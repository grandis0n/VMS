&НаКлиенте
Процедура САБ_СоздатьЗаказЗаявкуПосле(Команда)
	
	САБ_ОткрытьДокументНаОсновании("Документ.ЭлектронныйЗаказЗаявка.ФормаОбъекта");
	
КонецПроцедуры

&НаКлиенте
Процедура САБ_СоздатьЭкспедиторскуюРаспискуПосле(Команда)
	
	САБ_ОткрытьДокументНаОсновании("Документ.ЭлектроннаяЭкспедиторскаяРасписка.ФормаОбъекта");
	
КонецПроцедуры

&НаКлиенте
Процедура САБ_ОткрытьДокументНаОсновании(ИмяФормыДокумента)
	
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Или Модифицированность Тогда
		Если Не Записать() Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура("Основание", Объект.Ссылка);
	ОткрытьФорму(ИмяФормыДокумента, ПараметрыФормы);
	
КонецПроцедуры

&После("ПриСозданииНаСервере")
Процедура САБ_ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	САБ_ДобавитьКомандыСозданияДокументов();
	САБ_ДобавитьПолеОперативногоМенеджера();
	
КонецПроцедуры

&НаСервере
Процедура САБ_ДобавитьКомандыСозданияДокументов()

	ПанельФормы = Элементы.ФормаКоманднаяПанель;
	ЭлементПеред = Элементы.Найти("ФормаИныеПолучатели");
	
	САБ_ДобавитьКомандуСозданияДокумента(
		"САБ_СоздатьЭкспедиторскуюРасписку",
		"САБ_СоздатьЭкспедиторскуюРаспискуПосле",
		"Оформить экспедиторскую расписку",
		ПанельФормы,
		ЭлементПеред);
	
	САБ_ДобавитьКомандуСозданияДокумента(
		"САБ_СоздатьЗаказЗаявку",
		"САБ_СоздатьЗаказЗаявкуПосле",
		"Оформить заказ (заявка)",
		ПанельФормы,
		ЭлементПеред);
	
КонецПроцедуры

&НаСервере
Процедура САБ_ДобавитьКомандуСозданияДокумента(ИмяКоманды, ИмяДействия, ЗаголовокКоманды, Родитель, ЭлементПеред)
	
	Если Команды.Найти(ИмяКоманды) = Неопределено Тогда
		НоваяКоманда = Команды.Добавить(ИмяКоманды);
		НоваяКоманда.Действие = ИмяДействия;
		НоваяКоманда.Заголовок = ЗаголовокКоманды;
		НоваяКоманда.ИзменяетСохраняемыеДанные = Ложь;
	КонецЕсли;
	
	Кнопка = Элементы.Добавить(ИмяКоманды, Тип("КнопкаФормы"), Родитель);
	Кнопка.Вид = ВидКнопкиФормы.ОбычнаяКнопка;
	Кнопка.ИмяКоманды = ИмяКоманды;
	Кнопка.Отображение = ОтображениеКнопки.Текст;
	
	Если ЭлементПеред <> Неопределено Тогда
		Элементы.Переместить(Кнопка, Родитель, ЭлементПеред);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура САБ_ДобавитьПолеОперативногоМенеджера()
	
	Если Элементы.Найти("САБ_ОперативныйМенеджер") <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	НовыйЭлемент = Элементы.Добавить("САБ_ОперативныйМенеджер", Тип("ПолеФормы"));
	НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
	НовыйЭлемент.ПутьКДанным = "Объект.САБ_ОперативныйМенеджер";
	НовыйЭлемент.Заголовок = "Оперативный менеджер";
	НовыйЭлемент.ТолькоПросмотр =
		Не Пользователи.ЭтоПолноправныйПользователь()
		И Не РольДоступна("САБ_ИзменениеОперативногоМенеджераЭПД");
	
КонецПроцедуры