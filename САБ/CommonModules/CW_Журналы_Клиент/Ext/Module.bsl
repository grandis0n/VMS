
&НаКлиенте
&ИзменениеИКонтроль("ОткрытьЛибоРедактировать")
Функция саб_ОткрытьЛибоРедактировать(УФ, ВыбраннаяСтрока, ПроцедураОбратногоВызова)

	Элементы = УФ.Элементы;
	Журнал_СтруктураНастроек = УФ.Журнал_СтруктураНастроек;

	РежимОткрытия = Истина;

	Если (Журнал_СтруктураНастроек["РежимЕкселя"]) Тогда  

		// проверяем, что колонка редактируется
		ИмяКолонки = НРег(СтрЗаменить(Элементы.Журнал.ТекущийЭлемент.Имя,"Журнал_",""));
		ПараметрыКолонки = ПараметрыКолонки(УФ, ИмяКолонки);
		Если (ПараметрыКолонки = Неопределено) Тогда
			Возврат(Неопределено);
		КонецЕсли; 
		Если (ПараметрыКолонки.РежимПрямогоРедактирования) Тогда

			МассивВыделенных = ПолучитьМассивВыделенныхГрузоперевозок(УФ);
            #Удаление
			Если НЕ ПараметрыКолонки.РежимМножественногоРедактирования И МассивВыделенных.Количество() > 1 Тогда

				РежимОткрытия = Ложь;
				_УФК.ВывестиПредупреждение("Множественное редактирование невозможно.");

			Иначе

				Отказ = Ложь;
				Если ПараметрыКолонки.ИспользованиеОтбора Тогда
					СтруктураПараметров = новый Структура;
					СтруктураПараметров.Вставить("ОбъектХарактеристики"				, ПараметрыКолонки.ОбъектХарактеристики);
					СтруктураПараметров.Вставить("МассивСсылок"						, МассивВыделенных);
					СтруктураПараметров.Вставить("ЭтоФормаЖурналаГрузоперевозок"	, ЭтоФормаЖурналаГрузоперевозок(УФ));
					СтруктураПараметров.Вставить("ЭтоФормаЖурналаЗаявок"			, ЭтоФормаЖурналаЗаявок(УФ));
					СтруктураПараметров.Вставить("ЭтоФормаЖурналаЗаказов"			, ЭтоФормаЖурналаЗаказов(УФ));
					СтруктураПараметров.Вставить("ЭтоФормаЗаказа"					, ЭтоФормаЗаказа(УФ));

					Отказ = CW_Журналы_Сервер.ПроверитьНаличиеОтбора(СтруктураПараметров);
				КонецЕсли;  

				РежимОткрытия = Ложь;
				Если Не Отказ Тогда
					Возврат(ПроизвестиРедактирование(ПроцедураОбратногоВызова,УФ,МассивВыделенных, ПараметрыКолонки));	
				Иначе
					_УФК.ВывестиПредупреждение("Множественное редактирование невозможно.
					|Необходимо, чтобы значения реквзитов отбора параметра ("+ПараметрыКолонки.Заголовок+") были идентичными!");
				КонецЕсли;

			КонецЕсли;
			#КонецУдаления
			#Вставка
			Если МассивВыделенных.Количество() > 20 Тогда

				РежимОткрытия = Ложь;
				_УФК.ВывестиПредупреждение("Множественное редактирование невозможно. Максимальное количество документов - 20");

			Иначе

				Отказ = Ложь;
				Если ПараметрыКолонки.ИспользованиеОтбора Тогда
					СтруктураПараметров = новый Структура;
					СтруктураПараметров.Вставить("ОбъектХарактеристики"				, ПараметрыКолонки.ОбъектХарактеристики);
					СтруктураПараметров.Вставить("МассивСсылок"						, МассивВыделенных);
					СтруктураПараметров.Вставить("ЭтоФормаЖурналаГрузоперевозок"	, ЭтоФормаЖурналаГрузоперевозок(УФ));
					СтруктураПараметров.Вставить("ЭтоФормаЖурналаЗаявок"			, ЭтоФормаЖурналаЗаявок(УФ));
					СтруктураПараметров.Вставить("ЭтоФормаЖурналаЗаказов"			, ЭтоФормаЖурналаЗаказов(УФ));
					СтруктураПараметров.Вставить("ЭтоФормаЗаказа"					, ЭтоФормаЗаказа(УФ));
					
					Отказ = CW_Журналы_Сервер.ПроверитьНаличиеОтбора(СтруктураПараметров);
				КонецЕсли;  
				
				РежимОткрытия = Ложь;
				Если Не Отказ Тогда
					Возврат(ПроизвестиРедактирование(ПроцедураОбратногоВызова,УФ,МассивВыделенных, ПараметрыКолонки));	
				Иначе
					_УФК.ВывестиПредупреждение("Множественное редактирование невозможно.
												|Необходимо, чтобы значения реквзитов отбора параметра ("+ПараметрыКолонки.Заголовок+") были идентичными!");
				КонецЕсли
			КонецЕсли
			#КонецВставки

		КонецЕсли; 

	КонецЕсли;

	Если (РежимОткрытия) Тогда

		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("Ключ", УФ.Журнал_Данные.НайтиПоИдентификатору(ВыбраннаяСтрока)["ссылка"]);
		ПараметрыФормы.Вставить("НеРассчитыватьСтатусыПриЗаписи", Истина);

		Если (ЭтоФормаЖурналаГрузоперевозок(УФ)) Тогда
			ОткрытьФорму("Справочник.CW_Грузоперевозки.ФормаОбъекта", ПараметрыФормы, Элементы.Журнал);
		ИначеЕсли (ЭтоФормаЗаказа(УФ)) Тогда 
			ОткрытьФорму("Справочник.CW_Грузоперевозки.ФормаОбъекта", ПараметрыФормы, Элементы.Журнал);
		ИначеЕсли (ЭтоФормаЗаявки(УФ)) Тогда 
			ОткрытьФорму("Справочник.CW_Грузоперевозки.ФормаОбъекта", ПараметрыФормы, Элементы.Журнал);
		ИначеЕсли (ЭтоФормаЖурналаЗаявок(УФ)) Тогда 
			ОткрытьФорму("Справочник.CW_Заявки.ФормаОбъекта", ПараметрыФормы, Элементы.Журнал,,,,,РежимОткрытияОкнаФормы.Независимый);
		ИначеЕсли (ЭтоФормаЖурналаЗаказов(УФ)) Тогда 
			ОткрытьФорму("Справочник.CW_Заказы.ФормаОбъекта", ПараметрыФормы, Элементы.Журнал,,,,,РежимОткрытияОкнаФормы.Независимый);
		КонецЕсли; 

	КонецЕсли;

	Возврат(Неопределено);

КонецФункции
