&После("ЗаполнитьТаблицуЗначенийРеквизитовПоПараметрамФормы")
Процедура САБ_ЗаполнитьТаблицуЗначенийРеквизитовПоПараметрамФормы(Параметры, СтруктураРеквизитов)
	
	Если Не ЗначениеЗаполнено(Параметры.Основание)
		Или ТипЗнч(Параметры.Основание) <> Тип("ДокументСсылка.ЭлектронноеПоручениеЭкспедитору") Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(Параметры.Ключ) = Тип("ДокументСсылка.ЭлектроннаяЭкспедиторскаяРасписка") Тогда
		САБ_ЗаполнитьЭЭРНаОснованииЭПЭ(Параметры.Основание, СтруктураРеквизитов);
	ИначеЕсли ТипЗнч(Параметры.Ключ) = Тип("ДокументСсылка.ЭлектронныйЗаказЗаявка") Тогда
		САБ_ЗаполнитьЭЗЗНаОснованииЭПЭ(Параметры.Основание, СтруктураРеквизитов);
	КонецЕсли;
	
КонецПроцедуры 

&После("ЗаполнитьТаблицуЗначенийРеквизитов")
Процедура САБ_ЗаполнитьТаблицуЗначенийРеквизитовПосле(Документ, Организация, СтруктураРеквизитов, Титул = Неопределено, МассивИсключений = Неопределено, ТолькоНовые = Ложь)
	
	Если ТипЗнч(Документ) <> Тип("ДокументСсылка.ЭлектронноеПоручениеЭкспедитору") Тогда
		Возврат;
	КонецЕсли;
	
	Если СтруктураРеквизитов = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СтруктураРеквизитовЗаполнение = ОбменСГИСЭПДКлиентСервер.СкопироватьИзФиксированногоЗначенияРекурсивно(СтруктураРеквизитов);
	
	МассивВерсий = Неопределено;
	Если СтруктураРеквизитовЗаполнение.Свойство("ТитулЗаказчика", МассивВерсий) = Ложь
		Или МассивВерсий = Неопределено
		Или МассивВерсий.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ИндексВерсии = МассивВерсий.ВГраница();
	СтруктураТитула = ОбменСГИСЭПДКлиентСервер.СкопироватьИзФиксированногоЗначенияРекурсивно(МассивВерсий[ИндексВерсии]);
	
	ДобавленныеКлючи = САБ_ДополнитьИнострГрузоотправителяВСтруктуреЭПЭ(СтруктураТитула, Документ);
	
	МассивВерсий[ИндексВерсии] = Новый ФиксированнаяСтруктура(СтруктураТитула);
	СтруктураРеквизитовЗаполнение.Вставить("ТитулЗаказчика", Новый ФиксированныйМассив(МассивВерсий));
	СтруктураРеквизитов = Новый ФиксированнаяСтруктура(СтруктураРеквизитовЗаполнение);
	
	Если ДобавленныеКлючи.Количество() > 0 Тогда
		САБ_ЗаписатьРеквизитыГрузаЭПЭ(Документ, Организация, СтруктураТитула, ДобавленныеКлючи);
	КонецЕсли;
	
КонецПроцедуры

Процедура САБ_ЗаполнитьЭЭРНаОснованииЭПЭ(Основание, СтруктураРеквизитов)
	
	СтруктураРеквизитовОснования = Неопределено;
	ЗаполнитьТаблицуЗначенийРеквизитов(Основание, Основание.Организация, СтруктураРеквизитовОснования);
	
	Если СтруктураРеквизитовОснования = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СтруктураТитула = Новый Структура;
	СпособДоставки = "";
	
	Для Каждого ТитулКиЗ Из СтруктураРеквизитовОснования Цикл
		
		Если ТитулКиЗ.Ключ <> "ТитулЗаказчика" Тогда
			Продолжить;
		КонецЕсли;
		
		ПоследняяВерсия = ТитулКиЗ.Значение[ТитулКиЗ.Значение.ВГраница()];
		Для Каждого РеквизитКиЗ Из ПоследняяВерсия Цикл
			
			Если САБ_ЭтоСлужебныйРеквизитЭПЭ(РеквизитКиЗ.Ключ) Тогда
				Продолжить;
			КонецЕсли;
			
			ЧастиКлюча = САБ_ЧастиКлючаРеквизита(РеквизитКиЗ.Ключ);
			
			Если ЧастиКлюча.ЭтоТабличнаяЧасть
				И ЧастиКлюча.Таблица = "ТитулЗаказчикаГрузы"
				И ЧастиКлюча.НомерСтроки = 1 Тогда
				
				Если СтрНачинаетсяС(ЧастиКлюча.ИмяПоля, "АдрГруз") Тогда
					ПолеКуда = СтрЗаменить(ЧастиКлюча.ИмяПоля, "АдрГруз", "АдрПриемГруз");
					СтруктураТитула.Вставить("ТитулЭкспедитора" + ПолеКуда, РеквизитКиЗ.Значение);
					Если ЧастиКлюча.ИмяПоля = "АдрГрузАдресПредставление" Тогда
						СтруктураТитула.Вставить("ПредставлениеТитулЭкспедитораАдрПриемГрузАдрес", РеквизитКиЗ.Значение);
					КонецЕсли;
				КонецЕсли;
				
			КонецЕсли;
			
			Если ЧастиКлюча.ЭтоТабличнаяЧасть
				И ЧастиКлюча.Таблица = "ТитулЗаказчикаГрузы"
				И САБ_ЭтоПолеШапкиВСтрокеГрузаЭПЭ(ЧастиКлюча.ИмяПоля) Тогда
				Продолжить;
			КонецЕсли;
			
			КлючКуда = СтрЗаменить(РеквизитКиЗ.Ключ, "ТитулЗаказчика", "ТитулЭкспедитора");
			СтруктураТитула.Вставить(КлючКуда, РеквизитКиЗ.Значение);
			
		КонецЦикла;
		
	КонецЦикла;
	
	Если Основание.ЭтоВходящий <> Истина Тогда
		САБ_ПоменятьСтороныЭЭР(СтруктураТитула);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Основание.УИДМинтранс) Тогда
		СтруктураТитула.Вставить("ТитулЭкспедитораУИДПорЭксп", Основание.УИДМинтранс);
	КонецЕсли;
	
	СтруктураТитула.Вставить("ТитулЭкспедитораВладИнфрСовпГОВ", "1");
	СтруктураТитула.Вставить("ТитулЭкспедитораСвЛицПогрГрЛицоПогруз", "1");
	СтруктураТитула.Вставить("ТитулЭкспедитораСодержаниеОперации", "груз принят во владение экспедитором");
	СтруктураТитула.Вставить("ТитулЭкспедитораКодДокументаПоКНД", "1110489");
	СтруктураТитула.Вставить("ТитулЭкспедитораНаименованиеДокумента", "электронная экспедиторская расписка");
	
	САБ_ПодставитьСсылкуДоговораЭЭР(СтруктураТитула, Основание);
	САБ_ДозаполнитьОбязательныеПоляГрузаЭЭР(СтруктураТитула, СпособДоставки);
	САБ_ПривестиПризнакиК01(СтруктураТитула);
	
	МакетСоответствиеИмен = Документы.ЭлектроннаяЭкспедиторскаяРасписка.ПолучитьМакет("СоответствиеИменРеквизитов");
	ОбластьПоискаИмен = МакетСоответствиеИмен.ПолучитьОбласть("ТитулЭкспедитора");
	ЗаполнитьПредставлениеХранимыхДанныхОбъекта(СтруктураТитула,
		"Документ.ЭлектроннаяЭкспедиторскаяРасписка",
		ОбластьПоискаИмен);
	
	МассивВерсий = Новый Массив;
	МассивВерсий.Добавить(Новый ФиксированнаяСтруктура(СтруктураТитула));
	
	Результат = Новый Структура;
	Результат.Вставить("ТитулЭкспедитора", Новый ФиксированныйМассив(МассивВерсий));
	СтруктураРеквизитов = Новый ФиксированнаяСтруктура(Результат);
	
КонецПроцедуры

Процедура САБ_ПривестиПризнакиК01(СтруктураТитула)
	
	Ключи = Новый Массив;
	Для Каждого КиЗ Из СтруктураТитула Цикл
		Ключи.Добавить(КиЗ.Ключ);
	КонецЦикла;
	
	Для Каждого Ключ Из Ключи Цикл
		Значение = СтруктураТитула[Ключ];
		Если ТипЗнч(Значение) = Тип("Булево") Тогда
			СтруктураТитула.Вставить(Ключ, ?(Значение, "1", "0"));
		ИначеЕсли Значение = "Нет" Или Значение = "Н" Или Значение = "Ложь" Тогда
			СтруктураТитула.Вставить(Ключ, "0");
		ИначеЕсли Значение = "Да" Или Значение = "Д" Или Значение = "Истина" Тогда
			СтруктураТитула.Вставить(Ключ, "1");
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура САБ_ПодставитьСсылкуДоговораЭЭР(СтруктураТитула, Основание)
	
	Если ЗначениеЗаполнено(САБ_ЗначениеСтруктуры(СтруктураТитула, "СсылкаТитулЭкспедитораДоговор")) Тогда
		Возврат;
	КонецЕсли;
	
	НомерДоговора = СокрЛП(Строка(САБ_ЗначениеСтруктуры(СтруктураТитула, "ТитулЭкспедитораДоговорНомер")));
	НаименованиеДоговора = СокрЛП(Строка(САБ_ЗначениеСтруктуры(СтруктураТитула, "ТитулЭкспедитораДоговорНаименование")));
	ДатаДоговора = САБ_ЗначениеСтруктуры(СтруктураТитула, "ТитулЭкспедитораДоговорДата");
	
	Если Не ЗначениеЗаполнено(НомерДоговора) И Не ЗначениеЗаполнено(НаименованиеДоговора) Тогда
		Возврат;
	КонецЕсли;
	
	КонтрагентВладелец = ?(Основание.ЭтоВходящий = Истина,
		Основание.СсылкаТитулЗаказчикаЗаказчик,
		Основание.СсылкаТитулЗаказчикаЭкспедитор);
	
	НайденныйДоговор = саб_ДоговорКонтрагентаПоРеквизитамЭПЭ(
		НомерДоговора, НаименованиеДоговора, ДатаДоговора,
		Основание.Организация, КонтрагентВладелец);
	
	Если Не ЗначениеЗаполнено(НайденныйДоговор) Тогда
		НайденныйДоговор = саб_ДоговорКонтрагентаПоРеквизитамЭПЭ(
			НомерДоговора, НаименованиеДоговора, ДатаДоговора,
			Основание.Организация, Неопределено);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(НайденныйДоговор) Тогда
		НайденныйДоговор = саб_ДоговорКонтрагентаПоРеквизитамЭПЭ(
			НомерДоговора, НаименованиеДоговора, ДатаДоговора,
			Неопределено, Неопределено);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(НайденныйДоговор) Тогда
		Возврат;
	КонецЕсли;
	
	СтруктураТитула.Вставить("СсылкаТитулЭкспедитораДоговор", НайденныйДоговор);
	ОбменСГИСЭПДКлиентСервер.ЗаполнитьРеквизитыДоговора(
		НайденныйДоговор, "ТитулЭкспедитораДоговор", СтруктураТитула);
	
КонецПроцедуры

Процедура САБ_ПоменятьСтороныЭЭР(СтруктураТитула)
	
	НоваяСтруктура = Новый Структура;
	
	Для Каждого КиЗ Из СтруктураТитула Цикл
		
		Ключ = КиЗ.Ключ;
		
		Если СтрНачинаетсяС(Ключ, "ТитулЭкспедитораЭкспедитор")
			Или СтрНачинаетсяС(Ключ, "СсылкаТитулЭкспедитораЭкспедитор")
			Или СтрНачинаетсяС(Ключ, "ПредставлениеТитулЭкспедитораЭкспедитор") Тогда
			Ключ = СтрЗаменить(Ключ, "ТитулЭкспедитораЭкспедитор", "ТитулЭкспедитораЗаказчик");
		ИначеЕсли СтрНачинаетсяС(Ключ, "ТитулЭкспедитораЗаказчик")
			Или СтрНачинаетсяС(Ключ, "СсылкаТитулЭкспедитораЗаказчик")
			Или СтрНачинаетсяС(Ключ, "ПредставлениеТитулЭкспедитораЗаказчик") Тогда
			Ключ = СтрЗаменить(Ключ, "ТитулЭкспедитораЗаказчик", "ТитулЭкспедитораЭкспедитор");
		КонецЕсли;
		
		НоваяСтруктура.Вставить(Ключ, КиЗ.Значение);
		
	КонецЦикла;
	
	СтруктураТитула.Очистить();
	Для Каждого КиЗ Из НоваяСтруктура Цикл
		СтруктураТитула.Вставить(КиЗ.Ключ, КиЗ.Значение);
	КонецЦикла;
	
КонецПроцедуры

Процедура САБ_ЗаполнитьЭЗЗНаОснованииЭПЭ(Основание, СтруктураРеквизитов)
	
	СтруктураРеквизитовОснования = Неопределено;
	ЗаполнитьТаблицуЗначенийРеквизитов(Основание, Основание.Организация, СтруктураРеквизитовОснования);
	
	Если СтруктураРеквизитовОснования = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СоответствиеПолейГруза = САБ_СоответствиеПолейОписанияГрузаЭЗЗ();
	СтруктураТитула = Новый Структура;
	НомерПункта = 0;
	ДатаОтгрузки = Неопределено;
	ВремяОтгрузки = Неопределено;
	
	Для Каждого ТитулКиЗ Из СтруктураРеквизитовОснования Цикл
		
		Если ТитулКиЗ.Ключ <> "ТитулЗаказчика" Тогда
			Продолжить;
		КонецЕсли;
		
		ПоследняяВерсия = ТитулКиЗ.Значение[ТитулКиЗ.Значение.ВГраница()];
		Для Каждого РеквизитКиЗ Из ПоследняяВерсия Цикл
			
			Если САБ_ЭтоСлужебныйРеквизитЭПЭ(РеквизитКиЗ.Ключ) Тогда
				Продолжить;
			КонецЕсли;
			
			ЧастиКлюча = САБ_ЧастиКлючаРеквизита(РеквизитКиЗ.Ключ);
			
			Если ЧастиКлюча.ЭтоТабличнаяЧасть
				И СтрНачинаетсяС(ЧастиКлюча.Таблица, "ТитулЗаказчикаОписаниеГруза") Тогда
				
				Если ЧастиКлюча.Таблица = "ТитулЗаказчикаОписаниеГруза" Тогда
					ИмяПоляЭЗЗ = СоответствиеПолейГруза.Получить(ЧастиКлюча.ИмяПоля);
					Если ИмяПоляЭЗЗ = Неопределено Тогда
						Если ЧастиКлюча.ИмяПоля = "ИдентификаторСтроки"
							Или ЧастиКлюча.ИмяПоля = "ИдентификаторСтрокиРодителя" Тогда
							ИмяПоляЭЗЗ = ЧастиКлюча.ИмяПоля;
						Иначе
							Продолжить;
						КонецЕсли;
					КонецЕсли;
					КлючКуда = "ТитулГрузоотправителяГрузы__" + Формат(ЧастиКлюча.НомерСтроки, "ЧГ=0") + "__" + ИмяПоляЭЗЗ;
					СтруктураТитула.Вставить(КлючКуда, РеквизитКиЗ.Значение);
				КонецЕсли;
				Продолжить;
				
			КонецЕсли;
			
			Если ЧастиКлюча.ЭтоТабличнаяЧасть
				И ЧастиКлюча.Таблица = "ТитулЗаказчикаГрузы" Тогда
				
				Если ЧастиКлюча.НомерСтроки = 1 Тогда
					Если ЧастиКлюча.ИмяПоля = "ДатОтгрС" Тогда
						ДатаОтгрузки = РеквизитКиЗ.Значение;
					ИначеЕсли ЧастиКлюча.ИмяПоля = "ВрОтгр" Тогда
						ВремяОтгрузки = РеквизитКиЗ.Значение;
					КонецЕсли;
				КонецЕсли;
				
				Если СтрНачинаетсяС(ЧастиКлюча.ИмяПоля, "АдрГруз") Тогда
					САБ_ПеренестиАдресЭПЭВЭЗЗ(СтруктураТитула, ЧастиКлюча, РеквизитКиЗ.Значение, "Погрузка", НомерПункта);
				ИначеЕсли СтрНачинаетсяС(ЧастиКлюча.ИмяПоля, "АдрПунктНазн") Тогда
					САБ_ПеренестиАдресЭПЭВЭЗЗ(СтруктураТитула, ЧастиКлюча, РеквизитКиЗ.Значение, "Выгрузка", НомерПункта);
				КонецЕсли;
				Продолжить;
				
			КонецЕсли;
			
			Если ЧастиКлюча.ЭтоТабличнаяЧасть
				И ЧастиКлюча.Таблица = "ТитулЗаказчикаГрузыСвТС"
				И ЧастиКлюча.НомерСтроки = 1 Тогда
				
				Если ЧастиКлюча.ИмяПоля = "ВидТС" Тогда
					СтруктураТитула.Вставить("ТитулГрузоотправителяПараметрыТранспортногоСредстваТип", РеквизитКиЗ.Значение);
				ИначеЕсли ЧастиКлюча.ИмяПоля = "ТипКузов" Тогда
					СтруктураТитула.Вставить("ТитулГрузоотправителяПараметрыТранспортногоСредстваТипКузова", РеквизитКиЗ.Значение);
				КонецЕсли;
				Продолжить;
				
			КонецЕсли;
			
			Если ЧастиКлюча.ЭтоТабличнаяЧасть Тогда
				Продолжить;
			КонецЕсли;
			
			КлючКуда = САБ_КлючРеквизитаЭЗЗ(РеквизитКиЗ.Ключ, Основание.ЭтоВходящий = Истина);
			СтруктураТитула.Вставить(КлючКуда, РеквизитКиЗ.Значение);
			
		КонецЦикла;
	КонецЦикла;
	
	Если ЗначениеЗаполнено(ДатаОтгрузки) Тогда
		ДатаПодачи = ДатаОтгрузки;
		Если ТипЗнч(ДатаОтгрузки) = Тип("Дата") И ТипЗнч(ВремяОтгрузки) = Тип("Дата") Тогда
			ДатаПодачи = Дата(
				Год(ДатаОтгрузки), Месяц(ДатаОтгрузки), День(ДатаОтгрузки),
				Час(ВремяОтгрузки), Минута(ВремяОтгрузки), Секунда(ВремяОтгрузки));
		КонецЕсли;
		СтруктураТитула.Вставить("ТитулГрузоотправителяЗаявленныеДатаВремяПодачи", ДатаПодачи);
	КонецЕсли;
	
	МассивВерсий = Новый Массив;
	МассивВерсий.Добавить(Новый ФиксированнаяСтруктура(СтруктураТитула));
	
	Результат = Новый Структура;
	Результат.Вставить("ТитулГрузоотправителя", Новый ФиксированныйМассив(МассивВерсий));
	СтруктураРеквизитов = Новый ФиксированнаяСтруктура(Результат);
	
КонецПроцедуры

Процедура САБ_ПеренестиАдресЭПЭВЭЗЗ(СтруктураТитула, ЧастиКлюча, Значение, Операция, НомерПункта)
	
	ПолеЭЗЗ = САБ_ИмяПоляАдресаЭЗЗ(ЧастиКлюча.ИмяПоля);
	Если ПолеЭЗЗ = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ЧастиКлюча.НомерСтроки = 1 И Операция = "Погрузка" Тогда
		СтруктураТитула.Вставить("ТитулГрузоотправителяАдресПогрузки" + ПолеЭЗЗ.Шапка, Значение);
		Если ПолеЭЗЗ.Шапка = "Представление" Тогда
			СтруктураТитула.Вставить("ПредставлениеТитулГрузоотправителяАдресПогрузки", Значение);
			СтруктураТитула.Вставить("ТитулГрузоотправителяНаименованиеКонечногоПунктаМаршрута", Значение);
		КонецЕсли;
	КонецЕсли;
	
	Если Операция = "Выгрузка" И ЧастиКлюча.НомерСтроки = 1 И ПолеЭЗЗ.Шапка = "Представление" Тогда
		СтруктураТитула.Вставить("ТитулГрузоотправителяНаименованиеКонечногоПунктаМаршрута", Значение);
	КонецЕсли;
	
	НомерСтрокиПункта = ?(Операция = "Погрузка", 1, 2);
	ПрефиксСтроки = "ТитулГрузоотправителяАдресаПунктовПогрузкиИВыгрузки__" + Формат(НомерСтрокиПункта, "ЧГ=0") + "__";
	
	СтруктураТитула.Вставить(ПрефиксСтроки + "Операция", Операция);
	СтруктураТитула.Вставить(ПрефиксСтроки + "НомерПп", НомерСтрокиПункта);
	СтруктураТитула.Вставить(ПрефиксСтроки + ПолеЭЗЗ.Пункт, Значение);
	
КонецПроцедуры

Процедура САБ_ДозаполнитьОбязательныеПоляГрузаЭЭР(СтруктураТитула, СпособДоставки)
	
	НомерСтроки = 1;
	Пока Истина Цикл
		
		ЕстьСтрока = СтруктураТитула.Свойство("ТитулЭкспедитораГрузы__" + Формат(НомерСтроки, "ЧГ=0") + "__ИдентификаторСтроки")
			Или СтруктураТитула.Свойство("ТитулЭкспедитораГрузы__" + Формат(НомерСтроки, "ЧГ=0") + "__ИдентПартГруз")
			Или СтруктураТитула.Свойство("ТитулЭкспедитораГрузы__" + Формат(НомерСтроки, "ЧГ=0") + "__НомПартГруз")
			Или СтруктураТитула.Свойство("ТитулЭкспедитораОписаниеГруза__" + Формат(НомерСтроки, "ЧГ=0") + "__НаимГруз");
		
		Если Не ЕстьСтрока Тогда
			Прервать;
		КонецЕсли;
		
		ПрефиксГруза = "ТитулЭкспедитораГрузы__" + Формат(НомерСтроки, "ЧГ=0") + "__";
		ИдентификаторСтроки = Неопределено;
		Если Не СтруктураТитула.Свойство(ПрефиксГруза + "ИдентификаторСтроки", ИдентификаторСтроки)
			Или Не ЗначениеЗаполнено(ИдентификаторСтроки) Тогда
			ИдентификаторСтроки = Строка(Новый УникальныйИдентификатор);
			СтруктураТитула.Вставить(ПрефиксГруза + "ИдентификаторСтроки", ИдентификаторСтроки);
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(САБ_ЗначениеСтруктуры(СтруктураТитула, ПрефиксГруза + "ПрзПрвз")) Тогда
			СтруктураТитула.Вставить(ПрефиксГруза + "ПрзПрвз", "0");
		КонецЕсли;
		Если Не ЗначениеЗаполнено(САБ_ЗначениеСтруктуры(СтруктураТитула, ПрефиксГруза + "ВозмУкСтПарт")) Тогда
			СтруктураТитула.Вставить(ПрефиксГруза + "ВозмУкСтПарт", "0");
		КонецЕсли;
		Если Не ЗначениеЗаполнено(САБ_ЗначениеСтруктуры(СтруктураТитула, ПрефиксГруза + "УслПриемФСостГруз")) Тогда
			СтруктураТитула.Вставить(ПрефиксГруза + "УслПриемФСостГруз", "Соответствует сопроводительным документам");
		КонецЕсли;
		
		КлючОбязательства = "ТитулЭкспедитораГрузыУслПриемОбязЭксп__" + Формат(НомерСтроки, "ЧГ=0") + "__Обязательства";
		Если Не ЗначениеЗаполнено(САБ_ЗначениеСтруктуры(СтруктураТитула, КлючОбязательства)) Тогда
			СтруктураТитула.Вставить(КлючОбязательства, "Согласно договору транспортной экспедиции");
			СтруктураТитула.Вставить(
				"ТитулЭкспедитораГрузыУслПриемОбязЭксп__" + Формат(НомерСтроки, "ЧГ=0") + "__ИдентификаторСтрокиРодителя",
				ИдентификаторСтроки);
		КонецЕсли;
		
		ПрефиксОписания = "ТитулЭкспедитораОписаниеГруза__" + Формат(НомерСтроки, "ЧГ=0") + "__";
		Если Не ЗначениеЗаполнено(САБ_ЗначениеСтруктуры(СтруктураТитула, ПрефиксОписания + "СпДостГруз")) Тогда
			ТекстСпособа = ?(ЗначениеЗаполнено(СпособДоставки), СпособДоставки, "Автомобильный транспорт");
			СтруктураТитула.Вставить(ПрефиксОписания + "СпДостГруз", ТекстСпособа);
		КонецЕсли;
		Если Не ЗначениеЗаполнено(САБ_ЗначениеСтруктуры(СтруктураТитула, ПрефиксОписания + "УказОбъем")) Тогда
			ЕстьОбъем = ЗначениеЗаполнено(САБ_ЗначениеСтруктуры(СтруктураТитула, ПрефиксОписания + "Объем"));
			СтруктураТитула.Вставить(ПрефиксОписания + "УказОбъем", ?(ЕстьОбъем, "1", "0"));
		КонецЕсли;
		Если Не ЗначениеЗаполнено(САБ_ЗначениеСтруктуры(СтруктураТитула, ПрефиксОписания + "ИдентификаторСтрокиРодителя")) Тогда
			СтруктураТитула.Вставить(ПрефиксОписания + "ИдентификаторСтрокиРодителя", ИдентификаторСтроки);
		КонецЕсли;
		
		НомерСтроки = НомерСтроки + 1;
		
	КонецЦикла;
	
КонецПроцедуры

Функция САБ_КлючРеквизитаЭЗЗ(КлючОткуда, МенятьСтороны)
	
	Если МенятьСтороны Тогда
		Если СтрНайти(КлючОткуда, "ТитулЗаказчикаЭкспедитор") > 0 Тогда
			Возврат СтрЗаменить(КлючОткуда, "ТитулЗаказчикаЭкспедитор", "ТитулГрузоотправителяГрузоотправитель");
		ИначеЕсли СтрНайти(КлючОткуда, "ТитулЗаказчикаЗаказчик") > 0 Тогда
			Возврат СтрЗаменить(КлючОткуда, "ТитулЗаказчикаЗаказчик", "ТитулГрузоотправителяПеревозчик");
		КонецЕсли;
	Иначе
		Если СтрНайти(КлючОткуда, "ТитулЗаказчикаЗаказчик") > 0 Тогда
			Возврат СтрЗаменить(КлючОткуда, "ТитулЗаказчикаЗаказчик", "ТитулГрузоотправителяГрузоотправитель");
		ИначеЕсли СтрНайти(КлючОткуда, "ТитулЗаказчикаЭкспедитор") > 0 Тогда
			Возврат СтрЗаменить(КлючОткуда, "ТитулЗаказчикаЭкспедитор", "ТитулГрузоотправителяПеревозчик");
		КонецЕсли;
	КонецЕсли;
	
	Возврат СтрЗаменить(КлючОткуда, "ТитулЗаказчика", "ТитулГрузоотправителя");
	
КонецФункции

Функция САБ_ЭтоСлужебныйРеквизитЭПЭ(Ключ)
	
	Возврат СтрНачинаетсяС(Ключ, "ТитулЗаказчикаИдентификаторФайла")
		Или СтрНачинаетсяС(Ключ, "ТитулЗаказчикаДатаФормированияФайла")
		Или СтрНачинаетсяС(Ключ, "ТитулЗаказчикаВремяФормированияФайла")
		Или Ключ = "ТитулЗаказчикаНомер"
		Или Ключ = "ТитулЗаказчикаДата"
		Или Ключ = "ТитулЗаказчикаУИДМинтранс"
		Или Ключ = "ТитулЗаказчикаКодДокументаПоКНД"
		Или Ключ = "ТитулЗаказчикаНаименованиеДокумента"
		Или СтрНачинаетсяС(Ключ, "ТитулЗаказчикаДатаФормирования")
		Или СтрНачинаетсяС(Ключ, "ТитулЗаказчикаВремяФормирования")
		Или Ключ = "ТитулЗаказчикаСодержаниеОперации"
	
КонецФункции

Функция САБ_ЭтоПолеШапкиВСтрокеГрузаЭПЭ(ИмяПоля)
	
	Возврат СтрНачинаетсяС(ИмяПоля, "АдрГруз")
		Или СтрНачинаетсяС(ИмяПоля, "АдрПунктНазн")
		Или СтрНачинаетсяС(ИмяПоля, "Грузоотправитель")
		Или СтрНачинаетсяС(ИмяПоля, "Грузополучатель")
		Или ИмяПоля = "СсылкаГрузоотправитель"
		Или ИмяПоля = "СсылкаГрузополучатель"
		Или СтрНачинаетсяС(ИмяПоля, "ДатОтгр")
		Или СтрНачинаетсяС(ИмяПоля, "ДатДост")
		Или СтрНачинаетсяС(ИмяПоля, "ВрОтгр")
		Или СтрНачинаетсяС(ИмяПоля, "ВрДост");
	
КонецФункции

Функция САБ_ЧастиКлючаРеквизита(Ключ)
	
	Результат = Новый Структура("ЭтоТабличнаяЧасть, Таблица, НомерСтроки, ИмяПоля", Ложь, "", 0, Ключ);
	
	МассивЧастей = ОбменСГИСЭПДКлиентСервер.РазделитьСтрокуСоСложнымРазделителем(Ключ, "__");
	Если МассивЧастей.Количество() <> 3 Тогда
		Возврат Результат;
	КонецЕсли;
	
	Результат.ЭтоТабличнаяЧасть = Истина;
	Результат.Таблица = МассивЧастей[0];
	Результат.НомерСтроки = Число(МассивЧастей[1]);
	Результат.ИмяПоля = МассивЧастей[2];
	
	Возврат Результат;
	
КонецФункции

Функция САБ_ИмяПоляАдресаЭЗЗ(ИмяПоляЭПЭ)
	
	Остаток = ИмяПоляЭПЭ;
	Если СтрНачинаетсяС(Остаток, "АдрГруз") Тогда
		Остаток = Сред(Остаток, СтрДлина("АдрГруз") + 1);
	ИначеЕсли СтрНачинаетсяС(Остаток, "АдрПунктНазн") Тогда
		Остаток = Сред(Остаток, СтрДлина("АдрПунктНазн") + 1);
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
	СоответствиеШапки = Новый Соответствие;
	СоответствиеШапки.Вставить("АдресИндекс", "Индекс");
	СоответствиеШапки.Вставить("АдресКодРегиона", "КодРегиона");
	СоответствиеШапки.Вставить("АдресРайон", "Район");
	СоответствиеШапки.Вставить("АдресГород", "Город");
	СоответствиеШапки.Вставить("АдресНаселенныйПункт", "НаселенныйПункт");
	СоответствиеШапки.Вставить("АдресУлица", "Улица");
	СоответствиеШапки.Вставить("АдресДом", "Дом");
	СоответствиеШапки.Вставить("АдресКорпус", "Корпус");
	СоответствиеШапки.Вставить("АдресКвартира", "Квартира");
	СоответствиеШапки.Вставить("АдресИныеСведения", "ИныеСведения");
	СоответствиеШапки.Вставить("АдресПредставление", "Представление");
	СоответствиеШапки.Вставить("АдресКодСтраны", "КодСтраны");
	СоответствиеШапки.Вставить("АдрКоммент", "Комментарий");
	СоответствиеШапки.Вставить("Широта", "Широта");
	СоответствиеШапки.Вставить("Долгота", "Долгота");
	СоответствиеШапки.Вставить("ГЛНМеста", "GLN");
	
	ИмяШапки = СоответствиеШапки.Получить(Остаток);
	Если ИмяШапки = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ИмяПункта = "АдресПунктаПогрузки" + ИмяШапки;
	Если ИмяШапки = "Комментарий" Или ИмяШапки = "GLN" Или ИмяШапки = "Широта" Или ИмяШапки = "Долгота" Тогда
		ИмяПункта = "АдресПунктаПогрузкиВыгрузки" + ИмяШапки;
	КонецЕсли;
	
	Возврат Новый Структура("Шапка, Пункт", ИмяШапки, ИмяПункта);
	
КонецФункции

Функция САБ_СоответствиеПолейОписанияГрузаЭЗЗ()
	
	Результат = Новый Соответствие;
	Результат.Вставить("НаимГруз", "ОтгрузочноеНаименованиеГруза");
	Результат.Вставить("КолМестГр", "КоличествоГрузовыхМест");
	Результат.Вставить("Объем", "ОбъемГруза");
	Результат.Вставить("ВесНетто", "МассаНетто");
	Результат.Вставить("ВесБрутто", "МассаБрутто");
	Результат.Вставить("ВесГруз", "МассаБрутто");
	Результат.Вставить("КолПалл", "КоличествоПаллет");
	Результат.Вставить("ВесТар", "МассаТары");
	Результат.Вставить("ВысЗнач", "Высота");
	Результат.Вставить("ДлЗнач", "Длина");
	Результат.Вставить("ШирЗнач", "Ширина");
	
	Возврат Результат;
	
КонецФункции

Функция САБ_ЗначениеСтруктуры(СтруктураТитула, Ключ)
	
	Значение = Неопределено;
	СтруктураТитула.Свойство(Ключ, Значение);
	Возврат Значение;
	
КонецФункции
Процедура саб_ДописатьАлиасИнострСтатусаЭПЭ(СтруктураРеквизитов, ИмяРеквизита, ЗначениеРеквизита)
	
	Если Не ЗначениеЗаполнено(ЗначениеРеквизита) Тогда
		Возврат;
	КонецЕсли;
	
	Если СтрЗаканчиваетсяНа(ИмяРеквизита, "ИнострЛицоБезУчетаСтатусИО_ИГ") Тогда
		КлючАлиаса = СтрЗаменить(ИмяРеквизита, "ИнострЛицоБезУчетаСтатусИО_ИГ",
			"ИнострЛицоБезУчетаИдентификацияСтатуса");
		Если Не ЗначениеЗаполнено(САБ_ЗначениеСтруктуры(СтруктураРеквизитов, КлючАлиаса)) Тогда
			СтруктураРеквизитов.Вставить(КлючАлиаса, ЗначениеРеквизита);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Функция САБ_ДополнитьИнострГрузоотправителяВСтруктуреЭПЭ(СтруктураТитула, ДокументСсылка, ДвоичныеДанныеФайла = Неопределено)
	
	ДобавленныеКлючи = Новый Массив;
	
	Если ДвоичныеДанныеФайла = Неопределено Тогда
		ДанныеИзФайла = САБ_ГрузоотправителиИнострИзФайлаЭПЭ(ДокументСсылка);
	Иначе
		ДанныеИзФайла = САБ_ГрузоотправителиИнострИзДвоичныхДанных(ДвоичныеДанныеФайла);
	КонецЕсли;
	
	НомерСтроки = 1;
	Пока Истина Цикл
		
		ПрефиксСтроки = "ТитулЗаказчикаГрузы__" + Формат(НомерСтроки, "ЧГ=0") + "__";
		ПрефиксУчастника = ПрефиксСтроки + "Грузоотправитель";
		
		ЕстьСтрокаГруза = СтруктураТитула.Свойство(ПрефиксСтроки + "ИдентификаторСтроки")
			Или СтруктураТитула.Свойство(ПрефиксУчастника + "ЮЛНаименование")
			Или СтруктураТитула.Свойство(ПрефиксУчастника + "ИнострЛицоБезУчетаНаименование")
			Или СтруктураТитула.Свойство(ПрефиксУчастника + "ИнострЛицоБезУчетаСтатусИО_ИГ")
			Или (ДанныеИзФайла.Количество() >= НомерСтроки);
		
		Если Не ЕстьСтрокаГруза Тогда
			Прервать;
		КонецЕсли;
		
		Если ДанныеИзФайла.Количество() >= НомерСтроки Тогда
			Для Каждого КиЗ Из ДанныеИзФайла[НомерСтроки - 1] Цикл
				Ключ = ПрефиксСтроки + КиЗ.Ключ;
				ТекущееЗначение = Неопределено;
				СтруктураТитула.Свойство(Ключ, ТекущееЗначение);
				Если Не ЗначениеЗаполнено(ТекущееЗначение) И ЗначениеЗаполнено(КиЗ.Значение) Тогда
					СтруктураТитула.Вставить(Ключ, КиЗ.Значение);
					ДобавленныеКлючи.Добавить(Ключ);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
		САБ_ДописатьАлиасИнострСтатусаВСтрокеГруза(СтруктураТитула, ПрефиксУчастника, ДобавленныеКлючи);
		САБ_ПодставитьСсылкуИнострУчастникаСтроки(СтруктураТитула, ПрефиксСтроки, ПрефиксУчастника,
			"СсылкаГрузоотправитель", ДобавленныеКлючи);
		
		НомерСтроки = НомерСтроки + 1;
		
	КонецЦикла;
	
	Возврат ДобавленныеКлючи;
	
КонецФункции

Процедура САБ_ДописатьАлиасИнострСтатусаВСтрокеГруза(СтруктураТитула, ПрефиксУчастника, ДобавленныеКлючи = Неопределено)
	
	СтатусИО_ИГ = Неопределено;
	СтруктураТитула.Свойство(ПрефиксУчастника + "ИнострЛицоБезУчетаСтатусИО_ИГ", СтатусИО_ИГ);
	Если Не ЗначениеЗаполнено(СтатусИО_ИГ) Тогда
		Возврат;
	КонецЕсли;
	
	КлючАлиаса = ПрефиксУчастника + "ИнострЛицоБезУчетаИдентификацияСтатуса";
	Если Не ЗначениеЗаполнено(САБ_ЗначениеСтруктуры(СтруктураТитула, КлючАлиаса)) Тогда
		СтруктураТитула.Вставить(КлючАлиаса, СтатусИО_ИГ);
		Если ДобавленныеКлючи <> Неопределено Тогда
			ДобавленныеКлючи.Добавить(КлючАлиаса);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура САБ_ПодставитьСсылкуИнострУчастникаСтроки(СтруктураТитула, ПрефиксСтроки, ПрефиксУчастника, ИмяКлючаСсылки, ДобавленныеКлючи = Неопределено)
	
	КлючСсылки = ПрефиксСтроки + ИмяКлючаСсылки;
	Если ЗначениеЗаполнено(САБ_ЗначениеСтруктуры(СтруктураТитула, КлючСсылки)) Тогда
		Возврат;
	КонецЕсли;
	
	ПредставлениеУчастника = САБ_ПредставлениеИнострЛицаИзСтруктуры(СтруктураТитула, ПрефиксУчастника);
	Если Не ЗначениеЗаполнено(ПредставлениеУчастника) Тогда
		Возврат;
	КонецЕсли;
	
	СтруктураТитула.Вставить(КлючСсылки, НайтиСоздатьСтроковойЗначениеЭПД(ПредставлениеУчастника));
	Если ДобавленныеКлючи <> Неопределено Тогда
		ДобавленныеКлючи.Добавить(КлючСсылки);
	КонецЕсли;
	
КонецПроцедуры

Функция САБ_ПредставлениеИнострЛицаИзСтруктуры(СтруктураТитула, ПрефиксУчастника)
	
	Части = Новый Массив;
	
	Наименование = Неопределено;
	СтруктураТитула.Свойство(ПрефиксУчастника + "ИнострЛицоБезУчетаНаименование", Наименование);
	Если Не ЗначениеЗаполнено(Наименование) Тогда
		СтруктураТитула.Свойство(ПрефиксУчастника + "ЮЛНаименование", Наименование);
	КонецЕсли;
	Если ЗначениеЗаполнено(Наименование) Тогда
		Части.Добавить(СокрЛП(Наименование));
	КонецЕсли;
	
	Идентификатор = Неопределено;
	СтруктураТитула.Свойство(ПрефиксУчастника + "ИнострЛицоБезУчетаИдентификатор", Идентификатор);
	Если ЗначениеЗаполнено(Идентификатор) Тогда
		Части.Добавить(СокрЛП(Идентификатор));
	КонецЕсли;
	
	Страна = Неопределено;
	СтруктураТитула.Свойство(ПрефиксУчастника + "ИнострЛицоБезУчетаСтрана", Страна);
	Если ЗначениеЗаполнено(Страна) Тогда
		Части.Добавить(СокрЛП(Страна));
	КонецЕсли;
	
	Возврат СтрСоединить(Части, ", ");
	
КонецФункции

Функция САБ_ГрузоотправителиИнострИзФайлаЭПЭ(ДокументСсылка)
	
	Если Не ЗначениеЗаполнено(ДокументСсылка) Тогда
		Возврат Новый Массив;
	КонецЕсли;
	
	Возврат САБ_ГрузоотправителиИнострИзДвоичныхДанных(САБ_ДвоичныеДанныеТитулаЗаказчикаЭПЭ(ДокументСсылка));
	
КонецФункции

Функция САБ_ДвоичныеДанныеТитулаЗаказчикаЭПЭ(ДокументСсылка)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	СообщениеЭДО.Ссылка КАК Ссылка
	|ИЗ
	|	РегистрСведений.ОбъектыУчетаДокументовЭДО КАК ОбъектыУчетаДокументовЭДО
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.СообщениеЭДО КАК СообщениеЭДО
	|		ПО ОбъектыУчетаДокументовЭДО.ЭлектронныйДокумент = СообщениеЭДО.ЭлектронныйДокумент
	|ГДЕ
	|	ОбъектыУчетаДокументовЭДО.ОбъектУчета = &Документ
	|	И ОбъектыУчетаДокументовЭДО.Актуальный
	|	И СообщениеЭДО.ТипЭлементаРегламента = ЗНАЧЕНИЕ(Перечисление.ТипыЭлементовРегламентаЭДО.ЭПЭ_Титул1)
	|
	|УПОРЯДОЧИТЬ ПО
	|	СообщениеЭДО.МоментВремени УБЫВ";
	Запрос.УстановитьПараметр("Документ", ДокументСсылка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат ЭлектронныеДокументыЭДО.ДвоичныеДанныеСообщения(Выборка.Ссылка);
	
КонецФункции

Функция САБ_ГрузоотправителиИнострИзДвоичныхДанных(ДвоичныеДанныеФайла)
	
	Результат = Новый Массив;
	
	Если ДвоичныеДанныеФайла = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.ОткрытьПоток(ДвоичныеДанныеФайла.ОткрытьПотокДляЧтения());
	
	ДанныеТекущегоГруза = Неопределено;
	ВнутриСвГО = Ложь;
	ИмяТекстаСвИнНеУч = "";
	
	Пока ЧтениеXML.Прочитать() Цикл
		
		Если ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
			
			ИмяУзла = ЧтениеXML.ЛокальноеИмя;
			
			Если ИмяУзла = "СвГруз" Тогда
				ДанныеТекущегоГруза = Новый Структура;
				Результат.Добавить(ДанныеТекущегоГруза);
				ВнутриСвГО = Ложь;
			КонецЕсли;
			
			Если ИмяУзла = "СвГО" Тогда
				ВнутриСвГО = Истина;
			КонецЕсли;
			
			Если ИмяУзла = "СвИнНеУч" И ВнутриСвГО И ДанныеТекущегоГруза <> Неопределено Тогда
				Пока ЧтениеXML.ПрочитатьАтрибут() Цикл
					САБ_ЗаписатьПолеИнострГО(ДанныеТекущегоГруза, ЧтениеXML.ЛокальноеИмя, ЧтениеXML.Значение);
				КонецЦикла;
				ИмяТекстаСвИнНеУч = "";
			ИначеЕсли ВнутриСвГО И ДанныеТекущегоГруза <> Неопределено
				И (ИмяУзла = "ИдСтат" Или ИмяУзла = "КодСтр" Или ИмяУзла = "НаимСтран"
					Или ИмяУзла = "Наим" Или ИмяУзла = "Идентиф" Или ИмяУзла = "ИныеСвед") Тогда
				ИмяТекстаСвИнНеУч = ИмяУзла;
			Иначе
				ИмяТекстаСвИнНеУч = "";
			КонецЕсли;
			
		ИначеЕсли ЧтениеXML.ТипУзла = ТипУзлаXML.Текст Тогда
			
			Если ЗначениеЗаполнено(ИмяТекстаСвИнНеУч) И ДанныеТекущегоГруза <> Неопределено Тогда
				САБ_ЗаписатьПолеИнострГО(ДанныеТекущегоГруза, ИмяТекстаСвИнНеУч, ЧтениеXML.Значение);
			КонецЕсли;
			
		ИначеЕсли ЧтениеXML.ТипУзла = ТипУзлаXML.КонецЭлемента Тогда
			
			ИмяУзла = ЧтениеXML.ЛокальноеИмя;
			Если ИмяУзла = "СвГО" Тогда
				ВнутриСвГО = Ложь;
			КонецЕсли;
			Если ИмяУзла = "СвГруз" Тогда
				ДанныеТекущегоГруза = Неопределено;
				ВнутриСвГО = Ложь;
			КонецЕсли;
			ИмяТекстаСвИнНеУч = "";
			
		КонецЕсли;
		
	КонецЦикла;
	
	ЧтениеXML.Закрыть();
	
	Возврат Результат;
	
КонецФункции

Процедура САБ_ЗаписатьПолеИнострГО(ДанныеСтроки, ИмяПоляXML, ЗначениеПоля)
	
	ЗначениеАтрибута = СокрЛП(Строка(ЗначениеПоля));
	Если Не ЗначениеЗаполнено(ЗначениеАтрибута) Тогда
		Возврат;
	КонецЕсли;
	
	Если ИмяПоляXML = "ИдСтат" Тогда
		ДанныеСтроки.Вставить("ГрузоотправительИнострЛицоБезУчетаСтатусИО_ИГ", ЗначениеАтрибута);
		ДанныеСтроки.Вставить("ГрузоотправительИнострЛицоБезУчетаИдентификацияСтатуса", ЗначениеАтрибута);
	ИначеЕсли ИмяПоляXML = "КодСтр" Тогда
		ДанныеСтроки.Вставить("ГрузоотправительИнострЛицоБезУчетаКодСтраны", ЗначениеАтрибута);
	ИначеЕсли ИмяПоляXML = "НаимСтран" Тогда
		ДанныеСтроки.Вставить("ГрузоотправительИнострЛицоБезУчетаСтрана", ЗначениеАтрибута);
	ИначеЕсли ИмяПоляXML = "Наим" Тогда
		ДанныеСтроки.Вставить("ГрузоотправительИнострЛицоБезУчетаНаименование", ЗначениеАтрибута);
	ИначеЕсли ИмяПоляXML = "Идентиф" Тогда
		ДанныеСтроки.Вставить("ГрузоотправительИнострЛицоБезУчетаИдентификатор", ЗначениеАтрибута);
	ИначеЕсли ИмяПоляXML = "ИныеСвед" Тогда
		ДанныеСтроки.Вставить("ГрузоотправительИнострЛицоБезУчетаИныеСведения", ЗначениеАтрибута);
	КонецЕсли;
	
КонецПроцедуры

Процедура САБ_ЗаписатьРеквизитыГрузаЭПЭ(ДокументСсылка, Организация, СтруктураТитула, ДобавленныеКлючи)
	
	Если Не ЗначениеЗаполнено(ДокументСсылка) Или Не ЗначениеЗаполнено(Организация) Тогда
		Возврат;
	КонецЕсли;
	
	Титул = Перечисления.ТипыЭлементовРегламентаЭДО.ЭПЭ_Титул1;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕСТЬNULL(МАКСИМУМ(ВерсииТитуловЭПД.НомерВерсии), 0) КАК НомерВерсии
	|ИЗ
	|	РегистрСведений.ВерсииТитуловЭПД КАК ВерсииТитуловЭПД
	|ГДЕ
	|	ВерсииТитуловЭПД.Документ = &Документ
	|	И ВерсииТитуловЭПД.Титул = &Титул";
	Запрос.УстановитьПараметр("Документ", ДокументСсылка);
	Запрос.УстановитьПараметр("Титул", Титул);
	
	Выборка = Запрос.Выполнить().Выбрать();
	НомерВерсии = 0;
	Если Выборка.Следующий() Тогда
		НомерВерсии = Выборка.НомерВерсии;
	КонецЕсли;
	
	Для Каждого Ключ Из ДобавленныеКлючи Цикл
		
		Значение = Неопределено;
		СтруктураТитула.Свойство(Ключ, Значение);
		Если Не ЗначениеЗаполнено(Значение) Тогда
			Продолжить;
		КонецЕсли;
		
		НаборЗаписей = РегистрыСведений.ЗначенияРеквизитовДокументовЭПД.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Документ.Установить(ДокументСсылка);
		НаборЗаписей.Отбор.Организация.Установить(Организация);
		НаборЗаписей.Отбор.Титул.Установить(Титул);
		НаборЗаписей.Отбор.НомерВерсии.Установить(НомерВерсии);
		НаборЗаписей.Отбор.ИмяРеквизита.Установить(Ключ);
		
		Запись = НаборЗаписей.Добавить();
		Запись.Документ = ДокументСсылка;
		Запись.Организация = Организация;
		Запись.Титул = Титул;
		Запись.НомерВерсии = НомерВерсии;
		Запись.ИмяРеквизита = Ключ;
		
		Если ТипЗнч(Значение) = Тип("Строка") Тогда
			Запись.ЗначениеРеквизитаСтрока = Значение;
		Иначе
			Запись.ЗначениеРеквизита = Значение;
		КонецЕсли;
		
		НаборЗаписей.Записать();
		
	КонецЦикла;
	
КонецПроцедуры

#Область саб_ЗагрузкаЭПЭ

// Возвращает данные заполнения исходящего ЭПЭ по XML титула заказчика (ON_POREXPKLT).
//
// Параметры:
//  ДвоичныеДанныеФайла - ДвоичныеДанные - содержимое файла обмена.
//
// Возвращаемое значение:
//  Структура:
//   * Успех - Булево
//   * ТекстОшибки - Строка
//   * ДанныеДляЗаполнения - Структура - значения заполнения формы документа
//
Функция саб_ДанныеЗаполненияЭПЭИзДвоичныхДанных(ДвоичныеДанныеФайла) Экспорт
	
	Результат = саб_НовыйРезультатЗагрузкиЭПЭ();
	
	Если ДвоичныеДанныеФайла = Неопределено Тогда
		Результат.ТекстОшибки = НСтр("ru = 'Не переданы данные XML-файла.'");
		Возврат Результат;
	КонецЕсли;
	
	// Файл Conterra и аналоги не всегда проходит XSD макета СхемаТитулЗаказчика
	// (например НомПломб не целое, лишние знаки в весе). Читаем без схемы,
	// как типовые ПредставлениеФайлаПрикладногоЭлектронногоДокумента / ПрочитатьСодержаниеДокумента.
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.ОткрытьПоток(ДвоичныеДанныеФайла.ОткрытьПотокДляЧтения());
	
	Попытка
		ОбъектXDTO = ФабрикаXDTO.ПрочитатьXML(ЧтениеXML);
	Исключение
		ЧтениеXML.Закрыть();
		Результат.ТекстОшибки = СтрШаблон(
			НСтр("ru = 'Не удалось прочитать XML: %1'"),
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Результат;
	КонецПопытки;
	
	ЧтениеXML.Закрыть();
	
	Если ТипЗнч(ОбъектXDTO) <> Тип("ОбъектXDTO") Тогда
		Результат.ТекстОшибки = НСтр("ru = 'Не удалось разобрать XML-файл.'");
		Возврат Результат;
	КонецЕсли;
	
	КлючеваяИнформацияПоТитулу = саб_КлючеваяИнформацияТитулаЗаказчикаЭПЭ(ОбъектXDTO);
	
	Если КлючеваяИнформацияПоТитулу = Неопределено Тогда
		Результат.ТекстОшибки = НСтр("ru = 'Ожидается XML титула заказчика ЭПЭ (КНД 1110486 / ON_POREXPKLT).'");
		Возврат Результат;
	КонецЕсли;
	
	МенеджерОбъекта = Документы.ЭлектронноеПоручениеЭкспедитору;
	
	СтруктураРеквизитов = Новый Структура;
	ДокументОбъект = Новый Структура("ДополнительныеСвойства,ТипДокумента,ТекущийПолученныйТитул",
		Новый Структура, КлючеваяИнформацияПоТитулу.ТипДокумента, КлючеваяИнформацияПоТитулу.Титул);
	ДокументОбъект.ДополнительныеСвойства.Вставить("СтруктураРеквизитов", СтруктураРеквизитов);
	
	МакетСоответствиеИмен = МенеджерОбъекта.ПолучитьМакет("СоответствиеИменРеквизитов"
		+ ПостфиксМакетаПоНомеруВерсии(КлючеваяИнформацияПоТитулу.ВерсияФормата));
	ОбластьПоискаИмен = МакетСоответствиеИмен.ПолучитьОбласть(КлючеваяИнформацияПоТитулу.ПрефиксТитула);
	
	саб_ЗаполнитьЭПДПоОбъектуXDTOРекурсивно(ОбъектXDTO, ДокументОбъект, ОбластьПоискаИмен,
		Новый Соответствие, "//Файл", Новый Массив);
	
	саб_ОчиститьСлужебныеРеквизитыФайлаЭПЭ(СтруктураРеквизитов);
	саб_НормализоватьИННВСтруктуреЭПЭ(СтруктураРеквизитов);
	
	ЗадатьСсылкуНаКонтрагента(ДокументОбъект, "ТитулЗаказчикаЗаказчик", "Организации");
	ЗадатьСсылкуНаКонтрагента(ДокументОбъект, "ТитулЗаказчикаСоставитель", "Организации");
	ЗадатьСсылкуНаКонтрагента(ДокументОбъект, "ТитулЗаказчикаЭкспедитор");
	саб_ПодставитьКонтрагентаПоИННЕслиПустая(СтруктураРеквизитов, "ТитулЗаказчикаЭкспедитор");
	саб_ПодставитьУчастниковГрузовЭПЭ(СтруктураРеквизитов);
	САБ_ДополнитьИнострГрузоотправителяВСтруктуреЭПЭ(СтруктураРеквизитов, Неопределено, ДвоичныеДанныеФайла);
	
	ЗаполнитьПредставленияСсылочныхТипов(ДокументОбъект);
	ЗаполнитьПредставлениеХранимыхДанныхОбъекта(СтруктураРеквизитов,
		"Документ.ЭлектронноеПоручениеЭкспедитору", ОбластьПоискаИмен);
	
	Если ЗначениеЗаполнено(КлючеваяИнформацияПоТитулу.Номер) Тогда
		СтруктураРеквизитов.Вставить("ТитулЗаказчикаНомер", КлючеваяИнформацияПоТитулу.Номер);
	КонецЕсли;
	Если ЗначениеЗаполнено(КлючеваяИнформацияПоТитулу.Дата) Тогда
		СтруктураРеквизитов.Вставить("ТитулЗаказчикаДата", КлючеваяИнформацияПоТитулу.Дата);
	КонецЕсли;
	
	СтруктураРеквизитов.Вставить("ЭтоВходящий", Ложь);
	СтруктураРеквизитов.Вставить("РольУчастника", 3);
	СтруктураРеквизитов.Вставить("ТекущийТитул", Перечисления.ТипыЭлементовРегламентаЭДО.ЭПЭ_Титул1);
	
	СсылкаЗаказчика = Неопределено;
	СтруктураРеквизитов.Свойство("СсылкаТитулЗаказчикаЗаказчик", СсылкаЗаказчика);
	Если ТипЗнч(СсылкаЗаказчика) = Тип("СправочникСсылка.Организации") Тогда
		СтруктураРеквизитов.Вставить("Организация", СсылкаЗаказчика);
	Иначе
		СсылкаСоставителя = Неопределено;
		СтруктураРеквизитов.Свойство("СсылкаТитулЗаказчикаСоставитель", СсылкаСоставителя);
		Если ТипЗнч(СсылкаСоставителя) = Тип("СправочникСсылка.Организации") Тогда
			СтруктураРеквизитов.Вставить("Организация", СсылкаСоставителя);
		КонецЕсли;
	КонецЕсли;
	
	саб_ПодставитьДоговорЭПЭ(СтруктураРеквизитов);
	
	Результат.Успех = Истина;
	саб_ОставитьТолькоКорректныеКлючиТаблицЭПЭ(СтруктураРеквизитов);
	Результат.ДанныеДляЗаполнения = СтруктураРеквизитов;
	Возврат Результат;
	
КонецФункции

Функция саб_КлючеваяИнформацияТитулаЗаказчикаЭПЭ(ОбъектXDTO)
	
	Если ТипЗнч(ОбъектXDTO) <> Тип("ОбъектXDTO") Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ИдФайл = Строка(ЗначениеНеобязательногоСвойства(ОбъектXDTO, "ИдФайл", , ""));
	ДокументXDTO = ЗначениеНеобязательногоСвойства(ОбъектXDTO, "Документ");
	ЭтоТитулЗаказчика = СтрНачинаетсяС(ИдФайл, "ON_POREXPKLT");
	
	Если Не ЭтоТитулЗаказчика И ТипЗнч(ДокументXDTO) = Тип("ОбъектXDTO") Тогда
		КНД = Строка(ЗначениеНеобязательногоСвойства(ДокументXDTO, "КНД", , ""));
		НаимДок = НРег(Строка(ЗначениеНеобязательногоСвойства(ДокументXDTO, "НаимДок", , "")));
		ЭтоТитулЗаказчика = (КНД = "1110486")
			Или (ЕстьСвойство(ДокументXDTO, "СодИнфКлнт")
				И СтрНайти(НаимДок, "поручение экспедитору") > 0);
	КонецЕсли;
	
	Если Не ЭтоТитулЗаказчика Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Результат = Новый Структура("ПолеПоиска, ЗначениеИДПоиска, ТипДокумента, ПрефиксТитула,
		|ВерсияФормата, Титул, МинтрансИД, Номер, Дата, НомерВерсии, ДатаВерсии,
		|ЭтоИсправление, ПоДоверенности");
	Результат.ТипДокумента = Перечисления.ТипыДокументовЭДО.ЭПЭ;
	Результат.ПрефиксТитула = "ТитулЗаказчика";
	Результат.Титул = Перечисления.ТипыЭлементовРегламентаЭДО.ЭПЭ_Титул1;
	Результат.ПолеПоиска = "ТитулЗаказчикаИдентификаторФайла";
	Результат.ЗначениеИДПоиска = ИдФайл;
	Результат.ВерсияФормата = Строка(ЗначениеНеобязательногоСвойства(ОбъектXDTO, "ВерсФорм", , "5.01"));
	Результат.НомерВерсии = 0;
	Результат.ЭтоИсправление = Ложь;
	Результат.ПоДоверенности = Ложь;
	Результат.МинтрансИД = "";
	Результат.Номер = "";
	Результат.Дата = '00010101';
	Результат.ДатаВерсии = '00010101';
	
	Если ТипЗнч(ДокументXDTO) <> Тип("ОбъектXDTO") Тогда
		Возврат Результат;
	КонецЕсли;
	
	СодИнфКлнт = ЗначениеНеобязательногоСвойства(ДокументXDTO, "СодИнфКлнт");
	Если ТипЗнч(СодИнфКлнт) = Тип("ОбъектXDTO") Тогда
		Результат.МинтрансИД = ЗначениеНеобязательногоСвойства(СодИнфКлнт, "УИД_ПорЭксп", , "");
		Результат.Номер = ЗначениеНеобязательногоСвойства(СодИнфКлнт, "НомДок", , "");
		Результат.Дата = ОбменСГИСЭПДКлиентСервер.ПреобразоватьВДату(
			ЗначениеНеобязательногоСвойства(СодИнфКлнт, "ДатаДок", , ""));
	КонецЕсли;
	
	ВремяВерсии = ОбменСГИСЭПДКлиентСервер.ПреобразоватьВДату(
		ЗначениеНеобязательногоСвойства(ДокументXDTO, "ВрИнфКлнт", , ""));
	ДатаВерсии = ОбменСГИСЭПДКлиентСервер.ПреобразоватьВДату(
		ЗначениеНеобязательногоСвойства(ДокументXDTO, "ДатИнфКлнт", , ""));
	Результат.ДатаВерсии = ДатаВерсии
		+ 60 * 60 * Час(ВремяВерсии)
		+ 60 * Минута(ВремяВерсии)
		+ Секунда(ВремяВерсии);
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область саб_ЗагрузкаЭПЭСлужебные

Функция саб_НовыйРезультатЗагрузкиЭПЭ()
	
	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("ТекстОшибки", "");
	Результат.Вставить("ДанныеДляЗаполнения", Новый Структура);
	Возврат Результат;
	
КонецФункции

Процедура саб_ОчиститьСлужебныеРеквизитыФайлаЭПЭ(СтруктураРеквизитов)
	
	РеквизитыДляУдаления = Новый Массив;
	РеквизитыДляУдаления.Добавить("ТитулЗаказчикаУИДМинтранс");
	РеквизитыДляУдаления.Добавить("ТитулЗаказчикаВерсияПрограммы");
	РеквизитыДляУдаления.Добавить("ТитулЗаказчикаВерсияФормата");
	РеквизитыДляУдаления.Добавить("ТитулЗаказчикаИдентификаторФайла");
	РеквизитыДляУдаления.Добавить("ТитулЗаказчикаДатаФормированияФайла");
	РеквизитыДляУдаления.Добавить("ТитулЗаказчикаВремяФормированияФайла");
	
	Для Каждого КлючИЗначение Из СтруктураРеквизитов Цикл
		Если СтрНайти(КлючИЗначение.Ключ, "Подпис") > 0 Тогда
			РеквизитыДляУдаления.Добавить(КлючИЗначение.Ключ);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого ИмяРеквизита Из РеквизитыДляУдаления Цикл
		Если СтруктураРеквизитов.Свойство(ИмяРеквизита) Тогда
			СтруктураРеквизитов.Удалить(ИмяРеквизита);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// Заполнение по XDTO без схемы: одиночный повторяемый узел приходит как ОбъектXDTO,
// а не СписокXDTO. Типовой обход тогда вызывает Количество() у Неопределено.
Процедура саб_ЗаполнитьЭПДПоОбъектуXDTOРекурсивно(ОбъектXDTO, ДокументОбъект, МакетСоответствиеИмен,
	СчетчикСтрок, Знач УзелРодителя, Знач УровниИерархий)
	
	Если ДокументОбъект.ДополнительныеСвойства.Свойство("СтруктураРеквизитов") = Ложь Тогда
		ДокументОбъект.ДополнительныеСвойства.Вставить("СтруктураРеквизитов", Новый Структура);
	КонецЕсли;
	
	Если УровниИерархий = Неопределено Тогда
		УровниИерархий = Новый Массив;
	КонецЕсли;
	
	МассивОбъектовXDTO = Новый Массив;
	Если ТипЗнч(ОбъектXDTO) = Тип("Строка") Или ТипЗнч(ОбъектXDTO) = Тип("Число") Тогда
		МассивОбъектовXDTO.Добавить(Новый Структура("Имя, Объект", "", ОбъектXDTO));
	Иначе
		Для Каждого ТекущееСвойство Из ОбъектXDTO.Свойства() Цикл
			ТекущийОбъектXDTO = ОбъектXDTO[ТекущееСвойство.Имя];
			МассивОбъектовXDTO.Добавить(Новый Структура("Имя, Объект", ТекущееСвойство.Имя, ТекущийОбъектXDTO));
		КонецЦикла;
	КонецЕсли;
	
	Для Каждого ТекущийОбъектXDTO Из МассивОбъектовXDTO Цикл
		ТекущийУзел = УзелРодителя + "/" + ТекущийОбъектXDTO.Имя;
		Если ТипЗнч(ТекущийОбъектXDTO.Объект) = Тип("СписокXDTO") Тогда
			саб_ЗаполнитьТаблицуЭПДПоКоллекцииXDTO(ТекущийОбъектXDTO.Объект, ДокументОбъект,
				МакетСоответствиеИмен, СчетчикСтрок, ТекущийУзел, УровниИерархий);
		ИначеЕсли ТипЗнч(ТекущийОбъектXDTO.Объект) = Тип("ОбъектXDTO") Тогда
			Если ТекущийОбъектXDTO.Объект.Свойства().Количество() = 0 Тогда
				// Без XSD простой узел (<НомПломб>VS0382059</НомПломб>) — ОбъектXDTO с текстом
				// в последовательности, не строка. Типовой обход тогда не пишет значение.
				ТекстУзла = саб_ТекстовоеСодержимоеXDTO(ТекущийОбъектXDTO.Объект);
				Если ТекстУзла <> Неопределено Тогда
					саб_ЗаполнитьРеквизитЭПДПоЗначениюXDTO(ТекстУзла, ДокументОбъект,
						МакетСоответствиеИмен, СчетчикСтрок,
						саб_УзелДляСкалярногоЗначенияЭПД(МакетСоответствиеИмен, ТекущийУзел),
						УровниИерархий);
				КонецЕсли;
			ИначеЕсли саб_УзелЭПДЭтоТаблица(МакетСоответствиеИмен, ТекущийУзел) Тогда
				КоллекцияИзОдного = Новый Массив;
				КоллекцияИзОдного.Добавить(ТекущийОбъектXDTO.Объект);
				саб_ЗаполнитьТаблицуЭПДПоКоллекцииXDTO(КоллекцияИзОдного, ДокументОбъект,
					МакетСоответствиеИмен, СчетчикСтрок, ТекущийУзел, УровниИерархий);
			Иначе
				саб_ЗаполнитьЭПДПоОбъектуXDTOРекурсивно(ТекущийОбъектXDTO.Объект, ДокументОбъект,
					МакетСоответствиеИмен, СчетчикСтрок, ТекущийУзел, УровниИерархий);
			КонецЕсли;
		Иначе
			саб_ЗаполнитьРеквизитЭПДПоЗначениюXDTO(ТекущийОбъектXDTO.Объект, ДокументОбъект,
				МакетСоответствиеИмен, СчетчикСтрок,
				саб_УзелДляСкалярногоЗначенияЭПД(МакетСоответствиеИмен, ТекущийУзел),
				УровниИерархий);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция саб_УзелЭПДЭтоТаблица(МакетСоответствиеИмен, ТекущийУзел)
	
	ОбластьКолонкаУзлов = МакетСоответствиеИмен.Область(, 2, МакетСоответствиеИмен.ВысотаТаблицы, 2);
	ОбластьНайдено = МакетСоответствиеИмен.НайтиТекст(ТекущийУзел, , ОбластьКолонкаУзлов, Ложь, Истина, Истина, Ложь);
	Если ОбластьНайдено = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ИмяРеквизита = МакетСоответствиеИмен.Область(ОбластьНайдено.Верх, 1).Текст;
	Возврат ЗначениеЗаполнено(саб_ИмяПервойКолонкиТаблицыЭПД(МакетСоответствиеИмен, ИмяРеквизита));
	
КонецФункции

// Колонка макета — «ТитулЗаказчикаОписаниеГруза.НаимГруз», не «ТитулЗаказчикаОписаниеГруза.»:
// НайтиТекст с ЯчейкаЦеликом=Истина такую ячейку не находит, ОпГруз не считается таблицей.
Функция саб_ИмяПервойКолонкиТаблицыЭПД(МакетСоответствиеИмен, ИмяТаблицы)
	
	Если Не ЗначениеЗаполнено(ИмяТаблицы) Или СтрНайти(ИмяТаблицы, ".") > 0 Тогда
		Возврат "";
	КонецЕсли;
	
	ОбластьКолонкаИмен = МакетСоответствиеИмен.Область(, 1, МакетСоответствиеИмен.ВысотаТаблицы, 1);
	ОбластьКолонкиТаблицы = МакетСоответствиеИмен.НайтиТекст(ИмяТаблицы + ".", , ОбластьКолонкаИмен, Ложь, Ложь, Ложь, Ложь);
	Если ОбластьКолонкиТаблицы = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат МакетСоответствиеИмен.Область(ОбластьКолонкиТаблицы.Верх, 1).Текст;
	
КонецФункции

// Макет кладёт текст простого узла в путь со слэшем на конце
// (`.../НомПломб/`, не `.../НомПломб`). Без схемы свойство даёт путь без слэша.
Функция саб_УзелДляСкалярногоЗначенияЭПД(МакетСоответствиеИмен, ТекущийУзел)
	
	Если СтрЗаканчиваетсяНа(ТекущийУзел, "/") Тогда
		Возврат ТекущийУзел;
	КонецЕсли;
	
	УзелСоСлэшем = ТекущийУзел + "/";
	ОбластьКолонкаУзлов = МакетСоответствиеИмен.Область(, 2, МакетСоответствиеИмен.ВысотаТаблицы, 2);
	ОбластьНайдено = МакетСоответствиеИмен.НайтиТекст(УзелСоСлэшем, , ОбластьКолонкаУзлов, Ложь, Истина, Истина, Ложь);
	Если ОбластьНайдено = Неопределено Тогда
		Возврат ТекущийУзел;
	КонецЕсли;
	
	ИмяРеквизита = МакетСоответствиеИмен.Область(ОбластьНайдено.Верх, 1).Текст;
	Если СтрНайти(ИмяРеквизита, ".") = 0 Тогда
		Возврат ТекущийУзел;
	КонецЕсли;
	
	Возврат УзелСоСлэшем;
	
КонецФункции

Функция саб_ТекстовоеСодержимоеXDTO(ОбъектXDTO)
	
	ПоследовательностьУзла = ОбъектXDTO.Последовательность();
	Если ПоследовательностьУзла.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Попытка
		ТекстУзла = ПоследовательностьУзла.ПолучитьТекст(0);
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(ТекстУзла) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат ТекстУзла;
	
КонецФункции

Функция саб_СкопироватьУровниИерархийЭПД(УровниИерархий)
	
	Результат = Новый Массив;
	Если УровниИерархий = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	Для Индекс = 0 По УровниИерархий.ВГраница() Цикл
		Результат.Добавить(УровниИерархий[Индекс]);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Процедура саб_ЗаполнитьТаблицуЭПДПоКоллекцииXDTO(КоллекцияЭлементов, ДокументОбъект, МакетСоответствиеИмен,
	СчетчикСтрок, ТекущийУзел, УровниИерархий)
	
	ОбластьКолонкаУзлов = МакетСоответствиеИмен.Область(, 2, МакетСоответствиеИмен.ВысотаТаблицы, 2);
	ОбластьНайдено = МакетСоответствиеИмен.НайтиТекст(ТекущийУзел, , ОбластьКолонкаУзлов, Ложь, Истина, Истина, Ложь);
	Если ОбластьНайдено = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИмяРеквизита = МакетСоответствиеИмен.Область(ОбластьНайдено.Верх, 1).Текст;
	НомерСтроки = СчетчикСтрок.Получить(ИмяРеквизита);
	Если НомерСтроки = Неопределено Тогда
		НомерСтроки = 0;
	КонецЕсли;
	
	УровниИерархийТекущий = саб_СкопироватьУровниИерархийЭПД(УровниИерархий);
	УровниИерархийТекущий.Добавить(0);
	
	Для Каждого ЭлементСпискаXDTO Из КоллекцияЭлементов Цикл
		НомерСтроки = НомерСтроки + 1;
		СчетчикСтрок.Вставить(ИмяРеквизита, НомерСтроки);
		УровниИерархийТекущий[УровниИерархийТекущий.ВГраница()] = Строка(Новый УникальныйИдентификатор);
		саб_ЗаполнитьЭПДПоОбъектуXDTOРекурсивно(ЭлементСпискаXDTO, ДокументОбъект, МакетСоответствиеИмен,
			СчетчикСтрок, ТекущийУзел, УровниИерархийТекущий);
	КонецЦикла;
	
КонецПроцедуры

Процедура саб_ЗаполнитьРеквизитЭПДПоЗначениюXDTO(ЗначениеXDTO, ДокументОбъект, МакетСоответствиеИмен,
	СчетчикСтрок, ТекущийУзел, УровниИерархий)
	
	ОбластьКолонкаУзлов = МакетСоответствиеИмен.Область(, 2, МакетСоответствиеИмен.ВысотаТаблицы, 2);
	ОбластьНайдено = МакетСоответствиеИмен.НайтиТекст(ТекущийУзел, , ОбластьКолонкаУзлов, Ложь, Истина, Истина, Ложь);
	Если ОбластьНайдено = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИмяРеквизита = МакетСоответствиеИмен.Область(ОбластьНайдено.Верх, 1).Текст;
	ТипРеквизита = МакетСоответствиеИмен.Область(ОбластьНайдено.Верх, 7).Текст;
	ЗначениеРеквизита = саб_ЗначениеРеквизитаЭПДПоТипу(ЗначениеXDTO, ТипРеквизита);
	
	Если СтрНайти(ИмяРеквизита, ".") = 0 Тогда
		ИмяКолонкиТаблицы = саб_ИмяПервойКолонкиТаблицыЭПД(МакетСоответствиеИмен, ИмяРеквизита);
		Если ЗначениеЗаполнено(ИмяКолонкиТаблицы) Тогда
			ИмяРеквизита = ИмяКолонкиТаблицы;
		КонецЕсли;
	КонецЕсли;
	
	Если СтрНайти(ИмяРеквизита, "НомПломб") > 0 Тогда
		ЗначениеРеквизита = саб_НомерПломбыКакЧисло(ЗначениеРеквизита);
	КонецЕсли;
	
	Если СтрНайти(ИмяРеквизита, ".") Тогда
		ИмяТЧИКолонки = СтрРазделить(ИмяРеквизита, ".");
		ИмяТаблицы = ИмяТЧИКолонки[0];
		УровниСтроки = УровниИерархий;
		НомерСтрокиТЧ = СчетчикСтрок.Получить(ИмяТаблицы);
		Если ТипЗнч(НомерСтрокиТЧ) <> Тип("Число") Тогда
			НомерСтрокиТЧ = 1;
			СчетчикСтрок.Вставить(ИмяТаблицы, 1);
			УровниСтроки = саб_СкопироватьУровниИерархийЭПД(УровниИерархий);
			УровниСтроки.Добавить(Строка(Новый УникальныйИдентификатор));
		КонецЕсли;
		ПрефиксСтрокиТЧ = ИмяТаблицы + "__" + Формат(НомерСтрокиТЧ, "ЧГ=0");
		ИмяРеквизитаСтрокиТЧ = ПрефиксСтрокиТЧ + "__" + ИмяТЧИКолонки[1];
		Если ТипРеквизита = "Дата" Тогда
			ТекущееЗначение = Неопределено;
			Если ДокументОбъект.ДополнительныеСвойства.СтруктураРеквизитов.Свойство(ИмяРеквизитаСтрокиТЧ, ТекущееЗначение) Тогда
				ЗначениеРеквизита = ОбменСГИСЭПДКлиентСервер.СложитьЧастиДат(ТекущееЗначение, ЗначениеРеквизита);
			КонецЕсли;
		КонецЕсли;
		ДокументОбъект.ДополнительныеСвойства.СтруктураРеквизитов.Вставить(ИмяРеквизитаСтрокиТЧ, ЗначениеРеквизита);
		саб_ДописатьАлиасИнострСтатусаЭПЭ(ДокументОбъект.ДополнительныеСвойства.СтруктураРеквизитов,
			ИмяРеквизитаСтрокиТЧ, ЗначениеРеквизита);
		Если УровниСтроки.Количество() > 0 Тогда
			ДокументОбъект.ДополнительныеСвойства.СтруктураРеквизитов.Вставить(
				ПрефиксСтрокиТЧ + "__ИдентификаторСтроки", УровниСтроки[УровниСтроки.ВГраница()]);
		КонецЕсли;
		Если УровниСтроки.Количество() > 1 Тогда
			ДокументОбъект.ДополнительныеСвойства.СтруктураРеквизитов.Вставить(
				ПрефиксСтрокиТЧ + "__ИдентификаторСтрокиРодителя", УровниСтроки[УровниСтроки.ВГраница() - 1]);
		КонецЕсли;
	Иначе
		Если ТипРеквизита = "Дата" Тогда
			ТекущееЗначение = Неопределено;
			Если ДокументОбъект.ДополнительныеСвойства.СтруктураРеквизитов.Свойство(ИмяРеквизита, ТекущееЗначение) Тогда
				ЗначениеРеквизита = ОбменСГИСЭПДКлиентСервер.СложитьЧастиДат(ТекущееЗначение, ЗначениеРеквизита);
			КонецЕсли;
		КонецЕсли;
		ДокументОбъект.ДополнительныеСвойства.СтруктураРеквизитов.Вставить(ИмяРеквизита, ЗначениеРеквизита);
		саб_ДописатьАлиасИнострСтатусаЭПЭ(ДокументОбъект.ДополнительныеСвойства.СтруктураРеквизитов,
			ИмяРеквизита, ЗначениеРеквизита);
	КонецЕсли;
	
КонецПроцедуры

Функция саб_ЗначениеРеквизитаЭПДПоТипу(ЗначениеXDTO, ТипРеквизита)
	
	Если ТипРеквизита = "Дата" Или ТипРеквизита = "Время" Тогда
		Возврат ОбменСГИСЭПДКлиентСервер.ПреобразоватьВДату(ЗначениеXDTO);
	ИначеЕсли ТипРеквизита = "Число" Тогда
		Если ТипЗнч(ЗначениеXDTO) = Тип("Число") Тогда
			Возврат ЗначениеXDTO;
		КонецЕсли;
		Попытка
			Возврат ОбменСГИСЭПДКлиентСервер.ПреобразоватьВЧисло(ЗначениеXDTO);
		Исключение
			Возврат ЗначениеXDTO;
		КонецПопытки;
	ИначеЕсли ТипРеквизита = "Булево" Тогда
		Возврат ОбменСГИСЭПДКлиентСервер.ПреобразоватьВБулево(ЗначениеXDTO);
	КонецЕсли;
	
	Возврат ЗначениеXDTO;
	
КонецФункции

// Макет и форма ввода пломбы — тип Число. Conterra даёт VS0382059; буквы отбрасываем.
Функция саб_НомерПломбыКакЧисло(ЗначениеПломбы)
	
	Если ТипЗнч(ЗначениеПломбы) = Тип("Число") Тогда
		Возврат ЗначениеПломбы;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ЗначениеПломбы) Тогда
		Возврат ЗначениеПломбы;
	КонецЕсли;
	
	ТолькоЦифры = "";
	СтрокаПломбы = СокрЛП(Строка(ЗначениеПломбы));
	Для ИндексСимвола = 1 По СтрДлина(СтрокаПломбы) Цикл
		СимволПломбы = Сред(СтрокаПломбы, ИндексСимвола, 1);
		Если СтрНайти("0123456789", СимволПломбы) > 0 Тогда
			ТолькоЦифры = ТолькоЦифры + СимволПломбы;
		КонецЕсли;
	КонецЦикла;
	
	Если Не ЗначениеЗаполнено(ТолькоЦифры) Тогда
		Возврат ЗначениеПломбы;
	КонецЕсли;
	
	Возврат Число(ТолькоЦифры);
	
КонецФункции

// Типовой СсылкаНаОбъектПоИННКПП ищет ЮЛ по ИНН+КПП. В файле Conterra КПП нет,
// а в карточке контрагента КПП обычно заполнен - точное совпадение не находится.
Процедура саб_ПодставитьКонтрагентаПоИННЕслиПустая(СтруктураРеквизитов, ПрефиксРеквизита)
	
	СсылкаКонтрагента = Неопределено;
	СтруктураРеквизитов.Свойство("Ссылка" + ПрефиксРеквизита, СсылкаКонтрагента);
	Если ЗначениеЗаполнено(СсылкаКонтрагента) Тогда
		Возврат;
	КонецЕсли;
	
	ИНН = "";
	СтруктураРеквизитов.Свойство(ПрефиксРеквизита + "ЮЛ_ИНН", ИНН);
	Если Не ЗначениеЗаполнено(ИНН) Тогда
		СтруктураРеквизитов.Свойство(ПрефиксРеквизита + "ИП_ИНН", ИНН);
	КонецЕсли;
	
	НайденныйКонтрагент = саб_КонтрагентПоИНН(ИНН);
	Если ЗначениеЗаполнено(НайденныйКонтрагент) Тогда
		СтруктураРеквизитов.Вставить("Ссылка" + ПрефиксРеквизита, НайденныйКонтрагент);
	КонецЕсли;
	
КонецПроцедуры

Функция саб_КонтрагентПоИНН(ИНН)
	
	Если Не ЗначениеЗаполнено(ИНН) Тогда
		Возврат Справочники.Контрагенты.ПустаяСсылка();
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Контрагенты.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Контрагенты КАК Контрагенты
	|ГДЕ
	|	Контрагенты.ИНН = &ИНН
	|	И НЕ Контрагенты.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	Контрагенты.ОбособленноеПодразделение,
	|	Контрагенты.Наименование";
	Запрос.УстановитьПараметр("ИНН", саб_ИННСтрокой(ИНН));
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Справочники.Контрагенты.ПустаяСсылка();
	
КонецФункции

// В ЭПЭ грузоотправитель и грузополучатель живут в строках ТЧ ТитулЗаказчикаГрузы
// (ключи ТитулЗаказчикаГрузы__N__СсылкаГрузоотправитель). Типовой
// ЗаполнитьПредставленияСсылочныхТипов для ЭПЭ ждёт ДокументОбъект, а не структуру.
Процедура саб_ПодставитьУчастниковГрузовЭПЭ(СтруктураРеквизитов)
	
	НомерСтроки = 1;
	КлючСтроки = "ТитулЗаказчикаГрузы__" + Формат(НомерСтроки, "ЧГ=0") + "__ИдентификаторСтроки";
	Пока СтруктураРеквизитов.Свойство(КлючСтроки) Цикл
		
		саб_ПодставитьСсылкуУчастникаСтрокиГрузаЭПЭ(СтруктураРеквизитов, НомерСтроки, "Грузоотправитель");
		саб_ПодставитьСсылкуУчастникаСтрокиГрузаЭПЭ(СтруктураРеквизитов, НомерСтроки, "Грузополучатель");
		
		НомерСтроки = НомерСтроки + 1;
		КлючСтроки = "ТитулЗаказчикаГрузы__" + Формат(НомерСтроки, "ЧГ=0") + "__ИдентификаторСтроки";
		
	КонецЦикла;
	
КонецПроцедуры

Процедура саб_ПодставитьСсылкуУчастникаСтрокиГрузаЭПЭ(СтруктураРеквизитов, НомерСтроки, ПостфиксУчастника)
	
	НомерСтрокиСтрокой = Формат(НомерСтроки, "ЧГ=0");
	КлючСсылки = "ТитулЗаказчикаГрузы__" + НомерСтрокиСтрокой + "__Ссылка" + ПостфиксУчастника;
	
	ТекущаяСсылка = Неопределено;
	СтруктураРеквизитов.Свойство(КлючСсылки, ТекущаяСсылка);
	Если ЗначениеЗаполнено(ТекущаяСсылка) Тогда
		Возврат;
	КонецЕсли;
	
	ПрефиксУчастника = "ТитулЗаказчикаГрузы__" + НомерСтрокиСтрокой + "__" + ПостфиксУчастника;
	ИНН = "";
	СтруктураРеквизитов.Свойство(ПрефиксУчастника + "ЮЛ_ИНН", ИНН);
	Если Не ЗначениеЗаполнено(ИНН) Тогда
		СтруктураРеквизитов.Свойство(ПрефиксУчастника + "ИП_ИНН", ИНН);
	КонецЕсли;
	
	НайденныйКонтрагент = саб_КонтрагентПоИНН(ИНН);
	Если ЗначениеЗаполнено(НайденныйКонтрагент) Тогда
		СтруктураРеквизитов.Вставить(КлючСсылки, НайденныйКонтрагент);
		Возврат;
	КонецЕсли;
	
	ЗаполнитьПредставлениеСсылкиУчастника(СтруктураРеквизитов, ПрефиксУчастника);
	
	ТекущаяСсылка = Неопределено;
	СтруктураРеквизитов.Свойство(КлючСсылки, ТекущаяСсылка);
	Если ЗначениеЗаполнено(ТекущаяСсылка) Тогда
		Возврат;
	КонецЕсли;
	
	САБ_ДописатьАлиасИнострСтатусаВСтрокеГруза(СтруктураРеквизитов, ПрефиксУчастника);
	САБ_ПодставитьСсылкуИнострУчастникаСтроки(СтруктураРеквизитов,
		"ТитулЗаказчикаГрузы__" + НомерСтрокиСтрокой + "__", ПрефиксУчастника, "Ссылка" + ПостфиксУчастника);
	
КонецПроцедуры

// Типовой разбор XML пишет только Наименование/Номер/Дата договора. Ссылку
// Справочник.ДоговорыКонтрагентов типовой код подставляет лишь при заполнении
// из документа-основания (основной договор экспедитора), не по номеру из файла.
Процедура саб_ПодставитьДоговорЭПЭ(СтруктураРеквизитов)
	
	ТекущаяСсылка = Неопределено;
	СтруктураРеквизитов.Свойство("СсылкаТитулЗаказчикаДоговор", ТекущаяСсылка);
	Если ЗначениеЗаполнено(ТекущаяСсылка) Тогда
		Возврат;
	КонецЕсли;
	
	НомерДоговора = "";
	НаименованиеДоговора = "";
	ДатаДоговора = Неопределено;
	СтруктураРеквизитов.Свойство("ТитулЗаказчикаДоговорНомер", НомерДоговора);
	СтруктураРеквизитов.Свойство("ТитулЗаказчикаДоговорНаименование", НаименованиеДоговора);
	СтруктураРеквизитов.Свойство("ТитулЗаказчикаДоговорДата", ДатаДоговора);
	
	НомерДоговора = СокрЛП(Строка(НомерДоговора));
	НаименованиеДоговора = СокрЛП(Строка(НаименованиеДоговора));
	Если Не ЗначениеЗаполнено(НомерДоговора) И Не ЗначениеЗаполнено(НаименованиеДоговора) Тогда
		Возврат;
	КонецЕсли;
	
	Организация = Неопределено;
	СтруктураРеквизитов.Свойство("Организация", Организация);
	Экспедитор = Неопределено;
	СтруктураРеквизитов.Свойство("СсылкаТитулЗаказчикаЭкспедитор", Экспедитор);
	
	НайденныйДоговор = саб_ДоговорКонтрагентаПоРеквизитамЭПЭ(
		НомерДоговора, НаименованиеДоговора, ДатаДоговора, Организация, Экспедитор);
	Если Не ЗначениеЗаполнено(НайденныйДоговор) Тогда
		Возврат;
	КонецЕсли;
	
	СтруктураРеквизитов.Вставить("СсылкаТитулЗаказчикаДоговор", НайденныйДоговор);
	ОбменСГИСЭПДКлиентСервер.ЗаполнитьРеквизитыДоговора(
		НайденныйДоговор, "ТитулЗаказчикаДоговор", СтруктураРеквизитов);
	
КонецПроцедуры

Функция саб_ДоговорКонтрагентаПоРеквизитамЭПЭ(НомерДоговора, НаименованиеДоговора, ДатаДоговора, Организация, Экспедитор)
	
	НомерДляПоиска = саб_НомерДоговораНормализованный(НомерДоговора);
	Если Не ЗначениеЗаполнено(НомерДляПоиска) Тогда
		НомерДляПоиска = саб_НомерДоговораНормализованный(НаименованиеДоговора);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(НомерДляПоиска) Тогда
		Возврат Справочники.ДоговорыКонтрагентов.ПустаяСсылка();
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ДоговорыКонтрагентов.Ссылка КАК Ссылка,
	|	ДоговорыКонтрагентов.Номер КАК Номер,
	|	ДоговорыКонтрагентов.Дата КАК Дата
	|ИЗ
	|	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
	|ГДЕ
	|	НЕ ДоговорыКонтрагентов.ПометкаУдаления
	|	И НЕ ДоговорыКонтрагентов.ЭтоГруппа
	|	И (НЕ &ОтборПоВладельцу
	|			ИЛИ ДоговорыКонтрагентов.Владелец = &Владелец)
	|	И (НЕ &ОтборПоОрганизации
	|			ИЛИ ДоговорыКонтрагентов.Организация = &Организация)";
	
	ОтборПоВладельцу = ТипЗнч(Экспедитор) = Тип("СправочникСсылка.Контрагенты")
		И ЗначениеЗаполнено(Экспедитор);
	Запрос.УстановитьПараметр("ОтборПоВладельцу", ОтборПоВладельцу);
	Запрос.УстановитьПараметр("Владелец", ?(ОтборПоВладельцу, Экспедитор, Справочники.Контрагенты.ПустаяСсылка()));
	
	ОтборПоОрганизации = ТипЗнч(Организация) = Тип("СправочникСсылка.Организации")
		И ЗначениеЗаполнено(Организация);
	Запрос.УстановитьПараметр("ОтборПоОрганизации", ОтборПоОрганизации);
	Запрос.УстановитьПараметр("Организация",
		?(ОтборПоОрганизации, Организация, Справочники.Организации.ПустаяСсылка()));
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	НайденныйДоговор = Справочники.ДоговорыКонтрагентов.ПустаяСсылка();
	ДоговорСДатой = Справочники.ДоговорыКонтрагентов.ПустаяСсылка();
	
	Пока Выборка.Следующий() Цикл
		
		Если саб_НомерДоговораНормализованный(Выборка.Номер) <> НомерДляПоиска Тогда
			Продолжить;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(НайденныйДоговор) Тогда
			НайденныйДоговор = Выборка.Ссылка;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ДатаДоговора)
			И Выборка.Дата = ДатаДоговора Тогда
			ДоговорСДатой = Выборка.Ссылка;
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Если ЗначениеЗаполнено(ДоговорСДатой) Тогда
		Возврат ДоговорСДатой;
	КонецЕсли;
	
	Возврат НайденныйДоговор;
	
КонецФункции

Функция саб_НомерДоговораНормализованный(НомерДоговора)
	
	Результат = ВРег(СокрЛП(Строка(НомерДоговора)));
	Результат = СтрЗаменить(Результат, "№", "");
	Результат = СтрЗаменить(Результат, " ", "");
	Результат = СтрЗаменить(Результат, "-", "");
	Результат = СтрЗаменить(Результат, "/", "");
	Результат = СтрЗаменить(Результат, ".", "");
	
	Возврат Результат;
	
КонецФункции

Процедура саб_НормализоватьИННВСтруктуреЭПЭ(СтруктураРеквизитов)
	
	КлючиИНН = Новый Массив;
	Для Каждого КлючИЗначение Из СтруктураРеквизитов Цикл
		Если СтрЗаканчиваетсяНа(КлючИЗначение.Ключ, "ЮЛ_ИНН")
			Или СтрЗаканчиваетсяНа(КлючИЗначение.Ключ, "ИП_ИНН")
			Или СтрЗаканчиваетсяНа(КлючИЗначение.Ключ, "ФЛ_ИНН") Тогда
			КлючиИНН.Добавить(КлючИЗначение.Ключ);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого ИмяКлюча Из КлючиИНН Цикл
		СтруктураРеквизитов.Вставить(ИмяКлюча, саб_ИННСтрокой(СтруктураРеквизитов[ИмяКлюча]));
	КонецЦикла;
	
КонецПроцедуры

Функция саб_ИННСтрокой(ИНН)
	
	Если Не ЗначениеЗаполнено(ИНН) Тогда
		Возврат "";
	КонецЕсли;
	
	Результат = СокрЛП(Строка(ИНН));
	Результат = СтрЗаменить(Результат, " ", "");
	Результат = СтрЗаменить(Результат, Символы.НПП, "");
	Возврат Результат;
	
КонецФункции

Процедура саб_ОставитьТолькоКорректныеКлючиТаблицЭПЭ(СтруктураРеквизитов)
	
	КлючиДляУдаления = Новый Массив;
	Для Каждого КлючИЗначение Из СтруктураРеквизитов Цикл
		ЧастиКлюча = ОбменСГИСЭПДКлиентСервер.РазделитьСтрокуСоСложнымРазделителем(КлючИЗначение.Ключ, "__");
		Если ЧастиКлюча.Количество() < 2 Тогда
			Продолжить;
		КонецЕсли;
		Попытка
			А = Число(ЧастиКлюча[1]);
		Исключение
			КлючиДляУдаления.Добавить(КлючИЗначение.Ключ);
		КонецПопытки;
	КонецЦикла;
	
	Для Каждого ИмяКлюча Из КлючиДляУдаления Цикл
		СтруктураРеквизитов.Удалить(ИмяКлюча);
	КонецЦикла;
	
КонецПроцедуры


