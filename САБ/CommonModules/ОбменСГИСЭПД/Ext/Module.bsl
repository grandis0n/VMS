			Результат.Грузоперевозчик = Адресаты.Грузоперевозчик;
			ВремяВерсии = ОбменСГИСЭПДКлиентСервер.ПреобразоватьВДату(ОбъектXDTO.Документ.ВрИнфЭксп);
			Результат.ДатаВерсии = ОбменСГИСЭПДКлиентСервер.ПреобразоватьВДату(ОбъектXDTO.Документ.ДатИнфЭксп) 
			+ 60*60*Час(ВремяВерсии) + 60*Минута(ВремяВерсии) + Секунда(ВремяВерсии);
			// Скалдская расписка
		ИначеЕсли СтрНачинаетсяС(ОбъектXDTO.ИдФайл, "ON_SKLADRASP") Тогда
			Результат.ТипДокумента = Перечисления.ТипыДокументовЭДО.ЭСР;
			Результат.ПрефиксТитула = "ТитулЭкспедитора";
			Результат.Титул = Перечисления.ТипыЭлементовРегламентаЭДО.ЭСР_Титул1;
			Результат.ПолеПоиска = "ТитулЭкспедитораИдентификаторФайла";
			Результат.ЗначениеИДПоиска = ОбъектXDTO.ИдФайл;
			Результат.МинтрансИД = ОбъектXDTO.Документ.СодИнфЭксп.УИД_СкладР;

			Результат.Номер = ОбъектXDTO.Документ.СодИнфЭксп.НомДок;
			Результат.Дата = ОбменСГИСЭПДКлиентСервер.ПреобразоватьВДату(ОбъектXDTO.Документ.СодИнфЭксп.ДатаДок); 

			Результат.Грузоотправитель = Адресаты.Грузоотправитель;
			Результат.Грузоперевозчик = Адресаты.Грузоперевозчик;
			ВремяВерсии = ОбменСГИСЭПДКлиентСервер.ПреобразоватьВДату(ОбъектXDTO.Документ.ВрИнфЭксп);
			Результат.ДатаВерсии = ОбменСГИСЭПДКлиентСервер.ПреобразоватьВДату(ОбъектXDTO.Документ.ДатИнфЭксп) 
			+ 60*60*Час(ВремяВерсии) + 60*Минута(ВремяВерсии) + Секунда(ВремяВерсии);
		КонецЕсли;
	Исключение
		ЗаписьЖурналаРегистрации(НСтр("ru='ЭПД.Чтение XDTO'", ОбщегоНазначения.КодОсновногоЯзыка()),
		УровеньЖурналаРегистрации.Ошибка, , , ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Неопределено;	
	КонецПопытки;

	Если ЗначениеЗаполнено(Результат.ПрефиксТитула) И ЗначениеЗаполнено(Результат.ЗначениеИДПоиска) Тогда
		Возврат Результат;		
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

#КонецОбласти
