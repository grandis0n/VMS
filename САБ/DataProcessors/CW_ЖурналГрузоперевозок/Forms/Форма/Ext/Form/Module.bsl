
#Область саб_ОтборПоПериодуETD

&НаСервере
&После("ПриСозданииНаСервере")
Процедура саб_ПриСозданииНаСервереПосле(Отказ, СтандартнаяОбработка)
	
	Если Элементы.Найти("саб_КнопкаПериодETD") <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	КнопкаПериодETD = Элементы.Вставить("саб_КнопкаПериодETD", Тип("КнопкаФормы"), Элементы.ЖурналГруппаОтбор, Элементы.ЖурналОтборПоЗначению);
	КнопкаПериодETD.ИмяКоманды = "саб_ВыбратьПериодETD";
	КнопкаПериодETD.Отображение = ОтображениеКнопки.Картинка;
	
КонецПроцедуры

&НаКлиенте
Процедура саб_ВыбратьПериодETD(Команда)
	
	ДиалогПериода = Новый ДиалогРедактированияСтандартногоПериода;
	
	Если саб_ПериодETD = Неопределено Тогда
		ДиалогПериода.Период = Новый СтандартныйПериод;
	Иначе
		ДиалогПериода.Период = саб_ПериодETD;
	КонецЕсли;
	
	Оповещение = Новый ОписаниеОповещения("саб_ПослеВыбораПериодаETD", ЭтотОбъект);
	
	ДиалогПериода.Показать(Оповещение);
	
КонецПроцедуры

&НаКлиенте
Процедура саб_ПослеВыбораПериодаETD(ВыбранныйПериод, ДополнительныеПараметры) Экспорт
	
	Если ВыбранныйПериод = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	саб_ПериодETD = ВыбранныйПериод;
		
	саб_ПрименитьОтборПоПериодуETD();
	
КонецПроцедуры

&НаКлиенте
Процедура саб_ПрименитьОтборПоПериодуETD()
	
	саб_УстановитьОтборПоПериодуETDНаСервере();
	
	ВыполнитьДействие(
		_УФКС.СД(
			"Журналы",
			"сервер",
			"/ОбновитьДанные"
		)
	);
	
КонецПроцедуры

&НаСервере
Процедура саб_УстановитьОтборПоПериодуETDНаСервере()
		
	ИмяПоляETD = "Ссылка.[(кд) Дата ETD]";
	
	ПредставлениеОтбора = "саб_БыстрыйОтборПоПериодуETD";
	
	Отбор = Журнал_КомпоновщикНастроек.Настройки.Отбор;
	
	Для Каждого ЭлементОтбора Из Отбор.Элементы Цикл
		
		Если ЭлементОтбора.Представление = ПредставлениеОтбора Тогда
			
			Отбор.Элементы.Удалить(ЭлементОтбора);
			Прервать;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если саб_ПериодETD = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(саб_ПериодETD.ДатаНачала) Или Не ЗначениеЗаполнено(саб_ПериодETD.ДатаОкончания) Тогда
		
		Возврат;
		
	КонецЕсли;
	
	ГруппаОтбора = Отбор.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
	
	ГруппаОтбора.Использование = Истина;
	ГруппаОтбора.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИ;
	ГруппаОтбора.Представление = ПредставлениеОтбора;
	ГруппаОтбора.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;
	
	ЭлементНачало = ГруппаОтбора.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	
	ЭлементНачало.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ИмяПоляETD);
	ЭлементНачало.ВидСравнения = ВидСравненияКомпоновкиДанных.БольшеИлиРавно;
	ЭлементНачало.ПравоеЗначение = НачалоДня(саб_ПериодETD.ДатаНачала);
	ЭлементНачало.Использование = Истина;
	
	ЭлементОкончание = ГруппаОтбора.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	
	ЭлементОкончание.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ИмяПоляETD);
	ЭлементОкончание.ВидСравнения = ВидСравненияКомпоновкиДанных.МеньшеИлиРавно;
	ЭлементОкончание.ПравоеЗначение = КонецДня(саб_ПериодETD.ДатаОкончания);
	ЭлементОкончание.Использование = Истина;
	
КонецПроцедуры

#КонецОбласти