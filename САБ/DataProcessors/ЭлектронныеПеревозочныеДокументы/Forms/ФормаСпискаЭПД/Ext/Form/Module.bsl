#Область ОбработчикиСобытийФормы

&НаСервере
Процедура саб_ПриСозданииНаСервереПосле(Отказ, СтандартнаяОбработка)
	
	саб_ДобавитьКомандуЗагрузкиЭПЭ();
	САБ_УстановитьТекстЗапросаСписка();
	САБ_ДобавитьЭлементыОтбораМенеджера();
	САБ_УстановкаПользователя();
	САБ_УстановитьПараметрОтбораМенеджера(ЭтотОбъект);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура саб_ЗагрузитьЭПЭИзXML(Команда)
	
	саб_ЗагрузкаЭПЭКлиент.ЗагрузитьЭПЭИзФайла(УникальныйИдентификатор);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура САБ_ОтборОперативныйМенеджерПриИзменении(Элемент)
	
	САБ_УстановитьПараметрОтбораМенеджера(ЭтотОбъект);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура саб_ДобавитьКомандуЗагрузкиЭПЭ()
	
	Если Элементы.Найти("саб_ЗагрузитьЭПЭИзXML") <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Команды.Найти("саб_ЗагрузитьЭПЭИзXML") = Неопределено Тогда
		КомандаЗагрузки = Команды.Добавить("саб_ЗагрузитьЭПЭИзXML");
		КомандаЗагрузки.Заголовок = НСтр("ru = 'Загрузить ЭПЭ из XML'");
		КомандаЗагрузки.Подсказка = НСтр("ru = 'Создать электронное поручение экспедитору по XML-файлу титула заказчика'");
		КомандаЗагрузки.Действие = "саб_ЗагрузитьЭПЭИзXML";
	КонецЕсли;
	
	ГруппаСоздать = Элементы.Найти("ГруппаСоздать");
	Если ГруппаСоздать = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	КнопкаПеред = Элементы.Найти("СписокСоздатьЭЭР");
	Если КнопкаПеред = Неопределено Тогда
		КнопкаЗагрузки = Элементы.Добавить("саб_ЗагрузитьЭПЭИзXML", Тип("КнопкаФормы"), ГруппаСоздать);
	Иначе
		КнопкаЗагрузки = Элементы.Вставить("саб_ЗагрузитьЭПЭИзXML", Тип("КнопкаФормы"), ГруппаСоздать, КнопкаПеред);
	КонецЕсли;
	
	КнопкаЗагрузки.ИмяКоманды = "саб_ЗагрузитьЭПЭИзXML";
	КнопкаЗагрузки.Вид = ВидКнопкиФормы.КнопкаКоманднойПанели;
	
КонецПроцедуры

&НаСервере
Процедура САБ_УстановитьТекстЗапросаСписка()
	
	Если Параметры.Свойство("ОтборДокументОснование") Тогда
		Возврат;
	КонецЕсли;
	
	СвойстваСписка = ОбщегоНазначения.СтруктураСвойствДинамическогоСписка();
	СвойстваСписка.ОсновнаяТаблица = "РегистрСведений.РеестрЭПД";
	СвойстваСписка.ДинамическоеСчитываниеДанных = Истина;
	СвойстваСписка.ТекстЗапроса = САБ_ТекстЗапросаСпискаЭПД();
	ОбщегоНазначения.УстановитьСвойстваДинамическогоСписка(Элементы.Список, СвойстваСписка);
	
	Обработки.ЭлектронныеПеревозочныеДокументы.ЗаполнитьОбязательныеПараметрыЗапроса(Список.Параметры);
	САБ_УстановитьПараметрОтбораМенеджера(ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура САБ_ДобавитьЭлементыОтбораМенеджера()
	
	Если Не ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ЭтотОбъект, "ОтборОперативныйМенеджер") Тогда
		ДобавляемыеРеквизиты = Новый Массив;
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(
			"ОтборОперативныйМенеджер",
			Новый ОписаниеТипов("СправочникСсылка.Пользователи")));
		ИзменитьРеквизиты(ДобавляемыеРеквизиты);
	КонецЕсли;
	
	Если Элементы.Найти("ОтборОперативныйМенеджер") = Неопределено Тогда
		
		ГруппаОтборы = Элементы.Найти("ГруппаОтборыСписок");
		Если ГруппаОтборы = Неопределено Тогда
			ГруппаОтборы = ЭтотОбъект;
		КонецЕсли;
		
		ПолеОтбора = Элементы.Добавить("ОтборОперативныйМенеджер", Тип("ПолеФормы"), ГруппаОтборы);
		ПолеОтбора.Вид = ВидПоляФормы.ПолеВвода;
		ПолеОтбора.ПутьКДанным = "ОтборОперативныйМенеджер";
		ПолеОтбора.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
		ПолеОтбора.КнопкаОчистки = Истина;
		ПолеОтбора.ПодсказкаВвода = НСтр("ru = 'Оперативный менеджер'");
		
	КонецЕсли;
	
	Элементы.ОтборОперативныйМенеджер.УстановитьДействие("ПриИзменении", "САБ_ОтборОперативныйМенеджерПриИзменении");
	
	Если Элементы.Найти("САБ_ОперативныйМенеджер") = Неопределено
		И Элементы.Найти("Список") <> Неопределено Тогда
		
		Колонка = Элементы.Добавить("САБ_ОперативныйМенеджер", Тип("ПолеФормы"), Элементы.Список);
		Колонка.Вид = ВидПоляФормы.ПолеВвода;
		Колонка.ПутьКДанным = "Список.САБ_ОперативныйМенеджер";
		Колонка.Заголовок = НСтр("ru = 'Оперативный менеджер'");
		
	КонецЕсли;
	
КонецПроцедуры

