#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	УстановитьУсловноеОформлениеХарактеристик();
	
	ИспользоватьХарактеристикиНоменклатуры = Ложь;
	
	Параметры.Свойство("ЗагружатьКоличество"		,ЗагружатьКоличество);
	Параметры.Свойство("ЗагружатьОценку"			,ЗагружатьОценку);
	Параметры.Свойство("ЗагружатьЦену"				,ЗагружатьЦену);
	Параметры.Свойство("ЗагружатьЦеныПоВидамЦен"	,ЗагружатьЦеныПоВидамЦен);
	Параметры.Свойство("ИмяТЧ"						,ИмяТЧ);
	Параметры.Свойство("ЗагружатьЕдиницыИзмерения"	,ЗагружатьЕдиницыИзмерения);
	
	Если Параметры.Свойство("Заголовок") И ЗначениеЗаполнено(Параметры.Заголовок) Тогда
		
		АвтоЗаголовок = Ложь;
		Заголовок = Параметры.Заголовок;
		
	КонецЕсли;
		
	ИнициализироватьТабличныйДокумент();
	
	МассивЗначений = Новый Массив;
	МассивЗначений.Добавить("По запросу");
	МассивЗначений.Добавить("Мало");
	МассивЗначений.Добавить("Достаточно");
	МассивЗначений.Добавить("Много");
	Элементы.ТоварыОценка.СписокВыбора.ЗагрузитьЗначения(МассивЗначений);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыТовары

&НаКлиенте
Процедура ТоварыОценкаПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.Товары.ТекущиеДанные;
	Текст = ВРег(ТекущиеДанные.НаличиеСтрокой);
	
	Если Текст = Врег("Мало") ИЛИ Текст = "1" Тогда
		ТекущиеДанные.Наличие = 1;
		ТекущиеДанные.НаличиеСтрокой = НСтр("ru = 'Мало'");
	ИначеЕсли Текст = Врег("Достаточно") ИЛИ Текст = "2" Тогда
		ТекущиеДанные.Наличие = 2;
		ТекущиеДанные.НаличиеСтрокой = НСтр("ru = 'Достаточно'");
	ИначеЕсли Текст = Врег("Много") ИЛИ Текст = "3" Тогда
		ТекущиеДанные.Наличие = 3;
		ТекущиеДанные.НаличиеСтрокой = НСтр("ru = 'Много'");
	Иначе
		ТекущиеДанные.Наличие = 0;
		ТекущиеДанные.НаличиеСтрокой = НСтр("ru = 'По запросу'");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыНоменклатураПриИзменении(Элемент)
	СтрокаТаблицы = Элементы.Товары.ТекущиеДанные;
	
	Если НЕ ЗначениеЗаполнено(СтрокаТаблицы.Номенклатура) Тогда
		Возврат;
	КонецЕсли;
	
	ЗначенияРеквизитов = РеквизитыНоменклатуры(СтрокаТаблицы.Номенклатура);
	
	ЗаполнитьЗначенияСвойств(СтрокаТаблицы, ЗначенияРеквизитов);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Назад(Команда)
	Элементы.Шаги.ТекущаяСтраница = Элементы.Шаг1;
	Элементы.ФормаДалее.КнопкаПоУмолчанию = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ПеренестиТовары(Команда)
	
	Если ПроверитьЗаполнениеПолей() Тогда 
		
		СписокТоваров = ПолучитьРаспознанныеТовары(Объект.Товары, ВидыЦен);
		Закрыть(СписокТоваров);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Далее(Команда)
	
	ЗаполненыНоменклатураКодАртикулШтрихкод = ЗначениеЗаполнено(ТабличныйДокумент.Область("R2C1").Текст)
	Или ЗначениеЗаполнено(ТабличныйДокумент.Область("R2C2").Текст)
	Или ЗначениеЗаполнено(ТабличныйДокумент.Область("R2C3").Текст)
	Или ЗначениеЗаполнено(ТабличныйДокумент.Область("R2C4").Текст);
	
	Если Не ЗаполненыНоменклатураКодАртикулШтрихкод Тогда
		ПоказатьПредупреждение(Неопределено, НСтр("ru = 'Необходимо скопировать колонки в таблицу из внешнего файла.'"));
		Возврат;
	КонецЕсли;
	
	ОчиститьСообщения();
	Состояние(НСтр("ru = 'Осуществляется сопоставление введенных данных с данными информационной базы. Пожалуйста подождите...'"),,,БиблиотекаКартинок.Информация32);
	СопоставитьДанныеТабличногоДокументаСДаннымиИБ();
	
	Элементы.Шаги.ТекущаяСтраница = Элементы.Шаг2;
	Элементы.ПеренестиТовары.КнопкаПоУмолчанию = Истина;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервереБезКонтекста
Функция РеквизитыНоменклатуры(Знач СсылкаНаОбъект);
	ЗначенияРеквизитов = ТорговыеПредложенияБП.РеквизитыНоменклатурыПриИзменении(СсылкаНаОбъект, "Код, ЕдиницаИзмерения, ВидСтавкиНДС");
	ЗначенияРеквизитов.Вставить("СтавкаНДС", Перечисления.СтавкиНДС.СтавкаНДС(ЗначенияРеквизитов.ВидСтавкиНДС, ТекущаяДатаСеанса()));
	
	Возврат ЗначенияРеквизитов;
КонецФункции

&НаСервере
Процедура УстановитьУсловноеОформлениеХарактеристик()

	ЭлементУсловногоОформления = УсловноеОформление.Элементы.Добавить();
	
	ПолеЭлемента = ЭлементУсловногоОформления.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.ТоварыХарактеристика.Имя);
	
	ОтборЭлемента = ЭлементУсловногоОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.Товары.ХарактеристикиИспользуются");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Ложь;

	ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ТекстЗапрещеннойЯчейкиЦвет);
	ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("ОтметкаНезаполненного", Ложь);
	ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru = '<характеристики не используются>'"));
	ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);


КонецПроцедуры 

&НаСервере
Процедура ЗаполнитьВидыЦен()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВидыЦен.Ссылка КАК Ссылка,
		|	ВЫБОР
		|		КОГДА ВидыЦен.Валюта ЕСТЬ NULL
		|			ТОГДА ВидыЦен.Наименование
		|		ИНАЧЕ ВидыЦен.Наименование + "", "" + ВидыЦен.Валюта.Наименование
		|	КОНЕЦ КАК Наименование
		|ИЗ
		|	Справочник.ВидыЦен КАК ВидыЦен
		|ГДЕ
		|	НЕ ВидыЦен.ПометкаУдаления";
	
	ВидыЦен.Загрузить(Запрос.Выполнить().Выгрузить());

КонецПроцедуры

&НаСервере
Процедура ИнициализироватьТабличныйДокумент()
	
	МакетЗаполненияПоВнешнемуИсточнику = Обработки.ЗагрузкаДанныхИзВнешнихФайлов.ПолучитьМакет("МакетЗагрузкиДанных");
	ТабличныйДокумент.Очистить();
	
	ОбластьТовары = МакетЗаполненияПоВнешнемуИсточнику.ПолучитьОбласть("Штрихкод");
	ТабличныйДокумент.Присоединить(ОбластьТовары);
	
	ОбластьТовары = МакетЗаполненияПоВнешнемуИсточнику.ПолучитьОбласть("Код");
	ТабличныйДокумент.Присоединить(ОбластьТовары);
	
	ОбластьТовары = МакетЗаполненияПоВнешнемуИсточнику.ПолучитьОбласть("Артикул");
	ТабличныйДокумент.Присоединить(ОбластьТовары);
	
	ОбластьТовары = МакетЗаполненияПоВнешнемуИсточнику.ПолучитьОбласть("Номенклатура");
	ТабличныйДокумент.Присоединить(ОбластьТовары);
	
	Если ИспользоватьХарактеристикиНоменклатуры Тогда
		ОбластьТовары = МакетЗаполненияПоВнешнемуИсточнику.ПолучитьОбласть("Характеристика");
		ТабличныйДокумент.Присоединить(ОбластьТовары);
	КонецЕсли;
	
	Если ЗагружатьЕдиницыИзмерения Тогда
		ОбластьТовары = МакетЗаполненияПоВнешнемуИсточнику.ПолучитьОбласть("ЕдиницаИзмерения");
		ТабличныйДокумент.Присоединить(ОбластьТовары);
	КонецЕсли;
	
	Если ЗагружатьКоличество Тогда
		Элементы.ТоварыКоличество.Видимость = Истина;
		ОбластьТовары = МакетЗаполненияПоВнешнемуИсточнику.ПолучитьОбласть("Количество");
		ТабличныйДокумент.Присоединить(ОбластьТовары);
	КонецЕсли;
	
	Если ЗагружатьОценку Тогда
		Элементы.ТоварыОценка.Видимость = Истина;
		ОбластьТовары = МакетЗаполненияПоВнешнемуИсточнику.ПолучитьОбласть("ЗагружатьОценку");
		ТабличныйДокумент.Присоединить(ОбластьТовары);
	КонецЕсли;
	
	Если ЗагружатьЦену Тогда
		Элементы.ТоварыЦена.Видимость = Истина;
		ОбластьТовары = МакетЗаполненияПоВнешнемуИсточнику.ПолучитьОбласть("Цена");
		ТабличныйДокумент.Присоединить(ОбластьТовары);
	КонецЕсли;
	
	Если ЗагружатьЦеныПоВидамЦен Тогда
		ЗаполнитьВидыЦен();
		
		МассивРеквизитов = Новый Массив;
		ОписаниеТиповЧисло = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2, ДопустимыйЗнак.Любой));
		СтрокаСИменамиКолонок = "";
		
		Для Каждого ВидЦены Из ВидыЦен Цикл 
			ВидЦены.УникальноеИмя = "ВидЦены_" + СтрЗаменить(ВРег(Строка(ВидЦены.Ссылка.УникальныйИдентификатор())), "-", "x");
			СтрокаСИменамиКолонок = СтрокаСИменамиКолонок + "#&#&#&#." + ВидЦены.УникальноеИмя + ","+ Символы.ПС;
			
			ОбластьВидыЦен = МакетЗаполненияПоВнешнемуИсточнику.ПолучитьОбласть("ВидЦены");
			ОбластьВидыЦен.Параметры.ЗаголовокВидЦены = ВидЦены.Наименование;
			ТабличныйДокумент.Присоединить(ОбластьВидыЦен);
			
			МассивРеквизитов.Добавить(Новый РеквизитФормы(ВидЦены.УникальноеИмя,ОписаниеТиповЧисло,"Объект.Товары",ВидЦены.Наименование));
			
		КонецЦикла;
		
		ИзменитьРеквизиты(МассивРеквизитов);    	

		Для Каждого ВидЦены Из ВидыЦен Цикл 
			
			НовыйЭлемент = Элементы.Добавить(ВидЦены.УникальноеИмя, Тип("ПолеФормы"), Элементы.Товары);
			НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
			НовыйЭлемент.ПутьКДанным = "Объект.Товары." + ВидЦены.УникальноеИмя;
			
		КонецЦикла;

	КонецЕсли;

	
	ТабличныйДокумент.ФиксацияСверху = 1;
	
КонецПроцедуры

&НаСервере
Процедура СопоставитьДанныеТабличногоДокументаСДаннымиИБ()
	
	Объект.Товары.Очистить();
	НомераКолонок = Новый Соответствие;
	НомерКолонки = 1;
	
	НомераКолонок.Вставить("КолонкаШтрихкод", "C" + Формат(НомерКолонки, "ЧН=0; ЧГ=0"));
	НомерКолонки = НомерКолонки +1;
	НомераКолонок.Вставить("КолонкаКод", "C" + Формат(НомерКолонки, "ЧН=0; ЧГ=0"));
	НомерКолонки = НомерКолонки +1;
	НомераКолонок.Вставить("КолонкаАртикул", "C" + Формат(НомерКолонки, "ЧН=0; ЧГ=0"));
	НомерКолонки = НомерКолонки +1;
	НомераКолонок.Вставить("КолонкаНоменклатура", "C" + Формат(НомерКолонки, "ЧН=0; ЧГ=0"));
	НомерКолонки = НомерКолонки +1;
	
	Если ИспользоватьХарактеристикиНоменклатуры Тогда
		НомераКолонок.Вставить("КолонкаХарактеристика", "C" + Формат(НомерКолонки, "ЧН=0; ЧГ=0"));
		НомерКолонки = НомерКолонки +1;
	КонецЕсли;

	Если ЗагружатьЕдиницыИзмерения Тогда
		НомераКолонок.Вставить("ЕдиницаИзмерения", "C" + Формат(НомерКолонки, "ЧН=0; ЧГ=0"));
		НомерКолонки = НомерКолонки +1;
	КонецЕсли;
	
	Если ЗагружатьКоличество Тогда
		НомераКолонок.Вставить("КолонкаКоличество", "C" + Формат(НомерКолонки, "ЧН=0; ЧГ=0"));
		НомерКолонки = НомерКолонки +1;
	КонецЕсли;
	
	Если ЗагружатьОценку Тогда 
		НомераКолонок.Вставить("КолонкаОценка", "C" + Формат(НомерКолонки, "ЧН=0; ЧГ=0"));
		НомерКолонки = НомерКолонки +1;
	КонецЕсли;
	
	Если ЗагружатьЦену Тогда
		НомераКолонок.Вставить("Цена", "C" + Формат(НомерКолонки, "ЧН=0; ЧГ=0"));
		НомерКолонки = НомерКолонки +1;
	КонецЕсли;
	
	Если ЗагружатьЦеныПоВидамЦен Тогда
		
		Для Каждого ВидЦены Из ВидыЦен Цикл 
			
			НомераКолонок.Вставить(ВидЦены.УникальноеИмя, "C" + Формат(НомерКолонки, "ЧН=0; ЧГ=0"));
			НомерКолонки = НомерКолонки +1;
			
		КонецЦикла;
		
	КонецЕсли;

	
	
	НомерСтроки = 2;
	СтроковыйНомер = Формат(НомерСтроки, "ЧН=0; ЧГ=0");
	
	ЗаполненыНоменклатураКодАртикулШтрихкод = ЗначениеЗаполнено(ТабличныйДокумент.Область("R" + СтроковыйНомер + НомераКолонок.Получить("КолонкаАртикул")).Текст)
	Или ЗначениеЗаполнено(ТабличныйДокумент.Область("R" + СтроковыйНомер + НомераКолонок.Получить("КолонкаНоменклатура")).Текст)
	Или ЗначениеЗаполнено(ТабличныйДокумент.Область("R" + СтроковыйНомер + НомераКолонок.Получить("КолонкаШтрихкод")).Текст)
	Или ЗначениеЗаполнено(ТабличныйДокумент.Область("R" + СтроковыйНомер + НомераКолонок.Получить("КолонкаКод")).Текст);
	
	Пока ЗаполненыНоменклатураКодАртикулШтрихкод Цикл
		
		НоваяСтрока = Объект.Товары.Добавить();
		НоваяСтрока.КодСтроки = НомерСтроки;
		
		Попытка
			НоваяСтрока.ЗагружаемыйШтрихкод = ТабличныйДокумент.Область("R" + СтроковыйНомер + НомераКолонок.Получить("КолонкаШтрихкод")).Текст;
			НоваяСтрока.ЗагружаемыйКод = ТабличныйДокумент.Область("R" + СтроковыйНомер + НомераКолонок.Получить("КолонкаКод")).Текст;
			НоваяСтрока.ЗагружаемыйАртикул = ТабличныйДокумент.Область("R" + СтроковыйНомер + НомераКолонок.Получить("КолонкаАртикул")).Текст;
			НоваяСтрока.ЗагружаемаяНоменклатура = ТабличныйДокумент.Область("R" + СтроковыйНомер + НомераКолонок.Получить("КолонкаНоменклатура")).Текст;
			НоваяСтрока.ЗагружаемаяЕдиницаИзмерения = ТабличныйДокумент.Область("R" + СтроковыйНомер + НомераКолонок.Получить("ЕдиницаИзмерения")).Текст;
			
			Если ИспользоватьХарактеристикиНоменклатуры Тогда
				НоваяСтрока.ЗагружаемаяХарактеристика = ТабличныйДокумент.Область("R" + СтроковыйНомер + НомераКолонок.Получить("КолонкаХарактеристика")).Текст;
			КонецЕсли;
			
			Если ЗагружатьКоличество Тогда
				КоличествоТекст = ТабличныйДокумент.Область("R" + СтроковыйНомер + НомераКолонок.Получить("КолонкаКоличество")).Текст;
				НоваяСтрока.Количество = СтроковыеФункцииКлиентСервер.СтрокаВЧисло(КоличествоТекст);
			КонецЕсли;
			
			Если ЗагружатьОценку Тогда
				
				Текст = ВРег(ТабличныйДокумент.Область("R" + СтроковыйНомер + НомераКолонок.Получить("КолонкаОценка")).Текст);
				
				Если Текст = Врег("Мало") ИЛИ Текст = "1" Тогда
					НоваяСтрока.Наличие = 1;
					НоваяСтрока.НаличиеСтрокой = НСтр("ru = 'Мало'");
				ИначеЕсли Текст = Врег("Достаточно") ИЛИ Текст = "2" Тогда
					НоваяСтрока.Наличие = 2;
					НоваяСтрока.НаличиеСтрокой = НСтр("ru = 'Достаточно'");
				ИначеЕсли Текст = Врег("Много") ИЛИ Текст = "3" Тогда
					НоваяСтрока.Наличие = 3;
					НоваяСтрока.НаличиеСтрокой = НСтр("ru = 'Много'");
				Иначе
					НоваяСтрока.Наличие = 0;
					НоваяСтрока.НаличиеСтрокой = НСтр("ru = 'По запросу'");
				КонецЕсли;
				
			КонецЕсли;
		
			Если ЗагружатьЦену Тогда
				ЦенаТекст = ТабличныйДокумент.Область("R" + СтроковыйНомер + НомераКолонок.Получить("Цена")).Текст;
				НоваяСтрока.Цена = СтроковыеФункцииКлиентСервер.СтрокаВЧисло(ЦенаТекст);
			КонецЕсли;
			
			Если ЗагружатьЦеныПоВидамЦен Тогда
		
				Для Каждого ВидЦены Из ВидыЦен Цикл
					НоваяСтрока[ВидЦены.УникальноеИмя] = ТабличныйДокумент.Область("R" + СтроковыйНомер + НомераКолонок.Получить(ВидЦены.УникальноеИмя)).Текст;
				КонецЦикла;
		
			КонецЕсли;
		
		Исключение
			ОбщегоНазначения.СообщитьПользователю(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
		
		НомерСтроки = НомерСтроки + 1;
		СтроковыйНомер = Формат(НомерСтроки, "ЧН=0; ЧГ=0");
		
		ЗаполненыНоменклатураКодАртикулШтрихкод = ЗначениеЗаполнено(ТабличныйДокумент.Область("R" + СтроковыйНомер + НомераКолонок.Получить("КолонкаАртикул")).Текст)
		Или ЗначениеЗаполнено(ТабличныйДокумент.Область("R" + СтроковыйНомер + НомераКолонок.Получить("КолонкаНоменклатура")).Текст)
		Или ЗначениеЗаполнено(ТабличныйДокумент.Область("R" + СтроковыйНомер + НомераКолонок.Получить("КолонкаШтрихкод")).Текст)
		Или ЗначениеЗаполнено(ТабличныйДокумент.Область("R" + СтроковыйНомер + НомераКолонок.Получить("КолонкаКод")).Текст);	
	КонецЦикла;
	
	СопоставитьНоменклатуруПоШтрихКоду();
	
КонецПроцедуры

&НаСервере
Процедура СопоставитьНоменклатуруПоШтрихКоду()
	
	Запрос=Новый Запрос;
	Запрос.Текст=
	
	"ВЫБРАТЬ
	|	ТаблицаУточнения.ЗагружаемыйШтрихкод КАК ЗагружаемыйШтрихкод,
	|	ТаблицаУточнения.Номенклатура КАК Номенклатура,
	|	ТаблицаУточнения.Характеристика КАК Характеристика,
	|	ТаблицаУточнения.Количество КАК Количество,
	|	ТаблицаУточнения.Цена КАК Цена,
	|	ТаблицаУточнения.Наличие КАК Оценка,
	|	ТаблицаУточнения.НаличиеСтрокой КАК НаличиеСтрокой,
	|	ЕстьNULL(ТаблицаУточнения.ЗагружаемаяЕдиницаИзмерения, """") КАК ЗагружаемаяЕдиницаИзмерения,
	|	ТаблицаУточнения.ЗагружаемаяХарактеристика КАК ЗагружаемаяХарактеристика,
	|	ТаблицаУточнения.ЗагружаемыйАртикул КАК ЗагружаемыйАртикул,
	|	ТаблицаУточнения.ЗагружаемаяНоменклатура КАК ЗагружаемаяНоменклатура,
	|	ТаблицаУточнения.ЗагружаемыйКод КАК ЗагружаемыйКод,
	|	"+?(ЗагружатьЦеныПоВидамЦен, СтрЗаменить(СтрокаСИменамиКолонок, "#&#&#&#", "ТаблицаУточнения"), "")+"
	|	ТаблицаУточнения.КодСтроки КАК КодСтроки
	|ПОМЕСТИТЬ ТаблицаШтрихкод
	|ИЗ
	|	&КолонкаШтрихкод КАК ТаблицаУточнения
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ЗагружаемыйШтрихкод
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаШтрихкод.ЗагружаемыйШтрихкод КАК ЗагружаемыйШтрихкод,
	|	ЕСТЬNULL(Штрихкоды.Номенклатура, ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)) КАК Номенклатура,
	|	ТаблицаШтрихкод.Характеристика КАК Характеристика,
	|	ТаблицаШтрихкод.Количество КАК Количество,
	|	ТаблицаШтрихкод.Цена КАК Цена,
	|	ТаблицаШтрихкод.Оценка КАК Оценка,
	|	ТаблицаШтрихкод.НаличиеСтрокой КАК НаличиеСтрокой,
	|	ТаблицаШтрихкод.ЗагружаемыйАртикул КАК ЗагружаемыйАртикул,
	|	ТаблицаШтрихкод.ЗагружаемыйКод КАК ЗагружаемыйКод,
	|	ТаблицаШтрихкод.ЗагружаемаяНоменклатура КАК ЗагружаемаяНоменклатура,
	|	ТаблицаШтрихкод.ЗагружаемаяХарактеристика КАК ЗагружаемаяХарактеристика,
	|	ТаблицаШтрихкод.ЗагружаемаяЕдиницаИзмерения КАК ЗагружаемаяЕдиницаИзмерения,
	|	"+?(ЗагружатьЦеныПоВидамЦен, СтрЗаменить(СтрокаСИменамиКолонок, "#&#&#&#", "ТаблицаШтрихкод"), "")+"
	|	ТаблицаШтрихкод.КодСтроки КАК КодСтроки
	|ПОМЕСТИТЬ ПоискПоШтрихКодам
	|ИЗ
	|	ТаблицаШтрихкод КАК ТаблицаШтрихкод
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ШтрихкодыНоменклатуры КАК Штрихкоды
	|		ПО ТаблицаШтрихкод.ЗагружаемыйШтрихкод = Штрихкоды.Штрихкод
	|			И (ТаблицаШтрихкод.ЗагружаемыйШтрихкод <> """")
	|			И (Штрихкоды.Номенклатура ССЫЛКА Справочник.Номенклатура)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПоискПоШтрихКодам.ЗагружаемыйШтрихкод КАК ЗагружаемыйШтрихкод,
	|	ВЫБОР
	|		КОГДА ПоискПоШтрихКодам.Номенклатура ЕСТЬ NULL
	|			ТОГДА ЕСТЬNULL(НоменклатураСсылка.Ссылка, ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка))
	|		ИНАЧЕ ПоискПоШтрихКодам.Номенклатура
	|	КОНЕЦ КАК Номенклатура,
	|	ПоискПоШтрихКодам.Характеристика КАК Характеристика,
	|	ПоискПоШтрихКодам.Количество КАК Количество,
	|	ПоискПоШтрихКодам.Цена КАК Цена,
	|	ПоискПоШтрихКодам.Оценка КАК Оценка,
	|	ПоискПоШтрихКодам.НаличиеСтрокой КАК НаличиеСтрокой,
