	|	ПоискПоШтрихКодам.ЗагружаемаяХарактеристика КАК ЗагружаемаяХарактеристика,
	|	"+?(ЗагружатьЦеныПоВидамЦен, СтрЗаменить(СтрокаСИменамиКолонок, "#&#&#&#", "ПоискПоШтрихКодам"), "")+"
	|	ПоискПоШтрихКодам.ЗагружаемаяЕдиницаИзмерения КАК ЗагружаемаяЕдиницаИзмерения,
	|	ВЫБОР
	|		КОГДА ПоискПоШтрихКодам.ЗагружаемаяЕдиницаИзмерения = """"
	|			ТОГДА ВЫБОР
	|					КОГДА ПоискПоШтрихКодам.Номенклатура ЕСТЬ NULL
	|						ТОГДА ЕСТЬNULL(НоменклатураСсылка.Ссылка.ЕдиницаИзмерения, ЗНАЧЕНИЕ(Справочник.КлассификаторЕдиницИзмерения.ПустаяСсылка))
	|					ИНАЧЕ ПоискПоШтрихКодам.Номенклатура.ЕдиницаИзмерения
	|				КОНЕЦ
	|	КОНЕЦ КАК ЕдиницаИзмерения
	|ПОМЕСТИТЬ ПоискПоНоменклатуре
	|ИЗ
	|	ПоискПоШтрихКодам КАК ПоискПоШтрихКодам
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК НоменклатураСсылка
	|		ПО (ПоискПоШтрихКодам.ЗагружаемыйАртикул = НоменклатураСсылка.Артикул
	|					И ПоискПоШтрихКодам.ЗагружаемыйАртикул <> """"
	|				ИЛИ ПоискПоШтрихКодам.ЗагружаемаяНоменклатура = НоменклатураСсылка.Наименование
	|					И ПоискПоШтрихКодам.ЗагружаемаяНоменклатура <> """"
	|				ИЛИ ПоискПоШтрихКодам.ЗагружаемыйКод = НоменклатураСсылка.Код
	|					И ПоискПоШтрихКодам.ЗагружаемыйКод <> """")
	|
	|СГРУППИРОВАТЬ ПО
	|	ПоискПоШтрихКодам.Цена,
	|	ПоискПоШтрихКодам.ЗагружаемыйКод,
	|	ПоискПоШтрихКодам.КодСтроки,
	|	ПоискПоШтрихКодам.Характеристика,
	|	ПоискПоШтрихКодам.ЗагружаемыйАртикул,
	|	ПоискПоШтрихКодам.ЗагружаемаяНоменклатура,
	|	ПоискПоШтрихКодам.Количество,
	|	"+?(ЗагружатьЦеныПоВидамЦен, СтрЗаменить(СтрокаСИменамиКолонок, "#&#&#&#", "ПоискПоШтрихКодам"), "")+"
	|	ПоискПоШтрихКодам.ЗагружаемыйШтрихкод,
	|	ВЫБОР
	|		КОГДА ПоискПоШтрихКодам.Номенклатура ЕСТЬ NULL
	|			ТОГДА ЕСТЬNULL(НоменклатураСсылка.Ссылка, ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка))
	|		ИНАЧЕ ПоискПоШтрихКодам.Номенклатура
	|	КОНЕЦ,
	|	ПоискПоШтрихКодам.Оценка,
	|	ПоискПоШтрихКодам.НаличиеСтрокой,
	|	ЕСТЬNULL(НоменклатураСсылка.Ссылка, ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)),
	|	ПоискПоШтрихКодам.ЗагружаемаяХарактеристика,
	|	ПоискПоШтрихКодам.ЗагружаемаяЕдиницаИзмерения,
	|	ВЫБОР
	|		КОГДА ПоискПоШтрихКодам.ЗагружаемаяЕдиницаИзмерения = """"
	|			ТОГДА ВЫБОР
	|					КОГДА ПоискПоШтрихКодам.Номенклатура ЕСТЬ NULL
	|						ТОГДА ЕСТЬNULL(НоменклатураСсылка.Ссылка.ЕдиницаИзмерения, ЗНАЧЕНИЕ(Справочник.КлассификаторЕдиницИзмерения.ПустаяСсылка))
	|					ИНАЧЕ ПоискПоШтрихКодам.Номенклатура.ЕдиницаИзмерения
	|				КОНЕЦ
	|	КОНЕЦ
	|;
