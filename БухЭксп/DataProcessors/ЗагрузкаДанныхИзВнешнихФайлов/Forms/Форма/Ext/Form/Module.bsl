	|	ПоискПоНоменклатуре.Номенклатура КАК Номенклатура,
	|	ПоискПоНоменклатуре.Количество КАК Количество,
	|	ПоискПоНоменклатуре.Цена КАК Цена,
	|	ПоискПоНоменклатуре.Оценка КАК Оценка,
	|	ПоискПоНоменклатуре.НаличиеСтрокой КАК НаличиеСтрокой,
	|	ПоискПоНоменклатуре.ЗагружаемыйАртикул КАК ЗагружаемыйАртикул,
	|	ПоискПоНоменклатуре.ЗагружаемаяНоменклатура КАК ЗагружаемаяНоменклатура,
	|	ПоискПоНоменклатуре.ЗагружаемыйКод КАК ЗагружаемыйКод,
	|	ПоискПоНоменклатуре.КодСтроки КАК КодСтроки,
	|	ПоискПоНоменклатуре.Ссылка КАК Ссылка,
	|	ПоискПоНоменклатуре.ЗагружаемаяХарактеристика КАК ЗагружаемаяХарактеристика,
	|	ПоискПоНоменклатуре.ЗагружаемаяЕдиницаИзмерения КАК ЗагружаемаяЕдиницаИзмерения,
	|	"+?(ЗагружатьЦеныПоВидамЦен, СтрЗаменить(СтрокаСИменамиКолонок, "#&#&#&#", "ПоискПоНоменклатуре"), "")+"
	|	ПоискПоНоменклатуре.ЕдиницаИзмерения КАК ЕдиницаИзмерения
	|ПОМЕСТИТЬ ПоискПоХарактеристикам
	|ИЗ
	|	ПоискПоНоменклатуре КАК ПоискПоНоменклатуре
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПоискПоХарактеристикам.ЗагружаемыйШтрихкод КАК ЗагружаемыйШтрихкод,
	|	ПоискПоХарактеристикам.Номенклатура КАК Номенклатура,
	|	ПоискПоХарактеристикам.Количество КАК Количество,
	|	ПоискПоХарактеристикам.Цена КАК Цена,
	|	ПоискПоХарактеристикам.Оценка КАК Наличие,
	|	ПоискПоХарактеристикам.НаличиеСтрокой КАК НаличиеСтрокой,
	|	ПоискПоХарактеристикам.ЗагружаемыйАртикул КАК ЗагружаемыйАртикул,
	|	ПоискПоХарактеристикам.ЗагружаемаяНоменклатура КАК ЗагружаемаяНоменклатура,
	|	ПоискПоХарактеристикам.ЗагружаемыйКод КАК ЗагружаемыйКод,
	|	ПоискПоХарактеристикам.КодСтроки КАК КодСтроки,
	|	ПоискПоХарактеристикам.Ссылка КАК Ссылка,
	|	ПоискПоХарактеристикам.Номенклатура.Артикул КАК Артикул,
	|	ПоискПоХарактеристикам.Номенклатура.Код КАК Код,
	|	ПоискПоХарактеристикам.Номенклатура.ВидСтавкиНДС КАК СтавкаНДС,
	|	ЛОЖЬ КАК ХарактеристикиИспользуются,
	|	ПоискПоХарактеристикам.ЗагружаемаяХарактеристика КАК ЗагружаемаяХарактеристика,
	|	"+?(ЗагружатьЦеныПоВидамЦен, СтрЗаменить(СтрокаСИменамиКолонок, "#&#&#&#", "ПоискПоХарактеристикам"), "")+"
	|	ПоискПоХарактеристикам.ЗагружаемаяЕдиницаИзмерения КАК ЗагружаемаяЕдиницаИзмерения,
	|	ВЫБОР
	|		КОГДА ЕдиницыИзмерения.Ссылка ЕСТЬ NULL
	|			ТОГДА ПоискПоХарактеристикам.ЕдиницаИзмерения
	|		ИНАЧЕ ЕдиницыИзмерения.Ссылка
	|	КОНЕЦ КАК ЕдиницаИзмерения
	|ИЗ
	|	ПоискПоХарактеристикам КАК ПоискПоХарактеристикам
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КлассификаторЕдиницИзмерения КАК ЕдиницыИзмерения
	|		ПО ПоискПоХарактеристикам.ЗагружаемаяЕдиницаИзмерения = ЕдиницыИзмерения.Наименование
	|			И (ПоискПоХарактеристикам.ЗагружаемаяЕдиницаИзмерения <> """")";
	
	Запрос.УстановитьПараметр("КолонкаШтрихкод", Объект.Товары.Выгрузить());
	
	Объект.Товары.Загрузить(Запрос.Выполнить().Выгрузить());
	
КонецПроцедуры

&НаКлиенте
Функция ПроверитьЗаполнениеПолей()
	
	ОчиститьСообщения();
	
	СообщениеПользователю = Новый СообщениеПользователю;
	СообщениеПользователю.УстановитьДанные(ЭтотОбъект);
		
	Для Каждого Товар Из Объект.Товары Цикл 
		
		Если НЕ ЗначениеЗаполнено(Товар.Номенклатура) Тогда 
			
			СообщениеПользователю.Текст = НСтр("ru = 'Не заполнена номенклатура'");
			СообщениеПользователю.Поле = СтрШаблон(НСтр("ru = 'Объект.Товары[%1].Номенклатура'"), Объект.Товары.Индекс(Товар));
			СообщениеПользователю.Сообщить();
			Возврат Ложь;
			
		ИначеЕсли НЕ ЗначениеЗаполнено(Товар.Характеристика)
					И Товар.ХарактеристикиИспользуются Тогда 
					
			СообщениеПользователю.Текст = НСтр("ru = 'Не заполнена характеристика номенклатуры'");
			СообщениеПользователю.Поле = СтрШаблон(НСтр("ru = 'Объект.Товары[%1].Характеристика'"), Объект.Товары.Индекс(Товар));
			СообщениеПользователю.Сообщить();
			Возврат Ложь;
			
		ИначеЕсли НЕ ЗначениеЗаполнено(Товар.ЕдиницаИзмерения) Тогда 
			
			СообщениеПользователю.Текст = НСтр("ru = 'Не заполнена единица измерения номенклатуры'");
			СообщениеПользователю.Поле = СтрШаблон(НСтр("ru = 'Объект.Товары[%1].ЕдиницаИзмерения'"), Объект.Товары.Индекс(Товар));
			СообщениеПользователю.Сообщить();
			Возврат Ложь;
			
		КонецЕсли;
			
	КонецЦикла;

	Возврат Истина;
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьРаспознанныеТовары(Знач ВсеТовары,Знач ВидыЦен)
	
	МассивОтвет = Новый Массив;
	
	Для Каждого Товар Из ВсеТовары Цикл
		
		Если НЕ ЗначениеЗаполнено(Товар.Номенклатура) Тогда 
			Продолжить;
		КонецЕсли;
		
		СтруктураТовар = Новый Структура;
		СтруктураТовар.Вставить("Штрихкод"								, Товар.Штрихкод						);
		СтруктураТовар.Вставить("Артикул"								, Товар.Артикул							);
		СтруктураТовар.Вставить("Код"									, Товар.Код								);
		СтруктураТовар.Вставить("Номенклатура"							, Товар.Номенклатура					);
		СтруктураТовар.Вставить("Характеристика"						, Товар.Характеристика					);
		СтруктураТовар.Вставить("ЕдиницаИзмерения"						, Товар.ЕдиницаИзмерения				);
		СтруктураТовар.Вставить("Количество"							, Товар.Количество						);
		СтруктураТовар.Вставить("Цена"									, Товар.Цена							);
		СтруктураТовар.Вставить("СтавкаНДС"								, Товар.СтавкаНДС						);
		СтруктураТовар.Вставить("Оценка"								, Товар.Наличие							);
		СтруктураТовар.Вставить("Наличие"								, Товар.Наличие							);
		СтруктураТовар.Вставить("НаличиеСтрокой"						, Товар.НаличиеСтрокой					);
		СтруктураТовар.Вставить("ХарактеристикиИспользуются"			, Товар.ХарактеристикиИспользуются		);
		СтруктураТовар.Вставить("Модифицирован"							, Истина								);
		СтруктураТовар.Вставить("Организация"							, Справочники.Организации.ПустаяСсылка());

		
		Если ВидыЦен.Количество()>0 Тогда
			
			Для Каждого ВидЦены Из ВидыЦен Цикл 
				СтруктураТовар.Вставить(ВидЦены.УникальноеИмя, Товар[ВидЦены.УникальноеИмя]);
			КонецЦикла;
			
		КонецЕсли;
		
		МассивОтвет.Добавить(СтруктураТовар);
		
	КонецЦикла;
	
	Возврат МассивОтвет;

КонецФункции

#КонецОбласти
