	ПараметрыФормы.Вставить("СформироватьПриОткрытии", 	Истина); 
	ПараметрыФормы.Вставить("ВариантГруппировки", 		"ЗАЯВКА");     

	ОткрытьФорму("Отчет.CW_АнализБюджета.Форма", ПараметрыФормы, ПараметрыВыполненияКоманды.Источник);
	
