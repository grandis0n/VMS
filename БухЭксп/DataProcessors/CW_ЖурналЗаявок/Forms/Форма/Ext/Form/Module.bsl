// событие всех кнопок панели (!!!)
&НаКлиенте
Процедура ЖурналДействие(Команда)
	
	Если Команда.Имя = "Журнал_ОтключитьОтбор" Тогда
		
		Режим = РежимДиалогаВопрос.ДаНет;
		Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаОПодтвержденииОчисткиНастроек", ЭтотОбъект, Команда.Имя);
		ПоказатьВопрос(Оповещение, "Отключить все установленные отборы журнала?", Режим, 0);
		
	Иначе
		
		ВыполнитьДействие(_УФКС.СД("Журналы","клиент",СтрЗаменить(Команда.Имя,"Журнал_","/"),Неопределено));
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияВопросаОПодтвержденииОчисткиНастроек(Результат, Параметры) Экспорт
   
	Если Результат = КодВозвратаДиалога.Нет Тогда
        Возврат;
	КонецЕсли;
	
	Если ПроверитьНеобходимостьПодтврежденияОтключенияОтбора() Тогда
		
		Режим = РежимДиалогаВопрос.ДаНет;
		Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияПредупрежденияОДлительностиОчисткиОтбора", ЭтотОбъект,Параметры);
		ПоказатьВопрос(Оповещение, "Очистка всех отборов может занять продолжительное время. Продолжить?", Режим, 0);
		
	Иначе
		ВыполнитьДействие(_УФКС.СД("Журналы","клиент",СтрЗаменить(Параметры,"Журнал_","/"),Неопределено));
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияПредупрежденияОДлительностиОчисткиОтбора(Результат, Параметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;
	
	ВыполнитьДействие(_УФКС.СД("Журналы","клиент",СтрЗаменить(Параметры,"Журнал_","/"),Неопределено));
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПроверитьНеобходимостьПодтврежденияОтключенияОтбора()
	
	ЗначениеНастройки = CW_Настройки.ПолучитьНастройкуПользователя(,"ПодтверждатьОтклчюениеОтбораВЖурналах");
	
	Возврат ?(ЗначениеНастройки = Неопределено, Истина, ЗначениеНастройки);
	
КонецФункции


