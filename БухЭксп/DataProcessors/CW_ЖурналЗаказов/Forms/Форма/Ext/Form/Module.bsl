&НаКлиенте
Процедура ИзвлечьИзАрхива(Команда)  

	ВыделенныеСтроки = Элементы.Журнал.ВыделенныеСтроки;
	Если ВыделенныеСтроки = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ПараметрКоманды = новый Массив;
	Для Каждого ИдентификаторСтроки из ВыделенныеСтроки Цикл
		СтрокаТекущая = Журнал_Данные.НайтиПоИдентификатору(ИдентификаторСтроки);
		ПараметрКоманды.Добавить(СтрокаТекущая.Ссылка);
	КонецЦикла;
	
	ОдинОбъект	= "заказ";
	Несколько 	= "заказы";
	
	Если ПараметрКоманды.Количество() = 1 Тогда
		ТекстВопроса = СтрШаблон("Извлечь %1 в архива?", ОдинОбъект);	
	Иначе
		ТекстВопроса = СтрШаблон("Извлечь %1 в архива?", Несколько);	
	КонецЕсли;
	
	Режим = РежимДиалогаВопрос.ДаНет;    
	
	ПараметрыВыполненияКоманды = Новый Структура;
	ПараметрыВыполненияКоманды.Вставить("Источник", ЭтаФорма);
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ПараметрКоманды", 			ПараметрКоманды);
	ДополнительныеПараметры.Вставить("ПараметрыВыполненияКоманды", 	ПараметрыВыполненияКоманды);
	ДополнительныеПараметры.Вставить("Архив", 						Ложь);
	
	Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопроса", ЭтотОбъект, ДополнительныеПараметры);
	ПоказатьВопрос(Оповещение, ТекстВопроса, Режим, 0);
	
КонецПроцедуры

