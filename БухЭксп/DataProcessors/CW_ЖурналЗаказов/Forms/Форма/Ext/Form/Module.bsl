//Печать

&НаКлиенте
Процедура КомандаПечать(Команда)
	
	ТекущиеДанные =	Элементы.Журнал.ТекущиеДанные;
	
	Если ТекущиеДанные.Свойство("Ссылка") Тогда
		
		мСсылка = Новый Массив;
		мСсылка.Добавить(ТекущиеДанные.Ссылка);
		
		Ответ = CW_Печать.ПолучитьПараметрыФормыПечати(мСсылка, УникальныйИдентификатор);
		
		Если (_УФКС.ВыполненоУспешно(Ответ)) Тогда
			ОткрытьФорму("ОбщаяФорма.CW_Печать",Ответ.ПФ,мСсылка);
		КонецЕсли; 
		
	КонецЕсли;
	

КонецПроцедуры

&НаКлиенте
Процедура КомандаПакетнаяПечать(Команда)
	
	ТекущиеДанные =	Элементы.Журнал.ТекущиеДанные;
	
	Если ТекущиеДанные.Свойство("Ссылка") Тогда
		
		мСсылкиДляПечати = ПолучитьМассивСсылок(Элементы.Журнал.ВыделенныеСтроки);
		
		// получаем список ПФ
		СписокПечатныхФорм = ПолучитьСписокПечатныхФорм(мСсылкиДляПечати);
		ОписаниеОповещения = Новый ОписаниеОповещения("ОбработкаВыбораПечатныхФорм",ЭтотОбъект, Новый Структура("ПараметрКоманды, УникальныйИдентификатор", мСсылкиДляПечати, УникальныйИдентификатор)); 
		СписокПечатныхФорм.ПоказатьОтметкуЭлементов(ОписаниеОповещения,"Доступные печатные формы");
		
	КонецЕсли;
	
КонецПроцедуры      

&НаКлиенте
Процедура ОбработкаВыбораПечатныхФорм(СписокПечатныхФорм, ДополнительныеПараметры) Экспорт 
	
	Если СписокПечатныхФорм <> Неопределено Тогда
		
		// проверяем, что есть печатные формы
		КоличествоПФ = 0;
		Для каждого Стр Из СписокПечатныхФорм Цикл
			
			Если стр.Пометка Тогда
				КоличествоПФ = КоличествоПФ +1;
			КонецЕсли; 
			
		КонецЦикла; 
		
		Если КоличествоПФ <> 0 Тогда
			ВыполнитьПечать(ДополнительныеПараметры.ПараметрКоманды , ДополнительныеПараметры.УникальныйИдентификатор , СписокПечатныхФорм);
		Иначе
			_УФК.ВывестиПредупреждение("Печатные формы не выбраны!");
		КонецЕсли; 
		
		
	КонецЕсли; 
	
КонецПроцедуры

&НаСервере
Функция ПолучитьСписокПечатныхФорм(Ссылки)

	ТаблицаПечатныхФорм		= CW_Печать.ПолучитьПустуюТаблицуПечатныхФорм();
	МассивИменМетаданных	= CW_Печать.ПолучитьМассивИменМетеданных(Ссылки);
	
	CW_Печать.ЗаполнитьТаблицуПечатныхФормОбъектов(МассивИменМетаданных, ТаблицаПечатныхФорм);
	
	СписокПечатныхФорм = Новый СписокЗначений;
	
	Для каждого СтрокаТаблицы Из ТаблицаПечатныхФорм Цикл
		СписокПечатныхФорм.Добавить(СтрокаТаблицы.СсылкаНаОбработку, СтрокаТаблицы.Представление);
	КонецЦикла; 
	
	Возврат СписокПечатныхФорм;
	
КонецФункции 

&НаКлиенте
Процедура ВыполнитьПечать(ПараметрКоманды, ПараметрУникальныйИдентификатор, СписокПечатныхФорм)
	
	МассивИменМетаданных = CW_Печать.ПолучитьМассивИменМетеданных(ПараметрКоманды);
	
	мОбъектыПечати = Новый Массив;
	
	Для Каждого СсылкаВМассиве из ПараметрКоманды Цикл
		ОбъектПечати = Новый Структура;
		ОбъектПечати.Вставить("Ссылка", СсылкаВМассиве);
		
		мОбъектыПечати.Добавить(ОбъектПечати);
	КонецЦикла;
	
	ПараметрыПакетнойПечати = Новый Структура;
	ПараметрыПакетнойПечати.Вставить("ОбъектыПечати", 			мОбъектыПечати);
	ПараметрыПакетнойПечати.Вставить("МассивИменМетаданных", 	МассивИменМетаданных);
	
	Ответ = CW_Печать.ПолучитьПараметрыФормыПакетнойПечати(ПараметрыПакетнойПечати,ПараметрУникальныйИдентификатор, СписокПечатныхФорм);
	
	Если _УФКС.ВыполненоУспешно(Ответ) Тогда
		ОткрытьФорму("ОбщаяФорма.CW_Печать",Ответ.ПФ);
	КонецЕсли; 
	
КонецПроцедуры

&НаСервере
Функция ПолучитьМассивСсылок(Знач мВыделенныеСтроки)
	
	мСсылка = Новый Массив;

	Для Каждого ИдентификаторСтроки из мВыделенныеСтроки Цикл
		СтрокаДанных = Журнал_Данные.НайтиПоИдентификатору(ИдентификаторСтроки);
		мСсылка.Добавить(СтрокаДанных.Ссылка);
	КонецЦикла;
	
	Возврат мСсылка;
	
КонецФункции

&НаКлиенте
Процедура ОтчетАнализИсполненияБюджетаГрузоперевозок(Команда)

	ПараметрКоманды = ПолучитьСсылкиВыделенныхСтрокНаСервере(Элементы.Журнал.ВыделенныеСтроки);
	Если ПараметрКоманды.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыВыполненияКоманды = Новый Структура;
	ПараметрыВыполненияКоманды.Вставить("Источник", ЭтаФорма);
	
	CW_БюджетированиеКлиент.СформироватьОтчетАнализИсполненияБюджетаГрузоперевозок(ПараметрКоманды, ПараметрыВыполненияКоманды);

КонецПроцедуры

//Фоновое обновление журнала
&НаКлиенте
Процедура ВыполнитьФоновоеОбновлениеЖурнала()   
	
	РезультатВыполнения = ПродолжитьФоновоеОбновлениеЖурналаНаСервереВФоне();
	ПараметрыОжидания 	= ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ВыводитьОкноОжидания = Ложь;
	
	ОповещениеОЗавершении = Новый ОписаниеОповещения("ОбработатьРезультатФоновогоОбновления", ЭтотОбъект); 
	ДлительныеОперацииКлиент.ОжидатьЗавершение(РезультатВыполнения, ОповещениеОЗавершении, ПараметрыОжидания); 
	
КонецПроцедуры  

&НаСервере 
Функция ПродолжитьФоновоеОбновлениеЖурналаНаСервереВФоне()  
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(Новый УникальныйИдентификатор);
	ПараметрыВыполнения.ОжидатьЗавершение    		= 0;    
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = "";  
	ПараметрыВыполнения.ЗапуститьВФоне     			= Истина;  
	ПараметрыВыполнения.ЗапуститьНеВФоне			= ложь;   
	
	ПараметрыПроцедуры = Новый Структура;
	ПараметрыПроцедуры.Вставить("СКД",				ПолучитьИзВременногоХранилища(Журнал_СхемаКомпоновки));
	ПараметрыПроцедуры.Вставить("НастройкиСКД",		Журнал_КомпоновщикНастроек.ПолучитьНастройки());
  	ПараметрыПроцедуры.Вставить("УстанавливаемыеПараметры",	Новый Структура);

	Возврат ДлительныеОперации.ВыполнитьВФоне("CW_Журналы_Сервер.ПодготовитьДанные",ПараметрыПроцедуры, ПараметрыВыполнения);  
	
КонецФункции       

&НаКлиенте 
Процедура ОбработатьРезультатФоновогоОбновления(РезультатВыполнения, Дополнительныепараметры) Экспорт
	
	Если РезультатВыполнения.Статус = "Выполнено" Тогда 
		
		Если Не АктивноРедактированиеВРежимеExcel Тогда  
			
			ЕстьПолеСсылка = ЕстьПолеСсылка();
			Если ЕстьПолеСсылка Тогда
				УстановитьТекущуюССылку(Элементы.Журнал.ТекущаяСтрока);
			КонецЕсли;
			
			ОбработатьРезультатФоновогоОбновленияНаСервере(РезультатВыполнения.АдресРезультата);   
			
			Если ЕстьПолеСсылка Тогда
				ТекущаяСтрока = ПолучитьТекущуюСтрокуЖурнала(); 
				Если ТекущаяСтрока <> Неопределено Тогда
					Элементы.Журнал.ТекущаяСтрока = ТекущаяСтрока;
				КонецЕсли;
			КонецЕсли;
			
			Если ПараметрыФоновогоОбновления.Оповещать Тогда
				ПоказатьОповещениеПользователя("Журнал заказов", ,"Данные обновлены"); 
			КонецЕсли;
			
		КонецЕсли;   
		
	ИначеЕсли РезультатВыполнения.Статус = "Ошибка" Тогда
		
		ОтключитьОбработчикОжидания("ВыполнитьФоновоеОбновлениеЖурнала");
		
		ПоказатьОповещениеПользователя("Журнал заказов", ,  "Ошибка фонового обновления журнала.
															|Подробности см. в журнале регистрации."); 
	
	КонецЕсли;  
	
КонецПроцедуры 

&НаСервере
Процедура ОбработатьРезультатФоновогоОбновленияНаСервере(АдресРезультата)

	CW_Журналы_Сервер.ЗагрузитьДанные(ЭтаФорма, АдресРезультата);
	
КонецПроцедуры

&НаСервере
Функция ЕстьПолеСсылка() 
	
	ТаблицаЖурнала = Журнал_Данные.Выгрузить();
	Возврат ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ТаблицаЖурнала.Колонки, "ссылка");
	
КонецФункции

&НаСервере
Функция ПолучитьТекущуюСтрокуЖурнала()
	
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("Ссылка", ТекущаяСсылка); 
	
	НайденныеСтроки = Журнал_Данные.НайтиСтроки(ПараметрыОтбора);
	Если НайденныеСтроки.Количество() > 0 Тогда
		//Должна быть одна строка  
		Возврат НайденныеСтроки[0].ПолучитьИдентификатор();				
	КонецЕсли;

КонецФункции 

&НаСервере
Процедура УстановитьТекущуюССылку(Знач ТекущаяСтрока) 

	Если ТекущаяСтрока = Неопределено Тогда  
		ТекущаяСсылка = Неопределено;
		Возврат;
	КонецЕсли;
	
	СтрокаЖурнала = Журнал_Данные.НайтиПоИдентификатору(ТекущаяСтрока);
	ТекущаяСсылка = СтрокаЖурнала.ссылка;
	
КонецПроцедуры
