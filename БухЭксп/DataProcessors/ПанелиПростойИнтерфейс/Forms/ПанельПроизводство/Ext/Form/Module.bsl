#Область ОписаниеПеременных

&НаКлиенте
Перем ОткрытыеФормы;

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЕстьПравоПросмотрТребованиеНакладная = ПравоДоступа("Просмотр", Метаданные.Документы.ТребованиеНакладная);
	ЕстьПравоПросмотрОтчетПроизводстваЗаСмену = ПравоДоступа("Просмотр", Метаданные.Документы.ОтчетПроизводстваЗаСмену);
	ЕстьПравоПросмотрАктОбОказанииПроизводственныхУслуг =
		ПравоДоступа("Просмотр", Метаданные.Документы.АктОбОказанииПроизводственныхУслуг);
	ЕстьПравоПросмотрИнвентаризацияНЗП = ПравоДоступа("Просмотр", Метаданные.Документы.ИнвентаризацияНЗП);
	ЕстьПравоПросмотрПоступлениеТоваровУслуг =
		ПравоДоступа("Просмотр", Метаданные.Документы.ПоступлениеТоваровУслуг);
	ЕстьПравоПросмотрПередачаТоваров = ПравоДоступа("Просмотр", Метаданные.Документы.ПередачаТоваров);
	ЕстьПравоПросмотрРеализацияУслугПоПереработке =
		ПравоДоступа("Просмотр", Метаданные.Документы.РеализацияУслугПоПереработке);
	ЕстьПравоПросмотрВозвратТоваровПоставщику = ПравоДоступа("Просмотр", Метаданные.Документы.ВозвратТоваровПоставщику);
	ЕстьПравоПросмотрПередачаТоваров = ПравоДоступа("Просмотр", Метаданные.Документы.ПередачаТоваров);
	ЕстьПравоПросмотрПоступлениеИзПереработки = ПравоДоступа("Просмотр", Метаданные.Документы.ПоступлениеИзПереработки);
		
	Элементы.РасходМатериалов.Видимость = ЕстьПравоПросмотрТребованиеНакладная;
	Элементы.ВыпускПродукции.Видимость = ЕстьПравоПросмотрОтчетПроизводстваЗаСмену;
	Элементы.ОказаниеПроизводственныхУслуг.Видимость = ЕстьПравоПросмотрАктОбОказанииПроизводственныхУслуг;
	Элементы.ИнвентаризацияНЗП.Видимость = ЕстьПравоПросмотрИнвентаризацияНЗП;
	
	Элементы.ПоступлениеВПереработку.Видимость = ЕстьПравоПросмотрПоступлениеТоваровУслуг;
	Элементы.ПередачаПродукцииЗаказчику.Видимость = ЕстьПравоПросмотрПередачаТоваров;
	Элементы.РеализацияУслугПоПереработке.Видимость = ЕстьПравоПросмотрРеализацияУслугПоПереработке;
	Элементы.ВозвратМатериаловЗаказчику.Видимость = ЕстьПравоПросмотрВозвратТоваровПоставщику;
	
	Элементы.ПередачаСырьяВПереработку.Видимость = ЕстьПравоПросмотрПередачаТоваров;
	Элементы.ПоступлениеИзПереработки.Видимость = ЕстьПравоПросмотрПоступлениеИзПереработки;
		
	МобильныйКлиентАдаптацияФормы();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ВыпускПродукции(Команда)
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ВидОперации",
		ПредопределенноеЗначение("Перечисление.ВидыОперацийОтчетПроизводстваЗаСмену.ВыпускПродукции"));
	ПростойИнтерфейсКлиент.ОткрытьФормуВОкнеФормы("Документ.ОтчетПроизводстваЗаСмену.Форма.ФормаСписка",
		ЭтотОбъект, ПараметрыФормы, , ОткрытыеФормы);
	
КонецПроцедуры

&НаКлиенте
Процедура РасходМатериалов(Команда)
	
	ПростойИнтерфейсКлиент.ОткрытьФормуВОкнеФормы("Документ.ТребованиеНакладная.ФормаСписка",
		ЭтотОбъект, , , ОткрытыеФормы);
	
КонецПроцедуры

&НаКлиенте
Процедура ОказаниеПроизводственныхУслуг(Команда)
	
	ПростойИнтерфейсКлиент.ОткрытьФормуВОкнеФормы("Документ.АктОбОказанииПроизводственныхУслуг.ФормаСписка",
		ЭтотОбъект, , , ОткрытыеФормы);
	
КонецПроцедуры

&НаКлиенте
Процедура ИнвентаризацияНЗП(Команда)
	
	ПростойИнтерфейсКлиент.ОткрытьФормуВОкнеФормы("Документ.ИнвентаризацияНЗП.ФормаСписка",
		ЭтотОбъект, , , ОткрытыеФормы);
	
КонецПроцедуры

&НаКлиенте
Процедура ПоступлениеВПереработку(Команда)

	Отбор = Новый Структура;
	Отбор.Вставить("ВидОперации",
		ПредопределенноеЗначение("Перечисление.ВидыОперацийПоступлениеТоваровУслуг.ВПереработку"));

	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Заголовок", НСтр("ru = 'Поступление в переработку'"));
	ПараметрыФормы.Вставить("Отбор",     Отбор);
	ПараметрыФормы.Вставить("НеИзменятьОтборПоВидуОперации", Истина);
	
	ПростойИнтерфейсКлиент.ОткрытьФормуВОкнеФормы("Документ.ПоступлениеТоваровУслуг.ФормаСписка",
		ЭтотОбъект, ПараметрыФормы, , ОткрытыеФормы);
		
КонецПроцедуры

&НаКлиенте
Процедура ПередачаПродукцииЗаказчику(Команда)

	Отбор = Новый Структура("ВидОперации",
		ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачаТоваров.ИзПереработки"));
	ПараметрыФормы = Новый Структура("Отбор", Отбор);
	
	ПростойИнтерфейсКлиент.ОткрытьФормуВОкнеФормы("Документ.ПередачаТоваров.ФормаСписка",
		ЭтотОбъект, ПараметрыФормы, "ИзПереработки", ОткрытыеФормы);
	
КонецПроцедуры

&НаКлиенте
Процедура РеализацияУслугПоПереработке(Команда)
	
	ПростойИнтерфейсКлиент.ОткрытьФормуВОкнеФормы("Документ.РеализацияУслугПоПереработке.ФормаСписка",
		ЭтотОбъект, , , ОткрытыеФормы);
	
КонецПроцедуры

&НаКлиенте
Процедура ВозвратМатериаловЗаказчику(Команда)
	
	Отбор = Новый Структура("ВидОперации",
		ПредопределенноеЗначение("Перечисление.ВидыОперацийВозвратТоваровПоставщику.ИзПереработки"));

	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Заголовок", ПолноеИмяОперации(Отбор.ВидОперации));
	ПараметрыФормы.Вставить("Отбор",     Отбор);
	
	ПростойИнтерфейсКлиент.ОткрытьФормуВОкнеФормы("Документ.ВозвратТоваровПоставщику.ФормаСписка",
		ЭтотОбъект, ПараметрыФормы, , ОткрытыеФормы);
	
КонецПроцедуры

&НаКлиенте
Процедура ПередачаСырьяВПереработку(Команда)
	
	Отбор = Новый Структура("ВидОперации",
		ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачаТоваров.ВПереработку"));
	ПараметрыФормы = Новый Структура("Отбор", Отбор);
	
	ПростойИнтерфейсКлиент.ОткрытьФормуВОкнеФормы("Документ.ПередачаТоваров.ФормаСписка",
		ЭтотОбъект, ПараметрыФормы, "ВПереработку", ОткрытыеФормы);
	
КонецПроцедуры


&НаКлиенте
Процедура ПоступлениеИзПереработки(Команда)
	
	ПростойИнтерфейсКлиент.ОткрытьФормуВОкнеФормы("Документ.ПоступлениеИзПереработки.ФормаСписка",
		ЭтотОбъект, , , ОткрытыеФормы);
		
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ПолноеИмяОперации(ВидОперации)
	
	Возврат Перечисления.ВидыОперацийВозвратТоваровПоставщику.ПолноеИмяОперации(ВидОперации);
	
КонецФункции

#КонецОбласти

#Область МобильныйКлиент

&НаСервере
Процедура МобильныйКлиентАдаптацияФормы()
	
	Если Не ОбщегоНазначения.ЭтоМобильныйКлиент() Тогда
		Возврат;
	КонецЕсли;
	
	АдаптироватьМКШапкаФормы();
	
КонецПроцедуры

&НаСервере
Процедура АдаптироватьМКШапкаФормы()
	
	МобильныйКлиентБПФормаПанели.НастроитьФорму(ЭтотОбъект);
	МобильныйКлиентБПФормаПанели.УстановитьДоступностьЭлементовПанели(ЭтотОбъект);
	
КонецПроцедуры

#КонецОбласти
