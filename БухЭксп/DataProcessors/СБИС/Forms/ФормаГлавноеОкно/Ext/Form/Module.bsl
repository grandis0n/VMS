&НаКлиенте
Процедура ITSP_ДобавитьPDFВМассив(НазваниеДокумента,МассивФайлов,СсылкаНаPDF,Документ,ВремФ,Вложение,ИдСБИС)
	
	Если Документ = Неопределено Тогда
		Если Лев(Нрег(Прав(НазваниеДокумента,4)),1) = "." ИЛИ Лев(Нрег(Прав(НазваниеДокумента,5)),1) = "." Тогда //СтрНайти(Нрег(НазваниеДокумента),".pdf")=0 ИЛИ  Нрег(Прав(НазваниеДокумента,4)) = ".xls" Тогда
			ИмяФайла = НазваниеДокумента;
		Иначе
			ИмяФайла = НазваниеДокумента+".pdf";
		КонецЕсли;
	Иначе
		ИмяФайла = НазваниеДокумента+" №"+ITSP_РеквизитОбъекта(Документ,"НомерВходящегоДокумента")+" от "+Формат(ITSP_РеквизитОбъекта(Документ,"Дата"),"ДФ=dd.MM.yy")+".pdf";
	КонецЕсли;
	
	HTML = Неопределено;
	Если Вложение.Зашифрован="Да" Тогда
		Если Вложение.XMLДокумента="" Тогда
			//ДАнные = Кэш.Интеграция.ПолучитьДанныеЗашифрованногоФайла(Кэш,Вложение.Файл.Ссылка);
			ДД = Base64Значение(Кэш.Интеграция.ПолучитьДанныеЗашифрованногоФайла(Кэш,Вложение.Файл.Ссылка));
			ДД.Записать(ВремФ);
		Иначе
			HTML = Кэш.Интеграция.ПолучитьHTMLВложения(Кэш,ИдСБИС,Вложение);
		КонецЕсли;	
	Иначе		
		ФайлПолучен = Ложь;
		Для Счетчик = 1 По 5 Цикл   
			Попытка
				Кэш.Интеграция.СохранитьВложениеПоСсылкеВФайл(Кэш,СсылкаНаPDF,ВремФ);				
				ДД = Новый ДвоичныеДанные(ВремФ);	
				ФайлПолучен = Истина;
				Если Счетчик > 1 тогда ОчиститьСообщения(); КонецЕсли;
				Прервать;			
			Исключение
				
			КонецПопытки; 
		КонецЦикла;
		Если Не ФайлПолучен тогда
			ВызватьИсключение "Ошибка получения файла PDF повторите попытку позже";	
		КонецЕсли;
	КонецЕсли;
	
	Размер = Неопределено;
	Если HTML = Неопределено Тогда				
		ФайлВР = Новый Файл(ВремФ);
		
		МассивФайлов.Добавить(Новый Структура("ПолноеИмяФайла,ИмяФайла,Размер,АдресФайла",
		ИмяФайла,
		ИмяФайла,
		ФайлВР.Размер(),
		ПоместитьВоВременноеХранилище(ДД,УникальныйИдентификатор)));
	Иначе	
		МассивФайлов.Добавить(Новый Структура("ПолноеИмяФайла,ИмяФайла,Размер,АдресФайла",
		ИмяФайла,
		ИмяФайла,
		,
		HTML));	
	КонецЕсли;
	
		
КонецПроцедуры // ITSP_ДобавитьPDFВМассив()


