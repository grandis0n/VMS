&НаСервереБезКонтекста
Функция FARESO_УстановитьПризнакНаличияИдатуВозвратаОригиналов(Документ,Признак) 
	
	ДанныеДлязаписи = Новый Структура;
	ДанныеДлязаписи.Вставить("ЗаписьНового"			, Ложь);
	ДанныеДлязаписи.Вставить("Ссылка"				, Документ);
	ДанныеДлязаписи.Вставить("Признак"				, Признак);
	ДанныеДлязаписи.Вставить("ДатаВозврата" 		, ТекущаяДата());
	
	СтруктураПараметров = CW_Документы.ПодготовитьСтруктуруДляЗаписиНаличияОригиналовДокументов(ДанныеДлязаписи);
	
	Возврат CW_Документы.УстановитьПризнакНаличияИдатуВозвратаОригиналов(СтруктураПараметров);
	
КонецФункции

