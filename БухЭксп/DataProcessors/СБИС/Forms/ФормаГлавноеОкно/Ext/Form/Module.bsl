		Возврат(Справочники.CW_ДоговорыПоГрузоперевозкам.ПустаяСсылка());
	Иначе
		Если (СтрокаПараметра.Значение.Владелец = Плательщик) Тогда
			Возврат(СтрокаПараметра.Значение);
		Иначе
