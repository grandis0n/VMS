			КонецЕсли;
						
			НС.Всего = ?(СчетчикСтрок=КоличествоКонтейнеров,ОсталосьРаспределить,РавнаяДоля);
			ОсталосьРаспределить = ОсталосьРаспределить - НС.Всего;
			
			НС.Количество = КоличествоДляСтроки;
			НС.СтавкаНДС = СтавкаНДС;
			НС.Номенклатура = Номенклатура;
			
			Ставка = СтавкаНДС(НС.СтавкаНДС)/100;
			НС.НДС = НС.Всего*Ставка/(1+Ставка);
			НС.Сумма = НС.Всего - НС.НДС;
			НС.Цена = _сф.БезопасноРазделить(НС.Сумма,НС.Количество);

				
			Запрос = Новый Запрос;
			Запрос.Текст = "ВЫБРАТЬ
			|	CW_СтатьиЗатратНоменклатуры.СтатьяЗатрат
			|ИЗ
			|	РегистрСведений.CW_СтатьиЗатратНоменклатуры КАК CW_СтатьиЗатратНоменклатуры
			|ГДЕ
			|	CW_СтатьиЗатратНоменклатуры.Номенклатура = &Номенклатура";
			Запрос.УстановитьПараметр("Номенклатура", НС.Номенклатура);
