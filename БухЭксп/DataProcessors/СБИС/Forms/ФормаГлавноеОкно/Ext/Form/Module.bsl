Функция ВычленитьДату(Исходник)
	Если ТипЗнч(Исходник) = Тип("Дата") Тогда
		Возврат Исходник;
	КонецЕсли;
	Попытка 
		Результат = Лев(Исходник,10);
		Результат = Дата(Прав(Результат,4)+Сред(Результат,4,2)+Лев(Результат,2));
		Возврат Результат;
	Исключение
		Возврат Дата(1,1,1);	
	КонецПопытки;
	
