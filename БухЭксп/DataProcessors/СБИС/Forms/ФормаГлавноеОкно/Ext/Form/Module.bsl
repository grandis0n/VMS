Процедура ITSP_ОткрытьРасход(Команда)
	ТекущаяСтрока = Кэш.ТаблДок.ТекущиеДанные;
	Для каждого Документ ИЗ ТекущаяСтрока.Документы1С Цикл
		Расход = ITSP_ПолучитьРасходПоВедомому(Документ.Значение);
		Если Расход <> Неопределено Тогда
			ПоказатьЗначение(,Расход);
			Возврат;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаСервереБезКонтекста
Функция ITSP_ПолучитьРасходПоВедомому(Ведомый)
	//{{КОНСТРУКТОР_ЗАПРОСА_С_ОБРАБОТКОЙ_РЕЗУЛЬТАТА
	// Данный фрагмент построен конструктором.
	// При повторном использовании конструктора, внесенные вручную изменения будут утеряны!!!
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	CW_РасходыПоГрузоперевозке.Ссылка
	|ИЗ
	|	Документ.CW_РасходыПоГрузоперевозке КАК CW_РасходыПоГрузоперевозке
	|ГДЕ
	|	CW_РасходыПоГрузоперевозке.[Ведомый] = &Ведомый";
	
	Запрос.УстановитьПараметр("Ведомый", Ведомый);
	Запрос.Текст = СтрЗаменить(Запрос.Текст,"[Ведомый]",?(ТипЗнч(Ведомый) = Тип("ДокументСсылка.СчетНаОплатуПоставщика"),"ВедомыйСчет","ВедомыйДокумент"));
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Неопределено;
	КонецЕсли;
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	ВыборкаДетальныеЗаписи.Следующий();
	Возврат ВыборкаДетальныеЗаписи.Ссылка;
КонецФункции // ITSP_ПолучитьРасходПоВедомому()

&НаКлиенте
Процедура ITSP_ПривязатьСканы(Команда)
	ОчиститьСообщения();	
	ОбновлятьКонтент = Ложь;
	
	ITSP_ПривязатьСканыАвтономная(ОбновлятьКонтент);
	
	Если ОбновлятьКонтент Тогда
		ОбновитьКонтент();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ITSP_ПривязатьСканыАвтономная(ОбновлятьКонтент,ТихийРежим=Ложь,ITSP_ВыбранныеСтроки=Неопределено)
	Если ITSP_ВыбранныеСтроки = Неопределено Тогда
		ITSP_ВыбранныеСтроки = ТаблДокПолучитьВыбранныеСтроки();
	КонецЕсли;

	Для каждого ТекущаяСтрокаЭлемент ИЗ ITSP_ВыбранныеСтроки Цикл
		ТекущаяСтрока = ТекущаяСтрокаЭлемент.Значение;
		//МассивПакетов = Кэш.Текущий.Форма.ПодготовитьСтруктуруДокумента(ТекущаяСтрока, Кэш);
		//ВложенияПакета = Кэш.ОбщиеФункции.ЗаполнитьРеквизитыОснованийПакета(МассивПакетов[0], Кэш).Вложение;
		МассивПакетов = ITSP_ПодготовитьСтруктуруДокументаСбис(ТекущаяСтрока, Кэш);  // Облегченный вариант Кэш.Текущий.Форма.ПодготовитьСтруктуруДокумента(ТекущаяСтрока, Кэш);
		ВложенияПакета = МассивПакетов[0].Вложение;
		
		МассивФайлов = Новый Массив;
		ВремФ = ПолучитьИмяВременногоФайла("pdf");
			
		//---------------------------
		Расход = Неопределено;
		НомераДокументовПоВложениям = Новый Структура("НомерСчета,ДатаСчета,НомерАкта,ДатаАкта,НомерСФ,ДатаСФ,ПредъявленАкт,ПредъявленСФ","",Дата(1,1,1),"",Дата(1,1,1),"",Дата(1,1,1),Ложь,Ложь);
		Для каждого Вложение ИЗ ВложенияПакета Цикл
			//ITSP_ЗаполнитьНомерИДатуВложенияИзНазвания(Вложение.Название,Вложение.Номер,Вложение.Дата);
			//HTML = Кэш.Интеграция.ПолучитьHTMLВложения(Кэш,ТекущаяСтрока.ИдСБИС,Вложение);
			//Продолжить;
			Если (СтрНайти(Вложение.Название,"Счет")>0 И Вложение.Тип = "") ИЛИ Вложение.Тип = "ЭДОСч" Тогда
				НомераДокументовПоВложениям.НомерСчета = Вложение.Номер;
				НомераДокументовПоВложениям.ДатаСчета = Вложение.Дата;
				Если Расход = Неопределено Тогда
					Расход = ITSP_НайтиРасходПоНомеру("Счета",НомераДокументовПоВложениям.НомерСчета,НомераДокументовПоВложениям.ДатаСчета);
				КонецЕсли;
			КонецЕсли;
			Если Вложение.Тип = "АктВР" ИЛИ Вложение.Тип = "УпдДоп" ИЛИ Вложение.Тип = "УпдСчфДоп"	Тогда
				НомераДокументовПоВложениям.НомерАкта = Вложение.Номер;
				НомераДокументовПоВложениям.ДатаАкта = Вложение.Дата;
				НомераДокументовПоВложениям.ПредъявленАкт = Истина;
				Если Расход = Неопределено Тогда
					Расход = ITSP_НайтиРасходПоНомеру("Акта",НомераДокументовПоВложениям.НомерАкта,НомераДокументовПоВложениям.ДатаАкта);
				КонецЕсли;	
			КонецЕсли;
			Если Вложение.Тип = "СчФктр" Тогда
				НомераДокументовПоВложениям.НомерСФ = Вложение.Номер;
				НомераДокументовПоВложениям.ДатаСФ = Вложение.Дата;
				НомераДокументовПоВложениям.ПредъявленСФ = Истина;
				Если Расход = Неопределено Тогда
					Расход = ITSP_НайтиРасходПоНомеру("СФ",НомераДокументовПоВложениям.НомерСФ,НомераДокументовПоВложениям.ДатаСФ);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
		
		Если Расход = Неопределено Тогда
			Если ТихийРежим Тогда
				Продолжить;
			ИначеЕсли ЗначениеЗаполнено(НомераДокументовПоВложениям.НомерАкта) Тогда
				Сообщить("Не найден расход по акту №"+НомераДокументовПоВложениям.НомерАкта+" от "+Формат(НомераДокументовПоВложениям.ДатаАкта,"ДФ=dd.MM.yy"));	
			ИначеЕсли ЗначениеЗаполнено(НомераДокументовПоВложениям.НомерСФ) Тогда
				Сообщить("Не найден расход по фактуре №"+НомераДокументовПоВложениям.НомерСФ+" от "+Формат(НомераДокументовПоВложениям.ДатаСФ,"ДФ=dd.MM.yy"));	
			Иначе
				Сообщить("Не найден расход по грузоперевозкам");
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		
		Для каждого Вложение ИЗ ВложенияПакета Цикл
			ОбновлятьКонтент = Истина;
					
			Если СтрНайти(Нрег(Вложение.Название),"факт")=0 И СтрНайти(Вложение.Название,"Счет")>0 И Вложение.Служебный = "Нет" ИЛИ Вложение.Тип = "ЭДОСч" Тогда
				Документ = ITSP_РеквизитОбъекта(Расход,"ВедомыйСчет");
				ITSP_ПривязатьДокументКВложению(Вложение,Документ,ТекущаяСтрока.ИдСБИС);
				ITSP_ДобавитьPDFВМассив("Счет",МассивФайлов,?(Вложение.Тип = "ЭДОСч",Вложение.СсылкаНаPDF,Вложение.Файл.Ссылка),Документ,ВремФ,Вложение,ТекущаяСтрока.ИдСБИС);		
			ИначеЕсли Вложение.Тип = "АктВР" ИЛИ Вложение.Тип = "УпдДоп" ИЛИ Вложение.Тип = "УпдСчфДоп"	Тогда
				Документ = ITSP_РеквизитОбъекта(Расход,"ВедомыйДокумент");
				ITSP_ПривязатьДокументКВложению(Вложение,Документ,ТекущаяСтрока.ИдСБИС);
				Если Вложение.Тип = "АктВР" Тогда
					ITSP_ДобавитьPDFВМассив("Акт",МассивФайлов,Вложение.СсылкаНаPDF,Документ,ВремФ,Вложение,ТекущаяСтрока.ИдСБИС);
				Иначе
					ITSP_ДобавитьPDFВМассив("УПД",МассивФайлов,Вложение.СсылкаНаPDF,Документ,ВремФ,Вложение,ТекущаяСтрока.ИдСБИС);
				КонецЕсли;
			ИначеЕсли Вложение.Тип = "СчФктр" Тогда
				Документ = ITSP_РеквизитОбъекта(Расход,"ВедомыйСчетФактура");
				ITSP_ПривязатьДокументКВложению(Вложение,Документ,ТекущаяСтрока.ИдСБИС);
				ITSP_ДобавитьPDFВМассив("Счет-Фактура",МассивФайлов,Вложение.СсылкаНаPDF,Документ,ВремФ,Вложение,ТекущаяСтрока.ИдСБИС);

			ИначеЕсли Вложение.Служебный = "Нет" Тогда
				Если СтрНайти(Вложение.Название,"Ведомость выполненных работ")>0 Тогда
					Продолжить;
				КонецЕсли;

				Если Нрег(Прав(Вложение.Название,4)) = ".xls" ИЛИ Нрег(Прав(Вложение.Название,5)) = ".xlsx" Тогда
					ITSP_ДобавитьPDFВМассив(Вложение.Название,МассивФайлов,Вложение.Файл.Ссылка,,ВремФ,Вложение,ТекущаяСтрока.ИдСБИС);     
				Иначе
					ITSP_ДобавитьPDFВМассив(Вложение.Название,МассивФайлов,Вложение.СсылкаНаPDF,,ВремФ,Вложение,ТекущаяСтрока.ИдСБИС);	
				КонецЕсли;	
				
			КонецЕсли;
			
			
		КонецЦикла;
		Если МассивФайлов.Количество()<>0 Тогда
			Ответ = CW_ПрикрепитьФайлы(МассивФайлов,Неопределено,Расход);
            _БЭ.УстановитьПризнакНаличияОригиналов(Расход,Истина);
		КонецЕсли;
		УдалитьФайлы(ВремФ);
	КонецЦикла;

КонецПроцедуры



&НаСервереБезКонтекста
Функция ITSP_НайтиРасходПоНомеру(Тип,НомерАкта,ДатаАкта)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	CW_РасходыПоГрузоперевозке.Ссылка
	|ИЗ
	|	Документ.CW_РасходыПоГрузоперевозке КАК CW_РасходыПоГрузоперевозке
	|ГДЕ
	|	CW_РасходыПоГрузоперевозке.Проведен = ИСТИНА
	|	И CW_РасходыПоГрузоперевозке.Номер[Тип] = &НомерАкта
	|	И CW_РасходыПоГрузоперевозке.Дата[Тип] >= НАЧАЛОПЕРИОДА(&ДатаАкта, ДЕНЬ)
	|	И CW_РасходыПоГрузоперевозке.Дата[Тип] <= КОНЕЦПЕРИОДА(&ДатаАкта, ДЕНЬ)
	|
	|УПОРЯДОЧИТЬ ПО
	|	CW_РасходыПоГрузоперевозке.Дата УБЫВ";
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст,"[Тип]",Тип);
	Запрос.УстановитьПараметр("ДатаАкта", ДатаАкта);
	Запрос.УстановитьПараметр("НомерАкта", НомерАкта);
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Неопределено;
	КонецЕсли;
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	ВыборкаДетальныеЗаписи.Следующий();
	Возврат  ВыборкаДетальныеЗаписи.Ссылка;
	
КонецФункции // ITSP_НайтиРасходПоАкту()



&НаСервереБезКонтекста
Функция ITSP_РасходПоГрузоперевозкамПарсингСтрок(СтрокаXML,СтрокаАктXML,НомераДокументовПоВложениям,Поставщик,СведенияОКотрагенте,ИнструкцияКРазбору,АдресРасхода)
	
	МассивСообщений = новый Массив;
	Контейнера = новый Массив;
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.УстановитьСтроку(СтрокаXML);
	Документ = ФабрикаXDTO.ПрочитатьXML(ЧтениеXML);
	
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.УстановитьСтроку(СтрокаАктXML);
	ДокументАкт = ФабрикаXDTO.ПрочитатьXML(ЧтениеXML);
	
	Если ИнструкцияКРазбору.Свойство("Контейнера") тогда
		Выполнить ИнструкцияКРазбору.Контейнера;
	КонецЕсли;
	
	Если ИнструкцияКРазбору.Свойство("Счет") тогда
		Выполнить ИнструкцияКРазбору.Счет;
	КонецЕсли;
	
	ОткрытиеФормы = Ложь;	
	ПоФактуре = ИнструкцияКРазбору.РазборПоФактуре;
	
	//Если ИнструкцияКРазбору <> Неопределено тогда
	//	Если ИнструкцияКРазбору.Свойство("Контейнера") тогда
	//		//ИнструкцияТранзитКонтейнера = новый Структура("Путь,ОбработкаВыполнить","Документ.Документ.СвСчФакт.ИнфПолФХЖ1.ТекстИнф[2].Значен","Контейнера = СтрРазделить(СтрЗаменить(ЗначениеПоля,""Дополнение: "",""""),"","",Ложь)");	
	//		ЗначениеПоля = Неопределено;
	//		Попытка
	//			Выполнить ("ЗначениеПоля = " + ИнструкцияКРазбору.Контейнера.Путь);
	//			Результат = Неопределено;
	//			Выполнить (ИнструкцияКРазбору.Контейнера.ОбработкаВыполнить);
	//			
	//		Исключение 
	//			ОткрытиеФормы = Истина;	
	//		КонецПопытки; 
	//		
	//	КонецЕсли;
	//КонецЕсли;
	
	Если ПоФактуре Тогда
		XMLИсполнитель = Документ.Документ.СвСчФакт.СвПрод.ИдСв.СвЮЛУч;
	   	XMLЗаказчик = Документ.Документ.СвСчФакт.СвПокуп.ИдСв.СвЮЛУч;
		XMLВалюта = Документ.Документ.СвСчФакт.КодОКВ;
		Попытка
			XMLДоговор = Документ.Документ.СвПродПер.СвПер.ОснПер;
		Исключение
			XMLДоговор = Неопределено;	
		КонецПопытки;
		ЭтоФЛ = Ложь;
	Иначе
		Попытка
			XMLИсполнитель = Документ.Документ.СвДокПРУ.СодФХЖ1.Исполнитель.ИдСв.СвОрг.СвЮЛ;
			ЭтоФЛ = Ложь;
		Исключение
			XMLИсполнитель = Документ.Документ.СвДокПРУ.СодФХЖ1.Исполнитель.ИдСв.СвИП;    
			ЭтоФЛ = Истина;
		КонецПопытки;
		XMLЗаказчик = Документ.Документ.СвДокПРУ.СодФХЖ1.Заказчик.ИдСв.СвОрг.СвЮЛ;
		XMLВалюта = Документ.Документ.СвДокПРУ.ДенИзм.КодОКВ;
		XMLДоговор = Неопределено;
		Если ТипЗнч(Документ.Документ.СвДокПРУ.СодФХЖ1.Основание) = Тип("СписокXDTO") тогда	
			Для Каждого СтрокаXMLОснование Из Документ.Документ.СвДокПРУ.СодФХЖ1.Основание цикл
				Если СтрокаXMLОснование.НаимОсн = "Договор" тогда
					XMLДоговор = СтрокаXMLОснование;
				КонецЕсли;
				Если СтрокаXMLОснование.НаимОсн = "Счёт" тогда
					НомераДокументовПоВложениям.НомерСчета = СтрокаXMLОснование.НомОсн;
					НомераДокументовПоВложениям.ДатаСчета =  ВычленитьДату(СтрокаXMLОснование.ДатаОсн);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
	Если ИнструкцияКРазбору.Свойство("ФорматированиеНомерСчета") тогда
		Выполнить ИнструкцияКРазбору.ФорматированиеНомерСчета;	
	КонецЕсли;
	

	//---------------------------- Разбор заголовков ----------------------------------	Начало
	Прототип = FARESM_ПолучитьСтруктураРасхода();
	
	//Прототип = Новый Структура("Организация,Контрагент,Договор,Валюта,Продавец,НомерАкта,ДатаАкта,НомерСФ,ДатаСФ,НомерСчета,ДатаСчета,ПредъявленСчет,ПредъявленАкт,ПредъявленСФ");
		
	Прототип.Организация = FARESM_ПолучитьОрганизацию(XMLЗаказчик.ИННЮЛ, XMLЗаказчик.КПП, НомераДокументовПоВложениям.ДатаАкта); 
	Если НЕ ЗначениеЗаполнено(Прототип.Организация) Тогда
		МассивСообщений.Добавить("Не удалось найти организацию с ИНН/КПП "+XMLЗаказчик.ИННЮЛ+"/"+XMLЗаказчик.КПП);
		//Возврат Неопределено;
	КонецЕсли;
	
	Если ЭтоФЛ Тогда
		Прототип.Контрагент = ITSP_ВернутьЭлементСправочника("Контрагенты", Новый Структура("Наименование,ИНН",XMLИсполнитель.ФИО,XMLИсполнитель.ИННФЛ),СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок("ИНН")); //Дефолтовый 	
	Иначе
		Если Поставщик = "ВСК, ООО" тогда
			Прототип.Контрагент = ITSP_ВернутьЭлементСправочника("Контрагенты", Новый Структура("Наименование,ИНН,КПП",СведенияОКотрагенте.СвЮЛ.Название,СведенияОКотрагенте.СвЮЛ.ИНН,СведенияОКотрагенте.СвЮЛ.КПП),СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок("ИНН,КПП")); //Дефолтовый				
		//ИначеЕсли Поставщик = "Фит, ООО" тогда
		//	//
