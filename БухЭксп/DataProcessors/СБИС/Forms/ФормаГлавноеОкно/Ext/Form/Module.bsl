&НаКлиенте
Процедура FARESM_ОбработатьДанныеРасхода(Результат, ДанныеРасхода) Экспорт 
	МассивСообщений = ДанныеРасхода.МассивСообщений;
	Если Результат = Неопределено тогда
		СоответствиеНовыхНоменклатурПоставщика = Новый Соответствие;
		ДанныеРасхода.Вставить("СоответствиеНовыхНоменклатурПоставщика",СоответствиеНовыхНоменклатурПоставщика);
	ИначеЕсли Результат.Номенклатура.Пустая() тогда
		ДанныеРасхода.ОткрытиеФормы = Истина;
	Иначе
		Для Каждого НомерСтроки Из ДанныеРасхода.ТекущиеНомераСтрок Цикл
			ДанныеРасхода.СоответствиеНовыхНоменклатурПоставщика.Вставить(НомерСтроки,Результат.Номенклатура);
		КонецЦикла;
	КонецЕсли;
	
	Если МассивСообщений.Количество() тогда		
		Пока МассивСообщений.Количество() Цикл
			Сообщ = МассивСообщений[0];
			МассивСообщений.Удалить(0);
			Если ТипЗнч(Сообщ) = Тип("Строка") Тогда
				Сообщить(Сообщ);			
			Иначе
				Если Сообщ.Действие = "ПодобратьНоменклатуру" Тогда
					ДанныеРасхода.Вставить("ТекущиеНомераСтрок", Сообщ.НомераСтрок);
					ОписаниеОповещенияОЗакрытииНоменклатураПоставщиков = новый ОписаниеОповещения("FARESM_ОбработатьДанныеРасхода",ЭтотОбъект,ДанныеРасхода);
					ОткрытьФорму("Справочник.НоменклатураПоставщиков.ФормаОбъекта",Сообщ.СтруктураЗадачи,,,,,ОписаниеОповещенияОЗакрытииНоменклатураПоставщиков);			
				КонецЕсли;
				Возврат;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если ДанныеРасхода.СоответствиеНовыхНоменклатурПоставщика.Количество() <> 0 тогда
		FARESM_ОбработатьДанныеРасходаНаСервере(ДанныеРасхода);	
	КонецЕсли;
	
	Если ДанныеРасхода.ОткрытиеФормы тогда 
		SBIS_CW_ОповещениеОЗаписиДокумента = Новый ОписаниеОповещения("SBIS_CW_ОповещениеОЗаписиДокумента",ЭтотОбъект,ДанныеРасхода.Контекст);
		ОткрытьФорму("Документ.CW_РасходыПоГрузоперевозке.ФормаОбъекта",Новый Структура("Ключ,АдресПараметровЗаполнения,SBIS_CW_ОповещениеОЗаписиДокумента",ДанныеРасхода.РасходСсылка,ДанныеРасхода.АдресРасхода,Истина),,,,,SBIS_CW_ОповещениеОЗаписиДокумента);
	Иначе
		Попытка          
			Расход = FARESM_ЗаписатьРасход(ДанныеРасхода.АдресРасхода);
			FARESM_СвязатьДокументСПакетом(Расход, ДанныеРасхода.Контекст);		
			ОбновитьКонтент();
		Исключение
			SBIS_CW_ОповещениеОЗаписиДокумента = Новый ОписаниеОповещения("SBIS_CW_ОповещениеОЗаписиДокумента",ЭтотОбъект,ДанныеРасхода.Контекст);
			ОткрытьФорму("Документ.CW_РасходыПоГрузоперевозке.ФормаОбъекта",Новый Структура("Ключ,АдресПараметровЗаполнения,SBIS_CW_ОповещениеОЗаписиДокумента",ДанныеРасхода.РасходСсылка,ДанныеРасхода.АдресРасхода,Истина),,,,,SBIS_CW_ОповещениеОЗаписиДокумента);
		КонецПопытки;
	КонецЕсли; 
КонецПроцедуры

&НаКлиенте
Процедура FARESM_СвязатьДокументСПакетом(Расход, Контекст)
	Если Расход = Неопределено тогда
		возврат;
	КонецЕсли;
	
	ВложенияПакета = Контекст.ВложенияПакета;
	ИдСБИС_Строки = Контекст.ИдСБИС_Строки;
	//Перем Вложение, ВложенияПакета, Документ, ТекущаяСтрока;
	
	Для каждого Вложение ИЗ ВложенияПакета Цикл
		
		Если Вложение.Тип = "ЭДОСч" Тогда // ИЛИ (ЭтоВМКТ И Вложение.Тип = "" И СтрНайти(Вложение.Название,"Счет")>0) Тогда
			Документ = ITSP_РеквизитОбъекта(Расход,"ВедомыйСчет");
			ITSP_ПривязатьДокументКВложению(Вложение,Документ,ИдСБИС_Строки);		
		КонецЕсли;
		Если Вложение.Тип = "СчФктр" Тогда
			Документ = ITSP_РеквизитОбъекта(Расход,"ВедомыйСчетФактура");
			ITSP_ПривязатьДокументКВложению(Вложение,Документ,ИдСБИС_Строки);
		КонецЕсли;
		Если Вложение.Тип = "АктВР" ИЛИ Вложение.Тип = "УпдДоп" ИЛИ Вложение.Тип = "УпдСчфДоп" Тогда
			Документ = ITSP_РеквизитОбъекта(Расход,"ВедомыйДокумент");
			ITSP_ПривязатьДокументКВложению(Вложение,Документ,ИдСБИС_Строки);
			
			Если Вложение.Тип = "УпдСчфДоп" Тогда
				Документ = ITSP_РеквизитОбъекта(Расход,"ВедомыйСчетФактура");
				ITSP_ПривязатьДокументКВложению(Вложение,Документ,ИдСБИС_Строки);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаСервереБезКонтекста
Процедура FARESM_ОбработатьДанныеРасходаНаСервере(ДанныеРасхода) Экспорт 
	Прототип = ПолучитьИзВременногоХранилища(ДанныеРасхода.АдресРасхода);
	НомерСтроки = 0;
	Для Каждого СтрокаУслуга Из Прототип.Услуги Цикл
		НомерСтроки = НомерСтроки + 1;
		Номенклатура = ДанныеРасхода.СоответствиеНовыхНоменклатурПоставщика.Получить(НомерСтроки);
		Если Номенклатура <> Неопределено тогда 
			СтрокаУслуга.Номенклатура = Номенклатура;	
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры


&НаСервереБезКонтекста
Функция FARESM_ЗаписатьРасход(АдресРасхода)  
	Прототип = ПолучитьИзВременногоХранилища(АдресРасхода);
	Если ЗначениеЗаполнено(Прототип.Ссылка) тогда
		РасходОбъект = Прототип.Ссылка.ПолучитьОбъект();
	Иначе
		РасходОбъект = Документы.CW_РасходыПоГрузоперевозке.СоздатьДокумент();
	КонецЕсли;
	//РасходОбъект.Заполнить(Прототип);
	ЗаполнитьЗначенияСвойств(РасходОбъект,Прототип,,"Услуги,ВедомыйСчет,ВедомыйДокумент,ВедомыйСчетФактура");
	РасходОбъект.Услуги.Очистить();
	Для Каждого Услуга Из Прототип.Услуги цикл
		ЗаполнитьЗначенияСвойств(РасходОбъект.Услуги.Добавить(),Услуга);
	КонецЦикла;
	РасходОбъект.Записать(РежимЗаписиДокумента.Проведение);	
	Возврат РасходОбъект.Ссылка;
КонецФункции 


&НаКлиенте
Процедура SBIS_CW_ОповещениеОЗаписиДокумента(Ответ, Контекст) Экспорт 
	FARESM_СвязатьДокументСПакетом(Ответ,Контекст);
	ОбновитьКонтент(); 
КонецПроцедуры


&НаКлиенте
Функция ITSP_ПодготовитьСтруктуруДокументаСбис(СтрокаСпискаДокументов,Кэш)
	
	МассивПакетов = Новый Массив;	
	
	Для каждого Строка из СтрокаСпискаДокументов.СоставПакета Цикл		
		Документ = Строка.Значение;
		ПолныйСоставПакета = Кэш.Интеграция.ПрочитатьДокумент(Кэш, Строка.Значение.Идентификатор);
		Если ПолныйСоставПакета = Ложь Тогда
			Продолжить;
		КонецЕсли;
		МассивСлужебных = Новый Массив;
		сч = 0;
		Если ПолныйСоставПакета.Свойство("Вложение") Тогда
			Для Каждого Вложение Из ПолныйСоставПакета.Вложение Цикл
				Если Не Вложение.Свойство("Служебный") или Вложение.Служебный = "Нет" Тогда
					//XMLФайла = Кэш.Интеграция.ПолучитьДанныеФайла(Кэш,Вложение.Файл.Ссылка);
					////ПолныйСоставПакета.Вложение[сч].Вставить("XMLДокумента", XMLИсходногоФайла);
					//Вложение.Вставить("XMLДокумента", XMLФайла);
					Если Вложение.Зашифрован = "Да" Тогда
						ДвоичныеДанныеBase64 = Кэш.Интеграция.ПолучитьДанныеЗашифрованногоФайла(Кэш,Вложение.Файл.Ссылка);
						Вложение.Файл.Вставить("ДвоичныеДанные", ДвоичныеДанныеBase64);
						XMLФайла = ITSP_сбисТекстИзBase64(ДвоичныеДанныеBase64);
						//Кэш.Интеграция.ПроверитьПодписиВложения(Кэш,Вложение);
					Иначе
						XMLФайла = Кэш.Интеграция.ПолучитьДанныеФайла(Кэш,Вложение.Файл.Ссылка);
					КонецЕсли;
					Вложение.Вставить("XMLДокумента", XMLФайла);
					Если НЕ ЗначениеЗаполнено(Вложение.Номер) ИЛИ НЕ ЗначениеЗаполнено(Вложение.Дата) Тогда
						ITSP_ЗаполнитьНомерИДатуВложенияИзНазвания(Вложение.Название,Вложение.Номер,Вложение.Дата);		
					КонецЕсли;
				КонецЕсли;
				Если ПолныйСоставПакета.Свойство("Событие") Тогда
					Вложение.Вставить("Событие", ПолныйСоставПакета.Событие);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		МассивПакетов.Добавить(ПолныйСоставПакета);	
		Возврат МассивПакетов;
	КонецЦикла;
	
	Возврат МассивПакетов;
КонецФункции // ПодготовитьСтруктуруДокументаСбис()

