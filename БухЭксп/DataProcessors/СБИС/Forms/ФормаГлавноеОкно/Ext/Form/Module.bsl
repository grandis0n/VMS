Функция FARESM_ПолучитьОрганизацию(ИНН,КПП,Период)
	
	Если Период = Дата(1,1,1) тогда Период = ТекущаяДата() КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Организации.Ссылка КАК Ссылка,
		|	ИсторияРегистрацийВНалоговомОрганеСрезПоследних.РегистрацияВНалоговомОргане КАК РегистрацияВНалоговомОргане
		|ИЗ
		|	Справочник.Организации КАК Организации
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИсторияРегистрацийВНалоговомОргане.СрезПоследних(&Период, ) КАК ИсторияРегистрацийВНалоговомОрганеСрезПоследних
		|		ПО Организации.Ссылка = ИсторияРегистрацийВНалоговомОрганеСрезПоследних.СтруктурнаяЕдиница
		|ГДЕ
		|	Организации.ИНН = &ИНН
		|	И ИсторияРегистрацийВНалоговомОрганеСрезПоследних.РегистрацияВНалоговомОргане.КПП = &КПП
		|	И НЕ Организации.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("ИНН", ИНН);
	Запрос.УстановитьПараметр("КПП", КПП);
	Запрос.УстановитьПараметр("Период", Период);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВДЗ = РезультатЗапроса.Выбрать();
	
	Если  ВДЗ.Следующий() тогда
		Возврат ВДЗ.Ссылка;	
	Иначе
		Возврат Справочники.Организации.ПустаяСсылка();	
	КонецЕсли;;
	
	//}}КОНСТРУКТОР_ЗАПРОСА_С_ОБРАБОТКОЙ_РЕЗУЛЬТАТА
	
	
		
КонецФункции


&НаСервереБезКонтекста
Функция ITSP_ВернутьЭлементСправочника(Знач ИмяСправочника, Знач СтруктураЭлемента, Знач РеквизитыПоиска = "Наименование")
	Если ТипЗнч(СтруктураЭлемента) <> Тип("Структура") Тогда
		СтруктураЭлемента = Новый Структура("Наименование", СтруктураЭлемента);
	КонецЕсли;
	
	Менеджер = Справочники[ИмяСправочника];
	
	Если ТипЗнч(РеквизитыПоиска)=Тип("Массив") Тогда
		РеквизитПоиска = СокрЛП(РеквизитыПоиска[0]);
		РеквизитыПоиска.Удалить(0);
	Иначе
		РеквизитПоиска = РеквизитыПоиска;	
	КонецЕсли;
	
	Если СтруктураЭлемента.Наименование = "" Тогда	
		Возврат Менеджер.ПустаяСсылка();
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Спр.Ссылка
	|ИЗ
	|	Справочник."+ИмяСправочника+" КАК Спр
	|ГДЕ
	|	Спр.ПометкаУдаления    = ЛОЖЬ
	|	И Спр."+РеквизитПоиска+" = &Реквизит";
	
	Запрос.УстановитьПараметр("Реквизит", СтруктураЭлемента[РеквизитПоиска]);
	Для каждого РеквизитПоиска Из РеквизитыПоиска Цикл
		Запрос.Текст = Запрос.Текст + "
		|	И Спр."+РеквизитПоиска+" = &"+РеквизитПоиска+""; 
		Запрос.УстановитьПараметр(СокрЛП(РеквизитПоиска), СтруктураЭлемента[СокрЛП(РеквизитПоиска)]);	
	КонецЦикла;	
	
	Если СтруктураЭлемента.Свойство("Родитель") Тогда
		Запрос.Текст = Запрос.Текст + "
		|	И Спр.Родитель = &Родитель"; 
		Запрос.УстановитьПараметр("Родитель", СтруктураЭлемента.Родитель);
	КонецЕсли;
	Если СтруктураЭлемента.Свойство("Владелец") Тогда
		Запрос.Текст = Запрос.Текст + "
		|	И Спр.Владелец = &Владелец"; 
		Запрос.УстановитьПараметр("Владелец", СтруктураЭлемента.Владелец);
	КонецЕсли;
	
	Результат = Запрос.Выполнить();
	Если НЕ Результат.Пустой() Тогда
		ВыборкаДетальныеЗаписи = Результат.Выбрать();
		ВыборкаДетальныеЗаписи.Следующий();
		Возврат	ВыборкаДетальныеЗаписи.Ссылка;	
	КонецЕсли;
	
	Возврат Менеджер.ПустаяСсылка();	
КонецФункции

