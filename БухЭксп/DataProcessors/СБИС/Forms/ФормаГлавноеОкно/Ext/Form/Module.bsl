	УП = _БЭ.ПараметрыУчетнойПолитики(Прототип.Дата, Прототип.Организация);
	
	
	ТипПеревозкиИсключения = Новый Массив ;
	//ТипПеревозкиИсключения.Добавить(Справочники.CW_ТипыПеревозок.НайтиПоКоду(30));//Авто (контейнер)
	//ТипПеревозкиИсключения.Добавить(Справочники.CW_ТипыПеревозок.НайтиПоКоду(29));//Фура
	
	
