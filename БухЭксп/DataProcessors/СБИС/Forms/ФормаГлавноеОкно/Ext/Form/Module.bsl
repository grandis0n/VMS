	Кэш = сбисВосстановитьЗначения(СбисДополнительныеПараметры);
	
	СбисПараметрыСистемы = ПолучитьПараметрыСистемы(Отказ);
	Если Отказ Тогда
		Возврат СбисПараметрыСистемы;
	КонецЕсли;
	Кэш.Вставить("ПараметрыСистемы", СбисПараметрыСистемы);
	Версия = Кэш.ПараметрыСистемы.Обработка.Версия;
	
	КэшТекущегоСеанса = Новый Структура("Формы, Функции, РасчитанныеЗначения, Интерфейс, ПараметрыВыполненияФункций", Новый Структура("Получены", Новый Структура), Новый Структура, Новый Структура, Новый Структура, Новый Структура);
