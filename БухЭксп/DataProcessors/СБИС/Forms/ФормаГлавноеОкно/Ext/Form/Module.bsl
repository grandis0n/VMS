&НаСервереБезКонтекста
Процедура ITSP_ДобавитьОбъектПеревозки(Данные,ТЗ,ТипПеревозкиИсключения,МассивСообщений,Ошибка,Счет)
	
	НаименованиеГрузоперевозки = "";	
	Попытка
		НаименованиеГрузоперевозки = Данные.Container;
	Исключение
		Попытка
			НаименованиеГрузоперевозки = Данные.Wagon;
		Исключение
			МассивСообщений.Добавить("Невозможно выделить номер контейнера или вагона");	
			//Ошибка = Истина;
			Возврат;
		КонецПопытки;
	КонецПопытки;
	
	Если НЕ Счет.Пустая() Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	CW_РасходыПоГрузоперевозкеУслуги.Грузоперевозка КАК Ссылка
		|ИЗ
		|	Документ.CW_РасходыПоГрузоперевозке.Услуги КАК CW_РасходыПоГрузоперевозкеУслуги
		|ГДЕ
		|	CW_РасходыПоГрузоперевозкеУслуги.Ссылка = &Ссылка
		|	И CW_РасходыПоГрузоперевозкеУслуги.Грузоперевозка.Наименование = &Наименование";
		
		Запрос.УстановитьПараметр("Наименование", НаименованиеГрузоперевозки);
		Запрос.УстановитьПараметр("Ссылка", Счет);
		
		РезультатЗапроса = Запрос.Выполнить();
		Если РезультатЗапроса.Пустой() Тогда
			МассивСообщений.Добавить("Не удалось найти грузоперевозку "+НаименованиеГрузоперевозки+" в счете "+Счет);
			//Ошибка = Истина;
			//Возврат;
		КонецЕсли;

	Иначе
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	CW_Грузоперевозки.Ссылка
		|ИЗ
		|	Справочник.CW_Грузоперевозки КАК CW_Грузоперевозки
		|ГДЕ
		|	CW_Грузоперевозки.ПометкаУдаления = ЛОЖЬ
		|	И CW_Грузоперевозки.Наименование = &Наименование
		|	И НЕ CW_Грузоперевозки.ТипПеревозки В (&ТипПеревозкиИсключения)
		|
		|УПОРЯДОЧИТЬ ПО
		|	CW_Грузоперевозки.ДатаСделкиФ УБЫВ";
		
		Запрос.УстановитьПараметр("Наименование", НаименованиеГрузоперевозки);
		Запрос.УстановитьПараметр("ТипПеревозкиИсключения", ТипПеревозкиИсключения);
		
		РезультатЗапроса = Запрос.Выполнить();
		Если РезультатЗапроса.Пустой() Тогда
			МассивСообщений.Добавить("Не удалось найти грузоперевозку "+НаименованиеГрузоперевозки);
			//Ошибка = Истина;
			//Возврат;
		КонецЕсли;
		
	КонецЕсли;
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	ВыборкаДетальныеЗаписи.Следующий();
	
	НС = ТЗ.Добавить();
	НС.Идентификатор = Данные.CM_Id;
	НС.Грузоперевозка = ВыборкаДетальныеЗаписи.Ссылка;
	
КонецПроцедуры

