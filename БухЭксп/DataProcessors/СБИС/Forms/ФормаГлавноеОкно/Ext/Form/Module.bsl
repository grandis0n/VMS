	Если Ставка = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС18") ИЛИ Ставка = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС18_118") Тогда
		
		Возврат(18);
		
