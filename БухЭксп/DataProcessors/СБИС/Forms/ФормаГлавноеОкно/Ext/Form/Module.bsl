	Инструкция = новый Структура("РазборПоФактуре",Ложь);
	
	Если Контрагент = "Транзит, ООО" Тогда
			
		//ИнструкцияТранзитКонтейнера = новый Структура("Путь,ОбработкаВыполнить","Документ.Документ.СвСчФакт.ИнфПолФХЖ1.ТекстИнф[2].Значен","Контейнера = СтрРазделить(СтрЗаменить(ЗначениеПоля,""Дополнение: "",""""),"","",Ложь)");	
		
		ИнструкцияТранзитКонтейнера = "
