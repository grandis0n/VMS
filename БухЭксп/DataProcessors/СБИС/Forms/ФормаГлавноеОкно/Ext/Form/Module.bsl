&НаСервереБезКонтекста
Функция CW_ПрикрепитьФайлы(МассивФайлов,Родитель,ОбъектАрхива)
	//УстановитьПривилегированныйРежим(Истина);
	Для каждого СтруктураФайла Из МассивФайлов Цикл
		
		Попытка
			
			Если СтруктураФайла.Размер = Неопределено Тогда
				
				ВремФ = ПолучитьИмяВременногоФайла("html");
				ВремФPDF = ПолучитьИмяВременногоФайла("pdf");
				Текст = Новый ЗаписьТекста;
				Текст.Открыть(ВремФ,КодировкаТекста.UTF8);
				Текст.ЗаписатьСтроку(СтруктураФайла.АдресФайла);
				Текст.Закрыть();
				
				Если НЕ HTMLTOPDF(ВремФ,ВремФPDF) Тогда
					Сообщить("Не удалось преобразовать "+СтруктураФайла.ИмяФайла+" в PDF");
					Продолжить
				КонецЕсли;
				ФайлВрем = Новый Файл(ВремФPDF);
				СтруктураФайла.Размер = ФайлВрем.Размер();
				СтруктураФайла.АдресФайла = ПоместитьВоВременноеХранилище(Новый ДвоичныеДанные(ВремФPDF));
				УдалитьФайлы(ВремФ);
				УдалитьФайлы(ВремФPDF);
			КонецЕсли;
			
			НачатьТранзакцию();
			
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ
			|	CW_ОбъектыАрхива.Ссылка,
			|	CW_ОбъектыАрхива.Размер
			|ИЗ
			|	Справочник.CW_ОбъектыАрхива КАК CW_ОбъектыАрхива
			|ГДЕ
			|	CW_ОбъектыАрхива.Наименование = &Наименование
			|	И CW_ОбъектыАрхива.Объект = &Объект";
			
			Запрос.УстановитьПараметр("Наименование", СтруктураФайла.ИмяФайла);
			Запрос.УстановитьПараметр("Объект", ОбъектАрхива);
			
			РезультатЗапроса = Запрос.Выполнить();
			Если РезультатЗапроса.Пустой() Тогда
				// создаем объект архива
				НФ = Справочники.CW_ОбъектыАрхива.СоздатьЭлемент();
				// --- 
				НФ.Объект = ОбъектАрхива;
				НФ.ИмяФайла = СтруктураФайла.ИмяФайла;
				НФ.Расширение = _сф.ф_РасширениеФайла(НФ.ИмяФайла);
				НФ.Размер = СтруктураФайла.Размер;
				НФ.Наименование = НФ.ИмяФайла;
			Иначе	
				ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
				ВыборкаДетальныеЗаписи.Следующий();
				Если Окр(СтруктураФайла.Размер,0) = ВыборкаДетальныеЗаписи.Размер Тогда
					ОтменитьТранзакцию();
					Продолжить; // Не грузим лишнее	
				КонецЕсли;
				НФ = ВыборкаДетальныеЗаписи.Ссылка.ПолучитьОбъект();
			КонецЕсли;
			
			Если НФ.Том.Пустая() Тогда
				
				// установим том
				Запрос = Новый Запрос;
				Запрос.Текст = "ВЫБРАТЬ
				|	ТомаАрхива.Ссылка
				|ИЗ
				|	Справочник.CW_ТомаАрхива КАК ТомаАрхива
				|ГДЕ
				|	ТомаАрхива.Основной = ИСТИНА";
				Запрос.УстановитьПараметр("", );
				Выборка = Запрос.Выполнить().Выбрать();
				Если Выборка.Следующий() Тогда
					
					НФ.Том = Выборка.Ссылка;
					
				КонецЕсли; 
				
			КонецЕсли; 
			Если (Родитель <> Неопределено) Тогда
				
				Если (ТипЗнч(Родитель)=Тип("СправочникСсылка.CW_ОбъектыАрхива")) Тогда 
					
					Если (Родитель.ЭтоГруппа) Тогда
						НФ.Родитель = Родитель;
					Иначе
						НФ.Родитель = Родитель.Родитель;
					КонецЕсли; 
					
				КонецЕсли; 
				
			КонецЕсли; 
			НФ.Записать();
			// --- 
			Ответ = _ФА.ЗагрузитьФайлАрхива(НФ.Ссылка,СтруктураФайла.АдресФайла);
			Если (_УФКС.ВыполненоУспешно(Ответ)) Тогда
				НФ.ФайлЗагружен = Истина;
				НФ.Записать();
				//// --- 
				//ТекущийУзел = НФ.Ссылка;
				//Для каждого Стр Из СостояниеДерева Цикл
				//	Если (Стр.Значение = НФ.Родитель) Тогда
				//		Если (НЕ Стр.Пометка) Тогда
				//			Стр.Пометка = Истина;
				//		КонецЕсли; 
				//	КонецЕсли; 
				//КонецЦикла;  
				
			Иначе
				//Сообщить(_УФКС.ПредставлениеОшибки(Ответ));
				ВызватьИсключение "Ошибка прикрепления файла";
			КонецЕсли; 
			
			ЗафиксироватьТранзакцию();
			
		Исключение
			
			Сообщить(ОписаниеОшибки());
			
			Если (ТранзакцияАктивна()) Тогда
				ОтменитьТранзакцию();
			КонецЕсли; 
			
		КонецПопытки; 
		
	КонецЦикла; 
	
	//	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат(_УФКС.Ответ());
	
	// --- 
КонецФункции

&НаСервереБезКонтекста
Функция FARESM_ПолучитьСтруктураРасхода()
	
	СтруктураРасхода = новый Структура(); 
	Для каждого РеквизитРасхода Из Метаданные.Документы.CW_РасходыПоГрузоперевозке.СтандартныеРеквизиты цикл
		СтруктураРасхода.Вставить(РеквизитРасхода.Имя,РеквизитРасхода.Тип.ПривестиЗначение(Неопределено));	
	КонецЦикла;
	Для каждого РеквизитРасхода Из Метаданные.Документы.CW_РасходыПоГрузоперевозке.Реквизиты цикл
		СтруктураРасхода.Вставить(РеквизитРасхода.Имя,РеквизитРасхода.Тип.ПривестиЗначение(Неопределено));	
	КонецЦикла;
	Услуги = новый ТаблицаЗначений;
	Для каждого РеквизитТЗУслугиРасхода Из Метаданные.Документы.CW_РасходыПоГрузоперевозке.ТабличныеЧасти.Услуги.Реквизиты цикл 
		Услуги.Колонки.Добавить(РеквизитТЗУслугиРасхода.Имя,РеквизитТЗУслугиРасхода.Тип);	
	КонецЦикла;
	СтруктураРасхода.Вставить("Услуги",Услуги);
	Возврат СтруктураРасхода;
КонецФункции // ЗасунутьВPDF()


