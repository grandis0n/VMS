	//---------------------------- Разбор заголовков ---------------------------------- Конец
	
	//----------------------------- Поиск существующего расхода ----------------------- Начало
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	CW_РасходыПоГрузоперевозке.Ссылка КАК Ссылка
