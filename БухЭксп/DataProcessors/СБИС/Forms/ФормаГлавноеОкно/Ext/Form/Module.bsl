		Возврат(20);
		
	Иначе
		
		 Возврат(0);
		
	КонецЕсли; 
	
	// --- 
КонецФункции

&НаСервереБезКонтекста
Процедура ДобавитьСтрокуИзИсточникаСтрокДокументов(ПереченьСтрокXML,ОписаниеСтрокиXML,ПоФактуре,Строка)
	
	НС = Новый Структура(ОписаниеСтрокиXML);
	Если ПоФактуре Тогда
		ЗаполнитьЗначенияСвойств(НС,Строка);
	Иначе
		ITSP_УбратьДвойныеПробелы(Строка.НаимРабот);
		НС.НаимТов = Строка.НаимРабот;
		НС.КолТов = Строка.Количество;	
		НС.НалСт = Строка.НалСт;
		НС.ОКЕИ_Тов = Строка.ОКЕИ;
		НС.СтТовУчНал = Строка.СтоимУчНДС;	
	КонецЕсли;
	Если ЕстьСвойство(Строка,"ИнфПолФХЖ2") Тогда
		НС.Вставить("ИнфПолФХЖ2",Строка.ИнфПолФХЖ2);	
	КонецЕсли;
	Если ЕстьСвойство(Строка,"ДопСведТов") И ЕстьСвойство(Строка.ДопСведТов,"КодТов") Тогда
		НС.Вставить("ИнфПолФХЖ2",Строка.ДопСведТов.КодТов);		
	КонецЕсли;	
	ПереченьСтрокXML.Добавить(НС);
	
КонецПроцедуры // ДобавитьСтрокуИзИсточникаСтрокДокументов(ПереченьСтрокXML,ОписаниеСтрокиXML,ПоФактуре,ИсточникСтрокДокумента)()

&НаСервереБезКонтекста
Процедура ITSP_УбратьДвойныеПробелы(Строка)
	Строка = СтрЗаменить(Строка,Символ(160)," ");
	Пока СтрНайти(Строка,"  ")>0 Цикл
		Строка = СтрЗаменить(Строка,"  ", " ");	
	КонецЦикла;
КонецПроцедуры // УбратьДвойныеПробелы()

&НаСервереБезКонтекста
Процедура ITSP_ДобавитьКонтейнераПоКоносаменту(Коносамент,МассивКонтейнеров)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	CW_ХарактеристикиГрузоперевозок.Грузоперевозка.Наименование КАК ГрузоперевозкаНаименование
		|ИЗ
		|	РегистрСведений.CW_ХарактеристикиГрузоперевозок КАК CW_ХарактеристикиГрузоперевозок
		|ГДЕ
		|	CW_ХарактеристикиГрузоперевозок.Параметр = &П_Коносамент
		|	И CW_ХарактеристикиГрузоперевозок.Значение = &Коносамент
		|	И CW_ХарактеристикиГрузоперевозок.Грузоперевозка.ПометкаУдаления = ЛОЖЬ";
	
	Запрос.УстановитьПараметр("Коносамент", Коносамент);
	Запрос.УстановитьПараметр("П_Коносамент", ПланыВидовХарактеристик.CW_ПараметрыГрузоперевозок.НайтиПоНаименованию("Коносамент",Истина));
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		МассивКонтейнеров.Добавить(ВыборкаДетальныеЗаписи.ГрузоперевозкаНаименование);
	КонецЦикла;
	
КонецПроцедуры 

&НаКлиенте
Функция ITSP_сбисТекстИзBase64(ДвоичныеДанныеBase64) Экспорт
	ИмяВремФайла = ПолучитьИмяВременногоФайла("xml");
	ДвоичныеДанныеФайла = Base64Значение(ДвоичныеДанныеBase64);
	ДвоичныеДанныеФайла.Записать(ИмяВремФайла);
	Текст = Новый ЧтениеТекста(ИмяВремФайла);
	XMLФайла = Текст.Прочитать();
	Если Найти(XMLФайла, "encoding=""UTF-8""")>0 Тогда
		Текст = Новый ЧтениеТекста(ИмяВремФайла, КодировкаТекста.UTF8);
		XMLФайла = Текст.Прочитать();
	КонецЕсли;
	Попытка
		УдалитьФайлы(ИмяВремФайла);
	Исключение
	КонецПопытки;
	Попытка
		Если Лев(XMLФайла,4)="%PDF" Тогда // для PDF-файла иногда возвращается крокозябра, которая потом вызывает ошибку передачи данных между клиентом и сервером, несмотря на то, что это строка
			Возврат "";
		КонецЕсли;
	Исключение
	КонецПопытки;
	Возврат XMLФайла;
КонецФункции

&НаСервереБезКонтекста
Функция ВернутьПоследнийДоговорБЭ(Контрагент,Организация,Валюта,ВидДоговора)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	CW_ДоговорыПоГрузоперевозкам.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.CW_ДоговорыПоГрузоперевозкам КАК CW_ДоговорыПоГрузоперевозкам
		|ГДЕ
		|	CW_ДоговорыПоГрузоперевозкам.ПометкаУдаления = ЛОЖЬ
		|	И CW_ДоговорыПоГрузоперевозкам.Владелец = &Контрагент
		|	И CW_ДоговорыПоГрузоперевозкам.Организация = &Организация
		|	И CW_ДоговорыПоГрузоперевозкам.ВидДоговора = &ВидДоговора
		|	И CW_ДоговорыПоГрузоперевозкам.ВалютаДоговора = &Валюта
		|
		|УПОРЯДОЧИТЬ ПО
		|	CW_ДоговорыПоГрузоперевозкам.ДатаДоговора УБЫВ";
	
	Запрос.УстановитьПараметр("ВидДоговора", ВидДоговора);
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Валюта", Валюта);
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Справочники.CW_ДоговорыПоГрузоперевозкам.ПустаяСсылка();
	КонецЕсли;
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	ВыборкаДетальныеЗаписи.Следующий();

	Возврат ВыборкаДетальныеЗаписи.Ссылка;
КонецФункции

