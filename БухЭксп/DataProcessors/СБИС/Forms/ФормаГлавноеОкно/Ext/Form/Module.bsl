				НС.СтатьяЗатрат = СтрокаСтатьяЗатрат.СтатьяЗатрат;
			Иначе
				НС.СтатьяЗатрат = УП.ОсновнаяСтатьяЗатрат;
			КонецЕсли; 
			
			
			//---------- Попытка определить Порядок отражения на сначала на основании счета (если это возможно) затем на основании этого же самого документа, если он уже был введён
			
			Если ПорядокОтраженияПоРанееСуществовавшемуРасходу<>Неопределено Тогда
				ITSP_ВернутьПорядокОтраженияПоТаблицеСоответствий(НС,ПорядокОтраженияПоРанееСуществовавшемуРасходу);
			КонецЕсли;
			
			НС.ПорядокОтражения = Перечисления.CW_ПорядокОтраженияЗатрат.Затраты;
			
			//Если НС.ПорядокОтражения.Пустая() Тогда
			//	Если Поставщик = "ВМЭС, ООО" И НС.Номенклатура.Код = "00-00000162" Тогда
			//		НС.ПорядокОтражения = Перечисления.CW_ПорядокОтраженияЗатрат.Затраты;	
			//	Иначе
			//		НС.ПорядокОтражения = Перечисления.CW_ПорядокОтраженияЗатрат.Перевыставление;
			//	КонецЕсли;
			//КонецЕсли;
			//------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
			Если НС.ПорядокОтражения = Перечисления.CW_ПорядокОтраженияЗатрат.Перевыставление Тогда
				СтруктураПараметров = Новый Структура;
				СтруктураПараметров.Вставить("Объект"				, НС.Грузоперевозка);
				СтруктураПараметров.Вставить("ЭтоВариантБюджета"	, Ложь);
				СтруктураПараметров.Вставить("Контрагент"			, НС.Грузоперевозка.Клиент);
			
				НС.Покупатель = CW_Финансы.ВернутьПлательщика(СтруктураПараметров);
				Если ЗначениеЗаполнено(НС.Покупатель) Тогда
					ДоговорГП = ITSP_ДоговорГрузоперевозки(НС.Грузоперевозка, НС.Покупатель);
					Если (ДоговорГП = Неопределено) Тогда
						НС.ДоговорПокупателя = CW_Документы.ПолучитьПоследнийДоговор(НС.Покупатель, Прототип.Организация, Перечисления.ВидыДоговоровКонтрагентов.СПокупателем);
					Иначе
						НС.ДоговорПокупателя = ДоговорГП;
					КонецЕсли; 
				КонецЕсли; 
			ИначеЕсли НС.ПорядокОтражения = Перечисления.CW_ПорядокОтраженияЗатрат.Затраты Тогда
				Если ЗначениеЗаполнено(НС.Номенклатура) Тогда
					
					СтруктураПараметров = Новый Структура("Дата, Организация,Номенклатура,НоменклатурнаяГруппа");
					ЗаполнитьЗначенияСвойств(СтруктураПараметров,Прототип);
					СтруктураПараметров.Номенклатура = НС.Номенклатура;
					НС.СпособУчетаНДС = CW_Финансы.ПолучитьСпособУчетаНДС(СтруктураПараметров);
				КонецЕсли;		
			КонецЕсли;
			
			//CW_Шаблоны.УстановитьПредставлениеНоменклатуры(НС,Расход.Договор,Расход);
			НС.Представление = СтрокаДокументаXML.НаимТов;
			СчетчикСтрок = СчетчикСтрок + 1;
			ИндексСтроки = ИндексСтроки + 1;
		КонецЦикла;
		
		Если Номенклатура.Пустая() Тогда
			МассивСообщений.Вставить(0,Новый Структура("Действие,СтруктураЗадачи,НомераСтрок","ПодобратьНоменклатуру",Новый Структура("Наименование,SBIS_CW_НаименованиеРасширенное,Владелец,ВидСтавкиНДС,Артикул",РазложеннаяСтрока.Услуга,РазложеннаяСтрока.Услуга,Прототип.Контрагент,СтавкаНДС),НомераСтрок));
			ОткрытиеФормы = Истина;
			//Возврат Неопределено;
		КонецЕсли;
		
	КонецЦикла;
	
	//---------------------------- Разбор строк ВМКТ -----------------------------------
	Если Прототип.ПредъявленСчет И (Не ЗначениеЗаполнено(Прототип.ДатаСчета) ИЛИ Не ЗначениеЗаполнено(Прототип.НомерСчета)) Тогда
		Если Не ЗначениеЗаполнено(Прототип.ДатаСчета) Тогда
			Прототип.ДатаСчета = Прототип.ДатаАкта;	
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Прототип.НомерСчета) Тогда
			Прототип.НомерСчета = Прототип.НомерАкта;	
		КонецЕсли;
	КонецЕсли;
	АдресРасхода = ПоместитьВоВременноеХранилище(Прототип,АдресРасхода);
	Результат = Новый Структура("АдресРасхода,РасходСсылка,МассивСообщений,ОткрытиеФормы",АдресРасхода,Прототип.Ссылка,МассивСообщений,ОткрытиеФормы);
	//Расход.Записать(РежимЗаписиДокумента.Проведение);	
	Возврат Результат;	
КонецФункции // РасходПоГрузоперевозкамИзXMLФеско()

&НаСервереБезКонтекста
Функция ITSP_РазложитьСтрокуСКонтейнерами(СтруктураСтроки,Поставщик,Документ)
	СыраяСтрока = СтруктураСтроки.НаимТов;
	Если Поставщик = "Вмкт, ООО" Тогда
		Возврат ITSP_РазложитьСтрокуВМКТ(СыраяСтрока);
	ИначеЕсли Поставщик = "ВСК, ООО" Тогда
		Возврат ITSP_РазложитьСтрокуВСК(СтруктураСтроки);
	Иначе 		
		Если СтруктураСтроки.Свойство("ИнфПолФХЖ2") тогда
			Возврат ITSP_РазложитьСтрокуСтандарт(СыраяСтрока + " " + СтруктураСтроки.ИнфПолФХЖ2);	
		Иначе
			Возврат ITSP_РазложитьСтрокуСтандарт(СыраяСтрока);					
		КонецЕсли;
	КонецЕсли;	
КонецФункции // ITSP_РазложитьСтрокуВМКТ()

&НаСервереБезКонтекста
Функция ITSP_РазложитьСтрокуСтандарт(Знач СыраяСтрока, СтруктураСтроки = Неопределено)
	Рез = Новый Структура("Контейнера,НоменклатураПоставщика,Услуга",Новый Массив,Ложь);
	
	Рез.Услуга = "";	
	СыраяСтрока = СтрЗаменить(СыраяСтрока,"("," ");
	СыраяСтрока = СтрЗаменить(СыраяСтрока,")"," ");
	ЧастиСтроки = СтрРазделить(СыраяСтрока," ",Ложь);
	Для каждого Часть ИЗ ЧастиСтроки Цикл
		Контейнер = ВРег(СокрЛП(Часть));
		Контейнер = СтрЗаменить(Контейнер,",","");
		Если СтрДлина(Контейнер) <> 11 ИЛИ Сред(Контейнер,4,1)<>"U"  Тогда
			Если ITSP_СоотвествуетШаблонуПериодаДат(Контейнер) Тогда // 17/01/18-08/02/18
				Продолжить;
			КонецЕсли;
			Рез.Услуга = Рез.Услуга + ?(Рез.Услуга = "",""," ")+Часть; 
			Продолжить;
		КонецЕсли;
		Рез.Контейнера.Добавить(Контейнер);	
	КонецЦикла;
	Рез.Услуга = СокрЛП(Рез.Услуга);
	
	Возврат Рез;
КонецФункции // ITSP_РазложитьСтрокуВМКТ()

&НаСервереБезКонтекста
Функция ITSP_РазложитьСтрокуВМЭС(СыраяСтрока)
	Рез = Новый Структура("Контейнера,НоменклатураПоставщика,Услуга",Новый Массив,Ложь);
	
	Рез.Услуга = "";	
	ЧастиСтроки = СтрРазделить(СыраяСтрока," ",Ложь);
	Для каждого Часть ИЗ ЧастиСтроки Цикл
		Контейнер = ВРег(СокрЛП(Часть));
		Контейнер = СтрЗаменить(Контейнер,")","");
		Контейнер = СтрЗаменить(Контейнер,"(","");
		Если СтрДлина(Контейнер) <> 11 ИЛИ Сред(Контейнер,4,1)<>"U"  Тогда
			Если ITSP_СоотвествуетШаблонуПериодаДат(Контейнер) Тогда // 17/01/18-08/02/18
				Продолжить;
			КонецЕсли;
			Рез.Услуга = Рез.Услуга + ?(Рез.Услуга = "",""," ")+Часть; 
			Продолжить;
		КонецЕсли;
		Рез.Контейнера.Добавить(Контейнер);	
	КонецЦикла;
	Рез.Услуга = СокрЛП(Рез.Услуга);
	
	Если Рез.Контейнера.Количество() = 0 Тогда
		Для каждого Часть ИЗ ЧастиСтроки Цикл
			Коносамент = ВРег(СокрЛП(Часть));
			Коносамент = СтрЗаменить(Коносамент,")","");
			Коносамент = СтрЗаменить(Коносамент,"(","");	
			Если СтрДлина(Коносамент) = 16 И Лев(Часть,4)="SNKO" Тогда
				ITSP_ДобавитьКонтейнераПоКоносаменту(Коносамент,Рез.Контейнера);	
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если СтрНайти(Рез.Услуга,"(")>0 Тогда
		Рез.Услуга = Лев(Рез.Услуга,СтрНайти(Рез.Услуга,"(")-1);	
	КонецЕсли;
	Рез.Услуга = СокрЛП(Рез.Услуга);
	
	Возврат Рез;
КонецФункции // ITSP_РазложитьСтрокуВМКТ()

&НаСервереБезКонтекста
Функция ITSP_РазложитьСтрокуВСК(СтруктураСтроки)
	Рез = Новый Структура("Контейнера,НоменклатураПоставщика,Услуга",Новый Массив,Ложь,СокрЛП(СтруктураСтроки.НаимТов));
	
	Если НЕ СтруктураСтроки.Свойство("ИнфПолФХЖ2") Тогда
		Возврат Рез;	
	КонецЕсли;

	
	Если ТипЗнч(СтруктураСтроки.ИнфПолФХЖ2) = Тип("ОбъектXDTO") Тогда
		ЗанестиИзИнфПолФХЖ2КонтейнераВСК(СтруктураСтроки.ИнфПолФХЖ2,Рез.Контейнера);		
	Иначе
		Для каждого СтрокаИнфПолФХЖ2 ИЗ СтруктураСтроки.ИнфПолФХЖ2 Цикл
			ЗанестиИзИнфПолФХЖ2КонтейнераВСК(СтрокаИнфПолФХЖ2,Рез.Контейнера);
		КонецЦикла;
	КонецЕсли;	
	
	Возврат Рез;
КонецФункции // ITSP_РазложитьСтрокуВМКТ()

&НаСервереБезКонтекста
Процедура ЗанестиИзИнфПолФХЖ2КонтейнераВСК(СтруктураСтроки,Контейнера)
	Если НЕ СтруктураСтроки.Идентиф = "№" Тогда
		Возврат;
	КонецЕсли;
	ИнформацияОКонтейнере = СтрРазделить(СтруктураСтроки.Значен,"|",Истина);
	Контейнера.ДОбавить(ИнформацияОКонтейнере[0]);
КонецПроцедуры // ЗанестиИзИнфПолФХЖ2КонтейнераВСК()


&НаСервереБезКонтекста
Функция ITSP_СоотвествуетШаблонуПериодаДат(Строка) // 17/01/18-08/02/18
	Если СтрДлина(Строка) <> 17 Тогда
		Возврат ЛОжь;
	КонецЕсли;
	
	Возврат (Сред(Строка,3,1)="/" И Сред(Строка,6,1)="/" И Сред(Строка,9,1)="-" И Сред(Строка,12,1)="/" И Сред(Строка,15,1)="/");
	
КонецФункции // ITSP_СоотвествуетШаблонуПериодаДат()

&НаСервереБезКонтекста
Функция ITSP_РазложитьСтрокуВМКТ(СыраяСтрока)
		
	Рез = Новый Структура("Контейнера,НоменклатураПоставщика,Услуга",Новый Массив,Истина);	
	КонецТекстаУслуги = СтрНайти(СыраяСтрока,"|");
	Рез.Услуга = СокрЛП(Лев(СыраяСтрока,КонецТекстаУслуги-1)); 	

	Остаток = Прав(СыраяСтрока,СтрДлина(СыраяСтрока)-КонецТекстаУслуги);
	//--------------------------- Очистка от курса -----------------------------Начало
	НачалоКурса = СтрНайти(Остаток,"Курс");
	Если НачалоКурса<>0 Тогда
		Остаток = Лев(Остаток,НачалоКурса-1)+Прав(Остаток,СтрДлина(Остаток)-СтрНайти(Остаток,")",,НачалоКурса));			
	КонецЕсли;
	//--------------------------- Очистка от курса -----------------------------Конец
	//--------------------------- Очистка от содержимого квадратных скобок -----------------------------Начало
	Пока СтрНайти(Остаток,"[")>0 И СтрНайти(Остаток,"]")>0 Цикл
		Остаток = Лев(Остаток,СтрНайти(Остаток,"[")-1)+Прав(Остаток,СтрДлина(Остаток)-СтрНайти(Остаток,"]"));	
	КонецЦикла;
	//--------------------------- Очистка от содержимого квадратных скобок -----------------------------Конец
	Остаток = СтрЗАменить(Остаток,":","");
	Остаток = СтрЗАменить(Остаток,";"," ");
	
	Контейнера = СтрРазделить(Остаток," ",Ложь);
	Для каждого ВозможноКонтейнер ИЗ Контейнера Цикл
		Контейнер = ВРег(СокрЛП(ВозможноКонтейнер));
		Если СтрДлина(Контейнер) <> 11 ИЛИ Сред(Контейнер,4,1)<>"U"  Тогда
			Продолжить;
		КонецЕсли;
		Рез.Контейнера.Добавить(Контейнер);	
	КонецЦикла;
		
	Возврат Рез;
КонецФункции // ITSP_РазложитьСтрокуВМКТ()

&НаСервереБезКонтекста
Функция ITSP_ДобавитьОбъектПеревозкиПоНаименованию(НаименованиеГрузоперевозки,ТипПеревозкиИсключения,МассивСообщений)
	
	Если ПустаяСтрока(НаименованиеГрузоперевозки) Тогда
		МассивСообщений.Добавить("Пустой номер контейнера");	
		Возврат Неопределено;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	CW_Грузоперевозки.Ссылка
	|ИЗ
	|	Справочник.CW_Грузоперевозки КАК CW_Грузоперевозки
	|ГДЕ
	|	CW_Грузоперевозки.ПометкаУдаления = ЛОЖЬ
	|	И CW_Грузоперевозки.Наименование = &Наименование
	|	И НЕ CW_Грузоперевозки.ТипПеревозки В (&ТипПеревозкиИсключения)
	|
	|УПОРЯДОЧИТЬ ПО
	|	CW_Грузоперевозки.ДатаСделкиФ УБЫВ";
	
	Запрос.УстановитьПараметр("Наименование", НаименованиеГрузоперевозки);
	Запрос.УстановитьПараметр("ТипПеревозкиИсключения", ТипПеревозкиИсключения);
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		МассивСообщений.Добавить("Не удалось найти грузоперевозку "+НаименованиеГрузоперевозки);
		Возврат Неопределено;
	КонецЕсли;
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	ВыборкаДетальныеЗаписи.Следующий();
	
	Возврат ВыборкаДетальныеЗаписи.Ссылка;
	
КонецФункции

