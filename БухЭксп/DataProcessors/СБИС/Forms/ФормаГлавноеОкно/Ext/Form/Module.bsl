Функция ITSP_НайтиНоменклатуруПоНоменклатуреПоставщика(Наименование,Владелец,СтавкаНДС,Период)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	НоменклатураПоставщиков.Номенклатура КАК Номенклатура,
		|	НоменклатураПоставщиков.Номенклатура.ВидСтавкиНДС = &СтавкаНДС КАК СортировкаПоСтавкеНДС
		|ИЗ
		|	Справочник.НоменклатураПоставщиков КАК НоменклатураПоставщиков
		|ГДЕ
		|	НоменклатураПоставщиков.ПометкаУдаления = ЛОЖЬ
		|	И НоменклатураПоставщиков.ЭтоГруппа = ЛОЖЬ
		|	И НоменклатураПоставщиков.SBIS_CW_НаименованиеРасширенное Подобно &Наименование
		|	И НоменклатураПоставщиков.Владелец = &Владелец
		|
		|УПОРЯДОЧИТЬ ПО
		|	СортировкаПоСтавкеНДС УБЫВ";
	//ДлиннаНаименования = Метаданные.Справочники.НоменклатураПоставщиков.СтандартныеРеквизиты.Наименование.Тип.КвалификаторыСтроки.Длина;
	
	//Запрос.УстановитьПараметр("Наименование", Лев(Наименование,ДлиннаНаименования));
	Запрос.УстановитьПараметр("Наименование", Наименование);
	Запрос.УстановитьПараметр("СтавкаНДС", Перечисления.ВидыСтавокНДС.ВидСтавки(СтавкаНДС));
	Запрос.УстановитьПараметр("Владелец", Владелец);

	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Справочники.Номенклатура.ПустаяСсылка();
	КонецЕсли;
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	ВыборкаДетальныеЗаписи.Следующий();

	Возврат ВыборкаДетальныеЗаписи.Номенклатура;

КонецФункции // НайтиНоменклатуруПоНоменклатуреПоставщика()


