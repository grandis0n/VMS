		|Для Каждого СтрокаДопСвойство Из СписокДопСвойств Цикл
		|	Если СтрокаДопСвойство.Идентиф = ""Дополнение"" тогда 	
		|		Контейнера = ITSP_РазложитьСтрокуСтандарт(СтрокаДопСвойство.Значен).Контейнера;
		|	Прервать;
		|	КонецЕсли;
		|КонецЦикла;
		|";

		
		ИнструкцияТранзитСчет = "
		|СписокДопСвойств = ДокументАкт.Документ.СвДокПРУ.СодФХЖ1.ИнфПолФХЖ1.ТекстИнф;
		|Для Каждого СтрокаДопСвойство Из СписокДопСвойств Цикл
		|	Если СтрокаДопСвойство.Идентиф = ""ПоДоговору"" тогда 	
		|		СтрокаПредставлениеСчет = СтрокаДопСвойство.Значен;
		|		СтрокаПредставлениеСчет = СтрЗаменить(СтрокаПредставлениеСчет,""Сч. №"","""");
		|		МассивСтрокаПредставлениеСчет = СтрРазделить(СтрокаПредставлениеСчет,"" от "",Ложь);
		|		Если МассивСтрокаПредставлениеСчет.Количество() = 2 тогда
		|			НомераДокументовПоВложениям.НомерСчета = СокрЛП(МассивСтрокаПредставлениеСчет[0]);
		|			НомераДокументовПоВложениям.ДатаСчета = Дата(СокрЛП(МассивСтрокаПредставлениеСчет[1])+"" 00:00:00"");				
		|		КонецЕсли;
		|		Прервать;
		|	КонецЕсли;
		|КонецЦикла;
		|";
		
		Инструкция.Вставить("Контейнера",ИнструкцияТранзитКонтейнера);
		Инструкция.Вставить("Счет",ИнструкцияТранзитСчет);
	ИначеЕсли Контрагент = "Фит, ООО" Тогда
		
		ИнструкцияФорматированиеНомерСчета = "
		|НомераДокументовПоВложениям.НомерСчета = Прав(НомераДокументовПоВложениям.НомерСчета, СтрДлина(НомераДокументовПоВложениям.НомерСчета)-3); ";	
		Инструкция.Вставить("ФорматированиеНомерСчета",ИнструкцияФорматированиеНомерСчета);
		
		
		//Инструкция.ПоФактуре = Ложь;
	КонецЕсли;
	
	СоответствиеКонтрагентовПоФактуре.Вставить(Контрагент,Инструкция);		
	
