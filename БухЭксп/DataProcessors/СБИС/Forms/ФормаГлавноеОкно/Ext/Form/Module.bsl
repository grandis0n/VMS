Процедура ITSP_ДобавитьСтрокуАкта(Данные,ТЗ,МассивСообщений,Ошибка)
	
	Попытка 
		НДС = Число(Данные.ClInvR_VAT);
		Всего = Число(Данные.ClInvR_Sum);
	Исключение
		НДС = Неопределено;
		Всего = Неопределено;	
	КонецПопытки;
	
	Попытка
		НС = ТЗ.Добавить();
		НС.Идентификатор = Данные.ClInvR_ID;
		НС.Наименование = Данные.ClInvR_Text_RUS; // Поиск номенклатуры не тут, так как для её создания, надо иметь ещё и ЕдИзм
		Если Данные.ClInvR_VAT_Code = "VAT18" Тогда
			НС.СтавкаНДС = Перечисления.СтавкиНДС.НДС18;
		ИначеЕсли Данные.ClInvR_VAT_Code = "VAT20" Тогда
			НС.СтавкаНДС = Перечисления.СтавкиНДС.НДС20;
		ИначеЕсли Данные.ClInvR_VAT_Code = "VAT0" Тогда
			НС.СтавкаНДС = Перечисления.СтавкиНДС.НДС0;	
		Иначе
			НС.СтавкаНДС = Перечисления.СтавкиНДС.БезНДС;	
		КонецЕсли;
		НС.Цена = Число(Данные.ClInvR_Rate);
		НС.Всего = Всего;
		НС.НДС = НДС;
	Исключение
		МассивСообщений.Добавить("Не удалось разобрать строку акта "+ОписаниеОшибки());
		Ошибка = Истина;	
	КонецПопытки;
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ITSP_ДобавитьУслугуПоОбъектам(Данные,ТЗ,МассивСообщений,Ошибка)
	НС = ТЗ.Добавить();
	НС.ИдентификаторСтрокиАкта = Данные.ClInvR_ID;
	НС.ИдентификаторПеревозки = Данные.CM_Id;
	НС.ЕдиницаИзмерения = Справочники.КлассификаторЕдиницИзмерения.НайтиПоКоду(Данные.Meas_Code);
