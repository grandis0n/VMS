		ОсталосьРаспределить = Число(СтрокаДокументаXML.СтТовУчНал);
		РавнаяДоля = ОсталосьРаспределить/КоличествоКонтейнеров;
		НомераСтрок = новый Массив;
		СчетчикСтрок = 1;
		Для каждого Контейнер ИЗ РазложеннаяСтрока.Контейнера Цикл
			НС = Прототип.Услуги.Добавить();
			НомераСтрок.Добавить(Прототип.Услуги.Количество());
			Если ТипЗнч(Контейнер) = Тип("СправочникСсылка.CW_Грузоперевозки") тогда
