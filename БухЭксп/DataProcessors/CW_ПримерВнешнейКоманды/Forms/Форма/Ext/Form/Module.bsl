&НаКлиенте
Процедура ЗакрытьИзФормы(Команда)
	
	ЭтаФорма.Закрыть();
	
	//массив методов формы владельца, которые необходимо выполнить после закрытия формы внешней команды
	МетодыФормыВладельца = Новый Массив;
	МетодыФормыВладельца.Добавить("_УправлениеЭлементамиФормы()");
	
	ПараметрыОповещения = Новый Структура;
	ПараметрыОповещения.Вставить("УникальныйИдентификатор"	, ВладелецФормы.УникальныйИдентификатор);
	ПараметрыОповещения.Вставить("МетодыФормыВладельца"		, МетодыФормыВладельца);
	
	Оповестить("ВыполнитьМетодВладельца", ПараметрыОповещения);
	
КонецПроцедуры

