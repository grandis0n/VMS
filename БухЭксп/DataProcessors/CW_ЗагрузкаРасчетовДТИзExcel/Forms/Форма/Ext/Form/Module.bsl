
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ОтказНаКлиенте = Не ЗначениеЗаполнено(Параметры.Формат);
	СсылкаНаОбъект = Параметры.СсылкаНаОбъект;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если ОтказНаКлиенте Тогда
		ПоказатьПредупреждение(,"Обработка не предназначена для непосредственного использования!", 5);
		Отказ = Истина;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти 

#Область РаботаСФайлом

&НаКлиенте
Процедура ФайлДанныхНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ДиалогВыбораФайла = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	
	ДиалогВыбораФайла.Заголовок = "Загрузить табличный документ из файла";
	ДиалогВыбораФайла.Фильтр    = "Лист Excel (*.xls)|*.xls| Лист Excel (*.xlsx)|*.xlsx";
	
	Если ДиалогВыбораФайла.Выбрать() Тогда
		ФайлДанных = ДиалогВыбораФайла.ПолноеИмяФайла;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ФайлДанныхОткрытие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ОткрытьФайлНаСервере();

КонецПроцедуры

&НаСервере
Процедура ОткрытьФайлНаСервере()
	
	Если Не ЗначениеЗаполнено(ФайлДанных) Тогда
		Возврат;
	КонецЕсли; 
	
	ВыбФайл = Новый Файл(ФайлДанных);
	Если НЕ ВыбФайл.Существует() Тогда
		Возврат;
	КонецЕсли;
	
	#Если Не ВебКлиент Тогда
	ЗапуститьПриложение(ФайлДанных);
	#КонецЕсли
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьДанныеИзФайла(Команда)
	
	ОчиститьСообщения();
	ТаблицаДанных.Очистить();
	
	ДанныеЗагружены = ЗаполнитьТаблицуДанныхИзExcel(ФайлДанных);
	
	Если ДанныеЗагружены Тогда
		Состояние("Идет синхронизация данных...");
		
		СинхронизироватьДанныеНаСервере(ЭтаФорма.ВладелецФормы.УникальныйИдентификатор);
		АдресВоВременномХранилище = ПолучитьАдресВоВременномХранилище(ЭтаФорма.ВладелецФормы.УникальныйИдентификатор);
		
		СтруктураПередачи = Новый  Структура;
		СтруктураПередачи.Вставить("АдресВоВременномХранилище", АдресВоВременномХранилище);
		СтруктураПередачи.Вставить("ТаможенныйСборРуб", ТаможенныйСборРуб);
		СтруктураПередачи.Вставить("Курс", Курс);
		СтруктураПередачи.Вставить("Дата", Дата);
		
		Оповестить("Справочник.РасчетыДТ.Изменение", СтруктураПередачи, ЭтаФорма);
		
		ОбработчикРезультата = Новый ОписаниеОповещения("ПослеЗавершенияПомещенияФайлаНаСервер", ЭтаФорма);
	
		МассивВладельцев = Новый Массив;
		МассивВладельцев.Добавить(СсылкаНаОбъект);
		
		ЗапрашиватьТипФайлаПриДобавленииВАрхив = CW_РаботаСФайламиСервер.ЗапрашиватьТипФайлаПриДобавленииВАрхив();
		
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("МассивВладельцев", МассивВладельцев);
		ДополнительныеПараметры.Вставить("ЗапрашиватьТипФайлаПриДобавленииВАрхив", ЗапрашиватьТипФайлаПриДобавленииВАрхив);  
		ДополнительныеПараметры.Вставить("ОбработчикРезультата", ОбработчикРезультата);  
		
		ОписаниеОповещенияОЗавершении = Новый ОписаниеОповещения("ОбработкаПомещенияФайла", CW_РаботаСФайламиКлиент, ДополнительныеПараметры);
		
		НачатьПомещениеФайлаНаСервер(ОписаниеОповещенияОЗавершении,, ,, ФайлДанных, УникальныйИдентификатор);		
		
	КонецЕсли; 
	
КонецПроцедуры   

&НаКлиенте
Процедура ПослеЗавершенияПомещенияФайлаНаСервер(ОписаниеПомещенногоФайла, ДополнительныеПараметры) Экспорт
	
	ЭтаФорма.Закрыть(); 
	
КонецПроцедуры

&НаСервере
Функция ИспользуетсяАрхив()
	Возврат ПолучитьФункциональнуюОпцию("CW_ИспользованиеФайловогоАрхива");
КонецФункции
 
&НаСервере
Функция ФайлДобавлен(ИмяФайла)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ИмяФайла", ИмяФайла);
	Запрос.УстановитьПараметр("Объект",   СсылкаНаОбъект);
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	CW_ОбъектыАрхива.Ссылка
	|ИЗ
	|	Справочник.CW_ОбъектыАрхива КАК CW_ОбъектыАрхива
	|ГДЕ
	|	CW_ОбъектыАрхива.ПометкаУдаления = ЛОЖЬ
	|	И CW_ОбъектыАрхива.Объект = &Объект
	|	И CW_ОбъектыАрхива.ИмяФайла = &ИмяФайла";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Возврат Выборка.Следующий();
	
КонецФункции

&НаСервере
Функция ПолучитьАдресВоВременномХранилище(Адрес)

	
	ТаблицаДляПередачи = ТаблицаДанных.Выгрузить(,"КодТНВЭД,ОписаниеТовара,Номенклатура,СтранаПроисхождения,Цена,ЦенаИТС,Количество,КоличествоДоп,"
            			+"Сумма,ДопРасходы,ТаможеннаяСтоимость,ПошлинаПроцент,ПошлинаРуб,СезСпецПошлинаРуб,НДСПроцент,АнтидемпинговаяПошлинаРуб,"
						+"Всего,ВсегоРуб,НДСРуб, ЕдиницаИзмерения");
						
	Возврат ПоместитьВоВременноеХранилище(ТаблицаДляПередачи, Адрес);					
	
КонецФункции
    
#КонецОбласти 

#Область РаботаСExcel

&НаКлиенте
Функция ЗаполнитьТаблицуДанныхИзExcel(ИмяФайла, НомерЛистаExcel = 1)
	
	xlLastCell = 11;
	
	ВыбФайл = Новый Файл(ИмяФайла);
	Если НЕ ВыбФайл.Существует() Тогда
		Сообщить("Файл не существует!");
		Возврат Ложь;
	КонецЕсли;
	
	Попытка
		Excel = Новый COMОбъект("Excel.Application");
		Excel.WorkBooks.Open(ИмяФайла);
		Состояние("Обработка файла Microsoft Excel...");
		ExcelЛист = Excel.Sheets(НомерЛистаExcel);
	Исключение
		Сообщить("Ошибка. Возможно неверно указан номер листа книги Excel. Либо на компьютере не установлен Excel.");
		Возврат ложь;
	КонецПопытки;

	ActiveCell  = Excel.ActiveCell.SpecialCells(xlLastCell);
	RowCount    = ActiveCell.Row;
	RowBegin    = 5;
	
	ColumnCount = ActiveCell.Column;
		
	ОбластьДанных = ExcelЛист.Range(ExcelЛист.Cells(RowBegin,1),ExcelЛист.Cells(RowCount,ColumnCount));
	Данные        = ОбластьДанных.Value.Выгрузить();
	
	СформироватьСтрокиТаблицыДанныхНаСервере(RowCount - RowBegin);
	ЗаполнитьТаблицуСоответствияКолонокНаСервере();
	
	Для каждого Строка Из СоответствиеКолонок Цикл
		Попытка
			ЗагрузитьКолонкуНаСервере(Данные[Строка.НомерКолонкиИсточник - 1],Строка.ИмяКолонкиПриемник);
		Исключение
			Сообщить("Не удалось загрузить колонку: <" + Строка.ИмяКолонкиПриемник + ">");
			Сообщить(ОписаниеОшибки());
			Возврат Ложь;
		КонецПопытки;	
	КонецЦикла; 
	
	// Получим курс и дату
	КурсИзФайла = ExcelЛист.Cells(2,9).Text;
	Курс        = ПолучитьЧислоИзСтроки(КурсИзФайла);
	
	ДатаИзФайла = ExcelЛист.Cells(1,1).Text;
	Дата        = ПолучитьДатуРасчета(ДатаИзФайла, ЭтаФорма.ВладелецФормы.УникальныйИдентификатор);
	
	Excel.WorkBooks.Close();
	Excel = 0;
	
	// Удалим пустые строки таблицы
	Индекс = ТаблицаДанных.Количество() - 1;
	
	Пока Индекс >= 0 Цикл
		Строка = ТаблицаДанных.Получить(Индекс);
		
		Если ЗначениеЗаполнено(Строка.ВсегоРуб) И
			НЕ ЗначениеЗаполнено(Строка.Сумма) Тогда
			ТаможенныйСборРуб = Строка.ВсегоРуб;  // В этой же колонке (после промежуточных итогов)
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Строка.КодТНВЭД_ИзФайла) Тогда
			ТаблицаДанных.Удалить(Индекс);
		КонецЕсли;
		
		Индекс = Индекс - 1;
		
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции 

&НаСервере
Процедура ЗагрузитьКолонкуНаСервере(ДанныеКолонки, ИмяКолонки)
	
	_ТаблицаДанных = РеквизитФормыВЗначение("ТаблицаДанных");
	_ДанныеКолонки = Новый Массив;
	
	Попытка
		Колонка = _ТаблицаДанных.Колонки[ИмяКолонки]; // Если колонка содержит тип - Число, то приведем все элементы массива в число
		Если Колонка.ТипЗначения.СодержитТип(Тип("Число")) Тогда
			Для каждого Элемент Из ДанныеКолонки Цикл
				_ДанныеКолонки.Добавить(ПолучитьЧислоИзСтроки(Элемент)); 
			КонецЦикла; 
		ИначеЕсли ИмяКолонки = "КодТНВЭД_ИзФайла" Тогда // Уберем пробелы из кода	
			Для каждого Элемент Из ДанныеКолонки Цикл
				Элемент = СтрЗаменить(Элемент, " ", "");
				Элемент = СтрЗаменить(Элемент, Символ(160), "");
				_ДанныеКолонки.Добавить(Элемент); 
			КонецЦикла; 
		Иначе
			_ДанныеКолонки = ДанныеКолонки;
		КонецЕсли; 
		_ТаблицаДанных.ЗагрузитьКолонку(_ДанныеКолонки, Колонка);
	Исключение
		Сообщить(ОписаниеОшибки());
	КонецПопытки;
	
	ЗначениеВРеквизитФормы(_ТаблицаДанных, "ТаблицаДанных");
	
КонецПроцедуры

