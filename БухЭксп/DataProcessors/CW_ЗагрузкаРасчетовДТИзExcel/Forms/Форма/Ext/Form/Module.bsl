	|	И КлассификаторТНВЭД.Код = &КодТНВЭД_ИзФайла";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	// Создаем новый из классификатора
	Данные = Справочники.КлассификаторТНВЭД.ТаблицаКлассификатораТНВЭД();
    Отбор  = Новый Структура("Код", Строка(СтрокаТЗ.КодТНВЭД_ИзФайла)); 
	НайденныеСтроки = Данные.НайтиСтроки(Отбор); 
	
	Если НайденныеСтроки.Количество() = 1 Тогда
		Строка0 = НайденныеСтроки[0];
	Иначе
		Сообщение = Новый СообщениеПользователю;
		Сообщение.ИдентификаторНазначения = УИД_ВладельцаФормы;
		Сообщение.Текст = "Не удалось одназначно идентифицировать код ТН ВЭД: <" + Строка(СтрокаТЗ.КодТНВЭД_ИзФайла) + "> в классификаторе кодов ТН ВЭД";
		Сообщение.Сообщить();
		Возврат Неопределено;
	КонецЕсли;
		
	КодТНВЭД_Ссылка = Справочники.КлассификаторТНВЭД.СоздатьЭлемент();
	КодТНВЭД_Ссылка.Код                = Строка0.Код;
	КодТНВЭД_Ссылка.Наименование       = Строка0.Наименование;
	КодТНВЭД_Ссылка.НаименованиеПолное = СокрЛП(СтрокаТЗ.ОписаниеТовара);
	
	Попытка
		КодТНВЭД_Ссылка.Записать();
	Исключение
		Сообщение = Новый СообщениеПользователю;
		Сообщение.ИдентификаторНазначения = УИД_ВладельцаФормы;
		Сообщение.Текст = ОписаниеОшибки();
		Сообщение.Сообщить();
	КонецПопытки; 
	
	Возврат КодТНВЭД_Ссылка.Ссылка;
	
	//// Создаем новый
