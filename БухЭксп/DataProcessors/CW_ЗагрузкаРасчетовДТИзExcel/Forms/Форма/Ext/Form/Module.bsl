&НаСервере
Функция ПолучитьСтрануПроисхождения(СтрокаТЗ, УИД_ВладельцаФормы)
	
	Страна = СокрЛП(СтрокаТЗ.Страна_ИзФайла);
	
	Если НЕ ЗначениеЗаполнено(Страна) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Страна_ИзФайла", Страна);
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СтраныМира.Ссылка
	|ИЗ
	|	Справочник.СтраныМира КАК СтраныМира
	|ГДЕ
	|	СтраныМира.ПометкаУдаления = ЛОЖЬ
	|	И СтраныМира.Наименование = &Страна_ИзФайла";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	// Создаем новый из классификатора
	Данные = Справочники.СтраныМира.ТаблицаКлассификатора();
    Отбор  = Новый Структура("Наименование", ВРег(Страна)); 
	НайденныеСтроки = Данные.НайтиСтроки(Отбор); 
	
	Если НайденныеСтроки.Количество() = 1 Тогда
		Строка0 = НайденныеСтроки[0];
	Иначе
		Сообщение = Новый СообщениеПользователю;
		Сообщение.ИдентификаторНазначения = УИД_ВладельцаФормы;
		Сообщение.Текст = "Не удалось одназначно идентифицировать страну: <" + Страна + "> в классификаторе стран";
		Сообщение.Сообщить();
		Возврат Неопределено;
	КонецЕсли;
		
	Страна_Ссылка = Справочники.СтраныМира.СоздатьЭлемент();
	Страна_Ссылка.Код                = Строка0.Код;
	Страна_Ссылка.Наименование       = Строка0.Наименование;
	Страна_Ссылка.НаименованиеПолное = Строка0.НаименованиеПолное;
	Страна_Ссылка.КодАльфа2          = Строка0.КодАльфа2;
	Страна_Ссылка.КодАльфа3          = Строка0.КодАльфа3;
	
	Попытка
		Страна_Ссылка.Записать();
	Исключение
		Сообщение = Новый СообщениеПользователю;
		Сообщение.ИдентификаторНазначения = УИД_ВладельцаФормы;
		Сообщение.Текст = ОписаниеОшибки();
		Сообщение.Сообщить();
	КонецПопытки; 
	
	Возврат Страна_Ссылка.Ссылка;
	
КонецФункции

