	//КодТНВЭД_Ссылка.Наименование = Строка(СтрокаТЗ.КодТНВЭД_ИзФайла);
	//КодТНВЭД_Ссылка.Описание     = СокрЛП(СтрокаТЗ.ОписаниеТовара);
	//КодТНВЭД_Ссылка.ОсновнаяНоменклатура = Номенклатура;
	//
	//Попытка
	//	КодТНВЭД_Ссылка.Записать();
	//Исключение
	//    Сообщение = Новый СообщениеПользователю;
	//	Сообщение.ИдентификаторНазначения = УИД_ВладельцаФормы;
	//	Сообщение.Текст = ОписаниеОшибки();
