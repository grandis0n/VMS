&НаСервере
Функция ПолучитьЧислоИзСтроки(ИсходнаяСтрока) Экспорт
	
	Попытка
		ИсходнаяСтрока = СтрЗаменить(ИсходнаяСтрока, " ", "");
		ЧислоИзСтроки = Число(СокрЛП(ИсходнаяСтрока));
		Возврат ЧислоИзСтроки;
	Исключение
		МассивЧисел = Новый Массив; 		
		СтрокаЧисел = "";
		
		ПервыйРазделитель = Истина;
		Для Индекс = 1 По СтрДлина(СокрЛП(ИсходнаяСтрока)) Цикл
			
			Символ = Сред(ИсходнаяСтрока, Индекс, 1); // Перебираем все сиволы из нашей строки
			
			Если КодСимвола(Символ) >= 48 И КодСимвола(Символ) <= 57 
				ИЛИ КодСимвола(Символ) = 46 Тогда // Код нуля - 48, код 9-ки - 57, код "." - 46
				СтрокаЧисел = СтрокаЧисел + Символ;
			ИначеЕсли КодСимвола(Символ) = 44 И ПервыйРазделитель Тогда // Символ "," меняем на "." (только один раз)
				СтрокаЧисел = СтрокаЧисел + ".";
				ПервыйРазделитель = Ложь;
			ИначеЕсли СтрДлина(СтрокаЧисел) = 0 Тогда
				Продолжить;
			Иначе
				Прервать;
			КонецЕсли;
			
		КонецЦикла;
		
		Если СтрДлина(СтрокаЧисел) > 0 Тогда
			ЧислоИзСтроки = Число(СтрокаЧисел);
		Иначе
			ЧислоИзСтроки = 0;
		КонецЕсли;
		
		Возврат ЧислоИзСтроки;
		
	КонецПопытки; 

КонецФункции

&НаСервере
Функция ПолучитьДатуРасчета(ИсходнаяСтрока, УИД_ВладельцаФормы);
	
	Попытка
		МассивЧисел = Новый Массив; 		
		СтрокаЧисел = "";
		
		ПервыйРазделитель = Истина;
		Для Индекс = 1 По СтрДлина(СокрЛП(ИсходнаяСтрока)) Цикл
			
			Символ = Сред(ИсходнаяСтрока, Индекс, 1); // Перебираем все сиволы из нашей строки
			
			Если КодСимвола(Символ) >= 48 И КодСимвола(Символ) <= 57 
				ИЛИ КодСимвола(Символ) = 46 Тогда // Код нуля - 48, код 9-ки - 57, код "." - 46
				СтрокаЧисел = СтрокаЧисел + Символ;
			ИначеЕсли КодСимвола(Символ) = 44 И ПервыйРазделитель Тогда // Символ "," меняем на "." (только один раз)
				СтрокаЧисел = СтрокаЧисел + ".";
				ПервыйРазделитель = Ложь;
			ИначеЕсли СтрДлина(СтрокаЧисел) = 0 Тогда
				Продолжить;
			Иначе
				Прервать;
			КонецЕсли;
			
		КонецЦикла;
		
		Если СтрДлина(СтрокаЧисел) > 0 Тогда
			ДатаРасчета = Дата(СтрокаЧисел + " 00:00:00");
		Иначе
			ДатаРасчета = Неопределено;
		КонецЕсли;
	Исключение
		Сообщение = Новый СообщениеПользователю;
		Сообщение.ИдентификаторНазначения = УИД_ВладельцаФормы;
		Сообщение.Текст = "Не удалось одназначно идентифицировать дату расчета";
		Сообщение.Сообщить();
		ДатаРасчета = Неопределено;
		
	КонецПопытки;
		
	Возврат ДатаРасчета;
	
КонецФункции	
#КонецОбласти

#Область Синхронизация

&НаСервере
Процедура СинхронизироватьДанныеНаСервере(УИД_ВладельцаФормы)
	
	// Синхронизируем справочники и расчитываем показатели
	Для каждого Строка Из ТаблицаДанных Цикл
		Строка.КодТНВЭД            = ПолучитьКодТНВЭД(Строка, УИД_ВладельцаФормы);
		Строка.Номенклатура        = Номенклатура; 
		Строка.ЕдиницаИзмерения    = Строка.Номенклатура.ЕдиницаИзмерения;
		Строка.СтранаПроисхождения = ПолучитьСтрануПроисхождения(Строка, УИД_ВладельцаФормы);
		Строка.НДСПроцент          = СтавкаНДС;
		Строка.ЦенаИТС             = Строка.ТаможеннаяСтоимость / ?(Строка.Количество = 0, 1, Строка.Количество);
		Строка.Цена                = Строка.Сумма / ?(Строка.Количество = 0, 1, Строка.Количество);
	КонецЦикла; 
	
КонецПроцедуры

