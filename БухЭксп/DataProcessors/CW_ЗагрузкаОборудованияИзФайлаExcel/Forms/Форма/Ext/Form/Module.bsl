&НаСервереБезКонтекста
Процедура ЗаполнитьДанныеПараметра(Параметр, СтруктураРасшифровки) 
	
	ПолеПоиска = Новый Структура("ИмяПоля,СинонимПоля", "",""); 
	
	ПустаяСсылка = Параметр.ТипЗначения.ПривестиЗначение(Неопределено);
	Если ОбщегоНазначения.ЭтоСсылка(ТипЗнч(ПустаяСсылка)) Тогда
		ПолеПоиска.ИмяПоля 		= 	"Наименование";
		ПолеПоиска.СинонимПоля	=	"Наименование"; 
	КонецЕсли;    
	
	ЗначениеПараметра = Новый Структура;
	ЗначениеПараметра.Вставить("ИмяПоля", 		"Значение");
	ЗначениеПараметра.Вставить("СинонимПоля", 	"Значение");
	
	ДанныеРасшифровки = Новый Структура;
	ДанныеРасшифровки.Вставить("Ссылка", 		Параметр);
	ДанныеРасшифровки.Вставить("СинонимПоля", 	СокрЛП(Параметр.Наименование));
	ДанныеРасшифровки.Вставить("ЗначениеПоля", 	ЗначениеПараметра);
	ДанныеРасшифровки.Вставить("ПолеПоиска", 	ПолеПоиска);
	
	СтруктураРасшифровки = Новый Структура;
	СтруктураРасшифровки.Вставить("ПредставлениеЯчейки",	СокрЛП(Параметр.Наименование));
	СтруктураРасшифровки.Вставить("Идентификатор", 			XMLСтрока(Параметр));
	СтруктураРасшифровки.Вставить("Параметр", 				ДанныеРасшифровки);
	СтруктураРасшифровки.Вставить("ТипЗначения", 			Параметр.ТипЗначения);
	
КонецПроцедуры  

&НаСервереБезКонтекста
Функция ПолучитьСписокРеквизитовДоступныхДляПоиска(ИмяРеквизита)
	
	РеквизитыПоиска = новый СписокЗначений;
	
	Реквизит = Метаданные.Справочники.CW_Грузоперевозки.Реквизиты.Найти(ИмяРеквизита);
	Если Реквизит = Неопределено Тогда
		Возврат РеквизитыПоиска;
	КонецЕсли;
	
	ПустоеЗначение = Реквизит.Тип.ПривестиЗначение(Неопределено);
	Если ОбщегоНазначения.ЭтоСсылка(ТипЗнч(ПустоеЗначение)) Тогда
		
		МетаданныеРеквизита = ПустоеЗначение.Метаданные();
		
		Если МетаданныеРеквизита.ДлинаКода <> 0 Тогда  
			
			Реквизит = МетаданныеРеквизита.СтандартныеРеквизиты["Код"];
			Синоним  = Реквизит.Синоним;
			Если ПустаяСтрока(Синоним) Тогда
				Синоним = "Код";  
			КонецЕсли;
			
			РеквизитыПоиска.Добавить(Реквизит.Имя, Синоним); 
		КонецЕсли;
		
		Если МетаданныеРеквизита.ДлинаНаименования <> 0 Тогда
			Реквизит = МетаданныеРеквизита.СтандартныеРеквизиты["Наименование"];
			Синоним  = Реквизит.Синоним;
			Если ПустаяСтрока(Синоним) Тогда
				Синоним = "Наименование";  
			КонецЕсли;
			
			РеквизитыПоиска.Добавить(Реквизит.Имя, Синоним); 
		КонецЕсли;
		
		Для Каждого Реквизит из МетаданныеРеквизита.Реквизиты Цикл   
			Если Реквизит.Тип = Новый ОписаниеТипов("ХранилищеЗначения") Тогда
				Продолжить;
			Конецесли; 
			Если СтрНачинаетсяС(ВРег(Реквизит.Имя), "УДАЛИТЬ") Тогда
				Продолжить;
			КонецЕсли;
			
			РеквизитыПоиска.Добавить(Реквизит.Имя, Реквизит.Синоним); 
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат РеквизитыПоиска; 
	
КонецФункции

