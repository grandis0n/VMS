&НаКлиенте
Функция ПолучитьСписокВыборТипаДанных()
	
	СписокВыбора = Новый СписокЗначений;
	СписокВыбора.Добавить("Реквизит",	"Реквизит оборудования",,БиблиотекаКартинок.Реквизит);
	СписокВыбора.Добавить("Параметр",	"Параметр оборудования",,БиблиотекаКартинок.CW_ПараметрыГрузоперевозок);   
	
	Возврат СписокВыбора;

КонецФункции  

&НаСервере
Функция ПолучитьСписокДоступныхРеквизитовОбъекта()
	
	СписокЗначений = Новый СписокЗначений;
	СписокЗначений.Добавить("Наименование", "Наименование");
	
	стрДоступныеРеквизиты 		= "ВидПеревозки,Типоразмер,Примечание";
	массивДоступнныхРеквизитов 	= СтрРазделить(стрДоступныеРеквизиты,",", Ложь); 
	
	МетаданныеОбъекта = ПолучитьМетаданныеОбъекта();
	
	Реквизиты = МетаданныеОбъекта.Реквизиты;
	Для Каждого ИмяРеквизита из массивДоступнныхРеквизитов Цикл
		Реквизит = Реквизиты.Найти(ИмяРеквизита);
		Если Реквизит = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		СписокЗначений.Добавить(Реквизит.Имя, Реквизит.Синоним);
	КонецЦикла;
	
	Возврат СписокЗначений;
	
КонецФункции

