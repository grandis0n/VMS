&НаКлиенте
Процедура ЗаполнитьЗначенияКолонки(Команда) 
	
	ВыделенныеСтроки = Элементы.ТаблицаСоответствий.ВыделенныеСтроки;
	
	ОписаниеКолонки  = ПолучитьДанныеКолонки();   
	Если ОписаниеКолонки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ВыделенныеСтроки",	ВыделенныеСтроки);
	ДополнительныеПараметры.Вставить("ОписаниеКолонки", 	ОписаниеКолонки);
	
	ОписаниеОпвещения = Новый ОписаниеОповещения("ЗавершитьВыборЭлемента", ЭтотОбъект, ДополнительныеПараметры);  
	
	Если ОписаниеКолонки.ЭтоСсылка Тогда
		
		СтруктураПараметров = Новый Структура;
		СтруктураПараметров.Вставить("РежимВыбора", 		Истина);
		СтруктураПараметров.Вставить("ЗакрыватьПриВыборе", 	Истина);
		СтруктураПараметров.Вставить("МножественныйВыбор", 	Ложь);
		
		ОткрытьФорму(ОписаниеКолонки.ИмяОбъекта+".ФормаВыбора", СтруктураПараметров, ЭтаФорма,,,,ОписаниеОпвещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
	Иначе  
		
		ПоказатьВводЗначения(ОписаниеОпвещения,, "Введите значение", ОписаниеКолонки.ТипЗначения);
		
	КонецЕсли;
	
	
КонецПроцедуры  

&НаСервере
Функция ПолучитьДанныеКолонки() 
	
	ПутьКданным 	= Элементы.ТаблицаСоответствий.ТекущийЭлемент.ПутьКДанным;
	мДанныеПоля 	= СтрРазделить(ПутьКданным, ".");   
	ИмяКолонки 		= мДанныеПоля[1];  
	
	Для Каждого КлючЗначение из  ОписаниеКолонок Цикл
		
		ОписаниеКолонки = КлючЗначение.Значение; 
		ПолеЗначения 	= ОписаниеКолонки["ПолеЗначения"]; 
		ИмяПоля 		= ОписаниеКолонки["ИмяКолонки"]; 
		
		Если ИмяПоля = ИмяКолонки и ПолеЗначения <> Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		
		Если ПолеЗначения <> Неопределено Тогда
			ИмяПоля 		= ПолеЗначения["ИмяКолонки"];
			ОписаниеКолонки = ПолеЗначения;
		КонецЕсли;
		
		Если ИмяПоля = ИмяКолонки Тогда
			ТипЗначения = ОписаниеКолонки["ТипЗначения"];	
			Прервать;
		Конецесли;
		
	КонецЦикла;
	
	ПустаяСсылка = ТипЗначения.ПривестиЗначение(Неопределено);   
	
	ОписаниеКолонки = Новый Структура;
	ОписаниеКолонки.Вставить("Имя",			ИмяПоля);
	ОписаниеКолонки.Вставить("ТипЗначения",	ТипЗнч(ПустаяСсылка));
	ОписаниеКолонки.Вставить("ЭтоСсылка", 	Ложь);  
	
	Если ОбщегоНазначения.ЭтоСсылка(ТипЗнч(ПустаяСсылка)) Тогда
		ПолноеИмяОбъекта = Метаданные.НайтиПоТипу(ТипЗнч(ПустаяСсылка)).ПолноеИмя();
		ОписаниеКолонки.Вставить("ЭтоСсылка",	Истина);  
		ОписаниеКолонки.Вставить("ИмяОбъекта", 	ПолноеИмяОбъекта);  
	КонецЕсли;      
	
	Возврат ОписаниеКолонки
	
КонецФункции

&НаКлиенте
Процедура ЗавершитьВыборЭлемента(РезультатВыбора, ДополнительныеПараметры) Экспорт
	
	Если РезультатВыбора = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОбработатьВыборЭлементаНаСервере(РезультатВыбора, ДополнительныеПараметры);
	
КонецПроцедуры    

&НаСервере
Процедура ОбработатьВыборЭлементаНаСервере(ВыбранноеЗначение, ДополнительныеПараметры)
	
	Для Каждого ИдентификаторСтроки из ДополнительныеПараметры.ВыделенныеСтроки Цикл
		СтрокаТекущая = ТаблицаСоответствий.НайтиПоИдентификатору(ИдентификаторСтроки);
		СтрокаТекущая[ДополнительныеПараметры.ОписаниеКолонки["Имя"]]  = ВыбранноеЗначение;
	КонецЦикла; 
	
	УстановитьФлагПодобрано();
	
КонецПроцедуры

