//Копирование грузоперевозок&НаКлиенте 
&НаКлиенте
Процедура СкопироватьГрузоперевозки(Команда)  
	
	ВыделенныеСтроки = Элементы.Журнал.ВыделенныеСтроки;
	Если ВыделенныеСтроки.Количество() = 0 Тогда
		ПоказатьПредупреждение(,"Необходимо выбрать грузоперевозку для копирования!");
		Возврат;
	КонецЕсли;                                            
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ВыделенныеСтроки", ВыделенныеСтроки);   
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ПродолжитьКопированиеГрузоперевозок", ЭтотОбъект, ДополнительныеПараметры); 
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("КопированиеИзЗаказа", 	Ложь);	
	СтруктураПараметров.Вставить("ИзменятьТипПеревозки", 	Истина);	
	СтруктураПараметров.Вставить("УИД", 				УникальныйИдентификатор);		
	
	ОткрытьФорму("ОбщаяФорма.CW_КопированиеГрузоперевозок",СтруктураПараметров ,ЭтаФорма,,,,ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ПродолжитьКопированиеГрузоперевозок(АдресПараметров, ДополнительныеПараметры) Экспорт 
	
	Если АдресПараметров = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	РезультатВыполнения =  ПродолжитьКопированиеГрузоперевозокНаСервереВФоне(АдресПараметров, ДополнительныеПараметры);
	
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ВыводитьОкноОжидания = Истина;
	ОповещениеОЗавершении = Новый ОписаниеОповещения("ОбработатьРезультатКопированияГрузоперевозок", ЭтотОбъект, ДополнительныеПараметры);
	
	ДлительныеОперацииКлиент.ОжидатьЗавершение(РезультатВыполнения, ОповещениеОЗавершении, ПараметрыОжидания);

КонецПроцедуры

&НаСервере
Функция ПродолжитьКопированиеГрузоперевозокНаСервереВФоне(АдресПараметров, ДополнительныеПараметры)
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(Новый УникальныйИдентификатор);
	ПараметрыВыполнения.ОжидатьЗавершение 			= 0; // запускать сразу
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = "Копирование грузоперевозок заказа";
	ПараметрыВыполнения.ЗапуститьВФоне 				= Истина;
	ПараметрыВыполнения.ЗапуститьНеВФоне 			= ложь; 
	
	МассивОбъектовКопирования = Новый Массив;
	Для Каждого ИдентификаторСтроки из ДополнительныеПараметры.ВыделенныеСтроки Цикл
		СтрокаТекущая = Журнал_Данные.НайтиПоИдентификатору(ИдентификаторСтроки);
		МассивОбъектовКопирования.Добавить(СтрокаТекущая.Ссылка);
	КонецЦикла;
	
	ПараметрыПроцедуры = ПолучитьИзВременногоХранилища(АдресПараметров); 
	Если ТипЗнч(ПараметрыПроцедуры) <> Тип("Структура") Тогда
		ВызватьИсключение "Непредвиденная ошибка копирования! Обратитесь к администратору!";
	КонецЕсли;  
	
	ПараметрыПроцедуры.Вставить("МассивОбъектовКопирования", МассивОбъектовКопирования);

	Возврат ДлительныеОперации.ВыполнитьВФоне("Справочники.CW_Заказы.ВыполнитьКопированиеГрузоперевозок",ПараметрыПроцедуры, ПараметрыВыполнения);
	
КонецФункции

&НаКлиенте
Процедура ОбработатьРезультатКопированияГрузоперевозок(РезультатВыполнения, ДополнительныеПараметры) Экспорт
	
	Если РезультатВыполнения.Статус = "Выполнено" Тогда
		
		ВыполнитьДействие(_УФКС.СД("Журналы","клиент","/Обновить")); 
		
		РезультатКопирования = ПолучитьИзВременногоХранилища(РезультатВыполнения.АдресРезультата);
		
		Если ТипЗнч(РезультатКопирования) = Тип("Массив")
			И РезультатКопирования.Количество() = 1 Тогда
			ПоказатьЗначение(, РезультатКопирования[0]);	
		КонецЕсли;  
		
		ПоказатьПредупреждение(,"Копирование грузоперевозок завершено!",,"Копирование грузоперевозок");
		
	ИначеЕсли РезультатВыполнения.Статус = "Ошибка" Тогда
		
		ТекстПредупреждения = "Не удалось скопировать грузоперевозки!
		| По причине: "+ РезультатВыполнения.КраткоеПредставлениеОшибки + "
		| Информаиция об ошибке см. в журнале регистрации!";
		
		Если ТипЗнч(РезультатВыполнения.Сообщения) = Тип("Массив") Тогда
			Для Каждого СообщениеВМассиве из РезультатВыполнения.Сообщения Цикл
				СообщениеВМассиве.Сообщить();
			КонецЦикла;
		КонецЕсли;
		
		ПоказатьПредупреждение(,ТекстПредупреждения,,"Ошибка копирования грузоперевозк");
	КонецЕсли;
	
КонецПроцедуры
