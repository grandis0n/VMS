//Изменение представления грузоперевозок
&НаКлиенте
Процедура ВводПредставленияГрузоперевозок(Команда)
	
	ВыделенныеСтроки 	= Элементы.Журнал.ВыделенныеСтроки;  
	Грузоперевозки 		= ПолучитьСсылкиВыделенныхСтрокНаСервере(ВыделенныеСтроки);	
	
	ПараметрыПроцедуры = Новый Структура;
	ПараметрыПроцедуры.Вставить("КоличествоСтрок", 		Грузоперевозки.Количество());
	ПараметрыПроцедуры.Вставить("Грузоперевозки",  		Грузоперевозки);
	ПараметрыПроцедуры.Вставить("ВыделенныеСтроки",  	ВыделенныеСтроки);
	
	CW_МониторингКлиент.ПередНачаломВводаПредставлений(ЭтаФорма, ПараметрыПроцедуры);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьРезультатЗаполненияПредставлений(РезультатВыполнения, ДополнительныеПараметры) Экспорт
	
	Если РезультатВыполнения.Статус = "Выполнено" Тогда
		
		ОбновитьПредставленияНаФормеНаСервере(РезультатВыполнения.АдресРезультата, ДополнительныеПараметры.ВыделенныеСтроки); 
	   	ОповеститьОбИзменении(Тип("СправочникСсылка.CW_Грузоперевозки"));
		
	ИначеЕсли РезультатВыполнения.Статус = "Ошибка" Тогда
		
		ТекстПредупреждения = "Не удалось обновить предсставления грузоперевозок!
		| По причине: "+ РезультатВыполнения.КраткоеПредставлениеОшибки + "
		| Информаиция об ошибке см. в журнале регистрации!";
		
		Если ТипЗнч(РезультатВыполнения.Сообщения) = Тип("Массив") Тогда
			Для Каждого СообщениеВМассиве из РезультатВыполнения.Сообщения Цикл
				СообщениеВМассиве.Сообщить();
			КонецЦикла;
		КонецЕсли;
		
		ПоказатьПредупреждение(,ТекстПредупреждения,,"Ошибка обновления представлений");
		
	КонецЕсли;
	
КонецПроцедуры

