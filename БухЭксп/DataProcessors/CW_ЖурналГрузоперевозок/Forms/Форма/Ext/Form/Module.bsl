&НаСервере
Функция _СтруктураНастройки()
	// --- 
	
	Возврат(CW_Журналы_Сервер.ПолучитьСтруктуруНастройки(ЭтаФорма));
	
	// --- 
КонецФункции
 

&НаКлиенте
Процедура ОбработкаПодтвержденияСеансовойНастройки(Ответ, ДополнительныеПараметры) Экспорт 
	// --- 
	
	Если (Ответ <> Неопределено) Тогда
		
		// смотрим на выбранное действие
		Действие = Неопределено;
		Ответ.Свойство("Действие",Действие);
		Если (Действие = "Восстановить") Тогда
			
			ВыполнитьДействие(_УФКС.СД("Журналы","сервер","/ИнициализацияНастроек"));
			ВыполнитьДействие(_УФКС.СД("Журналы","сервер","/ОбновитьДанные"));
			
		ИначеЕсли (Действие = "Выбрать") Тогда 
			
			ВыполнитьДействие(_УФКС.СД("Журналы","клиент","/ЗагрузитьНастройку"));
			
		ИначеЕсли (Действие = "Создать") Тогда 
			
			Журнал_ТекущаяНастройка = Неопределено;
			Журнал_РежимНастройки = Истина;
			ВыполнитьДействие(_УФКС.СД("Журналы","сервер","/ИнициализацияНастроек"));
			
		КонецЕсли; 
		
	Иначе
		
		// снова открываем диалог подтверждения
		Закрыть();
		
	КонецЕсли;
	
	// --- 
КонецПроцедуры

