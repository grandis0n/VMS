&НаКлиенте
Процедура СобытиеЖурналВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	Если Поле.Имя = "ЖурналФайлы" Тогда
		_УФК.ОткрытьСписокФайловОбъекта(ЭтаФорма, Элемент.ТекущиеДанные.Ссылка);
	Иначе
		ВыполнитьДействие(_УФКС.СД("Журналы","клиент","/ОткрытьЛибоРедактировать",ВыбраннаяСтрока)); 
