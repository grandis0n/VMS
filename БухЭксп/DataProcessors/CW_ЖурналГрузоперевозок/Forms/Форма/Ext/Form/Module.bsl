&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// ---------------------------------------------------------------------------- 

	ЗапрашиватьТипФайлаПриДобавленииВАрхив = Константы.CW_ЗапрашиватьТипФайлаПриДобавленииВАрхив.Получить();
	
	ГруппаПользователя = CW_ПраваДоступа_ПИ.ГруппаПользователя(ПараметрыСеанса.ТекущийПользователь);
	
	УстанавливаемыеПараметры = Новый Структура; 
	УстанавливаемыеПараметры.Вставить("CW_ГруппаПользователя", ГруппаПользователя);
	
	УстановитьПараметрыФункциональныхОпцийФормы(УстанавливаемыеПараметры);
	
	Отладка = Ложь;
	
	ВыполнитьДействиеНаСервере(_УФКС.СД("Журналы","сервер","/ИнициализацияФормы",Параметры));
	
	Параметры.Свойство("РежимВыбора",РежимВыбора);
	
	ПараметрыОпции = Новый Структура("CW_Пользователь", ПараметрыСеанса.ТекущийПользователь);
	УстановитьПараметрыФункциональныхОпцийФормы(ПараметрыОпции);
	
	ИспользованиеФинансовыхСтатусов = ПолучитьФункциональнуюОпцию("CW_ИспользоватьФинансовыеСтатусыГрузоперевозок");

	//Фоновое обновление журнала
	НастройкиПользователя = CW_Настройки.ПолучитьНастройкиПользователя();
	
	СтруктураФоновоеОбновление = Новый Структура;
	СтруктураФоновоеОбновление.Вставить("Используется", 	НастройкиПользователя.ВыполнятьФоновоеОбновлениеЖурналаГрузоперевозок);
	СтруктураФоновоеОбновление.Вставить("Интервал", 		НастройкиПользователя.ИнтервалФоновогоОбновленияЖурналаГрузоперевозок);
	СтруктураФоновоеОбновление.Вставить("Оповещать", 		НастройкиПользователя.ПоказыватьОповещениеВыполненияОбновлениеЖурналаГрузоперевозок);
	
	ПараметрыФоновогоОбновления = Новый ФиксированнаяСтруктура(СтруктураФоновоеОбновление);
	//Фоновое обновление журнала   
	
	//Внешние подклчюаемые команды
	CW_ПодключаемыеКомандыСервер.ПриСозданииНаСервере(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	
	// ---------------------------------------------------------------------------- 
	Если (РежимОткрытия <> "") Тогда
		
		ВыполнитьДействие(_УФКС.СД("Журналы","сервер","/ИнициализацияНастроек"));
		Если (НЕ Журнал_РежимНастройки) Тогда
			ВыполнитьДействие(_УФКС.СД("Журналы","сервер","/ОбновитьДанные"));	
		КонецЕсли;
		
	Иначе
		
		// механизм подтверждения настройки журнала
		ПодключитьОбработчикОжидания("ПодтверждениеНастройкиЖурнала",0.1,Истина);
		
	КонецЕсли; 
	
	//Фоновое обновление журнала
	Если ПараметрыФоновогоОбновления.Используется Тогда
		ПодключитьОбработчикОжидания("ВыполнитьФоновоеОбновлениеЖурнала", ПараметрыФоновогоОбновления.Интервал);
	КонецЕсли;
	//Фоновое обновление журнала
	
КонецПроцедуры

#Область ПередЗакрытием 

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
		
	Если Журнал_ПодтверждатьЗакрытие и Не РежимВыбора и  Не ЗакрытиеФормы и НЕ ЗавершениеРаботы Тогда
		Отказ 		= истина;
		Режим 		= РежимДиалогаВопрос.ДаНет;
		Оповещение 	= Новый ОписаниеОповещения("ОбработкаЗакрытияФормы", ЭтаФорма);	
		ПоказатьВопрос(Оповещение,"Закрыть журнал грузоперевозок?",Режим,,,"Закрытие журнала грузоперевозок");			
	КонецЕсли;   
	
	//Фоновое обновление журнала
	Если ПараметрыФоновогоОбновления.Используется Тогда
		ОтключитьОбработчикОжидания("ВыполнитьФоновоеОбновлениеЖурнала");
	КонецЕсли;
	//Фоновое обновление журнала
	
КонецПроцедуры

