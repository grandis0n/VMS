//Отчет "Ожидаемые затраты"
&НаКлиенте
Процедура ОтчетОжидаемыеЗатраты(Команда)
	
	ПараметрКоманды = ПолучитьСсылкиВыделенныхСтрокНаСервере(Элементы.Журнал.ВыделенныеСтроки);
	
	ПараметрыОтчета  = ПолучитьПараметрыОткрытияОтчета(ПараметрКоманды);
	
	ФормаОтчета = ПолучитьФорму("Отчет.CW_ОжидаемыеЗатраты.Форма",ПараметрыОтчета.СтруктураПараметров, ЭтаФорма);
	ФормаОтчета.Отчет.КомпоновщикНастроек 	= ПараметрыОтчета.КомпоновщикНастроек; 
	
	ФормаОтчета.Отчет.ПорядокРасчетаРублевогоЭквивалентаПлановыхСтатейЗатрат = 1;
	ФормаОтчета.Отчет.ФактическиПолученныеЗатратыНаДату = ТекущаяДата(); 
	ФормаОтчета.Отчет.ФактическиеДокументы 	= "АКТЫ";
	ФормаОтчета.Отчет.УчитыватьПоставщика 	= Ложь;
	ФормаОтчета.Отчет.ВерсияБюджета 		= ПредопределенноеЗначение("Справочник.CW_ВерсииБюджетов.Основная");
	    
	ФормаОтчета.СкомпоноватьРезультат();
	ФормаОтчета.Открыть();
	
КонецПроцедуры  

 &НаСервере
Функция ПолучитьПараметрыОткрытияОтчета(ПараметрКоманды)
	
	ОтчетОбъект 		= Отчеты.CW_ОжидаемыеЗатраты.Создать();
	КомпоновщикНастроек = ОтчетОбъект.КомпоновщикНастроек; 
	
	ИмяПоляКомпоновки = "Грузоперевозка";
	
	ПравоеЗначение = Новый СписокЗначений;         
	ПравоеЗначение.ЗагрузитьЗначения(ПараметрКоманды);  

	УстановитьЭлементОтбораСКД(КомпоновщикНастроек, 
		ПравоеЗначение, 
		ИмяПоляКомпоновки); 
		
	ПравоеЗначение = Новый СписокЗначений;         
	ПравоеЗначение.Добавить(ПредопределенноеЗначение("Перечисление.CW_ПорядокОтраженияЗатрат.Затраты"));  
	
	УстановитьЭлементОтбораСКД(КомпоновщикНастроек, 
		ПравоеЗначение, 
		"ПорядокОтражения"); 
	
	ПараметрыОткрытия = Новый Структура(); 	
	ПараметрыОткрытия.Вставить("СформироватьПриОткрытии", 	Ложь);
	ПараметрыОткрытия.Вставить("ПользовательскиеНастройки", КомпоновщикНастроек.ПользовательскиеНастройки);
	ПараметрыОткрытия.Вставить("КлючВарианта", 				"ОжидаемыеЗатраты");
	ПараметрыОткрытия.Вставить("ВнешнийВызов", 				Истина);
	
	Структура = Новый Структура;
	Структура.Вставить("СтруктураПараметров", ПараметрыОткрытия);
	Структура.Вставить("КомпоновщикНастроек", КомпоновщикНастроек);
	
	Возврат Структура;

КонецФункции

&НаСервере
Процедура УстановитьЭлементОтбораСКД(КомпоновщикНастроек, ПравоеЗначение, ИмяПоляКомпоновки)
	
	Для Каждого ЭлементОтбора из КомпоновщикНастроек.Настройки.Отбор.Элементы Цикл 
		Если ТипЗнч(ЭлементОтбора) = Тип("ЭлементОтбораКомпоновкиДанных") Тогда
			Если ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ИмяполяКомпоновки) Тогда
				 Прервать;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла; 
	
	Если ЭлементОтбора = Неопределено Тогда
		ЭлементОтбора =  КомпоновщикНастроек.Настройки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ЭлементОтбора.ИдентификаторПользовательскойНастройки) Тогда
		ЭлементОтбора.ИдентификаторПользовательскойНастройки = Новый УникальныйИдентификатор(); 
	КонецЕсли; 
	
	ВидСравненияСКД = ВидСравненияКомпоновкиДанных.ВСписке;
	Если ПравоеЗначение.Количество() = 1 Тогда
		ПравоеЗначение  = ПравоеЗначение.Получить(0).Значение;
		ВидСравненияСКД	= ВидСравненияКомпоновкиДанных.Равно		
	КонецЕсли;
	
	ЭлементОтбора.ВидСравнения 		= ВидСравненияСКД;
	ЭлементОтбора.ЛевоеЗначение 	= Новый ПолеКомпоновкиДанных(ИмяполяКомпоновки);
	ЭлементОтбора.ПравоеЗначение 	= ПравоеЗначение;
	ЭлементОтбора.Использование 	= Истина;      
	
	ПользовательскийОтбор = КомпоновщикНастроек.ПользовательскиеНастройки.Элементы.Найти(ЭлементОтбора.ИдентификаторПользовательскойНастройки);
	Если ТипЗнч(ПользовательскийОтбор) = Тип("ЭлементОтбораКомпоновкиДанных") Тогда
		ПользовательскийОтбор.ПравоеЗначение	= ЭлементОтбора.ПравоеЗначение;    
		ПользовательскийОтбор.РежимОтображения 	= РежимОтображенияЭлементаНастройкиКомпоновкиДанных.БыстрыйДоступ;
		ПользовательскийОтбор.Использование		= ЭлементОтбора.Использование;    
	КонецЕсли;
	
КонецПроцедуры
