
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Параметры.Свойство("Объект", ПодключаемыйОбъект);
	
	Если  ЗначениеЗаполнено(ПодключаемыйОбъект) Тогда
		Настройки = _ПО.ПолучитьНастройкиОбработки(ПодключаемыйОбъект);
		
		Если (Настройки <> Неопределено) Тогда
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьИЗакрыть(Команда)
	
	_СохранитьНастройки();
	ЭтаФорма.Закрыть();
	
КонецПроцедуры

&НаСервере
Процедура _СохранитьНастройки()
	
	СтруктураНастройки = Новый Структура;
	СтруктураНастройки.Вставить("Параметр", Параметр);
	
	_ПО.ЗаписатьНастройкиОбработки(ПодключаемыйОбъект,СтруктураНастройки); 
	
КонецПроцедуры


 