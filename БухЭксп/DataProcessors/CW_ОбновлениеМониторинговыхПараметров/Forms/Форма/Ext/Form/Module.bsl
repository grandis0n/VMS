//Обработка данных
&НаСервере
Функция ДополнитьДанныеТиповПеревозокНаСервере(Обработано)
	
	Запрос = Новый Запрос;  
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 10
	               |	CW_ТипыПеревозок.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.CW_ТипыПеревозок КАК CW_ТипыПеревозок
	               |ГДЕ
	               |	НЕ CW_ТипыПеревозок.Ссылка В
	               |				(ВЫБРАТЬ
	               |					CW_СлужебныйВыполненПереход.Объект КАК Объект
	               |				ИЗ
	               |					РегистрСведений.CW_СлужебныйВыполненПереход КАК CW_СлужебныйВыполненПереход
	               |				ГДЕ
	               |					CW_СлужебныйВыполненПереход.ТипОбъекта = &ТипОбъекта)";

	Запрос.УстановитьПараметр("ТипОбъекта", "CW_ТипыПеревозок");
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Обработано = Выборка.Количество();
	
	Пока Выборка.Следующий() Цикл
		
		ОбъектТипПеревозки = Выборка.Ссылка.ПолучитьОбъект();
		

		//Параметры грузоперевозок
		ВладельцыПараметров = Новый Соответствие;
		мПорядокПараметров 	= новый Массив;
		ОбработатьТабличнуюЧасть(ВладельцыПараметров, мПорядокПараметров, ОбъектТипПеревозки.ГруппыПараметровГрузоперевозки, ОбъектТипПеревозки.ПараметрыГрузоперевозки);
	
		//Параметры заявок
		ВладельцыПараметров = Новый Соответствие;
		мПорядокПараметров 	= новый Массив;
		ОбработатьТабличнуюЧасть(ВладельцыПараметров, мПорядокПараметров, ОбъектТипПеревозки.ГруппыПараметровЗаявки, ОбъектТипПеревозки.ПараметрыЗаявки);
		
		//Параметры Заказов
		ВладельцыПараметров = Новый Соответствие;
		мПорядокПараметров 	= новый Массив;
		ОбработатьТабличнуюЧасть(ВладельцыПараметров, мПорядокПараметров, ОбъектТипПеревозки.ГруппыПараметровЗаказа, ОбъектТипПеревозки.ПараметрыЗаказа);
		
				
		ОбъектТипПеревозки.ОбменДанными.Загрузка = Истина;
		
		Попытка
			ОбъектТипПеревозки.Записать();
			ЗаписатьОбработанныеДанные(Выборка.Ссылка, "CW_ТипыПеревозок");
		Исключение
		КонецПопытки;
		
	КонецЦикла;
	
	Возврат истина;
	
КонецФункции

