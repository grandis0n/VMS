		ОбъектЗаказ = Выборка.Ссылка.ПолучитьОбъект();
		
		ОбработатьТабличнуюЧасть(ВладельцыПараметров, мПорядокПараметров, ОбъектЗаказ.ГруппыПараметровЗаказа, ОбъектЗаказ.ПараметрыЗаказа);
		
		ОбновитьХарактеристикиОбъекта(Выборка.Ссылка, ВладельцыПараметров, мПорядокПараметров);
		
		ОбъектЗаказ.ОбменДанными.Загрузка = Истина;
		
		Попытка
			ОбъектЗаказ.Записать();
			ЗаписатьОбработанныеДанные(Выборка.Ссылка, "CW_Заказы");
		Исключение
		КонецПопытки;
		
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

&НаСервере
Функция ДополнитьДанныеЗаявокНаСервере(Обработано)
	
	Запрос = Новый Запрос;                          
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 10
	|	CW_Заявки.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.CW_Заявки КАК CW_Заявки
	|ГДЕ
	|	НЕ CW_Заявки.Ссылка В
	|				(ВЫБРАТЬ
	|					CW_СлужебныйВыполненПереход.Объект КАК Объект
	|				ИЗ
	|					РегистрСведений.CW_СлужебныйВыполненПереход КАК CW_СлужебныйВыполненПереход
	|				ГДЕ
	|					CW_СлужебныйВыполненПереход.ТипОбъекта = &ТипОбъекта)";
	
	Запрос.УстановитьПараметр("ТипОбъекта", "CW_Заявки");

	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Ложь;
	КонецЕсли;	
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Обработано = Выборка.Количество();
	
	Пока Выборка.Следующий() Цикл
		
		ВладельцыПараметров = Новый Соответствие;
		мПорядокПараметров 	= новый Массив;
		
		ОбъектЗаявка = Выборка.Ссылка.ПолучитьОбъект();
		
		ОбработатьТабличнуюЧасть(ВладельцыПараметров, мПорядокПараметров, ОбъектЗаявка.ГруппыПараметровЗаявки, ОбъектЗаявка.ПараметрыЗаявки);
		
		ОбновитьХарактеристикиОбъекта(Выборка.Ссылка, ВладельцыПараметров, мПорядокПараметров);

	
		ОбъектЗаявка.ОбменДанными.Загрузка = Истина;
		Попытка
			ОбъектЗаявка.Записать();
			ЗаписатьОбработанныеДанные(Выборка.Ссылка, "CW_Заявки");
		Исключение
		КонецПопытки;
		
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции



&НаСервере
Процедура ЗаписатьОбработанныеДанные(Объект, ТипОбъекта)
	
	Запись = РегистрыСведений.CW_СлужебныйВыполненПереход.СоздатьМенеджерЗаписи();
	Запись.Объект 		= Объект;
	Запись.ТипОбъекта 	= ТипОбъекта;
	Запись.Записать(Истина);
	
КонецПроцедуры

&НаСервере
Процедура ОбработатьТабличнуюЧасть(ВладельцыПараметров, мПорядокПараметров, ГруппыПараметров, Параметры)
	
	Для Каждого СтрокаГрупп из ГруппыПараметров Цикл
		Если СтрокаГрупп.Наименование <> "Корень" тогда
			Если Не ЗначениеЗаполнено(СтрокаГрупп.ИдентификаторГруппы) или ОбновитьСуществующиеДанные Тогда 
				СтрокаГрупп.ИдентификаторГруппы = Новый УникальныйИдентификатор;
			КонецЕсли;
		КонецЕсли;
		
		мИдентифкаторВедомых =  ЗначениеИзСтрокиВнутр(СтрокаГрупп.ИдентификаторыВедомых);
		Для каждого ПодчиненныйЭлемент Из мИдентифкаторВедомых Цикл
			
			Если ТипЗнч(ПодчиненныйЭлемент) = Тип("ПланВидовХарактеристикСсылка.CW_ПараметрыГрузоперевозок") Тогда  
				ПодчиненныйЭлементОбъект = ПодчиненныйЭлемент.ПолучитьОбъект();
				Если ПодчиненныйЭлементОбъект = Неопределено Тогда
					Продолжить;
				КонецЕсли;                                                                                            
			Конецесли;
			
			ЭтоГруппа = ТипЗнч(ПодчиненныйЭлемент) = Тип("Число");
			Если ЭтоГруппа Тогда
				ОтборПоИдентификаторуГруппы = Новый Структура("Идентификатор",ПодчиненныйЭлемент);
				мСтроки = ГруппыПараметров.НайтиСтроки(ОтборПоИдентификаторуГруппы);
			Иначе
				мПорядокПараметров.Добавить(ПодчиненныйЭлемент);
				
				ВладельцыПараметров.Вставить(ПодчиненныйЭлемент, СтрокаГрупп.ИдентификаторГруппы);
				
				ОтборПоПараметру = Новый Структура("Параметр",ПодчиненныйЭлемент);
				мСтроки = Параметры.НайтиСтроки(ОтборПоПараметру);
			КонецЕсли;
			
			Порядок = мИдентифкаторВедомых.Найти(ПодчиненныйЭлемент);
			Порядок = ?(Порядок = Неопределено,0, Порядок);
			
			Для Каждого СтрокаМассива из мСтроки Цикл
				Если СтрокаМассива.ИдентификаторВладельца <> СтрокаГрупп.ИдентификаторГруппы Тогда
					СтрокаМассива.ИдентификаторВладельца = СтрокаГрупп.ИдентификаторГруппы;
				КонецЕсли;
				Если ЭтоГруппа Тогда
					СтрокаМассива.Порядок = Порядок;
				КонецЕсли;
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ОбновитьХарактеристикиОбъекта(СсылкаНаОбъект, ВладельцыПараметров, мПорядокПараметров)
	
	ЗапросГрузоперевозка = Новый Запрос;
	ЗапросГрузоперевозка.Текст = "ВЫБРАТЬ
	|	CW_ХарактеристикиГрузоперевозок.Грузоперевозка КАК Грузоперевозка,
	|	CW_ХарактеристикиГрузоперевозок.Параметр КАК Параметр,
	|	ЕСТЬNULL(CW_ГрузоперевозкиПараметрыГрузоперевозки.ИдентификаторВладельца, НЕОПРЕДЕЛЕНО) КАК ИдентификаторВладельца,
	|	ВЫБОР
	|		КОГДА CW_ГрузоперевозкиПараметрыГрузоперевозки.Параметр ЕСТЬ NULL
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК Служебный
	|ИЗ
	|	РегистрСведений.CW_ХарактеристикиГрузоперевозок КАК CW_ХарактеристикиГрузоперевозок
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.CW_Грузоперевозки.ПараметрыГрузоперевозки КАК CW_ГрузоперевозкиПараметрыГрузоперевозки
	|		ПО CW_ХарактеристикиГрузоперевозок.Грузоперевозка = CW_ГрузоперевозкиПараметрыГрузоперевозки.Ссылка
	|			И CW_ХарактеристикиГрузоперевозок.Параметр = CW_ГрузоперевозкиПараметрыГрузоперевозки.Параметр
	|ГДЕ
	|	CW_ХарактеристикиГрузоперевозок.Грузоперевозка = &Грузоперевозка";
	
	ЗапросГрузоперевозка.УстановитьПараметр("Грузоперевозка", СсылкаНаОбъект);
	
	РезультатЗапросаГрузоперевозка = ЗапросГрузоперевозка.Выполнить();
	ВыборкаГрузоперевозка = РезультатЗапросаГрузоперевозка.Выбрать();
	
	Пока ВыборкаГрузоперевозка.Следующий() Цикл
		ЗаписьРегистра = РегистрыСведений.CW_ХарактеристикиГрузоперевозок.СоздатьМенеджерЗаписи();
		ЗаписьРегистра.Грузоперевозка 	= ВыборкаГрузоперевозка.Грузоперевозка;
		ЗаписьРегистра.Параметр 		= ВыборкаГрузоперевозка.Параметр;
		
		ЗаписьРегистра.Прочитать();
		Если ЗаписьРегистра.Выбран() Тогда
			
			Порядок = мПорядокПараметров.Найти(ВыборкаГрузоперевозка.Параметр);
			Порядок = ?(Порядок = Неопределено,0, Порядок);
			
			ЗаписьРегистра.Служебный	 			= ВыборкаГрузоперевозка.Служебный;
			ЗаписьРегистра.ИдентификаторВладельца 	= ВладельцыПараметров.Получить(ВыборкаГрузоперевозка.Параметр);
			ЗаписьРегистра.Порядок 					= Порядок;
			
			ЗаписьРегистра.Записать();
			
		КонецЕсли;
		
	КонецЦикла;

КонецПроцедуры

