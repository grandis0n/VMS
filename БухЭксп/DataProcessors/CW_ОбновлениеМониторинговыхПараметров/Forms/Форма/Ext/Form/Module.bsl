
&НаКлиенте
Процедура ОбработатьВсе(Команда)
	
	Если ОбновитьСуществующиеДанные Тогда
		УдалитьДанныеРегистраСлужебныйВыполненПереход();	
	КонецЕсли;
	
	ПодключитьОбработчикОжидания("ВыполнитьОбработкуСправочников",0.1,Истина);	

КонецПроцедуры

&НаСервере
Процедура УдалитьДанныеРегистраСлужебныйВыполненПереход()
	
	Набор = РегистрыСведений.CW_СлужебныйВыполненПереход.СоздатьНаборЗаписей();
	Набор.Записать();
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьОбработкуСправочников()
	
	Если НЕ Выполняется Тогда	
		ВыполнитьОбработчики();
	КонецЕсли;
	
	Если Выполняется Тогда
		ПодключитьОбработчикОжидания("ВыполнитьОбработкуСправочников",0.1,Истина);	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьОбработчики()
	
	Если ФлагТипыПеревозозок И НЕ Выполняется Тогда
		ДополнитьДанныеТиповПеревозокНаКлиенте();
	КонецЕсли;
	
	Если ФлагЗаявки И НЕ Выполняется  Тогда
		ДополнитьДанныеЗаявокНаКлиенте();
	КонецЕсли;
	
	Если ФлагЗаказы И НЕ Выполняется  Тогда
		ДополнитьДанныеЗаказовНаКлиенте();
	КонецЕсли;
	
	Если ФлагГрузоперевозки И НЕ Выполняется  Тогда
		ДополнитьДанныеГрузоперевозокНаКлиенте();
	КонецЕсли;
	
	Если НЕ (ФлагТипыПеревозозок И ФлагЗаявки и ФлагЗаказы и ФлагГрузоперевозки) Тогда
		ОтключитьОбработчикОжидания("ВыполнитьОбработкуСправочников");
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ДополнитьДанныеТиповПеревозокНаКлиенте()
	
	ИндикаторТипыПеревозок = 0;
	Выполняется = Истина;
	
	ВсегоТиповПеревозок = ПолучитьКоличествоТиповПеревозок();
	Если ВсегоТиповПеревозок = 0 Тогда
		Выполняется = Ложь;
		ФлагТипыПеревозозок = Ложь;
		Возврат;
	КонецЕсли;
	
	Элементы.ИндикаторТипыПеревозок.МаксимальноеЗначение = ВсегоТиповПеревозок;
	
	ИмяОбработчика = "ОбработчикДополнитьДанныеТиповПеревозок";
	ПодключитьОбработчикОжидания(ИмяОбработчика, 0.1, Истина);

КонецПроцедуры

&НаКлиенте
Процедура ОбработчикДополнитьДанныеТиповПеревозок()
	
	ОбработкаПрерыванияПользователя();
	
	Обработано = 0;
	ЕстьДанные = ДополнитьДанныеТиповПеревозокНаСервере(Обработано);
	ИндикаторТипыПеревозок = ИндикаторТипыПеревозок+Обработано; 
	
	Если ЕстьДанные Тогда 
		Выполняется = Истина;
		ПодключитьОбработчикОжидания(ИмяОбработчика, 0.1, Истина);
	Иначе
		ИндикаторТипыПеревозок = ВсегоТиповПеревозок;
		Выполняется = Ложь;
		ФлагТипыПеревозозок = Ложь;
	КонецЕсли;
	
КонецПроцедуры

