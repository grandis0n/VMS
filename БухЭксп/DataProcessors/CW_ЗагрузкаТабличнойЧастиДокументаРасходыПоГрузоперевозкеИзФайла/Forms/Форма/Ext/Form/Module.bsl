&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Параметры.Свойство("АдресТаблицыДокумента", АдресТаблицыДокумента);   
	Параметры.Свойство("ВнешниеДанные",			ВнешниеДанные);  
	Параметры.Свойство("Контрагент",			Контрагент);     
	
	
	Соответствие = Обработки.CW_ЗагрузкаТабличнойЧастиДокументаРасходыПоГрузоперевозкеИзФайла.ПолучитьСоответствиеТиповРеквизитовДокумента();      
    СоответствиТипаРеквизита = Новый ФиксированноеСоответствие(Соответствие);
	
	ДанныеДокумента = Новый ФиксированнаяСтруктура(Параметры.ДанныеДокумента);	
	
	Организация = ДанныеДокумента.Организация;

	ПараметрыУчетнойПолитики = CW_Настройки.ПараметрыУчетнойПолитики(ДанныеДокумента.Дата, ДанныеДокумента.Организация);
	Если ПараметрыУчетнойПолитики.Свойство("ОсновнаяСтатьяЗатрат") Тогда
		ОсновнаяСтатьяЗатрат = ПараметрыУчетнойПолитики.ОсновнаяСтатьяЗатрат;
	КонецЕсли;
	
	ТекстНезаполненногоЗаголовкаПарамтера   = "Выбрать параметр";
	ТекстНезаполненногоЗаголовкаДействия 	= "Выбрать действие";
	
	ТОбъект = РеквизитФормыВЗначение("Объект");
	МакетЗаголовка = ТОбъект.ПолучитьМакет("МакетЗаголовка");   
	ОбластьЗаголовок = МакетЗаголовка.ПолучитьОбласть("Заголовок");
	ОбластьЗаголовок.Параметры.ИмяРеквизита 	= ТекстНезаполненногоЗаголовкаПарамтера;
	ОбластьЗаголовок.Параметры.Действие 		= ТекстНезаполненногоЗаголовкаДействия;
	
	ТабличныйДокумент.Вывести(ОбластьЗаголовок); 

	РежимПоказать = "Все";  
	
	РаздельныйУчетВходящегоНДС 			= ПолучитьРаздельныйУчетНДС();  
	ГруппировкаЗатратПоПодразделениям 	= ПолучитьГруппировкуЗатратПоПодразделениям();

	ПоказатьСпособУчетаНДС 		= РаздельныйУчетВходящегоНДС И CW_ПраваДоступа.ПравоДоступно("РедактированиеСпособаУчетаНДС");
	
	Элементы.ФормаЗагрузитьФайл.Видимость 	= (ТипЗнч(ВнешниеДанные) <> Тип("ТабличныйДокумент"));  
	Если ТипЗнч(ВнешниеДанные) <> Тип("ТабличныйДокумент") Тогда
		Элементы.СтраницыШаг1.ТекущаяСтраница = Элементы.СтраницаНачало;	
	КонецЕсли;

	//Значения по умолчанию
	Элементы.СпособУчетаНДС.Видимость =  ПоказатьСпособУчетаНДС;
	Элементы.Подразделение.Видимость  =  ГруппировкаЗатратПоПодразделениям;   
	
	ПорядокОтражения	= ПредопределенноеЗначение("Перечисление.CW_ПорядокОтраженияЗатрат.Затраты");
	ЗаполнятьСтавкуНДСИзНоменклатуры = истина;
	СпособУчетаНДС		= ПредопределенноеЗначение("Перечисление.СпособыУчетаНДС.ПринимаетсяКВычету");
	Количество  		= 1;
	//Значения по умолчанию
	
КонецПроцедуры

&НаСервере
Функция ПолучитьРаздельныйУчетНДС()
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	НастройкиУчетаНДССрезПоследних.Организация КАК Организация,
	|	НастройкиУчетаНДССрезПоследних.РаздельныйУчетНДСНаСчете19 КАК РаздельныйУчетНДСНаСчете19
	|ИЗ
	|	РегистрСведений.НастройкиУчетаНДС.СрезПоследних(&ДатаСреза, Организация = &Организация) КАК НастройкиУчетаНДССрезПоследних";  
	
	Запрос.УстановитьПараметр("ДатаСреза", 		ДанныеДокумента.Дата);
	Запрос.УстановитьПараметр("Организация", 	ДанныеДокумента.Организация); 
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать(); 
	Если Выборка.Следующий() Тогда
		Возврат Выборка.РаздельныйУчетНДСНаСчете19;
	КонецЕсли;  
	
	Возврат Ложь;

КонецФункции    

&НаСервере
Функция ПолучитьГруппировкуЗатратПоПодразделениям()
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	CW_УчетнаяПолитикаСрезПоследних.Организация КАК Организация,
	               |	CW_УчетнаяПолитикаСрезПоследних.ГруппировкаЗатратПоПодразделениям КАК ГруппировкаЗатратПоПодразделениям
	               |ИЗ
	               |	РегистрСведений.CW_УчетнаяПолитика.СрезПоследних(&ДатаСреза, Организация = &Организация) КАК CW_УчетнаяПолитикаСрезПоследних";  
	
	Запрос.УстановитьПараметр("ДатаСреза", 		ДанныеДокумента.Дата);
	Запрос.УстановитьПараметр("Организация", 	ДанныеДокумента.Организация); 
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать(); 
	Если Выборка.Следующий() Тогда
		Возврат Выборка.ГруппировкаЗатратПоПодразделениям;
	КонецЕсли;  
	
	Возврат Ложь;

КонецФункции 


&НаКлиенте
Процедура ПриОткрытии(Отказ)    
	
	Если ТипЗнч(ВнешниеДанные) = Тип("ТабличныйДокумент") Тогда 
		Элементы.СтраницыШаг1.ТекущаяСтраница = Элементы.СтраницаОжидание;
		НачатьЧтениеФайлаВФоне(ВнешниеДанные);  
	Иначе
		ОбработатьШагНаКлиенте("Шаг1");
	КонецЕсли;

КонецПроцедуры

