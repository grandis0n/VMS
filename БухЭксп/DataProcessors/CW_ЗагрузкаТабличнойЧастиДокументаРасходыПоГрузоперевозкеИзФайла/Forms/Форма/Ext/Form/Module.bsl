	Структура = Новый Структура;
	Структура.Вставить("ИмяКолонки", 				"");
	Структура.Вставить("Заголовок", 				"");  
	Структура.Вставить("ТипЗначения", 				Новый ОписаниеТипов("Строка"));  
	Структура.Вставить("Действие", 					"");  
	Структура.Вставить("ТолькоПросмотр", 			Истина); 
	Структура.Вставить("ПутьКДаннымПодвала", 		"");  
	Структура.Вставить("УказанПутьКДаннымПодвала", 	Ложь);  
	
	Структура.Вставить("ИмяГруппы", 				"");  
	Структура.Вставить("ЗаголовокГруппы",			"");  
	Структура.Вставить("ОтображатьВШапкеГруппу",	Ложь);  
	
	Структура.Вставить("КонтрольЗаполнения",Ложь); 
	
	Структура.Вставить("ОтборПоЗначению",	Ложь);  
	Структура.Вставить("ИмяПоля", 			"");
	Структура.Вставить("ИмяПоляКомпоновки",	"");  

	Структура.Вставить("Параметр",			Неопределено);  
	Структура.Вставить("ОтображатьВШапке",	Истина);  

	Структура.Вставить("ЕстьСсылочныйТип",	Ложь);  
	
    Возврат Структура;
	
КонецФункции

&НаСервере
Процедура УстановитьФлагПодобрано()
	
	мСтроки = ОписаниеКолонок.НайтиСтроки(Новый Структура("КонтрольЗаполнения", Истина));
	
	Для Каждого СтрокаТаблицы из ТаблицаСоответствий Цикл 
		ЗначенияПодобраны = Ложь;
		Для Каждого СтрокаОисания из мСтроки Цикл  
			ЗначенияПодобраны = ЗначениеЗаполнено(СтрокаТаблицы[СтрокаОисания.ИмяКолонки]);
			Если не ЗначенияПодобраны Тогда
				Прервать;
			КонецЕсли;
		КонецЦикла; 
		СтрокаТаблицы.ФлагПодобрано = ЗначенияПодобраны;
	КонецЦикла;
	
	УстановитьДоступностьКомандыВДокумент();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьДоступностьКомандыВДокумент()
	
	мНеПодобрано = ТаблицаСоответствий.НайтиСтроки(Новый Структура("ФлагПодобрано",Ложь));
	Элементы.КомандаДалееШаг3.Доступность = мНеПодобрано.Количество() = 0 или ПропускатьНеподобранныеСтроки;

КонецПроцедуры

&НаКлиенте
Процедура ТаблицаСоответствийПриИзменении(Элемент)
	
	УстановитьФлагПодобрано(); 
	УстановитьИтогиПоКолонкам();
	
КонецПроцедуры

&НаСервере
Функция ПолучитьГрузоперевозкуПоОтбору(ОтборКомпоновкиДанных)
	
	ТОбъект = РеквизитФормыВЗначение("Объект");
	СхемаКомпоновкиДанных = ТОбъект.ПолучитьМакет("МакетОтбораГрузоперевозок");
	
	Настройки = СхемаКомпоновкиДанных.НастройкиПоУмолчанию;
	_УФС.СкопироватьОтбор(ОтборКомпоновкиДанных, Настройки.Отбор);
	
	ДанныеРасшифровки = Новый ДанныеРасшифровкиКомпоновкиДанных;
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, Настройки, ДанныеРасшифровки,,Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	
	ПроцессорКомпоновкиДанных = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновки, , ДанныеРасшифровки);
	
	Результат = Новый ТаблицаЗначений;
	
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	ПроцессорВывода.УстановитьОбъект(Результат);
	
	ПроцессорВывода.Вывести(ПроцессорКомпоновкиДанных);
	
	Если Результат.Количество() = 0 или Результат.Количество() > 1 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	СтрокаТаблицы = Результат[0];
	Возврат СтрокаТаблицы.Ссылка;
	
КонецФункции
//Таблица соответстий  

&НаСервере
Процедура ПолучитьАдресТаблицыДокумента()  

	ВремТаблицаСоответствий = ТаблицаСоответствий.Выгрузить();
	КолонкаНоменклатура 	= ВремТаблицаСоответствий.Колонки.Найти("Номенклатура");
	
	МассивНоменклатуры = Новый Массив;
	Если КолонкаНоменклатура <> Неопределено Тогда
		МассивНоменклатуры = ТаблицаСоответствий.Выгрузить().ВыгрузитьКолонку("Номенклатура"); 
	КонецЕсли;
	СоответствияСтатейЗатрат = ПолучитьСоответствияСтатейЗатрат(МассивНоменклатуры);

	ТаблицаДокумента = ПолучитьТаблицуДокумента();  
	
	МассивРеквизитов = Новый Массив;
	МассивРеквизитов.Добавить("Номенклатура");  
	МассивРеквизитов.Добавить("ПорядокОтражения"); 
	Если НЕ ЗаполнятьСтавкуНДСИзНоменклатуры Тогда
		МассивРеквизитов.Добавить("СтавкаНДС");       
	КонецЕсли;
	МассивРеквизитов.Добавить("Количество");  
	Если ПоказатьСпособУчетаНДС Тогда
		МассивРеквизитов.Добавить("СпособУчетаНДС");
	КонецЕсли;
	Если ГруппировкаЗатратПоПодразделениям Тогда
		МассивРеквизитов.Добавить("Подразделение");  
	КонецЕсли;    
	
	СтруктураОтбора = Новый Структура("ФлагПодобрано", Истина);
	мПодобранныеСтроки = ТаблицаСоответствий.НайтиСтроки(СтруктураОтбора);

	Для Каждого СтрокаТабицы из мПодобранныеСтроки Цикл
		
		НоваяСтрока = ТаблицаДокумента.Добавить();
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТабицы); 
		УстановитьЗначенияПоУмолчанию(НоваяСтрока, МассивРеквизитов);  
		
		СтатьяЗатрат = СоответствияСтатейЗатрат.Получить(НоваяСтрока.Номенклатура); 
		Если СтатьяЗатрат = Неопределено Тогда
			СтатьяЗатрат = ОсновнаяСтатьяЗатрат;
		КонецЕсли;
		
		НоваяСтрока.СтатьяЗатрат  = СтатьяЗатрат;
		
		Если ЗаполнятьСтавкуНДСИзНоменклатуры Тогда
			СтавкаНДСНоменклаутры =  CW_БухгалтерияЭкспедитораСерверПереопределяемый.СтавкаНДС(НоваяСтрока.Номенклатура, ТекущаяДата());
			НоваяСтрока.СтавкаНДС = СтавкаНДСНоменклаутры;	
		КонецЕсли;
		
		Если ВариантПересчетаСуммы = 1 Тогда 
			ПереситатьДанныеСтрокиПоПервомуВарианту(НоваяСтрока); 
		ИначеЕсли  ВариантПересчетаСуммы = 2 Тогда 
			ПереситатьДанныеСтрокиПоВторомуВарианту(НоваяСтрока); 
		КонецЕсли; 
		
		Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(СтрокаТабицы, "ЗначениеНоменклатура") Тогда
			РегистрыСведений.CW_СоответствияНоменклатурыПоставщиков.ЗаписатьСоответствиеНоменклатуры(Контрагент, СтрокаТабицы["ЗначениеНоменклатура"], СтрокаТабицы["Номенклатура"]);
		КонецЕсли;   
	КонецЦикла;
	
	ПоместитьВоВременноеХранилище(ТаблицаДокумента, АдресТаблицыДокумента);
	
КонецПроцедуры 

&НаСервере
Функция ПолучитьСоответствияСтатейЗатрат(МассивНоменклатуры)
	
	Соответствие = новый Соответствие;   
	
	Если МассивНоменклатуры.Количество() = 0 Тогда
		Возврат Соответствие;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	запрос.Текст = "ВЫБРАТЬ
	               |	CW_СтатьиЗатратНоменклатуры.СтатьяЗатрат КАК СтатьяЗатрат,
	               |	CW_СтатьиЗатратНоменклатуры.Номенклатура КАК Номенклатура
	               |ИЗ
	               |	РегистрСведений.CW_СтатьиЗатратНоменклатуры КАК CW_СтатьиЗатратНоменклатуры
	               |ГДЕ
	               |	CW_СтатьиЗатратНоменклатуры.Номенклатура В(&МассивНоменклатуры)";
	
	Запрос.УстановитьПараметр("МассивНоменклатуры", МассивНоменклатуры);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		Соответствие.Вставить(Выборка.Номенклатура, Выборка.СтатьяЗатрат);	
	КонецЦикла;  
	
    Возврат Соответствие;
	
КонецФункции


&НаСервере
Процедура ПереситатьДанныеСтрокиПоПервомуВарианту(НоваяСтрока)
	
	Ставка = CW_Финансы.ПолучитьСтавкуНДС(НоваяСтрока.СтавкаНДС)/100; 
	
	НоваяСтрока.НДС 	= НоваяСтрока.Всего*Ставка/(1+Ставка);
	НоваяСтрока.Сумма 	= НоваяСтрока.Всего - НоваяСтрока.НДС;
	НоваяСтрока.Цена 	= ?(НоваяСтрока.Количество = 0, 0, НоваяСтрока.Сумма / НоваяСтрока.Количество);  
	
КонецПроцедуры 

&НаСервере
Процедура ПереситатьДанныеСтрокиПоВторомуВарианту(НоваяСтрока)
	
	ЗначениеСтавкиНДС  = CW_Финансы.ПолучитьСтавкуНДС(НоваяСтрока.СтавкаНДС);
	
	Если ДанныеДокумента.ЦенаСНДС Тогда
		РасчетнаяСтавкаНДС 	= (ЗначениеСтавкиНДС +?(ДанныеДокумента.ЦенаСНДС,100,0))/100;
		ЦенаБезНДС 			= НоваяСтрока.Цена / РасчетнаяСтавкаНДС;
	Иначе
		ЦенаБезНДС 			= НоваяСтрока.Цена;
	КонецЕсли;
	
	НоваяСтрока.Сумма 	= ЦенаБезНДС * НоваяСтрока.Количество;
	НоваяСтрока.НДС		= Окр(НоваяСтрока.Сумма	* ЗначениеСтавкиНДС/100,2,1);
	НоваяСтрока.Всего 	= НоваяСтрока.Сумма + НоваяСтрока.НДС;
	
КонецПроцедуры 

&НаСервере
Процедура УстановитьЗначенияПоУмолчанию(НоваяСтрока, Знач МассивРеквизитов)
	
	Для Каждого ИмяРеквизита из МассивРеквизитов Цикл
		Если Не ЗначениеЗаполнено(НоваяСтрока[ИмяРеквизита]) Тогда
			НоваяСтрока[ИмяРеквизита] = ЭтаФорма[ИмяРеквизита];
		КонецЕсли;                                       
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьТаблицуДокумента()
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 0
	|	CW_РасходыПоГрузоперевозкеУслуги.Грузоперевозка КАК Грузоперевозка,
	|	CW_РасходыПоГрузоперевозкеУслуги.Номенклатура КАК Номенклатура,
 	|	CW_РасходыПоГрузоперевозкеУслуги.СтатьяЗатрат КАК СтатьяЗатрат,
 	|	CW_РасходыПоГрузоперевозкеУслуги.Представление КАК Представление,
	|	CW_РасходыПоГрузоперевозкеУслуги.ПорядокОтражения КАК ПорядокОтражения,
	|	CW_РасходыПоГрузоперевозкеУслуги.СпособУчетаНДС КАК СпособУчетаНДС,
	|	CW_РасходыПоГрузоперевозкеУслуги.ПрочиеРасходы КАК ПрочиеРасходы,
	|	CW_РасходыПоГрузоперевозкеУслуги.Подразделение КАК Подразделение,
	|	CW_РасходыПоГрузоперевозкеУслуги.Количество КАК Количество,
	|	CW_РасходыПоГрузоперевозкеУслуги.Цена КАК Цена,
	|	CW_РасходыПоГрузоперевозкеУслуги.Сумма КАК Сумма,
	|	CW_РасходыПоГрузоперевозкеУслуги.СтавкаНДС КАК СтавкаНДС,
	|	CW_РасходыПоГрузоперевозкеУслуги.НДС КАК НДС,
	|	CW_РасходыПоГрузоперевозкеУслуги.Всего КАК Всего
	|ИЗ
	|	Документ.CW_РасходыПоГрузоперевозке.Услуги КАК CW_РасходыПоГрузоперевозкеУслуги"; 
	
	РезультатЗапроса = Запрос.Выполнить(); 
	
	Возврат РезультатЗапроса.Выгрузить();
	
КонецФункции


&НаКлиенте
Процедура ЗаполнитьЗначенияКолонки(Команда) 

	ВыделенныеСтроки 	= Элементы.ТаблицаСоответствий.ВыделенныеСтроки;
	ОписаниеКолонки 	= ПолучитьДанныеКолонки();   
	Если ОписаниеКолонки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ОписаниеКолонки", 	ОписаниеКолонки);
	ДополнительныеПараметры.Вставить("ВыделенныеСтроки", 	ВыделенныеСтроки);
	
	ОписаниеОпвещения = Новый ОписаниеОповещения("ЗавершитьВыборЭлемента", ЭтотОбъект, ДополнительныеПараметры);  
	
    СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("РежимВыбора", 		Истина);
	СтруктураПараметров.Вставить("ЗакрыватьПриВыборе", 	Истина);
	СтруктураПараметров.Вставить("МножественныйВыбор", 	Ложь);
	
	ОткрытьФорму(ОписаниеКолонки.ИмяСправочника+".ФормаВыбора", СтруктураПараметров, ЭтаФорма,,,,ОписаниеОпвещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры    

&НаКлиенте
Процедура ЗавершитьВыборЭлемента(РезультатВыбора, ДополнительныеПараметры) Экспорт
	
	Если РезультатВыбора = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОбработатьВыборЭлементаНаСервере(РезультатВыбора, ДополнительныеПараметры);
	
КонецПроцедуры    

&НаСервере
Процедура ОбработатьВыборЭлементаНаСервере(ВыбранноеЗначение, ДополнительныеПараметры)
	
	Для Каждого ИдентификаторСтроки из ДополнительныеПараметры.ВыделенныеСтроки Цикл
		СтрокаТекущая = ТаблицаСоответствий.НайтиПоИдентификатору(ИдентификаторСтроки);
		СтрокаТекущая[ДополнительныеПараметры.ОписаниеКолонки.Имя]  = ВыбранноеЗначение;
	КонецЦикла; 
	
	УстановитьФлагПодобрано();
	
КонецПроцедуры

&НаСервере
Функция ПолучитьДанныеКолонки() 
	
	ПутьКданным 	= Элементы.ТаблицаСоответствий.ТекущийЭлемент.ПутьКДанным;
	мДанныеПоля 	= СтрРазделить(ПутьКданным, ".");   
	ИмяПоля 		= мДанныеПоля[1];
	НайденныеСтроки = ОписаниеКолонок.НайтиСтроки(Новый Структура("ИмяКолонки", ИмяПоля));
	Если НайденныеСтроки.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	НайденнаяСтрока = НайденныеСтроки[0];
	Если НайденнаяСтрока.ТолькоПросмотр Тогда
		Возврат Неопределено;
	КонецЕсли;    
	
	ТипЗначенияКолонки = НайденнаяСтрока.ТипЗначения.Типы()[0];   

	ОписаниеТипаВсеСсылки = ОбщегоНазначения.ОписаниеТипаВсеСсылки();
	Если Не ОписаниеТипаВсеСсылки.СодержитТип(ТипЗначенияКолонки) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ПолноеИмяСправочника = Метаданные.НайтиПоТипу(ТипЗначенияКолонки).ПолноеИмя();
	
	ОписаниеКолонки = Новый Структура;
	ОписаниеКолонки.Вставить("Имя", 			ИмяПоля);
	ОписаниеКолонки.Вставить("ТипЗначения", 	НайденнаяСтрока.ТипЗначения);
	ОписаниеКолонки.Вставить("ИмяСправочника", 	ПолноеИмяСправочника);
	
	Возврат ОписаниеКолонки
	
КонецФункции    

