	СтрокаОписания.Действие   				= ПараметрыКолонки.Действие;
	СтрокаОписания.ТолькоПросмотр 			= ПараметрыКолонки.ТолькоПросмотр;   
	СтрокаОписания.ПутьКДаннымПодвала 		= ПараметрыКолонки.ПутьКДаннымПодвала;   
	СтрокаОписания.УказанПутьКДаннымПодвала = ПараметрыКолонки.УказанПутьКДаннымПодвала;   

	СтрокаОписания.ИмяГруппы 				= ПараметрыКолонки.ИмяГруппы;   
	СтрокаОписания.ЗаголовокГруппы			= ПараметрыКолонки.ЗаголовокГруппы;   
	СтрокаОписания.ОтображатьВШапкеГруппу	= ПараметрыКолонки.ОтображатьВШапкеГруппу;   

	СтрокаОписания.КонтрольЗаполнения	= ПараметрыКолонки.КонтрольЗаполнения; 
	
