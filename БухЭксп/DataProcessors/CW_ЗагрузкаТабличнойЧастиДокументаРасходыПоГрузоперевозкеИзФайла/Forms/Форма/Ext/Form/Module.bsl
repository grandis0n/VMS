&НаСервере
Процедура УстановитьИтогиПоКолонкам()
	
	ОтборОписанияКолонок = Новый Структура;
	ОтборОписанияКолонок.Вставить("УказанПутьКДаннымПодвала", истина);   
	
	НайденныеСтроки = ОписаниеКолонок.НайтиСтроки(ОтборОписанияКолонок);
	Если НайденныеСтроки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли; 
	
	ОторВключен = РежимПоказать <> "Все";
	
	Если ОторВключен Тогда  
		Подобрано = (РежимПоказать = "Синхронизированные");
		ОтборСтрок = Новый Структура("ФлагПодобрано", Подобрано);  
		
		ВремТаблицаСоответствий = ТаблицаСоответствий.Выгрузить().Скопировать(ОтборСтрок);;
	Иначе
		ВремТаблицаСоответствий = ТаблицаСоответствий.Выгрузить();
	КонецЕсли;
	
	Для Каждого НайденнаяСтрока из НайденныеСтроки Цикл  
		ЭтаФорма[НайденнаяСтрока.ПутьКДаннымПодвала] = ВремТаблицаСоответствий.Итог(НайденнаяСтрока.ИмяКолонки);
	КонецЦикла;  
	
	КоличествоСтрок = "Строк: "+ Формат(ВремТаблицаСоответствий.Количество(), "ЧДЦ=0; ЧН=-");
	
КонецПроцедуры

