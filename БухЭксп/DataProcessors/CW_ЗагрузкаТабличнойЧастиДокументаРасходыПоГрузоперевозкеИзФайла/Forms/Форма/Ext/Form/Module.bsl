//Работа с настройрками
&НаКлиенте
Процедура СохранитьНастройку(Команда)  
	
	ОткрытьФормуСохраненияНастроек();
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуСохраненияНастроек(Оповещение = Неопределено)
	
	СохраненыНастройки = Истина;
	
	СоответствиеНастроек = ПолучитьНастроенныйЗаголовокНаСервере();
	
	ПараметрыФормыВариантов = новый Структура;
	ПараметрыФормыВариантов.Вставить("РежимФормы", 	0);
	ПараметрыФормыВариантов.Вставить("Настройки", 	СоответствиеНастроек);
	
	ОткрытьФорму("Обработка.CW_ЗагрузкаТабличнойЧастиДокументаРасходыПоГрузоперевозкеИзФайла.Форма.ФормаВариантовНастроек", ПараметрыФормыВариантов,ЭтаФорма,,,,Оповещение,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

&НаСервере
Функция ПолучитьНастроенныйЗаголовокНаСервере()
	
	СоответствиеНастроек = новый Соответствие;
	
	Для Лево = 1 по ТабличныйДокумент.ШиринаТаблицы Цикл
		
		Область 		= ТабличныйДокумент.Область(1, Лево);
		ОбластьДействия = ТабличныйДокумент.Область(2, Лево);
		
		СтруктураНастроек = Новый Структура;
		
		ДанныеЯчейки = Новый Структура;
		ДанныеЯчейки.Вставить("Текст", 					Область.Текст);
		ДанныеЯчейки.Вставить("ПараметрРасшифровки", 	Область.ПараметрРасшифровки); 
		ДанныеЯчейки.Вставить("ЦветТекста", 			Область.ЦветТекста); 
		
		СтруктураНастроек.Вставить("Заголовок", ДанныеЯчейки);
		
		ДанныеЯчейки = Новый Структура;
		ДанныеЯчейки.Вставить("Текст", 					ОбластьДействия.Текст);
		ДанныеЯчейки.Вставить("ПараметрРасшифровки", 	ОбластьДействия.ПараметрРасшифровки); 
		ДанныеЯчейки.Вставить("ЦветТекста", 			ОбластьДействия.ЦветТекста); 
		
		СтруктураНастроек.Вставить("Действия", ДанныеЯчейки);
		
		СоответствиеНастроек.Вставить(Лево, СтруктураНастроек);
	КонецЦикла;
	
	Возврат СоответствиеНастроек;
	
КонецФункции

&НаКлиенте
Процедура ЗагрузитьНастройку(Команда)       
	
	СохраненыНастройки = Истина;
	
	Оповещение = Новый ОписаниеОповещения("ЗавершитьВыборНастроек", ЭтотОбъект);

	ПараметрыФормыВариантов = новый Структура;
	ПараметрыФормыВариантов.Вставить("РежимФормы", 1);
	
	ОткрытьФорму("Обработка.CW_ЗагрузкаТабличнойЧастиДокументаРасходыПоГрузоперевозкеИзФайла.Форма.ФормаВариантовНастроек", ПараметрыФормыВариантов,ЭтаФорма,,,,Оповещение,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

&наКлиенте
Процедура ЗавершитьВыборНастроек(РезультатВыбора, ДополнительныеПараметры) Экспорт   
	
	Если РезультатВыбора = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЗавершитьВыборНастроекНаСервере(РезультатВыбора);	
	
КонецПроцедуры

&НаСервере
Процедура ЗавершитьВыборНастроекНаСервере(СоответствиеНастроек)    
	
	Если ТипЗнч(СоответствиеНастроек) <> тип("Соответствие") Тогда
		Возврат;
	КонецЕсли;
	
	Для Лево = 1 по ТабличныйДокумент.ШиринаТаблицы Цикл   
		
		СтруктураНастроек = СоответствиеНастроек.Получить(Лево);
		Если СтруктураНастроек = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ДанныеЗаголовка = СтруктураНастроек.Заголовок;
		
		Область	 = ТабличныйДокумент.Область(1, Лево);
		Область.Текст 				= ДанныеЗаголовка.Текст;
		Область.ПараметрРасшифровки = ДанныеЗаголовка.ПараметрРасшифровки;
		Область.ЦветТекста 			= ДанныеЗаголовка.ЦветТекста;
		
		ДанныеДействия   = СтруктураНастроек.Действия; 
		
		ОбластьДействия = ТабличныйДокумент.Область(2, Лево);
		ОбластьДействия.Текст 				= ДанныеДействия.Текст;
		ОбластьДействия.ПараметрРасшифровки = ДанныеДействия.ПараметрРасшифровки;
		ОбластьДействия.ЦветТекста 			= ДанныеДействия.ЦветТекста;
		
	КонецЦикла;
	
	Обработки.CW_ЗагрузкаТабличнойЧастиДокументаРасходыПоГрузоперевозкеИзФайла.РассчитатьШиринуКолонокТабличногоДокумента(ТабличныйДокумент);
	
КонецПроцедуры
//Работа с настройрками

//Чтиение файла
&НаКлиенте
Процедура ЗагрузитьФайл(Команда)
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ЗавершитьПомещениеФайлаНаНаСервер", ЭтотОбъект);
	
	ПараметрыДиалога = Новый ПараметрыДиалогаПомещенияФайлов;
	ПараметрыДиалога.Заголовок = "Выберите файл";
	ПараметрыДиалога.Фильтр    = "Файл Excel|*.xls;*.xlsx";
	
	НачатьПомещениеФайлаНаСервер(ОписаниеОповещения,, ,,ПараметрыДиалога, Новый УникальныйИдентификатор);
	
КонецПроцедуры           

&НаКлиенте
Процедура ЗавершитьПомещениеФайлаНаНаСервер(ОписаниеПомещенногоФайла,ДополнительныеПараметры) Экспорт
	
	Если ОписаниеПомещенногоФайла = Неопределено 
		Или ОписаниеПомещенногоФайла.ПомещениеФайлаОтменено Тогда
		Возврат;
	Конецесли;       

	Элементы.СтраницыШаг1.ТекущаяСтраница = Элементы.СтраницаОжидание;
	
	ДанныеДляЗагрузки = Новый Структура;
	ДанныеДляЗагрузки.Вставить("Адрес", ОписаниеПомещенногоФайла.Адрес);
	ДанныеДляЗагрузки.Вставить("РасширениеФайла", ОписаниеПомещенногоФайла.СсылкаНаФайл.Расширение);
	
	НачатьЧтениеФайлаВФоне(ДанныеДляЗагрузки);
	
КонецПроцедуры

&НаКлиенте
Процедура НачатьЧтениеФайлаВФоне(Знач ДанныеДляЗагрузки)
	
	РезультатВыполнения =  ОбработатьЗагрузкуФайлаНаСервереВФоне(ДанныеДляЗагрузки);
	
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ВыводитьОкноОжидания = Ложь;
	ОповещениеОЗавершении = Новый ОписаниеОповещения("ОбработатьРезультатЗагрузкиФайла", ЭтотОбъект);
	
	ДлительныеОперацииКлиент.ОжидатьЗавершение(РезультатВыполнения, ОповещениеОЗавершении, ПараметрыОжидания);

КонецПроцедуры

&НаСервере
Функция ОбработатьЗагрузкуФайлаНаСервереВФоне(ДанныеДляЗагрузки=Неопределено) 
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(Новый УникальныйИдентификатор);
	ПараметрыВыполнения.ОжидатьЗавершение 			= 0; // запускать сразу
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = "Чтение файла Excel в табличный документ";
	ПараметрыВыполнения.ЗапуститьВФоне 				= Истина;
	ПараметрыВыполнения.ЗапуститьНеВФоне 			= ложь;

	ПараметрыЗагрузки = Новый Структура;
	ПараметрыЗагрузки.Вставить("ИмяМакетаЗаголовка", "МакетЗаголовка");
	
	Если ТипЗнч(ДанныеДляЗагрузки) = Тип("Структура") тогда
		ДвоичныеДанные 			= ПолучитьИзВременногоХранилища(ДанныеДляЗагрузки.Адрес);
		ХранилищеДанныхФайла 	= Новый ХранилищеЗначения(ДвоичныеДанные, Новый СжатиеДанных(9)); 
		
		ПараметрыЗагрузки.Вставить("ХранилищеДанныхФайла", 	ХранилищеДанныхФайла);
		ПараметрыЗагрузки.Вставить("РасширениеФайла", 		ДанныеДляЗагрузки.РасширениеФайла);
	КонецЕсли;
	
	Если ТипЗнч(ДанныеДляЗагрузки) = Тип("ТабличныйДокумент") тогда
		ПараметрыЗагрузки.Вставить("ДанныеФайла", 	ДанныеДляЗагрузки); 
	КонецЕсли;
	
	Возврат ДлительныеОперации.ВыполнитьВФоне("Обработки.CW_ЗагрузкаТабличнойЧастиДокументаРасходыПоГрузоперевозкеИзФайла.ЗагрузитьФайлВТабличныйДокумент", ПараметрыЗагрузки, ПараметрыВыполнения);
	
КонецФункции  

&НаКлиенте
Процедура ОбработатьРезультатЗагрузкиФайла(РезультатВыполнения, Дополнительныепараметры) Экспорт
	
	Если РезультатВыполнения.Статус = "Выполнено" Тогда
		
		ТабличныйДокумент = ПолучитьИзВременногоХранилища(РезультатВыполнения.АдресРезультата); 
		
		Элементы.СтраницыШаг1.ТекущаяСтраница = Элементы.СтраницаРезультат;
		
		Элементы.ФормаКомандаДалее.КнопкаПоУмолчанию = Истина;
		
	ИначеЕсли РезультатВыполнения.Статус = "Ошибка" Тогда
		
		ТекстПредупреждения = "Не удалось прочитать файл!!
		| По причине: "+ РезультатВыполнения.КраткоеПредставлениеОшибки + "
		| Информаиция об ошибке см. в журнале регистрации!";
		
		Если ТипЗнч(РезультатВыполнения.Сообщения) = Тип("Массив") Тогда
			Для Каждого СообщениеВМассиве из РезультатВыполнения.Сообщения Цикл
				СообщениеВМассиве.Сообщить();
			КонецЦикла;
		КонецЕсли;
		
		ПоказатьПредупреждение(,ТекстПредупреждения,,"Ошибка чтения файла");
	КонецЕсли;
	
КонецПроцедуры
//Чтиение файла

//Таблица соответстий  
&НаКлиенте
Процедура РежимПоказатьПриИзменении(Элемент)
	
	УстановитьОтборСтрок();
	УстановитьИтогиПоКолонкам();
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьОтборСтрок()
	
	Включен = РежимПоказать <> "Все";
	
	ОтборСтрок = Неопределено;
	Если Включен Тогда  
		Подобрано = (РежимПоказать = "Синхронизированные");
		ОтборСтрок = новый ФиксированнаяСтруктура(Новый Структура("ФлагПодобрано", Подобрано));
	КонецЕсли;
	
	Элементы.ТаблицаСоответствий.ОтборСтрок = ОтборСтрок;
	
КонецПроцедуры


&НаСервере
Процедура ЗаполнитьТаблицуСоответствий(Успешно) 
	
	СоответствиеИменКолонок = Новый Соответствие;    
	ТаблицаЗначений 		= Новый ТаблицаЗначений; 
	ТаблицаЗначений.Колонки.Добавить("НомерСтроки", 	Новый ОписаниеТипов("Число"));
	ТаблицаЗначений.Колонки.Добавить("СтрокаМакета", 	Новый ОписаниеТипов("Число"));
	
	ОписаниеКолонок.Очистить();
	
	//Соответствие колонок
	ЗаполнитьОписаниеКолонок(СоответствиеИменКолонок, ТаблицаЗначений);
	Если ОписаниеКолонок.Количество() = 0 Тогда
		Успешно = Ложь;
		Возврат;
	КонецЕсли;
	//Соответствие колонок  
	
	мСтрокиПоискПоЗначению = ОписаниеКолонок.НайтиСтроки(Новый Структура("ОтборПоЗначению", Истина));
	Если мСтрокиПоискПоЗначению.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Отсутствуют поля поиска грузоперевозок!");
		Возврат;
	КонецЕсли;
	
	//Заполнение промежуточной таблицы
	ЗаполнитьТабицуДанных(СоответствиеИменКолонок, ТаблицаЗначений);
	//Заполнение промежуточной таблицы

	//Реквизиты формы
	ОбработатьРеквизитыФормы(ТаблицаЗначений);
	//Реквизиты формы
	
	//Удаление элементов формы
	УдалитьНенужныеЭлементыФормы();
   	//Удаление элементов формы
	
	//Добавление элементов на фомру
	ДобавитьЭлементыФормы(ТаблицаЗначений);
	//Добавление элементов на фомру

	//Поиск грузоперевозок  
	ПодобратьГрузоперевозки(ТаблицаЗначений);
	//Поиск грузоперевозок  
	
	ТаблицаСоответствий.Загрузить(ТаблицаЗначений); 
	
	УстановитьИтогиПоКолонкам();
	УстановитьФлагПодобрано();

КонецПроцедуры 

&НаСервере
Процедура ПодобратьГрузоперевозки(ТаблицаЗначений)
	
	мСтрокиПоискПоЗначению = ОписаниеКолонок.НайтиСтроки(Новый Структура("ОтборПоЗначению", Истина));
	Для Каждого СтрокаТаблицы из ТаблицаЗначений Цикл 
		
		Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(СтрокаТаблицы, "Грузоперевозка") Тогда	
			ОтборКомпоновкиДанных = Новый ОтборКомпоновкиДанных;
			Для Каждого СтрокаПоиска из мСтрокиПоискПоЗначению Цикл   
				ЗначениеКолонки = СтрокаТаблицы[СтрокаПоиска.ИмяПоля];
				Если Не ЗначениеЗаполнено(ЗначениеКолонки) Тогда 
					Продолжить;
				КонецЕсли;
				ЭлементОтбора = ОтборКомпоновкиДанных.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
				ЭлементОтбора.ЛевоеЗначение 	= Новый ПолеКомпоновкиДанных(СтрокаПоиска.ИмяПоляКомпоновки); 
				ЭлементОтбора.ВидСравнения 		= ВидСравненияКомпоновкиДанных.Равно; 
				ЭлементОтбора.ПравоеЗначение 	= ЗначениеКолонки; 
				ЭлементОтбора.Использование 	= Истина; 
			КонецЦикла; 
			
			СтрокаТаблицы.Грузоперевозка = ПолучитьГрузоперевозкуПоОтбору(ОтборКомпоновкиДанных);
		КонецЕсли;
	
		Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(СтрокаТаблицы, "Номенклатура") 
			И ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(СтрокаТаблицы, "Грузоперевозка") Тогда
			
			Если ЗначениеЗаполнено(СтрокаТаблицы.Грузоперевозка)
				и ЗначениеЗаполнено(СтрокаТаблицы.Номенклатура) Тогда
				
				НоменклатураЗамены = ПолучитьЗначениеЗаменыДляНоменклатуры(СтрокаТаблицы.Номенклатура, СтрокаТаблицы.Грузоперевозка); 
				Если ЗначениеЗаполнено(НоменклатураЗамены) Тогда
					СтрокаТаблицы.Номенклатура = НоменклатураЗамены;
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли; 
	
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ДобавитьЭлементыФормы(Знач ТаблицаЗначений)
	
	ТаблицаФормы 		= Элементы.ТаблицаСоответствий;
	ГруппаПоиск 		= ДобавитьГруппуТаблицы("ГруппаПоискПоЗначению", "Грузоперевозка", Истина, Новый Картинка, ТаблицаФормы);
	
	СоответствиеКартинок = Новый Соответствие;
 	СоответствиеКартинок.Вставить("ПоискПоЗначению", 	БиблиотекаКартинок.Найти);
	СоответствиеКартинок.Вставить("ОбновитьЗначение", 	БиблиотекаКартинок.Изменить);
	
	ТабОписаниеКолонок 	= ОписаниеКолонок.Выгрузить();
	
	Для Каждого Колонка Из ТаблицаЗначений.Колонки Цикл
		
		СтрокаОписания = ТабОписаниеКолонок.Найти(Колонка.Имя, "ИмяКолонки");  
		Если СтрокаОписания = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Если СтрокаОписания.Действие = "ПоискПоЗначению" Тогда
			ЭлементРодитель = ГруппаПоиск;	
		Иначе   
			ЭлементРодитель = ТаблицаФормы;	
		КонецЕсли; 
		
		//Добавляем группу таблицы
		ГруппаТаблицы = Элементы.Найти(СтрокаОписания.ИмяГруппы);
		Если ГруппаТаблицы = Неопределено Тогда
			ГруппаТаблицы 	= ДобавитьГруппуТаблицы(СтрокаОписания.ИмяГруппы, 
														СтрокаОписания.ЗаголовокГруппы,
														СтрокаОписания.ОтображатьВШапкеГруппу, 
														Новый Картинка, 
														ЭлементРодитель);
														
			ГруппаТаблицы.РастягиватьПоГоризонтали = ложь;
			ГруппаТаблицы.РастягиватьПоВертикали   = Ложь;   
			
			Если СтрокаОписания.ЕстьСсылочныйТип Тогда
				ГруппаТаблицы.Группировка  = ГруппировкаКолонок.Вертикальная;
			КонецЕсли;
		КонецЕсли;
		//Добавляем группу таблицы
		
		ЦветФонаЯчейки 	= ?(СтрокаОписания.ТолькоПросмотр, Новый Цвет, ЦветаСтиля.ПравоРедактированияФон);
		
		КартинкаШапки = СоответствиеКартинок.Получить(СтрокаОписания.Действие); 
		КартинкаШапки = ?(КартинкаШапки=Неопределено, Новый Картинка, КартинкаШапки);
	
		//Добавляем элемент формы
		НовыйЭлемент = Элементы.Добавить("ТаблицаСоответствий"+Колонка.Имя, Тип("ПолеФормы"), ГруппаТаблицы);       
		НовыйЭлемент.Вид 						= ВидПоляФормы.ПолеВвода;
		НовыйЭлемент.ПутьКДанным 				= "ТаблицаСоответствий." + Колонка.Имя; 
		НовыйЭлемент.АвтоОтметкаНезаполненного 	= СтрокаОписания.КонтрольЗаполнения; 
		НовыйЭлемент.ОтображатьВШапке 		   	= СтрокаОписания.ОтображатьВШапке; 
		НовыйЭлемент.ОтображатьВПодвале			= Ложь;
		НовыйЭлемент.ТолькоПросмотр 			= СтрокаОписания.ТолькоПросмотр; 
		НовыйЭлемент.ЦветФона 		   			= ЦветФонаЯчейки;
		НовыйЭлемент.КартинкаШапки  			= КартинкаШапки;        
		НовыйЭлемент.РастягиватьПоГоризонтали 	= ложь;
		НовыйЭлемент.РастягиватьПоВертикали   	= Ложь; 
		
		НовыйЭлемент.ПутьКДаннымПодвала  		= СтрокаОписания.ПутьКДаннымПодвала; 
		НовыйЭлемент.ОтображатьВПодвале			= Не ПустаяСтрока(СтрокаОписания.ПутьКДаннымПодвала);
		
		Если НовыйЭлемент.ОтображатьВПодвале Тогда
			НовыйЭлемент.ШрифтПодвала = Новый Шрифт(,,Истина);                
		КонецЕсли;

		Ширина = ПолучитьШиринуКолнки(ТаблицаЗначений, Колонка.Имя);
		
		НовыйЭлемент.Ширина = Макс(Ширина, СтрДлина(Колонка.Заголовок)+4);
	
		//Добавляем элемент формы
		
	КонецЦикла;

КонецПроцедуры  

&НаСервере
Функция ПолучитьШиринуКолнки(ТаблицаЗначений, КолонкаИмя)
	
	ШиринаПоля = 0;
	Для Каждого СтрокаТаблицы из ТаблицаЗначений Цикл
		ДлинаЗначнеия = СтрДлина(СокрЛП(СтрокаТаблицы[КолонкаИмя]));
		ШиринаПоля = Макс(ШиринаПоля, ДлинаЗначнеия);
		Если ШиринаПоля > 20 Тогда
			ШиринаПоля = 0;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Возврат ШиринаПоля;
	
КонецФункции

&НаСервере
Функция ПолучитьИтогПоПолю(КолонкаИмя)    
	
	Возврат ТаблицаСоответствий.Итог(КолонкаИмя);
	
КонецФункции

&НаСервере
Функция ДобавитьГруппуТаблицы(ИмяГруппы, ЗаголовокГруппы, ОтображатьВШапке, КартинкаШапки, РодительскийЭлемент)
	
	ГруппаПоиск = Элементы.Добавить(ИмяГруппы, Тип("ГруппаФормы"), РодительскийЭлемент);
	ГруппаПоиск.Заголовок 			= ЗаголовокГруппы;  
	ГруппаПоиск.ОтображатьВШапке 	= ОтображатьВШапке;
	ГруппаПоиск.КартинкаШапки 		= КартинкаШапки;
	
	ГруппаПоиск.Вид			 		= ВидГруппыФормы.ГруппаКолонок; 
	ГруппаПоиск.Группировка 		= ГруппировкаКолонок.Горизонтальная;

	Возврат ГруппаПоиск;
	
КонецФункции

&НаСервере
Процедура УдалитьНенужныеЭлементыФормы()
	
	мЭлементы = Новый Массив;
	Для Каждого Элемент из Элементы.ТаблицаСоответствий.ПодчиненныеЭлементы Цикл 
		Если Элемент.Имя = "ТаблицаСоответствийНомерСтроки"	Тогда
			Продолжить;
		КонецЕсли;
		мЭлементы.Добавить(Элемент);
	КонецЦикла;  
	Для Каждого Элемент из мЭлементы Цикл  
		Элементы.Удалить(Элемент);
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьОписаниеКолонок(СоответствиеИменКолонок, ТаблицаЗначений)
	
	мРеквизитыТабличнойЧасти	= Метаданные.Документы.CW_РасходыПоГрузоперевозке.ТабличныеЧасти.Услуги.Реквизиты;    
	мРеквизитыГрузоперевозки	= Метаданные.Справочники.CW_Грузоперевозки.Реквизиты;    
	
	Для Лево = 1 По ТабличныйДокумент.ШиринаТаблицы Цикл
		Область 		= ТабличныйДокумент.Область(1, Лево);  
		Если Область.ПараметрРасшифровки = "" Тогда 
			Продолжить;
		КонецЕсли; 
		
		ОбластьДействие = ТабличныйДокумент.Область(2, Лево); 
		
		РеквизитОбъекта = мРеквизитыТабличнойЧасти.Найти(Область.ПараметрРасшифровки);
		Если РеквизитОбъекта = Неопределено Тогда
			РеквизитОбъекта	= мРеквизитыГрузоперевозки.Найти(Область.ПараметрРасшифровки);
		КонецЕсли;
		
		Если РеквизитОбъекта <> Неопределено Тогда
			
			ТипЗначенияРеквизита 	= ТипЗнч(РеквизитОбъекта.Тип.ПривестиЗначение()); 
			СсылочныйТип 			= ЭтоСсылочныйТип(ТипЗначенияРеквизита);
			
			ТолькоПросмотрКолонки 	= Ложь;
			ЗаголовокКолонки 		= "Значение";
			ИмяКолонки 				= Область.ПараметрРасшифровки;	
			ТипЗначенияКолонки 		= Новый ОписаниеТипов("Строка"); 
			ПутьКДаннымПодвала		= "";
			
			Если СсылочныйТип Тогда 
				ТолькоПросмотрКолонки 	= Истина;  
				ИмяКолонки 				= "Значение"+ИмяКолонки;
			Иначе
				ТипЗначенияКолонки		= РеквизитОбъекта.Тип;  
				ЗаголовокКолонки 		= РеквизитОбъекта.Синоним; 
				
				ПустоеЗначениеПоТипу = ТипЗначенияКолонки.привестиЗначение(Неопределено);
				Если ТипЗнч(ПустоеЗначениеПоТипу) = Тип("Число") Тогда
					ПутьКДаннымПодвала = "Итог"+ИмяКолонки;	
				КонецЕсли;
			КонецЕсли; 

			СтруктураОписанияКолонки = ПолучитьСтруктуруОписанияКолонки();
			СтруктураОписанияКолонки.ИмяКолонки 				= ИмяКолонки; 
			СтруктураОписанияКолонки.Заголовок 					= ЗаголовокКолонки;
			СтруктураОписанияКолонки.Действие 					= ОбластьДействие.ПараметрРасшифровки;
			СтруктураОписанияКолонки.ТолькоПросмотр 			= Истина;
			СтруктураОписанияКолонки.ОтображатьВШапке			= Истина; 
			СтруктураОписанияКолонки.ЕстьСсылочныйТип			= СсылочныйТип; 
			СтруктураОписанияКолонки.ТипЗначения  				= ТипЗначенияКолонки;
			СтруктураОписанияКолонки.ТолькоПросмотр				= ТолькоПросмотрКолонки; 
			СтруктураОписанияКолонки.ПутьКДаннымПодвала  		= ПутьКДаннымПодвала; 
			СтруктураОписанияКолонки.УказанПутьКДаннымПодвала 	= Не ПустаяСтрока(ПутьКДаннымПодвала);
		
			СтруктураОписанияКолонки.ИмяГруппы 				= "Группа"+Область.ПараметрРасшифровки;
			СтруктураОписанияКолонки.ЗаголовокГруппы 		= РеквизитОбъекта.Синоним;
			СтруктураОписанияКолонки.ОтображатьВШапкеГруппу	= СсылочныйТип;  
			
			СтруктураОписанияКолонки.ОтборПоЗначению 		= (ОбластьДействие.ПараметрРасшифровки = "ПоискПоЗначению"); 
			
			Если ИмяКолонки = "ЗначениеГрузоперевозка" Тогда
				Если ИскатьГрузоперевозкиПоКоду Тогда  
					СтруктураОписанияКолонки.ИмяПоляКомпоновки	= "Код";
				Иначе
					СтруктураОписанияКолонки.ИмяПоляКомпоновки	= "Наименование";
				КонецЕсли;
				СтруктураОписанияКолонки.ИмяПоля			= "ЗначениеГрузоперевозка";
			КонецЕсли;   
			
			Если мРеквизитыГрузоперевозки.Найти(Область.ПараметрРасшифровки) <> Неопределено Тогда
				СтруктураОписанияКолонки.ИмяПоляКомпоновки	= Область.ПараметрРасшифровки; 
				СтруктураОписанияКолонки.ИмяПоля			= Область.ПараметрРасшифровки;
			КонецЕсли;    
			
			УстановитьОписаниеКолонки(СтруктураОписанияКолонки);  
			
			ТаблицаЗначений.Колонки.Добавить(ИмяКолонки, ТипЗначенияКолонки, РеквизитОбъекта.Синоним); 
			
			СоответствиеИменКолонок.Вставить(Лево, ИмяКолонки);
			
			Если СсылочныйТип Тогда    
				//Добавляем поле сылка
				СтруктураОписанияКолонки.ИмяКолонки			= Область.ПараметрРасшифровки;
				СтруктураОписанияКолонки.Заголовок			= "Ссылка";
				СтруктураОписанияКолонки.ТипЗначения		= РеквизитОбъекта.Тип;
				СтруктураОписанияКолонки.КонтрольЗаполнения	= Истина;
				СтруктураОписанияКолонки.ЕстьСсылочныйТип	= Ложь;
				СтруктураОписанияКолонки.ОтборПоЗначению 	= Ложь;  
				СтруктураОписанияКолонки.ТолькоПросмотр 	= Ложь;
				
				УстановитьОписаниеКолонки(СтруктураОписанияКолонки); 
				
				ТаблицаЗначений.Колонки.Добавить(Область.ПараметрРасшифровки, РеквизитОбъекта.Тип, РеквизитОбъекта.Синоним); 
			КонецЕсли;
			
		Иначе
			//Параметр грузоперевозки  
			
			//Определяем характиристик парамтера
			ИмяКолонки  = СтрЗаменить(СокрЛП(Область.ПараметрРасшифровки), "-","_");   
			ИмяГруппы 	= "Группа"+ИмяКолонки;  
			
			ПараметрГрузоперевозки 	= XMLЗначение(Тип("ПланВидовХарактеристикСсылка.CW_ПараметрыГрузоперевозок"), Область.ПараметрРасшифровки);
			ТипЗначенияПараметра	= ТипЗнч(ПараметрГрузоперевозки.ТипЗначения.ПривестиЗначение()); 
			СсылочныйТип 			= ЭтоСсылочныйТип(ТипЗначенияПараметра);
			
			ЗаголовокКолонки 		= "Значение"; 
			ТолькоПросмотрКолонки 	= Ложь;
			ТипЗначенияКолонки 		= Новый ОписаниеТипов("Строка");
			ПутьКДаннымПодвала		= "";
			
			Если СсылочныйТип Тогда          
				ТолькоПросмотрКолонки 	= Истина;
			Иначе
				ТипЗначенияКолонки  	= ПараметрГрузоперевозки.ТипЗначения;  
				ЗаголовокКолонки 		= СокрЛП(ПараметрГрузоперевозки);
				
				ПустоеЗначениеПоТипу = ТипЗначенияКолонки.привестиЗначение(Неопределено);
				Если ТипЗнч(ПустоеЗначениеПоТипу) = Тип("Число") Тогда
					ПутьКДаннымПодвала = "Итог"+ИмяКолонки;	
				КонецЕсли;
			КонецЕсли;
			
			СтруктураОписанияКолонки = ПолучитьСтруктуруОписанияКолонки();
			СтруктураОписанияКолонки.ИмяКолонки 				= "Параметр"+ИмяКолонки;
			СтруктураОписанияКолонки.Заголовок 					= ЗаголовокКолонки;
			СтруктураОписанияКолонки.ТипЗначения 				= ТипЗначенияКолонки;
			СтруктураОписанияКолонки.Действие 					= ОбластьДействие.ПараметрРасшифровки;
			СтруктураОписанияКолонки.ТолькоПросмотр 			= ТолькоПросмотрКолонки;  
			СтруктураОписанияКолонки.ОтображатьВШапке			= Истина; 
			СтруктураОписанияКолонки.ЕстьСсылочныйТип			= СсылочныйТип; 
			СтруктураОписанияКолонки.ОтборПоЗначению 			= Не СсылочныйТип; 
			СтруктураОписанияКолонки.ПутьКДаннымПодвала 		= ПутьКДаннымПодвала; 
			СтруктураОписанияКолонки.УказанПутьКДаннымПодвала 	= Не ПустаяСтрока(ПутьКДаннымПодвала);
	
			СтруктураОписанияКолонки.ИмяГруппы 				= ИмяГруппы;
			СтруктураОписанияКолонки.ЗаголовокГруппы 		= СокрЛП(ПараметрГрузоперевозки); 
			СтруктураОписанияКолонки.ОтображатьВШапкеГруппу	= СсылочныйТип; 
			
			Если СтруктураОписанияКолонки.ОтборПоЗначению Тогда
				СтруктураОписанияКолонки.ИмяПоляКомпоновки 	= "Ссылка.["+ПараметрГрузоперевозки.Идентификатор+"]";   
				СтруктураОписанияКолонки.Параметр 			= ПараметрГрузоперевозки; 
				СтруктураОписанияКолонки.ИмяПоля			= СтруктураОписанияКолонки.ИмяКолонки;
			КонецЕсли;
			
			УстановитьОписаниеКолонки(СтруктураОписанияКолонки);
			
			ТаблицаЗначений.Колонки.Добавить("Параметр"+ИмяКолонки, ТипЗначенияКолонки, СокрЛП(ПараметрГрузоперевозки));  
			
			СоответствиеИменКолонок.Вставить(Лево, "Параметр"+ИмяКолонки);
			//Колонка "Параметр" - примитивные типы
			
			//Колонка "Параметр" - ссылочного типа
			Если СсылочныйТип Тогда  

				СтруктураОписанияКолонки.ИмяКолонки 		= "Ссылка"+ИмяКолонки;
				СтруктураОписанияКолонки.Заголовок 			= "Ссылка";
				СтруктураОписанияКолонки.ТипЗначения 		= ПараметрГрузоперевозки.ТипЗначения;
				СтруктураОписанияКолонки.Действие 			= ОбластьДействие.ПараметрРасшифровки;
				СтруктураОписанияКолонки.ТолькоПросмотр 	= Ложь;  
				
				СтруктураОписанияКолонки.ИмяГруппы 			= ИмяГруппы;
				СтруктураОписанияКолонки.ЗаголовокГруппы 	= СокрЛП(ПараметрГрузоперевозки); 
				СтруктураОписанияКолонки.ЕстьСсылочныйТип	= Ложь; 
				
				СтруктураОписанияКолонки.КонтрольЗаполнения	= Ложь;
				
				СтруктураОписанияКолонки.ОтборПоЗначению	= Истина;
				СтруктураОписанияКолонки.ИмяПоляКомпоновки 	= "Ссылка.[" + ПараметрГрузоперевозки.Идентификатор + "]";   
				СтруктураОписанияКолонки.Параметр 			= ПараметрГрузоперевозки; 
				
				УстановитьОписаниеКолонки(СтруктураОписанияКолонки);
				
				ТаблицаЗначений.Колонки.Добавить("Ссылка"+ИмяКолонки, ПараметрГрузоперевозки.ТипЗначения, СокрЛП(ПараметрГрузоперевозки));  
	
			КонецЕсли; 
			//Колонка "Параметр" - ссылочного типа  
		КонецЕсли;
		
	КонецЦикла;   
	
	ПараметрыОтбора = Новый Структура("ИмяКолонки", "Грузоперевозка");
	НайденныеСтроки = ОписаниеКолонок.НайтиСтроки(ПараметрыОтбора);
	Если НайденныеСтроки.Количество() = 0 Тогда
		СтруктураОписанияКолонки = ПолучитьСтруктуруОписанияКолонки();  
		СтруктураОписанияКолонки.Действие			= "ПоискПоЗначению";
		СтруктураОписанияКолонки.Заголовок			= "Грузоперевозка";
		СтруктураОписанияКолонки.ЗаголовокГруппы	= "Грузоперевозка";
		СтруктураОписанияКолонки.ИмяГруппы			= "ГруппаГрузоперевозка";
		СтруктураОписанияКолонки.ИмяКолонки			= "Грузоперевозка";
		СтруктураОписанияКолонки.ИмяПоля			= "ЗначениеГрузоперевозка";
		СтруктураОписанияКолонки.ИмяПоляКомпоновки	= "Наименование";
		СтруктураОписанияКолонки.КонтрольЗаполнения	= Истина;
		СтруктураОписанияКолонки.ТипЗначения		= Новый ОписаниеТипов("СправочникСсылка.CW_Грузоперевозки");
		
		УстановитьОписаниеКолонки(СтруктураОписанияКолонки); 
		
		ТаблицаЗначений.Колонки.Добавить("Грузоперевозка", Новый ОписаниеТипов("СправочникСсылка.CW_Грузоперевозки"), "Грузоперевозка"); 
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ЭтоСсылочныйТип(Знач ТипЗначенияРеквизита)
	
	Если Справочники.ТипВсеСсылки().СодержитТип(ТипЗначенияРеквизита)
		ИЛИ Перечисления.ТипВсеСсылки().СодержитТип(ТипЗначенияРеквизита) Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьТабицуДанных(Знач СоответствиеИменКолонок, ТаблицаЗначений)
	                
	ТабОписаниеКолонок =  ОписаниеКолонок.Выгрузить();
	
	НомерСтроки = 0;
	Для Верх = 3 по ТабличныйДокумент.ВысотаТаблицы Цикл 
		
		НомерСтроки = НомерСтроки + 1;
		
		НоваяСтрока = ТаблицаЗначений.Добавить();
		НоваяСтрока.СтрокаМакета 	= Верх;    
		НоваяСтрока.НомерСтроки 	= НомерСтроки;    
		
		Для Лево = 1 По ТабличныйДокумент.ШиринаТаблицы Цикл 
			
			ЗначениеТекст = ТабличныйДокумент.Область(Верх, Лево).Текст;  
			
			ИмяКолнки = СоответствиеИменКолонок.Получить(Лево);
			Если ИмяКолнки = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			СтрокаОписания = ТабОписаниеКолонок.Найти(ИмяКолнки, "ИмяКолонки"); 
			
			//преобразование примитивных типов
			ПустаяСсылка = СтрокаОписания.ТипЗначения.ПривестиЗначение(Неопределено);   
			Если ТипЗнч(ПустаяСсылка) = Тип("Дата") Тогда       
				ЗначениеЯчейки = ОбщегоНазначенияКлиентСервер.СтрокаВДату(ЗначениеТекст);  
			ИначеЕсли ТипЗнч(ПустаяСсылка) = Тип("Число") Тогда  
				Попытка
					ЗначениеЯчейки = Число(ЗначениеТекст); 
				Исключение       
					ЗначениеЯчейки = 0;
				КонецПопытки;
			ИначеЕсли ТипЗнч(ПустаяСсылка) = Тип("Булево") Тогда
				Если ВРЕГ(ЗначениеТекст) = "ДА" или ВРЕГ(ЗначениеТекст) = "YES" Тогда
					ЗначениеЯчейки = Истина;
				Иначе
					ЗначениеЯчейки = ЛожЬ;
				КонецЕсли; 
			Иначе   
				ЗначениеЯчейки = ЗначениеТекст   
			КонецЕсли;  
			//преобразование примитивных типов
		
			
			НоваяСтрока[ИмяКолнки] = ЗначениеЯчейки;  
	
			//Обработаем ссылочные типы 
			Если СтрокаОписания.ЕстьСсылочныйТип и ИмяКолнки <> "ЗначениеГрузоперевозка" Тогда 
				
				Если СтрНачинаетсяС(ИмяКолнки, "Параметр") Тогда
					ИмяКолнкиЗначения = СтрЗаменить(ИмяКолнки, "Параметр", "Ссылка");
				Иначе
					ИмяКолнкиЗначения = СтрЗаменить(ИмяКолнки, "Значение", ""); 
				КонеЦЕсли; 
				
				СтрокаОписанияЗначения 	= ТабОписаниеКолонок.Найти(ИмяКолнкиЗначения, "ИмяКолонки"); 
				Если СтрокаОписанияЗначения <> Неопределено Тогда  
					НоваяСтрока[ИмяКолнкиЗначения] = ПолучитьЗначениеСинхронизации(ЗначениеТекст, СтрокаОписанияЗначения);
				КонецЕсли;
				
			КонецЕсли;  
			//Обработаем ссылочные типы 
			
		КонецЦикла;
		
	КонецЦикла; 
	
КонецПроцедуры

&НаСервере
Процедура ОбработатьРеквизитыФормы(Знач ТаблицаЗначений)   
	
	ТабОписаниеКолонок = ОписаниеКолонок.Выгрузить();  
	
	ДобавляемыеРеквизиты = Новый Массив;
	Для Каждого Колонка из ТаблицаЗначений.Колонки Цикл   
		СтрокаОписания = ТабОписаниеКолонок.Найти(Колонка.Имя, "ИмяКолонки");
		Если СтрокаОписания <> Неопределено Тогда
			
			ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(Колонка.Имя, Колонка.ТипЗначения,"ТаблицаСоответствий", СтрокаОписания.Заголовок));
			Если СтрокаОписания.УказанПутьКДаннымПодвала Тогда
				ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(СтрокаОписания.ПутьКДаннымПодвала, Колонка.ТипЗначения));
			КонецЕсли;
			
		Конецесли;
	КонецЦикла; 
	
	УдалаемыеРеквизиты 	= Новый Массив;
	КолонкиТаблицы = ЭтаФорма.ПолучитьРеквизиты("ТаблицаСоответствий");
	
	ВсеИменаРеквизитовФормы = Новый Массив;
	РеквизитыФормы = ПолучитьРеквизиты();   
	Для Каждого РеквизитФормы из РеквизитыФормы Цикл
		ВсеИменаРеквизитовФормы.Добавить(РеквизитФормы.Имя);
	КонецЦикла;
	
	Для Каждого Реквизит из КолонкиТаблицы Цикл   
		Если Реквизит.Имя = "ФлагПодобрано" 
			или Реквизит.Имя = "СтрокаМакета" 
			или Реквизит.Имя = "НомерСтроки" Тогда 
			Продолжить;
		КонецЕсли;
		
		УдалаемыеРеквизиты.Добавить("ТаблицаСоответствий."+Реквизит.Имя); 
		
		Если ВсеИменаРеквизитовФормы.Найти("Итог"+Реквизит.Имя) <> Неопределено Тогда
			УдалаемыеРеквизиты.Добавить("Итог"+Реквизит.Имя); 
		КонецЕсли;
	КонецЦикла; 
	     
	ИзменитьРеквизиты(Добавляемыереквизиты, УдалаемыеРеквизиты); 

КонецПроцедуры

&НаСервере
Процедура УстановитьОписаниеКолонки(ПараметрыКолонки)
	
	СтрокаОписания = ОписаниеКолонок.Добавить(); 
	СтрокаОписания.ИмяКолонки 				= ПараметрыКолонки.ИмяКолонки;
	СтрокаОписания.Заголовок 				= ПараметрыКолонки.Заголовок; 
