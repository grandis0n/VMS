   	СтрокаОписания.ИмяПоляКомпоновки	= ПараметрыКолонки.ИмяПоляКомпоновки;
   	СтрокаОписания.ИмяПоля				= ПараметрыКолонки.ИмяПоля;

	СтрокаОписания.Параметр				= ПараметрыКолонки.Параметр;

	СтрокаОписания.ОтображатьВШапке     = ПараметрыКолонки.ОтображатьВШапке; 
	
