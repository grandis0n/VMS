&НаКлиенте
Процедура СинхронизацияПоРегиструНоменклатураПоставщиков(Команда) 
	
	ВыделенныеСтроки = Элементы.ТаблицаСоответствий.ВыделенныеСтроки;
	СинхронизацияПоРегиструНоменклатураПоставщиковНаСервере(ВыделенныеСтроки);  
	
КонецПроцедуры

&НаСервере
Процедура СинхронизацияПоРегиструНоменклатураПоставщиковНаСервере(ВыделенныеСтроки) 
	
	Если ВыделенныеСтроки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ПерваяСтрока = ТаблицаСоответствий.НайтиПоИдентификатору(ВыделенныеСтроки[0]);
	Если Не (ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ПерваяСтрока, "Номенклатура")
		и ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ПерваяСтрока, "ЗначениеНоменклатура"))Тогда
		Возврат; //нет колонки номенклатура или НоменклатураЗначение!
	КонецЕсли;
	
	Для Каждого ИдентификаторСтроки из ВыделенныеСтроки Цикл
		СтрокаТаблицы = ТаблицаСоответствий.НайтиПоИдентификатору(ИдентификаторСтроки);
		СтрокаТаблицы.Номенклатура = ПолучитьЗначениеДляНоменклатурыПоставщика(СтрокаТаблицы.ЗначениеНоменклатура);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура СинхронизацияПоРегиструКомандаПравилаЗаменыНоменклатуры(Команда)
	ВыделенныеСтроки = Элементы.ТаблицаСоответствий.ВыделенныеСтроки;
	СинхронизацияПоРегиструКомандаПравилаЗаменыНоменклатурыНаСервере(ВыделенныеСтроки);
КонецПроцедуры

&НаСервере
Процедура СинхронизацияПоРегиструКомандаПравилаЗаменыНоменклатурыНаСервере(ВыделенныеСтроки)
	
	Если ВыделенныеСтроки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ПерваяСтрока = ТаблицаСоответствий.НайтиПоИдентификатору(ВыделенныеСтроки[0]);
	Если Не (ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ПерваяСтрока, "Номенклатура")
		и ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ПерваяСтрока, "ЗначениеНоменклатура")
		И ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ПерваяСтрока, "Грузоперевозка"))Тогда
		Возврат; //нет колонки номенклатура или НоменклатураЗначение!
	КонецЕсли; 
	
	Для Каждого ИдентификаторСтроки из ВыделенныеСтроки Цикл
		СтрокаТаблицы = ТаблицаСоответствий.НайтиПоИдентификатору(ИдентификаторСтроки);
		Если Не (ЗначениеЗаполнено(СтрокаТаблицы.Грузоперевозка) 
			и ЗначениеЗаполнено(СтрокаТаблицы.Номенклатура)) Тогда
			Продолжить;
		КонецЕсли; 
		
		ЗначениеЗамены = ПолучитьЗначениеЗаменыДляНоменклатуры(СтрокаТаблицы.Номенклатура, СтрокаТаблицы.Грузоперевозка); 
		Если ЗначениеЗаполнено(ЗначениеЗамены) Тогда
			СтрокаТаблицы.Номенклатура = ЗначениеЗамены;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьЗначениеСинхронизации(Знач ЗначениеТекст, Знач СтрокаОписанияЗначения)
	
	ПустаяСсылка = СтрокаОписанияЗначения.ТипЗначения.ПривестиЗначение();   
	
	Если Перечисления.ТипВсеСсылки().СодержитТип(ТипЗнч(ПустаяСсылка)) Тогда 
		СтрЗначениеПеречисления = СтрЗаменить(ЗначениеТекст, " ", "");
		
		МетаданныеПеречисления 	= ПустаяСсылка.Метаданные();
		ИмяОбъекта			 	= МетаданныеПеречисления.Имя; 
		
		мдЗначениеПеречисления 	= МетаданныеПеречисления.ЗначенияПеречисления.Найти(СокрЛП(СтрЗначениеПеречисления)); 
		Если мдЗначениеПеречисления <> Неопределено Тогда
			ПолученноеЗначение = ПредопределенноеЗначение("Перечисление."+ИмяОбъекта+"."+СокрЛП(СтрЗначениеПеречисления)); 
		КонецЕсли;
		
	Иначе   
		
		Если ТипЗнч(ПустаяСсылка) = Тип("СправочникСсылка.Номенклатура") Тогда
			ПолученноеЗначение = ПолучитьЗначениеДляНоменклатурыПоставщика(ЗначениеТекст); 
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ПолученноеЗначение) Тогда
			Менеджер			= ОбщегоНазначения.МенеджерОбъектаПоСсылке(ПустаяСсылка); 
			ПолученноеЗначение	= Менеджер.НайтиПоНаименованию(СокрЛП(ЗначениеТекст), Истина); 
		КонецЕсли;
		
	Конецесли;                  
	
	Возврат ПолученноеЗначение;
	
КонецФункции

&НаСервере
Функция ПолучитьЗначениеДляНоменклатурыПоставщика(Знач ЗначениеТекст)
	
	Если ПустаяСтрока(ЗначениеТекст) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат РегистрыСведений.CW_СоответствияНоменклатурыПоставщиков.ПолучитьСоответствиеНоменклатуры(Контрагент, СокрЛП(ЗначениеТекст));

КонецФункции

&НаСервере
Функция ПолучитьЗначениеЗаменыДляНоменклатуры(Знач Номенклатура, Знач Грузоперевозка) 

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	|	CW_ПравилаЗаменыНоменклатурыКонтрагентов.НоменклатураЗамены КАК НоменклатураЗамены,
	|	CW_ПравилаЗаменыНоменклатурыКонтрагентов.НоменклатураЗаменыПоУсловию КАК НоменклатураЗаменыПоУсловию,
	|	CW_ПравилаЗаменыНоменклатурыКонтрагентов.ПараметрДляПроверкиЗаменыПоУсловию КАК ПараметрДляПроверкиЗаменыПоУсловию
	|ИЗ
	|	РегистрСведений.CW_ПравилаЗаменыНоменклатурыКонтрагентов КАК CW_ПравилаЗаменыНоменклатурыКонтрагентов
	|ГДЕ
	|	CW_ПравилаЗаменыНоменклатурыКонтрагентов.Контрагент = &Контрагент
	|	И CW_ПравилаЗаменыНоменклатурыКонтрагентов.Номенклатура = &Номенклатура
	|	И CW_ПравилаЗаменыНоменклатурыКонтрагентов.ТипПеревозки = &ТипПеревозки";
	
	Запрос.УстановитьПараметр("Контрагент", 	Контрагент);
	Запрос.УстановитьПараметр("Номенклатура", 	Номенклатура);
	Запрос.УстановитьПараметр("ТипПеревозки", 	Грузоперевозка.ТипПеревозки);  
	
	РезультатЗапроса = Запрос.Выполнить(); 
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	Выборка.Следующий(); //Запись всегда одна
	
	Если Не ЗначениеЗаполнено(Выборка.ПараметрДляПроверкиЗаменыПоУсловию) Тогда
		Возврат Выборка.НоменклатураЗамены;
	КонецЕсли;
	
	//Указан параметр условия
	СтрокаПараметров = Грузоперевозка.ПараметрыГрузоперевозки.Найти(Выборка.ПараметрДляПроверкиЗаменыПоУсловию, "Параметр");
	Если СтрокаПараметров = Неопределено Тогда
		Если ЗначениеЗаполнено(Грузоперевозка.Заказ) Тогда
			СтрокаПараметров = Грузоперевозка.Заказ.ПараметрыЗаказа.Найти(Выборка.ПараметрДляПроверкиЗаменыПоУсловию, "Параметр");
		КонецЕсли;
	КонецЕсли;
	
	Если СтрокаПараметров = Неопределено Тогда
		Возврат Выборка.НоменклатураЗамены;
	КонецЕсли;
	
	Если ТипЗнч(СтрокаПараметров.Значение) = Тип("Булево")
		И СтрокаПараметров.Значение Тогда
		Возврат Выборка.НоменклатураЗаменыПоУсловию;
	КонецЕсли;   
	
	Возврат Выборка.НоменклатураЗамены;
	
КонецФункции

