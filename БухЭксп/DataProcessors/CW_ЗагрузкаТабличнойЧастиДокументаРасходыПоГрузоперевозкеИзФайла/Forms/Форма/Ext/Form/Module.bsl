//Работа с макетом 
&НаКлиенте
Процедура ТабличныйДокументВыбор(Элемент, Область, СтандартнаяОбработка)
	
	Если Область.Верх = 1 И Область.Лево <= ТабличныйДокумент.ШиринаТаблицы Тогда
		
		ДополнительныеПараметры = Новый Структура("ТекущаяОбласть", Область);  
		
		СписокВыбора = Новый СписокЗначений;
		СписокВыбора.Добавить("РеквизитДокумента", 		"Реквизит табличной части документа",, БиблиотекаКартинок.Реквизит);
		СписокВыбора.Добавить("Параметр", 				"Параметр грузоперевозки"			,, БиблиотекаКартинок.CW_ПараметрыГрузоперевозок);
		СписокВыбора.Добавить("ДополнительныеПоиск", 	"Дополнительные поля поиска"		,, БиблиотекаКартинок.CW_Лупа);
		
		Оповещение = Новый ОписаниеОповещения("ЗавершитьВыборТипаДанных", ЭтотОбъект, ДополнительныеПараметры);

		ПоказатьВыборИзМеню(Оповещение, СписокВыбора, Элемент); 
	
	КонецЕсли;  
	
	Если Область.Верх = 2 И Область.Лево <= ТабличныйДокумент.ШиринаТаблицы Тогда
		
		ОбластьДанных = ТабличныйДокумент.Область(1,Область.Лево, 1, Область.Лево);
		
		СписокВыбора = Новый СписокЗначений;
		
		ДополнительныеПараметры = Новый Структура("ТекущаяОбласть", Область);
		
		СписокРеквизитовПоиска 	= ПолучитьСписокРеквизитовПоиска();
		Если СписокРеквизитовПоиска.НайтиПоЗначению(ОбластьДанных.ПараметрРасшифровки) <> Неопределено Тогда
			СписокВыбора.Добавить("ПоискПоЗначению",	"Поиск по значению", , БиблиотекаКартинок.Найти);
		КонецЕсли;
		
		СписокРеквизитовДокумента = ПолучитьСписокДоступныхРеквизитовДокумента();
		Если СписокРеквизитовДокумента.НайтиПоЗначению(ОбластьДанных.ПараметрРасшифровки) <> Неопределено Тогда  
			
			СписокВыбора.Добавить("ПоискПоЗначению",	"Поиск по значению", , БиблиотекаКартинок.Найти);
			
			Если ОбластьДанных.ПараметрРасшифровки <> "Грузоперевозка" Тогда
				СписокВыбора.Добавить("ОбновитьЗначение",	"Записать значение", , БиблиотекаКартинок.Изменить);   
			КонецЕсли;
			
		КонецЕсли;  
		
		Если СписокВыбора.Количество() = 0 Тогда
			СписокВыбора.Добавить("ПоискПоЗначению",	"Поиск по значению", , БиблиотекаКартинок.Найти);
			СписокВыбора.Добавить("ОбновитьЗначение",	"Записать значение", , БиблиотекаКартинок.Изменить);
		КонецЕсли;
		
		Оповещение = Новый ОписаниеОповещения("ЗавершитьВыборДействия", ЭтотОбъект, ДополнительныеПараметры);
		
		ПоказатьВыборИзМеню(Оповещение, СписокВыбора, Элемент); 
		
	КонецЕсли;  
	
КонецПроцедуры

     

&НаКлиенте
Процедура ЗавершитьВыборТипаДанных(РезультатВыбора, ДополнительныеПараметры) Экспорт
	
	Если РезультатВыбора = Неопределено Тогда
		Возврат;
	КонецЕсли;   

	ДоступныеДействия = ПолучитьДоступныеДействия();
		
	ОбластьДействие 	= ТабличныйДокумент.Область(2, ДополнительныеПараметры.ТекущаяОбласть.Лево, 2, ДополнительныеПараметры.ТекущаяОбласть.Лево);
	ДопПараметры 		= Новый Структура("ТекущаяОбласть", ОбластьДействие);
	ОповещениеДействие	= Новый ОписаниеОповещения("ЗавершитьВыборДействия", ЭтотОбъект, ДопПараметры);
	ОписаниеОповещения  = Новый ОписаниеОповещения("ТабличныйДокументВыборЗавершение", ЭтотОбъект, ДополнительныеПараметры);
	
	Если РезультатВыбора.Значение = "Параметр" Тогда 
		
		Действие  = ДоступныеДействия.НайтиПоЗначению("ПоискПоЗначению");
		
		ОткрытьФорму("ПланВидовХарактеристик.CW_ПараметрыГрузоперевозок.ФормаВыбора",, ЭтотОбъект,,,, ОписаниеОповещения);
		
	ИначеЕсли РезультатВыбора.Значение = "ДополнительныеПоиск" Тогда
		
		Действие = ДоступныеДействия.НайтиПоЗначению("ПоискПоЗначению");
		
		СписокВыбора 	= ПолучитьСписокРеквизитовПоиска();
		СписокВыбора.ПоказатьВыборЭлемента(ОписаниеОповещения, "Выберите реквизит поиска");  
		
		
	ИначеЕсли РезультатВыбора.Значение = "РеквизитДокумента" Тогда
		
		ДополнительныеПараметры.Вставить("УстановитьДействие", Истина);
		
		СписокРеквизитов = ПолучитьСписокДоступныхРеквизитовДокумента(); 
     	СписокРеквизитов.ПоказатьВыборЭлемента(ОписаниеОповещения, "Выберите реквизит документа");  

	КонецЕсли;

	ВыполнитьОбработкуОповещения(ОповещениеДействие, Действие); 
	
КонецПроцедуры

&НаСервере
Функция ПолучитьСписокРеквизитовПоиска()
	
	СписокВыбора = Новый СписокЗначений;
	СписокВыбора.Добавить("Заказ", 	"Заказ",, БиблиотекаКартинок.Реквизит); 
	
	Возврат СписокВыбора;
	
КонецФункции

&НаСервере
Функция ПолучитьСписокДоступныхРеквизитовДокумента()
	
	СписокДоступныхРеквизитов = Обработки.CW_ЗагрузкаТабличнойЧастиДокументаРасходыПоГрузоперевозкеИзФайла.ПолучитьСписокДоступныхРеквизитовДокумента();
	
	Если НЕ ПоказатьСпособУчетаНДС Тогда
		СписокДоступныхРеквизитов.Удалить(СписокДоступныхРеквизитов.НайтиПоЗначению("СпособУчетаНДС"));
	КонецЕсли;
	
	Если Не ГруппировкаЗатратПоПодразделениям Тогда
		СписокДоступныхРеквизитов.Удалить(СписокДоступныхРеквизитов.НайтиПоЗначению("Подразделение"));
	КонецЕсли; 
	
	Возврат СписокДоступныхРеквизитов;
	
КонецФункции

&НаКлиенте
Процедура ЗавершитьВыборДействия(РезультатВыбора, ДополнительныеПараметры) Экспорт
   	Если РезультатВыбора = Неопределено Тогда
		Возврат;
	КонецЕсли;    
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ТабличныйДокументВыборЗавершение", ЭтотОбъект, ДополнительныеПараметры);
	
	РезультатЗакрытия = Новый Структура;
	РезультатЗакрытия.Вставить("Представление", РезультатВыбора.Представление);
	РезультатЗакрытия.Вставить("Идентификатор", РезультатВыбора.Значение);
	
	ВыполнитьОбработкуОповещения(ОписаниеОповещения, РезультатЗакрытия);
	
	ПодключитьОбработчикОжидания("РассчитатьШиринуКолонокТабличногоДокумента", 0.1, Истина);
	
КонецПроцедуры 

&НаКлиенте
Процедура РассчитатьШиринуКолонокТабличногоДокумента()
	
	РассчитатьШиринуКолонокТабличногоДокументаНаСервере();
	
КонецПроцедуры  

&НаСервере
Процедура РассчитатьШиринуКолонокТабличногоДокументаНаСервере()
	
	Обработки.CW_ЗагрузкаТабличнойЧастиДокументаРасходыПоГрузоперевозкеИзФайла.РассчитатьШиринуКолонокТабличногоДокумента(ТабличныйДокумент);
	
КонецПроцедуры


&НаКлиенте
Процедура ТабличныйДокументВыборЗавершение(РезультатВыбора, ДополнительныеПараметры) Экспорт
	
	Если РезультатВыбора = Неопределено Тогда
		Возврат;
	КонецЕсли;  

	Если  ТипЗнч(РезультатВыбора) = Тип("ПланВидовХарактеристикСсылка.CW_ПараметрыГрузоперевозок") Тогда
		РезультатЗакрытия = ПолучитьДанныеПараметра(РезультатВыбора);                                         
	КонецЕсли;   
	
	Если ТипЗнч(РезультатВыбора) = Тип("ЭлементСпискаЗначений") Тогда  
		
		Идентификатор = РезультатВыбора.Значение;
		Если СтрНачинаетсяС(РезультатВыбора.Значение, "Грузоперевозка") Тогда  
			Идентификатор = "Грузоперевозка";  
			
			ИскатьГрузоперевозкиПоКоду = СтрЗаканчиваетсяНа(РезультатВыбора.Значение, "_ПоКоду");
		КонецЕсли;
			
		РезультатЗакрытия = Новый Структура;
		РезультатЗакрытия.Вставить("Представление", РезультатВыбора.Представление);
		РезультатЗакрытия.Вставить("Идентификатор", Идентификатор);
		
		Если ДополнительныеПараметры.Свойство("УстановитьДействие") и
			ДополнительныеПараметры.УстановитьДействие Тогда 
			
			ДоступныеДействия = ПолучитьДоступныеДействия();
			
			Если СтрНачинаетсяС(РезультатВыбора.Значение, "Грузоперевозка") Тогда  
				Действие = ДоступныеДействия.НайтиПоЗначению("ПоискПоЗначению");
			Иначе
				Действие = ДоступныеДействия.НайтиПоЗначению("ОбновитьЗначение");
			КонецЕсли;
			
			ОбластьДействие 	= ТабличныйДокумент.Область(2, ДополнительныеПараметры.ТекущаяОбласть.Лево, 2, ДополнительныеПараметры.ТекущаяОбласть.Лево);
			ДопПараметры 		= Новый Структура("ТекущаяОбласть", ОбластьДействие);
			ОповещениеДействие	= Новый ОписаниеОповещения("ЗавершитьВыборДействия", ЭтотОбъект, ДопПараметры);
			
			ВыполнитьОбработкуОповещения(ОповещениеДействие, Действие); 
		КонецЕсли;
	
	КонецЕсли;  
	
	Если  ТипЗнч(РезультатВыбора) = Тип("Структура") Тогда
		РезультатЗакрытия = РезультатВыбора;
	КонецЕсли;     
	
	Если РезультатЗакрытия = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекстНезаполненногоЗаголовка = ЗагрузкаДанныхИзВнешнихФайловКлиентСервер.ТекстЗаголовкаНесопоставленнойКолонки();
	Для НомерКолонки = 1 По ТабличныйДокумент.ШиринаТаблицы Цикл
		
		Область = ТабличныйДокумент.Область(1, НомерКолонки);
		Если Область.ПараметрРасшифровки = РезультатЗакрытия.Идентификатор Тогда
			Область.Текст = ТекстНезаполненногоЗаголовка;
			Область.ПараметрРасшифровки = "";
			Область.ЦветТекста = ОбщегоНазначенияКлиентПовтИсп.ЦветСтиля("НезаполненныйРеквизит");
		КонецЕсли;
		
	КонецЦикла;  
	
	ДополнительныеПараметры.ТекущаяОбласть.Текст      			= РезультатЗакрытия.Представление;
	ДополнительныеПараметры.ТекущаяОбласть.ЦветТекста 			= ОбщегоНазначенияКлиентПовтИсп.ЦветСтиля("ЦветГиперссылки");
	ДополнительныеПараметры.ТекущаяОбласть.ПараметрРасшифровки 	= РезультатЗакрытия.Идентификатор;

КонецПроцедуры  

&НаКлиенте
Процедура УдалитьСтроку(Команда)
	
	Верх = ТабличныйДокумент.ТекущаяОбласть.Верх;
	Низ  = ТабличныйДокумент.ТекущаяОбласть.Низ;
	Лево = ТабличныйДокумент.ТекущаяОбласть.Лево;
	
	Если (Верх = 1 или Верх = 2) И (Низ = 1 или Низ = 2) Тогда
		Возврат; // выделена первая строка (строка заголовка)
	КонецЕсли;
	
	УдалитьСтрокиНаСервере(Верх, Низ);
	Элементы.ТабличныйДокумент.ТекущаяОбласть = ТабличныйДокумент.Область(Верх, Лево);
	
КонецПроцедуры  

&НаКлиенте
Процедура ДобавитьСтроку(Команда)

	Верх = ТабличныйДокумент.ТекущаяОбласть.Верх;
	Низ  = ТабличныйДокумент.ТекущаяОбласть.Низ;
	Лево = ТабличныйДокумент.ТекущаяОбласть.Лево;
	
	Если (Верх = 1 или Верх = 2) И (Низ = 1 или Низ = 2) Тогда
		Возврат; // выделена первая строка (строка заголовка)
	КонецЕсли;
	
	ДобавитьСтрокиНаСервере(Верх, Низ);
	Элементы.ТабличныйДокумент.ТекущаяОбласть = ТабличныйДокумент.Область(Верх, Лево); 
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьКолонку(Команда)
	
	Если ТабличныйДокумент.ШиринаТаблицы = 1 Тогда
		Возврат; // выделена первая строка (строка заголовка)
	КонецЕсли;

	Лево  = ТабличныйДокумент.ТекущаяОбласть.Лево;
	Право = ТабличныйДокумент.ТекущаяОбласть.Право;
	Верх  = ТабличныйДокумент.ТекущаяОбласть.Верх;
	
	УдалитьКолонкиНаСервере(Лево, Право);
	Элементы.ТабличныйДокумент.ТекущаяОбласть = ТабличныйДокумент.Область(Верх, Лево);
	
КонецПроцедуры  

&НаСервере
Процедура УдалитьСтрокиНаСервере(Верх, Низ)
	
	Если Верх = 1 Тогда
		Верх = 2; // чтобы не удалить заголовки колонок
	КонецЕсли;
	
	Область = ТабличныйДокумент.Область(Верх,, Низ);
	ТабличныйДокумент.УдалитьОбласть(Область, ТипСмещенияТабличногоДокумента.ПоВертикали);
	
КонецПроцедуры 

&НаСервере
Процедура ДобавитьСтрокиНаСервере(Верх, Низ)
	
	Область = ТабличныйДокумент.Область(Верх,, Низ);
	ТабличныйДокумент.ВставитьОбласть(Область, Область, ТипСмещенияТабличногоДокумента.ПоВертикали);  
	
	ВыделеноСтрок = (Низ - Верх) + 1;
	
	НоваяОбласть = ТабличныйДокумент.Область(Низ+1,, Низ+ВыделеноСтрок);
	НоваяОбласть.Очистить(Истина,Ложь,Ложь);
	
КонецПроцедуры 

&НаКлиенте
Процедура ДобавитьКолонку(Команда) 
	
	Лево  = ТабличныйДокумент.ТекущаяОбласть.Лево;
	Право = ТабличныйДокумент.ТекущаяОбласть.Право;
	Верх  = ТабличныйДокумент.ТекущаяОбласть.Верх;
	
	ДобавитьКолонкиНаСервере(Лево, Право);
	Элементы.ТабличныйДокумент.ТекущаяОбласть = ТабличныйДокумент.Область(Верх, Лево);
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьКолонкиНаСервере(Лево, Право)
	
	Область = ТабличныйДокумент.Область(, Лево,, Право);
	ТабличныйДокумент.ВставитьОбласть(Область, Область, ТипСмещенияТабличногоДокумента.ПоГоризонтали);
	
	ВыделеноКолонок = (Право - Лево) + 1; 
	ЛевоНовая 		= Лево+1;
	ПравоНовая		= Лево+ВыделеноКолонок;
	
	НоваяОбласть = ТабличныйДокумент.Область(3,ЛевоНовая, ТабличныйДокумент.ВысотаТаблицы, ПравоНовая);
	НоваяОбласть.Очистить(Истина,Ложь,Ложь);
	
	Для Колонка = ЛевоНовая По ПравоНовая Цикл
		Область = ТабличныйДокумент.Область(1, Колонка, 1, Колонка);    
		Область.Текст 				= "Выбрать параметр";
		Область.ПараметрРасшифровки = "";
		Область.ЦветТекста 			= ЦветаСтиля.НезаполненныйРеквизит;  
		
		Область = ТабличныйДокумент.Область(2, Колонка, 2, Колонка);    
		Область.Текст 				= "Выбрать действие";
		Область.ПараметрРасшифровки = "";
		Область.ЦветТекста 			= ЦветаСтиля.НезаполненныйРеквизит;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура УдалитьКолонкиНаСервере(Лево, Право)
	
	Область = ТабличныйДокумент.Область(, Лево,, Право);
	ТабличныйДокумент.УдалитьОбласть(Область, ТипСмещенияТабличногоДокумента.ПоГоризонтали);
	
КонецПроцедуры   

&НаКлиенте
Процедура СнятьЗащитуЯчеек(Команда)
	
	Лево  = ТабличныйДокумент.ТекущаяОбласть.Лево;
	Право = ТабличныйДокумент.ТекущаяОбласть.Право;
	Верх  = ТабличныйДокумент.ТекущаяОбласть.Верх;
	Низ  = ТабличныйДокумент.ТекущаяОбласть.Низ;
	
	СнятьЗащитуЯчеекНаСервере(Право, Лево, Верх, Низ);  
	УстановитьГраницыНаСервере(Право, Лево, Верх, Низ);
	
КонецПроцедуры


&НаСервере
Процедура УстановитьГраницыНаСервере(Право, Лево, Верх, Низ)
	
	Линия	 = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная);
	
	Для НомерСтроки = Верх По Низ Цикл
		Для НомерКолонки = Лево По Право Цикл
			Ячейка = ТабличныйДокумент.Область(НомерСтроки, НомерКолонки);
			Ячейка.Обвести(Линия, Линия, Линия, Линия);
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры   

&НаСервере
Процедура СнятьЗащитуЯчеекНаСервере(Право, Лево, Верх, Низ) 
	
	Для НомерСтроки = Верх По Низ Цикл 
		Если НомерСтроки < 3 Тогда
			Продолжить;
		КонецЕсли;
		
		Для НомерКолонки = Лево По Право Цикл
			Ячейка = ТабличныйДокумент.Область(НомерСтроки, НомерКолонки);
			Ячейка.Защита = Ложь; 
			Ячейка.ЦветФона = ЦветаСтиля.ПравоРедактированияФон
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры


&НаСервереБезКонтекста
Функция ПолучитьДанныеПараметра(Параметр)
	
	Структура = Новый Структура;
	Структура.Вставить("Представление", Параметр.Наименование);
	Структура.Вставить("Идентификатор", XMLСтрока(Параметр));
	Структура.Вставить("ТипЗначения", 	Параметр.ТипЗначения);
	
	Возврат Структура;
	
КонецФункции   

&НаСервере
Процедура ПометитьСтрокиТабличногоДокумента()
	
	Для Каждого СтрокаТаблицы из ТаблицаСоответствий Цикл 
		Если СтрокаТаблицы.ФлагПодобрано Тогда
			Продолжить;
		КонецЕсли;
		Область = ТабличныйДокумент.Область(СтрокаТаблицы.СтрокаМакета, , СтрокаТаблицы.СтрокаМакета);
		Область.ЦветТекста = ЦветаСтиля.ЦветОтрицательногоЧисла;	
	КонецЦикла;
	
КонецПроцедуры   


