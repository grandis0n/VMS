Функция ПолучитьКурсПересчетаПоТекущемуДокументу()
	
	КурсПерерасчета = 1;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	CW_ДоходыПоГрузоперевозкам.Регистратор КАК Регистратор,
	|	СУММА(CW_ДоходыПоГрузоперевозкам.Всего) КАК Всего,
	|	СУММА(CW_ДоходыПоГрузоперевозкам.Всего_Валюта) КАК ВсегоВал
	|ИЗ
	|	РегистрНакопления.CW_ДоходыПоГрузоперевозкам КАК CW_ДоходыПоГрузоперевозкам
	|ГДЕ
	|	CW_ДоходыПоГрузоперевозкам.Регистратор = &Регистратор
	|
	|СГРУППИРОВАТЬ ПО
	|	CW_ДоходыПоГрузоперевозкам.Регистратор";
	Запрос.УстановитьПараметр("Регистратор", СсылкаНаОбъект);
	
	РезультатЗапроса = запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Если Выборка.Следующий() Тогда
		КурсПерерасчета = Окр(Выборка.Всего / Выборка.ВсегоВал, 4);
	КонецЕсли;
	
	Возврат КурсПерерасчета;
	
КонецФункции

