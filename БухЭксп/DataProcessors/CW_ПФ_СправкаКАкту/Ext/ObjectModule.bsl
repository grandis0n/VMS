#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
// информация об обработке
Функция Информация() Экспорт 
	
	СтруктураОписания 		= CW_ПодключаемыеКомандыСервер.СведенияОПодключаемомОбъекте("3.2.2.1");
	СтруктураОписания.Тип 	= CW_ПодключаемыеКомандыСервер.ТипОбработка();
	СтруктураОписания.Вид 	= CW_ПодключаемыеКомандыСервер.ВидОбработкиВидПечатнаяФорма();
	
	СтруктураОписания.Наименование 				= "Справка к акту";
	СтруктураОписания.Описание 					= "Справка к акту";
	
	СтруктураОписания.Версия					= "3.2.8.2";
	СтруктураОписания.МинимальнаяВерсияМодуля   = "8.3.15.8";
	
	CW_ПодключаемыеКомандыСервер.УстановитьМетодыВнешнегоОбъекта(СтруктураОписания, "Регистрация");
	
	//Макросы  шаблона представления
	CW_ПодключаемыеКомандыСервер.УстановитьМакросыШаблонаПредставленияОбъекта(СтруктураОписания, "[НомерДокумента]", 			"Номер документа", 				"ПолучитьНомерДокумента(ПараметрыПроцедуры)");	
	CW_ПодключаемыеКомандыСервер.УстановитьМакросыШаблонаПредставленияОбъекта(СтруктураОписания, "[НомерИсправления]", 			"Номер исправлния", 			"ПолучитьНомерИсправления(ПараметрыПроцедуры)");	
	CW_ПодключаемыеКомандыСервер.УстановитьМакросыШаблонаПредставленияОбъекта(СтруктураОписания, "[ДатаДокумента, dd.MM.yyyy]", "Дата документа (dd.MM.yyyy)", 	"ПолучитьДатуДокументаГГГГ(ПараметрыПроцедуры)");	
	CW_ПодключаемыеКомандыСервер.УстановитьМакросыШаблонаПредставленияОбъекта(СтруктураОписания, "[ДатаДокумента, dd.MM.yy]", 	"Дата документа (dd.MM.yy)",	"ПолучитьДатуДокументаГГ(ПараметрыПроцедуры)");	
	//Макросы  шаблона представления
	
	Возврат СтруктураОписания;
	
КонецФункции 

Процедура Регистрация(Ссылка) Экспорт
	
	ИменаМетаданных = Новый Массив;
	ИменаМетаданных.Добавить("Документ.CW_ДоходыПоГрузоперевозке");
	
	ПарамерыРегистрации = CW_ПодключаемыеКомандыСервер.НоваяСтруктураПараметрыРегистрации();
	ПарамерыРегистрации.ПодключаемыйОбъект 	= Ссылка; 
	ПарамерыРегистрации.Представление 		= "Справка к акту"; 
	ПарамерыРегистрации.ИменаМетаданных		= ИменаМетаданных; 		

	CW_ПодключаемыеКомандыСервер.ОбновитьРегистрациюПечатнойФормы(ПарамерыРегистрации);

КонецПроцедуры

Функция Использование(ПодключаемыйОбъект=Неопределено) Экспорт 
	
	СтруктураПараметровДоговора = CW_Настройки.ПустаяСтруктураПолученияПараметровДоговора();
	СтруктураПараметровДоговора.Дата 				= СсылкаНаОбъект.Дата;
	СтруктураПараметровДоговора.Договор 			= СсылкаНаОбъект.Договор;
	СтруктураПараметровДоговора.ПриложениеКДоговору = СсылкаНаОбъект.ПриложениеКДоговору;
	
	ПараметрыДоговора	= CW_Настройки.ПолучитьПараметрыДоговора(СтруктураПараметровДоговора,"ФормироватьСправку");
	
	Возврат СсылкаНаОбъект.ФормируетсяАкт И ПараметрыДоговора.ФормироватьСправку;
	
КонецФункции

Функция ИспользованиеВКонтексте(КонтекстВызова) Экспорт 
	
	Использование = Ложь;
	
	Если ТипЗнч(КонтекстВызова) = Тип("ДокументСсылка.CW_ОтчетЭкспедитора") Тогда
		СтруктураПараметровДоговора = CW_Настройки.ПустаяСтруктураПолученияПараметровДоговора();
		СтруктураПараметровДоговора.Дата 				= СсылкаНаОбъект.Дата;
		СтруктураПараметровДоговора.Договор 			= СсылкаНаОбъект.Договор;
		СтруктураПараметровДоговора.ПриложениеКДоговору = СсылкаНаОбъект.ПриложениеКДоговору;
		
		ПараметрыДоговора	= CW_Настройки.ПолучитьПараметрыДоговора(СтруктураПараметровДоговора,"ФормироватьСправку");
		Использование 		=  СсылкаНаОбъект.ФормируетсяАкт И ПараметрыДоговора.ФормироватьСправку
		
	КонецЕсли;
	
	Возврат Использование;
	
КонецФункции
// информация об обработке


//Функции макросов шаблона представления
Функция ПолучитьНомерДокумента(ПараметрыПроцедуры) Экспорт
	
	Возврат СокрЛП(ПараметрыПроцедуры.НомерДокумента);
	
КонецФункции

Функция ПолучитьНомерИсправления(ПараметрыПроцедуры) Экспорт
	
	НомерИсправления  = ?(ЗначениеЗаполнено(ПараметрыПроцедуры.НомерИсправления), " (испр. "+Формат(ПараметрыПроцедуры.НомерИсправления,"ЧГ=0")+")","");
	Возврат СокрЛП(НомерИсправления);
	
КонецФункции

Функция ПолучитьДатуДокументаГГГГ(ПараметрыПроцедуры) Экспорт
	
	Возврат Формат(ПараметрыПроцедуры.ДатаДокумента, "ДФ=dd.MM.yyyy");
	
КонецФункции

Функция ПолучитьДатуДокументаГГ(ПараметрыПроцедуры) Экспорт
	
	Возврат Формат(ПараметрыПроцедуры.ДатаДокумента, "ДФ=dd.MM.yy");
	
КонецФункции
//Функции макросов шаблона представления

Функция ПечатнаяФорма(НастройкиПечати=Неопределено) Экспорт
	
	Если НастройкиПечати = Неопределено Тогда
		НастройкиПечати = CW_ПодключаемыеКомандыСервер.НоваяСтруктураНастроекПечати();
	КонецЕсли;
	
	ОсновнойЯзык = Константы.CW_ОсновнойЯзык.Получить();
	
	РезультатПечати = CW_ПодключаемыеКомандыСервер.НоваяСтруктураРезультатаПечати();

	КоличествоЭксземпляров = CW_Настройки.ПолучитьНастройкуПользователя(, "КоличествоЭкземпляровИсхАкта", Истина);
	Если КоличествоЭксземпляров <> Неопределено Тогда 
		РезультатПечати.Параметры.Количество = КоличествоЭксземпляров;
		РезультатПечати.Параметры.Печать 	 = (КоличествоЭксземпляров <> 0);  
	Иначе
		РезультатПечати.Параметры.Количество = 2;
		РезультатПечати.Параметры.Печать 	 = Истина;  
	КонецЕсли;  
	
	СтруктураПараметровДоговора = CW_Настройки.ПустаяСтруктураПолученияПараметровДоговора();
	СтруктураПараметровДоговора.Дата 				= СсылкаНаОбъект.Дата;
	СтруктураПараметровДоговора.Договор 			= СсылкаНаОбъект.Договор;
	СтруктураПараметровДоговора.ПриложениеКДоговору = СсылкаНаОбъект.ПриложениеКДоговору;
	
	ПараметрыДоговора	= CW_Настройки.ПолучитьПараметрыДоговора(СтруктураПараметровДоговора);
	
	ВыводитьПоказателиСправкиВВалютеДокумента = ПараметрыДоговора.ВыводитьПоказателиСправкиВВалютеДокумента;
	
	//Параметр дополнительной группировки
	ПараметрДополнительнойГруппировки = ПараметрыДоговора.ПараметрДополнительнойГруппировкиСправкиКАкту;
	ВыводитьПараметрДополнительнойГруппировки = ЗначениеЗаполнено(ПараметрДополнительнойГруппировки);
	//Параметр дополнительной группировки
	
	// Параметры макета
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.ОриентацияСтраницы	= ОриентацияСтраницы.Ландшафт;
	ТабличныйДокумент.АвтоМасштаб			= Истина;
	
	Макет = ПолучитьМакет("Справка");
	// Параметры макета
	
	ВалтаРегУчета = Константы.ВалютаРегламентированногоУчета.Получить();
	ПредставлениеВалюты = CW_Настройки_ПИ.ПредставлениеВалютыНаРусском(ВалтаРегУчета);
	
	ЗапросШапка = Новый Запрос;
	ЗапросШапка.Текст = "ВЫБРАТЬ
	|	CW_ДоходыПоГрузоперевозке.Организация КАК Организация,
	|	CW_ДоходыПоГрузоперевозке.Контрагент КАК Контрагент,
	|	CW_ДоходыПоГрузоперевозке.Договор КАК Договор,
	|	CW_ДоходыПоГрузоперевозке.НомерАкта КАК НомерАкта,
	|	CW_ДоходыПоГрузоперевозке.ДатаАкта КАК ДатаАкта,
	|	CW_ДоходыПоГрузоперевозке.Валюта КАК Валюта,
	|	CW_ДоходыПоГрузоперевозке.Дата КАК Дата
	|ИЗ
	|	Документ.CW_ДоходыПоГрузоперевозке КАК CW_ДоходыПоГрузоперевозке
	|ГДЕ
	|	CW_ДоходыПоГрузоперевозке.Ссылка = &Ссылка";
	
	ЗапросШапка.УстановитьПараметр("Ссылка", СсылкаНаОбъект);
	ВыборкаШапка = ЗапросШапка.Выполнить().Выбрать();
	ВыборкаШапка.Следующий();
	
	НаименованияОрганизации = Справочники.Организации.НаименованияНаДату(ВыборкаШапка.Организация, ВыборкаШапка.Дата);
	НаименованияКонтрагента = Справочники.Контрагенты.НаименованияНаДату(ВыборкаШапка.Контрагент, ВыборкаШапка.Дата);
	
	//Шапка отчета
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	ОбластьШапка.Параметры.Организация 	= НаименованияОрганизации.НаименованиеДляПечатныхФорм;
	ОбластьШапка.Параметры.Покупатель 	= НаименованияКонтрагента.НаименованиеДляПечатныхФорм;
	ОбластьШапка.Параметры.Договор 		= ВыборкаШапка.Договор;
	
	СтурктаНомерНаПечета = Новый Структура("Организация,Дата,НомерАкта");
	ЗаполнитьЗначенияСвойств(СтурктаНомерНаПечета, ВыборкаШапка);
	
	ПредставлениеФормы = "Справка к акту №"+ CW_Документы.ПолучитьНомерНаПечать(СтурктаНомерНаПечета, "НомерАкта")+" от "+Формат(ВыборкаШапка.ДатаАкта, "ДФ=dd.MM.yyyy");
	
	//Установка представления печатной формы
	ПараметрыПодключаемогоОбъекта = Новый Структура;
	ПараметрыПодключаемогоОбъекта.Вставить("ПодключаемыйОбъект",	НастройкиПечати.ПодключаемыйОбъект);
	ПараметрыПодключаемогоОбъекта.Вставить("ШаблонПредставления",	НастройкиПечати.ШаблонПредставления);
	ПараметрыПодключаемогоОбъекта.Вставить("Представление",			СокрЛП(ПредставлениеФормы));
	
	ПараметрыПроцедуры = Новый Структура;
	ПараметрыПроцедуры.Вставить("НомерДокумента",	СтурктаНомерНаПечета);
	ПараметрыПроцедуры.Вставить("ДатаДокумента",	ВыборкаШапка.ДатаАкта);
	ПараметрыПроцедуры.Вставить("НомерИсправления",	СсылкаНаОбъект.НомерИсправления);
	
	РезультатПечати.Представление = CW_ПодключаемыеКомандыСервер.ПолучитьПредставлениеПоШаблону(ЭтотОбъект, ПараметрыПодключаемогоОбъекта, ПараметрыПроцедуры);
	//Установка представления печатной формы
	
	ЗаголовокФормы = "СПРАВКА К АКТУ №"+ CW_Документы.ПолучитьНомерНаПечать(СтурктаНомерНаПечета, "НомерАкта")+" от "+Формат(ВыборкаШапка.ДатаАкта, "ДФ='dd MMMM yyyy ""г.""'");
	ОбластьШапка.Параметры.ЗаголовокФормы = ЗаголовокФормы;
	
	ТабличныйДокумент.Вывести(ОбластьШапка);
	//Шапка отчета    
	
	// дополнительно
	Если ПараметрыДоговора.ВыводитьДополнениевШапкуСправкиКАкту Тогда
		ОбластьДополнительно = Макет.ПолучитьОбласть("Дополнительно");
		ОбластьДополнительно.Параметры.Дополнительно = CW_Шаблоны.ОбработатьШаблонНоменклатуры(ПараметрыДоговора.ДополнениеВШапкеСправкиКАкту, СсылкаНаОбъект, Неопределено, СсылкаНаОбъект.Услуги);
		
		ТабличныйДокумент.Вывести(ОбластьДополнительно);
	КонецЕсли;	
	// дополнительно
	
	//Курс перерасчета
	КурсПерерасчета = ПолучитьКурсПересчетаПоТекущемуДокументу();
	
	мПеревыставление = Новый Массив;
	мПеревыставление.Добавить(ПредопределенноеЗначение("Перечисление.CW_ПорядокОтраженияЗатрат.Перевыставление"));
	мПеревыставление.Добавить(ПредопределенноеЗначение("Перечисление.CW_ПорядокОтраженияЗатрат.ПеревыставлениеПоСтавкам"));
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("Регистратор",	 	СсылкаНаОбъект);
	Запрос.УстановитьПараметр("КурсПерерасчета", 	КурсПерерасчета);
	Запрос.УстановитьПараметр("мПеревыставление", 	мПеревыставление);
	
	Запрос.УстановитьПараметр("Параметр", 	ПараметрДополнительнойГруппировки);
	Запрос.УстановитьПараметр("ВыводитьПараметрДополнительнойГруппировки", 	ВыводитьПараметрДополнительнойГруппировки);
	
	Запрос.УстановитьПараметр("Контрагент", 			СсылкаНаОбъект.Контрагент);
	Запрос.УстановитьПараметр("Договор", 				СсылкаНаОбъект.Договор);
	Запрос.УстановитьПараметр("ПриложениеКДоговору", 	СсылкаНаОбъект.ПриложениеКДоговору);
	
	//ЗАПРОСЫ
	ДополнитьВЗапросДанныеПоДоходам(Запрос);
	ДополнитьВЗапросДанныеПоПеревыставляемымЗатратам(Запрос);
	ПодготовитьГруппыУслугДляполученияПрямыхЗатрат(Запрос);
	ПолучитьПрямыеЗатраты(Запрос);
	ПолучитьРасходныеДокументыКАкту(Запрос);
	ДополнитьВЗапросИтогиПоРасходнымДокументам(Запрос);
	ПодготовитьДанныеВходящихДокументов(Запрос);
	ПодготовитьВходящиеДанные(Запрос);
	//ЗАПРОСЫ
	
	
	//КОНТРОЛЬ НАЛИЧИЯ ДОКУМЕНТОВ
	ПроверитьНаличиеВходящихДокументов(Запрос);
	//КОНТРОЛЬ НАЛИЧИЯ ДОКУМЕНТОВ
	
	
	//СЧИТАЕМ КОЛИЧЕСТВО ВАЛЮТ ПО ДОКУМЕНТАМ
	ВыводитьКолонкуВалюта = ПолучитьИспользованиеКолнкиВалюта(Запрос, ВалтаРегУчета);
	//СЧИТАЕМ КОЛИЧЕСТВО ВАЛЮТ ПО ДОКУМЕНТАМ
	
	
	//Вывод шапки таблицы
	ОбластьШапкаТаблицыНачало = Макет.ПолучитьОбласть("ШапкаТаблицы|Начало");
	ТабличныйДокумент.Вывести(ОбластьШапкаТаблицыНачало);
	
	Если ВыводитьКолонкуВалюта Тогда
		ОбластьШапкаТаблицыВалюта = Макет.ПолучитьОбласть("ШапкаТаблицы|Валюта");
		ТабличныйДокумент.Присоединить(ОбластьШапкаТаблицыВалюта);
	КонецЕсли;
	
	Если ВыводитьПараметрДополнительнойГруппировки Тогда
		ОбластьШапкаТаблицыДопГруппировка = Макет.ПолучитьОбласть("ШапкаТаблицы|ДопГруппировка");
		ОбластьШапкаТаблицыДопГруппировка.Параметры.ИмяПараметра = Строка(ПараметрДополнительнойГруппировки);
		ТабличныйДокумент.Присоединить(ОбластьШапкаТаблицыДопГруппировка);
	КонецЕсли;
	
	ОбластьШапкаТаблицыЗатратыПоДокументу = Макет.ПолучитьОбласть("ШапкаТаблицы|ЗатратыПоДокументу");
	ТабличныйДокумент.Присоединить(ОбластьШапкаТаблицыЗатратыПоДокументу);
	
	Если ВыводитьКолонкуВалюта Тогда
		ОбластьШапкаТаблицыЗатратыКАкту = Макет.ПолучитьОбласть("ШапкаТаблицы|ЗатратыКАкту");
		ТабличныйДокумент.Присоединить(ОбластьШапкаТаблицыЗатратыКАкту);
	КонецЕсли;
	
	ОбластьШапкаТаблицыЗатратыКАктуРегу = Макет.ПолучитьОбласть("ШапкаТаблицы|ЗатратыКАктуРег");
	ОбластьШапкаТаблицыЗатратыКАктуРегу.Параметры.Валюта 			= ПредставлениеВалюты;
	ТабличныйДокумент.Присоединить(ОбластьШапкаТаблицыЗатратыКАктуРегу);
	
	Если ВыводитьПоказателиСправкиВВалютеДокумента Тогда
		ОбластьШапкаТаблицыЗатратыВВалютеКлиента = Макет.ПолучитьОбласть("ШапкаТаблицы|ЗатратыВВалютеКлиента");
		ОбластьШапкаТаблицыЗатратыВВалютеКлиента.Параметры.ВалютаКлиента = CW_Настройки_ПИ.ПредставлениеВалютыНаРусском(ВыборкаШапка.Валюта);
		ТабличныйДокумент.Присоединить(ОбластьШапкаТаблицыЗатратыВВалютеКлиента);
	КонецЕсли;
	//Шапка таблицы
	
	
	//Данные таблицы
	Запрос.Текст = "ВЫБРАТЬ
	|	ВТ_Данные.Контрагент КАК Контрагент,
	|	ВТ_Данные.Номенклатура КАК Номенклатура,
	|	ВТ_Данные.НоменклатураНаименованиеПолное КАК НоменклатураНаименованиеПолное,
	|	ВТ_Данные.ПорядокОтражения КАК ПорядокОтражения,
	|	ВТ_Данные.Регистратор КАК Регистратор,
	|	ВТ_Данные.ПредставлениеДокумента КАК ПредставлениеДокумента,
	|	ВТ_Данные.Валюта КАК Валюта,
	|	ВТ_Данные.ЗначениеПараметра КАК ЗначениеПараметра,
	|	ВТ_Данные.РасходыСуммаВсего КАК РасходыСуммаВсего,
	|	ВТ_Данные.РасходыСуммаНДС КАК РасходыСуммаНДС,
	|	ВТ_Данные.РасходыСуммаВсегоВал КАК РасходыСуммаВсегоВал,
	|	ВТ_Данные.РасходыСуммаНДСВал КАК РасходыСуммаНДСВал,
	|	ВТ_Данные.СуммаВсегоВалОбщая КАК СуммаВсегоВалОбщая,
	|	ВТ_Данные.СуммаНДСВалОбщая КАК СуммаНДСВалОбщая,
	|	ВТ_Данные.ДоходыСуммаВсегоВал КАК ДоходыСуммаВсегоВал,
	|	ВТ_Данные.ДоходыСуммаНДСВал КАК ДоходыСуммаНДСВал
	|ИЗ
	|	ВТ_Данные КАК ВТ_Данные
	|ИТОГИ
	|	МАКСИМУМ(Контрагент),
	|	МАКСИМУМ(Номенклатура),
	|	МАКСИМУМ(НоменклатураНаименованиеПолное),
	|	МАКСИМУМ(ПорядокОтражения),
	|	МАКСИМУМ(ПредставлениеДокумента),
	|	МАКСИМУМ(Валюта),
	|	СУММА(РасходыСуммаВсего),
	|	СУММА(РасходыСуммаНДС),
	|	СУММА(РасходыСуммаВсегоВал),
	|	СУММА(РасходыСуммаНДСВал),
	|	МАКСИМУМ(СуммаВсегоВалОбщая),
	|	МАКСИМУМ(СуммаНДСВалОбщая),
	|	СУММА(ДоходыСуммаВсегоВал),
	|	СУММА(ДоходыСуммаНДСВал)
	|ПО
	|	ОБЩИЕ,
	|	Регистратор,
	|	ЗначениеПараметра";
	
	РезультатЗапроса = Запрос.Выполнить();                           
	
	ВыборкаОбщие = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Если ВыборкаОбщие.Следующий() Тогда
		Нпп = 1;
		
		ВыборкаДокументы  = ВыборкаОбщие.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаДокументы.Следующий() Цикл
			
			ВыборкаЗначенеПараметра = ВыборкаДокументы.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			Пока ВыборкаЗначенеПараметра.Следующий() Цикл
				
				ОбластьСтрокаТаблицыНачало = Макет.ПолучитьОбласть("СтрокаТаблицы|Начало");
				
				ОбластьСтрокаТаблицыНачало.Параметры.Заполнить(ВыборкаЗначенеПараметра);
				
				ОбластьСтрокаТаблицыНачало.Параметры.Нпп = Нпп;
				
				//Номенклатура
				мНоменклатура = Новый Массив;
				ВыборкаДетали = ВыборкаЗначенеПараметра.Выбрать();
				Пока ВыборкаДетали.Следующий() Цикл
					
					Если ПустаяСтрока(ВыборкаДетали.НоменклатураНаименованиеПолное) Тогда
						ЗначениеВМассиве = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ВыборкаДетали.НоменклатураНаименованиеПолное);
					Иначе
						ЗначениеВМассиве = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ВыборкаДетали.Номенклатура);
					КонецЕсли;
					
					ОбщегоНазначенияКлиентСервер.ДополнитьМассив(мНоменклатура, ЗначениеВМассиве, Истина); 
				КонецЦикла;
				
				ОбластьСтрокаТаблицыНачало.Параметры.Услуги = СтрСоединить(мНоменклатура, ", ");
				
				ТабличныйДокумент.Вывести(ОбластьСтрокаТаблицыНачало);
				
				Если ВыводитьКолонкуВалюта Тогда
					СтрокаТаблицыВалюта = Макет.ПолучитьОбласть("СтрокаТаблицы|Валюта");
					СтрокаТаблицыВалюта.Параметры.Валюта = CW_Настройки_ПИ.ПредставлениеВалютыНаРусском(ВыборкаЗначенеПараметра.Валюта);
					ТабличныйДокумент.Присоединить(СтрокаТаблицыВалюта);
				КонецЕсли;
				
				Если ВыводитьПараметрДополнительнойГруппировки Тогда
					СтрокаТаблицыДопГруппировка = Макет.ПолучитьОбласть("СтрокаТаблицы|ДопГруппировка");
					СтрокаТаблицыДопГруппировка.Параметры.ЗначениеПараметра = ВыборкаЗначенеПараметра.ЗначениеПараметра;
					ТабличныйДокумент.Присоединить(СтрокаТаблицыДопГруппировка);
				КонецЕсли;
				
				ОбластьСтрокаТаблицыЗатратыПоДокументу = Макет.ПолучитьОбласть("СтрокаТаблицы|ЗатратыПоДокументу");
				ОбластьСтрокаТаблицыЗатратыПоДокументу.Параметры.Заполнить(ВыборкаЗначенеПараметра);
				ТабличныйДокумент.Присоединить(ОбластьСтрокаТаблицыЗатратыПоДокументу);
				
				Если ВыводитьКолонкуВалюта Тогда
					СтрокаТаблицыЗатратыКАкту = Макет.ПолучитьОбласть("СтрокаТаблицы|ЗатратыКАкту");
					СтрокаТаблицыЗатратыКАкту.Параметры.Заполнить(ВыборкаЗначенеПараметра);
					ТабличныйДокумент.Присоединить(СтрокаТаблицыЗатратыКАкту);
				КонецЕсли;
				
				СтрокаТаблицыЗатратыКАктуРег = Макет.ПолучитьОбласть("СтрокаТаблицы|ЗатратыКАктуРег");
				СтрокаТаблицыЗатратыКАктуРег.Параметры.Заполнить(ВыборкаЗначенеПараметра);
				ТабличныйДокумент.Присоединить(СтрокаТаблицыЗатратыКАктуРег);
				
				Если ВыводитьПоказателиСправкиВВалютеДокумента Тогда
					СтрокаТаблицыЗатратыВВалютеКлиента = Макет.ПолучитьОбласть("СтрокаТаблицы|ЗатратыВВалютеКлиента");
					СтрокаТаблицыЗатратыВВалютеКлиента.Параметры.Заполнить(ВыборкаЗначенеПараметра);
					
					СтрокаТаблицыЗатратыВВалютеКлиента.Параметры.КурсПерерасчета = КурсПерерасчета;
					
					ТабличныйДокумент.Присоединить(СтрокаТаблицыЗатратыВВалютеКлиента);
				КонецЕсли;
				
				Нпп = Нпп + 1;
			КонецЦикла;
			
		КонецЦикла;
		
		//ОБЩИЕ ИТОГИ
		ОбластьОбщиеИтогиНачало = Макет.ПолучитьОбласть("ПодвалТаблицы|Начало");
		ТабличныйДокумент.Вывести(ОбластьОбщиеИтогиНачало);
		
		Если ВыводитьКолонкуВалюта Тогда
			ПодвалТаблицыВалюта = Макет.ПолучитьОбласть("ПодвалТаблицы|Валюта");
			ТабличныйДокумент.Присоединить(ПодвалТаблицыВалюта);
		КонецЕсли;
		
		Если ВыводитьПараметрДополнительнойГруппировки Тогда
			ПодвалТаблицыДопГруппировка = Макет.ПолучитьОбласть("ПодвалТаблицы|ДопГруппировка");
			ТабличныйДокумент.Присоединить(ПодвалТаблицыДопГруппировка);
		КонецЕсли;
		
		ПодвалТаблицыЗатратыПоДокументу = Макет.ПолучитьОбласть("ПодвалТаблицы|ЗатратыПоДокументу");
		ТабличныйДокумент.Присоединить(ПодвалТаблицыЗатратыПоДокументу);
		
		Если ВыводитьКолонкуВалюта Тогда
			ПодвалТаблицыЗатратыКАкту = Макет.ПолучитьОбласть("ПодвалТаблицы|ЗатратыКАкту");
			ТабличныйДокумент.Присоединить(ПодвалТаблицыЗатратыКАкту);
		КонецЕсли;
		
		ПодвалТаблицыЗатратыКАктуРег = Макет.ПолучитьОбласть("ПодвалТаблицы|ЗатратыКАктуРег");
		ПодвалТаблицыЗатратыКАктуРег.Параметры.Заполнить(ВыборкаОбщие);
		ТабличныйДокумент.Присоединить(ПодвалТаблицыЗатратыКАктуРег);
		
		Если ВыводитьПоказателиСправкиВВалютеДокумента Тогда
			ПодвалТаблицыЗатратыВВалютеКлиента = Макет.ПолучитьОбласть("ПодвалТаблицы|ЗатратыВВалютеКлиента");
			ПодвалТаблицыЗатратыВВалютеКлиента.Параметры.Заполнить(ВыборкаОбщие);
			ТабличныйДокумент.Присоединить(ПодвалТаблицыЗатратыВВалютеКлиента);
		КонецЕсли;
		//ОБЩИЕ ИТОГИ
	КонецЕсли;
	//Данные таблицы
	
	//Дополнительная таблица
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	CW_РасходыПоГрузоперевозкам.Регистратор КАК Регистратор,
	               |	CW_РасходыПоГрузоперевозкам.Контрагент КАК Поставщик,
	               |	CW_РасходыПоГрузоперевозкам.Валюта КАК Валюта,
	               |	CW_РасходыПоГрузоперевозкам.Покупатель КАК Контрагент,
	               |	CW_РасходыПоГрузоперевозкам.ДоговорПокупателя КАК Договор,
	               |	CW_РасходыПоГрузоперевозкам.ПриложениеКДоговоруПокупателя КАК ПриложениеКДоговору,
	               |	СУММА(CW_РасходыПоГрузоперевозкам.Всего_Валюта) КАК Сумма,
	               |	СУММА(ВЫБОР
	               |			КОГДА CW_РасходыПоГрузоперевозкам.Покупатель = &Контрагент
	               |					И CW_РасходыПоГрузоперевозкам.ДоговорПокупателя = &Договор
	               |					И CW_РасходыПоГрузоперевозкам.ПриложениеКДоговоруПокупателя = &ПриложениеКДоговору
	               |				ТОГДА CW_РасходыПоГрузоперевозкам.Всего_Валюта
	               |			ИНАЧЕ 0
	               |		КОНЕЦ) КАК Отражено
	               |ИЗ
	               |	РегистрНакопления.CW_РасходыПоГрузоперевозкам КАК CW_РасходыПоГрузоперевозкам
	               |ГДЕ
	               |	CW_РасходыПоГрузоперевозкам.Регистратор В
	               |			(ВЫБРАТЬ
	               |				ВТ_Регистраторы.Регистратор КАК Регистратор
	               |			ИЗ
	               |				ВТ_Регистраторы КАК ВТ_Регистраторы)
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	CW_РасходыПоГрузоперевозкам.Регистратор,
	               |	CW_РасходыПоГрузоперевозкам.Покупатель,
	               |	CW_РасходыПоГрузоперевозкам.ДоговорПокупателя,
	               |	CW_РасходыПоГрузоперевозкам.ПриложениеКДоговоруПокупателя,
	               |	CW_РасходыПоГрузоперевозкам.Валюта,
	               |	CW_РасходыПоГрузоперевозкам.Контрагент
	               |ИТОГИ
	               |	МАКСИМУМ(Поставщик),
	               |	МАКСИМУМ(Валюта),
	               |	СУММА(Сумма),
	               |	СУММА(Отражено)
	               |ПО
	               |	Регистратор,
	               |	Контрагент,
	               |	Договор,
	               |	ПриложениеКДоговору";
	
	Результат = Запрос.Выполнить();
	
	ВыборкаРегистратор = Результат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	ОбластьЗаголовокДоп = Макет.ПолучитьОбласть("ЗаголовокДоп");					
	ТабличныйДокумент.Вывести(ОбластьЗаголовокДоп);
	
	ОбластьШапкаТаблицыДоп = Макет.ПолучитьОбласть("ШапкаТаблицыДоп");					
	ТабличныйДокумент.Вывести(ОбластьШапкаТаблицыДоп);
	
	Пока ВыборкаРегистратор.Следующий() Цикл
		
		ОбластьСтрокаДокументДоп = Макет.ПолучитьОбласть("СтрокаДокументДоп");
		
		ЗаполнитьЗначенияСвойств(ОбластьСтрокаДокументДоп.Параметры, ВыборкаРегистратор);
		
		ОбластьСтрокаДокументДоп.Параметры.ПредставлениеДокумента 	= ВыборкаРегистратор.Регистратор.ПредставлениеДокумента;
		
		ТабличныйДокумент.Вывести(ОбластьСтрокаДокументДоп);
		
		ВыборкаКонтрагент = ВыборкаРегистратор.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаКонтрагент.Следующий() Цикл
			
			ВыборкаДоговор = ВыборкаКонтрагент.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			Пока ВыборкаДоговор.Следующий() Цикл
				
				ВыборкаПриложениеКДоговору = ВыборкаДоговор.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
				Пока ВыборкаПриложениеКДоговору.Следующий() Цикл
					
					ОбластьСтрокаДоп = Макет.ПолучитьОбласть("СтрокаДоп");	
					
					ПредставлениеПокупателя = Строка(ВыборкаКонтрагент.Контрагент) 
					+ " ( Дог. №"+ Строка(ВыборкаДоговор.Договор.НомерДоговора)+" от "+ Формат(ВыборкаДоговор.Договор.ДатаДоговора,"ДФ=dd.MM.yyyy");
					
					Если ЗначениеЗаполнено(ВыборкаПриложениеКДоговору.ПриложениеКДоговору) Тогда
						ПредставлениеПокупателя = ПредставлениеПокупателя 
						+ ", Прил. №"+Строка(ВыборкаПриложениеКДоговору.ПриложениеКДоговору.НомерДокумента)+" от "+Формат(ВыборкаПриложениеКДоговору.ПриложениеКДоговору.ДатаДокумента,"ДФ=dd.MM.yyyy");
					КонецЕсли;
					
					ОбластьСтрокаДоп.Параметры.ПредставлениеПокупателя = ПредставлениеПокупателя;
					ОбластьСтрокаДоп.Параметры.Сумма 		= ВыборкаПриложениеКДоговору.Сумма;
					ОбластьСтрокаДоп.Параметры.Отражено 	= ВыборкаПриложениеКДоговору.Отражено;
					
					ТабличныйДокумент.Вывести(ОбластьСтрокаДоп);
					
				КонецЦикла;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	//Дополнительная таблица
	
	//Исполнитель документа
	Если Не СсылкаНаОбъект.Ответственный.Пустая() и ПараметрыДоговора.ВыводитьИсполнителяСправкаКАкту Тогда
		
		ОбластьРазделитель = Макет.ПолучитьОбласть("Разделитель");
		ТабличныйДокумент.Вывести(ОбластьРазделитель);
		
		ТелефонИсполнителя = 
		УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(СсылкаНаОбъект.Ответственный, 
		ПредопределенноеЗначение("Справочник.ВидыКонтактнойИнформации.ТелефонПользователя")
		,, Истина);		
		
		ИсполнительФизическоеЛицо 	= СсылкаНаОбъект.Ответственный.ФизическоеЛицо;
		Если ИсполнительФизическоеЛицо.Пустая() Тогда
			Исполнитель = "";
		Иначе
			Исполнитель = ФизическиеЛицаКлиентСервер.ФамилияИнициалы(ИсполнительФизическоеЛицо);
		КонецЕсли;
		
		ОбластьИсполнитель = Макет.ПолучитьОбласть("Исполнитель");
		ОбластьИсполнитель.Параметры.Исполнитель 		= "Исп. "+ Исполнитель;
		ОбластьИсполнитель.Параметры.ТелефонИсполнителя = "Тел. "+ ТелефонИсполнителя;
		
		ТабличныйДокумент.Вывести(ОбластьИсполнитель);
		
	КонецЕсли;
	//Исполнитель документа
	
	РезультатПечати.ПечатнаяФорма = ТабличныйДокумент;
	
	Возврат РезультатПечати;
	
КонецФункции

Функция ПолучитьИспользованиеКолнкиВалюта(Запрос, Знач ВалтаРегУчета)
	
	Запрос.Текст = "ВЫБРАТЬ
	|	ВТ_Регистраторы.Валюта КАК Валюта
	|ИЗ
	|	ВТ_Регистраторы КАК ВТ_Регистраторы
	|ГДЕ
	|	ВТ_Регистраторы.Валюта <> &ВалтаРегУчета";
	
	Запрос.УстановитьПараметр("ВалтаРегУчета", ВалтаРегУчета);
	РеузльтатЗапроса = Запрос.Выполнить();
	
	Возврат НЕ РеузльтатЗапроса.Пустой()
	
КонецФункции


//ЗАПРОСЫ
Процедура ДополнитьВЗапросДанныеПоДоходам(Запрос)
	
	Запрос.Текст = "ВЫБРАТЬ
	|	CW_ДоходыПоГрузоперевозкам.Грузоперевозка КАК Грузоперевозка,
	|	CW_ДоходыПоГрузоперевозкам.Договор КАК Договор,
	|	CW_ДоходыПоГрузоперевозкам.ПриложениеКДоговору КАК ПриложениеКДоговору,
	|	CW_ДоходыПоГрузоперевозкам.ДокументРасходов КАК ДокументРасходов,
	|	CW_ДоходыПоГрузоперевозкам.ПорядокОтражения КАК ПорядокОтражения,
	|	CW_ДоходыПоГрузоперевозкам.Номенклатура КАК Номенклатура,
	|	CW_ДоходыПоГрузоперевозкам.Номенклатура.НаименованиеПолное КАК НоменклатураНаименованиеПолное,
	|	ЕСТЬNULL(CW_СоставГруппУслуг.ГруппаУслуг, НЕОПРЕДЕЛЕНО) КАК ГруппаУслуг,
