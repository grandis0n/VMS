	//
	//Если "Сатурн"=СокрЛП(струПараметрыФормыОтправкиПисьма.Событие.Контрагент) Тогда 
	//	// для некоторых условий можно доработать письмо немного иначе, чем обычно
	//	струПараметрыФормыОтправкиПисьма.СтруктураПисьма.Тексты[0].Текст = 
	//		струПараметрыФормыОтправкиПисьма.СтруктураПисьма.Тексты[0].Текст
	//		+ Символы.ПС 
	//		+ Символы.ПС 
	//		+ "PS Просьба не забывать возвращать оригиналы документов! Иначе получится как в тот раз!"
	//	;
	//КонецЕсли;
	
	// можно по некоторому условию (например, выполнив отправку прямо отсюда) отказаться от вызова стандартной интерактивной формы отправки
	//СтруктураОтвета.Вставить("ОткрыватьСтандартнуюФормуОтправкиПочты", Ложь);
	
	Возврат СтруктураОтвета;

