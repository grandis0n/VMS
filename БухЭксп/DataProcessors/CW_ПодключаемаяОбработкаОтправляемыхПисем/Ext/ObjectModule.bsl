#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
// информация об обработке
Функция Информация() Экспорт 
	
	СтруктураОписания 		= CW_ПодключаемыеКомандыСервер.СведенияОПодключаемомОбъекте();
	СтруктураОписания.Тип 	= CW_ПодключаемыеКомандыСервер.ТипОбработка();
	СтруктураОписания.Вид 	= CW_ПодключаемыеКомандыСервер.ВидОбработкиОбработкаОтправляемыхПисем();
	
	СтруктураОписания.Наименование 				= "Обработка отправляемых писем (пример)";
	СтруктураОписания.Описание 					= "Пример работы с отправляемымми письмами";
	СтруктураОписания.Версия 					= "3.2.0";
	СтруктураОписания.МинимальнаяВерсияМодуля	= "8.3.10.10";
	СтруктураОписания.Настройка 				= Истина;

	//Методы обработчика
	CW_ПодключаемыеКомандыСервер.УстановитьМетодыВнешнегоОбъекта(СтруктураОписания, "ОбработатьПараметрыФормыОтправкиПисьма");
	
	//Формы обработчика
	CW_ПодключаемыеКомандыСервер.УстановитьИмяФормыНастроекОбъекта(СтруктураОписания, 	"ФормаНастройки");
	
	Возврат СтруктураОписания;

	
КонецФункции

