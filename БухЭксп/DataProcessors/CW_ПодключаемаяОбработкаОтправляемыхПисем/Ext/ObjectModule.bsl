	стру = _ПО.ПолучитьНастройкиОбработки(ПодключаемыйОбъект);
	Если ТипЗнч(стру) = Тип("Структура") Тогда 
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, стру);
	КонецЕсли;
	
	док = струПараметрыФормыОтправкиПисьма.Событие.ОбъектСобытия;
	Если ТипЗнч(док) = Тип("ДокументСсылка.CW_ДоходыПоГрузоперевозке")
		и ЗначениеЗаполнено(док)
		и док.ФормируетсяСчет
	Тогда 
		// только для счетов
		
		Если ЗначениеЗаполнено(ХарактеристикаАдресДляОтправкиПисьма) Тогда 
			з = Новый Запрос(
				"ВЫБРАТЬ РАЗЛИЧНЫЕ
				|	влож.АдресДляОтправкиПисьма
				|ИЗ
				|	(ВЫБРАТЬ
				|		ВЫРАЗИТЬ(CW_ХарактеристикиГрузоперевозок.Значение КАК СТРОКА(256)) КАК АдресДляОтправкиПисьма
				|	ИЗ
				|		Документ.CW_ДоходыПоГрузоперевозке.Услуги КАК CW_ДоходыПоГрузоперевозкеУслуги
				|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.CW_ХарактеристикиГрузоперевозок КАК CW_ХарактеристикиГрузоперевозок
				|			ПО CW_ДоходыПоГрузоперевозкеУслуги.Грузоперевозка = CW_ХарактеристикиГрузоперевозок.Грузоперевозка
				|				И (CW_ХарактеристикиГрузоперевозок.Параметр = &ХарактеристикаАдресДляОтправкиПисьма)
				|	ГДЕ
				|		CW_ДоходыПоГрузоперевозкеУслуги.Ссылка = &ДоходыСсылка
				|	
				|	ОБЪЕДИНИТЬ ВСЕ
				|	
				|	ВЫБРАТЬ
				|		CW_УчетныеЗаписиЭлектроннойПочты.ПочтовыйАдрес
				|	ИЗ
				|		Справочник.CW_УчетныеЗаписиЭлектроннойПочты КАК CW_УчетныеЗаписиЭлектроннойПочты
				|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.CW_НастройкиПользователей КАК CW_НастройкиПользователей
				|				ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.CW_ДоходыПоГрузоперевозке.Услуги КАК CW_ДоходыПоГрузоперевозкеУслуги
				|				ПО CW_НастройкиПользователей.Пользователь.ФизическоеЛицо = CW_ДоходыПоГрузоперевозкеУслуги.Грузоперевозка.ОперативныйМенеджер
				|					И (CW_ДоходыПоГрузоперевозкеУслуги.Ссылка = &ДоходыСсылка)
				|			ПО CW_УчетныеЗаписиЭлектроннойПочты.Ссылка = CW_НастройкиПользователей.УчетнаяЗаписьЭлектроннойПочты) КАК влож"
			);
			з.УстановитьПараметр("ДоходыСсылка", док);
			з.УстановитьПараметр("ХарактеристикаАдресДляОтправкиПисьма", ХарактеристикаАдресДляОтправкиПисьма);
			рз = з.Выполнить();
			выб = рз.Выбрать();
			Пока выб.Следующий() Цикл
				// если есть адрес и его ещё нет в письме, то добавим
				Если ЗначениеЗаполнено(выб.АдресДляОтправкиПисьма) 
					И Неопределено=струПараметрыФормыОтправкиПисьма.СтруктураПисьма.Получатели.Найти(выб.АдресДляОтправкиПисьма)
					И Неопределено=струПараметрыФормыОтправкиПисьма.СтруктураПисьма.Получатели_Копии.Найти(выб.АдресДляОтправкиПисьма)
				Тогда 
					// в копию
					_ЭП.ДобавитьПолучателейИзСтроки(струПараметрыФормыОтправкиПисьма.СтруктураПисьма.Получатели_Копии, выб.АдресДляОтправкиПисьма);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
	КонецЕсли;
	
	//// пример упрощённый, не для подражания
	//
