КонецПроцедуры

&НаСервере
Функция _СписокНастроекСтрокой()
	
	ЭтаФорма.ПолучитьРеквизиты("Объект");
	
	рез="";
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	Для Каждого мдРекв Из ОбработкаОбъект.Метаданные().Реквизиты Цикл
		//Если Лев(мдРекв.Имя, 9) = "Выгрузка_"
		//	ИЛИ Лев(мдРекв.Имя, 9) = "Загрузка_"
		//Тогда 
		//	// реквизит относится к настройкам загрузки либо выгрузки
		//	рез = рез + "," + мдРекв.Имя;
		//КонецЕсли;
		Если мдРекв.Имя = "ПодключаемыйОбъект" Тогда 
			Продолжить;
		КонецЕсли;
		рез = рез + "," + мдРекв.Имя;
	КонецЦикла;
	
	рез = Сред(рез, 2);
