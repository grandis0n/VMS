КонецФункции

&НаСервере
Функция _ПрочитатьНастройки()
	
	стру = _ПО.ПолучитьНастройкиОбработки(Объект.ПодключаемыйОбъект);
	Если ТипЗнч(стру) = Тип("Структура") Тогда 
		ЗаполнитьЗначенияСвойств(Объект, стру);
	КонецЕсли;
	
КонецФункции

&НаСервере
Функция _ЗаписатьНастройки()
	
	стру = Новый Структура(_СписокНастроекСтрокой());
	ЗаполнитьЗначенияСвойств(стру, Объект);
	_ПО.ЗаписатьНастройкиОбработки(Объект.ПодключаемыйОбъект, стру);
	
	Возврат Истина;
	
КонецФункции

