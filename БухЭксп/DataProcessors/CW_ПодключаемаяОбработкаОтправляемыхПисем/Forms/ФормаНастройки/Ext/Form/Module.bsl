&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Параметры.Свойство("Объект", Объект.ПодключаемыйОбъект);
	//Параметры.Свойство("Субъект", Объект. );
	
	ЭтаФорма.Заголовок = "Настройки заполнения отправляемых писем"; 
	_ПрочитатьНастройки();
