Функция ПредставлениеНоменклатуры(Стр, Док)
	
	Если СсылкаНаОбъект.ПодробноеПредставлениеНоменклатуры Тогда
		Мас = Док.Услуги.НайтиСтроки(Новый Структура("Грузоперевозка,Номенклатура,Сумма,СтавкаНДС,НДС,Всего", Стр.Грузоперевозка, Стр.Номенклатура, Стр.Сумма, Стр.СтавкаНДС, Стр.НДС, Стр.Всего)); 
		Если Мас.Количество() = 1 Тогда
			Если Мас[0].Представление <> "" Тогда
				Возврат Мас[0].Представление;
			Иначе
				Возврат ТиповоеПредставлениеНоменклатуры(Стр);
			КонецЕсли;	
		Иначе
			Возврат ТиповоеПредставлениеНоменклатуры(Стр);
		КонецЕсли;	
	Иначе	
		Возврат ТиповоеПредставлениеНоменклатуры(Стр);
	КонецЕсли;
	
КонецФункции

Функция ТиповоеПредставлениеНоменклатуры(Стр) 
	
	Если СокрЛП(Стр.Номенклатура.НаименованиеПолное) <> "" Тогда
		Возврат(Стр.Номенклатура.НаименованиеПолное);
	Иначе
		Возврат(Стр.Номенклатура.Наименование);
	КонецЕсли; 
	
КонецФункции	

Функция НаименованиеКонтрагента(Контрагент)
	
	Возврат ?(ПустаяСтрока(СокрЛП(Контрагент.НаименованиеПолное)),Контрагент.Наименование, СокрЛП(Контрагент.НаименованиеПолное));
	
КонецФункции

#КонецЕсли