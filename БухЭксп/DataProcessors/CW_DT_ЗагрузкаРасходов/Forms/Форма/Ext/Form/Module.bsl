&НаСервере
Функция СписокГрузоперевозокЕстьОшибки()
	Если НЕ СписокГрузоперевозок.Количество() Тогда
		Возврат "Список пуст!"
	ИначеЕсли СписокГрузоперевозок.НайтиСтроки(Новый Структура("Грузоперевозка",Справочники.CW_Грузоперевозки.ПустаяСсылка())).Количество() Тогда 
		Возврат "Есть пустые строки!"
	Иначе
		Таб = СписокГрузоперевозок.Выгрузить();Таб.Свернуть("Грузоперевозка");
		Если НЕ Таб.Количество() = СписокГрузоперевозок.Количество() Тогда
			Возврат "Есть дубли грузоперевозок!"
		КонецЕсли; 
	КонецЕсли; 	
