
#Область Форма

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	CW_ПодключаемыеКомандыСервер.ПриСозданииНаСервере(ЭтотОбъект);
	
	ВосстановитьСеансовуюНастройку();
	
	Если Параметры.Свойство("ТранспортноеСообщение",ТранспортноеСообщение) Тогда
		ПрочитатьТранспортноеСообщение(Отказ);
	Иначе 
		Элементы.ТранспортноеСообщение.Видимость = Истина;
	КонецЕсли; 
	
	ОбновитьСписокДополнительныхКолонокФормы(ЭтаФорма);
	
	Элементы.ГруппаСинхронизация.Ширина = 30;
	СтатусДокумента = Справочники.CW_СтатусыДокументов.ПолучитьСтатусНовогоОбъекта(Тип("ДокументСсылка.CW_РасходыПоГрузоперевозке"));	
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ОбновитьЗначенияУслуг();
	УслугиПоДоговру();
	Услуги_ЗаполнитьПроядокОтражения("");
	МожноФормировать(); 
	ИницализацияЭлементовФормы();
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	Если Не ЗавершениеРаботы Тогда
		СохранитьСеансовуюНастройку();
	КонецЕсли; 
КонецПроцедуры


&НаКлиенте
Процедура ИницализацияЭлементовФормы()
	ПоказыватьСинхронизацию							= ЕстьОшибкиСинхронизации;
	Элементы.ГруппаСинхронизация.Видимость			= ПоказыватьСинхронизацию;
	Элементы.ФормаПоказыватьСинхронизацию.Пометка	= ПоказыватьСинхронизацию; 	
	Элементы.УслугиДополнительныеКолонки.Видимость	= ПоказыватьДопКолоноки;
	Элементы.Услуги_ПоказыватьДопКолоноки.Пометка	= ПоказыватьДопКолоноки;
	ПредставлениеПараметраРаспределения();
КонецПроцедуры
 

&НаСервере
Процедура ПрочитатьТранспортноеСообщение(Отказ)
	
	ОчиститьФорму();
	ЗаполнитьЗначенияСвойств(ЭтаФорма,ТранспортноеСообщение,"Организация,Контрагент,ПрофильОбмена");
	Нашли = ТранспортноеСообщение.Вложения.Найти("Finance");Если Нашли = Неопределено Тогда Возврат;КонецЕсли;
	
	ПолноеИмяФайла = CW_РаботаСФайламиСервер.ПолучитьПолноеИмяФайла(Нашли.ОбъектАрхива);
	
	CW_DT.ЗаполнитьФормуИзXML(ЭтаФорма, ПолноеИмяФайла, Отказ);
	ПолучитьСинхронизацию();
	НайтиДоговор();
	ПодобратьГрузоперевозки();
	
	ПодразделениеОрганизации = CW_Настройки.ПолучитьНастройкуПользователя(CW_Настройки.Пользователь(),"ПодразделениеПользователя");	
	
	//Инициализация видимости элементов
	ПредставлениеСчета = ПредставлениеСчета(Счет);
	Элементы.ГруппаПродавец.Видимость		= НЕ ПродавецИдентификатор = "";
	Элементы.ПредставлениеСчета.Видимость	= НЕ ПредъявленСчет;
	Элементы.ГруппаСчет.Видимость			= НЕ ПредъявленСчет И НЕ СписокСчетов;
	Элементы.УникальныеСчета.Видимость		= СписокСчетов;
	Элементы.УслугиСчет.Видимость			= СписокСчетов;
	
	Элементы.ФормаСформировать.Заголовок	= ?(РасходыСсылка.Пустая(),"Сформировать","Обновить");	
	Заголовок = "Транспортное сообщение " + ТранспортноеСообщение.Номер + " от " + Формат(ТранспортноеСообщение.Дата,"ДФ=dd.MM.yyyy") + ": " + ?(РасходыСсылка.Пустая(),"Формирование","Обновление") + " расходов";
	
КонецПроцедуры



&НаСервере
Процедура ВосстановитьСеансовуюНастройку()
	СтруктураНастройки = ХранилищеСистемныхНастроек.Загрузить("CWDT.ЗагрузкаРасходов.Форма","Сеансовая");
	Если СтруктураНастройки <> Неопределено Тогда
		Попытка
			СтруктураНастройки.Свойство("ПараметрРаспределения",ПараметрРаспределения);
			СтруктураНастройки.Свойство("ПоказыватьДопКолоноки",ПоказыватьДопКолоноки);
			СтруктураНастройки.Свойство("Настройка_ФормироватьПредставлениеУслуги",Настройка_ФормироватьПредставлениеУслуги);
			СтруктураНастройки.Свойство("Настройка_ЗакрыватьОкноПослеФормирования",Настройка_ЗакрыватьОкноПослеФормирования);
			СтруктураНастройки.Свойство("Настройка_ОткрыватьСформированныйДокумент",Настройка_ОткрыватьСформированныйДокумент);
			СтруктураНастройки.Свойство("Настройка_ПроводитьСформированныйДокумент",Настройка_ПроводитьСформированныйДокумент);
		Исключение
		КонецПопытки;			
	КонецЕсли; 
КонецПроцедуры

&НаСервере
Процедура СохранитьСеансовуюНастройку()
	СтруктураНастройки = Новый Структура();
	мВыбранныеКолонки = Новый Массив;
	Для Каждого ЭлементСписка Из СписокДополнительныхКолонок Цикл
		Если ЭлементСписка.Пометка Тогда
			мВыбранныеКолонки.Добавить(ЭлементСписка.Значение);
		КонецЕсли;
	КонецЦикла;
	СтруктураНастройки.Вставить("ВыбранныеКолонки",мВыбранныеКолонки);
	СтруктураНастройки.Вставить("ПараметрРаспределения",ПараметрРаспределения);
	СтруктураНастройки.Вставить("ПоказыватьДопКолоноки",ПоказыватьДопКолоноки);
	СтруктураНастройки.Вставить("Настройка_ФормироватьПредставлениеУслуги",Настройка_ФормироватьПредставлениеУслуги);
	СтруктураНастройки.Вставить("Настройка_ЗакрыватьОкноПослеФормирования",Настройка_ЗакрыватьОкноПослеФормирования);
	СтруктураНастройки.Вставить("Настройка_ОткрыватьСформированныйДокумент",Настройка_ОткрыватьСформированныйДокумент);
	СтруктураНастройки.Вставить("Настройка_ПроводитьСформированныйДокумент",Настройка_ПроводитьСформированныйДокумент);
	ХранилищеСистемныхНастроек.Сохранить("CWDT.ЗагрузкаРасходов.Форма","Сеансовая",СтруктураНастройки);
КонецПроцедуры


