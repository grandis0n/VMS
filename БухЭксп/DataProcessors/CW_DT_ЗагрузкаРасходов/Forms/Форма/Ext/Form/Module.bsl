		ОбработатьРезультатВыбораКолонок(Результат);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ДополнитьДинамическиеКолонки(ФормаОбъекта)
	
    МассивДобавляемыхКолонокРезультатПоиска = Новый Массив;
	МассивУдаляемыхКолонокРезультатПоиска 	 = Новый Массив;
	
	мТипыРеквизитв = Новый Массив;
	мТипыРеквизитв.Добавить(Тип("Строка"));
	мТипыРеквизитв.Добавить(Тип("Число"));
	мТипыРеквизитв.Добавить(Тип("Дата"));
	мТипыРеквизитв.Добавить(Тип("Булево"));
	мТипыРеквизитв.Добавить(Справочники.ТипВсеСсылки());
	
	РеквизитыТаблицы = ФормаОбъекта.ПолучитьРеквизиты("Услуги");
	
	мРеквизитыТаблицы = Новый массив;
	Для Каждого Реквизит из РеквизитыТаблицы Цикл
		мРеквизитыТаблицы.Добавить(Реквизит.имя);
	КонецЦикла;

	СписокДобавляемыхДополнительныхКолонок = новый СписокЗначений;
	
	Для Каждого ЭлементСписка из ФормаОбъекта.СписокДополнительныхКолонок Цикл
		Если ЭлементСписка.Пометка тогда
			//РезультатПоиска
			Если мРеквизитыТаблицы.Найти("_"+ЭлементСписка.Значение) = Неопределено Тогда
				МассивДобавляемыхКолонокРезультатПоиска.Добавить(Новый РеквизитФормы("_"+ЭлементСписка.Значение, Новый ОписаниеТипов(мТипыРеквизитв), "Услуги",ЭлементСписка.Представление,Ложь));
			КонецЕсли;
			СписокДобавляемыхДополнительныхКолонок.Добавить(ЭлементСписка.Значение,ЭлементСписка.Представление,ЭлементСписка.Пометка); 
		Иначе
			УдаляемыйРеквизит = мРеквизитыТаблицы.Найти("_"+ЭлементСписка.Значение);
			Если УдаляемыйРеквизит <> Неопределено Тогда
				МассивУдаляемыхКолонокРезультатПоиска.Добавить("Услуги."+мРеквизитыТаблицы[УдаляемыйРеквизит]);
			КонецЕсли;
		КонецЕсли
	КонецЦикла;
	
	//РезультатПоиска
	ФормаОбъекта.ИзменитьРеквизиты(МассивДобавляемыхКолонокРезультатПоиска,МассивУдаляемыхКолонокРезультатПоиска);
	
	//Выводим на форме
	РасположениеКолонок = ФормаОбъекта.Элементы.Найти("УслугиДополнительныеКолонки");
	Если РасположениеКолонок = Неопределено тогда
		РасположениеКолонок = ФормаОбъекта.Элементы.Услуги;
	Конецесли;
	
	ВсегоКолонок = СписокДобавляемыхДополнительныхКолонок.Количество();
	Индекс = 0;
	
	СооветствиеГрупп = новый Соответствие;
	Для Индекс = 0 По  ВсегоКолонок Цикл
		Если Индекс%2 = 0 Тогда
			НайденныйЭлемент = ФормаОбъекта.Элементы.Найти("УслугиДополнительныеКолонки_"+Формат(Индекс,"ЧГ=0"));
			Если найденныйЭлемент <> Неопределено Тогда
				//Удаляем с формы
				ФормаОбъекта.Элементы.Удалить(НайденныйЭлемент);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Для Индекс = 0 По  ВсегоКолонок Цикл
		Если Индекс%2 = 0 Тогда
			НайденныйЭлемент = ФормаОбъекта.Элементы.Найти("УслугиДополнительныеКолонки_"+Формат(Индекс,"ЧГ=0"));
			Если найденныйЭлемент = Неопределено Тогда
				
				нЭлемент 				= ФормаОбъекта.Элементы.Добавить("УслугиДополнительныеКолонки_"+Формат(Индекс,"ЧГ=0"), Тип("ГруппаФормы"), РасположениеКолонок); 
				нЭлемент.Группировка 	= ГруппировкаКолонок.Вертикальная; 
				нЭлемент.ТолькоПросмотр = истина;
			КонецЕсли;
			
			СооветствиеГрупп.Вставить(Индекс, нЭлемент); 
		КонецЕсли;
	КонецЦикла;

	Для Каждого ЭлементСписка  из ФормаОбъекта.СписокДополнительныхКолонок Цикл
		//РезультатПоиска_
		НайденныйЭлемент = ФормаОбъекта.Элементы.Найти("Услуги_"+ЭлементСписка.Значение);
		Если найденныйЭлемент <> Неопределено Тогда
			//Удаляем с формы
			ФормаОбъекта.Элементы.Удалить(НайденныйЭлемент);
		КонецЕсли;
	КонецЦикла;
	
	Индекс = 0;
	Для Каждого ЭлементСписка  из СписокДобавляемыхДополнительныхКолонок Цикл
		
		Если Индекс%2 = 0 Тогда
			РасположениеКолонок = СооветствиеГрупп.Получить(Индекс);
		КонецЕсли;
		
		Если ФормаОбъекта.Элементы.Найти("Услуги_"+ЭлементСписка.Значение) = Неопределено  тогда
			//РезультатПоиска
			нЭлемент 				= ФормаОбъекта.Элементы.Добавить("Услуги_"+ЭлементСписка.Значение, Тип("ПолеФормы"), РасположениеКолонок); 
			нЭлемент.Вид 			= ВидПоляФормы.ПолеВвода; 
			нЭлемент.ПутьКДанным 	= "Услуги."+"_"+ЭлементСписка.Значение;
			нЭлемент.ТолькоПросмотр = истина;
		Конецесли;
		Индекс = Индекс + 1;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьСписокДополнительныхКолонокФормы(ФормаОбъекта) Экспорт
	ФормаОбъекта.СписокДополнительныхКолонок.Очистить();
	СоответствиеПараметров = Новый Соответствие;
	Справочники.CW_Грузоперевозки.ПолучитьСписокРеквизитовШапкиДляВыводаНаФорму(СоответствиеПараметров, ФормаОбъекта.СписокДополнительныхКолонок);
	ПланыВидовХарактеристик.CW_ПараметрыГрузоперевозок.ПолучиьСписокПараметровДляВыводаНаФорму(СоответствиеПараметров, ФормаОбъекта.СписокДополнительныхКолонок);
	ФормаОбъекта.СписокДоступныхПараметров.Добавить(СоответствиеПараметров);	
	Настройки = ХранилищеСистемныхНастроек.Загрузить("CWDT.ЗагрузкаРасходов.Форма","Сеансовая");
	Если Настройки <> Неопределено Тогда
		Если Настройки.Свойство("ВыбранныеКолонки") Тогда
			ФормаОбъекта.СписокВыбранныеКолонки.ЗагрузитьЗначения(Настройки.ВыбранныеКолонки);
			Для Каждого ЭлементМассива из Настройки.ВыбранныеКолонки Цикл
				ЭлементСписка = ФормаОбъекта.СписокДополнительныхКолонок.НайтиПоЗначению(ЭлементМассива);
				Если ЭлементСписка <> Неопределено Тогда
					ЭлементСписка.Пометка = истина;
				КонецЕсли;
			КонецЦикла;
			ДополнитьДинамическиеКолонки(ФормаОбъекта);
		КонецЕсли;
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Процедура ОбработатьРезультатВыбораКолонок(Результат)
	Если ЭтоАдресВременногоХранилища(Результат) Тогда
		СписокКолонок = ПолучитьИзВременногоХранилища(Результат);
		СписокДополнительныхКолонок.Очистить();
		СписокВыбранныеКолонки.Очистить();
		Для Каждого ЭлементСписка из СписокКолонок Цикл
			СписокДополнительныхКолонок.Добавить(ЭлементСписка.Значение, ЭлементСписка.Представление, ЭлементСписка.Пометка);
			Если ЭлементСписка.Пометка Тогда
				СписокВыбранныеКолонки.Добавить(ЭлементСписка.Значение);	
			КонецЕсли;
		КонецЦикла;
		ДополнитьДинамическиеКолонки(ЭтаФорма);
		_УФС.ОбновитьЗначенияПараметровГрузоперевозок(ПолучитьСтруктуруПараметровДляПередачи());
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ПолучитьСтруктуруПараметровДляПередачи(Идентификатор=Неопределено)
	
	мГрузоперевозки			= Новый Массив;
	ТаблицаДокумента		= Новый Массив;
	СоответствиеПараметров	= Неопределено;
	
	Если СписокДоступныхПараметров.Количество() Тогда
		СоответствиеПараметров = СписокДоступныхПараметров[0].Значение;
	КонецЕсли;
	
	Если Идентификатор=Неопределено Тогда
		ЭлементыУслуг = Услуги.ПолучитьЭлементы();	
	Иначе
		ЭлементыУслуг = Новый Массив;
		Для Каждого Элемент Из Услуги.ПолучитьЭлементы() Цикл
			Если Элемент.ГрузоперевозкаИдентификатор = Идентификатор Тогда ЭлементыУслуг.Добавить(Элемент);КонецЕсли; 
		КонецЦикла; 
	КонецЕсли; 
	
	Для Каждого Элемент Из ЭлементыУслуг Цикл
		Если Элемент.Корень Тогда
			Для Каждого Ветвь Из Элемент.ПолучитьЭлементы() Цикл
				Если мГрузоперевозки.Найти(Ветвь.Грузоперевозка)=Неопределено Тогда мГрузоперевозки.Добавить(Ветвь.Грузоперевозка);КонецЕсли; 		
				ТаблицаДокумента.Добавить(Ветвь);		
			КонецЦикла; 
		Иначе 
			Если мГрузоперевозки.Найти(Элемент.Грузоперевозка)=Неопределено Тогда мГрузоперевозки.Добавить(Элемент.Грузоперевозка);КонецЕсли; 		
			ТаблицаДокумента.Добавить(Элемент);		
		КонецЕсли; 
	КонецЦикла; 

	Возврат Новый Структура("Объект,ВыбранныеКолонки,СоответствиеПараметров,ТаблицаДокумента,мГрузоперевозки",Объект,СписокВыбранныеКолонки.ВыгрузитьЗначения(),СоответствиеПараметров,ТаблицаДокумента,мГрузоперевозки);
	
КонецФункции

&НаСервере
Процедура ОбновитьЗначенияПараметровнаСервере()
	_УФС.ОбновитьЗначенияПараметровГрузоперевозок(ПолучитьСтруктуруПараметровДляПередачи());	
КонецПроцедуры

#КонецОбласти 

&НаКлиенте
Процедура Услуги_ЗаполнитьПроядокОтражения(Команда)
	Для Каждого Элемент Из Услуги.ПолучитьЭлементы() Цикл
		Если Элемент.Корень Тогда
			Для Каждого Ветвь Из Элемент.ПолучитьЭлементы() Цикл
				Если НЕ Ветвь.Учитывать Тогда Продолжить;КонецЕсли; 
				Ветвь.ПорядокОтражения = ПолучитьПорядокОтражения(Элемент.Номенклатура);
				ЗаполнитьЗначенияСвойств(Ветвь,ПокупательДоговор(Ветвь.Грузоперевозка,Ветвь.ПорядокОтражения,Организация));	
			КонецЦикла; 
		Иначе
			Элемент.ПорядокОтражения = ПолучитьПорядокОтражения(Элемент.Номенклатура);		
			ЗаполнитьЗначенияСвойств(Элемент,ПокупательДоговор(Элемент.Грузоперевозка,Элемент.ПорядокОтражения,Организация));	
		КонецЕсли; 
	КонецЦикла; 
	МожноФормировать();
КонецПроцедуры

&НаКлиенте
Функция ПолучитьПорядокОтражения(Номенклатура)
	Если НЕ ЕстьОграниченияПоСпискуУслуг Тогда
		Возврат ПорядокОтражения;
	КонецЕсли; 
	Нашли = УслугиПоДоговору.НайтиСтроки(Новый Структура("Номенклатура",Номенклатура));
	Если Нашли.Количество() Тогда
		Возврат Нашли[0].ПорядокОтражения;
	Иначе 
		Возврат ПорядокОтражения;
	КонецЕсли; 
КонецФункции

