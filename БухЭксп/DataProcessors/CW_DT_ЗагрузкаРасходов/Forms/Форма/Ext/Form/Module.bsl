КонецПроцедуры

&НаКлиенте
Процедура ГрупповоеРедактирование(Ответ,ДП) Экспорт
	Если НЕ Ответ = Неопределено Тогда
		Для Каждого Стр Из Элементы.Услуги.ВыделенныеСтроки Цикл
			Элемент = Услуги.НайтиПоИдентификатору(Стр);Если НЕ Элемент.Учитывать ИЛИ Элемент.Корень Тогда Продолжить;КонецЕсли; 
			Если Элемент.Ветвь Тогда
				Если Ответ.КоличествоИзм Тогда
					Элемент.Количество = Ответ.Количество;		
				КонецЕсли; 
				Если Ответ.ПорядокОтраженияИзм Тогда
					Элемент.ПорядокОтражения = Ответ.ПорядокОтражения;
					Элемент.Покупатель = Неопределено;
					Элемент.ДоговорПокупателя = Неопределено;		
				КонецЕсли; 
				Если Ответ.ПокупательИзм И Элемент.ПорядокОтражения = ПредопределенноеЗначение("Перечисление.CW_ПорядокОтраженияЗатрат.Перевыставление") Тогда
					Элемент.Покупатель = Ответ.Покупатель;		
				КонецЕсли; 
				Если Ответ.ДоговорПокупателяИзм И Элемент.ПорядокОтражения = ПредопределенноеЗначение("Перечисление.CW_ПорядокОтраженияЗатрат.Перевыставление") Тогда
					Элемент.ДоговорПокупателя = Ответ.ДоговорПокупателя;		
				КонецЕсли; 
			ИначеЕсли НЕ Элемент.Корень Тогда 
				Если Ответ.ПорядокОтраженияИзм Тогда
					Элемент.ПорядокОтражения = Ответ.ПорядокОтражения;		
					Элемент.Покупатель = Неопределено;
					Элемент.ДоговорПокупателя = Неопределено;		
				КонецЕсли; 
				Если Ответ.ПокупательИзм И Элемент.ПорядокОтражения = ПредопределенноеЗначение("Перечисление.CW_ПорядокОтраженияЗатрат.Перевыставление") Тогда
					Элемент.Покупатель = Ответ.Покупатель;		
				КонецЕсли; 
				Если Ответ.ДоговорПокупателяИзм И Элемент.ПорядокОтражения = ПредопределенноеЗначение("Перечисление.CW_ПорядокОтраженияЗатрат.Перевыставление") Тогда
					Элемент.ДоговорПокупателя = Ответ.ДоговорПокупателя;		
				КонецЕсли; 
			КонецЕсли; 
		КонецЦикла; 
		
		//Для Каждого Элемент Из Услуги.ПолучитьЭлементы() Цикл
		//	Если Элемент.Корень Тогда
		//		Для Каждого Ветвь Из Элемент.ПолучитьЭлементы() Цикл
		//			Если НЕ Ветвь.Учитывать Тогда Продолжить;КонецЕсли; 
		//			//Ветвь.ПорядокОтражения = ПолучитьПорядокОтражения(Элемент.Номенклатура);
		//			//ЗаполнитьЗначенияСвойств(Ветвь,ПокупательДоговор(Ветвь.Грузоперевозка,Ветвь.ПорядокОтражения,Организация));	
		//		КонецЦикла; 
		//	Иначе
		//		//Элемент.ПорядокОтражения = ПолучитьПорядокОтражения(Элемент.Номенклатура);		
		//		//ЗаполнитьЗначенияСвойств(Элемент,ПокупательДоговор(Элемент.Грузоперевозка,Элемент.ПорядокОтражения,Организация));	
		//	КонецЕсли; 
		//КонецЦикла; 
	КонецЕсли; 		
КонецПроцедуры

