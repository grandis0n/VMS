&НаСервереБезКонтекста
Функция ПокупательДоговор(Грузоперевозка,ПорядокОтражения,Организация)
	Ответ = Новый Структура("Покупатель,ДоговорПокупателя"); 
	Если ПорядокОтражения	= Перечисления.CW_ПорядокОтраженияЗатрат.Перевыставление И НЕ Грузоперевозка.Пустая() Тогда
		Ответ.Покупатель	= ПокупательПоГрузоперевозке(Грузоперевозка);
		Если НЕ Ответ.Покупатель = Неопределено Тогда
			Ответ.ДоговорПокупателя	= ДоговорГрузоперевозки(Грузоперевозка, Ответ.Покупатель);
			Если Ответ.ДоговорПокупателя = Неопределено Тогда
				Ответ.ДоговорПокупателя = ПоследнийДоговорКонтрагента(Ответ.Покупатель,Организация);
			КонецЕсли; 
		КонецЕсли;
	КонецЕсли;
	Возврат Ответ
КонецФункции

&НаСервереБезКонтекста
Функция ПокупательПоГрузоперевозке(Грузоперевозка)
	Запрос = Новый Запрос;Запрос.Текст = 
		"ВЫБРАТЬ
		|	CW_ХарактеристикиГрузоперевозок.Значение КАК Покупатель
		|ИЗ
		|	Константа.CW_ПараметрПлательщика КАК CW_ПараметрПлательщика,
		|	РегистрСведений.CW_ХарактеристикиГрузоперевозок КАК CW_ХарактеристикиГрузоперевозок
		|ГДЕ
		|	CW_ХарактеристикиГрузоперевозок.Грузоперевозка = &Грузоперевозка
		|	И CW_ХарактеристикиГрузоперевозок.Параметр = CW_ПараметрПлательщика.Значение
		|	И НЕ CW_ПараметрПлательщика.Значение = ЗНАЧЕНИЕ(ПланВидовХарактеристик.CW_ПараметрыГрузоперевозок.)
		|	И НЕ (ВЫРАЗИТЬ(CW_ХарактеристикиГрузоперевозок.Значение КАК Справочник.Контрагенты)) = ЗНАЧЕНИЕ(Справочник.Контрагенты.)";
	Запрос.УстановитьПараметр("Грузоперевозка", Грузоперевозка);
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Запрос = Новый Запрос;Запрос.Текст = 
		"ВЫБРАТЬ
		|	CW_Грузоперевозки.Клиент КАК Клиент
		|ИЗ
		|	Справочник.CW_Грузоперевозки КАК CW_Грузоперевозки
		|ГДЕ
		|	CW_Грузоперевозки.Ссылка = &Ссылка";
		Запрос.УстановитьПараметр("Ссылка", Грузоперевозка);
		Выборка = Запрос.Выполнить().Выбрать();Выборка.Следующий();
		Возврат Выборка.Клиент
	Иначе 
		Выборка = РезультатЗапроса.Выбрать();Выборка.Следующий();
		Возврат Выборка.Покупатель
	КонецЕсли; 
	//Возврат CW_Финансы.ВернутьПлательщика(Новый Структура("Объект,ЭтоВариантБюджета,Контрагент",Грузоперевозка,Ложь,Грузоперевозка.Клиент));
КонецФункции

&НаСервереБезКонтекста
Функция ПоследнийДоговорКонтрагента(Контрагент,Организация)
	Запрос = Новый Запрос;Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	CW_ПоследниеИспользованныеДоговоры.Договор КАК Договор
		|ИЗ
		|	РегистрСведений.CW_ПоследниеИспользованныеДоговоры КАК CW_ПоследниеИспользованныеДоговоры
		|ГДЕ
		|	CW_ПоследниеИспользованныеДоговоры.Контрагент = &Контрагент
		|	И CW_ПоследниеИспользованныеДоговоры.Организация = &Организация
		|	И CW_ПоследниеИспользованныеДоговоры.ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровКонтрагентов.СПокупателем)";
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.УстановитьПараметр("Организация", Организация);
	Выборка = Запрос.Выполнить().Выбрать();Выборка.Следующий();
	Возврат Выборка.Договор
	//Возврат CW_Документы.ПолучитьПоследнийДоговор(Контрагент,Организация,Перечисления.ВидыДоговоровКонтрагентов.СПокупателем)
КонецФункции

&НаСервереБезКонтекста
Функция ДоговорГрузоперевозки(Грузоперевозка,Плательщик)
	Запрос	= Новый Запрос;Запрос.Текст = 
		"ВЫБРАТЬ
		|	CW_ХарактеристикиГрузоперевозок.Значение КАК Значение
		|ИЗ
		|	РегистрСведений.CW_ХарактеристикиГрузоперевозок КАК CW_ХарактеристикиГрузоперевозок,
		|	Константа.CW_ПараметрДоговораПлательщика КАК CW_ПараметрДоговораПлательщика
		|ГДЕ
		|	CW_ХарактеристикиГрузоперевозок.Грузоперевозка = &Грузоперевозка
		|	И CW_ХарактеристикиГрузоперевозок.Параметр = CW_ПараметрДоговораПлательщика.Значение
		|	И ВЫРАЗИТЬ(CW_ХарактеристикиГрузоперевозок.Значение КАК Справочник.CW_ДоговорыПоГрузоперевозкам).Владелец = &Плательщик";
	Запрос.УстановитьПараметр("Грузоперевозка",Грузоперевозка);
	Запрос.УстановитьПараметр("Плательщик",Плательщик);
	РезультатЗапроса = Запрос.Выполнить();
	Если НЕ РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		Возврат Выборка.Значение;
	КонецЕсли; 
КонецФункции

