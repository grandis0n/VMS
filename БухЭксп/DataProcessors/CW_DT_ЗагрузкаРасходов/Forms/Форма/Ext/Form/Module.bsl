&НаКлиенте
Процедура ГрузоперевозкиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	ТД = Элемент.ТекущиеДанные;
	Если Поле.Имя = "ГрузоперевозкиАвтосинхронизация" И ТД.Автосинхронизация Тогда ТД.Автосинхронизация = Ложь;КонецЕсли;
	Если ТД.Автосинхронизация Тогда Возврат 
	ИначеЕсли Поле.Имя = "ГрузоперевозкиДоступенОтбор" И ТД.ДоступенОтбор Тогда
		ОП = Новый ОписаниеОповещения("ОбработкаВыбораИзСписка",ЭтаФорма,ТД); 
		ОткрытьФорму("Справочник.CW_Грузоперевозки.ФормаВыбора",Новый Структура("РежимВыбора,МножественныйВыбор,Отбор",Истина,ТД.ДоступенСписокГрузоперевозок,Новый Структура("Ссылка",ТД.Отбор)),,,,,ОП,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);	
	ИначеЕсли Поле.Имя = "ГрузоперевозкиДоступенСписокГрузоперевозок" Тогда 
		ТД.ДоступенСписокГрузоперевозок = НЕ ТД.ДоступенСписокГрузоперевозок;
		Если ТД.ДоступенСписокГрузоперевозок Тогда
			Если НЕ ТД.Грузоперевозка.Пустая() Тогда
				ТД.СписокГрузоперевозок.Добавить().Грузоперевозка = ТД.Грузоперевозка;
				СписокГрузоперевозок.Добавить().Грузоперевозка = ТД.Грузоперевозка;
			КонецЕсли; 
			ТД.Грузоперевозка = Неопределено;
			//Элементы.ГруппаСписокГрузоперевозокДляБлокировки.Доступность = Истина;
			ОбновитьГрузоперевозкуУслуг(ТД);
		Иначе
			//Элементы.ГруппаСписокГрузоперевозокДляБлокировки.Доступность = Ложь;
			ОбновитьГрузоперевозкуУслуг(ТД);
			ТД.СписокГрузоперевозок.Очистить();
			СписокГрузоперевозок.Очистить();
		КонецЕсли;
	КонецЕсли; 
	МожноФормировать();
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбораИзСписка(Рез,ТД) Экспорт
	Если НЕ Рез = Неопределено Тогда
		Если ТД.ДоступенСписокГрузоперевозок Тогда
