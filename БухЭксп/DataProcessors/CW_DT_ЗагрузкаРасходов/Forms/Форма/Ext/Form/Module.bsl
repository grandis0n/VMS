				Если НЕ ТД.СписокГрузоперевозок.НайтиСтроки(Новый Структура("Грузоперевозка",Стр)).Количество() Тогда
					ТД.СписокГрузоперевозок.Добавить().Грузоперевозка = Стр;		
					СписокГрузоперевозок.Добавить().Грузоперевозка = Стр;		
				КонецЕсли; 
			КонецЦикла; 
			ОбновитьГрузоперевозкуУслуг(ТД);
		Иначе 
			ТД.Грузоперевозка = Рез;
			ОбновитьГрузоперевозкуУслуг(ТД);
		КонецЕсли; 
		МожноФормировать();
	КонецЕсли; 
