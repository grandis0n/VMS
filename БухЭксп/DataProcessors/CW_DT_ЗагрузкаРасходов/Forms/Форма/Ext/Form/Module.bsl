КонецПроцедуры

&НаКлиенте
Процедура ВыборВарианта(Ответ,ДП)Экспорт
	Если НЕ Ответ = Неопределено Тогда
		Пересчитать = Новый Массив;
		Для Каждого Стр Из Элементы.Услуги.ВыделенныеСтроки Цикл
			Элемент = Услуги.НайтиПоИдентификатору(Стр);Если НЕ Элемент.Корень И НЕ Элемент.Ветвь Тогда Возврат;КонецЕсли; 
			Корень = Услуги.НайтиПоИдентификатору(?(Элемент.Корень,Элемент.ПолучитьИдентификатор(),Элемент.ПолучитьРодителя().ПолучитьИдентификатор()));
			Если Пересчитать.Найти(Корень) = Неопределено Тогда Пересчитать.Добавить(Корень);КонецЕсли; 
		КонецЦикла; 
		Для Каждого Корень Из Пересчитать Цикл
			Расчет(Ответ,Корень);	
			РассчитатьКорень(Корень);
			РаспределитьРазницу(Корень);
			РассчитатьКорень(Корень);
		КонецЦикла; 
		МожноФормировать();
		ИтогиСтрокой();
	КонецЕсли; 	
КонецПроцедуры

&НаКлиенте
Процедура УслугиРасчетныеКолонкиПриИзменении(Элемент)
	РассчитатьКорень(Элементы.Услуги.ТекущиеДанные.ПолучитьРодителя()); 
	ИтогиСтрокой();
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьКорень(Корень)
	ЗаполнитьЗначенияСвойств(Корень,Новый Структура("КоличествоВетви,ЦенаВетви,НДСВетви,СуммаВетви,ВсегоВетви",0,0,0,0,0)); 
	Для Каждого Ветвь Из Корень.ПолучитьЭлементы() Цикл
		Если Ветвь.Учитывать Тогда
			Корень.КоличествоВетви	= Корень.КоличествоВетви + Ветвь.Количество;		
			Корень.ЦенаВетви		= Корень.ЦенаВетви + Ветвь.Цена;		
			Корень.СуммаВетви		= Корень.СуммаВетви + Ветвь.Сумма;		
			Корень.НДСВетви			= Корень.НДСВетви + Ветвь.НДС;		
			Корень.ВсегоВетви		= Корень.ВсегоВетви + Ветвь.Всего;		
		КонецЕсли; 
	КонецЦикла; 
КонецПроцедуры

&НаКлиенте
Процедура РаспределитьРазницу(Корень)
	Ветви = Ветви(Корень);
	Если Ветви.Количество() Тогда
		Ветвь = Ветви[Ветви.Количество()-1];	
		Ветвь.Количество= Ветвь.Количество + Корень.Количество - Корень.КоличествоВетви;		
		Ветвь.Сумма		= Ветвь.Сумма + Корень.Сумма - Корень.СуммаВетви;		
		Ветвь.НДС		= Ветвь.НДС + Корень.НДС - Корень.НДСВетви;		
		Ветвь.Всего		= Ветвь.Всего + Корень.Всего - Корень.ВсегоВетви;	
	КонецЕсли; 
КонецПроцедуры

&НаКлиенте
Процедура Расчет(Ответ,Корень)
	
	Ветви = Ветви(Корень);

	// вариант распределения суммы
	// 0 - на все г/п
	// 1 - на каждую г/п
	// 2 - пропорционально параметру
	// 3 - пропорционально выручке
	
	СуммаУслуги			= Корень.Всего;
	ОбратныйПересчет	= Истина;
	
	// распределение по параметру
	Если Ответ.ВариантРаспределения = 2 Тогда 
		Массив = Новый Массив;
		Для Каждого Ветвь Из Ветви Цикл
			Массив.Добавить(Ветвь.Грузоперевозка);
		КонецЦикла;
		
		База = ПолучитьБазуРаспределения(Массив,Ответ.ПараметрРаспределения);
		БазаРаспределенияПоПараметру	= База.БазаРаспределенияПоПараметру;
		СоответствиеЗначенийПараметра	= База.СоответствиеЗначенийПараметра;
		
		Если БазаРаспределенияПоПараметру = 0 Тогда
			СуммаУслуги = 0;
		КонецЕсли; 
	КонецЕсли;
	
	// проверяем вариант распределения
	Если Ответ.ВариантРаспределения = 0 ИЛИ Ответ.ВариантРаспределения = 2 Тогда
		ОстатокРаспределения = СуммаУслуги;
	КонецЕсли; 
	
	Ставка = CW_Финансы.ПолучитьСтавкуНДС(Корень.СтавкаНДС);
	
	// ЗАПОЛНЯЕМ
	Индекс=0;
	Для каждого Ветвь Из Ветви Цикл
		Индекс = Индекс + 1;
		Ветвь.Количество = Корень.Количество;
		
		Если СуммаУслуги Тогда
			// на все г/п
			Если Ответ.ВариантРаспределения = 0 Тогда 
				Если ОбратныйПересчет Тогда
					Ветвь.Всего = СуммаУслуги/Ветви.Количество();
					ОстатокРаспределения = ОстатокРаспределения - Ветвь.Всего;
				Иначе
					Ветвь.Сумма = СуммаУслуги/Ветви.Количество();
					ОстатокРаспределения = ОстатокРаспределения - Ветвь.Сумма;
				КонецЕсли; 
				Ветвь.Количество = Корень.Количество/Ветви.Количество();
				Если Ветви.Количество()=Индекс Тогда
					Если ОбратныйПересчет Тогда
						Ветвь.Всего	= Ветвь.Всего + ОстатокРаспределения;
					Иначе
						Ветвь.Сумма = Ветвь.Сумма + ОстатокРаспределения;	
					КонецЕсли; 
				КонецЕсли; 
			// по параметру
			ИначеЕсли Ответ.ВариантРаспределения = 2 Тогда 
				Если ОбратныйПересчет Тогда
					Ветвь.Всего = СуммаУслуги*СоответствиеЗначенийПараметра.Получить(Ветвь.Грузоперевозка)/БазаРаспределенияПоПараметру;
					ОстатокРаспределения = ОстатокРаспределения - Ветвь.Всего;
				Иначе
					Ветвь.Сумма = СуммаУслуги*СоответствиеЗначенийПараметра.Получить(Ветвь.Грузоперевозка)/БазаРаспределенияПоПараметру;
					ОстатокРаспределения = ОстатокРаспределения - Ветвь.Сумма;
				КонецЕсли; 
				Ветвь.Количество = Корень.Количество*СоответствиеЗначенийПараметра.Получить(Ветвь.Грузоперевозка)/БазаРаспределенияПоПараметру;
				Если Ветви.Количество()=Индекс Тогда
					Если ОбратныйПересчет Тогда
						Ветвь.Всего	= Ветвь.Всего + ОстатокРаспределения;
					Иначе
						Ветвь.Сумма = Ветвь.Сумма + ОстатокРаспределения;	
					КонецЕсли; 
				КонецЕсли; 
			КонецЕсли; 
			Если ОбратныйПересчет Тогда
				Ветвь.НДС 	= Ветвь.Всего*(Ставка/(100+Ставка));
				Ветвь.Сумма = Ветвь.Всего-Ветвь.НДС;
				Ветвь.Цена 	= ?(Ветвь.Количество = 0,0,Ветвь.Сумма/Ветвь.Количество);
			Иначе
				Ветвь.Цена 	= ?(Ветвь.Количество = 0,0,Ветвь.Сумма/Ветвь.Количество);
				Ветвь.НДС 	= Ветвь.Сумма*(Ставка/100);
				Ветвь.Всего = Ветвь.Сумма+Ветвь.НДС;
			КонецЕсли; 
		Иначе ОбнулитьЧисловыеПоказатели(Ветвь);
		КонецЕсли; 
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Функция Ветви(Корень)
	Ветви = Новый Массив;
	Для Каждого Ветвь Из Корень.ПолучитьЭлементы() Цикл
		Если Ветвь.Учитывать Тогда
			Ветви.Добавить(Ветвь);		
		КонецЕсли; 	
	КонецЦикла; 
	Возврат Ветви
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьБазуРаспределения(Грузоперевозки,Параметр)
	СоответствиеЗначенийПараметра	= Новый Соответствие;
	БазаРаспределенияПоПараметру	= 0;
	Запрос = Новый Запрос;Запрос.Текст = 
		"ВЫБРАТЬ
		|	CW_Грузоперевозки.Ссылка КАК Грузоперевозка
		|ПОМЕСТИТЬ ВТ
		|ИЗ
		|	Справочник.CW_Грузоперевозки КАК CW_Грузоперевозки
		|ГДЕ
		|	CW_Грузоперевозки.Ссылка В(&Ссылка)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ.Грузоперевозка КАК Грузоперевозка,
		|	ВЫРАЗИТЬ(ЕСТЬNULL(CW_ХарактеристикиГрузоперевозок.Значение, 0) КАК ЧИСЛО) КАК Значение
		|ИЗ
		|	ВТ КАК ВТ
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.CW_ХарактеристикиГрузоперевозок КАК CW_ХарактеристикиГрузоперевозок
		|		ПО ВТ.Грузоперевозка = CW_ХарактеристикиГрузоперевозок.Грузоперевозка
		|			И (CW_ХарактеристикиГрузоперевозок.Параметр = &Параметр)";
	Запрос.УстановитьПараметр("Ссылка", Грузоперевозки);
	Запрос.УстановитьПараметр("Параметр", Параметр);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СоответствиеЗначенийПараметра.Вставить(Выборка.Грузоперевозка,Выборка.Значение);
		БазаРаспределенияПоПараметру = БазаРаспределенияПоПараметру+Выборка.Значение;
	КонецЦикла;
	Возврат Новый Структура("СоответствиеЗначенийПараметра,БазаРаспределенияПоПараметру",СоответствиеЗначенийПараметра,БазаРаспределенияПоПараметру) 
КонецФункции

&НаКлиенте
Процедура ОбнулитьЧисловыеПоказатели(Элемент)
	ЗаполнитьЗначенияСвойств(Элемент,Новый Структура("Количество,Цена,Сумма,НДС,Всего",0,0,0,0,0));
КонецПроцедуры


#КонецОбласти 

