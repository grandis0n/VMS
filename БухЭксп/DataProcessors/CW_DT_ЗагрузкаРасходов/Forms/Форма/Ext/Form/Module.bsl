&НаКлиенте
Процедура ИтогиСтрокой()
	//ВремяНачала = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Итоги = Новый Структура("Строк,СтрОб,Сумма,НДС,Всего",0,0,0,0,0); 
	Для Каждого Элемент Из Услуги.ПолучитьЭлементы() Цикл
		Если Элемент.Корень Тогда
			Для Каждого Ветвь Из Элемент.ПолучитьЭлементы() Цикл
				Если Ветвь.Учитывать Тогда
					Итоги.СтрОб	= Итоги.СтрОб + 1;	
				КонецЕсли; 
			КонецЦикла; 
		Иначе
			Итоги.СтрОб	= Итоги.СтрОб + 1;	
		КонецЕсли; 
		Итоги.Строк	= Итоги.Строк + 1;	
		Итоги.Сумма	= Итоги.Сумма + Элемент.Сумма;	
		Итоги.НДС	= Итоги.НДС	  + Элемент.НДС;	
		Итоги.Всего	= Итоги.Всего + Элемент.Всего;	
	КонецЦикла; 
	ИтогиПоДокументу	= "Строк: " + Итоги.Строк + "(" + Итоги.СтрОб + ")" + "; Сумма: " + Формат(Итоги.Сумма,"ЧДЦ=2; ЧН=0.00") + "; НДС: " + Формат(Итоги.НДС,"ЧДЦ=2; ЧН=0.00")+ "; Всего: " + Формат(Итоги.Всего,"ЧДЦ=2; ЧН=0.00") + " " + ВалютаСообщения + "; "; 	
	ТекущиеДанные		= Элементы.Услуги.ТекущиеДанные;
	Если ТекущиеДанные	= Неопределено Тогда 
		ИтогиСтрокой	= Новый ФорматированнаяСтрока(ИтогиПоДокументу);
	Иначе
		Если ТекущиеДанные.Корень Тогда
			СтрокаУслуг = ТекущиеДанные;	
		ИначеЕсли ТекущиеДанные.Ветвь Тогда 
			СтрокаУслуг = ТекущиеДанные.ПолучитьРодителя();
		Иначе 
			ИтогиСтрокой = Новый ФорматированнаяСтрока(ИтогиПоДокументу);Возврат;
		КонецЕсли; 

		Отклонения = Новый Структура("Сумма,НДС,Всего",0,0,0);
		
		Для Каждого Показатель Из Отклонения Цикл
			Отклонения[Показатель.Ключ] = СтрокаУслуг[Показатель.Ключ] - СтрокаУслуг[Показатель.Ключ+"Ветви"];	
		КонецЦикла; 
		
		Если Отклонения.Сумма ИЛИ Отклонения.НДС ИЛИ Отклонения.Всего Тогда
			ОтклоненияСтр = "";
			Для Каждого Показатель Из Отклонения Цикл
				Если Показатель.Значение Тогда
					ОтклоненияСтр = ОтклоненияСтр + Показатель.Ключ + ": " + Формат(Показатель.Значение,"ЧДЦ=2") + "; ";	
				КонецЕсли; 	
			КонецЦикла; 
			ИтогиСтрокой = Новый ФорматированнаяСтрока(Новый ФорматированнаяСтрока(ИтогиПоДокументу),Новый ФорматированнаяСтрока("["+ Лев(ОтклоненияСтр,СтрДлина(ОтклоненияСтр)-1)+"]",,WebЦвета.Красный));	
		Иначе
			ИтогиСтрокой = Новый ФорматированнаяСтрока(ИтогиПоДокументу);
		КонецЕсли; 
	КонецЕсли; 
	//Сообщить(ТекущаяУниверсальнаяДатаВМиллисекундах() - ВремяНачала);
КонецПроцедуры

&НаКлиенте
Процедура ВалютаСообщенияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = ложь;
КонецПроцедуры

&НаКлиенте
Процедура СчетСинхронизацияПриИзменении(Элемент)
	ПредставлениеСчета = ПредставлениеСчета(Счет);
	МожноФормировать();
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПредставлениеСчета(Счет)
	Возврат ?(Счет.Пустая(),"к счету <...>","к счету: № "+Счет.НомерСчета + " от " + Формат(Счет.ДатаСчета,"ДФ=dd.MM.yyyy"))		
КонецФункции

&НаКлиенте
Процедура ДоговорСинхронизацияПриИзменении(Элемент)
	Валюта = ВалютаДоговора(Договор);
	УслугиПоДоговру();
	МожноФормировать();
КонецПроцедуры

&НаКлиенте
Процедура УслугиПоДоговру()
	Если Договор.Пустая()Тогда Возврат КонецЕсли; 
	Ответ = СвойстваДоговора(Договор,?(ПредъявленАкт,ДатаАкта,ДатаСчета));
	ЗаполнитьЗначенияСвойств(ЭтаФорма,Ответ,"ЕстьОграниченияПоСпискуУслуг,ПорядокОтражения");	
	УслугиПоДоговору.Очистить();
	Элементы.УникальнаяНоменклатураНоменклатура.СписокВыбора.Очистить();
	Если ЕстьОграниченияПоСпискуУслуг Тогда
		Для Каждого Стр Из Ответ.УслугиПоДоговору Цикл
			ЗаполнитьЗначенияСвойств(УслугиПоДоговору.Добавить(),Стр);
			Элементы.УникальнаяНоменклатураНоменклатура.СписокВыбора.Добавить(Стр.Номенклатура);
		КонецЦикла; 
		Элементы.УникальнаяНоменклатураНоменклатура.РежимВыбораИзСписка 	= Истина;
		Элементы.УникальнаяНоменклатураНоменклатура.ИсторияВыбораПриВводе	= ИсторияВыбораПриВводе.НеИспользовать;
	Иначе	
		Элементы.УникальнаяНоменклатураНоменклатура.РежимВыбораИзСписка 	= Ложь;
		Элементы.УникальнаяНоменклатураНоменклатура.ИсторияВыбораПриВводе	= ИсторияВыбораПриВводе.Авто;
	КонецЕсли; 
КонецПроцедуры

&НаСервереБезКонтекста
Функция СвойстваДоговора(Договор,Дата)
	Ответ	= Новый Структура("ЕстьОграниченияПоСпискуУслуг,ПорядокОтражения,УслугиПоДоговору");
	Запрос	= Новый Запрос;Запрос.Текст = 
		"ВЫБРАТЬ
		|	CW_ДоговорыПоГрузоперевозкам.ОграничиватьНоменклатуру КАК ЕстьОграниченияПоСпискуУслуг,
		|	CW_ПараметрыДоговоровСрезПоследних.ОсновнойПорядокОтраженияРасходов КАК ПорядокОтражения
		|ИЗ
		|	Справочник.CW_ДоговорыПоГрузоперевозкам КАК CW_ДоговорыПоГрузоперевозкам
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.CW_ПараметрыДоговоров.СрезПоследних(&Дата, Договор = &Договор) КАК CW_ПараметрыДоговоровСрезПоследних
		|		ПО CW_ПараметрыДоговоровСрезПоследних.Договор = CW_ДоговорыПоГрузоперевозкам.Ссылка
		|ГДЕ
		|	CW_ДоговорыПоГрузоперевозкам.Ссылка = &Договор";
	Запрос.УстановитьПараметр("Договор", Договор);
	Запрос.УстановитьПараметр("Дата", Дата);
	Выборка = Запрос.Выполнить().Выбрать();Выборка.Следующий();
	ЗаполнитьЗначенияСвойств(Ответ,Выборка);
	Если Выборка.ЕстьОграниченияПоСпискуУслуг Тогда
		Запрос = Новый Запрос;Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	CW_УслугиПоДоговоруГрузоперевозкиСрезПоследних.Договор КАК Договор,
			|	CW_УслугиПоДоговоруГрузоперевозкиСрезПоследних.УслугиПоДоговруГрузоперевозки КАК УслугиПоДоговруГрузоперевозки
			|ПОМЕСТИТЬ ВТ_ТекущийДокумент
			|ИЗ
			|	РегистрСведений.CW_УслугиПоДоговоруГрузоперевозки.СрезПоследних(&Дата, Договор = &Договор) КАК CW_УслугиПоДоговоруГрузоперевозкиСрезПоследних
			|ГДЕ
			|	(CW_УслугиПоДоговоруГрузоперевозкиСрезПоследних.УслугиПоДоговруГрузоперевозки.СрокДействия >= &Дата
			|			ИЛИ CW_УслугиПоДоговоруГрузоперевозкиСрезПоследних.УслугиПоДоговруГрузоперевозки.СрокДействия = ДАТАВРЕМЯ(1, 1, 1))
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	CW_УслугиПоДоговоруГрузоперевозкиНоменклатураПоДоговору.Номенклатура КАК Номенклатура,
			|	МАКСИМУМ(CW_УслугиПоДоговоруГрузоперевозкиНоменклатураПоДоговору.ПорядокОтражения) КАК ПорядокОтражения
			|ИЗ
			|	Документ.CW_УслугиПоДоговоруГрузоперевозки.НоменклатураПоДоговору КАК CW_УслугиПоДоговоруГрузоперевозкиНоменклатураПоДоговору
			|ГДЕ
			|	CW_УслугиПоДоговоруГрузоперевозкиНоменклатураПоДоговору.Ссылка В
			|			(ВЫБРАТЬ
			|				ВТ_ТекущийДокумент.УслугиПоДоговруГрузоперевозки КАК УслугиПоДоговруГрузоперевозки
			|			ИЗ
			|				ВТ_ТекущийДокумент КАК ВТ_ТекущийДокумент)
			|
			|СГРУППИРОВАТЬ ПО
			|	CW_УслугиПоДоговоруГрузоперевозкиНоменклатураПоДоговору.Номенклатура
			|
			|УПОРЯДОЧИТЬ ПО
			|	Номенклатура
			|АВТОУПОРЯДОЧИВАНИЕ";
		Запрос.УстановитьПараметр("Дата",		Дата);
		Запрос.УстановитьПараметр("Договор",	Договор);
		Выборка = Запрос.Выполнить().Выбрать();
		Ответ.УслугиПоДоговору = Новый Массив;
		Пока Выборка.Следующий() Цикл
			Строка = Новый Структура("Номенклатура,ПорядокОтражения");
			ЗаполнитьЗначенияСвойств(Строка,Выборка);
			Ответ.УслугиПоДоговору.Добавить(Строка); 			
		КонецЦикла; 
	КонецЕсли; 
	Возврат Ответ 
КонецФункции


&НаСервере
Процедура ПодобратьГрузоперевозки()
	Для Каждого СтрГрузоперевозки Из Грузоперевозки Цикл
		МассивРеквизитов = Новый Массив;
		МассивПараметров = Новый Массив; 
		СтрокиОтбора	 = СтрГрузоперевозки.Параметры.НайтиСтроки(Новый Структура("Отбор",Истина));
		Если СтрокиОтбора.Количество() Тогда //И НЕ СтрГрузоперевозки.Автосинхронизация
			Для Каждого Парам Из СтрокиОтбора Цикл
				Если ТипЗнч(Парам.Параметр) = Тип("ПланВидовХарактеристикСсылка.CW_ПараметрыГрузоперевозок") Тогда
					МассивПараметров.Добавить(Новый Структура("Параметр,Значение,Идентификатор",Парам.Параметр,Парам.Значение,Парам.Идентификатор)); 		
				Иначе
					МассивРеквизитов.Добавить(Новый Структура("Реквизит,Значение,Идентификатор",XMLстрока(Парам.Параметр),Парам.Значение,Парам.Идентификатор)); 		
				КонецЕсли; 	
			КонецЦикла; 	
		КонецЕсли;
		
		Если МассивРеквизитов.Количество() ИЛИ МассивПараметров.Количество() Тогда
			Запрос = Новый Запрос;
			Подходит = 0;
			Если МассивРеквизитов.Количество() Тогда
				Запрос.Текст = 
				"ВЫБРАТЬ
				|	CW_Грузоперевозки.Ссылка КАК Ссылка,
				|	1 КАК Подходит
				|ПОМЕСТИТЬ ВТ_СсылкаПодхоит
				|ИЗ
				|	Справочник.CW_Грузоперевозки КАК CW_Грузоперевозки
				|ГДЕ";
				Для Каждого Стр Из МассивРеквизитов Цикл
					Запрос.Текст = Запрос.Текст + "
					|	CW_Грузоперевозки." + Стр.Реквизит + " = &Значение" + Стр.Идентификатор;
					Запрос.Параметры.Вставить("Значение" + Стр.Идентификатор,Стр.Значение);
					Подходит = Подходит + 1;
				КонецЦикла;
				Если МассивПараметров.Количество() Тогда
					Для Каждого Стр Из МассивПараметров Цикл
						Запрос.Текст = Запрос.Текст + "
						|
						|ОБЪЕДИНИТЬ ВСЕ
						|
						|ВЫБРАТЬ
						|	CW_ХарактеристикиГрузоперевозок.Грузоперевозка,
						|	1
						|ИЗ
						|	РегистрСведений.CW_ХарактеристикиГрузоперевозок КАК CW_ХарактеристикиГрузоперевозок
						|ГДЕ
						|	CW_ХарактеристикиГрузоперевозок.Параметр = &Параметр" + Стр.Идентификатор + " 
						|	И CW_ХарактеристикиГрузоперевозок.Значение = &Значение" + Стр.Идентификатор;
						Запрос.Параметры.Вставить("Параметр" + Стр.Идентификатор,Стр.Параметр);
						Запрос.Параметры.Вставить("Значение" + Стр.Идентификатор,Стр.Значение);
						Подходит = Подходит + 1;
					КонецЦикла;
				КонецЕсли; 
			Иначе 
				Стр = МассивПараметров[0];
				Запрос.Текст = 
				"ВЫБРАТЬ
				|	CW_ХарактеристикиГрузоперевозок.Грузоперевозка КАК Ссылка,
				|	1 КАК Подходит
				|ПОМЕСТИТЬ ВТ_СсылкаПодхоит
				|ИЗ
				|	РегистрСведений.CW_ХарактеристикиГрузоперевозок КАК CW_ХарактеристикиГрузоперевозок
				|ГДЕ
				|	CW_ХарактеристикиГрузоперевозок.Параметр = &Параметр" + Стр.Идентификатор + " 
				|	И CW_ХарактеристикиГрузоперевозок.Значение = &Значение" + Стр.Идентификатор;
				Запрос.Параметры.Вставить("Параметр" + Стр.Идентификатор,Стр.Параметр);
				Запрос.Параметры.Вставить("Значение" + Стр.Идентификатор,Стр.Значение);
				Подходит = Подходит + 1;
				Для Сч = 1 По МассивПараметров.Количество()-1  Цикл
					Стр = МассивПараметров[Сч];
					Запрос.Текст = Запрос.Текст + "
					|
					|ОБЪЕДИНИТЬ ВСЕ
					|
					|ВЫБРАТЬ
					|	CW_ХарактеристикиГрузоперевозок.Грузоперевозка,
					|	1
					|ИЗ
					|	РегистрСведений.CW_ХарактеристикиГрузоперевозок КАК CW_ХарактеристикиГрузоперевозок
					|ГДЕ
					|	CW_ХарактеристикиГрузоперевозок.Параметр = &Параметр" + Стр.Идентификатор + " 
					|	И CW_ХарактеристикиГрузоперевозок.Значение = &Значение" + Стр.Идентификатор;
					Запрос.Параметры.Вставить("Параметр" + Стр.Идентификатор,Стр.Параметр);
					Запрос.Параметры.Вставить("Значение" + Стр.Идентификатор,Стр.Значение);
					Подходит = Подходит + 1;
				КонецЦикла; 
			КонецЕсли; 
			
			Запрос.Текст = Запрос.Текст + "
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ВТ_СсылкаПодхоит.Ссылка КАК Ссылка,
			|	СУММА(ВТ_СсылкаПодхоит.Подходит) КАК Подходит
			|ИЗ
			|	ВТ_СсылкаПодхоит КАК ВТ_СсылкаПодхоит
			|
			|СГРУППИРОВАТЬ ПО
			|	ВТ_СсылкаПодхоит.Ссылка
			|
			|ИМЕЮЩИЕ
			|	СУММА(ВТ_СсылкаПодхоит.Подходит) = &Подходит";
			Запрос.Параметры.Вставить("Подходит",Подходит);
			СтрГрузоперевозки.Отбор.ЗагрузитьЗначения(Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка"));
			СтрГрузоперевозки.ДоступенОтбор = СтрГрузоперевозки.Отбор.Количество();
			Если СтрГрузоперевозки.Отбор.Количество() = 1 И НЕ СтрГрузоперевозки.Автосинхронизация Тогда СтрГрузоперевозки.Грузоперевозка = СтрГрузоперевозки.Отбор[0].Значение; КонецЕсли; 
		КонецЕсли; 
	КонецЦикла; 			
КонецПроцедуры

#КонецОбласти 

#Область Синхронизация

&НаСервере
Процедура ПолучитьСинхронизацию()
	ПолучитьСсылку(РасходыСсылка,ПрофильОбмена,РасходыИдентификатор,"Документ.CW_РасходыПоГрузоперевозке");	
	ПолучитьСсылку(Договор,ПрофильОбмена,ДоговорИдентификатор,"Справочник.CW_ДоговорыПоГрузоперевозкам");Валюта = ВалютаДоговора(Договор);	
	Если НЕ ПродавецИдентификатор = "" Тогда
		ПолучитьСсылку(Продавец,ПрофильОбмена,ПродавецИдентификатор,"Справочник.Контрагенты");	
	КонецЕсли; 
	Если НЕ СчетИдентификатор = "" Тогда
		ПолучитьСсылку(Счет,ПрофильОбмена,СчетИдентификатор,"Документ.CW_РасходыПоГрузоперевозке");	
	КонецЕсли; 
	Для Каждого Стр Из Грузоперевозки Цикл
		ПолучитьГрузоперевозку(Стр,ПрофильОбмена);	
	КонецЦикла; 
	Для Каждого Стр Из УникальнаяНоменклатура Цикл
		ПолучитьСсылку(Стр.Номенклатура,ПрофильОбмена,Стр.Идентификатор,"Справочник.Номенклатура");Стр.Автосинхронизация = ЗначениеЗаполнено(Стр.Номенклатура);
	КонецЦикла; 
	Если СписокСчетов Тогда
		Для Каждого Стр Из УникальныеСчета Цикл
			ПолучитьСсылку(Стр.Счет,ПрофильОбмена,Стр.Идентификатор,"Документ.CW_РасходыПоГрузоперевозке");Стр.Автосинхронизация = ЗначениеЗаполнено(Стр.Счет);
		КонецЦикла; 
	КонецЕсли; 
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ПолучитьГрузоперевозку(Стр,ПрофильОбмена)
	Если Стр.ДоступенСписокГрузоперевозок ИЛИ НЕ Стр.Грузоперевозка.Пустая() Тогда Возврат КонецЕсли; 
	Запрос = Новый Запрос;Запрос.Текст = 
		"ВЫБРАТЬ
		|	CW_DT_Синхронизация.Ссылка
		|ИЗ
		|	РегистрСведений.CW_DT_Синхронизация КАК CW_DT_Синхронизация
		|ГДЕ
		|	CW_DT_Синхронизация.ПрофильОбмена = &ПрофильОбмена
		|	И CW_DT_Синхронизация.Идентификатор = &Идентификатор
		|	И CW_DT_Синхронизация.ТипМетаданных = &ТипМетаданных";
	Запрос.УстановитьПараметр("ПрофильОбмена",	ПрофильОбмена);
	Запрос.УстановитьПараметр("Идентификатор",	Стр.Идентификатор);
	Запрос.УстановитьПараметр("ТипМетаданных",	CW_Обмены_ПИ.МетаданноеКонфигурации("Справочник.CW_Грузоперевозки"));
	Результат = Запрос.Выполнить();
	Если НЕ Результат.Пустой() Тогда
		Выборка = Результат.Выбрать();
		Если Выборка.Количество() = 1 Тогда
			Если Выборка.Следующий() Тогда
				Стр.Грузоперевозка = Выборка.Ссылка;
				Стр.Автосинхронизация = Истина;
			КонецЕсли 
		Иначе 
			Пока Выборка.Следующий() Цикл
				нСтр = Стр.СписокГрузоперевозок.Добавить();нСтр.Грузоперевозка = Выборка.Ссылка;
			КонецЦикла;
			Стр.ДоступенСписокГрузоперевозок = Истина;
			Стр.Автосинхронизация = Истина;
		КонецЕсли; 
	КонецЕсли; 
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ПолучитьСсылку(Ссылка,ПрофильОбмена,Идентификатор,Тип)
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	CW_DT_Синхронизация.Ссылка
		|ИЗ
		|	РегистрСведений.CW_DT_Синхронизация КАК CW_DT_Синхронизация
		|ГДЕ
		|	CW_DT_Синхронизация.ПрофильОбмена = &ПрофильОбмена
		|	И CW_DT_Синхронизация.Идентификатор = &Идентификатор
		|	И CW_DT_Синхронизация.ТипМетаданных = &ТипМетаданных";
	Запрос.УстановитьПараметр("ПрофильОбмена",ПрофильОбмена);
	Запрос.УстановитьПараметр("Идентификатор",Идентификатор);
	Запрос.УстановитьПараметр("ТипМетаданных",CW_Обмены_ПИ.МетаданноеКонфигурации(Тип));
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Ссылка = Выборка.Ссылка
	КонецЕсли 
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьСинхро(Команда)
	ЗаписатьСинхронизацию()
КонецПроцедуры

&НаСервере
Процедура ЗаписатьСинхронизацию()
	ЗаписатьСсылку(Договор,ПрофильОбмена,ДоговорИдентификатор,"Справочник.CW_ДоговорыПоГрузоперевозкам",ДоговорПредставление);	
	Если НЕ РасходыИдентификатор = ""	Тогда ЗаписатьСсылку(РасходыСсылка,ПрофильОбмена,РасходыИдентификатор,"Документ.CW_РасходыПоГрузоперевозке");КонецЕсли;	
	Если НЕ ПродавецИдентификатор = ""	Тогда ЗаписатьСсылку(Продавец,ПрофильОбмена,ПродавецИдентификатор,"Справочник.Контрагенты",ПродавецПредставление);КонецЕсли; 
	Если НЕ СчетИдентификатор = ""		Тогда ЗаписатьСсылку(Счет,ПрофильОбмена,СчетИдентификатор,"Документ.CW_РасходыПоГрузоперевозке",СчетПредставление);КонецЕсли; 
	Для Каждого Стр Из УникальнаяНоменклатура Цикл
		Если Стр.Автосинхронизация Тогда Продолжить;КонецЕсли; 
		ЗаписатьСсылку(Стр.Номенклатура,ПрофильОбмена,Стр.Идентификатор,"Справочник.Номенклатура",Стр.Представление);	
	КонецЦикла;
	Для Каждого Стр Из Грузоперевозки Цикл
		Если Стр.Автосинхронизация Тогда Продолжить;КонецЕсли; 
		ЗаписатьСсылку(?(Стр.ДоступенСписокГрузоперевозок,Стр.СписокГрузоперевозок.Выгрузить().ВыгрузитьКолонку("Грузоперевозка"),Стр.Грузоперевозка),ПрофильОбмена,Стр.Идентификатор,"Справочник.CW_Грузоперевозки",Стр.Представление);	
	КонецЦикла; 
	Если СписокСчетов Тогда
		Для Каждого Стр Из УникальныеСчета Цикл
			Если Стр.Автосинхронизация Тогда Продолжить;КонецЕсли; 
			ЗаписатьСсылку(Стр.Счет,ПрофильОбмена,Стр.Идентификатор,"Документ.CW_РасходыПоГрузоперевозке",Стр.Представление);	
		КонецЦикла; 	
	КонецЕсли; 
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ЗаписатьСсылку(Ссылка,ПрофильОбмена,Идентификатор,Тип,Представление = "")
	
	ТипМетаданных =  CW_Обмены_ПИ.МетаданноеКонфигурации(Тип);
	
	НЗ = РегистрыСведений.CW_DT_Синхронизация.СоздатьНаборЗаписей();
	НЗ.Отбор.ПрофильОбмена.Установить(ПрофильОбмена);
	НЗ.Отбор.Идентификатор.Установить(Идентификатор);
	НЗ.Отбор.ТипМетаданных.Установить(ТипМетаданных);
	НЗ.Прочитать();
	НЗ.Очистить();
	
	Если ТипЗнч(Ссылка) = Тип("Массив") Тогда
		Для Каждого Стр Из Ссылка Цикл
			Запись = НЗ.Добавить();
			Запись.ПрофильОбмена	= ПрофильОбмена;
			Запись.Идентификатор	= Идентификатор;
			Запись.Ссылка			= Стр;
			Запись.ТипМетаданных	= ТипМетаданных;
			Запись.Представление	= Представление;
		КонецЦикла; 
	ИначеЕсли НЕ Ссылка.Пустая() Тогда  
		Запись = НЗ.Добавить();
		Запись.ПрофильОбмена		= ПрофильОбмена;
		Запись.Идентификатор		= Идентификатор;
		Запись.Ссылка				= Ссылка;
		Запись.ТипМетаданных		= ТипМетаданных;
		Запись.Представление		= Представление;
	КонецЕсли; 
	
	НЗ.Записать(Истина);
	
КонецПроцедуры 


