#Область МожноФормировать

&НаКлиенте
Процедура МожноФормировать()
	
	ЕстьОшибкиСинхронизации();
	ЕстьОшибкиУслуг();
	
	//Отображение
	ЗаголовокГруппаСтраницаОсновное			= "Основное" + ?(ЕстьОшибкиОсновное,"!",".");
	ЗаголовокГруппаСтраницаНоменклатура		= "Номенклатура" + ?(ЕстьОшибкиНоменклатура,"!",".");
	ЗаголовокГруппаСтраницаГрузоперевозки	= "Грузоперевозки" + ?(ЕстьОшибкиГрузоперевозки,"!",".");
	
	//Элементы.ГруппаСтраницаГрузоперевозки.ЦветФона = ?(ЕстьОшибкиГрузоперевозки,Новый Цвет(255,210,200),Новый Цвет(255,255,255));
	
	
	Элементы.ФормаСформировать.Доступность = НЕ (ЕстьОшибкиСинхронизации ИЛИ ЕстьОшибкиУслуг);
	
КонецПроцедуры

&НаКлиенте
Процедура ЕстьОшибкиСинхронизации()
	ЕстьОшибкиОсновное(); 	
	ЕстьОшибкиГрузоперевозки(); 	
	ЕстьОшибкиНоменклатура	= УникальнаяНоменклатура.НайтиСтроки(Новый Структура("Номенклатура",ПредопределенноеЗначение("Справочник.Номенклатура.ПустаяСсылка"))).Количество(); 
	ЕстьОшибкиСинхронизации = ЕстьОшибкиОсновное ИЛИ ЕстьОшибкиГрузоперевозки ИЛИ ЕстьОшибкиНоменклатура;
КонецПроцедуры

&НаКлиенте
Процедура ЕстьОшибкиОсновное()
	ЕстьОшибкиОсновное = Ложь;
	ЕстьОшибкиОсновное = ЕстьОшибкиОсновное ИЛИ Договор.Пустая();
	ЕстьОшибкиОсновное = ЕстьОшибкиОсновное ИЛИ НЕ Валюта = ВалютаСообщения;
	ЕстьОшибкиОсновное = ЕстьОшибкиОсновное ИЛИ УникальныеСчета.НайтиСтроки(Новый Структура("Счет",ПредопределенноеЗначение("Документ.CW_РасходыПоГрузоперевозке.ПустаяСсылка"))).Количество(); 
	Если НЕ ПредъявленСчет И НЕ СписокСчетов Тогда
		ЕстьОшибкиОсновное = ЕстьОшибкиОсновное ИЛИ Счет.Пустая();	
	КонецЕсли; 
	Если НЕ ПродавецИдентификатор = "" Тогда
		ЕстьОшибкиОсновное = ЕстьОшибкиОсновное ИЛИ Продавец.Пустая();	
	КонецЕсли; 
КонецПроцедуры

&НаКлиенте
Процедура ЕстьОшибкиГрузоперевозки()
	ЕстьОшибкиГрузоперевозки = Ложь;
	ЕстьОшибкиГрузоперевозки = Грузоперевозки.НайтиСтроки(Новый Структура("ДоступенСписокГрузоперевозок,Грузоперевозка",Ложь,ПредопределенноеЗначение("Справочник.CW_Грузоперевозки.ПустаяСсылка"))).Количество();	
	Если НЕ ЕстьОшибкиГрузоперевозки Тогда
		Для Каждого Стр Из Грузоперевозки.НайтиСтроки(Новый Структура("ДоступенСписокГрузоперевозок",Истина)) Цикл
			Если НЕ Стр.СписокГрузоперевозок.Количество() Тогда
				ЕстьОшибкиГрузоперевозки = Истина;Прервать;
			КонецЕсли; 		
		КонецЦикла; 	
	КонецЕсли; 
КонецПроцедуры
 
&НаКлиенте
Процедура ЕстьОшибкиУслуг()
	ЕстьОшибкиУслуг = Ложь;
	Для Каждого Элемент Из Услуги.ПолучитьЭлементы() Цикл
		Если Элемент.Корень Тогда
			//ЕстьОшибкиУслуг = ЕстьОшибкиУслуг ИЛИ НЕ Элемент.Количество	= Элемент.КоличествоВетви;
			ЕстьОшибкиУслуг = ЕстьОшибкиУслуг ИЛИ НЕ Элемент.Сумма		= Элемент.СуммаВетви;
			ЕстьОшибкиУслуг = ЕстьОшибкиУслуг ИЛИ НЕ Элемент.НДС		= Элемент.НДСВетви;
			ЕстьОшибкиУслуг = ЕстьОшибкиУслуг ИЛИ НЕ Элемент.Всего		= Элемент.ВсегоВетви;
			Если ЕстьОшибкиУслуг Тогда Прервать;КонецЕсли; 
			Для Каждого Ветвь Из Элемент.ПолучитьЭлементы() Цикл
				Если Ветвь.Учитывать И (Ветвь.ПорядокОтражения.Пустая() ИЛИ (Ветвь.ПорядокОтражения = ПредопределенноеЗначение("Перечисление.CW_ПорядокОтраженияЗатрат.Перевыставление") И Ветвь.ДоговорПокупателя.Пустая())) Тогда
					ЕстьОшибкиУслуг = Истина;Прервать;
				КонецЕсли; 
			КонецЦикла; 
		Иначе 
			Если Элемент.ПорядокОтражения.Пустая() ИЛИ (Элемент.ПорядокОтражения = ПредопределенноеЗначение("Перечисление.CW_ПорядокОтраженияЗатрат.Перевыставление") И Элемент.ДоговорПокупателя.Пустая()) Тогда
				ЕстьОшибкиУслуг = Истина;Прервать;
			КонецЕсли; 
		КонецЕсли; 
	КонецЦикла; 
КонецПроцедуры

#КонецОбласти 

&НаСервере
Процедура НайтиДоговор()
	Если Договор.Пустая() И ЗначениеЗаполнено(ДоговорДата) И ЗначениеЗаполнено(ДоговорДата)  Тогда
		ЗаполнитьЗначенияСвойств(ЭтаФорма,ДоговорПоставщика(Организация,Контрагент,ДоговорНомер,ДоговорДата));	
	КонецЕсли; 	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ДоговорПоставщика(Организация,Контрагент,ДоговорНомер,ДоговорДата)
	Запрос = Новый Запрос;Запрос.Текст = 
		"ВЫБРАТЬ
		|	CW_ДоговорыПоГрузоперевозкам.Ссылка КАК Ссылка,
		|	CW_ДоговорыПоГрузоперевозкам.ВалютаДоговора КАК Валюта
		|ИЗ
		|	Справочник.CW_ДоговорыПоГрузоперевозкам КАК CW_ДоговорыПоГрузоперевозкам
		|ГДЕ
		|	CW_ДоговорыПоГрузоперевозкам.НомерДоговора = &ДоговорНомер
		|	И CW_ДоговорыПоГрузоперевозкам.ДатаДоговора = &ДоговорДата
		|	И CW_ДоговорыПоГрузоперевозкам.Владелец = &Контрагент
		|	И CW_ДоговорыПоГрузоперевозкам.Организация = &Организация
		|	И CW_ДоговорыПоГрузоперевозкам.ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровКонтрагентов.СПоставщиком)";
	Запрос.УстановитьПараметр("ДоговорДата",	ДоговорДата);
	Запрос.УстановитьПараметр("ДоговорНомер",	ДоговорНомер);
	Запрос.УстановитьПараметр("Контрагент",		Контрагент);
	Запрос.УстановитьПараметр("Организация",	Организация);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Количество() = 1 Тогда
		Выборка.Следующий();
		Возврат Новый Структура("Договор,Валюта",Выборка.Ссылка,Выборка.Валюта) 
	Иначе 
		Возврат Новый Структура("Договор,Валюта") 
	КонецЕсли; 	
КонецФункции
 

