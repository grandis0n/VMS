&НаКлиенте
Процедура Сформировать(Команда) Экспорт
	ОП = Новый ОписаниеОповещения("ОтветСформировать",ЭтаФорма); 
	ПоказатьВопрос(ОП,"Сейчас будет " + ?(РасходыСсылка.Пустая(),"сформирован","обновлен") + " документ. Продолжить?",РежимДиалогаВопрос.ДаНет);
КонецПроцедуры

&НаКлиенте
Процедура ОтветСформировать(Ответ,ДП) Экспорт
	Если Ответ = КодВозвратаДиалога.Да Тогда
		Если СформироватьНаСервере() Тогда
			ЗаписатьСинхронизацию();
			Оповестить("CWDT.МенеджерСообщений.ОбновитьВходящие");
			Если Настройка_ОткрыватьСформированныйДокумент Тогда ПоказатьЗначение(,РасходыСсылка);КонецЕсли; 
			Если Настройка_ЗакрыватьОкноПослеФормирования Тогда Закрыть();КонецЕсли; 
		КонецЕсли;
	КонецЕсли; 	
КонецПроцедуры

&НаСервере
Функция СформироватьНаСервере()
	
	Если РасходыСсылка.Пустая() Тогда
		ОБ = Документы.CW_РасходыПоГрузоперевозке.СоздатьДокумент();
		СтатусДокумента = Справочники.CW_СтатусыДокументов.ПолучитьСтатусНовогоОбъекта(Тип("ДокументСсылка.CW_РасходыПоГрузоперевозке"));	
	Иначе
		ОБ = РасходыСсылка.ПолучитьОбъект();
		ЗаполнитьЗначенияСвойств(Об,Документы.CW_РасходыПоГрузоперевозке.СоздатьДокумент(),,"ВедомыйСчет,ВедомыйДокумент,ВедомыйСчетФактура,Ссылка,Номер,Дата,Проведен,ПометкаУдаления");
		ОБ.Услуги.Очистить();
		ОБ.ЗачетАвансов.Очистить();
		ОБ.ЗачетАвансовОЗ.Очистить();
		ОБ.ПлатёжноРасчётныеДокументы.Очистить();
		СтатусДокумента = Неопределено;
	КонецЕсли; 
	
	ОБ.Дата				= ?(ПредъявленАкт,ДатаАкта,ДатаСчета);
	ОБ.Организация		= Организация;
	ОБ.Контрагент		= Контрагент;
	ОБ.Договор			= Договор;
	ОБ.Валюта			= Договор.ВалютаДоговора;
	
	ПД	= _БЭ.ПараметрыДоговора(ОБ.Дата, ОБ.Договор);
	УП	= CW_Настройки.ПараметрыУчетнойПолитики(ОБ.Дата,Организация);
	
	ОБ.СпособЗачетаАвансов		= ПД.ПорядокЗачетаАвансов;
	ОБ.СпособЗачетаАвансовОЗ	= ПД.ПорядокЗачетаАвансовОЗ;
	
	ВестиУчетПоПодразделениям	= Истина;//ПолучитьФункциональнуюОпцию("ВестиУчетПоПодразделениям");
	
	ЗаполнитьЗначенияСвойств(ОБ,ЭтаФорма,"ПредъявленСчет,НомерСчета,ДатаСчета,ПредъявленАкт,НомерАкта,ДатаАкта,ПредъявленСФ,НомерСФ,ДатаСФ,Продавец,Счет,СписокСчетов,ПодразделениеОрганизации");
	
	Для Каждого Элемент Из Услуги.ПолучитьЭлементы() Цикл
		Если НЕ Элемент.Всего Тогда Продолжить; КонецЕсли; 
		Если Элемент.Корень Тогда
			Для Каждого Ветвь Из Элемент.ПолучитьЭлементы() Цикл
				Если НЕ Ветвь.Учитывать Тогда Продолжить;КонецЕсли; 
				нСтр = ОБ.Услуги.Добавить();
				ЗаполнитьЗначенияСвойств(нСтр,Ветвь,,?(Ветвь.ПорядокОтражения = Перечисления.CW_ПорядокОтраженияЗатрат.Затраты,"Покупатель,ДоговорПокупателя",""));
				ЗаполнитьЗначенияСвойств(нСтр,Элемент,"СтавкаНДС,Номенклатура");
				СтатьяЗатратНоменклатуры(нСтр,УП.ОсновнаяСтатьяЗатрат);
				Если ВестиУчетПоПодразделениям И Ветвь.ПорядокОтражения = Перечисления.CW_ПорядокОтраженияЗатрат.Затраты Тогда
					нСтр.Подразделение = ПодразделениеОрганизации;	
				КонецЕсли; 
				Если Настройка_ФормироватьПредставлениеУслуги Тогда
					CW_Шаблоны.УстановитьПредставлениеНоменклатуры(нСтр,ОБ.Договор,ОБ);
				КонецЕсли; 
			КонецЦикла; 
		Иначе
			нСтр = ОБ.Услуги.Добавить();
			ЗаполнитьЗначенияСвойств(нСтр,Элемент,,?(Элемент.ПорядокОтражения = Перечисления.CW_ПорядокОтраженияЗатрат.Затраты,"Покупатель,ДоговорПокупателя",""));
			СтатьяЗатратНоменклатуры(нСтр,УП.ОсновнаяСтатьяЗатрат);
			Если ВестиУчетПоПодразделениям И Элемент.ПорядокОтражения = Перечисления.CW_ПорядокОтраженияЗатрат.Затраты Тогда
				нСтр.Подразделение = ПодразделениеОрганизации;	
			КонецЕсли; 
			Если Настройка_ФормироватьПредставлениеУслуги Тогда
				CW_Шаблоны.УстановитьПредставлениеНоменклатуры(нСтр,ОБ.Договор,ОБ);
			КонецЕсли; 
		КонецЕсли; 
	КонецЦикла; 
	
	ОБ.ДополнительныеСвойства.Вставить("ЗаписьИзТранспортногоСообщения",Истина);
	ОБ.Комментарий = "Документ " + ?(РасходыСсылка.Пустая(),"сформирован","обновлен") + " " +Строка(ТекущаяДата()) + " (" + ТранспортноеСообщение + ")";
	
	Попытка
		ОБ.Записать(?(Настройка_ПроводитьСформированныйДокумент,РежимЗаписиДокумента.Проведение,РежимЗаписиДокумента.Запись));
	Исключение
		Сообщить("Документ не " + ?(РасходыСсылка.Пустая(),"сформирован","обновлен") + "!");
		Возврат Ложь
	КонецПопытки; 
	
	Если РасходыСсылка.Пустая() Тогда РасходыСсылка = ОБ.Ссылка;КонецЕсли; 
	

	//Подсистема.СтатусыДокументов
	//Запишем первый и текущий статус
	ДанныеДляЗаписи = Новый Структура;
	ДанныеДляЗаписи.Вставить("Документ", 		ОБ.Ссылка);
	ДанныеДляЗаписи.Вставить("СтатусДокумента", СтатусДокумента);
	ДанныеДляЗаписи.Вставить("Автор", 			ПараметрыСеанса.ТекущийПользователь);
	
	РегистрыСведений.CW_СтатусыДокументов.ДобавитьЗаписьВРегистр(ДанныеДляЗаписи);
	//Подсистема.СтатусыДокументов
	
	ТС = ТранспортноеСообщение.ПолучитьОбъект();
	ТС.Основания.Очистить();
	ТС.Основания.Добавить().Основание = РасходыСсылка;
	ТС.СостояниеОбмена = Перечисления.CW_DT_СостоянияОбмена.Загружен;
	ТС.Записать();

	Элементы.ФормаСформировать.Заголовок = ?(РасходыСсылка.Пустая(),"Сформировать","Обновить");	
	
	Возврат Истина
	
КонецФункции

&НаСервереБезКонтекста
Процедура СтатьяЗатратНоменклатуры(СтрокаТЧ,ОсновнаяСтатьяЗатрат)
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	CW_СтатьиЗатратНоменклатуры.СтатьяЗатрат
	|ИЗ
	|	РегистрСведений.CW_СтатьиЗатратНоменклатуры КАК CW_СтатьиЗатратНоменклатуры
	|ГДЕ
	|	CW_СтатьиЗатратНоменклатуры.Номенклатура = &Номенклатура";
	Запрос.УстановитьПараметр("Номенклатура", СтрокаТЧ.Номенклатура);
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда 
		СтрокаТЧ.СтатьяЗатрат = ОсновнаяСтатьяЗатрат;
	Иначе 
		Выборка = Результат.Выбрать();Выборка.Следующий();
		СтрокаТЧ.СтатьяЗатрат = Выборка.СтатьяЗатрат;
	КонецЕсли; 
КонецПроцедуры
 
