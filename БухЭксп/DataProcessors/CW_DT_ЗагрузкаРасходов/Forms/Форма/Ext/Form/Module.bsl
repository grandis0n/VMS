КонецПроцедуры

&НаКлиенте
Процедура ОбновитьГрузоперевозкуУслуг(ТекущиеДанные)
	ТекущиеДанные.Ошибка = ?(ТекущиеДанные.ДоступенСписокГрузоперевозок,НЕ ТекущиеДанные.СписокГрузоперевозок.Количество(),ТекущиеДанные.Грузоперевозка.Пустая());
	Для Каждого Стр Из УслугиНайтиСтроки(Новый Структура("Реквизит,Значение","ГрузоперевозкаИдентификатор",ТекущиеДанные.Идентификатор)) Цикл
		Ветви = Стр.ПолучитьЭлементы();Ветви.Очистить();
		Если ТекущиеДанные.ДоступенСписокГрузоперевозок Тогда
			Для Каждого Парам Из СписокВыбранныеКолонки Цикл Стр["_"+Парам.Значение] = Неопределено;КонецЦикла; 
			СтруктураВетви = Новый Структура("Ветвь,Учитывать,ПорядокОтражения",Истина,Истина,ПолучитьПорядокОтражения(Стр.Номенклатура)); 
			ЗаполнитьЗначенияСвойств(Стр,Новый Структура("Корень,Ветвь,ПорядокОтражения,Грузоперевозка,Покупатель,ДоговорПокупателя,КоличествоВетви,ЦенаВетви,НДСВетви,СуммаВетви,ВсегоВетви",Истина,Ложь)); 
			Для Каждого Эл Из ТекущиеДанные.СписокГрузоперевозок Цикл
				Ветвь = Ветви.Добавить();ЗаполнитьЗначенияСвойств(Ветвь,СтруктураВетви);
				Ветвь.Грузоперевозка = Эл.Грузоперевозка;ЗаполнитьЗначенияСвойств(Ветвь,ПокупательДоговор(Ветвь.Грузоперевозка,Ветвь.ПорядокОтражения,Организация));	
			КонецЦикла; 
		Иначе Стр.Грузоперевозка = ТекущиеДанные.Грузоперевозка; 
			Стр.ПорядокОтражения = ?(Стр.ПорядокОтражения.Пустая(),ПолучитьПорядокОтражения(Стр.Номенклатура),Стр.ПорядокОтражения);
			ЗаполнитьЗначенияСвойств(Стр,Новый Структура("Корень,Учитывать,КоличествоВетви,ЦенаВетви,НДСВетви,СуммаВетви,ВсегоВетви",Ложь,Истина)); 
			ЗаполнитьЗначенияСвойств(Стр,ПокупательДоговор(Стр.Грузоперевозка,Стр.ПорядокОтражения,Организация));	
		КонецЕсли; 		
	КонецЦикла;        
	Если ПоказыватьДопКолоноки Тогда
		ОбновитьЗначенияПараметровГрузоперевозок(ТекущиеДанные.Идентификатор);	
	КонецЕсли; 
	ИтогиСтрокой();
КонецПроцедуры
 
&НаКлиенте
Процедура ОбновитьЗначенияУслуг()
	Для Каждого Стр Из Грузоперевозки Цикл
		Стр.Ошибка = Истина;
		Если ЗначениеЗаполнено(Стр.Грузоперевозка) ИЛИ Стр.ДоступенСписокГрузоперевозок Тогда
			ОбновитьГрузоперевозкуУслуг(Стр)	
		КонецЕсли; 	
	КонецЦикла; 	
	Для Каждого Стр Из УникальнаяНоменклатура Цикл
		Если ЗначениеЗаполнено(Стр.Номенклатура) Тогда
			ОбновитьНоменклатуруУслуг(Стр)	
		КонецЕсли; 
	КонецЦикла; 	
	Для Каждого Стр Из УникальныеСчета Цикл
		Если ЗначениеЗаполнено(Стр.Счет) Тогда
			ОбновитьСчетУслуг(Стр)	
		КонецЕсли; 
	КонецЦикла; 	
КонецПроцедуры

