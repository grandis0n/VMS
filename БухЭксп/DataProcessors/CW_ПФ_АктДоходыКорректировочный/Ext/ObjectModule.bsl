			обл = Макет.ПолучитьОбласть("Дополнительно_Рус");
			обл.Параметры.Дополнительно = CW_Шаблоны.ОбработатьШаблонНоменклатуры(ПараметрыДоговора.ДополнениеВШапкеАкта, Ссылка, Неопределено, Ссылка.Услуги);
