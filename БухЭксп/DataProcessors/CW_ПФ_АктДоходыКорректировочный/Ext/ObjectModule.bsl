		тСуммаПрописьюАнгл 	= CW_Печать.СформироватьСуммуПрописьюАнгл(Макс(ИтогоРазницаПоАкту,-ИтогоРазницаПоАкту), Валюта);
	
		СуммаПрописью 		= ?(ИтогоРазницаПоАкту<0,"Минус "+НРег(тСуммаПрописью),		тСуммаПрописью); // ВызовБП
		СуммаПрописьюАнгл	= ?(ИтогоРазницаПоАкту<0,"Minus "+НРег(тСуммаПрописьюАнгл),	тСуммаПрописьюАнгл);
		
