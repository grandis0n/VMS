&НаКлиенте
Процедура СписокПриАктивизацииСтроки(Элемент)
	
	ВыделенныеСтроки = Элементы.Список.ВыделенныеСтроки;
	
	Если ВыделенныеСтроки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	//Убем и з массива группировки
	Для Каждого ЭлементМассива из ВыделенныеСтроки Цикл
		Если ТипЗнч(ЭлементМассива) = Тип("СтрокаГруппировкиДинамическогоСписка") Тогда
			Возврат;
		КонецЕсли;
	КонецЦикла;
	
	ДанныеСтрок = СписокПриАктивизацииСтрокиНаСервере(ВыделенныеСтроки);
	
	ИтогоКоличество = ДанныеСтрок.Количество;
	ИтогоСумма 		= ДанныеСтрок.Сумма;
	
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция СписокПриАктивизацииСтрокиНаСервере(ВыделенныеСтроки)
	
	Результат = новый Структура("Количество,Сумма",0,0);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ CW_ПланированиеДДС.Ссылка) КАК Количество,
	               |	СУММА(CW_ПланированиеДДС.Сумма) КАК Сумма
	               |ИЗ
	               |	Справочник.CW_ПланированиеДДС КАК CW_ПланированиеДДС
	               |ГДЕ
	               |	CW_ПланированиеДДС.Ссылка В(&ВыделенныеСтроки)";
	
	Запрос.УстановитьПараметр("ВыделенныеСтроки", ВыделенныеСтроки);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(Результат, Выборка);
	Конецесли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ПолучитьРазрешенныеСтатусыПланирования()
	
	Результат = Новый Массив;
	Результат.Добавить(ПредопределенноеЗначение("Перечисление.CW_СтатусыПланированияДДС.План"));
	Результат.Добавить(ПредопределенноеЗначение("Перечисление.CW_СтатусыПланированияДДС.Отклонена"));
	Результат.Добавить(ПредопределенноеЗначение("Перечисление.CW_СтатусыПланированияДДС.Согласована"));
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура СформироватьНазначенияПлатежа(Команда)
	
	МассивСтрок = Элементы.Список.ВыделенныеСтроки;
	
	РезультатВыполнения =  СформироватьНазначениеПлатежаВФоне(МассивСтрок);
	
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ВыводитьОкноОжидания = Истина;
	ОповещениеОЗавершении = Новый ОписаниеОповещения("ОбработатьРезультатЗадания", ЭтотОбъект);
	
	ДлительныеОперацииКлиент.ОжидатьЗавершение(РезультатВыполнения, ОповещениеОЗавершении, ПараметрыОжидания);

КонецПроцедуры

&НаСервере
Функция СформироватьНазначениеПлатежаВФоне(МассивСсылок)
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(Новый УникальныйИдентификатор);
	ПараметрыВыполнения.ОжидатьЗавершение 			= 0; // запускать сразу
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = "Заполнение назначения платежа";
	ПараметрыВыполнения.ЗапуститьВФоне 				= Истина;
	ПараметрыВыполнения.ЗапуститьНеВФоне 			= ложь;
	
	ПараметрыПроцедуры = Новый Структура;
	ПараметрыПроцедуры.Вставить("МассивЗаявок", МассивСсылок);
	
	Возврат ДлительныеОперации.ВыполнитьВФоне("Справочники.CW_ПланированиеДДС.ЗаполнитьСодежраниеЗаявкоНаРасход",ПараметрыПроцедуры, ПараметрыВыполнения);
	
КонецФункции

&НаКлиенте
Процедура ОбработатьРезультатЗадания(РезультатВыполнения, Дополнительныепараметры) Экспорт
	
	Если РезультатВыполнения.Статус = "Выполнено" Тогда
		
		Ответ = ПолучитьИзВременногоХранилища(РезультатВыполнения.АдресРезультата);   
		
		ТекстСообщения = "Сформировано назначение платежа для "+Формат(Ответ.ВсегоОбработано,"ЧГ=0")+" из "+Формат(Ответ.ВсегоПередано,"ЧГ=0")+" заявок на расход";
		
		Элементы.Список.Обновить();
		
		ПоказатьОповещениеПользователя("Формирование назначения платежа",,ТекстСообщения,,СтатусОповещенияПользователя.Информация);
	
	ИначеЕсли РезультатВыполнения.Статус = "Ошибка" Тогда
		
		ТекстПредупреждения = "Не удалось сформировать назначение платежа!
		| По причине: "+ РезультатВыполнения.КраткоеПредставлениеОшибки + "
		| Информаиция об ошибке см. в журнале регистрации!";
		
		Если ТипЗнч(РезультатВыполнения.Сообщения) = Тип("Массив") Тогда
			Для Каждого СообщениеВМассиве из РезультатВыполнения.Сообщения Цикл
				СообщениеВМассиве.Сообщить();
			КонецЦикла;
		КонецЕсли;
		
		ПоказатьПредупреждение(,ТекстПредупреждения,,"Ошибка формирования назначения платежа");
	КонецЕсли;
	
КонецПроцедуры  

//Групповое редактирование реквизитов
&НаКлиенте
Процедура ГрупповоеРедактированиеРеквизита(Команда)
	
	// если нет выделенных строк
	ВыделенныеСтроки = Элементы.Список.ВыделенныеСтроки;
	Если ВыделенныеСтроки.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Для группового изменения реквизтов необходимо выделить строки!",10,"Предупреждение");
		Возврат;
	КонецЕсли;    
	
	РедактируемыеРеквизиты = ПолучитьРедактиуемыеРеквизитыОбъекта();
	
	СтруктураПараметров = новый Структура;
	СтруктураПараметров.Вставить("РедактируемыеРеквизиты", РедактируемыеРеквизиты); 
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ВыделенныеСтроки", ВыделенныеСтроки);
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ЗавершитьРедактированиеРеквизитов", ЭтотОбъект, ДополнительныеПараметры);	
	
	ОткрытьФорму("ОбщаяФорма.CW_ГрупповоеИзменениеРеквизитовОбъекта", СтруктураПараметров, ЭтаФорма,,,,ОписаниеОповещения);

КонецПроцедуры   

&НаСервере
Функция ПолучитьРедактиуемыеРеквизитыОбъекта()
	
	Возврат Справочники.CW_ПланированиеДДС.ПолучитьРедактиуемыеРеквизитыОбъекта();
	
КонецФункции

&НаКлиенте
Процедура ЗавершитьРедактированиеРеквизитов(РезультатВыбора, ДополнительныеПараметры) Экспорт
	
	Если РезультатВыбора = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыПроцедуры = Новый Структура;
	ПараметрыПроцедуры.Вставить("Ссылки", 				ДополнительныеПараметры.ВыделенныеСтроки); 
	ПараметрыПроцедуры.Вставить("ЗначенияРеквизитов",	РезультатВыбора);
	
	РезультатВыполнения =  НачатьИзменениеРеквизитовВФоне(ПараметрыПроцедуры);
	
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтаФорма);
	ПараметрыОжидания.ВыводитьОкноОжидания = Истина;
	ОповещениеОЗавершении = Новый ОписаниеОповещения("ЗавершитьФоновоеРедактированиеРеквизитов", ЭтотОбъект, ДополнительныеПараметры);
	
	ДлительныеОперацииКлиент.ОжидатьЗавершение(РезультатВыполнения, ОповещениеОЗавершении, ПараметрыОжидания);

КонецПроцедуры    

&НаСервере
Функция НачатьИзменениеРеквизитовВФоне(ПараметрыПроцедуры)
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(Новый УникальныйИдентификатор);
	ПараметрыВыполнения.ОжидатьЗавершение 			= 0; // запускать сразу
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = "Редактирование реквизитов";
	ПараметрыВыполнения.ЗапуститьВФоне 				= Истина;
	ПараметрыВыполнения.ЗапуститьНеВФоне 			= ложь;
	
	Возврат ДлительныеОперации.ВыполнитьВФоне("Справочники.CW_ПланированиеДДС.ВыполнитьИзменениеРеквитовОбъектов", ПараметрыПроцедуры, ПараметрыВыполнения);
	
КонецФункции 

&НаКлиенте
Процедура ЗавершитьФоновоеРедактированиеРеквизитов(РезультатВыполнения, Дополнительныепараметры) Экспорт
	
	Если РезультатВыполнения.Статус = "Выполнено" Тогда
		
		ОповеститьОбИзменении(Тип("СправочникСсылка.CW_ПланированиеДДС"));
		
	ИначеЕсли РезультатВыполнения.Статус = "Ошибка" Тогда
		
		ТекстПредупреждения = "Не удалось изменить реквизты!
		| По причине: "+ РезультатВыполнения.КраткоеПредставлениеОшибки + "
		| Информаиция об ошибке см. в журнале регистрации!";
		
		Если ТипЗнч(РезультатВыполнения.Сообщения) = Тип("Массив") Тогда
			Для Каждого СообщениеВМассиве из РезультатВыполнения.Сообщения Цикл
				СообщениеВМассиве.Сообщить();
			КонецЦикла;
		КонецЕсли;
		
		ПоказатьПредупреждение(,ТекстПредупреждения,,"Ошибка изменения реквизитов");
	КонецЕсли;
	
КонецПроцедуры
//Групповое редактирование реквизитов

