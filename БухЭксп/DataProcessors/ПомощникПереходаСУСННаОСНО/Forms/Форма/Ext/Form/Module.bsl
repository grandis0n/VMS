	ПараметрыОтбора.Вставить("Дата", Объект.ДатаПерехода + 1);
	ПараметрыОтбора.Вставить("Организация", Объект.Организация);
	ПараметрыОтбора.Вставить("ПометкаУдаления", Ложь);
	
