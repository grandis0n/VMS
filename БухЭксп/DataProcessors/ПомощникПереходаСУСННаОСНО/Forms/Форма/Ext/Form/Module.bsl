	ПараметрыПомощника = Новый Структура;
	ПараметрыПомощника.Вставить("Организация", Объект.Организация);
	ПараметрыПомощника.Вставить("Период", ДатаНачалаПримененияОСНО);
	ПараметрыПомощника.Вставить("ЭтоПереходСУСННаОСНО", Истина);
	ОткрытьФорму("Обработка.ПодготовкаКВычетуНДСУчтенногоВСтоимости.Форма.ОсновнаяФорма", ПараметрыПомощника);
	
