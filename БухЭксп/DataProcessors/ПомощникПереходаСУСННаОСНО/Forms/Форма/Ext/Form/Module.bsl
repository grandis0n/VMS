КонецПроцедуры

&НаКлиенте
Процедура ПодготовитьСообщениеВФНС(Команда)
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Организация", Объект.Организация);
	
	ТекущаяДата = ОбщегоНазначенияКлиент.ДатаСеанса();
	НачалоПримененияЕдиногоУведомления = УчетУСНКлиентСервер.ДатаНачалаПримененияЕдиногоУведомленияУСН();
	ПрименяетсяЕдиноеУведомлениеУСН = ТекущаяДата >= НачалоПримененияЕдиногоУведомления;
	
	Если ПрименяетсяЕдиноеУведомлениеУСН Тогда
		
		ПараметрыЗаполнения = ПараметрыЗаполненияЕдиногоУведомления();
		ПараметрыФормы.Вставить("СформироватьФормуОтчетаАвтоматически", Истина);
		ПараметрыФормы.Вставить("ПараметрыЗаполнения", ПараметрыЗаполнения);
		
		ИмяФормыУведомления = ПолноеИмяФормыУведомления("РегламентированноеУведомлениеУСН");
		ОткрытьФорму(ИмяФормыУведомления, ПараметрыФормы);
		
	Иначе
		
		Если ЭтоВынужденныйПереход Тогда
			ИмяОтчета = "РегламентированноеУведомлениеУтратаПраваУСН";
		Иначе
			ИмяОтчета = "РегламентированноеУведомлениеОтказОтУСН";
		КонецЕсли;
		
		ИмяФормыУведомления = ПолноеИмяФормыУведомления(ИмяОтчета);
		ОткрытьФорму(ИмяФормыУведомления, ПараметрыФормы);
		
	КонецЕсли;
	
КонецПроцедуры

