&НаСервереБезКонтекста
Функция ПолучитьСписокДоступныхРеквизитовГрузоперевозки()
	
	СписокЗначений = Новый СписокЗначений;
	СписокЗначений.Добавить("Код", "Код");
	СписокЗначений.Добавить("Наименование", "Наименование");
	
	стрДоступныеРеквизиты 		= "ДатаСделкиФ,Клиент,Типоразмер,Груз,ОперативныйМенеджер,МенеджерПродаж,Маршрут";
	массивДоступнныхРеквизитов 	= СтрРазделить(стрДоступныеРеквизиты,",", Ложь);
	Реквизиты = Метаданные.Справочники.CW_Грузоперевозки.Реквизиты;
	Для Каждого ИмяРеквизита из массивДоступнныхРеквизитов Цикл
		Реквизит = Реквизиты.Найти(ИмяРеквизита);
		Если Реквизит = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		СписокЗначений.Добавить(Реквизит.Имя, Реквизит.Синоним);
	КонецЦикла;
	
	Возврат СписокЗначений;
	
КонецФункции

