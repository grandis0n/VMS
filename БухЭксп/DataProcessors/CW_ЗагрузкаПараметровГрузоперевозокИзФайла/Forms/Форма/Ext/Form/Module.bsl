&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	УстановитьЗаголовокФормыНаСервере();
	
	Параметры.Свойство("ОбъектОтбора", ЗаказЗаявка);    
	
	ИспользуютсяПараметрыВЗаказах = ПолучитьФункциональнуюОпцию("CW_ИспользуютсяПараметрыВЗаказах");
	
	ТекстНезаполненногоЗаголовкаПарамтера   = "Выбрать параметр";
	ТекстНезаполненногоЗаголовкаДействия 	= "Выбрать действие";
	
	ТОбъект = РеквизитФормыВЗначение("Объект");
	МакетЗаголовка = ТОбъект.ПолучитьМакет("МакетЗаголовка");   
	ОбластьЗаголовок = МакетЗаголовка.ПолучитьОбласть("Заголовок");
	ОбластьЗаголовок.Параметры.ИмяРеквизита 	= ТекстНезаполненногоЗаголовкаПарамтера;
	ОбластьЗаголовок.Параметры.Действие 		= ТекстНезаполненногоЗаголовкаДействия;
	
	ТабличныйДокумент.Вывести(ОбластьЗаголовок); 
	
	Элементы.ЗаказЗаявка.Видимость = ЗначениеЗаполнено(ЗаказЗаявка);
	Элементы.ЗаказЗаявка1.Видимость = ЗначениеЗаполнено(ЗаказЗаявка); 
	
	Элементы.КоманднаяПанельОбъектыЗаписи_1.Видимость = Не ЗначениеЗаполнено(ЗаказЗаявка);	
	Элементы.КоманднаяПанельОбъектыЗаписи_2.Видимость = ЗначениеЗаполнено(ЗаказЗаявка);
	
	ЗашоловокЗаказЗаявка = "";
	Если ТипЗнч(ЗаказЗаявка) = Тип("СправочникСсылка.CW_Заказы") Тогда
		ЗашоловокЗаказЗаявка = "Заказ";
	КонецЕсли;
	Если ТипЗнч(ЗаказЗаявка) = Тип("СправочникСсылка.CW_Заявки") Тогда
		ЗашоловокЗаказЗаявка = "Заявка";
	КонецЕсли;	
	Элементы.ЗаказЗаявка.Заголовок  = ЗашоловокЗаказЗаявка;
	Элементы.ЗаказЗаявка1.Заголовок = ЗашоловокЗаказЗаявка;
	
	РежимПоказать = "Все";  
	
	Элементы.СтраницыШаг1.ТекущаяСтраница = Элементы.СтраницаНачало;  
	
	ПоказатьСкрытьНазначениеПараметров = Ложь;
	ПоказатьСкрытьНазначениеПараметровНаСервере();

КонецПроцедуры 

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ОбработатьШагНаКлиенте("Шаг1");
	
КонецПроцедуры  


&НаСервере
Процедура УстановитьЗаголовокФормыНаСервере(Знач ИмяВыбраннойНастройки="")
	
	Если ПустаяСтрока(ИмяВыбраннойНастройки) Тогда
		ИмяНастройки = "";
	Иначе
		ИмяНастройки = "(" + ИмяВыбраннойНастройки + ")";
	КонецЕсли;
	
	ЭтаФорма.Заголовок = СокрЛП("Загрузка параметров грузоперевозок из файла "+ИмяНастройки);

КонецПроцедуры


//Шаги
&НаКлиенте
Процедура КомандаДалее(Команда)  
	
	ОбработатьШагНаКлиенте("Шаг2"); 
	
	ВключитьОтбор = (РежимПоказать = "НеПодобранные");
	УстановитьОтборСтрок(ВключитьОтбор);
	
КонецПроцедуры   

&НаКлиенте
Процедура КомандаДалееШаг3(Команда)
	
	ОбработатьШагНаКлиенте("Шаг3"); 
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаНазад(Команда) 
	
	ОбработатьШагНаКлиенте("Шаг1");   
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьШагНаКлиенте(ИмяШага) 
	
	Если ИмяШага = "Шаг1" Тогда
		Если ТаблицаСоответствий.Количество() > 0 Тогда
			ПометитьСтрокиТабличногоДокумента();
		КонецЕсли;
	КонецЕсли;
	
	Если ИмяШага = "Шаг2" Тогда 
		ОтметкиЗаполнены = ПроверитьУстановленныеОтметкиНазначенияПараметров();
		Если Не ОтметкиЗаполнены Тогда
			ПоказатьПредупреждение(, "Параметры должны быть записаны хотя бы в один объект!"); 
			ИмяШага = "Шаг1";
			Возврат;
		КонецЕсли;  
		
		ТекстОшибки = ЗаполнитьТаблицуСоответствий();    
		Если Не ПустаяСтрока(ТекстОшибки) Тогда
			ПоказатьПредупреждение(, ТекстОшибки); 
			ИмяШага = "Шаг1"	
		КонецЕсли;
	КонецЕсли;
	
	Если ИмяШага = "Шаг3" Тогда 
		
		УстановитьКартинкуОжиданияПоСтрокам(); 
		
		ПодключитьОбработчикОжидания("ВыполнитьЗагрузкуПараметров",0.1, Истина);
		
	КонецЕсли;  
	
	УстановитьТекущуюСтраницуДляШагаНаСервере(ИмяШага); 
	
	Элементы.КомандаДалееШаг3.Доступность 	= (ИмяШага <> "Шаг4"); 
	
КонецПроцедуры

&НаСервере
Функция УстановитьТекущуюСтраницуДляШагаНаСервере(ИмяШага)
	
	СоответствиеСтраницШагам = ПолучитьСоответствиеСтраницШагам();
	
	Страница = СоответствиеСтраницШагам.Получить(ИмяШага);
	Если Страница = Неопределено Тогда
		ВызватьИсключение "Ошибка!";
	КонецЕсли;
	
	Элементы.Страницы.ТекущаяСтраница = Страница;
	
КонецФункции 

&НаСервере
Функция ПолучитьСоответствиеСтраницШагам() 
	
	Соответствие = новый Соответствие;
	Соответствие.Вставить("Шаг1", Элементы.СтраницаШаг1);
	Соответствие.Вставить("Шаг2", Элементы.СтраницаШаг2); 
	Соответствие.Вставить("Шаг3", Элементы.СтраницаШаг2); 
	Соответствие.Вставить("Шаг4", Элементы.СтраницаШаг2); 
	
	Возврат Соответствие;
	
	
КонецФункции
//Шаги

//Работа с макетом
&НаКлиенте
Процедура ТабличныйДокументВыбор(Элемент, Область, СтандартнаяОбработка)
	
	Если Область.Верх = 1 И Область.Лево <= ТабличныйДокумент.ШиринаТаблицы Тогда
		
		Если ТипЗнч(Область.Расшифровка) = Тип("Структура") Тогда
			Возврат;
		КонецЕсли;    
		
		ОбластьДействие = ТабличныйДокумент.Область(2, Область.Лево, 2, Область.Лево);
		
		ДополнительныеПараметры = Новый Структура("ТекущаяОбласть,ОбластьДействие", Область, ОбластьДействие);
		
		СписокВыбора = Новый СписокЗначений;
		СписокВыбора.Добавить("Реквизит",	"Реквизит грузоперевозки",,БиблиотекаКартинок.Реквизит);
		СписокВыбора.Добавить("Параметр",	"Параметр грузоперевозки",,БиблиотекаКартинок.CW_ПараметрыГрузоперевозок);
		
		Оповещение = Новый ОписаниеОповещения("ЗавершитьВыборТипаДанных", ЭтотОбъект, ДополнительныеПараметры);
		
		ПоказатьВыборИзМеню(Оповещение, СписокВыбора, Элемент); 
		
	КонецЕсли;  
	
	Если Область.Верх = 2 И Область.Лево <= ТабличныйДокумент.ШиринаТаблицы Тогда
		
		ОбластьПараметра = ТабличныйДокумент.Область(1, Область.Лево, 1, Область.Лево);
		Если ОбластьПараметра.Расшифровка = Неопределено Тогда
			Возврат;
		КонецЕсли;
		
		СписокВыбора = Новый СписокЗначений;
		СписокВыбора.Добавить("ПоискПоЗначению",	"Поиск по значению", ,БиблиотекаКартинок.Найти);
		
		Если ОбластьПараметра.Расшифровка.Свойство("Реквизит") Тогда   
			Если ОбластьПараметра.Расшифровка["Идентификатор"] <> "Наименование" 
				и ОбластьПараметра.Расшифровка["Идентификатор"] <> "Код" Тогда
				СписокВыбора.Добавить("ОбновитьЗначение",	"Обновить реквизит", ,БиблиотекаКартинок.Изменить);
			КонецЕсли;
		КонецЕсли;  
		
		Если ОбластьПараметра.Расшифровка.Свойство("Параметр") Тогда
			СписокВыбора.Добавить("ОбновитьЗначение",	"Обновить параметр", ,БиблиотекаКартинок.Изменить);
			СписокВыбора.Добавить("ДобавитьЗначение",	"Добавить параметр", ,БиблиотекаКартинок.СоздатьЭлементСписка);
		КонецЕсли;
		
		ДополнительныеПараметры = Новый Структура("ТекущаяОбласть", Область);
		
		Оповещение = Новый ОписаниеОповещения("ЗавершитьВыборДействия", ЭтотОбъект, ДополнительныеПараметры);
		
		ПоказатьВыборИзМеню(Оповещение,СписокВыбора, Элемент); 
		
	КонецЕсли;
	
КонецПроцедуры   

&НаКлиенте
Процедура ТабличныйДокументОбработкаРасшифровки(Элемент, Расшифровка, СтандартнаяОбработка, ДополнительныеПараметры)
	
	СтандартнаяОбработка = Ложь;    
	Если Элемент.ТекущаяОбласть.Верх > 1 Тогда   
		Возврат;
	КонецЕсли;   
	
	ОбластьДействие = ТабличныйДокумент.Область(2, Элемент.ТекущаяОбласть.Лево, 2, Элемент.ТекущаяОбласть.Лево);
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ТекущаяОбласть", 	Элемент.ТекущаяОбласть); 
	ДополнительныеПараметры.Вставить("ОбластьДействие", ОбластьДействие); 
	
	СписокВыбора = Новый СписокЗначений;
	СписокВыбора.Добавить("Реквизит",	"Реквизит грузоперевозки",,БиблиотекаКартинок.Реквизит);
	СписокВыбора.Добавить("Параметр",	"Параметр грузоперевозки",,БиблиотекаКартинок.CW_ПараметрыГрузоперевозок);
	
	Если Расшифровка.Свойство("Параметр") Тогда
		Если ЭтоКонтрольнаяДата(Расшифровка["Параметр"]["Ссылка"]) Тогда
			СинонимПоля = Расшифровка["Параметр"]["ЗначениеПоля"]["СинонимПоля"];
			ПредставлениеКоманды = "Значение контрольной даты - " + СинонимПоля; 
			
			СписокВыбора.Добавить("ЗначенияПараметра", ПредставлениеКоманды, ,БиблиотекаКартинок.CW_КонтрольныеДаты);	
		КонецЕсли;  
		
		Если ЗначениеПараметраСсылка(Расшифровка["Параметр"]["Ссылка"]) Тогда  
			СинонимПоля = Расшифровка["Параметр"]["ПолеПоиска"]["СинонимПоля"];
			ПредставлениеКоманды = "Реквизит поиска - " + СинонимПоля; 
			
			СписокВыбора.Добавить("ВыборПоляПоискаПараметр",	ПредставлениеКоманды, ,БиблиотекаКартинок.Найти); 
		КонецЕсли;
	КонецЕсли;
	
	Если Расшифровка.Свойство("Реквизит") Тогда     
		
		Если ЭтоСсылка(Расшифровка["Реквизит"]["ИмяРеквизита"]) Тогда 
			СинонимПоля = Расшифровка["Реквизит"]["ПолеПоиска"]["СинонимПоля"];
			ПредставлениеКоманды = "Реквизит поиска - " + СинонимПоля; 
			
			СписокВыбора.Добавить("ВыборПоляПоискаРеквизит",	ПредставлениеКоманды, ,БиблиотекаКартинок.Найти); 
		КонецЕсли;
	КонецЕсли;  
	
	Оповещение = Новый ОписаниеОповещения("ЗавершитьВыборТипаДанных", ЭтотОбъект, ДополнительныеПараметры);
	
	ПоказатьВыборИзМеню(Оповещение, СписокВыбора, Элемент); 
	
КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьВыборТипаДанных(РезультатВыбора, ДополнительныеПараметры) Экспорт
	
	Если РезультатВыбора = Неопределено Тогда
		Возврат;
	КонецЕсли;  
	
	Если ДополнительныеПараметры.Свойство("ОбластьДействие") Тогда
		ДополнительныеПараметры.ОбластьДействие.Расшифровка 		= Неопределено;
		ДополнительныеПараметры.ОбластьДействие.ПараметрРасшифровки	= ""; 
		ДополнительныеПараметры.ОбластьДействие.Текст 				= "Выбрать действие";  
		ДополнительныеПараметры.ОбластьДействие.ЦветТекста			= ОбщегоНазначенияКлиентПовтИсп.ЦветСтиля("НезаполненныйРеквизит")
	КонецЕсли;
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ТабличныйДокументВыборЗавершение", ЭтотОбъект, ДополнительныеПараметры);
	
	Если РезультатВыбора.Значение = "Параметр" Тогда
		ОткрытьФорму("ПланВидовХарактеристик.CW_ПараметрыГрузоперевозок.ФормаВыбора",, ЭтотОбъект,,,, ОписаниеОповещения);
	КонецЕсли; 
	
	Если РезультатВыбора.Значение = "Реквизит" Тогда 
		СписокРеквизитов = ПолучитьСписокДоступныхРеквизитовГрузоперевозки(); 
		СписокРеквизитов.ПоказатьВыборЭлемента(ОписаниеОповещения, "Реквизиты");
	КонецЕсли;    
	
	Если РезультатВыбора.Значение = "ЗначенияПараметра" Тогда 
		
		Расшифровка = ДополнительныеПараметры.ТекущаяОбласть.Расшифровка;
		
		СписокЗначенийПараметра = Новый СписокЗначений;
		СписокЗначенийПараметра.Добавить("ЗначениеПлан",	"План"		, ,	БиблиотекаКартинок.CW_КонтрольныеДаты);
		СписокЗначенийПараметра.Добавить("ЗначениеФакт",	"Факт"		, ,	БиблиотекаКартинок.CW_КалендарьТекущаяДата);
		
		ОписаниеОповещения = Новый ОписаниеОповещения("ЗавершитьВыборЗначенияПарамета", ЭтотОбъект, ДополнительныеПараметры);
		
		ТекущееЗначение 	= Расшифровка["Параметр"]["ЗначениеПоля"]["ИмяПоля"];
		НачальаноеЗначение 	= СписокЗначенийПараметра.НайтиПоЗначению(ТекущееЗначение);
		
		СписокЗначенийПараметра.ПоказатьВыборЭлемента(ОписаниеОповещения,,НачальаноеЗначение);
		
	КонецЕсли;    
	
	Если РезультатВыбора.Значение = "ВыборПоляПоискаРеквизит" Тогда 
		
		Расшифровка 		= ДополнительныеПараметры.ТекущаяОбласть.Расшифровка;
		
		СписокРеквизитов 	= ПолучитьСписокРеквизитовДоступныхДляПоиска(Расшифровка.Идентификатор);
		
		ОписаниеОповещения = Новый ОписаниеОповещения("ЗавершитьВыборПоляПоискаРеквизита", ЭтотОбъект, ДополнительныеПараметры);
		
		ТекущееЗначение 	= Расшифровка["Реквизит"]["ПолеПоиска"]["ИмяПоля"];
		НачальаноеЗначение 	= СписокРеквизитов.НайтиПоЗначению(ТекущееЗначение);
		
		СписокРеквизитов.ПоказатьВыборЭлемента(ОписаниеОповещения,,НачальаноеЗначение); 
		
	КонецЕсли;  
	
	
	Если РезультатВыбора.Значение = "ВыборПоляПоискаПараметр" Тогда 
		
		Расшифровка 		= ДополнительныеПараметры.ТекущаяОбласть.Расшифровка;
		
		СписокРеквизитов 	= ПолучитьСписокРеквизитовПараметраДоступныхДляПоиска(Расшифровка.Идентификатор);
		
		ОписаниеОповещения = Новый ОписаниеОповещения("ЗавершитьВыборПоляПоискаПараметра", ЭтотОбъект, ДополнительныеПараметры);
		
		ТекущееЗначение 	= Расшифровка["Параметр"]["ПолеПоиска"]["ИмяПоля"];
		НачальаноеЗначение 	= СписокРеквизитов.НайтиПоЗначению(ТекущееЗначение);
		
		СписокРеквизитов.ПоказатьВыборЭлемента(ОписаниеОповещения,,НачальаноеЗначение); 
		
	КонецЕсли;  
	
КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьВыборДействия(РезультатВыбора, ДополнительныеПараметры) Экспорт
	Если РезультатВыбора = Неопределено Тогда
		Возврат;
	КонецЕсли;    
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ТабличныйДокументВыборЗавершение", ЭтотОбъект, ДополнительныеПараметры);
	
	СтруктураДействия = Новый Структура;
	СтруктураДействия.Вставить("Значение", 		РезультатВыбора.Значение); 
	СтруктураДействия.Вставить("Представление", РезультатВыбора.Представление); 
	
	ВыполнитьОбработкуОповещения(ОписаниеОповещения, СтруктураДействия);
	
КонецПроцедуры


&НаКлиенте
Процедура ТабличныйДокументВыборЗавершение(РезультатВыбора, ДополнительныеПараметры) Экспорт
	
	Если РезультатВыбора = Неопределено Тогда
		Возврат;
	КонецЕсли;   
	
	Если ТипЗнч(РезультатВыбора) = Тип("ПланВидовХарактеристикСсылка.CW_ПараметрыГрузоперевозок") Тогда
		СтруктураРасшифровки = Новый Структура;
		ЗаполнитьДанныеПараметра(РезультатВыбора, СтруктураРасшифровки);  
	КонецЕсли; 
	
	Если ТипЗнч(РезультатВыбора) = Тип("ЭлементСпискаЗначений") Тогда  
		
		ПолеПоиска = Новый Структура("ИмяПоля,СинонимПоля", "",""); 
		
		Если ЭтоСсылка(РезультатВыбора.Значение) Тогда
			ПолеПоиска.ИмяПоля 		=	"Наименование";
			ПолеПоиска.СинонимПоля	=	"Наименование"; 
		КонецЕсли;    
		
		ПредставлениеЯчейки = СокрЛП(РезультатВыбора.Представление); 
		
		ДанныеРасшифровки = Новый Структура;
		ДанныеРасшифровки.Вставить("ИмяРеквизита",	СокрЛП(РезультатВыбора.Значение));
		ДанныеРасшифровки.Вставить("СинонимПоля", 	СокрЛП(РезультатВыбора.Представление));
		ДанныеРасшифровки.Вставить("ПолеПоиска", 	ПолеПоиска);
		
		СтруктураРасшифровки = Новый Структура;
		СтруктураРасшифровки.Вставить("ПредставлениеЯчейки",	ПредставлениеЯчейки);
		СтруктураРасшифровки.Вставить("Идентификатор", 			СокрЛП(РезультатВыбора.Значение));
		СтруктураРасшифровки.Вставить("Реквизит", 				ДанныеРасшифровки);
		СтруктураРасшифровки.Вставить("ТипЗначения", 			Новый ОписаниеТипов("Строка"));
		
	КонецЕсли;  
	
	Если ТипЗнч(РезультатВыбора) = Тип("Структура") Тогда
		СтруктураРасшифровки = Новый Структура;
		СтруктураРасшифровки.Вставить("ПредставлениеЯчейки",	РезультатВыбора.Представление);
		СтруктураРасшифровки.Вставить("Идентификатор", 			СокрЛП(РезультатВыбора.Значение));
	КонецЕсли;
	
	Если СтруктураРасшифровки = Неопределено Тогда
		Возврат
	КонецЕсли;
	
	УстановитьОформлениеОбласти(СтруктураРасшифровки, ДополнительныеПараметры);
	
	ТабличныйДокументВыборЗавершениеНаСервере(); 
	
КонецПроцедуры 

&НаКлиенте
Процедура ЗавершитьВыборЗначенияПарамета(РезультатВыбора, ДополнительныеПараметры) Экспорт
	
	Если РезультатВыбора = Неопределено Тогда
		Возврат;
	КонецЕсли;   
	
	Расшифровка = ДополнительныеПараметры.ТекущаяОбласть.Расшифровка; 
	Расшифровка.ПредставлениеЯчейки	= СокрЛП(Расшифровка["Параметр"]["СинонимПоля"])+" ("+СокрЛП(РезультатВыбора.Представление)+")";
	
	Расшифровка["Параметр"]["ЗначениеПоля"].ИмяПоля		= СокрЛП(РезультатВыбора.Значение);
	Расшифровка["Параметр"]["ЗначениеПоля"].СинонимПоля	= СокрЛП(РезультатВыбора.Представление);
	
	УстановитьОформлениеОбласти(Расшифровка, ДополнительныеПараметры);
	
	ТабличныйДокументВыборЗавершениеНаСервере();  
	
КонецПроцедуры       

