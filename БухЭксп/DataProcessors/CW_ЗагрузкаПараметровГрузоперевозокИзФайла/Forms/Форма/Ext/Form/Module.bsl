&НаСервере
Процедура ТабличныйДокументВыборЗавершениеНаСервере()
	
	Обработки.CW_ЗагрузкаПараметровГрузоперевозокИзФайла.РассчитатьШиринуКолонокТабличногоДокумента(ТабличныйДокумент);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьОформлениеОбласти(Знач Расшифровка, Знач ДополнительныеПараметры)
	
	ТекстНезаполненногоЗаголовка = ЗагрузкаДанныхИзВнешнихФайловКлиентСервер.ТекстЗаголовкаНесопоставленнойКолонки();
	Для НомерКолонки = 1 По ТабличныйДокумент.ШиринаТаблицы Цикл
		Область = ТабличныйДокумент.Область(1, НомерКолонки);
		Если Область.ПараметрРасшифровки 	= Расшифровка.Идентификатор Тогда
			Область.Текст 					= ТекстНезаполненногоЗаголовка;
			Область.ПараметрРасшифровки 	= "";
			Область.Расшифровка 			= Неопределено;
			Область.ЦветТекста 				= ОбщегоНазначенияКлиентПовтИсп.ЦветСтиля("НезаполненныйРеквизит");
		КонецЕсли;  
	КонецЦикла; 
	
	ДополнительныеПараметры.ТекущаяОбласть.Текст      			= Расшифровка.ПредставлениеЯчейки;
	ДополнительныеПараметры.ТекущаяОбласть.ЦветТекста 			= ОбщегоНазначенияКлиентПовтИсп.ЦветСтиля("ЦветГиперссылки");
	ДополнительныеПараметры.ТекущаяОбласть.ПараметрРасшифровки 	= Расшифровка.Идентификатор;
	ДополнительныеПараметры.ТекущаяОбласть.Расшифровка 			= Расшифровка;
	
	МассивДействий 	= ПолучитьМассивДействийДляУстановкиНазначенияПараметра();
	
	Если ТипЗнч(ДополнительныеПараметры.ТекущаяОбласть.Расшифровка) = Тип("Структура")
		И МассивДействий.Найти(ДополнительныеПараметры.ТекущаяОбласть.ПараметрРасшифровки) <> Неопределено Тогда    
		
		ОбластьДанных = ТабличныйДокумент.Область(1, ДополнительныеПараметры.ТекущаяОбласть.Лево);
		Если ОбластьДанных.Расшифровка.Свойство("Параметр") Тогда
			ДобавитьСтрокуНазначенияПараметра(ОбластьДанных.Расшифровка.Параметр.Ссылка);  
		ИначеЕсли ОбластьДанных.Расшифровка.Свойство("Реквизит") Тогда
			ДобавитьСтрокуНазначенияПараметра(ОбластьДанных.Расшифровка.Реквизит.ИмяРеквизита);  
		КонецЕсли;
		
	КонецЕсли;
	
	ОбновитьНазначенияПараметровНаСервере();
	
КонецПроцедуры  

&НаКлиенте
Процедура УдалитьСтроку(Команда)
	
	Верх = ТабличныйДокумент.ТекущаяОбласть.Верх;
	Низ  = ТабличныйДокумент.ТекущаяОбласть.Низ;
	Лево = ТабличныйДокумент.ТекущаяОбласть.Лево;
	
	Если (Верх = 1 или Верх = 2) И (Низ = 1 или Низ = 2) Тогда
		Возврат; // выделена первая строка (строка заголовка)
	КонецЕсли;
	
	УдалитьСтрокиНаСервере(Верх, Низ);
	Элементы.ТабличныйДокумент.ТекущаяОбласть = ТабличныйДокумент.Область(Верх, Лево);
	
КонецПроцедуры  

&НаКлиенте
Процедура ДобавитьСтроку(Команда)
	
	Верх = ТабличныйДокумент.ТекущаяОбласть.Верх;
	Низ  = ТабличныйДокумент.ТекущаяОбласть.Низ;
	Лево = ТабличныйДокумент.ТекущаяОбласть.Лево;
	
	Если (Верх = 1 или Верх = 2) И (Низ = 1 или Низ = 2) Тогда
		Возврат; // выделена первая строка (строка заголовка)
	КонецЕсли;
	
	ДобавитьСтрокиНаСервере(Верх, Низ);
	Элементы.ТабличныйДокумент.ТекущаяОбласть = ТабличныйДокумент.Область(Верх, Лево); 
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьКолонку(Команда)
	
	Если ТабличныйДокумент.ШиринаТаблицы = 1 Тогда
		Возврат; // выделена первая строка (строка заголовка)
	КонецЕсли;
	
	Лево  = ТабличныйДокумент.ТекущаяОбласть.Лево;
	Право = ТабличныйДокумент.ТекущаяОбласть.Право;
	Верх  = ТабличныйДокумент.ТекущаяОбласть.Верх;
	
	УдалитьКолонкиНаСервере(Лево, Право);
	Элементы.ТабличныйДокумент.ТекущаяОбласть = ТабличныйДокумент.Область(Верх, Лево);
	
КонецПроцедуры  

&НаСервере
Процедура УдалитьСтрокиНаСервере(Верх, Низ)
	
	Если Верх = 1 Тогда
		Верх = 2; // чтобы не удалить заголовки колонок
	КонецЕсли;
	
	Область = ТабличныйДокумент.Область(Верх,, Низ);
	ТабличныйДокумент.УдалитьОбласть(Область, ТипСмещенияТабличногоДокумента.ПоВертикали);
	
КонецПроцедуры 

&НаСервере
Процедура ДобавитьСтрокиНаСервере(Верх, Низ)

	Область = ТабличныйДокумент.Область(Верх,, Низ);
	ТабличныйДокумент.ВставитьОбласть(Область, Область, ТипСмещенияТабличногоДокумента.ПоВертикали);  
	
	ВыделеноСтрок = (Низ - Верх) + 1;
	
	НоваяОбласть = ТабличныйДокумент.Область(Низ+1,, Низ+ВыделеноСтрок);
	НоваяОбласть.Очистить(Истина,Ложь,Ложь);
	
КонецПроцедуры 

&НаКлиенте
Процедура ДобавитьКолонку(Команда)
	Лево  = ТабличныйДокумент.ТекущаяОбласть.Лево;
	Право = ТабличныйДокумент.ТекущаяОбласть.Право;
	Верх  = ТабличныйДокумент.ТекущаяОбласть.Верх;
	
	ДобавитьКолонкиНаСервере(Лево, Право);
	Элементы.ТабличныйДокумент.ТекущаяОбласть = ТабличныйДокумент.Область(Верх, Лево);
КонецПроцедуры

&НаСервере
Процедура ДобавитьКолонкиНаСервере(Лево, Право)
 
	Область = ТабличныйДокумент.Область(, Лево,, Право);
	ТабличныйДокумент.ВставитьОбласть(Область, Область, ТипСмещенияТабличногоДокумента.ПоГоризонтали);
	
	ВыделеноКолонок = (Право - Лево) + 1; 
	ЛевоНовая 		= Лево+1;
	ПравоНовая		= Лево+ВыделеноКолонок;
	
	НоваяОбласть = ТабличныйДокумент.Область(3,ЛевоНовая, ТабличныйДокумент.ВысотаТаблицы, ПравоНовая);
	НоваяОбласть.Очистить(Истина,Ложь,Ложь);

	ТекстНезаполненногоЗаголовкаПарамтера   = "Выбрать параметр";
	ТекстНезаполненногоЗаголовкаДействия 	= "Выбрать действие";
	
	Для Колонка = ЛевоНовая По ПравоНовая Цикл
		Область = ТабличныйДокумент.Область(1, Колонка, 1, Колонка);    
		Область.Текст 				= ТекстНезаполненногоЗаголовкаПарамтера;
		Область.ПараметрРасшифровки = "";
		Область.ЦветТекста 			= ЦветаСтиля.НезаполненныйРеквизит;  
		
		Область = ТабличныйДокумент.Область(2, Колонка, 2, Колонка);    
		Область.Текст 				= ТекстНезаполненногоЗаголовкаДействия;
		Область.ПараметрРасшифровки = "";
		Область.ЦветТекста 			= ЦветаСтиля.НезаполненныйРеквизит;
	КонецЦикла;

	
КонецПроцедуры

&НаСервере
Процедура УдалитьКолонкиНаСервере(Лево, Право)
	
	Область = ТабличныйДокумент.Область(, Лево,, Право);
	ТабличныйДокумент.УдалитьОбласть(Область, ТипСмещенияТабличногоДокумента.ПоГоризонтали);
	
	ОбновитьНазначенияПараметровНаСервере();
	
КонецПроцедуры   

&НаКлиенте
Процедура УстановитьГраницы(Команда)
	
	Лево  = ТабличныйДокумент.ТекущаяОбласть.Лево;
	Право = ТабличныйДокумент.ТекущаяОбласть.Право;
	Верх  = ТабличныйДокумент.ТекущаяОбласть.Верх;
	Низ  = ТабличныйДокумент.ТекущаяОбласть.Низ;
	
	УстановитьГраницыНаСервере(Право, Лево, Верх, Низ);
	
КонецПроцедуры  

&НаКлиенте
Процедура СнятьЗащитуЯчеек(Команда)
	
	Лево  = ТабличныйДокумент.ТекущаяОбласть.Лево;
	Право = ТабличныйДокумент.ТекущаяОбласть.Право;
	Верх  = ТабличныйДокумент.ТекущаяОбласть.Верх;
	Низ  = ТабличныйДокумент.ТекущаяОбласть.Низ;
	
	СнятьЗащитуЯчеекНаСервере(Право, Лево, Верх, Низ);  
	УстановитьГраницыНаСервере(Право, Лево, Верх, Низ);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьГраницыНаСервере(Право, Лево, Верх, Низ)
	
	Линия	 = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная);
	
	Для НомерСтроки = Верх По Низ Цикл
		Для НомерКолонки = Лево По Право Цикл
			Ячейка = ТабличныйДокумент.Область(НомерСтроки, НомерКолонки);
			Ячейка.Обвести(Линия, Линия, Линия, Линия);
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры 

&НаСервере
Процедура СнятьЗащитуЯчеекНаСервере(Право, Лево, Верх, Низ) 
	
	Для НомерСтроки = Верх По Низ Цикл
		Если НомерСтроки < 3 Тогда
			Продолжить;
		КонецЕсли; 
		
		Для НомерКолонки = Лево По Право Цикл
			Ячейка = ТабличныйДокумент.Область(НомерСтроки, НомерКолонки);
			Ячейка.Защита 	= Ложь;
			Ячейка.ЦветФона = ЦветаСтиля.ПравоРедактированияФон
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ПометитьСтрокиТабличногоДокумента()
	
	Для Каждого СтрокаТаблицы из ТаблицаСоответствий Цикл 
		Если СтрокаТаблицы.ФлагПодобрано Тогда
			Продолжить;
		КонецЕсли;
		Область = ТабличныйДокумент.Область(СтрокаТаблицы.СтрокаМакета, , СтрокаТаблицы.СтрокаМакета);
		Область.ЦветТекста = ЦветаСтиля.ЦветОтрицательногоЧисла;	
	КонецЦикла;
	
КонецПроцедуры
//Работа с макетом

//Работа с настройрками
&НаКлиенте
Процедура СохранитьНастройку(Команда)  
	
	СоответствиеНастроек = ПолучитьНастроенныйЗаголовокНаСервере();
	
	ПараметрыФормыВариантов = новый Структура;
	ПараметрыФормыВариантов.Вставить("РежимФормы", 				0);
	ПараметрыФормыВариантов.Вставить("Настройки", 				СоответствиеНастроек);
	
	ОткрытьФорму("Обработка.CW_ЗагрузкаПараметровГрузоперевозокИзФайла.Форма.ФормаВариантовНастроек", ПараметрыФормыВариантов,ЭтаФорма,,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаСервере
Функция ПолучитьНастроенныйЗаголовокНаСервере()
	
	СоответствиеНастроек = новый Соответствие;
	
	Для Лево = 1 по ТабличныйДокумент.ШиринаТаблицы Цикл
		
		Область 		= ТабличныйДокумент.Область(1, Лево);
		ОбластьДействия = ТабличныйДокумент.Область(2, Лево);
		
		СтруктураНастроек = Новый Структура;
		
		ДанныеЯчейки = Новый Структура;
		ДанныеЯчейки.Вставить("Текст", 					Область.Текст);
		ДанныеЯчейки.Вставить("ПараметрРасшифровки", 	Область.ПараметрРасшифровки); 
		ДанныеЯчейки.Вставить("Расшифровка", 			Область.Расшифровка); 
		ДанныеЯчейки.Вставить("ЦветТекста", 			Область.ЦветТекста); 
		
		СтруктураНастроек.Вставить("Заголовок", ДанныеЯчейки);
		
		ДанныеЯчейки = Новый Структура;
		ДанныеЯчейки.Вставить("Текст", 					ОбластьДействия.Текст);
		ДанныеЯчейки.Вставить("ПараметрРасшифровки", 	ОбластьДействия.ПараметрРасшифровки); 
		ДанныеЯчейки.Вставить("Расшифровка", 			ОбластьДействия.Расшифровка); 
		ДанныеЯчейки.Вставить("ЦветТекста", 			ОбластьДействия.ЦветТекста); 
		
		СтруктураНастроек.Вставить("Действия", ДанныеЯчейки);
		
		СоответствиеНастроек.Вставить(Лево, СтруктураНастроек);
	КонецЦикла;  
	
	Соответствие = ПолучитьСоответствиеПоТаблицеНазначений();
	СоответствиеНастроек.Вставить("НазначенияПараметров", Соответствие);
	
	Возврат СоответствиеНастроек;
	
КонецФункции

&НаКлиенте
Процедура ЗагрузитьНастройку(Команда)       
	
	Оповещение = Новый ОписаниеОповещения("ЗавершитьВыборНастроек", ЭтотОбъект);
	
	ПараметрыФормыВариантов = новый Структура;
	ПараметрыФормыВариантов.Вставить("РежимФормы", 1);
	
	ОткрытьФорму("Обработка.CW_ЗагрузкаПараметровГрузоперевозокИзФайла.Форма.ФормаВариантовНастроек", ПараметрыФормыВариантов,ЭтаФорма,,,,Оповещение,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&наКлиенте
Процедура ЗавершитьВыборНастроек(ВыбраннаяНастройка, ДополнительныеПараметры) Экспорт   
	
	Если ВыбраннаяНастройка = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЗавершитьВыборНастроекНаСервере(ВыбраннаяНастройка);	
	
КонецПроцедуры

&НаСервере
Процедура ЗавершитьВыборНастроекНаСервере(ВыбраннаяНастройка)    
	
	УстановитьЗаголовокФормыНаСервере(ВыбраннаяНастройка["ИмяНастройки"]);
	
	СоответствиеНастроек = ВыбраннаяНастройка["Настройка"];
	Если ТипЗнч(СоответствиеНастроек) <> тип("Соответствие") Тогда
		Возврат;
	КонецЕсли;  
	
	СоответствиеНазначения = СоответствиеНастроек.Получить("НазначенияПараметров");
	Для Каждого КлючЗначение из СоответствиеНазначения Цикл 
		НоваяСтрока = НазначенияПараметров.Добавить();
		НоваяСтрока.Параметр 		= КлючЗначение.Ключ;  
		НоваяСтрока.ИндексКартинки 	= ПолучитьИндексКартинкиПараметра(КлючЗначение.Ключ);
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, КлючЗначение.Значение);
	КонецЦикла;
	
	МассивДействийНазначений = ПолучитьМассивДействийДляУстановкиНазначенияПараметра();
	
	Для Лево = 1 по ТабличныйДокумент.ШиринаТаблицы Цикл   
		
		СтруктураНастроек = СоответствиеНастроек.Получить(Лево);
		Если СтруктураНастроек = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ДанныеЗаголовка = СтруктураНастроек.Заголовок;
		
		Область	 = ТабличныйДокумент.Область(1, Лево);
		Область.Текст 				= ДанныеЗаголовка.Текст;
		Область.ПараметрРасшифровки = ДанныеЗаголовка.ПараметрРасшифровки;
		Область.Расшифровка 		= ДанныеЗаголовка.Расшифровка;
		Область.ЦветТекста 			= ДанныеЗаголовка.ЦветТекста;  
		
		ДанныеДействия   = СтруктураНастроек.Действия; 
		
		ОбластьДействия = ТабличныйДокумент.Область(2, Лево);
		ОбластьДействия.Текст 				= ДанныеДействия.Текст;
		ОбластьДействия.ПараметрРасшифровки = ДанныеДействия.ПараметрРасшифровки;
		ОбластьДействия.Расшифровка 		= ДанныеДействия.Расшифровка;
		ОбластьДействия.ЦветТекста 			= ДанныеДействия.ЦветТекста;  
		
	КонецЦикла; 
	
	Обработки.CW_ЗагрузкаПараметровГрузоперевозокИзФайла.РассчитатьШиринуКолонокТабличногоДокумента(ТабличныйДокумент);
	
КонецПроцедуры
