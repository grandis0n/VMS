			ГосКонтракт = Макет.ПолучитьОбласть("ГосКонтракт");
			
			Если ВерсияПостановления1137 >= 5 Тогда
				ГосКонтракт.Параметры.ИдентификаторГосКонтракта = СокрЛП(Ссылка.ИдентификаторГосКонтракта);
			Иначе
				ГосКонтракт.Параметры.ИдентификаторГосКонтракта = "Идентификатор государственного контракта, договора (соглашения)" + 
				?(ДатаСФ >= Дата(2017,10,01)," (при наличии)","") + ": " + СокрЛП(Ссылка.ИдентификаторГосКонтракта);
			КонецЕсли;
			ТабличныйДокумент.Вывести(ГосКонтракт);
		КонецЕсли;	
		
		// Реквизиты Комиссионера
		Если ИспользоватьПостановление1137 И ПараметрыДоговора.ХарактерДоговора = 1 И ЕстьПеревыставление и НЕ ПродавецПоСФСвояОрганизация Тогда
			
			ДопШапка = Макет.ПолучитьОбласть("РеквизитыКомиссионера");
			
			// получаем наш адрес
			Адрес = ПараметрыДоговора.АдресОрганизации;
			Наименование = Ссылка.Организация.НаименованиеСокращенное;
			
			
			КППнаДату = Справочники.Организации.КППНаДату(Ссылка.Организация, Ссылка.ДатаСчетаФактуры);
			
			Если ЗначениеЗаполнено(Ссылка.ПодразделениеОрганизации) Тогда
				Если Ссылка.ПодразделениеОрганизации.ОбособленноеПодразделение Тогда
					КППнаДату = Справочники.ПодразделенияОрганизаций.КППНаДату(Ссылка.ПодразделениеОрганизации, Ссылка.ДатаСчетаФактуры);
				КонецЕсли;
			КонецЕсли;
			
			ИННКПП = Ссылка.Организация.ИНН+?(ЗначениеЗаполнено(КППнаДату),"/"+КППнаДату,"");
			
			Представление = ПараметрыДоговора.ПредставлениеАгентаДляСчетаФактуры;
			Если СокрЛП(Представление) = "" Тогда
				
				Представление = "Составлен комиссионером (агентом)";
				
			КонецЕсли; 
			
			ДопШапка.Параметры.ПредставлениеКомиссионера = Представление+": "+Наименование+", "+Адрес+", ИНН/КПП: "+ИННКПП; 
			
			ТабличныйДокумент.Вывести(ДопШапка);
			
		КонецЕсли;
		
		ШапкаТаблицы = Макет.ПолучитьОбласть("ЗаголовокТаблицы");
		ТабличныйДокумент.Вывести(ШапкаТаблицы);
		
		
		ТаблицаУслугДоИзменения = CW_Финансы.ПолучитьУслугиДокумента(Ссылка.КорректируемыйДокумент);
		ТаблицаУслугДоИзменения.Колонки.Добавить("ПредставлениеГП");
		Для Каждого СтрТУ из ТаблицаУслугДоИзменения Цикл
			СтрТУ.ПредставлениеГП = СокрЛП(СтрТУ.Грузоперевозка.CW_Представление);
		КонецЦикла;	
		
		ТаблицаУслугПослеИзменения = CW_Финансы.ПолучитьУслугиДокументаКорректировки(Ссылка);
		ТаблицаУслугПослеИзменения.Колонки.Добавить("ПредставлениеГП");
		Для Каждого СтрТУ из ТаблицаУслугПослеИзменения Цикл
			СтрТУ.ПредставлениеГП = СокрЛП(СтрТУ.Грузоперевозка.CW_Представление);
		КонецЦикла;
		
		ТЗ_Услуги = ТаблицаУслугДоИзменения.Скопировать();
		ТЗ_УслугиПослеИзменения = ТаблицаУслугПослеИзменения.Скопировать();
		
		_сф.т_ДобавитьКолонку(ТЗ_Услуги,"ПК_Количество",,0);
		_сф.т_ДобавитьКолонку(ТЗ_Услуги,"ПК_Цена",,0);
		_сф.т_ДобавитьКолонку(ТЗ_Услуги,"ПК_Сумма",,0);
		_сф.т_ДобавитьКолонку(ТЗ_Услуги,"ПК_НДС",,0);
		_сф.т_ДобавитьКолонку(ТЗ_Услуги,"ПК_Всего",,0);
		
		_сф.т_ДобавитьКолонку(ТЗ_Услуги,"ПК_Цена_Рег",,0);
		_сф.т_ДобавитьКолонку(ТЗ_Услуги,"ПК_Сумма_Рег",,0);
		_сф.т_ДобавитьКолонку(ТЗ_Услуги,"ПК_НДС_Рег",,0);
		_сф.т_ДобавитьКолонку(ТЗ_Услуги,"ПК_Всего_Рег",,0);
		
		Индекс=0;  
		Для каждого Стр Из ТЗ_УслугиПослеИзменения Цикл
			СтрокаДобавлена = Ложь;
			Попытка
				СтрокаУслуг = ТЗ_Услуги.Получить(Индекс);   
				
				СтрокаУслуг.СтавкаНДС_ДоКорректировки = СтрокаУслуг.СтавкаНДС;	
				СтрокаУслуг.СтавкаНДС = Стр.СтавкаНДС;	
			Исключение
				СтрокаДобавлена = Истина;
				//Строка была добавлена
				СтрокаУслуг = ТЗ_Услуги.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаУслуг, Стр);
			КонецПопытки;
			
			// --- 
			СтрокаУслуг.ПК_Количество = Стр.Количество;
			СтрокаУслуг.ПК_Цена = Стр.Цена;
			СтрокаУслуг.ПК_Сумма = Стр.Сумма;
			СтрокаУслуг.ПК_НДС = Стр.НДС;
			СтрокаУслуг.ПК_Всего = Стр.Всего;
			// --- 
			СтрокаУслуг.ПК_Цена_Рег = Стр.Цена_Рег;
			СтрокаУслуг.ПК_Сумма_Рег = Стр.Сумма_Рег;
			СтрокаУслуг.ПК_НДС_Рег = Стр.НДС_Рег;
			СтрокаУслуг.ПК_Всего_Рег = Стр.Всего_Рег;
			// --- 
			
			Если СтрокаДобавлена Тогда
				СтрокаУслуг.Количество 	= 0;
				СтрокаУслуг.Цена		= 0;
				СтрокаУслуг.Сумма		= 0;
				СтрокаУслуг.НДС			= 0;
				СтрокаУслуг.Всего		= 0;
			КонецЕсли;
			
			_сф.Инкремент(Индекс);
			
		КонецЦикла;
		
		Если ЗначениеЗаполнено(ПараметрыДоговора.ВариантСверткиНоменклатурыДляСФ) И ПараметрыДоговора.ВариантСверткиНоменклатурыДляСФ.СворачиватьПоГрузоперевозкам Тогда
			
			ТЗ_УслугиСвернутые  = ТЗ_Услуги.СкопироватьКолонки();
			// --- 
			ТЗ_ГП  = ТЗ_Услуги.Скопировать();
			ТЗ_ГП.Свернуть("ПредставлениеГП");
			ТЗ_ГП.Колонки.Добавить("Представление");
			ТЗ_ГП.Колонки.Добавить("НомСтр");
			ТЗ_ГП.Колонки.Добавить("Итого");
			НомСтр = 0;
			Для Каждого Стр_ГП из ТЗ_ГП Цикл
				
				ТЗ_Отбор = ТЗ_Услуги.Скопировать(Новый Структура("ПредставлениеГП", Стр_ГП.ПредставлениеГП));
				
				Если ПараметрыДоговора.ЯзыкПечатиДокументов = 1 Тогда 
					Стр_ГП.Представление = CW_Шаблоны.ОбработатьШаблонНоменклатуры(ПараметрыДоговора.ВариантСверткиНоменклатурыДляСФ.ШаблонСверткиПоГрузоперевозкамАнгл, Ссылка, Неопределено, ТЗ_Отбор);
				ИначеЕсли ПараметрыДоговора.ЯзыкПечатиДокументов = 2 Тогда 
					Стр_ГП.Представление = CW_Шаблоны.ОбработатьШаблонНоменклатуры(ПараметрыДоговора.ВариантСверткиНоменклатурыДляСФ.ШаблонСверткиПоГрузоперевозкам, Ссылка, Неопределено, ТЗ_Отбор) + " / " + CW_Шаблоны.ОбработатьШаблонНоменклатуры(ПараметрыДоговора.ВариантСверткиНоменклатурыДляСФ.ШаблонСверткиПоГрузоперевозкамАнгл, Ссылка, Неопределено, ТЗ_Отбор);
				Иначе 
					Стр_ГП.Представление = CW_Шаблоны.ОбработатьШаблонНоменклатуры(ПараметрыДоговора.ВариантСверткиНоменклатурыДляСФ.ШаблонСверткиПоГрузоперевозкам, Ссылка, Неопределено, ТЗ_Отбор);
				КонецЕсли;
				Стр_ГП.НомСтр = НомСтр;
				Стр_ГП.Итого  = ТЗ_Отбор.Итог("Всего");
				
				CW_Печать.ПодготовитьТаблицуУслуг(ТЗ_Отбор, Ссылка, ПараметрыДоговора, "сф",Истина);
				Для Каждого Стр_Отбор из ТЗ_Отбор Цикл
					Стр_Ит = ТЗ_УслугиСвернутые.Добавить();
					ЗаполнитьЗначенияСвойств(Стр_Ит, Стр_Отбор);
				КонецЦикла;	
				НомСтр = НомСтр + 1 + ТЗ_Отбор.Количество();
				
			КонецЦикла;
			ТЗ_Услуги = ТЗ_УслугиСвернутые.Скопировать();
			
		Иначе
			
			CW_Печать.ПодготовитьТаблицуУслуг(ТЗ_Услуги,Ссылка,ПараметрыДоговора,"сф",Истина);
			
		КонецЕсли;	
		
		// убираем строки в которых не было изменений 
		мас = Новый Массив;
		Для Каждого Стр из ТЗ_Услуги Цикл
			Если Стр.Сумма = Стр.ПК_Сумма И Стр.НДС = Стр.ПК_НДС И Стр.Всего = Стр.ПК_Всего Тогда 
				мас.Добавить(Стр);	
			КонецЕсли;	
		КонецЦикла;	
		_сф.к_УдалитьЭлементыПоМассиву(ТЗ_Услуги, мас);
		
		ВсегоСтрокДляВывода = ТЗ_Услуги.Количество();				
		Кол = 1;
		
		// механизм вывода
		НомСтрГП = 0;
		РасчетыУЕ = Ссылка.ВедомыйДокументКорректировки.ДоговорКонтрагента.РасчетыВУсловныхЕдиницах;
		
		СтрокаТаблицы = Макет.ПолучитьОбласть("Строка");
		ПодвалТаблицы = Макет.ПолучитьОбласть("Итого");
		
		Увеличение_Сумма = 0;
		Уменьшение_Сумма = 0;
		Увеличение_НДС = 0;
		Уменьшение_НДС = 0;
		Увеличение_Всего = 0;
		Уменьшение_Всего = 0;
		
		Для каждого СтрокаУслуги Из ТЗ_Услуги Цикл
			
			Если ЕстьНомерСтроки тогда
				СтрокаТаблицы.Параметры.НомерСтроки = СтрокаУслуги.НомерСтроки;
			КонецЕсли;				
			
			СтрокаТаблицы.Параметры.НаименованиеНоменклатуры = СтрокаУслуги.Представление;
			Если СокрЛП(СтрокаУслуги.Номенклатура.ЕдиницаИзмерения.Наименование) = "-"
				ИЛИ Не ЗначениеЗаполнено(СтрокаУслуги.Номенклатура.ЕдиницаИзмерения) Тогда
				
				СтрокаТаблицы.Параметры.НаименованиеЕдиницыИзмерения = "--";
				СтрокаТаблицы.Параметры.ЕдиницаИзмеренияКод = "--";
				СтрокаТаблицы.Параметры.КоличествоДоИзменения = "--";
				СтрокаТаблицы.Параметры.КоличествоПослеИзменения = "--";
				СтрокаТаблицы.Параметры.ЦенаДоИзменения = "--";
				СтрокаТаблицы.Параметры.ЦенаПослеИзменения = "--";
				
			Иначе
				
				СтрокаТаблицы.Параметры.НаименованиеЕдиницыИзмерения = СтрокаУслуги.Номенклатура.ЕдиницаИзмерения;
				СтрокаТаблицы.Параметры.ЕдиницаИзмеренияКод = ?(ЗначениеЗаполнено(СтрокаУслуги.Номенклатура.ЕдиницаИзмерения.Код) , СтрокаУслуги.Номенклатура.ЕдиницаИзмерения.Код, "--");
				// --- 
				СтрокаТаблицы.Параметры.КоличествоДоИзменения = СтрокаУслуги.Количество;
				СтрокаТаблицы.Параметры.ЦенаДоИзменения = ?(РасчетыУЕ, СтрокаУслуги.Цена_Рег, СтрокаУслуги.Цена);
				// --- 
				СтрокаТаблицы.Параметры.КоличествоПослеИзменения = СтрокаУслуги.ПК_Количество;
				СтрокаТаблицы.Параметры.ЦенаПослеИзменения =?(РасчетыУЕ, СтрокаУслуги.ПК_Цена_Рег, СтрокаУслуги.ПК_Цена);
				
			КонецЕсли; 
			
			Если ВерсияПостановления1137 >= 5 Тогда
				ТоварКодТНВЭД = ?(ЗначениеЗаполнено(СтрокаУслуги.Номенклатура.КодТНВЭД), СтрокаУслуги.Номенклатура.КодТНВЭД, "--");
				
				СтрокаТаблицы.Параметры.ТоварКодТНВЭДДоИзменения =  ТоварКодТНВЭД;
				СтрокаТаблицы.Параметры.ТоварКодТНВЭД            =  ТоварКодТНВЭД;
			КонецЕсли;
			
			СтрокаТаблицы.Параметры.СтоимостьБезНДСДоИзменения = ?(РасчетыУЕ, СтрокаУслуги.Сумма_Рег, СтрокаУслуги.Сумма);
			СтрокаТаблицы.Параметры.СтоимостьБезНДСПослеИзменения = ?(РасчетыУЕ, СтрокаУслуги.ПК_Сумма_Рег, СтрокаУслуги.ПК_Сумма);
			Дельта = СтрокаТаблицы.Параметры.СтоимостьБезНДСПослеИзменения - СтрокаТаблицы.Параметры.СтоимостьБезНДСДоИзменения;
			Если (Дельта > 0) Тогда
				СтрокаТаблицы.Параметры.РазницаБезНДСУвеличение = Дельта;
				СтрокаТаблицы.Параметры.РазницаБезНДСУменьшение = 0;
				_сф.Инкремент(Увеличение_Сумма,Дельта);
			ИначеЕсли (Дельта < 0) Тогда 
				СтрокаТаблицы.Параметры.РазницаБезНДСУвеличение = 0;
				СтрокаТаблицы.Параметры.РазницаБезНДСУменьшение = -Дельта;
				_сф.Инкремент(Уменьшение_Сумма,-Дельта);
			КонецЕсли; 
			
			СтрокаТаблицы.Параметры.СтавкаНДС 				= ?(СтрокаУслуги.СтавкаНДС = Перечисления.СтавкиНДС.БезНДС, "БЕЗ НДС", СтрокаУслуги.СтавкаНДС);
			СтрокаТаблицы.Параметры.СтавкаНДСДоИзменения 	= ?(СтрокаУслуги.СтавкаНДС_ДоКорректировки = Перечисления.СтавкиНДС.БезНДС, "БЕЗ НДС", СтрокаУслуги.СтавкаНДС_ДоКорректировки);
			
			СтрокаТаблицы.Параметры.СуммаНДСДоИзменения 		= ?(СтрокаУслуги.СтавкаНДС = Перечисления.СтавкиНДС.БезНДС, "БЕЗ НДС", ?(РасчетыУЕ, СтрокаУслуги.НДС_Рег, СтрокаУслуги.НДС));
			СтрокаТаблицы.Параметры.СуммаНДСПослеИзменения 		= ?(СтрокаУслуги.СтавкаНДС = Перечисления.СтавкиНДС.БезНДС, "БЕЗ НДС", ?(РасчетыУЕ, СтрокаУслуги.ПК_НДС_Рег, СтрокаУслуги.ПК_НДС));
			Если (СтрокаТаблицы.Параметры.СуммаНДСДоИзменения 	= "БЕЗ НДС" ИЛИ СтрокаТаблицы.Параметры.СуммаНДСПослеИзменения = "БЕЗ НДС") Тогда
				Дельта = 0;
			Иначе
				Дельта = СтрокаТаблицы.Параметры.СуммаНДСПослеИзменения - СтрокаТаблицы.Параметры.СуммаНДСДоИзменения;
			КонецЕсли; 
			Если (Дельта > 0) Тогда
				СтрокаТаблицы.Параметры.РазницаНДСУвеличение = Дельта;
				СтрокаТаблицы.Параметры.РазницаНДСУменьшение = 0;
				_сф.Инкремент(Увеличение_НДС,Дельта);
			ИначеЕсли (Дельта < 0) Тогда 
				СтрокаТаблицы.Параметры.РазницаНДСУвеличение = 0;
				СтрокаТаблицы.Параметры.РазницаНДСУменьшение = -Дельта;
				_сф.Инкремент(Уменьшение_НДС,-Дельта);
			Иначе
				СтрокаТаблицы.Параметры.РазницаНДСУвеличение = 0;
				СтрокаТаблицы.Параметры.РазницаНДСУвеличение = 0;
			КонецЕсли;
			
			СтрокаТаблицы.Параметры.СтоимостьСНДСДоИзменения = ?(РасчетыУЕ, СтрокаУслуги.Всего_Рег, СтрокаУслуги.Всего);
			СтрокаТаблицы.Параметры.СтоимостьСНДСПослеИзменения = ?(РасчетыУЕ, СтрокаУслуги.ПК_Всего_Рег, СтрокаУслуги.ПК_Всего);
			Дельта = СтрокаТаблицы.Параметры.СтоимостьСНДСПослеИзменения - СтрокаТаблицы.Параметры.СтоимостьСНДСДоИзменения;
			Если (Дельта > 0) Тогда
				СтрокаТаблицы.Параметры.РазницаСНДСУвеличение = Дельта;
				СтрокаТаблицы.Параметры.РазницаСНДСУменьшение = 0;
				_сф.Инкремент(Увеличение_Всего,Дельта);
			ИначеЕсли (Дельта < 0) Тогда 
				СтрокаТаблицы.Параметры.РазницаСНДСУвеличение = 0;
				СтрокаТаблицы.Параметры.РазницаСНДСУменьшение = -Дельта;
				_сф.Инкремент(Уменьшение_Всего,-Дельта);
			КонецЕсли;
			
			Если (СтрокаУслуги.СтавкаНДС <> Перечисления.СтавкиНДС.БезНДС) Тогда
				ТолькоБезНДС = Ложь;
			КонецЕсли; 
			
			Выводимыеобласти = Новый Массив;
			Выводимыеобласти.Добавить(СтрокаТаблицы);
			
			Кол = Кол + 1;
			
			// Если обрабатываемая строка - последняя, будем проверять, помещается ли подвал документа
			Если ТЗ_Услуги.Индекс(СтрокаУслуги) = ТЗ_Услуги.Количество() - 1 Тогда 
				Выводимыеобласти.Добавить(ПодвалТаблицы);
				Выводимыеобласти.Добавить(Подписи);
			КонецЕсли;
			
			Если НЕ ОбщегоНазначения.ПроверитьВыводТабличногоДокумента(ТабличныйДокумент, Выводимыеобласти) Тогда
				ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
				ТабличныйДокумент.Вывести(ШапкаТаблицы);
			КонецЕсли;
			
			ТабличныйДокумент.Вывести(СтрокаТаблицы);
		КонецЦикла; // обход строк документа
		
		ПодвалТаблицы.Параметры.РазницаБезНДСУвеличение = Увеличение_Сумма;
		ПодвалТаблицы.Параметры.РазницаБезНДСУменьшение = Уменьшение_Сумма;
		ПодвалТаблицы.Параметры.РазницаНДСУвеличение = Увеличение_НДС;
		ПодвалТаблицы.Параметры.РазницаНДСУменьшение = Уменьшение_НДС;
		ПодвалТаблицы.Параметры.РазницаСНДСУвеличение = Увеличение_Всего;
		ПодвалТаблицы.Параметры.РазницаСНДСУменьшение = Уменьшение_Всего;
		
		ТабличныйДокумент.Вывести(ПодвалТаблицы);
		
		Подписи = Макет.ПолучитьОбласть("Подвал");
		Если (НЕ ИП) Тогда
			
			Подписанты = CW_Печать.ВернутьПодписантов(Ссылка, ПараметрыДоговора);
			
			Если ВыводитьПодписиИПечать Тогда
				
				Подписи = Макет.ПолучитьОбласть("ПодвалПодписи"); 
				
				ПодписьРуководитель		= CW_Печать.ПолучитьПодписьСотрудника(Подписанты.Руководитель, Ложь);
				
				РисунокПодписьРуководителя = Подписи.Рисунки.ПодписьРуководителя;
				РисунокПодписьРуководителя.Линия = Новый Линия(ТипЛинииРисункаТабличногоДокумента.НетЛинии);
				РисунокПодписьРуководителя.ВыводитьНаПечать = Ложь;  
				Если  ПодписьРуководитель <> Неопределено Тогда
					РисунокПодписьРуководителя.ВыводитьНаПечать	= Истина;
					РисунокПодписьРуководителя.Картинка 		= Новый Картинка(ПодписьРуководитель);
				КонецЕсли;
				
				ПодписьБухгалтера = CW_Печать.ПолучитьПодписьСотрудника(Подписанты.ГлБух, Ложь);
				
				РисунокПодписьБухгалтера = Подписи.Рисунки.ПодписьБухгалтера;
				РисунокПодписьБухгалтера.Линия = Новый Линия(ТипЛинииРисункаТабличногоДокумента.НетЛинии);
				РисунокПодписьБухгалтера.ВыводитьНаПечать 	= Ложь;
				Если  РисунокПодписьБухгалтера <> Неопределено Тогда
					РисунокПодписьБухгалтера.ВыводитьНаПечать	= Истина;
					РисунокПодписьБухгалтера.Картинка 			= Новый Картинка(ПодписьБухгалтера);
				КонецЕсли;
				
			КонецЕсли; 
			
			Подписи.Параметры.ФИОруководителя = CW_Печать.ФамилияИОИзСтрокиФамилияИмяОтчество(Подписанты.Руководитель,Ссылка.Дата)
			+ ?(ЗначениеЗаполнено(Подписанты.РуководительОснованиеРус), " (" + Подписанты.РуководительОснованиеРус + ")", "");
			
			Подписи.Параметры.ФИОГлавногоБухгалтера = CW_Печать.ФамилияИОИзСтрокиФамилияИмяОтчество(Подписанты.ГлБух,Ссылка.Дата)
			+ ?(ЗначениеЗаполнено(Подписанты.ГлБухОснованиеРус), " (" + Подписанты.ГлБухОснованиеРус + ")", ""); 
			
			ТабличныйДокумент.Вывести(Подписи);
			
			
		Иначе
			
			НаДату 		= Ссылка.ВедомыйДокумент.Дата;
			СведенияИП  = CW_БухгалтерияЭкспедитораСерверПереопределяемый.СведенияОЮрФизЛице(Ссылка.Организация, НаДату); // ВызовБП
			Подписи.Параметры.ФИОПБОЮЛ = СведенияИП.НаименованиеДляПечатныхФорм;
			Подписи.Параметры.Свидетельство=СведенияИП.Свидетельство;
			ТабличныйДокумент.Вывести(Подписи);
			
		КонецЕсли; 
	КонецЕсли; 
	
	#КонецОбласти 
	
	РезультатПечати.ПечатнаяФорма = ТабличныйДокумент; 
	
	Возврат РезультатПечати;
	
КонецФункции // Печать

Функция НужноПечататьОбычныйСчетФактуру(Ссылка)  
	
	ВидОперацииКорректировки = Ссылка.ВидОперацииКорректировки; 
	Если  ВидОперацииКорректировки.Пустая() Тогда
		ВидОперацииКорректировки = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсправленияПоступленияРеализации.СогласованноеИзменение");
	КонецЕсли;   
	
	Если ВидОперацииКорректировки = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсправленияПоступленияРеализации.СогласованноеИзменение") Тогда 
		Возврат Ложь;
	КонецЕсли;	
	
	Если ВидОперацииКорректировки = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсправленияПоступленияРеализации.ИсправлениеОшибки") Тогда  
		Если Не Ссылка.КорректируемыйДокумент.Корректировка Тогда 
			Возврат Истина;  
		Иначе
			Возврат НужноПечататьОбычныйСчетФактуру(Ссылка.КорректируемыйДокумент);	
		КонецЕсли; 
	КонецЕсли;  
	
	Возврат Ложь;
	
КонецФункции

Функция  ПолучитьВедомыйСчетФактуру(Ссылка);
	
	Если Ссылка.КорректируемыйДокумент.Корректировка Тогда
		Возврат	ПолучитьВедомыйСчетФактуру(Ссылка.КорректируемыйДокумент);
	КонецЕсли;
	
	Возврат Ссылка.КорректируемыйДокумент.ВедомыйСчетФактура
	
КонецФункции

Функция ПолучитьПоследнееИсправление(ИсправляемыйСчетФактура)
	
	Результат = Новый Структура("НомерИсправления,ДатаИсправления","",Дата(1,1,1));
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	|	СчетФактураВыданный.Дата КАК ДатаИсправления,
	|	СчетФактураВыданный.НомерИсправления КАК НомерИсправления
	|ИЗ
	|	Документ.СчетФактураВыданный КАК СчетФактураВыданный
	|ГДЕ
	|	СчетФактураВыданный.ИсправляемыйСчетФактура = &ИсправляемыйСчетФактура
	|	И СчетФактураВыданный.Исправление = ИСТИНА
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерИсправления УБЫВ";
	
	Запрос.УстановитьПараметр("ИсправляемыйСчетФактура", ИсправляемыйСчетФактура);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(Результат, Выборка);
	КонецЕсли;
	
	Возврат Результат
	
КонецФункции
#КонецЕсли