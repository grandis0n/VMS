&НаСервере
Функция ПолучитьСпискокДокументов()
	
	Запрос = новый запрос;
	запрос.Текст = "ВЫБРАТЬ
	               |	CW_РаспределениеЗатратПутевыхЛистовПоГрузоперевозкам.Ссылка КАК Ссылка
	               |ИЗ
	               |	Документ.CW_РаспределениеЗатратПутевыхЛистовПоГрузоперевозкам КАК CW_РаспределениеЗатратПутевыхЛистовПоГрузоперевозкам
	               |ГДЕ
	               |	CW_РаспределениеЗатратПутевыхЛистовПоГрузоперевозкам.Дата МЕЖДУ &Начало И &Окончание
	               |	И CW_РаспределениеЗатратПутевыхЛистовПоГрузоперевозкам.Проведен";
	
	Запрос.УстановитьПараметр("Начало", ПериодФормирования.ДатаНачала);
	Запрос.УстановитьПараметр("Окончание", ПериодФормирования.ДатаОкончания);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	МассивДокументов = новый Массив;
	
	Пока Выборка.Следующий() Цикл
		Если МассивДокументов.Найти(Выборка.Ссылка) = Неопределено Тогда
			МассивДокументов.Добавить(Выборка.Ссылка);
		КонецЕсли;
	КонецЦикла;
	
	Возврат МассивДокументов;
	
КонецФункции

&НаКлиенте
Процедура ОбработатьОповещения()
	
	МассивДокументов = ПолучитьСпискокДокументов();
	Если МассивДокументов.Количество() > 0 тогда
		Для Каждого СтрокаМассива из МассивДокументов Цикл
			
			ТекстОповещения	= "Необходимо переформировать документ:";
			ТекстПояснения	= Строка(СтрокаМассива);
			ПоказатьОповещениеПользователя(ТекстОповещения, ПолучитьНавигационнуюСсылку(СтрокаМассива), ТекстПояснения,БиблиотекаКартинок.CW_Документ, СтатусОповещенияПользователя.Важное);
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

