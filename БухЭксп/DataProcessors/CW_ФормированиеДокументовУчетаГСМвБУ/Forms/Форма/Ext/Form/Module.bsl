Процедура ОрганизацияПриИзменении(Элемент)
	
	ОбработатьВыборОрганизации();

	ПараметрыПроцедуры = СтруктураПолучаемыхДанных();
	ПараметрыПроцедуры.ПеремещенияТоплива 	= Истина;
	ПараметрыПроцедуры.СписанияТоплива 		= Истина;
	ПараметрыПроцедуры.ЗаработнаяПлата 		= Истина;
	
	РезультатВыполнения =  ПолучитьИсходныеДанныеНаСервереВФоне(ПараметрыПроцедуры);
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ВыводитьОкноОжидания = Истина; 
	ОповещениеОЗавершении = Новый ОписаниеОповещения("РезультатПолученияИсходныхДанных", ЭтотОбъект); 
	ДлительныеОперацииКлиент.ОжидатьЗавершение(РезультатВыполнения, ОповещениеОЗавершении, ПараметрыОжидания); 

КонецПроцедуры

&НаСервере 
Функция ПолучитьИсходныеДанныеНаСервереВФоне(ПараметрыПроцедуры)  
	
	ПараметрыПроцедуры.Вставить("ДатаНачала",			ПериодФормирования.ДатаНачала);  
	ПараметрыПроцедуры.Вставить("ДатаОкончания", 		ПериодФормирования.ДатаОкончания); 
	ПараметрыПроцедуры.Вставить("Организация", 			Организация);  
	ПараметрыПроцедуры.Вставить("ВестиУчетЗатратПоПодразделениям",	ВестиУчетЗатратПоПодразделениям);  
	ПараметрыПроцедуры.Вставить("ВестиУчетПоПодразделениям",		ВестиУчетПоПодразделениям);  
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(Новый УникальныйИдентификатор);
	ПараметрыВыполнения.ОжидатьЗавершение    = 0;  // запускать сразу  
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = "Получение исходных данных для учета ГСМ";  
	ПараметрыВыполнения.ЗапуститьВФоне = Истина;  
	ПараметрыВыполнения.ЗапуститьНеВФоне = ложь;   
	
	Возврат ДлительныеОперации.ВыполнитьВФоне("Обработки.CW_ФормированиеДокументовУчетаГСМвБУ.ПолучитьИсходныеДанные",ПараметрыПроцедуры, ПараметрыВыполнения);  
	
КонецФункции  

 &НаКлиенте 
Процедура РезультатПолученияИсходныхДанных(РезультатВыполнения, Дополнительныепараметры) Экспорт
	
	Если РезультатВыполнения.Статус = "Выполнено" Тогда   
		
		ОбработатьРезультатПолученияИсходныхДанныхНаСервере(РезультатВыполнения.АдресРезультата);
		
	ИначеЕсли РезультатВыполнения.Статус = "Ошибка" Тогда
		
		ТекстПредупреждения = "Информация об ошибке см. в журнале регистрации!";
		
		Если ТипЗнч(РезультатВыполнения.Сообщения) = Тип("Массив") Тогда
			
			Для Каждого СообщениеВМассиве из РезультатВыполнения.Сообщения Цикл
				СообщениеВМассиве.Сообщить();
			КонецЦикла;
			
		КонецЕсли;
		
		ПоказатьПредупреждение(,ТекстПредупреждения,,"Не удалось получить данные топлива к перемещению");  
		
	КонецЕсли;  

КонецПроцедуры   

&НаСервере
Процедура ОбработатьРезультатПолученияИсходныхДанныхНаСервере(АдресРезультата)
	
	Результат = ПолучитьИзВременногоХранилища(АдресРезультата);
	
	Если ТипЗнч(Результат) = Тип("Структура") Тогда
		
		Если Результат.Свойство("ПеремещенияТоплива") Тогда
			ИсходныеДанныеПеремещение.Загрузить(Результат.ПеремещенияТоплива);
		КонецЕсли;    
		
		Если Результат.Свойство("СписанияТоплива") Тогда
			
			ИсходныеДанныеСписание.Загрузить(Результат.СписанияТоплива.ИсходныеДанныеСписание);
			ИсходныеДанныеСписаниеНаФорме.Загрузить(Результат.СписанияТоплива.ИсходныеДанныеСписаниеНаФорме);
		КонецЕсли;   
		
		Если Результат.Свойство("ЗаработнаяПлата") Тогда
			
			ИсходныеДанныеЗарплата.Загрузить(Результат.ЗаработнаяПлата);
			
			Элементы.ИсходныеДанныеЗарплатаГруппа4.Видимость = 
				ИсходныеДанныеЗарплата.Итог("СуммаПР") <> 0 
				или ИсходныеДанныеЗарплата.Итог("СуммаВР" ) <> 0;
			
		КонецЕсли;  
		
	КонецЕсли;  
	
	УстановитьВидимостьЭлементовФормы();
	УстановитьДоступностьКнопокСформировать();  
	
КонецПроцедуры

