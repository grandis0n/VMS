&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ВестиУчетЗатратПоПодразделениям    		= ПолучитьФункциональнуюОпцию("ВестиУчетЗатратПоПодразделениям");
	//Для версии КОРП
	ВестиУчетПоПодразделениям          			= ПолучитьФункциональнуюОпцию("ВестиУчетПоПодразделениям");  
	Элементы.ПодразделениеОрганизации.Видимость = ВестиУчетПоПодразделениям;
	//Для версии КОРП
	
	ФормироватьРазныеДокументыПоВидуРасхода = Истина;

	ПолучитьКонтрольОтрицательныйостатков();
	УстановитьЗаголовокНадписиКонтроляОстатков();
	
	ПроверитьИПолучитьДополнительныеСвойства(Отказ);

	Элементы.ИсходныеДанныеПеремещениеГруппаПодразделение.Видимость = ВестиУчетПоПодразделениям;
	Элементы.ИсходныеДанныеЗарплатаПодразделение.Видимость 			= ВестиУчетЗатратПоПодразделениям или ВестиУчетПоПодразделениям;
	
	ПериодФормирования.ДатаНачала 		= НачалоМесяца(ТекущаяДата());
	ПериодФормирования.ДатаОкончания 	= КонецМесяца(ТекущаяДата());
	ДатаНакладных 						= КонецМесяца(ТекущаяДата());
	ДатаПеремещений 					= КонецМесяца(ТекущаяДата()) - 10;
	Организация 						= CW_Настройки.ОсновнаяОрганизация();
	
	СтатьяЗатрат 						= Константы.CW_СтатьяЗатратСписанияТопливаПоПутевымЛистам.Получить();
	
	УстановитьВидимостьЭлементовФормы();
	ОбработатьВыборОрганизации();
	
	ОбработатьИзменениеПериода();
	
	УстановитьДоступностьКнопокСформировать();
	
	Элементы.ИсходныеДанныеЗарплатаГруппа4.Видимость = Ложь;


КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	Отказ 				= ЗавершениеРаботы;
	ТекстПредупреждения = "Необходимо закрыть форму обработки формирования документов учета ГСМ!";
	
	Если ПроверитьНаличиеДокументовПриЗакрытии  Тогда
		
		Если Не ЗавершениеРаботы тогда
			
			ОбработатьОповещения();
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры


&НаСервере
Процедура УстановитьДоступностьКнопокСформировать()
	
	Элементы.НоменклатураКПеремещениюСформироватьПеремещения.Доступность 	= ИсходныеДанныеПеремещение.Количество() > 0;
	Элементы.ИсходныеДанныеСписаниеСформироватьНакладные.Доступность 		= ИсходныеДанныеСписаниеНаФорме.Количество() > 0;
	Элементы.ИсходныеДанныеЗарплатаСформироватьОперацию.Доступность 		= ИсходныеДанныеЗарплата.Количество() > 0;
	
КонецПроцедуры

&НаСервере
Процедура ПолучитьКонтрольОтрицательныйостатков()
	
	КонтрольОтрицательныхОстатков = Константы.ОтключитьКонтрольОтрицательныхОстатков.Получить();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьЗаголовокНадписиКонтроляОстатков()
	
	Элементы.НадписьОткрытьФормуНастроек.Заголовок = ?(КонтрольОтрицательныхОстатков, "Выключен","Включен");
	
КонецПроцедуры

&НаСервере
Процедура УстановитьПериодДинамическихСписков()
	
	ЗаполнитьЗначенияСвойств(Элементы.СписокПеремещениеТоваров.Период	, ПериодФормирования);
	ЗаполнитьЗначенияСвойств(Элементы.СписокТребованиеНакладная.Период	, ПериодФормирования);
	ЗаполнитьЗначенияСвойств(Элементы.СписокДокументовОперациБух.Период	, ПериодФормирования);
	
КонецПроцедуры

&НаСервере
Процедура ПроверитьИПолучитьДополнительныеСвойства(Отказ)
	
	ДополнительноеСвоствоПеремещения 	= Константы.CW_ДополнительноеСвойствоДокументаПеремещениеТоваров.Получить();
	ДополнительноеСвоствоТребование  	= Константы.CW_ДополнительноеСвойствоДокументаТребованиеНакладная.Получить();
	ДополнительноеСвоствоОперацияБух  	= Константы.CW_ДополнительноеСвойствоДокументаОперацияВведеннаяВручную.Получить();
	
	Если не ЗначениеЗаполнено(ДополнительноеСвоствоПеремещения) тогда
		//Формируем новое совойство
		СтруктураДанных = Новый Структура;
		СтруктураДанных.Вставить("ИмяНабораСвойств"	, "Документ_ПеремещениеТоваров");
		СтруктураДанных.Вставить("Наименование"		, "Сформирован обработкой учета ГСМ (Перемещение товаров)");
		СтруктураДанных.Вставить("Заголовок"		, "Сформирован обработкой учета ГСМ");
		СтруктураДанных.Вставить("Имя"				, "СформированОбработкойУчетаГСМ_");
		СтруктураДанных.Вставить("ИмяКонстанты"		, "CW_ДополнительноеСвойствоДокументаПеремещениеТоваров");
		
		Ответ = CW_УчетСобственногоТранспортаСервер.СоздатьИЗаписатьСвойствоДокумента(СтруктураДанных);
		
		Если Ответ.Успешно Тогда
			ДополнительноеСвоствоПеремещения = ПолучитьИзВременногоХранилища(Ответ.АдресЗначения);
			Константы.CW_ДополнительноеСвойствоДокументаПеремещениеТоваров.Установить(ДополнительноеСвоствоПеремещения);
		КонецЕсли;
		
		Отказ = Не Ответ.Успешно;
		
	КонецЕсли;
	
	Если Не Отказ Тогда
		
		Если не ЗначениеЗаполнено(ДополнительноеСвоствоТребование) тогда
			//Формируем новое совойство
			СтруктураДанных = Новый Структура;
			СтруктураДанных.Вставить("ИмяНабораСвойств"	, "Документ_ТребованиеНакладная");
			СтруктураДанных.Вставить("Наименование"		, "Сформирован обработкой учета ГСМ (Требование-накладная)");
			СтруктураДанных.Вставить("Заголовок"		, "Сформирован обработкой учета ГСМ");
			СтруктураДанных.Вставить("Имя"				, "СформированОбработкойУчетаГСМ_");
			СтруктураДанных.Вставить("ИмяКонстанты"		, "CW_ДополнительноеСвойствоДокументаТребованиеНакладная");
			
			Ответ = CW_УчетСобственногоТранспортаСервер.СоздатьИЗаписатьСвойствоДокумента(СтруктураДанных);
			
			Если Ответ.Успешно Тогда
				ДополнительноеСвоствоТребование = ПолучитьИзВременногоХранилища(Ответ.АдресЗначения);
				Константы.CW_ДополнительноеСвойствоДокументаТребованиеНакладная.Установить(ДополнительноеСвоствоТребование);
			КонецЕсли;
			
			Отказ = Не Ответ.Успешно;
			
		КонецЕсли;
		
	КонецЕсли;	
	
	//
	Если Не Отказ Тогда
		
		Если не ЗначениеЗаполнено(ДополнительноеСвоствоОперацияБух) тогда
			//Формируем новое совойство
			СтруктураДанных = Новый Структура;
			СтруктураДанных.Вставить("ИмяНабораСвойств"	, "Документ_ОперацияБух");
			СтруктураДанных.Вставить("Наименование"		, "Сформирован обработкой учета ГСМ (Операция введенная вручную)");
			СтруктураДанных.Вставить("Заголовок"		, "Сформирован обработкой учета ГСМ");
			СтруктураДанных.Вставить("Имя"				, "СформированОбработкойУчетаГСМ_");
			СтруктураДанных.Вставить("ИмяКонстанты"		, "CW_ДополнительноеСвойствоДокументаОперацияВведеннаяВручную");
			
			Ответ = CW_УчетСобственногоТранспортаСервер.СоздатьИЗаписатьСвойствоДокумента(СтруктураДанных);
			
			Если Ответ.Успешно Тогда
				ДополнительноеСвоствоОперацияБух = ПолучитьИзВременногоХранилища(Ответ.АдресЗначения);
				Константы.CW_ДополнительноеСвойствоДокументаОперацияВведеннаяВручную.Установить(ДополнительноеСвоствоОперацияБух);
			КонецЕсли;
			
			Отказ = Не Ответ.Успешно;
			
		КонецЕсли;
		
	КонецЕсли;	
	
КонецПроцедуры

&НаСервере
Процедура УстановитьОтборДинамическихСписков()    
	
	СписокПеремещениеТоваров.Отбор.Элементы.Очистить();
	СписокТребованиеНакладная.Отбор.Элементы.Очистить();
	СписокДокументовОперациБух.Отбор.Элементы.Очистить();
	
	Если ЗначениеЗаполнено(Организация) Тогда
		ЭлементОтбора = СписокПеремещениеТоваров.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Организация");
		ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		ЭлементОтбора.ПравоеЗначение = Организация;
		ЭлементОтбора.Использование = Истина; 
		
		ЭлементОтбора = СписокТребованиеНакладная.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Организация");
		ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		ЭлементОтбора.ПравоеЗначение = Организация;
		ЭлементОтбора.Использование = Истина; 
		
		ЭлементОтбора = СписокДокументовОперациБух.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Организация");
		ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		ЭлементОтбора.ПравоеЗначение = Организация;
		ЭлементОтбора.Использование = Истина; 
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьЭлементовФормы()
	
	Если СводноеПеремещение Тогда
		ТекстПодсказки = "Будет сформирован один документ ""Перемещение товаров"" на указанную дату";
		Элементы.ДатаПеремещений.Подсказка					= ТекстПодсказки;
		Элементы.СводноеПеремещение.Подсказка				= "";
	Иначе
		ТекстПодсказки = "Будут сформированы документы ""Перемещение товаров"" на каждую дату заправки";
		Элементы.ДатаПеремещений.Подсказка					= "";
		Элементы.СводноеПеремещение.Подсказка				= ТекстПодсказки;
	КонецЕсли;
	
	Элементы.ДатаПеремещений.Видимость 					= СводноеПеремещение;
	
	Элементы.ИсходныеДанныеПеремещениеКоличество.ТекстПодвала =  Формат(ИсходныеДанныеПеремещение.Итог("Количество"), "ЧДЦ=3") ;
	
	Элементы.ИсходныеДанныеЗарплатаСумма.ТекстПодвала   =  Формат(ИсходныеДанныеЗарплата.Итог("Сумма"), "ЧДЦ=2") ;
	Элементы.ИсходныеДанныеЗарплатаСуммаНУ.ТекстПодвала =  Формат(ИсходныеДанныеЗарплата.Итог("СуммаНУ"), "ЧДЦ=2") ;
	Элементы.ИсходныеДанныеЗарплатаСуммаПР.ТекстПодвала =  Формат(ИсходныеДанныеЗарплата.Итог("СуммаПР"), "ЧДЦ=2") ;
	Элементы.ИсходныеДанныеЗарплатаСуммаВР.ТекстПодвала =  Формат(ИсходныеДанныеЗарплата.Итог("СуммаВР"), "ЧДЦ=2") ;
	
	Элементы.ИсходныеДанныеСписаниеНаФормеКоличествоВсего.ТекстПодвала 			 =  Формат(ИсходныеДанныеСписаниеНаФорме.Итог("КоличествоВсего")			, "ЧДЦ=3") ;
	Элементы.ИсходныеДанныеСписаниеНаФормеКоличествоВПределахНормы.ТекстПодвала  =  Формат(ИсходныеДанныеСписаниеНаФорме.Итог("КоличествоВПределахНормы")	, "ЧДЦ=3") ;
	Элементы.ИсходныеДанныеСписаниеНаФормеКоличествоСверхНормы.ТекстПодвала		 =  Формат(ИсходныеДанныеСписаниеНаФорме.Итог("КоличествоСверхНормы")		, "ЧДЦ=3") ;

	
КонецПроцедуры

&НаКлиенте
Процедура ПериодФормированияПриИзменении(Элемент)
	
	ОбработатьИзменениеПериода();
	
КонецПроцедуры

&НаСервере
Процедура ОбработатьИзменениеПериода()
	
	ДатаНакладных 	= ПериодФормирования.ДатаОкончания;
	ДатаПеремещений = ДатаНакладных - 10;
	ДатаОперации 	= ПериодФормирования.ДатаОкончания;
	
	УстановитьПериодДинамическихСписков();
	
КонецПроцедуры

&НаСервере
Функция СпособУчетаНДСНоменклатуры(СпособУчета)
	Если ЗначениеЗаполнено(СпособУчета) Тогда
		Возврат СпособУчета;
	Иначе
		Возврат Перечисления.СпособыУчетаНДС.УчитываетсяВCтоимости;	
	КонецЕсли;
КонецФункции

&наСервере
Процедура ЗаписатьДополнителнительноеСвойствоДокумента(СсылкаНаДокумент)
	
	Если ТипЗнч(СсылкаНаДокумент) = Тип("ДокументСсылка.ТребованиеНакладная") Тогда
		Свойство = ДополнительноеСвоствоТребование;
	ИначеЕсли ТипЗнч(СсылкаНаДокумент) = Тип("ДокументСсылка.ПеремещениеТоваров") Тогда
		Свойство = ДополнительноеСвоствоПеремещения;
	ИначеЕсли ТипЗнч(СсылкаНаДокумент) = Тип("ДокументСсылка.ОперацияБух") Тогда
		Свойство = ДополнительноеСвоствоОперацияБух;
	Иначе
		//странно
		Возврат;
	КонецЕсли;
	
	Попытка
		Запись = РегистрыСведений.ДополнительныеСведения.СоздатьМенеджерЗаписи();
		Запись.Объект 	= СсылкаНаДокумент;
		Запись.Свойство = Свойство;
		Запись.Прочитать();
		
		Запись.Объект 	= СсылкаНаДокумент;
		Запись.Свойство = Свойство;
		Запись.Значение = истина;
		Запись.Записать(истина);
		
	Исключение
		
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура КонтрольОборотов(Команда)
	
	ПараметрыОтчета = новый Структура;
	ПараметрыОтчета.Вставить("ВнешнийВызов"	, Истина);
	ПараметрыОтчета.Вставить("НачалоПериода", ПериодФормирования.ДатаНачала);
	ПараметрыОтчета.Вставить("КонецПериода"	, ПериодФормирования.ДатаОкончания);
	ПараметрыОтчета.Вставить("ВнешнийВызов"	, Истина);
	
	Если ЗначениеЗаполнено(Организация) тогда
		ПараметрыОтчета.Вставить("Отбор", Новый Структура("Организация", Организация));
	КонецЕсли;
	
	ОткрытьФорму("Отчет.CW_АнализСписанияТопливаПоВидамУчета.Форма.ФормаОтчета",ПараметрыОтчета,ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура СводноеПеремещениеПриИзменении(Элемент)
	
	УстановитьВидимостьЭлементовФормы();

КонецПроцедуры

&НаКлиенте
Процедура ДатаДокументовПриИзменении(Элемент)
	Объект.ДатаПеремещений = Объект.ДатаНакладных - 10;
КонецПроцедуры

//Перемещение топлива
&НаКлиенте
Процедура СформироватьПеремещения(Команда)
	
	Если СводноеПеремещение Тогда
		Отказ = ложь;
		Если Не ЗначениеЗаполнено(Объект.ДатаПеремещений) Тогда   
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не указана дата документов",,"ДатаПеремещений", "Объект", Отказ);
		КонецЕсли;
		
		Если Отказ Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли; 
	
	Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаПеремещения", ЭтаФорма);
	
	Если ЕстьПеремещенияТекущегоПпериода() тогда
		Режим = РежимДиалогаВопрос.ДаНет;
		ПоказатьВопрос(Оповещение, "В указанном периоде есть документы ранее сформированные обработкой. Документы будут помечены на удаление. Продолжить?" , Режим, 0);		
	Иначе
		ВыполнитьОбработкуОповещения(Оповещение, КодВозвратаДиалога.Да);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияВопросаПеремещения(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;   
	
	РезультатВыполнения =  СформироватьПеремещенияТопливаНаСервереВФоне();
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ВыводитьОкноОжидания = Истина; 
