Функция ПолучитьМассивСтатейЗатаратПоОплатеТруда() Экспорт 
	
	мВидыРасходовНУ = Новый Массив;
	мВидыРасходовНУ.Добавить(Перечисления.ВидыРасходовНУ.ОплатаТруда);
	мВидыРасходовНУ.Добавить(Перечисления.ВидыРасходовНУ.СтраховыеВзносы);
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	СтатьиЗатрат.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.СтатьиЗатрат КАК СтатьиЗатрат
	|ГДЕ
	|	СтатьиЗатрат.ВидРасходовНУ В(&мВидыРасходовНУ)
	|	И СтатьиЗатрат.ПометкаУдаления = ЛОЖЬ";
	
	Запрос.УстановитьПараметр("мВидыРасходовНУ", мВидыРасходовНУ);  
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("Ссылка"); 
	
КонецФункции

Функция ПолучитьРаздельныйРежимУчетаНДС(Организация,ДатаСреза)
	
	УстановитьПривилегированныйРежим(Истина);
	
	РаздельныйУчетНДСНаСчете19 = CW_БухгалтерияЭкспедитораСерверПереопределяемый.РаздельныйУчетНДСНаСчете19(Организация, ДатаСреза);
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат РаздельныйУчетНДСНаСчете19;
	
КонецФункции

Функция СпособУчетаНДСНоменклатуры(СпособУчета)
	Если ЗначениеЗаполнено(СпособУчета) Тогда
		Возврат СпособУчета;
	Иначе
		Возврат Перечисления.СпособыУчетаНДС.УчитываетсяВCтоимости;	
	КонецЕсли;
КонецФункции

Процедура ЗаписатьДополнителнительноеСвойствоДокумента(СсылкаНаДокумент, Свойство)
	
	Запись = РегистрыСведений.ДополнительныеСведения.СоздатьМенеджерЗаписи();
	Запись.Объект 	= СсылкаНаДокумент;
	Запись.Свойство = Свойство;
	Запись.Прочитать();
	
	Запись.Объект 	= СсылкаНаДокумент;
	Запись.Свойство = Свойство;
	Запись.Значение = истина;
	Запись.Записать(истина);
	
КонецПроцедуры

Процедура УничтожитьТаблицуПакета(Запрос, ИмяТаблицы)
	
	Запрос.Текст = "УНИЧТОЖИТЬ "+ИмяТаблицы;
	Запрос.Выполнить();

КонецПроцедуры
