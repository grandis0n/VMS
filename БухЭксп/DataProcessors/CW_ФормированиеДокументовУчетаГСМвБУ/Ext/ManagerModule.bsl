	|	СУММА(ХозрасчетныйОбороты.СуммаНУОборотДт - ХозрасчетныйОбороты.СуммаНУОборотКт) КАК СуммаНУ,
	|	СУММА(ХозрасчетныйОбороты.СуммаПРОборотДт - ХозрасчетныйОбороты.СуммаПРОборотКт) КАК СуммаПР,
	|	СУММА(ХозрасчетныйОбороты.СуммаВРОборотДт - ХозрасчетныйОбороты.СуммаВРОборотКт) КАК СуммаВР
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный.Обороты(
	|			&НачалоПериода,
	|			&КонецПериода,
	|			Период,
	|			Счет = &СчетУчетаЗаработнойПлаты,
	|			,
	|			Субконто1 В (&мСтатьиЗатарат)
	|			//УСЛОВИЕ_Организация		
	|			,
	|			,
	|			) КАК ХозрасчетныйОбороты
	|ГДЕ
	|	(ХозрасчетныйОбороты.СуммаОборотДт - ХозрасчетныйОбороты.СуммаОборотКт <> 0
	|			ИЛИ ХозрасчетныйОбороты.СуммаНУОборотДт - ХозрасчетныйОбороты.СуммаНУОборотКт <> 0
	|			ИЛИ ХозрасчетныйОбороты.СуммаПРОборотДт - ХозрасчетныйОбороты.СуммаПРОборотКт <> 0
	|			ИЛИ ХозрасчетныйОбороты.СуммаВРОборотДт - ХозрасчетныйОбороты.СуммаВРОборотКт <> 0)
	|
	|СГРУППИРОВАТЬ ПО
	|	ХозрасчетныйОбороты.Организация,
	|	ХозрасчетныйОбороты.Счет,
	|	ХозрасчетныйОбороты.Подразделение,
	|	ХозрасчетныйОбороты.Валюта,
	|	ХозрасчетныйОбороты.Субконто1
	|ИТОГИ
	|	СУММА(Сумма),
	|	СУММА(СуммаНУ),
	|	СУММА(СуммаПР),
	|	СУММА(СуммаВР)
	|ПО
	|	ОБЩИЕ,
	|	Организация";  
	
	Если ЗначениеЗаполнено(ПараметрыПроцедуры.Организация) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "//УСЛОВИЕ_Организация", "И Организация = &Организация");
	КонецЕсли;
	
	Запрос.УстановитьПараметр("НачалоПериода", 				ПараметрыПроцедуры.ДатаНачала);
	Запрос.УстановитьПараметр("КонецПериода", 				Новый Граница(ПараметрыПроцедуры.ДатаОкончания, ВидГраницы.Включая));
	Запрос.УстановитьПараметр("СчетУчетаЗаработнойПлаты", 	ПланыСчетов.Хозрасчетный.ОбщепроизводственныеРасходы);
	Запрос.УстановитьПараметр("Организация", 				ПараметрыПроцедуры.Организация);
	Запрос.УстановитьПараметр("НоменклатурнаяГруппаДельта", ПараметрыПроцедуры.НоменклатурнаяГруппаДельта);  
	Запрос.УстановитьПараметр("мСтатьиЗатарат", 			мСтатьиЗатарат);
	
	РезультатЗапроса = Запрос.Выполнить();
	Если не РезультатЗапроса.Пустой() Тогда
		Выборка_ОбщийИтог = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Если Выборка_ОбщийИтог.Следующий() Тогда
			СформироватьДокументОперацияБух(Выборка_ОбщийИтог, ИндексДокумента, ПараметрыПроцедуры);	
		КонецЕсли;
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("ПроверитьНаличиеДокументовПриЗакрытии", ПараметрыПроцедуры.ПроверитьНаличиеДокументов);
	
	ПоместитьВоВременноеХранилище(Результат, АдресРезультата);
	
	
КонецПроцедуры

Процедура СформироватьДокументОперацияБух(РезультатЗапроса, ИндексДокумента, ПараметрыПроцедуры)
	
	СчетДт = ПланыСчетов.Хозрасчетный.ОсновноеПроизводство;
	
	Выборка_Организации = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока Выборка_Организации.Следующий() Цикл
		
		Выборка_Проводки = Выборка_Организации.Выбрать();
		
		Если Выборка_Проводки.Количество() = 0 тогда
			Продолжить;
		КонецЕсли;
		
		МассивОперацийБух = ПараметрыПроцедуры.МассивОперацийБух;
		
		СоздатьДокумент = истина;
		Если МассивОперацийБух.Количество() > 0 и ИндексДокумента < МассивОперацийБух.Количество() Тогда
			
			СсылкаНаДокумент = МассивОперацийБух[ИндексДокумента];
			
			//Готовим документ
			ОперацияБух = СсылкаНаДокумент.ПолучитьОбъект();
			ОперацияБух.УстановитьПометкуУдаления(Ложь);
			
			Набор = РегистрыБухгалтерии.Хозрасчетный.СоздатьНаборЗаписей();
			Набор.Отбор.Регистратор.Установить(СсылкаНаДокумент, Истина);
			Набор.Очистить();
			
			ИндексДокумента = ИндексДокумента + 1;
			СоздатьДокумент = Ложь;
		КонецЕсли;
		
		Если СоздатьДокумент Тогда	
			ОперацияБух = Документы.ОперацияБух.СоздатьДокумент();
		КонецЕсли;	
		
		ОперацияБух.Дата 			= ПараметрыПроцедуры.ДатаОперации;
		ОперацияБух.Организация 	= Выборка_Организации.Организация;
		ОперацияБух.СуммаОперации 	= Выборка_Организации.Сумма;
		ОперацияБух.Содержание 		= "Распределение зарплаты водителей по путевым листам";
		ОперацияБух.Ответственный 	= ПараметрыСеанса.ТекущийПользователь;
		ОперацияБух.Комментарий 	=  "(Сформирована обработокй ""Формирование документов учета ГСМ в БУ"")";
		ОперацияБух.Записать();
		
		ЗаписатьДополнителнительноеСвойствоДокумента(ОперацияБух.Ссылка, ПараметрыПроцедуры.ДополнительноеСвойство);
		
		Набор = РегистрыБухгалтерии.Хозрасчетный.СоздатьНаборЗаписей();
		Набор.Отбор.Регистратор.Установить(ОперацияБух.Ссылка, Истина);
		
		Пока Выборка_Проводки.Следующий() Цикл
			
			Движение					= Набор.Добавить();
			Движение.Период		 		= ПараметрыПроцедуры.ДатаОперации;
			Движение.Активность 		= Истина;
			Движение.Организация 		= Выборка_Проводки.Организация;
			
			//Дебет проводки
			Движение.СчетДт 			= СчетДт;
			Движение.ПодразделениеДт 	= Выборка_Проводки.Подразделение;
			
			БухгалтерскийУчет.УстановитьСубконто(Движение.СчетДт, Движение.СубконтоДт, "СтатьиЗатрат"			, Выборка_Проводки.СтатьяЗатрат);
			БухгалтерскийУчет.УстановитьСубконто(Движение.СчетДт, Движение.СубконтоДт, "НоменклатурныеГруппы"	, Выборка_Проводки.НоменклатурнаяГруппа);
			
			
			//Кредит проводки
			Движение.СчетКт 			= Выборка_Проводки.Счет;
			Движение.ПодразделениеКт	= Выборка_Проводки.Подразделение;
			
			БухгалтерскийУчет.УстановитьСубконто(Движение.СчетКт, Движение.СубконтоКт, "СтатьиЗатрат"			, Выборка_Проводки.СтатьяЗатрат);
			БухгалтерскийУчет.УстановитьСубконто(Движение.СчетКт, Движение.СубконтоКт, "НоменклатурныеГруппы"	, Выборка_Проводки.НоменклатурнаяГруппа);
			
			Движение.Сумма 				= Выборка_Проводки.Сумма;
			
			Движение.СуммаНУДт 			= Выборка_Проводки.СуммаНУ;
			Движение.СуммаНУКт 			= Выборка_Проводки.СуммаНУ;
			
			Движение.СуммаПРДт 			= Выборка_Проводки.СуммаПР;
			Движение.СуммаПРКт 			= Выборка_Проводки.СуммаПР;
			
			Движение.СуммаВРДт 			= Выборка_Проводки.СуммаВР;
			Движение.СуммаВРКт 			= Выборка_Проводки.СуммаВР;
			
		КонецЦикла;
		
		Набор.Записать(Истина);
		
		ПараметрыПроцедуры.ПроверитьНаличиеДокументов = Истина;   
		
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьРезультатЗапросаОперации(ПараметрыПроцедуры) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ОперацияБух.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ОперацияБух КАК ОперацияБух
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ДополнительныеСведения КАК ДополнительныеСведения
	|		ПО ОперацияБух.Ссылка = ДополнительныеСведения.Объект
	|ГДЕ
	|	ДополнительныеСведения.Свойство = &Свойство
	|	И ДополнительныеСведения.Значение = ИСТИНА
	|	И ОперацияБух.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
	|	И НЕ ОперацияБух.ПометкаУдаления 
	|	//УСЛОВИЕ_Организация
	|";
	
	Если ЗначениеЗаполнено(ПараметрыПроцедуры.Организация) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "//УСЛОВИЕ_Организация", "И ОперацияБух.Организация = &Организация");
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Организация", 	ПараметрыПроцедуры.Организация);
	Запрос.УстановитьПараметр("Свойство",		ПараметрыПроцедуры.ДополнительноеСвойство);
	Запрос.УстановитьПараметр("ДатаНачала",		ПараметрыПроцедуры.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", 	ПараметрыПроцедуры.ДатаОкончания);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат РезультатЗапроса;
	
КонецФункции

Функция ПометитьНаУдалениеДокументыОперацииБух(ПараметрыПроцедуры)
	
	МассивПомеченныхНаУдаление = Новый Массив;
	
	РезультатЗапроса = ПолучитьРезультатЗапросаОперации(ПараметрыПроцедуры);
	
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		ДокументОбъект = Выборка.Ссылка.ПолучитьОбъект();	
		ДокументОбъект.УстановитьПометкуУдаления(истина); 
		
		МассивПомеченныхНаУдаление.Добавить(Выборка.Ссылка);
	КонецЦикла;  
	
	Возврат МассивПомеченныхНаУдаление;
	
КонецФункции
