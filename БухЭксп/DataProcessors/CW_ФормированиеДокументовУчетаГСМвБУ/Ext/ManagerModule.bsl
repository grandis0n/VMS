	|	ВТ_ДанныеПроводки.Подразделение,
	|	ВТ_ДанныеПроводки.НоменклатурнаяГруппа,
	|	ВТ_ДанныеПроводки.СтатьяЗатрат
	|ИТОГИ
	|	СУММА(Сумма),
	|	СУММА(СуммаНУ)
	|ПО
	|	Организация";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ИндексДокумента = 0;
	Если не РезультатЗапроса.Пустой() Тогда
		СформироватьДокументОперацияБух(РезультатЗапроса, ИндексДокумента, ПараметрыПроцедуры);	
	КонецЕсли;	
	
	//Формируем операцию по отклонениям
	Запрос.Текст = "ВЫБРАТЬ
