#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
// функция записи настроек подключаемой обработки
Функция ЗаписатьНастройки(ИмяНастроек, Настройки, Отказ) Экспорт 
	
	УстановитьПривилегированныйРежим(Истина);
	
	Попытка
		ХранилищеСистемныхНастроек.Сохранить("Настойки_CW_ОперацииМСФО","Настойки_CW_ОперацииМСФО",Настройки,,"БухгалтерияЭкспедитора");
	Исключение
		Сообщение 		= Новый СообщениеПользователю;
		Сообщение.Текст = "Не удалось сохранить настройки по причине: " +ОписаниеОшибки();
		Сообщение.Сообщить();
		
		Отказ = Истина;
	КонецПопытки; 
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецФункции

Функция ПолучитьНастройки(ИмяНастроек) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Попытка
		
		Настройки = ХранилищеСистемныхНастроек.Загрузить(ИмяНастроек, ИмяНастроек,,"БухгалтерияЭкспедитора");
				
	Исключение
	    
		Настройки = Неопределено;
		
	КонецПопытки; 
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат Настройки;
	
КонецФункции

