		//СубконтоДт
		CW_БухгалтерскийУчетМСФО.УстановитьСубконто(Движение.СчетДт, Движение.СубконтоДт, "ДенежныеCредства"	, ВыборкаПоШапке.Касса);
		
		Если ИспользоватьСтатьиДДС Тогда
			CW_БухгалтерскийУчетМСФО.УстановитьСубконто(Движение.СчетДт, Движение.СубконтоДт, "СтатьиДвиженияДенежныхСредств"	, ВыборкаПоШапке.КассаСтатьяДДС);
		КонецЕсли;
		
		//КРЕДИТ
		Если Выборка_ОплатыПокупателя.Счет = ВыборкаПоШапке.Ссылка Тогда
			//Это аванс
			СтуктураСчетаКт = Новый Структура;
			СтуктураСчетаКт.Вставить("СчетКт"		, СтруктураНастроек.СчетАвансовКлиентов);
			СтуктураСчетаКт.Вставить("Контрагент"	, Выборка_ОплатыПокупателя.Контрагент);
			СтуктураСчетаКт.Вставить("Договор"		, Выборка_ОплатыПокупателя.Договор);
			СтуктураСчетаКт.Вставить("Счет"			, Неопределено);
			СодежаниеПроводки = "Advance payment from the buyer: "+СокрЛП(Выборка_ОплатыПокупателя.Контрагент)+" under the agreement: "+СокрП(Выборка_ОплатыПокупателя.Договор);
		Иначе
			СтуктураСчетаКт = Новый Структура;
			СтуктураСчетаКт.Вставить("СчетКт"		, СтруктураНастроек.СчетУчетаКлиентов);
			СтуктураСчетаКт.Вставить("Контрагент"	, Выборка_ОплатыПокупателя.Контрагент);
			СтуктураСчетаКт.Вставить("Договор"		, Выборка_ОплатыПокупателя.Договор);
			СтуктураСчетаКт.Вставить("Счет"			, Выборка_ОплатыПокупателя.Счет);
			СодежаниеПроводки = "Buyer's payment on "+ СокрЛП(Выборка_ОплатыПокупателя.Счет);
		КонецЕсли;
		
		СвойстваСчетКт		= CW_БухгалтерскийУчетВызовСервераПовтИспМСФО.ПолучитьСвойстваСчета(СтуктураСчетаКт.СчетКт);
		
		Движение.СчетКт 	=  СтуктураСчетаКт.СчетКт;
		
		//Учет по подразделениям
		Если СвойстваСчетКт.УчетПоПодразделениям Тогда
			Движение.ПодразделениеКт =  ВыборкаПоШапке.Подразделение;
		КонецЕсли;
		
		//Валюта Кт
		Если СвойстваСчетКт.Валютный Тогда
			Движение.ВалютаКт 			= ВыборкаПоШапке.КассаВалюта;
			Движение.ВалютнаяСуммаКт 	= Выборка_ОплатыПокупателя.Всего_Валюта * ЗнакСуммы;
		КонецЕсли;
		
		//Субконто Кт
		CW_БухгалтерскийУчетМСФО.УстановитьСубконто(Движение.СчетКт, Движение.СубконтоКт, "Контрагенты"						, СтуктураСчетаКт.Контрагент);
		CW_БухгалтерскийУчетМСФО.УстановитьСубконто(Движение.СчетКт, Движение.СубконтоКт, "Договоры"						, СтуктураСчетаКт.Договор);
		CW_БухгалтерскийУчетМСФО.УстановитьСубконто(Движение.СчетКт, Движение.СубконтоКт, "ДокументыРасчетовСКонтрагентами"	, СтуктураСчетаКт.Счет);
		
		Движение.Содержание = СодежаниеПроводки; 
		Движение.Сумма 		= Выборка_ОплатыПокупателя.Всего * ЗнакСуммы;
		
	КонецЦикла;
	
	//Курсовые разницы
	
	//d.samuilov@coralway.ru
	//--------------------------
	ВычестьНереализованнуюКурсовуюРазницу(мРезультатыЗапроса,ВыборкаПоШапке,СтруктураНастроек,Движения,Отказ);
	//--------------------------
	РезультатКурсовыеРазницы 	= мРезультатыЗапроса[1];
	Если Не РезультатКурсовыеРазницы.Пустой() Тогда
		
		ВыборкаКурсовыеРазницы 		= РезультатКурсовыеРазницы.Выбрать();
		
		Пока ВыборкаКурсовыеРазницы.Следующий() Цикл
			
			ДанныеДляПроводки = Новый Структура;
			ДанныеДляПроводки.Вставить("Дата"					, ВыборкаПоШапке.Дата);
			ДанныеДляПроводки.Вставить("Организация"			, ВыборкаПоШапке.Организация);
			ДанныеДляПроводки.Вставить("Подразделение"			, ВыборкаПоШапке.Подразделение);
			ДанныеДляПроводки.Вставить("Валюта"					, ВыборкаКурсовыеРазницы.Валюта);
			
			ДанныеДляПроводки.Вставить("КоррСчет"				, СтруктураНастроек.СчетУчетаКлиентов);
			ДанныеДляПроводки.Вставить("КоррПодразделение"		, ВыборкаПоШапке.Подразделение);
			ДанныеДляПроводки.Вставить("КоррСубконто1"			, ВыборкаКурсовыеРазницы.Контрагент);
			ДанныеДляПроводки.Вставить("КоррСубконто2"			, ВыборкаКурсовыеРазницы.Договор);
			ДанныеДляПроводки.Вставить("КоррСубконто3"			, ВыборкаКурсовыеРазницы.Счет);
			
			ДанныеДляПроводки.Вставить("СуммаКурсовойРазницы"	, ВыборкаКурсовыеРазницы.Всего);
			
			ВыполнитьДвиженияПоКурсовымРазницам(Движения, СтруктураНастроек, ДанныеДляПроводки, Отказ);
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

