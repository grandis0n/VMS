	               |ГДЕ
	               |	ВТ_ДвиженияДокумента.ВидОперации = &НереализованнаяКурсоваяРазница
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ВТ_ДвиженияДокумента.Счет,
	               |	ВТ_ДвиженияДокумента.Договор,
	               |	ВТ_ДвиженияДокумента.Организация,
	               |	ВТ_ДвиженияДокумента.Контрагент,
	               |	ВТ_ДвиженияДокумента.Валюта";
	
	Запрос.УстановитьПараметр("ОперативнаяДебиторскаяЗадолженность"	, ОперативнаяДебиторскаяЗадолженность);
	Запрос.УстановитьПараметр("КурсоваяРазница" 					, Перечисления.CW_ВидыДвиженийПоОперативнойЗадолженности.КурсоваяРазница);
	//d.samuilov@coraway.ru добавлен параметр, а так же добавлен в запрос Пакет 4 для получения нереализованной курсовой разницы
	Запрос.УстановитьПараметр("НереализованнаяКурсоваяРазница" 		, Перечисления.CW_ВидыДвиженийПоОперативнойЗадолженности.НереализованнаяКурсоваяРазница);
	//Запрос.УстановитьПараметр("ВидДвиженияРасход"					, ВидДвиженияНакопления.Расход);
	
	мРезультатыЗапроса =	Запрос.ВыполнитьПакет();
	
	#КонецОбласти
	
	//Оплата покупателя
	Результат_ОплатыПокупателя 	= мРезультатыЗапроса[2];
	Выборка_ОплатыПокупателя 		= Результат_ОплатыПокупателя.Выбрать();
	Пока Выборка_ОплатыПокупателя.Следующий() Цикл
		
		Движение = Движения.Добавить();
		Движение.Период			= ВыборкаПоШапке.Дата;
		Движение.Организация 	= ВыборкаПоШапке.Организация;
		
		//ДЕБЕТ
		Движение.СчетДт 		=  ВыборкаПоШапке.КассаСчет;
		
		//Учет по подразделениям
		Если СвойстваСчетКассы.УчетПоПодразделениям Тогда
			Движение.ПодразделениеКт =  ВыборкаПоШапке.Подразделение;
		КонецЕсли;
		
		//Валюта Кт
		Если СвойстваСчетКассы.Валютный Тогда
			Движение.ВалютаДт 			= ВыборкаПоШапке.КассаВалюта;
			Движение.ВалютнаяСуммаДт 	= Выборка_ОплатыПокупателя.Всего_Валюта * ЗнакСуммы;
