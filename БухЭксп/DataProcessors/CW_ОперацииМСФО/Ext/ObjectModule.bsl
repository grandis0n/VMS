		КонецЕсли;
		
		СвойстваСчетаДт		= CW_БухгалтерскийУчетВызовСервераПовтИспМСФО.ПолучитьСвойстваСчета(СтуктураСчетаДт.СчетДт);
		
		Движение.СчетДт 		=  СтуктураСчетаДт.СчетДт;
		
		//Учет по подразделениям
		Если СвойстваСчетаДт.УчетПоПодразделениям Тогда
			Движение.ПодразделениеДт =  ВыборкаПоШапке.Подразделение;
		КонецЕсли;
		
		//Валюта Дт
		Если СвойстваСчетаДт.Валютный Тогда
			Движение.ВалютаДт 			= ВыборкаПоШапке.КассаВалюта;
			Движение.ВалютнаяСуммаДт 	= Выборка_ОплатаПоставщику.Всего_Валюта * ЗнакСуммы;
		КонецЕсли;
		
		//Субконто Дт
		CW_БухгалтерскийУчетМСФО.УстановитьСубконто(Движение.СчетДт, Движение.СубконтоДт, "Контрагенты"						, СтуктураСчетаДт.Контрагент);
		CW_БухгалтерскийУчетМСФО.УстановитьСубконто(Движение.СчетДт, Движение.СубконтоДт, "Договоры"						, СтуктураСчетаДт.Договор);
		CW_БухгалтерскийУчетМСФО.УстановитьСубконто(Движение.СчетДт, Движение.СубконтоДт, "ДокументыРасчетовСКонтрагентами"	, СтуктураСчетаДт.Счет);
		
		
		//КРЕДИТ
		Движение.СчетКт 		=  ВыборкаПоШапке.КассаСчет;
		
		//Учет по подразделениям
		Если СвойстваСчетКассы.УчетПоПодразделениям Тогда
			Движение.ПодразделениеКт =  ВыборкаПоШапке.Подразделение;
		КонецЕсли;
		
		//Валюта Кт
		Если СвойстваСчетКассы.Валютный Тогда
			Движение.ВалютаКт 			= ВыборкаПоШапке.КассаВалюта;
			Движение.ВалютнаяСуммаКт 	= Выборка_ОплатаПоставщику.Всего_Валюта * ЗнакСуммы;
		КонецЕсли;
		
		//СубконтоДт
		CW_БухгалтерскийУчетМСФО.УстановитьСубконто(Движение.СчетКт, Движение.СубконтоКт, "ДенежныеCредства"	, ВыборкаПоШапке.Касса);
		
		Если ИспользоватьСтатьиДДС Тогда
			CW_БухгалтерскийУчетМСФО.УстановитьСубконто(Движение.СчетКт, Движение.СубконтоКт, "СтатьиДвиженияДенежныхСредств"	, ВыборкаПоШапке.КассаСтатьяДДС);
		КонецЕсли;
		
		Движение.Содержание = СодежаниеПроводки; 
		Движение.Сумма 		= Выборка_ОплатаПоставщику.Всего * ЗнакСуммы;		
		
	КонецЦикла;
	
	//Курсовые разницы
	//d.samuilov@coralway.ru
	//--------------------------
	ВычестьНереализованнуюКурсовуюРазницу(мРезультатыЗапроса,ВыборкаПоШапке,СтруктураНастроек,Движения,Отказ);
	//--------------------------
	
	РезультатКурсовыеРазницы 	= мРезультатыЗапроса[1];
	Если Не РезультатКурсовыеРазницы.Пустой() Тогда
		
		ВыборкаКурсовыеРазницы 		= РезультатКурсовыеРазницы.Выбрать();
		
