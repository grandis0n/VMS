		КонецЕсли;
		
		//СубконтоДт
		CW_БухгалтерскийУчетМСФО.УстановитьСубконто(Движение.СчетДт, Движение.СубконтоДт, "ДенежныеCредства"				, ВыборкаПоШапке.КоррКасса);
		
		Если ИспользоватьСтатьиДДС Тогда
			CW_БухгалтерскийУчетМСФО.УстановитьСубконто(Движение.СчетДт, Движение.СубконтоДт, "СтатьиДвиженияДенежныхСредств"	, ВыборкаПоШапке.КассаСтатьяДДС);
		КонецЕсли;
		
		СтруктураКурса 		= CW_Финансы.ПолучитьКурсВалюты(ВыборкаПоШапке.КоррКассаВалюта,ВыборкаПоШапке.Дата);
		СуммаРегПоступило 	= CW_Финансы.ПересчитатьИзВалютыВВалюту(ВыборкаПоШапке.КоррКассаСумма,ВыборкаПоШапке.КоррКассаВалюта,БазоваяВалюта,СтруктураКурса.Курс,1,СтруктураКурса.Кратность,1);
		
