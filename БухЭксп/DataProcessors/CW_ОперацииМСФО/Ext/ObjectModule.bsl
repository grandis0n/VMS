// информация об обработке
Функция Информация() Экспорт 
	
	СтруктураОписания 					= CW_ПодключаемыеКомандыСервер.СведенияОПодключаемомОбъекте("3.2.0.1");
	СтруктураОписания.Тип 				= CW_ПодключаемыеКомандыСервер.ТипОбработка();
	СтруктураОписания.Вид 				= CW_ПодключаемыеКомандыСервер.ВидОбработкиВнешняяПодписка();
	СтруктураОписания.ИмяВидаПодписки 	= CW_ПодключаемыеКомандыСервер.ИмяВидаПодпискиОбработчикПриПроведении();
	
	СтруктураОписания.Наименование 				= "Операции документов по финансовому блоку";
	СтруктураОписания.Описание 					= "Выполнение бухгалтерских движений по регистру ""МСФО""";
	СтруктураОписания.Версия					= "3.2.1.0";
	СтруктураОписания.МинимальнаяВерсияМодуля	= "8.3.10.10";
	
	СтруктураОписания.Настройка					= Истина;
	
	CW_ПодключаемыеКомандыСервер.УстановитьИмяФормыНастроекОбъекта(СтруктураОписания, "ФормаНастроек");
	
	CW_ПодключаемыеКомандыСервер.УстановитьМетаданныеВнешнейПодписки(СтруктураОписания, "Документ.CW_РасходыПоГрузоперевозке");  
	CW_ПодключаемыеКомандыСервер.УстановитьМетаданныеВнешнейПодписки(СтруктураОписания, "Документ.CW_ДоходыПоГрузоперевозке");  
	CW_ПодключаемыеКомандыСервер.УстановитьМетаданныеВнешнейПодписки(СтруктураОписания, "Документ.CW_КорректировкаОперативнойЗадолженности");  
	CW_ПодключаемыеКомандыСервер.УстановитьМетаданныеВнешнейПодписки(СтруктураОписания, "Документ.CW_ДвижениеДенежныхСредств");  
	CW_ПодключаемыеКомандыСервер.УстановитьМетаданныеВнешнейПодписки(СтруктураОписания, "Документ.CW_РасходыПодотчетногоЛица");  
	CW_ПодключаемыеКомандыСервер.УстановитьМетаданныеВнешнейПодписки(СтруктураОписания, "Документ.CW_РасходыПоПриобретениям");  
	
	Возврат СтруктураОписания;
	
КонецФункции

Функция Использование(Источник, Отказ) Экспорт
	
	Возврат  ПолучитьФункциональнуюОпцию("CW_ВедениеБухгалтескогоУчетаМСФО") и Не Отказ;
	
КонецФункции

Процедура ОбработчикПриПроведении(ПодключаемыйОбъект, Источник, Отказ, РежимПроведения) экспорт
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	//получаем настройки при их наличии
	ИмяНастроек 		= "Настойки_CW_ОперацииМСФО";
	СтруктураНастроек 	= Обработки.CW_ОперацииМСФО.ПолучитьНастройки(ИмяНастроек);
	
	Если СтруктураНастроек = Неопределено Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Не удалось получить настройки для выполнения двжиений по бухгалтерскому учету (МСФО).";
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;
	
	ЕстьОшибки = ПроверитьВозможностьВыполненияДвижений(СтруктураНастроек, Источник);
	
	Если ЕстьОшибки тогда
		Возврат;
	КонецЕсли;
	
	ДатаНачалаВеденияУчетаМСФО = Неопределено;
	СтруктураНастроек.Свойство("ДатаНачалаВеденияУчетаМСФО", ДатаНачалаВеденияУчетаМСФО);
	
	Если Не ЗначениеЗаполнено(ДатаНачалаВеденияУчетаМСФО) или Источник.Дата < ДатаНачалаВеденияУчетаМСФО Тогда
		//проводки не формируются
		Возврат;
	КонецЕсли;
	
	//Запишем движения;
	Источник.Движения.Записать();
	
	Если ТипЗнч(Источник) = Тип("ДокументОбъект.CW_РасходыПоГрузоперевозке") Тогда
		
		СформированияДвиженияДокумента_РасходыПоГрузоперевозке(Источник, СтруктураНастроек, Отказ);	
		
	ИначеЕсли ТипЗнч(Источник) = Тип("ДокументОбъект.CW_ДоходыПоГрузоперевозке") Тогда
		
		СформированияДвиженияДокумента_ДоходыПоГрузоперевозке(Источник, СтруктураНастроек, Отказ);	
		
	ИначеЕсли ТипЗнч(Источник) = Тип("ДокументОбъект.CW_КорректировкаОперативнойЗадолженности") Тогда
		
		СформированияДвиженияДокумента_КорректировкаОперативнойЗадолженности(Источник, СтруктураНастроек, Отказ);	
		
	ИначеЕсли ТипЗнч(Источник) = Тип("ДокументОбъект.CW_ДвижениеДенежныхСредств") Тогда
		
		СформированияДвиженияДокумента_ДвижениеДенежныхСредств(Источник, СтруктураНастроек, Отказ);	
		
	ИначеЕсли ТипЗнч(Источник) = Тип("ДокументОбъект.CW_РасходыПодотчетногоЛица") Тогда
		
		СформированияДвиженияДокумента_РасходыПодотчетногоЛица(Источник, СтруктураНастроек, Отказ);	
		
	ИначеЕсли ТипЗнч(Источник) = Тип("ДокументОбъект.CW_РасходыПоПриобретениям") Тогда
		
		СформированияДвиженияДокумента_РасходыПоПриобретениям(Источник, СтруктураНастроек, Отказ);	
		
	КонецЕсли;
	
	Источник.Движения.CW_МСФО.Записывать = Истина;
	Источник.Движения.CW_МСФО.Записать();
	
КонецПроцедуры

//Проверка заполнения реквизитов в настройках
//	в случае незаполненных счетов, запись движений не выполняется
//
Функция ПроверитьВозможностьВыполненияДвижений(СтруктураНастроек, Источник)
	
	Отказ = ложь;
	ПроверитьСчетаКурсовыхРазниц = Ложь;
	
	Если ТипЗнч(Источник) = Тип("ДокументОбъект.CW_РасходыПоГрузоперевозке") Тогда
		
		МассивПроверяемыхРеквизитов = новый Массив;
		МассивПроверяемыхРеквизитов.Добавить("СчетУчетаПоставщиков");
		МассивПроверяемыхРеквизитов.Добавить("СчетАвансовПоставщиков");
		МассивПроверяемыхРеквизитов.Добавить("СчетУчетаЗатрат");
		
		СтруктураПроверяемыхРеквизитов = новый Структура;
		СтруктураПроверяемыхРеквизитов.Вставить("Реквизиты", МассивПроверяемыхРеквизитов);
		
		ПроверитьЗаполнениеРеквизитов(СтруктураНастроек, СтруктураПроверяемыхРеквизитов, Отказ);
		
	ИначеЕсли ТипЗнч(Источник) = Тип("ДокументОбъект.CW_ДоходыПоГрузоперевозке") Тогда
		
		ФинРезульат 	= Неопределено;
		СтруктураНастроек.СвойСтво("ФинРезульат", ФинРезульат); 
		ФинРезульат 	= ?(ФинРезульат = Неопределено, Ложь, ФинРезульат);
		
		МассивПроверяемыхРеквизитов = новый Массив;
		МассивПроверяемыхРеквизитов.Добавить("СчетУчетаКлиентов");
		МассивПроверяемыхРеквизитов.Добавить("СчетАвансовКлиентов");
		
		Если ФинРезульат Тогда
			МассивПроверяемыхРеквизитов.Добавить("СчетУчетаФинРезультата");
		КонецЕсли;
		
		//Особая проверка с учетом Аналитики
		МассивПроверяемыхРеквизитовВОсобомПорядке = Новый Массив;
		МассивПроверяемыхРеквизитовВОсобомПорядке.Добавить("СчетУчетаДоходов");
		
		СтруктураПроверяемыхРеквизитов = новый Структура;
		СтруктураПроверяемыхРеквизитов.Вставить("Реквизиты"				, МассивПроверяемыхРеквизитов);
		СтруктураПроверяемыхРеквизитов.Вставить("РеквизитыОсобыйПорядок", МассивПроверяемыхРеквизитовВОсобомПорядке);
		
		ПроверитьЗаполнениеРеквизитов(СтруктураНастроек, СтруктураПроверяемыхРеквизитов, Отказ);
		
		
	ИначеЕсли ТипЗнч(Источник) = Тип("ДокументОбъект.CW_КорректировкаОперативнойЗадолженности") Тогда
		
		МассивПроверяемыхРеквизитов = новый Массив;
		МассивПроверяемыхРеквизитов.Добавить("СчетУчетаКлиентов");
		МассивПроверяемыхРеквизитов.Добавить("СчетУчетаПоставщиков");
		МассивПроверяемыхРеквизитов.Добавить("СчетУчетаЗатрат");
		
		//Особая проверка с учетом Аналитики
		МассивПроверяемыхРеквизитовВОсобомПорядке = Новый Массив;
		МассивПроверяемыхРеквизитовВОсобомПорядке.Добавить("СчетУчетаДоходов");
		
		СтруктураПроверяемыхРеквизитов = новый Структура;
		СтруктураПроверяемыхРеквизитов.Вставить("Реквизиты"				, МассивПроверяемыхРеквизитов);
		СтруктураПроверяемыхРеквизитов.Вставить("РеквизитыОсобыйПорядок", МассивПроверяемыхРеквизитовВОсобомПорядке);
		
		ПроверитьЗаполнениеРеквизитов(СтруктураНастроек, СтруктураПроверяемыхРеквизитов, Отказ);
		
		ПроверитьСчетаКурсовыхРазниц = истина;
		
	ИначеЕсли ТипЗнч(Источник) = Тип("ДокументОбъект.CW_РасходыПоПриобретениям") Тогда
		
		МассивПроверяемыхРеквизитов = новый Массив;
		МассивПроверяемыхРеквизитов.Добавить("СчетУчетаПоставщиков");
		МассивПроверяемыхРеквизитов.Добавить("СчетУчетаЗатрат");
		
		СтруктураПроверяемыхРеквизитов = новый Структура;
		СтруктураПроверяемыхРеквизитов.Вставить("Реквизиты", МассивПроверяемыхРеквизитов);
		
		ПроверитьЗаполнениеРеквизитов(СтруктураНастроек, СтруктураПроверяемыхРеквизитов, Отказ);
		
	ИначеЕсли ТипЗнч(Источник) = Тип("ДокументОбъект.CW_РасходыПодотчетногоЛица") Тогда
		
		МассивПроверяемыхРеквизитов = новый Массив;
		МассивПроверяемыхРеквизитов.Добавить("СчетУчетаРасчетовСПодотчетнымиЛицами");
		МассивПроверяемыхРеквизитов.Добавить("СчетАвансовПодотчетныхЛиц");
		
		СтруктураПроверяемыхРеквизитов = новый Структура;
		СтруктураПроверяемыхРеквизитов.Вставить("Реквизиты", МассивПроверяемыхРеквизитов);
		
		ПроверитьЗаполнениеРеквизитов(СтруктураНастроек, СтруктураПроверяемыхРеквизитов, Отказ);
		
	КонецЕсли;
	
	Если ПроверитьСчетаКурсовыхРазниц Тогда
		
		//Особая проверка с учетом Аналитики
		МассивСчетаКурсовыхРазниц = Новый Массив;
		МассивСчетаКурсовыхРазниц.Добавить("СчетУчетаРасходыПоКурсовымРазницам");
		МассивСчетаКурсовыхРазниц.Добавить("СчетУчетаДоходыПоКурсовымРазницам");
		
		СтруктураПроверяемыхРеквизитов = новый Структура;
		СтруктураПроверяемыхРеквизитов.Вставить("РеквизитыОсобыйПорядок", МассивСчетаКурсовыхРазниц);
		
		ПроверитьЗаполнениеРеквизитов(СтруктураНастроек, СтруктураПроверяемыхРеквизитов, Отказ);
		
	КонецЕсли;
	
	Возврат Отказ;
	
КонецФункции

Процедура ПроверитьЗаполнениеРеквизитов(СтруктураНастроек, СтруктураПроверяемыхРеквизитов, Отказ)
	
	Если СтруктураПроверяемыхРеквизитов.Свойство("Реквизиты") тогда
		
		Для Каждого ЭлементМассива из СтруктураПроверяемыхРеквизитов.Реквизиты Цикл
			
			ЗначениеСвойства = Неопределено;
			СтруктураНастроек.Свойство(ЭлементМассива,ЗначениеСвойства);
			
			Если не ЗначениеЗаполнено(ЗначениеСвойства) тогда
				Отказ = истина;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Если СтруктураПроверяемыхРеквизитов.Свойство("РеквизитыОсобыйПорядок") тогда
		
		Для Каждого ЭлементМассива из СтруктураПроверяемыхРеквизитов.РеквизитыОсобыйПорядок Цикл
			
			ЗначениеСвойства = Неопределено;
			СтруктураНастроек.Свойство(ЭлементМассива,ЗначениеСвойства);
			
			Если Не ЗначениеЗаполнено(ЗначениеСвойства) тогда
				Отказ = истина;
			Иначе
				УчетПоДоходамИРасходам	= CW_БухгалтерскийУчетВызовСервераПовтИспМСФО.НаСчетеВедетсяУчетПоДоходамИРасходам(ЗначениеСвойства);
				Если УчетПоДоходамИРасходам Тогда
					ЗначениеСвойстваАналитика = Неопределено;
					СтруктураНастроек.СвойСтво(ЭлементМассива+"Аналитика", ЗначениеСвойстваАналитика);
					Если Не ЗначениеЗаполнено(ЗначениеСвойстваАналитика)   Тогда
						Отказ = истина;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры




//ПРОЦЕДРУЫ ВЫПОЛНЕНИЯ ДВИЖЕНИЙ

//ДВИЖЕНИЯ ДОКУМЕНТА "РАСХОДЫ ПО ГРУЗОПЕРЕВОЗКЕ"
Процедура СформированияДвиженияДокумента_РасходыПоГрузоперевозке(Источник, СтруктураНастроек, Отказ)
	
	ЗапросПоШапке = новый Запрос;
	ЗапросПоШапке.Текст = "ВЫБРАТЬ
	|	CW_РасходыПоГрузоперевозке.Ссылка КАК Ссылка,
	|	CW_РасходыПоГрузоперевозке.Дата КАК Дата,
	|	CW_РасходыПоГрузоперевозке.Организация КАК Организация,
	|	CW_РасходыПоГрузоперевозке.ПодразделениеОрганизации КАК ПодразделениеОрганизации,
	|	CW_РасходыПоГрузоперевозке.Контрагент КАК Контрагент,
	|	CW_РасходыПоГрузоперевозке.Договор КАК Договор,
	|	CW_РасходыПоГрузоперевозке.Валюта КАК Валюта,
	|	CW_РасходыПоГрузоперевозке.ПредставлениеДокумента КАК ПредставлениеДокумента
	|ИЗ
	|	Документ.CW_РасходыПоГрузоперевозке КАК CW_РасходыПоГрузоперевозке
	|ГДЕ
	|	CW_РасходыПоГрузоперевозке.Ссылка = &ИсточникСсылка";
	
	ЗапросПоШапке.УстановитьПараметр("ИсточникСсылка", Источник.Ссылка);
	ВыборкаПоШапке = ЗапросПоШапке.Выполнить().Выбрать();
	ВыборкаПоШапке.Следующий();
	
	СвойстваСчетУчетаПоставщиков	= CW_БухгалтерскийУчетВызовСервераПовтИспМСФО.ПолучитьСвойстваСчета(СтруктураНастроек.СчетУчетаПоставщиков);
	СвойстваСчетАвансовПоставщиков	= CW_БухгалтерскийУчетВызовСервераПовтИспМСФО.ПолучитьСвойстваСчета(СтруктураНастроек.СчетАвансовПоставщиков);
	СвойстваСчетУчетаЗатрат			= CW_БухгалтерскийУчетВызовСервераПовтИспМСФО.ПолучитьСвойстваСчета(СтруктураНастроек.СчетУчетаЗатрат);
	
	#Область Получение_данных
	
	//Получаем наборы движений
	НаборЗаписей_ОЗ = _сф.НаборЗаписейПоРегистратору(РегистрыНакопления.CW_ОперативнаяКредиторскаяЗадолженность,ВыборкаПоШапке.Ссылка);
	НаборЗаписей_ОЗ.Прочитать();
	
	НаборЗаписей_Расходы = _сф.НаборЗаписейПоРегистратору(РегистрыНакопления.CW_РасходыПоГрузоперевозкам,ВыборкаПоШапке.Ссылка);
	НаборЗаписей_Расходы.Прочитать();
	
	ОперативнаяКредиторскаяЗадолженность 	= НаборЗаписей_ОЗ.Выгрузить();
	РасходыПоГрузоперевозкам				= НаборЗаписей_Расходы.Выгрузить();
	
	Запрос = новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.Текст = "ВЫБРАТЬ
	|	CW_ОперативнаяКредиторскаяЗадолженностьОбороты.НомерСтроки КАК НомерСтроки,
	|	CW_ОперативнаяКредиторскаяЗадолженностьОбороты.Контрагент КАК Контрагент,
	|	CW_ОперативнаяКредиторскаяЗадолженностьОбороты.Договор КАК Договор,
	|	CW_ОперативнаяКредиторскаяЗадолженностьОбороты.ВидОперации КАК ВидОперации,
	|	CW_ОперативнаяКредиторскаяЗадолженностьОбороты.Счет КАК Счет,
	|	CW_ОперативнаяКредиторскаяЗадолженностьОбороты.Всего_Валюта КАК СуммаАвансаВал,
	|	CW_ОперативнаяКредиторскаяЗадолженностьОбороты.Всего КАК СуммаАвансаРег
	|ПОМЕСТИТЬ ВТ_ЗачтенныеАвансы
	|ИЗ
	|	&ОперативнаяКредиторскаяЗадолженность КАК CW_ОперативнаяКредиторскаяЗадолженностьОбороты
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	CW_РасходыПоГрузоперевозкамОбороты.Контрагент КАК Контрагент,
	|	CW_РасходыПоГрузоперевозкамОбороты.Договор КАК Договор,
	|	CW_РасходыПоГрузоперевозкамОбороты.СтатьяЗатрат КАК СтатьяЗатрат,
	|	CW_РасходыПоГрузоперевозкамОбороты.Номенклатура КАК Номенклатура,
	|	CW_РасходыПоГрузоперевозкамОбороты.ДокументРасходов КАК ДокументРасходов,
	|	CW_РасходыПоГрузоперевозкамОбороты.Покупатель КАК Покупатель,
	|	CW_РасходыПоГрузоперевозкамОбороты.ДоговорПокупателя КАК ДоговорПокупателя,
	|	CW_РасходыПоГрузоперевозкамОбороты.Всего КАК СуммаРег,
	|	CW_РасходыПоГрузоперевозкамОбороты.Всего_Валюта КАК СуммаВал
	|ПОМЕСТИТЬ ВТ_Расходы
	|ИЗ
	|	&РасходыПоГрузоперевозкам КАК CW_РасходыПоГрузоперевозкамОбороты";
	
	Запрос.УстановитьПараметр("ОперативнаяКредиторскаяЗадолженность"	, ОперативнаяКредиторскаяЗадолженность);
	Запрос.УстановитьПараметр("РасходыПоГрузоперевозкам"				, РасходыПоГрузоперевозкам);
	
	Запрос.Выполнить();
	
	
	Запрос.Текст = "ВЫБРАТЬ
	|	ВТ_ЗачтенныеАвансы.Контрагент КАК Контрагент,
	|	ВТ_ЗачтенныеАвансы.Договор КАК Договор,
	|	СУММА(ВТ_ЗачтенныеАвансы.СуммаАвансаВал) КАК СуммаАвансаВал,
	|	СУММА(ВТ_ЗачтенныеАвансы.СуммаАвансаРег) КАК СуммаАвансаРег
	|ИЗ
	|	ВТ_ЗачтенныеАвансы КАК ВТ_ЗачтенныеАвансы
	|ГДЕ
	|	ВТ_ЗачтенныеАвансы.ВидОперации = &ЗачетАванса
	|	И ВТ_ЗачтенныеАвансы.Счет = &ТекущийСчет
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_ЗачтенныеАвансы.Контрагент,
	|	ВТ_ЗачтенныеАвансы.Договор";
	
	Запрос.УстановитьПараметр("ЗачетАванса"	, Перечисления.CW_ВидыДвиженийПоОперативнойЗадолженности.ЗачетАванса);
	Запрос.УстановитьПараметр("ТекущийСчет"	, ВыборкаПоШапке.Ссылка);
	
	РезультатАвансы = Запрос.Выполнить();
	
	Запрос.Текст = "ВЫБРАТЬ
	|	ВТ_Расходы.Контрагент КАК Контрагент,
	|	ВТ_Расходы.Договор КАК Договор,
	|	ВТ_Расходы.СтатьяЗатрат КАК СтатьяЗатрат,
	|	ВТ_Расходы.Номенклатура КАК Номенклатура,
	|	ВТ_Расходы.Номенклатура.НоменклатурнаяГруппа КАК НоменклатурнаяГруппа,
	|	СУММА(ВТ_Расходы.СуммаРег) КАК СуммаРег,
	|	СУММА(ВТ_Расходы.СуммаВал) КАК СуммаВал
	|ИЗ
	|	ВТ_Расходы КАК ВТ_Расходы
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_Расходы.СтатьяЗатрат,
	|	ВТ_Расходы.Договор,
	|ВТ_Расходы.Номенклатура.НоменклатурнаяГруппа,
	|	ВТ_Расходы.Номенклатура,
	|	ВТ_Расходы.Контрагент";
	
	Запрос.УстановитьПараметр("ПорядокОтраженияЗатрарты", Перечисления.CW_ПорядокОтраженияЗатрат.Затраты);
	
	РезультатЗатрарты = Запрос.Выполнить();
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	CW_ОперативнаяКредиторскаяЗадолженностьОбороты.Контрагент КАК Контрагент,
	               |	CW_ОперативнаяКредиторскаяЗадолженностьОбороты.Договор КАК Договор,
	               |	CW_ОперативнаяКредиторскаяЗадолженностьОбороты.Счет КАК Счет,
	               |	CW_ОперативнаяКредиторскаяЗадолженностьОбороты.Всего КАК СуммаАвансаРег
	               |ПОМЕСТИТЬ ВТ_КурсовыеРазницы
	               |ИЗ
	               |	&ОперативнаяКредиторскаяЗадолженность КАК CW_ОперативнаяКредиторскаяЗадолженностьОбороты
	               |ГДЕ
	               |	CW_ОперативнаяКредиторскаяЗадолженностьОбороты.ВидОперации = &ВидОперации
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ_КурсовыеРазницы.Контрагент КАК Контрагент,
	               |	ВТ_КурсовыеРазницы.Договор КАК Договор,
	               |	ВТ_КурсовыеРазницы.Счет КАК Счет,
	               |	ВТ_КурсовыеРазницы.СуммаАвансаРег КАК Всего
	               |ИЗ
	               |	ВТ_КурсовыеРазницы КАК ВТ_КурсовыеРазницы";


	Запрос.УстановитьПараметр("ОперативнаяКредиторскаяЗадолженность", ОперативнаяКредиторскаяЗадолженность);
	Запрос.УстановитьПараметр("ВидОперации", Перечисления.CW_ВидыДвиженийПоОперативнойЗадолженности.КурсоваяРазница);
	
	РезультатКурсовые = Запрос.Выполнить();
	#КонецОбласти
	
	#Область Авансы
	
	ВыборкаАвансы = РезультатАвансы.Выбрать();
	
	Пока ВыборкаАвансы.Следующий() Цикл
		
		Движение = Источник.Движения.CW_МСФО.Добавить();
		Движение.Период			= ВыборкаПоШапке.Дата;
		Движение.Организация 	= ВыборкаПоШапке.Организация;
		
		//ДЕБЕТ
		Движение.СчетДт 		=  СтруктураНастроек.СчетУчетаПоставщиков;
		
		//Учет по подразделениям
		Если СвойстваСчетУчетаПоставщиков.УчетПоПодразделениям Тогда
			Движение.ПодразделениеКт =  ВыборкаПоШапке.ПодразделениеОрганизации;
		КонецЕсли;
		
		//Валюта Дт
		Если СвойстваСчетУчетаПоставщиков.Валютный Тогда
			Движение.ВалютаДт 			= ВыборкаПоШапке.Валюта;
			Движение.ВалютнаяСуммаДт 	= ВыборкаАвансы.СуммаАвансаВал;
		КонецЕсли;
		
		//Субконто Дт
		CW_БухгалтерскийУчетМСФО.УстановитьСубконто(Движение.СчетДт, Движение.СубконтоДт, "Контрагенты"						, ВыборкаАвансы.Контрагент);
		CW_БухгалтерскийУчетМСФО.УстановитьСубконто(Движение.СчетДт, Движение.СубконтоДт, "Договоры"						, ВыборкаАвансы.Договор);
		CW_БухгалтерскийУчетМСФО.УстановитьСубконто(Движение.СчетДт, Движение.СубконтоДт, "ДокументыРасчетовСКонтрагентами"	, ВыборкаПоШапке.Ссылка);
		
		//КРЕДИТ
		Движение.СчетКт 		= СтруктураНастроек.СчетАвансовПоставщиков;
		
		//Учет по подразделениям
		Если СвойстваСчетАвансовПоставщиков.УчетПоПодразделениям Тогда
			Движение.ПодразделениеКт =  ВыборкаПоШапке.ПодразделениеОрганизации;
		КонецЕсли;
		
		//Валюта Дт
		Если СвойстваСчетАвансовПоставщиков.Валютный Тогда
			Движение.ВалютаКт 			= ВыборкаПоШапке.Валюта;
			Движение.ВалютнаяСуммаКт 	= ВыборкаАвансы.СуммаАвансаВал;
		КонецЕсли;
		
		//СубконтоКт
		CW_БухгалтерскийУчетМСФО.УстановитьСубконто(Движение.СчетКт, Движение.СубконтоКт, "Контрагенты"				, ВыборкаАвансы.Контрагент);
		CW_БухгалтерскийУчетМСФО.УстановитьСубконто(Движение.СчетКт, Движение.СубконтоКт, "Договоры"				, ВыборкаАвансы.Договор);
		
		Движение.Содержание = "Prepayment issued is read"; 
		Движение.Сумма 		= ВыборкаАвансы.СуммаАвансаРег;
		
	КонецЦикла;
	
	#Конецобласти
	
	#Область Затраты
	
	ВыборкаЗатраты = РезультатЗатрарты.Выбрать();
	
	Пока ВыборкаЗатраты.Следующий() Цикл
		
		Движение = Источник.Движения.CW_МСФО.Добавить();
		Движение.Период			= ВыборкаПоШапке.Дата;
		Движение.Организация 	= ВыборкаПоШапке.Организация;
		
		
		//ДЕБЕТ
		Движение.СчетДт 		= СтруктураНастроек.СчетУчетаЗатрат;
		
		//Учет по подразделениям
		Если СвойстваСчетУчетаЗатрат.УчетПоПодразделениям Тогда
			Движение.ПодразделениеДт =  ВыборкаПоШапке.ПодразделениеОрганизации;
		КонецЕсли;
		
		//Валюта Дт
		Если СвойстваСчетУчетаЗатрат.Валютный Тогда
			Движение.ВалютаДт 			= ВыборкаПоШапке.Валюта;
			Движение.ВалютнаяСуммаДт 	= ВыборкаЗатраты.СуммаВал;
		КонецЕсли;
		
		//СубконтоДт
		CW_БухгалтерскийУчетМСФО.УстановитьСубконто(Движение.СчетДт, Движение.СубконтоДт, "СтатьиЗатрат"			, ВыборкаЗатраты.СтатьяЗатрат);
		CW_БухгалтерскийУчетМСФО.УстановитьСубконто(Движение.СчетДт, Движение.СубконтоДт, "НоменклатурныеГруппы"	, ВыборкаЗатраты.НоменклатурнаяГруппа);
		
		
		//КРЕДИТ
		Движение.СчетКт 		=  СтруктураНастроек.СчетУчетаПоставщиков;
		
		//Учет по подразделениям
		Если СвойстваСчетУчетаПоставщиков.УчетПоПодразделениям Тогда
			Движение.ПодразделениеКт =  ВыборкаПоШапке.ПодразделениеОрганизации;
		КонецЕсли;
		
		//Валюта Кт
		Если СвойстваСчетУчетаПоставщиков.Валютный Тогда
			Движение.ВалютаКт 			= ВыборкаПоШапке.Валюта;
			Движение.ВалютнаяСуммаКт 	= ВыборкаЗатраты.СуммаВал;
		КонецЕсли;
		
		//СубконтоКт
		CW_БухгалтерскийУчетМСФО.УстановитьСубконто(Движение.СчетКт, Движение.СубконтоКт, "Контрагенты"				, ВыборкаЗатраты.Контрагент);
		CW_БухгалтерскийУчетМСФО.УстановитьСубконто(Движение.СчетКт, Движение.СубконтоКт, "Договоры"				, ВыборкаЗатраты.Договор);
		CW_БухгалтерскийУчетМСФО.УстановитьСубконто(Движение.СчетКт, Движение.СубконтоКт, "ДокументыРасчетовСКонтрагентами"	, ВыборкаПоШапке.Ссылка);
		
		Движение.Содержание = "Freight costs"; 
		Движение.Сумма 		= ВыборкаЗатраты.СуммаРег;
		
	КонецЦикла;
	
	
	
	#КонецОбласти
	
#Область Курсовые


	ВыборкаКурсовыеРазницы = РезультатКурсовые.Выбрать();
	
	///////
	Пока ВыборкаКурсовыеРазницы.Следующий() Цикл
			
			ДанныеДляПроводки = Новый Структура;
			ДанныеДляПроводки.Вставить("Дата"					, ВыборкаПоШапке.Дата);
			ДанныеДляПроводки.Вставить("Организация"			, ВыборкаПоШапке.Организация);
			ДанныеДляПроводки.Вставить("Подразделение"			, ВыборкаПоШапке.ПодразделениеОрганизации);
			ДанныеДляПроводки.Вставить("Валюта"					, ВыборкаПоШапке.Валюта);
			
			ДанныеДляПроводки.Вставить("КоррСчет"				, СтруктураНастроек.СчетУчетаПоставщиков);
			ДанныеДляПроводки.Вставить("КоррПодразделение"		, ВыборкаПоШапке.ПодразделениеОрганизации);
			ДанныеДляПроводки.Вставить("КоррСубконто1"			, ВыборкаКурсовыеРазницы.Контрагент);
			ДанныеДляПроводки.Вставить("КоррСубконто2"			, ВыборкаКурсовыеРазницы.Договор);
			ДанныеДляПроводки.Вставить("КоррСубконто3"			, ВыборкаПоШапке.Ссылка);
			
			ДанныеДляПроводки.Вставить("СуммаКурсовойРазницы"	, -ВыборкаКурсовыеРазницы.Всего);
			
			ВыполнитьДвиженияПоКурсовымРазницам(Источник.Движения.CW_МСФО, СтруктураНастроек, ДанныеДляПроводки, Отказ);
			
		КонецЦикла;

			
#КонецОбласти
	
КонецПроцедуры


//ДВИЖЕНИЯ ДОКУМЕНТА "ДОХОДЫ ПО ГРУЗОПЕРЕВОЗКЕ"
Процедура СформированияДвиженияДокумента_ДоходыПоГрузоперевозке(Источник, СтруктураНастроек,Отказ)
	
	ЗапросПоШапке = новый Запрос;
	ЗапросПоШапке.Текст = "ВЫБРАТЬ
	|	CW_ДоходыПоГрузоперевозке.Ссылка КАК Ссылка,
	|	CW_ДоходыПоГрузоперевозке.Дата КАК Дата,
	|	CW_ДоходыПоГрузоперевозке.Организация КАК Организация,
	|	CW_ДоходыПоГрузоперевозке.ПодразделениеОрганизации КАК ПодразделениеОрганизации,
	|	CW_ДоходыПоГрузоперевозке.Контрагент КАК Контрагент,
	|	CW_ДоходыПоГрузоперевозке.Договор КАК Договор,
	|	CW_ДоходыПоГрузоперевозке.Валюта КАК Валюта,
	|	CW_ДоходыПоГрузоперевозке.ПредставлениеДокумента КАК ПредставлениеДокумента
	|ИЗ
	|	Документ.CW_ДоходыПоГрузоперевозке КАК CW_ДоходыПоГрузоперевозке
	|ГДЕ
	|	CW_ДоходыПоГрузоперевозке.Ссылка = &ИсточникСсылка";
	
	ЗапросПоШапке.УстановитьПараметр("ИсточникСсылка", Источник.Ссылка);
	ВыборкаПоШапке =ЗапросПоШапке.Выполнить().Выбрать();
	ВыборкаПоШапке.Следующий();
	
	СвойстваСчетУчетаКлиентов 		= CW_БухгалтерскийУчетВызовСервераПовтИспМСФО.ПолучитьСвойстваСчета(СтруктураНастроек.СчетУчетаКлиентов);
	СвойстваСчетАвансовКлиентов 	= CW_БухгалтерскийУчетВызовСервераПовтИспМСФО.ПолучитьСвойстваСчета(СтруктураНастроек.СчетАвансовКлиентов);
	СвойстваСчетУчетаДоходов 		= CW_БухгалтерскийУчетВызовСервераПовтИспМСФО.ПолучитьСвойстваСчета(СтруктураНастроек.СчетУчетаДоходов);
	
	УчетПоДоходамИРасходам			= CW_БухгалтерскийУчетВызовСервераПовтИспМСФО.НаСчетеВедетсяУчетПоДоходамИРасходам(СтруктураНастроек.СчетУчетаДоходов);
	
	#Область Получение_данных
	
	НаборЗаписей_ОперативнаяДебиторскаяЗадолженность = _сф.НаборЗаписейПоРегистратору(РегистрыНакопления.CW_ОперативнаяДебиторскаяЗадолженность,ВыборкаПоШапке.Ссылка);
	НаборЗаписей_ОперативнаяДебиторскаяЗадолженность.Прочитать();
	
	НаборЗаписей_ДоходыПоГрузоперевозкам = _сф.НаборЗаписейПоРегистратору(РегистрыНакопления.CW_ДоходыПоГрузоперевозкам,ВыборкаПоШапке.Ссылка);
	НаборЗаписей_ДоходыПоГрузоперевозкам.Прочитать();
	
	НаборЗаписей_Перевыставление = _сф.НаборЗаписейПоРегистратору(РегистрыНакопления.CW_Перевыставление,ВыборкаПоШапке.Ссылка);
	НаборЗаписей_Перевыставление.Прочитать();
	
	НаборЗаписей_ПеревыставлениеПоСтавкам = _сф.НаборЗаписейПоРегистратору(РегистрыНакопления.CW_ПеревыставлениеПоСтавкам,ВыборкаПоШапке.Ссылка);
	НаборЗаписей_ПеревыставлениеПоСтавкам.Прочитать();
	
	ОперативнаяДебиторскаяЗадолженность 	= НаборЗаписей_ОперативнаяДебиторскаяЗадолженность.Выгрузить();
	ДоходыПоГрузоперевозкам 				= НаборЗаписей_ДоходыПоГрузоперевозкам.Выгрузить();
	Перевыставление							= НаборЗаписей_Перевыставление.Выгрузить();
	ПеревыставлениеПоСтавкам				= НаборЗаписей_ПеревыставлениеПоСтавкам.Выгрузить();
	
	Запрос = новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.Текст = "ВЫБРАТЬ
	|	CW_ОперативнаяДебиторскаяЗадолженностьОбороты.НомерСтроки КАК НомерСтроки,
	|	CW_ОперативнаяДебиторскаяЗадолженностьОбороты.Контрагент КАК Контрагент,
	|	CW_ОперативнаяДебиторскаяЗадолженностьОбороты.Договор КАК Договор,
	|	CW_ОперативнаяДебиторскаяЗадолженностьОбороты.ВидОперации КАК ВидОперации,
	|	CW_ОперативнаяДебиторскаяЗадолженностьОбороты.Счет КАК Счет,
	|	CW_ОперативнаяДебиторскаяЗадолженностьОбороты.Всего_Валюта КАК СуммаАвансаВал,
	|	CW_ОперативнаяДебиторскаяЗадолженностьОбороты.Всего КАК СуммаАвансаРег
	|ПОМЕСТИТЬ ВТ_ЗачтенныеАвансы
	|ИЗ
