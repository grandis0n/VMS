			ДанныеДляПроводки.Вставить("Организация"			, ВыборкаПоШапке.Организация);
			ДанныеДляПроводки.Вставить("Подразделение"			, ВыборкаПоШапке.Подразделение);
			ДанныеДляПроводки.Вставить("Валюта"					, ВыборкаКурсовыеРазницы.Валюта);
			
			ДанныеДляПроводки.Вставить("КоррСчет"				, СтруктураНастроек.СчетУчетаКлиентов);
			ДанныеДляПроводки.Вставить("КоррПодразделение"		, ВыборкаПоШапке.Подразделение);
			ДанныеДляПроводки.Вставить("КоррСубконто1"			, ВыборкаКурсовыеРазницы.Контрагент);
			ДанныеДляПроводки.Вставить("КоррСубконто2"			, ВыборкаКурсовыеРазницы.Договор);
			ДанныеДляПроводки.Вставить("КоррСубконто3"			, ВыборкаКурсовыеРазницы.Счет);
			
			ДанныеДляПроводки.Вставить("СуммаКурсовойРазницы"	, ВыборкаКурсовыеРазницы.Всего);
			
			ВыполнитьДвиженияПоНереализованнымКурсовымРазницам(Движения, СтруктураНастроек, ДанныеДляПроводки, Отказ);
			
		КонецЦикла;
		
	КонецЕсли;

КонецПроцедуры

Процедура ВыполнитьДвиженияПоПрочиеПоступления(Движения, ВыборкаПоШапке,СтруктураНастроек, Отказ)
	
	БазоваяВалюта			= CW_Настройки.ВалютаРегламентированногоУчета();
	ИспользоватьСтатьиДДС 	= ПолучитьФункциональнуюОпцию("ИспользоватьСтатьиДвиженияДенежныхСредств");
	
	Движение = Движения.Добавить();
	Движение.Период			= ВыборкаПоШапке.Дата;
	Движение.Организация 	= ВыборкаПоШапке.Организация;
	
	//ДЕБЕТ
	Движение.СчетДт 		=  ВыборкаПоШапке.КассаСчет;
	
	СвойстваКассаСчет	= CW_БухгалтерскийУчетВызовСервераПовтИспМСФО.ПолучитьСвойстваСчета(ВыборкаПоШапке.КассаСчет);
	
	//Учет по подразделениям
	Если СвойстваКассаСчет.УчетПоПодразделениям Тогда
		Движение.ПодразделениеДт =  ВыборкаПоШапке.Подразделение;
	КонецЕсли;
	
	//Валюта Кт
	Если СвойстваКассаСчет.Валютный Тогда
		Движение.ВалютаДт 			= ВыборкаПоШапке.КассаВалюта;
		Движение.ВалютнаяСуммаДт 	= ВыборкаПоШапке.КассаСумма;
	КонецЕсли;
	
	//СубконтоДт
	CW_БухгалтерскийУчетМСФО.УстановитьСубконто(Движение.СчетДт, Движение.СубконтоДт, "ДенежныеCредства"	, ВыборкаПоШапке.Касса);
	
	Если ИспользоватьСтатьиДДС Тогда
		CW_БухгалтерскийУчетМСФО.УстановитьСубконто(Движение.СчетДт, Движение.СубконтоДт, "СтатьиДвиженияДенежныхСредств"	, ВыборкаПоШапке.КассаСтатьяДДС);
	КонецЕсли;
	
	//КРЕДИТ
	Движение.СчетКт 		= ВыборкаПоШапке.Счет;
	
	СвойстваСчет = CW_БухгалтерскийУчетВызовСервераПовтИспМСФО.ПолучитьСвойстваСчета(ВыборкаПоШапке.Счет);
	
	//Количественный учет 
	Если СвойстваСчет.Количественный Тогда
		Движение.КоличествоКт =  ВыборкаПоШапке.Количество;
	КонецЕсли;
	
	//Учет по подразделениям
	Если СвойстваСчет.УчетПоПодразделениям Тогда
		Движение.ПодразделениеКт =  ВыборкаПоШапке.Подразделение;
	КонецЕсли;
	
	//Валюта Кт
	Если СвойстваСчет.Валютный Тогда
		Движение.ВалютаКт 			= ВыборкаПоШапке.КассаВалюта;
		Движение.ВалютнаяСуммаКт 	= ВыборкаПоШапке.КассаСумма;
	КонецЕсли;
	
	//СубконтоКт
	CW_БухгалтерскийУчетМСФО.УстановитьСубконто(Движение.СчетКт, Движение.СубконтоКт, 1	, ВыборкаПоШапке.Субконто1);
	CW_БухгалтерскийУчетМСФО.УстановитьСубконто(Движение.СчетКт, Движение.СубконтоКт, 2	, ВыборкаПоШапке.Субконто2);
	CW_БухгалтерскийУчетМСФО.УстановитьСубконто(Движение.СчетКт, Движение.СубконтоКт, 3	, ВыборкаПоШапке.Субконто3);
	
	Если БазоваяВалюта <> ВыборкаПоШапке.КассаВалюта Тогда
		СтруктураКурса 		= CW_Финансы.ПолучитьКурсВалюты(ВыборкаПоШапке.КассаВалюта,ВыборкаПоШапке.Дата);
		СуммаРегПоступило 	= CW_Финансы.ПересчитатьИзВалютыВВалюту(ВыборкаПоШапке.КассаСумма,ВыборкаПоШапке.КассаВалюта,БазоваяВалюта,СтруктураКурса.Курс,1,СтруктураКурса.Кратность,1);
	Иначе
		СуммаРегПоступило   = ВыборкаПоШапке.КассаСумма;
	КонецЕсли;
	
	Движение.Содержание = "Other income"; 
	Движение.Сумма 		= СуммаРегПоступило;	
	
КонецПроцедуры

Процедура ВыполнитьДвиженияПоПрочиеСписания(Движения, ВыборкаПоШапке,СтруктураНастроек, Отказ)
	
	БазоваяВалюта			= CW_Настройки.ВалютаРегламентированногоУчета();
	ИспользоватьСтатьиДДС 	= ПолучитьФункциональнуюОпцию("ИспользоватьСтатьиДвиженияДенежныхСредств");
	
	СвойстваСчетКассы		= CW_БухгалтерскийУчетВызовСервераПовтИспМСФО.ПолучитьСвойстваСчета(ВыборкаПоШапке.КассаСчет);
	СвойстваСчет 			= CW_БухгалтерскийУчетВызовСервераПовтИспМСФО.ПолучитьСвойстваСчета(ВыборкаПоШапке.Счет);
	СвойстваСчетНДС 		= CW_БухгалтерскийУчетВызовСервераПовтИспМСФО.ПолучитьСвойстваСчета(СтруктураНастроек.СчетУчетаНДС);
	
	Если ВыборкаПоШапке.УчитыватьНДС Тогда
		КассаСуммаБезНДС = ВыборкаПоШапке.КассаСумма - ВыборкаПоШапке.СуммаНДС;
	Иначе
		КассаСуммаБезНДС = ВыборкаПоШапке.КассаСумма;
	КонецЕсли;
	
	Движение = Движения.Добавить();
	Движение.Период			= ВыборкаПоШапке.Дата;
	Движение.Организация 	= ВыборкаПоШапке.Организация;
	
	//ДЕБЕТ
	Движение.СчетДт 		= ВыборкаПоШапке.Счет;
	
	//Количественный учет 
	Если СвойстваСчет.Количественный Тогда
		Движение.КоличествоДт =  ВыборкаПоШапке.Количество;
	КонецЕсли;
	
	//Учет по подразделениям
	Если СвойстваСчет.УчетПоПодразделениям Тогда
		Движение.ПодразделениеДт =  ВыборкаПоШапке.Подразделение;
	КонецЕсли;
	
	//Валюта Дт
	Если СвойстваСчет.Валютный Тогда
		Движение.ВалютаДт 			= ВыборкаПоШапке.КассаВалюта;
		Движение.ВалютнаяСуммаДт 	= КассаСуммаБезНДС;
	КонецЕсли;
	
	//СубконтоДт
	CW_БухгалтерскийУчетМСФО.УстановитьСубконто(Движение.СчетДт, Движение.СубконтоДт, 1	, ВыборкаПоШапке.Субконто1);
	CW_БухгалтерскийУчетМСФО.УстановитьСубконто(Движение.СчетДт, Движение.СубконтоДт, 2	, ВыборкаПоШапке.Субконто2);
	CW_БухгалтерскийУчетМСФО.УстановитьСубконто(Движение.СчетДт, Движение.СубконтоДт, 3	, ВыборкаПоШапке.Субконто3);
	
	//КРЕДИТ
	Движение.СчетКт 		=  ВыборкаПоШапке.КассаСчет;
	
	//Учет по подразделениям
	Если СвойстваСчетКассы.УчетПоПодразделениям Тогда
		Движение.ПодразделениеКт =  ВыборкаПоШапке.Подразделение;
	КонецЕсли;
	
	//Валюта Кт
	Если СвойстваСчетКассы.Валютный Тогда
		Движение.ВалютаКт 			= ВыборкаПоШапке.КассаВалюта;
		Движение.ВалютнаяСуммаКт 	= КассаСуммаБезНДС;
	КонецЕсли;
	
	//СубконтоКт
	CW_БухгалтерскийУчетМСФО.УстановитьСубконто(Движение.СчетКт, Движение.СубконтоКт, "ДенежныеCредства"	, ВыборкаПоШапке.Касса);
	
	Если ИспользоватьСтатьиДДС Тогда
		CW_БухгалтерскийУчетМСФО.УстановитьСубконто(Движение.СчетКт, Движение.СубконтоКт, "СтатьиДвиженияДенежныхСредств"	, ВыборкаПоШапке.КассаСтатьяДДС);
	КонецЕсли;
	
	Если БазоваяВалюта <> ВыборкаПоШапке.КассаВалюта Тогда
		СтруктураКурса 	= CW_Финансы.ПолучитьКурсВалюты(ВыборкаПоШапке.КассаВалюта,ВыборкаПоШапке.Дата);
		СуммаРегСписано = CW_Финансы.ПересчитатьИзВалютыВВалюту(ВыборкаПоШапке.КассаСумма,ВыборкаПоШапке.КассаВалюта,БазоваяВалюта,СтруктураКурса.Курс,1,СтруктураКурса.Кратность,1);
	Иначе
		СуммаРегСписано = ВыборкаПоШапке.КассаСумма;
	КонецЕсли;
	
	Движение.Содержание = "Other expenses"; 
	Движение.Сумма 		= СуммаРегСписано;
	
	
	Если ВыборкаПоШапке.УчитыватьНДС Тогда
		
		Движение = Движения.Добавить();
		Движение.Период			= ВыборкаПоШапке.Дата;
		Движение.Организация 	= ВыборкаПоШапке.Организация;
		
		//ДЕБЕТ
		Движение.СчетДт 		= ВыборкаПоШапке.СчетНДС;
		
		//Учет по подразделениям
		Если СвойстваСчетНДС.УчетПоПодразделениям Тогда
			Движение.ПодразделениеДт =  ВыборкаПоШапке.ПодразделениеОрганизации;
		КонецЕсли;
		
		//Валюта Дт
		Если СвойстваСчетНДС.Валютный Тогда
			Движение.ВалютаДт 			= ВыборкаПоШапке.КассаВалюта;
			Движение.ВалютнаяСуммаДт 	= ВыборкаПоШапке.СуммаНДС;
		КонецЕсли;
		
		//СубконтоДт
		CW_БухгалтерскийУчетМСФО.УстановитьСубконто(Движение.СчетКт, Движение.СубконтоДт, 1	, СтруктураНастроек.СчетУчетаНДССубконто1);
		CW_БухгалтерскийУчетМСФО.УстановитьСубконто(Движение.СчетКт, Движение.СубконтоДт, 2	, СтруктураНастроек.СчетУчетаНДССубконто2);
		CW_БухгалтерскийУчетМСФО.УстановитьСубконто(Движение.СчетКт, Движение.СубконтоДт, 3	, СтруктураНастроек.СчетУчетаНДССубконто3);
		
		
		//КРЕДИТ
