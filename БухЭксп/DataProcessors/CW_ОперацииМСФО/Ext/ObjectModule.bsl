		СчетКурсовыеРазницы = СтруктураНастроек.СчетУчетаДоходыПоНереализованнымКурсовымРазницам;
		Признак 			= "Кт";
		КоррПризнак 		= "Дт";
		СвойстваСчета 		= СвойстваСчетУчетаДоходыПоКР;
		Если Расходы_УчетПоДоходамИРасходам тогда
			СубконтоКурсовыеРазницы	= СтруктураНастроек.СчетУчетаДоходыПоНереализованнымКурсовымРазницамАналитика;
		КонецЕсли;
		Множитель = 1;
	Иначе
		СчетКурсовыеРазницы = СтруктураНастроек.СчетУчетаРасходыПоНереализованнымКурсовымРазницам;
		Признак 			= "Дт";
		КоррПризнак 		= "Кт";
		СвойстваСчета 		= СвойстваСчетУчетаРасходыПоКР;
		Если Расходы_УчетПоДоходамИРасходам тогда
			СубконтоКурсовыеРазницы = СтруктураНастроек.СчетУчетаРасходыПоНереализованнымКурсовымРазницамАналитика;
		КонецЕсли;
		Множитель = -1;
	КонецЕсли;
	
	Движение = Движения.Добавить();
	Движение.Период			= ДанныеДляПроводки.Дата;
	Движение.Организация 	= ДанныеДляПроводки.Организация;
	
	//СЧЕТ КУРСОВЫХ РАЗНИЦ
	Движение["Счет"+Признак]= СчетКурсовыеРазницы;
	
	//Учет по подразделениям
	Если СвойстваСчета.УчетПоПодразделениям Тогда
		Движение["Подразделение"+Признак] =  ДанныеДляПроводки.Подразделение;
	КонецЕсли;
	
	//СубконтоДт
	CW_БухгалтерскийУчетМСФО.УстановитьСубконто(Движение["Счет"+Признак], Движение["Субконто"+Признак], "ПрочиеДоходыИРасходы", СубконтоКурсовыеРазницы);
	
	//КОРР.СЧЕТ
	Движение["Счет"+КоррПризнак] =  ДанныеДляПроводки.КоррСчет;
	
	//Учет по подразделениям
	Если  ДанныеДляПроводки.КоррСчет.УчетПоПодразделениям Тогда
		Движение["Подразделение"+КоррПризнак] =  ДанныеДляПроводки.КоррПодразделение;
	КонецЕсли;
	
	//Валюта Дт
	Если  ДанныеДляПроводки.КоррСчет.Валютный Тогда
		Движение["Валюта"+КоррПризнак] 			= ДанныеДляПроводки.Валюта;
	КонецЕсли;
	
	
	//СубконтоКт
	CW_БухгалтерскийУчетМСФО.УстановитьСубконто(Движение["Счет"+КоррПризнак], Движение["Субконто"+КоррПризнак], 1	, ДанныеДляПроводки.КоррСубконто1);
	CW_БухгалтерскийУчетМСФО.УстановитьСубконто(Движение["Счет"+КоррПризнак], Движение["Субконто"+КоррПризнак], 2	, ДанныеДляПроводки.КоррСубконто2);
