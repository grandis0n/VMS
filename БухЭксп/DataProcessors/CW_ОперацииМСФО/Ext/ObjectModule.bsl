			CW_БухгалтерскийУчетМСФО.УстановитьСубконто(Движение.СчетКт, Движение.СубконтоКт, "СтатьиДвиженияДенежныхСредств"	, ВыборкаПоШапке.КассаСтатьяДДС);
		КонецЕсли;
		
		Если БазоваяВалюта <> ВыборкаПоШапке.КассаВалюта Тогда
			СтруктураКурса 	= CW_Финансы.ПолучитьКурсВалюты(ВыборкаПоШапке.КассаВалюта,ВыборкаПоШапке.Дата);
			СуммаНДСРег     = CW_Финансы.ПересчитатьИзВалютыВВалюту(ВыборкаПоШапке.СуммаНДС,ВыборкаПоШапке.КассаВалюта,БазоваяВалюта,СтруктураКурса.Курс,1,СтруктураКурса.Кратность,1);
		Иначе
			СуммаНДСРег 	= ВыборкаПоШапке.СуммаНДС;
		КонецЕсли;
		
		Движение.Содержание = "VAT on other expenses"; 
		Движение.Сумма 		= СуммаНДСРег;
		
		
	КонецЕсли;
	
	Движения.Записать();
	
	#Область Курсовые_разницы
	
	Если СвойстваСчет.Валютный Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		|	CW_МСФООстатки.Счет КАК Счет,
		|	CW_МСФООстатки.ВалютнаяСуммаОстаток КАК ВалютнаяСуммаОстаток,
		|	CW_МСФООстатки.СуммаОстаток КАК СуммаОстаток
		|ИЗ
		|	РегистрБухгалтерии.CW_МСФО.Остатки(
		|			&МоментВремени,
		|			Счет = &Счет,
		|			,
		|			Организация = &Организация
		|				И ВЫБОР
		|					КОГДА &УчетПоПодразделениям
		|						ТОГДА Подразделение = &Подразделение
		|					ИНАЧЕ ИСТИНА
		|				КОНЕЦ
		|				И Валюта = &Валюта
		|				И Субконто1 = &Субконто1
		|				И Субконто2 = &Субконто2
		|				И Субконто3 = &Субконто3) КАК CW_МСФООстатки";
		
		Запрос.УстановитьПараметр("МоментВремени"			, Новый Граница(ВыборкаПоШапке.Дата, ВидГраницы.Включая));
