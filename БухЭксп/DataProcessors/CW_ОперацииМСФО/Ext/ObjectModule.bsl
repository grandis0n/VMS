			СтуктураСчетаДт.Вставить("Контрагент"	, Выборка_ОплатаПоставщику.Контрагент);
			СтуктураСчетаДт.Вставить("Договор"		, Выборка_ОплатаПоставщику.Договор);
			СтуктураСчетаДт.Вставить("Счет"			, Выборка_ОплатаПоставщику.Счет);
