			Если СвойстваСчетУчетаФинРезультата.Валютный Тогда
				Движение.ВалютаКт 			= ВыборкаПоШапке.Валюта;
				Движение.ВалютнаяСуммаКт 	= ВыборкаФинРезультат.СуммаВал;
			КонецЕсли;
			
			//СубконтоКт
			//Пробуем установить все возможные субконто, на случай если на счете фин.результата добавили свои субконто
			CW_БухгалтерскийУчетМСФО.УстановитьСубконто(Движение.СчетКт, Движение.СубконтоКт	, "Контрагенты"						, ВыборкаДоходы.Контрагент);
			CW_БухгалтерскийУчетМСФО.УстановитьСубконто(Движение.СчетКт, Движение.СубконтоКт	, "Договоры"						, ВыборкаДоходы.Договор);
			CW_БухгалтерскийУчетМСФО.УстановитьСубконто(Движение.СчетКт, Движение.СубконтоКт	, "ДокументыРасчетовСКонтрагентами"	, ВыборкаПоШапке.Ссылка);
			CW_БухгалтерскийУчетМСФО.УстановитьСубконто(Движение.СчетКт, Движение.СубконтоКт	, "СтатьиЗатрат"					, ВыборкаФинРезультат.СтатьяЗатрат);
			CW_БухгалтерскийУчетМСФО.УстановитьСубконто(Движение.СчетКт, Движение.СубконтоКт	, "НоменклатурныеГруппы"			, ВыборкаФинРезультат.НоменклатурнаяГруппа);
			
			Движение.Содержание = "Calculation of financial result for "+СокрЛП(ВыборкаПоШапке.Ссылка); 
			
			Движение.Сумма 		= ВыборкаФинРезультат.СуммаРег;
			
		КонецЦикла;
		
	КонецЕсли;
	
	#КонецОбласти
	
КонецПроцедуры


//ДВИЖЕНИЯ ДОКУМЕНТА "КОРРЕКТИРОВКА ОПЕРАТИВНОЙ ЗАДОЛЖЕННОСТИ"
Процедура СформированияДвиженияДокумента_КорректировкаОперативнойЗадолженности(Источник, СтруктураНастроек, Отказ)
	
	ЗапросПоШапке = новый Запрос;
	ЗапросПоШапке.Текст = "ВЫБРАТЬ
	|	CW_КорректировкаОперативнойЗадолженности.Ссылка КАК Ссылка,
	|	CW_КорректировкаОперативнойЗадолженности.Дата КАК Дата,
	|	CW_КорректировкаОперативнойЗадолженности.Организация КАК Организация,
	|	CW_КорректировкаОперативнойЗадолженности.Валюта КАК Валюта,
	|	CW_КорректировкаОперативнойЗадолженности.ВидОперации КАК ВидОперации,
	|	CW_КорректировкаОперативнойЗадолженности.ВидЗадолженности КАК ВидЗадолженности,
	|	CW_КорректировкаОперативнойЗадолженности.СчетСписания КАК СчетСписания,
	|	CW_КорректировкаОперативнойЗадолженности.Подразделение КАК Подразделение,
	|	CW_КорректировкаОперативнойЗадолженности.Субконто1 КАК Субконто1,
	|	CW_КорректировкаОперативнойЗадолженности.Субконто2 КАК Субконто2,
	|	CW_КорректировкаОперативнойЗадолженности.Субконто3 КАК Субконто3
	|ИЗ
	|	Документ.CW_КорректировкаОперативнойЗадолженности КАК CW_КорректировкаОперативнойЗадолженности
	|ГДЕ
	|	CW_КорректировкаОперативнойЗадолженности.Ссылка = &ИсточникСсылка";
	
	ЗапросПоШапке.УстановитьПараметр("ИсточникСсылка", Источник.Ссылка);
	ВыборкаПоШапке =ЗапросПоШапке.Выполнить().Выбрать();
	ВыборкаПоШапке.Следующий();
	
	Если ВыборкаПоШапке.ВидОперации = Перечисления.CW_ВидыОперацийКорректировкиОперативнойЗадолженности.СписаниеЗадолженности Тогда
		Если ВыборкаПоШапке.ВидЗадолженности = Перечисления.CW_ВидыОперативнойЗадолженности.Дебиторская тогда
			ВыполнитьСписаниеДебиторскойЗадолженности(Источник.Движения.CW_МСФО, ВыборкаПоШапке, СтруктураНастроек, Отказ);
		Иначе
			ВыполнитьСписаниеКредиторскойЗадолженности(Источник.Движения.CW_МСФО, ВыборкаПоШапке, СтруктураНастроек, Отказ);
		КонецЕсли;
	Иначе
		ВыполнитьЗачетЗадолженности(Источник.Движения.CW_МСФО, ВыборкаПоШапке, СтруктураНастроек, Отказ);
	КонецЕсли;
	
КонецПроцедуры

Процедура ВыполнитьСписаниеДебиторскойЗадолженности(Движения,ВыборкаПоШапке, СтруктураНастроек, Отказ)
	
	СтруктураКоррСчета = Новый Структура;
	СтруктураКоррСчета.Вставить("Счет"			, ВыборкаПоШапке.СчетСписания);
	СтруктураКоррСчета.Вставить("Субконто1"		, ВыборкаПоШапке.Субконто1);
	СтруктураКоррСчета.Вставить("Субконто2"		, ВыборкаПоШапке.Субконто2);
	СтруктураКоррСчета.Вставить("Субконто3"		, ВыборкаПоШапке.Субконто3);
	СтруктураКоррСчета.Вставить("Подразделение"	, ВыборкаПоШапке.Подразделение);
	
	//СписаниеЗадолженности
	СвойстваКоррСчета			= CW_БухгалтерскийУчетВызовСервераПовтИспМСФО.ПолучитьСвойстваСчета(ВыборкаПоШапке.СчетСписания);
	СвойстваСчетУчетаКлиентов	= CW_БухгалтерскийУчетВызовСервераПовтИспМСФО.ПолучитьСвойстваСчета(СтруктураНастроек.СчетУчетаКлиентов);
	
	#Область Получение_данных
	НаборЗаписей_ОперативнаяДебиторскаяЗадолженность = _сф.НаборЗаписейПоРегистратору(РегистрыНакопления.CW_ОперативнаяДебиторскаяЗадолженность,ВыборкаПоШапке.Ссылка);
	НаборЗаписей_ОперативнаяДебиторскаяЗадолженность.Прочитать();
	
	ОперативнаяДебиторскаяЗадолженность	= НаборЗаписей_ОперативнаяДебиторскаяЗадолженность.Выгрузить();
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	запрос.Текст = "ВЫБРАТЬ
	|	CW_ОперативнаяДебиторскаяЗадолженность.ВидДвижения КАК ВидДвижения,
	|	ВЫБОР
	|		КОГДА CW_ОперативнаяДебиторскаяЗадолженность.ВидОперации = &КурсоваяРазница
	|			ТОГДА CW_ОперативнаяДебиторскаяЗадолженность.ВидОперации
	|		ИНАЧЕ НЕОПРЕДЕЛЕНО
	|	КОНЕЦ КАК ВидОперации,
	|	CW_ОперативнаяДебиторскаяЗадолженность.Организация КАК Организация,
	|	CW_ОперативнаяДебиторскаяЗадолженность.Контрагент КАК Контрагент,
	|	CW_ОперативнаяДебиторскаяЗадолженность.Валюта КАК Валюта,
	|	CW_ОперативнаяДебиторскаяЗадолженность.Договор КАК Договор,
	|	CW_ОперативнаяДебиторскаяЗадолженность.Счет КАК Счет,
	|	CW_ОперативнаяДебиторскаяЗадолженность.Всего_Валюта КАК Всего_Валюта,
	|	CW_ОперативнаяДебиторскаяЗадолженность.Всего КАК Всего
	|ПОМЕСТИТЬ ВТ_ДвиженияДокумента
	|ИЗ
	|	&ОперативнаяДебиторскаяЗадолженность КАК CW_ОперативнаяДебиторскаяЗадолженность
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ДвиженияДокумента.Организация КАК Организация,
	|	ВТ_ДвиженияДокумента.Контрагент КАК Контрагент,
	|	ВТ_ДвиженияДокумента.Договор КАК Договор,
	|	ВТ_ДвиженияДокумента.Валюта КАК Валюта,
	|	ВТ_ДвиженияДокумента.Счет КАК Счет,
	|	СУММА(ВТ_ДвиженияДокумента.Всего_Валюта) КАК Всего_Валюта,
	|	СУММА(ВТ_ДвиженияДокумента.Всего) КАК Всего
	|ИЗ
	|	ВТ_ДвиженияДокумента КАК ВТ_ДвиженияДокумента
	|ГДЕ
	|	ВТ_ДвиженияДокумента.ВидОперации = &КурсоваяРазница
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_ДвиженияДокумента.Контрагент,
	|	ВТ_ДвиженияДокумента.Валюта,
	|	ВТ_ДвиженияДокумента.Договор,
	|	ВТ_ДвиженияДокумента.Счет,
	|	ВТ_ДвиженияДокумента.Организация
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ДвиженияДокумента.Организация КАК Организация,
	|	ВТ_ДвиженияДокумента.Контрагент КАК Контрагент,
	|	ВТ_ДвиженияДокумента.Договор КАК Договор,
	|	ВТ_ДвиженияДокумента.Валюта КАК Валюта,
	|	ВТ_ДвиженияДокумента.Счет КАК Счет,
	|	СУММА(ВТ_ДвиженияДокумента.Всего_Валюта) КАК Всего_Валюта,
	|	СУММА(ВТ_ДвиженияДокумента.Всего) КАК Всего
	|ИЗ
	|	ВТ_ДвиженияДокумента КАК ВТ_ДвиженияДокумента
	|ГДЕ
	|	ВТ_ДвиженияДокумента.ВидОперации = НЕОПРЕДЕЛЕНО
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_ДвиженияДокумента.Организация,
	|	ВТ_ДвиженияДокумента.Контрагент,
	|	ВТ_ДвиженияДокумента.Договор,
	|	ВТ_ДвиженияДокумента.Валюта,
	|	ВТ_ДвиженияДокумента.Счет";
	
	Запрос.УстановитьПараметр("ОперативнаяДебиторскаяЗадолженность"	, ОперативнаяДебиторскаяЗадолженность);
	Запрос.УстановитьПараметр("КурсоваяРазница" 					, Перечисления.CW_ВидыДвиженийПоОперативнойЗадолженности.КурсоваяРазница);
	
	мРезультатыЗапроса =	Запрос.ВыполнитьПакет();
	
	#КонецОбласти
	
	//Списание затрат
	РезультатСписаниеЗатрат = мРезультатыЗапроса[2];
	ВыборкаСписаниеЗатрат 	= РезультатСписаниеЗатрат.Выбрать();
	Пока ВыборкаСписаниеЗатрат.Следующий() Цикл
		
		Движение = Движения.Добавить();
		Движение.Период			= ВыборкаПоШапке.Дата;
		Движение.Организация 	= ВыборкаПоШапке.Организация;
		
		//КРЕДИТ
		Движение.СчетКт 		=  СтруктураНастроек.СчетУчетаКлиентов;
		
		//Учет по подразделениям
		Если СвойстваСчетУчетаКлиентов.УчетПоПодразделениям Тогда
			Движение.ПодразделениеКт =  СтруктураКоррСчета.Подразделение;
		КонецЕсли;
		
		//Валюта Дт
		Если СвойстваСчетУчетаКлиентов.Валютный Тогда
			Движение.ВалютаКт 			= ВыборкаСписаниеЗатрат.Валюта;
			Движение.ВалютнаяСуммаКт 	= ВыборкаСписаниеЗатрат.Всего_Валюта;
		КонецЕсли;
		
		//Субконто Дт
		CW_БухгалтерскийУчетМСФО.УстановитьСубконто(Движение.СчетКт, Движение.СубконтоКт, "Контрагенты"				, ВыборкаСписаниеЗатрат.Контрагент);
		CW_БухгалтерскийУчетМСФО.УстановитьСубконто(Движение.СчетКт, Движение.СубконтоКт, "Договоры"				, ВыборкаСписаниеЗатрат.Договор);
		CW_БухгалтерскийУчетМСФО.УстановитьСубконто(Движение.СчетКт, Движение.СубконтоКт, "ДокументыРасчетовСКонтрагентами"	, ВыборкаСписаниеЗатрат.Счет);
		
		
		//ДЕБЕТ
		Движение.СчетДт 		= СтруктураКоррСчета.Счет;
		
		//Учет по подразделениям
		Если СвойстваКоррСчета.УчетПоПодразделениям Тогда
			Движение.ПодразделениеДт =  СтруктураКоррСчета.Подразделение;
		КонецЕсли;
		
		//Валюта Дт
		Если СвойстваКоррСчета.Валютный Тогда
			Движение.ВалютаДт 			= ВыборкаСписаниеЗатрат.Валюта;
			Движение.ВалютнаяСуммаДт 	= ВыборкаСписаниеЗатрат.Всего_Валюта;
		КонецЕсли;
		
		//СубконтоДт
		CW_БухгалтерскийУчетМСФО.УстановитьСубконто(Движение.СчетДт, Движение.СубконтоДт, 1, СтруктураКоррСчета.Субконто1);
		CW_БухгалтерскийУчетМСФО.УстановитьСубконто(Движение.СчетДт, Движение.СубконтоДт, 2, СтруктураКоррСчета.Субконто2);
		CW_БухгалтерскийУчетМСФО.УстановитьСубконто(Движение.СчетДт, Движение.СубконтоДт, 3, СтруктураКоррСчета.Субконто3);
		
		
		Движение.Содержание = "Written off customer debt " +СокрЛП(ВыборкаСписаниеЗатрат.Контрагент); 
		Движение.Сумма 		= ВыборкаСписаниеЗатрат.Всего;
		
	КонецЦикла;
	
	//Курсоывые разницы
	РезультатКурсовыеРазницы 	= мРезультатыЗапроса[1];
	Если Не РезультатКурсовыеРазницы.Пустой() Тогда
		
		ВыборкаКурсовыеРазницы 		= РезультатКурсовыеРазницы.Выбрать();
		
		Пока ВыборкаКурсовыеРазницы.Следующий() Цикл
			
			ДанныеДляПроводки = Новый Структура;
			ДанныеДляПроводки.Вставить("Дата"					, ВыборкаПоШапке.Дата);
			ДанныеДляПроводки.Вставить("Организация"			, ВыборкаПоШапке.Организация);
			ДанныеДляПроводки.Вставить("Подразделение"			, СтруктураКоррСчета.Подразделение);
			ДанныеДляПроводки.Вставить("Валюта"					, ВыборкаКурсовыеРазницы.Валюта);
			
			ДанныеДляПроводки.Вставить("КоррСчет"				, СтруктураНастроек.СчетУчетаКлиентов);
			ДанныеДляПроводки.Вставить("КоррПодразделение"		, СтруктураКоррСчета.Подразделение);
			ДанныеДляПроводки.Вставить("КоррСубконто1"			, ВыборкаКурсовыеРазницы.Контрагент);
			ДанныеДляПроводки.Вставить("КоррСубконто2"			, ВыборкаКурсовыеРазницы.Договор);
			ДанныеДляПроводки.Вставить("КоррСубконто3"			, ВыборкаКурсовыеРазницы.Счет);
			
			ДанныеДляПроводки.Вставить("СуммаКурсовойРазницы"	, ВыборкаКурсовыеРазницы.Всего);
			
			ВыполнитьДвиженияПоКурсовымРазницам(Движения, СтруктураНастроек, ДанныеДляПроводки, Отказ);
			
		КонецЦикла;
		
		
	КонецЕсли;
	
	
КонецПроцедуры

Процедура ВыполнитьСписаниеКредиторскойЗадолженности(Движения, ВыборкаПоШапке, СтруктураНастроек, Отказ)
	
	СтруктураКоррСчета = Новый Структура;
	СтруктураКоррСчета.Вставить("Счет"			, ВыборкаПоШапке.СчетСписания);
	СтруктураКоррСчета.Вставить("Субконто1"		, ВыборкаПоШапке.Субконто1);
	СтруктураКоррСчета.Вставить("Субконто2"		, ВыборкаПоШапке.Субконто2);
	СтруктураКоррСчета.Вставить("Субконто3"		, ВыборкаПоШапке.Субконто3);
	СтруктураКоррСчета.Вставить("Подразделение"	, ВыборкаПоШапке.Подразделение);
	
	//СписаниеЗадолженности
	СвойстваКоррСчета				= CW_БухгалтерскийУчетВызовСервераПовтИспМСФО.ПолучитьСвойстваСчета(ВыборкаПоШапке.СчетСписания);
	СвойстваСчетУчетаПоставщиков	= CW_БухгалтерскийУчетВызовСервераПовтИспМСФО.ПолучитьСвойстваСчета(СтруктураНастроек.СчетУчетаПоставщиков);
	
	#Область Получение_данных
	
	НаборЗаписей_ОперативнаяКредиторскаяЗадолженность = _сф.НаборЗаписейПоРегистратору(РегистрыНакопления.CW_ОперативнаяКредиторскаяЗадолженность,ВыборкаПоШапке.Ссылка);
	НаборЗаписей_ОперативнаяКредиторскаяЗадолженность.Прочитать();
	
	ОперативнаяКредиторскаяЗадолженность	= НаборЗаписей_ОперативнаяКредиторскаяЗадолженность.Выгрузить();
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	запрос.Текст = "ВЫБРАТЬ
	|	CW_ОперативнаяКредиторскаяЗадолженность.ВидДвижения КАК ВидДвижения,
	|	ВЫБОР
	|		КОГДА CW_ОперативнаяКредиторскаяЗадолженность.ВидОперации = &КурсоваяРазница
	|			ТОГДА CW_ОперативнаяКредиторскаяЗадолженность.ВидОперации
	|		ИНАЧЕ НЕОПРЕДЕЛЕНО
	|	КОНЕЦ КАК ВидОперации,
	|	CW_ОперативнаяКредиторскаяЗадолженность.Организация КАК Организация,
	|	CW_ОперативнаяКредиторскаяЗадолженность.Контрагент КАК Контрагент,
	|	CW_ОперативнаяКредиторскаяЗадолженность.Валюта КАК Валюта,
	|	CW_ОперативнаяКредиторскаяЗадолженность.Договор КАК Договор,
	|	CW_ОперативнаяКредиторскаяЗадолженность.Счет КАК Счет,
	|	CW_ОперативнаяКредиторскаяЗадолженность.Всего_Валюта КАК Всего_Валюта,
	|	CW_ОперативнаяКредиторскаяЗадолженность.Всего КАК Всего
	|ПОМЕСТИТЬ ВТ_ДвиженияДокумента
	|ИЗ
	|	&ОперативнаяКредиторскаяЗадолженность КАК CW_ОперативнаяКредиторскаяЗадолженность
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ДвиженияДокумента.Организация КАК Организация,
	|	ВТ_ДвиженияДокумента.Контрагент КАК Контрагент,
	|	ВТ_ДвиженияДокумента.Договор КАК Договор,
	|	ВТ_ДвиженияДокумента.Валюта КАК Валюта,
	|	ВТ_ДвиженияДокумента.Счет КАК Счет,
	|	СУММА(ВТ_ДвиженияДокумента.Всего_Валюта) КАК Всего_Валюта,
	|	СУММА(ВТ_ДвиженияДокумента.Всего) КАК Всего
	|ИЗ
	|	ВТ_ДвиженияДокумента КАК ВТ_ДвиженияДокумента
	|ГДЕ
	|	ВТ_ДвиженияДокумента.ВидОперации = &КурсоваяРазница
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_ДвиженияДокумента.Договор,
	|	ВТ_ДвиженияДокумента.Валюта,
	|	ВТ_ДвиженияДокумента.Контрагент,
	|	ВТ_ДвиженияДокумента.Организация,
	|	ВТ_ДвиженияДокумента.Счет
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ДвиженияДокумента.Организация КАК Организация,
	|	ВТ_ДвиженияДокумента.Контрагент КАК Контрагент,
	|	ВТ_ДвиженияДокумента.Договор КАК Договор,
	|	ВТ_ДвиженияДокумента.Валюта КАК Валюта,
	|	ВТ_ДвиженияДокумента.Счет КАК Счет,
	|	СУММА(ВТ_ДвиженияДокумента.Всего_Валюта) КАК Всего_Валюта,
	|	СУММА(ВТ_ДвиженияДокумента.Всего) КАК Всего
	|ИЗ
	|	ВТ_ДвиженияДокумента КАК ВТ_ДвиженияДокумента
	|ГДЕ
	|	ВТ_ДвиженияДокумента.ВидОперации = НЕОПРЕДЕЛЕНО
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_ДвиженияДокумента.Организация,
	|	ВТ_ДвиженияДокумента.Контрагент,
	|	ВТ_ДвиженияДокумента.Договор,
	|	ВТ_ДвиженияДокумента.Валюта,
	|	ВТ_ДвиженияДокумента.Счет";
	
	Запрос.УстановитьПараметр("ОперативнаяКредиторскаяЗадолженность"	, ОперативнаяКредиторскаяЗадолженность);
	Запрос.УстановитьПараметр("КурсоваяРазница"							, Перечисления.CW_ВидыДвиженийПоОперативнойЗадолженности.КурсоваяРазница);
	
	мРезультатыЗапроса =	Запрос.ВыполнитьПакет();
	
	#КонецОбласти
	
	//Списание затрат
	РезультатСписаниеЗатрат = мРезультатыЗапроса[2];
	ВыборкаСписаниеЗатрат 	= РезультатСписаниеЗатрат.Выбрать();
	Пока ВыборкаСписаниеЗатрат.Следующий() Цикл
		
		Движение = Движения.Добавить();
		Движение.Период			= ВыборкаПоШапке.Дата;
		Движение.Организация 	= ВыборкаПоШапке.Организация;
		
		//ДЕБЕТ
		Движение.СчетДт 		=  СтруктураНастроек.СчетУчетаПоставщиков;
		
		//Учет по подразделениям
		Если СвойстваСчетУчетаПоставщиков.УчетПоПодразделениям Тогда
			Движение.ПодразделениеДт =  СтруктураКоррСчета.Подразделение;
		КонецЕсли;
		
		//Валюта Дт
		Если СвойстваСчетУчетаПоставщиков.Валютный Тогда
			Движение.ВалютаДт 			= ВыборкаСписаниеЗатрат.Валюта;
			Движение.ВалютнаяСуммаДт 	= ВыборкаСписаниеЗатрат.Всего_Валюта;
		КонецЕсли;
		
		//Субконто Дт
		CW_БухгалтерскийУчетМСФО.УстановитьСубконто(Движение.СчетДт, Движение.СубконтоДт, "Контрагенты"				, ВыборкаСписаниеЗатрат.Контрагент);
		CW_БухгалтерскийУчетМСФО.УстановитьСубконто(Движение.СчетДт, Движение.СубконтоДт, "Договоры"				, ВыборкаСписаниеЗатрат.Договор);
		CW_БухгалтерскийУчетМСФО.УстановитьСубконто(Движение.СчетДт, Движение.СубконтоДт, "ДокументыРасчетовСКонтрагентами"	, ВыборкаСписаниеЗатрат.Счет);
		
		
		//КРЕДИТ
		Движение.СчетКт 		= СтруктураКоррСчета.Счет;
		
		//Учет по подразделениям
		Если СвойстваКоррСчета.УчетПоПодразделениям Тогда
			Движение.ПодразделениеКт =  СтруктураКоррСчета.Подразделение;
		КонецЕсли;
		
		//Валюта Дт
		Если СвойстваКоррСчета.Валютный Тогда
			Движение.ВалютаКт 			= ВыборкаСписаниеЗатрат.Валюта;
			Движение.ВалютнаяСуммаКт 	= ВыборкаСписаниеЗатрат.Всего_Валюта;
		КонецЕсли;
		
		//СубконтоДт
		CW_БухгалтерскийУчетМСФО.УстановитьСубконто(Движение.СчетКт, Движение.СубконтоКт, 1, СтруктураКоррСчета.Субконто1);
		CW_БухгалтерскийУчетМСФО.УстановитьСубконто(Движение.СчетКт, Движение.СубконтоКт, 2, СтруктураКоррСчета.Субконто2);
		CW_БухгалтерскийУчетМСФО.УстановитьСубконто(Движение.СчетКт, Движение.СубконтоКт, 3, СтруктураКоррСчета.Субконто3);
		
		
		Движение.Содержание = "Written off supplier debt "+СокрЛП(ВыборкаСписаниеЗатрат.Контрагент); 
		Движение.Сумма 		= ВыборкаСписаниеЗатрат.Всего;
		
	КонецЦикла;
	
	//Курсоывые разницы
	РезультатКурсовыеРазницы 	= мРезультатыЗапроса[1];
	Если Не РезультатКурсовыеРазницы.Пустой() Тогда
		
		ВыборкаКурсовыеРазницы 		= РезультатКурсовыеРазницы.Выбрать();
		
		Пока ВыборкаКурсовыеРазницы.Следующий() Цикл
			
			ДанныеДляПроводки = Новый Структура;
			ДанныеДляПроводки.Вставить("Дата"					, ВыборкаПоШапке.Дата);
			ДанныеДляПроводки.Вставить("Организация"			, ВыборкаПоШапке.Организация);
			ДанныеДляПроводки.Вставить("Подразделение"			, СтруктураКоррСчета.Подразделение);
			ДанныеДляПроводки.Вставить("Валюта"					, ВыборкаКурсовыеРазницы.Валюта);
			
			ДанныеДляПроводки.Вставить("КоррСчет"				, СтруктураНастроек.СчетУчетаПоставщиков);
			ДанныеДляПроводки.Вставить("КоррПодразделение"		, СтруктураКоррСчета.Подразделение);
			ДанныеДляПроводки.Вставить("КоррСубконто1"			, ВыборкаКурсовыеРазницы.Контрагент);
			ДанныеДляПроводки.Вставить("КоррСубконто2"			, ВыборкаКурсовыеРазницы.Договор);
			ДанныеДляПроводки.Вставить("КоррСубконто3"			, ВыборкаКурсовыеРазницы.Счет);
			
			ДанныеДляПроводки.Вставить("СуммаКурсовойРазницы"	, ВыборкаКурсовыеРазницы.Всего);
			
			Если ТипЗнч(Движения.Отбор.Регистратор.Значение) = Тип("ДокументСсылка.CW_КорректировкаОперативнойЗадолженности") И ВыборкаКурсовыеРазницы.Договор.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком Тогда
				ДанныеДляПроводки.СуммаКурсовойРазницы = ДанныеДляПроводки.СуммаКурсовойРазницы * -1;
			КонецЕсли;
			
			ВыполнитьДвиженияПоКурсовымРазницам(Движения, СтруктураНастроек, ДанныеДляПроводки, Отказ);
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ВыполнитьЗачетЗадолженности(Движения, ВыборкаПоШапке, СтруктураНастроек, Отказ)
	
	#Область Получение_данных
	
	НаборЗаписей_ОперативнаяКредиторскаяЗадолженность = _сф.НаборЗаписейПоРегистратору(РегистрыНакопления.CW_ОперативнаяКредиторскаяЗадолженность,ВыборкаПоШапке.Ссылка);
	НаборЗаписей_ОперативнаяКредиторскаяЗадолженность.Прочитать();
	
	НаборЗаписей_ОперативнаяДебиторскаяЗадолженность = _сф.НаборЗаписейПоРегистратору(РегистрыНакопления.CW_ОперативнаяДебиторскаяЗадолженность,ВыборкаПоШапке.Ссылка);
	НаборЗаписей_ОперативнаяДебиторскаяЗадолженность.Прочитать();
	
	ОперативнаяКредиторскаяЗадолженность	= НаборЗаписей_ОперативнаяКредиторскаяЗадолженность.Выгрузить();
	ОперативнаяДебиторскаяЗадолженность		= НаборЗаписей_ОперативнаяДебиторскаяЗадолженность.Выгрузить();
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	запрос.Текст = "ВЫБРАТЬ
	|	ОперативнаяКредиторскаяЗадолженность.ВидДвижения КАК ВидДвижения,
	|	ОперативнаяКредиторскаяЗадолженность.Организация КАК Организация,
	|	ОперативнаяКредиторскаяЗадолженность.Контрагент КАК Контрагент,
	|	ОперативнаяКредиторскаяЗадолженность.Валюта КАК Валюта,
	|	ОперативнаяКредиторскаяЗадолженность.Договор КАК Договор,
	|	ОперативнаяКредиторскаяЗадолженность.Счет КАК Счет,
	|	ОперативнаяКредиторскаяЗадолженность.Всего_Валюта КАК Всего_Валюта,
	|	ОперативнаяКредиторскаяЗадолженность.Всего КАК Всего,
	|	&СчетПоставщика КАК СчетПоставщика
	|ПОМЕСТИТЬ ВТ_ОперативнаяКредиторскаяЗадолженность
	|ИЗ
	|	&ОперативнаяКредиторскаяЗадолженность КАК ОперативнаяКредиторскаяЗадолженность
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОперативнаяДебиторскаяЗадолженность.ВидДвижения КАК ВидДвижения,
	|	ОперативнаяДебиторскаяЗадолженность.Организация КАК Организация,
	|	ОперативнаяДебиторскаяЗадолженность.Контрагент КАК Контрагент,
	|	ОперативнаяДебиторскаяЗадолженность.Валюта КАК Валюта,
	|	ОперативнаяДебиторскаяЗадолженность.Договор КАК Договор,
	|	ОперативнаяДебиторскаяЗадолженность.Счет КАК Счет,
	|	ОперативнаяДебиторскаяЗадолженность.Всего_Валюта КАК Всего_Валюта,
	|	ОперативнаяДебиторскаяЗадолженность.Всего КАК Всего,
	|	&СчетКлиента КАК СчетКлиента
	|ПОМЕСТИТЬ ВТ_ОперативнаяДебиторскаяЗадолженность
	|ИЗ
	|	&ОперативнаяДебиторскаяЗадолженность КАК ОперативнаяДебиторскаяЗадолженность
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ОперативнаяДебиторскаяЗадолженность.Организация КАК Организация,
	|	ВТ_ОперативнаяДебиторскаяЗадолженность.Контрагент КАК Контрагент,
	|	ВТ_ОперативнаяДебиторскаяЗадолженность.Договор КАК Договор,
	|	ВТ_ОперативнаяДебиторскаяЗадолженность.Счет КАК Счет,
	|	ВТ_ОперативнаяДебиторскаяЗадолженность.Всего_Валюта КАК СуммаВалКт,
	|	ВТ_ОперативнаяДебиторскаяЗадолженность.Всего КАК СуммаРегКт,
	|	ВТ_ОперативнаяДебиторскаяЗадолженность.СчетКлиента КАК СчетКредитора,
	|	""Кт"" КАК ПризнакСчетаКредитора
	|ПОМЕСТИТЬ ВТ_Кредитор
	|ИЗ
	|	ВТ_ОперативнаяДебиторскаяЗадолженность КАК ВТ_ОперативнаяДебиторскаяЗадолженность
	|ГДЕ
	|	ВТ_ОперативнаяДебиторскаяЗадолженность.ВидДвижения = &ВидДвиженияПриход
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВТ_ОперативнаяКредиторскаяЗадолженность.Организация,
	|	ВТ_ОперативнаяКредиторскаяЗадолженность.Контрагент,
	|	ВТ_ОперативнаяКредиторскаяЗадолженность.Договор,
	|	ВТ_ОперативнаяКредиторскаяЗадолженность.Счет,
	|	ВТ_ОперативнаяКредиторскаяЗадолженность.Всего_Валюта,
	|	ВТ_ОперативнаяКредиторскаяЗадолженность.Всего,
	|	ВТ_ОперативнаяКредиторскаяЗадолженность.СчетПоставщика,
	|	""Дт""
	|ИЗ
	|	ВТ_ОперативнаяКредиторскаяЗадолженность КАК ВТ_ОперативнаяКредиторскаяЗадолженность
	|ГДЕ
	|	ВТ_ОперативнаяКредиторскаяЗадолженность.ВидДвижения = &ВидДвиженияРасход
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Организация
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ОперативнаяДебиторскаяЗадолженность.Организация КАК Организация,
	|	ВТ_ОперативнаяДебиторскаяЗадолженность.Контрагент КАК Контрагент,
	|	ВТ_ОперативнаяДебиторскаяЗадолженность.Договор КАК Договор,
	|	ВТ_ОперативнаяДебиторскаяЗадолженность.Счет КАК Счет,
	|	ВТ_ОперативнаяДебиторскаяЗадолженность.Всего_Валюта КАК СуммаВалДт,
	|	ВТ_ОперативнаяДебиторскаяЗадолженность.Всего КАК СуммаРегДт,
	|	ВТ_ОперативнаяДебиторскаяЗадолженность.СчетКлиента КАК СчетДебитора,
	|	""Дт"" КАК ПризнакСчетаДебитора
	|ПОМЕСТИТЬ ВТ_Дебитор
	|ИЗ
	|	ВТ_ОперативнаяДебиторскаяЗадолженность КАК ВТ_ОперативнаяДебиторскаяЗадолженность
	|ГДЕ
	|	ВТ_ОперативнаяДебиторскаяЗадолженность.ВидДвижения = &ВидДвиженияРасход
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВТ_ОперативнаяКредиторскаяЗадолженность.Организация,
	|	ВТ_ОперативнаяКредиторскаяЗадолженность.Контрагент,
	|	ВТ_ОперативнаяКредиторскаяЗадолженность.Договор,
	|	ВТ_ОперативнаяКредиторскаяЗадолженность.Счет,
	|	ВТ_ОперативнаяКредиторскаяЗадолженность.Всего_Валюта,
	|	ВТ_ОперативнаяКредиторскаяЗадолженность.Всего,
	|	ВТ_ОперативнаяКредиторскаяЗадолженность.СчетПоставщика,
	|	""Кт""
	|ИЗ
	|	ВТ_ОперативнаяКредиторскаяЗадолженность КАК ВТ_ОперативнаяКредиторскаяЗадолженность
	|ГДЕ
	|	ВТ_ОперативнаяКредиторскаяЗадолженность.ВидДвижения = &ВидДвиженияПриход
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Организация
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Кредитор.Счет КАК КредиторДокументРасчетов,
	|	ВТ_Кредитор.СчетКредитора КАК КредиторСчет,
	|	ВТ_Кредитор.ПризнакСчетаКредитора КАК КредиторПризнакСчета,
	|	ВТ_Кредитор.Контрагент КАК КредиторКонтрагент,
	|	ВТ_Кредитор.Договор КАК КредиторДоговор,
	|	ВТ_Кредитор.СуммаВалКт КАК КредиторСуммаВал,
	|	ВТ_Кредитор.СуммаРегКт КАК КредиторСуммаРег,
	|	ВТ_Дебитор.СчетДебитора КАК ДебиторСчет,
	|	ВТ_Дебитор.ПризнакСчетаДебитора КАК ДебиторПризнакСчета,
	|	ВТ_Дебитор.Контрагент КАК ДебиторКонтрагент,
	|	ВТ_Дебитор.Договор КАК ДебиторДоговор,
	|	ВТ_Дебитор.Счет КАК ДебиторДокументРасчетов,
	|	ВТ_Дебитор.СуммаВалДт КАК ДебиторСуммаВал,
	|	ВТ_Дебитор.СуммаРегДт КАК ДебиторСуммаРег
	|ИЗ
	|	ВТ_Кредитор КАК ВТ_Кредитор
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Дебитор КАК ВТ_Дебитор
	|		ПО ВТ_Кредитор.Организация = ВТ_Дебитор.Организация
	|ИТОГИ
	|	МАКСИМУМ(КредиторСуммаВал),
	|	МАКСИМУМ(КредиторСуммаРег),
	|	СУММА(ДебиторСуммаВал),
	|	СУММА(ДебиторСуммаРег)
	|ПО
	|	КредиторДокументРасчетов";
	
	
	Запрос.УстановитьПараметр("ВидДвиженияПриход"	, ВидДвиженияНакопления.Приход);
	Запрос.УстановитьПараметр("ВидДвиженияРасход"	, ВидДвиженияНакопления.Расход);
	
	Запрос.УстановитьПараметр("ОперативнаяКредиторскаяЗадолженность"	,ОперативнаяКредиторскаяЗадолженность);
	Запрос.УстановитьПараметр("ОперативнаяДебиторскаяЗадолженность"		,ОперативнаяДебиторскаяЗадолженность);
	
	Запрос.УстановитьПараметр("СчетКлиента"			,СтруктураНастроек.СчетУчетаКлиентов);
	Запрос.УстановитьПараметр("СчетПоставщика"		,СтруктураНастроек.СчетУчетаПоставщиков);
	
	
	РезультатыЗапроса =	Запрос.Выполнить();
	
	#КонецОбласти
	
	ВыборкаДокументРасчетовКредитор = РезультатыЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	кэшСчетовДебитра = Новый ТаблицаЗначений;
	кэшСчетовДебитра.Колонки.Добавить("ДокументРасчетов");
	кэшСчетовДебитра.Колонки.Добавить("Сумма"		, Новый ОписаниеТипов("Число"));
	кэшСчетовДебитра.Колонки.Добавить("СуммаВал"	, Новый ОписаниеТипов("Число"));
	
	Пока ВыборкаДокументРасчетовКредитор.Следующий() Цикл
		
		КредиторСуммаРегДляЗачета =  ВыборкаДокументРасчетовКредитор.КредиторСуммаРег;
		КредиторСуммаВалДляЗачета =  ВыборкаДокументРасчетовКредитор.КредиторСуммаВал;
		
		ВыборкаПроводки = ВыборкаДокументРасчетовКредитор.Выбрать();
		
		Пока ВыборкаПроводки.Следующий() и КредиторСуммаРегДляЗачета <> 0 Цикл
			
			ДебиторСуммаРег = ВыборкаПроводки.ДебиторСуммаРег;
			ДебиторСуммаВал = ВыборкаПроводки.ДебиторСуммаВал;
			
			ЗачтеннаяСумма	=  0; ЗачтеннаяСуммавал	=  0;
			НайденнаяСтрока = кэшСчетовДебитра.Найти(ВыборкаПроводки.ДебиторДокументРасчетов, "ДокументРасчетов");
			Если НайденнаяСтрока <> Неопределено Тогда
				ЗачтеннаяСумма 		=  НайденнаяСтрока.Сумма;
				ЗачтеннаяСуммавал 	=  НайденнаяСтрока.СуммаВал;
			КонецЕсли;
			
			ДебиторСуммаРег = ДебиторСуммаРег - ЗачтеннаяСумма;
			ДебиторСуммаВал = ДебиторСуммаВал - ЗачтеннаяСуммавал;
			
			Если ДебиторСуммаРег = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			СуммаРегЗачтено  = Мин(ДебиторСуммаРег, КредиторСуммаРегДляЗачета);
			СуммаВалЗачтено  = Мин(ДебиторСуммаВал, КредиторСуммаВалДляЗачета);
			
			Если СуммаРегЗачтено = ДебиторСуммаРег и СуммаВалЗачтено <> ДебиторСуммаВал Тогда
				СуммаВалЗачтено	= СуммаВалЗачтено +  (СуммаВалЗачтено-ДебиторСуммаВал);
				ДебиторСуммаВал	= 0;
			Конецесли;
			
			
			Движение = Движения.Добавить();
			Движение.Период			= ВыборкаПоШапке.Дата;
			Движение.Организация 	= ВыборкаПоШапке.Организация;
			
			//ДебиторСчет
			ПризнакДебитор			= ВыборкаПроводки.ДебиторПризнакСчета; 
			СвойстваСчетаДебитор	= CW_БухгалтерскийУчетВызовСервераПовтИспМСФО.ПолучитьСвойстваСчета(ВыборкаПроводки.ДебиторСчет);
			
			
			Движение["Счет"+ПризнакДебитор] = ВыборкаПроводки.ДебиторСчет;
			
			//Учет по подразделениям
			Если СвойстваСчетаДебитор.УчетПоПодразделениям Тогда
				Движение["Подразделение"+ПризнакДебитор]=  ВыборкаПоШапке.Подразделение;
			КонецЕсли;
			
			Если СвойстваСчетаДебитор.Валютный Тогда
				Движение["Валюта"+ПризнакДебитор] 			= ВыборкаПоШапке.Валюта;
				Движение["ВалютнаяСумма"+ПризнакДебитор] 	= СуммаВалЗачтено;
			КонецЕсли;                                        
			
			//Субконто
			CW_БухгалтерскийУчетМСФО.УстановитьСубконто(Движение["Счет"+ПризнакДебитор], Движение["Субконто"+ПризнакДебитор], "Контрагенты"						, ВыборкаПроводки.ДебиторКонтрагент);
			CW_БухгалтерскийУчетМСФО.УстановитьСубконто(Движение["Счет"+ПризнакДебитор], Движение["Субконто"+ПризнакДебитор], "Договоры"						, ВыборкаПроводки.ДебиторДоговор);
			CW_БухгалтерскийУчетМСФО.УстановитьСубконто(Движение["Счет"+ПризнакДебитор], Движение["Субконто"+ПризнакДебитор], "ДокументыРасчетовСКонтрагентами"	, ВыборкаПроводки.ДебиторДокументРасчетов);
			
			
			//КредиторСчет
			ПризнакКредитор			= ВыборкаПроводки.КредиторПризнакСчета; 
			СвойстваСчетаКредитор	= CW_БухгалтерскийУчетВызовСервераПовтИспМСФО.ПолучитьСвойстваСчета(ВыборкаПроводки.КредиторСчет);
			
			
			Движение["Счет"+ПризнакКредитор] 	= ВыборкаПроводки.КредиторСчет;
			
			//Учет по подразделениям
			Если СвойстваСчетаКредитор.УчетПоПодразделениям Тогда
				Движение["Подразделение"+ПризнакКредитор]=  ВыборкаПоШапке.Подразделение;
			КонецЕсли;
			
			Если СвойстваСчетаКредитор.Валютный Тогда
				Движение["Валюта"+ПризнакКредитор] 			= ВыборкаПоШапке.Валюта;
				Движение["ВалютнаяСумма"+ПризнакКредитор] 	= СуммаВалЗачтено;
			КонецЕсли;
			
			//Субконто
			CW_БухгалтерскийУчетМСФО.УстановитьСубконто(Движение["Счет"+ПризнакКредитор], Движение["Субконто"+ПризнакКредитор], "Контрагенты"						, ВыборкаПроводки.КредиторКонтрагент);
			CW_БухгалтерскийУчетМСФО.УстановитьСубконто(Движение["Счет"+ПризнакКредитор], Движение["Субконто"+ПризнакКредитор], "Договоры"							, ВыборкаПроводки.КредиторДоговор);
			CW_БухгалтерскийУчетМСФО.УстановитьСубконто(Движение["Счет"+ПризнакКредитор], Движение["Субконто"+ПризнакКредитор], "ДокументыРасчетовСКонтрагентами"	, ВыборкаПроводки.КредиторДокументРасчетов);
			
			Движение.Содержание = "Offsetting of debts"; 
			Движение.Сумма 		= СуммаРегЗачтено;
			
			
			
			КредиторСуммаРегДляЗачета = КредиторСуммаРегДляЗачета - ЗачтеннаяСумма;
			КредиторСуммаВалДляЗачета = КредиторСуммаВалДляЗачета - ЗачтеннаяСуммавал;
			
			//Кэш зачтенного документа
			Если НайденнаяСтрока = Неопределено Тогда
				СтрокаКэш = кэшСчетовДебитра.Добавить();
				СтрокаКэш.ДокументРасчетов 	= ВыборкаПроводки.ДебиторДокументРасчетов;
				СтрокаКэш.Сумма				= СтрокаКэш.Сумма    + СуммаРегЗачтено;
				СтрокаКэш.СуммаВал			= СтрокаКэш.СуммаВал + СуммаВалЗачтено;
			Иначе
				НайденнаяСтрока.Сумма		= НайденнаяСтрока.Сумма    + СуммаРегЗачтено;
				НайденнаяСтрока.СуммаВал	= НайденнаяСтрока.СуммаВал + СуммаВалЗачтено;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры


//ДВИЖЕНИЯ ДОКУМЕНТА "ДВИЖЕНИЕ ДЕНЕЖНЫХ СРЕДСТВ"
Процедура СформированияДвиженияДокумента_ДвижениеДенежныхСредств(Источник, СтруктураНастроек, Отказ)
	
	ЗапросПоШапке = новый Запрос;          
	ЗапросПоШапке.Текст = "ВЫБРАТЬ
	|	CW_ДвижениеДенежныхСредств.Ссылка КАК Ссылка,
	|	CW_ДвижениеДенежныхСредств.Дата КАК Дата,
	|	CW_ДвижениеДенежныхСредств.ВидОперации КАК ВидОперации,
	|	CW_ДвижениеДенежныхСредств.Организация КАК Организация,
	|	CW_ДвижениеДенежныхСредств.Касса КАК Касса,
	|	CW_ДвижениеДенежныхСредств.Касса.Валюта КАК КассаВалюта,
	|	CW_ДвижениеДенежныхСредств.Касса.СчетКассы КАК КассаСчет,
	|	CW_ДвижениеДенежныхСредств.СтатьяДДС КАК КассаСтатьяДДС,
	|	CW_ДвижениеДенежныхСредств.СуммаВК КАК КассаСумма,
	|	CW_ДвижениеДенежныхСредств.КассаПоступления КАК КоррКасса,
	|	CW_ДвижениеДенежныхСредств.КассаПоступления.Валюта КАК КоррКассаВалюта,
	|	CW_ДвижениеДенежныхСредств.КассаПоступления.СчетКассы КАК КоррКассаСчет,
	|	CW_ДвижениеДенежныхСредств.ПоступлениеСтатьяДДС КАК КоррКассаСтатьяДДС,
	|	CW_ДвижениеДенежныхСредств.СуммаВД КАК КоррКассаСумма,
	|	CW_ДвижениеДенежныхСредств.Контрагент КАК Контрагент,
	|	CW_ДвижениеДенежныхСредств.Договор КАК Договор,
	|	CW_ДвижениеДенежныхСредств.Договор.ВалютаДоговора КАК ДоговорВалюта,
	|	CW_ДвижениеДенежныхСредств.СчетНДС КАК СчетНДС,
	|	CW_ДвижениеДенежныхСредств.Счет КАК Счет,
	|	CW_ДвижениеДенежныхСредств.СуммаНДС КАК СуммаНДС,
	|	CW_ДвижениеДенежныхСредств.УчитыватьНДС КАК УчитыватьНДС,
	|	CW_ДвижениеДенежныхСредств.Субконто1 КАК Субконто1,
	|	CW_ДвижениеДенежныхСредств.Субконто2 КАК Субконто2,
	|	CW_ДвижениеДенежныхСредств.Субконто3 КАК Субконто3,
	|	CW_ДвижениеДенежныхСредств.Подразделение КАК Подразделение,
	|	CW_ДвижениеДенежныхСредств.Количество КАК Количество
	|ИЗ
	|	Документ.CW_ДвижениеДенежныхСредств КАК CW_ДвижениеДенежныхСредств
	|ГДЕ
	|	CW_ДвижениеДенежныхСредств.Ссылка = &ИсточникСсылка";
	
	ЗапросПоШапке.УстановитьПараметр("ИсточникСсылка", Источник.Ссылка);
	ВыборкаПоШапке = ЗапросПоШапке.Выполнить().Выбрать();
	ВыборкаПоШапке.Следующий();
	
	Если ВыборкаПоШапке.ВидОперации =  Перечисления.CW_ВидыОперацийДДС.ОплатаПоставщику Тогда
		
		ВыполнитьДвиженияПоОплатаПоставщику(Источник.Движения.CW_МСФО,ВыборкаПоШапке,СтруктураНастроек, 1, Отказ);

	ИначеЕсли ВыборкаПоШапке.ВидОперации =  Перечисления.CW_ВидыОперацийДДС.ВозвратОтПоставщика Тогда
		
		ВыполнитьДвиженияПоОплатаПоставщику(Источник.Движения.CW_МСФО,ВыборкаПоШапке,СтруктураНастроек, -1, Отказ);
		
	ИначеЕсли ВыборкаПоШапке.ВидОперации =  Перечисления.CW_ВидыОперацийДДС.ПоступлениеОтПокупателя Тогда
		
		ВыполнитьДвиженияПоПоступлениеОтПокупателя(Источник.Движения.CW_МСФО,ВыборкаПоШапке,СтруктураНастроек, 1, Отказ);
		
	ИначеЕсли ВыборкаПоШапке.ВидОперации =  Перечисления.CW_ВидыОперацийДДС.ВозвратПокупателю Тогда
		
		ВыполнитьДвиженияПоПоступлениеОтПокупателя(Источник.Движения.CW_МСФО,ВыборкаПоШапке,СтруктураНастроек, -1, Отказ);
		
	ИначеЕсли ВыборкаПоШапке.ВидОперации =  Перечисления.CW_ВидыОперацийДДС.ПрочиеПоступления Тогда
		
		ВыполнитьДвиженияПоПрочиеПоступления(Источник.Движения.CW_МСФО,ВыборкаПоШапке,СтруктураНастроек, Отказ);
		
	ИначеЕсли ВыборкаПоШапке.ВидОперации =  Перечисления.CW_ВидыОперацийДДС.ПрочиеСписания Тогда
		
		ВыполнитьДвиженияПоПрочиеСписания(Источник.Движения.CW_МСФО,ВыборкаПоШапке,СтруктураНастроек, Отказ);
		
	ИначеЕсли ВыборкаПоШапке.ВидОперации =  Перечисления.CW_ВидыОперацийДДС.ПеремещениеВДругуюКассу Тогда
		
		ВыполнитьДвиженияПоПеремещениеВДругуюКассу(Источник.Движения.CW_МСФО,ВыборкаПоШапке,СтруктураНастроек, Отказ);
		
	ИначеЕсли ВыборкаПоШапке.ВидОперации =  Перечисления.CW_ВидыОперацийДДС.ОплатаПоставщикуПоПриобретениям Тогда
		
		ВыполнитьДвижениОплатаПоставщикуПоПриобретениям(Источник.Движения.CW_МСФО,ВыборкаПоШапке,СтруктураНастроек, Отказ);
		
	КонецЕсли;
	
КонецПроцедуры


//ДВИЖЕНИЯ ДОКУМЕНТА "ДВИЖЕНИЕ ДЕНЕЖНЫХ СРЕДСТВ" ПО ВИДАМ ОПЕРАЦИЙ
Процедура ВыполнитьДвиженияПоОплатаПоставщику(Движения, ВыборкаПоШапке, СтруктураНастроек, ЗнакСуммы, Отказ)
	
	СвойстваСчетКассы			 = CW_БухгалтерскийУчетВызовСервераПовтИспМСФО.ПолучитьСвойстваСчета(ВыборкаПоШапке.КассаСчет);
	ИспользоватьСтатьиДДС 		 = ПолучитьФункциональнуюОпцию("ИспользоватьСтатьиДвиженияДенежныхСредств");
	
	#Область Получение_данных
	
	НаборЗаписей_ОперативнаяКредиторскаяЗадолженность = _сф.НаборЗаписейПоРегистратору(РегистрыНакопления.CW_ОперативнаяКредиторскаяЗадолженность,ВыборкаПоШапке.Ссылка);
	НаборЗаписей_ОперативнаяКредиторскаяЗадолженность.Прочитать();
	
	ОперативнаяКредиторскаяЗадолженность	= НаборЗаписей_ОперативнаяКредиторскаяЗадолженность.Выгрузить();
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	запрос.Текст = "ВЫБРАТЬ
	               |	CW_ОперативнаяКредиторскаяЗадолженность.ВидДвижения КАК ВидДвижения,
	               |	ВЫБОР
	               |		КОГДА CW_ОперативнаяКредиторскаяЗадолженность.ВидОперации = &КурсоваяРазница
	               |				ИЛИ CW_ОперативнаяКредиторскаяЗадолженность.ВидОперации = &НереализованнаяКурсоваяРазница
	               |			ТОГДА CW_ОперативнаяКредиторскаяЗадолженность.ВидОперации
	               |		ИНАЧЕ НЕОПРЕДЕЛЕНО
	               |	КОНЕЦ КАК ВидОперации,
	               |	CW_ОперативнаяКредиторскаяЗадолженность.Организация КАК Организация,
	               |	CW_ОперативнаяКредиторскаяЗадолженность.Контрагент КАК Контрагент,
	               |	CW_ОперативнаяКредиторскаяЗадолженность.Договор КАК Договор,
	               |	CW_ОперативнаяКредиторскаяЗадолженность.Валюта КАК Валюта,
	               |	CW_ОперативнаяКредиторскаяЗадолженность.Счет КАК Счет,
	               |	CW_ОперативнаяКредиторскаяЗадолженность.Всего_Валюта КАК Всего_Валюта,
	               |	CW_ОперативнаяКредиторскаяЗадолженность.Всего КАК Всего
	               |ПОМЕСТИТЬ ВТ_ДвиженияДокумента
	               |ИЗ
	               |	&ОперативнаяКредиторскаяЗадолженность КАК CW_ОперативнаяКредиторскаяЗадолженность
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ_ДвиженияДокумента.Организация КАК Организация,
	               |	ВТ_ДвиженияДокумента.Контрагент КАК Контрагент,
	               |	ВТ_ДвиженияДокумента.Договор КАК Договор,
	               |	ВТ_ДвиженияДокумента.Счет КАК Счет,
	               |	ВТ_ДвиженияДокумента.Валюта КАК Валюта,
	               |	СУММА(ВТ_ДвиженияДокумента.Всего) КАК Всего,
	               |	СУММА(ВТ_ДвиженияДокумента.Всего_Валюта) КАК Всего_Валюта
	               |ИЗ
	               |	ВТ_ДвиженияДокумента КАК ВТ_ДвиженияДокумента
	               |ГДЕ
	               |	ВТ_ДвиженияДокумента.ВидОперации = &КурсоваяРазница
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ВТ_ДвиженияДокумента.Договор,
	               |	ВТ_ДвиженияДокумента.Контрагент,
	               |	ВТ_ДвиженияДокумента.Организация,
	               |	ВТ_ДвиженияДокумента.Валюта,
	               |	ВТ_ДвиженияДокумента.Счет
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ_ДвиженияДокумента.Организация КАК Организация,
	               |	ВТ_ДвиженияДокумента.Контрагент КАК Контрагент,
	               |	ВТ_ДвиженияДокумента.Договор КАК Договор,
	               |	ВТ_ДвиженияДокумента.Счет КАК Счет,
	               |	СУММА(ВТ_ДвиженияДокумента.Всего) КАК Всего,
	               |	СУММА(ВТ_ДвиженияДокумента.Всего_Валюта) КАК Всего_Валюта
	               |ИЗ
	               |	ВТ_ДвиженияДокумента КАК ВТ_ДвиженияДокумента
	               |ГДЕ
	               |	ВТ_ДвиженияДокумента.ВидОперации = НЕОПРЕДЕЛЕНО
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ВТ_ДвиженияДокумента.Организация,
	               |	ВТ_ДвиженияДокумента.Контрагент,
	               |	ВТ_ДвиженияДокумента.Договор,
	               |	ВТ_ДвиженияДокумента.Счет
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ_ДвиженияДокумента.Организация КАК Организация,
	               |	ВТ_ДвиженияДокумента.Контрагент КАК Контрагент,
	               |	ВТ_ДвиженияДокумента.Валюта КАК Валюта,
	               |	ВТ_ДвиженияДокумента.Договор КАК Договор,
	               |	ВТ_ДвиженияДокумента.Счет КАК Счет,
	               |	СУММА(ВТ_ДвиженияДокумента.Всего_Валюта) КАК Всего_Валюта,
	               |	СУММА(ВТ_ДвиженияДокумента.Всего) КАК Всего
	               |ИЗ
	               |	ВТ_ДвиженияДокумента КАК ВТ_ДвиженияДокумента
	               |ГДЕ
	               |	ВТ_ДвиженияДокумента.ВидОперации = &НереализованнаяКурсоваяРазница
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ВТ_ДвиженияДокумента.Счет,
	               |	ВТ_ДвиженияДокумента.Договор,
	               |	ВТ_ДвиженияДокумента.Организация,
