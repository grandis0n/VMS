		Запрос.УстановитьПараметр("Организация"				, ВыборкаПоШапке.Организация);
		Запрос.УстановитьПараметр("Подразделение"			, ВыборкаПоШапке.Подразделение);
		Запрос.УстановитьПараметр("УчетПоПодразделениям"	, СвойстваСчет.УчетПоПодразделениям);
		Запрос.УстановитьПараметр("Валюта"					, ВыборкаПоШапке.КассаВалюта);
		
		Запрос.УстановитьПараметр("Субконто1"			, ВыборкаПоШапке.Субконто1);
		Запрос.УстановитьПараметр("Субконто2"			, ВыборкаПоШапке.Субконто2);
		Запрос.УстановитьПараметр("Субконто3"			, ВыборкаПоШапке.Субконто3);
		
		РезультатЗапроса = Запрос.Выполнить();
		Выборка = РезультатЗапроса.Выбрать();
		
		Если Выборка.Следующий() Тогда
			Если Выборка.ВалютнаяСуммаОстаток = 0 и  Выборка.СуммаОстаток <> 0 Тогда
				СуммаКурсовойРазницы =  -Выборка.СуммаОстаток;
			КонецЕсли;
		КонецЕсли;
		
		
		Если СуммаКурсовойРазницы <> 0 И Не СуммаКурсовойРазницы = Неопределено Тогда
			
			ДанныеДляПроводки = Новый Структура;
