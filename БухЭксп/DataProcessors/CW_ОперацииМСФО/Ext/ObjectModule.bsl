		//Валюта Кт
		Если СвойстваКоррКассаСчет.Валютный Тогда
			Движение.ВалютаКт 			= ВыборкаПоШапке.КассаВалюта;
			Движение.ВалютнаяСуммаКт 	= ВыборкаПоШапке.КассаСумма;
		КонецЕсли;
		
		//Субконто Дт
		CW_БухгалтерскийУчетМСФО.УстановитьСубконто(Движение.СчетКт, Движение.СубконтоКт, "ДенежныеCредства"				, ВыборкаПоШапке.Касса);
		
		Если ИспользоватьСтатьиДДС Тогда
			CW_БухгалтерскийУчетМСФО.УстановитьСубконто(Движение.СчетКт, Движение.СубконтоКт, "СтатьиДвиженияДенежныхСредств"	, ВыборкаПоШапке.КассаСтатьяДДС);
		КонецЕсли;
		
		СтруктураКурса = CW_Финансы.ПолучитьКурсВалюты(ВыборкаПоШапке.КассаВалюта,ВыборкаПоШапке.Дата);
		СуммаРег 	   = CW_Финансы.ПересчитатьИзВалютыВВалюту(ВыборкаПоШапке.КассаСумма,ВыборкаПоШапке.КассаВалюта,БазоваяВалюта,СтруктураКурса.Курс,1,СтруктураКурса.Кратность,1);
		
		Движение.Содержание = "Cash transfers between cash registers"; 
		Движение.Сумма 		= СуммаРег;		
		
		#КонецОбласти
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ВыполнитьДвижениОплатаПоставщикуПоПриобретениям(Движения, ВыборкаПоШапке, СтруктураНастроек, Отказ)
	
	ИспользоватьСтатьиДДС	= ПолучитьФункциональнуюОпцию("ИспользоватьСтатьиДвиженияДенежныхСредств");
	
	СвойстваСчетКассы	= CW_БухгалтерскийУчетВызовСервераПовтИспМСФО.ПолучитьСвойстваСчета(ВыборкаПоШапке.КассаСчет);
	СвойстваСчетНДС		= CW_БухгалтерскийУчетВызовСервераПовтИспМСФО.ПолучитьСвойстваСчета(СтруктураНастроек.СчетУчетаНДС);
	
	#Область Получение_данных
	
	НаборЗаписей_ОперативнаяКредиторскаяЗадолженность = _сф.НаборЗаписейПоРегистратору(РегистрыНакопления.CW_ОперативнаяКредиторскаяЗадолженность,ВыборкаПоШапке.Ссылка);
	НаборЗаписей_ОперативнаяКредиторскаяЗадолженность.Прочитать();
	
	ОперативнаяКредиторскаяЗадолженность	= НаборЗаписей_ОперативнаяКредиторскаяЗадолженность.Выгрузить();
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	запрос.Текст = "ВЫБРАТЬ
	               |	CW_ОперативнаяКредиторскаяЗадолженность.ВидДвижения КАК ВидДвижения,
	               |	ВЫБОР
	               |		КОГДА CW_ОперативнаяКредиторскаяЗадолженность.ВидОперации = &КурсоваяРазница
	               |			ТОГДА CW_ОперативнаяКредиторскаяЗадолженность.ВидОперации
	               |		ИНАЧЕ НЕОПРЕДЕЛЕНО
	               |	КОНЕЦ КАК ВидОперации,
	               |	CW_ОперативнаяКредиторскаяЗадолженность.Организация КАК Организация,
	               |	CW_ОперативнаяКредиторскаяЗадолженность.Контрагент КАК Контрагент,
	               |	CW_ОперативнаяКредиторскаяЗадолженность.Договор КАК Договор,
	               |	CW_ОперативнаяКредиторскаяЗадолженность.Валюта КАК Валюта,
	               |	CW_ОперативнаяКредиторскаяЗадолженность.Счет КАК Счет,
	               |	CW_ОперативнаяКредиторскаяЗадолженность.Всего_Валюта КАК Всего_Валюта,
	               |	CW_ОперативнаяКредиторскаяЗадолженность.Всего КАК Всего
	               |ПОМЕСТИТЬ ВТ_ДвиженияДокумента
	               |ИЗ
	               |	&ОперативнаяКредиторскаяЗадолженность КАК CW_ОперативнаяКредиторскаяЗадолженность
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ_ДвиженияДокумента.Организация КАК Организация,
	               |	ВТ_ДвиженияДокумента.Контрагент КАК Контрагент,
	               |	ВТ_ДвиженияДокумента.Договор КАК Договор,
	               |	ВТ_ДвиженияДокумента.Счет КАК Счет,
	               |	ВТ_ДвиженияДокумента.Валюта КАК Валюта,
	               |	СУММА(ВТ_ДвиженияДокумента.Всего) КАК Всего,
	               |	СУММА(ВТ_ДвиженияДокумента.Всего_Валюта) КАК Всего_Валюта
	               |ИЗ
	               |	ВТ_ДвиженияДокумента КАК ВТ_ДвиженияДокумента
	               |ГДЕ
	               |	ВТ_ДвиженияДокумента.ВидОперации = &КурсоваяРазница
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ВТ_ДвиженияДокумента.Договор,
	               |	ВТ_ДвиженияДокумента.Контрагент,
	               |	ВТ_ДвиженияДокумента.Организация,
	               |	ВТ_ДвиженияДокумента.Валюта,
	               |	ВТ_ДвиженияДокумента.Счет
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ_ДвиженияДокумента.Организация КАК Организация,
	               |	ВТ_ДвиженияДокумента.Контрагент КАК Контрагент,
	               |	ВТ_ДвиженияДокумента.Договор КАК Договор,
	               |	ВТ_ДвиженияДокумента.Счет КАК Счет,
	               |	СУММА(ВТ_ДвиженияДокумента.Всего) КАК Всего,
	               |	СУММА(ВТ_ДвиженияДокумента.Всего_Валюта) КАК Всего_Валюта
	               |ИЗ
	               |	ВТ_ДвиженияДокумента КАК ВТ_ДвиженияДокумента
	               |ГДЕ
	               |	ВТ_ДвиженияДокумента.ВидОперации = НЕОПРЕДЕЛЕНО
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ВТ_ДвиженияДокумента.Организация,
	               |	ВТ_ДвиженияДокумента.Контрагент,
	               |	ВТ_ДвиженияДокумента.Договор,
	               |	ВТ_ДвиженияДокумента.Счет
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ_ДвиженияДокумента.Организация КАК Организация,
	               |	ВТ_ДвиженияДокумента.Контрагент КАК Контрагент,
	               |	ВТ_ДвиженияДокумента.Валюта КАК Валюта,
	               |	ВТ_ДвиженияДокумента.Договор КАК Договор,
	               |	ВТ_ДвиженияДокумента.Счет КАК Счет,
	               |	СУММА(ВТ_ДвиженияДокумента.Всего_Валюта) КАК Всего_Валюта,
	               |	СУММА(ВТ_ДвиженияДокумента.Всего) КАК Всего
	               |ИЗ
	               |	ВТ_ДвиженияДокумента КАК ВТ_ДвиженияДокумента
	               |ГДЕ
	               |	ВТ_ДвиженияДокумента.ВидОперации = &НереализованнаяКурсоваяРазница
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ВТ_ДвиженияДокумента.Счет,
	               |	ВТ_ДвиженияДокумента.Договор,
	               |	ВТ_ДвиженияДокумента.Организация,
	               |	ВТ_ДвиженияДокумента.Контрагент,
	               |	ВТ_ДвиженияДокумента.Валюта";
	
	Запрос.УстановитьПараметр("ОперативнаяКредиторскаяЗадолженность"	, ОперативнаяКредиторскаяЗадолженность);
	Запрос.УстановитьПараметр("КурсоваяРазница"							, Перечисления.CW_ВидыДвиженийПоОперативнойЗадолженности.КурсоваяРазница);
	//d.samuilov@coraway.ru добавлен параметр, а так же добавлен в запрос Пакет 4 для получения нереализованной курсовой разницы
	Запрос.УстановитьПараметр("НереализованнаяКурсоваяРазница" 		, Перечисления.CW_ВидыДвиженийПоОперативнойЗадолженности.НереализованнаяКурсоваяРазница);

	мРезультатыЗапроса =	Запрос.ВыполнитьПакет();
	
	#КонецОбласти
	
	//Оплата поставщику
	РезультатСписаниеЗатрат 	= мРезультатыЗапроса[2];
	Выборка_ОплатаПоставщику 	= РезультатСписаниеЗатрат.Выбрать();
	
	Пока Выборка_ОплатаПоставщику.Следующий() Цикл
		
		Движение = Движения.Добавить();
		Движение.Период			= ВыборкаПоШапке.Дата;
		Движение.Организация 	= ВыборкаПоШапке.Организация;
		
		//ДЕБЕТ
		Если Выборка_ОплатаПоставщику.Счет = ВыборкаПоШапке.Ссылка Тогда
			//Это аванс
			СтуктураСчетаДт = Новый Структура;
			СтуктураСчетаДт.Вставить("СчетДт"		, СтруктураНастроек.СчетАвансовПоставщиков);
			СтуктураСчетаДт.Вставить("Контрагент"	, Выборка_ОплатаПоставщику.Контрагент);
			СтуктураСчетаДт.Вставить("Договор"		, Выборка_ОплатаПоставщику.Договор);
			СтуктураСчетаДт.Вставить("Счет"			, Неопределено);
			СодежаниеПроводки = "Advance payment to supplier: "+СокрЛП(Выборка_ОплатаПоставщику.Контрагент)+" under the agreement: "+СокрП(Выборка_ОплатаПоставщику.Договор);
		Иначе
			СтуктураСчетаДт = Новый Структура;
			СтуктураСчетаДт.Вставить("СчетДт"		, СтруктураНастроек.СчетУчетаПоставщиков);
			СтуктураСчетаДт.Вставить("Контрагент"	, Выборка_ОплатаПоставщику.Контрагент);
			СтуктураСчетаДт.Вставить("Договор"		, Выборка_ОплатаПоставщику.Договор);
			СтуктураСчетаДт.Вставить("Счет"			, Выборка_ОплатаПоставщику.Счет);
			СодежаниеПроводки = "Payment to supplier on  "+ СокрЛП(Выборка_ОплатаПоставщику.Счет);
		КонецЕсли;
		
		СвойстваСчетаДт			= CW_БухгалтерскийУчетВызовСервераПовтИспМСФО.ПолучитьСвойстваСчета(СтуктураСчетаДт.СчетДт);
		Движение.СчетДт 		=  СтуктураСчетаДт.СчетДт;
		
		//Учет по подразделениям
		Если СвойстваСчетаДт.УчетПоПодразделениям Тогда
			Движение.ПодразделениеДт =  ВыборкаПоШапке.Подразделение;
		КонецЕсли;
		
		//Валюта Дт
		Если СвойстваСчетаДт.Валютный Тогда
			Движение.ВалютаДт 			= ВыборкаПоШапке.КассаВалюта;
			Движение.ВалютнаяСуммаДт 	= Выборка_ОплатаПоставщику.Всего_Валюта;
		КонецЕсли;
		
		//Валюта Дт
		Если СвойстваСчетаДт.Количественный Тогда
			Движение.КоличествоДт = ВыборкаПоШапке.Количество;
		КонецЕсли;
		
		//Субконто Дт
		CW_БухгалтерскийУчетМСФО.УстановитьСубконто(Движение.СчетДт, Движение.СубконтоДт, "Контрагенты"						, СтуктураСчетаДт.Контрагент);
		CW_БухгалтерскийУчетМСФО.УстановитьСубконто(Движение.СчетДт, Движение.СубконтоДт, "Договоры"						, СтуктураСчетаДт.Договор);
		CW_БухгалтерскийУчетМСФО.УстановитьСубконто(Движение.СчетДт, Движение.СубконтоДт, "ДокументыРасчетовСКонтрагентами"	, СтуктураСчетаДт.Счет);
		
		
		//КРЕДИТ
		Движение.СчетКт 		=  ВыборкаПоШапке.КассаСчет;
		
		//Учет по подразделениям
		Если СвойстваСчетКассы.УчетПоПодразделениям Тогда
			Движение.ПодразделениеКт =  ВыборкаПоШапке.Подразделение;
		КонецЕсли;
		
		//Валюта Кт
		Если СвойстваСчетКассы.Валютный Тогда
			Движение.ВалютаКт 			= ВыборкаПоШапке.КассаВалюта;
			Движение.ВалютнаяСуммаКт 	= Выборка_ОплатаПоставщику.Всего_Валюта;
		КонецЕсли;
		
		//СубконтоДт
		CW_БухгалтерскийУчетМСФО.УстановитьСубконто(Движение.СчетКт, Движение.СубконтоКт, "ДенежныеCредства"	, ВыборкаПоШапке.Касса);
		
		Если ИспользоватьСтатьиДДС Тогда
			CW_БухгалтерскийУчетМСФО.УстановитьСубконто(Движение.СчетКт, Движение.СубконтоКт, "СтатьиДвиженияДенежныхСредств"	, ВыборкаПоШапке.КассаСтатьяДДС);
		КонецЕсли;
		
		Движение.Содержание = СодежаниеПроводки; 
		Движение.Сумма 		= Выборка_ОплатаПоставщику.Всего;		
		
	КонецЦикла;
	
	//Курсовые разницы
	//d.samuilov@coralway.ru
	//--------------------------
	ВычестьНереализованнуюКурсовуюРазницу(мРезультатыЗапроса,ВыборкаПоШапке,СтруктураНастроек,Движения,Отказ);
	//--------------------------

	РезультатКурсовыеРазницы 	= мРезультатыЗапроса[1];
	Если Не РезультатКурсовыеРазницы.Пустой() Тогда
		
		ВыборкаКурсовыеРазницы 		= РезультатКурсовыеРазницы.Выбрать();
		
		Пока ВыборкаКурсовыеРазницы.Следующий() Цикл
			
			ДанныеДляПроводки = Новый Структура;
			ДанныеДляПроводки.Вставить("Дата"					, ВыборкаПоШапке.Дата);
			ДанныеДляПроводки.Вставить("Организация"			, ВыборкаПоШапке.Организация);
			ДанныеДляПроводки.Вставить("Подразделение"			, ВыборкаПоШапке.Подразделение);
			ДанныеДляПроводки.Вставить("Валюта"					, ВыборкаКурсовыеРазницы.Валюта);
			
			ДанныеДляПроводки.Вставить("КоррСчет"				, СтруктураНастроек.СчетУчетаПоставщиков);
			ДанныеДляПроводки.Вставить("КоррПодразделение"		, ВыборкаПоШапке.Подразделение);
			ДанныеДляПроводки.Вставить("КоррСубконто1"			, ВыборкаКурсовыеРазницы.Контрагент);
			ДанныеДляПроводки.Вставить("КоррСубконто2"			, ВыборкаКурсовыеРазницы.Договор);
			ДанныеДляПроводки.Вставить("КоррСубконто3"			, ВыборкаКурсовыеРазницы.Счет);
			
			ДанныеДляПроводки.Вставить("СуммаКурсовойРазницы"	, -ВыборкаКурсовыеРазницы.Всего);
			
			ВыполнитьДвиженияПоКурсовымРазницам(Движения, СтруктураНастроек, ДанныеДляПроводки, Отказ);
			
		КонецЦикла;
		
		
	КонецЕсли;
	
КонецПроцедуры


//ДВИЖЕНИЯ ДОКУМЕНТА "CW_РасходыПоПриобретениям"
Процедура СформированияДвиженияДокумента_РасходыПоПриобретениям(Источник, СтруктураНастроек, Отказ)	
	
	ЗапросПоШапке = новый Запрос;
	ЗапросПоШапке.Текст = "ВЫБРАТЬ
	|	CW_РасходыПоПриобретениям.Ссылка КАК Ссылка,
	|	CW_РасходыПоПриобретениям.Дата КАК Дата,
	|	CW_РасходыПоПриобретениям.Организация КАК Организация,
	|	CW_РасходыПоПриобретениям.ПодразделениеОрганизации КАК ПодразделениеОрганизации,
	|	CW_РасходыПоПриобретениям.Контрагент КАК Контрагент,
	|	CW_РасходыПоПриобретениям.Договор КАК Договор,
	|	CW_РасходыПоПриобретениям.Валюта КАК Валюта,
	|	CW_РасходыПоПриобретениям.ПредставлениеДокумента КАК ПредставлениеДокумента
	|ИЗ
	|	Документ.CW_РасходыПоПриобретениям КАК CW_РасходыПоПриобретениям
	|ГДЕ
	|	CW_РасходыПоПриобретениям.Ссылка = &ИсточникСсылка";
	
	ЗапросПоШапке.УстановитьПараметр("ИсточникСсылка", Источник.Ссылка);
	ВыборкаПоШапке = ЗапросПоШапке.Выполнить().Выбрать();
	ВыборкаПоШапке.Следующий();
	
	СвойстваСчетУчетаПоставщиков	= CW_БухгалтерскийУчетВызовСервераПовтИспМСФО.ПолучитьСвойстваСчета(СтруктураНастроек.СчетУчетаПоставщиков);
	СвойстваСчетАвансовПоставщиков	= CW_БухгалтерскийУчетВызовСервераПовтИспМСФО.ПолучитьСвойстваСчета(СтруктураНастроек.СчетАвансовПоставщиков);
	//СвойстваСчетУчетаЗатрат			= CW_БухгалтерскийУчетВызовСервераПовтИспМСФО.ПолучитьСвойстваСчета(СтруктураНастроек.СчетУчетаЗатрат);
	СвойстваСчетНДС 				= CW_БухгалтерскийУчетВызовСервераПовтИспМСФО.ПолучитьСвойстваСчета(СтруктураНастроек.СчетУчетаНДС);
	
	#Область Получение_данных
	
	//Получаем наборы движений
	НаборЗаписей_ОЗ = _сф.НаборЗаписейПоРегистратору(РегистрыНакопления.CW_ОперативнаяКредиторскаяЗадолженность,ВыборкаПоШапке.Ссылка);
	НаборЗаписей_ОЗ.Прочитать();
	
	НаборЗаписей_РасходыПоПриобретениям = _сф.НаборЗаписейПоРегистратору(РегистрыНакопления.CW_РасходыПоПриобретениям,ВыборкаПоШапке.Ссылка);
	НаборЗаписей_РасходыПоПриобретениям.Прочитать();
	
	ОперативнаяКредиторскаяЗадолженность 	= НаборЗаписей_ОЗ.Выгрузить();
	РасходыПоПриобретениям					= НаборЗаписей_РасходыПоПриобретениям.Выгрузить();
	
	Запрос = новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.Текст = "ВЫБРАТЬ
	|	CW_ОперативнаяКредиторскаяЗадолженностьОбороты.НомерСтроки КАК НомерСтроки,
	|	CW_ОперативнаяКредиторскаяЗадолженностьОбороты.Контрагент КАК Контрагент,
	|	CW_ОперативнаяКредиторскаяЗадолженностьОбороты.Договор КАК Договор,
	|	CW_ОперативнаяКредиторскаяЗадолженностьОбороты.ВидОперации КАК ВидОперации,
	|	CW_ОперативнаяКредиторскаяЗадолженностьОбороты.Счет КАК Счет,
	|	CW_ОперативнаяКредиторскаяЗадолженностьОбороты.Валюта КАК Валюта,
	|	CW_ОперативнаяКредиторскаяЗадолженностьОбороты.Всего КАК СуммаАванса,
	|	CW_ОперативнаяКредиторскаяЗадолженностьОбороты.Всего_Валюта КАК ВалютнаяСуммаАванса
	|ПОМЕСТИТЬ ВТ_ЗачтенныеАвансы
	|ИЗ
	|	&ОперативнаяКредиторскаяЗадолженность КАК CW_ОперативнаяКредиторскаяЗадолженностьОбороты
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	РасходыПоПриобретениям.Контрагент КАК Контрагент,
	|	РасходыПоПриобретениям.Договор КАК Договор,
	|	РасходыПоПриобретениям.СтатьяЗатрат КАК СтатьяЗатрат,
	|	РасходыПоПриобретениям.Номенклатура КАК Номенклатура,
	|	РасходыПоПриобретениям.ДокументЗатрат КАК ДокументЗатрат,
	
	|	РасходыПоПриобретениям.Валюта КАК Валюта,
	|	РасходыПоПриобретениям.УчетНДС КАК УчетНДС,
	|	РасходыПоПриобретениям.СчетЗатрат КАК СчетЗатрат,
	|	РасходыПоПриобретениям.СчетНДС КАК СчетНДС,
	|	РасходыПоПриобретениям.Субконто1 КАК Субконто1,
	|	РасходыПоПриобретениям.Субконто2 КАК Субконто2,
	|	РасходыПоПриобретениям.Субконто3 КАК Субконто3,
	
	|	РасходыПоПриобретениям.Количество КАК Количество,
	|	РасходыПоПриобретениям.Сумма КАК Сумма,
	|	РасходыПоПриобретениям.СуммаНДС КАК СуммаНДС,
	|	РасходыПоПриобретениям.ВалютнаяСумма КАК ВалютнаяСумма,
	|	РасходыПоПриобретениям.ВалютнаяСуммаНДС КАК ВалютнаяСуммаНДС
	|ПОМЕСТИТЬ ВТ_Расходы
	|ИЗ
	|	&РасходыПоПриобретениям КАК РасходыПоПриобретениям";
	
	Запрос.УстановитьПараметр("ОперативнаяКредиторскаяЗадолженность"	, ОперативнаяКредиторскаяЗадолженность);
	Запрос.УстановитьПараметр("РасходыПоПриобретениям"					, РасходыПоПриобретениям);
	
	Запрос.Выполнить();
	
	Запрос.Текст = "ВЫБРАТЬ
	|	ВТ_ЗачтенныеАвансы.Контрагент КАК Контрагент,
	|	ВТ_ЗачтенныеАвансы.Договор КАК Договор,
	|	ВТ_ЗачтенныеАвансы.Валюта КАК Валюта,
	|	СУММА(ВТ_ЗачтенныеАвансы.ВалютнаяСуммаАванса) КАК ВалютнаяСуммаАванса,
	|	СУММА(ВТ_ЗачтенныеАвансы.СуммаАванса) КАК СуммаАванса
	|ИЗ
	|	ВТ_ЗачтенныеАвансы КАК ВТ_ЗачтенныеАвансы
	|ГДЕ
	|	ВТ_ЗачтенныеАвансы.ВидОперации 	= &ЗачетАванса
	|	И ВТ_ЗачтенныеАвансы.Счет 		= &ТекущийСчет
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_ЗачтенныеАвансы.Контрагент,
	|	ВТ_ЗачтенныеАвансы.Договор,
	|	ВТ_ЗачтенныеАвансы.Валюта";
	
	Запрос.УстановитьПараметр("ЗачетАванса"	, Перечисления.CW_ВидыДвиженийПоОперативнойЗадолженности.ЗачетАванса);
	Запрос.УстановитьПараметр("ТекущийСчет"	, ВыборкаПоШапке.Ссылка);
	
	РезультатАвансы = Запрос.Выполнить();
	
	Запрос.Текст = "ВЫБРАТЬ
	
	|	ВТ_Расходы.Контрагент КАК Контрагент,
	|	ВТ_Расходы.Договор КАК Договор,
	|	ВТ_Расходы.СтатьяЗатрат КАК СтатьяЗатрат,
	|	ВТ_Расходы.Номенклатура КАК Номенклатура,
	|	ВТ_Расходы.Номенклатура.НоменклатурнаяГруппа КАК НоменклатурнаяГруппа,
	
	|	ВТ_Расходы.Валюта КАК Валюта,
	|	ВТ_Расходы.УчетНДС КАК УчетНДС,
	|	ВТ_Расходы.СчетЗатрат КАК СчетЗатрат,
	|	ВТ_Расходы.СчетНДС КАК СчетНДС,
	|	ВТ_Расходы.Субконто1 КАК Субконто1,
	|	ВТ_Расходы.Субконто2 КАК Субконто2,
	|	ВТ_Расходы.Субконто3 КАК Субконто3,
	
	|	СУММА(ВТ_Расходы.Количество) КАК Количество,
	|	СУММА(ВТ_Расходы.Сумма) КАК Сумма,
	|	СУММА(ВТ_Расходы.СуммаНДС) КАК СуммаНДС,
	|	СУММА(ВТ_Расходы.ВалютнаяСумма) КАК ВалютнаяСумма,
	|	СУММА(ВТ_Расходы.ВалютнаяСуммаНДС) КАК ВалютнаяСуммаНДС
	|ИЗ
	|	ВТ_Расходы КАК ВТ_Расходы
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_Расходы.Контрагент,
	|	ВТ_Расходы.Договор,
	|	ВТ_Расходы.СтатьяЗатрат,
	|	ВТ_Расходы.Номенклатура.НоменклатурнаяГруппа,
	|	ВТ_Расходы.Номенклатура,
	|	ВТ_Расходы.Валюта,
	|	ВТ_Расходы.УчетНДС,
	|	ВТ_Расходы.СчетНДС,
	|	ВТ_Расходы.СчетЗатрат,
	|	ВТ_Расходы.Субконто1,
	|	ВТ_Расходы.Субконто2,
	|	ВТ_Расходы.Субконто3";
	
	РезультатЗатрарты = Запрос.Выполнить();
	
	#КонецОбласти
	
	#Область Авансы
	
	ВыборкаАвансы = РезультатАвансы.Выбрать();
	
	Пока ВыборкаАвансы.Следующий() Цикл
		
		Движение = Источник.Движения.CW_МСФО.Добавить();
		Движение.Период			= ВыборкаПоШапке.Дата;
		Движение.Организация 	= ВыборкаПоШапке.Организация;
		
		//ДЕБЕТ
		Движение.СчетДт 		=  СтруктураНастроек.СчетУчетаПоставщиков;
		
		//Учет по подразделениям
		Если СвойстваСчетУчетаПоставщиков.УчетПоПодразделениям Тогда
			Движение.ПодразделениеКт =  ВыборкаПоШапке.ПодразделениеОрганизации;
		КонецЕсли;
		
		//Валюта Дт
		Если СвойстваСчетУчетаПоставщиков.Валютный Тогда
			Движение.ВалютаДт 			= ВыборкаПоШапке.Валюта;
			Движение.ВалютнаяСуммаДт 	= ВыборкаАвансы.ВалютнаяСуммаАванса;
		КонецЕсли;
		
		//Субконто Дт
		CW_БухгалтерскийУчетМСФО.УстановитьСубконто(Движение.СчетДт, Движение.СубконтоДт, "Контрагенты"						, ВыборкаАвансы.Контрагент);
		CW_БухгалтерскийУчетМСФО.УстановитьСубконто(Движение.СчетДт, Движение.СубконтоДт, "Договоры"						, ВыборкаАвансы.Договор);
		CW_БухгалтерскийУчетМСФО.УстановитьСубконто(Движение.СчетДт, Движение.СубконтоДт, "ДокументыРасчетовСКонтрагентами"	, ВыборкаПоШапке.Ссылка);
		
		//КРЕДИТ
		Движение.СчетКт 		= СтруктураНастроек.СчетАвансовПоставщиков;
		
		//Учет по подразделениям
		Если СвойстваСчетАвансовПоставщиков.УчетПоПодразделениям Тогда
			Движение.ПодразделениеКт =  ВыборкаПоШапке.ПодразделениеОрганизации;
		КонецЕсли;
		
		//Валюта Дт
		Если СвойстваСчетАвансовПоставщиков.Валютный Тогда
			Движение.ВалютаКт 			= ВыборкаПоШапке.Валюта;
			Движение.ВалютнаяСуммаКт 	= ВыборкаАвансы.ВалютнаяСуммаАванса;
		КонецЕсли;
		
		//СубконтоКт
		CW_БухгалтерскийУчетМСФО.УстановитьСубконто(Движение.СчетКт, Движение.СубконтоКт, "Контрагенты"				, ВыборкаАвансы.Контрагент);
		CW_БухгалтерскийУчетМСФО.УстановитьСубконто(Движение.СчетКт, Движение.СубконтоКт, "Договоры"				, ВыборкаАвансы.Договор);
		
		Движение.Содержание = "Offset advance paid"; 
		Движение.Сумма 		= ВыборкаАвансы.СуммаАванса;
		
	КонецЦикла;
	
	#Конецобласти
	
	#Область Затраты
	
	ВыборкаЗатраты = РезультатЗатрарты.Выбрать();
	
	Пока ВыборкаЗатраты.Следующий() Цикл
		
		Движение = Источник.Движения.CW_МСФО.Добавить();
		Движение.Период			= ВыборкаПоШапке.Дата;
		Движение.Организация 	= ВыборкаПоШапке.Организация;
		
		ВалютнаяСумма 	= ?(ВыборкаЗатраты.УчетНДС, ВыборкаЗатраты.ВалютнаяСумма	, ВыборкаЗатраты.ВалютнаяСумма	+ ВыборкаЗатраты.ВалютнаяСуммаНДС); 
		Сумма 			= ?(ВыборкаЗатраты.УчетНДС, ВыборкаЗатраты.Сумма			, ВыборкаЗатраты.Сумма			+ ВыборкаЗатраты.СуммаНДС); 
		
		//ДЕБЕТ
		СвойстваСчетЗатрат		= CW_БухгалтерскийУчетВызовСервераПовтИспМСФО.ПолучитьСвойстваСчета(ВыборкаЗатраты.СчетЗатрат);
		Движение.СчетДт 		= ВыборкаЗатраты.СчетЗатрат;
		
		//Учет по подразделениям
		Если СвойстваСчетЗатрат.УчетПоПодразделениям Тогда
			Движение.ПодразделениеДт =  ВыборкаПоШапке.ПодразделениеОрганизации;
		КонецЕсли;
		
		//Валюта Дт
		Если СвойстваСчетЗатрат.Валютный Тогда
			Движение.ВалютаДт 			= ВыборкаЗатраты.Валюта;
			Движение.ВалютнаяСуммаДт 	= ВалютнаяСумма;
		КонецЕсли;
		
		//Количество Дт
		Если СвойстваСчетЗатрат.Количественный Тогда
			Движение.КоличествоДт = ВыборкаЗатраты.Количество;
		КонецЕсли;
		
		//СубконтоДт
		CW_БухгалтерскийУчетМСФО.УстановитьСубконто(Движение.СчетДт, Движение.СубконтоДт, 1	, ВыборкаЗатраты.Субконто1);
		CW_БухгалтерскийУчетМСФО.УстановитьСубконто(Движение.СчетДт, Движение.СубконтоДт, 2	, ВыборкаЗатраты.Субконто2);
		CW_БухгалтерскийУчетМСФО.УстановитьСубконто(Движение.СчетДт, Движение.СубконтоДт, 3	, ВыборкаЗатраты.Субконто3);
		
		
		//КРЕДИТ
		Движение.СчетКт 		=  СтруктураНастроек.СчетУчетаПоставщиков;
		
		//Учет по подразделениям
		Если СвойстваСчетУчетаПоставщиков.УчетПоПодразделениям Тогда
			Движение.ПодразделениеКт =  ВыборкаПоШапке.ПодразделениеОрганизации;
		КонецЕсли;
		
		//Количество Дт
		Если СвойстваСчетУчетаПоставщиков.Количественный Тогда
			Движение.КоличествоКт = ВыборкаЗатраты.Количество;
		КонецЕсли;
		
		//Валюта Кт
		Если СвойстваСчетУчетаПоставщиков.Валютный Тогда
			Движение.ВалютаКт 			= ВыборкаПоШапке.Валюта;
			Движение.ВалютнаяСуммаКт 	= ВалютнаяСумма;
		КонецЕсли;
		
		//СубконтоКт
		CW_БухгалтерскийУчетМСФО.УстановитьСубконто(Движение.СчетКт, Движение.СубконтоКт, "Контрагенты"						, ВыборкаЗатраты.Контрагент);
		CW_БухгалтерскийУчетМСФО.УстановитьСубконто(Движение.СчетКт, Движение.СубконтоКт, "Договоры"						, ВыборкаЗатраты.Договор);
		CW_БухгалтерскийУчетМСФО.УстановитьСубконто(Движение.СчетКт, Движение.СубконтоКт, "ДокументыРасчетовСКонтрагентами"	, ВыборкаПоШапке.Ссылка);
		
		Движение.Содержание = "Acquisition expenses"; 
		Движение.Сумма 		= Сумма;
		
		
		//НДС
		
		Если ВыборкаЗатраты.УчетНДС Тогда
			
			Движение = Источник.Движения.CW_МСФО.Добавить();
			Движение.Период			= ВыборкаПоШапке.Дата;
			Движение.Организация 	= ВыборкаПоШапке.Организация;
			
			//ДЕБЕТ
			Движение.СчетДт 		= СтруктураНастроек.СчетУчетаНДС;
			
			//Учет по подразделениям
			Если СвойстваСчетНДС.УчетПоПодразделениям Тогда
				Движение.ПодразделениеДт =  ВыборкаПоШапке.ПодразделениеОрганизации;
			КонецЕсли;
			
			//Валюта Дт
			Если СвойстваСчетНДС.Валютный Тогда
				Движение.ВалютаДт 			= ВыборкаЗатраты.Валюта;
				Движение.ВалютнаяСуммаДт 	= ВыборкаЗатраты.ВалютнаяСуммаНДС;
			КонецЕсли;
			
			//СубконтоДт
			CW_БухгалтерскийУчетМСФО.УстановитьСубконто(Движение.СчетДт, Движение.СубконтоДт, 1	, СтруктураНастроек.СчетУчетаНДССубконто1);
			CW_БухгалтерскийУчетМСФО.УстановитьСубконто(Движение.СчетДт, Движение.СубконтоДт, 2	, СтруктураНастроек.СчетУчетаНДССубконто2);
			CW_БухгалтерскийУчетМСФО.УстановитьСубконто(Движение.СчетДт, Движение.СубконтоДт, 3	, СтруктураНастроек.СчетУчетаНДССубконто3);
			
			
			//КРЕДИТ
			Движение.СчетКт 		=  СтруктураНастроек.СчетУчетаПоставщиков;
			
			//Учет по подразделениям
			Если СвойстваСчетУчетаПоставщиков.УчетПоПодразделениям Тогда
				Движение.ПодразделениеКт =  ВыборкаПоШапке.ПодразделениеОрганизации;
			КонецЕсли;
			
			//Валюта Кт
			Если СвойстваСчетУчетаПоставщиков.Валютный Тогда
				Движение.ВалютаКт 			= ВыборкаПоШапке.Валюта;
				Движение.ВалютнаяСуммаКт 	= ВыборкаЗатраты.ВалютнаяСуммаНДС;
			КонецЕсли;
			
			//СубконтоКт
			CW_БухгалтерскийУчетМСФО.УстановитьСубконто(Движение.СчетКт, Движение.СубконтоКт, "Контрагенты"						, ВыборкаЗатраты.Контрагент);
			CW_БухгалтерскийУчетМСФО.УстановитьСубконто(Движение.СчетКт, Движение.СубконтоКт, "Договоры"						, ВыборкаЗатраты.Договор);
			CW_БухгалтерскийУчетМСФО.УстановитьСубконто(Движение.СчетКт, Движение.СубконтоКт, "ДокументыРасчетовСКонтрагентами"	, ВыборкаПоШапке.Ссылка);
			
			Движение.Содержание = "Purchase VAT"; 
			Движение.Сумма 		= ВыборкаЗатраты.СуммаНДС;
		КонецЕсли;
		
	КонецЦикла;
	
	#КонецОбласти
	
КонецПроцедуры


////ДВИЖЕНИЯ ДОКУМЕНТА "CW_РасходыПодотчетногоЛица"
Процедура СформированияДвиженияДокумента_РасходыПодотчетногоЛица(Источник, СтруктураНастроек, Отказ)
	
	СвойстваСчетаУчета	= CW_БухгалтерскийУчетВызовСервераПовтИспМСФО.ПолучитьСвойстваСчета(СтруктураНастроек.СчетУчетаРасчетовСПодотчетнымиЛицами);
	СвойстваСчетАвансов	= CW_БухгалтерскийУчетВызовСервераПовтИспМСФО.ПолучитьСвойстваСчета(СтруктураНастроек.СчетАвансовПодотчетныхЛиц);
	СвойстваСчетНДС		= CW_БухгалтерскийУчетВызовСервераПовтИспМСФО.ПолучитьСвойстваСчета(СтруктураНастроек.СчетУчетаНДС);
	
	ВалютаРегламентированногоУчета = Константы.ВалютаРегламентированногоУчета.Получить();
	
	//Шапка документа
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.Текст = "ВЫБРАТЬ
	|	CW_РасходыПодотчетногоЛица.Ссылка КАК Ссылка,
	|	CW_РасходыПодотчетногоЛица.Дата КАК Дата,
	|	CW_РасходыПодотчетногоЛица.Организация КАК Организация,
	|	CW_РасходыПодотчетногоЛица.ПодразделениеОрганизации КАК ПодразделениеОрганизации,
	|	CW_РасходыПодотчетногоЛица.Контрагент КАК Работник,
	|	CW_РасходыПодотчетногоЛица.Валюта КАК Валюта,
	|	CW_РасходыПодотчетногоЛица.СпособЗачетаАвансов КАК СпособЗачетаАвансов
	|ПОМЕСТИТЬ ВТ_ШапкаДокумента
	|ИЗ
	|	Документ.CW_РасходыПодотчетногоЛица КАК CW_РасходыПодотчетногоЛица
	|ГДЕ
	|	CW_РасходыПодотчетногоЛица.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	CW_РасходыПодотчетногоЛицаУслуги.Ссылка.Контрагент КАК Работник,
	|	CW_РасходыПодотчетногоЛицаУслуги.Номенклатура КАК Номенклатура,
	|	CW_РасходыПодотчетногоЛицаУслуги.СтатьяЗатрат КАК СтатьяЗатрат,
	|	CW_РасходыПодотчетногоЛицаУслуги.ПодразделениеЗатрат КАК ПодразделениеЗатрат,
	|	CW_РасходыПодотчетногоЛицаУслуги.СчетЗатрат КАК СчетЗатрат,
	|	CW_РасходыПодотчетногоЛицаУслуги.Количество КАК Количество,
	|	CW_РасходыПодотчетногоЛицаУслуги.СтавкаНДС КАК СтавкаНДС,
	|	CW_РасходыПодотчетногоЛицаУслуги.Сумма КАК СуммаВал,
	|	CW_РасходыПодотчетногоЛицаУслуги.НДС КАК НДСВал,
	|	CW_РасходыПодотчетногоЛицаУслуги.Всего КАК ВсегоВал,
	|	CW_РасходыПодотчетногоЛицаУслуги.УчитыватьНДС КАК УчитыватьНДС,
	|	CW_РасходыПодотчетногоЛицаУслуги.СчетНДС КАК СчетНДС,
	|	CW_РасходыПодотчетногоЛицаУслуги.Субконто1 КАК Субконто1,
	|	CW_РасходыПодотчетногоЛицаУслуги.Субконто2 КАК Субконто2,
	|	CW_РасходыПодотчетногоЛицаУслуги.Субконто3 КАК Субконто3,
	|	CW_РасходыПодотчетногоЛицаУслуги.Представление КАК Представление
	|ПОМЕСТИТЬ ВТ_ДанныеДокумента
	|ИЗ
	|	Документ.CW_РасходыПодотчетногоЛица.Услуги КАК CW_РасходыПодотчетногоЛицаУслуги
	|ГДЕ
	|	CW_РасходыПодотчетногоЛицаУслуги.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ШапкаДокумента.Ссылка КАК Ссылка,
	|	ВТ_ШапкаДокумента.Дата КАК Дата,
	|	ВТ_ШапкаДокумента.Организация КАК Организация,
	|	ВТ_ШапкаДокумента.ПодразделениеОрганизации КАК ПодразделениеОрганизации,
	|	ВТ_ШапкаДокумента.Работник КАК Работник,
	|	ВТ_ШапкаДокумента.Валюта КАК Валюта,
	|	ВТ_ШапкаДокумента.СпособЗачетаАвансов КАК СпособЗачетаАвансов
	|ИЗ
	|	ВТ_ШапкаДокумента КАК ВТ_ШапкаДокумента";
	
	Запрос.УстановитьПараметр("Ссылка", Источник.Ссылка); 
	Результат = Запрос.Выполнить();
	
	ВыборкаПоШапке = Результат.Выбрать();
	ВыборкаПоШапке.Следующий();
	
	#Область Авансы
	
	СуммаЗачетаАвансаРег = 0;
	СуммаЗачетаАвансаВал = 0;
	
	Если ВыборкаПоШапке.СпособЗачетаАвансов = Перечисления.СпособыЗачетаАвансов.Автоматически Тогда
		
		Запрос.Текст ="ВЫБРАТЬ
		              |	CW_МСФООстатки.Субконто1 КАК Работник,
		              |	CW_МСФООстатки.СуммаОстаток КАК СуммаАвансаРег,
		              |	CW_МСФООстатки.ВалютнаяСуммаОстаток КАК СуммаАвансаВал
		              |ПОМЕСТИТЬ ВТ_Авансы
		              |ИЗ
		              |	РегистрБухгалтерии.CW_МСФО.Остатки(
		              |			&МоментВремени,
		              |			Счет = &СчетУчетаАвансов,
		              |			&мСубконтоРаботники,
		              |			(Организация, Субконто1, Валюта) В
		              |					(ВЫБРАТЬ
		              |						ВТ_ШапкаДокумента.Организация КАК Организация,
		              |						ВТ_ШапкаДокумента.Работник КАК Работник,
		              |						ВТ_ШапкаДокумента.Валюта КАК Валюта
		              |					ИЗ
		              |						ВТ_ШапкаДокумента КАК ВТ_ШапкаДокумента)
		              |				И ВЫБОР
		              |					КОГДА &УчетПоПодразделеиям
		              |						ТОГДА Подразделение = &Подразделение
		              |					ИНАЧЕ ИСТИНА
		              |				КОНЕЦ) КАК CW_МСФООстатки
		              |;
		              |
		              |////////////////////////////////////////////////////////////////////////////////
		              |ВЫБРАТЬ
		              |	СУММА(ВТ_ДанныеДокумента.ВсегоВал) КАК ВсегоВал,
		              |	ВТ_ДанныеДокумента.Работник КАК Работник
		              |ПОМЕСТИТЬ ВТ_ВсегоПоДокументуВВалюте
		              |ИЗ
		              |	ВТ_ДанныеДокумента КАК ВТ_ДанныеДокумента
		              |
		              |СГРУППИРОВАТЬ ПО
		              |	ВТ_ДанныеДокумента.Работник
		              |;
		              |
		              |////////////////////////////////////////////////////////////////////////////////
		              |ВЫБРАТЬ
		              |	ВТ_Авансы.Работник КАК Работник,
		              |	ВТ_ВсегоПоДокументуВВалюте.ВсегоВал КАК ВсегоВал,
		              |	ВТ_Авансы.СуммаАвансаВал КАК СуммаАвансаВал,
		              |	ВТ_Авансы.СуммаАвансаРег КАК СуммаАвансаРег
		              |ИЗ
		              |	ВТ_ВсегоПоДокументуВВалюте КАК ВТ_ВсегоПоДокументуВВалюте
		              |		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Авансы КАК ВТ_Авансы
		              |		ПО ВТ_ВсегоПоДокументуВВалюте.Работник = ВТ_Авансы.Работник
		              |ГДЕ
		              |	ВТ_Авансы.СуммаАвансаВал > 0";
		
		
		мСубконтоРаботники = Новый Массив;
		мСубконтоРаботники.Добавить(ПланыВидовХарактеристик.CW_ВидыСубконтоМСФО.Работники);
		
		Запрос.УстановитьПараметр("Ссылка", Источник.Ссылка); 
		Запрос.УстановитьПараметр("МоментВремени"			, Новый Граница(Источник.МоментВремени(), ВидГраницы.Исключая));		
		Запрос.УстановитьПараметр("СчетУчетаАвансов"		, СтруктураНастроек.СчетАвансовПодотчетныхЛиц);		
		Запрос.УстановитьПараметр("мСубконтоРаботники"		, мСубконтоРаботники);
		
		Запрос.УстановитьПараметр("УчетПоПодразделеиям"		,  СвойстваСчетАвансов.УчетПоПодразделениям);		
		Запрос.УстановитьПараметр("Подразделение"			,  ВыборкаПоШапке.ПодразделениеОрганизации);		
		
		РезультатАвансы = Запрос.Выполнить();
		
		ВыборкаАвансы = РезультатАвансы.Выбрать();
		
		Пока ВыборкаАвансы.Следующий() Цикл
			
			Движение = Источник.Движения.CW_МСФО.Добавить();
			Движение.Период			= ВыборкаПоШапке.Дата;
			Движение.Организация 	= ВыборкаПоШапке.Организация;
			
			СуммаЗачетаАвансаВал 	= Мин(ВыборкаАвансы.СуммаАвансаВал, ВыборкаАвансы.ВсегоВал);
			
			Если СуммаЗачетаАвансаВал = ВыборкаАвансы.ВсегоВал Тогда
				//Полный зачет аванса
				СуммаЗачетаАвансаРег 	= ВыборкаАвансы.СуммаАвансаРег;
			Иначе
				СуммаЗачетаАвансаРег 	= ОКР(СуммаЗачетаАвансаВал * ?(ВыборкаАвансы.СуммаАвансаВал = 0,0, ВыборкаАвансы.СуммаАвансаРег / ВыборкаАвансы.СуммаАвансаВал),2);
			КонецЕсли;
			
			//ДЕБЕТ
			Движение.СчетДт 		=  СтруктураНастроек.СчетУчетаРасчетовСПодотчетнымиЛицами;
			
			//Учет по подразделениям
			Если СвойстваСчетаУчета.УчетПоПодразделениям Тогда
				Движение.ПодразделениеКт =  ВыборкаПоШапке.ПодразделениеОрганизации;
			КонецЕсли;
			
			//Валюта Дт
			Если СвойстваСчетаУчета.Валютный Тогда
				Движение.ВалютаДт 			= ВыборкаПоШапке.Валюта;
				Движение.ВалютнаяСуммаДт 	= СуммаЗачетаАвансаВал;
			КонецЕсли;
			
			//Субконто Дт
			CW_БухгалтерскийУчетМСФО.УстановитьСубконто(Движение.СчетДт, Движение.СубконтоДт, "Работники", ВыборкаПоШапке.Работник);
			
			//КРЕДИТ
			Движение.СчетКт 		= СтруктураНастроек.СчетАвансовПодотчетныхЛиц;       
			
			//Учет по подразделениям
			Если СвойстваСчетАвансов.УчетПоПодразделениям Тогда
				Движение.ПодразделениеКт =  ВыборкаПоШапке.ПодразделениеОрганизации;
			КонецЕсли;
			
			//Валюта Дт
			Если СвойстваСчетАвансов.Валютный Тогда
				Движение.ВалютаКт 			= ВыборкаПоШапке.Валюта;
				Движение.ВалютнаяСуммаКт 	= СуммаЗачетаАвансаВал;
			КонецЕсли;
			
			//СубконтоКт
			CW_БухгалтерскийУчетМСФО.УстановитьСубконто(Движение.СчетКт, Движение.СубконтоКт, "Работники", ВыборкаПоШапке.Работник);
			
			Движение.Содержание = "Credited is the advance given to the employee"; 
			Движение.Сумма 		= СуммаЗачетаАвансаРег;
			
		КонецЦикла;
		
	КонецЕсли;
	
	#КонецОбласти
	
	Запрос.Текст = "ВЫБРАТЬ
	|	ВТ_ДанныеДокумента.Работник КАК Работник,
	|	ВТ_ДанныеДокумента.Номенклатура КАК Номенклатура,
	|	ВТ_ДанныеДокумента.Представление КАК Представление,
	|	ВТ_ДанныеДокумента.СтатьяЗатрат КАК СтатьяЗатрат,
	|	ВТ_ДанныеДокумента.ПодразделениеЗатрат КАК ПодразделениеЗатрат,
	|	ВТ_ДанныеДокумента.СчетЗатрат КАК СчетЗатрат,
	|	ВТ_ДанныеДокумента.Количество КАК Количество,
	|	ВТ_ДанныеДокумента.СтавкаНДС КАК СтавкаНДС,
	|	ВТ_ДанныеДокумента.СуммаВал КАК СуммаВал,
	|	ВТ_ДанныеДокумента.НДСВал КАК НДСВал,
	|	ВТ_ДанныеДокумента.ВсегоВал КАК ВсегоВал,
	|	0 КАК СуммаРег,
	|	0 КАК НДСРег,
	|	0 КАК ВсегоРег,
	|	0 КАК ЗачтеноВал,
	|	ВТ_ДанныеДокумента.УчитыватьНДС КАК УчитыватьНДС,
	|	ВТ_ДанныеДокумента.СчетНДС КАК СчетНДС,
	|	ВТ_ДанныеДокумента.Субконто1 КАК Субконто1,
	|	ВТ_ДанныеДокумента.Субконто2 КАК Субконто2,
	|	ВТ_ДанныеДокумента.Субконто3 КАК Субконто3
	|ИЗ
	|	ВТ_ДанныеДокумента КАК ВТ_ДанныеДокумента";
	
	Результат 		= Запрос.Выполнить();
	ТаблицаДанных 	= Результат.Выгрузить();
	
	Курс 			= CW_Финансы.ПолучитьКурсВалюты(ВыборкаПоШапке.Валюта,ВыборкаПоШапке.Дата);
	
	Если СуммаЗачетаАвансаВал <> 0 Тогда
		//Распределяем сумму зачтенного аванса в валюте
		ИтогоВсегоВал = ТаблицаДанных.Итог("ВсегоВал");
		
		Для Каждого СтрокаДанных из ТаблицаДанных Цикл
			ЗачтеноВал = Окр(СуммаЗачетаАвансаВал * СтрокаДанных.ВсегоВал / ИтогоВсегоВал, 2);
			ЗачтеноРег = Окр(СуммаЗачетаАвансаРег * СтрокаДанных.ВсегоВал / ИтогоВсегоВал, 2);
			
			СтрокаДанных.ЗачтеноВал = ЗачтеноВал;
			
			СтрокаДанных.ВсегоРег 	= ЗачтеноРег;
			
			СуммаЗачетаАвансаВал = СуммаЗачетаАвансаВал - ЗачтеноВал;
			СуммаЗачетаАвансаРег = СуммаЗачетаАвансаРег - ЗачтеноРег;
			
		КонецЦикла;
		
		Если СуммаЗачетаАвансаВал <> 0 Тогда
			СтрокаДанных.ЗачтеноВал = СтрокаДанных.ЗачтеноВал + ИтогоВсегоВал; 
		КонецЕсли;
		Если СуммаЗачетаАвансаРег <> 0 Тогда
			СтрокаДанных.ВсегоРег = СтрокаДанных.ВсегоРег + СуммаЗачетаАвансаРег; 
		КонецЕсли;
		
	КонецЕсли;
	
	
	//Пересчет остатка задолженности по курсу документа
	
	Для Каждого СтрокаДанных из ТаблицаДанных Цикл
		
		ОстатокВсегоВал = СтрокаДанных.ВсегоВал - СтрокаДанных.ЗачтеноВал;
		Если ОстатокВсегоВал <> 0 Тогда
			ОстатокВсегоРег	= Окр(CW_Финансы.ПересчитатьИзВалютыВВалюту(ОстатокВсегоВал	, ВыборкаПоШапке.Валюта, ВалютаРегламентированногоУчета, Курс.Курс, 1, Курс.Кратность, 1),2,1);
		КонецЕсли;
		
		СтрокаДанных.ВсегоРег = СтрокаДанных.ВсегоРег +  ?(ОстатокВсегоРег=Неопределено,0,ОстатокВсегоРег);
	КонецЦикла;
	
	//Пересчет регламетного НДС
	Для Каждого СтрокаДанных из ТаблицаДанных Цикл
		
		Ставка 					= CW_Финансы.ПолучитьСтавкуНДС(СтрокаДанных.СтавкаНДС)/100;
		
		СтрокаДанных.НДСРег 	= СтрокаДанных.ВсегоРег*Ставка/(1+Ставка);
		СтрокаДанных.СуммаРег 	= СтрокаДанных.ВсегоРег - СтрокаДанных.НДСРег;
		
	КонецЦикла;
	
	//Записчываем движения
	Для Каждого СтрокаУслуги из ТаблицаДанных Цикл
		
		// регистр "CW_РасходыПоПриобретениям"
		Движение 					= Источник.Движения.CW_РасходыПоПриобретениям.Добавить();
		
		Движение.Период         	= ВыборкаПоШапке.Дата;
		Движение.ДокументЗатрат  	= Источник.Ссылка;
		Движение.Организация     	= ВыборкаПоШапке.Организация;
		Движение.Контрагент     	= ВыборкаПоШапке.Работник;
		Движение.Валюта         	= ВыборкаПоШапке.Валюта;
		
		Движение.Номенклатура   	= СтрокаУслуги.Номенклатура;
		Движение.СтатьяЗатрат   	= СтрокаУслуги.СтатьяЗатрат;
		
		Движение.СтавкаНДС			= СтрокаУслуги.СтавкаНДС;
		
		Движение.СчетЗатрат         = СтрокаУслуги.СчетЗатрат;
		Движение.Субконто1         	= СтрокаУслуги.Субконто1;
		Движение.Субконто2         	= СтрокаУслуги.Субконто2;
		Движение.Субконто3         	= СтрокаУслуги.Субконто3;
		
		Движение.УчетНДС         	= СтрокаУслуги.УчитыватьНДС;
		Движение.СчетНДС         	= СтрокаУслуги.СчетНДС;
		
		Движение.Количество      	= СтрокаУслуги.Количество;
		
		Движение.ВалютнаяСумма 		= СтрокаУслуги.СуммаВал;
		Движение.ВалютнаяСуммаНДС 	= СтрокаУслуги.НДСВал;
		Движение.ВалютнаяСуммаВсего = СтрокаУслуги.ВсегоВал;
		
		Движение.Сумма		       	= СтрокаУслуги.СуммаРег;
		Движение.СуммаНДС	        = СтрокаУслуги.НДСРег;
		Движение.СуммаВсего		    = СтрокаУслуги.ВсегоРег;
		
		Движение.Примечание		    = СтрокаУслуги.Представление;
		
		
		
		//CW_МСФО
		Движение = Источник.Движения.CW_МСФО.Добавить();
		Движение.Период			= ВыборкаПоШапке.Дата;
		Движение.Организация 	= ВыборкаПоШапке.Организация;
		
		ВалютнаяСумма 	= ?(СтрокаУслуги.УчитыватьНДС, СтрокаУслуги.СуммаВал, СтрокаУслуги.ВсегоВал); 
		СуммаРег 		= ?(СтрокаУслуги.УчитыватьНДС, СтрокаУслуги.СуммаРег, СтрокаУслуги.ВсегоРег); 
		
		//ДЕБЕТ
		СвойстваСчетЗатрат		= CW_БухгалтерскийУчетВызовСервераПовтИспМСФО.ПолучитьСвойстваСчета(СтрокаУслуги.СчетЗатрат);
		Движение.СчетДт 		= СтрокаУслуги.СчетЗатрат;
		
		//Учет по подразделениям
		Если СвойстваСчетЗатрат.УчетПоПодразделениям Тогда
			Движение.ПодразделениеДт =  ВыборкаПоШапке.ПодразделениеОрганизации;
		КонецЕсли;
		
		//Валюта Дт
		Если СвойстваСчетЗатрат.Валютный Тогда
			Движение.ВалютаДт 			= ВыборкаПоШапке.Валюта;
			Движение.ВалютнаяСуммаДт 	= ВалютнаяСумма;
		КонецЕсли;
		
		//Количество Дт
		Если СвойстваСчетЗатрат.Количественный Тогда
			Движение.КоличествоДт = СтрокаУслуги.Количество;
		КонецЕсли;
		
		
		//СубконтоДт
		CW_БухгалтерскийУчетМСФО.УстановитьСубконто(Движение.СчетДт, Движение.СубконтоДт, 1	, СтрокаУслуги.Субконто1);
		CW_БухгалтерскийУчетМСФО.УстановитьСубконто(Движение.СчетДт, Движение.СубконтоДт, 2	, СтрокаУслуги.Субконто2);
		CW_БухгалтерскийУчетМСФО.УстановитьСубконто(Движение.СчетДт, Движение.СубконтоДт, 3	, СтрокаУслуги.Субконто3);
		
		
		//КРЕДИТ
		Движение.СчетКт 		=  СтруктураНастроек.СчетУчетаРасчетовСПодотчетнымиЛицами;
		
		//Учет по подразделениям
		Если СвойстваСчетаУчета.УчетПоПодразделениям Тогда
			Движение.ПодразделениеКт =  ВыборкаПоШапке.ПодразделениеОрганизации;
		КонецЕсли;
		
		//Количество Дт
		Если СвойстваСчетаУчета.Количественный Тогда
			Движение.КоличествоКт = СтрокаУслуги.Количество;
		КонецЕсли;
		
		//Валюта Кт
		Если СвойстваСчетаУчета.Валютный Тогда
			Движение.ВалютаКт 			= ВыборкаПоШапке.Валюта;
			Движение.ВалютнаяСуммаКт 	= ВалютнаяСумма;
		КонецЕсли;
		
		//СубконтоКт
		CW_БухгалтерскийУчетМСФО.УстановитьСубконто(Движение.СчетКт, Движение.СубконтоКт, "Работники", ВыборкаПоШапке.Работник);
		
		Движение.Содержание = "Expenses of the accountable person"; 
		Движение.Сумма 		= СуммаРег;
		
		//НДС
		
		Если СтрокаУслуги.УчитыватьНДС Тогда
			
			Движение = Источник.Движения.CW_МСФО.Добавить();
			Движение.Период			= ВыборкаПоШапке.Дата;
			Движение.Организация 	= ВыборкаПоШапке.Организация;
			
			//ДЕБЕТ
			Движение.СчетДт 		= СтруктураНастроек.СчетУчетаНДС;
			
			//Учет по подразделениям
			Если СвойстваСчетНДС.УчетПоПодразделениям Тогда
				Движение.ПодразделениеДт =  ВыборкаПоШапке.ПодразделениеОрганизации;
			КонецЕсли;
			
			//Валюта Дт
			Если СвойстваСчетНДС.Валютный Тогда
				Движение.ВалютаДт 			= ВыборкаПоШапке.Валюта;
				Движение.ВалютнаяСуммаДт 	= СтрокаУслуги.НДСВал;
			КонецЕсли;
			
			//СубконтоДт
			CW_БухгалтерскийУчетМСФО.УстановитьСубконто(Движение.СчетДт, Движение.СубконтоДт, 1	, СтруктураНастроек.СчетУчетаНДССубконто1);
			CW_БухгалтерскийУчетМСФО.УстановитьСубконто(Движение.СчетДт, Движение.СубконтоДт, 2	, СтруктураНастроек.СчетУчетаНДССубконто2);
			CW_БухгалтерскийУчетМСФО.УстановитьСубконто(Движение.СчетДт, Движение.СубконтоДт, 3	, СтруктураНастроек.СчетУчетаНДССубконто3);
			
			
			//КРЕДИТ
			Движение.СчетКт 		=  СтруктураНастроек.СчетУчетаРасчетовСПодотчетнымиЛицами;
			
			//Учет по подразделениям
			Если СвойстваСчетаУчета.УчетПоПодразделениям Тогда
				Движение.ПодразделениеКт =  ВыборкаПоШапке.ПодразделениеОрганизации;
			КонецЕсли;
			
			//Валюта Кт
			Если СвойстваСчетаУчета.Валютный Тогда
				Движение.ВалютаКт 			= ВыборкаПоШапке.Валюта;
				Движение.ВалютнаяСуммаКт 	= СтрокаУслуги.НДСВал;
			КонецЕсли;
			
			//СубконтоКт
			CW_БухгалтерскийУчетМСФО.УстановитьСубконто(Движение.СчетКт, Движение.СубконтоКт, "Работники", ВыборкаПоШапке.Работник);
			
			Движение.Содержание = "VAT on expenses of accountable person"; 
			Движение.Сумма 		= СтрокаУслуги.НДСРег;
		КонецЕсли;
		
	КонецЦикла;
	
	
	
КонецПроцедуры



