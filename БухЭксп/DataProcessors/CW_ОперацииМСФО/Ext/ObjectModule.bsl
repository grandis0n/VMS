		Если ИспользоватьСтатьиДДС Тогда
			CW_БухгалтерскийУчетМСФО.УстановитьСубконто(Движение.СчетКт, Движение.СубконтоКт, "СтатьиДвиженияДенежныхСредств"	, ВыборкаПоШапке.КассаСтатьяДДС);
		КонецЕсли;
		
		СтруктураКурса 	= CW_Финансы.ПолучитьКурсВалюты(ВыборкаПоШапке.КассаВалюта,ВыборкаПоШапке.Дата);
		СуммаРегСписано = CW_Финансы.ПересчитатьИзВалютыВВалюту(ВыборкаПоШапке.КассаСумма,ВыборкаПоШапке.КассаВалюта,БазоваяВалюта,СтруктураКурса.Курс,1,СтруктураКурса.Кратность,1);
		
		Движение.Содержание = "Discharged from the cash register"; 
		Движение.Сумма 		= СуммаРегСписано;		
		
		#КонецОбласти
		
		#Область Поступление_в_кассу
		
		Движение = Движения.Добавить();
		Движение.Период			= ВыборкаПоШапке.Дата;
