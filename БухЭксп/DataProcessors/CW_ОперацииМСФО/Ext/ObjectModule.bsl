			ДанныеДляПроводки.Вставить("КоррСубконто1"			, ВыборкаПоШапке.Субконто1);
			ДанныеДляПроводки.Вставить("КоррСубконто2"			, ВыборкаПоШапке.Субконто2);
			ДанныеДляПроводки.Вставить("КоррСубконто3"			, ВыборкаПоШапке.Субконто3);
			
			ДанныеДляПроводки.Вставить("СуммаКурсовойРазницы"	, СуммаКурсовойРазницы);
			
			ВыполнитьДвиженияПоКурсовымРазницам(Движения, СтруктураНастроек, ДанныеДляПроводки, Отказ) ;
