//2. Заполнить парамтер в тип перевозки  
&НаСервере
Процедура ПолучитьСписокТиповПеревозок()  
	
	
    Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	CW_ТипыПеревозок.Ссылка КАК Ссылка,
	               |	ВЫБОР
	               |		КОГДА CW_ТипыПеревозокПараметрыГрузоперевозки.Ссылка ЕСТЬ NULL
	               |			ТОГДА ЛОЖЬ
	               |		ИНАЧЕ ИСТИНА
	               |	КОНЕЦ КАК Пометка
	               |ИЗ
	               |	Справочник.CW_ТипыПеревозок КАК CW_ТипыПеревозок
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.CW_ТипыПеревозок.ПараметрыГрузоперевозки КАК CW_ТипыПеревозокПараметрыГрузоперевозки
	               |		ПО CW_ТипыПеревозок.Ссылка = CW_ТипыПеревозокПараметрыГрузоперевозки.Ссылка
	               |			И (CW_ТипыПеревозокПараметрыГрузоперевозки.Параметр = &МониторинговыйПараметр)
	               |ГДЕ
	               |	CW_ТипыПеревозок.ПометкаУдаления = ЛОЖЬ
	               |	И CW_ТипыПеревозок.ЭтоГруппа = ЛОЖЬ";   
	
	Запрос.УстановитьПараметр("МониторинговыйПараметр", МониторинговыйПараметр);  
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		СписокТиповПеревозок.Добавить(Выборка.Ссылка,,Выборка.Пометка);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПараметрВТипыПеревозок(Команда) 
	
	ЗаполнитьПараметрВТипыПеревозокНаСервере();
	
КонецПроцедуры    

&НаСервере
Процедура ЗаполнитьПараметрВТипыПеревозокНаСервере()  
	
	Для Каждого ЭлементСписка из СписокТиповПеревозок Цикл       
		Если ЭлементСписка.Пометка = Ложь Тогда
			Продолжить;
		КонецЕсли;
		
		Если ЭлементСписка.Значение.ПараметрыГрузоперевозки.Найти(МониторинговыйПараметр, "Параметр") <> Неопределено Тогда
			//Параметр уже есть
			Продолжить;
		КонецЕсли; 
		
		ТипПеревозкиОбъект = ЭлементСписка.Значение.ПолучитьОбъект();
		НоваяСтрока = ТипПеревозкиОбъект.ПараметрыГрузоперевозки.Добавить();
		НоваяСтрока.Параметр = МониторинговыйПараметр;
		ТипПеревозкиОбъект.Записать();
		
	КонецЦикла;
	
КонецПроцедуры

 //3. Работа с таблицей  
&НаКлиенте
Процедура КомандаЗаполнить(Команда)  
	
	Если не ПроверитьЗаполнение() Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьПеревозкиНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПеревозкиНаСервере()
	
	мПорядокОтражения = Новый Массив;
	мПорядокОтражения.Добавить(ПредопределенноеЗначение("Перечисление.CW_ПорядокОтраженияДоходов.СобственнаяУслуга"));
	мПорядокОтражения.Добавить(ПредопределенноеЗначение("Перечисление.CW_ПорядокОтраженияДоходов.ПрочиеДоходы"));
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	CW_ДоходыПоГрузоперевозкамОбороты.Грузоперевозка КАК Грузоперевозка,
	               |	СУММА(CW_ДоходыПоГрузоперевозкамОбороты.ВсегоОборот) КАК СуммаРеализации
	               |ПОМЕСТИТЬ ВТ_Доходы
	               |ИЗ
	               |	РегистрНакопления.CW_ДоходыПоГрузоперевозкам.Обороты(
	               |			&НачалоПериода,
	               |			&КонецПериода,
	               |			Период,
	               |			ДокументДоходов.Организация = &Организация
	               |				И ДокументДоходов.ФормируетсяАкт
	               |				И ДокументДоходов.ФормируетсяСчетФактура
	               |				И СтавкаНДС = ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.НДС0)
	               |				И ПорядокОтражения В (&мПорядокОтражения)
	               |				И (ДокументДоходов.ВедомыйДокумент <> ЗНАЧЕНИЕ(Документ.РеализацияТоваровУслуг.ПустаяСсылка)
	               |					ИЛИ ДокументДоходов.ВедомыйДокументКорректировки <> ЗНАЧЕНИЕ(Документ.КорректировкаРеализации.ПустаяСсылка))) КАК CW_ДоходыПоГрузоперевозкамОбороты
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	CW_ДоходыПоГрузоперевозкамОбороты.Грузоперевозка
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	ВТ_Доходы.Грузоперевозка КАК Грузоперевозка,
	               |	ВТ_Доходы.Грузоперевозка.ТипПеревозки КАК ТипПеревозки,
	               |	ЕСТЬNULL(CW_ХарактеристикиГрузоперевозок.Параметр, НЕОПРЕДЕЛЕНО) КАК Параметр,
	               |	ЕСТЬNULL(CW_ХарактеристикиГрузоперевозок.Значение, НЕОПРЕДЕЛЕНО) КАК ЗнаначениеПараметра
	               |ИЗ
	               |	ВТ_Доходы КАК ВТ_Доходы
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.CW_ХарактеристикиГрузоперевозок КАК CW_ХарактеристикиГрузоперевозок
	               |		ПО ВТ_Доходы.Грузоперевозка = CW_ХарактеристикиГрузоперевозок.Грузоперевозка
	               |			И (CW_ХарактеристикиГрузоперевозок.Параметр = &Параметр)";
	
	Запрос.УстановитьПараметр("НачалоПериода", 		ПериодОбработки.ДатаНачала);
	Запрос.УстановитьПараметр("КонецПериода", 		Новый Граница(ПериодОбработки.ДатаОкончания, ВидГраницы.Включая));
	Запрос.УстановитьПараметр("Организация",  		Организация);    
	Запрос.УстановитьПараметр("мПорядокОтражения",  мПорядокОтражения);    
	Запрос.УстановитьПараметр("Параметр",  			МониторинговыйПараметр);    
	
	РезультатлвЗапроса = Запрос.Выполнить();
	
	ТаблицаПеревозок.Очистить();
	
	Выборка = РезультатлвЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = ТаблицаПеревозок.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка); 
	КонецЦикла;
	
	
КонецПроцедуры

