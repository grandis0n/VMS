Процедура ЗавершитьВыборТипПеревозкиЗначения(ЭлементСписка, ДополнительныеПараметры) Экспорт
	
	Если ЭлементСписка = Неопределено Тогда
		Возврат;
	Конецесли;        
	
	Список = Новый СписокЗначений;
	Список.Добавить(ПредопределенноеЗначение("Перечисление.CW_РеестрыНДС0Приложения.ЖД"));
	Список.Добавить(ПредопределенноеЗначение("Перечисление.CW_РеестрыНДС0Приложения.АВТО"));
	Список.Добавить(ПредопределенноеЗначение("Перечисление.CW_РеестрыНДС0Приложения.АВИА"));
	Список.Добавить(ПредопределенноеЗначение("Перечисление.CW_РеестрыНДС0Приложения.МОРЕ"));
	Список.Добавить(ПредопределенноеЗначение("Перечисление.CW_РеестрыНДС0Приложения.ЖДПредоставление"));
	Список.Добавить(ПредопределенноеЗначение("Перечисление.CW_РеестрыНДС0Приложения.АВИАТранзит"));
	Список.Добавить(ПредопределенноеЗначение("Перечисление.CW_РеестрыНДС0Приложения.ЖДТранзит"));
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ТипПеревозки", ЭлементСписка.Значение);
	
	Оповещение = Новый ОписаниеОповещения("ЗавершитьВыборЗначенияДляТипаПеревозки", ЭтотОбъект, ДополнительныеПараметры);
	
	Список.ПоказатьВыборЭлемента(Оповещение);
	
	
КонецПроцедуры   

&наКлиенте
Процедура ЗавершитьВыборЗначенияДляТипаПеревозки(ЭлементСписка, ДополнительныеПараметры) Экспорт
	Если ЭлементСписка = Неопределено Тогда
		Возврат;
	Конецесли; 
	
	УстанвоитьЗначениеДляТипаПеревозкиНаСервере(ЭлементСписка.Значение, ДополнительныеПараметры.ТипПеревозки);
	
КонецПроцедуры

&НаСервере
Процедура УстанвоитьЗначениеДляТипаПеревозкиНаСервере(Приложение, ТипПеревозки) 
	
	Отбор = Новый Структура;
	Отбор.Вставить("ТипПеревозки", ТипПеревозки);
	
	мСтроки = ТаблицаПеревозок.НайтиСтроки(Отбор);
	Для Каждого СтрокаТаблицы из мСтроки Цикл
		СтрокаТаблицы.ЗнаначениеПараметра 	= Приложение;
		СтрокаТаблицы.Флаг 					= Истина;	
	КонецЦикла;    

КонецПроцедуры

&НаСервере
Функция ПолучитьСписокТиповПеревозокДляВыбора()   
	
	СписокЗначений = Новый СписокЗначений;
	
	Для Каждого ЭлементСписка из СписокТиповПеревозок Цикл
		Если ЭлементСписка.Пометка Тогда
			СписокЗначений.Добавить(ЭлементСписка.Значение);	
		КонецЕсли;
	КонецЦикла;  
	
	Возврат СписокЗначений;
	
КонецФункции

 &НаКлиенте
Процедура ЗаписатьПеревозки(Команда)    
	
	Отбор = Новый Структура("Флаг", Истина);
	мСтроки = ТаблицаПеревозок.НайтиСтроки(Отбор);
	НомерСтроки = 1;
	Для Каждого СтрокаТаблицы из мСтроки Цикл    
		ЗаписатьПеревозкиНаСервере(СтрокаТаблицы.Грузоперевозка, СтрокаТаблицы.ЗнаначениеПараметра);    
		
		Прогесс = НомерСтроки / мСтроки.Количество() * 100; 
		
		Состояние(СокрЛП(СтрокаТаблицы.Грузоперевозка), Прогесс, "Запись");
		НомерСтроки = НомерСтроки + 1;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьПеревозкиНаСервере(Грузоперевозка,ЗнаначениеПараметра)
	
	ПеревозкаОбъект = Грузоперевозка.ПолучитьОбъект();
	
	НайденнаяСтрока = ПеревозкаОбъект.ПараметрыГрузоперевозки.Найти(МониторинговыйПараметр, "Параметр"); 
	Если НайденнаяСтрока = Неопределено Тогда
		НайденнаяСтрока = ПеревозкаОбъект.ПараметрыГрузоперевозки.Добавить();  
		НайденнаяСтрока.Параметр = МониторинговыйПараметр;
	КонецЕсли;                                        
	
	НайденнаяСтрока.Значение = ЗнаначениеПараметра;  
	
	ПеревозкаОбъект.ОбменДанными.Загрузка = истина;
	ПеревозкаОбъект.Записать(); 
	
	ЗаписатьМониторинговыеПараметрыВРегистр(Грузоперевозка, ЗнаначениеПараметра)
	
КонецПроцедуры   

Процедура ЗаписатьМониторинговыеПараметрыВРегистр(Грузоперевозка, ЗнаначениеПараметра) Экспорт
	
	ЗаписьРегистра = РегистрыСведений.CW_ХарактеристикиГрузоперевозок.СоздатьМенеджерЗаписи();
	ЗаписьРегистра.Грузоперевозка 	= Грузоперевозка;
	ЗаписьРегистра.Параметр 		= МониторинговыйПараметр;
	ЗаписьРегистра.Прочитать();
	
	ЗаписьРегистра.Грузоперевозка 	= Грузоперевозка;
	ЗаписьРегистра.Параметр 		= МониторинговыйПараметр;
	ЗаписьРегистра.Значение 		= ЗнаначениеПараметра;
	ЗаписьРегистра.Записать(Истина);
	
КонецПроцедуры // ЗаписатьМониторинговыеПараметрыВРегистр()



&НаКлиенте
Процедура МониторинговыйПараметрПриИзменении(Элемент)
	МониторинговыйПараметрПриИзмененииНаСервере();
КонецПроцедуры

&НаСервере
Процедура МониторинговыйПараметрПриИзмененииНаСервере()
	
	Константы.CW_РеестрыНДС0МониторинговыйПараметрПриложения.Установить(МониторинговыйПараметр);
	
КонецПроцедуры