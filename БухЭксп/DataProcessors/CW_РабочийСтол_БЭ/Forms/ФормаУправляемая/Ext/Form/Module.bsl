КонецПроцедуры
  
&НаКлиенте
Процедура КомандаДействие(Команда)
	
	ИмяЭлемента = Этаформа.ТекущийЭлемент.Имя;
	
	Строки = СтрЗаменить(ИмяЭлемента,"__",Символы.ПС);
	МассивСтрок = Новый Массив;
	Для Счетчик = 1 По СтрЧислоСтрок(Строки) Цикл
		
		МассивСтрок.Добавить(СтрПолучитьСтроку(Строки,Счетчик));
		
	КонецЦикла; 
	
	Если МассивСтрок.Количество() = 2 Тогда 
		ТипЭлемента = МассивСтрок[0];
		ЗначениеЭлемента = МассивСтрок[1];
	Иначе 
		Возврат;
	КонецЕсли;
	
	Если ТипЭлемента = "Справочник" Тогда
		
		ОткрытьФорму("Справочник."+ЗначениеЭлемента+".ФормаСписка");
		
	ИначеЕсли ТипЭлемента = "Документ" Тогда 
		
		ОткрытьФорму("Документ."+ЗначениеЭлемента+".ФормаСписка");
		
	ИначеЕсли ТипЭлемента = "ПС" Тогда 
		
		ОткрытьФорму("ПланСчетов."+ЗначениеЭлемента+".ФормаСписка");
		
	ИначеЕсли ТипЭлемента = "ПВХ" Тогда 
		
		ОткрытьФорму("ПланВидовХарактеристик."+ЗначениеЭлемента+".ФормаСписка");
		
	ИначеЕсли (ТипЭлемента = "ОбщаяФорма") Тогда 
		
		ОткрытьФорму("ОбщаяФорма."+ЗначениеЭлемента); 
		
	ИначеЕсли ТипЭлемента = "Обработка" Тогда 
		Если ЗначениеЭлемента = "CW_ЖурналГрузоперевозок" Тогда
			Если CW_Настройки.ПолучитьНастройкуПользователя(,"ОткрыватьЖурналГрузоперевозокВНовомОкне") Тогда
				ОткрытьФорму("Обработка."+ЗначениеЭлемента+".Форма",,,Новый УникальныйИдентификатор);
			Иначе
				ОткрытьФорму("Обработка."+ЗначениеЭлемента+".Форма");
			КонецЕсли;
		ИначеЕсли ЗначениеЭлемента = "CW_ЖурналЗаявок" Тогда
			Если CW_Настройки.ПолучитьНастройкуПользователя(,"ОткрыватьЖурналЗаявокВНовомОкне") Тогда
				ОткрытьФорму("Обработка."+ЗначениеЭлемента+".Форма",,,Новый УникальныйИдентификатор);
			Иначе
				ОткрытьФорму("Обработка."+ЗначениеЭлемента+".Форма");
			КонецЕсли;
		ИначеЕсли ЗначениеЭлемента = "CW_ЖурналЗаказов" Тогда
			Если CW_Настройки.ПолучитьНастройкуПользователя(,"ОткрыватьЖурналЗаказовВНовомОкне") Тогда
				ОткрытьФорму("Обработка."+ЗначениеЭлемента+".Форма",,,Новый УникальныйИдентификатор);
			Иначе
				ОткрытьФорму("Обработка."+ЗначениеЭлемента+".Форма");
			КонецЕсли;
		Иначе
			ОткрытьФорму("Обработка."+ЗначениеЭлемента+".Форма");
		КонецЕсли;
	ИначеЕсли ТипЭлемента = "Отчет" Тогда 
		
		ОткрытьФорму("Отчет."+ЗначениеЭлемента+".ФормаОбъекта",,,Новый УникальныйИдентификатор);
		
	ИначеЕсли ТипЭлемента = "РегистрСведений" Тогда 
		
		ОткрытьФорму("РегистрСведений."+ЗначениеЭлемента+".ФормаСписка");
		
	ИначеЕсли ТипЭлемента = "РегистрБухгалтерии" Тогда 
		
		ОткрытьФорму("РегистрБухгалтерии."+ЗначениеЭлемента+".ФормаСписка");
		
	ИначеЕсли ТипЭлемента = "Прочее" Тогда 
		
		// ручная обработка
		Если ЗначениеЭлемента = "Банк" Тогда
			
			ИмячФормыВыписки = ПолучитьИмяФормыБанковскиеВыписки();
			Если Не ПустаяСтрока(ИмячФормыВыписки) Тогда
				ОткрытьФорму(ИмячФормыВыписки);
			КонецЕсли; 
			
		ИначеЕсли ЗначениеЭлемента = "Параметры" Тогда 
			
			ОткрытьФорму("ОбщаяФорма.CW_Настройки");
			
		ИначеЕсли ЗначениеЭлемента = "НастройкиПользователя" Тогда 
			
			ОткрытьФорму("РегистрСведений.CW_НастройкиПользователей.ФормаЗаписи",_ПараметрыФормыНастроекПользователя());
			
		ИначеЕсли (ЗначениеЭлемента = "Контрагенты") Тогда 
			
			ИспользуетсяCRM = Ложь;
			Если (ИспользуетсяCRM) Тогда
				
				ОткрытьФорму("ОбщаяФорма.CW_ФормаКонтактнойИнформации");
				
			Иначе
				
				ОткрытьФорму("Справочник."+ЗначениеЭлемента+".ФормаСписка");
				
			КонецЕсли;
			
		ИначеЕсли ЗначениеЭлемента = "CW_ФормаВыбораСотрудникаДляРоли" Тогда
			
			СтруктураПараметровФормы = новый Структура;
			СтруктураПараметровФормы.Вставить("ВозможностьСоздаватьЗаписи"	, истина);
			СтруктураПараметровФормы.Вставить("РежимВыбора"	, Ложь);
			
			ОткрытьФорму("ОбщаяФорма.CW_ФормаВыбораСотрудникаДляРоли",СтруктураПараметровФормы);
			
		КонецЕсли; 
		
	КонецЕсли;
	
КонецПроцедуры   

