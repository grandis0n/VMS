&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	СкрытьЭлементыИнформацииОбОбновлениях();  
	
	ЭтоПолноправныйПользователь = CW_ПраваДоступа.ЭтоПолноправныйПользователь(ПараметрыСеанса.ТекущийПользователь,Истина);
	
	РежимОтладкиВключен = CW_Настройки.ПолучитьНастройкуПользователя(,"РежимОтладкиВключен");
	
	CW_БухгалтерияЭкспедитораСервер.ПриСозданииНаСервере(ЭтаФорма, Отказ, СтандартнаяОбработка);

	Элементы.ЗаголовокРабочегоСтола.Видимость = (НЕ ТекущийРежимЗапуска() = РежимЗапускаКлиентскогоПриложения.УправляемоеПриложение);
	
	УстановитьПраваДоступаНаСервере();
	_УправлениеЭлементамиФормы();
	
	ОбновитьСписокВнешнихОтчетовИОбработок();  
	
	ОбязательныеРасширенияУстановлены();
	Если ОбязательныеРасширенияУстановлены Тогда
		УстановитьЗапускРабочегоСтола();           
	КонецЕсли;
	
	ГруппаПользователя 			= CW_ПраваДоступа_ПИ.ГруппаПользователя(ПараметрыСеанса.ТекущийПользователь);
	ЭтоПолноправныйПользователь = CW_ПраваДоступа.ЭтоПолноправныйПользователь(ПараметрыСеанса.ТекущийПользователь, Истина); 
	
	БлокироватьРаботу 			= НЕ ЭтоПолноправныйПользователь и Не ЗначениеЗаполнено(ГруппаПользователя)
									или Не ОбязательныеРасширенияУстановлены;
	
	УстанавилваемыеПараметры = Новый Структура("CW_ГруппаПользователя",ГруппаПользователя); 
	УстановитьПараметрыФункциональныхОпцийФормы(УстанавилваемыеПараметры);
	
	Элементы.ДокументCW_РеестрПлатежейОткрытьСписок.Видимость = ПолучитьФункциональнуюОпцию("CW_РольКазначея", УстанавилваемыеПараметры);
	
	//Подсистема.ЛичныйКабинет    
	Если CW_ВерсииПодсистемСервер.СуществуетПодсистема("CW_БухгалтерияЭкспедитора.CW_ЛичныйКабинетКлиента") Тогда   
		Модуль_CW_ЛичныйКабинетКлиентаСервер = CW_ОбщегоНазначения.ОбщийМодуль("CW_ЛичныйКабинетКлиентаСервер");
		Модуль_CW_ЛичныйКабинетКлиентаСервер.ПриСозданииНаСервере(ЭтаФорма, Отказ, СтандартнаяОбработка);
	КонецЕсли;
	//Подсистема.ЛичныйКабинет   
	
	//Подсистема.CW_РеестрыНДС0 
	Если CW_ВерсииПодсистемСервер.СуществуетПодсистема("CW_БухгалтерияЭкспедитораДляРоссии.CW_РеестрыНДС0") Тогда   
		Модуль_CW_РеестрыНДС0Сервер = CW_ОбщегоНазначения.ОбщийМодуль("CW_РеестрыНДС0Сервер");
		Модуль_CW_РеестрыНДС0Сервер.ПриСозданииНаСервере(ЭтаФорма, Отказ, СтандартнаяОбработка); 
		Модуль_CW_РеестрыНДС0Сервер.УстановитьПараметрСеансаРеестрыНДС0(Не ИспользуетсяСервисРеестрНДС);
	КонецЕсли;
	//Подсистема.CW_РеестрыНДС0   
	
	//Подсистема.CW_ДоходыНерезидентов 
	Если CW_ВерсииПодсистемСервер.СуществуетПодсистема("CW_БухгалтерияЭкспедитораДляРоссии.CW_ДоходыНерезидентов") Тогда   
		Модуль_CW_ДоходыНерезидентовСервер = CW_ОбщегоНазначения.ОбщийМодуль("CW_ДоходыНерезидентовСервер");
		Модуль_CW_ДоходыНерезидентовСервер.ПриСозданииНаСервере(ЭтаФорма, Отказ, СтандартнаяОбработка); 
	КонецЕсли;
	//Подсистема.CW_ДоходыНерезидентов    
	
	ЭтаФорма.Заголовок = ПолучитьЗаголовокФормыНаСервере();

	//Подсистема ДополнительныеРеквизиты    
	CW_ДополнительныеРеквизитыСлужебный.УстановитьПрименениеДополнительныхРеквизитов();  
	//Конец Подсистема ДополнительныеРеквизиты   
	
	// по заявке  AFR-233641
	Элементы.Группа13.Доступность = РольДоступна("ПолныеПрава");
	Элементы.Группа11.Доступность = РольДоступна("ПолныеПрава");
	// по заявке  AFR-233641   
	
КонецПроцедуры

&НаСервере
Процедура ОбязательныеРасширенияУстановлены()
	
	ОбязательныеРасширенияУстановлены = Справочники.CW_ОбязательныеРасширения.ОбязательныеРасширенияУстановлены();

КонецПроцедуры

&НаСервере
Процедура УстановитьЗапускРабочегоСтола()
	
	Попытка
		НовыйСеанс = НЕ ПараметрыСеанса.CW_РабочийСтолЗапущен;
	Исключение
		НовыйСеанс = Истина;
	КонецПопытки;  
	
	ПараметрыСеанса.CW_РабочийСтолЗапущен = Истина;

КонецПроцедуры

&НаСервере
Процедура СкрытьЭлементыИнформацииОбОбновлениях()
	
	Элементы.ГруппаНаличиеОбновлений.Видимость  = Ложь;
	Элементы.ГруппаИсправления.Видимость 		= Ложь;
	Элементы.ГруппаДополнения.Видимость 		= Ложь;
	Элементы.ГруппаОбновить.Видимость 			= Ложь;

КонецПроцедуры 

&НаКлиенте
Процедура ПриОткрытии(Отказ) 
	
	//Первый запуск программы
	Если ЭтоПервыйЗапуск Тогда 
		Отказ = Истина;
		ОткрытьФорму("ОбщаяФорма.CW_ПервыйЗапуск"); 
		ЭтаФорма.Закрыть();
		//Первый запуск программы 
	КонецЕсли;       
	
	Если ТребуетсяОбновление Тогда
		Элементы.ДекорацияНачальная.Заголовок = "Обновление конфигурации...";
		CW_ОбновлениеКонфигурацииКлиент.ВыполнитьОбновлениеКонфигурации(Этаформа);	
	Иначе  
		
		Если Не ОбязательныеРасширенияУстановлены Тогда
			Отказ = истина;
			
			Если БлокироватьРаботу и Не ЭтоПолноправныйПользователь Тогда
				Элементы.ДекорацияНачальная.Заголовок = "";
				Оповещение = Новый ОписаниеОповещения("ПослеПредупрежденияОбУстанвокеРасширенийПриСтарте", ЭтотОбъект);
				ПоказатьПредупреждение(Оповещение, "Не установлены обязательные расширения. Обратитесь к администратору системы.");
			Иначе
				Элементы.ДекорацияНачальная.Заголовок = "Установка обязательных расширений...";      
				Оповещение = Новый ОписаниеОповещения("ПослеУстановкиОбязательныхРасширенийПриСтарте", ЭтотОбъект);
				ОткрытьФорму("ОбщаяФорма.CW_ФормаПроверкиИсправлений",,,,,,Оповещение,РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс); 
			КонецЕсли;   
			
		Иначе
			ПродолжитьОткрытиеФормы(Неопределено, Неопределено);  
			Элементы.СтраницыОсновногоРаздела.ТекущаяСтраница = Элементы.СтраницаРабочийСтол; 
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры   

&Наклиенте
Процедура ПослеПредупрежденияОбУстанвокеРасширенийПриСтарте(ДополнительныеПараметры) Экспорт
	
	ВключитьНачальнуюСтраницуБухгалтерияПредприятия();
	ПерезапуститьСистему();
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеУстановкиОбязательныхРасширенийПриСтарте(Результат, ДополнительныеПараметры) Экспорт
	
	ОбязательныеРасширенияУстановлены();
	Если Не ОбязательныеРасширенияУстановлены Тогда
		ВключитьНачальнуюСтраницуБухгалтерияПредприятия();
	КонецЕсли;
	
	ПерезапуститьСистему();
	
КонецПроцедуры

&НаКлиенте
Процедура ПерезапуститьСистему()
	
	// По завершении сеанса необходимо начать новый сеанс
	глНеобходимостьПерезапуска = Истина;
	
	// Попробуем перезапустить
	ЗавершитьРаботуСистемы(Истина,Истина);

КонецПроцедуры

&НаСервере
Процедура ВключитьНачальнуюСтраницуБухгалтерияПредприятия()   
	
	CW_БухгалтерияЭкспедитораСервер.ВключитьНачальнуюСтраницуБухгалтерияПредприятия(); 
	
КонецПроцедуры

&НаКлиенте
Процедура ПередНачаломПроверкиОбновлений()
	
	НачатьПроверкуОбновлений();
	
КонецПроцедуры

&НаКлиенте
Процедура НачатьПроверкуОбновлений(ВыводитьОкноОжидания=Ложь, ЗапуститьВФоне=Истина)

	РезультатВыполнения =  ПродолжитьПроверкуОбновленийНаСервереВФоне(ЗапуститьВФоне);
	
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ВыводитьОкноОжидания = ВыводитьОкноОжидания; 
	
	ОповещениеОЗавершении = Новый ОписаниеОповещения("ОбработатьРезультатВыполненияПроверкиОбновлений", ЭтотОбъект); 
	ДлительныеОперацииКлиент.ОжидатьЗавершение(РезультатВыполнения, ОповещениеОЗавершении, ПараметрыОжидания); 	
	
КонецПроцедуры
 
&НаКлиенте
Процедура ЗавешитьРасширенныеНастройкиМодуля(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Истина Тогда      
		Отказ = ложь;
	Иначе    
		ЭтаФорма.Закрыть();
		УбратьРабочийСтолИзНачальнойНастройки();
		ОбновитьИнтерфейс();
	КонецЕсли;    
	
КонецПроцедуры  

&НаКлиенте
Процедура ПродолжитьОткрытиеФормы(Результат, ДополнительныеПараметры) Экспорт
	
	Если БлокироватьРаботу Тогда
		УбратьРабочийСтолИзНачальнойНастройки();
		ОбновитьИнтерфейс();
		
		Отказ = истина;
		ПоказатьПредупреждение(, "Текущая учетная запись не включена ни в одну группу пользователей. 
		|Работа с программой не возможна. Обратитесь к администратору системы.");
		
		Возврат;
	КонецЕсли;   
	
	CW_БухгалтерияЭкспедитораКлиент.ПриОткрытии(ЭтаФорма, Отказ);
	
	//Подсистема.ОбновлениеКонфигурации
	Если ВыполнитьПроверкуНаличияОбновлений Тогда  
		ПередНачаломПроверкиОбновлений();
		ПодключитьОбработчикОжидания("ПередНачаломПроверкиОбновлений", 3600);
	КонецЕсли; 
	//Подсистема.ОбновлениеКонфигурации

	Если НовыйСеанс Тогда
	
		//Подсистема.СогласованиеОбъктов
		CW_СогласованиеКлиент.ПодключитьОбработчикиОжиданияСогласования();
		//Подсистема.СогласованиеОбъктов
		
		Если Не СоответствуетТиповойБухгалтерии И НЕ РежимОтладкиВключен Тогда
			ТекстПредупреждения = "Версия конфигурации ""1С:Бухгалтерия предприятия 8"" (" + ТекущаяВерсияБП + ") не соответствует рекомендуемой (" + РекомендуемаяВерсияБП + "). Для корректной работы модуля ""Бухгалтерия экспедитора 8"" обновите версию конфигурации ""1С:Бухгалтерия предприятия 8"" до рекомендованной.";
			ПоказатьПредупреждение(, ТекстПредупреждения);
		КонецЕсли; 
		
		//Подсистема.ЛичныйКабинет
		Если Не ИспользуетсяЛичныйКабинет Тогда
			ПодключитьОбработчикОжидания("ЗапуститьРекламныйБаннерЛКК", 1, Истина);
		КонецЕсли;
		//Подсистема.ЛичныйКабинет
		
		//Подсистема.CW_РеестрыНДС0
		Если CW_ВерсииПодсистемСервер.СуществуетПодсистема("CW_БухгалтерияЭкспедитораДляРоссии.CW_РеестрыНДС0") Тогда   
			Если Не ИспользуетсяСервисРеестрНДС Тогда
				ПодключитьОбработчикОжидания("ЗапуститьРекламныйБаннерРеестрыНДС0", 1, Истина);
			КонецЕсли;  
		КонецЕсли;  
		//Подсистема.CW_РеестрыНДС0

		//Подсистема.CW_ДоходыНерезидентов
		Если CW_ВерсииПодсистемСервер.СуществуетПодсистема("CW_БухгалтерияЭкспедитораДляРоссии.CW_ДоходыНерезидентов") Тогда  
			Если Не ИспользуетсяСервисДоходыНерезидентов Тогда
				ПодключитьОбработчикОжидания("ЗапуститьРекламныйБаннерДоходыНерезидентов", 1, Истина);
			КонецЕсли;  
		КонецЕсли;  
		//Подсистема.CW_ДоходыНерезидентов  
		
	КонецЕсли;
	
КонецПроцедуры  

 &НаСервере
Процедура УбратьРабочийСтолИзНачальнойНастройки() 
	
	CW_БухгалтерияЭкспедитораСервер.ОтключитьРабочийСтолБухгалтерияЭкспедитора();
	
КонецПроцедуры 

 &НаСервере
Процедура ВключитьРабочийСтолВНачальныеНастройки() 
	
	CW_БухгалтерияЭкспедитораСервер.ВключитьРабочийСтолБухгалтерияЭкспедитора();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьПраваДоступаНаСервере()       
	
	ПросмотрФинансов 			= ЭтоПолноправныйПользователь или CW_ПраваДоступа.ПравоДоступно("ПросмотрФинансов");
	ПросмотрРасходов 			= ЭтоПолноправныйПользователь или CW_ПраваДоступа.ПравоДоступно("ПросмотрФинансов_Расходы");
	ПросмотрДоходов 			= ЭтоПолноправныйПользователь или CW_ПраваДоступа.ПравоДоступно("ПросмотрФинансов_Доходы");
	АнализЭкономики 			= ЭтоПолноправныйПользователь или CW_ПраваДоступа.ПравоДоступно("АнализЭкономикиГрузоперевозок");
	ПросмотрОплатБУ 			= ЭтоПолноправныйПользователь или CW_ПраваДоступа.ПравоДоступно("ПросмотрФинансов_Оплаты");
	ПросмотрОплатОУ 			= ЭтоПолноправныйПользователь или CW_ПраваДоступа.ПравоДоступно("ПросмотрФинансов_ОперативныйУчет");
	УправлениеОбменамиДанных 	= ЭтоПолноправныйПользователь или CW_ПраваДоступа.ПравоДоступно("УправлениеОбменамиДанных");
	РедактированиеВозвратаОригиналовОтПоставщика = ЭтоПолноправныйПользователь или CW_ПраваДоступа.ПравоДоступно("РедактированиеВозвратаОригиналовОтПоставщика");
	РедактированиеВозвратаОригиналовОтКлиента = ЭтоПолноправныйПользователь или CW_ПраваДоступа.ПравоДоступно("РедактированиеВозвратаОригиналовОтКлиента"); 
	
	Элементы.СтраницаДокументы.Видимость = ЭтоПолноправныйПользователь или ПросмотрФинансов;
	Элементы.СтраницаОтчеты.Видимость = ЭтоПолноправныйПользователь или ПросмотрФинансов;

	Элементы.Документ__CW_РасходыПоГрузоперевозке.Видимость = ПросмотрРасходов;
	Элементы.Документ__CW_ДоходыПоГрузоперевозке.Видимость = ПросмотрДоходов;
	Элементы.Документ__CW_ЗакрытиеГрузоперевозки.Видимость = (ПросмотрРасходов И ПросмотрДоходов И ПолучитьФункциональнуюОпцию("CW_ИспользованиеСхемыПеревыставленияПоСтавкам"));
	Элементы.Документ__CW_КорректировкаПеревыставления.Видимость = (ПросмотрРасходов И ПросмотрДоходов);

	Элементы.ГруппаПлатежноРасчетныеДокументыОУ.Видимость = ПросмотрОплатОУ;
	Элементы.ГруппаДенежныеСредства.Видимость = ПросмотрОплатОУ;
	Элементы.Справочник__CW_Кассы.Видимость = ПросмотрОплатОУ;
	
	Элементы.ГруппанпПеревыставляемыеЗатраты.Видимость = (ПросмотрРасходов И ПросмотрДоходов);
	Элементы.ГруппанпПеревыставлениеПоСтавкам.Видимость = (ПросмотрРасходов И ПросмотрДоходов) И ПолучитьФункциональнуюОпцию("CW_ИспользованиеСхемыПеревыставленияПоСтавкам");
	Элементы.ГруппанпФинансовыйРезультатИВознаграждение.Видимость = (ПросмотрРасходов И ПросмотрДоходов);
	Элементы.Отчет__CW_АнализПрибылиПоГрузоперевозкам.Видимость = АнализЭкономики;  
	
	// группа "Бухгалтерская задолженность"
	Элементы.Отчет__CW_ВедомостьВзаиморасчетовСПоставщиками.Видимость = ПросмотрРасходов и ПросмотрОплатБУ;
	Элементы.Отчет__CW_ВедомостьВзаиморасчетовСПокупателями.Видимость = ПросмотрДоходов и ПросмотрОплатБУ;
	Элементы.Отчет__CW_ОтсутствующиеОригиналыДокументов.Видимость = (ПросмотрРасходов и РедактированиеВозвратаОригиналовОтПоставщика)  ИЛИ (ПросмотрДоходов и РедактированиеВозвратаОригиналовОтКлиента);
	Элементы.Отчет__CW_АктСверкиВзаиморасчетов.Видимость = (ПросмотрРасходов и ПросмотрДоходов и РедактированиеВозвратаОригиналовОтКлиента); 
	
	Элементы.ГруппаОперативныйУчетСПоставщиками.Видимость = (ПросмотрРасходов И ПросмотрОплатОУ);
	Элементы.ГруппаОперативныйУчетСПокупателями.Видимость = (ПросмотрДоходов И ПросмотрОплатОУ);
	
	Элементы.Справочник__CW_ФинансовыеСтатусы.Видимость = ПолучитьФункциональнуюОпцию("CW_ИспользоватьФинансовыеСтатусыГрузоперевозок");
