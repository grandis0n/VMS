	// Автоблок
	ИспользованиеБлокаСобственногоТранспорта 	= ПолучитьФункциональнуюОпцию("CW_ИспользованиеБлокаСобственногоТранспорта");
	ПрименяютсяНормативыРасходаТоплива 			= ПолучитьФункциональнуюОпцию("CW_ПрименяютсяНормативыРасходаТоплива");
	ВедетсяУчетШинТранспортногоСредства 		= ПолучитьФункциональнуюОпцию("CW_ВедетсяУчетШинТранспортногоСредства");
	РазрешитьПолучениеКоличестваУслугИзпараметраГрузоперевозки = ПолучитьФункциональнуюОпцию("CW_РазрешитьПолучениеКоличестваУслугИзпараметраГрузоперевозки");     
	ДоступенБлокАвтотранспорт 					= CW_ПраваДоступа.ПравоДоступно("ДоступенБлокАвтотранспорт");
	РедактированиеСтатусовДокументов 			= CW_ПраваДоступа.ПравоДоступно("РедактированиеСтатусовДокументов");
	
	Элементы.ГруппаТранспортныеСредства.Видимость 					= ИспользованиеБлокаСобственногоТранспорта и ДоступенБлокАвтотранспорт; 
	Элементы.СтраницаСобственныйАвтотранспорт.Видимость 			= ИспользованиеБлокаСобственногоТранспорта и ДоступенБлокАвтотранспорт;
	Элементы.ГруппаАвтотранспортНормативныйРасчетТоплива.Видимость	= ПрименяютсяНормативыРасходаТоплива;
	Элементы.Документ__CW_ШиномонтажТС.Видимость 					= ВедетсяУчетШинТранспортногоСредства;

	ВалютаРегламентированногоУчетаРубль = ПолучитьФункциональнуюОпцию("CW_ВалютаРегламентированногоУчетаРубль");
	
	//ФИНАНСЫ
	Элементы.ПС__Хозрасчетный.Видимость  													= ВалютаРегламентированногоУчетаРубль;
	Элементы.РегистрСведений__CW_СоответствиеНоменклатурныхГруппСпособамУчетаНДС.Видимость 	= ВалютаРегламентированногоУчетаРубль;
	Элементы.Документ__УстановкаЦенНоменклатуры.Видимость 									= ВалютаРегламентированногоУчетаРубль;
	Элементы.Справочник__Валюты.Видимость  													= ВалютаРегламентированногоУчетаРубль;
	Элементы.РегистрСведений__CW_НастройкаПолученияКоличестваИзПараметровГрузоперевозки.Видимость = РазрешитьПолучениеКоличестваУслугИзпараметраГрузоперевозки;
	Элементы.СправочникCW_СтатусыДокументовОткрытьСписок.Видимость 							= РедактированиеСтатусовДокументов;
	
	//Документы
	Элементы.ГруппаПлатежноРасчетныеДокументыБУ.Видимость			= ВалютаРегламентированногоУчетаРубль и ПросмотрОплатБУ;
	Элементы.Документ__CW_КорректировкаАктированияСчетов.Видимость	= ВалютаРегламентированногоУчетаРубль;
	
	//Отчеты
	Элементы.Отчет__CW_КонтрольПеревыставленияПоСтавкам.Видимость		= ВалютаРегламентированногоУчетаРубль;
	Элементы.Отчет__CW_КонтрольПеревыставленияЗатрат.Видимость			= ВалютаРегламентированногоУчетаРубль;
	Элементы.Отчет__CW_ВознаграждениеПоГрузоперевозкам.Видимость		= ВалютаРегламентированногоУчетаРубль;
	Элементы.Отчет__CW_ОтчетАгента.Видимость							= ВалютаРегламентированногоУчетаРубль;
	Элементы.Отчет__CW_НеАктированыеИсходящиеСчета.Видимость			= ВалютаРегламентированногоУчетаРубль;
	Элементы.Отчет__CW_НеАктированыеВходящиеСчета.Видимость				= ВалютаРегламентированногоУчетаРубль;
	Элементы.Отчет__CW_ВедомостьАктированияИсходящихСчетов.Видимость	= ВалютаРегламентированногоУчетаРубль;
	Элементы.Отчет__CW_ВедомостьАктированияВходящихСчетов.Видимость		= ВалютаРегламентированногоУчетаРубль;
	Элементы.ГруппаКонтрольЗадолженности.Видимость					    = ВалютаРегламентированногоУчетаРубль;
	
	ДоступныеТипыПоОпциямЛогистическиеСтатусы = CW_ЛогистическиеСтатусыСервер.ПолучитьДоступныеТипыПоОпциям();
	Элементы.СправочникCW_ЛогистическиеСтатусыОткрытьСписок.Видимость = ДоступныеТипыПоОпциямЛогистическиеСтатусы.Количество() > 0;
	
	ДоступныеТипыПоОпциямФинансовыеСтатусы = CW_ФинансовыеСтатусыСервер.ПолучитьДоступныеТипыПоОпциям();
