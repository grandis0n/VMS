&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "ОбновитьДанныеРабочегоСтола" Тогда
		
		_УправлениеЭлементамиФормы();
		УстановитьПраваДоступаНаСервере();
		ОбновитьСписокВнешнихОтчетовИОбработок();
		
	ИначеЕсли ИмяСобытия = "ОбновлениеКонфигурации_Успешно" Тогда   
		
		ТребуетсяОбновление = Ложь;
		ЭтаФорма.Заголовок = ПолучитьЗаголовокФормыНаСервере();	 
		Элементы.СтраницыОсновногоРаздела.ТекущаяСтраница = Элементы.СтраницаРабочийСтол;
		
	ИначеЕсли ИмяСобытия = "CW_НастройкиПользователей_Запись" Тогда
		
		//Мы нее знаем что конкретно записали, обновить информаицю об обновлениях
		ВыполнитьПроверкуНаличияОбновлений 	= CW_ОбновлениеКонфигурацииСервер.ВыполнитьПроверкуНаличияОбновлений(); 
		Если ВыполнитьПроверкуНаличияОбновлений Тогда
			НачатьПроверкуОбновлений(Ложь);	             
		Иначе
			СкрытьЭлементыИнформацииОбОбновлениях();
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры


#Область Динамическое_обновление_элементов_рабочего_стола

&НаСервере
Процедура ОбновитьСписокВнешнихОтчетовИОбработок()
	
	ГруппаПользователя 			= CW_ПраваДоступа_ПИ.ГруппаПользователя(ПараметрыСеанса.ТекущийПользователь);
	
	Запрос = новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	CW_ПодключаемыеОбъекты.Ссылка КАК Ссылка
	               |ПОМЕСТИТЬ ВТ_ВсеЭлементы
	               |ИЗ
	               |	Справочник.CW_ПодключаемыеОбъекты КАК CW_ПодключаемыеОбъекты
	               |ГДЕ
	               |	НЕ CW_ПодключаемыеОбъекты.ПометкаУдаления
	               |	И НЕ CW_ПодключаемыеОбъекты.НеИспользуется
	               |	И CW_ПодключаемыеОбъекты.РасполагатьНаРабочемСтоле
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	CW_ПодключаемыеОбъектыДоступностьОбъекта.Ссылка КАК Ссылка
	               |ПОМЕСТИТЬ ВТ_Доступные
	               |ИЗ
	               |	Справочник.CW_ПодключаемыеОбъекты.ДоступностьОбъекта КАК CW_ПодключаемыеОбъектыДоступностьОбъекта
	               |ГДЕ
	               |	CW_ПодключаемыеОбъектыДоступностьОбъекта.ГруппаПользователей = &ГруппаПользователеля
	               |	И НЕ CW_ПодключаемыеОбъектыДоступностьОбъекта.Ссылка.НеИспользуется
	               |	И НЕ CW_ПодключаемыеОбъектыДоступностьОбъекта.Ссылка.ПометкаУдаления
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ_ВсеЭлементы.Ссылка КАК Ссылка,
	               |	ВЫБОР
	               |		КОГДА &ЭтоПолноправныйПользователь
	               |			ТОГДА ИСТИНА
	               |		ИНАЧЕ ВЫБОР
	               |				КОГДА ВТ_Доступные.Ссылка ЕСТЬ NULL
	               |					ТОГДА ЛОЖЬ
	               |				ИНАЧЕ ИСТИНА
	               |			КОНЕЦ
	               |	КОНЕЦ КАК Доступен
	               |ИЗ
	               |	ВТ_ВсеЭлементы КАК ВТ_ВсеЭлементы
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Доступные КАК ВТ_Доступные
	               |		ПО ВТ_ВсеЭлементы.Ссылка = ВТ_Доступные.Ссылка";
	
	Запрос.УстановитьПараметр("ГруппаПользователеля"		, ГруппаПользователя);	
	Запрос.УстановитьПараметр("ЭтоПолноправныйПользователь"	, ЭтоПолноправныйПользователь);	

	РезультатЗапроса = Запрос.Выполнить();
	
	мОбъектыУдалить 	= Новый Массив;
	мОбъектыДобавить 	= Новый Массив;
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Если Выборка.Доступен Тогда
			мОбъектыДобавить.Добавить(Выборка.Ссылка);	
		КонецЕсли;
		
		мОбъектыУдалить.Добавить(Выборка.Ссылка);	
		
	КонецЦикла;
	
	//Удаление команд
	Запрос = Новый запрос;
	запрос.Текст = "ВЫБРАТЬ
	               |	CW_ПодключаемыеОбъектыКомандыОбъекта.Ссылка КАК Ссылка,
	               |	CW_ПодключаемыеОбъектыКомандыОбъекта.ИмяКоманды КАК ИмяКоманды,
	               |	CW_ПодключаемыеОбъектыРасположениеОбъекта.Расположение КАК Расположение
	               |ИЗ
	               |	Справочник.CW_ПодключаемыеОбъекты.КомандыОбъекта КАК CW_ПодключаемыеОбъектыКомандыОбъекта
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.CW_ПодключаемыеОбъекты.РасположениеОбъекта КАК CW_ПодключаемыеОбъектыРасположениеОбъекта
	               |		ПО CW_ПодключаемыеОбъектыКомандыОбъекта.Ссылка = CW_ПодключаемыеОбъектыРасположениеОбъекта.Ссылка
	               |ГДЕ
	               |	CW_ПодключаемыеОбъектыКомандыОбъекта.Ссылка.РасполагатьНаРабочемСтоле = ИСТИНА";
	
	Запрос.УстановитьПараметр("мОбъектыУдалить", мОбъектыУдалить);	
	
	Выборка_Удалить = Запрос.Выполнить().Выбрать();
	Пока Выборка_Удалить.Следующий() Цикл
		ИмяКоманды = ПолучитьИмяКомандыВнешнего(Выборка_Удалить.Ссылка.УникальныйИдентификатор(),Выборка_Удалить.Расположение, Выборка_Удалить.ИмяКоманды);
		ОбработатьУдалениеЭлемента(ИмяКоманды);
	КонецЦикла;
	
	//Добавление команд
	Запрос = новый Запрос;
	запрос.Текст = "ВЫБРАТЬ
	               |	CW_ПодключаемыеОбъектыКомандыОбъекта.Ссылка КАК Ссылка,
	               |	CW_ПодключаемыеОбъектыРасположениеОбъекта.Расположение КАК Расположение,
	               |	CW_ПодключаемыеОбъектыКомандыОбъекта.ИмяКоманды КАК ИмяКоманды,
	               |	CW_ПодключаемыеОбъектыКомандыОбъекта.ПредставлениеКоманды КАК ПредставлениеКоманды,
	               |	CW_ПодключаемыеОбъектыКомандыОбъекта.ИмяКартинки КАК ИмяКартинки
	               |ПОМЕСТИТЬ ВТ_ДобавляемыеОбъекты
	               |ИЗ
	               |	Справочник.CW_ПодключаемыеОбъекты.КомандыОбъекта КАК CW_ПодключаемыеОбъектыКомандыОбъекта
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.CW_ПодключаемыеОбъекты.РасположениеОбъекта КАК CW_ПодключаемыеОбъектыРасположениеОбъекта
	               |		ПО CW_ПодключаемыеОбъектыКомандыОбъекта.Ссылка = CW_ПодключаемыеОбъектыРасположениеОбъекта.Ссылка
	               |ГДЕ
	               |	CW_ПодключаемыеОбъектыКомандыОбъекта.Ссылка В(&мОбъектыДобавить)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	CW_РазделыРабочегоСтола.Ссылка КАК ГруппаФормы
	               |ИЗ
	               |	Справочник.CW_РазделыРабочегоСтола КАК CW_РазделыРабочегоСтола
	               |ГДЕ
	               |	CW_РазделыРабочегоСтола.Ссылка В
	               |			(ВЫБРАТЬ
	               |				ВТ_ДобавляемыеОбъекты.Расположение КАК Расположение
	               |			ИЗ
	               |				ВТ_ДобавляемыеОбъекты КАК ВТ_ДобавляемыеОбъекты)
	               |ИТОГИ ПО
	               |	ГруппаФормы ТОЛЬКО ИЕРАРХИЯ
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ_ДобавляемыеОбъекты.Ссылка КАК ПодключаемыйОбъект,
	               |	ВТ_ДобавляемыеОбъекты.Ссылка.Индекс КАК Индекс,
	               |	ВТ_ДобавляемыеОбъекты.ИмяКартинки КАК ИмяКартинки,
	               |	ВТ_ДобавляемыеОбъекты.ИмяКоманды КАК ИмяКоманды,
	               |	ВТ_ДобавляемыеОбъекты.ПредставлениеКоманды КАК ПредставлениеКоманды,
	               |	ВТ_ДобавляемыеОбъекты.Расположение КАК Расположение
	               |ИЗ
	               |	ВТ_ДобавляемыеОбъекты КАК ВТ_ДобавляемыеОбъекты
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Расположение,
	               |	Индекс";
	
	Запрос.УстановитьПараметр("мОбъектыДобавить", мОбъектыДобавить);	
	
	ПакетРезультатов = Запрос.ВыполнитьПакет();
	
	//Сначала обработаем иерархию
	ДеревоГрупп = ПакетРезультатов[1].Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	ДобавитьГруппыНаФорму(ДеревоГрупп);
	
	ВыборкаКоманды =  ПакетРезультатов[2].Выбрать();
	
	Пока ВыборкаКоманды.Следующий() Цикл
		
		ИмяКоманды 	= ПолучитьИмяКомандыВнешнего(ВыборкаКоманды.ПодключаемыйОбъект.УникальныйИдентификатор(), ВыборкаКоманды.Расположение ,  ВыборкаКоманды.ИмяКоманды);
		
		ИмяКартинки = ВыборкаКоманды.ИмяКартинки;

		Если ЗначениеЗаполнено(ИмяКартинки) Тогда
			КартинкаКоманды = БиблиотекаКартинок[ИмяКартинки];
		Иначе
			КартинкаКоманды = БиблиотекаКартинок.Отчет;
		КонецЕсли;  
		
		ПараметрыКнопки = новый Структура;
		ПараметрыКнопки.Вставить("Имя"			, ИмяКоманды);
		ПараметрыКнопки.Вставить("ИмяКоманды"	, "ОбработатьВызовПодключаемогоОбъекта");
		ПараметрыКнопки.Вставить("Заголовок"	, ВыборкаКоманды.ПредставлениеКоманды);
		ПараметрыКнопки.Вставить("Картинка"		, КартинкаКоманды);
		
		ДобавитьКнопкуНаФорму(ПараметрыКнопки, ВыборкаКоманды.Расположение);
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьИмяКомандыВнешнего(УИДОбъекта, Расположение, ИмяКоманды)
	
	стрУИД = СтрЗаменить(УИДОбъекта,"-","_");
	Возврат	ИмяКоманды+"_"+Формат(Расположение.Код,"ЧГ=0")+"_УИД_"+стрУИД;  
	
КонецФункции

&НаСервере
Процедура ДобавитьГруппыНаФорму(СтрокиДерева)
	
	Для Каждого СтрокаДерева из СтрокиДерева.Строки Цикл
		
		Если СтрокаДерева.ГруппаФормы.Предопределенный Тогда
			//предопределенные группы уже есть
			ДобавитьГруппыНаФорму(СтрокаДерева);
		Иначе
			
			Если СтрокаДерева.Родитель.ГруппаФормы.Предопределенный Тогда
				ИмяЭлементаГруппы = СтрокаДерева.Родитель.ГруппаФормы.ИмяПредопределенныхДанных;
			Иначе
				ИмяЭлементаГруппы = ПолучитьИмяЭлемента(СтрокаДерева.Родитель.ГруппаФормы); 
			КонецЕсли;
			
			ГруппаРодитель = Элементы.Найти(ИмяЭлементаГруппы);
			
			Если ГруппаРодитель <> Неопределено Тогда
				
				ИмяГруппы =  ПолучитьИмяЭлемента(СтрокаДерева.ГруппаФормы);
				
				Если Элементы.Найти(ИмяГруппы) = Неопределено Тогда
					
					//Добавлеем элемент на форму
					ЭлементГруппа = Элементы.Добавить(ИмяГруппы, Тип("ГруппаФормы"), ГруппаРодитель);
					ЭлементГруппа.Вид 					= ВидГруппыФормы.ОбычнаяГруппа;
					ЭлементГруппа.Отображение 			= ОтображениеОбычнойГруппы.ОбычноеВыделение;
					ЭлементГруппа.Заголовок 			= " "+СтрокаДерева.ГруппаФормы.Наименование;
					ЭлементГруппа.ОтображатьЗаголовок 	= истина;
					ЭлементГруппа.Группировка 			= ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
					ЭлементГруппа.ШрифтЗаголовка		= Новый Шрифт(ЭлементГруппа.ШрифтЗаголовка,,,Истина); 
					
				КонецЕсли;
			
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	
КонецПроцедуры

&наСервере
Процедура ОбработатьУдалениеЭлемента(ИмяКоманды)
	
	ЭлементФормы = Элементы.Найти(ИмяКоманды);
	
	Если ЭлементФормы <> Неопределено Тогда
		Элементы.Удалить(ЭлементФормы);
	КонецЕсли;
	
	КомандаФормы = Команды.Найти(ИмяКоманды);
	Если КомандаФормы <> Неопределено Тогда
		Команды.Удалить(КомандаФормы);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьКнопкуНаФорму(ПараметрыКнопки, Расположение)
	
	Если Расположение.Предопределенный Тогда
		ИмяЭлементаГруппы =  Расположение.ИмяПредопределенныхДанных;
	Иначе
		ИмяЭлементаГруппы =  ПолучитьИмяЭлемента(Расположение);
	КонецЕсли;
		
	РасположениеКоманды = Элементы.Найти(ИмяЭлементаГруппы);
	
	//Ссмылки на форме
	НайденныйЭлемент =  Элементы.Найти(ПараметрыКнопки.Имя);
	
	Если НайденныйЭлемент <> Неопределено Тогда
		Элементы.Удалить(НайденныйЭлемент);
	КонецЕсли;
	
	// создадим кнопку
	НовыйЭлемент        = Элементы.Добавить(ПараметрыКнопки.Имя 	,  	// Первый параметр - имя кнопки
											Тип("КнопкаФормы")		,  	// Второй параметр - тип элемента управления
											РасположениеКоманды)	;	// Третий параметр - место расположения на форме
	
	НовыйЭлемент.Вид    		= ВидКнопкиФормы.Гиперссылка; // вид кнопки
	НовыйЭлемент.Заголовок  	= ПараметрыКнопки.Заголовок;
	НовыйЭлемент.ИмяКоманды 	= ПараметрыКнопки.ИмяКоманды;
	НовыйЭлемент.Картинка 		= ПараметрыКнопки.Картинка;
	
	
КонецПроцедуры

&НаСервере
Функция ПолучитьИмяЭлемента(РазмещениеСсылка)
	
	Возврат "Группа_"+СтрЗаменить(СокрЛП(РазмещениеСсылка.УникальныйИдентификатор()),"-","_");
	
КонецФункции

&НаСервере
Функция ПолучитьДаныеОбъекта(стр_УИД_Элемента)
	
	стр_УИД = СтрЗаменить(стр_УИД_Элемента,"_","-");
	
	ПодключаемыйОбъект = Справочники.CW_ПодключаемыеОбъекты.ПолучитьСсылку(Новый УникальныйИдентификатор(стр_УИД));
	
	Если ПодключаемыйОбъект.Пустая() Тогда
		//Странно
		Возврат Неопределено;
	Конецесли;
	
	СтруктураДанныхОбъекта = Новый Структура("ПодключаемыйОбъект,Метод,ИмяФормы",ПодключаемыйОбъект,"","");
	
	//Методы
	мМетодыОбъекта = ПодключаемыйОбъект.МетодыОбъекта.ВыгрузитьКолонку("Метод");
	
	Если мМетодыОбъекта.Найти("ОткрытьФорму") <> Неопределено Тогда
		СтруктураДанныхОбъекта.Метод = "ОткрытьФорму";
	ИначеЕсли мМетодыОбъекта.Найти("ВыполнитьКлиентскийМетод") <> Неопределено Тогда
		СтруктураДанныхОбъекта.Метод = "ВыполнитьКлиентскийМетод";
	Иначе
		//Неизвестный метод формы
		Возврат Неопределено;
	Конецесли;
	
	_ПО.ПодключитьОбработку(ПодключаемыйОбъект);
	СтруктураДанныхОбъекта.ИмяФормы = _ПО.ПолучитьПолноеИмяФормыПоТипу(ПодключаемыйОбъект,"ФормаОбъекта");
	
	Возврат СтруктураДанныхОбъекта;
	
КонецФункции

&НаКлиенте
Процедура ОбработатьВызовПодключаемогоОбъекта(Команда) 
	
	ИмяЭлемента = Этаформа.ТекущийЭлемент.Имя;
	
	СтрокаИмениКоманды = СтрЗаменить(ИмяЭлемента,"_УИД_",";");
	
	МассивСтрок = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(СтрокаИмениКоманды,";");
	
	Если МассивСтрок.Количество() = 2 Тогда 
		стр_УИД_Элемента = МассивСтрок[1];
	Иначе 
		Возврат;
	КонецЕсли;
	
	// открываем форму
	СтруктураДанныхОбъекта = ПолучитьДаныеОбъекта(стр_УИД_Элемента);
	
	Если СтруктураДанныхОбъекта = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если СтруктураДанныхОбъекта.Метод = "ОткрытьФорму" Тогда
		
		ЭтоВнешнийОтчет = ПолучитьВидОбъекта(СтруктураДанныхОбъекта.ПодключаемыйОбъект);
		ОткрытьФорму(СтруктураДанныхОбъекта.ИмяФормы,СтруктураДанныхОбъекта,,?(ЭтоВнешнийОтчет, Новый УникальныйИдентификатор,Неопределено),,,,РежимОткрытияОкнаФормы.Независимый);
		
	ИначеЕсли  СтруктураДанныхОбъекта.Метод = "ВыполнитьКлиентскийМетод" Тогда
		
		ФормаОбъекта = ПолучитьФорму(СтруктураДанныхОбъекта.ИмяФормы, СтруктураДанныхОбъекта);
		ФормаОбъекта.ВыполнитьКлиентскийМетод();
		
	КонецЕсли;
	
КонецПроцедуры

