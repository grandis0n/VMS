Процедура ПродолжитьПолучениеРуководстваПользователя(Результат, Параметры) Экспорт   
	
	Если Не ПроверитьПодключениеНаСервере() Тогда
			ПоказатьПредупреждение(,"Не удалось подключиться к сайту технической поддержки.
									|Пожалуйста, убедитесь в корректности логина и пароля.",60);
	
	Иначе
		РезультатВыполнения =  ПолучитьРуководствоПользователяВФоне();
		
		ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
		ПараметрыОжидания.ВыводитьОкноОжидания = Истина;
		ОповещениеОЗавершении = Новый ОписаниеОповещения("ПродолжитьОткрытиеРуководстваПользователя", ЭтотОбъект);
		
		ДлительныеОперацииКлиент.ОжидатьЗавершение(РезультатВыполнения, ОповещениеОЗавершении, ПараметрыОжидания);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПроверитьЗаполнениеДанныхПоддержкиНаСервере() 
	
	Возврат CW_МониторПорталаПоддержкиСервер.ЗаполненыДанныеАутентификацииПользователяИнтернетПоддержки();

КонецФункции


&НаКлиенте
Процедура ПродолжитьОткрытиеРуководстваПользователя(РезультатВыполненя, ДополнительныеПараметры) Экспорт
	
	Если РезультатВыполненя.Статус = "Выполнено" Тогда
		Если ЭтоАдресВременногоХранилища(РезультатВыполненя.АдресРезультата) Тогда
			
			Если МожноПоказатьВПриложении() Тогда
				
				ПараметрыОткрытия = Новый Структура;
				ПараметрыОткрытия.Вставить("АдресФайла",	 РезультатВыполненя.АдресРезультата); 
				ПараметрыОткрытия.Вставить("ЗаголовокФормы", "Руководство пользователя"); 
				
				ОткрытьФорму("ОбщаяФорма.CW_ПросмотрPDFФайла", ПараметрыОткрытия);    
				
			Иначе
				ДвоичныеДанные = ПолучитьИзВременногоХранилища(РезультатВыполненя.АдресРезультата);
				
				#Если ВебКлиент Тогда
					ИмяФайла = "РуководствоПользователяБЭ.pdf";
					ПараметрыДиалогаПолученияФайлов = Новый ПараметрыДиалогаПолученияФайлов;
					ПараметрыДиалогаПолученияФайлов.ВыборКаталога = Истина;
					
					НачатьПолучениеФайлаССервера(РезультатВыполненя.АдресРезультата,ИмяФайла, ПараметрыДиалогаПолученияФайлов);	
				#Иначе
					ВременныйФайл = ПолучитьИмяВременногоФайла("pdf");
					ДвоичныеДанные.Записать(ВременныйФайл); 
					
					ЗапуститьПриложение(ВременныйФайл);
				#КонецЕсли      
			КонецЕсли;
		
		КонецЕсли;
	Иначе
		ПоказатьПредупреждение(,"Не удалось загрузить руководство пользователя.
								|Пожалуйста, повторите попытку позднее или
								|обратитесь в техническую поддержку.");
	КонецЕсли;
	
КонецПроцедуры   

&НаСервере
Функция МожноПоказатьВПриложении()
	
	СистемнаяИнформация = Новый СистемнаяИнформация; 
	
	мВерсияПриложения = СтрРазделить(СистемнаяИнформация.ВерсияПриложения,".", Ложь);   
	мМинимальнаяВерсия = СтрРазделить("8.3.21", ".", Ложь);
	
	Для Индекс = 0 по мМинимальнаяВерсия.Количество() - 1 Цикл
		Если мВерсияПриложения[Индекс] >= мМинимальнаяВерсия[Индекс] Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла; 
	
	Возврат Ложь;
	
КонецФункции 


&НаСервере
Функция ПолучитьРуководствоПользователяВФоне()
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(Новый УникальныйИдентификатор);
	ПараметрыВыполнения.ОжидатьЗавершение 			= 0; // запускать сразу
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = "Открытие руководства пользователя";
	ПараметрыВыполнения.ЗапуститьВФоне 				= Истина;
	ПараметрыВыполнения.ЗапуститьНеВФоне 			= ложь;
	
	ПараметрыПроцедуры = Новый Структура;
	
	Возврат ДлительныеОперации.ВыполнитьВФоне("Обработки.CW_РабочийСтол_БЭ.ПолучитьРуководствоПользователя", ПараметрыПроцедуры, ПараметрыВыполнения);
	
КонецФункции


