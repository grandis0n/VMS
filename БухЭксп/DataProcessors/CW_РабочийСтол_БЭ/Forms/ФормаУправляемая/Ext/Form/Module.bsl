&НаСервере
Функция ПолучитьЗаголовокФормыНаСервере()  
	
	
	УстановитьПривилегированныйРежим(Истина);  
	
	Пользователь = Строка(CW_Настройки.Пользователь().Наименование);
	Если Пользователь = "" Тогда
		Пользователь = Строка(CW_Настройки.Пользователь().Код);
	КонецЕсли;  
	
	//Подсистема.ОбновлениеКонфигурации  
	УстановленнаяВерсия 	= "";
	ИмяОсновнойПодсистемы 	= CW_ВерсииПодсистемСервер.ИмяОсновнойПодсистемы();
	ВерсииПодсистем 		= CW_ВерсииПодсистемСервер.УстановленныеВерсииПодсистем();
	
	ВерсииПодсистем.Свойство(ИмяОсновнойПодсистемы, УстановленнаяВерсия);
	УстановленнаяВерсия = ?(УстановленнаяВерсия = Неопределено, "0.0.0.0", УстановленнаяВерсия);

	ИмяТекущейКонфигурации	= CW_ВерсииПодсистемСервер.ИмяТекущейКонфигурации(); 
	//Подсистема.ОбновлениеКонфигурации   
	
	ДляВерсииКОРП = "";
	ОбщийМодульВариантыПриложений = CW_ОбщегоНазначения.ОбщийМодуль("ВариантыПриложений");
	Если ОбщийМодульВариантыПриложений <> Неопределено Тогда
		ДляВерсииКОРП =	?(ОбщийМодульВариантыПриложений.ЭтоВерсияКОРП()," КОРП", "");
	КонецЕсли;

	Если ЭтоПервыйЗапуск или ТребуетсяОбновление Тогда
		Возврат ИмяТекущейКонфигурации + ДляВерсииКОРП;
	Иначе
		Возврат ИмяТекущейКонфигурации + ДляВерсииКОРП +" ("+УстановленнаяВерсия+"). Пользователь: "+Пользователь;
	КонецЕсли;
	
	
КонецФункции
 
&НаСервере
Функция _ПараметрыФормыНастроекПользователя()
	// --- 
	
	Пользователь = CW_Настройки.Пользователь();
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	CW_НастройкиПользователей.Пользователь
	|ИЗ
	|	РегистрСведений.CW_НастройкиПользователей КАК CW_НастройкиПользователей
	|ГДЕ
	|	CW_НастройкиПользователей.Пользователь = &Пользователь";
	Запрос.УстановитьПараметр("Пользователь", Пользователь);
	ТЗ = Запрос.Выполнить().Выгрузить();
	Если ТЗ.Количество() = 0 Тогда
		
		// создаём
		Запись = РегистрыСведений.CW_НастройкиПользователей.СоздатьМенеджерЗаписи();
		Запись.Пользователь = Пользователь;
		Запись.Записать();
		
	КонецЕсли; 
	
	// пробуем получить ключ
	Отбор = Новый Структура("Пользователь",CW_Настройки.Пользователь());
	Ключ = РегистрыСведений.CW_НастройкиПользователей.СоздатьКлючЗаписи(Отбор);
	// --- 	
	ПФ = Новый Структура("Ключ",Ключ);
	Возврат(ПФ);
	
	// --- 
КонецФункции
 
