&НаКлиенте
Процедура ДеревоЗначенийСуммаВалПриИзменении(Элемент) 
	
	ТекущиеДанные = Элементы.ДеревоЗначений.ТекущиеДанные;
	Если ВалютаДоговора = ВалютаРегламентированногоУчета Тогда
		ТекущиеДанные.Сумма = ТекущиеДанные.СуммаВал;  
	Иначе
		ТекущиеДанные.Сумма  = ПересчитатьСуммуНаСервере(ТекущиеДанные.СуммаВал, ВалютаДоговора, ВалютаРегламентированногоУчета); 
	КонецЕсли;

	ТекущиеДанные.Курс = 1;
	Если ТекущиеДанные.СуммаВал <> 0 Тогда
		ТекущиеДанные.Курс = ТекущиеДанные.Сумма / ТекущиеДанные.СуммаВал;
	КонецЕсли;
	
   	ПересчитатьИтоги();
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоЗначенийСуммаПриИзменении(Элемент)   
	
	ТекущиеДанные = Элементы.ДеревоЗначений.ТекущиеДанные;
	Если ВалютаДоговора = ВалютаРегламентированногоУчета Тогда
		ТекущиеДанные.СуммаВал = ТекущиеДанные.Сумма; 
	Иначе
		//ТекущиеДанные.СуммаВал = ПересчитатьСуммуНаСервере(ТекущиеДанные.Сумма, ВалютаРегламентированногоУчета, ВалютаДоговора); 
	КонецЕсли;
	
	ТекущиеДанные.Курс = 1;
	Если ТекущиеДанные.СуммаВал <> 0 Тогда
		ТекущиеДанные.Курс = ТекущиеДанные.Сумма / ТекущиеДанные.СуммаВал;
	КонецЕсли;

   	ПересчитатьИтоги();
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоЗначенийПослеУдаления(Элемент)
   	ПересчитатьИтоги();
КонецПроцедуры

&НаСервере
Функция ПересчитатьСуммуНаСервере(Сумма, ВалютаНач, ВалютаКон)
	
	КурсВалютыНач = CW_Финансы.ПолучитьКурсВалюты(ВалютаНач, ДатаДокумента);
	КурсВалютыКон = CW_Финансы.ПолучитьКурсВалюты(ВалютаКон, ДатаДокумента);
	
	Возврат CW_Финансы.ПересчитатьИзВалютыВВалюту(Сумма, ВалютаНач,ВалютаКон,КурсВалютыНач.Курс, КурсВалютыКон.Курс, КурсВалютыНач.Курс, КурсВалютыНач.Кратность); 
	
КонецФункции

&НаКлиенте
Процедура ПересчитатьИтоги()
	
	ИтогоСуммаВал = 0;
	ЭлементыДерева = ДеревоЗначений.ПолучитьЭлементы();
	Для Каждого ЭлементДерева из ЭлементыДерева Цикл 
		ДанныеСтроки = ПолучитьДанныеСтроки(ЭлементДерева);
		ЭлементДерева.СуммаВал = ДанныеСтроки.СуммаВал;
		ЭлементДерева.Сумма    = ДанныеСтроки.Сумма;   
		
		ЭлементДерева.Курс = 1;
		Если ЭлементДерева.СуммаВал <> 0 Тогда
			ЭлементДерева.Курс = ЭлементДерева.Сумма / ЭлементДерева.СуммаВал;
		КонецЕсли;
		
		ИтогоСуммаВал = ИтогоСуммаВал + ДанныеСтроки.СуммаВал
	КонецЦикла;
	
КонецПроцедуры 

&НаКлиенте
Функция ПолучитьДанныеСтроки(ЭлементДерева)   
	
	ДанныеСтроки = Новый Структура("СуммаВал,Сумма", 0,0);
	
	ЭлементыДерева = ЭлементДерева.ПолучитьЭлементы();
	Для Каждого СтрокаДерева из ЭлементыДерева Цикл
		 ДанныеСтроки.Сумма 	= СтрокаДерева.Сумма;
		 ДанныеСтроки.СуммаВал 	= СтрокаДерева.СуммаВал;
	КонецЦикла;
	
	Возврат ДанныеСтроки;
	
КонецФункции

&НаКлиенте
Процедура ОткрытьДокументВзаиморасчетов(Команда)
	
	ТекущаяСтрока = Элементы.ДеревоЗначений.ТекущаяСтрока;
	ПродолжитьОткрытиеДокумента(ТекущаяСтрока);
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоЗначенийВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Поле.Имя = "ДеревоЗначенийПредставлениеДокумента" Тогда
		СтандартнаяОбработка = Ложь;
		ПродолжитьОткрытиеДокумента(ВыбраннаяСтрока);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПродолжитьОткрытиеДокумента(ВыбраннаяСтрока)
	
	СтрокаТекущая = ДеревоЗначений.НайтиПоИдентификатору(ВыбраннаяСтрока);
	ПоказатьЗначение(, СтрокаТекущая.ДокументВзаиморасчетов);
	
КонецПроцедуры


