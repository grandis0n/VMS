	               |					ВТ_Акты КАК ВТ_Акты)";
	
	Запрос.УстановитьПараметр("РезультатВыбора", РезультатВыбора);
	Запрос.УстановитьПараметр("ОплатаСсылка", 	 ОплатаСсылка); 
	
	ПакетРезультатовЗапроса = Запрос.ВыполнитьПакет();  
	
	РезультатЗапроса 		= ПакетРезультатовЗапроса[2];
	
	ВыборкаСчетЗадолженности = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаСчетЗадолженности.Следующий() Цикл 
		
		ВыборкаСчет = ВыборкаСчетЗадолженности.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаСчет.Следующий() Цикл     
			
			ВалютаСчета		= ВыборкаСчет.Документ.Валюта;
			КурсВалютыСчета	= CW_Финансы.ПолучитьКурсВалюты(ВалютаСчета, ДатаСреза); 
			
			Если ОбщегоНазначения.ЕстьРеквизитОбъекта("ПредставлениеДокумента", ВыборкаСчет.Документ.Метаданные()) Тогда
				ПредставлениеДокумента = ВыборкаСчет.Документ.ПредставлениеДокумента;
			Иначе
				ПредставлениеДокумента = СокрЛП(ВыборкаСчет.Документ);
			КонецЕсли;
			
			НоваяСтрокаСчет = ДеревоСчетов.Строки.Добавить();
			НоваяСтрокаСчет.ДокументВзаиморасчетов 	= ВыборкаСчет.Документ;
			НоваяСтрокаСчет.ПредставлениеДокумента 	= ПредставлениеДокумента;
			НоваяСтрокаСчет.СчетЗадолженности      	= ВыборкаСчет.СчетЗадолженности;
			НоваяСтрокаСчет.СуммаВал               	= ВыборкаСчет.Всего;
			//НоваяСтрокаСчет.Сделка                = ВыборкаСчет.Документ.ВедомыйСчет;
			//НоваяСтрокаСчет.СтавкаНДС    			= Неопределено;
			НоваяСтрокаСчет.Сумма 					= CW_Финансы.ПересчитатьИзВалютыВВалюту(
														ВыборкаСчет.Всего, 
														ВалютаСчета, 
														ВалютаРегламентированногоУчета, 
														КурсВалютыСчета.Курс, 
														КурсВалюты.Курс, 
														КурсВалютыСчета.Кратность, 
														КурсВалюты.Кратность);  
			
			НоваяСтрокаСчет.Курс = 1;
			Если НоваяСтрокаСчет.СуммаВал <> 0 Тогда
				НоваяСтрокаСчет.Курс = НоваяСтрокаСчет.Сумма / НоваяСтрокаСчет.СуммаВал;
			КонецЕсли;
			
			ВыборкаАкт = ВыборкаСчет.Выбрать();
			Пока ВыборкаАкт.Следующий() Цикл  
				
				Если ОбщегоНазначения.ЕстьРеквизитОбъекта("ПредставлениеДокумента", ВыборкаАкт.ДокументБУ.Метаданные()) Тогда
					ПредставлениеДокумента = ВыборкаАкт.ДокументБУ.ПредставлениеДокумента;
				Иначе
					ПредставлениеДокумента = СокрЛП(ВыборкаАкт.ДокументБУ);
				КонецЕсли;
				
				СтрокаВторогоУровня = НоваяСтрокаСчет.Строки.Добавить();
				СтрокаВторогоУровня.ИндексКартинки 			= 1;
				СтрокаВторогоУровня.ПредставлениеДокумента 	= ПредставлениеДокумента;
				СтрокаВторогоУровня.ДокументВзаиморасчетов 	= ВыборкаАкт.ДокументБУ;
				СтрокаВторогоУровня.СчетЗадолженности      	= ВыборкаАкт.СчетЗадолженности;
				СтрокаВторогоУровня.СуммаВал               	= ВыборкаАкт.Всего;
				СтрокаВторогоУровня.Сделка                 	= ВыборкаАкт.ДокументБУ.ВедомыйДокумент;
				//СтрокаВторогоУровня.СтавкаНДС    			= Неопределено;
				СтрокаВторогоУровня.Сумма = CW_Финансы.ПересчитатьИзВалютыВВалюту(
												ВыборкаАкт.Всего, 
												ВалютаСчета, 
												ВалютаРегламентированногоУчета, 
												КурсВалютыСчета.Курс, 
												КурсВалюты.Курс, 
												КурсВалютыСчета.Кратность, 
												КурсВалюты.Кратность);    
				
				СтрокаВторогоУровня.Курс = 1;
				Если СтрокаВторогоУровня.СуммаВал <> 0 Тогда
					СтрокаВторогоУровня.Курс = СтрокаВторогоУровня.Сумма / СтрокаВторогоУровня.СуммаВал;
				КонецЕсли;
				
			КонецЦикла; 
			
		КонецЦикла;
		
	КонецЦикла;  
	
	РезультатЗапросаОплаты 	= ПакетРезультатовЗапроса[3]; 
	ВыборкаОплаты = РезультатЗапросаОплаты.Выбрать();
	Пока ВыборкаОплаты.Следующий() Цикл 
		
		ВалютаСчета		= ВыборкаОплаты.Документ.Валюта;
		КурсВалютыСчета	= CW_Финансы.ПолучитьКурсВалюты(ВалютаСчета, ДатаСреза); 
		
		Если ОбщегоНазначения.ЕстьРеквизитОбъекта("ПредставлениеДокумента", ВыборкаОплаты.Документ.Метаданные()) Тогда
			ПредставлениеДокумента = ВыборкаОплаты.Документ.ПредставлениеДокумента;
		Иначе
			ПредставлениеДокумента = СокрЛП(ВыборкаОплаты.Документ);
		КонецЕсли;   
		
		НоваяСтрокаСчет = ДеревоСчетов.Строки.Добавить();
		НоваяСтрокаСчет.ДокументВзаиморасчетов 	= ВыборкаОплаты.Документ;
		НоваяСтрокаСчет.ПредставлениеДокумента 	= ПредставлениеДокумента;
		НоваяСтрокаСчет.СчетЗадолженности      	= ВыборкаОплаты.СчетЗадолженности;
		НоваяСтрокаСчет.СуммаВал               	= ВыборкаОплаты.Всего;
		//НоваяСтрокаСчет.Сделка                = ВыборкаСчет.Документ.ВедомыйСчет;
		//НоваяСтрокаСчет.СтавкаНДС    			= Неопределено;
		НоваяСтрокаСчет.Сумма 					= CW_Финансы.ПересчитатьИзВалютыВВалюту(
														ВыборкаОплаты.Всего, 
														ВалютаСчета, 
														ВалютаРегламентированногоУчета, 
														КурсВалютыСчета.Курс, 
														КурсВалюты.Курс, 
														КурсВалютыСчета.Кратность, 
														КурсВалюты.Кратность);  
														
		НоваяСтрокаСчет.Курс = 1;
		Если НоваяСтрокаСчет.СуммаВал <> 0 Тогда
			НоваяСтрокаСчет.Курс = НоваяСтрокаСчет.Сумма / НоваяСтрокаСчет.СуммаВал;
		КонецЕсли;
		
		Если ОбщегоНазначения.ЕстьРеквизитОбъекта("ПредставлениеДокумента", ВыборкаОплаты.ДокументБУ.Метаданные()) Тогда
			ПредставлениеДокументаБУ = ВыборкаОплаты.ДокументБУ.ПредставлениеДокумента;
		Иначе
			ПредставлениеДокументаБУ = СокрЛП(ВыборкаОплаты.ДокументБУ);
		КонецЕсли;
		
		СтрокаВторогоУровня = НоваяСтрокаСчет.Строки.Добавить();
		СтрокаВторогоУровня.ИндексКартинки 			= 1;
		СтрокаВторогоУровня.ПредставлениеДокумента 	= ПредставлениеДокументаБУ;
		СтрокаВторогоУровня.ДокументВзаиморасчетов 	= ВыборкаОплаты.ДокументБУ;
		СтрокаВторогоУровня.СчетЗадолженности      	= ВыборкаОплаты.СчетЗадолженности;
		СтрокаВторогоУровня.СуммаВал               	= ВыборкаОплаты.Всего;
		СтрокаВторогоУровня.Сделка                 	= ВыборкаОплаты.ДокументБУ.Основание;
		//СтрокаВторогоУровня.СтавкаНДС    			= Неопределено;
		СтрокаВторогоУровня.Сумма = CW_Финансы.ПересчитатьИзВалютыВВалюту(
										ВыборкаОплаты.Всего, 
										ВалютаСчета, 
										ВалютаРегламентированногоУчета, 
										КурсВалютыСчета.Курс, 
										КурсВалюты.Курс, 
										КурсВалютыСчета.Кратность, 
										КурсВалюты.Кратность);    
										СтрокаВторогоУровня.Курс = 1;
										
		Если СтрокаВторогоУровня.СуммаВал <> 0 Тогда
			СтрокаВторогоУровня.Курс = СтрокаВторогоУровня.Сумма / СтрокаВторогоУровня.СуммаВал;
		КонецЕсли;
		
	КонецЦикла;

КонецПроцедуры


&НаСервере
Функция ПолучитьПустоеДерево()  
	
	ДеревоСчетов = РеквизитФормыВЗначение("ДеревоЗначений");
	ДеревоСчетов.Строки.Очистить();
	
	Возврат ДеревоСчетов;
	
КонецФункции
//---Подбор документов


&НаКлиенте
Процедура ПеренестиВДокумент(Команда) 
	
	РезультатВыполнения =  НачатьЗаполнениеДокументовНаСервереВФоне();
	
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ВыводитьОкноОжидания = Истина;
	ОповещениеОЗавершении = Новый ОписаниеОповещения("ОбработатьЗаполненияДокументов", ЭтотОбъект);
	
	ДлительныеОперацииКлиент.ОжидатьЗавершение(РезультатВыполнения, ОповещениеОЗавершении, ПараметрыОжидания);

КонецПроцедуры   

&НаКлиенте
Процедура ОбработатьЗаполненияДокументов(РезультатВыполнения, Дополнительныепараметры) Экспорт
	
	Если РезультатВыполнения.Статус = "Выполнено" Тогда
		
		ЭтаФорма.Закрыть(Истина);
	
	ИначеЕсли РезультатВыполнения.Статус = "Ошибка" Тогда
		
		ТекстПредупреждения = "Не удалось сформировать документы!
		| По причине: "+ РезультатВыполнения.КраткоеПредставлениеОшибки + "
		| Информаиция об ошибке см. в журнале регистрации!";
		
		Если ТипЗнч(РезультатВыполнения.Сообщения) = Тип("Массив") Тогда
			Для Каждого СообщениеВМассиве из РезультатВыполнения.Сообщения Цикл
				СообщениеВМассиве.Сообщить();
			КонецЦикла;
		КонецЕсли;
		
		ПоказатьПредупреждение(,ТекстПредупреждения,,"Ошибка формирования документов"); 
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция НачатьЗаполнениеДокументовНаСервереВФоне() 
	
	ДокументОплата 				= ПолучитьСвязанныйДокументОплата();
	СтруктураТаблицДокументов 	= ПодготовитьПустыеТаблицыДокументов(); 
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("ДатаДокумента", 					ДатаДокумента);
	СтруктураПараметров.Вставить("Организация", 					Организация);
	СтруктураПараметров.Вставить("Контрагент", 						Контрагент);
	СтруктураПараметров.Вставить("Договор", 						Договор);
	СтруктураПараметров.Вставить("ПриложениеКДоговору",				ПриложениеКДоговору);
	СтруктураПараметров.Вставить("УчетныйДоговор",					УчетныйДоговор);
	СтруктураПараметров.Вставить("СтатьяДвиженияДенежныхСредств",	СтатьяДвиженияДенежныхСредств);
	СтруктураПараметров.Вставить("ДереваСчетов", 					РеквизитФормыВЗначение("ДеревоЗначений"));
	СтруктураПараметров.Вставить("ДокументВыписки",					ДокументВыписки);
	СтруктураПараметров.Вставить("ДокументОплата",					ДокументОплата);
	СтруктураПараметров.Вставить("ПустыеТаблицыДокументов",			СтруктураТаблицДокументов); 

	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(Новый УникальныйИдентификатор);
	ПараметрыВыполнения.ОжидатьЗавершение 			= 0; // запускать сразу
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = "Заполнение документ ""Списание с расчетного счета""";
	ПараметрыВыполнения.ЗапуститьВФоне 				= Истина;
	ПараметрыВыполнения.ЗапуститьНеВФоне 			= ложь;
	
	Возврат ДлительныеОперации.ВыполнитьВФоне("Обработки.CW_ПодборОперативныхДокументов.ЗаполнитьДокументСписаниеСРасчетногоСчета", СтруктураПараметров, ПараметрыВыполнения);
	
КонецФункции

&НаСервере
Функция ПолучитьСвязанныйДокументОплата()
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	|	CW_СвязанныеОплаты.Ссылка КАК Ссылка
	|ИЗ
	|	КритерийОтбора.CW_СвязанныеОплаты(&СписаниеСРасчетногоСчета) КАК CW_СвязанныеОплаты";   
	
	Запрос.УстановитьПараметр("СписаниеСРасчетногоСчета", ДокументВыписки);
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Если Выборка.Следующий() Тогда
		ДокументОплата = Выборка.Ссылка;
	КонецЕсли;

	Возврат ДокументОплата;

КонецФункции

&НаСервере
Функция ПодготовитьПустыеТаблицыДокументов()

	СтруктураТаблиц = Новый Структура;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 0
	|	CW_ОплатаОплата.Счет КАК Счет,
	|	CW_ОплатаОплата.Акт КАК Акт,
	|	CW_ОплатаОплата.СчетЗадолженности КАК СчетЗадолженности,
	|	CW_ОплатаОплата.СчетАванса КАК СчетАванса,
	|	CW_ОплатаОплата.Оплата КАК Оплата,
	|	CW_ОплатаОплата.Оплата_БВ КАК Оплата_БВ,
	|	CW_ОплатаОплата.Курс КАК Курс,
	|	CW_ОплатаОплата.СтавкаНДС КАК СтавкаНДС
	|ИЗ
	|	Документ.CW_Оплата.Оплата КАК CW_ОплатаОплата";  
	
	РезультатЗапроса 	= Запрос.Выполнить();
	ТаблицаОплат 		= РезультатЗапроса.Выгрузить();
	
	СтруктураТаблиц.Вставить("Оплаты", ТаблицаОплат);
	
	Если ТипЗнч(ДокументВыписки) = Тип("ДокументСсылка.СписаниеСРасчетногоСчета") Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 0
		|	СписаниеСРасчетногоСчетаРасшифровкаПлатежа.ДоговорКонтрагента КАК ДоговорКонтрагента,
		|	СписаниеСРасчетногоСчетаРасшифровкаПлатежа.СпособПогашенияЗадолженности КАК СпособПогашенияЗадолженности,
		|	СписаниеСРасчетногоСчетаРасшифровкаПлатежа.Сделка КАК Сделка,
		|	СписаниеСРасчетногоСчетаРасшифровкаПлатежа.СуммаПлатежа КАК СуммаПлатежа,
		|	СписаниеСРасчетногоСчетаРасшифровкаПлатежа.КурсВзаиморасчетов КАК КурсВзаиморасчетов,
		|	СписаниеСРасчетногоСчетаРасшифровкаПлатежа.СуммаВзаиморасчетов КАК СуммаВзаиморасчетов,
		|	СписаниеСРасчетногоСчетаРасшифровкаПлатежа.СтавкаНДС КАК СтавкаНДС,
		|	СписаниеСРасчетногоСчетаРасшифровкаПлатежа.СуммаНДС КАК СуммаНДС,
		|	СписаниеСРасчетногоСчетаРасшифровкаПлатежа.СтатьяДвиженияДенежныхСредств КАК СтатьяДвиженияДенежныхСредств,
		|	СписаниеСРасчетногоСчетаРасшифровкаПлатежа.СчетУчетаРасчетовСКонтрагентом КАК СчетУчетаРасчетовСКонтрагентом,
		|	СписаниеСРасчетногоСчетаРасшифровкаПлатежа.СчетУчетаРасчетовПоАвансам КАК СчетУчетаРасчетовПоАвансам,
		|	СписаниеСРасчетногоСчетаРасшифровкаПлатежа.КратностьВзаиморасчетов КАК КратностьВзаиморасчетов,
		|	СписаниеСРасчетногоСчетаРасшифровкаПлатежа.РасходыУСН КАК РасходыУСН,
		|	СписаниеСРасчетногоСчетаРасшифровкаПлатежа.НДСУСН КАК НДСУСН,
		|	СписаниеСРасчетногоСчетаРасшифровкаПлатежа.УдалитьРаспределятьРасходыУСН КАК УдалитьРаспределятьРасходыУСН,
		|	СписаниеСРасчетногоСчетаРасшифровкаПлатежа.СчетНаОплату КАК СчетНаОплату,
		|	СписаниеСРасчетногоСчетаРасшифровкаПлатежа.ВидПлатежаПоКредитамЗаймам КАК ВидПлатежаПоКредитамЗаймам,
		|	СписаниеСРасчетногоСчетаРасшифровкаПлатежа.ПорядокОтраженияДохода КАК ПорядокОтраженияДохода,
		|	СписаниеСРасчетногоСчетаРасшифровкаПлатежа.ОтражениеВУСН КАК ОтражениеВУСН
		|ИЗ
		|	Документ.СписаниеСРасчетногоСчета.РасшифровкаПлатежа КАК СписаниеСРасчетногоСчетаРасшифровкаПлатежа";  
		
		РезультатЗапроса = Запрос.Выполнить();
		ТаблицаСписаниеСРасчетногоСчета = РезультатЗапроса.Выгрузить(); 
		
		СтруктураТаблиц.Вставить("ТаблицаБухгалтескогоДокумента", 	ТаблицаСписаниеСРасчетногоСчета);
	
	КонецЕсли;
	
	Если ТипЗнч(ДокументВыписки) = Тип("ДокументСсылка.ПоступлениеНаРасчетныйСчет") Тогда
		
