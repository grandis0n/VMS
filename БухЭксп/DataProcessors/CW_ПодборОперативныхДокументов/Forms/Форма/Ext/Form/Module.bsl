
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	CW_Документы.ОпределитьВозможностьОткрытияОбъектаМодуля(ТипЗнч(ДокументВыписки),,Отказ);
	
	Параметры.Свойство("Ссылка",				ДокументВыписки);  
	Параметры.Свойство("ДатаДокумента", 		ДатаДокумента);
	Параметры.Свойство("Организация", 			Организация);
	Параметры.Свойство("Контрагент", 			Контрагент);
	Параметры.Свойство("Договор",				Договор);        
	Параметры.Свойство("ПриложениеКДоговору",	ПриложениеКДоговору);        
	Параметры.Свойство("УчетныйДоговор",		УчетныйДоговор);  
	
	ВалютаРегламентированногоУчета = Константы.ВалютаРегламентированногоУчета.Получить(); 

	ВалютаДоговора = Договор.ВалютаДоговора;
	УстановитьВидимостьСуммыВВалюте(); 
	
	УстановитьДеревоНаФорме();     
	
	//Подсистема.УчетПриложенийДоговоров
	ДанныеОбъекта = Новый Структура("Договор", Договор);
	CW_УчетПриложенийДоговоровСервер.УстановитьПараметрФункциональнойОпции(ЭтаФорма, ДанныеОбъекта);
	//Подсистема.УчетПриложенийДоговоров
	
КонецПроцедуры   

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ЭлементыДерева = ДеревоЗначений.ПолучитьЭлементы(); 

	МассивСтрок = Новый Массив;
	Для Каждого СтрокаДерева из ЭлементыДерева ЦИкл
		МассивСтрок.Добавить(СтрокаДерева.ПолучитьИдентификатор());
	КонецЦикла; 
	
	ПересчитатьИтоги();	
	РазвернутьДерево(МассивСтрок);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьДеревоНаФорме()
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	CW_СвязанныеОплаты.Ссылка КАК Ссылка
	               |ИЗ
	               |	КритерийОтбора.CW_СвязанныеОплаты(&Ссылка) КАК CW_СвязанныеОплаты
	               |ГДЕ
	               |	CW_СвязанныеОплаты.Ссылка.Организация = &Организация
	               |	И CW_СвязанныеОплаты.Ссылка.Контрагент = &Контрагент
	               |	И CW_СвязанныеОплаты.Ссылка.Договор = &Договор
	               |	И CW_СвязанныеОплаты.Ссылка.ПриложениеКДоговору = &ПриложениеКДоговору"; 
	
	Запрос.УстановитьПараметр("Ссылка", 		ДокументВыписки);
	Запрос.УстановитьПараметр("Организация", 	Организация);
	Запрос.УстановитьПараметр("Контрагент", 	Контрагент);
	Запрос.УстановитьПараметр("Договор", 		Договор);
	Запрос.УстановитьПараметр("ПриложениеКДоговору", ПриложениеКДоговору);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	Если Выборка.Следующий() Тогда 
		ОплатаСсылка = Выборка.Ссылка;  
		
		СтатьяДвиженияДенежныхСредств = ОплатаСсылка.СтатьяДвиженияДенежныхСредств; 
		
		ДеревоОплат = ОплатаСсылка.ХранилищеДерева.Получить();
		Если ТипЗнч(ДеревоОплат) = Тип("ДеревоЗначений") Тогда
			Попытка
				ЗначениеВРеквизитФормы(ДеревоОплат, "ДеревоЗначений");
			Исключение 
				//На случай, если изменится структура дерева
			КонецПопытки;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДоговорПриИзменении(Элемент)
	
	ДоговорПриИзмененииНаСервере(); 
	
КонецПроцедуры   

&НаКлиенте
Процедура ПриложениеКДоговоруПриИзменении(Элемент)
	ПриложениеКДоговоруПриИзмененииНаСервере();
КонецПроцедуры

&НаСервере
Процедура ДоговорПриИзмененииНаСервере() 

	
	УчетныйДоговор = Договор.УчетныйДоговор;
 	ВалютаДоговора = Договор.ВалютаДоговора;

	УстановитьВидимостьСуммыВВалюте();  

	//Подсистема.УчетПриложенийДоговоров
	ДанныеОбъекта = Новый Структура("Договор", Договор);
	CW_УчетПриложенийДоговоровСервер.УстановитьПараметрФункциональнойОпции(ЭтаФорма, ДанныеОбъекта);
	//Подсистема.УчетПриложенийДоговоров  
	
КонецПроцедуры 

&НаСервере
Процедура ПриложениеКДоговоруПриИзмененииНаСервере()

	УчетныйДоговор = ПриложениеКДоговору.УчетныйДоговор;
 	ВалютаДоговора = ПриложениеКДоговору.ВалютаДоговора;  
	
	УстановитьВидимостьСуммыВВалюте(); 
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьСуммыВВалюте()
	
	Элементы.ДеревоЗначенийСуммаВал.Видимость 	= ВалютаРегламентированногоУчета <> ВалютаДоговора;
	Элементы.ДеревоЗначенийКурс.Видимость 		= ВалютаРегламентированногоУчета <> ВалютаДоговора;
	Элементы.ДеревоЗначенийСуммаВал.Заголовок 	= "Сумма, "+СокрЛП(ВалютаДоговора);
	
КонецПроцедуры


//Очистка дерева счетов
&НаКлиенте
Процедура Очистить(Команда)   
	
	Режим = РежимДиалогаВопрос.ДаНет;
	Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопроса", ЭтотОбъект, Параметры);
	ПоказатьВопрос(Оповещение, "Табличная часть будет очищена. Продолжить?", Режим, 0);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияВопроса(Результат, Параметры) Экспорт
	Если Результат = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;  
	
	ОчиститьНаСервере();	
	ПересчитатьИтоги();
	
КонецПроцедуры

&НаСервере
Процедура ОчиститьНаСервере()
	
	ЭлементыДерева = ДеревоЗначений.ПолучитьЭлементы();
	ЭлементыДерева.Очистить();

КонецПроцедуры
//---Очистка дерева счетов


//Подбор документов
&НаКлиенте
Процедура Подбор(Команда)

	ОписаниеОповещения = Новый ОписаниеОповещения("ЗавершитьВыборТипаДокумента", ЭтотОбъект);
	
	МассивОграничениеТипа = ПолучитьОграниченияТипа();
	
	СписокТиповДокумента = Новый СписокЗначений;
	СписокТиповДокумента.ЗагрузитьЗначения(МассивОграничениеТипа);
	СписокТиповДокумента.ПоказатьВыборЭлемента(ОписаниеОповещения, "Выберите тип документа");
	
КонецПроцедуры    

&НаКлиенте
Процедура ЗавершитьВыборТипаДокумента(РезультатВыбора, ДополнительныеПараметры) Экспорт
	
	Если РезультатВыбора = Неопределено Тогда
		Возврат;
	КонецЕсли;          
	
	ТипОбъекта = РезультатВыбора.Значение;
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ТипОбъекта", ТипОбъекта);
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ОбработатьВыборДокументов", ЭтотОбъект, ДополнительныеПараметры);
	
	Отбор = Новый Структура;
	Отбор.Вставить("Организация",		Организация);
	Отбор.Вставить("Контрагент", 		Контрагент);
	Отбор.Вставить("Договор",			Договор);
	Отбор.Вставить("Проведен",			Истина); 
	
	Если ТипОбъекта = Тип("ДокументСсылка.CW_ДоходыПоГрузоперевозке") Тогда
		Отбор.Вставить("ФормируетсяСчет", Истина);                                       
	КонецЕсли;
	Если ТипОбъекта = Тип("ДокументСсылка.CW_РасходыПоГрузоперевозке") Тогда
		Отбор.Вставить("ПредъявленСчет", Истина);                                       
	КонецЕсли;
	Если ТипОбъекта = Тип("ДокументСсылка.CW_Оплата") Тогда
		Отбор.Вставить("ЭтоВозврат", Ложь);                                       
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПриложениеКДоговору) Тогда
		Отбор.Вставить("ПриложениеКДоговору", 	ПриложениеКДоговору);
	КонецЕсли; 
	
	СтруктураПараметров = Новый Структура;    
	СтруктураПараметров.Вставить("РежимВыбора", 		Истина);
	СтруктураПараметров.Вставить("МножественныйВыбор", 	Ложь);
	СтруктураПараметров.Вставить("Отбор", 				Отбор);
	
	ИмяОбъекта = ПолучитьИмяОбъектаПоТипуНаСервере(ТипОбъекта);  
	ОткрытьФорму("Документ."+ИмяОбъекта+".ФормаВыбора",СтруктураПараметров, ЭтаФорма,,,,ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры         

&НаСервере
Функция ПолучитьИмяОбъектаПоТипуНаСервере(Знач Тип)
	
	ПолноеИмя  = Метаданные.НайтиПоТипу(Тип).ПолноеИмя();
	ИмяОбъекта = СтрРазделить(ПолноеИмя, ".")[1];
	
	Возврат ИмяОбъекта;
	
КонецФункции  

&НаСервере
Функция ПолучитьОграниченияТипа()
	
	ОграничениеТипа = Новый Массив; 
	Если ТипЗнч(ДокументВыписки) = Тип("ДокументСсылка.СписаниеСРасчетногоСчета") Тогда
		ОграничениеТипа.Добавить(Тип("ДокументСсылка.CW_ДоходыПоГрузоперевозке"));  
	КонецЕсли;
	
	Если ТипЗнч(ДокументВыписки) = Тип("ДокументСсылка.ПоступлениеНаРасчетныйСчет") Тогда
		ОграничениеТипа.Добавить(Тип("ДокументСсылка.CW_РасходыПоГрузоперевозке"));  
	КонецЕсли;
	
	ОграничениеТипа.Добавить(Тип("ДокументСсылка.CW_Оплата"));
	
	Возврат ОграничениеТипа;
	
КонецФункции

&НаКлиенте
Процедура ОбработатьВыборДокументов(РезультатВыбора, ДополнительныеПараметры) Экспорт
	Если РезультатВыбора = Неопределено Тогда
		Возврат;
	КонецЕсли;  
	
	МассивДобавленныхСтрок = ОбработатьВыборДокументовНаСервере(РезультатВыбора, ДополнительныеПараметры);
	
	РазвернутьДерево(МассивДобавленныхСтрок);
   	ПересчитатьИтоги();
	
КонецПроцедуры

&НаКлиенте
Процедура РазвернутьДерево(МассивДобавленныхСтрок)
	
	Для Каждого СтрокаДерева из МассивДобавленныхСтрок Цикл
		Элементы.ДеревоЗначений.Развернуть(СтрокаДерева, Истина);          
	КонецЦикла;

КонецПроцедуры  

&НаСервере
Функция ОбработатьВыборДокументовНаСервере(РезультатВыбора, ДополнительныеПараметры) 

	МассивДобавленныхСтрок = Новый Массив;
	
	Если РезультатВыбора = Неопределено Тогда
		Возврат МассивДобавленныхСтрок;
	КонецЕсли;  
	
	ДеревоФормы 	= РеквизитФормыВЗначение("ДеревоЗначений");
	ЭлементыДерева 	= ДеревоЗначений.ПолучитьЭлементы();  
	ДеревоСчетов 	= ПодготовитьДеревоДляЗаполнения(РезультатВыбора, ДополнительныеПараметры);  
	
	Для Каждого СтрокаДерва из ДеревоСчетов.Строки Цикл 
		
		Отбор = Новый Структура("ДокументВзаиморасчетов", СтрокаДерва.ДокументВзаиморасчетов);
		НайденныеСтроки = ДеревоФормы.Строки.НайтиСтроки(Отбор, Ложь);  
		Если НайденныеСтроки.Количество() > 0 Тогда 
			//Этот счет уже есть в списке, пока пропускаем всю ветку
			Продолжить;
		КонецЕсли;
		
		НоваяСтрокаДерева = ЭлементыДерева.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрокаДерева, СтрокаДерва);  
		
		МассивДобавленныхСтрок.Добавить(НоваяСтрокаДерева.ПолучитьИдентификатор());
		
		Если СтрокаДерва.Строки.Количество() > 0 Тогда
			//Тут просто добавляем	
			СписокПодчиненныхЭлементов = НоваяСтрокаДерева.ПолучитьЭлементы(); 
			Для Каждого СтрокаВторогоУровня из СтрокаДерва.Строки Цикл
				ПодчиненнаяСтрока = СписокПодчиненныхЭлементов.Добавить();
				ЗаполнитьЗначенияСвойств(ПодчиненнаяСтрока, СтрокаВторогоУровня);     
			КонецЦикла;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат МассивДобавленныхСтрок;
	
КонецФункции  

&НаСервере
Функция ПодготовитьДеревоДляЗаполнения(РезультатВыбора, ДополнительныеПараметры) 
	
	ДатаСреза 		= ?(ЗначениеЗаполнено(ДатаДокумента), ДатаДокумента, ТекущаяДата());  
	КурсВалюты 		= CW_Финансы.ПолучитьКурсВалюты(ВалютаРегламентированногоУчета, ДатаСреза);
	ДеревоСчетов 	= ПолучитьПустоеДерево();
	
	Если ДополнительныеПараметры.ТипОбъекта = Тип("ДокументСсылка.CW_ДоходыПоГрузоперевозке") Тогда 
		ПодготовитьДеревоОплатПоДоходамПоГрузоперевозке(РезультатВыбора, ДеревоСчетов, КурсВалюты, ДатаСреза);
	КонецЕсли;
	
	Если ДополнительныеПараметры.ТипОбъекта = Тип("ДокументСсылка.CW_РасходыПоГрузоперевозке") Тогда 
		ПодготовитьДеревоОплатПоРасходамПоГрузоперевозке(РезультатВыбора, ДеревоСчетов, КурсВалюты, ДатаСреза);
	КонецЕсли;
	
	Если ДополнительныеПараметры.ТипОбъекта = Тип("ДокументСсылка.CW_Оплата") Тогда
		ПодготовитьДеревоПоОплате(РезультатВыбора, ДеревоСчетов);
	КонецЕсли;
	
	Возврат ДеревоСчетов;
	
КонецФункции

&НаСервере
Процедура ПодготовитьДеревоПоОплате(Знач РезультатВыбора,  ДеревоСчетов)
	
	Запрос = Новый Запрос;  
	
	Если ТипЗнч(ДокументВыписки) = Тип("ДокументСсылка.СписаниеСРасчетногоСчета") Тогда
		ЗапросТекст = "ВЫБРАТЬ
		|	CW_ОперативнаяДебиторскаяЗадолженностьОбороты.Счет КАК Счет,
		|	CW_ОперативнаяДебиторскаяЗадолженностьОбороты.СчетУчета КАК СчетУчета,
		|	CW_ОперативнаяДебиторскаяЗадолженностьОбороты.Счет.Основание КАК СчетОснование,
		|	CW_ОперативнаяДебиторскаяЗадолженностьОбороты.Всего_ВалютаРасход КАК ВсегоВалюта,
		|	CW_ОперативнаяДебиторскаяЗадолженностьОбороты.ВсегоРасход КАК Всего
		|ИЗ
		|	РегистрНакопления.CW_ОперативнаяДебиторскаяЗадолженность.Обороты(, , Период, Счет В (&РезультатВыбора)) КАК CW_ОперативнаяДебиторскаяЗадолженностьОбороты";
	КонецЕсли; 
	
	Если ТипЗнч(ДокументВыписки) = Тип("ДокументСсылка.ПоступлениеНаРасчетныйСчет") Тогда
		ЗапросТекст = "ВЫБРАТЬ
		|	CW_ОперативнаяКредиторскаяЗадолженностьОбороты.Счет КАК Счет,
		|	CW_ОперативнаяКредиторскаяЗадолженностьОбороты.СчетУчета КАК СчетУчета,
		|	CW_ОперативнаяКредиторскаяЗадолженностьОбороты.Счет.Основание КАК СчетОснование,
		|	CW_ОперативнаяКредиторскаяЗадолженностьОбороты.Всего_ВалютаРасход КАК ВсегоВалюта,
		|	CW_ОперативнаяКредиторскаяЗадолженностьОбороты.ВсегоРасход КАК Всего
		|ИЗ
		|	РегистрНакопления.CW_ОперативнаяКредиторскаяЗадолженность.Обороты(, , Период, Счет В (&РезультатВыбора)) КАК CW_ОперативнаяКредиторскаяЗадолженностьОбороты";
	КонецЕсли;  
	
	Если ЗапросТекст = Неопределено Тогда
		ВызватьИсключение "Не удалось опредеить вид оперативной задолженности!";
	КонецЕсли;
	
	Запрос.Текст = ЗапросТекст;

	Запрос.УстановитьПараметр("РезультатВыбора", РезультатВыбора);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Если ОбщегоНазначения.ЕстьРеквизитОбъекта("ПредставлениеДокумента", Выборка.Счет.Метаданные()) Тогда
			ПредставлениеДокумента = Выборка.Счет.ПредставлениеДокумента;
		Иначе
			ПредставлениеДокумента = СокрЛП(Выборка.Счет);
		КонецЕсли;
		
		НоваяСтрокаСчет = ДеревоСчетов.Строки.Добавить();
		НоваяСтрокаСчет.ДокументВзаиморасчетов 	= Выборка.Счет;
		НоваяСтрокаСчет.ПредставлениеДокумента 	= ПредставлениеДокумента;
		НоваяСтрокаСчет.СчетЗадолженности      	= Выборка.СчетУчета;
		НоваяСтрокаСчет.СуммаВал               	= Выборка.ВсегоВалюта;
		//НоваяСтрокаСчет.Сделка                = ВыборкаСчет.Документ.ВедомыйСчет;
		//НоваяСтрокаСчет.СтавкаНДС    			= Неопределено;
		НоваяСтрокаСчет.Сумма 					= Выборка.Всего; 
		
		НоваяСтрокаСчет.Курс = 1;
		Если НоваяСтрокаСчет.СуммаВал <> 0 Тогда
			НоваяСтрокаСчет.Курс = НоваяСтрокаСчет.Сумма / НоваяСтрокаСчет.СуммаВал;
		КонецЕсли;
		
		СтрокаВторогоУровня = НоваяСтрокаСчет.Строки.Добавить();
		СтрокаВторогоУровня.ИндексКартинки 			= 1;
		СтрокаВторогоУровня.ДокументВзаиморасчетов 	= Выборка.Счет;
		СтрокаВторогоУровня.ПредставлениеДокумента 	= ПредставлениеДокумента;
		СтрокаВторогоУровня.СчетЗадолженности      	= Выборка.СчетУчета;
		СтрокаВторогоУровня.СуммаВал               	= Выборка.ВсегоВалюта;
		СтрокаВторогоУровня.Сделка                  = Выборка.СчетОснование;
		//СтрокаВторогоУровня.СтавкаНДС    			= Неопределено;
		СтрокаВторогоУровня.Сумма 					= Выборка.Всего; 
		
		СтрокаВторогоУровня.Курс = 1;
		Если СтрокаВторогоУровня.СуммаВал <> 0 Тогда
			СтрокаВторогоУровня.Курс = СтрокаВторогоУровня.Сумма / СтрокаВторогоУровня.СуммаВал;
		КонецЕсли;
		
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ПодготовитьДеревоОплатПоДоходамПоГрузоперевозке(Знач РезультатВыбора, ДеревоСчетов, Знач КурсВалюты, Знач ДатаСреза)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	CW_ОплатаИсходящихДокументов.Документ КАК Документ,
	|	CW_ОплатаИсходящихДокументов.ДокументБУ КАК ДокументБУ,
	|	CW_ОплатаИсходящихДокументов.ДокументОплаты КАК ДокументОплаты,
	|	CW_ОплатаИсходящихДокументов.СчетЗадолженности КАК СчетЗадолженности,
	|	CW_ОплатаИсходящихДокументов.Всего КАК Всего,
	|	CW_ОплатаИсходящихДокументов.ПризнакАкта КАК ПризнакАкта
	|ПОМЕСТИТЬ ВТ_ДанныеРегистра
	|ИЗ
	|	РегистрСведений.CW_ОплатаИсходящихДокументов КАК CW_ОплатаИсходящихДокументов
	|ГДЕ
	|	CW_ОплатаИсходящихДокументов.Документ В(&РезультатВыбора)
	|	И CW_ОплатаИсходящихДокументов.Регистратор <> &ОплатаСсылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ДанныеРегистра.Документ КАК Документ,
	|	ВТ_ДанныеРегистра.ДокументБУ КАК ДокументБУ,
	|	ВТ_ДанныеРегистра.ДокументОплаты КАК ДокументОплаты,
	|	ВТ_ДанныеРегистра.СчетЗадолженности КАК СчетЗадолженности,
	|	ВТ_ДанныеРегистра.Всего КАК Всего
	|ПОМЕСТИТЬ ВТ_Акты
	|ИЗ
	|	ВТ_ДанныеРегистра КАК ВТ_ДанныеРегистра
	|ГДЕ
	|	ВТ_ДанныеРегистра.ПризнакАкта = ИСТИНА
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Акты.Документ КАК Документ,
	|	ВТ_Акты.ДокументБУ КАК ДокументБУ,
	|	ВТ_Акты.ДокументОплаты КАК ДокументОплаты,
	|	ВТ_Акты.СчетЗадолженности КАК СчетЗадолженности,
	|	ВТ_Акты.Всего КАК Всего
	|ИЗ
	|	ВТ_Акты КАК ВТ_Акты
	|ИТОГИ
	|	СУММА(Всего)
	|ПО
	|	Документ,
	|	СчетЗадолженности
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ДанныеРегистра.Документ КАК Документ,
	|	ВТ_ДанныеРегистра.ДокументОплаты КАК ДокументБУ,
	|	ВТ_ДанныеРегистра.СчетЗадолженности КАК СчетЗадолженности,
	|	ВТ_ДанныеРегистра.Всего КАК Всего
	|ИЗ
	|	ВТ_ДанныеРегистра КАК ВТ_ДанныеРегистра
	|ГДЕ
	|	ВТ_ДанныеРегистра.ПризнакАкта = ЛОЖЬ
	|	И ВТ_ДанныеРегистра.ДокументОплаты ССЫЛКА Документ.CW_Оплата
	|	И НЕ ВТ_ДанныеРегистра.Документ В
	|				(ВЫБРАТЬ
	|					ВТ_Акты.Документ КАК Документ
	|				ИЗ
	|					ВТ_Акты КАК ВТ_Акты)";
	
	Запрос.УстановитьПараметр("РезультатВыбора", РезультатВыбора);
	Запрос.УстановитьПараметр("ОплатаСсылка", 	 ОплатаСсылка); 
	
	ПакетРезультатовЗапроса = Запрос.ВыполнитьПакет();  
	
	РезультатЗапроса 		= ПакетРезультатовЗапроса[2];
	
	ВыборкаСчетЗадолженности = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаСчетЗадолженности.Следующий() Цикл 
		
		ВыборкаСчет = ВыборкаСчетЗадолженности.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаСчет.Следующий() Цикл     
			
			ВалютаСчета		= ВыборкаСчет.Документ.Валюта;
			КурсВалютыСчета	= CW_Финансы.ПолучитьКурсВалюты(ВалютаСчета, ДатаСреза); 
			
			Если ОбщегоНазначения.ЕстьРеквизитОбъекта("ПредставлениеДокумента", ВыборкаСчет.Документ.Метаданные()) Тогда
				ПредставлениеДокумента = ВыборкаСчет.Документ.ПредставлениеДокумента;
			Иначе
				ПредставлениеДокумента = СокрЛП(ВыборкаСчет.Документ);
			КонецЕсли;
			
			НоваяСтрокаСчет = ДеревоСчетов.Строки.Добавить();
			НоваяСтрокаСчет.ДокументВзаиморасчетов 	= ВыборкаСчет.Документ;
			НоваяСтрокаСчет.ПредставлениеДокумента 	= ПредставлениеДокумента;
			НоваяСтрокаСчет.СчетЗадолженности      	= ВыборкаСчет.СчетЗадолженности;
			НоваяСтрокаСчет.СуммаВал               	= ВыборкаСчет.Всего;
			//НоваяСтрокаСчет.Сделка                = ВыборкаСчет.Документ.ВедомыйСчет;
			//НоваяСтрокаСчет.СтавкаНДС    			= Неопределено;
			НоваяСтрокаСчет.Сумма 					= CW_Финансы.ПересчитатьИзВалютыВВалюту(
														ВыборкаСчет.Всего, 
														ВалютаСчета, 
														ВалютаРегламентированногоУчета, 
														КурсВалютыСчета.Курс, 
														КурсВалюты.Курс, 
														КурсВалютыСчета.Кратность, 
														КурсВалюты.Кратность);  
			
			НоваяСтрокаСчет.Курс = 1;
			Если НоваяСтрокаСчет.СуммаВал <> 0 Тогда
				НоваяСтрокаСчет.Курс = НоваяСтрокаСчет.Сумма / НоваяСтрокаСчет.СуммаВал;
			КонецЕсли;
			
			ВыборкаАкт = ВыборкаСчет.Выбрать();
			Пока ВыборкаАкт.Следующий() Цикл  
				
				Если ОбщегоНазначения.ЕстьРеквизитОбъекта("ПредставлениеДокумента", ВыборкаАкт.ДокументБУ.Метаданные()) Тогда
					ПредставлениеДокумента = ВыборкаАкт.ДокументБУ.ПредставлениеДокумента;
				Иначе
					ПредставлениеДокумента = СокрЛП(ВыборкаАкт.ДокументБУ);
				КонецЕсли;
				
				СтрокаВторогоУровня = НоваяСтрокаСчет.Строки.Добавить();
				СтрокаВторогоУровня.ИндексКартинки 			= 1;
				СтрокаВторогоУровня.ПредставлениеДокумента 	= ПредставлениеДокумента;
				СтрокаВторогоУровня.ДокументВзаиморасчетов 	= ВыборкаАкт.ДокументБУ;
				СтрокаВторогоУровня.СчетЗадолженности      	= ВыборкаАкт.СчетЗадолженности;
				СтрокаВторогоУровня.СуммаВал               	= ВыборкаАкт.Всего;
				СтрокаВторогоУровня.Сделка                 	= ВыборкаАкт.ДокументБУ.ВедомыйДокумент;
				//СтрокаВторогоУровня.СтавкаНДС    			= Неопределено;
				СтрокаВторогоУровня.Сумма = CW_Финансы.ПересчитатьИзВалютыВВалюту(
												ВыборкаАкт.Всего, 
												ВалютаСчета, 
												ВалютаРегламентированногоУчета, 
												КурсВалютыСчета.Курс, 
												КурсВалюты.Курс, 
												КурсВалютыСчета.Кратность, 
												КурсВалюты.Кратность);    
				
				СтрокаВторогоУровня.Курс = 1;
				Если СтрокаВторогоУровня.СуммаВал <> 0 Тогда
					СтрокаВторогоУровня.Курс = СтрокаВторогоУровня.Сумма / СтрокаВторогоУровня.СуммаВал;
				КонецЕсли;
				
			КонецЦикла; 
			
		КонецЦикла;
		
	КонецЦикла;  
	
	РезультатЗапросаОплаты 	= ПакетРезультатовЗапроса[3]; 
	ВыборкаОплаты = РезультатЗапросаОплаты.Выбрать();
	Пока ВыборкаОплаты.Следующий() Цикл 
		
		ВалютаСчета		= ВыборкаОплаты.Документ.Валюта;
		КурсВалютыСчета	= CW_Финансы.ПолучитьКурсВалюты(ВалютаСчета, ДатаСреза); 
		
		Если ОбщегоНазначения.ЕстьРеквизитОбъекта("ПредставлениеДокумента", ВыборкаОплаты.Документ.Метаданные()) Тогда
			ПредставлениеДокумента = ВыборкаОплаты.Документ.ПредставлениеДокумента;
		Иначе
			ПредставлениеДокумента = СокрЛП(ВыборкаОплаты.Документ);
		КонецЕсли;   
		
		НоваяСтрокаСчет = ДеревоСчетов.Строки.Добавить();
		НоваяСтрокаСчет.ДокументВзаиморасчетов 	= ВыборкаОплаты.Документ;
		НоваяСтрокаСчет.ПредставлениеДокумента 	= ПредставлениеДокумента;
		НоваяСтрокаСчет.СчетЗадолженности      	= ВыборкаОплаты.СчетЗадолженности;
		НоваяСтрокаСчет.СуммаВал               	= ВыборкаОплаты.Всего;
		//НоваяСтрокаСчет.Сделка                = ВыборкаСчет.Документ.ВедомыйСчет;
		//НоваяСтрокаСчет.СтавкаНДС    			= Неопределено;
		НоваяСтрокаСчет.Сумма 					= CW_Финансы.ПересчитатьИзВалютыВВалюту(
														ВыборкаОплаты.Всего, 
														ВалютаСчета, 
														ВалютаРегламентированногоУчета, 
														КурсВалютыСчета.Курс, 
														КурсВалюты.Курс, 
														КурсВалютыСчета.Кратность, 
														КурсВалюты.Кратность);  
														
		НоваяСтрокаСчет.Курс = 1;
		Если НоваяСтрокаСчет.СуммаВал <> 0 Тогда
			НоваяСтрокаСчет.Курс = НоваяСтрокаСчет.Сумма / НоваяСтрокаСчет.СуммаВал;
		КонецЕсли;
		
		Если ОбщегоНазначения.ЕстьРеквизитОбъекта("ПредставлениеДокумента", ВыборкаОплаты.ДокументБУ.Метаданные()) Тогда
			ПредставлениеДокументаБУ = ВыборкаОплаты.ДокументБУ.ПредставлениеДокумента;
		Иначе
			ПредставлениеДокументаБУ = СокрЛП(ВыборкаОплаты.ДокументБУ);
		КонецЕсли;
		
		СтрокаВторогоУровня = НоваяСтрокаСчет.Строки.Добавить();
		СтрокаВторогоУровня.ИндексКартинки 			= 1;
		СтрокаВторогоУровня.ПредставлениеДокумента 	= ПредставлениеДокументаБУ;
		СтрокаВторогоУровня.ДокументВзаиморасчетов 	= ВыборкаОплаты.ДокументБУ;
		СтрокаВторогоУровня.СчетЗадолженности      	= ВыборкаОплаты.СчетЗадолженности;
		СтрокаВторогоУровня.СуммаВал               	= ВыборкаОплаты.Всего;
		СтрокаВторогоУровня.Сделка                 	= ВыборкаОплаты.ДокументБУ.Основание;
		//СтрокаВторогоУровня.СтавкаНДС    			= Неопределено;
		СтрокаВторогоУровня.Сумма = CW_Финансы.ПересчитатьИзВалютыВВалюту(
										ВыборкаОплаты.Всего, 
										ВалютаСчета, 
										ВалютаРегламентированногоУчета, 
										КурсВалютыСчета.Курс, 
										КурсВалюты.Курс, 
										КурсВалютыСчета.Кратность, 
										КурсВалюты.Кратность);    
										СтрокаВторогоУровня.Курс = 1;
										
		Если СтрокаВторогоУровня.СуммаВал <> 0 Тогда
			СтрокаВторогоУровня.Курс = СтрокаВторогоУровня.Сумма / СтрокаВторогоУровня.СуммаВал;
		КонецЕсли;
		
	КонецЦикла;

КонецПроцедуры
 
