#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
Функция Информация() Экспорт 
	
	СтруктураОписания 		= CW_ПодключаемыеКомандыСервер.СведенияОПодключаемомОбъекте();
	СтруктураОписания.Тип 	= CW_ПодключаемыеКомандыСервер.ТипОбработка();
	СтруктураОписания.Вид 	= CW_ПодключаемыеКомандыСервер.ВидОбработкиОбработчикПослеЗаписи();
	
	СтруктураОписания.Наименование 				= "Пример обработчика после записи объекта";
	СтруктураОписания.Описание 					= "Пример обработчика после записи для документов";
	СтруктураОписания.Версия 					= "3.2.0";
	СтруктураОписания.МинимальнаяВерсияМодуля	= "8.3.10.10";
	СтруктураОписания.Настройка 				= Истина;

	//Назначения обработчика
	CW_ПодключаемыеКомандыСервер.УстановитьНазначениеВнешнегоОбъекта(СтруктураОписания, "Документ.CW_ДоходыПоГрузоперевозке");
	CW_ПодключаемыеКомандыСервер.УстановитьНазначениеВнешнегоОбъекта(СтруктураОписания, "Документ.CW_РасходыПоГрузоперевозке");
	
	//Методы обработчика
	CW_ПодключаемыеКомандыСервер.УстановитьМетодыВнешнегоОбъекта(СтруктураОписания, "ПослеЗаписи");
//	CW_ПодключаемыеКомандыСервер.УстановитьМетодыВнешнегоОбъекта(СтруктураОписания, "ОткрытьФорму");
	
	//Формы обработчика
	CW_ПодключаемыеКомандыСервер.УстановитьИмяФормыОбъекта(СтруктураОписания, 			"Форма");
	CW_ПодключаемыеКомандыСервер.УстановитьИмяФормыНастроекОбъекта(СтруктураОписания, 	"ФормаНастроек");
	
	Возврат СтруктураОписания;
	
КонецФункции
#КонецЕсли