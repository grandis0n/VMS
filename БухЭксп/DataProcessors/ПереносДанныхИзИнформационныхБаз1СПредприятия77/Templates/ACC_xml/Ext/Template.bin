	ЗаписатьЭлемент(УзелСвойства, "Значение", Источник);
	ДобавитьПодчиненный(УзелСсылки, УзелСвойства);
	ДобавитьПодчиненный(Приемник, УзелСсылки);
	СтандартнаяОбработка = 0;
