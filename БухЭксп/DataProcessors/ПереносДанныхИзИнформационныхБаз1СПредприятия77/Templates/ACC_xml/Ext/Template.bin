		КоллекцияОбъектов.Цена = Источник.Цена;
		КоллекцияОбъектов.Сумма = Источник.Сумма;
		
		СтавкаНДС = глСтавкаНалога(Источник, "НДС", Источник.Товар);
		Параметры.ПараметрыАлгоритмов.Установить("СтавкаНДС",СтавкаНДС);
