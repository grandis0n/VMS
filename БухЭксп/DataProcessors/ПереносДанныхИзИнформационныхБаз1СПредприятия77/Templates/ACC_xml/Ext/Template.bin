							<ПередВыгрузкой>Если Источник.СводныйСчетФактура = 0 Тогда
	ДокОснование = Источник.ДокументОснование;
Иначе
	Если Источник.КоличествоСтрок() &lt;&gt; 0 Тогда				
		Если Источник.ПолучитьСтрокуПоНомеру(1) = 1 Тогда
			ДокОснование = Источник.СчетФактураОснование;
		КонецЕсли;
	Иначе
		Отказ = 1;
	КонецЕсли;
КонецЕсли;

Если Отказ = 0 Тогда
	
	ТекущийКонтрагент = "";
	
	Если ДокОснование.Вид() = "СчетФактура" Тогда
		Если ПустоеЗначение(ДокОснование.Грузополучатель) = 0 Тогда
			Если ДокОснование.КонтрагентЯвляетсяОбособленнымПодразделением = 1 Тогда
				ТекущийКонтрагент = ДокОснование.Грузополучатель;
			КонецЕсли;	
		КонецЕсли;	
	ИначеЕсли ПустоеЗначение(ДокОснование) = 0 Тогда
		ДокОснование = ДокОснование.ДокументОснование;
		ОснованиеСчетФактура = 0;
		Пока ОснованиеСчетФактура = 0 Цикл
			Если ПустоеЗначение(ДокОснование) = 1 Тогда
				ОснованиеСчетФактура = 1;
				Прервать;
			ИначеЕсли ДокОснование.Вид() = "СчетФактура" Тогда
				ОснованиеСчетФактура = 1;
				Прервать;
			Иначе
				ДокОснование = ДокОснование.ДокументОснование;
			КонецЕсли;
		КонецЦикла;
		
		Если ДокОснование.Вид() = "СчетФактура" Тогда
			Если ПустоеЗначение(ДокОснование.Грузополучатель) = 0 Тогда				
				Если ДокОснование.КонтрагентЯвляетсяОбособленнымПодразделением = 1 Тогда
					ТекущийКонтрагент = ДокОснование.Грузополучатель;
				КонецЕсли;	
			КонецЕсли;	
		КонецЕсли;	
	КонецЕсли; 
	
	Если ТекущийКонтрагент &lt;&gt; "" Тогда
		Параметры.ПараметрыАлгоритмов.Установить("ТекущийКонтрагент", ТекущийКонтрагент);
		Значение = ПолучитьКППКонтрагента();
	Иначе
		Отказ = 1;
	КонецЕсли;
