			  Если Константа.ОрганизацияЯвляетсяПлательщикомЕНВД = Да Тогда
				  Если (СчетЗатрат = СчетПоКоду("26"))
					  или (СчетЗатрат = СчетПоКоду("44.1.3")) Тогда
					  Значение.Установить("ВидДеятельностиДляНалоговогоУчетаЗатрат","РаспределяемыеЗатраты");
				  ИначеЕсли СчетЗатрат = СчетПоКоду("44.1.2") Тогда
					  Значение.Установить("ВидДеятельностиДляНалоговогоУчетаЗатрат","ОсобыйПорядокНалогообложения");
				  Иначе
					  Значение.Установить("ВидДеятельностиДляНалоговогоУчетаЗатрат","ОсновнаяСистемаНалогообложения");
				  КонецЕсли;
			  Иначе
				  Значение.Установить("ВидДеятельностиДляНалоговогоУчетаЗатрат","ОсновнаяСистемаНалогообложения");
			  КонецЕсли;
			ИмяПКО = "СтатьиЗатрат_Предопределенные";
		ИначеЕсли (ВидСубконто = ВидыСубконто.ПрочиеДоходыИРасходы) Тогда
