								<ПередВыгрузкой>Параметры.ПараметрыАлгоритмов.Установить("СтавкаНДС",ОбъектКоллекции.СтавкаНДС);
ПолучитьСтавкуНДС();
Значение = Параметры.ПараметрыАлгоритмов.Получить("СтавкаНДССтрока");</ПередВыгрузкой>
							</Свойство>
