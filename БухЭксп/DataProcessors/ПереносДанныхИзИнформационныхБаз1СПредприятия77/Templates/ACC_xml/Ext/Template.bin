				<ПередВыгрузкойОбъекта>ЕстьТоварНаКомиссии = 0;
ЕстьСобственныйТовар = 0;

Объект.ВыбратьСтроки();
Пока Объект.ПолучитьСтроку() = 1 Цикл
	Если Объект.Товар.ТипТовара = Перечисление.ТипыТоваров.НаКомиссии Тогда
		ЕстьТоварНаКомиссии = ЕстьТоварНаКомиссии + 1;
	Иначе
		ЕстьСобственныйТовар = ЕстьСобственныйТовар + 1;
	КонецЕсли;	
КонецЦикла;

Если (Объект.ВидПоступления = 1) или (Объект.ВидПоступления = 11) Тогда
	Если ЕстьТоварНаКомиссии = 0 Тогда
		ИмяПКО = "ПоступлениеТоваров_ПТУ";
	Иначе
		Если ЕстьСобственныйТовар &gt; 0 Тогда
			ВыгрузитьПоПравилу(Объект ,,,,"ПоступлениеТоваров_ПТУ");
		КонецЕсли;
		
		Если ЕстьТоварНаКомиссии &gt; 0 Тогда
			ВыгрузитьПоПравилу(Объект ,,,,"ПоступлениеТоваров_ПТУ_Комиссия");
		КонецЕсли;
		
		Отказ = 1;
	КонецЕсли;
ИначеЕсли (Объект.ВидПоступления = 2) или (Объект.ВидПоступления = 12) Тогда
	ИмяПКО = "ПоступлениеТоваров_Возврат_Комиссия";
Иначе
	ИмяПКО = "ПоступлениеТоваров_Возврат";
КонецЕсли;</ПередВыгрузкойОбъекта>
