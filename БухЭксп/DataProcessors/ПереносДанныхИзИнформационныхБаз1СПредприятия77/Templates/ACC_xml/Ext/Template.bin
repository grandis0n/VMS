		ДокументСчетФактура = СчетФактура.ТекущийДокумент();
	КонецЕсли;
КонецЦикла;
Если ПустоеЗначение(ДокументСчетФактура)=0 Тогда
	КоллекцияОбъектов.ВыставленСФ = 1;
	КоллекцияОбъектов.ДатаСФ = ДокументСчетФактура.ДатаДок;
