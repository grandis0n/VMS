		Если ДокОснование.СуммаБезНДС20 &lt;&gt; 0 Тогда
			КоллекцияОбъектов.СтавкаНДСДоИзменения = "НДС18";
			КоллекцияОбъектов.ЦенаДоИзменения = ДокОснование.СуммаБезНДС20;
			КоллекцияОбъектов.СуммаДоИзменения = ДокОснование.СуммаБезНДС20;
			КоллекцияОбъектов.СуммаНДСДоИзменения = ДокОснование.НДС20;
		ИначеЕсли ДокОснование.СуммаБезНДС10 &lt;&gt; 0 Тогда
			КоллекцияОбъектов.СтавкаНДСДоИзменения = "НДС10";
			КоллекцияОбъектов.ЦенаДоИзменения = ДокОснование.СуммаБезНДС10;
			КоллекцияОбъектов.СуммаДоИзменения = ДокОснование.СуммаБезНДС10;
			КоллекцияОбъектов.СуммаНДСДоИзменения = ДокОснование.НДС10;
		ИначеЕсли ДокОснование.СуммаСовсемБезНДС &lt;&gt; 0 Тогда	
			КоллекцияОбъектов.СтавкаНДСДоИзменения = "БезНДС";
			КоллекцияОбъектов.ЦенаДоИзменения = ДокОснование.СуммаСовсемБезНДС;
			КоллекцияОбъектов.СуммаДоИзменения = ДокОснование.СуммаСовсемБезНДС;
			КоллекцияОбъектов.СуммаНДСДоИзменения = ДокОснование.НДС10;
		КонецЕсли;
		
		Если ДокОснование.Вид() = "СчетФактураПолученный" Тогда
			Если ДокОснование.Субсчет19 = СчетПоКоду("19.1") Тогда
				КоллекцияОбъектов.СчетУчетаНДС = "НДСприПриобретенииОсновныхСредств";
			ИначеЕсли ДокОснование.Субсчет19 = СчетПоКоду("19.2") Тогда
				КоллекцияОбъектов.СчетУчетаНДС = "НДСпоПриобретеннымНематериальнымАктивам";
			ИначеЕсли ДокОснование.Субсчет19 = СчетПоКоду("19.3") Тогда
				КоллекцияОбъектов.СчетУчетаНДС = "НДСпоПриобретеннымМПЗ";
			ИначеЕсли ДокОснование.Субсчет19 = СчетПоКоду("19.4") Тогда
				КоллекцияОбъектов.СчетУчетаНДС = "НДСпоПриобретеннымУслугам";	
			КонецЕсли;
		КонецЕсли;	
	ИначеЕсли (ДокОснование.Вид() = "ПоступлениеТоваров") или (ДокОснование.Вид() = "ПоступлениеМатериалов")
		или (ДокОснование.Вид() = "ПоступлениеОС") или (ДокОснование.Вид() = "НМА") 
		или (ДокОснование.Вид() = "ПоступлениеОборудования") или (ДокОснование.Вид() = "УслугиСтороннихОрганизаций") Тогда	
		Если  ДокОснование.ВариантРасчетаНалогов.СтавкаНДС.Ставка = 18 Тогда 
			КоллекцияОбъектов.СтавкаНДСДоИзменения = "НДС18"; 
		ИначеЕсли  ДокОснование.ВариантРасчетаНалогов.СтавкаНДС.Ставка = 10 Тогда
			КоллекцияОбъектов.СтавкаНДСДоИзменения = "НДС10";   
		ИначеЕсли  ДокОснование.ВариантРасчетаНалогов.СтавкаНДС.Ставка = 0 Тогда
			КоллекцияОбъектов.СтавкаНДСДоИзменения = "БезНДС";	
		КонецЕсли;
		
		КоллекцияОбъектов.ЦенаДоИзменения = ДокОснование.Итог("Всего") - ДокОснование.Итог("НДС");
		КоллекцияОбъектов.СуммаДоИзменения = ДокОснование.Итог("Всего") - ДокОснование.Итог("НДС");
		КоллекцияОбъектов.СуммаНДСДоИзменения = ДокОснование.Итог("НДС");
		
		Если (ДокОснование.Вид() = "ПоступлениеТоваров") или (ДокОснование.Вид() = "ПоступлениеМатериалов") Тогда
			КоллекцияОбъектов.СчетУчетаНДС = "НДСпоПриобретеннымМПЗ";
		ИначеЕсли ДокОснование.Вид() = "ПоступлениеОС" Тогда
			КоллекцияОбъектов.СчетУчетаНДС = "НДСприПриобретенииОсновныхСредств";
		ИначеЕсли ДокОснование.Вид() = "ПоступлениеНМА" Тогда
			КоллекцияОбъектов.СчетУчетаНДС = "НДСпоПриобретеннымНематериальнымАктивам";	
		КонецЕсли;
	КонецЕсли;
КонецЕсли;</ПередОбработкойВыгрузки>
