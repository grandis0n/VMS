	Если ТипЗначенияСтр(Счет) = "Счет" Тогда
		Значение = "Прочие налоги и сборы";
		
		Если Счет = СчетПоКоду("68.1") Тогда
			Значение = "НДФЛ при исполнении обязанностей налогового агента";
		ИначеЕсли Счет = СчетПоКоду("68.2") Тогда
			Значение = "НДС";
		ИначеЕсли Счет = СчетПоКоду("68.8") Тогда
			Значение = "Налог на имущество организаций";	
		ИначеЕсли Счет = СчетПоКоду("69.25") Тогда
			Значение = "Страховые взносы в ПФР";
		ИначеЕсли Счет = СчетПоКоду("69.1") Тогда
			Значение = "Страховые взносы в ФСС";	
		ИначеЕсли Счет = СчетПоКоду("69.3.1") Тогда
			Значение = "Страховые взносы в ФФОМС";
		ИначеЕсли Счет = СчетПоКоду("69.11") Тогда
			Значение = "Страховые взносы в ФСС от несчастных случаев";	
		КонецЕсли;	
		
		ИсходящиеДанные = СоздатьОбъект("СписокЗначений");
		ИсходящиеДанные.Установить("Наименование", Значение);
	КонецЕсли;	
