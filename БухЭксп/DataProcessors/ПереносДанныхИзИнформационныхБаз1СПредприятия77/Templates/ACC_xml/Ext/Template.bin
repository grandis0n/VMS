КоллекцияОбъектов.НоваяКолонка("Всего");

Если Источник.СводныйСчетФактура = 0 Тогда
	КоллекцияОбъектов.НоваяСтрока();
	КоллекцияОбъектов.ДокументОснование = Источник;
