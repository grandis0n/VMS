								<ПередВыгрузкой>Значение = ", серия: " + Источник.ДокументСерия + ", № " + Источник.ДокументНомер + ", выдан: "+ Источник.ДокументДатаВыдачи + ", " + Источник.ДокументКемВыдан;</ПередВыгрузкой>
							</Свойство>
