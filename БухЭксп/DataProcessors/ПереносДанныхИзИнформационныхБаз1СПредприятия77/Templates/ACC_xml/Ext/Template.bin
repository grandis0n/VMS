КоллекцияОбъектов.НоваяКолонка("ФизЛицо");

Если ПустоеЗначение(Источник.Председатель)=0 Тогда 
	КоллекцияОбъектов.НоваяСтрока();
	КоллекцияОбъектов.Председатель = 1;
	КоллекцияОбъектов.ФизЛицо = Источник.Председатель;
КонецЕсли;

Для к = 1 по 3 Цикл
