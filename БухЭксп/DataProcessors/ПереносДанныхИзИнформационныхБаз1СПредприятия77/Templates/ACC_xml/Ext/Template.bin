						<ПередОбработкойВыгрузки>Если ПустоеЗначение(ВходящиеДанные.Получить("ДанныеПоНДС")) = 1 Тогда
	Отказ = 1;

ИначеЕсли ВходящиеДанные.Получить("ДанныеПоНДС").КоличествоСтрок() = 0 Тогда
	Отказ = 1;
	
Иначе
