						<Источник Имя="" Вид=""/>
						<Приемник Имя="РасчетыСКонтрагентами" Вид="ТабличнаяЧасть"/>
						<ПередОбработкойВыгрузки>Если (ВходящиеДанные.Получить("РазделУчета") &lt;&gt; "РасчетыСПоставщикамиИПодрядчиками")
	И (ВходящиеДанные.Получить("РазделУчета") &lt;&gt; "РасчетыСПокупателямиИЗаказчиками")
	И (ВходящиеДанные.Получить("РазделУчета") &lt;&gt; "РасчетыСПрочимиДебиторамиИКредиторами") Тогда
	Отказ = 1;
ИначеЕсли ВходящиеДанные.Получить("ВходящиеОстатки").КоличествоСтрок() = 0 Тогда
	Отказ = 1;
Иначе
		
	КоллекцияОбъектов = ВходящиеДанные.Получить("ВходящиеОстатки");	
	ЗаполнитьРеквизитыДокументаВНО();
	ДобавитьСуммыНУПоСчетамРасчетовУЕ();
	ДобавитьСуммыНУПоСчетамРасчетовВАЛ();
	
	КоллекцияОбъектов.НоваяКолонка("КлючПоиска");
	КоллекцияОбъектов.НоваяКолонка("Документ", "Документ");
	КоллекцияОбъектов.НоваяКолонка("ДатаСФ");
	КоллекцияОбъектов.НоваяКолонка("НомерСФ");
	
	Если ВходящиеДанные.Получить("РазделУчета") = "РасчетыСПоставщикамиИПодрядчиками" Тогда
		Если (ВходящиеДанные.Получить("Счет") = СчетПоКоду("60.2"))
			ИЛИ (ВходящиеДанные.Получить("Счет") = СчетПоКоду("60.7"))
			ИЛИ (ВходящиеДанные.Получить("Счет") = СчетПоКоду("60.22")) Тогда
			
			Параметры.ПолучитьТолькоТаблицуНДС = 1;
			Параметры.ПараметрыАлгоритмов.Установить("НДСДатаВыгрузки", Параметры.ДатаВводаОстатков-1);
			Если (ВходящиеДанные.Получить("Дата") =  Параметры.ДатаВводаОстатков-1)  И (Параметры.П_ВыгружатьОбороты = 0) Тогда
				Если Параметры.ТаблицаНДСПоАвансамВыданным.КоличествоКолонок() = 0 Тогда 
					Параметры.ПараметрыАлгоритмов.Установить("НДСДатаВыгрузки", Параметры.ДатаВводаОстатков-1);					
					ДанныеПоНДСпоАвансамВыданным();
				КонецЕсли;
				Если Параметры.ТаблицаНДСПоАвансамВыданным.КоличествоСтрок() &lt;&gt; 0 Тогда
					РаспределитьАвансыВыданные();
				КонецЕсли;
			ИначеЕсли ВходящиеДанные.Получить("Дата") =  Параметры.ДатаОкончанияВыгрузкиОборотов Тогда
				Если Параметры.ТаблицаНДСПоАвансамВыданнымОб.КоличествоКолонок() = 0 Тогда 
					Параметры.ПараметрыАлгоритмов.Установить("НДСДатаВыгрузки", Параметры.ДатаОкончанияВыгрузкиОборотов);					
					ДанныеПоНДСпоАвансамВыданным();
				КонецЕсли;
				Если Параметры.ТаблицаНДСПоАвансамВыданнымОб.КоличествоСтрок() &lt;&gt; 0 Тогда
					ЗарегистрироватьКорректировкуАвансов();
					РаспределитьАвансыВыданные();					
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
	ИначеЕсли ВходящиеДанные.Получить("РазделУчета") = "РасчетыСПокупателямиИЗаказчиками" Тогда
		Если (ВходящиеДанные.Получить("Счет") = СчетПоКоду("62.2"))
			ИЛИ (ВходящиеДанные.Получить("Счет") = СчетПоКоду("62.7"))
			ИЛИ (ВходящиеДанные.Получить("Счет") = СчетПоКоду("62.22")) Тогда
			
			Параметры.ПолучитьТолькоТаблицуНДС = 1;
			Если (ВходящиеДанные.Получить("Дата") =  Параметры.ДатаВводаОстатков-1) И (Параметры.П_ВыгружатьОбороты = 0) Тогда
				Если Параметры.ТаблицаНДСПоАвансамПолученным.КоличествоКолонок() = 0 Тогда 
					Параметры.ПараметрыАлгоритмов.Установить("НДСДатаВыгрузки", Параметры.ДатаВводаОстатков-1);					
					ДанныеПоНДСпоАвансамПолученным();
				КонецЕсли;
				Если Параметры.ТаблицаНДСПоАвансамПолученным.КоличествоСтрок() &lt;&gt; 0 Тогда
					РаспределитьАвансыПолученные();
				КонецЕсли;
			ИначеЕсли ВходящиеДанные.Получить("Дата") =  Параметры.ДатаОкончанияВыгрузкиОборотов Тогда
				Если Параметры.ТаблицаНДСПоАвансамПолученнымОб.КоличествоКолонок() = 0 Тогда 
					Параметры.ПараметрыАлгоритмов.Установить("НДСДатаВыгрузки", Параметры.ДатаОкончанияВыгрузкиОборотов);					
					ДанныеПоНДСпоАвансамПолученным();
				КонецЕсли;
				Если Параметры.ТаблицаНДСПоАвансамПолученнымОб.КоличествоСтрок() &lt;&gt; 0 Тогда					
					ЗарегистрироватьКорректировкуАвансов();
					РаспределитьАвансыПолученные();
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецЕсли;</ПередОбработкойВыгрузки>
