	КонецЕсли;
	
	Таб = СоздатьОбъект("ТаблицаЗначений");
	Объект.ВыгрузитьТабличнуюЧасть(Таб);
    Таб.Свернуть("СчетФактураОснование, СчетФактураДатаИсходногоДокумента, СчетФактураНомерИсходногоДокумента, СчетФактураДатаИсправленияИсходногоДокумента, СчетФактураНомерИсправленияИсходногоДокумента, СчетФактураУчитыватьИсправлениеИсходногоДокумента", "Всего");
	Таб.ВыбратьСтроки();
	Пока Таб.ПолучитьСтроку() = 1 Цикл
		
		ВходящиеДанные.Установить("ИсправляемыйДокумент",Таб.СчетФактураОснование);	
		ВходящиеДанные.Установить("ДокументОснованиеДляКорректировки",Таб.СчетФактураОснование);	
		ВходящиеДанные.Установить("СчетФактураОснование", Таб.СчетФактураОснование);	
		ВходящиеДанные.Установить("Всего", Таб.Всего);	
		
		ВыгрузитьПоПравилу(Объект,,ВходящиеДанные,, "ИсправлениеСчетаФактуры");		
	КонецЦикла;
		
Иначе
		
	Если ПустоеЗначение(Объект.ДокументОснование) = 1 Тогда
		Отказ = 1;
	КонецЕсли;
	
	Если ТипЗначенияСтр(ВходящиеДанные) &lt;&gt; "СписокЗначений" Тогда
		ВходящиеДанные = СоздатьОбъект("СписокЗначений");
	КонецЕсли;
	
	Параметры.ПараметрыАлгоритмов.Установить("КорректировкаДокумент", Объект);
	Параметры.ПараметрыАлгоритмов.Установить("КорректировкаДокументОснование", Объект.ДокументОснование);
	ПолучитьИсправляемыйСчетФактуру();
	ВходящиеДанные.Установить("ДокументОснованиеДляКорректировки",Параметры.ПараметрыАлгоритмов.Получить("ИсправляемыйДокумент"));	
	
	ВходящиеДанные.Установить("ИсправляемыйДокумент",Объект.ДокументОснование);	
	ВходящиеДанные.Установить("СчетФактураОснование", Объект.ДокументОснование);	
	
	ВыгрузитьПоПравилу(Объект,,ВходящиеДанные,, "ИсправлениеСчетаФактуры");
	
КонецЕсли;</ПередВыгрузкойОбъекта>
