							<Свойство>
								<Код>27</Код>
								<Наименование> --&gt; ДоговорКонтрагента</Наименование>
								<Порядок>150</Порядок>
								<Источник Имя="" Вид=""/>
								<Приемник Имя="ДоговорКонтрагента" Вид="Реквизит" Тип="СправочникСсылка.ДоговорыКонтрагентов"/>
								<КодПравилаКонвертации>ДоговорыКонтрагентов                              </КодПравилаКонвертации>
								<ПередВыгрузкой>Параметры.ПараметрыАлгоритмов.Установить("Документ",Источник);
Параметры.ПараметрыАлгоритмов.Установить("Договор",ОбъектКоллекции.ДоговорКонтрагента);
Параметры.ПараметрыАлгоритмов.Установить("Счет",ОбъектКоллекции.СчетУчетаРасчетов);
ОпределитьВидДоговора();</ПередВыгрузкой>
							</Свойство>
							<Свойство>
								<Код>48</Код>
								<Наименование>--&gt; КорДоговорКонтрагента</Наименование>
								<Порядок>200</Порядок>
								<ПолучитьИзВходящихДанных>true</ПолучитьИзВходящихДанных>
								<Источник Имя="" Вид=""/>
								<Приемник Имя="КорДоговорКонтрагента" Вид="Реквизит" Тип="СправочникСсылка.ДоговорыКонтрагентов"/>
								<КодПравилаКонвертации>ДоговорыКонтрагентов                              </КодПравилаКонвертации>
								<ПередВыгрузкой>ВидОперацииПриемника = ВходящиеДанные.Получить("ВидОперации");

Если ВидОперацииПриемника &lt;&gt; "ПереносЗадолженности" Тогда
	ВходящиеДанные.Установить("КорДоговорКонтрагента", ПолучитьПустоеЗначение());
Иначе
	
	Для Сч = 1 По Источник.СчетСписания.КоличествоСубконто() Цикл
		
		ЗначениеСубконтоИсточника = Источник.ПолучитьАтрибут("Субконто"+Сч);
		
		Если ТипЗначенияСтр(ЗначениеСубконтоИсточника) = "Справочник" Тогда
			
			Если ЗначениеСубконтоИсточника.Вид() = "Договры" Тогда
				Прервать;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;	
	
	ВходящиеДанные.Установить("КорДоговорКонтрагента", ЗначениеСубконтоИсточника);
	
КонецЕсли;</ПередВыгрузкой>
