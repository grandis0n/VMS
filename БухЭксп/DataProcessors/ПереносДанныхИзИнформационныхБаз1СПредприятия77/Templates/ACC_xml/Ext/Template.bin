								<Источник Имя="" Вид=""/>
								<Приемник Имя="СчетУчетаРасчетов" Вид="Реквизит" Тип="ПланСчетовСсылка.Хозрасчетный"/>
								<КодПравилаКонвертации>Хозрасчетный                                      </КодПравилаКонвертации>
