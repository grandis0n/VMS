				<ОбъектВыборки>ДокументСсылка.ИнвентаризацияТМЦ</ОбъектВыборки>
				<ПередВыгрузкойОбъекта>Если (Объект.ВидТМЦ=1) или (Объект.ВидТМЦ=3) Тогда
	ИмяПКО = "ИнвентаризацияТМЦ_ТМЦ";
Иначе
	ИмяПКО = "ИнвентаризацияТМЦ_ОС";
