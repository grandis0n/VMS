								<ПередВыгрузкой>Значение = ПолучитьПустоеЗначение();
Для к = 1 по 3 Цикл
	Если Источник.СчетЗатрат.ВидСубконто(к) = ВидыСубконто.СтатьиЗатратНаПроизводство Тогда
		Значение = Источник.ПолучитьАтрибут("Субконто"+строка(к));
