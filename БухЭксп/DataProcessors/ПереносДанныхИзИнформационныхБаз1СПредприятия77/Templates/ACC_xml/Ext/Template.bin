			<Правило Отключить="false">
				<Код>док_РасходнаяНакладная</Код>
				<Наименование>Отгрузка товаров, продукции</Наименование>
				<Порядок>50</Порядок>
				<СпособОтбораДанных>СтандартнаяВыборка</СпособОтбораДанных>
				<ОбъектВыборки>ДокументСсылка.РасходнаяНакладная</ОбъектВыборки>
				<ПередВыгрузкойОбъекта>ЕстьТоварНаКомиссии = 0;
ЕстьСобственныйТовар = 0;

Объект.ВыбратьСтроки();
Пока Объект.ПолучитьСтроку() = 1 Цикл
	Если Объект.Товар.ТипТовара = Перечисление.ТипыТоваров.НаКомиссии Тогда
		ЕстьТоварНаКомиссии = ЕстьТоварНаКомиссии + 1;
	Иначе
		ЕстьСобственныйТовар = ЕстьСобственныйТовар + 1;
	КонецЕсли;	
КонецЦикла;

Если (Объект.ВидОтгрузки = 1) или (Объект.ВидОтгрузки = 11) Тогда
	ИмяПКО = "РасходнаяНакладная_Продажа";
ИначеЕсли (Объект.ВидОтгрузки = 2) или (Объект.ВидОтгрузки = 12) Тогда
	ИмяПКО = "РасходнаяНакладная_Комиссия";
Иначе	
	Если ЕстьТоварНаКомиссии = 0 Тогда
		ИмяПКО = "РасходнаяНакладная_Возврат";
	Иначе
		Если ЕстьСобственныйТовар &gt; 0 Тогда
			ВыгрузитьПоПравилу(Объект ,,,,"РасходнаяНакладная_Возврат");
		КонецЕсли;
		
		Если ЕстьТоварНаКомиссии &gt; 0 Тогда
			ВыгрузитьПоПравилу(Объект ,,,,"РасходнаяНакладная_Возврат_Комиссия");
		КонецЕсли;
		
		Отказ = 1;
	КонецЕсли;
КонецЕсли;</ПередВыгрузкойОбъекта>
