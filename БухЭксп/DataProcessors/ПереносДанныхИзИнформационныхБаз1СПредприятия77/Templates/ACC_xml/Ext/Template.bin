							<Приемник Имя="НачислениеАмортизации" Вид="Реквизит" Тип="Число"/>
							<ПередВыгрузкой>Если Источник.НачислятьАмортизацию =  1 Тогда
	Значение = 1;
Иначе
	Значение = 2;
КонецЕсли;</ПередВыгрузкой>
