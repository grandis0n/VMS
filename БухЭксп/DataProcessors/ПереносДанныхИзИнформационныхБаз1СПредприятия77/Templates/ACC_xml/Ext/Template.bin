КонецЦикла;

// удаление пустых строк
ПроводкиБУ.ВыбратьСтроки();
Пока ПроводкиБУ.ПолучитьСтроку() = 1 Цикл 
	Если (ПустоеЗначение(ПроводкиБУ.СчетДт) = 1) и (ПустоеЗначение(ПроводкиБУ.СчетКт) = 1) Тогда
		ПроводкиБУ.УдалитьСтроку(ПроводкиБУ.НомерСтроки);
	КонецЕсли;	
КонецЦикла;  

ПроводкиНУ.ВыбратьСтроки();
Пока ПроводкиНУ.ПолучитьСтроку() = 1 Цикл 
	Если (ПустоеЗначение(ПроводкиНУ.СчетДт) = 1) и (ПустоеЗначение(ПроводкиНУ.СчетКт) = 1) Тогда
