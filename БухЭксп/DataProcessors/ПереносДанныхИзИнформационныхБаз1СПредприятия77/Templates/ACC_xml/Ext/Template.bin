		ТаблицаНастройкиПараметров.УстановитьЗначение(НС,"Значение",Константа.ПрефиксДляВыгрузкиВ1СБухгалтерию8);
	КонецЕсли;
КонецЕсли;
НС = 0;
Если ТаблицаНастройкиПараметров.НайтиЗначение("ВыгружатьКоды",НС,"Имя") = 1 Тогда
	ТаблицаНастройкиПараметров.УстановитьЗначение(НС,"Значение",Нет)
КонецЕсли;</ПослеЗагрузкиПравилОбмена>
	<ПередВыгрузкойДанных>
