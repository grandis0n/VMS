								<Источник Имя="" Вид=""/>
								<Приемник Имя="ПериодВзаиморасчетов" Вид="Реквизит" Тип="Дата"/>
								<ПередВыгрузкой>Значение = Источник.ДатаДок;</ПередВыгрузкой>
