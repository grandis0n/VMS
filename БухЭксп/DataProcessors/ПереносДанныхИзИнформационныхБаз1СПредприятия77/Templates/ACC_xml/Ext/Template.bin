    Таб.Свернуть("СчетФактураОснование, СчетФактураДатаИсходногоДокумента, СчетФактураНомерИсходногоДокумента, СчетФактураДатаИсправленияИсходногоДокумента, СчетФактураНомерИсправленияИсходногоДокумента, СчетФактураУчитыватьИсправлениеИсходногоДокумента", "Всего");
	Таб.ВыбратьСтроки();
	Пока Таб.ПолучитьСтроку() = 1 Цикл
