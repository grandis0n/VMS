							<Наименование>--&gt; КурсВзаиморасчетов</Наименование>
							<Порядок>700</Порядок>
							<Источник Имя="" Вид=""/>
							<Приемник Имя="КурсВзаиморасчетов" Вид="Реквизит" Тип="Число"/>
							<ПередВыгрузкой>Значение = ?(Источник.Курс=0,1,Источник.Курс);</ПередВыгрузкой>
						</Свойство>
