							<КодПравилаКонвертации>Хозрасчетный                                      </КодПравилаКонвертации>
							<ПередВыгрузкой>	Параметры.ПараметрыАлгоритмов.Установить("Документ", Источник);
	ПолучитьСчетаРасчетовСКонтрагентамиПродажа();
