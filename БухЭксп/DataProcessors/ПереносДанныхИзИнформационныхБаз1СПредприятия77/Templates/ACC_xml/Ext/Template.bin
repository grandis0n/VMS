				<ПередВыгрузкойОбъекта>ВедетсяУчетЗарплаты = ?(Константа.УчетЗарплатыВоВнешнейПрограмме = Перечисление.Булево.Да, 0, 1);
Если Объект.ПорядокВыплаты = 0 Тогда
	Если ВедетсяУчетЗарплаты = 1 Тогда
		ИмяПКО = "ВыплатаЗПКасса";
	Иначе
		ИмяПКО = "ВедомостьНаВыплатуЗарплатыКассаВнешний";
	КонецЕсли;	
Иначе
	Если ВедетсяУчетЗарплаты = 1 Тогда
		ИмяПКО = "ВыплатаЗПБанк";
	Иначе
		ИмяПКО = "ВедомостьНаВыплатуЗарплатыБанкВнешний";
	КонецЕсли;			
КонецЕсли;</ПередВыгрузкойОбъекта>
