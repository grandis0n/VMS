	КоллекцияОбъектов.КурсВзаиморасчетов  = Курс;
	КоллекцияОбъектов.Сумма               = ?(Кратность = 0, 0, Источник.Сумма * Курс / Кратность );
	КоллекцияОбъектов.СуммаВзаиморасчетов = Источник.Сумма;
