НС = 0;
Если ТаблицаНастройкиПараметров.НайтиЗначение("_ВыгружатьПроведенные",НС,"Имя") = 1 Тогда
	ТаблицаНастройкиПараметров.УстановитьЗначение(НС,"Значение",1)
