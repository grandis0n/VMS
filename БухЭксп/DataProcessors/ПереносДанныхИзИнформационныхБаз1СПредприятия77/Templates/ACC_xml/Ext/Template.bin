								<Источник Имя="" Вид=""/>
								<Приемник Имя="КорСчетУчетаРасчетов" Вид="Реквизит" Тип="ПланСчетовСсылка.Хозрасчетный"/>
								<КодПравилаКонвертации>Хозрасчетный                                      </КодПравилаКонвертации>
								<ПередВыгрузкой>ВидОперацииПриемника = ВходящиеДанные.Получить("ВидОперации");

Если ВидОперацииПриемника &lt;&gt; "ПереносЗадолженности" Тогда
	ВходящиеДанные.Установить("КорСчетУчетаРасчетов", ПолучитьПустоеЗначение());
Иначе
	ВходящиеДанные.Установить("КорСчетУчетаРасчетов", Источник.СчетСписания);
КонецЕсли;</ПередВыгрузкой>
