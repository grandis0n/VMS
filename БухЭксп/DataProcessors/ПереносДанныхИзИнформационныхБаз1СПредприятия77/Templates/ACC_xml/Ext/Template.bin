				<ПередОбработкойПравила>//******************** Счет 94 ******************** 
СписокСчетовНУ = "Н16";
СписокСчетовПР = "НПР.94";
СписокСчетовБУ = "94";

Параметры.ПараметрыАлгоритмов.Установить("СписокСчетовБУ", СписокСчетовБУ);
