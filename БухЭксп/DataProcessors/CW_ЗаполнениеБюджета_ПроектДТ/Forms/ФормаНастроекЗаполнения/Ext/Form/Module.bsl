&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Аналитика     = ?(Параметры.Свойство("Заказ"), Параметры.Заказ, Параметры.Грузоперевозка);
	ВерсияБюджета = Параметры.ВерсияБюджета;
	Обработка     = Параметры.Обработка;
	
	СтавкаБезНДС = Перечисления.СтавкиНДС.БезНДС;
	Валюта       = Константы.ВалютаРегламентированногоУчета.Получить();
	
	ПрочитатьНастройкиНаСервере();
	
	Если Не ЗначениеЗаполнено(Организация) Тогда
		Организация = _БЭ.ОсновнаяОрганизация();
	КонецЕсли;
	
	ЗагрузитьТЧ();
		
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии()
	
	ЗаписатьНастройкиНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьТЧ()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	CW_ДТГрузоперевозок.ПроектДТ.НомерГТД КАК НомерГТД,
	|	CW_ДТГрузоперевозок.ПроектДТ.Клиент КАК Клиент,
	|	CW_ДТГрузоперевозок.Номенклатура КАК Номенклатура,
	|	CW_ДТГрузоперевозок.ПроектДТ,
	|	CW_ДТГрузоперевозок.РасчетДТ,
	|	CW_ДТГрузоперевозок.ПроектДТ.Импортер КАК Импортер,
	|	CW_ДТГрузоперевозок.ПроектДТ.Валюта КАК Валюта,
	|	CW_ДТГрузоперевозок.Грузоперевозка КАК Грузоперевозка,
	|	СУММА(CW_ДТГрузоперевозок.ВсегоРуб) КАК ВсегоРуб,
	|	СУММА(CW_ДТГрузоперевозок.НетарифкаРуб) КАК НетарифкаРуб,
	|	СУММА(CW_ДТГрузоперевозок.БрокерскиеУслугиРуб) КАК БрокерскиеУслугиРуб
	|ПОМЕСТИТЬ ВТ_Грузоперевозки
	|ИЗ
	|	РегистрСведений.CW_ДТГрузоперевозок КАК CW_ДТГрузоперевозок
	|ГДЕ
	|	CW_ДТГрузоперевозок.ПроектДТ.Аналитика = &Аналитика
	|
	|СГРУППИРОВАТЬ ПО
	|	CW_ДТГрузоперевозок.ПроектДТ.НомерГТД,
	|	CW_ДТГрузоперевозок.ПроектДТ.Валюта,
	|	CW_ДТГрузоперевозок.ПроектДТ.Импортер,
	|	CW_ДТГрузоперевозок.ПроектДТ.Клиент,
	|	CW_ДТГрузоперевозок.Грузоперевозка,
	|	CW_ДТГрузоперевозок.Номенклатура,
	|	CW_ДТГрузоперевозок.РасчетДТ,
	|	CW_ДТГрузоперевозок.ПроектДТ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Грузоперевозки.НомерГТД,
	|	ВТ_Грузоперевозки.Клиент,
	|	ВТ_Грузоперевозки.РасчетДТ,
	|	ВТ_Грузоперевозки.ПроектДТ КАК ПроектДТ,
	|	НЕОПРЕДЕЛЕНО КАК СтавкаНДС,
	|	ВТ_Грузоперевозки.Импортер,
	|	ВТ_Грузоперевозки.Валюта,
	|	ВТ_Грузоперевозки.Грузоперевозка,
	|	СУММА(ВТ_Грузоперевозки.ВсегоРуб) КАК ВсегоРуб,
	|	СУММА(ВТ_Грузоперевозки.НетарифкаРуб) КАК НетарифкаРуб,
	|	ВТ_Грузоперевозки.БрокерскиеУслугиРуб
	|ИЗ
	|	ВТ_Грузоперевозки КАК ВТ_Грузоперевозки
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_Грузоперевозки.Валюта,
	|	ВТ_Грузоперевозки.РасчетДТ,
	|	ВТ_Грузоперевозки.НомерГТД,
	|	ВТ_Грузоперевозки.ПроектДТ,
	|	ВТ_Грузоперевозки.Грузоперевозка,
	|	ВТ_Грузоперевозки.Импортер,
	|	ВТ_Грузоперевозки.Клиент,
	|	ВТ_Грузоперевозки.БрокерскиеУслугиРуб
	|
	|УПОРЯДОЧИТЬ ПО
	|	ПроектДТ
	|АВТОУПОРЯДОЧИВАНИЕ";
	
	Запрос.УстановитьПараметр("Аналитика", Аналитика);
	ТЗ = Запрос.Выполнить().Выгрузить();
		
	КешТаблицаДеклараций.Загрузить(ТЗ);
	
	ТЗ.Свернуть("НомерГТД,Клиент,Импортер,Валюта,ПроектДТ", "ВсегоРуб,НетарифкаРуб");
	
	ТаблицаДеклараций.Загрузить(ТЗ);
	
	Если ТаблицаДеклараций.Количество() = 1 Тогда
		ТаблицаДеклараций[0].Выбрана = Истина;
	КонецЕсли; 
	
//-------------------------------------------------------------------------------------------------------------------
		
КонецПроцедуры	

