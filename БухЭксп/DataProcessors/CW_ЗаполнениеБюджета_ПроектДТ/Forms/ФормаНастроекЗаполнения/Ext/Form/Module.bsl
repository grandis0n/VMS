&НаСервере
Процедура ЗаполнитьВыбранныйПроектНаСервере(Отказ)
	
	Отбор = Новый Структура("Выбрана", Истина);
	НайденныеСтроки = ТаблицаДеклараций.НайтиСтроки(Отбор);
	
	Если НайденныеСтроки.Количество() = 0 Тогда
		Сообщить("Не выбрана таможенная декларация!");
		Отказ = Истина;
		Возврат;
	КонецЕсли; 
	
	ВыбранныйПроектДТ = НайденныеСтроки[0].ПроектДТ;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокСтавокНДСНаСервере()
	
	Отбор = Новый Структура("ПроектДТ", ВыбранныйПроектДТ);
	ТаблицаСтавок = КешТаблицаДеклараций.Выгрузить(Отбор, "СтавкаНДС");
	ТаблицаСтавок.Свернуть("СтавкаНДС");
	
	Для каждого Стр Из ТаблицаСтавок Цикл
		СписокСтавкиНДС.Добавить(Стр.СтавкаНДС);
	КонецЦикла; 
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьБюджетНаСервере()
	
	Отбор = Новый Структура("ПроектДТ", ВыбранныйПроектДТ);
	ТаблицаДляОбхода = КешТаблицаДеклараций.Выгрузить(Отбор); 
	ТаблицаДляОбхода.Свернуть("Грузоперевозка","ВсегоРуб, НетарифкаРуб, БрокерскиеУслугиРуб"); 

	УчитыватьНДСВСебестоимости = CW_Настройки.ПараметрУчетнойПолитики(ТекущаяДата(), Организация, "УчитыватьНДСВСебестоимости");
	
	Для Каждого Стр из ТаблицаДляОбхода Цикл
		
		// Там. платежи
		СтавкаНДСПроцент = _БЭ.ПолучитьСтавкуНДС(СтавкаНДС);
		СуммаВсего = Стр.ВсегоРуб;
		
		Если СуммаВсего = 0 Тогда
			Продолжить;
		КонецЕсли;   
		
		ДанныеКурса = CW_Финансы.ПолучитьКурсВалюты(Валюта.Валюта, ТекущаяДата());
		
		СуммаНДС = 0;
		Сумма    = СуммаВсего - СуммаНДС;

		Спр = Справочники.CW_ПлановыеСтатьиЗатратИДоходов.СоздатьЭлемент();
		Спр.Владелец                = Стр.Грузоперевозка;
		Спр.ВидСтатьиПланирования   = Перечисления.CW_ВидыСтатейПланирования.Расходы;
		Спр.Контрагент              = ТамПлатежи_Контрагент;
		Спр.ВерсияБюджета           = ВерсияБюджета;
		Спр.Валюта                  = Валюта;    
		Спр.УчитыватьНДСВСебестоимости = УчитыватьНДСВСебестоимости;    
		
		Спр.Курс					= ДанныеКурса.Курс;   
		Спр.Кратность				= ДанныеКурса.Кратность;   
		
		Спр.Организация             = Организация;
		Спр.Номенклатура            = ТамПлатежи_Номенклатура;
		Спр.ПорядокОтраженияРасходов= Перечисления.CW_ПорядокОтраженияЗатрат.Затраты;
		Спр.Сумма                   = Сумма;
		Спр.СтавкаНДС               = СтавкаБезНДС;
		Спр.СуммаНДС                = СуммаНДС;
		Спр.СуммаВсего              = СуммаВсего;
		Спр.СуммаРуб                = Сумма;
		Спр.СуммаНДСРуб             = СуммаНДС;		
		Спр.СуммаВсегоРуб           = СуммаВсего;
		
		Попытка
			Спр.Записать();
		Исключение
		КонецПопытки;
		
		// Нетарифка
		Сумма = Стр.НетарифкаРуб;
		
		Если Сумма = 0 Тогда
			Продолжить;
		КонецЕсли; 
		
		СуммаНДС   = 0;
		СуммаВсего = Сумма + СуммаНДС;
		
		Спр = Справочники.CW_ПлановыеСтатьиЗатратИДоходов.СоздатьЭлемент();
		Спр.Владелец                = Стр.Грузоперевозка;
		Спр.ВидСтатьиПланирования   = Перечисления.CW_ВидыСтатейПланирования.Расходы;
		Спр.Контрагент              = Нетарифка_Контрагент;
		Спр.ВерсияБюджета           = ВерсияБюджета;
		Спр.Валюта                  = Валюта; 
		
		Спр.Курс					= ДанныеКурса.Курс;   
		Спр.Кратность				= ДанныеКурса.Кратность; 
		
		Спр.Организация             = Организация;
		Спр.Номенклатура            = Нетарифка_Номенклатура;
		Спр.ПорядокОтраженияРасходов= Перечисления.CW_ПорядокОтраженияЗатрат.Затраты;
		Спр.Сумма                   = Сумма;
		Спр.СтавкаНДС               = СтавкаБезНДС;
		Спр.СуммаНДС                = СуммаНДС;
		Спр.СуммаВсего              = СуммаВсего;
		Спр.СуммаРуб                = Сумма;
		Спр.СуммаНДСРуб             = СуммаНДС;		
		Спр.СуммаВсегоРуб           = СуммаВсего;
		
		Попытка
			Спр.Записать();
		Исключение
		КонецПопытки;
		
		// Брокерские услуги
		Сумма = Стр.БрокерскиеУслугиРуб;
		
		Если Сумма = 0 Тогда
			Продолжить;
		КонецЕсли; 
		
		СуммаНДС   = 0;
		СуммаВсего = Сумма + СуммаНДС;
		
		Спр = Справочники.CW_ПлановыеСтатьиЗатратИДоходов.СоздатьЭлемент();
		Спр.Владелец                = Стр.Грузоперевозка;
		Спр.ВидСтатьиПланирования   = Перечисления.CW_ВидыСтатейПланирования.Расходы;
		Спр.Контрагент              = БрокерскиеУслуги_Контрагент;
		Спр.ВерсияБюджета           = ВерсияБюджета;
		Спр.Валюта                  = Валюта;  
		
		Спр.Курс					= ДанныеКурса.Курс;   
		Спр.Кратность				= ДанныеКурса.Кратность;   

		Спр.Организация             = Организация;
		Спр.Номенклатура            = БрокерскиеУслуги_Номенклатура;
		Спр.ПорядокОтраженияРасходов= Перечисления.CW_ПорядокОтраженияЗатрат.Затраты;
		Спр.Сумма                   = Сумма;
		Спр.СтавкаНДС               = СтавкаБезНДС;
		Спр.СуммаНДС                = СуммаНДС;
		Спр.СуммаВсего              = СуммаВсего;
		Спр.СуммаРуб                = Сумма;
		Спр.СуммаНДСРуб             = СуммаНДС;		
		Спр.СуммаВсегоРуб           = СуммаВсего;
		
		Попытка
			Спр.Записать();
		Исключение
		КонецПопытки;


	КонецЦикла;	
	
КонецПроцедуры

