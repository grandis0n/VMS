&НаКлиенте
Процедура ТаблицаДекларацийВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	СнятьВыделение();
	Элемент.ТекущиеДанные.Выбрана = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаДекларацийВыбранаПриИзменении(Элемент)
	
	СнятьВыделение();
	
	ТекСтрока = Элементы.ТаблицаДеклараций.ТекущиеДанные;
	ТекСтрока.Выбрана = Истина;

КонецПроцедуры

&НаСервере
Функция ПрочитатьНастройкиНаСервере()
	
	Настройки = _ПО.ПолучитьНастройки(Обработка);
	_сф.ст_ЗаполнитьСвойства(ЭтаФорма, _СписокНастроекСтрокой(), Настройки);
		
КонецФункции

&НаСервере
Функция ЗаписатьНастройкиНаСервере()
	
	Попытка
		Настройки = Новый Структура();
		_сф.ст_ДобавитьСвойства(Настройки, _СписокНастроекСтрокой(), ЭтаФорма);
		_ПО.ЗаписатьНастройки(Обработка, ,Настройки);
	    Возврат(Истина);
	Исключение
	    Возврат(Ложь);
	КонецПопытки; 
	
КонецФункции

&НаСервере
Функция _СписокНастроекСтрокой()
	
	СписокНастроек = "Нетарифка_Номенклатура,
					|Нетарифка_Контрагент,
					|ТамПлатежи_Контрагент,
					|ТамПлатежи_Номенклатура,
					|БрокерскиеУслуги_Контрагент,
					|БрокерскиеУслуги_Номенклатура,
					|Организация";
						
	Возврат(СтрЗаменить(СписокНастроек, Символы.ПС, ""));
	
КонецФункции	

&НаСервере
Функция _ПроверитьНастройки()
	
	Рез = Истина;
	
	Если НЕ ЗначениеЗаполнено(Нетарифка_Номенклатура) Тогда
		Сообщить("В настройках не заполнено значение ""Номенклатура <Нетарифка>""");
		Рез = Ложь;
	КонецЕсли;	
	
	Если НЕ ЗначениеЗаполнено(Нетарифка_Контрагент) Тогда
		Сообщить("В настройках не заполнено значение ""Контрагент <Нетарифка>""");
		Рез = Ложь;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ТамПлатежи_Номенклатура) Тогда
		Сообщить("В настройках не заполнено значение ""Номенклатура <Там. платежи>""");
		Рез = Ложь;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ТамПлатежи_Контрагент) Тогда
		Сообщить("В настройках не заполнено значение ""Контрагент <Там. платежи>""");
		Рез = Ложь;
	КонецЕсли;
		
	Возврат Рез;
	
КонецФункции	

//-------------------------------------------------------------------------------------------------------------------

&НаКлиенте
Процедура СнятьВыделение()
	
	Для Каждого Стр из ТаблицаДеклараций Цикл
		Стр.Выбрана = Ложь;
	КонецЦикла;
	
КонецПроцедуры






