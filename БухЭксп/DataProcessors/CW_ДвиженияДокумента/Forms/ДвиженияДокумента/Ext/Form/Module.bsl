	КонецЦикла;
		
КонецПроцедуры

&НаСервере
Функция ВыполнитьЗапросКРегистру(Знач ИмяРегистра,Знач ВидРегистра,Знач РежимОстатки)
	
	Запрос = Новый Запрос;
	Если (ВидРегистра = "Накопления") Тогда
		
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	*,";
		Если (РежимОстатки) Тогда
			Запрос.Текст = Запрос.Текст + "
			|	ВЫБОР
			|		Когда ВидДвижения = Значение(ВидДвиженияНакопления.Приход)
			|			Тогда 1
			|		Иначе 2
			|	Конец Как КодКартинки";
		Иначе
			Запрос.Текст = Запрос.Текст + "
			|	0 Как КодКартинки";
		КонецЕсли;
		Запрос.Текст = Запрос.Текст + "
		|ИЗ
		|	Регистр"+ВидРегистра+"."+ИмяРегистра+"
		|ГДЕ
		|	Регистратор = &Регистратор"; 
		
	ИначеЕсли (ВидРегистра = "Сведений") Тогда
		
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	*
		|ИЗ
		|	Регистр"+ВидРегистра+"."+ИмяРегистра+"
		|ГДЕ
		|	Регистратор = &Регистратор";
		
	ИначеЕсли ВидРегистра = "Бухгалтерии" Тогда
		
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	*
		|ИЗ
		|	Регистр"+ВидРегистра+"."+ИмяРегистра+".ДвиженияССубконто(, , Регистратор = &Регистратор, , )";
        		
	КонецЕсли;	
	Запрос.УстановитьПараметр("Регистратор",Объект.ДокументСсылка);
	// --- 
	Возврат(Запрос.Выполнить());
	
КонецФункции	

