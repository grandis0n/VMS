&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	// --- 
	
	Параметры.Свойство("ДокументСсылка", Объект.ДокументСсылка);
	_СформироватьСписокДоступных();
	_ПоказатьДвижения();
	
	// --- 
КонецПроцедуры

// --- 

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	// --- 

КонецПроцедуры

// --- 

&НаСервере
Процедура _СформироватьСписокДоступных()
	// --- 
	
	Элементы.ДокументСсылка.ВыбиратьТип = Ложь;
	Элементы.ДокументСсылка.СписокВыбора.Очистить();
	Элементы.ДокументСсылка.СписокВыбора.Добавить(Объект.ДокументСсылка);
	
	Если (CW_ПраваДоступа.ДоступныОбъектыБухгалтерии()) Тогда
		
		Если (ТипЗнч(Объект.ДокументСсылка)=Тип("ДокументСсылка.CW_ДоходыПоГрузоперевозке")) Тогда
			
			// проверяем, что заполнены реквизиты
			Если (ЗначениеЗаполнено(Объект.ДокументСсылка.ВедомыйДокумент)) Тогда
				Элементы.ДокументСсылка.СписокВыбора.Добавить(Объект.ДокументСсылка.ВедомыйДокумент);
			КонецЕсли; 
			Если (ЗначениеЗаполнено(Объект.ДокументСсылка.ВедомыйСчетФактура)) Тогда
				Элементы.ДокументСсылка.СписокВыбора.Добавить(Объект.ДокументСсылка.ВедомыйСчетФактура);
			КонецЕсли; 
			
		ИначеЕсли (ТипЗнч(Объект.ДокументСсылка)=Тип("ДокументСсылка.CW_ЗакрытиеГрузоперевозки")) Тогда 
			
			// проверяем, что заполнены реквизиты
			Если (ЗначениеЗаполнено(Объект.ДокументСсылка.ВедомыйДокумент)) Тогда
				Элементы.ДокументСсылка.СписокВыбора.Добавить(Объект.ДокументСсылка.ВедомыйДокумент);
			КонецЕсли; 
			Если (ЗначениеЗаполнено(Объект.ДокументСсылка.ВедомыйСчетФактура)) Тогда
				Элементы.ДокументСсылка.СписокВыбора.Добавить(Объект.ДокументСсылка.ВедомыйСчетФактура);
			КонецЕсли; 
			
		ИначеЕсли (ТипЗнч(Объект.ДокументСсылка)=Тип("ДокументСсылка.CW_РасходыПоГрузоперевозке")) Тогда 
			
			Если (ЗначениеЗаполнено(Объект.ДокументСсылка.ВедомыйДокумент)) Тогда
				Элементы.ДокументСсылка.СписокВыбора.Добавить(Объект.ДокументСсылка.ВедомыйДокумент);
			КонецЕсли;  
			
		КонецЕсли; 
		
	КонецЕсли; 
	
	Если (Элементы.ДокументСсылка.СписокВыбора.Количество() = 1) Тогда
		Элементы.ДокументСсылка.ТолькоПросмотр = Истина;
	Иначе
		Элементы.ДокументСсылка.КнопкаВыпадающегоСписка=Истина;
	КонецЕсли; 
	
	// --- 
КонецПроцедуры

&НаКлиенте
Процедура ДокументСсылкаОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	Объект.ДокументСсылка = ВыбранноеЗначение;
	_ПоказатьДвижения();
	
КонецПроцедуры

&НаСервере
Процедура _ПоказатьДвижения()
	// --- 
	
	ЭтаФорма.Заголовок = "Движения документа: " + Объект.ДокументСсылка;
	Элементы.ГруппаДокумент.Заголовок = Объект.ДокументСсылка.Метаданные().Синоним;
	СформироватьСтатическиеСпискиСервер();
	
	// --- 
КонецПроцедуры
 

// --- 

&НаКлиенте
Процедура Сформировать(Команда)
	
	Если (Объект.ДокументСсылка.Пустая()) Тогда Возврат; КонецЕсли;
	// ---------------------------------------------------------------------------- 
	СформироватьСтатическиеСпискиСервер();
	
КонецПроцедуры

&НаСервере
Процедура СформироватьСтатическиеСпискиСервер()
	
	МассивРеквизитов = Новый Массив;
	МассивУдаляемыхРеквизитов = Новый Массив;
	ВремМассив = ЭтаФорма.ПолучитьРеквизиты();
	ВремМассив.Удалить(0);
	Для Каждого Рекв Из ВремМассив Цикл
		МассивУдаляемыхРеквизитов.Добавить(Рекв.Имя);
	КонецЦикла;
	ИзменитьРеквизиты(,МассивУдаляемыхРеквизитов);
	// --- 
	Для Каждого Движение Из Объект.ДокументСсылка.Метаданные().Движения Цикл
		
		ИмяРегистра = Движение.Имя;
		СинонимРегистра = Движение.Синоним;
		ИмяТЗ = "ТЗ_"+ИмяРегистра;
		// --- 
		Если (Метаданные.РегистрыНакопления.Индекс(Движение)>=0) Тогда 
			ВидРегистра = "Накопления"
		ИначеЕсли (Метаданные.РегистрыСведений.Индекс(Движение)>=0) Тогда 
			ВидРегистра = "Сведений"
		ИначеЕсли (Метаданные.РегистрыРасчета.Индекс(Движение)>=0) Тогда 
			ВидРегистра = "Расчета"
		ИначеЕсли (Метаданные.РегистрыБухгалтерии.Индекс(Движение)>=0) Тогда 
			ВидРегистра = "Бухгалтерии"
		КонецЕсли;
		// --- 
		РежимОстатки = Ложь; 
		Если ВидРегистра = "Накопления" Тогда
			Если Метаданные.РегистрыНакопления[имяРегистра].ВидРегистра = Метаданные.СвойстваОбъектов.ВидРегистраНакопления.Остатки Тогда
				РежимОстатки = Истина;
			Иначе
				РежимОстатки = Ложь;
			КонецЕсли;	
		КонецЕсли;	
		Данные = ВыполнитьЗапросКРегистру(ИмяРегистра,ВидРегистра,РежимОстатки);
		// --- 
		Если Данные.Пустой() Тогда 
			Продолжить; //Если движений нет, то и выводить таблицу не будем
		КонецЕсли;	
		// --- 
		Если Элементы.Найти("Страница_"+ИмяРегистра) = Неопределено Тогда
			//Добавляем страницы
			Стр = Элементы.Добавить("Страница_"+ИмяРегистра,Тип("ГруппаФормы"),Элементы.ГруппаСтраницы);
			Стр.Заголовок = СинонимРегистра;
		КонецЕсли;
		МассивРеквизитов.Очистить();
		//Добавляем реквизиты Формы
		Тип = Новый ОписаниеТипов("ТаблицаЗначений");
		РеквизитФормы = Новый РеквизитФормы(ИмяТЗ,Тип);
		МассивРеквизитов.Добавить(РеквизитФормы);
		//Добавляем колонки таблицы
		Для Каждого ТекСтандРекв Из Движение.СтандартныеРеквизиты Цикл
			РеквизитФормы = Новый РеквизитФормы(ТекСтандРекв.Имя, ТекСтандРекв.Тип, ИмяТЗ, ТекСтандРекв.Имя);
			МассивРеквизитов.Добавить(РеквизитФормы);
		КонецЦикла;
		Для Каждого ТекИзмерение Из Движение.Измерения Цикл
			РеквизитФормы = Новый РеквизитФормы(ТекИзмерение.Имя, ТекИзмерение.Тип, ИмяТЗ, ТекИзмерение.Имя);
			МассивРеквизитов.Добавить(РеквизитФормы);
		КонецЦикла;
		Если ВидРегистра = "Бухгалтерии" Тогда
			
			// добавляем субконто
			КоличествоСубконто = Движение.ПланСчетов.МаксКоличествоСубконто;
			ТипСубконто = Движение.ПланСчетов.ВидыСубконто.Тип;
			Для Индекс=1 По КоличествоСубконто Цикл
				
				РеквизитФормы = Новый РеквизитФормы("СубконтоДт"+Строка(Индекс), ТипСубконто, ИмяТЗ, "Субконто №"+Строка(Индекс)+" (Дт)");
				МассивРеквизитов.Добавить(РеквизитФормы);
				
			КонецЦикла;
			Для Индекс=1 По КоличествоСубконто Цикл
				
				РеквизитФормы = Новый РеквизитФормы("СубконтоКт"+Строка(Индекс), ТипСубконто, ИмяТЗ, "Субконто №"+Строка(Индекс)+" (Кт)");
				МассивРеквизитов.Добавить(РеквизитФормы);
				
			КонецЦикла;
			
			РеквизитФормы = Новый РеквизитФормы(	"СчетДт", 
													Новый ОписаниеТипов("ПланСчетовСсылка.Хозрасчетный"), 
													ИмяТЗ, 
													"Счет Дт");
			МассивРеквизитов.Добавить(РеквизитФормы);
			
			// --- 
			
			РеквизитФормы = Новый РеквизитФормы(	"СчетКт", 
													Новый ОписаниеТипов("ПланСчетовСсылка.Хозрасчетный"), 
													ИмяТЗ, 
													"Счет Кт");
			МассивРеквизитов.Добавить(РеквизитФормы);
			
			// --- 
			
			РеквизитФормы = Новый РеквизитФормы(	"ВалютаДт", 
													Новый ОписаниеТипов("СправочникСсылка.Валюты"), 
													ИмяТЗ, 
													"Валюта Дт");
			МассивРеквизитов.Добавить(РеквизитФормы);
			
			// --- 
			
			РеквизитФормы = Новый РеквизитФормы(	"ВалютаКт", 
													Новый ОписаниеТипов("СправочникСсылка.Валюты"), 
													ИмяТЗ, 
													"Валюта Кт");
			МассивРеквизитов.Добавить(РеквизитФормы);

			// --- 
			
			РеквизитФормы = Новый РеквизитФормы(	"ВалютнаяСуммаДт", 
													Новый ОписаниеТипов("Число",Новый КвалификаторыЧисла(15,2)), 
													ИмяТЗ, 
													"Валютная сумма Дт");
			МассивРеквизитов.Добавить(РеквизитФормы);
			
			// --- 
			
			РеквизитФормы = Новый РеквизитФормы(	"ВалютнаяСуммаКт", 
													Новый ОписаниеТипов("Число",Новый КвалификаторыЧисла(15,2)), 
													ИмяТЗ, 
													"Валютная сумма Кт");
			МассивРеквизитов.Добавить(РеквизитФормы);
			
			// --- 
			
			РеквизитФормы = Новый РеквизитФормы(	"КоличествоДт", 
													Новый ОписаниеТипов("Число",Новый КвалификаторыЧисла(15,3)), 
													ИмяТЗ, 
													"Количество Дт");
			МассивРеквизитов.Добавить(РеквизитФормы);
			
			// --- 
			
			РеквизитФормы = Новый РеквизитФормы(	"КоличествоКт", 
													Новый ОписаниеТипов("Число",Новый КвалификаторыЧисла(15,3)), 
													ИмяТЗ, 
													"Количество Кт");
			МассивРеквизитов.Добавить(РеквизитФормы);
			
			// ---------------------------------------------------------------------------- 
			
			РеквизитФормы = Новый РеквизитФормы(	"СуммаНУДт", 
													Новый ОписаниеТипов("Число",Новый КвалификаторыЧисла(15,2)), 
													ИмяТЗ, 
													"Сумма НУ Дт");
			МассивРеквизитов.Добавить(РеквизитФормы);
			// --- 
			РеквизитФормы = Новый РеквизитФормы(	"СуммаНУКт", 
													Новый ОписаниеТипов("Число",Новый КвалификаторыЧисла(15,2)), 
													ИмяТЗ, 
													"Сумма НУ Кт");
			МассивРеквизитов.Добавить(РеквизитФормы);
			// --- 
			РеквизитФормы = Новый РеквизитФормы(	"СуммаВРДт", 
													Новый ОписаниеТипов("Число",Новый КвалификаторыЧисла(15,2)), 
													ИмяТЗ, 
													"Сумма ВР Дт");
			МассивРеквизитов.Добавить(РеквизитФормы);
			// --- 
			РеквизитФормы = Новый РеквизитФормы(	"СуммаВРКт", 
													Новый ОписаниеТипов("Число",Новый КвалификаторыЧисла(15,2)), 
													ИмяТЗ, 
													"Сумма ВР Кт");
			МассивРеквизитов.Добавить(РеквизитФормы);
			// --- 
			РеквизитФормы = Новый РеквизитФормы(	"СуммаПРДт", 
													Новый ОписаниеТипов("Число",Новый КвалификаторыЧисла(15,2)), 
													ИмяТЗ, 
													"Сумма ПР Дт");
			МассивРеквизитов.Добавить(РеквизитФормы);
			// --- 
			РеквизитФормы = Новый РеквизитФормы(	"СуммаПРКт", 
													Новый ОписаниеТипов("Число",Новый КвалификаторыЧисла(15,2)), 
													ИмяТЗ, 
													"Сумма ПР Кт");
			МассивРеквизитов.Добавить(РеквизитФормы);
			
			
		КонецЕсли;
		Для Каждого ТекРесурс Из Движение.Ресурсы Цикл
			РеквизитФормы = Новый РеквизитФормы(ТекРесурс.Имя, ТекРесурс.Тип, ИмяТЗ, ТекРесурс.Имя);
			МассивРеквизитов.Добавить(РеквизитФормы);
		КонецЦикла;
		Для Каждого ТекРеквизит Из Движение.Реквизиты Цикл
			РеквизитФормы = Новый РеквизитФормы(ТекРеквизит.Имя, ТекРеквизит.Тип, ИмяТЗ, ТекРеквизит.Имя);
			МассивРеквизитов.Добавить(РеквизитФормы);
		КонецЦикла;
		 
		ОписаниеТиповЧисло = Новый ОписаниеТипов("Число",Новый КвалификаторыЧисла(1,0));
		РеквизитФормы = Новый РеквизитФормы("КодКартинки", ОписаниеТиповЧисло, ИмяТЗ, "");
		МассивРеквизитов.Добавить(РеквизитФормы);
		
		ИзменитьРеквизиты(МассивРеквизитов);
		ТЗ = Данные.Выгрузить();
		Попытка
			ТЗ.Сортировать("НомерСтроки Возр");
		Исключение
		    //ОписаниеОшибки()
		КонецПопытки; 
		ЭтаФорма[ИмяТЗ].Загрузить(ТЗ);
		
	КонецЦикла;
	
	Для Каждого Рекв Из МассивУдаляемыхРеквизитов Цикл
		Если (Элементы.Найти(Рекв) <> Неопределено) Тогда
			Элементы.Удалить(Элементы[Рекв]);
		КонецЕсли;	
	КонецЦикла;
	МассивТекущихРеквизитов = Новый Массив;
	ВремМассив = ЭтаФорма.ПолучитьРеквизиты();
	Для Каждого Рекв Из ВремМассив Цикл
		МассивТекущихРеквизитов.Добавить(Рекв.Имя);
	КонецЦикла;
	// --- 
	Для Каждого Движение Из Объект.ДокументСсылка.Метаданные().Движения Цикл
		
		ИмяРегистра = Движение.Имя;	
		СинонимРегистра = Движение.Синоним; 
		ИмяТЗ = "ТЗ_"+ИмяРегистра;
		// --- 
		Если (Метаданные.РегистрыНакопления.Индекс(Движение)>=0) Тогда 
			ВидРегистра = "Накопления"
		ИначеЕсли (Метаданные.РегистрыСведений.Индекс(Движение)>=0) Тогда 
			ВидРегистра = "Сведений"
		ИначеЕсли (Метаданные.РегистрыРасчета.Индекс(Движение)>=0) Тогда 
			ВидРегистра = "Расчета"
		ИначеЕсли (Метаданные.РегистрыБухгалтерии.Индекс(Движение)>=0) Тогда 
			ВидРегистра = "Бухгалтерии"
		КонецЕсли;
		// --- 
		Если (МассивТекущихРеквизитов.Найти(ИмяТЗ) = Неопределено) Тогда Продолжить; КонецЕсли;	
		// --- 
		ТекСтраница = Элементы.Найти("Страница_"+ИмяРегистра);
		ТекСтраница.Заголовок = СинонимРегистра + " (" + ЭтаФорма[ИмяТЗ].Количество()+")";
		// --- 
		КартинкаСтрок = Неопределено;
		Если (Метаданные.РегистрыНакопления.Индекс(Движение)>=0)	Тогда 
			Картинка = БиблиотекаКартинок.РегистрНакопления;
			КартинкаСтрок = БиблиотекаКартинок.CW_ДвиженияРегистров;
		ИначеЕсли (Метаданные.РегистрыСведений.Индекс(Движение)>=0) Тогда 
			Картинка = БиблиотекаКартинок.РегистрСведений;
			КартинкаСтрок = БиблиотекаКартинок.CW_ДвиженияРегистров;
		ИначеЕсли (Метаданные.РегистрыРасчета.Индекс(Движение)>=0) Тогда 
			Картинка = БиблиотекаКартинок.РегистрРасчета;
		ИначеЕсли (Метаданные.РегистрыБухгалтерии.Индекс(Движение)>=0) Тогда 
			Картинка = БиблиотекаКартинок.ПланСчетов;
		КонецЕсли;    
		ТекСтраница.Картинка = Картинка;
		// --- 
		ТаблицаФормы = Элементы.Добавить(ИмяТЗ,Тип("ТаблицаФормы"),ТекСтраница);
		ТаблицаФормы.ПутьКДанным = ИмяТЗ;
		ТаблицаФормы.ПоложениеКоманднойПанели = ПоложениеКоманднойПанелиЭлементаФормы.Нет;
		ТаблицаФормы.ТолькоПросмотр = Истина;
		ТаблицаФормы.ЧередованиеЦветовСтрок = Истина;
		ТаблицаФормы.РежимВыделенияСтроки = РежимВыделенияСтрокиТаблицы.Строка;
		Если (КартинкаСтрок <> Неопределено) Тогда
			
			ТаблицаФормы.КартинкаСтрок = КартинкаСтрок;
			ТаблицаФормы.ПутьКДаннымКартинкиСтроки = ИмяТЗ+".КодКартинки";
		
		КонецЕсли; 
		
		// РЕГИСТР БУХГАЛТЕРИИ
		// ---------------------------------------------------------------------------- 
		Если (ВидРегистра = "Бухгалтерии" И ИмяРегистра = "Хозрасчетный") Тогда
			
			ГруппаПериод = Элементы.Добавить(ИмяТЗ+"ГруппаПериод",Тип("ГруппаФормы"),Элементы[ИмяТЗ]);
			ГруппаПериод.Вид=ВидГруппыФормы.ГруппаКолонок;
			
