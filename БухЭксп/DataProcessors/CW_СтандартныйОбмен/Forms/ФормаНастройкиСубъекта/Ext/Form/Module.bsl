
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Обработка = _сф.ст_ПолучитьСвойство(Параметры,"Объект");
	Обмен = _сф.ст_ПолучитьСвойство(Параметры,"Субъект");
	Если Обмен.Пустая() Тогда
		
		// не передали субъект
		Отказ = Истина;
		Возврат;
		
	КонецЕсли; 
	// ---------------------------------------------------------------------------- 
	
	// формируем заголовок
	ЭтаФорма.Заголовок = "Настройки обмена """+Строка(Обмен)+""""; 
	
	// читаем настройки:
	_ПрочитатьНастройки();
	
	// --- 
	_УправлениеЭлементамиФормы();
	
КонецПроцедуры

