&НаКлиенте
Процедура Записать(Команда)
	
	// записываем настройки
	Если _ЗаписатьНастройки() Тогда
		
		// закрываем форму
		ЭтаФорма.Закрыть();
		
	Иначе
		
		// можем сообщить об ошибке
		// --- 
		
	КонецЕсли; 
	
	
	
КонецПроцедуры

