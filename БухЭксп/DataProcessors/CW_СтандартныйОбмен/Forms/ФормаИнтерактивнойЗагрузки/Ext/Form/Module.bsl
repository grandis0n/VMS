
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Обработка = _сф.ст_ПолучитьСвойство(Параметры,"Объект");
	Обмен = _сф.ст_ПолучитьСвойство(Параметры,"Субъект");
	Если Обмен.Пустая() Тогда
		
		// не передали субъект
		Отказ = Истина;
		Возврат;
		
	КонецЕсли;
	
	// ---------------------------------------------------------------------------- 
	
	СтруктураНастроек = _ПО.ПолучитьНастройкиСубъекта(Обработка,Обмен);
	Настройки.Добавить(СтруктураНастроек);
	
	СтрПараметры = _сф.ст_Создать("Обмен,Синхросоответствие,СоответствиеТипов,ИспользуетсяUID,ОсновнойТипПеревозки");
	СтрПараметры.Обмен = Обмен;
	СтрПараметры.СинхроСоответствие = Новый Соответствие;
	СтрПараметры.СоответствиеТипов = _Объект().СоответствиеМетаданных();
	СтрПараметры.ИспользуетсяUID = Неопределено;
	СтрПараметры.ОсновнойТипПеревозки = _Настройка().Загрузка_ОсновнойТипПеревозки;
	
	ПараметрыЗагрузки.Очистить();
	ПараметрыЗагрузки.Добавить(СтрПараметры);
		
	// --- 
	
	_УправлениеЭлементамиФормы();
	
	// --- 
	
	_ПрочитатьФайлыКаталога();
	
КонецПроцедуры


  

