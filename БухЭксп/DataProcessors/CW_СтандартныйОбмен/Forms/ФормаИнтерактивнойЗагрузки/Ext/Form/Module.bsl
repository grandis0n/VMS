&НаКлиенте
Процедура ТипыОбъектовПриАктивизацииСтроки(Элемент)
	
	Если Элементы.ТипыОбъектов.ТекущаяСтрока <> Неопределено Тогда
		
		ТипОбъекта = Элементы.ТипыОбъектов.ТекущиеДанные.Источник_Тип;
		Отбор = Новый Структура("Источник_Тип",ТипОбъекта);
		Элементы.Синхронизация.ОтборСтрок = Новый ФиксированнаяСтруктура(Отбор);
		
		_ОбработатьАктивизациюТипа(ТипОбъекта);
		
	КонецЕсли; 
	
КонецПроцедуры

&НаСервере
Процедура _ОбработатьАктивизациюТипа(ТипОбъекта)
	// --- 
	
	Типы = _ПараметрыЗагрузки().Типы;
	ТекущийТип = Типы.Получить(Строка(ТипОбъекта));
	
	// смотрим на синхронизацию
	РазрешенаАвтоматическаяСинхронизация = (Найти(ТекущийТип.Синхронизация,"A") <> 0);
	РазрешенаРучнаяСинхронизация = (Найти(ТекущийТип.Синхронизация,"M") <> 0);
	// --- 
	Элементы.СинхронизацияСинхронизация_СоздатьОбъектСоответствия.Доступность = РазрешенаАвтоматическаяСинхронизация;
	Элементы.СинхронизацияСинхронизация_СоздатьОбъектыСоответствияДляКатегории.Доступность = РазрешенаАвтоматическаяСинхронизация;
	Элементы.СинхронизацияСинхронизация_ВыбратьСоответствие.Доступность = РазрешенаРучнаяСинхронизация;
	
	// --- 
КонецПроцедуры
 

// ---------------------------------------------------------------------------- 

&НаКлиенте
Процедура Синхронизация_СоздатьОбъектСоответствия(Команда)
	
	Если Элементы.Синхронизация.ТекущиеДанные <> Неопределено Тогда
		
		_СоздатьОбъектСоответствия(Элементы.Синхронизация.ТекущаяСтрока,Элементы.ТипыОбъектов.ТекущиеДанные.Источник_Тип);
		
	КонецЕсли; 
	
КонецПроцедуры

&НаСервере
Функция _СоздатьОбъектСоответствия(ИдентификаторСтроки,ТипОбъкта=Неопределено)
	// --- 
	
	Если ТипЗнч(ИдентификаторСтроки) = Тип("Число") Тогда
		
		СинхроСтрока = Объект.Синхронизация.НайтиПоИдентификатору(ИдентификаторСтроки);
		
	Иначе
		
		СинхроСтрока = ИдентификаторСтроки;
		
	КонецЕсли; 
	
	СинхроСтрока.СозданиеНового = Истина;
	СинхроСтрока.Приемник_УИД = CW_Обмены.ПолучитьУИД(Неопределено);
	СинхроСтрока.Синхронизировано = Истина;
	СинхроСтрока.Приемник_Наименование = "< авто >";
	СинхроСтрока.НомерКартинки = 1;
	
	CW_Обмены.ЗаписатьСоответствиеВРегистр(_ПараметрыЗагрузки(),СинхроСтрока);
	
	Если ТипОбъкта <> Неопределено Тогда
		
		_ОбновитьСостояниеСинхронизации(ТипОбъкта);
		
	КонецЕсли; 
	
	// --- 
КонецФункции

// ----------------------------------------------------------------------------  

&НаКлиенте
Процедура Синхронизация_СоздатьОбъектыСоответствияДляКатегории(Команда)
	
	Если Элементы.ТипыОбъектов.ТекущиеДанные <> Неопределено Тогда
		
		_СоздатьОбъектыСоответствия(Элементы.ТипыОбъектов.ТекущиеДанные.Источник_Тип);
		
	КонецЕсли; 
	
КонецПроцедуры

&НаСервере
Функция _СоздатьОбъектыСоответствия(ТипОбъекта)
	// --- 
	
	Отбор = Новый Структура;
	Отбор.Вставить("Источник_Тип",ТипОбъекта);
	Отбор.Вставить("Синхронизировано",Ложь);
	Мстр = Объект.Синхронизация.НайтиСтроки(Отбор);
	
	Если НЕ Мстр.Количество()=0 Тогда
		
		Для каждого СинхроСтрока Из Мстр Цикл
			
			_СоздатьОбъектСоответствия(СинхроСтрока);
			
		КонецЦикла;
		
	КонецЕсли;
	
	_ОбновитьСостояниеСинхронизации(ТипОбъекта);
	
	// --- 
КонецФункции

