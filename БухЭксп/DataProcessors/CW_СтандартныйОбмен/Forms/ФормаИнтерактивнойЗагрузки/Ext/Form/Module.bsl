&НаКлиенте
Процедура СинхронизацияНазад(Команда)
	
	Элементы.ВыборФайлаПродолжить.КнопкаПоУмолчанию=Истина;
	Элементы.Страницы.ТекущаяСтраница=Элементы.СтраницаВыборФайла;
	
КонецПроцедуры

&НаКлиенте
Процедура СинхронизацияПродолжить(Команда)
	
	Ответ = _ПроверитьСинхронизацию();
	Если _УФКС.ВыполненоУспешно(Ответ) Тогда
		
		// можно грузить
		//Элементы.ВыборФайлаПродолжить.КнопкаПоУмолчанию=Истина;
		Элементы.Страницы.ТекущаяСтраница=Элементы.СтраницаЗагрузка;
		Ответ = _ЗагрузитьОбъекты();
		Если НЕ _УФКС.ВыполненоУспешно(Ответ) Тогда
			
			_УФК.ВывестиПредупреждение(_УФКС.ПредставлениеОшибки(Ответ));
			
		КонецЕсли; 
		
	Иначе
		
		_УФК.ВывестиПредупреждение("Синхронизация объектов не закончена.");
		
	КонецЕсли; 
	
КонецПроцедуры

