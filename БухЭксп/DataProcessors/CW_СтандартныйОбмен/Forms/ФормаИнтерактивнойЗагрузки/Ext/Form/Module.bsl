&НаКлиенте
Процедура Синхронизация_УдалитьСинхронизацию(Команда)
	
	Если Элементы.Синхронизация.ТекущиеДанные <> Неопределено Тогда
		
		Ответ = Вопрос("Вы уверены?", РежимДиалогаВопрос.ДаНет) ;
		Если Ответ=КодВозвратаДиалога.Да Тогда
			
			Ответ = _УдалитьСинхронизацию(Элементы.Синхронизация.ТекущаяСтрока);
			Если НЕ _УФКС.ВыполненоУспешно(Ответ) Тогда
				
				_УФК.ВывестиПредупреждение(_УФКС.ПредставлениеОшибки(Ответ));
				
			КонецЕсли; 
			
		КонецЕсли; 
		
	КонецЕсли; 
	
КонецПроцедуры

&НаСервере
Функция _УдалитьСинхронизацию(ИдентификаторСтрокиСинхронизации)
	// --- 
	
	Попытка
		
		СинхроСтрока = Объект.Синхронизация.НайтиПоИдентификатору(ИдентификаторСтрокиСинхронизации);
		// --- 
		
		СинхроСтрока.Приемник_УИД = CW_Обмены.ПолучитьУИД(Неопределено);
		СинхроСтрока.Приемник_Объект = Неопределено;
		СинхроСтрока.Приемник_Наименование = "";
		
		Ответ = CW_Обмены.ЗаписатьСоответствиеВРегистр(_ПараметрыЗагрузки(),СинхроСтрока);
		Если _УФКС.ВыполненоУспешно(Ответ) Тогда
			
			СинхроСтрока.Синхронизировано = Ложь;
			СинхроСтрока.СозданиеНового = Ложь;
			СинхроСтрока.НомерКартинки = 0;
			
			// --- 
			_ОбновитьСостояниеСинхронизации(СинхроСтрока.Источник_Тип);
			// --- 
			Возврат(_УФКС.Ответ());
			
		Иначе
			
			Возврат(_УФКС.Ответ(1,"Ошибка записи в регистр синхронизации: "+_УФКС.ПредставлениеОшибки(Ответ)));
			
		КонецЕсли; 
		
	Исключение
		
		Возврат(_УФКС.Ответ(1,ОписаниеОшибки()));
		
	КонецПопытки;
	
	
	// --- 
КонецФункции

