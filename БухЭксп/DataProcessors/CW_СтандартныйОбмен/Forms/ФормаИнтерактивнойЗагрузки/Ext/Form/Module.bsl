&НаКлиенте
Процедура Синхронизация_ВыбратьСоответствие(Команда)
	
	Если Элементы.ТипыОбъектов.ТекущиеДанные = Неопределено Тогда
		
		Возврат;
		
	КонецЕсли; 
	
	ТипОбъекта = Элементы.ТипыОбъектов.ТекущиеДанные.Источник_Тип;
	// --- 
	Ответ = _ПолучитьФормуВыбора(ТипОбъекта,Элементы.Синхронизация.ТекущаяСтрока);
	Если _УФКС.ВыполненоУспешно(Ответ) Тогда
		
		Попытка
			
			ФормаВыбора = ПолучитьФорму(Ответ.ИмяФормы,_сф.ст_ПолучитьСвойство(Ответ,"ПараметрыФормы"));
			
		Исключение
		    
			_УФК.ВывестиПредупреждение(ОписаниеОшибки());
			
		КонецПопытки; 
		
		// ... (тут можно произвести установку параметров для толстых форм, тип формы в Ответ.ИмяТипа)
 		
		Результат = ФормаВыбора.ОткрытьМодально();
		Если Результат <> Неопределено Тогда
			
			Ответ = _УстановитьСоответствие(Элементы.Синхронизация.ТекущаяСтрока,Результат);
			Если НЕ _УФКС.ВыполненоУспешно(Ответ) Тогда
				
				_УФК.ВывестиПредупреждение("Ошибка: "+_УФКС.ПредставлениеОшибки(Ответ));
				
			КонецЕсли; 		
			
		КонецЕсли; 
		
	Иначе
		
		_УФК.ВывестиПредупреждение(_УФКС.ПредставлениеОшибки(Ответ));
		
	КонецЕсли; 
	
КонецПроцедуры

&НаСервере
Функция _ПолучитьФормуВыбора(ТипОбъекта,ИдентификаторСтрокиСинхронизации)
	// --- 
		
	СФ = _УФКС.Ответ();
	// --- 
	СФ.Вставить("ИмяТипа",ТипОбъекта.Наименование);
	СМ = _ПараметрыЗагрузки().СоответствиеТипов.Получить(СФ.ИмяТипа);
	ИмяМетаданного = СМ.Имя;
	СФ.Вставить("ИмяФормы",ИмяМетаданного+".ФормаВыбора");
	// --- 
	ЕстьПараметры = Ложь;
	ПФ = Новый Структура;
	СинхроСтрока = Объект.Синхронизация.НайтиПоИдентификатору(ИдентификаторСтрокиСинхронизации);
	Если СинхроСтрока.Синхронизировано И НЕ СинхроСтрока.СозданиеНового Тогда
		
		ЕстьПараметры = Истина;
		ПФ.Вставить("ТекущаяСтрока",СинхроСтрока.Приемник_Объект);
		
	КонецЕсли; 
	// --- 
	Если СФ.ИмяТипа = "Справочник.Договоры" Тогда
		
		Ответ = _ДоработатьПараметрыФормыДляДоговора(ПФ,СинхроСтрока);
		Если _УФКС.ВыполненоУспешно(Ответ) Тогда
			
			ЕстьПараметры = Истина;
			
		Иначе
			
			Возврат(_УФКС.Ответ(1,_УФКС.ПредставлениеОшибки(Ответ)));
			
		КонецЕсли; 
		
	КонецЕсли; 
	// --- 
	Если ЕстьПараметры Тогда
		
		СФ.Вставить("ПараметрыФормы",ПФ);
		
	КонецЕсли; 
	// --- 
	Возврат(СФ);
	
	// --- 
КонецФункции

&НаСервере
Функция _ДоработатьПараметрыФормыДляДоговора(ПФ,СинхроСтрока)
	// --- 
	
	Если СинхроСтрока = Неопределено Тогда
		
		Возврат(_УФКС.Ответ(1,"Не найдена строка синхронизации"));
		
	КонецЕсли; 
	
	// ---------------------------------------------------------------------------- 
	
	СПО = Новый Структура("Организация,Контрагент,Валюта,ВидДоговора");
	// --- 
	// необходимо получить прочитанный объект соответствия
	Идентификатор = ?(_ПараметрыЗагрузки().ИспользуетсяUID,СинхроСтрока.Источник_УИД,СинхроСтрока.Источник_СИ);
	СинхроСоответствие = ПолучитьИзВременногоХранилища(_ПараметрыЗагрузки().СинхроСоответствие);
	ХМЛОбъект = СинхроСоответствие.Получить(Строка(Идентификатор));
	Если ХМЛОбъект = Неопределено Тогда
		
		Возврат(_УФКС.Ответ(1,"Ошибка чтения объекта"));
		
	КонецЕсли; 
	// ---------------------------------------------------------------------------- 
	
	// проверяем организацию
	СтрокаСинхронизации = _сф.к_НайтиСтроку(Объект.Синхронизация,_сф.ст_Отбор("Источник_УИД",_ИдентификаторПоСтроке(ХМЛОбъект["Организация"])));
	Если СтрокаСинхронизации.Синхронизировано Тогда
		
		Если СтрокаСинхронизации.ОбъектЗаписан Тогда
			
			СПО.Организация = СтрокаСинхронизации.Приемник_Объект;
			
		КонецЕсли; 
		
	Иначе
		
		Возврат(_УФКС.Ответ(1,"Сначала необходимо синхронизировать организацию """+Строка(СтрокаСинхронизации.Источник_Наименование)+""""));
		
	КонецЕсли; 
	
	// проверяем контрагента
	СтрокаСинхронизации = _сф.к_НайтиСтроку(Объект.Синхронизация,_сф.ст_Отбор("Источник_УИД",_ИдентификаторПоСтроке(ХМЛОбъект["Контрагент"])));
	Если СтрокаСинхронизации.Синхронизировано Тогда
		
		Если СтрокаСинхронизации.ОбъектЗаписан Тогда
			
			СПО.Контрагент = СтрокаСинхронизации.Приемник_Объект;
			
		КонецЕсли; 
		
	Иначе
		
		Возврат(_УФКС.Ответ(1,"Сначала необходимо синхронизировать контрагента """+Строка(СтрокаСинхронизации.Источник_Наименование)+""""));
		
	КонецЕсли; 
	
	// проверяем валюту
	СтрокаСинхронизации = _сф.к_НайтиСтроку(Объект.Синхронизация,_сф.ст_Отбор("Источник_УИД",_ИдентификаторПоСтроке(ХМЛОбъект["Валюта"])));
	Если СтрокаСинхронизации.Синхронизировано Тогда
		
		Если СтрокаСинхронизации.ОбъектЗаписан Тогда
			
			СПО.Валюта = СтрокаСинхронизации.Приемник_Объект;
			
		КонецЕсли; 
		
	Иначе
		
		Возврат(_УФКС.Ответ(1,"Сначала необходимо синхронизировать валюту """+Строка(СтрокаСинхронизации.Источник_Наименование)+""""));
		
	КонецЕсли; 
	
	// ---------------------------------------------------------------------------- 
	
	ПФ.Вставить("Отбор",Новый Структура);
	ПФ.Отбор.Вставить("ВзаиморасчетыВУЕ",ХМЛОбъект["УсловныеЕдиницы"]);
	
	Если СПО.Организация <> Неопределено Тогда
		
		ПФ.Отбор.Вставить("Организация",СПО.Организация);
		
	КонецЕсли; 
	Если СПО.Контрагент <> Неопределено Тогда
		
		ПФ.Отбор.Вставить("Владелец",СПО.Контрагент);
		
	КонецЕсли;
	Если СПО.Валюта <> Неопределено Тогда
		
		ПФ.Отбор.Вставить("ВалютаДоговора",СПО.Валюта);
		
	КонецЕсли;
	
	// ---------------------------------------------------------------------------- 
	Возврат(_УФКС.Ответ());
	
	// --- 
КонецФункции

&НаСервере
Функция _ИдентификаторПоСтроке(СтрокаИдентификатора)
	// --- 
	
	Если _ПараметрыЗагрузки().ИспользуетсяUID Тогда
		
		Возврат(Новый УникальныйИдентификатор(СтрокаИдентификатора));
		
	Иначе
		
		Возврат(СтрокаИдентификатора);
		
	КонецЕсли; 
	
	// --- 
КонецФункции

&НаСервере
Функция _УстановитьСоответствие(ИдентификаторСтрокиСинхронизации,СсылкаСоответствия)
	// --- 
	
	Попытка
		
		СинхроСтрока = Объект.Синхронизация.НайтиПоИдентификатору(ИдентификаторСтрокиСинхронизации);
		// --- 
		
		СинхроСтрока.Приемник_УИД = СсылкаСоответствия.УникальныйИдентификатор();
		СинхроСтрока.Приемник_Объект = СсылкаСоответствия;
		СинхроСтрока.Приемник_Наименование = Строка(СсылкаСоответствия);
		
		Ответ = CW_Обмены.ЗаписатьСоответствиеВРегистр(_ПараметрыЗагрузки(),СинхроСтрока);
		Если _УФКС.ВыполненоУспешно(Ответ) Тогда
			
			СинхроСтрока.Синхронизировано = Истина;
			СинхроСтрока.СозданиеНового = Ложь;
			СинхроСтрока.НомерКартинки = 1;
			
			// --- 
			_ОбновитьСостояниеСинхронизации(СинхроСтрока.Источник_Тип);
			// --- 
			Возврат(_УФКС.Ответ());
			
		Иначе
			
			Возврат(_УФКС.Ответ(1,"Ошибка записи в регистр синхронизации: "+_УФКС.ПредставлениеОшибки(Ответ)));
			
		КонецЕсли; 
		
	Исключение
		
		Возврат(_УФКС.Ответ(1,ОписаниеОшибки()));
		
	КонецПопытки;
	
	// --- 
КонецФункции

// ---------------------------------------------------------------------------- 

&НаКлиенте
Процедура Синхронизация_ОткрытьОбъект(Команда)
	
	Если Элементы.Синхронизация.ТекущаяСтрока <> Неопределено Тогда
		
		Ответ = _ПроверитьВозможностьОткрытияОбъекта(Элементы.Синхронизация.ТекущаяСтрока);
		Если _УФКС.ВыполненоУспешно(Ответ) Тогда
			
			ПоказатьЗначение(,Ответ.Ссылка);
			
		КонецЕсли; 
		
	КонецЕсли; 
	
КонецПроцедуры

&НаСервере
Функция _ПроверитьВозможностьОткрытияОбъекта(ИдентификаторСтрокиСинхронизации)
	// --- 
	
	СинхроСтрока = Объект.Синхронизация.НайтиПоИдентификатору(ИдентификаторСтрокиСинхронизации);
	// --- 
	Если СинхроСтрока.Синхронизировано И НЕ СинхроСтрока.СозданиеНового Тогда
		
		Ответ = _УФКС.Ответ();
		Ответ.Вставить("Ссылка",СинхроСтрока.Приемник_Объект);
		Возврат(Ответ);
		
	Иначе
		
		Возврат(_УФКС.Ответ(1));
		
	КонецЕсли; 
	
	// --- 
КонецФункции

