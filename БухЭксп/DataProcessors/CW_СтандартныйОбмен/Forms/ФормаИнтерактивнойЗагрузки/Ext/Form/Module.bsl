&НаКлиенте
Процедура ВыборФайлаПродолжить(Команда)
	
	// проверяем, выбрана ли строка файла
	Если Элементы.Файлы.ТекущиеДанные <> Неопределено Тогда
		
		// пробуем прочитать файл
		Если _УФКС.ВыполненоУспешно(_ФайлВыбор(Элементы.Файлы.ТекущаяСтрока)) Тогда
			
			Если _УФКС.ВыполненоУспешно(_ПодготовитьТаблицыСинхронизации()) Тогда
				
				Элементы.СинхронизацияПродолжить.КнопкаПоУмолчанию=Истина;
				Элементы.Страницы.ТекущаяСтраница=Элементы.СтраницаСинхронизация;
				
			Иначе
				
				_УФК.ВывестиПредупреждение("Ошибка подготовки таблиц синхронизации");
				Возврат;
				
			КонецЕсли; 
			
		Иначе
			
			_УФК.ВывестиПредупреждение("Ошибка чтения файла.");
			Возврат;
			
		КонецЕсли; 
		
	Иначе
		
		_УФК.ВывестиПредупреждение("Необходимо выбрать файл");
		Возврат;
		
	КонецЕсли; 
	
КонецПроцедуры

