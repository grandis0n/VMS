&НаСервере
Функция _ПрочитатьФайлыКаталога()
	// --- 
	
	Каталог = Настройки.Получить(0).Значение.Загрузка_КаталогЗагрузкиФайлов;
	
	// ---
	
	Попытка
		
		ФайлыКаталога = НайтиФайлы(Каталог,"*.zip",Ложь);
		
	Исключение
		CW_Журнал.ЗаписатьСообщение("Обмен.МИС.Загрузка","error","Ошибка чтения файлов: "+ОписаниеОшибки());
	КонецПопытки;
	
	// --- 
	Файлы.Очистить();
	Для каждого Файл Из ФайлыКаталога Цикл
		
		Нстр = Файлы.Добавить();
		Нстр.ИмяФайла = Файл.Имя;
		Нстр.ПолноеИмяФайла = Файл.ПолноеИмя;
		
	КонецЦикла;

	// --- 
КонецФункции

// ---------------------------------------------------------------------------- 

&НаСервере
Функция _ФайлВыбор(ИдентификаторСтроки)
	// --- 
	
	СтрокаФайла = Файлы.НайтиПоИдентификатору(ИдентификаторСтроки);
	ИмяФайла = СтрокаФайла.ПолноеИмяФайла;
	ЗагружаемыйФайл = ИмяФайла;
	// --- 
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	Ответ = ОбработкаОбъект.ПрочитатьФайл(_ПараметрыЗагрузки(),ИмяФайла);
	ЗначениеВРеквизитФормы(ОбработкаОбъект,"Объект");
	Возврат(Ответ);
	
	// --- 
КонецФункции

&НаСервере
Функция _ПодготовитьТаблицыСинхронизации()
	// --- 
	
	Попытка
		
		ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
		Ответ = ОбработкаОбъект.СинхронизироватьПоРегистру(_ПараметрыЗагрузки());
		Если НЕ _УФКС.ВыполненоУспешно(Ответ) Тогда
			
			Возврат(_УФКС.Ответ(1,"Ошибка синхронизации по регистру: "+_УФКС.ПредставлениеОшибки(Ответ)));
			
		Иначе
			
			ЗначениеВРеквизитФормы(ОбработкаОбъект,"Объект");
			
		КонецЕсли; 
		
		// --- 
		
		//Объект.Синхронизация.Сортировать("КлючСортировки Возр");
		
		// ---------------------------------------------------------------------------- 
		
		ТипыОбъектов.Очистить();
		
		ПЗ = _ПараметрыЗагрузки();
		Типы = ПЗ.Типы;
		СинхронизируемыеТипы = ПЗ.СинхронизируемыеТипы;
		
		Для каждого Стр Из СинхронизируемыеТипы Цикл
			
			Нстр = ТипыОбъектов.Добавить();
			Нстр.ИмяТипа = Типы.Получить(Строка(Стр.Ключ)).Синоним;
			Нстр.Источник_Тип = Стр.Ключ;
			
		КонецЦикла;
		
		_ОбновитьСостояниеСинхронизации();
		
		Возврат(_УФКС.Ответ());		
		
	Исключение
		
		Возврат(_УФКС.Ответ(1,ОписаниеОшибки()));
		
	КонецПопытки; 
	
	// --- 
КонецФункции

&НаСервере
Процедура _ОбновитьСостояниеСинхронизации(ТипОбъекта=Неопределено)
	// --- 
	
	// если передан тип, то обновляем только для заданного типа
	// иначе обновляем для всех типов
	
	Если ТипОбъекта = Неопределено Тогда
		
		ТЗТипов = ТипыОбъектов.Выгрузить(,"Источник_Тип");
		МассивТипов = ТЗТипов.ВыгрузитьКолонку("Источник_Тип");
		
	Иначе
		
		МассивТипов = Новый Массив;
		МассивТипов.Добавить(ТипОбъекта);
		
	КонецЕсли; 
	
	Для каждого ТипОбъекта Из МассивТипов Цикл
		
		// ищем несинхронизированные
		Отбор = _сф.ст_Создать("Источник_Тип,Синхронизировано");
		Отбор.Источник_Тип = ТипОбъекта;
		Отбор.Синхронизировано = Ложь;
		КоличествоНесинхронизированных = Объект.Синхронизация.НайтиСтроки(Отбор).Количество();
		СтрокаТипа = _сф.к_НайтиСтроку(ТипыОбъектов,_сф.ст_Отбор("Источник_Тип",ТипОбъекта));
		Если КоличествоНесинхронизированных <> 0 Тогда
			
			СтрокаТипа.Картинка = 0;
			
		Иначе
			
			СтрокаТипа.Картинка = 1;
			
		КонецЕсли; 
		
	КонецЦикла; 
	
	// --- 
КонецПроцедуры

&НаСервере
Функция _ПроверитьСинхронизацию()
	// --- 
	
	КоличествоНесинхронизированных = Объект.Синхронизация.НайтиСтроки(_сф.ст_Отбор("Синхронизировано",Ложь)).Количество();
	
	Если КоличествоНесинхронизированных = 0 Тогда
		
		Возврат(_УФКС.Ответ());
		
	Иначе
		
		Возврат(_УФКС.Ответ(1));
		
	КонецЕсли; 
	
	// --- 
КонецФункции

&НаСервере
Функция _ЗагрузитьОбъекты()
	// --- 
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	Ответ = ОбработкаОбъект.ЗагрузитьОбъекты(_ПараметрыЗагрузки());
	ЗначениеВРеквизитФормы(ОбработкаОбъект,"Объект");
	// --- 
	// перемещаем файл
	
	Если _УФКС.ВыполненоУспешно(Ответ) Тогда
		
		КаталогПеремещения = _Настройка().Загрузка_КаталогДляУспешных;
		
	Иначе
		
		КаталогПеремещения = _Настройка().Загрузка_КаталогДляОшибочных;
		
	КонецЕсли; 
	
	// перемещаем
	Попытка
		
		ПереместитьФайл(ЗагружаемыйФайл,КаталогПеремещения+"\"+_сф.ф_КороткоеИмяФайла(ЗагружаемыйФайл));
		
	Исключение
		
		Сообщить("Ошибка перемещения файла """+ЗагружаемыйФайл+""" в папку """+КаталогПеремещения+"""");
		
	КонецПопытки;
	
	// --- 
	Если _УФКС.ВыполненоУспешно(Ответ) Тогда
		
		Возврат(_УФКС.Ответ());
		
	Иначе
		
		Возврат(_УФКС.Ответ(1,"Ошибка загрузки: "+_УФКС.ПредставлениеОшибки(Ответ)));
		
	КонецЕсли; 
	
	// --- 
КонецФункции


