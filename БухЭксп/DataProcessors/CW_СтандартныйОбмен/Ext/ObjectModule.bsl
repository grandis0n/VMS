// --- 

Функция СинхронизироватьПоРегистру(ПараметрыЗагрузки) Экспорт 
	
	Попытка
		
		ИспользуетсяUID = ПараметрыЗагрузки.ИспользуетсяUID;
		
		Если ИспользуетсяUID Тогда
			
			Запрос = Новый Запрос;
			Запрос.Текст = "ВЫБРАТЬ
			|	CW_СинхронизацияОбъектов.Приемник_УИД,
			|	CW_СинхронизацияОбъектов.Приемник_Объект,
			|	CW_СинхронизацияОбъектов.флНезавершена,
			|	CW_СинхронизацияОбъектов.ПолитикаСинхронизации
			|ИЗ
			|	РегистрСведений.CW_СинхронизацияОбъектов КАК CW_СинхронизацияОбъектов
			|ГДЕ
			|	CW_СинхронизацияОбъектов.Источник_УИД = &ИдентификаторОбъекта
			|	И CW_СинхронизацияОбъектов.Источник_Идентификатор = &ИнформационнаяБаза";
			
		Иначе
			
			Запрос = Новый Запрос;
			Запрос.Текст = "ВЫБРАТЬ
			|	CW_СинхронизацияОбъектов.Приемник_УИД,
			|	CW_СинхронизацияОбъектов.Приемник_Объект,
			|	CW_СинхронизацияОбъектов.флНезавершена,
			|	CW_СинхронизацияОбъектов.ПолитикаСинхронизации
			|ИЗ
			|	РегистрСведений.CW_СинхронизацияОбъектов КАК CW_СинхронизацияОбъектов
			|ГДЕ
			|	CW_СинхронизацияОбъектов.Источник_СИ = &ИдентификаторОбъекта
			|	И CW_СинхронизацияОбъектов.Источник_Идентификатор = &ИнформационнаяБаза";
			
		КонецЕсли; 
		
		Запрос.УстановитьПараметр("ИнформационнаяБаза", ПараметрыЗагрузки.Обмен);
		
		Для каждого Стр Из Синхронизация Цикл
			
			Если НЕ Стр.Синхронизировано Тогда
				
				Если ИспользуетсяUID Тогда
					
					Запрос.УстановитьПараметр("ИдентификаторОбъекта", Новый УникальныйИдентификатор(Стр.Источник_УИД));
					
				Иначе
					
					Запрос.УстановитьПараметр("ИдентификаторОбъекта", Стр.Источник_СИ);
					
				КонецЕсли; 
				
				ТЗ = Запрос.Выполнить().Выгрузить();
				
				Для Каждого Строка Из ТЗ Цикл
					
					Стр.Приемник_УИД = Строка.Приемник_УИД;
					Стр.Приемник_Объект = Строка.Приемник_Объект;
					Стр.Синхронизировано = Истина;
					Стр.НомерКартинки = ?(Стр.Синхронизировано,1,0); 
					Стр.ПолитикаСинхронизации = Строка.ПолитикаСинхронизации;
					Если Стр.ПолитикаСинхронизации.Пустая() Тогда
						Стр.ПолитикаСинхронизации = Перечисления.CW_ПолитикаСинхронизацииОбъектов.Постоянная;			
					КонецЕсли; 
					
					Если Строка.флНезавершена Тогда
						
						Стр.СозданиеНового = Истина;
						Стр.Приемник_Наименование = "< авто >";
						
					Иначе
						
						Стр.СозданиеНового = Ложь;
						Стр.Приемник_Наименование = Строка(Стр.Приемник_Объект);
						
					КонецЕсли;
					
				КонецЦикла;
				
			КонецЕсли;
			
		КонецЦикла;
		
		Возврат(_УФКС.Ответ());
		
	Исключение
		
		Возврат(_УФКС.Ответ(1,ОписаниеОшибки()));
		
	КонецПопытки; 
	
КонецФункции

// процедура создания объекта соответствия, для автосинхронизации
Процедура УстановитьАвтосинхронизацию(ПараметрыЗагрузки,СинхроСтрока) 
	
	СинхроСтрока.СозданиеНового = Истина;
	СинхроСтрока.Приемник_УИД = CW_Обмены.ПолучитьУИД(Неопределено);
	СинхроСтрока.Синхронизировано = Истина;
	СинхроСтрока.Приемник_Наименование = "< авто >";
	CW_Обмены.ЗаписатьСоответствиеВРегистр(ПараметрыЗагрузки,СинхроСтрока);
	
КонецПроцедуры


