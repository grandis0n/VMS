// информация об обработке
Функция Информация() Экспорт 
	
	СтруктураОписания 		= CW_ПодключаемыеКомандыСервер.СведенияОПодключаемомОбъекте("3.2.0.1");
	СтруктураОписания.Тип 	= CW_ПодключаемыеКомандыСервер.ТипОбработка();
	СтруктураОписания.Вид 	= CW_ПодключаемыеКомандыСервер.ВидОбработкиОбмен();
	
	СтруктураОписания.Наименование 				= "Стандартный обмен";
	СтруктураОписания.Описание 					= "Стандартный обмен с Бухгалтерией экспедитора";
	
	СтруктураОписания.Версия					= "3.2.1.0";
	СтруктураОписания.МинимальнаяВерсияМодуля   = "8.3.10.10";
	
	СтруктураОписания.НастройкаСубъекта   		= Истина;
	
	CW_ПодключаемыеКомандыСервер.УстановитьМетодыВнешнегоОбъекта(СтруктураОписания, "РегистрируемыеМетаданные");
	CW_ПодключаемыеКомандыСервер.УстановитьМетодыВнешнегоОбъекта(СтруктураОписания, "ПолучитьОбъекты");
	CW_ПодключаемыеКомандыСервер.УстановитьМетодыВнешнегоОбъекта(СтруктураОписания, "ВыгрузитьОбъекты");
	CW_ПодключаемыеКомандыСервер.УстановитьМетодыВнешнегоОбъекта(СтруктураОписания, "РегистрацияРегламентныхЗаданий");
	CW_ПодключаемыеКомандыСервер.УстановитьМетодыВнешнегоОбъекта(СтруктураОписания, "РегламентныйВызовВыгрузки");
	CW_ПодключаемыеКомандыСервер.УстановитьМетодыВнешнегоОбъекта(СтруктураОписания, "РегламентныйВызовЗагрузки");
	
	CW_ПодключаемыеКомандыСервер.УстановитьФормыВнешнегоОбъекта(СтруктураОписания, "ФормаНастроекСубъекта", 		"ФормаНастройкиСубъекта");
	CW_ПодключаемыеКомандыСервер.УстановитьФормыВнешнегоОбъекта(СтруктураОписания, "ФормаИнтерактивнойЗагрузки", 	"ФормаИнтерактивнойЗагрузки");
	
	Возврат СтруктураОписания;
	
КонецФункции

