Функция РегистрацияРегламентныхЗаданий(Обмен,Параметры=Неопределено) Экспорт 
	// --- 
	
	// настройки будем определять по параметру в параметрах (второй аргумент регл. вызова)
	// ключ №1 - один набор настроек, ключ №2 - другой набор,
	// настройки сохраняем в настройки субъекта
	// при регламентном вызове определяем вариант и читаем настройки для этого ключа
	
	Попытка
		
		УстановитьПривилегированныйРежим(Истина);
		// --- 
		
		// получаем настройки
		Настройки = _ПО.ПолучитьНастройкиСубъекта(Обмен.Обработка,Обмен);
		МассивИдентификаторовРЗ = Новый Массив;
		
		// расписание онлайн-выгрузки
		// ---------------------------------------------------------------------------- 
		РЗ = РегламентныеЗадания.СоздатьРегламентноеЗадание("CW_РегламентнаяВыгрузка");
		РЗ.ИмяПользователя = "";
		РЗ.Наименование = "Выгрузка ("+Строка(Обмен)+"), онлайн"; // будет ещё не онлайн
		РЗ.Ключ = "online";
		// --- 
		МассивПараметров = Новый Массив;
		МассивПараметров.Добавить(Обмен);
		МассивПараметров.Добавить(Новый Структура("ВариантВыгрузки","online"));
		РЗ.Параметры = МассивПараметров;
		// --- 
		// расписание
		РасписаниеРЗ = _сф.ст_ПолучитьСвойство(Настройки,"Выгрузка_РасписаниеОнлайн").Получить(0).Значение;
		РЗ.Расписание = РасписаниеРЗ;
		// --- 
		РЗ.Использование = Истина;
		// --- 
		РЗ.Записать();
		// --- 
		МассивИдентификаторовРЗ.Добавить(РЗ.УникальныйИдентификатор);
		
		// расписание регламентной выгрузки
		// ---------------------------------------------------------------------------- 
		РЗ = РегламентныеЗадания.СоздатьРегламентноеЗадание("CW_РегламентнаяВыгрузка");
		РЗ.ИмяПользователя = "";
		РЗ.Наименование = "Выгрузка ("+Строка(Обмен)+"), ежедневная";
		РЗ.Ключ = "daily";
		// --- 
		МассивПараметров = Новый Массив;
		МассивПараметров.Добавить(Обмен);
		МассивПараметров.Добавить(Новый Структура("ВариантВыгрузки","daily"));
		РЗ.Параметры = МассивПараметров;
		// --- 
		// расписание
		РасписаниеРЗ = _сф.ст_ПолучитьСвойство(Настройки,"Выгрузка_РасписаниеЕжедневное").Получить(0).Значение;
		РЗ.Расписание = РасписаниеРЗ;
		// --- 
		РЗ.Использование = Истина;
		// --- 
		РЗ.Записать();
		// --- 
		МассивИдентификаторовРЗ.Добавить(РЗ.УникальныйИдентификатор);
		
		// расписание загрузки
		// ---------------------------------------------------------------------------- 
		РЗ = РегламентныеЗадания.СоздатьРегламентноеЗадание("CW_РегламентнаяЗагрузка");
		РЗ.ИмяПользователя = "";
		РЗ.Наименование = "Загрузка ("+Строка(Обмен)+")"; 
		РЗ.Ключ = "";
		// --- 
		МассивПараметров = Новый Массив;
		МассивПараметров.Добавить(Обмен);
		МассивПараметров.Добавить(Неопределено);
		РЗ.Параметры = МассивПараметров;
		// --- 
		// расписание
		РасписаниеРЗ = _сф.ст_ПолучитьСвойство(Настройки,"Загрузка_Расписание").Получить(0).Значение;
		РЗ.Расписание = РасписаниеРЗ;
		// --- 
		РЗ.Использование = Истина;
		// --- 
		РЗ.Записать();
		// --- 
		МассивИдентификаторовРЗ.Добавить(РЗ.УникальныйИдентификатор);
		
		// --- 
		УстановитьПривилегированныйРежим(Ложь);
		
	Исключение
		
		CW_Журнал.ОтладочноеСообщение("Обмен.МИС","Создание регламентного задания:"+Символы.ПС+ОписаниеОшибки());
		Возврат(_УФКС.Ответ(1,"Ошибка регистрации регламентных заданий."));
		
	КонецПопытки; 
	
	Ответ = _УФКС.Ответ();
	_сф.ст_УстановитьСвойство(Ответ,"МассивИдентификаторовРегламентныхЗаданий",МассивИдентификаторовРЗ);
	Возврат(Ответ);
	
	// --- 
КонецФункции

