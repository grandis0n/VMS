// устанавливает флаг успешной загрузки документа
Процедура  УстановитьФлагЗагрузкиОбъекта(ПараметрыЗагрузки,УИД)
	
	Если ПараметрыЗагрузки.ИспользуетсяUID Тогда
		
		Синхрострока = Объекты.Найти(Новый УникальныйИдентификатор(УИД),"Источник_УИД");
		
	Иначе
		
		Синхрострока = Объекты.Найти(УИД,"Источник_СИ");
		
	КонецЕсли; 
	
	Если Синхрострока <> Неопределено Тогда
		
		Синхрострока.ЗагруженоУспешно = Истина;
		Возврат;
				
	КонецЕсли;
	
КонецПроцедуры // УстановитьФлагЗагрузки()

// --- 

Функция ПолучитьСвязанныеСсылки(ПараметрыЗагрузки,УИД)
	
	МассивСсылок = Новый Массив;
	
	Если ПараметрыЗагрузки.ИспользуетсяUID Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		|	CW_СинхронизацияОбъектов.Приемник_Объект
		|ИЗ
		|	РегистрСведений.CW_СинхронизацияОбъектов КАК CW_СинхронизацияОбъектов
		|ГДЕ
		|	CW_СинхронизацияОбъектов.Источник_УИД = &Источник_УИД
		|	И CW_СинхронизацияОбъектов.Источник_Идентификатор = &Источник_Идентификатор";
		Запрос.УстановитьПараметр("Источник_УИД", Новый УникальныйИдентификатор(УИД));
		
	Иначе
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		|	CW_СинхронизацияОбъектов.Приемник_Объект
		|ИЗ
		|	РегистрСведений.CW_СинхронизацияОбъектов КАК CW_СинхронизацияОбъектов
		|ГДЕ
		|	CW_СинхронизацияОбъектов.Источник_СИ = &Источник_СИ
		|	И CW_СинхронизацияОбъектов.Источник_Идентификатор = &Источник_Идентификатор";
		Запрос.УстановитьПараметр("Источник_СИ", УИД);
		
	КонецЕсли; 
	
	Запрос.УстановитьПараметр("Источник_Идентификатор", ПараметрыЗагрузки.Обмен);
	
	ТЗ = Запрос.Выполнить().Выгрузить();
	Для Каждого Стр Из ТЗ Цикл
		 МассивСсылок.Добавить(Стр.Приемник_Объект);
	КонецЦикла;	
	Если МассивСсылок.Количество()=0 Тогда
		
		Возврат(Неопределено);
		
	Иначе
		
		Возврат(МассивСсылок);
		
	КонецЕсли;
	
КонецФункции // ПолучитьСвязанныеСсылки()

Функция ПолучитьСвязаннуюСсылку(ПараметрыЗагрузки,УИД,Тип)
	
	// обрезаем
	
	Мстр = ПолучитьСвязанныеСсылки(ПараметрыЗагрузки,УИД);
	Если Мстр <> Неопределено Тогда
		
		Для каждого Стр Из Мстр Цикл
			
			Если ТипЗнч(Стр) = Тип(Тип) Тогда
				
				Возврат(Стр);
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат(Неопределено);
	
КонецФункции // ПолучитьСвязаннуюСсылку()

Функция ПолучитьТипСоответствия(ПараметрыЗагрузки,ТипУУ)
	
	Возврат(ПараметрыЗагрузки.СоответствиеТипов.Получить(ТипУУ).Имя);
	
