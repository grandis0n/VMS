Функция ЗагрузитьФайл(ПараметрыЗагрузки,ПараметрыФайла)
	// --- 
	
	Попытка
		
		Синхронизация.Очистить(); 
		Объекты.Очистить();
		
		// пытаемся прочитать файл
		Ответ = ПрочитатьФайл(ПараметрыЗагрузки,ПараметрыФайла.Файл.ПолноеИмя);
		Если Ответ.Код <> 0 Тогда
			
			// пишем в лог
			Возврат(_УФКС.Ответ(1,Ответ.ОписаниеОшибки));
			
		КонецЕсли; 
		
		// выполняем синхронизацию
		СинхронизироватьПоРегистру(ПараметрыЗагрузки);
		
		// выполняем автосинхронизацию (для размеров и типов контейнеров)
		ВыполнитьАвтосинхронизацию(ПараметрыЗагрузки);
		
		// проверяем, есть ли несинхронизированные объекты
		Если Синхронизация.НайтиСтроки(_сф.ст_Отбор("Синхронизировано",Ложь)).Количество() <> 0 Тогда
			
			// тут ещё можно передать описание несинхронизированных объектов
			Возврат(_УФКС.Ответ(1,"Есть несинхронизированные объекты"));
						
		КонецЕсли; 
		
		// запускаем функцию загрузки
		Ответ = ЗагрузитьОбъекты(ПараметрыЗагрузки);
		Возврат(Ответ);		
		
	Исключение
		
		_УФКС.Ответ(1,ОписаниеОшибки());
		
	КонецПопытки; 
	
	// --- 
КонецФункции

Функция ПрочитатьФайл(ПараметрыЗагрузки,ИмяФайла) Экспорт 
	// --- 
	
	Пространство = "https://www.coralway.ru/af/xdto";
	// ---------------------------------------------------------------------------- 
	
	// создаём папку в tmp и распаковываем туда архив
	Путь = КаталогВременныхФайлов();
	ИмяКаталога = Путь+Формат(ТекущаяДата(),"ДФ=yyyyMMddHHmmss")+"_"+_сф.УИДСтрокой(CW_Настройки.Пользователь());
	Попытка
		
		СоздатьКаталог(ИмяКаталога);
		
	Исключение
		
		// --- 
		
	КонецПопытки; 
	
	// --- 
	
	Попытка
		
		Архив = Новый ЧтениеZipФайла(ИмяФайла);
		// --- 
		Архив.ИзвлечьВсе(ИмяКаталога,РежимВосстановленияПутейФайловZIP.НеВосстанавливать);
		
	Исключение
	   
		Сообщить(ОписаниеОшибки());
		
	КонецПопытки; 
	
	// проверяем, что в папке есть по крайней мере index.xml
	// ещё там чаще всего будет content.xml и, возможно, af8.xsd
	// если не нашли - пишем в лог сообщение и возвращаем сообщение пользователю
	
	Попытка
		
		ФайлыАрхива = НайтиФайлы(ИмяКаталога,"*",Ложь);
		
	Исключение
	    
		// --- 
		
	КонецПопытки; 
	
	// --- 
	
	СФ = _сф.ст_Создать("index,content,schema");
	Для каждого Файл Из ФайлыАрхива Цикл
		
		Если Файл.Имя = "index.xml" Тогда
			
			СФ.index = Файл.ПолноеИмя;
			
		КонецЕсли; 
		Если Файл.Имя = "content.xml" Тогда
			
			СФ.content = Файл.ПолноеИмя;
			
		КонецЕсли; 
		Если Файл.Имя = "af8.xsd" Тогда
			
			СФ.schema = Файл.ПолноеИмя;
			
		КонецЕсли; 
		
	КонецЦикла; 
	
	Если СФ.index = Неопределено Тогда
		
		// ... (ахтунг)
		
	КонецЕсли; 
	
	// инициализируем фабрику
	Если СФ.schema <> Неопределено Тогда
		
		// инциализируем фабрику по переданному файлу
		ФайлСхемы = СФ.schema;
		
	Иначе
		
		// инициализируем фабрику по собственному файлу из макета
		Схема = ПолучитьМакет("xsd");
		ФайлСхемы = ИмяКаталога+"\af8.xsd";
		Схема.Записать(ФайлСхемы);
		
	КонецЕсли; 
	
	// создаём фабрику
	ФайлыСхемы = Новый Массив;
	ФайлыСхемы.Добавить(ФайлСхемы);
	Фабрика = СоздатьФабрикуXDTO(ФайлыСхемы);
	
	// ---------------------------------------------------------------------------- 
	
	// читаем шапку index.xml
	// и настройки в ней
	// ---------------------------------------------------------------------------- 
	ЧитатьИндекс = Истина;
	ЧитатьСодержание = (СФ.content <> Неопределено);
	Если ЧитатьИндекс Тогда
		// --- 
		
		ЧтениеХМЛ = Новый ЧтениеXML;
		ЧтениеХМЛ.ОткрытьФайл(СФ.index);
		// --- 
		ЧтениеХМЛ.Прочитать();
		ЧтениеХМЛ.Прочитать();
		
		ТипИнфоБлок = Фабрика.Тип(Пространство,"ЗаголовокПакета");
		ТипСписокТипов = Фабрика.Тип(Пространство,"СписокВыгружаемыхТипов");
		ТипСписокОбъектов = Фабрика.Тип(Пространство,"СписокВыгружаемыхОбъектов");
		// --- 
		Настройки = Фабрика.ПрочитатьXML(ЧтениеХМЛ,ТипИнфоБлок);
		СписокТипов = Фабрика.ПрочитатьXML(ЧтениеХМЛ,ТипСписокТипов);
		СписокОбъектов = Фабрика.ПрочитатьXML(ЧтениеХМЛ,ТипСписокОбъектов);
		// --- 
		ЧтениеХМЛ.Закрыть();
		
		// ---------------------------------------------------------------------------- 
		
		// заполняем настройки
		_сф.ст_УстановитьСвойство(ПараметрыЗагрузки,"ИспользуетсяUID",Настройки.ИспользованиеUID);
		
		// анализируем типы
		Типы = _сф.со_Создать("Имя","Имя,Синоним,Синхронизация,Подтверждение,ТипXDTO",СписокТипов.Тип);
		СинхронизируемыеТипы = Новый Соответствие;
		
		// анализируем объекты
		Для каждого Объект Из СписокОбъектов.Объект Цикл
			
			ТипОбъекта = Типы.Получить(Объект.Тип);
			// --- 
			ПризнакСинхронизации = Истина;
			ПризнакВидимости = Истина;
			ПризнакЗагрузки = Ложь;
			// --- 
			Если ТипОбъекта.Подтверждение Тогда
				
				ПризнакЗагрузки = Истина;
				
			КонецЕсли; 
			// --- 
			Если ТипОбъекта.Синхронизация = "A" Тогда
				
				ПризнакСинхронизации = Ложь;
				
			КонецЕсли;
			// --- 
			Если ТипОбъекта.Имя = "Справочник.Грузоперевозка" Тогда
				
				ПризнакСинхронизации = Истина;
				ПризнакВидимости = Ложь;
				
			КонецЕсли; 
			// --- 
			Если ПризнакЗагрузки Тогда
				// --- 
				
				// проверяем, есть ли у нас соответствие для типа
				СТ = ПараметрыЗагрузки.СоответствиеТипов.Получить(ТипОбъекта.Имя);
				Если СТ = Неопределено Тогда
					
					// для полученного объекта нет соответствия
					Продолжить;
					
				КонецЕсли; 
				// --- 				
				НовыйОбъект = Объекты.Добавить();
				// --- 
				НовыйОбъект.Источник_Тип = CW_Обмены_ПИ.МетаданноеКонфигурации(ТипОбъекта.Имя);
				Если Настройки.ИспользованиеUID Тогда
					НовыйОбъект.Источник_УИД = Новый УникальныйИдентификатор(Объект.Идентификатор);
				Иначе
					НовыйОбъект.Источник_СИ = "<вторая часть типа>"+Объект.Идентификатор; 
				КонецЕсли; 
				НовыйОбъект.Источник_Наименование = Объект.CW_Представление;			
				НовыйОбъект.Загружать = Истина;
				НовыйОбъект.ЗагруженоУспешно = Ложь;
				НовыйОбъект.Приоритет = СТ.Приоритет;
				// --- 
				Если Объект.Режим <> "ПометкаУдаления" Тогда
					
					ЧитатьСодержание = Истина;
					
				КонецЕсли; 
				НовыйОбъект.ДатаВыгрузки = Объект.ДатаВыгрузки;
				
				// --- 
			КонецЕсли; 
			// --- 
			Если ПризнакСинхронизации Тогда
				// --- 
				
				// проверяем, что идентификатор объекта не пустой
				Если ПараметрыЗагрузки.ИспользуетсяUID Тогда
					
					Если СокрЛП(Объект.Идентификатор) = "00000000-0000-0000-0000-000000000000" Тогда
						
						Продолжить;
						
					КонецЕсли; 
					
				Иначе
					
					Если СокрЛП(Объект.Идентификатор) = "" Тогда
						
						Продолжить;
						
					КонецЕсли;  
					
				КонецЕсли; 
				
				НовыйОбъект = Синхронизация.Добавить();
				// --- 
				НовыйОбъект.Источник_Тип = CW_Обмены_ПИ.МетаданноеКонфигурации(ТипОбъекта.Имя);
				Если СинхронизируемыеТипы.Получить(НовыйОбъект.Источник_Тип) = Неопределено Тогда
					
					СинхронизируемыеТипы.Вставить(НовыйОбъект.Источник_Тип,Истина);
					
				КонецЕсли; 
				//НовыйОбъект.Источник_Синоним = ТипОбъекта.Синоним;
				
				Если ПараметрыЗагрузки.ИспользуетсяUID Тогда
					НовыйОбъект.Источник_УИД = Новый УникальныйИдентификатор(Объект.Идентификатор);
				Иначе
					НовыйОбъект.Источник_СИ = "<вторая часть типа>"+Объект.Идентификатор;
				КонецЕсли; 
				НовыйОбъект.Источник_Наименование = Объект.CW_Представление;
				НовыйОбъект.ДатаВыгрузки = Объект.ДатаВыгрузки;
				НовыйОбъект.Видимость = ПризнакВидимости;
				
				// --- 
			КонецЕсли; 
			
		КонецЦикла; 
		
		// сохраняем в найстройках
		_сф.ст_УстановитьСвойство(ПараметрыЗагрузки,"Типы",Типы);
		_сф.ст_УстановитьСвойство(ПараметрыЗагрузки,"СинхронизируемыеТипы",СинхронизируемыеТипы);
		
		// --- 
	КонецЕсли; 
	
	// читаем content.xml
	// ---------------------------------------------------------------------------- 
	Если ЧитатьСодержание Тогда
		// --- 
		
		ЧтениеХМЛ = Новый ЧтениеXML;
		ЧтениеХМЛ.ОткрытьФайл(СФ.content);
		// --- 
		ЧтениеХМЛ.Прочитать();
		//ЧтениеХМЛ.Прочитать();
		
		// читаем в цикле объекты
		// --- 
		
		СинхроСоответствие = Новый Соответствие;
		// --- 
		
		ТипыХДТО = Новый Соответствие;
		// --- 
		
		Пока ЧтениеХМЛ.Прочитать() Цикл
			
			Если ЧтениеХМЛ.Имя = "Объект" И ЧтениеХМЛ.ТипУзла=ТипУзлаXML.НачалоЭлемента Тогда
				
				ЧтениеХМЛ.ПрочитатьАтрибут();
				Идентификатор = ЧтениеХМЛ.Значение;
				ЧтениеХМЛ.ПрочитатьАтрибут();
				Тип = ЧтениеХМЛ.Значение;
				// --- 
				ЧтениеХМЛ.Прочитать();
				// --- 
				ТипОбъекта = Типы.Получить(Тип);
				ТипХДТО = ТипыХДТО.Получить(ТипОбъекта.ТипXDTO);
				Если ТипХДТО = Неопределено Тогда
					ТипХДТО = Фабрика.Тип(Пространство,ТипОбъекта.ТипXDTO);	
					ТипыХДТО.Вставить(ТипОбъекта.ТипXDTO,ТипХДТО);
				КонецЕсли; 
				ОбъектХДТО = Фабрика.ПрочитатьXML(ЧтениеХМЛ,ТипХДТО);
				
				// засовываем в синхросоответствие
				СинхроСоответствие.Вставить(Идентификатор,ОбъектХДТО);
				
			КонецЕсли; 
			
		КонецЦикла; 
		
		ПараметрыЗагрузки.СинхроСоответствие = ПоместитьВоВременноеХранилище(СинхроСоответствие,CW_Настройки.Пользователь().УникальныйИдентификатор());
		
		// --- 
		ЧтениеХМЛ.Закрыть();
		
		// --- 
	КонецЕсли; 
	
	// ---------------------------------------------------------------------------- 
	Возврат(_УФКС.Ответ());
	
	// --- 
КонецФункции

Процедура ВыполнитьАвтосинхронизацию(ПараметрыЗагрузки)
	// --- 
	
	МетаданныеАвтосинхронизации = Новый Соответствие;
	//МетаданныеАвтосинхронизации.Вставить(CW_Обмены_ПИ.МетаданноеКонфигурации("Справочник.ТипыКонтейнеров"),Истина);
	//МетаданныеАвтосинхронизации.Вставить(CW_Обмены_ПИ.МетаданноеКонфигурации("Справочник.РазмерыКонтейнеров"),Истина);
	
	Если МетаданныеАвтосинхронизации.Количество() <> 0 Тогда
		
		Для каждого Стр Из Синхронизация Цикл
			
			Если НЕ Стр.Синхронизировано Тогда
				
				Если МетаданныеАвтосинхронизации.Получить(Стр.Источник_Тип) <> Неопределено Тогда
					
					УстановитьАвтосинхронизацию(ПараметрыЗагрузки,Стр);
					
				КонецЕсли;
				
			КонецЕсли; 
			
		КонецЦикла; 
		
	КонецЕсли; 
	
	// --- 
КонецПроцедуры

Функция ЗагрузитьОбъекты(ПараметрыЗагрузки) Экспорт 
	
	// снимок таблицы синхронизации
	СинхроТЗ = Синхронизация.Выгрузить();
	// --- 
	СинхроСоответствие = ПолучитьИзВременногоХранилища(ПараметрыЗагрузки.СинхроСоответствие);
	_сф.ст_УстановитьСвойство(ПараметрыЗагрузки,"СинхроСоответствиеОбъект",СинхроСоответствие);
	
	Попытка
		
		// --- 
		НачатьТранзакцию();
		// ---------------------------------------------------------------------------- 
		
		Остановка = Ложь;
		ТекстОшибки = "";
		// внимание, сортировка по приоритету
		Объекты.Сортировать("Приоритет Возр");
		// ---------------------------------------------------------------------------- 
		Для каждого СтрокаОбъекта Из Объекты Цикл
			
			// --- 
			
			// массив объектов к записи
			МассивОбъектов = Новый Массив;
			ФлагОшибкиЗаписи = Ложь;
			
			Идентификатор = ИдентификаторОбъекта(СтрокаОбъекта,ПараметрыЗагрузки);
			
			ХМЛОбъект = СинхроСоответствие.Получить(Строка(Идентификатор));
			Тип = СтрокаОбъекта.Источник_Тип.Наименование;
			
			// ГРУЗОПЕРЕВОЗКИ
			// ---------------------------------------------------------------------------- 
			Если Тип = "Справочник.Грузоперевозка" Тогда
				
				// сначала проверяем, что создан заказ
				Соответствие = ПолучитьТипСоответствия(ПараметрыЗагрузки,Тип);
				СоответствиеСтр = _сф.стр_ПолучитьСтроку(Соответствие,".",2);
				ОбъектСсылка = ПолучитьСвязаннуюСсылку(ПараметрыЗагрузки,Идентификатор,"СправочникСсылка."+СоответствиеСтр);
				Если ОбъектСсылка <> Неопределено Тогда
					Объект = ОбъектСсылка.ПолучитьОбъект();
				Иначе
					
					Объект = Справочники[СоответствиеСтр].СоздатьЭлемент();
					Объект.УстановитьНовыйКод();
					
				КонецЕсли;
				
				Объект.Код = ХМЛОбъект["Номер"]; // будет перезаполнен, подумать
				
				Объект.Клиент = ПолучитьСсылкуСоответствия(ПараметрыЗагрузки,ХМЛОбъект["Клиент"]);
				Объект.CW_Представление = ХМЛОбъект["Контейнер"];
				Объект.ТипПеревозки = ПараметрыЗагрузки.ОсновнойТипПеревозки;
				Объект.Типоразмер = ПолучитьСсылкуСоответствия(ПараметрыЗагрузки,ХМЛОбъект["Типоразмер"]);
				Объект.Комментарий = XMLЗначение(Тип("Строка"),ХМЛОбъект["Комментарий"]);
				
				// --- 
				
				Объект.ПараметрыГрузоперевозки.Очистить(); // обсудить
				// --- 
				Для каждого СтрокаПараметр Из ХМЛОбъект["ПараметрыГрузоперевозки"].ПараметрГрузоперевозки Цикл
					// --- 
					
					Нстр = Объект.ПараметрыГрузоперевозки.Добавить();
					// --- 
					Нстр.Параметр = ПолучитьСсылкуСоответствия(ПараметрыЗагрузки,СтрокаПараметр.Параметр);
					Если Нстр.Параметр.ЭтоКонтрольнаяДата Тогда
						
						Нстр.Значение = XMLЗначение(Тип("Дата"),СтрокаПараметр.Значение);
						Нстр.ЗначениеПлан = СтрокаПараметр.ЗначениеПлан;
						Нстр.ЗначениеФакт = СтрокаПараметр.ЗначениеФакт;
						
					Иначе
						
						ТипПараметра = Нстр.Параметр.ТипЗначения.Типы()[0];
						ЭтоСсылочныйТип = _сф.тип_Ссылочный(ТипПараметра);
						Если ЭтоСсылочныйТип Тогда
							
							Нстр.Значение = ПолучитьСсылкуСоответствия(ПараметрыЗагрузки,СтрокаПараметр.Значение);
							
						Иначе
							
							Нстр.Значение = XMLЗначение(ТипПараметра,СтрокаПараметр.Значение);
							
						КонецЕсли; 
						
					КонецЕсли; 
					
					// --- 
				КонецЦикла; 
				
				
				// --- 
				
				// --- 
				Объект.ОбменДанными.Загрузка = Истина;
				Объект.Записать();
				
				// пропишем в таблицу синхронизации
				СинхроСтрока = _сф.к_НайтиСтроку(Синхронизация,_сф.ст_Отбор("Источник_УИД",СтрокаОбъекта.Источник_УИД));
				// --- 
				СинхроСтрока.Приемник_Объект		= Объект.Ссылка;
				СинхроСтрока.Приемник_УИД			= Объект.Ссылка.УникальныйИдентификатор();
				СинхроСтрока.СозданиеНового 		= Ложь;
				СинхроСтрока.ОбъектЗаписан 			= Истина;
				
				// --- 
				CW_Обмены.ЗаписатьСоответствиеВРегистр(ПараметрыЗагрузки,СинхроСтрока);
				
				// --- 
				МассивОбъектов.Добавить(Объект);
				
			КонецЕсли; 
			
			// ДОХОДЫ
			// ---------------------------------------------------------------------------- 
			Если Тип = "Документ.ДоходыПоГрузоперевозке" Тогда
				
				// сначала проверяем, что создан заказ
				Соответствие = ПолучитьТипСоответствия(ПараметрыЗагрузки,Тип);
				СоответствиеСтр = _сф.стр_ПолучитьСтроку(Соответствие,".",2);
				ОбъектСсылка = ПолучитьСвязаннуюСсылку(ПараметрыЗагрузки,Идентификатор,"ДокументСсылка."+СоответствиеСтр);
				Если ОбъектСсылка <> Неопределено Тогда
					Объект = ОбъектСсылка.ПолучитьОбъект();
				Иначе
					Объект = Документы[СоответствиеСтр].СоздатьДокумент();
				КонецЕсли;
				// ---------------------------------------------------------------------------- 
				
				Объект.Номер = ХМЛОбъект["Номер"];
				Объект.Дата = ХМЛОбъект["Дата"];
				// --- 
				Объект.Организация = ПолучитьСсылкуСоответствия(ПараметрыЗагрузки,ХМЛОбъект["Организация"]);
				Объект.Контрагент = ПолучитьСсылкуСоответствия(ПараметрыЗагрузки,ХМЛОбъект["Контрагент"]);
				Объект.Договор = ПолучитьСсылкуСоответствия(ПараметрыЗагрузки,ХМЛОбъект["Договор"]);
				Объект.Валюта = ПолучитьСсылкуСоответствия(ПараметрыЗагрузки,ХМЛОбъект["Валюта"]);
				// Объект.СпособЗачетаАвансов = 
				Объект.СрокОплаты = ХМЛОбъект["СрокОплаты"];
				// --- 
				ФормироватьСчет = ХМЛОбъект["ФормироватьСчет"];
				ДатаСчета = ?(ФормироватьСчет,ХМЛОбъект["ДатаСчета"],Дата(1,1,1));
				НомерСчета = ?(ФормироватьСчет,ХМЛОбъект["НомерСчета"],"");
				// --- 
				ФормироватьАкт = ХМЛОбъект["ФормироватьАкт"];
				ДатаАкта = ?(ФормироватьАкт,ХМЛОбъект["ДатаАкта"],Дата(1,1,1));
				НомерАкта = ?(ФормироватьАкт,ХМЛОбъект["НомерАкта"],"");
				// --- 
				ФормироватьСФ = ХМЛОбъект["ФормироватьСчетФактуру"];
				ДатаСФ = ?(ФормироватьСФ,ХМЛОбъект["ДатаСчетаФактуры"],Дата(1,1,1));
				НомерСФ = ?(ФормироватьСФ,ХМЛОбъект["НомерСчетаФактуры"],"");
				// --- 
				Объект.ПризнакОтличияАкта = (НомерСчета <> НомерАкта);
				Если Объект.ПризнакОтличияАкта Тогда
					
					Объект.НомерАкта = НомерАкта;
					Объект.ДатаАкта = ДатаАкта;
					
				КонецЕсли; 
				// --- 
				Объект.Комментарий = ХМЛОбъект["Комментарий"];
				// --- 
				Объект.Услуги.Очистить();
				Для каждого СтрокаУслуги Из ХМЛОбъект["Услуги"].Услуга Цикл
					// --- 
					
					Нстр = Объект.Услуги.Добавить();
					Нстр.Грузоперевозка = ПолучитьСсылкуСоответствия(ПараметрыЗагрузки,СтрокаУслуги.Грузоперевозка);
					Нстр.Номенклатура = ПолучитьСсылкуСоответствия(ПараметрыЗагрузки,СтрокаУслуги.Номенклатура);
					Нстр.СтатьяЗатрат = ПолучитьСсылкуСоответствия(ПараметрыЗагрузки,СтрокаУслуги.СтатьяЗатрат);
					Нстр.Представление = СтрокаУслуги.Представление;
					Нстр.Цена = СтрокаУслуги.Цена;
					Нстр.Количество = СтрокаУслуги.Количество;
					Нстр.Сумма = СтрокаУслуги.Сумма;
					Нстр.СуммаНДС = СтрокаУслуги.НДС;
					Нстр.СуммаВсего = СтрокаУслуги.Всего;
					// --- 
					Нстр.ПорядокОтражения = Перечисления.CW_ПорядокОтраженияДоходов.СобственнаяУслуга;
					
					// --- 
				КонецЦикла; 
				
				// --- 
				МассивОбъектов.Добавить(Объект);
				
			КонецЕсли;
			
			// РАСХОДЫ
			// ----------------------------------------------------------------------------
			Если Тип = "Документ.РасходыПоГрузоперевозке" Тогда
				
				// сначала проверяем, что создан заказ
				Соответствие = ПолучитьТипСоответствия(ПараметрыЗагрузки,Тип);
				СоответствиеСтр = _сф.стр_ПолучитьСтроку(Соответствие,".",2);
				ОбъектСсылка = ПолучитьСвязаннуюСсылку(ПараметрыЗагрузки,Идентификатор,"ДокументСсылка."+СоответствиеСтр);
				Если ОбъектСсылка <> Неопределено Тогда
					Объект = ОбъектСсылка.ПолучитьОбъект();
				Иначе
					Объект = Документы[СоответствиеСтр].СоздатьДокумент();
				КонецЕсли;
				// ---------------------------------------------------------------------------- 
				
				Объект.Номер = ХМЛОбъект["Номер"];
				Объект.Дата = ХМЛОбъект["Дата"];
				// --- 
				Объект.Организация = ПолучитьСсылкуСоответствия(ПараметрыЗагрузки,ХМЛОбъект["Организация"]);
				Объект.Контрагент = ПолучитьСсылкуСоответствия(ПараметрыЗагрузки,ХМЛОбъект["Контрагент"]);
				Объект.Договор = ПолучитьСсылкуСоответствия(ПараметрыЗагрузки,ХМЛОбъект["Договор"]);
				Объект.Валюта = ПолучитьСсылкуСоответствия(ПараметрыЗагрузки,ХМЛОбъект["Валюта"]);
				// Объект.СпособЗачетаАвансов = 
				Объект.СрокОплаты = ХМЛОбъект["СрокОплаты"];
				// --- 
				Объект.ПредъявленСчет = ХМЛОбъект["ПредъявленСчет"];
				Объект.ДатаСчета = ?(Объект.ПредъявленСчет,ХМЛОбъект["ДатаСчета"],Дата(1,1,1));
				Объект.НомерСчета = ?(Объект.ПредъявленСчет,ХМЛОбъект["НомерСчета"],"");
				// --- 
				Объект.ПредъявленАкт = ХМЛОбъект["ПредъявленАкт"];
				Объект.ДатаАкта = ?(Объект.ПредъявленАкт,ХМЛОбъект["ДатаАкта"],Дата(1,1,1));
				Объект.НомерАкта = ?(Объект.ПредъявленАкт,ХМЛОбъект["НомерАкта"],"");
				// --- 
				Объект.ПредъявленСФ = ХМЛОбъект["ПредъявленСчетФактура"];
				Объект.ДатаСФ = ?(Объект.ПредъявленСФ,ХМЛОбъект["ДатаСчетаФактуры"],Дата(1,1,1));
				Объект.НомерСФ = ?(Объект.ПредъявленСФ,ХМЛОбъект["НомерСчетаФактуры"],"");
				// --- 
				Объект.Комментарий = ХМЛОбъект["Комментарий"];
				
				// --- 
				
				Объект.Услуги.Очистить();
				Для каждого СтрокаУслуги Из ХМЛОбъект["Услуги"].Услуга Цикл
					// --- 
					
					Нстр = Объект.Услуги.Добавить();
					Нстр.Грузоперевозка = ПолучитьСсылкуСоответствия(ПараметрыЗагрузки,СтрокаУслуги.Грузоперевозка);
					Нстр.Номенклатура = ПолучитьСсылкуСоответствия(ПараметрыЗагрузки,СтрокаУслуги.Номенклатура);
					Нстр.СтатьяЗатрат = ПолучитьСсылкуСоответствия(ПараметрыЗагрузки,СтрокаУслуги.СтатьяЗатрат);
					Нстр.Представление = СтрокаУслуги.Представление;
					Нстр.Цена = СтрокаУслуги.Цена;
					Нстр.Количество = СтрокаУслуги.Количество;
					Нстр.Сумма = СтрокаУслуги.Сумма;
					Нстр.СуммаНДС = СтрокаУслуги.НДС;
					Нстр.СуммаВсего = СтрокаУслуги.Всего;
					// --- 
					Нстр.ПорядокОтражения = Перечисления.CW_ПорядокОтраженияЗатрат.Затраты;
					
					// --- 
				КонецЦикла; 
				
				// --- 
				МассивОбъектов.Добавить(Объект);
				
			КонецЕсли;
			
			СсылкаОбъектаСоответствия = Неопределено;
			
			Если НЕ ФлагОшибкиЗаписи Тогда
				
				Для каждого Объект Из МассивОбъектов Цикл
					
					Попытка
						
						//Сообщить(Объект);
						Объект.ОбменДанными.Загрузка = Истина;
						Объект.Записать();
						СсылкаОбъектаСоответствия = Объект.Ссылка;
						
					Исключение
						
						ТекстОшибки = ОписаниеОшибки();
						ФлагОшибкиЗаписи = Истина;
						Прервать;
						
					КонецПопытки;
					
				КонецЦикла;
				
			КонецЕсли; 
			
			Если НЕ ФлагОшибкиЗаписи Тогда
				
				// запишем синхронизацию в регистр
				Для каждого Объект Из МассивОбъектов Цикл
					
					Попытка
						
						Запись = РегистрыСведений.CW_СинхронизацияОбъектов.СоздатьМенеджерЗаписи();
						Запись.Источник_Тип = СтрокаОбъекта.Источник_Тип;
						Если ПараметрыЗагрузки.ИспользуетсяUID Тогда
							
							Запись.Источник_УИД = Идентификатор;
							
						Иначе
							
							Запись.Источник_СИ = Идентификатор;
							
						КонецЕсли; 
						
						Запись.Источник_Идентификатор = ПараметрыЗагрузки.Обмен;
						Запись.Приемник_Объект = Объект.Ссылка;
						Запись.Приемник_УИД = Объект.Ссылка.УникальныйИдентификатор();
						Запись.Источник_Наименование = СтрокаОбъекта.Источник_Наименование;
						Запись.флНезавершена = Ложь;
						Запись.Записать();
						
					Исключение
						
						ФлагОшибкиЗаписи = Истина;
						Прервать;
						
					КонецПопытки; 
										
				КонецЦикла;
				
				// пометим как загруженный успешно
				УстановитьФлагЗагрузкиОбъекта(ПараметрыЗагрузки,Идентификатор);
				
			Иначе
				
				Остановка = Истина;
				Прервать;
				
			КонецЕсли; 
			
			СтрокаОбъекта.ЗагруженоУспешно = Истина;
			СтрокаОбъекта.ОбъектСоответствия = СсылкаОбъектаСоответствия;
			
		КонецЦикла; 
		
		Если Остановка Тогда
			
			Если ТранзакцияАктивна() Тогда
				
				ОтменитьТранзакцию();
				
			КонецЕсли; 
			
			_сф.ст_УстановитьСвойство(ПараметрыЗагрузки,"СинхроСоответствиеОбъект",Неопределено);
			
			Возврат(_УФКС.Ответ(1,"Ошибка при загрузке:"+ТекстОшибки));
			
		КонецЕсли; 
		
		// ---------------------------------------------------------------------------- 
		ЗафиксироватьТранзакцию();
		// --- 
		
		_сф.ст_УстановитьСвойство(ПараметрыЗагрузки,"СинхроСоответствиеОбъект",Неопределено);
		
		Возврат(_УФКС.Ответ());
		
	Исключение
		
		_сф.ст_УстановитьСвойство(ПараметрыЗагрузки,"СинхроСоответствиеОбъект",Неопределено);
		
		Если ТранзакцияАктивна() Тогда
			
			ОтменитьТранзакцию();
			
		КонецЕсли; 
		
		Синхронизация.Загрузить(СинхроТЗ);
		
		Возврат(_УФКС.Ответ(1,ОписаниеОшибки()));
		
	КонецПопытки; 
	
		
КонецФункции

