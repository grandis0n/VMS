// возвращает ссылку на объект БУ по  уиду УУ
Функция ПолучитьСсылкуСоответствия(ПараметрыЗагрузки,Идентификатор) // первая главная функция
	
	Если Идентификатор = Неопределено Тогда
		
		Возврат(Неопределено);
		
	КонецЕсли;
	
	Если Идентификатор = "" Тогда
		
		Возврат(Неопределено);
		
	КонецЕсли;
	
	Если Идентификатор="00000000-0000-0000-0000-000000000000" Тогда
		
		Возврат(Неопределено);
		
	КонецЕсли;
		
	// --- 
	
	Если ПараметрыЗагрузки.ИспользуетсяUID Тогда
		
		Синхрострока = Синхронизация.Найти(Новый УникальныйИдентификатор(Идентификатор),"Источник_УИД");
		
	Иначе
		
		Синхрострока = Синхронизация.Найти(Идентификатор,"Источник_СИ");
		
	КонецЕсли; 
	
	Если Синхрострока = Неопределено Тогда
		
		Возврат(Неопределено);
		
	КонецЕсли;
	
	// --- 
	
	Ссылка = СоздатьОбновитьПоСинхроСтроке(ПараметрыЗагрузки,Синхрострока);
	
	Если Ссылка = Неопределено Тогда
		
		Сообщить("Идентификатор="+Строка(Идентификатор));
		ВызватьИсключение "Ошибка создания объекта!";
		
	КонецЕсли; 
	
	Синхрострока.Приемник_Объект = Ссылка;
		
	Возврат(Синхрострока.Приемник_Объект);
	
КонецФункции // СсылкаБУ()

// создание объекта в режиме автосинхронизации
Функция СоздатьОбновитьПоСинхроСтроке(ПараметрыЗагрузки,СинхроСтрока) // вторая главная функция
	
	Попытка
		
		// создаем/модифицируем один раз (!)
		Если СинхроСтрока.ОбъектЗаписан Тогда
			
			Возврат(СинхроСтрока.Приемник_Объект);
			
		КонецЕсли; 
		// --- 
		Если СинхроСтрока.СозданиеНового Тогда
			
			Соответствие = ПолучитьТипСоответствия(ПараметрыЗагрузки,СинхроСтрока.Источник_Тип.Наименование);
			СоответствиеСтр = _сф.стр_ПолучитьСтроку(Соответствие,".",2);
			Справочник = Справочники[СоответствиеСтр].СоздатьЭлемент();
			
		Иначе
			
			Если СинхроСтрока.ПолитикаСинхронизации = Перечисления.CW_ПолитикаСинхронизацииОбъектов.Первичная Тогда
				
				Возврат(СинхроСтрока.Приемник_Объект);
				
			Иначе
				
				Справочник = СинхроСтрока.Приемник_Объект.ПолучитьОбъект();
				
			КонецЕсли; 
			
		КонецЕсли;
		
		// ---------------------------------------------------------------------------- 
		
		Если ПараметрыЗагрузки.ИспользуетсяUID Тогда
			
			ХМЛОбъект = ПараметрыЗагрузки.СинхроСоответствиеОбъект.Получить(Строка(СинхроСтрока.Источник_УИД));
			
		Иначе
			
			ХМЛОбъект = ПараметрыЗагрузки.СинхроСоответствиеОбъект.Получить(СинхроСтрока.Источник_СИ);
			
		КонецЕсли; 
		
		// --- 
		 
		Если Синхрострока.Источник_Тип.Наименование = "Справочник.Организации" Тогда
			
			// --- 
			//Справочник = Справочники.Организации.СоздатьЭлемент();
			Справочник.Наименование 		= ХМЛОбъект["Наименование"];
			Справочник.НаименованиеПолное 	= ХМЛОбъект["ПолноеНаименование"];
			Справочник.Префикс				= СокрЛП(ХМЛОбъект["Префикс"]);
			// --- 
			Справочник.ИНН 					= ХМЛОбъект["ИНН"];
			Справочник.КПП 					= ХМЛОбъект["КПП"];
			// --- 
			
		КонецЕсли;
		// --- МИС
		Если Синхрострока.Источник_Тип.Наименование = "Справочник.Контрагенты" Тогда
			
			// --- 
			//Справочник = Справочники.Контрагенты.СоздатьЭлемент();
			Справочник.Наименование 		= СокрЛП(Синхрострока.Источник_Наименование);
			Справочник.НаименованиеПолное 	= "";
			// --- 
			Справочник.ИНН 					= "";
			Справочник.КПП 					= "";
			// --- 
			
		КонецЕсли;
		// --- 
		Если Синхрострока.Источник_Тип.Наименование = "Справочник.Договоры" Тогда
			
			// --- 
			//Справочник = Справочники.CW_ДоговорыПоГрузоперевозкам.СоздатьЭлемент(); // тмп
			Справочник.Наименование					= СокрЛП(СинхроСтрока.Источник_Наименование);
			Справочник.РедактироватьНаименование	= ХМЛОбъект["РедактироватьНаименование"];
			Справочник.Владелец 					= ПолучитьСсылкуСоответствия(ПараметрыЗагрузки,ХМЛОбъект["Контрагент"]);
			Справочник.Организация					= ПолучитьСсылкуСоответствия(ПараметрыЗагрузки,ХМЛОбъект["Организация"]);
			Справочник.ВалютаДоговора		 		= ПолучитьСсылкуСоответствия(ПараметрыЗагрузки,ХМЛОбъект["Валюта"]);
			Справочник.ТипДоговора					= ПолучитьСсылкуСоответствия(ПараметрыЗагрузки,ХМЛОбъект["ТипДоговора"]);
			// --- 
			Справочник.НомерДоговора 				= СокрЛП(ХМЛОбъект["НомерДоговора"]);
			Справочник.ДатаДоговора					= ХМЛОбъект["ДатаДоговора"];
			Справочник.СрокДействияДоговора 		= ХМЛОбъект["СрокДействияДоговора"];
			
			Если ХМЛОбъект["ВидДоговора"] = "СПокупателем" Тогда
				Справочник.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПокупателем;
			ИначеЕсли ХМЛОбъект["ВидДоговора"] = "СПоставщиком" Тогда
				Справочник.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком;
			КонецЕсли;
			
			Если Синхрострока.СозданиеНового Тогда
				
				// создаем учётный договор
				
				Договор = Справочники.ДоговорыКонтрагентов.СоздатьЭлемент();
				Договор.Наименование = Справочник.Наименование;
				Договор.Владелец = Справочник.Владелец;
				Договор.Организация = Справочник.Организация;
				Договор.ВидДоговора = Справочник.ВидДоговора;
				Договор.Номер = Справочник.НомерДоговора;
				Договор.Дата = Справочник.ДатаДоговора;
				Договор.ВидДоговора = Справочник.ВидДоговора;
				Договор.ВалютаВзаиморасчетов = Справочник.ВалютаДоговора;
				// --- 
				Договор.Записать();
				
				Справочник.УчетныйДоговор = Договор.Ссылка
				           				
			КонецЕсли; 
			
			Справочник.ОбменДанными.Загрузка = Истина;
			// --- 			       			
			
		КонецЕсли;
		// --- 
		Если Синхрострока.Источник_Тип.Наименование = "Справочник.ТипыДоговоров" Тогда
			
			//Справочник = Справочники.CW_ТипыДоговоров.СоздатьЭлемент(); // тмп
			Справочник.Наименование				= СокрЛП(Синхрострока.Источник_Наименование);
						
		КонецЕсли;
		// --- 
		Если Синхрострока.Источник_Тип.Наименование = "Справочник.Номенклатура" Тогда
			
			//Справочник = Справочники.Номенклатура.СоздатьЭлемент(); // тмп
			Справочник.Наименование				= ХМЛОбъект["Наименование"];
			Справочник.НаименованиеПолное 		= ХМЛОбъект["ПолноеНаименование"];
			//Справочник.СтавкаНДС				= ХМЛОбъект["Ставка"];
			Справочник.Услуга 					= ХМЛОбъект["Услуга"];
			
		КонецЕсли;
		// --- 
		Если Синхрострока.Источник_Тип.Наименование = "Справочник.СтатьиЗатрат" Тогда
			
			//Справочник = Справочники.СтатьиЗатрат.СоздатьЭлемент(); // тмп
			Справочник.Наименование				= СокрЛП(Синхрострока.Источник_Наименование);
						
		КонецЕсли;
		// --- 
		Если Синхрострока.Источник_Тип.Наименование = "Справочник.ВидыДеятельности" Тогда
			
			//Справочник = Справочники.НоменклатурныеГруппы.СоздатьЭлемент(); // тмп
			Справочник.Наименование				= СокрЛП(Синхрострока.Источник_Наименование);
						
		КонецЕсли;
		
		Если Синхрострока.Источник_Тип.Наименование = "Справочник.ТипыПеревозок" Тогда
			
			//<ВидПеревозки>Контейнерная</ВидПеревозки>
			//Справочник = Справочники.CW_ТипыПеревозок.СоздатьЭлемент(); // тмп
			Справочник.Наименование				= СокрЛП(Синхрострока.Источник_Наименование);
			Если ХМЛОбъект["ВидПеревозки"]="Контейнерная" Тогда
				
				Справочник.ВидПеревозки = Перечисления.CW_ВидыПеревозок.Контейнер;
				
			Иначе
				
				Справочник.ВидПеревозки = Перечисления.CW_ВидыПеревозок.Прочее;
				
			КонецЕсли;  
						
		КонецЕсли;
		// --- МИС
		Если Синхрострока.Источник_Тип.Наименование = "Справочник.ТипыКонтейнеров" Тогда
			
			//Справочник = Справочники.CW_ТипыКонтейнеров.СоздатьЭлемент(); // тмп
			Справочник.Наименование				= СокрЛП(ХМЛОбъект["Наименование"]);
			Справочник.Код						= СокрЛП(ХМЛОбъект["Наименование"]);
												
		КонецЕсли;
		// --- МИС
		Если Синхрострока.Источник_Тип.Наименование = "Справочник.РазмерыКонтейнеров" Тогда
			
			//Справочник = Справочники.CW_РазмерыКонтейнеров.СоздатьЭлемент(); // тмп
			Справочник.Наименование				= СокрЛП(ХМЛОбъект["Наименование"]);
												
		КонецЕсли;
		
		Справочник.Записать();
		
		//// ведомые объекты договоров: параметры договора и учётный договор
		//Если Синхрострока.Источник_Тип.Наименование = "Справочник.Договоры" Тогда
		//	
		//	// переносим параметры договора
		//	
		//	// очищаем существующие параметры
		//	НаборЗаписей = РегистрыСведений.CW_ПараметрыДоговоров.СоздатьНаборЗаписей();
		//	НаборЗаписей.Отбор.Договор.Значение = Справочник.Ссылка;
		//	НаборЗаписей.Отбор.Договор.Использование = Истина;
		//	НаборЗаписей.Отбор.Контрагент.Значение = Справочник.Владелец;
		//	НаборЗаписей.Отбор.Контрагент.Использование = Истина;
		//	НаборЗаписей.Записать();
		//	
		//	ТЗПараметров = ХМЛОбъект["Параметры"].Скопировать();
		//	
		//	Для каждого Стр Из ТЗПараметров Цикл
		//		
		//		Стр.Период = XMLЗначение(Тип("Дата"),Стр.Период);
		//		Если Стр.ПорядокЗачетаАвансов = "Автоматически" Тогда
		//			
		//			Стр.ПорядокЗачетаАвансов = Перечисления.СпособыЗачетаАвансов.Автоматически;
		//			
		//		ИначеЕсли Стр.ПорядокЗачетаАвансов = "ПоДокументу" Тогда
		//			
		//			Стр.ПорядокЗачетаАвансов = Перечисления.СпособыЗачетаАвансов.ПоДокументу;
		//			
		//		ИначеЕсли Стр.ПорядокЗачетаАвансов = "НеЗачитывать" Тогда
		//			
		//			Стр.ПорядокЗачетаАвансов = Перечисления.СпособыЗачетаАвансов.НеЗачитывать;
		//			
		//		КонецЕсли;
		//		Стр.ЗановоФормироватьПредставлениеПриПеревыставленииЗатрат = XMLЗначение(Тип("Булево"),Стр.ЗановоФормироватьПредставлениеПриПеревыставленииЗатрат);
		//		Стр.КоличествоДнейПросрочки = XMLЗначение(Тип("Число"), Стр.КоличествоДнейПросрочки);
		//		
		//		Запись = НаборЗаписей.Добавить();
		//		ЗаполнитьЗначенияСвойств(Запись,Стр);
		//		Запись.Контрагент = Справочник.Владелец;
		//		Запись.Договор = Справочник.Ссылка;
		//		
		//	КонецЦикла; 
		//	
		//	НаборЗаписей.Записать(Истина);
		//	
		//КонецЕсли; 
		
		// --- 
		
		СинхроСтрока.Приемник_Объект		= Справочник.Ссылка;
		СинхроСтрока.Приемник_УИД			= Справочник.Ссылка.УникальныйИдентификатор();
		СинхроСтрока.СозданиеНового 		= Ложь;
		СинхроСтрока.ОбъектЗаписан 			= Истина;
		
		// --- 
		CW_Обмены.ЗаписатьСоответствиеВРегистр(ПараметрыЗагрузки,СинхроСтрока);
		// --- 
		
		Возврат(Справочник.Ссылка);
		
	Исключение
		
		ОтменитьТранзакцию();
		// --- 
		
		СинхроСтрока.Приемник_Объект		= Неопределено;
		СинхроСтрока.ОбъектЗаписан 			= Ложь;
		
		Сообщить(ОписаниеОшибки());
		// --- 
		Возврат(Неопределено);
		
	КонецПопытки;
	
КонецФункции // ()

