Процедура УстановитьНомерДокумента(Объект,СтандартнаяОбработка,Префикс) Экспорт
	
	Префикс = Строка(Объект.Организация.Префикс)+Строка(Формат(Объект.Дата,"ДФ=ММ"))+ Строка(Формат(Объект.Дата,"ДФ=dd"))+"-";
	
КонецПроцедуры

Процедура УстановитьНомерСчета(Объект, СчетОбъект=Неопределено) Экспорт 
	
	Если СчетОбъект <> Неопределено Тогда
		Объект.Номер = СчетОбъект.Номер;
	КонецЕсли;
	
КонецПроцедуры

Процедура УстановитьНомерАкта(Ведущий, АктОбъект) Экспорт 
	
	Префикс = Строка(Ведущий.Организация.Префикс)+Строка(Формат(Ведущий.ДатаАкта,"ДФ=ММ"))+ Строка(Формат(Ведущий.ДатаАкта,"ДФ=dd"))+"-";
	_сф.ст_УстановитьСвойство(АктОбъект.ДополнительныеСвойства,"Префикс",Префикс);
	АктОбъект.УстановитьНовыйНомер();
	
КонецПроцедуры

Процедура УстановитьНомерСчетаФактуры(Объект, СчетФактураОбъект) Экспорт 
	
	Если СчетФактураОбъект <> Неопределено Тогда
		СчетФактураОбъект.Номер = Объект.НомерАкта;
	КонецЕсли;
	
КонецПроцедуры

#КонецЕсли