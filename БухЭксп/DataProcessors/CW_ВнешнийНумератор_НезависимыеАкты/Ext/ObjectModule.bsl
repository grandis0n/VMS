#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

// информация об обработке
Функция Информация() Экспорт 
	
	СтруктураОписания 					= CW_ПодключаемыеКомандыСервер.СведенияОПодключаемомОбъекте();
	СтруктураОписания.Тип 				= CW_ПодключаемыеКомандыСервер.ТипОбработка();
	СтруктураОписания.Вид 				= CW_ПодключаемыеКомандыСервер.ВидОбработкиВнешнийНумератор();

	СтруктураОписания.Наименование 				= "Внешний нумератор (счета - сплошная впределах даты, акты - независимая в пределах даты)";
	СтруктураОписания.Описание 					= "Обеспечивает сплошную нумерацию счетов и независимую для актов и с/ф в пределах даты";
	СтруктураОписания.Версия					= "3.2.1.0";
	СтруктураОписания.МинимальнаяВерсияМодуля	= "8.3.10.10";
	
	//Методы
	CW_ПодключаемыеКомандыСервер.УстановитьМетодыВнешнегоОбъекта(СтруктураОписания,	"Регистрация");
	CW_ПодключаемыеКомандыСервер.УстановитьМетодыВнешнегоОбъекта(СтруктураОписания,	"ОбработчикПриПроведении");
	//Методы
	
	Возврат СтруктураОписания;

КонецФункции

Функция Регистрация(СсылкаНаОбъект) Экспорт 
	
	Возврат(_УФКС.Ответ());
	
КонецФункции
