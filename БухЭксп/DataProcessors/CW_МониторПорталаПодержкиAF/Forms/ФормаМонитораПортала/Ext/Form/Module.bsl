&НаСервереБезКонтекста
Функция ТекстНадписиАвторизацияЛогинПароль(СтруктураДанных)
	
	мСтроки = Новый Массив;
	
	Если СтруктураДанных.АвторизацияВыполнена Тогда 
		мСтроки.Добавить(Новый ФорматированнаяСтрока("Авторизация выполнена успешно"));
	КонецЕсли;
	
	Если СтруктураДанных.ЛогинПолучен и СтруктураДанных.ПарольПолучен и НЕ СтруктураДанных.АвторизацияВыполнена Тогда 
		мСтроки.Добавить(Новый ФорматированнаяСтрока("Ошибка авторизации"));
		мСтроки.Добавить(Символы.ПС);
		мСтроки.Добавить(Новый ФорматированнаяСтрока("По причине: Логин и/или пароль указаны неверно и/или отсутствует подписка"));
	КонецЕсли;
	
	Если Не СтруктураДанных.ЛогинПолучен или НЕ СтруктураДанных.ПарольПолучен  Тогда 
		мСтроки.Добавить(Новый ФорматированнаяСтрока("Ошибка авторизации"));
		мСтроки.Добавить(Символы.ПС);
		мСтроки.Добавить(Новый ФорматированнаяСтрока("По причине: Логин и/или пароль не указаны"));
	КонецЕсли;

	Возврат Новый ФорматированнаяСтрока(мСтроки);		
	
КонецФункции

