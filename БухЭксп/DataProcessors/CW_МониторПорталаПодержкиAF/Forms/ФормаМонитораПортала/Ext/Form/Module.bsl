&НаСервере
Функция ПолучитьСтруктуруПараметров()
	
	РегистрационныйНомер 	= CW_ПроверкаЛицензии.ПолучитьРегистрационныйНомер();
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("РегистрационныйНомер", РегистрационныйНомер);
	
	Возврат СтруктураПараметров;
	
КонецФункции
