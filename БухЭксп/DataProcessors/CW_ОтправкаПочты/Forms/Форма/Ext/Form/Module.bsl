&НаКлиенте
Процедура ОткрытьФайл(Команда)
	
	СтрокаВложения = Вложения.НайтиПоИдентификатору(Элементы.Вложения.ТекущаяСтрока);
	ТипАдреса = _ОпределитьТипАдресаВложения(Элементы.Вложения.ТекущаяСтрока);
	
	Если ТипАдреса = "адрес"  или ТипАдреса = "путь"  Тогда  
		
		АдресВоВременномХранилище = СтрокаВложения.Адрес;
		
		//Заявка №AFR-240138 от 28.03.2024
		Если ТипАдреса = "путь" Тогда
			АдресВоВременномХранилище = ПолучитьАдресВоВременномХранилище(СтрокаВложения.Адрес);
		КонецЕсли;
		//Заявка №AFR-240138 от 28.03.2024
		
		ПараметрыДиалогаПолученияФайлов = Новый ПараметрыДиалогаПолученияФайлов;
		ПараметрыДиалогаПолученияФайлов.ВыборКаталога = Истина;
		
		НачатьПолучениеФайлаССервера(АдресВоВременномХранилище, СтрокаВложения.ИмяФайла, ПараметрыДиалогаПолученияФайлов);
		
	Иначе
		ПоказатьПредупреждение(,"Сохранение файла не доступно!");
	КонецЕсли; 
	
КонецПроцедуры  

