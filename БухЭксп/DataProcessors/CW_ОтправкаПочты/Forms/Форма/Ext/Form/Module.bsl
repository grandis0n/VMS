&НаКлиенте
Процедура ОбработкаВыбораФайлов(Ответ, ДополнительныеПараметры) Экспорт 
	// --- 
	
	Если (Ответ <> Неопределено) Тогда
		
		МассивПередаваемыхФайлов = Новый Массив;
		Для каждого ЭлементМассива Из Ответ Цикл
			
			МассивПередаваемыхФайлов.Добавить(Новый ОписаниеПередаваемогоФайла(ЭлементМассива));
			
		КонецЦикла; 
		// --- 
		Если (МассивПередаваемыхФайлов.Количество() <> 0) Тогда
			
			ПОВ = Новый ОписаниеОповещения("ОбработатьПомещениеФайлов",ЭтотОбъект, Новый Структура()); 
			НачатьПомещениеФайлов(ПОВ,МассивПередаваемыхФайлов,,Ложь,ЭтаФорма.УникальныйИдентификатор);
			
		КонецЕсли; 
		
	КонецЕсли; 
	
	// --- 
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьПомещениеФайлов(ПомещенныеФайлы, ДополнительныеПараметры) Экспорт 
	// --- 
	
	Если (ПомещенныеФайлы <> Неопределено) Тогда
		
		Модуль_РаботаСФайлами = CW_РаботаСФайламиКлиент.ПолучитьОбщийМодульРаботыСфайлами();
	
		Для каждого ПомещенныйФайл Из ПомещенныеФайлы Цикл
			
			ФайлОбъект = Новый Файл(ПомещенныйФайл.ПолноеИмя);
			// --- 
			Нстр = Вложения.Добавить();
			Нстр.ИмяФайла 		= ФайлОбъект.Имя;
			Нстр.ТипАдреса 		= "адрес";
			Нстр.Адрес 			= ПомещенныйФайл.Хранение;
			Нстр.Размер 		= ПриведенныйРазмер(ФайлОбъект.Размер());
			Нстр.ИндексКартинки = Модуль_РаботаСФайлами.ПолучитьИндексПиктограммыФайла(ФайлОбъект.Расширение);
			
		КонецЦикла; 
		
	КонецЕсли; 
	
	УстановитьЗаголовокКнопкиВложения();
	
КонецПроцедуры
  

