
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	
	Адрес = Неопределено;
	Параметры.Свойство("АдресТабличногоДокумента",Адрес);
	Если Адрес = Неопределено Тогда
		
		Отказ = Истина;
		Возврат;
		
	Иначе
		
		ТД.Вывести(ПолучитьИзВременногоХранилища(Адрес));
		
	КонецЕсли;
	
	ТД.АвтоМасштаб = Истина;
	ТД.ОриентацияСтраницы=ОриентацияСтраницы.Портрет;
	
КонецПроцедуры
