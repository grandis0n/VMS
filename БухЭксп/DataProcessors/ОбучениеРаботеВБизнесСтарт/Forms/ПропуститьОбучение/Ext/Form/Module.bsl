#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПропуститьОбучение(Команда)
	
	Результат = Новый Структура;
	Результат.Вставить("Причина", Причина);
	Результат.Вставить("Комментарий", Комментарий);
	Закрыть(Результат);
	
КонецПроцедуры

#КонецОбласти