
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ТекущаяВерсия 	= СокрЛП(CW_ОбновлениеКонфигурацииСервер.УстановленнаяВерсияПодсистемы());

	УстановитьДоступностьДляполныхПрав();
	
	ДанныеАутентификацииПользователя = CW_МониторПорталаПоддержкиСервер.ДанныеАутентификацииПользователяИнтернетПоддержки();
	Если ТипЗнч(ДанныеАутентификацииПользователя) = Тип("Структура") Тогда
		ДанныеАутентификацииПользователя.Свойство("Логин",  Логин);
		ДанныеАутентификацииПользователя.Свойство("Пароль", Пароль);
	КонецЕсли;

	//Автоматическая загрузка исправлений
	ЗагружатьИУстанавливатьИсправленияАвтоматически = Константы.CW_ЗагружатьИУстанавливатьИсправленияАвтоматически.Получить();  

	УстановитьПараметрыРегламентногоЗадания(
		Метаданные.РегламентныеЗадания.CW_ПолучениеИУстановкаИсправленийКонфигурации,
		"ДекорацияЗагрузкаИсправленийРасписание",
		ЗагружатьИУстанавливатьИсправленияАвтоматически);	
		
 	Элементы.ГруппаОтсутствуютИсправления.Видимость = ложь;
	//Автоматическая загрузка исправлений  

	//Автоматическая загрузка дополнений
	ЗагружатьИУстанавливатьДополненияАвтоматически = Константы.CW_ЗагружатьИУстанавливатьДополненияАвтоматически.Получить();  
	
	УстановитьПараметрыРегламентногоЗадания(
		Метаданные.РегламентныеЗадания.CW_ПолучениеИУстановкаДополненийКонфигурации,
		"ДекорацияЗагрузкаДополненияРасписание",
		ЗагружатьИУстанавливатьДополненияАвтоматически);	

	Элементы.ГруппаОтсутствуютДополнения.Видимость  = ложь;
	//Автоматическая загрузка дополнений  	
	
	Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаНачало;

КонецПроцедуры  

&НаСервере
Процедура УстановитьПараметрыРегламентногоЗадания(РегламетноеЗадание,ИмяРеквизитаРасписание,ЗагружатьИУстанавливатьАвтоматически)
	
	Задание = РегламентныеЗаданияСервер.ПолучитьРегламентноеЗадание(РегламетноеЗадание);
	Если Задание <> Неопределено Тогда
		Элементы[ИмяРеквизитаРасписание].Заголовок =
			ИнтернетПоддержкаПользователейКлиентСервер.ПредставлениеРасписания(Задание.Расписание);
	КонецЕсли;
	Элементы[ИмяРеквизитаРасписание].Видимость = ЗагружатьИУстанавливатьАвтоматически;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьДоступностьДляполныхПрав()
	
	ЭтоПользовательСПолнымиПравами 	= CW_ПраваДоступа.ПравоДоступно("ПолныеПрава");
	ТолькоПросмотр 					= Не ЭтоПользовательСПолнымиПравами;
	
	Элементы.КомандаПерезагрузить.Доступность = ЭтоПользовательСПолнымиПравами;
	Элементы.НадписьИсправляемыеОшибки.Доступность = ЭтоПользовательСПолнымиПравами;
	Элементы.КомандаЗагрузить.Доступность = ЭтоПользовательСПолнымиПравами;
	Элементы.ЗагружатьПатчи.Доступность = ЭтоПользовательСПолнымиПравами;

КонецПроцедуры 

&НаКлиенте
Процедура ЗагружатьПатчиПриИзменении(Элемент)
	
	ЗагружатьПатчиЗагружатьДополненияПриИзменениНаСервере();

КонецПроцедуры

&НаСервере
Процедура ЗагружатьПатчиЗагружатьДополненияПриИзменениНаСервере()
	
	Элементы.КомандаЗагрузить.Доступность = ЗагружатьПатчи ИЛИ ЗагружатьДополнения;
	Элементы.КомандаЗагрузить.КнопкаПоУмолчанию = истина;

КонецПроцедуры

&НаСервере
Процедура СохранитьСеансовуюНастройку()
	
	Если ЭтоПользовательСПолнымиПравами Тогда
		
		ВладелецДанных = CW_МониторПорталаПоддержкиСервер.ИдентификаторПодсистемы();
		Если ЗначениеЗаполнено(Логин) и ЗначениеЗаполнено(Пароль) Тогда
			ОбщегоНазначения.ЗаписатьДанныеВБезопасноеХранилище(ВладелецДанных, Логин, 	"login");
			ОбщегоНазначения.ЗаписатьДанныеВБезопасноеХранилище(ВладелецДанных, Пароль, "password");
		КонецЕсли;

	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	НужноВвестиЛогинИПароль = Не ЗначениеЗаполнено(Логин) и Не ЗначениеЗаполнено(Пароль);
	
	Если НужноВвестиЛогинИПароль Тогда
		Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаЛогинПароль;
	Иначе
		ПодключитьОбработчикОжидания("ВыполнитьПоискИсправлений",1,Истина);
	КонецЕсли;
	
КонецПроцедуры


&НаКлиенте
Процедура ВыполнитьПоискИсправлений()   
	
	ИсправленияПолучены = ПолучитьИсправленияНаСервере();
	Если ИсправленияПолучены = ЛОЖЬ Тогда
		ПоказатьПредупреждение(,"Не удалось получить исправления с портала обновлений! Попробуйте позже...");
		Возврат;
	КонецЕсли;   
	
	ПолучениеДополнений = Истина;
	ТекстОшибки = ПроверитьНаличиеДополненийНаСервере();
	Если ТекстОшибки <> "" Тогда
		ПолучениеДополнений = Ложь; 
		ДобавитьЗаписьЖурналаРегистрации("ПроверкаНаличияДополнений", ТекстОшибки)
	КонецЕсли;  
	
	//Исправления
	ЗагружатьПатчи = Исправления.Количество() > 0;
	
	Элементы.ГруппаОтсутствуютИсправления.Видимость = Не ЗагружатьПатчи;
	Элементы.ГруппаВыборИсправлений.Видимость 		= ЗагружатьПатчи;
	//Исправления  
	
	//Дополпнения
	Если ПолучениеДополнений Тогда
		ЗагружатьДополнения = Дополнения.Количество() > 0;
		
		Элементы.ГруппаОтсутствуютДополнения.Видимость  = Не ЗагружатьДополнения;
		Элементы.ГруппаВыборДополнений.Видимость 		= ЗагружатьДополнения;
	КонецЕсли;	
	//Дополпнения
	
	ЗагружатьПатчиЗагружатьДополненияПриИзменениНаСервере();
	УстановитьНадписиНаФорме();

	Элементы.Страницы.ТекущаяСтраница	= Элементы.СтраницаЗагрузка;
	
	Если Не ЗагружатьПатчи и Не ЗагружатьДополнения Тогда
		Элементы.Закрыть.КнопкаПоУмолчанию = истина;
	КонецЕсли;
	
КонецПроцедуры    

&НаСервере
Процедура ДобавитьЗаписьЖурналаРегистрации(ИмяСобытия, ТекстОшибки)
	
	ЗаписьЖурналаРегистрации(ИмяСобытия,,,,ТекстОшибки);

КонецПроцедуры


&НаСервере
Функция ПолучитьИсправленияНаСервере() 
	
	ТабИсправления = CW_ИсправленияКонфигурации.ПолучитьФайлыССервера(Логин, Пароль);
	
	Если ТабИсправления = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
		
	Исправления.Загрузить(ТабИсправления);
	
	Возврат Истина;
	
КонецФункции  

&НаСервере
Функция ПроверитьНаличиеДополненийНаСервере()
	
	ПараметрыПодключения = Новый Структура;
	ПараметрыПодключения.Вставить("АдресРесурса", 	CW_ИсправленияКонфигурации.СерверПроверкиНаличияДопонений());  

	Соединение = CW_ИсправленияКонфигурации.ПодключитьсяКСерверуПроверкиНаличияОбновлений(ПараметрыПодключения);
	Если Соединение = Неопределено Тогда
		//Не удалось подключиться к серверу
		Возврат Неопределено;
	КонецЕсли;                                             
	
	АдресРесурса = CW_ИсправленияКонфигурации.АдресРесурсаПроверкиНаличияДопонений() + 
			CW_ИсправленияКонфигурации.ИмяZIPфайлаШаблонаДополнений();
			
	ЛокальныйПуть = КаталогВременныхФайлов()+CW_ИсправленияКонфигурации.ИмяZIPфайлаШаблонаДополнений();  
	                    
	Ошибка = CW_ИсправленияКонфигурации.ПолучитьФайлССервера(АдресРесурса, ЛокальныйПуть, Соединение);  
	Если Ошибка <> "" Тогда
		Возврат Ошибка;
	КонецЕсли; 
	
	ТаблицаДоступныхДополнений = CW_ИсправленияКонфигурации.ОбработатьZIPФайлДополнений(ЛокальныйПуть);
	
	Дополнения.Загрузить(ТаблицаДоступныхДополнений); 
	
	Возврат "";
	
КонецФункции

&НаКлиенте
Процедура УстановитьНадписиНаФорме()
	
	Результат	= ПолучитьКоличествоИсправленоВыбрано();
	РазмерФайлов 									= Исправления.Итог("Размер")/1024;
	Элементы.РазмерИсправлений.Видимость 			= РазмерФайлов <> 0;
	Элементы.РазмерИсправлений.Заголовок 			= Формат(РазмерФайлов,"ЧДЦ=2; ЧГ=0")+" Кб";
	Элементы.НадписьИсправляемыеОшибки.Заголовок 	= "Исправляемые ошибки ("+Результат.Выбрано+" из "+Результат.Всего+")";
	Элементы.НадписьДляКонфигурации.Заголовок 		= "Версия конфигурации: " + ТекущаяВерсия;
	
	Результат	= ПолучитьКоличествоДоплоненийВыбрано();
	РазмерФайлов										= Дополнения.Итог("Размер")/1024;
	Элементы.РазмерДополнений.Видимость					= РазмерФайлов <> 0;
	Элементы.РазмерДополнений.Заголовок					= Формат(РазмерФайлов,"ЧДЦ=2; ЧГ=0")+" Кб";
	Элементы.НадписьВыбранныеДополнения.Заголовок		= "Дополнения к загрузке ("+Результат.Выбрано+" из "+Результат.Всего+")";
	Элементы.НадписьДляКонфигурацииДополнения.Заголовок	= "Версия конфигурации: " + ТекущаяВерсия;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьКоличествоДоплоненийВыбрано()
	
	Результат = Новый Структура;
	Результат.Вставить("Всего", Дополнения.Количество());
	
	Отбор = Новый Структура("Отметка", Истина);
	мСтроки = Дополнения.НайтиСтроки(Отбор);
	Результат.Вставить("Выбрано", мСтроки.Количество());

	Возврат Результат;
	
КонецФункции   

&НаСервере
Функция ПолучитьКоличествоИсправленоВыбрано()
	
	Результат = Новый Структура;
	Результат.Вставить("Всего", Исправления.Количество());
	
	Отбор = Новый Структура("Отметка", Истина);
	мСтроки = Исправления.НайтиСтроки(Отбор);
	Результат.Вставить("Выбрано", мСтроки.Количество());

	Возврат Результат;
	
КонецФункции 


&НаКлиенте
Процедура КомандаЗагрузить(Команда)
	
	Если ЗагружатьПатчи Тогда
		ОбработатьРасширенияНаСервере();
		ЗагружатьПатчи = Ложь;   
	КонецЕсли; 
	
	Если ЗагружатьДополнения Тогда
		ЗагрузитьДополненияКонфигурации();
		ЗагружатьДополнения = истина;
	КонецЕсли;
	
	ЗагружатьПатчиЗагружатьДополненияПриИзменениНаСервере();
	
	Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаЗавершениеЗагрузки;
	Элементы.КомандаПерезагрузить.КнопкаПоУмолчанию = истина;

КонецПроцедуры

&НаСервере
Процедура ОбработатьРасширенияНаСервере()
	
	Отбор 	= Новый Структура("Отметка", Истина);
	мСтроки = Исправления.НайтиСтроки(Отбор);
	
	Для Каждого СтрокаИсправления из мСтроки Цикл
		
		Если ЗначениеЗаполнено(СтрокаИсправления.Удаляемые) Тогда
			мУдаляемые = СтрРазделить(СтрокаИсправления.Удаляемые,";", Ложь);
			CW_ИсправленияКонфигурации.УдалитьРасширения(мУдаляемые);
		КонецЕсли;
		
		Попытка
			ДвоичныеДанные = ПолучитьИзВременногоХранилища(СтрокаИсправления.АдресФайла);
			
			Расширение = РасширенияКонфигурации.Создать();
			Справочники.ВерсииРасширений.ОтключитьПредупрежденияБезопасности(Расширение);
			Справочники.ВерсииРасширений.ОтключитьИспользованиеОсновныхРолейДляВсехПользователей(Расширение);
			Расширение.БезопасныйРежим = Ложь;
			Расширение.ИспользуетсяВРаспределеннойИнформационнойБазе = Истина;
			Расширение.Записать(ДвоичныеДанные);
		Исключение
		КонецПопытки;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьДополненияКонфигурации()
	
	УстановитьПривилегированныйРежим(Истина);
	
	Отбор 	= Новый Структура("Отметка", Истина);
	мСтроки = Дополнения.НайтиСтроки(Отбор);
	
	Для Каждого СтрокаИсправления из мСтроки Цикл   
		
		АдресРесурса  = СтрокаИсправления.АдресФайла; 
		ИмяZIPФайла   = CW_ИсправленияКонфигурации.ПолучитьИмяФайлаИзПути(АдресРесурса);
		ЛокальныйПуть = КаталогВременныхФайлов()+ИмяZIPФайла;  
		
		FTPСоединение = CW_ИсправленияКонфигурации.ПодключитьсяКРесурусуОбновлений(Логин, Пароль);
		Если FTPСоединение = Неопределено Тогда
			//Не удалось подключиться к серверу
			Продолжить;;
		КонецЕсли;                                             
		
		Ошибка = CW_ИсправленияКонфигурации.ПолучитьФайлССервера(АдресРесурса, ЛокальныйПуть, FTPСоединение);  
		Если Ошибка <> "" Тогда
			Продолжить;
		КонецЕсли;    
		
		ФайлАрхива = Новый Файл(ЛокальныйПуть);
		Если ФайлАрхива.Существует()Тогда    
			
			ИмяФайлаЗагрузки = CW_ИсправленияКонфигурации.РаспаковатьАрхив(ЛокальныйПуть, ФайлАрхива.ИмяБезРасширения+".cfe");
			
			//Удаляем одноименное раширение, если есть
			мУдаляемые = Новый Массив;
			мУдаляемые.Добавить(ФайлАрхива.ИмяБезРасширения);
			CW_ИсправленияКонфигурации.УдалитьРасширения(мУдаляемые);
			//Удаляем одноименное раширение, если есть
			
			Попытка
				ДвоичныеДанные = Новый ДвоичныеДанные(ИмяФайлаЗагрузки);
				
				Расширение = РасширенияКонфигурации.Создать();
				
				Справочники.ВерсииРасширений.ОтключитьПредупрежденияБезопасности(Расширение);
				Справочники.ВерсииРасширений.ОтключитьИспользованиеОсновныхРолейДляВсехПользователей(Расширение);
				
				Расширение.БезопасныйРежим = Ложь;
				Расширение.ИспользуетсяВРаспределеннойИнформационнойБазе = Истина;
				Расширение.Записать(ДвоичныеДанные); 
				
			Исключение
			КонецПопытки; 
			
			УдалитьФайлы(ИмяФайлаЗагрузки);
			
		КонецЕсли;
			
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура НадписьИсправляемыеОшибкиНажатие(Элемент)
	
	АдресИсправлений = ПолучитьАдресИсправлений();
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("АдресТаблицы", АдресИсправлений); 
	ПараметрыФормы.Вставить("Режим", 		"ИСПРАВЛЕНИЯ"); 
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Режим",	"ИСПРАВЛЕНИЯ");      
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ОбработатьВыборИсправленийДополнений",ЭтотОбъект, ДополнительныеПараметры);
	
	ОткрытьФорму("ОбщаяФорма.CW_ФормаВыбораИсправлений", ПараметрыФормы, ЭтаФорма,,,,ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры 

&НаКлиенте
Процедура НадписьВыбранныеДополненияНажатие(Элемент)
	
	АдресДополнений = ПолучитьАдресДополнений();
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("АдресТаблицы", АдресДополнений);
	ПараметрыФормы.Вставить("Режим", 		"ДОПОЛНЕНИЯ");      
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Режим",	"ДОПОЛНЕНИЯ");      
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ОбработатьВыборИсправленийДополнений",ЭтотОбъект, ДополнительныеПараметры);
	
	ОткрытьФорму("ОбщаяФорма.CW_ФормаВыбораИсправлений", ПараметрыФормы, ЭтаФорма,,,,ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры


&НаСервере
Функция ПолучитьАдресИсправлений()
	
	Возврат ПоместитьВоВременноеХранилище(Исправления.Выгрузить());
	
КонецФункции

&НаСервере
Функция ПолучитьАдресДополнений()
	
	Возврат ПоместитьВоВременноеХранилище(Дополнения.Выгрузить());
	
КонецФункции

&НаКлиенте
Процедура ОбработатьВыборИсправленийДополнений(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ <> Неопределено Тогда
		
		ОбрабтатьВыборНаСервере(Ответ, ДополнительныеПараметры);
		УстановитьНадписиНаФорме();
		
	КонецЕсли;
	
	
КонецПроцедуры

&НаСервере
Процедура ОбрабтатьВыборНаСервере(Ответ, ДополнительныеПараметры)
	
	ТаблицаРасширений = ПолучитьИзВременногоХранилища(Ответ);
	
	Если ДополнительныеПараметры.Режим = "ИСПРАВЛЕНИЯ" Тогда  
		Исправления.Загрузить(ТаблицаРасширений);
		ЗагружатьПатчи	=  Исправления.Количество() > 0;  
	КонецЕсли;
	
	Если ДополнительныеПараметры.Режим = "ДОПОЛНЕНИЯ" Тогда  
		Дополнения.Загрузить(ТаблицаРасширений);
		ЗагружатьДополнения	=  Дополнения.Количество() > 0;  
	КонецЕсли;
	
	ЗагружатьПатчиЗагружатьДополненияПриИзменениНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаПерезагрузить(Команда)
	
	ПредложитьПерезагрузкуПрограммыПриОбновленииКонфигурации();
	
КонецПроцедуры

&НаКлиенте
Процедура ПредложитьПерезагрузкуПрограммыПриОбновленииКонфигурации()

   // По завершении сеанса необходимо начать новый сеанс
    глНеобходимостьПерезапуска = Истина;

   // Попробуем перезапустить
    ЗавершитьРаботуСистемы(Истина,Истина); 


КонецПроцедуры

&НаКлиенте
Процедура КомандаПоказатьУстановленные(Команда)
	
	ОткрытьФорму("ОбщаяФорма.CW_УстановленныеИсправления",,ЭтаФорма,,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры


//Автоматическая загрузка исправлений
&НаКлиенте
Процедура ДекорацияЗагрузкаИсправленийРасписаниеНажатие(Элемент)
	
	Расписание = CW_ИсправленияКонфигурации.РасписаниеЗаданияУстановкиИсправлений();
	ДиалогРасписание = Новый ДиалогРасписанияРегламентногоЗадания(Расписание);
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ПриИзмененииРасписанияУстановкиИсправлений",
		ЭтотОбъект);
	ДиалогРасписание.Показать(ОписаниеОповещения);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииРасписанияУстановкиИсправлений(Расписание, Форма) Экспорт
	
	Если Расписание = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПериодПовтораВТечениеДня = Расписание.ПериодПовтораВТечениеДня;
	Если ПериодПовтораВТечениеДня > 0
		И ПериодПовтораВТечениеДня < 3600 Тогда
		ПоказатьПредупреждение(,
			НСтр("ru = 'Интервал автоматической установки не может быть чаще, чем один раз в час.'"));
		Возврат;
	КонецЕсли;
	
	CW_ИсправленияКонфигурации.УстановитьРасписаниеЗаданияУстановкиИсправлений(Расписание);
	
	Элементы.ДекорацияЗагрузкаИсправленийРасписание.Заголовок =
		ИнтернетПоддержкаПользователейКлиентСервер.ПредставлениеРасписания(Расписание);
	
КонецПроцедуры

&НаКлиенте
Процедура ДекорацияЗагрузкаДополненийРасписаниеНажатие(Элемент)
	
	Расписание = CW_ИсправленияКонфигурации.РасписаниеЗаданияУстановкиДополнений();
	ДиалогРасписание = Новый ДиалогРасписанияРегламентногоЗадания(Расписание);
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ПриИзмененииРасписанияУстановкиДополнений",
		ЭтотОбъект);
	ДиалогРасписание.Показать(ОписаниеОповещения);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииРасписанияУстановкиДополнений(Расписание, Форма) Экспорт
	
	Если Расписание = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПериодПовтораВТечениеДня = Расписание.ПериодПовтораВТечениеДня;
	Если ПериодПовтораВТечениеДня > 0
		И ПериодПовтораВТечениеДня < 3600 Тогда
		ПоказатьПредупреждение(,
			НСтр("ru = 'Интервал автоматической установки не может быть чаще, чем один раз в час.'"));
		Возврат;
	КонецЕсли;
	
	CW_ИсправленияКонфигурации.УстановитьРасписаниеЗаданияУстановкиДополнений(Расписание);
	
	Элементы.ДекорацияЗагрузкаДополненияРасписание.Заголовок =
		ИнтернетПоддержкаПользователейКлиентСервер.ПредставлениеРасписания(Расписание);
	
КонецПроцедуры


&НаКлиенте
Процедура ИспользуетсяАвтоматическаяЗагрзукаИсправленийПриИзменении(Элемент)
	
	CW_ИсправленияКонфигурации.ВключитьОтключитьАвтоматическуюУстановкуИсправлений(ЗагружатьИУстанавливатьИсправленияАвтоматически);
	Элементы.ДекорацияЗагрузкаИсправленийРасписание.Видимость =	ЗагружатьИУстанавливатьИсправленияАвтоматически;
	
КонецПроцедуры 

&НаКлиенте
Процедура ИспользуетсяАвтоматическаяЗагрзукаДополненийПриИзменении(Элемент)
	
	CW_ИсправленияКонфигурации.ВключитьОтключитьАвтоматическуюУстановкуДополнений(ЗагружатьИУстанавливатьДополненияАвтоматически);
	Элементы.ДекорацияЗагрузкаДополненияРасписание.Видимость =	ЗагружатьИУстанавливатьДополненияАвтоматически;
	
КонецПроцедуры

