&НаКлиенте
Процедура ПодстрокаПоискаПриИзменении(Элемент)
	
	_ВыполнитьПоиск();
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаНайти(Команда)
	
	_ВыполнитьПоиск();
	
КонецПроцедуры

&НаКлиенте
Процедура НеИскатьЗначениеПараметраПоЗаказамПриИзменении(Элемент)
	
	СП = _ДС().СоответствиеПараметров.Получить(ПараметрПоиска);
	УстановитьВидимостьЭлементовПоискаПопараметрамЗаказа(СП.Значение);
	
	_ВыполнитьПоиск();
	
КонецПроцедуры


&НаСервере
Процедура _ВыполнитьПоиск()
	
	Если СокрЛП(ПодстрокаПоиска)="" Тогда
		
		Возврат;
		
	КонецЕсли; 
	
	// Определим подстроку поиска
	//---------------------------------------------------------------------------------------
	
	СП = _ДС().СоответствиеПараметров.Получить(ПараметрПоиска);
	
	Подстрока_2 = Неопределено;
	
	ИскатьВЗаказах = Ложь;
	
	Если СП.Представление = "Грузоперевозка" Тогда
		
		ПараметрГП = ПланыВидовХарактеристик.CW_ПараметрыГрузоперевозок.Служебный;
		СтрокаУсловия = " И	CW_ХарактеристикиГрузоперевозок.Грузоперевозка.CW_Представление ПОДОБНО &Подстрока";
		Подстрока = Строка("%"+СокрЛП(ПодстрокаПоиска)+"%");
		
	ИначеЕсли СП.Представление = "Заказ" Тогда 
		
		ПараметрГП = ПланыВидовХарактеристик.CW_ПараметрыГрузоперевозок.Служебный;
		СтрокаУсловия = " И CW_ХарактеристикиГрузоперевозок.Грузоперевозка.Заказ.Наименование ПОДОБНО &Подстрока"; 
		Подстрока = Строка("%"+СокрЛП(ПодстрокаПоиска)+"%");
		
	ИначеЕсли (СП.Представление = "Клиент") Тогда 
		
		ПараметрГП = ПланыВидовХарактеристик.CW_ПараметрыГрузоперевозок.Служебный;
		СтрокаУсловия = " И CW_ХарактеристикиГрузоперевозок.Грузоперевозка.Клиент = &Подстрока"; 
		Подстрока = ПодстрокаПоиска; 
		
	ИначеЕсли (СП.Представление = "Дата грузоперевозки (В интервале)") Тогда 
		
		ПараметрГП = ПланыВидовХарактеристик.CW_ПараметрыГрузоперевозок.Служебный;
		СтрокаУсловия = " И	CW_ХарактеристикиГрузоперевозок.Грузоперевозка.ДатаСделкиФ МЕЖДУ &Подстрока И &Подстрока_2"; 
		Подстрока 	= ПодстрокаПоиска.ДатаНачала; 
		Подстрока_2 = ПодстрокаПоиска.ДатаОкончания; 
		
	ИначеЕсли (СП.Представление = "Дата грузоперевозки (По значению)") Тогда 
		
		ПараметрГП = ПланыВидовХарактеристик.CW_ПараметрыГрузоперевозок.Служебный;
		СтрокаУсловия = " И	CW_ХарактеристикиГрузоперевозок.Грузоперевозка.ДатаСделкиФ = &Подстрока"; 
		Подстрока = ПодстрокаПоиска; 
		
	Иначе
		
		//ищем в заказах только если указано значение параметра
		ИскатьВЗаказах = Не НеИскатьЗначениеПараметраПоЗаказам; 
		
		Параметр 	= СП.Значение;
		ПараметрГП 	= Параметр;
		Если Параметр.ТипЗначения.Типы()[0] = Тип("Строка") Тогда
			
			СтрокаУсловия = " И CW_ХарактеристикиГрузоперевозок.Значение ПОДОБНО &Подстрока ";
			Подстрока = Строка("%"+СокрЛП(ПодстрокаПоиска)+"%");
			
			СтрокаУсловияДляЗаказов = " И CW_ХарактеристикиЗаказов.Значение ПОДОБНО &Подстрока ";
			Подстрока = Строка("%"+СокрЛП(ПодстрокаПоиска)+"%");
		
		Иначе
			
			СтрокаУсловия = "И CW_ХарактеристикиГрузоперевозок.Значение = &Подстрока";
			Подстрока = ПодстрокаПоиска;
			
			СтрокаУсловияДляЗаказов = "И CW_ХарактеристикиЗаказов.Значение = &Подстрока";
			Подстрока = ПодстрокаПоиска;
		
		КонецЕсли;
		
	КонецЕсли;
	
	Запрос = Новый Запрос;     //"+СтрокаУсловия+"
	Запрос.МенеджерВременныхТаблиц = новый МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("ПараметрГП", 	ПараметрГП);
	Запрос.УстановитьПараметр("Подстрока", 		Подстрока);
	Запрос.УстановитьПараметр("Подстрока_2", 	Подстрока_2);
	
	Если ИскатьВЗаказах Тогда
		Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		               |	CW_Грузоперевозки.Ссылка КАК Ссылка,
		               |	CW_ХарактеристикиЗаказов.Заказ КАК Заказ,
		               |	CW_ХарактеристикиЗаказов.Значение КАК Параметр,
		               |	ИСТИНА КАК ПоЗаказу
		               |ПОМЕСТИТЬ ВТ_ГрузоперевозокиПоЗначениюПараметраЗаказа
		               |ИЗ
		               |	РегистрСведений.CW_ХарактеристикиЗаказов КАК CW_ХарактеристикиЗаказов
		               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.CW_Грузоперевозки КАК CW_Грузоперевозки
		               |		ПО CW_ХарактеристикиЗаказов.Заказ = CW_Грузоперевозки.Заказ
		               |ГДЕ
		               |	CW_ХарактеристикиЗаказов.Параметр = &ПараметрГП 
					   |	"+СтрокаУсловияДляЗаказов+"
		               |
		               |СГРУППИРОВАТЬ ПО
		               |	CW_ХарактеристикиЗаказов.Значение,
		               |	CW_Грузоперевозки.Ссылка,
		               |	CW_ХарактеристикиЗаказов.Заказ";
		
	Иначе
		//Просто пустая таблица, чтобы не было ошибок в запросе с отсутствием временной таблицы
		Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 0
		               |	ЗНАЧЕНИЕ(Справочник.CW_Грузоперевозки.ПустаяСсылка) КАК Ссылка,
		               |	ЗНАЧЕНИЕ(Справочник.CW_Заказы.ПустаяСсылка) КАК Заказ,
		               |	НЕОПРЕДЕЛЕНО КАК Параметр,
		               |	ИСТИНА КАК ПоЗаказу
		               |ПОМЕСТИТЬ ВТ_ГрузоперевозокиПоЗначениюПараметраЗаказа
		               |ИЗ
		               |	РегистрСведений.CW_ХарактеристикиЗаказов КАК CW_ХарактеристикиЗаказов";
	КонецЕсли;
	
	Запрос.Выполнить();
	
	Запрос.Текст = 	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
					|	CW_ХарактеристикиГрузоперевозок.Грузоперевозка КАК Ссылка,
					|	CW_ХарактеристикиГрузоперевозок.Грузоперевозка.Заказ КАК Заказ,
					|	CW_ХарактеристикиГрузоперевозок.Значение КАК Параметр,
		            |	ЛОЖЬ КАК ПоЗаказу
					|ПОМЕСТИТЬ ВТ_ГрузоперевозкиПоЗначениюПараметра
					|ИЗ
					|	РегистрСведений.CW_ХарактеристикиГрузоперевозок КАК CW_ХарактеристикиГрузоперевозок
					|ГДЕ
					|	CW_ХарактеристикиГрузоперевозок.Параметр = &ПараметрГП 
					|	"+СтрокаУсловия+"
					|
					|СГРУППИРОВАТЬ ПО
					|	CW_ХарактеристикиГрузоперевозок.Грузоперевозка,
					|	CW_ХарактеристикиГрузоперевозок.Значение
					|
					|ИНДЕКСИРОВАТЬ ПО
					|	Ссылка";
	
	Запрос.Выполнить();
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	ВТ_ГрузоперевозкиПоЗначениюПараметра.Ссылка КАК Ссылка,
	               |	ВТ_ГрузоперевозкиПоЗначениюПараметра.Заказ КАК Заказ,
	               |	ВТ_ГрузоперевозкиПоЗначениюПараметра.Параметр КАК Параметр,
	               |	ВТ_ГрузоперевозкиПоЗначениюПараметра.ПоЗаказу КАК ПоЗаказу,
	               |	ВЫБОР
	               |		КОГДА ВТ_ГрузоперевозкиПоЗначениюПараметра.Заказ = ЗНАЧЕНИЕ(Справочник.CW_Заказы.ПустаяСсылка)
	               |			ТОГДА ВТ_ГрузоперевозкиПоЗначениюПараметра.Ссылка
	               |		ИНАЧЕ ВТ_ГрузоперевозкиПоЗначениюПараметра.Заказ
	               |	КОНЕЦ КАК АналитикаЗакрытия
	               |ПОМЕСТИТЬ ВТ_ОсновноеУсловие
	               |ИЗ
	               |	ВТ_ГрузоперевозкиПоЗначениюПараметра КАК ВТ_ГрузоперевозкиПоЗначениюПараметра
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ВТ_ГрузоперевозокиПоЗначениюПараметраЗаказа.Ссылка,
	               |	ВТ_ГрузоперевозокиПоЗначениюПараметраЗаказа.Заказ,
	               |	ВТ_ГрузоперевозокиПоЗначениюПараметраЗаказа.Параметр,
	               |	ВТ_ГрузоперевозокиПоЗначениюПараметраЗаказа.ПоЗаказу КАК ПоЗаказу,
	               |	ВЫБОР
	               |		КОГДА ВТ_ГрузоперевозокиПоЗначениюПараметраЗаказа.Заказ = ЗНАЧЕНИЕ(Справочник.CW_Заказы.ПустаяСсылка)
	               |			ТОГДА ВТ_ГрузоперевозокиПоЗначениюПараметраЗаказа.Ссылка
	               |		ИНАЧЕ ВТ_ГрузоперевозокиПоЗначениюПараметраЗаказа.Заказ
	               |	КОНЕЦ
	               |ИЗ
	               |	ВТ_ГрузоперевозокиПоЗначениюПараметраЗаказа КАК ВТ_ГрузоперевозокиПоЗначениюПараметраЗаказа
	               |ГДЕ
	               |	ВТ_ГрузоперевозокиПоЗначениюПараметраЗаказа.Ссылка <> ЗНАЧЕНИЕ(Справочник.CW_Грузоперевозки.ПустаяСсылка)";
	
	Запрос.Выполнить();
	
	Запрос.Текст = "УНИЧТОЖИТЬ ВТ_ГрузоперевозокиПоЗначениюПараметраЗаказа";
	Запрос.Выполнить();
	Запрос.Текст = "УНИЧТОЖИТЬ ВТ_ГрузоперевозкиПоЗначениюПараметра";
	Запрос.Выполнить();

	Запрос.Текст = "ВЫБРАТЬ
	               |	ВТ_ОсновноеУсловие.Ссылка.Код КАК Номер,
	               |	ВТ_ОсновноеУсловие.Ссылка.CW_Представление КАК Представление,
	               |	ВТ_ОсновноеУсловие.Ссылка.ДатаСделкиФ КАК Дата,
	               |	ВТ_ОсновноеУсловие.Ссылка.Клиент КАК Клиент,
	               |	ВТ_ОсновноеУсловие.Ссылка КАК Ссылка,
	               |	ВТ_ОсновноеУсловие.Ссылка.ПометкаУдаления КАК ПометкаУдаления,
	               |	ВТ_ОсновноеУсловие.Заказ КАК Заказ,
	               |	ВТ_ОсновноеУсловие.АналитикаЗакрытия КАК АналитикаЗакрытия,
	               |	ВТ_ОсновноеУсловие.Параметр КАК Параметр,
	               |	МИНИМУМ(ВТ_ОсновноеУсловие.ПоЗаказу) КАК ПоЗаказу
	               |ПОМЕСТИТЬ ВТ_Свернуто
	               |ИЗ
	               |	ВТ_ОсновноеУсловие КАК ВТ_ОсновноеУсловие
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ВТ_ОсновноеУсловие.Ссылка.CW_Представление,
	               |	ВТ_ОсновноеУсловие.Ссылка.ПометкаУдаления,
	               |	ВТ_ОсновноеУсловие.Ссылка,
	               |	ВТ_ОсновноеУсловие.Заказ,
	               |	ВТ_ОсновноеУсловие.Ссылка.Код,
	               |	ВТ_ОсновноеУсловие.АналитикаЗакрытия,
	               |	ВТ_ОсновноеУсловие.Ссылка.ДатаСделкиФ,
	               |	ВТ_ОсновноеУсловие.Ссылка.Клиент,
	               |	ВТ_ОсновноеУсловие.Параметр";
	
	Запрос.Выполнить();
	
	Запрос.Текст = "УНИЧТОЖИТЬ ВТ_ОсновноеУсловие";
	Запрос.Выполнить();
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	ВТ_Свернуто.Номер КАК Номер,
	               |	ВТ_Свернуто.Представление КАК Представление,
	               |	ВТ_Свернуто.Дата КАК Дата,
	               |	ВТ_Свернуто.Клиент КАК Клиент,
	               |	ВТ_Свернуто.Ссылка КАК Ссылка,
	               |	ВТ_Свернуто.Заказ КАК Заказ,
	               |	ВТ_Свернуто.ПоЗаказу КАК ПоЗаказу,
	               |	ВТ_Свернуто.АналитикаЗакрытия КАК АналитикаЗакрытия,
	               |	ВТ_Свернуто.Параметр КАК Параметр,
	               |	ВЫБОР
	               |		КОГДА CW_ЗакрытиеФинансов.ДатаЗакрытия ЕСТЬ NULL
	               |			ТОГДА ЛОЖЬ
	               |		ИНАЧЕ ИСТИНА
	               |	КОНЕЦ КАК ПризнакЗакрытия,
	               |	ВЫБОР
	               |		КОГДА ВТ_Свернуто.ПометкаУдаления
	               |			ТОГДА 4
	               |		ИНАЧЕ 3
	               |	КОНЕЦ + ВЫБОР
	               |		КОГДА CW_ЗакрытиеФинансов.ДатаЗакрытия ЕСТЬ NULL
	               |			ТОГДА 0
	               |		ИНАЧЕ 5
	               |	КОНЕЦ КАК ИндексКартинки
	               |ИЗ
	               |	ВТ_Свернуто КАК ВТ_Свернуто
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.CW_ЗакрытиеФинансов КАК CW_ЗакрытиеФинансов
	               |		ПО ВТ_Свернуто.АналитикаЗакрытия = CW_ЗакрытиеФинансов.Аналитика
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Дата УБЫВ,
	               |	Номер УБЫВ";
	
	РезультатЗапроса = запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	ВТ_Свернуто.Ссылка КАК Ссылка
	               |ИЗ
	               |	ВТ_Свернуто КАК ВТ_Свернуто";
	РезультатЗапроса =Запрос.Выполнить();
	
	мГрузоперевозки = РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("Ссылка");
	
	ВыбранныеКолонки 						= ПолучитьМассивВыбранныхКолонок();
	ВыборкаЗначенийДополнительныхКолонок 	= ПолучитьЗначенияДополнительныхКолонокТаблицыПодбора(ВыбранныеКолонки, мГрузоперевозки); 	
	СоответствиеПараметров 					= _ДС().СоответствиеПараметров;	

	РезультатПоиска.Очистить();
	Пока Выборка.Следующий() Цикл
		
		Если ИсключитьЗакрытыеПоФинансам и Выборка.ПризнакЗакрытия Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = РезультатПоиска.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		
		ЗаполнитьЗначенияДопонительныхКолонокПоСтроке(НоваяСтрока, ВыборкаЗначенийДополнительныхКолонок, ВыбранныеКолонки, СоответствиеПараметров);

	КонецЦикла;
	
	Количество = РезультатПоиска.Количество();
	Элементы.ГруппаПоиск.Заголовок = "Поиск"+?(Количество=0,""," ("+Формат(Количество,"ЧЦ=15; ЧДЦ=0; ЧГ=")+")");
	
КонецПроцедуры

&НаСервере
Функция ПолучитьМассивВыбранныхКолонок()
	
	ВыбранныеКолонки = новый Массив;
	Для Каждого ЭлементСписка из СписокДопКолонок Цикл
		Если ЭлементСписка.Пометка Тогда
			ВыбранныеКолонки.Добавить(ЭлементСписка.Значение);	
		КонецЕсли;
	КонецЦикла;
	
	Возврат ВыбранныеКолонки;

КонецФункции

&НаСервере
Процедура ЗаполнитьЗначенияДополнительныхКолонок(ИмяТаблицы, мГрузоперевозки)
	
	ТаблицаФормы 							= ЭтаФорма[ИмяТаблицы];
	ВыбранныеКолонки 						= ПолучитьМассивВыбранныхКолонок();
	ВыборкаЗначенийДополнительныхКолонок 	= ПолучитьЗначенияДополнительныхКолонокТаблицыПодбора(ВыбранныеКолонки, мГрузоперевозки); 	
	СоответствиеПараметров 					= _ДС().СоответствиеПараметров;	
	
	Для каждого Строкатаблицы Из ТаблицаФормы Цикл
		ЗаполнитьЗначенияДопонительныхКолонокПоСтроке(Строкатаблицы, ВыборкаЗначенийДополнительныхКолонок, ВыбранныеКолонки, СоответствиеПараметров);
	КонецЦикла;	
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьЗначенияДопонительныхКолонокПоСтроке(ТекущаяСтрока, Знач ВыборкаЗначенийДополнительныхКолонок, Знач ВыбранныеКолонки, Знач СоответствиеПараметров)
	
	Для Каждого ЭлементМассива из ВыбранныеКолонки Цикл
		СтрокаСоответствия = СоответствиеПараметров.Получить(ЭлементМассива);
		
		Если СтрокаСоответствия.ЭтоПараметр Тогда
			ОтборВыборки = Новый Структура("Грузоперевозка,Параметр",ТекущаяСтрока.Ссылка,СтрокаСоответствия.Значение); 
		Иначе
			ОтборВыборки = Новый Структура("Грузоперевозка",ТекущаяСтрока.Ссылка); 
		КонецЕсли;
		
		Если  ВыборкаЗначенийДополнительныхКолонок <> Неопределено Тогда
			ВыборкаЗначенийДополнительныхКолонок.Сбросить();
			Если ВыборкаЗначенийДополнительныхКолонок.НайтиСледующий(ОтборВыборки) Тогда
				Если СтрокаСоответствия.ЭтоПараметр Тогда
					ТекущаяСтрока["_"+ЭлементМассива] =	ВыборкаЗначенийДополнительныхКолонок.Значение;
				Иначе
					ТекущаяСтрока["_"+ЭлементМассива] = ВыборкаЗначенийДополнительныхКолонок[СтрокаСоответствия.Значение];
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры   

&НаКлиенте
Процедура РезультатПоискаВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	// --- 
	Если РежимДвойногоКлика=ПредопределенноеЗначение("Перечисление.CW_ОбработкаДвойногоКликаВПодборе.Выбор") Тогда
		
		Выбор();
		
	ИначеЕсли РежимДвойногоКлика=ПредопределенноеЗначение("Перечисление.CW_ОбработкаДвойногоКликаВПодборе.Подбор") Тогда 
		
