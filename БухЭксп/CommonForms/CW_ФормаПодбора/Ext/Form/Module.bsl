&НаСервере
Процедура ОбработатьРезультатВыбораКолонок(Результат)
	
	Если ЭтоАдресВременногоХранилища(Результат) Тогда
		
		СписокКолонок = ПолучитьИзВременногоХранилища(Результат);
		СписокДопКолонок.Очистить();
		Для Каждого ЭлементСписка из СписокКолонок Цикл
			СписокДопКолонок.Добавить(ЭлементСписка.Значение, ЭлементСписка.Представление, ЭлементСписка.Пометка);
		КонецЦикла;
		
		ДополнитьКолонкиПоиска();
		
		ЗаполнитьЗначенияДополнительныхКолонок("РезультатПоиска",РезультатПоиска.Выгрузить().ВыгрузитьКолонку("Ссылка"));
		ЗаполнитьЗначенияДополнительныхКолонок("ТаблицаПодбора"	,ТаблицаПодбора.Выгрузить().ВыгрузитьКолонку("Ссылка"));

		
	КонецЕсли;
	                                 
КонецПроцедуры

&наСервере
Процедура ДополнитьКолонкиПоиска()
	
    МассивДобавляемыхКолонокРезультатПоиска = Новый Массив;
	МассивУдаляемыхКолонокРезультатПоиска 	 = Новый Массив;
	
	МассивДобавляемыхКолонокТаблицаПодбора = Новый Массив;
	МассивУдаляемыхКолонокТаблицаПодбора   = Новый Массив;
	
	мТипыРеквизитв = Новый Массив;
	мТипыРеквизитв.Добавить(Тип("Строка"));
	мТипыРеквизитв.Добавить(Тип("Число"));
	мТипыРеквизитв.Добавить(Тип("Дата"));
	мТипыРеквизитв.Добавить(Тип("Булево"));
	мТипыРеквизитв.Добавить(Справочники.ТипВсеСсылки());
	
	РеквизитыТаблицыРезультатПоиска = ПолучитьРеквизиты("РезультатПоиска");
	РеквизитыТаблицыТаблицаПодбора  = ПолучитьРеквизиты("ТаблицаПодбора");
	
	мРеквизитыРезультатПоиска = Новый массив;
	Для Каждого Реквизит из РеквизитыТаблицыРезультатПоиска Цикл
		мРеквизитыРезультатПоиска.Добавить(Реквизит.имя);
	КонецЦикла;
	
	мРеквизитыТаблицаПодбора = Новый массив;
	Для Каждого Реквизит из РеквизитыТаблицыТаблицаПодбора Цикл
		мРеквизитыТаблицаПодбора.Добавить(Реквизит.имя);
	КонецЦикла;

	
	Для Каждого ЭлементСписка из СписокДопКолонок Цикл
		Если ЭлементСписка.Пометка тогда
			//РезультатПоиска
			Если мРеквизитыРезультатПоиска.Найти("_"+ЭлементСписка.Значение) = Неопределено Тогда
				МассивДобавляемыхКолонокРезультатПоиска.Добавить(Новый РеквизитФормы("_"+ЭлементСписка.Значение, Новый ОписаниеТипов(мТипыРеквизитв), "РезультатПоиска",ЭлементСписка.Представление,Ложь));
			КонецЕсли;
			//ТаблицаПодбора
			Если мРеквизитыТаблицаПодбора.Найти("_"+ЭлементСписка.Значение) = Неопределено Тогда
				МассивДобавляемыхКолонокТаблицаПодбора.Добавить(Новый РеквизитФормы("_"+ЭлементСписка.Значение, Новый ОписаниеТипов(мТипыРеквизитв), "ТаблицаПодбора",ЭлементСписка.Представление,Ложь));
			КонецЕсли;			
		Иначе
			УдаляемыйРеквизит = мРеквизитыРезультатПоиска.Найти("_"+ЭлементСписка.Значение);
			Если УдаляемыйРеквизит <> Неопределено Тогда
				МассивУдаляемыхКолонокРезультатПоиска.Добавить("РезультатПоиска."+мРеквизитыРезультатПоиска[УдаляемыйРеквизит]);
			КонецЕсли;
			//Пропускаем параметр поиска
			УдаляемыйРеквизит = мРеквизитыТаблицаПодбора.Найти("_"+ЭлементСписка.Значение);
			Если УдаляемыйРеквизит <> Неопределено Тогда
				МассивУдаляемыхКолонокТаблицаПодбора.Добавить("ТаблицаПодбора."+мРеквизитыТаблицаПодбора[УдаляемыйРеквизит]);
			КонецЕсли;
		КонецЕсли
		
	КонецЦикла;
	
	//РезультатПоиска
	ИзменитьРеквизиты(МассивДобавляемыхКолонокРезультатПоиска,МассивУдаляемыхКолонокРезультатПоиска);
	
	//ТаблицаПодбора
	ИзменитьРеквизиты(МассивДобавляемыхКолонокТаблицаПодбора,МассивУдаляемыхКолонокТаблицаПодбора);
	
	//Выводим на форме
	Для Каждого ЭлементСписка  из СписокДопКолонок Цикл
		Если ЭлементСписка.Пометка Тогда
			
			Если ЭтаФорма.Элементы.Найти("РезультатПоиска_"+ЭлементСписка.Значение) = Неопределено  тогда
				//РезультатПоиска
				нЭлемент = Элементы.Добавить("РезультатПоиска_"+ЭлементСписка.Значение, Тип("ПолеФормы"), Элементы.РезультатПоиска); 
				нЭлемент.Вид = ВидПоляФормы.ПолеВвода; 
				нЭлемент.ПутьКДанным = "РезультатПоиска."+"_"+ЭлементСписка.Значение;
				нЭлемент.ТолькоПросмотр = Истина;
				
				//ТаблицаПодбора
				нЭлемент = Элементы.Добавить("ТаблицаПодбора_"+ЭлементСписка.Значение, Тип("ПолеФормы"), Элементы.ТаблицаПодбора); 
				нЭлемент.Вид = ВидПоляФормы.ПолеВвода; 
				нЭлемент.ПутьКДанным = "ТаблицаПодбора."+"_"+ЭлементСписка.Значение;
				нЭлемент.ТолькоПросмотр = Истина;
			Конецесли;
			
		Иначе
			
			//РезультатПоиска_
			НайденныйЭлемент = Элементы.Найти("РезультатПоиска_"+ЭлементСписка.Значение);
			Если найденныйЭлемент <> Неопределено Тогда
				//Удаляем с формы
				Элементы.Удалить(НайденныйЭлемент);
			КонецЕсли;
			
			//ТаблицаПодбора
			НайденныйЭлемент = Элементы.Найти("ТаблицаПодбора_"+ЭлементСписка.Значение);
			Если найденныйЭлемент <> Неопределено Тогда
				//Удаляем с формы
				Элементы.Удалить(НайденныйЭлемент);
			КонецЕсли;
			
		Конецесли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура РезультатПоискаПриАктивизацииСтроки(Элемент)
	
	ВыделеноСтрок = Элементы.РезультатПоиска.ВыделенныеСтроки.Количество();
	
КонецПроцедуры

//Работа с буфером обмена
&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "ДанныеСкопированыВБуферОбмена" Тогда  
		ДоступностьКоманды = ПолучитьДоступностьКомандыБуфераОбмена();
		УстановитьДоступностьКомандыВставки(ЭтотОбъект, ДоступностьКоманды);
	КонецЕсли;
	
КонецПроцедуры    

&НаСервере
Функция ПолучитьДоступностьКомандыБуфераОбмена()
	
	ДанныеБуфераОбмена 	= CW_РаботаСБуферомОбмена.СтрокиИзБуфераОбмена(); 
	ТипИсточника		= CW_РаботаСБуферомОбмена.ПолучитьТипОбъектаПоИмени(ДанныеБуфераОбмена.Источник); 
	Возврат Не CW_РаботаСБуферомОбмена.ПустойБуферОбмена() и (ТипИсточника = тип("СправочникСсылка.CW_Грузоперевозки"));
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьДоступностьКомандыВставки(Форма, Доступность)

	Доступность = Не Форма.ТолькоПросмотр И Доступность;
	Элементы = Форма.Элементы;
	Элементы.БуфераОбменаВставить.Доступность = Доступность;
	
КонецПроцедуры  

&НаКлиенте
Процедура БуфераОбменаВставить(Команда)
	КоличествоСтрок = БуфераОбменаВставитьНаСервере();
	Если КоличествоСтрок <> Неопределено Тогда
		CW_РаботаСБуферомОбменаКлиент.ОповеститьОВставкеСтрокИзБуфераОбмена(ЭтаФорма, КоличествоСтрок);	
	КонецЕсли; 
КонецПроцедуры

&НаСервере
Функция БуфераОбменаВставитьНаСервере()
	
	ДанныеБуфераОбмена 	= CW_РаботаСБуферомОбмена.СтрокиИзБуфераОбмена(); 
	ТипИсточника		= CW_РаботаСБуферомОбмена.ПолучитьТипОбъектаПоИмени(ДанныеБуфераОбмена.Источник); 
	Если ТипИсточника <> тип("СправочникСсылка.CW_Грузоперевозки") Тогда
		Возврат Неопределено;
	КонецЕсли;    
	
	МассивДобавленных = Новый Массив;
	Выборка = ПолучитьСведенияОДобавляемыхГрузоперевозках(ДанныеБуфераОбмена.Данные);
	Пока Выборка.Следующий() Цикл   
		МассивНайденных = ТаблицаПодбора.НайтиСтроки(Новый Структура("Ссылка", Выборка.Ссылка));
		Если МассивНайденных.Количество() <> 0 Тогда
			Продолжить;
		КонецЕсли;
		НоваяСтрока = ТаблицаПодбора.Добавить();
		НоваяСтрока.Грузоперевозка 	 = СокрЛП(Выборка.Грузоперевозка);
		НоваяСтрока.Заказ  			 = Выборка.Заказ;
		НоваяСтрока.Номер  			 = Выборка.Номер;
		НоваяСтрока.Дата   			 = Выборка.Дата;
		НоваяСтрока.Клиент 			 = Выборка.Клиент;
		НоваяСтрока.Ссылка  		 = Выборка.Ссылка;
		НоваяСтрока.ПризнакЗакрытия  = Выборка.ПризнакЗакрытия;
		НоваяСтрока.ПометкаУдаления  = Выборка.ПометкаУдаления;
		НоваяСтрока.ИндексКартинки   = ?(Выборка.ПометкаУдаления, 4, 3);   
		
		МассивДобавленных.Добавить(Выборка.Ссылка);
	КонецЦикла;    
	
	ЗаполнитьЗначенияДополнительныхКолонок("ТаблицаПодбора", МассивДобавленных);
	
	Возврат ДанныеБуфераОбмена.Данные.Количество();
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьСведенияОДобавляемыхГрузоперевозках(Знач ДанныеБуфераОбмена)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	CW_Грузоперевозки.Ссылка КАК Ссылка,
	               |	CW_Грузоперевозки.CW_Представление КАК Грузоперевозка,
	               |	CW_Грузоперевозки.Код КАК Номер,
	               |	CW_Грузоперевозки.ДатаСделкиФ КАК Дата,
	               |	CW_Грузоперевозки.ПометкаУдаления КАК ПометкаУдаления,
	               |	CW_Грузоперевозки.Заказ КАК Заказ,
	               |	CW_Грузоперевозки.Клиент КАК Клиент,
	               |	ВЫБОР
	               |		КОГДА CW_ЗакрытиеФинансов.ДатаЗакрытия ЕСТЬ NULL
	               |			ТОГДА ЛОЖЬ
	               |		ИНАЧЕ ИСТИНА
	               |	КОНЕЦ КАК ПризнакЗакрытия
	               |ИЗ
	               |	Справочник.CW_Грузоперевозки КАК CW_Грузоперевозки
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.CW_ЗакрытиеФинансов КАК CW_ЗакрытиеФинансов
	               |		ПО CW_Грузоперевозки.Ссылка = CW_ЗакрытиеФинансов.ДатаЗакрытия
	               |ГДЕ
	               |	CW_Грузоперевозки.Ссылка В(&ДанныеБуфераОбмена)"; 
	
	Запрос.УстановитьПараметр("ДанныеБуфераОбмена", ДанныеБуфераОбмена);
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Возврат Выборка;
	
КонецФункции
//Работа с буфером обмена

