&НаКлиенте
Процедура Выбор()
	// --- 
	
	Если ТаблицаПодбора.Количество()=0 Тогда
		
		Если Элементы.РезультатПоиска.ТекущиеДанные <> Неопределено Тогда
			
			// возвращаем текущу строку
			СтруктураОтвета = Новый Структура;
			СтруктураОтвета.Вставить("Вариант","Грузоперевозка");
			СтруктураОтвета.Вставить("Грузоперевозка",Элементы.РезультатПоиска.ТекущиеДанные.Ссылка);
			ЭтаФорма.Закрыть(СтруктураОтвета);
			
		Иначе
			
			_УФК.ВывестиПредупреждение("Грузоперевозка не выбрана!");
			Возврат;
			
		КонецЕсли; 
		
	ИначеЕсли ТаблицаПодбора.Количество() > 0 Тогда 
		
		// проверяем, что в подборе нет помеченных на удаление
		//ЕстьПомеченные = Ложь;
		//Для каждого Стр Из ТаблицаПодбора Цикл
		//	Если (Стр.ПометкаУдаления) Тогда
		//		ЕстьПомеченные = Истина;
		//		Прервать;
		//	КонецЕсли; 
		//КонецЦикла; 
		////---- заменено на:
		ОтборПомеченных = Новый Структура("ПометкаУдаления", Истина);
		мСтроки 		= ТаблицаПодбора.НайтиСтроки(ОтборПомеченных);
		ЕстьПомеченные = мСтроки.Количество() > 0;
		
		Если (ЕстьПомеченные) Тогда
			
			ПОВ = Новый ОписаниеОповещения("ОбработкаПодтвержденияПодбораПомеченных",ЭтотОбъект, Новый Структура()); 
			ПоказатьВопрос(ПОВ,"Подбор содержит помеченные на удаление грузоперевозки. Продолжить?",РежимДиалогаВопрос.ДаНет,,КодВозвратаДиалога.Нет);
			
		Иначе
			
			ПоказатьДиалогВыбораНоменклатуры();
			
		КонецЕсли; 
		
	КонецЕсли; 
	
	// --- 
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаПодтвержденияПодбораПомеченных(Ответ, ДополнительныеПараметры) Экспорт 
	// --- 
	
	Если (Ответ <> Неопределено) Тогда
		
		Если (Ответ = КодВозвратаДиалога.Да) Тогда
			
			ПоказатьДиалогВыбораНоменклатуры();
			
		КонецЕсли; 
		
	КонецЕсли; 
	
	// --- 
КонецПроцедуры
  

&НаКлиенте
Процедура ПоказатьДиалогВыбораНоменклатуры()
	
	// Вызываем форму выбора услуги
	ОписаниеОповещения = Новый ОписаниеОповещения("ОбработкаВыбораНоменклатуры",ЭтотОбъект);  
	
	СтруктураПараметров = ПолучитьПараметрыФормыВыбораНоменклатурыНаСервере(); 
	
	ОткрытьФорму("ОбщаяФорма.CW_ФормаВыбораНоменклатуры",СтруктураПараметров,,,,,ОписаниеОповещения,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры
  

&НаКлиенте
Процедура ОбработкаВыбораНоменклатуры(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СтруктураОтвета = Новый Структура;
	СтруктураОтвета.Вставить("Вариант",					"ГрузоперевозкиИНоменклатура");
	СтруктураОтвета.Вставить("Грузоперевозки",			ПолучитьМассивГрузоперевозокНаСервере());
	СтруктураОтвета.Вставить("СтруктураНоменклатуры",	Результат);
	
	ЭтаФорма.Закрыть(СтруктураОтвета);
	
