&НаКлиенте
Процедура ПараметрПоискаПриИзменении(Элемент)
	
	_ПараметрПоискаПриИзменении();
	
КонецПроцедуры

&НаСервере
Процедура _ПараметрПоискаПриИзменении()
	// --- 
	
	РезультатПоиска.Очистить();
	
	СП = _ДС().СоответствиеПараметров.Получить(ПараметрПоиска);
	
	УстановитьВидимостьЭлементовПоискаПопараметрамЗаказа(СП.Значение);

	ВидимостьКолонкиПараметра = Ложь;
	ЗаголовокКолонкиПараметра = "";
	Если СП.Представление = "Грузоперевозка" ИЛИ СП.Представление = "Заказ" ИЛИ СП.Представление = "Клиент" 
		или СП.Представление = "Дата грузоперевозки (По значению)" или СП.Представление = "Дата грузоперевозки (В интервале)" Тогда
		
		
		ВидимостьКолонкиПараметра = Ложь;
		Если (СП.Представление = "Грузоперевозка" ИЛИ СП.Представление = "Заказ") Тогда
			
			Элементы.ПодстрокаПоиска.КнопкаВыбора=Ложь;
			ПодстрокаПоиска = "";
		
		ИначеЕсли (СП.Представление = "Клиент") Тогда 
			
			Элементы.ПодстрокаПоиска.КнопкаВыбора = Истина;
			ПодстрокаПоиска = Справочники.Контрагенты.ПустаяСсылка();  
			
		ИначеЕсли (СП.Представление = "Дата грузоперевозки (В интервале)") Тогда 
			
			ПодстрокаПоиска = Новый СтандартныйПериод;
			Элементы.ПодстрокаПоиска.КнопкаВыбора = Истина;
			
		ИначеЕсли (СП.Представление = "Дата грузоперевозки (По значению)") Тогда 
			
			ПодстрокаПоиска = Дата(1,1,1);
			Элементы.ПодстрокаПоиска.КнопкаВыбора = Истина;
			
		КонецЕсли; 
		
	Иначе
		
		ВидимостьКолонкиПараметра = Истина;
		ЗаголовокКолонкиПараметра = СП.Представление;
		
		Параметр = СП.Значение;
		
		Если Параметр.ТипЗначения.Типы()[0] = Тип("Строка") Тогда
			ПодстрокаПоиска = "";
			Элементы.ПодстрокаПоиска.КнопкаВыбора = Ложь;
		ИначеЕсли Параметр.ТипЗначения.Типы()[0] = Тип("Дата") Тогда 	
			ПодстрокаПоиска = Дата(1,1,1);
			Элементы.ПодстрокаПоиска.КнопкаВыбора = Истина;
		ИначеЕсли Параметр.ТипЗначения.Типы()[0] = Тип("Число") Тогда 	
			ПодстрокаПоиска = 0;
			Элементы.ПодстрокаПоиска.КнопкаВыбора = Истина;
		ИначеЕсли Параметр.ТипЗначения.Типы()[0] = Тип("Булево") Тогда
			ПодстрокаПоиска = Истина;
			Элементы.ПодстрокаПоиска.КнопкаВыбора = Истина;
		Иначе
			ПодстрокаПоиска = Новый(Параметр.ТипЗначения.Типы()[0]);  
			Элементы.ПодстрокаПоиска.КнопкаВыбора = Истина;
		КонецЕсли;	
		
	КонецЕсли;
	
	Элементы.РезультатПоискаПараметр.Видимость = ВидимостьКолонкиПараметра;
	Если ВидимостьКолонкиПараметра Тогда
		
		Элементы.РезультатПоискаПараметр.Заголовок = СП.Представление;
		
	КонецЕсли; 
	
	// --- 
КонецПроцедуры

