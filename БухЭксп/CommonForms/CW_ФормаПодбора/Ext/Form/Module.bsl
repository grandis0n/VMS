
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ТипДокумента 	= Параметры.ТипДокумента;
	Валюта 			= Параметры.Валюта;
	Грузоперевозки 	= Параметры.Грузоперевозки;
	
	ИспользованиеЗаказов = ПолучитьФункциональнуюОпцию("CW_ИспользованиеЗаказов");
	
	Параметры.Свойство("РаздельныйУчетВходящегоНДС"			, РаздельныйУчетВходящегоНДС);
	Параметры.Свойство("ГруппировкаЗатратПоПодразделениям"	, ГруппировкаЗатратПоПодразделениям);
	// --- 
	ДС.Добавить(Новый Структура);
	// --- 
	
	_УстановитьСписокПараметров();
	_ОбновитьСписокДополнительныхКолонок();
	
	Настройки = _УФС.ЗагрузитьСеансовыеНастройки(ЭтаФорма);
	Если Настройки <> Неопределено Тогда
		
		Попытка
			
			Если Настройки.Свойство("ТекущийПараметр") Тогда
				ПараметрПоиска = Настройки.ТекущийПараметр;
			КонецЕсли;
			
			Если Настройки.Свойство("ВыбранныеКолонки") Тогда
				Для Каждого ЭлементМассива из Настройки.ВыбранныеКолонки Цикл
					ЭлементСписка = СписокДопКолонок.НайтиПоЗначению(ЭлементМассива);
					ЭлементСписка.Пометка = истина;
				КонецЦикла;
				ДополнитьКолонкиПоиска();
			КонецЕсли;
			
			_ПараметрПоискаПриИзменении();
			
		Исключение
		    //ОписаниеОшибки()
		КонецПопытки;
		
	КонецЕсли; 

	Если Грузоперевозки <> Неопределено Тогда
		
		// проверяем, что среди переданных нет закрытых
		МассивАналитик = Новый Массив;
		Для каждого Стр Из Грузоперевозки Цикл
			
			_сф.м_ДобавитьУникально(МассивАналитик,?(ЗначениеЗаполнено(Стр.Заказ),Стр.Заказ,Стр));
			
		КонецЦикла; 
		ТаблицаЗакрытых = CW_Мониторинг.ТаблицаЗакрытыхПоАналитике(МассивАналитик);
	
		Для каждого Стр Из Грузоперевозки Цикл
			
			Аналитика = ?(ЗначениеЗаполнено(Стр.Заказ),Стр.Заказ,Стр);
			Если ТаблицаЗакрытых.Найти(Аналитика,"Аналитика") <> Неопределено Тогда
				
				Продолжить;
				
			КонецЕсли; 
			Нстр = ТаблицаПодбора.Добавить();
			Нстр.Грузоперевозка = Стр.CW_Представление;
			Нстр.Номер = Стр.Код;
			Нстр.Дата = Стр.ДатаСделкиФ;
			Нстр.Клиент = Стр.Клиент;
			Нстр.Ссылка = Стр;
			Нстр.ПометкаУдаления = Стр.ПометкаУдаления;
			Нстр.Заказ = Стр.Заказ;
			Нстр.ИндексКартинки = ?(Стр.ПометкаУдаления,4,3);
						
		КонецЦикла; 
		
	КонецЕсли; 
	
	ЗаполнитьЗначенияДополнительныхКолонок("РезультатПоиска",Грузоперевозки);
	ЗаполнитьЗначенияДополнительныхКолонок("ТаблицаПодбора",Грузоперевозки);

	// --- 
	Параметры.Свойство("Договор",Договор);
	Параметры.Свойство("ДатаДокумента",ДатаДокумента);
	
	//Подсистема.УчетПриложенийДоговоров
	Параметры.Свойство("ПриложениеКДоговору",ПриложениеКДоговору);
	//Подсистема.УчетПриложенийДоговоров
	
	РежимДвойногоКликаП = CW_Настройки.ПолучитьНастройкуПользователя(CW_Настройки.Пользователь(),"РежимДвойногоКликаВФормеПодбора");
	Если РежимДвойногоКликаП <> Неопределено Тогда
		
		РежимДвойногоКлика = РежимДвойногоКликаП;
		
	Иначе
		
		РежимДвойногоКлика = Перечисления.CW_ОбработкаДвойногоКликаВПодборе.Подбор;
		
	КонецЕсли; 
		
	ОбновитьЗаголовокПодбора();
	
	// --- 
	Элементы.ТаблицаПодбораЗаполнитьПоБюджету.Видимость 	= ПолучитьФункциональнуюОпцию("CW_ИспользованиеБюджетирования");
	
	
	Если НЕ ПустаяСтрока(ПараметрПоиска) Тогда
		СП = _ДС().СоответствиеПараметров.Получить(ПараметрПоиска);
		УстановитьВидимостьЭлементовПоискаПопараметрамЗаказа(СП.Значение);
	КонецЕсли;
	
	//Работа с буфером обмена  
	// Проверка буфера обмена на наличие скопированных строк
	ДоступностьКоманды = ПолучитьДоступностьКомандыБуфераОбмена();
	УстановитьДоступностьКомандыВставки(ЭтотОбъект, ДоступностьКоманды);
	//Работа с буфером обмена
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьЭлементовПоискаПопараметрамЗаказа(ЗначениеПоиска)
	
	Элементы.НеИскатьЗначениеПараметраПоЗаказам.Видимость 	= ТипЗнч(ЗначениеПоиска) = Тип("ПланВидовХарактеристикСсылка.CW_ПараметрыГрузоперевозок"); 
	Элементы.РезультатПоискаПоЗаказу.Видимость 				= ТипЗнч(ЗначениеПоиска) = Тип("ПланВидовХарактеристикСсылка.CW_ПараметрыГрузоперевозок")
																И НЕ НеИскатьЗначениеПараметраПоЗаказам;

КонецПроцедуры

Функция ПолучитьЗначенияДополнительныхКолонокТаблицыПодбора(ВыбранныеКолонки, мГрузоперевозки)
	
	мПараметры = Новый Массив;
	мРеквизиты = Новый Массив;
	
	СоответствиеПараметров = _ДС().СоответствиеПараметров;	
	
	Для Каждого ЭлементМассива из ВыбранныеКолонки Цикл
		СтрокаСоответствия = СоответствиеПараметров.Получить(ЭлементМассива);
		Если СтрокаСоответствия <> Неопределено Тогда
			Если СтрокаСоответствия.ЭтоПараметр Тогда
				мПараметры.Добавить(СтрокаСоответствия.Значение);
			Иначе
				мРеквизиты.Добавить(СтрокаСоответствия.Значение);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = "ВЫБРАТЬ";
	
	Для Каждого ЭлементМассива из мРеквизиты Цикл
		Запрос.Текст = Запрос.Текст + "			   
		|	CW_Грузоперевозки."+ЭлементМассива+" КАК "+ЭлементМассива+",";
	КонецЦикла;
	
	Запрос.Текст = Запрос.Текст + "			   
	|	CW_Грузоперевозки.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ ВТ_Грузоперевозки
	|ИЗ
	|	Справочник.CW_Грузоперевозки КАК CW_Грузоперевозки
	|ГДЕ
	|	CW_Грузоперевозки.Ссылка В(&мГрузоперевозки)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	CW_ХарактеристикиГрузоперевозок.Грузоперевозка КАК Грузоперевозка,
	|	CW_ХарактеристикиГрузоперевозок.Параметр КАК Параметр,
	|	CW_ХарактеристикиГрузоперевозок.Значение КАК Значение
	|ПОМЕСТИТЬ ВТ_Параметры
	|ИЗ
	|	РегистрСведений.CW_ХарактеристикиГрузоперевозок КАК CW_ХарактеристикиГрузоперевозок
	|ГДЕ
	|	CW_ХарактеристикиГрузоперевозок.Грузоперевозка В(&мГрузоперевозки)
	|	И CW_ХарактеристикиГрузоперевозок.Параметр В(&мПараметры)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Грузоперевозки.Ссылка КАК Грузоперевозка,";
	
	Для Каждого ЭлементМассива из мРеквизиты Цикл
		Запрос.Текст = Запрос.Текст + "			   
		|	ВТ_Грузоперевозки."+ЭлементМассива+" КАК "+ЭлементМассива+",";
	КонецЦикла;
	
	Запрос.Текст = Запрос.Текст + "			   
	|	ЕСТЬNULL(ВТ_Параметры.Параметр, НЕОПРЕДЕЛЕНО) КАК Параметр,
	|	ЕСТЬNULL(ВТ_Параметры.Значение, НЕОПРЕДЕЛЕНО) КАК Значение
	|ИЗ
	|	ВТ_Грузоперевозки КАК ВТ_Грузоперевозки
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Параметры КАК ВТ_Параметры
	|		ПО ВТ_Грузоперевозки.Ссылка = ВТ_Параметры.Грузоперевозка";
	
	Запрос.УстановитьПараметр("мГрузоперевозки"	, мГрузоперевозки);
	Запрос.УстановитьПараметр("мПараметры"		, мПараметры);
	
	Возврат запрос.Выполнить().Выбрать();
	
КонецФункции


// ---------------------------------------------------------------------------- 

Функция _ДС()
	// --- 
	
	Возврат(ДС[0].Значение);
	
	// --- 
КонецФункции
  

&НаСервере
Процедура _УстановитьСписокПараметров()
	// --- 
	
	Индекс = 0;
	ТЗП = _сф.т_Создать("Ключ,Значение,Представление");
	
	_сф.Инкремент(Индекс);
	Нстр = ТЗП.Добавить();
	Нстр.Ключ = _Ключ(Индекс);
	Нстр.Значение = Тип("СправочникСсылка.Контрагенты");
	Нстр.Представление = "Клиент";
	
	Если ИспользованиеЗаказов Тогда
		
		_сф.Инкремент(Индекс);
		Нстр = ТЗП.Добавить();
		Нстр.Ключ = _Ключ(Индекс);
		Нстр.Значение = Тип("СправочникСсылка.CW_Заказы");
		Нстр.Представление = "Заказ";

	КонецЕсли; 
	
	_сф.Инкремент(Индекс);
	Нстр = ТЗП.Добавить();
	Нстр.Ключ = _Ключ(Индекс);
	Нстр.Значение = Тип("СправочникСсылка.CW_Грузоперевозки");
	Нстр.Представление = "Грузоперевозка";
	
	// дата ГП
	_сф.Инкремент(Индекс);
	Нстр 				= ТЗП.Добавить();
	Нстр.Ключ 			= _Ключ(Индекс);
	Нстр.Значение		= Тип("Дата");
	Нстр.Представление 	= "Дата грузоперевозки (По значению)";
	
	_сф.Инкремент(Индекс);
	Нстр 				= ТЗП.Добавить();
	Нстр.Ключ 			= _Ключ(Индекс);
	Нстр.Значение 		= Тип("Дата");
	Нстр.Представление 	= "Дата грузоперевозки (В интервале)";
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	CW_ПараметрыГрузоперевозок.Ссылка,
	               |	CW_ПараметрыГрузоперевозок.Наименование КАК Наименование
	               |ИЗ
	               |	ПланВидовХарактеристик.CW_ПараметрыГрузоперевозок КАК CW_ПараметрыГрузоперевозок
	               |ГДЕ
	               |	CW_ПараметрыГрузоперевозок.ЭтоКонтрольнаяДата = ЛОЖЬ
	               |	И CW_ПараметрыГрузоперевозок.Предопределенный = ЛОЖЬ
	               |	И CW_ПараметрыГрузоперевозок.ЭтоГруппа = ЛОЖЬ
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Наименование";
	
	РезультатЗапрсоа = Запрос.Выполнить();
	Выборка = РезультатЗапрсоа.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		_сф.Инкремент(Индекс);
		
		Нстр = ТЗП.Добавить();
		Нстр.Ключ 			= _Ключ(Индекс);
		Нстр.Значение 		= Выборка.Ссылка;
		Нстр.Представление 	= Выборка.Наименование;
		
	КонецЦикла;  
	
	// ---------------------------------------------------------------------------- 
	
	_ДС().Вставить("СоответствиеПараметров",_сф.со_Создать("Ключ","Ключ,Значение,Представление",ТЗП));
	// --- 
	Элементы.ПараметрПоиска.СписокВыбора.Очистить();
	Для каждого Стр Из ТЗП Цикл
		
		Элементы.ПараметрПоиска.СписокВыбора.Добавить(Стр.Ключ,Стр.Представление);
		
	КонецЦикла; 
	// --- 
	ПараметрПоиска = _сф.к_ПервыйЭлемент(ТЗП).Ключ;
	_ПараметрПоискаПриИзменении();
	
	// --- 
КонецПроцедуры

&НаСервере
Процедура _ОбновитьСписокДополнительныхКолонок()
	
	СоответствиеПараметров = _ДС().СоответствиеПараметров;
	
	СписокДопКолонок.Очистить();
	
	Справочники.CW_Грузоперевозки.ПолучитьСписокРеквизитовШапкиДляВыводаНаФорму(СоответствиеПараметров, СписокДопКолонок);
	ПланыВидовХарактеристик.CW_ПараметрыГрузоперевозок.ПолучиьСписокПараметровДляВыводаНаФорму(СоответствиеПараметров, СписокДопКолонок);
	
	//Для каждого СтрокаСоответствия из СоответствиеПараметров Цикл
	//	ЗначениеСоответствия = СтрокаСоответствия.Значение;
	//	СписокДопКолонок.Добавить(СтрокаСоответствия.Ключ,ЗначениеСоответствия.Представление, Ложь);
	//КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция _Ключ(Номер)
	// --- 
	
	Возврат(Формат(Номер,"ЧЦ=10; ЧДЦ=0; ЧГ="));
	
	// --- 
КонецФункции

