&НаКлиенте
Процедура _ДобавитьВПодбор(ВыбранныеСтроки)
	
	ЕстьЗакрытые = Ложь;
	
	Для каждого Стр Из ВыбранныеСтроки Цикл
		
		СтрокаТЗ = РезультатПоиска.НайтиПоИдентификатору(Стр);
		
		Если СтрокаТЗ.ПризнакЗакрытия Тогда 
			ЕстьЗакрытые = Истина;
			Продолжить;
		КонецЕсли; 
		
		МассивНайденных = ТаблицаПодбора.НайтиСтроки(Новый Структура("Ссылка", СтрокаТЗ.Ссылка));
		
		Если МассивНайденных.Количество() = 0 Тогда
			
			Нстр = ТаблицаПодбора.Добавить();
			
			ЗаполнитьЗначенияСвойств(Нстр, СтрокаТЗ);
			
			Нстр.Грузоперевозка = СтрокаТЗ.Представление;
			//Нстр.Номер = СтрокаТЗ.Номер;
			//Нстр.Дата = СтрокаТЗ.Дата;
			//Нстр.Клиент = СтрокаТЗ.Клиент;
			//Нстр.Ссылка = СтрокаТЗ.Ссылка;
			//Нстр.ПометкаУдаления = СтрокаТЗ.ПометкаУдаления;
			//Нстр.Заказ = СтрокаТЗ.Заказ;	
			//Нстр.ПризнакЗакрытия = СтрокаТЗ.ПризнакЗакрытия;
			//Нстр.ИндексКартинки = СтрокаТЗ.ИндексКартинки;
			
		КонецЕсли; 
	КонецЦикла; 
	
	Если ЕстьЗакрытые Тогда
		_УФК.ВывестиПредупреждение("Грузоперевозки с блокированными финансами в документ не добавлены!");
	КонецЕсли; 

	ОбновитьЗаголовокПодбора();

КонецПроцедуры



&НаСервере
Процедура _ДобавитьВПодборИзЖурнала(МассивГрузоперевозок)
	// --- 
	
	ЕстьЗакрытые = Ложь;
	ТЗПодбора = ТаблицаПодбора.Выгрузить();
	
	Для каждого Стр Из МассивГрузоперевозок Цикл
		
		Если (_сф.к_НайтиСтроку(ТЗПодбора,Новый Структура("Ссылка",Стр)) <> Неопределено) Тогда
			
			Продолжить;
			
		КонецЕсли; 
		
		Если (CW_Мониторинг.ПолучитьДатуЗакрытия(Стр) <> Дата(1,1,1)) Тогда
			
			ЕстьЗакрытые = Истина;
			Продолжить;
			
		КонецЕсли; 
		
		Нстр = ТаблицаПодбора.Добавить();
		Нстр.Грузоперевозка = Стр.CW_Представление;
		Нстр.Номер = Стр.Код;
		Нстр.Дата = Стр.ДатаСделкиФ;
		Нстр.Клиент = Стр.Клиент;
		Нстр.Ссылка = Стр;
		Нстр.ПометкаУдаления = Стр.ПометкаУдаления;
		Нстр.Заказ = Стр.Заказ;	
		Нстр.ПризнакЗакрытия = Ложь;
		Нстр.ИндексКартинки = ?(Стр.ПометкаУдаления, 4, 3);
		
	КонецЦикла; 
	// --- 
	Если ЕстьЗакрытые Тогда
		
		Сообщить("Закрытые грузоперевозки в подбор не добавлены!");
		
	КонецЕсли; 
	// --- 
	ОбновитьЗаголовокПодбора();
	
	// --- 
КонецПроцедуры

