&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Параметры.Свойство("ОбъектПечати", 		ОбъектПечати); 
	Параметры.Свойство("ШаблонДокумента", 	ШаблонДокумента);   
	
	Заголовок = СокрЛП(ОбъектПечати);
	
	Если НЕ ЗначениеЗаполнено(ОбъектПечати) Тогда
		ВызватьИсключение НСтр("ru = 'Не определен документ, для которого необходимо распечатать текст.'");
	КонецЕсли;      
	Если НЕ ЗначениеЗаполнено(ШаблонДокумента) Тогда
		ВызватьИсключение НСтр("ru = 'Не определен шаблон документа.'");
	КонецЕсли;      
	
	//Настройки колонтитулов  
	Если ШаблонДокумента.ВыводитьКолонтитулы Тогда
		Настройки = ШаблонДокумента.НастройкиКолонтитулов.Получить();   
		
		Если ТипЗнч(Настройки) = Тип("Структура")  Тогда
			НастройкиКолонтитулов = новый ФиксированнаяСтруктура(Настройки);
		КонецЕсли;
	КонецЕсли;
	//Настройки колонтитулов  
	
КонецПроцедуры

&НаКлиенте
Процедура ФорматированныйДокументПриИзменении(Элемент)
	
	Модифицированность = Истина;

КонецПроцедуры

&НаКлиенте
Процедура Сохранить(Команда)
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ИмяФормата", "MXL");          
	
	ОткрытьФорму("ОбщаяФорма.CW_СохранениеДокумента", ПараметрыФормы, ЭтаФорма);
	
КонецПроцедуры       

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора) 
	
	Если ВРег(ИсточникВыбора.ИмяФормы) = ВРег("ОбщаяФорма.CW_СохранениеДокумента") Тогда
		
		Если ВыбранноеЗначение <> Неопределено 
			И ВыбранноеЗначение <> КодВозвратаДиалога.Отмена Тогда
			
			ФорматыСохранения = ВыбранноеЗначение.ФорматыСохранения;
			Если ВыбранноеЗначение.ВариантСохранения = "СохранитьВПапку" Тогда
				СохранитьФайлыВКаталог(ВыбранноеЗначение);
			Иначе
				ЗаписатьФайлыНаСервере(ВыбранноеЗначение);
				Оповестить("ОбновитьНаличиеПрикрепленныхФайлов");
				Состояние(НСтр("ru = 'Сохранение успешно завершено.'"));
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры      

&НаСервере
Процедура ЗаписатьФайлыНаСервере(ВыбранноеЗначение)
	
	// подготовка временной папки
	ИмяВременнойПапки = ПолучитьИмяВременногоФайла();
	СоздатьКаталог(ИмяВременнойПапки);
	
	// Проверим наличие имени файла, заданное пользователем. 
	// В случае его отсутствия в качестве имени будем использовать наименование шаблона документа
	Если ЗначениеЗаполнено(ВыбранноеЗначение.ИмяФайла) Тогда
		ИмяФайлаБезРасширения = ВыбранноеЗначение.ИмяФайла;		
	Иначе
		ИмяФайлаБезРасширения = ШаблонДокумента.Наименование;		
	КонецЕсли;
	
	ИмяФайлаБезРасширения = ОбщегоНазначенияКлиентСервер.ЗаменитьНедопустимыеСимволыВИмениФайла(СокрЛП(ИмяФайлаБезРасширения));
	
	Для Каждого ФорматФайла Из ВыбранноеЗначение.ФорматыСохранения Цикл
		
		Если ФорматФайла = "DOCX" Тогда
			// Подготовим DOCX документ на основе табличного документа
			ИмяФайла 	= ИмяФайлаБезРасширения+".docx";    
			Расширение 	= ".docx";
			ПолноеИмяФайла = ПодготовитьDOCXНаОсновеТабличногоДокумента(ИмяВременнойПапки, ИмяФайла);
			
		ИначеЕсли ФорматФайла = "PDF" Тогда
			// Подготовим PDF документ на основе табличного документа
			ИмяФайла 	= ИмяФайлаБезРасширения + ".pdf";
			Расширение 	= ".pdf";
			ПолноеИмяФайла = ПодготовитьPDFНаОсновеТабличногоДокумента(ИмяВременнойПапки, ИмяФайла);
			
		ИначеЕсли ФорматФайла = "MXL" Тогда
			// Подготовим PDF документ на основе табличного документа
			ИмяФайла 	= ИмяФайлаБезРасширения + ".mxl";
			Расширение 	= ".mxl";
			ПолноеИмяФайла = ПодготовитьMXLНаОсновеТабличногоДокумента(ИмяВременнойПапки, ИмяФайла);
			
		ИначеЕсли ФорматФайла = "HTML" Тогда
			// Подготовим HTML документ на основе табличного документа
			ИмяФайла 	= ИмяФайлаБезРасширения + ".htm";
			Расширение 	= ".htm";
			ПолноеИмяФайла = ПодготовитьHTMLНаОсновеТабличногоДокумента(ИмяВременнойПапки, ИмяФайла);
			
		КонецЕсли;                          
		
		ОбъектыАрхива = Новый Массив;
		ОбъектыАрхива.Добавить(ОбъектПечати);  
		
		ДвоичныеДанные = Новый ДвоичныеДанные(ПолноеИмяФайла);
		Хранение = ПоместитьВоВременноеХранилище(ДвоичныеДанные, Новый УникальныйИдентификатор);

		ДанныеФайла = Новый Структура;
		ДанныеФайла.Вставить("Имя",			ИмяФайла);
		ДанныеФайла.Вставить("Расширение",	Расширение);
		ДанныеФайла.Вставить("Хранение",	Хранение);
		
		ПомещенныеФайлы = Новый Массив;
		ПомещенныеФайлы.Добавить(ДанныеФайла);

		CW_РаботаСФайламиСервер.ПрикрепитьФайлы(ПомещенныеФайлы, ОбъектыАрхива, ВыбранноеЗначение.ТипДокумента); 
		
	КонецЦикла;
	
	// Удалим временный файл.
	УдалитьВременныйФайлНаСервер(ИмяВременнойПапки);
	
КонецПроцедуры

&НаСервере
Функция ПодготовитьMXLНаОсновеТабличногоДокумента(ИмяПапки, ИмяФайла)
	
	ПолноеИмяФайла = УникальноеИмяФайла(ОбщегоНазначенияКлиентСервер.ДобавитьКонечныйРазделительПути(ИмяПапки) + ИмяФайла);
	ТабличныйДокумент.Записать(ПолноеИмяФайла, ТипФайлаТабличногоДокумента.MXL);
	
	Возврат ПолноеИмяФайла;
	
КонецФункции

&НаСервере
Функция ПодготовитьDOCXНаОсновеТабличногоДокумента(ИмяПапки, ИмяФайла)
	
