&НаКлиенте
Процедура УстановитьВсе(Команда)
	
	УстановитьФлажки(Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура СнятьВсе(Команда)
	
	УстановитьФлажки(Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьФлажки(Флаг)
	// --- 
	
	Для каждого Стр Из ТаблицаОтбора Цикл
		
		Стр.Использование = Флаг;
		
	КонецЦикла; 
	
	// --- 
КонецПроцедуры


// ---------------------------------------------------------------------------- 

&НаКлиенте
Процедура Установить(Команда)
	// формируем список из выбранных
	Список = Новый СписокЗначений;
	
	ОтборСтрок 		= Новый Структура("Использование", Истина);
	ВыбранныеСтроки = ТаблицаОтбора.НайтиСтроки(ОтборСтрок);
	
	Для каждого ВыбраннаяСтрока Из ВыбранныеСтроки Цикл
		Список.Добавить(ВыбраннаяСтрока.Ссылка);
	КонецЦикла; 
	
	ПараметрыЗакрытия = Новый Структура;
	ПараметрыЗакрытия.Вставить("Список", 			Список);
	
	ЭтаФорма.Закрыть(ПараметрыЗакрытия);
	
КонецПроцедуры
  