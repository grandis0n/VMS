&наСервере
Процедура УстановитьЗначенияКонстнатНаСервере(Ответ)
	
	Если ЭтоАдресВременногоХранилища(Ответ.АдресЗначения) тогда
		
		СсылкаНаДополнительныйРеквизит = ПолучитьИзВременногоХранилища(Ответ.АдресЗначения);
		
		НаборКонстант[Ответ.ИмяКонстанты] = СсылкаНаДополнительныйРеквизит;
		
		Модифицированность = Истина;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

&НаКлиенте
Процедура CW_УчитыватьПробегТранспортногоСредстваСГрузомПриИзменении(Элемент)
	      
	НаборКонстант.CW_УчитыватьПробегТранспортногоСредстваСГрузом =  CW_УчитыватьПробегТранспортногоСредстваСГрузом;
	ИзмененныеКонстанты = УчитыватьПробегТраснпортногоСредстваСГрузомНаСервере();
	
	УправлениеФормой(ЭтаФорма);
	
	ПодключитьОбработчикОжидания("ОбновитьИнтерфейсПрограммы", 0.1, Истина);
	ОбновитьИнтерфейс = Истина;
	
	Для Каждого КонстантаИмя ИЗ ИзмененныеКонстанты Цикл
		Если КонстантаИмя <> "" Тогда
			Оповестить("Запись_НаборКонстант", Новый Структура, КонстантаИмя);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция УчитыватьПробегТраснпортногоСредстваСГрузомНаСервере()
	
	ИзмененныеКонстанты = Новый Массив;
		
	КонстантаИмя = СохранитьЗначениеРеквизита("НаборКонстант.CW_УчитыватьПробегТранспортногоСредстваСГрузом");
	ИзмененныеКонстанты.Добавить(КонстантаИмя);
	
	НаборКонстант.CW_ВводитьДанныеОПорожнемПробегеВДокументах = Ложь;
	КонстантаИмя = СохранитьЗначениеРеквизита("НаборКонстант.CW_ВводитьДанныеОПорожнемПробегеВДокументах");
	ИзмененныеКонстанты.Добавить(КонстантаИмя);
	
	ОбновитьПовторноИспользуемыеЗначения();
		
	 
	
	Возврат ИзмененныеКонстанты;
	
КонецФункции

&НаКлиенте
Процедура CW_УчитыватьПогрешностьИзмеренияОстаткаТопливаПриИзменении(Элемент)
	
	
	НаборКонстант.CW_УчитыватьПогрешностьИзмеренияОстаткаТоплива =  CW_УчитыватьПогрешностьИзмеренияОстаткаТоплива;
	ИзмененныеКонстанты = УчитыватьПогрешностьИзмеренияОстаткаТопливаНаСервере();
	                         
	УправлениеФормой(ЭтаФорма);
	
	ПодключитьОбработчикОжидания("ОбновитьИнтерфейсПрограммы", 0.1, Истина);
	ОбновитьИнтерфейс = Истина;
	
	Для Каждого КонстантаИмя ИЗ ИзмененныеКонстанты Цикл
		Если КонстантаИмя <> "" Тогда
			Оповестить("Запись_НаборКонстант", Новый Структура, КонстантаИмя);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция УчитыватьПогрешностьИзмеренияОстаткаТопливаНаСервере()
	
	ИзмененныеКонстанты = Новый Массив;
		
	КонстантаИмя = СохранитьЗначениеРеквизита("НаборКонстант.CW_УчитыватьПогрешностьИзмеренияОстаткаТоплива");
	ИзмененныеКонстанты.Добавить(КонстантаИмя);
	
	НаборКонстант.CW_ВариантОтраженияЗатратПоБУВПределахПогрешности = Неопределено;
	КонстантаИмя = СохранитьЗначениеРеквизита("НаборКонстант.CW_ВариантОтраженияЗатратПоБУВПределахПогрешности");
	ИзмененныеКонстанты.Добавить(КонстантаИмя);
	
	ОбновитьПовторноИспользуемыеЗначения();
	
	 
	
	Возврат ИзмененныеКонстанты;
	
КонецФункции

&НаКлиенте
Процедура CW_ПрименяютсяНормативыРасходаТопливаПриИзменении(Элемент)
	
	НаборКонстант.CW_ПрименяютсяНормативыРасходаТоплива =  CW_ПрименяютсяНормативыРасходаТоплива;
	ИзмененныеКонстанты = ПрименяютсяНормативыРасходаТопливаНаСервере();
	
	УправлениеФормой(ЭтаФорма);
	
	ПодключитьОбработчикОжидания("ОбновитьИнтерфейсПрограммы", 0.1, Истина);
	ОбновитьИнтерфейс = Истина;
	
	Для Каждого КонстантаИмя ИЗ ИзмененныеКонстанты Цикл
		Если КонстантаИмя <> "" Тогда
			Оповестить("Запись_НаборКонстант", Новый Структура, КонстантаИмя);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ПрименяютсяНормативыРасходаТопливаНаСервере()
	
	ИзмененныеКонстанты = Новый Массив;
		
	КонстантаИмя = СохранитьЗначениеРеквизита("НаборКонстант.CW_ПрименяютсяНормативыРасходаТоплива");
	ИзмененныеКонстанты.Добавить(КонстантаИмя);
	
	НаборКонстант.CW_ИспользуютсяПоказателиТранспортногоСредстваОтдельноОтМодели = Ложь;
	КонстантаИмя = СохранитьЗначениеРеквизита("НаборКонстант.CW_ИспользуютсяПоказателиТранспортногоСредстваОтдельноОтМодели");
	ИзмененныеКонстанты.Добавить(КонстантаИмя);
	
	НаборКонстант.CW_РазрешеноСоздаватьПоказателиДляРасчетанормРасходаТоплива = Ложь;
	КонстантаИмя = СохранитьЗначениеРеквизита("НаборКонстант.CW_РазрешеноСоздаватьПоказателиДляРасчетанормРасходаТоплива");
	ИзмененныеКонстанты.Добавить(КонстантаИмя);
	
	НаборКонстант.CW_ПорядокРасчетаНормативаТоплива = Неопределено;
	КонстантаИмя = СохранитьЗначениеРеквизита("НаборКонстант.CW_ПорядокРасчетаНормативаТоплива");
