&НаКлиенте
Перем ОбновитьИнтерфейс;

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	УстановитьЗначенияРеквизитовФормы(ЭтаФорма);
	УправлениеФормой(ЭтаФорма);
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура УстановитьЗначенияРеквизитовФормы(Форма)
	
	Форма.CW_ПрименяютсяНормативыРасходаТоплива         	= Константы.CW_ПрименяютсяНормативыРасходаТоплива.Получить();
	Форма.CW_УчитыватьПогрешностьИзмеренияОстаткаТоплива  	= Константы.CW_УчитыватьПогрешностьИзмеренияОстаткаТоплива.Получить();
	Форма.CW_УчитыватьПробегТранспортногоСредстваСГрузом  	= Константы.CW_УчитыватьПробегТранспортногоСредстваСГрузом.Получить();
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УправлениеФормой(Форма)
	
	Элементы = Форма.Элементы;
	
	//Доступность элементов
	Элементы.CW_ВводитьДанныеОПорожнемПробегеВДокументах.Доступность 		= Форма.CW_УчитыватьПробегТранспортногоСредстваСГрузом; 
	Элементы.CW_ВариантОтраженияЗатратПоБУВПределахПогрешности.Доступность 	= Форма.CW_УчитыватьПогрешностьИзмеренияОстаткаТоплива; 
	
	Элементы.CW_РазрешеноСоздаватьПоказателиДляРасчетанормРасходаТоплива.Доступность 	= Форма.CW_ПрименяютсяНормативыРасходаТоплива; 
	Элементы.CW_ИспользуютсяПоказателиТранспортногоСредстваОтдельноОтМодели.Доступность = Форма.CW_ПрименяютсяНормативыРасходаТоплива; 
	Элементы.CW_ПорядокРасчетаНормативаТоплива.Доступность 								= Форма.CW_ПрименяютсяНормативыРасходаТоплива;

КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииРеквизитаФормы(Элемент)
	
	ПриИзмененииРеквизитаНаКлиенте(Элемент, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииРеквизитаНаКлиенте(Элемент, ОбновлятьИнтерфейс = Истина)
	
	КонстантаИмя = ПриИзмененииРеквизитаСервер(Элемент.Имя);
	
	Если ОбновлятьИнтерфейс Тогда
		ОбновитьИнтерфейс = Истина;
		ПодключитьОбработчикОжидания("ОбновитьИнтерфейсПрограммы", 0.1, Истина);
	КонецЕсли;
	
	Если КонстантаИмя <> "" Тогда
		Оповестить("Запись_НаборКонстант", Новый Структура, КонстантаИмя);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПриИзмененииРеквизитаСервер(ИмяЭлемента)
	
	РеквизитПутьКДанным = Элементы[ИмяЭлемента].ПутьКДанным;
	
	КонстантаИмя = СохранитьЗначениеРеквизита(РеквизитПутьКДанным);
	
	Возврат КонстантаИмя;
	
КонецФункции

&НаСервере
Функция СохранитьЗначениеРеквизита(РеквизитПутьКДанным)
	
	// Сохранение значений реквизитов, не связанных с константами напрямую (в отношении один-к-одному).
	Если РеквизитПутьКДанным = "" Тогда
		Возврат "";
	КонецЕсли;
	
	// Определение имени константы.
	КонстантаИмя = "";
	Если НРег(Лев(РеквизитПутьКДанным, 14)) = НРег("НаборКонстант.") Тогда
		// Если путь к данным реквизита указан через "НаборКонстант".
		КонстантаИмя = Сред(РеквизитПутьКДанным, 15);
	КонецЕсли;
	
	// Сохранения значения константы.
	Если КонстантаИмя <> "" Тогда
		КонстантаМенеджер = Константы[КонстантаИмя];
		КонстантаЗначение = НаборКонстант[КонстантаИмя];
		
		Если КонстантаМенеджер.Получить() <> КонстантаЗначение Тогда
			КонстантаМенеджер.Установить(КонстантаЗначение);
		КонецЕсли;
	КонецЕсли;
	
	Возврат КонстантаИмя;
	
КонецФункции

&НаКлиенте
Процедура ОбновитьИнтерфейсПрограммы()
	
	Если ОбновитьИнтерфейс = Истина Тогда
		ОбновитьИнтерфейс = Ложь;
		ОбщегоНазначенияКлиент.ОбновитьИнтерфейсПрограммы();
	КонецЕсли;
	
КонецПроцедуры




#Область Формирование_допонительных_свойств_документов
//Создание дополнительных свойств документов

//Свойство "Операция Бух"
&НаКлиенте
Процедура СоздатьСвойствоОперацияВведенаяВручную(Команда)
	
	Если ЗначениеЗаполнено(НаборКонстант.CW_ДополнительноеСвойствоДокументаОперацияВведеннаяВручную) Тогда
		
		Режим = РежимДиалогаВопрос.ДаНет;
		Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаСозданияСвойстваРучнаяОперация", ЭтаФорма, Параметры);
		ПоказатьВопрос(Оповещение, "Указанное свойство документа будет заменено новым. Продоложить?", Режим, 0); 
		
	Иначе
		
		ОбработатьФормированиеСвойстваРучнаяОперация();
		
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияВопросаСозданияСвойстваРучнаяОперация(Результат, Параметры) Экспорт
	Если Результат = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;
	
	ОбработатьФормированиеСвойстваРучнаяОперация();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьФормированиеСвойстваРучнаяОперация()
	
	СтруктураДанных = Новый Структура;
	СтруктураДанных.Вставить("ИмяНабораСвойств"	, "Документ_ОперацияБух");
	СтруктураДанных.Вставить("Наименование"		, "Сформирован обработкой учета ГСМ (Операция введенная вручную)");
	СтруктураДанных.Вставить("Заголовок"		, "Сформирован обработкой учета ГСМ");
	СтруктураДанных.Вставить("Имя"				, "СформированОбработкойУчетаГСМ_");
	СтруктураДанных.Вставить("ИмяКонстанты"		, "CW_ДополнительноеСвойствоДокументаОперацияВведеннаяВручную");
	
	Ответ = CW_УчетСобственногоТранспортаСервер.СоздатьИЗаписатьСвойствоДокумента(СтруктураДанных);
	
	Если Ответ.Успешно Тогда
		УстановитьЗначенияКонстнатНаСервере(Ответ);
	Иначе
		
		Сообщение = новый СообщениеПользователю;
		Сообщение.Текст = "Не удалось записать свойство для документа Требование-накладная"+Символы.ПС+Ответ.ОписаниеОшибки;
		Сообщение.Сообщить();
		
	КонецЕсли;
	
КонецПроцедуры

//Свойство "Перемещение товаров"
