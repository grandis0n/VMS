&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ДеревоЗначений 	= РеквизитФормыВЗначение("ДеревоТитулов");  
	
	ТипОбъекта 		= ОбщегоНазначения.ИдентификаторОбъектаМетаданных(ТипЗнч(Параметры.ПараметрКоманды));
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	CW_ОбменГИСЭПДНастройкиЗаполненияЭПД.ТипДокументаЭПД КАК ТипДокументаЭПД,
	               |	CW_ОбменГИСЭПДНастройкиЗаполненияЭПД.ТекущийТитул КАК ТекущийТитул
	               |ПОМЕСТИТЬ ВТ_НастроенныеТитулы
	               |ИЗ
	               |	Справочник.CW_ОбменГИСЭПДНастройкиЗаполненияЭПД КАК CW_ОбменГИСЭПДНастройкиЗаполненияЭПД
	               |ГДЕ
	               |	CW_ОбменГИСЭПДНастройкиЗаполненияЭПД.ТипОбъекта = &ТипОбъекта
	               |	И CW_ОбменГИСЭПДНастройкиЗаполненияЭПД.Основная = ИСТИНА
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	CW_ОбменГИСЭПДПроформыТитуловЭПД.ТекущийТитул КАК ТекущийТитул,
	               |	CW_ОбменГИСЭПДПроформыТитуловЭПД.ТипДокументаЭПД КАК ТипДокументаЭПД,
	               |	CW_ОбменГИСЭПДПроформыТитуловЭПД.Ссылка КАК ПроформаЭПД,
	               |	CW_ОбменГИСЭПДСвязанныеДокументыЭПД.СвязанныйЭПД КАК СвязанныйЭПД
	               |ПОМЕСТИТЬ ВТ_СуществующиеДокументы
	               |ИЗ
	               |	Справочник.CW_ОбменГИСЭПДПроформыТитуловЭПД КАК CW_ОбменГИСЭПДПроформыТитуловЭПД
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.CW_ОбменГИСЭПДСвязанныеДокументыЭПД КАК CW_ОбменГИСЭПДСвязанныеДокументыЭПД
	               |		ПО CW_ОбменГИСЭПДПроформыТитуловЭПД.Ссылка = CW_ОбменГИСЭПДСвязанныеДокументыЭПД.ПроформаТитулаЭПД
	               |ГДЕ
	               |	CW_ОбменГИСЭПДПроформыТитуловЭПД.ОбъектОснование = &ОбъектОснование
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ_НастроенныеТитулы.ТипДокументаЭПД КАК ТипДокументаЭПД,
	               |	ВТ_НастроенныеТитулы.ТекущийТитул КАК ТекущийТитул,
	               |	ЕСТЬNULL(ВТ_СуществующиеДокументы.ПроформаЭПД, НЕОПРЕДЕЛЕНО) КАК ПроформаЭПД,
	               |	ЕСТЬNULL(ВТ_СуществующиеДокументы.ПроформаЭПД, ВТ_СуществующиеДокументы.СвязанныйЭПД) КАК ЭПД
	               |ИЗ
	               |	ВТ_НастроенныеТитулы КАК ВТ_НастроенныеТитулы
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_СуществующиеДокументы КАК ВТ_СуществующиеДокументы
	               |		ПО ВТ_НастроенныеТитулы.ТипДокументаЭПД = ВТ_СуществующиеДокументы.ТипДокументаЭПД
	               |			И ВТ_НастроенныеТитулы.ТекущийТитул = ВТ_СуществующиеДокументы.ТекущийТитул
	               |ИТОГИ ПО
	               |	ТипДокументаЭПД"; 
	
	Запрос.УстановитьПараметр("ТипОбъекта", 		ТипОбъекта);
	Запрос.УстановитьПараметр("ОбъектОснование",	Параметры.ПараметрКоманды);
	
	РезультатЗапроса 	= Запрос.Выполнить();
	
	ВыборкаТипДокумента = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаТипДокумента.Следующий() ЦИкл  
		
		СтрокаТипа = ДеревоЗначений.Строки.Добавить();
		СтрокаТипа.ТипДокументаТитул = ВыборкаТипДокумента.ТипДокументаЭПД;
		СтрокаТипа.ЭтоГруппа 		= истина;
		
		ВыборкаТитул = ВыборкаТипДокумента.Выбрать();
		Пока ВыборкаТитул.Следующий() ЦИкл
			СтрокаТитула = СтрокаТипа.Строки.Добавить();
			СтрокаТитула.ТипДокументаТитул 	= ВыборкаТитул.ТекущийТитул;
			СтрокаТитула.ПроформаЭПД 		= ВыборкаТитул.ПроформаЭПД;
			СтрокаТитула.ЭПД 				= ВыборкаТитул.ЭПД; 
			СтрокаТитула.ЕстьЭПД            = ЗначениеЗаполнено(ВыборкаТитул.ЭПД)
		КонецЦикла;  
		
	КонецЦикла;
	
	ЗначениеВРеквизитФормы(ДеревоЗначений, "ДеревоТитулов");
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)  
	
	ЭлементыДерева =ДеревоТитулов.ПолучитьЭлементы(); 
	Для Каждого ЭлементДерева из ЭлементыДерева Цикл
		Элементы.ДеревоТитулов.Развернуть(ЭлементДерева.ПолучитьИдентификатор());
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ПродолжитьСозданиеЭПД(Команда)
	
	ВыбраннаяСтрока = Элементы.ДеревоТитулов.ТекущаяСтрока;
	
	НачатьФормированиеЭПД(ВыбраннаяСтрока);
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоТитуловВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка) 
	
	СтандартнаяОбработка = Ложь;
	
	НачатьФормированиеЭПД(ВыбраннаяСтрока);

КонецПроцедуры  

&НаКлиенте
Процедура НачатьФормированиеЭПД(Знач ВыбраннаяСтрока)
	
	ДанныеСтроки = ПолучитьДанныеСтроки(ВыбраннаяСтрока);
	Если ДанныеСтроки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Оповещение = Новый ОписаниеОповещения("ПродолжитьФормированиеЭПД", ЭтотОбъект, ДанныеСтроки);
	
	Если ЗначениеЗаполнено(ДанныеСтроки.ДокументЭПД) Тогда
		Режим = РежимДиалогаВопрос.ДаНет;
		ПоказатьВопрос(Оповещение, "Проформа ЭПД для выбранного титула существует! Обновить?", Режим, 0); 
	Иначе
		ВыполнитьОбработкуОповещения(Оповещение, КодВозвратаДиалога.Да);
	КонецЕсли;

КонецПроцедуры   

&НаКлиенте
Процедура ПродолжитьФормированиеЭПД(КодВозврата, ДополнительныеПараметры) Экспорт
    Если КодВозврата = КодВозвратаДиалога.Нет Тогда
        Возврат;
    КонецЕсли;

 	Закрыть(ДополнительныеПараметры);

КонецПроцедуры


&НаСервере
Функция ПолучитьДанныеСтроки(ВыбраннаяСтрока)
	
	СтрокаДерева = ДеревоТитулов.НайтиПоИдентификатору(ВыбраннаяСтрока);
	Если СтрокаДерева.ЭтоГруппа Тогда
		Возврат Неопределено;
	КонецЕсли;

	СтрокаРодитель = СтрокаДерева.ПолучитьРодителя();
	
	ДанныеСтроки = Новый Структура;
	ДанныеСтроки.Вставить("ТипДокументаЭПД",	СтрокаРодитель.ТипДокументаТитул);
	ДанныеСтроки.Вставить("ТекущийТитул",		СтрокаДерева.ТипДокументаТитул);
	ДанныеСтроки.Вставить("ДокументЭПД",		СтрокаДерева.ПроформаЭПД);
	
	Возврат ДанныеСтроки;
	
КонецФункции
