&НаКлиенте
Процедура ОткрытьФормуРедактированияРасписанияЗадания(Префикс)
	
	Если ЭтаФорма[Префикс + "ПереводВАрхивРасписаниеРегламентногоЗадания"] = Неопределено Тогда
		ЭтаФорма[Префикс + "ПереводВАрхивРасписаниеРегламентногоЗадания"] = Новый РасписаниеРегламентногоЗадания;
	КонецЕсли;    
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Префикс", Префикс);
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ПереводВАрхивЗавершитьИзменениеРасписания", ЭтотОбъект, ДополнительныеПараметры);
	
	Диалог = Новый ДиалогРасписанияРегламентногоЗадания(ЭтаФорма[Префикс + "ПереводВАрхивРасписаниеРегламентногоЗадания"]);
	Диалог.Показать(ОписаниеОповещения);

КонецПроцедуры    

&НаКлиенте
Процедура ПереводВАрхивЗавершитьИзменениеРасписания(РезультатВыбора, ДополнительныеПараметры) Экспорт
	
	Если РезультатВыбора = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЭтаФорма[ДополнительныеПараметры.Префикс + "ПереводВАрхивРасписаниеРегламентногоЗадания"] = РезультатВыбора;

	УстановитьНадписьРасписания(ДополнительныеПараметры.Префикс);
	
	ЗаписатьИзмененияРегламентногоЗадания(ДополнительныеПараметры.Префикс);
	
КонецПроцедуры


&НаСервере
Процедура ИнициализацияРегламентгогоЗадания(Префикс)
	
	УстановитьПривилегированныйРежим(Истина);
	
	ИмяЗадания = СоответствиеИмениЗаданияПереводаВАрхив.получить(Префикс);
	
	РегламентноеЗадание = РегламентныеЗадания.НайтиПредопределенное(Метаданные.РегламентныеЗадания[ИмяЗадания]);
	ЭтаФорма[Префикс + "ПереводВАрхивРасписаниеРегламентногоЗадания"]	= РегламентноеЗадание.Расписание;
	ЭтаФорма[Префикс + "ПереводВАрхивИспользуется"]						= РегламентноеЗадание.Использование; 
	
	Элементы[Префикс + "ПереводВАрхивРасписаниеВыполнения"].Видимость 	= ЭтаФорма[Префикс + "ПереводВАрхивИспользуется"];

	УстановитьНадписьРасписания(Префикс);

КонецПроцедуры   

&НаСервере
Процедура УстановитьНадписьРасписания(Префикс)
	
	Если ЭтаФорма[Префикс + "ПереводВАрхивРасписаниеВыполнения"] = Неопределено Тогда
		ЭтаФорма[Префикс + "ПереводВАрхивРасписаниеВыполнения"] = НСтр("ru='Настроить расписание выполнения'");
	Иначе
		ЭтаФорма[Префикс + "ПереводВАрхивРасписаниеВыполнения"] = ЭтаФорма[Префикс + "ПереводВАрхивРасписаниеРегламентногоЗадания"];
	КонецЕсли;
	
КонецПроцедуры


