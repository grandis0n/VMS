&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ВерсииПодсистем  = CW_ВерсииПодсистемСервер.УстановленныеВерсииПодсистем();
	Если ВерсииПодсистем.Свойство("CW_ЛичныйКабинетКлиента") Тогда
		ВерсияПодсистемы = ВерсииПодсистем.CW_ЛичныйКабинетКлиента;
	КонецЕсли;      

	ВерсияПодсистемы 	= ?(ВерсияПодсистемы = Неопределено, "Не установлена", ВерсияПодсистемы);
	Заголовок 			= Заголовок + " (версия "+СокрЛП(ВерсияПодсистемы)+")"; 
	
	ПолучитьПараметрыПубликацииИнформационнойБазы();
	Результат = CW_ОбщийМодульЛичныйКабинетСервер.ПолучитьИнформациюЛичногоКабинета(Истина, УникальныйИдентификатор);
	
	Если Результат = Неопределено Тогда
		ВызватьИсключение "Ошибка интернет-соединения. Повтортие попытку позже";
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(ЭтаФорма, Результат); 
	
	ПараметрыУчетнойЗаписи = Новый ФиксированнаяСтруктура(Результат.ДанныеУчетнойЗаписи);
	ПараметрыУчетнойЗаписи.Свойство("name", ПредставлениеУчетнойЗаписи);  
	
	Если ПустаяСтрока(ПредставлениеУчетнойЗаписи) Тогда
		ПредставлениеУчетнойЗаписи = "<Автоматически>";	
	КонецЕсли;
	
	ЗаполнитьДанныеФормы();	
	ПолучитьСписокПараметровДляОтбора();
	
	Если КонецДня(ТекущаяДата()) <= ДатаОкончания 
		И НачалоДня(ТекущаяДата()) >= ДатаНачала Тогда
		Статус = "Действует";
		ЦветТекстаНадписи = WebЦвета.Зеленый;
	Иначе
		Статус = "Не оформлена";
		ЦветТекстаНадписи = WebЦвета.Красный;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДатаНачала) и ЗначениеЗаполнено(ДатаОкончания) Тогда
		ПериодДействия = Формат(ДатаНачала,"ДФ=dd.MM.yyyy")+" - " + Формат(ДатаОкончания,"ДФ=dd.MM.yyyy");
	КонецЕсли;
	
	СтатистикаНачало 	= НачалоМесяца(ТекущаяДата());
	СтатистикаКонец 	= ТекущаяДата();
	
	Элементы.Статус.ЦветТекста = ЦветТекстаНадписи;
	
	Соответствие = Новый Соответствие;
	Соответствие.Вставить("Грузоперевозки", "CW_ПереводГрузоперевозокВАрхив");
	Соответствие.Вставить("Заявки", 		 "CW_ПереводЗаявокВАрхив");
	
	СоответствиеИмениЗаданияПереводаВАрхив = Новый ФиксированноеСоответствие(Соответствие);
	
	//Перевод в архив
	ИнициализацияРегламентгогоЗадания("Грузоперевозки");
	ИнициализацияРегламентгогоЗадания("Заявки");
	//Перевод в архив     
	
	РаботаСВнешнимиРесурсамиЗаблокирована = РегламентныеЗаданияСервер.РаботаСВнешнимиРесурсамиЗаблокирована();
	
	Элементы.ГруппаПродлениеПодписки.Видимость = Не РаботаСВнешнимиРесурсамиЗаблокирована;
	Элементы.НадписьРаботаСВнешнимиРесурсамиЗаблокирована.Видимость = РаботаСВнешнимиРесурсамиЗаблокирована;
	Элементы.КартинкаРаботаСВнешнимиРесурсамиЗаблокирована.Видимость = РаботаСВнешнимиРесурсамиЗаблокирована;

	Элементы.ИзменитьПредставлениеАдреса.Доступность = Не РаботаСВнешнимиРесурсамиЗаблокирована;
	Элементы.ИзменитьЭлектронныйАдресРегистрации.Доступность = Не РаботаСВнешнимиРесурсамиЗаблокирована;
	Элементы.ИзменитьКонтакты.Доступность = Не РаботаСВнешнимиРесурсамиЗаблокирована;
	Элементы.ИзменитьПубликацюБазыДанных.Доступность = Не РаботаСВнешнимиРесурсамиЗаблокирована;
	Элементы.ИзменитьСерверЛичногоКабинета.Доступность = Не РаботаСВнешнимиРесурсамиЗаблокирована;
	
	//Подсистема.ОбменДокументами
	РазрешенныеОрганизации.ЗагрузитьЗначения(Результат.РазрешенныеОрганизации);
    УстановитьДоступностьНастроекОбменаДанынми();  
	УстановитьВидиостьСпискаКонтрагентов();
	//Подсистема.ОбменДокументами  
	
КонецПроцедуры

&НаСервере
Процедура ПолучитьПараметрыПубликацииИнформационнойБазы()
	//Проверка наличия клиента с указанным регистрационным номера в базе Сервиса
	РегистрационныйНомер 		= CW_ПроверкаЛицензии.ПолучитьРегистрационныйНомер();

	СтруктураJSON = Новый Структура;
	СтруктураJSON.Вставить("regnumber", XMLСтрока(РегистрационныйНомер));
	
	ПараметрыHTTPЗапроса = CW_РаботаСВнешнимиРесурсамиСервер.ПодготовитьHTTPЗапрос("lkk_parametersinfo", СтруктураJSON);
	Ответ 		= CW_РаботаСВнешнимиРесурсамиСервер.ПолучитьДанныеССервера(ПараметрыHTTPЗапроса.HTTPСоединение, ПараметрыHTTPЗапроса.HTTPЗапрос, "GET"); 
	Если Ответ = Неопределено Тогда
		Возврат;	
	КонецЕсли;  
	
	Если Ответ.КодСостояния = 200 Тогда
		
		СтруктураJSON = CW_РаботаСВнешнимиРесурсамиСервер.ПрочитатьHTTPСервисВОбъект(Ответ);
		
		ЛичныйКабинетНаименование	 		= XMLЗначение(Тип("Строка"), СтруктураJSON.customername); 	
		ЛичныйКабинетИмяСервера 			= XMLЗначение(Тип("Строка"),СтруктураJSON.servername); 		
		ЛичныйКабинетПортСервера 			= XMLЗначение(Тип("Число"),СтруктураJSON.port);
		ЛичныйКабинетЗащищенноеСоединение 	= XMLЗначение(Тип("Булево"),СтруктураJSON.ssl); 			
		ЛичныйКабинетИмяБазыДанных 			= XMLЗначение(Тип("Строка"),СтруктураJSON.basename); 		
		
	КонецЕсли;
	
КонецПроцедуры	   	

&НаСервере
Процедура ПолучитьСписокПараметровДляОтбора()
	
	МассивПараметров = ПланыВидовХарактеристик.CW_ПараметрыГрузоперевозок.ПолучитьСписокПараметровПоТипуЗначения(Тип("Булево"));
	СписокПараметровДляОтбора.ЗагрузитьЗначения(МассивПараметров);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДанныеФормы()
	
	ОграничениеРазмераФайла = Константы.CW_ЛичныйКабинетОграничениеРазмераФайла.Получить();
	
	ssl = Константы.CW_ЛичныйКабинетЗащищенноеСоединение.Получить();
	СтрокаСерверЛичногоКабинета = "http"+?(ssl,"s","")+"://"+СокрЛП(Константы.CW_ЛичныйКабинетИмяСервера.Получить())+"/";
	
	СтрокаПубликацияБазыДанных = "http"+?(ЛичныйКабинетЗащищенноеСоединение,"s","")+"://";
	
	Если Не ПустаяСтрока(ЛичныйКабинетИмяСервера) и Не ЛичныйКабинетПортСервера  = 0 и Не ПустаяСтрока(ЛичныйКабинетИмяБазыДанных) Тогда
		СтрокаПубликацияБазыДанных = СтрокаПубликацияБазыДанных 
		+ СокрЛП(ЛичныйКабинетИмяСервера)+":"+Формат(ЛичныйКабинетПортСервера,"ЧГ=0")+"/"
		+ СокрЛП(ЛичныйКабинетИмяБазыДанных);
	КонецЕсли;  
	
	УчетнаяЗаписьДляОтправкиУведомлений 	= Константы.CW_ЛичныйКабинетУчетнаяЗаписьДляОтправкиУведомлений.Получить();
	ПараметрПереводаГрузоперевозкиВАрхив 	= Константы.CW_ПараметрПереводаГрузоперевозкиВАрхив.Получить();
	ПараметрПереводаЗаявкиВАрхив 			= Константы.CW_ПараметрПереводаЗаявкиВАрхив.Получить();
	
	//Подсистема.ОбменДокументами
	CW_ПорядокДоступаКДокументам		= Константы.CW_ПорядокДоступаКДокументам.Получить();   
	ИспользуетсяЭлектронныйОбменДанными = Константы.CW_ИспользуетсяЭлектронныйОбменДанными.Получить();
	//Подсистема.ОбменДокументами
	
	
КонецПроцедуры

