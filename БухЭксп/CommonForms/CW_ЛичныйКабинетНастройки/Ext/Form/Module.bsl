КонецПроцедуры

&НаКлиенте
Процедура ПродолжитьВыполнениеВФоне(ФоновояПроцедура, текст="")
	
	РезультатВыполнения =  ПереводВАрхивВыполнитьНаСервереВФоне(ФоновояПроцедура);
	
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ВыводитьОкноОжидания = Истина;                                                                                             
	
	Дополнительныепараметры = Новый Структура;
	Дополнительныепараметры.Вставить("Текст", текст);
	
	ОповещениеОЗавершении = Новый ОписаниеОповещения("ЗавершениеВыполненияРегламентногоЗаданияПереводВАрхив", ЭтотОбъект, Дополнительныепараметры);
	
	ДлительныеОперацииКлиент.ОжидатьЗавершение(РезультатВыполнения, ОповещениеОЗавершении, ПараметрыОжидания);

КонецПроцедуры 

&НаСервере
Функция ПереводВАрхивВыполнитьНаСервереВФоне(ФоновояПроцедура)
	
	ПараметрыПроцедуры = Новый Структура;
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(Новый УникальныйИдентификатор);
	ПараметрыВыполнения.ОжидатьЗавершение 			= 0; // запускать сразу
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = "Перевод в архив";
	ПараметрыВыполнения.ЗапуститьВФоне 				= Истина;
	ПараметрыВыполнения.ЗапуститьНеВФоне 			= ложь;
	
	Возврат ДлительныеОперации.ВыполнитьВФоне(ФоновояПроцедура, ПараметрыПроцедуры, ПараметрыВыполнения);
	
КонецФункции

&НаКлиенте
Процедура ЗавершениеВыполненияРегламентногоЗаданияПереводВАрхив(РезультатВыполнения, Дополнительныепараметры) Экспорт
	
	Если РезультатВыполнения.Статус = "Выполнено" Тогда
		ПоказатьОповещениеПользователя("Регламентное задание",,"Перевод "+Дополнительныепараметры.Текст+" в архив завершен");
	ИначеЕсли РезультатВыполнения.Статус = "Ошибка" Тогда
		ПоказатьОповещениеПользователя("Регламентное задание",,"Ошибка перевода "+Дополнительныепараметры.Текст+" в архив");
	КонецЕсли;
	
КонецПроцедуры    

&НаСервере
Процедура ПереводВАрхивИспользуетсяПриИзмененииНаСервере(Префикс)
	
	ЗаписатьИзмененияРегламентногоЗадания(Префикс);
	Элементы[Префикс + "ПереводВАрхивРасписаниеВыполнения"].Видимость = ЭтаФорма[Префикс + "ПереводВАрхивИспользуется"];
	
КонецПроцедуры   

&НаСервере
Процедура ЗаписатьИзмененияРегламентногоЗадания(Префикс)  
	
	ИмяЗадания = СоответствиеИмениЗаданияПереводаВАрхив.Получить(Префикс); 
	
	УстановитьПривилегированныйРежим(Истина);
	
	РегламентноеЗадание = РегламентныеЗадания.НайтиПредопределенное(Метаданные.РегламентныеЗадания[ИмяЗадания]);
	
	РегламентноеЗадание.Использование 	= ЭтаФорма[Префикс + "ПереводВАрхивИспользуется"];
	РегламентноеЗадание.Расписание 		= ЭтаФорма[Префикс + "ПереводВАрхивРасписаниеРегламентногоЗадания"];
	РегламентноеЗадание.Записать();
	
КонецПроцедуры

