&НаСервере
Функция УдалитьЛоготипНаСервере()
	
	СтруктураJSON = Новый Структура; 
	СтруктураJSON.Вставить("regnumber",  XMLСтрока(РегНомер));
	
	ПараметрыHTTPЗапроса = CW_РаботаСВнешнимиРесурсамиСервер.ПодготовитьHTTPЗапрос("lkk_dellogo", СтруктураJSON);
	Ответ 		= CW_РаботаСВнешнимиРесурсамиСервер.ПолучитьДанныеССервера(ПараметрыHTTPЗапроса.HTTPСоединение, ПараметрыHTTPЗапроса.HTTPЗапрос, "POST"); 
	Если Ответ = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат Ответ.КодСостояния;
	
КонецФункции

&НаСервере
Функция УстановитьЛоготипНаСервере(АдресЛоготипа)
	
	ДвоичныеДанные 	= ПолучитьИзВременногоХранилища(АдресЛоготипа);
	СодержимоеФайла = Base64Строка(ДвоичныеДанные);
	
	СтруктураJSON = Новый Структура; 
	СтруктураJSON.Вставить("regnumber",  XMLСтрока(РегНомер));
	СтруктураJSON.Вставить("logo",  	 XMLСтрока(СодержимоеФайла)); 
	
	ПараметрыHTTPЗапроса = CW_РаботаСВнешнимиРесурсамиСервер.ПодготовитьHTTPЗапрос("lkk_setlogo", СтруктураJSON);
	Ответ 		= CW_РаботаСВнешнимиРесурсамиСервер.ПолучитьДанныеССервера(ПараметрыHTTPЗапроса.HTTPСоединение, ПараметрыHTTPЗапроса.HTTPЗапрос, "POST"); 
	Если Ответ = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат Ответ.КодСостояния;
	
КонецФункции


&НаКлиенте
Процедура ИзменитьКонтакты(Команда)
	
	Оповещение = Новый ОписаниеОповещения("ОбработатьРезультатИзмененияКонтактнойИнформации", ЭтотОбъект, Параметры);
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("НазваниеКомпании", 		НазваниеКомпании);
	СтруктураПараметров.Вставить("НазваниеКомпанииАнгл", 	НазваниеКомпанииАнгл);
	СтруктураПараметров.Вставить("Сайт", 			 		Сайт);
	СтруктураПараметров.Вставить("Телефоны", 		 		Телефоны);
	СтруктураПараметров.Вставить("ЭлектроннаяПочта", 		ЭлектроннаяПочта);
	СтруктураПараметров.Вставить("ЧасовойПояс", 			ЧасовойПояс);
	
	ОткрытьФорму("ОбщаяФорма.CW_ЛичныйКабинетИзменениеКонтактнойИнформации", СтруктураПараметров, ЭтаФорма,,,,Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьРезультатИзмененияКонтактнойИнформации(Результат, Параметры) Экспорт
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Результат.Свойство("НазваниеКомпании",			НазваниеКомпании);
	Результат.Свойство("НазваниеКомпанииАнгл",		НазваниеКомпанииАнгл);
	Результат.Свойство("Сайт", 			 			Сайт);
	Результат.Свойство("Телефоны", 					Телефоны);
	Результат.Свойство("ЭлектроннаяПочта", 			ЭлектроннаяПочта);
	Результат.Свойство("ЧасовойПояс", 				ЧасовойПояс);
	Результат.Свойство("ЧасовойПоясПредставление",	ЧасовойПоясПредставление);
	
	ПоказатьПредупреждение(,"Контактная информация обновлена", ,"Личный кабинет клиента");
	
КонецПроцедуры

