&НаКлиенте
Процедура Очистить(Команда)
	
	Если ПустаяСтрока(АдресЛоготипа) Тогда
		КодСостояния = УдалитьЛоготипНаСервере();
		Если КодСостояния <> 200 Тогда
			ПоказатьПредупреждение(,"Не удалось очистить установленный логотип. Попробуйте позднее...");
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	АдресЛоготипа  = "";
	
КонецПроцедуры

