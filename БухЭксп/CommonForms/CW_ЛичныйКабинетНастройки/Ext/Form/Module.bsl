&НаКлиенте
Процедура ОткрытьФормуВыбораПараметров(Элемент)
	
	МассивПараметров = ПолучитьПараметрыДляОтбора();
	
	СтруктураОтбора = Новый Структура;
	СтруктураОтбора.Вставить("Ссылка", МассивПараметров);
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("Отбор", СтруктураОтбора);
	
	ОткрытьФорму("ПланВидовХарактеристик.CW_ПараметрыГрузоперевозок.ФормаВыбора", СтруктураПараметров, Элемент);

