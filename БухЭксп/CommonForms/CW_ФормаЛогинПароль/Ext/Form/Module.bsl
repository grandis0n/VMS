&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ДанныеАутентификацииПользователя = CW_МониторПорталаПоддержкиСервер.ДанныеАутентификацииПользователяИнтернетПоддержки();
	
	Если ТипЗнч(ДанныеАутентификацииПользователя) = Тип("Структура") Тогда
		ДанныеАутентификацииПользователя.Свойство("Логин",  Логин);
		ДанныеАутентификацииПользователя.Свойство("Пароль", Пароль);
	КонецЕсли;	 
	
	СтарыйЛогин = Логин;

КонецПроцедуры

&НаСервере
Функция СохранитьСеансовуюНастройку()
	
	ВладелецДанных = CW_МониторПорталаПоддержкиСервер.ИдентификаторПодсистемы();
	
	Если ЗначениеЗаполнено(Логин) И ЗначениеЗаполнено(Пароль) Тогда                        
		ПараметрыАвтоизации = Новый Структура;
		ПараметрыАвтоизации.Вставить("ВладелецДанных", ВладелецДанных);
		ПараметрыАвтоизации.Вставить("Логин", Логин);
		ПараметрыАвтоизации.Вставить("Пароль", Пароль);
		
		Возврат CW_РегистрацияПрограммыСервер.ЗаписатьПараметрыАвторизации(ПараметрыАвтоизации);
	КонецЕсли;  

КонецФункции

&НаКлиенте
Процедура СохранитьДанныеАутентификацииИПродолжить(Команда)
	
	Если Не ПроверитьЗаполнение() Тогда
		Возврат;
	КонецЕсли;
	
	Успешно = СохранитьСеансовуюНастройку();
	Если Успешно = Неопределено Тогда
		ПоказатьПредупреждение(, "Регистрационные данные не изменены!");
		Возврат;
	КонецЕсли;  
	
	Если Успешно = Ложь Тогда      
		Логин =  СтарыйЛогин;
		ПоказатьПредупреждение(, "Введенные параметры авторизации не соответствуют установленной лицензии!");  
		Возврат;
	КонецЕсли;  
		
	Модифицированность = Ложь;  
	Ответ = Новый Структура;
	Ответ.Вставить("ИзменилсяЛогин", (СтарыйЛогин <> Логин));
	ЭтаФорма.Закрыть(Ответ);
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьПароль(Команда)
	
	ПоказатьСкрытьПароль = Не ПоказатьСкрытьПароль;
	Элементы.ПоказатьПароль.Пометка = ПоказатьСкрытьПароль;
	
	Элементы.Пароль.РежимПароля = Не ПоказатьСкрытьПароль;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьПодключение(Команда) 
	
	Если НЕ CW_РаботаСFTPРесурсами.ПроверитьЗаполнениеПараметровFTP() Тогда     
		
		НавигационнаяСылка = "e1cib/list/Справочник.CW_НастройкиFTPРесурсов";
		
		мСтроки = Новый Массив;
		мСтроки.Добавить(Новый ФорматированнаяСтрока("Настройки подключения к сайту технической поддержке заполнены некорректно!"));
		мСтроки.Добавить(Новый ФорматированнаяСтрока(Символы.ПС));
		мСтроки.Добавить(Новый ФорматированнаяСтрока("Проверьте правильность параметров подключения в справочнике "));  
		мСтроки.Добавить(Новый ФорматированнаяСтрока("Настройки ftp-ресурсов",,,,НавигационнаяСылка));  
		
		ФорматированнаяСтрока = Новый ФорматированнаяСтрока(мСтроки);
		ПоказатьПредупреждение(,ФорматированнаяСтрока,60,"Проверка подключения");
		Возврат;
	КонецЕсли;
	
	Если ПроверитьПодключениеНаСервере() Тогда
		ПоказатьПредупреждение(,"Подключение выполнено успешно",60,"Проверка подключения");
	Иначе
		ПоказатьПредупреждение(,"Не удалось подключиться к серверу техподдержки! Проверьте правильность введенных данных",60,"Проверка подключения");
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПроверитьПодключениеНаСервере()
	
	HTTPСоединение = CW_ИсправленияКонфигурации.ПодключитьсяКРесурусуОбновлений(Логин, Пароль);
	Возврат НЕ HTTPСоединение = Неопределено;
	
КонецФункции

&НаКлиенте
Процедура УдалитьНастройку(Команда)
	
	Режим = РежимДиалогаВопрос.ДаНет;
	Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаОбУдаленииНастройки", ЭтотОбъект, Параметры);
	ПоказатьВопрос(Оповещение, "Настройка подключения к сайту техподдержи будет удалена. Продолжить?", Режим, 0);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияВопросаОбУдаленииНастройки(Результат, Параметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Нет Тогда
        Возврат;
	КонецЕсли;
	
	УдалитьДанныеИзБезопасногоХранилищаНаСервере();

КонецПроцедуры

&НаСервере
Процедура УдалитьДанныеИзБезопасногоХранилищаНаСервере()
	
	Логин  = "";  	Пароль = "";
	
	ВладелецДанных = CW_МониторПорталаПоддержкиСервер.ИдентификаторПодсистемы();
	ОбщегоНазначения.УдалитьДанныеИзБезопасногоХранилища(ВладелецДанных, "login,password");

КонецПроцедуры