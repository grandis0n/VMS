КонецПроцедуры 

&НаСервере
Процедура ДеревоОплатСуммаНДСПриИзмененииНаСервере(ИдентификаторСтроки)
	
	СтрокаДерева = ДеревоОплат.НайтиПоИдентификатору(ИдентификаторСтроки); 
	РодительСтроки  = СтрокаДерева.ПолучитьРодителя();
	Если РодительСтроки <> Неопределено Тогда
		ПересчитатьСуммуНДСРодителя(РодительСтроки);
	КонецЕсли;
	
КонецПроцедуры


&НаСервере
Функция _ПроверитьКорректностьОплаты_БВ(ТС)
	
	СтрукутраКурса = CW_Финансы.ПолучитьКурсВалюты(Валюта, Дата);
	
	// пересчитываем валютную сумму по курсу
		
	СтрокаДерева = ДеревоОплат.НайтиПоИдентификатору(ТС);
	Если СтрокаДерева.Оплата_Валюта = 0 И СтрокаДерева.Курс <> 0 Тогда
		
		Если (РежимДДС) Тогда
			
			СтрокаДерева.Курс = КроссКурс;
			СтрокаДерева.Оплата_Валюта = _сф.БезопасноРазделить(СтрокаДерева.Оплата_БВ,СтрокаДерева.Курс / СтрукутраКурса.Кратность);
			
		Иначе
			
			СтрокаДерева.Оплата_Валюта = _сф.БезопасноРазделить(СтрокаДерева.Оплата_БВ,СтрокаДерева.Курс / СтрукутраКурса.Кратность);
			//_ПроверитьКорректностьОплаты(ТС);
			
		КонецЕсли; 
		
	Иначе
		
		СтрокаДерева.Курс = _сф.БезопасноРазделить(СтрокаДерева.Оплата_БВ,СтрокаДерева.Оплата_Валюта) * СтрукутраКурса.Кратность;
		
	КонецЕсли; 
	
КонецФункции

