&НаКлиенте
Процедура ДеревоОплатВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТД = Элементы.ДеревоОплат.ТекущиеДанные;
	
	Если Поле = Элементы.ДеревоОплатСуммаДокумента Тогда
		
		Если (ТД.СуммаДокумента > 0) Тогда
			
			ТД.Оплата_Валюта = ТД.СуммаДокумента;
			_ПроверитьКорректностьОплаты(Элементы.ДеревоОплат.ТекущаяСтрока);	
			
			ПересчитатьСтавкуНДСПоСтроке(Элементы.ДеревоОплат.ТекущаяСтрока);
	
		КонецЕсли; 
			
	ИначеЕсли Поле = Элементы.ДеревоОплатЗадолженность Тогда
		
		Если (ТД.Задолженность > 0) Тогда
			
			ТД.Оплата_Валюта = ТД.Задолженность;
			_ПроверитьКорректностьОплаты(Элементы.ДеревоОплат.ТекущаяСтрока);
			
			ПересчитатьСтавкуНДСПоСтроке(Элементы.ДеревоОплат.ТекущаяСтрока);
	
		КонецЕсли; 
		
	КонецЕсли; 
	
	ОбновитьИтоги();
	
КонецПроцедуры


&НаКлиенте
Процедура ДеревоОплатОплата_ВалютаПриИзменении(Элемент)
	
	// необходимо проверить, если это счёт, то сумма оплаты не должна превышать сумму оплаты по подчинённым актам,
	// если акт - аналогично
	Ответ = _ПроверитьКорректностьОплаты(Элементы.ДеревоОплат.ТекущаяСтрока);  
	
	ПересчитатьСтавкуНДСПоСтроке(Элементы.ДеревоОплат.ТекущаяСтрока);
	
	ОбновитьИтоги();
	Если НЕ _УФКС.ВыполненоУспешно(Ответ) Тогда
		
		_УФК.ВывестиПредупреждение(_УФКС.ПредставлениеОшибки(Ответ));
		
	КонецЕсли; 
	
КонецПроцедуры

&НаСервере
Функция _ПроверитьКорректностьОплаты(ТС)   
	
	СтрокаДерева = ДеревоОплат.НайтиПоИдентификатору(ТС);
	// --- 
	Если (СтрокаДерева.Оплата_Валюта <= 0) Тогда
		
		СтрокаДерева.Оплата_Валюта = 0;
		СтрокаДерева.Оплата_БВ = 0;		
			
	КонецЕсли; 
	Если (СтрокаДерева.Оплата_БВ < 0) Тогда
		
		СтрокаДерева.Оплата_БВ = 0;	
		
	КонецЕсли; 
	
	//Для получения кратности
	СтруктураКурса = CW_Финансы.ПолучитьКурсВалюты(Валюта,Дата);
	//Для получения кратности
	
	
	// --- 
	Если (РежимДДС) Тогда
		
		// пересчитываем по кросс-курсу из шапки
		СтрокаДерева.Курс = КроссКурс;
		СтрокаДерева.Оплата_БВ = Окр(СтрокаДерева.Оплата_Валюта*СтрокаДерева.Курс / СтруктураКурса.Кратность, 2);
		
	Иначе
		
		Если УЕ Тогда
			
			Если СтрокаДерева.Курс = 0 Тогда
				
				СтрокаДерева.Курс 		= СтруктураКурса.Курс;
				СтрокаДерева.Оплата_БВ 	= ОКР(СтрокаДерева.Оплата_Валюта*СтрокаДерева.Курс / СтруктураКурса.Кратность, 2);
				
			Иначе
				
				Если СтрокаДерева.Оплата_БВ = 0 Тогда
					
					СтрокаДерева.Оплата_БВ = ОКР(СтрокаДерева.Оплата_Валюта*СтрокаДерева.Курс / СтруктураКурса.Кратность, 2);
					
				Иначе
					
					СтрокаДерева.Курс = _сф.БезопасноРазделить(СтрокаДерева.Оплата_БВ,СтрокаДерева.Оплата_Валюта) * СтруктураКурса.Кратность;
					
				КонецЕсли; 
				
			КонецЕсли; 
			
		КонецЕсли;
		
	КонецЕсли; 
	
	// --- 
	Если СтрокаДерева.ЭтоСчет Тогда
		
		ОплатаПоСчету = СтрокаДерева.Оплата_Валюта;
		ОплатаПоАктам = 0;
		Для каждого СтрокаАкта Из СтрокаДерева.ПолучитьЭлементы() Цикл
			
			_сф.Инкремент(ОплатаПоАктам,СтрокаАкта.Оплата_Валюта);
			
		КонецЦикла; 
		Если ОплатаПоАктам > ОплатаПоСчету Тогда
			
			СтрокаДерева.Оплата_Валюта = ОплатаПоАктам;
			_ПроверитьКорректностьОплаты(СтрокаДерева.ПолучитьИдентификатор());
			
		КонецЕсли; 
				
	Иначе
		
		СтрокаСчета = СтрокаДерева.ПолучитьРодителя();
		ОплатаПоСчету = СтрокаСчета.Оплата_Валюта;
		ОплатаПоАктам = 0;
		Для каждого СтрокаАкта Из СтрокаСчета.ПолучитьЭлементы() Цикл
			
			_сф.Инкремент(ОплатаПоАктам,СтрокаАкта.Оплата_Валюта);
			
		КонецЦикла; 
		Если ОплатаПоАктам > ОплатаПоСчету Тогда
			
			СтрокаСчета.Оплата_Валюта = ОплатаПоАктам;
			_ПроверитьКорректностьОплаты(СтрокаСчета.ПолучитьИдентификатор());
			
		КонецЕсли; 
		
	КонецЕсли; 
	
	Возврат _УФКС.Ответ();

КонецФункции

// --- 

&НаКлиенте
Процедура ДеревоОплатОплата_БВПриИзменении(Элемент)
	
	Ответ = _ПроверитьКорректностьОплаты_БВ(Элементы.ДеревоОплат.ТекущаяСтрока);   
	
	ПересчитатьСтавкуНДСПоСтроке(Элементы.ДеревоОплат.ТекущаяСтрока, "БВ");
	
	ОбновитьИтоги();
	
КонецПроцедуры     

&НаСервере
Процедура ПересчитатьСтавкуНДСПоСтроке(ИдентификаторСтроки, Постфикс="Валюта") 
	
	ПостфиксЗадолженность = ?(Постфикс="Валюта", "", "_"+Постфикс);
	
	СтрокаДерева = ДеревоОплат.НайтиПоИдентификатору(ИдентификаторСтроки); 
	Если СтрокаДерева["Оплата_"+Постфикс] = 0 Тогда
		Возврат;
	КонецЕсли;    
	
	Если Не ЗначениеЗаполнено(СтрокаДерева.СтавкаНДС) Тогда 
		СтрокаДерева.СтавкаНДС =  СтрокаДерева.СтавкаНДСИсходная;    
	КонецЕсли;
	ЗначениеСтавки = CW_Финансы.ПолучитьСтавкуНДС(СтрокаДерева.СтавкаНДС)/100;

	Если СтрокаДерева["Задолженность"+ПостфиксЗадолженность] = 0 Тогда
		
		// при расчетах в у.е. сумму НДС рассчитываем от рублевого эквивалента оплаты
		Если УЕ Тогда
			СтрокаДерева.СуммаНДС = Окр(СтрокаДерева["Оплата_БВ"]  * ЗначениеСтавки/(1+ЗначениеСтавки),2,1);
		Иначе
			СтрокаДерева.СуммаНДС = Окр(СтрокаДерева["Оплата_"+Постфикс]  * ЗначениеСтавки/(1+ЗначениеСтавки),2,1);
		КонецЕсли;
	Иначе
		Если СтрокаДерева = Неопределено 
			или СтрокаДерева.СуммаДокумента = 0 Тогда
			КоэффициентОплаты = 0; 
		Иначе
			КоэффициентОплаты = СтрокаДерева["Оплата_Валюта"] / СтрокаДерева.СуммаДокумента;
		КонецЕсли;
		
		Если КоэффициентОплаты < 1 Тогда
			СтрокаДерева.СуммаНДС = Окр(СтрокаДерева.СуммаНДСИсходная * КоэффициентОплаты, 2);
		Иначе
			СтрокаДерева.СуммаНДС = СтрокаДерева.СуммаНДСИсходная;
		КонецЕсли;  
	КонецЕсли; 
	
	РодительСтроки  = СтрокаДерева.ПолучитьРодителя();
	Если РодительСтроки <> Неопределено Тогда
		ПересчитатьСуммуНДСРодителя(РодительСтроки);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПересчитатьСуммуНДСРодителя(РодительСтроки)
	
	ЭлементыРодителя = РодительСтроки.ПолучитьЭлементы();
	
	СуммаНДС = 0;
	Для Каждого ПодчиненнаяСтрока из ЭлементыРодителя Цикл
		СуммаНДС = СуммаНДС + ПодчиненнаяСтрока.СуммаНДС;
	КонецЦикла;
	
	РодительСтроки.СуммаНДС = СуммаНДС;

КонецПроцедуры   


&НаКлиенте
