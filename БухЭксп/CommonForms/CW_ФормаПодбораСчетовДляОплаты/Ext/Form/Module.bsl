&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	CW_Документы.ОпределитьВозможностьОткрытияОбъектаМодуля(Тип("ДокументМенеджер.ПоступлениеНаРасчетныйСчет"),,Отказ);

	БазоваяВалюта 	= CW_Настройки.ВалютаРегламентированногоУчета();
	
	//Для версии КОРП
	ВестиУчетПоПодразделениям 				= ПолучитьФункциональнуюОпцию("ВестиУчетПоПодразделениям");
	Элементы.ГруппаОрганизация.Видимость 	= ВестиУчетПоПодразделениям;
	
	Параметры.Свойство("ПодразделениеОрганизации",ПодразделениеОрганизации);
	Элементы.ПодразделениеОрганизации.ТолькоПросмотр = ЗначениеЗаполнено(ПодразделениеОрганизации);
	//Для версии КОРП
	
	ЗаполнитьЗначенияСвойств(ЭтаФорма,Параметры,"Организация,Контрагент,Договор,Валюта,ВалютаДокумента,Представление,Дата,ВедомыйДокумент,СтатьяДДС,ВидОперации");
	
	//Подсистема.УчетПриложенийДоговоров
	УстановитьВидимостьПриложения();
	
	ПриложениеКДоговору = Параметры.ПриложениеКДоговору; 
	//Подсистема.УчетПриложенийДоговоров    
	
	
	Параметры.Свойство("СуммаОплаты",СуммаОплаты);
	Параметры.Свойство("ПлатежноеПоручение",ПлатежноеПоручение);
	Если (ВедомыйДокумент <> Неопределено) Тогда
		АвтоматическийПодборСчетов = ВедомыйДокумент.АвтоматическийПодборСчетов;
		АвтоматическийПодборАктов = ВедомыйДокумент.АвтоматическийПодборАктов;
	Иначе
		АвтоматическийПодборСчетов = Ложь;
		АвтоматическийПодборАктов = Ложь;
	КонецЕсли; 
	
	//Параметры выбора договора
	Если ТипЗнч(ПлатежноеПоручение) = Тип("ДокументСсылка.СписаниеСРасчетногоСчета") Тогда
		ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком;	
	ИначеЕсли ТипЗнч(ПлатежноеПоручение) = Тип("ДокументСсылка.ПоступлениеНаРасчетныйСчет") Тогда
		ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПокупателем;	
	КонецЕсли;  
	
	ПараметрыВыбора = Новый Массив;
	ПараметрыВыбора.Добавить(Новый ПараметрВыбора("Отбор.БухгалтерскийУчет", Истина));
	
	Если ВидДоговора <> Неопределено Тогда
		ПараметрыВыбора.Добавить(Новый ПараметрВыбора("Отбор.ВидДоговора", ВидДоговора));
	КонецЕсли;
	
	Если ВалютаДокумента <> БазоваяВалюта Тогда
		ПараметрыВыбора.Добавить(Новый ПараметрВыбора("Отбор.ВзаиморасчетыВУЕ", ЛОЖЬ));
	КонецЕсли;
	//Параметры выбора договора
	
	УстановитьПараметрыБухгалтерскогоУчета();
	
	ТаблицаОЗ 		= ПолучитьИзВременногоХранилища(Параметры.АдресТаблицыОЗ);
	АдресТаблицыОЗ 	= ПоместитьВоВременноеХранилище(ТаблицаОЗ,ЭтаФорма.УникальныйИдентификатор);
	
	СН 		= CW_Настройки.ПараметрГлобальнойУчетнойПолитики(Дата,Организация,"СистемаНалогообложения");
	ОСНО 	= СН = Перечисления.СистемыНалогообложения.Общая;   
	
	Если Не ПриложениеКДоговору.Пустая() Тогда
		УстановитьПараметриыПриложенияДоговора(ПриложениеКДоговору);
	Иначе
		УстановитьПараметриыПриложенияДоговора(Договор);
	КонецЕсли;
	
	// восстанавливаем настройки
	_ВосстановитьНастройки();
	
	РежимДДС = (_сф.ст_ПолучитьСвойство(Параметры,"РежимДДС"));
	Если (РежимДДС = Неопределено) Тогда
		РежимДДС = Ложь;
	КонецЕсли; 
	Если (РежимДДС) Тогда
		ВалютаКассы = _сф.ст_ПолучитьСвойство(Параметры,"ВалютаКассы");
		Элементы.Валюта.Видимость = (Валюта <> ВалютаКассы);
		Элементы.КроссКурс.Видимость = (Валюта <> ВалютаКассы);
		Если (Элементы.КроссКурс.Видимость) Тогда
			
			КурсВД = CW_Финансы.ПолучитьКурсВалюты(Валюта,Дата);
			КурсВК = CW_Финансы.ПолучитьКурсВалюты(ВалютаКассы,Дата);
			
			КроссКурс = _сф.БезопасноРазделить(КурсВД.Курс,КурсВК.Курс)*_сф.БезопасноРазделить(КурсВК.Кратность,КурсВД.Кратность);
			
		КонецЕсли; 
		Элементы.ВалютаКассы.Видимость = Истина;
		Элементы.ДеревоОплатОплата_БВ.Заголовок = "Оплата, "+Строка(ВалютаКассы);
		Элементы.ДеревоОплатКурс.Видимость = (Ложь);
		Элементы.ДеревоОплатОплата_БВ.Видимость = (Валюта <> ВалютаКассы);
		Элементы.СтатьяДДС.Видимость = Ложь;
		Элементы.ПорядокОтраженияАванса.Видимость = Ложь;
	Иначе
		Элементы.Валюта.Видимость = (Валюта <> БазоваяВалюта И УЕ);
		Элементы.ВалютаКассы.Видимость = Ложь;
		Элементы.КроссКурс.Видимость = Ложь;
		Элементы.ДеревоОплатОплата_БВ.Заголовок = "Оплата, "+Строка(БазоваяВалюта);
		Элементы.ДеревоОплатКурс.Видимость = УЕ;
		Элементы.ДеревоОплатОплата_БВ.Видимость = УЕ;
		БУ = CW_Конфигурация.ПланСчетов().Касса;
		ВестиУчетПоСтатьямДДС = НЕ (БУ.ВидыСубконто.Найти(CW_Конфигурация.ВидыСубконто().СтатьиДвиженияДенежныхСредств, "ВидСубконто") = Неопределено);
		Элементы.СтатьяДДС.Видимость = (ВестиУчетПоСтатьямДДС);
		УСН = (СН = Перечисления.СистемыНалогообложения.Упрощенная И Договор.ВидДоговора=Перечисления.ВидыДоговоровКонтрагентов.СПокупателем);
		Элементы.ПорядокОтраженияАванса.Видимость = УСН;
	КонецЕсли; 
	
	Если (Договор.ВидДоговора=Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком) Тогда
		ПустойАкт = Документы.CW_РасходыПоГрузоперевозке.ПустаяСсылка();
		Если (РежимДДС) Тогда
			ПлатежноеПоручение = Документы.СписаниеСРасчетногоСчета.ПустаяСсылка();
		КонецЕсли; 
	Иначе
		ПустойАкт = Документы.CW_ДоходыПоГрузоперевозке.ПустаяСсылка();
		Если (РежимДДС) Тогда
			ПлатежноеПоручение = Документы.ПоступлениеНаРасчетныйСчет.ПустаяСсылка();
		КонецЕсли; 
	КонецЕсли; 
	
	УстаноитьЗаголовкиЭлементов();
	
	_УправлениеЭлементамиФормы();
	_ОбновитьДерево();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьПараметрыБухгалтерскогоУчета()
	
	СтруктураПараметровБухУчета = Новый Структура;
	СтруктураПараметровБухУчета.Вставить("Договор", 				Договор);
	СтруктураПараметровБухУчета.Вставить("ПриложениеКДоговору",		ПриложениеКДоговору);
	
	ПараметрыБухгалтерскогоУчета  	= CW_Финансы.ПолучитьПарметрыВеденияБухгалтерскогоУчета(СтруктураПараметровБухУчета, Дата);
	ПоДоговоруВедетсяБУ 			= ПараметрыБухгалтерскогоУчета.БухгалтерскийУчет;
	УчетныйДоговор 					= ПараметрыБухгалтерскогоУчета.УчетныйДоговор;

КонецПроцедуры

&НаСервере
Процедура УстаноитьЗаголовкиЭлементов()
	
	Элементы.ДеревоОплатЗадолженность.Заголовок = "Задолженность, "+Строка(Валюта);
	Элементы.ДеревоОплатОплата_Валюта.Заголовок = "Оплата, "+Строка(Валюта);
	Элементы.ДеревоОплатСуммаНДС.Заголовок = "НДС, "+?(Договор.ВзаиморасчетыВУЕ,"Руб.", Строка(Валюта));
	
	Элементы.ДеревоОплатСтавкаНДС.Видимость = ПоДоговоруВедетсяБУ и НЕ РежимДДС;
	Элементы.ДеревоОплатСуммаНДС.Видимость 	= ПоДоговоруВедетсяБУ и НЕ РежимДДС;
	
	УстановитьПараметрыВыбораСтавкиНДС();

КонецПроцедуры  

&НаСервере
Процедура УстановитьПараметрыВыбораСтавкиНДС() Экспорт
	
	ПараметрНДСПриУСН = Новый ПараметрВыбора("СтавкаНДСПриУСН",
		РегистрыСведений.НастройкиУчетаНДС.СтавкаНалогообложенияПриУСН(Организация, Дата));
	МассивПараметровВыбора = Новый Массив;
	МассивПараметровВыбора.Добавить(ПараметрНДСПриУСН);
	
	Если ПолучитьФункциональнуюОпцию("ОсуществляетсяРеализацияТоваровУслугКомитентов")
		И УчетНДСКлиентСервер.Применяется176ФЗ(Дата) Тогда
		ОсуществляетсяРеализацияТоваровУслугКомитентов = Новый ПараметрВыбора("ОсуществляетсяРеализацияТоваровУслугКомитентов", Истина);
		МассивПараметровВыбора.Добавить(ОсуществляетсяРеализацияТоваровУслугКомитентов);
	КонецЕсли;
	
	Элементы["ДеревоОплатСтавкаНДС"].ПараметрыВыбора = Новый ФиксированныйМассив(МассивПараметровВыбора);

КонецПроцедуры


&НаКлиенте
Процедура ПередЗакрытием(Отказ, СтандартнаяОбработка)
	
	_СохранитьНастройки();
	
КонецПроцедуры

&НаСервере
Функция _ВосстановитьНастройки()
	// --- 
	
	Попытка
		
		ИмяНастройки="ПоследняяНастройка";
		ПоследняяНастройка = ХранилищеСистемныхНастроек.Загрузить("ОбщаяФорма.ПодборСчетовДляОплаты", ИмяНастройки);
		ПоследняяНастройка.Свойство("СтрокиСвернуты",СтрокиСвернуты);
		
	Исключение
		//ОписаниеОшибки()
	КонецПопытки; 
	
	// --- 
КонецФункции

&НаСервере
Функция _СохранитьНастройки()
	// --- 
	
	ИмяНастройки="ПоследняяНастройка";
	Настройка = Новый Структура("СтрокиСвернуты",СтрокиСвернуты);
	ХранилищеСистемныхНастроек.Сохранить("ОбщаяФорма.ПодборСчетовДляОплаты", ИмяНастройки, Настройка);
	
	// --- 
КонецФункции
 

&НаСервере
Процедура _УправлениеЭлементамиФормы()
	
	// колонка "Сумма по документу"
	Элементы.ДеревоОплатСуммаДокумента.Видимость 	= Элементы.ДеревоОплатКомандаСуммыДокументов.Пометка;
	//Элементы.ДеревоОплатСуммаНДС.Видимость 			= Элементы.ДеревоОплатКомандаСуммыДокументов.Пометка;
	Элементы.ДеревоОплатКомандаСуммыДокументов.Заголовок = ?(Элементы.ДеревоОплатКомандаСуммыДокументов.Пометка, " Скрыть", " Показать");
	// --- 
	Элементы.АвтоматическийПодборСчетов.Доступность = (СуммаОплаты <> 0);
	Элементы.ДеревоОплатОплата_Валюта.ТолькоПросмотр = АвтоматическийПодборСчетов;
	Элементы.ДеревоОплатОплата_БВ.ТолькоПросмотр = АвтоматическийПодборСчетов;
	
	Элементы.Валюта.Видимость 				= (Валюта <> БазоваяВалюта И УЕ);
	Элементы.ДеревоОплатКурс.Видимость 		= УЕ;
	Элементы.ДеревоОплатОплата_БВ.Видимость = УЕ;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСписок(Команда)
	
	_ОбновитьДерево();
	
КонецПроцедуры

&НаСервере
Процедура _ОбновитьДерево()
	Если Не ЗначениеЗаполнено(Договор) Тогда
		Возврат;
	КонецЕсли;
	
	СК = CW_Финансы.ПолучитьКурсВалюты(Валюта,Дата);
	
	ЕстьВедомый = (ЗначениеЗаполнено(ВедомыйДокумент));
	ТаблицаВедомого = ВедомыйДокумент.Оплата.Выгрузить();
	
	// определение статьи ДДС
	Если (ЗначениеЗаполнено(ВедомыйДокумент.Основание)) Тогда
		ТаблицаСтатейДДС = ВедомыйДокумент.Основание.РасшифровкаПлатежа.Выгрузить(,"СтатьяДвиженияДенежныхСредств");
		ТаблицаСтатейДДС.Свернуть("СтатьяДвиженияДенежныхСредств");
		Если (ТаблицаСтатейДДС.Количество() <> 0) Тогда
			СтатьяДДС = _сф.к_ПервыйЭлемент(ТаблицаСтатейДДС).СтатьяДвиженияДенежныхСредств;	
		КонецЕсли; 
	КонецЕсли; 
	
	// определение порядка отражения аванса
	Если (Договор.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПокупателем И ЗначениеЗаполнено(ВедомыйДокумент.Основание) И УСН) Тогда
		ТаблицаПОА = ВедомыйДокумент.Основание.РасшифровкаПлатежа.Выгрузить(,"ПорядокОтраженияАванса");
		ТаблицаПОА.Свернуть("ПорядокОтраженияАванса");
		Если (ТаблицаПОА.Количество() <> 0) Тогда
			ПорядокОтраженияАванса = _сф.к_ПервыйЭлемент(ТаблицаПОА).ПорядокОтраженияАванса;	
		КонецЕсли; 
	КонецЕсли; 
	
	// если не удалось определить порядок отражения аванса (такая ситуация возможна для нового документа), 
	// то устанавливаем порядок, указанный в учетной политике организации
	Если Не ЗначениеЗаполнено(ПорядокОтраженияАванса) И 
		(Договор.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПокупателем) И УСН
	Тогда
		ДанныеУчетнойполитики = CW_Настройки.ПараметрыУчетнойПолитики(?(Дата='00010101000000', ТекущаяДата(), Дата),Организация);
		ПорядокОтраженияАванса = ДанныеУчетнойполитики["ПорядокОтраженияАванса"];
	КонецЕсли;
	         
	ТаблицаОЗ = ПолучитьИзВременногоХранилища(АдресТаблицыОЗ);
	Если ТаблицаОЗ <> Неопределено Тогда
		ТаблицаВедомого = ТаблицаОЗ;
	КонецЕсли; 
	
	ПараметрыТОЗ = Новый Структура;
	_сф.ст_ДобавитьСвойства(ПараметрыТОЗ,"Организация,Контрагент,Договор,Валюта",ЭтаФорма);
	
	//Подсистема.УчетПриложенийДоговоров
	ПараметрыТОЗ.Вставить("ПриложениеКДоговору", ПриложениеКДоговору);
	//Подсистема.УчетПриложенийДоговоров

	
	Если (ЗначениеЗаполнено(ПлатежноеПоручение) И ЕстьВедомый) Тогда
		ПараметрыТОЗ.Вставить("Дата",ВедомыйДокумент.МоментВремени());
	Иначе
		ПараметрыТОЗ.Вставить("Дата",Дата);
	КонецЕсли; 
	
	//Для версии КОРП
	Если ВестиУчетПоПодразделениям Тогда
		ПараметрыТОЗ.Вставить("ВестиУчетПоПодразделениям"	, ВестиУчетПоПодразделениям);
		ПараметрыТОЗ.Вставить("ПодразделениеОрганизации"	, ПодразделениеОрганизации);
	КонецЕсли;
	//Для версии КОРП

	ПараметрыТОЗ.Вставить("ВидОперации",ВидОперации);
	
	ТОЗ = CW_Финансы.ТаблицаОперативнойЗадолженностиПоСчетам(ПараметрыТОЗ);
	
	// теперь получим акты, соответствующие счетам
	Если (НЕ РежимДДС) Тогда
		
		ПараметрыТЗА = Новый Структура;
		_сф.ст_ДобавитьСвойства(ПараметрыТЗА,"Организация,Контрагент,Договор,ПриложениеКДоговору,Валюта",ЭтаФорма);
		ПараметрыТЗА.Вставить("Дата", ПлатежноеПоручение.МоментВремени());
		ПараметрыТЗА.Вставить("ТОЗ",ТОЗ);

		СтруктураБЗ = CW_Финансы.СтруктураБухгалтерскойЗадолженностиПоАктам(ПараметрыТЗА);
		ТА = СтруктураБЗ.ТА;
		ТЗА = СтруктураБЗ.ТЗА;
		
	КонецЕсли; 
	
	СтавкаНДС = CW_БухгалтерияЭкспедитораДляРоссииСервер.СтавкаНДСПоВидуСтавки(Перечисления.ВидыСтавокНДС.Общая, Дата);
	
	ПараметрыДО = Новый Структура;
	ПараметрыДО.Вставить("РежимДДС",РежимДДС);
	ПараметрыДО.Вставить("Курс",СК.Курс);
	ПараметрыДО.Вставить("Кратность",СК.Кратность);
	ПараметрыДО.Вставить("ЕстьВедомый",ЕстьВедомый);
	ПараметрыДО.Вставить("ТаблицаВедомого",ТаблицаВедомого);
	ПараметрыДО.Вставить("ПустойАкт",ПустойАкт);
	ПараметрыДО.Вставить("УЕ",УЕ);
	ПараметрыДО.Вставить("ТОЗ",ТОЗ);
	ПараметрыДО.Вставить("ТА",ТА);
	ПараметрыДО.Вставить("ТЗА",ТЗА);
	ПараметрыДО.Вставить("Организация",Организация);
	ПараметрыДО.Вставить("Договор",Договор);
	ПараметрыДО.Вставить("Валюта",Валюта);
	ПараметрыДО.Вставить("БазоваяВалюта",БазоваяВалюта);
	ПараметрыДО.Вставить("Дата",Дата);
	ПараметрыДО.Вставить("СтавкаНДС",СтавкаНДС);
	
	CW_Финансы.СформироватьДеревоОплат(ДеревоОплат,ПараметрыДО);
	
	ОбновитьИтоги();

КонецПроцедуры


&НаКлиенте
