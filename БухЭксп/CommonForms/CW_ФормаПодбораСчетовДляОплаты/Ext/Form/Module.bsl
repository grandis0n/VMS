&НаКлиенте
Процедура ОчиститьОплаты(Команда)
	
	АвтоматическийПодборСчетов = Ложь;
	Для каждого СтрокаСчета Из ДеревоОплат.ПолучитьЭлементы() Цикл
		
		СтрокаСчета.Оплата_Валюта = 0;
		
		Если УЕ Тогда
			СтрокаСчета.Оплата_БВ = 0;
		КонецЕсли; 
		
		СтрокаСчета.СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.ПустаяСсылка");  
		СтрокаСчета.СуммаНДС  = 0;

		Для каждого СтрокаАкта Из СтрокаСчета.ПолучитьЭлементы() Цикл
			
			СтрокаАкта.Оплата_Валюта = 0;
			
			Если УЕ Тогда
				СтрокаАкта.Оплата_БВ = 0;
			КонецЕсли; 
			
			СтрокаАкта.СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.ПустаяСсылка");  
			СтрокаАкта.СуммаНДС  = 0;
			
		КонецЦикла; 
		
	КонецЦикла; 
	
	ОбновитьИтоги();
	
КонецПроцедуры

