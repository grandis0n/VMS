КонецПроцедуры

Процедура ОбновитьИтоги()
	// --- 
	
	Оплачено_Валюта = 0;
	Оплачено_БВ 	= 0;
	ИтогоСумма		= 0;
	// --- 
	
	Для каждого Стр Из ДеревоОплат.ПолучитьЭлементы() Цикл
		
		Оплачено_Валюта = Оплачено_Валюта+Стр.Оплата_Валюта;
		Если УЕ ИЛИ РежимДДС Тогда
			
			Оплачено_БВ = Оплачено_БВ + Стр.Оплата_БВ;
			
		КонецЕсли; 
		
	КонецЦикла;
	
	Если УЕ ИЛИ РежимДДС Тогда
		ИтогоСумма = Оплачено_БВ;
	Иначе
		ИтогоСумма = Оплачено_Валюта;
	КонецЕсли; 
	
	Если (РежимДДС) Тогда
		
		Итого = "Оплачено, "+Строка(Валюта)+": "+Формат(Оплачено_Валюта,"ЧЦ=15; ЧДЦ=2; ЧН=");
		Если (Валюта <> ВалютаКассы) Тогда
			
			Итого = Итого+", "+Строка(ВалютаКассы)+": "+Формат(Оплачено_БВ,"ЧЦ=15; ЧДЦ=2; ЧН=");
			
		КонецЕсли; 
		
	Иначе
		
		Итого = "Оплачено, "+Строка(Валюта)+": "+Формат(Оплачено_Валюта,"ЧЦ=15; ЧДЦ=2; ЧН=");
		Если УЕ Тогда
			
			Итого = Итого+", "+Строка(БазоваяВалюта)+": "+Формат(Оплачено_БВ,"ЧЦ=15; ЧДЦ=2; ЧН=");
			
		КонецЕсли; 
		
	КонецЕсли; 
	
	// --- 
КонецПроцедуры

// ---------------------------------------------------------------------------- 

&НаКлиенте
Процедура КомандаОК(Команда)
	
	Если (СуммаОплаты <> 0) и (СуммаОплаты <> ИтогоСумма) тогда
		
		Если УЕ ИЛИ РежимДДС Тогда
			тВалюта = БазоваяВалюта;
		Иначе
			тВалюта = Валюта;
		КонецЕсли;	
		
		Режим = РежимДиалогаВопрос.ДаНет;
		Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаПодтвержденияОплаты", ЭтаФорма, Параметры);
		ПоказатьВопрос(Оповещение, "Итоговая сумма оплаты "+Формат(ИтогоСумма, "ЧДЦ=2; ЧРД=,; ЧРГ=' '; ЧН=0,00")+ " " + тВалюта + 
		" отличается от суммы в документе "+Формат(СуммаОплаты, "ЧДЦ=2; ЧРД=,; ЧРГ=' '; ЧН=0,00")+" " + тВалюта + ".
		|Продолжить?", Режим, 0); 
		
	Иначе
		Ответ = _ПодтвердитьОплату();
		Если _УФКС.ВыполненоУспешно(Ответ) Тогда
			
			ЭтаФорма.Закрыть(Ответ);
			
		КонецЕсли; 
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияВопросаПодтвержденияОплаты(Результат, Параметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Нет Тогда
        Возврат;
	КонецЕсли;
	
	Ответ = _ПодтвердитьОплату();
	Если _УФКС.ВыполненоУспешно(Ответ) Тогда
		
		ЭтаФорма.Закрыть(Ответ);
		
	КонецЕсли; 
	
КонецПроцедуры

&НаСервере
Функция _ПодтвердитьОплату()
	// --- 
	
	Если (НЕ РежимДДС) Тогда
		
		СК = CW_Финансы.ПолучитьКурсВалюты(Валюта,Дата);
		
		// формируем таблицу оплат по оперативной задолженности
		ТаблицаОЗ = Документы.CW_Оплата.ПустаяСсылка().Оплата.Выгрузить();
		
		// подготовим табличную часть в зависимости от ведущего документа
		Если ТипЗнч(ПлатежноеПоручение) = Тип("ДокументСсылка.ПоступлениеНаРасчетныйСчет") Тогда
			ТабличнаяЧасть = Документы.ПоступлениеНаРасчетныйСчет.ПустаяСсылка().РасшифровкаПлатежа.Выгрузить();
		Иначе
			ТабличнаяЧасть = Документы.СписаниеСРасчетногоСчета.ПустаяСсылка().РасшифровкаПлатежа.Выгрузить();
		КонецЕсли; 
		
		ПараметрыЗаполнения = Новый Структура;
		ПараметрыЗаполнения.Вставить("Договор"					, Договор);
		//Подсистема.УчетПриложенийДоговоров
		ПараметрыЗаполнения.Вставить("ПриложениеКДоговору"		, ПриложениеКДоговору);
		//Подсистема.УчетПриложенийДоговоров
		ПараметрыЗаполнения.Вставить("СтатьяДДС"				, СтатьяДДС);
		ПараметрыЗаполнения.Вставить("ПорядокОтраженияАванса"	, ПорядокОтраженияАванса);
		ПараметрыЗаполнения.Вставить("УЕ"						, УЕ);
		ПараметрыЗаполнения.Вставить("ПустойАкт"				, ПустойАкт);
		ПараметрыЗаполнения.Вставить("Курс"						, СК.Курс);
		ПараметрыЗаполнения.Вставить("Кратность"				, СК.Кратность);
		ПараметрыЗаполнения.Вставить("ТипДокумента"				, ТипЗнч(ПлатежноеПоручение));
		
		CW_Финансы.ЗаполнитьТаблицыПлатежныхДокументов(ДеревоОплат,ТаблицаОЗ,ТабличнаяЧасть, ПараметрыЗаполнения);
		
		СтруктураПараметров = Новый Структура("ВедомыйДокумент,Реквизиты,ТаблицаДокумента,ТаблицаПоОперативнойЗадолженности");
		
		Реквизиты = _сф.ст_Создать("Организация,Контрагент,Договор,Валюта,АвтоматическийПодборСчетов,АвтоматическийПодборАктов,ПорядокОтраженияАванса",ЭтаФорма);
		
		//Подсистема.УчетПриложенийДоговоров
		Реквизиты.Вставить("ПриложениеКДоговору", ПриложениеКДоговору);
		//Подсистема.УчетПриложенийДоговоров

		
		//Для версии КОРП
		Если ВестиУчетПоПодразделениям Тогда
			Реквизиты.Вставить("ПодразделениеОрганизации", ПодразделениеОрганизации);
		КонецЕсли;
		//Для версии КОРП
		
		СтруктураПараметров.ВедомыйДокумент 					= ВедомыйДокумент;
		СтруктураПараметров.Реквизиты 							= Реквизиты;
		СтруктураПараметров.ТаблицаПоОперативнойЗадолженности 	= ТаблицаОЗ;
		СтруктураПараметров.ТаблицаДокумента 					= ТабличнаяЧасть;
		
		// --- 
		Ответ = _УФКС.Ответ();
		Ответ.Вставить("АдресПараметровОплаты",ПоместитьВоВременноеХранилище(СтруктураПараметров,ЭтаФорма.УникальныйИдентификатор));
		
		Возврат(Ответ);
		
	КонецЕсли; 
	
	Если (РежимДДС) Тогда
		
		ТаблицаДокумента = Документы.CW_ДвижениеДенежныхСредств.ПустаяСсылка().Расшифровка.Выгрузить();
		Для каждого СтрокаСчета Из ДеревоОплат.ПолучитьЭлементы() Цикл
			
			СуммаОплатыПоСчету = СтрокаСчета.Оплата_Валюта;
			СуммаОплатыПоСчету_БВ = СтрокаСчета.Оплата_БВ;
			// --- 
			ОстатокОплаты = СуммаОплатыПоСчету;
			ОстатокОплаты_БВ = СуммаОплатыПоСчету_БВ;
			Если (ОстатокОплаты > 0) Тогда
				
				Нстр = ТаблицаДокумента.Добавить();
				// --- 
				Нстр.Документ = СтрокаСчета.Документ;
				Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(СтрокаСчета.Документ,"ПредставлениеДокумента") Тогда
					Нстр.Представление = СтрокаСчета.Документ.ПредставлениеДокумента;
				Иначе
					Нстр.Представление = Строка(СтрокаСчета.Документ);
				КонецЕсли;
				Если (НЕ ЗначениеЗаполнено(СтрокаСчета.Документ)) Тогда
					Нстр.Представление = СтрокаСчета.Представление;
				КонецЕсли; 
				Нстр.Счет = СтрокаСчета.СчетЗадолженности;
				Если (ВалютаКассы = Валюта) Тогда
					Нстр.СуммаВД = ОстатокОплаты;
					Нстр.СуммаВК = ОстатокОплаты;
				Иначе
					Нстр.СуммаВД = ОстатокОплаты;
					Нстр.СуммаВК = ОстатокОплаты_БВ;
				КонецЕсли; 
				// --- 
				
			КонецЕсли; 
			
		КонецЦикла; 
		Ответ = _УФКС.Ответ();
		Ответ.Вставить("АдресТаблицыДокумента",ПоместитьВоВременноеХранилище(ТаблицаДокумента,ЭтаФорма.УникальныйИдентификатор));
		Возврат(Ответ);
		
	КонецЕсли; 
	
	// --- 

КонецФункции


