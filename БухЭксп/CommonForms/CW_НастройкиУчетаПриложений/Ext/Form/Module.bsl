	ИзмененныеКонстанты = Новый Массив;
	
	КонстантаИмя = СохранитьЗначениеРеквизита("НаборКонстант.CW_АвтоматическаяНумерацияПриложенийКДоговорамСПокупателями");
	ИзмененныеКонстанты.Добавить(КонстантаИмя);
	
	НаборКонстант.CW_НумераторДоговоров = Неопределено;
	КонстантаИмя = СохранитьЗначениеРеквизита("НаборКонстант.CW_НумераторПриложений");
	ИзмененныеКонстанты.Добавить(КонстантаИмя);
	
	НаборКонстант.CW_ШаблонНомераДоговораСПокупателем = "";
	КонстантаИмя = СохранитьЗначениеРеквизита("НаборКонстант.CW_ШаблонНомераПриложенияКДоговоруСПокупателем");
	ИзмененныеКонстанты.Добавить(КонстантаИмя);
	
	НаборКонстант.CW_ДлинаЧисловойЧастиНомераДоговора = 0;
	КонстантаИмя = СохранитьЗначениеРеквизита("НаборКонстант.CW_ДлинаЧисловойЧастиНомераПриложения");
	ИзмененныеКонстанты.Добавить(КонстантаИмя);
	
	НаборКонстант.CW_ИспользуетсяВнешнийНумераторПриложений = Ложь;
	КонстантаИмя = СохранитьЗначениеРеквизита("НаборКонстант.CW_ИспользуетсяВнешнийНумераторПриложений");
	ИзмененныеКонстанты.Добавить(КонстантаИмя);

