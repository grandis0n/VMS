#Область СлужебныеПроцедурыИФункции

&НаСервереБезКонтекста
Процедура УстановитьЗначенияРеквизитовФормы(Форма)

	Форма.CW_АвтоматическаяНумерацияДоговоровСПокупателями 	= Константы.CW_АвтоматическаяНумерацияДоговоровСПокупателями.Получить();
	
	Форма.CW_АвтоматическаяНумерацияПриложенийКДоговорамСПокупателями 	= Константы.CW_АвтоматическаяНумерацияПриложенийКДоговорамСПокупателями.Получить();
	Форма.CW_ИспользуетсяВнешнийНумераторПриложений	 					= Константы.CW_ИспользуетсяВнешнийНумераторПриложений.Получить();
	
КонецПроцедуры


&НаКлиентеНаСервереБезКонтекста
Процедура УправлениеФормой(Форма)
	
	Элементы = Форма.Элементы;
	
	Элементы.CW_ИспользуетсяВнешнийНумераторДоговоров.Видимость = Форма.CW_АвтоматическаяНумерацияДоговоровСПокупателями = 1;	
	
	Элементы.ГруппаВстроенныйНумераторДоговоров.Видимость 	= Форма.CW_ИспользуетсяВнешнийНумераторДоговоров = 0
															И Форма.CW_АвтоматическаяНумерацияДоговоровСПокупателями = 1;
	Элементы.ГруппаВнешнийНумераторДоговоров.Видимость		= Форма.CW_ИспользуетсяВнешнийНумераторДоговоров = 1
															И Форма.CW_АвтоматическаяНумерацияДоговоровСПокупателями = 1;
	
	Элементы.CW_ИспользуетсяВнешнийНумераторПриложений.Видимость 	= Форма.CW_АвтоматическаяНумерацияПриложенийКДоговорамСПокупателями = 1;		
	Элементы.ГруппаПредупреждениеНумерацииприложений.Видимость   	= Форма.CW_АвтоматическаяНумерацияПриложенийКДоговорамСПокупателями = 1 
																	И Форма.CW_АвтоматическаяНумерацияПриложенийКДоговорамСПокупателями = 1;
	Элементы.ГруппаВстроенныйНумераторПриложений.Видимость 			= Форма.CW_ИспользуетсяВнешнийНумераторПриложений = 0 
																	И Форма.CW_АвтоматическаяНумерацияПриложенийКДоговорамСПокупателями = 1;
	Элементы.ГруппаВнешнийНумераторПриложений.Видимость				= Форма.CW_ИспользуетсяВнешнийНумераторПриложений = 1 
																	И Форма.CW_АвтоматическаяНумерацияПриложенийКДоговорамСПокупателями = 1;
																	
	Элементы.УстановитьНачальныйНомер.Видимость 					= Форма.CW_АвтоматическаяНумерацияДоговоровСПокупателями = 1;		
																	
КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииРеквизитаНаКлиенте(Элемент, ОбновлятьИнтерфейс = Истина)
	
	КонстантаИмя = ПриИзмененииРеквизитаСервер(Элемент.Имя);
	
	Если ОбновлятьИнтерфейс Тогда
		ОбновитьИнтерфейс = Истина;
		ПодключитьОбработчикОжидания("ОбновитьИнтерфейсПрограммы", 0.1, Истина);
	КонецЕсли;
	
	Если КонстантаИмя <> "" Тогда
		Оповестить("Запись_НаборКонстант", Новый Структура, КонстантаИмя);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПриИзмененииРеквизитаСервер(ИмяЭлемента)
	
	РеквизитПутьКДанным = Элементы[ИмяЭлемента].ПутьКДанным;
	
	КонстантаИмя = СохранитьЗначениеРеквизита(РеквизитПутьКДанным);
	
	ОбновитьПовторноИспользуемыеЗначения();
	
	Возврат КонстантаИмя;
	
КонецФункции

&НаСервере
Функция СохранитьЗначениеРеквизита(РеквизитПутьКДанным)
	
	// Сохранение значений реквизитов, не связанных с константами напрямую (в отношении один-к-одному).
	Если РеквизитПутьКДанным = "" Тогда
		Возврат "";
	КонецЕсли;
	
	// Определение имени константы.
	КонстантаИмя = "";
	Если НРег(Лев(РеквизитПутьКДанным, 14)) = НРег("НаборКонстант.") Тогда
		// Если путь к данным реквизита указан через "НаборКонстант".
		КонстантаИмя = Сред(РеквизитПутьКДанным, 15);
	КонецЕсли;
	
	// Сохранения значения константы.
	Если КонстантаИмя <> "" Тогда
		КонстантаМенеджер = Константы[КонстантаИмя];
		КонстантаЗначение = НаборКонстант[КонстантаИмя];
		
		Если КонстантаМенеджер.Получить() <> КонстантаЗначение Тогда
			КонстантаМенеджер.Установить(КонстантаЗначение);
		КонецЕсли;
	КонецЕсли;
	
	Возврат КонстантаИмя;
	
КонецФункции

&НаКлиенте
Процедура ОбновитьИнтерфейсПрограммы()
	
	Если ОбновитьИнтерфейс = Истина Тогда
		ОбновитьИнтерфейс = Ложь;
		ОбщегоНазначенияКлиент.ОбновитьИнтерфейсПрограммы();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьИзменениеРеквизитаНаФорме(ИзмененныеКонстанты)
	
	УправлениеФормой(ЭтаФорма);
	
	ПодключитьОбработчикОжидания("ОбновитьИнтерфейсПрограммы", 0.1, Истина);
	ОбновитьИнтерфейс = Истина;
	
	Для Каждого КонстантаИмя ИЗ ИзмененныеКонстанты Цикл
		Если КонстантаИмя <> "" Тогда
			Оповестить("Запись_НаборКонстант", Новый Структура, КонстантаИмя);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
