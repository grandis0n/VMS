&НаСервере
Процедура МенедджерПродажПриИзмененииНаСервере()
	
	СписокКонтрагентов.Отбор.Элементы.Очистить();
	
	Если Не ЗначениеЗаполнено(МенеджерПродаж) Тогда
		Возврат;
	Конецесли;

	Запрос = новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	CW_МенеджерыПродажКлиентовСрезПоследних.Контрагент КАК Контрагент
	               |ИЗ
	               |	РегистрСведений.CW_МенеджерыПродажКлиентов.СрезПоследних(&ДатаСреза, МенеджерПродаж = &МенеджерПродаж) КАК CW_МенеджерыПродажКлиентовСрезПоследних
	               |ГДЕ
	               |	CW_МенеджерыПродажКлиентовСрезПоследних.МенеджерПродаж В(&МенеджерПродаж)";
	
	Запрос.УстановитьПараметр("ДатаСреза", ТекущаяДата());
	Запрос.УстановитьПараметр("МенеджерПродаж", МенеджерПродаж);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	ПравоеЗначение = Новый СписокЗначений;
	Пока Выборка.Следующий() Цикл
		ПравоеЗначение.Добавить(Выборка.Контрагент);
	КонецЦикла;
	
	ЭлементОтбора = СписокКонтрагентов.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение 	= Новый ПолеКомпоновкиДанных("Ссылка");
	ЭлементОтбора.Использование 	= Истина;
	ЭлементОтбора.ВидСравнения 		= ВидСравненияКомпоновкиДанных.ВСписке;
	ЭлементОтбора.ПравоеЗначение 	= ПравоеЗначение
	
КонецПроцедуры

