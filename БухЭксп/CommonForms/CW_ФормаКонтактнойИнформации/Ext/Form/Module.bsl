&НаКлиенте
Процедура ЗагрузитьЛоготип(Команда)
	
	// показываем диалог выбора файла
	Режим = РежимДиалогаВыбораФайла.Открытие;
	ДиалогОткрытияФайла = Новый ДиалогВыбораФайла(Режим);
	ДиалогОткрытияФайла.ПолноеИмяФайла = "";
	//Текст = "ru = ""Текст""; en = ""Text""";
	Фильтр = "PNG|*.png|GIF|*.gif|BMP|*.bmp";
	ДиалогОткрытияФайла.Фильтр = Фильтр;
	ДиалогОткрытияФайла.МножественныйВыбор = Ложь;
	ДиалогОткрытияФайла.Заголовок = "Выберите файл";
	Если ДиалогОткрытияФайла.Выбрать() Тогда
		
		МассивФайлов = ДиалогОткрытияФайла.ВыбранныеФайлы;
		Файл = МассивФайлов[0];
		
		АдресФайла = "";
		ПОВ = Новый ОписаниеОповещения("ОбработкаЗагрузкиФайла",ЭтотОбъект, Новый Структура()); 
		НачатьПомещениеФайла(ПОВ,АдресФайла,Файл,Ложь,УникальныйИдентификатор);
		
	Иначе
		Текст = "ru = ""Файл(ы) не выбран!""; en = ""File(s) not selected!""";
		_УФК.ВывестиПредупреждение(НСтр(Текст));
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаЗагрузкиФайла(Результат, АдресВременногоХранилищаФайла, ВыбранноеИмя, ДополнительныеПараметры) Экспорт 
	
	Если Результат Тогда
		
		ПараметрыВыбора = новый Структура;
		ПараметрыВыбора.Вставить("МножественныйВыбор", Ложь);
		
		ДополнительныеПараметры.Вставить("АдресВременногоХранилищаФайла", АдресВременногоХранилищаФайла);
		ДополнительныеПараметры.Вставить("ВыбранноеИмя", ВыбранноеИмя);
		
		ОписаниеОповещения = Новый ОписаниеОповещения("ПродолжитьПомещениеФалов", ЭтотОбъект, ДополнительныеПараметры);
		Если ЗапрашиватьТипФайлаПриДобавленииВАрхив Тогда
			ОткрытьФорму("Справочник.CW_ТипыДокументовФайловогоАрхива.ФормаВыбора",ПараметрыВыбора,ЭтаФорма,,,,ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		Иначе
			ВыполнитьОбработкуОповещения(ОписаниеОповещения,Неопределено);
		КонецЕсли;
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ПродолжитьПомещениеФалов(РезультатВыбора, ДополнительныеПараметры)Экспорт
	
	Если РезультатВыбора = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если РезультатВыбора = Неопределено И ЗапрашиватьТипФайлаПриДобавленииВАрхив Тогда
		ПоказатьПредупреждение(,"Не выбран тип документа. Добавление файла отменено!");
		Возврат;
	КонецЕсли;	
	
	ОбработатьЗагрузкуФайлаНаСервере(ДополнительныеПараметры.АдресВременногоХранилищаФайла, 
					ДополнительныеПараметры.ВыбранноеИмя, 
					РезультатВыбора);
			
	ОбновитьЛоготип();   
	
КонецПроцедуры

&НаСервере
Процедура ОбработатьЗагрузкуФайлаНаСервере(АдресФайла, ВыбранноеИмя, ТипДокумента)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	|	CW_ЛоготипыКонтрагентов.ОбъектАрхива
	|ИЗ
	|	РегистрСведений.CW_ЛоготипыКонтрагентов КАК CW_ЛоготипыКонтрагентов
	|ГДЕ
	|	CW_ЛоготипыКонтрагентов.Контрагент = &Контрагент";

	Запрос.УстановитьПараметр("Контрагент", ТекущийОбъект);  
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Если Выборка.Следующий() Тогда    
		ОбъектАрхива = Выборка.ОбъектАрхива;
		CW_РаботаСФайламиСервер.ЗаписатьФайлВТомХранения(ОбъектАрхива, АдресФайла, ОбъектАрхива.Том);
	Иначе  
		
		ПозТочки 	= СтрНайти(ВыбранноеИмя,".", НаправлениеПоиска.СКонца);
		Расширение 	= Сред(ВыбранноеИмя, ПозТочки);  

		ДанныеФайла = Новый Структура;
		ДанныеФайла.Вставить("Имя",			ВыбранноеИмя);
		ДанныеФайла.Вставить("Расширение",	Расширение);
		ДанныеФайла.Вставить("Хранение",	АдресФайла);
		
		ПомещенныйФайл = CW_РаботаСФайламиСервер.ПрикрепитьФайл(ДанныеФайла, ТекущийОбъект, ТипДокумента);
		
		Если ПомещенныйФайл <> Неопределено Тогда
			Запись = РегистрыСведений.CW_ЛоготипыКонтрагентов.СоздатьМенеджерЗаписи();
			Запись.Контрагент = ТекущийОбъект;
			Запись.ОбъектАрхива = ПомещенныйФайл;
			Запись.Записать();
		КонецЕсли;
		
	КонецЕсли;
	
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьЛоготип(Команда)
	
	_УдалитьЛоготип();
