	Возврат(_НайтиСтрокуДерева(КЛ,КонтактныеЛица));
	
	// --- 
КонецФункции

&НаСервере
Функция _НайтиСтрокуДерева(СсылкаКЛ,ЭлементДерева)
	// --- 
	
	СтрокаКЛ = Неопределено;
	
	Для каждого СтрокаДерева Из ЭлементДерева.ПолучитьЭлементы() Цикл
		
		Если (СтрокаДерева.Ссылка = СсылкаКЛ) Тогда
			
			Возврат(СтрокаДерева.ПолучитьИдентификатор());
			
		Иначе
			
			СтрокаКЛ = _НайтиСтрокуДерева(СсылкаКЛ, СтрокаДерева);
			Если (СтрокаКЛ <> Неопределено) Тогда
				
				Возврат(СтрокаКЛ);
				
			КонецЕсли; 
			
		КонецЕсли; 
		
	КонецЦикла; 
	
	Возврат(СтрокаКЛ);
	
	// --- 
КонецФункции
 

&НаСервере
Функция _ВладелецКИ(КИ)
	// --- 
	
	Если (ТипЗнч(КИ.Владелец)=Тип("СправочникСсылка.ФизическиеЛица")) Тогда
		
		Возврат(КИ.Владелец);
		
	Иначе
		
		Если (ТипЗнч(КИ.Владелец)=Тип("СправочникСсылка.Контрагенты")) Тогда
			Возврат(Новый Структура("Контрагент,КонтактноеЛицо",КИ.Владелец,Неопределено));
		Иначе
			Возврат(Новый Структура("Контрагент,КонтактноеЛицо",КИ.Владелец.Владелец,КИ.Владелец));
		КонецЕсли; 
		
	КонецЕсли; 
	
	// --- 
КонецФункции

