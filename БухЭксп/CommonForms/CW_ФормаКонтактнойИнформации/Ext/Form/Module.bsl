&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	Если (ВыбранноеЗначение <> Неопределено) Тогда
		
		ВладелецКИ = _ВладелецКИ(ВыбранноеЗначение);
		Если (ТипЗнч(ВладелецКИ)=Тип("СправочникСсылка.ФизическиеЛица")) Тогда
			
			Если (Элементы.СтраницыКонтрагентов.ТекущаяСтраница <> Элементы.СтраницаФизическиеЛица) Тогда
				Элементы.СтраницыКонтрагентов.ТекущаяСтраница = Элементы.СтраницаФизическиеЛица;
				ФормироватьДеревоКонтактныхЛиц = Ложь;
				ВидимостьРазделовФормы();	
			КонецЕсли; 
			// --- 
			Элементы.ФизическиеЛица.ТекущаяСтрока = ВладелецКИ;
			// --- 
			СтрокиКИ = КонтактнаяИнформация.НайтиСтроки(Новый Структура("Ссылка",ВыбранноеЗначение));
			Если (СтрокиКИ.Количество() <> 0) Тогда
				СтрокаКИ = СтрокиКИ[0];
				Элементы.КонтактнаяИнформация.ТекущаяСтрока = СтрокаКИ.ПолучитьИдентификатор();
			КонецЕсли; 
			
		Иначе
			
			Если (Элементы.СтраницыКонтрагентов.ТекущаяСтраница <> Элементы.СтраницаКонтрагенты) Тогда
				Элементы.СтраницыКонтрагентов.ТекущаяСтраница = Элементы.СтраницаКонтрагенты;	
				ФормироватьДеревоКонтактныхЛиц = Истина;
				ВидимостьРазделовФормы();
			КонецЕсли; 
			// --- 
			ТекущийОбъект = ВладелецКИ.Контрагент;
			Элементы.Контрагенты.ТекущаяСтрока = ТекущийОбъект;
			_СформироватьДерево();
			ОбновитьЛоготип();
			// --- 
			Если (ВладелецКИ.КонтактноеЛицо <> Неопределено) Тогда
				ТекущийОбъектОтбора = ВладелецКИ.КонтактноеЛицо;
			Иначе
				ТекущийОбъектОтбора = ТекущийОбъект;
			КонецЕсли; 
			_ОбновитьКонтактнуюИнформацию();
			// --- 
			// ищем строку контактного лица в дереве
			Если (ВладелецКИ.КонтактноеЛицо <> Неопределено) Тогда
				
				ИдентификаторСтрокиКЛ = _ИдентификаторСтрокиКЛ(ВладелецКИ.КонтактноеЛицо);
				Если (ИдентификаторСтрокиКЛ <> Неопределено ) Тогда
					Элементы.КонтактныеЛица.ТекущаяСтрока = ИдентификаторСтрокиКЛ;
					// --- 
					СтрокиКИ = КонтактнаяИнформация.НайтиСтроки(Новый Структура("Ссылка",ВыбранноеЗначение));
					Если (СтрокиКИ.Количество() <> 0) Тогда
						СтрокаКИ = СтрокиКИ[0];
						Элементы.КонтактнаяИнформация.ТекущаяСтрока = СтрокаКИ.ПолучитьИдентификатор();
					КонецЕсли; 
					// --- 
				КонецЕсли; 	
				
			Иначе
				
				СтрокиКИ = КонтактнаяИнформация.НайтиСтроки(Новый Структура("Ссылка",ВыбранноеЗначение));
				Если (СтрокиКИ.Количество() <> 0) Тогда
					СтрокаКИ = СтрокиКИ[0];
					Элементы.КонтактнаяИнформация.ТекущаяСтрока = СтрокаКИ.ПолучитьИдентификатор();
				КонецЕсли; 
				
			КонецЕсли; 
			
			
		КонецЕсли; 
		
	КонецЕсли; 	
	
КонецПроцедуры

