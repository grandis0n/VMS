КонецПроцедуры
  
&НаСервере
Процедура _ОтборСобытий(ОбъектОтбора)
	// --- 
	
	События.Параметры.УстановитьЗначениеПараметра("ДатаСобытия",Неопределено);
	
	// --- 
	
	Если (ТипЗнч(ОбъектОтбора) = Тип("СправочникСсылка.Контрагенты")) Тогда
		
		События.Отбор.Элементы.Очистить();
		_УФС.ДобавитьОтбор(События.Отбор,"Владелец",,ОбъектОтбора);
		_ОбновитьДатыСобытий();
		
	ИначеЕсли (ТипЗнч(ОбъектОтбора) = Тип("СправочникСсылка.CW_КонтактыеЛица")) Тогда 
		
		События.Отбор.Элементы.Очистить();
		_УФС.ДобавитьОтбор(События.Отбор,"КонтактноеЛицо",,ОбъектОтбора);
		_ОбновитьДатыСобытий();
		
	ИначеЕсли (ТипЗнч(ОбъектОтбора) = Тип("СправочникСсылка.ФизическиеЛица")) Тогда 
		
		События.Отбор.Элементы.Очистить();
		_УФС.ДобавитьОтбор(События.Отбор,"КонтактноеЛицо.ФизическоеЛицо",,ОбъектОтбора);
		_ОбновитьДатыСобытий();
		
	КонецЕсли; 
	
	
	Если (Элементы.Календарь.Видимость) Тогда
		
		События.Параметры.УстановитьЗначениеПараметра("ДатаСобытия",Календарь);
		
	Иначе
		
		События.Параметры.УстановитьЗначениеПараметра("ДатаСобытия",Неопределено);
		
	КонецЕсли; 

	
	// --- 
КонецПроцедуры

&НаСервере
Процедура _ОтборПоДатеСобытия()
	// --- 
	
	Если (Элементы.Календарь.Видимость) Тогда
		
		События.Параметры.УстановитьЗначениеПараметра("ДатаСобытия",Календарь);
		Элементы.События.Обновить();
		// --- 
	Иначе
		
		События.Параметры.УстановитьЗначениеПараметра("ДатаСобытия",Неопределено);
		
	КонецЕсли;	
	
	// --- 
КонецПроцедуры
 

&НаСервере
Процедура _ОбновитьДатыСобытий()
	// --- 
	
	Если (Элементы.Календарь.Видимость) Тогда
		
		// получаем настройки компоновщика динамического списка
		_ОтключитьОтборПоДатеСобытия();
		ТаблицаСобытий = _УФС.ПолучитьДанныеДинамическогоСписка(События,"ДатаСобытия");
		_УстановитьОтборПоДатеСобытия();
		// ---------------------------------------------------------------------------- 
		ТаблицаСобытий.Колонки.Добавить("МесяцСобытия");
		Для каждого Стр Из ТаблицаСобытий Цикл
			Стр.ДатаСобытия = НачалоДня(Стр.ДатаСобытия);	
			Стр.МесяцСобытия = НачалоМесяца(Стр.ДатаСобытия);
		КонецЦикла; 
		ТаблицаМесяцев = ТаблицаСобытий.Скопировать();
		ТаблицаМесяцев.Свернуть("МесяцСобытия");
		// --- 
		СобытияПоМесяцам.Очистить();
		// --- 
		Для каждого Стр Из ТаблицаМесяцев Цикл
			
			Отбор = Новый Структура("МесяцСобытия",Стр.МесяцСобытия);
			СобытияМесяца = ТаблицаСобытий.Скопировать(Отбор);
			//_сф.к_НайтиСтроки(ТаблицаСобытий,Отбор);
			// --- 
			Нстр = СобытияПоМесяцам.Добавить();
			Нстр.Месяц = Стр.МесяцСобытия;
			Нстр.ДатыСобытий = Новый СписокЗначений;
			Нстр.ДатыСобытий.ЗагрузитьЗначения(_сф.м_СоздатьИзКолонкиТЗ(СобытияМесяца,"ДатаСобытия"));
			
		КонецЦикла; 
		
	КонецЕсли; 
	
	// --- 
КонецПроцедуры
 


