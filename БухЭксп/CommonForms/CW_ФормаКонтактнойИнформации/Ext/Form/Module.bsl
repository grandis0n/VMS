
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ПоложениеКоманднойПанели = ПоложениеКоманднойПанелиФормы.Нет;
	ЗапрашиватьТипФайлаПриДобавленииВАрхив = Константы.CW_ЗапрашиватьТипФайлаПриДобавленииВАрхив.Получить();
	
	РедактированиеФизическиеЛицаРазрешено 	= НЕ РегистрыСведений.CW_ДоступныеСправочникиПоГруппамПользователей.РедактированиеОбъектаЗапрещено(Тип("СправочникСсылка.ФизическиеЛица"));
	РедактированиеКонтрагентыРазрешено 		= НЕ РегистрыСведений.CW_ДоступныеСправочникиПоГруппамПользователей.РедактированиеОбъектаЗапрещено(Тип("СправочникСсылка.Контрагенты"));
	
	Элементы.ГруппаЛоготип.Доступность = ПолучитьФункциональнуюОпцию("CW_ИспользованиеФайловогоАрхива") И ПолучитьФункциональнуюОпцию("CW_ИспользованиеЛоготипов");
	Элементы.ГруппаЛоготип.Видимость = Элементы.ГруппаЛоготип.Доступность;
	Если (Элементы.ГруппаЛоготип.Видимость) Тогда
		Элементы.ПолеЛоготипа.РазмерКартинки=РазмерКартинки.АвтоРазмер;
	КонецЕсли; 
	Элементы.Календарь.Видимость = Ложь;
	Календарь = ТекущаяДата();

	Элементы.ГруппаКонтрагент.Видимость = Ложь;
	Элементы.ГруппаФизическоеЛицо.Видимость = Ложь;
	Элементы.СтраницаДоговоры.Видимость = Ложь;
	Элементы.СтраницаЗаявки.Видимость = Ложь;
	Элементы.СтраницаРеквизитыКонтрагента.Видимость = Ложь;
	Элементы.СтраницаРеквизитыФизическогоЛица.Видимость = Ложь;
	
	Элементы.ФормаОбщаяКоманда_Контрагент_CW_ФайлыАрхива.Видимость = Ложь;  
	Элементы.ФормаОбщаяКоманда_ФизическоеЛицо_CW_ФайлыАрхива.Видимость = Ложь;  

	Ключ = Неопределено;
	ОбъектКопирования = Неопределено;
	Параметры.Свойство("ВидФормы",ВидФормы);
	Параметры.Свойство("Ссылка",НовыйОбъект);
	Параметры.Свойство("Ключ",Ключ);
	Параметры.Свойство("ОбъектКопирования",ОбъектКопирования);
	Параметры.Свойство("РежимВыбораКИ",РежимВыбораКИ);
	Если (Ключ <> Неопределено) Тогда
		
		Если (НЕ РежимВыбораКИ) Тогда
			Если (ТипЗнч(Ключ)=Тип("СправочникСсылка.Контрагенты")) Тогда
				ВидФормы = "ФормаКонтрагента";
			ИначеЕсли (ТипЗнч(Ключ)=Тип("СправочникСсылка.ФизическиеЛица")) Тогда 
				ВидФормы = "ФормаФизическогоЛица"
			КонецЕсли; 
		Иначе
			Если (ТипЗнч(Ключ)=Тип("СправочникСсылка.Контрагенты")) Тогда
				Элементы.СтраницыКонтрагентов.ТекущаяСтраница = Элементы.СтраницаКонтрагенты;
			ИначеЕсли (ТипЗнч(Ключ)=Тип("СправочникСсылка.ФизическиеЛица")) Тогда 
				Элементы.СтраницыКонтрагентов.ТекущаяСтраница = Элементы.СтраницаФизическиеЛица;
			КонецЕсли;
		КонецЕсли; 
		
		НовыйОбъект = Ключ;
		
	КонецЕсли; 

	Если (ВидФормы = "ФормаКонтрагента") Тогда
		
		Элементы.ГруппаПоиск.Видимость = Ложь;
		Элементы.ГруппаКонтрагент.Видимость = Истина;
		Элементы.СтраницаРеквизитыКонтрагента.Видимость = Истина;   
		
		Элементы.ФормаОбщаяКоманда_Контрагент_CW_ФайлыАрхива.Видимость = Истина;  
		Элементы.ФормаОбщаяКоманда_ФизическоеЛицо_CW_ФайлыАрхива.Видимость = Ложь;  
		
		Если (НЕ НовыйОбъект.Пустая()) Тогда
			КонтрагентОбъект = НовыйОбъект.ПолучитьОбъект();
			ОбъектЗаписан = Истина;
		Иначе
			Если РедактированиеКонтрагентыРазрешено Тогда
				Если (ОбъектКопирования = Неопределено) Тогда
					КонтрагентОбъект = Справочники.Контрагенты.СоздатьЭлемент();
					КонтрагентОбъект.СтранаРегистрации = Справочники.СтраныМира.Россия;
				Иначе
					КонтрагентОбъект = ОбъектКопирования.Скопировать();
				КонецЕсли; 
			Иначе
				Сообщение = новый СообщениеПользователю;
				Сообщение.Текст = "Недостаточно прав для данного действия.";
				Сообщение.Сообщить();
				Отказ = Истина;
			КонецЕсли; 
		КонецЕсли; 
		ЗначениеВРеквизитФормы(КонтрагентОбъект,"ОбъектКонтрагент");
		ПоложениеКоманднойПанели = ПоложениеКоманднойПанелиФормы.Верх;
		
		_СформироватьЗаголовокКонтрагента();
		
	ИначеЕсли (ВидФормы = "ФормаФизическогоЛица") Тогда 
		
		Элементы.ФормаОбщаяКоманда_Контрагент_CW_ФайлыАрхива.Видимость = Ложь;  
		Элементы.ФормаОбщаяКоманда_ФизическоеЛицо_CW_ФайлыАрхива.Видимость = Истина;  
	
		Элементы.ГруппаПоиск.Видимость = Ложь;
		Элементы.ГруппаФизическоеЛицо.Видимость = Истина;
		Элементы.СтраницаРеквизитыФизическогоЛица.Видимость = Истина;
		Если (НЕ НовыйОбъект.Пустая()) Тогда
			ФизическоеЛицоОбъект = НовыйОбъект.ПолучитьОбъект();
			ОбъектЗаписан = Истина;
		Иначе
			
			Если РедактированиеФизическиеЛицаРазрешено Тогда
				Если (ОбъектКопирования = Неопределено) Тогда
					ФизическоеЛицоОбъект = Справочники.ФизическиеЛица.СоздатьЭлемент();
				Иначе
					ФизическоеЛицоОбъект = ОбъектКопирования.Скопировать();
				КонецЕсли; 
			Иначе
				Сообщение = новый СообщениеПользователю;
				Сообщение.Текст = "Недостаточно прав для данного действия.";
				Сообщение.Сообщить();
				Отказ = Истина;
			КонецЕсли;
			
			
		КонецЕсли; 
		
		ЗначениеВРеквизитФормы(ФизическоеЛицоОбъект,"ОбъектФизическоеЛицо");
		ПоложениеКоманднойПанели = ПоложениеКоманднойПанелиФормы.Верх;
		
		_СформироватьЗаголовокФизическогоЛица();
		
	КонецЕсли; 

	События.Параметры.УстановитьЗначениеПараметра("ДатаСобытия",Календарь);
	
	Элементы.ФизическиеЛица.ТолькоПросмотр 	= НЕ РедактированиеФизическиеЛицаРазрешено;
	Элементы.Контрагенты.ТолькоПросмотр 	= НЕ РедактированиеКонтрагентыРазрешено;
	ПолучитьДействующихМенеджеров();

	_УправлениеЭлементамиФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ФормироватьДеревоКонтактныхЛиц = (Элементы.СтраницыКонтрагентов.ТекущаяСтраница = Элементы.СтраницаКонтрагенты);
	// --- 
	Если (НЕ РежимВыбораКИ) Тогда
		Если (ВидФормы <> "") Тогда
			
			УстановитьТекущийОбъект(НовыйОбъект);
			
		КонецЕсли;	
		
	Иначе
		
		Если (Элементы.СтраницыКонтрагентов.ТекущаяСтраница = Элементы.СтраницаКонтрагенты) Тогда
			Элементы.Контрагенты.ТекущаяСтрока = НовыйОбъект;
		ИначеЕсли (Элементы.СтраницыКонтрагентов.ТекущаяСтраница = Элементы.СтраницаФизическиеЛица) Тогда 
			Элементы.ФизическиеЛица.ТекущаяСтрока = НовыйОбъект;
		КонецЕсли; 
		
	КонецЕсли; 
	// --- 
	ВидимостьРазделовФормы();
	
КонецПроцедуры

// ---------------------------------------------------------------------------- 

&НаСервере
Процедура _УправлениеЭлементамиФормы()
	// --- 
	
	Если (Элементы.СтраницаРеквизитыКонтрагента.Видимость) Тогда
		
		Элементы.ГруппаРезидент.Видимость = (ЗначениеЗаполнено(ОбъектКонтрагент.СтранаРегистрации) И ОбъектКонтрагент.СтранаРегистрации = Справочники.СтраныМира.Россия);
		Элементы.ГруппаНерезидент.Видимость = (ЗначениеЗаполнено(ОбъектКонтрагент.СтранаРегистрации) И ОбъектКонтрагент.СтранаРегистрации <> Справочники.СтраныМира.Россия);
		
	КонецЕсли; 
	
	Если (Элементы.ГруппаКонтрагент.Видимость) Тогда
		
		Элементы.ГруппаСтандартнаяФормаКонтрагента.Видимость = ЗначениеЗаполнено(ОбъектКонтрагент.Ссылка);
		
	КонецЕсли; 
	
	Если (Элементы.ГруппаФизическоеЛицо.Видимость) Тогда
		
		Элементы.ГруппаСтандартнаяФормаФизическогоЛица.Видимость = ЗначениеЗаполнено(ОбъектФизическоеЛицо.Ссылка);
		
	КонецЕсли; 
	
	Если (ВидФормы <> "") Тогда
		
		Элементы.СтраницыИнформации.Видимость = ОбъектЗаписан;
		
	КонецЕсли; 
	
	// --- 
КонецПроцедуры

// ---------------------------------------------------------------------------- 

&НаСервере
Процедура _СформироватьЗаголовокКонтрагента()
	// --- 
	
	Если (ЗначениеЗаполнено(ОбъектКонтрагент.Ссылка)) Тогда
		
		Заголовок = Строка(ОбъектКонтрагент.Наименование);
		
	Иначе
		
		Заголовок = "Создание контрагента";
		
	КонецЕсли; 
	
	// --- 
КонецПроцедуры
 
&НаСервере
Процедура _СформироватьЗаголовокФизическогоЛица()
	// --- 
	
	Если (ЗначениеЗаполнено(ОбъектФизическоеЛицо.Ссылка)) Тогда
		
		Заголовок = Строка(ОбъектФизическоеЛицо.ФИО);
		
	Иначе
		
		Заголовок = "Создание физического лица";
		
	КонецЕсли; 
	
	// --- 
КонецПроцедуры

// ---------------------------------------------------------------------------- 

#Область Списки 

&НаКлиенте
Процедура КонтрагентыПриАктивизацииСтроки(Элемент)
	
	Если (Элементы.СтраницыКонтрагентов.ТекущаяСтраница = Элементы.СтраницаКонтрагенты) Тогда
		
		Если (Элементы.Контрагенты.ТекущаяСтрока <> Неопределено) Тогда
			
			УстановитьТекущийОбъект(Элементы.Контрагенты.ТекущаяСтрока);
			
		КонецЕсли; 
		
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ФизическиеЛицаПриАктивизацииСтроки(Элемент)
	
	Если (Элементы.СтраницыКонтрагентов.ТекущаяСтраница = Элементы.СтраницаФизическиеЛица) Тогда
		
		Если (Элементы.ФизическиеЛица.ТекущаяСтрока <> Неопределено) Тогда
			
			УстановитьТекущийОбъект(Элементы.ФизическиеЛица.ТекущаяСтрока);
			
		КонецЕсли; 
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьТекущийОбъект(НовыйОбъект)
	
	Если (НовыйОбъект <> ТекущийОбъект) Тогда
		
		ТекущийОбъект = НовыйОбъект;

		Если (ТипЗнч(ТекущийОбъект)=Тип("СправочникСсылка.Контрагенты")) Тогда
			
			ФормироватьДеревоКонтактныхЛиц = Истина;
			Если (Элементы.ГруппаКонтактныеЛицаКонтрагента.Видимость <> ФормироватьДеревоКонтактныхЛиц) Тогда
				Элементы.ГруппаКонтактныеЛицаКонтрагента.Видимость = (ФормироватьДеревоКонтактныхЛиц);	
			КонецЕсли; 

			СформироватьДерево();
			СвернутьДеревоКонтактныхЛиц();
			ОбновитьЛоготип();

			_ОтборСобытий(ТекущийОбъект);
			
		ИначеЕсли (ТипЗнч(ТекущийОбъект)=Тип("СправочникСсылка.ФизическиеЛица")) Тогда
			
			ФормироватьДеревоКонтактныхЛиц = Ложь;
			Если (Элементы.ГруппаКонтактныеЛицаКонтрагента.Видимость <> ФормироватьДеревоКонтактныхЛиц) Тогда
				Элементы.ГруппаКонтактныеЛицаКонтрагента.Видимость = (ФормироватьДеревоКонтактныхЛиц);	
			КонецЕсли; 

			_СформироватьТаблицуКонтактныхЛиц();

			_ОтборСобытий(ТекущийОбъект);
			Элементы.СтраницаДоговоры.Видимость = Ложь;
			Элементы.СтраницаЗаявки.Видимость = Ложь;
			
		КонецЕсли; 
		
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьЛоготип()
	
	Если Элементы.ГруппаЛоготип.Доступность Тогда
		ОбновитьЛоготипНаСервере();
	КонецЕсли; 
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьЛоготипНаСервере()
	
	АдресЛоготипа = "";

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	CW_ЛоготипыКонтрагентов.ОбъектАрхива КАК ОбъектАрхива
	               |ИЗ
	               |	РегистрСведений.CW_ЛоготипыКонтрагентов КАК CW_ЛоготипыКонтрагентов
	               |ГДЕ
	               |	CW_ЛоготипыКонтрагентов.Контрагент = &Контрагент";

	Запрос.УстановитьПараметр("Контрагент", ТекущийОбъект); 
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Если Выборка.Следующий() Тогда
		 ОбъектАрхива = Выборка.ОбъектАрхива;
		 АдресЛоготипа = CW_РаботаСФайламиСервер.ПолучитьСсылкуНаДвоичныеДанные(Выборка.ОбъектАрхива, УникальныйИдентификатор)
	КонецЕсли;
	
КонецПроцедуры
 

#КонецОбласти 



#Область Действия

&НаКлиенте
Процедура ДоговорыКонтрагента(Команда)
	
	Если (Элементы.Контрагенты.ТекущаяСтрока <> Неопределено) Тогда
		ПФ = Новый Структура("Отбор,ЗаголовокОтбора",Новый Структура("Владелец",Элементы.Контрагенты.ТекущаяСтрока),Строка(Элементы.Контрагенты.ТекущаяСтрока));
		ОткрытьФорму("Справочник.CW_ДоговорыПоГрузоперевозкам.ФормаСписка",ПФ,,Истина);
	КонецЕсли; 
	
КонецПроцедуры



#КонецОбласти 

#Область ДеревоКонтактныхЛиц

// ---------------------------------------------------------------------------- 

&НаСервере
Процедура _СформироватьТаблицуКонтактныхЛиц()
	// --- 
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	CW_КонтактыеЛица.Ссылка,
	               |	CW_КонтактыеЛица.Владелец КАК Контрагент,
	               |	CW_КонтактыеЛица.Должность,
	               |	CW_КонтактыеЛица.ПометкаУдаления,
	               |	CW_КонтактыеЛица.Неактивный,
	               |	CW_КонтактыеЛица.Комментарий
	               |ИЗ
	               |	Справочник.CW_КонтактыеЛица КАК CW_КонтактыеЛица
	               |ГДЕ
	               |	CW_КонтактыеЛица.ФизическоеЛицо = &ФизическоеЛицо
	               |	И CW_КонтактыеЛица.ПометкаУдаления = ЛОЖЬ";
	Запрос.УстановитьПараметр("ФизическоеЛицо", ТекущийОбъект);
	// --- 
	ТЗ = Запрос.Выполнить().Выгрузить();
	
	Если (ТЗ.Количество() = 0) Тогда
		
		КонтактныеЛицаФизическогоЛица.Очистить();
		
	Иначе
		
		КонтактныеЛицаФизическогоЛица.Загрузить(ТЗ);
		
	КонецЕсли; 
	КартинкаПользователя = ПоместитьВоВременноеХранилище(БиблиотекаКартинок.CW_Пользователь.ПолучитьДвоичныеДанные(),УникальныйИдентификатор);
	Для каждого Стр Из КонтактныеЛицаФизическогоЛица Цикл
		Стр.АдресКартинки = КартинкаПользователя;
	КонецЦикла; 
	
	_ОтборКонтактнойИнформации(ТекущийОбъект);
	
	// --- 
КонецПроцедуры
 

// ---------------------------------------------------------------------------- 

&НаКлиенте
Процедура СформироватьДерево()
	// --- 
	
	Если (ФормироватьДеревоКонтактныхЛиц) Тогда
		
		СохранитьВидДерева();
		// --- 
		_СформироватьДерево();
		// --- 
		ВосстановитьВидДерева();	
		
	КонецЕсли; 
	
	// --- 
КонецПроцедуры

&НаКлиенте
Процедура СохранитьВидДерева()
	// --- 
	
	СостояниеДерева.Очистить();
	// --- 
	КореньДерева = Неопределено;
	СтрокиДерева = КонтактныеЛица.ПолучитьЭлементы();
	Если (СтрокиДерева.Количество() <> 0) Тогда
		ОпределитьСтатусУзла(СтрокиДерева[0]);
	КонецЕсли; 
	
	// --- 
КонецПроцедуры

&НаКлиенте
Функция ОпределитьСтатусУзла(Узел)
	// --- 
	
	Если (Узел.ЭтоГруппа) Тогда
		
		Идентификатор = Узел.ПолучитьИдентификатор();
		Если (Идентификатор <> Неопределено) Тогда
			
			Развернут = Элементы.КонтактныеЛица.Развернут(Идентификатор);
			Если (Развернут <> Неопределено) Тогда
				СостояниеДерева.Добавить(Узел.Ссылка,,Развернут);
				// --- 
				Для каждого ПУ Из Узел.ПолучитьЭлементы() Цикл
					
					ОпределитьСтатусУзла(ПУ);
					
				КонецЦикла; 
			КонецЕсли; 
			
		КонецЕсли; 
		
	КонецЕсли; 
	
	// --- 
КонецФункции
  

&НаКлиенте
Процедура ВосстановитьВидДерева()
	// --- 
	
	ИдентификаторТекущегоУзла = 0;
	
	Если (СостояниеДерева.Количество() <> 0) Тогда
		
		СтрокиДерева = КонтактныеЛица.ПолучитьЭлементы();
		Если (СтрокиДерева.Количество() <> 0) Тогда
			ВосстановитьСтатусУзла(СтрокиДерева[0]);
		КонецЕсли; 
		
	КонецЕсли; 
	
	Элементы.КонтактныеЛица.ТекущаяСтрока = ИдентификаторТекущегоУзла;
	
	// --- 
КонецПроцедуры

&НаКлиенте
Функция ВосстановитьСтатусУзла(Узел)
	// --- 
	
	Если (Узел.ЭтоГруппа) Тогда
		
		СсылкаУзла = Узел.Ссылка;
		ЗаписьСтатуса = СостояниеДерева.НайтиПоЗначению(СсылкаУзла);
		Если (ЗаписьСтатуса <> Неопределено) Тогда
			
			ТекущийИдентификатор = Узел.ПолучитьИдентификатор();
			Если (ЗаписьСтатуса.Пометка) Тогда
				
				Элементы.КонтактныеЛица.Развернуть(ТекущийИдентификатор);
				
			КонецЕсли; 
			
			Если (СсылкаУзла = ТекущийРодительУзла ИЛИ СсылкаУзла = ТекущийУзел) Тогда
				
				ИдентификаторТекущегоУзла = ТекущийИдентификатор;
				
			КонецЕсли; 
			
		Иначе
			
			Элементы.КонтактныеЛица.Развернуть(Узел.ПолучитьИдентификатор());
			
		КонецЕсли; 
		
		Для каждого ПУ Из Узел.ПолучитьЭлементы() Цикл
			
			ВосстановитьСтатусУзла(ПУ);
			
		КонецЦикла; 
		
	Иначе
		
		СсылкаУзла = Узел.Ссылка;
		Если (СсылкаУзла = ТекущийУзел) Тогда
			
			ТекущийИдентификатор = Узел.ПолучитьИдентификатор();
			ИдентификаторТекущегоУзла = ТекущийИдентификатор;
			
		КонецЕсли; 
		
	КонецЕсли; 
	
	// --- 
КонецФункции
  

&НаСервере
Процедура _СформироватьДерево()
	// --- 
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	CW_КонтактыеЛица.Ссылка,
	               |	CW_КонтактыеЛица.Родитель,
	               |	CW_КонтактыеЛица.Наименование,
	               |	0 КАК Уровень,
	               |	CW_КонтактыеЛица.ЭтоГруппа,
	               |	CW_КонтактыеЛица.Должность,
	               |	CW_КонтактыеЛица.Неактивный,
	               |	CW_КонтактыеЛица.Комментарий
	               |ИЗ
	               |	Справочник.CW_КонтактыеЛица КАК CW_КонтактыеЛица
	               |ГДЕ
	               |	CW_КонтактыеЛица.Владелец = &Владелец
	               |	И CW_КонтактыеЛица.ПометкаУдаления = ЛОЖЬ";
	Запрос.УстановитьПараметр("Владелец", ТекущийОбъект);
	// --- 
	ТЗ = Запрос.Выполнить().Выгрузить();
	ТЗ.Колонки.Добавить("СтрокаСформирована",Новый ОписаниеТипов("Булево"));
	
	УровниГрупп = Новый Соответствие;
	Для каждого Стр Из ТЗ Цикл
		
		Если (Стр.ЭтоГруппа) Тогда
			
			УровниГрупп.Вставить(Стр.Ссылка,_ОпределитьУровеньГруппы(Стр.Ссылка,УровниГрупп));
			
		КонецЕсли; 
		
	КонецЦикла; 
	
	ТЗ.Сортировать("ЭтоГруппа Убыв,Уровень Убыв");
	
	// очищаем дерево
	КонтактныеЛица.ПолучитьЭлементы().Очистить();
	// ---------------------------------------------------------------------------- 
	
	Нстр = КонтактныеЛица.ПолучитьЭлементы().Добавить();
	Нстр.Ссылка = ТекущийОбъект;
	Нстр.ЭтоКорень = Истина;
	Нстр.ЭтоГруппа = Истина;
	Нстр.Представление = Строка(ТекущийОбъект);
	// --- 
	Для каждого Стр Из ТЗ Цикл
		
		_СформироватьВеткуДерева(Стр, ТЗ, Нстр);
		
	КонецЦикла; 
	// --- 
	КоличествоПодчиненных = 0;
	Для каждого ПС Из Нстр.ПолучитьЭлементы() Цикл
		_сф.Инкремент(КоличествоПодчиненных,ПС.КоличествоПодчиненных);
	КонецЦикла; 
	ПредставлениеКоличества = ?(КоличествоПодчиненных <> 0," ("+Формат(КоличествоПодчиненных)+")","");
	Нстр.Представление = Строка(ТекущийОбъект)+ПредставлениеКоличества;
	
	// --- 
КонецПроцедуры
 
&НаСервере
Функция _ОпределитьУровеньГруппы(Группа, СоответствиеУровней)
	// --- 
	
	Если (Группа.Родитель.Пустая()) Тогда
		
		УровеньРодителя = 0;
		
	Иначе
		
		УровеньРодителя = СоответствиеУровней.Получить(Группа.Родитель);
		Если (УровеньРодителя = Неопределено) Тогда
			УровеньРодителя = _ОпределитьУровеньГруппы(Группа.Родитель, СоответствиеУровней);
		КонецЕсли; 
		
	КонецЕсли; 
	// --- 
	Возврат(1+УровеньРодителя);
	
	// --- 
КонецФункции
 
&НаСервере
Процедура _СформироватьВеткуДерева(СтрокаТЗ, ТЗ, Родитель=Неопределено)
	// --- 
	
	Если (СтрокаТЗ.СтрокаСформирована) Тогда
		
		Возврат;
		
	КонецЕсли; 
	
	Если (Родитель = Неопределено) Тогда
		
		Нстр = КонтактныеЛица.ПолучитьЭлементы().Добавить();
		
	Иначе
		
		Нстр = Родитель.ПолучитьЭлементы().Добавить();
		
	КонецЕсли; 
	
	Нстр.Ссылка = СтрокаТЗ.Ссылка;
	Нстр.ЭтоГруппа = СтрокаТЗ.ЭтоГруппа;
	СтрокаТЗ.СтрокаСформирована = Истина;
	Если (СтрокаТЗ.ЭтоГруппа) Тогда
		
		Нстр.ИндексКартинки = 0;
		// --- 
		Отбор = Новый Структура("Родитель",Нстр.Ссылка);
		ТаблицаПодчиненных = _сф.к_НайтиСтроки(ТЗ,Отбор);
		Для каждого СтрокаПодчиненного Из ТаблицаПодчиненных Цикл
			_СформироватьВеткуДерева(СтрокаПодчиненного, ТЗ, Нстр);
		КонецЦикла; 
		// --- 
		КоличествоПодчиненных = 0;
		Для каждого ПС Из Нстр.ПолучитьЭлементы() Цикл
			_сф.Инкремент(КоличествоПодчиненных,ПС.КоличествоПодчиненных);
		КонецЦикла; 
		
		// --- 
		Нстр.КоличествоПодчиненных = КоличествоПодчиненных;
		ПредставлениеКоличества = ?(КоличествоПодчиненных <> 0," ("+Формат(КоличествоПодчиненных)+")",""); 
		Нстр.Представление = СтрокаТЗ.Наименование + ПредставлениеКоличества;
		
	Иначе
		
		Нстр.ИндексКартинки = 1;
		Нстр.КоличествоПодчиненных = 1;
		// --- 
		Нстр.Представление = Строка(СтрокаТЗ.Ссылка);
		Нстр.Должность = СтрокаТЗ.Должность;
		Нстр.Неактивный = СтрокаТЗ.Неактивный;
		Нстр.Комментарий = СтрокаТЗ.Комментарий;
		
	КонецЕсли; 
	
	// --- 
КонецПроцедуры

