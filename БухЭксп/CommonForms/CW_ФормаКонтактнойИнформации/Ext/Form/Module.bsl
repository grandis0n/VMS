			Элементы.КонтактнаяИнформация.ТолькоПросмотр = Истина;
		Иначе
			Элементы.КонтактнаяИнформация.ТолькоПросмотр = Ложь;
		КонецЕсли; 
		// вызываем формирование отбора
		Если (ТекущийУзел <> ТекущийОбъектОтбора) Тогда
			
			ТекущийОбъектОтбора = ТекущийУзел;
			// --- 
			ОтборКонтактнойИнформации(ТекущийУзел);
