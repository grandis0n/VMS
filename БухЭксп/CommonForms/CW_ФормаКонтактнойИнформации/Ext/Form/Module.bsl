Процедура КонтактныеЛицаПеретаскивание(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Строка, Поле)
	
	СтандартнаяОбработка=Ложь;
	
	Если (ТипЗнч(ПараметрыПеретаскивания.Значение) = Тип("Массив")) Тогда
		
		ПеретаскиваемаяСтрока = ПараметрыПеретаскивания.Значение[0];
		Если (ТипЗнч(ПеретаскиваемаяСтрока) = Тип("Число")) Тогда
			
			_УстановитьРодителя(ПеретаскиваемаяСтрока,Строка);
			СформироватьДерево();
			
		ИначеЕсли (ТипЗнч(ПеретаскиваемаяСтрока)=Тип("ДанныеФормыЭлементКоллекции")) Тогда 
			
			Если (ТипЗнч(ПеретаскиваемаяСтрока.Ссылка)=Тип("СправочникСсылка.CW_КонтактнаяИнформация")) Тогда
				
				МассивКИ = Новый Массив;
				Для каждого Стр Из ПараметрыПеретаскивания.Значение Цикл
					МассивКИ.Добавить(Стр.Ссылка);	
				КонецЦикла; 
				Ответ = _ПереподчинитьКонтактнуюИнформацию(МассивКИ,Строка);
				Если (_УФКС.ВыполненоУспешно(Ответ)) Тогда
					
					_ОбновитьКонтактнуюИнформацию();
					СформироватьДерево();
					
				Иначе
					
					_УФК.ВывестиПредупреждение(_УФКС.ПредставлениеОшибки(Ответ));
					
				КонецЕсли; 
				
			КонецЕсли; 
			
		КонецЕсли; 
		
	КонецЕсли; 
	
КонецПроцедуры

&НаСервере
Процедура _УстановитьРодителя(ИдентификаторЭлемента, ИдентификаторГруппы)
	// --- 
	
	СтрокаЭлемента = КонтактныеЛица.НайтиПоИдентификатору(ИдентификаторЭлемента);
	СтрокаГруппы = КонтактныеЛица.НайтиПоИдентификатору(ИдентификаторГруппы);
	
	ТекущийУзел = СтрокаЭлемента.Ссылка;
	ТекущийРодительУзла = СтрокаГруппы.Ссылка;
	
	Если (СтрокаГруппы.ЭтоГруппа) Тогда
		
		Элемент = СтрокаЭлемента.Ссылка.ПолучитьОбъект();
		Элемент.Родитель = СтрокаГруппы.Ссылка;
		Элемент.Записать();
		
		//_СформироватьДерево();
		
	КонецЕсли; 
	
	// --- 
КонецПроцедуры

&НаСервере
Функция _ПереподчинитьКонтактнуюИнформацию(МассивКИ, ИдентификаторСтрокиКЛ)
	// --- 
	
	СтрокаКЛ= КонтактныеЛица.НайтиПоИдентификатору(ИдентификаторСтрокиКЛ);
	Если (СтрокаКЛ.ЭтоГруппа И ТипЗнч(СтрокаКЛ.Ссылка) <> Тип("СправочникСсылка.Контрагенты")) Тогда
		
		Возврат(_УФКС.Ответ(1,"Контактную информацию нельзя отнести к группе контактных лиц."));
		
	КонецЕсли; 
	
	Для каждого ЭлементКИ Из МассивКИ Цикл
		
		//Если (ЭлементКИ.ЛичнаяКИ) Тогда
		//	Продолжить;
		//КонецЕсли; 
		// --- 
		// если старый владелец или новый владелец контрагенты - тогда копируем
		СтарыйВладелец = ЭлементКИ.Владелец;
		НовыйВладелец = СтрокаКЛ.Ссылка;
		Если (ТипЗнч(СтарыйВладелец)=Тип("СправочникСсылка.Контрагенты") ИЛИ ТипЗнч(НовыйВладелец)=Тип("СправочникСсылка.Контрагенты")) Тогда
			
			// копируем
			ОбъектКИ = ЭлементКИ.Скопировать();
			ОбъектКИ.Владелец = СтрокаКЛ.Ссылка;
			ОбъектКИ.Записать();
			
		Иначе
			
			// копируем
			ОбъектКИ = ЭлементКИ.Скопировать();
			ОбъектКИ.Владелец = СтрокаКЛ.Ссылка;
			ОбъектКИ.Записать();
			//// переподчиняем
			//ОбъектКИ = ЭлементКИ.ПолучитьОбъект();
			//ОбъектКИ.Владелец = СтрокаКЛ.Ссылка;
			//ОбъектКИ.Записать();
			
		КонецЕсли; 
		
	КонецЦикла; 
	
	Возврат(_УФКС.Ответ());
	
	// --- 
