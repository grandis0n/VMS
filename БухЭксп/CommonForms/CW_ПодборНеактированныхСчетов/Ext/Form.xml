	<Attributes>
		<Attribute name="ТаблицаВходящихСчетов" id="1">
			<Title>
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Таблица входящих счетов</v8:content>
				</v8:item>
			</Title>
			<Type>
				<v8:Type>cfg:DynamicList</v8:Type>
			</Type>
			<Settings xsi:type="DynamicList">
				<ManualQuery>true</ManualQuery>
				<DynamicDataRead>false</DynamicDataRead>
				<QueryText>ВЫБРАТЬ РАЗРЕШЕННЫЕ
	РегистрНакопленияCW_АктированиеВходящихСчетовОстатки.Счет КАК Счет,
	РегистрНакопленияCW_АктированиеВходящихСчетовОстатки.ВсегоОстаток КАК Всего
ИЗ
	РегистрНакопления.CW_АктированиеВходящихСчетов.Остатки(
			&amp;Период,
			Организация = &amp;Организация
				И Контрагент = &amp;Контрагент
				И Договор = &amp;Договор
				И ПриложениеКДоговору = &amp;ПриложениеКДоговору
				И Валюта = &amp;Валюта
				И ВЫБОР
					КОГДА &amp;Грузоперевозка = НЕОПРЕДЕЛЕНО
						ТОГДА ИСТИНА
					ИНАЧЕ Грузоперевозка = &amp;Грузоперевозка
				КОНЕЦ
				И ВЫБОР
					КОГДА &amp;ПорядокОтражения = НЕОПРЕДЕЛЕНО
						ТОГДА ИСТИНА
					ИНАЧЕ ПорядокОтражения = &amp;ПорядокОтражения
				КОНЕЦ
				И ВЫБОР
					КОГДА &amp;Номенклатура = НЕОПРЕДЕЛЕНО
						ТОГДА ИСТИНА
					ИНАЧЕ Номенклатура = &amp;Номенклатура
				КОНЕЦ
				И ВЫБОР
					КОГДА &amp;СтавкаНДС = НЕОПРЕДЕЛЕНО
