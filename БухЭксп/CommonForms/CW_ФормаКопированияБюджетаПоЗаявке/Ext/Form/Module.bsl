
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ОбъектКопирования = Параметры.ОбъектКопирования;
	УИД = Параметры.УИД;
	
	// --- 
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	CW_ВариантыБюджетовПоЗаявкам.Ссылка
	|ИЗ
	|	Справочник.CW_ВариантыБюджетовПоЗаявкам КАК CW_ВариантыБюджетовПоЗаявкам
	|ГДЕ
	|	CW_ВариантыБюджетовПоЗаявкам.ПометкаУдаления = ЛОЖЬ
	|	И CW_ВариантыБюджетовПоЗаявкам.Владелец = &Владелец";
	Запрос.УстановитьПараметр("Владелец", ОбъектКопирования);
	ТЗ = Запрос.Выполнить().Выгрузить();
	Для каждого Стр Из ТЗ Цикл
		
		ВариантыБюджетов.Добавить(Стр.Ссылка,,Истина);
		
	КонецЦикла; 
	 
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаДа(Команда)
	
	Ответ = _УФКС.Ответ();
	Ответ.Вставить("ВариантыБюджетов",ВариантыБюджетов);
	// --- 
	ЭтаФорма.Закрыть(Ответ);
	
КонецПроцедуры
