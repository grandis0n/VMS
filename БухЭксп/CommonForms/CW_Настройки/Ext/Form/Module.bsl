&НаСервереБезКонтекста
Процедура ОбработатьСправочникВалюты(ВалютаРубль)
	
	УстановитьПривилегированныйРежим(истина);
	
	ТекущаяВалюта = Константы.ВалютаРегламентированногоУчета.Получить();
	
	Если ТекущаяВалюта = ВалютаРубль Тогда
		КлассификаторXML = Обработки.ЗагрузкаКурсовВалют.ПолучитьМакет("ОбщероссийскийКлассификаторВалют").ПолучитьТекст();
	Иначе
		КлассификаторXML = Обработки.CW_ЗагрузкаКурсовВалют_ЕЦБ.ПолучитьМакет("ОбщероссийскийКлассификаторВалют").ПолучитьТекст();
	КонецЕсли;
	
	КлассификаторТаблица = ОбщегоНазначения.ПрочитатьXMLВТаблицу(КлассификаторXML).Данные;
	
	Если ТекущаяВалюта = ВалютаРубль тогда
		ПолеПоиска 	= "Code";
		ПолеКод 	= "Code";
	Иначе
		ПолеПоиска  = "CodeSymbol";
		ПолеКод 	= "Code";
	КонецЕсли;
	
	//Обработкам справочник "Валюты"
	Запрос = Новый запрос;
	запрос.Текст = 	"ВЫБРАТЬ
	               	|	Валюты.Ссылка КАК Ссылка,
	               	|	Валюты.Код КАК Code,
	               	|	Валюты.Наименование КАК CodeSymbol
	               	|ИЗ
	               	|	Справочник.Валюты КАК Валюты";
	
	Результат = Запрос.Выполнить();
	
	Выборка = Результат.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		ВалютаОбъект = Выборка.Ссылка.ПолучитьОбъект();

		ЗаписьОКВ = КлассификаторТаблица.Найти(Выборка[ПолеПоиска],ПолеПоиска);
		
		Если Не ЗаписьОКВ = Неопределено Тогда
			
			ВалютаОбъект.Код					= ЗаписьОКВ[ПолеКод];
			ВалютаОбъект.Наименование			= ЗаписьОКВ.CodeSymbol;
			ВалютаОбъект.НаименованиеПолное		= ЗаписьОКВ.Name;
			
			Если ТекущаяВалюта = ВалютаРубль Тогда
				ВалютаОбъект.ЗагружаетсяИзИнтернета	= ЗаписьОКВ.RBCLoading;
				Загружается = Вычислить(ЗаписьОКВ.RBCLoading);
			Иначе
				ВалютаОбъект.ЗагружаетсяИзИнтернета	= ЗаписьОКВ.ECBLoading;
				Загружается = Вычислить(ЗаписьОКВ.ECBLoading);
			КонецЕсли;
			
			ВалютаОбъект.ПараметрыПрописи		= ЗаписьОКВ.NumerationItemOptions;
			
			Если Загружается Тогда
				ВалютаОбъект.СпособУстановкиКурса = Перечисления.СпособыУстановкиКурсаВалюты.ЗагрузкаИзИнтернета;
			Иначе
				ВалютаОбъект.СпособУстановкиКурса = Перечисления.СпособыУстановкиКурсаВалюты.РучнойВвод;
			КонецЕсли;
			
		Иначе
			
			ВалютаОбъект.СпособУстановкиКурса 	= Перечисления.СпособыУстановкиКурсаВалюты.РучнойВвод;
			ВалютаОбъект.ЗагружаетсяИзИнтернета = Ложь;
			
		КонецЕсли;
		
		ВалютаОбъект.Записать();
		
	КонецЦикла;
	
	Сообщение = новый СообщениеПользователю;   
	Сообщение.Текст = НСтр("ru = 'Модифицирован справочник валюты'; en = 'The currency directory has been modified'");
	Сообщение.Сообщить();	
	
	
	//Очистим курсы валют
	НаборЗаписей = РегистрыСведений.КурсыВалют.СоздатьНаборЗаписей();
	НаборЗаписей.Очистить();
	
	//Создадим запись для базовой валюты
	Запись = НаборЗаписей.Добавить();
	Запись.Период 		= Дата(1980,1,1);
	Запись.Валюта 		= ТекущаяВалюта;
	Запись.Курс 		= 1;
	Запись.Кратность 	= 1;
	
	НаборЗаписей.Записать(Истина);

	Сообщение = новый СообщениеПользователю;   
	Сообщение.Текст = НСтр("ru = 'Удалены курсы валют'; en = 'Deleted exchange rates'");
	Сообщение.Сообщить();	

	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры


