&НаКлиенте
Процедура ОбработкаВыбораПользователя(ЗначениеВыбора, ДополнительныйПараметр) Экспорт
	
	Если Не ЗначениеВыбора = Неопределено Тогда
		
		Отказ = ПроверитьВозможностьВыбораПользователя(ЗначениеВыбора);
		
		Если Отказ Тогда
			ПоказатьПредупреждение(,"Выбранный пользователь помечен на удаление или недействителен!");
		КонецЕсли;
				
		Если Не Отказ Тогда
			
			ДанныеЗаполнения = Новый Структура("Пользователь", ЗначениеВыбора);
			
			ПараметрыФормы = Новый Структура("ЗначенияЗаполнения",ДанныеЗаполнения);
			ОткрытьФорму("РегистрСведений.CW_НастройкиПользователей.ФормаЗаписи", ПараметрыФормы,ЭтаФорма,,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
			
		КонецЕсли;
		
	Конецесли;
	
