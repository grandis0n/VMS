	Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаОбОбновленииПравПользователей", ЭтаФорма);
	ПоказатьВопрос(Оповещение, "Произвести автоматическую настройку ролей пользователей модуля?", Режим, 0);

