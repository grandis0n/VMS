&НаКлиенте
Процедура CW_ВедениеБухгалтескогоУчетаМСФОПриИзменении(Элемент)

	ДополнительныеПараметры = новый Структура;
	ДополнительныеПараметры.Вставить("Имя", Элемент.Имя);
	
	Оповещение = Новый ОписаниеОповещения("ПродолжитьИзменениеОпцииВедениеБухгалтескогоУчетаМСФО", ЭтотОбъект, ДополнительныеПараметры);
	ТекстВопроса = "Будет отключена функциональность ""Учет по МСФО"". Продолжить?";
	
	Если Не CW_ВедениеБухгалтескогоУчетаМСФО Тогда
		Режим = РежимДиалогаВопрос.ДаНет;
		ПоказатьВопрос(Оповещение, ТекстВопроса, Режим, 0);	
	Иначе   
		ВыполнитьОбработкуОповещения(Оповещение,КодВозвратаДиалога.Да); 
	КонецЕсли;
	
	
КонецПроцедуры   

&НаКлиенте
Процедура ПродолжитьИзменениеОпцииВедениеБухгалтескогоУчетаМСФО(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Нет Тогда
		CW_ВедениеБухгалтескогоУчетаМСФО = Истина;	
		Возврат;
	КонецЕсли;   
	
	НаборКонстант.CW_ВедениеБухгалтескогоУчетаМСФО =  CW_ВедениеБухгалтескогоУчетаМСФО;
	ИзмененныеКонстанты = ВедениеБухгалтескогоУчетаМСФОПриИзмененииНаСервере();
	
	УправлениеФормойНаСервере();
	
	ПодключитьОбработчикОжидания("ОбновитьИнтерфейсПрограммы", 0.1, Истина);
	ОбновитьИнтерфейс = Истина;
	
	Для Каждого КонстантаИмя ИЗ ИзмененныеКонстанты Цикл
		Если КонстантаИмя <> "" Тогда
			Оповестить("Запись_НаборКонстант", Новый Структура, КонстантаИмя);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ВедениеБухгалтескогоУчетаМСФОПриИзмененииНаСервере()
	
	ИзмененныеКонстанты = Новый Массив;
		
	КонстантаИмя = СохранитьЗначениеРеквизита("НаборКонстант.CW_ВедениеБухгалтескогоУчетаМСФО");
	ИзмененныеКонстанты.Добавить(КонстантаИмя);
	
	НаборКонстант.CW_МСФО_ВалютаУчета = ВалютаРегламентированногоУчета;
	КонстантаИмя = СохранитьЗначениеРеквизита("НаборКонстант.CW_МСФО_ВалютаУчета");
	ИзмененныеКонстанты.Добавить(КонстантаИмя);
	
	Если CW_ВедениеБухгалтескогоУчетаМСФО и Не НаборКонстант.CW_ИспользованиеВнешнихПодписок Тогда
		///Включаем внешние подписки, если они не включены
		НаборКонстант.CW_ИспользованиеВнешнихПодписок = Истина;
		КонстантаИмя = СохранитьЗначениеРеквизита("НаборКонстант.CW_ИспользованиеВнешнихПодписок");
		ИзмененныеКонстанты.Добавить(КонстантаИмя);
	КонецЕсли;
	
	ОбновитьПовторноИспользуемыеЗначения();
	
	Возврат ИзмененныеКонстанты;
	
КонецФункции
