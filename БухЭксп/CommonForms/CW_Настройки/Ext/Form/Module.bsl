&НаКлиенте
Процедура ЛичныйКабинетПодключить(Команда)
	
	Режим = РежимДиалогаВопрос.ДаНет;
	Оповещение = Новый ОписаниеОповещения("ПродложитьПодключениеКСервису", ЭтотОбъект, Параметры);
	
	ПоказатьВопрос(Оповещение, "Будет выполнено подключение к сервису 
								|""Личный кабинет клиента"". Продолжить?", Режим, 0);
	
КонецПроцедуры

&НаКлиенте
Процедура ПродложитьПодключениеКСервису(Результат, Параметры) Экспорт
	Если Результат = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ CW_РаботаСВнешнимиРесурсамиСервер.ПроверитьПараметрыАвторизацииНаСервереТехподдрежки() Тогда
		ПоказатьПредупреждение(,"Не указаны параметры авторизации на сервере техподдержки!",,"Авторизация");
	Иначе
		CW_РаботаСВнешнимиРесурсамиСервер.СоздатьПараметрыПодключенияСервиса();
		
		Оповещение = Новый ОписаниеОповещения("ОбработатьРезультатПодключенияКСервису", ЭтотОбъект, Параметры);
		ОткрытьФорму("ОбщаяФорма.CW_ЛичныйКабинетАктивацияДоступа",,ЭтаФорма,,,,Оповещение,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьРезультатПодключенияКСервису(Результат, Параметры) Экспорт
	Если Результат = Неопределено Тогда
		//Отказ от подклчюения
		Возврат;
	КонецЕсли;
	
	НаборКонстант.CW_ЛичныйКабинетИспользуется = Истина;
	ПриИзмененииРеквизитаНаКлиенте(Элементы.CW_ЛичныйКабинетИспользуется, Истина);
	
	УстановитьВидимостьКнопокУправленияЛичнымКабинетов();
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьВидимостьКнопокУправленияЛичнымКабинетов()
	
	Элементы.ЛичныйКабинетПодключить.Видимость	= Не НаборКонстант.CW_ЛичныйКабинетИспользуется;
	Элементы.НастройкиЛичногоКабинета.Видимость = НаборКонстант.CW_ЛичныйКабинетИспользуется;
	Элементы.ЛичныйКабинетОтключить.Видимость	= НаборКонстант.CW_ЛичныйКабинетИспользуется;

КонецПроцедуры

&НаКлиенте
Процедура ЛичныйКабинетОтключить(Команда)
	
	Режим = РежимДиалогаВопрос.ДаНет;
	Оповещение = Новый ОписаниеОповещения("ПродолжитьОтключениеЛичногоКабинета", ЭтотОбъект, Параметры);
	ПоказатьВопрос(Оповещение, "Вы действительно хотите от подключения к сервису?", Режим, 0);
	
КонецПроцедуры

&НаКлиенте
Процедура ПродолжитьОтключениеЛичногоКабинета(Результат, Параметры) Экспорт
    Если Результат = КодВозвратаДиалога.Нет Тогда
        Возврат;
    КонецЕсли;
	
	КодСостояния = ВыполнитьОтключениеСервисаНаСервере();
	
	Если КодСостояния = 200 Тогда
		НаборКонстант.CW_ЛичныйКабинетИспользуется = Ложь;
		ПриИзмененииРеквизитаНаКлиенте(Элементы.CW_ЛичныйКабинетИспользуется, Истина);
		
		УстановитьВидимостьКнопокУправленияЛичнымКабинетов();
		ПоказатьПредупреждение(,"Сервис отключен",,"Личный кабинет клиента"); 
	Иначе
		ПоказатьПредупреждение(,"Ошибка отключения сервиса. Попробуйте позже.",,"Ошибка работы с сервисом"); 
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция  ВыполнитьОтключениеСервисаНаСервере() 
	
	РегистрационныйНомер 	= CW_ПроверкаЛицензии.ПолучитьРегистрационныйНомер();

	СтруктураJSON = Новый Структура;
	СтруктураJSON.Вставить("regnumber",		XMLСтрока(РегистрационныйНомер));
	СтруктураJSON.Вставить("disabledate",	XMLСтрока(ТекущаяДата()));    
	
	ПараметрыHTTPЗапроса = CW_РаботаСВнешнимиРесурсамиСервер.ПодготовитьHTTPЗапрос("lkk_disableservice", СтруктураJSON);
 	Ответ 		= CW_РаботаСВнешнимиРесурсамиСервер.ПолучитьДанныеССервера(ПараметрыHTTPЗапроса.HTTPСоединение, ПараметрыHTTPЗапроса.HTTPЗапрос, "GET"); 
	Если Ответ = Неопределено Тогда
		Возврат 533;
	КонецЕсли;
	
	Возврат Ответ.КодСостояния
	
КонецФункции

