&НаКлиенте
Перем ОбновитьИнтерфейс;

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка) 
	
	УстановитьДоступностьЭлементовФормыДляПолныхПрав(ЭтаФорма);

	ВалютаРубль = CW_БухгалтерияЭкспедитораСервер.ПолучитьЗначениеНациональнойВалюты();
	
	ПроверитьПараметрыУчета();
	
	
	// --- 
	Если НаборКонстант.CW_ПорядокРасчетаНормативаТоплива.Пустая() Тогда
		НаборКонстант.CW_ПорядокРасчетаНормативаТоплива = Перечисления.CW_ПорядокРасчетаНормативаТоплива.НаДатуОкончанияПеревозки;
	КонецЕсли;
	
	ИнициализацияРегламеногоЗадания();

	//Подсистема.ЛичныйКабинет
	Элементы.ЛичныйКабинетПодключить.Видимость	= Не НаборКонстант.CW_ЛичныйКабинетИспользуется;
	Элементы.НастройкиЛичногоКабинета.Видимость = НаборКонстант.CW_ЛичныйКабинетИспользуется;
	Элементы.ЛичныйКабинетОтключить.Видимость	= НаборКонстант.CW_ЛичныйКабинетИспользуется;
	//Подсистема.ЛичныйКабинет  
	
	//Подсистема.CW_БухгалтерскийУчетМСФО
	Элементы.ГруппаМСФО.Видимость = CW_ВерсииПодсистемСервер.СуществуетПодсистема("CW_БухгалтерияЭкспедитора.CW_БухгалтерскийУчетМСФО");
	//Подсистема.CW_БухгалтерскийУчетМСФО  
	
	УстановитьЗначенияРеквизитовФормы(ЭтаФорма);
	УправлениеФормойНаСервере();
	
	УстановитьУсловноеОфрмлениеФормы();
	
	ПолучитьДанныеАктивацииНаСервере();

	УстановитьОтборНастроейОперативногоУчетаНаСервере(); 

	_УФС.ОтключитьИсториюВыбораЭлементовФормы(ЭтаФорма);   
	
	ОтборПользователей = 1;
	УстановитьОтбрСпискаНастройкиПользователейНаСервере();
	
	ИспользуетсяНовыйМеханизм = CW_ПроверкаЛицензии.ИспользуетсяНовыйМеханизмЛицензирования();
	
	Элементы.ОбщаяКомандаCW_РегистрацияМодуля.Видимость =  НЕ ИспользуетсяНовыйМеханизм;
	Элементы.ГруппаЛицензияНаПрограмму.Видимость 		=  НЕ ИспользуетсяНовыйМеханизм; 
	
	Элементы.ОбщаяКомандаCW_АктивацияМодуля.Видимость 			=  ИспользуетсяНовыйМеханизм;
	Элементы.ОбщаяКомандаCW_ПолучитьКомплектПинКодов.Видимость 	=  ИспользуетсяНовыйМеханизм;
	Элементы.ГруппаАктивацияПрограммы.Видимость 				=  ИспользуетсяНовыйМеханизм;

	ПоказатьСкрытьСоставНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ПолучитьДанныеАктивацииНаСервере()
	
	ДанныеЛицензии = CW_РегистрацияПрограммыСервер.ПолучитьДанныеСтраницыЛицензии(); 
	
	ЗаполнитьЗначенияСвойств(ЭтаФорма, ДанныеЛицензии);  
	
	Если ДанныеЛицензии.Свойство("ЦветТекстаСтатуса") Тогда
		Элементы.Рег_СтатусПрограммы.ЦветТекста = ДанныеЛицензии.ЦветТекстаСтатуса;	
	КонецЕсли;
	Если ДанныеЛицензии.Свойство("ЦветТекстаБазы") Тогда
		Элементы.Рег_Использование.ЦветТекста = ДанныеЛицензии.ЦветТекстаБазы;	
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "ВыполненаАктивацияПрограммы" Тогда
		
		ПолучитьДанныеАктивацииНаСервере();            
		
	ИначеЕсли ИмяСобытия = "Запись_Пользователи" Тогда  
		
		Элементы.НастройкиПользователей.Обновить();
		
	КонецЕсли;
	
КонецПроцедуры


//Подсистема.РаботаСЭлектроннойПочтой
&НаКлиенте
Процедура ОтправкаПисемИспользуетсяПриИзменении(Элемент)
	ЗаписатьИзмененияРегламентногоЗадания();
	
	УправлениеФормойНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьНадписьРасписания()
	
	Если ОтправкаПисемРасписаниеРегламентногоЗадания = Неопределено Тогда
		ОтправкаПисемРасписаниеВыполнения = НСтр("ru='Настроить расписание выполнения'");
	Иначе
		ОтправкаПисемРасписаниеВыполнения = ОтправкаПисемРасписаниеРегламентногоЗадания;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправкаПисемРасписаниеВыполненияНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если ОтправкаПисемРасписаниеРегламентногоЗадания = Неопределено Тогда
		ОтправкаПисемРасписаниеРегламентногоЗадания = Новый РасписаниеРегламентногоЗадания;
	КонецЕсли;
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ОтправкаПисемЗавершитьИзменениеРасписания", ЭтотОбъект);
	
	Диалог = Новый ДиалогРасписанияРегламентногоЗадания(ОтправкаПисемРасписаниеРегламентногоЗадания);
	Диалог.Показать(ОписаниеОповещения);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправкаПисемЗавершитьИзменениеРасписания(РезультатВыбора, ДополнительныеПараметры) Экспорт
	
	Если РезультатВыбора = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОтправкаПисемРасписаниеРегламентногоЗадания = РезультатВыбора;
	УстановитьНадписьРасписания();
	
	ЗаписатьИзмененияРегламентногоЗадания();
	
КонецПроцедуры

&НаСервере
Процедура ИнициализацияРегламеногоЗадания()
	
	УстановитьПривилегированныйРежим(Истина);
	
	//Подсистема.РаботаСЭлектроннойПочтой
	РегламентноеЗадание = РегламентныеЗадания.НайтиПредопределенное(Метаданные.РегламентныеЗадания.CW_ОтправкаПисем);
	ОтправкаПисемРасписаниеРегламентногоЗадания	= РегламентноеЗадание.Расписание;
	ОтправкаПисемИспользуется					= РегламентноеЗадание.Использование;
	УстановитьНадписьРасписания();
	//Подсистема.РаботаСЭлектроннойПочтой

КонецПроцедуры

&НаСервере
Процедура ЗаписатьИзмененияРегламентногоЗадания()
	
	УстановитьПривилегированныйРежим(Истина);
	
	РегламентноеЗадание = РегламентныеЗадания.НайтиПредопределенное(Метаданные.РегламентныеЗадания.CW_ОтправкаПисем);
	
	РегламентноеЗадание.Использование 	= ОтправкаПисемИспользуется;
	РегламентноеЗадание.Расписание 		= ОтправкаПисемРасписаниеРегламентногоЗадания;
	РегламентноеЗадание.Записать();
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправкаПисемВыполнитьВручную(Команда)
	
	РезультатВыполнения =  ОтправкаПисемВыполнитьВручнуюНаСервереВФоне();
	
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ВыводитьОкноОжидания = Истина;
	ОповещениеОЗавершении = Новый ОписаниеОповещения("ЗавершениеВыполненияРегламентногоЗаданияОтправкаПисем", ЭтотОбъект);
	
	ДлительныеОперацииКлиент.ОжидатьЗавершение(РезультатВыполнения, ОповещениеОЗавершении, ПараметрыОжидания);

КонецПроцедуры

&НаСервере
Функция ОтправкаПисемВыполнитьВручнуюНаСервереВФоне()
	
	ПараметрыПроцедуры = Новый Структура;
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(Новый УникальныйИдентификатор);
	ПараметрыВыполнения.ОжидатьЗавершение 			= 0; // запускать сразу
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = "Отправка писем";
	ПараметрыВыполнения.ЗапуститьВФоне 				= Истина;
	ПараметрыВыполнения.ЗапуститьНеВФоне 			= ложь;
	
	Возврат ДлительныеОперации.ВыполнитьВФоне("_ЭП.ОтправитьПочту",ПараметрыПроцедуры, ПараметрыВыполнения);
	
КонецФункции

&НаКлиенте
Процедура ЗавершениеВыполненияРегламентногоЗаданияОтправкаПисем(РезультатВыполнения, Дополнительныепараметры) Экспорт
	
	Если РезультатВыполнения.Статус = "Выполнено" Тогда
		ПоказатьОповещениеПользователя("Отправка писем завершена",,"Регламентное задание");
	ИначеЕсли РезультатВыполнения.Статус = "Ошибка" Тогда
		ПоказатьОповещениеПользователя("Ошибка отправки писем",, "Регламентное задание");
	КонецЕсли;
	
КонецПроцедуры

//Подсистема.РаботаСЭлектроннойПочтой


&НаСервереБезКонтекста
Функция НаличиеПроведенныхДокументов()
	
	ТекстЗапроса	= "";
	ПерваяИнтерация = Истина;
	
	Для Каждого ОбъектМетаданных из Метаданные.Документы Цикл
		
		Если Не ПерваяИнтерация Тогда
			
			ТекстЗапроса = ТекстЗапроса + "
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|";
			
		КонецЕсли;
		
		ТекстЗапроса = ТекстЗапроса + "
		|ВЫБРАТЬ ПЕРВЫЕ 1
		|	"+ОбъектМетаданных.Имя+".Ссылка
		|ИЗ
		|	Документ."+ОбъектМетаданных.Имя+" КАК "+ОбъектМетаданных.Имя;
		
		ПерваяИнтерация = ложь;
		
		
	КонецЦикла;
	
	Если ЗначениеЗаполнено(ТекстЗапроса) Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = ТекстЗапроса;
		РезультатЗапроса = Запрос.Выполнить();
		
		Возврат Не РезультатЗапроса.Пустой();
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

&НаСервереБезКонтекста
Процедура УстановитьДоступностьЭлементовФормыДляПолныхПрав(Форма)
	
	ЭтоПользовательСПолнымиПравами 	 = CW_ПраваДоступа.ПравоДоступно("ПолныеПрава");
	Форма.ТолькоПросмотр			 = Не ЭтоПользовательСПолнымиПравами;
	
	Для Каждого Элемент из Форма.Элементы Цикл
		Если ЕстьСвойство(Элемент, "ТолькоПросмотр") Тогда
			Элемент.ТолькоПросмотр = Не ЭтоПользовательСПолнымиПравами;
		ИначеЕсли  ТипЗнч(Элемент) = Тип("КнопкаФормы") Тогда
			Элемент.Доступность = ЭтоПользовательСПолнымиПравами;
		КонецЕсли;
	КонецЦикла;

	Форма.Элементы.СсылкаНаПодключаемыеОбъекты.Доступность  			  = ЭтоПользовательСПолнымиПравами;
	Форма.Элементы.ИдентификаторыПодключаемыхОбъектов.Доступность  		  = ЭтоПользовательСПолнымиПравами;
	Форма.Элементы.ПроверитьИОбновитьНаборыПравПользователей.Доступность  = ЭтоПользовательСПолнымиПравами;
	Форма.Элементы.Группа8.Доступность  								  = ЭтоПользовательСПолнымиПравами;
	
	Форма.Элементы.CW_ЛичныйКабинетИспользуется.ТолькоПросмотр		= Истина;
	Форма.Элементы.CW_РеестрыНДС0Используется.ТолькоПросмотр		= Истина;
	Форма.Элементы.CW_ДоходыНерезидентовИспользуется.ТолькоПросмотр	= Истина;   
	Форма.Элементы.CW_ОбменГИСЭПДИспользуется.ТолькоПросмотр		= Истина;   

	                                                                 
КонецПроцедуры

&НаСервереБезКонтекста
Функция ЕстьСвойство(Элемент, Свойство)
	
	Попытка 
		ЗначениеСвойства = Элемент[Свойство];
		Возврат Истина;
	Исключение
		Возврат Ложь;
	КонецПопытки;
	
КонецФункции

&НаСервере
Процедура УстановитьУсловноеОфрмлениеФормы()
	
	//При помощи условного оформления для полноправных 
	//ползователей устанвливаем текст группы пользователя "Администраторы"
	
	Запрос = новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	CW_НастройкиПользователей.Пользователь КАК Пользователь
	|ИЗ
	|	РегистрСведений.CW_НастройкиПользователей КАК CW_НастройкиПользователей";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	мПолноправныеПользователи = Новый Массив;
	Пока Выборка.Следующий() Цикл
		Если CW_ПраваДоступа.ЭтоПолноправныйПользователь(Выборка.Пользователь, Истина) Тогда
			мПолноправныеПользователи.Добавить(Выборка.Пользователь);
		КонецЕсли;
	КонецЦикла;
	
	Если мПолноправныеПользователи.Количество() > 0 Тогда
		
		СписокПолноправныхПользователей = Новый СписокЗначений;
		СписокПолноправныхПользователей.ЗагрузитьЗначения(мПолноправныеПользователи);
		
		ЭлементУО = УсловноеОформление.Элементы.Добавить();
		
		КомпоновкаДанныхКлиентСервер.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "НастройкиПользователейГруппаПользователей");
		
		ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"НастройкиПользователей.Пользователь", ВидСравненияКомпоновкиДанных.ВСписке, СписокПолноправныхПользователей);
		
		ИмяГруппыАдминистраторы = Строка(Справочники.CW_ГруппыПользователей.Администраторы);
		
		ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", ИмяГруппыАдминистраторы);
		
	КонецЕсли;

КонецПроцедуры

#Область ЗаполнениеСчетовРасчетов 

&НаКлиенте
Процедура ЗаполнитьСчетаРасчетов_Поставщики(Команда)
	
	_ЗаполнитьСчетаРасчетов("Поставщики");
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьСчетаРасчетов_Покупатели(Команда)
	
	_ЗаполнитьСчетаРасчетов("Покупатели");	
	
КонецПроцедуры

&НаСервере
Процедура _ЗаполнитьСчетаРасчетов(Вариант)
	// --- 
	
	Поставщики = (Вариант = "Поставщики");
	Покупатели = (Вариант = "Покупатели");
	Счета = CW_Конфигурация.ПланСчетов();
	// --- 
	
	Если (Поставщики) Тогда
		
		НЗ = РегистрыСведений.CW_СчетаВзаиморасчетовСПоставщиками.СоздатьНаборЗаписей();
		МассивСчетов = Новый Массив;
		МассивСчетов.Добавить(Счета.РасчетыСПоставщиками); // 60.01
		МассивСчетов.Добавить(Счета.РасчетыПоАвансамВыданным); // 60.02
		МассивСчетов.Добавить(Счета.РасчетыСПоставщикамиВал); // 60.21
		МассивСчетов.Добавить(Счета.РасчетыПоАвансамВыданнымВал); // 60.22
		МассивСчетов.Добавить(Счета.РасчетыСПоставщикамиУЕ); // 60.31
		МассивСчетов.Добавить(Счета.РасчетыПоАвансамВыданнымУЕ); // 60.32
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	CW_УчетнаяПолитика.СчетРасчетов_Поставщики_Рубли КАК Рубли,
		               |	CW_УчетнаяПолитика.СчетРасчетов_Поставщики_Валюта КАК Валюта,
		               |	CW_УчетнаяПолитика.СчетРасчетов_Поставщики_УЕ КАК УЕ
		               |ИЗ
		               |	РегистрСведений.CW_УчетнаяПолитика КАК CW_УчетнаяПолитика";
		ТаблицаСчетовПоставщиков = Запрос.Выполнить().Выгрузить();
		Для каждого Стр Из ТаблицаСчетовПоставщиков Цикл
			_сф.м_ДобавитьУникально(МассивСчетов,Стр.Рубли);
			_сф.м_ДобавитьУникально(МассивСчетов,Стр.Валюта);
			_сф.м_ДобавитьУникально(МассивСчетов,Стр.УЕ);
		КонецЦикла; 
		
	ИначеЕсли (Покупатели) Тогда 
		
		НЗ = РегистрыСведений.CW_СчетаВзаиморасчетовСПокупателями.СоздатьНаборЗаписей();
		МассивСчетов = Новый Массив;
		МассивСчетов.Добавить(Счета.РасчетыСПокупателями); // 62.01
		МассивСчетов.Добавить(Счета.РасчетыПоАвансамПолученным); // 62.02
		МассивСчетов.Добавить(Счета.РасчетыСПокупателямиВал); // 62.21
		МассивСчетов.Добавить(Счета.РасчетыПоАвансамПолученнымВал); // 62.22
		МассивСчетов.Добавить(Счета.РасчетыСПокупателямиУЕ); // 62.31
		МассивСчетов.Добавить(Счета.РасчетыПоАвансамПолученнымУЕ); // 62.32
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	CW_УчетнаяПолитика.СчетРасчетов_Клиенты_Рубли КАК Рубли,
		               |	CW_УчетнаяПолитика.СчетРасчетов_Клиенты_Валюта КАК Валюта,
		               |	CW_УчетнаяПолитика.СчетРасчетов_Клиенты_УЕ КАК УЕ
		               |ИЗ
		               |	РегистрСведений.CW_УчетнаяПолитика КАК CW_УчетнаяПолитика";
		ТаблицаСчетовПоставщиков = Запрос.Выполнить().Выгрузить();
		Для каждого Стр Из ТаблицаСчетовПоставщиков Цикл
			_сф.м_ДобавитьУникально(МассивСчетов,Стр.Рубли);
			_сф.м_ДобавитьУникально(МассивСчетов,Стр.Валюта);
			_сф.м_ДобавитьУникально(МассивСчетов,Стр.УЕ);
		КонецЦикла; 
		
	КонецЕсли; 
	
	НЗ.Очистить();
	Для каждого Счет Из МассивСчетов Цикл
		
		Запись = НЗ.Добавить();
		Запись.Счет = Счет;
		
	КонецЦикла; 
	НЗ.Записать(Истина);
	
	// --- 
	
	Элементы.СчетаКлиентов.Обновить();
	Элементы.СчетаПоставщиков.Обновить();
	
	// --- 
КонецПроцедуры

