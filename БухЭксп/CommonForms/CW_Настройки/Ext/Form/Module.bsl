&НаКлиенте
Процедура ОбработатьИзменениеОпции(СтруктураПараметров)  
	
	КонстантаИмя = ПолучитьИмяКонстанты(СтруктураПараметров.Имя);
	Если КонстантаИмя = "" тогда
		Возврат;
	КонецЕсли;
	
	Оповещение = Новый ОписаниеОповещения("ПродолжитьИзменениеОпции", ЭтотОбъект, СтруктураПараметров);
	
	ЗначениеОпции = НаборКонстант[КонстантаИмя];
	
	Если Не ЗначениеОпции Тогда
		Режим = РежимДиалогаВопрос.ДаНет;
		ПоказатьВопрос(Оповещение, СтруктураПараметров.ТекстВопроса, Режим, 0);	
	Иначе   
		ВыполнитьОбработкуОповещения(Оповещение,КодВозвратаДиалога.Да); 
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПродолжитьИзменениеОпции(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Нет Тогда 
		КонстантаИмя = ПолучитьИмяКонстанты(ДополнительныеПараметры.Имя);
		Если КонстантаИмя <> "" Тогда
			НаборКонстант[КонстантаИмя] = Истина; //Всегда устанавливаем в "Истина", так как перед этим сняли
		КонецЕсли;
		
		Возврат;
	КонецЕсли;   

	КонстантаИмя = ПриИзмененииРеквизитаСервер(ДополнительныеПараметры.Имя);
	
	ПодключитьОбработчикОжидания("ОбновитьИнтерфейсПрограммы", 0.1, Истина);
	
	Если КонстантаИмя <> "" Тогда
		Оповестить("Запись_НаборКонстант", Новый Структура, КонстантаИмя);
	КонецЕсли;
	
КонецПроцедуры  

&НаСервере
Функция ПолучитьИмяКонстанты(ИмяЭлемента)

	РеквизитПутьКДанным = Элементы[ИмяЭлемента].ПутьКДанным;
	Если РеквизитПутьКДанным = "" Тогда
		Возврат "";
	КонецЕсли;
	
	// Определение имени константы.
	КонстантаИмя = "";
	Если НРег(Лев(РеквизитПутьКДанным, 14)) = НРег("НаборКонстант.") Тогда
		// Если путь к данным реквизита указан через "НаборКонстант".
		КонстантаИмя = Сред(РеквизитПутьКДанным, 15);
	КонецЕсли; 
	
	Возврат КонстантаИмя;
	
КонецФункции



&НаКлиенте
Процедура ВалютаРегламентированногоУчетаПриИзменении(Элемент)
	
	Если ПроверитьВозмоожностьИзмененияКонстанты() Тогда 
		НаборКонстант.ВалютаРегламентированногоУчета =  ВалютаРегламентированногоУчета;
		ИзмененныеКонстанты = ВалютаРегламентированногоУчетаНаСервере();
		
		УправлениеФормойНаСервере();
		
		ПодключитьОбработчикОжидания("ОбновитьИнтерфейсПрограммы", 0.1, Истина);
		ОбновитьИнтерфейс = Истина;
		
		Для Каждого КонстантаИмя ИЗ ИзмененныеКонстанты Цикл
			Если КонстантаИмя <> "" Тогда
				Оповестить("Запись_НаборКонстант", Новый Структура, КонстантаИмя);
			КонецЕсли;
		КонецЦикла;
	Иначе
		ВалютаРегламентированногоУчета = НаборКонстант.ВалютаРегламентированногоУчета;
		ПоказатьПредупреждение(,"Невозможно изменить валюту регламентированного учета, в информационной базе есть проведенные документы!");
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПроверитьВозмоожностьИзмененияКонстанты()
	
	ВалютаДоИзменения = Константы.ВалютаРегламентированногоУчета.Получить();
	
	Если ВалютаДоИзменения <> ВалютаРегламентированногоУчета и ЗначениеЗаполнено(ВалютаДоИзменения) Тогда
		Возврат Не НаличиеПроведенныхДокументов();
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции


