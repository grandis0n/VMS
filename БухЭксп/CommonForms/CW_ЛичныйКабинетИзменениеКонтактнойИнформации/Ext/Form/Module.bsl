&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	РегистрационныйНомер 	= CW_ПроверкаЛицензии.ПолучитьРегистрационныйНомер();
	
	ЗаполнитьСписокВыбораЧасовыхПоясов(Элементы.ЧасовойПояс.СписокВыбора);
	
	Параметры.Свойство("НазваниеКомпании", 		НазваниеКомпании);
	Параметры.Свойство("НазваниеКомпанииАнгл", 	НазваниеКомпанииАнгл);
	Параметры.Свойство("Сайт", 					Сайт);
	Параметры.Свойство("Телефоны", 		 		Телефоны);
	Параметры.Свойство("ЭлектроннаяПочта", 		ЭлектроннаяПочта);
	Параметры.Свойство("ЧасовойПояс", 			ЧасовойПояс);
	                                        	
КонецПроцедуры

&НаСервере
Функция ОтправитьДляОбработки()
	
	СтруктураJSON = Новый Структура;
	СтруктураJSON.Вставить("regnumber",	XMLСтрока(РегистрационныйНомер));
	СтруктураJSON.Вставить("nameen",	XMLСтрока(НазваниеКомпанииАнгл));
	СтруктураJSON.Вставить("name",		XMLСтрока(НазваниеКомпании));
	СтруктураJSON.Вставить("phone",		XMLСтрока(Телефоны));
	СтруктураJSON.Вставить("website",	XMLСтрока(Сайт));
	СтруктураJSON.Вставить("email",		XMLСтрока(ЭлектроннаяПочта));
	СтруктураJSON.Вставить("timezone",	XMLСтрока(ЧасовойПояс));
	
	ПараметрыHTTPЗапроса = CW_РаботаСВнешнимиРесурсамиСервер.ПодготовитьHTTPЗапрос("lkk_changecontacts", СтруктураJSON);
	Ответ 		= CW_РаботаСВнешнимиРесурсамиСервер.ПолучитьДанныеССервера(ПараметрыHTTPЗапроса.HTTPСоединение, ПараметрыHTTPЗапроса.HTTPЗапрос, "POST");		
	Если Ответ = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат Ответ.КодСостояния;
	
КонецФункции

&НаКлиенте
Процедура ЗавершитьАктивацию(Команда)
	
	КодСостояния =  ОтправитьДляОбработки();
	Если КодСостояния = Неопределено Тогда
		ПоказатьПредупреждение(,"Ошибка работы с интертент!");
		Возврат;
	КонецЕсли;
	                                                         
	Если КодСостояния = 200 Тогда
		
		ЧасовойПоясПредставление = ПолучитьПредставлениеЧасовгоПояса(ЧасовойПояс);

		СтруктураПараметров = Новый Структура;
		СтруктураПараметров.Вставить("НазваниеКомпанииАнгл", 		НазваниеКомпанииАнгл);
		СтруктураПараметров.Вставить("НазваниеКомпании", 			НазваниеКомпании);
		СтруктураПараметров.Вставить("Сайт", 			 			Сайт);
		СтруктураПараметров.Вставить("Телефоны", 		 			Телефоны);
		СтруктураПараметров.Вставить("ЭлектроннаяПочта", 			ЭлектроннаяПочта);
		
		СтруктураПараметров.Вставить("ЧасовойПояс", 				ЧасовойПояс);
		СтруктураПараметров.Вставить("ЧасовойПоясПредставление", 	ЧасовойПоясПредставление);

		ЭтаФорма.Закрыть(СтруктураПараметров);
	Иначе
		ПоказатьПредупреждение(,"Не удалось завершить активацию Сервиса!",,"Ошибка активации Сервиса");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗакрытьФорму(Команда)
	
	ЭтаФорма.Закрыть();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокВыбораЧасовыхПоясов(СписокЗначений) Экспорт
	
	мЧасовыеПояса = ПолучитьДопустимыеЧасовыеПояса();
	
	Для Каждого ЧасовойПояс  из мЧасовыеПояса Цикл
		ПредставлениеЧасовогоПояса = ПолучитьПредставлениеЧасовгоПояса(ЧасовойПояс);
		СписокЗначений.Добавить(ЧасовойПояс, ПредставлениеЧасовогоПояса); 
	КонецЦикла;
	
	СписокЗначений.СортироватьПоПредставлению(НаправлениеСортировки.Возр);
	
КонецПроцедуры

Функция ПолучитьПредставлениеЧасовгоПояса(ЧасовойПояс) Экспорт
	
	Если Не ЗначениеЗаполнено(ЧасовойПояс) тогда
		Возврат "";
	КонецЕсли;
	
	Возврат "("+ПредставлениеЧасовогоПояса(ЧасовойПояс)+") "+ЧасовойПояс;
	
КонецФункции
