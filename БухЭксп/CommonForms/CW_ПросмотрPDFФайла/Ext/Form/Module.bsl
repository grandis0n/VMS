
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Параметры.Свойство("АдресФайла", АдресФайла);
	Если Не ЭтоАдресВременногоХранилища(АдресФайла) Тогда
		Отказ = истина;
		Возврат;
	КонецЕсли;   
	
	Если Параметры.Свойство("ЗаголовокФормы") 
		И Не ПустаяСтрока(Параметры.ЗаголовокФормы) Тогда
		Заголовок = Параметры.ЗаголовокФормы;  
		ЭтаФорма.АвтоЗаголовок = Ложь;
	КонецЕсли;
	
КонецПроцедуры  

&НаКлиенте
Процедура ПриОткрытии(Отказ) 
	
	ЗагрузитьДокумент();
	
КонецПроцедуры     

&НаКлиенте
Процедура ЗагрузитьДокумент()  
	
	ДанныеФайла = ПолучитьИзВременногоХранилища(АдресФайла);
	Если ТипЗнч(ДанныеФайла) = Тип("ДвоичныеДанные") Тогда   
		ПотокВПамяти = ДанныеФайла.ОткрытьПотокДляЧтения(); 
		Попытка
			ДокументPDF.Прочитать(ПотокВПамяти); 
			Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаДокумент;   
		Исключение
			Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаОшибка;   
		КонецПопытки;
	КонецЕсли;
	
КонецПроцедуры  
