
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ОбъектКопирования = Параметры.ОбъектКопирования;
	УИД = Параметры.УИД;
	
	НастройкиПользователя = CW_Настройки.ПолучитьНастройкиПользователя(ПараметрыСеанса.ТекущийПользователь);
	СпособЗаполненияПараметровГрузоперевозкиПриКопировании 	= НастройкиПользователя.СпособЗаполненияПараметровГрузоперевозкиПриКопировании;
	
	Если (ТипЗнч(ОбъектКопирования)=Тип("СправочникСсылка.CW_Заказы")) Тогда
		
		ЭтаФорма.Заголовок = "Копирование заказа";
		Элементы.ОчищатьСсылкуНаЗаказ.Видимость = Ложь;
		_СформироватьСписокГП();
		
	ИначеЕсли (ТипЗнч(ОбъектКопирования)=Тип("СправочникСсылка.CW_Грузоперевозки")) Тогда 
		
		ЭтаФорма.Заголовок = "Копирование грузоперевозки";
		Элементы.ГруппаГрузоперевозки.Видимость = Ложь;
		Элементы.ОчищатьСсылкуНаЗаказ.Видимость = Ложь;
		КопироватьГрузоперевозки=Истина;
		Элементы.ГруппаЗаполнениеПараметров.Видимость = Истина;
		
	КонецЕсли; 
	
	// --- 
	
	// --- 
	Бюджетирование = ПолучитьФункциональнуюОпцию("CW_ИспользованиеБюджетирования");
	Элементы.ГруппаБюджеты.Видимость = (Бюджетирование);
	Если (Бюджетирование) Тогда
		_СформироватьСписокВерсийБюджетов();
	КонецЕсли; 
	
	_УправлениеЭлементамиФормы();
	
КонецПроцедуры

&НаСервере
Процедура _СформироватьСписокГП()
	// --- 
	
	МассивГП = CW_Мониторинг.ГрузоперевозкиЗаказа(ОбъектКопирования);
	Грузоперевозки.Очистить();
	Для каждого Стр Из МассивГП Цикл
		
		Грузоперевозки.Добавить(Стр,,Истина);
		
	КонецЦикла; 
	
	// --- 
КонецПроцедуры
 
&НаСервере
Процедура _СформироватьСписокВерсийБюджетов()
	// --- 
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	CW_ВерсииБюджетов.Ссылка
	|ИЗ
	|	Справочник.CW_ВерсииБюджетов КАК CW_ВерсииБюджетов
	|ГДЕ
	|	CW_ВерсииБюджетов.ПометкаУдаления = ЛОЖЬ";
	ТЗ = Запрос.Выполнить().Выгрузить();
	ВерсииБюджетов.Очистить();
	Для каждого Стр Из ТЗ Цикл
		
		ВерсииБюджетов.Добавить(Стр.Ссылка,,Истина);
		
	КонецЦикла; 
	
	// --- 
КонецПроцедуры


&НаКлиенте
Процедура КомандаОК(Команда)
	
	ЭтаФорма.Закрыть(_АдресПараметров());
	
КонецПроцедуры
 
&НаСервере
Функция _АдресПараметров()
	// --- 
	
	Ответ = Новый Структура("ОбъектКопирования,Грузоперевозки,ВерсииБюджетов,ОчищатьПоказателиБюджетов,ОчищатьСсылкуНаЗаказ,СпособЗаполненияПараметровГрузоперевозкиПриКопировании");
	Ответ.ОбъектКопирования = ОбъектКопирования;
	Ответ.ОчищатьСсылкуНаЗаказ = ОчищатьСсылкуНаЗаказ;
	Ответ.СпособЗаполненияПараметровГрузоперевозкиПриКопировании = СпособЗаполненияПараметровГрузоперевозкиПриКопировании;
	
	Если (КопироватьГрузоперевозки) Тогда
		
		Ответ.Грузоперевозки = _сф.сп_ОтобратьПоПометке(Грузоперевозки,Истина).ВыгрузитьЗначения();
		
		Если (КопироватьБюджет) Тогда
			
			Ответ.ВерсииБюджетов = _сф.сп_ОтобратьПоПометке(ВерсииБюджетов,Истина).ВыгрузитьЗначения();
			Ответ.ОчищатьПоказателиБюджетов = ОчищатьПоказателиБюджетов;
			
		КонецЕсли; 
		
	КонецЕсли; 
	
	Адрес = ПоместитьВоВременноеХранилище(Ответ,УИД);
	Возврат(Адрес);
	
	// --- 
КонецФункции

// ---------------------------------------------------------------------------- 

&НаКлиенте
Процедура КопироватьГрузоперевозкиПриИзменении(Элемент)
	
	Если (НЕ КопироватьГрузоперевозки) Тогда
		
		КопироватьБюджет = Ложь;
		ОчищатьПоказателиБюджетов = Ложь;
		СпособЗаполненияПараметровГрузоперевозкиПриКопировании = -1;
	КонецЕсли; 
	
	_УправлениеЭлементамиФормы();
	
КонецПроцедуры

&НаСервере
Функция _УправлениеЭлементамиФормы()
	
	Элементы.Грузоперевозки.Доступность 			= КопироватьГрузоперевозки;
	Элементы.КопироватьБюджет.Доступность 			= КопироватьГрузоперевозки;
	Элементы.ГруппаЗаполнениеПараметров.Видимость 	= КопироватьГрузоперевозки;
	Элементы.ВерсииБюджетов.Доступность 			= КопироватьБюджет;
	Элементы.ОчищатьПоказателиБюджета.Доступность 	= КопироватьБюджет;

КонецФункции

&НаКлиенте
Процедура КопироватьБюджетПриИзменении(Элемент)
	
	Если (НЕ КопироватьБюджет) Тогда
		ОчищатьПоказателиБюджетов = Ложь;
	КонецЕсли; 
	_УправлениеЭлементамиФормы();
	
КонецПроцедуры
 
 