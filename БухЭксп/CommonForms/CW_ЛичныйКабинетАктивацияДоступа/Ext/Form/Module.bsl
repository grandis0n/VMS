&НаКлиенте
Процедура ПодтверждениеОтказаОтПодклчюенияКСервису(Результат, Параметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("РегистрационныйНомер", 	РегистрационныйНомер);
	СтруктураПараметров.Вставить("ПинКод", 					"");//передаем пустую строку, будут заблокирвоаны все активные
	СтруктураПараметров.Вставить("Событие", 				0);

	Успешно =  CW_РегистрацияПрограммыСервер.ПроверитьВведенныйПинКод(СтруктураПараметров);   
	CW_РегистрацияПрограммыСервер.ЗаблокироватьПинКод(СтруктураПараметров);
		
	ЭтаФорма.Закрыть();
	
КонецПроцедуры

