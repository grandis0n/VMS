&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ПоказатьНастройки = Ложь;
	Если Параметры.Свойство("ПоказатьНастройки") Тогда
		ПоказатьНастройки =	 Параметры.ПоказатьНастройки;
	Конецесли;
	
	Параметры.Свойство("ОбъектСсылка", ОбъектСсылка);
	
	Элементы.ГруппаПределыОтбора.Видимость = ЗначениеЗаполнено(ОбъектСсылка);
	
	Если ТипЗнч(ОбъектСсылка) = Тип("СправочникСсылка.CW_Заявки") Тогда
		Элементы.НадписьПредупреждение.Заголовок = "ВНИМАНИЕ! Поиск выполняется в пределах заявки: ";
	Иначе
		Элементы.НадписьПредупреждение.Заголовок = "ВНИМАНИЕ! Поиск выполняется в пределах заказа: ";
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОбъектСсылка) Тогда
		Элементы.ДеревоГПЗаказ.Видимость = ТипЗнч(ОбъектСсылка) = Тип("СправочникСсылка.CW_Заявки");
	КонецЕсли;
	
	Элементы.Группа4.Видимость = ПоказатьНастройки; 
						
	ВосстановитьСеансовуюНастройку();
	
	УстановитьЗаголовкиЭлементовФормы();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьЗаголовкиЭлементовФормы()
	
	Элементы.Количество_НомераКонтейнеров.Заголовок = ?(ТекстСодержитСписокНомеровКонтейнеров=0,"Найдено номеров контейнеров","Найдено представлений");
	
КонецПроцедуры

&НаКлиенте
Процедура кнПолучитьКонтейнера(Команда)
	
	Если ПустаяСтрока(Текст) Тогда
		_УФК.ВывестиПредупреждение("Введите текст");
		Возврат;
	КонецЕсли; 
	
	_ПолучитьКонтейнера();
	
КонецПроцедуры

&НаСервере
Процедура _ПолучитьКонтейнера()
	
	Список.Очистить();
	
	// закомментированный код вырезает из текста все буквы русского алфавита,
	// но в номерах контейнеров очень часто они присутствуют (по ошибке),
	// поэтому анализу подвергнем весь текст
	
	//ВыхТекст = "";
	//ДлТекста = СтрДлина(Текст);
	//Для Инк = 1 по ДлТекста цикл
	//	Если ЭтоЛатБуква(КодСимвола(Текст, Инк)) или ЭтоЦифра(КодСимвола(Текст, Инк)) Тогда
	//		ВыхТекст = ВыхТекст + Сред(Текст, Инк, 1);	
	//	КонецЕсли; 
	//КонецЦикла; 
	
	
	// посимвольно переберем весь текст и найдем в нем строки, похожие на номера контейнеров:
	// 4-й символ должен быть "U" (грузовой контейнер), первые 3 символа - буквы, 
	// с 5 - 11 - должны быть цифры 
	ВыхТекст = СокрЛП(Текст);
	ДлСтр = СтрДлина(ВыхТекст);
	
	
	Если ТекстСодержитСписокНомеровКонтейнеров = 0 Тогда
		МассивЗначений = Новый Массив;
	
		Для ВедСимв = 4 по ДлСтр-7 цикл
			Если Сред(ВыхТекст, ВедСимв, 1) = "U" ИЛИ Сред(ВыхТекст, ВедСимв, 1) = "u" тогда
				Если (ЭтоЛатБуква(КодСимвола(ВыхТекст, ВедСимв - 1)) или ЭтоРусБуква(КодСимвола(ВыхТекст, ВедСимв - 1))) и
					(ЭтоЛатБуква(КодСимвола(ВыхТекст, ВедСимв - 2)) или ЭтоРусБуква(КодСимвола(ВыхТекст, ВедСимв - 2))) и
					(ЭтоЛатБуква(КодСимвола(ВыхТекст, ВедСимв - 3)) или ЭтоРусБуква(КодСимвола(ВыхТекст, ВедСимв - 3))) 
					Тогда
					Если ЭтоЦифра(КодСимвола(ВыхТекст, ВедСимв + 1)) и
						ЭтоЦифра(КодСимвола(ВыхТекст, ВедСимв + 2)) и
						ЭтоЦифра(КодСимвола(ВыхТекст, ВедСимв + 3)) и
						ЭтоЦифра(КодСимвола(ВыхТекст, ВедСимв + 4)) и
						ЭтоЦифра(КодСимвола(ВыхТекст, ВедСимв + 5)) и
						ЭтоЦифра(КодСимвола(ВыхТекст, ВедСимв + 6)) и
						ЭтоЦифра(КодСимвола(ВыхТекст, ВедСимв + 7)) 
						Тогда
						
						МассивЗначений.Добавить(ВРег(_СФ.стр_ЗаменитьСхожиеСимволыРусНаЛат(Сред(ВыхТекст, ВедСимв - 3, 11))));
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;	
		КонецЦикла;
		
	Иначе
		времТекст = Текст;
		
		//Меняем разделители
		мСимволыДляЗамены = Новый массив;
		мСимволыДляЗамены.Добавить(",");
		мСимволыДляЗамены.Добавить(" ");
		мСимволыДляЗамены.Добавить("|");
		мСимволыДляЗамены.Добавить("/");
		мСимволыДляЗамены.Добавить("\");
		мСимволыДляЗамены.Добавить(Символы.ПС);
		
		Для Каждого СимволЗамены из мСимволыДляЗамены Цикл
			времТекст = СтрЗаменить(времТекст,СимволЗамены,";");
		КонецЦикла;
		
		МассивЗначений = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(времТекст,";", Истина);
		
	КонецЕсли;
	
	Количество_НомераКонтейнеров 	= МассивЗначений.Количество();
	Количество_Грузоперевозки 		= 0;
	Количество_Отбор 				= 0;
	
	ДеревоГП.ПолучитьЭлементы().Очистить();
		
	Для Каждого ЗначениеМассива из МассивЗначений Цикл
		
		Нстр 					= ДеревоГП.ПолучитьЭлементы().Добавить();
		Нстр.НомерКонтейнера 	= ЗначениеМассива;
		Нстр.ЭтоГруппа 			= Истина;
		Нстр.Представление	 	= Нстр.НомерКонтейнера;
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("ОбъектСсылка", ОбъектСсылка);
		
		Запрос.Текст = "ВЫБРАТЬ
		               |	CW_Грузоперевозки.Ссылка КАК Ссылка,
		               |	CW_Грузоперевозки.ТипПеревозки КАК ТипПеревозки,
		               |	ЕСТЬNULL(CW_ЗначенияЛогистическихСтатусовОбъектов.ЛогистическийСтатус.СсылкаКартинки, """") КАК СсылкаКартинки
		               |ИЗ
		               |	Справочник.CW_Грузоперевозки КАК CW_Грузоперевозки
		               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.CW_ЗначенияЛогистическихСтатусовОбъектов КАК CW_ЗначенияЛогистическихСтатусовОбъектов
		               |		ПО CW_Грузоперевозки.Ссылка = CW_ЗначенияЛогистическихСтатусовОбъектов.ОбъектСтатуса
		               |ГДЕ
		               |	CW_Грузоперевозки.CW_Представление ПОДОБНО ""%#СтрокаПоиска#%""
		               |	И НЕ CW_Грузоперевозки.ПометкаУдаления
					   |	//УсловиеПоЗаказуЗаявке";
		
		Если ЗначениеЗаполнено(ОбъектСсылка) Тогда
			
			Если ТипЗнч(ОбъектСсылка) = Тип("СправочникСсылка.CW_Заказы") Тогда
				Запрос.Текст = СтрЗаменить(Запрос.Текст, "//УсловиеПоЗаказуЗаявке", "И CW_Грузоперевозки.Заказ = &ОбъектСсылка");	
			КонецЕсли;
			Если ТипЗнч(ОбъектСсылка) = Тип("СправочникСсылка.CW_Заявки") Тогда
				Запрос.Текст = СтрЗаменить(Запрос.Текст, "//УсловиеПоЗаказуЗаявке", "И CW_Грузоперевозки.Заявка = &ОбъектСсылка");	
			КонецЕсли;
			
		КонецЕсли;
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "#СтрокаПоиска#", ЗначениеМассива);
		
		
		РезультатЗапроса 	=  Запрос.Выполнить();
		Выборка  			= РезультатЗапроса.Выбрать();
			
		Пока Выборка.Следующий() Цикл
			
			
			СтрокаГП = Нстр.ПолучитьЭлементы().Добавить();
			СтрокаГП.ЭтоГруппа = Ложь;
			СтрокаГП.Грузоперевозка = Выборка.Ссылка;
			СтрокаГП.ТипПеревозки 	= Выборка.ТипПеревозки;
			СтрокаГП.Представление = Строка(СтрокаГП.Грузоперевозка);
			СтрокаГП.ИндексКартинки = 3;
			СтрокаГП.Пометка = Истина;
			СтрокаГП.ЕстьГрузоперевозки = Истина;
			СтрокаГП.АдресКартинки 		= Выборка.СсылкаКартинки;
			
			_сф.Инкремент(Количество_Грузоперевозки);
			_сф.Инкремент(Количество_Отбор);
			
		КонецЦикла; 
	
		
		// --- 
		// анализируем найденные г/п и устанавливаем индекс картинки: красный - г/п не найдены, зелёный - г/п одна, синий - г/п несколько
		КоличествоНайденных = Нстр.ПолучитьЭлементы().Количество();
		Если (КоличествоНайденных = 0) Тогда
			
			Нстр.ИндексКартинки = 0;
			Нстр.ЕстьГрузоперевозки = Ложь;
			
		ИначеЕсли (КоличествоНайденных = 1) Тогда 
			
			
			Нстр.ИндексКартинки = 1;
			Нстр.Представление =  Нстр.НомерКонтейнера + " ("+Строка(КоличествоНайденных)+")";
			Нстр.ЕстьГрузоперевозки = Истина;
			
		Иначе
			
			Нстр.ИндексКартинки = 2;
			Нстр.Представление =  Нстр.НомерКонтейнера + " ("+Строка(КоличествоНайденных)+")";
			Нстр.ЕстьГрузоперевозки = Истина;
			
		КонецЕсли; 
		Нстр.АдресКартинки = "";
		
	КонецЦикла;

	// --- 
КонецПроцедуры
 

&НаСервере
Функция ЭтоЛатБуква(Код);
	
	//A - 65	Z - 90	a - 97	z - 122	
	Если (Код >= 65 и Код <= 90) ИЛИ (Код >= 97 и Код <= 122) Тогда
		Возврат Истина
	Иначе
		Возврат Ложь
	КонецЕсли; 	
	
КонецФункции


// Выполняет проверку символа на принадлежность к русскому алфавиту
//
// Параметры
// ---------
//  <Код> (Число) - код символа в соответствии с кодировкой Unicode
//
// Возвращаемое значение
// ---------------------
//   <Истина> - символ принадлежит русскому алфавиту, <Ложь> - в противном случае
//
&НаСервере
Функция ЭтоРусБуква(Код);
	
	//A - 1040	Я - 1071	a - 1072	я - 1103	
	Если (Код >= 1040 и Код <= 1071) ИЛИ (Код >= 1072 и Код <= 1103) Тогда
		Возврат Истина
	Иначе
		Возврат Ложь
	КонецЕсли; 	
	
КонецФункции

&НаСервере
Функция ЭтоЦифра(Код)
	
	//0 - 48	9 - 57
	Если Код >= 48 и Код <= 57 Тогда
		Возврат Истина
	Иначе
		Возврат Ложь
	КонецЕсли; 	
	
КонецФункции

&НаКлиенте
Процедура кнОК(Команда)
	
	Если (ДеревоГП.ПолучитьЭлементы().Количество()=0) Тогда
		кнПолучитьКонтейнера(ЭтаФорма.Команды.Найти("кнПолучитьКонтейнера"));	
	КонецЕсли; 
	
	Рез =  _ПолучитьМассивГП();
	Если Рез.Количество() > 0 Тогда	
		
		Ответ = Новый Структура;
		Ответ.Вставить("НастройкиОтбора", Рез);
		Ответ.Вставить("УчестьОтбор", УчестьОтбор);
		Ответ.Вставить("УчестьСтатусы", УчестьСтатусы);
		ЭтаФорма.Закрыть(Ответ);
		
	Иначе
		
		ПОВ = Новый ОписаниеОповещения("ОбработкаВопросаПродолжения",ЭтотОбъект); 
		ПоказатьВопрос(ПОВ,"Контейнеры в тексте не найдены!" + Символы.ПС + "Продолжить редактирование?",  РежимДиалогаВопрос.ДаНет);
		
	КонецЕсли;	
	
КонецПроцедуры

&НаСервере
Функция _ПолучитьМассивГП()
	// --- 
	
	Рез = Новый Массив;
	Для Каждого Стр из ДеревоГП.ПолучитьЭлементы() Цикл
		Для каждого СтрГП Из Стр.ПолучитьЭлементы() Цикл
			Если СтрГП.Пометка Тогда
				Рез.Добавить(СтрГП.Грузоперевозка);
			КонецЕсли;	
		КонецЦикла; 
	КонецЦикла;
	
	Возврат(Рез);
	
	// --- 
КонецФункции
 

&НаКлиенте
Процедура ОбработкаВопросаПродолжения(Ответ, ДополнительныеПараметры) Экспорт
	// --- 
	
	Если Ответ = КодВозвратаДиалога.Нет Тогда
		ЭтаФорма.Закрыть();
	КонецЕсли;	
	
	// --- 
КонецПроцедуры
  

&НаКлиенте
Процедура кнОтмена(Команда)
	
	ЭтаФорма.Закрыть();
	
КонецПроцедуры

&НаКлиенте
Процедура ПараметрыОтбора(Команда)
	
	кнПолучитьКонтейнера(ЭтаФорма.Команды.Найти("кнПолучитьКонтейнера"));
	
КонецПроцедуры

