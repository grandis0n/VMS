КонецПроцедуры


&НаКлиенте
Процедура КомандаУстановитьПометкуУПоследнейГрузоперевозки(Команда)
	
	УстановитьЗначениеПометки(Ложь);
	_КомандаУстановитьПометкуУПоследнейГрузоперевозки();
	
КонецПроцедуры

// Отмечает среди найденных гр
//
// Параметры:
// ----------
//  <Параметр1>  - <Тип.Вид> - описание параметра
//  <Параметр2>  - <Тип.Вид> - <описание параметра>
//
&НаСервере 
Процедура _КомандаУстановитьПометкуУПоследнейГрузоперевозки()
Перем ТЗ;	
	
	// таблица значений для сортировки грузоперевозок
	ТЗ = Новый ТаблицаЗначений;
	ТЗ.Колонки.Добавить("КодГП");
	ТЗ.Колонки.Добавить("ДатаГП");
	ТЗ.Колонки.Добавить("ГП");
	
	// обход контейнеров
	Для каждого Стр Из ДеревоГП.ПолучитьЭлементы() Цикл
		
		// подготовим таблицу грузоперевозок для контейнера
		ТЗ.Очистить();
		Для каждого СтрГП Из Стр.ПолучитьЭлементы() Цикл
			НовСтр = ТЗ.Добавить();
			НовСтр.ГП = СтрГП.Грузоперевозка;
			НовСтр.КодГП = СтрГП.Грузоперевозка.Код;
			НовСтр.ДатаГП = СтрГП.Грузоперевозка.ДатаСделкиФ; 
		КонецЦикла; 
		
		// если для контейнера были найдены ГП, 
		// то найдем последнюю и поставим для нее флаг
		Если ТЗ.Количество() > 0 Тогда
			ТЗ.Сортировать("ДатаГП Убыв, КодГП Убыв");
			ТмпГП = ТЗ[0].ГП;
			
			// переберем грузоперевозки контейнера и поставим флаг на последней
			Для каждого СтрГП Из Стр.ПолучитьЭлементы() Цикл
				Если СтрГП.Грузоперевозка = ТмпГП Тогда
					СтрГП.Пометка = Истина;
					Количество_Отбор = Количество_Отбор + 1;
					Прервать;
				КонецЕсли;
			КонецЦикла; 
		КонецЕсли; // для контейнера найдены ГП 
	КонецЦикла; // обход контейнеров

КонецПроцедуры // _КомандаУстановитьПометкуУПоследнейГрузоперевозки()

&НаКлиенте
Процедура ТекстСодержитСписокНомеровКонтейнеровПриИзменении(Элемент)
	
	ЭлементыДерева = ДеревоГП.ПолучитьЭлементы() ;
	
	Если ЭлементыДерева.количество() > 0 Тогда
		ДеревоГП.ПолучитьЭлементы().Очистить();
	Конецесли;
	
	Если Не ПустаяСтрока(Текст) Тогда
		кнПолучитьКонтейнера(ЭтаФорма.Команды.Найти("кнПолучитьКонтейнера"));
	Конецесли;
	
	УстановитьЗаголовкиЭлементовФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура ТекстПриИзменении(Элемент)
	
	кнПолучитьКонтейнера(ЭтаФорма.Команды.Найти("кнПолучитьКонтейнера"));

КонецПроцедуры


&НаСервере
Процедура ВосстановитьСеансовуюНастройку()
	
	// пытаемся восстановить настройки
	Идентификатор = "CW_ЖурналГрузоперевозок_ОтборКонтейнеровПоТексту";
	СеансоваяНастройка = ХранилищеСистемныхНастроек.Загрузить(Идентификатор, "Сеансовая");
	Если СеансоваяНастройка <> Неопределено Тогда
		Попытка
			СеансоваяНастройка.Свойство("ТекстСодержитСписокНомеровКонтейнеров",ТекстСодержитСписокНомеровКонтейнеров);
		Исключение
		КонецПопытки; 
	КонецЕсли; 
	
КонецПроцедуры

&НаСервере
Процедура СохранитьСеансовуюНастройку()
	
	СтруктураНастройки = Новый Структура();
	СтруктураНастройки.Вставить("ТекстСодержитСписокНомеровКонтейнеров",ТекстСодержитСписокНомеровКонтейнеров);
	
	Идентификатор = "CW_ЖурналГрузоперевозок_ОтборКонтейнеровПоТексту";
	ХранилищеСистемныхНастроек.Сохранить(Идентификатор, "Сеансовая", СтруктураНастройки);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	
	Если не ЗавершениеРаботы Тогда
		СохранитьСеансовуюНастройку();
	КонецЕсли;
	
КонецПроцедуры

