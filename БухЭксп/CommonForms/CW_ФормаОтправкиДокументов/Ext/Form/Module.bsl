&НаСервереБезКонтекста
Функция ФамилияИОИзСтрокиФамилияИмяОтчество(строкаФамилияИмяОтчество) Экспорт 
	// Преобразует строку вида " Пупкин Василий Иванович" в "Пупкин В.И."
	
	стр = СокрЛП(строкаФамилияИмяОтчество);
	
	// удалим двойные пробелы
	Пока Найти(стр, "  ")>0 Цикл
		стр = СтрЗаменить(стр, "  ", " ");
	КонецЦикла;
	
	// разделим на [три] строки
	стр = СтрЗаменить(стр, " ", Символы.ПС);
	
	Фамилия  = СтрПолучитьСтроку(стр, 1);
	Имя      = "";
	Отчество = "";
	
	Если СтрЧислоСтрок(стр) >= 2 Тогда 
		Имя = СтрПолучитьСтроку(стр, 2);
	КонецЕсли;
	
	Если СтрЧислоСтрок(стр) >= 3 Тогда 
		Отчество = СтрПолучитьСтроку(стр, 3);
	КонецЕсли;
	
	ФамилияИО = ?(НЕ ПустаяСтрока(Фамилия), Фамилия + ?(НЕ ПустаяСтрока(Имя)," " + Лев(Имя,1) + "." + 
				?(НЕ ПустаяСтрока(Отчество) , 
				Лев(Отчество,1)+".", ""), ""), "");
	
	Возврат ФамилияИО;
	
КонецФункции

&НаКлиенте
Процедура ОтправитьОднимФайломПриИзменении(Элемент)
	
	Элементы.ГруппаИмяФайлаПакета.Видимость = ОтправитьОднимФайлом;
	
КонецПроцедуры

&НаКлиенте
Процедура СнятьВсеПечатныеФормы(Команда)
	СнятьУстановитьВсеПечатныеФормы(Ложь);
КонецПроцедуры

&НаКлиенте
Процедура УстановитьВсеПечатныеФормы(Команда)
	СнятьУстановитьВсеПечатныеФормы(Истина);
КонецПроцедуры

&НаКлиенте
Процедура СнятьУстановитьВсеПечатныеФормы(Флаг)
	
	Для Каждого СтрокаФорм из Формы Цикл
		СтрокаФорм.Отправлять = Флаг;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура СнятьВсеФайлы(Команда)
	
	СнятьВУстановитьВсеФайлыНаСервере(Ложь);
	РазвернутьВсеСтрокиДерева();
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьВсеФайлы(Команда)
	
	СнятьВУстановитьВсеФайлыНаСервере(Истина); 
	РазвернутьВсеСтрокиДерева();
	
КонецПроцедуры

&НаКлиенте
Процедура РазвернутьВсеСтрокиДерева()
	
	ЭлементыДерева = ДеревоФайлов.ПолучитьЭлементы();
	Если ЭлементыДерева.Количество() > 0 Тогда
		ИдентификаторСтроки = ЭлементыДерева[0].ПолучитьИдентификатор();
		Элементы.ДеревоФайлов.Развернуть(ИдентификаторСтроки, Истина);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура СнятьВУстановитьВсеФайлыНаСервере(Флаг)
	
	ТДерево = РеквизитФормыВЗначение("ДеревоФайлов");
	
	ПараметрыОтбора = Новый Структура("Группа", Ложь);
	мСтроки = ТДерево.Строки.НайтиСтроки(ПараметрыОтбора, Истина);
	
	Для Каждого СтрокаДерева из мСтроки Цикл
		СтрокаДерева.Пометка = Флаг;
	КонецЦикла;
	
	ЗначениеВРеквизитФормы(ТДерево, "ДеревоФайлов");
	
КонецПроцедуры


&НаКлиенте
Процедура УстановитьВсеШаблоны(Команда)
	СнятьУстановитьВсеШаблоны(Истина);
КонецПроцедуры

&НаКлиенте
Процедура СнятьВсеШаблоны(Команда)
	СнятьУстановитьВсеШаблоны(Ложь);
КонецПроцедуры

 &НаКлиенте
Процедура СнятьУстановитьВсеШаблоны(Флаг)
	
	Для Каждого СтрокаШаблонов из ШаблоныДокументов Цикл
		СтрокаШаблонов.Отправлять = Флаг;
	КонецЦикла;
	
КонецПроцедуры

 