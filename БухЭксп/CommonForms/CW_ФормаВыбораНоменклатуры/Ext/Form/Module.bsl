
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	РазрешитьПолучениеКоличестваУслугИзпараметраГрузоперевозки 	= ПолучитьФункциональнуюОпцию("CW_РазрешитьПолучениеКоличестваУслугИзпараметраГрузоперевозки");
	
	ПараметрыФункциональныхОпций = Новый Структура("CW_Пользователь", CW_Настройки.Пользователь());
	УстановитьПараметрыФункциональныхОпцийФормы(ПараметрыФункциональныхОпций);
	
	Если РазрешитьПолучениеКоличестваУслугИзпараметраГрузоперевозки Тогда
		Элементы.ПорядокПолученияКоличества.СписокВыбора.Вставить(0,0, "из параметра грузопереовзки");
	Иначе
		ПорядокПолученияКоличества = 1;
	КонецЕсли;
	
	ТипДокумента = Параметры.ТипДокумента;
	
	Если Параметры.Свойство("Договор") Тогда 
		Договор = Параметры.Договор;
	КонецЕсли;
	
	//Подсистема.УчетПриложенийДоговоров
	Если Параметры.Свойство("ПриложениеКДоговору") Тогда 
		ПриложениеКДоговору = Параметры.ПриложениеКДоговору;
	КонецЕсли;
	//Подсистема.УчетПриложенийДоговоров
	
	Параметры.Свойство("ДатаДокумента",ДатаДокумента);
	
	КаталогУслуг = Константы.CW_КаталогУслуг.Получить();
	
	// настройки пользователя
	структураНастройкиПользователя = CW_Настройки.ПолучитьНастройкиПользователя();    
	ПодставлятьСтавку         = структураНастройкиПользователя.ПодставлятьСтавкуНДС;
	ПодразделениеПользователя = структураНастройкиПользователя.ПодразделениеПользователя;
	
	мПорядокОтражения = Новый Массив;
	мПорядокОтражения.Добавить(ПредопределенноеЗначение("Перечисление.CW_ПорядокОтраженияДоходов.Перевыставление"));
	мПорядокОтражения.Добавить(ПредопределенноеЗначение("Перечисление.CW_ПорядокОтраженияЗатрат.Затраты"));
	
	Если ТипДокумента = "CW_РасходыПоГрузоперевозке" Тогда
		ПорядокОтраженияИмя = "ПорядокОтраженияРасходов";
	ИначеЕсли ТипДокумента = "CW_ДоходыПоГрузоперевозке" Тогда
		ПорядокОтраженияИмя = "ПорядокОтраженияДоходов";
	КонецЕсли; 
	
	// договор и его параметры
	Если ЗначениеЗаполнено(Договор) Тогда
		
		СтруктураПараметров = CW_Настройки.ПустаяСтруктураПолученияПараметровДоговора();
		СтруктураПараметров.Дата 	= ТекущаяДата();
		СтруктураПараметров.Договор = Договор;
		СтруктураПараметров.ПриложениеКДоговору = ПриложениеКДоговору;
		
		ПараметрыДоговора = CW_Настройки.ПолучитьПараметрыДоговора(СтруктураПараметров, "ОсновнойПорядокОтраженияРасходов;ОсновнойПорядокОтраженияДоходов");
		
		ОсновнойПорядокОтраженияРасходов	= ПараметрыДоговора.ОсновнойПорядокОтраженияРасходов;
		ОсновнойПорядокОтраженияДоходов  	= ПараметрыДоговора.ОсновнойПорядокОтраженияДоходов;

		Организация 						= Договор.Организация;
		
		//Ограничение списка услуг 
		ЕстьОграниченияНоменклатурыПоДоговору	= Договор.ОграничиватьНоменклатуру и ПолучитьФункциональнуюОпцию("CW_ОграничиватьУслугиПоДоговорам");
		ЕстьОграниченияНоменклатуры 			= ЕстьОграниченияНоменклатурыПоДоговору;
		
		Если ЕстьОграниченияНоменклатурыПоДоговору	Тогда
			АдресУслугПоДоговору	= _УФС.ОбновитьСписокУслугПоДоговору(ДатаДокумента, Договор, ЭтаФорма);
		КонецЕсли;
		
		НеОграничиватьУслугиПоПеревыставлению 	= Константы.CW_НеОграничиватьСписокУслугПриПеревыставленииЗатрат.Получить();   
		
		Если ЕстьОграниченияНоменклатуры и НеОграничиватьУслугиПоПеревыставлению Тогда
			Если ТипДокумента = "CW_РасходыПоГрузоперевозке" Тогда
				ЕстьОграниченияНоменклатуры = ОсновнойПорядокОтраженияРасходов <> ПредопределенноеЗначение("Перечисление.CW_ПорядокОтраженияЗатрат.Перевыставление");
			ИначеЕсли ТипДокумента = "CW_ДоходыПоГрузоперевозке" Тогда
				ЕстьОграниченияНоменклатуры = ОсновнойПорядокОтраженияДоходов <> ПредопределенноеЗначение("Перечисление.CW_ПорядокОтраженияДоходов.Перевыставление");
			КонецЕсли; 
		КонецЕсли;
		
		Если ЕстьОграниченияНоменклатуры Тогда
			УстанавливатьЦенуВЗависимостиОтГруза  	= ПолучитьФункциональнуюОпцию("CW_УстанавливатьЦенуВЗависимостиОтГруза");  
		КонецЕсли;
		
		СтруктураДанных = новый Структура;
		СтруктураДанных.Вставить("АдресУслугПоДоговору"			, АдресУслугПоДоговору);
		СтруктураДанных.Вставить("ЭлементФормы"					, Элементы.Номенклатура);
		СтруктураДанных.Вставить("ЕстьОграниченияПоСпискуУслуг"	, ЕстьОграниченияНоменклатуры);
		
		_УФС.УстановитьСписокУслуг(СтруктураДанных);
		//Ограничение списка услуг
	
	КонецЕсли;
 	
	Если ТипДокумента = "CW_РасходыПоГрузоперевозке" Тогда
		ИмяНастройки = "Расходы";
		РасходнаяСтатья = Истина;
		Элементы.ПорядокОтраженияРасходов.Видимость = Истина;
		Элементы.ПорядокОтраженияДоходов.Видимость = Ложь;
		ПорядокОтражения = ОсновнойПорядокОтраженияРасходов;
	ИначеЕсли ТипДокумента = "CW_ДоходыПоГрузоперевозке" Тогда
		ИмяНастройки = "Доходы";
		ДоходнаяСтатья = Истина;
		Элементы.ПорядокОтраженияРасходов.Видимость = Ложь;
		Элементы.ПорядокОтраженияДоходов.Видимость = Истина;
		ПорядокОтражения = ОсновнойПорядокОтраженияДоходов;
	КонецЕсли;  
	

	
	// настройки уч.политики организации
	Если ЗначениеЗаполнено(Организация) Тогда
		ПараметрыУчетнойПолитики = CW_Настройки.ПараметрыУчетнойПолитики(ТекущаяДата(), Организация);
		ОсновнаяСтатьяЗатрат   = ПараметрыУчетнойПолитики.ОсновнаяСтатьяЗатрат;
		ОсновнойСпособУчетаНДС = ПараметрыУчетнойПолитики.ОсновнойСпособУчетаНДС;
	КонецЕсли;
	
	Если Параметры.Свойство("РаздельныйУчетВходящегоНДС") Тогда 
		РаздельныйУчетВходящегоНДС = Параметры.РаздельныйУчетВходящегоНДС;
	Иначе 
		РаздельныйУчетВходящегоНДС = Ложь;
	КонецЕсли;
	
	Если Параметры.Свойство("ГруппировкаЗатратПоПодразделениям") Тогда 
		ГруппировкаЗатратПоПодразделениям = Параметры.ГруппировкаЗатратПоПодразделениям;
	Иначе 
		ГруппировкаЗатратПоПодразделениям = Ложь;
	КонецЕсли;

	Элементы.Подразделение.Видимость = Ложь;
	
	Валюта = Параметры.Валюта;
	
	СтавкаНДСПриРеализации = УчетНДСКлиентСервер.СтавкаНДСПриРеализации(ДатаДокумента, Организация);
	
	// читаем параметры из сеансовой настройки
	Настройки = _УФС.ЗагрузитьСеансовыеНастройки(ЭтаФорма,"Сеансовая_"+ИмяНастройки);
	ПоУмолчанию = Истина;
	Если Настройки <> Неопределено Тогда
		Попытка
			// читаем
			СеансовыйПорядокОтраженияДоходов 	= Настройки.ПорядокОтраженияДоходов;
			СеансовыйПорядокОтраженияРасходов 	= Настройки.ПорядокОтраженияРасходов;
			// --- 
			ВариантПредставления 		= Настройки.ВариантПредставления;
			Представление 				= Настройки.Представление;
			ВариантОпределенияСуммы 	= Настройки.ВариантОпределенияСуммы;
			СуммаВключаетНДС 			= Настройки.СуммаВключаетНДС;
			ВариантРаспределения 		= Настройки.ВариантРаспределения;
			ПараметрРаспределения 		= Настройки.ПараметрРаспределения;
			
			Если РазрешитьПолучениеКоличестваУслугИзпараметраГрузоперевозки Тогда
				ПорядокПолученияКоличества  = Настройки.ПорядокПолученияКоличества;
			КонецЕсли;
			
			Настройки.Свойство("РазделитьКоличествоУслугНаКоличествоГрузоперевозок",РазделитьКоличествоУслугНаКоличествоГрузоперевозок);
			Настройки.Свойство("РаспределитьКоличествоПророрциональноПараметру",РаспределитьКоличествоПророрциональноПараметру);
			
			// ---------------------------------------------------------------------------- 
			ПоУмолчанию = Ложь;
			
		Исключение
			//ОписаниеОшибки()
		КонецПопытки; 
		
	КонецЕсли;
	
	Если ПоУмолчанию Тогда
		
		ПорядокОтраженияРасходов = Перечисления.CW_ПорядокОтраженияЗатрат.Затраты;
		ПорядокОтраженияДоходов = Перечисления.CW_ПорядокОтраженияДоходов.СобственнаяУслуга;
		// --- 
		ВариантПредставления 	= 0;
		СуммаВключаетНДС 		= Истина;
		ПараметрРаспределения 	= ПланыВидовХарактеристик.CW_ПараметрыГрузоперевозок.ПустаяСсылка();
		
		ВариантРаспределения 	= 1;

		ВариантОпределенияСуммы = 1;
		Если ЕстьОграниченияНоменклатуры Тогда
			ВариантОпределенияСуммы = 0;
		КонецЕсли;
		
	КонецЕсли; 
	

	
	Если (ЗначениеЗаполнено(ПорядокОтражения)) Тогда
		Если (ТипДокумента = "CW_РасходыПоГрузоперевозке") Тогда
			ПорядокОтраженияРасходов = ПорядокОтражения;
		Иначе
			ПорядокОтраженияДоходов = ПорядокОтражения;
		КонецЕсли; 
		
	Иначе
		Если (ЗначениеЗаполнено(СеансовыйПорядокОтраженияДоходов)) Тогда
			ПорядокОтраженияДоходов = СеансовыйПорядокОтраженияДоходов;
		Иначе
			ПорядокОтраженияДоходов=Перечисления.CW_ПорядокОтраженияДоходов.СобственнаяУслуга;
		КонецЕсли; 
		Если (ЗначениеЗаполнено(СеансовыйПорядокОтраженияРасходов)) Тогда
			ПорядокОтраженияРасходов = СеансовыйПорядокОтраженияРасходов;
		Иначе
			ПорядокОтраженияРасходов=Перечисления.CW_ПорядокОтраженияЗатрат.Затраты;
		КонецЕсли; 
		
	КонецЕсли; 
	
	_ПредставлениеПараметраРаспределения();
	
	// --- 
	
	Количество = 1;
	
	// --- 
	ПеревыставлениеПоСтавкам = ПолучитьФункциональнуюОпцию("CW_ИспользованиеСхемыПеревыставленияПоСтавкам");
	
	Элементы.СтавкаНДС.Доступность = CW_ПраваДоступа.ПравоДоступно("РедактированиеСтавкиНДС");
	
	Элементы.ПорядокОтраженияДоходов.РежимВыбораИзСписка=Истина;
	Элементы.ПорядокОтраженияДоходов.ОтображениеКнопкиВыбора = ОтображениеКнопкиВыбора.ОтображатьВПолеВвода;
	Элементы.ПорядокОтраженияДоходов.ИсторияВыбораПриВводе=ИсторияВыбораПриВводе.НеИспользовать;
	// --- 
	Элементы.ПорядокОтраженияДоходов.СписокВыбора.Очистить();
	Элементы.ПорядокОтраженияДоходов.СписокВыбора.Добавить(Перечисления.CW_ПорядокОтраженияДоходов.СобственнаяУслуга);
	Элементы.ПорядокОтраженияДоходов.СписокВыбора.Добавить(Перечисления.CW_ПорядокОтраженияДоходов.Перевыставление);
	Элементы.ПорядокОтраженияДоходов.СписокВыбора.Добавить(Перечисления.CW_ПорядокОтраженияДоходов.ПрочиеДоходы);
	// --- 
	Если (ПеревыставлениеПоСтавкам) Тогда
		Элементы.ПорядокОтраженияДоходов.СписокВыбора.Добавить(Перечисления.CW_ПорядокОтраженияДоходов.ПеревыставлениеПоСтавкам);
	КонецЕсли; 
	
	// --- 
	Элементы.ПорядокОтраженияРасходов.РежимВыбораИзСписка=Истина;
	Элементы.ПорядокОтраженияРасходов.ОтображениеКнопкиВыбора = ОтображениеКнопкиВыбора.ОтображатьВПолеВвода;
	Элементы.ПорядокОтраженияРасходов.ИсторияВыбораПриВводе=ИсторияВыбораПриВводе.НеИспользовать;
	// --- 
	Элементы.ПорядокОтраженияРасходов.СписокВыбора.Очистить();
	Элементы.ПорядокОтраженияРасходов.СписокВыбора.Добавить(Перечисления.CW_ПорядокОтраженияЗатрат.Затраты);
	Элементы.ПорядокОтраженияРасходов.СписокВыбора.Добавить(Перечисления.CW_ПорядокОтраженияЗатрат.Перевыставление);
	Элементы.ПорядокОтраженияРасходов.СписокВыбора.Добавить(Перечисления.CW_ПорядокОтраженияЗатрат.ПрочиеРасходы);
	// --- 
	Если (ПеревыставлениеПоСтавкам) Тогда
		Элементы.ПорядокОтраженияРасходов.СписокВыбора.Добавить(Перечисления.CW_ПорядокОтраженияЗатрат.ПеревыставлениеПоСтавкам);
	КонецЕсли; 
	// --- 
	
	//Элементы.ГруппаПараметрыРасходов.Видимость = (РасходнаяСтатья);
	Элементы.СпособУчетаНДС.Видимость = Ложь;
	Если (РасходнаяСтатья) Тогда
		Элементы.СпособУчетаНДС.Доступность = (РаздельныйУчетВходящегоНДС И CW_ПраваДоступа.ПравоДоступно("РедактированиеСпособаУчетаНДС"));
		Если (Элементы.СпособУчетаНДС.Видимость) Тогда
			СпособУчетаНДС = ОсновнойСпособУчетаНДС;
		КонецЕсли; 
	КонецЕсли; 
	
	Элементы.Подразделение.Видимость = Ложь;
	Если (РасходнаяСтатья) Тогда
		// если по организации ведется учет затрат по подразделениям
		Если ГруппировкаЗатратПоПодразделениям Тогда 
			Если ЗначениеЗаполнено(ПодразделениеПользователя) Тогда 
				Подразделение = ПодразделениеПользователя;
			Иначе 
				Подразделение = ПараметрыУчетнойПолитики.ОсновноеПодразделение;
			КонецЕсли;
			Элементы.Подразделение.Видимость = Истина;
		КонецЕсли;
	КонецЕсли;
	
	// --- 
	
	МассивИсключаемыхРеквизитов = Новый Массив;
	МассивИсключаемыхРеквизитов.Добавить("Номенклатура");
	_УФС.ОтключитьИсториюВыбораЭлементовФормы(ЭтаФорма,МассивИсключаемыхРеквизитов);
	_УправлениеЭлементамиФормами();
	
	ЗаполнитьПараметрыФормулы();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПараметрыФормулы()

	ШаблонФормулы = "[ЦенаУслуги] [Валюта] х [Количество] [ЕдиницаИзмерения] = [Сумма] [Валюта]";
	
	ВалютаДоговора = Строка(Договор.ВалютаДоговора);
	
	ЦенаУслуги 			= 0;
	ЕдиницаИзмерения	= "";
	тКоличество 		= 1;
	
	ЕстьОграниченияНоменклатуры = ПолучитьНаличиеОграниченийПоНоменклатуре();
	
	Если ЕстьОграниченияНоменклатуры и ЗначениеЗаполнено(Номенклатура) Тогда
		
		СтруктураПараметров = Новый Структура;
		СтруктураПараметров.Вставить("АдресУслугПоДоговору"						, АдресУслугПоДоговору);
		СтруктураПараметров.Вставить("УстанавливатьЦенуВЗависимостиОтГруза"		, Ложь);
		СтруктураПараметров.Вставить("УстанавливатьЦенуВЗависимостиОтКлиента"	, Ложь);
		
		СтруктураПараметров.Вставить("Номенклатура"								, Номенклатура);
			
		УслугаДоговора = _УФС.ПолучитьУслугуДоговораПоПараметрам(СтруктураПараметров);		
		
		Если УслугаДоговора <> Неопределено Тогда 				   
			ЦенаУслуги		= УслугаДоговора.ЦенаБезНДС;
			
			Если ТипЗнч(УслугаДоговора.ПорядокОтражения) = Тип("ПеречислениеСсылка.CW_ПорядокОтраженияДоходов") Тогда
				ПорядокОтраженияДоходов = УслугаДоговора.ПорядокОтражения;
			ИначеЕсли ТипЗнч(УслугаДоговора.ПорядокОтражения) = Тип("ПеречислениеСсылка.CW_ПорядокОтраженияЗатрат") Тогда
				ПорядокОтраженияРасходов = УслугаДоговора.ПорядокОтражения;
			КонецЕсли;				
				
		КонецЕсли; 
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Номенклатура) Тогда
		ЕдиницаИзмерения = Строка(Номенклатура.ЕдиницаИзмерения);	
	КонецЕсли;
	
	Если ПорядокПолученияКоличества = 1 тогда
		тКоличество = Количество;
	Конецесли;
	
	Сумма =  ЦенаУслуги * тКоличество;
	
	ПараметрыФормулы = Новый Структура;
	ПараметрыФормулы.Вставить("Валюта"			, ВалютаДоговора);
	ПараметрыФормулы.Вставить("ЦенаУслуги"		, ?(ЦенаУслуги=0, "{Цена за услугу}", Формат(ЦенаУслуги,"ЧДЦ=2"))+?(УстанавливатьЦенуВЗависимостиОтГруза,"*",""));
	ПараметрыФормулы.Вставить("ЕдиницаИзмерения", ?(ЗначениеЗаполнено(ЕдиницаИзмерения),"("+ЕдиницаИзмерения+")", ""));
	ПараметрыФормулы.Вставить("Количество"		, Формат(тКоличество,"ЧДЦ=3"));
	ПараметрыФормулы.Вставить("Сумма"		    , Формат(Сумма,"ЧДЦ=2"));
	
	
	Для Каждого ПараметрФормулы  из ПараметрыФормулы Цикл
		ШаблонФормулы = СтрЗаменить(ШаблонФормулы, "["+ПараметрФормулы.Ключ+"]", ПараметрФормулы.Значение);
	КонецЦикла;
	
	Элементы.ФормулаПолученияСуммы.Заголовок =  ШаблонФормулы;
	
	
КонецПроцедуры
