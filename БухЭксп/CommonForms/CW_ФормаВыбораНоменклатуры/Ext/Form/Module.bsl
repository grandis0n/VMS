&НаКлиенте
Процедура КомандаЗаполнить(Команда)
	
	Если (ЭтаФорма.ТекущийЭлемент=Элементы.Всего И Всего=0) Тогда
		ЭтаФорма.ТекущийЭлемент = Элементы.СуммаВключаетНДС;
	КонецЕсли; 
	
	// проверяем заполнение  
	Если Не ПроверитьЗаполнение() Тогда
		Возврат;	
	КонецЕсли;
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("Номенклатура",			Номенклатура);
	СтруктураПараметров.Вставить("СтатьяЗатрат",			СтатьяЗатрат);
	СтруктураПараметров.Вставить("ВариантПредставления",	ВариантПредставления);
	СтруктураПараметров.Вставить("Представление",			Представление);
	СтруктураПараметров.Вставить("Количество",				Количество);
	СтруктураПараметров.Вставить("СтавкаНДС",				СтавкаНДС);
	СтруктураПараметров.Вставить("ВариантОпределенияСуммы",	ВариантОпределенияСуммы);
	СтруктураПараметров.Вставить("Всего",					Всего);
	СтруктураПараметров.Вставить("СуммаВключаетНДС",		СуммаВключаетНДС);  
	СтруктураПараметров.Вставить("Цена",					Цена);
	СтруктураПараметров.Вставить("ЦенаВключаетНДС",			ЦенаВключаетНДС);  
	
	Если РасходнаяСтатья Тогда
		СтруктураПараметров.Вставить("ПорядокОтраженияРасходов",	ПорядокОтраженияРасходов);	
		СтруктураПараметров.Вставить("СпособУчетаНДС",				СпособУчетаНДС);
		СтруктураПараметров.Вставить("Подразделение", 				Подразделение);
		СтруктураПараметров.Вставить("ОпределениеВыручки",			ОпределениеВыручки);
		СтруктураПараметров.Вставить("УчитыватьСуммыНеактированныхСчетов",	УчитыватьСуммыНеактированныхСчетов);
	КонецЕсли; 
	
	Если ДоходнаяСтатья Тогда
		СтруктураПараметров.Вставить("ПорядокОтраженияДоходов",	ПорядокОтраженияДоходов);	
	КонецЕсли; 
	
	СтруктураПараметров.Вставить("ВариантРаспределения",	ВариантРаспределения);
	СтруктураПараметров.Вставить("ПараметрРаспределения",	ПараметрРаспределения);
	СтруктураПараметров.Вставить("РазделитьКоличествоУслугНаКоличествоГрузоперевозок",	РазделитьКоличествоУслугНаКоличествоГрузоперевозок);
	СтруктураПараметров.Вставить("РаспределитьКоличествоПророрциональноПараметру",		РаспределитьКоличествоПророрциональноПараметру);
	СтруктураПараметров.Вставить("ПорядокПолученияКоличества", ПорядокПолученияКоличества);
	
	ЭтаФорма.Закрыть(СтруктураПараметров);
	
КонецПроцедуры  

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)   
	
	Если РасходнаяСтатья Тогда  
		ПроверяемыеРеквизиты.Удалить(ПроверяемыеРеквизиты.Найти("ПорядокОтраженияДоходов"));
	КонецЕсли;
	Если ДоходнаяСтатья Тогда  
		ПроверяемыеРеквизиты.Удалить(ПроверяемыеРеквизиты.Найти("ПорядокОтраженияРасходов"));
	КонецЕсли;
	
	Если ВариантРаспределения <> 2 Тогда 
		ПроверяемыеРеквизиты.Удалить(ПроверяемыеРеквизиты.Найти("ПараметрРаспределения"));
	КонецЕсли; 
	
КонецПроцедуры



