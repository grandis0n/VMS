	// --- 
КонецПроцедуры
  

&НаКлиенте
Процедура ПорядокОтраженияРасходовПриИзменении(Элемент)
	
	Если ПорядокОтраженияРасходов.Пустая() Тогда
		ПорядокОтраженияРасходов = ПредопределенноеЗначение("Перечисление.CW_ПорядокОтраженияЗатрат.Затраты");
		Если ЗначениеЗаполнено(Номенклатура) Тогда
			СтруктураПараметров = ПодготовитьСтруктуруПараметровПолученияСпособаУчетаНДС();
			СпособУчетаНДС 		= CW_Финансы.ПолучитьСпособУчетаНДС(СтруктураПараметров);
		КонецЕсли; 
	ИначеЕсли ПорядокОтраженияРасходов = ПредопределенноеЗначение("Перечисление.CW_ПорядокОтраженияЗатрат.Перевыставление") ИЛИ ПорядокОтраженияРасходов = ПредопределенноеЗначение("Перечисление.CW_ПорядокОтраженияЗатрат.ПеревыставлениеПоСтавкам") Тогда
		СпособУчетаНДС = ПредопределенноеЗначение("Перечисление.CW_ПорядокОтраженияЗатрат.ПустаяСсылка");
	ИначеЕсли ПорядокОтраженияРасходов = ПредопределенноеЗначение("Перечисление.CW_ПорядокОтраженияЗатрат.Затраты") Тогда
		СтруктураПараметров = ПодготовитьСтруктуруПараметровПолученияСпособаУчетаНДС();
		СпособУчетаНДС 		= CW_Финансы.ПолучитьСпособУчетаНДС(СтруктураПараметров);
	КонецЕсли;           
	
	ПорядокОтраженияРасходовПриИзмененииНаСервере();
	
	_УправлениеЭлементамиФормами();
	
КонецПроцедуры
   
&НаСервере
Процедура ПорядокОтраженияРасходовПриИзмененииНаСервере()
	
	Если Не ЗначениеЗаполнено(Договор) Тогда
		Возврат;
	КонецЕсли;
	
	ЕстьОграниченияНоменклатуры = ПолучитьНаличиеОграниченийПоНоменклатуре();
	
	СтруктураДанных = новый Структура;
	СтруктураДанных.Вставить("АдресУслугПоДоговору"			, АдресУслугПоДоговору);
	СтруктураДанных.Вставить("ЭлементФормы"					, Элементы.Номенклатура);
	СтруктураДанных.Вставить("ЕстьОграниченияПоСпискуУслуг"	, ЕстьОграниченияНоменклатуры);
	
	_УФС.УстановитьСписокУслуг(СтруктураДанных);
	
КонецПроцедуры


&НаКлиенте
Функция ПодготовитьСтруктуруПараметровПолученияСпособаУчетаНДС()
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("Дата"					, ТекущаяДата());
	СтруктураПараметров.Вставить("Организация"			, Организация);
	СтруктураПараметров.Вставить("Номенклатура"			, Номенклатура);
	СтруктураПараметров.Вставить("НоменклатурнаяГруппа"	, ПолучитьНоменклатурнуюГруппу(Номенклатура));
	
	Возврат СтруктураПараметров;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьНоменклатурнуюГруппу(Номенклатура)
	
	Возврат  Номенклатура.НоменклатурнаяГруппа;
	
КонецФункции

