	Настройки.Вставить("СуммаВключаетНДС"			, СуммаВключаетНДС);
	Настройки.Вставить("ВариантРаспределения"		, ВариантРаспределения);
	Настройки.Вставить("ПараметрРаспределения"		, ПараметрРаспределения);
	Настройки.Вставить("ПорядокПолученияКоличества"	, ПорядокПолученияКоличества);
	
	Настройки.Вставить("РазделитьКоличествоУслугНаКоличествоГрузоперевозок",РазделитьКоличествоУслугНаКоличествоГрузоперевозок);
	Настройки.Вставить("РаспределитьКоличествоПророрциональноПараметру",РаспределитьКоличествоПророрциональноПараметру);
