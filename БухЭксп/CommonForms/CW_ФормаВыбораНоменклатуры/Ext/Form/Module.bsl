&НаКлиенте
Процедура ВариантОпределенияСуммыПриИзменении(Элемент)
	
	Если ВариантОпределенияСуммы=0 Тогда
		
		Если (ВариантРаспределения = 2) Тогда
			ВариантРаспределения = 1;
			РаспределитьКоличествоПророрциональноПараметру = Ложь;
		КонецЕсли; 
		
	КонецЕсли; 
	
	Если ВариантОпределенияСуммы = 2 Тогда
		ВариантРаспределения = 1;
	КонецЕсли;
	
	// --- 
	_УправлениеЭлементамиФормами();
	ЗаполнитьПараметрыФормулы();
	
КонецПроцедуры

&НаКлиенте
Процедура ВариантРаспределенияПриИзменении(Элемент)
	
	Если (ВариантОпределенияСуммы = 0 И ВариантРаспределения = 2) Тогда
		ВариантРаспределения = 1;
		_УФК.ВывестиПредупреждение("Распределение по значению параметра для данного режима определения цены недоступно.");
	КонецЕсли; 
	Если (ВариантРаспределения <> 2) Тогда
		РаспределитьКоличествоПророрциональноПараметру = Ложь;
	КонецЕсли; 
	_УправлениеЭлементамиФормами();
	
КонецПроцедуры

