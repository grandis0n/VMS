&НаСервере
Процедура _СохранитьСеансовуюНастройку()
	// --- 
	
	Настройки = Новый Структура;
	// --- 
	Настройки.Вставить("ПорядокОтраженияДоходов",ПорядокОтраженияДоходов);
	Настройки.Вставить("ПорядокОтраженияРасходов",ПорядокОтраженияРасходов);
