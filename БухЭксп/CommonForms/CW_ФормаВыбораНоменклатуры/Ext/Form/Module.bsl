&НаКлиенте
Процедура НоменклатураНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)

	ЕстьОграниченияНоменклатуры = ПолучитьНаличиеОграниченийПоНоменклатуре();
	
	Если ЕстьОграниченияНоменклатуры И Элемент.СписокВыбора.Количество() = 0 Тогда
		СтандартнаяОбработка = Ложь;
		
		Сообщение = новый СообщениеПользователю;
		Сообщение.Текст   		= "Не определен список услуг по договору!";
		Сообщение.Сообщить();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НоменклатураПриИзменении(Элемент)

	ЕстьОграниченияНоменклатуры = ПолучитьНаличиеОграниченийПоНоменклатуре();
	
	Если ПодставлятьСтавку = Неопределено Тогда
		ПодставлятьСтавку = Ложь;
	КонецЕсли;   
	
	ПН = _ПараметрыНоменклатуры(Номенклатура, ЕстьОграниченияНоменклатуры, АдресУслугПоДоговору, ТипДокумента, Организация, Договор, ДатаДокумента, ПодставлятьСтавку);
	
	_УстановитьСтатьюЗатрат();
	
	Если ЗначениеЗаполнено(Номенклатура) И Элементы.ПорядокОтраженияРасходов.Видимость  Тогда
		СтруктураПараметров = ПодготовитьСтруктуруПараметровПолученияСпособаУчетаНДС();
		СпособУчетаНДС 		= CW_Финансы.ПолучитьСпособУчетаНДС(СтруктураПараметров);
	КонецЕсли;	
	
	Если ЗначениеЗаполнено(ПН.ПорядокОтражения) Тогда
		Если Типзнч(ПН.ПорядокОтражения) = Тип("ПеречислениеСсылка.CW_ПорядокОтраженияДоходов") Тогда
			ПорядокОтраженияДоходов = ПН.ПорядокОтражения;
		Иначе
			ПорядокОтраженияРасходов = ПН.ПорядокОтражения;
		КонецЕсли;
	КонецЕсли;
	
	Представление = ПН.Представление;
	
	// ставка НДС подставляется в зависимости от настройки пользователя
	СтавкаНДС = ПН.СтавкаНДС;                  
	
	//Дополним параметры формулы
	ЗаполнитьПараметрыФормулы();
	
КонецПроцедуры

&НаСервере
Процедура _УстановитьСтатьюЗатрат()
	// --- 
	
	// пробуем найти в регистре
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	CW_СтатьиЗатратНоменклатуры.СтатьяЗатрат
	|ИЗ
	|	РегистрСведений.CW_СтатьиЗатратНоменклатуры КАК CW_СтатьиЗатратНоменклатуры
	|ГДЕ
	|	CW_СтатьиЗатратНоменклатуры.Номенклатура = &Номенклатура";
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	ТЗ = Запрос.Выполнить().Выгрузить();
	СтрокаСтатьяЗатрат = _сф.к_ПервыйЭлемент(ТЗ);
	Если (СтрокаСтатьяЗатрат <> Неопределено) Тогда
		
		СтатьяЗатрат = СтрокаСтатьяЗатрат.СтатьяЗатрат;
		
	Иначе
		
		СтатьяЗатрат = ОсновнаяСтатьяЗатрат;
		
	КонецЕсли; 
	
	// --- 
КонецПроцедуры
 

&НаСервереБезКонтекста
Функция _ПараметрыНоменклатуры(Номенклатура, ЕстьОграниченияНоменклатуры, АдресУслугПоДоговору, ТипДокумента, Организация, Договор, ДатаДокумента, ПодставлятьСтавку)
	
	ПН = Новый Структура("СтатьяЗатрат,Представление,СтавкаНДС,ПорядокОтражения");
	ПН.СтатьяЗатрат 	= Номенклатура.СтатьяЗатрат;
	ПН.Представление 	= Номенклатура.НаименованиеПолное; 
	
	ПараметрыСтавкиНДС = Новый Структура;
	ПараметрыСтавкиНДС.Вставить("Дата", 		ДатаДокумента);
	ПараметрыСтавкиНДС.Вставить("Организация", 	Организация);
	ПараметрыСтавкиНДС.Вставить("Номенклатура", Номенклатура); 
	ПараметрыСтавкиНДС.Вставить("Договор", 		Договор); 
	ПараметрыСтавкиНДС.Вставить("ПодставлятьСтавкуНДС", ПодставлятьСтавку); 

	Если ТипДокумента = "CW_ДоходыПоГрузоперевозке" Тогда
		ПараметрыСтавкиНДС.Вставить("ТипДвижения", "ДОХОДЫ");
	Иначе
		ПараметрыСтавкиНДС.Вставить("ТипДвижения", "РАСХОДЫ");
	КонецЕсли;   
	
	ПН.СтавкаНДС = CW_Документы.ПолучитьСтавкуНДС(ПараметрыСтавкиНДС);
	
	Если ЕстьОграниченияНоменклатуры Тогда
		Если ЭтоАдресВременногоХранилища(АдресУслугПоДоговору) Тогда
			
			СтруктураПараметров = Новый Структура;
			СтруктураПараметров.Вставить("АдресУслугПоДоговору"						, АдресУслугПоДоговору);
			СтруктураПараметров.Вставить("УстанавливатьЦенуВЗависимостиОтГруза"		, Ложь);
			СтруктураПараметров.Вставить("УстанавливатьЦенуВЗависимостиОтКлиента"	, Ложь);
			
			СтруктураПараметров.Вставить("Номенклатура"								, Номенклатура);
			
			УслугаДоговора = _УФС.ПолучитьУслугуДоговораПоПараметрам(СтруктураПараметров);
			
			Если УслугаДоговора <> Неопределено Тогда 				   
				ПН.СтавкаНДС			= УслугаДоговора.СтавкаНДС;
				ПН.ПорядокОтражения		= УслугаДоговора.ПорядокОтражения;
			КонецЕсли; 
		КонецЕсли;		
	КонецЕсли;
	
	Возврат(ПН);

КонецФункции

