	Если ПараметрРаспределения.Пустая() Тогда
		
		ПредставлениеПараметраРаспределения = "< ... >";
		
	Иначе
		
		ПредставлениеПараметраРаспределения = Строка(ПараметрРаспределения);
		
	КонецЕсли; 
	
