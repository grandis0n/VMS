&НаСервере
Процедура _УправлениеЭлементамиФормами()
	// --- 
	
	Элементы.ГруппаПроизвольноеПредставление.Видимость = (ВариантПредставления = 1);
	// --- 
	Элементы.ГруппаФиксированнаяСумма.Видимость = (ВариантОпределенияСуммы = 1);
	// --- 
	Элементы.ГруппаРаспределениеСуммы.Видимость = (ВариантРаспределения = 2);
	// --- 
	Элементы.РаспределитьКоличествоПророрциональноПараметру.Видимость = (ВариантРаспределения = 2);
	//Элементы.ВариантРаспределения.Доступность = (НЕ ВариантОпределенияСуммы = 0);
	//Элементы.РазделитьКоличествоУслугНаКоличествоГрузоперевозок.Видимость = (ВариантРаспределения = 0);
	
	Элементы.ГруппаПараметрыВыручки.Видимость = (ВариантРаспределения = 3);
	Элементы.УчитыватьСуммыНеактированныхСчетов.Видимость = (ОпределениеВыручки = 1);
	
	Элементы.СпособУчетаНДС.Видимость = Элементы.СпособУчетаНДС.Доступность И РасходнаяСтатья И ПорядокОтраженияРасходов = Перечисления.CW_ПорядокОтраженияЗатрат.Затраты;
	
	Элементы.Количество.Видимость 						= ПорядокПолученияКоличества = 1;
	Элементы.ГруппаРаспределениеКоличества.Видимость 	= ПорядокПолученияКоличества = 1;
	
	ЕстьОграниченияНоменклатуры = ПолучитьНаличиеОграниченийПоНоменклатуре();
	Если ЕстьОграниченияНоменклатуры Тогда
		Элементы.ГруппаРаспределение.Видимость = ВариантОпределенияСуммы <> 0;
	КонецЕсли;    
	
	Элементы.ГруппаРаспределение.Доступность = ВариантОпределенияСуммы <> 2;	
	
	
	Элементы.Группа4.Видимость = ВариантОпределенияСуммы = 2;
	
	//Элементы.ФормулаПолученияСуммы.Видимость = ВариантОпределенияСуммы = 0;
	
	//Элементы.КомментарийКФормуле.Видимость = УстанавливатьЦенуВЗависимостиОтГруза;
	
КонецПроцедуры
 
