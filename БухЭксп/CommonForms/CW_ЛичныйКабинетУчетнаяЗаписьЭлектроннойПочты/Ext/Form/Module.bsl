
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ДанныеУчетнойЗаписи = Новый ФиксированнаяСтруктура(Параметры.ПараметрыУчетнойЗаписи);
	ДанныеУчетнойЗаписи.Свойство("name",			Наименование);
	ДанныеУчетнойЗаписи.Свойство("user",			ПользовательSMTP);
	ДанныеУчетнойЗаписи.Свойство("password",		ПарольSMTP);
	ДанныеУчетнойЗаписи.Свойство("server",			АдресСервераSMTP);
	ДанныеУчетнойЗаписи.Свойство("port",			ПортSMTP);
	ДанныеУчетнойЗаписи.Свойство("authentication",	АутентификацияSMTP);
	ДанныеУчетнойЗаписи.Свойство("ssl",				ИспользоватьSSLSMTP);  
	
	Если ПустаяСтрока(АутентификацияSMTP) Тогда
		АутентификацияSMTP = "ПоУмолчанию";
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПарольSMTPНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)

	ПолеПароляНачалоВыбора(Элемент, ПарольSMTP, СтандартнаяОбработка);

КонецПроцедуры

&НаКлиенте
Процедура ПолеПароляНачалоВыбора(Элемент, Реквизит, СтандартнаяОбработка) Экспорт
	
	СтандартнаяОбработка = Ложь;
	Реквизит = Элемент.ТекстРедактирования;
	Элемент.РежимПароля = Не Элемент.РежимПароля;
	Если Элемент.РежимПароля Тогда
		Элемент.КартинкаКнопкиВыбора = БиблиотекаКартинок.ВводимыеСимволыВидны;
	Иначе
		Элемент.КартинкаКнопкиВыбора = БиблиотекаКартинок.ВводимыеСимволыСкрыты;
	КонецЕсли;
	
КонецПроцедуры


&НаКлиенте
Процедура Записать(Команда)

	Если Не ПроверитьЗаполнение() Тогда
		Возврат;
	КонецЕсли;   
	
	Модифицированность = Ложь;
	
	Ответ =	СохранитьУчетнуюЗапись(); 
	Если Ответ.КодСостояния = 200 Тогда   
		ПоказатьОповещениеПользователя("Личный кабинет клиента",,"Учетная запись сохранена");
		ЭтаФорма.Закрыть(ДанныеУчетнойЗаписи);
	Иначе
		ПоказатьПредупреждение(,Ответ.Тело,,"Личный кабинет клиента"); 
	КонецЕсли;  
	
КонецПроцедуры  

&НаКлиенте
Функция СохранитьУчетнуюЗапись() 

	КодСостояния = CW_РаботаСВнешнимиРесурсамиСервер.ПроверитьПодключениеНаСервере();
	Если КодСостояния <> 200 Тогда
		ОписаниеКодовСостояний = CW_ОбщийМодульЛичныйКабинетКлиентСервер.ПолучитьОписаниеКодовСостояний();
		
		Ответ = Новый Структура;
		Ответ.Вставить("КодСостояния", 	КодСостояния);	
		Ответ.Вставить("Тело",			"Ошибка подклчюения! Код: "+Строка(КодСостояния)+" - " + ОписаниеКодовСостояний.Получить(КодСостояния));	
		Возврат Ответ;
	КонецЕсли;  
	
	Возврат СохранитьУчетнуюЗаписьНаСервере();
	
КонецФункции 

&НаСервере
Функция СохранитьУчетнуюЗаписьНаСервере()  
	
	ЗаписатьДанныеУчетнойЗаписиНаСервере(); 

	РегистрационныйНомер 	= CW_ПроверкаЛицензии.ПолучитьРегистрационныйНомер();
	УчетнаяЗаписьJSON 		= CW_РаботаСВнешнимиРесурсамиСервер.ОбъектВСтрокуJSON(Новый Структура(ДанныеУчетнойЗаписи));
	
	СтруктураJSON = Новый Структура;
	СтруктураJSON.Вставить("regnumber",		XMLСтрока(РегистрационныйНомер));
	СтруктураJSON.Вставить("mailaccount",	УчетнаяЗаписьJSON);
	
	ПараметрыHTTPЗапроса = CW_РаботаСВнешнимиРесурсамиСервер.ПодготовитьHTTPЗапрос("lkk_saveaccount", СтруктураJSON);
	HTTPОтвет 	= CW_РаботаСВнешнимиРесурсамиСервер.ПолучитьДанныеССервера(ПараметрыHTTPЗапроса.HTTPСоединение, ПараметрыHTTPЗапроса.HTTPЗапрос, "POST"); 
	Если HTTPОтвет = Неопределено Тогда
		Ответ = Новый Структура;
		Ответ.Вставить("КодСостояния", 	533);	
		Ответ.Вставить("Тело",			"Отсутствует инетрен-соединение");	
		Возврат Ответ;
	КонецЕсли;  
	
	Если HTTPОтвет.КодСостояния = 200 Тогда
		Результат = CW_РаботаСВнешнимиРесурсамиСервер.ПрочитатьHTTPСервисВОбъект(HTTPОтвет);	
		
		ПараметрыУчетнойЗаписи = Новый Структура(ДанныеУчетнойЗаписи);
		ПараметрыУчетнойЗаписи.Вставить("uid",				Результат.uid);
		ДанныеУчетнойЗаписи = Новый ФиксированнаяСтруктура(ПараметрыУчетнойЗаписи);
		
		Ответ = Новый Структура;
		Ответ.Вставить("КодСостояния", 	HTTPОтвет.КодСостояния);	
		Ответ.Вставить("Тело",			"");	
	Иначе
		Ответ = Новый Структура;
		Ответ.Вставить("КодСостояния", 	HTTPОтвет.КодСостояния);	
		Ответ.Вставить("Тело",			HTTPОтвет.ПолучитьТелоКакСтроку());	
	КонецЕсли;
	
	Возврат Ответ;
	
КонецФункции


&НаСервере
Процедура ЗаписатьДанныеУчетнойЗаписиНаСервере()  
	
	ПараметрыУчетнойЗаписи = Новый Структура(ДанныеУчетнойЗаписи);
	ПараметрыУчетнойЗаписи.Вставить("name",				Наименование);
	ПараметрыУчетнойЗаписи.Вставить("user",				ПользовательSMTP);
	ПараметрыУчетнойЗаписи.Вставить("password",			ПарольSMTP);
	ПараметрыУчетнойЗаписи.Вставить("server",			АдресСервераSMTP);
	ПараметрыУчетнойЗаписи.Вставить("port",				ПортSMTP);
	ПараметрыУчетнойЗаписи.Вставить("authentication",	АутентификацияSMTP);
	ПараметрыУчетнойЗаписи.Вставить("ssl",				ИспользоватьSSLSMTP);
	ПараметрыУчетнойЗаписи.Вставить("protected",		ИспользоватьSSLSMTP);
	
	ДанныеУчетнойЗаписи = Новый ФиксированнаяСтруктура(ПараметрыУчетнойЗаписи);
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьНастройки(Команда)  
	
	Если Не ПроверитьЗаполнение() Тогда
		Возврат;
	КонецЕсли;

	КодСостояния = CW_РаботаСВнешнимиРесурсамиСервер.ПроверитьПодключениеНаСервере();
	Если КодСостояния <> 200 Тогда
		ОписаниеКодовСостояний = CW_ОбщийМодульЛичныйКабинетКлиентСервер.ПолучитьОписаниеКодовСостояний();
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Ошибка подклчюения! Код: "+Строка(КодСостояния)+" - " + ОписаниеКодовСостояний.Получить(КодСостояния);
		Сообщение.Сообщить();
		
		ПоказатьПредупреждение(,"Не удалось подключиться к сервису");
		Возврат;
	КонецЕсли;    
	
	Оповещение = новый ОписаниеОповещения("ПослеВводаАдресаПолучателя", ЭтотОбъект);
	
	ПоказатьВводСтроки(Оповещение, ДанныеУчетнойЗаписи.user,"Введите адрес электроной почты"); 
	
КонецПроцедуры  

&НаКлиенте
Процедура ПослеВводаАдресаПолучателя(Строка, ДополнительныеПараметры) Экспорт
	
	Если Строка = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Ответ = ПроверитьНастройкиНаСервере(Строка); 
	Если Ответ.КодСостояния = 200 Тогда   
		ПоказатьОповещениеПользователя("Учетная запись электронной почты",,"Письмо отправлено");
	Иначе
		ПоказатьПредупреждение(,Ответ.Тело,,"Ошибка"); 
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПроверитьНастройкиНаСервере(Получатель)
	
	ЗаписатьДанныеУчетнойЗаписиНаСервере();  

	РегистрационныйНомер 	= CW_ПроверкаЛицензии.ПолучитьРегистрационныйНомер();
	УчетнаяЗаписьJSON 		= CW_РаботаСВнешнимиРесурсамиСервер.ОбъектВСтрокуJSON(Новый Структура(ДанныеУчетнойЗаписи));
	
	СтруктураJSON = Новый Структура;
	СтруктураJSON.Вставить("regnumber",		XMLСтрока(РегистрационныйНомер));
	СтруктураJSON.Вставить("mailaccount",	УчетнаяЗаписьJSON);
	СтруктураJSON.Вставить("recipient",		XMLСтрока(Получатель));
	
	ПараметрыHTTPЗапроса = CW_РаботаСВнешнимиРесурсамиСервер.ПодготовитьHTTPЗапрос("lkk_testmail", СтруктураJSON);
	HTTPОтвет 	= CW_РаботаСВнешнимиРесурсамиСервер.ПолучитьДанныеССервера(ПараметрыHTTPЗапроса.HTTPСоединение, ПараметрыHTTPЗапроса.HTTPЗапрос, "GET"); 
	Если HTTPОтвет = Неопределено Тогда
		Ответ = Новый Структура;
		Ответ.Вставить("КодСостояния", 	533);	
		Ответ.Вставить("Тело",			"Отсутствует инетрен-соединение");	
		Возврат Ответ;
	КонецЕсли;
	
	Ответ = Новый Структура;
	Ответ.Вставить("КодСостояния", 	HTTPОтвет.КодСостояния);	
	Ответ.Вставить("Тело",			HTTPОтвет.ПолучитьТелоКакСтроку());	
	
	Возврат Ответ;
	
КонецФункции
