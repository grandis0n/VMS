&НаКлиенте
Процедура ТаблицаСортировкиПередУдалением(Элемент, Отказ)
	
	// находим соответствие в списке колонок и меняем порядок сортировки
	_ОбработатьУдалениеСтрокиТаблицыСортировки(Элемент.ТекущаяСтрока);	
	
КонецПроцедуры

&НаСервере
Процедура _ОбработатьУдалениеСтрокиТаблицыСортировки(Идентификатор)
	// --- 
	
	СтрокаТаблицысортировки = ТаблицаСортировки.НайтиПоИдентификатору(Идентификатор);
	СтрокаСортировки = _сф.к_НайтиСтроку(ОписаниеКолонок,"СтрокаПоляКомпоновки",СтрокаТаблицысортировки.СтрокаПоляКомпоновки);
	Если СтрокаСортировки <> Неопределено Тогда
		
		СтрокаСортировки.Сортировка = Перечисления.CW_ПорядокСортировки.Нет;
		СтрокаСортировки.ИндексСортировки = 0;
		
	КонецЕсли; 
	
	// --- 
КонецПроцедуры

&НаКлиенте
Процедура Заполнить(Команда)
	
	Если ОписаниеКолонок.Количество() > 0 Тогда
		
		СоответствиеПредставлений = ПолучитьЗаголовкиФОрмыПоИмениОбъкта();
		
		мДанныеФормы = СтрРазделить(ЭтотОбъект.ИмяФормыИсточника,".",ложь);
		
		ПредставлениеЗаголовкаФормы = СоответствиеПредставлений.Получить(мДанныеФормы[1]);
		ПредставлениеЗаголовкаФормы = ?(ПредставлениеЗаголовкаФормы=Неопределено, "Журнал", ПредставлениеЗаголовкаФормы);
		
		ПОВ = Новый ОписаниеОповещения("ОбработкаВопросаОчисткиКолонокПриЗаполнении",ЭтотОбъект); 
		ПоказатьВопрос(ПОВ,"Текущие колоноки журнала будут удалены." + Символы.ПС + "Продолжить?", РежимДиалогаВопрос.ДаНет, , , ПредставлениеЗаголовкаФормы);
		
	Иначе
		
		_Заполнить();		
		
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьЗаголовкиФОрмыПоИмениОбъкта()
	
	Результат = Новый Соответствие;
	Результат.Вставить("CW_ЖурналЗаказов",			"Журнал заказов");
	Результат.Вставить("CW_ЖурналГрузоперевозок", 	"Журнал грузоперевозок");
	Результат.Вставить("CW_ЖурналЗаявок", 			"Журнал заявок");
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ОбработкаВопросаОчисткиКолонокПриЗаполнении(Ответ, ДополнительныеПараметры) Экспорт
	// --- 
	
	Если (Ответ = КодВозвратаДиалога.Да) Тогда
		_Заполнить();
	КонецЕсли;
	
	// --- 
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПоТипуПеревозки(Команда)
	
	Если ОписаниеКолонок.Количество() > 0 Тогда
		ПОВ = Новый ОписаниеОповещения("ОбработкаВопросаОчисткиКолонокПриЗаполненииПоТипуПараметра",ЭтотОбъект); 
		ПоказатьВопрос(ПОВ,"Текущие колоноки журнала будут удалены." + Символы.ПС + "Продолжить?", РежимДиалогаВопрос.ДаНет, , , "Журнал грузоперевозок");
	Иначе
		
		ПродолжитьЗаполнениеСпискаКолонок();
		
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВопросаОчисткиКолонокПриЗаполненииПоТипуПараметра(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		ПродолжитьЗаполнениеСпискаКолонок();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПродолжитьЗаполнениеСпискаКолонок()
	
	Если ЭтоАдресВременногоХранилища(АдресСпискаТиповПеревозок) Тогда
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("АдресСпискаЗначений"	, АдресСпискаТиповПеревозок);
		ПараметрыФормы.Вставить("СписокСПометками"		, Ложь);
		ПараметрыФормы.Вставить("ЗаголовокФормы"		, "Выберите тип перевозки");
		
		ОписаниеОповещения = новый ОписаниеОповещения("ПослеЗакрытияФормыВыбораСпискаПараметров", ЭтаФорма);
		
		ОткрытьФорму("ОбщаяФорма.CW_ФормаВыбораИзСписка",ПараметрыФормы, ЭтаФорма,,,,ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
	КонецЕсли;
	
КонецПроцедуры


&НаКлиенте
Процедура ПослеЗакрытияФормыВыбораСпискаПараметров(Ответ, ДополнительныеПараметры) Экспорт
	
	Если ЗначениеЗаполнено(Ответ) и ЭтоАдресВременногоХранилища(Ответ) Тогда
		СтукрутаОтвета = ПолучитьИзВременногоХранилища(Ответ);
		_Заполнить(СтукрутаОтвета.Значение); 
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура _Заполнить(ТипПеревозки = Неопределено)
	
	ОписаниеКолонок.Очистить();

	мДанныеФормы 		= СтрРазделить(ЭтотОбъект.ИмяФормыИсточника,".",ложь);
	ПолноеИмяОбъекта 	= мДанныеФормы[0]+"."+мДанныеФормы[1];
	
	МенеджерОбъекта = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени(ПолноеИмяОбъекта);
	Результат = МенеджерОбъекта.ЗаполнитьНастройкиКолонок(ТипПеревозки);
	
	Для Каждого СтруктураВМассиве из Результат Цикл
		Статус = _ОбработатьВыборПоля(СтруктураВМассиве);
		Если Статус.Код <> 0 Тогда
			Сообщить(Статус.ОписаниеОшибки);
		КонецЕсли; 
	КонецЦикла;	
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьВидимость(Команда)
	
	_УстановитьВидимостьВсех(Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура СнятьВидимость(Команда)
	
	_УстановитьВидимостьВсех(Ложь);
	
КонецПроцедуры
 

&НаСервере
Процедура _УстановитьВидимостьВсех(Признак)
	// --- 
	
	Для каждого Стр Из ОписаниеКолонок Цикл
		
		Если (Стр.Видимость <> Признак) Тогда
			
			Стр.Видимость = Признак;
			_ВидимостьПриИзмененииДляСтроки(Стр);
			
		КонецЕсли; 
		
	КонецЦикла; 
	
	// --- 
КонецПроцедуры

&НаКлиенте
Процедура ОписаниеКолонокФорматНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	// --- 
	Попытка
		
		Конструктор = Новый КонструкторФорматнойСтроки;
		Конструктор.Текст = Элементы.ОписаниеКолонок.ТекущиеДанные.Формат;
		СтрокаТипа = _СтрокаТипа(Элементы.ОписаниеКолонок.ТекущаяСтрока);
		Конструктор.ДоступныеТипы = Новый ОписаниеТипов(СтрокаТипа); 
		// --- 
		ПОВ = Новый ОписаниеОповещения("ОбработкаИзмененияФорматаКолонки",ЭтотОбъект); 
		Конструктор.Показать(ПОВ);
		
	Исключение
		_УФК.ВывестиПредупреждение("Формат вывода доступен только для примитивных типов.");
	КонецПопытки; 
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаИзмененияФорматаКолонки(НовыйТекст, ДополнительныеПараметры) Экспорт 
	// --- 
	
	Если (НовыйТекст <> Неопределено) Тогда
		
		Элементы.ОписаниеКолонок.ТекущиеДанные.Формат = НовыйТекст;
		
	КонецЕсли; 
	
	// --- 
КонецПроцедуры
  
 
&НаСервере
Функция _СтрокаТипа(Идентификатор)
	// --- 
	
	СтрокаОписания  = ОписаниеКолонок.НайтиПоИдентификатору(Идентификатор);
	Возврат(Строка(СтрокаОписания.ТипЗначения));	
	
	// --- 
КонецФункции

 


