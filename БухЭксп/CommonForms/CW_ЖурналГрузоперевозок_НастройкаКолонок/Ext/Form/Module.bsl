&НаСервере
Процедура _ВидимостьПриИзмененииДляСтроки(СтрокаКолонки)
	// --- 
	
	СтрокаСортировки = _сф.к_НайтиСтроку(ТаблицаСортировки,"СтрокаПоляКомпоновки",СтрокаКолонки.СтрокаПоляКомпоновки);
	Если СтрокаКолонки.Видимость = Истина Тогда
		
		// добавляем в сортировку
		Если СтрокаКолонки.Сортировка <> Перечисления.CW_ПорядокСортировки.Нет Тогда
			
			Нстр = ТаблицаСортировки.Добавить();
			ЗаполнитьЗначенияСвойств(Нстр,СтрокаКолонки);
			
		КонецЕсли; 
				
	Иначе
		
		// удаляем из таблицы сортировки
		Если СтрокаСортировки <> Неопределено Тогда
			
			ТаблицаСортировки.Удалить(СтрокаСортировки.ПолучитьИдентификатор());
			
		КонецЕсли; 
		
	КонецЕсли; 
	
	// --- 
