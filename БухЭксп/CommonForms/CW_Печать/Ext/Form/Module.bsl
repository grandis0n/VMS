&НаКлиенте
Процедура КоличествоПлюс(Команда)
	
	ТД = Элементы.ДеревоПФ.ТекущиеДанные;
	Если (ТД <> Неопределено) Тогда
		
		Если (НЕ ТД.Группа) Тогда
			
			ТД.Количество = ТД.Количество+1;
			ПриИзмененииКоличества();
			
		КонецЕсли; 
		
	КонецЕсли; 
	
КонецПроцедуры


&НаКлиенте
Процедура КоличествоМинус(Команда)
	
	ТД = Элементы.ДеревоПФ.ТекущиеДанные;
	Если (ТД <> Неопределено) Тогда
		
		Если (НЕ ТД.Группа) Тогда
			
			Если (ТД.Количество > 0) Тогда
				
				ТД.Количество = ТД.Количество-1;
				ПриИзмененииКоличества();
				
			КонецЕсли; 
			
		КонецЕсли; 
		
	КонецЕсли;
	
КонецПроцедуры


&НаКлиенте
Процедура ДеревоПФКоличествоЭкземпляровПриИзменении(Элемент)
	
	ПриИзмененииКоличества();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииКоличества()
	// --- 
	
	ТД = Элементы.ДеревоПФ.ТекущиеДанные;
	// --- 
	Если (ТД.Количество = 0 И ТД.Печать <> 0) Тогда
		
		ТД.Печать = 0;
		ОбновитьФлаги();
		
	ИначеЕсли (ТД.Количество <> 0 И ТД.Печать = 0) Тогда 
		
		ТД.Печать = 1;
		ОбновитьФлаги();
		
	КонецЕсли; 
	
	// --- 
КонецПроцедуры

&НаКлиенте
Процедура ДеревоПФФлагПечатиПриИзменении(Элемент)
	
	ТД = Элементы.ДеревоПФ.ТекущиеДанные;
	Если (ТД.Печать = 2) Тогда
		ТД.Печать = 0;
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Функция ОбновитьФлаги()
	// --- 
	
	ТД = Элементы.ДеревоПФ.ТекущиеДанные;
	// --- 
	
	УстановитьФлагРодителя(ТД);
	Если (ТД.Группа) Тогда
		УстановитьФлагиСтрок(ТД,ТД.Печать);
	КонецЕсли; 
	
	// --- 
КонецФункции

&НаКлиенте
Процедура УстановитьФлагРодителя(СтрокаДерева) Экспорт
	
	СтрокаРодитель = СтрокаДерева.ПолучитьРодителя();
	Если СтрокаРодитель = Неопределено Тогда
		
		Возврат;
		
	КонецЕсли;
	
	// --- 
	
	ЕстьИстина = Ложь;
	ЕстьЛожь = Ложь;
	
	Для каждого Стр Из СтрокаРодитель.ПолучитьЭлементы() Цикл
		
		Если Стр.Печать = 1 Тогда
			
			ЕстьИстина = Истина;
			
		КонецЕсли;
		
		Если Стр.Печать = 0 Тогда
			
			ЕстьЛожь = Истина;
			
		КонецЕсли;
		
		Если Стр.Печать = 2 Тогда
			
			ЕстьИстина = Истина;
			ЕстьЛожь = Истина;
			
		КонецЕсли;
		
	КонецЦикла;
	
	// --- 
	
	Если ЕстьИстина И ЕстьЛожь Тогда
		
		СтрокаРодитель.Печать = 2;
		
	ИначеЕсли ЕстьИстина И НЕ ЕстьЛожь Тогда
		
		СтрокаРодитель.Печать = 1;
		
	ИначеЕсли НЕ ЕстьИстина И ЕстьЛожь Тогда
		
		СтрокаРодитель.Печать = 0;
		
	КонецЕсли;
	
	УстановитьФлагРодителя(СтрокаРодитель);
	
КонецПроцедуры // УстановитьФлагРодителя()

&НаКлиенте
Процедура УстановитьФлагиСтрок(СтрокаДерева,Значение) Экспорт
	
	Для каждого Стр Из СтрокаДерева.ПолучитьЭлементы() Цикл
		
		Стр.Печать = Значение;
		УстановитьФлагиСтрок(Стр, Значение);
		
	КонецЦикла;
	
КонецПроцедуры

