#Область ВыводПодписиИПечатиВДокументах

&НаКлиенте
Процедура ПодписьИПечатьПриИзменении(Элемент)
	
	ЭлементыДерева = ДеревоПФ.ПолучитьЭлементы();
	
	Если Не ДеревоСписок Тогда
		Индекс = ЭлементыДерева.Индекс(Элементы.ДеревоПФ.ТекущиеДанные);
	Иначе
		ТекущийРодитель = Элементы.ДеревоПФ.ТекущиеДанные.ПолучитьРодителя();
		Если ТекущийРодитель = Неопределено Тогда
			Возврат;
		КонецЕсли;
		
		ИндексРодителя 	= ЭлементыДерева.Индекс(ТекущийРодитель);
		
		ЭлементыРодителя = ТекущийРодитель.ПолучитьЭлементы();
		Индекс 			 = ЭлементыРодителя.Индекс(Элементы.ДеревоПФ.ТекущиеДанные);
	КонецЕсли;
	
	ОбработатьИзменениеФлагаНаСервере();
	
	Если Не ДеревоСписок Тогда
		Элементы.ДеревоПФ.ТекущаяСтрока = ДеревоПФ.ПолучитьЭлементы()[Индекс].ПолучитьИдентификатор();
	Иначе
		РодительТекущейСтроки 			= ДеревоПФ.ПолучитьЭлементы()[ИндексРодителя];
		Элементы.ДеревоПФ.ТекущаяСтрока = РодительТекущейСтроки.ПолучитьЭлементы()[Индекс].ПолучитьИдентификатор();
		РазвернутьСтроки();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбработатьИзменениеФлагаНаСервере()
	
	Если ЭтоПакетнаяПечать Тогда
		
		мОбъектыПечати 	= Новый Массив;
		
		мСсылки = СписокОбъектовПечати.ВыгрузитьЗначения();
		МассивИменМетаданных	= CW_Печать.ПолучитьМассивИменМетеданных(мСсылки);
		
		СсылкаВМассиве  = мСсылки[0];
		Если ТипЗнч(СсылкаВМассиве)= Тип("ДокументСсылка.CW_ОтчетЭкспедитора") Тогда
			//Дополняем метаданые связанных документов
			Запрос = Новый Запрос;
			Запрос.Текст = "ВЫБРАТЬ
			|	CW_ДокументыОтчетаЭкспедитора.ОтчетЭкспедитора КАК ОтчетЭкспедитора,
			|	CW_ДокументыОтчетаЭкспедитора.СвязанныйДокумент КАК СвязанныйДокумент
			|ИЗ
			|	РегистрСведений.CW_ДокументыОтчетаЭкспедитора КАК CW_ДокументыОтчетаЭкспедитора
			|ГДЕ
			|	CW_ДокументыОтчетаЭкспедитора.ОтчетЭкспедитора В(&ОтчетыЭкспедитора)
			|	И CW_ДокументыОтчетаЭкспедитора.СвязанныйДокумент.Проведен
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	CW_ОтчетЭкспедитораДокументыВознаграждения.Ссылка,
			|	CW_ОтчетЭкспедитораДокументыВознаграждения.Документ
			|ИЗ
			|	Документ.CW_ОтчетЭкспедитора.ДокументыВознаграждения КАК CW_ОтчетЭкспедитораДокументыВознаграждения
			|ГДЕ
			|	CW_ОтчетЭкспедитораДокументыВознаграждения.Ссылка В(&ОтчетыЭкспедитора)
			|	И CW_ОтчетЭкспедитораДокументыВознаграждения.Документ.Проведен
			|
			|УПОРЯДОЧИТЬ ПО
			|	СвязанныйДокумент УБЫВ
			|ИТОГИ ПО
			|	ОтчетЭкспедитора
			|АВТОУПОРЯДОЧИВАНИЕ";
			
			Запрос.УстановитьПараметр("ОтчетыЭкспедитора", мСсылки);
			
			РезультатЗапроса = Запрос.Выполнить();
			
			ВыборкаОтчетЭкспедитора = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			Пока  ВыборкаОтчетЭкспедитора.Следующий() Цикл
				
				мСвязанныеДокументы = Новый Массив;
				
				ВыборкаДетали = ВыборкаОтчетЭкспедитора.Выбрать();
				Пока ВыборкаДетали.Следующий() Цикл
					мСвязанныеДокументы.Добавить(ВыборкаДетали.СвязанныйДокумент);
				КонецЦикла;
				
				ОбъектПечати = Новый Структура;
				ОбъектПечати.Вставить("Ссылка", 			ВыборкаОтчетЭкспедитора.ОтчетЭкспедитора);
				ОбъектПечати.Вставить("СвязанныеДокументы", мСвязанныеДокументы);
				
				мОбъектыПечати.Добавить(ОбъектПечати);
				
			КонецЦикла;
			
		Иначе
			Для Каждого Ссылка из мСсылки Цикл
				ОбъектПечати = Новый Структура;
				ОбъектПечати.Вставить("Ссылка", 			Ссылка);
				
				мОбъектыПечати.Добавить(ОбъектПечати);
			КонецЦикла;
		Конецесли;
		
		ПараметрыПакетнойПечати = Новый Структура;
		ПараметрыПакетнойПечати.Вставить("ОбъектыПечати", 			мОбъектыПечати);
		ПараметрыПакетнойПечати.Вставить("МассивИменМетаданных", 	МассивИменМетаданных);
		
		ПараметрыПечати = CW_Печать.ПолучитьПараметрыФормыПакетнойПечати(ПараметрыПакетнойПечати,УникальныйИдентификатор, СписокПечатныхФорм, ПодписьИПечать) ;
	Иначе
		ПараметрыПечати = CW_Печать.ПолучитьПараметрыФормыПечати(СписокОбъектовПечати.ВыгрузитьЗначения(),УникальныйИдентификатор, ПодписьИПечать);
	КонецЕсли;
	
	Если (_УФКС.ВыполненоУспешно(ПараметрыПечати)) Тогда
		ДеревоПФ.ПолучитьЭлементы().Очистить();
		ОбновитьДанныеФормы(ПараметрыПечати.ПФ);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти


