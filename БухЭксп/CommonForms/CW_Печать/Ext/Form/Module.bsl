&НаКлиенте
Функция ПолучитьФорматыПакета()
	
	СписокВыбораФормата = Новый СписокЗначений;
	СписокВыбораФормата.Добавить(ТипФайлаПакетаОтображаемыхДокументов.PDF	,"Документ PDF(*.pdf)"				,,БиблиотекаКартинок.CW_ДокументPDF);
	СписокВыбораФормата.Добавить(ТипФайлаПакетаОтображаемыхДокументов.XLS	,"Лист Excel (*.xls)"				,,БиблиотекаКартинок.CW_Excel);
	СписокВыбораФормата.Добавить(ТипФайлаПакетаОтображаемыхДокументов.XLSX	,"Лист Excel 2007-... (*.xlsx)"		,,БиблиотекаКартинок.CW_Excel);
	СписокВыбораФормата.Добавить(ТипФайлаПакетаОтображаемыхДокументов.ODS	,"Электронная таблица ODF (*.ods)"	,,БиблиотекаКартинок.CW_Excel);
	СписокВыбораФормата.Добавить(ТипФайлаПакетаОтображаемыхДокументов.DOCX	,"Документ Word (*.docx)"			,,БиблиотекаКартинок.CW_ДокументWord);
	
	СписокВыбораФормата.Добавить(ТипФайлаПакетаОтображаемыхДокументов.HTML4	,"Документ HTML 4 (*.htm)"			,,БиблиотекаКартинок.ФорматHTML);
	СписокВыбораФормата.Добавить(ТипФайлаПакетаОтображаемыхДокументов.HTML5	,"Документ HTML 5 (*.htm)"			,,БиблиотекаКартинок.ФорматHTML);
	
	Возврат СписокВыбораФормата;
	
КонецФункции

