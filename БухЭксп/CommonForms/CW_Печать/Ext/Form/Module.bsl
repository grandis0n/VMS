&НаКлиенте
Процедура СохранитьКак(Команда)   
	
	СтрокаТекущая = Элементы.ДеревоПФ.ТекущаяСтрока;
	ИмяФайлаБезРасширения = ПолучитьИмяФайлаБезРасширения(СтрокаТекущая);
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ИмяФормата", 	"MXL");          
	ПараметрыФормы.Вставить("ВключитьXLSX",	Истина);  
	ПараметрыФормы.Вставить("ИмяФайла",		ИмяФайлаБезРасширения);  
	
	ОткрытьФорму("ОбщаяФорма.CW_СохранениеДокумента", ПараметрыФормы, ЭтаФорма);
	
КонецПроцедуры

 &НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	Если ВРег(ИсточникВыбора.ИмяФормы) = ВРег("ОбщаяФорма.CW_СохранениеДокумента") Тогда
		
		ТекущаяСтрока = Элементы.ДеревоПФ.ТекущаяСтрока;

		Если ВыбранноеЗначение <> Неопределено 
			И ВыбранноеЗначение <> КодВозвратаДиалога.Отмена Тогда
			
			Если ВыбранноеЗначение.ВариантСохранения = "СохранитьВПапку" Тогда
				СохранитьФайлыВКаталог(ВыбранноеЗначение);
			Иначе
				ЗаписатьФайлыНаСервере(ВыбранноеЗначение, ТекущаяСтрока);
				Оповестить("ОбновитьНаличиеПрикрепленныхФайлов");
				Состояние(НСтр("ru= 'Сохранение успешно завершено.'"));
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПакетСохранитьКак(Команда)
	
	СписокВыбораФормата = ПолучитьФорматыТабличногоДоумента();
	
	ПараметрыСохранения = новый Структура;
	ПараметрыСохранения.Вставить("РежимПакет",	Истина);
	ПараметрыСохранения.Вставить("ОдинФайл",	Ложь);
	ПараметрыСохранения.Вставить("СписокВыбораФормата", СписокВыбораФормата);
	
	ПродолжитьСохранениеДокумента(ПараметрыСохранения);
	
КонецПроцедуры

&НаКлиенте
Процедура ПакетСохранитьКакОдинФайл(Команда)
	
	СписокВыбораФормата = ПолучитьФорматыПакета();
	
	ПараметрыСохранения = новый Структура;
	ПараметрыСохранения.Вставить("ОдинФайл", 	Истина);
	ПараметрыСохранения.Вставить("РежимПакет",	Истина);
	ПараметрыСохранения.Вставить("СписокВыбораФормата", СписокВыбораФормата);
	
	ПродолжитьСохранениеДокумента(ПараметрыСохранения);
	
КонецПроцедуры


&НаКлиенте
Процедура ПродолжитьСохранениеДокумента(ПараметрыСохранения)
	
	МассивПараметровСохраняемыхФайлов = ПолучитьМассивПараметровСохраняемыхФайлов(ПараметрыСохранения.РежимПакет);
	
	Если МассивПараметровСохраняемыхФайлов.Количество() = 0 Тогда
		ПоказатьПредупреждение(,"Нет данных для сохранения!");
		Возврат;	
	КонецЕсли;
	
	Если ПараметрыСохранения.РежимПакет Тогда
		Если ПараметрыСохранения.ОдинФайл Тогда
			Режим =	РежимДиалогаВыбораФайла.Сохранение;
		Иначе
			Режим =	РежимДиалогаВыбораФайла.ВыборКаталога;
		КонецЕсли;
	Иначе
		Режим =	РежимДиалогаВыбораФайла.Сохранение;
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Режим"				, Режим);
	ДополнительныеПараметры.Вставить("ОдинФайл"				, ПараметрыСохранения.ОдинФайл);
	ДополнительныеПараметры.Вставить("ДанныеДляСохранения"  , МассивПараметровСохраняемыхФайлов);
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ОбработкаВыбораФорматаСохранения",ЭтотОбъект, ДополнительныеПараметры); 
	
	ПараметрыСохранения.СписокВыбораФормата.ПоказатьВыборЭлемента(ОписаниеОповещения,"Выберите формат файла");
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбораФорматаСохранения(Ответ, ДополнительныеПараметры) Экспорт 
	
	Если Ответ <> Неопределено Тогда
		
		СоответствиеРасширений 	= ПодготвитьСоответствиеТиповФайловИРасширений();
		Расширение				= СоответствиеРасширений.Получить(Ответ.Значение);
		
		ДиалогОткрытияФайла = Новый ДиалогВыбораФайла(ДополнительныеПараметры.Режим);
		
		Если ДополнительныеПараметры.Режим = РежимДиалогаВыбораФайла.Сохранение тогда
			СоответствиеФильтров 	= ПодготвитьСоответствиеТиповФайловИФильтров();
			
			Если ДополнительныеПараметры.ОдинФайл Тогда
				ПредставлениеИмениФайла = "Пакет документов";	
			Иначе
				ДанныеДляСохранения 	= ДополнительныеПараметры.ДанныеДляСохранения[0];
				ПредставлениеИмениФайла	= СтрЗаменить(СокрЛП(ДанныеДляСохранения.Представление),"/","-");
				ПредставлениеИмениФайла	= СтрЗаменить(СокрЛП(ПредставлениеИмениФайла),".","-");
			КонецЕсли;
			
			ДиалогОткрытияФайла.ПолноеИмяФайла 		= ПредставлениеИмениФайла;
			ДиалогОткрытияФайла.Фильтр 				= СоответствиеФильтров.Получить(Ответ.Значение);
			ДиалогОткрытияФайла.Заголовок 			= "Укажите имя файла...";
			
		Иначе
			ДиалогОткрытияФайла.Заголовок 			= "Укажите каталог для сохранения...";
		КонецЕсли;
		
		ДиалогОткрытияФайла.МножественныйВыбор 	= Ложь;
		
		СтруктураДопПараметров = Новый Структура;
		СтруктураДопПараметров.Вставить("Режим"						, ДополнительныеПараметры.Режим);
		СтруктураДопПараметров.Вставить("ОдинФайл"					, ДополнительныеПараметры.ОдинФайл);
		СтруктураДопПараметров.Вставить("ФорматФайла"				, Ответ.Значение);
		СтруктураДопПараметров.Вставить("Расширение"				, Расширение);
		СтруктураДопПараметров.Вставить("ДанныеДляСохранения"		, ДополнительныеПараметры.ДанныеДляСохранения);
		
		ОписаниеОповещения = Новый ОписаниеОповещения("ОбработкаСохраненияФайлов",ЭтотОбъект, СтруктураДопПараметров); 
		ДиалогОткрытияФайла.Показать(ОписаниеОповещения);
		
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаСохраненияФайлов(Ответ, ДополнительныеПараметры) Экспорт 
	
	Если Ответ <> Неопределено Тогда
		
		ИмяФайлаИзДанных = ложь;
		Если ДополнительныеПараметры.Режим = РежимДиалогаВыбораФайла.Сохранение Тогда
			//Получили полное имя файла
			ПолноеИмяФайла =  Ответ[0];
		Иначе
			//Получили имя каталога
			ИмяФайлаИзДанных 	= Истина;
			ПолноеИмяФайла 		= СокрЛП(Ответ[0]) + ?(Прав(СокрЛП(Ответ[0]),1)="\","","\");
		КонецЕсли;
		
		МассивДанныхДляСохранения = Новый Массив;
		Для Каждого  ДанныеДляСохранения из ДополнительныеПараметры.ДанныеДляСохранения Цикл
			ПараметрыСохранения = Новый Структура;
			ПараметрыСохранения.Вставить("АдресДанных"			, ДанныеДляСохранения.АдресДанных);
			ПараметрыСохранения.Вставить("Представление"		, ДанныеДляСохранения.Представление);
			ПараметрыСохранения.Вставить("ФорматФайла"			, ДополнительныеПараметры.ФорматФайла);
			ПараметрыСохранения.Вставить("ПолноеИмяФайла"		, ПолноеИмяФайла);
			ПараметрыСохранения.Вставить("ИмяФайлаИзДанных"		, ИмяФайлаИзДанных);
			ПараметрыСохранения.Вставить("Расширение"			, ДополнительныеПараметры.Расширение);
			
			Если ДополнительныеПараметры.ОдинФайл Тогда
				МассивДанныхДляСохранения.Добавить(ПараметрыСохранения);
			Иначе
				ЗаписатьДанныеВФайлы(ПараметрыСохранения);
			КонецЕсли;
			
		КонецЦикла;
		
		Если МассивДанныхДляСохранения.Количество() > 0 Тогда
			ЗаписатьДанныеВПакет(МассивДанныхДляСохранения, ПолноеИмяФайла, ДополнительныеПараметры.ФорматФайла);
		КонецЕсли;
		
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьДанныеВФайлы(ПараметрыСохранения)
	
	ТабличныйДокумент = ПолучитьИзВременногоХранилища(ПараметрыСохранения.АдресДанных);
	
	Если ПараметрыСохранения.ИмяФайлаИзДанных Тогда
		ПредставлениеИмениФайла	= СтрЗаменить(СокрЛП(ПараметрыСохранения.Представление),"/","-");
		ПредставлениеИмениФайла	= СтрЗаменить(СокрЛП(ПредставлениеИмениФайла),".","-");
		
		ИмяФайлаСохранения  = ПараметрыСохранения.ПолноеИмяФайла + ПредставлениеИмениФайла + ПараметрыСохранения.Расширение;
	Иначе
		ИмяФайлаСохранения = ПараметрыСохранения.ПолноеИмяФайла;	
	КонецЕсли;
	
	ТабличныйДокумент.Записать(ИмяФайлаСохранения,ПараметрыСохранения.ФорматФайла);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьДанныеВПакет(МассивДанныхДляСохранения, ПолноеИмяФайла, ТипФайла)
	
	Пакет = Новый ПакетОтображаемыхДокументов;
	
	Для Каждого ПараметрыСохранения из МассивДанныхДляСохранения Цикл
		ТабличныйДокумент = ПолучитьИзВременногоХранилища(ПараметрыСохранения.АдресДанных);
		
		ЭлементПакета = Пакет.Состав.Добавить();
		ЭлементПакета.Данные 		= ПоместитьВоВременноеХранилище(ТабличныйДокумент, Новый УникальныйИдентификатор);
		ЭлементПакета.Наименование 	= ПараметрыСохранения.Представление;
	КонецЦикла;
	
	Попытка
		Пакет.Записать(ПолноеИмяФайла, ТипФайла);
	Исключение
		ПоказатьПредупреждение(,"Не удалось сохранить документы в выбранном формате. 
		|Выберите другой формат файла для сохранения докментов.",,"Ошибка сохранения документов");
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьМассивПараметровСохраняемыхФайлов(РежимПакет)
	
	МассивПараметровСохраняемыхФайлов = Новый Массив;
	
	Если РежимПакет Тогда
		МассивЭлементовДерева = ДеревоПФ.ПолучитьЭлементы();
		НайтивДеревеПечатныхФормОтмеченныеЭлементы(МассивЭлементовДерева,МассивПараметровСохраняемыхФайлов);
	Иначе
		ДанныеТекущиейСтроки = Элементы.ДеревоПФ.ТекущиеДанные;
		МассивПараметровСохраняемыхФайлов.Добавить(Новый Структура("АдресДанных, Представление", ДанныеТекущиейСтроки.Адрес, ДанныеТекущиейСтроки.Представление));
	КонецЕсли;
	
	Возврат МассивПараметровСохраняемыхФайлов;
	
КонецФункции

&НаКлиенте
Процедура НайтивДеревеПечатныхФормОтмеченныеЭлементы(МассивЭлементовДерева, МассивПараметровСохраняемыхФайлов)
	
	Для Каждого СтрокаДерева Из МассивЭлементовДерева Цикл
		Если  СтрокаДерева.Группа Тогда
			НайтивДеревеПечатныхФормОтмеченныеЭлементы(СтрокаДерева.ПолучитьЭлементы(),МассивПараметровСохраняемыхФайлов);
			Продолжить;
		КонецЕсли;
		
		Если СтрокаДерева.Печать <> 0 Тогда
			Если ЭтоАдресВременногоХранилища(СтрокаДерева.Адрес) Тогда
				МассивПараметровСохраняемыхФайлов.Добавить(Новый Структура("АдресДанных, Представление", СтрокаДерева.Адрес, СтрокаДерева.Представление));
			КонецЕсли;
		КонецЕсли;	
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Функция ПодготвитьСоответствиеТиповФайловИРасширений()
	
	СоответствиеРасширений = новый Соответствие;
	СоответствиеРасширений.Вставить(ТипФайлаТабличногоДокумента.PDF	,".pdf");
	СоответствиеРасширений.Вставить(ТипФайлаТабличногоДокумента.MXL	,".mxl");
	СоответствиеРасширений.Вставить(ТипФайлаТабличногоДокумента.MXL7,".mxl");
	СоответствиеРасширений.Вставить(ТипФайлаТабличногоДокумента.XLS	,".xls");
	СоответствиеРасширений.Вставить(ТипФайлаТабличногоДокумента.XLSX,".xlsx");
	СоответствиеРасширений.Вставить(ТипФайлаТабличногоДокумента.ODS	,".ods");
	СоответствиеРасширений.Вставить(ТипФайлаТабличногоДокумента.DOCX,".docx");
	СоответствиеРасширений.Вставить(ТипФайлаТабличногоДокумента.TXT	,".txt");
	
	СоответствиеРасширений.Вставить(ТипФайлаТабличногоДокумента.HTML,".htm");
	СоответствиеРасширений.Вставить(ТипФайлаТабличногоДокумента.HTML3,".htm");
	СоответствиеРасширений.Вставить(ТипФайлаТабличногоДокумента.HTML4,".htm");
	СоответствиеРасширений.Вставить(ТипФайлаТабличногоДокумента.HTML5,".htm");
	
	Возврат СоответствиеРасширений;
	
КонецФункции

&НаКлиенте
Функция ПодготвитьСоответствиеТиповФайловИФильтров()
	
	СоответствиеФильтров = новый Соответствие;
	СоответствиеФильтров.Вставить(ТипФайлаТабличногоДокумента.PDF	,"Файлы .pdf (*.pdf)|*.pdf");
	СоответствиеФильтров.Вставить(ТипФайлаТабличногоДокумента.MXL	,"Файлы .mxl (*.mxl)|*.mxl");
	СоответствиеФильтров.Вставить(ТипФайлаТабличногоДокумента.MXL7	,"Файлы .mxl (версия 7) (*.mxl)|*.mxl");
	СоответствиеФильтров.Вставить(ТипФайлаТабличногоДокумента.XLS	,"Файлы .xls (*.xls)|*.xls");
	СоответствиеФильтров.Вставить(ТипФайлаТабличногоДокумента.XLSX	,"Файлы .xlsx (*.xlsx)|*.xlsx");
	СоответствиеФильтров.Вставить(ТипФайлаТабличногоДокумента.ODS	,"Файлы .ods (*.ods)|*.ods");
	СоответствиеФильтров.Вставить(ТипФайлаТабличногоДокумента.DOCX	,"Файлы .docx (*.docx)|*.docx");
	
	СоответствиеФильтров.Вставить(ТипФайлаТабличногоДокумента.HTML	,"Документ HTML (*.htm)|*.htm");
	СоответствиеФильтров.Вставить(ТипФайлаТабличногоДокумента.HTML3	,"Документ HTML 3 (*.htm)|*.htm");
	СоответствиеФильтров.Вставить(ТипФайлаТабличногоДокумента.HTML4	,"Документ HTML 4 (*.htm)|*.htm");
	СоответствиеФильтров.Вставить(ТипФайлаТабличногоДокумента.HTML5	,"Документ HTML 5 (*.htm)|*.htm");
	
	//Для пакетного сохранения
	СоответствиеФильтров.Вставить(ТипФайлаПакетаОтображаемыхДокументов.PDF	,"Файлы .pdf (*.pdf)|*.pdf");
	СоответствиеФильтров.Вставить(ТипФайлаПакетаОтображаемыхДокументов.XLS	,"Файлы .xls (*.xls)|*.xls");
	СоответствиеФильтров.Вставить(ТипФайлаПакетаОтображаемыхДокументов.XLSX	,"Файлы .xlsx (*.xlsx)|*.xlsx");
	СоответствиеФильтров.Вставить(ТипФайлаПакетаОтображаемыхДокументов.ODS	,"Файлы .ods (*.ods)|*.ods");
	СоответствиеФильтров.Вставить(ТипФайлаПакетаОтображаемыхДокументов.DOCX	,"Файлы .docx (*.docx)|*.docx");
	
	СоответствиеФильтров.Вставить(ТипФайлаПакетаОтображаемыхДокументов.HTML4	,"Документ HTML 4 (*.htm)|*.htm");
	СоответствиеФильтров.Вставить(ТипФайлаПакетаОтображаемыхДокументов.HTML5	,"Документ HTML 5 (*.htm)|*.htm");
	
	Возврат СоответствиеФильтров;
	
КонецФункции


&НаКлиенте
Процедура ПечатьПакета(Команда)
	
	ПодготовитьИНапечататьПакетДокументов(РежимИспользованияДиалогаПечати.Использовать);
	
КонецПроцедуры  

 &НаКлиенте
Процедура ПечатьПакетаСразу(Команда)
	 
	ПодготовитьИНапечататьПакетДокументов(РежимИспользованияДиалогаПечати.НеИспользовать);  
	
КонецПроцедуры 

&НаКлиенте
Функция ПодготовитьИНапечататьПакетДокументов(Знач РежимДиалогаПечати) 

	ПакетДокументов = Новый ПакетОтображаемыхДокументов;   
	
	Для каждого СтрокаДерева Из ДеревоПФ.ПолучитьЭлементы() Цикл
		ДобавитьДокументВПакет(ПакетДокументов, СтрокаДерева);
	КонецЦикла;
	
	ПакетДокументов.Напечатать(РежимДиалогаПечати);
	
КонецФункции 

&НаКлиенте
Процедура ДобавитьДокументВПакет(ПакетДокументов, СтрокаДерева) 
	
	Если СтрокаДерева.Печать = 0 Тогда 
		Для каждого ПодчиненнаяСтрока Из СтрокаДерева.ПолучитьЭлементы() Цикл
			ДобавитьДокументВПакет(ПакетДокументов, ПодчиненнаяСтрока);
		КонецЦикла;
	КонецЕсли;
	
	Если СтрокаДерева.Печать <> 0 Тогда
		Если СтрокаДерева.Группа Тогда
			Возврат;
		КонецЕсли; 
		
		ВремТабличныйДокумент = ПолучитьИзВременногоХранилища(СтрокаДерева.Адрес);
		
		Для Экземпляр = 1 по СтрокаДерева.Количество Цикл 
			
			АдресДокумента = ПоместитьВоВременноеХранилище(ВремТабличныйДокумент, Новый УникальныйИдентификатор);
			
			ЭлементПакета =	ПакетДокументов.Состав.Добавить();
			ЭлементПакета.Данные 		= АдресДокумента;
			ЭлементПакета.Наименование 	= СтрокаДерева.Представление;
		КонецЦикла;
		
	КонецЕсли;           
	
КонецПроцедуры


&НаКлиенте
Процедура ПечатьТекущего(Команда)
	
	НапечататьДокумент(РежимИспользованияДиалогаПечати.Использовать);
	
КонецПроцедуры  

&НаКлиенте
Процедура ПечатьТекущегоСразу(Команда)  
	
	НапечататьДокумент(РежимИспользованияДиалогаПечати.НеИспользовать); 
	
КонецПроцедуры

&НаКлиенте
Процедура НапечататьДокумент(РежимДиалогаПечати)
	
	ТекущийТД.Напечатать(РежимДиалогаПечати);
	
КонецПроцедуры




&НаКлиенте
Процедура ТекущийРедактировать(Команда)
	
	РежимРедактированияТабличногоДокумента = Не РежимРедактированияТабличногоДокумента;
	
	ТекущиеДанные = Элементы.ДеревоПФ.ТекущиеДанные;
	Если (ТекущиеДанные.Группа) Тогда
		Возврат;
	КонецЕсли; 
	
	Элементы.ТекущийТД.Редактирование 		= РежимРедактированияТабличногоДокумента;
	Элементы.ТекущийТД.Защита 				= Не РежимРедактированияТабличногоДокумента;
	Элементы.ТекущийТД.ТолькоПросмотр 		= Не РежимРедактированияТабличногоДокумента;
	Элементы.ТекущийТД.ОтображатьСетку 		= РежимРедактированияТабличногоДокумента;
	Элементы.ТекущийТД.ОтображатьЗаголовки 	= РежимРедактированияТабличногоДокумента;
	
	Элементы.РедактироватьТекущий.Пометка 	= РежимРедактированияТабличногоДокумента;
	
	Если Не РежимРедактированияТабличногоДокумента Тогда
		ЗаписатьМакетВДеревоПечатныхФорм( Элементы.ДеревоПФ.ТекущаяСтрока)
	КонецЕсли;
	
КонецПроцедуры


&НаСервере
Процедура ЗаписатьМакетВДеревоПечатныхФорм(Идентификатор)
	
	СтрокаДерева = ДеревоПФ.НайтиПоИдентификатору(Идентификатор);
	СтрокаДерева.Адрес = ПоместитьВоВременноеХранилище(ТекущийТД,ЭтаФорма.УникальныйИдентификатор);
	
КонецПроцедуры


&НаКлиенте
Процедура ОтправитьПоЭлектроннойПочте(Команда)
	
	Если СписокОбъектовПечати.Количество() = 1 Тогда
		ДанныеДляЗаполненияШаблона = СписокОбъектовПечати.Получить(0).Значение;	
	КонецЕсли;
	
	МассивПараметров = ПолучитьМассивСтруктурПараметровДляПечати(ДанныеДляЗаполненияШаблона);
	
	Для Каждого СтруктураПараметров из МассивПараметров Цикл
		ОткрытьФорму("ОбщаяФорма.CW_ФормаОтправкиДокументов", СтруктураПараметров);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьМассивСтруктурПараметровДляПечати(тДанныеДляЗаполненияШаблона=Неопределено)
	
	Результат = Новый Массив;
	
	ТаблицаДанных = Новый ТаблицаЗначений;
	ТаблицаДанных.Колонки.Добавить("АдресТабДок");
	ТаблицаДанных.Колонки.Добавить("АдресЭлПочты");
	ТаблицаДанных.Колонки.Добавить("АдресЭлПочтыКопия");
	ТаблицаДанных.Колонки.Добавить("АдресЭлПочтыСкрытаяКопия");
	ТаблицаДанных.Колонки.Добавить("ШаблонПисьма");
	ТаблицаДанных.Колонки.Добавить("ДанныеДляЗаполненияШаблона");
	ТаблицаДанных.Колонки.Добавить("Представление");
	
	ДеревоПечатныхФорм = РеквизитФормыВЗначение("ДеревоПФ");
	
	ОтборСтрокДерева = Новый Структура("Группа, Печать", Ложь, 1);
	СтрокиДерева = ДеревоПечатныхФорм.Строки.НайтиСтроки(ОтборСтрокДерева, Истина);
	
	Для Каждого СтрокаДерева из СтрокиДерева Цикл
		СтрокаТаблицы = ТаблицаДанных.Добавить();
		СтрокаТаблицы.АдресТабДок 					= СтрокаДерева.Адрес;
		СтрокаТаблицы.АдресЭлПочты					= СтрокаДерева.АдресЭлПочты;
		СтрокаТаблицы.АдресЭлПочтыКопия				= СтрокаДерева.АдресЭлПочтыКопия;
		СтрокаТаблицы.АдресЭлПочтыСкрытаяКопия		= СтрокаДерева.АдресЭлПочтыСкрытаяКопия;
		СтрокаТаблицы.ШаблонПисьма					= СтрокаДерева.ШаблонПисьма;
		СтрокаТаблицы.ДанныеДляЗаполненияШаблона	= СтрокаДерева.ДанныеДляЗаполненияШаблона;
		СтрокаТаблицы.Представление					= СтрокаДерева.Представление;
	КонецЦикла;
	
	СвёрнутаяТаблицаДанных = ТаблицаДанных.Скопировать(, "АдресЭлПочты,АдресЭлПочтыКопия,АдресЭлПочтыСкрытаяКопия,ШаблонПисьма, ДанныеДляЗаполненияШаблона");
	СвёрнутаяТаблицаДанных.Свернуть("АдресЭлПочты,АдресЭлПочтыКопия,АдресЭлПочтыСкрытаяКопия, ШаблонПисьма, ДанныеДляЗаполненияШаблона");
	
	Для Каждого СтрокаТаблицы Из СвёрнутаяТаблицаДанных Цикл
		
		ОтборСтрок = Новый Структура;
		ОтборСтрок.Вставить("АдресЭлПочты",					СтрокаТаблицы.АдресЭлПочты);
		ОтборСтрок.Вставить("АдресЭлПочтыКопия",			СтрокаТаблицы.АдресЭлПочтыКопия);
		ОтборСтрок.Вставить("АдресЭлПочтыСкрытаяКопия",		СтрокаТаблицы.АдресЭлПочтыСкрытаяКопия);
		ОтборСтрок.Вставить("ШаблонПисьма",					СтрокаТаблицы.ШаблонПисьма);
		ОтборСтрок.Вставить("ДанныеДляЗаполненияШаблона",	СтрокаТаблицы.ДанныеДляЗаполненияШаблона);
		
		мСтроки = ТаблицаДанных.НайтиСтроки(ОтборСтрок);
		
		ТаблицаПечатныхФорм = ТаблицаДанных.Скопировать(мСтроки, "АдресТабДок, Представление");
		
		АдресТаблицыПечатныхФорм = ПоместитьВоВременноеХранилище(ТаблицаПечатныхФорм, УникальныйИдентификатор);
		
		ПараметрыФормыПечати = Новый Структура;
		ПараметрыФормыПечати.Вставить("Получатели",				СтрокаТаблицы.АдресЭлПочты);
		ПараметрыФормыПечати.Вставить("ПолучателиКопия",		СтрокаТаблицы.АдресЭлПочтыКопия);
		ПараметрыФормыПечати.Вставить("ПолучателиСкрытаяКопия",	СтрокаТаблицы.АдресЭлПочтыСкрытаяКопия);
		ПараметрыФормыПечати.Вставить("ШаблонПисьма",			СтрокаТаблицы.ШаблонПисьма);
		
		ДанныеДляЗаполненияШаблона =  ?(ЗначениеЗаполнено(СтрокаТаблицы.ДанныеДляЗаполненияШаблона),СтрокаТаблицы.ДанныеДляЗаполненияШаблона, тДанныеДляЗаполненияШаблона);
		ПараметрыФормыПечати.Вставить("ДанныеДляЗаполненияШаблона",	ДанныеДляЗаполненияШаблона);
		
		ПараметрыФормыПечати.Вставить("АдресТаблицыПечатныхФорм",	АдресТаблицыПечатныхФорм); 
		
		ПараметрыФормыПечати.Вставить("ПечатныеФормыПодготовлены",	Истина); 
		
		Результат.Добавить(ПараметрыФормыПечати);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Процедура РекурсивныйОбходДереваДляТаблицыПечатаемыхФорм(СтрокаДерева, тз) Экспорт 
	
	Если (СтрокаДерева.Печать <> 0) Тогда
		
		Если (НЕ СтрокаДерева.Группа) Тогда
			
			строкаТЗ = тз.Добавить();
			строкаТЗ.ШаблонПисьма = Неопределено;
			строкаТЗ.АдресТабДок = СтрокаДерева.Адрес;
			строкаТЗ.АдресЭлПочты= СтрокаДерева.АдресЭлПочты;
			строкаТЗ.ШаблонПисьма= СтрокаДерева.ШаблонПисьма;
			строкаТЗ.ДанныеДляЗаполненияШаблона= СтрокаДерева.ДанныеДляЗаполненияШаблона;
			строкаТЗ.Представление= СтрокаДерева.Представление;
			
		КонецЕсли;
		
	Иначе
		
		Для каждого Стр Из СтрокаДерева.ПолучитьЭлементы() Цикл
			
			РекурсивныйОбходДереваДляТаблицыПечатаемыхФорм(Стр, тз);
			
		КонецЦикла;
		
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ВключитьВыключитьИерархию(Команда)
	
	ОбновитьДеревоНаСервере();
	если ДеревоСписок Тогда
		РазвернутьСтроки();
	Конецесли;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьДеревоНаСервере()
	
	Если ЭтоАдресВременногоХранилища(АдресПакетаФорм) Тогда
		
		ДеревоСписок = Не ДеревоСписок;
		
		ЭлементыДерева = ДеревоПФ.ПолучитьЭлементы();
		ЭлементыДерева.Очистить();
		
		СтруктураПакета = ПолучитьИзВременногоХранилища(АдресПакетаФорм);
		_ЗаполнитьДерево(СтруктураПакета,ДеревоПФ);
		ОбновитьОтображениеКнопки();
		УстановитьТекущуюСтрокуДерева(ДеревоПФ);	
		
	Конецесли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоРазвернуть(Команда)
	РазвернутьСтроки();
КонецПроцедуры

&НаКлиенте
Процедура ДеревоСвернуть(Команда)
	СвернутьСтроки();
КонецПроцедуры

&НаКлиенте
Процедура РазвернутьСтроки()
	
	КоллекцияЭлементовДерева = ДеревоПФ.ПолучитьЭлементы();
	
	//Развернуть дерево 
	Для Каждого Строка Из КоллекцияЭлементовДерева Цикл 
		ИдентификаторСтроки = Строка.ПолучитьИдентификатор();
		Элементы.ДеревоПФ.Развернуть(ИдентификаторСтроки);
	КонецЦикла; 
	
КонецПроцедуры

&НаКлиенте
Процедура СвернутьСтроки()
	
	КоллекцияЭлементовДерева = ДеревоПФ.ПолучитьЭлементы();
	
	//Развернуть дерево 
	Для Каждого Строка Из КоллекцияЭлементовДерева Цикл 
		ИдентификаторСтроки = Строка.ПолучитьИдентификатор();
		Элементы.ДеревоПФ.Свернуть(ИдентификаторСтроки);
	КонецЦикла; 
	
КонецПроцедуры

&НаКлиенте
Процедура ТекущийТДОбработкаРасшифровки(Элемент, Расшифровка, СтандартнаяОбработка, ДополнительныеПараметры)
	СтандартнаяОбработка =Ложь;
КонецПроцедуры

&наСервере
Процедура ОбновитьОтображениеКнопки()
	
	Элементы.ДеревоПФВключитьВыключитьИерархию.Видимость 	= Не ОдинДокумент или НеОтключатьИерархиюФорм;	
	Элементы.ГруппадеревоРазвренутьСвернуть.Видимость 		= ДеревоСписок или НеОтключатьИерархиюФорм;
	
	Если Не ОдинДокумент Тогда
		Элементы.ДеревоПФВключитьВыключитьИерархию.Картинка = ?(ДеревоСписок, БиблиотекаКартинок.CW_Меню2, БиблиотекаКартинок.CW_Подразделения);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьИмяОбработкиПриИзменении(Элемент)
	Элементы.ДеревоПФНавигационнаяСсылкаПредставление.Видимость = ПоказатьИмяОбработки;
КонецПроцедуры

&НаКлиенте
Процедура ДеревоПФВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Поле.ГиперссылкаЯчейки Тогда
		СтандартнаяОбработка 	= Ложь;
		
		Если Поле.Имя = "ДеревоПФНавигационнаяСсылкаПредставление" Тогда
			ПерейтиПоНавигационнойСсылке(Элементы.ДеревоПФ.ТекущиеДанные.НавигационнаяСсылка);
		КонецЕсли;
		
	КонецЕсли;	
	
КонецПроцедуры


//Сохранение печатной формы
&НаКлиенте
Процедура СохранитьФайлыВКаталог(Знач ВыбранноеЗначение)
	
	МассивДанных = ПоместитьФайлыВоВременноеХранилищеНаСервере(ВыбранноеЗначение);
	
	#Если ВебКлиент Тогда
		Для Каждого Элемент Из МассивДанных Цикл
			ПараметрыДиалогаПолученияФайлов = Новый ПараметрыДиалогаПолученияФайлов;
			ПараметрыДиалогаПолученияФайлов.ВыборКаталога = Истина;
			
			НачатьПолучениеФайлаССервера(Элемент.АдресВоВременномХранилище, Элемент.Представление, ПараметрыДиалогаПолученияФайлов);
		КонецЦикла;
	#Иначе 
		
		ДополнительныеПараметры = Новый Структура();
		ДополнительныеПараметры.Вставить("КаталогДляСохранения", ВыбранноеЗначение.КаталогДляСохранения);
	
		ОписаниеОповещения = Новый ОписаниеОповещения("СохранитьФайлыВКаталогЗавершение", ЭтотОбъект, ДополнительныеПараметры);
		
		КаталогДляСохранения = ОбщегоНазначенияКлиентСервер.ДобавитьКонечныйРазделительПути(ВыбранноеЗначение.КаталогДляСохранения);
		
		ПолучаемыеФайлы = Новый Массив;
		Для Каждого Элемент Из МассивДанных Цикл
		
			ПолучаемыйФайл 			= Новый ОписаниеПередаваемогоФайла;
			ПолучаемыйФайл.Имя 		= Элемент.Представление;
			ПолучаемыйФайл.Хранение = Элемент.АдресВоВременномХранилище;
			
			ПолучаемыеФайлы.Добавить(ПолучаемыйФайл);
		
		КонецЦикла;
		
		НачатьПолучениеФайлов(ОписаниеОповещения, ПолучаемыеФайлы, КаталогДляСохранения, Ложь);
		
	#КонецЕсли

КонецПроцедуры   

&НаСервере
Процедура ЗаписатьФайлыНаСервере(ВыбранноеЗначение, ТекущаяСтрока)  
	
	// подготовка временной папки
	ИмяВременнойПапки = ПолучитьИмяВременногоФайла();
	СоздатьКаталог(ИмяВременнойПапки); 
	
	СтрокаТекущая = ДеревоПФ.НайтиПоИдентификатору(ТекущаяСтрока);
	
	ИмяФайлаБезРасширения = ОбщегоНазначенияКлиентСервер.ЗаменитьНедопустимыеСимволыВИмениФайла(СокрЛП(ВыбранноеЗначение.ИмяФайла));

	Для Каждого ФорматФайла Из ВыбранноеЗначение.ФорматыСохранения Цикл
		
		Если ФорматФайла = "DOCX" Тогда
			// Подготовим DOCX документ на основе табличного документа
			ИмяФайла = ИмяФайлаБезРасширения+".docx";
			Расширение 	= ".docx";
			ПолноеИмяФайла = ПодготовитьDOCXНаОсновеТабличногоДокумента(ИмяВременнойПапки, ИмяФайла);
		ИначеЕсли ФорматФайла = "XLSX" Тогда
			// Подготовим XLSX документ на основе табличного документа
			ИмяФайла = ИмяФайлаБезРасширения + ".xlsx";
			Расширение 	= ".xlsx";
			ПолноеИмяФайла = ПодготовитьXLSXНаОсновеТабличногоДокумента(ИмяВременнойПапки, ИмяФайла); 
		ИначеЕсли ФорматФайла = "PDF" Тогда
			// Подготовим PDF документ на основе табличного документа
			ИмяФайла = ИмяФайлаБезРасширения + ".pdf";
			Расширение 	= ".pdf";
			ПолноеИмяФайла = ПодготовитьPDFНаОсновеТабличногоДокумента(ИмяВременнойПапки, ИмяФайла);
		ИначеЕсли ФорматФайла = "MXL" Тогда
			// Подготовим PDF документ на основе табличного документа
			ИмяФайла = ИмяФайлаБезРасширения + ".mxl";
			Расширение 	= ".mxl";
			ПолноеИмяФайла = ПодготовитьMXLНаОсновеТабличногоДокумента(ИмяВременнойПапки, ИмяФайла);
		ИначеЕсли ФорматФайла = "HTML" Тогда
			// Подготовим HTML документ на основе табличного документа
			ИмяФайла 	= ИмяФайлаБезРасширения + ".htm";
			Расширение 	= ".htm";
			ПолноеИмяФайла = ПодготовитьHTMLНаОсновеТабличногоДокумента(ИмяВременнойПапки, ИмяФайла);
		КонецЕсли;                          
		
		Если ПолучитьФункциональнуюОпцию("CW_ЗапрашиватьТипФайлаПриДобавленииВАрхив") Тогда
			ТипДокумента = ВыбранноеЗначение.ТипДокумента;   
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрокаТекущая.Ссылка) Тогда  
			
			ОбъектыАрхива = Новый Массив;
			ОбъектыАрхива.Добавить(СтрокаТекущая.Ссылка);  
			
			ДвоичныеДанные = Новый ДвоичныеДанные(ПолноеИмяФайла);
			Хранение = ПоместитьВоВременноеХранилище(ДвоичныеДанные, Новый УникальныйИдентификатор);
			
			ДанныеФайла = Новый Структура;
			ДанныеФайла.Вставить("Имя",			ИмяФайла);
			ДанныеФайла.Вставить("Расширение",	Расширение);
			ДанныеФайла.Вставить("Хранение",	Хранение);
			
			ПомещенныеФайлы = Новый Массив;
			ПомещенныеФайлы.Добавить(ДанныеФайла);
			
			CW_РаботаСФайламиСервер.ПрикрепитьФайлы(ПомещенныеФайлы, ОбъектыАрхива, ТипДокумента); 
			
		КонецЕсли;
		
	КонецЦикла;
	
	// Удалим временный файл.
	УдалитьВременныйФайлНаСервер(ИмяВременнойПапки);
	
КонецПроцедуры

&НаСервере
Функция ПолучитьИмяФайлаБезРасширения(Знач СтрокаТекущая)   
	
	ТекущаяСтрока =	ДеревоПФ.НайтиПоИдентификатору(СтрокаТекущая);
	
	Возврат ОбщегоНазначенияКлиентСервер.ЗаменитьНедопустимыеСимволыВИмениФайла(СокрЛП(ТекущаяСтрока.Представление));

КонецФункции

&НаКлиенте
Процедура СохранитьФайлыВКаталогЗавершение(ПолученныеФайлы, ДополнительныеПараметры) Экспорт

	Если ПолученныеФайлы = Неопределено Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'При сохранении возникла ошибка'"));
	Иначе
		Состояние(НСтр("ru = 'Сохранение успешно завершено'"), , НСтр("ru = 'в папку:'") + " " + ДополнительныеПараметры.КаталогДляСохранения);
	КонецЕсли;

КонецПроцедуры   

&НаСервере
Функция ПоместитьФайлыВоВременноеХранилищеНаСервере(ВыбранноеЗначение)

	Папка = ПолучитьИмяВременногоФайла();
	СоздатьКаталог(Папка);
	
	// Указываем имя файла вложения
	ИмяФайлаБезРасширения = ОбщегоНазначенияКлиентСервер.ЗаменитьНедопустимыеСимволыВИмениФайла(СокрЛП(ВыбранноеЗначение.ИмяФайла));
	
	МассивДанных = Новый Массив;
	Для Каждого ФорматФайла Из ВыбранноеЗначение.ФорматыСохранения Цикл
		
		Если ФорматФайла = "DOCX" Тогда
			ИмяФайла = ИмяФайлаБезРасширения + ".docx";
			// Подготовим DOCX документ на основе табличного документа
			ПолноеИмяФайла = ПодготовитьDOCXНаОсновеТабличногоДокумента(Папка, ИмяФайла);
		ИначеЕсли ФорматФайла = "PDF" Тогда
			ИмяФайла = ИмяФайлаБезРасширения + ".pdf";
			// Подготовим PDF документ на основе табличного документа
			ПолноеИмяФайла = ПодготовитьPDFНаОсновеТабличногоДокумента(Папка, ИмяФайла);
		ИначеЕсли ФорматФайла = "MXL" Тогда
			ИмяФайла = ИмяФайлаБезРасширения + ".mxl";
			// Подготовим PDF документ на основе табличного документа
			ПолноеИмяФайла = ПодготовитьMXLНаОсновеТабличногоДокумента(Папка, ИмяФайла); 
		ИначеЕсли ФорматФайла = "XLSX" Тогда
			ИмяФайла = ИмяФайлаБезРасширения + ".xlsx";
			// Подготовим XLSX документ на основе табличного документа
			ПолноеИмяФайла = ПодготовитьXLSXНаОсновеТабличногоДокумента(Папка, ИмяФайла); 
		КонецЕсли;
		
		ДвоичныеДанные 				= Новый ДвоичныеДанные(ПолноеИмяФайла);
		ПутьВоВременномХранилище 	= ПоместитьВоВременноеХранилище(ДвоичныеДанные, ЭтотОбъект.УникальныйИдентификатор);   
		
		ОписаниеФайла = Новый Структура;
		ОписаниеФайла.Вставить("Представление", ИмяФайла);
		ОписаниеФайла.Вставить("АдресВоВременномХранилище", ПутьВоВременномХранилище);
		
		МассивДанных.Добавить(ОписаниеФайла);
		
	КонецЦикла;  
	
	УдалитьВременныйФайлНаСервер(Папка);
	
	Возврат МассивДанных;

КонецФункции

