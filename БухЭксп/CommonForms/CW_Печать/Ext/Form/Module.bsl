
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Параметры.Свойство("НеОтключатьИерархиюФорм"	, НеОтключатьИерархиюФорм);
	Параметры.Свойство("АдресПакета"				, АдресПакетаФорм);
	Параметры.Свойство("ЭтоПакетнаяПечать"			, ЭтоПакетнаяПечать);
	
	ДеревоСписок = истина;
	
	ОбновитьДанныеФормы(Параметры);	
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьДанныеФормы(Параметры)
	
	Если ЭтоАдресВременногоХранилища(Параметры.АдресОбъектовПечати) Тогда
		СписокОбъектовПечати.ЗагрузитьЗначения(ПолучитьИзВременногоХранилища(Параметры.АдресОбъектовПечати));
	КонецЕсли;
	
	Если ЭтоАдресВременногоХранилища(Параметры.АдресСписокПФ) Тогда
		СписокПечатныхФорм = ПолучитьИзВременногоХранилища(Параметры.АдресСписокПФ);
	КонецЕсли;
	
	Если ЭтоАдресВременногоХранилища(АдресПакетаФорм) Тогда
		СтруктураПакета = ПолучитьИзВременногоХранилища(Параметры.АдресПакета);
		
		_ЗаполнитьДерево(СтруктураПакета,ДеревоПФ);
		
		УстановитьТекущуюСтрокуДерева(ДеревоПФ);
		ОбновитьОтображениеКнопки();
	Конецесли;
	
КонецПроцедуры


&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	РазвернутьСтроки();
	
КонецПроцедуры

&наСервере
Процедура УстановитьТекущуюСтрокуДерева(Дерево)
	
	Если ДеревоСписок Тогда
		КоллекцияЭлементовДерева = Дерево.ПолучитьЭлементы();
		
		Для Каждого Строка Из КоллекцияЭлементовДерева Цикл 
			Если Строка.Группа Тогда
				УстановитьТекущуюСтрокуДерева(Строка);
				Возврат;
			Иначе
				Элементы.ДеревоПФ.ТекущаяСтрока = Строка.ПолучитьИдентификатор();
				Возврат;
			КонецЕсли;
		КонецЦикла; 
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция _ЗаполнитьДерево(Структура,Дерево, ВыводитьГруппы = Ложь)
	// --- 
	// Имя
	// Вид = {Корень;Группа;Элемент}
	// ПФ
	
	Если (Структура.Вид = "Элемент") Тогда
		
		СтрокаДерева 				= Дерево.ПолучитьЭлементы().Добавить();
		СтрокаДерева.Имя 			= Структура.Имя;
		СтрокаДерева.Представление 	= СтрокаДерева.Имя;
		СтрокаДерева.Группа 		= Ложь;
		СтрокаДерева.Картинка 		= 1;
		
		СтрокаДерева.Печать 		= ?(Структура.Печать=Истина,1,0);
		СтрокаДерева.Количество 	= Структура.Количество;
		СтрокаДерева.Адрес 			= ПоместитьВоВременноеХранилище(Структура.ПФ,ЭтаФорма.УникальныйИдентификатор);
		
		Если Структура.Свойство("АдресЭлПочты") Тогда
			СтрокаДерева.АдресЭлПочты = Структура.АдресЭлПочты;
		КонецЕсли;
		Если Структура.Свойство("АдресЭлПочтыКопия") Тогда
			СтрокаДерева.АдресЭлПочтыКопия = Структура.АдресЭлПочтыКопия;
		КонецЕсли;
		Если Структура.Свойство("АдресЭлПочтыСкрытаяКопия") Тогда
			СтрокаДерева.АдресЭлПочтыСкрытаяКопия = Структура.АдресЭлПочтыСкрытаяКопия; 
		КонецЕсли;
		
		Если Структура.Свойство("ШаблонПисьма") Тогда
			СтрокаДерева.ШаблонПисьма = Структура.ШаблонПисьма;
		КонецЕсли;
		
		Если Структура.Свойство("ДанныеДляЗаполненияШаблона") Тогда
			СтрокаДерева.ДанныеДляЗаполненияШаблона	= Структура.ДанныеДляЗаполненияШаблона;
		КонецЕсли;
		
		Если Структура.Свойство("НавигационнаяСсылка") Тогда
			СтрокаДерева.НавигационнаяСсылка 				= Структура.НавигационнаяСсылка;
			СтрокаДерева.НавигационнаяСсылкаПредставление 	= Структура.НавигационнаяСсылкаПредставление;
		КонецЕсли;
		
		СтрокаДерева.Ссылка = Структура.Ссылка;
		
		Возврат(Истина);
		
	КонецЕсли; 
	
	Если (Структура.Вид = "Группа") Тогда
		
		Если ВыводитьГруппы или НеОтключатьИерархиюФорм Тогда
			СтрокаДерева 				= Дерево.ПолучитьЭлементы().Добавить();
			СтрокаДерева.Имя 			= Структура.Имя;
			СтрокаДерева.Представление 	= СтрокаДерева.Имя;
			СтрокаДерева.Группа 		= Истина;
			СтрокаДерева.Картинка 		= 0;
		Иначе
			СтрокаДерева 				= Дерево;
		КонецЕсли;
		
		Для каждого Элемент Из Структура.Элементы Цикл
			_ЗаполнитьДерево(Элемент,СтрокаДерева);
		КонецЦикла; 
		
		Возврат(Истина);
		
	КонецЕсли; 
	
	// --- 
	
	Если (Структура.Вид = "Корень") Тогда
		
		ОдинДокумент = Структура.Элементы.Количество()=1;
		
		ВывестиИерархию = Не ОдинДокумент И ДеревоСписок;
		ДеревоСписок 	= ВывестиИерархию;
		
		Для каждого Элемент Из Структура.Элементы Цикл
			_ЗаполнитьДерево(Элемент, Дерево, ВывестиИерархию);
		КонецЦикла; 
		
		Возврат(Истина);
		
	КонецЕсли; 
	
	// --- 
КонецФункции


&НаКлиенте
Процедура ДеревоПФПриАктивизацииСтроки(Элемент)
	
	ТД = Элементы.ДеревоПФ.ТекущиеДанные;
	Если (ТД = Неопределено) Тогда
		Возврат;
	КонецЕсли; 
	Если (НЕ ТД.Группа) Тогда
		
		_ЗагрузитьПФ(ТД.Адрес);
		
		Элементы.ТекущийТД.ТолькоПросмотр = Истина;
		Элементы.ТекущийТД.ОтображатьСетку = Ложь;
		Элементы.ТекущийТД.ОтображатьЗаголовки = Ложь;
		
	КонецЕсли; 
	
КонецПроцедуры

