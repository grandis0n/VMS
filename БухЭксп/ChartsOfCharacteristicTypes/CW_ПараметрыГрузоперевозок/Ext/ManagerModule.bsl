#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

Процедура ПолучиьСписокПараметровДляВыводаНаФорму(СоответствиеПараметров, СписокДополнительныхКолонок) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	CW_ПараметрыГрузоперевозок.Код КАК Код,
	               |	CW_ПараметрыГрузоперевозок.Ссылка КАК Ссылка,
	               |	CW_ПараметрыГрузоперевозок.Наименование КАК Наименование,
	               |	CW_ПараметрыГрузоперевозок.ЭтоКонтрольнаяДата КАК ЭтоКонтрольнаяДата
	               |ИЗ
	               |	ПланВидовХарактеристик.CW_ПараметрыГрузоперевозок КАК CW_ПараметрыГрузоперевозок
	               |ГДЕ
	               |	НЕ CW_ПараметрыГрузоперевозок.Предопределенный
	               |	И НЕ CW_ПараметрыГрузоперевозок.ЭтоГруппа
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Наименование";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаПараметры = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаПараметры.Следующий() Цикл
		ИмяКолонки 				= СокрЛП(ВыборкаПараметры.Код);
		ПредставлениеПараметра 	= СокрЛП(ВыборкаПараметры.Наименование);  
		
		СоответствиеПараметров.Вставить(ИмяКолонки, Новый Структура("ЭтоПараметр, Значение,Представление",Истина, ВыборкаПараметры.Ссылка, ПредставлениеПараметра));
		СписокДополнительныхКолонок.Добавить(ИмяКолонки,	ПредставлениеПараметра, Ложь);
		
		Если ВыборкаПараметры.ЭтоКонтрольнаяДата Тогда
			СоответствиеПараметров.Вставить(ИмяКолонки + "_План", Новый Структура("ЭтоПараметр, Значение,Представление",Истина, ВыборкаПараметры.Ссылка, ПредставлениеПараметра + " (План)"));
			СписокДополнительныхКолонок.Добавить(ИмяКолонки + "_План",	ПредставлениеПараметра + " (План)", Ложь);   
			
			СоответствиеПараметров.Вставить(ИмяКолонки + "_Факт", Новый Структура("ЭтоПараметр, Значение,Представление",Истина, ВыборкаПараметры.Ссылка, ПредставлениеПараметра + " (Факт)"));
			СписокДополнительныхКолонок.Добавить(ИмяКолонки + "_Факт",	ПредставлениеПараметра + " (Факт)", Ложь);   
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

// Функция - Получить список параметров по типу значения
//
// Параметры:
//  Тип					 			-	тип значения параметров; 
//  ИсключитьПомеченныеНаУдаление	-	исключение из массива помеченных на удаление параметров
// 
// Возвращаемое значение:
//   - Массив ссылок с типом "ПланВидовХарактеристик.CW_ПараметрыГрузоперевозок"
//
Функция ПолучитьСписокПараметровПоТипуЗначения(Тип, ИсключитьПомеченныеНаУдаление=Истина) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	CW_ПараметрыГрузоперевозок.Ссылка КАК Ссылка,
	|	CW_ПараметрыГрузоперевозок.ТипЗначения КАК ТипЗначения
	|ИЗ
	|	ПланВидовХарактеристик.CW_ПараметрыГрузоперевозок КАК CW_ПараметрыГрузоперевозок
	|ГДЕ
	|	CW_ПараметрыГрузоперевозок.ЭтоГруппа = ЛОЖЬ
	|	//УсловиеПомеченныхНаУдаление";  
	
	Если ИсключитьПомеченныеНаУдаление Тогда
		ТекстЗамены = "И CW_ПараметрыГрузоперевозок.ПометкаУдаления = ЛОЖЬ";
		Запрос.Текст = СтрЗаменить(Запрос.Текст,"//УсловиеПомеченныхНаУдаление", ТекстЗамены);
	КонецЕсли;
	
	Выборка = Запрос.Выполнить().Выбрать();
	Массив = Новый Массив;	
	Пока Выборка.Следующий() Цикл
		Если  Выборка.ТипЗначения.СодержитТип(Тип) Тогда
			Массив.Добавить(Выборка.Ссылка);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Массив;
	
КонецФункции

Функция ПолучитьСвойстваПараметров(МассивПараметров) Экспорт
	
	Пользователь 				= ПараметрыСеанса.ТекущийПользователь;
	ЭтоПолноправныйПользователь = CW_ПраваДоступа.ЭтоПолноправныйПользователь(ПараметрыСеанса.ТекущийПользователь,Истина);
	
	ГруппаПользователя = CW_ПраваДоступа_ПИ.ГруппаПользователя(Пользователь);
	Если (ГруппаПользователя = Неопределено) Тогда
		ГруппаПользователя = Справочники.CW_ГруппыПользователей.ПустаяСсылка();
	КонецЕсли; 
	Если (ГруппаПользователя.ПолныеПрава) Тогда
		ГруппаПользователя = Справочники.CW_ГруппыПользователей.Администраторы;
	КонецЕсли; 
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ПараметрыГрузоперевозок.Ссылка КАК Ссылка,
	               |	ВЫБОР
	               |		КОГДА ПараметрыГрузоперевозок.ДинамическийПараметр
	               |			ТОГДА 3
	               |		КОГДА ПараметрыГрузоперевозок.ЭтоКонтрольнаяДата
	               |			ТОГДА 2
	               |		ИНАЧЕ 1
	               |	КОНЕЦ КАК ИндексКартинки,
	               |	ВЫБОР
	               |		КОГДА &ПолныеПрава
	               |			ТОГДА ИСТИНА
	               |		ИНАЧЕ ЕСТЬNULL(CW_ПраваДоступаДляПараметровМониторинга.Просмотр, ЛОЖЬ)
	               |	КОНЕЦ КАК Просмотр,
	               |	ВЫБОР
	               |		КОГДА &ПолныеПрава
	               |			ТОГДА ИСТИНА
	               |		ИНАЧЕ ЕСТЬNULL(CW_ПраваДоступаДляПараметровМониторинга.Редактирование, ЛОЖЬ)
	               |	КОНЕЦ КАК Редактирование,
	               |	ПараметрыГрузоперевозок.ДинамическийПараметр КАК ЭтоДинамическийПараметр,
	               |	ПараметрыГрузоперевозок.КонтрольнаяДатаИспользуетВремя КАК КонтрольнаяДатаИспользуетВремя,
	               |	ПараметрыГрузоперевозок.ЭтоКонтрольнаяДата КАК ЭтоКонтрольнаяДата,
	               |	ПараметрыГрузоперевозок.НеПоказыватьВФормеГрузоперевозок КАК ПараметрНеПоказыватьВФормеГрузоперевозок,
	               |	ПараметрыГрузоперевозок.ОбработкаИзменения КАК ЕстьОбработкаИзменения,
	               |	ПараметрыГрузоперевозок.ИспользуетсяОбработкаПередНачаломВыбора КАК ЕстьОбработкаПередНачаломВыбора,
	               |	ПараметрыГрузоперевозок.ИспользоватьФормуВыбораОбъекта КАК РедактироватьВСтроке,
	               |	ПараметрыГрузоперевозок.НеПоказыватьВФормеГрузоперевозок КАК СкрыватьВДереве,
	               |	ПараметрыГрузоперевозок.ЭтоВедомыйПараметр КАК ЕстьВедущие,
	               |	ПараметрыГрузоперевозок.ФорматВывода КАК ФорматВывода
	               |ИЗ
	               |	ПланВидовХарактеристик.CW_ПараметрыГрузоперевозок КАК ПараметрыГрузоперевозок
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.CW_ПраваДоступаДляПараметровМониторинга КАК CW_ПраваДоступаДляПараметровМониторинга
	               |		ПО ПараметрыГрузоперевозок.Ссылка = CW_ПраваДоступаДляПараметровМониторинга.Параметр
	               |			И (CW_ПраваДоступаДляПараметровМониторинга.Группа = &ГруппаПользователя)
	               |ГДЕ
	               |	ПараметрыГрузоперевозок.Ссылка В(&МассивПараметров)";
	
	Запрос.УстановитьПараметр("МассивПараметров", 	МассивПараметров);
	Запрос.УстановитьПараметр("ГруппаПользователя", ГруппаПользователя);
	Запрос.УстановитьПараметр("ПолныеПрава", 		ЭтоПолноправныйПользователь или ГруппаПользователя.ПолныеПрава);
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	Возврат Выборка;
	
КонецФункции

// Функция - ПолучитьМассивВедомыхПараметров(Параметр)
//
// Параметры:
//  Параметр - 	 Параметр, для которого будутполучены выдомые параметры 
// 
// Возвращаемое значение:
//   - массив ведомых параметров
//
Функция ПолучитьМассивВедомыхПараметров(Параметр) Экспорт

	Результат = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	ВедущиеПараметры.Ссылка КАК Ссылка
	               |ИЗ
	               |	ПланВидовХарактеристик.CW_ПараметрыГрузоперевозок.ВедущиеПараметры КАК ВедущиеПараметры
	               |ГДЕ
	               |	ВедущиеПараметры.Параметр = &Параметр";
	
	Запрос.УстановитьПараметр("Параметр", Параметр);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Добавить(Выборка.Ссылка);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции  

//Шаблоны стандартных писем
Процедура ДополнитьМакросыПараметровГрузоперевозок(ГруппаМакросов) Экспорт

	Запрос = новый Запрос;
	запрос.Текст = "ВЫБРАТЬ
	               |	CW_ПараметрыГрузоперевозок.Ссылка КАК Ссылка,
	               |	CW_ПараметрыГрузоперевозок.Наименование КАК Наименование,
	               |	CW_ПараметрыГрузоперевозок.ТипЗначения КАК ТипЗначения,
	               |	CW_ПараметрыГрузоперевозок.Идентификатор КАК Идентификатор,
	               |	CW_ПараметрыГрузоперевозок.ИдентификаторПлан КАК ИдентификаторПлан,
	               |	CW_ПараметрыГрузоперевозок.ИдентификаторФакт КАК ИдентификаторФакт
	               |ИЗ
	               |	ПланВидовХарактеристик.CW_ПараметрыГрузоперевозок КАК CW_ПараметрыГрузоперевозок
	               |ГДЕ
	               |	CW_ПараметрыГрузоперевозок.Служебный = ЛОЖЬ
	               |	И CW_ПараметрыГрузоперевозок.ЭтоГруппа = ЛОЖЬ
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Идентификатор
	               |АВТОУПОРЯДОЧИВАНИЕ";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		КартинкаТипа = ИндексКартинкиТипа(Выборка.ТипЗначения);   
		
		ДобавитьСтрокуМакросов(ГруппаМакросов,"["+СокрЛП(Выборка.Идентификатор) + "]", СокрЛП(Выборка.Идентификатор) , КартинкаТипа);
		
		Если Не ПустаяСтрока(СокрЛП(Выборка.ИдентификаторПлан)) Тогда
			ПредставлениеПараметра = СтрЗаменить(СокрЛП(Выборка.ИдентификаторПлан), "_ЗначениеПлан", " (План)");
			ДобавитьСтрокуМакросов(ГруппаМакросов,"["+СокрЛП(Выборка.ИдентификаторПлан) + "]", ПредставлениеПараметра , КартинкаТипа);
		КонецЕсли;
		Если Не ПустаяСтрока(СокрЛП(Выборка.ИдентификаторФакт)) Тогда
			ПредставлениеПараметра = СтрЗаменить(СокрЛП(Выборка.ИдентификаторФакт), "_ЗначениеФакт", " (Факт)");
			ДобавитьСтрокуМакросов(ГруппаМакросов,"["+СокрЛП(Выборка.ИдентификаторФакт) + "]", ПредставлениеПараметра , КартинкаТипа);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры 

Процедура ДобавитьСтрокуМакросов(ГруппаМакросов, Значение, Представление, ИндексКартинки)
	
	СтрокаМакроса = ГруппаМакросов.Строки.Добавить();
	СтрокаМакроса.ИндексКартинки 	= ИндексКартинки;
	СтрокаМакроса.Значение 			= Значение;
	СтрокаМакроса.Представление 	= Представление;
	СтрокаМакроса.ЭтоГруппа 		= Ложь;
	
КонецПроцедуры

Процедура ОписаниеМакросовПараметровГрузоперевозок(Результат) Экспорт	

	Запрос = новый Запрос;
	запрос.Текст = "ВЫБРАТЬ
	               |	CW_ПараметрыГрузоперевозок.Ссылка КАК Ссылка,
	               |	CW_ПараметрыГрузоперевозок.Наименование КАК Наименование,
	               |	CW_ПараметрыГрузоперевозок.Идентификатор КАК Идентификатор,
	               |	CW_ПараметрыГрузоперевозок.ИдентификаторПлан КАК ИдентификаторПлан,
	               |	CW_ПараметрыГрузоперевозок.ИдентификаторФакт КАК ИдентификаторФакт,
	               |	CW_ПараметрыГрузоперевозок.ТипЗначения КАК ТипЗначения
	               |ИЗ
	               |	ПланВидовХарактеристик.CW_ПараметрыГрузоперевозок КАК CW_ПараметрыГрузоперевозок
	               |ГДЕ
	               |	CW_ПараметрыГрузоперевозок.Служебный = ЛОЖЬ
	               |	И CW_ПараметрыГрузоперевозок.ЭтоГруппа = ЛОЖЬ
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Наименование
	               |АВТОУПОРЯДОЧИВАНИЕ";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Идентификатор 	= "["+СокрЛП(Выборка.Идентификатор) + "]";
		ИмяФункции 		= "МенеджерОбъектаШаблона.ПолучитьЗначениеПараметра(Источник, """+Идентификатор+""", ""Значение"", СоответствиеПараметров)";
		Результат.Вставить(Идентификатор,	ИмяФункции);
		
		Если Не ПустаяСтрока(СокрЛП(Выборка.ИдентификаторПлан)) Тогда
			ИдентификаторПлан 	= "["+СокрЛП(Выборка.ИдентификаторПлан) + "]";
			ИмяФункцииПлан 		= "МенеджерОбъектаШаблона.ПолучитьЗначениеПараметра(Источник, """+ИдентификаторПлан+""", ""ЗначениеПлан"", СоответствиеПараметров)";
			Результат.Вставить(ИдентификаторПлан,	ИмяФункцииПлан);
		КонецЕсли;	
		Если Не ПустаяСтрока(СокрЛП(Выборка.ИдентификаторФакт)) Тогда
			ИдентификаторФакт 	= "["+СокрЛП(Выборка.ИдентификаторФакт) + "]";
			ИмяФункцииФакт 		= "МенеджерОбъектаШаблона.ПолучитьЗначениеПараметра(Источник, """+ИдентификаторФакт+""", ""ЗначениеФакт"", СоответствиеПараметров)";
			Результат.Вставить(ИдентификаторФакт,	ИмяФункцииФакт);
		КонецЕсли;	
		
	КонецЦикла;
	
КонецПроцедуры  

Функция ПолучитьСоответствиеПараметров() Экспорт
	
	Соответствие = Новый Соответствие;

	Запрос = новый Запрос;
	запрос.Текст = "ВЫБРАТЬ
	               |	CW_ПараметрыГрузоперевозок.Ссылка КАК Ссылка,
	               |	CW_ПараметрыГрузоперевозок.ТипЗначения КАК ТипЗначения,
	               |	CW_ПараметрыГрузоперевозок.Идентификатор КАК Идентификатор,
	               |	CW_ПараметрыГрузоперевозок.ИдентификаторПлан КАК ИдентификаторПлан,
	               |	CW_ПараметрыГрузоперевозок.ИдентификаторФакт КАК ИдентификаторФакт
	               |ИЗ
	               |	ПланВидовХарактеристик.CW_ПараметрыГрузоперевозок КАК CW_ПараметрыГрузоперевозок
	               |ГДЕ
	               |	CW_ПараметрыГрузоперевозок.Служебный = ЛОЖЬ
	               |	И CW_ПараметрыГрузоперевозок.ЭтоГруппа = ЛОЖЬ";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Соответствие.Вставить("["+СокрЛП(Выборка.Идентификатор+"]"), Выборка.Ссылка);
		
		Если Не ПустаяСтрока(СокрЛП(Выборка.ИдентификаторПлан)) Тогда
			Соответствие.Вставить("["+СокрЛП(Выборка.ИдентификаторПлан)+"]", Выборка.Ссылка);
		КонецЕсли;
		Если Не ПустаяСтрока(СокрЛП(Выборка.ИдентификаторФакт)) Тогда
			Соответствие.Вставить("["+СокрЛП(Выборка.ИдентификаторФакт)+"]", Выборка.Ссылка);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Соответствие;
	
КонецФункции 

Функция ИндексКартинкиТипа(ОписаниеТипов)
	
	ИндексКартинки = 8;
	Если ОписаниеТипов.Типы().Количество() = 1 Тогда
		Тип = ОписаниеТипов.Типы()[0];
		Если Тип = Тип("Число") Тогда
			ИндексКартинки = 1;
		ИначеЕсли Тип = Тип("Дата") Тогда
			ИндексКартинки = 2;
		ИначеЕсли Тип = Тип("Булево") Тогда
			ИндексКартинки = 3;
		ИначеЕсли Тип = Тип("Строка") Тогда
			ИндексКартинки = 4;
		ИначеЕсли ОбщегоНазначения.ЭтоСсылка(Тип) Тогда
			ИндексКартинки = 5;
		ИначеЕсли Тип = Тип("УникальныйИдентификатор") Тогда
			ИндексКартинки = 6;
		КонецЕсли;
	ИначеЕсли ОписаниеТипов.Типы().Количество() > 1 Тогда
		ИндексКартинки = 7;
	КонецЕсли;
	
	Возврат ИндексКартинки;
	
КонецФункции 

Функция КартинкаТипа(ОписаниеТипов)
	
	Картинка = БиблиотекаКартинок.ТипНеопределено;
	Если ОписаниеТипов.Типы().Количество() = 1 Тогда
		Тип = ОписаниеТипов.Типы()[0];
		Если Тип = Тип("Число") Тогда
			Картинка = БиблиотекаКартинок.ТипЧисло;
		ИначеЕсли Тип = Тип("Дата") Тогда
			Картинка = БиблиотекаКартинок.ТипДата;
		ИначеЕсли Тип = Тип("Булево") Тогда
			Картинка = БиблиотекаКартинок.ТипБулево;
		ИначеЕсли Тип = Тип("Строка") Тогда
			Картинка = БиблиотекаКартинок.ТипСтрока;
		ИначеЕсли ОбщегоНазначения.ЭтоСсылка(Тип) Тогда
			Картинка = БиблиотекаКартинок.ТипСсылка;
		ИначеЕсли Тип = Тип("УникальныйИдентификатор") Тогда
			Картинка = БиблиотекаКартинок.ТипИдентификатор;
		КонецЕсли;
	ИначеЕсли ОписаниеТипов.Типы().Количество() > 1 Тогда
		Картинка = БиблиотекаКартинок.ТипСоставнойОсновной;
	КонецЕсли;
	
	Возврат Картинка;
	
КонецФункции  
//---Шаблоны стандартных писем

Функция ПолучитьИндексПиктограммыПараметра(Знач Ссылка) Экспорт 
	
	Если Ссылка.ЭтоГруппа Тогда
		Возврат 14;
	КонецЕсли;  
	
	Если Ссылка.ЭтоКонтрольнаяДата Тогда
		Возврат 3;
	КонецЕсли;   
	
	Если Ссылка.ДинамическийПараметр Тогда
		Возврат 12;                                                                       
	КонецЕсли;
	
	Возврат ВариантыОтчетовСлужебныйКлиентСервер.ИндексКартинкиПоля(Ссылка.ТипЗначения);
	
КонецФункции
//Обновление версии
Процедура ЗаполнитьСписокВедущихИВедомыхПараметров() Экспорт
	
	ТаблицаМакросов = CW_Мониторинг.СписокМакросовДинамическихПараметров();
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	CW_ПараметрыГрузоперевозок.Ссылка КАК Ссылка,
	               |	CW_ПараметрыГрузоперевозок.Формула КАК Формула
	               |ИЗ
	               |	ПланВидовХарактеристик.CW_ПараметрыГрузоперевозок КАК CW_ПараметрыГрузоперевозок
	               |ГДЕ
	               |	CW_ПараметрыГрузоперевозок.ДинамическийПараметр = ИСТИНА
	               |	И CW_ПараметрыГрузоперевозок.ПометкаУдаления = ЛОЖЬ";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		ВедущиеПараметры = Новый СписокЗначений;
		
		МакросыФормулы = _сф.стр_СписокМакросов(Выборка.Формула,"{}");
		Для Каждого ЭлементМассива из МакросыФормулы Цикл
			ИмяМакроса = "{"+ЭлементМассива+"}";
			
			Отбор = Новый Структура("Макрос", ИмяМакроса);
			мСтрока = ТаблицаМакросов.НайтиСтроки(Отбор);
			Если мСтрока.Количество() > 0 Тогда
				//Всегда одна строка
				НайденнаяСтрока = мСтрока[0];
				ДобавитьПараметрВСписок(ВедущиеПараметры, НайденнаяСтрока.Параметр);
			КонецЕсли;
			
		КонецЦикла;
		
		Если ВедущиеПараметры.Количество() > 0 Тогда
			ПараметрОбъект = Выборка.Ссылка.ПолучитьОбъект();
			ПараметрОбъект.ВедущиеПараметры.Очистить();
			Для Каждого ЭлементСписка из ВедущиеПараметры Цикл
				НоваяСтрока = ПараметрОбъект.ВедущиеПараметры.Добавить();
				НоваяСтрока.Параметр = ЭлементСписка.Значение;
			КонецЦикла;
			
			ПараметрОбъект.Записать();
		КонецЕсли;
		
	КонецЦикла;
	
	
КонецПроцедуры
	
Процедура ДобавитьПараметрВСписок(ВедущиеПараметры, ТекущийПараметр)
	
	Если ВедущиеПараметры.НайтиПоЗначению(ТекущийПараметр) = Неопределено Тогда
		
		ВедущиеПараметры.Добавить(ТекущийПараметр);
		Для Каждого СтрокаВедущего из ТекущийПараметр.ВедущиеПараметры Цикл
			ДобавитьПараметрВСписок(ВедущиеПараметры, СтрокаВедущего.Параметр);
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры
