&НаКлиенте
Процедура ЗначениеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)

	Если ОграниченСпискомЗначений Тогда
		ВыбратьИзСпискаЗначений(Элемент, СтандартнаяОбработка);
	КонецЕсли;
	
	Если АдресПараметровФормыВыбораСсылочногоТипа <> "" Тогда
		ВыбратьИзДоступныхЗначений(Элемент, СтандартнаяОбработка);
	КонецЕсли; 
	
	Если ИспользоватьФормуВводаАдреса Тогда  
		ВыбратьАдрес(СтандартнаяОбработка);
	КонецЕсли;
	
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьАдрес(СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ПараметрыФормыВводаАдреса = 
		УправлениеКонтактнойИнформациейКлиент.ПараметрыФормыКонтактнойИнформации(
		ОбменСГИСЭПДВызовСервера.ВидФактическийАдресКонтрагента(), 
		ПолноеЗначение);
	
	Оповещение = Новый ОписаниеОповещения("ВводАдреса_Завершение", ЭтотОбъект);
	
	УправлениеКонтактнойИнформациейКлиент.ОткрытьФормуКонтактнойИнформации(ПараметрыФормыВводаАдреса, ЭтаФорма, Оповещение);

КонецПроцедуры

&НаКлиенте
Процедура ВыбратьИзДоступныхЗначений(Элемент, СтандартнаяОбработка)
	
	ДанныеФормыВыбора = ПолучитьИзВременногоХранилища(АдресПараметровФормыВыбораСсылочногоТипа);
	Если Не ПустаяСтрока(ДанныеФормыВыбора.ИмяФормы) Тогда
		
		СтандартнаяОбработка = Ложь;
	
		ОписаниеОповещения = Новый ОписаниеОповещения("ОбработкаВыбораЗначенияИзДоступных",ЭтотОбъект); 
		ОткрытьФорму(ДанныеФормыВыбора.ИмяФормы, 
		ДанныеФормыВыбора.ПараметрыФормы,
		Элемент,,,,
		ОписаниеОповещения,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ВыбратьИзСпискаЗначений(Элемент, СтандартнаяОбработка) 
	
	СтандартнаяОбработка = Ложь;
	
	ОписаниеОповещения 	= Новый ОписаниеОповещения("ОбработкаВыбораЗначенияИзДоступных",ЭтотОбъект);    
	СтруктураПараметров = Новый Структура("Параметр",Параметр);
	
	ОткрытьФорму("ПланВидовХарактеристик.CW_ПараметрыГрузоперевозок.Форма.ФормаВыбораДоступныхЗначенийПараметра", 
		СтруктураПараметров, 
		Элемент,,,,
		ОписаниеОповещения,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры  

&НаКлиенте
Процедура ВводАдреса_Завершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Значение 		= Результат.Представление;
	ПолноеЗначение 	= Результат.КонтактнаяИнформация; 

	ПараметрИзменен 	= Истина;
	
КонецПроцедуры        

&НаКлиенте
Процедура ОбработкаВыбораЗначенияИзДоступных(Ответ, ДополнительныеПараметры) Экспорт 
	
	Если Ответ = Неопределено Тогда    
		Возврат;
	КонецЕсли;
	
	Значение = Ответ;
	ЗначениеПриИзменении(Элементы.Значение);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗначениеНачалоВыбораИзСписка(Элемент, СтандартнаяОбработка)
	
	Если ОграниченСпискомЗначений Тогда
		СтандартнаяОбработка=Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗначениеОткрытие(Элемент, СтандартнаяОбработка)
	
	Если (ТипЗнч(Значение) = Тип("СправочникСсылка.Контрагенты")) Тогда
		
		Если (ПолучитьФункциональнуюОпциюФормы("CW_ИспользованиеCRM")) Тогда
			
			// получаем настройку пользователя
			ИспользоватьСобственнуюФорму = (CW_Настройки.ПолучитьНастройкуПользователя( , "ИспользуемаяФормаКонтрагента") <> 0);
			Если (ИспользоватьСобственнуюФорму) Тогда
				
				СтандартнаяОбработка = Ложь;
				// --- 
				Если (ЗначениеЗаполнено(Значение)) Тогда
					ПФ = Новый Структура("ВидФормы,Ссылка","ФормаКонтрагента",Значение);
					ОткрытьФорму("ОбщаяФорма.CW_ФормаКонтактнойИнформации",ПФ,Элемент,Истина);	
				КонецЕсли; 
				
			КонецЕсли; 
			
		КонецЕсли;
		
	ИначеЕсли (ТипЗнч(Значение) = Тип("СправочникСсылка.ФизическиеЛица")) Тогда 
		
		Если (ПолучитьФункциональнуюОпциюФормы("CW_ИспользованиеCRM")) Тогда
			
			// получаем настройку пользователя
			ИспользоватьСобственнуюФорму = (CW_Настройки.ПолучитьНастройкуПользователя( , "ИспользуемаяФормаКонтрагента") <> 0);
			Если (ИспользоватьСобственнуюФорму) Тогда
				
				СтандартнаяОбработка = Ложь;
				// --- 
				Если (ЗначениеЗаполнено(Значение)) Тогда
					ПФ = Новый Структура("ВидФормы,Ссылка","ФормаФизическогоЛица",Значение);
					ОткрытьФорму("ОбщаяФорма.CW_ФормаКонтактнойИнформации",ПФ,Элемент,Истина);	
				КонецЕсли; 
				
			КонецЕсли; 
			
		КонецЕсли;
		
	КонецЕсли; 
	
КонецПроцедуры





 
 