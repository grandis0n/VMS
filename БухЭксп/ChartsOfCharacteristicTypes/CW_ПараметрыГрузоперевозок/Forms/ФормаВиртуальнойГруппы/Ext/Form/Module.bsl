
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Параметры.Свойство("НоваяГруппа"				, НоваяГруппа);
	
	Параметры.Свойство("НаименованиеГруппы"			, НаименованиеГруппы);
	Параметры.Свойство("ГруппаРазвернута"			, ГруппаРазвернута);
	Параметры.Свойство("РежимГрузоперевозки"		, РежимГрузоперевозки);
	Параметры.Свойство("ДоступнаСменаРежимаСвертки"	, ДоступнаСменаРежимаСвертки);
	
	Элементы.РежимСверткиГруппы.Доступность = ДоступнаСменаРежимаСвертки; 
	
	Если НоваяГруппа Тогда
		
		Если РежимГрузоперевозки Тогда
			ГруппаРазвернута = CW_Настройки.ПолучитьНастройкуПользователя(ПараметрыСеанса.ТекущийПользователь,"РазворачиватьДеревоПараметровГрузоперевозок");		
		Иначе
			ГруппаРазвернута = CW_Настройки.ПолучитьНастройкуПользователя(ПараметрыСеанса.ТекущийПользователь,"РазворачиватьДеревоПараметровЗаявок");	
		КонецЕсли;
		
	КонецЕсли;
	
	РежимСверткиГруппы = ?(ГруппаРазвернута,1,0); 
	
КонецПроцедуры

// ---------------------------------------------------------------------------- 

&НаКлиенте
Процедура КомандаОК(Команда)
	
	Если (ЗначениеЗаполнено(СокрЛП(НаименованиеГруппы))) Тогда
		
		СтруктураВозврата = Новый Структура("НаименованиеГруппы,ГруппаРазвернута", НаименованиеГруппы,РежимСверткиГруппы=1);
		ЭтаФорма.Закрыть(СтруктураВозврата);	
		
	Иначе
		_УФК.ВывестиПредупреждение("Не задано наименование группы!");		
		Возврат;
	КонецЕсли; 
	
КонецПроцедуры

