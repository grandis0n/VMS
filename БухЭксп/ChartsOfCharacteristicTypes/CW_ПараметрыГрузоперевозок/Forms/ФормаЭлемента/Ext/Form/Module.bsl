&НаСервере
Функция _ПроверитьУникальностьВведенногоЗначения(ИдентификаторСтроки)
	// --- 
	
	СтрокаПроверяемогоЗначения = Объект.ДоступныеЗначения.НайтиПоИдентификатору(ИдентификаторСтроки);
	ПроверяемоеЗначение = СтрокаПроверяемогоЗначения.ДоступноеЗначение;
	
	// --- 
	
	ДоступныеЗначения = Объект.ДоступныеЗначения.Выгрузить(,"ДоступноеЗначение");
	ДоступныеЗначения.Колонки.Добавить("Количество");
	ДоступныеЗначения.ЗаполнитьЗначения(1,"Количество");
	Если (Объект.ТипЗначения = Новый ОписаниеТипов("Строка")) Тогда
		Для каждого Стр Из ДоступныеЗначения Цикл
			
			Стр.ДоступноеЗначение = СокрЛП(ВРег(Стр.ДоступноеЗначение));
			
		КонецЦикла;
		ПроверяемоеЗначение = СокрЛП(ВРег(ПроверяемоеЗначение));
	КонецЕсли; 
	
	ДоступныеЗначения.Свернуть("ДоступноеЗначение","Количество");
	// --- 
	Для каждого Стр Из ДоступныеЗначения Цикл
		
		Если (Стр.Количество > 1) Тогда
			
			Если (Стр.ДоступноеЗначение = ПроверяемоеЗначение) Тогда
				
				Объект.ДоступныеЗначения.Удалить(Объект.ДоступныеЗначения.Индекс(СтрокаПроверяемогоЗначения));
				Возврат(_УФКС.Ответ(1,"Введено неуникальное значение"));
				
			КонецЕсли;  
			
		КонецЕсли; 
		
	КонецЦикла; 
	
	// --- 
	
	Возврат(_УФКС.Ответ());
	
	// --- 
КонецФункции

