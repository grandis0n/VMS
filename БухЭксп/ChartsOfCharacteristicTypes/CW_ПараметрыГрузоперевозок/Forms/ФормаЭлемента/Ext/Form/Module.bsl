&НаКлиенте
Процедура ПараметрыОтбораЗначениеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ТД = Элементы.ПараметрыОтбора.ТекущиеДанные;
	
	// сначала проверяем, не используется ли параметр
	Если (ТД.ВидУсловия = ПредопределенноеЗначение("Перечисление.CW_ВидыУсловийОтбораПараметров.Значение")) Тогда 
		
		// определяем тип значения текущего реквизита 
		ТипЗначения = _ПолучитьТипРеквизитаОтбора(ТД.РеквизитОтбора);
		Если ТипЗначения <> Неопределено Тогда
			
			Элемент.ОграничениеТипа = ТипЗначения;
			Элемент.ВыбиратьТип = (ТипЗначения.Типы().Количество() <> 1);
						
		КонецЕсли;
		
	ИначеЕсли (ТД.ВидУсловия = ПредопределенноеЗначение("Перечисление.CW_ВидыУсловийОтбораПараметров.Реквизит")) Тогда 
		
		СтандартнаяОбработка = Ложь;
		
		// открываем форму выбора реквизита
		ПОВ = Новый ОписаниеОповещения("ОбработкаВыбораРеквизитаДляОтбора",ЭтотОбъект, Новый Структура()); 
		СписокРеквизитов = _СписокРеквизитов();
		ПоказатьВыборИзСписка(ПОВ,СписокРеквизитов,Элемент);
		
	ИначеЕсли (ТД.ВидУсловия = ПредопределенноеЗначение("Перечисление.CW_ВидыУсловийОтбораПараметров.Параметр")) Тогда
		
		СтандартнаяОбработка = Ложь;
		// --- 
		// открываем форму выбора параметра грузоперевозки
		ПОВ = Новый ОписаниеОповещения("ОбработкаВыбораПараметраДляОтбора",ЭтотОбъект); 
		ОткрытьФорму("ПланВидовХарактеристик.CW_ПараметрыГрузоперевозок.ФормаВыбора",Новый Структура("РежимВыбора",Истина),Элемент,,,,ПОВ, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
	КонецЕсли; 
	
КонецПроцедуры

