	Если (Ответ <> Неопределено) Тогда
		
		Результат = _ДобавитьПараметрВТипыГрузоперевозок(Ответ);
		Если (_УФКС.ВыполненоУспешно(Результат)) Тогда
			
			ПоказатьПредупреждение(,"Параметр успешно добавлен.");
			
		Иначе
			
			ПоказатьПредупреждение(,_УФКС.ПредставлениеОшибки(Результат));
			
		КонецЕсли;
		
		Элементы.СписокТиповПеревозок.Обновить();
		
	КонецЕсли; 
	
	// --- 
