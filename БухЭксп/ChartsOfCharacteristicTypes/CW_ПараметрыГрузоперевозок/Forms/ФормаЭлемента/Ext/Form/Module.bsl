&НаСервере
Функция _ДобавитьПараметрВТипыГрузоперевозок(ТипыГП)
	// --- 
	
	Попытка
		
		Для каждого ТипГП Из ТипыГП Цикл
			
			// проверяем, что в типе нет ещё этого параметра
			СтрокаПараметра = _сф.к_НайтиСтроку(ТипГП.ПараметрыГрузоперевозки,"Параметр",Объект.Ссылка);
			Если (СтрокаПараметра = Неопределено) Тогда
				
				ТипОбъект = ТипГП.ПолучитьОбъект();
				Нстр = ТипОбъект.ПараметрыГрузоперевозки.Добавить();
				Нстр.Параметр = Объект.Ссылка;
				ТипОбъект.Записать();
				
			КонецЕсли; 
			
		КонецЦикла;
		
	Исключение
		
		Возврат(_УФКС.Ответ(1,ОписаниеОшибки()));
		
	КонецПопытки; 
	
	Возврат(_УФКС.Ответ());
	 
	// --- 
КонецФункции

&НаКлиенте
Процедура УдалитьПараметрИзТипаПеревозки(Команда)
	
	Результат = _УдалитьПараметрИзВыбранныхТипов(Элементы.СписокТиповПеревозок.ВыделенныеСтроки);	
	Если (_УФКС.ВыполненоУспешно(Результат)) Тогда
		
		ПоказатьПредупреждение(,"Параметр успешно удалён.");
		
	Иначе
		
		ПоказатьПредупреждение(,_УФКС.ПредставлениеОшибки(Результат));
		
	КонецЕсли;
	
	Элементы.СписокТиповПеревозок.Обновить();
	
КонецПроцедуры

&НаСервере
Функция _УдалитьПараметрИзВыбранныхТипов(Знач МассивТипов)
	// --- 
	
	Попытка
		
		Для каждого ТипГП Из МассивТипов Цикл
			
			ТипОбъект = ТипГП.ПолучитьОбъект();
			СтрокаПараметра = _сф.к_НайтиСтроку(ТипОбъект.ПараметрыГрузоперевозки,"Параметр",Объект.Ссылка);
			Если (СтрокаПараметра <> Неопределено) Тогда
				
				ТипОбъект.ПараметрыГрузоперевозки.Удалить(СтрокаПараметра);
				
			КонецЕсли; 
			ТипОбъект.Записать();
			
		КонецЦикла;
		
	Исключение
		
		Возврат(_УФКС.Ответ(1,ОписаниеОшибки()));
		
	КонецПопытки; 
	
	Возврат(_УФКС.Ответ()); 
	
	// --- 
КонецФункции

