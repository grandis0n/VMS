
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЭтаФорма.ТолькоПросмотр 				= (НЕ CW_ПраваДоступа.ПравоДоступно("РедактированиеНастроекМониторинга") ИЛИ Объект.ТолькоПросмотр);
	ИспользованиеДинамическихПараметров 	= ПолучитьФункциональнуюОпцию("CW_ИспользованиеДинамическихПараметров");
	
	_УФС.ОтключитьИсториюВыбораЭлементовФормы(ЭтаФорма);
	
	Если  ИспользованиеДинамическихПараметров Тогда
		Элементы.ПереключательКД.СписокВыбора.Добавить(2, "динамический параметр");
	КонецЕсли;
	
	Если Объект.ЭтоКонтрольнаяДата Тогда
		ПереключательКД=1;
	ИначеЕсли Объект.ДинамическийПараметр Тогда 
		ПереключательКД=2;
	КонецЕсли; 
	
	// ---------------------------------------------------------------------------- 
	
	#Область ФормированиеМакросов 
	
	Макросы = CW_Мониторинг.СписокМакросовДинамическихПараметров();
	ТаблицаМакросов.Загрузить(Макросы);
	
	#КонецОбласти 
	
	#Область ФормированиеФормул
	
		СписокФормул = Новый СписокЗначений;
		СписокФормул.Добавить("ТекущаяДата()",					"Текущая дата");
		СписокФормул.Добавить("РазностьДат(<Дата1>,<Дата2>)",	"Разность дат (в днях)");
	
		Для каждого Элемент Из СписокФормул Цикл
			Нстр = ТаблицаФормул.Добавить();
			Нстр.Макрос 		= Элемент.Значение;
			Нстр.Описание 		= Элемент.Представление;
			Нстр.ИндексКартинки = 3;
		КонецЦикла; 
	
	#КонецОбласти 
	
	ЗаполнитьВедущиеПараметры();
	
	// ---------------------------------------------------------------------------- 
	
	УО = РеквизитФормыВЗначение("Объект").ХранилищеУсловногоОформления.Получить();
	Если (УО <> Неопределено) Тогда
		
		АдресУО = ПоместитьВоВременноеХранилище(УО,ЭтаФорма.УникальныйИдентификатор);
		
	КонецЕсли; 
	
	ИспользованиеПодключаемыхОбработокПриИзмененииПараметров  = ПолучитьФункциональнуюОпцию("CW_ИспользованиеПодключаемыхОбработокПриИзмененииПараметров");
	
	Элементы.ГруппаПередНачаломВыбора.Видимость 		= ИспользованиеПодключаемыхОбработокПриИзмененииПараметров и Не Объект.ИспользоватьФормуВыбораОбъекта;
	Элементы.ГруппаОбработкаИзменения.Видимость 		= ИспользованиеПодключаемыхОбработокПриИзмененииПараметров;
	
	Если Параметры.Ключ.пустая() и Не ЗначениеЗаполнено(Параметры.ЗначениеКопирования) Тогда
		Объект.ТипЗначения = Новый ОписаниеТипов("Строка");
	КонецЕсли;
	
	_ОтборПоПравам();
	_ПроверитьТипЗначения();
	_УправлениеЭлементамиФормы();
	
КонецПроцедуры    

//Ведущие и ведомые
&НаСервере
Процедура ЗаполнитьВедущиеПараметры()
	
	Для каждого СтрокаВедущих из Объект.ВедущиеПараметры Цикл
		ВедущиеПараметры.Добавить(СтрокаВедущих.Параметр);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьВедущиеПараметры(ТекущийОбъект)
	
	ТекущийОбъект.ВедущиеПараметры.Очистить();
	Для каждого ЭлементСписка из ВедущиеПараметры Цикл
		НоваяСтрока = ТекущийОбъект.ВедущиеПараметры.Добавить();
		НоваяСтрока.Параметр = ЭлементСписка.Значение;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьВедущиеПараметрыПоФормуле()
	
	ВедущиеПараметры.Очистить();
	
	//Добавляем новые
	МакросыФормулы = _сф.стр_СписокМакросов(Объект.Формула,"{}");
	
	Для Каждого ЭлементМассива из МакросыФормулы Цикл
		ИмяМакроса = "{"+ЭлементМассива+"}";
		
		Отбор = Новый Структура("Макрос", ИмяМакроса);
		мСтрока = ТаблицаМакросов.НайтиСтроки(Отбор);
		Если мСтрока.Количество() > 0 Тогда
			//Всегда одна строка
			НайденнаяСтрока = мСтрока[0];
			ДобавитьПараметрВСписок(ВедущиеПараметры, НайденнаяСтрока.Параметр);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьПараметрВСписок(ВедущиеПараметры, ТекущийПараметр)
	
	Если ВедущиеПараметры.НайтиПоЗначению(ТекущийПараметр) = Неопределено Тогда
		
		ВедущиеПараметры.Добавить(ТекущийПараметр);
		
		//Если у текущего параметра есть ведущие, то добавим в списко и их (ведущие второго и третьего уровня)
		Для Каждого СтрокаВедущего из ТекущийПараметр.ВедущиеПараметры Цикл
			ДобавитьПараметрВСписок(ВедущиеПараметры, СтрокаВедущего.Параметр);
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры
//Ведущие и ведомые

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	Если НЕ Объект.Ссылка.Пустая() Тогда
		
		ИзменилосьНаименование = ЗначениеРеквизитаИзменилосьНаСервере("Наименование");
		                                                                              
		Если ИзменилосьНаименование и НЕ ПродолжитьЗапись Тогда
			Отказ = Истина;
			
			ТекстВопроса = "Изменение наименования параметра может повлечь 
			               |за собою возникновение программных ошибок                                
						   |в отчетах или списках, в которых данный параметр  
			               |используется в качестве отборов или группировок.  
			               |Перенастройка таких отборов и группировок должна  
			               |быть произведена пользователем самостоятельно 
						   |в ручном режиме. Продолжить?";
			
			Режим = РежимДиалогаВопрос.ДаНет;          
			
			ДополнительынеПараметры = Новый Структура;
			ДополнительынеПараметры.Вставить("ПараметрыЗаписи", ПараметрыЗаписи);
			
			Оповещение = Новый ОписаниеОповещения("ПродолжитьЗаписьПараметра", ЭтотОбъект, ДополнительынеПараметры);
			ПоказатьВопрос(Оповещение, ТекстВопроса, Режим, 0);
			
		КонецЕсли;
		
		Если ТипЗначенияИзменен Тогда
			Отказ = Истина;
			ДиалогПодтвержденияИзмененияТипа();
		КонецЕсли;
		
	КонецЕсли;  
	
	Если ПродолжитьЗапись Тогда
		ПродолжитьЗапись = Не ПродолжитьЗапись;
	КонецЕсли;
	
КонецПроцедуры 

&НаКлиенте
Процедура ПродолжитьЗаписьПараметра(Результат, ДополнительынеПараметры) Экспорт
    Если Результат = КодВозвратаДиалога.Нет Тогда
        Возврат;
    КонецЕсли;

    ПродолжитьЗапись = Истина;
	ЭтаФорма.Записать(ДополнительынеПараметры.ПараметрыЗаписи);

КонецПроцедуры

&НаСервере
Функция ЗначениеРеквизитаИзменилосьНаСервере(ИмяРеквизита)
	
	Возврат Объект[ИмяРеквизита] <> Объект.Ссылка[ИмяРеквизита];
	
КонецФункции

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	Если (ЭтоАдресВременногоХранилища(АдресУО)) Тогда
		Нечто = ПолучитьИзВременногоХранилища(АдресУО);
		ТекущийОбъект.ХранилищеУсловногоОформления = Новый ХранилищеЗначения(Нечто);
	КонецЕсли; 
	
	ТекущийОбъект.СформироватьИдентификатор();
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	CW_ПараметрыГрузоперевозок.Ссылка
	|ИЗ
	|	ПланВидовХарактеристик.CW_ПараметрыГрузоперевозок КАК CW_ПараметрыГрузоперевозок
	|ГДЕ
	|	CW_ПараметрыГрузоперевозок.Идентификатор = &Идентификатор
	|	И CW_ПараметрыГрузоперевозок.Ссылка <> &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", ТекущийОбъект.Ссылка);
	Запрос.УстановитьПараметр("Идентификатор", ТекущийОбъект.Идентификатор); 
	ТЗ = Запрос.Выполнить().Выгрузить();
	Если ТЗ.Количество() <> 0 Тогда
		
		Отказ = Истина;
		Сообщить("Неуникальное наименование параметра. Параметр с таким именем уже существует.",СтатусСообщения.Внимание);
		Возврат;
		
	КонецЕсли; 	
	
	Если ИзмененаФормула Тогда
		ОбновитьВедущиеПараметрыПоФормуле();
		ЗаписатьВедущиеПараметры(ТекущийОбъект);
	КонецЕсли;
	
	ОповещатьОбИзмененииПараметра = Истина;
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	_ОтборПоПравам();
	
	ЗаполнитьВедущиеПараметры();
	
	ИзмененаФормула = Ложь;

	_УправлениеЭлементамиФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	CW_МониторинговыеПараметрыКлиент.ОбновитьНаименованияСвязанныхПараметров(ЭтаФорма, Объект.Ссылка);
	
	Если ОповещатьОбИзмененииПараметра Тогда
		
		ОповещатьОбИзмененииПараметра = Ложь;
		Оповестить("ПараметрИзменен",Объект.Ссылка);
		
	КонецЕсли; 
	
КонецПроцедуры

&НаСервере
Процедура _УправлениеЭлементамиФормы()
	
	// для динамического параметра отобразим станицу с формулой
	Элементы.СтраницаДинамическийПараметр.Видимость = (Объект.ДинамическийПараметр);
	
	Элементы.ТипЗначения.Видимость = (НЕ Объект.ЭтоКонтрольнаяДата);
	Элементы.ФорматВывода.Видимость = ДоступенФорматВывода;
	Элементы.КонтрольнаяДатаИспользуетВремя.Видимость = (Объект.ЭтоКонтрольнаяДата);
	
	Элементы.ОграниченСпискомЗначений.Видимость = (НЕ Объект.ЭтоКонтрольнаяДата);
	
	// для динамических параметров спрячем дополнительные опции
	Элементы.ГруппаОпции.Видимость = (НЕ Объект.ДинамическийПараметр);
	
	Элементы.МножественноеПрямоеРедактирование.Доступность = Объект.ПрямоеРедактирование;
	
	Элементы.ЛимитПросрочки.Видимость = (Объект.ЭтоКонтрольнаяДата);
	
	// ---------------------------------------------------------------------------- 
	
	Элементы.ГруппаКонтрольИзменения.Видимость = Объект.КонтрольИзменения;
	
	// ---------------------------------------------------------------------------- 
	
	Элементы.ГруппаИспользоватьОтбор.Видимость = ЭтоСсылочныйТип;
	Элементы.СтраницаПараметрыОтбора.Видимость = Объект.ИспользованиеОтбора;
	Если Объект.ИспользованиеОтбора Тогда 
		Элементы.ПараметрыОтбора.Видимость = (Объект.ВариантОтбора=Перечисления.CW_ВариантыОтбораДляПараметров.СтандартныйОтбор);
		Элементы.ВнешняяОбработкаОтбора.Видимость = (Объект.ВариантОтбора=Перечисления.CW_ВариантыОтбораДляПараметров.ВнешняяОбработка);
	КонецЕсли;
	
	// --- 
	
	Элементы.ВнешняяОбработкаИзменения.Видимость 			= Объект.ОбработкаИзменения;
	Элементы.ВнешняяОбработкаПередНачаломВыбора.Видимость 	= Объект.ИспользуетсяОбработкаПередНачаломВыбора;
	
	// ---------------------------------------------------------------------------- 
	
	Элементы.СтраницаПредопределенныеЗначения.Видимость = (Объект.ОграниченСпискомЗначений);
	Элементы.СтраницаПрава.Видимость = (НЕ Объект.Ссылка.Пустая() И CW_ПраваДоступа.ПравоДоступно("РедактированиеНастроекМониторинга"));
	Элементы.СтраницаТипыПеревозок.Видимость = (НЕ Объект.Ссылка.Пустая());
	
	// --- 
	Элементы.ИспользоватьФормуВыбораОбъекта.Видимость 	= ЭтоСсылочныйТип;
	
	// ---
	Элементы.ОткрытьСписокДополнительныхЗначенийПараметра.Видимость = Объект.ИспользуютсяДополнительныеЗначения;
	
	Элементы.ГруппаОпцииВложенная.Доступность = Не Объект.НеПоказыватьВФормеГрузоперевозок;
	
	Элементы.ИспользоватьФормуВводаАдреса.Видимость = Объект.ТипЗначения.СодержитТип(Тип("Строка"));
	
КонецПроцедуры

&НаСервере
Процедура _ПроверитьТипЗначения()
	// --- 
	
	Если Объект.ЭтоКонтрольнаяДата Тогда 
		ЭтоСсылочныйТип = Ложь;
		ДоступенФорматВывода = Истина;
		Объект.ТипЗначения = Новый ОписаниеТипов("Дата");
		СтрокаТипа = Строка(Объект.ТипЗначения);
		Возврат;
	КонецЕсли;
	
	Если Объект.ТипЗначения.Типы().Количество() <> 1 Тогда
		Объект.ТипЗначения = Новый ОписаниеТипов("Строка");
	КонецЕсли; 
	
	ТипПараметра 			= Объект.ТипЗначения.Типы()[0];
	СтрокаТипа 				= Строка(ТипПараметра);
	ЭтоСсылочныйТип 		= _сф.тип_Ссылочный(ТипПараметра);
	ДоступенФорматВывода 	= Ложь; 
	ЭтоПеречисление 		= Перечисления.ТипВсеСсылки().СодержитТип(ТипПараметра);
	
	Если ЭтоСсылочныйТип Тогда
		// сформируем список выбора для параметров отбора    ОбъектМетаданных
		СписокВыбора = Новый СписокЗначений;
		СсылкаТипа = Новый(ТипПараметра);
		МетаданныеСсылки = СсылкаТипа.Метаданные();
		
		ТипыПолейОтбора = Новый Соответствие;
		
		Для каждого Реквизит Из МетаданныеСсылки.СтандартныеРеквизиты Цикл
			ИмяОтбора = "Отбор."+Реквизит.Имя;
			
			СписокВыбора.Добавить(ИмяОтбора);
			ТипыПолейОтбора.Вставить(ИмяОтбора, Реквизит.Тип);
		КонецЦикла; 
		
		Если Не ЭтоПеречисление Тогда
			Для каждого Реквизит Из МетаданныеСсылки.Реквизиты Цикл   
				ИмяОтбора = "Отбор."+Реквизит.Имя;
				
				СписокВыбора.Добавить(ИмяОтбора);
				ТипыПолейОтбора.Вставить(ИмяОтбора, Реквизит.Тип);
			КонецЦикла;                  
		КонецЕсли;
		
		Элементы.ПараметрыОтбораРеквизитОтбора.СписокВыбора.Очистить();
		Элементы.ПараметрыОтбораРеквизитОтбора.СписокВыбора.ЗагрузитьЗначения(СписокВыбора.ВыгрузитьЗначения());
		
		ОписаниеТиповОтбора = Новый ФиксированноеСоответствие(ТипыПолейОтбора);
		
	Иначе
		
		Если ТипПараметра = Тип("Булево")
			ИЛИ ТипПараметра = Тип("Число")
			ИЛИ ТипПараметра = Тип("Дата") 
		Тогда
			ДоступенФорматВывода = Истина;
		КонецЕсли; 
		
		Если (Объект.ИспользованиеОтбора) Тогда
			
			Объект.ИспользованиеОтбора = Ложь;
			
		КонецЕсли; 
		
	КонецЕсли; 
	
	Если (Объект.ОграниченСпискомЗначений) Тогда
		
		Элементы.ДоступныеЗначенияДоступноеЗначение.ВыбиратьТип=Ложь;
		Элементы.ДоступныеЗначенияДоступноеЗначение.ОграничениеТипа = Объект.ТипЗначения;
		
		Если Объект.ИспользуютсяДополнительныеЗначения Тогда
			//нужен отбор по владельцу
			МассивСвязиПараметровВыбора = новый Массив;
			МассивСвязиПараметровВыбора.Добавить(Новый СвязьПараметраВыбора("Отбор.Владелец", "Объект.Ссылка"));
			
			СвязиПараметровВыбора = Новый ФиксированныйМассив(МассивСвязиПараметровВыбора);
			
			Элементы.ДоступныеЗначенияДоступноеЗначение.СвязиПараметровВыбора = СвязиПараметровВыбора;
		КонецЕсли;
		
	КонецЕсли; 
	
	// проверяем
	Если (НЕ Объект.Ссылка.Пустая()) Тогда
		
		Если (Объект.ТипЗначения <> Объект.Ссылка.ТипЗначения) Тогда
			
			ТипЗначенияИзменен = Истина;
			
		Иначе
			
			ТипЗначенияИзменен = Ложь;
			
		КонецЕсли; 
		
	КонецЕсли;    
	
	//ХранениеПолногоЗначения 
	Если Не Объект.ТипЗначения.СодержитТип(Тип("Строка")) Тогда
		Объект.СохранятьПолноеЗначениеПараметра = Ложь;
	Конецесли;  
	
	Элементы.СохранятьПолноеЗначениеПараметра.Видимость = Объект.ТипЗначения.СодержитТип(Тип("Строка"));
	//---ХранениеПолногоЗначения
	
КонецПроцедуры

&НаСервере
Функция _ОтборПоПравам()
	// --- 
	
	Если (НЕ Объект.Ссылка.Пустая()) Тогда
		
		ПраваДоступа.Отбор.Элементы.Очистить();
		_УФС.ДобавитьОтбор(ПраваДоступа.Отбор,"Параметр",,Объект.Ссылка);
		
		// --- 
		
		_УФС.ДобавитьОтбор(СписокТиповПеревозок.Отбор,"ПараметрыГрузоперевозки.Параметр",,Объект.Ссылка);
		
	КонецЕсли;
	
	// --- 
КонецФункции

