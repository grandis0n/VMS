Процедура ОбработкаПолученияФормы(ВидФормы, Параметры, ВыбраннаяФорма, ДополнительнаяИнформация, СтандартнаяОбработка)
	
	Если ВидФормы <> "ФормаГруппы" Тогда
		Возврат;
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	
	ВыбраннаяФорма = "ФормаГруппы";
	
	СписокПриказов = ПланыВидовХарактеристик.CW_РеестрыНДС0ЯчейкиПриложений.ПолучитьСписокПриказов();
	Приказы = СписокПриказов.ВыгрузитьЗначения();
	
	Если Параметры.Свойство("Ключ") Тогда
		
		Если ЗначениеЗаполнено(Параметры.Ключ) Тогда  
			Если Приказы.Найти(Параметры.Ключ) = Неопределено Тогда
				ВыбраннаяФорма = "ФормаПриложения";
			Иначе
				ВыбраннаяФорма = "ФормаПриказа";
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры


