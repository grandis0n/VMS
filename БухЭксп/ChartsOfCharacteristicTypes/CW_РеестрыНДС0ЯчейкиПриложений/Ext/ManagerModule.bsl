Процедура ЗаполнитьЯчейкиОтчета(Знач ОписаниеЯчеек, Знач Родитель)
	
	Для Каждого СтрокаОписания из ОписаниеЯчеек Цикл 
		
		НайденнаяСсылка = ПланыВидовХарактеристик.CW_РеестрыНДС0ЯчейкиПриложений.НайтиПоРеквизиту("ИмяЯчейки",СтрокаОписания.ИмяЯчейки, Родитель);  
		Если НайденнаяСсылка.Пустая() Тогда
			ОписаниеЯчейки = ПланыВидовХарактеристик.CW_РеестрыНДС0ЯчейкиПриложений.СоздатьЭлемент();  
		Иначе
			ОписаниеЯчейки = НайденнаяСсылка.ПолучитьОбъект();  
		КонецЕсли;
		
		ОписаниеЯчейки.Родитель 				= Родитель;
		ОписаниеЯчейки.Наименование				= СтрокаОписания.Наименование;
		ОписаниеЯчейки.ИмяГруппы 				= СтрокаОписания.ИмяГруппы;
		ОписаниеЯчейки.ИмяЯчейки 				= СтрокаОписания.ИмяЯчейки;
		ОписаниеЯчейки.НомерКолонки 			= СтрокаОписания.НомерКолонки;
		ОписаниеЯчейки.ТипЗначения  			= СтрокаОписания.Тип;  
		ОписаниеЯчейки.ЯчейкаНумерации 			= СтрокаОписания.Нумерация;
		ОписаниеЯчейки.ЯчейкаНалоговаяБаза 		= СтрокаОписания.НалоговаяБаза;  
		ОписаниеЯчейки.ЯчейкаПримечание 		= СтрокаОписания.Примечание; 
		ОписаниеЯчейки.КонтролироватьЗаполнение = СтрокаОписания.КонтролироватьЗаполнение; 
		
		
		ОписаниеЯчейки.Записать();
	КонецЦикла;

КонецПроцедуры 

Функция ПолучитьОписанияЯчеек(ИмяМакета)        
	
	ОписаниеЯчеек = Новый ТаблицаЗначений;
	ОписаниеЯчеек.Колонки.Добавить("НомерКолонки", 	Новый ОписаниеТипов("Число"));
	ОписаниеЯчеек.Колонки.Добавить("ИмяГруппы", 	Новый ОписаниеТипов("Строка"));
	ОписаниеЯчеек.Колонки.Добавить("ИмяЯчейки", 	Новый ОписаниеТипов("Строка"));
	ОписаниеЯчеек.Колонки.Добавить("Тип");
	ОписаниеЯчеек.Колонки.Добавить("НалоговаяБаза", Новый ОписаниеТипов("Булево"));
	ОписаниеЯчеек.Колонки.Добавить("Нумерация", 	Новый ОписаниеТипов("Булево"));   
	ОписаниеЯчеек.Колонки.Добавить("Примечание", 	Новый ОписаниеТипов("Булево"));   
	ОписаниеЯчеек.Колонки.Добавить("КонтролироватьЗаполнение", 	Новый ОписаниеТипов("Булево"));
	ОписаниеЯчеек.Колонки.Добавить("Наименование",  Новый ОписаниеТипов("Строка"));
	
	Макет = ПланыВидовХарактеристик.CW_РеестрыНДС0ЯчейкиПриложений.ПолучитьМакет(ИмяМакета);
	
	ВысотаТаблицы = Макет.ВысотаТаблицы;
	
	//1 - Номер колонки	
	//2 - Раздел
	//3 - Ключ	
	//4 - Тип	   
	//5 - Налоговая база	
	//6 - Нумерация  
	//7 - ОбязательноДляЗаполнения  
	//8 - Наименование  
	
	Для НомерСтроки = 2 По Макет.ВысотаТаблицы Цикл
		
		НоваяСтрока = ОписаниеЯчеек.Добавить();
		
		НоваяСтрока.НомерКолонки 	= Число(Макет.Область(НомерСтроки, 1, НомерСтроки, 1).Текст);
		НоваяСтрока.ИмяГруппы 		= СокрЛП(Макет.Область(НомерСтроки, 2, НомерСтроки, 2).Текст);
		НоваяСтрока.ИмяЯчейки 		= СокрЛП(Макет.Область(НомерСтроки, 3, НомерСтроки, 3).Текст); 
		
		Тип = СокрЛП(Макет.Область(НомерСтроки, 4, НомерСтроки, 4).Текст);	
		Если Тип = "Строка" или Тип = "Булево" Тогда
			НоваяСтрока.Тип = Новый ОписаниеТипов(Тип);
		КонецЕсли;
		Если Тип = "Дата" Тогда
			НоваяСтрока.Тип = Новый ОписаниеТипов(Тип,,,,,Новый КвалификаторыДаты(ЧастиДаты.Дата));
		КонецЕсли;
		Если Тип = "Число" Тогда
			НоваяСтрока.Тип = Новый ОписаниеТипов(Тип,,,Новый КвалификаторыЧисла(16,2));
		КонецЕсли;
		
		НалоговаяБаза 	= СокрЛП(Макет.Область(НомерСтроки, 5, НомерСтроки, 5).Текст);	
		НоваяСтрока.НалоговаяБаза = ?(НалоговаяБаза = "+", Истина, Ложь);
			
		Нумерация 	= СокрЛП(Макет.Область(НомерСтроки, 6, НомерСтроки, 6).Текст);	
		НоваяСтрока.Нумерация = ?(Нумерация = "+", Истина, Ложь);
		
		Примечание 	= СокрЛП(Макет.Область(НомерСтроки, 7, НомерСтроки, 7).Текст);	
		НоваяСтрока.Примечание = ?(Примечание = "+", Истина, Ложь);
		
		КонтролироватьЗаполнение 	= СокрЛП(Макет.Область(НомерСтроки, 8, НомерСтроки, 8).Текст);	
		НоваяСтрока.КонтролироватьЗаполнение = ?(КонтролироватьЗаполнение = "+", Истина, Ложь);

		НоваяСтрока.Наименование 	= СокрЛП(Макет.Область(НомерСтроки, 9, НомерСтроки, 9).Текст);   
		
	КонецЦикла;	
	
	Возврат ОписаниеЯчеек;
	
КонецФункции
	
Функция ВыполнитьНастройкиМониторинговыхПарамтеров() Экспорт
	
