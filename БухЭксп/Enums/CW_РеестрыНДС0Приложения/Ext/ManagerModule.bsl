
Функция ПолучитьСписокПриложений() Экспорт
	
	СписокЗначений = Новый СписокЗначений;
	СписокЗначений.Добавить(Перечисления.CW_РеестрыНДС0Приложения.ЖД);
	СписокЗначений.Добавить(Перечисления.CW_РеестрыНДС0Приложения.АВТО);
	СписокЗначений.Добавить(Перечисления.CW_РеестрыНДС0Приложения.АВИА);
	СписокЗначений.Добавить(Перечисления.CW_РеестрыНДС0Приложения.МОРЕ);
	
	Возврат СписокЗначений;
	
КонецФункции