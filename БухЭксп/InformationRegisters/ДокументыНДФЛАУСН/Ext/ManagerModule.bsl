#Область ПрограммныйИнтерфейс

// Возвращает описание реквизитов документа НДФЛ
//
// Параметры:
//  Документ - ДокументСсылка.СписаниеСРасчетногоСчета - ссылка на документ
//  Организация - СправочникСсылка.Организации - организация документа
//
// Возвращаемое значение:
//  Структура:
//   * Документ - ДокументСсылка.СписаниеСРасчетногоСчета - ссылка на документ
//   * Организация - СправочникСсылка.Организации - организация документа
//   * Идентификатор - Строка - идентификатор документа
//   * Статус - ПеречислениеСсылка.СтатусыРасчетовНДФЛАУСН - статус документа
//   * ТекстОшибки - Строка - текст ошибки из входящего запроса РасчетНДФЛ сервсиса
//   * ИдентификаторИсходящегоЗапроса - Строка - идентификатор исходящего запроса РасчетНДФЛ сервиса
//   * ИдентификаторВходящегоЗапроса - Строка - идентификатор входящего запроса РасчетНДФЛ сервиса
//   * ДатаДокумента - дата документа
//
Функция НовыйРеквизитыДокумента(Документ, Организация) Экспорт
	
	ПараметрыЗапроса = Новый Структура;
	ПараметрыЗапроса.Вставить("Документ", Документ);
	ПараметрыЗапроса.Вставить("Организация", Организация);
	ПараметрыЗапроса.Вставить("Идентификатор", "");
	ПараметрыЗапроса.Вставить("Статус", Перечисления.СтатусыРасчетовНДФЛАУСН.ПустаяСсылка());
	ПараметрыЗапроса.Вставить("ТекстОшибки", "");
	ПараметрыЗапроса.Вставить("ИдентификаторИсходящегоЗапроса", "");
	ПараметрыЗапроса.Вставить("ИдентификаторВходящегоЗапроса", "");
	ПараметрыЗапроса.Вставить("ДатаДокумента", '00010101');
	
	Возврат ПараметрыЗапроса;
	
КонецФункции

// Создает или изменяет запись в регистре по переданным реквизитам документа НДФЛ
//
// Параметры:
//  РеквизитыДокумента - Структура - см. НовыйРеквизитыДокумента()
//
Процедура ИзменитьДокумент(РеквизитыДокумента) Экспорт
	
	Набор = СоздатьНаборЗаписей();
	Набор.Отбор.Документ.Установить(РеквизитыДокумента.Документ);
	Запись = Набор.Добавить();
	ЗаполнитьЗначенияСвойств(Запись, РеквизитыДокумента);
	Набор.Записать();
	
КонецПроцедуры

// Возвращает значения измерений, ресурсов и реквизитов записи, устанавливая отбор в зависимости от переданных
// параметров
//
// Параметры:
//  Документ - ДокументСсылка.СписаниеСРасчетногоСчета, Неопределено -
//             заполняется, если требуется отбор по значению измерения Документ
//  Идентификатор - Строка, Неопределено - заполняется, если требуется отбор по значению ресурса Идентификатор
//
// Возвращаемое значение:
//  Структура - см. НовыйРеквизитыДокумента - реквизиты документа
//  Неопределено - в случае, если не переданы параметры отбора или нет записи о документе в регистре
//
Функция ДанныеДокумента(Документ = Неопределено, Идентификатор = Неопределено) Экспорт
	
	ТекстЗапроса =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ДокументыНДФЛАУСН.Организация КАК Организация,
		|	ДокументыНДФЛАУСН.Документ КАК Документ,
		|	ДокументыНДФЛАУСН.Идентификатор КАК Идентификатор,
		|	ДокументыНДФЛАУСН.Статус КАК Статус,
		|	ДокументыНДФЛАУСН.ТекстОшибки КАК ТекстОшибки,
		|	ДокументыНДФЛАУСН.ИдентификаторИсходящегоЗапроса КАК ИдентификаторИсходящегоЗапроса,
		|	ДокументыНДФЛАУСН.ИдентификаторВходящегоЗапроса КАК ИдентификаторВходящегоЗапроса,
		|	СписаниеСРасчетногоСчета.Дата КАК ДатаДокумента
		|ИЗ
		|	РегистрСведений.ДокументыНДФЛАУСН КАК ДокументыНДФЛАУСН
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СписаниеСРасчетногоСчета КАК СписаниеСРасчетногоСчета
		|		ПО ДокументыНДФЛАУСН.Документ = СписаниеСРасчетногоСчета.Ссылка";
	
	СхемаЗапроса = СхемыЗапросов.Создать(ТекстЗапроса);
	ТочкаЗапроса = СхемыЗапросов.НайтиТаблицуПоПсевдониму(СхемаЗапроса, "ДокументыНДФЛАУСН");
	Запрос = Новый Запрос;
	Если ЗначениеЗаполнено(Документ) Тогда
		ТочкаЗапроса.Оператор.Отбор.Добавить("ДокументыНДФЛАУСН.Документ = &Документ");
		Запрос.УстановитьПараметр("Документ", Документ);
	ИначеЕсли ЗначениеЗаполнено(Идентификатор) Тогда
		ТочкаЗапроса.Оператор.Отбор.Добавить("ДокументыНДФЛАУСН.Идентификатор = &Идентификатор");
		Запрос.УстановитьПараметр("Идентификатор", Идентификатор);
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
	Запрос.Текст = СхемаЗапроса.ПолучитьТекстЗапроса();
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		РеквизитыДокумента = НовыйРеквизитыДокумента(Выборка.Документ, Выборка.Организация);
		ЗаполнитьЗначенияСвойств(РеквизитыДокумента, Выборка);
		Возврат РеквизитыДокумента;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

#Область СлужебныйПрограммныйИнтерфейс

Процедура ОбновитьДокументНДФЛАУСНПередЗаписью(ДокументОбъект, Отказ, РежимЗаписи) Экспорт
	
	ДокументОбъект.ДополнительныеСвойства.Вставить("ЭтоНовыйДокументНДФЛАУСН", ДокументОбъект.ЭтоНовый());
	ДокументОбъект.ДополнительныеСвойства.Вставить("РежимЗаписиДокументаНДФЛАУСН", РежимЗаписи);
	
КонецПроцедуры

Процедура ОбновитьДокументНДФЛАУСНПриЗаписи(ДокументОбъект, Отказ) Экспорт
	
	ЭтоНовыйДокументНДФЛАУСН = ДокументОбъект.ДополнительныеСвойства.ЭтоНовыйДокументНДФЛАУСН;
	РежимЗаписиДокументаНДФЛАУСН = ДокументОбъект.ДополнительныеСвойства.РежимЗаписиДокументаНДФЛАУСН;
	
	Попытка
		БлокировкаДанных = Новый БлокировкаДанных;
		ЭлементБлокировкиДанных = БлокировкаДанных.Добавить("РегистрСведений.ДокументыНДФЛАУСН");
		ЭлементБлокировкиДанных.УстановитьЗначение("Документ", ДокументОбъект.Ссылка);
		БлокировкаДанных.Заблокировать();
		
		ЭтоДокументНДФЛАУСН = Не ДокументОбъект.ПометкаУдаления
			И Документы.СписаниеСРасчетногоСчета.ЭтоОперацияРасчетаНДФЛАУСН(ДокументОбъект);
		
		Если ЭтоДокументНДФЛАУСН И УчетнаяПолитика.ПрименяетсяАУСН(ДокументОбъект.Организация, ДокументОбъект.Дата) Тогда
			Если РежимЗаписиДокументаНДФЛАУСН = РежимЗаписиДокумента.ОтменаПроведения Тогда
				ДобавитьПустуюЗапись(ДокументОбъект.Ссылка, ДокументОбъект.Организация);
			Иначе
				РеквизитыДокумента = ДанныеДокумента(ДокументОбъект.Ссылка);
				Если РеквизитыДокумента = Неопределено Или РеквизитыДокумента.Организация <> ДокументОбъект.Организация Тогда
					ДобавитьПустуюЗапись(ДокументОбъект.Ссылка, ДокументОбъект.Организация);
				КонецЕсли;
			КонецЕсли;
		ИначеЕсли Не ЭтоНовыйДокументНДФЛАУСН Тогда
			УдалитьЗапись(ДокументОбъект.Ссылка);
		КонецЕсли;
	Исключение
		Отказ = Истина;
		ТекстОшибки = СтрШаблон(НСтр("ru = 'Не удалось записать расчет НДФЛ АУСН по причине:
			|%1'"),
		ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ЗаписатьОшибкуВЖурналРегистрации(ТекстОшибки);
		ВызватьИсключение ТекстОшибки;
	КонецПопытки;
	
КонецПроцедуры

Процедура ОбновитьДокументНДФЛАУСНПриПроведенииРасчета(Документ, Отказ) Экспорт
	
	Ключи = ДанныеДокумента(Документ);
	Если Ключи = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		БлокировкаДанных = Новый БлокировкаДанных;
		ЭлементБлокировкиДанных = БлокировкаДанных.Добавить("РегистрСведений.ДокументыНДФЛАУСН");
		ЭлементБлокировкиДанных.УстановитьЗначение("Документ", Документ);
		БлокировкаДанных.Заблокировать();
	
		ДатаПодключенияПередачиНДФЛ = РегистрыСведений.СостоянияИнтеграцииАУСН.ДатаПодключенияПередачиНДФЛ(Ключи.Организация);
		НастроенаПередачаНДФЛ = ЗначениеЗаполнено(ДатаПодключенияПередачиНДФЛ)
			И Ключи.ДатаДокумента >= ДатаПодключенияПередачиНДФЛ;
		
		РеквизитыДокумента = НовыйРеквизитыДокумента(Документ, Ключи.Организация);
		РеквизитыДокумента.Статус = ?(НастроенаПередачаНДФЛ,
			Перечисления.СтатусыРасчетовНДФЛАУСН.ОжидаетОтправки,
			Перечисления.СтатусыРасчетовНДФЛАУСН.ПустаяСсылка());
		ИзменитьДокумент(РеквизитыДокумента);
	Исключение
		Отказ = Истина;
		ТекстОшибки = СтрШаблон(НСтр("ru = 'Не удалось записать расчет НДФЛ АУСН по причине:
			|%1'"),
		ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ЗаписатьОшибкуВЖурналРегистрации(ТекстОшибки);
		ВызватьИсключение ТекстОшибки;
	КонецПопытки;
	
КонецПроцедуры

Функция РасшифроватьВходящийЗапрос(ДанныеДокумента) Экспорт
	
	Возврат РасшифроватьЗапрос(ДанныеДокумента.ИдентификаторВходящегоЗапроса, "PostEmployeeInfoResponse");
	
КонецФункции

Функция РасшифроватьИсходящийЗапрос(ДанныеДокумента) Экспорт
	
	Возврат РасшифроватьЗапрос(ДанныеДокумента.ИдентификаторИсходящегоЗапроса, "PostEmployeeInfoRequest");
	
КонецФункции

#КонецОбласти

