#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ДобавитьПустуюЗапись(Документ, Организация)
	
	РеквизитыДокумента = НовыйРеквизитыДокумента(Документ, Организация);
	ИзменитьДокумент(РеквизитыДокумента);
	
КонецПроцедуры

Процедура УдалитьЗапись(Документ)
	
	Набор = СоздатьНаборЗаписей();
	Набор.Отбор.Документ.Установить(Документ);
	Набор.Записать();
	
КонецПроцедуры

Функция РасшифроватьЗапрос(ИдентификаторЗапроса, ТипЗапроса)
	
	Если ПустаяСтрока(ИдентификаторЗапроса) Тогда
		Возврат "";
	КонецЕсли;
	
	ДокументАУСН = РегистрыСведений.ДокументыАУСН.НайтиДокументы(Неопределено,
		ИдентификаторЗапроса);
	Если ДокументАУСН.Следующий() Тогда
		КаталогРазбора = ФайловаяСистема.СоздатьВременныйКаталог("zip");
		ДанныеДокумента = ИнтеграцияАУСН.РасшифроватьДанныеДокумента(ДокументАУСН, КаталогРазбора);
		ФайловаяСистема.УдалитьВременныйКаталог(КаталогРазбора);
		ЗаписьXML = Новый ЗаписьXML;
		ЗаписьXML.УстановитьСтроку("UTF-8");
		ДанныеДокумента.Фабрика.ЗаписатьXML(ЗаписьXML, ДанныеДокумента.Ответ, ТипЗапроса);
		Возврат ЗаписьXML.Закрыть();
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

Процедура ЗаписатьОшибкуВЖурналРегистрации(ТекстОшибки)
	
	ЗаписьЖурналаРегистрации(ИнтеграцияАУСНКлиентСервер.ИмяСобытияЖурналаРегистрации(),
		УровеньЖурналаРегистрации.Ошибка, Метаданные.РегистрыСведений.ДокументыНДФЛАУСН, , ТекстОшибки);
	
КонецПроцедуры

#Область ОбработчикиОбновления

Процедура ЗаполнитьДокументыНДФЛАУСН(ПараметрыОбработчика) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	НастройкиСистемыНалогообложения.Организация КАК Организация
	|ИЗ
	|	РегистрСведений.НастройкиСистемыНалогообложения КАК НастройкиСистемыНалогообложения
	|ГДЕ
	|	НастройкиСистемыНалогообложения.ПрименяетсяАУСН";
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		ПараметрыОбработчика.ОбработкаЗавершена = Истина;
		Возврат;
	КонецЕсли;
	
	ОрганизацииАУСН = РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("Организация");
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	НастройкиСистемыНалогообложения.ДатаИзменения КАК ДатаИзменения,
	|	НастройкиСистемыНалогообложения.Организация КАК Организация,
	|	НастройкиСистемыНалогообложения.ПрименяетсяАУСН КАК ПрименяетсяАУСН
	|ПОМЕСТИТЬ НастройкиСистемыНалогообложения
	|ИЗ
	|	РегистрСведений.НастройкиСистемыНалогообложения КАК НастройкиСистемыНалогообложения
	|ГДЕ
	|	НастройкиСистемыНалогообложения.Организация В(&ОрганизацииАУСН)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ ПЕРВЫЕ 1000
	|	ДокументСписаниеСРасчетногоСчета.Ссылка КАК Ссылка,
	|	ДокументСписаниеСРасчетногоСчета.Организация КАК Организация,
	|	ДокументСписаниеСРасчетногоСчета.Дата КАК Дата
	|ПОМЕСТИТЬ ДокументыНДФЛ
	|ИЗ
	|	Документ.СписаниеСРасчетногоСчета КАК ДокументСписаниеСРасчетногоСчета
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СписаниеСРасчетногоСчета.ПеречислениеЗаработнойПлаты КАК СписаниеСРасчетногоСчетаПеречислениеЗаработнойПлаты
	|		ПО ДокументСписаниеСРасчетногоСчета.Ссылка = СписаниеСРасчетногоСчетаПеречислениеЗаработнойПлаты.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДокументыНДФЛАУСН КАК ДокументыНДФЛАУСН
	|		ПО ДокументСписаниеСРасчетногоСчета.Ссылка = ДокументыНДФЛАУСН.Документ
	|ГДЕ
	|	НЕ ДокументСписаниеСРасчетногоСчета.ПометкаУдаления
	|	И ДокументСписаниеСРасчетногоСчета.Организация В
	|			(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|				НастройкиСистемыНалогообложения.Организация
	|			ИЗ
	|				НастройкиСистемыНалогообложения КАК НастройкиСистемыНалогообложения
	|			ГДЕ
	|				НастройкиСистемыНалогообложения.ПрименяетсяАУСН)
	|	И ДокументыНДФЛАУСН.Идентификатор ЕСТЬ NULL
	|	И (ДокументСписаниеСРасчетногоСчета.ВидОперации В (ЗНАЧЕНИЕ(Перечисление.ВидыОперацийСписаниеДенежныхСредств.ПеречислениеЗаработнойПлатыРаботнику), ЗНАЧЕНИЕ(Перечисление.ВидыОперацийСписаниеДенежныхСредств.ПеречислениеСотрудникуПоДоговоруПодряда))
	|				И ДокументСписаниеСРасчетногоСчета.ПлатежнаяВедомость ССЫЛКА Документ.ВедомостьНаВыплатуЗарплатыВБанк
	|			ИЛИ ДокументСписаниеСРасчетногоСчета.ВидОперации В (ЗНАЧЕНИЕ(Перечисление.ВидыОперацийСписаниеДенежныхСредств.ПеречислениеЗП), ЗНАЧЕНИЕ(Перечисление.ВидыОперацийСписаниеДенежныхСредств.ПеречислениеСотрудникамПоДоговорамПодряда))
	|				И СписаниеСРасчетногоСчетаПеречислениеЗаработнойПлаты.Ведомость ССЫЛКА Документ.ВедомостьНаВыплатуЗарплатыВБанк)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Организация
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДокументыНДФЛ.Ссылка КАК Ссылка,
	|	ДокументыНДФЛ.Организация КАК Организация,
	|	ДокументыНДФЛ.Дата КАК Дата,
	|	МАКСИМУМ(ЕСТЬNULL(НастройкиСистемыНалогообложения.ДатаИзменения, ДАТАВРЕМЯ(1, 1, 1))) КАК НастройкиСистемыНалогообложенияДатаИзменения
	|ПОМЕСТИТЬ ДокументыНДФЛСрезПоследних
	|ИЗ
	|	ДокументыНДФЛ КАК ДокументыНДФЛ
	|		ЛЕВОЕ СОЕДИНЕНИЕ НастройкиСистемыНалогообложения КАК НастройкиСистемыНалогообложения
	|		ПО ДокументыНДФЛ.Организация = НастройкиСистемыНалогообложения.Организация
	|			И ДокументыНДФЛ.Дата >= НастройкиСистемыНалогообложения.ДатаИзменения
	|
	|СГРУППИРОВАТЬ ПО
	|	ДокументыНДФЛ.Ссылка,
	|	ДокументыНДФЛ.Дата,
	|	ДокументыНДФЛ.Организация
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ДокументыНДФЛ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДокументыНДФЛСрезПоследних.Ссылка КАК Ссылка,
	|	ДокументыНДФЛСрезПоследних.Организация КАК Организация,
	|	ДокументыНДФЛСрезПоследних.Дата КАК Дата
	|ПОМЕСТИТЬ ДокументыНДФЛАУСН
	|ИЗ
	|	ДокументыНДФЛСрезПоследних КАК ДокументыНДФЛСрезПоследних
	|		ЛЕВОЕ СОЕДИНЕНИЕ НастройкиСистемыНалогообложения КАК НастройкиСистемыНалогообложения
	|		ПО ДокументыНДФЛСрезПоследних.НастройкиСистемыНалогообложенияДатаИзменения = НастройкиСистемыНалогообложения.ДатаИзменения
	|			И ДокументыНДФЛСрезПоследних.Организация = НастройкиСистемыНалогообложения.Организация
	|ГДЕ
	|	ЕСТЬNULL(НастройкиСистемыНалогообложения.ПрименяетсяАУСН, ЛОЖЬ) = ИСТИНА
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ДокументыНДФЛСрезПоследних
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ НастройкиСистемыНалогообложения
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	РасчетыНДФЛАУСН.Регистратор КАК Регистратор,
	|	МАКСИМУМ(РасчетыНДФЛАУСН.УдалитьОтправитьВБанк) КАК ОтправитьВСервис
	|ПОМЕСТИТЬ ОтправитьРасчетыВСервис
	|ИЗ
	|	РегистрНакопления.РасчетыНДФЛАУСН КАК РасчетыНДФЛАУСН
	|ГДЕ
	|	РасчетыНДФЛАУСН.Активность
	|	И РасчетыНДФЛАУСН.Регистратор В
	|			(ВЫБРАТЬ
	|				ДокументыНДФЛАУСН.Ссылка
	|			ИЗ
	|				ДокументыНДФЛАУСН КАК ДокументыНДФЛАУСН)
	|
	|СГРУППИРОВАТЬ ПО
	|	РасчетыНДФЛАУСН.Регистратор
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДокументыНДФЛАУСН.Ссылка КАК Ссылка,
	|	ДокументыНДФЛАУСН.Организация КАК Организация,
	|	ДокументыНДФЛАУСН.Дата КАК Дата,
	|	ЕСТЬNULL(ОтправитьРасчетыВСервис.ОтправитьВСервис, ЛОЖЬ) КАК ОтправитьВСервис
	|ИЗ
	|	ДокументыНДФЛАУСН КАК ДокументыНДФЛАУСН
	|		ЛЕВОЕ СОЕДИНЕНИЕ ОтправитьРасчетыВСервис КАК ОтправитьРасчетыВСервис
	|		ПО ДокументыНДФЛАУСН.Ссылка = ОтправитьРасчетыВСервис.Регистратор
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата УБЫВ";
	
	Запрос.УстановитьПараметр("ОрганизацииАУСН", ОрганизацииАУСН);
	
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		ПараметрыОбработчика.ОбработкаЗавершена = Истина;
		Возврат;
	КонецЕсли;
	
	ПараметрыОбработчика.ОбработкаЗавершена = Ложь;
	ОбъектовОбработано = 0;
	ПроблемныхОбъектов = 0;
	
	СоответствиеДатаПодключения = Новый Соответствие;
	СоответствиеБанкПередачиНДФЛ = Новый Соответствие;
	
	Выборка = Результат.Выбрать();
	Пока Выборка.Следующий() Цикл
		НачатьТранзакцию();
		
		Попытка
			БлокировкаДанных = Новый БлокировкаДанных;
			ЭлементБлокировкиДанных = БлокировкаДанных.Добавить("Документ.СписаниеСРасчетногоСчета");
			ЭлементБлокировкиДанных.УстановитьЗначение("Ссылка", Выборка.Ссылка);
			ЭлементБлокировкиДанных = БлокировкаДанных.Добавить("РегистрСведений.ДокументыНДФЛАУСН");
			ЭлементБлокировкиДанных.УстановитьЗначение("Документ", Выборка.Ссылка);
			ЭлементБлокировкиДанных = БлокировкаДанных.Добавить("РегистрСведений.НастройкиСистемыНалогообложения");
			БлокировкаДанных.Заблокировать();
			
			НаборЗаписей = СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.Документ.Установить(Выборка.Ссылка);
			НаборЗаписей.Прочитать();
			Если ЗначениеЗаполнено(НаборЗаписей.Количество()) Тогда
				ЗафиксироватьТранзакцию();
				Продолжить;
			КонецЕсли;
			
			// После блокировки данных вид операции документа и применение АУСН проверяем заново,
			// чтобы не добавить лишнюю запись в регистр
			ДокументОбъект = Выборка.Ссылка.ПолучитьОбъект();
			Если ДокументОбъект = Неопределено Тогда
				ЗафиксироватьТранзакцию();
				Продолжить;
			КонецЕсли;
			
			ЭтоДокументНДФЛАУСН = Не ДокументОбъект.ПометкаУдаления
				И Документы.СписаниеСРасчетногоСчета.ЭтоОперацияРасчетаНДФЛАУСН(ДокументОбъект);
			Если Не ЭтоДокументНДФЛАУСН
				Или Не УчетнаяПолитика.ПрименяетсяАУСН(ДокументОбъект.Организация, ДокументОбъект.Дата) Тогда
				ЗафиксироватьТранзакцию();
				Продолжить;
			КонецЕсли;
			
			НоваяЗапись = НаборЗаписей.Добавить();
			НоваяЗапись.Организация = ДокументОбъект.Организация;
			НоваяЗапись.Документ = Выборка.Ссылка;
			Если ДокументОбъект.Проведен Тогда
				ДатаПодключенияПередачиНДФЛ = СоответствиеДатаПодключения[ДокументОбъект.Организация];
				Если ДатаПодключенияПередачиНДФЛ = Неопределено Тогда
					ДатаПодключенияПередачиНДФЛ = РегистрыСведений.СостоянияИнтеграцииАУСН.ДатаПодключенияПередачиНДФЛ(
						ДокументОбъект.Организация);
					СоответствиеДатаПодключения[ДокументОбъект.Организация] = ?(ДатаПодключенияПередачиНДФЛ = Неопределено,
						Дата(1, 1, 1), ДатаПодключенияПередачиНДФЛ);
				КонецЕсли;
				Если ЗначениеЗаполнено(ДатаПодключенияПередачиНДФЛ) И ДокументОбъект.Дата >= ДатаПодключенияПередачиНДФЛ Тогда
					Если Выборка.ОтправитьВСервис Тогда
						НоваяЗапись.Статус = Перечисления.СтатусыРасчетовНДФЛАУСН.ОжидаетОтправки;
					Иначе
						БанкПередачиНДФЛИзПрограммы = СоответствиеБанкПередачиНДФЛ[ДокументОбъект.Организация];
						Если БанкПередачиНДФЛИзПрограммы = Неопределено Тогда
							БанкПередачиНДФЛИзПрограммы = РегистрыСведений.СостоянияИнтеграцииАУСН.БанкПередачиНДФЛИзПрограммы(
								ДокументОбъект.Организация);
							СоответствиеБанкПередачиНДФЛ[ДокументОбъект.Организация] = ?(БанкПередачиНДФЛИзПрограммы = Неопределено, 
								Справочники.КлассификаторБанков.ПустаяСсылка(), БанкПередачиНДФЛИзПрограммы);
						КонецЕсли;
						НоваяЗапись.Статус = ?(ЗначениеЗаполнено(БанкПередачиНДФЛИзПрограммы),
							Перечисления.СтатусыРасчетовНДФЛАУСН.ПереданВБанк, Перечисления.СтатусыРасчетовНДФЛАУСН.ПереданВФНС);
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			ОбновлениеИнформационнойБазы.ЗаписатьНаборЗаписей(НаборЗаписей);
			
			ОбъектовОбработано = ОбъектовОбработано + 1;
			ЗафиксироватьТранзакцию();
		Исключение
			
			ПроблемныхОбъектов = ПроблемныхОбъектов + 1;
			ОтменитьТранзакцию();
			
			// Обработку проблемных данных пропускаем, так как приоритет имеют беспроблемные данные
			ТекстСообщения = СтрШаблон(НСтр("ru = 'Не удалось обработать документ НДФЛ АУСН: %1 по причине:
				|%2'"),
				Выборка.Ссылка, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			ЗаписьЖурналаРегистрации(
				ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
				УровеньЖурналаРегистрации.Ошибка,
				Метаданные.РегистрыСведений.ДокументыНДФЛАУСН,
				Выборка.Ссылка,
				ТекстСообщения);
			
		КонецПопытки;
	КонецЦикла;
	
	ИмяПроцедурыОбновления = НСтр("ru = 'РегистрыСведений.ДокументыНДФЛАУСН.ЗаполнитьДокументыНДФЛАУСН'");
	Если ПроблемныхОбъектов > 0 Тогда
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Процедуре %1 не удалось обработать документы:
				|в %2 из %3 возникли ошибки'"),
			ИмяПроцедурыОбновления,
			ПроблемныхОбъектов,
			ОбъектовОбработано);
		ВызватьИсключение ТекстСообщения;
	ИначеЕсли ОбъектовОбработано > 0 Тогда
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Процедура %1 обработала очередную порцию данных: %2 документов'"),
			ИмяПроцедурыОбновления,
			ОбъектовОбработано);
		ЗаписьЖурналаРегистрации(
			ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
			УровеньЖурналаРегистрации.Информация,
			,,
			ТекстСообщения);
	Иначе
		ПараметрыОбработчика.ОбработкаЗавершена = Истина;
	КонецЕсли;
	
КонецПроцедуры

Процедура ДозаполнитьДокументыНДФЛАУСН(ПараметрыОбработчика) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1000
	|	РасчетыНДФЛАУСН.Регистратор КАК Ссылка,
	|	ДокументСписаниеСРасчетногоСчета.Дата КАК Дата,
	|	МАКСИМУМ(РасчетыНДФЛАУСН.УдалитьОтправитьВБанк) КАК ОтправитьВСервис
	|ИЗ
	|	РегистрНакопления.РасчетыНДФЛАУСН КАК РасчетыНДФЛАУСН
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СписаниеСРасчетногоСчета КАК ДокументСписаниеСРасчетногоСчета
	|		ПО РасчетыНДФЛАУСН.Регистратор = ДокументСписаниеСРасчетногоСчета.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДокументыНДФЛАУСН КАК ДокументыНДФЛАУСН
	|		ПО РасчетыНДФЛАУСН.Регистратор = ДокументыНДФЛАУСН.Документ
	|ГДЕ
	|	РасчетыНДФЛАУСН.Активность
	|	И ДокументыНДФЛАУСН.Идентификатор ЕСТЬ NULL
	|
	|СГРУППИРОВАТЬ ПО
	|	РасчетыНДФЛАУСН.Регистратор,
	|	ДокументСписаниеСРасчетногоСчета.Дата
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата УБЫВ";
	
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		ПараметрыОбработчика.ОбработкаЗавершена = Истина;
		Возврат;
	КонецЕсли;
	
	ПараметрыОбработчика.ОбработкаЗавершена = Ложь;
	ОбъектовОбработано = 0;
	ПроблемныхОбъектов = 0;
	
	СоответствиеДатаПодключения = Новый Соответствие;
	СоответствиеБанкПередачиНДФЛ = Новый Соответствие;
	
	Выборка = Результат.Выбрать();
	Пока Выборка.Следующий() Цикл
		НачатьТранзакцию();
		
		Попытка
			БлокировкаДанных = Новый БлокировкаДанных;
			ЭлементБлокировкиДанных = БлокировкаДанных.Добавить("Документ.СписаниеСРасчетногоСчета");
			ЭлементБлокировкиДанных.УстановитьЗначение("Ссылка", Выборка.Ссылка);
			ЭлементБлокировкиДанных = БлокировкаДанных.Добавить("РегистрСведений.ДокументыНДФЛАУСН");
			ЭлементБлокировкиДанных.УстановитьЗначение("Документ", Выборка.Ссылка);
			ЭлементБлокировкиДанных = БлокировкаДанных.Добавить("РегистрНакопления.РасчетыНДФЛАУСН.НаборЗаписей");
			ЭлементБлокировкиДанных.УстановитьЗначение("Регистратор", Выборка.Ссылка);
			БлокировкаДанных.Заблокировать();
			
			НаборЗаписей = СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.Документ.Установить(Выборка.Ссылка);
			НаборЗаписей.Прочитать();
			Если ЗначениеЗаполнено(НаборЗаписей.Количество()) Тогда
				ЗафиксироватьТранзакцию();
				Продолжить;
			КонецЕсли;
			
			НаборЗаписейРасчетыНДФЛ = РегистрыНакопления.РасчетыНДФЛАУСН.СоздатьНаборЗаписей();
			НаборЗаписейРасчетыНДФЛ.Отбор.Регистратор.Установить(Выборка.Ссылка);
			НаборЗаписейРасчетыНДФЛ.Прочитать();
			
			ЭтоДокументНДФЛАУСН = ЗначениеЗаполнено(НаборЗаписейРасчетыНДФЛ.Количество());
			Если Не ЭтоДокументНДФЛАУСН Тогда
				ЗафиксироватьТранзакцию();
				Продолжить;
			КонецЕсли;
			
			ДокументОбъект = Выборка.Ссылка.ПолучитьОбъект();
			Если ДокументОбъект = Неопределено Тогда
				ЗафиксироватьТранзакцию();
				Продолжить;
			КонецЕсли;
			
			НоваяЗапись = НаборЗаписей.Добавить();
			НоваяЗапись.Организация = ДокументОбъект.Организация;
			НоваяЗапись.Документ = Выборка.Ссылка;
			Если ДокументОбъект.Проведен Тогда
				ДатаПодключенияПередачиНДФЛ = СоответствиеДатаПодключения[ДокументОбъект.Организация];
				Если ДатаПодключенияПередачиНДФЛ = Неопределено Тогда
					ДатаПодключенияПередачиНДФЛ = РегистрыСведений.СостоянияИнтеграцииАУСН.ДатаПодключенияПередачиНДФЛ(
						ДокументОбъект.Организация);
					СоответствиеДатаПодключения[ДокументОбъект.Организация] = ?(ДатаПодключенияПередачиНДФЛ = Неопределено,
						Дата(1, 1, 1), ДатаПодключенияПередачиНДФЛ);
				КонецЕсли;
				Если ЗначениеЗаполнено(ДатаПодключенияПередачиНДФЛ) И ДокументОбъект.Дата >= ДатаПодключенияПередачиНДФЛ Тогда
					Если Выборка.ОтправитьВСервис Тогда
						НоваяЗапись.Статус = Перечисления.СтатусыРасчетовНДФЛАУСН.ОжидаетОтправки;
					Иначе
						БанкПередачиНДФЛИзПрограммы = СоответствиеБанкПередачиНДФЛ[ДокументОбъект.Организация];
						Если БанкПередачиНДФЛИзПрограммы = Неопределено Тогда
							БанкПередачиНДФЛИзПрограммы = РегистрыСведений.СостоянияИнтеграцииАУСН.БанкПередачиНДФЛИзПрограммы(
								ДокументОбъект.Организация);
							СоответствиеБанкПередачиНДФЛ[ДокументОбъект.Организация] = ?(БанкПередачиНДФЛИзПрограммы = Неопределено, 
								Справочники.КлассификаторБанков.ПустаяСсылка(), БанкПередачиНДФЛИзПрограммы);
						КонецЕсли;
						НоваяЗапись.Статус = ?(ЗначениеЗаполнено(БанкПередачиНДФЛИзПрограммы),
							Перечисления.СтатусыРасчетовНДФЛАУСН.ПереданВБанк, Перечисления.СтатусыРасчетовНДФЛАУСН.ПереданВФНС);
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			ОбновлениеИнформационнойБазы.ЗаписатьНаборЗаписей(НаборЗаписей);
			
			ОбъектовОбработано = ОбъектовОбработано + 1;
			ЗафиксироватьТранзакцию();
		Исключение
			
			ПроблемныхОбъектов = ПроблемныхОбъектов + 1;
			ОтменитьТранзакцию();
			
			// Обработку проблемных данных пропускаем, так как приоритет имеют беспроблемные данные
			ТекстСообщения = СтрШаблон(НСтр("ru = 'Не удалось обработать документ НДФЛ АУСН: %1 по причине:
				|%2'"),
				Выборка.Ссылка, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			ЗаписьЖурналаРегистрации(
				ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
				УровеньЖурналаРегистрации.Ошибка,
				Метаданные.РегистрыСведений.ДокументыНДФЛАУСН,
				Выборка.Ссылка,
				ТекстСообщения);
			
		КонецПопытки;
	КонецЦикла;
	
	ИмяПроцедурыОбновления = НСтр("ru = 'РегистрыСведений.ДокументыНДФЛАУСН.ДозаполнитьДокументыНДФЛАУСН'");
	Если ПроблемныхОбъектов > 0 Тогда
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Процедуре %1 не удалось обработать документы:
				|в %2 из %3 возникли ошибки'"),
			ИмяПроцедурыОбновления,
			ПроблемныхОбъектов,
			ОбъектовОбработано);
		ВызватьИсключение ТекстСообщения;
	ИначеЕсли ОбъектовОбработано > 0 Тогда
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Процедура %1 обработала очередную порцию данных: %2 документов'"),
			ИмяПроцедурыОбновления,
			ОбъектовОбработано);
		ЗаписьЖурналаРегистрации(
			ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
			УровеньЖурналаРегистрации.Информация,
			,,
			ТекстСообщения);
	Иначе
		ПараметрыОбработчика.ОбработкаЗавершена = Истина;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#КонецОбласти

#КонецЕсли