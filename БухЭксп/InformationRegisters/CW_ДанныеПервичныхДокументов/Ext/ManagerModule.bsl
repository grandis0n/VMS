
Процедура ЗаписатьДанныеПервичногоДокумента(Знач ДанныеДокумента, Знач ВидДокумента, НомерДляПечати, Номер, Дата) Экспорт
	    
	ЗаписьРегистра = РегистрыСведений.CW_ДанныеПервичныхДокументов.СоздатьМенеджерЗаписи();
	ЗаписьРегистра.Организация 		= ДанныеДокумента.Организация;
	ЗаписьРегистра.Контрагент 		= ДанныеДокумента.Контрагент;
	ЗаписьРегистра.Документ 		= ДанныеДокумента.Ссылка;
	ЗаписьРегистра.ВидДокумента 	= ВидДокумента;
	ЗаписьРегистра.НомерДляПечати 	= НомерДляПечати;
	ЗаписьРегистра.Номер 			= Номер; 
	ЗаписьРегистра.Дата 			= Дата; 
	ЗаписьРегистра.Записать(Истина);

КонецПроцедуры  

Процедура ОчиститьНаборПоУсловиям(ДанныеДокумента) Экспорт
	
	Набор = РегистрыСведений.CW_ДанныеПервичныхДокументов.СоздатьНаборЗаписей();
	Набор.Отбор.Организация.Установить(ДанныеДокумента.Организация);
	Набор.Отбор.Контрагент.Установить(ДанныеДокумента.Контрагент);
	Набор.Отбор.Документ.Установить(ДанныеДокумента.Ссылка);  
	Набор.Прочитать();
	Набор.Очистить();
	
	
КонецПроцедуры

Процедура ЗаполнитьДанныеРегистра() Экспорт
	
	ДатаДокумента =  КонецДня(ТекущаяДата());
	
	Выборка = ПолучитьВыборкуДокументов(ДатаДокумента);
	
	Пока Истина Цикл   
		
		Если Выборка.Количество() = 0 Тогда
			Прервать;
		КонецЕсли;
		
		Пока Выборка.Следующий() Цикл  
			
			CW_Документы.ЗаписатьДанныеПервичногоДокумента(Выборка.Ссылка);
			
			ДатаДокумента =  Выборка.Дата;
			
		КонецЦикла; 
		
		Выборка = ПолучитьВыборкуДокументов(ДатаДокумента);
		
	КонецЦикла;
	
	
КонецПроцедуры

Функция ПолучитьВыборкуДокументов(ДатаДокумента)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1000
	               |	CW_ДоходыПоГрузоперевозке.Ссылка КАК Ссылка,
	               |	CW_ДоходыПоГрузоперевозке.Контрагент КАК Контрагент,
	               |	CW_ДоходыПоГрузоперевозке.Организация КАК Организация,
	               |	CW_ДоходыПоГрузоперевозке.ФормируетсяАкт КАК ФормируетсяАкт,
	               |	CW_ДоходыПоГрузоперевозке.ФормируетсяСчет КАК ФормируетсяСчет,
	               |	CW_ДоходыПоГрузоперевозке.ФормируетсяСчетФактура КАК ФормируетсяСчетФактура,
	               |	CW_ДоходыПоГрузоперевозке.НомерСчета КАК НомерСчета,
	               |	CW_ДоходыПоГрузоперевозке.НомерАкта КАК НомерАкта,
	               |	CW_ДоходыПоГрузоперевозке.НомерСчетаФактуры КАК НомерСчетаФактуры,
	               |	CW_ДоходыПоГрузоперевозке.ДатаАкта КАК ДатаАкта,
	               |	CW_ДоходыПоГрузоперевозке.ДатаСчета КАК ДатаСчета,
	               |	CW_ДоходыПоГрузоперевозке.ДатаСчетаФактуры КАК ДатаСчетаФактуры,
	               |	CW_ДоходыПоГрузоперевозке.Дата КАК Дата
	               |ИЗ
	               |	Документ.CW_ДоходыПоГрузоперевозке КАК CW_ДоходыПоГрузоперевозке
	               |ГДЕ
	               |	CW_ДоходыПоГрузоперевозке.Проведен
	               |	И CW_ДоходыПоГрузоперевозке.Дата < &ДатаДокумента
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	CW_ДоходыПоГрузоперевозке.Дата УБЫВ
	               |АВТОУПОРЯДОЧИВАНИЕ"; 
	
	Запрос.УстановитьПараметр("ДатаДокумента", ДатаДокумента);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат РезультатЗапроса.Выбрать();
	
КонецФункции
