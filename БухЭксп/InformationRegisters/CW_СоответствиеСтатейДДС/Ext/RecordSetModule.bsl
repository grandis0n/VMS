#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

Процедура ПередЗаписью(Отказ, Замещение)
	
	мСтатьиДвиженияДенежныхСредств =  Новый Массив;
	Для Каждого Строка Из ЭтотОбъект Цикл
		 мСтатьиДвиженияДенежныхСредств.Добавить(Строка.СтатьяДвиженияДенежныхСредств);
	КонецЦикла;
	
	ПроверитьДублиСтатейДДС(мСтатьиДвиженияДенежныхСредств, Отказ);
	
КонецПроцедуры

Процедура ПроверитьДублиСтатейДДС(мСтатьиДвиженияДенежныхСредств, Отказ)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	CW_СоответствиеСтатейДДС.СтатьяДвиженияДенежныхСредств КАК СтатьяДвиженияДенежныхСредств,
	               |	CW_СоответствиеСтатейДДС.СтатьяДДС КАК СтатьяДДС
	               |ИЗ
	               |	РегистрСведений.CW_СоответствиеСтатейДДС КАК CW_СоответствиеСтатейДДС
	               |ГДЕ
	               |	CW_СоответствиеСтатейДДС.СтатьяДвиженияДенежныхСредств В(&мСтатьиДвиженияДенежныхСредств)";
	
	Запрос.УстановитьПараметр("мСтатьиДвиженияДенежныхСредств", мСтатьиДвиженияДенежныхСредств);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если Не РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
			ШаблонСообщения = "Статья движения денежных средств уже назначена для Статьи %1";
			ТекстСообщения = СтрШаблон(ШаблонСообщения, Выборка.СтатьяДДС);
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,"СтатьяДвиженияДенежныхСредств","Запись",Отказ);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры


#КонецЕсли