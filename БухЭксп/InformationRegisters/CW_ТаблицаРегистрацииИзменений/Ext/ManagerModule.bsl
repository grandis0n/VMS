#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

Процедура ИзменитьСтатусЗаписей(МассивЗаписей,НовыйСтатус) Экспорт 
	// --- 
	
	МенеджерЗаписи = РегистрыСведений.CW_ТаблицаРегистрацииИзменений.СоздатьМенеджерЗаписи();
	// --- 
	СтатусРегистрации = Перечисления.CW_СтатусыВыгрузки.Зарегистрирован;
	// --- 
	Для каждого Элемент Из МассивЗаписей Цикл
		ЗаполнитьЗначенияСвойств(МенеджерЗаписи,Элемент);
		МенеджерЗаписи.Прочитать();
		МенеджерЗаписи.Статус = НовыйСтатус;
		Если (НовыйСтатус=СтатусРегистрации) Тогда
			МенеджерЗаписи.ОшибкаВыгрузки = Ложь;
		КонецЕсли; 
		МенеджерЗаписи.Записать(Истина);
	КонецЦикла;
	
	// --- 
КонецПроцедуры

