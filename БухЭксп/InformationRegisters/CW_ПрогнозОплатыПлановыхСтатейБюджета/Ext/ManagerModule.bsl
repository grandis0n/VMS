
Функция ПолучитьПрогнозОплаты(СтатьяБюджета) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	CW_ПрогнозОплатыПлановыхСтатейБюджета.ПрогнозДата КАК ПрогнозДата
	               |ИЗ
	               |	РегистрСведений.CW_ПрогнозОплатыПлановыхСтатейБюджета КАК CW_ПрогнозОплатыПлановыхСтатейБюджета
	               |ГДЕ
	               |	CW_ПрогнозОплатыПлановыхСтатейБюджета.СтатьяБюджета = &СтатьяБюджета";  
	
	Запрос.УстановитьПараметр("СтатьяБюджета", СтатьяБюджета);
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.ПрогнозДата;
	КонецЕсли;
	
	Возврат Дата(1,1,1);
	
КонецФункции     

Процедура ЗаписатьПрогнозОплаты(СтатьяБюджета, ПрогнозДата) Экспорт 
	
	Запись = РегистрыСведений.CW_ПрогнозОплатыПлановыхСтатейБюджета.СоздатьМенеджерЗаписи();
	Запись.СтатьяБюджета 	= СтатьяБюджета; 
	Запись.ПрогнозДата 		= ПрогнозДата; 
	Запись.Записать(Истина);
	
КонецПроцедуры