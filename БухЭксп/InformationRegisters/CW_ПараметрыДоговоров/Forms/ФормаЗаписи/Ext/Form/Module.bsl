&НаКлиенте
Процедура ОбработкаИзмененияШаблонаДополнения(Ответ, ДополнительныеПараметры) Экспорт 
	
	Если (Ответ <> Неопределено) Тогда
		Запись[ДополнительныеПараметры] = Ответ;
		Элементы[ДополнительныеПараметры].ОбновитьТекстРедактирования();
	КонецЕсли; 
	
КонецПроцедуры


&НаКлиенте
Процедура КопироватьПараметрыДругогоОбъекта(Команда)
	
	Режим = РежимДиалогаВопрос.ДаНет;
	Оповещение = Новый ОписаниеОповещения("ПродолжитьКопированиеПараметров", ЭтотОбъект, Параметры);
	ПоказатьВопрос(Оповещение, "Значения параметров на закладках ""Основные"" и ""Документы"" будут заменены на текущие значения параметров выбранного объекта. Продолжить?", Режим, 0);	
	
КонецПроцедуры


&НаКлиенте
Процедура ПродолжитьКопированиеПараметров(Результат, Параметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Нет Тогда
        Возврат;
	КонецЕсли;

	ИмяОбъектаМетаданных = ПолучитьИмяОбъектаМетаданныхВладельцаПараметров(Запись.Договор);

	ОписаниеОповещения = Новый ОписаниеОповещения("ОбработатьВыборТипаОбъекта", ЭтотОбъект);
	
	Если ВедетсяУчетПриложенийПоДоговорам Тогда
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("АдресСпискаЗначений", 	ПолучитьАдресСписка());
		ПараметрыФормы.Вставить("СписокСПометками", 	Ложь);
		ПараметрыФормы.Вставить("ЗаголовокФормы", 		"Выберите тип объекта");
		
		ОткрытьФорму("ОбщаяФорма.CW_ФормаВыбораИзСписка", ПараметрыФормы, ЭтаФорма,,,,ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
	Иначе
		
		АдресРезультата = ПолучитьАдресРезультатаДоговор();
		ВыполнитьОбработкуОповещения(ОписаниеОповещения, АдресРезультата);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьАдресРезультатаДоговор()
	
	СтруктураВыбора = Новый Структура;
	СтруктураВыбора.Вставить("Значение", "CW_ДоговорыПоГрузоперевозкам"); 
	
	Возврат ПоместитьВоВременноеХранилище(СтруктураВыбора);

КонецФункции

&НаСервере
Функция получитьАдресСписка()
	
	СписокВыбора = Новый СписокЗначений;
	СписокВыбора.Добавить("CW_ДоговорыПоГрузоперевозкам", "Договоры по грузоперевозкам"	,,БиблиотекаКартинок.CW_Договоры);
	СписокВыбора.Добавить("CW_ПриложенияКДоговорам"		, "Приложения к договорам"		,,БиблиотекаКартинок.CW_Приложение);

	Возврат ПоместитьВоВременноеХранилище(СписокВыбора);
	
КонецФункции


&НаСервереБезКонтекста
Функция ПолучитьИмяОбъектаМетаданныхВладельцаПараметров(Договор)
	Возврат	Договор.Метаданные().Имя;
КонецФункции

&НаКлиенте
Процедура ОбработатьВыборТипаОбъекта(ЗначениеВыбора, Параметры) Экспорт
	Если ЗначениеВыбора = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеВыбора = ПолучитьЗначениеВыбора(ЗначениеВыбора);
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ОбработатьВыборОбъектаКопирования", ЭтотОбъект,);
	
	ПараметрыФормы = новый Структура;
	ПараметрыФормы.Вставить("ЗакрыватьПриВыборе", Истина);
	ПараметрыФормы.Вставить("МножественныйВыбор", Ложь);
	ПараметрыФормы.Вставить("РежимВыбора", Истина);
	
	ОткрытьФорму("Справочник."+ДанныеВыбора.Значение+".ФормаВыбора", ПараметрыФормы, ЭтаФорма,,,,ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаСервере
Функция ПолучитьЗначениеВыбора(ЗначениеВыбора)
	
	Возврат ПолучитьИзВременногоХранилища(ЗначениеВыбора);
	
КонецФункции

&НаКлиенте
Процедура ОбработатьВыборОбъектаКопирования(ЗначениеВыбора, Параметры) Экспорт
    Если ЗначениеВыбора = Неопределено Тогда
        Возврат;
	КонецЕсли;
	
	ОбработатьВыборОбъектаКопированиянаСервере(ЗначениеВыбора);
	
КонецПроцедуры

&НаСервере
Процедура ОбработатьВыборОбъектаКопированиянаСервере(ЗначениеВыбора)
	
	ВыборкаЗначенийПараметровОбъекта = ПолучитьПараметрыДоговора(ЗначениеВыбора);
	
	Если ВыборкаЗначенийПараметровОбъекта =Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИсключаемыеСвойства = ПолучитьНеКопируемыеРеквизиты();
	
	ЗаполнитьЗначенияСвойств(Запись, ВыборкаЗначенийПараметровОбъекта,,ИсключаемыеСвойства);
	
	_УправлениеЭлементамиФормы();
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьПараметрыДоговора(ЗначениеВыбора)
	
	Запрос = новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ *
	               |ИЗ
	               |	РегистрСведений.CW_ПараметрыДоговоров.СрезПоследних(&ДатаСреза, Договор = &Договор) КАК CW_ПараметрыДоговоровСрезПоследних";
	
	Запрос.УстановитьПараметр("ДатаСреза", 	ТекущаяДата());
	Запрос.УстановитьПараметр("Договор", 	ЗначениеВыбора);
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

