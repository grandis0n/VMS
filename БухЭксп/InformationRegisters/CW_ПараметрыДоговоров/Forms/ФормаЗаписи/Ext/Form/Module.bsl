	мРеквизитыИсключения.Добавить("ГлавныйБухгалтерОрганизации");
	мРеквизитыИсключения.Добавить("ГлавныйБухгалтерОснование");
	
	//EN
	мРеквизитыИсключения.Добавить("РасчетныйСчетОрганизацииИностранный");
	мРеквизитыИсключения.Добавить("АдресОрганизацииАнгл");
	мРеквизитыИсключения.Добавить("ДолжностьРуководителяОрганизацииАнгл");
	мРеквизитыИсключения.Добавить("РуководительОснованиеАнгл");
	мРеквизитыИсключения.Добавить("ГлавныйБухгалтерОснованиеАнгл");
	
	//Закладка "Комментарий"
	мРеквизитыИсключения.Добавить("Комментарий");
	
	Возврат СтрСоединить(мРеквизитыИсключения, ",");
	
КонецФункции

&НаКлиенте
Процедура РежимПодписейПриИзменении(Элемент)
	
	//подписанты
	Если Запись.РежимПодписей = 0 Тогда
		ПолучитьПодпиантовИзКарточкиОрганизацииНаСервере();
	КонецЕсли;
	//подписанты
	
	_УправлениеЭлементамиФормы();
	
КонецПроцедуры

&наСервере
Процедура ПолучитьПодпиантовИзКарточкиОрганизацииНаСервере()
	
	ДанныеОтветственных = РегистрыСведений.CW_ПараметрыДоговоров.ПолучитьОтветственныхЛицИзКарточкиОрганизации(Договор.Организация);
	
	РуководительОрганизацииИзКарточки			= ДанныеОтветственных.РуководительОрганизации;
	ДолжностьРуководителяОрганизацииИзКарточки 	= ДанныеОтветственных.ДолжностьРуководителя;
	
	ГлавныйБухгалтерОрганизацииИзКарточки		= ДанныеОтветственных.ГлавныйБухгалтер;
	ДолжностьГлавногоБухгалтераИзКарточки 		= ДанныеОтветственных.ДолжностьГлавногоБухгалтера;

КонецПроцедуры

&НаКлиенте
Процедура РедактироватьПодпиантовНажатие(Элемент)
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("Ключ", ПолучитьОрганизацию(Договор));
	
	Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияФормыОрганизации", ЭтотОбъект);
	
	ОткрытьФорму("Справочник.Организации.ФормаОбъекта", СтруктураПараметров,,,,,Оповещение);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияФормыОрганизации(РезультатВыбора, ДополнительныеПараметры) Экспорт
	
	ПолучитьПодпиантовИзКарточкиОрганизацииНаСервере();
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьОрганизацию(Договор)
	Возврат Договор.Организация;
КонецФункции

&НаКлиенте
Процедура ПринадлежностьДоговораПриИзменении(Элемент)
	УстановитьЗаголовокСтраницНаСервере();
КонецПроцедуры  

&НаСервере
Процедура УстановитьЗаголовокСтраницНаСервере()
	
	Если Запись.ИспользуетсяУниверсальныйДокумент Тогда
		ЗаголовокСтраницаСФ 	= "УПД (с/ф)";
		ЗаголовокСтраницаАкт 	= "УПД (Акт)";
	Иначе
		ЗаголовокСтраницаСФ 	= "Счет-фактура";
		ЗаголовокСтраницаАкт 	= "Акт";
	КонецЕсли;
	
	Если Запись.ХарактерДоговора = 1 Тогда
		ЗаголовокСтраницаОтчетЭкспедитора = "Отчет агента";	
	Иначе
		ЗаголовокСтраницаОтчетЭкспедитора = "Отчет экспедитора";	
	КонецЕсли;

	Элементы.ГруппаСФ.Заголовок 	= ЗаголовокСтраницаСФ;
	Элементы.ГруппаАкт.Заголовок 	= ЗаголовокСтраницаАкт;
	Элементы.ГруппаОтчетЭкспедитора.Заголовок = ЗаголовокСтраницаОтчетЭкспедитора;

КонецПроцедуры

//УПД
&НаКлиенте
Процедура ИспользуетсяУниверсальныйДокументПриИзменении(Элемент)
	УстановитьЗаголовокСтраницНаСервере(); 
	УстановитьВидимостьЭлементовДляУПД();
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьЭлементовДляУПД()
	
	Элементы.ГруппаОформлениеТабличнойЧастиСФ.Видимость = Не Запись.ИспользуетсяУниверсальныйДокумент; 
	Элементы.Услуги0Или1Работы.Видимость = Не Запись.ИспользуетсяУниверсальныйДокумент;
	Элементы.ВыводитьРеквизитыПриПечатиАкта.Видимость = Не Запись.ИспользуетсяУниверсальныйДокумент;
	Элементы.ВыводСуммыБезНДСДляАкта.Видимость = Не Запись.ИспользуетсяУниверсальныйДокумент;
	Элементы.ГруппаШаблонДополненияВСчф.Видимость = Не Запись.ИспользуетсяУниверсальныйДокумент; 
	Элементы.ПредставлениеАгентаДляСчетаФактуры.Видимость = Не Запись.ИспользуетсяУниверсальныйДокумент; 

КонецПроцедуры
//УПД

&НаКлиенте
Процедура ВыводитьДополнениеВПодавлеРасчетаПриИзменении(Элемент)

	_УправлениеЭлементамиФормы();

КонецПроцедуры

&НаКлиенте
Процедура ДополнениеПодвалаРасчетаРусНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	
	ПОВ = Новый ОписаниеОповещения("ОбработкаИзмененияШаблонаДополнения", ЭтотОбъект, Элемент.Имя); 
	ПФ = Новый Структура("Шаблон,РасходнаяСтатья,ДоходнаяСтатья", Элементы.ДополнениеВШапкеРасчетаАктаАнгл.ТекстРедактирования, Ложь, Истина);
	ОткрытьФорму("ОбщаяФорма.CW_ФормаРедактированияШаблонов", ПФ,,,,, ПОВ, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

