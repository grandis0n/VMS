&НаСервере
Функция _ПараметрыФормыУчетнойПолитики()
	// --- 
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	|	CW_УчетнаяПолитика.Период КАК Период
	|ИЗ
	|	РегистрСведений.CW_УчетнаяПолитика КАК CW_УчетнаяПолитика
	|ГДЕ
	|	CW_УчетнаяПолитика.Организация = &Организация
	|
	|УПОРЯДОЧИТЬ ПО
	|	Период УБЫВ";
	Запрос.УстановитьПараметр("Организация", Договор.Организация);
	ТЗ = Запрос.Выполнить().Выгрузить();
	Если (ТЗ.Количество() <> 0) Тогда
		
		Период = _сф.к_ПервыйЭлемент(ТЗ).Период;
		
	КонецЕсли; 
	 
	
	// пробуем получить ключ
	Отбор = Новый Структура("Организация,Период", Договор.Организация,Период);
	Ключ = РегистрыСведений.CW_УчетнаяПолитика.СоздатьКлючЗаписи(Отбор);
	// --- 	
	ПФ = Новый Структура("Ключ",Ключ);
	Возврат(ПФ);
	
	// --- 
КонецФункции

