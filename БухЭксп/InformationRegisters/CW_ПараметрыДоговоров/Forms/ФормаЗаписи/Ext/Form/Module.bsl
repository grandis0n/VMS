 &НаСервере
Функция _СформироватьСписокВыбораАдреса(ИмяЭлемента)
	// --- 
	
	СписокВыбора = Новый СписокЗначений;
	
	СведенияКонтрагент = CW_БухгалтерияЭкспедитораСерверПереопределяемый.СведенияОЮрФизЛице(Договор.Владелец, Запись.Период); // ВызовБП
	
	Возврат(СписокВыбора);
	
	// --- 
КонецФункции

&НаСервере
Функция _СформироватьСписокВыбораРуководителя(ИмяЭлемента)
	// --- 
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Контрагент", Договор.Владелец);
	
	Запрос.Текст=
		"ВЫБРАТЬ
		|	КонтактныеЛица.Должность,
		|	КонтактныеЛица.Ссылка,
		|	КонтактныеЛица.Наименование
		|ИЗ
		|	Справочник.КонтактныеЛица КАК КонтактныеЛица
		|ГДЕ
		|	КонтактныеЛица.ОбъектВладелец = &Контрагент";
		Выборка = Запрос.Выполнить().Выбрать();
		Спис = Новый СписокЗначений;

		Если Выборка.Количество() <> 0 тогда
			Пока Выборка.Следующий() цикл
				Если не Выборка.Ссылка.ЭтоГруппа Тогда
					Если Прав(ИмяЭлемента, 4)="Англ" Тогда 
						Спис.Добавить(_СФ.Стр_Транслит(Выборка.Наименование), _СФ.Стр_Транслит(Выборка.Наименование) + " (" + Выборка.Должность + ")");
					Иначе 
						Спис.Добавить(Выборка.Ссылка, Выборка.Наименование + " (" + (Выборка.Должность) + ")");
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;	
		Иначе
			Спис.Добавить(,"<<< Нет сотрудников >>>");	
		КонецЕсли;
	Возврат(спис);
	
	// --- 
КонецФункции

&НаСервере
Процедура _РуководительКонтрагентаРусОбработкаВыбора()
	// --- 
	
	Если НЕ ЗначениеЗаполнено(Запись.ДолжностьРуководителя) Тогда
		Запрос = Новый Запрос;		
		Запрос.Текст =		
			"ВЫБРАТЬ
			|	КонтактныеЛица.Должность
			|ИЗ
			|	Справочник.КонтактныеЛица КАК КонтактныеЛица
			|ГДЕ
			|	КонтактныеЛица.ОбъектВладелец = &Контрагент
			|	И КонтактныеЛица.Ссылка = &Ссылка";
		Запрос.УстановитьПараметр("Контрагент", Договор.Владелец);
		Запрос.УстановитьПараметр("Ссылка", Запись.Руководитель);
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Количество() <> 0 Тогда
			Пока Выборка.Следующий() цикл
				Запись.ДолжностьРуководителя = Выборка.Должность;
			КонецЦикла;	
		КонецЕсли;	
		
	КонецЕсли;	
	
	// --- 
КонецПроцедуры
 
