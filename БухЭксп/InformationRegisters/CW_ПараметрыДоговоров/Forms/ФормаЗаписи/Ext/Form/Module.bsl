&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ВедетсяУчетПриложенийПоДоговорам  = ПолучитьФункциональнуюОпцию("CW_ВедетсяУчетПриложенийПоДоговорам");
		
	Если ТипЗнч(Запись.Договор) = Тип("СправочникСсылка.CW_ДоговорыПоГрузоперевозкам") Тогда
		Договор		= Запись.Договор;
		Заголовок 	= "Параметры договора"; 
		
		Элементы.Владелец.Видимость = Ложь;
		Элементы.ЗаписьДоговор.Заголовок = "Договор";
		
		ИспользуютсяПриложенияПоДоговору = ВедетсяУчетПриложенийПоДоговорам и Договор.ИспользуютсяПриложения;
		
	Иначе
		Договор		= Запись.Договор.Договор;
		Заголовок 	= "Параметры приложения (соглашения)"; 
		
		Элементы.ЗаписьДоговор.Заголовок = "Приложение (соглашение)";
		
		ИспользуютсяПриложенияПоДоговору = Истина;
	КонецЕсли;
	
	ИспользуетсяОграниченияПоГруппамУслуг =  Запись.Договор.ИспользуетсяОграниченияПоГруппамУслуг;
	
	Валюта						= Запись.Договор.ВалютаДоговора;
	
	ВидДоговора 				= Договор.ВидДоговора;
	ЕстьОграниченияНоменклатуры = Договор.ОграничиватьНоменклатуру;
	
	ИспользуютсяЗаказы 			   		= ПолучитьФункциональнуюОпцию("CW_ИспользованиеЗаказов");
	ВалютаРегламентированногоУчетаРубль = ПолучитьФункциональнуюОпцию("CW_ВалютаРегламентированногоУчетаРубль");
	
	БазоваяВалюта 						= CW_Настройки.ВалютаРегламентированногоУчета();
	
	Элементы.ФормироватьСправкуКАкту.Видимость = ИспользуютсяПриложенияПоДоговору и ИспользуетсяОграниченияПоГруппамУслуг;
	
	ТекущаяОрганизация = Договор.Организация;
	
	Если ТипЗнч(Запись.Договор) = Тип("СправочникСсылка.CW_ДоговорыПоГрузоперевозкам") Тогда
		ТекущийКонтрагент  = Запись.Договор.Владелец;
	Иначе
		ТекущийКонтрагент  = Запись.Договор.Договор.Владелец;
	КонецЕсли;
	
	Если Запись.ИзКарточкиОрганизации Тогда
		ОбновитьДанныеОрганизацииИзКарточки(ТекущаяОрганизация);
	КонецЕсли;
	
	Если Запись.РеквизитыИзКарточкиКонтрагента Тогда
		ОбновитьДанныеКонтрагентаИзКарточки(ТекущийКонтрагент);
	КонецЕсли;
	
	//подписанты
	Если Запись.РежимПодписей = 0 Тогда
		ПолучитьПодпиантовИзКарточкиОрганизацииНаСервере();
	КонецЕсли;
	//подписанты
	
	Элементы.ГруппаВыводНаПечать.Видимость 	= ТекущийКонтрагент.ОбособленноеПодразделение;
	ВыводитьРеквизитыГоловнойОрганизации 	= ?(Запись.ВПечатныхФормахВыводитьРеквизитыГоловнойОрганизации,1,0);
	
	Элементы.ГруппаПересчетСуммыРублевогоЭквивалента.Видимость = Валюта <> БазоваяВалюта;
	
	РасчетРублевогоЭквивалентаПропорциональноПоСуммеИтога = ?(Запись.РасчетРублевогоЭквивалентаПропорциональноПоСуммеИтога,1,0);
	
	//Заполнение списка порядка заполнения
	Если ИспользуютсяЗаказы Тогда
		
		Элементы.ПорядокЗаполнения.СписокВыбора.Добавить(2,"По заказу");
		Элементы.ПорядокЗаполнения.СписокВыбора.Добавить(3,"По списку заказов");
		
	КонецЕсли;
	
	//Получим настрйоки пользователя
	СтруктураНастроекПользователя 	= CW_Настройки.ПолучитьНастройкиПользователя();
	
	СтруктураНастроекПользователя.Свойство("ОсновнойПорядокОтраженияДоходов"	, ОсновнойПорядокОтраженияДоходов);
	СтруктураНастроекПользователя.Свойство("ОсновнойПорядокОтраженияРасходов"	, ОсновнойПорядокОтраженияРасходов);
	
	Если Не ЗначениеЗаполнено(ОсновнойПорядокОтраженияДоходов) тогда
		Если ВалютаРегламентированногоУчетаРубль Тогда
			ОсновнойПорядокОтраженияДоходов = Перечисления.CW_ПорядокОтраженияДоходов.СобственнаяУслуга;
		Иначе
			ОсновнойПорядокОтраженияДоходов = Перечисления.CW_ПорядокОтраженияДоходов.ПеревыставлениеПоСтавкам;
		КонецЕсли;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ОсновнойПорядокОтраженияРасходов) тогда
		Если ВалютаРегламентированногоУчетаРубль Тогда
			ОсновнойПорядокОтраженияРасходов = Перечисления.CW_ПорядокОтраженияЗатрат.Затраты;
		Иначе
			ОсновнойПорядокОтраженияРасходов = Перечисления.CW_ПорядокОтраженияДоходов.ПеревыставлениеПоСтавкам;
		КонецЕсли;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Запись.ИсходныйКлючЗаписи) Тогда
		//Новая запись
		Если Не ВалютаРегламентированногоУчетаРубль Тогда
			Запись.ЯзыкПечатиДокументов 			= 1;
			Запись.ВыводитьРеквизитыПриПечатиАкта 	= Ложь;
			Запись.СкрыватьКолонкиНДСвТЧСчета 		= Истина;
		КонецЕсли;
		
		Запись.ОсновнойПорядокОтраженияДоходов  = ОсновнойПорядокОтраженияДоходов;
		Запись.ОсновнойПорядокОтраженияРасходов = ОсновнойПорядокОтраженияРасходов;
		
		Если НЕ ЗначениеЗаполнено(Запись.ПорядокЗаполненияРасчётноПлатёжныхДокументовСФ) Тогда 
			Если ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПокупателем Тогда 
				// с покупателями - Автоматически
				Запись.ПорядокЗаполненияРасчётноПлатёжныхДокументовСФ = Перечисления.CW_ПорядокЗаполненияРасчётноПлатёжныхДокументовСФ.Автоматически;
			Иначе 
				Запись.ПорядокЗаполненияРасчётноПлатёжныхДокументовСФ = Перечисления.CW_ПорядокЗаполненияРасчётноПлатёжныхДокументовСФ.НеУчитывать;
			КонецЕсли;
		КонецЕсли;
		
		Если ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПокупателем Тогда 
			ОсновнойПорядокЗачетаАвансов = CW_Настройки.ПолучитьНастройкуПользователя(ПараметрыСеанса.ТекущийПользователь,"СпособЗачетаАвнасовИсходящихДокументов");
		Иначе 
			ОсновнойПорядокЗачетаАвансов = CW_Настройки.ПолучитьНастройкуПользователя(ПараметрыСеанса.ТекущийПользователь,"СпособЗачетаАвнасовВходящихДокументов");
		КонецЕсли;
		
		Запись.ПорядокЗачетаАвансовОЗ = ?(ЗначениеЗаполнено(ОсновнойПорядокЗачетаАвансов), ОсновнойПорядокЗачетаАвансов, Перечисления.СпособыЗачетаАвансов.Автоматически);
		
		Запись.СчетНаПредоплату = 1;
		
	КонецЕсли;
	
	Элементы.АвтоматическиРасчитыватьПланОплатыПриЗаписиДокумента.Видимость = ВидДоговора = ПредопределенноеЗначение("Перечисление.ВидыДоговоровКонтрагентов.СПоставщиком"); 
	
	// --- 
	
	Элементы.СтраницыДопИнфо.ОтображениеСтраниц=ОтображениеСтраницФормы.Нет;
	// проверяем, не изменилась ли валюта
	
	// ---------------------------------------------------------------------------- 
	
	Элементы.РасчетныйСчетОрганизацииРус.ПараметрыВыбора = _УФКС.СформироватьПараметрВыбораПоля("Отбор.Владелец",Договор.Организация);
	Элементы.РасчетныйСчетОрганизацииАнгл.ПараметрыВыбора = _УФКС.СформироватьПараметрВыбораПоля("Отбор.Владелец",Договор.Организация);
	
	_ОбновитьУчетнуюПолитику();
	_СформироватьПараметрыВыбораДляЭлементов();
	_УправлениеЭлементамиФормы();
	Если Элементы.ГруппаПереключениеЯзыков.Видимость Тогда
		
		_ВыделитьКнопкуЯзыка("RU");
		
	КонецЕсли; 
	
	_ЗаполнитьСпискиРеквизитов();
	
	
	Элементы.НалоговыйАгент_НДСЗаСчетСредствПоставщика.Видимость = Запись.Договор.УчетныйДоговор.УчетАгентскогоНДС;
	
	//----
	Элементы.АдресПечати.РазмерКартинки=РазмерКартинки.АвтоРазмер;
	КартинкаПечать = РеквизитФормыВЗначение("Запись").Печать.Получить();
	Если (КартинкаПечать <> Неопределено) Тогда
		АдресПечати = ПоместитьВоВременноеХранилище(КартинкаПечать,ЭтаФорма.УникальныйИдентификатор);
	Иначе
		АдресПечати = "";
	КонецЕсли; 
	
	//----
	
	Элементы.АдресПодписиРуководителя.РазмерКартинки=РазмерКартинки.АвтоРазмер;
	КартинкаПодписи = РеквизитФормыВЗначение("Запись").ПодписьРуководителя.Получить();
	Если (КартинкаПодписи <> Неопределено) Тогда
		АдресПодписиРуководителя = ПоместитьВоВременноеХранилище(КартинкаПодписи,ЭтаФорма.УникальныйИдентификатор);
	Иначе
		АдресПодписиРуководителя = "";
	КонецЕсли; 
	
	//----
	
	Элементы.АдресПодписиГлавногоБухгалтера.РазмерКартинки=РазмерКартинки.АвтоРазмер;
	КартинкаПодписиГлавногоБухгалтера = РеквизитФормыВЗначение("Запись").ПодписьГлБухгалтера.Получить();
	Если (КартинкаПодписиГлавногоБухгалтера <> Неопределено) Тогда
		АдресПодписиГлавногоБухгалтера = ПоместитьВоВременноеХранилище(КартинкаПодписиГлавногоБухгалтера,ЭтаФорма.УникальныйИдентификатор);
	Иначе
		АдресПодписиГлавногоБухгалтера = "";
	КонецЕсли;  
	
	Элементы.ГруппаРасчетКАкту.Видимость = Запись.ТребуетсяРасчетКАкту;

	ПорядокПеревыставленияПриИзмененииНаСервере();
	СчетНаПредоплатуПриИзмененииНаСервере();  
	УстановитьЗаголовокСтраницНаСервере();
	УстановитьВидимостьЭлементовДляУПД();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ОбновитьДопИнфо();
	УправлениеЭлементамиФормы(); 
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	Если Запись.АвтоматическийРасчетВознаграждения И Запись.Номенклатура.Пустая() Тогда
		
		_УФК.ВывестиПредупреждение("Не указана Номенклатура вознаграждения.");
		Отказ = Истина;
		Возврат;
		
	КонецЕсли; 
	
	// если не заданы значения, то принудительно определим их
	Если Не ЗначениеЗаполнено(Запись.ОсновнойПорядокОтраженияДоходов) Тогда
		Если ЗначениеЗаполнено(ОсновнойПорядокОтраженияДоходов) Тогда
			Запись.ОсновнойПорядокОтраженияДоходов = ОсновнойПорядокОтраженияДоходов;
		Иначе
			Если Не ЗначениеЗаполнено(ОсновнойПорядокОтраженияДоходов) тогда
				Если ВалютаРегламентированногоУчетаРубль Тогда
					Запись.ОсновнойПорядокОтраженияДоходов = ПредопределенноеЗначение("Перечисление.CW_ПорядокОтраженияДоходов.СобственнаяУслуга");
				Иначе
					Запись.ОсновнойПорядокОтраженияДоходов = ПредопределенноеЗначение("Перечисление.CW_ПорядокОтраженияДоходов.ПеревыставлениеПоСтавкам");
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Запись.ОсновнойПорядокОтраженияРасходов) Тогда
		Если ЗначениеЗаполнено(ОсновнойПорядокОтраженияРасходов) Тогда
			Запись.ОсновнойПорядокОтраженияРасходов = ОсновнойПорядокОтраженияРасходов;
		Иначе
			Если Не ЗначениеЗаполнено(ОсновнойПорядокОтраженияРасходов) тогда
				Если ВалютаРегламентированногоУчетаРубль Тогда
					Запись.ОсновнойПорядокОтраженияРасходов = ПредопределенноеЗначение("Перечисление.CW_ПорядокОтраженияЗатрат.Затраты");
				Иначе
					Запись.ОсновнойПорядокОтраженияРасходов =  ПредопределенноеЗначение("Перечисление.CW_ПорядокОтраженияЗатрат.ПеревыставлениеПоСтавкам") ;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Запись.РасчетРублевогоЭквивалентаПропорциональноПоСуммеИтога = РасчетРублевогоЭквивалентаПропорциональноПоСуммеИтога = 1;
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	Если Валюта = БазоваяВалюта ИЛИ Договор.ВзаиморасчетыВУЕ Тогда
		
		Если Запись.ЯзыкПечатиДокументов<>0 Тогда 
			Запись.ЯзыкПечатиДокументов = 0;
		КонецЕсли;
		
	КонецЕсли;
	
	// ------
	
	Если (АдресПодписиГлавногоБухгалтера = "") Тогда
		ТекущийОбъект.ПодписьГлБухгалтера = Новый ХранилищеЗначения(Неопределено);
	Иначе
		ТекущийОбъект.ПодписьГлБухгалтера = Новый ХранилищеЗначения(ПолучитьИзВременногоХранилища(АдресПодписиГлавногоБухгалтера));	
	КонецЕсли;  
	
	// ------
	
	Если (АдресПодписиРуководителя = "") Тогда
		ТекущийОбъект.ПодписьРуководителя = Новый ХранилищеЗначения(Неопределено);
	Иначе
		ТекущийОбъект.ПодписьРуководителя = Новый ХранилищеЗначения(ПолучитьИзВременногоХранилища(АдресПодписиРуководителя));	
	КонецЕсли; 
	
	// ------
	
	Если (АдресПечати = "") Тогда
		ТекущийОбъект.Печать = Новый ХранилищеЗначения(Неопределено);
	Иначе
		ТекущийОбъект.Печать = Новый ХранилищеЗначения(ПолучитьИзВременногоХранилища(АдресПечати));	
	КонецЕсли; 

	ТекущийОбъект.ВПечатныхФормахВыводитьРеквизитыГоловнойОрганизации = ВыводитьРеквизитыГоловнойОрганизации = 1;
	
КонецПроцедуры

&НаСервере
Функция _ЗаполнитьСпискиРеквизитов()
	// --- 
	
	#Область Контрагент
	
	СведенияКонтрагент = CW_БухгалтерияЭкспедитораСерверПереопределяемый.СведенияОЮрФизЛице(Договор.Владелец, Запись.Период); // ВызовБП
	
	#Область Адрес 
	Элементы.АдресКонтрагентаРус.СписокВыбора.Очистить();
	Элементы.АдресКонтрагентаАнгл.СписокВыбора.Очистить();
	
	Если (ЗначениеЗаполнено(СведенияКонтрагент.ФактическийАдрес)) Тогда
		
		Элементы.АдресКонтрагентаРус.СписокВыбора.Добавить(СведенияКонтрагент.ФактическийАдрес);
		Элементы.АдресКонтрагентаАнгл.СписокВыбора.Добавить(_сф.стр_Транслит(СведенияКонтрагент.ФактическийАдрес));
		
	КонецЕсли; 
	Если (ЗначениеЗаполнено(СведенияКонтрагент.ЮридическийАдрес)) Тогда
		
		Если (СведенияКонтрагент.ЮридическийАдрес <> СведенияКонтрагент.ФактическийАдрес) Тогда
			Элементы.АдресКонтрагентаРус.СписокВыбора.Добавить(СведенияКонтрагент.ЮридическийАдрес);
			Элементы.АдресКонтрагентаАнгл.СписокВыбора.Добавить(_сф.стр_Транслит(СведенияКонтрагент.ЮридическийАдрес));	
		КонецЕсли; 
		
	КонецЕсли; 
	
	Если (Элементы.АдресКонтрагентаРус.СписокВыбора.Количество() = 0) Тогда
		Элементы.АдресКонтрагентаРус.СписокВыбора.Добавить("<< нет данных >>");
	КонецЕсли; 
	Если (Элементы.АдресКонтрагентаАнгл.СписокВыбора.Количество() = 0) Тогда
		Элементы.АдресКонтрагентаАнгл.СписокВыбора.Добавить("<< нет данных >>");
	КонецЕсли; 
	
	#КонецОбласти 
	
	#Область Телефон
	
	Элементы.ТелефонКонтрагентаРус.СписокВыбора.Очистить();
	Если (ЗначениеЗаполнено(СведенияКонтрагент.Телефоны)) Тогда
		
		Элементы.ТелефонКонтрагентаРус.СписокВыбора.Добавить(СведенияКонтрагент.Телефоны);
		
	КонецЕсли; 
	Если (Элементы.ТелефонКонтрагентаРус.СписокВыбора.Количество() = 0) Тогда
		Элементы.ТелефонКонтрагентаРус.СписокВыбора.Добавить("<< нет данных >>");
	КонецЕсли; 
	
	#КонецОбласти 
	
	#Область КонтактныеЛица
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Контрагент", Договор.Владелец);
	Запрос.Текст=
	"ВЫБРАТЬ
	|	КонтактныеЛица.Должность,
	|	КонтактныеЛица.Ссылка,
	|	КонтактныеЛица.Наименование,
	|	КонтактныеЛица.Роль
	|ИЗ
	|	Справочник.КонтактныеЛица КАК КонтактныеЛица
	|ГДЕ
	|	КонтактныеЛица.ОбъектВладелец = &Контрагент";	
	// --- 
	ТЗ = Запрос.Выполнить().Выгрузить();
	
	#Область РуководительКонтрагента 
	РольРуководителя = Константы.CW_РольРуководителя.Получить();
	Если (ЗначениеЗаполнено(РольРуководителя)) Тогда
		
		Отбор = Новый Структура("Роль",РольРуководителя);
		ТаблицаРуководителей = ТЗ.Скопировать(Отбор);
		// --- 
		КолонкаДолжностей = ТаблицаРуководителей.Скопировать(,"Должность");
		КолонкаДолжностей.Свернуть("Должность");
		МассивДолжностей = КолонкаДолжностей.ВыгрузитьКолонку("Должность");
		
	Иначе
		
		ТаблицаРуководителей = ТЗ;
		МассивДолжностей = Новый Массив;
		МассивДолжностей.Добавить("Генеральный директор");
		
	КонецЕсли; 
	
	Элементы.ДолжностьРуководителяКонтрагентаРус.СписокВыбора.Очистить();
	Элементы.ДолжностьРуководителяКонтрагентаАнгл.СписокВыбора.Очистить();
	Для каждого Стр Из МассивДолжностей Цикл
		
		Элементы.ДолжностьРуководителяКонтрагентаРус.СписокВыбора.Добавить(Стр);
		Элементы.ДолжностьРуководителяКонтрагентаАнгл.СписокВыбора.Добавить(_сф.стр_Транслит(Стр));
		
	КонецЦикла; 
	// --- 
	Если (Элементы.ДолжностьРуководителяКонтрагентаРус.СписокВыбора.Количество()=0) Тогда
		Элементы.ДолжностьРуководителяКонтрагентаРус.СписокВыбора.Добавить("< не указан>");
	КонецЕсли; 
	Если (Элементы.ДолжностьРуководителяКонтрагентаАнгл.СписокВыбора.Количество()=0) Тогда
		Элементы.ДолжностьРуководителяКонтрагентаАнгл.СписокВыбора.Добавить("< не указан>");
	КонецЕсли; 
	
	// --- 
	
	Элементы.РуководительКонтрагентаРус.СписокВыбора.Очистить();
	Элементы.РуководительКонтрагентаАнгл.СписокВыбора.Очистить();
	// --- 
	Для каждого Стр Из ТаблицаРуководителей Цикл
		
		ФИО = Стр.Наименование;
		Элементы.РуководительКонтрагентаРус.СписокВыбора.Добавить(ФИО);
		Элементы.РуководительКонтрагентаАнгл.СписокВыбора.Добавить(_сф.стр_Транслит(ФИО));
		
	КонецЦикла; 
	// --- 
	Если (Элементы.РуководительКонтрагентаРус.СписокВыбора.Количество() = 0) Тогда
		
		Элементы.РуководительКонтрагентаРус.СписокВыбора.Добавить("< не указан>");
		
	КонецЕсли; 
	Если (Элементы.РуководительКонтрагентаАнгл.СписокВыбора.Количество() = 0) Тогда
		
		Элементы.РуководительКонтрагентаАнгл.СписокВыбора.Добавить("< не указан>");
		
	КонецЕсли; 
	
	#КонецОбласти 
	
	#Область ГлавныйБухгалтерКонтрагента 
	
	РольГлавногоБухгалтера = Константы.CW_РольГлавногоБухгалтера.Получить();
	Если (ЗначениеЗаполнено(РольРуководителя)) Тогда
		
		Отбор = Новый Структура("Роль",РольГлавногоБухгалтера);
		ТаблицаБухгалтеров = ТЗ.Скопировать(Отбор);
		
	Иначе
		
		ТаблицаБухгалтеров = ТЗ;
		
	КонецЕсли; 
	
	Элементы.ГлавныйБухгалтерКонтрагентаРус.СписокВыбора.Очистить();
	Элементы.ГлавныйБухгалтерКонтрагентаАнгл.СписокВыбора.Очистить();
	// --- 
	Для каждого Стр Из ТаблицаБухгалтеров Цикл
		
		ФИО = Стр.Наименование;
		Элементы.ГлавныйБухгалтерКонтрагентаРус.СписокВыбора.Добавить(ФИО);
		Элементы.ГлавныйБухгалтерКонтрагентаАнгл.СписокВыбора.Добавить(_сф.стр_Транслит(ФИО));
		
	КонецЦикла; 
	// --- 
	Если (Элементы.ГлавныйБухгалтерКонтрагентаРус.СписокВыбора.Количество() = 0) Тогда
		
		Элементы.ГлавныйБухгалтерКонтрагентаРус.СписокВыбора.Добавить("< не указан>");
		
	КонецЕсли; 
	Если (Элементы.ГлавныйБухгалтерКонтрагентаАнгл.СписокВыбора.Количество() = 0) Тогда
		
		Элементы.ГлавныйБухгалтерКонтрагентаАнгл.СписокВыбора.Добавить("< не указан>");
		
	КонецЕсли; 
	
	#КонецОбласти 
	
	#КонецОбласти 
	
	#КонецОбласти 
	
	// --- 
	
	#Область Организация
	
	СведенияОрганизация		= CW_БухгалтерияЭкспедитораСерверПереопределяемый.СведенияОЮрФизЛице(Договор.Организация,Запись.Период); // ВызовБП
	СведенияОрганизацияАнгл = РегистрыСведений.CW_УчетнаяПолитика.ПолучитьСведенияОбОрганизацииНаАнглийскомЯзыке(Договор.Организация);
							//НаименованиеОрганизации,ДолжностьРуководителя,АдресОрганизации"

	#Область АдресОрганизации
	
	Элементы.АдресОрганизацииРус.СписокВыбора.Очистить();
	
	Если ЗначениеЗаполнено(СведенияОрганизация.ФактическийАдрес) Тогда
		Элементы.АдресОрганизацииРус.СписокВыбора.Добавить(СведенияОрганизация.ФактическийАдрес);
	КонецЕсли; 
	
	Если ЗначениеЗаполнено(СведенияОрганизация.ЮридическийАдрес) 
		И СведенияОрганизация.ЮридическийАдрес <> СведенияОрганизация.ФактическийАдрес Тогда
		Элементы.АдресОрганизацииРус.СписокВыбора.Добавить(СведенияОрганизация.ЮридическийАдрес);
	КонецЕсли; 
	Если Элементы.АдресОрганизацииРус.СписокВыбора.Количество() = 0 Тогда
		Элементы.АдресОрганизацииРус.СписокВыбора.Добавить("< не указано >");
	КонецЕсли; 

	
	Элементы.АдресОрганизацииАнгл.СписокВыбора.Очистить();
	Если ЗначениеЗаполнено(СведенияОрганизацияАнгл.АдресОрганизации) Тогда
		Элементы.АдресОрганизацииАнгл.СписокВыбора.Добавить(СведенияОрганизацияАнгл.АдресОрганизации);
	Иначе
		
		Если ЗначениеЗаполнено(СведенияОрганизация.ФактическийАдрес) Тогда
			Элементы.АдресОрганизацииАнгл.СписокВыбора.Добавить(_сф.стр_Транслит(СведенияОрганизация.ФактическийАдрес));
		КонецЕсли;
		Если ЗначениеЗаполнено(СведенияОрганизация.ЮридическийАдрес)
			И СведенияОрганизация.ЮридическийАдрес <> СведенияОрганизация.ФактическийАдрес Тогда
			Элементы.АдресОрганизацииАнгл.СписокВыбора.Добавить(_сф.стр_Транслит(СведенияОрганизация.ЮридическийАдрес));
		КонецЕсли;
		
	КонецЕсли;
	
	Если Элементы.АдресОрганизацииАнгл.СписокВыбора.Количество() = 0 Тогда
		Элементы.АдресОрганизацииАнгл.СписокВыбора.Добавить("< не указано >");
	КонецЕсли; 
	
	#КонецОбласти 
	
	
	#Область ТелефонОрганизации
	
	Элементы.ТелефонОрганизацииРус.СписокВыбора.Очистить();
	Если (ЗначениеЗаполнено(СведенияОрганизация.Телефоны)) Тогда
		Элементы.ТелефонОрганизацииРус.СписокВыбора.Добавить(СведенияОрганизация.Телефоны);
	КонецЕсли; 
	Если (Элементы.ТелефонОрганизацииРус.СписокВыбора.Количество() = 0 ) Тогда
		Элементы.ТелефонОрганизацииРус.СписокВыбора.Добавить("< не указано >");
	КонецЕсли; 
	
	#КонецОбласти 
	
	// --- 
	
	#Область ОтветственныеЛицаОрганизации
	
	ОтветственныеЛица = ОтветственныеЛицаБППереопределяемый.ОтветственныеЛица(Договор.Организация,Запись.Период);
	
	#Область ДолжностьРуководителяОрганизации
	
	Элементы.ДолжностьРуководителяОрганизации.СписокВыбора.Очистить();
	Если ЗначениеЗаполнено(ОтветственныеЛица.РуководительДолжностьПредставление) Тогда
		Элементы.ДолжностьРуководителяОрганизации.СписокВыбора.Добавить(ОтветственныеЛица.РуководительДолжностьПредставление);
	КонецЕсли;
	Если Элементы.ДолжностьРуководителяОрганизации.СписокВыбора.Количество() = 0 Тогда
		Элементы.ДолжностьРуководителяОрганизации.СписокВыбора.Добавить("< не указано >");
	КонецЕсли; 
	
	Элементы.ДолжностьРуководителяОрганизацииАнгл.СписокВыбора.Очистить();
	Если ЗначениеЗаполнено(СведенияОрганизацияАнгл.ДолжностьРуководителя) Тогда
		Элементы.ДолжностьРуководителяОрганизацииАнгл.СписокВыбора.Добавить(СведенияОрганизацияАнгл.ДолжностьРуководителя);
	КонецЕсли;	
	Если Элементы.ДолжностьРуководителяОрганизацииАнгл.СписокВыбора.Количество() = 0 Тогда
		Элементы.ДолжностьРуководителяОрганизацииАнгл.СписокВыбора.Добавить("< не указано >");
	КонецЕсли; 
	
	#КонецОбласти 
	
	// --- 
	
	#Область Руководитель
	
	Элементы.РуководительОрганизации.СписокВыбора.Очистить();
	Если (ЗначениеЗаполнено(ОтветственныеЛица.Руководитель)) Тогда
		Элементы.РуководительОрганизации.СписокВыбора.Добавить(ОтветственныеЛица.Руководитель);
	КонецЕсли; 
	Если (Элементы.РуководительОрганизации.СписокВыбора.Количество() =0) Тогда
		Элементы.РуководительОрганизации.СписокВыбора.Добавить(Справочники.ФизическиеЛица.ПустаяСсылка(),"< не указано >");
	КонецЕсли; 
	
	#КонецОбласти 
	
	// --- 
	
	#Область ГлавныйБухгалтерОрганизации
	
	Элементы.ГлавныйБухгалтерОрганизации.СписокВыбора.Очистить();
	Если (ЗначениеЗаполнено(ОтветственныеЛица.ГлавныйБухгалтер)) Тогда
		Элементы.ГлавныйБухгалтерОрганизации.СписокВыбора.Добавить(ОтветственныеЛица.ГлавныйБухгалтер);
	КонецЕсли; 
	Если (Элементы.ГлавныйБухгалтерОрганизации.СписокВыбора.Количество() =0) Тогда
		Элементы.ГлавныйБухгалтерОрганизации.СписокВыбора.Добавить(Справочники.ФизическиеЛица.ПустаяСсылка(),"< не указано >");
	КонецЕсли; 
	
	#КонецОбласти 
	
	// --- 
	
	#КонецОбласти 
	
	#КонецОбласти 
	
	// --- 
КонецФункции

&НаСервере
Процедура _УправлениеЭлементамиФормы()
	
	_РуководительОрганизацииАнглПриИзменении();
	_ГлавныйБухгалтерОрганизацииАнглПриИзменении();
	
	СтруктураПараметровБухУчета = Новый Структура;
	
	Если ТипЗнч(Запись.Договор) = Тип("СправочникСсылка.CW_ДоговорыПоГрузоперевозкам") Тогда
		СтруктураПараметровБухУчета.Вставить("Договор", 			Запись.Договор);
		СтруктураПараметровБухУчета.Вставить("ПриложениеКДоговору",	ПредопределенноеЗначение("Справочник.CW_ПриложенияКДоговорам.ПустаяСсылка"));
	Иначе
		СтруктураПараметровБухУчета.Вставить("Договор",				Запись.Договор.Договор);
		СтруктураПараметровБухУчета.Вставить("ПриложениеКДоговору",	Запись.Договор);
	КонецЕсли;
	
	ПараметрыБухгалтерскогоУчета = CW_Финансы.ПолучитьПарметрыВеденияБухгалтерскогоУчета(СтруктураПараметровБухУчета);
	
	Элементы.ПорядокЗачетаАвансов.Доступность = ПараметрыБухгалтерскогоУчета.БухгалтерскийУчет;
	
	// Видимость элементов группы "Расчет вознаграждения"
	Элементы.МоментАвтоматическогоВыставленияВознаграждения.Видимость = Запись.АвтоматическийРасчетВознаграждения;
	Элементы.ГруппаВариантРасчета.Видимость = Запись.АвтоматическийРасчетВознаграждения;
	Элементы.ГруппаНоменклатураВознаграждения.Видимость = Запись.АвтоматическийРасчетВознаграждения;
	Элементы.ИсключатьКН.Видимость = Запись.АвтоматическийРасчетВознаграждения;
	
	Если Запись.АвтоматическийРасчетВознаграждения Тогда 
		Если Запись.ВариантРасчетаВознаграждения = Перечисления.CW_ВариантыАвтоматическогоРасчетаВознаграждения.ПроцентОтСуммы Тогда
			
			Элементы.РазмерАгентскогоВознаграждения.Видимость = Истина;
			Элементы.РазмерАгентскогоВознаграждения.Заголовок = "Процент";
			Элементы.ИсключатьКН.Видимость = Истина;
			Элементы.МоментАвтоматическогоВыставленияВознаграждения.Доступность = Истина;
			Элементы.СтавкаНДС.Видимость = Истина;
			
		ИначеЕсли Запись.ВариантРасчетаВознаграждения = Перечисления.CW_ВариантыАвтоматическогоРасчетаВознаграждения.ФиксированнаяСумма Тогда 
			
			Элементы.РазмерАгентскогоВознаграждения.Видимость = Истина;
			Элементы.РазмерАгентскогоВознаграждения.Заголовок = "Сумма, "+Валюта.Наименование;
			Элементы.ИсключатьКН.Видимость = Ложь;
			Элементы.МоментАвтоматическогоВыставленияВознаграждения.Доступность = Истина;
			Элементы.СтавкаНДС.Видимость = Истина;
			
		ИначеЕсли Запись.ВариантРасчетаВознаграждения = Перечисления.CW_ВариантыАвтоматическогоРасчетаВознаграждения.ДоходыМинусРасходы Тогда 
			
			Элементы.РазмерАгентскогоВознаграждения.Видимость = Ложь;
			Элементы.ИсключатьКН.Видимость = Ложь;
			Элементы.МоментАвтоматическогоВыставленияВознаграждения.Доступность = Ложь;
			Элементы.СтавкаНДС.Видимость = Ложь;
			
		Иначе
			
			Элементы.РазмерАгентскогоВознаграждения.Видимость = Ложь;
			Элементы.ИсключатьКН.Видимость = Ложь;
			Элементы.МоментАвтоматическогоВыставленияВознаграждения.Доступность = Ложь;
			Элементы.СтавкаНДС.Видимость = Ложь;
			
		КонецЕсли;
	КонецЕсли;
	
	
	
	// в зависимости от варианта печати обеспечим доступ к данным на английском языке
	Если БазоваяВалюта = Валюта  Тогда 
		//Элементы.РеквизитыАнглийскийЯзык.Видимость 	= Ложь;
		//Элементы.РеквизитыРусскийЯзык.Видимость 	= Ложь;
		Элементы.СтраницыДопИнфо.ТекущаяСтраница 	= Элементы.СтраницаДопИнфоРус;
	Иначе 
		//Элементы.РеквизитыАнглийскийЯзык.Видимость 	= Истина;
		//Элементы.РеквизитыРусскийЯзык.Видимость 	= Истина;
		Элементы.СтраницыДопИнфо.ТекущаяСтраница 	= Элементы.СтраницаДопИнфоРусАнгл;
	КонецЕсли;
	
	Элементы.ГруппаРеквизитыДокументов.Видимость = ВидДоговора=Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком;
	Элементы.ГруппаРасчетВознаграждения.Видимость = Не ВидДоговора=Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком;
	
	// отображение и скрытие лишних элементов
	Элементы.ГруппаПодписантыИзКарточки.Видимость 	= Запись.РежимПодписей = 0;   
	Элементы.ГруппаФиксированные.Видимость 			= Запись.РежимПодписей = 1;  
	Элементы.ГруппаФиксированыеАнгл.Видимость 		= Запись.РежимПодписей = 1;  
	Элементы.ВариантПодписей.Видимость 				= Запись.РежимПодписей = 2;  
	Элементы.ВариантПодписейАнгл.Видимость 			= Запись.РежимПодписей = 2;  
	
	Элементы.ЗаполнитьРеквизитыОрганизацииРус.Видимость = Не (Запись.ИзКарточкиОрганизации и Запись.РежимПодписей = 0);  
	
	Элементы.ОсновнойПорядокОтраженияДоходов.Видимость = (ВидДоговора=Перечисления.ВидыДоговоровКонтрагентов.СПокупателем);
	Элементы.ОсновнойПорядокОтраженияРасходов.Видимость = (ВидДоговора=Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком);
	
	Элементы.ДополнениеВШапкеСчета.Видимость     			= Запись.ВыводитьДополнениеВШапкуСчета 	И (Запись.ЯзыкПечатиДокументов = 0 ИЛИ Запись.ЯзыкПечатиДокументов = 2);
	Элементы.ДополнениеВШапкеСчетаАнгл.Видимость 			= Запись.ВыводитьДополнениеВШапкуСчета 	И (Запись.ЯзыкПечатиДокументов = 1 ИЛИ Запись.ЯзыкПечатиДокументов = 2);
	Элементы.ПодвалВСчете.Видимость    						= Запись.ВыводитьПодвалВСчете = 2 		И (Запись.ЯзыкПечатиДокументов = 0 ИЛИ Запись.ЯзыкПечатиДокументов = 2);
	Элементы.ПодвалВСчетеАнгл.Видимость 					= Запись.ВыводитьПодвалВСчете = 2 		И (Запись.ЯзыкПечатиДокументов = 1 ИЛИ Запись.ЯзыкПечатиДокументов = 2);
	Элементы.ДополнениеВШапкеАкта.Видимость     			= Запись.ВыводитьДополнениеВШапкуАкта 	И (Запись.ЯзыкПечатиДокументов = 0 ИЛИ Запись.ЯзыкПечатиДокументов = 2);
	Элементы.ДополнениеВШапкеАктаАнгл.Видимость 			= Запись.ВыводитьДополнениеВШапкуАкта 	И (Запись.ЯзыкПечатиДокументов = 1 ИЛИ Запись.ЯзыкПечатиДокументов = 2);
	Элементы.ДополнениеВШапкеСчф.Видимость     				= Запись.ВыводитьДополнениевШапкуСчф 	И (Запись.ЯзыкПечатиДокументов = 0 ИЛИ Запись.ЯзыкПечатиДокументов = 2);
	Элементы.ДополнениеВШапкеСчфАнгл.Видимость 				= Запись.ВыводитьДополнениевШапкуСчф 	И (Запись.ЯзыкПечатиДокументов = 1 ИЛИ Запись.ЯзыкПечатиДокументов = 2);
	
	Элементы.ДополнениеВШапкеРасчетаАкта.Видимость		= Запись.ВыводитьДополнениевШапкуРасчетаАкта 	И (Запись.ЯзыкПечатиДокументов = 0 ИЛИ Запись.ЯзыкПечатиДокументов = 2);
	Элементы.ДополнениеВШапкеРасчетаАктаАнгл.Видимость	= Запись.ВыводитьДополнениевШапкуРасчетаАкта 	И (Запись.ЯзыкПечатиДокументов = 1 ИЛИ Запись.ЯзыкПечатиДокументов = 2);
	
	ПриИзмененииФлагаВыводитьДополнениеВПодвалеОтчетаЭкспедитора();
	ПриИзмененииФлагаВыводитьДополнениеВШапкеОтчетаЭкспедитора();
	
	Элементы.ТипЦен.Видимость 	= Не ЕстьОграниченияНоменклатуры;
	Элементы.ГруппаСФ.Видимость = ВалютаРегламентированногоУчетаРубль;
	
	Элементы.ГруппаРасчетКАкту.Видимость 				= Запись.ТребуетсяРасчетКАкту;
	Элементы.ДополнениеВШапкеСправкиКАкту.Видимость		= Запись.ВыводитьДополнениевШапкуСправкиКАкту;
	Элементы.ГруппаСправка.Видимость					= Запись.ФормироватьСправку;

	Элементы.ДополнениеПодвалаАктаРус.Видимость     	= Запись.ВыводитьДополнениеВПодавлеАкта И (Запись.ЯзыкПечатиДокументов = 0 ИЛИ Запись.ЯзыкПечатиДокументов = 2);
	Элементы.ДополнениеПодвалаАктаАнгл.Видимость 		= Запись.ВыводитьДополнениеВПодавлеАкта И (Запись.ЯзыкПечатиДокументов = 1 ИЛИ Запись.ЯзыкПечатиДокументов = 2);

	Элементы.ДополнениеПодвалаРасчетаРус.Видимость     	= Запись.ВыводитьДополнениеВПодавлеРасчета И (Запись.ЯзыкПечатиДокументов = 0 ИЛИ Запись.ЯзыкПечатиДокументов = 2);
	Элементы.ДополнениеПодвалаРасчетаАнгл.Видимость 	= Запись.ВыводитьДополнениеВПодавлеРасчета И (Запись.ЯзыкПечатиДокументов = 1 ИЛИ Запись.ЯзыкПечатиДокументов = 2);
	
	Элементы.НужноПечататьQRКод.Видимость = Запись.ЯзыкПечатиДокументов = 0;
	
	УстановитьВидимостьРеквизитовОрганизции();
	УстановитьВидимостьРеквизитовКонтрагента();
	
КонецПроцедуры

