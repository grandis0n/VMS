	РасчетныйСчетИзКарточкиОрганизации 	= "№"+СведенияОбОрганизации.НомерСчета +", в "+СведенияОбОрганизации.Банк;
	АдресИзКарточкиОрганизации 			= СведенияОбОрганизации.ЮридическийАдрес;
