&НаСервере
Процедура _ЗаполнитьРеквизитыОрганизацииРус()
	// --- 
	
	Если Не Запись.РежимПодписей = 0 Тогда
		//Создаем отбор для получения бухгалтера
		Отбор = Новый Структура("СтруктурнаяЕдиница,ОтветственноеЛицо", Договор.Организация, Перечисления.ОтветственныеЛицаОрганизаций.ГлавныйБухгалтер);
		Запись.ГлавныйБухгалтерОрганизации = РегистрыСведений.ОтветственныеЛицаОрганизаций.ПолучитьПоследнее(Запись.Период, Отбор).ФизическоеЛицо;
		
		//Меняем отбор для получения руководителя
		Отбор.ОтветственноеЛицо = Перечисления.ОтветственныеЛицаОрганизаций.Руководитель;
		рс = РегистрыСведений.ОтветственныеЛицаОрганизаций.ПолучитьПоследнее(ТекущаяДата(), Отбор); // МетаданныеБП
		Запись.РуководительОрганизации          = рс.ФизическоеЛицо;
		Запись.ДолжностьРуководителяОрганизации = рс.Должность;
	КонецЕсли;
	
	Если Не Запись.ИзКарточкиОрганизации Тогда
		_СведенияОбОрганизации = CW_БухгалтерияЭкспедитораСерверПереопределяемый.СведенияОЮрФизЛице(Договор.Организация, Запись.Период); // ВызовБП
		Запись.АдресОрганизации   =_СведенияОбОрганизации.ЮридическийАдрес;
		Запись.ТелефонОрганизации =_СведенияОбОрганизации.Телефоны;
		
		Запись.РасчетныйСчетОрганизации = Договор.Организация.ОсновнойБанковскийСчет;	
	КонецЕсли;
	// --- 
КонецПроцедуры

&НаСервере
Процедура _ЗаполнитьРеквизитыОрганизацииАнгл()
	// --- 
	
	з = Новый Запрос(
		"ВЫБРАТЬ
		|	CW_ИностранныеБанковскиеСчета.Ссылка
		|ИЗ
		|	Справочник.CW_ИностранныеБанковскиеСчета КАК CW_ИностранныеБанковскиеСчета
		|ГДЕ
		|	CW_ИностранныеБанковскиеСчета.Владелец = &Организация
		|	И CW_ИностранныеБанковскиеСчета.ВалютаДенежныхСредств = &Валюта"
	);
	з.УстановитьПараметр("Организация", Договор.Организация);
	з.УстановитьПараметр("Валюта", Валюта);
	рз = з.Выполнить();
	выб = рз.Выбрать();
	Если выб.Следующий() Тогда 
		Запись.РасчетныйСчетОрганизацииИностранный = выб.Ссылка;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Запись.РуководительОрганизации) Тогда 
		Отбор = Новый Структура("СтруктурнаяЕдиница,ОтветственноеЛицо", Договор.Организация, Перечисления.ОтветственныеЛицаОрганизаций.Руководитель);
		рс = РегистрыСведений.ОтветственныеЛицаОрганизаций.ПолучитьПоследнее(ТекущаяДата(), Отбор);
		Запись.РуководительОрганизации          = рс.ФизическоеЛицо;
		Запись.ДолжностьРуководителяОрганизации = рс.Должность;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Запись.ГлавныйБухгалтерОрганизации) Тогда 
		Отбор = Новый Структура("СтруктурнаяЕдиница,ОтветственноеЛицо", Договор.Организация, Перечисления.ОтветственныеЛицаОрганизаций.ГлавныйБухгалтер);
		Запись.ГлавныйБухгалтерОрганизации = РегистрыСведений.ОтветственныеЛицаОрганизаций.ПолучитьПоследнее(ТекущаяДата(), Отбор).ФизическоеЛицо;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Запись.РуководительОрганизации) Тогда 
		стр = РегистрыСведений.CW_ПараметрыСотрудников.ПолучитьФамилиюИмяАнгл(Запись.РуководительОрганизации);
		Если НЕ ЗначениеЗаполнено(стр) Тогда 
			стр = _СФ.Стр_Транслит(Запись.РуководительОрганизации.Наименование);
			РегистрыСведений.CW_ПараметрыСотрудников.УстановитьФамилиюИмяАнгл(Запись.РуководительОрганизации, стр);
		КонецЕсли;
		_РуководительОрганизацииАнглПриИзменении();
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Запись.ГлавныйБухгалтерОрганизации) Тогда 
		стр = РегистрыСведений.CW_ПараметрыСотрудников.ПолучитьФамилиюИмяАнгл(Запись.ГлавныйБухгалтерОрганизации);
		Если НЕ ЗначениеЗаполнено(стр) Тогда 
			стр = _СФ.Стр_Транслит(Запись.ГлавныйБухгалтерОрганизации.Наименование);
			РегистрыСведений.CW_ПараметрыСотрудников.УстановитьФамилиюИмяАнгл(Запись.ГлавныйБухгалтерОрганизации, стр);
		КонецЕсли;
		_ГлавныйБухгалтерОрганизацииАнглПриИзменении();
	КонецЕсли;

	з = Новый Запрос(
		"ВЫБРАТЬ
		|	CW_УчетнаяПолитикаСрезПоследних.ДолжностьРуководителяОрганизацииАнгл,
		|	CW_УчетнаяПолитикаСрезПоследних.АдресОрганизацииАнгл
		|ИЗ
		|	РегистрСведений.CW_УчетнаяПолитика.СрезПоследних КАК CW_УчетнаяПолитикаСрезПоследних
		|ГДЕ
		|	CW_УчетнаяПолитикаСрезПоследних.Организация = &Организация"
	);
	з.УстановитьПараметр("Организация", Договор.Организация);
	рз = з.Выполнить();
	выб = рз.Выбрать();
	Если выб.Следующий() Тогда 
		Если ЗначениеЗаполнено(выб.АдресОрганизацииАнгл) Тогда 
			Запись.АдресОрганизацииАнгл = выб.АдресОрганизацииАнгл;
		КонецЕсли;
		Если ЗначениеЗаполнено(выб.ДолжностьРуководителяОрганизацииАнгл) Тогда 
			Запись.ДолжностьРуководителяОрганизацииАнгл = выб.ДолжностьРуководителяОрганизацииАнгл;
		КонецЕсли;
	КонецЕсли;
	
	// --- 
КонецПроцедуры

