&НаСервере
Функция ПолучитьСтруктуруНеобходимыхРеквизитов()
	
	Реквизиты = Новый Структура;
	Реквизиты.Вставить("Адрес"						, "");
	Реквизиты.Вставить("АдресАнгл"					, "");
	Реквизиты.Вставить("Телефон"					, "");
	Реквизиты.Вставить("РасчетныйСчет"				, Неопределено);
	Реквизиты.Вставить("ДолжностьРуководителя"		, "");
	Реквизиты.Вставить("Руководитель"				, "");
	Реквизиты.Вставить("ДолжностьРуководителяАнгл"	, "");
	Реквизиты.Вставить("РуководительАнгл"			, "");
	Реквизиты.Вставить("ГлавныйБухгалтер"			, "");
	Реквизиты.Вставить("ГлавныйБухгалтерАнгл"		, "");
	
	Возврат Реквизиты;
	
КонецФункции

&НаСервере
Функция _ЗаполнитьРеквизитыКонтрагента()
	
	Реквизиты = ПолучитьСтруктуруНеобходимыхРеквизитов();
	
	ВладелецДоговора	= ТекущийКонтрагент;
	ПериодЗаписи 		= Запись.Период;
	
	СведенияКонтрагент = CW_БухгалтерияЭкспедитораСерверПереопределяемый.СведенияОЮрФизЛице(ВладелецДоговора, ПериодЗаписи); // ВызовБП
	
	//Адрес
	СведенияКонтрагент.Свойство("ЮридическийАдрес", Реквизиты.Адрес);
	Если Не ЗначениеЗаполнено(Реквизиты.Адрес) Тогда
		СведенияКонтрагент.Свойство("ФактическийАдрес", Реквизиты.Адрес);
	КонецЕсли;
	Реквизиты.АдресАнгл = _сф.стр_Транслит(Реквизиты.Адрес);
	
	СведенияКонтрагент.Свойство("Телефоны"	, Реквизиты.Телефон);
	
	
	Реквизиты.РасчетныйСчет = БухгалтерскийУчетПереопределяемый.ПолучитьБанковскийСчетПоУмолчанию(ВладелецДоговора);
	
	//Данные контактных лиц
	РольРуководителя 		= Константы.CW_РольРуководителя.Получить();
	РольГлавногоБухгалтера 	= Константы.CW_РольГлавногоБухгалтера.Получить();
	
	мРоли = Новый Массив;
	Если ЗначениеЗаполнено(РольРуководителя) Тогда
		мРоли.Добавить(РольРуководителя);	
	КонецЕсли;
	Если ЗначениеЗаполнено(РольГлавногоБухгалтера) Тогда
		мРоли.Добавить(РольГлавногоБухгалтера);	
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	КонтактныеЛица.Ссылка КАК Ссылка,
	               |	КонтактныеЛица.Фамилия КАК Фамилия,
	               |	КонтактныеЛица.Имя КАК Имя,
	               |	КонтактныеЛица.Отчество КАК Отчество,
	               |	КонтактныеЛица.Роль КАК Роль,
	               |	КонтактныеЛица.Должность КАК Должность
	               |ИЗ
	               |	Справочник.КонтактныеЛица КАК КонтактныеЛица
	               |ГДЕ
	               |	КонтактныеЛица.ОбъектВладелец = &Контрагент
	               |	И КонтактныеЛица.Роль В(&мРоли)";	
	
	Запрос.УстановитьПараметр("Контрагент"	, ВладелецДоговора);
	Запрос.УстановитьПараметр("мРоли"		, мРоли);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Если Выборка.Роль = РольРуководителя Тогда
			Реквизиты.Руководитель 			= Выборка.Фамилия+" "+Выборка.Имя+" "+Выборка.Отчество;
			Реквизиты.ДолжностьРуководителя = Выборка.Должность;
			
			Реквизиты.РуководительАнгл			=  _сф.стр_Транслит(Реквизиты.Руководитель);
			Реквизиты.ДолжностьРуководителяАнгл	=  _сф.стр_Транслит(Реквизиты.ДолжностьРуководителя);
		КонецЕсли;
		
		Если Выборка.Роль = РольГлавногоБухгалтера Тогда
			Реквизиты.ГлавныйБухгалтер		= Выборка.Фамилия+" "+Выборка.Имя+" "+Выборка.Отчество;
			Реквизиты.ГлавныйБухгалтерАнгл	=  _сф.стр_Транслит(Реквизиты.ГлавныйБухгалтер);
		КонецЕсли;	
		
	КонецЦикла;
	
	ЗаполнитьЗначенияСвойств(Запись, Реквизиты);
	
КонецФункции
 

