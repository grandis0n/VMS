
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Параметры.Отбор.Свойство("ТранспортноеСредство", ТранспортноеСредство);
	
	Если  ЗначениеЗаполнено(ТранспортноеСредство) Тогда
		Заголовок = "История изменения гос.номера транспортного средства: "+ СокрЛП(ТранспортноеСредство);
		Элементы.ТранспортноеСредство.Видимость = Ложь;
	Иначе
		Заголовок = "Гос.номера транспортных средства";
	КонецЕсли
	
КонецПроцедуры
