
&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)
	
	// --- 
	Если ПараметрКоманды.Пустая() Тогда
		_УФК.ВывестиПредупреждение("Значение не заполнено. Выберите значение и повторите.");
		Возврат;
	КонецЕсли; 
	ИмяРеквизита = ПараметрыВыполненияКоманды.Источник.ТекущийЭлемент.Имя;
	
	ПродолжитьОбработку = истина;
	
	Попытка
		ВидСубъекта = _ВидСубъекта(ИмяРеквизита);
	Исключение
		//Пробуем по типу значения
		Если ТипЗнч(ПараметрКоманды) = Тип("СправочникСсылка.Контрагенты") Тогда
			ИмяРеквизита = "Клиент";
		ИначеЕсли ТипЗнч(ПараметрКоманды) = Тип("СправочникСсылка.CW_ТипыПеревозок") Тогда
			ИмяРеквизита = "ТипПеревозки";
		ИначеЕсли ТипЗнч(ПараметрКоманды) = Тип("СправочникСсылка.CW_МаршрутыГрузоперевозок") Тогда
			ИмяРеквизита = "Маршрут";
		ИначеЕсли ТипЗнч(ПараметрКоманды) = Тип("СправочникСсылка.CW_Грузы") Тогда
			ИмяРеквизита = "Груз";
		ИначеЕсли ТипЗнч(ПараметрКоманды) = Тип("СправочникСсылка.CW_ТипоразмерыКонтейнеров") Тогда
			ИмяРеквизита = "Типоразмер";
		ИначеЕсли ТипЗнч(ПараметрКоманды) = Тип("СправочникСсылка.ФизическиеЛица") Тогда
			ПродолжитьОбработку = ложь;
			
			Список = Новый СписокЗначений;
			Список.Добавить("МенеджерПродаж", "Менеджер продаж");
			Список.Добавить("ОперативныйМенеджер", "Оперативный менеджер");
			
			ПараметрыОповещения = новый Структура;
			ПараметрыОповещения.Вставить("ПараметрКоманды"				, ПараметрКоманды);
			ПараметрыОповещения.Вставить("ПараметрыВыполненияКоманды"	, ПараметрыВыполненияКоманды);
			
			Оповещение = Новый ОписаниеОповещения("ПослеВыбораЭлемента", ЭтотОбъект, ПараметрыОповещения);
			Список.ПоказатьВыборЭлемента(Оповещение, "Выберите тип параметра."); 
			
		КонецЕсли;
		
		Если ПродолжитьОбработку Тогда
			ВидСубъекта = _ВидСубъекта(ИмяРеквизита);
		КонецЕсли;
		
	КонецПопытки;
	
	Если ПродолжитьОбработку тогда
		ИмяОбъекта = CW_Обмены_ПИ.ПолучитьИмяОбъектаМатаданныхПоИмениФормы(ПараметрыВыполненияКоманды.Источник.ИмяФормы);
		ПараметрыФормы = Новый Структура("Отбор", Новый Структура("ВидСубъекта,Субъект",ВидСубъекта, ПараметрКоманды));
		ОткрытьФорму("РегистрСведений.CW_ПредопределенныеЗначенияПараметров.ФормаСписка", ПараметрыФормы, ПараметрыВыполненияКоманды.Источник, ПараметрыВыполненияКоманды.Уникальность, ПараметрыВыполненияКоманды.Окно);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораЭлемента(ВыбранныйЭлемент, ПараметрыОповещения) Экспорт
	
	Если Не ВыбранныйЭлемент = Неопределено Тогда
		ВидСубъекта = _ВидСубъекта(ВыбранныйЭлемент.Значение);
		
		ИмяОбъекта = CW_Обмены_ПИ.ПолучитьИмяОбъектаМатаданныхПоИмениФормы(ПараметрыОповещения.ПараметрыВыполненияКоманды.Источник.ИмяФормы);
		ПараметрыФормы = Новый Структура("Отбор", Новый Структура("ВидСубъекта,Субъект",ВидСубъекта, ПараметрыОповещения.ПараметрКоманды));
		ОткрытьФорму("РегистрСведений.CW_ПредопределенныеЗначенияПараметров.ФормаСписка", ПараметрыФормы, ПараметрыОповещения.ПараметрыВыполненияКоманды.Источник, ПараметрыОповещения.ПараметрыВыполненияКоманды.Уникальность, ПараметрыОповещения.ПараметрыВыполненияКоманды.Окно);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция _ВидСубъекта(ИмяРеквизита)
	
	Возврат CW_Мониторинг.ВидСубъекта(ИмяРеквизита);
	
КонецФункции

  