&НаКлиенте
Процедура Логтип_Выбрать(Команда)
	
	Режим = РежимДиалогаВыбораФайла.Открытие;
	ДиалогОткрытияФайла = Новый ДиалогВыбораФайла(Режим);
	ДиалогОткрытияФайла.ПолноеИмяФайла = "";
	//Текст = "ru = ""Текст""; en = ""Text""";
	Фильтр = 	"Все картинки (*.bmp;*.dib;*.rle;*.jpg;*.jpeg;*.tif;*.gif;*.png;*.ico;*.wmf;*.emf)|*.bmp;*.dib;*.rle;*.jpg;*.jpeg;*.tif;*.gif;*.png;*.ico;*.wmf;*.emf|" 
	+ "Формат bmp (*.bmp;*.dib;*.rle)|*.bmp;*.dib;*.rle|"
	+ "Формат JPEG (*.jpg;*.jpeg)|*.jpg;*.jpeg|"
	+ "Формат TIFF (*.tif)|*.tif|"
	+ "Формат GIF (*.gif)|*.gif|"
	+ "Формат PNG (*.png)|*.png|"
	+ "Формат icon (*.ico)|*.ico|"
	+ "Формат метафайл (*.wmf;*.emf)|*.wmf;*.emf|"; // картинки
	ДиалогОткрытияФайла.Фильтр = Фильтр;
	ДиалогОткрытияФайла.МножественныйВыбор = Ложь;
	ДиалогОткрытияФайла.Заголовок = "Выберите файл";
	Если ДиалогОткрытияФайла.Выбрать() Тогда
		МассивФайлов = ДиалогОткрытияФайла.ВыбранныеФайлы;
		Файл 		 = МассивФайлов[0];
		
		АдресФайла = "";
		ОписаниеОповещения = Новый ОписаниеОповещения("ОбработкаЗагрузкиФайлаЛоготипа",ЭтотОбъект, Новый Структура()); 
		НачатьПомещениеФайла(ОписаниеОповещения, АдресФайла, Файл, Ложь, УникальныйИдентификатор);
	Иначе
		ПоказатьПредупреждение(,НСтр("ru = ""Файл(ы) не выбран!""; en = ""File(s) not selected!"""));
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаЗагрузкиФайлаЛоготипа(Результат, АдресВременногоХранилищаФайла, ВыбранноеИмя, ДополнительныеПараметры) Экспорт 
	
	Если Результат Тогда
		Успешно = ОбработатьЗагрузкуФайлаЛоготипаНаСервере(АдресВременногоХранилищаФайла);
		Если не Успешно Тогда
			ПоказатьПредупреждение(,"Не удалось загрузить файл!");
		КонецЕсли; 
	КонецЕсли; 
	
КонецПроцедуры

&НаСервере
Функция ОбработатьЗагрузкуФайлаЛоготипаНаСервере(Адрес)
	
	Попытка
		ДвоичныеДаныне 	= ПолучитьИзВременногоХранилища(Адрес);
		АдресЛоготипа 	= ПоместитьВоВременноеХранилище(ДвоичныеДаныне, Новый УникальныйИдентификатор);
		Возврат Истина;
	Исключение
	    Возврат Ложь;
	КонецПопытки; 
	
КонецФункции
