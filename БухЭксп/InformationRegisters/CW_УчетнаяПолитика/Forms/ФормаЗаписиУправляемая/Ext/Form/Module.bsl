&НаКлиенте
Перем ОбновитьИнтерфейс;

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ВалютаРегламентированногоУчетаРубль = ПолучитьФункциональнуюОпцию("CW_ВалютаРегламентированногоУчетаРубль");
	ВалютаРегламентированногоУчета 		= Константы.ВалютаРегламентированногоУчета.Получить();
		
	ИнициализацияФормы();
	
	ЗначениеПереключателя_ЗановоФормироватьПредставлениеПриПеревыставленииЗатрат = ?(Запись.ЗановоФормироватьПредставлениеПриПеревыставленииЗатрат, 1, 0);
	ЗначениеПереключателя_УчитыватьКурсыВалютАвансовДляБазыНДС = ?(Запись.УчитыватьКурсыВалютАвансовДляБазыНДС, 1, 0);
	
	Если (ЗначениеЗаполнено(Параметры.ЗначениеКопирования)) Тогда
		ЗаписьРегистра = РегистрыСведений.CW_УчетнаяПолитика.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(ЗаписьРегистра, Параметры.ЗначениеКопирования);
		ЗаписьРегистра.Прочитать();  
		
		ДвоичныеДанныеЛоготип 	= ЗаписьРегистра.Логотип.Получить();  
	Иначе
		ДвоичныеДанныеЛоготип 	= РеквизитФормыВЗначение("Запись").Логотип.Получить();  
	КонецЕсли;  
	
	Если ДвоичныеДанныеЛоготип <> Неопределено Тогда
		АдресЛоготипа = ПоместитьВоВременноеХранилище(ДвоичныеДанныеЛоготип, Новый УникальныйИдентификатор);
	Иначе
		АдресЛоготипа = "";
	КонецЕсли; 
		
	// отрабатываем действия, связанные с изменением даты (вступили в действие с 01.07.16 в соответствии с Приказом ФНС России от 14.03.2016 № ММВ-7-3/136@) 
	_ПериодПриИзменении();   
	
	ТолькоАктуальные = Истина;
	ТолькоАктуальныеНаСервере(); 
	УстановитьОтборДинамическогоСпискаДополнительныхПечатей();  
	
	УстановитьСистемуНалогообложения();

	ПорядокНумерацииПутевыхЛистовПриИзмененииНаСервере(); 
	
	СвояОрганизацияВКачествеПокупателяПриИзмененииНаСервере();
	
	_УФС.ОтключитьИсториюВыбораЭлементовФормы(ЭтаФорма); 
	
КонецПроцедуры 

&НаСервере
Процедура УстановитьСистемуНалогообложения()  
	
	МассивУпрощенная		= CW_БухгалтерияЭкспедитораСервер.ПолучитьУпрощенныеСистемыНалогообложения();
	СистемаНалогообложения	= CW_БухгалтерияЭкспедитораСервер.ПолучитьСистемуНалогообложения(Запись.Организация, Запись.Период);
	
	Элементы.НЗПОтражатьВНУ.Видимость = МассивУпрощенная.Найти(СистемаНалогообложения) <> Неопределено;	
	
КонецПроцедуры


 &НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	УстановитьВидимостьПредупрежденийПланированияПлатежей();
КонецПроцедуры

&НаКлиенте
Процедура ТолькоАктуальные(Команда)
	
	ТолькоАктуальные = Не ТолькоАктуальные;
	ТолькоАктуальныеНаСервере(); 
	УстановитьОтборДинамическогоСпискаДополнительныхПечатей();
	
КонецПроцедуры 

&НаСервере
Процедура ТолькоАктуальныеНаСервере()
	Элементы.ПечатиОрганизацииТолькоАктуальные.Пометка = ТолькоАктуальные;
КонецПроцедуры

&НаСервере
Процедура УстановитьОтборДинамическогоСпискаДополнительныхПечатей()
	
	ПечатиОрганизации.Отбор.Элементы.Очистить(); 
	
	ПравоеЗначение = ?(ЗначениеЗаполнено(Запись.Организация), Запись.Организация, Неопределено);
	
	ЭлементОтбора = ПечатиОрганизации.Отбор.Элементы.Добавить(тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение = новый ПолеКомпоновкиДанных("Организация");
	ЭлементОтбора.ВидСравнения 		= ВидСравненияКомпоновкиДанных.Равно;
	ЭлементОтбора.ПравоеЗначение 	= ПравоеЗначение;
	ЭлементОтбора.Использование 	= истина;
	
	Если ТолькоАктуальные Тогда
		ЭлементОтбора = ПечатиОрганизации.Отбор.Элементы.Добавить(тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение = новый ПолеКомпоновкиДанных("Актуальная");
		ЭлементОтбора.ВидСравнения 		= ВидСравненияКомпоновкиДанных.Равно;
		ЭлементОтбора.ПравоеЗначение 	= Истина;
		ЭлементОтбора.Использование 	= истина;
	КонецЕсли;
	
КонецПроцедуры


&НаСервере
Процедура ИнициализацияФормы()
	
	//Список выбора
	мСписокВыбора = Новый  Массив;
	мСписокВыбора.Добавить(Перечисления.CW_ПорядокПрисвоенияИсходящихНомеров.СплошнаяНумерация);
	мСписокВыбора.Добавить(Перечисления.CW_ПорядокПрисвоенияИсходящихНомеров.ВПределахДаты);
	
	Если ВалютаРегламентированногоУчетаРубль Тогда
		мСписокВыбора.Добавить(Перечисления.CW_ПорядокПрисвоенияИсходящихНомеров.НезависимаяНумерация);
	КонецЕсли;
	
	мСписокВыбора.Добавить(Перечисления.CW_ПорядокПрисвоенияИсходящихНомеров.ВнешнийНумератор);
	
	Элементы.ПорядокПрисвоенияНомеров.СписокВыбора.ЗагрузитьЗначения(мСписокВыбора);
	
	//////Видимость элементов 
	////Функциональная опция не отрабатывает, так как поля формы не связаны с реквизитыами
	Элементы.СпособыУчетаНДС.Видимость 		= ВалютаРегламентированногоУчетаРубль;
	Элементы.Декорация1.Видимость 			= ВалютаРегламентированногоУчетаРубль;
	
	//Подсистема УчетНЗП
	ВариантУчетаНЗППриИзмененииНаСервере();
	УстановитьВидимостьЭлементовНЗП();
	//---Подсистема УчетНЗП

	УстановитьПараметрыФункциональныхОпций();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьПараметрыФункциональныхОпций()
	                                        
	УстанавливаемыеПараметры = новый Структура;
	УстанавливаемыеПараметры.Вставить("Организация", Запись.Организация);
	
	УстановитьПараметрыФункциональныхОпцийФормы(УстанавливаемыеПараметры);

КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	Запись.ЗановоФормироватьПредставлениеПриПеревыставленииЗатрат = (1=ЗначениеПереключателя_ЗановоФормироватьПредставлениеПриПеревыставленииЗатрат);
	Запись.УчитыватьКурсыВалютАвансовДляБазыНДС = (1=ЗначениеПереключателя_УчитыватьКурсыВалютАвансовДляБазыНДС);
	
	ПроверитьСчетаУчета(Отказ);
	
КонецПроцедуры

&НаСервере
Процедура ПроверитьСчетаУчета(Отказ)
	
	МассивКонтрольныхСчетов = новый Массив;
	
	Если CW_ВерсииПодсистемСервер.СуществуетПодсистема("CW_БухгалтерияЭкспедитораДляРоссии") Тогда  
		Модуль_CW_БухгалтерияЭкспедитораДляРоссииСервер = CW_ОбщегоНазначения.ОбщийМодуль("CW_БухгалтерияЭкспедитораДляРоссииСервер");
		МассивКонтрольныхСчетов = Модуль_CW_БухгалтерияЭкспедитораДляРоссииСервер.МассивКонтрольныхСчетов();    
	КонецЕсли; 
	
	Если CW_ВерсииПодсистемСервер.СуществуетПодсистема("CW_БухгалтерияЭкспедитораДляБелоруси") Тогда  
		Модуль_CW_БухгалтерияЭкспедитораДляБелорусиСервер = CW_ОбщегоНазначения.ОбщийМодуль("CW_БухгалтерияЭкспедитораДляБелорусиСервер");
		МассивКонтрольныхСчетов = Модуль_CW_БухгалтерияЭкспедитораДляБелорусиСервер.МассивКонтрольныхСчетов();    
	КонецЕсли; 
	
	МассивИменПроверяемыхПолей = новый Массив;
	МассивИменПроверяемыхПолей.Добавить("СчетРасчетов_Поставщики_Рубли");
	МассивИменПроверяемыхПолей.Добавить("СчетРасчетов_Поставщики_Валюта");
	МассивИменПроверяемыхПолей.Добавить("СчетРасчетов_Поставщики_УЕ");
	МассивИменПроверяемыхПолей.Добавить("СчетРасчетов_Клиенты_Рубли");
	МассивИменПроверяемыхПолей.Добавить("СчетРасчетов_Клиенты_Валюта");
	МассивИменПроверяемыхПолей.Добавить("СчетРасчетов_Клиенты_УЕ");
	
	Для Каждого ИмяПоля Из МассивИменПроверяемыхПолей Цикл
		Если МассивКонтрольныхСчетов.Найти(Запись[ИмяПоля])<> Неопределено Тогда
			_УФКС.СообщитьПользователю("Выбран недопустимый счет учета! ("+СокрЛП(Запись[ИмяПоля])+")",,"Запись."+ИмяПоля,,Отказ);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	Если ЭтоАдресВременногоХранилища(АдресЛоготипа) Тогда
		ТекущийОбъект.Логотип = Новый ХранилищеЗначения(ПолучитьИзВременногоХранилища(АдресЛоготипа));	
	Иначе
		ТекущийОбъект.Логотип = Новый ХранилищеЗначения(Неопределено);
	КонецЕсли;	
	
	// безальтернотивное включение опций Постановления №1137 и 735
	Если Запись.Период >= Дата(2015,1,1) Тогда
		ТекущийОбъект.СчетаФактурыПоПостановлению1137 = Истина;
		ТекущийОбъект.ТребованияПостановления735 = Истина;
	КонецЕсли;  
	
	// новые коды видов операций для перевыставления
	Если Запись.Период >= Дата(2016,7,1) Тогда
		ТекущийОбъект.КодВидаОперацииДляВходящихСчетовФактур = "01";
		ТекущийОбъект.КодВидаОперацииДляИсходящихСчетовФактур = "01";
	КонецЕсли;
	
	// с начала действия Постановления Правительста РФ №981
	// в графу "Стоимость (всего)" должны выводиться исключительно
	// перевыставляемые услуги
	Если Запись.Период >= Дата(2017,10,1) Тогда
		ТекущийОбъект.ОбщаяСуммаСчетФактурыВСтрокахСводных = Ложь;
	КонецЕсли; 
	
	ТекущийОбъект.ВедетсяУчетНЗПДирективно = Запись.ВедетсяУчетНЗП и Запись.ВариантУчетаНЗП = ПредопределенноеЗначение("Перечисление.CW_ВариантУчетаНЗП.Директивно");
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПодсказкуНумератора()
	
	мОписаниеНумератора = "Нумерация исходящих документов (счета, акта и счета-фактуры) по экспедиторской деятельности осуществляется " + Символы.ПС;
	Если Запись.ПорядокПрисвоенияНомеров = ПредопределенноеЗначение("Перечисление.CW_ПорядокПрисвоенияИсходящихНомеров.СплошнаяНумерация") Тогда
		мОписаниеНумератора =  мОписаниеНумератора + 
		                       "единым пакетом независимо от документов по остальным видам деятельности организации. 
							   |Номер документа формируется из префикса организации (если он задан) и порядкового номера 
							   |документа в пределах года. 
							   |Пример: Ф0000000003";

	ИначеЕсли Запись.ПорядокПрисвоенияНомеров = ПредопределенноеЗначение("Перечисление.CW_ПорядокПрисвоенияИсходящихНомеров.ВПределахДаты") Тогда
		мОписаниеНумератора = мОписаниеНумератора +
		                      "единым пакетом независимо от документов по остальным видам деятельности организации. 
							  |Номер документа формируется из префикса организации (если он задан), двух цифр месяца, 
							  |двух цифр даты и порядкового номера документа в пределах даты. 
					          |Пример: Ф0314-00003";

	ИначеЕсли Запись.ПорядокПрисвоенияНомеров = ПредопределенноеЗначение("Перечисление.CW_ПорядокПрисвоенияИсходящихНомеров.НезависимаяНумерация") Тогда
		мОписаниеНумератора = мОписаниеНумератора + 
		                      "в единой последовательности с документами, оформляемыми организацией по прочим видам деятельности. 
							  |Номер документа формируется из префикса организации (если он задан) и порядкового номера 
							  |соответствующего документа (""Счет на оплату покупателю"", ""Реализация товаров и услуг"" и ""Счет-фактура выданный"") 
							  |в пределах года. 
					          |Пример: Счет - Ф0000000003, Акт - Ф0000000021, Счет-фактура - Ф0000000017";

	ИначеЕсли Запись.ПорядокПрисвоенияНомеров = ПредопределенноеЗначение("Перечисление.CW_ПорядокПрисвоенияИсходящихНомеров.ВнешнийНумератор") Тогда
		мОписаниеНумератора = мОписаниеНумератора + 
		                      "в соответствии с алгоритмом внешнего нумератора, реализованным в виде подключаемой обработки:";
	КонецЕсли; 
	Элементы.ПорядокПрисвоенияНомеров.Подсказка = мОписаниеНумератора;

КонецПроцедуры

&НаКлиенте
Процедура УправлениеЭлементамиФормы()
	
	// начиная с 2015 года применение постановления №1137 является обязательным,
	// поэтому вывод опций скрываем (их принудительная установка 
	// осуществляется при изменении периода)
	Ранее2015 = ?(Запись.Период >= Дата(2015,1,1),Ложь,Истина);
	Элементы.СчетаФактурыПоПостановлению1137.Видимость 			= Ранее2015;
	Элементы.СчетаФактурыПоПостановлению735.Видимость 			= Ранее2015;
	Элементы.ОтражатьСчетаФактурыНаПеревыставление.Видимость 	= Ранее2015;
	Элементы.ВыводитьСтрокуКомиссионераВСчетахФактурах.Видимость= Ранее2015;
	
	// начиная с 01.10.2017 года применение требований постановления 
	// Правительста РФ №981 является обязательным, поэтому вывод опций скрываем 
	// (их принудительная установка  осуществляется при изменении периода)
	Ранее2017_10_01= ?(Запись.Период >= Дата(2017,10,1),Ложь,Истина); 
	Элементы.ОбщаяСуммаСчетФактурыВСтрокахСводных.Видимость = Ранее2017_10_01;
	
	Элементы.ВыводитьСтрокуКомиссионераВСчетахФактурах.Доступность 	= Запись.СчетаФактурыПоПостановлению1137;

	// выводим дополнительную информацию к выбранному значению нумератора
	УстановитьПодсказкуНумератора();
	Элементы.ВнешнийНумератор.Видимость = (Запись.ПорядокПрисвоенияНомеров = ПредопределенноеЗначение("Перечисление.CW_ПорядокПрисвоенияИсходящихНомеров.ВнешнийНумератор"));
	
КонецПроцедуры

&НаСервере
Процедура _СформироватьСчета()
	// --- 
	
	ВидыСубконто = CW_Конфигурация.ВидыСубконто();
	СубконтоКонтрагент = ВидыСубконто.Контрагенты;
	СубконтоДоговор = ВидыСубконто.Договоры;
	СубконтоДокументВзаиморасчетов = ВидыСубконто.ДокументыРасчетовСКонтрагентами;
	// ---------------------------------------------------------------------------- 
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Хозрасчетный.Ссылка,
	               |	Хозрасчетный.Код КАК Код
	               |ИЗ
	               |	ПланСчетов.Хозрасчетный КАК Хозрасчетный
	               |ГДЕ
	               |	Хозрасчетный.ВидыСубконто.ВидСубконто.Ссылка = &СубконтоКонтрагент
	               |	И Хозрасчетный.ВидыСубконто.ВидСубконто.Ссылка = &СубконтоДоговор
	               |	И Хозрасчетный.ВидыСубконто.ВидСубконто.Ссылка = &СубконтоДокументВзаиморасчетов
	               |	И Хозрасчетный.Валютный = &Валютный
	               |	И Хозрасчетный.Забалансовый = &Забалансовый
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Код";
	
	Запрос.УстановитьПараметр("СубконтоКонтрагент", СубконтоКонтрагент);
	Запрос.УстановитьПараметр("СубконтоДоговор", СубконтоДоговор);
	Запрос.УстановитьПараметр("СубконтоДокументВзаиморасчетов", СубконтоДокументВзаиморасчетов);
	// ----------------------------------------------------------------------------  
	Запрос.УстановитьПараметр("Валютный", Ложь); 
	Запрос.УстановитьПараметр("Забалансовый", Ложь); 
	// --- 
	ТЗ = Запрос.Выполнить().Выгрузить();
	
	СписокЗнач = Новый СписокЗначений;
	Для Каждого Стр ИЗ ТЗ Цикл
		Если НЕ (Стр.Код = "76.05" ИЛИ Стр.Код = "76.06") Тогда
			Элементы.СчетРасчетов_Поставщики_Рубли.СписокВыбора.Добавить(Стр.Ссылка,Стр.Код);	
		КонецЕсли; 
	КонецЦикла;	
	// ---------------------------------------------------------------------------- 
	Запрос.УстановитьПараметр("Валютный", Истина); 
	Запрос.УстановитьПараметр("Забалансовый", Ложь); 
	// --- 
