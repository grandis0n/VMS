
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Элементы.АдресПодписи.РазмерКартинки=РазмерКартинки.АвтоРазмер;
	// --- 
	к = РеквизитФормыВЗначение("Запись").Подпись.Получить();
	Если (к <> Неопределено) Тогда
		АдресПодписи = ПоместитьВоВременноеХранилище(к,ЭтаФорма.УникальныйИдентификатор);
	Иначе
		АдресПодписи = "";
	КонецЕсли;   
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	Если (АдресПодписи = "") Тогда
		ТекущийОбъект.Подпись = Новый ХранилищеЗначения(Неопределено);
	Иначе
		ТекущийОбъект.Подпись = Новый ХранилищеЗначения(ПолучитьИзВременногоХранилища(АдресПодписи));	
	КонецЕсли; 
	
КонецПроцедуры

