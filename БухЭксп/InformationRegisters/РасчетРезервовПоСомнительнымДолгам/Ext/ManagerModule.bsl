
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

#Область ДляВызоваИзДругихПодсистем

// См. СтандартныеПодсистемыСервер.ПриОпределенииМетодовРазрешенныхДляВызоваКакПроизвольныйКод
Процедура ПриОпределенииМетодовРазрешенныхДляВызоваКакПроизвольныйКод(Методы) Экспорт
	
	Методы.Вставить("ЗаполнитьРесурсСомнительнаяЗадолженность");
	
КонецПроцедуры

// СтандартныеПодсистемы.УправлениеДоступом

// См. УправлениеДоступомПереопределяемый.ПриЗаполненииСписковСОграничениемДоступа.
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт

	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(Организация)";

КонецПроцедуры

// Конец СтандартныеПодсистемы.УправлениеДоступом

#КонецОбласти

#Область ОбработчикиОбновления

// Отложенный обработчик обновления заполняет ресурс "СомнительнаяЗадолженность"
// в регистре "Расчет резервов по сомнительным долгам".
Процедура ЗаполнитьРесурсСомнительнаяЗадолженность(Параметры) Экспорт
	
	СхемаЗапроса = Новый СхемаЗапроса;
	СхемаЗапроса.УстановитьТекстЗапроса(
	"ВЫБРАТЬ ПЕРВЫЕ 1000
	|	Регистр.Регистратор КАК Ссылка,
	|	Регистр.ПериодРасчета КАК Период
	|ПОМЕСТИТЬ ПервыеСтроки
	|ИЗ
	|	РегистрСведений.РасчетРезервовПоСомнительнымДолгам КАК Регистр
	|ГДЕ
	|	Регистр.СомнительнаяЗадолженность = 0 
	|УПОРЯДОЧИТЬ ПО
	|	Период УБЫВ,
	|	Ссылка УБЫВ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ПервыеСтроки.Ссылка КАК Ссылка,
	|	ПервыеСтроки.Период КАК Период
	|ИЗ
	|	ПервыеСтроки КАК ПервыеСтроки
	|УПОРЯДОЧИТЬ ПО
	|	Период УБЫВ,
	|	Ссылка УБЫВ");
	
	МоментВремени = Неопределено;
	Если Параметры.Свойство("МоментВремени", МоментВремени) И ЗначениеЗаполнено(МоментВремени) Тогда
		СтрокаОтбора = "(Регистр.ПериодРасчета < &ДатаМомента ИЛИ (Регистр.ПериодРасчета = &ДатаМомента И Регистр.Регистратор < &СсылкаМомента))";
		СхемаЗапроса.ПакетЗапросов[0].Операторы[0].Отбор.Добавить(СтрокаОтбора);
	КонецЕсли;
	
	Запрос = Новый Запрос(СхемаЗапроса.ПолучитьТекстЗапроса());
	
	Если ЗначениеЗаполнено(МоментВремени) Тогда
		Запрос.УстановитьПараметр("ДатаМомента",   МоментВремени.Дата);
		Запрос.УстановитьПараметр("СсылкаМомента", МоментВремени.Ссылка);
	КонецЕсли;
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Параметры.ОбработкаЗавершена = Истина;
		Возврат;
	КонецЕсли;
	
	ОбъектовОбработано = 0;
	ПроблемныхОбъектов = 0;
	Параметры.ОбработкаЗавершена = Ложь;
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		ОбъектовОбработано = ОбъектовОбработано + 1;
		Попытка
			НаборЗаписей = РегистрыСведений.РасчетРезервовПоСомнительнымДолгам.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.Регистратор.Установить(Выборка.Ссылка);
			НаборЗаписей.Прочитать();
			Для Каждого Запись Из НаборЗаписей Цикл
				Если Запись.СомнительнаяЗадолженность = 0
					И Не ЗначениеЗаполнено(Запись.ВидОбеспечения)
					И Запись.СуммаОбеспечения = 0 Тогда
					Запись.СомнительнаяЗадолженность = Макс(Запись.СуммаЗадолженности - Запись.ВстречнаяЗадолженность, 0);
				КонецЕсли;
			КонецЦикла;
			НаборЗаписей.ОбменДанными.Загрузка = Истина;
			НаборЗаписей.Записать();
			
			ТекущийМомент = Новый МоментВремени(Выборка.Период, Выборка.Ссылка);
			Параметры.Вставить("МоментВремени", ТекущийМомент);
		Исключение
			ПроблемныхОбъектов = ПроблемныхОбъектов + 1;
			ЗаписьЖурналаРегистрации(ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
				УровеньЖурналаРегистрации.Предупреждение, , Выборка.Ссылка,
				ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЦикла;
	
	Если ПроблемныхОбъектов > 0 Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Ошибок: %1 из %2'"), ПроблемныхОбъектов, ОбъектовОбработано);
	КонецЕсли;
	
КонецПроцедуры
#КонецОбласти

#КонецОбласти

#КонецЕсли
