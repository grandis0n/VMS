
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Параметры.Свойство("Обмен",Обмен);
	Список.Параметры.УстановитьЗначениеПараметра("Обмен",?(Обмен.Пустая(),Неопределено,Обмен));
	
КонецПроцедуры

&НаКлиенте
Процедура ОбменПриИзменении(Элемент)
	
	_ОтборОбменПриИзменении();
	Элементы.Список.Обновить();
	
КонецПроцедуры

&НаСервере
Процедура _ОтборОбменПриИзменении()
	// --- 
	
	Если Обмен.Пустая() Тогда
		
		Значение = Неопределено;
		
	Иначе
		
		Значение = Обмен;
		
	КонецЕсли; 
	Список.Параметры.УстановитьЗначениеПараметра("Обмен",Значение);
		
	// --- 
КонецПроцедуры