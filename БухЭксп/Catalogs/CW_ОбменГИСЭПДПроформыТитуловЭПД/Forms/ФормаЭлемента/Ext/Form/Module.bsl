			Макет 		= CW_ОбменГИСЭПДСерверВызовСервера.ПолучитьМакетЭлектронногоПеревозочногоДокумента(ИмяМакета);    
			
			ОбластьПреемник 	= ТабличныйДокумент.Область("ПриемникЯвляетсяЭкспедитором");	
			
			ОбластьЯвляетсяЭкспедитором	= Макет.Область("ЯвляетсяЭкспедитором");   
			ТабличныйДокумент.ВставитьОбласть(ОбластьЯвляетсяЭкспедитором, ОбластьПреемник, ТипСмещенияТабличногоДокумента.ПоВертикали);
		КонецЕсли;
		
		ОбластьСоставДоговораНаВыполнениеУслуг = ТабличныйДокумент.Области.Найти("СоставДоговораНаВыполнениеУслуг");
		ОбластьСоставДоговораНаВыполнениеУслуг.Сгруппировать();          
		
		ОбластьСоставОснованияРасчетов = ТабличныйДокумент.Области.Найти("СоставОснованияРасчетов");
		ОбластьСоставОснованияРасчетов.Сгруппировать();          
		
	Иначе
		
		ОбластьДоверенность	= ТабличныйДокумент.Области.Найти("ЯвляетсяЭкспедитором");   
		Если ОбластьДоверенность <> Неопределено Тогда
			ТабличныйДокумент.УдалитьОбласть(ОбластьДоверенность, ТипСмещенияТабличногоДокумента.ПоВертикали);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры   

&НаСервере
Процедура ОбработатьИзменнениеОбластиЛицоОсуществляющееПогрузкуЯвляетсяГрузоотправителем_ЭТрН_Титул1()

	ОбластьЛицоОсуществляющееПогрузку = ТабличныйДокумент.Области.Найти("ТитулГрузоотправителяЛицоОсуществляющееПогрузкуЯвляетсяГрузоотправителем");
	Если ОбластьЛицоОсуществляющееПогрузку.значение = "2" Тогда 
		ПараметрыДокументаЭПД = ПараметрыДокументовЭПД.Получить(Объект.ТипДокументаЭПД); 
		ИмяМакета 	= ПараметрыДокументаЭПД["Макеты"].Получить(Объект.ТекущийТитул); 
		Макет 		= CW_ОбменГИСЭПДСерверВызовСервера.ПолучитьМакетЭлектронногоПеревозочногоДокумента(ИмяМакета);    
		
		ОбластьПреемник	= ТабличныйДокумент.Область("ПриемникИноеЛицо");	
		
		ОбластьИноеЛицо	= Макет.Область("ИноеЛицо");   
		ТабличныйДокумент.ВставитьОбласть(ОбластьИноеЛицо, ОбластьПреемник, ТипСмещенияТабличногоДокумента.ПоВертикали);
		
		ОбластьСоставОснование = ТабличныйДокумент.Области.Найти("СоставОснование");
		ОбластьСоставОснование.Сгруппировать();          
		
		ОбластьСоставРаботникЛица = ТабличныйДокумент.Области.Найти("СоставРаботникЛица");
		ОбластьСоставРаботникЛица.Сгруппировать();  

	Иначе
		ОбластьИноеЛицо	= ТабличныйДокумент.Области.Найти("ИноеЛицо");   
		Если ОбластьИноеЛицо <> Неопределено Тогда
			ТабличныйДокумент.УдалитьОбласть(ОбластьИноеЛицо, ТипСмещенияТабличногоДокумента.ПоВертикали);
		КонецЕсли;
	КонецЕсли;
	
	
КонецПроцедуры

&НаСервере
Процедура ОбработатьИзменнениеОбластиВариантОснованияПолномочий_ЭТрН_Титул1()
	
	ОбластьВариантОснованияПолномочий = ТабличныйДокумент.Области.Найти("ВариантОснованияПолномочий"); 
	Если ОбластьВариантОснованияПолномочий <> Неопределено Тогда
		ПараметрыДокументаЭПД = ПараметрыДокументовЭПД.Получить(Объект.ТипДокументаЭПД); 
		ИмяМакета 	= ПараметрыДокументаЭПД["Макеты"].Получить(Объект.ТекущийТитул); 
		Макет 		= CW_ОбменГИСЭПДСерверВызовСервера.ПолучитьМакетЭлектронногоПеревозочногоДокумента(ИмяМакета);    
		
		
		//Удаляем области
		ОбластьОснованиеТекст	= ТабличныйДокумент.Области.Найти("ОснованиеТекст");   
		Если ОбластьОснованиеТекст <> Неопределено Тогда
			ТабличныйДокумент.УдалитьОбласть(ОбластьОснованиеТекст, ТипСмещенияТабличногоДокумента.ПоВертикали);
		КонецЕсли; 
		
		ОбластьОснованиеДокумент	= ТабличныйДокумент.Области.Найти("ОснованиеДокумент");   
		Если ОбластьОснованиеДокумент <> Неопределено Тогда
			ТабличныйДокумент.УдалитьОбласть(ОбластьОснованиеДокумент, ТипСмещенияТабличногоДокумента.ПоВертикали);
		КонецЕсли;
		//---Удаляем области
		
		ОбластьПреемник	= ТабличныйДокумент.Область("ПриемникОснование");	
	
		Если ОбластьВариантОснованияПолномочий.Значение = 0 Тогда 
			ОбластьОснованиеТекст = Макет.Область("ОснованиеТекст");   
			ТабличныйДокумент.ВставитьОбласть(ОбластьОснованиеТекст, ОбластьПреемник, ТипСмещенияТабличногоДокумента.ПоВертикали);
		Иначе   
			ОбластьОснованиеДокумент = Макет.Область("ОснованиеДокумент");   
			ТабличныйДокумент.ВставитьОбласть(ОбластьОснованиеДокумент, ОбластьПреемник, ТипСмещенияТабличногоДокумента.ПоВертикали);
		КонецЕсли;  
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ТекущийТитулПриИзменении_ОбработатьИзменнениеОбласти_ЭПЛ_Титул1()
	
	МассивИменОбластей = Новый Массив;
	МассивИменОбластей.Добавить("ТитулОформлениеПризнакНачалаРейса");
	МассивИменОбластей.Добавить("ТитулОформлениеСведенияОВидеПеревозки");
	МассивИменОбластей.Добавить("ТитулОформлениеВидКоммерческойПеревозки");
	МассивИменОбластей.Добавить("ВариантМедосмотр");
	МассивИменОбластей.Добавить("ВариантТехконтроль");
	МассивИменОбластей.Добавить("ВариантПоказанияОдометра");
	МассивИменОбластей.Добавить("ТитулОформлениеПризнакФормированияПутевогоЛистаНаОдинДень");
	
	Для Каждого ИмяОбласти из МассивИменОбластей Цикл
		ТекущаяОбласть = ТабличныйДокумент.Области.Найти(ИмяОбласти);
		Если ТекущаяОбласть <> Неопределено Тогда
			ОбработатьИзменнениеОбласти_ЭПЛ_Титул1(ТекущаяОбласть);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры


&НаКлиенте
Процедура ТекущийТитулПриИзменении_ОбработатьИзменнениеОбласти_ЭПЛ_Титул2()
	
	МассивИменОбластей = Новый Массив;
	МассивИменОбластей.Добавить("ВариантМедработник");
	
	Для Каждого ИмяОбласти из МассивИменОбластей Цикл
		ТекущаяОбласть = ТабличныйДокумент.Области.Найти(ИмяОбласти);
		Если ТекущаяОбласть <> Неопределено Тогда
			ОбработатьИзменнениеОбласти_ЭПЛ_Титул2(ТекущаяОбласть);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры


&НаКлиенте
Процедура ОбработатьИзменнениеОбласти_ЭПЛ_Титул1(ТекущаяОбласть)
	
	ТипСмещения	= "ПоВертикали"; 
	
	Если ТекущаяОбласть.Имя = "ТитулОформлениеПризнакФормированияПутевогоЛистаНаОдинДень" Тогда 
		
		ИмяВставляемаяОбласть	= "ДатаИспользования";
		ИмяУдаляемаяОбласть		= "НачалоОкончаниеИспользования";
		
		Если ТекущаяОбласть.Значение = "1" Тогда  
			ИмяВставляемаяОбласть	= "ДатаИспользования";
			ИмяУдаляемаяОбласть		= "НачалоОкончаниеИспользования";
			
			ВставитьОбластьТабличногоДокумента(ИмяВставляемаяОбласть, ТипСмещения);
			УдалитьОбластьТабличногоДокумента(ИмяУдаляемаяОбласть, ТипСмещения);
		ИначеЕсли ТекущаяОбласть.Значение = "2" Тогда 
			ИмяВставляемаяОбласть	= "НачалоОкончаниеИспользования";
			ИмяУдаляемаяОбласть		= "ДатаИспользования";
			
			ВставитьОбластьТабличногоДокумента(ИмяВставляемаяОбласть, ТипСмещения);
			УдалитьОбластьТабличногоДокумента(ИмяУдаляемаяОбласть, ТипСмещения);   
		Иначе
			УдалитьОбластьТабличногоДокумента("ДатаИспользования", 				ТипСмещения);
			УдалитьОбластьТабличногоДокумента("НачалоОкончаниеИспользования", 	ТипСмещения);
		КонецЕсли;  
		
		Возврат; 
		
	КонецЕсли;  
	
	Если ТекущаяОбласть.Имя = "ТитулОформлениеПризнакНачалаРейса" Тогда
		ИмяОбласти	= "ПредыдущийПутевойЛист";
		Значение 	= "2";
	КонецЕсли;
	
	Если ТекущаяОбласть.Имя = "ТитулОформлениеСведенияОВидеПеревозки" Тогда
		ИмяОбласти	= "ВидКоммерческойПеревозки";
		Значение 	= "КП";
	КонецЕсли;
	
	Если ТекущаяОбласть.Имя = "ТитулОформлениеВидКоммерческойПеревозки" Тогда
		ИмяОбласти			= "Адреса";
		Значение 			= "ПГ"; 
		ИмяОбластиГруппа	= "СоставАдреса";
	КонецЕсли;
	
	Если ТекущаяОбласть.Имя = "ВариантМедосмотр" Тогда
		ИмяОбласти	= "СторонняяМедорганизация"; 
		ТипСмещения	= "ПоГоризонтали";	
		Значение 	= "Сторонняя организация";
	КонецЕсли;
	
	Если ТекущаяОбласть.Имя = "ВариантТехконтроль" Тогда
		ИмяОбласти	= "СторонняяТехконтроль";  
		ТипСмещения	= "ПоГоризонтали";	
		Значение 	= "Сторонняя организация";
	КонецЕсли;   
	
	Если ТекущаяОбласть.Имя = "ВариантПоказанияОдометра" Тогда
		ИмяОбласти	= "СторонняяПоказанияОдометра";  
		ТипСмещения	= "ПоГоризонтали";	
		Значение 	= "Сторонняя организация";
	КонецЕсли;  
	
	Если ТекущаяОбласть.Значение = Значение Тогда 
		ВставитьОбластьТабличногоДокумента(ИмяОбласти, ТипСмещения);
	Иначе
		УдалитьОбластьТабличногоДокумента(ИмяОбласти, ТипСмещения);
	КонецЕсли; 
	
	Если ИмяОбластиГруппа <> Неопределено Тогда
		ОбластьСостав = ТабличныйДокумент.Области.Найти(ИмяОбластиГруппа); 
		Если ОбластьСостав <> Неопределено Тогда
			ОбластьСостав.Сгруппировать();          
		КонецЕсли;
	КонецЕсли;
	
	Если ТекущаяОбласть.Имя = "ТитулОформлениеСведенияОВидеПеревозки" Тогда 
		Область = ТабличныйДокумент.Области.Найти("ТитулОформлениеВидКоммерческойПеревозки"); 
		Если Область = Неопределено Тогда
			ИмяОбласти	= "Адреса";
			УдалитьОбластьТабличногоДокумента(ИмяОбласти, ТипСмещения);
		Иначе
			ОбработатьИзменнениеОбласти_ЭПЛ_Титул1(Область);	
		КонецЕсли;
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьИзменнениеОбласти_ЭПЛ_Титул2(ТекущаяОбласть)
	
	ТипСмещения	= "ПоВертикали"; 
	
	Если ТекущаяОбласть.Имя = "ВариантМедработник" Тогда 
		
		Если ТекущаяОбласть.Значение = 0 Тогда  
			ИмяВставляемаяОбласть	= "ШтатныйМедработник";
			ИмяУдаляемаяОбласть		= "СтороннийМедработник";  
			ИмяОбластиГруппа 		= "СоставШтатныйМедработник";
			
			ВставитьОбластьТабличногоДокумента(ИмяВставляемаяОбласть, ТипСмещения);
			УдалитьОбластьТабличногоДокумента(ИмяУдаляемаяОбласть, ТипСмещения); 
		КонецЕсли;  
		
		Если ТекущаяОбласть.Значение = 1 Тогда 
			ИмяВставляемаяОбласть	= "СтороннийМедработник";
			ИмяУдаляемаяОбласть		= "ШтатныйМедработник";       
			ИмяОбластиГруппа 		= "СоставСтороннийМедработник";
			
			ВставитьОбластьТабличногоДокумента(ИмяВставляемаяОбласть, ТипСмещения);
			УдалитьОбластьТабличногоДокумента(ИмяУдаляемаяОбласть, ТипСмещения);   
		КонецЕсли;  
		
		Если ИмяОбластиГруппа <> Неопределено Тогда
			ОбластьСостав = ТабличныйДокумент.Области.Найти(ИмяОбластиГруппа); 
			Если ОбластьСостав <> Неопределено Тогда
				ОбластьСостав.Сгруппировать();          
			КонецЕсли;
		КонецЕсли;
		
		ПоказатьУровеньГруппировокСтрокНаСервере(0);
		
	КонецЕсли;  
	
КонецПроцедуры


&НаСервере
Процедура ВставитьОбластьТабличногоДокумента(Знач ИмяВставляемаяОбласть, Знач ИмяТипаСмещения)
	
	ПараметрыДокументаЭПД = ПараметрыДокументовЭПД.Получить(Объект.ТипДокументаЭПД); 
	ИмяМакета 	= ПараметрыДокументаЭПД["Макеты"].Получить(Объект.ТекущийТитул); 
	Макет 		= CW_ОбменГИСЭПДСерверВызовСервера.ПолучитьМакетЭлектронногоПеревозочногоДокумента(ИмяМакета);    
	
	//ВставляемаяОбласть	= Макет.Область(ИмяВставляемаяОбласть); 
	
	ВремТаблДок 		= Макет.ПолучитьОбласть(ИмяВставляемаяОбласть);

	CW_ОбменГИСЭПДДополнительный.УстановитьИдентификаторыСтрок(Объект.ТекущийТитул, ВремТаблДок, "_1");
	CW_ОбменГИСЭПДДополнительный.УстановитьИдентификаторыСтрок(Объект.ТекущийТитул, ВремТаблДок, "_2");
	CW_ОбменГИСЭПДДополнительный.УстановитьИдентификаторыСтрок(Объект.ТекущийТитул, ВремТаблДок, "_3");
	
	ВставляемаяОбласть	= ВремТаблДок.Область(ИмяВставляемаяОбласть); 
	
	
	ИмяОбластьПреемник	 = "Приемник" + ИмяВставляемаяОбласть;
	
	ОбластьПреемник		= ТабличныйДокумент.Область(ИмяОбластьПреемник);
	ТипСмещения			= ТипСмещенияТабличногоДокумента[ИмяТипаСмещения];
	
	Если ТабличныйДокумент.Области.Найти(ИмяВставляемаяОбласть) = Неопределено Тогда
		ТабличныйДокумент.ВставитьОбласть(ВставляемаяОбласть, ОбластьПреемник, ТипСмещения);
	КонецЕсли;
	
КонецПроцедуры   

&НаСервере
Процедура УдалитьОбластьТабличногоДокумента(Знач ИмяОбласти, Знач ИмяТипаСмещения)
	
	ТипСмещения			= ТипСмещенияТабличногоДокумента[ИмяТипаСмещения];
	
	ВставляемаяОбласть	= ТабличныйДокумент.Области.Найти(ИмяОбласти);   
	Если ВставляемаяОбласть <> Неопределено Тогда
		ТабличныйДокумент.УдалитьОбласть(ВставляемаяОбласть, ТипСмещения);
	КонецЕсли;
	
КонецПроцедуры


&НаКлиенте
Процедура ПослеВыбораИзСписка(РезультатВыбора, ДополнительныеПараметры) ЭКспорт
	
	Если РезультатВыбора = Неопределено Тогда
		Возврат;
	КонецЕсли;  
	
	Область = ТабличныйДокумент.Области.Найти(ДополнительныеПараметры.ИмяОбласти);
	Область.Значение = РезультатВыбора.Значение;
	
	Если СтрНачинаетсяС(ДополнительныеПараметры.ИмяОбласти, 
		"ТитулГрузоотправителяАдресаПунктовПогрузкиИВыгрузки_Операция") Тогда
		
		ИндексПоказателя	= ИндексПоказателя(ДополнительныеПараметры.ИмяОбласти);    
		Постфикс 			= СтрокаСИндексомПоказателя(ИндексПоказателя);
		
		ОбластьНумерацииСтрок = ТабличныйДокумент.Область("ТитулГрузоотправителяАдресаПунктовПогрузкиИВыгрузки_НомерПп"+Постфикс);
		ОбластьНумерацииСтрок.Значение = Строка(ИндексПоказателя);
		
		ЗащитаОбласти 		= (РезультатВыбора.Значение = "Выгрузка");
		ЦветФонаОбласти 	= ?(РезультатВыбора.Значение = "Выгрузка", Новый Цвет(255,255,255), Новый Цвет(255,255,192));
		ЗначениеОбласти		= "";
		
		ОбластьНаименование = ТабличныйДокумент.Область("ТитулГрузоотправителяАдресаПунктовПогрузкиИВыгрузки_ВладелецПунктаПогрузкиНаименование"+Постфикс);
		ОбластьНаименование.Защита 		= ЗащитаОбласти;
		ОбластьНаименование.ЦветФона 	= ЦветФонаОбласти;
		ОбластьНаименование.Значение	= ЗначениеОбласти;
		
		ОбластьИНН 			= ТабличныйДокумент.Область("ТитулГрузоотправителяАдресаПунктовПогрузкиИВыгрузки_ВладелецПунктаПогрузкиИНН"+Постфикс);
		ОбластьИНН.Защита	= ЗащитаОбласти;
		ОбластьИНН.ЦветФона = ЦветФонаОбласти;
		ОбластьИНН.Значение	= ЗначениеОбласти;
	КонецЕсли;
	
	Если Объект.ТекущийТитул = ПредопределенноеЗначение("Перечисление.ТипыЭлементовРегламентаЭДО.ЭТрН_Титул1") Тогда 
		
		Если ДополнительныеПараметры.ИмяОбласти = "ТитулГрузоотправителяЛицоОсуществляющееПогрузкуЯвляетсяГрузоотправителем" Тогда
			ОбработатьИзменнениеОбластиЛицоОсуществляющееПогрузкуЯвляетсяГрузоотправителем_ЭТрН_Титул1();	
			ОбработатьИзменнениеОбластиВариантОснованияПолномочий_ЭТрН_Титул1(); 
		КонецЕсли;
	
		Если ДополнительныеПараметры.ИмяОбласти = "ВариантОснованияПолномочий" Тогда
			ОбработатьИзменнениеОбластиВариантОснованияПолномочий_ЭТрН_Титул1(); 
		КонецЕсли;
		
	КонецЕсли; 
	
	Если Объект.ТекущийТитул = ПредопределенноеЗначение("Перечисление.ТипыЭлементовРегламентаЭДО.ЭПЛ_Титул1") Тогда 
		ОбработатьИзменнениеОбласти_ЭПЛ_Титул1(Область);
	КонецЕсли; 
	
	Если Объект.ТекущийТитул = ПредопределенноеЗначение("Перечисление.ТипыЭлементовРегламентаЭДО.ЭПЛ_Титул2") Тогда 
		ОбработатьИзменнениеОбласти_ЭПЛ_Титул2(Область);
	КонецЕсли; 
	
	Модифицированность = Истина;
	
КонецПроцедуры   

&НаКлиенте
Процедура ПослеВыбораИзСправочника(РезультатВыбора, ДополнительныеПараметры) ЭКспорт
	
	Если РезультатВыбора = Неопределено Тогда
		Возврат;
	КонецЕсли;    
	
	Если СтрНачинаетсяС(ДополнительныеПараметры.ИмяОбласти, "ТитулГрузоотправителяГрузы_ВидТары") Тогда
		
		КодЭлемента = ПолучитьКодЭлементаНаСервере(РезультатВыбора);
		
		Область = ТабличныйДокумент.Области.Найти(ДополнительныеПараметры.ИмяОбласти);  
		Если Область <> Неопределено Тогда
			Область.Значение = КодЭлемента;
		КонецЕсли;
		
	КонецЕсли;
	
	Если ДополнительныеПараметры.ИмяОбласти = "СсылкаТитулПеревозчикаВалютаСтоимости"  Тогда
		
		Область = ТабличныйДокумент.Области.Найти(ДополнительныеПараметры.ИмяОбласти);  
		Если Область <> Неопределено Тогда
			Область.Значение = РезультатВыбора;
			
			ДанныеВалюты = ПолучитьКодНаименованиеВалюты(РезультатВыбора);   
			
			ОбластьКодВалюты = ТабличныйДокумент.Области.Найти("ТитулПеревозчикаКодВалютыСтоимости");  
			Если ОбластьКодВалюты <> Неопределено Тогда
				ОбластьКодВалюты.Значение = ДанныеВалюты.Код;
			Конецесли;
			
			ОбластьНаименованиеВалюты = ТабличныйДокумент.Области.Найти("ТитулПеревозчикаНаименованиеВалютыСтоимости");  
			Если ОбластьНаименованиеВалюты <> Неопределено Тогда
				ОбластьНаименованиеВалюты.Значение = ДанныеВалюты.Наименование;
			Конецесли;
		КонецЕсли;
		
	КонецЕсли;
	
	
	Модифицированность = Истина;
	
КонецПроцедуры 


&НаСервере
Функция ПолучитьМассивИменОбластейМногострочнойЧасти(Знач ВремТаблДок)
	
	МассивИменОбластей = Новый Массив;
	Для Каждого Область из ВремТаблДок.Области Цикл
		Если СтрНачинаетсяС(Область.Имя, "МногострочнаяЧасть") 
			Или СтрНачинаетсяС(Область.Имя, "УдалитьСтроку") Тогда
			Продолжить;
		Конецесли;
		ИмяОбластиБезПрефикса = CW_ОбменГИСЭПДСерверВызовСервера.ИмяОбластиБезПрефикса(Область.Имя);  
		МассивИменОбластей.Добавить(ИмяОбластиБезПрефикса);
	КонецЦикла;
	
	Возврат МассивИменОбластей;
	
КонецФункции  

&НаСервере
Процедура ДобавитьСтроку()  
	
	ИмяТекОбласти = Элементы.ТабличныйДокумент.ТекущаяОбласть.Имя;    
	
	Если СтрНайти(ИмяТекОбласти, "ДобавитьСтроку") Тогда
		ИмяОбластиПреемника 	= СтрЗаменить(ИмяТекОбласти, "ДобавитьСтроку", 	"");
		ИмяОбластиПреемника 	= СтрЗаменить(ИмяОбластиПреемника, "Значок", 	"");
		
		ЧастиОбласти 			= СтрРазделить(ИмяОбластиПреемника,"_");
		
		ИмяГруппы 				= ЧастиОбласти[0];
		ИмяОбластиПреемника 	= "ДобавлениеСтроки" + ИмяОбластиПреемника;
	КонецЕсли;    
	
	ПараметрыДокументаЭПД = ПараметрыДокументовЭПД.Получить(Объект.ТипДокументаЭПД); 
	ИмяМакета 	= ПараметрыДокументаЭПД["Макеты"].Получить(Объект.ТекущийТитул); 
	Макет 		= CW_ОбменГИСЭПДСерверВызовСервера.ПолучитьМакетЭлектронногоПеревозочногоДокумента(ИмяМакета);    
	
	НачИндекс 		= "_1";
	
	ВремТаблДок 		= Макет.ПолучитьОбласть();
	ИскомаяОбластьМнЧ 	= ВремТаблДок.Области.Найти("МногострочнаяЧасть" + ИмяГруппы);
	
	ВремТаблДок 		= ВремТаблДок.ПолучитьОбласть(ИскомаяОбластьМнЧ.Верх, , 
	ИскомаяОбластьМнЧ.Верх + ВысотаМногострочнойЧасти(ИмяГруппы, Макет) - 1, );
	
	ПреИндекс_Число = ИндексПоказателя(ИмяОбластиПреемника);
	ПреИндекс = СтрокаСИндексомПоказателя(ПреИндекс_Число);
	
	НовИндекс_Число = ПреИндекс_Число + 1;
	НовИндекс = СтрокаСИндексомПоказателя(НовИндекс_Число);
	
	НачПостфикс = ИмяГруппы + НачИндекс;
	ПреПостфикс = ИмяГруппы + ПреИндекс;
	НовПостфикс = ИмяГруппы + НовИндекс;  
	
	МассивИменОбластей = ПолучитьМассивИменОбластейМногострочнойЧасти(ВремТаблДок);
	
	Для каждого ИмяОбласти Из МассивИменОбластей Цикл
		
		НачИмяОбл = ИмяОбласти + НачИндекс;
		НовИмяОбл = ИмяОбласти + НовИндекс;
		
		ОбластьЯчейки = ВремТаблДок.Области[НачИмяОбл];
		ОбластьЯчейки.Имя = НовИмяОбл;
		
		Если ОбластьЯчейки.СодержитЗначение = Истина Тогда
			ОбластьЯчейки.Очистить();
		КонецЕсли; 
		
		Если ИмяОбласти = "ТитулГрузоотправителяАдресаПунктовПогрузкиИВыгрузки_НомерПп" Тогда
			ОбластьЯчейки.Значение = Строка(НовИндекс_Число);	
		КонецЕсли;
		
	КонецЦикла; 
	
	CW_ОбменГИСЭПДДополнительный.УстановитьИдентификаторыСтрок(Объект.ТекущийТитул, ВремТаблДок, НовИндекс);  
	
	ДопИндексы 			= CW_ОбменГИСЭПДДополнительный.ПолучитьДополнительныеИндексыОбластейТитула();
	СтрокаДопИндексы 	= ДопИндексы.Получить(Объект.ТекущийТитул);
	Если СтрокаДопИндексы <> Неопределено Тогда 
		ДопМассив = СтрРазделить(СтрокаДопИндексы,";");
		Для Каждого ДопИндекс из ДопМассив Цикл  
			ЧастиСтроки = СтрРазделить(ДопИндекс, "_", Ложь); 
			Если ЧастиСтроки.Количество() = 2 Тогда
				ТекИндекс = "_"+ЧастиСтроки[0]+НовИндекс;	
			Иначе
				ТекИндекс = ДопИндекс;
			КонецЕсли;
			CW_ОбменГИСЭПДДополнительный.УстановитьИдентификаторыСтрок(Объект.ТекущийТитул, ВремТаблДок, ТекИндекс,,НовИндекс); 
		КонецЦикла;
	КонецЕсли;
	
	Обл = ВремТаблДок.Область("УдалитьСтроку" + НачПостфикс);
	Обл.Имя = "УдалитьСтроку" + НовПостфикс;
	
	Обл = ВремТаблДок.Область("УдалитьСтроку" + НовПостфикс);
	Обл.Гиперссылка = Истина;
	Обл.Текст = "х";
	Если НовИндекс_Число = 2 Тогда
		Обл = ТабличныйДокумент.Области.Найти("УдалитьСтроку" + ПреПостфикс);
		Обл.Гиперссылка = Истина;
		Обл.Текст = "х";
	КонецЕсли; 
	
	Обл = ТабличныйДокумент.Области.Найти("ДобавитьСтроку" + ПреПостфикс);
	Обл.Имя = "ДобавитьСтроку" + НовПостфикс;   
	
	Обл = ТабличныйДокумент.Области.Найти("ДобавитьСтрокуЗначок" + ПреПостфикс);
	Обл.Имя = "ДобавитьСтрокуЗначок" + НовПостфикс;
	
	ОблПреемник = ТабличныйДокумент.Области.Найти(ИмяОбластиПреемника);  
	ОблПреемник.Имя = "ДобавлениеСтроки" + НовПостфикс;
	
	ВремТаблДок.Область("МногострочнаяЧасть" + ИмяГруппы).Имя = "";
	
	ВставляемаяОбласть = ВремТаблДок.Область(1, , ВремТаблДок.ВысотаТаблицы, ); 
	
	ТабличныйДокумент.ВставитьОбласть(ВставляемаяОбласть, ОблПреемник, ТипСмещенияТабличногоДокумента.ПоВертикали);
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьСтроку()
	
	ИмяТекОбласти 	= Элементы.ТабличныйДокумент.ТекущаяОбласть.Имя;
	
	ЧастиОбласти	= СтрРазделить(ИмяТекОбласти,"_");
	ИмяГруппы		= ЧастиОбласти[0];
	
	ДополнительныеПараметры = новый Структура;
	ДополнительныеПараметры.Вставить("ИмяОбласти",	ИмяТекОбласти); 
	ДополнительныеПараметры.Вставить("ИмяГруппы",	ИмяГруппы); 
	
	ОписаниеОповещения = Новый ОписаниеОповещения("УдалитьСтрокуЗавершение", ЭтотОбъект, ДополнительныеПараметры);
	ТекстВопроса = НСтр("ru='Удалить выбранную строку?'");
	
	ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Да);
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьСтрокуЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	УдалитьСтрокуНаСервере(ДополнительныеПараметры);  
	
	Модифицированность = Истина;
	
КонецПроцедуры  

&НаСервере
Процедура УдалитьСтрокуНаСервере(ДополнительныеПараметры)
	
	ИмяГруппы 	= СтрЗаменить(ДополнительныеПараметры.ИмяГруппы, "УдалитьСтроку", "");
	
	ТекИндекс_Число = ИндексПоказателя(ДополнительныеПараметры.ИмяОбласти);
	ТекИндекс 		= СтрокаСИндексомПоказателя(ТекИндекс_Число);
	ТекПостфикс 	= ИмяГруппы + ТекИндекс;
	
	ПараметрыДокументаЭПД = ПараметрыДокументовЭПД.Получить(Объект.ТипДокументаЭПД); 
	ИмяМакета 	= ПараметрыДокументаЭПД["Макеты"].Получить(Объект.ТекущийТитул); 
	Макет 		= CW_ОбменГИСЭПДСерверВызовСервера.ПолучитьМакетЭлектронногоПеревозочногоДокумента(ИмяМакета);    
	
	ВремТаблДок 		= Макет.ПолучитьОбласть();
	ИскомаяОбластьМнЧ 	= ВремТаблДок.Области.Найти("МногострочнаяЧасть" + ИмяГруппы);
	
	ВремТаблДок 		= ВремТаблДок.ПолучитьОбласть(ИскомаяОбластьМнЧ.Верх, , 
	ИскомаяОбластьМнЧ.Верх + ВысотаМногострочнойЧасти(ИмяГруппы, Макет) - 1, );
	
	ЧастиИмени = СтрРазделить(ДополнительныеПараметры.ИмяОбласти, "_"); 
	ИмяПервойГрафы = ЧастиИмени[0]; 
	
	ОблДобавлениеСтроки = ТабличныйДокумент.Области.Найти("ДобавлениеСтроки" + ТекПостфикс);  
	
	ОбластиАдресов = CW_ОбменГИСЭПДСерверВызовСервера.СписокОбластейАдресов(Объект.ТекущийТитул); 
	Для Каждого ИмяОбласти из ОбластиАдресов Цикл   
		Если СтрНачинаетсяС(ИмяОбласти, ПрефиксТитула + ИмяГруппы) Тогда
			КонтактнаяИнформация = Новый Структура(ДанныеКонтактнойИнформации);
			КонтактнаяИнформация.Удалить(ИмяОбласти+ТекИндекс);  
			ДанныеКонтактнойИнформации = Новый ФиксированнаяСтруктура(КонтактнаяИнформация);
		КонецЕсли;
	КонецЦикла;
	
	// Удаляется последняя строка.
	Если ОблДобавлениеСтроки <> Неопределено Тогда
		
		ПреИндекс_Число = ТекИндекс_Число - 1;
		ПреИндекс 		= СтрокаСИндексомПоказателя(ПреИндекс_Число);
		ПреПостфикс		= ИмяГруппы + ПреИндекс;
		
		ОблУдаляемогоПоказателя = ТабличныйДокумент.Область(ИмяПервойГрафы + ТекИндекс);
		
		ВерхУдОбласти = ОблУдаляемогоПоказателя.Верх;
		НизУдОбласти  = ОблДобавлениеСтроки.Верх - 1;
		
		УдаляемаяОбласть = ТабличныйДокумент.Область(ВерхУдОбласти, , НизУдОбласти, );
		ТабличныйДокумент.УдалитьОбласть(УдаляемаяОбласть, ТипСмещенияТабличногоДокумента.ПоВертикали); 
		
		Обл = ТабличныйДокумент.Области.Найти("ДобавлениеСтроки" + ТекПостфикс);
		Обл.Имя = "ДобавлениеСтроки" + ПреПостфикс;
		Обл = ТабличныйДокумент.Области.Найти("ДобавитьСтроку" + ТекПостфикс);
		Обл.Имя = "ДобавитьСтроку" + ПреПостфикс;
		Обл = ТабличныйДокумент.Области.Найти("ДобавитьСтрокуЗначок" + ТекПостфикс);
		Обл.Имя = "ДобавитьСтрокуЗначок" + ПреПостфикс;
		
		Если ПреИндекс_Число = 1 Тогда
			Обл = ТабличныйДокумент.Область("УдалитьСтроку" + ПреПостфикс);
			Обл.Гиперссылка = Ложь;
			Обл.Текст = "";
		КонецЕсли;    
		
	Иначе 
		
		НовИндекс_Число = ТекИндекс_Число + 1;
		НовИндекс = СтрокаСИндексомПоказателя(НовИндекс_Число);
		
		ОблУдаляемогоПоказателя = ТабличныйДокумент.Область(ИмяПервойГрафы + ТекИндекс);
		ОблСледующегоПоказателя = ТабличныйДокумент.Область(ИмяПервойГрафы + НовИндекс);
		
		ВерхУдОбласти = ОблУдаляемогоПоказателя.Верх;
		НизУдОбласти  = ОблСледующегоПоказателя.Верх - 1;
		
		УдаляемаяОбласть 	= ТабличныйДокумент.Область(ВерхУдОбласти, , НизУдОбласти, );  
		
		ВремТаблДок 		= ТабличныйДокумент.ПолучитьОбласть(ВерхУдОбласти, ,НизУдОбласти, );
		МассивИменОбластей 	= ПолучитьМассивИменОбластейМногострочнойЧасти(ВремТаблДок);
		
		ТабличныйДокумент.УдалитьОбласть(УдаляемаяОбласть, ТипСмещенияТабличногоДокумента.ПоВертикали);
		
		НовИндекс_Число = ТекИндекс_Число;
		
		// Реиндексация имен областей текущей многострочной части после удаления строки.  
		Пока ТабличныйДокумент.Области.Найти(ИмяПервойГрафы 
			+ СтрокаСИндексомПоказателя(НовИндекс_Число + 1)) <> Неопределено Цикл
			
			ПреИндекс = СтрокаСИндексомПоказателя(НовИндекс_Число + 1);
			НовИндекс = СтрокаСИндексомПоказателя(НовИндекс_Число);
			
			Для каждого ОбластьИмя Из МассивИменОбластей Цикл
				
				ПреИмяОбл = ОбластьИмя + ПреИндекс;
				НовИмяОбл = ОбластьИмя + НовИндекс;
				
				ОбластьЯчейки = ТабличныйДокумент.Области[ПреИмяОбл];
				ОбластьЯчейки.Имя = НовИмяОбл;  
				
				Если СтрНачинаетсяС(ОбластьЯчейки.Имя, "ТитулГрузоотправителяАдресаПунктовПогрузкиИВыгрузки_НомерПп") Тогда
					
					ИндексПоказателя = ИндексПоказателя(ОбластьЯчейки.Имя);    
					
					Постфикс = СтрокаСИндексомПоказателя(ИндексПоказателя);
					
					ОбластьНумерацииСтрок = ТабличныйДокумент.Область("ТитулГрузоотправителяАдресаПунктовПогрузкиИВыгрузки_НомерПп"+Постфикс);
					ОбластьНумерацииСтрок.Значение = Строка(ИндексПоказателя);
					
				КонецЕсли;
				
			КонецЦикла;
			
			ПреПостфикс = ИмяГруппы + ПреИндекс;
			НовПостфикс = ИмяГруппы + НовИндекс;
			
			Обл = ТабличныйДокумент.Области.Найти("УдалитьСтроку" + ПреПостфикс);
			Обл.Имя = "УдалитьСтроку" + НовПостфикс;  
			
			НовИндекс_Число = НовИндекс_Число + 1;
			
		КонецЦикла;
		
		ПреИндекс = СтрокаСИндексомПоказателя(НовИндекс_Число);
		НовИндекс = СтрокаСИндексомПоказателя(НовИндекс_Число - 1);
		
		ПреПостфикс = ИмяГруппы + ПреИндекс;
		НовПостфикс = ИмяГруппы + НовИндекс;
		
		Обл = ТабличныйДокумент.Области.Найти("ДобавлениеСтроки" + ПреПостфикс);
		Обл.Имя = "ДобавлениеСтроки" + НовПостфикс;
		Обл = ТабличныйДокумент.Области.Найти("ДобавитьСтроку" + ПреПостфикс);
		Обл.Имя = "ДобавитьСтроку" + НовПостфикс;
		Обл = ТабличныйДокумент.Области.Найти("ДобавитьСтрокуЗначок" + ПреПостфикс);
		Обл.Имя = "ДобавитьСтрокуЗначок" + НовПостфикс;
		
		НовИмяТекОбл = ИмяПервойГрафы + ТекИндекс;
		Элементы.ТабличныйДокумент.ТекущаяОбласть = ТабличныйДокумент.Области[НовИмяТекОбл];
		
	КонецЕсли;
	
	Модифицированность = Истина;
	
КонецПроцедуры  

&НаКлиентеНаСервереБезКонтекста
Функция ИндексПоказателя(Знач ИмяОбласти) 
	
	МассивСтрок = СтрРазделить(ИмяОбласти, "_");
	
	КолСтрок = МассивСтрок.Количество();
	
	Если КолСтрок = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ИндексСтрока = МассивСтрок[КолСтрок - 1];
	Если СтроковыеФункцииКлиентСервер.ТолькоЦифрыВСтроке(ИндексСтрока) Тогда
		Возврат Число(ИндексСтрока);
	КонецЕсли;
	
КонецФункции   

&НаКлиентеНаСервереБезКонтекста
Функция СтрокаСИндексомПоказателя(Знач Индекс) 
	
	Если ТипЗнч(Индекс) <> Тип("Число") Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат "_" + Формат(Индекс, "ЧГ=");
	
КонецФункции


&НаСервере
Функция ВысотаМногострочнойЧасти(ИмяГруппы, ТаблДок = Неопределено)
	
	Если ТаблДок = Неопределено Тогда
		ПараметрыДокументаЭПД = ПараметрыДокументовЭПД.Получить(Объект.ТипДокументаЭПД); 
		ИмяМакета 	= ПараметрыДокументаЭПД["Макеты"].Получить(Объект.ТекущийТитул); 
		ТаблДок 	= CW_ОбменГИСЭПДСерверВызовСервера.ПолучитьМакетЭлектронногоПеревозочногоДокумента(ИмяМакета);    
	КонецЕсли;
	
	ИскомаяОбласть1 = ТаблДок.Области.Найти("МногострочнаяЧасть" + ИмяГруппы); 
	
	Для каждого ИскомаяОбласть2 Из ТаблДок.Области Цикл  
		Если СтрНачинаетсяС(ИскомаяОбласть2.Имя, "ДобавлениеСтроки" + ИмяГруппы) Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Возврат ИскомаяОбласть2.Верх - ИскомаяОбласть1.Верх;
	
КонецФункции

&НаСервере
Функция ПолучитьСписокАдресовПунктов()
	
	СписокЗначений = Новый СписокЗначений;
	
	Для Каждого Область из ТабличныйДокумент.Области Цикл
		Если СтрНайти(Область.Имя, ПрефиксТитула) =  0 Тогда
			Продолжить;
		КонецЕсли;
		
		Если СтрНачинаетсяС(Область.Имя, "ТитулГрузоотправителяАдресаПунктовПогрузкиИВыгрузки_ПредставлениеАдресПунктаПогрузки") Тогда
			ИндексСтроки 	= ИндексПоказателя(Область.Имя);
			СтрокаСИндексом = СтрокаСИндексомПоказателя(ИндексСтроки);
			
			ОбластьСНомером = ТабличныйДокумент.Области.Найти("ТитулГрузоотправителяАдресаПунктовПогрузкиИВыгрузки_НомерПп"+СтрокаСИндексом);
			Если ОбластьСНомером <> Неопределено Тогда
				СписокЗначений.Добавить(ОбластьСНомером.Значение,СокрЛП(Область.Значение)); 
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат СписокЗначений;
	
КонецФункции 

&НаКлиенте
Процедура ВводАдреса(ОбластьИмя) 
	
	Если ТипЗнч(ДанныеКонтактнойИнформации) = Тип("ФиксированнаяСтруктура") 
		и ДанныеКонтактнойИнформации.Свойство(ОбластьИмя) Тогда
		ДанныеАдреса = ДанныеКонтактнойИнформации[ОбластьИмя];  
		
		КонтактнаяИнформацияАдреса 	= ДанныеАдреса.КонтактнаяИнформация;
		СтруктураРеквизитовАдреса 	= ДанныеАдреса.СтруктураАдреса;
	Иначе
		СтруктураРеквизитовАдреса 	= CW_ОбменГИСЭПДСерверВызовСервера.ПустаяСтруктураАдерса(); 
		КонтактнаяИнформацияАдреса 	= ОбменСГИСЭПДВызовСервера.КонтактнаяИнформацияВXML(СтруктураРеквизитовАдреса,,
		ПредопределенноеЗначение("Перечисление.ТипыКонтактнойИнформации.Адрес"));
	КонецЕсли;
	
	ПараметрыФормыВводаАдреса = УправлениеКонтактнойИнформациейКлиент.ПараметрыФормыКонтактнойИнформации(
	ОбменСГИСЭПДВызовСервера.ВидФактическийАдресКонтрагента(), 
	КонтактнаяИнформацияАдреса);
	
	ДополнительныеПараметры = Новый Структура;               
	ДополнительныеПараметры.Вставить("ОбластьИмя", ОбластьИмя);  
	
	Оповещение = Новый ОписаниеОповещения("ВводАдреса_Завершение", ЭтотОбъект, ДополнительныеПараметры);
	
	УправлениеКонтактнойИнформациейКлиент.ОткрытьФормуКонтактнойИнформации(ПараметрыФормыВводаАдреса, ЭтаФорма, Оповещение);
	
КонецПроцедуры

&НаКлиенте
Процедура ВводАдреса_Завершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат <> Неопределено Тогда
		
		ОбластьДокумента = ТабличныйДокумент.Область(ДополнительныеПараметры.ОбластьИмя);
		Если ОбластьДокумента <> Неопределено тогда
			ОбластьДокумента.Значение = Результат.Представление;
		КонецЕсли;
		
		РезультатЗначение = ?(Результат.Свойство("Значение"), Результат.Значение, Результат.Адрес);	
		
		СтруктураПараметров = Новый Структура("БезПредставлений, ПроверитьАдрес, КодыАдреса", Ложь, Истина, Истина);
		СтруктураАдреса = CW_ОбменГИСЭПДСерверВызовСервера.СведенияОбАдресе(РезультатЗначение, СтруктураПараметров);
		
		ОбластьИмя		= CW_ОбменГИСЭПДСерверВызовСервера.ИмяОбластиБезПрефикса(ДополнительныеПараметры.ОбластьИмя);
		ИндексСтроки	= ИндексПоказателя(ДополнительныеПараметры.ОбластьИмя);
		СтрокаСИндексом = СтрокаСИндексомПоказателя(ИндексСтроки);
		
		СтруктураРеквизитовАдреса = ПолучитьРеквизитыАдреса(СтруктураАдреса, ОбластьИмя, СтрокаСИндексом);
		СтруктураРеквизитовАдреса.Вставить(ДополнительныеПараметры.ОбластьИмя, Результат.Представление);
		
		КонтактнаяИнформация = Новый Структура;
		Если ТипЗнч(ДанныеКонтактнойИнформации) = Тип("ФиксированнаяСтруктура") Тогда
			КонтактнаяИнформация = Новый Структура(ДанныеКонтактнойИнформации); 
		КонецЕсли;
		
		ДанныеАдреса = Новый Структура;
		ДанныеАдреса.Вставить("КонтактнаяИнформация", 		Результат.КонтактнаяИнформация);
		ДанныеАдреса.Вставить("СтруктураАдреса",			СтруктураАдреса); 
		ДанныеАдреса.Вставить("СтруктураРеквизитовАдреса",	СтруктураРеквизитовАдреса); 
		
		КонтактнаяИнформация.Вставить(ДополнительныеПараметры.ОбластьИмя, ДанныеАдреса);
		
		ДанныеКонтактнойИнформации = Новый ФиксированнаяСтруктура(КонтактнаяИнформация);
		
		Модифицированность = Истина;
		
	КонецЕсли;
	
КонецПроцедуры        

&НаСервере
Функция ПолучитьРеквизитыАдреса(СтруктураАдреса, ИмяЭлемента, ИндексСтроки="") 
	
	Префикс = СтрЗаменить(ИмяЭлемента, "Представление", "");
	
	СтруктураДанныеАдреса = Новый Структура;   
	
	Если СтруктураАдреса.ТипАдреса = "ВСвободнойФорме"
		Или ЗначениеЗаполнено(СтруктураАдреса.Территория) Тогда
		СтруктураДанныеАдреса.Вставить(Префикс + "Представление" + ИндексСтроки, СтруктураАдреса.Представление);
		СтруктураДанныеАдреса.Вставить(Префикс + "КодСтраны"  + ИндексСтроки, СтруктураАдреса.КодСтраны);	
	Иначе	
		СтруктураДанныеАдреса.Вставить(Префикс + "Индекс" + ИндексСтроки, СтруктураАдреса.Индекс);
		СтруктураДанныеАдреса.Вставить(Префикс + "КодРегиона" + ИндексСтроки, СтруктураАдреса.КодРегиона);
		СтруктураДанныеАдреса.Вставить(Префикс + "Город" + ИндексСтроки, СтруктураАдреса.Город + ?(СтруктураАдреса.ГородТипКраткий = "", "", " ") + СтруктураАдреса.ГородТипКраткий);
		СтруктураДанныеАдреса.Вставить(Префикс + "Район" + ИндексСтроки, СтруктураАдреса.Район + ?(СтруктураАдреса.РайонТипКраткий = "", "", " ") + СтруктураАдреса.РайонТипКраткий);
		СтруктураДанныеАдреса.Вставить(Префикс + "НаселенныйПункт" + ИндексСтроки, СтруктураАдреса.НаселенныйПункт + ?(СтруктураАдреса.НаселенныйПунктТипКраткий = "", "", " ") + СтруктураАдреса.НаселенныйПунктТипКраткий);
		СтруктураДанныеАдреса.Вставить(Префикс + "Улица" + ИндексСтроки, СтруктураАдреса.Улица + ?(СтруктураАдреса.УлицаТипКраткий = "", "", " ") + СтруктураАдреса.УлицаТипКраткий);
		СтруктураДанныеАдреса.Вставить(Префикс + "Дом" + ИндексСтроки, СтруктураАдреса.Здание.Номер);
		Если СтруктураАдреса.Корпуса.Количество() > 0 Тогда
			СтруктураДанныеАдреса.Вставить(Префикс + "Корпус" + ИндексСтроки, СтруктураАдреса.Корпуса[0].Номер);
		КонецЕсли;	
	КонецЕсли;    
	
	Возврат СтруктураДанныеАдреса;
	
КонецФункции

&НаСервере
Функция ПолучитьФактическийНаСервере(ЗначениеОтбора)
	
	Если ТипЗнч(ЗначениеОтбора) = Тип("СправочникСсылка.Организации") Тогда
		ВидАдреса = Справочники.ВидыКонтактнойИнформации.ФактАдресОрганизации;	
	Иначе
		ВидАдреса = CW_ОбменГИСЭПДПереопределяемый.ВидФактическийАдресКонтрагента();	
	КонецЕсли;
	
	ТаблицаКИ = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(ЗначениеОтбора, ВидАдреса,,Ложь); 
	Результат = Новый Структура("Вид,Значение,КонтактнаяИнформация,Представление");
	
	Если ТаблицаКИ.Количество() > 0 Тогда
		Результат = Новый Структура("Вид,Значение,КонтактнаяИнформация,Представление");
		Результат.Вид 			= ТаблицаКИ[0].Вид;
		Результат.Значение 		= ТаблицаКИ[0].Значение;
		Результат.Представление = ТаблицаКИ[0].Представление;  
		Результат.КонтактнаяИнформация = ТаблицаКИ[0].ЗначенияПолей;
	КонецЕсли; 
	
	Возврат Результат;
	
КонецФункции

&НаСервереБезконтекста
Функция ПолучитьИНН(Контрагент)
	
	Если ТипЗнч(Контрагент) = Тип("СправочникСсылка.Контрагенты") Тогда
		Возврат Контрагент.ИНН;
	Конецесли; 
	
	Возврат "";
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьКодЭлементаНаСервере(ВыбранныйЭлемент)
	
