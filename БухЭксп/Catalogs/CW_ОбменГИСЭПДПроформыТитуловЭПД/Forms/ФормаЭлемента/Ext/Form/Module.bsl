
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("Макет") Тогда
		ВывестиТабличныйДокументНаФорму(Параметры.Макет);
	КонецЕсли;  
	Если Параметры.Свойство("КонтактнаяИнформация") Тогда
		ДанныеКонтактнойИнформации = Новый ФиксированнаяСтруктура(Параметры.КонтактнаяИнформация);	
	КонецЕсли;
	Если Параметры.Свойство("ДанныеЗаполнения") Тогда     
		ЗаполнитьЗначенияСвойств(Объект, Параметры.ДанныеЗаполнения);
	КонецЕсли;
	
	Если ПараметрыДокументовЭПД = Неопределено Тогда
		CW_ОбменГИСЭПДДополнительный.УстановитьПараметрыТиповДокументовЭПД(ЭтотОбъект); 
	КонецЕсли;
	
	Если ТипЗнч(ДоступныеТипыДокументовЭПД) = Тип("ФиксированныйМассив") 
		И Параметры.Ключ.Пустая() 
		и ДоступныеТипыДокументовЭПД.Количество() = 1 Тогда
		Объект.ТипДокументаЭПД = ДоступныеТипыДокументовЭПД[0];
	КонецЕсли;   
	
	Если Не Объект.ТипДокументаЭПД.Пустая() Тогда
		ТипДокументаЭПДПриИзмененииНаСервере();  
	КонецЕсли;   
	
КонецПроцедуры 

&НаСервере
Процедура УстановитьФункцииДокумента(ИмяФункции)
	
	Область = ТабличныйДокумент.Область("ТитулГрузоотправителяФункция");
	Область.Значение = ИмяФункции;
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	CW_ОбменГИСЭПДДополнительный.УстановитьПараметрыТиповДокументовЭПД(ЭтотОбъект); 
	
	ДокументЭПД = CW_ОбменГИСЭПДДополнительный.ПолучитьСвязанныйДокументЭПД(Объект.Ссылка);
	
	ИнформацияПоПрефиксамТитула = CW_ОбменГИСЭПДПереопределяемый.ПрефиксТитулаПоЭлементуРегламентаЭДО(Объект.ТекущийТитул);
	ПрефиксТитула 				= ИнформацияПоПрефиксамТитула.ВПрограмме;
	
	УстановитьДанныеОбъекта(ТекущийОбъект);
	
КонецПроцедуры  

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	CW_ОбменГИСЭПДДополнительный.ДобавитьСвязанныйДокументЭПД(Объект.Ссылка, ДокументЭПД);
	
КонецПроцедуры


&НаСервере
Процедура УстановитьДанныеОбъекта(ТекущийОбъект)
	
	ДанныеКонтактнойИнформации 		= ТекущийОбъект.ДанныеКонтактнойИнформации.Получить();
	ХранимыйДокумент 				= ТекущийОбъект.ХранилищеМакета.Получить(); 
	
	ВывестиТабличныйДокументНаФорму(ХранимыйДокумент);

КонецПроцедуры

&НаСервере
Процедура ВывестиТабличныйДокументНаФорму(ХранимыйДокумент)
	
	Если ТипЗнч(ХранимыйДокумент) = Тип("ТабличныйДокумент") Тогда
		ТабличныйДокумент = ХранимыйДокумент;
		ТабличныйДокумент.ОтображатьГруппировки = Истина;  
		ТабличныйДокумент.ПоказатьУровеньГруппировокСтрок(0);  
	КонецЕсли;
	
	Если Объект.ТекущийТитул = ПредопределенноеЗначение("Перечисление.ТипыЭлементовРегламентаЭДО.ЭЗЗ_Титул1") Тогда 
		ОбработатьИзменнениеОбластиПоДоверенностиГрузоотправителя_ЭЗЗ_Титул1(); 
	КонецЕсли;
	Если Объект.ТекущийТитул = ПредопределенноеЗначение("Перечисление.ТипыЭлементовРегламентаЭДО.ЭЗЗ_Титул2") Тогда 
		ОбработатьИзменнениеОбластиВариантПоДоверенностиЗаПеревозчика_ЭЗЗ_Титул2(); 
	КонецЕсли;  
	Если Объект.ТекущийТитул = ПредопределенноеЗначение("Перечисление.ТипыЭлементовРегламентаЭДО.ЭТрН_Титул1") Тогда 
		ОбработатьИзменнениеОбластиПоДоверенностиГрузоотправителя_ЭТрН_Титул1(); 
		ОбработатьИзменнениеОбластиТитулГрузоотправителяЭкспедитор_ЭТрН_Титул1();
	КонецЕсли;

КонецПроцедуры  

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если Объект.ТекущийТитул = ПредопределенноеЗначение("Перечисление.ТипыЭлементовРегламентаЭДО.ЭТрН_Титул1") Тогда 
		//	ОбработатьИзменнениеОбластиПоДоверенностиГрузоотправителя_ЭТрН_Титул1(); 
			УстановитьДоступностьОбластиГрузоплучатель_ЭТрН_Титул1();
		//	ОбработатьИзменнениеОбластиТитулГрузоотправителяЭкспедитор_ЭТрН_Титул1();
	КонецЕсли;  
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	Объект.Наименование = СокрЛП(Объект.ТипДокументаЭПД) + " - " + СокрЛП(Объект.ТекущийТитул);
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи) 

	Если ЗначениеЗаполнено(ТекущийОбъект.ВидДокумента) = Ложь Тогда
		ТекущийОбъект.ВидДокумента = ЭлектронныеДокументыЭДО.ВидДокументаПоТипу(ТекущийОбъект.ТипДокументаЭПД);
	КонецЕсли;
	
	ТекущийОбъект.ХранилищеМакета = Новый ХранилищеЗначения(ТабличныйДокумент, Новый СжатиеДанных(9));
	ТекущийОбъект.ДанныеКонтактнойИнформации = Новый ХранилищеЗначения(ДанныеКонтактнойИнформации, Новый СжатиеДанных(9));
	
	ЗаписатьЗначенияРеквизитовДокументаЭПД(ТекущийОбъект);
	
КонецПроцедуры   

&НаСервере
Процедура ЗаписатьЗначенияРеквизитовДокументаЭПД(ТекущийОбъект)

	ИнформацияПоПрефиксамТитула = CW_ОбменГИСЭПДПереопределяемый.ПрефиксТитулаПоЭлементуРегламентаЭДО(Объект.ТекущийТитул);
	ПрефиксТитула = ИнформацияПоПрефиксамТитула.ВПрограмме;
	
	ИмяДокумента 				= ПолучитьИмяДокументаПоТипу();
	ОбластиАдресов 				= CW_ОбменГИСЭПДСерверВызовСервера.СписокОбластейАдресов(Объект.ТекущийТитул);
	ОбластиБулево				= CW_ОбменГИСЭПДСерверВызовСервера.СписокОбластейТипБлево(Объект.ТекущийТитул);  
	ОбластиСтроковыеЗначения	= CW_ОбменГИСЭПДСерверВызовСервера.СписокОбластейСтроковыеЗначения(Объект.ТекущийТитул);  
	
	ТаблицаЗначенийРеквизитов	= CW_ОбменГИСЭПДДополнительный.ПолучитьПустуюТаблицуЗначенийРеквизитов();  
	
	Если НужноЗаписатьПараметрыТранспортногоСредства() Тогда
		ЗаписатьХранимыеДанныеПараметрыТранспортногоСредства(ТаблицаЗначенийРеквизитов, ИмяДокумента);
	КонецЕсли;
	Если НужноЗаписатьТраспортноеСредство() Тогда
		ЗаписатьХранимыеДанныеТраспортного(ТаблицаЗначенийРеквизитов, ИмяДокумента, ПрефиксТитула);
	КонецЕсли; 
	
	Если НужноЗаписатьВодителя() Тогда
		ЗаписатьХранимыеДанныеВодителя(ТаблицаЗначенийРеквизитов, ИмяДокумента, ПрефиксТитула);
	КонецЕсли;   
	Если НужноЗаписатьГруз() Тогда
		ЗаписатьХранимыеДанныеГруз(ТаблицаЗначенийРеквизитов, ИмяДокумента, ПрефиксТитула);
	КонецЕсли;   
	Если НужноЗаписатьМедработика() Тогда
		ЗаписатьХранимыеДанныеМедработика(ТаблицаЗначенийРеквизитов, ИмяДокумента, ПрефиксТитула, "ШтатныйМедработник");
		ЗаписатьХранимыеДанныеМедработика(ТаблицаЗначенийРеквизитов, ИмяДокумента, ПрефиксТитула, "СтороннийМедработник");
	КонецЕсли;

	ИменаТаблицХранимыеДанные  = Новый Массив;
	
	Для Каждого Область из ТабличныйДокумент.Области Цикл
		Если СтрНайти(Область.Имя, ПрефиксТитула) = 0 Тогда
			Продолжить;
		КонецЕсли; 
		
		Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ТекущийОбъект, Область.Имя) Тогда 
			ТекущийОбъект[Область.Имя] = Область.Значение;                                              
		КонецЕсли; 
		
		ИмяОбластиБезПрефикса = CW_ОбменГИСЭПДСерверВызовСервера.ИмяОбластиБезПрефикса(Область.Имя); 
		
		Если ОбластиБулево.Найти(ИмяОбластиБезПрефикса) <> Неопределено Тогда
			
			ЗначениеРеквизита 	= (Область.Значение = "V"); 
			
			ДанныеСтроки = ПустаяСтруктураДанныхСтроки();
			ДанныеСтроки.ИмяРеквизита 			= Область.Имя;; 
			ДанныеСтроки.ЗначениеРеквизита 		= ЗначениеРеквизита;
			
			ПривОбластьИмя 	= CW_ОбменГИСЭПДДополнительный.ПривестиИмяОбласти(Область.Имя);
			ЧастиИмени 		= СтрРазделить(ПривОбластьИмя, "_"); 
			Если ЧастиИмени.Количество() = 3 Тогда    
				ДанныеСтроки.ИмяТабличнойЧасти 		= ЧастиИмени[0]; 
				ДанныеСтроки.НомерСтрокиРеквизита	= ЧастиИмени[2];  
				ДанныеСтроки.ИмяРеквизита			= CW_ОбменГИСЭПДДополнительный.ВостановитьПриведенноеИмяРеквизита(ЧастиИмени[1]); 
			КонецЕсли; 
			
			ЗаписатьЗначениеОбластиВТаблицу(ТаблицаЗначенийРеквизитов, ДанныеСтроки);
			
		ИначеЕсли ОбластиАдресов.Найти(ИмяОбластиБезПрефикса) <> Неопределено Тогда  
			
			Если ТипЗнч(ДанныеКонтактнойИнформации) = Тип("ФиксированнаяСтруктура") 
				и ДанныеКонтактнойИнформации.Свойство(Область.Имя) Тогда
				
				ДанныеАдреса = ДанныеКонтактнойИнформации[Область.Имя];  
				Для Каждого КлючЗначение из ДанныеАдреса.СтруктураРеквизитовАдреса Цикл 
					ДанныеСтроки = ПустаяСтруктураДанныхСтроки();
					ДанныеСтроки.ЗначениеРеквизита 		= КлючЗначение.Значение;
					
					ПривОбластьИмя 	= CW_ОбменГИСЭПДДополнительный.ПривестиИмяОбласти(КлючЗначение.Ключ);
					ЧастиИмени 		= СтрРазделить(ПривОбластьИмя, "_"); 
					Если ЧастиИмени.Количество() = 3 Тогда   
						ДанныеСтроки.ИмяТабличнойЧасти 		= ЧастиИмени[0]; 
						ДанныеСтроки.ИмяРеквизита 			= CW_ОбменГИСЭПДДополнительный.ВостановитьПриведенноеИмяРеквизита(ЧастиИмени[1]); 
						ДанныеСтроки.НомерСтрокиРеквизита	= ЧастиИмени[2]; 
					Иначе
						ДанныеСтроки.ИмяРеквизита 			= ЧастиИмени[0]; 
					КонецЕсли; 
					
					ЗаписатьЗначениеОбластиВТаблицу(ТаблицаЗначенийРеквизитов, ДанныеСтроки);
				КонецЦикла; 
				
			КонецЕсли; 
			
		ИначеЕсли СтрНайти(Область.Имя, "ХранимыеДанныеСторонаПодписавшаяДокумент") > 0 Тогда 
			
			ПривОбластьИмя	= CW_ОбменГИСЭПДДополнительный.ПривестиИмяОбласти(Область.Имя);	
			ЧастиИмени 		= СтрРазделить(ПривОбластьИмя, "_"); 
			Если ЧастиИмени.Количество() > 2 Тогда 
				Если ИменаТаблицХранимыеДанные.Найти(ЧастиИмени[0]) = Неопределено Тогда
					ИменаТаблицХранимыеДанные.Добавить(ЧастиИмени[0]); 
				КонецЕсли;
			КонецЕсли; 
			
			ХранимыеДанные = ПолучитьХранимыеДанныеСторонаПодписавшаяДокумент(ИмяДокумента, Область);
			Если ХранимыеДанные <> Неопределено Тогда
				//Запись состава хранимых данных
				Для Каждого СтрокаДанных из ХранимыеДанные.Данные Цикл   
					ДанныеСтроки = ПустаяСтруктураДанныхСтроки();
					ДанныеСтроки.ИмяРеквизита 			= СтрокаДанных.Имя; 
					ДанныеСтроки.ЗначениеРеквизита 		= СтрокаДанных.Значение;
					
					Если ЧастиИмени.Количество() > 2 Тогда 
						ДанныеСтроки.ИмяТабличнойЧасти 		= ЧастиИмени[0]; 
						ДанныеСтроки.НомерСтрокиРеквизита	= ЧастиИмени[2];  
					КонецЕсли; 
					
					ЗаписатьЗначениеОбластиВТаблицу(ТаблицаЗначенийРеквизитов, ДанныеСтроки);  
				КонецЦикла; 
				//---Запись состава хранимых данных
			КонецЕсли; 
			
			//Запись хранимых данных
			ДанныеСтроки = ПустаяСтруктураДанныхСтроки();
			ДанныеСтроки.ИмяРеквизита 			= Область.Имя; 
			ДанныеСтроки.ЗначениеРеквизита 		= ХранимыеДанные;
			
			Если ЧастиИмени.Количество() > 2 Тогда 
				ДанныеСтроки.ИмяТабличнойЧасти 		= ЧастиИмени[0]; 
				ДанныеСтроки.ИмяРеквизита			= CW_ОбменГИСЭПДДополнительный.ВостановитьПриведенноеИмяРеквизита(ЧастиИмени[1]); 
				ДанныеСтроки.НомерСтрокиРеквизита	= ЧастиИмени[2];  
			КонецЕсли; 
			
			ЗаписатьЗначениеОбластиВТаблицу(ТаблицаЗначенийРеквизитов, ДанныеСтроки);  
			//--Запись хранимых данных
		Иначе
			
			ДанныеСтроки = ПустаяСтруктураДанныхСтроки();
			ДанныеСтроки.ИмяРеквизита 		= Область.Имя; 
			
			Если ОбластиСтроковыеЗначения.Найти(ИмяОбластиБезПрефикса) = Неопределено Тогда 
				ДанныеСтроки.ЗначениеРеквизита	= Область.Значение;   
			Иначе
				СтроковыеЗначенияЭПД = Новый Структура;
				СтроковыеЗначенияЭПД.Вставить("Тип", 			Тип("СправочникСсылка.СтроковыеЗначенияЭПД"));
				СтроковыеЗначенияЭПД.Вставить("Наименование", 	СокрЛП(Область.Значение));
				
				ДанныеСтроки.ЗначениеРеквизита	= СтроковыеЗначенияЭПД;   
			КонецЕсли;
			
			ПривОбластьИмя 	= CW_ОбменГИСЭПДДополнительный.ПривестиИмяОбласти(Область.Имя);
			ЧастиИмени 		= СтрРазделить(ПривОбластьИмя, "_"); 
			Если ЧастиИмени.Количество() > 2  Тогда 
				ДанныеСтроки.ИмяТабличнойЧасти 		= ЧастиИмени[0]; 
				ДанныеСтроки.ИмяРеквизита			= CW_ОбменГИСЭПДДополнительный.ВостановитьПриведенноеИмяРеквизита(ЧастиИмени[1]); 
				ДанныеСтроки.НомерСтрокиРеквизита	= ЧастиИмени[2];  
			КонецЕсли; 
			
			ЗаписатьЗначениеОбластиВТаблицу(ТаблицаЗначенийРеквизитов, ДанныеСтроки);
			
		КонецЕсли;  
		
	КонецЦикла; 
	
	Если Объект.ТекущийТитул = ПредопределенноеЗначение("Перечисление.ТипыЭлементовРегламентаЭДО.ЭЗЗ_Титул1") Тогда 
		ОбластьГрузоотправитель = ТабличныйДокумент.Области.Найти("СсылкаТитулГрузоотправителяГрузоотправитель");
		Если ОбластьГрузоотправитель <> Неопределено Тогда
			ТекущийОбъект.Организация 	= ОбластьГрузоотправитель.Значение	
		КонецЕсли;  
		
		ОбластьВариантПоДоверенности = ТабличныйДокумент.Области.Найти("ВариантПоДоверенностиЗаГрузоотправителя"); 
		Если ОбластьВариантПоДоверенности <> Неопределено Тогда
			Если ОбластьВариантПоДоверенности.Значение = "V" Тогда
				ОбластьСоставитель = ТабличныйДокумент.Области.Найти("СсылкаТитулГрузоотправителяСоставитель");
				Если ОбластьСоставитель <> Неопределено Тогда
					ТекущийОбъект.Организация 	= ОбластьСоставитель.Значение	
				КонецЕсли;  
			КонецЕсли;                                        
		КонецЕсли;   
	КонецЕсли;
	
	Если Объект.ТекущийТитул = ПредопределенноеЗначение("Перечисление.ТипыЭлементовРегламентаЭДО.ЭЗЗ_Титул2") Тогда 
		ОбластьВариантПоДоверенности = ТабличныйДокумент.Области.Найти("ВариантПоДоверенностиЗаПеревозчика"); 
		Если ОбластьВариантПоДоверенности <> Неопределено Тогда
			Если ОбластьВариантПоДоверенности.Значение = "V" Тогда
				ОбластьСоставитель = ТабличныйДокумент.Области.Найти("СсылкаТитулПеревозчикаСоставитель");
				Если ОбластьСоставитель <> Неопределено Тогда
					ТекущийОбъект.Организация 	= ОбластьСоставитель.Значение	
				КонецЕсли;  
			КонецЕсли;                                        
		КонецЕсли;   
	КонецЕсли;  
	
	Если Объект.ТекущийТитул = ПредопределенноеЗначение("Перечисление.ТипыЭлементовРегламентаЭДО.ЭТрН_Титул1") Тогда 
		ОбластьГрузоотправитель = ТабличныйДокумент.Области.Найти("СсылкаТитулГрузоотправителяГрузоотправитель");
		Если ОбластьГрузоотправитель <> Неопределено Тогда
			ТекущийОбъект.Организация 	= ОбластьГрузоотправитель.Значение	
		КонецЕсли;  
		
		ОбластьВариантПоДоверенности = ТабличныйДокумент.Области.Найти("ВариантПоДоверенности"); 
		Если ОбластьВариантПоДоверенности <> Неопределено Тогда
			Если ОбластьВариантПоДоверенности.Значение = "V" Тогда
				ОбластьСоставитель = ТабличныйДокумент.Области.Найти("СсылкаТитулГрузоотправителяСоставитель");
				Если ОбластьСоставитель <> Неопределено Тогда
					ТекущийОбъект.Организация 	= ОбластьСоставитель.Значение	
				КонецЕсли;  
			КонецЕсли;                                        
		КонецЕсли;   
	КонецЕсли;     

	УдалитьСтрокиСПустымЗначением(ТаблицаЗначенийРеквизитов);

	ТекущийОбъект.ЗначенияРеквизитовДокументовЭПД = Новый ХранилищеЗначения(ТаблицаЗначенийРеквизитов,	Новый СжатиеДанных(9));
	
КонецПроцедуры
    
&НаСервере
Процедура УдалитьПустыеХранимыеДанныеСторонаПодписавшаяДокумент(ТаблицаЗначенийРеквизитов)
	
	УдаляемыеСтроки = Новый Соответствие;
	
	ОтборХранимыеДанные = Новый Структура;
	ОтборХранимыеДанные.Вставить("Имя", "ХранимыеДанныеСторонаПодписавшаяДокумент"); 
	
	ВремТаблицаЗначенийРеквизитов = ТаблицаЗначенийРеквизитов.Скопировать(); 
	
	//Удаляем из исходной таблицы все строки по именам табличных частей
	ТабличныеЧасти = ВремТаблицаЗначенийРеквизитов.Скопировать(ОтборХранимыеДанные); 
	ТабличныеЧасти.Свернуть("ИмяТабличнойЧасти");
	Для Каждого СтрокаТаблицы из ТабличныеЧасти Цикл
		СтруктураОтбора = Новый Структура;
		СтруктураОтбора.Вставить("ИмяТабличнойЧасти", СтрокаТаблицы.ИмяТабличнойЧасти);
		
		УдаляемыеСтроки = ТаблицаЗначенийРеквизитов.НайтиСтроки(СтруктураОтбора);
		Для Каждого УдаляемаяСтрока из УдаляемыеСтроки Цикл
			ТаблицаЗначенийРеквизитов.Удалить(УдаляемаяСтрока);	
		КонецЦикла;
	КонецЦикла;
	//---Удаляем из исходной таблицы все строки по именам табличных частей 
	
	//Подготовка таблиц по данным строк
	ПодготовленныеТаблицы = Новый Соответствие;
	
	Для Каждого СтрокаТаблицы из ТабличныеЧасти Цикл
		СтруктураОтбора = Новый Структура;
		СтруктураОтбора.Вставить("ИмяТабличнойЧасти", СтрокаТаблицы.ИмяТабличнойЧасти); 
		
		ТаблицаРеквизитов = ВремТаблицаЗначенийРеквизитов.Скопировать(СтруктураОтбора);
		ТаблицаРеквизитов.Свернуть("Имя");
		
		ТаблицаНомераСтрок = ВремТаблицаЗначенийРеквизитов.Скопировать(СтруктураОтбора);
		ТаблицаНомераСтрок.Свернуть("НомерСтрокиТЧ");
		
		ТаблицаЗначений = Новый ТаблицаЗначений;
		Для каждого СтрокаТаблицыРеквизитов из ТаблицаРеквизитов Цикл
			ТаблицаЗначений.Колонки.Добавить(СтрокаТаблицыРеквизитов.Имя);	
		КонецЦикла;  
		
		Для Каждого СтрокаНомеров из ТаблицаНомераСтрок Цикл    
			СтруктураОтбора.Вставить("НомерСтрокиТЧ", СтрокаНомеров.НомерСтрокиТЧ); 
			
			НоваяСтрока = ТаблицаЗначений.Добавить();
			
			НайденныеСтроки = ВремТаблицаЗначенийРеквизитов.НайтиСтроки(СтруктураОтбора);
			Для Каждого СтрокаДанных из НайденныеСтроки Цикл
				НоваяСтрока[СтрокаДанных.Имя] = СтрокаДанных.Значение;	
			КонецЦикла;
		КонецЦикла;
		
		ПодготовленныеТаблицы.Вставить(СтрокаТаблицы.ИмяТабличнойЧасти, ТаблицаЗначений);  
	КонецЦикла;  
	//---Подготовка таблиц по данным строк
	
	//Удаление пустых строк
	Для Каждого СтрокаТаблицы из ТабличныеЧасти Цикл   
		ТаблицаЗначений = ПодготовленныеТаблицы.Получить(СтрокаТаблицы.ИмяТабличнойЧасти);
		
		УдаляемыеСтроки = Новый Массив;
		Для Каждого СтрокаТаблицыЗначений из ТаблицаЗначений Цикл
			Если ТипЗнч(СтрокаТаблицыЗначений.ХранимыеДанныеСторонаПодписавшаяДокумент) <> тип("Структура") Тогда   
				УдаляемыеСтроки.Добавить(СтрокаТаблицыЗначений);	
			КонецЕсли;
		КонецЦикла;
		
		Для Каждого УдаляемаяСтрока из УдаляемыеСтроки Цикл
			ТаблицаЗначений.Удалить(УдаляемаяСтрока);	
		КонецЦикла;
		
		ПодготовленныеТаблицы.Вставить(СтрокаТаблицы.ИмяТабличнойЧасти, ТаблицаЗначений);  
	КонецЦикла;
	//---Удаление пустых строк   
	
	//Запись данных таблиц в исходную таблицу
	Для Каждого СтрокаТаблицы из ТабличныеЧасти Цикл   
		ТаблицаЗначений = ПодготовленныеТаблицы.Получить(СтрокаТаблицы.ИмяТабличнойЧасти);
		Если ТаблицаЗначений.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;   
		
		Для Индекс=0 по ТаблицаЗначений.Количество()-1 Цикл 
			Для Каждого Колонка из ТаблицаЗначений.Колонки Цикл
				СтрокаТаблицыЗначений = ТаблицаЗначений[Индекс];
				
				НоваяСтрока = ТаблицаЗначенийРеквизитов.Добавить();
				НоваяСтрока.ИмяТабличнойЧасти 	= СтрокаТаблицы.ИмяТабличнойЧасти; 
				НоваяСтрока.Имя					= Колонка.Имя; 
				НоваяСтрока.Значение 			= СтрокаТаблицыЗначений[Колонка.Имя];
				НоваяСтрока.НомерСтрокиТЧ		= Индекс+1;  
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	//Запись данных таблиц в исходную таблицу
	
КонецПроцедуры

&НаСервере
Процедура УдалитьСтрокиСПустымЗначением(ТаблицаЗначенийРеквизитов)
	
	УдаляемыеСтроки = Новый Соответствие;
	
	ОтборХранимыеДанные = Новый Структура;
	ОтборХранимыеДанные.Вставить("ИмяРеквизита", "ХранимыеДанныеСторонаПодписавшаяДокумент"); 
	
	ВремТаблицаЗначенийРеквизитов = ТаблицаЗначенийРеквизитов.Скопировать(); 
	
	//Удаляем из исходной таблицы все строки по именам табличных частей
	ТабличныеЧасти = ВремТаблицаЗначенийРеквизитов.Скопировать(ОтборХранимыеДанные); 
	ТабличныеЧасти.Свернуть("ИмяТабличнойЧасти");
	Для Каждого СтрокаТаблицы из ТабличныеЧасти Цикл
		СтруктураОтбора = Новый Структура;
		СтруктураОтбора.Вставить("ИмяТабличнойЧасти", СтрокаТаблицы.ИмяТабличнойЧасти);
		
		УдаляемыеСтроки = ТаблицаЗначенийРеквизитов.НайтиСтроки(СтруктураОтбора);
		Для Каждого УдаляемаяСтрока из УдаляемыеСтроки Цикл
			ТаблицаЗначенийРеквизитов.Удалить(УдаляемаяСтрока);	
		КонецЦикла;
	КонецЦикла;
	//---Удаляем из исходной таблицы все строки по именам табличных частей 
	
	//Подготовка таблиц по данным строк
	ПодготовленныеТаблицы = Новый Соответствие;
	
	Для Каждого СтрокаТаблицы из ТабличныеЧасти Цикл
		СтруктураОтбора = Новый Структура;
		СтруктураОтбора.Вставить("ИмяТабличнойЧасти", СтрокаТаблицы.ИмяТабличнойЧасти); 
		
		ТаблицаРеквизитов = ВремТаблицаЗначенийРеквизитов.Скопировать(СтруктураОтбора);
		ТаблицаРеквизитов.Свернуть("ИмяРеквизита");
		
		ТаблицаНомераСтрок = ВремТаблицаЗначенийРеквизитов.Скопировать(СтруктураОтбора);
		ТаблицаНомераСтрок.Свернуть("НомерСтрокиРеквизита");
		
		ТаблицаЗначений = Новый ТаблицаЗначений;
		Для каждого СтрокаТаблицыРеквизитов из ТаблицаРеквизитов Цикл
			ТаблицаЗначений.Колонки.Добавить(СтрокаТаблицыРеквизитов.ИмяРеквизита);	
		КонецЦикла;  
		
		Для Каждого СтрокаНомеров из ТаблицаНомераСтрок Цикл    
			СтруктураОтбора.Вставить("НомерСтрокиРеквизита", СтрокаНомеров.НомерСтрокиРеквизита); 
			
			НоваяСтрока = ТаблицаЗначений.Добавить();
			
			НайденныеСтроки = ВремТаблицаЗначенийРеквизитов.НайтиСтроки(СтруктураОтбора);
			Для Каждого СтрокаДанных из НайденныеСтроки Цикл
				НоваяСтрока[СтрокаДанных.ИмяРеквизита] = СтрокаДанных.ЗначениеРеквизита;	
			КонецЦикла;
		КонецЦикла;
		
		ПодготовленныеТаблицы.Вставить(СтрокаТаблицы.ИмяТабличнойЧасти, ТаблицаЗначений);  
	КонецЦикла;  
	//---Подготовка таблиц по данным строк
	
	//Удаление пустых строк
	Для Каждого СтрокаТаблицы из ТабличныеЧасти Цикл   
		ТаблицаЗначений = ПодготовленныеТаблицы.Получить(СтрокаТаблицы.ИмяТабличнойЧасти);
		
		УдаляемыеСтроки = Новый Массив;
		Для Каждого СтрокаТаблицыЗначений из ТаблицаЗначений Цикл
			Если ТипЗнч(СтрокаТаблицыЗначений.ХранимыеДанныеСторонаПодписавшаяДокумент) <> тип("Структура") Тогда   
				УдаляемыеСтроки.Добавить(СтрокаТаблицыЗначений);	
			КонецЕсли;
		КонецЦикла;
		
		Для Каждого УдаляемаяСтрока из УдаляемыеСтроки Цикл
			ТаблицаЗначений.Удалить(УдаляемаяСтрока);	
		КонецЦикла;
		
		ПодготовленныеТаблицы.Вставить(СтрокаТаблицы.ИмяТабличнойЧасти, ТаблицаЗначений);  
