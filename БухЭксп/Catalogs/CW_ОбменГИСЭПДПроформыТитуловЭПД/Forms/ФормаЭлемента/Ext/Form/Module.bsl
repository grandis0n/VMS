&НаСервере
Процедура ПоказатьУровеньГруппировокСтрокНаСервере(Индекс)
	ТабличныйДокумент.ПоказатьУровеньГруппировокСтрок(Индекс);  
КонецПроцедуры

&НаСервере
Функция ПолучитьИмяДокументаПоТипу()
	
	Возврат CW_ОбменГИСЭПДПереопределяемый.ИмяДокументаПоТипу(Объект.ТипДокументаЭПД);
	
КонецФункции

&НаКлиенте
Процедура СоздатьЗаполнитьЭПД(Команда) 
	
	Если Модифицированность Тогда
		ПоказатьПредупреждение(, "Перпед заполнением ЭПД необходимо записать элемент!");
		Возврат;
	КонецЕсли;

	Режим = РежимДиалогаВопрос.ДаНет;
	Оповещение = Новый ОписаниеОповещения("ПродолжитьСозданиеДокументаЭПД", ЭтотОбъект, Параметры);
	ПоказатьВопрос(Оповещение, "Будет заполнен документ ЭПД. Продолжить?", Режим, 0);
	
КонецПроцедуры  

&НаКлиенте
Процедура ПродолжитьСозданиеДокументаЭПД(Результат, ДоолнительныеПараметры) Экспорт
    Если Результат = КодВозвратаДиалога.Нет Тогда
        Возврат;
    КонецЕсли;

  	ИмяДокумента = ПолучитьИмяДокументаПоТипу();
	Если ИмяДокумента = Неопределено Тогда
		Возврат;
	КонецЕсли;  
	
	РезультатВыполнения =  НачатьЗаполнениеЭПДНаСервереВФоне(ДокументЭПД); 
	Если РезультатВыполнения = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ВыводитьОкноОжидания = Истина; 
	ОповещениеОЗавершении = Новый ОписаниеОповещения("ПослеЗаполненияЭПД", ЭтотОбъект); 
	ДлительныеОперацииКлиент.ОжидатьЗавершение(РезультатВыполнения, ОповещениеОЗавершении, ПараметрыОжидания); 
	
КонецПроцедуры

&НаСервере
Функция НачатьЗаполнениеЭПДНаСервереВФоне(ЭлектронныйПеревозочныйДокумент)
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(Новый УникальныйИдентификатор);
	ПараметрыВыполнения.ОжидатьЗавершение    = 0;  // запускать сразу  
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = "";  
	ПараметрыВыполнения.ЗапуститьВФоне		= Истина;  
	ПараметрыВыполнения.ЗапуститьНеВФоне    = ложь;  
	
	ПараметрыПроцедуры = ПодготовитьПараметрыПроцедуры(ЭлектронныйПеревозочныйДокумент);  
	Если ПараметрыПроцедуры = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат ДлительныеОперации.ВыполнитьВФоне("CW_ОбменГИСЭПДДополнительный.ЗаполнитьЭПД" ,ПараметрыПроцедуры, ПараметрыВыполнения);  	
	
КонецФункции  

&НаСервере
Функция ПодготовитьПараметрыПроцедуры(ЭлектронныйПеревозочныйДокумент)
	
	ПараметрыПроцедуры = Новый Структура; 
	
	тОбъект = РеквизитФормыВЗначение("Объект");
	ТаблицаЗначенийРеквизитов = тОбъект.ЗначенияРеквизитовДокументовЭПД.Получить();
	Если ТипЗнч(ТаблицаЗначенийРеквизитов) <> Тип("ТаблицаЗначений") Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ТекущийШагТитула = ТекущийШагТитула();  
	ТекущийШаг = ТекущийШагТитула.Получить(Объект.ТекущийТитул); 
	ТекущийШаг = ?(ТекущийШаг=Неопределено, "", ТекущийШаг);
	
	ПараметрыПроцедуры.Вставить("Дата",	ТекущаяДата());
	ПараметрыПроцедуры.Вставить("Организация",	Объект.Организация);
	ПараметрыПроцедуры.Вставить("СсылкаТитулГрузоотправителяГрузоотправитель",	Объект.СсылкаТитулГрузоотправителяГрузоотправитель);
	ПараметрыПроцедуры.Вставить("СсылкаТитулГрузоотправителяПеревозчик", 		Объект.СсылкаТитулГрузоотправителяПеревозчик);
	ПараметрыПроцедуры.Вставить("СсылкаТитулГрузоотправителяПеревозчик", 		Объект.СсылкаТитулГрузоотправителяПеревозчик);
	ПараметрыПроцедуры.Вставить("ТипДокументаЭПД", 	Объект.ТипДокументаЭПД);
	ПараметрыПроцедуры.Вставить("ЭлектронныйПеревозочныйДокумент", ЭлектронныйПеревозочныйДокумент);
	ПараметрыПроцедуры.Вставить("ТекущийШаг", 	ТекущийШаг); 
	
	ВерсияТитула = Новый Структура;
	ВерсияТитула.Вставить("Титул",				Объект.ТекущийТитул);
	ВерсияТитула.Вставить("НомерВерсии",		"");
	ВерсияТитула.Вставить("ИдентификаторФайла",	"");
	ВерсияТитула.Вставить("ВерсияТитула", 		0);   
	ВерсияТитула.Вставить("ДатаВерсии", 		Дата(1,1,1));   
	
	ПараметрыПроцедуры.Вставить("ВерсияТитула", 	ВерсияТитула);        
	ПараметрыПроцедуры.Вставить("ПрефиксТитула", 	ПрефиксТитула);        
	
	ПараметрыПроцедуры.Вставить("ТаблицаЗначенийРеквизитов", ТаблицаЗначенийРеквизитов);  
	
	Возврат ПараметрыПроцедуры;
	
КонецФункции    

&НаСервере
Функция ТекущийШагТитула()
	
	Соответствие = Новый Соответствие;
	Соответствие.Вставить(ПредопределенноеЗначение("Перечисление.ТипыЭлементовРегламентаЭДО.ЭЗЗ_Титул1"), "Оформление");
	Соответствие.Вставить(ПредопределенноеЗначение("Перечисление.ТипыЭлементовРегламентаЭДО.ЭЗЗ_Титул2"), "Подтвреждение");
	Соответствие.Вставить(ПредопределенноеЗначение("Перечисление.ТипыЭлементовРегламентаЭДО.ЭТрН_Титул1"), "Оформление");
	
	Возврат Соответствие;
	
КонецФункции

&НаКлиенте 
Процедура ПослеЗаполненияЭПД(РезультатВыполнения, Дополнительныепараметры) Экспорт
	
	Если РезультатВыполнения = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если РезультатВыполнения.Статус = "Выполнено" Тогда    
		
		ПослеЗаполненияЭПДНаСервере(РезультатВыполнения.АдресРезультата);   
		
		ПоказатьЗначение(, ДокументЭПД);
		
	ИначеЕсли РезультатВыполнения.Статус = "Ошибка" Тогда
		
		ТекстПредупреждения = "Информация об ошибке см. в журнале регистрации!";
		
		Если ТипЗнч(РезультатВыполнения.Сообщения) = Тип("ФиксированныйМассив") Тогда
			Для Каждого СообщениеВМассиве из РезультатВыполнения.Сообщения Цикл
				СообщениеВМассиве.Сообщить();
			КонецЦикла;
		КонецЕсли;
		
		ПоказатьПредупреждение(,ТекстПредупреждения,,"Ошибка формирования документов");  
		
	КонецЕсли;  
	
КонецПроцедуры  

&НаСервере
Процедура ПослеЗаполненияЭПДНаСервере(АдресРезультата)
	
	ЗаполненныйДокумент = ПолучитьИзВременногоХранилища(АдресРезультата);
	
	CW_ОбменГИСЭПДДополнительный.ДобавитьСвязанныйДокументЭПД(Объект.Ссылка, ЗаполненныйДокумент);
	ДокументЭПД = CW_ОбменГИСЭПДДополнительный.ПолучитьСвязанныйДокументЭПД(Объект.Ссылка);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьЭПД(Команда)   

	Режим = РежимДиалогаВопрос.ДаНет;
	Оповещение = Новый ОписаниеОповещения("ПродолжитьЗаполнениеЭПД", ЭтотОбъект);
	ПоказатьВопрос(Оповещение, "Данные документа будут перезаполнены. 
							   |Продолжить?", Режим, 0);
	
КонецПроцедуры  

&НаКлиенте
Процедура ПродолжитьЗаполнениеЭПД(Результата, ДополнительныеПараметры) Экспорт
    Если Результата = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли; 
	
	РезультатВыполнения =  ПродолжитьЗаполнениеЭПДВФонеНаСервере();
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ВыводитьОкноОжидания = Истина; 
	ОповещениеОЗавершении = Новый ОписаниеОповещения("ПослеПолученияДанныхЭПД", ЭтотОбъект); 
	ДлительныеОперацииКлиент.ОжидатьЗавершение(РезультатВыполнения, ОповещениеОЗавершении, ПараметрыОжидания); 	
	
КонецПроцедуры 

&НаСервере
Функция ПолучитьИдентификаторОбъектаМетаданных(ТипПараметраКоманды)

	Возврат ОбщегоНазначения.ИдентификаторОбъектаМетаданных(ТипПараметраКоманды);
	
КонецФункции

&НаСервере     
Функция ПродолжитьЗаполнениеЭПДВФонеНаСервере() 
	
	ТипОбъекта = ПолучитьИдентификаторОбъектаМетаданных(ТипЗнч(Объект.ОбъектОснование));
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(Новый УникальныйИдентификатор);
	ПараметрыВыполнения.ОжидатьЗавершение    = 0;  // запускать сразу  
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = "";  
	ПараметрыВыполнения.ЗапуститьВФоне     = Истина;  
	ПараметрыВыполнения.ЗапуститьНеВФоне    = ложь;   
	
	РезультатВыбора = Новый Структура;
	РезультатВыбора.Вставить("ТипДокументаЭПД", Объект.ТипДокументаЭПД);
	РезультатВыбора.Вставить("ТекущийТитул", 	Объект.ТекущийТитул);
	РезультатВыбора.Вставить("ТипОбъекта",  	ТипОбъекта);
	РезультатВыбора.Вставить("ДокументЭПД", 	Объект.Ссылка);

	ПараметрыПроцедуры = Новый Структура;
	ПараметрыПроцедуры.Вставить("ПараметрКоманды", Объект.ОбъектОснование);
	ПараметрыПроцедуры.Вставить("РезультатВыбора", РезультатВыбора);
	
	Возврат ДлительныеОперации.ВыполнитьВФоне("CW_ОбменГИСЭПДДополнительный.ПолучитьДанныеДокументаЭПД" ,ПараметрыПроцедуры, ПараметрыВыполнения);  
	
КонецФункции    

&НаКлиенте 
Процедура ПослеПолученияДанныхЭПД(РезультатВыполнения, Дополнительныепараметры) Экспорт
	
	Если РезультатВыполнения.Статус = "Выполнено" Тогда    
		
		РезультатВыполненя = ПолучитьИзВременногоХранилища(РезультатВыполнения.АдресРезультата);
		Если ТипЗнч(РезультатВыполненя) <> тип("Структура") Тогда
			Возврат;
		КонецЕсли;   
		
		ВывестиТабличныйДокументНаФорму(РезультатВыполненя.Макет);
		ДанныеКонтактнойИнформации = Новый ФиксированнаяСтруктура(РезультатВыполненя.КонтактнаяИнформация);	
		
	ИначеЕсли РезультатВыполнения.Статус = "Ошибка" Тогда
		
		ТекстПредупреждения = "Информация об ошибке см. в журнале регистрации!";
		
		Если ТипЗнч(РезультатВыполнения.Сообщения) = Тип("ФиксированныйМассив") Тогда
			
			Для Каждого СообщениеВМассиве из РезультатВыполнения.Сообщения Цикл
				СообщениеВМассиве.Сообщить();
			КонецЦикла;
			
		КонецЕсли;
		
		ПоказатьПредупреждение(,ТекстПредупреждения,,"Ошибка формирования документов");  
		
	КонецЕсли;  
	
КонецПроцедуры



  