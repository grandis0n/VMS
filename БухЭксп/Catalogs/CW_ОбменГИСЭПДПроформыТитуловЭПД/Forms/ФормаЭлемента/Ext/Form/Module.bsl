&НаКлиенте
Процедура ОбработатьИзменнениеОбластиГрузоотправительЯвляетсяГрузополучателем_ЭТрН_Титул1()
	
	Типы = Новый Массив;   
	
	ОбластьЯвляетсяГрузополучателем = ТабличныйДокумент.Области.Найти("ГрузоотправительЯвляетсяГрузополучателем");
	Если ОбластьЯвляетсяГрузополучателем.значение = "V" Тогда
		Типы.Добавить(Тип("СправочникСсылка.Организации"));	
		
		ОбластьГрузоотправитель = ТабличныйДокумент.Области.Найти("СсылкаТитулГрузоотправителяГрузоотправитель"); 
		Грузоотправитель = ОбластьГрузоотправитель.Значение;
		
	Иначе
		Типы.Добавить(Тип("СправочникСсылка.Контрагенты"));	
		
		Грузоотправитель = ПредопределенноеЗначение("Справочник.Контрагенты.ПустаяСсылка");
	КонецЕсли;   
	
	ОбластьГрузополучатель = ТабличныйДокумент.Области.Найти("СсылкаТитулГрузоотправителяГрузополучатель");
	ОбластьГрузополучатель.ТипЗначения 	= Новый ОписаниеТипов(Типы);  
	ОбластьГрузополучатель.Значение 	= Грузоотправитель;
	
	ОбластьИмя = "ПредставлениеТитулГрузоотправителяГрузополучательАдресДоставки";

	ОбластьАдресДоставки = ТабличныйДокумент.Области.Найти(ОбластьИмя); 
	Если Не ЗначениеЗаполнено(ОбластьАдресДоставки.Значение) Тогда 
		ДанныеАдреса = ПолучитьФактическийНаСервере(Грузоотправитель);
		
		ДополнительныеПараметры = Новый Структура;               
		ДополнительныеПараметры.Вставить("ОбластьИмя", ОбластьИмя);  
		
		Оповещение = Новый ОписаниеОповещения("ВводАдреса_Завершение", ЭтотОбъект, ДополнительныеПараметры);
		
		ВыполнитьОбработкуОповещения(Оповещение, ДанныеАдреса);
		
	Конецесли;

	УстановитьДоступностьОбластиГрузоплучатель_ЭТрН_Титул1();
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьДоступностьОбластиГрузоплучатель_ЭТрН_Титул1()
	
	ОбластьЯвляетсяГрузополучателем = ТабличныйДокумент.Области.Найти("ГрузоотправительЯвляетсяГрузополучателем");
	УстановитьЗащиту = (ОбластьЯвляетсяГрузополучателем.значение = "V");
	
	ОбластьГрузополучатель = ТабличныйДокумент.Области.Найти("СсылкаТитулГрузоотправителяГрузополучатель");
	ОбластьГрузополучатель.Защита 	= УстановитьЗащиту;   
	ОбластьГрузополучатель.ЦветФона = ?(УстановитьЗащиту, Новый Цвет, Новый Цвет(255, 255, 192));

КонецПроцедуры    
 
