	ПредставленияРеквизитов.Вставить("СпособУпаковки",					"Способ упаковки");
	ПредставленияРеквизитов.Вставить("КодТоварнойНоменклатуры",			"Код товарной номенклатуры");
	ПредставленияРеквизитов.Вставить("Плотность",						"Плотность");
	
	ТаблицаХранимыхДанных	= Новый ТаблицаЗначений;
	ТаблицаХранимыхДанных.Колонки.Добавить("ИмяТабличнойЧасти");
	ТаблицаХранимыхДанных.Колонки.Добавить("ИмяРеквизита");
	ТаблицаХранимыхДанных.Колонки.Добавить("НомерСтроки");
	ТаблицаХранимыхДанных.Колонки.Добавить("Значение");
	
	Для Каждого Область из ТабличныйДокумент.Области Цикл
		Если СтрНачинаетсяС(Область.Имя, ПрефиксТитула+"Грузы")
			ИЛИ СтрНачинаетсяС(Область.Имя, ПрефиксТитула+"ОписаниеГруза") Тогда  
			
			ЧастиИмени = СтрРазделить(Область.Имя, "_");  
			
			ПредставлениеРеквизита = ПредставленияРеквизитов.Получить(ЧастиИмени[1]);   
			Если ПредставлениеРеквизита = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			НоваяСтрока = ТаблицаХранимыхДанных.Добавить();
			НоваяСтрока.ИмяТабличнойЧасти 	= ЧастиИмени[0];
			НоваяСтрока.ИмяРеквизита 		= ЧастиИмени[1];
			НоваяСтрока.НомерСтроки 		= ЧастиИмени[2];  
			НоваяСтрока.Значение 			= Область.Значение;   
			
		КонецЕсли;
	КонецЦикла;  
	
	ТаблицаНомераСтрок = ТаблицаХранимыхДанных.Скопировать();
	ТаблицаНомераСтрок.Свернуть("НомерСтроки"); 
	
	Для Каждого СтрокаТаблицы из ТаблицаНомераСтрок Цикл  
		
		Отбор = Новый Структура;
		Отбор.Вставить("НомерСтроки",СтрокаТаблицы.НомерСтроки);
		
		НайденныеСтроки = ТаблицаХранимыхДанных.НайтиСтроки(Отбор);
	
		ХранимыеДанные = СтруктураХранимыхДанных();
		ХранимыеДанные.ГруппаДанных = "Груз"; 
		ХранимыеДанные.Тип 			= "Груз"; 
		ХранимыеДанные.ИмяОбъекта 	= "Документ."+ИмяДокумента; 
		
		Для Каждого СтрокаХранимыхДанных из НайденныеСтроки Цикл
			НоваяСтрока = ХранимыеДанные.Данные.Добавить();
			НоваяСтрока.Имя 			= СтрокаХранимыхДанных.ИмяРеквизита;
			НоваяСтрока.Представление 	= ПредставленияРеквизитов.Получить(СтрокаХранимыхДанных.ИмяРеквизита);
			НоваяСтрока.Значение 		= СтрокаХранимыхДанных.Значение;
		КонецЦикла;
		
		УдалитьПустыеХранимыеДанныеСторонаПодписавшаяДокумент(ХранимыеДанные.Данные);
		
		Если ХранимыеДанные.Данные.Количество() > 0 Тогда
			ДанныеСтроки = ПустаяСтруктураДанныхСтроки();
			ДанныеСтроки.ИмяРеквизита 			= "ХранимыеДанныеГруз"; 
			ДанныеСтроки.ЗначениеРеквизита 		= ХранимыеДанные;
			ДанныеСтроки.ИмяТабличнойЧасти 		= НайденныеСтроки[0].ИмяТабличнойЧасти;  
			ДанныеСтроки.НомерСтрокиРеквизита 	= СтрокаТаблицы.НомерСтроки;  
			
			ЗаписатьЗначениеОбластиВТаблицу(ТаблицаЗначенийРеквизитов, ДанныеСтроки);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьХранимыеДанныеМедработика(ТаблицаЗначенийРеквизитов, ИмяДокумента, ПрефиксТитула, ИмяГруппы)

	ОбластиХранимыхДанных = Новый Массив;
	ОбластиХранимыхДанных.Добавить("МедорганизацияНаименование"); 
	ОбластиХранимыхДанных.Добавить("Фамилия"); 
	ОбластиХранимыхДанных.Добавить("Имя"); 
	ОбластиХранимыхДанных.Добавить("Отчество");
	ОбластиХранимыхДанных.Добавить("Должность");
	ОбластиХранимыхДанных.Добавить("ЛицензияСерия");     
	ОбластиХранимыхДанных.Добавить("ЛицензияНомер");     
	ОбластиХранимыхДанных.Добавить("ЛицензияДатаВыдачи");     
	ОбластиХранимыхДанных.Добавить("ЛицензияСрокОкончания");     
	
	ПредставленияРеквизитов = Новый Соответствие; 
	ПредставленияРеквизитов.Вставить("МедорганизацияНаименование", "Наименование мед.органиазции"); 
	ПредставленияРеквизитов.Вставить("Фамилия", "Фамилия"); 
	ПредставленияРеквизитов.Вставить("Имя", "Имя"); 
	ПредставленияРеквизитов.Вставить("Отчество", "Отчество");
	ПредставленияРеквизитов.Вставить("Должность", "Должность");
	ПредставленияРеквизитов.Вставить("ЛицензияСерия","Лицензия серия");     
	ПредставленияРеквизитов.Вставить("ЛицензияНомер", "Лицензия номер");     
	ПредставленияРеквизитов.Вставить("ЛицензияДатаВыдачи", "Лицензия дата выдачи");     
	ПредставленияРеквизитов.Вставить("ЛицензияСрокОкончания","Лицензия срок окончания");     
	
	ХранимыеДанные = СтруктураХранимыхДанных();
	ХранимыеДанные.ГруппаДанных = ПрефиксТитула+ИмяГруппы; 
	ХранимыеДанные.Тип 			= ИмяГруппы; 
	ХранимыеДанные.ИмяОбъекта 	= "Документ."+ИмяДокумента; 
	
	Для Каждого ИмяОбласти из ОбластиХранимыхДанных Цикл
		Область = ТабличныйДокумент.Области.Найти(ПрефиксТитула+ИмяГруппы+ИмяОбласти);
		Если Область = Неопределено Тогда 
			Продолжить;
		КонецЕсли; 
		
		НоваяСтрока = ХранимыеДанные.Данные.Добавить();
		НоваяСтрока.Имя 			= ИмяОбласти;
		НоваяСтрока.Представление 	= ПредставленияРеквизитов.Получить(ИмяОбласти);
		НоваяСтрока.Значение 		= Область.Значение;
	КонецЦикла;
	
	УдалитьПустыеХранимыеДанныеСторонаПодписавшаяДокумент(ХранимыеДанные.Данные);
	
	Если ХранимыеДанные.Данные.Количество() > 0 Тогда
		ДанныеСтроки = ПустаяСтруктураДанныхСтроки();
		ДанныеСтроки.ИмяРеквизита 			= "ХранимыеДанные"+ПрефиксТитула+ИмяГруппы; 
		ДанныеСтроки.ЗначениеРеквизита 		= ХранимыеДанные;
		
		ЗаписатьЗначениеОбластиВТаблицу(ТаблицаЗначенийРеквизитов, ДанныеСтроки);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция СтруктураХранимыхДанных()
	
	ТипСтрока = Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(255));
	ТипЧисло = Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(10));
	
	Данные = Новый ТаблицаЗначений;
	Данные.Колонки.Добавить("Имя",				 ТипСтрока);
	Данные.Колонки.Добавить("Представление",	 ТипСтрока);
	Данные.Колонки.Добавить("Значение");
	Данные.Колонки.Добавить("ИмяТабличнойЧасти", ТипСтрока);
	Данные.Колонки.Добавить("НомерСтрокиТЧ",	 ТипЧисло);

	СтрукутраХранимыхДанных = Новый Структура;     
	СтрукутраХранимыхДанных.Вставить("ГруппаДанных", 	"");
	СтрукутраХранимыхДанных.Вставить("Тип", 			"");
	СтрукутраХранимыхДанных.Вставить("ИмяОбъекта",		"");
	СтрукутраХранимыхДанных.Вставить("Контрагент",		Неопределено);
	СтрукутраХранимыхДанных.Вставить("Данные",			Данные);
	
	Возврат СтрукутраХранимыхДанных;	
	
КонецФункции  


&НаКлиенте
Процедура ТипДокументаЭПДПриИзменении(Элемент)
	ТипДокументаЭПДПриИзмененииНаСервере();
КонецПроцедуры

&НаСервере
Процедура ТипДокументаЭПДПриИзмененииНаСервере()
	
	Объект.ВидДокумента = ЭлектронныеДокументыЭДО.ВидДокументаПоТипу(Объект.ТипДокументаЭПД);
	
	CW_ОбменГИСЭПДДополнительный.УстановитьСписокВыбораТитула(ЭтотОбъект);

	ИмяДокументаПоТипу = CW_ОбменГИСЭПДПереопределяемый.ИмяДокументаПоТипу(Объект.ТипДокументаЭПД);
	
	ДоступныеТипы = Новый Массив;
	ДоступныеТипы.Добавить(Тип("ДокументСсылка."+ИмяДокументаПоТипу));
	
	ОграничениеТипа = Новый ОписаниеТипов(ДоступныеТипы);
	
	Элементы.ДокументЭПД.ОграничениеТипа = ОграничениеТипа;   
	
	Если ДокументЭПД = Неопределено Тогда
		ДокументЭПД = ОграничениеТипа.ПривестиЗначение(Неопределено);  
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТекущийТитулПриИзменении(Элемент)
	
	ТекущийТитулПриИзмененииНаСервере(); 
	
	Если Объект.ТекущийТитул = ПредопределенноеЗначение("Перечисление.ТипыЭлементовРегламентаЭДО.ЭТрН_Титул1") Тогда
		ОбработатьИзменнениеОбластиГрузоотправительЯвляетсяГрузополучателем_ЭТрН_Титул1();
		ОбработатьИзменнениеОбластиЛицоОсуществляющееПогрузкуЯвляетсяГрузоотправителем_ЭТрН_Титул1();	
		ОбработатьИзменнениеОбластиВариантОснованияПолномочий_ЭТрН_Титул1(); 
	КонецЕсли;   
	
	Если Объект.ТекущийТитул = ПредопределенноеЗначение("Перечисление.ТипыЭлементовРегламентаЭДО.ЭПЛ_Титул1") Тогда
		ТекущийТитулПриИзменении_ОбработатьИзменнениеОбласти_ЭПЛ_Титул1();
	КонецЕсли;   
	Если Объект.ТекущийТитул = ПредопределенноеЗначение("Перечисление.ТипыЭлементовРегламентаЭДО.ЭПЛ_Титул2") Тогда
		ТекущийТитулПриИзменении_ОбработатьИзменнениеОбласти_ЭПЛ_Титул2();
	КонецЕсли;   
	
КонецПроцедуры 

&НаСервере
Процедура ТекущийТитулПриИзмененииНаСервере()    
	
	ПараметрыДокументаЭПД = ПараметрыДокументовЭПД.Получить(Объект.ТипДокументаЭПД); 
	Если ТипЗнч(ПараметрыДокументаЭПД) = Тип("ФиксированнаяСтруктура") тогда 
		
		ИнформацияПоПрефиксамТитула = CW_ОбменГИСЭПДПереопределяемый.ПрефиксТитулаПоЭлементуРегламентаЭДО(Объект.ТекущийТитул);
		ПрефиксТитула = ИнформацияПоПрефиксамТитула.ВПрограмме;
		
		ИмяМакета 	= ПараметрыДокументаЭПД["Макеты"].Получить(Объект.ТекущийТитул); 
		Макет 		= CW_ОбменГИСЭПДСерверВызовСервера.ПолучитьМакетЭлектронногоПеревозочногоДокумента(ИмяМакета);    
		
		ТабличныйДокумент.Очистить();
		ТабличныйДокумент.Вывести(Макет); 
		
		ТабличныйДокумент.ПоказатьУровеньГруппировокСтрок(0);  
		
		Для каждого Область из ТабличныйДокумент.Области Цикл
			Если СтрНачинаетсяС(Область.Имя, "УдалитьСтроку") Тогда
				Область.Гиперссылка = Ложь;
				Область.Текст = "";  
			КонецЕсли; 
		КонецЦикла;   
		
		Если Объект.ТекущийТитул = Перечисления.ТипыЭлементовРегламентаЭДО.ЭЗЗ_Титул1 Тогда
			ОбластьТитулГрузоотправителяЗаказДата = ТабличныйДокумент.Область("ТитулГрузоотправителяЗаказДата");
			ОбластьТитулГрузоотправителяЗаказДата.Значение = ТекущаяДатаСеанса();  
			
			АдресаПунктовПогрузкиИВыгрузкиНомерПп = ТабличныйДокумент.Область("ТитулГрузоотправителяАдресаПунктовПогрузкиИВыгрузки_НомерПп_1");
			АдресаПунктовПогрузкиИВыгрузкиНомерПп.Значение = 1;  
			
			ОбработатьИзменнениеОбластиПоДоверенностиГрузоотправителя_ЭЗЗ_Титул1();
			
			УстановитьФункцииДокумента("Заказ");
		КонецЕсли; 
		
		Если Объект.ТекущийТитул = Перечисления.ТипыЭлементовРегламентаЭДО.ЭТрН_Титул1 Тогда
			ОбработатьИзменнениеОбластиПоДоверенностиГрузоотправителя_ЭТрН_Титул1(); 
			ОбработатьИзменнениеОбластиТитулГрузоотправителяЭкспедитор_ЭТрН_Титул1();
		КонецЕсли;  
		Если Объект.ТекущийТитул = Перечисления.ТипыЭлементовРегламентаЭДО.ЭЗЗ_Титул2 Тогда
			ОбработатьИзменнениеОбластиВариантПоДоверенностиЗаПеревозчика_ЭЗЗ_Титул2();
		КонецЕсли;   
		

		CW_ОбменГИСЭПДДополнительный.УстановитьИдентификаторыСтрок(Объект.ТекущийТитул, ТабличныйДокумент, "_1");
		CW_ОбменГИСЭПДДополнительный.УстановитьИдентификаторыСтрок(Объект.ТекущийТитул, ТабличныйДокумент, "_2");
		CW_ОбменГИСЭПДДополнительный.УстановитьИдентификаторыСтрок(Объект.ТекущийТитул, ТабличныйДокумент, "_3");
		
		
	КонецЕсли;  
	
КонецПроцедуры

&НаКлиенте
Процедура ТабличныйДокументВыбор(Элемент, Область, СтандартнаяОбработка)
	
	Если Элементы.ТабличныйДокумент.Защита Тогда
		Возврат;
	КонецЕсли;
	
	Если СтрЧислоВхождений(Область.Имя, "ДобавитьСтроку") = 1 И Область.Текст <> "" Тогда
		ДобавитьСтроку();
		Возврат;
	ИначеЕсли СтрЧислоВхождений(Область.Имя, "УдалитьСтроку") = 1 И Область.Текст <> "" Тогда
		УдалитьСтроку();
		Возврат;
	КонецЕсли;    
	
	ИмяОбластиБезПрефикса = CW_ОбменГИСЭПДСерверВызовСервера.ИмяОбластиБезПрефикса(Область.Имя);  
	
	мОбластиБулево	= CW_ОбменГИСЭПДСерверВызовСервера.СписокОбластейТипБлево(Объект.ТекущийТитул);
	Если мОбластиБулево.Найти(ИмяОбластиБезПрефикса) <> Неопределено Тогда
		Область.Значение = ?(ПустаяСтрока(Область.значение), "V", ""); 
	КонецЕсли;  
	
	мОбластиАдресов	= CW_ОбменГИСЭПДСерверВызовСервера.СписокОбластейАдресов(Объект.ТекущийТитул);    
	Если мОбластиАдресов.Найти(ИмяОбластиБезПрефикса) <> Неопределено Тогда
		//Нужно показать форму ввода адреса
		ВводАдреса(Область.Имя);
		Возврат;
	КонецЕсли; 
	
	СпискиВыбора = CW_ОбменГИСЭПДСерверВызовСервера.ПолучитьСпискиВыбораЗначенияТекущегоТитула(Объект.ТекущийТитул);
	
	СписокВыбора = СпискиВыбора.Получить(ИмяОбластиБезПрефикса); 
	Если СписокВыбора = Неопределено 
		И (ИмяОбластиБезПрефикса = "ТитулГрузоотправителяГрузыПунктыПогрузкиВыгрузки_ПунктПогрузки"
		или ИмяОбластиБезПрефикса = "ТитулГрузоотправителяГрузыПунктыПогрузкиВыгрузки_ПунктВыгрузки") Тогда 
		СписокВыбора = ПолучитьсписокАдресовПунктов();
	КонецЕсли;
	
	Если СписокВыбора <> Неопределено Тогда
		ТекущийЭлементСписка = СписокВыбора.НайтиПоЗначению(Область.Значение);
		
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("ИмяОбласти", Область.Имя);
		
		Оповещение = Новый ОписаниеОповещения("ПослеВыбораИзСписка", ЭтотОбъект, ДополнительныеПараметры);
		
		ПоказатьВыборИзМеню(Оповещение, СписокВыбора, Элемент); 
		Возврат;
	КонецЕсли;  
	
	Если Объект.ТекущийТитул = ПредопределенноеЗначение("Перечисление.ТипыЭлементовРегламентаЭДО.ЭЗЗ_Титул1") Тогда 
		
		Если Область.Имя = "ВариантПоДоверенностиЗаГрузоотправителя" Тогда
			ОбработатьИзменнениеОбластиПоДоверенностиГрузоотправителя_ЭЗЗ_Титул1();
			Модифицированность = Истина;
		КонецЕсли;  
		
		Если СтрНачинаетсяС(Область.Имя, "ТитулГрузоотправителяГрузы_ВидТары") Тогда
			ДополнительныеПараметры = Новый Структура;
			ДополнительныеПараметры.Вставить("ИмяОбласти", Область.Имя);
			
			Оповещение = Новый ОписаниеОповещения("ПослеВыбораИзСправочника", ЭтотОбъект, ДополнительныеПараметры);
			
			ОткрытьФорму("Справочник.КлассификаторУпаковкиЭПД.ФормаВыбора", ,ЭтаФорма,,,,Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		КонецЕсли;  
		
	КонецЕсли;
	
	Если Объект.ТекущийТитул = ПредопределенноеЗначение("Перечисление.ТипыЭлементовРегламентаЭДО.ЭЗЗ_Титул2") Тогда 
		
		Если Область.Имя = "ВариантПоДоверенностиЗаПеревозчика" Тогда
			ОбработатьИзменнениеОбластиВариантПоДоверенностиЗаПеревозчика_ЭЗЗ_Титул2();
			Модифицированность = Истина;   
		КонецЕсли;     
		
		Если Область.Имя = "СсылкаТитулПеревозчикаВалютаСтоимости" Тогда   
			
			ДополнительныеПараметры = Новый Структура;
			ДополнительныеПараметры.Вставить("ИмяОбласти", Область.Имя);
			
			Оповещение = Новый ОписаниеОповещения("ПослеВыбораИзСправочника", ЭтотОбъект, ДополнительныеПараметры);
			
			СтруктураПараметров = Новый Структура;
			СтруктураПараметров.Вставить("РежимВыбора", 		Истина);
			СтруктураПараметров.Вставить("ЗакрыватьПриВыборе", 	Истина);
			СтруктураПараметров.Вставить("МножественныйВыбор", 	Ложь);
			
			ОткрытьФорму("Справочник.Валюты.ФормаВыбора", СтруктураПараметров ,ЭтаФорма,,,,Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);    
		КонецЕсли;
		
	КонецЕсли; 
	
	Если Объект.ТекущийТитул = ПредопределенноеЗначение("Перечисление.ТипыЭлементовРегламентаЭДО.ЭТрН_Титул1") Тогда 
		
		Если Область.Имя = "ВариантПоДоверенности"	Тогда
			ОбработатьИзменнениеОбластиПоДоверенностиГрузоотправителя_ЭТрН_Титул1();
			Модифицированность = Истина;
		КонецЕсли;  
		Если Область.Имя = "ТитулГрузоотправителяЭкспедитор"	Тогда
			ОбработатьИзменнениеОбластиТитулГрузоотправителяЭкспедитор_ЭТрН_Титул1();
			Модифицированность = Истина;
		КонецЕсли;  
		Если Область.Имя = "ГрузоотправительЯвляетсяГрузополучателем"	Тогда
			ОбработатьИзменнениеОбластиГрузоотправительЯвляетсяГрузополучателем_ЭТрН_Титул1();
			Модифицированность = Истина;
		КонецЕсли;  
		
	КонецЕсли;  
	
	
КонецПроцедуры 

&НаКлиенте
Процедура ТабличныйДокументПриИзмененииСодержимогоОбласти(Элемент, Область, ДополнительныеПараметры)
	
	Если Элементы.ТабличныйДокумент.Защита Тогда
		Возврат;
	КонецЕсли; 
	
	Если Объект.ТекущийТитул = ПредопределенноеЗначение("Перечисление.ТипыЭлементовРегламентаЭДО.ЭЗЗ_Титул1") Тогда 
		Если СтрНачинаетсяС(Область.Имя, "ТитулГрузоотправителяАдресаПунктовПогрузкиИВыгрузки_ВладелецПунктаПогрузкиНаименование") Тогда
			ЧастиИмени  = СтрРазделить(Область.Имя,"_");
			ТекИндекс 	= "_"+ЧастиИмени[2];
			
			ОбластьИННИмя = "ТитулГрузоотправителяАдресаПунктовПогрузкиИВыгрузки_ВладелецПунктаПогрузкиИНН"+ТекИндекс;	
			
			ОбластьИНН = ТабличныйДокумент.Области.Найти(ОбластьИННИмя);  
			Если ОбластьИНН <> Неопределено Тогда
				ОбластьИНН.ЗНачение = ПолучитьИНН(Область.Значение);
			КонецЕсли;
			
			ЭтаФорма.Модифицированность = Истина;
			
		КонецЕсли;
	КонецЕсли;  
	
	Если Объект.ТекущийТитул = ПредопределенноеЗначение("Перечисление.ТипыЭлементовРегламентаЭДО.ЭТрН_Титул1") Тогда 
		Если СтрНачинаетсяС(Область.Имя, "ТитулГрузоотправителяСведенияОбОпасныхГрузах_СсылкаДОПОГ") Тогда
			ЧастиИмени  = СтрРазделить(Область.Имя,"_");
			ТекИндекс 	= "_"+ЧастиИмени[2];
			
			ОбластьИмяНомерООН = "ТитулГрузоотправителяСведенияОбОпасныхГрузах_НомерООН"+ТекИндекс;	
			
			ОбластьНомерООН = ТабличныйДокумент.Области.Найти(ОбластьИмяНомерООН);  
			Если ОбластьНомерООН <> Неопределено Тогда
				ОбластьНомерООН.ЗНачение = ПолучитьКодЭлементаНаСервере(Область.Значение);
			КонецЕсли;
			
			ЭтаФорма.Модифицированность = Истина;
			
		КонецЕсли;  
		
	КонецЕсли;  
	
КонецПроцедуры 

