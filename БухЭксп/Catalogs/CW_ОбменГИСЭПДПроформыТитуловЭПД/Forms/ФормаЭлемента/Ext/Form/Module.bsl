&НаСервере
Функция ПолучитьХранимыеДанныеСторонаПодписавшаяДокумент(ИмяДокумента, Область)
	
	Если Не ЗначениеЗаполнено(Область.Значение) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ПараметрыСтороныПодписавшейДокумент = ПараметрыСтороныПодписавшейДокумент(); 
	ЗначенияРеквизитов 		= ПараметрыСтороныПодписавшейДокумент["ЗначенияРеквизитов"];
	ПредставленияРеквизитов = ПараметрыСтороныПодписавшейДокумент["ПредставленияРеквизитов"];
	
	ИННКонтрагента =  ПолучитьИНН(Область.Значение); 
	Если СтрДлина(ИННКонтрагента) = 12 Тогда
		ЗначенияРеквизитов.ФЛ_ИНН = ИННКонтрагента;
		ЗначенияРеквизитов.ЮЛ_ИНН  = "";
	ИначеЕсли СтрДлина(ИННКонтрагента) <= 10 Тогда
		ЗначенияРеквизитов.ФЛ_ИНН = "";
		ЗначенияРеквизитов.ЮЛ_ИНН = ИННКонтрагента;	
	КонецЕсли;   
	
	//Запись хранимых данных
	ХранимыеДанные = СтруктураХранимыхДанных();
	ХранимыеДанные.ГруппаДанных = "СторонаПодписавшаяДокумент";
	ХранимыеДанные.Тип 			= "СторонаПодписавшаяДокумент";
	ХранимыеДанные.ИмяОбъекта 	= "Документ."+ИмяДокумента;
	
	Для Каждого КлючЗначение из ЗначенияРеквизитов Цикл
		СтрокаДанных = ХранимыеДанные.Данные.Добавить();    
		СтрокаДанных.Имя			= КлючЗначение.Ключ;
		СтрокаДанных.Представление 	= ПредставленияРеквизитов.Получить(КлючЗначение.Ключ);
		СтрокаДанных.Значение 		= КлючЗначение.Значение;
	КонецЦикла; 
	
	Возврат ХранимыеДанные;

КонецФункции

&НаСервере
Функция ПараметрыСтороныПодписавшейДокумент()
	
	ЗначенияРеквизитов = Новый Структура;
	ЗначенияРеквизитов.Вставить("ИнострЛицоБезУчетаВидУдостоверения");
	ЗначенияРеквизитов.Вставить("ИнострЛицоБезУчетаДатаВыдачиУдостоверения");
	ЗначенияРеквизитов.Вставить("ИнострЛицоБезУчетаИдентификатор");
	ЗначенияРеквизитов.Вставить("ИнострЛицоБезУчетаИныеСведения");
	ЗначенияРеквизитов.Вставить("ИнострЛицоБезУчетаНаименование");
	ЗначенияРеквизитов.Вставить("ИнострЛицоБезУчетаНомерУдостоверения");
	ЗначенияРеквизитов.Вставить("ИнострЛицоБезУчетаСтатусИО_ИГ");
	ЗначенияРеквизитов.Вставить("ИнострЛицоБезУчетаСтрана");
	ЗначенияРеквизитов.Вставить("НадписьПоясненияНекорректногоИНН");
	ЗначенияРеквизитов.Вставить("ОрганВластиВыдавшийДокумент");
	ЗначенияРеквизитов.Вставить("РФИлиНет");
	ЗначенияРеквизитов.Вставить("ФЛ_ИНН");
	ЗначенияРеквизитов.Вставить("ЮЛ_ИНН	");   
	
	//Сторона подписавшая документ  
	ПредставленияРеквизитов = Новый Соответствие;
	ПредставленияРеквизитов.Вставить("РФИлиНет",									"РФИли нет");
	ПредставленияРеквизитов.Вставить("НадписьПоясненияНекорректногоИНН",			"");
	ПредставленияРеквизитов.Вставить("ОрганВластиВыдавшийДокумент",					"Наименование госоргана");
	ПредставленияРеквизитов.Вставить("ИнострЛицоБезУчетаСтатусИО_ИГ",				"Идентификация статуса");
	ПредставленияРеквизитов.Вставить("ИнострЛицоБезУчетаСтрана",					"Страна");
	ПредставленияРеквизитов.Вставить("ИнострЛицоБезУчетаНаименование",				"Наименование (ФИО)");
	ПредставленияРеквизитов.Вставить("ИнострЛицоБезУчетаИдентификатор",				"Идентификатор иностранной лица");
	ПредставленияРеквизитов.Вставить("ИнострЛицоБезУчетаВидУдостоверения",			"Вид документа");
	ПредставленияРеквизитов.Вставить("ИнострЛицоБезУчетаНомерУдостоверения",		"Номер документа");
	ПредставленияРеквизитов.Вставить("ИнострЛицоБезУчетаДатаВыдачиУдостоверения",	"Дата выдачи документа");
	ПредставленияРеквизитов.Вставить("ИнострЛицоБезУчетаИныеСведения",				"Иные сведения");
	ПредставленияРеквизитов.Вставить("ЮЛ_ИНН",	"ИНН организации, состоящей на учете в налоговом органе");
	ПредставленияРеквизитов.Вставить("ФЛ_ИНН",	"ИНН физического лица, в том числе индивидуального предпринимателя");
	
	Структура = Новый Структура;
	Структура.Вставить("ЗначенияРеквизитов",	 	ЗначенияРеквизитов);
	Структура.Вставить("ПредставленияРеквизитов", 	ПредставленияРеквизитов);

	Возврат Структура;

КонецФункции

&НаСервере
Функция ПустаяСтруктураДанныхСтроки()
	
	ДанныеСтроки = Новый Структура;
	ДанныеСтроки.Вставить("ИмяТабличнойЧасти", 		"");
	ДанныеСтроки.Вставить("НомерСтрокиРеквизита", 	0);
	ДанныеСтроки.Вставить("ИмяРеквизита", 			"");
	ДанныеСтроки.Вставить("ЗначениеРеквизита", 		Неопределено);
	
	Возврат ДанныеСтроки;

КонецФункции

&НаСервере
Процедура ЗаписатьЗначениеОбластиВТаблицу(Таблица, ДанныеСтроки)
	
	НоваяСтрока = Таблица.Добавить(); 
	НоваяСтрока.Титул 					= Объект.ТекущийТитул;
	НоваяСтрока.ИмяТабличнойЧасти 		= ДанныеСтроки.ИмяТабличнойЧасти; 
	НоваяСтрока.НомерСтрокиРеквизита	= ДанныеСтроки.НомерСтрокиРеквизита;  
	НоваяСтрока.ИмяРеквизита 			= ДанныеСтроки.ИмяРеквизита; 
	НоваяСтрока.ЗначениеРеквизита 		= ДанныеСтроки.ЗначениеРеквизита;
	
КонецПроцедуры 

&НаСервере
Процедура ЗаписатьХранимыеДанныеПараметрыТранспортногоСредства(ТаблицаЗначенийРеквизитов, ИмяДокумента)

	ОбластиХранимыхДанных = Новый Массив;
	ОбластиХранимыхДанных.Добавить("ТитулГрузоотправителяПараметрыТранспортногоСредстваТип"); 
	ОбластиХранимыхДанных.Добавить("ТитулГрузоотправителяПараметрыТранспортногоСредстваГрузоподъемность"); 
	ОбластиХранимыхДанных.Добавить("ТитулГрузоотправителяПараметрыТранспортногоСредстваВместимость");
	ОбластиХранимыхДанных.Добавить("ТитулГрузоотправителяПараметрыТранспортногоСредстваТипПогрузки");
	ОбластиХранимыхДанных.Добавить("ТитулГрузоотправителяПараметрыТранспортногоСредстваТипКузова");
	ОбластиХранимыхДанных.Добавить("ТитулГрузоотправителяПараметрыТранспортногоСредстваИныеПараметры");
	
	ПредставленияРеквизитов = Новый Соответствие; 
	ПредставленияРеквизитов.Вставить("Тип",					"Тип");    
	ПредставленияРеквизитов.Вставить("ТипПогрузки",			"Тип погрузки");
	ПредставленияРеквизитов.Вставить("Вместимость",			"Вместимость, м3");
	ПредставленияРеквизитов.Вставить("ТипКузова",			"Тип кузова");
	ПредставленияРеквизитов.Вставить("Грузоподъемность",	"Грузоподъемность, т");
	ПредставленияРеквизитов.Вставить("ИныеПараметры",		"Другие необходимые параметры");
	
	ХранимыеДанные = СтруктураХранимыхДанных();
	ХранимыеДанные.ГруппаДанных = "ТитулГрузоотправителяПараметрыТранспортногоСредства"; 
	ХранимыеДанные.Тип 			= "ПараметрыТранспортногоСредства"; 
	ХранимыеДанные.ИмяОбъекта 	= "Документ."+ИмяДокумента; 
	
	Для Каждого ИмяОбласти из ОбластиХранимыхДанных Цикл
		Область = ТабличныйДокумент.Области.Найти(ИмяОбласти);
		Если Область = Неопределено Тогда 
			Продолжить;
		КонецЕсли; 
		
		ИмяРеквизита = СтрЗаменить(ИмяОбласти, "ТитулГрузоотправителяПараметрыТранспортногоСредства", ""); 
		
		НоваяСтрока = ХранимыеДанные.Данные.Добавить();
		НоваяСтрока.Имя 			= ИмяРеквизита;
		НоваяСтрока.Представление 	= ПредставленияРеквизитов.Получить(ИмяРеквизита);
		НоваяСтрока.Значение 		= Область.Значение;
	КонецЦикла;   
	
	УдалитьПустыеХранимыеДанныеСторонаПодписавшаяДокумент(ХранимыеДанные.Данные);
	
	Если ХранимыеДанные.Данные.Количество() > 0 Тогда
		ДанныеСтроки = ПустаяСтруктураДанныхСтроки();
		ДанныеСтроки.ИмяРеквизита 			= "ХранимыеДанныеТитулГрузоотправителяПараметрыТранспортногоСредства"; 
		ДанныеСтроки.ЗначениеРеквизита 		= ХранимыеДанные;
		
		ЗаписатьЗначениеОбластиВТаблицу(ТаблицаЗначенийРеквизитов, ДанныеСтроки);
	КонецЕсли;
	
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьХранимыеДанныеВодителя(ТаблицаЗначенийРеквизитов, ИмяДокумента, ПрефиксТитула)
	
	ПредставленияРеквизитов = Новый Соответствие; 
	ПредставленияРеквизитов.Вставить("Фамилия",		"Фамилия");    
	ПредставленияРеквизитов.Вставить("Имя",			"Имя");
	ПредставленияРеквизитов.Вставить("Отчество",	"Отчество");
	ПредставленияРеквизитов.Вставить("ФЛ_ИНН",		"ИНН");
	ПредставленияРеквизитов.Вставить("НомерВУ",		"Номер ВУ");
	ПредставленияРеквизитов.Вставить("СерияВУ",		"Серия ВУ");
	ПредставленияРеквизитов.Вставить("ДатаВыдачиВУ","Дата выдачи ВУ");
	ПредставленияРеквизитов.Вставить("Телефон",		"Телефон");

	ХранимыеДанные = СтруктураХранимыхДанных();
	ХранимыеДанные.ГруппаДанных = "Водитель"; 
	ХранимыеДанные.Тип 			= "Водитель"; 
	ХранимыеДанные.ИмяОбъекта 	= "Документ."+ИмяДокумента; 
	
	ИменаОбластейРеквизитов = ПолучимтьИменаОбластейРеквизитовВодителя();
	Для Каждого ИмяОбласти из ИменаОбластейРеквизитов Цикл
		Область = ТабличныйДокумент.Области.Найти(ПрефиксТитула+ИмяОбласти);
		Если Область = Неопределено Тогда 
			Продолжить;
		КонецЕсли; 
		
		ПривОбластьИмя 	= CW_ОбменГИСЭПДДополнительный.ПривестиИмяОбласти(Область.Имя);
		ЧастиИмени 		= СтрРазделить(ПривОбластьИмя, "_");
		ИмяРеквизита 	= CW_ОбменГИСЭПДДополнительный.ВостановитьПриведенноеИмяРеквизита(ЧастиИмени[1]);	
		
		НоваяСтрока = ХранимыеДанные.Данные.Добавить();
		НоваяСтрока.Имя 			= ИмяРеквизита;
		НоваяСтрока.Представление 	= ПредставленияРеквизитов.Получить(ИмяРеквизита);
		НоваяСтрока.Значение 		= Область.Значение;
	КонецЦикла;   
	
	//Табличные части
	ИменаОбластейТабличныхЧастей = ПолучитьИменаОбластейТабличныхЧастейВодителей();
	Для Каждого ИмяОбласти из ИменаОбластейТабличныхЧастей Цикл
		Область = ТабличныйДокумент.Области.Найти(ПрефиксТитула+ИмяОбласти);
		Если Область = Неопределено Тогда 
			Продолжить;
		КонецЕсли; 
		
		НоваяСтрока = ХранимыеДанные.Данные.Добавить();
		НоваяСтрока.Имя 			= "Телефон";
		НоваяСтрока.Представление 	= ПредставленияРеквизитов.Получить("Телефон");
		НоваяСтрока.Значение 		= Область.Значение;
		
		НоваяСтрока.ИмяТабличнойЧасти 	= "ВодительНомераТелефонов";
		НоваяСтрока.НомерСтрокиТЧ 		= 1;
		
	КонецЦикла;   
	//---Табличные части
	
	УдалитьПустыеХранимыеДанныеСторонаПодписавшаяДокумент(ХранимыеДанные.Данные);
	
	Если ХранимыеДанные.Данные.Количество() > 0 Тогда
		ДанныеСтроки = ПустаяСтруктураДанныхСтроки();
		ДанныеСтроки.ИмяТабличнойЧасти		= ПрефиксТитула+"Водители";
		ДанныеСтроки.ИмяРеквизита			= "ХранимыеДанныеВодитель"; 
		ДанныеСтроки.ЗначениеРеквизита		= ХранимыеДанные;
		ДанныеСтроки.НомерСтрокиРеквизита	= 1;
		
		ЗаписатьЗначениеОбластиВТаблицу(ТаблицаЗначенийРеквизитов, ДанныеСтроки);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьИменаОбластейТабличныхЧастейВодителей()

	ОбластиХранимыхДанных = Новый Массив;

	Если Объект.ТекущийТитул = ПредопределенноеЗначение("Перечисление.ТипыЭлементовРегламентаЭДО.ЭТрН_Титул1") Тогда 
	ОбластиХранимыхДанных.Добавить("ВодительНомераТелефонов_Телефон_1");
    КонецЕсли;
	
	Возврат ОбластиХранимыхДанных;

КонецФункции

&НаСервере
Функция ПолучимтьИменаОбластейРеквизитовВодителя()
	
	ОбластиХранимыхДанных = Новый Массив;
	ОбластиХранимыхДанных.Добавить("Водители_Фамилия_1"); 
	ОбластиХранимыхДанных.Добавить("Водители_Имя_1"); 
	ОбластиХранимыхДанных.Добавить("Водители_Отчество_1");
	ОбластиХранимыхДанных.Добавить("Водители_ФЛ_ИНН_1");
	ОбластиХранимыхДанных.Добавить("Водители_НомерВУ_1");
	ОбластиХранимыхДанных.Добавить("Водители_СерияВУ_1");
	ОбластиХранимыхДанных.Добавить("Водители_ДатаВыдачиВУ_1"); 
	
	Возврат ОбластиХранимыхДанных;

КонецФункции

&НаСервере
Процедура ЗаписатьХранимыеДанныеТраспортного(ТаблицаЗначенийРеквизитов, ИмяДокумента, ПрефиксТитула)
	
	ПредставленияРеквизитов = ПолучитьСоответствиеПредставленийРеквизитовТранспортногоСредства();

	ХранимыеДанные = СтруктураХранимыхДанных();
	ХранимыеДанные.ГруппаДанных = ПрефиксТитула +"ТранспортноеСредство"; 
	ХранимыеДанные.Тип 			= "ТранспортноеСредство"; 
	ХранимыеДанные.ИмяОбъекта 	= "Документ."+ИмяДокумента; 
	
	ОбластиРеквизитыТС = ПолучитьИменаОбластейРеквизитовТранспортногоСредства();
	Для Каждого ИмяОбласти из ОбластиРеквизитыТС Цикл
		Область = ТабличныйДокумент.Области.Найти(ПрефиксТитула+ИмяОбласти);
		Если Область = Неопределено Тогда 
			Продолжить;
		КонецЕсли; 
		ИмяРеквизита = СтрЗаменить(ИмяОбласти, "ТранспортноеСредство", "");
		
		НоваяСтрока = ХранимыеДанные.Данные.Добавить();
		НоваяСтрока.Имя 			= ИмяРеквизита;
		НоваяСтрока.Представление 	= ПредставленияРеквизитов.Получить(ИмяРеквизита);
		НоваяСтрока.Значение 		= Область.Значение;
	КонецЦикла; 
	
	ОбластиТабличныеЧасти = ПолучитьИменаОбластейТабличныхЧастейТраспортногоСредства();
	Для Каждого ИмяОбласти из ОбластиТабличныеЧасти Цикл
		Область = ТабличныйДокумент.Области.Найти(ПрефиксТитула+ИмяОбласти);
		Если Область = Неопределено Тогда 
			Продолжить;
		КонецЕсли;   
		
		ЗначениеОбласти = Область.Значение; 
		
		Если СтрНайти(ИмяОбласти, "ХранимыеДанныеСторонаПодписавшаяДокумент") > 0 Тогда 
			ЗначениеОбласти = ПолучитьХранимыеДанныеСторонаПодписавшаяДокумент(ИмяДокумента, Область); 
		КонецЕсли;   
		
		ЧастиИмени 			= СтрРазделить(ИмяОбласти, "_");
		ИмяРеквизита 		= ЧастиИмени[1];
		ИмяТабличнойЧасти 	= ЧастиИмени[0];
		НомерСтрокиТЧ 		= Число(ЧастиИмени[2]);
	
		НоваяСтрока = ХранимыеДанные.Данные.Добавить();
		НоваяСтрока.Имя 				= ИмяРеквизита;
		НоваяСтрока.Представление 		= ПредставленияРеквизитов.Получить(ИмяРеквизита);
		НоваяСтрока.Значение 			= ЗначениеОбласти; 
		НоваяСтрока.ИмяТабличнойЧасти 	= ИмяТабличнойЧасти;
		НоваяСтрока.НомерСтрокиТЧ 		= НомерСтрокиТЧ;  
		
	КонецЦикла;
	
	УдалитьПустыеХранимыеДанныеСторонаПодписавшаяДокумент(ХранимыеДанные.Данные);
	
	ХранимыеДанныеПрицепа = ПолучитьХранимыеДанныеПрицепа(ТаблицаЗначенийРеквизитов, ИмяДокумента, ПрефиксТитула);
	Если ХранимыеДанныеПрицепа.Данные.Количество() > 0 Тогда
		ДанныеСтроки = ПустаяСтруктураДанныхСтроки();
		ДанныеСтроки.ИмяТабличнойЧасти		= ПрефиксТитула + "Прицепы";
		ДанныеСтроки.ИмяРеквизита			= "ХранимыеДанныеПрицеп"; 
		ДанныеСтроки.ЗначениеРеквизита		= ХранимыеДанныеПрицепа;
		ДанныеСтроки.НомерСтрокиРеквизита	= 1;
		
		ЗаписатьЗначениеОбластиВТаблицу(ТаблицаЗначенийРеквизитов, ДанныеСтроки); 
		
		Для Каждого Строкатаблицы из ХранимыеДанныеПрицепа.Данные Цикл
			НоваяСтрока = ХранимыеДанные.Данные.Добавить(); 
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Строкатаблицы);  
			Если ПустаяСтрока(НоваяСтрока.ИмяТабличнойЧасти) Тогда
				НоваяСтрока.ИмяТабличнойЧасти = "Прицепы";
			КонецЕсли;
			НоваяСтрока.НомерСтрокиТЧ 		= 1;  
		КонецЦикла;
		
		НоваяСтрока = ХранимыеДанные.Данные.Добавить();
		НоваяСтрока.Имя 				= "ХранимыеДанныеПрицеп";
		НоваяСтрока.Представление 		= "";
		НоваяСтрока.Значение 			= ХранимыеДанныеПрицепа; 
		НоваяСтрока.ИмяТабличнойЧасти 	= "Прицепы";
		НоваяСтрока.НомерСтрокиТЧ 		= 1;  
		
	КонецЕсли;
	
	Если ХранимыеДанные.Данные.Количество() > 0 Тогда
		ДанныеСтроки = ПустаяСтруктураДанныхСтроки();
		ДанныеСтроки.ИмяРеквизита 			= "ХранимыеДанные"+ПрефиксТитула+"ТранспортноеСредство"; 
		ДанныеСтроки.ЗначениеРеквизита 		= ХранимыеДанные;
		
		ЗаписатьЗначениеОбластиВТаблицу(ТаблицаЗначенийРеквизитов, ДанныеСтроки);
