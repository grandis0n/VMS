		Набор = РегистрыСведений.CW_ДоступностьСтатусовПоГруппамПользователей.СоздатьНаборЗаписей();
		Набор.Отбор.ГруппаПользователя.Установить(ПараметрКоманды);
		Набор.Прочитать();
		Набор.Загрузить(РезультатЗапроса.Выгрузить());  
		Набор.Записать(Истина); 
	КонецЕсли;
	//--CW_ДоступностьСтатусовПоГруппамПользователей
	
	//CW_ДоступноИнициацияСогласования
	Запрос = Новый Запрос;
