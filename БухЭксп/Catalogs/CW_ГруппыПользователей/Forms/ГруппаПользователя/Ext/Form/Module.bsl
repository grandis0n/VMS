
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	УправлениеПользователями = CW_ПраваДоступа.ПравоДоступно("УправлениеПользователями");	
	
	ЭтаФорма.ТолькоПросмотр = Не УправлениеПользователями;
	Элементы.НастройкаФильтраГрузоперевозок.Доступность = УправлениеПользователями;
	Элементы.ДеревоРедактированияСправочников.ТолькоПросмотр = Не УправлениеПользователями;
	
	Элементы.ДеревоРедактированияСправочников.ТолькоПросмотр = Не УправлениеПользователями;
	Элементы.ДеревоРедактированияСправочниковГруппа2.Доступность = УправлениеПользователями;
	
	Элементы.КонтекстноеМенюУстановитьФлажкиДляВыделенныхСтрок.Доступность = УправлениеПользователями;
	Элементы.КонтекстноеМенюСнятьФлажкиДляВыделенныхСтрок.Доступность = УправлениеПользователями;
	
	Элементы.ГруппаОтборОбъектов.Доступность = УправлениеПользователями;
	
	Если Параметры.Ключ.Пустая() Тогда  
		ЗаполнитьДеревоНастроекСтатейДДС(Параметры.ЗначениеКопирования);
		ЗаполнитьДеревоНастроекРедактированияСправочников(Параметры.ЗначениеКопирования);
		ЗаполнитьДеревоПравПараметров(Параметры.ЗначениеКопирования);
		ЗаполнитьНастройкуПравШаблонов(Параметры.ЗначениеКопирования);
		ЗаполнитьСписокИнициацииСогласования(Параметры.ЗначениеКопирования);
		ЗаполнитьСписокДоступныхОрганизаций(Параметры.ЗначениеКопирования);
		
		Если ПолучитьФункциональнуюОпцию("CW_ИспользуютсяСтатусыДокументов") Тогда
			ЗаполнитьДеревоСтатусов(Параметры.ЗначениеКопирования);
		КонецЕсли;
		
	КонецЕсли;
	
	ПравоРедактироватьНастройкиМониторинга 				= CW_ПраваДоступа.ПравоДоступно("РедактированиеНастроекМониторинга");
	Элементы.ДеревоПравПараметров.Доступность 			= ПравоРедактироватьНастройкиМониторинга;	
	Элементы.ГруппаСправочникиКИ.Видимость 				= ПолучитьФункциональнуюОпцию("CW_ИспользованиеCRM");
	Элементы.СтраницаБюджетирование.Видимость			= ПолучитьФункциональнуюОпцию("CW_ИспользованиеБюджетирования");
	
	Если Объект.Ссылка = Справочники.CW_ГруппыПользователей.Администраторы Тогда
		Объект.ПолныеПрава = Истина;
		Элементы.ПолныеПрава.Доступность = Ложь;
		Элементы.Наименование.Доступность = Ложь;
	КонецЕсли; 
	
	
	Если Параметры.Ключ.Пустая() Тогда
		_УправлениеЭлементамиФормы();     
	КонецЕсли;
	
	УстановитьДоступностьРедактируемыхРеквизитовШапки();
 	УстановитьДоступностьЭлементовБюджета();   
	
	
	_УстановитьОтборСостава();
	
	// добавлено CW (КС)..
	//--------------------
	РедактированиеСроковОплаты 		= Объект.РедактированиеСроковОплатыВходящихСчетов Или Объект.РедактированиеСроковОплатыИсходящихСчетов;
	
	УстановитьВидимостьПодчиненных_Номерасчетов();
	УстановитьВидимостьПодчиненных_Номера();
	
	
	ТекстЗаказы = "";
	Если ПолучитьФункциональнуюОпцию("CW_ИспользованиеЗаказов") Тогда
		ТекстЗаказы = " и заказов";
	КонецЕсли;
	
	Элементы.СтраницаПланированиеДДС.Видимость = Объект.ДоступенБлокПланированияДДС;    
	
	
КонецПроцедуры  

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	ЗаполнитьДеревоНастроекСтатейДДС(ТекущийОбъект.Ссылка);
	ЗаполнитьДеревоНастроекРедактированияСправочников(ТекущийОбъект.Ссылка);
	ЗаполнитьДеревоПравПараметров(ТекущийОбъект.Ссылка);
	ЗаполнитьНастройкуПравШаблонов(ТекущийОбъект.Ссылка);
	ЗаполнитьСписокИнициацииСогласования(ТекущийОбъект.Ссылка);
	ЗаполнитьСписокДоступныхОрганизаций(ТекущийОбъект.Ссылка);
	
	Если ПолучитьФункциональнуюОпцию("CW_ИспользуютсяСтатусыДокументов") Тогда
		ЗаполнитьДеревоСтатусов(ТекущийОбъект.Ссылка);
	КонецЕсли;
	
	ФильтрГрузоперевозок = ТекущийОбъект.ХранилищеФильтраГрузоперевозок.Получить();
	Если ФильтрГрузоперевозок <> Неопределено Тогда
		АдресФильтра = ПоместитьВоВременноеХранилище(ФильтрГрузоперевозок,ЭтаФорма.УникальныйИдентификатор);
	КонецЕсли; 
	
	ФильтрЗаявок = ТекущийОбъект.ХранилищеФильтраЗаявок.Получить();
	Если ФильтрЗаявок <> Неопределено Тогда
		АдресФильтраЗаявок = ПоместитьВоВременноеХранилище(ФильтрЗаявок,ЭтаФорма.УникальныйИдентификатор);
	КонецЕсли; 
	
	ФильтрЗаказов = ТекущийОбъект.ХранилищеФильтраЗаказов.Получить();
	Если ФильтрЗаказов <> Неопределено Тогда
		АдресФильтраЗаказов = ПоместитьВоВременноеХранилище(ФильтрЗаказов,ЭтаФорма.УникальныйИдентификатор);
	КонецЕсли; 

	_УправлениеЭлементамиФормы();
	
КонецПроцедуры


&НаСервере
Процедура ЗаполнитьНастройкуПравШаблонов(ГруппаПользователя)  
	
	ТаблицаПрав = CW_ШаблоныДокументовСерверВызовСервера.ПолучитьТаблицаПравДоступа(ГруппаПользователя);
	ПраваРедактирвоанияШаблонов.Загрузить(ТаблицаПрав);
	
КонецПроцедуры


&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)

	ЗаписатьИнициациюСогласования();
	ЗаписатьДанныеПравНаПараметры();
	
	ЗаписатьДоступныеСтатьиДДСВРегистр();
	ЗаписатьДоступныеСтатусыВРегистр();
	ЗаписатьРазрешенныеСправочникиВРегистр();  
	
	ЗаписатьПраваРедактированияШаблонов();   
	
	ЗаписатьРодиДляГруппыПользователей();
	
	_УправлениеЭлементамиФормы();
	_УстановитьОтборСостава();
	
	ЗаписатьСписокДоступныхОрганизаций();
	
	
КонецПроцедуры 

&НаСервере
Процедура ЗаписатьСписокДоступныхОрганизаций()
	
	ТаблицаНабора = РегистрыСведений.CW_ОрганизацииДоступныеПоГруппамПользователей.ПолучитьПустуюТаблицуНабора();
	
	Для Каждого СтрокаТаблицы из ДоступныеОрганизации Цикл
		СтрокаНабора = ТаблицаНабора.Добавить();
		СтрокаНабора.ГруппаПользователей 	= Объект.Ссылка;
		СтрокаНабора.Организация 			= СтрокаТаблицы.Организация;
	КонецЦикла;
	
	РегистрыСведений.CW_ОрганизацииДоступныеПоГруппамПользователей.ЗаписатьСписокДоступныхОрганизаций(Объект.Ссылка, ТаблицаНабора);
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьРодиДляГруппыПользователей()   
	
	ПараметрыПроцедуры = Новый Структура;
	ПараметрыПроцедуры.Вставить("ГруппаПользователей", 	Объект.Ссылка);
	ПараметрыПроцедуры.Вставить("РеестрыНДС0",			Объект.РеестрыНДС0);
	ПараметрыПроцедуры.Вставить("ДоходыНерезидентов",	Объект.ДоходыНерезидентов);
	ПараметрыПроцедуры.Вставить("ОбменС1СЭПД", 			Объект.ОбменС1СЭПД);
	
	Справочники.CW_ГруппыПользователей.ОбновитьПрофилиПользователей(ПараметрыПроцедуры);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокДоступныхОрганизаций(ГруппаПользователя)    
	
	Если Не Объект.Ссылка.Пустая() Тогда
		ТаблицаОрганизаций = РегистрыСведений.CW_ОрганизацииДоступныеПоГруппамПользователей.ПолучитьСписокДоступныхОрганизаций(ГруппаПользователя);
		ДоступныеОрганизации.Загрузить(ТаблицаОрганизаций);
	КонецЕсли;
	
КонецПроцедуры

// ---------------------------------------------------------------------------- 

&НаСервере
Процедура _УправлениеЭлементамиФормы()
	
	Элементы.СтраницаСостав.Видимость = (НЕ Объект.Ссылка.Пустая());
	Элементы.СтраницыПрав.Видимость = (НЕ Объект.ПолныеПрава);
	
	// Раздел "ФИНАНСЫ"
	// ----------------
	
	// Закладка "Расходы и доходы"
	//-------------------------------
	
	// Просмотр документов
	Элементы.ГруппаПросмотрФинансовСоставДокументов.Доступность = (Объект.ПросмотрФинансов);
	Элементы.ГруппаРедактированиеРасходов.Доступность = (Объект.РедактированиеФинансов и Объект.ПросмотрФинансов_Расходы);
	
	// редактирование документов
	Элементы.ГруппаОпцииРедактированияДокументов.Доступность = Объект.РедактированиеФинансов;
	
	Элементы.ГруппаРедактированиеДоходов.Доступность = (Объект.РедактированиеФинансов и Объект.ПросмотрФинансов_Доходы);
	Элементы.РедактированиеФинансов.Доступность = (Объект.ПросмотрФинансов);
	Элементы.РедактированиеОперативныхОплат.Доступность = (Объект.ПросмотрФинансов_ОперативныйУчет);
	
	// опции редактирования документов
	Элементы.РазрешитьПроведениеДокументовБезГрузоперевозок.Доступность = (Объект.РедактированиеФинансов);
	Элементы.РедактированиеСтавкиНДС.Доступность = (Объект.РедактированиеФинансов);
	Элементы.РедактированиеСпособаУчетаНДС.Доступность = (Объект.РедактированиеФинансов_Расходы_Акты или Объект.РедактированиеФинансов_Расходы_Счета);
	Элементы.РедактированиеНомеровПервичныхДокументов.Доступность = (Объект.РедактированиеФинансов_Доходы_Акты ИЛИ Объект.РедактированиеФинансов_Доходы_Счета);
	//		Элементы.РедактированиеСроковОплаты.Доступность = Объект.РедактированиеФинансов;
	Элементы.РедактированиеСроковОплатыВходящихСчетов.Доступность = Объект.РедактированиеФинансов_Расходы_Счета;
	Элементы.РедактированиеСроковОплатыИсходящихСчетов.Доступность = Объект.РедактированиеФинансов_Доходы_Счета;
	
	Элементы.ГруппаДополнениеРазрешенийРедактированияИсходящихСчетов.Доступность   = Объект.РедактированиеФинансов_Доходы_Счета;
	Элементы.ГруппаДополнениеРазрешенийРедактироватьВходящиеСчета.Доступность    = Объект.РедактированиеФинансов_Расходы_Счета;
	
	// Закладка "Оплаты"                                   
	Элементы.ПросмотрОперативныхОплат.Доступность = (Объект.ПросмотрФинансов);
	Элементы.ПросмотрФинансов_Оплаты.Доступность = (Объект.ПросмотрФинансов);
	
	// Закладка "Наличие оригиналов"
	Элементы.РедактированиеВозвратаОригиналовОтПоставщика.Доступность = (Объект.ПросмотрФинансов_Расходы);
	Элементы.РедактированиеВозвратаОригиналовОтКлиента.Доступность = (Объект.ПросмотрФинансов_Доходы);
	
	// Закладка "Блокировка"
	Элементы.ЗакрытиеГрузоперевозок.Доступность = (Объект.РедактированиеФинансов_Доходы_Акты И Объект.РедактированиеФинансов_Расходы_Акты);
	Элементы.ОтменаЗакрытияГрузоперевозок.Доступность = (Объект.РедактированиеФинансов_Доходы_Акты И Объект.РедактированиеФинансов_Расходы_Акты);

	// статусы документов	
	Элементы.ДоступныеСтатусыДокументов.Видимость = Объект.РедактированиеСтатусовДокументов;
	
	
	// Раздел "МОНИТОРИНГ"
	
	Элементы.ДоступныеТипыГрузоперевозок.Видимость 		= Объект.ОграничениеПоТипамГрузоперевозок;
	Элементы.НастройкаФильтраГрузоперевозок.Видимость 	= Объект.ФильтрГрузоперевозок и НЕ ЭтаФорма.ТолькоПросмотр;
	Элементы.КомандаНастройкаФильтаЗаявок.Видимость 	= Объект.ФильтрЗаявок и НЕ ЭтаФорма.ТолькоПросмотр;
	Элементы.КомандаНастройкаОтбораЗаказов.Видимость 	= Объект.ФильтрЗаказов и НЕ ЭтаФорма.ТолькоПросмотр;
	Элементы.ГруппаСправочникиCRM.Видимость 			= Объект.РедактированиеCRM; 
	
	УстановитьЦветНадлписиФильтров();
	
КонецПроцедуры    

&НаСервере
Процедура УстановитьЦветНадлписиФильтров() 
	
	Если ЭтоАдресВременногоХранилища(АдресФильтра) Тогда 
		ЦветТекста = Новый Цвет;
	Иначе
		ЦветТекста = ЦветаСтиля.ЦветОсобогоТекста;   
	КонецЕсли;  
	Элементы.НастройкаФильтраГрузоперевозок.ЦветТекста  = ЦветТекста;
	
	Если ЭтоАдресВременногоХранилища(АдресФильтраЗаказов) Тогда 
		ЦветТекста = Новый Цвет;
	Иначе
		ЦветТекста = ЦветаСтиля.ЦветОсобогоТекста;   
	КонецЕсли;  
	Элементы.КомандаНастройкаОтбораЗаказов.ЦветТекста   = ЦветТекста;
	
	Если ЭтоАдресВременногоХранилища(АдресФильтраЗаявок) Тогда
		ЦветТекста = Новый Цвет;
	Иначе
		ЦветТекста = ЦветаСтиля.ЦветОсобогоТекста;   
	КонецЕсли;
	
	Элементы.КомандаНастройкаФильтаЗаявок.ЦветТекста    = ЦветТекста;
	
КонецПроцедуры

&НаСервере
Процедура _УстановитьОтборСостава()
	// --- 
	
	Состав.Параметры.УстановитьЗначениеПараметра("Группа",Объект.Ссылка);
	
	// --- 
КонецПроцедуры


&НаКлиенте
Процедура ПолныеПраваПриИзменении(Элемент)
	
	_УправлениеЭлементамиФормы();
	
	ОбновитьДанныеРегистраПравДДС = Истина;
	
КонецПроцедуры

&НаСервере
Процедура ПолныеПраваПриИзмененииНаСервере()
	
	ОбновитьИнтерфейс = истина;
	
КонецПроцедуры

&НаКлиенте
Процедура РедактированиеФинансов_Расходы_АктыПриИзменении(Элемент)
	
	Если НЕ Объект.РедактированиеФинансов_Расходы_Акты Тогда
		// если акт то же не доступен для редактирования, 
		// то снимаем флаг редактирования способа НДС
		Если Объект.РедактированиеФинансов_Доходы_Счета = Ложь Тогда
			Объект.РедактированиеСпособаУчетаНДС = Ложь;
			Объект.РедактированиеВозвратаОригиналовОтПоставщика = Ложь;
		КонецЕсли;
		
		Объект.РедактированиеВозвратаОригиналовОтПоставщика = Ложь;
	КонецЕсли;
	
	_УправлениеЭлементамиФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура РедактированиеФинансов_Доходы_АктыПриИзменении(Элемент)
	
	Если НЕ Объект.РедактированиеФинансов_Доходы_Акты Тогда
		Объект.РедактированиеВозвратаОригиналовОтКлиента=Ложь;
	КонецЕсли;
	Если (НЕ Объект.РедактированиеФинансов_Доходы_Акты И НЕ Объект.РедактированиеФинансов_Доходы_Счета) Тогда
		Объект.РедактированиеНомеровПервичныхДокументов = Ложь;
	КонецЕсли; 
	_УправлениеЭлементамиФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура РедактированиеФинансовПриИзменении(Элемент)
	
	Если Объект.РедактированиеФинансов = Ложь Тогда
		
		// сбросим возможность редактирования документов
		Объект.РедактированиеФинансов_Расходы_Счета = Ложь;
		Объект.РедактированиеФинансов_Расходы_Акты 	= Ложь;
		Объект.РедактированиеФинансов_Доходы_Счета 	= Ложь;
		Объект.РедактированиеФинансов_Доходы_Акты 	= Ложь;
		
		// сбросим все опции редактирования
		Объект.РазрешитьПроведениеДокументовБезГрузоперевозок = Ложь;
		Объект.РедактированиеСтавкиНДС	 		= Ложь;
		Объект.РедактированиеСпособаУчетаНДС 	= Ложь;
		Объект.РедактированиеНомеровПервичныхДокументов = Ложь;
		РедактированиеСроковОплаты = Ложь;
		
		РедактированиеСроковОплатыПриИзменении(Элемент);
		
		Объект.РазрешитьРедактированиеИсходящихОплаченныхСчетов    = Ложь;
		Объект.РазрешитьРедактированиеИсходящихАктированныхСчетов  = Ложь;
		Объект.РазрешитьРедактированиеВходящихОплаченныхСчетов     = Ложь;
		Объект.РазрешитьРедактированиеВходящихАктированныхСчетов   = Ложь;
		Объект.РедактированиеФинансов_Корректировки 			   = Ложь;
		
		Объект.РедактированиеНомераДокументаДоходыПоГрузоперевозкам    = Ложь;
		Объект.РедактированиеНомераДокументаРасходыПоГрузоперевозкам    = Ложь;
	КонецЕсли; 
	
	УстановитьВидимостьПодчиненных_Номера();
	_УправлениеЭлементамиФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура ПросмотрФинансовПриИзменении(Элемент)
	
	Если (НЕ Объект.ПросмотрФинансов) Тогда
		
		// виды документов для просмотра
		Объект.ПросмотрФинансов_Расходы = Ложь;
		Объект.ПросмотрФинансов_Доходы = Ложь;
		
		// сбросим возможность редактирования
		Объект.РедактированиеФинансов = Ложь;
		РедактированиеФинансовПриИзменении(Элемент);
		
		// опции редактирования документов
		Объект.РазрешитьПроведениеДокументовБезГрузоперевозок = Ложь;
		Объект.РедактированиеСтавкиНДС = Ложь;
		Объект.РедактированиеСпособаУчетаНДС = Ложь;
		Объект.РедактированиеНомеровПервичныхДокументов = Ложь;
		РедактированиеСроковОплаты = Ложь;
		РедактированиеСроковОплатыПриИзменении(Элемент);
		
		// управление блокировкой 
		Объект.ЗакрытиеГрузоперевозок=Ложь;
		Объект.ОтменаЗакрытияГрузоперевозок=Ложь;
		
		// контроль наличия оригиналов документов 
		Объект.РедактированиеВозвратаОригиналовОтКлиента=Ложь;
		Объект.РедактированиеВозвратаОригиналовОтПоставщика=Ложь;
		
		// управление оплатами 
		Объект.ПросмотрФинансов_ОперативныйУчет=Ложь;
		Объект.РедактированиеФинансов_ОперативныйУчет=Ложь;
		Объект.ПросмотрФинансов_Оплаты = Ложь;
		
		// установим признак модифицированности
		ЭтаФорма.Модифицированность = Истина;
		
	КонецЕсли; 
	
	_УправлениеЭлементамиФормы();
	
КонецПроцедуры

