&НаКлиенте
Процедура ДеревоСтатейДДСИспользованиеПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ДеревоСтатейДДС.ТекущиеДанные;
	
	УстановитьДанныеСтрокиПриИзмененииФлага(ТекущиеДанные, "Использование");
	Если ТекущиеДанные.ЭтоГруппа Тогда
		УстановитьФлагиДляПодчиненных(ТекущиеДанные, "Использование");
		УстановитьФлагиДляРодителей(ТекущиеДанные, "Использование");
	Иначе
		УстановитьФлагиДляРодителей(ТекущиеДанные, "Использование");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СтатьиДДДСИспользованиеСнятьВсе(Команда)
	
	ЭлементыДерева = ДеревоСтатейДДС.ПолучитьЭлементы();
	ОбработатьФлажкиДереваСтатейДДС(ЭлементыДерева, "Использование", Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура СтатьиДДСРазвернутьВсе(Команда)
	
	ЭлементыДерерва = ДеревоСтатейДДС.ПолучитьЭлементы();
	
	Для Каждого СтрокаДерева из ЭлементыДерерва Цикл
		
		Если Не СтрокаДерева.ЭтоГруппа Тогда
			Продолжить;
		КонецЕсли;
		
		ИдентификаторСтроки = СтрокаДерева.ПолучитьИдентификатор();
		Элементы.ДеревоСтатейДДС.Развернуть(ИдентификаторСтроки, Истина);
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура СтатьиДДССвернутьВсе(Команда)
	
	ЭлементыДерерва = ДеревоСтатейДДС.ПолучитьЭлементы();
	
	Для Каждого СтрокаДерева из ЭлементыДерерва Цикл
		
		Если Не СтрокаДерева.ЭтоГруппа Тогда
			Продолжить;
		КонецЕсли;
		
		ИдентификаторСтроки = СтрокаДерева.ПолучитьИдентификатор();
		Элементы.ДеревоСтатейДДС.Свернуть(ИдентификаторСтроки);
		
	КонецЦикла;
	
КонецПроцедуры


&НаКлиенте
Процедура СтатьиДДДСИспользованиеУстановитьВсе(Команда)
	
	ЭлементыДерева = ДеревоСтатейДДС.ПолучитьЭлементы();
	ОбработатьФлажкиДереваСтатейДДС(ЭлементыДерева, "Использование", Истина);

	
КонецПроцедуры

&НаКлиенте
Процедура СтатьиДДДСПросмотрСнятьВсе(Команда)
	
	ЭлементыДерева = ДеревоСтатейДДС.ПолучитьЭлементы();
	ОбработатьФлажкиДереваСтатейДДС(ЭлементыДерева, "Просмотр", Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура СтатьиДДДСПросмотрУстановитьВсе(Команда)
	
	ЭлементыДерева = ДеревоСтатейДДС.ПолучитьЭлементы();
	ОбработатьФлажкиДереваСтатейДДС(ЭлементыДерева, "Просмотр", Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьФлажкиДереваСтатейДДС(ЭлементыДерева, ИмяПоля, Флаг)
	
	Для Каждого СтрокаДерева из ЭлементыДерева Цикл
		СтрокаДерева[ИмяПоля] = Флаг;
		УстановитьДанныеСтрокиПриИзмененииФлага(СтрокаДерева, ИмяПоля);
		
		УстановитьФлагиДляПодчиненных(СтрокаДерева, ИмяПоля);
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоСтатейДДСПросмотрПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ДеревоСтатейДДС.ТекущиеДанные;
	
	УстановитьДанныеСтрокиПриИзмененииФлага(ТекущиеДанные, "Просмотр");
	Если ТекущиеДанные.ЭтоГруппа Тогда
		УстановитьФлагиДляПодчиненных(ТекущиеДанные, "Просмотр");
		УстановитьФлагиДляРодителей(ТекущиеДанные, "Просмотр");
	Иначе
		УстановитьФлагиДляРодителей(ТекущиеДанные, "Просмотр");
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура УстановитьФлагиДляПодчиненных(ТекущиеДанные, ИмяПоля)
	
	СтрокиДерева = ТекущиеДанные.ПолучитьЭлементы();
	
	Для Каждого СтрокаДерева из  СтрокиДерева Цикл
		
		СтрокаДерева[ИмяПоля] = ТекущиеДанные[ИмяПоля];
		УстановитьДанныеСтрокиПриИзмененииФлага(СтрокаДерева, ИмяПоля);
		Если СтрокаДерева.ЭтоГруппа Тогда
			УстановитьФлагиДляПодчиненных(СтрокаДерева, ИмяПоля);
		КонецЕсли;		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьФлагиДляРодителей(ТекущиеДанные, ИмяПоля)
	
	СтрокаРодитель 	 = ТекущиеДанные.ПолучитьРодителя();
	
	Если СтрокаРодитель = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЭлементыРодителя = СтрокаРодитель.ПолучитьЭлементы();
	
	мЗначенияПометок = Новый Массив;
	Для Каждого СтрокаДерева из ЭлементыРодителя ЦИкл
		Пометка = СтрокаДерева[ИмяПоля];
		Если мЗначенияПометок.Найти(Пометка) = Неопределено Тогда
			мЗначенияПометок.Добавить(Пометка);
		КонецЕсли;
	КонецЦикла;
	
	Если мЗначенияПометок.Количество() = 1 Тогда
		СтрокаРодитель[ИмяПоля] = мЗначенияПометок[0];
	Иначе
		СтрокаРодитель[ИмяПоля] = 2;
	КонецЕсли;
	
	//Переходим на верхний уровень
	Если СтрокаРодитель.ПолучитьРодителя() <> Неопределено Тогда
		УстановитьФлагиДляРодителей(СтрокаРодитель, ИмяПоля);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьДанныеСтрокиПриИзмененииФлага(СрокаДерева, ИмяПоля)
	
	Если ИмяПоля = "Использование" Тогда
		Если СрокаДерева.Использование > 1 Тогда
			СрокаДерева.Использование = 0;
		КонецЕсли;
		Если СрокаДерева.Использование = 1 Тогда
			СрокаДерева.Просмотр = 1;
		КонецЕсли;
	КонецЕсли;
	
	Если ИмяПоля = "Просмотр" Тогда
		Если СрокаДерева.Просмотр > 1 Тогда
			СрокаДерева.Просмотр = 0;
		КонецЕсли;
		Если СрокаДерева.Просмотр = 0 Тогда
			СрокаДерева.Использование = 0;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДеревоНастроекСтатейДДС(ГруппаПользователя)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	CW_СтатьиДДС.Ссылка КАК СтатьяДДС,
	|	ВЫБОР
	|		КОГДА CW_ПраваДоступаДляСтатейДДС.СтатьяДДС ЕСТЬ NULL
	|			ТОГДА 0
	|		ИНАЧЕ 1
	|	КОНЕЦ КАК Просмотр,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(CW_ПраваДоступаДляСтатейДДС.Использование, ЛОЖЬ)
	|			ТОГДА 1
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК Использование,
	|	ВЫБОР
	|		КОГДА CW_СтатьиДДС.ВидДвижения = ЗНАЧЕНИЕ(Перечисление.CW_ВидыДвиженияДДС.Приход)
	|			ТОГДА 1
	|		КОГДА CW_СтатьиДДС.ВидДвижения = ЗНАЧЕНИЕ(Перечисление.CW_ВидыДвиженияДДС.Расход)
	|			ТОГДА 2
	|	КОНЕЦ КАК ИндексКартинки,
	|	CW_СтатьиДДС.ЭтоГруппа КАК ЭтоГруппа
	|ИЗ
	|	Справочник.CW_СтатьиДДС КАК CW_СтатьиДДС
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.CW_ПраваДоступаДляСтатейДДС КАК CW_ПраваДоступаДляСтатейДДС
	|		ПО (CW_ПраваДоступаДляСтатейДДС.СтатьяДДС = CW_СтатьиДДС.Ссылка)
	|			И (CW_ПраваДоступаДляСтатейДДС.ГруппаПользователя = &ГруппаПользователя)
	|ГДЕ
	|	НЕ CW_СтатьиДДС.ЭтоГруппа
	|
	|УПОРЯДОЧИТЬ ПО
	|	ЭтоГруппа УБЫВ,
	|	СтатьяДДС
	|ИТОГИ ПО
	|	СтатьяДДС ИЕРАРХИЯ
	|АВТОУПОРЯДОЧИВАНИЕ";
	
	Запрос.Параметры.Вставить("ГруппаПользователя",ГруппаПользователя);
	РезультатЗапроса = Запрос.Выполнить();
	
	ДеревоСтатей = Запрос.Выполнить().Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкамСИерархией);
	
	ОбработатьДеревоСтатей(ДеревоСтатей.Строки);
	
	ЗаполнитьФлагиГруппДерева(ДеревоСтатей.Строки);
	
	ЗначениеВРеквизитФормы(ДеревоСтатей, "ДеревоСтатейДДС");
	
КонецПроцедуры

&НаСервере
Процедура ПолучитьФлагГруппыНаСервере(ГруппаДерева, ИмяПоля)
	
	СтрокиГруппы = ГруппаДерева.Строки;
	
	мЗначенияПометок = Новый Массив;
	Для Каждого СтрокаДерева из СтрокиГруппы ЦИкл
		
		Если СтрокаДерева.ЭтоГруппа Тогда
			ПолучитьФлагГруппыНаСервере(СтрокаДерева, "Просмотр");
			ПолучитьФлагГруппыНаСервере(СтрокаДерева, "Использование");
		КонецЕсли;
		
		Пометка = СтрокаДерева[ИмяПоля];
		Если мЗначенияПометок.Найти(Пометка) = Неопределено Тогда
			мЗначенияПометок.Добавить(Пометка);
		КонецЕсли;
	КонецЦикла;
	
	Если мЗначенияПометок.Количество() = 1 Тогда
		ГруппаДерева[ИмяПоля] = мЗначенияПометок[0];
	Иначе
		ГруппаДерева[ИмяПоля] = 2;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьФлагиГруппДерева(СтрокиДерева)
	
	Для Каждого СтрокаДерева из СтрокиДерева Цикл
		Если СтрокаДерева.ЭтоГруппа Тогда
			ПолучитьФлагГруппыНаСервере(СтрокаДерева, "Просмотр");
			ПолучитьФлагГруппыНаСервере(СтрокаДерева, "Использование");
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ОбработатьДеревоСтатей(СтрокиДерева)
	
	Для Каждого СтрокаДерева из СтрокиДерева Цикл
		Если СтрокаДерева.ЭтоГруппа Тогда
			ОбработатьДеревоСтатей(СтрокаДерева.Строки);
		Иначе
			СтрокаВИерархии = СтрокаДерева.Строки[0];
			ЗаполнитьЗначенияСвойств(СтрокаДерева, СтрокаВИерархии,"Просмотр,Использование");
			
			СтрокаДерева.Строки.Удалить(СтрокаВИерархии);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьДоступныеСтатьиДДСВРегистр()
		
	Набор = РегистрыСведений.CW_ПраваДоступаДляСтатейДДС.СоздатьНаборЗаписей();
	Набор.Отбор.ГруппаПользователя.Установить(Объект.Ссылка);
	Набор.Очистить();
	
	Если ПолучитьФункциональнуюОпцию("CW_ИспользуетсяБлокПланированиеДДС") Тогда
		
		ЭлементыДерева = ДеревоСтатейДДС.ПолучитьЭлементы();
		ДобавитьДанныеВНаборПравДДС(ЭлементыДерева, Набор);
		
	КонецЕсли;
	
	Набор.Отбор.ГруппаПользователя.Установить(Объект.Ссылка);
	Набор.Записать(Истина);

КонецПроцедуры

&НаСервере
Процедура ДобавитьДанныеВНаборПравДДС(ЭлементыДерева, Набор)
	
	Для Каждого СтрокаДерева из ЭлементыДерева Цикл
		Если СтрокаДерева.Просмотр = 0 Тогда
			Продолжить;
		КонецЕсли;
		Если СтрокаДерева.ЭтоГруппа Тогда
			ДобавитьДанныеВНаборПравДДС(СтрокаДерева.ПолучитьЭлементы(), Набор);
			Продолжить;
		КонецЕсли;
		
		СтрокаНабора = Набор.Добавить();
		СтрокаНабора.ГруппаПользователя = Объект.Ссылка;
		СтрокаНабора.СтатьяДДС 			= СтрокаДерева.СтатьяДДС;
		СтрокаНабора.Использование 		= СтрокаДерева.Использование;
		
	КонецЦикла;
	
КонецПроцедуры


&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	ОповеститьОбИзменении(Тип("СправочникСсылка.CW_ПланированиеДДС"));
	ОбновитьИнтерфейсПрограммы();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьИнтерфейсПрограммы()
	
	Если ОбновитьИнтерфейс = Истина Тогда
		ОбновитьИнтерфейс = Ложь;
		ОбщегоНазначенияКлиент.ОбновитьИнтерфейсПрограммы();
	КонецЕсли;
	
КонецПроцедуры


&НаКлиенте
Процедура РольФинансовогоКонтролераПриИзменении(Элемент)
	
	ОбновитьИнтерфейс = истина;
	
КонецПроцедуры

&НаКлиенте
Процедура РольКазначеяПриИзменении(Элемент)
	
	ОбновитьИнтерфейс = истина;

