&НаКлиенте
Процедура ОбработкаДобавленияПользователя(Ответ, ДополнительныеПараметры) Экспорт
	// --- 
	
	Если (Ответ <> Неопределено) Тогда
		
		Результат = _ДобавитьПользователя(Ответ);
		Если (НЕ _УФКС.ВыполненоУспешно(Результат)) Тогда
			_УФК.ВывестиПредупреждение(_УФКС.ПредставлениеОшибки(Результат));
		Иначе
			Элементы.Состав.Обновить();
		КонецЕсли; 
		
	КонецЕсли; 
	
	// --- 
КонецПроцедуры

&НаСервере
Функция _ДобавитьПользователя(мПользователей)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Пользователи.Ссылка КАК Пользователь
	               |ПОМЕСТИТЬ ВТ_ВыбранныеПользователи
	               |ИЗ
	               |	Справочник.Пользователи КАК Пользователи
	               |ГДЕ
	               |	Пользователи.Ссылка В(&мПользователей)
	               |
	               |ИНДЕКСИРОВАТЬ ПО
	               |	Пользователь
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	CW_ПараметрыПользователей.Пользователь КАК Пользователь
	               |ПОМЕСТИТЬ ВТ_ПользователиВГруппе
	               |ИЗ
	               |	РегистрСведений.CW_ПараметрыПользователей КАК CW_ПараметрыПользователей
	               |ГДЕ
	               |	CW_ПараметрыПользователей.Группа = &Группа
	               |	И CW_ПараметрыПользователей.Пользователь В(&мПользователей)
	               |
	               |ИНДЕКСИРОВАТЬ ПО
	               |	Пользователь
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ_ВыбранныеПользователи.Пользователь КАК Пользователь,
	               |	ВЫБОР
	               |		КОГДА ВТ_ПользователиВГруппе.Пользователь ЕСТЬ NULL
	               |			ТОГДА ЛОЖЬ
	               |		ИНАЧЕ ИСТИНА
	               |	КОНЕЦ КАК МожноДобавить
	               |ПОМЕСТИТЬ ВТ_Итоговая
	               |ИЗ
	               |	ВТ_ВыбранныеПользователи КАК ВТ_ВыбранныеПользователи
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ПользователиВГруппе КАК ВТ_ПользователиВГруппе
	               |		ПО ВТ_ВыбранныеПользователи.Пользователь = ВТ_ПользователиВГруппе.Пользователь
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ_Итоговая.Пользователь КАК Пользователь
	               |ИЗ
	               |	ВТ_Итоговая КАК ВТ_Итоговая
	               |ГДЕ
	               |	НЕ ВТ_Итоговая.МожноДобавить";
	
	Запрос.УстановитьПараметр("мПользователей"	, мПользователей);
	Запрос.УстановитьПараметр("Группа"			, Объект.Ссылка); 
	
	РезультатЗапроса = Запрос.Выполнить();
	
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат(_УФКС.Ответ(1,"Пользователь(и) уже принадлежат группе"));
	КонецЕсли;

	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Запись = РегистрыСведений.CW_ПараметрыПользователей.СоздатьМенеджерЗаписи();
		Запись.Пользователь = Выборка.Пользователь;
		Запись.Группа = Объект.Ссылка;
		Запись.Записать(Истина);
		
	КонецЦикла; 
	
	Возврат(_УФКС.Ответ());
	
	// --- 
КонецФункции

&НаКлиенте
Процедура РедактированиеФинансов_Расходы_СчетаПриИзменении(Элемент)
	
	// если сняли флаг
	Если Объект.РедактированиеФинансов_Расходы_Счета = Ложь Тогда
		Объект.РедактированиеСроковОплатыВходящихСчетов = Ложь;
		
		// если акт то же не доступен для редактирования, 
		// то снимаем флаг редактирования способа НДС
		Если Объект.РедактированиеФинансов_Расходы_Акты = Ложь Тогда
			Объект.РедактированиеСпособаУчетаНДС = Ложь;
			Объект.РедактированиеВозвратаОригиналовОтПоставщика = Ложь;
		КонецЕсли;
		
		Объект.РазрешитьРедактированиеВходящихОплаченныхСчетов		= Ложь;
		Объект.РазрешитьРедактированиеВходящихАктированныхСчетов 	= Ложь;
		
	КонецЕсли; 
	
	_УправлениеЭлементамиФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура РедактированиеФинансов_Доходы_СчетаПриИзменении(Элемент)
	
	// сняли флаг
	Если Объект.РедактированиеФинансов_Доходы_Счета = Ложь Тогда
		Объект.РедактированиеВозвратаОригиналовОтКлиента = Ложь;
		Объект.РедактированиеСроковОплатыИсходящихСчетов = Ложь;
		
		// если акт то же не доступен для редактирования, то снимаем флаг изменения номеров
		Если Объект.РедактированиеФинансов_Доходы_Акты = Ложь Тогда
			Объект.РедактированиеНомеровПервичныхДокументов = Ложь;
		КонецЕсли;
		
		Объект.РазрешитьРедактированиеИсходящихАктированныхСчетов	= Ложь;
		Объект.РазрешитьРедактированиеИсходящихОплаченныхСчетов 	= Ложь;
		 
	КонецЕсли; 
	
	_УправлениеЭлементамиФормы();
	
КонецПроцедуры

