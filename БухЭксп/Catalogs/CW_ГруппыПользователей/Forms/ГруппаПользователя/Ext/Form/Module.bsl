//Статусы документов
&НаСервере
Процедура ЗаполнитьДеревоСтатусов(ГруппаПользователя)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	CW_СтатусыДокументов.Владелец КАК Владелец,
	               |	CW_СтатусыДокументов.Ссылка КАК Статус,
	               |	ВЫБОР
	               |		КОГДА ВложенныйЗапрос.СтатусДокумента ЕСТЬ NULL
	               |			ТОГДА 0
	               |		ИНАЧЕ 1
	               |	КОНЕЦ КАК Доступен
	               |ИЗ
	               |	Справочник.CW_СтатусыДокументов КАК CW_СтатусыДокументов
	               |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	               |			CW_ДоступностьСтатусовПоГруппамПользователей.СтатусДокумента КАК СтатусДокумента
	               |		ИЗ
	               |			РегистрСведений.CW_ДоступностьСтатусовПоГруппамПользователей КАК CW_ДоступностьСтатусовПоГруппамПользователей
	               |		ГДЕ
	               |			CW_ДоступностьСтатусовПоГруппамПользователей.ГруппаПользователя = &ГруппаПользователя) КАК ВложенныйЗапрос
	               |		ПО CW_СтатусыДокументов.Ссылка = ВложенныйЗапрос.СтатусДокумента
	               |//ГДЕ
	               |//	НЕ CW_СтатусыДокументов.НазначатьДляНовыхОбъектов 
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Владелец
	               |ИТОГИ ПО
	               |	Владелец
	               |АВТОУПОРЯДОЧИВАНИЕ";
	
	Запрос.УстановитьПараметр("ГруппаПользователя", ГруппаПользователя);
	
	ВыборкаВладелец = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	ЭлементыДерева = ДоступныеСтатусыДокументов.ПолучитьЭлементы();
	ЭлементыДерева.Очистить();
	
	Пока ВыборкаВладелец.Следующий() Цикл
		
		СтрокаДереваГруппа = ЭлементыДерева.Добавить();
		СтрокаДереваГруппа.Статус  		= Неопределено;
		СтрокаДереваГруппа.Наименование = ВыборкаВладелец.Владелец;
		СтрокаДереваГруппа.ЭтоГруппа  	= Истина;
		
		ВыборкаДетали = ВыборкаВладелец.Выбрать();
		
		ЭлементыГруппы = СтрокаДереваГруппа.ПолучитьЭлементы();
		
		ВсегоПометокВГруппе = 0;
		Пока ВыборкаДетали.Следующий() Цикл
			
			СтрокаДерева 				= ЭлементыГруппы.Добавить();
			СтрокаДерева.Статус  		= ВыборкаДетали.Статус;
			СтрокаДерева.Доступен  		= ВыборкаДетали.Доступен;
			СтрокаДерева.Наименование 	= ВыборкаДетали.Статус;
			СтрокаДерева.ЭтоГруппа  	= Ложь;
			СтрокаДерева.ИндексКартинки = 1;
			
			ВсегоПометокВГруппе = ВсегоПометокВГруппе + ВыборкаДетали.Доступен;
		КонецЦикла;	
		
		Если ВсегоПометокВГруппе = 0 Тогда
			СтрокаДереваГруппа.Доступен = 0;
		ИначеЕсли ВсегоПометокВГруппе = ЭлементыГруппы.Количество() Тогда
			СтрокаДереваГруппа.Доступен = 1;
		Иначе
			СтрокаДереваГруппа.Доступен = 2;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ДоступныеСтатусыДокументовДоступенПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ДоступныеСтатусыДокументов.ТекущиеДанные;
	
	Если ТекущиеДанные.Доступен > 1 Тогда
		ТекущиеДанные.Доступен = 0;
	КонецЕсли;
	
	УстановитьСопутствующиеФлаги(Элементы.ДоступныеСтатусыДокументов.ТекущаяСтрока);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьСопутствующиеФлаги(ИдентификаторСтроки)
	
	СтрокаТекущая = ДоступныеСтатусыДокументов.НайтиПоИдентификатору(ИдентификаторСтроки);
	
	Если СтрокаТекущая.ЭтоГруппа Тогда
		ЭлементыСтроки = СтрокаТекущая.ПолучитьЭлементы();
		Для Каждого СтрокаДерева из ЭлементыСтроки ЦИкл
			СтрокаДерева.Доступен = СтрокаТекущая.Доступен;
		КонецЦикла;
	Иначе
		СтрокаРодитель 		= СтрокаТекущая.ПолучитьРодителя();
		ЭлементыРодителя 	= СтрокаРодитель.ПолучитьЭлементы();
		ВсегоПометокВГруппе = 0;
		Для Каждого СтрокаДерева из ЭлементыРодителя ЦИкл
			ВсегоПометокВГруппе = ВсегоПометокВГруппе + СтрокаДерева.Доступен;
		КонецЦикла;
		
		Если ВсегоПометокВГруппе = 0 Тогда
			СтрокаРодитель.Доступен = 0;
		ИначеЕсли ВсегоПометокВГруппе = ЭлементыРодителя.Количество() Тогда
			СтрокаРодитель.Доступен = 1;
		Иначе
			СтрокаРодитель.Доступен = 2;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьДоступныеСтатусыВРегистр()
	
	Набор = РегистрыСведений.CW_ДоступностьСтатусовПоГруппамПользователей.СоздатьНаборЗаписей();
	Набор.Отбор.ГруппаПользователя.Установить(Объект.Ссылка);
	Набор.Очистить();
	
	Если ПолучитьФункциональнуюОпцию("CW_ИспользуютсяСтатусыДокументов") Тогда
		
		ЭлементыДерева = ДоступныеСтатусыДокументов.ПолучитьЭлементы();
		
		Для Каждого СтрокаДерева из ЭлементыДерева Цикл
			ДобавитьДанныеВНабор(СтрокаДерева, Набор);
		КонецЦикла;
		
	КонецЕсли;
	
	Набор.Отбор.ГруппаПользователя.Установить(Объект.Ссылка);
	Набор.Записать(Истина);
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьДанныеВНабор(СтрокаГруппа, Набор)
	
	ЭлементыГруппы = СтрокаГруппа.ПолучитьЭлементы();
	
	Для Каждого СтрокаДерева из ЭлементыГруппы Цикл
		Если СтрокаДерева.Доступен = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаНабора = Набор.Добавить();
		СтрокаНабора.ГруппаПользователя = 	Объект.Ссылка;
		СтрокаНабора.СтатусДокумента =		СтрокаДерева.Статус;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура СтатусыИсходящихДокументовСнятьФлажки(Команда)

	ЭлементыДерева = ДоступныеСтатусыДокументов.ПолучитьЭлементы();
	
	Для Каждого СтрокаДерева из ЭлементыДерева Цикл
		СтрокаДерева.Доступен = 0;
		Идентификатор = СтрокаДерева.ПолучитьИдентификатор();
		УстановитьСопутствующиеФлаги(Идентификатор);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура СтатусыИсходящихДокументовУстановитьФлажки(Команда)
	
	ЭлементыДерева = ДоступныеСтатусыДокументов.ПолучитьЭлементы();
	
	Для Каждого СтрокаДерева из ЭлементыДерева Цикл
		СтрокаДерева.Доступен = 1;
		Идентификатор = СтрокаДерева.ПолучитьИдентификатор();
		УстановитьСопутствующиеФлаги(Идентификатор);
	КонецЦикла;
	
КонецПроцедуры
//Статусы документов

//Права параметров
&НаСервере
Процедура ЗаполнитьДеревоПравПараметров(ГруппаПользователя)   
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	CW_ПараметрыГрузоперевозок.Ссылка КАК Параметр,
	|	0 КАК ИндексКартинки,
	|	CW_ПараметрыГрузоперевозок.ЭтоГруппа КАК ЭтоГруппа,
	|	ЕСТЬNULL(CW_ПраваДоступаДляПараметровМониторинга.Просмотр, ЛОЖЬ) КАК ПравоПросмотр,
	|	ЕСТЬNULL(CW_ПраваДоступаДляПараметровМониторинга.Редактирование, ЛОЖЬ) КАК ПравоРедактирование
	|ИЗ
	|	ПланВидовХарактеристик.CW_ПараметрыГрузоперевозок КАК CW_ПараметрыГрузоперевозок
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.CW_ПраваДоступаДляПараметровМониторинга КАК CW_ПраваДоступаДляПараметровМониторинга
	|		ПО CW_ПараметрыГрузоперевозок.Ссылка = CW_ПраваДоступаДляПараметровМониторинга.Параметр
	|			И (CW_ПраваДоступаДляПараметровМониторинга.Группа = &ГруппаПользователя)
	|ГДЕ
	|	CW_ПараметрыГрузоперевозок.ЭтоГруппа = ЛОЖЬ
	|
	|УПОРЯДОЧИТЬ ПО
	|	ЭтоГруппа УБЫВ,
	|	Параметр
	|ИТОГИ ПО
	|	Параметр ИЕРАРХИЯ
	|АВТОУПОРЯДОЧИВАНИЕ";    
	
	Запрос.УстановитьПараметр("ГруппаПользователя", ГруппаПользователя);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ДеревоПрав = Запрос.Выполнить().Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкамСИерархией);
	
	ОбработатьДеревоПравПараметров(ДеревоПрав.Строки);
	
	ЗначениеВРеквизитФормы(ДеревоПрав, "ДеревоПравПараметров");

КонецПроцедуры    

&НаСервере
Процедура ОбработатьДеревоПравПараметров(СтрокиДерева)
	
	Для Каждого СтрокаДерева из СтрокиДерева Цикл 
		СтрокаДерева.ИндексКартинки = CW_МониторинговыеПараметрыСервер.ПолучитьИндексПиктограммыПараметраОбъекта(СтрокаДерева.Параметр);
		Если СтрокаДерева.ЭтоГруппа  Тогда
			ОбработатьДеревоПравПараметров(СтрокаДерева.Строки);
		Иначе
			Если СтрокаДерева.Строки.Количество() > 0 Тогда 
				СтрокаВИерархии = СтрокаДерева.Строки[0];
				ЗаполнитьЗначенияСвойств(СтрокаДерева, СтрокаВИерархии,"ПравоПросмотр,ПравоРедактирование");
				СтрокаДерева.Строки.Очистить();
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьДанныеПравНаПараметры()
	
	Набор = РегистрыСведений.CW_ПраваДоступаДляПараметровМониторинга.СоздатьНаборЗаписей();
	Набор.Отбор.Группа.Установить(Объект.Ссылка);
	Набор.Прочитать();
	Набор.Очистить();
	
	ДеревоЗначений = РеквизитФормыВЗначение("ДеревоПравПараметров"); 
	
	СтруктураПараметровОтбора = Новый Структура;
	СтруктураПараметровОтбора.Вставить("ЭтоГруппа", Ложь);
	
	СтрокиПараметров = ДеревоЗначений.Строки.НайтиСтроки(СтруктураПараметровОтбора, Истина);  
	Для Каждого СтрокаПараметра из СтрокиПараметров Цикл
		Если НЕ СтрокаПараметра.ПравоПросмотр
			И НЕ СтрокаПараметра.ПравоРедактирование Тогда
			Продолжить;
		КонецЕсли;
		
		ЗаписьНабора = Набор.Добавить();
		ЗаписьНабора.Группа = Объект.Ссылка;
		ЗаписьНабора.Параметр = СтрокаПараметра.Параметр;
		ЗаписьНабора.Просмотр = СтрокаПараметра.ПравоПросмотр;
		ЗаписьНабора.Редактирование = СтрокаПараметра.ПравоРедактирование;
	КонецЦикла;
	
	Набор.Записать(Истина);
	
КонецПроцедуры
//---Права параметров

//Редактирование справочников
&НаСервере
Процедура ЗаполнитьДеревоНастроекРедактированияСправочников(ГруппаПользователя)
	
	СоответствиеВладельцев = РегистрыСведений.CW_ОбъектыОграниченийДоступа.ПолучитьДосупныеОбъектыРедактирования();
	
	мИдентифкаторы = Новый Массив;
	Для каждого ЭлементСоответствия из СоответствиеВладельцев Цикл
		мИдентифкаторы.Добавить(ЭлементСоответствия.Ключ);
	КонецЦикла;
	
	Запрос = новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	CW_ОбъектыОграниченийДоступа.ИдентификаторОбъектаМетаданных КАК ИдентификаторОбъекта,
	               |	CW_ОбъектыОграниченийДоступа.ВладелецОбъекта КАК ВладелецОбъекта
	               |ИЗ
	               |	РегистрСведений.CW_ОбъектыОграниченийДоступа КАК CW_ОбъектыОграниченийДоступа";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ВладелецОбъекта = СоответствиеВладельцев.Получить(Выборка.ИдентификаторОбъекта);
		Если ВладелецОбъекта = Неопределено Тогда
			СоответствиеВладельцев.Вставить(Выборка.ИдентификаторОбъекта, Выборка.ВладелецОбъекта);
		КонецЕсли;
	КонецЦикла;
	
	ЭлементыДерева = ДеревоРедактированияСправочников.ПолучитьЭлементы();
	ЭлементыДерева.Очистить();
	
	МассивВладельцев = Новый Массив;
	МассивВладельцев.Добавить(ПредопределенноеЗначение("Перечисление.CW_ВладелецОбъектаДоступа.ЗначениеБухгалтерияПредприятия"));
	МассивВладельцев.Добавить(ПредопределенноеЗначение("Перечисление.CW_ВладелецОбъектаДоступа.ЗначениеКоралВэй"));
	
	//Создаем группы дерева
	СоответстивеГруппДерева = Новый Соответствие;
	Для каждого ЭлементМассива из МассивВладельцев Цикл
		СтрокаДереваГруппа = ЭлементыДерева.Добавить();
		СтрокаДереваГруппа.Наименование 		= СокрЛП(ЭлементМассива);
		СтрокаДереваГруппа.ИдентификаторОбъекта	= ЭлементМассива;
		СтрокаДереваГруппа.ИндексКартинки 		= 2;
		СтрокаДереваГруппа.ЭтоГруппа  			= Истина;
		
		СоответстивеГруппДерева.Вставить(ЭлементМассива, СтрокаДереваГруппа); 
	КонецЦикла;

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ИдентификаторыОбъектовМетаданных.Ссылка КАК ИдентификаторОбъекта,
	               |	ИдентификаторыОбъектовМетаданных.Синоним КАК Синоним,
	               |	ИдентификаторыОбъектовМетаданных.ПолноеИмя КАК ПолноеИмя,
	               |	ИСТИНА КАК Предопределенный
	               |ПОМЕСТИТЬ ВТ_Предопределенные
	               |ИЗ
	               |	Справочник.ИдентификаторыОбъектовМетаданных КАК ИдентификаторыОбъектовМетаданных
	               |ГДЕ
	               |	ИдентификаторыОбъектовМетаданных.Ссылка В(&мИдентифкаторы)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	CW_ОбъектыОграниченийДоступа.ИдентификаторОбъектаМетаданных КАК ИдентификаторОбъекта,
	               |	CW_ОбъектыОграниченийДоступа.ИдентификаторОбъектаМетаданных.Синоним КАК Синоним,
	               |	CW_ОбъектыОграниченийДоступа.ИдентификаторОбъектаМетаданных.ПолноеИмя КАК ПолноеИмя,
	               |	ЛОЖЬ КАК Предопределенный
	               |ПОМЕСТИТЬ ВТ_Пользовательские
	               |ИЗ
	               |	РегистрСведений.CW_ОбъектыОграниченийДоступа КАК CW_ОбъектыОграниченийДоступа
	               |ГДЕ
	               |	НЕ CW_ОбъектыОграниченийДоступа.ИдентификаторОбъектаМетаданных В
	               |				(ВЫБРАТЬ
	               |					ВТ_Предопределенные.ИдентификаторОбъекта КАК ИдентификаторОбъекта
	               |				ИЗ
	               |					ВТ_Предопределенные КАК ВТ_Предопределенные)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ_Предопределенные.ИдентификаторОбъекта КАК ИдентификаторОбъекта,
	               |	ВТ_Предопределенные.Синоним КАК Синоним,
	               |	ВТ_Предопределенные.ПолноеИмя КАК ПолноеИмя,
	               |	ВТ_Предопределенные.Предопределенный КАК Предопределенный
	               |ПОМЕСТИТЬ ВТ_Идентифкаторы
	               |ИЗ
	               |	ВТ_Предопределенные КАК ВТ_Предопределенные
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ВТ_Пользовательские.ИдентификаторОбъекта,
	               |	ВТ_Пользовательские.Синоним,
	               |	ВТ_Пользовательские.ПолноеИмя,
	               |	ВТ_Пользовательские.Предопределенный
	               |ИЗ
	               |	ВТ_Пользовательские КАК ВТ_Пользовательские
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ_Идентифкаторы.ИдентификаторОбъекта КАК ИдентификаторОбъекта,
	               |	ВТ_Идентифкаторы.Синоним КАК Синоним,
	               |	ВТ_Идентифкаторы.ПолноеИмя КАК ПолноеИмя,
	               |	ВТ_Идентифкаторы.Предопределенный КАК Предопределенный,
	               |	ВЫБОР
	               |		КОГДА CW_ДоступныеСправочникиПоГруппамПользователей.ИдентификаторОбъектаМетаданных ЕСТЬ NULL
	               |			ТОГДА ЛОЖЬ
	               |		ИНАЧЕ ИСТИНА
	               |	КОНЕЦ КАК Флаг
	               |ИЗ
	               |	ВТ_Идентифкаторы КАК ВТ_Идентифкаторы
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.CW_ДоступныеСправочникиПоГруппамПользователей КАК CW_ДоступныеСправочникиПоГруппамПользователей
	               |		ПО ВТ_Идентифкаторы.ИдентификаторОбъекта = CW_ДоступныеСправочникиПоГруппамПользователей.ИдентификаторОбъектаМетаданных
	               |			И (CW_ДоступныеСправочникиПоГруппамПользователей.ГруппаПользователя = &ГруппаПользователя)
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Предопределенный УБЫВ,
	               |	Синоним
	               |АВТОУПОРЯДОЧИВАНИЕ";
	 	
	Запрос.УстановитьПараметр("ГруппаПользователя",	ГруппаПользователя);
	Запрос.УстановитьПараметр("мИдентифкаторы",		мИдентифкаторы);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Если НЕ ОбщегоНазначения.ОбъектМетаданныхДоступенПоФункциональнымОпциям(Выборка.ПолноеИмя) Тогда
			Продолжить;
		КонецЕсли;
		
		ВладелецОбъекта 	= СоответствиеВладельцев.Получить(Выборка.ИдентификаторОбъекта);
	
		СтрокаДереваГруппа 	= СоответстивеГруппДерева.Получить(ВладелецОбъекта);
		ЭлементыГруппы 		= СтрокаДереваГруппа.ПолучитьЭлементы();
		
		СтрокаДерева = ЭлементыГруппы.Добавить();
		СтрокаДерева.Наименование  			= Выборка.Синоним;
		СтрокаДерева.ИдентификаторОбъекта	= Выборка.ИдентификаторОбъекта;
		СтрокаДерева.Флаг 					= Выборка.Флаг;
		СтрокаДерева.ИндексКартинки 		= ?(Выборка.Предопределенный, 5, 3);
		СтрокаДерева.ЭтоГруппа  			= Ложь;
		
	КонецЦикла;
	
	//Флажки групп
	ЭлементыДерева =  ДеревоРедактированияСправочников.ПолучитьЭлементы();
	Для Каждого СтрокаГруппа Из  ЭлементыДерева  Цикл
		
		СтрокиДерева =  СтрокаГруппа.ПолучитьЭлементы();
		ПометкиСтрок 	= 0;
		Для Каждого СтрокаДерева Из  СтрокиДерева  Цикл
			ПометкиСтрок = ПометкиСтрок + СтрокаДерева.Флаг;
		КонецЦикла;
		
		Если ПометкиСтрок = 0 Тогда
			СтрокаГруппа.Флаг = 0;
		ИначеЕсли ПометкиСтрок = СтрокиДерева.Количество() Тогда
			СтрокаГруппа.Флаг = 1;
		Иначе
			СтрокаГруппа.Флаг = 2;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоРедактированияСправочниковФлагПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ДеревоРедактированияСправочников.ТекущиеДанные;
	
	Если ТекущиеДанные.Флаг > 1 Тогда
		ТекущиеДанные.Флаг = 0;
	КонецЕсли;
	
	УстановитьСопутствующиеФлагиДеревоРедактированияСправочников(Элементы.ДеревоРедактированияСправочников.ТекущаяСтрока);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьСопутствующиеФлагиДеревоРедактированияСправочников(ИдентификаторСтроки)
	
	СтрокаТекущая = ДеревоРедактированияСправочников.НайтиПоИдентификатору(ИдентификаторСтроки);
	
	Если СтрокаТекущая.ЭтоГруппа Тогда
		ЭлементыСтроки = СтрокаТекущая.ПолучитьЭлементы();
		Для Каждого СтрокаДерева из ЭлементыСтроки ЦИкл
			СтрокаДерева.Флаг = СтрокаТекущая.Флаг;
		КонецЦикла;
	Иначе
		СтрокаРодитель 		= СтрокаТекущая.ПолучитьРодителя();
		ЭлементыРодителя 	= СтрокаРодитель.ПолучитьЭлементы();
		
		ВсегоПометокВГруппе = 0;
		Для Каждого СтрокаДерева из ЭлементыРодителя ЦИкл
			ВсегоПометокВГруппе = ВсегоПометокВГруппе + СтрокаДерева.Флаг;
		КонецЦикла;
		
		Если ВсегоПометокВГруппе = 0 Тогда
			СтрокаРодитель.Флаг = 0;
		ИначеЕсли ВсегоПометокВГруппе = ЭлементыРодителя.Количество() Тогда
			СтрокаРодитель.Флаг = 1;
		Иначе
			СтрокаРодитель.Флаг = 2;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РедактированиеСправочниковСнятьФлажки(Команда)
	
	ОбработатьФлажкиДереваСправочников(0);
	
КонецПроцедуры

&НаКлиенте
Процедура РедактированиеСправочниковУстановитьФлажки(Команда)
	
	ОбработатьФлажкиДереваСправочников(1);

КонецПроцедуры

&НаКлиенте
Процедура ОбработатьФлажкиДереваСправочников(Флаг)
	
	ЭлементыДерева = ДеревоРедактированияСправочников.ПолучитьЭлементы();
	
	Для Каждого СтрокаДерева из ЭлементыДерева Цикл
		СтрокаДерева.Флаг = Флаг;
		Идентификатор = СтрокаДерева.ПолучитьИдентификатор();
		УстановитьСопутствующиеФлагиДеревоРедактированияСправочников(Идентификатор);
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура РедактированиеСправочниковУстановитьФлажкиДляВыделенныхСтрок(Команда)
	
	ОбрабоатьФлажкиВыделенныхСтрок(1);

КонецПроцедуры

&НаКлиенте
Процедура РедактированиеСправочниковСнятьФлажкиДляВыделенныхСтрок(Команда)
	
	ОбрабоатьФлажкиВыделенныхСтрок(0);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбрабоатьФлажкиВыделенныхСтрок(Флаг)
	
	
	ВыделенныеСтроки = Элементы.ДеревоРедактированияСправочников.ВыделенныеСтроки;
	
	Для Каждого Идентификатор из ВыделенныеСтроки Цикл
		СтрокаДерева = ДеревоРедактированияСправочников.НайтиПоИдентификатору(Идентификатор);
		СтрокаДерева.Флаг = Флаг;
		УстановитьСопутствующиеФлагиДеревоРедактированияСправочников(Идентификатор);
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ЗаписатьРазрешенныеСправочникиВРегистр()
	
	НаборОбъектыОграничений = РегистрыСведений.CW_ОбъектыОграниченийДоступа.СоздатьНаборЗаписей();
	
	НаборДоступныеСправочники = РегистрыСведений.CW_ДоступныеСправочникиПоГруппамПользователей.СоздатьНаборЗаписей();
	НаборДоступныеСправочники.Отбор.ГруппаПользователя.Установить(Объект.Ссылка);
	
	ЭлементыДерева = ДеревоРедактированияСправочников.ПолучитьЭлементы();
	Для Каждого СтрокаДереваГруппа из ЭлементыДерева Цикл
		
		ЭлементыГруппы = СтрокаДереваГруппа.ПолучитьЭлементы();
		Для Каждого СтрокаДерева из ЭлементыГруппы Цикл
			
			Если СтрокаДерева.Флаг = 1 Тогда
				СтрокаНабора = НаборДоступныеСправочники.Добавить();
				СтрокаНабора.ГруппаПользователя 			= Объект.Ссылка;
				СтрокаНабора.ИдентификаторОбъектаМетаданных = СтрокаДерева.ИдентификаторОбъекта;
			КонецЕсли;
			
			СтрокаНабора = НаборОбъектыОграничений.Добавить();
			СтрокаНабора.ВладелецОбъекта 				= СтрокаДереваГруппа.ИдентификаторОбъекта;
			СтрокаНабора.ИдентификаторОбъектаМетаданных = СтрокаДерева.ИдентификаторОбъекта;
			
		КонецЦикла;
		
	КонецЦикла;
	
	НаборОбъектыОграничений.Записать(Истина);
	НаборДоступныеСправочники.Записать(Истина);

КонецПроцедуры
//Редактирование справочников

&НаСервере
Процедура ЗаписатьПраваРедактированияШаблонов()
	
	НаборЗаписей = РегистрыСведений.CW_ШаблоныДокументовПраваДоступа.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.ГруппаПользователя.Установить(Объект.Ссылка);
	НаборЗаписей.Прочитать();
	
	НаборЗаписей.Очистить();
	
	Для Каждого СтрокаТаблицы из ПраваРедактирвоанияШаблонов Цикл
		 НоваяСтрока = НаборЗаписей.Добавить();
		 НоваяСтрока.ГруппаПользователя = Объект.Ссылка;
		 
		 НоваяСтрока.ИдентификаторОбъектаМетаданных 	= СтрокаТаблицы.ИдентификаторОбъектаМетаданных;
		 НоваяСтрока.РедактированиеШаблонаДокумента 	= СтрокаТаблицы.РедактированиеШаблонаДокумента;
		 НоваяСтрока.РедактированиеОбщегоШаблона 		= СтрокаТаблицы.РедактированиеОбщегоШаблона;
		 НоваяСтрока.РедактированиеМакросовШаблона		= СтрокаТаблицы.РедактированиеМакросовШаблона;
		 
	 КонецЦикла;      
	 
	 НаборЗаписей.Записать(Истина);
	
КонецПроцедуры


&НаСервере
Процедура ЗаполнитьСписокИнициацииСогласования(ГруппаПользователя)  
	
	ГруппаПользователей = ?(ГруппаПользователя.Пустая(), Неопределено, ГруппаПользователя);
	
	мИдентифкаторыОбъектов = Новый Массив;
	мТипы = Метаданные.ОпределяемыеТипы.CW_ОбъектыСогласования.Тип.Типы();
	Для Каждого ТипОбъекта из мТипы Цикл
		ИдентификаторОбъекта = ОбщегоНазначения.ИдентификаторОбъектаМетаданных(ТипОбъекта);
		мИдентифкаторыОбъектов.Добавить(ИдентификаторОбъекта);
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ИдентификаторыОбъектовМетаданных.Ссылка КАК ОбъектМетаданных,
	               |	ЕСТЬNULL(CW_ДоступноИнициацияСогласования.Доступно, ЛОЖЬ) КАК Доступно
	               |ИЗ
	               |	Справочник.ИдентификаторыОбъектовМетаданных КАК ИдентификаторыОбъектовМетаданных
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.CW_ДоступноИнициацияСогласования КАК CW_ДоступноИнициацияСогласования
	               |		ПО ИдентификаторыОбъектовМетаданных.Ссылка = CW_ДоступноИнициацияСогласования.ИдентификаторОбъектаМетаданных
	               |			И (CW_ДоступноИнициацияСогласования.ГруппаПользователей = &ГруппаПользователей)
	               |ГДЕ
	               |	ИдентификаторыОбъектовМетаданных.Ссылка В(&мИдентифкаторыОбъектов)";
	
	Запрос.УстановитьПараметр("мИдентифкаторыОбъектов", мИдентифкаторыОбъектов);
	Запрос.УстановитьПараметр("ГруппаПользователей", 	ГруппаПользователей);
	
	РезультатЗапроса = Запрос.Выполнить();
	ИнициацияСогласования.Загрузить(РезультатЗапроса.Выгрузить());
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьИнициациюСогласования()
	
	мОбъекты = Новый Массив; 
	
	Если Объект.ПолныеПрава Тогда
		мСтроки = ИнициацияСогласования.Выгрузить();
	Иначе
		мСтроки = ИнициацияСогласования.НайтиСтроки(Новый Структура("Доступно", Истина));
	КонецЕсли;
	
	Для Каждого СтрокаМассива из мСтроки Цикл
		мОбъекты.Добавить(СтрокаМассива.ОбъектМетаданных);
	КонецЦикла;
	
	РегистрыСведений.CW_ДоступноИнициацияСогласования.ЗаписатьИнициациюСогласования(Объект.Ссылка, мОбъекты);
	
КонецПроцедуры

&НаКлиенте
Процедура ПросмотрБюджетовПриИзменении(Элемент)
	
	Если НЕ Объект.ПросмотрБюджетов Тогда
		Объект.РедактированиеНастроекБюджетов = Ложь;
		Объект.РедактированиеБюджетов = Ложь;
		Объект.ИзменениеКурсаПланирования = Ложь;
		Объект.БюджетированиеРедактированиеСтавкиНДС = Ложь;
	КонецЕсли;
	
	УстановитьДоступностьЭлементовБюджета();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьДоступностьЭлементовБюджета()
	
	Элементы.РедактированиеНастроекБюджетов.Доступность = Объект.ПросмотрБюджетов;
	Элементы.РедактированиеБюджетов.Доступность = Объект.ПросмотрБюджетов;
	Элементы.ИзменениеКурсаПланирования.Доступность = Объект.ПросмотрБюджетов;
	Элементы.БюджетированиеРедактированиеСтавкиНДС.Доступность = Объект.ПросмотрБюджетов;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "КопированиеНастроек" 
		и Параметр = Объект.Ссылка Тогда 
		ЭтаФорма.Прочитать();
	КонецЕсли;     
	
	Если ИмяСобытия = "Запись_CW_ОбъектыОграниченийДоступа" Тогда
		ЗаполнитьДеревоНастроекРедактированияСправочников(Объект.Ссылка);	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДоступностьОрганизацийВсеПриИзменении(Элемент)
	ДоступностьОрганизацийВсеПриИзмененииНаСервере();
КонецПроцедуры 

&НаСервере
Процедура ДоступностьОрганизацийВсеПриИзмененииНаСервере()
	               
	Если Не Объект.ИспользуютсяОграниченияПоОрганизациям Тогда
		ДоступныеОрганизации.Очистить();
	КонецЕсли; 
	
	Элементы.ДоступныеОрганизации.Доступность = Объект.ИспользуютсяОграниченияПоОрганизациям;

КонецПроцедуры

&НаСервере
Процедура ПравоРедактированияСтатусовДокументовПриИзмененииНаСервере()
	_УправлениеЭлементамиФормы();
КонецПроцедуры

&НаКлиенте
Процедура ПравоРедактированияСтатусовДокументовПриИзменении(Элемент)
	ПравоРедактированияСтатусовДокументовПриИзмененииНаСервере();
КонецПроцедуры





