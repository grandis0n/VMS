&НаСервере
Процедура ТекущийТитулПриИзмененииНаСервере()
	
	ПараметрыДокументаЭПД = ПараметрыДокументовЭПД.Получить(Объект.ТипДокументаЭПД); 
	Если ТипЗнч(ПараметрыДокументаЭПД) = Тип("ФиксированнаяСтруктура") тогда 
		
		ИнформацияПоПрефиксамТитула = CW_ОбменГИСЭПДПереопределяемый.ПрефиксТитулаПоЭлементуРегламентаЭДО(Объект.ТекущийТитул);
		ПрефиксТитула = ИнформацияПоПрефиксамТитула.ВПрограмме;
		
		Макет = ПолучитьМакетОбъекта();
		
		ТабличныйДокумент.Очистить();
		ТабличныйДокумент.Вывести(Макет);  
		
		ТабличныйДокумент.ПоказатьУровеньГруппировокСтрок(0);  
		
		ЗаполнитьМакетИзНастроек();                                                     
		
		Если Объект.ТекущийТитул = ПредопределенноеЗначение("Перечисление.ТипыЭлементовРегламентаЭДО.ЭЗЗ_Титул1") Тогда 
			ОбластьДоверенность	= ТабличныйДокумент.Области.Найти("Доверенность");   
			Если ОбластьДоверенность <> Неопределено Тогда
				ТабличныйДокумент.УдалитьОбласть(ОбластьДоверенность, ТипСмещенияТабличногоДокумента.ПоВертикали);
			КонецЕсли; 
			
			Для каждого Область из ТабличныйДокумент.Области Цикл
				Если СтрНачинаетсяС(Область.Имя, "УдалитьСтроку") Тогда
					Область.Гиперссылка = Ложь;
					Область.Текст = "";  
				КонецЕсли; 
			КонецЦикла;     
		КонецЕсли;  
		
	КонецЕсли;  
	
КонецПроцедуры   

&НаСервере
Процедура ЗаполнитьМакетИзНастроек()  
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	CW_ОбменГИСЭПДЗначенияНастроекЗаполненияЭПД.НастройкаЗаполнения КАК НастройкаЗаполнения,
	|	CW_ОбменГИСЭПДЗначенияНастроекЗаполненияЭПД.ИмяТабличнойЧасти КАК ИмяТабличнойЧасти,
	|	CW_ОбменГИСЭПДЗначенияНастроекЗаполненияЭПД.ИмяОбласти КАК ИмяОбласти,
	|	CW_ОбменГИСЭПДЗначенияНастроекЗаполненияЭПД.АлгоритмЗаполнения КАК АлгоритмЗаполнения
	|ИЗ
	|	РегистрСведений.CW_ОбменГИСЭПДЗначенияНастроекЗаполненияЭПД КАК CW_ОбменГИСЭПДЗначенияНастроекЗаполненияЭПД
	|ГДЕ
	|	CW_ОбменГИСЭПДЗначенияНастроекЗаполненияЭПД.НастройкаЗаполнения = &НастройкаЗаполнения";
	
	Запрос.УстановитьПараметр("НастройкаЗаполнения", Объект.Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		ОбластьТабличногоДокумента = ТабличныйДокумент.Области.Найти(Выборка.ИмяОбласти);
		Если ОбластьТабличногоДокумента <> Неопределено Тогда
			ОбластьТабличногоДокумента.Значение = Выборка.АлгоритмЗаполнения;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры   

&НаСервере
Функция ПолучитьМакетОбъекта()
	
	ПараметрыДокументаЭПД = ПараметрыДокументовЭПД.Получить(Объект.ТипДокументаЭПД); 
	ИмяМакета 	= ПараметрыДокументаЭПД["Настройки"].Получить(Объект.ТекущийТитул); 
	Макет 		= Справочники.CW_ОбменГИСЭПДНастройкиЗаполненияЭПД.ПолучитьМакет(ИмяМакета);

	Возврат Макет;
	
КонецФункции


