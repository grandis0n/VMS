&НаКлиенте
Процедура СоздатьАлгоритмыЗаполненияРеквизитов(Команда)  
	
	Отказ = Ложь;
	Если Не ЗначениеЗаполнено(Объект.ТипОбъекта) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не выбран тип объекта!",,"ТипОбъекта", "Объект", Отказ);
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Объект.ТекущийТитул) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не выбран титул!",,"ТекущийТитул", "Объект", Отказ);
	КонецЕсли;   
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;   
	
	Режим = РежимДиалогаВопрос.ДаНет;
	Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопроса", ЭтотОбъект, Параметры);
	ПоказатьВопрос(Оповещение, "Для каждого незаполненного реквизита титула будет найден, а в случае отсутствия будет создан новый алгоритм заполнения. Продолжить?", Режим, 0);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияВопроса(Результат, Параметры) Экспорт
    Если Результат = КодВозвратаДиалога.Нет Тогда
        Возврат;
    КонецЕсли;

	РезультатВыполнения =  ПродолжитьЗаполнениеСправочникАлгоритмыНаСервереВФоне(); 
	Если РезультатВыполнения = Неопределено Тогда 
		ПоказатьПредупреждение(, "Не удалось определить имя макета настроек для титула!");
		Возврат;
	КонецЕсли;
	
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ВыводитьОкноОжидания = Истина; 
	ОповещениеОЗавершении = Новый ОписаниеОповещения("ОбработатьРезультатВыполнения", ЭтотОбъект); 
	ДлительныеОперацииКлиент.ОжидатьЗавершение(РезультатВыполнения, ОповещениеОЗавершении, ПараметрыОжидания); 	

КонецПроцедуры

&НаСервере 
Функция ПродолжитьЗаполнениеСправочникАлгоритмыНаСервереВФоне()  
	
	СоответствиеОбластей = Новый Соответствие;  
	
	СоответствиеОбластей.Вставить(Перечисления.ТипыЭлементовРегламентаЭДО.ЭЗЗ_Титул1, 	"ЭЗЗ_Титул1");
	СоответствиеОбластей.Вставить(Перечисления.ТипыЭлементовРегламентаЭДО.ЭЗЗ_Титул2, 	"ЭЗЗ_Титул2");  
	
	СоответствиеОбластей.Вставить(Перечисления.ТипыЭлементовРегламентаЭДО.ЭТрН_Титул1, 	"ЭТрН_Титул1"); 
	
	СоответствиеОбластей.Вставить(Перечисления.ТипыЭлементовРегламентаЭДО.ЭПЛ_Титул1, 	"ЭПЛ_Титул1");   
	СоответствиеОбластей.Вставить(Перечисления.ТипыЭлементовРегламентаЭДО.ЭПЛ_Титул2, 	"ЭПЛ_Титул2");   
	СоответствиеОбластей.Вставить(Перечисления.ТипыЭлементовРегламентаЭДО.ЭПЛ_Титул3, 	"ЭПЛ_Титул3");   
	СоответствиеОбластей.Вставить(Перечисления.ТипыЭлементовРегламентаЭДО.ЭПЛ_Титул4, 	"ЭПЛ_Титул4");   
	СоответствиеОбластей.Вставить(Перечисления.ТипыЭлементовРегламентаЭДО.ЭПЛ_Титул5, 	"ЭПЛ_Титул5"); 
	
	СоответствиеОбластей.Вставить(Перечисления.ТипыЭлементовРегламентаЭДО.ЭСВ_Титул1_1, "ЭСВ_Титул1_1");   

	ИмяОбласти = СоответствиеОбластей.Получить(Объект.ТекущийТитул);
	Если ИмяОбласти = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(Новый УникальныйИдентификатор);
	ПараметрыВыполнения.ОжидатьЗавершение    = 0;  // запускать сразу  
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = "";  
	ПараметрыВыполнения.ЗапуститьВФоне     = Истина;  
	ПараметрыВыполнения.ЗапуститьНеВФоне   = ложь;   

	ПараметрыПроцедуры = Новый Структура;  
	ПараметрыПроцедуры.Вставить("ТипДокументаЭПД", 	Объект.ТипДокументаЭПД);  
	ПараметрыПроцедуры.Вставить("ТекущийТитул", 	Объект.ТекущийТитул);  
	ПараметрыПроцедуры.Вставить("ТипОбъекта", 		Объект.ТипОбъекта);  
	ПараметрыПроцедуры.Вставить("ИмяОбласти", 		ИмяОбласти);  
	
	Возврат ДлительныеОперации.ВыполнитьВФоне("CW_ОбменГИСЭПДДополнительный.СформироватьАлгоритмыЗаполненияРеквизитовЭПД",ПараметрыПроцедуры, ПараметрыВыполнения);  
	
КонецФункции     

&НаКлиенте 
Процедура ОбработатьРезультатВыполнения(РезультатВыполнения, Дополнительныепараметры) Экспорт
	
	Если РезультатВыполнения = Неопределено Тогда 
		//Выполннение прервано
		Возврат;
	КонецЕсли;
	
	Если РезультатВыполнения.Статус = "Выполнено" Тогда    
        ОбработатьРезультатВыполненияНаСервере(РезультатВыполнения.АдресРезультата);
	ИначеЕсли РезультатВыполнения.Статус = "Ошибка" Тогда
		
		ТекстПредупреждения = "Информация об ошибке см. в журнале регистрации!";
		
		Если ТипЗнч(РезультатВыполнения.Сообщения) = Тип("ФиксированныйМассив") Тогда
			
			Для Каждого СообщениеВМассиве из РезультатВыполнения.Сообщения Цикл
				СообщениеВМассиве.Сообщить();
			КонецЦикла;
			
		КонецЕсли;
		
		ПоказатьПредупреждение(,ТекстПредупреждения,,"Ошибка заполнения справочника!");  
		
	КонецЕсли;  
	
КонецПроцедуры 

&НаСервере
Процедура ОбработатьРезультатВыполненияНаСервере(АдресРезультата)
	
	Результат = ПолучитьИзВременногоХранилища(АдресРезультата);
	Если ТипЗнч(Результат) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли; 
	
	Для Каждого КлючЗначение из Результат Цикл
		НайденнаяОбласть = ТабличныйДокумент.Области.Найти(КлючЗначение.Ключ);
		Если НайденнаяОбласть <> Неопределено Тогда
			НайденнаяОбласть.Значение = КлючЗначение.Значение;    
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьНаименование(Команда)
	ЗаполнитьНаименованиеНаСервере();
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНаименованиеНаСервере()
	
	ШаблонНаименования  = "%1 (%2, %3)";
	
	Объект.Наименование  = СтрШаблон(ШаблонНаименования, 
		СокрЛП(Объект.ТипОбъекта.Синоним),
		СокрЛП(Объект.ТипДокументаЭПД),
		СокрЛП(Объект.ТекущийТитул));
	
КонецПроцедуры



