
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)  
	
	CW_ОбменГИСЭПДДополнительный.УстановитьПараметрыТиповДокументовЭПД(ЭтотОбъект);
	
	Если ТипЗнч(ДоступныеТипыДокументовЭПД) = Тип("ФиксированныйМассив") 
		И Параметры.Ключ.Пустая() 
		и ДоступныеТипыДокументовЭПД.Количество() = 1 Тогда
		Объект.ТипДокументаЭПД = ДоступныеТипыДокументовЭПД[0];
	КонецЕсли;   
	
	Если Не Объект.ТипДокументаЭПД.Пустая() Тогда
		ТипДокументаЭПДПриИзмененииНаСервере();  
	КонецЕсли;  
	
	CW_ОбменГИСЭПДДополнительный.ЗаполнитьДоступныеТипыОбъектов(ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)

	CW_ОбменГИСЭПДДополнительный.УстановитьПараметрыТиповДокументовЭПД(ЭтотОбъект);
	
	ИнформацияПоПрефиксамТитула = CW_ОбменГИСЭПДПереопределяемый.ПрефиксТитулаПоЭлементуРегламентаЭДО(Объект.ТекущийТитул);
	ПрефиксТитула = ИнформацияПоПрефиксамТитула.ВПрограмме;  
	
	ТекущийТитулПриИзмененииНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	
КонецПроцедуры 

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)

	ЗаписатьНастройкиЗаполненияЭПД();

КонецПроцедуры   

&НаСервере
Процедура ЗаписатьНастройкиЗаполненияЭПД()  
	
	ПоляТаблицПоТитулам = CW_ОбменГИСЭПДСерверВызовСервера.ПолучитьСоставПолейТаблиц();

	Набор = РегистрыСведений.CW_ОбменГИСЭПДЗначенияНастроекЗаполненияЭПД.СоздатьНаборЗаписей();
	Набор.Отбор.НастройкаЗаполнения.Установить(Объект.Ссылка);
	Набор.Очистить();
	
	ПоляТаблиц = ПоляТаблицПоТитулам.Получить(Объект.ТекущийТитул);
	
	Для Каждого Область из ТабличныйДокумент.Области Цикл
		Если СтрНачинаетсяС(Область.Имя, "МногострочнаяЧасть") Тогда
			Продолжить;
		КонецЕсли; 
		
		ИмяТабличнойЧасти = ПоляТаблиц.Получить(Область.Имя);
		
		Запись = Набор.Добавить();
		Запись.НастройкаЗаполнения	= Объект.Ссылка;
		Запись.ИмяТабличнойЧасти 	= ИмяТабличнойЧасти;
		Запись.ИмяОбласти 			= Область.Имя;
		Запись.АлгоритмЗаполнения	= Область.Значение;
		
	КонецЦикла;   
	
	Набор.Записать(Истина);

КонецПроцедуры    



