
&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	КодОшибки = ПроверитьТекстПоляНаСервере();  
	Если КодОшибки > 0 Тогда  
		Отказ = Истина;
		ПоказатьПредупреждение(, "Неверно имя! Имя должно состоять из ордного слова, начинаться с буквы и не содержать специальнрых символов кроме ""_""");	
		Возврат;
	КонецЕсли;   
	
	Если Не ПроверитьЗарезервированноеИмяПоля() Тогда
		Отказ = Истина;
		ПоказатьПредупреждение(, "Указанное наименование поля является зарезервированным и не может быть использовано!");	
	КонецЕсли;
	

КонецПроцедуры

&НаСервере
Функция ПроверитьТекстПоляНаСервере() 
	
	НедопустимыеСимволы = "!№;%:?*()+~`@#$^&";
	стрЧисла 			= "0123456789";
	ЕстьОшибкаПоля 		= Ложь;  
	
	ИмяПоля = СокрЛП(Объект.Код);
	
	Если Не ПустаяСтрока(ИмяПоля) Тогда
		Если СтрНайти(ИмяПоля, " ") > 0 Тогда 
			Возврат 1;
		КонецЕсли; 
		
		ПервыйСимвол = Лев(ИмяПоля, 1);  
		Если СтрНайти(стрЧисла, ПервыйСимвол) > 0 Тогда
			Возврат 2;
		КонецЕсли;    
		
		Для Поз = 1 По СтрДлина(ИмяПоля) Цикл
			Символ = Сред(ИмяПоля, Поз, 1);
			Если СтрНайти(НедопустимыеСимволы, Символ) > 0 Тогда
				Возврат 2;
			КонецЕсли;    
		КонецЦикла;
	КонецЕсли;
	
	Возврат 0
	
КонецФункции

&НаСервере
Функция ПроверитьЗарезервированноеИмяПоля()
	
	ЗарезервированынеПоля = CW_ЭлектронныйОбменДаннымиСервер.ПолучитьСписокЗарезервированныхПолей();
	Возврат ЗарезервированынеПоля.Найти(СокрЛП(Объект.Код)) = Неопределено;
	
КонецФункции

