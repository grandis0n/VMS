
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Параметры.Свойство("Контрагент", Контрагент);  
	
	Параметры.Свойство("Договор", Договор);  
	Параметры.Свойство("ПриложениеКДоговору", ПриложениеКДоговору);  
	
	ДоговорПриИзмененииНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ДоговорПриИзменении(Элемент)
	
	ДоговорПриИзмененииНаСервере();
	
КонецПроцедуры 

&НаСервере
Процедура ДоговорПриИзмененииНаСервере()  
	
	//Подсистема.УчетПриложенийДоговоров
	ПоказатьПриложениеКДоговору = Ложь;
	Если ЗначениеЗаполнено(Договор) Тогда
		ПараметрОпции = Новый Структура("CW_ДоговорПоГрузоперевозкам", Договор);
		ПоказатьПриложениеКДоговору = ПолучитьФункциональнуюОпцию("CW_ВедетсяУчетПриложенийПоДоговорам", ПараметрОпции);
	КонецЕсли;                                                          
	
	Элементы.ПриложениеКДоговору.Видимость = ПоказатьПриложениеКДоговору;
	//Подсистема.УчетПриложенийДоговоров
	
КонецПроцедуры

&НаКлиенте
Процедура ОК(Команда)

	Структура = Новый Структура;
	Структура.Вставить("Договор", 				Договор);
	Структура.Вставить("ПриложениеКДоговору", 	ПриложениеКДоговору);
	
	Закрыть(Структура);
	
КонецПроцедуры


