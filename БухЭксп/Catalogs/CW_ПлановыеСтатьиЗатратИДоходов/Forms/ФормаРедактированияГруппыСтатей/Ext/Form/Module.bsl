	ОткрытьФорму("Обработка.CW_ЖурналГрузоперевозок.Форма.Форма",ПФ, ЭтаФорма,Истина,,,ПОВ,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаПодбораИзЖурнала(Ответ, ДополнительныеПараметры) Экспорт 
	// --- 
	
	Если (Ответ <> Неопределено) Тогда
		
		МассивДублей = Новый Массив;
		МассивДобавляемых = Новый Массив;
		Для каждого Стр Из Ответ Цикл
			
			// проверяем, что такой г/п нет в списке
			Отбор = Новый Структура("Грузоперевозка",Стр);
			мстр = дфкБюджет.НайтиСтроки(Отбор);
			Если (мстр.Количество()=0) Тогда
				
				МассивДобавляемых.Добавить(Стр);
				
			Иначе
				
				МассивДублей.Добавить(Стр);
				
			КонецЕсли; 
			
		КонецЦикла; 
		
		Если (МассивДобавляемых.Количество() <> 0) Тогда
			
			ДополнительныеПараметры = Новый Структура;
			ДополнительныеПараметры.Вставить("ЗначениеКопирования", Неопределено);
			ОбработкаВыбораГрузоперевозок(МассивДобавляемых, ДополнительныеПараметры);
			
			ОбновитьИтоги();
			БылиИзменения = Истина;
			
		КонецЕсли; 
		
		Если (МассивДублей.Количество() <> 0) Тогда
			
			ПредставлениеГП = "";
			Для каждого Стр Из МассивДублей Цикл
				Если (ПредставлениеГП <> "") Тогда
					ПредставлениеГП = ПредставлениеГП + ", ";
				КонецЕсли; 
				ПредставлениеГП = ПредставлениеГП + Строка(Стр);
			КонецЦикла; 
			_УФК.ВывестиПредупреждение("Грузоперевозка """+Строка(ПредставлениеГП)+""" уже добавлена.");
			
		КонецЕсли; 
		
	КонецЕсли; 
	
	// --- 
КонецПроцедуры

//Использование количества
&НаКлиенте
Процедура ОбновитьКоличество(Команда)  
	
	РезультатВыполнения =  ОбновитьКоличествоНаСервереВФоне(ВидСтатьиПланирования);
	Если РезультатВыполнения = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ВыводитьОкноОжидания = Истина;   
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ВидСтатьиПланирования", ВидСтатьиПланирования);
	
	ОповещениеОЗавершении = Новый ОписаниеОповещения("ОбработатьРезультатОбновленияКоличества", ЭтотОбъект, ДополнительныеПараметры);
	
	ДлительныеОперацииКлиент.ОжидатьЗавершение(РезультатВыполнения, ОповещениеОЗавершении, ПараметрыОжидания);
	
КонецПроцедуры   

&НаСервере
Функция ОбновитьКоличествоНаСервереВФоне(ВидСтатьиПланирования)
	
	МассивСтатей = ПолучитьМассивСтатейБюджетаНаСервере(); 
	Если МассивСтатей.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(Новый УникальныйИдентификатор);
	ПараметрыВыполнения.ОжидатьЗавершение 			= 0; // запускать сразу
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = "Обновление количества статей бюджета: "+Строка(ЗаказСсылка);
	ПараметрыВыполнения.ЗапуститьВФоне 				= Истина;
	ПараметрыВыполнения.ЗапуститьНеВФоне 			= ложь;
	
	ПараметрыПроцедуры = Новый Структура;
	ПараметрыПроцедуры.Вставить("МассивСтатей", 	МассивСтатей);
	
	Возврат ДлительныеОперации.ВыполнитьВФоне("Справочники.CW_ПлановыеСтатьиЗатратИДоходов.ОбновитьКоличествоПлановыхСтатей",ПараметрыПроцедуры, ПараметрыВыполнения);
	
КонецФункции    

&НаСервере
Функция ПолучитьМассивСтатейБюджетаНаСервере()
	
	МассивСтатей = Новый Массив;
	Для Каждого СтрокаБюджета из дфкБюджет Цикл
		БюджетЗаблокирован = РегистрыСведений.CW_УтверждениеБюджетов.ПолучитьБлокировкуБюджета(СтрокаБюджета.Грузоперевозка, ВерсияБюджета);
		Если БюджетЗаблокирован Тогда
			Продолжить;
		КонецЕсли;                     
		МассивСтатей.Добавить(СтрокаБюджета.СтатьяСсылка);	
	КонецЦикла;
	
	Возврат МассивСтатей;
	
КонецФункции

&НаКлиенте
Процедура ОбработатьРезультатОбновленияКоличества(РезультатВыполнения, ДополнительныеПараметры) Экспорт
	
	Если РезультатВыполнения.Статус = "Выполнено" Тогда
		
		Грузоперевозка = ПредопределенноеЗначение("Справочник.CW_Грузоперевозки.ПустаяСсылка");	
		_ОбновитьБюджет();
		
	ИначеЕсли РезультатВыполнения.Статус = "Ошибка" Тогда
		
		ТекстПредупреждения = "Не удалось обновить количество одной или нескольких статей бюджета!
		| По причине: "+ РезультатВыполнения.КраткоеПредставлениеОшибки + "
		| Информаиция об ошибке см. в журнале регистрации!";
		
		Если ТипЗнч(РезультатВыполнения.Сообщения) = Тип("Массив") Тогда
			Для Каждого СообщениеВМассиве из РезультатВыполнения.Сообщения Цикл
				СообщениеВМассиве.Сообщить();
			КонецЦикла;
		КонецЕсли;
		
		ПоказатьПредупреждение(,ТекстПредупреждения,,"Ошибка обновления количества");
	КонецЕсли;
	
КонецПроцедуры
//Использование количества

&НаКлиенте
Процедура ПрогнозОплаты(Команда)
	
	ВыделенныеСтроки = Элементы.Бюджет.ВыделенныеСтроки;
	ПараметрыСтатьи  = ПолучитьПараметрыСтатьиБюджета(ВыделенныеСтроки);
	Если ПараметрыСтатьи = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Владелец", ПараметрыСтатьи.Владелец);        
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ВыделенныеСтроки", ВыделенныеСтроки);

	ОписаниеОповещения = Новый ОписаниеОповещения("ПрогнозПредставлениеЗавершение", ЭтотОбъект, ДополнительныеПараметры);
	
	ОткрытьФорму("Справочник.CW_ПлановыеСтатьиЗатратИДоходов.Форма.ФормаПрогнозаОплаты", ПараметрыФормы, ЭтотОбъект,,,,ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры   

&НаСервере
Функция ПолучитьПараметрыСтатьиБюджета(ВыделенныеСтроки)
	
	Если ВыделенныеСтроки.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	СтрокаБюджета = дфкБюджет.НайтиПоИдентификатору(ВыделенныеСтроки[0]);   
	СтатьяБюджета = СтрокаБюджета.СтатьяСсылка;
	
	ПараметрыСтатьи = Новый Структура;
	ПараметрыСтатьи.Вставить("Владелец", СтатьяБюджета.Владелец); 
	
	Возврат ПараметрыСтатьи;
	
КонецФункции

&НаКлиенте
Процедура ПрогнозПредставлениеЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;  
	
	ПрогнозПредставлениеЗавершениеНаСервере(Результат, ДополнительныеПараметры);	
	
КонецПроцедуры

&НаСервере
Процедура ПрогнозПредставлениеЗавершениеНаСервере(Результат, ДополнительныеПараметры)
	
	Для Каждого ИдентификаторСтроки из ДополнительныеПараметры.ВыделенныеСтроки Цикл
		
		СтрокаБюджета = дфкБюджет.НайтиПоИдентификатору(ИдентификаторСтроки);  
		
		СтатьяБюджетаОбъект = СтрокаБюджета.СтатьяСсылка.ПолучитьОбъект();
		СтатьяБюджетаОбъект.ВариантПрогноза = Результат.ВариантПрогноза;
		СтатьяБюджетаОбъект.ПрогнозКонтрольнаяДата = Результат.ПрогнозКонтрольнаяДата;
		СтатьяБюджетаОбъект.ПрогнозКоличествоДней = Результат.ПрогнозКоличествоДней;
		СтатьяБюджетаОбъект.ПрогнозКоличествоДнейПлан = Результат.ПрогнозКоличествоДнейПлан;
		СтатьяБюджетаОбъект.Записать();
		
		РегистрыСведений.CW_ПрогнозОплатыПлановыхСтатейБюджета.ЗаписатьПрогнозОплаты(СтрокаБюджета.СтатьяСсылка, Результат.ПрогнозДата);
		
		СтрокаБюджета.ПлановаяДатаОплаты = Результат.ПрогнозДата;

	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура РасчитатьПрогноз(Команда)

	ВыделенныеСтроки = Элементы.Бюджет.ВыделенныеСтроки;
 	ПараметрыСтатьи  = ПолучитьПараметрыСтатьиБюджета(ВыделенныеСтроки);
	Если ПараметрыСтатьи = Неопределено 
		или ТипЗнч(ПараметрыСтатьи.Владелец) <> Тип("СправочникСсылка.CW_Грузоперевозки") Тогда
		Возврат;
	КонецЕсли;   

	РасчитатьПрогнозНаСервере(ВыделенныеСтроки);

КонецПроцедуры  

&НаСервере
Процедура РасчитатьПрогнозНаСервере(ВыделенныеСтроки)

	Для Каждого ИдентификаторСтроки из ВыделенныеСтроки Цикл     
		
		СтрокаБюджета = дфкБюджет.НайтиПоИдентификатору(ИдентификаторСтроки);  
		СтатьяБюджета = СтрокаБюджета.СтатьяСсылка;   
		ПрогнозДата   = РегистрыСведений.CW_ПрогнозОплатыПлановыхСтатейБюджета.ПолучитьПрогнозОплаты(СтатьяБюджета);
		
		ПараметрыРасчета = Новый Структура;
		ПараметрыРасчета.Вставить("ВариантПрогноза", 			СтатьяБюджета.ВариантПрогноза);
		ПараметрыРасчета.Вставить("Владелец", 					СтатьяБюджета.Владелец);
		ПараметрыРасчета.Вставить("ПрогнозКонтрольнаяДата", 	СтатьяБюджета.ПрогнозКонтрольнаяДата);
		ПараметрыРасчета.Вставить("ПрогнозКоличествоДней", 		СтатьяБюджета.ПрогнозКоличествоДней);
		ПараметрыРасчета.Вставить("ПрогнозКоличествоДнейПлан", 	СтатьяБюджета.ПрогнозКоличествоДнейПлан);
		
		ПараметрыРасчета.Вставить("ПрогнозДата",	 			ПрогнозДата);
		ПараметрыРасчета.Вставить("ДатаНачалаПеревозки", 		СтатьяБюджета.Владелец.ДатаСделкиФ);
		
		НовыйПрогнозДата = Справочники.CW_ПлановыеСтатьиЗатратИДоходов.РассчитатьПрогнозОплатыСтатьиБюджета(ПараметрыРасчета); 
		Если НовыйПрогнозДата <> Неопределено 
			И НовыйПрогнозДата <> ПрогнозДата Тогда
			РегистрыСведений.CW_ПрогнозОплатыПлановыхСтатейБюджета.ЗаписатьПрогнозОплаты(СтатьяБюджета, НовыйПрогнозДата);
			
			СтрокаБюджета.ПлановаяДатаОплаты = НовыйПрогнозДата;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры
