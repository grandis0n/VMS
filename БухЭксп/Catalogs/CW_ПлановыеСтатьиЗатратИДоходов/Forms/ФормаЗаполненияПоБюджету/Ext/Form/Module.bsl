&НаКлиенте
Процедура ГрузоперевозкиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Поле.Имя = "ГрузоперевозкиСальдо" Тогда
		
		СтандартнаяОбработка=Ложь;
		Строка = дфкГрузоперевозки.НайтиПоИдентификатору(ВыбраннаяСтрока);
		Если Строка.Сальдо <> 0 Тогда
			
			Строка.СуммаКВыставлению = (Строка.СуммаПоБюджету - Строка.СуммаФакт) * ПроцентВыставления/100 ;//Строка.Сальдо;
			Если Строка.СуммаПоБюджету<>0 Тогда 
				Строка.КоличествоКВыставлению = строка.КоличествоПоБюджету * Строка.СуммаКВыставлению/Строка.СуммаПоБюджету;
			КонецЕсли;
			Строка.Сальдо = Строка.СуммаПоБюджету - Строка.СуммаФакт - Строка.СуммаКВыставлению;
			ГрузоперевозкиСуммаКВыставлениюПриИзменении(Поле);
			
		КонецЕсли; 
		
		ПолучитьКоличествоВыставленныхСтрокГрузоперевозки();	
		
	КонецЕсли; 
	
КонецПроцедуры


&НаКлиенте
Процедура СтатьиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка=Ложь;
	Если Поле.Имя = "СтатьиСальдо" или Поле.Имя = "СтатьиСальдоКоличество"  Тогда
		
		УстановитьПометкиГрузоперевозок(ВыбраннаяСтрока, Истина);
		
	ИначеЕсли Поле.Имя = "СтатьиСуммаКВыставлению" или Поле.Имя = "СтатьиКоличествоКВыставлению" Тогда 
		
		// если форма вызвана из карточки г/п даём редактировать сумму
		Если Элементы.ГруппаГрузоперевозки.Видимость = Ложь Тогда
			
			СтандартнаяОбработка = Истина;
			
		КонецЕсли; 
				
	КонецЕсли; 
	
КонецПроцедуры


&НаКлиенте
Процедура ДоговорНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	// --- 
	ОткрытьФорму("Справочник.CW_ДоговорыПоГрузоперевозкам.ФормаВыбора",_ПолучитьПараметрыВыбораДоговора(),Элемент);
	
КонецПроцедуры

&НаСервере
Функция _ПолучитьПараметрыВыбораДоговора()
	// --- 
	
	Отбор = _сф.ст_Создать("Владелец:Контрагент,Организация,ВидДоговора",ЭтаФорма);
	ПараметрыФормы = Новый Структура("Отбор,РежимВыбора",Отбор,Истина);
	Возврат(ПараметрыФормы);
	
	// --- 
КонецФункции

&НаКлиенте
Процедура ВерсияБюджетаПриИзменении(Элемент)
	_ПолучитьТаблицыБюджетаПланФакт_ДляВыбораКонтрагента();
КонецПроцедуры

&НаКлиенте
Процедура ФормированиеФактаПриИзменении(Элемент)
	_ПолучитьТаблицыБюджетаПланФакт_ДляВыбораКонтрагента();	
КонецПроцедуры

&НаКлиенте
Процедура ДатаДокументаПриИзменении(Элемент)
	
	Если (ДатаДокумента = Дата(1,1,1)) Тогда
		
		ДатаДокумента = ТекущаяДата();
		
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура КлиентПриИзменении(Элемент)
	
	Договор = Неопределено;
	_ЗаполнитьТаблицыСтатейИГрузоперевозок(); 
	_УправлениеЭлементамиФормы();
	
КонецПроцедуры

