&НаСервере
Процедура _ДополнитьФактомПоДругимВалютам()
	// --- 
	
	// получаем данные
	Если (ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПокупателем) Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	CW_ДоходыПоГрузоперевозкамОбороты.Контрагент КАК Клиент,
		|	CW_ДоходыПоГрузоперевозкамОбороты.Валюта,
		|	СУММА(CW_ДоходыПоГрузоперевозкамОбороты.Всего_ВалютаОборот) КАК СуммаФакт,
		|	CW_ДоходыПоГрузоперевозкамОбороты.ДокументДоходов КАК Документ,
		|	CW_ДоходыПоГрузоперевозкамОбороты.Период
		|ИЗ
		|	РегистрНакопления.CW_ДоходыПоГрузоперевозкам.Обороты(
		|			,
		|			,
		|			Регистратор,
		|			ВЫБОР
		|					КОГДА &ПоСчетам 
		|						ТОГДА ЭтоСчет
		|					ИНАЧЕ ЭтоАкт
		|				КОНЕЦ
		|				И Контрагент = &Контрагент
		|				И Валюта <> &ВалютаСтроки
		|				И Номенклатура = &Номенклатура
		|				И Грузоперевозка = &Грузоперевозка
		|				И СтавкаНДС = &СтавкаНДС) КАК CW_ДоходыПоГрузоперевозкамОбороты
		|
		|СГРУППИРОВАТЬ ПО
		|	CW_ДоходыПоГрузоперевозкамОбороты.Контрагент,
		|	CW_ДоходыПоГрузоперевозкамОбороты.Валюта,
		|	CW_ДоходыПоГрузоперевозкамОбороты.ДокументДоходов,
		|	CW_ДоходыПоГрузоперевозкамОбороты.Период";
		
	ИначеЕсли (ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком) Тогда 
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	CW_РасходыПоГрузоперевозкамОбороты.Контрагент КАК Клиент,
		|	CW_РасходыПоГрузоперевозкамОбороты.Валюта,
		|	СУММА(CW_РасходыПоГрузоперевозкамОбороты.Всего_ВалютаОборот) КАК СуммаФакт,
		|	CW_РасходыПоГрузоперевозкамОбороты.ДокументРасходов КАК Документ,
		|	CW_РасходыПоГрузоперевозкамОбороты.Период
		|ИЗ
		|	РегистрНакопления.CW_РасходыПоГрузоперевозкам.Обороты(
		|			,
		|			,
		|			Регистратор,
		|			ВЫБОР
		|					КОГДА &ПоСчетам 
		|						ТОГДА ЭтоСчет
		|					ИНАЧЕ ЭтоАкт
		|				КОНЕЦ
		|				И Контрагент = &Контрагент
		|				И Валюта <> &ВалютаСтроки
		|				И Номенклатура = &Номенклатура
		|				И Грузоперевозка = &Грузоперевозка
		|				И СтавкаНДС = &СтавкаНДС) КАК CW_РасходыПоГрузоперевозкамОбороты
		|
		|СГРУППИРОВАТЬ ПО
		|	CW_РасходыПоГрузоперевозкамОбороты.Контрагент,
		|	CW_РасходыПоГрузоперевозкамОбороты.Валюта,
		|	CW_РасходыПоГрузоперевозкамОбороты.ДокументРасходов,
		|	CW_РасходыПоГрузоперевозкамОбороты.Период"; 				
		
		
	КонецЕсли;
					   
	Для каждого Стр Из дфкГрузоперевозки Цикл
		
		Запрос.УстановитьПараметр("ПоСчетам", ?(ФормированиеФакта=0,Ложь,Истина));
		// --- 
		Запрос.УстановитьПараметр("Контрагент", Договор.Владелец);
		Запрос.УстановитьПараметр("ВалютаСтроки", Стр.Валюта);
		Запрос.УстановитьПараметр("Грузоперевозка", Стр.Грузоперевозка);
		Запрос.УстановитьПараметр("Номенклатура", Стр.Номенклатура);
		Запрос.УстановитьПараметр("СтавкаНДС", Стр.СтавкаНДС); 
		// --- 
		ТЗ = Запрос.Выполнить().Выгрузить();
		СуммаФакт = 0;
		Для каждого СтрокаДокумента Из ТЗ Цикл
			
			СтруктураКурсаДокумента = CW_Финансы.ПолучитьКурсВалюты(СтрокаДокумента.Валюта,СтрокаДокумента.Период);
			СтруктураКурсаСтроки = CW_Финансы.ПолучитьКурсВалюты(Стр.Валюта,СтрокаДокумента.Период);
			// --- 
			СуммаПересчитанная = CW_Финансы.ПересчитатьИзВалютыВВалюту(СтрокаДокумента.СуммаФакт,СтрокаДокумента.Валюта,Стр.Валюта,СтруктураКурсаДокумента.Курс,СтруктураКурсаСтроки.Курс,СтруктураКурсаДокумента.Кратность,СтруктураКурсаСтроки.Кратность); 
			_сф.Инкремент(СуммаФакт,СуммаПересчитанная);
			
		КонецЦикла;
		_сф.Инкремент(Стр.СуммаФакт,СуммаФакт);
		Стр.Сальдо = Стр.СуммаПоБюджету - Стр.СуммаФакт - Стр.СуммаКВыставлению;
		
	КонецЦикла; 
	
	ТаблицаДляСвертки = дфкГрузоперевозки.Выгрузить();
	ТаблицаДляСвертки.Свернуть("Номенклатура,СтавкаНДС,Валюта","СуммаФакт");
	// --- 
	Для каждого Стр Из ТаблицаДляСвертки Цикл
		
		Отбор = Новый Структура("Номенклатура,СтавкаНДС,Валюта",Стр.Номенклатура,Стр.СтавкаНДС,Стр.Валюта);
		СтрокаСтатьи = _сф.к_НайтиСтроку(дфкСтатьи,Отбор);
		Если (СтрокаСтатьи <> Неопределено) Тогда
			_сф.Инкремент(СтрокаСтатьи.СуммаФакт,Стр.СуммаФакт);
		КонецЕсли; 
		
	КонецЦикла; 
	// --- 
	Для каждого Стр Из дфкСтатьи Цикл
		
		Стр.Сальдо = Стр.СуммаПоБюджету - Стр.СуммаФакт - Стр.СуммаКВыставлению;
		
	КонецЦикла;      
	
	// --- 
КонецПроцедуры


&НаКлиенте
Процедура СтатьиВыставитьВсе(Команда)
	
	Для каждого СтрокаСтатьи из дфкСтатьи Цикл
		УстановитьПометкиГрузоперевозок(СтрокаСтатьи.ПолучитьИдентификатор(), истина);
	КонецЦикла;
	
КонецПроцедуры


&НаКлиенте
Процедура СтатьиОчиститьВсе(Команда)
	
	Для каждого СтрокаСтатьи из дфкСтатьи Цикл
		УстановитьПометкиГрузоперевозок(СтрокаСтатьи.ПолучитьИдентификатор(), Ложь);
	КонецЦикла;
	
КонецПроцедуры


&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "ОбновитьКоментарийДоговораНаФрме" Тогда
		УстановитьЗаголовокНадписиКомментарияДоговора();
	КонецЕсли;
	
КонецПроцедуры


&НаСервере
Процедура ПолучитьКоличествоВыставленныхСтрокГрузоперевозки()
	
	ТекущаяСтрока = Элементы.Статьи.ТекущаяСтрока;
	Если ТекущаяСтрока <> Неопределено Тогда
		ПолучитьКоличествоВыставленныхСтрокГрузоперевозкиНаСервере(ТекущаяСтрока);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПолучитьКоличествоВыставленныхСтрокГрузоперевозкиНаСервере(ИдентификаторСтроки)
	
	СтрокаТекущая = дфкСтатьи.НайтиПоИдентификатору(ИдентификаторСтроки);
	Если СтрокаТекущая = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОтборСтрок = Новый Структура("Номенклатура, СтавкаНДС, Валюта", СтрокаТекущая.Номенклатура, СтрокаТекущая.СтавкаНДС, СтрокаТекущая.Валюта);
	мСтрокиВсего = дфкГрузоперевозки.НайтиСтроки(ОтборСтрок);
	
	ОтборСтрок.Вставить("СуммаКВыставлению", 0);
	мСтрокиВыставлено = дфкГрузоперевозки.НайтиСтроки(ОтборСтрок);
	
	ГрузоперевозкиВсегоСтрок  = мСтрокиВсего.Количество();
	ГрузоперевозкиВыставлено = ГрузоперевозкиВсегоСтрок - мСтрокиВыставлено.Количество(); 
	
КонецПроцедуры

&НаСервере
Процедура ПолучитьКоличествоВыставленныхСтрокСтатьи()
	
	мСтроки = дфкСтатьи.НайтиСтроки(Новый Структура("СуммаКВыставлению",0));
	СтатьиВыставлено = дфкСтатьи.Количество() - мСтроки.Количество(); 
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьГрузоперевозку(Команда)
	
	ТекущиеДанные = Элементы.Грузоперевозки.ТекущиеДанные;
	
	Если ТекущиеДанные <> Неопределено Тогда
		СтруктураПараметров = Новый Структура("Ключ", ТекущиеДанные.Грузоперевозка);
		ОткрытьФорму("Справочник.CW_Грузоперевозки.ФормаОбъекта", СтруктураПараметров,ЭтаФорма, Истина,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	КонецЕсли;
	
КонецПроцедуры


&НаКлиенте
Процедура ВариантКурсаПриИзменении(Элемент)
	ВариантКурсаПриИзмененииНаСервере();
КонецПроцедуры

