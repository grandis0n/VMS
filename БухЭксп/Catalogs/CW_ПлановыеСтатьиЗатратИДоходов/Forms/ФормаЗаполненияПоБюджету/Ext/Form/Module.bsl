&НаСервере
Функция ПолучитьСуммуБезНДС(СТ,ВидСтатьиПланирования)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	CW_ПлановыеСтатьиЗатратИДоходов.Сумма КАК Сумма,
	               |	CW_ПлановыеСтатьиЗатратИДоходов.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.CW_ПлановыеСтатьиЗатратИДоходов КАК CW_ПлановыеСтатьиЗатратИДоходов
	               |ГДЕ
	               |	CW_ПлановыеСтатьиЗатратИДоходов.Владелец = &Грузоперевозка
	               |	И CW_ПлановыеСтатьиЗатратИДоходов.ВерсияБюджета = &ВерсияБюджета
	               |	И CW_ПлановыеСтатьиЗатратИДоходов.ВидСтатьиПланирования = &ВидСтатьиПланирования
	               |	И CW_ПлановыеСтатьиЗатратИДоходов.Контрагент = &Контрагент
	               |	И CW_ПлановыеСтатьиЗатратИДоходов.Номенклатура = &Номенклатура
	               |	И CW_ПлановыеСтатьиЗатратИДоходов.Валюта = &Валюта
	               |	И CW_ПлановыеСтатьиЗатратИДоходов.СтавкаНДС = &СтавкаНДС
	               |	И CW_ПлановыеСтатьиЗатратИДоходов.ПометкаУдаления = ЛОЖЬ";
	
	Запрос.УстановитьПараметр("Грузоперевозка", 		СТ.Грузоперевозка);
	Запрос.УстановитьПараметр("ВерсияБюджета", 			ВерсияБюджета);
	Запрос.УстановитьПараметр("ВидСтатьиПланирования", 	ВидСтатьиПланирования);
	Запрос.УстановитьПараметр("Контрагент", 			Контрагент);
	Запрос.УстановитьПараметр("Номенклатура", 			СТ.Номенклатура);
	Запрос.УстановитьПараметр("Валюта", 				СТ.Валюта);
	Запрос.УстановитьПараметр("СтавкаНДС", 				СТ.СтавкаНДС);
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Сумма;
	КонецЕсли; 
	
	Возврат 0;
	
КонецФункции


&НаСервере
Функция _ПолучитьКомментарий(СТ,ВидСтатьиПланирования)
	// --- 
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	CW_ПлановыеСтатьиЗатратИДоходов.Комментарий
	               |ИЗ
	               |	Справочник.CW_ПлановыеСтатьиЗатратИДоходов КАК CW_ПлановыеСтатьиЗатратИДоходов
	               |ГДЕ
	               |	CW_ПлановыеСтатьиЗатратИДоходов.Владелец = &Грузоперевозка
	               |	И CW_ПлановыеСтатьиЗатратИДоходов.ВерсияБюджета = &ВерсияБюджета
	               |	И CW_ПлановыеСтатьиЗатратИДоходов.ВидСтатьиПланирования = &ВидСтатьиПланирования
	               |	И CW_ПлановыеСтатьиЗатратИДоходов.Контрагент = &Контрагент
	               |	И CW_ПлановыеСтатьиЗатратИДоходов.Номенклатура = &Номенклатура
	               |	И CW_ПлановыеСтатьиЗатратИДоходов.Валюта = &Валюта
	               |	И CW_ПлановыеСтатьиЗатратИДоходов.СтавкаНДС = &СтавкаНДС
	               |	И CW_ПлановыеСтатьиЗатратИДоходов.ПометкаУдаления = ЛОЖЬ";
	Запрос.УстановитьПараметр("Грузоперевозка", СТ.Грузоперевозка);
	Запрос.УстановитьПараметр("ВерсияБюджета", ВерсияБюджета);
	Запрос.УстановитьПараметр("ВидСтатьиПланирования", ВидСтатьиПланирования);
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.УстановитьПараметр("Номенклатура", СТ.Номенклатура);
	Запрос.УстановитьПараметр("Валюта", СТ.Валюта);
	Запрос.УстановитьПараметр("СтавкаНДС", СТ.СтавкаНДС);
	ТЗ = Запрос.Выполнить().Выгрузить();
	Если (ТЗ.Количество()=1) Тогда
		Возврат(СокрЛП(_сф.к_ПервыйЭлемент(ТЗ).Комментарий));
	Иначе
		Возврат("");
	КонецЕсли; 
	
	// --- 
КонецФункции

&НаСервере
Функция _ПолучитьСтатьюПланирования(СтрокаПараметров,ВидСтатьиПланирования)
	
	СтруктураВозврата = Новый Структура;
	СтруктураВозврата.Вставить("Ссылка"							, Справочники.CW_ПлановыеСтатьиЗатратИДоходов.ПустаяСсылка());
	СтруктураВозврата.Вставить("КонтрольнаяДатаКурсаДляПроверки", Дата(1,1,1));
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	CW_ПлановыеСтатьиЗатратИДоходов.Ссылка КАК Ссылка,
	               |	CW_ПлановыеСтатьиЗатратИДоходов.КонтрольнаяДатаКурсаДляПроверки КАК КонтрольнаяДатаКурсаДляПроверки
	               |ИЗ
	               |	Справочник.CW_ПлановыеСтатьиЗатратИДоходов КАК CW_ПлановыеСтатьиЗатратИДоходов
	               |ГДЕ
	               |	CW_ПлановыеСтатьиЗатратИДоходов.Владелец = &Грузоперевозка
	               |	И CW_ПлановыеСтатьиЗатратИДоходов.ВерсияБюджета = &ВерсияБюджета
	               |	И CW_ПлановыеСтатьиЗатратИДоходов.ВидСтатьиПланирования = &ВидСтатьиПланирования
	               |	И CW_ПлановыеСтатьиЗатратИДоходов.Контрагент = &Контрагент
	               |	И CW_ПлановыеСтатьиЗатратИДоходов.Номенклатура = &Номенклатура
	               |	И CW_ПлановыеСтатьиЗатратИДоходов.Валюта = &Валюта
	               |	И CW_ПлановыеСтатьиЗатратИДоходов.СтавкаНДС = &СтавкаНДС
	               |	И НЕ CW_ПлановыеСтатьиЗатратИДоходов.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("Грузоперевозка"			, СтрокаПараметров.Грузоперевозка);
	Запрос.УстановитьПараметр("Номенклатура"			, СтрокаПараметров.Номенклатура);
	Запрос.УстановитьПараметр("Валюта"					, СтрокаПараметров.Валюта);
	Запрос.УстановитьПараметр("СтавкаНДС"				, СтрокаПараметров.СтавкаНДС);
	Запрос.УстановитьПараметр("ВерсияБюджета"			, ВерсияБюджета);
	Запрос.УстановитьПараметр("ВидСтатьиПланирования"	, ВидСтатьиПланирования);
	Запрос.УстановитьПараметр("Контрагент"				, Контрагент);
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(СтруктураВозврата, Выборка);
	КонецЕсли;
	
	Возврат СтруктураВозврата;
	
КонецФункции


