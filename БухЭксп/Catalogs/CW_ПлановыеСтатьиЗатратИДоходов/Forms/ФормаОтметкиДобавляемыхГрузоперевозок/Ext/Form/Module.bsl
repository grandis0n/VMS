&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ОбновитьСтатистику();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСтатистику()
	// --- 
	
	Элементы.Статистика.Заголовок = "Грузоперевозки: "+Формат(КоличествоОтмеченныхГП,"ЧДЦ=; ЧН=") +"/"+Формат(КоличествоДоступныхГП,"ЧДЦ=; ЧН=");
	Если (КоличествоДоступныхГП <> КоличествоГП) Тогда
		Элементы.Статистика.Заголовок = Элементы.Статистика.Заголовок + " (всего по заказу "+Формат(КоличествоГП,"ЧДЦ=; ЧН=")+")";
	КонецЕсли; 
	
	// --- 
КонецПроцедуры

&НаКлиенте
Процедура ГрузоперевозкиПометкаПриИзменении(Элемент)
	
	ОбновитьКоличествоОтмеченных();
	ОбновитьСтатистику();
	
КонецПроцедуры
  
&НаКлиенте
Процедура ОбновитьКоличествоОтмеченных()
	// --- 
	
	КоличествоОтмеченныхГП = 0;
	Для каждого Элемент Из Грузоперевозки Цикл
		
		Если (Элемент.Пометка) Тогда
			КоличествоОтмеченныхГП = КоличествоОтмеченныхГП+1;
		КонецЕсли; 
		
	КонецЦикла; 
	
	// --- 
КонецПроцедуры
  
