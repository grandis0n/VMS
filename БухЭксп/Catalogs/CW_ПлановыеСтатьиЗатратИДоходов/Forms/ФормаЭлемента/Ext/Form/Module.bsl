Процедура РасчитатьПрогноз(Команда)
	РасчитатьПрогнозНаСервере();
КонецПроцедуры

&НаСервере
Процедура РасчитатьПрогнозНаСервере()
	
	Если ТипЗнч(Объект.Владелец) <> Тип("СправочникСсылка.CW_Грузоперевозки") Тогда
		Возврат;
	КонецЕсли;
	
	ДатаНачалаПеревозки = Объект.Владелец.ДатаСделкиФ;
	
	ПараметрыРасчета = Новый Структура;
	ПараметрыРасчета.Вставить("ВариантПрогноза", 			Объект.ВариантПрогноза);
	ПараметрыРасчета.Вставить("Владелец", 					Объект.Владелец);
	ПараметрыРасчета.Вставить("ПрогнозКонтрольнаяДата", 	Объект.ПрогнозКонтрольнаяДата);
	ПараметрыРасчета.Вставить("ПрогнозКоличествоДней", 		Объект.ПрогнозКоличествоДней);
	ПараметрыРасчета.Вставить("ПрогнозКоличествоДнейПлан", 	Объект.ПрогнозКоличествоДнейПлан);
	
	ПараметрыРасчета.Вставить("ПрогнозДата",	 			ПрогнозДата);
	ПараметрыРасчета.Вставить("ДатаНачалаПеревозки", 		ДатаНачалаПеревозки);
	
	НовыйПрогнозДата = Справочники.CW_ПлановыеСтатьиЗатратИДоходов.РассчитатьПрогнозОплатыСтатьиБюджета(ПараметрыРасчета); 
	Если НовыйПрогнозДата <> Неопределено 
		И НовыйПрогнозДата <> ПрогнозДата Тогда
		ПрогнозДата = НовыйПрогнозДата;   
		Модифицированность = истина;
		УстановитьПредставлениеПрогнозаДДС();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)                                            
	
	Если ИспользуетсяПрогнозированиеДДСПоБюджету 
		и ТипЗнч(Объект.Владелец) = Тип("СправочникСсылка.CW_Грузоперевозки") Тогда 
		РасчитатьПрогнозНаСервере();
		РегистрыСведений.CW_ПрогнозОплатыПлановыхСтатейБюджета.ЗаписатьПрогнозОплаты(Объект.Ссылка, ПрогнозДата);
		ПрогнозДата = РегистрыСведений.CW_ПрогнозОплатыПлановыхСтатейБюджета.ПолучитьПрогнозОплаты(Объект.Ссылка);
		УстановитьПредставлениеПрогнозаДДС();             
	КонецЕсли;  
	
	УстановитьОтборДинамическогоСписка();
	
КонецПроцедуры
