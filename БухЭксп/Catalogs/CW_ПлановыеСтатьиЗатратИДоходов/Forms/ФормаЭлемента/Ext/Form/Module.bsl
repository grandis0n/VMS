Процедура ПредставлениеКурсаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;  
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ОбработкаВыбораКурса",ЭтотОбъект);  
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ВладелецСтатьи", 	Объект.Владелец);
	ПараметрыФормы.Вставить("ТипКурсаВалюты", 	Объект.ТипКурсаВалюты);
	ПараметрыФормы.Вставить("Курс", 			Объект.Курс);
	ПараметрыФормы.Вставить("Кратность", 		Объект.Кратность);   
	ПараметрыФормы.Вставить("КонтрольнаяДата",  Объект.КонтрольнаяДатаКурсаДляПроверки); 
	
	ПараметрыФормы.Вставить("ВариантПоДате",  	Объект.Валюта <> ВРУ); 
	
	
	ОткрытьФорму("Справочник.CW_ПлановыеСтатьиЗатратИДоходов.Форма.ФормаВыбораКурсаВалюты", ПараметрыФормы,,,,,ОписаниеОповещения,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбораКурса(Результат, ДополнительныеПараметры) Экспорт 
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;  
	
	Модифицированность = истина;  
	
	Объект.ТипКурсаВалюты 	= Результат.ТипКурсаВалюты;
	
	Если Результат.ТипКурсаВалюты = 0 Тогда   
		
		СтруктураКурса = CW_Финансы.ПолучитьКурсВалюты(Объект.Валюта, ДатаВладельца); 
		Объект.Курс 		= СтруктураКурса.Курс;
		Объект.Кратность 	= СтруктураКурса.Кратность; 
		Объект.КонтрольнаяДатаКурсаДляПроверки = Неопределено;	
		
	ИначеЕсли Результат.ТипКурсаВалюты = 1 Тогда
		
		Объект.Курс 		= Результат.Курс;
		Объект.Кратность 	= Результат.Кратность;
		Объект.КонтрольнаяДатаКурсаДляПроверки = Неопределено;	
		
	ИначеЕсли Результат.ТипКурсаВалюты = 2 Тогда 

		ДатаКурсаСтатьи 	= CW_Бюджетирование.ПолучитьДатуКурсаПлановойСтатьи(Объект.Владелец, Результат.КонтрольнаяДата, ДатаВладельца);
		СтруктураКурса  	= CW_Финансы.ПолучитьКурсВалюты(Объект.Валюта, ДатаКурсаСтатьи.Дата); 
		
		Объект.КонтрольнаяДатаКурсаДляПроверки 	= Результат.КонтрольнаяДата;	
		Объект.Курс 							= СтруктураКурса.Курс;
		Объект.Кратность 						= СтруктураКурса.Кратность; 
		
	КонецЕсли;
	
	УстановитьПредставлениеКурса();
	
	_КурсПриИзменении();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьПредставлениеКурса() 
	
	СоответствиеТипаКурса = Новый Соответствие;
	СоответствиеТипаКурса.Вставить(0, " (Авто.)");
	СоответствиеТипаКурса.Вставить(1, " (Фикс.)");
	СоответствиеТипаКурса.Вставить(2, " ("+СокрЛП(Объект.КонтрольнаяДатаКурсаДляПроверки)+")"); 
	
	ПредставлениеТипаКурса 	= СоответствиеТипаКурса.Получить(Объект.ТипКурсаВалюты);
	ПредставлениеКурса 		= Формат(Объект.Курс, "ЧДЦ=4; ЧГ=0") + ?(Объект.Кратность > 1, "/"+Формат(Объект.Кратность,"ЧЦ=10; ЧГ="), "") + ПредставлениеТипаКурса;
	
КонецПроцедуры   

   &НаКлиенте
Процедура ПредставлениеКурсаПриИзменении(Элемент)
	УстановитьПредставлениеКурса();
КонецПроцедуры

