	Результат.Свойство("ПрогнозКоличествоДней", 	Объект.ПрогнозКоличествоДней);
	Результат.Свойство("ПрогнозКоличествоДнейПлан", Объект.ПрогнозКоличествоДнейПлан);
	Результат.Свойство("ПрогнозДата", 				ПрогнозДата);
	
