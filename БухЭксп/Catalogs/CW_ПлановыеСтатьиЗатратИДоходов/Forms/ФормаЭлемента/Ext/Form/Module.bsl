&НаСервере
Процедура УстановитьОтборДинамическогоСписка()
	
	СписокДокументов.Отбор.Элементы.Очистить();
	
	ЭлементОтбра = СписокДокументов.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбра.ЛевоеЗначение 	= Новый ПолеКомпоновкиДанных("СтатьяБюджета");
	ЭлементОтбра.ВидСравнения 	= ВидСравненияКомпоновкиДанных.Равно;
	ЭлементОтбра.ПравоеЗначение	= ?(Объект.Ссылка.Пустая(), Неопределено, Объект.Ссылка);
	ЭлементОтбра.Использование 	= Истина;  
	
	Запрос = Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ
	|	CW_ДоходыПоГрузоперевозкамОбороты.СтатьяБюджета КАК СтатьяБюджета,
	|	CW_ДоходыПоГрузоперевозкамОбороты.ДокументДоходов КАК Документ,
	|	CW_ДоходыПоГрузоперевозкамОбороты.ДокументДоходов.ПредставлениеДокумента КАК ПредставлениеДокумента,
	|	CW_ДоходыПоГрузоперевозкамОбороты.Валюта КАК Валюта,
	|	CW_ДоходыПоГрузоперевозкамОбороты.ВсегоОборот КАК Всего,
	|	CW_ДоходыПоГрузоперевозкамОбороты.Всего_ВалютаОборот КАК ВсегоВал
	|ПОМЕСТИТЬ ВТ_Данные
	|ИЗ
	|	РегистрНакопления.CW_ДоходыПоГрузоперевозкам.Обороты(, , Период, СтатьяБюджета = &СтатьяБюджета) КАК CW_ДоходыПоГрузоперевозкамОбороты
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	CW_РасходыПоГрузоперевозкамОбороты.СтатьяБюджета,
	|	CW_РасходыПоГрузоперевозкамОбороты.ДокументРасходов,
	|	CW_РасходыПоГрузоперевозкамОбороты.ДокументРасходов.ПредставлениеДокумента,
	|	CW_РасходыПоГрузоперевозкамОбороты.Валюта,
	|	CW_РасходыПоГрузоперевозкамОбороты.ВсегоОборот,
	|	CW_РасходыПоГрузоперевозкамОбороты.Всего_ВалютаОборот
	|ИЗ
	|	РегистрНакопления.CW_РасходыПоГрузоперевозкам.Обороты(, , Период, СтатьяБюджета = &СтатьяБюджета) КАК CW_РасходыПоГрузоперевозкамОбороты
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВТ_Данные.Документ КАК Документ
	|ИЗ
	|	ВТ_Данные КАК ВТ_Данные"; 
	
	Запрос.УстановитьПараметр("СтатьяБюджета", ?(Объект.Ссылка.Пустая(), Неопределено, Объект.Ссылка)); 
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	КоличествоДокументов = Выборка.Количество();
	
КонецПроцедуры





