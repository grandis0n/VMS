#Область СобытияФормы 

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка) 
	
	мТмп = _сф.ст_ПолучитьСвойство(Параметры.ЗначенияЗаполнения,"ТолькоПросмотр");
	мТмп = ?(мТмп = Неопределено,Ложь,мТмп);
	мТмп2 = _сф.ст_ПолучитьСвойство(Параметры,"ТолькоПросмотр");
	мТмп2 = ?(мТмп2 = Неопределено,Ложь,мТмп2);
	ЭтаФорма.ТолькоПросмотр = (мТмп ИЛИ мТмп2); 
	
	ВРУ = CW_Настройки.ВалютаРегламентированногоУчета(); 
	
	ИспользованиеСхемыПеревыставленияПоСтавкам = ПолучитьФункциональнуюОпцию("CW_ИспользованиеСхемыПеревыставленияПоСтавкам");

	//Подсистема.ОграничениеСпискаУслуг
	Массив = новый Массив;
	Массив.Добавить(ПредопределенноеЗначение("Перечисление.CW_ПорядокОтраженияДоходов.Перевыставление"));
	Массив.Добавить(ПредопределенноеЗначение("Перечисление.CW_ПорядокОтраженияЗатрат.Перевыставление"));
	//Подсистема.ОграничениеСпискаУслуг
	
	Если ИспользованиеСхемыПеревыставленияПоСтавкам Тогда
		//Подсистема.ОграничениеСпискаУслуг
		Массив.Добавить(ПредопределенноеЗначение("Перечисление.CW_ПорядокОтраженияДоходов.ПеревыставлениеПоСтавкам"));
		Массив.Добавить(ПредопределенноеЗначение("Перечисление.CW_ПорядокОтраженияЗатрат.ПеревыставлениеПоСтавкам"));
		//Подсистема.ОграничениеСпискаУслуг
		
		Элементы.ПорядокОтраженияРасходов.СписокВыбора.Добавить(Перечисления.CW_ПорядокОтраженияЗатрат.ПеревыставлениеПоСтавкам);
		Элементы.ПорядокОтраженияДоходов.СписокВыбора.Добавить(Перечисления.CW_ПорядокОтраженияДоходов.ПеревыставлениеПоСтавкам);
	КонецЕсли; 
	
	//Подсистема.ОграничениеСпискаУслуг
	МассивПеревыставлений = Новый ФиксированныйМассив(Массив);
	//Подсистема.ОграничениеСпискаУслуг
	
	УказыватьДоговор = ПолучитьФункциональнуюОпцию("CW_УказыватьДоговорДляПлановыхСтатейБюджета");
	ПоказатьПриложениеКДоговору = Ложь;
	Если ЗначениеЗаполнено(Объект.Договор) Тогда
		ПараметрОпции = Новый Структура("CW_ДоговорПоГрузоперевозкам", Объект.Договор);
		ПоказатьПриложениеКДоговору = ПолучитьФункциональнуюОпцию("CW_ВедетсяУчетПриложенийПоДоговорам", ПараметрОпции);
	КонецЕсли;
	
	Элементы.Договор.Видимость = УказыватьДоговор;
	Элементы.ПриложениеКДоговору.Видимость = УказыватьДоговор и ПоказатьПриложениеКДоговору; 
	
	Элементы.ПорядокОтраженияРасходов.Видимость = Ложь;
	Элементы.ПорядокОтраженияДоходов.Видимость = Ложь;
	
	// строка заголовка
	Если Объект.ВидСтатьиПланирования = Перечисления.CW_ВидыСтатейПланирования.Доходы Тогда 
		
		стр = "Плановый доход";
		Элементы.ГруппаСтатья.Заголовок = "Доход";
		Элементы.Контрагент.Заголовок = "Клиент";
		Элементы.ПорядокОтраженияДоходов.Видимость = Истина;
		
		НовыеПараметры = Новый Массив;
		НовыеПараметры.Добавить(Новый ПараметрВыбора("Отбор.ВидДоговора", ПредопределенноеЗначение("Перечисление.ВидыДоговоровКонтрагентов.СПокупателем")));
		Элементы.Договор.ПараметрыВыбора =  Новый ФиксированныйМассив(НовыеПараметры);
		
	ИначеЕсли Объект.ВидСтатьиПланирования = Перечисления.CW_ВидыСтатейПланирования.Расходы Тогда  
		
		стр = "Плановая затрата";
		Элементы.ГруппаСтатья.Заголовок = "Затрата";
		Элементы.Контрагент.Заголовок = "Поставщик";
		Элементы.ПорядокОтраженияРасходов.Видимость = Истина;
		
		НовыеПараметры = Новый Массив;
		НовыеПараметры.Добавить(Новый ПараметрВыбора("Отбор.ВидДоговора", ПредопределенноеЗначение("Перечисление.ВидыДоговоровКонтрагентов.СПоставщиком")));
		Элементы.Договор.ПараметрыВыбора =  Новый ФиксированныйМассив(НовыеПараметры);
	
	Иначе 
		
		стр = "НЕ ОПРЕДЕЛЕН ВИД СТАТЬИ ПЛАНИРОВАНИЯ!";
		
	КонецЕсли;
	
	// заголовок формы
	Если ЗначениеЗаполнено(Объект.Владелец) Тогда  
		Если ТипЗнч(Объект.Владелец) = Тип("СправочникСсылка.CW_ВариантыБюджетовПоЗаявкам") Тогда
			// заявка
			Заголовок = Стр + ". Вариант бюджета: " + Объект.Владелец;	
		Иначе
			// грузоперевозка
			Заголовок = Стр + ". Версия бюджета: " + Объект.ВерсияБюджета;	
		КонецЕсли;
	Иначе
		Заголовок = стр + " НЕ ОПРЕДЕЛЕН ВЛАДЕЛЕЦ СТАТЬИ!";
	КонецЕсли;
	
	УстановитьДатуВладельца();
	
	Если ТипЗнч(Объект.Владелец) = Тип("СправочникСсылка.CW_Грузоперевозки") Тогда
		ВалютаБюджета = Справочники.CW_ТипыПеревозок.ПолучитьВалютуДатуКурсаБюджета(Объект.Владелец.ТипПеревозки, Объект.ВидСтатьиПланирования); 
		Если ВалютаБюджета <> Неопределено Тогда
			СтруктураВалютаБюджета = новый ФиксированнаяСтруктура(ВалютаБюджета); 
		КонецЕсли;
	КонецЕсли; 
	
	// заполнение данных нового элемента
	Если Объект.Ссылка.Пустая() Тогда 
		
		// читаем настройки
		Объект.Организация 	= CW_Настройки.ОсновнаяОрганизация();
		Объект.ЦенаСНДС = CW_Настройки.ПолучитьНастройкуПользователя(, "ЦенаСНДС" + Объект.ВидСтатьиПланирования);
		
		ТипДвижения = "ДОХОДЫ";
		Если Объект.ВидСтатьиПланирования = ПредопределенноеЗначение("Перечисление.CW_ВидыСтатейПланирования.Расходы") Тогда
			ТипДвижения = "РАСХОДЫ";
		КонецЕсли;
	                                
		ПараметрыСтавкиНДС = Новый Структура;
		ПараметрыСтавкиНДС.Вставить("Дата", 		ДатаВладельца);
		ПараметрыСтавкиНДС.Вставить("Организация", 	Объект.Организация);
		ПараметрыСтавкиНДС.Вставить("Номенклатура", Объект.Номенклатура);
		ПараметрыСтавкиНДС.Вставить("Договор", 		Объект.Договор); 
		ПараметрыСтавкиНДС.Вставить("ПодставлятьСтавкуНДС",  CW_Настройки.ПолучитьНастройкуПользователя(ПараметрыСеанса.ТекущийПользователь,"ПодставлятьСтавкуНДС"));
		ПараметрыСтавкиНДС.Вставить("ТипДвижения",  ТипДвижения);
		
		Объект.СтавкаНДС = CW_Документы.ПолучитьСтавкуНДС(ПараметрыСтавкиНДС);

		ДатаКурсаСтатьи			= ДатаВладельца;
		
		Если ТипЗнч(Объект.Владелец) = Тип("СправочникСсылка.CW_Грузоперевозки") Тогда
			
			Если СтруктураВалютаБюджета <> Неопределено Тогда
				Объект.ТипКурсаВалюты = СтруктураВалютаБюджета.ТипКурсаВалюты;
				Если Объект.ТипКурсаВалюты = 2 и ЗначениеЗаполнено(СтруктураВалютаБюджета.ДатаКурса) Тогда 
					
					ДанныеКурса = CW_Бюджетирование.ПолучитьДатуКурсаПлановойСтатьи(Объект.Владелец, СтруктураВалютаБюджета.ДатаКурса, ДатаВладельца);
					Объект.КонтрольнаяДатаКурсаДляПроверки 	= СтруктураВалютаБюджета.ДатаКурса; 
					Если ЗначениеЗаполнено(ДанныеКурса.Дата) Тогда
						ДатаКурсаСтатьи = ДанныеКурса.Дата;	
					КонецЕсли; 
					
				КонецЕсли;   
				
				Объект.Валюта =	СтруктураВалютаБюджета.Валюта
			КонецЕсли;
			
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Объект.Валюта) Тогда    
			Объект.Валюта 		= ПолучитьОсновнуюВалюту(); 
		КонецЕсли;
		
		СтруктураКурса  	= CW_Финансы.ПолучитьКурсВалюты(Объект.Валюта, ДатаКурсаСтатьи); 	
		Объект.Курс 		= СтруктураКурса.Курс;
		Объект.Кратность 	= СтруктураКурса.Кратность;  
		
		// установка опции учета НДС в себестоимости
		ОрганизацияПриИзмененииНаСервере();		
	КонецЕсли; 
	
	// определяем режим выбора контрагентов
	Если (Константы.CW_ОграничиватьВыборКонтрагентовПоБюджету.Получить()) Тогда
		
		Если ТипЗНЧ(Объект.Владелец) = Тип("СправочникСсылка.CW_Грузоперевозки") Тогда
			Если Объект.Владелец.Заказ.Пустая()  Тогда
				ТаблицаКонтрагентов = Объект.Владелец.КонтрагентыПоБюджету.Выгрузить();
			Иначе
				ТаблицаКонтрагентов = Объект.Владелец.Заказ.КонтрагентыПоБюджету.Выгрузить();
			КонецЕсли; 
			
			МассивКонтрагентов = ТаблицаКонтрагентов.ВыгрузитьКолонку("Контрагент");
			
			Если Параметры.ЗначенияЗаполнения.Свойство("Контрагент") Тогда
				Если МассивКонтрагентов.Найти(Параметры.ЗначенияЗаполнения.Контрагент) = Неопределено Тогда
					//Добавляем переданного в параметрах контрагента
					МассивКонтрагентов.Добавить(Параметры.ЗначенияЗаполнения.Контрагент);
				КонецЕсли;
			КонецЕсли;

			Элементы.Контрагент.СписокВыбора.Очистить();
			Для каждого Элемент Из МассивКонтрагентов Цикл
				
				Элементы.Контрагент.СписокВыбора.Добавить(Элемент);
				
			КонецЦикла; 
			Элементы.Контрагент.РежимВыбораИзСписка = Истина;
		КонецЕсли;
		
	КонецЕсли;       
	
	УстановитьПредставлениеКурса();
	
	//Использование количества
	ИспользованиеКоличестваДляПлановыхСтатей = ПолучитьФункциональнуюОпцию("CW_ИспользованиеКоличестваДляПлановыхСтатей");
	Если ТипЗнч(Объект.Владелец) = Тип("СправочникСсылка.CW_Грузоперевозки") Тогда
		ПолучениеКоличестваУслугИзПараметраГрузоперевозки = ПолучитьФункциональнуюОпцию("CW_РазрешитьПолучениеКоличестваУслугИзПараметраГрузоперевозки");  
		Если Параметры.Ключ.Пустая() Тогда
			Объект.Количество = 1;
		КонецЕсли;
	КонецЕсли;
	
	Элементы.ОбновитьКоличество.Видимость = ИспользованиеКоличестваДляПлановыхСтатей и ПолучениеКоличестваУслугИзПараметраГрузоперевозки; 
	//Использование количества    
	
	//Прогноз ДДС   
	ИспользуетсяПрогнозированиеДДСПоБюджету = ПолучитьФункциональнуюОпцию("CW_ИспользуетсяПрогнозированиеДДСПоБюджету"); 
	Если ИспользуетсяПрогнозированиеДДСПоБюджету Тогда
		ПрогнозДата = РегистрыСведений.CW_ПрогнозОплатыПлановыхСтатейБюджета.ПолучитьПрогнозОплаты(Объект.Ссылка);
		УстановитьПредставлениеПрогнозаДДС();             
	КонецЕсли;
	//Прогноз ДДС  
	
	//Подсистема.ОграничениеСпискаУслуг  
	Если УказыватьДоговор Тогда
		ОграничиватьУслугиПоДоговорам = ПолучитьФункциональнуюОпцию("CW_ОграничиватьУслугиПоДоговорам");
		Если ОграничиватьУслугиПоДоговорам Тогда
			НеОграничиватьУслугиПоПеревыставлению 	= Константы.CW_НеОграничиватьСписокУслугПриПеревыставленииЗатрат.Получить();
		КонецЕсли;                 
		
		УстановитьСписокДоступнойНоменклатуры();  
	КонецЕсли;
	//Подсистема.ОграничениеСпискаУслуг  
	
	УстановитьВидимостьЗначенияНаценки();

	ОбратныйПересчетВДокументах  = CW_Настройки.ПолучитьНастройкуПользователя(,"ОбратныйПересчетВДокументах");
	
	_ПраваДоступа(); 
	
	Элементы.ПорядокРаспределенияСуммы.Видимость = (ТипЗнч(Объект.Владелец) = Тип("СправочникСсылка.CW_ВариантыБюджетовПоЗаявкам"));
	
	УстановитьОтборДинамическогоСписка();
	
	Элементы.СрокДействия.Видимость = (Объект.ВидСтатьиПланирования = Перечисления.CW_ВидыСтатейПланирования.Расходы)
		И (ТипЗнч(Объект.Владелец) = Тип("СправочникСсылка.CW_ВариантыБюджетовПоЗаявкам"));
	
	УстановитьВидимостьПриложения();  
	
	// опция "НДС в себестоимости" должна отображаться только для расходых статей
	Элементы.УчитыватьНДСВСебестоимости.Видимость = (Объект.ВидСтатьиПланирования = Перечисления.CW_ВидыСтатейПланирования.Расходы);

	//Внешние подклчюаемые команды
	CW_ПодключаемыеКомандыСервер.ПриСозданииНаСервере(ЭтотОбъект);
	
КонецПроцедуры  

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект) 
	
	УстановитьПараметрыДоговора();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьЗначенияНаценки()
	
	ЭтоРасходнаяСтатья = (Объект.ВидСтатьиПланирования = ПредопределенноеЗначение("Перечисление.CW_ВидыСтатейПланирования.Расходы"));

	Элементы.ВариантНаценки.Видимость  = ЭтоРасходнаяСтатья;
	Элементы.ЗначениеНаценки.Видимость = ЭтоРасходнаяСтатья И НЕ (Объект.ВариантНаценки = ПредопределенноеЗначение("Перечисление.CW_ВариантыНаценки.Нет"));
	
КонецПроцедуры


&НаСервере
Функция УстановитьДатуВладельца() 
	
	Если ТипЗнч(Объект.Владелец) = Тип("СправочникСсылка.CW_Грузоперевозки") Тогда
		ДатаВладельца = Объект.Владелец.ДатаСделкиФ;
	КонецЕсли;
	
	Если ТипЗнч(Объект.Владелец) = Тип("СправочникСсылка.CW_ВариантыБюджетовПоЗаявкам") Тогда
		ДатаВладельца = Объект.Владелец.Владелец.ДатаОбращения;
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ДоступностьКурса();	
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	ОповеститьОЗаписиНового(Объект.Ссылка);
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	//Подсистема.ОграничениеСпискаУслуг
	Если ИмяСобытия = "ОбновитьСписокУслугПоПротоколу" Или  ИмяСобытия = "ОбновитьАдресУслугДоговора" Тогда 
		УстановитьСписокДоступнойНоменклатуры();   
	КонецЕсли;
	//Подсистема.ОграничениеСпискаУслуг
	
КонецПроцедуры


#КонецОбласти 

&НаСервере
Процедура _ПраваДоступа()
	// --- 
	
	ПравоРедактирования = CW_ПраваДоступа.ПравоДоступно("РедактированиеБюджетов");
	Если НЕ ПравоРедактирования Тогда
		
		ЭтаФорма.ТолькоПросмотр = Истина;
		Элементы.ФормаЗаписатьИЗакрыть.Видимость = Ложь;
		Элементы.ФормаЗаписать.Видимость = Ложь;
		Элементы.ФормаЗакрыть.КнопкаПоУмолчанию = Истина;
		
	КонецЕсли; 
	
	Если ПравоРедактирования Тогда
		
		// проверяем права на курс
		ПравоРедактированияКурса = CW_ПраваДоступа.ПравоДоступно("ИзменениеКурсаПланирования");
		Если НЕ ПравоРедактированияКурса Тогда
			Элементы.ПредставлениеКурса.Доступность = Ложь;
			Элементы.УстановитьКурс.Доступность = Ложь;
		КонецЕсли; 
		
	КонецЕсли; 
	
	Элементы.СтавкаНДС.Доступность =  CW_ПраваДоступа.ПравоДоступно("БюджетированиеРедактированиеСтавкиНДС");
	// --- 
КонецПроцедуры

#Область Контрагент 

&НаКлиенте
Процедура КонтрагентНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	Если (НЕ Элемент.РежимВыбораИзсписка) Тогда
		
		Если (Объект.ВидСтатьиПланирования=ПредопределенноеЗначение("Перечисление.CW_ВидыСтатейПланирования.Доходы")) Тогда
			_УФК.ВыбратьКлиента(Объект.Контрагент,Элемент, ДанныеВыбора, СтандартнаяОбработка);
		ИначеЕсли (Объект.ВидСтатьиПланирования=ПредопределенноеЗначение("Перечисление.CW_ВидыСтатейПланирования.Расходы")) Тогда 
			_УФК.ВыбратьПоставщика(Объект.Контрагент,Элемент, ДанныеВыбора, СтандартнаяОбработка);
		КонецЕсли; 
		
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура КонтрагентПриИзменении(Элемент)
	
	ПодставитьЦенуНоменклатуры(Ложь,Истина);
	ПриИзмененииДоговораНаСервере();

КонецПроцедуры

#КонецОбласти 

#Область СобытияВалюты 

&НаСервере
Функция ПолучитьОсновнуюВалюту()
	
	Возврат(CW_Настройки.ВалютаРегламентированногоУчета());
	
КонецФункции

&НаКлиенте
Процедура ВалютаПриИзменении(Элемент) 
	
	Если ЗначениеЗаполнено(Объект.Валюта) Тогда  
		ДатаКурса = ДатаВладельца;
		Объект.КонтрольнаяДатаКурсаДляПроверки = Неопределено; 
		Если Объект.Валюта <> ВРУ Тогда
			Если СтруктураВалютаБюджета <> Неопределено  и ЗначениеЗаполнено(СтруктураВалютаБюджета.ДатаКурса) Тогда
				Объект.КонтрольнаяДатаКурсаДляПроверки = СтруктураВалютаБюджета.ДатаКурса;
			КонецЕсли;                     
			Если  ЗначениеЗаполнено(Объект.КонтрольнаяДатаКурсаДляПроверки) Тогда
				СтруктураКурса 	= CW_Бюджетирование.ПолучитьДатуКурсаПлановойСтатьи(Объект.Владелец, Объект.КонтрольнаяДатаКурсаДляПроверки, ДатаВладельца);
				ДатаКурса 		= СтруктураКурса.Дата;
				Объект.ТипКурсаВалюты = 2;
			КонецЕсли;
		КонецЕсли;
		
		_ВалютаПриИзменении(ДатаКурса);   
		
		ДоступностьКурса();   
		
	Иначе
		Объект.ТипКурсаВалюты 	= 0;
		Объект.Курс 			= Неопределено;
		Объект.Кратность		= Неопределено;
		Объект.КонтрольнаяДатаКурсаДляПроверки = Неопределено;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура _ВалютаПриИзменении(ДатаКурса)
	
	СтруктураКурса = CW_Финансы.ПолучитьКурсВалюты(Объект.Валюта, ДатаКурса); 
	
	Объект.Курс 		= СтруктураКурса.Курс;
	Объект.Кратность 	= СтруктураКурса.Кратность;

	_КурсПриИзменении();

	УстановитьПредставлениеКурса();

	УстановитьЦенуНоменклатуры();
	
КонецПроцедуры

#КонецОбласти 

#Область СобытияКурса 

&НаКлиенте
Процедура ДоступностьКурса()
	
	Элементы.ГруппаПредставлениеКурса.Видимость = ?(Объект.Валюта = ВРУ, Ложь, Истина);
	
КонецПроцедуры

&НаСервере
Процедура _КурсПриИзменении()
	
	ПересчетСуммНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьКурс(Команда)
	
	Если ЗначениеЗаполнено(Объект.Валюта) Тогда   
		Если Объект.ТипКурсаВалюты = 2 Тогда
			ДатаКурсаСтатьи = CW_Бюджетирование.ПолучитьДатуКурсаПлановойСтатьи(Объект.Владелец, Объект.КонтрольнаяДатаКурсаДляПроверки, ДатаВладельца);
			_ВалютаПриИзменении(ДатаКурсаСтатьи.Дата);
		ИначеЕсли Объект.ТипКурсаВалюты = 0 Тогда
			_ВалютаПриИзменении(ДатаВладельца);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры
 

#КонецОбласти 

#Область СобытияНоменклатуры 

&НаКлиенте
Процедура НоменклатураПриИзменении(Элемент)  
	
	Если ЗначениеЗаполнено(Объект.Номенклатура) Тогда 
		_НоменклатураПриИзменении();
	КонецЕсли; 
	
КонецПроцедуры

&НаСервере
Процедура _НоменклатураПриИзменении()
	
	Объект.ЕдиницаИзмерения = Объект.Номенклатура.ЕдиницаИзмерения; 
	
	УстановитьЦенуНоменклатуры();
	
	//Подсистема.ОграничениеСпискаУслуг 
	Если ИспользуетсяОгранчиениеУслуг Тогда 
		
		СтруктураПараметров = Новый Структура;
		СтруктураПараметров.Вставить("АдресУслугПоДоговору"						, АдресУслугПоДоговору);
		СтруктураПараметров.Вставить("УстанавливатьЦенуВЗависимостиОтГруза"		, Ложь);
		СтруктураПараметров.Вставить("УстанавливатьЦенуВЗависимостиОтКлиента"	, Ложь);
		
		СтруктураПараметров.Вставить("Номенклатура"								, Объект.Номенклатура);
		
		УслугаДоговора = _УФС.ПолучитьУслугуДоговораПоПараметрам(СтруктураПараметров);	
		
		Если УслугаДоговора <> Неопределено Тогда 
			
			Объект.СтавкаНДС	= УслугаДоговора.СтавкаНДС; 
			Объект.Количество = ?(Объект.Количество = 0,1,Объект.Количество);
			
			Если Объект.ВидСтатьиПланирования = ПредопределенноеЗначение("Перечисление.CW_ВидыСтатейПланирования.Доходы") Тогда
				Объект.ПорядокОтраженияДоходов	= УслугаДоговора.ПорядокОтражения;                                                             
			ИначеЕсли Объект.ВидСтатьиПланирования = ПредопределенноеЗначение("Перечисление.CW_ВидыСтатейПланирования.Расходы") Тогда
				Объект.ПорядокОтраженияРасходов	= УслугаДоговора.ПорядокОтражения;                                                             
			КонецЕсли;   
			
			Если УслугаДоговора.ВариантРасчетаНДС = ПредопределенноеЗначение("Перечисление.ВариантыРасчетаНДС.НДСВСумме") Тогда  
				
				Объект.СуммаВсего = УслугаДоговора.Цена * Объект.Количество;  
				СуммаВсегоПриИзмененииНаСервере();
			Иначе
				Объект.Цена = УслугаДоговора.Цена;  
				ЦенаПриИзмененииНаСервере()	
			КонецЕсли;
			
		КонецЕсли;	
		
	// ограничение списка услуг не используется
	Иначе
		ПодставлятьСтавку = CW_Настройки.ПолучитьНастройкуПользователя(CW_Настройки.Пользователь(),"ПодставлятьСтавкуНДС");  
		Если ПодставлятьСтавку Тогда  
			Объект.СтавкаНДС =  CW_БухгалтерияЭкспедитораСерверПереопределяемый.СтавкаНДС(Объект.Номенклатура, ДатаВладельца);
		Иначе
			ТипДвижения = "ДОХОДЫ";
			Если Объект.ВидСтатьиПланирования = ПредопределенноеЗначение("Перечисление.CW_ВидыСтатейПланирования.Расходы") Тогда
				ТипДвижения = "РАСХОДЫ";
			КонецЕсли;
			
			ПараметрыСтавкиНДС = Новый Структура;
			ПараметрыСтавкиНДС.Вставить("Дата", 		ДатаВладельца);
			ПараметрыСтавкиНДС.Вставить("Организация", 	Объект.Организация);
			ПараметрыСтавкиНДС.Вставить("Номенклатура", Объект.Номенклатура);
			ПараметрыСтавкиНДС.Вставить("Договор", 		Объект.Договор);
			ПараметрыСтавкиНДС.Вставить("ПодставлятьСтавкуНДС",  CW_Настройки.ПолучитьНастройкуПользователя(ПараметрыСеанса.ТекущийПользователь,"ПодставлятьСтавкуНДС"));
			ПараметрыСтавкиНДС.Вставить("ТипДвижения",  ТипДвижения);
			
			Объект.СтавкаНДС = CW_Документы.ПолучитьСтавкуНДС(ПараметрыСтавкиНДС);
		КонецЕсли; // подставлять ставку НДС из номенклатуры
	КонецЕсли;
	//Подсистема.ОграничениеСпискаУслуг   
	
	
	ПересчетСуммНаСервере();   

	Если ИспользованиеКоличестваДляПлановыхСтатей и ПолучениеКоличестваУслугИзПараметраГрузоперевозки Тогда 
		ОбновитьКоличествоНаСервере();
	КонецЕсли;
	
КонецПроцедуры   

&НаСервере
Процедура УстановитьЦенуНоменклатуры() 
	
	Если ТипЗнч(ПараметрыДоговора) <> тип("ФиксированнаяСтруктура") Тогда
		Возврат;
	КонецЕсли;
	
	ТипЦен = Неопределено;
	ПараметрыДоговора.Свойство("ТипЦен", ТипЦен);  
	Если Не ЗначениеЗаполнено(ТипЦен) Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЦеныНоменклатурыСрезПоследних.Номенклатура КАК Номенклатура,
	               |	ЦеныНоменклатурыСрезПоследних.Валюта КАК Валюта,
	               |	ЦеныНоменклатурыСрезПоследних.Цена КАК Цена
	               |ИЗ
	               |	РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
	               |			&ДатаСреза,
	               |			Номенклатура = &Номенклатура
	               |				И ТипЦен = &ТипЦен) КАК ЦеныНоменклатурыСрезПоследних
	               |ГДЕ
	               |	ЦеныНоменклатурыСрезПоследних.Валюта = &Валюта";  
	
	Запрос.УстановитьПараметр("ДатаСреза", 		ТекущаяДата());
	Запрос.УстановитьПараметр("Номенклатура", 	Объект.Номенклатура);
 	Запрос.УстановитьПараметр("ТипЦен", 		ТипЦен); 
 	Запрос.УстановитьПараметр("Валюта", 		Объект.Валюта); 
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	Если Выборка.Следующий() Тогда
		Объект.Цена 		= Выборка.Цена;	
		Объект.Количество 	= 1;
		Объект.Сумма   		= Объект.Цена * Объект.Количество;
		ЦенаПриИзмененииНаСервере();
	КонецЕсли;
	
КонецПроцедуры
	

