	ПриИзмененииДоговораНаСервере();
	ДоступностьКурса();  
	
КонецПроцедуры

&НаСервере
Процедура ПриИзмененииДоговораНаСервере()

	//Подсистема.ОграничениеСпискаУслуг
	УстановитьСписокДоступнойНоменклатуры();
	
	Если ЗначениеЗаполнено(Объект.Договор) Тогда
		Объект.Валюта 		= Объект.Договор.ВалютаДоговора;
		Объект.Организация 	= Объект.Договор.Организация;  
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.Валюта) Тогда  
		ДатаКурса = ДатаВладельца;
		Объект.КонтрольнаяДатаКурсаДляПроверки = Неопределено; 
		Если Объект.Валюта <> ВРУ Тогда
			Если СтруктураВалютаБюджета <> Неопределено и ЗначениеЗаполнено(СтруктураВалютаБюджета.ДатаКурса) Тогда
				Объект.КонтрольнаяДатаКурсаДляПроверки = СтруктураВалютаБюджета.ДатаКурса;
			КонецЕсли;                     
			Если  ЗначениеЗаполнено(Объект.КонтрольнаяДатаКурсаДляПроверки) Тогда
				СтруктураКурса 	= CW_Бюджетирование.ПолучитьДатуКурсаПлановойСтатьи(Объект.Владелец, Объект.КонтрольнаяДатаКурсаДляПроверки, ДатаВладельца);
				ДатаКурса 		= СтруктураКурса.Дата;
				Объект.ТипКурсаВалюты = 2;
			КонецЕсли;
		КонецЕсли;
		
		_ВалютаПриИзменении(ДатаКурса);   
		
	Иначе
		Объект.ТипКурсаВалюты 	= 0;
		Объект.Курс 			= Неопределено;
		Объект.Кратность		= Неопределено;
		Объект.КонтрольнаяДатаКурсаДляПроверки = Неопределено;
	КонецЕсли;
	
	
	//Элементы.Валюта.Доступность 		= НЕ ЗначениеЗаполнено(Объект.Договор); //доступна всегда. Заявка AFR-240447
	Элементы.Организация.Доступность 	= НЕ ЗначениеЗаполнено(Объект.Договор);
	//Подсистема.ОграничениеСпискаУслуг

	УстановитьВидимостьПриложения();

	УстановитьПараметрыДоговора();
	УстановитьЦенуНоменклатуры();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьПриложения()
	
	//Подсистема.УчетПриложенийДоговоров
	ВедетсяУчетПриложенийПоДоговорам = ПолучитьФункциональнуюОпцию("CW_ВедетсяУчетПриложенийПоДоговорам");
	Элементы.ПриложениеКДоговору.Видимость = Объект.Договор.ИспользуютсяПриложения и ВедетсяУчетПриложенийПоДоговорам;
	//Подсистема.УчетПриложенийДоговоров

КонецПроцедуры  


&НаКлиенте
Процедура ПриложениеКДоговоруПриИзменении(Элемент) 
	
	УстановитьПараметрыДоговора();
	УстановитьЦенуНоменклатуры();

