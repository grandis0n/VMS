Функция ПолучитьСоответствиеИмениНастройкиВидуСтатьи()
	
	Соответствие = Новый Соответствие;
	Соответствие.Вставить(ПредопределенноеЗначение("Перечисление.CW_ВидыСтатейПланирования.Доходы"), 	"ОсновнойПорядокОтраженияДоходовСтатейБюджета");
	Соответствие.Вставить(ПредопределенноеЗначение("Перечисление.CW_ВидыСтатейПланирования.Расходы"), 	"ОсновнойПорядокОтраженияРасходовСтатейБюджета");
	
	Возврат Соответствие;
	
КонецФункции  

Функция ПолучитьСоответствиеПорядкаОтржаенияПоУмочанию()
	
	Соответствие = Новый Соответствие;
	Соответствие.Вставить(ПредопределенноеЗначение("Перечисление.CW_ВидыСтатейПланирования.Доходы"), 	ПредопределенноеЗначение("Перечисление.CW_ПорядокОтраженияДоходов.СобственнаяУслуга"));
	Соответствие.Вставить(ПредопределенноеЗначение("Перечисление.CW_ВидыСтатейПланирования.Расходы"), 	ПредопределенноеЗначение("Перечисление.CW_ПорядокОтраженияЗатрат.Затраты"));
	
	Возврат Соответствие;
	
КонецФункции  

Функция ПолучитьСоответствиеИмениРеквизитаВидуСтатьи()
	
	Соответствие = Новый Соответствие;
	Соответствие.Вставить(ПредопределенноеЗначение("Перечисление.CW_ВидыСтатейПланирования.Доходы"), 	"ПорядокОтраженияДоходов");
	Соответствие.Вставить(ПредопределенноеЗначение("Перечисление.CW_ВидыСтатейПланирования.Расходы"), 	"ПорядокОтраженияРасходов");
	
	Возврат Соответствие;
	
КонецФункции

