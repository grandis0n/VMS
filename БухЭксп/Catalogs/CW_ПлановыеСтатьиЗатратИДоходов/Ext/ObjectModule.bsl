#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("Структура") Тогда
		НастройкиПараметров = CW_Бюджетирование.ПолучитьНастройкиПараметровЗаполнения();  
		Если НастройкиПараметров.МассивПараметов.Количество() > 0 Тогда
			ЗначенияПараметров = CW_Бюджетирование.ПолучитьЗначенияПараметров(ДанныеЗаполнения.Владелец, НастройкиПараметров.МассивПараметов); 
			Для Каждого Параметр из НастройкиПараметров.МассивПараметов Цикл
				ИмяРеквизита 		= НастройкиПараметров.СоответствиеРеквизитов.Получить(Параметр);  
				Если ИмяРеквизита = Неопределено Тогда
					Продолжить;
				КонецЕсли;
				ЭтотОбъект[ИмяРеквизита] = ЗначенияПараметров.Получить(Параметр); 
			КонецЦикла;
		КонецЕсли;   
		
		ПорядокОтржаенияПоУмочанию = ПолучитьСоответствиеПорядкаОтржаенияПоУмочанию();
		
		СоответствиеИмениНастройкиВидуСтатьи = ПолучитьСоответствиеИмениНастройкиВидуСтатьи();
		ИмяНастройки = СоответствиеИмениНастройкиВидуСтатьи.Получить(ДанныеЗаполнения.ВидСтатьиПланирования);
		
		ПорядокОтражения = CW_Настройки.ПолучитьНастройкуПользователя(, ИмяНастройки);
		Если Не ЗначениеЗаполнено(ПорядокОтражения) Тогда
			ПорядокОтражения = ПорядокОтржаенияПоУмочанию.Получить(ДанныеЗаполнения.ВидСтатьиПланирования);	
		КонецЕсли;  
		
		СоответствиеИмениРеквизитаВидуСтатьи = ПолучитьСоответствиеИмениРеквизитаВидуСтатьи();
		ИмяРеквизита = СоответствиеИмениРеквизитаВидуСтатьи.Получить(ДанныеЗаполнения.ВидСтатьиПланирования); 
		
		ЭтотОбъект[ИмяРеквизита] = ПорядокОтражения;
		
	КонецЕсли;  
		
КонецПроцедуры    

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	Если ВариантНаценки = ПредопределенноеЗначение("Перечисление.CW_ВариантыНаценки.Нет")
		ИЛИ ВариантНаценки = ПредопределенноеЗначение("Перечисление.CW_ВариантыНаценки.ПустаяСсылка") Тогда
		
		Индекс = ПроверяемыеРеквизиты.Найти("ЗначениеНаценки");
		Если Индекс <> Неопределено Тогда
			ПроверяемыеРеквизиты.Удалить(Индекс);
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры
 
