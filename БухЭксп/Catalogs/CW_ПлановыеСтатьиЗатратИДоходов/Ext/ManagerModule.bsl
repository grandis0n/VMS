Процедура ОбработкаПолученияПредставления(Данные, Представление, СтандартнаяОбработка) 
	
	СтандартнаяОбработка = ложь;
	
	Массив = Новый Массив;
	
	Если ЗначениеЗаполнено(Данные.Номенклатура) Тогда
		Массив.Добавить(Данные.Номенклатура);            
	КонецЕсли;
	Если ЗначениеЗаполнено(Данные.Контрагент) Тогда
		Массив.Добавить(Данные.Контрагент);
	КонецЕсли;
	
	Массив.Добавить(Формат(Данные.СуммаВсего, "ЧДЦ=2; ЧН=0.00")+" "+СокрЛП(Данные.Валюта));
	
	Представление = СтрСоединить(Массив, ", ");

