&НаКлиенте
Процедура ТипПеревозкиПриИзменении(Элемент)
	
	ВыполнитьДействие(_УФКС.СД("Грузоперевозки","сервер","/ПроверитьНомерКонтейнера"));
	ВыполнитьДействие(_УФКС.СД("Грузоперевозки","сервер","/УправлениеЭлементамиФормы"));
	
	// ---------------------------------------------------------------------------- 
	
	ДиалогЗаполненияПоТипу();
	
