КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПараметрыПоТипуПеревозки(ВариантЗаполнения)

	ЗаполнитьПредопределенныеЗначенияРеквизитовШапки();
	_ЗаполнитьПараметрыПоТипуПеревозки(ВариантЗаполнения);
	_ЗаполнитьПредопределенныеЗначенияПараметровДляРеквизита(Объект.ТипПеревозки, "ТипПеревозки");

	ЭтаФорма.Модифицированность = Истина;
	ОбновитьДеревоПараметров();
	
	// --- 
КонецПроцедуры

&НаСервере
Процедура _ЗаполнитьПараметрыПоТипуПеревозки(ВариантЗаполнения)
	// --- 
	
	// удаляем несоответствующие параметры
	Если (ВариантЗаполнения = 1) Тогда
		
		МассивУдаляемых = Новый Массив;
		Для каждого СтрПараметр Из Объект.ПараметрыГрузоперевозки Цикл
			
			Отбор = Новый Структура("Параметр", СтрПараметр.Параметр);
			СтрокаПараметра = _сф.к_НайтиСтроку(Объект.ТипПеревозки.ПараметрыГрузоперевозки, Отбор);
			Если (СтрокаПараметра = Неопределено) Тогда
				МассивУдаляемых.Добавить(СтрПараметр);
			КонецЕсли; 
			
		КонецЦикла;
		_сф.к_УдалитьЭлементыПоМассиву(Объект.ПараметрыГрузоперевозки, МассивУдаляемых);
		
	КонецЕсли; 
	
	// переносим иерархию
	Если (ВариантЗаполнения = 0 ИЛИ ВариантЗаполнения = 1) Тогда
		
		// очищаем текущие группы
		Объект.ГруппыПараметровГрузоперевозки.Очистить();
		// копируем группы из типа 
		Объект.ГруппыПараметровГрузоперевозки.Загрузить(Объект.ТипПеревозки.ГруппыПараметровГрузоперевозки.Выгрузить());
		
	КонецЕсли; 
	
	// переносим параметры из типа
	Для каждого СтрПараметр Из Объект.ТипПеревозки.ПараметрыГрузоперевозки Цикл
		
		Отбор = Новый Структура("Параметр", СтрПараметр.Параметр);
		СтрокаПараметра = _сф.к_НайтиСтроку(Объект.ПараметрыГрузоперевозки, Отбор);
		Если (СтрокаПараметра = Неопределено) Тогда
			
			// добавляем
			Нстр = Объект.ПараметрыГрузоперевозки.Добавить();
			Нстр.Параметр = СтрПараметр.Параметр;
			Нстр.Значение = СтрПараметр.Параметр.ТипЗначения.ПривестиЗначение(Неопределено); 
			
			//Новый механизм
			Нстр.ИдентификаторВладельца = СтрПараметр.ИдентификаторВладельца;
			//Новый механизм	
			
			//ХранениеПолногоЗначения
			ДобавитьСохраняемоеПолноеЗначение(СтрПараметр.Параметр);
			//---ХранениеПолногоЗначения

		КонецЕсли; 
		
	КонецЦикла; 
	
	Если (ЗначениеЗаполнено(Объект.ОтслеживаемоеОборудование)) Тогда
		
		_ОбновитьСписокПараметровОтслеживаемогоОборудования();
		// добавляем и заполняем параметры	
		Для каждого СтрокаПараметраОС Из Объект.ОтслеживаемоеОборудование.ПараметрыГрузоперевозки Цикл
			
			СтрокаПараметра = CW_Мониторинг.СтрокаПараметра(Объект,СтрокаПараметраОС.Параметр);
			Если (СтрокаПараметра = Неопределено) Тогда
				СтрокаПараметра = Объект.ПараметрыГрузоперевозки.Добавить();
				СтрокаПараметра.Параметр = СтрокаПараметраОС.Параметр;
			КонецЕсли; 
			СтрокаПараметра.Значение = СтрокаПараметраОС.Значение;
			
			//ХранениеПолногоЗначения
			ДобавитьСохраняемоеПолноеЗначение(СтрПараметр.Параметр, СтрокаПараметраОС.Значение);
			//---ХранениеПолногоЗначения
			
		КонецЦикла;
		
	КонецЕсли; 
	
	// --- 
КонецПроцедуры

