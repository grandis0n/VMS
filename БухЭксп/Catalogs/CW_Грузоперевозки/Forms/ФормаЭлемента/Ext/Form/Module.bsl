//Групповое редактирование реквизитов статей бюджета
&НаКлиенте
Процедура ГрупповоеРедактированиеРеквизитаСтатейРасходов(Команда)

	Отказ = Ложь;

	ВыделенныеСтроки 	= Элементы.БюджетРасходы.ВыделенныеСтроки;   
	CW_БюджетированиеКлиент.ПередНачаломГруповогоРедактированияРеквизитовСтатенйБюджета(ВыделенныеСтроки, Отказ);	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;  	

	МассивСтатейБюджета = ПолучитьМассивВыбранныхСтатейБюджетаНаСервере(ВыделенныеСтроки, "БюджетРасходы");

	CW_БюджетированиеКлиент.ГрупповоеРедактированиеРеквизитовСтатейБюджета(ЭтотОбъект, МассивСтатейБюджета, "БюджетРасходы");

КонецПроцедуры

&НаКлиенте
Процедура ГрупповоеРедактированиеРеквизитовСтатейДоходов(Команда)
	Отказ = Ложь;

	ВыделенныеСтроки 	= Элементы.БюджетДоходы.ВыделенныеСтроки;   
	CW_БюджетированиеКлиент.ПередНачаломГруповогоРедактированияРеквизитовСтатенйБюджета(ВыделенныеСтроки, Отказ);	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;  	

	МассивСтатейБюджета = ПолучитьМассивВыбранныхСтатейБюджетаНаСервере(ВыделенныеСтроки, "БюджетДоходы");
	
	CW_БюджетированиеКлиент.ГрупповоеРедактированиеРеквизитовСтатейБюджета(ЭтотОбъект, МассивСтатейБюджета, "БюджетДоходы");
  
КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьФоновоеРедактированиеРеквизитов(РезультатВыполнения, Дополнительныепараметры) Экспорт
	
	Если РезультатВыполнения.Статус = "Выполнено" Тогда
		
		ОповеститьОбИзменении(Тип("СправочникСсылка.CW_ПлановыеСтатьиЗатратИДоходов"));
		
		ВыполнитьДействие(_УФКС.СД("Грузоперевозки","сервер","/БюджетОбновить"));
		
		//Сортировка бюджетов
		ВосстановитьСортировкуТаблицы("БюджетРасходы");
		ВосстановитьСортировкуТаблицы("БюджетДоходы");
		//Сортировка бюджетов
	
	ИначеЕсли РезультатВыполнения.Статус = "Ошибка" Тогда
		
		ТекстПредупреждения = "Не удалось изменить реквизты!
		| По причине: "+ РезультатВыполнения.КраткоеПредставлениеОшибки + "
		| Информаиция об ошибке см. в журнале регистрации!";
		
		Если ТипЗнч(РезультатВыполнения.Сообщения) = Тип("Массив") Тогда
			Для Каждого СообщениеВМассиве из РезультатВыполнения.Сообщения Цикл
				СообщениеВМассиве.Сообщить();
			КонецЦикла;
		КонецЕсли;
		
		ПоказатьПредупреждение(,ТекстПредупреждения,,"Ошибка изменения реквизитов");
	КонецЕсли;
	
КонецПроцедуры
