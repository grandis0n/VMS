&НаКлиенте
Процедура ОбработкаВыбораГрузоперевозки(ВыбранноеЗначение, ДополнительныеПараметры) Экспорт 
	
	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ОбработкаВыбораПараметровКопированияБюджетаГрузоперевозки",ЭтотОбъект); 
	СтруктураПараметров = Новый Структура("Грузоперевозка, ВерсияБюджета", ВыбранноеЗначение, БюджетТекущаяВерсия);
	ОткрытьФорму("Справочник.CW_Грузоперевозки.Форма.ФормаКопированияБюджета",СтруктураПараметров,,,,,ОписаниеОповещения,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбораПараметровКопированияБюджетаГрузоперевозки(РезультатВыбора, ДополнительныеПараметры) Экспорт 
	
	Если РезультатВыбора = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	РезультатВыполнения =  ПродолжитьЗаполнениеБюджетаПоГрузоперевозкеНаСервереВФоне(РезультатВыбора);
	
	Дополнительныепараметры = Новый Структура;
	
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ВыводитьОкноОжидания = Истина;
	ОповещениеОЗавершении = Новый ОписаниеОповещения("ОбработатьРезультатКопированияБюджетаИзГрузоперевозки", ЭтотОбъект);
	
	ДлительныеОперацииКлиент.ОжидатьЗавершение(РезультатВыполнения, ОповещениеОЗавершении, ПараметрыОжидания);

КонецПроцедуры

&НаСервере
Функция ПродолжитьЗаполнениеБюджетаПоГрузоперевозкеНаСервереВФоне(ПараметрыПроцедуры)
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(Новый УникальныйИдентификатор);
	ПараметрыВыполнения.ОжидатьЗавершение 			= 0; // запускать сразу
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = "Копирование бюджета из грузоперевозки";
	ПараметрыВыполнения.ЗапуститьВФоне 				= Истина;
	ПараметрыВыполнения.ЗапуститьНеВФоне 			= ложь;
	
	ПараметрыПроцедуры.Вставить("Ссылка", 			Объект.Ссылка);
	ПараметрыПроцедуры.Вставить("Клиент", 			Объект.Клиент);
	ПараметрыПроцедуры.Вставить("ТекущаяВерсия", 	БюджетТекущаяВерсия);
	
	Возврат ДлительныеОперации.ВыполнитьВФоне("Справочники.CW_Грузоперевозки.СкопироватьБюджетИзГрузоперевозки",ПараметрыПроцедуры, ПараметрыВыполнения);
		
КонецФункции  

&НаКлиенте
Процедура ОбработатьРезультатКопированияБюджетаИзГрузоперевозки(РезультатВыполнения, Дополнительныепараметры) Экспорт
	
	Если РезультатВыполнения.Статус = "Выполнено" Тогда
		
		ВыполнитьДействие(_УФКС.СД("Грузоперевозки","клиент","/БюджетОбновить"));
		
	ИначеЕсли РезультатВыполнения.Статус = "Ошибка" Тогда
		
		ТекстПредупреждения = "Ошибка заполнения бюджетов!
		| По причине: "+ РезультатВыполнения.КраткоеПредставлениеОшибки + "
		| Информаиция об ошибке см. в журнале регистрации!";
		
		Если ТипЗнч(РезультатВыполнения.Сообщения) = Тип("Массив") Тогда
			Для Каждого СообщениеВМассиве из РезультатВыполнения.Сообщения Цикл
				СообщениеВМассиве.Сообщить();
			КонецЦикла;
		КонецЕсли;
		
		ПоказатьПредупреждение(,ТекстПредупреждения,,"Ошибка заполнения бюджетов");
		
	КонецЕсли;
	
КонецПроцедуры
