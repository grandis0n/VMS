&НаСервере
Функция _ЭлементыГруппыПараметров(ГруппаПараметров)
	// --- 
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	CW_ПараметрыГрузоперевозок.Ссылка
	               |ИЗ
	               |	ПланВидовХарактеристик.CW_ПараметрыГрузоперевозок КАК CW_ПараметрыГрузоперевозок
	               |ГДЕ
	               |	CW_ПараметрыГрузоперевозок.Ссылка В ИЕРАРХИИ(&Ссылка)
	               |	И CW_ПараметрыГрузоперевозок.ЭтоГруппа = ЛОЖЬ
	               |	И CW_ПараметрыГрузоперевозок.ПометкаУдаления = ЛОЖЬ";
	Запрос.УстановитьПараметр("Ссылка", ГруппаПараметров);
	ТЗ = Запрос.Выполнить().Выгрузить();
	Возврат(ТЗ.ВыгрузитьКолонку("Ссылка"));
	
	// --- 
КонецФункции
 

&НаСервере
Функция _ИдентификаторСтрокиПараметра(Параметр)
	// --- 
	
	ЭлементКартыПараметров = КартаПараметровДерева.НайтиПоЗначению(Параметр);
	Если (ЭлементКартыПараметров = Неопределено) Тогда
		Сообщить("Для параметра """+Строка(Параметр)+""" в карте параметров не найден идентификатор строки.");
		Возврат(Неопределено);
	Иначе
		
		Возврат(Число(ЭлементКартыПараметров.Представление));
		
	КонецЕсли; 
	
	// --- 
КонецФункции
 

&НаКлиенте
Функция ДобавляемыйПараметрНовый(Параметр)
	// --- 
	
	Отбор = Новый Структура("Параметр",Параметр);
	СтрокиПараметра = Объект.ПараметрыГрузоперевозки.НайтиСтроки(Отбор);
	Возврат(СтрокиПараметра.Количество()=0);
	
	// --- 
КонецФункции
  
&НаСервере
Функция ТекущийРодитель()
	// --- 
	
	Если (Элементы.ДПГ.ТекущаяСтрока <> Неопределено) Тогда
		
		ИдентификаторТекущейСтроки = Элементы.ДПГ.ТекущаяСтрока;
		ТекущаяСтрока = ДПГ.НайтиПоИдентификатору(ИдентификаторТекущейСтроки);
		РодительТекущейСтроки = ТекущаяСтрока.ПолучитьРодителя();
		Если (РодительТекущейСтроки <> Неопределено) Тогда
			Возврат(РодительТекущейСтроки);
		КонецЕсли; 
		
	КонецЕсли; 
	
	Возврат(ДПГ);
	
	// --- 
КонецФункции

&НаСервере
Функция _ДобавитьПараметр(Параметр)
	// --- 
	//Новый механизм
	ИдентификаторГруппыВладельца = Неопределено;
	//Новый механизм
	
	// добавляем в ТЧ параметров
	СтрокаПараметра = Объект.ПараметрыГрузоперевозки.Добавить();
	СтрокаПараметра.Параметр = Параметр;
	СтрокаПараметра.Значение = Параметр.ТипЗначения.ПривестиЗначение(Неопределено); 
	// добавляем в дерево
	Если (Элементы.ДПГ.ТекущаяСтрока <> Неопределено) Тогда
		ИдентификаторТекущейСтроки = Элементы.ДПГ.ТекущаяСтрока;
		ТекущаяСтрока = ДПГ.НайтиПоИдентификатору(ИдентификаторТекущейСтроки);
		Если (ТекущаяСтрока.ЭтоГруппа) Тогда
			ТР = ТекущаяСтрока;
		Иначе
			ТР = ТекущийРодитель();	
		КонецЕсли; 
		//Новый механизм
		Если ТР <> ДПГ Тогда
			ИдентификаторГруппыВладельца = ТР.ИдентификаторГруппы;
		КонецЕсли;
		//Новый механизм
	Иначе
		ТР = ТекущийРодитель();
	КонецЕсли; 
	
	//Новый механизм
	Если ИдентификаторГруппыВладельца <>  Неопределено Тогда
		ОтборСтрок = Новый Структура("Идентификатор",ТР.ИдентификаторГруппы);
		мСтрокиГрупп = Объект.ГруппыПараметровГрузоперевозки.НайтиСтроки(ОтборСтрок);
		Если мСтрокиГрупп.Количество() > 0 Тогда
			СтрокаГруппы = мСтрокиГрупп[0];
			СтрокаПараметра.ИдентификаторВладельца = СтрокаГруппы.ИдентификаторГруппы; 	
		КонецЕсли;
	КонецЕсли; 
	//Новый механизм  
	
	//ХранениеПолногоЗначения
	ДобавитьСохраняемоеПолноеЗначение(СтрокаПараметра.Параметр);
	//---ХранениеПолногоЗначения
	
	// --- 
	СтрокаДерева = ТР.ПолучитьЭлементы().Добавить();
	// заполняем строку дерева
	_ЗаполнитьСтрокуДереваПоПараметру(СтрокаДерева,СтрокаПараметра);
	// записываем принадлежность параметра группе
	ГруппаСтроки = _ОпределитьСтрокуГруппуСтрокиДерева(СтрокаДерева);
	_ДобавитьЭлементГруппы(Параметр, ГруппаСтроки);
	СтрокаДерева.ИдентификаторГруппы = ГруппаСтроки.Идентификатор;
	
	// записываем в карту 
	Идентификатор = СтрокаДерева.ПолучитьИдентификатор();
	// --- 
	ЭлементКартыПараметров = КартаПараметровДерева.НайтиПоЗначению(Параметр);
	Если (ЭлементКартыПараметров = Неопределено) Тогда
		ЭлементКартыПараметров = КартаПараметровДерева.Добавить(Параметр);
	КонецЕсли; 
	ЭлементКартыПараметров.Представление = Формат(Идентификатор,"ЧЦ=10; ЧДЦ=; ЧН=0; ЧГ=");
	// --- 
	_ПроверитьГруппыПоИерархии(СтрокаДерева);	
	// --- 
	Возврат(Идентификатор);
	
	// --- 
КонецФункции

&НаСервере
Функция _ОпределитьСтрокуГруппуСтрокиДерева(СтрокаДерева)
	// --- 
	
	РодительСтроки = СтрокаДерева.ПолучитьРодителя();
	Если (РодительСтроки = Неопределено) Тогда
		СтрокаГруппы = Объект.ГруппыПараметровГрузоперевозки[0];
	Иначе
		Отбор = Новый Структура("Идентификатор", РодительСтроки.ИдентификаторГруппы);
		СтрокаГруппы = _сф.к_НайтиСтроку(Объект.ГруппыПараметровГрузоперевозки, Отбор);
	КонецЕсли; 
	
	Возврат(СтрокаГруппы);
	
	// --- 
КонецФункции

&НаСервере
Процедура _ДобавитьЭлементГруппы(Элемент, СтрокаГруппы, НовыйПредыдущий=Неопределено)
	// --- 
	
	МассивВедомых = ЗначениеИзСтрокиВнутр(СтрокаГруппы.ИдентификаторыВедомых);
	Если (НовыйПредыдущий =  Неопределено) Тогда
		МассивВедомых.Добавить(Элемент);
	Иначе
		
		ИндексПредыдущего = МассивВедомых.Найти(НовыйПредыдущий);
		Если (ИндексПредыдущего <> Неопределено) Тогда
			МассивВедомых.Вставить(ИндексПредыдущего,Элемент);
		Иначе
			МассивВедомых.Добавить(Элемент);
		КонецЕсли; 
		
	КонецЕсли; 
	СтрокаГруппы.ИдентификаторыВедомых = ЗначениеВСтрокуВнутр(МассивВедомых);
	Если (ТипЗнч(Элемент)=Тип("Число")) Тогда
		
		ДПГ_ТекущаяГруппа = Элемент;
		ДПГ_ТекущийПараметр = Неопределено;
		
	Иначе
		
		ДПГ_ТекущаяГруппа = СтрокаГруппы.Идентификатор;
		ДПГ_ТекущийПараметр = Элемент;
		
	КонецЕсли; 
	
	// --- 
КонецПроцедуры

&НаСервере
Процедура _ПереместитьЭлементГруппы(Элемент, СтрокаГруппы, НовыйПредыдущий);
	// --- 
	
	МассивВедомых = ЗначениеИзСтрокиВнутр(СтрокаГруппы.ИдентификаторыВедомых);
	// --- 
	Если (НовыйПредыдущий = Неопределено ) Тогда
		
		ИндексЭлемента = МассивВедомых.Найти(Элемент);
		МассивВедомых.Удалить(ИндексЭлемента);
		МассивВедомых.Добавить(Элемент);
		
	Иначе
		
		ИндесНовогоПредыдущего = МассивВедомых.Найти(НовыйПредыдущий);
		ИндексЭлемента = МассивВедомых.Найти(Элемент);
		МассивВедомых.Удалить(ИндексЭлемента);
		МассивВедомых.Вставить(ИндесНовогоПредыдущего,Элемент);
		
	КонецЕсли; 
	// --- 
	СтрокаГруппы.ИдентификаторыВедомых = ЗначениеВСтрокуВнутр(МассивВедомых);
	
	// --- 
КонецПроцедуры
 

&НаСервере
Процедура _УдалитьЭлементГруппы(Элемент, СтрокаГруппы)
	// --- 
	
	МассивВедомых = ЗначениеИзСтрокиВнутр(СтрокаГруппы.ИдентификаторыВедомых);
	МассивВедомых.Удалить(МассивВедомых.Найти(Элемент));
	СтрокаГруппы.ИдентификаторыВедомых = ЗначениеВСтрокуВнутр(МассивВедомых);
	
	// --- 
КонецПроцедуры
 
#КонецОбласти 

#Область РедактированиеЭлементов

&НаСервере
Функция _АдресОбъекта()  
	
	ТаблицаПараметров = Объект.ПараметрыГрузоперевозки.Выгрузить();
	ТаблицаПараметров.Колонки.Добавить("ХранилищеДанных"); 
	ТаблицаПараметров.Очистить(); 
	
	ТОбъект = РеквизитФормыВЗначение("Объект");
	Для Каждого СтрокаТаблицы из ТОбъект.ПараметрыГрузоперевозки Цикл
		НоваяСтрока = ТаблицаПараметров.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы); 
		
		НоваяСтрока.ХранилищеДанных = Новый ХранилищеЗначения(СтрокаТаблицы.ХранилищеДанных.Получить());
	КонецЦикла;
	
	СтруктураОбъекта = Новый Структура;
	СтруктураОбъекта.Вставить("Ссылка", 			Объект);
	СтруктураОбъекта.Вставить("ТаблицаПараметров", 	ТаблицаПараметров); 
	
	Возврат ПоместитьВоВременноеХранилище(СтруктураОбъекта,ЭтаФорма.УникальныйИдентификатор);
	
КонецФункции

&НаСервере
Функция _ТолькоПросмотрПараметра(Параметр)
	
	ТолькоПросмотрПараметра = Истина;
	
	НаборПрав = ПолучитьИзВременногоХранилища(АдресКартыПравПараметров);
	Попытка
		ТолькоПросмотрПараметра = (НЕ НаборПрав["п_"+_сф.КлючПоСсылке(Параметр)].Редактирование);
	Исключение
		ТолькоПросмотрПараметра = Истина;
	КонецПопытки; 
	
	Если НЕ ТолькоПросмотрПараметра Тогда
		// проверим, что параметр не указан в связанном объекте оборудования
		Если ПолучитьФункциональнуюОпцию("CW_ИспользованиеМониторингаОборудования") Тогда
			Если ЗначениеЗаполнено(Объект.ОтслеживаемоеОборудование) Тогда
				СтрокаПараметра = CW_Мониторинг.СтрокаПараметра(Объект.ОтслеживаемоеОборудование,Параметр);
				Если СтрокаПараметра <> Неопределено Тогда
					ТолькоПросмотрПараметра = Истина;
				КонецЕсли; 
			КонецЕсли; 
		КонецЕсли; 
	КонецЕсли; 
	
	Возврат ТолькоПросмотрПараметра;
	
КонецФункции

&НаКлиенте
Процедура ОбработатьИзменениеПараметра(Ответ,ДополнительныеПараметры) Экспорт 
	
	Если (Ответ <> Неопределено) Тогда
		
		Если ТипЗнч(Ответ) <> Тип("Структура") И ТипЗнч(Ответ) <> Тип("Массив") Тогда
			//В случае если ответ форме не имеет тип структура, поместим его в структуру для последующей обработки
			Ответ = _ПО.ПолучитьСтруктуруОтветаВнешнейФормы(Ответ, ДополнительныеПараметры.Параметр);
		КонецЕсли;
		
		Если ТипЗнч(Ответ) <> Тип("Массив") Тогда
			МассивПараметров = Новый Массив;
			МассивПараметров.Добавить(Ответ);
		Иначе
			МассивПараметров = Ответ;
		КонецЕсли;
		
		Для каждого ОтветСтруктура из МассивПараметров Цикл
			Если (ОтветСтруктура.ПараметрИзменен) Тогда
				
				Если (ДополнительныеПараметры.СвойстваПараметра = Неопределено) Тогда
					СписокВедомых = Неопределено;
				Иначе	
					СписокВедомых = ДополнительныеПараметры.СвойстваПараметра.СписокВедомых;
				КонецЕсли; 
				// --- 
				Ответ = _ОбновитьПараметр(ОтветСтруктура, СписокВедомых);	
				Если (_УФКС.ВыполненоУспешно(Ответ)) Тогда
					
					Модифицированность = Истина;
					ТребуетсяПолноеОбновление = Ложь;
					Ответ.Свойство("ПолноеОбновление",ТребуетсяПолноеОбновление);
					Если (ТребуетсяПолноеОбновление) Тогда
						
						ОбновитьДеревоПараметров();
						
					КонецЕсли; 
					
				КонецЕсли; 
				
			КонецЕсли; 
		КонецЦикла;	
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция _ОбновитьПараметр(СтруктураПараметра, СписокВедомых)
	// --- 
	
	Параметр = СтруктураПараметра.Параметр;
	// --- 
	КартаСвойств = ПолучитьИзВременногоХранилища(АдресКартыСвойствПараметров);
	СП = КартаСвойств.Получить(Параметр);
	КартаПрав = ПолучитьИзВременногоХранилища(АдресКартыПравПараметров);
	НП = КартаПрав["п_"+_сф.КлючПоСсылке(Параметр)];
	// --- 
	ЭлементКартыПараметров = КартаПараметровДерева.НайтиПоЗначению(Параметр);
	Если (ЭлементКартыПараметров = Неопределено) Тогда
		
		Сообщить("Для параметра """+Строка(Параметр)+""" в карте параметров не найден идентификатор строки.");
		ИдентификаторСтрокиДерева = Неопределено;
		
	Иначе
		
		ИдентификаторСтрокиДерева = Число(ЭлементКартыПараметров.Представление);
		
	КонецЕсли; 
	Если (ИдентификаторСтрокиДерева = Неопределено) Тогда
		
		// добавляем...
		Если (Элементы.ДПГ.ТекущаяСтрока <> Неопределено) Тогда
			ИдентификаторТекущейСтроки = Элементы.ДПГ.ТекущаяСтрока;
			ТекущаяСтрока = ДПГ.НайтиПоИдентификатору(ИдентификаторТекущейСтроки);
			Если (ТекущаяСтрока.ЭтоГруппа) Тогда
				ТР = ТекущаяСтрока;
			Иначе
				ТР = ТекущийРодитель();	
			КонецЕсли; 
		Иначе
			ТР = ТекущийРодитель();
		КонецЕсли; 
		// --- 
		СтрокаДерева = ТР.ПолучитьЭлементы().Добавить();
		
	Иначе
		
		СтрокаДерева = ДПГ.НайтиПоИдентификатору(ИдентификаторСтрокиДерева);	
		
	КонецЕсли; 
	// --- 
	СтрокаПараметра = _сф.к_НайтиСтроку(Объект.ПараметрыГрузоперевозки,Новый Структура("Параметр",Параметр));
	Если (СтруктураПараметра.Значение <> Неопределено) Тогда
		СтрокаПараметра.Значение = СтруктураПараметра.Значение;
	КонецЕсли; 
	Если (СтрокаПараметра.ЗначениеПлан <> Неопределено) Тогда
		СтрокаПараметра.ЗначениеПлан = СтруктураПараметра.ЗначениеПлан;
	КонецЕсли;
	Если (СтрокаПараметра.ЗначениеФакт <> Неопределено) Тогда
		СтрокаПараметра.ЗначениеФакт = СтруктураПараметра.ЗначениеФакт;
	КонецЕсли;
	Если (СтрокаПараметра.Примечание <> Неопределено) Тогда
		СтрокаПараметра.Примечание = СтруктураПараметра.Примечание;
	КонецЕсли;
	// --- 
	Если (СП.ЭтоКонтрольнаяДата) Тогда
		Если (ЗначениеЗаполнено(СтрокаПараметра.ЗначениеФакт)) Тогда
			СтрокаПараметра.Значение = СтрокаПараметра.ЗначениеФакт;
		Иначе
			СтрокаПараметра.Значение = СтрокаПараметра.ЗначениеПлан;
		КонецЕсли; 
	КонецЕсли;  

	//ХранениеПолногоЗначения     
	Если CW_МониторинговыеПараметрыСервер.ИспользуетсяСохранениеПолногоЗначения(Параметр) Тогда 
		ДобавитьСохраняемоеПолноеЗначение(Параметр, СтруктураПараметра.ПолноеЗначение);             
	КонецЕсли;
	//---ХранениеПолногоЗначения
	
	// --- 
	_ЗаполнитьСтрокуДереваПоПараметру(СтрокаДерева, СтрокаПараметра, СП, НП);
	// --- 
	Если (СписокВедомых <> Неопределено) Тогда
		Если (СписокВедомых.Количество() <> 0) Тогда
			
			Для каждого ЭлементСписка Из СписокВедомых Цикл
				
				ВедомыйПараметр = ЭлементСписка.Значение;
				// ---------------------------------------------------------------------------- 
				ВедомыйЭлементКартыПараметров = КартаПараметровДерева.НайтиПоЗначению(ВедомыйПараметр);
				Если (ВедомыйЭлементКартыПараметров <> Неопределено) Тогда
					
					СвойстваВедомогоПараметра = CW_Мониторинг.СтруктураСвойствПараметра(ВедомыйПараметр);
					
					СтруктураВедомогоПараметра = CW_МониторинговыеПараметрыСервер.ПолучитьПустуюСтруктуруРедактированияПараметров();
					СтруктураВедомогоПараметра.Параметр 		= ВедомыйПараметр;
					СтруктураВедомогоПараметра.ПараметрИзменен 	= Истина;    
					СтруктураВедомогоПараметра.Значение 		= Новый(ВедомыйПараметр.ТипЗначения.Типы()[0]);    
					                                        	
					_ОбновитьПараметр(СтруктураВедомогоПараметра, СвойстваВедомогоПараметра.СписокВедомых);
					
				КонецЕсли;
				
			КонецЦикла; 
			
		КонецЕсли; 
	КонецЕсли; 
	// --- 
	// проверяем, не подключены ли к параметру обработчики изменения
	ТребуетсяПолноеОбновление = Ложь;
	Если (СП.ОбработкаИзменения) Тогда
		
		Если (ЗначениеЗаполнено(Параметр.ВнешняяОбработкаИзменения)) Тогда
			
			ОбработкаОбъект = _ПО.ПолучитьОбработку(Параметр.ВнешняяОбработкаИзменения);  
			
			Попытка
				ПараметрыПроцедуры = новый Структура;
				ПараметрыПроцедуры.Вставить("ВнешняяОбработка",	Параметр.ВнешняяОбработкаИзменения);
				ПараметрыПроцедуры.Вставить("Объект", 			Объект);
				ПараметрыПроцедуры.Вставить("Форма", 			ЭтаФорма);
				ПараметрыПроцедуры.Вставить("СтрокаПараметра", 	СтрокаПараметра);
				
				Результат = ОбработкаОбъект.ВыполнитьОбработкуИзмененияПараметра(ПараметрыПроцедуры); 
			Исключение
				//Поддержка старых версий обработок
				Результат = ОбработкаОбъект.ОбработкаИзмененияПараметра(Объект,ЭтаФорма,СтрокаПараметра);
			КонецПопытки;
			
			ОбработкаОбъект = Неопределено;
			// --- 
			Если (_УФКС.ВыполненоУспешно(Результат)) Тогда
				
				// параметры
				ТаблицаПараметров = Неопределено;
				Результат.Свойство("ТаблицаПараметров",ТаблицаПараметров);
				Если (ТаблицаПараметров <> Неопределено) Тогда
					
					Для каждого Стр Из ТаблицаПараметров Цикл
						
						Отбор = Новый Структура("Параметр", Стр.Параметр);
						ЗаполняемаяСтрокаПараметра = _сф.к_НайтиСтроку(Объект.ПараметрыГрузоперевозки,Отбор);
						Если (ЗаполняемаяСтрокаПараметра = Неопределено) Тогда
							ЗаполняемаяСтрокаПараметра = Объект.ПараметрыГрузоперевозки.Добавить(); 
							
							//ХранениеПолногоЗначения
							ДобавитьСохраняемоеПолноеЗначение(Стр.Параметр, Стр.Значение);
							//---ХранениеПолногоЗначения
							
							ТребуетсяПолноеОбновление = Истина;
						КонецЕсли; 
						ЗаполнитьЗначенияСвойств(ЗаполняемаяСтрокаПараметра, Стр);
						Если (НЕ ТребуетсяПолноеОбновление) Тогда
							
							// находим строку дерева этого параметра и обновляем её
							ЭлементКартыПараметров = КартаПараметровДерева.НайтиПоЗначению(Стр.Параметр);
							Если (ЭлементКартыПараметров = Неопределено) Тогда
								
								Сообщить("Для параметра """+Строка(Стр.Параметр)+""" в карте параметров не найден идентификатор строки.");
								ИдентификаторСтрокиДерева = Неопределено;
								
							Иначе
								
								ИдентификаторСтрокиДерева = Число(ЭлементКартыПараметров.Представление);
								
							КонецЕсли; 
							// --- 
							Если (ИдентификаторСтрокиДерева <> Неопределено) Тогда
								
								СтрокаДерева = ДПГ.НайтиПоИдентификатору(ИдентификаторСтрокиДерева);
								Если (СтрокаДерева <> Неопределено) Тогда
									СП = КартаСвойств.Получить(Стр.Параметр);
									НП = КартаПрав["п_"+_сф.КлючПоСсылке(Стр.Параметр)];
									_ЗаполнитьСтрокуДереваПоПараметру(СтрокаДерева, ЗаполняемаяСтрокаПараметра, СП, НП);	
								КонецЕсли; 
								
							КонецЕсли; 
							
						КонецЕсли; 
						
					КонецЦикла; 
					
				КонецЕсли;
				
				// реквизиты
				СтруктураРеквизитов = Неопределено;
				Результат.Свойство("СтруктураРеквизитов",СтруктураРеквизитов);
				Если (СтруктураРеквизитов <> Неопределено) Тогда
					
					ЗаполнитьЗначенияСвойств(Объект, СтруктураРеквизитов);
					
				КонецЕсли; 
				
			Иначе
				
				Сообщить(_УФКС.ПредставлениеОшибки(Результат));
				
			КонецЕсли; 
			
			// --- 
			
		КонецЕсли; 
		
		// пересчитываем все дин. параметры
		ПересчитатьДинамическиеПараметры();	
		
	Иначе
		
		// просто пересчитываем параметры по текущему
		ПересчитатьДинамическиеПараметры(Параметр);	
		
	КонецЕсли; 
	
	Ответ = _УФКС.Ответ();
	Ответ.Вставить("ПолноеОбновление",ТребуетсяПолноеОбновление);
	Возврат(Ответ);
	
	// --- 
КонецФункции

&НаСервере
Функция ПересчитатьДинамическиеПараметры(ИзменившийсяПараметр=Неопределено)
	// --- 
	
	// пересчитываем и показываем
	КартаСвойствПараметров = ПолучитьИзВременногоХранилища(АдресКартыСвойствПараметров);
	ТаблицаДП = CW_Мониторинг.ДинамическиеПараметрыОбъекта(Объект,КартаСвойствПараметров,,Объект.ПараметрыГрузоперевозки.Выгрузить());
	Если (ТаблицаДП.Количество() <> 0) Тогда
		КартаПрав = ПолучитьИзВременногоХранилища(АдресКартыПравПараметров);
	КонецЕсли; 
	Для каждого Стр Из ТаблицаДП Цикл
		
		// в ТЧ
		Отбор = Новый Структура("Параметр",Стр.Параметр);
		СтрокаПараметра = _сф.к_НайтиСтроку(Объект.ПараметрыГрузоперевозки,Отбор);
		Если (СтрокаПараметра <> Неопределено) Тогда
			
			СтрокаПараметра.Значение = Стр.Значение;
			// --- 
			ЭлементКартыПараметров = КартаПараметровДерева.НайтиПоЗначению(Стр.Параметр);
			Если (ЭлементКартыПараметров = Неопределено) Тогда
				
				Сообщить("Для параметра """+Строка(Стр.Параметр)+""" в карте параметров не найден идентификатор строки.");
				ИдентификаторСтрокиДерева = Неопределено;
				
			Иначе
				
				ИдентификаторСтрокиДерева = Число(ЭлементКартыПараметров.Представление);
				
			КонецЕсли;
			// --- 
			Если (ИдентификаторСтрокиДерева <> Неопределено) Тогда
				СтрокаДерева = ДПГ.НайтиПоИдентификатору(ИдентификаторСтрокиДерева);
				СП = КартаСвойствПараметров.Получить(Стр.Параметр);
				НП = КартаПрав["п_"+_сф.КлючПоСсылке(Стр.Параметр)];
				_ЗаполнитьСтрокуДереваПоПараметру(СтрокаДерева, СтрокаПараметра, СП, НП);
			КонецЕсли; 
			
		КонецЕсли; 
		
	КонецЦикла; 
	
	// --- 
КонецФункции

#КонецОбласти 

#Область ДобавлениеГруппЭлементов

&НаКлиенте
Процедура ДобавитьГруппу(Команда)
	
	// спрашиваем название группы
	ПараметрыФормы 	= Новый Структура("НоваяГруппа,РежимГрузоперевозки,ДоступнаСменаРежимаСвертки", Истина,Истина,Истина);
	ПОВ 			= Новый ОписаниеОповещения("ОбработатьВводНаименованияГруппы",ЭтотОбъект, Новый Структура()); 
	ОткрытьФорму("ПланВидовХарактеристик.CW_ПараметрыГрузоперевозок.Форма.ФормаВиртуальнойГруппы",ПараметрыФормы,ЭтаФорма,,,,ПОВ,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьВводНаименованияГруппы(Ответ, ДополнительныеПараметры) Экспорт 
	// --- 
	
	Если (Ответ <> Неопределено) Тогда
		
		Модифицированность 		= истина;
		РедактированиеГруппы 	= Ложь;
		
		ДополнительныеПараметры.Свойство("Редактирование",РедактированиеГруппы);
		Если (РедактированиеГруппы = Неопределено ) Тогда
			РедактированиеГруппы = Ложь;
		КонецЕсли;
		
		Если (РедактированиеГруппы) Тогда
			ИдентификаторСтроки = _ОбновитьГруппу(Элементы.ДПГ.ТекущаяСтрока,Ответ);
		Иначе
			ИдентификаторСтроки = _ДобавитьГруппу(Ответ);	
		КонецЕсли; 
		
		//Обнолвение пометок вышестоящий групп
		ОбновитьРаскрытиеВышеСтоящихГрупп(ИдентификаторСтроки, Ответ.ГруппаРазвернута);
	
		ИдентификаторГруппы = ДПГ.НайтипоИдентификатору(ИдентификаторСтроки).ИдентификаторГруппы;
		УстановитьСостояниеСверткиСтроки(ИдентификаторСтроки, ИдентификаторГруппы, Ответ.ГруппаРазвернута);
		//ВосстановитьСостояниеСверткиСтроки(ИдентификаторСтроки);

	КонецЕсли; 
	
	// --- 
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьРаскрытиеВышеСтоящихГрупп(ИдентификаторСтроки,ГруппаРазвернута)
	
	Если Не ГруппаРазвернута Тогда
		//ничего делать не нужно, свертка вышестоящией группы от этого не зависит;
		Возврат;
	КонецЕсли;
	
	СтрокаДерева = ДПГ.НайтипоИдентификатору(ИдентификаторСтроки);

	ОбработатьСверткуРодителяРекурсивно(СтрокаДерева,ГруппаРазвернута);
	
КонецПроцедуры

&наКлиенте
Процедура ОбработатьСверткуРодителяРекурсивно(СтрокаДерева, ГруппаРазвернута)
	
	РодительГруппы = СтрокаДерева.ПолучитьРодителя();
	
	Если РодительГруппы <> Неопределено Тогда
		
		СтруктураПараметров = новый Структура("НаименованиеГруппы,ГруппаРазвернута",РодительГруппы.НаименованиеГруппы,ГруппаРазвернута);
		_ОбновитьГруппу(РодительГруппы.ПолучитьИдентификатор(),СтруктураПараметров);
		
		УстановитьСостояниеСверткиСтроки(РодительГруппы.ПолучитьИдентификатор(), РодительГруппы.ИдентификаторГруппы, ГруппаРазвернута);

		ОбработатьСверткуРодителяРекурсивно(РодительГруппы, ГруппаРазвернута)
	КонецЕсли;
	
КонецПроцедуры


&НаСервере
Функция _ОбновитьГруппу(ИдентификаторСтрокиДерева,СтруктураПараметров)
	// --- 
	
	СтрокаДерева = ДПГ.НайтиПоИдентификатору(ИдентификаторСтрокиДерева);
	СтрокаГруппы = _сф.к_НайтиСтроку(Объект.ГруппыПараметровГрузоперевозки,Новый Структура("Идентификатор",СтрокаДерева.ИдентификаторГруппы));
	// --- 
	СтрокаГруппы.Наименование 			= СтруктураПараметров.НаименованиеГруппы;
	СтрокаГруппы.Раскрывать 			= СтруктураПараметров.ГруппаРазвернута;
	// --- 
	_ЗаполнитьСтрокуДереваПоГруппе(СтрокаДерева, СтрокаГруппы);
	// --- 
	_ПроверитьГруппыПоИерархии(СтрокаДерева);
	
	Возврат(ИдентификаторСтрокиДерева);
	
	// --- 
КонецФункции
 

&НаСервере
Функция _ДобавитьГруппу(СтруктураПараметров)
	// --- 
	//Новый механизм
	ИдентификаторГруппыВладельца = Неопределено;
	//Новый механизм
	
	// создаем строку ТЧ
	СтрокаГруппы = Объект.ГруппыПараметровГрузоперевозки.Добавить();
	СтрокаГруппы.Идентификатор = _ИдентификаторНовойГруппы();
	
	СтрокаГруппы.Наименование 			= СтруктураПараметров.НаименованиеГруппы;
	СтрокаГруппы.Раскрывать 			= СтруктураПараметров.ГруппаРазвернута;
	
	
	СтрокаГруппы.ИдентификаторыВедомых = ЗначениеВСтрокуВнутр(Новый Массив);
	// --- 
	// создаем строку дерева
	Если (Элементы.ДПГ.ТекущаяСтрока <> Неопределено) Тогда
		ИдентификаторТекущейСтроки = Элементы.ДПГ.ТекущаяСтрока;
		ТекущаяСтрока = ДПГ.НайтиПоИдентификатору(ИдентификаторТекущейСтроки);
		Если (ТекущаяСтрока.ЭтоГруппа) Тогда
			ТР = ТекущаяСтрока;
		Иначе
			ТР = ТекущийРодитель();	
		КонецЕсли; 
		//Новый механизм
		Если ТР <> ДПГ Тогда
			ИдентификаторГруппыВладельца = ТР.ИдентификаторГруппы;
		КонецЕсли;
		//Новый механизм
	Иначе
		ТР = ТекущийРодитель();
	КонецЕсли; 
	
	//Новый механизм
	СтрокаГруппы.ИдентификаторГруппы = Новый УникальныйИдентификатор;
	Если ИдентификаторГруппыВладельца <>  Неопределено Тогда
		ОтборСтрок = Новый Структура("Идентификатор",ИдентификаторГруппыВладельца);
		мСтрокиГрупп = Объект.ГруппыПараметровГрузоперевозки.НайтиСтроки(ОтборСтрок);
		Если мСтрокиГрупп.Количество() > 0 Тогда
			СтрокаГруппыВладельца = мСтрокиГрупп[0];
			СтрокаГруппы.ИдентификаторВладельца = СтрокаГруппыВладельца.ИдентификаторГруппы; 	
		КонецЕсли;
	КонецЕсли;
	//Новый механизм

	// --- 
	СтрокаДерева = ТР.ПолучитьЭлементы().Добавить();
	// заполняем
	_ЗаполнитьСтрокуДереваПоГруппе(СтрокаДерева, СтрокаГруппы);
	// добавляем в массив элементов родителя
	_ДобавитьЭлементГруппы(СтрокаГруппы.Идентификатор, _ОпределитьСтрокуГруппуСтрокиДерева(СтрокаДерева));
	// --- 
	_ПроверитьГруппыПоИерархии(СтрокаДерева);
	// --- 
	Возврат(СтрокаДерева.ПолучитьИдентификатор());
	
	// --- 
КонецФункции

&НаСервере
Функция _ИдентификаторНовойГруппы()
	// --- 
	
	ТЗИ = Объект.ГруппыПараметровГрузоперевозки.Выгрузить(,"Идентификатор");
	ТЗИ.Сортировать("Идентификатор Возр");
	ПоследнийИдентификатор = _сф.к_ПоследнийЭлемент(ТЗИ).Идентификатор;
	НовыйИдентификатор = ПоследнийИдентификатор+1;
	Возврат(НовыйИдентификатор);
	
	// --- 
КонецФункции
 

#КонецОбласти 

#Область ПодборПараметров

&НаКлиенте
Процедура ПодборПараметров(Команда)
	
	ПараметрыФормыПодбора = Новый Структура;
	ПараметрыФормыПодбора.Вставить("МножественныйВыбор"	, Истина);
	ПараметрыФормыПодбора.Вставить("РежимВыбора"		, Истина);
	ПараметрыФормыПодбора.Вставить("ЗакрыватьПриВыборе"	, Истина);
	
	ОписаниеОповещения 		= Новый ОписаниеОповещения("ПослеЗакрытияФормыПодбораПараметра", ЭтаФорма);
	
	ОткрытьФорму("ОбщаяФорма.CW_ПодборПараметровГрузоперевозок",ПараметрыФормыПодбора, ЭтаФорма,,,,ОписаниеОповещения,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияФормыПодбораПараметра(ВыбранныеЗначения, ДополнительныеПараметры) Экспорт
	
	ОбработкаВыбораПараметра(ВыбранныеЗначения, Неопределено);

КонецПроцедуры


&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "ПараметрИзменен" Тогда 
		_ОбновитьСвойстваПараметров();
		
	ИначеЕсли ИмяСобытия = "Запись_НаборКонстант" Тогда
		
		//Подистема.СобственныйТранспорт
		ВыполнитьДействие(_УФКС.СД("Грузоперевозки","клиент","/ФинансыТранспортОбновить",Неопределено));
		//Подистема.СобственныйТранспорт
		
	ИначеЕсли ИмяСобытия = "ОбновитьДеревоПараметровГрузоперевозки" Тогда 
		Если ТипЗнч(Параметр) = Тип("Массив") И НЕ Параметр.Найти(Объект.Ссылка) = Неопределено 
			ИЛИ	 ТипЗнч(Параметр) = Тип("СправочникСсылка.CW_Грузоперевозки") И Параметр = Объект.Ссылка Тогда
			ЭтаФорма.Прочитать();
			ОбновитьДеревоПараметров();
		КонецЕсли
		
	ИначеЕсли ИмяСобытия = "ОбновитьДеревоПараметровГрузоперевозкиПоЗаказу" Тогда 
		Если ТипЗнч(Параметр) = Тип("Массив") И 
			НЕ Параметр.Найти(Объект.Заказ) = Неопределено	
			ИЛИ Параметр = Объект.Заказ Тогда
			
			ЭтаФорма.Прочитать();
			ОбновитьДеревоПараметров();
			
		КонецЕсли
		
	ИначеЕсли ИмяСобытия = "ВыполнитьМетодВладельца" Тогда
		
		Если ТипЗнч(Параметр) = тип("Структура") Тогда
			УникальныйИдентификаторВладельца 	= Неопределено;
			МетодыФормыВладельца 				= Неопределено;
			
			Параметр.Свойство("УникальныйИдентификатор"	, УникальныйИдентификаторВладельца);
			Параметр.Свойство("МетодыФормыВладельца"	, МетодыФормыВладельца);
			
			Если ЭтаФорма.УникальныйИдентификатор = УникальныйИдентификаторВладельца Тогда
				Если Не МетодыФормыВладельца = Неопределено и ТипЗнч(МетодыФормыВладельца) = Тип("Массив") Тогда
					
					Для Каждого СтрокаМассива из МетодыФормыВладельца Цикл
						Попытка
							Выполнить(СтрокаМассива);
						Исключение
						КонецПопытки;
					КонецЦикла;
					
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;	
		
	ИначеЕсли  ИмяСобытия = "ОбновитьБюджеты" Тогда
		
		Если ТипЗнч(Параметр) = Тип("СправочникСсылка.CW_Грузоперевозки") И Параметр = Объект.Ссылка Тогда
			
			ВыполнитьДействие(_УФКС.СД("Грузоперевозки","клиент","/БюджетРасходыОбновить", Неопределено));
			ВыполнитьДействие(_УФКС.СД("Грузоперевозки","клиент","/БюджетДоходыОбновить" , Неопределено));
			
			//Сортировка бюджетов
			ВосстановитьСортировкуТаблицы("БюджетРасходы");
			ВосстановитьСортировкуТаблицы("БюджетДоходы");
			//Сортировка бюджетов
			
		КонецЕсли
		
		//Наличие прикрепленных файлов
	ИначеЕсли ИмяСобытия = "ОбновитьНаличиеПрикрепленныхФайлов" Тогда
		
		ОбработатьОповещениеОбновитьНаличиеПрикрепленныхФайлов();
		//Наличие прикрепленных файлов
		
	ИначеЕсли ИмяСобытия = "ФинансыДоходыОбновить" Тогда
		
		ВыполнитьДействие(_УФКС.СД("Грузоперевозки","клиент","/ФинансыДоходыОбновить",Неопределено));
		
		
	ИначеЕсли ИмяСОбытия = "ЗаписьОтчетаЭкспедитора" Тогда
		
		УстановитьИтогиДинамическогоСписка();  
		
	КонецЕсли; 
	
КонецПроцедуры     

#КонецОбласти 

#Область УдалениеЭлементов 

&НаКлиенте
Процедура ДПГПередУдалением(Элемент, Отказ)
	
	Отказ = Истина;
	
	Если ЗначениеЗаполнено(ДатаБлокировкиМониторинга) тогда
		Возврат;
	КонецЕсли;
	
	// --- 
	Идентификатор = Элементы.ДПГ.ТекущаяСтрока;
	СтрокаДерева = ДПГ.НайтиПоИдентификатору(Идентификатор);
	
	Если СтрокаДерева.ПараметрЗаказа Тогда
		Возврат;
	КонецЕсли;
	
	// --- 
	Если (СтрокаДерева.УдалениеРазрешено) Тогда

		Если (СтрокаДерева.ЭтоГруппа) Тогда
			
			Если (СтрокаДерева.ПолучитьЭлементы().Количество() <> 0) Тогда
				
				ПОВ = Новый ОписаниеОповещения("ОбработкаПодтвержденияУдаленияГруппы",ЭтотОбъект, Новый Структура()); 
				ПоказатьВопрос(ПОВ,"Группа будет удалена вместе с параметрами. Продолжить?", РежимДиалогаВопрос.ДаНет);
				
			Иначе
				
				УдалитьСтрокуДерева(Идентификатор);
				
			КонецЕсли; 
			
		Иначе
			
			УдалитьСтрокуДерева(Идентификатор);
			ЭтаФорма.Модифицированность=Истина;
			
		КонецЕсли; 
		
	Иначе
		
		Если (СтрокаДерева.ПредопределенныйПараметр) Тогда
			
			Если (СтрокаДерева.ЭтоГруппа) Тогда
				
				_УФК.ВывестиПредупреждение("Группа содержит предопределённые параметры.");
				Возврат;
				
			Иначе
				
				_УФК.ВывестиПредупреждение("Нельзя удалить предопределённые параметр.");
				Возврат;
				
			КонецЕсли;
			
		Иначе
			
			_УФК.ВывестиПредупреждение("Недостаточно прав для данного действия.");
			Возврат;
			
		КонецЕсли; 
		
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаПодтвержденияУдаленияГруппы(Ответ, ДополнительныеПараметры) Экспорт 
	// --- 
	
	Если (Ответ <> Неопределено) Тогда
		
		Если (Ответ = КодВозвратаДиалога.Да) Тогда
			
			УдалитьСтрокуДерева(Элементы.ДПГ.ТекущаяСтрока);
			
		КонецЕсли; 
		
	КонецЕсли; 
	
	// --- 
КонецПроцедуры
  
&НаКлиенте
Процедура УдалитьСтрокуДерева(Идентификатор)
	// --- 
	Модифицированность = Истина;
	
	НоваяТекущаяСтрока = Неопределено;
	// --- 
	СтрокаДерева = ДПГ.НайтиПоИдентификатору(Идентификатор);
	РодительСтрокиДерева = СтрокаДерева.ПолучитьРодителя();
	Если (РодительСтрокиДерева = Неопределено) Тогда
		КоллекцияСтрок = ДПГ.ПолучитьЭлементы();
	Иначе
		КоллекцияСтрок = РодительСтрокиДерева.ПолучитьЭлементы();
	КонецЕсли; 
	КоличествоЭлементовКоллекции = КоллекцияСтрок.Количество();
	Если (КоличествоЭлементовКоллекции > 1) Тогда
		
		// получаем индекс
		ИндексУдаляемойСтроки = КоллекцияСтрок.Индекс(СтрокаДерева);
		Если (ИндексУдаляемойСтроки <> КоличествоЭлементовКоллекции-1) Тогда
			НоваяТекущаяСтрока = КоллекцияСтрок[ИндексУдаляемойСтроки+1].ПолучитьИдентификатор();
		Иначе 
			НоваяТекущаяСтрока = КоллекцияСтрок[ИндексУдаляемойСтроки-1].ПолучитьИдентификатор();
		КонецЕсли; 
		
	Иначе
		
		Если (РодительСтрокиДерева <> Неопределено) Тогда
			
			НоваяТекущаяСтрока = РодительСтрокиДерева.ПолучитьИдентификатор();
			
		КонецЕсли; 
		
	КонецЕсли; 
	
	// удаляем рекурсивно группы/параметры
	Результат = _УдалитьПараметрыРекурсивно(Идентификатор);
	Если (_УФКС.ВыполненоУспешно(Результат)) Тогда
		
		// удаляем строку дерева
		_УдалитьСтрокуДерева(Идентификатор);
		
		Если (НоваяТекущаяСтрока <> Неопределено ) Тогда
			
			Элементы.ДПГ.ТекущаяСтрока = НоваяТекущаяСтрока;
			
		КонецЕсли; 
		
	КонецЕсли; 
	
	// --- 
КонецПроцедуры

&НаСервере
Функция _УдалитьПараметрыРекурсивно(ИдентификаторСтроки)
	// --- 
	
	СтрокаДерева = ДПГ.НайтиПоИдентификатору(ИдентификаторСтроки);
	Если (СтрокаДерева.ЭтоГруппа) Тогда
		ЭлементДПГ = СтрокаДерева.ИдентификаторГруппы;
	Иначе
		ЭлементДПГ = СтрокаДерева.Параметр;
	КонецЕсли; 
	
	// удаляем из родителя
	РодительСтрокиДерева = СтрокаДерева.ПолучитьРодителя();
	Если (РодительСтрокиДерева = Неопределено) Тогда
		СтрокаГруппы = Объект.ГруппыПараметровГрузоперевозки[0];
	Иначе
		СтрокаГруппы = _сф.к_НайтиСтроку(Объект.ГруппыПараметровГрузоперевозки,Новый Структура("Идентификатор", РодительСтрокиДерева.ИдентификаторГруппы));
	КонецЕсли; 
	_УдалитьЭлементГруппы(ЭлементДПГ, СтрокаГруппы);
	
	// физически удаляем
	_УдалитьЭлементДПГ(ЭлементДПГ);
	// --- 
	Возврат(_УФКС.Ответ());
	
	// --- 
КонецФункции

&НаСервере
Процедура _УдалитьЭлементДПГ(ЭлементДПГ)
	// --- 
	
	Если (ТипЗнч(ЭлементДПГ)=Тип("Число")) Тогда
		
		СтрокаГруппы = _сф.к_НайтиСтроку(Объект.ГруппыПараметровГрузоперевозки,Новый Структура("Идентификатор", ЭлементДПГ));
		МассивВедомых = ЗначениеИзСтрокиВнутр(СтрокаГруппы.ИдентификаторыВедомых);
		Для каждого Ведомый Из МассивВедомых Цикл
			
			_УдалитьЭлементДПГ(Ведомый);
			
		КонецЦикла; 
		// --- 
		Объект.ГруппыПараметровГрузоперевозки.Удалить(Объект.ГруппыПараметровГрузоперевозки.Индекс(СтрокаГруппы));
		
	Иначе
		
		СтрокаПараметра = _сф.к_НайтиСтроку(Объект.ПараметрыГрузоперевозки,Новый Структура("Параметр",ЭлементДПГ));
		Объект.ПараметрыГрузоперевозки.Удалить(Объект.ПараметрыГрузоперевозки.Индекс(СтрокаПараметра));
		
		//ХранениеПолногоЗначения
		Если ЭлементДПГ.СохранятьПолноеЗначениеПараметра Тогда
			Соответствие = Новый Соответствие(СохраняемоеПолноеЗначение);
			Соответствие.Удалить(ЭлементДПГ); 
			СохраняемоеПолноеЗначение = Новый ФиксированноеСоответствие(Соответствие);
		КонецЕсли;
		//---ХранениеПолногоЗначения
		
	КонецЕсли; 
	
	// --- 
КонецПроцедуры
 

#КонецОбласти 

#Область ПеремещениеЭлементов

&НаКлиенте
Процедура ПереместитьВверх(Команда)
	
	СдвинутьСтроку(-1);
	
КонецПроцедуры

&НаКлиенте
Процедура ПереместитьВниз(Команда)
	
	СдвинутьСтроку(1);
	
КонецПроцедуры

&НаКлиенте
Процедура СдвинутьСтроку(Направление)
	// --- 
	
	ТекущаяСтрока = Элементы.ДПГ.ТекущаяСтрока;
	СтрокаДерева = ДПГ.НайтиПоИдентификатору(ТекущаяСтрока);
	РодительТекущейСтроки = СтрокаДерева.ПолучитьРодителя();
	Если (РодительТекущейСтроки = Неопределено) Тогда
		РодительТекущейСтроки = ДПГ;
		ГруппаРодитель = 0;
	Иначе
		ГруппаРодитель = РодительТекущейСтроки.ИдентификаторГруппы;	
	КонецЕсли; 
	// --- 
	КоллекцияСтрок = РодительТекущейСтроки.ПолучитьЭлементы();
	КоличествоСтрок = КоллекцияСтрок.Количество();
	Если (КоличествоСтрок = 1) Тогда
		Возврат;
	КонецЕсли; 
	ИндексТекущейСтроки = КоллекцияСтрок.Индекс(СтрокаДерева);
	// --- 
	// проверяем крайние положения
	// если уперлись - переносим в конец/начало
	Сдвиг = 0;
	ПредыдущееДействие = Неопределено;
	СледующееДействие = Неопределено;
	// --- 
	Если (ИндексТекущейСтроки = 0 И Направление=-1) Тогда
		
		Сдвиг = КоличествоСтрок-1; // с плюсом;
		ПредыдущаяСтрока = КоллекцияСтрок.Получить(КоличествоСтрок-1);
		Если (ПредыдущаяСтрока.ЭтоГруппа) Тогда
			ИдентификаторПредыдущейСтроки = ПредыдущаяСтрока.ИдентификаторГруппы;
		Иначе
			ИдентификаторПредыдущейСтроки = ПредыдущаяСтрока.Параметр;
		КонецЕсли; 
		
		
	ИначеЕсли (ИндексТекущейСтроки <> 0 И Направление=-1) Тогда 
		
		Сдвиг = -1;
		СледующаяСтрока = КоллекцияСтрок.Получить(ИндексТекущейСтроки+Сдвиг);
		Если (СледующаяСтрока.ЭтоГруппа) Тогда
			ИдентификаторСледующейСтроки = СледующаяСтрока.ИдентификаторГруппы;
		Иначе
			ИдентификаторСледующейСтроки = СледующаяСтрока.Параметр;
		КонецЕсли;
		
	ИначеЕсли (ИндексТекущейСтроки = КоличествоСтрок-1 И Направление=1) Тогда 
		
		 Сдвиг = -(КоличествоСтрок-1);
		 СледующаяСтрока = КоллекцияСтрок.Получить(0);
		 Если (СледующаяСтрока.ЭтоГруппа) Тогда
			ИдентификаторСледующейСтроки = СледующаяСтрока.ИдентификаторГруппы;
		Иначе
			ИдентификаторСледующейСтроки = СледующаяСтрока.Параметр;
		КонецЕсли;
		 
	ИначеЕсли (ИндексТекущейСтроки <> КоличествоСтрок-1 И Направление=1) Тогда 
		
		 Сдвиг = 1;
		 ПредыдущаяСтрока = КоллекцияСтрок.Получить(ИндексТекущейСтроки+Сдвиг);
		 Если (ПредыдущаяСтрока.ЭтоГруппа) Тогда
			ИдентификаторПредыдущейСтроки = ПредыдущаяСтрока.ИдентификаторГруппы;
		Иначе
			ИдентификаторПредыдущейСтроки = ПредыдущаяСтрока.Параметр;
		КонецЕсли; 
		
	КонецЕсли; 
	
	Ответ = _ИзменитьПорядокСтроки(ГруппаРодитель, ТекущаяСтрока, ИдентификаторПредыдущейСтроки, ИдентификаторСледующейСтроки);
	Если (_УФКС.ВыполненоУспешно(Ответ)) Тогда
		
		КоллекцияСтрок.Сдвинуть(КоллекцияСтрок.Индекс(СтрокаДерева),Сдвиг);
		
	Иначе
		
		Сообщить(_УФКС.ПредставлениеОшибки(Ответ));
		
	КонецЕсли; 
	
	// --- 
КонецПроцедуры

&НаСервере
Функция _ИзменитьПорядокСтроки(ИдентификаторГруппыРодителя, ИдентификаторТекущейСтроки, ИдентификаторПредыдущейСтроки, ИдентификаторСледующейСтроки)
	// --- 
	
	Попытка
		
		Группа = _сф.к_НайтиСтроку(Объект.ГруппыПараметровГрузоперевозки,Новый Структура("Идентификатор",ИдентификаторГруппыРодителя));
		МассивЭлементов = ЗначениеИзСтрокиВнутр(Группа.ИдентификаторыВедомых);
		ТаблицаЭлементов = Новый ТаблицаЗначений;
		ТаблицаЭлементов.Колонки.Добавить("Идентификатор");
		Для каждого Элемент Из МассивЭлементов Цикл
			Нстр = ТаблицаЭлементов.Добавить();
			Нстр.Идентификатор = Элемент;
		КонецЦикла; 
		СтрокаДерева = ДПГ.НайтиПоИдентификатору(ИдентификаторТекущейСтроки);
		Если (СтрокаДерева.ЭтоГруппа) Тогда
			СдвигаемоеЗначение = СтрокаДерева.ИдентификаторГруппы;
		Иначе
			СдвигаемоеЗначение = СтрокаДерева.Параметр;
		КонецЕсли; 
		СтрокаСдвигаемогоЗначения = _сф.к_НайтиСтроку(ТаблицаЭлементов, Новый Структура("Идентификатор",СдвигаемоеЗначение));
		// --- 
		Если (ИдентификаторПредыдущейСтроки <> Неопределено) Тогда
			
			ОтносительноеЗначение = ИдентификаторПредыдущейСтроки;
			//СтрокаДействия = _сф.к_НайтиСтроку(ТЧ, Новый Структура("Действие",ПредыдущееДействие));
			
		ИначеЕсли (ИдентификаторСледующейСтроки <> Неопределено) Тогда 
			
			ОтносительноеЗначение = ИдентификаторСледующейСтроки;
			
		КонецЕсли; 
		СтрокаОтносительногоЗначения = _сф.к_НайтиСтроку(ТаблицаЭлементов, Новый Структура("Идентификатор",ОтносительноеЗначение));
		Сдвиг = (ТаблицаЭлементов.Индекс(СтрокаОтносительногоЗначения)-ТаблицаЭлементов.Индекс(СтрокаСдвигаемогоЗначения));
		ТаблицаЭлементов.Сдвинуть(СтрокаСдвигаемогоЗначения,Сдвиг);
		// --- 
		МассивЭлементов=ТаблицаЭлементов.ВыгрузитьКолонку("Идентификатор");
		Группа.ИдентификаторыВедомых = ЗначениеВСтрокуВнутр(МассивЭлементов);
		
		
	Исключение
		Возврат(_УФКС.Ответ(1,ОписаниеОшибки()));
	КонецПопытки; 
	
	Возврат(_УФКС.Ответ());
	
	// --- 
КонецФункции
 
