#КонецОбласти 

#Область Клиент 

&НаКлиенте
Процедура КлиентНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	_УФК.ВыбратьКлиента(Объект.Клиент,Элемент, ДанныеВыбора, СтандартнаяОбработка);
	
КонецПроцедуры

&НаКлиенте
Процедура КлиентПриИзменении(Элемент)
	
	УстановитьМенеджераПродаж();
	
	ЗаполнитьПредопределенныеЗначенияПараметровДляРеквизита(Объект.Клиент, "Клиент");
	
	// --- 
	ОбновитьДерево = _ПроверитьСвязанныеПараметры("Клиент");
	Если (ОбновитьДерево) Тогда
		ОбновитьДеревоПараметров();
	КонецЕсли; 
	
КонецПроцедуры

&НаСервере
Процедура УстановитьМенеджераПродаж()
	
	ПараметрыСреза = Новый Структура;
	ПараметрыСреза.Вставить("ДатаСреза", Объект.ДатаСделкиФ);
	ПараметрыСреза.Вставить("Контрагент", Объект.Клиент);
	
	НовыйМенеджерПродаж = РегистрыСведений.CW_МенеджерыПродажКлиентов.ПолучитьМенеджераКлиента(ПараметрыСреза);
	
	Если ЗначениеЗаполнено(НовыйМенеджерПродаж) Тогда
		Если НовыйМенеджерПродаж <> Объект.МенеджерПродаж Тогда
			Объект.МенеджерПродаж = НовыйМенеджерПродаж;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура МенеджерПродажПриИзменении(Элемент)
	ЗаполнитьПредопределенныеЗначенияПараметровДляРеквизита(Объект.МенеджерПродаж, "МенеджерПродаж");
КонецПроцедуры

&НаКлиенте
Процедура ОперативныйМенеджерПриИзменении(Элемент)
	ЗаполнитьПредопределенныеЗначенияПараметровДляРеквизита(Объект.ОперативныйМенеджер, "ОперативныйМенеджер");
КонецПроцедуры

//Ограничение выбора менеджеров
&НаКлиенте
Процедура ВыбратьИзСпискаДействующихМенеджеров(Команда)
	
	МассивДействующиеМенеджеры = ПолучитьМассивДействующиеМенеджеровНаСервере();

	Если МассивДействующиеМенеджеры.Количество() <> 0 Тогда
		СтандартнаяОбработка = Ложь;
		СтруктураОтбора = Новый Структура("Ссылка", МассивДействующиеМенеджеры);
		
		ПараметрыФормыВыбора = Новый Структура;
		ПараметрыФормыВыбора.Вставить("Отбор", СтруктураОтбора);
		ПараметрыФормыВыбора.Вставить("МножественныйВыбор", Ложь);
		ПараметрыФормыВыбора.Вставить("РежимВыбора", Истина);
		ПараметрыФормыВыбора.Вставить("ЗакрыватьПриВыборе", Истина);
		
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("ИмяРеквизита", Этаформа.ТекущийЭлемент.Имя);
		
		Оповещение = Новый ОписаниеОповещения("ПродолжитьВыборМенеджера", ЭтаФорма, ДополнительныеПараметры);
		
		ОткрытьФорму("Справочник.ФизическиеЛица.ФормаВыбора", ПараметрыФормыВыбора, ЭтаФорма,,,,Оповещение,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьМассивДействующиеМенеджеровНаСервере()
	Возврат РегистрыСведений.CW_ДействующиеМенеджеры.ПолучитьМассивДействующиеМенеджеров();
КонецФункции

&НаКлиенте
Процедура ПродолжитьВыборМенеджера(РезльтатВыбора, ДополнительныеПараметры) Экспорт
	
	Если РезльтатВыбора = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Объект[ДополнительныеПараметры.ИмяРеквизита] = РезльтатВыбора;
	
КонецПроцедуры
//Ограничение выбора менеджеров



&НаСервере
Функция _ПроверитьСвязанныеПараметры(ИмяРеквизита)
	// --- 
	
	ОбновитьДП = Ложь;
	КартаСвойств = ПолучитьИзВременногоХранилища(АдресКартыСвойствПараметров);
	// --- 
	Для каждого Стр Из Объект.ПараметрыГрузоперевозки Цикл
		
		СП = КартаСвойств.Получить(Стр.Параметр);
		Если (СП.ИспользованиеОтбора) Тогда
			
			Для каждого СтрокаОтбора Из Стр.Параметр.ПараметрыОтбора Цикл
				
				Если (СтрокаОтбора.ВидУсловия = Перечисления.CW_ВидыУсловийОтбораПараметров.Реквизит) Тогда
					
					Если (СтрокаОтбора.Значение = ИмяРеквизита) Тогда
						
						СвойстваПараметра = CW_Мониторинг.СтруктураСвойствПараметра(Стр.Параметр);
						// --- 
						Стр.Значение = Неопределено;     
						
						Ответ = CW_МониторинговыеПараметрыСервер.ПолучитьПустуюСтруктуруРедактированияПараметров();
						Ответ.Параметр 		= Стр.Параметр;
						Ответ.Примечание 	= Стр.Примечание;
						
						Результат = _ОбновитьПараметр(Ответ, СвойстваПараметра.СписокВедомых);

						ОбновитьДП = Истина;
						
					КонецЕсли; 
					
				КонецЕсли; 
				
			КонецЦикла; 
			
		КонецЕсли; 
		
	КонецЦикла; 
	// --- 
	Возврат(ОбновитьДП);
	
	// --- 
КонецФункции 

#КонецОбласти 

#Область Маршрут

&НаКлиенте
Процедура МаршрутПриИзменении(Элемент)
	
	Если (ЗначениеЗаполнено(Объект.Маршрут)) Тогда
		
		Если (_МаршрутСоответствуетТипуПеревозки(Объект.Маршрут,Объект.ТипПеревозки)) Тогда
			ЗаполнитьПредопределенныеЗначенияПараметровДляРеквизита(Объект.Маршрут, "Маршрут");
		Иначе
			Объект.Маршрут = Неопределено;
			ПоказатьПредупреждение(,"Маршрут не соответствует указанному типу перевозки.");
		КонецЕсли; 
		
	КонецЕсли; 
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция _МаршрутСоответствуетТипуПеревозки(Маршрут,ТипПеревозки)
	// --- 
	
	Если (Маршрут.ОграничениеПоТипамПеревозок) Тогда
		
		Если (НЕ ЗначениеЗаполнено(ТипПеревозки)) Тогда
			
			Возврат(Ложь);
			
		Иначе
			
			Если (Маршрут.ТипыПеревозок.Найти(ТипПеревозки,"ТипПеревозки") <> Неопределено) Тогда
				Возврат(Истина);
			Иначе
				Возврат(Ложь);
			КонецЕсли; 
			
		КонецЕсли; 
		
	Иначе
		
		Возврат(Истина);
		
	КонецЕсли;  
	
	// --- 
КонецФункции
 

