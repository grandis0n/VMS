//Подключаемые команды
&НаСервере
Процедура ДобавитьПодключаемыеКоманды()
	
	ДанныеПодключаемыхКоманд =  ПолучитьДанныеПодключаемыхКоманд();
	
	Для Каждого ЭлементДанных из ДанныеПодключаемыхКоманд Цикл
		
		ИмяКоманды 		= ЭлементДанных.Ключ;
		ДанныеКоманды 	= ЭлементДанных.Значение;

		СоздатьКомандуФормы(ЭлементДанных.Ключ, ДанныеКоманды.ЗаголовокКоманды);
		
		ИмяЭлементаГруппы 	= "ГруппаПодключаемыеКоманды";
		
		ПараметрыКнопки = новый Структура;
		ПараметрыКнопки.Вставить("ИмяКоманды"			, ИмяКоманды);
		ПараметрыКнопки.Вставить("ИмяКартинки"			, "");
		ПараметрыКнопки.Вставить("Заголовок"			, ДанныеКоманды.ЗаголовокКоманды);
		ПараметрыКнопки.Вставить("ИмяЭлементаГруппы"	, ИмяЭлементаГруппы);
		
		ДобавитьКнопкуНаФорму(ПараметрыКнопки);
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьДанныеПодключаемыхКоманд()
	
	ДанныеПодключаемыхКоманд = Новый Соответствие;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	CW_ПодключаемыеОбъекты.Ссылка КАК Ссылка,
	               |	ВЫБОР
	               |		КОГДА CW_ПодключаемыеОбъектыФормыОбъекта.ИмяФормы ЕСТЬ NULL
	               |			ТОГДА ЛОЖЬ
	               |		ИНАЧЕ ИСТИНА
	               |	КОНЕЦ КАК ЕстьФормаЗаполнения,
	               |	CW_ПодключаемыеОбъектыФормыОбъекта.ИмяФормы КАК ИмяФормы
	               |ИЗ
	               |	Справочник.CW_ПодключаемыеОбъекты КАК CW_ПодключаемыеОбъекты
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.CW_ПодключаемыеОбъекты.ФормыОбъекта КАК CW_ПодключаемыеОбъектыФормыОбъекта
	               |		ПО CW_ПодключаемыеОбъекты.Ссылка = CW_ПодключаемыеОбъектыФормыОбъекта.Ссылка
	               |			И (CW_ПодключаемыеОбъектыФормыОбъекта.ТипФормы = ""ФормаНастроекЗаполнения"")
	               |ГДЕ
	               |	CW_ПодключаемыеОбъекты.ТипВнешнегоОбъекта = Значение(Перечисление.CW_ТипыПодключаемыхОбъектов.ВнешняяОбработка)
	               |	И (CW_ПодключаемыеОбъекты.Вид = ""ЗаполнениеБюджета_CW_Грузоперевозки""
				   //Поддержка версии 1.0
	               |			ИЛИ CW_ПодключаемыеОбъекты.Вид = ""ЗаполнениеБюджета"")
				   //Поддержка версии 1.0
	               |	И CW_ПодключаемыеОбъекты.ПометкаУдаления = ЛОЖЬ
	               |	И CW_ПодключаемыеОбъекты.НеИспользуется = ЛОЖЬ";
	
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		ИдентифкаторКоманды = "_"+Строка(Выборка.Ссылка.УникальныйИдентификатор());
		ИдентифкаторКоманды = СтрЗаменить(ИдентифкаторКоманды, "-", "_");
		
		Подключена =_ПО.ПодключитьОбработку(Выборка.Ссылка);

		СтруктурДанных = Новый Структура;
		СтруктурДанных.Вставить("Обработка", 			Выборка.Ссылка);
		СтруктурДанных.Вставить("ЗаголовокКоманды", 	Строка(Выборка.Ссылка));
		СтруктурДанных.Вставить("Подключена", 			Подключена);
		СтруктурДанных.Вставить("ЕстьФормаЗаполнения", 	Выборка.ЕстьФормаЗаполнения);
		
		Если Выборка.ЕстьФормаЗаполнения Тогда
			ПолноеИмяФрмы = _ПО.ПолучитьПолноеИмяФормы(Выборка.Ссылка,Выборка.ИмяФормы);
			СтруктурДанных.Вставить("ПолноеИмяФрмы", 	ПолноеИмяФрмы);
		КонецЕсли;
		
		ДанныеПодключаемыхКоманд.Вставить(ИдентифкаторКоманды, СтруктурДанных);
		
	КонецЦикла;
	
	АдресПодключаемыхКоманд = ПоместитьВоВременноеХранилище(ДанныеПодключаемыхКоманд, УникальныйИдентификатор);
	
	Возврат ДанныеПодключаемыхКоманд;
	
КонецФункции

&НаСервере
Процедура ДобавитьКнопкуНаФорму(ПараметрыКнопки)
	
	РасположениеКоманды = ЭтотОбъект.Элементы.Найти(ПараметрыКнопки.ИмяЭлементаГруппы);
	
	//Ссмылки на форме
	НайденныйЭлемент =  ЭтотОбъект.Элементы.Найти(ПараметрыКнопки.ИмяКоманды);
	Если НайденныйЭлемент <> Неопределено Тогда
		ЭтотОбъект.Элементы.Удалить(НайденныйЭлемент);
	КонецЕсли;
	
	// создадим кнопку
	НовыйЭлемент = ЭтотОбъект.Элементы.Добавить(ПараметрыКнопки.ИмяКоманды,  	// Первый параметр - имя кнопки
												Тип("КнопкаФормы")		,  	// Второй параметр - тип элемента управления
												РасположениеКоманды)	;	// Третий параметр - место расположения на форме
	
	НовыйЭлемент.Вид    		= ВидКнопкиФормы.КнопкаКоманднойПанели; // вид кнопки
	НовыйЭлемент.Заголовок  	= ПараметрыКнопки.Заголовок;
	НовыйЭлемент.ИмяКоманды 	= ПараметрыКнопки.ИмяКоманды;
	НовыйЭлемент.Картинка 		= БиблиотекаКартинок.CW_Загрузка;
	
КонецПроцедуры

&НаСервере
Процедура СоздатьКомандуФормы(ИмяКоманды, ЗаголовокКоманды)
	
	Если ЭтотОбъект.Команды.Найти(ИмяКоманды) = Неопределено Тогда
		
		// создадим команду
		НоваяКоманда = ЭтотОбъект.Команды.Добавить(ИмяКоманды); 			// Имя нашей команды
		НоваяКоманда.Заголовок  = ЗаголовокКоманды; 						// заголовок
		НоваяКоманда.Действие   = "ПодключаемыеКоманды_ЗаполнитьБюджет"; 	// Имя функции/процедуры	
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПодключаемыеКоманды_ЗаполнитьБюджет(Команда)
	
	ПараметрыКоманды 	= ПолучитьПараметрыКомандыНаСервере(Команда.Имя);

	СтруктураПараметров	= ПолучитьПараметрыЗаполнения(ПараметрыКоманды.Обработка);
	
	Если ПараметрыКоманды.ЕстьФормаЗаполнения Тогда
		// открываем форму
		ОписаниеОповещения	= Новый ОписаниеОповещения("ОбработкаЗаполненияБюджета",ЭтотОбъект);
		
		ОткрытьФорму(ПараметрыКоманды.ПолноеИмяФрмы,СтруктураПараметров,ЭтаФорма,,,,ОписаниеОповещения,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
	Иначе
		
		Если ПараметрыКоманды.ВыполнятьВФоне Тогда     

			РезультатВыполнения =  ПродолжитьЗаполнениеБюджетаНаСервереВФоне(СтруктураПараметров);
			
			ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
			ПараметрыОжидания.ВыводитьОкноОжидания = Истина;
			ОповещениеОЗавершении = Новый ОписаниеОповещения("ОбработатьРезультатЗаполненияБюджета", ЭтотОбъект);
			
			ДлительныеОперацииКлиент.ОжидатьЗавершение(РезультатВыполнения, ОповещениеОЗавершении, ПараметрыОжидания);
			
		Иначе
			// неинтерактивно
			Ответ = ЗаполнитьНеинтерактивно(ПараметрыКоманды.Обработка);
			Если Ответ <> Неопределено Тогда
				Если НЕ _УФКС.ВыполненоУспешно(Ответ) Тогда
					_УФК.ВывестиПредупреждение("Ошибка заполнения: "+_УФКС.ПредставлениеОшибки(Ответ));
				КонецЕсли;
			КонецЕсли; 
			
			ВыполнитьДействие(_УФКС.СД("Грузоперевозки","сервер","/БюджетОбновить"));
			
		КонецЕсли;
		
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьРезультатЗаполненияБюджета(РезультатВыполнения, Дополнительныепараметры) Экспорт
	
	Если РезультатВыполнения.Статус = "Выполнено" Тогда
		
		ВыполнитьДействие(_УФКС.СД("Грузоперевозки","сервер","/БюджетОбновить"));
	
	ИначеЕсли РезультатВыполнения.Статус = "Ошибка" Тогда
		
		ТекстПредупреждения = "Бюджеты не заполнены!
		| По причине: "+ РезультатВыполнения.КраткоеПредставлениеОшибки + "
		| Информаиция об ошибке см. в журнале регистрации!";
		
		Если ТипЗнч(РезультатВыполнения.Сообщения) = Тип("Массив") Тогда
			Для Каждого СообщениеВМассиве из РезультатВыполнения.Сообщения Цикл
				СообщениеВМассиве.Сообщить();
			КонецЦикла;
		КонецЕсли;
		
		ПоказатьПредупреждение(,ТекстПредупреждения,,"Ошибка заполнения");
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПродолжитьЗаполнениеБюджетаНаСервереВФоне(ПараметрыПроцедуры)
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(Новый УникальныйИдентификатор);
	ПараметрыВыполнения.ОжидатьЗавершение 			= 0; // запускать сразу
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = "Заполнение бюджета заказа";
	ПараметрыВыполнения.ЗапуститьВФоне 				= Истина;
	ПараметрыВыполнения.ЗапуститьНеВФоне 			= ложь;
	
	Возврат ДлительныеОперации.ВыполнитьВФоне("Справочники.CW_Заказы.ПодключаемыеКоманды_ЗаполнитьБюджет", ПараметрыПроцедуры, ПараметрыВыполнения);
		
КонецФункции

&НаСервере
Функция ПолучитьПараметрыКомандыНаСервере(ИмяКоманды)
	
	ПараметрыКоманд = ПолучитьИзВременногоХранилища(АдресПодключаемыхКоманд);
	
	СтруктураКоманды = ПараметрыКоманд.Получить(ИмяКоманды);
	
	//Дополнительная информация по обработке
	ОбработкаОбъект 		= _ПО.ПолучитьОбработку(СтруктураКоманды.Обработка);
	ИнформацияОбОбработке 	= ОбработкаОбъект.Информация();
	
	ВыполнятьВФоне = Ложь;
	Если ИнформацияОбОбработке.Свойство("ВыполнятьВФоне") Тогда
		ВыполнятьВФоне = ИнформацияОбОбработке.ВыполнятьВФоне;	
	КонецЕсли;
	
	СтруктураКоманды.Вставить("ВыполнятьВФоне",ВыполнятьВФоне);
	
	Возврат СтруктураКоманды;
	
КонецФункции

&НаСервере
Функция ПолучитьПараметрыЗаполнения(ОбработкаЗаполнения)
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("Грузоперевозка",	Объект.Ссылка);
	СтруктураПараметров.Вставить("ВерсияБюджета",	БюджетТекущаяВерсия);
	СтруктураПараметров.Вставить("Обработка",		ОбработкаЗаполнения);
	
	Возврат СтруктураПараметров;
	
КонецФункции

&НаСервере
Функция ЗаполнитьНеинтерактивно(ОбработкаЗаполнения)
	// --- 
	
	СтруктураПараметров = ПолучитьПараметрыЗаполнения(ОбработкаЗаполнения);
	Обработка 			= _ПО.ПолучитьОбработку(ОбработкаЗаполнения);
	Ответ 				= Обработка.ЗаполнитьБюджет(СтруктураПараметров);
	Возврат Ответ;
	
	// --- 
КонецФункции
