&НаКлиенте
Процедура ОтчетЭкспедитораПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	Отказ = истина;
	
	ЗначенияЗаполнения = Новый Структура;
	ЗначенияЗаполнения.Вставить("ПорядокЗаполнения", 0);
	ЗначенияЗаполнения.Вставить("ЗначениеОтбора", Объект.Ссылка);

	ДополнитьКонтрагентаИДоговор(ЗначенияЗаполнения);
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("ЗначенияЗаполнения", ЗначенияЗаполнения);
	
	ОткрытьФорму("Документ.CW_ОтчетЭкспедитора.ФормаОбъекта", СтруктураПараметров, ЭтотОбъект);
	

КонецПроцедуры   

&НаСервере
Процедура ДополнитьКонтрагентаИДоговор(ЗначенияЗаполнения)   
	
	СтруктураПараметров 	= ПодготовитьДанныеДляПолученияДанныхпокупателя();
	СтруктураДанныхСтроки 	= ПолучитьДанныеПокупателя(СтруктураПараметров);
	
	Если СтруктураДанныхСтроки.Свойство("Покупатель") Тогда 
		ЗначенияЗаполнения.Вставить("Контрагент", СтруктураДанныхСтроки.Покупатель);
	КонецЕсли;
	Если СтруктураДанныхСтроки.Свойство("ДоговорПокупателя") Тогда
		ЗначенияЗаполнения.Вставить("Договор", СтруктураДанныхСтроки.ДоговорПокупателя);
	КонецЕсли;
	Если СтруктураДанныхСтроки.Свойство("ПриложениеКДоговору") Тогда
		ЗначенияЗаполнения.Вставить("ПриложениеКДоговору", СтруктураДанныхСтроки.ПриложениеКДоговору);
	КонецЕсли;
	
КонецПроцедуры		

//Получение параметров для строки "Покупатель", "Договор", "Приложение"
&НаСервере
Функция ПодготовитьДанныеДляПолученияДанныхпокупателя()
	
	Организация = CW_Настройки.ОсновнаяОрганизация();
	
	Результат = Новый Структура;
	Результат.Вставить("Организация", 		Организация);
	Результат.Вставить("Контрагент", 		Объект.Клиент);
	Результат.Вставить("Объект", 			Объект.Ссылка);
	Результат.Вставить("Заказ", 			Объект.Заказ);
	Результат.Вставить("ЭтоВариантБюджета", ЛОЖЬ);
	Результат.Вставить("УчетПриложений", 	ЛОЖЬ);
	
	Возврат Результат;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьДанныеПокупателя(СтруктураПараметров)
	
	Покупатель = CW_Финансы.ВернутьПлательщика(СтруктураПараметров);
	СтруктураПараметров.Вставить("Покупатель", Покупатель);
	
	ПолучитьДоговорПокупателя(СтруктураПараметров);
	ПолучитьПриложениеПоДоговору(СтруктураПараметров);
	
	ДанныеСтроки = Новый Структура;
	ДанныеСтроки.Вставить("Покупатель", СтруктураПараметров.Покупатель);
	
	Если СтруктураПараметров.Свойство("ДоговорПокупателя") Тогда
		ДанныеСтроки.Вставить("ДоговорПокупателя", СтруктураПараметров.ДоговорПокупателя);
	КонецЕсли;
	
	Если СтруктураПараметров.Свойство("ПриложениеКДоговору") Тогда
		ДанныеСтроки.Вставить("ПриложениеКДоговору", СтруктураПараметров.ПриложениеКДоговору);
	КонецЕсли;
	
	Возврат ДанныеСтроки;
	
КонецФункции

&НаСервереБезКонтекста
Процедура ПолучитьДоговорПокупателя(СтруктураПараметров)
	
	Если НЕ ЗначениеЗаполнено(СтруктураПараметров.Объект) Тогда
		Возврат;
	КонецЕсли; 
	
	НайденныйДоговор = ПредопределенноеЗначение("Справочник.CW_ДоговорыПоГрузоперевозкам.ПустаяСсылка");
	
	ПараметрДоговора = Константы.CW_ПараметрДоговораПлательщика.Получить();
	Если Не ПараметрДоговора.Пустая() Тогда
		
		НайденныйДоговор = ПолучитьЗначениеПараметра(СтруктураПараметров.Объект, ПараметрДоговора, ПредопределенноеЗначение("Справочник.CW_ДоговорыПоГрузоперевозкам.ПустаяСсылка"));
		
		Если Не ЗначениеЗаполнено(НайденныйДоговор) Тогда
			Если СтруктураПараметров.Свойство("Заказ") Тогда
				Если ЗначениеЗаполнено(СтруктураПараметров.Заказ) Тогда
					НайденныйДоговор = ПолучитьЗначениеПараметра(СтруктураПараметров.Заказ, ПараметрДоговора, ПредопределенноеЗначение("Справочник.CW_ДоговорыПоГрузоперевозкам.ПустаяСсылка"))
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(НайденныйДоговор) Тогда
			Если НайденныйДоговор.Владелец <> СтруктураПараметров.Покупатель ИЛИ
				НайденныйДоговор.Организация <> СтруктураПараметров.Организация Тогда
				
				НайденныйДоговор = ПредопределенноеЗначение("Справочник.CW_ДоговорыПоГрузоперевозкам.ПустаяСсылка");
			КонецЕсли; 
		КонецЕсли; 
		
	КонецЕсли; 
	
	Если Не ЗначениеЗаполнено(НайденныйДоговор)  Тогда
		ВидДоговора = ПредопределенноеЗначение("Перечисление.ВидыДоговоровКонтрагентов.СПокупателем");
		НайденныйДоговор = CW_Документы.ПолучитьПоследнийДоговор(СтруктураПараметров.Покупатель, СтруктураПараметров.Организация, ВидДоговора);
	КонецЕсли;
	
	СтруктураПараметров.Вставить("ДоговорПокупателя", НайденныйДоговор);
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ПолучитьПриложениеПоДоговору(СтруктураПараметров)
	
	Если НЕ ПолучитьФункциональнуюОпцию("CW_ВедетсяУчетПриложенийПоДоговорам") Тогда 
		Возврат;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(СтруктураПараметров.Объект) Тогда
		Возврат;
	КонецЕсли; 

	Если НЕ СтруктураПараметров.ДоговорПокупателя.ИспользуютсяПриложения Тогда
		Возврат;
	КонецЕсли;
	
	НайденноеПриложение = ПредопределенноеЗначение("Справочник.CW_ПриложенияКДоговорам.ПустаяСсылка");
	
	СтруктураПараметров.УчетПриложений = Истина;
	
	ПараметрПриложенияДоговора = Константы.CW_ПараметрПриложенияДоговора.Получить();
	Если Не ПараметрПриложенияДоговора.Пустая() Тогда
		
		НайденноеПриложение = ПолучитьЗначениеПараметра(СтруктураПараметров.Объект, ПараметрПриложенияДоговора, ПредопределенноеЗначение("Справочник.CW_ПриложенияКДоговорам.ПустаяСсылка"));
		
		Если НайденноеПриложение.Пустая() Тогда
			Если СтруктураПараметров.Свойство("Заказ") Тогда
				Если ЗначениеЗаполнено(СтруктураПараметров.Заказ) Тогда
					НайденноеПриложение = ПолучитьЗначениеПараметра(СтруктураПараметров.Заказ, ПараметрПриложенияДоговора, ПредопределенноеЗначение("Справочник.CW_ПриложенияКДоговорам.ПустаяСсылка"))
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		Если Не НайденноеПриложение.Пустая() Тогда
			Если НайденноеПриложение.Договор <> СтруктураПараметров.ДоговорПокупателя  Тогда
				НайденноеПриложение = ПредопределенноеЗначение("Справочник.CW_ПриложенияКДоговорам.ПустаяСсылка");
			КонецЕсли; 
		КонецЕсли;
		
	КонецЕсли;
	
	Если НайденноеПриложение.Пустая() Тогда
		
		Запрос = Новый Запрос;
		запрос.Текст = "ВЫБРАТЬ
		               |	CW_ПриложенияКДоговорам.Ссылка КАК Ссылка
		               |ИЗ
		               |	Справочник.CW_ПриложенияКДоговорам КАК CW_ПриложенияКДоговорам
		               |ГДЕ
		               |	CW_ПриложенияКДоговорам.Договор = &Договор
		               |	И CW_ПриложенияКДоговорам.ПометкаУдаления = ЛОЖЬ
		               |	И (CW_ПриложенияКДоговорам.СрокДействия > &Текущаядата
		               |			ИЛИ CW_ПриложенияКДоговорам.СрокДействия = &ПустаяДата)";
		
		Запрос.УстановитьПараметр("Договор", 		СтруктураПараметров.ДоговорПокупателя);
		Запрос.УстановитьПараметр("Текущаядата", 	ТекущаяДата());
		Запрос.УстановитьПараметр("ПустаяДата", 	Дата(1,1,1));
		
		РезультатЗапроса = Запрос.Выполнить();
		
		Выборка = РезультатЗапроса.Выбрать();
		Если Выборка.Количество() = 1 Тогда
			Выборка.Следующий();
			НайденноеПриложение = Выборка.Ссылка;
		КонецЕсли;
		
	КонецЕсли;

	СтруктураПараметров.Вставить("ПриложениеКДоговору", НайденноеПриложение);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьЗначениеПараметра(ВладелецПараметров, Параметр, ПустоеЗначение)
	
	Запрос = Новый Запрос;
	
	Если ТипЗнч(ВладелецПараметров)  = Тип("СправочникСсылка.CW_Грузоперевозки") Тогда
		Запрос.Текст = "ВЫБРАТЬ
		               |	CW_ХарактеристикиГрузоперевозок.Грузоперевозка КАК Грузоперевозка,
		               |	CW_ХарактеристикиГрузоперевозок.Параметр КАК Параметр,
		               |	CW_ХарактеристикиГрузоперевозок.Значение КАК Значение
		               |ИЗ
		               |	РегистрСведений.CW_ХарактеристикиГрузоперевозок КАК CW_ХарактеристикиГрузоперевозок
		               |ГДЕ
		               |	CW_ХарактеристикиГрузоперевозок.Грузоперевозка = &ВладелецПараметров
		               |	И CW_ХарактеристикиГрузоперевозок.Параметр = &Параметр";
	КонецЕсли;
	
	Если ТипЗнч(ВладелецПараметров)  = Тип("СправочникСсылка.CW_Заказы") Тогда
		Запрос.Текст = "ВЫБРАТЬ
		               |	CW_ХарактеристикиЗаказов.Параметр КАК Параметр,
		               |	CW_ХарактеристикиЗаказов.Значение КАК Значение
		               |ИЗ
		               |	РегистрСведений.CW_ХарактеристикиЗаказов КАК CW_ХарактеристикиЗаказов
		               |ГДЕ
		               |	CW_ХарактеристикиЗаказов.Заказ = &ВладелецПараметров
		               |	И CW_ХарактеристикиЗаказов.Параметр = &Параметр";
	КонецЕсли;
	
	Запрос.УстановитьПараметр("ВладелецПараметров", ВладелецПараметров);
	Запрос.УстановитьПараметр("Параметр", 			Параметр);
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Значение;
	КонецЕсли;
	
	Возврат ПустоеЗначение;
	
КонецФункции
