&НаКлиенте
Процедура ДПГПередНачаломИзменения(Элемент, Отказ)
	
	Отказ = Истина;
	
	Если ЗначениеЗаполнено(ДатаБлокировкиМониторинга) тогда
		Возврат;
	КонецЕсли;

	
	Идентификатор = Элементы.ДПГ.ТекущаяСтрока;
	СтрокаДПГ = ДПГ.НайтиПоИдентификатору(Идентификатор);
	// ---------------------------------------------------------------------------- 
	Если СтрокаДПГ.ПараметрЗаказа Тогда
		Возврат;
	КонецЕсли;
	                                             
	Если СтрокаДПГ.ПараметрОборудования Тогда
		Возврат;
	КонецЕсли;
	
	// группа
	Если (СтрокаДПГ.ЭтоГруппа) Тогда
		
		ДоступнаСменаРежимаСвертки 	= ПроверитьСостояниеВедомых(СтрокаДПГ);
		СостояниеГруппы  			= ПолучитьНастройкуРаскрытияГруппы(СтрокаДПГ.ИдентификаторГруппы);
		
		ПараметрыФормы 	= Новый Структура("НаименованиеГруппы,ГруппаРазвернута,РежимГрузоперевозки,ДоступнаСменаРежимаСвертки", СтрокаДПГ.НаименованиеГруппы,СостояниеГруппы, Истина,ДоступнаСменаРежимаСвертки);
		ПОВ 			= Новый ОписаниеОповещения("ОбработатьВводНаименованияГруппы",ЭтотОбъект, Новый Структура("Редактирование",Истина)); 
		
		ОткрытьФорму("ПланВидовХарактеристик.CW_ПараметрыГрузоперевозок.Форма.ФормаВиртуальнойГруппы",ПараметрыФормы,,,,,ПОВ, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
	КонецЕсли;
	
	// параметр
	Если (НЕ СтрокаДПГ.ЭтоГруппа) Тогда 
		
		Параметр = Элемент.ТекущиеДанные.Параметр;
		
		ИдентификаторСтрокиГруппы	= Неопределено;
		РодительПараметра 			= СтрокаДПГ.ПолучитЬРодителя();
		Если  РодительПараметра <> Неопределено тогда
			ИдентификаторСтрокиГруппы	= РодительПараметра.ПолучитьИдентификатор()
		КонецЕсли;
		
		// --- 
		ПараметрТолькоПросмотр = _ТолькоПросмотрПараметра(Параметр);
		СвойстваПараметра = CW_Мониторинг.СтруктураСвойствПараметра(Параметр);	
		Если (СвойстваПараметра.Ведомый) Тогда
			
			// проверяем ведущие на заполненность
			Результат = _ПроверитьЗаполнениеВедущих(Параметр,СвойстваПараметра.СписокВедущих);
			Если (НЕ _УФКС.ВыполненоУспешно(Результат)) Тогда
				
				_УФК.ВывестиПредупреждение("Данный параметр является зависимым!");
				Возврат;
				
			КонецЕсли;
			
		КонецЕсли; 
		Если (СвойстваПараметра.ДинамическийПараметр) Тогда
			
			_УФК.ВывестиПредупреждение("Динамические параметры не редактируются");
			Возврат;
			
		КонецЕсли;
		// --- 
		АдресОбъекта 		= _АдресОбъекта();
		РежимТолькоПросмотр = ПараметрТолькоПросмотр ИЛИ ЗначениеЗаполнено(ДатаБлокировкиМониторинга);
		ВыбраннаяФорма 		= Неопределено;
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("Режим"						, "РедактированиеОбъекта");
		ПараметрыФормы.Вставить("Параметр"					, Параметр);
		ПараметрыФормы.Вставить("ИдентификаторСтрокиГруппы"	, ИдентификаторСтрокиГруппы);
		ПараметрыФормы.Вставить("АдресСвойствПараметра"		, ПоместитьВоВременноеХранилище(СвойстваПараметра,ЭтаФорма.УникальныйИдентификатор));
		ПараметрыФормы.Вставить("АдресОбъекта"				, АдресОбъекта);
		ПараметрыФормы.Вставить("ТолькоПросмотр"			, РежимТолькоПросмотр);
		ПараметрыФормы.Вставить("Значение"			        , СтрокаДПГ.Значение);
		
		//ХранениеПолногоЗначения  
		Если CW_МониторинговыеПараметрыСервер.ИспользуетсяСохранениеПолногоЗначения(Параметр) Тогда
			Если ТипЗнч(СохраняемоеПолноеЗначение) = Тип("ФиксированноеСоответствие") Тогда
				ПолноеЗначение = СохраняемоеПолноеЗначение.Получить(Параметр);
			КонецЕсли;
			ПолноеЗначение = ?(ПолноеЗначение=Неопределено, СтрокаДПГ.Значение, ПолноеЗначение);
			
			ПараметрыФормы.Вставить("ПолноеЗначение", ПолноеЗначение);
		КонецЕсли;
		//---ХранениеПолногоЗначения
		
		ПОВ = Новый ОписаниеОповещения("ОбработатьИзменениеПараметра",ЭтотОбъект,Новый Структура("СвойстваПараметра,Параметр",СвойстваПараметра,Параметр));
		
		Если СвойстваПараметра.ИспользоватьФормуВыбораОбъекта тогда
			
			Если Не РежимТолькоПросмотр Тогда
				ВыбраннаяФорма = СвойстваПараметра.ИмяФормыВыбора;
				
				ПараметрыФормы.Вставить("РежимВыбора"		,         Истина);
				ПараметрыФормы.Вставить("ЗакрыватьПриВыборе",         Истина);
				
				ОтборФормы = СформироватьПараметрыОтбора(Объект.Ссылка, Параметр);
				
				Если ОтборФормы <> Неопределено Тогда
					Если СвойстваПараметра.ИспользуютсяДополнительныеЗначения Тогда
						Если ОтборФормы.Свойство("Отбор") Тогда
							ОтборФормы.Отбор.Вставить("Владелец",Параметр);
						КонецЕсли;
					КонецЕсли;
					ПараметрыФормы.Вставить("Отбор", ОтборФормы.Отбор);
				Иначе
					Если СвойстваПараметра.ИспользуютсяДополнительныеЗначения Тогда
						ПараметрыФормы.Вставить("Отбор", Новый Структура("Владелец",Параметр));
					КонецЕсли;
				КонецЕсли;
				
			КонецЕсли; 
			
		Иначе
			Если СвойстваПараметра.ИспользуетсяВнешняяОбработкаПередНачаломИзменения Тогда
				
				СтруктураПараметров = _ПО.ПолучитьИмяФормыНаСервере(Параметр, АдресОбъекта);
				ВыбраннаяФорма 		= "ПланВидовХарактеристик.CW_ПараметрыГрузоперевозок.Форма.ФормаРедактирования";
				
				ОбработчикНеИспользуется = Ложь;
				Если СтруктураПараметров.Свойство("НеИспользуется") Тогда
					ОбработчикНеИспользуется = СтруктураПараметров.НеИспользуется;
				КонецЕсли;
				

				Если СтруктураПараметров.Свойство("ТолькоПросмотр") Тогда
					Если  НЕ ПараметрыФормы.ТолькоПросмотр Тогда
						ПараметрыФормы.ТолькоПросмотр =  СтруктураПараметров.ТолькоПросмотр;
					КонецЕсли;
				КонецЕсли;
				
				Если СтруктураПараметров.Свойство("ПодключаемыйОбъект") Тогда
					ПараметрыФормы.Вставить("ПодключаемыйОбъект",СтруктураПараметров.ПодключаемыйОбъект);
				КонецЕсли; 
				
				Если ОбработчикНеИспользуется ИЛИ 
					СтруктураПараметров.РежимОткрытия = 1 Тогда
					ВыбраннаяФорма = "ПланВидовХарактеристик.CW_ПараметрыГрузоперевозок.Форма.ФормаРедактирования";
				ИначеЕсли	СтруктураПараметров.РежимОткрытия = 0 Тогда
					ВыбраннаяФорма = СтруктураПараметров.ИмяФормы;
				КонецЕсли;

			Иначе
				ВыбраннаяФорма = "ПланВидовХарактеристик.CW_ПараметрыГрузоперевозок.Форма.ФормаРедактирования";
			КонецЕсли;

		КонецЕсли;
		
		Если ВыбраннаяФорма <> Неопределено Тогда
			ОткрытьФорму(ВыбраннаяФорма, ПараметрыФормы,ЭтаФорма,,,,ПОВ,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		КонецЕсли;
		
	КонецЕсли; 
	
КонецПроцедуры

&НаСервере
Функция СформироватьПараметрыОтбора(РедактируемыйОбъект,Параметр)
	
	Если Не Параметр.ИспользованиеОтбора Тогда
		Возврат Неопределено;
	Конецесли;

	Если Параметр.ВариантОтбора=Перечисления.CW_ВариантыОтбораДляПараметров.СтандартныйОтбор Тогда
		
		МассивПараметровВыбора = Новый Массив;
		Для каждого ПараметрВыбора Из Параметр.ПараметрыОтбора Цикл
			
			Если (ПараметрВыбора.ВидУсловия = Перечисления.CW_ВидыУсловийОтбораПараметров.Значение) Тогда
				
				НовыйПараметр = Новый ПараметрВыбора(ПараметрВыбора.РеквизитОтбора,ПараметрВыбора.Значение);
				МассивПараметровВыбора.Добавить(НовыйПараметр);
				
			ИначеЕсли (ПараметрВыбора.ВидУсловия = Перечисления.CW_ВидыУсловийОтбораПараметров.Реквизит) Тогда
				
				Попытка
					
					ИмяРеквизита = ПараметрВыбора.Значение;
					Если (ИмяРеквизита = "Клиент") Тогда
						Если (ТипЗнч(РедактируемыйОбъект.Ссылка)=Тип("СправочникСсылка.CW_Заявки")) Тогда
							ИмяРеквизита = "Контрагент";
						КонецЕсли; 
					КонецЕсли; 
					
					СсылкаОбъекта = РедактируемыйОбъект.Ссылка;
					ЗначениеРеквизита = СсылкаОбъекта[ИмяРеквизита];
					
				Исключение
					ЗначениеРеквизита = Неопределено;
				КонецПопытки; 
				
				Если (ЗначениеРеквизита <> Неопределено) Тогда
					
					Если (ЗначениеЗаполнено(ЗначениеРеквизита)) Тогда
						
						НовыйПараметр = Новый ПараметрВыбора(ПараметрВыбора.РеквизитОтбора,ЗначениеРеквизита);
						МассивПараметровВыбора.Добавить(НовыйПараметр);
						
					КонецЕсли; 
					
				КонецЕсли; 
				
				
			ИначеЕсли (ПараметрВыбора.ВидУсловия = Перечисления.CW_ВидыУсловийОтбораПараметров.Параметр) Тогда
				
				ИмяТЧ = CW_Мониторинг.ТабличнаяЧастьПараметровОбъекта(РедактируемыйОбъект); 
				
				Если ИмяТЧ <> Неопределено Тогда
					// в качестве значения подставляем значение параметра 
					СтрокаПараметра = _сф.к_НайтиСтроку(РедактируемыйОбъект[ИмяТЧ],"Параметр",ПараметрВыбора.Значение);
					Если СтрокаПараметра <> Неопределено Тогда
						НовыйПараметр = Новый ПараметрВыбора(ПараметрВыбора.РеквизитОтбора,СтрокаПараметра.Значение);
						МассивПараметровВыбора.Добавить(НовыйПараметр);
					КонецЕсли;	
				КонецЕсли;
				
			КонецЕсли; 
			
		КонецЦикла; 
		
		//Элементы.Значение.ВыборГруппИЭлементов=ГруппыИЭлементы.ГруппыИЭлементы;
		
		ПараметрыФормыВыбора = Новый Структура("ИмяФормы,ПараметрыФормы,ПараметрыВыбора","",Новый Структура,Новый Массив);
		Для каждого Стр Из МассивПараметровВыбора Цикл
			
			// 
			ТипПараметра = Параметр.ТипЗначения.Типы()[0];
			СсылкаТипа = Новый(ТипПараметра);
			ПараметрыФормыВыбора.ИмяФормы = СсылкаТипа.Метаданные().ПолноеИмя()+".ФормаВыбора";
			// --- 
			Если (Стр.Имя = "Отбор.Родитель") Тогда
				
				// ПараметрВыбора.Значение.Ссылка.Метаданные().ПолноеИмя()
				
				ПараметрыФормыВыбора.ИмяФормы = Стр.Значение.Метаданные().ПолноеИмя()+".ФормаВыбора";
				ПараметрыФормыВыбора.ПараметрыФормы.Вставить("РежимВыбора",Истина);
				
				Если (Стр.Значение.Метаданные().ПолноеИмя()="Справочник.Контрагенты") Тогда
					
					Запрос = Новый Запрос;
					Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
					|	Контрагенты.Ссылка
					|ИЗ
					|	Справочник.Контрагенты КАК Контрагенты
					|ГДЕ
					|	Контрагенты.Родитель = &Родитель";
					Запрос.УстановитьПараметр("Родитель",Стр.Значение);
					Первый = _сф.ВыполнитьЗапрос(Запрос,,Истина,"Ссылка",Неопределено);
					Если (Первый <> Неопределено) Тогда
						
						ПараметрыФормыВыбора.ПараметрыФормы.Вставить("ТекущаяСтрока",Первый);
						
					Иначе
						
						ПараметрыФормыВыбора.ПараметрыФормы.Вставить("ТекущаяСтрока",Стр.Значение);
						
					КонецЕсли; 
					
				Иначе
					
					ПараметрыФормыВыбора.ПараметрыФормы.Вставить("ТекущаяСтрока",Стр.Значение);
					
				КонецЕсли; 
				
				ПН = Новый НастройкиКомпоновкиДанных;
				ЭлементОтбора = ПН.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
				ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Ссылка");
				ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.ВИерархии;
				ЭлементОтбора.ПравоеЗначение = Стр.Значение;
				ЭлементОтбора.Использование = Истина;
				ЭлементОтбора.Применение=ТипПримененияОтбораКомпоновкиДанных.ТолькоИерархия;
				ПараметрыФормыВыбора.ПараметрыФормы.Вставить("ФиксированныеНастройки", ПН);
				
				
			Иначе
				
				ПараметрыФормыВыбора.ПараметрыВыбора.Добавить(Стр);
				ПараметрыФормыВыбора.ПараметрыФормы.Вставить("РежимВыбора",Истина);
				
			КонецЕсли; 
			
		КонецЦикла; 
		
		// добавляем параметры выбора в отбор
		ПараметрыФормыВыбора.ПараметрыФормы.Вставить("Отбор",Новый Структура);
		Для каждого Стр Из ПараметрыФормыВыбора.ПараметрыВыбора Цикл
			
			ПараметрыФормыВыбора.ПараметрыФормы.Отбор.Вставить(СтрЗаменить(Стр.Имя,"Отбор.",""),Стр.Значение);
			
		КонецЦикла; 
		
	Возврат ПараметрыФормыВыбора.ПараметрыФормы;
		
	ИначеЕсли Параметр.ВариантОтбора=Перечисления.CW_ВариантыОтбораДляПараметров.ВнешняяОбработка Тогда
		
		ОбработкаОбъект = _ПО.ПолучитьОбработку(Параметр.ВнешняяОбработкаОтбора);
		// Параметры:
		// Параметр - текущий редактируемый параметр
		// РедактируемыйОбъект - грузоперевозка, заявки или другое
		// ТекущееЗначение - Текущее значение параметра
		// ВозвращаемоеЗначение: Структура:
		// ИмяФормы - полное имя формы
		// ПараметрыФормы - внезапно, параметры формы
		// ПараметрыВыбора - массив фиксированных структур или пустой массив (?) - зачем он нужен не очень понятно
		// --- 
		// пример заполнения структуры в предыдущей ветке
		// --- 
		ПараметрыФормыВыбора = ОбработкаОбъект.ПараметрыФормыВыбора(Параметр,РедактируемыйОбъект,Неопределено);
		ОбработкаОбъект = Неопределено;
		
		Возврат ПараметрыФормыВыбора.ПараметрыФормы; 
		
	КонецЕсли; 
	
	Возврат Неопределено;
	
КонецФункции


&наКлиенте
Функция ПроверитьСостояниеВедомых(СтрокаДерева)
	
	ДоступностьСменыРежима = Истина;
	
	тЭлеметы = СтрокаДерева.ПолучитьЭлементы();
	ПроверитьСостояниеВедомыхРекурсивно(тЭлеметы, ДоступностьСменыРежима);
	
	Возврат ДоступностьСменыРежима;
	
КонецФункции

&наКлиенте
Процедура ПроверитьСостояниеВедомыхРекурсивно(тЭлеметы, ДоступностьСменыРежима)
	
	Если Не ДоступностьСменыРежима Тогда
		Возврат;
	КонецЕсли;
	
	Для каждого стрЭлемент из тЭлеметы Цикл
		Если  стрЭлемент.ЭтоГруппа Тогда
			ЭлементСостояния = ДПГ_СостояниеСвертки.НайтиПоЗначению(стрЭлемент.ИдентификаторГруппы);
			Если ЭлементСостояния <> Неопределено Тогда
				Если ЭлементСостояния.Пометка Тогда
					ДоступностьСменыРежима = Ложь;
				КонецЕсли;
			КонецЕсли;
			Подчиненные = стрЭлемент.получитьЭлементы();
			ПроверитьСостояниеВедомыхРекурсивно(подчиненные, ДоступностьСменыРежима);
		КонецЕсли;
	КонецЦикла;
		
КонецПроцедуры

&НаСервере
Функция ПолучитьНастройкуРаскрытияГруппы(Идентификатор)
	
	мНайденныеСтроки = Объект.ГруппыПараметровГрузоперевозки.НайтиСтроки(Новый Структура("Идентификатор",Идентификатор));
	
	Если мНайденныеСтроки.Количество() = 0 Тогда
		//Странно... группа есть, а строки нет
		//получим настройку из параметров
		
		CW_Настройки.ПолучитьНастройкуПользователя(ПараметрыСеанса.ТекущийПользователь,"РазворачиватьДеревоПараметровГрузоперевозок");		
	Иначе
		Возврат мНайденныеСтроки[0].Раскрывать;
	КонецЕсли;
	
КонецФункции

&НаСервере
Функция _ПроверитьЗаполнениеВедущих(Параметр,СписокВедущих)
	// --- 
	
	// контроллируем заполнение и единство
	ФлагОшибки = Ложь;
	ТекстОшибки = "";
	Для каждого ВедущийПГ Из СписокВедущих Цикл
		
		// проверяем параметр у переданных объектов
		МассивНепустыхЗначений = Новый Массив;
		
		ВедущийПараметр = ВедущийПГ.Значение;
		СтрокаПараметра = _сф.к_НайтиСтроку(Объект.ПараметрыГрузоперевозки,"Параметр",ВедущийПараметр);
		Если СтрокаПараметра = Неопределено Тогда
			
			ЗначениеПараметра = Неопределено;
			
		Иначе
			
			ЗначениеПараметра = СтрокаПараметра.Значение;
			
		КонецЕсли; 
		Если ЗначениеЗаполнено(ЗначениеПараметра) Тогда
			
			_сф.м_ДобавитьУникально(МассивНепустыхЗначений,ЗначениеПараметра);
			
		Иначе
			
			ФлагОшибки = Истина;
			ТекстОшибки = "";
			
		КонецЕсли; 
		
		
		// теперь если нет ошибки считаем количество
		// если не 1, то выдаём ошибку
		Если НЕ ФлагОшибки Тогда
			
			Если МассивНепустыхЗначений.Количество() <> 1 Тогда
				
				ФлагОшибки = Истина;
				ТекстОшибки = ""
				
			КонецЕсли; 
			
		КонецЕсли; 
		
		Если ФлагОшибки Тогда
			
			// тут необходимо закрыть форму и вернуть описание ошибки
			ТекстОшибки = "Условия отбора для выбранного параметра ("""+Параметр.Наименование+""") требуют, чтобы было задано значение параметра """+ВедущийПараметр.Наименование+""".";
			Возврат(_УФКС.Ответ(1,ТекстОшибки));
			
		КонецЕсли; 
		
	КонецЦикла; 
	
	Возврат(_УФКС.Ответ());
	
	// --- 
КонецФункции

