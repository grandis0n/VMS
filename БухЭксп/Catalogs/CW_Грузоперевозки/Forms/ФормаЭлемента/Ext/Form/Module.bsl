#Область Форма 

&НаКлиенте
Процедура СтраницыПриСменеСтраницы(Элемент, ТекущаяСтраница)
	
	Если (ТекущаяСтраница = Элементы.СтраницаФинансы) Тогда
		
		ВыполнитьДействие(_УФКС.СД("Грузоперевозки","сервер","/ФинансыОбновить"));
		
		Элементы.ФинансыДоходыГруппаВводНаОсновании.Доступность		= ФинансыДоходы.Количество() > 0	и Не ЗначениеЗаполнено(ДатаЗакрытия);
		Элементы.ФинансыРасходыГруппаВводНаОсновании.Доступность	= ФинансыРасходы.Количество() > 0 	и Не ЗначениеЗаполнено(ДатаЗакрытия);
		
	ИначеЕсли (ТекущаяСтраница = Элементы.СтраницаБюджет) Тогда
		
		ВыполнитьДействие(_УФКС.СД("Грузоперевозки","сервер","/БюджетОбновить"));
		
		//Сортировка бюджетов
		ВосстановитьСортировкуТаблицы("БюджетРасходы");
		ВосстановитьСортировкуТаблицы("БюджетДоходы");
		//Сортировка бюджетов
		
		//Использование количества
		УстановитьДоступностьОбновленияКоличестваНаСервере();
		//Использование количества
		
	ИначеЕсли (ТекущаяСтраница = Элементы.СтраницаДекларации) Тогда
		
		ВыполнитьДействие(_УФКС.СД("Грузоперевозки","сервер","/ДекларацииОбновить"));
		
	КонецЕсли; 
	
КонецПроцедуры  

#КонецОбласти 

#Область Реквизиты 

&НаКлиенте
Процедура ПредставлениеПриИзменении(Элемент)
	
	Если (ПроверятьНомерКонтейнера) Тогда 
		ВыполнитьДействие(_УФКС.СД("Грузоперевозки","сервер","/ПроверитьНомерКонтейнера"));
	КонецЕсли;
	
	Если ВыполнятьПоискОборудования И ИспользуетсяМониторингОборудования И ЗначениеЗаполнено(Объект.CW_Представление) Тогда
		
		ПодключитьОбработчикОжидания("ПроверитьНаличиеОборудования",0.1,Истина);
		
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура Форма_ПроверитьНомерГрузоперевозки(Команда)
	
	МассивДоступных = _МассивДоступных();
	Если МассивДоступных.Количество() <> 0 Тогда
		ПФ = Новый Структура("РежимВыбора,МассивДоступных",Истина,МассивДоступных);
		ОткрытьФорму("Обработка.CW_ЖурналГрузоперевозок.Форма.Форма",ПФ, ЭтаФорма,Истина,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	Иначе
		_УФК.ВывестиПредупреждение("Грузоперевозок со сходным представлением не найдено.");
	КонецЕсли; 
		
КонецПроцедуры

&НаСервере
Функция _МассивДоступных()
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ 
	               |	CW_Грузоперевозки.Ссылка
	               |ИЗ
	               |	Справочник.CW_Грузоперевозки КАК CW_Грузоперевозки
	               |ГДЕ
	               |	CW_Грузоперевозки.CW_Представление ПОДОБНО &Наименование
	               |	И CW_Грузоперевозки.Ссылка <> &Ссылка";

	Запрос.УстановитьПараметр("Наименование", СокрЛП(Объект.CW_Представление));
	Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка); 
	ТЗ = Запрос.Выполнить().Выгрузить();
	
	Возврат ТЗ.ВыгрузитьКолонку("Ссылка");
	
КонецФункции

&НаКлиенте
Процедура ДатаСделкиФПриИзменении(Элемент)
	
	Если (Объект.ДатаСделкиФ=Дата(1,1,1)) Тогда
		
		Объект.ДатаСделкиФ=ТекущаяДата();
		
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаказПриИзменении(Элемент)
	
	// проверяем, что заказ не заблокирован
	Если (_ЗаказЗаблокирован()) Тогда
		Объект.Заказ = Неопределено;
		ПоказатьПредупреждение(,"Заказ заблокирован.");
		Возврат;
	КонецЕсли; 
	
	// если по заказу утверждён бюджет, а мы подключаем к нему эту грузоперевозку - надо обновить данные утверждения бюджета из заказа
	ВыполнитьДействие(_уфкс.СД("Грузоперевозки","сервер","/БюджетИнициализация"));
	Если (Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаБюджет) Тогда
		ВыполнитьДействие(_уфкс.СД("Грузоперевозки","клиент","/БюджетОбновить"));
	КонецЕсли; 
	ВыполнитьДействие(_УФКС.СД("Грузоперевозки","сервер","/УправлениеЭлементамиФормы"));
	
	_ОбновитьПодсказкуКоманды();
	
	Если ИспользуютсяПараметрыВЗаказах и ЗначениеЗаполнено(Объект.Заказ) Тогда
		_ОбновитьСписокПараметровОтслеживаемогоОборудования();
		ОбновитьДеревоПараметров();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция _ЗаказЗаблокирован()
	// --- 
	
	Если (ПолучитьФункциональнуюОпцию("CW_ИспользованиеБлокировкиМониторинга")) Тогда
		Возврат(ЗначениеЗаполнено(CW_Мониторинг.ПолучитьДатуЗакрытияМониторинга(Объект.Заказ)));
	Иначе
		Возврат Ложь;
	КонецЕсли; 
	
	// --- 
КонецФункции
 

&НаКлиенте
Процедура ПерезаполнитьРеквизитыШапкиПоЗаказу(Команда)
	
	Если (ЗначениеЗаполнено(Объект.Заказ)) Тогда
		
		Режим = РежимДиалогаВопрос.ДаНет;
		Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаЗаполнитьГрузоперевозку", ЭтаФорма, Параметры);
		ПоказатьВопрос(Оповещение,"Заполнить грузоперевозку по текущему заказу? ", Режим, 0); 
		
	Иначе
		
		Режим = РежимДиалогаВопрос.ДаНет;
		Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаСформироватьЗаказ", ЭтаФорма, Параметры);
		ПоказатьВопрос(Оповещение,"Создать заказ на основании текущей грузоперевозки? ", Режим, 0); 
		
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура _ЗаполнитьГрузоперевозку()
	
	Результат = _ПерезаполнитьРеквизитыШапкиПоЗаказу();
	Если (_УФКС.ВыполненоУспешно(Результат)) Тогда
		
		ТребуетсяПерезаполнениеПараметровПоТипу = Ложь;
		Результат.Свойство("ТребуетсяПерезаполнениеПараметровПоТипу",ТребуетсяПерезаполнениеПараметровПоТипу);
		Если (ТребуетсяПерезаполнениеПараметровПоТипу = Истина) Тогда
			
			ДиалогЗаполненияПоТипу();
			
		Иначе
			
			ОбновитьДеревоПараметров();
			
		КонецЕсли; 
		
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияВопросаЗаполнитьГрузоперевозку(Результат, Параметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;
	
	_ЗаполнитьГрузоперевозку();  
	_ОбновитьПодсказкуКоманды();
	
	ЭтотОбъект.Модифицированность = Истина;

КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияВопросаСформироватьЗаказ(Результат, Параметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;
	
	_СоздатьЗаказНаСервере();
	_ОбновитьПодсказкуКоманды();
	
	ЭтотОбъект.Модифицированность = Истина;

КонецПроцедуры

&НаСервере
ФункциЯ _ПолучитьСтркутуруШапкиЗаказ()
	
	мдЗаказ = Метаданные.Справочники.CW_Заказы;
	
	СтруктураРеквизитов = Новый Структура;
	
	Для Каждого Реквизит из мдЗаказ.Реквизиты Цикл
		
		СтруктураРеквизитов.Вставить(Реквизит.Имя,Неопределено);
		
	КонецЦикла;
	
	ЗаполнитьЗначенияСвойств(СтруктураРеквизитов, Объект);
	
	Возврат СтруктураРеквизитов;
		
КонецФункции

&НаСервере
Процедура _СоздатьЗаказНаСервере()
	
	СтруктураШапкиЗаказа = _ПолучитьСтркутуруШапкиЗаказ();
	
	НовыйЗаказ = Справочники.CW_Заказы.СоздатьЭлемент();
	
	ЗаполнитьЗначенияСвойств(НовыйЗаказ, СтруктураШапкиЗаказа);
	
	НовыйЗаказ.Записать();
	
	Объект.Заказ = НовыйЗаказ.Ссылка;
	
	//Запишем стутасы
	МассивСсылок = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(НовыйЗаказ.Ссылка);
	
	CW_ЛогистическиеСтатусыСервер.РассчитатьЛогистическийСтатус(МассивСсылок);
	CW_ФинансовыеСтатусыСервер.РассчитатьФинансовыйСтатус(МассивСсылок);
	//Запишем стутасы
	
	
КонецПроцедуры


&НаСервере
Функция _ПерезаполнитьРеквизитыШапкиПоЗаказу()
	// --- 
	
	Ответ = _УФКС.Ответ();
	
	ТребуетсяПерезаполнениеПараметровПоТипу = (Объект.ТипПеревозки <> Объект.Заказ.ТипПеревозки И ЗначениеЗаполнено(Объект.Заказ.ТипПеревозки));
	// --- 
	Объект.ТипПеревозки = Объект.Заказ.ТипПеревозки;
	ИзмененКлиент = (Объект.Клиент <> Объект.Заказ.Клиент);
	Объект.Клиент = Объект.Заказ.Клиент;
	ИзмененМаршрут = (Объект.Маршрут <> Объект.Заказ.Маршрут);
	Объект.Маршрут = Объект.Заказ.Маршрут;
	ИзмененГруз = (Объект.Груз <> Объект.Заказ.Груз);
	Объект.Груз = Объект.Заказ.Груз;
	
	Если (ТребуетсяПерезаполнениеПараметровПоТипу) Тогда
		
		_ЗаполнитьПредопределенныеЗначенияПараметровДляРеквизита(Объект.ТипПеревозки, "ТипПеревозки");
		
	КонецЕсли; 
	Если (ИзмененКлиент) Тогда
		
		_ЗаполнитьПредопределенныеЗначенияПараметровДляРеквизита(Объект.Клиент, "Клиент");
		
	КонецЕсли; 
	Если (ИзмененМаршрут) Тогда
		
		_ЗаполнитьПредопределенныеЗначенияПараметровДляРеквизита(Объект.Маршрут, "Маршрут");
		
	КонецЕсли; 
	Если (ИзмененГруз) Тогда
		
		_ЗаполнитьПредопределенныеЗначенияПараметровДляРеквизита(Объект.Груз, "Груз");
		
	КонецЕсли; 
	
	Ответ.Вставить("ТребуетсяПерезаполнениеПараметровПоТипу",ТребуетсяПерезаполнениеПараметровПоТипу);
	Возврат(Ответ);
	
	// --- 
КонецФункции
 

