&НаКлиенте
Перем ПараметрТекущиейСтрокиДерева;

#Область СобытияФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	//Наличие прикрепленных файлов
	_УФКС.УстановитьНаличиеПрикрепленныхФайловПриСозданииФормыНаСервере(ЭтаФорма);
	//Наличие прикрепленных файлов
	
	Параметры.Свойство("НеРассчитыватьСтатусыПриЗаписи", НеРассчитыватьСтатусыПриЗаписи);
	
	ПоказыватьПриложениеВБюджете = ПолучитьФункциональнуюОпцию("CW_ВедетсяУчетПриложенийПоДоговорам") 
									И ПолучитьФункциональнуюОпцию("CW_УказыватьДоговорДляПлановыхСтатейБюджета");
									
	ГруппаПользователя = CW_ПраваДоступа_ПИ.ГруппаПользователя(ПараметрыСеанса.ТекущийПользователь);

	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("CW_Пользователь", 		ПараметрыСеанса.ТекущийПользователь);
	СтруктураПараметров.Вставить("CW_ГруппаПользователя", 	ГруппаПользователя);
	УстановитьПараметрыФункциональныхОпцийФормы(СтруктураПараметров);									
									
	Элементы.БюджетДоходыПриложениеКДоговору.Видимость = ПоказыватьПриложениеВБюджете;
	Элементы.БюджетРасходыПриложениеКДоговору.Видимость = ПоказыватьПриложениеВБюджете;
	
	НастрйкаОтображенияКолонкиКомментарий = ХранилищеСистемныхНастроек.Загрузить(ЭтаФорма.ИмяФормы,"ОтображенияКолонкиКомментарий");
	
	Если Не НастрйкаОтображенияКолонкиКомментарий = Неопределено Тогда
		НастрйкаОтображенияКолонкиКомментарий.Свойство("ПоказатьСкрытьКомментарий_Доходы", ПоказатьСкрытьКомментарий_Доходы);
		НастрйкаОтображенияКолонкиКомментарий.Свойство("ПоказатьСкрытьКомментарий_Расходы", ПоказатьСкрытьКомментарий_Расходы);
	КонецЕсли;
	
	// получим опции и права
	ИспользуетсяБлокировкаМониторинга 				= ПолучитьФункциональнуюОпцию("CW_ИспользованиеБлокировкиМониторинга");
	ВалютаРегламентированногоУчетаОтличнаОтРубля 	= НЕ ПолучитьФункциональнуюОпцию("CW_ВалютаРегламентированногоУчетаРубль");
	ИспользуетсяРеквизитКлиент 						= ПолучитьФункциональнуюОпцию("CW_ИспользованиеКлиент");
	ИспользуютсяПараметрыВЗаказах 					= ПолучитьФункциональнуюОпцию("CW_ИспользуютсяПараметрыВЗаказах");
	ИспользуетсяМониторингОборудования				= ПолучитьФункциональнуюОпцию("CW_ИспользованиеМониторингаОборудования");
	ВыполнятьПоискОборудования						= ПолучитьФункциональнуюОпцию("CW_ВыполнятьПоискОборудованияПриВводеПредставленияГрузоперевозки");
	АвтоматическиПодставлятьОборудование			= ПолучитьФункциональнуюОпцию("CW_АвтоматическиПодставлятьОборудованиеНаСлеженииВГрузоперевозку");
	
	Элементы.НадписьЗакрытие.Видимость 				= ПолучитьФункциональнуюОпцию("CW_ИспользованиеБлокировкиФинансов");   
	
	ОтображатьПараметрыЗаказаВГрузоперевозке 			= CW_Настройки.ПолучитьНастройкуПользователя(,"ОтображатьПараметрыЗаказаВГрузоперевозке");
	Элементы.ДПГПоказатьСкрытьПараметрыЗаказа.Пометка 	=  ОтображатьПараметрыЗаказаВГрузоперевозке;
	
	//Видимость отчета Ведомость перевыставления по ставкам    
	ИспользованиеСхемыПеревыставленияПоСтавкам = ПолучитьФункциональнуюОпцию("CW_ИспользованиеСхемыПеревыставленияПоСтавкам");
	ПросмотрФинансов = CW_ПраваДоступа.ПравоДоступно("ПросмотрФинансов", ПараметрыСеанса.ТекущийПользователь);
	Элементы.Отчет_ВедомостьПеревыставленияПоСтавкам.Видимость = ИспользованиеСхемыПеревыставленияПоСтавкам и ПросмотрФинансов;
	//КОНЕЦ   

	// выполним действия в зависимости от опций и прав 	
	Элементы.ГруппаБлокировкаМониторинга.Видимость 			= ИспользуетсяБлокировкаМониторинга И НЕ Объект.Ссылка.Пустая();
	Элементы.ИзменитьДатуБлокировкиГрузоперевозок.Видимость = (НЕ ЗначениеЗаполнено(Объект.Заказ));
	_ОбновитьСтатусБлокировкиМониторинга();
	
	ЭтоНовыйОбъект = Параметры.Ключ.Пустая();
	
	Основание = Неопределено;
	Параметры.Свойство("Основание",Основание);
	ВводНаОсновании = ЗначениеЗаполнено(Основание);
	
	Попытка
		Заявка = Параметры.ЗначенияЗаполнения.Заявка;
	Исключение
	    Заявка = Неопределено;
	КонецПопытки; 
	
	Если (Заявка <> Неопределено) Тогда
		ВводНаОсновании = Истина;
		ВводНаОснованииЗаявки = Истина;
	КонецЕсли; 
	
	Если (Объект.ГруппыПараметровГрузоперевозки.Количество()=0) Тогда
		
		НастоящийОбъект = РеквизитФормыВЗначение("Объект");
		НастоящийОбъект.ПроверитьИерархиюПараметров();
		ЗначениеВРеквизитФормы(НастоящийОбъект,"Объект");
		
	КонецЕсли; 
	
	// кэшируем свойства параметров
	_ОбновитьСвойстваПараметров();
	
	КартаСвойствПараметров = ПолучитьИзВременногоХранилища(АдресКартыСвойствПараметров);
	Если (_сф.ст_ПолучитьСвойство(Параметры, "ОчищатьФактическиеДаты")=Истина) Тогда
		Для каждого СтрокаПараметра Из Объект.ПараметрыГрузоперевозки Цикл
			СП = КартаСвойствПараметров.Получить(СтрокаПараметра.Параметр);
			Если (СП.ЭтоКонтрольнаяДата) Тогда
				СтрокаПараметра.ЗначениеФакт = Дата(1,1,1);
				СтрокаПараметра.Значение = СтрокаПараметра.ЗначениеПлан;
			КонецЕсли; 
		КонецЦикла; 
	КонецЕсли; 
	
	Если (ЗначениеЗаполнено(Объект.ОтслеживаемоеОборудование)) Тогда
		_ОбновитьСписокПараметровОтслеживаемогоОборудования();
	КонецЕсли; 
	
	//Подсистема.ЛогистическиеСтатусы
	ИспользоватьЛогистическиеСтатусыГрузоперевозок = ПолучитьФункциональнуюОпцию("CW_ИспользоватьЛогистическиеСтатусыГрузоперевозок");   
	Если ИспользоватьЛогистическиеСтатусыГрузоперевозок Тогда
	CW_ЛогистическиеСтатусыСервер.ПриСозданииНаСервере(ЭтаФорма, Отказ, СтандартнаяОбработка);
	КонецЕсли;
	//Подсистема.ЛогистическиеСтатусы
	
	//Подсистема.ФинансовыеСтатусы
	ИспользоватьФинансовыеСтатусыГрузоперевозок = ПолучитьФункциональнуюОпцию("CW_ИспользоватьФинансовыеСтатусыГрузоперевозок");
	Если ИспользоватьФинансовыеСтатусыГрузоперевозок Тогда
		CW_ФинансовыеСтатусыСервер.ПриСозданииНаСервере(ЭтаФорма, Отказ, СтандартнаяОбработка);
	КонецЕсли;
	//Подсистема.ФинансовыеСтатусы
	
	//РаботаСАрхивомОбъектов    
	CW_АрхивОбъектовСервер.ПриСозданииНаСервере(ЭтаФорма);
	//РаботаСАрхивомОбъектов  
	
	
	// выполнение действий при открытии формы
	#Область ОбластьИнициализацияФормы
	
		Инициализировать = Ложь;
		Если (НЕ Параметры.ЗначениеКопирования.Пустая()) Тогда
			
			Если Параметры.Ключ.Пустая() Тогда
				
				НастройкиПользователя = CW_Настройки.ПолучитьНастройкиПользователя(ПараметрыСеанса.ТекущийПользователь);
				
				Если НастройкиПользователя.ОчищатьПредставлениеГрузоперевозкиПриКопировании Тогда
					Объект.CW_Представление = "";
				КонецЕсли;
				
				Если НастройкиПользователя.УстанавливатьТекущуюДатуГрузоперевозкиПриКопировании Тогда
					Объект.ДатаСделкиФ = ТекущаяДата();
				КонецЕсли;
				
			КонецЕсли;
	
			ОбъектКопирования = Параметры.ЗначениеКопирования;
			Если (ПолучитьФункциональнуюОпцию("CW_ИспользованиеБюджетирования")) Тогда
				РежимКопирования = Истина;
				ВыполнитьДействиеНаСервере(_УФКС.СД("Грузоперевозки","сервер","/ОтборДокументовФинансовогоРезультата"));
			Иначе
				Инициализировать = Истина;
			КонецЕсли; 
		Иначе
			Инициализировать = Истина;
		КонецЕсли; 
		Если (Инициализировать) Тогда
			
			// логика, связанная с доступностью (видимостью) в зависимости от прав пользователя,
			// отрабатывается в этой процедуре
			ВыполнитьДействиеНаСервере(_УФКС.СД("Грузоперевозки","сервер","/ИнициализацияФормы"));
		КонецЕсли; 
	
	#КонецОбласти 
	
	Элементы.ПерезаполнитьРеквизитыШапкиПоЗаказу.Доступность = Не Элементы.ГруппаШапка.ТолькоПросмотр;
	
	// ---
	ЗагрузитьСеансовуюНастройкуДеклараций();
	// ---
	
	//Элементы.ФормаВнешниеДействия.Видимость = (_СписокДействий().Количество() <> 0);
	
	стНастроек = ХранилищеСистемныхНастроек.Загрузить("Грузоперевозки", "ОтображатьПостатейно");
	Если стНастроек <> Неопределено Тогда
		ФинансыДоходыОтображатьПостатейно  		= _сф.ст_ПолучитьСвойство(стНастроек, "ОтображатьПостатейно");
		ФинансыРасходыОтображатьПостатейно 		= _сф.ст_ПолучитьСвойство(стНастроек, "ОтображатьПостатейно");
		ФинансыТранспортОтображатьПостатейно 	= _сф.ст_ПолучитьСвойство(стНастроек, "ОтображатьПостатейно");
	КонецЕсли;	
	
	_ОбновитьПодсказкуКоманды();
	
	//Заполнение списка выбора элемента
	Если ВалютаРегламентированногоУчетаОтличнаОтРубля Тогда
		Элементы.ВыводФинрезультата.СписокВыбора.Очистить();
		Элементы.ВыводФинрезультата.СписокВыбора.Добавить(1, "По счетам");
		ОтображениеФинансовогоРезультата = 1;
	КонецЕсли;
	
	Если ЭтоНовыйОбъект Тогда
		
		//Времено на переходный период
		//Для новых объектов уже используется новый механизм хранения данных
		СлужебныйВыполненПереход = Истина;
		//Времено на переходный период
		
		Объект.Ответственный = ПараметрыСеанса.ТекущийПользователь;
		
		//Заполнение предопределенных параметров
		МассивИменРеквизитов = Новый Массив;
		МассивИменРеквизитов.Добавить("ТипПеревозки");
		МассивИменРеквизитов.Добавить("Типоразмер");
		МассивИменРеквизитов.Добавить("МенеджерПродаж");
		МассивИменРеквизитов.Добавить("ОперативныйМенеджер");
		МассивИменРеквизитов.Добавить("Клиент");
		МассивИменРеквизитов.Добавить("Маршрут");
		МассивИменРеквизитов.Добавить("Груз");
		
		Для Каждого РеквизитМассива из МассивИменРеквизитов Цикл
			Если ЗначениеЗаполнено(Объект[РеквизитМассива]) Тогда
				_ЗаполнитьПредопределенныеЗначенияПараметровДляРеквизита(Объект[РеквизитМассива],РеквизитМассива);
			КонецЕсли;
		КонецЦикла;
		
		Если ЗначениеЗаполнено(Объект.ТипПеревозки) Тогда
			_ЗаполнитьПараметрыПоТипуПеревозки(0);
			_УФС.ЗаполнитьПредопределенныеЗначенияРеквизитовШапки(Объект, Объект.ТипПеревозки, "ДляГрузоперевозки");
		КонецЕсли;
		
		_ОбновитьДеревоПараметров();
		ПересчитатьДинамическиеПараметры();
		
	КонецЕсли;
	
	Элементы.БюджетДоходыКомментарий.Видимость  = ПоказатьСкрытьКомментарий_Доходы;
	Элементы.БюджетРасходыКомментарий.Видимость = ПоказатьСкрытьКомментарий_Расходы;
	
	Элементы.БюджетРасходыПоказатьСкрытьКомментарий_Расходы.Пометка = ПоказатьСкрытьКомментарий_Расходы;
	Элементы.БюджетДоходыПоказатьСкрытьКомментарий_Доходы.Пометка 	= ПоказатьСкрытьКомментарий_Доходы;
	
	Элементы.БюджетРасходыСуммаРуб.Заголовок 		= "Сумма, "+?(ЗначениеЗаполнено(ВРУ),СокрЛП(ВРУ), "-");
	Элементы.БюджетРасходыСуммаВсегоРуб.Заголовок   = "Всего, "+?(ЗначениеЗаполнено(ВРУ),СокрЛП(ВРУ), "-");
	Элементы.БюджетДоходыСуммаРуб.Заголовок			= "Сумма, "+?(ЗначениеЗаполнено(ВРУ),СокрЛП(ВРУ), "-");
	Элементы.БюджетДоходыСуммаВсегоРуб.Заголовок	= "Всего, "+?(ЗначениеЗаполнено(ВРУ),СокрЛП(ВРУ), "-");
	
	
	Если ПолучитьФункциональнуюОпцию("CW_ИспользованиеБюджетирования") Тогда
		ДобавитьПодключаемыеКоманды();
	КонецЕсли;

	ЗаявкаПриИзмененииНаСервере();
	
	СтараяЗаявка = Объект.Заявка;
	СтарыйЗаказ  = Объект.Заказ;
	
	УстановитьПараметрыДинамическогоСписка();
	УстановитьИтогиДинамическогоСписка();   
	
	//Использование количества
	ИспользованиеКоличестваДляПлановыхСтатей 			= ПолучитьФункциональнуюОпцию("CW_ИспользованиеКоличестваДляПлановыхСтатей");
	ПолучениеКоличестваУслугИзПараметраГрузоперевозки 	= ПолучитьФункциональнуюОпцию("CW_РазрешитьПолучениеКоличестваУслугИзПараметраГрузоперевозки");

	Элементы.ОбновитьКоличествоРасходы.Видимость = ИспользованиеКоличестваДляПлановыхСтатей и ПолучениеКоличестваУслугИзПараметраГрузоперевозки; 
	Элементы.ОбновитьКоличествоДоходы.Видимость  = ИспользованиеКоличестваДляПлановыхСтатей и ПолучениеКоличестваУслугИзПараметраГрузоперевозки;
	//Использование количества   
	
	//ПрогнозОплаты
	ИспользуетсяПрогнозированиеДДСПоБюджету = 	ПолучитьФункциональнуюОпцию("CW_ИспользуетсяПрогнозированиеДДСПоБюджету");
	//ПрогнозОплаты    
	
	//Внешние подклчюаемые команды
	CW_ПодключаемыеКомандыСервер.ПриСозданииНаСервере(ЭтотОбъект);
	
	ДополнительныеСвойстваФормы = Новый Структура();               
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	//ХранениеПолногоЗначения
	Для Каждого СтрокаОбъекта из ТекущийОбъект.ПараметрыГрузоперевозки Цикл 
		ДобавитьСохраняемоеПолноеЗначение(СтрокаОбъекта.Параметр, СтрокаОбъекта.ХранилищеДанных.Получить());  
	КонецЦикла;
	//---ХранениеПолногоЗначения
	
КонецПроцедуры  

&НаСервере
Процедура УстановитьПараметрыДинамическогоСписка()
	
	ОтчетЭкспедитора.Параметры.УстановитьЗначениеПараметра("Грузоперевозка",Объект.Ссылка); 
	
КонецПроцедуры

&НаСервере
Процедура УстановитьИтогиДинамическогоСписка()
	
	СтруктураИтоговОтчетЭкспедитора = CW_БухгалтерияЭкспедитораСерверПереопределяемый.ИтогиДинамическогоСписка(ОтчетЭкспедитора, "КоличествоЗаписей");
	
	Элементы.СтраницаОтчетЭкспедитора.Заголовок = "Отчет экспедитора "+?(СтруктураИтоговОтчетЭкспедитора.КоличествоЗаписей = Null,	"",	" ("+СтруктураИтоговОтчетЭкспедитора.КоличествоЗаписей+")"); 
	
КонецПроцедуры

&наСервере
Процедура _ОбновитьПодсказкуКоманды()
	
	ЭтаФорма.Команды.ПерезаполнитьРеквизитыШапкиПоЗаказу.Подсказка = ?(ЗначениеЗаполнено(Объект.Заказ),"Перезаполнить реквизиты шапки по заказу","Создать заказ на основании грузоперевозки");
	
КонецПроцедуры

&НаСервере
Процедура _ОбновитьСвойстваПараметров()
	// --- 
	
	КартаПравПараметров = CW_ПраваДоступа.НаборПравДляПараметров();
	АдресКартыПравПараметров = ПоместитьВоВременноеХранилище(КартаПравПараметров, ЭтаФорма.УникальныйИдентификатор);
	// --- 
	КартаСвойствПараметров = CW_Мониторинг.ПолучитьСоответствиеСвойствПараметров();
	АдресКартыСвойствПараметров = ПоместитьВоВременноеХранилище(КартаСвойствПараметров, ЭтаФорма.УникальныйИдентификатор);
	
	// --- 
КонецПроцедуры
 

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	
	ПОВ_БазоваяЛогика = Новый ОписаниеОповещения("ПриОткрытииБазоваяЛогика",ЭтотОбъект);
	
	Если (РежимКопирования ИЛИ ВводНаОснованииЗаявки) Тогда
		
		Если (РежимКопирования) Тогда
			
			ПОВ_Отказ = Новый ОписаниеОповещения("ОбработкаКопированияОтказ",ЭтотОбъект);
			ПОВ_Обработка = Новый ОписаниеОповещения("ОбработкаКопированияГрузоперевозки",ЭтотОбъект,Новый Структура("ПОВ_БазоваяЛогика,ПОВ_Отказ",ПОВ_БазоваяЛогика,ПОВ_Отказ));
			// --- 
			ПФ = Новый Структура("ОбъектКопирования,УИД",ОбъектКопирования,ЭтаФорма.УникальныйИдентификатор);
			ОткрытьФорму("ОбщаяФорма.CW_ФормаКопированияАналитики",ПФ,,,,,ПОВ_Обработка,РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
			
		Иначе
			
			ПОВ = Новый ОписаниеОповещения("ОбработкаВопросаКопированияБюджетаПоЗаявке",ЭтотОбъект, Новый Структура()); 
			//ПоказатьВопрос(ПОВ,"Копировать бюджет?",РежимДиалогаВопрос.ДаНет); 
			ВыполнитьОбработкуОповещения(ПОВ,КодВозвратаДиалога.Нет); 
			
		КонецЕсли; 
		
				
	Иначе
		
		ВыполнитьОбработкуОповещения(ПОВ_БазоваяЛогика);
		
	КонецЕсли;
	
	//Если НЕ CW_Настройки.ПолучитьНастройкуПользователя( , "ВыводитьКурсПланирования") Тогда
	//	Элементы.БюджетДоходыКурс.Видимость = Ложь;
	//	//Элементы.БюджетДоходыПиктограммаКурса.Видимость = Ложь;
	//	Элементы.БюджетРасходыКурс.Видимость = Ложь;		
	//	//Элементы.БюджетРасходыПиктограммаКурса.Видимость = Ложь;
	//КонецЕсли;	
	
	ДПГ_ВосстановитьСостояниеСвертки();

	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаКопированияГрузоперевозки(Ответ,ДополнительныеПараметры) Экспорт
	// --- 
	
	Если (Ответ = Неопределено) Тогда
		
		ВыполнитьОбработкуОповещения(ДополнительныеПараметры.ПОВ_Отказ);
		Возврат;
		
	Иначе
		
		АдресНастроекКопирования = Ответ;
		Попытка    
			ЗаполнитьПараметрыПоНастройке(АдресНастроекКопирования);
			ВыполнитьДействие(_УФКС.СД("Грузоперевозки","сервер","/ИнициализацияФормы"));
			ЭтаФорма.Записать();
			
		Исключение
			Сообщить(ОписаниеОшибки());
			Отказ = Истина;
			Возврат;
		КонецПопытки; 
		
	КонецЕсли; 
	
	// --- 
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПараметрыПоНастройке(АдресНастроекКопирования)
	
	ПараметрыСоздания = ПолучитьИзВременногоХранилища(АдресНастроекКопирования);
	
	Если ПараметрыСоздания.СпособЗаполненияПараметровГрузоперевозкиПриКопировании = 0 Тогда
		   _ЗаполнитьПараметрыПоТипуПеревозки(1);
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаКопированияОтказ(Ответ,ДополнительныеПараметры) Экспорт
	// --- 
	
	ЭтаФорма.Закрыть();
	
	// --- 
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВопросаКопированияБюджетаПоЗаявке(Ответ, ДополнительныеПараметры) Экспорт 
	// --- 
	
	Если (Ответ <> Неопределено) Тогда
		
		Если (Ответ = КодВозвратаДиалога.Да) Тогда
			
			Если Не БюджетЗаявкиВалиден() тогда
				ОписаниеОповещения = Новый ОписаниеОповещения("ОбработкаВалидностиБюджета",ЭтотОбъект); 
				ПоказатьВопрос(ОписаниеОповещения,"Бюджет заявки просрочен. Копировать бюджет?",РежимДиалогаВопрос.ДаНет);
			Иначе
				КопироватьБюджетЗаявки = Истина;
			КонецЕсли;
			
		КонецЕсли; 
		
	КонецЕсли; 
	ПриОткрытииБазоваяЛогика(Истина,Неопределено);
	
	// --- 
КонецПроцедуры

&наСервере
Функция БюджетЗаявкиВалиден()
	
	СрокДействияБюджета = Объект.Заявка.ВариантБюджета.СрокДействия;
	
	Возврат	СрокДействияБюджета >= НачалоДня(ТекущаяДата()) или Не ЗначениеЗаполнено(СрокДействияБюджета);
	
КонецФункции

&НаКлиенте
Процедура ОбработкаВалидностиБюджета(Ответ,ДополнительныеПараметры) Экспорт
	
	Если (Ответ <> Неопределено) Тогда
		Если (Ответ = КодВозвратаДиалога.Да) Тогда
			КопироватьБюджетЗаявки = Истина;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры


&НаКлиенте
Процедура ПриОткрытииБазоваяЛогика(Ответ,ДополнительныеПараметры) Экспорт
	
	//// формируем дерево
	ОбновитьДеревоПараметров();
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	СеансовыеНастройки = Новый Структура("ФинансыРасходыОтображатьПостатейно,ФинансыТранспортОтображатьПостатейно,ФинансыДоходыОтображатьПостатейно",ФинансыРасходыОтображатьПостатейно,ФинансыТранспортОтображатьПостатейно, ФинансыДоходыОтображатьПостатейно);
	_УФС.СохранитьСеансовыеНастройки(ЭтаФорма,,СеансовыеНастройки);
	// --- 
	_сф.ст_УстановитьСвойство(ТекущийОбъект.ДополнительныеСвойства,"ИнтерактивныйРежим", Истина);
	// --- 
	Если (ТекущийОбъект.Ссылка.Пустая() И ЗначениеЗаполнено(ТекущийОбъект.Заявка) И ВводНаОсновании) Тогда
		_сф.ст_УстановитьСвойство(ТекущийОбъект.ДополнительныеСвойства,"ПеренестиБюджетИзЗаявки",КопироватьБюджетЗаявки);
	КонецЕсли; 
	// --- 
	Если (АдресНастроекКопирования <> "") Тогда
		
		_сф.ст_УстановитьСвойство(ТекущийОбъект.ДополнительныеСвойства,"АдресНастроекКопирования",АдресНастроекКопирования);
		
	КонецЕсли; 
	
	Если Не ИспользуетсяРеквизитКлиент тогда
		
		ПараметрПлательщика = Константы.CW_ПараметрПлательщика.Получить();
		
		Если ЗначениеЗаполнено(ПараметрПлательщика) Тогда
			
			СтрокаПараметра = CW_Мониторинг.СтрокаПараметра(ТекущийОбъект, ПараметрПлательщика);
			Если Не СтрокаПараметра = Неопределено Тогда
				ТекущийОбъект.Клиент = СтрокаПараметра.Значение;
			КонецЕсли; 
			
		КонецЕсли;
		
	КонецЕсли;
	
	//Запись данных харнилища занчений по строкам 
	Для Каждого ЭлементСписка из СписокАдресовЗначенийПараметров Цикл
		
		//ДанныеПоАдресу - тип "Структура("Параметр, ТаблицаДанных")
		ДанныеПоАдресу = ЭлементСписка.Значение;
		
		Отбор = Новый Структура("Параметр", ДанныеПоАдресу.Параметр);
		мСтроки = ТекущийОбъект.ПараметрыГрузоперевозки.НайтиСтроки(Отбор);
		Если мСтроки.Количество() > 0 Тогда
			//Предполагаем что строка будет только одна
			СтрокаДанных = мСтроки[0]; 
			Если ТипЗНЧ(ДанныеПоАдресу.ДанныеДляХранения) = Тип("ДанныеФормыКоллекция") Тогда
				СтрокаДанных.ХранилищеДанных = новый ХранилищеЗначения(ДанныеПоАдресу.ДанныеДляХранения.Выгрузить());	
			Иначе
				СтрокаДанных.ХранилищеДанных = новый ХранилищеЗначения(ДанныеПоАдресу.ДанныеДляХранения);	
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;  
	
	//ХранениеПолногоЗначения 
	Если ТипЗнч(СохраняемоеПолноеЗначение) = Тип("ФиксированноеСоответствие") Тогда 
		Для Каждого КлючЗначение из СохраняемоеПолноеЗначение Цикл
			Отбор = Новый Структура("Параметр", КлючЗначение.Ключ);
			НайденныеСтроки = ТекущийОбъект.ПараметрыГрузоперевозки.НайтиСтроки(Отбор);
			Если НайденныеСтроки.Количество() > 0 Тогда
				//Предполагаем что строка будет только одна
				СтрокаДанных = НайденныеСтроки[0];   
				СтрокаДанных.ХранилищеДанных = новый ХранилищеЗначения(КлючЗначение.Значение);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	//---ХранениеПолногоЗначения
	
	
	//Перенесем ДополнительныеСвойстваФормы в ДополнительныеСвойства объекта
	Для Каждого Свойство Из ДополнительныеСвойстваФормы Цикл
		_сф.ст_УстановитьСвойство(ТекущийОбъект.ДополнительныеСвойства,Свойство.Ключ,Свойство.Значение);               			
	КонецЦикла; 
	
	ТекущийОбъект.ДополнительныеСвойства.Вставить("СтараяЗаявка", 	СтараяЗаявка);
	ТекущийОбъект.ДополнительныеСвойства.Вставить("СтарыйЗаказ", 	СтарыйЗаказ);

КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	МассивСсылок = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Объект.Ссылка);
	
	//Подсистема.ЛогистическиеСтатусы
	CW_ЛогистическиеСтатусыСервер.РассчитатьЛогистическийСтатус(МассивСсылок);
	CW_ЛогистическиеСтатусыСервер.ПослеЗаписиНаСервере(ЭтаФорма);
	//Подсистема.ЛогистическиеСтатусы
	
	//Подсистема.ФинансовыеСтатусы
	CW_ФинансовыеСтатусыСервер.РассчитатьФинансовыйСтатус(МассивСсылок);
	CW_ФинансовыеСтатусыСервер.ПослеЗаписиНаСервере(ЭтаФорма);
	//Подсистема.ФинансовыеСтатусы   
	
	//ПрогнозОплаты
	Если ИспользуетсяПрогнозированиеДДСПоБюджету Тогда
		CW_Бюджетирование.РассчитатьПрогнозОплаты(Объект.Ссылка);
	КонецЕсли;
	//ПрогнозОплаты

	Если (ЗначениеЗаполнено(объект.Заказ)) Тогда
		Справочники.CW_Заказы.ПроверитьСоответствиеРеквизитов(объект.Заказ);	
	КонецЕсли; 
	АдресНастроекКопирования = _сф.ст_ПолучитьСвойство(ТекущийОбъект.ДополнительныеСвойства,"АдресНастроекКопирования");
	Если (ЭтоНовыйОбъект) Тогда
		
		Если (ПолучитьФункциональнуюОпцию("CW_ИспользованиеСхемыПеревыставленияПоСтавкам")) Тогда
			ВыполнитьДействиеНаСервере(_УФКС.СД("Грузоперевозки","сервер","/ОтборДокументовФинансовогоРезультата"));	
		КонецЕсли; 
		Если (ПолучитьФункциональнуюОпцию("CW_ИспользованиеМеханизмаСвязейГрузоперевозок")) Тогда
			ВыполнитьДействиеНаСервере(_УФКС.СД("Грузоперевозки","сервер","/ОтборСвязей"));	
		КонецЕсли; 
		ВыполнитьДействиеНаСервере(_УФКС.СД("Грузоперевозки","сервер","/УправлениеЭлементамиФормы"));
		// --- 
		ЭтоНовыйОбъект = Ложь;
		
	КонецЕсли; 
	// ---
	//ВыполнитьДействиеНаСервере(_УФКС.СД("Грузоперевозки","сервер","/Заголовок"));
	
	//РаботаСАрхивомОбъектов
	CW_АрхивОбъектовСервер.ПослеЗаписиНаСервере(ЭтаФорма);
	//РаботаСАрхивомОбъектов

	ДополнительныеСвойстваФормы = Новый Структура();               

КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	Если (НЕ ЗакрытиеФормы) Тогда
		ОбновитьДеревоПараметров();
		
		СтараяЗаявка = Объект.Заявка;
		СтарыйЗаказ  = Объект.Заказ;
		
	Иначе
		ЗакрытиеФормы = Ложь;
	КонецЕсли; 
	
	ОповеститьОЗаписиНового(Объект.Ссылка);
	Оповестить("ЗаписьСправочника",Объект.Ссылка,"Справочник.CW_Грузоперевозки");
	Оповестить("Запись_CW_Грузоперевозки", Новый Структура("Объект",Объект.Ссылка), "Справочник.CW_Грузоперевозки");

	ВыполнитьДействие(_УФКС.СД("Грузоперевозки","сервер","/ПраваДоступа"));
	
КонецПроцедуры


&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	Если Не ЗавершениеРаботы Тогда
		СтруктураНастройки = Новый Структура;
		СтруктураНастройки.Вставить("ПоказатьСкрытьКомментарий_Доходы"	, ПоказатьСкрытьКомментарий_Доходы);
		СтруктураНастройки.Вставить("ПоказатьСкрытьКомментарий_Расходы"	, ПоказатьСкрытьКомментарий_Расходы);
		СохранитьНастройкиНаСервере(ЭтаФорма.ИмяФормы, СтруктураНастройки);
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура СохранитьНастройкиНаСервере(ИмяТекущейФормы, СтруктураНастройки)
	
	ХранилищеСистемныхНастроек.Сохранить(ИмяТекущейФормы,"ОтображенияКолонкиКомментарий", СтруктураНастройки);
	
КонецПроцедуры

