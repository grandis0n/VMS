Функция ПолучитьОборудованиеПоНаименованию(ПредставлениеОборудования)
	Возврат Справочники.CW_Оборудование.ПолучитьОборудованиеПоНаименованию(ПредставлениеОборудования);
КонецФункции

&НаСервере
Функция ПроверитьОборудованиенаСлежении(ПредставлениеОборудования)

	Оборудование = ПолучитьОборудованиеПоНаименованию(ПредставлениеОборудования);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	CW_ОтслеживаемоеОборудование.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.CW_ОтслеживаемоеОборудование КАК CW_ОтслеживаемоеОборудование
	               |ГДЕ
	               |	CW_ОтслеживаемоеОборудование.Оборудование = &Оборудование
	               |	И ВЫБОР
	               |			КОГДА CW_ОтслеживаемоеОборудование.ОкончаниеСлежения = ДАТАВРЕМЯ(1, 1, 1)
	               |				ТОГДА &ДатаПеревозки >= НАЧАЛОПЕРИОДА(CW_ОтслеживаемоеОборудование.НачалоСлежения, ДЕНЬ)
	               |			ИНАЧЕ &ДатаПеревозки МЕЖДУ НАЧАЛОПЕРИОДА(CW_ОтслеживаемоеОборудование.НачалоСлежения, ДЕНЬ) И КОНЕЦПЕРИОДА(CW_ОтслеживаемоеОборудование.ОкончаниеСлежения, ДЕНЬ)
	               |		КОНЕЦ";
	
	Запрос.УстановитьПараметр("Оборудование", 	Оборудование);
	Запрос.УстановитьПараметр("ДатаПеревозки", 	Объект.ДатаСделкиФ); 
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Если Выборка.Количество() > 1 Тогда
		Возврат ложь;
	КонецЕсли;
	
	Если Выборка.Следующий() Тогда
		Объект.ОтслеживаемоеОборудование = Выборка.Ссылка;
	КонецЕсли;  
	
	Возврат истина;

КонецФункции

&НаКлиенте
Процедура ОткрытьФормуОтслеживаемогоОборудования()
	
	ОборудованиеДляОтбора = ПолучитьОборудованиеПоНаименованию(Объект.CW_Представление);
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("РежимВыбора",				Истина);
	СтруктураПараметров.Вставить("МножественныйВыбор",		Ложь);
	СтруктураПараметров.Вставить("ДатаПроверки",			Объект.ДатаСделкиФ);
	СтруктураПараметров.Вставить("ОборудованиеДляОтбора",	ОборудованиеДляОтбора);
	
	Оповещение = Новый ОписаниеОповещения("ОбработкаПривязкиОборудования",ЭтотОбъект); 
	
	ОткрытьФорму("Справочник.CW_ОтслеживаемоеОборудование.ФормаВыбора", СтруктураПараметров,ЭтаФорма,Истина,,,Оповещение,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры


&НаКлиенте
Процедура ОбработкаПривязкиОборудования(Ответ, ДополнительныеПараметры) Экспорт 
	// --- 
	
	Если Ответ <> Неопределено Тогда
		Модифицированность = Истина; 
		
		ОбработкаПривязкиОборудованияНаСервере(Ответ);
		
		
		ВыполнитьДействие(_УФКС.СД("Грузоперевозки","сервер","/УправлениеЭлементамиФормы"));
		
		ОбновитьДеревоПараметров();
		
	КонецЕсли; 
	
	// --- 
КонецПроцедуры  

&НаСервере
Процедура ОбработкаПривязкиОборудованияНаСервере(Ответ)
	
	ОбработатьОтветПривязкиОбороудованияНаСервере(Ответ.ОбъектСлежения);
	
КонецПроцедуры

&НаСервере
Процедура ОбработатьОтветПривязкиОбороудованияНаСервере(ОбъектСлежения)
	
	Объект.ОтслеживаемоеОборудование = ОбъектСлежения;
	
	_ОбновитьСписокПараметровОтслеживаемогоОборудования();
	_ОбработатьПривязкуОборудования();
	
	Если Не ЗначениеЗаполнено(Объект.CW_Представление) Тогда
		Объект.CW_Представление =  ОбъектСлежения.Оборудование;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура _ОбработатьПривязкуОборудования()
	// --- 
	
	// проверяем и заполняем типоразмер
	Если (Объект.ОтслеживаемоеОборудование.Оборудование.ВидПеревозки = Перечисления.CW_ВидыПеревозок.Контейнер) Тогда
		
		Объект.Типоразмер = Объект.ОтслеживаемоеОборудование.Оборудование.Типоразмер;
		
	КонецЕсли; 
	
	// добавляем и заполняем параметры	
	Отбор = Новый Структура;
	Отбор.Вставить("ДобавлятьВКарточку", Истина);
	
	мСтроки = Объект.ОтслеживаемоеОборудование.ПараметрыГрузоперевозки.НайтиСтроки(Отбор);
	Для каждого СтрокаМассива из мСтроки Цикл
		
		Отбор = Новый Структура;
		Отбор.Вставить("Параметр", СтрокаМассива.Параметр);
		
		мСтроки = Объект.ПараметрыГрузоперевозки.НайтиСтроки(Отбор);
		Если мСтроки.Количество() <> 0 Тогда
			НоваяСтрока = мСтроки[0];  //Всегда одна строка
		Иначе
			НоваяСтрока = Объект.ПараметрыГрузоперевозки.Добавить();
			НоваяСтрока.Параметр	= СтрокаМассива.Параметр;
		КонецЕсли;
		
		НоваяСтрока.Значение	= СтрокаМассива.Значение;
		НоваяСтрока.Примечание 	= СтрокаМассива.Примечание;
		
		//ХранениеПолногоЗначения
		ДобавитьСохраняемоеПолноеЗначение(СтрокаМассива.Параметр, СтрокаМассива.Значение);
		//---ХранениеПолногоЗначения
		
	КонецЦикла;
	// добавляем и заполняем параметры	
	
	
КонецПроцедуры

&НаКлиенте
Процедура ОтслеживаемоеОборудованиеОчистка(Элемент, СтандартнаяОбработка)
	
	ОчиститьПараметрыОборудования();

	ВыполнитьДействие(_УФКС.СД("Грузоперевозки","сервер","/УправлениеЭлементамиФормы"));
	ОбновитьДеревоПараметров();
	
КонецПроцедуры

&НаКлиенте
Процедура ОтслеживаемоеОборудованиеОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ДополонительныеПараметры = Новый Структура;
	ДополонительныеПараметры.Вставить("ВыбранноеЗначение", ВыбранноеЗначение);
	
	Оповещение = Новый ОписаниеОповещения("ПродолжитьВыборОборудования", ЭтотОбъект, ДополонительныеПараметры);

	Если Не ДатаПеревозкиВПериодеСлежения(ВыбранноеЗначение, Объект.ДатаСделкиФ) Тогда
		Режим = РежимДиалогаВопрос.ДаНет;
		ПоказатьВопрос(Оповещение, "Дата грузоперевозки находится за пределами периода слежения выбранного оборудования. Продолжить?", Режим, 0);
	Иначе
		 ВыполнитьОбработкуОповещения(Оповещение, КодВозвратаДиалога.Да);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПродолжитьВыборОборудования(Результат, Параметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Нет Тогда
		Объект.ОтслеживаемоеОборудование = ПредопределенноеЗначение("Справочник.CW_ОтслеживаемоеОборудование.ПустаяСсылка");
	Иначе
		Объект.ОтслеживаемоеОборудование = Параметры.ВыбранноеЗначение;
	КонецЕсли;
	
	ОчиститьПараметрыОборудования();
	
	ОбработатьОтветПривязкиОбороудованияНаСервере(Объект.ОтслеживаемоеОборудование);
	ВыполнитьДействие(_УФКС.СД("Грузоперевозки","сервер","/УправлениеЭлементамиФормы"));
	ОбновитьДеревоПараметров();

КонецПроцедуры

&НаСервереБезКонтекста
Функция ДатаПеревозкиВПериодеСлежения(ВыбранноеЗначение, ДатаПеревозки)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	CW_ОтслеживаемоеОборудование.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.CW_ОтслеживаемоеОборудование КАК CW_ОтслеживаемоеОборудование
	               |ГДЕ
	               |	CW_ОтслеживаемоеОборудование.Ссылка = &ВыбранноеЗначение
	               |	И &ДатаПеревозки МЕЖДУ CW_ОтслеживаемоеОборудование.НачалоСлежения И ВЫБОР
	               |			КОГДА CW_ОтслеживаемоеОборудование.ОкончаниеСлежения = ДАТАВРЕМЯ(1, 1, 1)
	               |				ТОГДА КОНЕЦПЕРИОДА(&ДатаПеревозки, ДЕНЬ)
	               |			ИНАЧЕ КОНЕЦПЕРИОДА(CW_ОтслеживаемоеОборудование.ОкончаниеСлежения, ДЕНЬ)
	               |		КОНЕЦ";
	
	Запрос.УстановитьПараметр("ДатаПеревозки", ДатаПеревозки);
	Запрос.УстановитьПараметр("ВыбранноеЗначение", ВыбранноеЗначение);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат Не РезультатЗапроса.Пустой();
	
КонецФункции

&НаКлиенте
Процедура ОчиститьПараметрыОборудования()
	
	МассивСтрок = Новый Массив;
	ЭлементыДерева = ДПГ.ПолучитьЭлементы();
	ПолучитьСтрокиПоОборудованиюДляУдаления(ЭлементыДерева, МассивСтрок);
	
	Для Каждого ИдентификаторСтроки из МассивСтрок Цикл
		УдалитьСтрокуДерева(ИдентификаторСтроки);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьСтрокиПоОборудованиюДляУдаления(ЭлементыДерева, МассивСтрок)
	
	Для Каждого СтрокаДерева из ЭлементыДерева Цикл
		Если СтрокаДерева.ЭтоГруппа Тогда
			Если СтрокаДерева.НаименованиеГруппы = "Оборудование на слежении" Тогда
				МассивСтрок.Добавить(СтрокаДерева.ПолучитьИдентификатор());
			Иначе
				ПолучитьСтрокиПоОборудованиюДляУдаления(СтрокаДерева.ПолучитьЭлементы(), МассивСтрок);
			КонецЕсли;
		ИначеЕсли СтрокаДерева.ПараметрОборудования Тогда
			МассивСтрок.Добавить(СтрокаДерева.ПолучитьИдентификатор());
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

