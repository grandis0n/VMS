&НаКлиенте
Процедура ФинансыДоходыВвестиНаОснованииРасходыПоГрузоперевозке(Команда)
	
	Если Элементы.ФинансыДоходы.ВыделенныеСтроки.Количество() > 1 Тогда
		ПоказатьПредупреждение(,"Для ввода на основании необходимо выбрать один документ!");
		Возврат;
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("КомандаИмя",  "/ФинансыРасходыОбновить");  
	ОписаниеОповещенияПриЗакрытииФормы = Новый ОписаниеОповещения("ОбновитьТаблицуФинансы", ЭтотОбъект, ДополнительныеПараметры);
	
	СсылкаДокументОснование = ПолучитьСсылкуНаДокумент("ФинансыДоходы", Элементы.ФинансыДоходы.ТекущаяСтрока);
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ЗначенияЗаполнения", СсылкаДокументОснование);
	ПараметрыФормы.Вставить("Основание"			, СсылкаДокументОснование);
	
	ОткрытьФорму("Документ.CW_РасходыПоГрузоперевозке.ФормаОбъекта", ПараметрыФормы, ЭтаФорма,,,,ОписаниеОповещенияПриЗакрытииФормы);
	
КонецПроцедуры


&НаКлиенте
Процедура ФинансыРасходыВвестиНаОснованииРасходыПоГрузоперевозке(Команда)
	
	Если Элементы.ФинансыРасходы.ВыделенныеСтроки.Количество() > 1 Тогда
		ПоказатьПредупреждение(,"Для ввода на основании необходимо выбрать один документ!");
		Возврат;
	КонецЕсли;
	
	СсылкаДокументОснование	= ПолучитьСсылкуНаДокумент("ФинансыРасходы", Элементы.ФинансыРасходы.ТекущаяСтрока);
	
	СтруктураОснования = Новый Структура("ПредъявленСчет,ПредъявленАкт,ПредъявленСФ");
	ПолучитьДанныеДляВводаНаОсновании(СтруктураОснования, СсылкаДокументОснование) ;

	Если СтруктураОснования.ПредъявленСчет И 
		НЕ (СтруктураОснования.ПредъявленАкт ИЛИ СтруктураОснования.ПредъявленСФ) тогда
		
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("КомандаИмя",  "/ФинансыРасходыОбновить");
		ОписаниеОповещенияПриЗакрытииФормы = Новый ОписаниеОповещения("ОбновитьТаблицуФинансы", ЭтотОбъект, ДополнительныеПараметры);
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("ЗначенияЗаполнения", СсылкаДокументОснование);
		ПараметрыФормы.Вставить("Основание"			, СсылкаДокументОснование);
		
		ОткрытьФорму("Документ.CW_РасходыПоГрузоперевозке.ФормаОбъекта", ПараметрыФормы, ЭтаФорма,,,,ОписаниеОповещенияПриЗакрытииФормы);
		
	Иначе
		ПоказатьПредупреждение(,"Ввод документ ""Расходы по грузоперевозке"" возможен только для документа с признаком ""Счет""");
	конецЕсли;
	
КонецПроцедуры


