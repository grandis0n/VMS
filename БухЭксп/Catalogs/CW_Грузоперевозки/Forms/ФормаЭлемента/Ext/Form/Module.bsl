&НаКлиенте
Процедура Отчет_ВедомостьПеревыставленияПоСтавкам(Команда) 
	
	ПараметрыОтчета = Новый Структура;
	ПараметрыОтчета.Вставить("НачалоПериода", 	Дата(1,1,1));
	ПараметрыОтчета.Вставить("КонецПериода", 	ТекущаяДата());  
	
	МассивГруппировок = Новый Массив;
	МассивГруппировок.Добавить("Контрагент");
	МассивГруппировок.Добавить("Договор");
	МассивГруппировок.Добавить("Грузоперевозка");
	
	ПараметрыФормы = новый Структура;
	ПараметрыФормы.Вставить("ВнешнийВызов", 	Истина);
	ПараметрыФормы.Вставить("Параметры", 		ПараметрыОтчета);
	ПараметрыФормы.Вставить("Группировки", 		МассивГруппировок);
	
	ПараметрыФормы.Вставить("Отбор", Новый Структура("Грузоперевозка", Объект.Ссылка));
	
	ОткрытьФорму("Отчет.CW_ВедомостьПеревыставленияПоСтавкам.Форма", ПараметрыФормы, ЭтаФорма);

КонецПроцедуры


