&НаКлиенте
Процедура ОбработкаВыбораГрузоперевозкиСвязи(Ответ, ДополнительныеПараметры) Экспорт 
	// --- 
	
	Если (Ответ <> Неопределено) Тогда
		
		Если (ДополнительныеПараметры.Режим = "Ведущие") Тогда
			
			Результат = _ДобавитьВедущуюГП(Ответ);
			Если (_УФКС.ВыполненоУспешно(Результат)) Тогда
				Элементы.ВедущиеГрузоперевозки.Обновить();
			Иначе
				ПоказатьПредупреждение(,_УФКС.ПредставлениеОшибки(Результат));
			КонецЕсли; 
			
		КонецЕсли; 
		// --- 
		Если (ДополнительныеПараметры.Режим = "Ведомые") Тогда
			
			Результат = _ДобавитьВедомуюГП(Ответ);
			Если (_УФКС.ВыполненоУспешно(Результат)) Тогда
				Элементы.ВедомыеГрузоперевозки.Обновить();
			Иначе
				ПоказатьПредупреждение(,_УФКС.ПредставлениеОшибки(Результат));
			КонецЕсли; 
			
		КонецЕсли; 
		
	КонецЕсли; 
	
	// --- 
КонецПроцедуры

&НаСервере
Функция _ДобавитьВедущуюГП(Грузоперевозка)
	// --- 
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	CW_СвязиГрузоперевозок.Грузоперевозка
	|ИЗ
	|	РегистрСведений.CW_СвязиГрузоперевозок КАК CW_СвязиГрузоперевозок
	|ГДЕ
	|	CW_СвязиГрузоперевозок.Грузоперевозка = &Грузоперевозка
	|	И CW_СвязиГрузоперевозок.ГрузоперевозкаРодитель = &ГрузоперевозкаРодитель";
	Запрос.УстановитьПараметр("ГрузоперевозкаРодитель", Грузоперевозка);
	Запрос.УстановитьПараметр("Грузоперевозка", Объект.Ссылка); 
	ТЗ = Запрос.Выполнить().Выгрузить();
	Если (ТЗ.Количество() <> 0) Тогда
		
		Возврат(_УФКС.Ответ(1,"Грузоперевозка уже добавлена."));
		
	Иначе
		
		Запись = РегистрыСведений.CW_СвязиГрузоперевозок.СоздатьМенеджерЗаписи();
		Запись.Грузоперевозка = Объект.Ссылка;
		Запись.ГрузоперевозкаРодитель = Грузоперевозка;
		Запись.Записать(Истина);
		// --- 
		Возврат(_УФКС.Ответ());
		
	КонецЕсли; 
	
	// --- 
КонецФункции
 
