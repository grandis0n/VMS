	Если НЕ ЗначениеЗаполнено(Объект.ОтслеживаемоеОборудование) Тогда
		
		// проверяем наличие оборудования с одинаковым представлением
		Если ПолучитьНаличиеОборудования(Объект.CW_Представление) Тогда
			
			Если Не АвтоматическиПодставлятьОборудование 
				или Не ПроверитьОборудованиенаСлежении(Объект.CW_Представление)  Тогда
				
				// задаем вопрос
				ПОВ = Новый ОписаниеОповещения("ОбработкаВопросаПостановкиНаСлежение",ЭтотОбъект, Новый Структура()); 
				ПоказатьВопрос(ПОВ,"Введённое представление соответствует оборудованию на слежении. Поставить грузоперевозку на слежение?",РежимДиалогаВопрос.ДаНет,,,"Мониторинг оборудования");
				
			КонецЕсли;
			
		КонецЕсли; 
		
	КонецЕсли;
	
