&НаКлиенте
Процедура ДПГ_ПерезаполнитьПараметрыПоШаблону(Команда)
	
	ДиалогЗаполненияПоТипу();
	
КонецПроцедуры

&НаКлиенте
Процедура ДиалогЗаполненияПоТипу()
	// --- 
	
	Если (ЗначениеЗаполнено(Объект.ТипПеревозки)) Тогда
		
		Если (Объект.ПараметрыГрузоперевозки.Количество() <> 0) Тогда
			
			ПОВ = Новый ОписаниеОповещения("ОбработкаВыбораВариантаЗаполненияПоТипу",ЭтотОбъект);
			ОткрытьФорму("Справочник.CW_Грузоперевозки.Форма.ФормаЗаполненияПоТипуПеревозки",,,,,,ПОВ, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
			
		Иначе
			
			ЗаполнитьПараметрыПоТипуПеревозки(0);
			
		КонецЕсли; 

	КонецЕсли; 
	
	// --- 
КонецПроцедуры
  

&НаКлиенте
Процедура ОбработкаВыбораВариантаЗаполненияПоТипу(Ответ, ДополнительныеПараметры) Экспорт 
	
	Если (Ответ <> Неопределено) Тогда
		ЗаполнитьПараметрыПоТипуПеревозки(Ответ);
	КонецЕсли; 
	
КонецПроцедуры

