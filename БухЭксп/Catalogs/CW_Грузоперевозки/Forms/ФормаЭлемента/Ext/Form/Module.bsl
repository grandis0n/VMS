//Суммирование значений колонок
&НаКлиенте
Процедура СуммаПоВыделеннымСтрокам(Команда)

	ИмяТаблицы 		= Этаформа.ТекущийЭлемент.Имя;   
	
	// если имя текущего элемента не удается найти на форме	
	Попытка
 		ТаблицаФормы 	= Этаформа[ИмяТаблицы];   
	Исключение
		Возврат;	
	КонецПопытки;  
	
	Если Элементы[ИмяТаблицы].ВыделенныеСтроки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Если ТипЗнч(ТаблицаФормы) = Тип("ДинамическийСписок") Тогда    
		СтркутраПараметров = ПолучитьСтруктуруИтоговДинамическогоСпискаНаСервере(ИмяТаблицы);	 
	Иначе
		СтркутраПараметров = CW_Грузоперевозки_Клиент.ПолучитьСтруктуруИтоговТаблицыФормы(Этаформа, ИмяТаблицы);	 
	КонецЕсли;  
	
	CW_Грузоперевозки_Клиент.ОткрытьФормуВычисленияЗначений(СтркутраПараметров, ЭтаФорма);
	
КонецПроцедуры    

