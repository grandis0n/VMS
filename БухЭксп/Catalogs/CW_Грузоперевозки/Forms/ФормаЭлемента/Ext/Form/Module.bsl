&НаСервере
Функция _ЗаполнитьПредопределенныеЗначенияПараметровДляРеквизита(Реквизит, ИмяРеквизита)
	// --- 
	
	СП = ПолучитьПредопределенныеПараметры(Реквизит, ИмяРеквизита);
	Если (_УФКС.ВыполненоУспешно(СП)) Тогда
		Результат = ДобавитьПредопределенныеПараметры(СП.Параметры);
		Если (_УФКС.ВыполненоУспешно(Результат)) Тогда
			Возврат(Истина);
		КонецЕсли;
	КонецЕсли; 
	Возврат(Ложь);
	
	// --- 
