
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	//CW_ПраваДоступа.УстановитьПраваДляФормы(ЭтаФорма);
	//CW_Документы.ОтображениеКнопокКоманднойПанелиФормыСписка(ЭтаФорма);
	// --------------------------------------------------------------------------- 
	
	ГруппаПользователя = CW_ПраваДоступа_ПИ.ГруппаПользователя(ПараметрыСеанса.ТекущийПользователь);

	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("CW_ГруппаПользователя", 	ГруппаПользователя);
	СтруктураПараметров.Вставить("CW_Пользователь", 		ПараметрыСеанса.ТекущийПользователь);
	
	УстановитьПараметрыФункциональныхОпцийФормы(СтруктураПараметров);
	
	Параметры.Свойство("РежимВыбора",Элементы.Список.РежимВыбора);
	Если (Элементы.Список.РежимВыбора) Тогда
		
		Элементы.Список.МножественныйВыбор=Ложь;
	КонецЕсли; 
	
	УстановитьОтборПоГруппеПользователя();
	
	Параметры.Свойство("Клиент",Клиент);
	
	Если Параметры.Свойство("МассивОбъектовОтбора") Тогда
		
		НовыйЭлемент = Список.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		НовыйЭлемент.ЛевоеЗначение 		= Новый ПолеКомпоновкиДанных("Ссылка");
		НовыйЭлемент.ВидСравнения  		= ВидСравненияКомпоновкиДанных.ВСписке;
		НовыйЭлемент.ПравоеЗначение   	= Параметры.МассивОбъектовОтбора;
		НовыйЭлемент.Применение 		= ТипПримененияОтбораКомпоновкиДанных.Элементы;
		НовыйЭлемент.Использование 		= Истина;
		
	КонецЕсли;                                                  	

	_ЗагрузитьСеансовуюНастройку();

	_ПраваДоступа();
	
	 УстановитьИнтевалСпискаНаСервере();
	 
	 //Подсистема.ЛогистическиеСтатусы
	ИспользоватьЛогистическиеСтатусыГрузоперевозок = ПолучитьФункциональнуюОпцию("CW_ИспользоватьЛогистическиеСтатусыГрузоперевозок");
	Элементы.ГруппаЛогистическийСтатус.Видимость   = ИспользоватьЛогистическиеСтатусыГрузоперевозок;
	
	Если ИспользоватьЛогистическиеСтатусыГрузоперевозок Тогда
		ИдентификаторОбъекта = ОбщегоНазначения.ИдентификаторОбъектаМетаданных(Тип("СправочникСсылка.CW_Грузоперевозки"));
		МеханизмРаскраски 	 = Константы.CW_МеханизмРаскраскиСписковМониторинга.Получить();
		
		CW_ЛогистическиеСтатусыСервер.ПриСозданииФормыСпискаНаСервере(ЭтаФорма, "Список", ИдентификаторОбъекта, МеханизмРаскраски, Отказ, СтандартнаяОбработка);
	КонецЕсли;
	//Подсистема.ЛогистическиеСтатусы

	//Подсистема.ФинансовыеСтатусы
	ИспользоватьФинансовыеСтатусыГрузоперевозок = ПолучитьФункциональнуюОпцию("CW_ИспользоватьФинансовыеСтатусыГрузоперевозок");
	Элементы.ГруппаФинансовыйСтатус.Видимость   = ИспользоватьФинансовыеСтатусыГрузоперевозок;
	
	Если ИспользоватьФинансовыеСтатусыГрузоперевозок Тогда
		CW_ФинансовыеСтатусыСервер.ПриСозданииФормыСпискаНаСервере(ЭтаФорма, "Список", ИдентификаторОбъекта, Отказ, СтандартнаяОбработка);
	КонецЕсли;
	//Подсистема.ФинансовыеСтатусы
	
	УстановитьПараметрыыДинамическогоСписка();
	
	//Внешние подклчюаемые команды
	CW_ПодключаемыеКомандыСервер.ПриСозданииНаСервере(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если ЗначениеЗаполнено(Клиент) Тогда
		
		ОтборНайден = Ложь;
		Для Каждого ЭлементОтбора из Список.Отбор.Элементы Цикл
			Если ЭлементОтбора.ЛевоеЗначение 	= Новый ПолеКомпоновкиДанных("Клиент") Тогда
				ОтборНайден = Истина;
				Прервать;
			Конецесли;
		КонецЦикла;
		
		Если НЕ ОтборНайден Тогда
			ЭлементОтбора = Список.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		КонецЕсли;
		
		ЭлементОтбора.ЛевоеЗначение 	= Новый ПолеКомпоновкиДанных("Клиент");
		ЭлементОтбора.ВидСравнения 		= ВидСравненияКомпоновкиДанных.Равно;
		ЭлементОтбора.ПравоеЗначение 	= Клиент;
		ЭлементОтбора.Использование 	= Истина;
		
	КонецЕсли;

	
КонецПроцедуры

&НаКлиенте
Процедура СписокПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	Если НЕ ПравоДобавленияГрузоперевозокя Тогда
		Отказ = истина;
		ПоказатьПредупреждение(,"Нет прав для добавления грузоперевозки");
	КонецЕсли;

	
	
КонецПроцедуры


&НаСервере
Процедура УстановитьОтборПоГруппеПользователя()
	
	ГруппаПользователя = CW_ПраваДоступа_ПИ.ГруппаПользователя(ПараметрыСеанса.ТекущийПользователь);
	
	Если  ГруппаПользователя = ПредопределенноеЗначение("Справочник.CW_ГруппыПользователей.Администраторы") 
		ИЛИ ГруппаПользователя.ПолныеПрава ИЛИ Не ГруппаПользователя.ФильтрГрузоперевозок Тогда
		Возврат;
	КонецЕсли;
	
	НастройкиГруппы  = ГруппаПользователя.ХранилищеФильтраГрузоперевозок.Получить();
	
	Если НастройкиГруппы <> Неопределено Тогда
		Список.КомпоновщикНастроек.ЗагрузитьНастройки(НастройкиГруппы);
	КонецЕсли;
	
КонецПроцедуры

