&НаСервере
Функция _ПФ_НастройкаСписка()
	// --- 
	
	ПФ = Новый Структура("Источник,СписокКолонок",ЭтаФорма.Заголовок,Новый Массив);
	// --- 
	_СформироватьСтруктуруКолонок(Элементы.Список,ПФ.СписокКолонок);
	СписокКолонок.ЗагрузитьЗначения(ПФ.СписокКолонок);
	// --- 
	Возврат(ПФ);
	
	// --- 
КонецФункции
 
&НаСервере
Процедура _СформироватьСтруктуруКолонок(Элемент,МассивСК)
	// --- 
	мИсключения = Новый Массив;   
	//Добавили, убрали, потом уберем обратно, поэтому не удаляю
	//мИсключения.Добавить("КартинкаСтатуса");
	//мИсключения.Добавить("ФинансовыйСтатусКартинка");
	//мИсключения.Добавить("ГруппаЛогистическийСтатус");
	//мИсключения.Добавить("ГруппаФинансовыйСтатус");
	
	мНеДоступноПоОпциям = Новый Массив;
	Если НЕ ПолучитьФункциональнуюОпцию("CW_ИспользоватьФинансовыеСтатусыГрузоперевозок") Тогда
		мНеДоступноПоОпциям.Добавить("ФинансовыйСтатус");	
	КонецЕсли;
	Если НЕ ПолучитьФункциональнуюОпцию("CW_ИспользоватьЛогистическиеСтатусыГрузоперевозок") Тогда
		мНеДоступноПоОпциям.Добавить("ЛогистическийСтатус");	
	КонецЕсли; 
	Если CW_Настройки.ПолучитьНастройкуПользователя(CW_Настройки.Пользователь(), "СкрыватьКартинкиСтатусовВЖурналах") тогда
		мНеДоступноПоОпциям.Добавить("КартинкаСтатуса");	
	КонецЕсли;
	Если CW_Настройки.ПолучитьНастройкуПользователя(CW_Настройки.Пользователь(), "СкрыватьКартинкиФинансовыхСтатусовВЖурналах") тогда
		мНеДоступноПоОпциям.Добавить("ФинансовыйСтатусКартинка");	
	КонецЕсли;
	
	// обходим подчинённые элементы
	Для каждого ПЭ Из Элемент.ПодчиненныеЭлементы Цикл
		
		Если мИсключения.Найти(ПЭ.Имя) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Если мНеДоступноПоОпциям.Найти(ПЭ.Имя) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
	
		Узел = _ШаблонУзла();
		_сф.ст_ЗаполнитьСвойства(Узел,"Имя,Заголовок,Видимость",ПЭ);
		Узел.ЭтоГруппа = (ТипЗнч(ПЭ) <> Тип("ПолеФормы"));
		МассивСК.Добавить(Узел);

		Если Узел.ЭтоГруппа Тогда
			_СформироватьСтруктуруКолонок(ПЭ,Узел.Элементы);
		КонецЕсли; 
		
	КонецЦикла; 
	
	// --- 
КонецПроцедуры
 
&НаСервере
Функция _ШаблонУзла()
	// --- 
	
	Возврат(Новый Структура("Имя,Заголовок,Видимость,ИзменениеВидимости,ЭтоГруппа,Элементы","","",Ложь,Истина,Ложь,Новый Массив));
	
	// --- 
КонецФункции

// --- 

&НаСервере
Процедура _ОбработатьНастройкуСписка(Настройка)
	// --- 
	
	Если (Настройка = Неопределено) Тогда
		
		Возврат;
		
	КонецЕсли; 
	
	Попытка
		
		// необходимо проверить порядок и видимость, 
		// сначала видимость
		Для каждого СК Из Настройка Цикл
			
			_ОбновитьВидимость(СК);
			
		КонецЦикла; 
		// потом порядок
		Если (СписокКолонок.Количество()=0) Тогда
			_СформироватьСтруктуруКолонок(Элементы.Список,СписокКолонок);
			_ОбновитьПорядок(Настройка);
		Иначе
			_ОбновитьПорядок(Настройка);
		КонецЕсли; 
		
	Исключение
		//ОписаниеОшибки()
	КонецПопытки; 
	
	_СохранитьСеансовуюНастройку();
	
	// --- 
КонецПроцедуры

&НаСервере
Процедура _ОбновитьВидимость(СК)
	// --- 
	
	ЭлементФормы = Элементы.Найти(СК.Имя);
	Если ЭлементФормы <> Неопределено Тогда
		
		ЭлементФормы.Видимость = СК.Видимость;
		Если СК.Видимость И СК.ЭтоГруппа Тогда
			
			Для каждого Элемент Из СК.Элементы Цикл
				
				_ОбновитьВидимость(Элемент);
				
			КонецЦикла; 
			
		КонецЕсли; 
		
	КонецЕсли; 
	
	// --- 
КонецПроцедуры

&НаСервере
Процедура _ОбновитьПорядок(Настройка)
	// --- 
	
	ТекущийИндекс = 1;
	Для каждого СК Из Настройка Цикл
		
		ПередвигаемыйЭлемент = Элементы[СК.Имя];
		Элементы.Переместить(ПередвигаемыйЭлемент, ПередвигаемыйЭлемент.Родитель);
		
		Если СК.ЭтоГруппа Тогда
			
			_ОбновитьПорядок(СК.Элементы);
			
		КонецЕсли; 
		
	КонецЦикла; 
	
	// --- 
	СписокКолонок.ЗагрузитьЗначения(Настройка);
	// --- 
КонецПроцедуры


&НаСервере
Процедура УстановитьИнтевалСпискаНаСервере()
	
	ДатаНачала 		= ПериодСписка.ДатаНачала;
	ДатаОкончания 	= ?(ЗначениеЗаполнено(ПериодСписка.ДатаОкончания), ПериодСписка.ДатаОкончания, Дата('39991231'));
	
	Список.Параметры.УстановитьЗначениеПараметра("ДатаНачала"	, ДатаНачала);
	Список.Параметры.УстановитьЗначениеПараметра("ДатаОкончания", ДатаОкончания);
	
	//Установим заголовок формы
	СтрокаПериода = ПредставлениеПериода(ПериодСписка.ДатаНачала,ПериодСписка.ДатаОкончания);
	Заголовок = "Список грузоперевозок "+?(ЗначениеЗаполнено(СтрокаПериода),"("+СтрокаПериода+")",""); 
	
КонецПроцедуры

&НаКлиенте
Процедура ИнтевалСписка(Команда)
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ОбработкаВыбораПериода",ЭтотОбъект); 
	Диалог = Новый ДиалогРедактированияСтандартногоПериода();
	Диалог.Период.ДатаНачала 	= ПериодСписка.ДатаНачала;
	Диалог.Период.ДатаОкончания = ПериодСписка.ДатаОкончания;
	Диалог.Период.Вариант 		= ВариантСтандартногоПериода.ПроизвольныйПериод;
	Диалог.Показать(ОписаниеОповещения);
	
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбораПериода(ОтветПериод, ДополнительныеПараметры) Экспорт 
	
	Если ОтветПериод <> Неопределено Тогда
		ПериодСписка = ОтветПериод;
		установитьИнтевалСпискаНаСервере();
	КонецЕсли; 
	
КонецПроцедуры


