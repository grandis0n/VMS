&НаКлиенте
Процедура ПересчитатьСуммыПоСтроке(СтрокаТЧ, ОбратныйПересчет = Ложь);
	
	НДСПроцент = CW_Финансы.ПолучитьСтавкуНДС(СтрокаТЧ.НДСПроцент, Ложь);
	Курс = ?(Объект.Курс = 0, 1, Объект.Курс);
	
	Если НЕ ОбратныйПересчет Тогда
		СтрокаТЧ.Сумма = СтрокаТЧ.Цена * СтрокаТЧ.Количество;
	Иначе
		СтрокаТЧ.Цена  = СтрокаТЧ.Сумма / ?(СтрокаТЧ.Количество = 0, 1, СтрокаТЧ.Количество);
	КонецЕсли;
	
	СтрокаТЧ.ТаможеннаяСтоимость = СтрокаТЧ.Сумма + СтрокаТЧ.ДопРасходы;
	СтрокаТЧ.ЦенаИТС             = СтрокаТЧ.ТаможеннаяСтоимость / ?(СтрокаТЧ.Количество = 0, 1, СтрокаТЧ.Количество);
	//СтрокаТЧ.ПошлинаРуб          = СтрокаТЧ.ТаможеннаяСтоимость * СтрокаТЧ.ПошлинаПроцент / 100 * Курс;
	СтрокаТЧ.НДСРуб              = ((СтрокаТЧ.ТаможеннаяСтоимость * Курс) + СтрокаТЧ.ПошлинаРуб) * НДСПроцент / 100; 
	СтрокаТЧ.Всего               = (СтрокаТЧ.ПошлинаРуб + СтрокаТЧ.НДСРуб + СтрокаТЧ.АнтидемпинговаяПошлинаРуб + СтрокаТЧ.СезСпецПошлинаРуб) / Курс;
	СтрокаТЧ.ВсегоРуб            = СтрокаТЧ.ПошлинаРуб + СтрокаТЧ.НДСРуб + СтрокаТЧ.АнтидемпинговаяПошлинаРуб + СтрокаТЧ.СезСпецПошлинаРуб;
	
	ЕстьИзмененияВСумме = Истина;
КонецПроцедуры

#КонецОбласти

#Область Команды

&НаКлиенте
Процедура ПолучитьКурсВалюты(Команда)
	
	Если Не ЗначениеЗаполнено(ВалютаРасчета) Тогда
		ПоказатьПредупреждение(,"Не указана валюта расчетов!",5);
		Возврат;
	КонецЕсли; 
	
	ПолучитьКурсВалютыНаСервере();
	
	Если Не Объект.Курс = КурсДоИзменения И Объект.Товары.Количество() Тогда
		ПОВ = Новый ОписаниеОповещения("ОбработкаВопросаИзмененияКурса", ЭтаФорма);
		ПоказатьВопрос(ПОВ,"Изменился курс расчетов. Пересчитать показатели документа по новому курсу?", РежимДиалогаВопрос.ДаНет);
	КонецЕсли; 
	
	КурсДоИзменения = Объект.Курс;
		    	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВопросаИзмененияКурса(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		Для каждого Стр Из Объект.Товары Цикл
			ПересчитатьСуммыПоСтроке(Стр);
		КонецЦикла; 
		ОбновитьИтогиПоТоварам();
	КонецЕсли; 

КонецПроцедуры

&НаКлиенте
Процедура НастройкаСписка(Команда)
	
	ПОВ = Новый ОписаниеОповещения("ОбработкаИзмененияНастройкиСпискаТоваров", ЭтаФорма); 
	ОткрытьФорму("ОбщаяФорма.CW_ФормаНастройкиСписка",ПФ_НастройкаСписка(),,,,,ПОВ, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаИзмененияНастройкиСпискаТоваров(Ответ, ДополнительныеПараметры) Экспорт
	
	Если (Ответ <> Неопределено) Тогда
		ОбработатьНастройкуСписка(Ответ); 
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьРасчет_Формат_CTM(Команда)
	
	Если Объект.Ссылка.Пустая() Тогда
		ЭтаФорма.Записать();
		СформироватьЗаголовокФормы();
	КонецЕсли; 
	
	Если Объект.Товары.Количество() Тогда
		ПОВ = Новый ОписаниеОповещения("ОбработкаВопросаЗагрузкиТоваров", ЭтаФорма);
		ПоказатьВопрос(ПОВ,"Табличная часть будет очищена, продолжить?", РежимДиалогаВопрос.ДаНет);
	Иначе
		СтруктураПараметров = Новый Структура("Формат, СсылкаНаОбъект", "CTM", Объект.Ссылка);
		ОткрытьФорму("Обработка.CW_ЗагрузкаРасчетовДТИзExcel.Форма.Форма", СтруктураПараметров,ЭтаФорма,,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	КонецЕсли; 
	
	ЭтаФорма.Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВопросаЗагрузкиТоваров(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		Объект.Товары.Очистить();
		СтруктураПараметров = Новый Структура("Формат, СсылкаНаОбъект", "CTM", Объект.Ссылка);
		ОткрытьФорму("Обработка.CW_ЗагрузкаРасчетовДТИзExcel.Форма.Форма", СтруктураПараметров,ЭтаФорма,,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	КонецЕсли; 
	
КонецПроцедуры

