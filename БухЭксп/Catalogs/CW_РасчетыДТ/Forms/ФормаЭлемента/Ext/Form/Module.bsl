
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Не ЗначениеЗаполнено(Параметры.Основание) И Не ЗначениеЗаполнено(Объект.ПроектДТ) Тогда
		ОтказНаКлиенте = Истина;
		Возврат;
	КонецЕсли; 
	
	Если ЗначениеЗаполнено(Параметры.Основание) И Не ЗначениеЗаполнено(Объект.ПроектДТ) Тогда
		Объект.ПроектДТ = Параметры.Основание;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Параметры.Основание) Тогда
		ЭтаФорма.ТолькоПросмотр = Истина;
	КонецЕсли; 
	
	ВалютаРасчета   = Объект.ПроектДТ.Валюта;
	
	Если ЗначениеЗаполнено(Объект.ПроектДТ.Аналитика) Тогда
		ВариантПривязки = ?(Объект.ПроектДТ.ПроектПоЗаказу,0,1);
	Иначе
		ВариантПривязки = 2;
	КонецЕсли; 
	
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Объект.Дата   = ТекущаяДата();
		Объект.Автор  = ПараметрыСеанса.ТекущийПользователь;
		Объект.Статус = Перечисления.CW_СтатусыПроектовДТ.ПредварительныйРасчет;
		Объект.Наименование = "Расчет";
		ПолучитьКурсВалютыНаСервере();
	КонецЕсли;
	
	КурсДоИзменения = Объект.Курс;
	ДатаДоИзменения = Объект.Дата;
		
	ПраваДоступаНаСервере();
	
	УстановитьДоступНаСервере();
	
	ЗагрузитьСеансовуюНастройку();
	УправлениеЭлементамиФормы();
	СформироватьЗаголовокФормы();
	//Внешние подклчюаемые команды
	CW_ПодключаемыеКомандыСервер.ПриСозданииНаСервере(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если ОтказНаКлиенте Тогда
		ПоказатьПредупреждение(,"Справочник не предназначен для непосредственного использования!", 5);
		Отказ = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	//Если Не ЕстьИзменения Тогда
	//	ЕстьИзменения = ЭтаФорма.Модифицированность;
	//КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии()
	СохранитьСеансовуюНастройку();
	ПараметрыПередачи = Новый Структура("ЕстьИзмененияДляРаспределения,ЕстьИзмененияВСумме,РасчетСсылка", ЕстьИзмененияДляРаспределения,ЕстьИзмененияВСумме,Объект.Ссылка);
	Оповестить("Документ.ПроектыДТ.Изменение",ПараметрыПередачи,Объект.ПроектДТ);
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "Справочник.РасчетыДТ.Изменение" Тогда
		
		Если ЗначениеЗаполнено(Параметр.Курс) Тогда
			КурсДоИзменения = Объект.Курс;
			Объект.Курс     = Параметр.Курс;
			Объект.Дата     = Параметр.Дата; 
		КонецЕсли; 
		
		Если ЗначениеЗаполнено(Параметр.ТаможенныйСборРуб) Тогда
			Объект.ТаможенныйСборРуб = Параметр.ТаможенныйСборРуб; 
		КонецЕсли;
		
 		Если ЗначениеЗаполнено(Параметр.АдресВоВременномХранилище) Тогда
			ЗагрузитьТоварыИзХранилище(Параметр.АдресВоВременномХранилище);
		КонецЕсли; 
		
	КонецЕсли; 
	
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьТоварыИзХранилище(Адрес)
    
    ТаблицаДанных = ПолучитьИзВременногоХранилища(Адрес);
    Объект.Товары.Загрузить(ТаблицаДанных);
	ОбновитьИтогиПоТоварам();

КонецПроцедуры

#КонецОбласти 

