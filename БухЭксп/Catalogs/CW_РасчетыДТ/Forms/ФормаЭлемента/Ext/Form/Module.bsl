КонецФункции

&НаСервере
Функция ПраваДоступаНаСервере()
	
	ПравоРедактирования = CW_ПраваДоступа.ПравоДоступно("РедактированиеФинансов");
	Если (НЕ ПравоРедактирования ИЛИ ЭтаФорма.ТолькоПросмотр) Тогда
		
		ЭтаФорма.ТолькоПросмотр = Истина;
		
	КонецЕсли;
	
КонецФункции

&НаСервере
Процедура УправлениеЭлементамиФормы()
	
	ОбновитьИтогиПоТоварам();
	
	Элементы.ПроектДТАналитика.Заголовок              = ?(ВариантПривязки = 0, "Заказ","Грузоперевозка");
	Элементы.ТоварыЦена.Заголовок                     = "Цена (" + ВалютаРасчета + ")";
	Элементы.ТоварыЦенаИТС.Заголовок                  = "ИТС (" + ВалютаРасчета + ")";
	Элементы.ТоварыСумма.Заголовок                    = "Фактурная стоимость (" + ВалютаРасчета + ")";
	Элементы.ТоварыДопРасходы.Заголовок               = "Доп. расходы (" + ВалютаРасчета + ")";
	Элементы.ТоварыТаможеннаяСтоимость.Заголовок      = "Таможенная стоимость (" + ВалютаРасчета + ")";
	Элементы.ТоварыВсего.Заголовок                    = "Всего (" + ВалютаРасчета + ")";
	Элементы.ТоварыНомерСтроки.ТолькоПросмотр         = ЗапретИзменений;
	Элементы.ТоварыКодТНВЭД.ТолькоПросмотр            = ЗапретИзменений;
	Элементы.ТоварыКодТНВЭДОписание.ТолькоПросмотр    = ЗапретИзменений;
	Элементы.ТоварыНоменклатура.ТолькоПросмотр        = ЗапретИзменений;  
	Элементы.ТоварыСтранаПроисхождения.ТолькоПросмотр = ЗапретИзменений;
	Элементы.ТоварыЕдиницаИзмерения.ТолькоПросмотр    = ЗапретИзменений;
	Элементы.ТоварыКоличество.ТолькоПросмотр          = ЗапретИзменений;
	
	Элементы.ФормаЗагрузитьРасчет_Формат_CTM.Доступность = Не ЗапретИзменений;
	
	Элементы.ПроектДТАналитика.Видимость = Не ВариантПривязки = 2;
		
КонецПроцедуры

&НаСервере
Функция СформироватьЗаголовокФормы()
	
	ЗаголовокДокумента = 
		"Расчет декларации на товары:" 
		+ ?(ЗначениеЗаполнено(Объект.Ссылка), " " + СокрЛП(Объект.Код), " (создание)");
	ЭтаФорма.Заголовок = ЗаголовокДокумента;
	
КонецФункции

&НаСервере
Процедура УстановитьДоступНаСервере()
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("РасчетДТ", Объект.Ссылка);
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	CW_ДТГрузоперевозок.РасчетДТ
	|ИЗ
	|	РегистрСведений.CW_ДТГрузоперевозок КАК CW_ДТГрузоперевозок
	|ГДЕ
	|	CW_ДТГрузоперевозок.РасчетДТ = &РасчетДТ";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	ЗапретИзменений = Выборка.Следующий();
	
КонецПроцедуры
 
#КонецОбласти

#Область РеквизитыФормы

&НаКлиенте
Процедура КурсПриИзменении(Элемент)
	
	Если Не Объект.Курс = КурсДоИзменения И Объект.Товары.Количество() Тогда
		ПОВ = Новый ОписаниеОповещения("ОбработкаВопросаИзмененияКурса", ЭтаФорма);
		ПоказатьВопрос(ПОВ,"Изменился курс расчетов. Пересчитать показатели документа по новому курсу?", РежимДиалогаВопрос.ДаНет);
	КонецЕсли; 
	
	КурсДоИзменения = Объект.Курс;

КонецПроцедуры

&НаКлиенте
Процедура ДатаПриИзменении(Элемент)
	
	Если Не ЗначениеЗаполнено(Объект.Дата) Тогда
		Объект.Дата = ТекущаяДата();
	КонецЕсли;
	
	Если Не Объект.Дата = ДатаДоИзменения Тогда
		ПОВ = Новый ОписаниеОповещения("ОбработкаВопросаИзменениеДаты", ЭтаФорма);
		ПоказатьВопрос(ПОВ,"Изменилась дата документа. Пересчитать курс документа на новую дату?", РежимДиалогаВопрос.ДаНет);
	КонецЕсли; 
	
	ДатаДоИзменения = Объект.Дата;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВопросаИзменениеДаты(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		ПолучитьКурсВалюты(Неопределено); 
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ТаможенныйСборРубПриИзменении(Элемент)
	ОбновитьИтогиПоТоварам();
	ЕстьИзмененияВСумме = Истина;
КонецПроцедуры

&НаКлиенте
Процедура БрокерскиеУслугиРубПриИзменении(Элемент)
	ЕстьИзмененияВСумме = Истина;
КонецПроцедуры

#КонецОбласти

#Область Товары

&НаСервере
Процедура ОбновитьИтогиПоТоварам()
	
	// итоговая строка по табличной части "Товары" 
	СВ = Строка(ВалютаРасчета);
	ФЧ = "ЧЦ=15; ЧДЦ=2; ЧН=";
	
	Курс = ?(Объект.Курс = 0, 1, Объект.Курс);
	
	ТаможенныйСборВалюта       = Объект.ТаможенныйСборРуб / Курс;
	Объект.ТаможеннаяСтоимость = Объект.Товары.Итог("ТаможеннаяСтоимость");
	Объект.Сумма               = Объект.Товары.Итог("Сумма");
	Объект.Всего               = Объект.Товары.Итог("Всего") + ТаможенныйСборВалюта; 
	Объект.ВсегоРуб            = Объект.Товары.Итог("ВсегоРуб") + Объект.ТаможенныйСборРуб; 
	Объект.НетарифкаРуб        = Объект.Товары.Итог("НетарифкаРуб"); 
	
	Если Объект.Товары.Количество() = 0 Тогда
		ИтогоПоТоварам = "Сведения об услугах отсутствуют";
	Иначе
		ИтогоПоТоварам = "Строк: "+Объект.Товары.Количество() +
						 ";  Фактурная стоимость: "+Формат(Объект.Сумма,ФЧ)+" ("+СВ+")"+ 
						 ";  Всего платежей: "+Формат(Объект.Всего,ФЧ)+" ("+СВ+")"+
						 ";  Всего платежей: "+Формат(Объект.ВсегоРуб,ФЧ)+" (Руб.)"+
						 ";  Нетарифка: "+Формат(Объект.НетарифкаРуб,ФЧ)+" (Руб.)";
	КонецЕсли;
	
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
