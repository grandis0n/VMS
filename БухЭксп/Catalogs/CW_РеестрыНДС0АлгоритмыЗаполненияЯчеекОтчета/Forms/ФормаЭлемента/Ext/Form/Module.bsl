
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ТОбъект = РеквизитФормыВЗначение("Объект");
	
	СхемаКомпоновкиДанных 	= ТОбъект.ПолучитьМакет("СхемаКомпоновкиДанных");
	АдресСхемы 				= ПоместитьВоВременноеХранилище(СхемаКомпоновкиДанных,Этаформа.УникальныйИдентификатор);

	ЗаполнитьДополнительныеКолонки();
	
	Если ЗначениеЗаполнено(Параметры.ЗначениеКопирования) Тогда
		КопируемааяТаблица = Параметры.ЗначениеКопирования.ФункцииЗначения;
		Для Каждого СтрокаТаблицы из Объект.ФункцииЗначения Цикл
			
			ИндексСтроки 		= Объект.ФункцииЗначения.Индекс(СтрокаТаблицы);  
			
			КопируемаяСтрока 	= КопируемааяТаблица[ИндексСтроки];
			НастройкаОтбора		= КопируемаяСтрока.ХранилищеОтбора.Получить();
			
			СтрокаТаблицы.АдресОтбора = ПоместитьВоВременноеХранилище(НастройкаОтбора, Новый УникальныйИдентификатор);
			Если НастройкаОтбора <> Неопределено Тогда
				СтрокаТаблицы.НаличеОтбора   = НастройкаОтбора.Отбор.Элементы.Количество() > 0; 
			Конецесли;
		КонецЦикла;
	КонецЕсли;


КонецПроцедуры      

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	Для Каждого СтрокаОбъекта из ТекущийОбъект.ФункцииЗначения	Цикл
		ИндексСтроки  = ТекущийОбъект.ФункцииЗначения.Индекс(СтрокаОбъекта);  
		СтрокаТекущая = Объект.ФункцииЗначения[ИндексСтроки];   
		
		НастройкаОтбора = Неопределено;
		Если ЭтоАдресВременногоХранилища(СтрокаТекущая.АдресОтбора) Тогда
			НастройкаОтбора = ПолучитьИзВременногоХранилища(СтрокаТекущая.АдресОтбора); 
		КонецЕсли;
		
		СтрокаОбъекта.ХранилищеОтбора = Новый ХранилищеЗначения(НастройкаОтбора, Новый СжатиеДанных(9));
	КонецЦикла;
	
КонецПроцедуры   

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	ЗаполнитьДополнительныеКолонки();
	
КонецПроцедуры  

&НаСервере
Процедура ЗаполнитьДополнительныеКолонки()

	ТОбъект = РеквизитФормыВЗначение("Объект");
	Для Каждого СтрокаОтбора из ТОбъект.ФункцииЗначения  Цикл           
		НастройкаОтбора	= СтрокаОтбора.ХранилищеОтбора.Получить();
		ИндексСтроки	= ТОбъект.ФункцииЗначения.Индекс(СтрокаОтбора);
		
		СтрокаОбъекта = Объект.ФункцииЗначения.Получить(ИндексСтроки);
		СтрокаОбъекта.АдресОтбора 	 = ПоместитьВоВременноеХранилище(НастройкаОтбора, Новый УникальныйИдентификатор);    
		Если НастройкаОтбора <> Неопределено Тогда
			СтрокаОбъекта.НаличеОтбора   = НастройкаОтбора.Отбор.Элементы.Количество() > 0; 
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура УсловияЗначенияВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Поле.ГиперссылкаЯчейки Тогда       
		СтандартнаяОбработка = Ложь;   
		
		ТекущиеДанные = Элементы.УсловияЗначения.ТекущиеДанные;   
		АдресОтбора = ТекущиеДанные.АдресОтбора;
		Если Не ЭтоАдресВременногоХранилища(АдресОтбора) Тогда
			АдресОтбора 				= ПоместитьВоВременноеХранилище(Неопределено, Новый УникальныйИдентификатор); 
			ТекущиеДанные.АдресОтбора 	= АдресОтбора;
		КонецЕсли;  
		
		ДополнительныеПараметры = Новый Структура;   
		ДополнительныеПараметры.Вставить("ТекущиеДанные", 	ТекущиеДанные);
		
		ОписаниеОповещения = Новый ОписаниеОповещения("ОбработкаИзмененияОтбораИСортировки", ЭтотОбъект, ДополнительныеПараметры);   
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("АдресСхемы",	АдресСхемы);
		ПараметрыФормы.Вставить("АдресОтбора",	АдресОтбора);
		
		ОткрытьФорму("Справочник.CW_РеестрыНДС0АлгоритмыЗаполненияЯчеекОтчета.Форма.ФормаРедактированияОтбора", ПараметрыФормы,,,,,ОписаниеОповещения,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	КонецЕсли;
	
КонецПроцедуры    

&НаКлиенте
Процедура ОбработкаИзмененияОтбораИСортировки(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	НастройкаОтбора = ПолучитьИзВременногоХранилища(ДополнительныеПараметры.ТекущиеДанные.АдресОтбора); 
	
	ДополнительныеПараметры.ТекущиеДанные.НаличеОтбора	= НастройкаОтбора <> Неопределено; 
	Если НастройкаОтбора <> Неопределено Тогда
		ДополнительныеПараметры.ТекущиеДанные.НаличеОтбора   = НастройкаОтбора.Отбор.Элементы.Количество() > 0; 
	КонецЕсли;    
	
	Модифицированность = Истина;

КонецПроцедуры

&НаКлиенте
Процедура УсловияЗначенияПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если Не НоваяСтрока Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеДанные = Элементы.УсловияЗначения.ТекущиеДанные;   
	Если Копирование Тогда  
		КопируемаяНастройка = ПолучитьИзВременногоХранилища(ТекущиеДанные.АдресОтбора);
	КонецЕсли; 
	
	ТекущиеДанные.АдресОтбора = ПоместитьВоВременноеХранилище(КопируемаяНастройка, Новый УникальныйИдентификатор);
	
	
КонецПроцедуры





