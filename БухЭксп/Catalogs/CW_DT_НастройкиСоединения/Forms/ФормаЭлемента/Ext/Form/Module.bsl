
&НаКлиенте
Процедура Ping(Команда)
	ПоказатьПредупреждение(,PingНаСервере());
КонецПроцедуры
 
&НаСервере
Функция PingНаСервере()
	Попытка
		HTTPСоединение	= HTTPСоединение();
		HTTPЗапрос		= Новый HTTPЗапрос(Объект.АдресРесурса + "/test");
		HTTPОтвет		= HTTPСоединение.Получить(HTTPЗапрос);
		Возврат			HTTPОтвет.КодСостояния
	Исключение
		Возврат			ОписаниеОшибки()
	КонецПопытки;
КонецФункции

&НаСервере
Функция HTTPСоединение()
	Возврат CW_DT.HTTPСоединение(Объект)	
КонецФункции
 