&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Ключ.Пустая() И Не ПустаяСтрока(Объект.Наименование) Тогда
		Если НЕ ЗначениеЗаполнено(Объект.Идентификатор) Тогда  
			Объект.Идентификатор 	= ИдентификаторПоПредставлению();
		КонецЕсли;
	КонецЕсли;   
	
	CW_ОбменГИСЭПДДополнительный.ЗаполнитьДоступныеТипыОбъектов(ЭтотОбъект);
	
	УстановитьДоступностьСпособаПолученияЗначения();
	ВозвращаемоеЗначениеПриИзмененииНаСервере();                                                  
	
	Если Объект.ВозвращаемоеЗначение = Перечисления.CW_ОбменГИСЭПДВидыРезультатов.ЗначениеРеквизита Тогда
		СпособПолученияЗначенияПриИзмененииНаСервере();     
	КонецЕсли;
	
	УстановитьАдерсСхемыКомпоновки(); 
	УстановитьВидиостьДанных();
	
КонецПроцедуры 

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	Если Объект.ВозвращаемоеЗначение = Перечисления.CW_ОбменГИСЭПДВидыРезультатов.ЗначениеРеквизита Тогда
		ТекстФормулы.УстановитьТекст(ТекущийОбъект.ТекстФормулы);
		УстановитьАдерсСхемыКомпоновки(); 
	КонецЕсли;
	Если Объект.ВозвращаемоеЗначение = Перечисления.CW_ОбменГИСЭПДВидыРезультатов.ТабличнаяЧасть Тогда
		ХранимыеНастройкиОтбора = ТекущийОбъект.ХранилищеНастроек.Получить();
		Если ТипЗнч(ХранимыеНастройкиОтбора) = тип("ТаблицаЗначений") Тогда
			НастройкиОтбора.Загрузить(ХранимыеНастройкиОтбора);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)   
	
	ТекущийОбъект.ТекстФормулы = ТекстФормулы.ПолучитьТекст();
	ТекущийОбъект.ХранилищеНастроек = Новый ХранилищеЗначения(НастройкиОтбора.Выгрузить());
	
КонецПроцедуры    

&НаКлиенте
Процедура СпособПолученияЗначенияПриИзменении(Элемент)
	
	Объект.ПутьКДанным 	= Неопределено;
	Объект.Значение		= Неопределено;    
	Объект.ФорматВывода	= Неопределено;    
	ТекстФормулы.Очистить();    
	
	СпособПолученияЗначенияПриИзмененииНаСервере();   
	
	Если Объект.СпособПолученияЗначения = 1 Тогда
		Объект.ТипОбъекта = Неопределено;	
	КонецЕсли;

	УстановитьДоступностьСпособаПолученияЗначения();
	
КонецПроцедуры

&НаСервере
Процедура СпособПолученияЗначенияПриИзмененииНаСервере()
	
	//Реквизит(0), Фиксированное значение(2), Формула(3)
	Элементы.ПутьКДанным.Видимость	= (Объект.СпособПолученияЗначения = 0); 
	Элементы.Значение.Видимость		= (Объект.СпособПолученияЗначения = 1); 
	Элементы.ГруппаТекстФормулы.Видимость	= (Объект.СпособПолученияЗначения = 2);   
	
КонецПроцедуры

&НаКлиенте
Процедура НаименованиеПриИзменении(Элемент) 
	
	НаименованиеПриИзмененииНаКлиенте();  
	
КонецПроцедуры  

&НаКлиенте
Процедура ОбновитьИдентифкатор(Команда)
	
	Объект.Идентификатор = ИдентификаторПоПредставлению();
	
КонецПроцедуры

&НаКлиенте
Процедура НаименованиеПриИзмененииНаКлиенте()
	
	Если НЕ ЗначениеЗаполнено(Объект.Идентификатор) Тогда  
		Объект.Идентификатор = ИдентификаторПоПредставлению();
	КонецЕсли;
	
КонецПроцедуры  

&НаСервере
Функция ИдентификаторПоПредставлению()
	
	Идентификатор = ПолучитьИдентификаторПоТексту(СокрЛП(Объект.Наименование));
	
	ПолучитьУникальныйИдентификатор(Идентификатор, Идентификатор, Объект.Ссылка);
	
	Возврат СокрЛП(Идентификатор);
	
КонецФункции   

&НаСервере
Функция ПолучитьИдентификаторПоТексту(Знач Представление) Экспорт
	
	СтрокаЦифр 		= "0123456789";
	Идентификатор 	= "";
	БылРазделитель	 = Ложь; 
	
	Для НомСимвола = 1 По СтрДлина(Представление) Цикл
		Символ = Сред(Представление, НомСимвола, 1);
		Если СтрНайти(СтрокаЦифр,Символ) > 0 
			И ПустаяСтрока(Идентификатор) Тогда
			// цифры в начале пропускаем
			Продолжить;
		КонецЕсли;
		Если СтроковыеФункцииКлиентСервер.ЭтоРазделительСлов(КодСимвола(Символ)) Тогда
			БылРазделитель = Истина;
		Иначе
			Если БылРазделитель Тогда
				БылРазделитель = Ложь;
				Символ = ВРег(Символ);
			КонецЕсли;
			Идентификатор = Идентификатор + Символ;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Идентификатор;
	
КонецФункции

&НаСервере
Процедура ПолучитьУникальныйИдентификатор(Идентификатор, Знач ИсходныйИдентификатор, ТекущаяСсылка)  
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	|	CW_ОбменГИСЭПДФункцииЗначенийРеквизитовЭПД.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.CW_ОбменГИСЭПДФункцииЗначенийРеквизитовЭПД КАК CW_ОбменГИСЭПДФункцииЗначенийРеквизитовЭПД
	|ГДЕ
	|	CW_ОбменГИСЭПДФункцииЗначенийРеквизитовЭПД.Ссылка <> &Ссылка
	|	И CW_ОбменГИСЭПДФункцииЗначенийРеквизитовЭПД.Идентификатор = &Идентификатор";   
	
	Запрос.УстановитьПараметр("Ссылка", 			ТекущаяСсылка);
	Запрос.УстановитьПараметр("Идентификатор", 		Идентификатор);
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли;  
	
	ТекущийКлюч = СтрЗаменить(Идентификатор,ИсходныйИдентификатор,""); 
	ТекущийКлюч = ?(ПустаяСтрока(ТекущийКлюч), 0, Число(ТекущийКлюч));
	ТекущийКлюч = ТекущийКлюч 	+ 1;  
	
	Идентификатор 	= ИсходныйИдентификатор + Формат(ТекущийКлюч, "ЧГ=0");
	
	ПолучитьУникальныйИдентификатор(Идентификатор, ИсходныйИдентификатор, ТекущаяСсылка);
	
КонецПроцедуры

&НаКлиенте
Процедура ПутьКДаннымНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;  
	
	ПараметрыФормы = новый Структура;
	ПараметрыФормы.Вставить("РежимВыбора",			Истина);
	ПараметрыФормы.Вставить("ЗакрыватьПриВыборе",	Истина);
	ПараметрыФормы.Вставить("ИдентификаторОбъектовМетаданных", Объект.ТипОбъекта);
	ПараметрыФормы.Вставить("АдресСхемы", 			АдресСхемы);
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ВыборЭлементаЗавершение", ЭтотОбъект);
	
	ОткрытьФорму("Справочник.CW_ОбменГИСЭПДФункцииЗначенийРеквизитовЭПД.Форма.ФормаВыбораРеквизита", ПараметрыФормы,ЭтаФорма,,,,ОписаниеОповещения);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыборЭлементаЗавершение(ВыбранноеЗначение, ДополнительныеПараметры) Экспорт
	
	Если ТипЗнч(ВыбранноеЗначение) <> Тип("Строка") Тогда
		Возврат;
	КонецЕсли;                                       
	
	Объект.ПутьКДанным = ВыбранноеЗначение;  
	
КонецПроцедуры   

