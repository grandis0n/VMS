
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	АдресСхемыКомпоновки = Параметры.АдресСхемыКомпоновки; 	
	КомпоновщикНастроек.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(АдресСхемыКомпоновки));  
	
	ИсключенияПоЗаголовку = Новый Массив;

	ОбработатьДоступныеПоляВыбора(КомпоновщикНастроек.Настройки.ДоступныеПоляВыбора.Элементы, ИсключенияПоЗаголовку);
	
	// убираем недоступные для просмотра поля
	НаборПрав = CW_ПраваДоступа.НаборПравДляПараметров();
	Для Каждого СтруктураПрав Из НаборПрав Цикл
		Если НЕ НаборПрав[СтруктураПрав.Ключ].Просмотр Тогда 
			Ограничение = Элементы.ДоступныеПоля.ОграниченияИспользования.Добавить();
			Ограничение.Доступность = Ложь;
			Ограничение.Поле 		= Новый ПолеКомпоновкиДанных(НаборПрав[СтруктураПрав.Ключ].Идентификатор);
		КонецЕсли; 
	КонецЦикла; 
	
КонецПроцедуры     

&НаСервере
Процедура ОбработатьДоступныеПоляВыбора(ДоступныеПоляВыбора, ИсключенияПоЗаголовку)
	
	Для Каждого ПолеВыбора Из ДоступныеПоляВыбора Цикл  
		Если ИсключенияПоЗаголовку.Найти(ПолеВыбора.Заголовок) <> Неопределено 
			ИЛИ ПолеВыбора.Таблица 
			ИЛИ ПолеВыбора.Папка  Тогда
			Ограничение = Элементы.ДоступныеПоля.ОграниченияИспользования.Добавить();
			Ограничение.Доступность = Ложь;
			Ограничение.Поле 		= ПолеВыбора.Поле; 
			Если ПолеВыбора.Папка  Тогда
				ОбработатьДоступныеПоляВыбора(ПолеВыбора.Элементы, ИсключенияПоЗаголовку);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла; 
	
КонецПроцедуры

&НаКлиенте
Процедура ДоступныеПоляВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь; 
	ВыбранныеСтроки = Новый Массив;
	ВыбранныеСтроки.Добавить(ВыбраннаяСтрока);
	
	ОбработатьВыборПоля(ВыбранныеСтроки);
	
КонецПроцедуры

&НаКлиенте
Процедура Добавить(Команда)

	ВыделенныеСтроки = Элементы.ДоступныеПоля.ВыделенныеСтроки;  
	Если ВыделенныеСтроки.Количество() > 0 Тогда
		ОбработатьВыборПоля(ВыделенныеСтроки);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОбработатьВыборПоля(ВыделенныеСтроки)  
	
	Ответ = Новый Массив;
	Для Каждого ВыбраннаяСтрока из ВыделенныеСтроки Цикл
		ДоступноеПоле = КомпоновщикНастроек.Настройки.ДоступныеПоляГруппировок.ПолучитьОбъектПоИдентификатору(ВыбраннаяСтрока);
		СтруктураДоступноеПоле = Новый Структура;
		СтруктураДоступноеПоле.Вставить("Поле",			ДоступноеПоле.Поле);
		СтруктураДоступноеПоле.Вставить("Заголовок",	ДоступноеПоле.Заголовок);
		СтруктураДоступноеПоле.Вставить("ТипЗначения",	ДоступноеПоле.ТипЗначения);
		
	Ответ.Добавить(СтруктураДоступноеПоле);	
	КонецЦикла;
	
	ЭтаФорма.Закрыть(Ответ);
	
КонецПроцедуры

	
