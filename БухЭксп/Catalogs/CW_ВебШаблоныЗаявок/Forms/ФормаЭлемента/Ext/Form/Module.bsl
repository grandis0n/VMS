 //Состав заявик
&НаКлиенте    
Процедура СоставЗаявкиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	Если Поле.ГиперссылкаЯчейки Тогда  

		СтандартнаяОбработка = Ложь;     
		
		ТекущиеДанные = Элементы.СоставЗаявки.ТекущиеДанные;
		
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("ВыбраннаяСтрока", ВыбраннаяСтрока);
		
		ОписаниеОповещения = Новый ОписаниеОповещения("УстанвоитьПредставлениеЗначенияПоУмолчанию", ЭтотОбъект, ДополнительныеПараметры);
		
		Если Поле.Имя = "СоставЗаявкиАдресОтбора" Тогда  
			
			ПустаяСсылка = ТекущиеДанные.ОписаниеТипа.ПривестиЗначение(Неопределено);
			АдресСхемыКомпоновки = ПоместитьВоВременноеХранилище(Неопределено, УникальныйИдентификатор);
			ПоместитьСхемуКомпановкиДанныхДляТипаПоАдресу(ТипЗнч(ПустаяСсылка), АдресСхемыКомпоновки);
			
			СтруктураПараметров = Новый Структура;
			СтруктураПараметров.Вставить("АдресНастроек",	ТекущиеДанные.АдресОтбора);  
  			СтруктураПараметров.Вставить("СхемаКомпоновки",	АдресСхемыКомпоновки);  

			ОткрытьФорму("Справочник.CW_ВебШаблоныЗаявок.Форма.НастройкаОтбора", СтруктураПараметров, ЭтаФорма,,,,ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца); 
			
		ИначеЕсли Поле.Имя = "СоставЗаявкиПредставлениеЗначенияПоУмолчанию" Тогда 
			
			СтруктураПараметров = Новый Структура;     
			СтруктураПараметров.Вставить("ЗаголвоокПоля", 				ТекущиеДанные.ЗаголовокПоляRU);
			СтруктураПараметров.Вставить("АдресЗначенияПоУмолчанию",	ТекущиеДанные.АдресЗначенияПоУмолчанию);  
			СтруктураПараметров.Вставить("ОписаниеТипов", 				ТекущиеДанные.ОписаниеТипа);      

			ОткрытьФорму("Справочник.CW_ВебШаблоныЗаявок.Форма.ФормаУстановкиЗначенияПоУмолчанию", СтруктураПараметров, ЭтаФорма,,,,ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца); 
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры    

&НаСервере
Процедура ПоместитьСхемуКомпановкиДанныхДляТипаПоАдресу(Тип, АдресРезультата)
	
	Справочники.CW_ВебШаблоныЗаявок.ПоместитьСхемуКомпановкиДанныхДляТипаПоАдресу(Тип, АдресРезультата);
		
КонецПроцедуры

&НаКлиенте
Процедура УстанвоитьПредставлениеЗначенияПоУмолчанию(Результат, ДополнительныеПараметры) Экспорт   
	
	Если Результат = Неопределено тогда
		Возврат;
	КонецЕсли;
	
	УстанвоитьПредставлениеЗначенияПоУмолчаниюНаСервере(ДополнительныеПараметры);
	
КонецПроцедуры   

&НаСервере
Процедура УстанвоитьПредставлениеЗначенияПоУмолчаниюНаСервере(ДополнительныеПараметры)
	
	СтрокаТекущая 		= Объект.СоставЗаявки.НайтиПоИдентификатору(ДополнительныеПараметры.ВыбраннаяСтрока); 
	ЗначениеПоУмолчанию = ПолучитьИзВременногоХранилища(СтрокаТекущая.АдресЗначенияПоУмолчанию);
	СтрокаТекущая.ПредставлениеЗначенияПоУмолчанию = Строка(ЗначениеПоУмолчанию);
	
	Модифицированность = Истина; 
	
КонецПроцедуры



