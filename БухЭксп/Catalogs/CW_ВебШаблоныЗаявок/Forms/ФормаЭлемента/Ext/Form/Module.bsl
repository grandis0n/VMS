&НаСервере
Функция ПолучитьИмяОбластиМакета()
	
	Если Объект.ТипМакетаНовойЗаявки = 1 Тогда
		Возврат "";
	КонецЕсли;
	
	ВремТаблица = Объект.СоставЗаявки.Выгрузить(,"НомерСтроки,ИмяОбластиМакета");
	ВремТаблица.Сортировать("ИмяОбластиМакета УБЫВ");	 
	
	ПерваяСтрока = ВремТаблица[0];
	Если ПустаяСтрока(ПерваяСтрока.ИмяОбластиМакета) Тогда 
		НомерОбласти = 1;
	Иначе
		НомерОбласти = Число(Сред(ПерваяСтрока.ИмяОбластиМакета, 2))+1;
	КонецЕсли; 
	
	Возврат "П" + Формат(НомерОбласти, "ЧЦ=9; ЧВН=; ЧГ=0");
	
КонецФункции

