&наКлиенте
Функция ПолучитьСписокДоступныхРеквизитов() 
	
	СписокДоступныхРеквизитов = Новый СписокЗначений;
	
	Для Каждого СтрокаОписания из ОписаниеРеквизитов Цикл
		СписокДоступныхРеквизитов.Добавить(СтрокаОписания.Имя, СтрокаОписания.Заголовок);	
	КонецЦикла;
	
	Возврат СписокДоступныхРеквизитов;

КонецФункции  

&НаКлиенте
Процедура ЗавершитьВыборРеквизита(РезультатВыбора, ДополнительныеПараметры) Экспорт
	
	Если РезультатВыбора = Неопределено Тогда
		Возврат;
	КонецЕсли;  
	
	Отбор = Новый Структура;
	Отбор.Вставить("ПараметрЗаявки", РезультатВыбора.Значение);  
	
	мСтроки = Объект.СоставЗаявки.НайтиСтроки(Отбор);
	Если мСтроки.Количество() > 0 Тогда
		ПоказатьПредупреждение(,"Реквизит "+СокрЛП(РезультатВыбора)+" уже есть в списке!");
		Возврат;
	КонецЕсли;
	
	ПродолжитьДобавлениеРеквизита(РезультатВыбора);

КонецПроцедуры

&НаКлиенте
Процедура ПродолжитьДобавлениеРеквизита(Знач РезультатВыбора)
	
	ИдентификаторГруппы = ПустойУникальныйИдентификатор();
	
	СтрокаГруппы = Элементы.ГруппыПараметров.ТекущиеДанные;  
	Если СтрокаГруппы <> Неопределено Тогда
		ИдентификаторГруппы = СтрокаГруппы.ИдентификаторГруппы;	
	КонецЕсли;  
	
	ОписаниеРеквизита = ПолучитьОписаниеРеквизита(РезультатВыбора.Значение);   
	Если ОписаниеРеквизита = Неопределено Тогда
		ВызватьИсключение "Недоступное имя реквизита!";
	КонецЕсли;

	СтрокаТекущая =	Объект.СоставЗаявки.Добавить();
	СтрокаТекущая.ПараметрЗаявки	= РезультатВыбора.Значение;
	СтрокаТекущая.ИмяПоля			= "СоставЗаявки"+СокрЛП(ОписаниеРеквизита.Имя);
	СтрокаТекущая.ЗаголовокПоляRU	= СокрЛП(ОписаниеРеквизита.Заголовок);
	СтрокаТекущая.ПолеСсылка 		= ЭтоСсылка(ОписаниеРеквизита.ОписаниеТипов);
	СтрокаТекущая.ИндексКартинки	= 1;
	СтрокаТекущая.АдресОтбора 		= ПоместитьВоВременноеХранилище(Неопределено, Новый УникальныйИдентификатор);
	СтрокаТекущая.АдресЗначенияПоУмолчанию 	= ПоместитьВоВременноеХранилище(Неопределено, Новый УникальныйИдентификатор);
	СтрокаТекущая.ИдентификаторГруппы 		= ИдентификаторГруппы;
	СтрокаТекущая.ИмяОбластиМакета 			= ПолучитьИмяОбластиМакета(); 
	СтрокаТекущая.ОписаниеТипа 				= ОписаниеРеквизита.ОписаниеТипов; 
	
	ОбновитьКоличествоПолейГруппНаСервере();
	
	Модифицированность = истина;

КонецПроцедуры

&НаСервере
Функция ПолучитьОписаниеРеквизита(Знач РезультатВыбора)
	
	Отбор = Новый Структура;
	Отбор.Вставить("Имя", РезультатВыбора);
	мСтроки = ОписаниеРеквизитов.НайтиСтроки(Отбор);
	Если мСтроки.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;                
	
	СтрокаОписания = мСтроки[0];
	
	ОписаниеРеквизита = Новый Структура;
	ОписаниеРеквизита.Вставить("Имя", 			СтрокаОписания.Имя);
	ОписаниеРеквизита.Вставить("Заголовок", 	СтрокаОписания.Заголовок);
	ОписаниеРеквизита.Вставить("ОписаниеТипов", СтрокаОписания.ОписаниеТипов);

	Возврат ОписаниеРеквизита;
	
КонецФункции   
