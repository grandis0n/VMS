&НаКлиенте
Процедура КомандаПерезаполнитьПараметрыВедомых(Команда)
	
	ПОВ = Новый ОписаниеОповещения("ОбработкаПодтвержденияПерезаписиПараметров",ЭтотОбъект, Новый Структура()); 
	ПоказатьВопрос(ПОВ,"Прописать параметры в связанные грузоперевозки?",РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры
 
&НаКлиенте
Процедура ОбработкаПодтвержденияПерезаписиПараметров(Ответ, ДополнительныеПараметры) Экспорт 
	
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	мГрузоперевозок = ПолучитьМассивГрузоперевозокОбъектаНаСервере(Объект.Ссылка);
	ВсегоЗначений 	= мГрузоперевозок.Количество();
	
	АдресПараметров = ПодготовитьПараметрыДляЗаполнения();
	
	Для Индекс = 0 по мГрузоперевозок.ВГраница() Цикл 
		
		Прогрес = (Индекс + 1) * 100 / ВсегоЗначений;

		Грузоперевозка = мГрузоперевозок.Получить(Индекс);
		
		ПерезаполнитьПараметрыНаСервере(Грузоперевозка, АдресПараметров);

		Состояние("Заполнение параметров грузоперевозок...", Прогрес, Строка(Грузоперевозка));
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ПодготовитьПараметрыДляЗаполнения()
	
	Запрос = Новый запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 0
	               |	CW_ОтслеживаемоеОборудованиеПараметрыГрузоперевозки.Параметр КАК Параметр,
	               |	CW_ОтслеживаемоеОборудованиеПараметрыГрузоперевозки.Значение КАК Значение,
	               |	CW_ОтслеживаемоеОборудованиеПараметрыГрузоперевозки.Примечание КАК Примечание
	               |ИЗ
	               |	Справочник.CW_ОтслеживаемоеОборудование.ПараметрыГрузоперевозки КАК CW_ОтслеживаемоеОборудованиеПараметрыГрузоперевозки";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ТаблицаПараметров = РезультатЗапроса.Выгрузить();
	
	Для каждого СтрокаПараметрв Из Объект.ПараметрыГрузоперевозки Цикл
		Если СтрокаПараметрв.ДобавлятьВКарточку = ложь Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = ТаблицаПараметров.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаПараметрв);
		
	КонецЦикла;
	
	Возврат ПоместитьВоВременноеХранилище(ТаблицаПараметров, УникальныйИдентификатор);

КонецФункции
		
&НаСервереБезКонтекста
Функция ПолучитьМассивГрузоперевозокОбъектаНаСервере(ОбъектСлежения)
	
	Результат = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	CW_Грузоперевозки.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.CW_Грузоперевозки КАК CW_Грузоперевозки
	               |ГДЕ
	               |	CW_Грузоперевозки.ОтслеживаемоеОборудование = &ОбъектСлежения";
	
	Запрос.УстановитьПараметр("ОбъектСлежения", ОбъектСлежения);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Добавить(Выборка.Ссылка);
	КонецЦикла;

	Возврат Результат;
	
КонецФункции

&НаСервереБезКонтекста
Процедура ПерезаполнитьПараметрыНаСервере(Грузоперевозка, АдресПараметров)
	
	ТаблицаПараметров = ПолучитьИзВременногоХранилища(АдресПараметров);
	Если ТаблицаПараметров = Неопределено Тогда
		//странно
		Возврат;
	КонецЕсли;
	
	ГрузоперевозкаОбъект = Грузоперевозка.ПолучитьОбъект();

	Для каждого СтрокаПараметров из ТаблицаПараметров Цикл
		
		Отбор = Новый Структура;
		Отбор.Вставить("Параметр", СтрокаПараметров.Параметр);
		
		мСтроки = ГрузоперевозкаОбъект.ПараметрыГрузоперевозки.НайтиСтроки(Отбор);
		Если мСтроки.Количество() <> 0 Тогда
			НоваяСтрока = мСтроки[0];  //Всегда одна строка
		Иначе
			НоваяСтрока = ГрузоперевозкаОбъект.ПараметрыГрузоперевозки.Добавить();
			НоваяСтрока.Параметр	= СтрокаПараметров.Параметр;
		КонецЕсли;
		
		НоваяСтрока.Значение			= СтрокаПараметров.Значение;
		НоваяСтрока.Примечание 			= СтрокаПараметров.Примечание;
		
	КонецЦикла;
	
	ГрузоперевозкаОбъект.Записать();
	
	//Запишем стутасы
	МассивСсылок = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Грузоперевозка);
	
	CW_ЛогистическиеСтатусыСервер.РассчитатьЛогистическийСтатус(МассивСсылок);
	CW_ФинансовыеСтатусыСервер.РассчитатьФинансовыйСтатус(МассивСсылок);
	//Запишем стутасы

КонецПроцедуры


