&НаСервере
Процедура _ЗаполнитьЗначенияПараметровИзОбъектаОборудования()
	
	ПараметрыОборудования = Объект.Оборудование.ПараметрыГрузоперевозки.Выгрузить();
	
	Для каждого Стр Из ПараметрыОборудования Цикл
		
		Отбор = Новый Структура("Параметр",Стр.Параметр);
		мСтроки = Объект.ПараметрыГрузоперевозки.НайтиСтроки(Отбор);
		Если мСтроки.Количество() = 0 Тогда 
			СтрокаПараметра = Объект.ПараметрыГрузоперевозки.Добавить();
			СтрокаПараметра.Параметр = Стр.Параметр;
		Иначе
			СтрокаПараметра = мСтроки[0];
		КонецЕсли;
		СтрокаПараметра.Значение 			= Стр.Значение;
		СтрокаПараметра.Примечание 			= Стр.Примечание;
		СтрокаПараметра.ДобавлятьВКарточку 	= Истина;
		
	КонецЦикла; 
	
КонецПроцедуры
 

