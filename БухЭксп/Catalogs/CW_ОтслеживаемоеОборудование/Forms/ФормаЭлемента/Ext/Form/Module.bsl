&НаКлиенте
Процедура ОбновитьСписокПараметров(Команда)
	
	Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопроса", ЭтотОбъект, Параметры);
	
	Если Объект.ПараметрыГрузоперевозки.Количество() > 0 Тогда
		Режим = РежимДиалогаВопрос.ДаНет;
		ПоказатьВопрос(Оповещение, "Список параметров будет обновлен. Продолжить?", Режим, 0);
	Иначе
		ВыполнитьОбработкуОповещения(Оповещение, КодВозвратаДиалога.Да); 
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияВопроса(Результат, Параметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Нет Тогда
        Возврат;
    КонецЕсли;

	ОбновитьСписокПараметровНаСервере();

КонецПроцедуры

&НаСервере
Процедура ОбновитьСписокПараметровНаСервере()
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 0
	               |	CW_ОтслеживаемоеОборудованиеПараметрыГрузоперевозки.Параметр КАК Параметр,
	               |	CW_ОтслеживаемоеОборудованиеПараметрыГрузоперевозки.Значение КАК Значение,
	               |	CW_ОтслеживаемоеОборудованиеПараметрыГрузоперевозки.Примечание КАК Примечание,
	               |	ИСТИНА КАК ДобавлятьВКарточку
	               |ИЗ
	               |	Справочник.CW_ОтслеживаемоеОборудование.ПараметрыГрузоперевозки КАК CW_ОтслеживаемоеОборудованиеПараметрыГрузоперевозки";
	
	РезультатЗапроса = Запрос.Выполнить();
	ТаблицаПараметров = РезультатЗапроса.Выгрузить();
	
	Запрос = Новый Запрос;
	
	Если ЗначениеЗаполнено(Объект.Оборудование) Тогда
		Запрос.Текст = "ВЫБРАТЬ
		|	CW_ОборудованиеПараметрыГрузоперевозки.Параметр КАК Параметр,
		|	CW_ОборудованиеПараметрыГрузоперевозки.Значение КАК Значение,
		|	CW_ОборудованиеПараметрыГрузоперевозки.Примечание КАК Примечание
		|ИЗ
		|	Справочник.CW_Оборудование.ПараметрыГрузоперевозки КАК CW_ОборудованиеПараметрыГрузоперевозки
		|ГДЕ
		|	CW_ОборудованиеПараметрыГрузоперевозки.Ссылка = &Оборудование";
		
		Запрос.УстановитьПараметр("Оборудование", Объект.Оборудование);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
			НайденнаяСтрока = ТаблицаПараметров.Найти(Выборка.Параметр, "Параметр");
			
			Если НайденнаяСтрока = Неопределено Тогда
				НайденнаяСтрока = ТаблицаПараметров.Добавить();
			КонецЕсли;
			ЗаполнитьЗначенияСвойств(НайденнаяСтрока,Выборка);
		КонецЦикла;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.ВариантСлежения) Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		|	CW_ВариантыСлеженияПараметрыГрузоперевозки.Параметр КАК Параметр,
		|	CW_ВариантыСлеженияПараметрыГрузоперевозки.Значение КАК Значение,
		|	CW_ВариантыСлеженияПараметрыГрузоперевозки.Примечание КАК Примечание
		|ИЗ
		|	Справочник.CW_ВариантыСлежения.ПараметрыГрузоперевозки КАК CW_ВариантыСлеженияПараметрыГрузоперевозки
		|ГДЕ
		|	CW_ВариантыСлеженияПараметрыГрузоперевозки.Ссылка = &ВариантСлежения";
		
		
		Запрос.УстановитьПараметр("ВариантСлежения", Объект.ВариантСлежения);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
			НайденнаяСтрока = ТаблицаПараметров.Найти(Выборка.Параметр, "Параметр");
			
			Если НайденнаяСтрока = Неопределено Тогда
				НайденнаяСтрока = ТаблицаПараметров.Добавить();
			КонецЕсли;
			ЗаполнитьЗначенияСвойств(НайденнаяСтрока,Выборка);
		КонецЦикла;
		
	КонецЕсли;

	Если ТаблицаПараметров.Количество() > 0 Тогда
		Объект.ПараметрыГрузоперевозки.Загрузить(ТаблицаПараметров);
	КонецЕсли;
	
КонецПроцедуры


&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если (ИмяСобытия = "ПараметрИзменен") Тогда
		
		_ОбновитьСвойстваПараметров();
		
	КонецЕсли; 
	
КонецПроцедуры


//ХранениеПолногоЗначения
&НаСервере
Процедура ДобавитьСохраняемоеПолноеЗначение(Параметр, ХранимоеЗначение=Неопределено)
	
	Если Не CW_МониторинговыеПараметрыСервер.ИспользуетсяСохранениеПолногоЗначения(Параметр) Тогда   
		Возврат
    КонецЕсли;
	
	Соответствие = Новый Соответствие;
	Если ТипЗнч(СохраняемоеПолноеЗначение) = Тип("ФиксированноеСоответствие") Тогда
		Соответствие = Новый Соответствие(СохраняемоеПолноеЗначение);                                             
	КонецЕсли;
	
	Соответствие.Вставить(Параметр, ХранимоеЗначение);
	СохраняемоеПолноеЗначение = Новый ФиксированноеСоответствие(Соответствие);
	
КонецПроцедуры  

&НаСервере
Процедура УдалитьСохраняемоеПолноеЗначение(Параметр)
	
	Если CW_МониторинговыеПараметрыСервер.ИспользуетсяСохранениеПолногоЗначения(Параметр) Тогда
		Соответствие = Новый Соответствие(СохраняемоеПолноеЗначение);
		Соответствие.Удалить(Параметр); 
		СохраняемоеПолноеЗначение = Новый ФиксированноеСоответствие(Соответствие);
	КонецЕсли;
	
КонецПроцедуры

