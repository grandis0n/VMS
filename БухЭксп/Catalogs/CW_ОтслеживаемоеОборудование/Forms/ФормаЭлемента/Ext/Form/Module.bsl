
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЭтаФорма.ТолькоПросмотр = (НЕ CW_ПраваДоступа.ПравоДоступно("РедактированиеОбъектовСлежения"));
	// --- 
	ПравоРедактирования = CW_ПраваДоступа.ПравоДоступно("РедактированиеОбъектовСлежения");
	// --- 
	Элементы.Статусы.ИзменятьПорядокСтрок = ПравоРедактирования;
	Элементы.Статусы.ИзменятьСоставСтрок = ПравоРедактирования;
	Элементы.Статусы.ТолькоПросмотр = (НЕ ПравоРедактирования);
	// ---
	
	// кэшируем свойства параметров
	_ОбновитьСвойстваПараметров();
	
	_ОбновитьУсловноеОформлениеПараметров();
	
	_УправлениеЭлементамиФормы();
	_ИнициализацияСписков();
	
	_СформироватьЗаголовок();
	
	//Внешние подклчюаемые команды
	CW_ПодключаемыеКомандыСервер.ПриСозданииНаСервере(ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)

	//ХранениеПолногоЗначения
	Для Каждого СтрокаОбъекта из ТекущийОбъект.ПараметрыГрузоперевозки Цикл
		ДобавитьСохраняемоеПолноеЗначение(СтрокаОбъекта.Параметр, СтрокаОбъекта.ХранилищеДанных.Получить());
	КонецЦикла;
	//---ХранениеПолногоЗначения

КонецПроцедуры    

&НаКлиенте
Процедура ПараметрыГрузоперевозкиПередУдалением(Элемент, Отказ)
	
	ТекущиеДанные = Элементы.ПараметрыГрузоперевозки.ТекущиеДанные;
	УдалитьСохраняемоеПолноеЗначение(ТекущиеДанные.Параметр);
	
КонецПроцедуры     



&НаСервере
Процедура УстановитьОтборДинамическогоСпискаСтатусы()
	
	Статусы.Отбор.Элементы.Очистить();
	
	НовыйЭлементОтбора =  Статусы.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	НовыйЭлементОтбора.ЛевоеЗначение 	= Новый ПолеКомпоновкиДанных("ОбъектСлежения");
	НовыйЭлементОтбора.ВидСравнения 	= ВидСравненияКомпоновкиДанных.Равно;
	НовыйЭлементОтбора.ПравоеЗначение 	= ?(Объект.Ссылка.Пустая(), Неопределено, Объект.Ссылка);
	НовыйЭлементОтбора.Использование 	= Истина; 
	
	Если ПоказатьТекущийСтатус Тогда
		ЭлементОтбора = Статусы.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение 	= Новый ПолеКомпоновкиДанных("ТекущийСтатус");
		ЭлементОтбора.ВидСравнения 		= ВидСравненияКомпоновкиДанных.Равно;
		ЭлементОтбора.ПравоеЗначение 	= Истина;
		ЭлементОтбора.Использование 	= Истина;
	КонецЕсли;
	
КонецПроцедуры


&НаСервере
Процедура _ОбновитьСвойстваПараметров()
	// --- 
	
	КартаПравПараметров = CW_ПраваДоступа.НаборПравДляПараметров();
	АдресКартыПравПараметров = ПоместитьВоВременноеХранилище(КартаПравПараметров, ЭтаФорма.УникальныйИдентификатор);
	// --- 
	КартаСвойствПараметров = _БЭ.ПолучитьСоответствиеСвойствПараметров();
	АдресКартыСвойствПараметров = ПоместитьВоВременноеХранилище(КартаСвойствПараметров, ЭтаФорма.УникальныйИдентификатор);	
	
	// --- 
КонецПроцедуры
 

