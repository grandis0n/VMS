
Процедура ПриЗаписи(Отказ)
	
	#Область ФормированиеСсылкиКаритинки
	
	Если Ссылка.ХранилищеКартинки.Получить() = Неопределено Тогда 
		новСсылкаКартинки = "";
	Иначе 
		новСсылкаКартинки = ПолучитьНавигационнуюСсылку(Ссылка, "ХранилищеКартинки");
	КонецЕсли;

	Если СсылкаКартинки<>новСсылкаКартинки Тогда 
		СсылкаКартинки = новСсылкаКартинки;
		ЭтотОбъект.Записать();
	КонецЕсли;
	
	#КонецОбласти 
	
КонецПроцедуры
