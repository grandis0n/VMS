&НаКлиенте
Процедура ФильтрПриИзменении(Элемент)
	
	_ФильтрПриИзменении();
	
КонецПроцедуры

&НаСервере
Процедура _ФильтрПриИзменении()
	// --- 
	
	Список.Отбор.Элементы.Очистить();
	
	Если НЕ Фильтр.Пустая() Тогда
		
		// добавляем условия:
		
		// 1. приоритеты
		Если Фильтр.ОтборПоПриоритету Тогда
			
			Если Фильтр.Приоритеты.Количество() <> 0 Тогда
				
				Отбор = Список.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
				Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Приоритет");
				Отбор.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке;
				Отбор.ПравоеЗначение = Фильтр.Приоритеты.ВыгрузитьКолонку("Приоритет");
				Отбор.Использование = Истина;
				
			КонецЕсли; 
			
		КонецЕсли; 
		
		// 2. источники
		Если Фильтр.ВариантФильтрацииПоИсточнику <> 0 Тогда
			
			Если Фильтр.Источники.Количество() <> 0 Тогда
				
				Отбор = Список.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
				Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Источник");
				Отбор.ВидСравнения = ?(Фильтр.ВариантФильтрацииПоИсточнику=1,ВидСравненияКомпоновкиДанных.ВСписке,ВидСравненияКомпоновкиДанных.НеВСписке);
				Отбор.ПравоеЗначение = Фильтр.Источники.ВыгрузитьКолонку("Источник");
				Отбор.Использование = Истина;
				
			КонецЕсли; 
			
		КонецЕсли; 
				
	КонецЕсли; 
	
	_НастройкаСписка();
	
	// --- 
КонецПроцедуры

// ---------------------------------------------------------------------------- 

&НаКлиенте
Процедура СнятьФильтр(Команда)
	
	Фильтр = Неопределено;
	_ФильтрПриИзменении();
	
КонецПроцедуры

// ---------------------------------------------------------------------------- 

&НаКлиенте
Процедура ПометкаВажности(Команда)
	
	_ИзменитьПометкуВажности(Элементы.Список.ТекущаяСтрока);
	Элементы.Список.Обновить();
	
КонецПроцедуры

&НаСервере
Процедура _ИзменитьПометкуВажности(Ссылка)
	// --- 
	
	СообщениеОбъект = Ссылка.ПолучитьОбъект();
	СообщениеОбъект.Важное = (НЕ СообщениеОбъект.Важное);
	СообщениеОбъект.Записать();
	
	// --- 
КонецПроцедуры

&НаКлиенте
Процедура УдалитьСтарыеСообщения(Команда)
	
	ПОВ = Новый ОписаниеОповещения("ОбработкаВыбораДаты",ЭтотОбъект, Новый Структура()); 
	ПоказатьВводДаты(ПОВ,НачалоДня(ТекущаяДата()-5*60*60*24),"Пометить сообщения старше",ЧастиДаты.Дата);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбораДаты(Дата, ДополнительныеПараметры) Экспорт 
	// --- 
	
	Если (Дата <> Неопределено) Тогда
		
		Результат = _ПометитьНаУдалениеСообщенияДоДаты(Дата);
		Если (_УФКС.ВыполненоУспешно(Результат)) Тогда
			
			Элементы.Список.Обновить();
			ПоказатьПредупреждение(,Формат(Результат.КоличествоСообщений)+ " помечено на удаление.");
			
		КонецЕсли; 
		
	КонецЕсли; 
	
	// --- 
КонецПроцедуры

&НаСервере
Функция _ПометитьНаУдалениеСообщенияДоДаты(Дата)
	// --- 
	
	УстановитьПривилегированныйРежим(Истина);
	// --- 
	Если (ЗначениеЗаполнено(Фильтр)) Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	CW_СистемныеСообщения.Ссылка
		               |ИЗ
		               |	Справочник.CW_СистемныеСообщения КАК CW_СистемныеСообщения
		               |ГДЕ
		               |	CW_СистемныеСообщения.ПометкаУдаления = ЛОЖЬ
		               |	И CW_СистемныеСообщения.Дата < &Дата
		               |	И CW_СистемныеСообщения.Важное = ЛОЖЬ
		               |	И ВЫБОР
		               |			КОГДА &ОтборПоПриоритету = ЛОЖЬ
		               |				ТОГДА ИСТИНА
		               |			ИНАЧЕ CW_СистемныеСообщения.Приоритет В (&Приоритеты)
		               |		КОНЕЦ
		               |	И ВЫБОР
		               |			КОГДА &ОтборПоИсточнику = ЛОЖЬ
		               |				ТОГДА ИСТИНА
		               |			ИНАЧЕ ВЫБОР
		               |					КОГДА &ПоСписку = ИСТИНА
		               |						ТОГДА &Источник В (&Источники)
		               |					ИНАЧЕ НЕ &Источник В (&Источники)
		               |				КОНЕЦ
		               |		КОНЕЦ";
		Запрос.УстановитьПараметр("Дата", Дата);
		// --- 
		Если (Фильтр.ОтборПоПриоритету И Фильтр.Приоритеты.Количество() <> 0) Тогда
			Запрос.УстановитьПараметр("ОтборПоПриоритету", Истина);
			Запрос.УстановитьПараметр("Приоритеты",  Фильтр.Приоритеты.ВыгрузитьКолонку("Приоритет"));
		Иначе
			Запрос.УстановитьПараметр("ОтборПоПриоритету", Ложь);
		КонецЕсли;
		// --- 
		Если (Фильтр.ВариантФильтрацииПоИсточнику <> 0 И Фильтр.Источники.Количество() <> 0) Тогда
			
			Запрос.УстановитьПараметр("ОтборПоИсточнику", Истина); 
			Если (Фильтр.ВариантФильтрацииПоИсточнику=1) Тогда
				Запрос.УстановитьПараметр("ПоСписку", Истина);
			Иначе
				Запрос.УстановитьПараметр("ПоСписку", Ложь);
			КонецЕсли; 
			Запрос.УстановитьПараметр("Источники", Фильтр.Источники.ВыгрузитьКолонку("Источник")); 
			
		Иначе
			
			Запрос.УстановитьПараметр("ОтборПоИсточнику", Ложь);
			
		КонецЕсли; 
		
	Иначе
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		|	CW_СистемныеСообщения.Ссылка
		|ИЗ
		|	Справочник.CW_СистемныеСообщения КАК CW_СистемныеСообщения
		|ГДЕ
		|	CW_СистемныеСообщения.ПометкаУдаления = ЛОЖЬ
		|	И CW_СистемныеСообщения.Дата < &Дата
		|	И CW_СистемныеСообщения.Важное = ЛОЖЬ";
		Запрос.УстановитьПараметр("Дата", Дата);
		
	КонецЕсли; 
	
	// --- 
		// --- 
	ТЗ = Запрос.Выполнить().Выгрузить();
	КоличествоСообщений = ТЗ.Количество();
	Для каждого Стр Из ТЗ Цикл
		СообщениеОбъект = Стр.Ссылка.ПолучитьОбъект();
		СообщениеОбъект.УстановитьПометкуУдаления(Истина);
	КонецЦикла; 
	// --- 
	Ответ = _УФКС.Ответ();
	Ответ.Вставить("КоличествоСообщений",КоличествоСообщений);
	// --- 
	Возврат(Ответ);
	
	
	// --- 
КонецФункции
 

