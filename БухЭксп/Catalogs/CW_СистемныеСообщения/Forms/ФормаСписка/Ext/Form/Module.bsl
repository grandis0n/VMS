&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ПравоОткрытия = CW_ПраваДоступа.ПравоДоступно("ПросмотрСистемныхСообщений");
	Если (НЕ ПравоОткрытия) Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли; 
	
	Список.Отбор.Элементы.Очистить();
	_ЗагрузитьСеансовыеНастройки();
	
	Параметры.Свойство("Фильтр",Фильтр);
	Если НЕ Фильтр.Пустая() Тогда
		
		_ФильтрПриИзменении();
		
	Иначе
		
		_НастройкаСписка();
		
	КонецЕсли; 
	//Внешние подклчюаемые команды
	CW_ПодключаемыеКомандыСервер.ПриСозданииНаСервере(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии()
	
	//_СохранитьСеансовыеНастройки();
	
КонецПроцедуры
 
// --- 

&НаСервере
Функция _СохранитьСеансовыеНастройки()
	// --- 
	
	СтруктураНастроекФормы = Новый Структура;
	СтруктураНастроекФормы.Вставить("ТолькоНовые",ТолькоНовые);
	СтруктураНастроекФормы.Вставить("ТолькоВажные",ТолькоВажные);
	
	УстановитьПривилегированныйРежим(Истина);
	ХранилищеСистемныхНастроек.Сохранить(ЭтаФорма.ИмяФормы,"ПоследняяНастройка",СтруктураНастроекФормы,,ПользователиИнформационнойБазы.ТекущийПользователь().УникальныйИдентификатор);	
	УстановитьПривилегированныйРежим(Ложь);
	
	// --- 
КонецФункции

&НаСервере
Функция _ЗагрузитьСеансовыеНастройки()
	// --- 
	
	УстановитьПривилегированныйРежим(Истина);
	ПоследняяНастройка = ХранилищеСистемныхНастроек.Загрузить(ЭтаФорма.ИмяФормы,"ПоследняяНастройка",,ПользователиИнформационнойБазы.ТекущийПользователь().УникальныйИдентификатор);	
	УстановитьПривилегированныйРежим(Ложь);
	Если ПоследняяНастройка <> Неопределено Тогда
		
		ПоследняяНастройка.Свойство("ТолькоНовые",ТолькоНовые);
		ПоследняяНастройка.Свойство("ТолькоВажные",ТолькоВажные);
		
	КонецЕсли; 
	
	// --- 
КонецФункции

// ---------------------------------------------------------------------------- 

&НаКлиенте
Процедура ТолькоНовые(Команда)
	
	ТолькоНовые = НЕ ТолькоНовые;
	_НастройкаСписка();
	
КонецПроцедуры

&НаКлиенте
Процедура ТолькоВажные(Команда)
	
	ТолькоВажные = НЕ ТолькоВажные;
	_НастройкаСписка();
	
КонецПроцедуры

// --- 

&НаСервере
Процедура _НастройкаСписка()
	// --- 
	
	Элементы.ФормаТолькоНовые.Пометка = ТолькоНовые;
	Элементы.ФормаТолькоВажные.Пометка = ТолькоВажные;
	
	// ---------------------------------------------------------------------------- 
	
	ПолеКомпоновки = Новый ПолеКомпоновкиДанных("ПометкаУдаления");
	Если ТолькоНовые Тогда
		
		СтрокаОтбораНовых = Неопределено;
		Для каждого СтрокаОтбора Из Список.Отбор.Элементы Цикл
			
			Если (СтрокаОтбора.ЛевоеЗначение = ПолеКомпоновки) Тогда
				
				СтрокаОтбораНовых = СтрокаОтбора;
				
			КонецЕсли; 
			
		КонецЦикла;
		Если (СтрокаОтбораНовых = Неопределено) Тогда
			
			_УФС.ДобавитьОтбор(Список.Отбор,"ПометкаУдаления",,Ложь);
			
		Иначе
			
			СтрокаОтбораНовых.Использование = Истина;
			
		КонецЕсли; 
		
	Иначе
		
		 Для каждого СтрокаОтбора Из Список.Отбор.Элементы Цикл
			
			Если (СтрокаОтбора.ЛевоеЗначение = ПолеКомпоновки) Тогда
				
				СтрокаОтбора.Использование = Ложь;
				
			КонецЕсли; 
			
		КонецЦикла;
		
	КонецЕсли; 
	
	// ---------------------------------------------------------------------------- 
	
	ПолеКомпоновки = Новый ПолеКомпоновкиДанных("Важное");
	Если ТолькоВажные Тогда
		
		СтрокаОтбораВажных = Неопределено;
		Для каждого СтрокаОтбора Из Список.Отбор.Элементы Цикл
			
			Если (СтрокаОтбора.ЛевоеЗначение = ПолеКомпоновки) Тогда
				
				СтрокаОтбораВажных = СтрокаОтбора;
				
			КонецЕсли; 
			
		КонецЦикла;
		Если (СтрокаОтбораВажных = Неопределено) Тогда
			
			_УФС.ДобавитьОтбор(Список.Отбор,"Важное",,Истина);
			
		Иначе
			
			СтрокаОтбораВажных.Использование = Истина;
			
		КонецЕсли; 
		
	Иначе
		
		Для каждого СтрокаОтбора Из Список.Отбор.Элементы Цикл
			
			Если (СтрокаОтбора.ЛевоеЗначение = ПолеКомпоновки) Тогда
				
				СтрокаОтбора.Использование = Ложь;
				
			КонецЕсли; 
			
		КонецЦикла; 
				
	КонецЕсли; 
	
	// --- 
	_СохранитьСеансовыеНастройки();
	
	// --- 
КонецПроцедуры

// ---------------------------------------------------------------------------- 

&НаКлиенте
Процедура ОтправитьПоЭлектроннойПочте(Команда)
	
	ПФ = Новый Структура("СтруктураПисьма",_ПолучитьСП(Элементы.Список.ВыделенныеСтроки));
	ОткрытьФорму("Обработка.CW_ОтправкаПочты.Форма.Форма",ПФ);
	
КонецПроцедуры

&НаСервере
Функция _ПолучитьСП(Знач МассивВыделенныхСтрок)
	// --- 
	
	// сортируем по дате сообщения
	ТЗ = _сф.т_Создать("Ссылка,Дата");
	Для каждого Стр Из МассивВыделенныхСтрок Цикл
		
		Нстр = ТЗ.Добавить();
		Нстр.Ссылка = Стр;
		Нстр.Дата = Стр.Дата;
		
	КонецЦикла; 
	ТЗ.Сортировать("Дата Возр");
	МассивВыделенныхСтрок = ТЗ.ВыгрузитьКолонку("Ссылка");
	// --- 
	
	СП = _ЭП.СтруктураПисьма();
	// --- 
	УЗ = CW_Настройки.ПолучитьНастройкуПользователя(,"УчетнаяЗаписьЭлектроннойПочты");
	Если УЗ <> Неопределено Тогда
		
		СП.Отправитель = УЗ;
		
	КонецЕсли; 
	// --- 
	_ЭП.ДобавитьТекст(СП,CW_Журнал.СформироватьТекстПисьма(МассивВыделенныхСтрок));
	// --- 
	
	Возврат(ПоместитьВоВременноеХранилище(СП,ЭтаФорма.УникальныйИдентификатор));
	
	// --- 
КонецФункции
 

