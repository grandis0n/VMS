#КонецОбласти  

&НаКлиенте
Процедура СтатусыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Поле.ГиперссылкаЯчейки Тогда   
		
		СтрокаТекущая 	= Объект.Статусы.НайтиПоИдентификатору(ВыбраннаяСтрока);
		АдресОтбора 	= СтрокаТекущая.АдресОтбора;  
		
		Если Не ЭтоАдресВременногоХранилища(АдресОтбора) Тогда
			АдресОтбора = ПолучитьПустойАдресОтбора();	
		КонецЕсли;
		
		ПараметрыОткрытия = Новый Структура;
		ПараметрыОткрытия.Вставить("АдресОтбора", АдресОтбора);   
		ПараметрыОткрытия.Вставить("АдресСхемы", АдресСхемы);   
		
		ДополнительныеПараметры = новый Структура;
		ДополнительныеПараметры.Вставить("ВыбраннаяСтрока", ВыбраннаяСтрока);
		
		Оповещение = Новый ОписаниеОповещения("ЗавершитьВыборНастроек", ЭтотОбъект, ДополнительныеПараметры);
		
		ОткрытьФорму("Справочник.CW_ТипыСлежения.Форма.ФормаРедактированияОтбора", ПараметрыОткрытия, ЭтаФорма,,,,Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
	КонецЕсли;
	
КонецПроцедуры   

&НаСервере
Функция ПолучитьПустойАдресОтбора()
	
	Возврат ПоместитьВоВременноеХранилище(Неопределено, Новый УникальныйИдентификатор);
	
КонецФункции

&НаКлиенте
Процедура ЗавершитьВыборНастроек(РезультатВыбора, ДополнительныеПараметры) Экспорт
	
	Если РезультатВыбора = Неопределено Тогда
		Возврат;
	КонецЕсли;   
	
	ЗавершитьВыборНастроекНаСервере(РезультатВыбора, ДополнительныеПараметры);
	
КонецПроцедуры

&НаСервере
Процедура ЗавершитьВыборНастроекНаСервере(РезультатВыбора, ДополнительныеПараметры) 
	
	Если НЕ ЭтоАдресВременногоХранилища(РезультатВыбора.АдресОтбора) Тогда
		Возврат;
	КонецЕсли;    
	
	СтрокаТекущая = Объект.Статусы.НайтиПоИдентификатору(ДополнительныеПараметры.ВыбраннаяСтрока);
	СтрокаТекущая.АдресОтбора 		= РезультатВыбора.АдресОтбора; 
	СтрокаТекущая.ОтборУстановлен 	= РезультатВыбора.ОтборУстановлен; 
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура СтатусыКонтрольнаяДатаНачалоВыбора1(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)  
	
	СтандартнаяОбработка = Ложь;     
	
	МассивПараметров = ПолучитьИзВременногоХранилища(АдресПараметров);  
	Если ТипЗнч(МассивПараметров) <> Тип("Массив") Тогда
		МассивПараметров  = Новый Массив;
	КонецЕсли;

	СписокЗначений = Новый СписокЗначений;
	СписокЗначений.ЗагрузитьЗначения(МассивПараметров); 
	
	СтруктураОтбора = Новый Структура;
	СтруктураОтбора.Вставить("Ссылка", СписокЗначений);
	
	ПараметрыОткрытия = Новый Структура;
	ПараметрыОткрытия.Вставить("Отбор", СтруктураОтбора);
	
	ОткрытьФорму("ПланВидовХарактеристик.CW_ПараметрыГрузоперевозок.ФормаВыбора", ПараметрыОткрытия, Элемент,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры
