&НаКлиенте
Процедура СтатусыШаблонОписанияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	// --- 
	ПОВ = Новый ОписаниеОповещения("ОбработкаИзмененияШаблона",ЭтотОбъект); 
	ПФ = Новый Структура("Шаблон,Режим",Элемент.ТекстРедактирования,"СтатусыОборудования");
	ОткрытьФорму("ОбщаяФорма.CW_ФормаРедактированияШаблонов",ПФ,,,,,ПОВ, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры


&НаКлиенте
Процедура ОбработкаИзмененияШаблона(Ответ, ДополнительныеПараметры) Экспорт 
	// --- 
	
	Если (Ответ <> Неопределено) Тогда
		
		Элементы.Статусы.ТекущиеДанные.ШаблонОписания = Ответ;
		
	КонецЕсли; 
	
	// --- 
КонецПроцедуры


&НаКлиенте
Процедура СтатусыКонтрольнаяДатаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ПОВ = Новый ОписаниеОповещения("ОбработкаВыбораКонтрольнойДаты",ЭтотОбъект, Новый Структура()); 
	ОткрытьФорму("ПланВидовХарактеристик.CW_ПараметрыГрузоперевозок.Форма.ФормаВыбораПараметровПоТипамПеревозок",,Элемент,,,,ПОВ,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры


&НаКлиенте
Процедура ОбработкаВыбораКонтрольнойДаты(Ответ, ДополнительныеПараметры) Экспорт 
	// --- 
	
	Если (Ответ <> Неопределено) Тогда
		
		
		Если (Элементы.Статусы.ТекущиеДанные.КонтрольнаяДата <> Ответ) Тогда
			
			Если (_ПроверитьИспользованиеКонтрольнойДаты(Ответ)) Тогда
				
				Элементы.Статусы.ТекущиеДанные.КонтрольнаяДата = Ответ;
				
			Иначе
				
				ПоказатьПредупреждение(,"Контрольная дата уже добавлена.");
				
			КонецЕсли; 
			
		Иначе
			
			Элементы.Статусы.ТекущиеДанные.КонтрольнаяДата = Ответ;
			
		КонецЕсли; 
		
	КонецЕсли; 
	
	// --- 
КонецПроцедуры

&НаСервере
Функция _ПроверитьИспользованиеКонтрольнойДаты(Ответ)
	// --- 
	
	Результат = Объект.Статусы.НайтиСтроки(Новый Структура("КонтрольнаяДата",Ответ));
	Возврат(Результат.Количество()=0);
	
	// --- 
КонецФункции
 

&НаКлиенте
Процедура СтатусыКонтрольнаяДатаОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	Результат = _ПроверитьИспользованиеКонтрольнойДаты(ВыбранноеЗначение);
	Если (НЕ Результат) Тогда
		
		СтандартнаяОбработка = Ложь;
		ПоказатьПредупреждение(,"Контрольная дата уже добавлена.");
		
	КонецЕсли; 
	
КонецПроцедуры

// ---------------------------------------------------------------------------- 

&НаКлиенте
Процедура КомандаПерезаполнитьПараметрыВедомых(Команда)
	
	ПОВ = Новый ОписаниеОповещения("ОбработкаПодтвержденияПерезаписиПараметров",ЭтотОбъект, Новый Структура()); 
	ПоказатьВопрос(ПОВ,"Произвести перерасчёт статусов связанных грузоперевозок?",РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры
 
&НаКлиенте
Процедура ОбработкаПодтвержденияПерезаписиПараметров(Ответ, ДополнительныеПараметры) Экспорт 
	// --- 
	
	Если (Ответ <> Неопределено) Тогда
		
		Если (Ответ = КодВозвратаДиалога.Да) Тогда
			
			Записать();
			_ПерезаполнитьПараметрыВедомых();
			Состояние("Пересчёт завершён.");
			
		КонецЕсли;  
		
	КонецЕсли; 
	
	// --- 
КонецПроцедуры
  
&НаСервере
Процедура _ПерезаполнитьПараметрыВедомых()
	// --- 
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	CW_Грузоперевозки.Ссылка
	               |ИЗ
	               |	Справочник.CW_Грузоперевозки КАК CW_Грузоперевозки
	               |ГДЕ
	               |	CW_Грузоперевозки.ОтслеживаемоеОборудование.ВариантСлежения.ТипСлежения = &ТипСлежения";
	Запрос.УстановитьПараметр("ТипСлежения", Объект.Ссылка);
	ТЗ = Запрос.Выполнить().Выгрузить();
	// --- 
	Для каждого Стр Из ТЗ Цикл
		
		ГрузоперевозкаОбъект = Стр.Ссылка.ПолучитьОбъект();
		ГрузоперевозкаОбъект.Записать();
		
	КонецЦикла;
	
	// --- 
КонецПроцедуры

&НаКлиенте
Процедура СтатусыКонтрольнаяДатаПриИзменении(Элемент)
	ЗаполнитьДобавленныеКолонкиТаблицы();
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	ЗаполнитьДобавленныеКолонкиТаблицы();
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДобавленныеКолонкиТаблицы()  
	
	ТОбъект = РеквизитФормыВЗначение("Объект");
	
	Для Каждого СтрокаТаблицы из ТОбъект.Статусы Цикл     
		
		ИндексСтроки = ТОбъект.Статусы.Индекс(СтрокаТаблицы);  
		СтрокаОбъекта = Объект.Статусы[ИндексСтроки];
		
		Если ЗначениеЗаполнено(СтрокаТаблицы.КонтрольнаяДата) Тогда
			СтрокаОбъекта.ИндексКартинки = ?(СтрокаТаблицы.КонтрольнаяДата.КонтрольнаяДатаИспользуетВремя, 1, 2);
		КонецЕсли; 

		НастройкиОтбора = СтрокаТаблицы.ХранилищеОтбора.Получить();
		АдерсОтбора		= ПоместитьВоВременноеХранилище(НастройкиОтбора, Новый УникальныйИдентификатор);
		СтрокаОбъекта.АдресОтбора =  АдерсОтбора;  
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура СтатусыКонтрольнаяДатаОткрытие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("Ключ", Элементы.Статусы.ТекущиеДанные.КонтрольнаяДата);
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ПослеЗакрытияФормыПараметра", ЭтотОбъект);
	
	ОткрытьФорму("ПланВидовХарактеристик.CW_ПараметрыГрузоперевозок.ФормаОбъекта", СтруктураПараметров, ЭтотОбъект,,,,ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияФормыПараметра(Результат, ДополнительныеПараметры) Экспорт
	ЗаполнитьДобавленныеКолонкиТаблицы();
КонецПроцедуры

&НаКлиенте
Процедура УстановитьСтаутсПоУмолчанию(Команда)  
	
	ТекущаяСтрока = Элементы.Статусы.ТекущаяСтрока;
	УстановитьСтаутсПоУмолчаниюНаСервере(ТекущаяСтрока);  
	
КонецПроцедуры

 &НаСервере
Процедура УстановитьСтаутсПоУмолчаниюНаСервере(ТекущаяСтрока)

	СтрокаТекущая = Объект.Статусы.НайтиПоИдентификатору(ТекущаяСтрока);
	Объект.СтатусОборудованияПоУмолчанию = СтрокаТекущая.Статус;

КонецПроцедуры

