
&НаКлиенте
Процедура РегламентныеЗадания(Команда)
	
	ПФ = Новый Структура();
	Если Элементы.Список.ТекущиеДанные <> Неопределено Тогда
		
		ПФ.Вставить("ОтборПоВладельцу",Элементы.Список.ТекущаяСтрока);
		
	КонецЕсли; 
	ОткрытьФорму("Обработка.CW_КонсольЗаданий.Форма.ФормаОбработки",ПФ);
	
КонецПроцедуры

&НаКлиенте
Процедура СистемныеСообщения(Команда)
	
	ПФ = Новый Структура();
	Если Элементы.Список.ТекущиеДанные <> Неопределено Тогда
		
		ОФ = ПолучитьОсновнойФильтр(Элементы.Список.ТекущаяСтрока);
		Если НЕ ОФ.Пустая() Тогда
			
			ПФ.Вставить("Фильтр",ОФ);
			
		КонецЕсли; 
		
	КонецЕсли;
	
	Форма = ПолучитьФорму("Справочник.CW_СистемныеСообщения.ФормаСписка",ПФ);
	Форма.Открыть();
	
КонецПроцедуры


&НаСервереБезКонтекста
Функция ПолучитьОсновнойФильтр(Обмен)
	// --- 
	
	Возврат(Обмен.ОсновнойФильтр);
	
	// --- 
КонецФункции
 

