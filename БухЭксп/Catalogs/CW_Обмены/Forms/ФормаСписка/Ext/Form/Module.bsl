&НаКлиенте
Процедура ИнтерактивнаяЗагрузка(Команда)
	
	Обмен = Элементы.Список.ТекущаяСтрока;       
	Если Обмен <> Неопределено Тогда
		
		ИмяФормыИЗ = _ИмяФормыИнтерактивнойЗагрузки(Обмен);
		Если (ИмяФормыИЗ <> Неопределено) Тогда
			ПФ = Новый Структура("Объект,Субъект",_ОбработкаОбмена(Обмен),Обмен);
			ОткрытьФорму(ИмяФормыИЗ,ПФ);
		КонецЕсли; 
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция _ОбработкаОбмена(Обмен)
	// --- 
	
	Возврат(Обмен.Обработка);
	
	// --- 
КонецФункции

&НаСервере
Функция _ИмяФормыИнтерактивнойЗагрузки(Обмен)
	// --- 
	
	Если (Обмен.Использование И Обмен.Загрузка) Тогда
		
		// подключаем обработку, вдруг ещё не подключена
		_ПО.ПодключитьОбработку(Обмен.Обработка);
		Возврат(_ПО.ПолучитьПолноеИмяФормыПоТипу(Обмен.Обработка,"ФормаИнтерактивнойЗагрузки"));
		
	Иначе
		
		Возврат(Неопределено);
		
	КонецЕсли; 
	
	// --- 
КонецФункции

