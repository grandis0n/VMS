
Процедура ПриЗаписи(Отказ)
	
	ОбновитьПовторноИспользуемыеЗначения(); 
	
КонецПроцедуры 

 Процедура ПередЗаписью(Отказ)  
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ИдентификаторФормулыУникальный() Тогда
		Отказ = Истина;
	КонецЕсли;

КонецПроцедуры  

Функция ИдентификаторФормулыУникальный()
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	CW_РеестрыНДС0ФункцииЗначенийЯчеекОтчета.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.CW_РеестрыНДС0ФункцииЗначенийЯчеекОтчета КАК CW_РеестрыНДС0ФункцииЗначенийЯчеекОтчета
	               |ГДЕ
	               |	CW_РеестрыНДС0ФункцииЗначенийЯчеекОтчета.Ссылка <> &Ссылка
	               |	И CW_РеестрыНДС0ФункцииЗначенийЯчеекОтчета.Идентификатор = &Идентификатор";   
	
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.УстановитьПараметр("Идентификатор", Идентификатор); 
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат РезультатЗапроса.Пустой();
	
КонецФункции
