
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ТолькоПросмотр = Объект.Предопределенный;  

	Элементы.Группа4.Видимость	= НЕ Объект.Предопределенный;
	Элементы.Группа5.Видимость 	= НЕ Объект.Предопределенный;
	Элементы.Группа6.Видимость	= НЕ Объект.Предопределенный;	

	Если Параметры.Ключ.Пустая() И Не ПустаяСтрока(Объект.Наименование) Тогда
		Если НЕ ЗначениеЗаполнено(Объект.Идентификатор) Тогда  
			Объект.Идентификатор 	= ИдентификаторПоПредставлению();
		КонецЕсли;
	КонецЕсли;  
	
	Если Параметры.Ключ.Пустая() Тогда
		СписокОбъектовПараметра.Добавить("Грузоперевозка",,Истина);
		СписокОбъектовПараметра.Добавить("Заказ");
		СписокОбъектовПараметра.Добавить("Заявка");
	КонецЕсли;
	
	ТекстФормулы.УстановитьТекст(Объект.ТекстФормулы);
	
	СпособПолученияЗначенияПриИзмененииНаСервере();     
	
КонецПроцедуры  

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	 СписокОбъектовПараметра = ТекущийОбъект.ОбъектПараметра.Получить();
	
КонецПроцедуры


&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)   
	
	ПроверитьИдентификаторФункции(Отказ);
	
	Если Отказ Тогда 
		Возврат;
	КонецЕсли;
	
	ТекущийОбъект.ТекстФормулы 		= ТекстФормулы.ПолучитьТекст();
	ТекущийОбъект.ОбъектПараметра 	= Новый ХранилищеЗначения(СписокОбъектовПараметра, Новый СжатиеДанных(9));
	
КонецПроцедуры

&НаКлиенте
Процедура СпособПолученияЗначенияПриИзменении(Элемент)
	
	Объект.ИмяРеквизита 	= "";
	Объект.Значение 		= Неопределено;    
	Объект.МониторинговыйПараметр = Неопределено;    
	ТекстФормулы.Очистить();    
	
	СпособПолученияЗначенияПриИзмененииНаСервере();    
	
КонецПроцедуры

&НаСервере
Процедура СпособПолученияЗначенияПриИзмененииНаСервере()
	
	ЭтоСправочникСсылка = Ложь;
	Если Объект.СпособПолученияЗначения = 1 
		И Объект.МониторинговыйПараметр.ТипЗначения <> Неопределено Тогда
			ТипПараметра 		= Объект.МониторинговыйПараметр.ТипЗначения.Типы()[0];
			ЭтоСправочникСсылка = Справочники.ТипВсеСсылки().СодержитТип(ТипПараметра);
	КонецЕсли;
	
	//Реквизит грузоперевозки(0), Мониторинговый параметр(1), Фиксированное значение(2), Формула(3)
	Элементы.ГруппаМониторинговыйПараметр.Видимость = (Объект.СпособПолученияЗначения = 1); 
	Элементы.ИмяРеквизита.Видимость					= (Объект.СпособПолученияЗначения = 0) ИЛИ (Объект.СпособПолученияЗначения = 1 и ЭтоСправочникСсылка); 
	Элементы.ЗначениеПараметра.Видимость 			= (Объект.СпособПолученияЗначения = 1) И Объект.МониторинговыйПараметр.ЭтоКонтрольнаяДата;   
	Элементы.Значение.Видимость 					= (Объект.СпособПолученияЗначения = 2); 
	Элементы.ГруппаФормула.Видимость 				= (Объект.СпособПолученияЗначения = 3) и Не Объект.Предопределенный;   
	
КонецПроцедуры


&НаКлиенте
Процедура МониторинговыйПараметрПриИзменении(Элемент) 
	
	МониторинговыйПараметрПриИзмененииНаСервере(); 
	СпособПолученияЗначенияПриИзмененииНаСервере();     
	
КонецПроцедуры 

 &НаСервере
Процедура МониторинговыйПараметрПриИзмененииНаСервере()
	
	Объект.ЗначениеПараметра = "Значение";
	СпособПолученияЗначенияПриИзмененииНаСервере();     
	
КонецПроцедуры

