	КонецЕсли;

КонецПроцедуры  

&НаСервере
Функция ИдентификаторПоПредставлению()
	
	Идентификатор = ПолучитьИдентификаторПоТексту(СокрЛП(Объект.Наименование));
	
	ПолучитьУникальныйИдентификатор(Идентификатор, Идентификатор, Объект.Ссылка);

	Возврат СокрЛП(Идентификатор);
	
КонецФункции   

&НаСервере
Функция ПолучитьИдентификаторПоТексту(Знач Представление) Экспорт
	
	СтрокаЦифр 		= "0123456789";
	Идентификатор 	= "";
	БылРазделитель	 = Ложь; 
	
	Для НомСимвола = 1 По СтрДлина(Представление) Цикл
		Символ = Сред(Представление, НомСимвола, 1);
		Если СтрНайти(СтрокаЦифр,Символ) > 0 
			И ПустаяСтрока(Идентификатор) Тогда
			// цифры в начале пропускаем
			Продолжить;
		КонецЕсли;
		Если СтроковыеФункцииКлиентСервер.ЭтоРазделительСлов(КодСимвола(Символ)) Тогда
			БылРазделитель = Истина;
		Иначе
			Если БылРазделитель Тогда
				БылРазделитель = Ложь;
				Символ = ВРег(Символ);
			КонецЕсли;
			Идентификатор = Идентификатор + Символ;
		КонецЕсли;
	КонецЦикла;
	
	Возврат СокрЛП(Идентификатор);

КонецФункции 

&НаСервере
Процедура ПроверитьИдентификаторФункции(Отказ) 
	
	СтрокаЦифр		= "0123456789";
	Идентификатор 	= Объект.Идентификатор;
	
	Для НомСимвола = 1 По СтрДлина(Идентификатор) Цикл
		Символ = Сред(Идентификатор, НомСимвола, 1);
		Если НомСимвола = 1 Тогда
			Если СтрНайти(СтрокаЦифр,Символ) > 0 
				ИЛИ Символ = " " Тогда
				// первая цифра
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Идентификатор функции не может начинаться с цифры и пробела!", ,"Идентификатор", "Объект", Отказ);
				Возврат; 
			КонецЕсли;
		КонецЕсли;  
		
		Если СтроковыеФункцииКлиентСервер.ЭтоРазделительСлов(КодСимвола(Символ)) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Идентификатор функции не может содержать зарезервированные символы ("+Символ+")!", ,"Идентификатор", "Объект", Отказ);
			Возврат; 
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ПолучитьУникальныйИдентификатор(Идентификатор, Знач ИсходныйИдентификатор, ТекущаяСсылка)  
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	CW_РеестрыНДС0ФункцииЗначенийЯчеекОтчета.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.CW_РеестрыНДС0ФункцииЗначенийЯчеекОтчета КАК CW_РеестрыНДС0ФункцииЗначенийЯчеекОтчета
	               |ГДЕ
	               |	CW_РеестрыНДС0ФункцииЗначенийЯчеекОтчета.Ссылка <> &Ссылка
	               |	И CW_РеестрыНДС0ФункцииЗначенийЯчеекОтчета.Идентификатор = &Идентификатор";   
	
	Запрос.УстановитьПараметр("Ссылка", 			ТекущаяСсылка);
	Запрос.УстановитьПараметр("Идентификатор", 		Идентификатор);
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли;  
	
	ТекущийКлюч = СтрЗаменить(Идентификатор,ИсходныйИдентификатор,""); 
	ТекущийКлюч = ?(ПустаяСтрока(ТекущийКлюч), 0, Число(ТекущийКлюч));
	ТекущийКлюч = ТекущийКлюч 	+ 1;  
	
	Идентификатор 	= ИсходныйИдентификатор + Формат(ТекущийКлюч, "ЧГ=0");
	
	ПолучитьУникальныйИдентификатор(Идентификатор, ИсходныйИдентификатор, ТекущаяСсылка);
	
КонецПроцедуры

&НаКлиенте
Процедура ИмяРеквизитаНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)   
	
	СтандартнаяОбработка = Ложь;
	
	АдресСхемы = ПолучитьАдресСхемы();
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("АдресСхемы", АдресСхемы);   
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ЗавершитьВыборРеквизита", ЭтотОбъект);
	
	ОткрытьФорму("Справочник.CW_РеестрыНДС0ФункцииЗначенийЯчеекОтчета.Форма.ДоступныеПоля", СтруктураПараметров, ЭтаФорма,,,,ОписаниеОповещения);
	
КонецПроцедуры      

&НаКлиенте
Процедура ЗавершитьВыборРеквизита(РезультатВыбора, ДополнительныеПараметры) Экспорт

	Если РезультатВыбора = Неопределено Тогда
		Возврат;
	КонецЕсли; 
	
	Объект.ИмяРеквизита = РезультатВыбора;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьАдресСхемы() 
	
	//Реквизит грузоперевозки(0), Мониторинговый параметр(1), Фиксированное значение(2), Формула(3)
	Если Объект.СпособПолученияЗначения = 0 Тогда
		ИмяТипа = "CW_Грузоперевозки";
	КонецЕсли;
	Если Объект.СпособПолученияЗначения = 1 и Объект.МониторинговыйПараметр.ЭтоСсылочныйТип Тогда
		ТипПараметра = Объект.МониторинговыйПараметр.ТипЗначения.Типы()[0];
		Если Справочники.ТипВсеСсылки().СодержитТип(ТипПараметра) Тогда    
			ТипДанныхXML = XMLТип(ТипПараметра); 
			ИмяТипа	     = СтрЗаменить(ТипДанныхXML.ИмяТипа, "CatalogRef.", "");
		КонецЕсли;
	КонецЕсли;  
	
	Если ИмяТипа = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	СхемаКомпоновкиДанных 	= Справочники.CW_РеестрыНДС0ФункцииЗначенийЯчеекОтчета.ПолучитьМакет("СхемаРеквизитов"); 
	ТекстЗапроса 			= СхемаКомпоновкиДанных.НаборыДанных[0].Запрос;    
	ТекстЗапроса 			= СтрЗаменить(ТекстЗапроса, "ИмяСправочника", ИмяТипа);
	
	СхемаКомпоновкиДанных.НаборыДанных[0].Запрос = ТекстЗапроса;	
	
	Возврат ПоместитьВоВременноеХранилище(СхемаКомпоновкиДанных, УникальныйИдентификатор);
	
КонецФункции


