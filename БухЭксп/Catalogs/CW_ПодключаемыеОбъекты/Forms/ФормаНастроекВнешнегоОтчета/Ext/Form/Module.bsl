&НаКлиенте
Процедура ПредставлениеКомандыПриИзменении(Элемент)
	Модифицированность = истина;
КонецПроцедуры


&НаКлиенте
Процедура ВыборКоманды(Команда)
	
	ПараметрыФормы = Новый Структура("АдресСписка",ПолучитьАдресСпискаКоманд());
	
	ОписаниеОповещения = новый ОписаниеОповещения("ПриЗакрытиФормыВыбораКоманды", ЭтаФорма);
	
	ОткрытьФорму("Справочник.CW_ПодключаемыеОбъекты.Форма.ФормаВыбораКоманды",ПараметрыФормы, ЭтаФорма,,,,ОписаниеОповещения,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытиФормыВыбораКоманды(Результат, ДопПараметр) Экспорт
	
	Если Результат <> Неопределено Тогда
		ОбработатьРезультаВыбораКомнады(Результат);
		Модифицированность = истина;
		ИзмененоКоманда 	= истина;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбработатьрезультаВыбораКомнады(Результат)
	
	Если ЭтоАдресВременногоХранилища(Результат) Тогда
		
		СтрокаСписка = ПолучитьИзВременногоХранилища(Результат);
		
		ИмяКоманды 				= СтрокаСписка.Значение;
		ПредставлениеКоманды 	= СтрокаСписка.Представление;
		
		Отбор = новый Структура("ИмяКоманды", ИмяКоманды);
		мКоманда = КомандыОбъекта.НайтиСтроки(Отбор);
		Если мКоманда.Количество() > 0 Тогда
			СтрокаКоманды = мКоманда[0];
			_ОбработатьВыборКартинки(СтрокаКоманды.ИмяКартинки);	
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры


&наСервере
Функция ПолучитьАдресСпискаКоманд()
	
	Возврат ПоместитьВоВременноеХранилище(СписокКомандОбъекта);
	
КонецФункции

&НаКлиенте
Процедура ВыполнитьПослеВыбора(ВыбранноеЗначение, ДополнительныеПараметры) Экспорт
	
	Если ВыбранноеЗначение <> Неопределено Тогда
		
		ИмяКоманды = ВыбранноеЗначение.Значение;
		ПредставлениеКоманды = ВыбранноеЗначение.Представление;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти


#Область Выбор_пиктограммы_команды

&НаКлиенте
Процедура ОбработкаВыбораПиктограммы(Ответ, ДополнительныеПараметры) Экспорт 
	// --- 
	
	Если Ответ <> Неопределено Тогда
		
		_ОбработатьВыборКартинки(Ответ.Значение);
		
	КонецЕсли; 
	
	// --- 
КонецПроцедуры

&НаСервере
Процедура _ЗаполнитьСписокКартинок()
	
	СписокКартинок.Очистить();
	CW_ОбщегоНазначения.ЗаполнитьСписокКартинок(СписокКартинок); 
	
КонецПроцедуры

&НаСервере
Функция _ОбработатьВыборКартинки(тИмяКартинки)
	
	ИмяКартинки 					= тИмяКартинки; 
	
	Если ЗначениеЗаполнено(ИмяКартинки) Тогда
		Элементы.ВыборКартинки.Картинка = БиблиотекаКартинок[тИмяКартинки]; 
	Иначе
		Если ЭтоОтчет Тогда
			Элементы.ВыборКартинки.Картинка = БиблиотекаКартинок.Отчет;
		Иначе
			Элементы.ВыборКартинки.Картинка = БиблиотекаКартинок.Обработка;
		КонецЕсли;
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Процедура ВыборКартинки(Команда)
	
	СписокВыбора = Новый СписокЗначений;
	СписокВыбора.Добавить("коллекция"	,"Из коллекции"	,,БиблиотекаКартинок.ПанельНастроек);//БиблиотекаКартинок.ПанельПользователя);
	СписокВыбора.Добавить("очистить"	,"Очистить"		,,БиблиотекаКартинок.Очистить);
	// --- 
	ОписаниеОповещения = Новый ОписаниеОповещения("ОбработкаВыбораВариантаПиктограммы",ЭтотОбъект); 
	ПоказатьВыборИзСписка(ОписаниеОповещения,СписокВыбора, Элементы.ВыборКартинки);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбораВариантаПиктограммы(Ответ, ДополнительныеПараметры) Экспорт
	// --- 
	
	Если Ответ <> Неопределено Тогда
		
		Если Ответ.Значение = "коллекция" Тогда
			
			// выбираем из списка
			Если СписокКартинок.Количество() = 0 Тогда
				
				_ЗаполнитьСписокКартинок();
				
			КонецЕсли; 
			ПОВ = Новый ОписаниеОповещения("ОбработкаВыбораПиктограммы",ЭтотОбъект); 
			СписокКартинок.ПоказатьВыборЭлемента(ПОВ,"Выберите пиктограмму");
			
		ИначеЕсли Ответ.Значение = "очистить" Тогда 
			
			ИмяКартинки = "";
			_ОбработатьВыборКартинки(ИмяКартинки);
			
		КонецЕсли; 
		
		Модифицированность = истина;
		ИзмененоКартинка 	= истина;
		
	КонецЕсли; 
	
	// --- 
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьИЗакрыть(Команда)
	
	ЭтаФорма.Закрыть(ПолучитьНастрйокиНаСервере());
	
КонецПроцедуры

&НаСервере
Функция ПолучитьНастрйокиНаСервере()
	
	КомандаОтчета = Новый Структура;
	КомандаОтчета.Вставить("ИмяКартинки"			, ИмяКартинки);
	КомандаОтчета.Вставить("ИмяКоманды"				, ИмяКоманды);
	КомандаОтчета.Вставить("ПредставлениеКоманды"	, ПредставлениеКоманды);
	КомандаОтчета.Вставить("ОсновнаяКоманда"		, истина);
	
	Настройки = Новый Структура;
	Настройки.Вставить("Индекс"				, Индекс);
	Настройки.Вставить("КомандаОтчета"		, КомандаОтчета);
	Настройки.Вставить("РасположениеОбъекта", РасположениеОбъекта.ВыгрузитьЗначения());
	Настройки.Вставить("ДоступностьОбъекта" , ДоступностьОбъекта.ВыгрузитьЗначения());
	
	Возврат ПоместитьВоВременноеХранилище(Настройки);
	
КонецФункции



#КонецОбласти

