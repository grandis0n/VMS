&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЕстьКоманды = Ложь;
	Если ЭтоАдресВременногоХранилища(Параметры.АдресНастроек) Тогда
		Настройки =  ПолучитьИзВременногоХранилища(Параметры.АдресНастроек);
		Если Настройки <> Неопределено Тогда
			
			Индекс 		= Настройки.Индекс;
			ЭтоОтчет 	= Настройки.ЭтоОтчет;
		
			Для Каждого ЭлементСписка из Настройки.СписокКомандОбъекта Цикл
				СписокКомандОбъекта.Добавить(ЭлементСписка.Значение, ЭлементСписка.Представление);	
			КонецЦикла;
			
			
			КомандаОтчета =  Настройки.КомандаОтчета;
			
			ЗаполнитьЗначенияСвойств(ЭтаФорма, КомандаОтчета);
			
			_ОбработатьВыборКартинки(ИмяКартинки) ;
					
			РасположениеОбъекта.ЗагрузитьЗначения(Настройки.РасположениеОбъекта);
			ДоступностьОбъекта.ЗагрузитьЗначения(Настройки.ДоступностьОбъекта);
			
			КомандыОбъекта.Загрузить(Настройки.КомандыОбъекта);
			
			ЕстьКоманды = КомандыОбъекта.Количество() > 0;
			
		КонецЕсли;
		
	КонецЕсли;
	
	УстановитьТекстДоступныхГруппПользователй();
	УстановитьТекстРасположенияОбъекта();
	
	//Видимость элементов
	Элементы.ВыборКартинки.Видимость 				= ЕстьКоманды;
	Элементы.ПредставлениеКоманды.Видимость	 		= ЕстьКоманды;
	Элементы.ГруппаРасположение.Видимость 			= ЕстьКоманды;
	Элементы.Доступность.Видимость	 				= ЕстьКоманды;
	
	Элементы.Надпись_КомандыНеНастроены.Видимость 	= Не ЕстьКоманды;
	
	Элементы.ВыборКоманды.Видимость = КомандыОбъекта.Количество() > 1;
	
КонецПроцедуры  



&НаСервере
Процедура УстановитьТекстДоступныхГруппПользователй()
	
	
	Если ДоступностьОбъекта.Количество() = 0 Тогда
		Элементы.ДекорацияСтрокаГруппПользователей.Заголовок = "<Настроить>";
	Иначе
		Элементы.ДекорацияСтрокаГруппПользователей.Заголовок = СтрСоединить(ДоступностьОбъекта.ВыгрузитьЗначения(),", ");
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьТекстРасположенияОбъекта()
	
	Если РасположениеОбъекта.Количество() = 0 Тогда
		Элементы.ДекорацияСтрокаРасположение.Заголовок = "<Настроить>";
	Иначе
		МассивРасположенийНаРабочемСтоле 				= ПолучитьОписаниеРасположенияНаРабочемСтоле(РасположениеОбъекта.ВыгрузитьЗначения());
		Элементы.ДекорацияСтрокаРасположение.Заголовок 	= СтрСоединить(МассивРасположенийНаРабочемСтоле, Символы.ПС);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьОписаниеРасположенияНаРабочемСтоле(РасположенияОбъекта)
	
	Исклчаемыеродители = ПолучитьИскючения();
	
	Массив = Новый Массив;
	
	Для Каждого Расположение из РасположенияОбъекта Цикл
		
		СтрокаРасположения = "";
		ПолучитьСтрокуРасположения(Расположение,Исклчаемыеродители,СтрокаРасположения);
		Массив.Добавить(СтрокаРасположения);
		
	КонецЦикла;
	
	Возврат Массив;
	
КонецФункции

