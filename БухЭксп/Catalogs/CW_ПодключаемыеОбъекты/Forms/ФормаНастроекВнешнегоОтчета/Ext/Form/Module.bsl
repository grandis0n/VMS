&НаСервере
Процедура ПолучитьСтрокуРасположения(Расположение, ИсклчаемыеРодители, СтрокаРасположения)
	
		
	СтрокаРасположения = """"+ СокрЛП(Расположение) +"""" + ?(ЗначениеЗаполнено(СтрокаРасположения)," - " + СтрокаРасположения,"");
	
	Родитель = Расположение.Родитель;
	Если ИсклчаемыеРодители.Найти(Родитель) <> Неопределено Тогда
		//Берем уровень выше
		Родитель = Родитель.Родитель;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Родитель) Тогда
		ПолучитьСтрокуРасположения(Родитель, ИсклчаемыеРодители, СтрокаРасположения);
	КонецЕсли;
	
КонецПроцедуры


#Область Выбор_расположения_на_рабочем_столе

&НаКлиенте
Процедура ДекорацияСтрокаРасположениеНажатие(Элемент)
	
	ПараметрыФормы = Новый Структура("АдресСписка",ПолучитьАдресСпискаРасположений());
	ОписаниеОповещения = новый ОписаниеОповещения("ПриЗакрытиФормыВыбораРасположения", ЭтаФорма);
	
	ОткрытьФорму("Справочник.CW_ПодключаемыеОбъекты.Форма.ФормаВыбораРасположения",ПараметрыФормы, ЭтаФорма,,,,ОписаниеОповещения,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры


&НаКлиенте
Процедура ПриЗакрытиФормыВыбораРасположения(Результат, ДопПараметр) Экспорт
	
	Если Результат <> Неопределено Тогда
		ОбработатьРезультаВыбораРасположения(Результат);
		Модифицированность 		= истина;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьАдресСпискаРасположений()
	
	Возврат ПоместитьВоВременноеХранилище(РасположениеОбъекта.ВыгрузитьЗначения());
	
КонецФункции

&НаСервере
Процедура ОбработатьРезультаВыбораРасположения(Результат)
	
	Если ЭтоАдресВременногоХранилища(Результат) Тогда
		
		мВыбранныеЗначения = ПолучитьИзВременногоХранилища(Результат);	
		
		РасположениеОбъекта.ЗагрузитьЗначения(мВыбранныеЗначения);
		
	КонецЕсли;
	
	УстановитьТекстРасположенияОбъекта();
	
КонецПроцедуры

#КонецОбласти


