
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ВариантОтбора = 1;
	
	ЭтаФорма.ТолькоПросмотр = (НЕ CW_ПраваДоступа.ПравоДоступно("УправлениеСистемнымиФункциями"));
	// --- 
	Если ЭтаФорма.ТолькоПросмотр Тогда
		
		Элементы.Список.ИзменятьСоставСтрок = Ложь;
		Элементы.Список.ТолькоПросмотр = Истина;
		
	КонецЕсли; 
	
	УстановитьОтборДинамическогоСписка();
	
	
	//Внешние подклчюаемые команды
	CW_ПодключаемыеКомандыСервер.ПриСозданииНаСервере(ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура 	УстановитьОтборДинамическогоСписка() 
	
	
	Отбор = Список.Отбор;
	Отбор.Элементы.Очистить();
	
	Если ВариантОтбора > 0 Тогда
		
		НовЭлементОтбора = Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		НовЭлементОтбора.ЛевоеЗначение 		= Новый ПолеКомпоновкиДанных("НеИспользуется"); 
		НовЭлементОтбора.ВидСравнения 		= ВидСравненияКомпоновкиДанных.Равно; 
		НовЭлементОтбора.Использование 		= истина; 
		НовЭлементОтбора.ПравоеЗначение 	= ВариантОтбора = 2;
		НовЭлементОтбора.РежимОтображения 	= РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВариантОтбораПриИзменении(Элемент)
	УстановитьОтборДинамическогоСписка();
КонецПроцедуры


