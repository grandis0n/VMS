
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	АдресСписка = Параметры.АдресСписка;
	
	Если ЭтоАдресВременногоХранилища(АдресСписка) Тогда
		ВыбранныеРасположения.ЗагрузитьЗначения(ПолучитьИзВременногоХранилища(АдресСписка));
	КонецЕсли;
	
	Запрещенные.ЗагрузитьЗначения(Справочники.CW_РазделыРабочегоСтола.ПолучитьМассивЗапрещенныхЭлементов());
	
	ПодготовитьДеревоФормы();

КонецПроцедуры

&НаСервере
Процедура ПодготовитьДеревоФормы()
	
	ДанныеКартинок 			= ПодготовитьКартинки();
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	CW_РазделыРабочегоСтола.Ссылка КАК Ссылка,
	               |	CW_РазделыРабочегоСтола.Родитель КАК Родитель
	               |ИЗ
	               |	Справочник.CW_РазделыРабочегоСтола КАК CW_РазделыРабочегоСтола
	               |ГДЕ
	               |	НЕ CW_РазделыРабочегоСтола.ПометкаУдаления
	               |ИТОГИ ПО
	               |	Ссылка ТОЛЬКО ИЕРАРХИЯ";
	
	ТаблицаЗначений = Запрос.Выполнить().Выгрузить();
	ТаблицаЗначений.Свернуть("Ссылка,Родитель","");
	
	 тДерево = РеквизитФормыВЗначение("ДеревоЗначений");  
	 
	 //Очистим строки дерева
	 тДерево.Строки.Очистить();
	 
	 Для каждого СтрокаТаблицы из ТаблицаЗначений Цикл
		 
		 Пометка = ВыбранныеРасположения.НайтиПоЗначению(СтрокаТаблицы.Ссылка) <> Неопределено;

		 Если ЗначениеЗаполнено(СтрокаТаблицы.Родитель) Тогда
			 СтрокаДерева =  тДерево.Строки.Найти(СтрокаТаблицы.Родитель, "Расположение",Истина);
			 Если СтрокаДерева <> Неопределено Тогда
				 ДобавитьСтрокуДеревева(СтрокаДерева.Строки, СтрокаТаблицы.Ссылка, Пометка);
			 КонецЕсли;
		 Иначе
			 Картинка = ДанныеКартинок.Получить(СтрокаТаблицы.Ссылка);
			 ДобавитьСтрокуДеревева(тДерево.Строки, СтрокаТаблицы.Ссылка, Пометка, Картинка);
		 КонецЕсли;
		 
	КонецЦикла;
	
	ЗначениеВРеквизитФормы(тДерево,"ДеревоЗначений"); 	
	
КонецПроцедуры


&НаСервере
Процедура ДобавитьСтрокуДеревева(СтрокиДерева, Расположение, Пометка, АдресКартинки = "")
	
	СтрокаДерева =	СтрокиДерева.Добавить();
	СтрокаДерева.Расположение 	= Расположение;
	СтрокаДерева.Пометка 		= Пометка;
	СтрокаДерева.Картинка       = АдресКартинки;
	
КонецПроцедуры

&НаСервере
Функция ПодготовитьКартинки()
	
	Соответствие = новый Соответствие;
	Соответствие.Вставить(Справочники.CW_РазделыРабочегоСтола.Автотранспорт	, БиблиотекаКартинок.CW_Машины);
	Соответствие.Вставить(Справочники.CW_РазделыРабочегоСтола.Мониторинг	, БиблиотекаКартинок.CW_Грузоперевозки);
	Соответствие.Вставить(Справочники.CW_РазделыРабочегоСтола.Финансы		, БиблиотекаКартинок.CW_ДеньгиНаличные);
	Соответствие.Вставить(Справочники.CW_РазделыРабочегоСтола.Документы		, БиблиотекаКартинок.CW_ДокументТекстовый);
	Соответствие.Вставить(Справочники.CW_РазделыРабочегоСтола.Отчеты		, БиблиотекаКартинок.CW_Отчеты);
	
	Возврат Соответствие;
	
КонецФункции

&НаСервере
Функция ПолучитьАдресСпискаРасположения()
	
	мМассивВыбранных = Новый Массив;
	
	тДерево = РеквизитФормыВЗначение("ДеревоЗначений"); 
	
	Отбор = Новый Структура("Пометка", истина);
	мПомеченныеСтроки = тДерево.Строки.НайтиСтроки(Отбор, Истина);
	
	Для Каждого СтрокаМассива из мПомеченныеСтроки Цикл
		
		мМассивВыбранных.Добавить(СтрокаМассива.Расположение);
		
	КонецЦикла;

	Возврат ПоместитьВоВременноеХранилище(мМассивВыбранных);
	
КонецФункции

&НаКлиенте
Процедура РасположениеПометкаПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ДеревоЗначений.ТекущиеДанные;
	
	Если ПроверитьНаСервере(ТекущиеДанные.Расположение) Тогда
		ПоказатьПредупреждение(,"Не допускается выбирать корневые группы!");
		ТекущиеДанные.Пометка = ложЬ;
	КонецЕсли
	
КонецПроцедуры

&НаСервере
Функция ПроверитьНаСервере(Расположение)
	
	Запрещено =	Запрещенные.НайтиПоЗначению(Расположение) <> Неопределено;
	
	Возврат Запрещено;	
	
КонецФункции

&НаКлиенте
Процедура ОткрытьСправочник(Команда)
	
	ОписаниеОповещения = новый ОписаниеОповещения("ОбновитьДеревоФормы",ЭтаФорма);
	ОткрытьФорму("Справочник.CW_РазделыРабочегоСтола.ФормаСписка",,,,,,ОписаниеОповещения);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьДеревоФормы(Резултат, Доппараметры) Экспорт
	
	ПодготовитьДеревоФормы();	
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаВыбрать(Команда)
	АдресСписка = ПолучитьАдресСпискаРасположения();
	ЭтаФорма.Закрыть(АдресСписка);
КонецПроцедуры
