&НаСервере
Процедура ОбработатьЗагрузкуОбъекта(Результат,ИмяЗагружаемогоФайла=Неопределено)
	// --- 
	
	СтруктураОписания = ПолучитьИзВременногоХранилища(Результат.СтруктураОписания);
	// --- 
	
	Если ИмяЗагружаемогоФайла <> Неопределено Тогда
		
		Объект.ИмяФайла = ИмяЗагружаемогоФайла;
		
	КонецЕсли; 
	
	_ПО.ЗаполнитьИнформациюПоОбработке(Объект,СтруктураОписания);
	
	ОбработкаЗагружена = Истина;
	Модифицированность = Истина;
	
	Если СтруктураОписания.Вид = "ВнешняяКоманда" Тогда
		ОбновитьВнешниеКомандыВРегистре = истина;
	КонецЕсли;

	Объект.ДатаЗаписи = ТекущаяДата();
	
	ПроверитьВстроеннуюОбработку();
	
	УстановитьПредупреждеиеНесоответствииВерсии();
	
	_УправлениеФормой();
	
	// --- 
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	Если (НЕ Объект.Встроенная и НЕ Объект.Отладка) ИЛИ Объект.НеИспользуется Тогда
		//Ничего не выбрано, ничего проверять не нужно.
		Возврат;
	КонецЕсли;
	
	Если НЕ Объект.Встроенная И НЕ ОбработкаЗагружена и НЕ Объект.Отладка Тогда
		
		Отказ = Истина;
		_УФК.ВывестиПредупреждение("Не загружена обработка.");
		
	КонецЕсли; 
	
	Если Объект.Вид = "ВнешняяФорма" и не ИспользованиеВнешнихПодключаемыхФормОбъектов Тогда
		ПоказатьПредупреждение(,"Для загрузки внешней подкючаемой формы объекта необходимо включить исползование внешних форм.");
		Отказ = истина;
	КонецЕсли;
	
	Если Объект.Отладка и Не ЗначениеЗаполнено(Объект.ОтладкаИмяОбработки) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не выбра файл внешней обработки",,"ОтладкаИмяОбработки","Объект", Отказ);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПоследний(Команда)
	
	Объект.Индекс = ПолучитьПоследний();
	
КонецПроцедуры

&НаСервере
Функция ПолучитьПоследний()
	
	Запрос = Новый запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	МАКСИМУМ(CW_ПодключаемыеОбъектыРасположениеОбъекта.Ссылка.Индекс) КАК Индекс
	|ИЗ
	|	Справочник.CW_ПодключаемыеОбъекты.РасположениеОбъекта КАК CW_ПодключаемыеОбъектыРасположениеОбъекта
	|ГДЕ
	|	НЕ CW_ПодключаемыеОбъектыРасположениеОбъекта.Ссылка.ПометкаУдаления
	|	И CW_ПодключаемыеОбъектыРасположениеОбъекта.Ссылка.РасполагатьНаРабочемСтоле
	|	И НЕ CW_ПодключаемыеОбъектыРасположениеОбъекта.Ссылка.НеИспользуется
	|	И CW_ПодключаемыеОбъектыРасположениеОбъекта.Расположение В(&мРасположение)";
	
	Запрос.УстановитьПараметр("мРасположение", Объект.РасположениеОбъекта.Выгрузить().ВыгрузитьКолонку("Расположение"));
	
	РезультатЗапроса = запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() тогда
		Возврат 0;
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат ?(ЗначениеЗаполнено(Выборка.Индекс),Выборка.Индекс + 1,0);
	КонецЕсли;
	
	Возврат 0;
	
КонецФункции

