&НаСервере
Функция ПолучитьАдресНастроекФормы()
	
	КомандаОтчета = Новый Структура("ИмяКартинки,ИмяКоманды,ПредставлениеКоманды","","","");
	
	Отбор = новый Структура;
	Отбор.Вставить("ОсновнаяКоманда", Истина);
	мКоманда = Объект.КомандыОбъекта.НайтиСтроки(Отбор);
	
	
	Если мКоманда.Количество() <> 0 Тогда
		//Основаня команда не указана!!!
		ЗаполнитьЗначенияСвойств(КомандаОтчета, мКоманда[0]);
		
	Иначе
		
		Если  Объект.КомандыОбъекта.Количество() > 0 Тогда
			//Берем первую!
			ЗаполнитьЗначенияСвойств(КомандаОтчета,  Объект.КомандыОбъекта[0]);
		КонецЕсли;
		
	КонецЕсли;
	
	СписокКомандОбъекта = новый СписокЗначений;
	Для Каждого СтрокаКоманд из Объект.КомандыОбъекта Цикл
		СписокКомандОбъекта.Добавить(СтрокаКоманд.ИмяКоманды, СтрокаКоманд.ПредставлениеКоманды);
	КонецЦикла;

	
	Настройки = Новый Структура;
	Настройки.Вставить("Индекс"					, Объект.Индекс);
	Настройки.Вставить("КомандаОтчета"			, КомандаОтчета);
	Настройки.Вставить("РасположениеОбъекта"	, Объект.РасположениеОбъекта.Выгрузить().ВыгрузитьКолонку("Расположение"));
	Настройки.Вставить("ДоступностьОбъекта" 	, Объект.ДоступностьОбъекта.Выгрузить().ВыгрузитьКолонку("ГруппаПользователей"));
	Настройки.Вставить("СписокКомандОбъекта"    , СписокКомандОбъекта);
	Настройки.Вставить("КомандыОбъекта"     	, Объект.КомандыОбъекта.Выгрузить());
	Настройки.Вставить("ЭтоОтчет"     			, ПолучитьТипОбъекта());
	
	Возврат ПоместитьВоВременноеХранилище(Настройки);
	
КонецФункции

&НаСервере
Функция ПолучитьТипОбъекта()
	
	Если Объект.Отладка Тогда
		//Из конфигурации
		Попытка
			ПодключенныйОтчет =	Отчеты[Объект.ИмяВстроеннойОбработки];
			Возврат истина;
		Исключение
		КонецПопытки;
	Иначе
		Если СтрНайти(Объект.ИмяФайла, "erf") > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

&НаКлиенте
Процедура ПриЗакрытиФормыНастроекВнешнегоОтчета(Результат, ДопПараметр) Экспорт
	
	Если Результат <> Неопределено Тогда
		ОбработатьРезультаНастроек(Результат);
		Модифицированность = истина;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбработатьРезультаНастроек(Результат)
	
	Если ЭтоАдресВременногоХранилища(Результат) Тогда
		
		Настройки = ПолучитьИзВременногоХранилища(Результат);
		
		КомандаОтчета = Настройки.КомандаОтчета;
		
		Для Каждого СтрокаКоманд из Объект.КомандыОбъекта Цикл
			СтрокаКоманд.ОсновнаяКоманда = ЛожЬ;
		КонецЦикла;
		
		Отбор = Новый Структура("ИмяКоманды",КомандаОтчета.ИмяКоманды);
		мКоманда = Объект.КомандыОбъекта.НайтиСтроки(Отбор);
		
		Если мКоманда.Количество() <> 0 Тогда
			мКоманда[0].ИмяКартинки 			= КомандаОтчета.ИмяКартинки;
			мКоманда[0].ПредставлениеКоманды 	= КомандаОтчета.ПредставлениеКоманды;
			мКоманда[0].ОсновнаяКоманда 		= истина;
		КонецЕсли;
		
		Объект.РасположениеОбъекта.Очистить();
		Объект.ДоступностьОбъекта.Очистить();
		
		Для Каждого СтрокаМассива из Настройки.ДоступностьОбъекта  Цикл
			  НоваяСтрока = Объект.ДоступностьОбъекта.Добавить();
			  НоваяСтрока.ГруппаПользователей = СтрокаМассива;		
		КонецЦикла;
		
		Для Каждого СтрокаМассива из Настройки.РасположениеОбъекта  Цикл
			  НоваяСтрока = Объект.РасположениеОбъекта.Добавить();
			  НоваяСтрока.Расположение = СтрокаМассива;		
		  КонецЦикла;
		  
		Объект.Индекс = Настройки.Индекс;

	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НастройкиВнешнейПодписки(Команда)
	
	Если Модифицированность ИЛИ Объект.Ссылка.Пустая() Тогда
		
		ПоказатьПредупреждение(,"Данные еще не записаны. Переход к форме внешней подписки возможен только после записи данных!");
		
	Иначе
		
		ОбработатьОткрытиеФормыВнешнейПодписки()
		
	КонецЕсли;
		
КонецПроцедуры


&НаКлиенте
Процедура НастройкиВнешнейФормы(Команда)
	
	Если Модифицированность ИЛИ Объект.Ссылка.Пустая() Тогда
		ПоказатьПредупреждение(,"Данные еще не записаны. Переход к подключаемой форме возможен только после записи данных!");
	Иначе
		ОбработатьОткрытиеПодключаемойФормы()
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьОткрытиеПодключаемойФормы()
	
	СсылкуНаПодключаемуюФорму = ПолучитьСсылкуНаПодключаемуюФорму();
	
	Если ЗначениеЗаполнено(СсылкуНаПодключаемуюФорму) Тогда
		ПоказатьЗначение(,СсылкуНаПодключаемуюФорму);
	Иначе
		
		ИдентификаторОбъектаМетаданных = ПолучитьИдентификаторОбъектаМетаданных();
		
		Если ИдентификаторОбъектаМетаданных <> Неопределено Тогда
			
			ПараметрыФормы = Новый Структура;
			ПараметрыФормы.Вставить("ЗначенияЗаполнения", Новый Структура ("ИдентификаторОбъектаМетаданных, ПодключаемыйОбъект", ИдентификаторОбъектаМетаданных, Объект.Ссылка));
			ПараметрыФормы.Вставить("Наименование"		, Объект.Наименование);
			
			ОткрытьФорму("Справочник.CW_ПодключаемыеФормы.ФормаОбъекта", ПараметрыФормы, ЭтаФорма, Истина);
		Иначе
			ПоказатьПредупреждение(,"Не удалось получить Идентификатор объекта метаданных");
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьИдентификаторОбъектаМетаданных()
	
	ИмяМетаданного =  Справочники.CW_ПодключаемыеФормы.ПолучитьИмяМетаданногоПодключаемойФормы(Объект.Ссылка);
	
	Если ИмяМетаданного <> Неопределено Тогда
		Возврат ОбщегоНазначения.ИдентификаторОбъектаМетаданных(ИмяМетаданного);
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

&НаСервере
Функция ПолучитьСсылкуНаПодключаемуюФорму()
	
	Возврат Справочники.CW_ПодключаемыеФормы.НайтиПоРеквизиту("ПодключаемыйОбъект", Объект.Ссылка);
	
КонецФункции

&НаКлиенте
Процедура ОбработатьОткрытиеФормыВнешнейПодписки()
	
	ДанныеПодписки = ПолучитьИнформациюВнешнейподписки();

	МетаданныеПодпискиКоличество = ДанныеПодписки.МетаданныеПодписки.Количество();
	
	мСвязанныеПодписки = ПолучитьСвязанныеВнешниеПодписки();
	
	Если мСвязанныеПодписки <> Неопределено Тогда
		
		Если мСвязанныеПодписки.Количество() > 0 Тогда
			
			Если МетаданныеПодпискиКоличество = 1 и мСвязанныеПодписки.Количество() = 1 Тогда
				
				ПоказатьЗначение(,мСвязанныеПодписки[0]);
				
			Иначе
				АдресСпискаЗначений = ПолучитьАдресСписакаСвязанныхПодписок(мСвязанныеПодписки, МетаданныеПодпискиКоличество);
				
				ПараметрыФормы = Новый Структура;
				ПараметрыФормы.Вставить("АдресСпискаЗначений"	, АдресСпискаЗначений);
				ПараметрыФормы.Вставить("СписокСПометками"		, Ложь);
				ПараметрыФормы.Вставить("ЗаголовокФормы"		, "Список связанных подписок");
				
				ОписаниеОповещения = новый ОписаниеОповещения("ПриЗакрытиФормыВыбораИзСписка", ЭтотОбъект);
				ОткрытьФорму("ОбщаяФорма.CW_ФормаВыбораИзСписка", ПараметрыФормы, ЭтаФорма, , , , ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
				
			КонецЕсли;
			
		КонецЕсли;
		
	Иначе
		
		ОткрытьФормуНовойВнешнейПодписки();
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьИнформациюВнешнейподписки()
	
	Возврат Справочники.CW_ВнешниеПодписки.ПолучитьДанныеВнешнейПдписки(Объект.Ссылка);
	
КонецФункции

&НаКлиенте
Процедура ОткрытьФормуНовойВнешнейПодписки()
	
	ДанныеПодписки = ПолучитьИнформациюВнешнейподписки();
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ЗначенияЗаполнения", Новый Структура ("ВидПодписки, Обработка", ДанныеПодписки.ВидПодписки, Объект.Ссылка));
	ПараметрыФормы.Вставить("Наименование"		, Объект.Наименование);
	
	ОткрытьФорму("Справочник.CW_ВнешниеПодписки.Форма.ФормаЭлемента", ПараметрыФормы, ЭтаФорма, Истина);
	
КонецПроцедуры

&наСервере
Функция ПолучитьАдресСписакаСвязанныхПодписок(мСвязанныеПодписки, ДоступноеКоличество)
	
	СписокПодписок = Новый СписокЗначений;
	СписокПодписок.ЗагрузитьЗначения(мСвязанныеПодписки);
	
	Если СписокПодписок.Количество() < ДоступноеКоличество Тогда
		СписокПодписок.Добавить("Создать", "<Создать новую>");
	КонецЕсли;
	
	Возврат ПоместитьВоВременноеХранилище(СписокПодписок);
	
КонецФункции

&НаКлиенте
Процедура ПриЗакрытиФормыВыбораИзСписка(Результат, ДопПараметр) Экспорт
	
	Если Результат <> Неопределено Тогда
		ЗначениеВыбора = ОбработатьРезультаВыбораЗначения(Результат);
		
		Если  ЗначениеЗаполнено(ЗначениеВыбора) Тогда
			
			Если ЗначениеВыбора = "Создать" Тогда
				//Создаем новую подписку на событие
				ОткрытьФормуНовойВнешнейПодписки();
				
			Иначе
				
				//Открываем выбранное значение
				ПоказатьЗначение(,ЗначениеВыбора);
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ОбработатьРезультаВыбораЗначения(Результат)
	
	Если ЭтоАдресВременногоХранилища(Результат) Тогда
		
		СтркутураОтвета = ПолучитьИзВременногоХранилища(Результат);
		Возврат СтркутураОтвета.Значение;
	КонецЕсли;
	
	Возврат Неопределено
	
КонецФункции

&НаСервере
Функция ПолучитьСвязанныеВнешниеПодписки()
	
	Возврат Справочники.CW_ПодключаемыеОбъекты.ПолучитьСвязанныеВнешниеПодписки(Объект.Ссылка); 
	
КонецФункции


&НаКлиенте
Процедура НастройкаВнешнейКоманды(Команда)
	
	АдресНастроек 		= Новый Структура("АдресНастроек", ПолучитьАдресНастроекВнешнейКоманды());
	ОписаниеОповещения = новый ОписаниеОповещения("ПриЗакрытиФормыНастроекВнешнейКоманды", ЭтаФорма);
	
	ОткрытьФорму("Справочник.CW_ПодключаемыеОбъекты.Форма.ФормаНастроекВнешнейКоманды",АдресНастроек, ЭтаФорма,,,,ОписаниеОповещения,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытиФормыНастроекВнешнейКоманды(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат <> Неопределено Тогда
		
		ОбработатьРезультатНастройкиВнешнейКоманды(Результат);
		
	КонецЕсли;
	
КонецПроцедуры
	
&НаСервере
Процедура ОбработатьРезультатНастройкиВнешнейКоманды(Результат)
	
	Если ЭтоАдресВременногоХранилища(Результат) Тогда
		
		Объект.ПараметрыВнешнейКоманды.Очистить();
		ТаблицаПараметров = ПолучитьИзВременногоХранилища(Результат);
		
		Для Каждого СтрокаТаблицыПараметров из ТаблицаПараметров Цикл
			НоваяСтрока = Объект.ПараметрыВнешнейКоманды.Добавить();
			
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицыПараметров);
			
			НоваяСтрока.АдресГруппДоступа = ПоместитьВоВременноеХранилище(СтрокаТаблицыПараметров.ГруппыДоступа.ВыгрузитьЗначения(),ЭтаФорма);
			
		КонецЦикла;
		
		Модифицированность 				= Истина;
		ОбновитьВнешниеКомандыВРегистре = Истина;
		
	КонеЦЕсли;
	
КонецПроцедуры
	

&НаСервере
Функция  ПолучитьАдресНастроекВнешнейКоманды()
	
	Возврат ПоместитьВоВременноеХранилище(Объект.ПараметрыВнешнейКоманды.Выгрузить());
	
КонецФункции


&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	Если ОбновитьВнешниеКомандыВРегистре Тогда
		Справочники.CW_ПодключаемыеОбъекты.ЗарегистрироватьВнешниеКоманды(Объект.Ссылка);
		ОбновитьВнешниеКомандыВРегистре = Ложь;
	КонецЕсли;
	
	Если ИзмененоИспользованиеОбработки Тогда
		
		Если ТекущийОбъект.НеИспользуется Тогда
			ОбработатьИспользованиеВнешнихПодписок();
			ОбработатьИспользованиеПодключаемыхФорм();
		КонецЕсли;
		
		ИзмененоИспользованиеОбработки = ложь;
		
	КонецЕсли;
	
	ОбновитьАдресаГруппДоступа();
	
КонецПроцедуры

&наСервере
Функция ПолучитьСоответствиеТипаОбработкиРодителю()
	
	Результат = Новый Соответствие;
	Результат.Вставить(ПредопределенноеЗначение("Перечисление.CW_ТипыПодключаемыхОбъектов.ВнешнийОтчет"), 		ПредопределенноеЗначение("Справочник.CW_ИдентификаторыПодключаемыхОбъектов.мдОтчеты"));
	Результат.Вставить(ПредопределенноеЗначение("Перечисление.CW_ТипыПодключаемыхОбъектов.ВнешняяОбработка"), 	ПредопределенноеЗначение("Справочник.CW_ИдентификаторыПодключаемыхОбъектов.мдОбработки"));
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура ОбработатьИспользованиеВнешнихПодписок()
	
	мВнешниеПодписки =	ПолучитьСвязанныеВнешниеПодписки();

	Если мВнешниеПодписки <> Неопределено Тогда
		Для Каждого Подписка из мВнешниеПодписки Цикл
			
			ПодпискаОбъект = Подписка.ПолучитьОбъект();
			ПодпискаОбъект.НеИспользуется = Истина;
			ПодпискаОбъект.Записать();
			
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

&наСервере
Процедура ОбработатьИспользованиеПодключаемыхФорм()
	
	ПодключаемаяФорма = ПолучитьСсылкуНаПодключаемуюФорму();

	Если ЗначениеЗаполнено(ПодключаемаяФорма) Тогда
		ПодключаемаяФормаОбъект 				= ПодключаемаяФорма.ПолучитьОбъект();
		ПодключаемаяФормаОбъект.НеИспользуется 	= Истина;
		ПодключаемаяФормаОбъект.Записать();
	КонецЕсли;
	
КонецПроцедуры
	

&НаКлиенте
Процедура НеИспользуетсяПриИзменении(Элемент)
	
	Если Объект.Вид = "ВнешняяКоманда" Тогда
		ОбновитьВнешниеКомандыВРегистре = Истина;
	КонецЕсли;
	
	ИзмененоИспользованиеОбработки = истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ИмяВстроеннойОбработкиПриИзменении(Элемент)
	
	ПроверитьВстроеннуюОбработку();
	
КонецПроцедуры

&НаКлиенте
Процедура ПеречитатьИнформациюОВнешнейОбработке(Команда)
	
	Результат = ПолучитьСтруктуруОписанияДляВстроеннойОбработки(Ложь);
	Если Результат.Код <> 0 Тогда
		ПоказатьПредупреждение(,Результат.ОписаниеОшибки,,"Ошибка загрузки внешней обработки");
		Возврат;
	Иначе
		ОбработатьЗагрузкуОбъекта(Результат);
	КонецЕсли; 
	
КонецПроцедуры

&НаСервере
Процедура ПроверитьВстроеннуюОбработку()
	
	Попытка
		Если Объект.ТипВнешнегоОбъекта = Перечисления.CW_ТипыПодключаемыхОбъектов.ВнешнийОтчет Тогда
			Менеджер = Отчеты[Объект.ИмяВстроеннойОбработки];
		Иначе
			Менеджер = Обработки[Объект.ИмяВстроеннойОбработки];
		КонецЕсли;                  
		Элементы.ИмяВстроеннойОбработки.ЦветТекстаЗаголовка	= Новый Цвет();
	Исключение
		Элементы.ИмяВстроеннойОбработки.ЦветТекстаЗаголовка	= Новый Цвет(255,0,0);
		Элементы.СтраницыОбъекта.ТекущаяСтраница 			= Элементы.Страница_ОписаниеОбъекта;
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура ШаблонПредставленияПечатнойФормыНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	// при нажатии выбора не обновлялся текст
	Объект.ШаблонПредставленияПечатнойФормы = ЭтаФорма.Элементы.ШаблонПредставленияПечатнойФормы.ТекстРедактирования;
	
	Если Объект.Макросы.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Для печатной формы не определены макросы формирования представления!");
		Возврат;
	КонецЕсли;
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("ПодключаемыйОбъект", Объект.Ссылка);
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ЗавершитьВыборМакроса", ЭтотОбъект);
	
	ОткрытьФорму("Справочник.CW_ПодключаемыеОбъекты.Форма.ФормаВыбраМакросов", СтруктураПараметров, ЭтотОбъект,,,, ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьВыборМакроса(РезультатВыбора, ДополнительныеПараметры) Экспорт
	
	Если РезультатВыбора = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Объект.ШаблонПредставленияПечатнойФормы = Объект.ШаблонПредставленияПечатнойФормы + РезультатВыбора;
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ИсторияИзменений(Команда)
	
	МакетИсторияИзменений = ПорлучитьИсториюИзмененийНаСервере();
	Если МакетИсторияИзменений <> Неопределено Тогда
		
		МакетИсторияИзменений.ОтображатьГруппировки = Истина;
		МакетИсторияИзменений.ОтображатьЗаголовки 	= Ложь;
		МакетИсторияИзменений.ОтображатьСетку 		= Ложь;
		МакетИсторияИзменений.ТолькоПросмотр 		= Истина;
		
		МакетИсторияИзменений.Показать("История изменений внешнего объекта");
		
	Иначе
		ПоказатьПредупреждение(,"Не удалось получить историю изменений внешнего объекта", 30);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПорлучитьИсториюИзмененийНаСервере()
	
	Попытка
		
		Если Объект.Встроенная Тогда
			Если Объект.ТипВнешнегоОбъекта = ПредопределенноеЗначение("Перечисление.CW_ТипыПодключаемыхОбъектов.ВнешнийОтчет") Тогда
				ВнешняяОбработка = Отчеты[Объект.ИмяВстроеннойОбработки].Создать();
			Иначе
				ВнешняяОбработка = Обработки[Объект.ИмяВстроеннойОбработки].Создать();
			КонецЕсли;                  
		Иначе   
			
			Если ЭтоАдресВременногоХранилища(АдресОбработки) Тогда
				ДвоичныеДанные = ПолучитьИзВременногоХранилища(АдресОбработки);
			КонецЕсли;  
			
			Если ДвоичныеДанные = Неопределено Тогда
				ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
				ДвоичныеДанные	= ОбработкаОбъект.ХранилищеОбработки.Получить();
			КонецЕсли;  
			
			Если ДвоичныеДанные = Неопределено Тогда
				Возврат Неопределено;
			КонецЕсли;
			
			ИмяФайлаОбработки 	= КаталогВременныхФайлов()+ Объект.ИмяФайла;
			ДвоичныеДанные.Записать(ИмяФайлаОбработки);
			
			Файл = Новый Файл(ИмяФайлаОбработки);
			Если Не Файл.Существует() Тогда
				Возврат Неопределено;
			КонецЕсли;
			
			Если Файл.Расширение = ".erf" Тогда
				ВнешняяОбработка = ВнешниеОтчеты.Создать(ИмяФайлаОбработки);
			ИначеЕсли Файл.Расширение = ".epf" Тогда
				ВнешняяОбработка = ВнешниеОбработки.Создать(ИмяФайлаОбработки);
			Иначе
				Возврат Неопределено;
			КонецЕсли;
			
		КонецЕсли;
		
		Попытка
			Возврат ВнешняяОбработка.ПолучитьМакетИсторииИзменений();
		Исключение
			Возврат Неопределено;
		КонецПопытки; 
		
	Исключение
		Возврат Неопределено;
	КонецПопытки; 
	
КонецФункции



#Область Подключаемые_внешние_команды

&НаКлиенте
Процедура ВнешняяКоманда_ВыполнитьКоманду(Команда)
	
	CW_ПодключаемыеКомандыКлиент.ВыполнитьВнешнююКоманду(ЭтотОбъект, Команда.Имя);

КонецПроцедуры

#КонецОбласти

