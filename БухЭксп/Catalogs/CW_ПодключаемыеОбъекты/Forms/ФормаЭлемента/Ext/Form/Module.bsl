&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ИспользованиеВнешнихПодключаемыхФормОбъектов 	= ПолучитьФункциональнуюОпцию("CW_ИспользованиеВнешнихПодключаемыхФормОбъектов");
	ИспользованиеВнешнихПодписок 					= ПолучитьФункциональнуюОпцию("CW_ИспользованиеВнешнихПодписок");
	
	ЭтаФорма.ТолькоПросмотр = (НЕ CW_ПраваДоступа.ПравоДоступно("УправлениеСистемнымиФункциями"));
	Если НЕ Объект.Ссылка.Пустая() И НЕ Объект.Встроенная Тогда
		ОбработкаЗагружена = Истина;
	КонецЕсли; 
	
	ВерсияПодсистемыОбъекта = ?(Объект.ВерсияПодсистемы = "", 			"0.0.0.0", Объект.ВерсияПодсистемы);
	МинимальнаяВерсияМодуля = ?(Объект.МинимальнаяВерсияМодуля = "", 	"0.0.0.0", Объект.МинимальнаяВерсияМодуля);
	
	ТекущаяВерсияМодуля = CW_ОбновлениеКонфигурацииСервер.УстановленнаяВерсияПодсистемы();
	
	ТекущаяВерсияПодсистемы = "";
	ВерсииПодсистемБЭ 		= _БЭ.ВерсииПодсистемБЭ();
	ВерсииПодсистемБЭ.Свойство("ВнешниеПодключаемыеОбъекты", ТекущаяВерсияПодсистемы);
	ТекущаяВерсияПодсистемы = ?(ЗначениеЗаполнено(ТекущаяВерсияПодсистемы), ТекущаяВерсияПодсистемы , "0.0.0.0");

	ОбновитьАдресаГруппДоступа();
	
	Если Объект.Встроенная Тогда
		ПроверитьВстроеннуюОбработку();
	КонецЕсли;
	
	_УправлениеФормой();
	
	УстановитьПредупреждеиеНесоответствииВерсии();
	
	//Внешние подклчюаемые команды
	CW_ПодключаемыеКомандыСервер.ПриСозданииНаСервере(ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьПредупреждеиеНесоответствииВерсии()
	
	Если Не ПроверитьМинимальнуюВерсию(МинимальнаяВерсияМодуля) Тогда 
		Элементы.ДекорацияСовместимость.Видимость = истина;
		Элементы.ДекорацияСовместимость.Заголовок = "Внешняя подключаемая обработка не соответствует минимальной весрии модуля: "+СокрЛП(МинимальнаяВерсияМодуля);
	КонецЕсли;
	
КонецПроцедуры  

&НаСервере
Функция ПроверитьМинимальнуюВерсию(МинимальнаяВерсия)
	
	Если Не ЗначениеЗаполнено(МинимальнаяВерсия) или МинимальнаяВерсия = "0.0.0.0" Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат СравнитьВерсии(ТекущаяВерсияМодуля, МинимальнаяВерсия);

КонецФункции  

 &НаСервере
Функция СравнитьВерсии(ТекущаяВерсия, МинимальнаяВерсия) Экспорт  
	
	Если СокрЛП(ТекущаяВерсия) = СокрЛП(МинимальнаяВерсия) Тогда
		Возврат Истина;
	КонецЕсли;
	
	мТекущаяВерсия 		= СтрРазделить(СокрЛП(ТекущаяВерсия),		".");
	мМинимальнаяВерсия	= СтрРазделить(СокрЛП(МинимальнаяВерсия),	".");
	
	Для Индекс = 0 по мТекущаяВерсия.ВГраница() Цикл
		
		индТекущаяВерсия 		= Число(мТекущаяВерсия.Получить(Индекс));
		индМинимальнаяВерсия 	= Число(мМинимальнаяВерсия.Получить(Индекс));
		
		Если индТекущаяВерсия > индМинимальнаяВерсия Тогда
			//Разряд текущей версии больше минимальной версии
			Возврат Истина;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Ложь;

КонецФункции // СравнитьВерсии()

&НаСервере
Процедура _УправлениеФормой()
	
	ЭтоВнешнийОтчет 	= Объект.ТипВнешнегоОбъекта = ПредопределенноеЗначение("Перечисление.CW_ТипыПодключаемыхОбъектов.ВнешнийОтчет");
	ЭтоВнешняяОбработка = Объект.ТипВнешнегоОбъекта = ПредопределенноеЗначение("Перечисление.CW_ТипыПодключаемыхОбъектов.ВнешняяОбработка");
	
	ПоказатьНастройкиПодписки 			= ЭтоВнешняяОбработка 	и Объект.Вид = "ВнешняяПодписка";
	ПоказатьНастройкиКоманды 			= (ЭтоВнешняяОбработка или ЭтоВнешнийОтчет)  и Объект.Вид = "ВнешняяКоманда";
	ПоказатьНастройкиПодключаемойФормы  = ЭтоВнешняяОбработка  и Объект.Вид = "ВнешняяФорма";
	
	Элементы.Отладка.Видимость 									= Не Объект.Встроенная;
	Элементы.Сохранить.Видимость 								= Не Объект.Встроенная;
	Элементы.ГруппаДанныеФайла.Видимость						= Не Объект.Встроенная;
	
	Элементы.ПеречитатьИнформациюОВнешнейОбработке.Видимость	= Объект.Встроенная;
	Элементы.ПредставлениеОбработки.Видимость 					= Объект.Встроенная;
	
	Элементы.ОтладкаИмяОбработки.Видимость 		= Объект.Отладка;
	Элементы.ИмяВстроеннойОбработки.Видимость 	= Объект.Встроенная;
	
	Элементы.Настройка.Видимость 				= Объект.Настройка;
	Элементы.НастройкиВнешнегоОтчета.Видимость  = Объект.РасполагатьНаРабочемСтоле;
	Элементы.НастройкиВнешнейПодписки.Видимость = ПоказатьнастройкиПодписки и ИспользованиеВнешнихПодписок;
	Элементы.НадписьВнешниеПодписки.Видимость   = ПоказатьнастройкиПодписки и НЕ ИспользованиеВнешнихПодписок;
	Элементы.НастройкаВнешнейКоманды.Видимость  = ПоказатьНастройкиКоманды;
	
	Элементы.НастройкиПодключаемойФормы.Видимость  	= ПоказатьНастройкиПодключаемойФормы и ИспользованиеВнешнихПодключаемыхФормОбъектов;
	Элементы.НадписьВнешниеФормы.Видимость 	 		= ПоказатьНастройкиПодключаемойФормы и Не ИспользованиеВнешнихПодключаемыхФормОбъектов;
	
	Элементы.НадписьНетНастроек.Видимость  = 	Не Объект.Настройка 				и 
												Не Объект.РасполагатьНаРабочемСтоле и 
												Не ПоказатьНастройкиПодписки 		и 
												Не ПоказатьНастройкиКоманды  		и
												НЕ ПоказатьНастройкиПодключаемойФормы;
												
	Элементы.ГруппаШаблонПредставления.Видимость = Объект.Вид = "ПечатнаяФорма";
	
	Элементы.ИсторияИзменений.Видимость			 = Объект.ИсторияИзменений;
	
КонецПроцедуры


&НаКлиенте
Процедура ВстроеннаяПриИзменении(Элемент)
	
	ОбработкаЗагружена = Ложь;
	
	Если Объект.Встроенная Тогда
		Объект.Отладка 		= Ложь;
		ОбработкаЗагружена 	= Истина;
		
	КонецЕсли;
	
	_УправлениеФормой();

КонецПроцедуры

// ---------------------------------------------------------------------------- 
&НаКлиенте
Процедура ЗагрузитьВнешнийФайл(Команда)
	
	СоответствиеФильтра = ПолучитьСоответствиеФильтровТипуОбъекта();
	
	Фильтр = СоответствиеФильтра.Получить(Объект.ТипВнешнегоОбъекта);
	Если Фильтр = Неопределено Тогда
		Фильтр = "Внешние обработки (*.epf)|*.epf|Внешние отчеты (*.erf)|*.erf";
	КонецЕсли;
	
	ДиалогОткрытияФайла 					= Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	ДиалогОткрытияФайла.ПолноеИмяФайла 		= "";
	ДиалогОткрытияФайла.Фильтр 				= Фильтр;
	ДиалогОткрытияФайла.МножественныйВыбор 	= Ложь;
	ДиалогОткрытияФайла.Заголовок 			= "Выберите внешний файл";
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ПродолжитьЗагрузкуФайла",ЭтотОбъект); 
	
	НачатьПомещениеФайла(ОписаниеОповещения, , ДиалогОткрытияФайла, Истина, УникальныйИдентификатор);
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьСоответствиеФильтровТипуОбъекта()
	
	Результат = Новый Соответствие;
	Результат.Вставить(ПредопределенноеЗначение("Перечисление.CW_ТипыПодключаемыхОбъектов.ВнешнийОтчет"), 		"Внешние отчеты (*.erf)|*.erf"); 
	Результат.Вставить(ПредопределенноеЗначение("Перечисление.CW_ТипыПодключаемыхОбъектов.ВнешняяОбработка"), 	"Внешние обработки (*.epf)|*.epf"); 
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ПродолжитьЗагрузкуФайла(Результат, Адрес, ПолноеИмя, ДополнительныеПараметры) Экспорт
	
	Если Не Результат Тогда
		Возврат;
	КонецЕсли;

	Файл = Новый Файл(ПолноеИмя);

	СтруктураОтвета = ПолучитьСтруктуруОписанияДляЗагруженнойОбработкиНаСервере(Файл.Имя, Файл.Расширение, Адрес);
	Если СтруктураОтвета.Код <> 0 Тогда
		ПоказатьПредупреждение(,СтруктураОтвета.ОписаниеОшибки,,"Ошибка загрузки внешней обработки");
		Возврат;
	КонецЕсли;
	
	СтруктураПараметровВОпроса = Новый Структура;
	СтруктураПараметровВОпроса.Вставить("СтруктураОтвета", 	СтруктураОтвета);
	СтруктураПараметровВОпроса.Вставить("Файл", 			Файл);
	
	Оповещение = Новый ОписаниеОповещения("ПродолжитьЗагрузкуФайлаПродолжение", ЭтотОбъект, СтруктураПараметровВОпроса);

	Если Объект.ИмяФайла <> Файл.Имя и ОбработкаЗагружена Тогда
		Режим = РежимДиалогаВопрос.ДаНет;
		
		СтрокаШабона = "Имя загружаемго файла ""%1"" отличается от загруженного ранее ""%2"". Продолжить?";
		ТекстВопроса = СтрШаблон(СтрокаШабона, Файл.Имя, Объект.ИмяФайла); 
		
		ПоказатьВопрос(Оповещение, ТекстВопроса, Режим, 0);
		
	Иначе
		ВыполнитьОбработкуОповещения(Оповещение,  КодВозвратаДиалога.Да);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПродолжитьЗагрузкуФайлаПродолжение(Результат, ДополнительныеПараметры) Экспорт
    Если Результат = КодВозвратаДиалога.Нет Тогда
        Возврат;
	КонецЕсли;
	
	Файл = ДополнительныеПараметры.Файл;

	ОписаниеОповещения = Новый ОписаниеОповещения("ОбработкаПолученияВремениИзмененияФайла",ЭтотОбъект);
	Файл.НачатьПолучениеВремениИзменения(ОписаниеОповещения);
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ОбработкаПолученияРазмераФайла",ЭтотОбъект);
	Файл.НачатьПолучениеРазмера(ОписаниеОповещения);
	
	ОбработатьЗагрузкуОбъекта(ДополнительныеПараметры.СтруктураОтвета, Файл.Имя);
	
	ПоказатьОповещениеПользователя("Загрузка внешнего файла",, Файл.Имя,,,УникальныйИдентификатор);

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаПолученияРазмераФайла(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат <> Неопределено Тогда
		Объект.РазмерФайла = Результат;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаПолученияВремениИзмененияФайла(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат <> Неопределено Тогда
		Объект.ДатаИзмененияФайла = Результат;
	КонецЕсли;
	
КонецПроцедуры
	
// ---------------------------------------------------------------------------- 

&НаСервере
Функция ПолучитьСтруктуруОписанияДляЗагруженнойОбработкиНаСервере(ИмяФайла, Расширение, АдресФайла)
	
	СтруктураОтвета = Новый Структура("Код,СтруктураОписания,ОписаниеОшибки");

	Попытка
		
		ДвоичныеДанные 		= ПолучитьИзВременногоХранилища(АдресФайла);
		ИмяФайлаОбработки 	= КаталогВременныхФайлов()+ ИмяФайла;
		
		ДвоичныеДанные.Записать(ИмяФайлаОбработки);
		
		АдресОбработки = ПоместитьВоВременноеХранилище(ДвоичныеДанные,ЭтаФорма.УникальныйИдентификатор);
		
		Если Расширение = ".erf" Тогда
			ВнешняяОбработка = ВнешниеОтчеты.Создать(ИмяФайлаОбработки);
		ИначеЕсли Расширение = ".epf" Тогда
			ВнешняяОбработка = ВнешниеОбработки.Создать(ИмяФайлаОбработки);
		Иначе
			СтруктураОтвета.Вставить("Код", 1);
			СтруктураОтвета.Вставить("ОписаниеОшибки","Неправильный тип файла ("+Расширение+")!");
			Возврат СтруктураОтвета;
		КонецЕсли;
		
		СтруктураОписания 	= ВнешняяОбработка.Информация();
		ВнешняяОбработка 	= Неопределено;       
		
		Если Не ПроверитьМинимальнуюВерсию(СтруктураОписания.МинимальнаяВерсияМодуля) Тогда
			СтруктураОтвета.Вставить("Код", 1);
			СтруктураОтвета.Вставить("ОписаниеОшибки","Внешняя подключаемая обработка не соответствует минимальной весрии модуля: "+СокрЛП(СтруктураОписания.МинимальнаяВерсияМодуля));
			Возврат СтруктураОтвета;
		КонецЕсли;

		СтруктураОтвета.Вставить("Код", 0);
		СтруктураОтвета.Вставить("СтруктураОписания", ПоместитьВоВременноеХранилище(СтруктураОписания,ЭтаФорма.УникальныйИдентификатор));
		
	Исключение
			СтруктураОтвета.Вставить("Код", 1);
			СтруктураОтвета.Вставить("ОписаниеОшибки",ОписаниеОшибки());
			
	КонецПопытки; 
	
	Возврат СтруктураОтвета;
	
КонецФункции

&НаСервере
Функция ПолучитьСтруктуруОписанияДляВстроеннойОбработки(ПроверятьМинимальнуюВерсию = Истина)
	
	СтруктураОтвета = Новый Структура("Код,СтруктураОписания,ОписаниеОшибки");
	
	Попытка
		Если ЗначениеЗаполнено(Объект.ТипВнешнегоОбъекта) Тогда 
			Если Объект.ТипВнешнегоОбъекта = ПредопределенноеЗначение("Перечисление.CW_ТипыПодключаемыхОбъектов.ВнешнийОтчет") Тогда
				ВнешняяОбработка = Отчеты[Объект.ИмяВстроеннойОбработки].Создать();
			Иначе
				ВнешняяОбработка = Обработки[Объект.ИмяВстроеннойОбработки].Создать();
			КонецЕсли;
		Иначе
			Если НЕ Неопределено = Метаданные.Отчеты.Найти(Объект.ИмяВстроеннойОбработки) Тогда 
				ВнешняяОбработка = Отчеты[Объект.ИмяВстроеннойОбработки].Создать();
			Иначе
				ВнешняяОбработка = Обработки[Объект.ИмяВстроеннойОбработки].Создать();
			КонецЕсли;
		КонецЕсли;
	Исключение    
		СтруктураОтвета.Вставить("Код", 1);
		СтруктураОтвета.Вставить("ОписаниеОшибки",ОписаниеОшибки());
	КонецПопытки; 
	
	Попытка
		СтруктураОписания 	= ВнешняяОбработка.Информация();
		ВнешняяОбработка 	= Неопределено;   
		
		Если ПроверятьМинимальнуюВерсию Тогда
			Если Не ПроверитьМинимальнуюВерсию(СтруктураОписания.МинимальнаяВерсияМодуля) Тогда
				СтруктураОтвета.Вставить("Код", 1);
				СтруктураОтвета.Вставить("ОписаниеОшибки","Внешняя подключаемая обработка не соответствует минимальной весрии модуля: "+СокрЛП(СтруктураОписания.МинимальнаяВерсияМодуля));
				Возврат СтруктураОтвета;
			КонецЕсли;                          
		КонецЕсли;
		
		СтруктураОтвета.Вставить("Код", 0);
		СтруктураОтвета.Вставить("СтруктураОписания", ПоместитьВоВременноеХранилище(СтруктураОписания,ЭтаФорма.УникальныйИдентификатор));
		
		Возврат СтруктураОтвета;
		
	Исключение
		СтруктураОтвета.Вставить("Код", 1);
		СтруктураОтвета.Вставить("ОписаниеОшибки",ОписаниеОшибки());
	КонецПопытки; 
	
	Возврат СтруктураОтвета;

КонецФункции

// ---------------------------------------------------------------------------- 

&НаКлиенте
Процедура Сохранить(Команда)
	
	Если Объект.Ссылка.Пустая() Тогда
		Возврат;
	КонецЕсли;   
	
	ДанныеФайла = ПолучитьДанныеФайла(Объект.Ссылка);
	Если ДанныеФайла = Неопределено Тогда
		ПоказатьПредупреждение(, "Ошибка получения файла");
		Возврат;
	КонецЕсли;

	ОписаниеПередаваемогоФайла = Новый ОписаниеПередаваемогоФайла;
	ОписаниеПередаваемогоФайла.Имя 		= ДанныеФайла.ИмяФайла;
	ОписаниеПередаваемогоФайла.Хранение = ДанныеФайла.АдресФайла;
	
