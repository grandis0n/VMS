&НаКлиенте
Процедура ПродолжитьВыборВстроеннойОбработки(Результат, Дополнительныепараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Объект.ИмяВстроеннойОбработки 	= Результат.Имя;
	Объект.ПредставлениеОбработки 	= Результат.Представление;
	Объект.ТипВнешнегоОбъекта 		= Результат.ТипВнешнегоОбъекта;
	
	Результат = ПолучитьСтруктуруОписанияДляВстроеннойОбработки();
	
	Если Результат.Код <> 0 Тогда
		ПоказатьПредупреждение(, Результат.ОписаниеОшибки,,"Ошибка загрузки внешней обработки");
		Возврат;
	КонецЕсли;
	
	ОбработатьЗагрузкуОбъекта(Результат);
	
	УстановитьПредупреждеиеНесоответствииВерсии();
	
КонецПроцедуры

&НаКлиенте
Процедура ОтладкаИмяОбработкиНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если Объект.ТипВнешнегоОбъекта = ПредопределенноеЗначение("Перечисление.CW_ТипыПодключаемыхОбъектов.ВнешнийОтчет") Тогда
		Фильтр = "Внешние отчеты (*.erf)|*.erf";
	Иначе
		Фильтр = "Внешние обработки (*.epf)|*.epf";
	КонецЕсли;
	
	ДиалогОткрытияФайла 					= Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	ДиалогОткрытияФайла.ПолноеИмяФайла 		= "";
	ДиалогОткрытияФайла.Фильтр 				= Фильтр;
	ДиалогОткрытияФайла.МножественныйВыбор 	= Ложь;
	ДиалогОткрытияФайла.Заголовок 			= "Выберите внешний файл";
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ПродолжитьЗагрузкуФайлаОтладки",ЭтотОбъект); 
	
	НачатьПомещениеФайла(ОписаниеОповещения, , ДиалогОткрытияФайла, Истина, УникальныйИдентификатор);
	
КонецПроцедуры

&НаКлиенте
Процедура ПродолжитьЗагрузкуФайлаОтладки(Результат, Адрес, ПолноеИмя, ДополнительныеПараметры) Экспорт
	
	Если Не Результат Тогда
		Возврат;
	КонецЕсли;
	
	Файл = новый Файл(ПолноеИмя);
	
	Если Файл.Существует() Тогда
		Объект.ОтладкаИмяОбработки = Файл.ПолноеИмя;
		Объект.ИмяВнешнегоОбъекта  = ПолучитьИмяВнешнейОбработки();
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ПолучитьИмяВнешнейОбработки()
	
	ИмяВнешнегоОбъекта ="";
	
	Если Объект.ТипВнешнегоОбъекта = ПредопределенноеЗначение("Перечисление.CW_ТипыПодключаемыхОбъектов.ВнешнийОтчет") Тогда
		Менеджер = ВнешниеОтчеты;
	Иначе
		Менеджер = ВнешниеОбработки;
	КонецЕсли;
	
	Попытка
		стрВнешнийОбъект = СокрЛП(Менеджер.Создать(Объект.ОтладкаИмяОбработки));
	Исключение
	КонецПопытки;
	
	мДанныеОбъекта = СтрРазделить(стрВнешнийОбъект,".",Ложь);
	Если мДанныеОбъекта.Количество() > 0 Тогда
		ИмяВнешнегоОбъекта = мДанныеОбъекта[1];
	КонецЕсли;
	
	Возврат	ИмяВнешнегоОбъекта;
	
КонецФункции

