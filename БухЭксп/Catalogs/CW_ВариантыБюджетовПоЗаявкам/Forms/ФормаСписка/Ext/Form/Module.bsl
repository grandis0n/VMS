КонецПроцедуры    

&НаКлиенте
Процедура ПослеЗакрытияВопросаБюджетРазблокировать(Результат, Параметры) Экспорт
    Если Результат = КодВозвратаДиалога.Нет Тогда
        Возврат;
    КонецЕсли;

	БюджетРазблокироватьнаСервере();
	
	Оповестить("Запись_ВариантыБюджетов");

КонецПроцедуры 


&НаСервере
Процедура БюджетБлокироватьНаСервере() 
	
	ТекущаяСтрока = Элементы.Список.ТекущаяСтрока; 
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;  
	
	Запись = РегистрыСведений.CW_УтверждениеБюджетов.СоздатьМенеджерЗаписи();
	Запись.ВерсияБюджета = ТекущаяСтрока.Ссылка;
	Запись.Объект 		 = ТекущаяСтрока.Владелец;
	Запись.Записать();       
	
	Заблокирован = истина;
	Элементы.ФормаБюджетБлокировать.Доступность 	= Не Заблокирован и УтверждениеБюджетов;
	Элементы.ФормаБюджетРазблокировать.Доступность 	= Заблокирован и ОтменаУтвержденияБюджетов;

	ЗаписатьИсториюУтвержденияБюджета(ТекущаяСтрока, Истина); 
	
	Элементы.Список.Обновить();
	
КонецПроцедуры

&НаСервере
Процедура БюджетРазблокироватьнаСервере()
	
	ТекущаяСтрока = Элементы.Список.ТекущаяСтрока; 
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Запись = РегистрыСведений.CW_УтверждениеБюджетов.СоздатьМенеджерЗаписи();
	Запись.ВерсияБюджета = ТекущаяСтрока.Ссылка;
	Запись.Объект 		 = ТекущаяСтрока.Владелец;  
	Запись.Прочитать();
	
	Если Запись.Выбран() Тогда
		Запись.Удалить();
		ЗаписатьИсториюУтвержденияБюджета(ТекущаяСтрока);
	КонецЕсли;
	
	Заблокирован = Ложь;
	Элементы.ФормаБюджетБлокировать.Доступность 	= Не Заблокирован и УтверждениеБюджетов;
	Элементы.ФормаБюджетРазблокировать.Доступность 	= Заблокирован и ОтменаУтвержденияБюджетов;

	Элементы.Список.Обновить();

КонецПроцедуры


&НаСервере
Процедура ЗаписатьИсториюУтвержденияБюджета(ТекущаяСтрока, Заблокирован = Ложь)
	
	УстановитьПривилегированныйРежим(Истина); 
	
	Запись = РегистрыСведений.CW_ИсторияУтверждениеБюджетов.СоздатьМенеджерЗаписи();
	Запись.Период 		 = ТекущаяДата();
	Запись.ВерсияБюджета = ТекущаяСтрока.Ссылка;
	Запись.Объект 		 = ТекущаяСтрока.Владелец;  
	Запись.Пользователь  = CW_Настройки.Пользователь();
	Запись.ПризнакУтверждения = Заблокирован;

	Запись.Записать(Истина);

КонецПроцедуры

