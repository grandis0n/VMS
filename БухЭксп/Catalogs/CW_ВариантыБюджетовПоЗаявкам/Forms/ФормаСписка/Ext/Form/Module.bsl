&НаСервере
Процедура _ПраваДоступа()
	// --- 
	
	ПравоРедактирования = Истина; //(CW_ПраваДоступа.ПравоДоступно("???")
	Если НЕ ПравоРедактирования Тогда

		Элементы.Список.ИзменятьСоставСтрок = Ложь;
		Элементы.Список.ТолькоПросмотр = Истина;
		
	КонецЕсли;
	
	Элементы.ФормаОтборСортировка.Видимость = CW_Настройки.ПолучитьНастройкуПользователя(, "РежимОтладкиВключен");
	
	// --- 
КонецПроцедуры

