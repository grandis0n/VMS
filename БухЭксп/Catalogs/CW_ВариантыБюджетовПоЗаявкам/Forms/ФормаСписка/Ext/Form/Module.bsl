&НаСервере
Функция _СохранитьСеансовуюНастройку()
	// --- 
	
	_УФС.СохранитьСеансовыеНастройки(ЭтаФорма,,_ПФ_НастройкаСписка().СписокКолонок);
	
	// --- 
КонецФункции

&НаСервере
Функция _ЗагрузитьСеансовуюНастройку()
	// --- 
	
	Настройка = _УФС.ЗагрузитьСеансовыеНастройки(ЭтаФорма);
	_ОбработатьНастройкуСписка(Настройка);
	
	// --- 
КонецФункции

