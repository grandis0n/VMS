Процедура СохранитьНастройку(НастройкаСсылка,Настройка) Экспорт 
	
	НастройкаОбъект = НастройкаСсылка.ПолучитьОбъект();
	НастройкаОбъект.Настройка = Новый ХранилищеЗначения(Настройка);
	НастройкаОбъект.Записать();
	
КонецПроцедуры

Функция ЗагрузитьНастройку(НастройкаСсылка) Экспорт 
	
	
	Настройки = НастройкаСсылка.Настройка.Получить();
	Возврат(Настройки);	
	
	
КонецФункции

