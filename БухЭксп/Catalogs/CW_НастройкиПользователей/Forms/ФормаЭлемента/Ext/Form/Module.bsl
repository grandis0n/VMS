
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если (НЕ Объект.Ссылка.Пустая()) Тогда
		
		ТекущийПользователь = CW_Настройки.Пользователь();
		Если (ТекущийПользователь <> Объект.Пользователь) 
			И НЕ Пользователи.ЭтоПолноправныйПользователь(,Истина) Тогда
			
			ЭтаФорма.ТолькоПросмотр 					= Истина;
			Элементы.Родитель.Доступность 				= Ложь;
			Элементы.ГруппаОбщийДоступ.Доступность		= Ложь;
			Элементы.ОграничениеДоступа.Доступность 	= Ложь;
			Элементы.ФормаЗагрузитьИзФайла.Доступность 	= Ложь;
			
		КонецЕсли; 
		
	КонецЕсли; 
	
	Элементы.ФормаСохранитьВФайл.Видимость = (НЕ Объект.Ссылка.Пустая());
	Элементы.ФормаЗагрузитьИзФайла.Видимость = (НЕ Объект.Ссылка.Пустая());
	
	_УправлениеЭлементамиФормы();
	//Внешние подклчюаемые команды
	CW_ПодключаемыеКомандыСервер.ПриСозданииНаСервере(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	ОповеститьОЗаписиНового(Объект.Ссылка);
	
КонецПроцедуры

