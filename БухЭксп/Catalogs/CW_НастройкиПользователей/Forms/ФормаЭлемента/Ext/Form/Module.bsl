&НаКлиенте
Процедура ЗагрузитьИзФайла(Команда)
	
	ПОВ = Новый ОписаниеОповещения("ОбработкаВыбораФайлаНастройки",ЭтотОбъект, Новый Структура()); 
	ДиалогВыбораФайла = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	ДиалогВыбораФайла.МножественныйВыбор = Ложь;
	ДиалогВыбораФайла.Заголовок = "Выберите файл настройки";
	ДиалогВыбораФайла.Фильтр = НСтр("ru = 'Настройка списка'; en = 'List settings'") + "(*.ls)|*.ls";
	// --- 
	ДиалогВыбораФайла.Показать(ПОВ);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбораФайлаНастройки(Файлы, ДополнительныеПараметры) Экспорт 
	// --- 
	
	Если (Файлы <> Неопределено) Тогда
		
		Если (Файлы.Количество() <> 0) Тогда
			
			ПередатьФайлНастройкиНаСервер(Файлы[0]);
			
		КонецЕсли; 
		
	КонецЕсли; 
	
	// --- 
КонецПроцедуры

&НаКлиенте
Процедура ПередатьФайлНастройкиНаСервер(Файл)
	// --- 
	
	ПОВ = Новый ОписаниеОповещения("ОбработкаЗагрузкиФайлаНаСервер",ЭтотОбъект, Новый Структура()); 
	НачатьПомещениеФайла(ПОВ,,Файл,Ложь,ЭтаФорма.УникальныйИдентификатор);
	
	// --- 
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаЗагрузкиФайлаНаСервер(Результат,Адрес,ИмяФайла, ДополнительныеПараметры) Экспорт 
	// --- 
	
	Если (Результат <> Неопределено) Тогда
		
		Если (Результат) Тогда
			
			Ответ = _ПрочитатьНастройкуНаСервере(Адрес);
			Если (_УФКС.ВыполненоУспешно(Ответ)) Тогда
				Прочитать();
			Иначе
				ПоказатьПредупреждение(,_УФКС.ПредставлениеОшибки(Ответ));
			КонецЕсли; 
			
		КонецЕсли; 
		
	КонецЕсли; 
	
	// --- 
КонецПроцедуры

&НаСервере
Функция _ПрочитатьНастройкуНаСервере(АдресФайлаНастройки)
	// --- 
	
	Попытка
		
		ДД = ПолучитьИзВременногоХранилища(АдресФайлаНастройки);
		ИмяВременногоФайла = ПолучитьИмяВременногоФайла("ls");
		ДД.Записать(ИмяВременногоФайла);
		// --- 
		ТекстовыйДокумент = Новый ТекстовыйДокумент;
		ТекстовыйДокумент.Прочитать(ИмяВременногоФайла,КодировкаТекста.UTF8);
		СтрокаНастройки = ТекстовыйДокумент.ПолучитьТекст();
		СтруктураНастройки = ЗначениеИзСтрокиВнутр(СтрокаНастройки);
		ТекстовыйДокумент = Неопределено;
		УдалитьФайлы(ИмяВременногоФайла);
		// --- 
		НастройкаОбъект = Объект.Ссылка.ПолучитьОбъект();
		НастройкаОбъект.Настройка = Новый ХранилищеЗначения(СтруктураНастройки);
		НастройкаОбъект.Записать();
		
	Исключение
		
		Возврат(_УФКС.Ответ(1,ОписаниеОшибки()));
		
	КонецПопытки; 
	
	Возврат(_УФКС.Ответ());
		
	// --- 
КонецФункции

