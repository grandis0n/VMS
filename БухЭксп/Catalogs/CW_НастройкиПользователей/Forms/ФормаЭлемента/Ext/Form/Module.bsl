&НаКлиенте
Процедура СохранитьВФайл(Команда)
	
	СФ = _ПолучитьСтруктураФайла();
	// --- 
	МассивПередаваемыхФайлов = Новый Массив;
	МассивПередаваемыхФайлов.Добавить(Новый ОписаниеПередаваемогоФайла(СФ.Имя,СФ.Адрес));
	// --- 
	ПОВ = Новый ОписаниеОповещения("ОбработкаСохраненияФайлаНастройки",ЭтотОбъект, Новый Структура()); 
	НачатьПолучениеФайлов(ПОВ,МассивПередаваемыхФайлов,,Истина);
	
КонецПроцедуры

&НаСервере
Функция _ПолучитьСтруктураФайла()
	// --- 
	
	Настройка = Объект.Ссылка.Настройка.Получить();
	СтрокаНастройки = ЗначениеВСтрокуВнутр(Настройка);
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла("ls");
	// --- 
	ТекстовыйФайл = Новый ТекстовыйДокумент;
	ТекстовыйФайл.ДобавитьСтроку(СтрокаНастройки);
	ТекстовыйФайл.Записать(ИмяВременногоФайла,КодировкаТекста.UTF8);
	// --- 
	ДД = Новый ДвоичныеДанные(ИмяВременногоФайла);
	УдалитьФайлы(ИмяВременногоФайла);
	АдресФайла = ПоместитьВоВременноеХранилище(ДД,ЭтаФорма.УникальныйИдентификатор);
	// --- 
	СФ = Новый Структура("Адрес,Имя",АдресФайла,Объект.Наименование+".ls");
	// --- 
	Возврат(СФ);
	
	// --- 
КонецФункции
 
&НаКлиенте
Процедура ОбработкаСохраненияФайлаНастройки(ПолученныеФайлы, ДополнительныеПараметры) Экспорт 
	// --- 
	
	Если (ПолученныеФайлы <> Неопределено) Тогда
		
		Состояние("Файл настройки сохранён.");
		
	КонецЕсли; 
	
	// --- 
КонецПроцедуры

