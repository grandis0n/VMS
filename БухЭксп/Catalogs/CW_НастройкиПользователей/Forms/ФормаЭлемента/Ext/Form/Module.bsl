&НаСервере
Процедура _УправлениеЭлементамиФормы()
	// --- 
	
	Элементы.ГруппаОбщийДоступ.Видимость = Элементы.ГруппаОбщийДоступ.Доступность;
	// --- 
	Элементы.ОграничениеДоступа.Видимость = Объект.ОбщаяНастройка;
	Элементы.ПраваДоступа.Видимость = Объект.ОграничениеДоступа;
	
	// --- 
КонецПроцедуры


&НаКлиенте
Процедура ОбщаяНастройкаПриИзменении(Элемент)
	
	Если (НЕ Объект.ОбщаяНастройка) Тогда
		Объект.ОграничениеДоступа = Ложь;
		Объект.ПраваДоступа.Очистить();
	КонецЕсли; 
	_УправлениеЭлементамиФормы();
	
КонецПроцедуры


&НаКлиенте
Процедура ОграничениеДоступаПриИзменении(Элемент)
	
	_УправлениеЭлементамиФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура ПраваДоступаВладелецПраваДоступаПриИзменении(Элемент)
	ПраваДоступаВладелецПраваДоступаПриИзмененииНаСервере();
КонецПроцедуры

&НаСервере
Процедура ПраваДоступаВладелецПраваДоступаПриИзмененииНаСервере()
	
	Для каждого Стр Из Объект.ПраваДоступа Цикл
		
		Если ((ТипЗнч(Стр.ВладелецПраваДоступа)=Тип("СправочникСсылка.Пользователи"))) Тогда
			Стр.ИндексКартинки = 1;	
		КонецЕсли; 
		
	КонецЦикла; 
	
КонецПроцедуры

