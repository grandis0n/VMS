&НаКлиенте
Процедура ДеревоНастроекПеретаскивание(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Строка, Поле)
	
	СтандартнаяОбработка=Ложь;
	
	// проверяем что и куда мы перетащили
	Если (ТипЗнч(ПараметрыПеретаскивания.Значение) = Тип("Число")) Тогда
		
		СтрокаЧто = ДеревоНастроек.НайтиПоИдентификатору(ПараметрыПеретаскивания.Значение);
		СтрокаКуда = ДеревоНастроек.НайтиПоИдентификатору(Строка);
		
		Если (СтрокаЧто.ТолькоПросмотр ИЛИ СтрокаКуда.ТолькоПросмотр) Тогда
			
			Возврат;
			
		КонецЕсли; 
		
		_УстановитьРодителя(ПараметрыПеретаскивания.Значение,Строка);
		СформироватьДерево();
		
	КонецЕсли; 
		
КонецПроцедуры

&НаСервере
Процедура _УстановитьРодителя(ИдентификаторЭлемента, ИдентификаторГруппы)
	// --- 
	
	СтрокаЭлемента = ДеревоНастроек.НайтиПоИдентификатору(ИдентификаторЭлемента);
	СтрокаГруппы = ДеревоНастроек.НайтиПоИдентификатору(ИдентификаторГруппы);
	
	Если (СтрокаГруппы.ЭтоГруппа) Тогда
		
		ЭлементАрхива = СтрокаЭлемента.Ссылка.ПолучитьОбъект();
		ЭлементАрхива.Родитель = СтрокаГруппы.Ссылка;
		ЭлементАрхива.Записать();
		
		ТекущийРодительУзла = ЭлементАрхива.Родитель;
		
	КонецЕсли; 
	
	// --- 
