&НаКлиенте
Процедура УдалитьФайл(Команда)
	
	Если (Элементы.ДеревоНастроек.ТекущиеДанные <> Неопределено) Тогда
		
		ТребуетсяПодтверждение = Ложь;
		Если (Элементы.ДеревоНастроек.ТекущиеДанные.ЭтоГруппа) Тогда
			
			Если (Элементы.ДеревоНастроек.ТекущиеДанные.ПолучитьЭлементы().Количество() <> 0) Тогда
				
				ТребуетсяПодтверждение = Истина;
				
			КонецЕсли; 
			
		КонецЕсли; 
		
		Если (ТребуетсяПодтверждение) Тогда
			
			ПОВ = Новый ОписаниеОповещения("ВыполнитьУдалениеФайла",ЭтотОбъект, Новый Структура());
			ПоказатьВопрос(ПОВ,"Удалить группу файлов?",РежимДиалогаВопрос.ДаНет);
			
		Иначе
			
			ВыполнитьУдалениеФайла(КодВозвратаДиалога.Да,Неопределено);
			
		КонецЕсли; 
		
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьУдалениеФайла(Ответ, ДополнительныеПараметры) Экспорт 
	// --- 
	
	Если (Ответ = КодВозвратаДиалога.Да) Тогда
		
		РезультатУдаления = _УдалитьФайл(Элементы.ДеревоНастроек.ТекущиеДанные.Ссылка);
		Если (_УФКС.ВыполненоУспешно(РезультатУдаления)) Тогда
			ТекущийУзел = Неопределено;
			ТекущийИдентификатор = 0;
			СформироватьДерево();
		КонецЕсли; 
		
	КонецЕсли; 
	
	// --- 
КонецПроцедуры
  
 
&НаСервере
Функция _УдалитьФайл(Ссылка)
	// --- 
	
	Попытка
		
		Если (Ссылка.ЭтоГруппа) Тогда
			
			// получаем подчиненные и удаляем
			Запрос = Новый Запрос;
			Запрос.Текст = "ВЫБРАТЬ
			               |	CW_НастройкиПользователей.Ссылка
			               |ИЗ
			               |	Справочник.CW_НастройкиПользователей КАК CW_НастройкиПользователей
			               |ГДЕ
			               |	CW_НастройкиПользователей.Родитель = &Родитель";
			Запрос.УстановитьПараметр("Родитель", Ссылка);
			ТЗ = Запрос.Выполнить().Выгрузить();
			// --- 
			Для каждого Стр Из ТЗ Цикл
				
				Ответ = _УдалитьФайл(Стр.Ссылка);
				Если (НЕ _УФКС.ВыполненоУспешно(Ответ)) Тогда
					
					Сообщить(_УФКС.ПредставлениеОшибки(Ответ));
					Возврат(Ответ);
					
				КонецЕсли; 
				
			КонецЦикла; 
			
		КонецЕсли; 
		
		УстановитьПривилегированныйРежим(Истина);
		Об = Ссылка.ПолучитьОбъект();
		Об.Удалить();
		
	Исключение
		
		Сообщить(ОписаниеОшибки());
		Возврат(_УФКС.Ответ(1));
		
	КонецПопытки; 
	
	Возврат(_УФКС.Ответ());
	
	// --- 
КонецФункции

