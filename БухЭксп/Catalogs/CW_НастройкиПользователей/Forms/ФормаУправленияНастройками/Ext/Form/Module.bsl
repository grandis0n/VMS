&НаКлиенте
Процедура ДеревоНастроекПередУдалением(Элемент, Отказ)
	
	Если (Элементы.ДеревоНастроек.ТекущиеДанные <> Неопределено) Тогда
		
		Отказ = Истина;
		ТребуетсяПодтверждение = Ложь;
		Если (Элементы.ДеревоНастроек.ТекущиеДанные.ЭтоГруппа) Тогда
			
			Если (Элементы.ДеревоНастроек.ТекущиеДанные.Ссылка = ПредопределенноеЗначение("Справочник.CW_НастройкиПользователей.ПустаяСсылка")) Тогда
				
				Отказ = Истина;
				_УФК.ВывестиПредупреждение("Корневую группу нельзя удалить");
				Возврат;
				
			КонецЕсли; 
			
			Если (Элементы.ДеревоНастроек.ТекущиеДанные.ПолучитьЭлементы().Количество() <> 0) Тогда
				
				ТребуетсяПодтверждение = Истина;
				
			КонецЕсли; 
			
		КонецЕсли; 
		
		Если (Элементы.ДеревоНастроек.ТекущиеДанные.ТолькоПросмотр) Тогда
			
			Если Не ЭтоПолноправныйПользователь() Тогда 
				Отказ = Истина;
				_УФК.ВывестиПредупреждение("Общую настройку нельзя удалить.");
				Возврат;
			КонецЕсли;   
			
		КонецЕсли;  
		
		ТекстВопроса = "";
		Если Элементы.ДеревоНастроек.ТекущиеДанные.ТолькоПросмотр Тогда
			ТекстВопроса = "Настройка является общей. Внесение в настройку изменений повлияет на работу других пользователей. ";
		КонецЕсли;
		
	
		// подтверждение в случае удаления группы настроек
		Если (ТребуетсяПодтверждение) Тогда
			
			ТекстВопроса = ТекстВопроса + "Удалить группу настроек?";
			
			ПОВ = Новый ОписаниеОповещения("ВыполнитьУдалениеФайла",ЭтотОбъект, Новый Структура());
			ПоказатьВопрос(ПОВ,ТекстВопроса,РежимДиалогаВопрос.ДаНет);
			
			
			// при удаления выбранной настройки, лишний раз убеждаемся в том, 
			// что действие пользователя осознанное
		Иначе
			
			ТекстВопроса = ТекстВопроса + "Подтвердите удаление настройки (отменить удаление будет невозможно)?";
	
			ПОВ = Новый ОписаниеОповещения("ВыполнитьУдалениеФайла",ЭтотОбъект, Новый Структура());
			ПоказатьВопрос(ПОВ, ТекстВопроса,РежимДиалогаВопрос.ДаНет);
			
			//	ВыполнитьУдалениеФайла(КодВозвратаДиалога.Да,Неопределено);
			
		КонецЕсли;   
		
	КонецЕсли; 
	
КонецПроцедуры  

