
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Параметры.Свойство("КлючОбъекта",КлючОбъекта);
	Параметры.Свойство("РежимОткрытия", РежимОткрытия);
	Параметры.Свойство("РежимВыбора", Элементы.ДеревоНастроек.РежимВыбора);
	
	Параметры.Свойство("СкрытьВозможностьОтбора", СкрытьВозможностьОтбора);
	
	ТекущийПользователь= CW_Настройки.Пользователь();
	// --- 
	
	Элементы.ДеревоНастроекКомандаВыбрать.КнопкаПоУмолчанию = Истина;
	Если (РежимОткрытия = "Сохранение") Тогда
		
		Заголовок = "Сохранение настроек";
		Элементы.ДеревоНастроек.ИзменятьСоставСтрок = Истина;
		Элементы.ФормаГруппаСоздание.Видимость = Истина;
		Элементы.ДеревоНастроекКомандаВыбрать.Заголовок = "Сохранить";
		Попытка
			Элементы.ДеревоНастроекКомандаВыбрать.Картинка=БиблиотекаКартинок.СохранитьФайл;	
		Исключение
		    Элементы.ДеревоНастроекКомандаВыбрать.Картинка=БиблиотекаКартинок.СохранитьФайл;
		КонецПопытки; 
		
		// --- 
		Элементы.ГруппаПараметры.Видимость = Ложь;
		// --- 
		Элементы.НеВосстанавливатьОтбор.Видимость = Ложь;
		
		Элементы.ДеревоНастроекДобавить.Видимость = Истина;
		Элементы.ДеревоНастроекКомандаДобавитьГруппу.Видимость = Истина;
		
	Иначе
		
		Заголовок = "Загрузка настроек";
		Элементы.ФормаГруппаСоздание.Видимость = Ложь;
		Элементы.ДеревоНастроек.ИзменятьСоставСтрок = Ложь;
		Элементы.ДеревоНастроекКомандаВыбрать.Заголовок = "Загрузить";
		Попытка
			Элементы.ДеревоНастроекКомандаВыбрать.Картинка=БиблиотекаКартинок.ЗагрузитьФайл;	
		Исключение
		    Элементы.ДеревоНастроекКомандаВыбрать.Картинка=БиблиотекаКартинок.ЗагрузкаФайла;
		КонецПопытки; 
		
		Элементы.ГруппаПараметры.Видимость = Ложь;
		Элементы.НеВосстанавливатьОтбор.Видимость = Не СкрытьВозможностьОтбора;
		
		Если (Параметры.Свойство("ИмяФормыВладельца")) Тогда
			
			УФ = Новый Структура("ИмяФормы",Параметры.ИмяФормыВладельца);
			Если (CW_Журналы_Сервер.ЭтоФормаЗаказа(УФ) ИЛИ CW_Журналы_Сервер.ЭтоФормаЗаявки(УФ)) Тогда
				НеВосстанавливатьОтбор = Истина;
				Элементы.НеВосстанавливатьОтбор.Доступность=Ложь;
			КонецЕсли;  
			
		КонецЕсли; 
		
	КонецЕсли; 
	
	_СформироватьДерево();
	
КонецПроцедуры

// ---------------------------------------------------------------------------- 

&НаКлиенте
Процедура СформироватьДерево()
	// --- 
	
	СохранитьВидДерева();
	_СформироватьДерево();
	ВосстановитьВидДерева();
	
	// --- 
КонецПроцедуры

&НаКлиенте
Процедура СохранитьВидДерева()
	// --- 
	
	СостояниеДерева.Очистить();
	// --- 
	КореньДерева = Неопределено;
	СтрокиДерева = ДеревоНастроек.ПолучитьЭлементы();
	Если (СтрокиДерева.Количество() <> 0) Тогда
		ОпределитьСтатусУзла(СтрокиДерева[0]);
	КонецЕсли; 
	
	// --- 
КонецПроцедуры

&НаКлиенте
Функция ОпределитьСтатусУзла(Узел)
	// --- 
	
	Если (Узел.ЭтоГруппа) Тогда
		
		СостояниеДерева.Добавить(Узел.Ссылка,,Элементы.ДеревоНастроек.Развернут(Узел.ПолучитьИдентификатор()));
		// --- 
		Для каждого ПУ Из Узел.ПолучитьЭлементы() Цикл
			
			ОпределитьСтатусУзла(ПУ);
			
		КонецЦикла; 
		
	КонецЕсли; 
	
	// --- 
КонецФункции

&НаКлиенте
Процедура ВосстановитьВидДерева()
	// --- 
	
	ИдентификаторТекущегоУзла = 0;
	
	Если (СостояниеДерева.Количество() <> 0) Тогда
		
		СтрокиДерева = ДеревоНастроек.ПолучитьЭлементы();
		ТекущаяСтрокаВосстановлена = Ложь;
		Если (СтрокиДерева.Количество() <> 0) Тогда
			
			Для каждого СтрокаДерева Из СтрокиДерева Цикл
				ВосстановитьСтатусУзла(СтрокаДерева);	
				Если (НЕ ТекущаяСтрокаВосстановлена) Тогда
					Если (ИдентификаторТекущегоУзла <> 0) Тогда
						Элементы.ДеревоНастроек.ТекущаяСтрока = ИдентификаторТекущегоУзла;	
						ТекущаяСтрокаВосстановлена=Истина;
					КонецЕсли; 	
				КонецЕсли; 
				
			КонецЦикла; 
			
		КонецЕсли; 
		
	КонецЕсли; 
	
	// --- 
КонецПроцедуры

&НаКлиенте
Функция ВосстановитьСтатусУзла(Узел)
	// --- 
	
	СсылкаУзла = Узел.Ссылка;
	ТекущийИдентификатор = Узел.ПолучитьИдентификатор();
	// --- 
	Если (Узел.ЭтоГруппа) Тогда
		
		
		ЗаписьСтатуса = СостояниеДерева.НайтиПоЗначению(СсылкаУзла);
		Если (ЗаписьСтатуса <> Неопределено) Тогда
			
			Если (ЗаписьСтатуса.Пометка) Тогда
				
				Элементы.ДеревоНастроек.Развернуть(ТекущийИдентификатор);
				
			КонецЕсли; 
			
			Если (СсылкаУзла = ТекущийРодительУзла ИЛИ СсылкаУзла = ТекущийУзел) Тогда
				
				ИдентификаторТекущегоУзла = ТекущийИдентификатор;
				
			КонецЕсли; 
			
		Иначе
			
			Элементы.ДеревоНастроек.Развернуть(Узел.ПолучитьИдентификатор());
			
		КонецЕсли; 
		
		Для каждого ПУ Из Узел.ПолучитьЭлементы() Цикл
			
			ВосстановитьСтатусУзла(ПУ);
			
		КонецЦикла; 
		
	Иначе
		
		Если (СсылкаУзла = ТекущийУзел) Тогда
			
			ИдентификаторТекущегоУзла = ТекущийИдентификатор;
			
		КонецЕсли; 
		
	КонецЕсли; 
	
	// --- 
КонецФункции

// --- 

&НаСервере
Функция _ОпределитьУровеньГруппы(Группа, СоответствиеУровней)
	// --- 
	
	Если (Группа.Родитель.Пустая()) Тогда
		
		УровеньРодителя = 0;
		
	Иначе
		
		УровеньРодителя = СоответствиеУровней.Получить(Группа.Родитель);
		Если (УровеньРодителя = Неопределено) Тогда
			УровеньРодителя = _ОпределитьУровеньГруппы(Группа.Родитель, СоответствиеУровней);
		КонецЕсли; 
		
	КонецЕсли; 
	// --- 
	Возврат(1+УровеньРодителя);
	
	// --- 
КонецФункции
 
&НаСервере
Процедура _СформироватьВеткуДерева(СтрокаТЗ, ТЗ, Родитель=Неопределено)
	// --- 
	
	Если (СтрокаТЗ.СтрокаСформирована) Тогда
		
		Возврат;
		
	КонецЕсли; 
	
	Если (Родитель = Неопределено) Тогда
		
		Нстр = ДеревоНастроек.ПолучитьЭлементы().Добавить();
		
	Иначе
		
		Нстр = Родитель.ПолучитьЭлементы().Добавить();
		Нстр.ТолькоПросмотр = Родитель.ТолькоПросмотр;
		
	КонецЕсли; 
	
	Нстр.Ссылка 	= СтрокаТЗ.Ссылка;
	Нстр.ЭтоГруппа 	= СтрокаТЗ.ЭтоГруппа;
	Нстр.Автор 		= СтрокаТЗ.Автор;
	СтрокаТЗ.СтрокаСформирована = Истина;
	Если (СтрокаТЗ.ЭтоГруппа) Тогда
		
		Нстр.ИндексКартинки = 0;
		Нстр.Описание = СтрокаТЗ.Описание;
		// --- 
		Отбор = Новый Структура("Родитель",Нстр.Ссылка);
		ТаблицаПодчиненных = _сф.к_НайтиСтроки(ТЗ,Отбор);
		Для каждого СтрокаПодчиненного Из ТаблицаПодчиненных Цикл
			_СформироватьВеткуДерева(СтрокаПодчиненного, ТЗ, Нстр);
		КонецЦикла; 
		// --- 
		//КоличествоПодчиненных = ТаблицаПодчиненных.Количество();
		//ПредставлениеКоличества = ?(КоличествоПодчиненных <> 0," ("+Формат(КоличествоПодчиненных)+")",""); 
		//Нстр.Представление = СтрокаТЗ.Наименование + ПредставлениеКоличества;
		Нстр.Представление = СтрокаТЗ.Наименование;
		
	Иначе
		
		Нстр.ИндексКартинки = 1;
		// --- 
		Нстр.Представление = СтрокаТЗ.Наименование;
		Нстр.Описание = СтрокаТЗ.Описание;
		
	КонецЕсли; 
	
	// --- 
КонецПроцедуры

// --- 

&НаСервере
Процедура _СформироватьДерево()
	// --- 
	
	// очищаем дерево
	ДеревоНастроек.ПолучитьЭлементы().Очистить();
	// ---------------------------------------------------------------------------- 
	
	#Область ЛичныеНастройки 
	
	Нстр = ДеревоНастроек.ПолучитьЭлементы().Добавить();
	Нстр.Ссылка = Справочники.CW_НастройкиПользователей.ПустаяСсылка();
	Нстр.ЭтоГруппа = Истина;
	Нстр.Представление = "Личные";
	Нстр.Описание = "Личные настройки";
	// --- 
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	CW_НастройкиПользователей.Ссылка КАК Ссылка,
	               |	CW_НастройкиПользователей.Родитель КАК Родитель,
	               |	CW_НастройкиПользователей.Наименование КАК Наименование,
	               |	0 КАК Уровень,
	               |	CW_НастройкиПользователей.ЭтоГруппа КАК ЭтоГруппа,
	               |	CW_НастройкиПользователей.Описание КАК Описание,
	               |	ЛОЖЬ КАК СтрокаСформирована,
	               |	CW_НастройкиПользователей.Пользователь КАК Автор
	               |ИЗ
	               |	Справочник.CW_НастройкиПользователей КАК CW_НастройкиПользователей
	               |ГДЕ
	               |	CW_НастройкиПользователей.Пользователь = &Пользователь
	               |	И CW_НастройкиПользователей.КлючОбъекта = &КлючОбъекта
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Наименование
	               |АВТОУПОРЯДОЧИВАНИЕ";
	Запрос.УстановитьПараметр("Пользователь", ТекущийПользователь);
	Запрос.УстановитьПараметр("КлючОбъекта", КлючОбъекта); 
	// --- 
	ТЗ_ЛичныеНастройки = Запрос.Выполнить().Выгрузить();
	
	УровниГрупп = Новый Соответствие;
	Для каждого Стр Из ТЗ_ЛичныеНастройки Цикл
		
		Если (Стр.ЭтоГруппа) Тогда
			
			УровниГрупп.Вставить(Стр.Ссылка,_ОпределитьУровеньГруппы(Стр.Ссылка,УровниГрупп));
			
		КонецЕсли; 
		
	КонецЦикла; 
	
	ТЗ_ЛичныеНастройки.Сортировать("ЭтоГруппа Убыв,Уровень Убыв");
	// --- 
	Для каждого Стр Из ТЗ_ЛичныеНастройки Цикл
		
		_СформироватьВеткуДерева(Стр, ТЗ_ЛичныеНастройки, Нстр);
		
	КонецЦикла; 
	
	#КонецОбласти 
	
	#Область ОбщиеНастройки
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	CW_НастройкиПользователей.Ссылка КАК Ссылка,
	               |	CW_НастройкиПользователей.Родитель КАК Родитель,
	               |	CW_НастройкиПользователей.Наименование КАК Наименование,
	               |	0 КАК Уровень,
	               |	CW_НастройкиПользователей.ЭтоГруппа КАК ЭтоГруппа,
	               |	CW_НастройкиПользователей.Описание КАК Описание,
	               |	ЛОЖЬ КАК СтрокаСформирована,
	               |	CW_НастройкиПользователей.ОграничениеДоступа КАК ОграничениеДоступа,
	               |	CW_НастройкиПользователей.Пользователь КАК Автор
	               |ИЗ
	               |	Справочник.CW_НастройкиПользователей КАК CW_НастройкиПользователей
	               |ГДЕ
	               |	CW_НастройкиПользователей.Пользователь <> &Пользователь
	               |	И CW_НастройкиПользователей.ОбщаяНастройка = ИСТИНА
	               |	И CW_НастройкиПользователей.ЭтоГруппа = ЛОЖЬ
	               |	И CW_НастройкиПользователей.КлючОбъекта = &КлючОбъекта";
	Запрос.УстановитьПараметр("Пользователь", ТекущийПользователь);
	Запрос.УстановитьПараметр("КлючОбъекта", КлючОбъекта);
	ТЗ_ОбщиеНастройки = Запрос.Выполнить().Выгрузить();
	// --- 
	МассивУдаляемых = Новый Массив;
	Для каждого Стр Из ТЗ_ОбщиеНастройки Цикл
		
		Если (Стр.ОграничениеДоступа) Тогда
			
			// проверяем 
			ДоступноПользователю = Стр.Ссылка.ПраваДоступа.Найти(ТекущийПользователь,"ВладелецПраваДоступа");
			Если (ДоступноПользователю = Неопределено) Тогда
				
				// проверяем группу
				ГруппаПользователя = CW_ПраваДоступа_ПИ.ГруппаПользователя(ТекущийПользователь);
				ДоступноПользователю = Стр.Ссылка.ПраваДоступа.Найти(ГруппаПользователя,"ВладелецПраваДоступа");
				
			КонецЕсли; 
			Если (ДоступноПользователю = Неопределено) Тогда
				
				МассивУдаляемых.Добавить(Стр);
				
			КонецЕсли; 
			
		КонецЕсли; 
		
	КонецЦикла; 
	_сф.к_УдалитьЭлементыПоМассиву(ТЗ_ОбщиеНастройки,МассивУдаляемых);
	
	// --- 
	
	Нстр = ДеревоНастроек.ПолучитьЭлементы().Добавить();
	Нстр.Ссылка = Справочники.CW_НастройкиПользователей.ПустаяСсылка();
	Нстр.ЭтоГруппа = Истина;
	Нстр.Представление = "Общие";
	Нстр.Описание = "Настройки других пользователей в общем доступе";
	Нстр.ИндексКартинки = 2;
	Нстр.ТолькоПросмотр = Истина;
	
	// --- 
	Для каждого Стр Из ТЗ_ОбщиеНастройки Цикл
		
		_СформироватьВеткуДерева(Стр, ТЗ_ОбщиеНастройки, Нстр);
		
	КонецЦикла; 
	
	#КонецОбласти 
	
	// --- 
КонецПроцедуры

// --- 

&НаКлиенте
Процедура ДеревоНастроекВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если (НЕ Элементы.ДеревоНастроек.ТекущиеДанные.ЭтоГруппа) Тогда
		
		Если (РежимОткрытия = "Сохранение") Тогда
			
			СтандартнаяОбработка = ложь;
			
			Режим = РежимДиалогаВопрос.ДаНет;
			Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаОСохраненииНастройкиВыбор", ЭтаФорма, Параметры);
			ПоказатьВопрос(Оповещение,"Сохраненная настройка будет заменена текущей. Продолжить?" , Режим, 0); 
			
			
		Иначе
			
			ВернутьЗначениеЗагрузки(Элементы.ДеревоНастроек.ТекущиеДанные.Ссылка);
			
		КонецЕсли;
		
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияВопросаОСохраненииНастройкиВыбор(Результат, Параметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Нет Тогда
		ЭтаФорма.Закрыть(Неопределено);
		Возврат;
	КонецЕсли;
	
	Если (НЕ Элементы.ДеревоНастроек.ТекущиеДанные.ТолькоПросмотр) Тогда
		ВернутьЗначениеСохранения(Элементы.ДеревоНастроек.ТекущиеДанные.Ссылка);
	Иначе
		_УФК.ВывестиПредупреждение("Изменение общих настроек запрещено.");
	КонецЕсли; 
	
КонецПроцедуры


&НаКлиенте
Процедура КомандаВыбрать(Команда)
	
	Если (Элементы.ДеревоНастроек.ТекущиеДанные.Ссылка <> Неопределено) Тогда
		
		Если (НЕ Элементы.ДеревоНастроек.ТекущиеДанные.ЭтоГруппа) Тогда
			
			Если (РежимОткрытия = "Сохранение") Тогда
				
				Режим = РежимДиалогаВопрос.ДаНет;
				Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаОСохраненииНастройки", ЭтаФорма, Параметры);
				ПоказатьВопрос(Оповещение,"Сохраненная настройка будет заменена текущей. Продолжить?" , Режим, 0); 
					
			Иначе
				
				ВернутьЗначениеЗагрузки(Элементы.ДеревоНастроек.ТекущиеДанные.Ссылка);
				
			КонецЕсли; 
			
		КонецЕсли; 
		
	КонецЕсли; 
	
КонецПроцедуры


&НаКлиенте
Процедура ПослеЗакрытияВопросаОСохраненииНастройки(Результат, Параметры) Экспорт
	Если Результат = КодВозвратаДиалога.Нет Тогда
		
		ЭтаФорма.Закрыть(Неопределено);
		
		Возврат;
	КонецЕсли;
	
	Если (НЕ Элементы.ДеревоНастроек.ТекущиеДанные.ТолькоПросмотр) ИЛИ ЭтоПолноправныйПользователь() Тогда
		ВернутьЗначениеСохранения(Элементы.ДеревоНастроек.ТекущиеДанные.Ссылка);
	Иначе
