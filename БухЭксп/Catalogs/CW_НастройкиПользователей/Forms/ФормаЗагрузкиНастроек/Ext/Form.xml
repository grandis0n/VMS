	СправочникНастройкиПользователей.Настройка,
	СправочникНастройкиПользователей.ОбщаяНастройка КАК ОбщаяНастройка
ИЗ
	Справочник.CW_НастройкиПользователей КАК СправочникНастройкиПользователей
ГДЕ
	СправочникНастройкиПользователей.ПометкаУдаления = ЛОЖЬ
	И СправочникНастройкиПользователей.КлючОбъекта = &amp;КлючОбъекта
	И (СправочникНастройкиПользователей.Пользователь = &amp;ТекущийПользователь
			ИЛИ СправочникНастройкиПользователей.ОбщаяНастройка = ИСТИНА)</QueryText>
