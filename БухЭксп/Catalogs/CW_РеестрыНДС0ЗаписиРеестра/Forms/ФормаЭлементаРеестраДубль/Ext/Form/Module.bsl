
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	УстановитьПустойМакет = Ложь;
	Если Параметры.Ключ.Пустая() тогда    
		Если Не ЗначениеЗаполнено(Объект.ПериодОтчета) Тогда
			Объект.ПериодОтчета = НачалоКвартала(ТекущаяДата()); 
		Конецесли;
		УстановитьПустойМакет = Истина;
	Конецесли;   
	
	СтруктураРаскраски = Новый Структура;
	СтруктураРаскраски.Вставить("_0", Новый Цвет(255, 255, 192)); //Разрешено
	СтруктураРаскраски.Вставить("_1", Новый Цвет(255, 255, 255)); //Запрещено

	мСтруктураЦветовРаскраски = Новый ФиксированнаяСтруктура(СтруктураРаскраски); 
	
	ИсключитьПустоеЗначение = Новый Массив;
	ИсключитьПустоеЗначение.Добавить("");
	ТаблицаКодовОпераций0.Загрузить(УчетНДС.КлассификаторКодовОперацийПоСтавке0(Объект.ПериодОтчета,,ИсключитьПустоеЗначение));
	
	ЗаполнитьДанныеФормыПриложения();
	
	Если УстановитьПустойМакет тогда     
		Макет = CW_РеестрыНДС0Дополнительный.ПолучитьМакетПоИмени(ИмяМакета);
		ТабличныйДокумент = CW_РеестрыНДС0Дополнительный.ПолучитьНачальныйТабличныйДокумент(Макет, СтруктураПриложения);
	Конецесли;     
	
	Для Каждого Область из ТабличныйДокумент.Области Цикл
		УстановитьДоступностьОбласти(Область.Имя);
	КонецЦикла;
	
	УстановитьТребованиеЗаполнения();
		
	CW_РеестрыНДС0Дополнительный.ЗаполнитьТЗВыбора(ТЗВыбора, Объект.ПриложениеПриказа, ЗаголовокВыбора);
	
	ЗаполнитьДеревоФайлов();

	СоответствиеПриложенияИмениФормыОтчета = CW_РеестрыНДС0Дополнительный.ПолучитьСоответствиеПриложенияИмениФормыОтчета();
	ИмяФОрмыОтчета = СоответствиеПриложенияИмениФормыОтчета.Получить(Объект.ПриложениеПриказа);
	
	УстановитьНадписьПредупреждения();
	УстановитьПредставлениеПериода(); 
	УстановитьДоступностьКомандыЗаполнить();     
	
	ПредыдущийДокументРеализации 	= Объект.ДокументРеализации;
	ПредыдущийДокументДоходов 		= Объект.ДокументДоходов;
	
	ПоказатьСкрытьФайлыНаСервере();
	
	УстановитьЗаголовокФормы(Параметры.Ключ.Пустая());  
	
	УстановитьСостояниеОбъекта();
	
	ЗапретАвтоматическогоУдаленияПриИзмененииНаСервере();
	
КонецПроцедуры    

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)

	ВремТабличныйДокумент = ТекущийОбъект.ДанныеПриложенияТабличныйДокумент.Получить();	

	ТабличныйДокумент.Очистить();
	ТабличныйДокумент.Вывести(ВремТабличныйДокумент);
	
КонецПроцедуры  

&НаСервере
Процедура УстановитьСостояниеОбъекта()
	
	ИндексКартинкиРучноеРедактирование = ?(Объект.РучноеРедактирование, 9, 0);
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	УстановитьЗаголовокФормы();

КонецПроцедуры

&НаСервере
Процедура УстановитьЗаголовокФормы(ЭтоНовый=Ложь)
	
	Заголовок = "Реестр по НДС: "+ СокрЛП(Объект.ПриложениеПриказа)+" ("+СокрЛП(Объект.ПриложениеРеестра)+")" + " за " + Формат(Объект.ПериодОтчета,"ДФ='к ""квартал"" гггг ""г.""'") + " (" + СокрЛП(Объект.Приказ) + ") " + ?(ЭтоНовый," - создание","");

КонецПроцедуры  

&НаСервере
Функция ЗаполнитьДанныеФормыПриложения()
	
	//Нужно перезаполнить данные прилдожения
	СоответствиеПриложенияИмениМакета = CW_РеестрыНДС0Дополнительный.ПолучитьСоответствиеПриложенияИмениМакета(Объект.Приказ);
	ИмяМакета = СоответствиеПриложенияИмениМакета.Получить(Объект.ПриложениеПриказа); 
	
	Если Не ПустаяСтрока(ИмяМакета) Тогда
		УстановитьСтруктуруПриложения();
	КонецЕсли;
	
	Возврат Не ПустаяСтрока(ИмяМакета);
		
КонецФункции    

&НаСервере
Функция ПолучитьПриложениеПриказа()
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	CW_РеестрыНДС0ЯчейкиПриложений.Ссылка КАК Ссылка
	               |ИЗ
	               |	ПланВидовХарактеристик.CW_РеестрыНДС0ЯчейкиПриложений КАК CW_РеестрыНДС0ЯчейкиПриложений
	               |ГДЕ
	               |	CW_РеестрыНДС0ЯчейкиПриложений.ЭтоГруппа = ИСТИНА
	               |	И CW_РеестрыНДС0ЯчейкиПриложений.Родитель = &Приказ
	               |	И CW_РеестрыНДС0ЯчейкиПриложений.ПриложениеПоВидуТранспорта = &ВидТранспорта";
	
	Запрос.УстановитьПараметр("Приказ",  		Объект.Приказ);
	Запрос.УстановитьПараметр("ВидТранспорта",  Объект.ПриложениеРеестра);  
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
КонецФункции


&НаСервере
Процедура СформироватьМногострочныеЧастиТабличногоДокумента(Макет, ВремТабличныйДокумент, СтрокиДерева, ИмяГруппы,  Координаты = "")
	
	Если НЕ СтруктураПриложения.Свойство(ИмяГруппы) Тогда
		Возврат;
	КонецЕсли;   
	
	НачИндекс = "_1";
	
	мКоординаты = СтрРазделить(Координаты, "_"); 
	НачКоординаты = "";
	Для Индекст = 0 по мКоординаты.ВГраница() Цикл
		НачКоординаты = НачКоординаты +"_1";
	КонецЦикла;
	
	СтруктураОтбора = новый Структура;
	СтруктураОтбора.Вставить("МногострочнаяЧасть", ИмяГруппы);
	
	мСтрокиДерева = СтрокиДерева.НайтиСтроки(СтруктураОтбора); 
	Для Индекс = 0  по мСтрокиДерева.ВГраница() Цикл  
		
		СтрокаДерева 			= мСтрокиДерева.Получить(Индекс);
		НовИндекс 				= СтрокаСИндексомПоказателя(Индекс+1);
		ОбластьМногострочная 	= Макет.ПолучитьОбласть("МногострочнаяЧасть"+ИмяГруппы);   
		
		МассивИменГраф = СтруктураПриложения[ИмяГруппы]["Графы"];
		Для каждого ИмяГрафы Из МассивИменГраф Цикл 
			
			Для Каждого ОбластьЯчейки из ОбластьМногострочная.Области Цикл
				Если СтрНачинаетсяС(ОбластьЯчейки.Имя, ИмяГрафы) Тогда
					Прервать;
				КонецЕсли;
			КонецЦикла;
			
			НовИмяОбл = ИмяГрафы + Координаты + НовИндекс;
			ОбластьЯчейки.Имя 		= НовИмяОбл;
			ОбластьЯчейки.Значение  = СтрокаДерева.Данные[НовИмяОбл];
		КонецЦикла;
		
		//область "Удалить строку"  
		Для Каждого ВремОбласть из ОбластьМногострочная.Области Цикл
			Если СтрНачинаетсяС(ВремОбласть.Имя, "УдалитьСтроку" + ИмяГруппы) Тогда  
				Прервать;
			КонецЕсли;
		КонецЦикла; 
		
		ВремОбласть.Имя = "УдалитьСтроку"+ ИмяГруппы + Координаты + НовИндекс;   
		Если Индекс = 0 Тогда
			ВремОбласть.Гиперссылка = Ложь;	
			ВремОбласть.Текст = "";	
		КонецЕсли;
		
		//область "Удалить строку"  
		
		ВремТабличныйДокумент.Вывести(ОбластьМногострочная);

		// Заполнение данными из строк многострочных частей, подчиненных текущей строке многострочной части.
		ДанныеМногострочныхЧастей = Новый Структура;
		ИменаПодчГрупп = СтруктураПриложения[ИмяГруппы]["ИменаПодчиненныхГрупп"];
		Для каждого ИмяПодчГруппы Из ИменаПодчГрупп Цикл 
			СформироватьМногострочныеЧастиТабличногоДокумента(Макет, ВремТабличныйДокумент,  СтрокаДерева.Строки, ИмяПодчГруппы,  Координаты + НовИндекс);
		КонецЦикла;
		
	КонецЦикла;    
	
	//Добавление строк
	НовПостфикс = ИмяГруппы + Координаты + НовИндекс;
	
	ОбластьДобавлениеСтроки = ПолучитьОбластьПоЧастиИмени("ДобавлениеСтроки" + ИмяГруппы, Макет, Истина);
	
	ВремОбласть = ПолучитьОбластьПоЧастиИмени("ДобавлениеСтроки" + ИмяГруппы, ОбластьДобавлениеСтроки);
	ВремОбласть.Имя = "ДобавлениеСтроки"+НовПостфикс;   
	
	
	ВремОбласть = ПолучитьОбластьПоЧастиИмени("ДобавитьСтрокуЗначок" + ИмяГруппы, ОбластьДобавлениеСтроки);
	ВремОбласть.Имя = "ДобавитьСтрокуЗначок" + НовПостфикс; 
	
	ВремОбласть = ПолучитьОбластьПоЧастиИмени("ДобавитьСтроку" + ИмяГруппы, ОбластьДобавлениеСтроки);
	ВремОбласть.Имя	= "ДобавитьСтроку" + НовПостфикс; 
	
	ВремТабличныйДокумент.Вывести(ОбластьДобавлениеСтроки);
	//Добавление строк
	
	
КонецПроцедуры

&НаСервере
Функция ПолучитьОбластьПоЧастиИмени(Знач ИмяОбласти, Знач Макет, НужноПолучитьОбласть = Ложь)
	
	Для Каждого ВремОбласть из Макет.Области Цикл
		Если СтрНачинаетсяС(ВремОбласть.Имя, ИмяОбласти) Тогда   
			Если НужноПолучитьОбласть Тогда
				Возврат  Макет.ПолучитьОбласть(ВремОбласть.Имя);
			КонецЕсли;	
			Прервать;
		КонецЕсли;
	КонецЦикла;   
	
	Возврат ВремОбласть;
		
КонецФункции



