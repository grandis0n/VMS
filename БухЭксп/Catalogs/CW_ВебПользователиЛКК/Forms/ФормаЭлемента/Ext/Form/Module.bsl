&НаКлиенте
Процедура ОбработатьОтветСервера(РезультатВыполнения, Дополнительныепараметры) Экспорт
	
	Если РезультатВыполнения.Статус = "Выполнено" Тогда
		
		СтруктураОтвета = ПолучитьИзВременногоХранилища(РезультатВыполнения.АдресРезультата);
		Если СтруктураОтвета.ОшибкаОтправки Тогда
			ТекстПредупреждения = ?(ПустаяСтрока(СтруктураОтвета.ТекстОшибки), "Не удалось отправить по указаному адресу!", СтруктураОтвета.ТекстОшибки);
			ПоказатьПредупреждение(,ТекстПредупреждения,,"Ошибка отправки сообщения");
		Иначе
			ПоказатьПредупреждение(,"Пользователю отправлен временный пароль");
		КонецЕсли;
	
	ИначеЕсли РезультатВыполнения.Статус = "Ошибка" Тогда
		
		ТекстПредупреждения = "Ошибка отправки пароля пользователю!
		| По причине: "+ РезультатВыполнения.КраткоеПредставлениеОшибки + "
		| Информаиция об ошибке см. в журнале регистрации!";
		
		ПоказатьПредупреждение(,ТекстПредупреждения,,"Ошибка отправки пароля пользователю");
		
	КонецЕсли;
	
