Процедура ОбработатьВводНовогоПароля(ДанныеПароля, Параметры) Экспорт
	
	Если ДанныеПароля = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	УстановленНовыйПароль 	= Истина;
	ВременныйПароль 		= ДанныеПароля.Пароль;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьОсновным(Команда)
	
	ТекущиеДанные = Элементы.ДоступныеПрофили.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТекущиеДанные.ЭтоГруппа Тогда
		ПоказатьПредупреждение(, "Необходимо выбрать элемент, а не группу профилей!");
		Возврат;
	КонецЕсли;
	
	ТекущаяСтрока = Элементы.ДоступныеПрофили.ТекущаяСтрока;
	УстановитьОсновнойПрофиль(ТекущаяСтрока);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьОсновнойПрофиль(ТекущаяСтрока) 
	
	СтрокаТекущкя 	= ДоступныеПрофили.НайтиПоИдентификатору(ТекущаяСтрока);  
	СтрокаТекущкя.Основной = Истина;
	
	ТекущийРодитель = СтрокаТекущкя.ПолучитьРодителя();
	СтрокиГруппы 	= ТекущийРодитель.ПолучитьЭлементы();
	Для Каждого СтрокаДерева из СтрокиГруппы Цикл
		ИдентфикаторСтроки = СтрокаДерева.ПолучитьИдентификатор(); 
		Если ИдентфикаторСтроки <> ТекущаяСтрока Тогда
			СтрокаДерева.Основной = Ложь;	
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ДоступныеПрофилиИспользованиеПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ДоступныеПрофили.ТекущиеДанные;
	ТекущиеДанные.Использование = ?(ТекущиеДанные.Использование = 2, 0, ТекущиеДанные.Использование);

	ОбработатьПодчиненныеЭлементы(Элементы.ДоступныеПрофили.ТекущаяСтрока);
	УстановитьФлагРодителя(Элементы.ДоступныеПрофили.ТекущаяСтрока);
	
	Если ТекущиеДанные.Использование = 0 Тогда  
		Если ТребуетсяУведомлениеПоРегламенту тогда
			ПоказатьПредупреждение(,"Проверьте настройки регламентных заданий.");
			ТребуетсяУведомлениеПоРегламенту = Ложь;
			УстановитьОформлениеКнопки(Ложь);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьПодчиненныеЭлементы(ИдентифкаторСтроки)
	
	ГруппаДерева = ДоступныеПрофили.НайтиПоИдентификатору(ИдентифкаторСтроки);
	
	ЭлементыСтроки = ГруппаДерева.ПолучитьЭлементы();
	Для Каждого СтрокаДерева из ЭлементыСтроки Цикл
		СтрокаДерева.Использование = ГруппаДерева.Использование;  
		Если СтрокаДерева.ЭтоГруппа Тогда
			ОбработатьПодчиненныеЭлементы(СтрокаДерева.ПолучитьИдентификатор())
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьФлагРодителя(ИдентифкаторСтроки)
	
	СтрокаДерева 	= ДоступныеПрофили.НайтиПоИдентификатору(ИдентифкаторСтроки);
	
	ГруппаДерева 	= СтрокаДерева.ПолучитьРодителя();
	Пока ГруппаДерева <> Неопределено Цикл
		ГруппаДерева.Использование = ПолучитьПометкуРодителяНаКлиенте(ГруппаДерева.ПолучитьЭлементы());
		ГруппаДерева 	= ГруппаДерева.ПолучитьРодителя();
	КонецЦикла;
	
КонецПроцедуры     

&НаКлиенте
Функция ПолучитьПометкуРодителяНаКлиенте(ЭлементыДерева)
	
	Пометка = Неопределено;
	Для Каждого ЭлементДерева из ЭлементыДерева Цикл 
		Если Пометка = Неопределено Тогда
			Пометка = ЭлементДерева.Использование;
		Иначе
			Если Пометка <> ЭлементДерева.Использование Тогда
				Пометка = 2;
				Прервать;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Если Пометка = Неопределено Тогда
		Возврат 0;
	КонецЕсли;
	
	Возврат Пометка; 
	
КонецФункции

&НаСервере
Функция ПолучитьПометкуРодителяНаСервере(ЭлементыДерева)
	
	Пометка = Неопределено;
	Для Каждого ЭлементДерева из ЭлементыДерева Цикл 
		Если Пометка = Неопределено Тогда
			Пометка = ЭлементДерева.Использование;
		Иначе
			Если Пометка <> ЭлементДерева.Использование Тогда
				Пометка = 2;
				Прервать;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Если Пометка = Неопределено Тогда
		Возврат 0;
	КонецЕсли;
	
	Возврат Пометка; 
	
КонецФункции


&НаКлиенте
Процедура ЭлектроннаяПочтаПриИзменении(Элемент)   
	
	РезультатВыполнения = ВыполнитьПроверкуСуществованияПользователяВФоне();
	
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ВыводитьОкноОжидания = Ложь;
	ОповещениеОЗавершении = Новый ОписаниеОповещения("ОбработатьРезультатПроверки", ЭтотОбъект);
	
	ДлительныеОперацииКлиент.ОжидатьЗавершение(РезультатВыполнения, ОповещениеОЗавершении, ПараметрыОжидания);
	
КонецПроцедуры  

&НаСервере
Функция ВыполнитьПроверкуСуществованияПользователяВФоне() 
	
	ЗаблокироватьДанныеФормыДляРедактирования();
	
	МожноЗаписатьПользователя 	= Истина;
	НужноУстановитьПароль		= Истина;
	Элементы.ГруппаОжиданиеПроверки.Видимость 		= Истина;
	Элементы.ГруппаПользовательСуществует.Видимость	= Ложь;
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(Новый УникальныйИдентификатор);
	ПараметрыВыполнения.ОжидатьЗавершение 			= 0; // запускать сразу
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = "Проверка пользователя";
	ПараметрыВыполнения.ЗапуститьВФоне 				= Истина;
	ПараметрыВыполнения.ЗапуститьНеВФоне 			= ложь;
	
	ВыделенныеСтроки = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Объект.Ссылка);
	
	ПараметрыПроцедуры = Новый Структура;
	ПараметрыПроцедуры.Вставить("ЭлектроннаяПочта",			Объект.ЭлектроннаяПочта);
 	ПараметрыПроцедуры.Вставить("ИдентифкаторПользователя",	Объект.ИдентифкаторПользователя);

	Возврат ДлительныеОперации.ВыполнитьВФоне("CW_ОбщийМодульЛичныйКабинетСервер.ВыполнитьПроверкуСуществованияПользователя",ПараметрыПроцедуры, ПараметрыВыполнения);
		
КонецФункции 

&НаКлиенте
Процедура ОбработатьРезультатПроверки(РезультатВыполнения, Дополнительныепараметры) Экспорт
	
	Если РезультатВыполнения.Статус = "Выполнено" Тогда
		
		РезультатПроверки 				= ПолучитьИзВременногоХранилища(РезультатВыполнения.АдресРезультата);
		
		УстановитеПарольВидимость = Истина;
		Если РезультатПроверки.ПользовательСуществует 
			И Объект.ИдентифкаторПользователя <> СокрЛП(РезультатПроверки.ИдентифкаторПользователя) Тогда  
			ИдентифкаторПользователя 	= РезультатПроверки.ИдентифкаторПользователя;
			НужноУстановитьПароль		= Ложь;
			МожноЗаписатьПользователя 	= Ложь;
			УстановитеПарольВидимость  = Ложь;
		КонецЕсли;
		
		Элементы.ГруппаПользовательСуществует.Видимость = НЕ МожноЗаписатьПользователя;
		Элементы.НадписьУстановитеПароль.Видимость 		= УстановитеПарольВидимость;
		Элементы.ГруппаОжиданиеПроверки.Видимость 		= Ложь;
		
	ИначеЕсли РезультатВыполнения.Статус = "Ошибка" Тогда
		
		РезультатПроверки = ПолучитьИзВременногоХранилища(РезультатВыполнения.АдресРезультата);
		
		Элементы.НадписьОшибка.Подсказка = "Возникла ошибка при проверке пользователя. Попробуйте позже!";
		Элементы.ГруппаОжиданиеПроверкиОшибка.Видимость = Истина; 
		
		Если ТипЗнч(РезультатПроверки) = Тип("Структура") Тогда
			Если РезультатПроверки.Свойство("ТекстОшибки") Тогда
				Элементы.НадписьОшибка.Подсказка = РезультатПроверки.ТекстОшибки;
			КонецЕсли;  
		КонецЕсли;  
		
	КонецЕсли; 
	
	РазблокироватьДанныеФормыДляРедактирования();
	
КонецПроцедуры

 &НаКлиенте
Процедура ЭтоНужныйПользователь(Команда) 
	 
	МожноЗаписатьПользователя 		= истина;
	Объект.ИдентифкаторПользователя = ИдентифкаторПользователя; 
	
	Элементы.ГруппаПользовательСуществует.Видимость = Ложь;
	
КонецПроцедуры


&НаСервере
Процедура ПолучитьДанныеПользователя()
	
	РегистрационныйНомер 	= CW_ПроверкаЛицензии.ПолучитьРегистрационныйНомер();
	
	СтруктураJSON = Новый Структура;
	СтруктураJSON.Вставить("regnumber",	XMLСтрока(РегистрационныйНомер));
	СтруктураJSON.Вставить("userid", 	XMLСтрока(Объект.ИдентифкаторПользователя));
	
	ПараметрыHTTPЗапроса = CW_РаботаСВнешнимиРесурсамиСервер.ПодготовитьHTTPЗапрос("lkk_userinfo", СтруктураJSON);
	Ответ 		= CW_РаботаСВнешнимиРесурсамиСервер.ПолучитьДанныеССервера(ПараметрыHTTPЗапроса.HTTPСоединение, ПараметрыHTTPЗапроса.HTTPЗапрос, "GET"); 
	Если Ответ = Неопределено Тогда
		Возврат;
	КонецЕсли;  
	
	Если Ответ.КодСостояния = 200 Тогда
		СтруктураJSON = CW_РаботаСВнешнимиРесурсамиСервер.ПрочитатьHTTPСервисВОбъект(Ответ);
	
		АктивныйПользователь				= XMLЗначение(Тип("Булево"), СтруктураJSON.activeuser);
		ИспользуетсяAPI						= XMLЗначение(Тип("Булево"), СтруктураJSON.usedapi);
		ПотребоватьСменыПароляПриВходе 		= XMLЗначение(Тип("Булево"), СтруктураJSON.requirepasswordchange);   
		ПарольУстановлен 					= XMLЗначение(Тип("Булево"), СтруктураJSON.passwordset);   
		РазрешенДоступПоAPI					= XMLЗначение(Тип("Булево"), СтруктураJSON.allowedapi);
		КлючДоступаAPI						= XMLЗначение(Тип("Строка"), СтруктураJSON.keyapi); 
		ТребуетсяУведомлениеПоРегламенту	= XMLЗначение(Тип("Булево"), СтруктураJSON.tasks);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РазрешенДоступПоAPIПриИзменении(Элемент)
	УправлениеЭлементамиФормы(); 
КонецПроцедуры  

&НаКлиенте
Процедура НастроитьРасписание(Команда)  
	
	ТекущиеДанные = Элементы.ДоступныеПрофили.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено 
		ИЛИ ТипЗнч(ТекущиеДанные.Профиль) <> Тип("СправочникСсылка.CW_ВебПрофили") Тогда
		ПоказатьПредупреждение(, "Необходимо выбрать мастер-профиль");
		Возврат;		
	Конецесли;
	
	ТребуетсяУведомлениеПоРегламенту = Истина;
	УстановитьОформлениеКнопки(Истина);
	
	ТекущаяСтрока = Элементы.ДоступныеПрофили.ТекущаяСтрока;
	МассивПрофилей = ПолучитьМассивПрофилей(ТекущаяСтрока);	
	Если МассивПрофилей.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Отсутствуют доступные профили!");
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Пользователь",    	Объект.Ссылка);
	ПараметрыФормы.Вставить("ОсновнойПрофиль",  ТекущиеДанные.Профиль);
	ПараметрыФормы.Вставить("МассивПрофилей",  	МассивПрофилей);
	ПараметрыФормы.Вставить("Язык",  			СокрЛП(Объект.Язык));
	
	ОткрытьФорму("Справочник.CW_ВебПользователиЛКК.Форма.НастройкиЗаданияОтправки", ПараметрыФормы, ЭтаФорма,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры   

&НаСервере
Процедура УстановитьОформлениеКнопки(ПроверкаВыполнена)
	
	Элементы.ДоступныеПрофилиНастроитьРасписание.ЦветТекста = ?(ПроверкаВыполнена, Новый Цвет, ЦветаСтиля.ЦветОсобогоТекста);   
	Элементы.ДоступныеПрофилиНастроитьРасписание.ЦветФона 	= ?(ПроверкаВыполнена, Новый Цвет, Новый Цвет(255,255,0));  
	
КонецПроцедуры

&НаСервере
Функция ПолучитьМассивПрофилей(ТекущаяСтрока) 

	Массив = Новый Массив;
	
	СтрокаТекущая = ДоступныеПрофили.НайтиПоИдентификатору(ТекущаяСтрока);
	ЭлементыДерева = СтрокаТекущая.ПолучитьЭлементы();
	Для Каждого ЭлементДерева из ЭлементыДерева Цикл
		Если ЭлементДерева.Профиль = "ГРУЗОПЕРЕВОЗКИ" Тогда
			ИдентификаторСтрокиРаздела = ЭлементДерева.ПолучитьИдентификатор();
			Прервать;
		КонецЕсли;	
	КонецЦикла;
	
	Если ИдентификаторСтрокиРаздела = Неопределено Тогда
		Возврат Массив;
	КонецЕсли;
	
	СтрокаРаздела= ДоступныеПрофили.НайтиПоИдентификатору(ИдентификаторСтрокиРаздела);
	ЭлементыРаздела = СтрокаРаздела.ПолучитьЭлементы();
	Для Каждого СтрокаДерева из ЭлементыРаздела Цикл
		Если СтрокаДерева.Использование = 1 Тогда
			Массив.Добавить(СтрокаДерева.Профиль);
		КонецЕсли;	
	КонецЦикла;
	
	Возврат Массив;
	
КонецФункции

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	Если УстановленНовыйПароль Тогда
		ТекущийОбъект.ДополнительныеСвойства.Вставить("ВременныйПароль", ВременныйПароль);
	КонецЕсли;
	
	ТекущийОбъект.ДополнительныеСвойства.Вставить("АктивныйПользователь", 			АктивныйПользователь);
	ТекущийОбъект.ДополнительныеСвойства.Вставить("РазрешенДоступПоAPI", 			РазрешенДоступПоAPI);
	ТекущийОбъект.ДополнительныеСвойства.Вставить("ПотребоватьСменыПароляПриВходе",	ПотребоватьСменыПароляПриВходе);
	
КонецПроцедуры  

