	ЭлементыДерева = ДоступныеПрофили.ПолучитьЭлементы();
	
	Для Каждого СтрокаДерева из ЭлементыДерева Цикл
		СтрокаДерева.Использование = Использование;
		ОбработатьПодчиненныеЭлементы(СтрокаДерева.ПолучитьИдентификатор());  
