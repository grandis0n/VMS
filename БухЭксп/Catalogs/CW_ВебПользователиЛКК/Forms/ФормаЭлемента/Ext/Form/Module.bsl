
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Элементы.ГруппаОжиданиеПроверкиОшибка.Видимость = Ложь; 
	Элементы.ГруппаОжиданиеПроверки.Видимость 		= Ложь;
	
	МожноЗаписатьПользователя = истина;   
	Элементы.ГруппаПользовательСуществует.Видимость = Ложь;
	
	Если Параметры.Ключ.Пустая() Тогда
		НужноУстановитьПароль = Истина;
		Объект.Язык = Справочники.CW_Языки.ru;
		Заголовок = "Новый пользователь";
	Иначе
		Заголовок = Объект.Наименование;
	КонецЕсли;
	
	Элементы.Язык.СписокВыбора.Добавить(ПредопределенноеЗначение("Справочник.CW_Языки.ru")); 
	Элементы.Язык.СписокВыбора.Добавить(ПредопределенноеЗначение("Справочник.CW_Языки.en"));
	
	ЗаполнитьДоступныеВебПрофили();
	ПолучитьДанныеПользователя();
	УправлениеЭлементамиФормы(); 
	
КонецПроцедуры


&НаСервере
Процедура УправлениеЭлементамиФормы()
	
	Элементы.РазрешенДоступПоAPI.Видимость 						= ИспользуетсяAPI;
	Элементы.КлючДоступаAPI.Видимость 							= ИспользуетсяAPI и РазрешенДоступПоAPI;
	Элементы.ГруппаОшибкаИдентфикации.Видимость 				= Не ЗначениеЗаполнено(Объект.ИдентифкаторПользователя);
	Элементы.УстановитьПароль.Доступность 						= ЗначениеЗаполнено(Объект.ИдентифкаторПользователя) или Не ПарольУстановлен;
	Элементы.ОтправитьПользователюПриглашение.Доступность 		= ЗначениеЗаполнено(Объект.ИдентифкаторПользователя);
	Элементы.ОтправитьПользователюВременныйПароль.Доступность 	= ЗначениеЗаполнено(Объект.ИдентифкаторПользователя);
	
	Элементы.НадписьУстановитеПароль.Видимость = НужноУстановитьПароль и Не ПарольУстановлен;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДоступныеВебПрофили()
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	CW_ДоступныеПользователи.ВебПрофиль КАК ВебПрофиль,
	               |	CW_ДоступныеПользователи.ВебПрофиль.ДоступенРазделПеревозки КАК ДоступенРазделГрузоперевозки,
	               |	CW_ДоступныеПользователи.ВебПрофиль.ДоступенРазделЗаявки КАК ДоступенРазделЗаявки
	               |ПОМЕСТИТЬ ВТ_ДоступныеОсновныеПрофили
	               |ИЗ
	               |	РегистрСведений.CW_ДоступныеПользователи КАК CW_ДоступныеПользователи
	               |ГДЕ
	               |	CW_ДоступныеПользователи.Пользователь = &Пользователь
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ_ДоступныеОсновныеПрофили.ВебПрофиль КАК ВебПрофиль,
	               |	ВТ_ДоступныеОсновныеПрофили.ДоступенРазделГрузоперевозки КАК ДоступенРазделГрузоперевозки,
	               |	ВТ_ДоступныеОсновныеПрофили.ДоступенРазделЗаявки КАК ДоступенРазделЗаявки
	               |ИЗ
	               |	ВТ_ДоступныеОсновныеПрофили КАК ВТ_ДоступныеОсновныеПрофили
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	CW_ВебПрофилиПеревозок.Владелец КАК ОсновнойПрофиль,
	               |	CW_ВебПрофилиПеревозок.Ссылка КАК Профиль,
	               |	CW_ВебПрофилиПеревозок.Активный КАК Активный,
	               |	ВЫБОР
	               |		КОГДА CW_ПользователиВебПрофилей.ВебПрофиль ЕСТЬ NULL
	               |			ТОГДА 0
	               |		ИНАЧЕ 1
	               |	КОНЕЦ КАК Использование,
	               |	ЕСТЬNULL(CW_ПользователиВебПрофилей.Основной, ЛОЖЬ) КАК Основной
	               |ИЗ
	               |	Справочник.CW_ВебПрофилиПеревозок КАК CW_ВебПрофилиПеревозок
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.CW_ПользователиВебПрофилей КАК CW_ПользователиВебПрофилей
	               |		ПО CW_ВебПрофилиПеревозок.Ссылка = CW_ПользователиВебПрофилей.ВебПрофиль
	               |			И (CW_ПользователиВебПрофилей.Пользователь = &Пользователь)
	               |ГДЕ
	               |	CW_ВебПрофилиПеревозок.Владелец В
	               |			(ВЫБРАТЬ
	               |				ВТ_ДоступныеОсновныеПрофили.ВебПрофиль КАК ВебПрофиль
	               |			ИЗ
	               |				ВТ_ДоступныеОсновныеПрофили КАК ВТ_ДоступныеОсновныеПрофили)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	CW_ВебПрофилиЗаявок.Владелец КАК ОсновнойПрофиль,
	               |	CW_ВебПрофилиЗаявок.Ссылка КАК Профиль,
	               |	CW_ВебПрофилиЗаявок.Активный КАК Активный,
	               |	ВЫБОР
	               |		КОГДА CW_ПользователиВебПрофилей.ВебПрофиль ЕСТЬ NULL
	               |			ТОГДА 0
	               |		ИНАЧЕ 1
	               |	КОНЕЦ КАК Использование,
	               |	ЕСТЬNULL(CW_ПользователиВебПрофилей.Основной, ЛОЖЬ) КАК Основной
	               |ИЗ
	               |	Справочник.CW_ВебПрофилиЗаявок КАК CW_ВебПрофилиЗаявок
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.CW_ПользователиВебПрофилей КАК CW_ПользователиВебПрофилей
	               |		ПО CW_ВебПрофилиЗаявок.Ссылка = CW_ПользователиВебПрофилей.ВебПрофиль
	               |			И (CW_ПользователиВебПрофилей.Пользователь = &Пользователь)
	               |ГДЕ
	               |	CW_ВебПрофилиЗаявок.Владелец В
	               |			(ВЫБРАТЬ
	               |				ВТ_ДоступныеОсновныеПрофили.ВебПрофиль КАК ВебПрофиль
	               |			ИЗ
	               |				ВТ_ДоступныеОсновныеПрофили КАК ВТ_ДоступныеОсновныеПрофили)"; 
	
	Запрос.УстановитьПараметр("Пользователь", Объект.Ссылка);
	
	ПакетРезультатовЗапроса = Запрос.ВыполнитьПакет();    
	
	РезультатОсновнойПрофиль		= ПакетРезультатовЗапроса[1];
	
	РезультатПрофильГрузоперевозок 	= ПакетРезультатовЗапроса[2]; 
	ТаблицаПрофильГрузоперевозок 	= РезультатПрофильГрузоперевозок.Выгрузить();
	
	РезультатПрофильЗаявок 			= ПакетРезультатовЗапроса[3];
	ТаблицаПрофильЗаявок 			= РезультатПрофильЗаявок.Выгрузить();  
	
	ЭлементыДерева = ДоступныеПрофили.ПолучитьЭлементы();
	
	ВыборкаОсновнойПрофиль = РезультатОсновнойПрофиль.Выбрать();
	Пока ВыборкаОсновнойПрофиль.Следующий() Цикл
		
		ГруппаДерева = ЭлементыДерева.Добавить();
		ГруппаДерева.Профиль 		= ВыборкаОсновнойПрофиль.ВебПрофиль;
		ГруппаДерева.ИндексКартинки = 0;
		ГруппаДерева.Активный 		= ИСТИНА;   
		ГруппаДерева.ЭтоГруппа      = ИСТИНА;
		
		Отбор = Новый Структура("ОсновнойПрофиль",  ВыборкаОсновнойПрофиль.ВебПрофиль); 
		
		Если ВыборкаОсновнойПрофиль.ДоступенРазделГрузоперевозки Тогда
			мСтроки = ТаблицаПрофильГрузоперевозок.НайтиСтроки(Отбор); 
			Если мСтроки.Количество() > 0 Тогда
				ЭлементыВидПрофиля = ГруппаДерева.ПолучитьЭлементы();
				ГруппыДереваВидПрофиля = ЭлементыВидПрофиля.Добавить();
				ГруппыДереваВидПрофиля.Профиль 			= "ГРУЗОПЕРЕВОЗКИ";
				ГруппыДереваВидПрофиля.ИндексКартинки 	= 1;
				ГруппыДереваВидПрофиля.Активный 		= ИСТИНА; 
				ГруппыДереваВидПрофиля.ЭтоГруппа      	= ИСТИНА;
				
				ЭлементыГруппы = ГруппыДереваВидПрофиля.ПолучитьЭлементы();
				Для каждого СтрокаМассива из мСтроки Цикл
					НоваяСтрока = ЭлементыГруппы.Добавить();
					
					ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаМассива); 
					
					НоваяСтрока.Раздел = "ГРУЗОПЕРЕВОЗКИ"; 
					НоваяСтрока.ИндексКартинки = 2; 
				КонецЦикла;   
				
				ГруппыДереваВидПрофиля.Использование = ПолучитьПометкуРодителяНаСервере(ЭлементыГруппы)
			КонецЕсли;
		КонецЕсли;
		
		Если ВыборкаОсновнойПрофиль.ДоступенРазделЗаявки Тогда
			мСтроки = ТаблицаПрофильЗаявок.НайтиСтроки(Отбор); 
			Если мСтроки.Количество() > 0 Тогда
				ЭлементыВидПрофиля = ГруппаДерева.ПолучитьЭлементы();
				ГруппыДереваВидПрофиля = ЭлементыВидПрофиля.Добавить();
				ГруппыДереваВидПрофиля.Профиль 			= "ЗАЯВКИ";
				ГруппыДереваВидПрофиля.ИндексКартинки 	= 1;
				ГруппыДереваВидПрофиля.Активный 		= ИСТИНА; 
				ГруппыДереваВидПрофиля.ЭтоГруппа      	= ИСТИНА;
				
				ЭлементыГруппы = ГруппыДереваВидПрофиля.ПолучитьЭлементы();
				Для каждого СтрокаМассива из мСтроки Цикл
					НоваяСтрока = ЭлементыГруппы.Добавить(); 
					
					ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаМассива); 
					
					НоваяСтрока.Раздел = "ЗАЯВКИ"; 
					НоваяСтрока.ИндексКартинки = 2;
				КонецЦикла;  
				
				ГруппыДереваВидПрофиля.Использование = ПолучитьПометкуРодителяНаСервере(ЭлементыГруппы)
			КонецЕсли;
		КонецЕсли;
	
		ГруппаДерева.Использование = ПолучитьПометкуРодителяНаСервере(ГруппаДерева.ПолучитьЭлементы())
		
	КонецЦикла;
	
	

КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	НаборЗаписей = РегистрыСведений.CW_ПользователиВебПрофилей.СоздатьНаборЗаписей();	
	НаборЗаписей.Отбор.Пользователь.Установить(ТекущийОбъект.Ссылка);
	НаборЗаписей.Прочитать();
	НаборЗаписей.Очистить();   
	
	ДеревоПрофилей = РеквизитФормыВЗначение("ДоступныеПрофили");
	
	СтруктураОтбора = Новый Структура;
	СтруктураОтбора.Вставить("ЭтоГруппа", 		Ложь);
	СтруктураОтбора.Вставить("Использование", 	1);
	
	ПомеченныеСтроки = ДеревоПрофилей.Строки.НайтиСтроки(СтруктураОтбора, Истина);  
	Для Каждого СтрокаДерева из ПомеченныеСтроки Цикл 
		ЗаписьНабора = НаборЗаписей.Добавить();   
		ЗаписьНабора.Пользователь 		= Объект.Ссылка;
		ЗаписьНабора.Раздел  	   		= СтрокаДерева.Раздел;
		ЗаписьНабора.ВебПрофиль 		= СтрокаДерева.Профиль;
		ЗаписьНабора.ОсновнойПрофиль 	= СтрокаДерева.Профиль.Владелец;
		ЗаписьНабора.Основной 			= СтрокаДерева.Основной;
	КонецЦикла;
	
	НаборЗаписей.Записать();
	
	Заголовок = ТекущийОбъект.Наименование;
	
	Элементы.ГруппаОшибкаИдентфикации.Видимость 				= Не ЗначениеЗаполнено(Объект.ИдентифкаторПользователя);
	Элементы.УстановитьПароль.Доступность 						= ЗначениеЗаполнено(Объект.ИдентифкаторПользователя);
	Элементы.ОтправитьПользователюПриглашение.Доступность 		= ЗначениеЗаполнено(Объект.ИдентифкаторПользователя);
	Элементы.ОтправитьПользователюВременныйПароль.Доступность 	= ЗначениеЗаполнено(Объект.ИдентифкаторПользователя);
	
	УстановленНовыйПароль	= Ложь;
	ПарольУстановлен 		= Истина;
	ВременныйПароль			= "";
	
	Элементы.НадписьУстановитеПароль.Видимость = НЕ ПарольУстановлен;
	
	ПолучитьДанныеПользователя();
	
	УправлениеЭлементамиФормы();

КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)    

	Если СтрНайти(Объект.ЭлектроннаяПочта,"@") = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Указан некорректный адрес электронной почты!",,"ЭлектроннаяПочта","Объект", Отказ);			
	КонецЕсли;
	
	Если Не АдресУникальный(Объект.ЭлектроннаяПочта, Объект.Ссылка) Тогда   
		Отказ = Истина;
		ВызватьИсключение "В этой базе данных пользователь с таким электронным адресом уже существует! Запись невозможна!";
	КонецЕсли;   
	
	Если НЕ МожноЗаписатьПользователя Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В сервисе ""Личный кабинет клиента"" пользователь с таким электронным адресом уже зарегистрирован!",,"ЭлектроннаяПочта","Объект", Отказ);			
	КонецЕсли;
	
	Если НужноУстановитьПароль Тогда
		Если НЕ ПарольУстановлен и Не УстановленНовыйПароль Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Необходимо установить временный пароль!",,"ИдентифкаторПользователя","Объект", Отказ);			
		КонецЕсли;                      
	Конецесли;  
	
	Ответ = ОбновитьДанныеПользователяЛичногоКабинета(Отказ);
	
	Состояние(Ответ.Текст,,Ответ.Пояснение);
	
КонецПроцедуры   


Функция ОбновитьДанныеПользователяЛичногоКабинета(Отказ) 
	
	СоответствиеКодовСостояний = CW_ОбщийМодульЛичныйКабинетКлиентСервер.ПолучитьОписаниеКодовСостояний();	
	
	Если Объект.ПометкаУдаления Тогда
		АктивныйПользователь 	= Ложь;
		РазрешенДоступПоAPI 	= Ложь;
	КонецЕсли;
	
	РегистрационныйНомер 	= CW_ПроверкаЛицензии.ПолучитьРегистрационныйНомер();

	СтруктураJSON = новый Структура;
	СтруктураJSON.Вставить("regnumber",	XMLСтрока(РегистрационныйНомер));
	СтруктураJSON.Вставить("name",		XMLСтрока(Объект.ЭлектроннаяПочта));		
	СтруктураJSON.Вставить("email",		XMLСтрока(Объект.ЭлектроннаяПочта));
	
	СтруктураJSON.Вставить("active",	XMLСтрока(АктивныйПользователь));
	СтруктураJSON.Вставить("language",	XMLСтрока(Объект.Язык.Код));
	СтруктураJSON.Вставить("userid",	XMLСтрока(Объект.ИдентифкаторПользователя));
	
	СтруктураJSON.Вставить("showfiles",	XMLСтрока(Объект.ВыгружатьФайлы));
	СтруктураJSON.Вставить("showdocs",	XMLСтрока(Объект.ВыгружатьПечатныеФормы));
	СтруктураJSON.Вставить("create",	XMLСтрока(Не Объект.ПометкаУдаления));
	
	СтруктураJSON.Вставить("requirepasswordchange", XMLСтрока(ПотребоватьСменыПароляПриВходе));
	
	СтруктураJSON.Вставить("usedapi",	XMLСтрока(РазрешенДоступПоAPI));
	
	Если УстановленНовыйПароль Тогда
		СтруктураJSON.Вставить("password", XMLСтрока(ВременныйПароль));
	КонецЕсли;
	
	ПараметрыHTTPЗапроса = CW_РаботаСВнешнимиРесурсамиСервер.ПодготовитьHTTPЗапрос("lkk_updateuser", СтруктураJSON);
 	Ответ 		= CW_РаботаСВнешнимиРесурсамиСервер.ПолучитьДанныеССервера(ПараметрыHTTPЗапроса.HTTPСоединение, ПараметрыHTTPЗапроса.HTTPЗапрос, "POST"); 

	Если Ответ = Неопределено Тогда  
		Структура = новый Структура;
		Структура.Вставить("Текст", 	"Не удалось обновить данные пользователя");
		Структура.Вставить("Пояснение", "Отсутствует интернет-соединение!");
		Возврат Структура;
	КонецЕсли;

	Структура = новый Структура("Текст,Пояснение", "", "");
	
	Если Ответ.КодСостояния = 200 Тогда   
		СтруктураJSON = CW_РаботаСВнешнимиРесурсамиСервер.ПрочитатьHTTPСервисВОбъект(Ответ);
		Если СтруктураJSON.Свойство("userid") Тогда
			Объект.ИдентифкаторПользователя  =  XMLЗначение(Тип("Строка"), СтруктураJSON.userid);
		КонецЕсли; 
		
		Структура.Текст 		= "Пользователь записан";
		Структура.Пояснение 	= СтруктураJSON.info;
	Иначе  
		Структура.Текст 		= "Не удалось обновить данные пользователя";
		Структура.Пояснение 	= Ответ.ПолучитьТелоКакСтроку();
	КонецЕсли; 
	
	Возврат Структура;
	
КонецФункции



&НаСервереБезКонтекста
Функция АдресУникальный(ЭлектроннаяПочта, ТекущаяСсылка)
	
	Запрос = новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	CW_ВебПользователиЛКК.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.CW_ВебПользователиЛКК КАК CW_ВебПользователиЛКК
	               |ГДЕ
	               |	CW_ВебПользователиЛКК.Ссылка <> &Ссылка
	               |	И CW_ВебПользователиЛКК.ЭлектроннаяПочта = &ЭлектроннаяПочта";
	
	Запрос.УстановитьПараметр("Ссылка", ТекущаяСсылка); 
	Запрос.УстановитьПараметр("ЭлектроннаяПочта", ЭлектроннаяПочта); 
	
	РезультатЗапроса = Запрос.Выполнить();

	Возврат РезультатЗапроса.Пустой();
		
КонецФункции

