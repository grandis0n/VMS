&НаКлиенте
Процедура ВыполнитьЗаданиеСейчас(НомерЗадания) 
	
	РезультатВыполнения =  ВыполнитьЗаданиеСейчасНаСервереВФоне(НомерЗадания);
	
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ВыводитьОкноОжидания = Истина;
	ОповещениеОЗавершении = Новый ОписаниеОповещения("ОбработатьВыполнениеЗадания", ЭтотОбъект);
	
	ДлительныеОперацииКлиент.ОжидатьЗавершение(РезультатВыполнения, ОповещениеОЗавершении, ПараметрыОжидания);
	
КонецПроцедуры  

&НаСервере
Функция ВыполнитьЗаданиеСейчасНаСервереВФоне(НомерЗадания)
	
	ИдентификаторЗадания = ЭтаФорма["ИдентификаторЗадания_"+НомерЗадания];

	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(Новый УникальныйИдентификатор);
	ПараметрыВыполнения.ОжидатьЗавершение 			= 0; // запускать сразу
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = "Отправка списка перевозок (ручная)";
	ПараметрыВыполнения.ЗапуститьВФоне 				= Истина;
	ПараметрыВыполнения.ЗапуститьНеВФоне 			= ложь;   
	
	МассивНастроекДляЗаписи = Новый Массив;
	Если Использование_1 ИЛИ ЗначениеЗаполнено(ИдентификаторЗадания_1) Тогда
		МассивНастроекДляЗаписи.Добавить(ПолучитьПараметрыОтправкиФайлов("1"));
	КонецЕсли;
	
	Если Использование_2 ИЛИ ЗначениеЗаполнено(ИдентификаторЗадания_2) Тогда
		МассивНастроекДляЗаписи.Добавить(ПолучитьПараметрыОтправкиФайлов("2"));
	КонецЕсли;

	ПараметрыПроцедуры = Новый Структура;
	ПараметрыПроцедуры.Вставить("ИдентификаторЗадания", ИдентификаторЗадания);   
	
	Возврат ДлительныеОперации.ВыполнитьВФоне("CW_ОбщийМодульЛичныйКабинетСервер.ВыполнитьЗаданиеОтправки",ПараметрыПроцедуры, ПараметрыВыполнения);
	
КонецФункции   

 &НаКлиенте
Процедура ОбработатьВыполнениеЗадания(РезультатВыполнения, ДополнительныеПараметры) Экспорт
	
	Если РезультатВыполнения = Неопределено Тогда 
		Возврат;
	КонецЕсли;

	Если РезультатВыполнения.Статус = "Выполнено" Тогда   
		
		ПоказатьПредупреждение(,"Регламентное задание выполнено успешно");
		
	ИначеЕсли РезультатВыполнения.Статус = "Ошибка" Тогда
		
		Результат = ПолучитьИзВременногоХранилища(РезультатВыполнения.АдресРезультата);
		
		ТекстПредупреждения = "Ошибка выполнения задания!
		| По причине: "+ Результат + "
		| Информаиция об ошибке см. в журнале регистрации!";
		
		ПоказатьПредупреждение(, ТекстПредупреждения);
		
	КонецЕсли;
	
КонецПроцедуры  



&НаСервере
Функция ПолучитьСоответствиеПредставленийСостояния()
	
	Результат = Новый Соответствие;
	Результат.Вставить(СостояниеФоновогоЗадания.Активно, 			Нстр("ru='Выполняетсмя'; en='Active'"));
	Результат.Вставить(СостояниеФоновогоЗадания.Завершено, 			Нстр("ru='Завершено'; en='Job is completed'"));
	Результат.Вставить(СостояниеФоновогоЗадания.Отменено, 			Нстр("ru='Отменено'; en='Canceled'")); 
	Результат.Вставить(СостояниеФоновогоЗадания.ЗавершеноАварийно,  Нстр("ru='Ошибка'; en='Job failed'"));
	
	Возврат Результат;
	
КонецФункции


&НаСервере
Функция ПолучитьСоответствиеСостояний()
	
	Результат = Новый Соответствие;
	
	Результат.Вставить(СостояниеФоновогоЗадания.Активно, 			"Выполняется"); 
	Результат.Вставить(СостояниеФоновогоЗадания.Завершено, 			"Завершено"); 
	Результат.Вставить(СостояниеФоновогоЗадания.ЗавершеноАварийно, 	"Ошибка");
	
	Возврат Результат;
	
