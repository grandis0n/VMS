&НаКлиенте
Процедура ЗавершениеВыбораМакроса(ЭлементСписка, ДополнительныеПараметры) Экспорт
	
	Если ЭлементСписка = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	НачалоСтроки = 0; НачалоКолонки = 0; КонецСтроки = 0; КонецКолонки = 0;
	
	ДополнительныеПараметры.Элемент.ПолучитьГраницыВыделения(НачалоСтроки, НачалоКолонки, КонецСтроки, КонецКолонки);    
	
	ЭтаФорма["ШаблонИмениФайла"+ДополнительныеПараметры.Постфикс] = Лев(ДополнительныеПараметры.Элемент.ТекстРедактирования, НачалоКолонки-1) 
								+ СокрЛП(ЭлементСписка.Значение) 
								+ Сред(ДополнительныеПараметры.Элемент.ТекстРедактирования, КонецКолонки);  
								
	ТекущийПостфикс = ДополнительныеПараметры.Постфикс;
	ПозицияКурсора 	= СтрДлина(Лев(ДополнительныеПараметры.Элемент.ТекстРедактирования, НачалоКолонки-1) 
								+ СокрЛП(ЭлементСписка.Значение))+1; 
								

	ПодключитьОбработчикОжидания("УстановитьГраницы", 0.1, Истина);							
								
	УстановитьПримерИмениФайла(ДополнительныеПараметры.Постфикс);
	
КонецПроцедуры 

&НаКлиенте
Процедура УстановитьГраницы()
    
    Элементы["ШаблонИмениФайла"+ТекущийПостфикс].УстановитьГраницыВыделения(ПозицияКурсора, ПозицияКурсора);
    
КонецПроцедуры

&НаКлиенте
Функция ПолучитьСписокДоступныхМакросов()   
	
	//[name] - Имя профиля;
	//[ГГГГ] - четыре цифры года, пример "2025" (2025 год);
	//[ГГ] - две цифры года, пример "25" (2025 год);
	//[MM] - две цифры месяца, пример "02" (февраль 2025 года);
	//[ЧЧ] - две цифры даты, пример "01" (1 февраль 2025 года);
	//[hh] - две цифры часа, пример "23" (23:59:59);
	//[mm] - две цифры минут, пример "59" (23:59:59);
	//[ss] - две цифры секунд, пример "59" (23:59:59); 
	
	СписокМакросов = Новый СписокЗначений;
	СписокМакросов.Добавить("[name]",	"[name] - Имя профиля");
	СписокМакросов.Добавить("[yyyy]",	"[yyyy] - четыре цифры года");
	СписокМакросов.Добавить("[yy]",		"[yy] - Две цифры года");
	СписокМакросов.Добавить("[MM]",		"[MM] - Две цифры месяца");
	СписокМакросов.Добавить("[dd]",		"[dd] - Две цифры даты");
	СписокМакросов.Добавить("[hh]",		"[hh] - Две цифры часа");
	СписокМакросов.Добавить("[mm]",		"[mm] - Две цифры минут");
	СписокМакросов.Добавить("[ss]",		"[ss] - Две цифры секунд");
	
	Возврат СписокМакросов;
	
КонецФункции

&НаСервере
Процедура УстановитьПримерИмениФайла(Знач Постфикс)   
	
	ШаблонИмениФайла = ЭтаФорма["ШаблонИмениФайла"+Постфикс];   
	
	Дополнение = "";
	Если ЭтаФорма["ОтправлятьПакет"+Постфикс] Тогда	
		Дополнение = Формат(ТекущаяДата(),"ДФ=yyyy_MM_dd");
	Иначе
		ТаблицаПрофилиПользователя = ЭтаФорма["ПрофилиПользователя"+Постфикс].Выгрузить();	 
		СтрокаПрофилей = ТаблицаПрофилиПользователя.Найти(Истина, "Пометка");  
		Если СтрокаПрофилей <> Неопределено Тогда
			Дополнение = Нстр("ru='"+СтрокаПрофилей.Профиль.ПредставлениеRU+"'; en='"+СтрокаПрофилей.Профиль.ПредставлениеEN+"'",Язык);
		КонецЕсли;
	КонецЕсли;
	
	ИмяФайлаПоУмолчанию = "ShipmentUpdate_"+Дополнение+".xlsx";
	
	СтрПримерИмениФайла = ОбработатьШаблонИмениФайла(ШаблонИмениФайла);
	ЭтаФорма["ПримерИмениФайла"+Постфикс] = ?(ПустаяСтрока(СтрПримерИмениФайла), ИмяФайлаПоУмолчанию, СтрПримерИмениФайла+".xlsx");
	
КонецПроцедуры


&НаСервере
Функция ОбработатьШаблонИмениФайла(Знач Текст)
	
	Текст = СтрЗаменить(Текст,"[name]", "Профиль");
	Текст = СтрЗаменить(Текст,"[yyyy]", Формат(ТекущаяДата(),"ДФ=yyyy"));
	Текст = СтрЗаменить(Текст,"[yy]", 	Формат(ТекущаяДата(),"ДФ=yy"));
	Текст = СтрЗаменить(Текст,"[MM]", 	Формат(ТекущаяДата(),"ДФ=MM"));
	Текст = СтрЗаменить(Текст,"[dd]", 	Формат(ТекущаяДата(),"ДФ=dd"));
	Текст = СтрЗаменить(Текст,"[hh]", 	Формат(ТекущаяДата(),"ДФ=hh"));
	Текст = СтрЗаменить(Текст,"[mm]", 	Формат(ТекущаяДата(),"ДФ=mm"));
	Текст = СтрЗаменить(Текст,"[ss]", 	Формат(ТекущаяДата(),"ДФ=ss"));

	Возврат Текст;

КонецФункции

&НаКлиенте
Процедура ШаблонИмениФайла_1ПриИзменении(Элемент)

	Если ЕстьНедопустимыеСимволыВИмениФайла(ШаблонИмениФайла_1) Тогда 
		НедопустимыеСимволы = ОбщегоНазначенияКлиентСервер.ПолучитьНедопустимыеСимволыВИмениФайла();
		НедопустимыеСимволы = РазделитьНедопустимыеСимволы(НедопустимыеСимволы);	
		ТекстПредупреждения = "В имени файла нельзя использовать символы: " + НедопустимыеСимволы;	
		ПоказатьПредупреждение(,ТекстПредупреждения);
	КонецЕсли;
	
	УстановитьПримерИмениФайла("_1"); 
	
КонецПроцедуры

&НаКлиенте
Процедура ШаблонИмениФайла_2ПриИзменении(Элемент)
	
	Если ЕстьНедопустимыеСимволыВИмениФайла(ШаблонИмениФайла_2) Тогда 
		НедопустимыеСимволы = ОбщегоНазначенияКлиентСервер.ПолучитьНедопустимыеСимволыВИмениФайла();
		НедопустимыеСимволы = РазделитьНедопустимыеСимволы(НедопустимыеСимволы);	
		ТекстПредупреждения = "В имени файла нельзя использовать символы: "+ НедопустимыеСимволы;	
		ПоказатьПредупреждение(,ТекстПредупреждения);
	КонецЕсли;
	
	УстановитьПримерИмениФайла("_2");  
	
КонецПроцедуры 

&НаСервере
Функция РазделитьНедопустимыеСимволы(Знач НедопустимыеСимволы, Разделитель=", ")
	
	Результат = Новый Массив;
	
	Для ПозицияСимвола = 1 По СтрДлина(НедопустимыеСимволы) Цикл
		ПроверяемыйСимвол = Сред(НедопустимыеСимволы, ПозицияСимвола,1);
		Если ПроверяемыйСимвол = Символы.ПС Тогда
			ПроверяемыйСимвол = "<Перенос строки>";	
		Конецесли;
		Если ПроверяемыйСимвол = Символы.Таб Тогда
			ПроверяемыйСимвол = "<Символ Tab>";
		Конецесли;
		
		Результат.Добавить(ПроверяемыйСимвол); 
		
	КонецЦикла;
	
	Возврат СтрСоединить(Результат, Разделитель);
	
КонецФункции

&НаСервере
Функция ЕстьНедопустимыеСимволыВИмениФайла(ШаблонИмениФайла)  
	
	ИмяФайла = ОбработатьШаблонИмениФайла(ШаблонИмениФайла);
	МассивСимволов = ОбщегоНазначенияКлиентСервер.НайтиНедопустимыеСимволыВИмениФайла(ИмяФайла);
	
	Возврат МассивСимволов.Количество() > 0;
	
КонецФункции    

&НаКлиенте
Процедура ОтправлятьПакет_1ПриИзменении(Элемент)
	
	УстановитьПримерИмениФайла("_1"); 

КонецПроцедуры

&НаКлиенте
Процедура ОтправлятьПакет_2ПриИзменении(Элемент)
	
	УстановитьПримерИмениФайла("_2"); 

КонецПроцедуры

