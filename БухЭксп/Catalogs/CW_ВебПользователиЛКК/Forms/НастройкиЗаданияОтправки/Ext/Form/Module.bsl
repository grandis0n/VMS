&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка) 
	
	РегистрационныйНомер = CW_ПроверкаЛицензии.ПолучитьРегистрационныйНомер();
	
	Параметры.Свойство("Пользователь", 		Пользователь); 
	Параметры.Свойство("ОсновнойПрофиль", 	ОсновнойПрофиль); 
	Параметры.Свойство("Язык", 				Язык); 
	
	ПрофилиПользователя = Новый ФиксированныйМассив(Новый Массив);  
	Если Параметры.Свойство("МассивПрофилей") Тогда
		ПрофилиПользователя = Новый ФиксированныйМассив(Параметры.МассивПрофилей);  
	КонецЕсли;
	
	Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаОжидание;  
	
	РаботаСВнешнимиРесурсамиЗаблокирована = РегламентныеЗаданияСервер.РаботаСВнешнимиРесурсамиЗаблокирована();
	
	Элементы.ОтправитьВручнуюВторое.Доступность = НЕ РаботаСВнешнимиРесурсамиЗаблокирована;
	Элементы.ОтправитьВручнуюПервое.Доступность = НЕ РаботаСВнешнимиРесурсамиЗаблокирована;
	Элементы.ФормаЗаписать.Доступность 			= НЕ РаботаСВнешнимиРесурсамиЗаблокирована;
	Элементы.ФормаЗаписатьИЗакрыть.Доступность 	= НЕ РаботаСВнешнимиРесурсамиЗаблокирована;
	
КонецПроцедуры     


&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ПодключитьОбработчикОжидания("ПолучитьИнформациюПоЗаданиям", 0.1, Истина);

КонецПроцедуры      

&НаКлиенте
Процедура ПолучитьИнформациюПоЗаданиям()
	
	РезультатВыполнения =  ПолучитьИнформациюПоЗаданиямНаСервереВФоне();
	
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ВыводитьОкноОжидания = Ложь;
	ОповещениеОЗавершении = Новый ОписаниеОповещения("ОбработатьПолученияЗаданий", ЭтотОбъект);
	
	ДлительныеОперацииКлиент.ОжидатьЗавершение(РезультатВыполнения, ОповещениеОЗавершении, ПараметрыОжидания);
	
КонецПроцедуры 

&НаСервере
Функция ПолучитьИнформациюПоЗаданиямНаСервереВФоне()
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(Новый УникальныйИдентификатор);
	ПараметрыВыполнения.ОжидатьЗавершение 			= 0; // запускать сразу
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = "Получение ифнормации о заданиях отправки";
	ПараметрыВыполнения.ЗапуститьВФоне 				= Истина;
	ПараметрыВыполнения.ЗапуститьНеВФоне 			= ложь;
	
	ПараметрыПроцедуры = Новый Структура;
	ПараметрыПроцедуры.Вставить("ИдентифкаторПользователя", Пользователь.ИдентифкаторПользователя);
	ПараметрыПроцедуры.Вставить("ЭлектроннаяПочта",			Пользователь.ЭлектроннаяПочта);
	ПараметрыПроцедуры.Вставить("ОсновнойПрофиль",			ОсновнойПрофиль);
	
	Возврат ДлительныеОперации.ВыполнитьВФоне("CW_ОбщийМодульЛичныйКабинетСервер.ПолучитьИнформациюПоЗаданиям",ПараметрыПроцедуры, ПараметрыВыполнения);
	
КонецФункции

&НаКлиенте
Процедура ОбработатьПолученияЗаданий(РезультатВыполнения, Дополнительныепараметры) Экспорт
	
	Если РезультатВыполнения = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	
	Если РезультатВыполнения.Статус = "Выполнено" Тогда
		
		ОбработатьУспешноеВыполнениеЗаданияНаСервере(РезультатВыполнения.АдресРезультата);
		УстановитьДоступностьЭлементовПриИспользовании();
		
		Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаНастройки;
		
	
	ИначеЕсли РезультатВыполнения.Статус = "Ошибка" Тогда
		
		ТекстПредупреждения = "Ошибка получения списка заданий!
		|По причине: "+ РезультатВыполнения.КраткоеПредставлениеОшибки + "
		|Информаицию об ошибке см. в журнале регистрации!";
		
		Элементы.ТекстОшибки.Заголовок = ТекстПредупреждения;
		Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаОшибка;
		
	КонецЕсли;
	
КонецПроцедуры     

&НаСервере
Процедура ОбработатьУспешноеВыполнениеЗаданияНаСервере(АдресРезультата) 
	
	МассивНастроек 			= ПолучитьИзВременногоХранилища(АдресРезультата);  
	СоответствиеДнейНедели 	= ПолучитьСоответствиеДнейНеделиИменамРеквизитов();
	ЧасовойПояс 			= ЧасовойПояс();
	
	//Начальное заполнение таблиц профилей
	Для Постфикс = 1 По 2 Цикл
		ТаблицаПрофилиПользователя = ЭтаФорма["ПрофилиПользователя_"+Постфикс];
		Для Каждого Профиль из ПрофилиПользователя Цикл   
			//Это новый профиль;
			НоваяСтрока = ТаблицаПрофилиПользователя.Добавить();
			НоваяСтрока.Профиль = Профиль;
			НоваяСтрока.УИД  	= XMLСтрока(Профиль);
		КонецЦикла;               
	КонецЦикла;
	//Начальное заполнение таблиц профилей
	
	Для Каждого СтруктураНастроек из МассивНастроек Цикл 
		
		ПостфиксРеквизитов = Формат(СтруктураНастроек.НомерЗадания,"ЧГ=");
		
		ЭтаФорма["ИдентификаторЗадания_" + ПостфиксРеквизитов] = Новый УникальныйИдентификатор(СтруктураНастроек.ИдентификаторЗадания);
 		ЭтаФорма["Использование_" 		 + ПостфиксРеквизитов] = СтруктураНастроек.Используетвся;
		ЭтаФорма["ДатаНачала_" 			 + ПостфиксРеквизитов] = СтруктураНастроек.ДатаНачала;
		ЭтаФорма["ВремяНачала_" 		 + ПостфиксРеквизитов] = СтруктураНастроек.ВремяНачала;
		ЭтаФорма["Получатели_" 			 + ПостфиксРеквизитов] = СтруктураНастроек.Получатели;
		ЭтаФорма["Копии_" 				 + ПостфиксРеквизитов] = СтруктураНастроек.Копии;
		ЭтаФорма["ОтправлятьПакет_"		 + ПостфиксРеквизитов] = СтруктураНастроек.ОтправлятьПакет;  
		ЭтаФорма["ШаблонИмениФайла_"	 + ПостфиксРеквизитов] = СтруктураНастроек.ШаблонИмениФайла;    
		
		ПредставлениеЧасовогоПояса 		= CW_ОбщийМодульЛичныйКабинетСервер.ПолучитьПредставлениеЧасовгоПояса(СтруктураНастроек.ЧасовойПояс); 
		Элементы.ЧасовойПояс1.Заголовок = "Часовой пояс: " + ПредставлениеЧасовогоПояса;
		Элементы.ЧасовойПояс2.Заголовок = "Часовой пояс: " + ПредставлениеЧасовогоПояса; 
		ЧасовойПояс 					= СтруктураНастроек.ЧасовойПояс;
		
		мДниНедели = СтрРазделить(СтруктураНастроек.стрДни, ";");
		Для Каждого ДеньНедели из мДниНедели Цикл     
			Если ПустаяСтрока(ДеньНедели) тогда
				Продолжить;
			КонецЕсли;
			ИмяРеквизита = СоответствиеДнейНедели.Получить(Число(ДеньНедели));
			ЭтаФорма[ИмяРеквизита+"_"+ПостфиксРеквизитов] = Истина;
		КонецЦикла;  
		
		ТаблицаПрофилиПользователя = ЭтаФорма["ПрофилиПользователя_"+ПостфиксРеквизитов];
		Для Каждого СтрокаТаблицы из СтруктураНастроек.ТаблицаПрофилей Цикл 
			Профиль 			= XMLЗначение(тип("СправочникСсылка.CW_ВебПрофилиПеревозок"), СтрокаТаблицы.Профиль);
			СтруктураОтбора 	= Новый Структура("Профиль",Профиль);
			мНайденныеСтроки 	= ТаблицаПрофилиПользователя.НайтиСтроки(СтруктураОтбора); 
			Если мНайденныеСтроки.Количество() = 0 Тогда 
				//Этого профиля в настрйках уже нет
				НоваяСтрока = ТаблицаПрофилиПользователя.Добавить();
				НоваяСтрока.Профиль = XMLЗначение(тип("СправочникСсылка.CW_ВебПрофили"), СтрокаТаблицы.Профиль);
				НоваяСтрока.УИД  	= СтрокаТаблицы.Профиль;  
				НоваяСтрока.Пометка = Истина;
				НоваяСтрока.Удалить = Истина;    
			Иначе 
				НайденаняСтрока = мНайденныеСтроки[0];
				НайденаняСтрока.Пометка = Истина;
			КонецЕсли; 
		КонецЦикла;  
		
	КонецЦикла;
	
	УстановитьПримерИмениФайла("_1"); 
	УстановитьПримерИмениФайла("_2"); 
	
КонецПроцедуры   

&НаСервере
Функция ПолучитьСоответствиеДнейНеделиИменамРеквизитов()
	
	Результат = Новый Соответствие;
	Результат.Вставить(1,"ДеньПн");
	Результат.Вставить(2,"ДеньВт");
	Результат.Вставить(3,"ДеньСр");
	Результат.Вставить(4,"ДеньЧт");
	Результат.Вставить(5,"ДеньПт");
	Результат.Вставить(6,"ДеньСб");
	Результат.Вставить(7,"ДеньВс");
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура Записать(Команда)
	
	ЗадатьВопросОЗаписиЗаданий();

КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьИЗакрыть(Команда)
	
	ЗадатьВопросОЗаписиЗаданий(Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗадатьВопросОЗаписиЗаданий(ЗакрытьФорму = Ложь)

	НедопустимыеСимволы = ОбщегоНазначенияКлиентСервер.ПолучитьНедопустимыеСимволыВИмениФайла();
	НедопустимыеСимволы = РазделитьНедопустимыеСимволы(НедопустимыеСимволы);	
	
	ТекстПредупреждения = Нстр("ru='В имени файла нельзя использовать символы: ';
	|en='Characters cannot be used in the file name:'") + НедопустимыеСимволы;	
	
	Отказ = Ложь;
	Если Использование_1 Тогда
		Если ЕстьНедопустимыеСимволыВИмениФайла(ШаблонИмениФайла_1) Тогда 
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			"В имени файла нельзя использовать символы: "+ НедопустимыеСимволы,
			,
			"ШаблонИмениФайла_1",
			,
			Отказ);
		КонецЕсли;
	КонецЕсли; 
	
	Если Использование_2 Тогда
		Если ЕстьНедопустимыеСимволыВИмениФайла(ШаблонИмениФайла_2) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			"В имени файла нельзя использовать символы: "+ НедопустимыеСимволы,
			,
			"ШаблонИмениФайла_2",
			,
			Отказ);
		КонецЕсли;
	КонецЕсли;
  
	Если Отказ Тогда 
		Возврат;
	КонецЕсли;
 
	СпроситьПользователяОЗаписи = Ложь;
	ТекстВопроса = "";
	
	МестнаяТекущаяДата = МестнаяТекущаяДата();
	
	Если Использование_1 и ВремяНачала_1 < Дата(1,1,1,Час(МестнаяТекущаяДата), Минута(МестнаяТекущаяДата), 0) и ДатаНачала_1 < МестнаяТекущаяДата Тогда
		ТекстВопроса = Нстр("ru='Будет выполнена задание первой отправки файлов.'; en='The task of sending the files for the first time will be completed.'");
		СпроситьПользователяОЗаписи = Истина;
	КонецЕсли;
	Если Использование_2 и ВремяНачала_2 < Дата(1,1,1,Час(МестнаяТекущаяДата), Минута(МестнаяТекущаяДата), 0) и ДатаНачала_2 < МестнаяТекущаяДата Тогда
		СпроситьПользователяОЗаписи = Истина;
		Если ТекстВопроса <> "" Тогда
			ТекстВопроса = Нстр("ru='Будут выполнены задания первой и второй отправки файлов.'; en='The tasks for the first and second file submission will be completed.'");
		Иначе
			ТекстВопроса = Нстр("ru='Будет выполнена задание второй отправки файлов.'; en='The task of sending the files for the second time will be completed.'");
		КонецЕсли;
	КонецЕсли;
	
	ДополнительныеПараметры = новый Структура;
	ДополнительныеПараметры.Вставить("ЗакрытьФорму", ЗакрытьФорму);
	
	Оповещение = Новый ОписаниеОповещения("ПродолжитьЗаписьЗадания", ЭтотОбъект, ДополнительныеПараметры);
	
	Если СпроситьПользователяОЗаписи Тогда
		
		ТекстВопроса = ТекстВопроса + Нстр("ru=' Продолжить?'; en='Continue?'");;
		
		Режим = РежимДиалогаВопрос.ДаНет;
		ПоказатьВопрос(Оповещение, ТекстВопроса, Режим, 0); 
		
	Иначе
		ВыполнитьОбработкуОповещения(Оповещение,КодВозвратаДиалога.Да);	
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПродолжитьЗаписьЗадания(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Нет Тогда
        Возврат;
	КонецЕсли;
	
	Если Использование_1 и Не ЗначениеЗаполнено(Получатели_1) Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = Нстр("ru='Не указан получатель первой отправки!'; en='Recipient of the first shipment is Empty'");
		Сообщение.Поле = "Получатели_1";
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;
	
	Если Использование_2 и Не ЗначениеЗаполнено(Получатели_2) Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = Нстр("ru='Не указан получатель второй отправки!'; en='Recipient of the second shipment is Empty'");
		Сообщение.Поле = "Получатели_2";
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;
	
 	РезультатВыполнения =  ПродолжитьЗаписьЗаданияНаСервереВФоне();
	
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ВыводитьОкноОжидания = Истина;
	ОповещениеОЗавершении = Новый ОписаниеОповещения("ОбработатьЗавершениеЗаписиЗаданий", ЭтотОбъект, ДополнительныеПараметры);
	
	ДлительныеОперацииКлиент.ОжидатьЗавершение(РезультатВыполнения, ОповещениеОЗавершении, ПараметрыОжидания);
	
КонецПроцедуры 

&НаСервере
Функция ПродолжитьЗаписьЗаданияНаСервереВФоне()  
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(Новый УникальныйИдентификатор);
	ПараметрыВыполнения.ОжидатьЗавершение 			= 0; // запускать сразу
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = "Запись ифнормации о заданиях отправки";
	ПараметрыВыполнения.ЗапуститьВФоне 				= Истина;
	ПараметрыВыполнения.ЗапуститьНеВФоне 			= ложь;   
	
	МассивНастроекДляЗаписи = Новый Массив;
	Если Использование_1 ИЛИ ЗначениеЗаполнено(ИдентификаторЗадания_1) Тогда
		МассивНастроекДляЗаписи.Добавить(ПолучитьПараметрыОтправкиФайлов("1"));
	КонецЕсли;
	
	Если Использование_2 ИЛИ ЗначениеЗаполнено(ИдентификаторЗадания_2) Тогда
		МассивНастроекДляЗаписи.Добавить(ПолучитьПараметрыОтправкиФайлов("2"));
	КонецЕсли;

	ПараметрыПроцедуры = Новый Структура;
	ПараметрыПроцедуры.Вставить("ИдентифкаторПользователя", Пользователь.ИдентифкаторПользователя);   
	ПараметрыПроцедуры.Вставить("МассивНастроекДляЗаписи", 	МассивНастроекДляЗаписи);   
	
	Возврат ДлительныеОперации.ВыполнитьВФоне("CW_ОбщийМодульЛичныйКабинетСервер.ЗаписатьЗаданияОтправки",ПараметрыПроцедуры, ПараметрыВыполнения);
	
КонецФункции

 &НаКлиенте
Процедура ОбработатьЗавершениеЗаписиЗаданий(РезультатВыполнения, ДополнительныеПараметры) Экспорт
	
	Если РезультатВыполнения = Неопределено Тогда 
		Возврат;
	КонецЕсли;

	Если РезультатВыполнения.Статус = "Выполнено" Тогда   
		
		Модифицированность = Ложь;

		Если ДополнительныеПараметры.Свойство("ЗакрытьФорму")
			И ДополнительныеПараметры.ЗакрытьФорму  Тогда
			ЭтаФорма.Закрыть();     
		Иначе
			Результат = ПолучитьИзВременногоХранилища(РезультатВыполнения.АдресРезультата);
			
			Если ТипЗнч(Результат) = Тип("Структура") Тогда
				Для Каждого Задание из Результат.Задания Цикл
					ЭтаФорма["ИдентификаторЗадания_"+СокрЛП(Задание.НомерЗадания)] = Задание.ИдентификаторЗадания;
				КонецЦикла;
			КонецЕсли;
			
		КонецЕсли;
		
	ИначеЕсли РезультатВыполнения.Статус = "Ошибка" Тогда
		
		ТекстПредупреждения = "Ошибка записи заданий!
		| По причине: "+ РезультатВыполнения.ПодробноеПредставлениеОшибки + "
		| Информаиция об ошибке см. в журнале регистрации!";
		
		ПоказатьПредупреждение(, ТекстПредупреждения);
		
	КонецЕсли;
	
КонецПроцедуры  

&НаСервере
Функция ПолучитьПараметрыОтправкиФайлов(Постфикс)

	НастройкиПрофилей = Новый ТаблицаЗначений;
	НастройкиПрофилей.Колонки.Добавить("Профиль", 			Новый ОписаниеТипов("Строка"));
	НастройкиПрофилей.Колонки.Добавить("Статус", 			Новый ОписаниеТипов("Число"));
	
	Отбор = Новый Структура("Пометка", Истина);
	мВыбранныеПрофили = ЭтаФорма["ПрофилиПользователя_"+Постфикс].НайтиСтроки(Отбор);
	Для Каждого СтрокаПрофилей из мВыбранныеПрофили Цикл
		Если НЕ СтрокаПрофилей.Пометка Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = НастройкиПрофилей.Добавить();  
		НоваяСтрока.Профиль	= СтрокаПрофилей.УИД;	
		НоваяСтрока.Статус	= СтрокаПрофилей.Вариант;	
	КонецЦикла; 
	
	СтрДниНедели = СокрЛП(СтрСоединить(ПолучитьДниНедели(Постфикс), ";"));

	Структура = Новый Структура;
	Структура.Вставить("НомерЗадания", 			Постфикс);
	Структура.Вставить("ИдентификаторЗадания", 	ЭтаФорма["ИдентификаторЗадания_"+ Постфикс]);
 	Структура.Вставить("Использование",   		ЭтаФорма["Использование_"	+ Постфикс]);
	Структура.Вставить("ДатаНачала",  			ЭтаФорма["ДатаНачала_"		+ Постфикс]);
	Структура.Вставить("ВремяНачала", 			ЭтаФорма["ВремяНачала_"		+ Постфикс]);
 	Структура.Вставить("ДниНедели",   			СтрДниНедели);
	Структура.Вставить("Получатели", 			ЭтаФорма["Получатели_"		+ Постфикс]);
	Структура.Вставить("Копии", 	 			ЭтаФорма["Копии_"			+ Постфикс]);
	Структура.Вставить("ОтправлятьПакет",		ЭтаФорма["ОтправлятьПакет_"	+ Постфикс]);
	Структура.Вставить("ШаблонИмениФайла",		ЭтаФорма["ШаблонИмениФайла_"+ Постфикс]);
	Структура.Вставить("НастройкиПрофилей",		НастройкиПрофилей);  
	Структура.Вставить("ОсновнойПрофиль",		XMLСтрока(ОсновнойПрофиль));  
	
	Возврат Структура;

КонецФункции 

&НаСервере
Функция ПолучитьДниНедели(Постфикс)
	
	мДни = Новый Массив;
	мДни.Добавить(1);
	мДни.Добавить(2);
	мДни.Добавить(3);
	мДни.Добавить(4);
	мДни.Добавить(5);
	мДни.Добавить(6);
	мДни.Добавить(7);
	
	СоответствиеРеквизитовДням = ПолучитьСоответствиеДнейНеделиИменамРеквизитов();
	
	мДниНедели = Новый Массив;
	
	Если ЭтаФорма["Использование_"+Постфикс] Тогда
		Для Каждого День из мДни Цикл
			ИмяРеквизита = СоответствиеРеквизитовДням.Получить(День);
			ДеньВыбран = ЭтаФорма[ИмяРеквизита+"_"+Постфикс];
			Если ДеньВыбран тогда
				мДниНедели.Добавить(День);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Возврат мДниНедели;
	
КонецФункции

&НаКлиенте
Процедура ОтправитьВручнуюПервое(Команда)

	Если Не ЗначениеЗаполнено(ИдентификаторЗадания_1) Тогда
		ПоказатьПредупреждение(,Нстр("ru='Не настроено задания первой отправки файлов!';
									 |en='The task of sending files for the first time is not configured!'"));
		Возврат;
	КонецЕсли;
	
	Если Модифицированность Тогда
		ПоказатьПредупреждение(,Нстр("ru='Для выполнения задания нужно записать настройки!'; en='To run the task, you need to write down the settings!'"));
		Возврат;
	КонецЕсли;
	
	ВыполнитьЗаданиеСейчас("1");
	
КонецПроцедуры

