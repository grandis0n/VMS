&НаСервере
Функция МестнаяТекущаяДата()
	
	УниверсальноеВремяНачала = УниверсальноеВремя(ТекущаяДата(), ЧасовойПояс());
	Возврат МестноеВремя(УниверсальноеВремяНачала, ЧасовойПояс); 
	
КонецФункции

&НаСервере
Функция ПолучитьМестноеВремя(ВремяНачала)
	
	ДатаВремя = Дата(Год(ТекущаяДата()), Месяц(ТекущаяДата()), День(ТекущаяДата()), Час(ВремяНачала), Минута(ВремяНачала), Секунда(ВремяНачала));
	
	УниверсальноеВремяНачала = УниверсальноеВремя(ДатаВремя, ЧасовойПояс());
	Возврат МестноеВремя(УниверсальноеВремяНачала, ЧасовойПояс); 
	
КонецФункции

&НаСервере
Функция ВремяСервера(ВремяНачала)
	
	ДатаВремя = Дата(Год(ТекущаяДата()), Месяц(ТекущаяДата()), День(ТекущаяДата()), Час(ВремяНачала), Минута(ВремяНачала), Секунда(ВремяНачала));
	
	УниверсальноеВремяНачала = УниверсальноеВремя(ДатаВремя, ЧасовойПояс);
	Возврат МестноеВремя(УниверсальноеВремяНачала, ЧасовойПояс()); 
	
КонецФункции



