#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

Процедура ПередЗаписью(Отказ)
	
	Если ПометкаУдаления Тогда
		
		Использование = Ложь;
		
	КонецЕсли; 
	
КонецПроцедуры

// --- 

Процедура ПриЗаписи(Отказ)
	
	Если Использование Тогда
		
		Попытка
			
			УстановитьПривилегированныйРежим(Истина);
			// --- 
			
			// удаляем существующие связанные регламентные задания
			Ответ = _ПО.УдалитьСвязанныеРегламентныеЗадания(Ссылка);
			
			МассивИдентификаторовРЗ = Новый Массив;
			
			// создаём РЗ
			РЗ = РегламентныеЗадания.СоздатьРегламентноеЗадание("CW_РегламентнаяОтправкаСистемныхСообщений");
			РЗ.ИмяПользователя = "";
			РЗ.Наименование = "Отправка логов ("+Строка(Ссылка)+")";
			// --- 
			МассивПараметров = Новый Массив;
			МассивПараметров.Добавить(Ссылка);
			РЗ.Параметры = МассивПараметров;
			// --- 
			// расписание
			РасписаниеРЗ = Расписание.Получить();
			Если РасписаниеРЗ <> Неопределено Тогда
				
				РЗ.Расписание = РасписаниеРЗ;
				
			КонецЕсли; 
			// --- 
			РЗ.Использование = Истина;
			// --- 
			РЗ.Записать();
			
			// записываем идентификатор созданного задания в регистр
			Ответ = _ПО.ДобавитьСвязанноеРегламентноеЗадание(Ссылка,РЗ.УникальныйИдентификатор);
			
			// --- 
			УстановитьПривилегированныйРежим(Ложь);
			
		Исключение
			
			CW_Журнал.ОтладочноеСообщение("ФильтрыСистемныхСообщений.РегистрацияЗадания",Строка(Ссылка)+Символы.ПС+ОписаниеОшибки());
			
		КонецПопытки; 
		
	Иначе
		
		Ответ = _ПО.УдалитьСвязанныеРегламентныеЗадания(Ссылка);
		                                                        		
	КонецЕсли; 
	
КонецПроцедуры

#КонецЕсли