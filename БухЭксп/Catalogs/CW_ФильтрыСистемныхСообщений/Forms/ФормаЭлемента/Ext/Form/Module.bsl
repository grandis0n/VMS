&НаКлиенте
Процедура РасписаниеНажатие(Элемент)
	
	Если Расписания.Количество() > 0 Тогда
        РасписаниеРЗ = Расписания.Получить(0).Значение;
    Иначе
        РасписаниеРЗ = Неопределено;
    КонецЕсли;
	
	Если РасписаниеРЗ = Неопределено Тогда
		
		РасписаниеРЗ = Новый РасписаниеРегламентногоЗадания;
		
	КонецЕсли;
	
	ДиалогРасписания = Новый ДиалогРасписанияРегламентногоЗадания(РасписаниеРЗ);
	ПОВ = Новый ОписаниеОповещения("ОбработкаИзмененияРасписания",ЭтотОбъект); 
	ДиалогРасписания.Показать(ПОВ);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаИзмененияРасписания(РасписаниеОтвет, ДополнительныеПараметры) Экспорт 
	// --- 
	
	Расписания.Очистить();
	Расписания.Добавить(РасписаниеОтвет);
	Элементы.Расписание.Заголовок = "Расписание ("+Строка(РасписаниеОтвет)+")";
	
	// --- 
КонецПроцедуры
  

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	Если Расписания.Количество() <> 0 Тогда
		
		ТекущийОбъект.Расписание = Новый ХранилищеЗначения(Расписания.Получить(0).Значение);
		
	КонецЕсли; 
	
КонецПроцедуры
 
