// --- 

&НаСервере
Процедура _ПриоритетПриИзменении(ИмяЭлемента)
	// --- 
	
	Значение = ЭтаФорма[ИмяЭлемента];
	ЗП = Перечисления.CW_ПриоритетыСистемныхСообщений["p"+Прав(ИмяЭлемента,1)];
	Если Значение Тогда
		
		// добавляем
		Нстр = Объект.Приоритеты.Добавить();
		Нстр.Приоритет = ЗП;

		
		
	Иначе
		
		// удаляем
		Строка = _сф.к_НайтиСтроку(Объект.Приоритеты,"Приоритет",ЗП);
		Если Строка <> Неопределено Тогда
			
			Объект.Приоритеты.Удалить(Строка);
			
		КонецЕсли; 
				
	КонецЕсли; 
	
	// --- 
КонецПроцедуры

