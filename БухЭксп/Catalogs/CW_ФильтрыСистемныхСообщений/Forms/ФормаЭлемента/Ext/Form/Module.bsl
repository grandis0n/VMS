&НаКлиенте
Процедура ИсточникиПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа)
	
	Отказ = Истина;
	ПОВ = Новый ОписаниеОповещения("ОбработкаДобавленияИсточника",ЭтотОбъект); 
	ОткрытьФорму("Справочник.CW_ИсточникиСистемныхСообщений.ФормаВыбора",Новый Структура("РежимВыбора",Истина),,,,,ПОВ, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаДобавленияИсточника(Ответ, ДополнительныеПараметры) Экспорт 
	// --- 
	
	Если (Ответ <> Неопределено) Тогда
		
		// проверяем, не дубль ли
		Если НЕ _ДобавитьИсточник(Ответ) Тогда
			
			_УФК.ВывестиПредупреждение("Источник уже добавлен.");
			
		КонецЕсли; 
		
	КонецЕсли; 
	
	// --- 
КонецПроцедуры
  

&НаСервере
Функция _ДобавитьИсточник(Источник)
	// --- 
	
	Строка = _сф.к_НайтиСтроку(Объект.Источники,"Источник",Источник);
	Если Строка = Неопределено Тогда
		
		Нстр = Объект.Источники.Добавить();
		Нстр.Источник = Источник;
		Возврат(Истина);
		
	Иначе
		
		Возврат(Ложь);
		
	КонецЕсли; 
	
	// --- 
КонецФункции

