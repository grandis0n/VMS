
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// формируем заголовки флажков приоритетов
	Для каждого ЗП Из Метаданные.Перечисления.CW_ПриоритетыСистемныхСообщений.ЗначенияПеречисления Цикл
		
		Индекс = Прав(ЗП.Имя,1);
		Элементы["п"+Индекс].Заголовок = ЗП.Синоним;
		
	КонецЦикла; 
	
	_ПрочитатьЗначенияПриоритетов();
	
	// --- 
	
	Расписания.Очистить();
	РасписаниеРЗ = РеквизитФормыВЗначение("Объект").Расписание.Получить();
	Если РасписаниеРЗ <> Неопределено Тогда
		
		Элементы.Расписание.Заголовок = "Расписание ("+Строка(РасписаниеРЗ)+")";
		Расписания.Добавить(РасписаниеРЗ);
		
	КонецЕсли; 
	
	// --- 
	
	_УправлениеЭлементамиФормы();
	//Внешние подклчюаемые команды
	CW_ПодключаемыеКомандыСервер.ПриСозданииНаСервере(ЭтотОбъект);

КонецПроцедуры

&НаСервере
Процедура _ПрочитатьЗначенияПриоритетов()
	// --- 
	
	п0 = Ложь;
	п1 = Ложь;
	п2 = Ложь;
	п3 = Ложь;
	п4 = Ложь;
	п5 = Ложь;
	п6 = Ложь;
	п7 = Ложь;
	// --- 
	
	Для каждого Стр Из Объект.Приоритеты Цикл
		
		Индекс = _ПолучитьИндекс(Стр.Приоритет);
		ЭтаФорма["п"+Индекс]=Истина;
		
	КонецЦикла; 
	
	// --- 
КонецПроцедуры

&НаСервере
Функция _ПолучитьИндекс(ЗП)
	// --- 
	
	Если ЗП = Перечисления.CW_ПриоритетыСистемныхСообщений.p0 Тогда
		
		Возврат("0");
		
	ИначеЕсли ЗП = Перечисления.CW_ПриоритетыСистемныхСообщений.p1 Тогда 
		
		Возврат("1"); 
		
	ИначеЕсли ЗП = Перечисления.CW_ПриоритетыСистемныхСообщений.p2 Тогда 
		
		Возврат("2"); 

	ИначеЕсли ЗП = Перечисления.CW_ПриоритетыСистемныхСообщений.p3 Тогда 
		
		Возврат("3"); 

	ИначеЕсли ЗП = Перечисления.CW_ПриоритетыСистемныхСообщений.p4 Тогда 
		
		Возврат("4"); 
		
	ИначеЕсли ЗП = Перечисления.CW_ПриоритетыСистемныхСообщений.p5 Тогда 
		
		Возврат("5"); 

	ИначеЕсли ЗП = Перечисления.CW_ПриоритетыСистемныхСообщений.p6 Тогда 
		
		Возврат("6"); 

    ИначеЕсли ЗП = Перечисления.CW_ПриоритетыСистемныхСообщений.p7 Тогда 
		
		Возврат("7"); 
		
	КонецЕсли; 
	
	// --- 
КонецФункции
   

&НаСервере
Процедура _УправлениеЭлементамиФормы()
	// --- 
	
	Элементы.ГруппаПриоритеты.ТолькоПросмотр = (НЕ Объект.ОтборПоПриоритету);
	
	Элементы.Источники.ТолькоПросмотр = (Объект.ВариантФильтрацииПоИсточнику = 0);
	
	// --- 
КонецПроцедуры


&НаКлиенте
Процедура ОтборПоПриоритетуПриИзменении(Элемент)
	
	_ОтборПоПриоритетуПриИзменении();
	
КонецПроцедуры
 
&НаСервере
Процедура _ОтборПоПриоритетуПриИзменении()
	// --- 
	
	Если НЕ Объект.ОтборПоПриоритету Тогда
		
		Объект.Приоритеты.Очистить();
		_ПрочитатьЗначенияПриоритетов();
		
	КонецЕсли; 
	
	_УправлениеЭлементамиФормы();
	
	// --- 
КонецПроцедуры

