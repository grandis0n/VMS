
&НаКлиенте
Процедура SWIFTПриИзменении(Элемент)
	// только заглавные латинские буквы и цифры
	Объект.SWIFT = СОКРЛП(ВРЕГ(Объект.SWIFT));
	
	ТекстОшибки = "";
	новыйЦветТекста = Неопределено;
	
	Если НЕ _ПроверитьКорректностьSWIFT(Объект.SWIFT, ТекстОшибки, новыйЦветТекста) Тогда 
		Элементы.SWIFT.Заголовок = "SWIFT: "+ТекстОшибки;
	Иначе 
		Элементы.SWIFT.Заголовок = "SWIFT";
	КонецЕсли;
	Элементы.SWIFT.ЦветТекста = новыйЦветТекста;

КонецПроцедуры

&НаСервереБезКонтекста
Функция _ПроверитьКорректностьSWIFT(свифт, ТекстОшибки, ЦветТекста)

	флКорректен = Справочники.CW_ИностранныеБанки.ПроверитьКорректностьSWIFT(свифт, ТекстОшибки);
	Если флКорректен Тогда 
		ЦветТекста = ЦветаСтиля.ЦветТекстаПоля;
	Иначе 
		ЦветТекста = ЦветаСтиля.ЦветОсобогоТекста;
	КонецЕсли;

	Возврат флКорректен;
	
КонецФункции

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	
	//Внешние подклчюаемые команды
	CW_ПодключаемыеКомандыСервер.ПриСозданииНаСервере(ЭтотОбъект);
	
КонецПроцедуры

#Область Подключаемые_внешние_команды

&НаКлиенте
Процедура ВнешняяКоманда_ВыполнитьКоманду(Команда)
	
	CW_ПодключаемыеКомандыКлиент.ВыполнитьВнешнююКоманду(ЭтотОбъект, Команда.Имя);

КонецПроцедуры

#КонецОбласти