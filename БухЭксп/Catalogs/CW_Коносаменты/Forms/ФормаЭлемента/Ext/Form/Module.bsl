КонецФункции 

&НаСервере
Функция ПолучитьГруз()
	
	УчетГруза = ПолучитьФункциональнуюОпциюФормы("CW_КоносаментыУчетГруза");
	УчетЗаявок = ПолучитьФункциональнуюОпциюФормы("CW_КоносаментыУчетЗаявок");
	
	Если УчетЗаявок и УчетГруза 
		И ЗначениеЗаполнено(Объект.Заявка) Тогда
		Возврат Объект.Заявка.Груз;
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Процедура СоздатьГрузоперевозки(Команда) 
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Записать", Модифицированность);
	
	Оповещение = Новый ОписаниеОповещения("ПередСозданиемГрузоперевозок", ЭтотОбъект, ДополнительныеПараметры);
	
	Если Модифицированность Тогда 
		Режим = РежимДиалогаВопрос.ДаНет;
		ПоказатьВопрос(Оповещение, "Коносамент будет записан. Продолжить?", Режим, 0); 
	Иначе
		ВыполнитьОбработкуОповещения(Оповещение, КодВозвратаДиалога.Да); 
	КонецЕсли;
	
КонецПроцедуры    

&НаКлиенте
Процедура ПередСозданиемГрузоперевозок(Результат, ДополнительныеПараметры) Экспорт
	Если Результат = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;  
	
	Если ДополнительныеПараметры.Записать Тогда
		ЭтотОбъект.Записать();
	КонецЕсли;
	
	ВыделенныеСтроки = Элементы.ГрузовыеЕдиницы.ВыделенныеСтроки;
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ВыделенныеСтроки", ВыделенныеСтроки);
	
	Оповещение = Новый ОписаниеОповещения("ПродолжитьСозданиеГрузоперевозок", ЭтотОбъект, ДополнительныеПараметры);
	
	Режим = РежимДиалогаВопрос.ДаНет;
	ПоказатьВопрос(Оповещение, "Для выеделенных строк будут созданы грузоперевозки. Продолжить?", Режим, 0); 
	
КонецПроцедуры    

&НаКлиенте
Процедура ПродолжитьСозданиеГрузоперевозок(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;  
	
	Результат = СоздатьГрузоперевозкиНаСервере(ДополнительныеПараметры.ВыделенныеСтроки);
	
	Если Результат.Создано <> 0 Тогда 
		ПоказатьПредупреждение(, "Создано грузоперевозок: "+Формат(Результат.Создано,"ЧГ=0"));
	КонецЕсли;
	Если Результат.НомераСтрок.Количество() > 0 Тогда 
		ПоказатьПредупреждение(, "При формировании грузоперевозок возникла ошибка!");  
		Для каждого НомерСтроки из Результат.НомераСтрок Цикл
			Сообщить("Не удалось сформировать грузоперевозку по строке "+Формат(НомерСтроки,"ЧГ=0")+"!");	
		КонецЦикла;
	КонецЕсли;
	
	Элементы.Грузоперевозки.Обновить();
	
КонецПроцедуры   

&НаСервере
Функция СоздатьГрузоперевозкиНаСервере(ВыделенныеСтроки)
	
	Результат = Новый Структура("Создано,НомераСтрок",0,Новый Массив);
	
	МассивИдентификаторовСтрок = Новый Массив; 
	Для каждого ВыделеннаяСтрока из ВыделенныеСтроки Цикл
		СтрокаТаблицы = Объект.ГрузовыеЕдиницы.НайтиПоИдентификатору(ВыделеннаяСтрока);
		МассивИдентификаторовСтрок.Добавить(СтрокаТаблицы.ИдентификаторСтроки);
	КонецЦикла;   
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	CW_ГрузоперевозкиКоносаментов.ИдентификаторСтроки КАК ИдентификаторСтроки
	|ИЗ
	|	РегистрСведений.CW_ГрузоперевозкиКоносаментов КАК CW_ГрузоперевозкиКоносаментов
	|ГДЕ
	|	CW_ГрузоперевозкиКоносаментов.ИдентификаторСтроки В(&МассивИдентификаторовСтрок)";
	
	Запрос.УстановитьПараметр("МассивИдентификаторовСтрок", МассивИдентификаторовСтрок);
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() 
		и МассивИдентификаторовСтрок.Количество() > 0 Цикл
		МассивИдентификаторовСтрок.Удалить(МассивИдентификаторовСтрок.Найти(Выборка.ИдентификаторСтроки));
	КонецЦикла;   
	
	Если МассивИдентификаторовСтрок.Количество() = 0 Тогда  
		Для каждого ВыделеннаяСтрока из ВыделенныеСтроки Цикл
			СтрокаТаблицы = Объект.ГрузовыеЕдиницы.НайтиПоИдентификатору(ВыделеннаяСтрока);
			Результат.НомераСтрок.Добавить(СтрокаТаблицы.НомерСтроки);
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;  
	
	ГрузовыеЕдиницы = Объект.ГрузовыеЕдиницы.Выгрузить(); //ну куда же без этого
	
	Для Каждого ИдентификаторСтроки из МассивИдентификаторовСтрок Цикл
		
		Отбор = Новый Структура;
		Отбор.Вставить("ИдентификаторСтроки", ИдентификаторСтроки);
		
		мГрузовыеЕдиницы= Объект.ГрузовыеЕдиницы.НайтиСтроки(Отбор);;  
		Если мГрузовыеЕдиницы.количество() = 0 Тогда
			Продолжить;
		КонецЕсли;  
		
		НайденнаяСтрока = мГрузовыеЕдиницы[0]; 
		
		ЗначенияЗаполнения = Новый Структура;
		ЗначенияЗаполнения.Вставить("Коносамент", 	 Объект.Ссылка);
		ЗначенияЗаполнения.Вставить("СтрокаТаблицы", НайденнаяСтрока);
		
		НоваяГрузопереовозка = Справочники.CW_Грузоперевозки.СоздатьЭлемент();
		НоваяГрузопереовозка.Заполнить(ЗначенияЗаполнения);
		
		НоваяГрузопереовозка.CW_Представление = НайденнаяСтрока.НаименованиеГрузовойЕдиницы;
		НоваяГрузопереовозка.ДатаСделкиФ = Объект.Дата;
		НоваяГрузопереовозка.Наименование = НайденнаяСтрока.НаименованиеГрузовойЕдиницы;
		НоваяГрузопереовозка.Типоразмер   = НайденнаяСтрока.Типоразмер;
		
		Попытка
			НоваяГрузопереовозка.Записать();  
			Результат.Создано = Результат.Создано + 1;
		Исключение 
			Результат.НомераСтрок.Добавить(НайденнаяСтрока.НомерСтроки);
			Продолжить;
		КонецПопытки;
		
		ЗаписьРегистра = РегистрыСведений.CW_ГрузоперевозкиКоносаментов.СоздатьМенеджерЗаписи();
		ЗаписьРегистра.Грузоперевозка = НоваяГрузопереовозка.Ссылка;
		ЗаписьРегистра.Коносамент = Объект.Ссылка;
		ЗаписьРегистра.ИдентификаторСтроки = ИдентификаторСтроки;
		ЗаписьРегистра.Записать();
		
	КонецЦикла;
	
	Для каждого ВыделеннаяСтрока из ВыделенныеСтроки Цикл
		СтрокаТаблицы = Объект.ГрузовыеЕдиницы.НайтиПоИдентификатору(ВыделеннаяСтрока);
		ЗаполнитьСписокГрузопереозвокПоСтроке(СтрокаТаблицы); 
	КонецЦикла;   
	
	Возврат Результат;
	
КонецФункции


&НаКлиенте
Процедура ОбновитьГрузоперевозки(Команда)   
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Записать", Модифицированность);
	
	Оповещение = Новый ОписаниеОповещения("ПередВыполнениемОбновитьГрузоперевозки", ЭтотОбъект, ДополнительныеПараметры);
	
	Если Модифицированность Тогда 
		Режим = РежимДиалогаВопрос.ДаНет;
		ПоказатьВопрос(Оповещение, "Коносамент будет записан. Продолжить?", Режим, 0); 
	Иначе
		ВыполнитьОбработкуОповещения(Оповещение, КодВозвратаДиалога.Да); 
	КонецЕсли;
	
	
КонецПроцедуры   


&НаКлиенте
Процедура ПередВыполнениемОбновитьГрузоперевозки(Результат, ДополнительныеПараметры) Экспорт
	Если Результат = КодВозвратаДиалога.Нет Тогда   
		ПоказатьПредупреждение(, "Произошла ошибка. Данные грузоперевозок не обновлены!");
		Возврат;
	КонецЕсли;  
	
	Если ДополнительныеПараметры.Записать Тогда 
		Попытка
			ЭтотОбъект.Записать();
		Исключение
			ПоказатьПредупреждение(, "Произошла ошибка. Данные грузоперевозок не обновлены!");
		КонецПопытки;
	КонецЕсли;
	
	ВыделенныеСтроки = Элементы.ГрузовыеЕдиницы.ВыделенныеСтроки;
	
	Успешно = ОбновитьГрузоперевозкиНаСервере(ВыделенныеСтроки);
	Если Успешно Тогда
		ПоказатьПредупреждение(, "Данные грузоперевозок обновлены!");	
	КонецЕсли;
	
КонецПроцедуры  

&НаСервере
Функция ОбновитьГрузоперевозкиНаСервере(ВыделенныеСтроки)
	
	Для Каждого ТекущаяСтрока из ВыделенныеСтроки Цикл
		СтрокаТекущая = Объект.ГрузовыеЕдиницы.НайтиПоИдентификатору(ТекущаяСтрока);                                  
		
		ЗначенияЗаполнения = Новый Структура;
		ЗначенияЗаполнения.Вставить("Коносамент", 	 Объект.Ссылка);
		ЗначенияЗаполнения.Вставить("СтрокаТаблицы", СтрокаТекущая);
		
		Для Каждого ЭлементСписка из СтрокаТекущая.СписокГрузоперевозок Цикл  
			ГрузоперевозкаОбъект = ЭлементСписка.Значение.ПолучитьОбъект();
			ГрузоперевозкаОбъект.Заполнить(ЗначенияЗаполнения);
			
			ГрузоперевозкаОбъект.CW_Представление = СтрокаТекущая.НаименованиеГрузовойЕдиницы;
			ГрузоперевозкаОбъект.ДатаСделкиФ = Объект.Дата;
			ГрузоперевозкаОбъект.Наименование = СтрокаТекущая.НаименованиеГрузовойЕдиницы;
			ГрузоперевозкаОбъект.Типоразмер   = СтрокаТекущая.Типоразмер;
			
			ГрузоперевозкаОбъект.Записать();
		КонецЦикла;
	КонецЦикла;  
	
	УстановитьСписокГрузоперевозокВСтроки();  
	
	Возврат Истина;
	
КонецФункции    

&НаСервере
Процедура УстановитьСписокГрузоперевозокВСтроки()  
	
	Для каждого СтрокаТаблицы из Объект.ГрузовыеЕдиницы Цикл
		ЗаполнитьСписокГрузопереозвокПоСтроке(СтрокаТаблицы); 
	КонецЦикла;
	
КонецПроцедуры 

&НаСервере
Процедура ЗаполнитьСписокГрузопереозвокПоСтроке(СтрокаТаблицы)  
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	CW_ГрузоперевозкиКоносаментов.Грузоперевозка КАК Грузоперевозка
	|ИЗ
	|	РегистрСведений.CW_ГрузоперевозкиКоносаментов КАК CW_ГрузоперевозкиКоносаментов
	|ГДЕ
	|	CW_ГрузоперевозкиКоносаментов.Коносамент = &Коносамент
	|	И CW_ГрузоперевозкиКоносаментов.ИдентификаторСтроки = &ИдентификаторСтроки";  
	
	Запрос.УстановитьПараметр("Коносамент", Объект.Ссылка);
	Запрос.УстановитьПараметр("ИдентификаторСтроки", СтрокаТаблицы.ИдентификаторСтроки);     
	
	РезультатЗапроса = Запрос.Выполнить();
	
	МассивГрузоперевозок = РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("Грузоперевозка");
	
	СтрокаТаблицы.СписокГрузоперевозок.ЗагрузитьЗначения(МассивГрузоперевозок);  
	СтрокаТаблицы.СписокГрузоперевозокСтрокой = СтрСоединить(МассивГрузоперевозок, ", ");
	
КонецПроцедуры 


&НаКлиенте
Процедура ГрузовыеЕдиницыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Поле.Имя = "ГрузовыеЕдиницыСписокГрузоперевозокСтрокой" Тогда
		СтандартнаяОбработка = Ложь;  
		
		СписокГрузоперевозок = ПолучитьСписокГрузоперевозок(ВыбраннаяСтрока);
		Если СписокГрузоперевозок.Количество() = 0 Тогда
			Возврат;
		КонецЕсли;
		
		Оповещение = Новый ОписаниеОповещения("ПослеВыбораГрузоперевозкиИзСписка", ЭтотОбъект);
		Если СписокГрузоперевозок.Количество() = 1 Тогда   
			ЭлементСписка = СписокГрузоперевозок.Получить(0);   
			ВыполнитьОбработкуОповещения(Оповещение,ЭлементСписка); 
		Иначе    
			СписокГрузоперевозок.ПоказатьВыборЭлемента(Оповещение, "ВЫбор грузоперевозки");
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры     

&НаКлиенте
Процедура ПослеВыбораГрузоперевозкиИзСписка(ЭлементСписка, ДополнительныеПараметры) Экспорт
	
	Если ЭлементСписка = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПоказатьЗначение(,ЭлементСписка.Значение);
	
КонецПроцедуры

&НаСервере
Функция ПолучитьСписокГрузоперевозок(ВыбраннаяСтрока)
	
	СтрокаТаблицы = Объект.ГрузовыеЕдиницы.НайтиПоИдентификатору(ВыбраннаяСтрока);  
	Возврат СтрокаТаблицы.СписокГрузоперевозок;
	
КонецФункции

