&НаСервереБезКонтекста
Функция ГрузоотправителиИГрузополучателиПолучитьДанные(Источник) 
	
	Структура = Новый Структура;
	Структура.Вставить("ПолноеНаименование", 	Источник.ПолноеНаименование);
	Структура.Вставить("ЮридическийАдрес", 		Источник.ЮридическийАдрес);
	
	Возврат Структура;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьНаименованиеИАдрес(ИмяРеквизита, Данные) 
	
	Объект[ИмяРеквизита+"Наименование"] = Данные.ПолноеНаименование;
	Объект[ИмяРеквизита+"Адрес"] 		= Данные.ЮридическийАдрес;
	
КонецПроцедуры

&НаКлиенте
Процедура ГрузоперевозкиПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	Если Объект.Ссылка.Пустая() Тогда
		ПоказатьПредупреждение(, "Необходимо записать элемент!");
		Отказ = истина;
		Возврат;
	КонецЕсли;  
	
	Если Не ЗначениеЗаполнено(Объект.Контрагент) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
		"Для создания грузоперевозки требуется обязательное заполнение клиента!",,
		"Контрагент",
		"Объект", 
		Отказ);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.ТипКоносамента) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
		"Для создания грузоперевозки требуется обязательное заполнение типа коносамента!",,
		"ТипКоносамента",
		"Объект", 
		Отказ);
	КонецЕсли; 
	
	Если Не ЗначениеЗаполнено(Объект.ТипПеревозки) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
		"Для создания грузоперевозки требуется обязательное заполнение типа перевозки!",,
		"ТипПеревозки",
		"Объект", 
		Отказ);
	КонецЕсли;  
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	ЗначенияЗаполнения = Новый Структура;
	ЗначенияЗаполнения.Вставить("Коносамент", Объект.Ссылка);
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("ЗначенияЗаполнения", ЗначенияЗаполнения);
	
	ОткрытьФорму("Справочник.CW_Грузоперевозки.ФормаОбъекта", СтруктураПараметров, ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаказыПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	Отказ = Истина;
	
	Если Копирование Тогда
		Возврат;
	КонецЕсли;
	
	Если Объект.Ссылка.Пустая() Тогда
		ПоказатьПредупреждение(, "Необходимо записать элемент!");
		Возврат;
	КонецЕсли; 
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Записать", Модифицированность);
	
	Оповещение = Новый ОписаниеОповещения("ПередСозданиемЗаказа", ЭтотОбъект, ДополнительныеПараметры);
	
	Если Модифицированность Тогда 
		Режим = РежимДиалогаВопрос.ДаНет;
		ПоказатьВопрос(Оповещение, "Коносамент будет записан. Продолжить?", Режим, 0); 
	Иначе
		ВыполнитьОбработкуОповещения(Оповещение, КодВозвратаДиалога.Да); 
	КонецЕсли;
	
КонецПроцедуры 

&НаКлиенте
Процедура ПередСозданиемЗаказа(Результат, ДополнительныеПараметры) Экспорт
	Если Результат = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;  
	
	Если ДополнительныеПараметры.Записать Тогда   
		ЭтотОбъект.Записать();
	КонецЕсли;    
	
	ЕстьЗаказыКоносамента = ЕстьЗаказыКоносамента();
	
	Оповещение = Новый ОписаниеОповещения("ПродолжитьСозданиеЗаказа", ЭтотОбъект);
	
	Если ЕстьЗаказыКоносамента Тогда
		Режим = РежимДиалогаВопрос.ДаНет;
		ПоказатьВопрос(Оповещение, "По коносаменту уже существует заказ(ы). Продолжить?", Режим, 0);
	Иначе
		ВыполнитьОбработкуОповещения(Оповещение, КодВозвратаДиалога.Да);
	КонецЕсли;
	
КонецПроцедуры          

&НаКлиенте
Процедура ПродолжитьСозданиеЗаказа(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Нет Тогда
		Возврат;                                                             
	КонецЕсли;                                                                
	
	Если Не ЗначениеЗаполнено(Объект.Контрагент) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
		"Для создания заказа требуется обязательное заполнение клиента!",,
		"Контрагент",
		"Объект");
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.ТипПеревозки) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
		"Для создания заказа требуется обязательное заполнение типа перевозки!",,
		"ТипПеревозки",
		"Объект"); 
		Возврат;
	КонецЕсли;  
	
	Если Не ЗначениеЗаполнено(Объект.Наименование) 
		И Не ЗначениеЗаполнено(Объект.Букинг) Тогда  
		
		Если Не ЗначениеЗаполнено(Объект.Наименование) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			"Для создания заказа требуется обязательное заполнение номера коносамента!",,
			"Наименование",
			"Объект"); 
			Возврат;
		КонецЕсли;  
		
		Если Не ЗначениеЗаполнено(Объект.Букинг) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			"Для создания заказа требуется обязательное заполнение букинга коносамента!",,
			"Букинг",
			"Объект"); 
			Возврат;
		КонецЕсли;  
	КонецЕсли;  
	
	МассивГрузоперевозок = ПолучитьСписокЗаказовКоносамента();
	Если МассивГрузоперевозок.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Для создания заказа требуется выбрать хотя бы одну грузоперевозку!");
		Возврат;
	КонецЕсли;     
	
	СтруктураОтбора = Новый Структура;
	СтруктураОтбора.Вставить("Ссылка", МассивГрузоперевозок);
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("Отбор", СтруктураОтбора);
	СтруктураПараметров.Вставить("МножественныйВыбор", Истина);
	СтруктураПараметров.Вставить("ЗакрыватьПриВыборе", Истина);
	
	Оповещение = Новый ОписаниеОповещения("ПослеВыбораГрузоперевозок", ЭтотОбъект);
	
	ОткрытьФорму("Справочник.CW_Грузоперевозки.ФормаВыбора", СтруктураПараметров, ЭтаФорма,,,,Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры     

&НаКлиенте
Процедура ПослеВыбораГрузоперевозок(РезультатВыбора, ДополнительынеПараметры) Экспорт
	
	Если РезультатВыбора = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЗаказСсылка = СоздатьЗаказНаСервере(РезультатВыбора);  
	
	Элементы.Заказы.Обновить();
	
	Если ЗаказСсылка <> Неопределено Тогда
		ПоказатьЗначение(,ЗаказСсылка);       
	КонецЕсли;
	
КонецПроцедуры  

&НаСервере
Функция СоздатьЗаказНаСервере(МассивГрузоперевозок)
	
	НовыйЗаказ = Справочники.CW_Заказы.СоздатьЭлемент();
	НовыйЗаказ.Наименование = ?(ПустаяСтрока(Объект.Наименование), Объект.Букинг, Объект.Наименование);
	НовыйЗаказ.Коносамент   = Объект.Ссылка;
	НовыйЗаказ.ДатаСделкиФ  = Объект.Дата;
	НовыйЗаказ.ТипПеревозки = Объект.ТипПеревозки;
	НовыйЗаказ.Клиент		= Объект.Контрагент;
	НовыйЗаказ.Заявка		= Объект.Заявка;
	
	МенеджерПродаж = Объект.Заявка.МенеджерПродаж;
	Если Не ЗначениеЗаполнено(МенеджерПродаж) Тогда
		МенеджерПродаж = CW_Настройки.ПолучитьНастройкуПользователя(CW_Настройки.Пользователь(),"ОсновнойМенеджерПродаж");
	КонецЕсли;
	
	НовыйЗаказ.МенеджерПродаж = МенеджерПродаж;      
	НовыйЗаказ.ОперативныйМенеджер = CW_Настройки.ПолучитьНастройкуПользователя(CW_Настройки.Пользователь(),"ОсновнойОперативныйМенеджер");
	
	НовыйЗаказ.Маршрут = Объект.Заявка.Маршрут;
	НовыйЗаказ.Груз = Объект.Заявка.Груз;
	
	НовыйЗаказ.ГруппыПараметровЗаказа.Загрузить(НовыйЗаказ.ТипПеревозки.ГруппыПараметровЗаказа.Выгрузить());
	НовыйЗаказ.ПараметрыЗаказа.Загрузить(НовыйЗаказ.ТипПеревозки.ПараметрыЗаказа.Выгрузить());
	
	_УФС.ЗаполнитьПредопределенныеЗначенияРеквизитовШапки(НовыйЗаказ, НовыйЗаказ.ТипПеревозки, "ДляЗаказа"); 
	
	СтруктураПараметров = CW_Мониторинг.ПолучитьПредопределенныеПараметры(НовыйЗаказ.ТипПеревозки,"ТипПеревозки", Новый УникальныйИдентификатор);
	Если СтруктураПараметров.Код = 0 Тогда
		CW_Мониторинг.ДобавитьПредопределенныеПараметры(НовыйЗаказ, СтруктураПараметров.Параметры);
	КонецЕсли;
	
	СоответствияИменРеквизитов = Перечисления.CW_РеквизитыКоносамента.ПолучитьСоответствияИменРеквизитов();
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	СоответствиеРеквизитовПараметрам.РеквизитКоносамента КАК РеквизитКоносамента,
	|	СоответствиеРеквизитовПараметрам.ИмяРеквизита КАК ИмяРеквизита,
	|	СоответствиеРеквизитовПараметрам.ПараметрОбъекта КАК Параметр
	|ИЗ
	|	Справочник.CW_ТипыКоносаментов.СоответствиеРеквизитовМониторинговымПараметрам КАК СоответствиеРеквизитовПараметрам
	|ГДЕ
	|	СоответствиеРеквизитовПараметрам.Ссылка = &ТипКоносамента
	|	И СоответствиеРеквизитовПараметрам.КопироватьВЗаказы = ИСТИНА";
	
	Запрос.УстановитьПараметр("ТипКоносамента", Объект.ТипКоносамента);
	
	Коносамент = Объект.Ссылка;
	МетаданныеКоносамента = Коносамент.Метаданные();
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		
		ИмяРеквизита = СоответствияИменРеквизитов.Получить(Выборка.РеквизитКоносамента);  
		Если МетаданныеКоносамента.Реквизиты.Найти(ИмяРеквизита) = Неопределено
			и МетаданныеКоносамента.ТабличныеЧасти.ГрузовыеЕдиницы.Реквизиты.Найти(ИмяРеквизита) = Неопределено
			и Выборка.РеквизитКоносамента <> Перечисления.CW_РеквизитыКоносамента.НомерКоносамента Тогда
			Продолжить;
		КонецЕсли;
		
		Если МетаданныеКоносамента.ТабличныеЧасти.ГрузовыеЕдиницы.Реквизиты.Найти(ИмяРеквизита) = Неопределено Тогда
			Выражение = "Коносамент[ИмяРеквизита]";
			Если Не ПустаяСтрока(Выборка.ИмяРеквизита) Тогда
				Выражение = Выражение + "."+СокрЛП(Выборка.ИмяРеквизита);
			КонецЕсли; 
			
			ЗначениеРеквизита = Вычислить(Выражение); 
		КонецЕсли;
		
		НайденаняСтрока = НовыйЗаказ.ПараметрыЗаказа.Найти(Выборка.Параметр, "Параметр");
		Если НайденаняСтрока = Неопределено Тогда
			НоваяСтрока = НовыйЗаказ.ПараметрыЗаказа.Добавить();
			НоваяСтрока.Параметр = Выборка.Параметр;   
		КонецЕсли;
		НоваяСтрока.Значение = ЗначениеРеквизита;
	КонецЦикла;
	
	Запрос = Новый Запрос;  
	Запрос.Текст = "ВЫБРАТЬ
	|	CW_МониторинговыеПараметрыТиповОбъектов.Параметр КАК Параметр
	|ПОМЕСТИТЬ ВТ_ДобавляемыеПараметры
	|ИЗ
	|	Справочник.CW_МониторинговыеПараметрыТиповОбъектов КАК CW_МониторинговыеПараметрыТиповОбъектов
	|ГДЕ
	|	CW_МониторинговыеПараметрыТиповОбъектов.Владелец = &ТипКоносамента
	|	И CW_МониторинговыеПараметрыТиповОбъектов.КопироватьВЗаказы = ИСТИНА
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	CW_МониторинговыеПараметрыОбъектов.Параметр КАК Параметр,
	|	CW_МониторинговыеПараметрыОбъектов.Значение КАК Значение,
	|	CW_МониторинговыеПараметрыОбъектов.ЗначениеПлан КАК ЗначениеПлан,
	|	CW_МониторинговыеПараметрыОбъектов.ЗначениеФакт КАК ЗначениеФакт
	|ИЗ
	|	Справочник.CW_МониторинговыеПараметрыОбъектов КАК CW_МониторинговыеПараметрыОбъектов
	|ГДЕ
	|	CW_МониторинговыеПараметрыОбъектов.Владелец = &Коносамент
	|	И CW_МониторинговыеПараметрыОбъектов.Параметр В
	|			(ВЫБРАТЬ
	|				ВТ_ДобавляемыеПараметры.Параметр КАК Параметр
	|			ИЗ
	|				ВТ_ДобавляемыеПараметры КАК ВТ_ДобавляемыеПараметры)";
	
	Запрос.УстановитьПараметр("Коносамент", 	Коносамент);
	Запрос.УстановитьПараметр("ТипКоносамента", Коносамент.ТипКоносамента);
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() ЦИкл
		НайденаняСтрока = НовыйЗаказ.ПараметрыЗаказа.Найти(Выборка.Параметр, "Параметр");
		Если НайденаняСтрока = Неопределено Тогда
			НоваяСтрока = НовыйЗаказ.ПараметрыЗаказа.Добавить();
			НоваяСтрока.Параметр = Выборка.Параметр;         
		КонецЕсли;
		НоваяСтрока.Значение = Выборка.Значение;
		НоваяСтрока.ЗначениеПлан = Выборка.ЗначениеПлан;
		НоваяСтрока.ЗначениеФакт = Выборка.ЗначениеФакт;
	КонецЦикла;
	
	Попытка
		НовыйЗаказ.Записать();
	Исключение
		Сообщить(ОписаниеОшибки());
		Возврат Неопределено;
	КонецПопытки; 
	
	
	Для Каждого Грузоперевозка из МассивГрузоперевозок Цикл
		ГрузопереовзкаОбъект = Грузоперевозка.ПолучитьОбъект();
		ГрузопереовзкаОбъект.Заказ = НовыйЗаказ.Ссылка;
		ГрузопереовзкаОбъект.Записать();
	КонецЦикла;

    Возврат НовыйЗаказ.Ссылка;

КонецФункции

&НаСервере
Функция ПолучитьСписокЗаказовКоносамента()
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	CW_Грузоперевозки.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.CW_Грузоперевозки КАК CW_Грузоперевозки
	|ГДЕ
	|	CW_Грузоперевозки.Коносамент = &Коносамент
	|	И CW_Грузоперевозки.Заказ = ЗНАЧЕНИЕ(Справочник.CW_Заказы.ПустаяСсылка)"; 
	
	Запрос.УстановитьПараметр("Коносамент", Объект.Ссылка); 
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("Ссылка");
	
КонецФункции

&НаСервере
Функция ЕстьЗаказыКоносамента()
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	|	CW_Заказы.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.CW_Заказы КАК CW_Заказы
	|ГДЕ
	|	CW_Заказы.Коносамент = &Коносамент";  
	
	Запрос.УстановитьПараметр("Коносамент", Объект.Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат НЕ РезультатЗапроса.Пустой();
	
КонецФункции

&НаКлиенте
Процедура ГрузовыеЕдиницыПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НоваяСтрока Тогда
		ТекущиеДанные = Элементы.ГрузовыеЕдиницы.ТекущиеДанные;
		ТекущиеДанные.ИдентификаторСтроки = Новый УникальныйИдентификатор;   
		ТекущиеДанные.Груз = ПолучитьГруз();
		
		Если Копирование Тогда
			ТекущиеДанные.СписокГрузоперевозок.Очистить();
			ТекущиеДанные.СписокГрузоперевозокСтрокой = "";	
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры 

&НаКлиенте
Процедура ГрузовыеЕдиницыПередУдалением(Элемент, Отказ) 
	
	ВыделенныеСтроки = Элементы.ГрузовыеЕдиницы.ВыделенныеСтроки;
	
	Отказ = Истина; 
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ВыделенныеСтроки", ВыделенныеСтроки);
	
	Режим = РежимДиалогаВопрос.ДаНет;
	Оповещение = Новый ОписаниеОповещения("ПродолжитьУдалениеСтрокГрузовыхЕдиниц", ЭтотОбъект, ДополнительныеПараметры);
	ПоказатьВопрос(Оповещение, "Выделенные строки будут удалены. Продолжить?", Режим, 0);	
	
КонецПроцедуры    

&НаКлиенте
Процедура ПродолжитьУдалениеСтрокГрузовыхЕдиниц(Результат, ДополнительныеПараметры) Экспорт
	Если Результат = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;        
	
	ЕстьЗаписи = ЕстьЗаписиРегистраCоответствиеГрузоперевозокСтрокамКоносаментов(ДополнительныеПараметры.ВыделенныеСтроки);
	
	Оповещение = Новый ОписаниеОповещения("ЕщеРазПродолжитьУдалениеСтрокГрузовыхЕдиниц", ЭтотОбъект, ДополнительныеПараметры);
	Если ЕстьЗаписи Тогда
		Режим = РежимДиалогаВопрос.ДаНет;
		ПоказатьВопрос(Оповещение, "С выделенными строками найдены связанные грузоперевозки. Связь грузоперевозок со сторами будет разорвана. Продолжить?", Режим, 0);	
	Иначе
		УдалениеСтрокГрузовыхЕдиницНаСерере(ДополнительныеПараметры.ВыделенныеСтроки)
	КонецЕсли;
	
КонецПроцедуры    

&НаКлиенте
Процедура ЕщеРазПродолжитьУдалениеСтрокГрузовыхЕдиниц(Результат, ДополнительныеПараметры) Экспорт
	Если Результат = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;        
	
	ПродолжитьУдалениеСтрокГрузовыхЕдиницНаСерере(ДополнительныеПараметры.ВыделенныеСтроки);
	
КонецПроцедуры  

&НаСервере
Процедура УдалениеСтрокГрузовыхЕдиницНаСерере(ВыделенныеСтроки)
	
	Для Каждого ИдентификаторСтроки из ВыделенныеСтроки Цикл
		СтрокаТаблицы = Объект.ГрузовыеЕдиницы.НайтиПоИдентификатору(ИдентификаторСтроки);	
		Объект.ГрузовыеЕдиницы.Удалить(СтрокаТаблицы) 
	КонецЦикла;
	
КонецПроцедуры  


&НаСервере
Процедура ПродолжитьУдалениеСтрокГрузовыхЕдиницНаСерере(ВыделенныеСтроки) 
	
	Для Каждого ИдентификаторСтроки из ВыделенныеСтроки Цикл
		СтрокаТаблицы = Объект.ГрузовыеЕдиницы.НайтиПоИдентификатору(ИдентификаторСтроки);	
		
		КлючРегистра = Новый Структура;
		КлючРегистра.Вставить("Коносамент", 			Объект.Ссылка);
		КлючРегистра.Вставить("Грузоперевозка", 		СтрокаТаблицы.Грузоперевозка);
		КлючРегистра.Вставить("ИдентификаторСтроки",	СтрокаТаблицы.ИдентификаторСтроки);
		
		ЗаписьРегистра = РегистрыСведений.CW_ГрузоперевозкиКоносаментов.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(ЗаписьРегистра, КлючРегистра);
		
		Если ЗаписьРегистра.Прочитать() Тогда
			ЗаписьРегистра.Удалить();
		КонецЕсли;
		
		Объект.ГрузовыеЕдиницы.Удалить(СтрокаТаблицы) 
		
	КонецЦикла;
	
КонецПроцедуры  

&НаСервере
Функция ЕстьЗаписиРегистраCоответствиеГрузоперевозокСтрокамКоносаментов(ВыделенныеСтроки) 
	
	МассивСтроки = Новый Массив;
	
	Для Каждого ИдентификаторСтроки из ВыделенныеСтроки Цикл
		СтрокаТаблицы = Объект.ГрузовыеЕдиницы.НайтиПоИдентификатору(ИдентификаторСтроки);	
		МассивСтроки.Добавить(СтрокаТаблицы.ИдентификаторСтроки);
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	|	CW_ГрузоперевозкиКоносаментов.Грузоперевозка КАК Грузоперевозка
	|ИЗ
	|	РегистрСведений.CW_ГрузоперевозкиКоносаментов КАК CW_ГрузоперевозкиКоносаментов
	|ГДЕ
	|	CW_ГрузоперевозкиКоносаментов.ИдентификаторСтроки в (&МассивСтроки)";  
	
	Запрос.УстановитьПараметр("МассивСтроки", МассивСтроки); 
	
	РезультатЗапроса = Запрос.Выполнить();
	
