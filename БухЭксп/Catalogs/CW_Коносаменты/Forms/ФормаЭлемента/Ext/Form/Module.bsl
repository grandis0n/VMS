
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка) 
	
	Если ЗначениеЗаполнено(Объект.Рейс) Тогда
		УстановитьПорты();  
	КонецЕсли;  
	
	Если ТипЗнч(Порты) = Тип("ФиксированныйМассив") Тогда  
		Элементы.ПортОтправки.СписокВыбора.Очистить(); 
		Элементы.ПортОтправки.СписокВыбора.ЗагрузитьЗначения(Новый Массив(Порты));  
		
		Элементы.ПортПерегрузки.СписокВыбора.Очистить(); 
		Элементы.ПортПерегрузки.СписокВыбора.ЗагрузитьЗначения(Новый Массив(Порты));
		
		Элементы.ПортВыгрузки.СписокВыбора.Очистить(); 
		Элементы.ПортВыгрузки.СписокВыбора.ЗагрузитьЗначения(Новый Массив(Порты));
	КонецЕсли;
	
	Если Параметры.Ключ.Пустая() Тогда
		Объект.Дата = ТекущаяДата();	
		Если ЗначениеЗаполнено(Объект.Рейс) Тогда
			Если ТипЗнч(Порты) = Тип("ФиксированныйМассив") Тогда  
				Если ЗначениеЗаполнено(Объект.ПортОтправки) Тогда
					УстановитьТерминал(Объект.ПортОтправки, "ТерминалОтправки");
				КонецЕсли;
				Если ЗначениеЗаполнено(Объект.ПортПерегрузки) Тогда
					УстановитьТерминал(Объект.ПортПерегрузки, "ТерминалПерегрузки");
				КонецЕсли;
				Если ЗначениеЗаполнено(Объект.ПортВыгрузки) Тогда
					УстановитьТерминал(Объект.ПортВыгрузки, "ТерминалВыгрузки");
				КонецЕсли; 
			КонецЕсли;
			
		КонецЕсли;
	КонецЕсли;
	
	CW_МониторинговыеПараметрыСервер.ПриСозданииНаСервере(ЭтаФорма, Отказ, СтандартнаяОбработка);
	
	УстановитьПараметрыФункциональныхОпций();
	
	//Наличие прикрепленных файлов
	_УФКС.УстановитьНаличиеПрикрепленныхФайловПриСозданииФормыНаСервере(ЭтаФорма);
	//Наличие прикрепленных файлов
	
	УстановитьОтборДинамическихСписков();
	
	//Внешние подклчюаемые команды
	CW_ПодключаемыеКомандыСервер.ПриСозданииНаСервере(ЭтотОбъект);
	
КонецПроцедуры

