&НаКлиенте
Процедура УстановитьСписокПотры(Элемент, СтандартнаяОбработка)
	
	Элемент.СписокВыбора.Очистить(); 
	
	Если ТипЗнч(Порты) <> Тип("ФиксированныйМассив") Тогда  
		СтандартнаяОбработка = ложь;
		Возврат;
	КонецЕсли;
	
	МассивПорты = Новый Массив(Порты);    
	Элемент.СписокВыбора.ЗагрузитьЗначения(МассивПорты);
	
КонецПроцедуры    

&НаСервере
Процедура УстановитьПорты()
	
	Если Не ЗначениеЗаполнено(Объект.Рейс) Тогда
		Возврат;
	КонецЕсли; 
	
	СоответствиеПортыТерминалы = Новый Соответствие;
	МассивПорты = Новый Массив;
	
	Запрос = новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	CW_РейсыЗаходы.Порт КАК Порт,
	|	CW_РейсыЗаходы.Терминал КАК Терминал
	|ИЗ
	|	Справочник.CW_Рейсы.Заходы КАК CW_РейсыЗаходы
	|ГДЕ
	|	CW_РейсыЗаходы.Ссылка = &Рейс"; 
	
	Запрос.УстановитьПараметр("Рейс", Объект.Рейс);
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		СоответствиеПортыТерминалы.Вставить(Выборка.Порт, Выборка.Терминал);   
		
		Если МассивПорты.Найти(Выборка.Порт) = Неопределено Тогда
			МассивПорты.Добавить(Выборка.Порт);                 
		КонецЕсли;
	КонецЦикла;
	
	Порты = Новый ФиксированныйМассив(МассивПорты);
	ПортыТерминалы = Новый ФиксированноеСоответствие(СоответствиеПортыТерминалы);
	
КонецПроцедуры


