&НаКлиенте
Процедура СвязатьСГрузоперевозкой(Команда)  
	
	МассивГрузоперевозок = ПолучитьСписокГрузоперевозокКоносамента();
	
	Отбор = Новый Структура;
	Отбор.Вставить("Ссылка", МассивГрузоперевозок);
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("Отбор", Отбор);
	СтруктураПараметров.Вставить("ЗакрыватьПриВыборе", ложь);
	СтруктураПараметров.Вставить("МножественныйВыбор", Истина);
	
	ОткрытьФорму("Справочник.CW_Грузоперевозки.ФормаВыбора", СтруктураПараметров, Элементы.ГрузовыеЕдиницы,,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры    

&НаСервере
Функция ПолучитьСписокГрузоперевозокКоносамента() 
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	CW_ГрузоперевозкиКоносаментов.Грузоперевозка КАК Грузоперевозка
	|ПОМЕСТИТЬ ВТ_ПривязанныеГрузоперевозки
	|ИЗ
	|	РегистрСведений.CW_ГрузоперевозкиКоносаментов КАК CW_ГрузоперевозкиКоносаментов
	|ГДЕ
	|	CW_ГрузоперевозкиКоносаментов.Коносамент = &Коносамент
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	CW_Грузоперевозки.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.CW_Грузоперевозки КАК CW_Грузоперевозки
	|ГДЕ
	|	CW_Грузоперевозки.Коносамент = &Коносамент
	|	И НЕ CW_Грузоперевозки.Ссылка В
	|				(ВЫБРАТЬ
	|					ВТ_ПривязанныеГрузоперевозки.Грузоперевозка КАК Грузоперевозка
	|				ИЗ
	|					ВТ_ПривязанныеГрузоперевозки КАК ВТ_ПривязанныеГрузоперевозки)"; 
	
	Запрос.УстановитьПараметр("Коносамент", Объект.Ссылка); 
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("Ссылка");
	
КонецФункции

&НаКлиенте
Процедура ГрузовыеЕдиницыОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;   
	ТекущаяСтрока= Элементы.ГрузовыеЕдиницы.ТекущаяСтрока;
	ГрузовыеЕдиницыОбработкаВыбораНаСервере(ВыбранноеЗначение, ТекущаяСтрока);
	
	Элементы.Грузоперевозки.Обновить();
	
КонецПроцедуры

&НаСервере
Процедура ГрузовыеЕдиницыОбработкаВыбораНаСервере(ВыбранноеЗначение, ТекущаяСтрока)
	
	СтрокаТекущая = Объект.ГрузовыеЕдиницы.НайтиПоИдентификатору(ТекущаяСтрока);
	
	Для Каждого Грузоперевозка из ВыбранноеЗначение Цикл
		ЗаписьРегистра = РегистрыСведений.CW_ГрузоперевозкиКоносаментов.СоздатьМенеджерЗаписи();
		ЗаписьРегистра.Грузоперевозка = Грузоперевозка;
		ЗаписьРегистра.Коносамент = Объект.Ссылка;
		ЗаписьРегистра.ИдентификаторСтроки = СтрокаТекущая.ИдентификаторСтроки;
		ЗаписьРегистра.Записать();
	КонецЦикла;  
	
	ЗаполнитьСписокГрузопереозвокПоСтроке(СтрокаТекущая); 
	
КонецПроцедуры

&НаКлиенте
Процедура ОтвязатьОтСтроки(Команда)
	
	ТекущаяСтрока = Элементы.ГрузовыеЕдиницы.ТекущаяСтрока; 
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СписокГрузоперевозок = ПолучитьСписокГрузоперевозок(ТекущаяСтрока);
	Если СписокГрузоперевозок.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ТекущаяСтрока", ТекущаяСтрока);
	
	Оповещение = Новый ОписаниеОповещения("ПослеОтметкиГрузоперевозок", ЭтотОбъект, ДополнительныеПараметры);
	СписокГрузоперевозок.ПоказатьОтметкуЭлементов(Оповещение, "Выбор грузоперевозок");
	
КонецПроцедуры  

&НаКлиенте
Процедура ПослеОтметкиГрузоперевозок(СписокГрузоперевозок, ДополнительныеПараметры) Экспорт    
	
	Если СписокГрузоперевозок = Неопределено Тогда
		Возврат;
	КонецЕсли; 
	
	ОтвязатьОтСтрокиНаСервере(СписокГрузоперевозок, ДополнительныеПараметры.ТекущаяСтрока);
	
КонецПроцедуры   


&НаСервере
Процедура ОтвязатьОтСтрокиНаСервере(СписокГрузоперевозок, ТекущаяСтрока)    
	
	СтрокаТекущая = Объект.ГрузовыеЕдиницы.НайтиПоИдентификатору(ТекущаяСтрока); 
	
	Для Каждого ЭлементСписка из СписокГрузоперевозок Цикл
		Если Не ЭлементСписка.Пометка Тогда
			Продолжить;
		КонецЕсли;
		
		ЗаписьРегистра = РегистрыСведений.CW_ГрузоперевозкиКоносаментов.СоздатьМенеджерЗаписи();
		ЗаписьРегистра.Грузоперевозка = ЭлементСписка.Значение;
		ЗаписьРегистра.Коносамент = Объект.Ссылка;
		ЗаписьРегистра.ИдентификаторСтроки = СтрокаТекущая.ИдентификаторСтроки;
		
		ЗаписьРегистра.Прочитать();
		
		Если ЗаписьРегистра.Выбран() Тогда
			ЗаписьРегистра.Удалить();
		КонецЕсли;
		
	КонецЦикла;
	
	ЗаполнитьСписокГрузопереозвокПоСтроке(СтрокаТекущая); 
	
КонецПроцедуры

