&НаСервере
Процедура ПересчитатьПоказателиНаСервере()
	
	Если Объект.Заходы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ДлительностьСтоянок_Минуты	= 0;
	ДлительностьРейса_Минуты	= 0;
	ДлительностьХода_Минуты		= 0;
	
	Запрос = Новый Запрос;   
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.Текст  = "ВЫБРАТЬ
	|	Заходы.ДатаЗахода КАК ДатаЗахода,
	|	Заходы.ДатаВыхода КАК ДатаВыхода,
	|	РАЗНОСТЬДАТ(Заходы.ДатаЗахода, Заходы.ДатаВыхода, МИНУТА) КАК ДлительностьСтоянки
	|ПОМЕСТИТЬ ВТ_Заходы
	|ИЗ
	|	&Заходы КАК Заходы";
	
	Запрос.УстановитьПараметр("Заходы", Объект.Заходы.Выгрузить());  
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Запрос.Текст ="ВЫБРАТЬ
	|	МИНИМУМ(ВТ_Заходы.ДатаЗахода) КАК ДатаЗахода,
	|	МАКСИМУМ(ВТ_Заходы.ДатаВыхода) КАК ДатаВыхода,
	|	СУММА(ВТ_Заходы.ДлительностьСтоянки) КАК ДлительностьСтоянки
	|ПОМЕСТИТЬ ВТ_Рейс
	|ИЗ
	|	ВТ_Заходы КАК ВТ_Заходы
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Рейс.ДатаЗахода КАК ДатаЗахода,
	|	ВТ_Рейс.ДатаВыхода КАК ДатаВыхода,
	|	ВТ_Рейс.ДлительностьСтоянки КАК ДлительностьСтоянки,
	|	РАЗНОСТЬДАТ(ВТ_Рейс.ДатаЗахода, ВТ_Рейс.ДатаВыхода, МИНУТА) КАК ДлительностьРейсаСуммарно
	|ИЗ
	|	ВТ_Рейс КАК ВТ_Рейс";
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Если Выборка.Следующий() Тогда
		ДатаНачала 					= Выборка.ДатаЗахода;	
		ДатаОкончания 				= Выборка.ДатаВыхода;
		ДлительностьСтоянок_Минуты 	= Выборка.ДлительностьСтоянки;
		ДлительностьРейса_Минуты 	= Выборка.ДлительностьРейсаСуммарно;
		ДлительностьХода_Минуты 	= Макс(Выборка.ДлительностьРейсаСуммарно - Выборка.ДлительностьСтоянки, 0);
	КонецЕсли;
	
	ДлительностьРейса_Судосутки_Представление 	= Формат(ДлительностьРейса_Минуты/(60*24),"ЧДЦ=1; ЧГ=");
	ДлительностьРейса_Представление 			= ПредставлениеДлительностиНаСервере(ДлительностьРейса_Минуты);
	ДлительностьХода_Представление 				= ПредставлениеДлительностиНаСервере(ДлительностьХода_Минуты);
  	ДлительностьСтоянок_Представление 			= ПредставлениеДлительностиНаСервере(ДлительностьСтоянок_Минуты);

КонецПроцедуры
 
&НаСервере
Функция ПредставлениеДлительностиНаСервере(Длительность)
	
	Если Длительность = 0 Тогда
		Возврат "-"; 
	КонецЕсли;
	
	КоличествоЧасов = Цел(Длительность/60);
	КоличествоМинут = Длительность - КоличествоЧасов*60;   
	
	ШаблонВремя = "%1:%2";
	
	Возврат СтрШаблон(ШаблонВремя, 
				Формат(КоличествоЧасов,"ЧЦ=2; ЧДЦ=0; ЧН=00; ЧВН=; ЧГ="), 
				Формат(КоличествоМинут,"ЧЦ=2; ЧДЦ=0; ЧН=00; ЧВН=; ЧГ="));
	
КонецФункции

&НаКлиенте
Процедура КоносаментыПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр) 
	
	Отказ = Истина;
	
	ЗначенияЗаполнения = ПолучитьЗначенияЗаполнения();
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("ЗначенияЗаполнения", ЗначенияЗаполнения);
	
	ОткрытьФорму("Справочник.CW_Коносаменты.ФормаОбъекта", СтруктураПараметров, ЭтаФорма);
	
КонецПроцедуры

&НаСервере
Функция ПолучитьЗначенияЗаполнения()
	
	ЗначенияЗаполнения = Новый Структура;
	ЗначенияЗаполнения.Вставить("ТипКоносамента", 		Объект.ТипКоносамента);
	ЗначенияЗаполнения.Вставить("Линия", 				Объект.Линия);
	ЗначенияЗаполнения.Вставить("Рейс", 				Объект.Ссылка);
	ЗначенияЗаполнения.Вставить("Судно", 				Объект.Судно); 
	ЗначенияЗаполнения.Вставить("ТипПеревозки", 		Объект.ТипПеревозки); 
	ЗначенияЗаполнения.Вставить("Организация", 			Объект.Организация); 
	ЗначенияЗаполнения.Вставить("ДоставкаНаименование",	Объект.НаименованиеОрганизации); 
	ЗначенияЗаполнения.Вставить("ДоставкаАдрес", 		Объект.АдресОрганизации); 
	
	Если Объект.Заходы.Количество() > 0 Тогда
		ПерваяСтрока 	= Объект.Заходы[0];
		ПоследняяСтрока = Объект.Заходы[Объект.Заходы.Количество()-1];
		
		ЗначенияЗаполнения.Вставить("ПортОтправки",		ПерваяСтрока.Порт);
		ЗначенияЗаполнения.Вставить("ТерминалОтправки",	ПерваяСтрока.Терминал);
		ЗначенияЗаполнения.Вставить("ПортВыгрузки",		ПоследняяСтрока.Порт);
		ЗначенияЗаполнения.Вставить("ТерминалВыгрузки",	ПоследняяСтрока.Терминал); 
	КонецЕсли;

	Возврат ЗначенияЗаполнения;

КонецФункции

&НаСервере
Процедура ЗаходыПортПриИзмененииНаСервере(ТекущаяСтрока) 

	СтрокаТекущая = Объект.Заходы.НайтиПоИдентификатору(ТекущаяСтрока);
	
	ЕстьДубли = ложь;
	Для каждого СтрокаЗахода из Объект.Заходы Цикл
		Если СтрокаЗахода = СтрокаТекущая Тогда
			Продолжить;
		КонецЕсли;
		
		Если СтрокаЗахода.Порт = СтрокаТекущая.Порт Тогда
			ЕстьДубли = Истина;
			Прервать;
		КонецЕсли;
		
	КонецЦикла;  
	
	Если ЕстьДубли Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
		"Порт уже указан в маршруте",,
		"Заходы["+Формат(Объект.Заходы.Индекс(СтрокаТекущая),"ЧГ=0")+"].Порт",
		"Объект", );
	КонецЕсли;
	
КонецПроцедуры

