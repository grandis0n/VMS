&НаКлиенте
Функция НайтиПозициюВДереве(ЭлементыДерева) Экспорт
	
	Для Каждого СтрокаДерева Из ЭлементыДерева Цикл
		Если СтрокаДерева.Параметр = ПараметрТекущиейСтрокиДерева Тогда
			Возврат СтрокаДерева.ПолучитьИдентификатор();
			Прервать;
		КонецЕсли;
		ИдентификаторСтрокиДерева =  НайтиПозициюВДереве(СтрокаДерева.ПолучитьЭлементы());
		Если ИдентификаторСтрокиДерева <> Неопределено Тогда
			Возврат ИдентификаторСтрокиДерева;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции



#Область ФормированиеДерева 

&НаКлиенте
Процедура ДПГ_Обновить(Команда)
	
	ОбновитьДеревоПараметров();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьДеревоПараметров(СП=Неопределено)
	
	ТекущиеДанные =  Элементы.ДПГ.ТекущиеДанные;
	Если  ТекущиеДанные <> Неопределено Тогда
		ПараметрТекущиейСтрокиДерева = Элементы.ДПГ.ТекущиеДанные.Параметр;
	КонецЕсли;
	
	_ОбновитьДеревоПараметров(СП);
	ПересчитатьДинамическиеПараметры();
	ДПГ_ВосстановитьСостояниеСвертки();
	
	Если ЗначениеЗаполнено(ПараметрТекущиейСтрокиДерева) Тогда
		ВосстановитьТекущуюПозициюКурсора();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура _ОбновитьДеревоПараметров(СП=Неопределено)
	// --- 
	
	Если (Объект.ГруппыПараметровЗаявки.Количество()=0) Тогда
		Корень = Объект.ГруппыПараметровЗаявки.Добавить();
		Корень.ИдентификаторыВедомых = ЗначениеВСтрокуВнутр(Новый Массив);
	Иначе
		Корень = Объект.ГруппыПараметровЗаявки[0];	
	КонецЕсли; 
	Если (НЕ Корень.Раскрывать) Тогда
		Корень.Раскрывать = Истина;
	КонецЕсли; 
	Если (Корень.ИдентификаторыВедомых="") Тогда
		Корень.ИдентификаторыВедомых = ЗначениеВСтрокуВнутр(Новый Массив);
	КонецЕсли; 
	// ---------------------------------------------------------------------------- 
	
	// получаем текущие группы 		
	Элементы.ДПГ.НачальноеОтображениеДерева=НачальноеОтображениеДерева.НеРаскрывать;
	ДПГ.ПолучитьЭлементы().Очистить();
	// --- 
	СПВ = Новый Структура("КартаПрав,КартаСвойств,ТаблицаКонтроляГрупп,ТаблицаКонтроляПараметров");
	СПВ.КартаПрав = ПолучитьИзВременногоХранилища(АдресКартыПравПараметров);
	СПВ.КартаСвойств = ПолучитьИзВременногоХранилища(АдресКартыСвойствПараметров);
	СПВ.ТаблицаКонтроляГрупп = _ТаблицаКонтроляГрупп();
	СПВ.ТаблицаКонтроляПараметров = _ТаблицаКонтроляПараметров(СПВ.КартаПрав);
	// --- 
	УдалятьПустыеГруппы = Ложь;
	Если (СП <> Неопределено) Тогда
		СП.Свойство("УдалятьПустыеГруппы",УдалятьПустыеГруппы);
	КонецЕсли; 
	СПВ.Вставить("УдалятьПустыеГруппы",УдалятьПустыеГруппы);
	// --- 
	_СформироватьЭлементыДерева(Корень,Неопределено,СПВ);
	
	// проверим, всё ли выведено
	#Область КонтрольНесформированных 
	// после формирования проверяем, нет ли потерянных групп, 
	// если есть, то засовываем их в корень и переформировываем дерево
	// сообщаем о потерянных группах
	МассивНеучтенныхГрупп = _сф.к_НайтиСтроки(СПВ.ТаблицаКонтроляГрупп,Новый Структура("Видимость",Ложь));
	Если (МассивНеучтенныхГрупп.Количество() <> 0) Тогда
		
		// переносим каждую в корень
		Для каждого КонтрольнаяСтрокаГруппы Из МассивНеучтенныхГрупп Цикл
			
			_ДобавитьЭлементГруппы(КонтрольнаяСтрокаГруппы.Идентификатор, Корень);
			
		КонецЦикла; 
		// --- 
		// переформировываем дерево
		_ОбновитьДеревоПараметров();
		
	КонецЕсли; 
	
	// далее проверяем, нет ли потерянных/новых параметров, если есть
	// то добавляем их в корень и снова переформировываем дерево
	МассивНеучтенныхПараметров = _сф.к_НайтиСтроки(СПВ.ТаблицаКонтроляПараметров,Новый Структура("Видимость",Ложь));
	Если (МассивНеучтенныхПараметров.Количество() <> 0) Тогда
		
		// переносим каждую в корень
		Для каждого КонтрольнаяСтрокаПараметра Из МассивНеучтенныхПараметров Цикл
			
			_ДобавитьЭлементГруппы(КонтрольнаяСтрокаПараметра.Параметр, Корень);
			
		КонецЦикла; 
		// переформировываем дерево
		_ОбновитьДеревоПараметров();
		
	КонецЕсли; 
	#КонецОбласти 
	
	// --- 
КонецПроцедуры

&НаСервере
Функция _ТаблицаКонтроляГрупп()
	// --- 
	
	ТаблицаКонтроляГрупп = Объект.ГруппыПараметровЗаявки.Выгрузить();
	ТаблицаКонтроляГрупп.Колонки.Добавить("Видимость");
	ТаблицаКонтроляГрупп.ЗаполнитьЗначения(Ложь,"Видимость");
	СтрокаКорня = _сф.к_ПервыйЭлемент(ТаблицаКонтроляГрупп);
	СтрокаКорня.Видимость = Истина;
	// --- 
	Возврат(ТаблицаКонтроляГрупп);
	
	// --- 
КонецФункции

&НаСервере
Функция _ТаблицаКонтроляПараметров(НаборПрав)
	// --- 
	
	ТаблицаКонтроляПараметров = Объект.ПараметрыЗаявки.Выгрузить();
	// --- 
	ТаблицаКонтроляПараметров.Колонки.Добавить("Видимость");
	ТаблицаКонтроляПараметров.ЗаполнитьЗначения(Ложь,"Видимость");
	// --- 
	МассивУдаляемыхСтрок = Новый Массив;
	Для каждого СтрокаКонтроля Из ТаблицаКонтроляПараметров Цикл
		
		СтруктураПрав = НаборПрав["п_"+_сф.КлючПоСсылке(СтрокаКонтроля.Параметр)];
		Если (НЕ СтруктураПрав.Просмотр) Тогда
			
			МассивУдаляемыхСтрок.Добавить(СтрокаКонтроля);
			
		КонецЕсли;
		
	КонецЦикла; 
	_сф.к_УдалитьЭлементыПоМассиву(ТаблицаКонтроляПараметров, МассивУдаляемыхСтрок);
	// --- 
	Возврат(ТаблицаКонтроляПараметров);
	
	// --- 
КонецФункции

&НаСервере
Функция _СформироватьЭлементыДерева(Группа,СтрокаДерева = Неопределено, СПВ)
	
	// СПВ - структура параметров вызова
	// --- 
	// .КартаПрав
	// .КартаСвойств
	// .ТаблицаКонтроляГрупп = Неопределено
	// .ТаблицаКонтроляПараметров = Неопределено
	
	// ---------------------------------------------------------------------------- 
	
	Если (СтрокаДерева <> Неопределено) Тогда
		КоллекцияЭлементовДерева = СтрокаДерева.ПолучитьЭлементы();
	Иначе
		КоллекцияЭлементовДерева = ДПГ.ПолучитьЭлементы();		
	КонецЕсли; 
	КоллекцияЭлементовДерева.Очистить();
	// --- 
	
	МассивПодчиненныхЭлементов = ЗначениеИзСтрокиВнутр(Группа.ИдентификаторыВедомых);
	МассивИдентификаторовДляУдаления = Новый Массив;
	Для каждого ПодчиненныйЭлемент Из МассивПодчиненныхЭлементов Цикл
		
		Если ТипЗнч(ПодчиненныйЭлемент) = Тип("ПланВидовХарактеристикСсылка.CW_ПараметрыГрузоперевозок") Тогда  
			ПодчиненныйЭлементОбъект = ПодчиненныйЭлемент.ПолучитьОбъект();
			Если ПодчиненныйЭлементОбъект = Неопределено Тогда
				Продолжить;
			КонецЕсли;                                                                                            
		Конецесли;

		ЭтоГруппа = (ТипЗнч(ПодчиненныйЭлемент)=Тип("Число"));
		// --- 	
		Если (ЭтоГруппа) Тогда
			
			ОтборПоИдентификаторуГруппы = Новый Структура("Идентификатор",ПодчиненныйЭлемент);
			СтрокаГруппы = _сф.к_НайтиСтроку(Объект.ГруппыПараметровЗаявки,ОтборПоИдентификаторуГруппы);
			// проверяем, что еще не выведена и записываем признак формирования
			Если (СПВ.ТаблицаКонтроляГрупп <> Неопределено) Тогда
				
				КонтрольнаяСтрокаГруппы = _сф.к_НайтиСтроку(СПВ.ТаблицаКонтроляГрупп, ОтборПоИдентификаторуГруппы);
				Если (КонтрольнаяСтрокаГруппы.Видимость) Тогда
					
					// ахтунг, зацикливание
					МассивИдентификаторовДляУдаления.Добавить(ПодчиненныйЭлемент);
					Продолжить;
					
				Иначе
					
					КонтрольнаяСтрокаГруппы.Видимость = Истина;
					
				КонецЕсли; 
				
			КонецЕсли; 
			// --- 
			Нстр = КоллекцияЭлементовДерева.Добавить();
			_ЗаполнитьСтрокуДереваПоГруппе(Нстр, СтрокаГруппы);
			// --- 
			УстановитьСостояниеСверткиСтроки(Нстр.ПолучитьИдентификатор(), Нстр.ИдентификаторГруппы, СтрокаГруппы.Раскрывать);
			_СформироватьЭлементыДерева(СтрокаГруппы, Нстр, СПВ);
			// ---------------------------------------------------------------------------- 
			// устанавливаем признак разрешения удаления для группы
			УдалениеРазрешено = Истина;
			// --- 
			КоллекцияПодчиненных = Нстр.ПолучитьЭлементы();
			КоличествоСформированныхПодчиненных = КоллекцияПодчиненных.Количество();
			КоличествоПодчиненных = ЗначениеИзСтрокиВнутр(СтрокаГруппы.ИдентификаторыВедомых).Количество();
			Если (КоличествоСформированныхПодчиненных <> КоличествоПодчиненных) Тогда
				
				УдалениеРазрешено = Ложь;
				
			Иначе
				
				Для каждого ПодчиненнаяСтрока Из КоллекцияПодчиненных Цикл
					
					Если (НЕ ПодчиненнаяСтрока.УдалениеРазрешено) Тогда
						УдалениеРазрешено = Ложь;
						Прервать;
					КонецЕсли; 
					
				КонецЦикла; 
				
			КонецЕсли; 
			Нстр.УдалениеРазрешено = УдалениеРазрешено;
			// ---
			Нстр.КоличествоПараметров = 0;
			Для каждого ПодчиненнаяСтрока Из КоллекцияПодчиненных Цикл
				
				_сф.Инкремент(Нстр.КоличествоПараметров,ПодчиненнаяСтрока.КоличествоПараметров);
				
			КонецЦикла;
			Если (ПоказыватьКоличествоПараметров) Тогда
				 
				Нстр.Параметр_Представление = Нстр.НаименованиеГруппы + " ("+Формат(Нстр.КоличествоПараметров,"ЧН=; ЧГ=")+")";
				
			КонецЕсли; 
			
		КонецЕсли; 
		// --- 
		Если (НЕ ЭтоГруппа) Тогда
			
			Параметр = ПодчиненныйЭлемент;
			// ---------------------------------------------------------------------------- 
			
			// проверим права
			СтруктураПрав = СПВ.КартаПрав["п_"+_сф.КлючПоСсылке(Параметр)];
			Если (НЕ СтруктураПрав.Просмотр) Тогда
				
				Продолжить;
				
			КонецЕсли;
			// --- 
			// найдем свойства
			СП = СПВ.КартаСвойств.Получить(ПодчиненныйЭлемент);
			// --- 
			// контроль формирования
			Если (СПВ.ТаблицаКонтроляПараметров <> Неопределено) Тогда
				
				ОтборПоПараметру = Новый Структура("Параметр",ПодчиненныйЭлемент);
				КонтрольнаяСтрокаПараметра = _сф.к_НайтиСтроку(СПВ.ТаблицаКонтроляПараметров, ОтборПоПараметру);
				Если (КонтрольнаяСтрокаПараметра = Неопределено) Тогда
					
					//Сообщить("Параметр """+Строка(ПодчиненныйЭлемент)+""" не найден в контрольной таблице.");
					
				Иначе
					
					Если (КонтрольнаяСтрокаПараметра.Видимость) Тогда
						
						// ахтунг, параметр уже в какой-то группе, удаляем из текущей
						МассивИдентификаторовДляУдаления.Добавить(ПодчиненныйЭлемент);
						Продолжить;
						
					Иначе
						
						КонтрольнаяСтрокаПараметра.Видимость = Истина;
						
					КонецЕсли; 
					
				КонецЕсли; 
				
			КонецЕсли; 
			// --- 
			СтрокаПараметра = _сф.к_НайтиСтроку(Объект.ПараметрыЗаявки,Новый Структура("Параметр",Параметр));
			Если (СтрокаПараметра = Неопределено) Тогда
				
				// параметр был удален
				МассивИдентификаторовДляУдаления.Добавить(ПодчиненныйЭлемент);
				Продолжить;
				
			КонецЕсли; 
			Нстр = КоллекцияЭлементовДерева.Добавить();
			_ЗаполнитьСтрокуДереваПоПараметру(Нстр, СтрокаПараметра, СП, СтруктураПрав);
			
			// записываем добавленную строку в карту параметров дерева
			ЭлементКартыПараметров = КартаПараметровДерева.НайтиПоЗначению(Параметр);
			Если (ЭлементКартыПараметров = Неопределено) Тогда
				ЭлементКартыПараметров = КартаПараметровДерева.Добавить(Параметр);
			КонецЕсли; 
			ЭлементКартыПараметров.Представление = Формат(Нстр.ПолучитьИдентификатор(),"ЧЦ=10; ЧДЦ=; ЧН=; ЧГ=");
			
		КонецЕсли; 
		
		
	КонецЦикла; 
	// --- 
	// удаление пустых групп
	Если (СПВ.Свойство("УдалятьПустыеГруппы")) Тогда
		
		Если (СПВ.УдалятьПустыеГруппы) Тогда
			
			МассивУдаляемыхСтрокДерева = Новый Массив;
			// --- 
			Для каждого ПодчиненнаяСтрока Из КоллекцияЭлементовДерева Цикл
				
				Если (ПодчиненнаяСтрока.ЭтоГруппа И ПодчиненнаяСтрока.КоличествоПараметров = 0) Тогда
					
					// удаляем группу
					Идентификатор = ПодчиненнаяСтрока.ИдентификаторГруппы;
					СтрокаГруппы = _сф.к_НайтиСтроку(Объект.ГруппыПараметровЗаявки,Новый Структура("Идентификатор",Идентификатор));
					Если (СтрокаГруппы <> Неопределено) Тогда
						
						Если (СтрокаГруппы.Идентификатор <> 0) Тогда
							
							МассивИдентификаторовДляУдаления.Добавить(Идентификатор);
							МассивУдаляемыхСтрокДерева.Добавить(ПодчиненнаяСтрока);
							Объект.ГруппыПараметровЗаявки.Удалить(Объект.ГруппыПараметровЗаявки.Индекс(СтрокаГруппы));
							
						КонецЕсли; 
						
					КонецЕсли; 
					
				КонецЕсли; 
				
			КонецЦикла; 
			// --- 
			Если (МассивУдаляемыхСтрокДерева.Количество() <> 0) Тогда
				
				Для каждого УдаляемаяСтрока Из МассивУдаляемыхСтрокДерева Цикл
					
					КоллекцияЭлементовДерева.Удалить(КоллекцияЭлементовДерева.Индекс(УдаляемаяСтрока));
					
				КонецЦикла; 
				
			КонецЕсли; 
			
		КонецЕсли;
		
	КонецЕсли; 
	 
	// --- 
	// удаляем некорректные элементы
	Если (МассивИдентификаторовДляУдаления.Количество() <> 0) Тогда
		
		Для каждого ИдентификаторДляУдаления Из МассивИдентификаторовДляУдаления Цикл
			
			МассивПодчиненныхЭлементов.Удалить(МассивПодчиненныхЭлементов.Найти(ИдентификаторДляУдаления));
			
		КонецЦикла; 
		Группа.ИдентификаторыВедомых = ЗначениеВСтрокуВнутр(МассивПодчиненныхЭлементов);
		
	КонецЕсли; 
	
	// --- 
КонецФункции

&НаСервере
Процедура _ЗаполнитьСтрокуДереваПоПараметру(СтрокаДерева,СтрокаПараметра,СвойстваПараметра=Неопределено,СтруктураПрав=Неопределено)
	// --- 
	
	Если (СтрокаПараметра = Неопределено) Тогда
		Возврат;
	КонецЕсли; 
	// ---------------------------------------------------------------------------- 
	
	Параметр = СтрокаПараметра.Параметр;
	ТДата = ТекущаяДата();
	// ---------------------------------------------------------------------------- 
	Если (СвойстваПараметра = Неопределено) Тогда
		СвойстваПараметров = ПолучитьИзВременногоХранилища(АдресКартыСвойствПараметров);
		СвойстваПараметра = СвойстваПараметров.Получить(Параметр);
		Если (СвойстваПараметра = Неопределено) Тогда
			КартаСвойств = ПолучитьИзВременногоХранилища(АдресКартыСвойствПараметров);
			СвойстваПараметра = КартаСвойств.Получить(Параметр);
		КонецЕсли; 
	КонецЕсли; 
	Если (СтруктураПрав = Неопределено) Тогда
		
		КартаПрав = ПолучитьИзВременногоХранилища(АдресКартыПравПараметров);
		СтруктураПрав = КартаПрав["п_"+_сф.КлючПоСсылке(Параметр)];
		
	КонецЕсли; 
	// ---------------------------------------------------------------------------- 
	
	// основное
	СтрокаДерева.Параметр = Параметр;	
	СтрокаДерева.Параметр_Представление = СвойстваПараметра.Наименование;	
	СтрокаДерева.Значение = СтрокаПараметра.Значение;
	СтрокаДерева.КоличествоПараметров = 1;
	СтрокаДерева.Примечание = СтрокаПараметра.Примечание;
	
	//Новый механизм
	СтрокаДерева.ИдентификаторВладельца = СтрокаПараметра.ИдентификаторВладельца;
	//Новый механизм
	
	// ---------------------------------------------------------------------------- 
	// индекс картинки
	Если (СвойстваПараметра.ЭтоКонтрольнаяДата) Тогда
		СтрокаДерева.ИндексКартинки = 2;				
	ИначеЕсли (СвойстваПараметра.ДинамическийПараметр) Тогда 
		СтрокаДерева.ИндексКартинки = 3;
	Иначе
		СтрокаДерева.ИндексКартинки = 1;
	КонецЕсли; 
	
	// ---------------------------------------------------------------------------- 
	// формат вывода
	ТипЗначенияПараметра = СвойстваПараметра.ТипЗначения;
	ТипПараметра = СвойстваПараметра.ТипЗначения.Типы()[0];
	Если (СвойстваПараметра.ЭтоКонтрольнаяДата) Тогда
		
		Если СвойстваПараметра.ФорматВывода <> "" Тогда
			СтрокаДерева.Значение_Представление = Формат(СтрокаДерева.Значение,СвойстваПараметра.ФорматВывода);
		Иначе
			
			Если (НЕ СвойстваПараметра.КонтрольнаяДатаИспользуетВремя) Тогда
				СтрокаДерева.Значение_Представление = Формат(СтрокаДерева.Значение,"ДФ=dd.MM.yyyy");
			Иначе
				СтрокаДерева.Значение_Представление = Формат(СтрокаДерева.Значение,"ДФ='dd.MM.yyyy HH:mm'");
			КонецЕсли; 
			
		КонецЕсли; 
		
	Иначе
		
		Если (ТипПараметра = Тип("Булево") ИЛИ ТипПараметра = Тип("Дата") ИЛИ ТипПараметра=Тип("Число")) Тогда
			
			Если (СвойстваПараметра.ФорматВывода <> "") Тогда
				
				СтрокаДерева.Значение_Представление = Формат(СтрокаДерева.Значение,СвойстваПараметра.ФорматВывода);
				
			Иначе
				
				СтрокаДерева.Значение_Представление = Формат(СтрокаДерева.Значение);
				
				Если ТипПараметра = Тип("Дата") Тогда
					
					ФорматВывода = "";
					ЧастьДаты = ТипЗначенияПараметра.КвалификаторыДаты.ЧастиДаты;
					Если ЧастьДаты = ЧастиДаты.Дата Тогда
						
						// формат дат по умолчанию
						ФорматВывода = "ДФ=dd.MM.yyyy";
						
					ИначеЕсли ЧастьДаты = ЧастиДаты.Время Тогда 
						
						// формат дат по умолчанию
						ФорматВывода = "ДФ=HH:mm:ss";
						
					ИначеЕсли ЧастьДаты = ЧастиДаты.ДатаВремя Тогда 
						
						// формат дат по умолчанию
						ФорматВывода = "ДЛФ=";
						
					КонецЕсли;
					
					СтрокаДерева.Значение_Представление = Формат(СтрокаДерева.Значение,ФорматВывода);
					
				КонецЕсли; 
				
			КонецЕсли;
			
		Иначе
			
			СтрокаДерева.Значение_Представление = Строка(СтрокаДерева.Значение);
			
		КонецЕсли; 					
		
	КонецЕсли; 
	
	// ---------------------------------------------------------------------------- 
	// статус план/факт
	Если (СвойстваПараметра.ЭтоКонтрольнаяДата) Тогда
		
		Если (СтрокаПараметра.ЗначениеФакт <> Дата(1,1,1)) Тогда
			
			СтрокаДерева.ПланФакт=Истина;
			СтрокаДерева.ПланПросрочен=Ложь;
			
		Иначе
			
			СтрокаДерева.ПланФакт=Ложь;
			Если (СтрокаПараметра.ЗначениеПлан <> Дата(1,1,1)) И (СтрокаПараметра.ЗначениеПлан - НачалоДня(ТДата) <= СвойстваПараметра.ЛимитПросрочкиКонтрольнойДаты * 60*60*24) Тогда
				СтрокаДерева.ПланПросрочен=Истина;
			Иначе	
				СтрокаДерева.ПланПросрочен=Ложь;
			КонецЕсли; 
			
		КонецЕсли; 
		
	КонецЕсли; 

	// ---------------------------------------------------------------------------- 
	// право удаления
	СтрокаДерева.УдалениеРазрешено = СтруктураПрав.Редактирование;
	
	// ---------------------------------------------------------------------------- 
	// контроль заполнения
	Если (ЗначениеЗаполнено(Объект.ТипПеревозки)) Тогда
		
		СтрокаКонтроляЗаполненияПараметра = Объект.ТипПеревозки.ПараметрыЗаявки.Найти(СтрокаПараметра.Параметр,"Параметр");
		Если (СтрокаКонтроляЗаполненияПараметра <> Неопределено) Тогда
			
			СтрокаДерева.КонтрольЗаполнения = СтрокаКонтроляЗаполненияПараметра.КонтрольЗаполнения;
			
		КонецЕсли; 
		ТекущееЗначениеКонтроляЗаполнения = СтрокаДерева.ЗначениеНезаполнено;
		Если (СвойстваПараметра.ЭтоКонтрольнаяДата) Тогда
			
			СтрокаДерева.ЗначениеНезаполнено = (СтрокаДерева.КонтрольЗаполнения И НЕ ЗначениеЗаполнено(СтрокаПараметра.ЗначениеФакт));
			
		Иначе
			
			СтрокаДерева.ЗначениеНезаполнено = (СтрокаДерева.КонтрольЗаполнения И НЕ ЗначениеЗаполнено(СтрокаПараметра.Значение));
			
		КонецЕсли; 
		Если (ТекущееЗначениеКонтроляЗаполнения <> СтрокаДерева.ЗначениеНезаполнено) Тогда
			
			// требуется рекурсивно проверить контроль заполнения
			_ПроверитьГруппыПоИерархии(СтрокаДерева);
			
		КонецЕсли; 
		
	КонецЕсли; 
	
	// --- 
КонецПроцедуры

&НаСервере
Процедура _ПроверитьГруппыПоИерархии(СтрокаДерева)
	// --- 
	
	Если (СтрокаДерева.ЭтоГруппа) Тогда
		СтрокаРодителя = СтрокаДерева;
	Иначе
		СтрокаРодителя = СтрокаДерева.ПолучитьРодителя();
		Если (СтрокаРодителя = Неопределено) Тогда
			
			Возврат;
			
		КонецЕсли; 
	КонецЕсли; 
	// --- 
	ЗначениеНеЗаполнено = Ложь;
	// требуется проверить отметку контроля заполнения у родителя
	
	ЭлементыСтроки = СтрокаРодителя.ПолучитьЭлементы();
	СтрокаРодителя.КоличествоПараметров = 0;
	Для каждого Стр Из ЭлементыСтроки Цикл
		
		Если (Стр.КонтрольЗаполнения И Стр.ЗначениеНезаполнено) Тогда
			
			ЗначениеНеЗаполнено = Истина;
			
		КонецЕсли; 
		_сф.Инкремент(СтрокаРодителя.КоличествоПараметров,Стр.КоличествоПараметров);
		
	КонецЦикла; 
	СтрокаРодителя.ЗначениеНезаполнено = ЗначениеНеЗаполнено;
	Если (ПоказыватьКоличествоПараметров) Тогда
		СтрокаРодителя.Параметр_Представление = СтрокаРодителя.НаименованиеГруппы + " ("+Формат(СтрокаРодителя.КоличествоПараметров,"ЧН=; ЧГ=")+")";	
	КонецЕсли; 
	
	// --- 
	
	// устанавливаем признак разрешения удаления для группы
	УдалениеРазрешено = Истина;
	// --- 
	КоличествоСформированныхПодчиненных = ЭлементыСтроки.Количество();
	СтрокаГруппы = _сф.к_НайтиСтроку(Объект.ГруппыПараметровЗаявки,Новый Структура("Идентификатор",СтрокаДерева.ИдентификаторГруппы));
	КоличествоПодчиненных = ЗначениеИзСтрокиВнутр(СтрокаГруппы.ИдентификаторыВедомых).Количество();
	Если (КоличествоСформированныхПодчиненных <> КоличествоПодчиненных) Тогда
		
		УдалениеРазрешено = Ложь;
		
	Иначе
		
		Для каждого ПодчиненнаяСтрока Из ЭлементыСтроки Цикл
			
			Если (НЕ ПодчиненнаяСтрока.УдалениеРазрешено) Тогда
				УдалениеРазрешено = Ложь;
				Прервать;
			КонецЕсли; 
			
		КонецЦикла; 
		
	КонецЕсли; 
	СтрокаРодителя.УдалениеРазрешено = УдалениеРазрешено;
	
	// --- 
	РодительРодителя = СтрокаРодителя.ПолучитьРодителя();
	Если (РодительРодителя <> Неопределено) Тогда
		_ПроверитьГруппыПоИерархии(РодительРодителя);	
	КонецЕсли; 
	
	// --- 
КонецПроцедуры
 

&НаСервере
Процедура _ЗаполнитьСтрокуДереваПоГруппе(СтрокаДерева, СтрокаГруппы)
	// --- 
	
	СтрокаДерева.ЭтоГруппа = Истина;
	СтрокаДерева.НаименованиеГруппы = СтрокаГруппы.Наименование;
	СтрокаДерева.Параметр_Представление = СтрокаГруппы.Наименование;
	СтрокаДерева.ИдентификаторГруппы = СтрокаГруппы.Идентификатор;
	СтрокаДерева.КонтрольЗаполнения = Истина;
	// --- 
	СтрокаДерева.ИндексКартинки = 0;
	
	//Новый механизм
	СтрокаДерева.ИдентификаторВладельца = СтрокаГруппы.ИдентификаторВладельца;
	//Новый механизм
	
	// --- 
КонецПроцедуры

// --- 

&НаКлиенте
Процедура ВыполнитьПодгрузкуСтрок(ИдентификаторСтрокиРодителя)
	// --- 
	
	СтрокаДерева = ДПГ.НайтиПоИдентификатору(ИдентификаторСтрокиРодителя);
	СтрокаДерева.ПолучитьЭлементы().Очистить();
	_ВыполнитьПодгрузку(ИдентификаторСтрокиРодителя);
	// --- 
	
	ВосстановитьСостояниеСверткиСтроки(ИдентификаторСтрокиРодителя);
	// --- 
	Элементы.ДПГ.Развернуть(ИдентификаторСтрокиРодителя);
	СохранитьСостояниеСверткиСтроки(ИдентификаторСтрокиРодителя, Истина);
	
	// --- 
КонецПроцедуры

&НаСервере
Процедура _ВыполнитьПодгрузку(ИдентификаторСтрокиРодителя)
	// --- 
	
	СтрокаРодителя = ДПГ.НайтиПоИдентификатору(ИдентификаторСтрокиРодителя);
	СтрокаГруппа = _сф.к_НайтиСтроку(Объект.ГруппыПараметровЗаявки,Новый Структура("Идентификатор",СтрокаРодителя.ИдентификаторГруппы));
	// --- 
	СПВ = Новый Структура("КартаПрав,КартаСвойств,ТаблицаКонтроляГрупп,ТаблицаКонтроляПараметров");
	СПВ.КартаПрав = ПолучитьИзВременногоХранилища(АдресКартыПравПараметров);
	СПВ.КартаСвойств = ПолучитьИзВременногоХранилища(АдресКартыСвойствПараметров);
	// --- 
	_СформироватьЭлементыДерева(СтрокаГруппа,СтрокаРодителя, СПВ);
	
	//
	_ПроверитьГруппыПоИерархии(СтрокаРодителя);
	
	// --- 
КонецПроцедуры

#КонецОбласти 

#Область СобытияДерева


&НаКлиенте
Процедура ДПГПередНачаломИзменения(Элемент, Отказ)
	
	Отказ = Истина;
	Идентификатор = Элементы.ДПГ.ТекущаяСтрока;
	СтрокаДПГ = ДПГ.НайтиПоИдентификатору(Идентификатор);
	// ---------------------------------------------------------------------------- 
	
	// группа
	Если (СтрокаДПГ.ЭтоГруппа) Тогда
		
		ДоступнаСменаРежимаСвертки 	= ПроверитьСостояниеВедомых(СтрокаДПГ);
		СостояниеГруппы 			= ПолучитьНастройкуРаскрытияГруппы(СтрокаДПГ.ИдентификаторГруппы);
		
		ПФ 				= Новый Структура("НаименованиеГруппы,ГруппаРазвернута,РежимГрузоперевозки,ДоступнаСменаРежимаСвертки", СтрокаДПГ.НаименованиеГруппы,СостояниеГруппы, Ложь,ДоступнаСменаРежимаСвертки);
		ПОВ 			= Новый ОписаниеОповещения("ОбработатьВводНаименованияГруппы",ЭтотОбъект, Новый Структура("Редактирование",Истина)); 
		
		ОткрытьФорму("ПланВидовХарактеристик.CW_ПараметрыГрузоперевозок.Форма.ФормаВиртуальнойГруппы",ПФ,,,,,ПОВ, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
	КонецЕсли;
	
	// параметр
	Если (НЕ СтрокаДПГ.ЭтоГруппа) Тогда
		
		Параметр = Элемент.ТекущиеДанные.Параметр;
		
		ИдентификаторСтрокиГруппы	= Неопределено;
		РодительПараметра 			= СтрокаДПГ.ПолучитЬРодителя();
		Если  РодительПараметра <> Неопределено тогда
			ИдентификаторСтрокиГруппы	= РодительПараметра.ПолучитьИдентификатор()
		КонецЕсли;
		
		// --- 
		ПараметрТолькоПросмотр = _ТолькоПросмотрПараметра(Параметр);
		СвойстваПараметра = CW_Мониторинг.СтруктураСвойствПараметра(Параметр);	
		Если (СвойстваПараметра.Ведомый) Тогда
			
			// проверяем ведущие на заполненность
			Результат = _ПроверитьЗаполнениеВедущих(Параметр,СвойстваПараметра.СписокВедущих);
			Если (НЕ _УФКС.ВыполненоУспешно(Результат)) Тогда
				
				_УФК.ВывестиПредупреждение("Данный параметр является зависимым!");
				Возврат;
				
			КонецЕсли;
			
		КонецЕсли; 
		Если (СвойстваПараметра.ДинамическийПараметр) Тогда
			
			_УФК.ВывестиПредупреждение("Динамические параметры не редактируются");
			Возврат;
			
		КонецЕсли;
		// --- 
		АдресОбъекта 	=  _АдресОбъекта();
		ВыбраннаяФорма 	= Неопределено;
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("Режим"						, "РедактированиеОбъекта");
		ПараметрыФормы.Вставить("Параметр"					, Параметр);
		ПараметрыФормы.Вставить("ИдентификаторСтрокиГруппы"	, ИдентификаторСтрокиГруппы);
		ПараметрыФормы.Вставить("АдресСвойствПараметра"		, ПоместитьВоВременноеХранилище(СвойстваПараметра,ЭтаФорма.УникальныйИдентификатор));
		ПараметрыФормы.Вставить("АдресОбъекта"				, АдресОбъекта);
		ПараметрыФормы.Вставить("ТолькоПросмотр"			, ПараметрТолькоПросмотр);
		ПараметрыФормы.Вставить("Значение"			        , СтрокаДПГ.Значение);
		
		//ХранениеПолногоЗначения  
		Если CW_МониторинговыеПараметрыСервер.ИспользуетсяСохранениеПолногоЗначения(Параметр) Тогда
			Если ТипЗнч(СохраняемоеПолноеЗначение) = Тип("ФиксированноеСоответствие") Тогда
				ПолноеЗначение = СохраняемоеПолноеЗначение.Получить(Параметр);
			КонецЕсли;
			ПолноеЗначение = ?(ПолноеЗначение=Неопределено, СтрокаДПГ.Значение, ПолноеЗначение);
			
			ПараметрыФормы.Вставить("ПолноеЗначение", ПолноеЗначение);
		КонецЕсли;
		//---ХранениеПолногоЗначения
		
		ПОВ = Новый ОписаниеОповещения("ОбработатьИзменениеПараметра",ЭтотОбъект,Новый Структура("СвойстваПараметра,Параметр",СвойстваПараметра,Параметр));
		
		Если СвойстваПараметра.ИспользоватьФормуВыбораОбъекта тогда
			
			Если Не ПараметрТолькоПросмотр Тогда
				ВыбраннаяФорма = СвойстваПараметра.ИмяФормыВыбора;
				
				ПараметрыФормы.Вставить("РежимВыбора"		,         Истина);
				ПараметрыФормы.Вставить("ЗакрыватьПриВыборе",         Истина);
				
				Если СвойстваПараметра.ИспользуютсяДополнительныеЗначения Тогда
					ПараметрыФормы.Вставить("Отбор", Новый Структура("Владелец",Параметр));
				КонецЕсли;

			КонецЕсли;
			
		Иначе
			Если СвойстваПараметра.ИспользуетсяВнешняяОбработкаПередНачаломИзменения Тогда
				СтруктураПараметров = _ПО.ПолучитьИмяФормыНаСервере(Параметр, АдресОбъекта);
				ВыбраннаяФорма 		= "ПланВидовХарактеристик.CW_ПараметрыГрузоперевозок.Форма.ФормаРедактирования";
				
				ОбработчикНеИспользуется = Ложь;
				Если СтруктураПараметров.Свойство("НеИспользуется") Тогда
					ОбработчикНеИспользуется = СтруктураПараметров.НеИспользуется;
				КонецЕсли;

				Если СтруктураПараметров.Свойство("ТолькоПросмотр") Тогда
					Если  НЕ ПараметрыФормы.ТолькоПросмотр Тогда
						ПараметрыФормы.ТолькоПросмотр =  СтруктураПараметров.ТолькоПросмотр;
					КонецЕсли;
				КонецЕсли;
				
				Если СтруктураПараметров.Свойство("ПодключаемыйОбъект") Тогда
					ПараметрыФормы.Вставить("ПодключаемыйОбъект",СтруктураПараметров.ПодключаемыйОбъект);
				КонецЕсли; 	
				
				Если ОбработчикНеИспользуется ИЛИ 
					СтруктураПараметров.РежимОткрытия = 1 Тогда
					ВыбраннаяФорма = "ПланВидовХарактеристик.CW_ПараметрыГрузоперевозок.Форма.ФормаРедактирования";
				ИначеЕсли	СтруктураПараметров.РежимОткрытия = 0 Тогда
					ВыбраннаяФорма = СтруктураПараметров.ИмяФормы;
				КонецЕсли;

			Иначе
				ВыбраннаяФорма = "ПланВидовХарактеристик.CW_ПараметрыГрузоперевозок.Форма.ФормаРедактирования";
			КонецЕсли;

		КонецЕсли;
		
		Если ВыбраннаяФорма <> Неопределено Тогда
			ОткрытьФорму(ВыбраннаяФорма, ПараметрыФормы,ЭтаФорма,,,,ПОВ,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		КонецЕсли;
		
	КонецЕсли; 
	
КонецПроцедуры


&наКлиенте
Функция ПроверитьСостояниеВедомых(СтрокаДерева)
	
	ДоступностьСменыРежима = Истина;
	
	тЭлеметы = СтрокаДерева.ПолучитьЭлементы();
	ПроверитьСостояниеВедомыхРекурсивно(тЭлеметы, ДоступностьСменыРежима);
	
	Возврат ДоступностьСменыРежима;
	
КонецФункции

&наКлиенте
Процедура ПроверитьСостояниеВедомыхРекурсивно(тЭлеметы, ДоступностьСменыРежима)
	
	Если Не ДоступностьСменыРежима Тогда
		Возврат;
	КонецЕсли;
	
	Для каждого стрЭлемент из тЭлеметы Цикл
		Если  стрЭлемент.ЭтоГруппа Тогда
			ЭлементСостояния = ДПГ_СостояниеСвертки.НайтиПоЗначению(стрЭлемент.ИдентификаторГруппы);
			Если ЭлементСостояния <> Неопределено Тогда
				Если ЭлементСостояния.Пометка Тогда
					ДоступностьСменыРежима = Ложь;
				КонецЕсли;
			КонецЕсли;
			Подчиненные = стрЭлемент.получитьЭлементы();
			ПроверитьСостояниеВедомыхРекурсивно(подчиненные, ДоступностьСменыРежима);
		КонецЕсли;
	КонецЦикла;
		
КонецПроцедуры


&НаСервере
Функция ПолучитьНастройкуРаскрытияГруппы(Идентификатор)
	
	мНайденныеСтроки = Объект.ГруппыПараметровЗаявки.НайтиСтроки(Новый Структура("Идентификатор",Идентификатор));
	
	Если мНайденныеСтроки.Количество() = 0 Тогда
		//Странно... группа есть, а строки нет
		//получим настройку из параметров
		
		CW_Настройки.ПолучитьНастройкуПользователя(ПараметрыСеанса.ТекущийПользователь,"РазворачиватьДеревоПараметровЗаявок");		
	Иначе
		Возврат мНайденныеСтроки[0].Раскрывать;
	КонецЕсли;
	
КонецФункции


&НаСервере
Функция _ПроверитьЗаполнениеВедущих(Параметр,СписокВедущих)
	// --- 
	
	// контроллируем заполнение и единство
	ФлагОшибки = Ложь;
	ТекстОшибки = "";
	Для каждого ВедущийПГ Из СписокВедущих Цикл
		
		// проверяем параметр у переданных объектов
		МассивНепустыхЗначений = Новый Массив;
		
		ВедущийПараметр = ВедущийПГ.Значение;
		СтрокаПараметра = _сф.к_НайтиСтроку(Объект.ПараметрыЗаявки,"Параметр",ВедущийПараметр);
		Если СтрокаПараметра = Неопределено Тогда
			
			ЗначениеПараметра = Неопределено;
			
		Иначе
			
			ЗначениеПараметра = СтрокаПараметра.Значение;
			
		КонецЕсли; 
		Если ЗначениеЗаполнено(ЗначениеПараметра) Тогда
			
			_сф.м_ДобавитьУникально(МассивНепустыхЗначений,ЗначениеПараметра);
			
		Иначе
			
			ФлагОшибки = Истина;
			ТекстОшибки = "";
			
		КонецЕсли; 
		
		
		// теперь если нет ошибки считаем количество
		// если не 1, то выдаём ошибку
		Если НЕ ФлагОшибки Тогда
			
			Если МассивНепустыхЗначений.Количество() <> 1 Тогда
				
				ФлагОшибки = Истина;
				ТекстОшибки = ""
				
			КонецЕсли; 
			
		КонецЕсли; 
		
		Если ФлагОшибки Тогда
			
			// тут необходимо закрыть форму и вернуть описание ошибки
			ТекстОшибки = "Условия отбора для выбранного параметра ("""+Параметр.Наименование+""") требуют, чтобы было задано значение параметра """+ВедущийПараметр.Наименование+""".";
			Возврат(_УФКС.Ответ(1,ТекстОшибки));
			
		КонецЕсли; 
		
	КонецЦикла; 
	
	Возврат(_УФКС.Ответ());
	
	// --- 
КонецФункции

#КонецОбласти 

#Область СостояниеСвертки 

&НаСервере
Функция УстановитьСостояниеСверткиСтроки(ИдентификаторСтроки, ИдентификаторГруппы, Развернута=Истина)

	ЭлементСостояния = ДПГ_СостояниеСвертки.НайтиПоЗначению(ИдентификаторГруппы);
	Если (ЭлементСостояния = Неопределено) Тогда
		ЭлементСостояния = ДПГ_СостояниеСвертки.Добавить(ИдентификаторГруппы);
	КонецЕсли; 
	ЭлементСостояния.Представление 	= Формат(ИдентификаторСтроки,"ЧДЦ=; ЧН=; ЧГ=");
	ЭлементСостояния.Пометка 		= Развернута;

КонецФункции

&НаКлиенте
Процедура ДПГ_ВосстановитьСверткуДерево(Команда)
	
	ДПГ_ВосстановитьСостояниеСвертки();
	
КонецПроцедуры

&НаКлиенте
Процедура ДПГ_ВосстановитьСостояниеСвертки()
	
	тЭлементы = ДПГ.ПолучитьЭлементы();
	ДПГ_ВосстановитьСостояниеСверткиРекунсивно(тЭлементы);
		
КонецПроцедуры

&НаКлиенте
Процедура ДПГ_ВосстановитьСостояниеСверткиРекунсивно(тЭлементы)
	
	Для каждого тЭлемент Из тЭлементы Цикл
		
		тПодчиненные = тЭлемент.ПолучитьЭлементы();
		ДПГ_ВосстановитьСостояниеСверткиРекунсивно(тПодчиненные);
		
		ВосстановитьСостояниеСверткиСтроки(тЭлемент.ПолучитьИдентификатор());
		
	КонецЦикла; 
	
КонецПроцедуры


&НаКлиенте
Процедура ВосстановитьСостояниеСверткиДерева()
	
	Для каждого Стр Из ДПГ.ПолучитьЭлементы() Цикл
		ВосстановитьСостояниеСверткиСтроки(Стр.ПолучитьИдентификатор());
	КонецЦикла; 
	
КонецПроцедуры

&НаКлиенте
Процедура ВосстановитьСостояниеСверткиСтроки(Идентификатор)
	
	СтрокаДерева 		= ДПГ.НайтиПоИдентификатору(Идентификатор);
	ЭлементСостояния 	= ДПГ_СостояниеСвертки.НайтиПоЗначению(СтрокаДерева.ИдентификаторГруппы);
	
	Если ЭлементСостояния <> Неопределено Тогда
		
		Если ЭлементСостояния.Пометка Тогда
			Элементы.ДПГ.Развернуть(СтрокаДерева.ПолучитьИдентификатор());
		Иначе
			Элементы.ДПГ.Свернуть(СтрокаДерева.ПолучитьИдентификатор());
		конецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция СохранитьСостояниеСверткиСтроки(ИдентификаторСтроки,Признак)
	// --- 
	
	СтрокаДерева = ДПГ.НайтиПоИдентификатору(ИдентификаторСтроки);
	Если (СтрокаДерева = Неопределено) Тогда
		Возврат(Неопределено);
	КонецЕсли; 
	// --- 
	СтрокиГрупп = Объект.ГруппыПараметровЗаявки.НайтиСтроки(Новый Структура("Идентификатор",СтрокаДерева.ИдентификаторГруппы));
	Если (СтрокиГрупп.Количество() <> 0) Тогда
		СтрокаГруппы = СтрокиГрупп[0];
		СтрокаГруппы.Раскрывать = Признак;
	КонецЕсли; 
	// --- 
	ЭлементСостояния = ДПГ_СостояниеСвертки.НайтиПоЗначению(СтрокаДерева.ИдентификаторГруппы);
	Если (ЭлементСостояния = Неопределено) Тогда
		ЭлементСостояния = ДПГ_СостояниеСвертки.Добавить(СтрокаДерева.ИдентификаторГруппы);
	КонецЕсли; 
	ЭлементСостояния.Представление = Формат(ИдентификаторСтроки,"ЧДЦ=; ЧН=; ЧГ=");
	ЭлементСостояния.Пометка = Признак;
	
	// --- 
КонецФункции

// --- 

&НаКлиенте
Процедура СвернутьВсе(Команда)
	
	тЭлементы = ДПГ.ПолучитьЭлементы();
	СвернутьРекурсивно(тЭлементы); 
	
КонецПроцедуры

&НаКлиенте
Процедура СвернутьРекурсивно(тЭлементы)
	
	Для Каждого тСтр Из тЭлементы Цикл
		тСтрЭлементы = тСтр.ПолучитьЭлементы();
		СвернутьРекурсивно(тСтрЭлементы);
		
		Элементы.ДПГ.Свернуть(тСтр.ПолучитьИдентификатор());
