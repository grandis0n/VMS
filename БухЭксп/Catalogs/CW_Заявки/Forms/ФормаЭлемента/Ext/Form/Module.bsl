&НаКлиенте
Процедура ЗаполнитьБюджет(Команда)
	
	СписокВыбора = Новый СписокЗначений;
	СписокВыбора.Добавить(0,"Скопировать из грузоперевозки");
	СписокВыбора.Вставить(1,"Подключаемые обработки заполнения");
	
	ПОВ = Новый ОписаниеОповещения("ОбработкаВыбораВариантаЗаполненияБюджета",ЭтотОбъект, Новый Структура()); 
	СписокВыбора.ПоказатьВыборЭлемента(ПОВ,"Вариант заполнения", Элементы.ЗаполнитьПоПрайсам);
		
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбораВариантаЗаполненияБюджета(Ответ, ДополнительныеПараметры) Экспорт 
	// --- 
	
	Если (Ответ <> Неопределено) Тогда
		
		Если (Ответ.Значение = 0) Тогда
			
			ПОВ = Новый ОписаниеОповещения("ОбработкаВыбораГрузоперевозки",ЭтотОбъект, Новый Структура()); 
			ПараметрыФормы = Новый Структура;
			ПараметрыФормы.Вставить("РежимВыбора",Истина);
			ОткрытьФорму("Справочник.CW_Грузоперевозки.ФормаВыбора",ПараметрыФормы,,Истина,,,ПОВ,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
			
		Иначе
			
			// получаем список обработок заполнения бюджета
			Ответ = _ОбработкиЗаполненияБюджета();
			Если (_УФКС.ВыполненоУспешно(Ответ)) Тогда
				
				Для каждого Стр Из Ответ.Обработки Цикл
					
					//СП = _ПараметрыЗаполнения();
					
					Если (Стр.Интерактив) Тогда
						
						// открываем форму
						ИмяФормыНастроек = _ИмяФормыНастроекЗаполнения(Стр.Обработка);
						ПФ = _ПараметрыЗаполнения(Стр.Обработка);
						ПОВ = Новый ОписаниеОповещения("ОбработкаЗаполненияБюджета",ЭтотОбъект);
						ОткрытьФорму(ИмяФормыНастроек,ПФ,,,,,ПОВ,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
						
					Иначе
						
						// неинтерактивно
						ОбработкаЗаполненияБюджета(_ЗаполнитьНеинтерактивно(Стр.Обработка));
						
					КонецЕсли; 
					
				КонецЦикла; 
				
			Иначе
				
				_УФК.ВывестиПредупреждение(_УФКС.ПредставлениеОшибки(Ответ));
				Возврат;
				
			КонецЕсли; 
			
		КонецЕсли; 
		
	КонецЕсли; 
	
	// --- 
КонецПроцедуры
  

&НаКлиенте
Процедура ОбработкаЗаполненияБюджета(Ответ,ДополнительныеПараметры=Неопределено) Экспорт 
	// --- 
	
	Если (Ответ <> Неопределено) Тогда
		Если (НЕ _УФКС.ВыполненоУспешно(Ответ)) Тогда
			
			_УФК.ВывестиПредупреждение("Ошибка заполнения: "+_УФКС.ПредставлениеОшибки(Ответ));
			
		Иначе
			
			ВыполнитьДействие(_УФКС.СД("Грузоперевозки","сервер","/БюджетОбновить"));
			
			//Сортировка бюджетов
			ВосстановитьСортировкуТаблицы("БюджетРасходы");
			ВосстановитьСортировкуТаблицы("БюджетДоходы");
			//Сортировка бюджетов
			
		КонецЕсли;
	КонецЕсли;
	
	// --- 
КонецПроцедуры
  

&НаСервере
Функция _ОбработкиЗаполненияБюджета()
	// --- 
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	CW_ПодключаемыеОбъекты.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.CW_ПодключаемыеОбъекты КАК CW_ПодключаемыеОбъекты
	               |ГДЕ
	               |	CW_ПодключаемыеОбъекты.ТипВнешнегоОбъекта = Значение(Перечисление.CW_ТипыПодключаемыхОбъектов.ВнешняяОбработка)
	               |	И CW_ПодключаемыеОбъекты.Вид = &Вид
	               |	И CW_ПодключаемыеОбъекты.ПометкаУдаления = ЛОЖЬ
	               |	И CW_ПодключаемыеОбъекты.НеИспользуется = ЛОЖЬ";
	
	Запрос.УстановитьПараметр("Вид", "ЗаполнениеБюджета");
	// --- 
	МассивОбработок = Новый Массив;
	// --- 
	ТЗ = Запрос.Выполнить().Выгрузить();
	Для каждого Стр Из ТЗ Цикл
		
		СО = Новый Структура("Обработка,Интерактив",Стр.Ссылка,Ложь);
		Отбор = Новый Структура("ТипФормы","ФормаНастроекЗаполнения");
		СтрокаФормы = _сф.к_НайтиСтроку(Стр.Ссылка.ФормыОбъекта,Отбор);
		Если (СтрокаФормы <> Неопределено) Тогда
			
			СО.Интерактив = Истина;
			
		КонецЕсли; 
		МассивОбработок.Добавить(СО);
		
	КонецЦикла; 
	Если (МассивОбработок.Количество()=0) Тогда
		Возврат(_УФКС.Ответ(1,"Обработок заполнения не обнаружено"));
	Иначе
		Ответ = _УФКС.Ответ();
		Ответ.Вставить("Обработки",МассивОбработок);
		Возврат(Ответ);
	КонецЕсли; 
	
	// --- 
КонецФункции

&НаСервере
Функция _ПараметрыЗаполнения(ОбработкаЗаполнения)
	// --- 
	
	СП = Новый Структура;
	СП.Вставить("Грузоперевозка",Объект.Ссылка);
	СП.Вставить("ВерсияБюджета",БюджетТекущаяВерсия);
	СП.Вставить("Обработка",ОбработкаЗаполнения);
	
	Возврат(СП);
	
	// --- 
КонецФункции

&НаСервере
Функция _ЗаполнитьНеинтерактивно(ОбработкаЗаполнения)
	// --- 
	
	СП = _ПараметрыЗаполнения(ОбработкаЗаполнения);
	Обработка = _ПО.ПолучитьОбработку(ОбработкаЗаполнения);
	Ответ = Обработка.ЗаполнитьБюджет(СП);
	Возврат(Ответ);
	
	// --- 
КонецФункции

&НаСервере
Функция _ИмяФормыНастроекЗаполнения(ОбработкаЗаполнения)
	// --- 
	
	// подключаем обработку, вдруг ещё не подключена
	_ПО.ПодключитьОбработку(ОбработкаЗаполнения);
	Возврат(_ПО.ПолучитьПолноеИмяФормыПоТипу(ОбработкаЗаполнения,"ФормаНастроекЗаполнения"));
	
	// --- 
КонецФункции


