&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ПОВ_БазоваяЛогика = Новый ОписаниеОповещения("ПриОткрытииБазоваяЛогика",ЭтотОбъект);
	
	Если (РежимКопирования) Тогда
		
		ПОВ_Отказ = Новый ОписаниеОповещения("ОбработкаКопированияОтказ",ЭтотОбъект);
		ПОВ_Обработка = Новый ОписаниеОповещения("ОбработкаКопированияБюджета",ЭтотОбъект,Новый Структура("ПОВ_БазоваяЛогика,ПОВ_Отказ",ПОВ_БазоваяЛогика,ПОВ_Отказ));
		// --- 
		ПОВ = Новый ОписаниеОповещения("ОбработкаВопросаКопированияБюджета",ЭтотОбъект, Новый Структура()); 
		ПФ = Новый Структура("ОбъектКопирования,УИД",ОбъектКопирования,ЭтаФорма.УникальныйИдентификатор);
		ОткрытьФорму("ОбщаяФорма.CW_ФормаКопированияБюджетаПоЗаявке",ПФ,,,,,ПОВ_Обработка,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

		
	Иначе
		
		ВыполнитьОбработкуОповещения(ПОВ_БазоваяЛогика);
		
	КонецЕсли;
	
	
	ДПГ_ВосстановитьСостояниеСвертки();

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаКопированияБюджета(Ответ,ДополнительныеПараметры) Экспорт
	// --- 
	
	Если (Ответ = Неопределено) Тогда
		
		ВыполнитьОбработкуОповещения(ДополнительныеПараметры.ПОВ_Отказ);
		Возврат;
		
	Иначе
		
		Если (_УФКС.ВыполненоУспешно(Ответ)) Тогда
			
			// сохраняем список вариантов 
			Для каждого Элемент Из Ответ.ВариантыБюджетов Цикл
				
				Если (Элемент.Пометка) Тогда
					ВариантыБюджетов.Добавить(Элемент.Значение);	
				КонецЕсли; 
				
			КонецЦикла; 
			
		КонецЕсли; 
		// --- 
		РежимКопирования = Ложь;
		Попытка
			//ВыполнитьДействие(_УФКС.СД("Грузоперевозки","сервер","/ИнициализацияФормы"));
			ЭтаФорма.Записать();
		Исключение
			Сообщить(ОписаниеОшибки());
			Отказ = Истина;
			Возврат;
		КонецПопытки; 
		
	КонецЕсли; 
	
	// --- 
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаКопированияОтказ(Ответ,ДополнительныеПараметры) Экспорт
	// --- 
	
	ПОВ_БазоваяЛогика = Новый ОписаниеОповещения("ПриОткрытииБазоваяЛогика",ЭтотОбъект);
	ВыполнитьОбработкуОповещения(ПОВ_БазоваяЛогика);
	
	// --- 
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытииБазоваяЛогика(Ответ,ДополнительныеПараметры) Экспорт
	// --- 
	
	Если (Объект.Ссылка.Пустая() И НЕ Объект.ТипПеревозки.Пустая()) Тогда
		ЗаполнитьПараметрыПоТипуПеревозки(0);
	КонецЕсли; 
	// формируем дерево
	ОбновитьДеревоПараметров();
	
	// --- 
КонецПроцедуры


&НаКлиенте
Процедура ТипПеревозкиПриИзменении(Элемент) 
	
	ДиалогЗаполненияПоТипу();
	_УправлениеЭлементамиФормы();
	ЗаполнитьПредопределенныеЗначенияПараметровДляРеквизита(Объект.ТипПеревозки, "ТипПеревозки");
	
	ВыполнитьДействиеНаСервере(_УФКС.СД("Журналы","сервер","/ИнициализацияФормы",Новый Структура("ИмяСеансовойНастройки","ПоследняяНастройкаЗаявки")));
	ВыполнитьДействиеНаСервере(_УФКС.СД("Журналы","сервер","/ИнициализацияНастроек"));
	ВыполнитьДействиеНаСервере(_УФКС.СД("Журналы","сервер","/ОбновитьДанные"));
	
