&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	_сф.ст_УстановитьСвойство(ТекущийОбъект.ДополнительныеСвойства,"ИнтерактивныйРежим", 			Истина);
	
	Если (ВариантыБюджетов.Количество() <> 0) Тогда
		
		_сф.ст_УстановитьСвойство(ТекущийОбъект.ДополнительныеСвойства,"КопироватьБюджеты",Истина);
		_сф.ст_УстановитьСвойство(ТекущийОбъект.ДополнительныеСвойства,"КопироватьБюджетыМассивВариантов",ВариантыБюджетов.ВыгрузитьЗначения());
		
	КонецЕсли; 
	
	//Запись данных харнилища занчений по строкам 
	Для Каждого ЭлементСписка из СписокАдресовЗначенийПараметров Цикл
		
		//ДанныеПоАдресу - тип "Структура("Параметр, ТаблицаДанных")
		ДанныеПоАдресу = ЭлементСписка.Значение;
		
		Отбор = Новый Структура("Параметр", ДанныеПоАдресу.Параметр);
		мСтроки = ТекущийОбъект.ПараметрыЗаявки.НайтиСтроки(Отбор);
		Если мСтроки.Количество() > 0 Тогда
			//Предполагаем что строка будет только одна
			СтрокаДанных = мСтроки[0]; 
			Если ТипЗНЧ(ДанныеПоАдресу.ДанныеДляХранения) = Тип("ДанныеФормыКоллекция") Тогда
				СтрокаДанных.ХранилищеДанных = новый ХранилищеЗначения(ДанныеПоАдресу.ДанныеДляХранения.Выгрузить());	
			Иначе
				СтрокаДанных.ХранилищеДанных = новый ХранилищеЗначения(ДанныеПоАдресу.ДанныеДляХранения);	
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
	//ХранениеПолногоЗначения 
	Если ТипЗнч(СохраняемоеПолноеЗначение) = Тип("ФиксированноеСоответствие") Тогда 
		Для Каждого КлючЗначение из СохраняемоеПолноеЗначение Цикл
			Отбор = Новый Структура("Параметр", КлючЗначение.Ключ);
			НайденныеСтроки = ТекущийОбъект.ПараметрыЗаявки.НайтиСтроки(Отбор);
			Если НайденныеСтроки.Количество() > 0 Тогда
				//Предполагаем что строка будет только одна
				СтрокаДанных = НайденныеСтроки[0];   
				СтрокаДанных.ХранилищеДанных = новый ХранилищеЗначения(КлючЗначение.Значение);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	//---ХранениеПолногоЗначения
	
КонецПроцедуры


&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	Если (НЕ Элементы.СтраницаСобытия.Видимость) Тогда
		
		_ОтборСобытий();
		
	КонецЕсли; 
	
	УстановитьОтборЗаказов();
	// --- 
	_УправлениеЭлементамиФормы();
	// --- 
	Если (НЕ ГрузоперевозкиИнициализированы ) Тогда
		_УстановитьЗаголовокСтраницыГрузоперевозок();
	КонецЕсли;
	// --- 
	_Заголовок();
	
	//Подсистема.ЛогистическиеСтатусы
	ВыполнитьРасчетЛогистическогоСтатусаНаСервере();
	//Подсистема.ЛогистическиеСтатусы   
	
	//ПрогнозОплаты   
	Если ИспользуетсяПрогнозированиеДДСПоБюджету Тогда
		CW_Бюджетирование.РассчитатьПрогнозОплаты(Объект.Ссылка);
	КонецЕсли;
	//ПрогнозОплаты 
	
	//РаботаСАрхивомОбъектов
	CW_АрхивОбъектовСервер.ПослеЗаписиНаСервере(ЭтаФорма);
	//РаботаСАрхивомОбъектов
	
	УстаноитьВидимостьСтраниц();
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	// --- 
	ВариантыБюджетов.Очистить();
	// --- 
	ОповеститьОЗаписиНового(Объект.Ссылка);
	Оповестить("ЗаписьСправочника",Объект.Ссылка,"Справочник.CW_Заявки");
	
КонецПроцедуры

