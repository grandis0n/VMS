			Если (НЕ ЗначениеЗаполнено(Объект.Содержание)) Тогда
				
				ПоказатьПредупреждение(,"Содержание не заполнено.");
				
			ИначеЕсли (НЕ ЗначениеЗаполнено(Объект.Контрагент)) Тогда 
				
				ПоказатьПредупреждение(,"Не указан клиент"); 
				
			Иначе		
				
				ПФ = _ПараметрыФормыСобытия();
				ОткрытьФорму("Справочник.CW_События.Форма.ФормаЭлемента",ПФ);
				//_СоздатьСобытиеПоСодержанию();
