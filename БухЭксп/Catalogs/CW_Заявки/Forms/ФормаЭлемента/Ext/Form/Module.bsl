Процедура БюджетЗаполнитьДоходыПоРасходам(Команда)
	
	ПараметрыВариантаБюджета = ПолучитьПараметрыВариантаБюджета();
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("ВалютаВарианта", ПараметрыВариантаБюджета.Валюта);  
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ПослеВыбораВариантаВалюты", ЭтотОбъект);
	
	ОткрытьФорму("Справочник.CW_Заявки.Форма.ВыборВалютыБюджета", СтруктураПараметров, ЭтаФорма,,,,ОписаниеОповещения); 
	
КонецПроцедуры  

&НаКлиенте
Процедура ПослеВыбораВариантаВалюты(РезультатВыбора, ДополнительныеПараметры) Экспорт
	
	Если РезультатВыбора = Неопределено Тогда
		Возврат;
	КонецЕсли;    
	
	МассивСсылок = Новый Массив;
	Для каждого ВыделеннаяСтрока Из Элементы.БюджетРасходы.ВыделенныеСтроки Цикл
		СтрокаТаблицы = БюджетРасходы.НайтиПоИдентификатору(ВыделеннаяСтрока);
		МассивСсылок.Добавить(СтрокаТаблицы.СтатьяСсылка);
	КонецЦикла; 
	
	ПараметрыЗаполнения = Новый Структура;
	ПараметрыЗаполнения.Вставить("Объект", 					Объект.ВариантБюджета);
	ПараметрыЗаполнения.Вставить("ВерсияБюджета", 			БюджетТекущаяВерсия);
	ПараметрыЗаполнения.Вставить("ВариантВалютыБюджета",	РезультатВыбора.ВариантВалютыБюджета);
	ПараметрыЗаполнения.Вставить("МассивСсылок", 	    	МассивСсылок);
	ПараметрыЗаполнения.Вставить("ДоходыВРасходы", 	    	Ложь);
	ПараметрыЗаполнения.Вставить("РежимДерево", 			Ложь);
	
	Ответ = БюджетЗаполнитьДоходыПоРасходамНаСервере(ПараметрыЗаполнения);
	
	ВыполнитьДействие(Ответ);
	
КонецПроцедуры  

