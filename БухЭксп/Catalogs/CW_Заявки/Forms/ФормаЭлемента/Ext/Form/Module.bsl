&НаСервере
Функция ПродолжитьСозданиеГрузоперевозокНаСервереВФоне(ПараметрыПроцедуры)
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(Новый УникальныйИдентификатор);
	ПараметрыВыполнения.ОжидатьЗавершение 			= 0; // запускать сразу
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = "Создание грузоперевозок";
	ПараметрыВыполнения.ЗапуститьВФоне 				= Истина;
	ПараметрыВыполнения.ЗапуститьНеВФоне 			= ложь;

	Если ЭтоАдресВременногоХранилища(ПараметрыПроцедуры.АдресВариантовБюжетаЗаявки) Тогда
		СписокВариантовБюджета = ПолучитьИзВременногоХранилища(ПараметрыПроцедуры.АдресВариантовБюжетаЗаявки);   
	КонецЕсли; 
	
	ПараметрыПроцедуры.Вставить("СписокВариантовБюджета", 		СписокВариантовБюджета);	
	
	Возврат ДлительныеОперации.ВыполнитьВФоне("Справочники.CW_Заявки.СформироватьЗаполнитьЗаказПоЗаявке",ПараметрыПроцедуры, ПараметрыВыполнения);
		
КонецФункции  

&НаКлиенте
Процедура ОбработатьРезультатСозданияГрузоперевозок(РезультатВыполнения, Дополнительныепараметры) Экспорт
	
	Если РезультатВыполнения.Статус = "Выполнено" Тогда
		
		ВыполнитьДействие(_УФКС.СД("Журналы","клиент","/Обновить",Неопределено));
		
		ПоказатьОповещениеПользователя("Создание грузоперевозок",,"Создано "+Формат(Дополнительныепараметры.Количество,"ЧДЦ=0")+" грузоперевозок");
		
		
	ИначеЕсли РезультатВыполнения.Статус = "Ошибка" Тогда
		
		ТекстПредупреждения = "Ошибка создания грузоперевозок!
		| По причине: "+ РезультатВыполнения.КраткоеПредставлениеОшибки + "
		| Информаиция об ошибке см. в журнале регистрации!";
		
		Если ТипЗнч(РезультатВыполнения.Сообщения) = Тип("Массив") Тогда
			Для Каждого СообщениеВМассиве из РезультатВыполнения.Сообщения Цикл
				СообщениеВМассиве.Сообщить();
			КонецЦикла;
		КонецЕсли;
		
		ПоказатьПредупреждение(,ТекстПредупреждения,,"Ошибка создания грузоперевозок");
		
	КонецЕсли;
	
КонецПроцедуры
