Функция БюджетЗаполнитьДоходыПоРасходамНаСервере(ПараметрыЗаполнения)
	
	Возврат CW_Грузоперевозки_Сервер.БюджетЗаполнитьДоходыПоРасходам(ЭтаФорма, ПараметрыЗаполнения); 
	
КонецФункции

&НаСервере
Функция ПолучитьПараметрыВариантаБюджета() 
	
	ВариантБюджетаВалюта	= Объект.ВариантБюджета.Валюта; 
	ВариантБюджетаКурс 		= Объект.ВариантБюджета.Курс;
	ВариантБюджетаКратность	= Объект.ВариантБюджета.Кратность;
	
	Если ВариантБюджетаВалюта.Пустая() Тогда
		ВариантБюджетаВалюта 	= Константы.ВалютаРегламентированногоУчета.Получить();
		ВариантБюджетаКурс 		= 1;
		ВариантБюджетаКратность = 1;
	КонецЕсли;
	
	ПараметрыВариантаБюджета = Новый Структура;
	ПараметрыВариантаБюджета.Вставить("Валюта", 	ВариантБюджетаВалюта);
	ПараметрыВариантаБюджета.Вставить("Курс", 		ВариантБюджетаКурс);
	ПараметрыВариантаБюджета.Вставить("Кратность", 	ВариантБюджетаКратность);
	
	Возврат ПараметрыВариантаБюджета;
	
КонецФункции

//ХранениеПолногоЗначения
&НаСервере
Процедура ДобавитьСохраняемоеПолноеЗначение(Параметр, ХранимоеЗначение=Неопределено)
	
	Если Не CW_МониторинговыеПараметрыСервер.ИспользуетсяСохранениеПолногоЗначения(Параметр) Тогда   
		Возврат
    КонецЕсли;
	
	Соответствие = Новый Соответствие;
	Если ТипЗнч(СохраняемоеПолноеЗначение) = Тип("ФиксированноеСоответствие") Тогда
		Соответствие = Новый Соответствие(СохраняемоеПолноеЗначение);                                             
	КонецЕсли;
	
	Соответствие.Вставить(Параметр, ХранимоеЗначение);
	СохраняемоеПолноеЗначение = Новый ФиксированноеСоответствие(Соответствие);
	
