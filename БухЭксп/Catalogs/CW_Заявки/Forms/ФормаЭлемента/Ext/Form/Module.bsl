		ДополнительныеПараметры.Вставить("ИмяРеквизита", Этаформа.ТекущийЭлемент.Имя);
		
		Оповещение = Новый ОписаниеОповещения("ПродолжитьВыборМенеджера", ЭтаФорма, ДополнительныеПараметры);
		
