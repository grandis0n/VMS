&НаКлиенте
Процедура ОбработкаВопросаКопированияБюджета(Ответ, ДополнительныеПараметры) Экспорт 
	// --- 
	
	Если (_УФКС.ВыполненоУспешно(Ответ)) Тогда
		
		// сохраняем список вариантов 
		Для каждого Элемент Из Ответ.ВариантыБюджетов Цикл
			
			Если (Элемент.Пометка) Тогда
				ВариантыБюджетов.Добавить(Элемент.Значение);	
			КонецЕсли; 
			
		КонецЦикла; 
		
	КонецЕсли; 
	// --- 
	РежимКопирования = Ложь;
	// --- 
	//ЭтаФорма.Записать();
	
	// --- 
