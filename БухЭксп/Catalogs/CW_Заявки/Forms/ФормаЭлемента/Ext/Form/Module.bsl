&НаКлиенте
Процедура СоздатьЗаказПоТекущейЗаявке(Команда)
	
	Если Объект.Ссылка.Пустая() Тогда
		ПоказатьПредупреждение(,"Необходимо записать заявку!");
		Возврат;
	КонецЕсли;
		
	ПараметрыЗаказа = ПолучитьПараметрыФормированияЗаказа();
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ПродолжитьФормированиеЗаказа", ЭтотОбъект);
	ОткрытьФорму("ОбщаяФорма.CW_СозданиеЗаказа", ПараметрыЗаказа, ЭтаФорма,,,,ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаСервере
Функция ПолучитьПараметрыФормированияЗаказа()
	
	Результат = Новый Структура;
	Результат.Вставить("Заявка", 				Объект.Ссылка);
	Результат.Вставить("Количество", 			Объект.КоличествоПеревозок);
	Результат.Вставить("ТипПеревозки", 			Объект.ТипПеревозки);
	Результат.Вставить("РежимСозданиеЗаказа", 	Истина);
	Результат.Вставить("ДоступенРежимНеСоздаватьГрузоперевозки", Истина);
	
	Если ПолучитьФункциональнуюОпцию("CW_ИспользованиеБюджетирования") Тогда
		
		Результат.Вставить("ВариантБюжетаЗаявки", Объект.ВариантБюджета);
		Результат.Вставить("КопироватьБюджет", Истина);
		
	КонецЕсли;	
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ПродолжитьФормированиеЗаказа(Ответ, Параметры) Экспорт
	
	Если Ответ = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	РезультатВыполнения =  ПродолжитьФормированиеЗаказаНаСервереВФоне(Ответ);
	
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ВыводитьОкноОжидания = Истина;
	ОповещениеОЗавершении = Новый ОписаниеОповещения("ОбработатьРезультатСозданияЗаказа", ЭтотОбъект);
	
	ДлительныеОперацииКлиент.ОжидатьЗавершение(РезультатВыполнения, ОповещениеОЗавершении, ПараметрыОжидания);

КонецПроцедуры

&НаКлиенте
Процедура ОбработатьРезультатСозданияЗаказа(РезультатВыполнения, Дополнительныепараметры) Экспорт
	
	Если РезультатВыполнения.Статус = "Выполнено" Тогда
		
		ВыполнитьДействие(_УФКС.СД("Журналы","клиент","/Обновить",Неопределено));
	
		СтрПараметров = Новый Структура;
		СтрПараметров.Вставить("Ключ", ПолучитьИзВременногоХранилища(РезультатВыполнения.АдресРезультата));
		
		УстановитьОтборЗаказов();
		УстановитьЗаголовокЗакладкиЗаказы();
		
		ОткрытьФорму("Справочник.CW_Заказы.ФормаОбъекта", СтрПараметров, ЭтаФорма);
		
	ИначеЕсли РезультатВыполнения.Статус = "Ошибка" Тогда
		
		ТекстПредупреждения = "Заказ не сформирован!
		| По причине: "+ РезультатВыполнения.КраткоеПредставлениеОшибки + "
		| Информаиция об ошибке см. в журнале регистрации!";
		
		Если ТипЗнч(РезультатВыполнения.Сообщения) = Тип("Массив") Тогда
			Для Каждого СообщениеВМассиве из РезультатВыполнения.Сообщения Цикл
				СообщениеВМассиве.Сообщить();
			КонецЦикла;
		КонецЕсли;
		
		ПоказатьПредупреждение(,ТекстПредупреждения,,"Ошибка создания заказа");
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПродолжитьФормированиеЗаказаНаСервереВФоне(ПараметрыПроцедуры)
	
	Если НЕ ГрузоперевозкиИнициализированы Тогда
		// инициализируем
		ВыполнитьДействиеНаСервере(_УФКС.СД("Журналы","сервер","/ИнициализацияФормы",Новый Структура("ИмяСеансовойНастройки","ПоследняяНастройкаЗаявки")));
		ВыполнитьДействиеНаСервере(_УФКС.СД("Журналы","сервер","/ИнициализацияНастроек"));
		ВыполнитьДействиеНаСервере(_УФКС.СД("Журналы","сервер","/ОбновитьДанные"));
		// --- 
		ГрузоперевозкиИнициализированы = Истина;
	КонецЕсли;  
	
	Если ЭтоАдресВременногоХранилища(ПараметрыПроцедуры.АдресВариантовБюжетаЗаявки) Тогда
		СписокВариантовБюджета = ПолучитьИзВременногоХранилища(ПараметрыПроцедуры.АдресВариантовБюжетаЗаявки);   
	КонецЕсли; 
	
	ПараметрыПроцедуры.Вставить("СписокВариантовБюджета", 		СписокВариантовБюджета); 
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(Новый УникальныйИдентификатор);
	ПараметрыВыполнения.ОжидатьЗавершение 			= 0; // запускать сразу
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = "Создание заказа по заявке";
	ПараметрыВыполнения.ЗапуститьВФоне 				= Истина;
	ПараметрыВыполнения.ЗапуститьНеВФоне 			= ложь;
	
	Возврат ДлительныеОперации.ВыполнитьВФоне("Справочники.CW_Заявки.СформироватьЗаполнитьЗаказПоЗаявке",ПараметрыПроцедуры, ПараметрыВыполнения);
		
КонецФункции
