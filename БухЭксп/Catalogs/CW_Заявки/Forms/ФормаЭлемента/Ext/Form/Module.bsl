&НаКлиенте
Процедура КонтрагентОткрытие(Элемент, СтандартнаяОбработка)
	
	Если (ПолучитьФункциональнуюОпциюФормы("CW_ИспользованиеCRM")) Тогда
		
	    // получаем настройку пользователя
		ИспользоватьСобственнуюФорму = (CW_Настройки.ПолучитьНастройкуПользователя( , "ИспользуемаяФормаКонтрагента") <> 0);
		Если (ИспользоватьСобственнуюФорму) Тогда
			
			СтандартнаяОбработка = Ложь;
			// --- 
			Если (ЗначениеЗаполнено(Объект.Контрагент)) Тогда
				ПФ = Новый Структура("ВидФормы,Ссылка","ФормаКонтрагента",Объект.Контрагент);
				ОткрытьФорму("ОбщаяФорма.CW_ФормаКонтактнойИнформации",ПФ,Элемент,Истина);	
			КонецЕсли; 
			
