КонецПроцедуры

&НаСервере
Процедура ВосстановитьПоложениеКурсора(ИмяТаблицы)   
	
	СоответствиеИмениРеквизита = ПолучитьСоответствиеИмениРеквизитаТаблице();
	
	ИмяРеквизита = СоответствиеИмениРеквизита.Получить(ИмяТаблицы);
	Если ИмяРеквизита = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекущаяСтатья = ЭтаФорма[ИмяРеквизита];  
	Если Не ЗначениеЗаполнено(ТекущаяСтатья) Тогда
		Возврат;
	КонецЕсли;
	
	Отбор = Новый Структура;
	Отбор.Вставить("СтатьяСсылка", ТекущаяСтатья);
	
	НайденныеСтроки = ЭтаФорма[ИмяТаблицы].НайтиСтроки(Отбор);
	Если НайденныеСтроки.Количество() > 0 тогда
		//по утвреждению АПС всегдаодна строка
		НайденнаяСтрока = НайденныеСтроки[0];
		Элементы[ИмяТаблицы].ТекущаяСтрока = НайденнаяСтрока.ПолучитьИдентификатор();
	КонецЕсли;
	
КонецПроцедуры


