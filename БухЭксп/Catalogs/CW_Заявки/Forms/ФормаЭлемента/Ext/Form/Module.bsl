&НаКлиенте
Перем ПараметрТекущиейСтрокиДерева;

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	//_УФС.ОтключитьИсториюВыбораЭлементовФормы(ЭтаФорма);
	// ---------------------------------------------------------------------------- 
	
	Параметры.Свойство("НеРассчитыватьСтатусыПриЗаписи", НеРассчитыватьСтатусыПриЗаписи);
	
	Если (Объект.ГруппыПараметровЗаявки.Количество()=0) Тогда
		
		НастоящийОбъект = РеквизитФормыВЗначение("Объект");
		НастоящийОбъект.ПроверитьИерархиюПараметров();
		ЗначениеВРеквизитФормы(НастоящийОбъект,"Объект");
		
	КонецЕсли; 
	
	Если Параметры.Ключ.Пустая() Тогда
		
		//Времено на переходный период
		//Для новых объектов уже используется новый механизм хранения данных
		СлужебныйВыполненПереход = Истина;
		//Времено на переходный период
		
		Объект.Ответственный = ПараметрыСеанса.ТекущийПользователь;
	КонецЕсли;   
	
	Пользователь						= CW_Настройки.Пользователь();
	НастройкиПользователя 				= CW_Настройки.ПолучитьНастройкиПользователя(Пользователь);
 	КонтролироватьПросрочкуПлановыхДат 	= НастройкиПользователя.КонтролироватьПросрочкуПлановыхДат;

	ГруппаПользователя = CW_ПраваДоступа_ПИ.ГруппаПользователя(ПараметрыСеанса.ТекущийПользователь);

	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("CW_Пользователь", 		ПараметрыСеанса.ТекущийПользователь);  
	СтруктураПараметров.Вставить("CW_ГруппаПользователя", 	ГруппаПользователя);
	
	УстановитьПараметрыФункциональныхОпцийФормы(СтруктураПараметров);
	
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("CW_Пользователь", ПараметрыСеанса.ТекущийПользователь);  
	
	Элементы.СписокЗаказыФайлы.Видимость = ПолучитьФункциональнуюОпцию("CW_ОтображатьКолонкуФайлыВСпискеЗаказы", СтруктураПараметров);
	
	ПоказыватьПриложениеВБюджете = ПолучитьФункциональнуюОпцию("CW_ВедетсяУчетПриложенийПоДоговорам") 
									И ПолучитьФункциональнуюОпцию("CW_УказыватьДоговорДляПлановыхСтатейБюджета");
									
	Элементы.БюджетДоходыПриложениеКДоговору.Видимость = ПоказыватьПриложениеВБюджете;
	Элементы.БюджетРасходыПриложениеКДоговору.Видимость = ПоказыватьПриложениеВБюджете;
	
	// кэшируем свойства параметров
	_ОбновитьСвойстваПапаметров();
	// ---
	Если (НЕ ЗначениеЗаполнено(Объект.ДатаОбращения)) Тогда
		Объект.ДатаОбращения = ТекущаяДата();		
	КонецЕсли; 
	
	// --- 
	
	Если (НЕ Параметры.ЗначениеКопирования.Пустая()) Тогда
		
		ОбъектКопирования = Параметры.ЗначениеКопирования;
		РежимКопирования = Истина;
		// --- 
		// проверяем, что у объекта копирования есть бюджеты
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		|	CW_ВариантыБюджетовПоЗаявкам.Ссылка
		|ИЗ
		|	Справочник.CW_ВариантыБюджетовПоЗаявкам КАК CW_ВариантыБюджетовПоЗаявкам
		|ГДЕ
		|	CW_ВариантыБюджетовПоЗаявкам.Владелец = &Владелец";
		Запрос.УстановитьПараметр("Владелец", ОбъектКопирования);
		ТЗ = Запрос.Выполнить().Выгрузить();
		// --- 
		Варианты = ТЗ.ВыгрузитьКолонку("Ссылка");
		
		// --- 
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	CW_ПлановыеСтатьиЗатратИДоходов.Ссылка
		               |ИЗ
		               |	Справочник.CW_ПлановыеСтатьиЗатратИДоходов КАК CW_ПлановыеСтатьиЗатратИДоходов
		               |ГДЕ
		               |	CW_ПлановыеСтатьиЗатратИДоходов.Владелец В(&Владельцы)";
		СписокВладельцев = Новый СписокЗначений;
		СписокВладельцев.ЗагрузитьЗначения(Варианты);
		Запрос.УстановитьПараметр("Владельцы", СписокВладельцев);
		ТЗ = Запрос.Выполнить().Выгрузить();
		Если (ТЗ.Количество() = 0) Тогда
			
			РежимКопирования = Ложь;
			
		КонецЕсли; 
		 
		
	КонецЕсли;
	
	// --- 
	
	ВРУ = CW_Настройки.ВалютаРегламентированногоУчета();
	// --- 
	Элементы.Маршрут.Видимость = ПолучитьФункциональнуюОпцию("CW_ИспользованиеМаршрутов");
	Элементы.Груз.Видимость = ПолучитьФункциональнуюОпцию("CW_ИспользованиеГрузов");
	// --- 
	Элементы.СтраницаБюджет.Видимость =  ПолучитьФункциональнуюОпцию("CW_ИспользованиеБюджетирования") и CW_ПраваДоступа.ПравоДоступно("ПросмотрБюджетов");
	Элементы.ВыводитьАрхивные1.Видимость = ПолучитьФункциональнуюОпцию("CW_ИспользованиеЗаказов");  

	// --- 
	БюджетТекущаяВерсия = Справочники.CW_ВерсииБюджетов.Основная;
	// --- 
	Если (НЕ Объект.Ссылка.Пустая()) Тогда
		
		_ОтборСобытий(); 
		
	КонецЕсли; 
	
	Элементы.БюджетРасходыСуммаРуб.Заголовок 		= "Сумма, "+?(ЗначениеЗаполнено(ВРУ),СокрЛП(ВРУ), "-");
	Элементы.БюджетРасходыСуммаВсегоРуб.Заголовок	= "Всего, "+?(ЗначениеЗаполнено(ВРУ),СокрЛП(ВРУ), "-");
	Элементы.БюджетДоходыСуммаРуб.Заголовок			= "Сумма, "+?(ЗначениеЗаполнено(ВРУ),СокрЛП(ВРУ), "-");
	Элементы.БюджетДоходыСуммаВсегоРуб.Заголовок	= "Всего, "+?(ЗначениеЗаполнено(ВРУ),СокрЛП(ВРУ), "-");

	// --- 
	_УправлениеЭлементамиФормы();
	// --- 
	
	// определяем количество грузоперевозок
	Если (НЕ ГрузоперевозкиИнициализированы ) Тогда
		_УстановитьЗаголовокСтраницыГрузоперевозок();
	КонецЕсли;  
	
	Если Параметры.Ключ.Пустая() Тогда
		Если ЗначениеЗаполнено(Объект.ТипПеревозки) Тогда
			_УФС.ЗаполнитьПредопределенныеЗначенияРеквизитовШапки(Объект, Объект.ТипПеревозки, "ДляЗаявки");
		КонецЕсли;
	КонецЕсли;

	//Список заказов
	УстановитьОтборЗаказов();
	УстановитьЗаголовокЗакладкиЗаказы();
	//Список заказов
	
	//Наличие прикрепленных файлов
	_УФКС.УстановитьНаличиеПрикрепленныхФайловПриСозданииФормыНаСервере(ЭтаФорма);
	//Наличие прикрепленных файлов
	
	//Подсистема.ЛогистическиеСтатусы
	Если ПолучитьФункциональнуюОпцию("CW_ИспользоватьЛогистическиеСтатусыЗаявок") Тогда
		CW_ЛогистическиеСтатусыСервер.ПриСозданииНаСервере(ЭтаФорма, Отказ, СтандартнаяОбработка);
	КонецЕсли;
	//Подсистема.ЛогистическиеСтатусы
	
	ИспользуютсяФинансовыеСтатусы 			= ПолучитьФункциональнуюОпцию("CW_ИспользоватьФинансовыеСтатусыГрузоперевозок");
	ИспользованиеФинансовыхСтатусовЗаказов 	= ПолучитьФункциональнуюОпцию("CW_ИспользоватьФинансовыеСтатусыЗаказов");

	Элементы.СписокЗаказыЛогистическийСтатусКартинка.Видимость 	= Не НастройкиПользователя.СкрыватьКартинкиСтатусовВЖурналах и ИспользуютсяФинансовыеСтатусы;
	Элементы.СписокЗаказыФинансовыйСтатусКартинка.Видимость 	= Не НастройкиПользователя.СкрыватьКартинкиФинансовыхСтатусовВЖурналах и ИспользованиеФинансовыхСтатусовЗаказов;
	//ПрогнозОплаты
	ИспользуетсяПрогнозированиеДДСПоБюджету = ПолучитьФункциональнуюОпцию("CW_ИспользуетсяПрогнозированиеДДСПоБюджету");
	//ПрогнозОплаты
	
	//РаботаСАрхивомОбъектов
	УстановитьПараметрыДинамическогОСписка();
	CW_АрхивОбъектовСервер.ПриСозданииНаСервере(ЭтаФорма);
	//РаботаСАрхивомОбъектов
	
	_Заголовок();          
	
	УстановитьЦветФонаСрокаДеййствияНаСервере();   
	
	УстаноитьВидимостьСтраниц();    
	
	//Внешние подклчюаемые команды
	CW_ПодключаемыеКомандыСервер.ПриСозданииНаСервере(ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	ВариантБюджета = ТекущийОбъект.ВариантБюджета;

	//ХранениеПолногоЗначения
	Для Каждого СтрокаОбъекта из ТекущийОбъект.ПараметрыЗаявки Цикл
		ДобавитьСохраняемоеПолноеЗначение(СтрокаОбъекта.Параметр, СтрокаОбъекта.ХранилищеДанных.Получить());
	КонецЦикла;
	//---ХранениеПолногоЗначения
	
КонецПроцедуры 

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	
	Если Не ЗавершениеРаботы Тогда
		Если ГрузоперевозкиИнициализированы Тогда
			ВыполнитьДействиеНаСервере(_УФКС.СД("Журналы","сервер","/СохранитьСеансовыеНастройки","ПоследняяНастройкаЗаявки"));	
		КонецЕсли;                    
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура УстаноитьВидимостьСтраниц()
	
	Элементы.СтраницаБюджет.Видимость = Не Объект.Ссылка.Пустая();
	Элементы.СтраницаЗаказы.Видимость = Не Объект.Ссылка.Пустая();
	Элементы.СтраницаЖурналГрузоперевозок.Видимость = Не Объект.Ссылка.Пустая();

КонецПроцедуры  

&НаСервере
Процедура УстановитьЦветФонаСрокаДеййствияНаСервере() 
	
	СрокДействия = Объект.ВариантБюджета.СрокДействия;	
	
	Если Не ЗначениеЗаполнено(СрокДействия) или СрокДействия >= НачалоДня(ТекущаяДата()) Тогда 
		Элементы.ГруппаСрокДействияВариантаБюджета.ЦветФона = Новый Цвет();	
	Иначе
		Элементы.ГруппаСрокДействияВариантаБюджета.ЦветФона = Новый Цвет(255,160,122);	
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьОтборЗаказов()
	
	СписокЗаказы.Отбор.Элементы.Очистить();
	
	ЭлементОтбора = СписокЗаказы.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение 	= Новый ПолеКомпоновкиДанных("Заявка");
	ЭлементОтбора.ВидСравнения 		= ВидСравненияКомпоновкиДанных.Равно;
	ЭлементОтбора.ПравоеЗначение 	= ?(Объект.Ссылка.Пустая(), Неопределено, Объект.Ссылка);;
	ЭлементОтбора.Использование 	= Истина;
	
	УстановитьОтборПоГруппеПользователя();
	
КонецПроцедуры

&НаСервере
Процедура _ОбновитьСвойстваПапаметров()
	// --- 
	
	КартаПравПараметров = CW_ПраваДоступа.НаборПравДляПараметров();
	АдресКартыПравПараметров = ПоместитьВоВременноеХранилище(КартаПравПараметров, ЭтаФорма.УникальныйИдентификатор);
	// --- 
	КартаСвойствПараметров = CW_Мониторинг.ПолучитьСоответствиеСвойствПараметров();
	АдресКартыСвойствПараметров = ПоместитьВоВременноеХранилище(КартаСвойствПараметров, ЭтаФорма.УникальныйИдентификатор);
	
	// --- 
КонецПроцедуры

