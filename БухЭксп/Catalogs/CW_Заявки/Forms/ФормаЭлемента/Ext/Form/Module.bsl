Процедура ОбработатьАктивизацияюСтрокиБюджетаНаСервере(ИмяТаблицы, ИдентификаторСтроки) 
	
	СоответствиеИмениРеквизита = ПолучитьСоответствиеИмениРеквизитаТаблице();
	
	ИмяРеквизита = СоответствиеИмениРеквизита.Получить(ИмяТаблицы);
	Если ИмяРеквизита = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СтрокаТекущая =	ЭтаФорма[ИмяТаблицы].НайтиПоИдентификатору(ИдентификаторСтроки);
	 
	УстановитьТекущуюСтатью(СтрокаТекущая.СтатьяСсылка, ИмяРеквизита);
	
