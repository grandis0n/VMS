			ОткрытьФорму("Справочник.CW_Грузоперевозки.Форма.ФормаЗаполненияПоТипуПеревозки",,,,,,ПОВ, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
			
		Иначе
			
			ЗаполнитьПараметрыПоТипуПеревозки(0);
			
