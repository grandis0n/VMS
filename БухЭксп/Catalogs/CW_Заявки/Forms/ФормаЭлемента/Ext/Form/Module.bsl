	ДанныеЗаполнения.ДатаСобытия = Объект.ДатаОбращения;
	ДанныеЗаполнения.ТипСобытия = Объект.ТипОбращения;
	ДанныеЗаполнения.Владелец = Объект.Контрагент;
	//ДанныеЗаполнения.КонтактноеЛицо = Объект.КонтактноеЛицо;
	ДанныеЗаполнения.Описание = Объект.Содержание;
	ДанныеЗаполнения.ОбъектСобытия = Объект.Ссылка;
	// --- 
	ПФ.Вставить("ЗначенияЗаполнения",ДанныеЗаполнения);
	Возврат(ПФ);
	
	// --- 
