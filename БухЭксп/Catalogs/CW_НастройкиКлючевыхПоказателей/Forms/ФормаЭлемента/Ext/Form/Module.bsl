
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	УстановитьСписокДоступныхМакетов();
	
	Если Параметры.Ключ.Пустая() Тогда
		УсловиеСравнения = "Равно";
		
		Если Не Параметры.ЗначениеКопирования.Пустая() Тогда
			CW_КлючевыеПоказателиСервер.ЗаполнитьТаблицуОформления(ЭтаФорма, Параметры.ЗначениеКопирования);
			ЗаполнитьТаблицуУсловногоОформления(Параметры.ЗначениеКопирования);
			УстановитьАдресНастроекКомпоновщика(Параметры.ЗначениеКопирования);
		КонецЕсли;  
	КонецЕсли;   
	
	CW_КлючевыеПоказателиСервер.ПриСозданииНаСервере(ЭтаФорма,Отказ, СтандартнаяОбработка); 
	Если ТаблицаУсловногоОформления.Количество() = 0 Тогда
		НастройкиУсловногоОформления = CW_КлючевыеПоказателиСервер.ПолучитьПустуюТаблицуУсловногоОформления();	
		ТаблицаУсловногоОформления.Загрузить(НастройкиУсловногоОформления);
	КонецЕсли;  
	
	ИспользуетсяУсловноеОформлениеЗначенияПриИзмененииНаСервере();

	УстановитьВидимостьПоказателя();
	УстановитьДоступностьОтбора();
	
	КлючевойПараметр = 1000.00;
	CW_КлючевыеПоказателиСервер.УстановитьПримерОформленияНаСервере(Элементы.КлючевойПараметрПример, ТаблицаОформления.Выгрузить()); 
	Если ИспользуетсяУсловноеОформлениеЗначения Тогда
		CW_КлючевыеПоказателиСервер.УстановитьПримерОформленияНаСервере(Элементы.КлючевойПараметрПримерУсловноеОформление, ТаблицаУсловногоОформления.Выгрузить()); 
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)  

	CW_КлючевыеПоказателиСервер.ЗаполнитьТаблицуОформления(ЭтаФорма, ТекущийОбъект);
	
 	ЗаполнитьТаблицуУсловногоОформления(ТекущийОбъект);
	УстановитьАдресНастроекКомпоновщика(ТекущийОбъект);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьАдресНастроекКомпоновщика(ТекущийОбъект)
	
	НастройкиКомпановщика = ТекущийОбъект.ХранилищеНастроек.Получить();
	АдресНастроек = ПоместитьВоВременноеХранилище(НастройкиКомпановщика, Новый УникальныйИдентификатор);
	
	ИнициализироватьКомпоновщикНастроек();

КонецПроцедуры  

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)  

	ЭлементЗначениеПараметра = КомпоновщикНастроек.Настройки.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("ВыводитьАрхивные"));
	Если ЭлементЗначениеПараметра <> Неопределено Тогда
		КомпоновщикНастроек.Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("ВыводитьАрхивные", УчитыватьАрхивные);                                                                               
	КонецЕсли;
	
	ТекущийОбъект.ХранилищеНастроек = Новый ХранилищеЗначения(КомпоновщикНастроек.ПолучитьНастройки());  
	
	CW_КлючевыеПоказателиСервер.ЗаписатьНастройкиОформления(ЭтаФорма, ТекущийОбъект);

	//НастройкиУсловногоОформления 
	Если ИспользуетсяУсловноеОформлениеЗначения Тогда
		Оформление = Новый Структура;
		
		НайденныеСтроки = ТаблицаУсловногоОформления.НайтиСтроки(Новый Структура("Выбор", Истина));
		Для Каждого СтрокаСтиля из НайденныеСтроки Цикл
			Оформление.Вставить(СтрокаСтиля.Параметр, СтрокаСтиля.Значение);
		КонецЦикла;
		
		НастройкиУсловногоОформления = Новый Структура;
		НастройкиУсловногоОформления.Вставить("Условие",	УсловиеСравнения);
		НастройкиУсловногоОформления.Вставить("Значение",	ЗначениеСравнения);
		НастройкиУсловногоОформления.Вставить("Оформление",	Оформление);
	КонецЕсли;
	
	ТекущийОбъект.НастройкиУсловногоОформления 	= Новый ХранилищеЗначения(НастройкиУсловногоОформления);
	//---НастройкиУсловногоОформления
	
КонецПроцедуры

&НаСервере
Процедура УстановитьСписокДоступныхМакетов()
	
	Элементы.ИмяМакета.СписокВыбора.Очистить();
	Элементы.ИмяМакета.СписокВыбора.Добавить("Грузоперевозки", "Грузоперевозки");
	
	Если ПолучитьФункциональнуюОпцию("CW_ИспользованиеЗаказов") Тогда
		Элементы.ИмяМакета.СписокВыбора.Добавить("Заказы", "Заказы");
	КонецЕсли;   
	
	Если ПолучитьФункциональнуюОпцию("CW_ИспользованиеЗаявок") Тогда
		Элементы.ИмяМакета.СписокВыбора.Добавить("Заявки", "Заявки");
	КонецЕсли;
	
	Если CW_ПраваДоступа.ПравоДоступно("ПросмотрФинансов_Доходы") Тогда
		Элементы.ИмяМакета.СписокВыбора.Добавить("ДебиторскаяЗадолженность", "Дебиторская задолженность");
	КонецЕсли;
	
КонецПроцедуры


&НаСервере
Процедура ЗаполнитьТаблицуУсловногоОформления(ТекущийОбъект, УстановитьУспользованиеОформления=Истина) 
	
	НастройкиУсловногоОформления = ТекущийОбъект.НастройкиУсловногоОформления.Получить(); 
	Если НастройкиУсловногоОформления = Неопределено Тогда
		Если УстановитьУспользованиеОформления Тогда
			ИспользуетсяУсловноеОформлениеЗначения = Ложь;
		КонецЕсли;
		Возврат;
	КонецЕсли;

	НоваяТаблицаОформления = CW_КлючевыеПоказателиСервер.ПолучитьПустуюТаблицуУсловногоОформления();	
	
	Если ТипЗнч(НастройкиУсловногоОформления) = Тип("Структура")
		и НастройкиУсловногоОформления.Свойство("Условие")
		и НастройкиУсловногоОформления.Свойство("Значение")
		и НастройкиУсловногоОформления.Свойство("Оформление") Тогда 
		
		УсловиеСравнения  = НастройкиУсловногоОформления.Условие;	
		ЗначениеСравнения = НастройкиУсловногоОформления.Значение;	
		
		Для каждого КлючЗначение из НастройкиУсловногоОформления.Оформление Цикл
			НайденаняСтрока = НоваяТаблицаОформления.Найти(КлючЗначение.Ключ, "Параметр");
			Если НайденаняСтрока <> Неопределено Тогда
				НайденаняСтрока.Значение = КлючЗначение.Значение;	
				НайденаняСтрока.Выбор 		= Истина;
			Конецесли;
		КонецЦикла;
	КонецЕсли;  
	
	Если УстановитьУспользованиеОформления Тогда
		ИспользуетсяУсловноеОформлениеЗначения = Истина;
	КонецЕсли;
	
	ТаблицаУсловногоОформления.Загрузить(НоваяТаблицаОформления);
	
КонецПроцедуры 

&НаКлиенте
Процедура ИмяМакетаПриИзменении(Элемент) 
	
	ИмяМакетаПриИзмененииНаСеврере();
	ИнициализироватьКомпоновщикНастроек();  
	
КонецПроцедуры

&НаСервере
Процедура ИмяМакетаПриИзмененииНаСеврере()  
	
	ПоместитьВоВременноеХранилище(Неопределено, АдресНастроек);  
	
	УстановитьВидимостьПоказателя();
	УстановитьДоступностьОтбора();

КонецПроцедуры 

&НаСервере
Процедура УстановитьДоступностьОтбора()
	
	Элементы.КомпоновщикНастроекНастройкиОтбор.Доступность = Не ПустаяСтрока(Объект.ИмяМакета);

КонецПроцедуры


&НаСервере
Процедура УстановитьВидимостьПоказателя()
	
	Элементы.ИмяПоказателя.Видимость 		= (Объект.ИмяМакета = "ДебиторскаяЗадолженность"); 
	
КонецПроцедуры

&НаСервере
Процедура ИнициализироватьКомпоновщикНастроек()    
	
	СоответствиеОбщегоМакетаПоИмени = CW_КлючевыеПоказателиСервер.ПолучитьСоответствиеИмениМакета();
	
	ИмяМакета = СоответствиеОбщегоМакетаПоИмени.Получить(Объект.ИмяМакета);
	
	Схема 		= ПолучитьОбщийМакет(ИмяМакета);
    АдресСхемы 	= ПоместитьВоВременноеХранилище(Схема, Новый УникальныйИдентификатор);

	Если ЭтоАдресВременногоХранилища(АдресНастроек) Тогда
		НастройкиКомпоновщика = ПолучитьИзВременногоХранилища(АдресНастроек);
	КонецЕсли;  
	
	Если НастройкиКомпоновщика = Неопределено Тогда
		НастройкиКомпоновщика = Схема.НастройкиПоУмолчанию;  
	КонецЕсли;
	
	КомпоновщикНастроек.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(АдресСхемы));	
	
	КомпоновщикНастроек.ЗагрузитьНастройки(НастройкиКомпоновщика);
	
	ЭлементЗначениеПараметра = КомпоновщикНастроек.Настройки.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("ВыводитьАрхивные"));
	Если ЭлементЗначениеПараметра <> Неопределено Тогда    
		УчитыватьАрхивные = ЭлементЗначениеПараметра.Значение;                                                                               
	КонецЕсли;   
	Элементы.УчитыватьАрхивные.Видимость = ЭлементЗначениеПараметра <> Неопределено; 
	
КонецПроцедуры


