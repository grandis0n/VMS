
&НаКлиенте
Процедура КомандаПродолжить(Команда)
	
	Если (НЕ ЗначениеЗаполнено(Фамилия) И НЕ ЗначениеЗаполнено(Имя) И НЕ ЗначениеЗаполнено(Отчество)) Тогда
		
		_УФК.ВывестиПредупреждение("Не заполнены данные физического лица!");
		Возврат;
		
	КонецЕсли; 
	
	Ответ = Новый Структура("Фамилия,Имя,Отчество", Фамилия, Имя, Отчество);
	ЭтаФорма.Закрыть(Ответ);
	
КонецПроцедуры
