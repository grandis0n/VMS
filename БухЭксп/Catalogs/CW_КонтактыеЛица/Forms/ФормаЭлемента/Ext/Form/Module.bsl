
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	_УФС.ОтключитьИсториюВыбораЭлементовФормы(ЭтаФорма);
	// --- 
	_УправлениеЭлементамиФормы();
	//Внешние подклчюаемые команды
	CW_ПодключаемыеКомандыСервер.ПриСозданииНаСервере(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	ОповеститьОЗаписиНового(Объект.Ссылка);
	
КонецПроцедуры

// ---------------------------------------------------------------------------- 

&НаСервере
Процедура _УправлениеЭлементамиФормы()
	// --- 
	
	Элементы.ГруппаСоздатьФизЛицо.Видимость = (Объект.ФизическоеЛицо.Пустая());
	
	// --- 
КонецПроцедуры

&НаКлиенте
Процедура СоздатьФизЛицо(Команда)
	
	РедактированиеЗапрещено  = ПроверитьРазрешения();
	
	Если Не РедактированиеЗапрещено Тогда
		ПОВ = Новый ОписаниеОповещения("ОбработкаВводаДанныхФизическогоЛица",ЭтотОбъект); 
		ОткрытьФорму("Справочник.CW_КонтактыеЛица.Форма.ФормаСозданияФизическогоЛица",,,,,,ПОВ,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	Иначе
		ПоказатьПредупреждение(, "Недостаточно прав для данного действия.");
	КонецЕсли; 
	
КонецПроцедуры

&НаСервере
Функция ПроверитьРазрешения()
	
	Возврат РегистрыСведений.CW_ДоступныеСправочникиПоГруппамПользователей.РедактированиеОбъектаЗапрещено(Тип("СправочникСсылка.ФизическиеЛица"));
	
КонецФункции

&НаКлиенте
Процедура ОбработкаВводаДанныхФизическогоЛица(Ответ, ДополнительныеПараметры ) Экспорт 
	// --- 
	
	Если (Ответ <> Неопределено) Тогда
		
		Результат = _СоздатьФизЛицо(Ответ);
		Если (НЕ _УФКС.ВыполненоУспешно(Результат)) Тогда
			
			_УФК.ВывестиПредупреждение(_УФКС.ПредставлениеОшибки(Результат));
			
		КонецЕсли; 
		_УправлениеЭлементамиФормы();
		
	КонецЕсли; 
	
	// --- 
КонецПроцедуры

&НаСервере
Функция _СоздатьФизЛицо(СтруктураФЛ)
	// --- 
	
	НФЛ = Справочники.ФизическиеЛица.СоздатьЭлемент();
	НФЛ.Наименование = ?(ЗначениеЗаполнено(СтруктураФЛ.Фамилия),СокрЛП(СтруктураФЛ.Фамилия),"")
	+?(ЗначениеЗаполнено(СтруктураФЛ.Имя)," "+СокрЛП(СтруктураФЛ.Имя),"")
	+?(ЗначениеЗаполнено(СтруктураФЛ.Отчество)," "+СокрЛП(СтруктураФЛ.Отчество),"");
	НФЛ.ФИО = НФЛ.Наименование;
	
	
	Попытка
		
		НФЛ.Записать();
		Объект.ФизическоеЛицо = НФЛ.Ссылка;
		
		УстановитьПривилегированныйРежим(Истина);
		
		Запись = РегистрыСведений.ФИОФизическихЛиц.СоздатьМенеджерЗаписи();
		// --- 
		Запись.Период = ТекущаяДата();
		Запись.ФизическоеЛицо = Объект.ФизическоеЛицо;
		Запись.Фамилия = СтруктураФЛ.Фамилия;
		Запись.Имя = СтруктураФЛ.Имя;
		Запись.Отчество = СтруктураФЛ.Отчество;
		// --- 
		Запись.Записать();
		
	Исключение
		Возврат(_УФКС.Ответ(1,ОписаниеОшибки()));
	КонецПопытки; 
	
	Возврат(_УФКС.Ответ());
	
	// --- 
КонецФункции

