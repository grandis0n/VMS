&НаКлиенте
Процедура КонтактныеЛицаПередУдалением(Элемент, Отказ)
	
	Отказ = Истина;
	Если (Элементы.КонтактныеЛица.ТекущиеДанные <> Неопределено) Тогда
		Если (Элементы.КонтактныеЛица.ТекущиеДанные.ЭтоКорень) Тогда
			Возврат;
		Иначе
			УдалитьСтрокуКонтактныхЛиц();
		КонецЕсли; 
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьСтрокуКонтактныхЛиц()
	
	Если (Элементы.КонтактныеЛица.ТекущиеДанные <> Неопределено) Тогда
		ТребуетсяПодтверждение = Ложь;
		Если (Элементы.КонтактныеЛица.ТекущиеДанные.ЭтоГруппа) Тогда
			Если (Элементы.КонтактныеЛица.ТекущиеДанные.ПолучитьЭлементы().Количество() <> 0) Тогда
				ТребуетсяПодтверждение = Истина;
			КонецЕсли; 
		КонецЕсли; 
		
		Если (ТребуетсяПодтверждение) Тогда
			ПОВ = Новый ОписаниеОповещения("ВыполнитьУдалениеКонтактногоЛица", ЭтотОбъект, Новый Структура());
			ПоказатьВопрос(ПОВ,"Удалить группу контактных лиц?",РежимДиалогаВопрос.ДаНет);
		Иначе
			ВыполнитьУдалениеКонтактногоЛица(КодВозвратаДиалога.Да,Неопределено);
		КонецЕсли; 
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьУдалениеКонтактногоЛица(Ответ, ДополнительныеПараметры) Экспорт 
	
	Если (Ответ = КодВозвратаДиалога.Да) Тогда
		РезультатУдаления = _ВыполнитьУдалениеКонтактногоЛица(Элементы.КонтактныеЛица.ТекущиеДанные.Ссылка);
		Если (_УФКС.ВыполненоУспешно(РезультатУдаления)) Тогда
			ТекущийУзел = Неопределено;
			СформироватьДерево();
		КонецЕсли; 
	КонецЕсли; 
	
КонецПроцедуры

&НаСервере
Функция _ВыполнитьУдалениеКонтактногоЛица(Ссылка)
	
	Попытка
		Если (Ссылка.ЭтоГруппа) Тогда
			Запрос = Новый Запрос;
			Запрос.Текст = "ВЫБРАТЬ
			               |	CW_КонтактыеЛица.Ссылка
			               |ИЗ
			               |	Справочник.CW_КонтактыеЛица КАК CW_КонтактыеЛица
			               |ГДЕ
			               |	CW_КонтактыеЛица.Родитель = &Родитель";
			Запрос.УстановитьПараметр("Родитель", Ссылка);
			ТЗ = Запрос.Выполнить().Выгрузить();
			Для каждого Стр Из ТЗ Цикл
				Ответ = _ВыполнитьУдалениеКонтактногоЛица(Стр.Ссылка);
				Если (НЕ _УФКС.ВыполненоУспешно(Ответ)) Тогда
					Сообщить(_УФКС.ПредставлениеОшибки(Ответ));
					Возврат(Ответ);
				КонецЕсли; 
			КонецЦикла; 
		КонецЕсли; 
		
		УстановитьПривилегированныйРежим(Истина);
		Об = Ссылка.ПолучитьОбъект();
		Об.УстановитьПометкуУдаления(Истина);
	Исключение
		Сообщить(ОписаниеОшибки());
		Возврат(_УФКС.Ответ(1));
	КонецПопытки; 
	
	Возврат(_УФКС.Ответ());
	
КонецФункции

