&НаКлиенте
Процедура КонтактныеЛицаПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	Отказ = Истина;
	Если (Элементы.КонтактныеЛица.ТекущиеДанные <> Неопределено) Тогда
		Если (Элементы.КонтактныеЛица.ТекущиеДанные.ЭтоГруппа) Тогда
			Родитель = Элементы.КонтактныеЛица.ТекущиеДанные.Ссылка;
		Иначе
			Родитель = Неопределено;
		КонецЕсли; 
	Иначе
		Родитель = Неопределено;
	КонецЕсли; 
	
	Если (Группа) Тогда
		ПФ = Новый Структура("ЗначенияЗаполнения,ЭтоГруппа,Родитель", Новый Структура("Владелец,Родитель", Контрагент, Родитель), Ложь, Родитель);
		ОткрытьФорму("Справочник.CW_КонтактыеЛица.ФормаГруппы", ПФ, Элемент);
	Иначе
		ПФ = Новый Структура("ЗначенияЗаполнения,ЭтоГруппа,Родитель", Новый Структура("Владелец,Родитель", Контрагент, Родитель), Ложь, Родитель);
		ОткрытьФорму("Справочник.CW_КонтактыеЛица.ФормаОбъекта", ПФ, Элемент);
	КонецЕсли; 
	
КонецПроцедуры

