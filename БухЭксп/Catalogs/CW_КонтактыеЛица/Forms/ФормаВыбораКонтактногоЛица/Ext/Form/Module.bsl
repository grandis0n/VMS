&НаКлиенте
Процедура СохранитьВидДерева()
	
	СостояниеДерева.Очистить();
	КореньДерева = Неопределено;
	СтрокиДерева = КонтактныеЛица.ПолучитьЭлементы();
	Если (СтрокиДерева.Количество() <> 0) Тогда
		ОпределитьСтатусУзла(СтрокиДерева[0]);
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Функция ОпределитьСтатусУзла(Узел)
	
	Если (Узел.ЭтоГруппа) Тогда
		Идентификатор = Узел.ПолучитьИдентификатор();
		Если (Идентификатор <> Неопределено) Тогда
			Развернут = Элементы.КонтактныеЛица.Развернут(Идентификатор);
			Если (Развернут <> Неопределено) Тогда
				СостояниеДерева.Добавить(Узел.Ссылка,,Развернут);
				Для каждого ПУ Из Узел.ПолучитьЭлементы() Цикл
					ОпределитьСтатусУзла(ПУ);
				КонецЦикла; 
			КонецЕсли; 
		КонецЕсли; 
	КонецЕсли; 
	
КонецФункции
  
