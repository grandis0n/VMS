&НаКлиенте
Процедура КонтактныеЛицаПеретаскивание(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Строка, Поле)
	
	СтандартнаяОбработка = Ложь;
	
	Если (ТипЗнч(ПараметрыПеретаскивания.Значение) = Тип("Массив")) Тогда
		ПеретаскиваемаяСтрока = ПараметрыПеретаскивания.Значение[0];
		Если (ТипЗнч(ПеретаскиваемаяСтрока) = Тип("Число")) Тогда
			_УстановитьРодителя(ПеретаскиваемаяСтрока, Строка);
			СформироватьДерево();
		КонецЕсли; 
	КонецЕсли; 
	
КонецПроцедуры

&НаСервере
Процедура _УстановитьРодителя(ИдентификаторЭлемента, ИдентификаторГруппы)
	
	СтрокаЭлемента = КонтактныеЛица.НайтиПоИдентификатору(ИдентификаторЭлемента);
	СтрокаГруппы = КонтактныеЛица.НайтиПоИдентификатору(ИдентификаторГруппы);
	
	ТекущийУзел = СтрокаЭлемента.Ссылка;
	ТекущийРодительУзла = СтрокаГруппы.Ссылка;
	
	Если (СтрокаГруппы.ЭтоГруппа) Тогда
		Элемент = СтрокаЭлемента.Ссылка.ПолучитьОбъект();
		Элемент.Родитель = СтрокаГруппы.Ссылка;
		Элемент.Записать();
	КонецЕсли; 
	
КонецПроцедуры

