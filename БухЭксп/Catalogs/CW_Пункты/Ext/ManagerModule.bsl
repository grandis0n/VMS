
Функция ВыполнитьКонвертациюАдресов() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	CW_Пункты.Ссылка КАК Ссылка,
	|	CW_Пункты.Адрес КАК Адрес
	|ИЗ
	|	Справочник.CW_Пункты КАК CW_Пункты
	|ГДЕ
	|	CW_Пункты.ПометкаУдаления = ЛОЖЬ";   
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл  
		
		Если ПустаяСтрока(Выборка.Адрес) Тогда
			Продолжить;
		КонецЕсли;
		
		ДанныеАдреса = РаботаСАдресами.РазложитьПредставлениеАдресаПоПолям(Выборка.Адрес);
		
		КонтактнаяИнформацияАдреса = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияВXML(
			ДанныеАдреса,
			Выборка.Адрес,
			ПредопределенноеЗначение("Перечисление.ТипыКонтактнойИнформации.Адрес"));
		
		СтруктураПараметров = Новый Структура("БезПредставлений, ПроверитьАдрес, КодыАдреса", Ложь, Истина, Истина);
		СтруктураАдреса = РаботаСАдресами.СведенияОбАдресе(КонтактнаяИнформацияАдреса, СтруктураПараметров);
		
		ПунктОбъект = Выборка.Ссылка.ПолучитьОбъект();
		ПунктОбъект.Адрес 					= СтруктураАдреса.Представление;
		ПунктОбъект.КонтактнаяИнформация 	= КонтактнаяИнформацияАдреса;
		ПунктОбъект.Записать();
		
	КонецЦикла;
	
КонецФункции