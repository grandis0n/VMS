#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

//Подсистема.ДополнительныеХарактиристикиДоговоров
Функция ПолучитьСписокПараметров(Шаблон) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст ="ВЫБРАТЬ
	              |	CW_ШаблоныДоговоровДополнительныеХарактеристики.Параметр КАК Параметр,
	              |	CW_ШаблоныДоговоровДополнительныеХарактеристики.Значение КАК Значение,
	              |	CW_ШаблоныДоговоровДополнительныеХарактеристики.ИндексКартинки КАК ИндексКартинки,
	              |	CW_ШаблоныДоговоровДополнительныеХарактеристики.ОграниченСпискомЗначений КАК ОграниченСпискомЗначений
	              |ИЗ
	              |	Справочник.CW_ШаблоныДоговоров.ДополнительныеХарактеристики КАК CW_ШаблоныДоговоровДополнительныеХарактеристики
	              |ГДЕ
	              |	CW_ШаблоныДоговоровДополнительныеХарактеристики.Ссылка = &Шаблон";
	
	Запрос.УстановитьПараметр("Шаблон", Шаблон);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат  РезультатЗапроса.Выгрузить();
	
КонецФункции
//Подсистема.ДополнительныеХарактиристикиДоговоров


//Служебные процедуры
Процедура ОбработатьСписокПараметровШаблонов() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	CW_ШаблоныДоговоров.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.CW_ШаблоныДоговоров КАК CW_ШаблоныДоговоров";
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		ШаблонОбъект = Выборка.Ссылка.ПолучитьОбъект();
		
		Для Каждого СтрокаШаблона из  ШаблонОбъект.ДополнительныеХарактеристики Цикл
			Если НЕ ЗначениеЗаполнено(СтрокаШаблона.Параметр) Тогда
				Продолжить;
			КонецЕсли;
			
			CW_ДополнительныеХарактиристикиДоговоровСервер.ОбработатьДанныеСтроки(СтрокаШаблона);
		КонецЦикла;
		
		ШаблонОбъект.Записать();
		
	КонецЦикла;
	
КонецПроцедуры


//Служебные процедуры
#КонецЕсли
