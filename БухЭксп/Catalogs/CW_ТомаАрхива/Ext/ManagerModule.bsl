
Функция ПолучитьОсновнойТомХранения() Экспорт 
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;                     
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	|	ТомаАрхива.Ссылка
	|ИЗ
	|	Справочник.CW_ТомаАрхива КАК ТомаАрхива
	|ГДЕ
	|	ТомаАрхива.Основной = ИСТИНА";   
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;  
	
	Возврат ПредопределенноеЗначение("Справочник.CW_ТомаАрхива.ПустаяСсылка");
	
КонецФункции