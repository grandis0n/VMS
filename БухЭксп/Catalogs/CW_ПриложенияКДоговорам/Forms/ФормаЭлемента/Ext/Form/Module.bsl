&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	//Подсистема.ГруппыУслугПриложенийИДоговоров
	CW_ГруппыУслугСервер.ПослеЗаписиНаСервере(ЭтаФорма, ТекущийОбъект, ПараметрыЗаписи);
	//Подсистема.ГруппыУслугПриложенийИДоговоров
	
	//Подсистема.СтатусыДокументов
	CW_СтатусыДокументовСервер.ПослеЗаписиНаСервере(ЭтаФорма, ТекущийОбъект, ПараметрыЗаписи);
	//Подсистема.СтатусыДокументов
	
	//Подсистема.ДополнительныеХарактиристикиДоговоров
	CW_ДополнительныеХарактиристикиДоговоровСервер.ПослеЗаписиНаСервере(ЭтаФорма, ТекущийОбъект, ПараметрыЗаписи);
	//Подсистема.ДополнительныеХарактиристикиДоговоров
	
	//Подсистема.УчетПриложенийДоговоров
	CW_УчетПриложенийДоговоровСервер.ПослеЗаписиНаСервере(ЭтаФорма, ТекущийОбъект, ПараметрыЗаписи);
	//Подсистема.УчетПриложенийДоговоров
	
	//Подсистема.ОригиналыДокументов
	CW_ОригиналыДокументовСервер.ПослеЗаписиНаСервере(ЭтаФорма, ТекущийОбъект, ПараметрыЗаписи);
	//Подсистема.ОригиналыДокументов

	УстановитьОтборДинамическихСписков();
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)

	Если Объект.БухгалтерскийУчет Тогда
		Если Объект.УчетныйДоговор.Пустая() Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не выбран учетный дооговор",,"УчетныйДоговор","Объект", Отказ);
		КонецЕсли;
	КонецЕсли;
	
	//Подсистема.СтатусыДокументов
	CW_СтатусыДокументовСервер.ПередЗаписьюНаСервере(ЭтаФорма, Отказ, ТекущийОбъект, ПараметрыЗаписи);
	//Подсистема.СтатусыДокументов
	
	//Подсистема.ДополнительныеХарактиристикиДоговоров
	CW_ДополнительныеХарактиристикиДоговоровСервер.ПередЗаписьюНаСервере(ЭтаФорма, Отказ);
	//Подсистема.ДополнительныеХарактиристикиДоговоров
	
КонецПроцедуры


&НаСервере
Процедура УстановитьОтборДинамическихСписков()
	
	//ДокументыПоПриложению
	ДокументыПоПриложению.Отбор.Элементы.Очистить();
	
	ЭлементОтбора = ДокументыПоПриложению.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение 	= Новый ПолеКомпоновкиДанных("ПриложениеКДоговору");
	ЭлементОтбора.ВидСравнения 		= ВидСравненияКомпоновкиДанных.Равно;
	ЭлементОтбора.ПравоеЗначение 	= Объект.Ссылка;
	ЭлементОтбора.Использование 	= Истина;
	
	ЭлементОтбора = ДокументыПоПриложению.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение 	= Новый ПолеКомпоновкиДанных("УказаноПриложение");
	ЭлементОтбора.ВидСравнения 		= ВидСравненияКомпоновкиДанных.Равно;
	ЭлементОтбора.ПравоеЗначение 	= Истина;
	ЭлементОтбора.Использование 	= Истина;
	//ДокументыПоПриложению

	//ПараметрыДоговора
	ПараметрыДоговора.Отбор.Элементы.Очистить();
	
	ЭлементОтбора = ПараметрыДоговора.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Договор");
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ЭлементОтбора.ПравоеЗначение = Объект.Ссылка;
	ЭлементОтбора.Использование = Истина;
	//ПараметрыДоговора
	
	
	//ШаблоныУслуг
	ШаблоныУслуг.Отбор.Элементы.Очистить();
	
	ЭлементОтбора = ШаблоныУслуг.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение 	= Новый ПолеКомпоновкиДанных("Договор");
	ЭлементОтбора.ВидСравнения 		= ВидСравненияКомпоновкиДанных.Равно;
	ЭлементОтбора.ПравоеЗначение 	= Объект.Договор;
	ЭлементОтбора.Использование 	= Истина;
	
	ЭлементОтбора = ШаблоныУслуг.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение 	= Новый ПолеКомпоновкиДанных("ПриложениеКДоговору");
	ЭлементОтбора.ВидСравнения 		= ВидСравненияКомпоновкиДанных.Равно;
	ЭлементОтбора.ПравоеЗначение 	= Объект.Ссылка;
	ЭлементОтбора.Использование 	= Истина;
	
	Если Объект.Договор.ВерсияДанных= ПредопределенноеЗначение("Перечисление.ВидыДоговоровКонтрагентов.СПоставщиком") Тогда
		
		ЭлементОтбора = ШаблоныУслуг.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение 	= Новый ПолеКомпоновкиДанных("РасходнаяСтатья");
		ЭлементОтбора.ВидСравнения 		= ВидСравненияКомпоновкиДанных.Равно;
		ЭлементОтбора.ПравоеЗначение 	= Истина;
		ЭлементОтбора.Использование 	= Истина;
		
	Иначе
		ЭлементОтбора = ШаблоныУслуг.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение 	= Новый ПолеКомпоновкиДанных("ДоходнаяСтатья");
		ЭлементОтбора.ВидСравнения 		= ВидСравненияКомпоновкиДанных.Равно;
		ЭлементОтбора.ПравоеЗначение 	= Истина;
		ЭлементОтбора.Использование 	= Истина;
		
	КонецЕсли; 
	
КонецПроцедуры


&НаКлиенте
Процедура РедактироватьНаименованиеПриИзменении(Элемент)
	
	Элементы.Наименование.ТолькоПросмотр = Ложь;
	
	Объект.РедактироватьНаименование 		= СпособРедактированияНаименования = 1;
	Элементы.Наименование.ТолькоПросмотр 	= СпособРедактированияНаименования = 0;
	
	Если НЕ Объект.РедактироватьНаименование Тогда
		
		// формируем стандартное наименование
		УстановитьПредставление();
		
	КонецЕсли; 

	
КонецПроцедуры


&НаКлиенте
Процедура ВидДокументаПриИзменении(Элемент)
	УстановитьПредставление();
КонецПроцедуры

&НаКлиенте
Процедура НомерДокументаПриИзменении(Элемент)
	УстановитьПредставление();
КонецПроцедуры

&НаКлиенте
Процедура ДатаДокументаПриИзменении(Элемент)
	
	УстановитьПредставление();
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ЕстьАвтоматическаяНумерацияПриложений()
	Возврат  ПолучитьФункциональнуюОпцию("CW_АвтоматическаяНумерацияПриложенийКДоговорамСПокупателями");
КонецФункции


&НаКлиенте 
Процедура УстановитьПредставление()
	
	Если СпособРедактированияНаименования = 1 Тогда
		Возврат;
	КонецЕсли;
	
	ВидДокумента 	= ПолучитьКраткоеНаименование(Объект.ВидДокумента);
	Номер 			= ?(ЗначениеЗаполнено(Объект.НомерДокумента), " №" + СокрЛП(Объект.НомерДокумента), "");
	Дата 			= ?(ЗначениеЗаполнено(Объект.ДатаДокумента), " от "+ Формат(Объект.ДатаДокумента,"ДФ=dd.MM.yyyy"), "");
	
	ШаблонПредставления = "[ВидДокумента][Номер][Дата]";
	
	СтрПредставление = СтрЗаменить(ШаблонПредставления, "[ВидДокумента]", ВидДокумента);
	СтрПредставление = СтрЗаменить(СтрПредставление, "[Номер]", Номер);
	СтрПредставление = СтрЗаменить(СтрПредставление, "[Дата]", Дата);
	
	Объект.Наименование = СтрПредставление;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьКраткоеНаименование(ВидДокумента)
	
	Возврат СокрЛП(ВидДокумента.КраткоеНаименование);
	
КонецФункции

//ШаблонДоговоров
&НаКлиенте
Процедура ЗаполнитьПараметрыПоШаблону(Команда)
	
	ОткрытьФормуВыбораВариантаЗаполнения();
	
КонецПроцедуры

&НаКлиенте
Процедура ШаблонДоговораПриИзменении(Элемент)
	
	Если ЗначениеЗаполнено(Объект.ШаблонДоговора) Тогда
		
		ДанныеЗаполнения = новый Структура;
		
		//Подсистема.ДополнительныеХарактиристикиДоговоров
		CW_ДополнительныеХарактиристикиДоговоровСервер.ТребуетсяЗаполнениеДополнительныхХарактеристик(ДанныеЗаполнения);
		Если ДанныеЗаполнения.Свойство("ЗаполнитьДополнительныеХарактеристики") Тогда
			ЗаполнитьДополнительныеХарактеристики = ДанныеЗаполнения.ЗаполнитьДополнительныеХарактеристики;
		КонецЕсли;
		//Подсистема.ДополнительныеХарактиристикиДоговоров
		
		Если ЗаполнитьДополнительныеХарактеристики и ДополнительныеХарактеристики.Количество() > 0 Тогда
			
			Режим = РежимДиалогаВопрос.ДаНет;
			
			Оповещение = Новый ОписаниеОповещения("ОбработкаСменыШаблона", ЭтотОбъект);
			ПоказатьВопрос(Оповещение, "Заполнить свойства договора по шаблону?", Режим, 0);

		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаСменыШаблона(Результат, Параметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Нет Тогда
        Возврат;
	КонецЕсли;
	
	ОткрытьФормуВыбораВариантаЗаполнения();
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуВыбораВариантаЗаполнения()
	
	ОписаниеОпвещения = Новый ОписаниеОповещения("ОбработатьВыборВариантаЗаполнения", ЭтотОбъект);
	ОткрытьФорму("ОбщаяФорма.CW_ВыборВариантаЗаполненияПараметровПоШаблону",,ЭтаФорма,,,,ОписаниеОпвещения,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьВыборВариантаЗаполнения(Ответ, Параметры) Экспорт
	
	Если Ответ = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	//Подсистема.ДополнительныеХарактиристикиДоговоров
	ОбработатьВыборВариантаЗаполеннияПараметровНаСервере(Ответ.ВариантПерезаполнить);
	//Подсистема.ДополнительныеХарактиристикиДоговоров
	
КонецПроцедуры
//ШаблонДоговоров


//Подсистема.СтатусыДокументов
&НаКлиенте
Процедура СтатусДокументаИзменить(Команда)
	
	CW_СтатусыДокументовКлиент.ОткрытьФормуРедактированияСтатуса(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьИзменениеДанныхСтатуса(Результат, ДополнительныеПараметры) Экспорт
	
	CW_СтатусыДокументовКлиент.ОбработатьИзменениеДанныхСтатуса(ЭтаФорма, Результат);
	
КонецПроцедуры

