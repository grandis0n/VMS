&НаКлиенте
Процедура СоздатьУчетныйДоговор(Команда)
	
	
	Если НЕ Объект.УчетныйДоговор.Пустая() Тогда
		ПоказатьПредупреждение(, "Учетный договор уже создан!",30,"Создание учетного договора");
		Возврат;
	КонецЕсли; 
	
	// проверяем заполненные поля
	Отказ = Ложь;
	Если Объект.Договор.Пустая() Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Отсутствует основной договор!",,"ОбъектВладелец", "ЭтотОбъект", Отказ);
	КонецЕсли; 
	Если ПустаяСтрока(Объект.НомерДокумента)Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Не указана номер приложения",,"НомерДокумента", "ЭтотОбъект", Отказ);
	КонецЕсли;
	
	Если ПустаяСтрока(Объект.ДатаДокумента)Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Не указана дата приложения",,"ДатаДокумента", "ЭтотОбъект", Отказ);
	КонецЕсли;
	
	Если Не Отказ Тогда
		СоздатьУчетныйДоговорНаСервере();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура СоздатьУчетныйДоговорНаСервере()
	
	УчетныйДоговор = Справочники.ДоговорыКонтрагентов.ПустаяСсылка();
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	CW_ДоговорыПоГрузоперевозкам.Владелец КАК Владелец,
	               |	CW_ДоговорыПоГрузоперевозкам.Организация КАК Организация,
	               |	CW_ДоговорыПоГрузоперевозкам.ВидДоговора КАК ВидДоговора
	               |ИЗ
	               |	Справочник.CW_ДоговорыПоГрузоперевозкам КАК CW_ДоговорыПоГрузоперевозкам
	               |ГДЕ
	               |	CW_ДоговорыПоГрузоперевозкам.Ссылка = &Договор";
	
	Запрос.УстановитьПараметр("Договор", Объект.Договор);
	
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаОсновнойДоговор = РезультатЗапроса.Выбрать();
	ВыборкаОсновнойДоговор.Следующий();
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	ДоговорыКонтрагентов.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
	               |ГДЕ
	               |	ДоговорыКонтрагентов.Организация = &Организация
	               |	И ДоговорыКонтрагентов.Номер = &Номер
	               |	И ДоговорыКонтрагентов.Дата = &Дата
	               |	И ДоговорыКонтрагентов.Владелец = &Владелец
	               |	И ДоговорыКонтрагентов.ВидДоговора = &ВидДоговора
	               |	И ДоговорыКонтрагентов.ВалютаВзаиморасчетов = &ВалютаВзаиморасчетов
	               |	И ДоговорыКонтрагентов.РасчетыВУсловныхЕдиницах = &РасчетыВУсловныхЕдиницах";
	
	Запрос.УстановитьПараметр("Номер",	Объект.НомерДокумента);
	Запрос.УстановитьПараметр("Дата",	Объект.ДатаДокумента);
	Запрос.УстановитьПараметр("ВалютаВзаиморасчетов", 		Объект.ВалютаДоговора);
	Запрос.УстановитьПараметр("РасчетыВУсловныхЕдиницах",	Объект.ВзаиморасчетыВУЕ);
	
	Запрос.УстановитьПараметр("Организация", 	ВыборкаОсновнойДоговор.Организация);
	Запрос.УстановитьПараметр("Владелец",		ВыборкаОсновнойДоговор.Владелец);
	Запрос.УстановитьПараметр("ВидДоговора",	ВыборкаОсновнойДоговор.ВидДоговора);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	Если Выборка.Следующий() Тогда
		УчетныйДоговор = Выборка.Ссылка; 	
	КонецЕсли;
	
	Если УчетныйДоговор.Пустая() Тогда
		
		Договор = Справочники.ДоговорыКонтрагентов.СоздатьЭлемент();
		Договор.Наименование 	= Объект.Наименование+" ("+Объект.Договор.Наименование+")";
		Договор.Владелец 		= ВыборкаОсновнойДоговор.Владелец;
		Договор.Организация 	= ВыборкаОсновнойДоговор.Организация;
		Договор.ВидДоговора 	= ВыборкаОсновнойДоговор.ВидДоговора;
		
		Договор.Номер	= Объект.НомерДокумента;
		Договор.Дата	= Объект.ДатаДокумента;
		Договор.ВалютаВзаиморасчетов 	 = Объект.ВалютаДоговора;
		Договор.РасчетыВУсловныхЕдиницах = Объект.ВзаиморасчетыВУЕ;
		
		Договор.СпособЗаполненияСтавкиНДС 	= ПредопределенноеЗначение("Перечисление.СпособыЗаполненияСтавкиНДС.Автоматически");
		Договор.СпособВыставленияДокументов = ПредопределенноеЗначение("Перечисление.СпособыВыставленияДокументов.Автоматически");
		
		Договор.Записать();
		
		УчетныйДоговор = Договор.Ссылка;	
		
		ТекущийУчетныйДоговор = Договор.Ссылка;
		
	КонецЕсли; 
	
	Объект.УчетныйДоговор = УчетныйДоговор;	
	ТекущийУчетныйДоговор = УчетныйДоговор;
	
КонецПроцедуры

&НаКлиенте
Процедура НадписьСлужебныеДоговораНажатие(Элемент)
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("АгентскийДоговорНаЗакупку", Объект.АгентскийДоговорНаЗакупку);
	СтруктураПараметров.Вставить("АгентскийДоговорНаПродажу", Объект.АгентскийДоговорНаПродажу);
	СтруктураПараметров.Вставить("ДоговорДляВыявленияФинансовогоРезультата", Объект.ДоговорДляВыявленияФинансовогоРезультата);
	
	ОписаниеОпвещения = Новый ОписаниеОповещения("ОбработатьИзменениеСлужебныхДоговоров", ЭтотОбъект);
	
	ОткрытьФорму("ОбщаяФорма.CW_СлужебныеДоговора", СтруктураПараметров, ЭтаФорма,,,, ОписаниеОпвещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

&НаКлиенте
Процедура ОбработатьИзменениеСлужебныхДоговоров(Результат, Параметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Объект.АгентскийДоговорНаЗакупку <>  Результат.АгентскийДоговорНаЗакупку Тогда
		Объект.АгентскийДоговорНаЗакупку = Результат.АгентскийДоговорНаЗакупку;
		Модифицированность = Истина;
	КонецЕсли;
	
	Если Объект.АгентскийДоговорНаПродажу <>  Результат.АгентскийДоговорНаПродажу Тогда
		Объект.АгентскийДоговорНаПродажу = Результат.АгентскийДоговорНаПродажу;
		Модифицированность = Истина;
	КонецЕсли;
	Если Объект.ДоговорДляВыявленияФинансовогоРезультата <>  Результат.ДоговорДляВыявленияФинансовогоРезультата Тогда
		Объект.ДоговорДляВыявленияФинансовогоРезультата = Результат.ДоговорДляВыявленияФинансовогоРезультата;
		Модифицированность = Истина;
	КонецЕсли;
	
КонецПроцедуры


&НаКлиенте
Процедура БухгалтерскийУчетПриИзменении(Элемент)
	
	// при наличии проведенных документов по договору изменять признак не даем
	Если Не Объект.БухгалтерскийУчет Тогда
		Если ЕстьПроведенныеДокументыПоДоговору() Тогда 
			Объект.БухгалтерскийУчет = НЕ Объект.БухгалтерскийУчет;
			ПоказатьПредупреждение(	, "По приложению есть проведённые документы. 
			|Изменять признак ведения бухгалтерского учёта запрещено!"	);
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	_БухгалтерскийУчетПриИзменении();
	
КонецПроцедуры

&НаСервере
Функция _БухгалтерскийУчетПриИзменении()
	
	Если (НЕ Объект.БухгалтерскийУчет) Тогда
		//Объект.УчетныйДоговор = Неопределено;
	КонецЕсли; 
	
	_УправлениеЭлементамиФормы();
КонецФункции


&НаСервере
Процедура _УправлениеЭлементамиФормы()
	
	Элементы.ГруппаУчетныйДоговор.Видимость	= Объект.БухгалтерскийУчет;
	
КонецПроцедуры


&НаСервере
Функция ЕстьПроведенныеДокументыПоДоговору()
	
	ЕстьДокументы = Ложь;
	
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
		|	CW_ДокументыПоДоговорамИПриложениям.Ссылка КАК Ссылка
		|ИЗ
		|	КритерийОтбора.CW_ДокументыПоДоговорамИПриложениям(&Договор) КАК CW_ДокументыПоДоговорамИПриложениям
		|ГДЕ
		|	CW_ДокументыПоДоговорамИПриложениям.Ссылка.Проведен = ИСТИНА";
		
		Запрос.УстановитьПараметр("Договор", Объект.Ссылка);
		
		РезультатЗапроса = Запрос.Выполнить();
		ЕстьДокументы = НЕ РезультатЗапроса.Пустой();	
		
	КонецЕсли;
	
	Возврат ЕстьДокументы;
	
КонецФункции


&НаКлиенте
Процедура ЗаполнитьГрупппыУслугИзПриложения(Команда)
	
	Если Объект.Ссылка.Пустая() тогда
		ПоказатьПредупреждение(,"Необходимо записать приложение!");
		Возврат;
	КонецЕсли;
	
	Режим = РежимДиалогаВопрос.ДаНет;
	Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаКопированияГруппУслуг", ЭтотОбъект);
	ПоказатьВопрос(Оповещение, "Группы услуг будут скопированы из выбранного приложения. Продолжить?", Режим, 0);	
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияВопросаКопированияГруппУслуг(Результат, Параметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Нет Тогда
        Возврат;
    КонецЕсли;

	Оповещение = Новый ОписаниеОповещения("ПродолжитьКопированиеГруппУслуг",ЭтотОбъект);
	
	ПараметрыФормыВыбора = новый Структура;
	ПараметрыФормыВыбора.Вставить("РежимВыбора", Истина);
	ПараметрыФормыВыбора.Вставить("МножественыйВыбор", Ложь);
	ПараметрыФормыВыбора.Вставить("ЗакрыватьПриВыборе", Истина);
	
	ОткрытьФорму("Справочник.CW_ПриложенияКДоговорам.ФормаВыбора", ПараметрыФормыВыбора, ЭтаФорма,,,,Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ПродолжитьКопированиеГруппУслуг(ВыбранноеЗначение, Параметры) Экспорт

	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	РезультатВыполнения =  ПродолжитьКопированиеГруппУслугВФоне(ВыбранноеЗначение);
	
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ВыводитьОкноОжидания = Истина;
	ОповещениеОЗавершении = Новый ОписаниеОповещения("ОбработатьРезультатКопированияГруппУслуг", ЭтотОбъект);
	
	ДлительныеОперацииКлиент.ОжидатьЗавершение(РезультатВыполнения, ОповещениеОЗавершении, ПараметрыОжидания);

КонецПроцедуры

&НаСервере
Функция ПродолжитьКопированиеГруппУслугВФоне(ЗначениеКопирования)
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(Новый УникальныйИдентификатор);
	ПараметрыВыполнения.ОжидатьЗавершение 			= 0; // запускать сразу
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = "Копирование групп услуг приложения к договору";
	ПараметрыВыполнения.ЗапуститьВФоне 				= Истина;
	ПараметрыВыполнения.ЗапуститьНеВФоне 			= ложь;
	
	ПараметрыПроцедуры = Новый Структура;
	ПараметрыПроцедуры.Вставить("ТекущийОбъект", 		Объект.Ссылка);
	ПараметрыПроцедуры.Вставить("ЗначениеКопирования", 	ЗначениеКопирования);
	
	Возврат ДлительныеОперации.ВыполнитьВФоне("РегистрыСведений.CW_ХарактеристикиГруппУслуг.СкопироватьДатыОказанияГруппУслуг",ПараметрыПроцедуры, ПараметрыВыполнения);
	
КонецФункции

&НаКлиенте
Процедура ОбработатьРезультатКопированияГруппУслуг(РезультатВыполнения, Дополнительныепараметры) Экспорт
	
	Если РезультатВыполнения.Статус = "Выполнено" Тогда
		
		Элементы.ГруппыУслуг.Обновить();
		ПоказатьОповещениеПользователя("Группы услуг заполнены");
		
	ИначеЕсли РезультатВыполнения.Статус = "Ошибка" Тогда
		
		ТекстПредупреждения = "Группы услуг не скопированы!
		| По причине: "+ РезультатВыполнения.КраткоеПредставлениеОшибки + "
		| Информаиция об ошибке см. в журнале регистрации!";
		
		Если ТипЗнч(РезультатВыполнения.Сообщения) = Тип("Массив") Тогда
			Для Каждого СообщениеВМассиве из РезультатВыполнения.Сообщения Цикл
				СообщениеВМассиве.Сообщить();
			КонецЦикла;
		КонецЕсли;
		
		ПоказатьПредупреждение(,ТекстПредупреждения,,"Ошибка копирования групп услуг");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаНачалаВеденияБухгалтерскогоУчетаНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Режим = РежимДиалогаВопрос.ДаНет;
	Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаОбИзмененииДатыБухгалтескогоУчета", ЭтотОбъект, Параметры);
	ПоказатьВопрос(Оповещение, "Документы до даты начала ведения бухгалтерского учета не будут формировать связанных документов бухгалтерского учета. Продолжить?", Режим, 0);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияВопросаОбИзмененииДатыБухгалтескогоУчета(Результат, Параметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Нет Тогда
        Возврат;
	КонецЕсли;
	
	Подсказка = "Введите дату";
	ЧастьДаты = ЧастиДаты.Дата;
	Оповещение = Новый ОписаниеОповещения("ПослеВводаДатыДатыБухгалтескогоУчета", ЭтотОбъект, Параметры);
	ПоказатьВводДаты(Оповещение, ТекущаяДата(), Подсказка, ЧастьДаты);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВводаДатыДатыБухгалтескогоУчета(НоваяДата, Параметры) Экспорт
	
	Если НоваяДата = Неопределено Тогда
        Возврат;
	КонецЕсли;
	
	Объект.ДатаНачалаВеденияБухгалтерскогоУчета = НоваяДата;
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриложенияДоговораПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	Отказ = Истина;
	
	ЗначенияЗаполнения = Новый Структура;
	ЗначенияЗаполнения.Вставить("Договор", Объект.Договор);
	ЗначенияЗаполнения.Вставить("Родитель", Объект.Ссылка);
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("ЗначенияЗаполнения", ЗначенияЗаполнения);
	
	ОткрытьФорму("Справочник.CW_ПриложенияКДоговорам.ФормаОбъекта", СтруктураПараметров,ЭтаФорма);
	
КонецПроцедуры


