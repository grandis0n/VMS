#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)

	Ответственный = ПараметрыСеанса.ТекущийПользователь;
	ДатаСоздания = ТекущаяДата();

КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	// проверяем, есть ли по договору действующие параметры
	// если нет - создаем на дату договора
	Если ДатаДокумента = Дата(1,1,1) Тогда
		Возврат;
	КонецЕсли; 
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	CW_ПараметрыДоговоров.Договор
	               |ИЗ
	               |	РегистрСведений.CW_ПараметрыДоговоров КАК CW_ПараметрыДоговоров
	               |ГДЕ
	               |	CW_ПараметрыДоговоров.Договор = &ПриложениеДоговора";
	
	Запрос.УстановитьПараметр("ПриложениеДоговора", Ссылка); 
	
	РезультатЗапроса = Запрос.Выполнить();
	
	// параметров не нашли, создаем новые датой договора
	Если РезультатЗапроса.Пустой() Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ *
		|ИЗ
		|	РегистрСведений.CW_ПараметрыДоговоров.СрезПоследних(&ДатаСреза, Договор = &Договор) КАК CW_ПараметрыДоговоров";
		
		Если Не ЗначениеЗаполнено(Родитель) Тогда
			Запрос.УстановитьПараметр("Договор", Договор); 
		Иначе
			Запрос.УстановитьПараметр("Договор", Родитель); 
		КонецЕсли;
		
		Запрос.УстановитьПараметр("ДатаСреза", ДатаДокумента); 
		
		РезультатЗапроса = Запрос.Выполнить();
	    Выборка = РезультатЗапроса.Выбрать();
		
		Запись = РегистрыСведений.CW_ПараметрыДоговоров.СоздатьМенеджерЗаписи();
		
		Если Выборка.Следующий() Тогда
			ЗаполнитьЗначенияСвойств(Запись, Выборка);	
		КонецЕсли;
		
		Запись.Период	= ДатаДокумента;
		Запись.Договор	= Ссылка;
		
		Запись.Записать();
		
	КонецЕсли; 

КонецПроцедуры

#КонецЕсли
