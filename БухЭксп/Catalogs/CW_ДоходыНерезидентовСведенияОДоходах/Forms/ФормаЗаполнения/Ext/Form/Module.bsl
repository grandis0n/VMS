
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("АдресРезультата") 
		И ЭтоАдресВременногоХранилища(Параметры.АдресРезультата) Тогда
		ТаблицаДокументов.Загрузить(ПолучитьИзВременногоХранилища(Параметры.АдресРезультата));
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаПродолжить(Команда)
	
	ТекущаяСтрока = Элементы.ТаблицаДокументов.ТекущаяСтрока;
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЗавершитьВыборСтрокиНаКлиенте(ТекущаяСтрока);

КонецПроцедуры

&НаКлиенте
Процедура ТаблицаДокументовВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	ЗавершитьВыборСтрокиНаКлиенте(ВыбраннаяСтрока);
КонецПроцедуры 

&НаКлиенте
Процедура ЗавершитьВыборСтрокиНаКлиенте(ВыбраннаяСтрока)
	
	СтрокаТекущая = ТаблицаДокументов.НайтиПоИдентификатору(ВыбраннаяСтрока);
	
	Структура = Новый Структура;
	Структура.Вставить("Период", 				СтрокаТекущая.Период);
	Структура.Вставить("Контрагент", 			СтрокаТекущая.Контрагент);
	Структура.Вставить("ДоговорКонтрагента", 	СтрокаТекущая.ДоговорКонтрагента);
	Структура.Вставить("Валюта", 				СтрокаТекущая.Валюта);
	Структура.Вставить("СуммаПоДокументу", 		СтрокаТекущая.СуммаПоДокументу);
	       
	ЭтаФорма.Закрыть(Структура);
	
КонецПроцедуры