&НаСервере
Процедура _ПерезаполнитьПараметрыВедомых()
	// --- 
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	CW_ОтслеживаемоеОборудование.Ссылка
	|ИЗ
	|	Справочник.CW_ОтслеживаемоеОборудование КАК CW_ОтслеживаемоеОборудование
	|ГДЕ
	|	CW_ОтслеживаемоеОборудование.Оборудование = &Оборудование";
	Запрос.УстановитьПараметр("Оборудование", Объект.Ссылка);
	ТЗ = Запрос.Выполнить().Выгрузить();
	// --- 
	Для каждого Стр Из ТЗ Цикл
		
		ОтслеживаемоеОборудованиеОбъект = Стр.Ссылка.ПолучитьОбъект();
		// --- 
		Для каждого СтрокаПараметраОборудования Из Объект.ПараметрыГрузоперевозки Цикл
			
			СтрокаПараметра = CW_Мониторинг.СтрокаПараметра(ОтслеживаемоеОборудованиеОбъект,СтрокаПараметраОборудования.Параметр);
			Если (СтрокаПараметра = Неопределено) Тогда
				
				СтрокаПараметра = ОтслеживаемоеОборудованиеОбъект.ПараметрыГрузоперевозки.Добавить();
				СтрокаПараметра.Параметр = СтрокаПараметраОборудования.Параметр;
				
			КонецЕсли; 
			СтрокаПараметра.Значение = СтрокаПараметраОборудования.Значение;
			
		КонецЦикла; 
		// --- 
		ОтслеживаемоеОборудованиеОбъект.Записать();
		
	КонецЦикла;
	
	// --- 
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	CW_Грузоперевозки.Ссылка
	               |ИЗ
	               |	Справочник.CW_Грузоперевозки КАК CW_Грузоперевозки
	               |ГДЕ
	               |	CW_Грузоперевозки.ОтслеживаемоеОборудование.Оборудование = &Оборудование";
	Запрос.УстановитьПараметр("Оборудование", Объект.Ссылка);
	ТЗ = Запрос.Выполнить().Выгрузить();
	// --- 
	Для каждого Стр Из ТЗ Цикл
		
		ГрузоперевозкаОбъект = Стр.Ссылка.ПолучитьОбъект();
		// --- 
		Для каждого СтрокаПараметраОборудования Из Объект.ПараметрыГрузоперевозки Цикл
			
			СтрокаПараметра = CW_Мониторинг.СтрокаПараметра(ГрузоперевозкаОбъект,СтрокаПараметраОборудования.Параметр);
			Если (СтрокаПараметра = Неопределено) Тогда
				
				СтрокаПараметра = ГрузоперевозкаОбъект.ПараметрыГрузоперевозки.Добавить();
				СтрокаПараметра.Параметр = СтрокаПараметраОборудования.Параметр;
				
			КонецЕсли; 
			СтрокаПараметра.Значение = СтрокаПараметраОборудования.Значение;
			
		КонецЦикла; 
		// --- 
		ГрузоперевозкаОбъект.Записать();
		
	КонецЦикла;
	 
	
	
	// --- 
КонецПроцедуры
 
&НаСервере
Процедура _ОбновитьУсловноеОформлениеПараметров()
	// --- 
	
	СвойстваПараметров = ПолучитьИзВременногоХранилища(АдресКартыСвойствПараметров);
	// --- 
	
	ЭтаФорма.УсловноеОформление.Элементы.Очистить();
	Для каждого Стр Из Объект.ПараметрыГрузоперевозки Цикл
		
		ФорматВывода = Стр.Параметр.ФорматВывода;
		Если (ФорматВывода = "") Тогда
			
			СвойстваПараметра = СвойстваПараметров.Получить(Стр.Параметр);
			Если (СвойстваПараметра = Неопределено) Тогда
				КартаСвойств = ПолучитьИзВременногоХранилища(АдресКартыСвойствПараметров);
				СвойстваПараметра = КартаСвойств.Получить(Стр.Параметр);
			КонецЕсли;
			ТипЗначенияПараметра = СвойстваПараметра.ТипЗначения;
			ТипПараметра = СвойстваПараметра.ТипЗначения.Типы()[0];
			Если (СвойстваПараметра.ЭтоКонтрольнаяДата) Тогда
				
				Если (НЕ СвойстваПараметра.КонтрольнаяДатаИспользуетВремя) Тогда
					ФорматВывода = "ДФ=dd.MM.yyyy";
				Иначе
					ФорматВывода = "ДФ='dd.MM.yyyy HH:mm'";
				КонецЕсли; 
				
			Иначе
				
				Если (ТипПараметра = Тип("Булево") ИЛИ ТипПараметра = Тип("Дата") ИЛИ ТипПараметра=Тип("Число")) Тогда
					
					Если ТипПараметра = Тип("Дата") Тогда
						
						ФорматВывода = "";
						ЧастьДаты = ТипЗначенияПараметра.КвалификаторыДаты.ЧастиДаты;
						Если ЧастьДаты = ЧастиДаты.Дата Тогда
							
							// формат дат по умолчанию
							ФорматВывода = "ДФ=dd.MM.yyyy";
							
						ИначеЕсли ЧастьДаты = ЧастиДаты.Время Тогда 
							
							// формат дат по умолчанию
							ФорматВывода = "ДФ=HH:mm:ss";
							
						ИначеЕсли ЧастьДаты = ЧастиДаты.ДатаВремя Тогда 
							
							// формат дат по умолчанию
							ФорматВывода = "ДЛФ=";
							
						КонецЕсли;
						
					КонецЕсли; 
					
				КонецЕсли; 					
				
			КонецЕсли;  
		КонецЕсли; 
		Если (ФорматВывода <> "") Тогда
			УО = _УФС.ДобавитьПростоеУсловноеОформление(ЭтаФорма,"Объект.ПараметрыГрузоперевозки.Параметр",,Стр.Параметр,"ПараметрыГрузоперевозкиЗначение","Формат",ФорматВывода);
		КонецЕсли; 
		
	КонецЦикла; 
	
	// --- 
КонецПроцедуры


&НаКлиенте
Процедура КомандаОбновитьПараметры(Команда)
	
	_ОбновитьУсловноеОформлениеПараметров();
	
