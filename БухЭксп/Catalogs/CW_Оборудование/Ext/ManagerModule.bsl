
Функция ПолучитьНаличиеОборудования(ПредставлениеОборудования) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	CW_Оборудование.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.CW_Оборудование КАК CW_Оборудование
	               |ГДЕ
	               |	CW_Оборудование.Наименование = &ПредставлениеОборудования
	               |	И CW_Оборудование.ПометкаУдаления = ЛОЖЬ";

	Запрос.УстановитьПараметр("ПредставлениеОборудования", ПредставлениеОборудования);
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат НЕ РезультатЗапроса.Пустой();
	
КонецФункции

Функция ПолучитьОборудованиеПоНаименованию(ПредставлениеОборудования) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	CW_Оборудование.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.CW_Оборудование КАК CW_Оборудование
	               |ГДЕ
	               |	CW_Оборудование.Наименование = &ПредставлениеОборудования
	               |	И CW_Оборудование.ПометкаУдаления = ЛОЖЬ";

	Запрос.УстановитьПараметр("ПредставлениеОборудования", ПредставлениеОборудования);
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат ПредопределенноеЗначение("Справочник.CW_Оборудование.ПустаяСсылка");
	
КонецФункции

Процедура ПоставитьОборудованиеНаСлеждение(ПараметрыПроцедуры, АдресРезультата) Экспорт
	
	ПараметрыСлежения = ПараметрыПроцедуры.ПараметрыСлежения;  
	
	ОтслеживаемоеОборудование = Новый Массив;
	
	Для Каждого Оборудование из ПараметрыПроцедуры.Оборудование Цикл  
		
		Наименование = Строка(Оборудование)+" ("+Строка(ПараметрыСлежения.ВариантСлежения)+", "+Формат(ПараметрыСлежения.НачалоСлежения,"ДЛФ=D")+")";
	
		ОбъектОтслеживаемоеОборудование = Справочники.CW_ОтслеживаемоеОборудование.СоздатьЭлемент();
		ОбъектОтслеживаемоеОборудование.Оборудование 		= Оборудование;   
		ОбъектОтслеживаемоеОборудование.Наименование 		= Наименование;   
		ОбъектОтслеживаемоеОборудование.ВариантСлежения 	= ПараметрыСлежения.ВариантСлежения;   
		ОбъектОтслеживаемоеОборудование.НачалоСлежения 		= ПараметрыСлежения.НачалоСлежения;   
		ОбъектОтслеживаемоеОборудование.ОкончаниеСлежения 	= ПараметрыСлежения.ОкончаниеСлежения;  
		
		//Параметры оборудования
		Для Каждого СтрокаПараметров из  Оборудование.ПараметрыГрузоперевозки Цикл 
			НоваяСтрока = ОбъектОтслеживаемоеОборудование.ПараметрыГрузоперевозки.Добавить();
			НоваяСтрока.Параметр			= СтрокаПараметров.Параметр;
			НоваяСтрока.Значение			= СтрокаПараметров.Значение;
			НоваяСтрока.Примечание			= СтрокаПараметров.Примечание;    
			НоваяСтрока.ХранилищеДанных		= Новый ХранилищеЗначения(СтрокаПараметров.ХранилищеДанных.Получить());
			НоваяСтрока.ДобавлятьВКарточку 	= Истина;
		КонецЦикла; 
		//---Параметры оборудования
		
		ОбъектОтслеживаемоеОборудование.Записать();  
		
		ОтслеживаемоеОборудование.Добавить(ОбъектОтслеживаемоеОборудование.Ссылка);
		
	КонецЦикла;
	
	ПоместитьВоВременноеХранилище(ОтслеживаемоеОборудование, АдресРезультата);  
	
КонецПроцедуры      

