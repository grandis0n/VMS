&НаСервере
Процедура ПрочитатьТоварыТорговогоПредложения()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТоварыТорговыхПредложений.Номенклатура КАК Номенклатура,
		|	ТоварыТорговыхПредложений.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
		|	ТоварыТорговыхПредложений.НетВПрайсе КАК НетВПрайсе,
		|	ТоварыТорговыхПредложений.Количество КАК Количество,
		|	ТоварыТорговыхПредложений.Оценка КАК Оценка,
		|	ТоварыТорговыхПредложений.Цена КАК Цена
		|ИЗ
		|	РегистрСведений.ТоварыТорговыхПредложений КАК ТоварыТорговыхПредложений
		|ГДЕ
		|	ТоварыТорговыхПредложений.ТорговоеПредложение = &ТорговоеПредложение";
	
	Запрос.УстановитьПараметр("ТорговоеПредложение", Объект.Ссылка);
	
	Товары.Загрузить(Запрос.Выполнить().Выгрузить());
	
	ПересчетНомераСтрок(ЭтотОбъект);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьРеквизитыВидаЦен(ВидЦены)
	
	Если НЕ ЗначениеЗаполнено(ВидЦены) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Ответ = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ВидЦены, "ВалютаЦены, ЦенаВключаетНДС");
	
	Возврат Ответ;
	
КонецФункции

&НаКлиенте
Процедура ВыборВидаЦен_Завершение(Результат, ДопПараметры) Экспорт 
	
	Если Результат <> Неопределено Тогда
		
		Ответ = ПолучитьРеквизитыВидаЦен(Результат);
		
		Если Ответ = Неопределено Тогда 
			Возврат;
		КонецЕсли;
		
		Объект.ТипЦены = Результат;
		Валюта = Ответ.ВалютаЦены;
		ЦенаВключаетНДС = Ответ.ЦенаВключаетНДС;
		
		СформироватьЗаголовокВидыЦен();
		СформироватьПредставлениеМинимальнойСуммыЗаказа();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьЗаголовокВидыЦен()
	
	ЦенаВключаетНДСТекст = ?(ЦенаВключаетНДС, НСтр("ru = 'НДС в сумме'"), НСтр("ru = 'НДС сверху'"));
	
	МассивСтрок = Новый Массив;
	
	Если ЗначениеЗаполнено(Объект.ТипЦены) Тогда
		МассивСтрок.Добавить(Строка(Объект.ТипЦены));
	Иначе 
		МассивСтрок.Добавить(Новый ФорматированнаяСтрока(НСтр("ru = '<Тип цены не выбран>'"), , WebЦвета.Красный));
	КонецЕсли;
	
	МассивСтрок.Добавить(" (");
	
	Если ЗначениеЗаполнено(Валюта) Тогда
		МассивСтрок.Добавить(Строка(Валюта));
	Иначе
		МассивСтрок.Добавить(Новый ФорматированнаяСтрока(НСтр("ru = '<Валюта не выбрана>'"),,WebЦвета.Красный));
	КонецЕсли;
	
	МассивСтрок.Добавить(") • ");
	
	МассивСтрок.Добавить(ЦенаВключаетНДСТекст);
	
	Элементы.ДекорацияВидЦены.Заголовок = Новый ФорматированнаяСтрока(МассивСтрок);
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьПредставлениеМинимальнойСуммыЗаказа()
	
	Если ЗначениеЗаполнено(Объект.МинимальнаяСуммаЗаказа) Тогда
		МинимальнаяСуммаЗаказаПредставление = СтрШаблон("%1 %2", Формат(Объект.МинимальнаяСуммаЗаказа, "ЧДЦ=2"), Строка(Валюта));
	Иначе
		МинимальнаяСуммаЗаказаПредставление = НСтр("ru = 'Любая'");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьЗаголовокСрокПоставки()

	Если Объект.СрокПоставки = 0 Тогда
		
		СрокПоставки = НСтр("ru = 'В наличии'");
		
	Иначе
		
		СрокПоставки = СтроковыеФункцииКлиентСервер.СтрокаСЧисломДляЛюбогоЯзыка(
		        НСтр("ru = ';%1 день;;%1 дня;%1 дней;%1 дня'"),
		        Объект.СрокПоставки);
	
	КонецЕсли;

КонецПроцедуры

