
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	УстановитьУсловноеОформление();
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(Объект, ЭтотОбъект);
	
	ПриСозданииЧтенииНаСервере();
	
	ИспользуетсяНесколькоОрганизацийЭД = Справочники.Организации.ИспользуетсяНесколькоОрганизаций();
	
	Если ЗначениеЗаполнено(Объект.Организация) И Не ИспользуетсяНесколькоОрганизацийЭД Тогда
		
		Элементы.Организация.Видимость = Ложь;
		
	КонецЕсли;
	
	// ЭлектронноеВзаимодействие.ТорговыеПредложения
	Если Объект.Ссылка.Пустая() Тогда
		ОбновитьДанныеПубликацииТорговыхПредложений();
	КонецЕсли;
	// Конец ЭлектронноеВзаимодействие.ТорговыеПредложения
	
	ПрочитатьТоварыТорговогоПредложения();
	
	ПрочитатьНастройкиПубликации(Объект.Ссылка);
	
	ПоВсемКонтрагентам = Истина;
	
	
	СхемаВыгрузкиДанных = РеквизитФормыВЗначение("Объект").ПолучитьМакет("СхемаВыгрузки");
	
	АдресСхемы = ПоместитьВоВременноеХранилище(СхемаВыгрузкиДанных, УникальныйИдентификатор);
	
	КомпоновщикНастроек.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(АдресСхемы)); 
	КомпоновщикНастроек.ЗагрузитьНастройки(СхемаВыгрузкиДанных.НастройкиПоУмолчанию);
	
	Элементы.СрокПоставки.Доступность              = НЕ ТолькоПросмотр;
	Элементы.ДекорацияВидЦены.Доступность          = НЕ ТолькоПросмотр;
	Элементы.МинимальнаяСуммаЗаказа.Доступность    = НЕ ТолькоПросмотр;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	// ЭлектронноеВзаимодействие.ТорговыеПредложения
	Если ИмяСобытия = "ТорговыеПредложения_ИзменениеСинхронизации"
		И (Параметр = Неопределено ИЛИ Параметр = Объект.Ссылка) Тогда
		
		ОбновитьДанныеПубликацииТорговыхПредложений();
		
	КонецЕсли;
	// Конец ЭлектронноеВзаимодействие.ТорговыеПредложения
	
	Если ИмяСобытия = "ТорговыеПредложения_ЗаписьДополнительныеНастройки"
		И Параметр.ТорговоеПредложение = Объект.Ссылка Тогда
		
		НастроитьФормуПослеИзмененияНастроекПубликации(Параметр);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	ТекущийОбъект.ДополнительныеСвойства.Вставить("ЭтоНовый", ТекущийОбъект.Ссылка.Пустая());
	
	ПроверкаНаДубли = ЭтотОбъект.Товары.Выгрузить(,"Номенклатура, ЕдиницаИзмерения");
	ПроверкаНаДубли.Колонки.Добавить("Количество");
	ПроверкаНаДубли.ЗаполнитьЗначения(1,"Количество");
	ПроверкаНаДубли.Свернуть("Номенклатура, ЕдиницаИзмерения","Количество");
	
	Шаблон = НСтр("ru = 'По товару %1 в табличной части найдено %2'");
	
	Для Каждого СтрокаПроверки Из ПроверкаНаДубли Цикл
		
		Если СтрокаПроверки.Количество > 1 Тогда
			Отказ = Истина;
			
			Строк = СтроковыеФункцииКлиентСервер.СтрокаСЧисломДляЛюбогоЯзыка(
				НСтр("ru = ';%1 строка;;%1 строки;%1 строк;%1 строки'"),
				СтрокаПроверки.Количество);
			
			Сообщение = Новый СообщениеПользователю();
			Сообщение.Текст = СтрШаблон(Шаблон, СтрокаПроверки.Номенклатура, Строк);
			Сообщение.Поле = "Товары";
			Сообщение.УстановитьДанные(ЭтотОбъект);
			Сообщение.Сообщить();
			
		КонецЕсли;
		
	КонецЦикла;
	
	ТекущийОбъект.ТорговоеПредложениеРодитель = Справочники.ТорговыеПредложения.ПустаяСсылка();
	
	ТекущийОбъект.ПоВсемТоварам = Товары.Количество() = 0;
	
	// ЭлектронноеВзаимодействие.ТорговыеПредложения
	ТорговыеПредложения.ПередЗаписьюНаСервере(ЭтотОбъект, ТекущийОбъект, Объект.Организация, Элементы.ГруппаУправленияТорговымиПредложениями, Отказ);
	// Конец ЭлектронноеВзаимодействие.ТорговыеПредложения
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	// ЭлектронноеВзаимодействие.ТорговыеПредложения
	ТорговыеПредложенияКлиент.ПослеЗаписи(ЭтотОбъект, ПараметрыЗаписи);
	// Конец ЭлектронноеВзаимодействие.ТорговыеПредложения
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	СформироватьЗаголовокВидыЦен();
	СформироватьЗаголовокСрокПоставки();
	СформироватьПредставлениеМинимальнойСуммыЗаказа();
	УстановитьВидимостьГруппыТовары();
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	// СтандартныеПодсистемы.УправлениеДоступом
	УправлениеДоступом.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
	// ЭлектронноеВзаимодействие.ТорговыеПредложения
	ТорговыеПредложения.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, Объект.Организация, Элементы.ГруппаУправленияТорговымиПредложениями);
	// Конец ЭлектронноеВзаимодействие.ТорговыеПредложения
	
КонецПроцедуры

&НаСервере
Процедура ПриЗаписиНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	Если НЕ ЭтотОбъект.Модифицированность 
		И НЕ ТекущийОбъект.ДополнительныеСвойства.ЭтоНовый Тогда
		
		Возврат;
	КонецЕсли;
	
	НачатьТранзакцию();
	Попытка
		
		БлокировкаДанных = Новый БлокировкаДанных;
		ЭлементБлокировки = БлокировкаДанных.Добавить("РегистрСведений.ТоварыТорговыхПредложений");
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		ЭлементБлокировки.УстановитьЗначение("ТорговоеПредложение", ТекущийОбъект.Ссылка);
		БлокировкаДанных.Заблокировать();
		
		НаборТоваров = РегистрыСведений.ТоварыТорговыхПредложений.СоздатьНаборЗаписей();
		НаборТоваров.Отбор.ТорговоеПредложение.Установить(ТекущийОбъект.Ссылка);
		
		ТаблицаТоваров = ЭтотОбъект.Товары.Выгрузить();
		ТаблицаТоваров.Колонки.Добавить("ТорговоеПредложение");
		ТаблицаТоваров.ЗаполнитьЗначения(ТекущийОбъект.Ссылка, "ТорговоеПредложение");
		
		Если НЕ Объект.ОбновлятьОстаткиИЦены Тогда
			ТаблицаТоваров.ЗаполнитьЗначения(Ложь, "НетВПрайсе");
			ЭтотОбъект.Товары.Загрузить(ТаблицаТоваров);
		КонецЕсли;
		
		НаборТоваров.Загрузить(ТаблицаТоваров);
		НаборТоваров.Записать();
		
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		Информация = ИнформацияОбОшибке();
		
		ЭлектронноеВзаимодействие.ОбработатьОшибку(НСтр("ru = 'Сохранение торгового предложения'"),
			ПодробноеПредставлениеОшибки(Информация), НСтр("ru = 'Не удалось сохранить торговое предложение'"), "",
			ТекущийОбъект.Ссылка);
			
	КонецПопытки;
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	// СтандартныеПодсистемы.УправлениеДоступом
	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.УправлениеДоступом") Тогда
		МодульУправлениеДоступом = ОбщегоНазначения.ОбщийМодуль("УправлениеДоступом");
		МодульУправлениеДоступом.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
	// ЭлектронноеВзаимодействие.ТорговыеПредложения
	ОбновитьДанныеПубликацииТорговыхПредложений();
	// Конец ЭлектронноеВзаимодействие.ТорговыеПредложения
	
	ПриСозданииЧтенииНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	
	Для Каждого СтрокаТовар Из Товары Цикл
		
		НомерСтроки = Товары.Индекс(СтрокаТовар);
		
		Если ЦеныПубликуются
			И СтрокаТовар.Цена = 0
			И НЕ (Объект.ОбновлятьОстаткиИЦены И СтрокаТовар.НетВПрайсе) Тогда
			
			ТекстОшибки = Новый ФорматированнаяСтрока(СтрШаблон(НСтр("ru = 'В строке %1 не заполнена цена.'"), НомерСтроки+1)
				+Символы.ПС
				+НСтр("ru = 'Для торгового предложения включена публикация цен на товары'"));
				
			ОбщегоНазначения.СообщитьПользователю(
				ТекстОшибки, 
				Объект.Ссылка, 
				ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("Товары", НомерСтроки, "Цена"), , Отказ);
				
		КонецЕсли;
			
	КонецЦикла;
	
	Если Не ЗначениеЗаполнено(Объект.ТипЦены) Тогда
		ОбщегоНазначения.СообщитьПользователю(
			НСтр("ru = 'Вид цены не выбран'"), 
			Объект.Ссылка , "ДекорацияВидЦены",, Отказ);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.ДатаОкончанияДействия) 
		И Объект.ДатаОкончанияДействия < Объект.ДатаНачалаДействия Тогда
		
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Дата окончание периода не может быть меньше даты начала'"),
			Объект.Ссылка, "ДатаОкончанияДействия", , Отказ);
		
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ДекорацияВидЦеныНажатие(Элемент)
	
	ПараметрыОткрытия = Новый Структура();
	ПараметрыОткрытия.Вставить("Ключ" , Объект.ТипЦены);
	ПараметрыОткрытия.Вставить("ЗакрыватьПриВыборе" , Истина);
	
	ОткрытьФорму("Справочник.ТипыЦенНоменклатуры.ФормаВыбора",
	    ПараметрыОткрытия,
	    УникальныйИдентификатор,
	    ,,,
	    Новый ОписаниеОповещения("ВыборВидаЦен_Завершение",ЭтотОбъект),
	    РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры


&НаКлиенте
Процедура ДекорацияПЛОбработкаНавигационнойСсылки(Элемент, НавигационнаяСсылкаФорматированнойСтроки, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ОткрытьФорму("РегистрСведений.ЦеныНоменклатуры.ФормаСписка");
	
КонецПроцедуры

&НаКлиенте
Процедура СрокПоставкиНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Оповещение = Новый ОписаниеОповещения("СрокПоставкиЗавершение",ЭтотОбъект);
	
	ПоказатьВводЧисла(Оповещение, Объект.СрокПоставки,
	    НСтр("ru = 'Введите срок поставки'"),
	    3,
	    0);
	    
КонецПроцедуры

&НаКлиенте
Процедура МинимальнаяСуммаЗаказаНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Оповещение = Новый ОписаниеОповещения("МинимальнаяСуммаЗаказаЗавершение", ЭтотОбъект);
	
	ПоказатьВводЧисла(Оповещение, Объект.МинимальнаяСуммаЗаказа,
		НСтр("ru = 'Введите минимальную суму заказа'"), 15, 2);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыТовары

&НаКлиенте
Процедура ТоварыПеретаскивание(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Строка, Поле)
	
	ПересчетНомераСтрок(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыПослеУдаления(Элемент)
	
	ПересчетНомераСтрок(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыНоменклатураПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.Товары.ТекущиеДанные;
	РеквизитыНоменклатуры = РеквизитыНоменклатуры(ТекущиеДанные.Номенклатура, "ЕдиницаИзмерения");
	ЗаполнитьЗначенияСвойств(ТекущиеДанные, РеквизитыНоменклатуры);
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НоваяСтрока И Копирование Тогда 
		Элементы.Товары.ТекущиеДанные.НетВПрайсе = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыПередОкончаниемРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования, Отказ)
	
	Если НоваяСтрока Тогда
		Элементы.Товары.ТекущиеДанные.НомерСтроки = Товары.Количество();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

// ЭлектронноеВзаимодействие.ТорговыеПредложения
&НаКлиенте
Процедура Подключаемый_ПриИзменении_ПубликоватьТорговыеПредложения (Элемент, СтандартнаяОбработка)
	
	ТорговыеПредложенияКлиент.ПриИзмененииПубликоватьТорговыеПредложения(ЭтотОбъект, Объект, Элемент, СтандартнаяОбработка);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьОценку(Команда)
	
	СписокВариантов = Элементы.ТоварыОценка.СписокВыбора;
	
	Описание = Новый ОписаниеОповещения("УстановкаОценки_Завершение",ЭтотОбъект);
	
	СписокВариантов.ПоказатьВыборЭлемента(Описание, НСтр("ru = 'Выберите оценку остатка'"));
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_Нажатие_ГиперссылкиТорговыхПредложений(Элемент, СтандартнаяОбработка)
	
	ТорговыеПредложенияКлиент.ТорговыеПредложенияНажатиеГиперссылки(ЭтотОбъект, Объект, Элемент, СтандартнаяОбработка);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПоУсловию(Команда)
	
	Если Товары.Количество() > 0 Тогда
		
		ПоказатьВопрос(Новый ОписаниеОповещения("ЗаполнитьПоУсловию_Завершение", ЭтотОбъект),
		               НСтр("ru = 'Перед заполнением табличная часть будет очищена. Заполнить?'"),
		               РежимДиалогаВопрос.ДаНет,,
		               КодВозвратаДиалога.Да,);
		
		Возврат;
	
	КонецЕсли;
	
	ЗаполнитьПоУсловию_Завершение(КодВозвратаДиалога.Да,Неопределено);
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьПоШтрихКоду(Команда)
	
	Оповещение = Новый ОписаниеОповещения("ДобавитьПоШтрихкодуПослеПоиска", ЭтотОбъект, Неопределено);
	ШтрихкодированиеНоменклатурыБПКлиент.ПоказатьВводШтрихкода(Оповещение); 
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьИзВнешнегоФайла(Команда)
	
	ПараметрыФормы = Новый Структура();
	ПараметрыФормы.Вставить("ЗагружатьЦену"            , Истина);
	ПараметрыФормы.Вставить("ЗагружатьКоличество"      , Истина);
	ПараметрыФормы.Вставить("ЗагружатьОценку"          , Истина);
	ПараметрыФормы.Вставить("ЗагружатьЕдиницыИзмерения", Истина);
	
	Описание = Новый ОписаниеОповещения("Подключаемый_ЗагрузитьИзВнешнегоФайла_Завершение",ЭтотОбъект);
	
	ОткрытьФорму("Обработка.ЗагрузкаДанныхИзВнешнихФайлов.Форма.Форма", 
	    ПараметрыФормы,
	    ,,,,
	    Описание);
	    
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьЦенуНаПроцент(Команда)
	
	ПараметрыФормы = Новый Структура();
	
	Оповещение = Новый ОписаниеОповещения("ИзменитьЦенуНаПроцент_Завершение",ЭтотОбъект);
	
