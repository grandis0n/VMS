&НаСервере
Процедура ЗаполнитьТоварыОтбора()

	Товары.Очистить();
	СхемаКомпоновки = РеквизитФормыВЗначение("Объект").ПолучитьМакет("СхемаВыгрузки");
	
	ТаблицаДанныеПакетаПредложений = Новый ТаблицаЗначений;
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновки, КомпоновщикНастроек.Настройки,,,
	           Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"), Ложь);
	
	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки,,,);
	
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	
	ПроцессорВывода.УстановитьОбъект(ТаблицаДанныеПакетаПредложений);
	
	ПроцессорВывода.Вывести(ПроцессорКомпоновки);
	Товары.Загрузить(ТаблицаДанныеПакетаПредложений);
	
	НомерСтроки = 0;
	
	Для Каждого Товар Из Товары Цикл
		
		НомерСтроки = НомерСтроки + 1;
		Товар.НомерСтроки = НомерСтроки;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция РеквизитыНоменклатуры(Знач СсылкаНаОбъект, Знач Реквизиты);
	Возврат ТорговыеПредложенияБП.РеквизитыНоменклатурыПриИзменении(СсылкаНаОбъект, Реквизиты);
КонецФункции

&НаКлиенте
Процедура ДобавитьПоШтрихкодуПослеПоиска(Результат, Контекст) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(Результат) = Тип("Массив") Тогда
		Штрихкоды = Результат;
	Иначе
		Штрихкоды = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Результат);
	КонецЕсли;
	
	Для каждого ТекущийШтрихкод Из Штрихкоды Цикл
		
		НоваяСтрока = Товары.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущийШтрихкод);
		ЗаполнитьЗначенияСвойств(НоваяСтрока, РеквизитыНоменклатуры(НоваяСтрока.Номенклатура, "ЕдиницаИзмерения"));
		НоваяСтрока.НомерСтроки = Товары.Количество();
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ЗагрузитьИзВнешнегоФайла_Завершение(Результат, Параметры) Экспорт
	
	Если ЗначениеЗаполнено(Результат) Тогда
		
		Товары.Очистить();
		
		НомерСтроки = 0;
		Для Каждого СтрокаРезультата Из Результат Цикл
			
			НомерСтроки = НомерСтроки + 1;
			НоваяСтрока = Товары.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаРезультата);
			НоваяСтрока.НомерСтроки = НомерСтроки;
		
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановкаОценки_Завершение(Значение,ДополнительныеПараметры) Экспорт
	
	Если Значение<>Неопределено Тогда
		
		Для Каждого Индекс Из Элементы.Товары.ВыделенныеСтроки	Цикл 
			Элементы.Товары.ДанныеСтроки(Индекс).Оценка=Значение.Значение;
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьЦенуНаПроцент_Завершение(РезультатВыполнения,ДопПараметры) Экспорт
	
	Если ЗначениеЗаполнено(РезультатВыполнения) Тогда
		
		Для Каждого Индекс Из Элементы.Товары.ВыделенныеСтроки Цикл
			
			СтрокаТаблицы = Элементы.Товары.ДанныеСтроки(Индекс);
			
			СуммаПроцента = РезультатВыполнения.Процент * СтрокаТаблицы.Цена/100;
					
			Если РезультатВыполнения.Уменьшить Тогда
				СтрокаТаблицы.Цена = СтрокаТаблицы.Цена - СуммаПроцента;
			Иначе 
				СтрокаТаблицы.Цена = СтрокаТаблицы.Цена + СуммаПроцента;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры 

&НаСервере
Процедура ОбновитьПоДаннымПрайсЛистаНаСервере()
	Запрос = Новый Запрос; 
	Запрос.УстановитьПараметр("ТипЦены", Объект.ТипЦены);
	Запрос.УстановитьПараметр("Валюта",  Валюта);
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЦеныНоменклатурыСрезПоследних.Номенклатура КАК Номенклатура,
	|	ЦеныНоменклатурыСрезПоследних.Номенклатура.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ЦеныНоменклатурыСрезПоследних.Цена КАК Цена
	|ИЗ
	|	РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
	|			,
	|			ТипЦен = &ТипЦены
	|				И Валюта = &Валюта) КАК ЦеныНоменклатурыСрезПоследних
	|ГДЕ
	|	ЦеныНоменклатурыСрезПоследних.Цена <> 0";
	
	ТаблицаНоменклатуры = Запрос.Выполнить().Выгрузить();
	
	Товары.Загрузить(ТаблицаНоменклатуры);
КонецПроцедуры 

#КонецОбласти
