
Процедура ПередЗаписью(Отказ) 

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если ЭтоНовый() 
		или Родитель <> Ссылка.Родитель Тогда
			ИндексЭлемента = ПолучитьИндексЭлемента();                                    
	КонецЕсли; 
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	Если Не ЭтоГруппа Тогда
		ПроверяемыеРеквизиты.Удалить(ПроверяемыеРеквизиты.Найти("Наименование"));
	КонецЕсли;   
	
КонецПроцедуры

Функция ПолучитьИндексЭлемента()   
	
	ИндексЭлемента = 0;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	МониторинговыеПараметры.ИндексЭлемента КАК ИндексЭлемента
	               |ИЗ
	               |	Справочник.CW_МониторинговыеПараметрыТиповОбъектов КАК МониторинговыеПараметры
	               |ГДЕ
	               |	МониторинговыеПараметры.Владелец = &Владелец
	               |	И МониторинговыеПараметры.Родитель = &Родитель
	               |	И МониторинговыеПараметры.ЭтоГруппа = &ЭтоГруппа
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ИндексЭлемента УБЫВ";  
	
	Запрос.УстановитьПараметр("Владелец", 	Владелец);  
	Запрос.УстановитьПараметр("Родитель", 	Родитель);
	Запрос.УстановитьПараметр("ЭтоГруппа", 	ЭтоГруппа);
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Если Выборка.Следующий() Тогда  
		ИндексЭлемента =  Выборка.ИндексЭлемента;
	КонецЕсли;
	
	Возврат ИндексЭлемента + 1;
	
КонецФункции
