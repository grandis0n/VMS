#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

Процедура ПриЗаписи(Отказ)
	
	Если ОбменДанными.Загрузка Тогда 
		Возврат;
	КонецЕсли;
	
	Если ЭтотОбъект.ДополнительныеСвойства.Свойство("ЗаписатьОбъектНаСогласование") Тогда
		Если ЭтотОбъект.ДополнительныеСвойства.ЗаписатьОбъектНаСогласование Тогда
			
			мОжидаютСогласования = МаршрутСогласования.НайтиСтроки(Новый Структура("ОжидаетСогласования", Истина));
			мДанныеДляЗаписи = новый Массив;
			Для Каждого СтрокаМаршртуа из мОжидаютСогласования Цикл
				СтруктураСогласования = Новый Структура;
				СтруктураСогласования.Вставить("ГруппаСогласования",  		СтрокаМаршртуа.ГруппаСогласования);
				СтруктураСогласования.Вставить("Пользователь",  			СтрокаМаршртуа.Пользователь);
				СтруктураСогласования.Вставить("ЭтапСогласования", 			Ссылка);
				
				СтруктураСогласования.Вставить("ДатаНачала", 				СтрокаМаршртуа.Получено);
				СтруктураСогласования.Вставить("ДатаПланЗавершения", 		СтрокаМаршртуа.ПлановаяДата);
				СтруктураСогласования.Вставить("ПорядокСогласования", 		ПорядокСогласования);
				СтруктураСогласования.Вставить("Комментарий",				"");
			
				мДанныеДляЗаписи.Добавить(СтруктураСогласования);
			КонецЦикла;
			
			//Добавляем инициатора
			СтруктураСогласования = Новый Структура;
			СтруктураСогласования.Вставить("ГруппаСогласования",	ПредопределенноеЗначение("Справочник.CW_ГруппыСогласования.ПустаяСсылка"));
			СтруктураСогласования.Вставить("Пользователь",			Инициатор);
			СтруктураСогласования.Вставить("ЭтапСогласования",		Ссылка);
			
			СтруктураСогласования.Вставить("ДатаНачала",			ДатаНачала);
			СтруктураСогласования.Вставить("ДатаПланЗавершения",	ПлановаяДатаЗавершения);
			СтруктураСогласования.Вставить("ПорядокСогласования",	ПорядокСогласования);
			СтруктураСогласования.Вставить("Комментарий",			Комментарий);
			
			мДанныеДляЗаписи.Добавить(СтруктураСогласования);
			
			РегистрыСведений.CW_ОбъектыНаСогласовании.ЗаписатьОбъектНаСогласование(ОбъектСогласования, мДанныеДляЗаписи);
			
			Если ЭтотОбъект.ДополнительныеСвойства.Свойство("ОповеститьИнициатора") Тогда
				ОповеститьИнициатора = ЭтотОбъект.ДополнительныеСвойства.ОповеститьИнициатора;
			КонецЕсли;
			
			Если ЭтотОбъект.ДополнительныеСвойства.Свойство("ОповеститьПользователей") Тогда
				ОповеститьПользователей = ЭтотОбъект.ДополнительныеСвойства.ОповеститьПользователей;
			КонецЕсли;

			CW_СогласованиеСервер.ОповеститьПользователейПоСогласованию(Ссылка, ОповеститьПользователей, ОповеститьИнициатора);
			
		КонецЕсли;
	КонецЕсли;
	
	Если ЭтотОбъект.ДополнительныеСвойства.Свойство("ОтменитьОбъектНаСогласование") Тогда
		Если ЭтотОбъект.ДополнительныеСвойства.ОтменитьОбъектНаСогласование Тогда
			РегистрыСведений.CW_ОбъектыНаСогласовании.ОчиститьДанныеРегистра(ОбъектСогласования);
		КонецЕсли;
	КонецЕсли;
	
	Если ЭтотОбъект.ДополнительныеСвойства.Свойство("ЗаписатьСостояниеОбъекта")
		И ЭтотОбъект.ДополнительныеСвойства.ЗаписатьСостояниеОбъекта Тогда
		РегистрыСведений.CW_СостояниеСогласованияОбъекта.ЗаписатьСостояниеОбъекта(ОбъектСогласования, ЭтотОбъект.ДополнительныеСвойства.СостояниеОбъекта);
	КонецЕсли;

КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	ВсегоЭтапов  	= Справочники.CW_ЭтапыСогласования.ПолучитьКоличествоЭтаповОбъектаСогласования(ОбъектСогласования);
	Наименование 	= "Этап "+Строка(ВсегоЭтапов+1);
	
	ДатаНачала  	= Неопределено;
	ПлановаяДатаЗавершения  = Неопределено;
	ДатаЗавершения  		= Неопределено;
	СостояниеСогласования  	= ПредопределенноеЗначение("Перечисление.CW_СостоянияСогласования.Черновик");
	Завершен		= Ложь;
	
	Для Каждого СтрокаТабличнойЧасти из  МаршрутСогласования Цикл
		СтрокаТабличнойЧасти.Событие 				= ПредопределенноеЗначение("Перечисление.CW_СобытияСогласования.ПустаяСсылка");
		СтрокаТабличнойЧасти.ДатаСобытия 			= Неопределено;
		СтрокаТабличнойЧасти.Замечания 				= "";
		СтрокаТабличнойЧасти.ПлановаяДата 			= Неопределено;
		СтрокаТабличнойЧасти.Получено 				= Неопределено;
		СтрокаТабличнойЧасти.Продолжительность 		= 0;
		СтрокаТабличнойЧасти.ОжидаетСогласования 	= Ложь;
	КонецЦикла;
	
КонецПроцедуры


#КонецЕсли

