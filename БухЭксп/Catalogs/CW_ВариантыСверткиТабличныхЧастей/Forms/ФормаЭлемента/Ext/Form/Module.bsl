&НаКлиенте
Процедура ОбработкаВыбораНомеклатуры(Ответ, ДополнительныеПараметры) Экспорт 
	// --- 
	
	Если (Ответ <> Неопределено) Тогда
		
		// проверяем, что такой номенклатуры ещё нет
		Если НЕ _ПроверитьНоменклатуру(Ответ) Тогда
			
			_УФК.ВывестиПредупреждение("Такая номенклатура уже выбрана.");
			Возврат;
			
		Иначе
			
			Нстр = Объект.НоменклатураСвертки.Добавить();
			Нстр.Номенклатура = Ответ;
			
			Элементы.НоменклатураСвертки.ТекущаяСтрока = Нстр.ПолучитьИдентификатор();
			
			ЭтаФорма.Модифицированность=Истина;
			
			НоменклатураСверткиНоменклатураПриИзмененииНаСервере(Элементы.НоменклатураСвертки.ТекущаяСтрока);

		КонецЕсли; 
		
	КонецЕсли; 
	
	// --- 
КонецПроцедуры
  

&НаСервере
Функция _ПроверитьНоменклатуру(Номенклатура)
	// --- 
	
	Если _сф.к_НайтиСтроку(Объект.НоменклатураСвертки.Выгрузить(),"Номенклатура",Номенклатура) = Неопределено Тогда
		
		Возврат(Истина);
		
	Иначе
		
		Возврат(Ложь);
		
	КонецЕсли; 
	
	// --- 
КонецФункции

