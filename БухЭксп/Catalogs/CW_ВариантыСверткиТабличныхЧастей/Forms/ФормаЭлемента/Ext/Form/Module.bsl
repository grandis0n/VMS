&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	_УФС.ОтключитьИсториюВыбораЭлементовФормы(ЭтаФорма);
	
	УстановитьВидимостьСтраницыДопКолонок();
	
	Если Объект.ВыводитьДополнительныеКолонки Тогда
		ДобавитьДополнительныеКолонки();
	КонецЕсли;
	
	ЗаполнитьЗначенияДополнительныхКолонок();
	
	УстановитьТекстШаблоновНаФорме();

	//Внешние подклчюаемые команды
	CW_ПодключаемыеКомандыСервер.ПриСозданииНаСервере(ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьТекстШаблоновНаФорме()
	
	Если ЗначениеЗаполнено(Объект.ШаблонСверткиПоГрузоперевозкам) Тогда
		ШаблонСверткиПоГрузоперевозкам = Объект.ШаблонСверткиПоГрузоперевозкам;
	Иначе
		ШаблонСверткиПоГрузоперевозкам = "<Укажите шаблон свертки>";
	КонецЕсли;
	Если ЗначениеЗаполнено(Объект.ШаблонСверткиПоГрузоперевозкамАнгл) Тогда
		ШаблонСверткиПоГрузоперевозкамАнгл = Объект.ШаблонСверткиПоГрузоперевозкамАнгл;
	Иначе
		ШаблонСверткиПоГрузоперевозкамАнгл = "<Укажите шаблон свертки>";
	КонецЕсли;

КонецПроцедуры


