	ПарамерыФормы = Новый Структура;
	ПарамерыФормы.Вставить("Шаблон",			Объект.ШаблонСверткиПоГрузоперевозкамАнгл);
	ПарамерыФормы.Вставить("РасходнаяСтатья",	Ложь);
	ПарамерыФормы.Вставить("ДоходнаяСтатья",	Истина);
	
