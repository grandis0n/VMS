&НаКлиенте
Процедура ОткрытьФайлДляПросмотра()
	
	Если ЭтоНовый() Тогда
		Возврат;
	КонецЕсли;    
	
	ДанныеФайла = CW_РаботаСФайламиКлиент.ДанныеФайла(ТекущаяСсылкаНаФайл(), УникальныйИдентификатор);	
	CW_РаботаСФайламиКлиент.ОткрытьФайл(ДанныеФайла);
	
КонецПроцедуры  

&НаКлиенте
Процедура СохранитьКак()
	
	Если ЭтоНовый() Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеФайла = CW_РаботаСФайламиКлиент.ДанныеФайла(ТекущаяСсылкаНаФайл(), УникальныйИдентификатор);	
	CW_РаботаСФайламиКлиент.СохранитьКак(ДанныеФайла);
	
КонецПроцедуры

&НаКлиенте
Функция ЭтоНовый()
	
	Возврат ТекущаяСсылкаНаФайл().Пустая();
	
КонецФункции

&НаКлиенте
Функция ТекущаяСсылкаНаФайл()
	
	ОбъектФормы = ЭтотОбъект.Объект; // СправочникОбъект
	Возврат ОбъектФормы.Ссылка;
	
КонецФункции

&НаКлиенте
Процедура ЗагрузитьФайл(Команда)
	
	Если Объект.Ссылка.Пустая() Тогда
		ПоказатьПредупреждение(, "Необходимо записать элемент!");
		Возврат;
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура;
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ПослеПомещенияФайлаНаСервер", ЭтотОбъект, ДополнительныеПараметры); 
	
	ПараметрыДиалога = Новый ПараметрыДиалогаПомещенияФайлов;
	ПараметрыДиалога.Заголовок  			= "Выберите файл";
	ПараметрыДиалога.Фильтр					= "(*.*)|*.*";
	ПараметрыДиалога.МножественныйВыбор	 	= Истина;  
	
	НачатьПомещениеФайлаНаСервер(ОписаниеОповещения,,,, ПараметрыДиалога, УникальныйИдентификатор);
	
КонецПроцедуры 

&НаКлиенте
Процедура ПослеПомещенияФайлаНаСервер(ПомещенныйФайл, ДополнительныеПараметры) Экспорт 
	
	Если ПомещенныйФайл = Неопределено Тогда
		Возврат;
	КонецЕсли;      
	
	ОсновнойТомХранения = CW_РаботаСФайламиСервер.ПолучитьОсновнойТомХранения();
	
	Успешно = CW_РаботаСФайламиСервер.ЗаписатьФайлВТомХранения(Объект.Ссылка, ПомещенныйФайл.Адрес, ОсновнойТомХранения);
	
	Если Не Успешно Тогда
		ПоказатьПредупреждение(, "Не удалось добавить файл!", ,"Ошибка добавления файла");
	Иначе  
		
		Объект.ИмяФайла		= ПомещенныйФайл.СсылкаНаФайл.Имя;
		Объект.Наименование = ПомещенныйФайл.СсылкаНаФайл.Имя;	
		ПолноеИмя    		= ПомещенныйФайл.СсылкаНаФайл.Имя;
		
		Объект.Расширение   = ПомещенныйФайл.СсылкаНаФайл.Расширение;
		
		ОбъектАрхива = ПолучитьОбъектАрхива(Объект.Владелец);
		
		ОповеститьОбИзменении(ОбъектАрхива); 
		ОповеститьОбИзменении(Тип("СправочникСсылка.CW_ОбъектыАрхива")); 
	КонецЕсли;
	
КонецПроцедуры     

&НаСервереБезКонтекста
Функция ПолучитьОбъектАрхива(ВладелецАрхива)
	
	Возврат ВладелецАрхива.ОбъектАрхива;
	
КонецФункции






