&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ТекущийПользователь=CW_Настройки.Пользователь();
	
	// установим объект  
	Если Параметры.Ключ.Пустая() Тогда
		ВладелецАрхива = CW_РаботаСФайламиСервер.ПолучитьВладельцаАрхиваПоОбъекту(Параметры.ЗначенияЗаполнения.Объект);
		
		Объект.Владелец = Параметры.ЗначенияЗаполнения.Объект;	
		Объект.Родитель = Параметры.ЗначенияЗаполнения.Родитель;
	КонецЕсли;
	
	ЭтоНовый = Объект.Ссылка.Пустая();
	
	Если Объект.Том.Пустая() Тогда
		
		// установим том
		
		УстановитьПривилегированныйРежим(Истина);
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		|	ТомаАрхива.Ссылка
		|ИЗ
		|	Справочник.CW_ТомаАрхива КАК ТомаАрхива
		|ГДЕ
		|	ТомаАрхива.Основной = ИСТИНА";
		Запрос.УстановитьПараметр("", );
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			
			Объект.Том = Выборка.Ссылка;
			
		КонецЕсли; 
		УстановитьПривилегированныйРежим(Ложь);
		
	КонецЕсли; 
	
	СформироватьПолноеИмяФайла();
	СформироватьРазмер();
	
	// --- 
	Если Объект.СпособХраненияАрхива = 1 Тогда
		Элементы.ПолноеИмя.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;	
	КонецЕсли;  
	
	УказанСтороннийВладелец = ЗначениеЗаполнено(Объект.ОбъектАрхиваВладелец);
	
	Элементы.ГруппаОблако.Видимость 		= (Объект.СпособХраненияАрхива = 1) И Не УказанСтороннийВладелец;
	Элементы.ГруппаХранение.Видимость 		= (Объект.СпособХраненияАрхива <> 1) И Не УказанСтороннийВладелец;
	Элементы.ФормаСохранитьКак.Видимость 	= (Объект.СпособХраненияАрхива <> 1) И Не УказанСтороннийВладелец;
	Элементы.ГруппаВладелецФайла.Видимость 	= УказанСтороннийВладелец;   
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	УказанСтороннийВладелец = ЗначениеЗаполнено(Объект.ОбъектАрхиваВладелец);
	Если Объект.СпособХраненияАрхива = 1 И Не УказанСтороннийВладелец Тогда 
		Если ПустаяСтрока(ПолноеИмя) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не указана ссылка на файл",,"ПолноеИмя",,Отказ); 
		Иначе
			ТекущийОбъект.ИмяФайла = ПолноеИмя;   
		КонецЕсли;
	КонецЕсли;	
	
КонецПроцедуры

