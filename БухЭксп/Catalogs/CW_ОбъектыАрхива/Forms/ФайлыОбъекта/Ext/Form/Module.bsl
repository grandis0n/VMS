&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Параметры.Свойство("РежимВыбора",	РежимВыбора);
	Параметры.Свойство("ОбъектАрхива",	ОбъектАрхива);
	Если ОбъектАрхива = Неопределено Тогда
		ВызватьИсключение "Не указан объект архива!";
	КонецЕсли;

	ТекущийПользователь = CW_Настройки.Пользователь();  
	
	ЗапрашиватьТипФайлаПриДобавленииВАрхив 	= Константы.CW_ЗапрашиватьТипФайлаПриДобавленииВАрхив.Получить();
	НепосредственноеУдаление = CW_ПраваДоступа.ПравоДоступно("НепосредственноеУдалениеОбъектовАрхива");
	
	ЭтаФорма.АвтоЗаголовок = Ложь;
	ЭтаФорма.Заголовок = "Файлы: " + СокрЛП(ОбъектАрхива);
	
	ВладелецАрхива = CW_РаботаСФайламиСервер.ПолучитьВладельцаАрхиваПоОбъекту(ОбъектАрхива);
	
	ЭлементОтбора = СписокФайлы.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение 	= Новый ПолеКомпоновкиДанных("Владелец");
  	ЭлементОтбора.ВидСравнения 		= ВидСравненияКомпоновкиДанных.Равно;
	ЭлементОтбора.ПравоеЗначение 	= ВладелецАрхива;
	ЭлементОтбора.Использование 	= Истина;

	// проверяем доступность основного тома
	ОсновнойТомХранения = CW_РаботаСФайламиСервер.ПолучитьОсновнойТомХранения();
	Если ЗначениеЗаполнено(ОсновнойТомХранения) Тогда
		ОсновнойТомДоступен = ОсновнойТомХранения.Активный и Не ОсновнойТомХранения.ТолькоЧтение;
	КонецЕсли;   
	
	Элементы.СписокФайлы.ТолькоПросмотр					= Не ОсновнойТомДоступен;
	Элементы.ФормаДобавитьФайлВГрузоперевозки.Видимость	= ТипЗнч(ОбъектАрхива) = Тип("СправочникСсылка.CW_Заказы");

	Если Элементы.Найти("ФормаУдалить") <> Неопределено Тогда
		Элементы.ФормаУдалить.Видимость = НепосредственноеУдаление;
	КонецЕсли;

КонецПроцедуры  

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	УстановитьВидимостьПредварительногоПросмотра();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьРезультатУдаленияФайлов(РезультатВыполнения, Дополнительныепараметры) Экспорт
	
	Если РезультатВыполнения.Статус = "Выполнено" Тогда
		
		Элементы.СписокФайлы.Обновить();
		ОповеститьОбИзменении(ОбъектАрхива);
		
	ИначеЕсли РезультатВыполнения.Статус = "Ошибка" Тогда
		
		ТекстПредупреждения = "Ошибка "+Дополнительныепараметры+" файлов!
		| По причине: "+ РезультатВыполнения.КраткоеПредставлениеОшибки + "
		| Информаиция об ошибке см. в журнале регистрации!";
		
		Если ТипЗнч(РезультатВыполнения.Сообщения) = Тип("Массив") Тогда
			Для Каждого СообщениеВМассиве из РезультатВыполнения.Сообщения Цикл
				СообщениеВМассиве.Сообщить();
			КонецЦикла;
		КонецЕсли;
		
		ПоказатьПредупреждение(,ТекстПредупреждения,,"Ошибка "+Дополнительныепараметры+" файлов");
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура АдресМиниатюрыНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;  
	
	ТекущаяСтрока = Элементы.СписокФайлы.ТекущаяСтрока;
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ЭтоГруппа(ТекущаяСтрока) Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеФайла = CW_РаботаСФайламиКлиент.ДанныеФайла(ТекущаяСтрока, УникальныйИдентификатор);	
	CW_РаботаСФайламиКлиент.ОткрытьФайл(ДанныеФайла);
	
КонецПроцедуры 

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	
	Если Не ЗавершениеРаботы Тогда
		Оповестить("ОбновитьНаличиеПрикрепленныхФайлов",ОбъектАрхива);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьФайлВГрузоперевозки(Команда)
	
	ТекущаяСтрока = Элементы.СписокФайлы.ТекущаяСтрока;
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ЭтоГруппа(ТекущаяСтрока) Тогда
		ПоказатьПредупреждение(,"Выберите элемент!");
		Возврат;
	КонецЕсли;
	
	АдресСпискаГрузоперевозок = ПолучитьАдресСпискаГрузоперевозокЗаказа();
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("АдресСпискаЗначений"	, АдресСпискаГрузоперевозок);
	ПараметрыФормы.Вставить("СписокСПометками"		, Истина);
	ПараметрыФормы.Вставить("ЗаголовокФормы"		, "Выберите грузоперевозки для помещения файла");
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ОбъектАрхива", 	ТекущаяСтрока);
	
	ОписаниеОповещения = новый ОписаниеОповещения("ПослеЗакрытияФормыВыбораГрузоперевозок", ЭтаФорма, ДополнительныеПараметры);
	
	ОткрытьФорму("ОбщаяФорма.CW_ФормаВыбораИзСписка",ПараметрыФормы, ЭтаФорма,,,,ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияФормыВыбораГрузоперевозок(РезультатВыбора, ДополнительныеПараметры) Экспорт
	
	Если РезультатВыбора = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ЭтоАдресВременногоХранилища(РезультатВыбора) Тогда
		
		РезультатВыполнения =  ОбработатьРезультаВыбораНаСервере(РезультатВыбора, ДополнительныеПараметры);
		
		Дополнительныепараметры = Новый Структура;
		
		ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
		ПараметрыОжидания.ВыводитьОкноОжидания = Истина;
		ОповещениеОЗавершении = Новый ОписаниеОповещения("ОбрабтатьРезультатаФоновогоЗаданая", ЭтотОбъект);
		
		ДлительныеОперацииКлиент.ОжидатьЗавершение(РезультатВыполнения, ОповещениеОЗавершении, ПараметрыОжидания);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ОбработатьРезультаВыбораНаСервере(РезультатВыбора, ДополнительныеПараметры)
	
	ВыбранныеЭлементы = ПолучитьИзВременногоХранилища(РезультатВыбора);

	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(Новый УникальныйИдентификатор);
	ПараметрыВыполнения.ОжидатьЗавершение 			= 0; // запускать сразу
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = "Добавление файлов к грузоперевозкам";
	ПараметрыВыполнения.ЗапуститьВФоне 				= Истина;
	ПараметрыВыполнения.ЗапуститьНеВФоне 			= ложь;
	
	ПараметрыПроцедуры = Новый Структура;
	
	ПараметрыПроцедуры.Вставить("ВыбранныеЭлементы", ВыбранныеЭлементы);
	ПараметрыПроцедуры.Вставить("ОбъектАрхива",		 ДополнительныеПараметры.ОбъектАрхива);
	
	Возврат ДлительныеОперации.ВыполнитьВФоне("Справочники.CW_ОбъектыАрхива.ДобавитьСсылкуНаОбъектАрхиваДляВыбранныхГрузоперевозок",ПараметрыПроцедуры, ПараметрыВыполнения);

КонецФункции

&НаКлиенте
Процедура ОбрабтатьРезультатаФоновогоЗаданая(РезультатВыполнения, Дополнительныепараметры) Экспорт
	
	Если РезультатВыполнения.Статус = "Выполнено" Тогда
		
		КоличествоПеревозок = ПолучитьИзВременногоХранилища(РезультатВыполнения.АдресРезультата);
		ПоказатьОповещениеПользователя("Добавление файлов к грузоперевозкам",,"Обработано "+Формат(КоличествоПеревозок,"ЧГ=0")+" грузоперевозок");
		
	ИначеЕсли РезультатВыполнения.Статус = "Ошибка" Тогда
		
		ТекстПредупреждения = "Ошибка добавления файлов к грузоперевозкам!
		| По причине: "+ РезультатВыполнения.КраткоеПредставлениеОшибки + "
		| Информаиция об ошибке см. в журнале регистрации!";
		
		Если ТипЗнч(РезультатВыполнения.Сообщения) = Тип("Массив") Тогда
			Для Каждого СообщениеВМассиве из РезультатВыполнения.Сообщения Цикл
				СообщениеВМассиве.Сообщить();
			КонецЦикла;
		КонецЕсли;
		
		ПоказатьПредупреждение(,ТекстПредупреждения,,"Ошибка добавления файлов к грузоперевозкам");
		
	КонецЕсли;
	
КонецПроцедуры



&НаСервере
Функция ПолучитьАдресСпискаГрузоперевозокЗаказа()
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	CW_Грузоперевозки.Ссылка КАК Ссылка,
	               |	CW_Грузоперевозки.CW_Представление КАК Представление
	               |ИЗ
	               |	Справочник.CW_Грузоперевозки КАК CW_Грузоперевозки
	               |ГДЕ
	               |	CW_Грузоперевозки.Заказ = &Заказ";
	
	Запрос.УстановитьПараметр("Заказ", ОбъектАрхива);
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	СписокВыбора = Новый СписокЗначений;
	Пока Выборка.Следующий() Цикл
		СписокВыбора.Добавить(Выборка.Ссылка, Выборка.Представление);
	КонецЦикла;

	Возврат ПоместитьВоВременноеХранилище(СписокВыбора, УникальныйИдентификатор);
	
КонецФункции

&НаКлиенте
Процедура СписокФайлыПриАктивизацииСтроки(Элемент)
	
	ПодключитьОбработчикОжидания("ОбработчикПоказаМиниатюры",0.1,Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработчикПоказаМиниатюры() 
	
	ТекущаяСтрока = Элементы.СписокФайлы.ТекущаяСтрока;
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если ТипЗнч(ТекущаяСтрока) = Тип("СтрокаГруппировкиДинамическогоСписка") тогда
		Возврат;
	КонецЕсли;
	
	ДанныеМиниатюры = ПолучитьДанныеНаСервере(ТекущаяСтрока); 
	Если ДанныеМиниатюры = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(ДанныеМиниатюры["Данные"]) = Тип("ДвоичныеДанные") Тогда
		ПотокВПамяти = ДанныеМиниатюры["Данные"].ОткрытьПотокДляЧтения(); 
		Попытка
			ДокументPDF.Прочитать(ПотокВПамяти);  
		Исключение
			ДанныеМиниатюры["ТекущаяСтраница"] = "СтраницаВсеФайлы";
		КонецПопытки;
	ИначеЕсли ТипЗнч(ДанныеМиниатюры["Данные"]) = Тип("Строка") Тогда
		АдресМиниатюры = ДанныеМиниатюры.Данные;	
	КонецЕсли;  
	
	Элементы.СтраницыПредпросмотра.ТекущаяСтраница = Элементы[ДанныеМиниатюры.ТекущаяСтраница];
	
КонецПроцедуры
  
&НаСервере
Функция ПолучитьДанныеНаСервере(Знач Ссылка) 
	
	Если ТипЗнч(Ссылка) = Тип("СтрокаГруппировкиДинамическогоСписка") тогда
		Возврат Неопределено;
	КонецЕсли;

	СписокРасширений = РаботаСФайламиСлужебный.СписокРасширенийДляПредпросмотра(); 
	СписокРасширений.Добавить("pdf");
	
	Расширение 			= СтрЗаменить(НРег(Ссылка.Расширение), ".","");
	Если СписокРасширений.НайтиПоЗначению(Расширение) = Неопределено Тогда 
		Возврат Неопределено;
	КонецЕсли;

	ДанныеМиниатюры = Новый Структура("Данные,ТекущаяСтраница", "","СтраницаВсеФайлы");
	
	ДвоичныеДанные  = CW_РаботаСФайламиСервер.ДвоичныеДанныеФайла(Ссылка);
	
	Если Расширение = "pdf" Тогда
		ДанныеМиниатюры.Данные 			= ДвоичныеДанные;
		ДанныеМиниатюры.ТекущаяСтраница = "СтраницаФайлыPDF"; 
	Иначе
		ДанныеМиниатюры.Данные 			=  ПоместитьВоВременноеХранилище(ДвоичныеДанные, УникальныйИдентификатор);
		ДанныеМиниатюры.ТекущаяСтраница =  "СтраницаВсеФайлы";
	КонецЕсли;
	
	Возврат ДанныеМиниатюры;
	
КонецФункции

&НаКлиенте
Процедура СписокФайлыПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)

	Отказ = Истина;   
	
	Если Группа Тогда 
		
		ЗначенияЗаполнения = Новый Структура;
		ЗначенияЗаполнения.Вставить("Владелец",	ВладелецАрхива);
		ЗначенияЗаполнения.Вставить("Родитель",	Родитель);
		
		СтруктураПараметров = Новый Структура;
		СтруктураПараметров.Вставить("ЭтоГруппа", 			Группа);
		СтруктураПараметров.Вставить("ЗначенияЗаполнения", ЗначенияЗаполнения);
		
		ОткрытьФорму("Справочник.CW_ОбъектыАрхива.ФормаГруппы", СтруктураПараметров, ЭтаФорма); 
		
	Иначе
		
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("Родитель", Родитель);
		
		ОписаниеОповещения = Новый ОписаниеОповещения("ПослеПомещенияФайловНаСервер", ЭтотОбъект, ДополнительныеПараметры); 
		
		ПараметрыДиалога = Новый ПараметрыДиалогаПомещенияФайлов;
		ПараметрыДиалога.Заголовок  			= "Выберите файлы";
		ПараметрыДиалога.Фильтр					= "(*.*)|*.*";
		ПараметрыДиалога.МножественныйВыбор	 	= Истина;  
		НачатьПомещениеФайловНаСервер(ОписаниеОповещения,,,ПараметрыДиалога, ЭтаФорма.УникальныйИдентификатор);  
		
	КонецЕсли;
	
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеПомещенияФайловНаСервер(ПомещенныеФайлы, ДополнительныеПараметры) Экспорт 
	
	Если ПомещенныеФайлы = Неопределено Тогда
		Возврат;
	КонецЕсли;      
	
	МассивПомещенныеФайлы = Новый Массив;
	Для Каждого ПомещенныйФайл из ПомещенныеФайлы Цикл
		ДанныеФайла = Новый Структура;
		ДанныеФайла.Вставить("Имя", 		ПомещенныйФайл.СсылкаНаФайл.Имя);
		ДанныеФайла.Вставить("Расширение", 	ПомещенныйФайл.СсылкаНаФайл.Расширение);
		ДанныеФайла.Вставить("Хранение", 	ПомещенныйФайл.Адрес);
		
		МассивПомещенныеФайлы.Добавить(ДанныеФайла);	
	КонецЦикла;
	
	ДополнительныеПараметры.Вставить("ПомещенныеФайлы", МассивПомещенныеФайлы);
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ПродолжитьПомещениеФалов", ЭтотОбъект, ДополнительныеПараметры);
	
	Если ЗапрашиватьТипФайлаПриДобавленииВАрхив Тогда
		
		ПараметрыВыбора = новый Структура;
		ПараметрыВыбора.Вставить("МножественныйВыбор", Ложь);  
		
		ОткрытьФорму("Справочник.CW_ТипыДокументовФайловогоАрхива.ФормаВыбора",ПараметрыВыбора, ЭтаФорма,,,,ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
	Иначе   
		
		ВыполнитьОбработкуОповещения(ОписаниеОповещения,Неопределено);   
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПродолжитьПомещениеФалов(РезультатВыбора, ДополнительныеПараметры) Экспорт
	
	Если РезультатВыбора = Неопределено и ЗапрашиватьТипФайлаПриДобавленииВАрхив Тогда
		ПоказатьПредупреждение(,"Не выбран тип документа. Добавление файла отменено!"); 
		Возврат;
	КонецЕсли;    
	
	МассивОбъектов = новый Массив;
	МассивОбъектов.Добавить(ОбъектАрхива);
	
	Успешно = CW_РаботаСФайламиСервер.ПрикрепитьФайлы(ДополнительныеПараметры.ПомещенныеФайлы, МассивОбъектов, РезультатВыбора,  ДополнительныеПараметры.Родитель); 
	
	Если Не Успешно Тогда
		ПоказатьПредупреждение(, "Не удалось добавить файл!", ,"Ошибка добавления файла");
	Иначе
		ОповеститьОбИзменении(ОбъектАрхива); 
		ОповеститьОбИзменении(Тип("СправочникСсылка.CW_ОбъектыАрхива")); 
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ДобавитьСсылкуНаФайл(Команда)
	
	ТекущаяСтрока = Элементы.СписокФайлы.ТекущаяСтрока;
	Если ТекущаяСтрока <> Неопределено Тогда
		Родитель = ПолучитьРодителяПоТекущейСсылке(ТекущаяСтрока);
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Родитель", Родитель);
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ПередНачаломДобавленияСсылки", ЭтотОбъект, ДополнительныеПараметры);
	
	ОткрытьФорму("Справочник.CW_ОбъектыАрхива.Форма.ФормаДобавленияСсылкиНаФайл", ,ЭтаФорма,,,,ОписаниеОповещения,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры    

&НаСервереБезКонтекста
Функция ПолучитьРодителяПоТекущейСсылке(Ссылка)

	Если ТипЗнч(Ссылка) = Тип("СтрокаГруппировкиДинамическогоСписка") тогда
		Возврат Неопределено;
	КонецЕсли;

	Если Ссылка.ЭтоГруппа Тогда
		Возврат Ссылка;
	КонецЕсли;
	
	Возврат Ссылка.Родитель;   
	
КонецФункции

&НаКлиенте
Процедура ПередНачаломДобавленияСсылки(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ДополнительныеПараметры.Вставить("Результат", Результат);
	
	ПараметрыВыбора = новый Структура;
	ПараметрыВыбора.Вставить("МножественныйВыбор", Ложь);
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ПослеВыбораТипаДокумента", ЭтотОбъект, ДополнительныеПараметры);
	
	Если ЗапрашиватьТипФайлаПриДобавленииВАрхив Тогда
		ОткрытьФорму("Справочник.CW_ТипыДокументовФайловогоАрхива.ФормаВыбора",ПараметрыВыбора,ЭтаФорма,,,,ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	Иначе
		ВыполнитьОбработкуОповещения(ОписаниеОповещения,Неопределено);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораТипаДокумента(РезультатВыбора, ДополнительныеПараметры) Экспорт
	
	Если РезультатВыбора = Неопределено и ЗапрашиватьТипФайлаПриДобавленииВАрхив Тогда
		ПоказатьПредупреждение(,"Не выбран тип документа. Добавление файла отменено!"); 
		Возврат;
	КонецЕсли;    
	
	CW_РаботаСФайламиСервер.ДобавитьСсылкуНаФайл(ДополнительныеПараметры.Результат, ОбъектАрхива, ДополнительныеПараметры.Родитель, РезультатВыбора);
	
	Элементы.СписокФайлы.Обновить();
	
	ОповеститьОбИзменении(ОбъектАрхива);

КонецПроцедуры     

