        Возврат;
    КонецЕсли;

	УдалитьЭлементНаСервере(ДополнительныеПараметры.Ссылка); 
	
	ОповеститьОбИзменении(Тип("СправочникСсылка.CW_ОбъектыАрхива"));

КонецПроцедуры  

