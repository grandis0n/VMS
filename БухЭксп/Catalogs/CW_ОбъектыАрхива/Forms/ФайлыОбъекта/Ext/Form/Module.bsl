&НаКлиенте
Процедура СохранитьКак(Команда)
	
	ТекущаяСтрока = Элементы.СписокФайлы.ТекущаяСтрока;
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ЭтоГруппа(ТекущаяСтрока) Тогда
		Возврат;
	КонецЕсли; 
	
	ДанныеФайла = CW_РаботаСФайламиКлиент.ДанныеФайла(ТекущаяСтрока, УникальныйИдентификатор);	
	CW_РаботаСФайламиКлиент.СохранитьКак(ДанныеФайла);
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьВКаталог(Команда)
	
	ВыделенныеСтроки = Элементы.СписокФайлы.ВыделенныеСтроки;
	Если ВыделенныеСтроки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	ПолучаемыеФайлы = ПолучитьМассивПолучаемыхФайлов(ВыделенныеСтроки);
	Если ПолучаемыеФайлы.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Не удалось получить данные. Проверьте существование файлов в томе!");
		Возврат;
	КонецЕсли;    
	
	ПараметрыДиалогаПолученияФайлов = Новый ПараметрыДиалогаПолученияФайлов;
	ПараметрыДиалогаПолученияФайлов.ВыборКаталога 	= Истина;
	ПараметрыДиалогаПолученияФайлов.Заголовок 		= "Выберите каталог для сохранения выбранынх файлов";
	
	НачатьПолучениеФайловССервера(ПолучаемыеФайлы, ПараметрыДиалогаПолученияФайлов)
	
КонецПроцедуры    

&НаКлиенте
Функция ПолучитьМассивПолучаемыхФайлов(ВыделенныеСтроки)
	
	ПолучаемыеФайлы = Новый Массив; 
	
	Для Каждого Ссылка из ВыделенныеСтроки Цикл
		
		Если ЭтоГруппа(Ссылка) Тогда
			Продолжить;
		КонецЕсли;   
		
		Если СпособХраненияАрхива(Ссылка) = 1 Тогда
			Продолжить;
		КонецЕсли;

		ДанныеФайла = CW_РаботаСФайламиКлиент.ДанныеФайла(Ссылка, Новый УникальныйИдентификатор);
		Если ДанныеФайла.СсылкаНаДвоичныеДанныеФайла = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ОписаниеПередаваемогоФайла = Новый ОписаниеПередаваемогоФайла;
		ОписаниеПередаваемогоФайла.Имя 		= ДанныеФайла.ИмяФайлаДляСохранения;
		ОписаниеПередаваемогоФайла.Хранение = ДанныеФайла.СсылкаНаДвоичныеДанныеФайла;
	
		ПолучаемыеФайлы.Добавить(ОписаниеПередаваемогоФайла);
		
	КонецЦикла;
	
	Возврат ПолучаемыеФайлы;
	
КонецФункции  

&НаКлиенте
Процедура СписокФайлыПроверкаПеретаскивания(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Строка, Поле)    
	
	СтандартнаяОбработка = Ложь;
	
КонецПроцедуры   


&НаКлиенте
Процедура СписокФайлыПеретаскивание(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Строка, Поле) 
	

	Если ТипЗнч(ПараметрыПеретаскивания.Значение) = Тип("Массив") 
		и ТипЗнч(ПараметрыПеретаскивания.Значение[0]) = Тип("СправочникСсылка.CW_ОбъектыАрхива") Тогда  
		//Перетаскивание в пределах спискоа стандратно
		Возврат;
	КонецЕсли;
	
	СтандартнаяОбработка=Ложь;    
	
	Если Не ОсновнойТомДоступен Тогда
		ПоказатьПредупреждение(, "Основной том хранения файлов не доступен!");
		Возврат;
	КонецЕсли;
	
	ТекущаяСтрока = Элементы.СписокФайлы.ТекущаяСтрока;
	Если ТекущаяСтрока <> Неопределено Тогда
		Родитель = ПолучитьРодителяПоТекущейСсылке(ТекущаяСтрока);
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Родитель", Родитель);
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ПослеПомещенияФайловНаСервер", ЭтотОбъект, ДополнительныеПараметры);  
	
	ОписанияПередаваемыхФайлов = новый Массив; 
	
	Если ТипЗнч(ПараметрыПеретаскивания.Значение) = Тип("СсылкаНаФайл") Тогда  
		
		ОписаниеПередаваемогоФайла = Новый ОписаниеПередаваемогоФайла;
		ОписаниеПередаваемогоФайла.Имя = ПараметрыПеретаскивания.Значение.Файл.ПолноеИмя;
		
		ОписанияПередаваемыхФайлов.Добавить(ОписаниеПередаваемогоФайла);
		
	ИначеЕсли ТипЗнч(ПараметрыПеретаскивания.Значение) = Тип("Массив") Тогда
		
		Для каждого СсылкаНаФайл из ПараметрыПеретаскивания.Значение Цикл 
			Если ТипЗнч(СсылкаНаФайл) = Тип("СсылкаНаФайл") Тогда  
				ОписаниеПередаваемогоФайла = Новый ОписаниеПередаваемогоФайла;
				ОписаниеПередаваемогоФайла.Имя = СсылкаНаФайл.Файл.ПолноеИмя;
				
				ОписанияПередаваемыхФайлов.Добавить(ОписаниеПередаваемогоФайла); 
			КонецЕсли;  
		КонецЦикла;  
		
	КонецЕсли;
	
	Если ОписанияПередаваемыхФайлов.Количество() > 0 Тогда
		НачатьПомещениеФайловНаСервер(ОписаниеОповещения,,, ОписанияПередаваемыхФайлов, ЭтаФорма.УникальныйИдентификатор);
	КонецЕсли;
	

КонецПроцедуры

