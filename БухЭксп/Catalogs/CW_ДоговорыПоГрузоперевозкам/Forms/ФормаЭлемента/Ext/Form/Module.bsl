&НаКлиенте
Процедура СформироватьНаименование()
	
	Если СпособРедактированияНаименования = 1 Тогда
		Возврат;
	КонецЕсли;
	
	ВидДокумента 	= ПолучитьКраткоеНаименование(Объект.ВидДокумента);
	Номер 			= ?(ЗначениеЗаполнено(Объект.НомерДоговора), " №" + СокрЛП(Объект.НомерДоговора), "");
	Дата 			= ?(ЗначениеЗаполнено(Объект.ДатаДоговора), " от "+ Формат(Объект.ДатаДоговора,"ДФ=dd.MM.yyyy"), "");
	
	ШаблонПредставления = "[ВидДокумента][Номер][Дата]";
	
	СтрПредставление = СтрЗаменить(ШаблонПредставления, "[ВидДокумента]", 	ВидДокумента);
	СтрПредставление = СтрЗаменить(СтрПредставление, 	"[Номер]", 			Номер);
	СтрПредставление = СтрЗаменить(СтрПредставление, 	"[Дата]", 			Дата);
	
	Объект.Наименование = СтрПредставление;
	
КонецПроцедуры

