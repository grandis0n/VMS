 
 &НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	//Подсистема.СтатусыДокументов
	CW_СтатусыДокументовСервер.ПриСозданииНаСервере(ЭтаФорма,Отказ, СтандартнаяОбработка);
	//Подсистема.СтатусыДокументов
	
	//Подсистема.СогласованиеОбъктов
	CW_СогласованиеСервер.ПриСозданииНаСервере(ЭтаФорма,Отказ, СтандартнаяОбработка);
	//Подсистема.СогласованиеОбъктов
	
	//Подсистема.ГруппыУслугПриложенийИДоговоров
	CW_ГруппыУслугСервер.ПриСозданииНаСервере(ЭтаФорма, Отказ, СтандартнаяОбработка); 
	//Подсистема.ГруппыУслугПриложенийИДоговоров
	
	//Подсистема.ДополнительныеХарактиристикиДоговоров
	CW_ДополнительныеХарактиристикиДоговоровСервер.ПриСозданииНаСервере(ЭтаФорма, Отказ, СтандартнаяОбработка);
	//Подсистема.ДополнительныеХарактиристикиДоговоров
	
	//Подсистема.УчетПриложенийДоговоров
	CW_УчетПриложенийДоговоровСервер.ПриСозданииНаСервере(ЭтаФорма, Отказ, СтандартнаяОбработка);
	//Подсистема.УчетПриложенийДоговоров
	
	//Подсистема.ОригиналыДокументов
	CW_ОригиналыДокументовСервер.ПриСозданииНаСервере(ЭтаФорма, Отказ, СтандартнаяОбработка);
	//Подсистема.ОригиналыДокументов
	
	//Наличие прикрепленных файлов
	_УФКС.УстановитьНаличиеПрикрепленныхФайловПриСозданииФормыНаСервере(ЭтаФорма);
	//Наличие прикрепленных файлов
	
	ВедениеБухгалтескогоУчетаМСФО 			= ПолучитьФункциональнуюОпцию("CW_ВедениеБухгалтескогоУчетаМСФО");
	ВалютаРегламентированногоУчетаРубль 	= ПолучитьФункциональнуюОпцию("CW_ВалютаРегламентированногоУчетаРубль");
	РедактированиеЗапрещено_ШаблоныУслуг 	= РегистрыСведений.CW_ДоступныеСправочникиПоГруппамПользователей.РедактированиеОбъектаЗапрещено("РегистрСведений.CW_ШаблоныУслуг");
	
	Если Не ВалютаРегламентированногоУчетаРубль или ВедениеБухгалтескогоУчетаМСФО Тогда
		Элементы.ВидДоговора.СписокВыбора.Добавить(Перечисления.ВидыДоговоровКонтрагентов.Прочее);
	КонецЕсли;
	
	БазоваяВалюта = CW_Настройки.ВалютаРегламентированногоУчета();
	Если Параметры.Ключ.Пустая() Тогда
		ДатаДоговора = ТекущаяДата();
		
		Если Объект.Организация.Пустая() Тогда
			Объект.Организация = CW_Настройки.ОсновнаяОрганизация();
		КонецЕсли; 
		
		Объект.БухгалтерскийУчет = CW_Настройки.ПолучитьНастройкуПользователя(ПараметрыСеанса.ТекущийПользователь,"УстанавливатьДляНовыхДоговоровБУ");;
		
	КонецЕсли; 
	
	Если  ПолучитьФункциональнуюОпцию("CW_ИспользуютсяЗависимыеУслуги") Тогда
		Если Объект.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПокупателем Тогда
			ИспользуютсяЗависимыеУслуги		= ПолучитьФункциональнуюОпцию("CW_ИспользуютсяЗависимыеУслугиПоИсходящимДоговорам");
			ЗависимыеУслугиУчитыватьГруз	= ПолучитьФункциональнуюОпцию("CW_ЗависимыеУслугиУчитыватьГрузПоИсходящим");
		ИначеЕсли Объект.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком Тогда
			ИспользуютсяЗависимыеУслуги		= ПолучитьФункциональнуюОпцию("CW_ИспользуютсяЗависимыеУслугиПоВходяимДоговорам");
			ЗависимыеУслугиУчитыватьГруз	= ПолучитьФункциональнуюОпцию("CW_ЗависимыеУслугиУчитыватьГрузПоВходящим");
			ЗависимыеУслугиУчитыватьКлиентаПоВходящим 	= ПолучитьФункциональнуюОпцию("CW_ЗависимыеУслугиУчитыватьКлиентаПоВходящим");
		КонецЕсли;
	КонецЕсли;

	ОграничиватьУслугиПоДоговорам = ПолучитьФункциональнуюОпцию("CW_ОграничиватьУслугиПоДоговорам");
	Если ОграничиватьУслугиПоДоговорам Тогда
		ПолучитьРазрешениеНаредактированиеУслугПоТипуДоговора();
	КонецЕсли;
	
	СписокЗависимыхУслуг.Параметры.УстановитьЗначениеПараметра("Договор", Объект.Ссылка);
	
	СпособРедактированияНаименования =  ?(Объект.РедактироватьНаименование,1,0);
	
	_УФС.ВключитьКлассическийВидЭлементаФормы(Элементы.ВидДоговора);
	_УФС.ВключитьКлассическийВидЭлементаФормы(Элементы.ВалютаДоговора);
	_УФС.ВключитьКлассическийВидЭлементаФормы(Элементы.Организация);
	          
	_УправлениеЭлементамиФормы();
	
	// контроль для разрешения изменения реквизитов
	ЕстьПроведенныеДокументы = ЕстьПроведенныеДокументыПоДоговору(Объект.Ссылка);		
	
	РедактированиеЗапрещено	= РегистрыСведений.CW_ДоступныеСправочникиПоГруппамПользователей.РедактированиеОбъектаЗапрещено(Тип("СправочникСсылка.CW_ДоговорыПоГрузоперевозкам"));

	Если РедактированиеЗапрещено Тогда
		
		ЭтаФорма.ТолькоПросмотр 						= Истина;
		Элементы.ПараметрыДоговора.ТолькоПросмотр 		= Истина;
		Элементы.ДокументыДоходов.ТолькоПросмотр 		= Истина;
		Элементы.ДокументыРасходов.ТолькоПросмотр 		= Истина;
		Элементы.ШаблоныУслуг.ТолькоПросмотр 			= Истина;
		
		Элементы.ПараметрыДоговораКнопкаИзменить.Доступность 	= Ложь;
		Элементы.ДокументыДоходовКнопка2.Доступность 			= Ложь;
		Элементы.ДокументыРасходовКнопка2.Доступность 			= Ложь;
		Элементы.ШаблоныУслугКнопка4.Доступность 				= Ложь;
		
		Элементы.СпособРедактированияНаименования.Доступность = Ложь;
	КонецЕсли; 
	
	ТекущийУчетныйДоговор = Объект.УчетныйДоговор;
	
	ОтображатьТипДоговора = CW_Настройки.ПолучитьНастройкуПользователя(ПараметрыСеанса.ТекущийПользователь,"ОтображатьТипДоговора");
	Элементы.ТипДоговора.Видимость = ОтображатьТипДоговора;
	
	
	//Внешние подклчюаемые команды
	CW_ПодключаемыеКомандыСервер.ПриСозданииНаСервере(ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	
	//Подсистема.ГруппыУслугПриложенийИДоговоров
	CW_ГруппыУслугСервер.ПослеЗаписиНаСервере(ЭтаФорма, ТекущийОбъект, ПараметрыЗаписи);
	//Подсистема.ГруппыУслугПриложенийИДоговоров
	
	//Подсистема.СтатусыДокументов
	CW_СтатусыДокументовСервер.ПослеЗаписиНаСервере(ЭтаФорма, ТекущийОбъект, ПараметрыЗаписи);
	//Подсистема.СтатусыДокументов
	
	//Подсистема.ДополнительныеХарактиристикиДоговоров
	CW_ДополнительныеХарактиристикиДоговоровСервер.ПослеЗаписиНаСервере(ЭтаФорма, ТекущийОбъект, ПараметрыЗаписи);
	//Подсистема.ДополнительныеХарактиристикиДоговоров
	
	//Подсистема.УчетПриложенийДоговоров
	CW_УчетПриложенийДоговоровСервер.ПослеЗаписиНаСервере(ЭтаФорма, ТекущийОбъект, ПараметрыЗаписи);
	//Подсистема.УчетПриложенийДоговоров
	
	//Подсистема.ОригиналыДокументов
	CW_ОригиналыДокументовСервер.ПослеЗаписиНаСервере(ЭтаФорма, ТекущийОбъект, ПараметрыЗаписи);
	//Подсистема.ОригиналыДокументов

КонецПроцедуры


// Выполняет проверку наличия проведенных документов по договору
&НаСервереБезКонтекста
Функция ЕстьПроведенныеДокументыПоДоговору(ТекущаяСсылка)
	
	Если не ЗначениеЗаполнено(ТекущаяСсылка) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	|	CW_ДокументыПоДоговорамИПриложениям.Ссылка КАК Ссылка
	|ИЗ
	|	КритерийОтбора.CW_ДокументыПоДоговорамИПриложениям(&Договор) КАК CW_ДокументыПоДоговорамИПриложениям
	|ГДЕ
	|	CW_ДокументыПоДоговорамИПриложениям.Ссылка.Проведен = ИСТИНА";
	
	Запрос.УстановитьПараметр("Договор", ТекущаяСсылка);
	
	РезультатЗапроса 	= Запрос.Выполнить();
	Возврат НЕ РезультатЗапроса.Пустой();	
	
КонецФункции





&НаСервере
Процедура ПолучитьРазрешениеНаредактированиеУслугПоТипуДоговора()
	
	Если Не ЗначениеЗаполнено(Объект.ВидДоговора) Тогда
		РазрешеноРедактированиеУслуг = Ложь;
	КонецЕсли;
	
	Если Объект.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком Тогда
		РазрешеноРедактированиеУслуг 	= CW_ПраваДоступа.ПравоДоступно("РедактироватьУслугиПоВходящимДоговорам");
	ИначеЕсли Объект.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПокупателем Тогда
		РазрешеноРедактированиеУслуг 	= CW_ПраваДоступа.ПравоДоступно("РедактироватьУслугиПоИсходящимДоговорам");
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	_УправлениеЭлементамиФормы();
	УстановитьОтборДинамическихСписков();
	
	Если КомментарийИзменен Тогда
		КомментарийИзменен = Ложь;
		Оповестить("ОбновитьКоментарийДоговораНаФрме");
	Конецесли;
	
	Оповестить("ОбновитьАдресУслугДоговора");
	
КонецПроцедуры


&НаСервере
Процедура _УправлениеЭлементамиФормы()

	Если Объект.ВалютаДоговора = БазоваяВалюта Тогда
		Элементы.ВзаиморасчетыВУЕ.Видимость = Ложь;
	Иначе
		Элементы.ВзаиморасчетыВУЕ.Видимость = Истина;
	КонецЕсли; 	
	
	Элементы.Наименование.ТолькоПросмотр = (НЕ Объект.РедактироватьНаименование);
	
	Элементы.ГруппаУчетныйДоговор.Видимость 				=  Объект.БухгалтерскийУчет;
	Элементы.УчетныйДоговор.Видимость 						=  Объект.БухгалтерскийУчет;
	Элементы.СоздатьУчетныйДоговор.Видимость 				=  Объект.БухгалтерскийУчет;
	Элементы.НадписьСлужебныеДоговора.Видимость 			=  Объект.БухгалтерскийУчет; 
	Элементы.ДатаНачалаВеденияБухгалтерскогоУчета.Видимость =  Объект.БухгалтерскийУчет; 
	
	ВидимостьЗакладок = (НЕ Объект.Ссылка.Пустая());   
	
	ПросмотрРасходов 			= CW_ПраваДоступа.ПравоДоступно("ПросмотрФинансов_Расходы");
	ПросмотрДоходов 			= CW_ПраваДоступа.ПравоДоступно("ПросмотрФинансов_Доходы");
	
	Элементы.СтраницаПараметры.Видимость				= ВидимостьЗакладок;
	Элементы.СтраницаДокументыДоходов.Видимость			= ВидимостьЗакладок И Объект.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПокупателем и ПросмотрДоходов;
	Элементы.СтраницаДокументыРасходов.Видимость		= ВидимостьЗакладок И Объект.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком и ПросмотрРасходов;
	Элементы.СтраницаШаблоныУслуг.Видимость				= ВидимостьЗакладок;
	Элементы.СтраницаНоменклатураПоДоговору.Видимость	= ВидимостьЗакладок;
	
	ОграничиватьНоменклатуруПриИзмененииНаСервере();
	
	Если ОграничиватьУслугиПоДоговорам Тогда
		Элементы.ОграничиватьНоменклатуру.Доступность 		= РазрешеноРедактированиеУслуг;
		Элементы.УстановкаУслугПоДоговору.ТолькоПросмотр 	= Не РазрешеноРедактированиеУслуг;
	КонецЕсли;


	Если ДоговорДляОтбора.Пустая() Тогда
		
		Если ВидимостьЗакладок Тогда
			
			ДоговорДляОтбора = Объект.Ссылка;
			ПараметрыДоговора.Параметры.УстановитьЗначениеПараметра("Договор",ДоговорДляОтбора);
			_УФС.ДобавитьОтбор(ПараметрыДоговора.Отбор,"Договор",,ДоговорДляОтбора);
            Элементы.ПараметрыДоговора.Обновить();
			
			ШаблоныУслуг.Отбор.Элементы.Очистить();
			_УФС.ДобавитьОтбор(ШаблоныУслуг.Отбор,"Договор",,ДоговорДляОтбора);
			_УФС.ДобавитьОтбор(ШаблоныУслуг.Отбор,"ПриложениеКДоговору",,ПредопределенноеЗначение("Справочник.CW_ПриложенияКДоговорам.ПустаяСсылка"));

			Если Объект.ВидДоговора=Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком Тогда
				
				ДокументыРасходов.Параметры.УстановитьЗначениеПараметра("Договор",ДоговорДляОтбора);
				Элементы.ДокументыРасходов.Обновить();
				Элементы.СтраницаДокументыРасходов.Видимость = Истина;
				// --- 
				_УФС.ДобавитьОтбор(ШаблоныУслуг.Отбор,"РасходнаяСтатья",,Истина);
				Элементы.ШаблоныУслуг.Обновить();
				
			Иначе
				
				ДокументыДоходов.Параметры.УстановитьЗначениеПараметра("Договор",ДоговорДляОтбора);
				Элементы.ДокументыДоходов.Обновить();
				Элементы.СтраницаДокументыДоходов.Видимость = Истина;
				// --- 
				_УФС.ДобавитьОтбор(ШаблоныУслуг.Отбор,"ДоходнаяСтатья",,Истина);
				Элементы.ШаблоныУслуг.Обновить();
				
			КонецЕсли; 
			
		КонецЕсли; 
		
	КонецЕсли; 
	
	Элементы.СписокЗависимыхУслуг.Видимость = ИспользуютсяЗависимыеУслуги;
	
	Элементы.ШаблоныУслуг.ТолькоПросмотр 				= РедактированиеЗапрещено_ШаблоныУслуг;
	Элементы.ШаблоныУслугКоманднаяПанель.Доступность 	= НЕ РедактированиеЗапрещено_ШаблоныУслуг;
	
	УстановитьОтборДинамическихСписков();
	
	//Подсистема.ГруппыУслугПриложенийИДоговоров
	Элементы.ИспользуетсяОграниченияПоГруппамУслуг.Видимость = Объект.ВидДоговора = ПредопределенноеЗначение("Перечисление.ВидыДоговоровКонтрагентов.СПокупателем"); 
	//Подсистема.ГруппыУслугПриложенийИДоговоров
	
	// --- 
КонецПроцедуры

&НаСервере
Процедура УстановитьОтборДинамическихСписков()
	
	УстановкаУслугПоДоговору.Параметры.УстановитьЗначениеПараметра("Договор"	, Объект.Ссылка);
	УстановкаУслугПоДоговору.Параметры.УстановитьЗначениеПараметра("ТекущаяДата", ТекущаяДата());
	УстановкаУслугПоДоговору.Параметры.УстановитьЗначениеПараметра("ПустаяДата"	, Дата(1,1,1));
	
КонецПроцедуры
// ---------------------------------------------------------------------------- 

&НаКлиенте
Процедура СоздатьУчетныйДоговор(Команда)
	
	Если НЕ Объект.УчетныйДоговор.Пустая() Тогда
		
		_УФК.ВывестиПредупреждение("Договор уже создан!");
		Возврат;
		
	КонецЕсли; 
	
	// проверяем заполненные поля
	
	Если Объект.Организация.Пустая() Тогда
		
		_УФК.ВывестиПредупреждение("Не задана организация.");
		Возврат;
		
	КонецЕсли; 
	
	Если Объект.Владелец.Пустая() Тогда
		
		_УФК.ВывестиПредупреждение("Не задан контрагент.");
		Возврат;
		
	КонецЕсли;

	Если СокрЛП(Объект.НомерДоговора)="" Тогда
		
		_УФК.ВывестиПредупреждение("Не задан номер.");
		Возврат;
		
	КонецЕсли;
	
	Если Объект.ДатаДоговора=Дата(1,1,1) Тогда
		
		_УФК.ВывестиПредупреждение("Не задана дата договора.");
		Возврат;
		
	КонецЕсли;

	Если Объект.ВидДоговора.Пустая() Тогда
		
		_УФК.ВывестиПредупреждение("Не задан вид договора.");
		Возврат;
		
	КонецЕсли;
	
	// --- 
	
	_СоздатьУчетныйДоговор();
	
КонецПроцедуры

&НаСервере
Процедура _СоздатьУчетныйДоговор()
	
	Запрос = Новый Запрос;
	Запрос.Текст =	"ВЫБРАТЬ ПЕРВЫЕ 1
	              	|	ДоговорыКонтрагентов.Ссылка КАК Ссылка
	              	|ИЗ
	              	|	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
	              	|ГДЕ
	              	|	ДоговорыКонтрагентов.Организация = &Организация
	              	|	И ДоговорыКонтрагентов.Номер = &Номер
	              	|	И ДоговорыКонтрагентов.Дата = &Дата
	              	|	И ДоговорыКонтрагентов.Владелец = &Владелец
	              	|	И ДоговорыКонтрагентов.ВидДоговора = &Вид
	              	|	И ДоговорыКонтрагентов.ВалютаВзаиморасчетов = &ВалютаВзаиморасчетов
	              	|	И ДоговорыКонтрагентов.РасчетыВУсловныхЕдиницах = &РасчетыВУсловныхЕдиницах"; 
	
	Запрос.УстановитьПараметр("Организация", Объект.Организация);  
	Запрос.УстановитьПараметр("Номер",		 Объект.НомерДоговора); 
	Запрос.УстановитьПараметр("Дата",	  	 Объект.ДатаДоговора); 
	Запрос.УстановитьПараметр("Владелец",	 Объект.Владелец); 
	Запрос.УстановитьПараметр("Вид",		 Объект.ВидДоговора); 
	Запрос.УстановитьПараметр("ВалютаВзаиморасчетов", 		Объект.ВалютаДоговора);
	Запрос.УстановитьПараметр("РасчетыВУсловныхЕдиницах", 	Объект.ВзаиморасчетыВУЕ);
	
	//Для версии КОРП 
	ЭтоВерсияКОРП = ВариантыПриложений.ЭтоВерсияКОРП();
	Если ЭтоВерсияКОРП Тогда
		//Ищем по головной организации
		Запрос.УстановитьПараметр("Организация", Объект.Организация.ГоловнаяОрганизация); 
	КонецЕсли;
	//Для версии КОРП
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Если Выборка.Следующий() Тогда
		УчетныйДоговор = Выборка.Ссылка; 	
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(УчетныйДоговор) Тогда
		
		Договор = Справочники.ДоговорыКонтрагентов.СоздатьЭлемент(); 
		
		СтрокаРеквизитов = "Наименование,Владелец,Организация,Номер:НомерДоговора,Дата:ДатаДоговора,ВидДоговора,ВалютаВзаиморасчетов:ВалютаДоговора,РасчетыВУсловныхЕдиницах:ВзаиморасчетыВУЕ";
		_сф.ст_ЗаполнитьСвойства(Договор,СтрокаРеквизитов,Объект);

		//Для версии КОРП 
		Если ЭтоВерсияКОРП Тогда
			Договор.Организация = Объект.Организация.ГоловнаяОрганизация;  
		КонецЕсли;
		//Для версии КОРП 
		
		Договор.СпособЗаполненияСтавкиНДС 	= ПредопределенноеЗначение("Перечисление.СпособыЗаполненияСтавкиНДС.Автоматически");
		Договор.СпособВыставленияДокументов = ПредопределенноеЗначение("Перечисление.СпособыВыставленияДокументов.Автоматически");
		
		Договор.Записать(); 
		
		УчетныйДоговор = Договор.Ссылка;
		
	КонецЕсли;   
	
	Объект.УчетныйДоговор = УчетныйДоговор;	
	ТекущийУчетныйДоговор = УчетныйДоговор;

КонецПроцедуры
 

