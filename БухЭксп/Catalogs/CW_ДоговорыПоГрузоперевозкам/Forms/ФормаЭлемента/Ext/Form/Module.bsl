		СтандартнаяОбработка = Ложь;
		_УФК.ОткрытьСписокФайловОбъекта(ЭтаФорма, ВыбраннаяСтрока);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьГрупппыУслугИзДоговора(Команда)
	
	Если Объект.Ссылка.Пустая() тогда
		ПоказатьПредупреждение(,"Необходимо записать договор!");
		Возврат;
	КонецЕсли;
	
	Режим = РежимДиалогаВопрос.ДаНет;
	Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаКопированияГруппУслуг", ЭтотОбъект);
	ПоказатьВопрос(Оповещение, "Группы услуг будут скопированы из выбранного договора. Продолжить?", Режим, 0);	
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияВопросаКопированияГруппУслуг(Результат, Параметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Нет Тогда
        Возврат;
    КонецЕсли;

	Оповещение = Новый ОписаниеОповещения("ПродолжитьКопированиеГруппУслуг",ЭтотОбъект);
	
	ПараметрыФормыВыбора = новый Структура;
	ПараметрыФормыВыбора.Вставить("РежимВыбора", Истина);
	ПараметрыФормыВыбора.Вставить("МножественыйВыбор", Ложь);
	ПараметрыФормыВыбора.Вставить("ЗакрыватьПриВыборе", Истина);
	
	ОткрытьФорму("Справочник.CW_ДоговорыПоГрузоперевозкам.ФормаВыбора", ПараметрыФормыВыбора, ЭтаФорма,,,,Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ПродолжитьКопированиеГруппУслуг(ВыбранноеЗначение, Параметры) Экспорт

	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	РезультатВыполнения =  ПродолжитьКопированиеГруппУслугВФоне(ВыбранноеЗначение);
	
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ВыводитьОкноОжидания = Истина;
	ОповещениеОЗавершении = Новый ОписаниеОповещения("ОбработатьРезультатКопированияГруппУслуг", ЭтотОбъект);
	
	ДлительныеОперацииКлиент.ОжидатьЗавершение(РезультатВыполнения, ОповещениеОЗавершении, ПараметрыОжидания);

КонецПроцедуры

&НаСервере
Функция ПродолжитьКопированиеГруппУслугВФоне(ЗначениеКопирования)
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(Новый УникальныйИдентификатор);
	ПараметрыВыполнения.ОжидатьЗавершение 			= 0; // запускать сразу
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = "Копирование групп услуг договора по грузоперевозоке";
	ПараметрыВыполнения.ЗапуститьВФоне 				= Истина;
	ПараметрыВыполнения.ЗапуститьНеВФоне 			= ложь;
	
	ПараметрыПроцедуры = Новый Структура;
	ПараметрыПроцедуры.Вставить("ТекущийОбъект", 		Объект.Ссылка);
	ПараметрыПроцедуры.Вставить("ЗначениеКопирования", 	ЗначениеКопирования);
	
	Возврат ДлительныеОперации.ВыполнитьВФоне("РегистрыСведений.CW_ХарактеристикиГруппУслуг.СкопироватьДатыОказанияГруппУслуг",ПараметрыПроцедуры, ПараметрыВыполнения);
	
КонецФункции

&НаКлиенте
Процедура ОбработатьРезультатКопированияГруппУслуг(РезультатВыполнения, Дополнительныепараметры) Экспорт
	
	Если РезультатВыполнения.Статус = "Выполнено" Тогда
		
		Элементы.ГруппыУслуг.Обновить();
		ПоказатьОповещениеПользователя("Группы услуг заполнены");
		
	ИначеЕсли РезультатВыполнения.Статус = "Ошибка" Тогда
		
		ТекстПредупреждения = "Группы услуг не скопированы!
		| По причине: "+ РезультатВыполнения.КраткоеПредставлениеОшибки + "
		| Информаиция об ошибке см. в журнале регистрации!";
		
		Если ТипЗнч(РезультатВыполнения.Сообщения) = Тип("Массив") Тогда
			Для Каждого СообщениеВМассиве из РезультатВыполнения.Сообщения Цикл
				СообщениеВМассиве.Сообщить();
			КонецЦикла;
		КонецЕсли;
		
		ПоказатьПредупреждение(,ТекстПредупреждения,,"Ошибка копирования групп услуг");
	КонецЕсли;
	
КонецПроцедуры


&НаКлиенте
Процедура ПриложенияДоговораПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	Если Модифицированность или Объект.Ссылка.Пустая() Тогда
		ПоказатьПредупреждение(,"Необходимо записать договор!");
		Отказ = истина;
	КонецЕсли;
	
КонецПроцедуры


&НаКлиенте
Процедура ДатаНачалаВеденияБухгалтерскогоУчетаНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Режим = РежимДиалогаВопрос.ДаНет;
	Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаОбИзмененииДатыБухгалтескогоУчета", ЭтотОбъект, Параметры);
	ПоказатьВопрос(Оповещение, "Документы до даты начала ведения бухгалтерского учета не будут формировать связанных документов бухгалтерского учета. Продолжить?", Режим, 0);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияВопросаОбИзмененииДатыБухгалтескогоУчета(Результат, Параметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Нет Тогда
        Возврат;
	КонецЕсли;
	
	Подсказка = "Введите дату";
	ЧастьДаты = ЧастиДаты.Дата;
	Оповещение = Новый ОписаниеОповещения("ПослеВводаДатыДатыБухгалтескогоУчета", ЭтотОбъект, Параметры);
	ПоказатьВводДаты(Оповещение, ТекущаяДата(), Подсказка, ЧастьДаты);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВводаДатыДатыБухгалтескогоУчета(НоваяДата, Параметры) Экспорт
	
	Если НоваяДата = Неопределено Тогда
        Возврат;
	КонецЕсли;
	
	Объект.ДатаНачалаВеденияБухгалтерскогоУчета = НоваяДата;
	Модифицированность = Истина;
	
КонецПроцедуры

