&НаКлиенте
Процедура УстановкаУслугПоДоговоруПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	Если Не Объект.Ссылка.Пустая() Тогда
		
		Если Не Копирование Тогда 
			
			Отказ = истина; 
			
			//открываем форму с парметрами только в случае если не используется копирование документа.
			ЗначенияЗаполнения 	= новый Структура;
			ЗначенияЗаполнения.Вставить("Организация", 		Объект.Организация);
			ЗначенияЗаполнения.Вставить("Контрагент", 		Объект.Владелец);
			ЗначенияЗаполнения.Вставить("Договор", 			Объект.Ссылка);
			ЗначенияЗаполнения.Вставить("ВалютаДокумента", 	Объект.ВалютаДоговора);
			
			ПараметрыФормы = новый Структура("ЗначенияЗаполнения", ЗначенияЗаполнения);
			
			ОткрытьФорму("Документ.CW_УслугиПоДоговоруГрузоперевозки.ФормаОбъекта", ПараметрыФормы, Этаформа,,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		КонецЕсли;
		
	Иначе
		
		Отказ = истина;
		ПоказатьПредупреждение(,"Договор нужно записать!");
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "ОбновитьСписокУслугПоПротоколу" Тогда
		
		УстановитьОтборДинамическихСписков();
		Элементы.УстановкаУслугПоДоговору.Обновить();
		
		//Подсистема.УчетПриложенийДоговоров
	ИначеЕсли ИмяСобытия = "ОбновитьНаличиеДополнительныхСоглашений" Тогда
		
		CW_УчетПриложенийДоговоровКлиентСервер.ОбновитьНаличиеДополнительныхСоглашений(ЭтаФорма);
		//Подсистема.УчетПриложенийДоговоров
		
		//Наличие прикрепленных файлов
	ИначеЕсли ИмяСобытия = "ОбновитьНаличиеПрикрепленныхФайлов" Тогда
		
		ОбработатьОповещениеОбновитьНаличиеПрикрепленныхФайлов();
		//Наличие прикрепленных файлов
		
	ИначеЕсли ИмяСобытия ="ЗаписьПриложенияДоговора" и  Параметр = Объект.Ссылка Тогда
		
		CW_УчетПриложенийДоговоровКлиентСервер.ОбновитьНаличиеДополнительныхСоглашений(ЭтаФорма);
		
		//Подсистема.СтатусыДокументов
	ИначеЕсли ИмяСобытия = "Изменение_СтатусДокумента" Тогда
		
		ОбработатьОповещениеИзменениеСтатусДокументаНаСервере();
		//Подсистема.СтатусыДокументов  
		
		//Подсистема.СогласованиеОбъктов 
	ИначеЕсли ИмяСобытия = "Изменение_СогласованиеОбъектов" Тогда
		
		  CW_СогласованиеКлиент.ОбновитьСтатусОбъекта(Истина, ЭтаФорма);
		//Подсистема.СогласованиеОбъктов
		
	КонецЕсли;

КонецПроцедуры

