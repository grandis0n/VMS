#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

Функция НаименованиеУчетногоДоговора(ДоговорОбъект) Экспорт 
	// --- 
	
	Наименование = "Служебный (Дог.№"+СокрЛП(ДоговорОбъект.НомерДоговора)+" от "+Формат(ДоговорОбъект.ДатаДоговора,"ДФ=dd.MM.yyyy; ДП=<...>")+")";
	Возврат(Наименование);
	
	// --- 
КонецФункции

Функция НаименованиеУчетногоДоговораСКомитентом(ДоговорОбъект) Экспорт 
	// --- 
	
	Наименование = "Служебный с комитентом (Дог.№"+СокрЛП(ДоговорОбъект.НомерДоговора)+" от "+Формат(ДоговорОбъект.ДатаДоговора,"ДФ=dd.MM.yyyy; ДП=<...>")+")";
	Возврат(Наименование);
	
	// --- 
КонецФункции

Функция НаименованиеУчетногоДоговораВыявленияРезультата(ДоговорОбъект) Экспорт 
	// --- 
	
	Наименование = "Служебный для выявления результата (Дог.№"+СокрЛП(ДоговорОбъект.НомерДоговора)+" от "+Формат(ДоговорОбъект.ДатаДоговора,"ДФ=dd.MM.yyyy; ДП=<...>")+")";
