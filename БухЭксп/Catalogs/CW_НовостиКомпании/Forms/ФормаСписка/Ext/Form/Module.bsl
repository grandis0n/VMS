
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЭтотОбъект.ТолькоПросмотр  = НЕ CW_ПраваДоступа.ПравоДоступно("ЛичныйКабинетУправлениеПрофилями"); 
	
	ЗаполнитьДеревоНовостей();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДеревоНовостей()
	
	Дерево = РеквизитФормыВЗначение("СтатусНовостей");
	
	СтрокаВсе = Дерево.Строки.Добавить();
	СтрокаВсе.Значение = 0;
	СтрокаВсе.Наименование = "Все новости"; 
	
	Детали = СтрокаВсе.Строки.Добавить();
	Детали.Значение = 1;
	Детали.Наименование = "Актуальные"; 

	Детали = СтрокаВсе.Строки.Добавить();
	Детали.Значение = 4;
	Детали.Наименование = "Важные"; 
	
	Детали = СтрокаВсе.Строки.Добавить();
	Детали.Значение = 2;
	Детали.Наименование = "Архив"; 
	
	Детали = СтрокаВсе.Строки.Добавить();
	Детали.Значение = 3;
	Детали.Наименование = "Корзина"; 

	ЗначениеВРеквизитФормы(Дерево, "СтатусНовостей");

КонецПроцедуры

&НаКлиенте
Процедура СтатусНовостейПриАктивизацииСтроки(Элемент)

	ТекущиеДанные = Элементы.СтатусНовостей.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено тогда
		Возврат;
	КонецЕсли;
	
	УстановитьОтборСписка(ТекущиеДанные.Значение);
	
КонецПроцедуры    

&НаСервере
Процедура УстановитьОтборСписка(Значение=0)  
	
	Список.Отбор.Элементы.Очистить();   
	
	Если  Значение > 0 Тогда
		Если Значение = 1 Тогда
			ЭлементОтбора = Список.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
			ЭлементОтбора.Использование = истина;   
			ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Архив");
			ЭлементОтбора.ПравоеЗначение = Ложь;   
		Конецесли;
		
		Если Значение = 2 Тогда
			ЭлементОтбора = Список.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
			ЭлементОтбора.Использование = истина;   
			ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Архив");
			ЭлементОтбора.ПравоеЗначение = Истина;
		Конецесли;
		
		Если Значение = 3 Тогда
			ЭлементОтбора = Список.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
			ЭлементОтбора.Использование = истина;   
			ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ПометкаУдаления");
			ЭлементОтбора.ПравоеЗначение = истина;
		Конецесли;
		
		Если Значение = 4 Тогда
			ЭлементОтбора = Список.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
			ЭлементОтбора.Использование = истина;   
			ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Важность");
			ЭлементОтбора.ПравоеЗначение = Истина;    
			
			ЭлементОтбора = Список.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
			ЭлементОтбора.Использование = истина;   
			ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Архив");
			ЭлементОтбора.ПравоеЗначение = Ложь;   
		Конецесли;  
		
		Если Значение <> 3 Тогда
			ЭлементОтбора = Список.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
			ЭлементОтбора.Использование 	= истина;   
			ЭлементОтбора.ЛевоеЗначение 	= Новый ПолеКомпоновкиДанных("ПометкаУдаления");
			ЭлементОтбора.ПравоеЗначение 	= Ложь;
		Конецесли;  
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ) 
	
	ЭлементыДерева = СтатусНовостей.ПолучитьЭлементы();
	Элементы.СтатусНовостей.Развернуть(ЭлементыДерева[0].ПолучитьИдентификатор());

КонецПроцедуры


