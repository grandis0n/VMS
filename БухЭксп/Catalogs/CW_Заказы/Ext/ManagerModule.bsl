Процедура ОбновитьСписокНомеровЗакзаов() Экспорт
	
	Префикс = СокрЛП(Константы.CW_ПрефиксЗаказов.Получить());
	Если ЗначениеЗаполнено(Префикс) Тогда
		Если Найти(Префикс,"[") > 0 Тогда
			//Используются шабоны префикса, ничего не делаем, они уже пишутся в регистр
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	CW_Заказы.Ссылка КАК Ссылка,
	               |	CW_Заказы.Код КАК Код
	               |ИЗ
	               |	Справочник.CW_Заказы КАК CW_Заказы
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Код УБЫВ";
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Если Выборка.Следующий() Тогда
		ПоследнийНомер =  Выборка.код;
		РегистрыСведений.CW_НумерацияЗаказов.ЗаписатьПоследнийНомерЗаказа(Префикс, ПоследнийНомер);
	КонецЕсли;
	
КонецПроцедуры
