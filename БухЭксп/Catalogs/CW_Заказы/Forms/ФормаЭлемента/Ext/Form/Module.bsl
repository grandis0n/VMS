//Использование количества 
&НаСервере
Процедура УстановитьДоступностьОбновленияКоличестваНаСервере()       
	
	Если Объект.Ссылка.Пустая() Тогда
		Возврат;
	КонецЕсли;
	
	Если БюджетТекущаяВерсия.Пустая() Тогда
		Возврат;
	Конецесли;
	
	Если ИспользованиеКоличестваДляПлановыхСтатей и ПолучениеКоличестваУслугИзПараметраГрузоперевозки Тогда
		БюджетЗаблокирован = РегистрыСведений.CW_УтверждениеБюджетов.ПолучитьБлокировкуБюджета(Объект.Ссылка, БюджетТекущаяВерсия);
		Элементы.ОбновитьКоличествоРасходы.Доступность = Не БюджетЗаблокирован; 
		Элементы.ОбновитьКоличествоДоходы.Доступность  = НЕ БюджетЗаблокирован;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьКоличествоДоходы(Команда)
	
	ОбновитьКоличествоНаКлиенте(ПредопределенноеЗначение("Перечисление.CW_ВидыСтатейПланирования.Доходы"));

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьКоличествоРасходы(Команда)  
	
	ОбновитьКоличествоНаКлиенте(ПредопределенноеЗначение("Перечисление.CW_ВидыСтатейПланирования.Расходы")); 
	
КонецПроцедуры    

&НаКлиенте
Процедура ОбновитьКоличествоНаКлиенте(ВидСтатьиПланирования)
	
	РезультатВыполнения =  ОбновитьКоличествоНаСервереВФоне(ВидСтатьиПланирования);
	Если РезультатВыполнения = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ВыводитьОкноОжидания = Истина;   
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ВидСтатьиПланирования", ВидСтатьиПланирования);
	
	ОповещениеОЗавершении = Новый ОписаниеОповещения("ОбработатьРезультатОбновленияКоличества", ЭтотОбъект, ДополнительныеПараметры);
	
	ДлительныеОперацииКлиент.ОжидатьЗавершение(РезультатВыполнения, ОповещениеОЗавершении, ПараметрыОжидания);
	
КонецПроцедуры

&НаСервере
Функция ОбновитьКоличествоНаСервереВФоне(ВидСтатьиПланирования)
	
	МассивСтатей = ПолучитьМассивСтатейБюджетаНаСервере(ВидСтатьиПланирования);   
	Если МассивСтатей.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(Новый УникальныйИдентификатор);
	ПараметрыВыполнения.ОжидатьЗавершение 			= 0; // запускать сразу
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = "Обновление количества статей бюджета: "+Строка(Объект.Ссылка);
	ПараметрыВыполнения.ЗапуститьВФоне 				= Истина;
	ПараметрыВыполнения.ЗапуститьНеВФоне 			= ложь;
	
	ПараметрыПроцедуры = Новый Структура;
	ПараметрыПроцедуры.Вставить("МассивСтатей", 	МассивСтатей);
	
	Возврат ДлительныеОперации.ВыполнитьВФоне("Справочники.CW_ПлановыеСтатьиЗатратИДоходов.ОбновитьКоличествоПлановыхСтатей",ПараметрыПроцедуры, ПараметрыВыполнения);
	
КонецФункции

&НаСервере
Функция  ПолучитьМассивСтатейБюджетаНаСервере(ВидСтатьиПланирования)  
	
	Если Объект.Ссылка.Пустая() Тогда 
		Возврат Новый Массив;
	КонецЕсли;
	
	МассивГрузоперевозок = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	CW_Грузоперевозки.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.CW_Грузоперевозки КАК CW_Грузоперевозки
	               |ГДЕ
	               |	CW_Грузоперевозки.ПометкаУдаления = ЛОЖЬ
	               |	И CW_Грузоперевозки.Заказ = &Заказ";  
	
	Запрос.УстановитьПараметр("Заказ", Объект.Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();             
	
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		БюджетЗаблокирован = РегистрыСведений.CW_УтверждениеБюджетов.ПолучитьБлокировкуБюджета(Выборка.Ссылка, БюджетТекущаяВерсия);
		Если БюджетЗаблокирован Тогда
			Продолжить;
		КонецЕсли;                     
		МассивГрузоперевозок.Добавить(Выборка.Ссылка);	
	КонецЦикла;
	
	Если МассивГрузоперевозок.Количество() = 0 Тогда
		Возврат Новый Массив;
	КонецЕсли;

	МассивСтатей = Новый Массив;  
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	CW_ПлановыеСтатьиЗатратИДоходов.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.CW_ПлановыеСтатьиЗатратИДоходов КАК CW_ПлановыеСтатьиЗатратИДоходов
	               |ГДЕ
	               |	CW_ПлановыеСтатьиЗатратИДоходов.Владелец В(&МассивГрузоперевозок)
	               |	И CW_ПлановыеСтатьиЗатратИДоходов.ВерсияБюджета = &ВерсияБюджета
	               |	И CW_ПлановыеСтатьиЗатратИДоходов.ВидСтатьиПланирования = &ВидСтатьиПланирования
	               |	И CW_ПлановыеСтатьиЗатратИДоходов.ПометкаУдаления = ЛОЖЬ";
	
	Запрос.УстановитьПараметр("МассивГрузоперевозок", 	МассивГрузоперевозок);
	Запрос.УстановитьПараметр("ВерсияБюджета", 			БюджетТекущаяВерсия);
	Запрос.УстановитьПараметр("ВидСтатьиПланирования", 	ВидСтатьиПланирования);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		МассивСтатей.Добавить(Выборка.Ссылка);
	КонецЦикла;                           
	
	Возврат МассивСтатей;
	
КонецФункции

&НаКлиенте
Процедура ОбработатьРезультатОбновленияКоличества(РезультатВыполнения, ДополнительныеПараметры) Экспорт
	
	Если РезультатВыполнения.Статус = "Выполнено" Тогда
		
		Если ДополнительныеПараметры.ВидСтатьиПланирования = ПредопределенноеЗначение("Перечисление.CW_ВидыСтатейПланирования.Доходы") Тогда
			КомандаИмя = "/БюджетДоходыОбновить"	
		Иначе
			КомандаИмя = "/БюджетРасходыОбновить"	
		КонецЕсли;
		
		ВыполнитьДействие(_УФКС.СД("Грузоперевозки","клиент", КомандаИмя, Неопределено));
		
	ИначеЕсли РезультатВыполнения.Статус = "Ошибка" Тогда
		
		ТекстПредупреждения = "Не удалось обновить количество одной или нескольких статей бюджета!
		| По причине: "+ РезультатВыполнения.КраткоеПредставлениеОшибки + "
		| Информаиция об ошибке см. в журнале регистрации!";
		
		Если ТипЗнч(РезультатВыполнения.Сообщения) = Тип("Массив") Тогда
			Для Каждого СообщениеВМассиве из РезультатВыполнения.Сообщения Цикл
				СообщениеВМассиве.Сообщить();
			КонецЦикла;
		КонецЕсли;
		
		ПоказатьПредупреждение(,ТекстПредупреждения,,"Ошибка обновления количества");
	КонецЕсли;
	
КонецПроцедуры
