&НаСервере
Процедура УстановитьМенеджераПродаж()
	
	ПараметрыСреза = Новый Структура;
	ПараметрыСреза.Вставить("ДатаСреза"	, Объект.ДатаСделкиФ);
	ПараметрыСреза.Вставить("Контрагент", Объект.Клиент);
	
	НовыйМенеджерПродаж = РегистрыСведений.CW_МенеджерыПродажКлиентов.ПолучитьМенеджераКлиента(ПараметрыСреза);
	
	Если ЗначениеЗаполнено(НовыйМенеджерПродаж)  Тогда
		Если НовыйМенеджерПродаж <> Объект.МенеджерПродаж Тогда
			Объект.МенеджерПродаж = НовыйМенеджерПродаж;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

