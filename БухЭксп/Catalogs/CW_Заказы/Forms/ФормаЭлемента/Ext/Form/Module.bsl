	ВыполнитьДействиеНаСервере(_УФКС.СД("Журналы","сервер","/ИнициализацияНастроек"));
	ВыполнитьДействиеНаСервере(_УФКС.СД("Журналы","сервер","/ОбновитьДанные"));
	
КонецПроцедуры

&НаСервере
Процедура _ЗаполнитьПараметрыПоТипуПеревозки(ВариантЗаполнения)
	// --- 
	
	// удаляем несоответствующие параметры
	Если (ВариантЗаполнения = 1) Тогда
		
		МассивУдаляемых = Новый Массив;
		Для каждого СтрПараметр Из Объект.ПараметрыЗаказа Цикл
			
			Отбор = Новый Структура("Параметр", СтрПараметр.Параметр);
			СтрокаПараметра = _сф.к_НайтиСтроку(Объект.ТипПеревозки.ПараметрыЗаказа, Отбор);
			Если (СтрокаПараметра = Неопределено) Тогда
				МассивУдаляемых.Добавить(СтрПараметр);
			КонецЕсли; 
			
		КонецЦикла;
		_сф.к_УдалитьЭлементыПоМассиву(Объект.ПараметрыЗаказа, МассивУдаляемых);
		
	КонецЕсли; 
	
	// переносим иерархию
	Если (ВариантЗаполнения = 0 ИЛИ ВариантЗаполнения = 1) Тогда
		
		// очищаем текущие группы
		Объект.ГруппыПараметровЗаказа.Очистить();
		// копируем группы из типа 
		Объект.ГруппыПараметровЗаказа.Загрузить(Объект.ТипПеревозки.ГруппыПараметровЗаказа.Выгрузить());
		
	КонецЕсли; 
	
	// переносим параметры из типа
	ТаблицаПараметров = Объект.ТипПеревозки.ПараметрыЗаказа.Выгрузить();
	Для каждого СтрПараметр Из ТаблицаПараметров Цикл
		
		Отбор = Новый Структура("Параметр", СтрПараметр.Параметр);
		СтрокаПараметра = _сф.к_НайтиСтроку(Объект.ПараметрыЗаказа, Отбор);
		Если (СтрокаПараметра = Неопределено) Тогда
			
			// добавляем
			Нстр = Объект.ПараметрыЗаказа.Добавить();
			Нстр.Параметр = СтрПараметр.Параметр;
			Нстр.Значение = СтрПараметр.Параметр.ТипЗначения.ПривестиЗначение(Неопределено); 
			
			//Новый механизм
			Нстр.ИдентификаторВладельца = СтрПараметр.ИдентификаторВладельца;
			//Новый механизм	
			
			//ХранениеПолногоЗначения
			ДобавитьСохраняемоеПолноеЗначение(СтрПараметр.Параметр);
			//---ХранениеПолногоЗначения
		КонецЕсли; 
		
	КонецЦикла; 
	
	// --- 
КонецПроцедуры

