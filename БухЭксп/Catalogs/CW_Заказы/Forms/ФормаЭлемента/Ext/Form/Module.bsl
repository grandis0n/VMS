&НаКлиенте
Перем ПараметрТекущиейСтрокиДерева;

#Область СобытияФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ВыводитьАрхивные = Истина;
	
	Параметры.Свойство("НеРассчитыватьСтатусыПриЗаписи", НеРассчитыватьСтатусыПриЗаписи);

	// ---------------------------------------------------------------------------- 
	ИспользуетсяБлокировкаМониторинга 				= ПолучитьФункциональнуюОпцию("CW_ИспользованиеБлокировкиМониторинга") И НЕ Объект.Ссылка.Пустая();
	ВалютаРегламентированногоУчетаОтличнаОтРубля 	= НЕ ПолучитьФункциональнуюОпцию("CW_ВалютаРегламентированногоУчетаРубль");
	
	Элементы.НадписьЗакрытие.Видимость 				= ПолучитьФункциональнуюОпцию("CW_ИспользованиеБлокировкиФинансов");
	
	ВариантГруппировкиБюджетаДоходыДерево   = CW_Настройки.ПолучитьНастройкуПользователя(,"ВариантГруппировкиБюджетаДоходыДерево");
	ВариантГруппировкиБюджетаРасходыДерево  = CW_Настройки.ПолучитьНастройкуПользователя(,"ВариантГруппировкиБюджетаРасходыДерево");
	
	ИспользуютсяПараметрыВЗаказах 			= ПолучитьФункциональнуюОпцию("CW_ИспользуютсяПараметрыВЗаказах");
	
	ПоказыватьПриложениеВБюджете = ПолучитьФункциональнуюОпцию("CW_ВедетсяУчетПриложенийПоДоговорам") 
									И ПолучитьФункциональнуюОпцию("CW_УказыватьДоговорДляПлановыхСтатейБюджета");
									
	Элементы.БюджетДоходыПриложениеКДоговору.Видимость = ПоказыватьПриложениеВБюджете;
	Элементы.БюджетДоходыДеревоПриложениеКДоговору.Видимость = ПоказыватьПриложениеВБюджете;
	
	Элементы.БюджетРасходыДеревоПриложениеКДоговору.Видимость = ПоказыватьПриложениеВБюджете;
	Элементы.БюджетРасходыПриложениеКДоговору.Видимость = ПоказыватьПриложениеВБюджете;
	
	ГруппаПользователя = CW_ПраваДоступа_ПИ.ГруппаПользователя(ПараметрыСеанса.ТекущийПользователь);    
	
	//Видимость отчета Ведомость перевыставления по ставкам    
	ИспользованиеСхемыПеревыставленияПоСтавкам = ПолучитьФункциональнуюОпцию("CW_ИспользованиеСхемыПеревыставленияПоСтавкам");
	ПросмотрФинансов = CW_ПраваДоступа.ПравоДоступно("ПросмотрФинансов", ПараметрыСеанса.ТекущийПользователь);
	Элементы.Отчет_ВедомостьПеревыставленияПоСтавкам.Видимость = ИспользованиеСхемыПеревыставленияПоСтавкам и ПросмотрФинансов;
	//КОНЕЦ   
	

	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("CW_ГруппаПользователя", 	ГруппаПользователя);
	СтруктураПараметров.Вставить("CW_Пользователь", 	ПараметрыСеанса.ТекущийПользователь);
	
	УстановитьПараметрыФункциональныхОпцийФормы(СтруктураПараметров);
	
	КлиентДоИзменения = Объект.Клиент;
	
	Элементы.ГруппаБлокировкаМониторинга.Видимость = ИспользуетсяБлокировкаМониторинга;
	Если (ИспользуетсяБлокировкаМониторинга) Тогда
		
		_ОбновитьСтатусБлокировкиМониторинга();
		
	КонецЕсли;
	
	Если ПолучитьФункциональнуюОпцию("CW_ИспользованиеБюджетирования") Тогда
		ДобавитьПодключаемыеКоманды();
		
		Элементы.ЗаполнитьБюджетыПоЗаявке.Видимость = ЗначениеЗаполнено(Объект.Заявка);
	КонецЕсли;
	
	//Наличие прикрепленных файлов
	_УФКС.УстановитьНаличиеПрикрепленныхФайловПриСозданииФормыНаСервере(ЭтаФорма);
	//Наличие прикрепленных файлов
	
	//Параметры заказа
	Если ИспользуютсяПараметрыВЗаказах Тогда
		// кэшируем свойства параметров
		_ОбновитьСвойстваПапаметров();
		Если Объект.ГруппыПараметровЗаказа.Количество()=0 Тогда
			НастоящийОбъект = РеквизитФормыВЗначение("Объект");
			НастоящийОбъект.ПроверитьИерархиюПараметров();
			ЗначениеВРеквизитФормы(НастоящийОбъект,"Объект");
		КонецЕсли; 
	КонецЕсли;
	//Параметры заказа

	
	//Отладка = Истина;
	
	Если Параметры.Ключ.Пустая() Тогда
		Объект.Ответственный = ПараметрыСеанса.ТекущийПользователь;
		Если ЗначениеЗаполнено(Объект.ТипПеревозки) Тогда
			_УФС.ЗаполнитьПредопределенныеЗначенияРеквизитовШапки(Объект, Объект.ТипПеревозки, "ДляЗаказа");
		КонецЕсли;
		
		//Времено на переходный период
		//Для новых объектов уже используется новый механизм хранения данных
		СлужебныйВыполненПереход = Истина;
		//Времено на переходный период
		
	КонецЕсли;

	//РаботаСАрхивомОбъектов    
	CW_АрхивОбъектовСервер.ПриСозданииНаСервере(ЭтаФорма);
	//РаботаСАрхивомОбъектов  
	
	Основание = Неопределено;
	Параметры.Свойство("Основание",Основание);
	ВводНаОсновании = ЗначениеЗаполнено(Основание);
	
	Если (ВводНаОсновании) Тогда
		
		Если (ТипЗнч(Основание) = Тип("СправочникСсылка.CW_Заявки")) Тогда
			
			ВводНаОснованииЗаявки = Истина;
			
		КонецЕсли; 
		
	КонецЕсли; 
	
	Инициализировать = Ложь;
	Если (НЕ Параметры.ЗначениеКопирования.Пустая()) Тогда
		
		ОбъектКопирования = Параметры.ЗначениеКопирования;
		РежимКопирования = Истина;
		Если (ПолучитьФункциональнуюОпцию("CW_ИспользованиеСхемыПеревыставленияПоСтавкам")) Тогда
			ВыполнитьДействиеНаСервере(_УФКС.СД("Грузоперевозки","сервер","/ОтборДокументовФинансовогоРезультата"));
		КонецЕсли; 
		
	Иначе
		
		Инициализировать = Истина;
		
	КонецЕсли; 
	Если (Инициализировать) Тогда
		
		ВыполнитьДействиеНаСервере(_УФКС.СД("Грузоперевозки","сервер","/ИнициализацияФормы"));
		
	КонецЕсли; 
	
	НастрйкаОтображенияКолонкиКомментарий = ХранилищеСистемныхНастроек.Загрузить(ЭтаФорма.ИмяФормы,"ОтображенияКолонкиКомментарий");
	
	Если Не НастрйкаОтображенияКолонкиКомментарий = Неопределено Тогда
		НастрйкаОтображенияКолонкиКомментарий.Свойство("ПоказатьСкрытьКомментарий_Доходы"	, ПоказатьСкрытьКомментарий_Доходы);
		НастрйкаОтображенияКолонкиКомментарий.Свойство("ПоказатьСкрытьКомментарий_Расходы"	, ПоказатьСкрытьКомментарий_Расходы);
	КонецЕсли;

	// ---
	ЗагрузитьСеансовуюНастройкуДеклараций();
	// ---
	
	// ---------------------------------------------------------------------------- 
	//Элементы.ФормаВнешниеДействия.Видимость = (_СписокДействий().Количество() <> 0);
	// ---------------------------------------------------------------------------- 
	
	стНастроек = ХранилищеСистемныхНастроек.Загрузить("Грузоперевозки", "ОтображатьПостатейно");
	Если стНастроек <> Неопределено Тогда
		ФинансыДоходыОтображатьПостатейно  		= _сф.ст_ПолучитьСвойство(стНастроек, "ОтображатьПостатейно");
		ФинансыРасходыОтображатьПостатейно	 	= _сф.ст_ПолучитьСвойство(стНастроек, "ОтображатьПостатейно");
		ФинансыТранспортОтображатьПостатейно 	= _сф.ст_ПолучитьСвойство(стНастроек, "ОтображатьПостатейно");
	КонецЕсли;		
	
	// определяем количество грузоперевозок
	Если Не Параметры.Ключ.Пустая() Тогда
		Если (НЕ ГрузоперевозкиИнициализированы) Тогда
			
			ВыполнитьДействиеНаСервере(_УФКС.СД("Журналы","сервер","/ИнициализацияФормы",Новый Структура("ИмяСеансовойНастройки","ПоследняяНастройкаЗаказы")));
			ВыполнитьДействиеНаСервере(_УФКС.СД("Журналы","сервер","/ИнициализацияНастроек"));
			ВыполнитьДействиеНаСервере(_УФКС.СД("Журналы","сервер","/ОбновитьДанные"));
			// --- 
			ГрузоперевозкиИнициализированы = Истина;
			_УстановитьЗаголовокСтраницыГрузоперевозок();	
			
		КонецЕсли; 
	КонецЕсли; 

	Элементы.БюджетРасходыСуммаРуб.Заголовок 			= "Сумма, "+?(ЗначениеЗаполнено(ВРУ),СокрЛП(ВРУ), "-");
	Элементы.БюджетРасходыСуммаВсегоРуб.Заголовок     	= "Всего, "+?(ЗначениеЗаполнено(ВРУ),СокрЛП(ВРУ), "-");
	Элементы.БюджетРасходыДеревоСуммаРуб.Заголовок      = "Сумма, "+?(ЗначениеЗаполнено(ВРУ),СокрЛП(ВРУ), "-");
	Элементы.БюджетРасходыДеревоСуммаВсегоРуб.Заголовок = "Всего, "+?(ЗначениеЗаполнено(ВРУ),СокрЛП(ВРУ), "-");
	
	Элементы.БюджетДоходыДеревоСуммаРуб.Заголовок     	= "Сумма, "+?(ЗначениеЗаполнено(ВРУ),СокрЛП(ВРУ), "-");
	Элементы.БюджетДоходыДеревоСуммаВсегоРуб.Заголовок 	= "Всего, "+?(ЗначениеЗаполнено(ВРУ),СокрЛП(ВРУ), "-");
	Элементы.БюджетДоходыСуммаРуб.Заголовок      		= "Сумма, "+?(ЗначениеЗаполнено(ВРУ),СокрЛП(ВРУ), "-");
	Элементы.БюджетДоходыСуммаВсегоРуб.Заголовок 		= "Всего, "+?(ЗначениеЗаполнено(ВРУ),СокрЛП(ВРУ), "-");
	
	
	Элементы.БюджетДоходыДеревоКомментарий.Видимость  = ПоказатьСкрытьКомментарий_Доходы;
	Элементы.БюджетРасходыДеревоКомментарий.Видимость = ПоказатьСкрытьКомментарий_Расходы;
	
	Элементы.БюджетРасходыДеревоПоказатьСкрытьКомментарий_Расходы.Пометка 	= ПоказатьСкрытьКомментарий_Расходы;
	Элементы.БюджетДоходыДеревоПоказатьСкрытьКомментарий_Доходы.Пометка 	= ПоказатьСкрытьКомментарий_Доходы;


	//Заполнение списка выбора элемента
	Если ВалютаРегламентированногоУчетаОтличнаОтРубля Тогда
		Элементы.ВыводФинрезультата.СписокВыбора.Очистить();
		Элементы.ВыводФинрезультата.СписокВыбора.Добавить(1, "По счетам");
		ОтображениеФинансовогоРезультата = 1;
	КонецЕсли;
	
	ВариантГруппировкиБюджетаРасходПриИзмененииНаСервере();
	ВариантГруппировкиБюджетаДоходыПриИзмененииНаСервере(); 
	
	ЗаявкаПриИзмененииНаСервере();
	
	СтараяЗаявка = Объект.Заявка;
	
	//Подсистема.ЛогистическиеСтатусы
	ИспользоватьЛогистическиеСтатусыЗаказов 		= ПолучитьФункциональнуюОпцию("CW_ИспользоватьЛогистическиеСтатусыЗаказов");
	Если ИспользоватьЛогистическиеСтатусыЗаказов Тогда 
		CW_ЛогистическиеСтатусыСервер.ПриСозданииНаСервере(ЭтаФорма, Отказ, СтандартнаяОбработка);
	КонецЕсли;
	//Подсистема.ЛогистическиеСтатусы
	
	//Подсистема.ФинансовыеСтатусы
	ИспользоватьФинансовыеСтатусыЗаказов 		= ПолучитьФункциональнуюОпцию("CW_ИспользоватьФинансовыеСтатусыЗаказов");
	Если ИспользоватьФинансовыеСтатусыЗаказов  Тогда
		CW_ФинансовыеСтатусыСервер.ПриСозданииНаСервере(ЭтаФорма, Отказ, СтандартнаяОбработка);
	Конецесли;
	//Подсистема.ФинансовыеСтатусы

	//ПрогнозОплаты
	ИспользуетсяПрогнозированиеДДСПоБюджету = 	ПолучитьФункциональнуюОпцию("CW_ИспользуетсяПрогнозированиеДДСПоБюджету");
	//ПрогнозОплаты    
	
	УстановитьПараметрыДинамическогоСписка();
	УстановитьИтогиДинамическогоСписка();
	
	//Использование количества
	ИспользованиеКоличестваДляПлановыхСтатей 			= ПолучитьФункциональнуюОпцию("CW_ИспользованиеКоличестваДляПлановыхСтатей");
	ПолучениеКоличестваУслугИзПараметраГрузоперевозки 	= ПолучитьФункциональнуюОпцию("CW_РазрешитьПолучениеКоличестваУслугИзПараметраГрузоперевозки");
	
	Элементы.ОбновитьКоличествоРасходы.Видимость = ИспользованиеКоличестваДляПлановыхСтатей и ПолучениеКоличестваУслугИзПараметраГрузоперевозки; 
	Элементы.ОбновитьКоличествоДоходы.Видимость  = ИспользованиеКоличестваДляПлановыхСтатей и ПолучениеКоличестваУслугИзПараметраГрузоперевозки;
	//Использование количества 
	
	ДоступноПодклчюениеГрузоперевозок = Истина;
	Если ИспользуетсяБлокировкаМониторинга Тогда
		ДоступноПодклчюениеГрузоперевозок = НЕ ЗначениеЗаполнено(ДатаБлокировкиМониторинга);
	КонецЕсли; 
	Элементы.ЖурналГруппаПодключитьГрузоперевозки.Доступность = ДоступноПодклчюениеГрузоперевозок;

	//Внешние подклчюаемые команды
	CW_ПодключаемыеКомандыСервер.ПриСозданииНаСервере(ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	//ХранениеПолногоЗначения
	Для Каждого СтрокаОбъекта из ТекущийОбъект.ПараметрыЗаказа Цикл
		ДобавитьСохраняемоеПолноеЗначение(СтрокаОбъекта.Параметр, СтрокаОбъекта.ХранилищеДанных.Получить());
	КонецЦикла;
	//---ХранениеПолногоЗначения
	
КонецПроцедуры 

&НаСервере
Процедура УстановитьПараметрыДинамическогоСписка()
	
	ОтчетЭкспедитора.Параметры.УстановитьЗначениеПараметра("Заказ",Объект.Ссылка); 
	
КонецПроцедуры

&НаСервере
Процедура УстановитьИтогиДинамическогоСписка()
	
	СтруктураИтоговОтчетЭкспедитора = CW_БухгалтерияЭкспедитораСерверПереопределяемый.ИтогиДинамическогоСписка(ОтчетЭкспедитора, "КоличествоЗаписей");
	
	Элементы.СтраницаОтчетЭкспедитора.Заголовок = "Отчет экспедитора "+?(СтруктураИтоговОтчетЭкспедитора.КоличествоЗаписей = Null,	"",	" ("+СтруктураИтоговОтчетЭкспедитора.КоличествоЗаписей+")"); 
	
КонецПроцедуры


&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	// ---------------------------------------------------------------------------- 
	
	Если (РежимКопирования ИЛИ ВводНаОснованииЗаявки) Тогда
		
		Если (РежимКопирования) Тогда
			
			ПодключитьОбработчикОжидания("ДиалогКопирования",0.1,Истина);

		КонецЕсли; 
		
		
	Иначе
		
		ВыполнитьДействие(_УФКС.СД("Журналы","сервер","/УстановитьЗаголовкиКолонок"));
			
	КонецЕсли;
	
	
	Если ИспользуютсяПараметрыВЗаказах Тогда
		Если (Объект.Ссылка.Пустая() И НЕ Объект.ТипПеревозки.Пустая()) Тогда
			ЗаполнитьПараметрыПоТипуПеревозки(0);
		КонецЕсли; 
		// формируем дерево
		ОбновитьДеревоПараметров();
	КонецЕсли;	

	
КонецПроцедуры

&НаКлиенте
Процедура ДиалогКопирования() Экспорт 
	// --- 
	
	ПФ = Новый Структура("ОбъектКопирования,УИД",ОбъектКопирования,ЭтаФорма.УникальныйИдентификатор);
	ПОВ = Новый ОписаниеОповещения("ОбработкаКопированияАналитики",ЭтотОбъект); 
	ОткрытьФорму("ОбщаяФорма.CW_ФормаКопированияАналитики" ,ПФ,,,,,ПОВ, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
	// --- 
КонецПроцедуры
  

&НаКлиенте
Процедура ОбработкаКопированияАналитики(Ответ, ДополнительныеПараметры) Экспорт 
	// --- 
	
	Если (Ответ = Неопределено) Тогда
		
		//ВыполнитьДействие(_УФКС.СД("Грузоперевозки","сервер","/ИнициализацияФормы"));
		ЭтаФорма.Закрыть();
		
	Иначе
		
		АдресНастроекКопирования = Ответ;
		Попытка
			
			ВыполнитьДействие(_УФКС.СД("Грузоперевозки","сервер","/ИнициализацияФормы"));
			// --- 
			ЭтаФорма.Записать();
			// --- 
			//ВыполнитьДействиеНаСервере(_УФКС.СД("Журналы","сервер","/ИнициализацияФормы",Новый Структура("ИмяСеансовойНастройки","ПоследняяНастройкаЗаказы")));
			//ВыполнитьДействиеНаСервере(_УФКС.СД("Журналы","сервер","/ИнициализацияНастроек"));
			ВыполнитьДействиеНаСервере(_УФКС.СД("Журналы","сервер","/ОбновитьДанные"));
	
		Исключение
			Сообщить(ОписаниеОшибки());
			ЭтаФорма.Закрыть();
		КонецПопытки; 
		
	КонецЕсли; 
	 
	// --- 
КонецПроцедуры
  

// ---------------------------------------------------------------------------- 

&НаКлиенте
Процедура ПередЗакрытием(Отказ, СтандартнаяОбработка)
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	
	Если Не ЗавершениеРаботы Тогда
		Если ГрузоперевозкиИнициализированы Тогда
			ВыполнитьДействиеНаСервере(_УФКС.СД("Журналы","сервер","/СохранитьСеансовыеНастройки","ПоследняяНастройкаЗаказы"));	
		КонецЕсли;                    
	КонецЕсли;
	
КонецПроцедуры


&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	СеансовыеНастройки = Новый Структура("ФинансыРасходыОтображатьПостатейно,ФинансыТранспортОтображатьПостатейно,ФинансыРасходыОтображатьПостатейно,ФинансыДоходыОтображатьПостатейно",ФинансыРасходыОтображатьПостатейно,ФинансыТранспортОтображатьПостатейно,ФинансыРасходыОтображатьПостатейно,ФинансыДоходыОтображатьПостатейно);
	_УФС.СохранитьСеансовыеНастройки(ЭтаФорма,,СеансовыеНастройки);
	// --- 
	_сф.ст_УстановитьСвойство(ТекущийОбъект.ДополнительныеСвойства,"ИнтерактивныйРежим", 			Истина);
	// --- 
	Если (АдресНастроекКопирования <> "") Тогда
		
		_сф.ст_УстановитьСвойство(ТекущийОбъект.ДополнительныеСвойства,"АдресНастроекКопирования",АдресНастроекКопирования);
		
	КонецЕсли;       
	
	//Запись данных харнилища занчений по строкам 
	Для Каждого ЭлементСписка из СписокАдресовЗначенийПараметров Цикл
		
		//ДанныеПоАдресу - тип "Структура("Параметр, ТаблицаДанных")
		ДанныеПоАдресу = ЭлементСписка.Значение;
		
		Отбор = Новый Структура("Параметр", ДанныеПоАдресу.Параметр);
		мСтроки = ТекущийОбъект.ПараметрыЗаказа.НайтиСтроки(Отбор);
		Если мСтроки.Количество() > 0 Тогда
			//Предполагаем что строка будет только одна
			СтрокаДанных = мСтроки[0]; 
			Если ТипЗНЧ(ДанныеПоАдресу.ДанныеДляХранения) = Тип("ДанныеФормыКоллекция") Тогда
				СтрокаДанных.ХранилищеДанных = новый ХранилищеЗначения(ДанныеПоАдресу.ДанныеДляХранения.Выгрузить());	
			Иначе
				СтрокаДанных.ХранилищеДанных = новый ХранилищеЗначения(ДанныеПоАдресу.ДанныеДляХранения);	
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
	//ХранениеПолногоЗначения 
	Если ТипЗнч(СохраняемоеПолноеЗначение) = Тип("ФиксированноеСоответствие") Тогда 
		Для Каждого КлючЗначение из СохраняемоеПолноеЗначение Цикл
			Отбор = Новый Структура("Параметр", КлючЗначение.Ключ);
			НайденныеСтроки = ТекущийОбъект.ПараметрыЗаказа.НайтиСтроки(Отбор);
			Если НайденныеСтроки.Количество() > 0 Тогда
				//Предполагаем что строка будет только одна
				СтрокаДанных = НайденныеСтроки[0];   
				СтрокаДанных.ХранилищеДанных = новый ХранилищеЗначения(КлючЗначение.Значение);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
//---ХранениеПолногоЗначения
	
	ТекущийОбъект.ДополнительныеСвойства.Вставить("СтараяЗаявка", 			СтараяЗаявка);
	ТекущийОбъект.ДополнительныеСвойства.Вставить("ИнтерактивныйРежим", 	Истина);
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	АдресНастроекКопирования = _сф.ст_ПолучитьСвойство(ТекущийОбъект.ДополнительныеСвойства,"АдресНастроекКопирования");
	ВыполнитьДействиеНаСервере(_УФКС.СД("Грузоперевозки","сервер","/ОтборДокументовФинансовогоРезультата"));
	ВыполнитьДействиеНаСервере(_УФКС.СД("Грузоперевозки","сервер","/УправлениеЭлементамиФормы"));
	ВыполнитьДействиеНаСервере(_УФКС.СД("Журналы","сервер","/Обновить"));
	
	// --- 
	_ЖурГп_Заказ_ПроверитьСоответствиеРеквизитовГрузоперевозок();
	// --- 
	Если (НЕ ГрузоперевозкиИнициализированы) Тогда
		ВыполнитьДействиеНаСервере(_УФКС.СД("Журналы","сервер","/ИнициализацияФормы",Новый Структура("ИмяСеансовойНастройки","ПоследняяНастройкаЗаказы")));
		ВыполнитьДействиеНаСервере(_УФКС.СД("Журналы","сервер","/ИнициализацияНастроек"));
		ВыполнитьДействиеНаСервере(_УФКС.СД("Журналы","сервер","/ОбновитьДанные"));
		// --- 
		ГрузоперевозкиИнициализированы = Истина;
		_УстановитьЗаголовокСтраницыГрузоперевозок();	
	КонецЕсли; 
	
	//Подсистема.ЛогистическиеСтатусы
	ВыполнитьРасчетЛогистическогоСтатусаНаСервере();
	//Подсистема.ЛогистическиеСтатусы
	
	//Подсистема.ФинансовыеСтатусы
	ВыполнитьРасчетФинансовогоСтатусаНаСервере();
	//Подсистема.ФинансовыеСтатусы

	//РаботаСАрхивомОбъектов
	CW_АрхивОбъектовСервер.ПослеЗаписиНаСервере(ЭтаФорма);
	//РаботаСАрхивомОбъектов

	//ПрогнозОплаты
	Если ИспользуетсяПрогнозированиеДДСПоБюджету Тогда
		CW_Бюджетирование.РассчитатьПрогнозОплаты(Объект.Ссылка);
	КонецЕсли;
	//ПрогнозОплаты
	
	
	ЭтоНовыйОбъект = Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура БюджетРасходыДеревоВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;

	ТекущаяГрузоперевозка 	= Неопределено;
	ЭтоГруппировка 			= ПроверитьГруппировку(ВыбраннаяСтрока, ТекущаяГрузоперевозка, истина);
	
	Если ЭтоГруппировка Тогда
		ПоказатьЗначение(,ТекущаяГрузоперевозка);
	Иначе
		ВыполнитьДействие(_УФКС.СД("Грузоперевозки","клиент","/БюджетОткрыть",Новый Структура("Элемент,ВыбраннаяСтрока,Поле",Элемент,ВыбраннаяСтрока,Поле)));
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура БюджетДоходыДеревоВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;

	ТекущаяГрузоперевозка 	= Неопределено;
	ЭтоГруппировка 			= ПроверитьГруппировку(ВыбраннаяСтрока, ТекущаяГрузоперевозка, ложь);
	
	Если ЭтоГруппировка Тогда
		ПоказатьЗначение(,ТекущаяГрузоперевозка);
	Иначе
		ВыполнитьДействие(_УФКС.СД("Грузоперевозки","клиент","/БюджетОткрыть",Новый Структура("Элемент,ВыбраннаяСтрока,Поле",Элемент,ВыбраннаяСтрока,Поле)));
	КонецЕсли;

КонецПроцедуры


&наСервере
Функция  ПроверитьГруппировку(ВыбраннаяСтрока, ТекущаяГрузоперевозка, РасходыДоходы)
	
	Если РасходыДоходы Тогда
		СтрокаДерева	= БюджетРасходыДерево.НайтиПоИдентификатору(ВыбраннаяСтрока);
	Иначе
		СтрокаДерева	= БюджетДоходыДерево.НайтиПоИдентификатору(ВыбраннаяСтрока);
	КонецЕсли;
	
	ТекущаяГрузоперевозка 	= СтрокаДерева.Контрагент;
	СтрокаРодитель 			= СтрокаДерева.ПолучитьРодителя();
	
	Возврат СтрокаРодитель = Неопределено;
	
КонецФункции

&НаКлиенте
Процедура РазвернутьСтрокиДерева(ИмяТаблицы)
	
	Если ИмяТаблицы = "БюджетДоходыДерево" Тогда
		КоллекцияЭлементовДерева = БюджетДоходыДерево.ПолучитьЭлементы();
	Иначе
		КоллекцияЭлементовДерева = БюджетРасходыДерево.ПолучитьЭлементы();
	КонецЕсли;
	
	//Развернуть дерево 
	Для Каждого Строка Из КоллекцияЭлементовДерева Цикл 
		
		ИдентификаторСтроки = Строка.ПолучитьИдентификатор();
		Элементы[ИмяТаблицы].Развернуть(ИдентификаторСтроки);
		
	КонецЦикла; 
	
КонецПроцедуры

&НаКлиенте
Процедура СвернутьСтрокиДерева(ИмяТаблицы)
	
	//Свернуть дерево 
	Если ИмяТаблицы = "БюджетДоходыДерево" Тогда
		КоллекцияЭлементовДерева = БюджетДоходыДерево.ПолучитьЭлементы();
	Иначе
		КоллекцияЭлементовДерева = БюджетРасходыДерево.ПолучитьЭлементы();
	КонецЕсли;
	
	
	Для Каждого Строка Из КоллекцияЭлементовДерева Цикл
		
		ИдентификаторСтроки = Строка.ПолучитьИдентификатор();
		Элементы[ИмяТаблицы].Свернуть(ИдентификаторСтроки);
		
	КонецЦикла;
	
КонецПроцедуры


&НаКлиенте
Процедура Дерево_ДоходыРазвернуть(Команда)
	
	РазвернутьСтрокиДерева("БюджетДоходыДерево") ;

КонецПроцедуры

&НаКлиенте
Процедура Дерево_ДоходыСвернуть(Команда)
	
	СвернутьСтрокиДерева("БюджетДоходыДерево");
	
КонецПроцедуры

&НаКлиенте
Процедура Дерево_РасходыРазвернуть(Команда)
	
	РазвернутьСтрокиДерева("БюджетРасходыДерево");

КонецПроцедуры

&НаКлиенте
Процедура Дерево_РасходыСвернуть(Команда)
	
	СвернутьСтрокиДерева("БюджетРасходыДерево");
	
КонецПроцедуры


#КонецОбласти 

#Область Форма 

&НаКлиенте
Процедура СтраницыПриСменеСтраницы(Элемент, ТекущаяСтраница)
	
	Если (ТекущаяСтраница = Элементы.СтраницаЖурналГрузоперевозок) Тогда
		
		Если (НЕ ГрузоперевозкиИнициализированы) Тогда
			
			ВыполнитьДействиеНаСервере(_УФКС.СД("Журналы","сервер","/ИнициализацияФормы",Новый Структура("ИмяСеансовойНастройки","ПоследняяНастройкаЗаказы")));
			ВыполнитьДействиеНаСервере(_УФКС.СД("Журналы","сервер","/ИнициализацияНастроек"));
			ВыполнитьДействиеНаСервере(_УФКС.СД("Журналы","сервер","/ОбновитьДанные"));
			// --- 
			ГрузоперевозкиИнициализированы = Истина;
	
		КонецЕсли; 
		
	ИначеЕсли (ТекущаяСтраница = Элементы.СтраницаФинансы) Тогда
		
		ВыполнитьДействие(_УФКС.СД("Грузоперевозки","сервер","/ФинансыОбновить"));
		
	ИначеЕсли (ТекущаяСтраница = Элементы.СтраницаБюджет) Тогда
		
		ВыполнитьДействие(_УФКС.СД("Грузоперевозки","сервер","/БюджетОбновить")); 
		
		//Сортировка бюджетов
		ВосстановитьСортировкуТаблицы("БюджетРасходы");
		ВосстановитьСортировкуТаблицы("БюджетДоходы");
		//Сортировка бюджетов
		
		//Использование количества
		УстановитьДоступностьОбновленияКоличестваНаСервере();
		//Использование количества
		
	ИначеЕсли (ТекущаяСтраница = Элементы.СтраницаДекларации) Тогда
		
		ВыполнитьДействие(_УФКС.СД("Грузоперевозки","сервер","/ДекларацииОбновить"));
		
	КонецЕсли; 
	
КонецПроцедуры  

&НаСервере
Процедура _УстановитьЗаголовокСтраницыГрузоперевозок()
	
	Если (Объект.Ссылка.Пустая()) Тогда
		Возврат;
	КонецЕсли; 
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ CW_Грузоперевозки.Ссылка) КАК КоличествоГрузоперевозок
	               |ИЗ
	               |	Справочник.CW_Грузоперевозки КАК CW_Грузоперевозки
	               |ГДЕ
	               |	CW_Грузоперевозки.Заказ = &Заказ";
	
	Запрос.УстановитьПараметр("Заказ", Объект.Ссылка);
	РезультатЗапроса = Запрос.Выполнить();
	
	КоличествоГрузоперевозок = 0;
	Выборка = РезультатЗапроса.Выбрать();
	Если Выборка.Следующий() Тогда
		КоличествоГрузоперевозок = Выборка.КоличествоГрузоперевозок;
	КонецЕсли;
	
	Элементы.СтраницаЖурналГрузоперевозок.Заголовок = "Грузоперевозки"+?(КоличествоГрузоперевозок=0, "", " ("+Формат(КоличествоГрузоперевозок,"ЧДЦ=; ЧН=; ЧГ=")+")"); 
	
КонецПроцедуры

#КонецОбласти 

#Область Реквизиты 

&НаКлиенте
Процедура ТипПеревозкиПриИзменении(Элемент)
	
	Если ИспользуютсяПараметрыВЗаказах Тогда
		ДиалогЗаполненияПоТипу();   
	Иначе
		ЗаполнитьПредопределенныеЗначенияРеквизитовШапки();
		ПродолжитьЗаполнениеПриИзмененииТипаПеревозки();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПродолжитьЗаполнениеПриИзмененииТипаПеревозки()
	
	Если (ЗначениеЗаполнено(Объект.ТипПеревозки) И Журнал_Данные.Количество() <> 0) Тогда
		ПОВ = Новый ОписаниеОповещения("ОбработкаВопросаПерезаполненияПараметровПоШаблону",ЭтотОбъект); 
		ПоказатьВопрос(ПОВ,"Параметры всех грузоперевозок будут заменены по шаблону. Продолжить?", РежимДиалогаВопрос.ДаНет);
	Иначе
		ВыполнитьДействие(_УФКС.СД("Грузоперевозки","сервер","/УправлениеЭлементамиФормы"));
		
		ВыполнитьДействиеНаСервере(_УФКС.СД("Журналы","сервер","/ИнициализацияФормы",Новый Структура("ИмяСеансовойНастройки","ПоследняяНастройкаЗаказы")));
		ВыполнитьДействиеНаСервере(_УФКС.СД("Журналы","сервер","/ИнициализацияНастроек"));
		ВыполнитьДействиеНаСервере(_УФКС.СД("Журналы","сервер","/ОбновитьДанные"));
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВопросаПерезаполненияПараметровПоШаблону(Ответ, ДополнительныеПараметры) Экспорт 
	// --- 
	
	Если (Ответ = КодВозвратаДиалога.Да) Тогда
	
		_ЗаполнитьПараметрыГрузоперевозокПоТипуПеревозки();
		
		ВыполнитьДействие(_УФКС.СД("Грузоперевозки","сервер","/УправлениеЭлементамиФормы"));
		ВыполнитьДействиеНаСервере(_УФКС.СД("Журналы","сервер","/ИнициализацияФормы",Новый Структура("ИмяСеансовойНастройки","ПоследняяНастройкаЗаказы")));
		ВыполнитьДействиеНаСервере(_УФКС.СД("Журналы","сервер","/ИнициализацияНастроек"));
		ВыполнитьДействиеНаСервере(_УФКС.СД("Журналы","сервер","/ОбновитьДанные"));
		
	КонецЕсли; 

КонецПроцедуры

&НаКлиенте
Процедура ПерезаполнитьПредопределенныеЗначенияРеквизитовШапки(Команда)
	Если ЗначениеЗаполнено(Объект.ТипПеревозки) Тогда
		ЗаполнитьПредопределенныеЗначенияРеквизитовШапки();
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПредопределенныеЗначенияРеквизитовШапки()
	
	_УФС.ЗаполнитьПредопределенныеЗначенияРеквизитовШапки(Объект, Объект.ТипПеревозки, "ДляЗаказа");
	
КонецПроцедуры
  

&НаСервере
Процедура _ЗаполнитьПараметрыГрузоперевозокПоТипуПеревозки()
	
	мСсылки = Журнал_Данные.Выгрузить().ВыгрузитьКолонку("Ссылка");
	
	ТабПараметровТипаПеревозки 		= Объект.ТипПеревозки.ПараметрыГрузоперевозки.Выгрузить();
	ГруппыПараметровГрузоперевозки 	= Объект.ТипПеревозки.ГруппыПараметровГрузоперевозки.Выгрузить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	CW_ТипыПеревозокПараметрыГрузоперевозки.Параметр КАК Параметр
	               |ПОМЕСТИТЬ ВТ_ПараметрыТипаПеревозки
	               |ИЗ
	               |	Справочник.CW_ТипыПеревозок.ПараметрыГрузоперевозки КАК CW_ТипыПеревозокПараметрыГрузоперевозки
	               |ГДЕ
	               |	CW_ТипыПеревозокПараметрыГрузоперевозки.Ссылка = &ТипПеревозки
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	CW_ГрузоперевозкиПараметрыГрузоперевозки.Параметр КАК Параметр,
	               |	CW_ГрузоперевозкиПараметрыГрузоперевозки.Ссылка КАК Ссылка
	               |ПОМЕСТИТЬ ВТ_ПараметрыГрузоперевозок
	               |ИЗ
	               |	Справочник.CW_Грузоперевозки.ПараметрыГрузоперевозки КАК CW_ГрузоперевозкиПараметрыГрузоперевозки
	               |ГДЕ
	               |	CW_ГрузоперевозкиПараметрыГрузоперевозки.Ссылка В(&мСсылки)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ_ПараметрыГрузоперевозок.Ссылка КАК Грузоперевозка,
	               |	ВТ_ПараметрыГрузоперевозок.Параметр КАК Параметр,
	               |	ВТ_ПараметрыТипаПеревозки.Параметр КАК ПараметрТипа
	               |ИЗ
	               |	ВТ_ПараметрыГрузоперевозок КАК ВТ_ПараметрыГрузоперевозок
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ПараметрыТипаПеревозки КАК ВТ_ПараметрыТипаПеревозки
	               |		ПО ВТ_ПараметрыГрузоперевозок.Параметр = ВТ_ПараметрыТипаПеревозки.Параметр
	               |ИТОГИ
	               |	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Параметр)
	               |ПО
	               |	Грузоперевозка";
	
	Запрос.УстановитьПараметр("ТипПеревозки", Объект.ТипПеревозки);
	Запрос.УстановитьПараметр("мСсылки"		, мСсылки);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаГрузоперевозки = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	НачатьТранзакцию();

	Для каждого Грузоперевозка из мСсылки Цикл
		
		ВыборкаГрузоперевозки.Сбросить();
		
		Отбор = новый Структура("Грузоперевозка",Грузоперевозка);
		
		мСохраняемыепараметры = Новый Массив;
		Если ВыборкаГрузоперевозки.НайтиСледующий(Отбор) Тогда
			Если ВыборкаГрузоперевозки.Параметр	> 0 Тогда
				ВыборкаПараметры = ВыборкаГрузоперевозки.Выбрать();
				Пока ВыборкаПараметры.Следующий() Цикл
					мСохраняемыепараметры.Добавить(ВыборкаПараметры.Параметр);
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;
		
		ГрузоперевозкаОбъект = Грузоперевозка.ПолучитьОбъект();
		
		//Перезаполняем гурппы    
		//AFR-240189
		ГрузоперевозкаОбъект.ГруппыПараметровГрузоперевозки.Загрузить(ГруппыПараметровГрузоперевозки);
		//AFR-240189
		
		Если мСохраняемыепараметры.Количество() = 0 Тогда
			//Просто загружаем таблицу, совпадений нет
			ГрузоперевозкаОбъект.ПараметрыГрузоперевозки.Загрузить(ТабПараметровТипаПеревозки);
		Иначе  
			//Заявка №AFR-240030
			//мСтрокиКУдалению = Новый Массив;
			////Готовим массив строк к удалению
			//Для каждого СтрокаПараметров из ГрузоперевозкаОбъект.ПараметрыГрузоперевозки Цикл
			//	Если мСохраняемыепараметры.Найти(СтрокаПараметров.Параметр) = Неопределено Тогда
			//		мСтрокиКУдалению.Добавить(СтрокаПараметров);
			//	КонецЕсли;
			//КонецЦикла;
			//
			//Если мСтрокиКУдалению.Количество() > 0 тогда
			//	//Удалем строки по массиву
			//	Для Каждого СтрокаМассива из мСтрокиКУдалению Цикл
			//		ГрузоперевозкаОбъект.ПараметрыГрузоперевозки.Удалить(СтрокаМассива);
			//	КонецЦикла;
			//КонецЕсли;
			//Заявка №AFR-240030
			
			//Добавляем парметры
			мПараметрыТипаперевозки = ТабПараметровТипаПеревозки.ВыгрузитьКолонку("Параметр");
			Для каждого НовыйПараметр из  мПараметрыТипаперевозки Цикл
				СтрокаПараметра = ГрузоперевозкаОбъект.ПараметрыГрузоперевозки.Найти(НовыйПараметр, "Параметр");
				Если СтрокаПараметра = Неопределено тогда
					новаяСтрока =  ГрузоперевозкаОбъект.ПараметрыГрузоперевозки.Добавить();
					новаяСтрока.Параметр = НовыйПараметр;
				КонецЕсли;
			КонецЦикла;
			
		КонецЕсли;
		
		ГрузоперевозкаОбъект.Записать();
		
	КонецЦикла;
	
	Если ТранзакцияАктивна() Тогда
		ЗафиксироватьТранзакцию();
	КонецЕсли;

КонецПроцедуры

