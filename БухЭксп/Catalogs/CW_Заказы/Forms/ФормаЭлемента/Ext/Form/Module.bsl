&НаКлиенте
Процедура ПолучитьСтрокуДерева(ИмяТаблицы, НовыйОбъект) 
	
	Если ИмяТаблицы = "БюджетДоходыДерево" Тогда
		КоллекцияЭлементовДерева = БюджетДоходыДерево.ПолучитьЭлементы();
	Иначе
		КоллекцияЭлементовДерева = БюджетРасходыДерево.ПолучитьЭлементы();
	КонецЕсли;

	Для каждого мСтрокиГрузоперевозок Из КоллекцияЭлементовДерева Цикл
		
		мСтрокиСтатей = мСтрокиГрузоперевозок.ПолучитьЭлементы();
		
        Для каждого СтрокаСтатьи Из мСтрокиСтатей Цикл
            Если СтрокаСтатьи.СтатьяСсылка = НовыйОбъект Тогда
                Элементы[ИмяТаблицы].ТекущаяСтрока = СтрокаСтатьи.ПолучитьИдентификатор();
            КонецЕсли;
        КонецЦикла;
	КонецЦикла;
	
