&НаКлиенте
Процедура ПоказатьСкрытьКомментарий_Доходы(Команда)
	
	ПоказатьСкрытьКомментарий_Доходы 									= Не ПоказатьСкрытьКомментарий_Доходы;
	Элементы.БюджетДоходыДеревоПоказатьСкрытьКомментарий_Доходы.Пометка	= ПоказатьСкрытьКомментарий_Доходы;
	
	ПоказатьСкрытьКомментарийДоходыРасходы(Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьСкрытьКомментарий_Расходы(Команда)
	
	ПоказатьСкрытьКомментарий_Расходы 										= Не ПоказатьСкрытьКомментарий_Расходы;
	Элементы.БюджетРасходыДеревоПоказатьСкрытьКомментарий_Расходы.Пометка 	= ПоказатьСкрытьКомментарий_Расходы;

	ПоказатьСкрытьКомментарийДоходыРасходы(Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьСкрытьКомментарийДоходыРасходы(ДоходыРасходы)
	
	Если ДоходыРасходы Тогда
		Элементы.БюджетДоходыДеревоКомментарий.Видимость  = ПоказатьСкрытьКомментарий_Доходы;
	Иначе
		Элементы.БюджетРасходыДеревоКомментарий.Видимость = ПоказатьСкрытьКомментарий_Расходы;
	КонецЕсли;
	
КонецПроцедуры


&НаКлиенте
Процедура Форма_ФинансыТранспортОбновить(Команда)
	
	ВыполнитьДействие(_УФКС.СД("Грузоперевозки","клиент",СтрЗаменить(Команда.Имя,"Форма_","/"),Неопределено));
	
КонецПроцедуры

&НаКлиенте
Процедура ФинансыТранспортВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Поле.Имя = "ФинансыТранспортПутевойЛист" Тогда
		ПараметрыФормы = Новый Структура("Ключ", ФинансыТранспорт[ВыбраннаяСтрока].ПутевойЛист);
		ОткрытьФорму("Документ.CW_ПутевойЛист.ФормаОбъекта",ПараметрыФормы);
	Иначе
		ПараметрыФормы = Новый Структура("Ключ", ФинансыТранспорт[ВыбраннаяСтрока].ДокументРасходов);
		ОткрытьФорму("Документ.ТребованиеНакладная.ФормаОбъекта",ПараметрыФормы);
	КонецЕсли;
	
КонецПроцедуры


//Изменение представления грузоперевозок
&НаКлиенте
Процедура ВводПредставленияГрузоперевозок(Команда)
	
	ВыделенныеСтроки 	= Элементы.Журнал.ВыделенныеСтроки;  
	Грузоперевозки 		= ПолучитьСсылкиВыделенныхСтрокНаСервере(ВыделенныеСтроки);	
	
	ПараметрыПроцедуры = Новый Структура;
	ПараметрыПроцедуры.Вставить("КоличествоСтрок", 		Грузоперевозки.Количество());
	ПараметрыПроцедуры.Вставить("Грузоперевозки",  		Грузоперевозки);
	ПараметрыПроцедуры.Вставить("ВыделенныеСтроки",  	ВыделенныеСтроки);
	
	CW_МониторингКлиент.ПередНачаломВводаПредставлений(ЭтаФорма, ПараметрыПроцедуры);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьРезультатЗаполненияПредставлений(РезультатВыполнения, ДополнительныеПараметры) Экспорт
	
	Если РезультатВыполнения.Статус = "Выполнено" Тогда
		
		ОбновитьПредставленияНаФормеНаСервере(РезультатВыполнения.АдресРезультата, ДополнительныеПараметры.ВыделенныеСтроки); 
	   	ОповеститьОбИзменении(Тип("СправочникСсылка.CW_Грузоперевозки"));
		
	ИначеЕсли РезультатВыполнения.Статус = "Ошибка" Тогда
		
		ТекстПредупреждения = "Не удалось обновить предсставления грузоперевозок!
		| По причине: "+ РезультатВыполнения.КраткоеПредставлениеОшибки + "
		| Информаиция об ошибке см. в журнале регистрации!";
		
		Если ТипЗнч(РезультатВыполнения.Сообщения) = Тип("Массив") Тогда
			Для Каждого СообщениеВМассиве из РезультатВыполнения.Сообщения Цикл
				СообщениеВМассиве.Сообщить();
			КонецЦикла;
		КонецЕсли;
		
		ПоказатьПредупреждение(,ТекстПредупреждения,,"Ошибка обновления представлений");
		
	КонецЕсли;
	
КонецПроцедуры

