&НаКлиенте
Процедура ОчиститьЗаявкуНаФорме()
	
	Если Объект.Клиент = КлиентДоИзменения 
			или Не ЗначениеЗаполнено(Объект.Заявка) 
			или Не ЗначениеЗаполнено(КлиентДоИзменения) Тогда
		Возврат; //ничего делать не нужно
	КонецЕсли; 
	
	КлиентЗаявки = ПолучитьКлиентаЗаявки(Объект.Заявка);
	Если Объект.Клиент = КлиентЗаявки Тогда
		Возврат; //ничего делать не нужно
	КонецЕсли; 
	
	Режим = РежимДиалогаВопрос.ДаНет;
	Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаПриИзмененииКлиента", ЭтотОбъект);
	ПоказатьВопрос(Оповещение, "Контрагент заказа не соответствует контрагенту заявки. Очистить заявку?", Режим, 0);	
	
КонецПроцедуры  

