 &НаСервере
Функция ПолучитьМассивВыбранныхСтатейБюджетаНаСервере(ВыделенныеСтроки, ИмяТаблицы) 
	
	ВидСтатьиПоИмениТаблицы = ПолучитьВидыСтатейПоИмениТаблицы();
	
	ВидСтатьи = ВидСтатьиПоИмениТаблицы.Получить(ИмяТаблицы);
	Если ВидСтатьи = Неопределено Тогда
		Возврат "Не удалось опредеить вид статьи бюджета!";
	КонецЕсли; 
	
	МассивСтатей = Новый Массив;
	
	Для Каждого ИдентификаторСтроки из ВыделенныеСтроки Цикл
		СтрокаТекущая = ЭтаФорма[ИмяТаблицы].НайтиПоИдентификатору(ИдентификаторСтроки);   
		
		ВыбранаГруппа 	= Ложь; 
		Грузоперевозка 	= Неопределено;
		Если ИмяТаблицы = "БюджетРасходыДерево" 
			ИЛИ ИмяТаблицы = "БюджетДоходыДерево" Тогда 
			
			СтрокаРодитель  =  СтрокаТекущая.ПолучитьРодителя();
			Если СтрокаРодитель <> Неопределено Тогда
				Грузоперевозка  = СтрокаРодитель.Контрагент;
			Иначе
				Грузоперевозка  = СтрокаТекущая.Контрагент;
				ВыбранаГруппа 	= Истина;
			КонецЕсли;
		КонецЕсли;
		
		Отбор = Новый Структура;
		Отбор.Вставить("ЗаказСсылка",           Объект.Ссылка);
		Отбор.Вставить("ВерсияБюджета",         БюджетТекущаяВерсия);
		Отбор.Вставить("ВидСтатьиПланирования", ВидСтатьи);
		Отбор.Вставить("Контрагент",            СтрокаТекущая.Контрагент);
		Отбор.Вставить("Номенклатура",          СтрокаТекущая.Номенклатура);
		Отбор.Вставить("Валюта",                СтрокаТекущая.Валюта);
		Отбор.Вставить("СтавкаНДС",             СтрокаТекущая.СтавкаНДС);
		Отбор.Вставить("Организация",           СтрокаТекущая.Организация);
		Отбор.Вставить("Грузоперевозка",        Грузоперевозка);
		Отбор.Вставить("ВыбранаГруппа",         ВыбранаГруппа);
		
		ТаблицаСтатей	= CW_Бюджетирование._ПолучитьТаблицуБюджетаДляРедактированияИзЗаказа(Отбор, Грузоперевозка);
		мСтатьиБюджета 	= ТаблицаСтатей.ВыгрузитьКолонку("СтатьяСсылка");  
		
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(МассивСтатей, мСтатьиБюджета, Истина);  
		
	КонецЦикла;   
	
	Возврат МассивСтатей;
	
КонецФункции

&НаСервере
Функция ПолучитьВидыСтатейПоИмениТаблицы()
	
	ВидСтатьиПоИмениТаблицы = Новый Соответствие;
	ВидСтатьиПоИмениТаблицы.Вставить("БюджетРасходы", 		ПредопределенноеЗначение("Перечисление.CW_ВидыСтатейПланирования.Расходы"));
	ВидСтатьиПоИмениТаблицы.Вставить("БюджетРасходыДерево", ПредопределенноеЗначение("Перечисление.CW_ВидыСтатейПланирования.Расходы"));
	
	ВидСтатьиПоИмениТаблицы.Вставить("БюджетДоходы", 		ПредопределенноеЗначение("Перечисление.CW_ВидыСтатейПланирования.Доходы"));
	ВидСтатьиПоИмениТаблицы.Вставить("БюджетДоходыДерево",  ПредопределенноеЗначение("Перечисление.CW_ВидыСтатейПланирования.Доходы"));

	Возврат ВидСтатьиПоИмениТаблицы;
	
КонецФункции

