&НаКлиенте
Процедура ОткрытьФормуВыбораГрузоперевозок(МножественныйВыбор, ЗакрыватьПриВыборе)
	
	СтруктураОтбора = Новый Структура;
	СтруктураОтбора.Вставить("Заказ", 			ПредопределенноеЗначение("Справочник.CW_Заказы.ПустаяСсылка")); 

	ПараметрыФормыПодбора = Новый Структура;
	ПараметрыФормыПодбора.Вставить("Отбор", 				СтруктураОтбора); 
	ПараметрыФормыПодбора.Вставить("РежимВыбора", 			Истина);
	ПараметрыФормыПодбора.Вставить("МножественныйВыбор", 	МножественныйВыбор);
	ПараметрыФормыПодбора.Вставить("ЗакрыватьПриВыборе", 	ЗакрыватьПриВыборе);
	
	Если ЗначениеЗаполнено(Объект.Клиент) Тогда
		ПараметрыФормыПодбора.Вставить("Клиент", Объект.Клиент);
	КонецЕсли; 
	
	ОткрытьФорму("Справочник.CW_Грузоперевозки.ФормаВыбора", ПараметрыФормыПодбора, ЭтаФорма,,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли; 

	Если ВРег(ИсточникВыбора.ИмяФормы)  = ВРег("Справочник.Пользователи.Форма.ФормаСписка") Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(ВыбранноеЗначение) <> Тип("Массив") 
		и ТипЗнч(ВыбранноеЗначение) <> Тип("СправочникСсылка.CW_Грузоперевозки")  Тогда
 		Возврат;
	КонецЕсли; 

	Если ТипЗнч(ВыбранноеЗначение) <> Тип("Массив") Тогда
		ВыбранноеЗначение = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ВыбранноеЗначение);	
	КонецЕсли;
	
	Если ВыбранноеЗначение.Количество() > 5 Тогда
		
		РезультатВыполнения =  ОбработатьВыборНаСервереВФоне(ВыбранноеЗначение);
		
		ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
		ПараметрыОжидания.ВыводитьОкноОжидания = Истина;
		ОповещениеОЗавершении = Новый ОписаниеОповещения("ОбработатьРезультатДобавленияГрузоперевозок", ЭтотОбъект);
		
		ДлительныеОперацииКлиент.ОжидатьЗавершение(РезультатВыполнения, ОповещениеОЗавершении, ПараметрыОжидания);
	Иначе 
		//меньше 5-ти грузопереозок обрабатываем без фона
		ОбработатьВыборНаСервере(ВыбранноеЗначение);	
		
		ПоказатьОповещениеПользователя("Добавление грузоперевозок к заказу",,"Выполнено",,СтатусОповещенияПользователя.Информация);
		ВыполнитьДействие(_УФКС.СД("Журналы","клиент","/Обновить",Неопределено));
	КонецЕсли;
	
КонецПроцедуры    


&НаСервере
Процедура ОбработатьВыборНаСервере(ВыбранноеЗначение)
	
	ПараметрыПроцедуры = Новый Структура;
	ПараметрыПроцедуры.Вставить("Заказ",				Объект.Ссылка);
	ПараметрыПроцедуры.Вставить("МассивГрузоперевозок",	ВыбранноеЗначение);
	
	Справочники.CW_Заказы.ДобавитьГрузоперевозки(ПараметрыПроцедуры);
	
КонецПроцедуры


&НаСервере
Функция ОбработатьВыборНаСервереВФоне(ВыбранноеЗначение)
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(Новый УникальныйИдентификатор);
	ПараметрыВыполнения.ОжидатьЗавершение 			= 0; // запускать сразу
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = "Добавление грузопереовзок к заказу";
	ПараметрыВыполнения.ЗапуститьВФоне 				= Истина;
	ПараметрыВыполнения.ЗапуститьНеВФоне 			= Ложь; 

	ПараметрыПроцедуры = Новый Структура;
	ПараметрыПроцедуры.Вставить("Заказ",				Объект.Ссылка);
	ПараметрыПроцедуры.Вставить("МассивГрузоперевозок",	ВыбранноеЗначение);
	
	Возврат ДлительныеОперации.ВыполнитьВФоне("Справочники.CW_Заказы.ДобавитьГрузоперевозки",ПараметрыПроцедуры, ПараметрыВыполнения);
	
КонецФункции

&НаКлиенте
Процедура ОбработатьРезультатДобавленияГрузоперевозок(РезультатВыполнения, Дополнительныепараметры) Экспорт
	
	Если РезультатВыполнения.Статус = "Выполнено" Тогда
		
		ПоказатьОповещениеПользователя("Добавление грузоперевозок к заказу",,"Выполнено",,СтатусОповещенияПользователя.Информация);
		ВыполнитьДействие(_УФКС.СД("Журналы","клиент","/Обновить",Неопределено));
		
	ИначеЕсли РезультатВыполнения.Статус = "Ошибка" Тогда
		
		ТекстПредупреждения = "Документы не сформированы!
		| По причине: "+ РезультатВыполнения.КраткоеПредставлениеОшибки + "
		| Информаиция об ошибке см. в журнале регистрации!";
		
		Если ТипЗнч(РезультатВыполнения.Сообщения) = Тип("Массив") Тогда
			Для Каждого СообщениеВМассиве из РезультатВыполнения.Сообщения Цикл
				СообщениеВМассиве.Сообщить();
			КонецЦикла;
		КонецЕсли;
		
		ПоказатьПредупреждение(,ТекстПредупреждения,,"Ошибка добавления грузоперевозок");
	КонецЕсли;
	
КонецПроцедуры
