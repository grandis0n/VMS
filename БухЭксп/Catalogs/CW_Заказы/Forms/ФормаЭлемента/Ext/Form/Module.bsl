	Для Каждого тСтр Из тЭлементы Цикл
		Элементы.ДПГ.Развернуть(тСтр.ПолучитьИдентификатор(), Истина);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти 

#Область ДобавлениеЭлементов 

&НаКлиенте
Процедура ДеревоПараметровГППередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	Отказ = Истина; 
	
	Если ЗначениеЗаполнено(ДатаБлокировкиМониторинга) тогда
		Возврат;
	КонецЕсли;
	
	// --- 
	ПОВ = Новый ОписаниеОповещения("ОбработкаВыбораПараметра",ЭтотОбъект); 
	
	ПарамерыФормыВыбора = Новый Структура;
	ПарамерыФормыВыбора.Вставить("ВыборГруппИЭлементов"	,ИспользованиеГруппИЭлементов.ГруппыИЭлементы);
	ПарамерыФормыВыбора.Вставить("Множественныйвыбор"	,Истина);

	ОткрытьФорму("ПланВидовХарактеристик.CW_ПараметрыГрузоперевозок.ФормаВыбора",ПарамерыФормыВыбора,Элемент,,,,ПОВ, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбораПараметра(Ответ, ДополнительныеПараметры) Экспорт
	// --- 
		
	Если (Ответ <> Неопределено) Тогда
		Если ТипЗнч(Ответ) = Тип("ПланВидовХарактеристикСсылка.CW_ПараметрыГрузоперевозок") Тогда
			Ответ = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Ответ);
		КонецЕсли;
		
		// если группа
		МассивДобавляемых = Новый Массив;
		ОдиночныйВыбор = Ответ.Количество() = 1;
		
		Для Каждого Параметр из Ответ Цикл
			
			// если группа
			Если (_ПараметрЯвляетсяГруппой(Параметр)) Тогда
				МассивДобавляемых = _ЭлементыГруппыПараметров(Параметр);
			Иначе
				МассивДобавляемых.Добавить(Параметр);
			КонецЕсли; 
			
		КонецЦикла;
		
		Если  ОдиночныйВыбор Тогда
			ДобавляемыйПараметр = Ответ[0];
			Если Не ДобавляемыйПараметрНовый(ДобавляемыйПараметр) Тогда
				// позиционируемся на выбранный элемент
				Идентификатор = _ИдентификаторСтрокиПараметра(ДобавляемыйПараметр);
				Если (Идентификатор <> Неопределено) Тогда
					Элементы.ДПГ.ТекущаяСтрока = Идентификатор;	
				КонецЕсли; 
				//_УФК.ВывестиПредупреждение("Параметр уже добавлен.");
				Возврат;
			КонецЕсли;
		КонецЕсли; 
		

		Для каждого ДобавляемыйПараметр Из МассивДобавляемых Цикл
			
			// проверяем, что параметр новый
			Если (ДобавляемыйПараметрНовый(ДобавляемыйПараметр)) Тогда
				
				ИдентификаторДобавленнойСтроки = _ДобавитьПараметр(ДобавляемыйПараметр);
				
				// ракрываем строку родителя, если свернута
				ДобавленнаяСтрока = ДПГ.НайтиПоИдентификатору(ИдентификаторДобавленнойСтроки);
				РодительДобавленнойСтроки = ДобавленнаяСтрока.ПолучитьРодителя();
				Если (РодительДобавленнойСтроки <> Неопределено) Тогда
					
					ИдентификаторРодителяДобавленнойСтроки = РодительДобавленнойСтроки.ПолучитьИдентификатор();
					Если (НЕ Элементы.ДПГ.Развернут(ИдентификаторРодителяДобавленнойСтроки)) Тогда
						Элементы.ДПГ.Развернуть(ИдентификаторРодителяДобавленнойСтроки);
						СохранитьСостояниеСверткиСтроки(ИдентификаторРодителяДобавленнойСтроки,Истина);
					КонецЕсли; 
					// --- 
					ДПГ_ТекущаяГруппа = РодительДобавленнойСтроки.ИдентификаторГруппы;
					
				Иначе
					
					ДПГ_ТекущаяГруппа = 0;
					
				КонецЕсли; 
				
				// позиционируемся на добавленный элемент
				Элементы.ДПГ.ТекущаяСтрока = ИдентификаторДобавленнойСтроки;
				// --- 
				ДПГ_ТекущийПараметр = ДобавленнаяСтрока.Параметр;
											
			КонецЕсли;
			
		КонецЦикла; 
		
		ПараметрыЗаказаИзменены = Истина;
		// --- 
	КонецЕсли; 
	
	// --- 
КонецПроцедуры

