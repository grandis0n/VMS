&НаКлиенте
Процедура ПередУдалениемБюджета(ВыделенныеСтроки, ИмяТаблицы)
	
	ДополнительныеПараметры = Новый Структура;   
	ДополнительныеПараметры.Вставить("ВыделенныеСтроки", 	ВыделенныеСтроки);
	ДополнительныеПараметры.Вставить("ИмяТаблицы", 			ИмяТаблицы);

	Оповещение = Новый ОписаниеОповещения("ПродолжитьУдалениеБюджета", ЭтотОбъект, ДополнительныеПараметры);
	
	CW_БюджетированиеКлиент.ПередУдалениемБюджета(ЭтотОбъект,Оповещение);
	
КонецПроцедуры 

&НаКлиенте
Процедура ПродолжитьУдалениеБюджета(Ответ,  ДополнительныеПараметры) Экспорт
	Если Ответ = Неопределено
		или Ответ <> КодВозвратаДиалога.ОК Тогда
		Возврат;
	КонецЕсли;   
	
	Текст = БюджетПередУдалениемНаСервере(ДополнительныеПараметры); 
	Если Не ПустаяСтрока(Текст) Тогда
		ПоказатьПредупреждение(, Текст);
	КонецЕсли; 
	
	Если ДополнительныеПараметры.ИмяТаблицы = "БюджетРасходы" 
		или ДополнительныеПараметры.ИмяТаблицы = "БюджетРасходыДерево" Тогда
		ВыполнитьДействие(_УФКС.СД("Грузоперевозки","клиент","/БюджетРасходыОбновить",	Неопределено));
	КонецЕсли;
	
	Если ДополнительныеПараметры.ИмяТаблицы = "БюджетДоходы" 
		или ДополнительныеПараметры.ИмяТаблицы = "БюджетДоходыДерево" Тогда
		ВыполнитьДействие(_УФКС.СД("Грузоперевозки","клиент","/БюджетДоходыОбновить",	Неопределено));
	КонецЕсли;
	
КонецПроцедуры   

&НаСервере
Функция БюджетПередУдалениемНаСервере(ДополнительныеПараметры)
	
	Если БюджетУтвержден Тогда
		Отказ = Истина;
		Возврат "Невозможно удалить утвержденный бюджет!";
	КонецЕсли;  

	УстановитьПривилегированныйРежим(Истина);

	ВидСтатьиПоИмениТаблицы = ПолучитьВидыСтатейПоИмениТаблицы();
	
	ВидСтатьи = ВидСтатьиПоИмениТаблицы.Получить(ДополнительныеПараметры.ИмяТаблицы);
	Если ВидСтатьи = Неопределено Тогда
		Возврат "Не удалсь определить вид статьи бюджета!";
	КонецЕсли;
	
	Для Каждого ИдентификаторСтроки из ДополнительныеПараметры.ВыделенныеСтроки Цикл
		СтрокаТекущая = ЭтаФорма[ДополнительныеПараметры.ИмяТаблицы].НайтиПоИдентификатору(ИдентификаторСтроки);   
		
		ВыбранаГруппа = Ложь; 
		Грузоперевозка = Неопределено;
		Если ДополнительныеПараметры.ИмяТаблицы = "БюджетРасходыДерево" 
			ИЛИ ДополнительныеПараметры.ИмяТаблицы = "БюджетДоходыДерево" Тогда 
			
			СтрокаРодитель  =  СтрокаТекущая.ПолучитьРодителя();
			Если СтрокаРодитель <> Неопределено Тогда
				Грузоперевозка  = СтрокаРодитель.Контрагент;
			Иначе
				Грузоперевозка  = СтрокаТекущая.Контрагент;
				ВыбранаГруппа 	= Истина;
			КонецЕсли;
		КонецЕсли;
		
		Отбор = Новый Структура;
		Отбор.Вставить("ЗаказСсылка",           Объект.Ссылка);
		Отбор.Вставить("ВерсияБюджета",         БюджетТекущаяВерсия);
		Отбор.Вставить("ВидСтатьиПланирования", ВидСтатьи);
		Отбор.Вставить("Контрагент",            СтрокаТекущая.Контрагент);
		Отбор.Вставить("Номенклатура",          СтрокаТекущая.Номенклатура);
		Отбор.Вставить("Валюта",                СтрокаТекущая.Валюта);
		Отбор.Вставить("СтавкаНДС",             СтрокаТекущая.СтавкаНДС);
		Отбор.Вставить("Организация",           СтрокаТекущая.Организация);
		Отбор.Вставить("Грузоперевозка",        Грузоперевозка);
		Отбор.Вставить("ВыбранаГруппа",         ВыбранаГруппа);
		
		ТаблицаСтатей 		= CW_Бюджетирование._ПолучитьТаблицуБюджетаДляРедактированияИзЗаказа(Отбор, Грузоперевозка);
		МассивСтатей 		= ТаблицаСтатей.ВыгрузитьКолонку("СтатьяСсылка");  
		СтатьиСоСсылками 	= CW_Бюджетирование.ПроверитьВозможностьУдаленияСтатейБюджета(МассивСтатей);
		
		Для Каждого СтрокаТаблицы Из ТаблицаСтатей Цикл 
			Если СтатьиСоСсылками.Найти(СтрокаТаблицы.СтатьяСсылка) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			СтатьяОбъект = СтрокаТаблицы.СтатьяСсылка.ПолучитьОбъект();
			СтатьяОбъект.Удалить();
		КонецЦикла;
		
	КонецЦикла;   
	
	
	Если ВариантГруппировкиБюджетаДоходыДерево  Тогда
		ЭлементыДереваДоходы = БюджетДоходыДерево.ПолучитьЭлементы();
		Элементы.ГруппаБюджетДоходы.Заголовок = "Доходы ("+ЭлементыДереваДоходы.Количество()+")";
		
		ЭлементыДереваРасходы = БюджетРасходыДерево.ПолучитьЭлементы();
		Элементы.ГруппаБюджетЗатраты.Заголовок = "Расходы ("+ЭлементыДереваРасходы.Количество()+")";
	Иначе
		Элементы.ГруппаБюджетДоходы.Заголовок 	= "Доходы ("+БюджетДоходы.Количество()+")";
		Элементы.ГруппаБюджетЗатраты.Заголовок  = "Расходы ("+БюджетРасходы.Количество()+")";
	КонецЕсли;
	
	Возврат "";
	
КонецФункции






