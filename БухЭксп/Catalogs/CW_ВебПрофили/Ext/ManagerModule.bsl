#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

Функция ВернутьПодчиненныеПрофили(ОсновнойПрофиль) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	CW_ВебПрофили.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.CW_ВебПрофили КАК CW_ВебПрофили
	|ГДЕ
	|	CW_ВебПрофили.ОсновнойПрофиль = &ОсновнойПрофиль";
	
	Запрос.УстановитьПараметр("ОсновнойПрофиль", ОсновнойПрофиль);  
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Возврат Выборка;
	
КонецФункции

Функция ВернутьПодчиненныеПрофилиДляСписка(мОсновнойПрофиль) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	CW_ВебПрофили.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.CW_ВебПрофили КАК CW_ВебПрофили
	|ГДЕ
	|	CW_ВебПрофили.ОсновнойПрофиль в (&мОсновнойПрофиль)";
	
	Запрос.УстановитьПараметр("мОсновнойПрофиль", мОсновнойПрофиль);  
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Возврат Выборка;
	
КонецФункции


