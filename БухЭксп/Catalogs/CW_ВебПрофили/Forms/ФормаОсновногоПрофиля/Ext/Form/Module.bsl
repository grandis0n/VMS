&НаКлиенте
Процедура ЗаврешитьВводТекстаНаРазныхЯзыках(РезультатВвода, ДополнительныеПараметры) Экспорт
	
	Если РезультатВвода = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЗаврешитьЗаврешитьВводТекстаНаРазныхЯзыкахНаСервере(РезультатВвода, ДополнительныеПараметры.Реквизит);

	Модифицированность = истина;
	
КонецПроцедуры

&НаСервере
Процедура ЗаврешитьЗаврешитьВводТекстаНаРазныхЯзыкахНаСервере(РезультатВвода, ИмяРеквизита)
	
	Для Каждого КлючЗначение из РезультатВвода Цикл
		Объект[ИмяРеквизита + КлючЗначение.Ключ] = КлючЗначение.Значение; 
	КонецЦикла;    
	
КонецПроцедуры


&НаКлиенте
Процедура НастройкаОтбораОтчетЗадолженность(Команда)

	Если Объект.Ссылка.Пустая() Тогда
		ПоказатьПредупреждение(, "Необходимо записать элемент справочнка!");
		Возврат;
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ИмяЭлемента",		"НастройкаОтбораОтчетЗадолженность");  
	ДополнительныеПараметры.Вставить("СхемаКомпоновки",	АдресСхемыДебиторскаяЗадолженность);  
	ДополнительныеПараметры.Вставить("АдресНастроек",	АдресНастроекОтбораОтчетЗадолженность);  
	ДополнительныеПараметры.Вставить("Записать",		Ложь);  
	
	Оповещение = Новый ОписаниеОповещения("ВопросПередНачаломНастроекОтбора", ЭтотОбъект, ДополнительныеПараметры);
	
	Если Объект.Ссылка.Пустая() Тогда
		ДополнительныеПараметры.Вставить("Записать", Истина);  
		Режим = РежимДиалогаВопрос.ДаНет;
		ПоказатьВопрос(Оповещение, "Элемент справочника будет записан. Продлолжить?", Режим, 0);
	Иначе  
		ВыполнитьОбработкуОповещения(Оповещение, КодВозвратаДиалога.Да);
	КонецЕсли;
	

КонецПроцедуры

