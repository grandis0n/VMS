&НаКлиенте
Процедура ДоступныеВариантыОтчетаПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	Отказ = Истина;
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("КлючОбъекта", 		"Отчет.CW_ЛичныйКабинетДебиторскаЗадолженность");
	СтруктураПараметров.Вставить("КлючТекущихНастроек", Неопределено); 
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ЗавершитьВыборВариантаОтчета", ЭтотОбъект);
	
	ОткрытьФорму("ХранилищеНастроек.ХранилищеВариантовОтчетов.Форма.ВыборВариантаОтчета", СтруктураПараметров, ЭтаФорма,,,,ОписаниеОповещения)


КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьВыборВариантаОтчета(РезультатВыбора, ДополнительныеПараметры) Экспорт   
	
	Если РезультатВыбора = Неопределено Тогда
		Возврат;
	КонецЕсли;  
	
	ЗавершитьВыборВариантаОтчетаНаСервере(РезультатВыбора, ДополнительныеПараметры);
	
КонецПроцедуры 

&НаСервере
Процедура ЗавершитьВыборВариантаОтчетаНаСервере(РезультатВыбора, ДополнительныеПараметры)   
	
	ВыбранныйВариантОтчета = Справочники.ВариантыОтчетов.НайтиПоРеквизиту("КлючВарианта", РезультатВыбора.КлючНастроек);
	Если Не ЗначениеЗаполнено(ВыбранныйВариантОтчета) Тогда
		Возврат;
	КонецЕсли;       
	
	Отбор = Новый Структура("ВариантОтчета", ВыбранныйВариантОтчета);
	мСтроки = Объект.ДоступныеВариантыОтчета.НайтиСтроки(Отбор);
	Если мСтроки.Количество() > 0 Тогда
		Возврат;
	КонецЕсли;
	
	НоваяСтрока = Объект.ДоступныеВариантыОтчета.Добавить();
	НоваяСтрока.ВариантОтчета = ВыбранныйВариантОтчета;
	НоваяСтрока.КомандаСтроки = "Сформировать";
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьОтчетОсновной(Команда)
	
	ОткрытьВариантОтчета("Основной")

КонецПроцедуры  

&НаКлиенте
Процедура ОткрытьОтчет(Команда)
	
	ТекущиеДанные = Элементы.ДоступныеВариантыОтчета.ТекущиеДанные; 
	КлючВарианта  = ПолучитьКлючТекущегоВариантаОтчета(ТекущиеДанные.ВариантОтчета);
	
	ОткрытьВариантОтчета(КлючВарианта);
	
КонецПроцедуры   

&НаКлиенте
Процедура ДоступныеВариантыОтчетаВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если Поле.ГиперссылкаЯчейки Тогда
		ТекущиеДанные 	= Элементы.ДоступныеВариантыОтчета.ТекущиеДанные; 
		КлючВарианта 	= ПолучитьКлючТекущегоВариантаОтчета(ТекущиеДанные.ВариантОтчета);
		
		ОткрытьВариантОтчета(КлючВарианта);
	КонецЕсли;

КонецПроцедуры    

&НаСервереБезКонтекста
Функция ПолучитьКлючТекущегоВариантаОтчета(ВариантОтчета)
	
	Если Не ЗначениеЗаполнено(ВариантОтчета) Тогда
		Возврат "Основной";
	КонецЕсли;
	
	Возврат ВариантОтчета.КлючВарианта;
	
КонецФункции

&НаКлиенте
Процедура ОткрытьВариантОтчета(КлючВарианта)
	
	ФормаОтчета = ПолучитьФорму("Отчет.CW_ЛичныйКабинетДебиторскаЗадолженность.Форма");;
	ФормаОтчета.УстановитьТекущийВариант(КлючВарианта);
	
	Настройки = ПолучитьНастройки(ФормаОтчета.Отчет.КомпоновщикНастроек, АдресНастроекОтбораОтчетЗадолженность, Объект.ТипДополнительнойИнформации);
	ФормаОтчета.Отчет.КомпоновщикНастроек.ЗагрузитьНастройки(Настройки);
	
	ФормаОтчета.СкомпоноватьРезультат();
	ФормаОтчета.Открыть();

КонецПроцедуры



&НаСервереБезКонтекста
Функция ПолучитьНастройки(КомпоновщикНастроек, АдресНастроек, ТипДополнительнойИнформции =0)
	
	Настройки = КомпоновщикНастроек.ПолучитьНастройки();  
	
	ХранимыеНастройки = ПолучитьИзВременногоХранилища(АдресНастроек);
	Для Каждого ЭлементОтбораПрофиля Из ХранимыеНастройки.Отбор.Элементы Цикл
		ЭлементОтбораОтчета = Настройки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЗаполнитьЗначенияСвойств(ЭлементОтбораОтчета, ЭлементОтбораПрофиля);
	КонецЦикла;
	
    Возврат Настройки;
	
КонецФункции

&НаСервере
Функция ПолучитьОтборИзНастроек()
	
	СтруктураОтбора = Новый Структура; 
	
	НастройкиОтчет = ПолучитьИзВременногоХранилища(АдресНастроекОтбораОтчетЗадолженность);
	Для Каждого ЭлементОтбора Из НастройкиОтчет.Отбор.Элементы Цикл  
		СтруктураОтбора.Вставить(СокрЛП(ЭлементОтбора.ЛевоеЗначение),ЭлементОтбора.ПравоеЗначение);
	КонецЦикла; 
	
	Возврат СтруктураОтбора;
	
КонецФункции

