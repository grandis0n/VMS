&НаКлиенте
Процедура ПроверитьВозможностьУстановитьОтборПоСписку()
	// --- 
	
	Идентификатор = Элементы.КомпоновщикНастроекНастройкиОтбор.ТекущаяСтрока;
	Доступно = Ложь;
	Если (Идентификатор <> Неопределено) Тогда
		
		ЭлементОтбора = КомпоновщикНастроек.Настройки.Отбор.ПолучитьОбъектПоИдентификатору(Идентификатор);
		Если (ТипЗнч(ЭлементОтбора) = Тип("ЭлементОтбораКомпоновкиДанных")) Тогда
			
			Если (ТипЗнч(ЭлементОтбора.ПравоеЗначение) = Тип("Строка")) Тогда
				Доступно = Истина;
			КонецЕсли; 
			
		КонецЕсли;
		
	КонецЕсли; 
	Элементы.КомпоновщикНастроекНастройкиОтборСформироватьСписок.Доступность = Ложь;
	
	// --- 
КонецПроцедуры


&НаКлиенте
Процедура КомпоновщикНастроекНастройкиОтборПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)

	Отказ = Истина;

	ОписаниеОповещения = Новый ОписаниеОповещения("ОбработкаДобавленияОтбора", ЭтотОбъект);  
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("СхемаКомпоновкиДанных", 	СхемаКомпоновки);
	ПараметрыФормы.Вставить("Режим", 					"Отбор");
	ПараметрыФормы.Вставить("ИсключенныеПоля", 			ПолучитьЗапрещенныеПоля());
	ПараметрыФормы.Вставить("ТекущаяСтрока", 			Неопределено);  
	
	ОткрытьФорму("ОбщаяФорма.CW_ФормаВыбораДоступногоПоля", ПараметрыФормы,Элемент,,,,ОписаниеОповещения,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);  
	
КонецПроцедуры  

&НаКлиенте
Функция ПолучитьЗапрещенныеПоля() Экспорт
	
	СписокПолей = Новый Массив;
	СписокПолей.Добавить("UserFields");
	СписокПолей.Добавить("DataParameters");
	СписокПолей.Добавить("SystemFields");

	СписокПолей.Добавить("Документ.Услуги"); 
	СписокПолей.Добавить("Документ.ДополнительныеРеквизиты");
	СписокПолей.Добавить("Документ.Дата"); 
	СписокПолей.Добавить("Документ.Организация"); 
 	СписокПолей.Добавить("Документ.Контрагент"); 

	СписокПолей.Добавить("Документ.ЗачетАвансов");
	СписокПолей.Добавить("Документ.ЗачетАвансовОЗ");
	СписокПолей.Добавить("Документ.ПлатёжноРасчётныеДокументы");
	СписокПолей.Добавить("Документ.ДокументыОбОтгрузке");
	СписокПолей.Добавить("Документ.СуммаДокумента");
	СписокПолей.Добавить("Документ.Валюта");

	СписокПолей.Добавить("Документ.ДокументыВознаграждения"); 
	СписокПолей.Добавить("Документ.ВсегоСуммаВсего"); 
	СписокПолей.Добавить("Документ.ВалютаДокумента"); 

	Возврат Новый ФиксированныйМассив(СписокПолей);
	
КонецФункции

&НаКлиенте
Процедура ОбработкаДобавленияОтбора(РезультатВыбора, ДополнительныеПараметры) Экспорт
	
	Если РезультатВыбора = Неопределено или РезультатВыбора = КодВозвратаДиалога.Отмена Тогда
		Возврат;
	КонецЕсли;   
	
	ЭлементОтбора = КомпоновщикНастроек.Настройки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));   
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(РезультатВыбора.Поле);
	ЭлементОтбора.Использование = Истина; 
	
	Если Элементы.КомпоновщикНастроекНастройкиОтбор.ТекущаяСтрока <> Неопределено Тогда
		Элементы.КомпоновщикНастроекНастройкиОтбор.Развернуть(Элементы.КомпоновщикНастроекНастройкиОтбор.ТекущаяСтрока);  
	КонецЕсли;
	
КонецПроцедуры  


