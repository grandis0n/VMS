&НаКлиенте
Процедура СформироватьСписок(Команда)
	
	СтрокаСписка = "";
	ОписаниеОповещения = Новый ОписаниеОповещения("ОбработкаВводаСписка", ЭтотОбъект); 
	ПоказатьВводСтроки(ОписаниеОповещения, СтрокаСписка, "Введите список значений", , Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВводаСписка(СтрокаСписка, ДопПараметры) Экспорт
	
	Если СтрокаСписка <> Неопределено Тогда
		спЗначений = ПолучитьСписок(СтрокаСписка);
		Если спЗначений.Количество() > 0 Тогда
			ТД = Элементы.КомпоновщикНастроекНастройкиОтбор.ТекущиеДанные;
			Для Каждого СтрОтбора из КомпоновщикНастроек.Настройки.Отбор.Элементы Цикл
				Если СтрОтбора.ЛевоеЗначение = ТД.ЛевоеЗначение И ТипЗнч(СтрОтбора.ПравоеЗначение) = Тип("Строка") Тогда 
					СтрОтбора.ВидСравнения   = ВидСравненияКомпоновкиДанных.ВСписке;
					СтрОтбора.ПравоеЗначение = спЗначений;
					СтрОтбора.Использование  = Истина;
				КонецЕсли;	
			КонецЦикла;	
		КонецЕсли;	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьСписок(Список)
	
	Разделители = ПолучитьРазделитили();
	спЗначений = Новый СписокЗначений;
	ДлТекста = СтрДлина(Список);
	ВыхТекст = "";
	Для Инк = 1 по ДлТекста Цикл
		Если Разделители.Найти(Сред(Список, Инк, 1)) = Неопределено Тогда
			ВыхТекст = ВыхТекст + Сред(Список, Инк, 1);	
		Иначе
			Если ЗначениеЗаполнено(ВыхТекст) Тогда
				спЗначений.Добавить(СокрЛП(ВыхТекст));
				ВыхТекст = "";
			КонецЕсли;	
		КонецЕсли; 
	КонецЦикла;	
	Если ЗначениеЗаполнено(ВыхТекст) Тогда
		спЗначений.Добавить(СокрЛП(ВыхТекст));
		ВыхТекст = "";
	КонецЕсли;
	
	Возврат спЗначений;
	
КонецФункции

&НаКлиенте
Функция ПолучитьРазделитили();
	
	мас = Новый Массив;
	мас.Добавить(";");
	мас.Добавить(".");
	мас.Добавить(",");
	//мас.Добавить(" ");	
	мас.Добавить(Символы.ВК);
	мас.Добавить(Символы.ВТаб);
	мас.Добавить(Символы.ПС);
	мас.Добавить(Символы.ПФ);
	мас.Добавить(Символы.Таб); 
	
	Возврат мас;
	
КонецФункции	

