
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	CW_ПраваДоступа.УстановитьПраваДляФормы(ЭтаФорма);
	_УФС.ОтключитьИсториюВыбораЭлементовФормы(ЭтаФорма);
	//Внешние подклчюаемые команды
	CW_ПодключаемыеКомандыСервер.ПриСозданииНаСервере(ЭтотОбъект);
	
КонецПроцедуры


&НаКлиенте
Процедура СтранаПриИзменении(Элемент)
	СтранаПриИзмененииНаСервере();
КонецПроцедуры

&НаСервере
Процедура СтранаПриИзмененииНаСервере()
	Справочники.CW_Суда.УстановитьАктуальноеЗначениеИсторииСтраны(Объект.Страна, Объект.ИсторияСтраны);
КонецПроцедуры

&НаКлиенте
Процедура ИсторияСтраныНажатие(Элемент)

	ПараметрыФормы = Новый Структура("ТекущиаяСтрана, ИсторияСтраны, ТолькоПросмотр", 
					Объект.Страна, Объект.ИсторияСтраны, ТолькоПросмотр);
	
	ОткрытьФорму("Справочник.CW_Суда.Форма.РедактированиеИсторииСтраны", ПараметрыФормы, ЭтотОбъект);

КонецПроцедуры  


&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)

	Если ВРег(ИсточникВыбора.ИмяФормы) = ВРег("Справочник.CW_Суда.Форма.РедактированиеИсторииСтраны") Тогда

		УстановитьСтрануПослеРедактированияИстории(ВыбранноеЗначение.ИсторияСтраны); 
		
	КонецЕсли;
	
	
КонецПроцедуры


&НаСервере
Процедура УстановитьСтрануПослеРедактированияИстории(НаборЗаписей)
	
	Модифицированность = Истина;
	
	НаборЗаписей.Сортировать("Период");
	
	Объект.ИсторияСтраны.Очистить();
	Если НаборЗаписей.Количество() > 1 Тогда
		Для Каждого ЗаписьНабора Из НаборЗаписей Цикл
			ЗаписьИстории = Объект.ИсторияСтраны.Добавить();
			ЗаполнитьЗначенияСвойств(ЗаписьИстории, ЗаписьНабора);
		КонецЦикла;
	КонецЕсли;
	
	Объект.Страна = НаборЗаписей[НаборЗаписей.Количество()-1].Страна;
	СтранаПриИзмененииНаСервере();
	
КонецПроцедуры


#Область Подключаемые_внешние_команды

&НаКлиенте
Процедура ВнешняяКоманда_ВыполнитьКоманду(Команда)
	
	CW_ПодключаемыеКомандыКлиент.ВыполнитьВнешнююКоманду(ЭтотОбъект, Команда.Имя);

КонецПроцедуры

#КонецОбласти