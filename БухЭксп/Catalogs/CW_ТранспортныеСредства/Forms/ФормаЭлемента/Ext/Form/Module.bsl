&НаСервере
Процедура ЗаполнитьТаблицуХарактеристикМодели()
	
	Если Не ЗначениеЗаполнено(Объект.Модель) тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.Модель.ТипТранспортногоСредства) тогда
		Возврат;
	КонецЕсли;
	
	ДеревоХарактеристик  = РеквизитФормыВЗначение("ХарактеристикиМодели");
	
	ДеревоХарактеристик.Строки.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	CW_МоделиТС.ТипТранспортногоСредства.НаличиеКузоваИлиЦистерны КАК НаличиеКузоваИлиЦистерны,
	               |	CW_МоделиТС.ТипТранспортногоСредства.НаличиеРефрижираторнойУстановки КАК НаличиеРефрижираторнойУстановки,
	               |	CW_МоделиТС.ТипКолеснойБазы КАК Характеристики__Тип_колесной_базы,
	               |	CW_МоделиТС.ВидЗагрузки КАК Характеристики__Вид_загрузки,
	               |	CW_МоделиТС.Высота КАК Характеристики__Высота,
	               |	CW_МоделиТС.Длина КАК Характеристики__Длина,
	               |	CW_МоделиТС.Ширина КАК Характеристики__Ширина,
	               |	CW_МоделиТС.Вес КАК Характеристики__Вес,
	               |	CW_МоделиТС.Грузоподъемность КАК Характеристики__Грузоподъемность,
	               |	CW_МоделиТС.Объем КАК Характеристики__Объем,
	               |	CW_МоделиТС.ТемператураПредставление КАК Температурынй_режим__Температура,
	               |	CW_МоделиТС.ТипДвигателяТС КАК Двигатель__Тип,
	               |	CW_МоделиТС.МодельДвигателя КАК Двигатель__Модель,
	               |	CW_МоделиТС.ОбъемДвигателя КАК Двигатель__Объем,
	               |	CW_МоделиТС.МощностьДвигателяКВТ КАК Двигатель__Мощность_кВТ,
	               |	CW_МоделиТС.МощностьДвигателяЛС КАК Двигатель__Мощность_ЛС,
	               |	НЕ CW_МоделиТС.ТопливныйБакОтсутствует КАК Топливный_Бак__Наличие,
	               |	CW_МоделиТС.ОбъемТопливногоБака КАК Топливный_Бак__Объем
	               |ИЗ
	               |	Справочник.CW_МоделиТС КАК CW_МоделиТС
	               |ГДЕ
	               |	CW_МоделиТС.Ссылка = &МодельТС";
	
	Запрос.УстановитьПараметр("МодельТС", Объект.Модель);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		СтруктураХарактеристик = новый Структура;
		СтруктураХарактеристик.Вставить("Характеристики__Тип_колесной_базы", "Тип колесной базы");
		СтруктураХарактеристик.Вставить("Характеристики__Вес", "Вес, т.");
		
		Если Выборка.НаличиеКузоваИлиЦистерны Тогда
			СтруктураХарактеристик.Вставить("Характеристики__Вид_загрузки"		, "Вид загрузки");
			СтруктураХарактеристик.Вставить("Характеристики__Грузоподъемность"	, "Грузоподъемность, т.");
			СтруктураХарактеристик.Вставить("Характеристики__Объем"				, "Объем, м.куб.");
			СтруктураХарактеристик.Вставить("Характеристики__Высота"			, "Высота, м." );
			СтруктураХарактеристик.Вставить("Характеристики__Длина"				, "Длина, м.");
			СтруктураХарактеристик.Вставить("Характеристики__Ширина"			, "Ширина, м.");
		КонецЕсли;
		
		Если Выборка.НаличиеРефрижираторнойУстановки тогда
			СтруктураХарактеристик.Вставить("Температурынй_режим__Температура", "Диапазон температур, град. С");
		КонецЕсли;
		
		Если Выборка.Двигатель__Тип <> Перечисления.CW_ТипыДвигателейТС.Отсутствует Тогда
			СтруктураХарактеристик.Вставить("Двигатель__Тип"		, "Тип");
			СтруктураХарактеристик.Вставить("Двигатель__Модель"		, "Модель");
			
			Если Выборка.Двигатель__Тип <> Перечисления.CW_ТипыДвигателейТС.Электрический Тогда
				СтруктураХарактеристик.Вставить("Двигатель__Объем"	, "объем, см.куб");
			КонецЕсли;
			
			СтруктураХарактеристик.Вставить("Двигатель__Мощность_кВТ"	, "Мощность, к.Вт");
			СтруктураХарактеристик.Вставить("Двигатель__Мощность_ЛС"	, "Мощность, л.с.");
			
			Если Выборка.Топливный_бак__Наличие Тогда
				СтруктураХарактеристик.Вставить("Топливный_бак__Объем"	, "Объем, л.");
			КонецЕсли;
		КонецЕсли;
		
		Для Каждого ЭлементСтркутуры из СтруктураХарактеристик Цикл
			
			Строки 			= СтрЗаменить(ЭлементСтркутуры.Ключ,"__",Символы.ПС);
			МассивСтрок 	= Новый Массив;
			Для Счетчик 	= 1 По СтрЧислоСтрок(Строки) Цикл
				МассивСтрок.Добавить(СтрПолучитьСтроку(Строки,Счетчик));
			КонецЦикла; 
			
			Если МассивСтрок.Количество() = 2 Тогда 
				ГруппаХарактеристик 	= МассивСтрок[0];
			Иначе 
				Продолжить;
			КонецЕсли;

			ГруппаХарактеристик 	= СтрЗаменить(ГруппаХарактеристик , "_", " ");
			Значение 				= Выборка[ЭлементСтркутуры.Ключ];
			
			Если ТипЗнч(Значение) = Тип("Число") Тогда
				Значение = Формат(Значение, "ЧДЦ=3");
			Иначе
				Значение = СокрЛП(Значение);
			КонецЕсли;
			
			//Заполнение дерева
			ГруппаСтрока = ДеревоХарактеристик.Строки.Найти(ГруппаХарактеристик,"тРодитель");
			Если ГруппаСтрока  = Неопределено Тогда
				ГруппаСтрока = ДеревоХарактеристик.Строки.Добавить();
				ГруппаСтрока.тРодитель 		= ГруппаХарактеристик;
				ГруппаСтрока.Характеристика = ГруппаХарактеристик;
				ГруппаСтрока.ТипЭлемента 	= 0;
			КонецЕсли;
			
			СтрокаХарактеристка =  ГруппаСтрока.Строки.Добавить();
			СтрокаХарактеристка.тРодитель 		= ГруппаХарактеристик;
			СтрокаХарактеристка.Характеристика  = ЭлементСтркутуры.Значение;
			СтрокаХарактеристка.Значение 		= Значение;
			СтрокаХарактеристка.ТипЭлемента 	= 3;
			
		КонецЦикла;
		
	КонецЕсли;
	
	ЗначениеВРеквизитФормы(ДеревоХарактеристик, "ХарактеристикиМодели");
	
КонецПроцедуры

&НаКлиенте
