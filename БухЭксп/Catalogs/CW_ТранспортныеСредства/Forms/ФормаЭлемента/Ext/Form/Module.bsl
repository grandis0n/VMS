&НаКлиенте
Процедура  ОткрытьФормуСпискаПоказателя(СтрокаПоказателя)
	
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("ОбъектРасчета"					, Объект.Ссылка);
	ПараметрыОтбора.Вставить("ПоказательРасчетаРасходаТоплива"	, СтрокаПоказателя.ПоказательРасчетаРасходаТоплива);
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("Отбор" , ПараметрыОтбора);

	ОповещениеПриЗакрытии = Новый ОписаниеОповещения("ОбновитьПоказателиПослеЗакрытияФормыВыбора", ЭтотОбъект);
	
	ОткрытьФорму("РегистрСведений.CW_ЗначенияПоказателейНормРасходаТоплива.Форма.ФормаРедактированияСписка",СтруктураПараметров,ЭтаФорма,,,,ОповещениеПриЗакрытии,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

