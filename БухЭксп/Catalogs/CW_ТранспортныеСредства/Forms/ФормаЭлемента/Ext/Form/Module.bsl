&НаКлиенте 
Перем ИндексСтроки;

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ИспользуетсяБлокСобственногоТранспорта 						= ПолучитьФункциональнуюОпцию("CW_ИспользованиеБлокаСобственногоТранспорта");
	ПрименяютсяНормативыРасходаТоплива 							= ПолучитьФункциональнуюОпцию("CW_ПрименяютсяНормативыРасходаТоплива");
	ИспользуютсяПоказателиТранспортногоСредстваОтдельноОтМодели = ПолучитьФункциональнуюОпцию("CW_ИспользуютсяПоказателиТранспортногоСредстваОтдельноОтМодели");
	ИспользуетсяДополнительноеОборудование						= ПолучитьФункциональнуюОпцию("CW_ИспользуетсяДополнительноеОборудованиеТранспортныхСредств");
	
	УстанавливатьОтборПрицепаПоВладельцу = CW_Настройки.ПолучитьНастройкуПользователя(ПараметрыСеанса.ТекущийПользователь,"УстанавливатьОтборПрицепаПоВладельцу");
	
	ОсновнойТипДляТягача 			= CW_Настройки.ПолучитьНастройкуПользователя(ПараметрыСеанса.ТекущийПользователь,"ОсновнойТипТранспортногоСредстваДляТягача");
	ОсновнойТипДляПрицепа 			= CW_Настройки.ПолучитьНастройкуПользователя(ПараметрыСеанса.ТекущийПользователь,"ОсновнойТипТранспортногоСредстваДляПрицепа");
	ОсновнойТипДляДопОборудования 	= CW_Настройки.ПолучитьНастройкуПользователя(ПараметрыСеанса.ТекущийПользователь,"ОсновнойТипТранспортногоСредстваДляДополнительногоОборудования");
	
	Если ИспользуетсяДополнительноеОборудование тогда
		Элементы.ВидТС.СписокВыбора.Добавить(ПредопределенноеЗначение("Перечисление.CW_ВидыТС.ДополнительноеОборудование"));
	КонецЕсли;
	
	Если ИспользуетсяБлокСобственногоТранспорта Тогда
		Элементы.Принадлежность.СписокВыбора.Добавить(2, "Собственное");
	КонецЕсли;

	ДокументыТС_ПоказыватьНеАктуальные 	= Ложь;
	ОтображатьВсеПоказатели 			= истина;
	
	ОбработатьОтображениеКнопкиАкутальныхДокументов();
	
	_ОтборПараметров();
	
	CW_ПраваДоступа.УстановитьПраваДляФормы(ЭтаФорма);
	_УФС.ОтключитьИсториюВыбораЭлементовФормы(ЭтаФорма);
	
	_НачальноеЗаполнение();
	
	ЗаполнитьТаблицуХарактеристикМодели();
	
	_УправлениеЭлементамиФормы();
	
	_СписокВыбораОсновногоТоплива();
	
	
	Если Не Параметры.Ключ.Пустая() Тогда
		ОбновитьДанныеРегистрационногоНомера();
	КонецЕсли;
	
	Элементы.НадписьПоказатьИсторию.Видимость = Не Параметры.Ключ.Пустая();
	
	ОбработатьВидимостьЭлементовПоПринадлежностиТС();
	
	ОбновитьПодсказкуТоплива();

	РедактироватьНаименованиеПриИзмененииНаСервере();
	
	//Внешние подклчюаемые команды
	CW_ПодключаемыеКомандыСервер.ПриСозданииНаСервере(ЭтотОбъект);
		
КонецПроцедуры

&НаСервере
Процедура ОбновитьПодсказкуТоплива()
	
	МассивСтрок = Новый Массив;
	МассивСтрок.Добавить(Новый ФорматированнаяСтрока("Выбор вида топлив ограничен настройками "));
	МассивСтрок.Добавить(Новый ФорматированнаяСтрока("модели",,,,ПолучитьНавигационнуюСсылку(Объект.Модель)));
	МассивСтрок.Добавить(Новый ФорматированнаяСтрока(" транспортного средства"));
	
	Элементы.Топливо.РасширеннаяПодсказка.Заголовок = Новый ФорматированнаяСтрока(МассивСтрок);
	
КонецПроцедуры  

&НаКлиенте
Процедура РедактироватьНаименованиеПриИзменении(Элемент)
	РедактироватьНаименованиеПриИзмененииНаСервере(); 
	РегистрационныйЗнакПриИзмененииНаСервере();
КонецПроцедуры

&НаСервере
Процедура РедактироватьНаименованиеПриИзмененииНаСервере()
	Элементы.Наименование.Доступность = Объект.РедактироватьНаименование;
КонецПроцедуры



&НаСервере
Процедура ОбновитьОтображениеКнопки()
	
	Элементы.ПоказателиНормРасходаТопливаПоказатьВсеПоказатели.Пометка = Не ОтображатьВсеПоказатели;
	
КонецПроцедуры


&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	Если ИспользуетсяБлокСобственногоТранспорта тогда
		_ОтборПараметров();
	КонецЕсли;
	
	Если РегистрационныйЗнак_Изменен 
		или РегистрационныйЗнак_Произвольный_Изменен
		или РегистрационныйЗнак_Номер_Изменен 
		Или РегистрационныйЗнак_Регион_Изменен Тогда
		
		Если  РегистрационныйЗнак_Произвольный Тогда
			РегистрационныйЗнак_Номер 	= "";
			РегистрационныйЗнак_Регион 	= "";
		КонецЕсли;
		
		ТекущиеДанныеГосНомера = РегистрыСведений.CW_РегистрацонныеЗнакиАвтомобилей.ПолучитьДанныеРегистрационногоЗнака(ТекущийОбъект.Ссылка, ТекущаяДата());
		РегистрационныйЗнак_Изменился 		 		= ВРЕГ(СокрЛП(РегистрационныйЗнак))			<> СокрЛП(ТекущиеДанныеГосНомера.РегистрационныйЗнак);
		РегистрационныйЗнак_Номер_Изменился  		= ВРЕГ(СокрЛП(РегистрационныйЗнак_Номер))	<> СокрЛП(ТекущиеДанныеГосНомера.РегистрационныйЗнак_Номер);
		РегистрационныйЗнак_Регион_Изменился 		= ВРЕГ(СокрЛП(РегистрационныйЗнак_Регион))	<> СокрЛП(ТекущиеДанныеГосНомера.РегистрационныйЗнак_Регион);
		РегистрационныйЗнак_Произвольный_Изменился 	= СокрЛП(РегистрационныйЗнак_Произвольный) 	<> СокрЛП(ТекущиеДанныеГосНомера.РегистрационныйЗнак_Произвольный);
		
		Если РегистрационныйЗнак_Изменился 
			или РегистрационныйЗнак_Номер_Изменился 
			или РегистрационныйЗнак_Регион_Изменился 
			или  РегистрационныйЗнак_Произвольный_Изменился Тогда
			
			ДанныеДляЗаписиВРегистр = Новый Структура;
			ДанныеДляЗаписиВРегистр.Вставить("Период"							, ТекущаяДата());
			ДанныеДляЗаписиВРегистр.Вставить("ТранспортноеСредство"				, ТекущийОбъект.Ссылка);
			
			ДанныеДляЗаписиВРегистр.Вставить("РегистрационныйЗнак"							, РегистрационныйЗнак);
			ДанныеДляЗаписиВРегистр.Вставить("РегистрационныйЗнак_Номер"					, РегистрационныйЗнак_Номер);
			ДанныеДляЗаписиВРегистр.Вставить("РегистрационныйЗнак_Регион"					, РегистрационныйЗнак_Регион);
			ДанныеДляЗаписиВРегистр.Вставить("РегистрационныйЗнак_Произвольный"				, РегистрационныйЗнак_Произвольный);
			
			РегистрыСведений.CW_РегистрацонныеЗнакиАвтомобилей.ЗаписатьДанныеРегистрационныхЗнаковВРегистр(ДанныеДляЗаписиВРегистр);
			
			ОбновитьДанныеРегистрационногоНомера();
			
		КонецЕсли;
		
	КонецЕсли;
	
	_УправлениеЭлементамиФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	Если Не РегистрационныйЗнак_Произвольный Тогда
		РегистрационныйЗнак	= ВРЕГ(СокрЛП(РегистрационныйЗнак_Номер)+СокрЛП(РегистрационныйЗнак_Регион));
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	Если РегистрационныйЗнак_Изменен 
		Или РегистрационныйЗнак_Произвольный_Изменен
		Или РегистрационныйЗнак_Номер_Изменен 
		Или РегистрационныйЗнак_Регион_Изменен Тогда
		
		Оповестить("ОбновитьРегистрационныеНомера");
		
		РегистрационныйЗнак_Изменен 				= Ложь;
		РегистрационныйЗнак_Номер_Изменен 			= Ложь;
		РегистрационныйЗнак_Регион_Изменен 			= Ложь;
		РегистрационныйЗнак_Произвольный_Изменен 	= Ложь;
	
	КонецЕсли;
		
КонецПроцедуры

// ---------------------------------------------------------------------------- 

&НаСервере
Процедура _ЗаполнитьСписокВодителей()
	
	Запрос = новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	CW_РолиСотрудниковОрганизацийСрезПоследних.Сотрудник КАК Сотрудник,
	               |	CW_РолиСотрудниковОрганизацийСрезПоследних.РольСотрудника КАК РольСотрудника
	               |ИЗ
	               |	РегистрСведений.CW_РолиСотрудниковОрганизаций.СрезПоследних КАК CW_РолиСотрудниковОрганизацийСрезПоследних
	               |ГДЕ
	               |	CW_РолиСотрудниковОрганизацийСрезПоследних.РольСотрудника = &РольСотрудника";
	
	РольСотрудника = ПредопределенноеЗначение("Справочник.CW_РолиСотрудников.Водитель");
	Запрос.УстановитьПараметр("РольСотрудника", РольСотрудника);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	мВодители = РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("Сотрудник");
	
	Элементы.Водитель.СписокВыбора.ЗагрузитьЗначения(мВодители);
	
КонецПроцедуры

// ---------------------------------------------------------------------------- 

&НаСервере
Процедура ЗаполнитьПоказателиНормРасходаТопливаНаСервере()
	
	Если Не ПрименяютсяНормативыРасходаТоплива Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	CW_ПоказателиРасчетаРасходаТоплива.Ссылка КАК Показатель,
		|	CW_ПоказателиРасчетаРасходаТоплива.БуквенныйКод КАК БуквенныйКод,
		|	CW_ПоказателиРасчетаРасходаТоплива.Описание КАК Описание
		|ПОМЕСТИТЬ ВТ_ДоступныеПоказатели
		|ИЗ
		|	Справочник.CW_ПоказателиРасчетаРасходаТоплива КАК CW_ПоказателиРасчетаРасходаТоплива
		|ГДЕ
		|	ВЫБОР
		|			КОГДА НЕ &УчитыватьПогрешностьИзмеренияОстаткаТоплива
		|				ТОГДА CW_ПоказателиРасчетаРасходаТоплива.Ссылка <> ЗНАЧЕНИЕ(Справочник.CW_ПоказателиРасчетаРасходаТоплива.ПогрешностьИзмеренияОстаткаТоплива)
		|			ИНАЧЕ ИСТИНА
		|		КОНЕЦ
		|	И CW_ПоказателиРасчетаРасходаТоплива.УказываетсяВНастройках
		|	И НЕ CW_ПоказателиРасчетаРасходаТоплива.ПометкаУдаления
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Показатель
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	CW_ЗначенияПоказателейНормРасходаТопливаСрезПоследних.Период КАК Период,
		|	CW_ЗначенияПоказателейНормРасходаТопливаСрезПоследних.ПоказательРасчетаРасходаТоплива КАК ПоказательРасчетаРасходаТоплива,
		|	CW_ЗначенияПоказателейНормРасходаТопливаСрезПоследних.ЗначениеПоказателя КАК ЗначениеПоказателя
		|ПОМЕСТИТЬ ВТ_СрезЗначений
		|ИЗ
		|	РегистрСведений.CW_ЗначенияПоказателейНормРасходаТоплива.СрезПоследних(
		|			&ДатаСреза,
		|			ПоказательРасчетаРасходаТоплива В
		|					(ВЫБРАТЬ
		|						ВТ_ДоступныеПоказатели.Показатель КАК Показатель
		|					ИЗ
		|						ВТ_ДоступныеПоказатели КАК ВТ_ДоступныеПоказатели)
		|				И ОбъектРасчета = &ОбъектРасчета) КАК CW_ЗначенияПоказателейНормРасходаТопливаСрезПоследних
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	ПоказательРасчетаРасходаТоплива
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЕСТЬNULL(ВТ_СрезЗначений.Период, НЕОПРЕДЕЛЕНО) КАК Период,
		|	ВТ_ДоступныеПоказатели.Показатель КАК ПоказательРасчетаРасходаТоплива,
		|	ВТ_ДоступныеПоказатели.БуквенныйКод КАК БуквенныйКод,
		|	ВТ_ДоступныеПоказатели.Описание КАК Описание,
		|	ЕСТЬNULL(ВТ_СрезЗначений.ЗначениеПоказателя, 0) КАК ЗначениеПоказателя,
		|	ВЫБОР
		|		КОГДА ЕСТЬNULL(ВТ_СрезЗначений.ЗначениеПоказателя, 0) = 0
		|			ТОГДА ЛОЖЬ
		|		ИНАЧЕ ИСТИНА
		|	КОНЕЦ КАК Отображать
		|ИЗ
		|	ВТ_ДоступныеПоказатели КАК ВТ_ДоступныеПоказатели
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_СрезЗначений КАК ВТ_СрезЗначений
		|		ПО ВТ_ДоступныеПоказатели.Показатель = ВТ_СрезЗначений.ПоказательРасчетаРасходаТоплива";
	
	Запрос.УстановитьПараметр("ДатаСреза"									, ТекущаяДата());
	Запрос.УстановитьПараметр("ОбъектРасчета"								, Объект.Ссылка);
	Запрос.УстановитьПараметр("ВидтранспортногоСредства"					, Объект.ВидТС);
	Запрос.УстановитьПараметр("УчитыватьПогрешностьИзмеренияОстаткаТоплива"	, ПолучитьФункциональнуюОпцию("CW_УчитыватьПогрешностьИзмеренияОстаткаТоплива"));
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ПоказателиНормРасходаТоплива.Загрузить(РезультатЗапроса.Выгрузить());
	
КонецПроцедуры


&НаСервере
Процедура ПолучитьДействующуюФрмулуНормРасходаТранспортногоСредства()
	
	ПараметрыФормулы = CW_УчетСобственногоТранспортаСервер.ПолучитьДействующуюФормулуНормрасходатранспортныхСредств(ТекущаяДата(), Объект.Ссылка);
	
	Если ПараметрыФормулы = Неопределено Тогда
		ФормулаРасчетаНормыРасходаТоплива = Объект.Модель.ФормулаРасчетаНормыРасходаТоплива;
		ПрименяетсяФормулаМодели = Истина;
	Иначе
		ФормулаРасчетаНормыРасходаТоплива   = ПараметрыФормулы.ФормулаРасчетаНормыРасходаТоплива;
		ДействуетДо 						= ПараметрыФормулы.ДействуетДо;
		ПрименяетсяФормулаМодели = Ложь;
	КонецЕсли;
	
КонецПроцедуры


&НаСервере
Процедура _НачальноеЗаполнение()
	// --- 
	
	Если (Объект.Ссылка.Пустая()) Тогда
		
		Объект.ГодВыпуска = Год(ТекущаяДата());
		
		УстановитьТипТарнспортногоСредстваИзНастроекПользоватлея();
			
		ПриИзмененииТипаТранспортногоСредстваНаСервере();
	
	Иначе
		
		Если ИспользуетсяБлокСобственногоТранспорта тогда

			ЕстьПутевыеЛистыПоТранспортномуСредству = ПроверитьНаличиеПутевыхЛистов();
			
			ЗаполнитьТекущиеСостояние();
			
			_ЗаполнитьСписокВодителей();
			
			_ОтборПараметров();
			
			Если ПрименяютсяНормативыРасходаТоплива Тогда
				
				ПолучитьДействующуюФрмулуНормРасходаТранспортногоСредства();
			
				ЗаполнитьПоказателиНормРасходаТопливаНаСервере();
				
				УстановитьСнятьОтборПоказателей();
				
				ОбновитьОтображениеКнопки();
				
			КонецЕсли;
			
			
			
		КонецЕсли;
		
	КонецЕсли; 
	
КонецПроцедуры

&НаСервере
Процедура УстановитьТипТарнспортногоСредстваИзНастроекПользоватлея()
	
	ТипТранспортногоСредства = Неопределено;
	Если Объект.ВидТС = Перечисления.CW_ВидыТС.Автомобиль Тогда
		ТипТранспортногоСредства = ОсновнойТипДляТягача;
	ИначеЕсли  Объект.ВидТС = Перечисления.CW_ВидыТС.Прицеп Тогда
		ТипТранспортногоСредства = ОсновнойТипДляПрицепа;
	ИначеЕсли  Объект.ВидТС = Перечисления.CW_ВидыТС.ДополнительноеОборудование Тогда
		ТипТранспортногоСредства = ОсновнойТипДляДопОборудования;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТипТранспортногоСредства) Тогда
		Если Объект.ТипТранспортногоСредства.ВидТС <> Объект.ВидТС  Тогда
			Объект.ТипТранспортногоСредства = Неопределено;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Объект.ТипТранспортногоСредства) Тогда
			Объект.ТипТранспортногоСредства = ТипТранспортногоСредства;
		Конецесли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТекущиеСостояние()
	
	//ТекущийСтатус
	Запрос = Новый запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	CW_СостоянияТССрезПоследних.ТранспортноеСредство КАК ТранспортноеСредство,
	|	CW_СостоянияТССрезПоследних.Состояние КАК Состояние
	|ИЗ
	|	РегистрСведений.CW_СостоянияТС.СрезПоследних(, ТранспортноеСредство = &ТранспортноеСредство) КАК CW_СостоянияТССрезПоследних";
	
	Запрос.УстановитьПараметр("ТранспортноеСредство"	, Объект.Ссылка);
	
	Выборка = запрос.Выполнить().Выбрать();
	
	ТекущийСтатус = Справочники.CW_СостоянияТС.ПустаяСсылка();
	Если Выборка.Следующий() тогда
		ТекущийСтатус =  Выборка.Состояние;
	КонецЕсли;

	//ТекущийПробег
	//ТекущийПробегСГрузом
	Запрос = Новый запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	CW_ПробегТСОбороты.ТранспортноеСредство КАК ТранспортноеСредство,
	               |	СУММА(CW_ПробегТСОбороты.ПробегОборот) КАК Пробег,
	               |	СУММА(CW_ПробегТСОбороты.ПробегСГрузомОборот) КАК ПробегСГрузом
	               |ИЗ
	               |	РегистрНакопления.CW_ПробегТС.Обороты(, , , ТранспортноеСредство = &ТранспортноеСредство) КАК CW_ПробегТСОбороты
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	CW_ПробегТСОбороты.ТранспортноеСредство";
	
	Запрос.УстановитьПараметр("ТранспортноеСредство"	, Объект.Ссылка);
	
	Выборка = запрос.Выполнить().Выбрать();
	                                                           
	ТекущийПробег 			= 0;
	ТекущийПробегСГрузом 	= 0;
	Если Выборка.Следующий() тогда
		ТекущийПробег 			=  Выборка.Пробег;
		ТекущийПробегСГрузом 	=  Выборка.ПробегСГрузом;
	КонецЕсли;
	
	//	ТекущийОстатокТоплива
	Запрос = Новый запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	CW_ТопливоТСОстатки.ТранспортноеСредство КАК ТранспортноеСредство,
	               |	CW_ТопливоТСОстатки.КоличествоОстаток КАК Количество
	               |ИЗ
	               |	РегистрНакопления.CW_ТопливоТС.Остатки(, ТранспортноеСредство = &ТранспортноеСредство) КАК CW_ТопливоТСОстатки
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	CW_ТопливоТСОстатки.ТранспортноеСредство,
	               |	CW_ТопливоТСОстатки.КоличествоОстаток";
	
	Запрос.УстановитьПараметр("ТранспортноеСредство"	, Объект.Ссылка);
	
	Выборка = запрос.Выполнить().Выбрать();
	                                                           
	ТекущийОстатокТоплива = 0;
	Если Выборка.Следующий() тогда
		ТекущийОстатокТоплива 	=  Выборка.Количество;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПроверитьНаличиеПутевыхЛистов()
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	|	CW_ПутевойЛист.Ссылка
	|ИЗ
	|	Документ.CW_ПутевойЛист КАК CW_ПутевойЛист
	|ГДЕ
	|	CW_ПутевойЛист.ТранспортноеСредство = &ТранспортноеСредство
	|	И CW_ПутевойЛист.Проведен = ИСТИНА";
	Запрос.УстановитьПараметр("ТранспортноеСредство", Объект.Ссылка);
	
	Результат = Запрос.Выполнить(); 
	
	Возврат Не Результат.Пустой();
	
КонецФункции
 
&НаСервере
Процедура _СписокВыбораОсновногоТоплива()
	// --- 
	
	Если (ЗначениеЗаполнено(Объект.Модель)) Тогда
		
		мВидыТопливаМодели = ПолучитьВидыТопливаМоделиТС();
		
		Элементы.Топливо.СписокВыбора.ЗагрузитьЗначения(мВидыТопливаМодели);

	КонецЕсли; 
	
	// --- 
КонецПроцедуры
 
&НаСервере
Процедура _УправлениеЭлементамиФормы()
	
	ВидТСТягач 						= ПредопределенноеЗначение("Перечисление.CW_ВидыТС.Автомобиль");
	ВидТСДополнительноеОборудование = ПредопределенноеЗначение("Перечисление.CW_ВидыТС.ДополнительноеОборудование");
	ВидТСПустаяСсылка 				= ПредопределенноеЗначение("Перечисление.CW_ВидыТС.ПустаяСсылка");

	//Элементы.ВидТС.ТолькоПросмотр 			= ЕстьПутевыеЛистыПоТранспортномуСредству;
	//Элементы.Модель.ТолькоПросмотр 			= ЕстьПутевыеЛистыПоТранспортномуСредству;
	Элементы.НомерКПП.Видимость 			= Объект.ВидТС 	= ВидТСТягач;
	Элементы.СтраницаПоУмолчанию.Видимость 	= Объект.ВидТС 	= ВидТСТягач;
	Элементы.СтраницаНормыРасхода.Видимость = Объект.ВидТС  = ВидТСТягач и ПрименяютсяНормативыРасходаТоплива;
	
	Элементы.СтраницаПутевыеЛисты.Видимость = НЕ (Объект.ВидТС = ВидТСПустаяСсылка или Объект.ВидТС = ВидТСДополнительноеОборудование);
	Элементы.ГруппаРегНомер.Видимость 		= НЕ (Объект.ВидТС = ВидТСПустаяСсылка или Объект.ВидТС = ВидТСДополнительноеОборудование);
	
	Элементы.ГруппаПоказатели.Видимость 	= ПоказателиНормРасходаТоплива.Количество() > 0 
	и ИспользуютсяПоказателиТранспортногоСредстваОтдельноОтМодели
	и Не Объект.Модель.ТопливныйБакОтсутствует; 
	
	Элементы.ГруппаФормула.Видимость 			= ПрименяютсяНормативыРасходаТоплива;
	Элементы.ДатаОкончания.Видимость 			= Не ПрименяетсяФормулаМодели и ПрименяютсяНормативыРасходаТоплива;
	
	Элементы.ГруппаПараметрыТС.Видимость 	= Объект.Принадлежность = 2;
	Элементы.Контрагент.Видимость 			= Объект.Принадлежность < 2;
	
	//Элементы.Группа6.Доступность 			= НЕ Объект.Принадлежность = 2;
	
	ПроизвольныйРегистрационныйЗнакПриИзмененииНаСервере();
	ИзменитьПодсказкуВводаРегистрационногоЗнака();
	
КонецПроцедуры
 
&НаСервере
Процедура _ОтборПараметров()

	Если Объект.ВидТС = ПредопределенноеЗначение("Перечисление.CW_ВидыТС.Автомобиль") Тогда
		ВидТранспортногоСредства = 0;
	ИначЕесли  Объект.ВидТС = ПредопределенноеЗначение("Перечисление.CW_ВидыТС.Прицеп") Тогда
		ВидТранспортногоСредства = 1;
	Иначе
		ВидТранспортногоСредства = -1;
	КонецЕсли;
	
	ПараметрыТС.КомпоновщикНастроек.Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("ТранспортноеСредство"				, Объект.Ссылка);
	//Временно, до удаления соответствующего параметра ТС
	ПараметрыТС.КомпоновщикНастроек.Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("ПараметрТранпортногоСредстваРегЗнак"	, ПланыВидовХарактеристик.CW_ПараметрыТранспортныхСредств.РегистрационныйЗнак);
	
	
	
	ДокументыТС.КомпоновщикНастроек.Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("ТранспортноеСредство"	, Объект.Ссылка);
	ДокументыТС.КомпоновщикНастроек.Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("НеДействует"				,?(ДокументыТС_ПоказыватьНеАктуальные,Неопределено,Ложь));
	
	ПутевыеЛистыТС.КомпоновщикНастроек.Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("ВидТранспортногоСредства"	, ВидТранспортногоСредства);
	ПутевыеЛистыТС.КомпоновщикНастроек.Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("ЗначениеОтбора"			, Объект.Ссылка);
	
	ОборудованиеТС.КомпоновщикНастроек.Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("ТранспортноеСредство"	, Объект.Ссылка);
	
КонецПроцедуры

