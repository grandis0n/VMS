&НаКлиенте
Процедура ВодительНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	
	Если Объект.Принадлежность  = 2 Тогда
		//Отбор из по роли сотрудник атолько для совбственных 
		
		СтандартнаяОбработка = Ложь;
		
		СтруктураПараметровФормы 	= Новый Структура;
		СтруктураПараметровФормы.Вставить("РольСотрудника"				, ПредопределенноеЗначение("Справочник.CW_РолиСотрудников.Водитель"));
		СтруктураПараметровФормы.Вставить("Организация"					, Неопределено);
		СтруктураПараметровФормы.Вставить("ОтборПоОрганизации"			, Ложь);
		СтруктураПараметровФормы.Вставить("ВозможностьСоздаватьЗаписи"	, Ложь);
		
		ДополнительныйПараметр 		= Новый Структура("Реквизит", "Водитель");
		
		ОписаниеОповещения = Новый ОписаниеОповещения("ОбработкаВыбораВодителя",ЭтотОбъект, ДополнительныйПараметр);
		
		ОткрытьФорму("ОбщаяФорма.CW_ФормаВыбораСотрудникаДляРоли",СтруктураПараметровФормы,,,,,ОписаниеОповещения,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
	Иначе
		
		СписокЗначенийВыбора = Новый СписокЗначений;
		Если ПолучитьСписокСотрудников(СписокЗначенийВыбора) Тогда
			СтандартнаяОбработка = Ложь;
			
			ОписаниеОповещения = Новый ОписаниеОповещения("ОбработкаВыбораВодителя",ЭтотОбъект);
			
			ПараметрыФормыВыбора = Новый Структура("РежимВыбора, ЗакрыватьПриВыборе", Истина, истина);
			
			Форма = ОткрытьФорму("Справочник.ФизическиеЛица.ФормаВыбора",ПараметрыФормыВыбора,,,,,ОписаниеОповещения,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
			
			ПользовательскийОтбор = Форма.Список.КомпоновщикНастроек.ПользовательскиеНастройки.Элементы.Найти(Форма.Список.КомпоновщикНастроек.Настройки.Отбор.ИдентификаторПользовательскойНастройки); //Если вам известен идентификатор, указываете здесь. Но можно не заполнять
			ПользовательскийОтбор.Элементы.Очистить();  			
			
			ОтборВладелец = ПользовательскийОтбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
			ОтборВладелец.Использование = Истина;
			ОтборВладелец.ИдентификаторПользовательскойНастройки = "КонтактныеЛица";  
			ОтборВладелец.ЛевоеЗначение 	= Новый ПолеКомпоновкиДанных("Ссылка");
			ОтборВладелец.ВидСравнения 		= ВидСравненияКомпоновкиДанных.ВСписке;
			ОтборВладелец.ПравоеЗначение	= СписокЗначенийВыбора;
			
		Конецесли;
		
	КонецЕсли;
	
		
КонецПроцедуры

&НаСервере
Функция ПолучитьСписокСотрудников(ДанныеВыбора)
	
	Если ЗначениеЗаполнено(Объект.Контрагент) Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	CW_КонтактыеЛица.ФизическоеЛицо КАК ФизическоеЛицо
		               |ИЗ
		               |	Справочник.CW_КонтактыеЛица КАК CW_КонтактыеЛица
		               |ГДЕ
		               |	CW_КонтактыеЛица.Владелец = &Владелец
		               |	И НЕ CW_КонтактыеЛица.Неактивный
		               |	И НЕ CW_КонтактыеЛица.ПометкаУдаления";
		
		Запрос.УстановитьПараметр("Владелец", Объект.Контрагент);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		Если РезультатЗапроса.Пустой() Тогда
			Возврат Ложь;
		КонецЕсли;
		
		Выборка = РезультатЗапроса.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			ДанныеВыбора.Добавить(Выборка.ФизическоеЛицо);
		КонецЦикла;
		
		Возврат ДанныеВыбора.Количество() > 0;
		
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

