&НаСервере
Процедура _УправлениеЭлементамиФормы()
	// --- 
	
	Заголовок = Строка(Объект.Владелец);
	
	Если (ТипЗнч(Объект.Владелец) = Тип("СправочникСсылка.Контрагенты")) Тогда
		
		Элементы.ВариантКИ.Видимость = Ложь;
		
	Иначе
		
		Элементы.ВариантКИ.Видимость = Истина;
		Если (ТипЗнч(Объект.Владелец) = Тип("СправочникСсылка.CW_КонтактыеЛица")) Тогда
			
			ВариантКИ = 0;
			Если (НЕ Объект.Владелец.ФизическоеЛицо.Пустая()) Тогда
				
				Элементы.ВариантКИ.ТолькоПросмотр = Ложь;
				
			Иначе
				
				Элементы.ВариантКИ.ТолькоПросмотр = Истина;
				
			КонецЕсли; 
			
		Иначе
			
			Элементы.ВариантКИ.ТолькоПросмотр = Ложь;
			ВариантКИ = 1;
			
		КонецЕсли; 
		
	КонецЕсли;
	
	// --- 
КонецПроцедуры
 

// --- 

&НаКлиенте
Процедура ЛичнаяКИПриИзменении(Элемент)
	
	_ЛичнаяКИПриИзменении();
	
КонецПроцедуры

&НаСервере
Процедура _ЛичнаяКИПриИзменении()
	// --- 
	
	Объект.Владелец = Объект.Владелец.ФизическоеЛицо;
	_УправлениеЭлементамиФормы();
	
	// --- 
КонецПроцедуры

&НаКлиенте
Процедура ВариантКИПриИзменении(Элемент)
	
	Если (ВариантКИ = 1) Тогда
		
		Объект.ЛичнаяКИ = Истина;
		_ЛичнаяКИПриИзменении();
		
	Иначе
		
		// спрашиваем контактное лицо
		ПОВ = Новый ОписаниеОповещения("ОбработкаВыбораКонтактногоЛица",ЭтотОбъект, Новый Структура()); 
		ПФ = Новый Структура("Физлицо",Объект.Владелец);
		ОткрытьФорму("Справочник.CW_КонтактыеЛица.Форма.ФормаВыбораКонтактногоЛицаПоФизлицу",ПФ,,,,,ПОВ,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбораКонтактногоЛица(Ответ, ДополнительныеПараметры) Экспорт 
	// --- 
	
	Если (Ответ <> Неопределено) Тогда
		
		Объект.ЛичнаяКИ = Ложь;
		ВариантКИ = 0;
		Объект.Владелец = Ответ;
		
	КонецЕсли; 
	
	// --- 
КонецПроцедуры
  

&НаКлиенте
Процедура ОткрытьКИ(Команда)
	
	// открываем КИ
	_УФК.ОткрытьКонтактнуюИнформацию(Объект.Ссылка);
	
КонецПроцедуры


