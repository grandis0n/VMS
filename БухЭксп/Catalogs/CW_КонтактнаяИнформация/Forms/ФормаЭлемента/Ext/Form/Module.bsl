
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если (Объект.Ссылка.Пустая()) Тогда
		Объект.Владелец = Параметры.ЗначенияЗаполнения.Владелец;
	КонецЕсли; 
	// --- 
	_УФС.ОтключитьИсториюВыбораЭлементовФормы(ЭтаФорма);
	
	_УправлениеЭлементамиФормы();
	//Внешние подклчюаемые команды
	CW_ПодключаемыеКомандыСервер.ПриСозданииНаСервере(ЭтотОбъект);

КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	CW_КонтактнаяИнформация.Ссылка
	               |ИЗ
	               |	Справочник.CW_КонтактнаяИнформация КАК CW_КонтактнаяИнформация
	               |ГДЕ
	               |	CW_КонтактнаяИнформация.Основной = ИСТИНА
	               |	И CW_КонтактнаяИнформация.Владелец = &Владелец
	               |	И CW_КонтактнаяИнформация.ВидКИ = &ВидКИ
	               |	И CW_КонтактнаяИнформация.Ссылка <> &Ссылка
	               |	И CW_КонтактнаяИнформация.ПометкаУдаления = ЛОЖЬ";
	Запрос.УстановитьПараметр("Владелец", Объект.Владелец);
	Запрос.УстановитьПараметр("ВидКИ", Объект.ВидКИ);
	Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка); 
	ТЗ = Запрос.Выполнить().Выгрузить();
	
	Если (Объект.Основной) Тогда
		
		Если (ТЗ.Количество() <> 0) Тогда
			
			Для каждого Стр Из ТЗ Цикл
				
				СтрО = Стр.Ссылка.ПолучитьОбъект();
				СтрО.Основной = ЛОжь;
				СтрО.Записать();
				
			КонецЦикла; 
			
		КонецЕсли; 		
		
	Иначе
		
		Если (ТЗ.Количество() = 0) Тогда
			
			ТекущийОбъект.Основной = Истина;
			
		КонецЕсли; 
		
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	ОповеститьОЗаписиНового(Объект.Ссылка);
	
КонецПроцедуры

