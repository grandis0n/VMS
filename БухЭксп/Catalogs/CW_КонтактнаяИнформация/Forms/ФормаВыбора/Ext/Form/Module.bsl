
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Элементы.КонтактнаяИнформация.РежимВыбора = Истина;
	
	Попытка
		
		Параметры.Отбор.Свойство("Владелец",ТекущийОбъектОтбора);
		
	Исключение
	    Отказ = Истина;
	КонецПопытки; 
	
	Заголовок = "Контактная информация ("+Строка(ТекущийОбъектОтбора)+")";
	
	_ОтборКонтактнойИнформации(ТекущийОбъектОтбора);
	//Внешние подклчюаемые команды
	CW_ПодключаемыеКомандыСервер.ПриСозданииНаСервере(ЭтотОбъект);

КонецПроцедуры

