&НаСервере
Процедура _ОтборКонтактнойИнформации(ОбъектОтбора)
	// --- 
	
	ТекущийОбъектОтбора = ОбъектОтбора;
	_ОбновитьКонтактнуюИнформацию();
	
	// --- 
КонецПроцедуры

&НаКлиенте
Процедура КонтактнаяИнформацияПриАктивизацииСтроки(Элемент)
	
	Если (Элементы.КонтактнаяИнформация.ТекущиеДанные <> Неопределено) Тогда
		ТекущаяКонтактнаяИнформация = Элементы.КонтактнаяИнформация.ТекущиеДанные.Ссылка;
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьКонтактнуюИнформацию()
	// --- 
	
	_ОбновитьКонтактнуюИнформацию();
	
	// --- 
КонецПроцедуры

&НаСервере
Процедура _ОбновитьКонтактнуюИнформацию()
	// --- 
	
	Если (ТекущийОбъектОтбора = Неопределено) Тогда
		Возврат;
	КонецЕсли; 
	
	// --- 
	Если (ТипЗнч(ТекущийОбъектОтбора) = Тип("СправочникСсылка.Контрагенты")) Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	CW_КонтактнаяИнформация.Ссылка,
		               |	CW_КонтактнаяИнформация.Наименование КАК ЗначениеКИ,
		               |	CW_КонтактнаяИнформация.ЛичнаяКИ,
		               |	CW_КонтактнаяИнформация.ВидКИ,
		               |	CW_КонтактнаяИнформация.ВидКИ.ТипКИ.СсылкаКартинки КАК АдресКартинки,
		               |	CW_КонтактнаяИнформация.Основной КАК ОсновнойВидКИ
		               |ИЗ
		               |	Справочник.CW_КонтактнаяИнформация КАК CW_КонтактнаяИнформация
		               |ГДЕ
		               |	CW_КонтактнаяИнформация.Владелец = &Владелец
		               |	И CW_КонтактнаяИнформация.ПометкаУдаления = ЛОЖЬ
		               |
		               |УПОРЯДОЧИТЬ ПО
		               |	CW_КонтактнаяИнформация.ВидКИ.Код
		               |АВТОУПОРЯДОЧИВАНИЕ";
		Запрос.УстановитьПараметр("Владелец", ТекущийОбъектОтбора);
		ТЗ = Запрос.Выполнить().Выгрузить(); 
		
	ИначеЕсли (ТипЗнч(ТекущийОбъектОтбора) = Тип("СправочникСсылка.ФизическиеЛица")) Тогда 
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	CW_КонтактнаяИнформация.Ссылка,
		               |	CW_КонтактнаяИнформация.Наименование КАК ЗначениеКИ,
		               |	CW_КонтактнаяИнформация.ЛичнаяКИ,
		               |	CW_КонтактнаяИнформация.ВидКИ,
		               |	CW_КонтактнаяИнформация.ВидКИ.ТипКИ.СсылкаКартинки КАК АдресКартинки,
		               |	CW_КонтактнаяИнформация.Основной КАК ОсновнойВидКИ
		               |ИЗ
		               |	Справочник.CW_КонтактнаяИнформация КАК CW_КонтактнаяИнформация
		               |ГДЕ
		               |	CW_КонтактнаяИнформация.Владелец = &Владелец
		               |	И CW_КонтактнаяИнформация.ПометкаУдаления = ЛОЖЬ
		               |
		               |УПОРЯДОЧИТЬ ПО
		               |	CW_КонтактнаяИнформация.ВидКИ.Код
		               |АВТОУПОРЯДОЧИВАНИЕ";
		Запрос.УстановитьПараметр("Владелец", ТекущийОбъектОтбора);
		ТЗ = Запрос.Выполнить().Выгрузить(); 
 		
	ИначеЕсли (ТипЗнч(ТекущийОбъектОтбора) = Тип("СправочникСсылка.CW_КонтактыеЛица")) Тогда 
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	CW_КонтактнаяИнформация.Ссылка,
		               |	CW_КонтактнаяИнформация.Наименование КАК ЗначениеКИ,
		               |	CW_КонтактнаяИнформация.ЛичнаяКИ,
		               |	CW_КонтактнаяИнформация.ВидКИ,
		               |	CW_КонтактнаяИнформация.ВидКИ.ТипКИ.СсылкаКартинки КАК АдресКартинки,
		               |	CW_КонтактнаяИнформация.Основной КАК ОсновнойВидКИ
		               |ИЗ
		               |	Справочник.CW_КонтактнаяИнформация КАК CW_КонтактнаяИнформация
		               |ГДЕ
		               |	(CW_КонтактнаяИнформация.Владелец = &Владелец
		               |			ИЛИ CW_КонтактнаяИнформация.Владелец = &ФизическоеЛицо)
		               |	И CW_КонтактнаяИнформация.ПометкаУдаления = ЛОЖЬ
		               |
		               |УПОРЯДОЧИТЬ ПО
		               |	CW_КонтактнаяИнформация.ВидКИ.Код
		               |АВТОУПОРЯДОЧИВАНИЕ";
		Запрос.УстановитьПараметр("Владелец", ТекущийОбъектОтбора);
		Запрос.УстановитьПараметр("ФизическоеЛицо", ТекущийОбъектОтбора.ФизическоеЛицо); 
		ТЗ = Запрос.Выполнить().Выгрузить(); 
		
	КонецЕсли; 
	// --- 
	КартинкаЗвезда = БиблиотекаКартинок.CW_ПользовательМаленький;
	АдресКартинки = ПоместитьВоВременноеХранилище(КартинкаЗвезда.ПолучитьДвоичныеДанные(),УникальныйИдентификатор);
	// --- 
	КонтактнаяИнформация.Загрузить(ТЗ);
	// --- 
	Для каждого Стр Из КонтактнаяИнформация Цикл
		Если (Стр.ЛичнаяКИ) Тогда
			Стр.ПризнакЛичнойКИ = АдресКартинки;
		КонецЕсли; 
	КонецЦикла; 
	// --- 
	Если (ЗначениеЗаполнено(ТекущаяКонтактнаяИнформация)) Тогда
		ТекущаяСтрока = _сф.к_НайтиСтроку(КонтактнаяИнформация,Новый Структура("Ссылка",ТекущаяКонтактнаяИнформация));
		Если (ТекущаяСтрока <> Неопределено) Тогда
			Элементы.КонтактнаяИнформация.ТекущаяСтрока = ТекущаяСтрока.ПолучитьИдентификатор();
		КонецЕсли; 
	КонецЕсли; 
	
	// --- 
КонецПроцедуры

&НаКлиенте
Процедура КонтактнаяИнформацияПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	Отказ = Истина;
	// --- 
	ПФ = Новый Структура("ЗначенияЗаполнения",Новый Структура("Владелец",ТекущийОбъектОтбора));
	Если (Копирование) Тогда
		ПФ.Вставить("ЗначениеКопирования", Элементы.КонтактнаяИнформация.ТекущиеДанные.Ссылка);
	КонецЕсли; 
	ОткрытьФорму("Справочник.CW_КонтактнаяИнформация.ФормаОбъекта", ПФ, Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура КонтактнаяИнформацияВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	// --- 
	ВыполнитьВыборКИ(Элементы.КонтактнаяИнформация.ТекущаяСтрока)
	
КонецПроцедуры

&НаКлиенте
Процедура КонтактнаяИнформацияПередНачаломИзменения(Элемент, Отказ)
	
	Отказ = Истина;
	// --- 
	
	//ВыполнитьВыборКИ(Элементы.КонтактнаяИнформация.ТекущаяСтрока);
	
	Если (Элементы.КонтактнаяИнформация.ТекущиеДанные <> Неопределено) Тогда
		
		Если (Элемент.ТекущийЭлемент.Имя = "КонтактнаяИнформацияАдресКартинки") Тогда
			
			// переходим к КИ
			_УФК.ОткрытьКонтактнуюИнформацию(Элементы.КонтактнаяИнформация.ТекущиеДанные.Ссылка);
			
		Иначе
			
			ПФ = Новый Структура("Ключ",Элементы.КонтактнаяИнформация.ТекущиеДанные.Ссылка);
			ОткрытьФорму("Справочник.CW_КонтактнаяИнформация.ФормаОбъекта",ПФ,Элемент);
			
		КонецЕсли; 
		
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура КонтактнаяИнформацияОбработкаЗаписиНового(НовыйОбъект, Источник, СтандартнаяОбработка)
	
	ТекущаяКонтактнаяИнформация = НовыйОбъект;
	_ОбновитьКонтактнуюИнформацию();
	
КонецПроцедуры

&НаКлиенте
Процедура КонтактнаяИнформацияПередУдалением(Элемент, Отказ)
	
	Отказ = Истина;
	// --- 
	ПОВ = Новый ОписаниеОповещения("ОбработкаВопросаУдаленияКИ",ЭтотОбъект, Новый Структура());
	ПоказатьВопрос(ПОВ,"Удалить контактную информацию?",РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВопросаУдаленияКИ(Ответ, ДополнительныеПараметры) Экспорт 
	// --- 
	
	Если (Ответ <> Неопределено) Тогда
		
		Если (Ответ=КодВозвратаДиалога.Да) Тогда
			
			Результат = _ВыполнитьУдалениеКИ(Элементы.КонтактнаяИнформация.ТекущиеДанные.Ссылка);
			Если (_УФКС.ВыполненоУспешно(Результат)) Тогда
				Стр = КонтактнаяИнформация.НайтиПоИдентификатору(Элементы.КонтактнаяИнформация.ТекущаяСтрока);
				КонтактнаяИнформация.Удалить(Стр);
			КонецЕсли; 
			
		КонецЕсли; 
		
	КонецЕсли; 
	
	// --- 
КонецПроцедуры
  

&НаСервере
Функция _ВыполнитьУдалениеКИ(СсылкаКИ)
	// --- 
	
	Попытка
		КИ = СсылкаКИ.ПолучитьОбъект();
		КИ.УстановитьПометкуУдаления(Истина);	
	Исключение
	    Возврат(_УФКС.Ответ(1,ОписаниеОшибки()));
	КонецПопытки; 
	
	Возврат(_УФКС.Ответ());
	
	// --- 
КонецФункции

