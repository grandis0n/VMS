&НаСервере
Процедура _СформироватьПредставление()
	// --- 
	
	Объект.Наименование = СокрЛП(Объект.ИмяОтправителя)+" <"+СокрЛП(Объект.ПочтовыйАдрес)+">";	
	
	// --- 
КонецПроцедуры


