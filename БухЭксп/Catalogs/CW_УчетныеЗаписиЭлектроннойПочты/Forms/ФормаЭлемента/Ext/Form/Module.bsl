	 _АутентификацияSMTPПриИзменении();
	
КонецПроцедуры

&НаСервере
Процедура _АутентификацияSMTPПриИзменении()
	// --- 
	
	Элементы.ПользовательSMTP.Видимость = Объект.АутентификацияSMTP;
	Элементы.ПарольSMTP.Видимость = Объект.АутентификацияSMTP;

	
	Если НЕ Объект.АутентификацияSMTP Тогда
		
		Объект.ПользовательSMTP = "";
		Объект.ПарольSMTP = "";
				
	КонецЕсли;
	
	// --- 
КонецПроцедуры

