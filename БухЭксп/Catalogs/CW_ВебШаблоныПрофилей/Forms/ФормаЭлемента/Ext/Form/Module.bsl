&НаСервере
Функция ПолучитьМониторинговыйПараметр(СтрокаПоляКомпоновки) 
	
	позНачала = СтрНайти(СтрокаПоляКомпоновки,"[");
	позКонеца = СтрНайти(СтрокаПоляКомпоновки,"]"); 
	
	Идентификатор = Сред(СтрокаПоляКомпоновки, позНачала+1, позКонеца-позНачала-1);
	
	Если ПустаяСтрока(Идентификатор) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	CW_ПараметрыГрузоперевозок.Ссылка КАК Ссылка
	               |ИЗ
	               |	ПланВидовХарактеристик.CW_ПараметрыГрузоперевозок КАК CW_ПараметрыГрузоперевозок
	               |ГДЕ
	               |	(CW_ПараметрыГрузоперевозок.Идентификатор = &Идентификатор
	               |			ИЛИ CW_ПараметрыГрузоперевозок.ИдентификаторПлан = &Идентификатор
	               |			ИЛИ CW_ПараметрыГрузоперевозок.ИдентификаторФакт = &Идентификатор)"; 
	
	Запрос.УстановитьПараметр("Идентификатор", Идентификатор);
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Неопределено;

КонецФункции      

