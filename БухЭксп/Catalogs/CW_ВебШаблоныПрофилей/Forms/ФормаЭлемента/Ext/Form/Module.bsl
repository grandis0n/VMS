&НаСервере
Функция ПолучитьСписокДоступныхПолей()
	
	СписокЗначений = новый СписокЗначений;
	
	Для Каждого СтрокаПоля из Объект.СтруктураПрофиля Цикл
		СписокЗначений.Добавить(СтрокаПоля.СтрокаПоляКомпоновки, СтрокаПоля.ЗаголовокRU);
	КонецЦикла;  
	
	Возврат СписокЗначений;
	
КонецФункции

&НаКлиенте
Процедура ГруппыПолейПередУдалением(Элемент, Отказ)

	Отказ = истина;	
	
	ТекущиеДанные = Элементы.ГруппыПолей.ТекущиеДанные; 
	Если ТекущиеДанные.ИндексКартинки = 2 Тогда
		ПоказатьПредупреждение(, "Нельзя удалять предопределенный элемент!");
		Возврат;
	КонецЕсли;   
	
	Отбор = Новый Структура;
	Отбор.Вставить("ИдентификаторГруппы", ТекущиеДанные.ИдентификаторГруппы); 
	
	ТекущаяСтрока = Элементы.ГруппыПолей.ТекущаяСтрока;
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Отбор", Отбор); 
	ДополнительныеПараметры.Вставить("ТекущаяСтрока", ТекущаяСтрока); 

	Режим = РежимДиалогаВопрос.ДаНет;
	Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаОбУдаленииГруппы", ЭтотОбъект, ДополнительныеПараметры);
	ПоказатьВопрос(Оповещение, "Группа будет удалена. 
	                           |Продолжить?", Режим, 0);
	
КонецПроцедуры  

&НаКлиенте
Процедура ПослеЗакрытияВопросаОбУдаленииГруппы(Результат, ДополнительныеПараметры) Экспорт
    Если Результат = КодВозвратаДиалога.Нет Тогда
        Возврат;
    КонецЕсли;

	МассивСтрокСостава 	= Объект.ПоляОбъекта.НайтиСтроки(ДополнительныеПараметры.Отбор);
	Для Каждого СтрокаМассива из МассивСтрокСостава Цикл  
		СтрокаМассива.ИдентификаторГруппы = ПустойУникальныйИдентификатор();
	КонецЦикла;  
	
	СтрокаТекущая = Объект.ГруппыПолей.НайтиПоИдентификатору(ДополнительныеПараметры.ТекущаяСтрока);
	Объект.ГруппыПолей.Удалить(СтрокаТекущая);

	ОбновитьКоличествоПолейГруппНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ГруппыПолейВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Поле.ГиперссылкаЯчейки Тогда 
		СтандартнаяОбработка = Ложь;
		
		ТекущиеДанные = Элементы.ГруппыПолей.ТекущиеДанные;
		ТекущаяСтрока = Элементы.ГруппыПолей.ТекущаяСтрока;
		
		Если Не ЗначениеЗаполнено(ТекущиеДанные.ИдентификаторГруппы) Тогда
			Возврат;
		КонецЕсли;
		
		СтруктураПараметров = Новый Структура;
        СтруктураПараметров.Вставить("Шрифт", 				ТекущиеДанные.Шрифт);
        СтруктураПараметров.Вставить("ЦветТекста", 			ТекущиеДанные.ЦветТекста);
        СтруктураПараметров.Вставить("ЦветФона", 			ТекущиеДанные.ЦветФона);
        СтруктураПараметров.Вставить("ОтображатьЗаголовок",	ТекущиеДанные.ОтображатьЗаголовок);
		
		ВыделенныеСтроки = Новый Массив;
		ВыделенныеСтроки.Добавить(ТекущаяСтрока);
		
		ОткрытьФормуНастройкиОформления(СтруктураПараметров, ВыделенныеСтроки);
		                              
	КонецЕсли;

КонецПроцедуры  

 &НаКлиенте
Процедура ГруппыПолейПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)

	Если Копирование Тогда
		Отказ = истина;
		Возврат;
	КонецЕсли;
	
	ДобавитьГруппуСПустымИдентификатором();
	
КонецПроцедуры

&НаКлиенте
Процедура ГруппыПолейПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НоваяСтрока Тогда
		ТекущиеДанные = Элементы.ГруппыПолей.ТекущиеДанные;
		ТекущиеДанные.ИдентификаторГруппы = Новый УникальныйИдентификатор();
		ТекущиеДанные.КоличествоПолей	  = 0;
		
		ТекущаяСтрока = Элементы.ГруппыПолей.ТекущаяСтрока; 
		
		ВыбранныеСтроки = Новый Массив;
		ВыбранныеСтроки.Добавить(ТекущаяСтрока);
		УстановитьОформлениеПоУмолчаниюНаСервере(ВыбранныеСтроки);   
		
		УстановитьОтборСтрок(ТекущиеДанные.ИдентификаторГруппы);

		ОбновитьКоличествоПолейГруппНаСервере();
	КонецЕсли;

КонецПроцедуры  

&НаКлиенте
Процедура ГруппыПолейПеретаскивание(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Строка, Поле) 
	
	СтандартнаяОбработка = ЛожЬ;
	
	СтрокаГруппы = Объект.ГруппыПолей.НайтиПоИдентификатору(Строка); 
	
	Для Каждого СтрокаПоля из ПараметрыПеретаскивания.Значение Цикл
		СтрокаПоля.ИдентификаторГруппы = СтрокаГруппы.ИдентификаторГруппы;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ГруппыПолейПриАктивизацииСтроки(Элемент)
	
	ТекущиеДанные = Элементы.ГруппыПолей.ТекущиеДанные;  
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьОтборСтрок(ТекущиеДанные.ИдентификаторГруппы);
	
