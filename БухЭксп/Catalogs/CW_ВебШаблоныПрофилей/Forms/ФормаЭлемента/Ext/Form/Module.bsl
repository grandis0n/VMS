&НаКлиенте
Процедура ЗаврешитьВводРазноязычныхТекстов(РезультатВвода, ДополнительныеПараметры) Экспорт
	
	Если РезультатВвода = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЗаврешитьВводРазноязычныхТекстовНаСервере(РезультатВвода, ДополнительныеПараметры);

	Модифицированность = истина;
	
КонецПроцедуры

&НаСервере
Процедура ЗаврешитьВводРазноязычныхТекстовНаСервере(РезультатВвода, ДополнительныеПараметры)
	
	СтрокаТекущая = Объект[ДополнительныеПараметры.ИмяТаблицы].НайтиПоИдентификатору(ДополнительныеПараметры.ВыбраннаяСтрока);  
	Для Каждого КлючЗначение из РезультатВвода Цикл
		СтрокаТекущая[ДополнительныеПараметры.ИмяРеквизита+КлючЗначение.Ключ] = КлючЗначение.Значение; 
	КонецЦикла;    
	
	Если ДополнительныеПараметры.ИмяТаблицы = "СтруктураПрофиля" Тогда
		ОбновитьЗаголовокСвязанныхПолей(СтрокаТекущая.СтрокаПоляКомпоновки, СтрокаТекущая.ЗаголовокRU);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПереместитьПараметрВГруппу(Команда)

	ВыделенныеСтроки = Элементы.ПоляОбъекта.ВыделенныеСтроки;  
	Если ВыделенныеСтроки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	СписокГрупп = ПолучитьСписокГруппНаСервере();
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ВыделенныеСтроки", ВыделенныеСтроки);
	
	Оповещение = Новый ОписаниеОповещения("ЗавершитьПеремещениеВгруппу", ЭтотОбъект, ДополнительныеПараметры);
	
	СписокГрупп.ПоказатьВыборЭлемента(Оповещение, "Выберите группу");
	
КонецПроцедуры      

&НаКлиенте
Процедура ЗавершитьПеремещениеВгруппу(ЭлементСписка, ДополнительныеПараметры) Экспорт
	
	Если ЭлементСписка = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого ВыделеннаяСтрока из ДополнительныеПараметры.ВыделенныеСтроки Цикл
		СтрокаТекущая = Объект.ПоляОбъекта.НайтиПоИдентификатору(ВыделеннаяСтрока);
		СтрокаТекущая.ИдентификаторГруппы = ЭлементСписка.Значение;                  
	КонецЦикла;  
	
	Модифицированность = Истина;
	
	ОбновитьКоличествоПолейГруппНаСервере();
	
КонецПроцедуры

&НаСервере
Функция ПолучитьСписокГруппНаСервере()
	
	СписокГрупп = Новый СписокЗначений;
	
	Для Каждого СтрокаГрупп из Объект.ГруппыПолей Цикл
		СписокГрупп.Добавить(СтрокаГрупп.ИдентификаторГруппы, СтрокаГрупп.ИмяГруппыRU, , БиблиотекаКартинок.Папка);
	КонецЦикла; 
	
	Возврат СписокГрупп;
	
КонецФункции

&НаКлиенте
Процедура ПоляОбъектаПередУдалением(Элемент, Отказ)
	
	Отказ = Истина;

КонецПроцедуры

&НаКлиенте
Процедура УстановитьОформление(Команда)
	
	ВыбранныеСтроки = Элементы.ГруппыПолей.ВыделенныеСтроки;  
	Если ВыбранныеСтроки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;  
	
	СтруктураПараметров = Новый Структура(ОформлениеГруппПоУмолчанию);
	ОткрытьФормуНастройкиОформления(СтруктураПараметров, ВыбранныеСтроки);
	
КонецПроцедуры   

&НаКлиенте
Процедура ОткрытьФормуНастройкиОформления(СтруктураПараметров, ВыбранныеСтроки)
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ВыбранныеСтроки", ВыбранныеСтроки);
	
	Оповещение = Новый ОписаниеОповещения("ЗавершитьВыборОформленияГрупп", ЭтотОбъект, ДополнительныеПараметры);
	
	ОткрытьФорму("ОбщаяФорма.CW_ФормаУстановкиОформления", СтруктураПараметров, ЭтаФорма,,,,Оповещение);

КонецПроцедуры 

&НаКлиенте
Процедура ЗавершитьВыборОформленияГрупп(РезультатОформления, ДополнительныеПараметры) Экспорт
	
	Если РезультатОформления = Неопределено Тогда
		Возврат;
	КонецЕсли;    
	
	ЗавершитьВыборОформленияГруппНаСервере(РезультатОформления, ДополнительныеПараметры);
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаСервере
Процедура ЗавершитьВыборОформленияГруппНаСервере(Знач РезультатОформления,  ДополнительныеПараметры)
	
	Для Каждого ТекущаяСтрока из ДополнительныеПараметры.ВыбранныеСтроки Цикл  
		УстановитьОформлениеСтрокиНаСервере(ТекущаяСтрока, РезультатОформления);
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура УстановитьОформлениеСтрокиНаСервере(ТекущаяСтрока, Знач РезультатОформления)
	
	СтрокаТекущая = Объект.ГруппыПолей.НайтиПоИдентификатору(ТекущаяСтрока);  
	Если Не ЗначениеЗаполнено(СтрокаТекущая.ИдентификаторГруппы) Тогда
		Возврат;
	КонецЕсли;
	
	СтрокаТекущая.Шрифт 				= РезультатОформления.Шрифт;
	СтрокаТекущая.ЦветТекста 			= РезультатОформления.ЦветТекста;
	СтрокаТекущая.ЦветФона 				= РезультатОформления.ЦветФона; 
	СтрокаТекущая.ОтображатьЗаголовок	= РезультатОформления.ОтображатьЗаголовок; 
	СтрокаТекущая.ЕстьОформление		= 1;

КонецПроцедуры 


&НаКлиенте
Процедура УстановитьОформлениеПоУмолчанию(Команда)  
	
	ВыбранныеСтроки = Элементы.ГруппыПолей.ВыделенныеСтроки;  
	Если ВыбранныеСтроки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	УстановитьОформлениеПоУмолчаниюНаСервере(ВыбранныеСтроки);

КонецПроцедуры

&НаСервере
Процедура УстановитьОформлениеПоУмолчаниюНаСервере(ВыбранныеСтроки)
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ВыбранныеСтроки", ВыбранныеСтроки);   
	
	РезультатОформления = Новый Структура(ОформлениеГруппПоУмолчанию);
	
	ЗавершитьВыборОформленияГруппНаСервере(РезультатОформления, ДополнительныеПараметры);

КонецПроцедуры

&НаСервере
Процедура УстановитьПараметрыОформленияПоУмолчанию()
	
	ХранилищеЗначения 	= Константы.CW_ОформлениеГруппВебШаблонов.Получить();
	СтруктураПараметров = ХранилищеЗначения.Получить();
	
	Если СтруктураПараметров = Неопределено Тогда
		СтруктураПараметров = Новый Структура;
		СтруктураПараметров.Вставить("Шрифт", 				ШрифтыСтиля.ШрифтТекста);
		СтруктураПараметров.Вставить("ЦветТекста", 			ЦветаСтиля.ЦветТекстаПоля);
		СтруктураПараметров.Вставить("ЦветФона", 			ЦветаСтиля.ЦветФонаПоля);
		СтруктураПараметров.Вставить("ОтображатьЗаголовок",	Истина);
	КонецЕсли;   
	
	ОформлениеГруппПоУмолчанию = Новый ФиксированнаяСтруктура(СтруктураПараметров);
	
КонецПроцедуры



