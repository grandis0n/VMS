&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Ключ.Пустая() Тогда
		Объект.Наименование	= "Новый";
	КонецЕсли;     
	
	УстановитьПараметрыОформленияПоУмолчанию();
	
	СтарыйРаздел = Объект.Раздел;
	
	Если Не ПустаяСтрока(Объект.Раздел) Тогда
		УстановитьАдресаСхемыДоступныхПолей(Объект.Раздел);              
	КонецЕсли;  
	
	Если Параметры.Ключ.Пустая() Тогда
		ДобавитьГруппуСПустымИдентификатором();
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	УстановитьЗначенияДополительныхКолонок(ТекущийОбъект);
	
КонецПроцедуры   

&НаСервере
Процедура ОбновитьКоличествоПолейГруппНаСервере()
	
	Для Каждого СтрокаГруппы из Объект.ГруппыПолей Цикл
		Отбор = Новый Структура;
		Отбор.Вставить("ИдентификаторГруппы", СтрокаГруппы.ИдентификаторГруппы); 
		
		МассивПолей = Объект.ПоляОбъекта.НайтиСтроки(Отбор);
		СтрокаГруппы.КоличествоПолей =  МассивПолей.Количество();
	КонецЦикла;
	
КонецПроцедуры


 &НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	УстановитьЗначенияДополительныхКолонок(ТекущийОбъект);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьЗначенияДополительныхКолонок(ТекущийОбъект)
   
	Для Каждого СтрокаТекущийОбъект из ТекущийОбъект.СтруктураПрофиля Цикл
		ИндексСтроки = ТекущийОбъект.СтруктураПрофиля.Индекс(СтрокаТекущийОбъект);	
		
		СтрокаОбъект = Объект.СтруктураПрофиля[ИндексСтроки];  
		СтрокаОбъект.ОписаниеТипа = СтрокаТекущийОбъект.ХранилищеТипаЗначения.Получить();
	КонецЦикла; 
	
	Для Каждого СтрокаТаблицы из ТекущийОбъект.ГруппыПолей Цикл   
		ИндексСтроки	= ТекущийОбъект.ГруппыПолей.Индекс(СтрокаТаблицы);  
		
		СтрокаОбъекта 	= Объект.ГруппыПолей[ИндексСтроки]; 
		
		Отбор = Новый Структура;
		Отбор.Вставить("ИдентификаторГруппы", СтрокаОбъекта.ИдентификаторГруппы); 
		МассивПолей = Объект.ПоляОбъекта.НайтиСтроки(Отбор);
	
		
		СтрокаОбъекта.Шрифт 			= СтрокаТаблицы.ХранилищеШрифт.Получить();   
		СтрокаОбъекта.ЦветФона 			= СтрокаТаблицы.ХранилищеЦветФона.Получить();   
		СтрокаОбъекта.ЦветТекста 		= СтрокаТаблицы.ХранилищеЦветТекста.Получить();   
		СтрокаОбъекта.ИндексКартинки 	= ?(ЗначениеЗаполнено(СтрокаОбъекта.ИдентификаторГруппы), 0, 2);  
		СтрокаОбъекта.КоличествоПолей 	=  МассивПолей.Количество();
		
	КонецЦикла; 
	
	Для Каждого СтрокаТаблицы из ТекущийОбъект.ПоляОбъекта Цикл   
		ИндексСтроки	= ТекущийОбъект.ПоляОбъекта.Индекс(СтрокаТаблицы);  
		
		СтрокаОбъекта 	= Объект.ПоляОбъекта[ИндексСтроки];  
		СтрокаОбъекта.ИндексКартинки 	= 3;
	КонецЦикла; 

   
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	Для Каждого СтрокаСтруктуры из Объект.СтруктураПрофиля Цикл
		ИндексСтроки = Объект.СтруктураПрофиля.Индекс(СтрокаСтруктуры);	
		СтрокаТекущийОбъект = ТекущийОбъект.СтруктураПрофиля[ИндексСтроки];  
		СтрокаТекущийОбъект.ХранилищеТипаЗначения = Новый ХранилищеЗначения(СтрокаСтруктуры.ОписаниеТипа);
	КонецЦикла;   
	
	Для Каждого СтрокаТаблицы из ТекущийОбъект.ГруппыПолей Цикл  
		ИндексСтроки	= ТекущийОбъект.ГруппыПолей.Индекс(СтрокаТаблицы);
		СтрокаОбъекта 	= Объект.ГруппыПолей[ИндексСтроки];  
		
		СтрокаТаблицы.ХранилищеШрифт 		= Новый ХранилищеЗначения(СтрокаОбъекта.Шрифт);
		СтрокаТаблицы.ХранилищеЦветФона 	= Новый ХранилищеЗначения(СтрокаОбъекта.ЦветФона);
		СтрокаТаблицы.ХранилищеЦветТекста 	= Новый ХранилищеЗначения(СтрокаОбъекта.ЦветТекста);   
	КонецЦикла;  
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	ДобавитьГруппуСПустымИдентификатором(); 

КонецПроцедуры 

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	ОповеститьОЗаписиНового(Объект.Ссылка);
	
КонецПроцедуры

&НаКлиенте
Процедура РазделПриИзменении(Элемент) 
	
	Если СтарыйРаздел = Объект.Раздел Тогда
		//Ничего делать не нужно
		Возврат;
	КонецЕсли;  

	Оповещение = Новый ОписаниеОповещения("ЗавершитьИзменениеРаздела", ЭтотОбъект);
	
	Если Объект.СтруктураПрофиля.Количество() <> 0 Тогда
		Режим = РежимДиалогаВопрос.ДаНет;
		ПоказатьВопрос(Оповещение, "Структура профиля будет очищена. Продолжить?", Режим, 0);	
	Иначе
		ВыполнитьОбработкуОповещения(Оповещение,КодВозвратаДиалога.Да);
	КонецЕсли;
	
КонецПроцедуры 

&НаКлиенте
Процедура ЗавершитьИзменениеРаздела(Результат, ДополнительныеПараметры) Экспорт
	Если Результат = КодВозвратаДиалога.Нет Тогда     
		Объект.Раздел = СтарыйРаздел;
        Возврат;
    КонецЕсли;
	
	Объект.СтруктураПрофиля.Очистить();
	Объект.ПоляСортировки.Очистить();
	
	УстановитьАдресаСхемыДоступныхПолей(Объект.Раздел);

	СтарыйРаздел = Объект.Раздел;

КонецПроцедуры

&НаСервере
Процедура УстановитьАдресаСхемыДоступныхПолей(Знач Раздел) 
	
	Если ПустаяСтрока(Раздел) Тогда 
		АдресСхемыДоступныхПолей = "";
		Возврат;
	КонецЕсли;
		
	СхемаДоступныхПолей  		= ПолучитьОбщийМакет("CW_"+Раздел+"СхемаДоступныхПолей");
	АдресСхемыДоступныхПолей 	= ПоместитьВоВременноеХранилище(СхемаДоступныхПолей,Этаформа.УникальныйИдентификатор);
	
КонецПроцедуры 

&НаКлиенте
Процедура СтруктураПрофиляВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Поле.ГиперссылкаЯчейки Тогда
		СтандартнаяОбработка = ложь;	
		
		ТекущаяСтрока = Элементы.СтруктураПрофиля.ТекущаяСтрока;
		ТекущиеДанные = Элементы.СтруктураПрофиля.ТекущиеДанные;
		
		ДанныеСтроки = Новый Структура;
		ДанныеСтроки.Вставить("СтрокаПоляКомпоновки", ТекущиеДанные.СтрокаПоляКомпоновки);
		ДанныеСтроки.Вставить("ОбъектХарактеристики", ТекущиеДанные.ОбъектХарактеристики);
		
		Конструктор = Новый КонструкторФорматнойСтроки;
		Конструктор.Текст 			= Элементы.СтруктураПрофиля.ТекущиеДанные.Формат;
		Конструктор.ДоступныеТипы 	= ПолучитьОписаниеТипаНаСервере(ДанныеСтроки); 
		
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("ТекущаяСтрока", ТекущаяСтрока);
	
		ОписаниеОповещения = Новый ОписаниеОповещения("ОбработкаИзмененияФорматаКолонки", ЭтотОбъект, ДополнительныеПараметры); 
		Конструктор.Показать(ОписаниеОповещения);

	КонецЕсли;
	
КонецПроцедуры    

&НаСервереБезКонтекста
Функция ПолучитьОписаниеТипаНаСервере(ДанныеСтроки)

	Если ЗначениеЗаполнено(ДанныеСтроки.ОбъектХарактеристики) Тогда
		Возврат ДанныеСтроки.ОбъектХарактеристики.ТипЗначения;
	Конецесли;
	
	Ссылка 				= ПредопределенноеЗначение("Справочник.CW_Заявки.ПустаяСсылка");
	ЛогистическийСтатус = ПредопределенноеЗначение("Справочник.CW_ЛогистическиеСтатусы.ПустаяСсылка");
	ПустоеЗначение 		= Вычислить(ДанныеСтроки.СтрокаПоляКомпоновки); 
	
	ДоступныйТип = Новый Массив;
	ДоступныйТип.Добавить(ТипЗнч(ПустоеЗначение));
	
	Возврат Новый ОписаниеТипов(ДоступныйТип);	
	
КонецФункции


&НаКлиенте
Процедура ОбработкаИзмененияФорматаКолонки(ФорматЗначения, ДополнительныеПараметры) Экспорт 
	
	Если ФорматЗначения = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СтрокаТекущая = Объект.СтруктураПрофиля.НайтиПоИдентификатору(ДополнительныеПараметры.ТекущаяСтрока);
	СтрокаТекущая.Формат = ФорматЗначения; 
	
КонецПроцедуры


&НаКлиенте
Процедура СтруктураПрофиляПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	Отказ = Истина;	
	
	Если Не ЭтоАдресВременногоХранилища(АдресСхемыДоступныхПолей) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не выбран раздел шаблона!",,"Раздел", "Объект");
		Возврат;
	КонецЕсли;
	
	ОписаниеОповещения 	= Новый ОписаниеОповещения("ОбработкаДобавленияКолонки",ЭтотОбъект); 
	СтруктураПараметров = Новый Структура("АдресСхемыКомпоновки", АдресСхемыДоступныхПолей);
	
	ОткрытьФорму("Справочник.CW_ВебШаблоныПрофилей.Форма.ФормаПодбораКолонки",СтруктураПараметров,,,,,ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);	
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаДобавленияКолонки(ВыбранныеПоля, ДополнительныеПараметры) Экспорт  
	
	Если ВыбранныеПоля = Неопределено Тогда
		Возврат;
	КонецЕсли;                                                                
	
	ОбработатьВыборПоляНаСервере(ВыбранныеПоля);
	
	Модифицированность = Истина;

КонецПроцедуры 
	
&НаСервере
Процедура ОбработатьВыборПоляНаСервере(ВыбранныеПоля)  
	
	ПримитивныеТипы = Новый Массив;
	ПримитивныеТипы.Добавить(Тип("Булево"));
	ПримитивныеТипы.Добавить(Тип("Дата"));
	ПримитивныеТипы.Добавить(Тип("Число"));
	
	Для Каждого ВыбранноеПоле из ВыбранныеПоля Цикл
		
		Отбор = Новый Структура;
		Отбор.Вставить("СтрокаПоляКомпоновки", Строка(ВыбранноеПоле.Поле));
		
		мСтроки = Объект.СтруктураПрофиля.НайтиСтроки(Отбор);
		Если мСтроки.Количество() > 0 Тогда
			Продолжить;
		КонецЕсли;      
		
		СтрокаТаблицы = Объект.СтруктураПрофиля.Добавить(); 
		СтрокаТаблицы.ИмяПоля				= ИмяПоляИзСтрокиПоляКомпоновки(Строка(ВыбранноеПоле.Поле));
		СтрокаТаблицы.СтрокаПоляКомпоновки	= Строка(ВыбранноеПоле.Поле);
		СтрокаТаблицы.ЗаголовокRU			= ВыбранноеПоле.Заголовок;
		
		МассивТипов = ВыбранноеПоле.ТипЗначения.Типы();
		Для Каждого ТипЗначения из МассивТипов Цикл   
			Если ПримитивныеТипы.Найти(ТипЗначения) <> Неопределено Тогда 
				СтрокаТаблицы.ДоступенФормат = Истина; 
				Прервать;
			КонецЕсли;
		КонецЦикла; 
		
		СтрокаТаблицы.ОписаниеТипа 			= ВыбранноеПоле.ТипЗначения;
		СтрокаТаблицы.Фиксация 				= ПредопределенноеЗначение("Перечисление.CW_ВариантыФиксацииКолонок.Нет");
		СтрокаТаблицы.ОбъектХарактеристики 	= ПолучитьМониторинговыйПараметр(Строка(ВыбранноеПоле.Поле));
		
		//Поля объекта
		СтрокаТаблицы = Объект.ПоляОбъекта.Добавить(); 
		СтрокаТаблицы.СтрокаПоляКомпоновки	= Строка(ВыбранноеПоле.Поле);
		СтрокаТаблицы.ЗаголовокRU			= ВыбранноеПоле.Заголовок;
		СтрокаТаблицы.ИндексКартинки 		= 3;
		
	КонецЦикла; 
	
КонецПроцедуры   

&НаКлиенте
Процедура СтруктураПрофиляПередУдалением(Элемент, Отказ)
	
	ТекущиеДанные = Элементы.СтруктураПрофиля.ТекущиеДанные;
	
	Отбор = Новый Структура("СтрокаПоляКомпоновки", ТекущиеДанные.СтрокаПоляКомпоновки);
	
	МассивПоляОбъекта = Объект.ПоляОбъекта.НайтиСтроки(Отбор);
	Для Каждого СтрокаМассива из МассивПоляОбъекта Цикл
		Объект.ПоляОбъекта.Удалить(СтрокаМассива);	
	КонецЦикла;
	
	МассивПоляСортировки = Объект.ПоляСортировки.НайтиСтроки(Отбор);
	Для Каждого СтрокаМассива из МассивПоляСортировки Цикл
		Объект.ПоляСортировки.Удалить(СтрокаМассива);	
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура СтруктураПрофиляЗаголовокRUПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.СтруктураПрофиля.ТекущиеДанные;
	
	ОбновитьЗаголовокСвязанныхПолей(ТекущиеДанные.СтрокаПоляКомпоновки, ТекущиеДанные.ЗаголовокRU);
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьЗаголовокСвязанныхПолей(Знач СтрокаПоляКомпоновки, Знач ЗаголовокПоля)
	
	Отбор = Новый Структура("СтрокаПоляКомпоновки", СтрокаПоляКомпоновки);
	
	МассивПоляОбъекта = Объект.ПоляОбъекта.НайтиСтроки(Отбор);
	Для Каждого СтрокаМассива из МассивПоляОбъекта Цикл    
		СтрокаМассива.ЗаголовокRU = ЗаголовокПоля;
	КонецЦикла;
	
	МассивПоляСортировки = Объект.ПоляСортировки.НайтиСтроки(Отбор);
	Для Каждого СтрокаМассива из МассивПоляСортировки Цикл
		СтрокаМассива.Заголовок = ЗаголовокПоля;
	КонецЦикла;

КонецПроцедуры


&НаСервере
Процедура ДобавитьГруппуСПустымИдентификатором()
	
	ПустойИдентификаторГруппы = ПустойУникальныйИдентификатор();
	
	Отбор = Новый Структура;
	Отбор.Вставить("ИдентификаторГруппы", ПустойИдентификаторГруппы); 
	
	МассивПолей	= Объект.ПоляОбъекта.НайтиСтроки(Отбор);
	МассивГрупп	= Объект.ГруппыПолей.НайтиСтроки(Отбор);
	
	Если (МассивПолей.Количество() > 0 
		И МассивГрупп.Количество() = 0) 
		ИЛИ Объект.ГруппыПолей.Количество() = 0 Тогда 
		
		//Добавим группу с пустым идентификатором
		НоваяСтрока = Объект.ГруппыПолей.Вставить(0);
		НоваяСтрока.ИмяГруппыRU 			= "<Пустая>"; 
		НоваяСтрока.ИдентификаторГруппы 	= ПустойИдентификаторГруппы;  
		НоваяСтрока.ИндексКартинки			= 2;
		НоваяСтрока.ЕстьОформление			= -1;

		ВыбранныеСтроки = Новый Массив;
		ВыбранныеСтроки.Добавить(НоваяСтрока.ПолучитьИдентификатор());
		
		УстановитьОформлениеПоУмолчаниюНаСервере(ВыбранныеСтроки);   
		
		ОбновитьКоличествоПолейГруппНаСервере(); 
		
	КонецЕсли;

КонецПроцедуры  

&НаСервере
Функция ПустойУникальныйИдентификатор()
	
	Возврат Новый УникальныйИдентификатор("00000000-0000-0000-0000-000000000000");
	
КонецФункции  

&НаСервере
Функция ИмяПоляИзСтрокиПоляКомпоновки(Знач ИмяПоля)
	
	ИмяПоля = СтрЗаменить(ИмяПоля," ","");
	ИмяПоля = СтрЗаменить(ИмяПоля,"(","_");
	ИмяПоля = СтрЗаменить(ИмяПоля,")","_");
