Функция ПолучитьВалютуДатуКурсаБюджета(ТипПеревозки, ВидСтатьи) Экспорт   

	Валюта 			= Константы.ВалютаРегламентированногоУчета.Получить();	 
	СтруктураОтвета = Новый Структура("Валюта,ДатаКурса,ТипКурсаВалюты", Валюта, Неопределено, 0);
	
	Если ВидСтатьи = ПредопределенноеЗначение("Перечисление.CW_ВидыСтатейПланирования.ПустаяСсылка") Тогда
		Возврат СтруктураОтвета;
	КонецЕсли;
	
	СоответствиеСуфикса = ПолучитьСоответствиеСуфикса();
 	Суффикс = СоответствиеСуфикса.Получить(ВидСтатьи);  
	Если Суффикс = Неопределено Тогда
		Возврат СтруктураОтвета;
	КонецЕсли; 

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	CW_ТипыПеревозок.Ссылка КАК Ссылка,
	               |	CW_ТипыПеревозок.БюджетВалютаДохода КАК БюджетВалютаДохода,
	               |	CW_ТипыПеревозок.БюджетВалютаРасхода КАК БюджетВалютаРасхода,
	               |	CW_ТипыПеревозок.БюджетДатаКурсаДохода КАК БюджетДатаКурсаДохода,
	               |	CW_ТипыПеревозок.БюджетДатаКурсаРасхода КАК БюджетДатаКурсаРасхода,
	               |	CW_ТипыПеревозок.ТипКурсаВалютыДохода КАК ТипКурсаВалютыДохода,
	               |	CW_ТипыПеревозок.ТипКурсаВалютыРасхода КАК ТипКурсаВалютыРасхода
	               |ИЗ
	               |	Справочник.CW_ТипыПеревозок КАК CW_ТипыПеревозок
	               |ГДЕ
	               |	CW_ТипыПеревозок.Ссылка = &ТипПеревозки"; 
	
	Запрос.УстановитьПараметр("ТипПеревозки", ТипПеревозки);
	
	Результат = Запрос.Выполнить();
	

	
	Выборка = Результат.Выбрать();
	Если Выборка.Следующий() Тогда  
		СтруктураОтвета.Вставить("Валюта", 			Выборка["БюджетВалюта"+Суффикс]);	
		СтруктураОтвета.Вставить("ДатаКурса", 		Выборка["БюджетДатаКурса"+Суффикс]);
		СтруктураОтвета.Вставить("ТипКурсаВалюты", 	Выборка["ТипКурсаВалюты"+Суффикс]);	
	КонецЕсли;
	
	Возврат СтруктураОтвета; 
	
КонецФункции   

Функция ПолучитьСоответствиеСуфикса()
	
	Соответствие = новый Соответствие;
	Соответствие.Вставить(ПредопределенноеЗначение("Перечисление.CW_ВидыСтатейПланирования.Доходы"), "Дохода");
	Соответствие.Вставить(ПредопределенноеЗначение("Перечисление.CW_ВидыСтатейПланирования.Расходы"), "Расхода");

	Возврат Соответствие;
	
КонецФункции

Процедура ЗаполнитьТипКурсаВалютыБюджета() Экспорт
	
	Запрос = новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	CW_ТипыПеревозок.Ссылка КАК Ссылка,
	               |	CW_ТипыПеревозок.БюджетДатаКурсаДохода КАК БюджетДатаКурсаДохода,
	               |	CW_ТипыПеревозок.БюджетДатаКурсаРасхода КАК БюджетДатаКурсаРасхода
	               |ИЗ
	               |	Справочник.CW_ТипыПеревозок КАК CW_ТипыПеревозок
	               |ГДЕ
	               |	CW_ТипыПеревозок.ПометкаУдаления = ЛОЖЬ
	               |	И CW_ТипыПеревозок.ЭтоГруппа = ЛОЖЬ"; 
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Записать = Ложь;
		ОбъектТипПеревозки = Выборка.Ссылка.ПолучитьОбъект(); 
		
		Если ЗначениеЗаполнено(Выборка.БюджетДатаКурсаДохода) Тогда
			Записать = Истина;	 
			ОбъектТипПеревозки.ТипКурсаВалютыДохода = 2;	
		КонецЕсли;
		Если ЗначениеЗаполнено(Выборка.БюджетДатаКурсаРасхода) Тогда
			Записать = Истина;	
			ОбъектТипПеревозки.ТипКурсаВалютыРасхода = 2;	
		КонецЕсли;
		
		Если Записать тогда   
			ОбъектТипПеревозки.ОбменДанными.Загрузка = истина;
			ОбъектТипПеревозки.Записать();
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

