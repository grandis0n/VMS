#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

Функция ПолучитьЗначенияПредопределенныхЗначенийРеквизитовШапки(ТипПеревозки, Назначение = "ДляГрузоперевозки") Экспорт
	
	Результат = Новый Структура;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	CW_ТипыПеревозокПредопределенныеЗначенияРеквизитов.ИмяРеквизита КАК ИмяРеквизита,
	|	CW_ТипыПеревозокПредопределенныеЗначенияРеквизитов.ПерезаполнятьЗначение КАК ПерезаполнятьЗначение,
	|	CW_ТипыПеревозокПредопределенныеЗначенияРеквизитов.ХранилищеЗначения КАК ХранилищеЗначения
	|ИЗ
	|	Справочник.CW_ТипыПеревозок.ПредопределенныеЗначенияРеквизитов КАК CW_ТипыПеревозокПредопределенныеЗначенияРеквизитов
	|ГДЕ
	|	CW_ТипыПеревозокПредопределенныеЗначенияРеквизитов.Ссылка = &ТипПеревозки
	|	И CW_ТипыПеревозокПредопределенныеЗначенияРеквизитов."+Назначение+" = ИСТИНА";
	
	Запрос.УстановитьПараметр("ТипПеревозки", ТипПеревозки);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл   
		
		ХранимоеЗначение = Выборка.ХранилищеЗначения.Получить();   

		ЗначениеРеквизита = Новый Структура;
		ЗначениеРеквизита.Вставить("ПерезаполнятьЗначение", Выборка.ПерезаполнятьЗначение);
		ЗначениеРеквизита.Вставить("Значение", 				ХранимоеЗначение);
		
		Если ЗначениеЗаполнено(ХранимоеЗначение) Тогда  
			
			Результат.Вставить(Выборка.ИмяРеквизита, ЗначениеРеквизита);  
			Если Выборка.ИмяРеквизита = "Клиент" Тогда   
				//Дублируем для заявки
				Результат.Вставить("Контрагент", ЗначениеРеквизита);  
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Процедура ОбработкаПолученияФормы(ВидФормы, Параметры, ВыбраннаяФорма, ДополнительнаяИнформация, СтандартнаяОбработка)
	
	
