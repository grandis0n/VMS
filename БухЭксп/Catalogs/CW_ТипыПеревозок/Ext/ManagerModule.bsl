Функция ПолучитьГруппыИПараметры(Ссылка, ПолучаемыеПараметры) Экспорт
	
	Результат = Новый Структура;
	
	Пользователь 				= ПараметрыСеанса.ТекущийПользователь;
	ЭтоПолноправныйПользователь = CW_ПраваДоступа.ЭтоПолноправныйПользователь(ПараметрыСеанса.ТекущийПользователь,Истина);
	
	ГруппаПользователя = CW_ПраваДоступа_ПИ.ГруппаПользователя(Пользователь);
	Если (ГруппаПользователя = Неопределено) Тогда
		ГруппаПользователя = Справочники.CW_ГруппыПользователей.ПустаяСсылка();
	КонецЕсли; 
	Если (ГруппаПользователя.ПолныеПрава) Тогда
		ГруппаПользователя = Справочники.CW_ГруппыПользователей.Администраторы;
	КонецЕсли; 

	Если ПолучаемыеПараметры.Свойство("ПараметрыГрузоперевозок") Тогда
		Если ПолучаемыеПараметры.ПараметрыГрузоперевозок Тогда
			
			Запрос = Новый Запрос;
			Запрос.Текст = "ВЫБРАТЬ
			               |	CW_ТипыПеревозокГруппыПараметровГрузоперевозки.ИдентификаторГруппы КАК ИдентификаторГруппы,
			               |	CW_ТипыПеревозокГруппыПараметровГрузоперевозки.ИдентификаторВладельца КАК ИдентификаторВладельца,
			               |	CW_ТипыПеревозокГруппыПараметровГрузоперевозки.Наименование КАК Параметр,
			               |	CW_ТипыПеревозокГруппыПараметровГрузоперевозки.Раскрывать КАК Раскрывать,
			               |	CW_ТипыПеревозокГруппыПараметровГрузоперевозки.Порядок КАК Порядок
			               |ИЗ
			               |	Справочник.CW_ТипыПеревозок.ГруппыПараметровГрузоперевозки КАК CW_ТипыПеревозокГруппыПараметровГрузоперевозки
			               |ГДЕ
			               |	CW_ТипыПеревозокГруппыПараметровГрузоперевозки.Ссылка = &Ссылка
			               |
			               |УПОРЯДОЧИТЬ ПО
			               |	Порядок
			               |АВТОУПОРЯДОЧИВАНИЕ
			               |;
			               |
			               |////////////////////////////////////////////////////////////////////////////////
			               |ВЫБРАТЬ
			               |	CW_ТипыПеревозокПараметрыГрузоперевозки.ИдентификаторВладельца КАК ИдентификаторВладельца,
			               |	CW_ТипыПеревозокПараметрыГрузоперевозки.Параметр КАК Параметр,
			               |	CW_ТипыПеревозокПараметрыГрузоперевозки.КонтрольЗаполнения КАК КонтрольЗаполнения,
			               |	CW_ТипыПеревозокПараметрыГрузоперевозки.КонтрольЗаполненияРасходы КАК КонтрольЗаполненияРасходы,
			               |	CW_ТипыПеревозокПараметрыГрузоперевозки.КонтрольЗаполненияДоходы КАК КонтрольЗаполненияДоходы,
			               |	CW_ТипыПеревозокПараметрыГрузоперевозки.Значение КАК Значение,
			               |	CW_ТипыПеревозокПараметрыГрузоперевозки.Порядок КАК Порядок,
