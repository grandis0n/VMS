КонецПроцедуры

&НаКлиенте
Процедура ПеренестиВСоставПараметровГрузопереовзки(Команда)
	
	Если ИндексСтраницыПараметров = 1 Тогда //Страница заявки
		
		ДеревоПараметров = ДПЗ;
		ВыделенныеСтроки = Элементы.ДПЗ.ВыделенныеСтроки;
		ИмяРеквизитаГруппыПараметров = "ГруппыПараметровЗаявки";
		
	ИначеЕсли ИндексСтраницыПараметров = 2 Тогда //Страница Заказы
		
		ДеревоПараметров = ДПЗаказ;
		ВыделенныеСтроки = Элементы.ДПЗаказ.ВыделенныеСтроки;
		ИмяРеквизитаГруппыПараметров = "ГруппыПараметровЗаказа";
		
	КонецЕсли;	
	
	УдалитьСтрокиВходящиеВВыбранныеГруппы(ВыделенныеСтроки, ДеревоПараметров);
	
	Для Каждого ИдентифкаторСтроки Из ВыделенныеСтроки Цикл
		СтрокаДерева =  ДеревоПараметров.НайтиПоИдентификатору(ИдентифкаторСтроки);
		ПеренестиЭлементыВГрузоперевозки(СтрокаДерева, ИмяРеквизитаГруппыПараметров);
	КонецЦикла;
	
	_ДПГ_Обновить();
	ДПГ_ВосстановитьСостояниеСвертки();
	
КонецПроцедуры


&НаКлиенте
Процедура УдалитьСтрокиВходящиеВВыбранныеГруппы(ВыделенныеСтроки, ДеревоПараметров)
	
	мГруппы = Новый Массив;
	мСтроки = Новый Массив;
	
	//Заполниим группы
	Для Каждого ИдентифкаторСтроки Из ВыделенныеСтроки Цикл
		СтрокаДерева =  ДеревоПараметров.НайтиПоИдентификатору(ИдентифкаторСтроки);
		Если СтрокаДерева.ЭтоГруппа Тогда
			мГруппы.Добавить(СтрокаДерева);
		Иначе
			мСтроки.Добавить(ИдентифкаторСтроки);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого ИдентифкаторСтроки Из мСтроки Цикл
		СтрокаДерева 	=  ДеревоПараметров.НайтиПоИдентификатору(ИдентифкаторСтроки); 
		СтрокаРодитель 	= СтрокаДерева.ПолучитьРодителя();
		
		Если мГруппы.Найти(СтрокаРодитель) <> Неопределено Тогда
			ВыделенныеСтроки.Удалить( ВыделенныеСтроки.Найти(ИдентифкаторСтроки));
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры


&НаКлиенте
Процедура ПеренестиЭлементыВЗаявки(СтрокаДерева, ИмяРеквизитаГруппыПараметров, ИдентификаторГруппыРодителя = Неопределено)
	
	Если СтрокаДерева.ЭтоГруппа Тогда
		
		мСтрокиГруппы_ДПЗ = Объект.ГруппыПараметровЗаявки.НайтиСтроки(Новый Структура("Наименование", СтрокаДерева.НаименованиеГруппы));
		Если мСтрокиГруппы_ДПЗ.Количество() = 0 Тогда
			
			мНайденныеСтроки = Объект[ИмяРеквизитаГруппыПараметров].НайтиСтроки(Новый Структура("Идентификатор",СтрокаДерева.ИдентификаторГруппы));
			Если мНайденныеСтроки.Количество() > 0 Тогда
				ТекущаяСтрокаГруппы = мНайденныеСтроки[0];
				СтруктураГруппы = Новый Структура("НаименованиеГруппы,ГруппаРазвернута", СтрокаДерева.НаименованиеГруппы,ТекущаяСтрокаГруппы.Раскрывать);
				ИдентификаторГруппы = _ДПЗ_ДобавитьГруппу(СтруктураГруппы, ИдентификаторГруппыРодителя);
			КонецЕсли;
			
		Иначе
			ИдентификаторГруппы =  мСтрокиГруппы_ДПЗ[0].Идентификатор;
		КонецЕсли;
		
		ЭлементыДерева = СтрокаДерева.ПолучитьЭлементы();
		
		Для Каждого СтрокаГруппы из ЭлементыДерева цикл
			
			Если СтрокаГруппы.ЭтоГруппа Тогда
				ПеренестиЭлементыВЗаявки(СтрокаГруппы,ИдентификаторГруппы);
			Иначе
				Если ДПЗ_ДобавляемыйПараметрНовый(СтрокаГруппы.Параметр) Тогда
					ИдентификаторДобавленнойСтроки = _ДПЗ_ДобавитьПараметр(СтрокаГруппы.Параметр,Истина,ИдентификаторГруппы);
				КонецЕсли;
				
			КонецЕсли;
		КонецЦикла;
		
	Иначе
		Если ДПЗ_ДобавляемыйПараметрНовый(СтрокаДерева.Параметр) Тогда
			ИдентификаторДобавленнойСтроки = _ДПЗ_ДобавитьПараметр(СтрокаДерева.Параметр,истина);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПеренестиЭлементыВЗаказы(СтрокаДерева, ИмяРеквизитаГруппыПараметров, ИдентификаторГруппыРодителя = Неопределено)
	
	Если СтрокаДерева.ЭтоГруппа Тогда
		
		мСтрокиГруппы_ДПЗаказ = Объект.ГруппыПараметровЗаказа.НайтиСтроки(Новый Структура("Наименование", СтрокаДерева.НаименованиеГруппы));
		Если мСтрокиГруппы_ДПЗаказ.Количество() = 0 Тогда
			
			мНайденныеСтроки = Объект[ИмяРеквизитаГруппыПараметров].НайтиСтроки(Новый Структура("Идентификатор",СтрокаДерева.ИдентификаторГруппы));
			Если мНайденныеСтроки.Количество() > 0 Тогда
				ТекущаяСтрокаГруппы = мНайденныеСтроки[0];
				СтруктураГруппы = Новый Структура("НаименованиеГруппы,ГруппаРазвернута", СтрокаДерева.НаименованиеГруппы,ТекущаяСтрокаГруппы.Раскрывать);
				ИдентификаторГруппы = _ДПЗаказ_ДобавитьГруппу(СтруктураГруппы, ИдентификаторГруппыРодителя);
			КонецЕсли;
			
		Иначе
			ИдентификаторГруппы =  мСтрокиГруппы_ДПЗаказ[0].Идентификатор;
		КонецЕсли;
		
		ЭлементыДерева = СтрокаДерева.ПолучитьЭлементы();
		
		Для Каждого СтрокаГруппы из ЭлементыДерева цикл
			
			Если СтрокаГруппы.ЭтоГруппа Тогда
				ПеренестиЭлементыВЗаявки(СтрокаГруппы,ИдентификаторГруппы);
			Иначе
				Если ДПЗаказ_ДобавляемыйПараметрНовый(СтрокаГруппы.Параметр) Тогда
					ИдентификаторДобавленнойСтроки = _ДПЗаказ_ДобавитьПараметр(СтрокаГруппы.Параметр,Истина,ИдентификаторГруппы);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
	Иначе
		Если ДПЗаказ_ДобавляемыйПараметрНовый(СтрокаДерева.Параметр) Тогда
			ИдентификаторДобавленнойСтроки = _ДПЗаказ_ДобавитьПараметр(СтрокаДерева.Параметр,истина);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
