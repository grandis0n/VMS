&НаКлиенте
Функция ДПГ_ДобавляемыйПараметрНовый(Параметр)
	// --- 
	
	Отбор = Новый Структура("Параметр",Параметр);
	СтрокиПараметра = Объект.ПараметрыГрузоперевозки.НайтиСтроки(Отбор);
	Возврат(СтрокиПараметра.Количество()=0);
	
	// --- 
КонецФункции
  
&НаСервере
Функция ДПГ_ТекущийРодитель()
	// --- 
	
	Если (Элементы.ДПГ.ТекущаяСтрока <> Неопределено) Тогда
		
		ИдентификаторТекущейСтроки = Элементы.ДПГ.ТекущаяСтрока;
		ТекущаяСтрока = ДПГ.НайтиПоИдентификатору(ИдентификаторТекущейСтроки);
		РодительТекущейСтроки = ТекущаяСтрока.ПолучитьРодителя();
		Если (РодительТекущейСтроки <> Неопределено) Тогда
			Возврат(РодительТекущейСтроки);
		КонецЕсли; 
		
	КонецЕсли; 
	
	Возврат(ДПГ);
	
	// --- 
КонецФункции

&НаСервере
Функция _ДПГ_ДобавитьПараметр(Параметр,ПереносПараметров=Ложь,ИдентификаторСтрокиРодителя=Неопределено)
	// --- 
	//Новый механизм
	ИдентификаторГруппыВладельца = Неопределено;
	//Новый механизм
	
	// добавляем в ТЧ параметров
	СтрокаТЧ = Объект.ПараметрыГрузоперевозки.Добавить();
	СтрокаТЧ.Параметр = Параметр;
	Если ПереносПараметров Тогда
		
		Если ИдентификаторСтрокиРодителя <> Неопределено Тогда
			ТекущаяСтрока = ДПГ.НайтиПоИдентификатору(ИдентификаторСтрокиРодителя);
			//Новый механизм
			ИдентификаторГруппыВладельца = ТекущаяСтрока.ИдентификаторГруппы;
			//Новый механизм
		Иначе
			ТекущаяСтрока = ДПГ;
		Конецесли;
		
		ТР =  ТекущаяСтрока;
	Иначе
		// добавляем в дерево
		Если (Элементы.ДПГ.ТекущаяСтрока <> Неопределено) Тогда
			ИдентификаторТекущейСтроки = Элементы.ДПГ.ТекущаяСтрока;
			ТекущаяСтрока = ДПГ.НайтиПоИдентификатору(ИдентификаторТекущейСтроки);
			Если (ТекущаяСтрока.ЭтоГруппа) Тогда
				ТР = ТекущаяСтрока;
			Иначе
				ТР = ДПГ_ТекущийРодитель();	
			КонецЕсли;
			
			//Новый механизм
			Если ТР <> ДПГ Тогда
				ИдентификаторГруппыВладельца = ТР.ИдентификаторГруппы;
			КонецЕсли;
			//Новый механизм
			
		Иначе
			ТР = ДПГ_ТекущийРодитель();	
		КонецЕсли; 
	КонецЕсли;
	
	//Новый механизм
	Если ИдентификаторГруппыВладельца <>  Неопределено Тогда
		ОтборСтрок = Новый Структура("Идентификатор",ТР.ИдентификаторГруппы);
		мСтрокиГрупп = Объект.ГруппыПараметровГрузоперевозки.НайтиСтроки(ОтборСтрок);
		Если мСтрокиГрупп.Количество() > 0 Тогда
			СтрокаГруппы = мСтрокиГрупп[0];
			СтрокаТЧ.ИдентификаторВладельца = СтрокаГруппы.ИдентификаторГруппы; 	
		КонецЕсли;
	КонецЕсли; 
	//Новый механизм
	
	СтрокаДерева = ТР.ПолучитьЭлементы().Добавить();
	// заполняем строку дерева
	НаборПравДляПараметров = CW_ПраваДоступа.НаборПравДляПараметров();
	СтруктураПрав = НаборПравДляПараметров["п_"+_сф.КлючПоСсылке(Параметр)];
	_ДПГ_ЗаполнитьСтрокуДереваПоПараметру(СтрокаДерева,Параметр,,СтруктураПрав);
	// записываем принадлежность параметра группе
	_ДПГ_ДобавитьЭлементГруппы(Параметр, _ДПГ_ОпределитьСтрокуГруппуСтрокиДерева(СтрокаДерева));
	// --- 
	
	Возврат(СтрокаДерева.ПолучитьИдентификатор());
	
	// --- 
КонецФункции

&НаСервере
Функция _ДПГ_ОпределитьСтрокуГруппуСтрокиДерева(СтрокаДерева)
	// --- 
	
	РодительСтроки = СтрокаДерева.ПолучитьРодителя();
	Если (РодительСтроки = Неопределено) Тогда
		СтрокаГруппы = Объект.ГруппыПараметровГрузоперевозки[0];
	Иначе
		Отбор = Новый Структура("Идентификатор", РодительСтроки.ИдентификаторГруппы);
		СтрокаГруппы = _сф.к_НайтиСтроку(Объект.ГруппыПараметровГрузоперевозки, Отбор);
	КонецЕсли; 
	
	Возврат(СтрокаГруппы);
	
	// --- 
КонецФункции

&НаСервере
Процедура _ДПГ_ДобавитьЭлементГруппы(Элемент, СтрокаГруппы, НовыйПредыдущий=Неопределено)
	// --- 
	
	МассивВедомых = ЗначениеИзСтрокиВнутр(СтрокаГруппы.ИдентификаторыВедомых);
	Если (НовыйПредыдущий =  Неопределено) Тогда
		МассивВедомых.Добавить(Элемент);
	Иначе
		
		ИндексПредыдущего = МассивВедомых.Найти(НовыйПредыдущий);
		Если (ИндексПредыдущего <> Неопределено) Тогда
			МассивВедомых.Вставить(ИндексПредыдущего,Элемент);
		Иначе
			МассивВедомых.Добавить(Элемент);
		КонецЕсли; 
		
	КонецЕсли; 
	СтрокаГруппы.ИдентификаторыВедомых = ЗначениеВСтрокуВнутр(МассивВедомых);
	Если (ТипЗнч(Элемент)=Тип("Число")) Тогда
		
		ДПГ_ТекущаяГруппа = Элемент;
		ДПГ_ТекущийПараметр = Неопределено;
		
	Иначе
		
		ДПГ_ТекущаяГруппа = СтрокаГруппы.Идентификатор;
		ДПГ_ТекущийПараметр = Элемент;
		
	КонецЕсли; 
	
	// --- 
КонецПроцедуры

&НаСервере
Процедура _ДПГ_ПереместитьЭлементГруппы(Элемент, СтрокаГруппы, НовыйПредыдущий);
	// --- 
	
	МассивВедомых = ЗначениеИзСтрокиВнутр(СтрокаГруппы.ИдентификаторыВедомых);
	// --- 
	Если (НовыйПредыдущий = Неопределено ) Тогда
		
		ИндексЭлемента = МассивВедомых.Найти(Элемент);
		МассивВедомых.Удалить(ИндексЭлемента);
		МассивВедомых.Добавить(Элемент);
		
	Иначе
		
		ИндесНовогоПредыдущего = МассивВедомых.Найти(НовыйПредыдущий);
		ИндексЭлемента = МассивВедомых.Найти(Элемент);
		МассивВедомых.Удалить(ИндексЭлемента);
		МассивВедомых.Вставить(ИндесНовогоПредыдущего,Элемент);
		
	КонецЕсли; 
	// --- 
	СтрокаГруппы.ИдентификаторыВедомых = ЗначениеВСтрокуВнутр(МассивВедомых);
	
	// --- 
КонецПроцедуры

&НаСервере
Процедура _ДПГ_УдалитьЭлементГруппы(Элемент, СтрокаГруппы)
	// --- 
	
	МассивВедомых = ЗначениеИзСтрокиВнутр(СтрокаГруппы.ИдентификаторыВедомых);
	МассивВедомых.Удалить(МассивВедомых.Найти(Элемент));
	СтрокаГруппы.ИдентификаторыВедомых = ЗначениеВСтрокуВнутр(МассивВедомых);
	
	// --- 
КонецПроцедуры
 
