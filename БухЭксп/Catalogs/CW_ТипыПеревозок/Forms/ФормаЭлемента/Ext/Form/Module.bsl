&НаКлиенте
Процедура ПеренестиВСоставПараметровЗаявки(Команда)
	
	
	Если ИндексСтраницыПараметров = 0 Тогда //Страница грузоперевозки
		
		ДеревоПараметров = ДПГ;
		ВыделенныеСтроки = Элементы.ДПГ.ВыделенныеСтроки;
		ИмяРеквизитаГруппыПараметров = "ГруппыПараметровГрузоперевозки";
		
	ИначеЕсли ИндексСтраницыПараметров = 2 Тогда //Страница Заказы
		
		ДеревоПараметров = ДПЗаказ;
		ВыделенныеСтроки = Элементы.ДПЗаказ.ВыделенныеСтроки;
		ИмяРеквизитаГруппыПараметров = "ГруппыПараметровЗаказа";
		
	КонецЕсли;	
	
	УдалитьСтрокиВходящиеВВыбранныеГруппы(ВыделенныеСтроки, ДеревоПараметров);
	
	Для Каждого ИдентифкаторСтроки Из ВыделенныеСтроки Цикл
		СтрокаДерева =  ДеревоПараметров.НайтиПоИдентификатору(ИдентифкаторСтроки);
		ПеренестиЭлементыВЗаявки(СтрокаДерева, ИмяРеквизитаГруппыПараметров);
	КонецЦикла;
	
	_ДПЗ_Обновить();
	ДПЗ_ВосстановитьСостояниеСвертки();
	
КонецПроцедуры

