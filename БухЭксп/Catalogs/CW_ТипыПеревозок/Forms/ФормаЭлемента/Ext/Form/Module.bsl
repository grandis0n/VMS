	// --- 
	НаборПравДляПараметров = CW_ПраваДоступа.НаборПравДляПараметров();
	СвойстваПараметров = ПолучитьИзВременногоХранилища(АдресСвойствПараметров);
	_ДПЗ_СформироватьЭлементыДерева(СтрокаГруппа,СтрокаРодителя, НаборПравДляПараметров, СвойстваПараметров);
	
	// --- 
