&НаСервере
Процедура ЗаполнитьСписокРеквизитовШапкиНаСервере()
	
	мРеквизиты = Справочники.CW_ТипыПеревозок.ПолучитьМассивДоступныхРеквизитовШапки();
	
	Для Каждого ЗначениеМассива из  мРеквизиты Цикл
		
		Отбор 	= Новый Структура("ИмяРеквизита",ЗначениеМассива.Имя);
		мСтроки = Объект.ПредопределенныеЗначенияРеквизитов.НайтиСтроки(Отбор); 

		Если мСтроки.Количество() = 0 Тогда
			НоваяСтрока = Объект.ПредопределенныеЗначенияРеквизитов.Добавить();
			НоваяСтрока.ИмяРеквизита 		= ЗначениеМассива.Имя;
			НоваяСтрока.СинонимРеквизита 	= ЗначениеМассива.Синоним;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры


