&НаКлиенте
Процедура ДПГ_ДобавитьГруппу(Команда)
	
	// спрашиваем название группы
	ПараметрыФормы = Новый Структура("НоваяГруппа,РежимГрузоперевозки,ДоступнаСменаРежимаСвертки", Истина,Истина, Истина);
	ПОВ = Новый ОписаниеОповещения("ДПГ_ОбработатьВводНаименованияГруппы",ЭтотОбъект, Новый Структура()); 
	ОткрытьФорму("ПланВидовХарактеристик.CW_ПараметрыГрузоперевозок.Форма.ФормаВиртуальнойГруппы",ПараметрыФормы,ЭтаФорма,,,,ПОВ,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ДПГ_ОбработатьВводНаименованияГруппы(Ответ, ДополнительныеПараметры) Экспорт 
	// --- 
	
	Если (Ответ <> Неопределено) Тогда
		
		Модифицированность = истина;
		РедактированиеГруппы = Ложь;
		ДополнительныеПараметры.Свойство("Редактирование",РедактированиеГруппы);
		Если (РедактированиеГруппы = Неопределено ) Тогда
			РедактированиеГруппы = Ложь;
		КонецЕсли; 
		Если (РедактированиеГруппы) Тогда
			
			ИдентификаторСтроки = _ДПГ_ОбновитьГруппу(Элементы.ДПГ.ТекущаяСтрока,Ответ);
			
		Иначе
			
			ИдентификаторСтроки = _ДПГ_ДобавитьГруппу(Ответ);	
			
		КонецЕсли;
		
		//Обнолвение пометок вышестоящий групп
		ОбновитьРаскрытиеВышеСтоящихГрупп(ИдентификаторСтроки, Ответ.ГруппаРазвернута);
		
		ИдентификаторГруппы = ДПГ.НайтипоИдентификатору(ИдентификаторСтроки).ИдентификаторГруппы;
		ДПГ_УстановитьСостояниеСверткиСтроки(ИдентификаторСтроки, ИдентификаторГруппы, Ответ.ГруппаРазвернута);
		//ДПГ_ВосстановитьСостояниеСверткиСтроки(ИдентификаторСтроки);
		
	КонецЕсли; 
	
	// --- 
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьРаскрытиеВышеСтоящихГрупп(ИдентификаторСтроки,ГруппаРазвернута)
	
	Если Не ГруппаРазвернута Тогда
		//ничего делать не нужно, свертка вышестоящией группы от этого не зависит;
		Возврат;
	КонецЕсли;
	
	СтрокаДерева = ДПГ.НайтипоИдентификатору(ИдентификаторСтроки);

	ОбработатьСверткуРодителяРекурсивно(СтрокаДерева,ГруппаРазвернута);
	
КонецПроцедуры

&наКлиенте
Процедура ОбработатьСверткуРодителяРекурсивно(СтрокаДерева, ГруппаРазвернута)
	
	РодительГруппы = СтрокаДерева.ПолучитьРодителя();
	
	Если РодительГруппы <> Неопределено Тогда
		СтруктураПараметров = новый Структура("НаименованиеГруппы,ГруппаРазвернута",РодительГруппы.НаименованиеГруппы,ГруппаРазвернута);
		
		_ДПГ_ОбновитьГруппу(РодительГруппы.ПолучитьИдентификатор(),СтруктураПараметров);
		
		ДПГ_УстановитьСостояниеСверткиСтроки(РодительГруппы.ПолучитьИдентификатор(), РодительГруппы.ИдентификаторГруппы, ГруппаРазвернута);

		ОбработатьСверткуРодителяРекурсивно(РодительГруппы, ГруппаРазвернута)
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция _ДПГ_ОбновитьГруппу(ИдентификаторСтрокиДерева,СтруктураПараметров)
	// --- 
	
	СтрокаДерева = ДПГ.НайтиПоИдентификатору(ИдентификаторСтрокиДерева);
	СтрокаГруппы = _сф.к_НайтиСтроку(Объект.ГруппыПараметровГрузоперевозки,Новый Структура("Идентификатор",СтрокаДерева.ИдентификаторГруппы));
	
	СтрокаГруппы.Наименование 			= СтруктураПараметров.НаименованиеГруппы;
	СтрокаГруппы.Раскрывать 			= СтруктураПараметров.ГруппаРазвернута;

	
	_ДПГ_ЗаполнитьСтрокуДереваПоГруппе(СтрокаДерева, СтрокаГруппы);
	
	Возврат(ИдентификаторСтрокиДерева);
	
	// --- 
КонецФункции
 
&НаСервере
Функция _ДПГ_ДобавитьГруппу(СтруктураПараметров, ИдентификаторГруппыРодителя=Неопределено)
	
	//Новый механизм
	ИдентификаторГруппыВладельца = Неопределено;
	//Новый механизм
	
	// создаем строку ТЧ
	СтрокаГруппы 						= Объект.ГруппыПараметровГрузоперевозки.Добавить();
	СтрокаГруппы.Идентификатор 			= _ДПГ_ИдентификаторНовойГруппы();
	СтрокаГруппы.Наименование 			= СтруктураПараметров.НаименованиеГруппы;
	СтрокаГруппы.Раскрывать 			= СтруктураПараметров.ГруппаРазвернута;
	СтрокаГруппы.ИдентификаторыВедомых 	= ЗначениеВСтрокуВнутр(Новый Массив);
	
	// создаем строку дерева
	Если ИдентификаторГруппыРодителя = Неопределено Тогда
		Если (Элементы.ДПГ.ТекущаяСтрока <> Неопределено) Тогда
			ИдентификаторТекущейСтроки = Элементы.ДПГ.ТекущаяСтрока;
			ТекущаяСтрока = ДПГ.НайтиПоИдентификатору(ИдентификаторТекущейСтроки);
			Если (ТекущаяСтрока.ЭтоГруппа) Тогда
				ТР = ТекущаяСтрока;
			Иначе
				ТР = ДПГ_ТекущийРодитель();	
			КонецЕсли; 
			//Новый механизм
			Если ТР <> ДПГ Тогда
				ИдентификаторГруппыВладельца = ТР.ИдентификаторГруппы;
			КонецЕсли;
			//Новый механизм
		Иначе
			ТР = ДПГ_ТекущийРодитель();	
		КонецЕсли; 
	Иначе
		ТР = ДПГ.НайтиПоИдентификатору(ИдентификаторГруппыРодителя);
		//Новый механизм
		Если ТР <> Неопределено Тогда
			ИдентификаторГруппыВладельца = ТР.ИдентификаторГруппы;
		КонецЕсли;
		//Новый механизм
	КонецЕсли;
	
	//Новый механизм
	СтрокаГруппы.ИдентификаторГруппы = Новый УникальныйИдентификатор;
	Если ИдентификаторГруппыВладельца <>  Неопределено Тогда
		ОтборСтрок = Новый Структура("Идентификатор",ИдентификаторГруппыВладельца);
		мСтрокиГрупп = Объект.ГруппыПараметровГрузоперевозки.НайтиСтроки(ОтборСтрок);
		Если мСтрокиГрупп.Количество() > 0 Тогда
			СтрокаГруппыВладельца = мСтрокиГрупп[0];
			СтрокаГруппы.ИдентификаторВладельца = СтрокаГруппыВладельца.ИдентификаторГруппы; 	
		КонецЕсли;
	КонецЕсли;
	//Новый механизм

	// --- 
	СтрокаДерева = ТР.ПолучитьЭлементы().Добавить();
	// заполняем
	_ДПГ_ЗаполнитьСтрокуДереваПоГруппе(СтрокаДерева, СтрокаГруппы);
	// добавляем в массив элементов родителя
	_ДПГ_ДобавитьЭлементГруппы(СтрокаГруппы.Идентификатор, _ДПГ_ОпределитьСтрокуГруппуСтрокиДерева(СтрокаДерева));
	// --- 
	
	
	Возврат(СтрокаДерева.ПолучитьИдентификатор());
	
	// --- 
КонецФункции

&НаСервере
Функция _ДПГ_ИдентификаторНовойГруппы()
	// --- 
	
	ТЗИ = Объект.ГруппыПараметровГрузоперевозки.Выгрузить(,"Идентификатор");
	ТЗИ.Сортировать("Идентификатор Возр");
	ПоследнийИдентификатор = _сф.к_ПоследнийЭлемент(ТЗИ).Идентификатор;
	НовыйИдентификатор = ПоследнийИдентификатор+1;
	Возврат(НовыйИдентификатор);
	
	// --- 
КонецФункции
 
#КонецОбласти 

#Область УдалениеЭлементов_Грузоперевозка 

&НаКлиенте
Процедура ДПГ_ПередУдалением(Элемент, Отказ)
	
	Отказ = Истина;
	// --- 
	Идентификатор = Элементы.ДПГ.ТекущаяСтрока;
	СтрокаДерева = ДПГ.НайтиПоИдентификатору(Идентификатор);
	// --- 
	Если (СтрокаДерева.УдалениеРазрешено) Тогда
		Модифицированность = истина;
	
		Если (СтрокаДерева.ЭтоГруппа) Тогда
			
			Если (СтрокаДерева.ПолучитьЭлементы().Количество() <> 0) Тогда
				
				ПОВ = Новый ОписаниеОповещения("ДПГ_ОбработкаПодтвержденияУдаленияГруппы",ЭтотОбъект, Новый Структура()); 
				ПоказатьВопрос(ПОВ,"Группа будет удалена вместе с параметрами. Продолжить?", РежимДиалогаВопрос.ДаНет);
				
			Иначе
				
				ДПГ_УдалитьСтрокуДерева(Идентификатор);
				
			КонецЕсли; 
			
		Иначе
			
			ДПГ_УдалитьСтрокуДерева(Идентификатор);
			
		КонецЕсли; 
		
	Иначе
		
		_УФК.ВывестиПредупреждение("Недостаточно прав для данного действия");
		Возврат;
		
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ДПГ_ОбработкаПодтвержденияУдаленияГруппы(Ответ, ДополнительныеПараметры) Экспорт 
	// --- 
	
	Если (Ответ <> Неопределено) Тогда
		
		Если (Ответ = КодВозвратаДиалога.Да) Тогда
			
			ДПГ_УдалитьСтрокуДерева(Элементы.ДПГ.ТекущаяСтрока);
			
		КонецЕсли; 
		
	КонецЕсли; 
	
	// --- 
КонецПроцедуры
  
&НаКлиенте
Процедура ДПГ_УдалитьСтрокуДерева(Идентификатор)
	// --- 
	
	НоваяТекущаяСтрока = Неопределено;
	// --- 
	СтрокаДерева = ДПГ.НайтиПоИдентификатору(Идентификатор);
	РодительСтрокиДерева = СтрокаДерева.ПолучитьРодителя();
	Если (РодительСтрокиДерева = Неопределено) Тогда
		КоллекцияСтрок = ДПГ.ПолучитьЭлементы();
	Иначе
		КоллекцияСтрок = РодительСтрокиДерева.ПолучитьЭлементы();
	КонецЕсли; 
	КоличествоЭлементовКоллекции = КоллекцияСтрок.Количество();
	Если (КоличествоЭлементовКоллекции > 1) Тогда
		
		// получаем индекс
		ИндексУдаляемойСтроки = КоллекцияСтрок.Индекс(СтрокаДерева);
		Если (ИндексУдаляемойСтроки <> КоличествоЭлементовКоллекции-1) Тогда
			НоваяТекущаяСтрока = КоллекцияСтрок[ИндексУдаляемойСтроки+1].ПолучитьИдентификатор();
		Иначе 
			НоваяТекущаяСтрока = КоллекцияСтрок[ИндексУдаляемойСтроки-1].ПолучитьИдентификатор();
		КонецЕсли; 
		
	Иначе
		
		Если (РодительСтрокиДерева <> Неопределено) Тогда
			
			НоваяТекущаяСтрока = РодительСтрокиДерева.ПолучитьИдентификатор();
			
		КонецЕсли; 
		
	КонецЕсли; 
	
	// удаляем рекурсивно группы/параметры
	Результат = _ДПГ_УдалитьПараметрыРекурсивно(Идентификатор);
	Если (_УФКС.ВыполненоУспешно(Результат)) Тогда
		
		// удаляем строку дерева
		_ДПГ_УдалитьСтрокуДерева(Идентификатор);
		
		Если (НоваяТекущаяСтрока <> Неопределено ) Тогда
			
			Элементы.ДПГ.ТекущаяСтрока = НоваяТекущаяСтрока;
			
		КонецЕсли; 
		
	КонецЕсли; 
	
	// --- 
КонецПроцедуры

&НаСервере
Функция _ДПГ_УдалитьПараметрыРекурсивно(ИдентификаторСтроки)
	// --- 
	
	СтрокаДерева = ДПГ.НайтиПоИдентификатору(ИдентификаторСтроки);
	Если (СтрокаДерева.ЭтоГруппа) Тогда
		ЭлементДПГ = СтрокаДерева.ИдентификаторГруппы;
	Иначе
		ЭлементДПГ = СтрокаДерева.Параметр;
	КонецЕсли; 
	
	// удаляем из родителя
	РодительСтрокиДерева = СтрокаДерева.ПолучитьРодителя();
	Если (РодительСтрокиДерева = Неопределено) Тогда
		СтрокаГруппы = Объект.ГруппыПараметровГрузоперевозки[0];
	Иначе
		СтрокаГруппы = _сф.к_НайтиСтроку(Объект.ГруппыПараметровГрузоперевозки,Новый Структура("Идентификатор", РодительСтрокиДерева.ИдентификаторГруппы));
	КонецЕсли; 
	_ДПГ_УдалитьЭлементГруппы(ЭлементДПГ, СтрокаГруппы);
	
	// физически удаляем
	_ДПГ_УдалитьЭлементДПГ(ЭлементДПГ);
	// --- 
	Возврат(_УФКС.Ответ());
	
	// --- 
КонецФункции

&НаСервере
Процедура _ДПГ_УдалитьЭлементДПГ(ЭлементДПГ)
	// --- 
	
	Если (ТипЗнч(ЭлементДПГ)=Тип("Число")) Тогда
		
		СтрокаГруппы = _сф.к_НайтиСтроку(Объект.ГруппыПараметровГрузоперевозки,Новый Структура("Идентификатор", ЭлементДПГ));
		МассивВедомых = ЗначениеИзСтрокиВнутр(СтрокаГруппы.ИдентификаторыВедомых);
		Для каждого Ведомый Из МассивВедомых Цикл
			
			_ДПГ_УдалитьЭлементДПГ(Ведомый);
			
		КонецЦикла; 
		// --- 
		Объект.ГруппыПараметровГрузоперевозки.Удалить(Объект.ГруппыПараметровГрузоперевозки.Индекс(СтрокаГруппы));
		
	Иначе
		
		СтрокаПараметра = _сф.к_НайтиСтроку(Объект.ПараметрыГрузоперевозки,Новый Структура("Параметр",ЭлементДПГ));
		Объект.ПараметрыГрузоперевозки.Удалить(Объект.ПараметрыГрузоперевозки.Индекс(СтрокаПараметра));
		
	КонецЕсли; 
	
	// --- 
КонецПроцедуры
 

#КонецОбласти 

#Область ПеремещениеЭлементов_Грузоперевозка

&НаКлиенте
Процедура ДПГ_ПереместитьВверх(Команда)
	
	ДПГ_СдвинутьСтроку(-1);
	
КонецПроцедуры

&НаКлиенте
Процедура ДПГ_ПереместитьВниз(Команда)
	
	ДПГ_СдвинутьСтроку(1);
	
КонецПроцедуры

&НаКлиенте
Процедура ДПГ_СдвинутьСтроку(Направление)
	// --- 
	
	ТекущаяСтрока = Элементы.ДПГ.ТекущаяСтрока;
	СтрокаДерева = ДПГ.НайтиПоИдентификатору(ТекущаяСтрока);
	РодительТекущейСтроки = СтрокаДерева.ПолучитьРодителя();
	Если (РодительТекущейСтроки = Неопределено) Тогда
		РодительТекущейСтроки = ДПГ;
		ГруппаРодитель = 0;
	Иначе
		ГруппаРодитель = РодительТекущейСтроки.ИдентификаторГруппы;	
	КонецЕсли; 
	// --- 
	КоллекцияСтрок = РодительТекущейСтроки.ПолучитьЭлементы();
	КоличествоСтрок = КоллекцияСтрок.Количество();
	Если (КоличествоСтрок = 1) Тогда
		Возврат;
	КонецЕсли; 
	ИндексТекущейСтроки = КоллекцияСтрок.Индекс(СтрокаДерева);
	// --- 
	// проверяем крайние положения
	// если уперлись - переносим в конец/начало
	Сдвиг = 0;
	ПредыдущееДействие = Неопределено;
	СледующееДействие = Неопределено;
	// --- 
	Если (ИндексТекущейСтроки = 0 И Направление=-1) Тогда
		
		Сдвиг = КоличествоСтрок-1; // с плюсом;
		ПредыдущаяСтрока = КоллекцияСтрок.Получить(КоличествоСтрок-1);
		Если (ПредыдущаяСтрока.ЭтоГруппа) Тогда
			ИдентификаторПредыдущейСтроки = ПредыдущаяСтрока.ИдентификаторГруппы;
		Иначе
			ИдентификаторПредыдущейСтроки = ПредыдущаяСтрока.Параметр;
		КонецЕсли; 
		
	ИначеЕсли (ИндексТекущейСтроки <> 0 И Направление=-1) Тогда 
		
		Сдвиг = -1;
		СледующаяСтрока = КоллекцияСтрок.Получить(ИндексТекущейСтроки+Сдвиг);
		Если (СледующаяСтрока.ЭтоГруппа) Тогда
			ИдентификаторСледующейСтроки = СледующаяСтрока.ИдентификаторГруппы;
		Иначе
			ИдентификаторСледующейСтроки = СледующаяСтрока.Параметр;
		КонецЕсли;
		
	ИначеЕсли (ИндексТекущейСтроки = КоличествоСтрок-1 И Направление=1) Тогда 
		
		 Сдвиг = -(КоличествоСтрок-1);
		 СледующаяСтрока = КоллекцияСтрок.Получить(0);
		 Если (СледующаяСтрока.ЭтоГруппа) Тогда
			ИдентификаторСледующейСтроки = СледующаяСтрока.ИдентификаторГруппы;
		Иначе
			ИдентификаторСледующейСтроки = СледующаяСтрока.Параметр;
		КонецЕсли;
		 
	ИначеЕсли (ИндексТекущейСтроки <> КоличествоСтрок-1 И Направление=1) Тогда 
		
		 Сдвиг = 1;
		 ПредыдущаяСтрока = КоллекцияСтрок.Получить(ИндексТекущейСтроки+Сдвиг);
		 Если (ПредыдущаяСтрока.ЭтоГруппа) Тогда
			ИдентификаторПредыдущейСтроки = ПредыдущаяСтрока.ИдентификаторГруппы;
		Иначе
			ИдентификаторПредыдущейСтроки = ПредыдущаяСтрока.Параметр;
		КонецЕсли; 
		
	КонецЕсли; 
	
	Ответ = _ДПГ_ИзменитьПорядокСтроки(ГруппаРодитель, ТекущаяСтрока, ИдентификаторПредыдущейСтроки, ИдентификаторСледующейСтроки);
	Если (_УФКС.ВыполненоУспешно(Ответ)) Тогда
		
		КоллекцияСтрок.Сдвинуть(КоллекцияСтрок.Индекс(СтрокаДерева),Сдвиг);
		
	Иначе
		
		Сообщить(_УФКС.ПредставлениеОшибки(Ответ));
		
	КонецЕсли; 
	
	// --- 
КонецПроцедуры

&НаСервере
Функция _ДПГ_ИзменитьПорядокСтроки(ИдентификаторГруппыРодителя, ИдентификаторТекущейСтроки, ИдентификаторПредыдущейСтроки, ИдентификаторСледующейСтроки)
	// --- 
	
	Попытка
		
		Группа = _сф.к_НайтиСтроку(Объект.ГруппыПараметровГрузоперевозки,Новый Структура("Идентификатор",ИдентификаторГруппыРодителя));
		МассивЭлементов = ЗначениеИзСтрокиВнутр(Группа.ИдентификаторыВедомых);
		ТаблицаЭлементов = Новый ТаблицаЗначений;
		ТаблицаЭлементов.Колонки.Добавить("Идентификатор");
		Для каждого Элемент Из МассивЭлементов Цикл
			Нстр = ТаблицаЭлементов.Добавить();
			Нстр.Идентификатор = Элемент;
		КонецЦикла; 
		СтрокаДерева = ДПГ.НайтиПоИдентификатору(ИдентификаторТекущейСтроки);
		Если (СтрокаДерева.ЭтоГруппа) Тогда
			СдвигаемоеЗначение = СтрокаДерева.ИдентификаторГруппы;
		Иначе
			СдвигаемоеЗначение = СтрокаДерева.Параметр;
		КонецЕсли; 
		СтрокаСдвигаемогоЗначения = _сф.к_НайтиСтроку(ТаблицаЭлементов, Новый Структура("Идентификатор",СдвигаемоеЗначение));
		// --- 
		Если (ИдентификаторПредыдущейСтроки <> Неопределено) Тогда
			
			ОтносительноеЗначение = ИдентификаторПредыдущейСтроки;
			//СтрокаДействия = _сф.к_НайтиСтроку(ТЧ, Новый Структура("Действие",ПредыдущееДействие));
			
		ИначеЕсли (ИдентификаторСледующейСтроки <> Неопределено) Тогда 
			
			ОтносительноеЗначение = ИдентификаторСледующейСтроки;
			
		КонецЕсли; 
		СтрокаОтносительногоЗначения = _сф.к_НайтиСтроку(ТаблицаЭлементов, Новый Структура("Идентификатор",ОтносительноеЗначение));
		Сдвиг = (ТаблицаЭлементов.Индекс(СтрокаОтносительногоЗначения)-ТаблицаЭлементов.Индекс(СтрокаСдвигаемогоЗначения));
		ТаблицаЭлементов.Сдвинуть(СтрокаСдвигаемогоЗначения,Сдвиг);
		// --- 
		МассивЭлементов=ТаблицаЭлементов.ВыгрузитьКолонку("Идентификатор");
		Группа.ИдентификаторыВедомых = ЗначениеВСтрокуВнутр(МассивЭлементов);
		
		
	Исключение
		Возврат(_УФКС.Ответ(1,ОписаниеОшибки()));
	КонецПопытки; 
	
	Возврат(_УФКС.Ответ());
	
	// --- 
КонецФункции
 
#КонецОбласти 

#Область ДрагЭндДроп_Грузоперевозка

&НаКлиенте
Процедура ДПГ_НачалоПеретаскивания(Элемент, ПараметрыПеретаскивания, Выполнение)
	
	Если (Элементы.ДПГ.ВыделенныеСтроки.Количество() > 1) Тогда
		
		Выполнение = Ложь;
		ПоказатьПредупреждение(,"Множественное перетаскивание недоступно.");
		Возврат;
		
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ДПГ_Перетаскивание(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Строка, Поле)
	
	СтандартнаяОбработка=Ложь;
	// --- 
	
	// проверим, что действие, в которое мы вставляем не находится ниже по иерархии вставляемого действия
	// сформируем массив действий по иерархии от текущего вверх
	МассивСтрок = Новый Массив;
	ИдентификаторТекущейСтроки = Строка;
	МассивИдентификаторов = ПараметрыПеретаскивания.Значение;
	Если (ИдентификаторТекущейСтроки = Неопределено) Тогда
		
		НовыйРодитель = 0;
		НовыйПредыдущий = Неопределено;
		ВставкаРазрешена = Истина;
		
	Иначе
		
		СтрокаДерева = ДПГ.НайтиПоИдентификатору(ИдентификаторТекущейСтроки);
		Если (СтрокаДерева.ЭтоГруппа) Тогда
			МассивСтрок.Добавить(СтрокаДерева.ИдентификаторГруппы);	
			НовыйРодитель = СтрокаДерева.ИдентификаторГруппы;
			НовыйПредыдущий = Неопределено;
		Иначе
			НовыйПредыдущий = СтрокаДерева.Параметр;
			НовыйРодительСтрока = СтрокаДерева.ПолучитьРодителя();
			Если (НовыйРодительСтрока <>  Неопределено) Тогда
				НовыйРодитель = НовыйРодительСтрока.ИдентификаторГруппы;
			Иначе
				НовыйРодитель = 0;
			КонецЕсли; 
		КонецЕсли; 
		
		РодительСтроки = СтрокаДерева.ПолучитьРодителя();
		Пока (РодительСтроки <> Неопределено) Цикл
			
			// всегда группа
			МассивСтрок.Добавить(РодительСтроки.ИдентификаторГруппы);
			РодительСтроки = РодительСтроки.ПолучитьРодителя();
			
		КонецЦикла; 
		// ---
		МассивПеремещаемыхСтрок = Новый Массив;
		Для каждого Идентификатор Из МассивИдентификаторов Цикл
			ПеремещаемаяСтрокаДерева = ДПГ.НайтиПоИдентификатору(Идентификатор);
			Если (ПеремещаемаяСтрокаДерева.ЭтоГруппа) Тогда
				МассивПеремещаемыхСтрок.Добавить(ПеремещаемаяСтрокаДерева.ИдентификаторГруппы);
			Иначе
				МассивПеремещаемыхСтрок.Добавить(ПеремещаемаяСтрокаДерева.Параметр);	
			КонецЕсли; 
		КонецЦикла; 
		// --- 
		ВставкаРазрешена = Истина;
		Для каждого ПеремещаемаяСтрока Из МассивПеремещаемыхСтрок Цикл
			
			Если (МассивСтрок.Найти(ПеремещаемаяСтрока) <> Неопределено) Тогда
				
				ВставкаРазрешена = Ложь;
				Прервать;
				
			КонецЕсли; 
			
		КонецЦикла; 
		
	КонецЕсли; 
	Если (НЕ ВставкаРазрешена) Тогда
		
		ПоказатьПредупреждение(,"Вставка в иерархию с нарушением логической целостности.");
		Возврат;
		
	КонецЕсли; 
	
	// ---------------------------------------------------------------------------- 
	Ответ = _ДПГ_ВыполнитьПеремещениеСтрок(МассивИдентификаторов, НовыйРодитель,НовыйПредыдущий);
	Если (_УФКС.ВыполненоУспешно(Ответ)) Тогда
		
		Модифицированность = истина;

		// удаляем вставляемые действия
		Для каждого Идентификатор Из МассивИдентификаторов Цикл
			
			_ДПГ_УдалитьСтрокуДерева(Идентификатор);
			
		КонецЦикла; 
		
		Если (ИдентификаторТекущейСтроки = Неопределено) Тогда
			
			ПолноеОбновление = Истина;
			_ДПГ_Обновить();
			ДПГ_ВосстановитьСостояниеСвертки();
			
		Иначе
			
			// переформировываем элементы текущего действия
			ПолноеОбновление = Ложь;
			СтрокаДерева = ДПГ.НайтиПоИдентификатору(Строка);
			Если (СтрокаДерева.ЭтоГруппа) Тогда
				
				ТекущаяСтрока = Строка;
				ДПГ_ВыполнитьПодгрузкуСтрок(ТекущаяСтрока);
				
			Иначе
				
				СтрокаРодителя = СтрокаДерева.ПолучитьРодителя();
				Если (СтрокаРодителя = Неопределено) Тогда
					
					// обновить все
					// тут бы процедуру анализа новых ... TODO
					ПолноеОбновление = Истина;
					_ДПГ_Обновить();
					ДПГ_ВосстановитьСостояниеСвертки();
					
				Иначе
					
					ТекущаяСтрока = СтрокаРодителя.ПолучитьИдентификатор();
					ДПГ_ВыполнитьПодгрузкуСтрок(ТекущаяСтрока);
					
				КонецЕсли; 
				
			КонецЕсли; 
			
			
		КонецЕсли; 
		
	Иначе
		
		ПоказатьПредупреждение(,_УФКС.ПредставлениеОшибки(Ответ));
		
	КонецЕсли; 
	
КонецПроцедуры

&НаСервере
Функция _ДПГ_ВыполнитьПеремещениеСтрок(МассивИдентификаторовСтрок, НовыйРодитель, НовыйПредыдущий=Неопределено)
	// --- 
	
	Попытка
		
		Для каждого ИдентификаторСтроки Из МассивИдентификаторовСтрок Цикл
			
			Результат = _ДПГ_УстановитьРодителяСтроки(ИдентификаторСтроки, НовыйРодитель, НовыйПредыдущий);
			Если (НЕ _УФКС.ВыполненоУспешно(Результат)) Тогда
				
				Возврат(_УФКС.Ответ(1,_УФКС.ПредставлениеОшибки(Результат)));
				
			КонецЕсли; 
			
		КонецЦикла; 
		
	Исключение
	    Сообщить(ОписаниеОшибки());
	КонецПопытки; 
	
	Возврат(_УФКС.Ответ());
	
	// --- 
КонецФункции

&НаСервере
Функция _ДПГ_УстановитьРодителяСтроки(ИдентификаторСтроки, НовыйРодитель, НовыйПредыдущий=Неопределено)
	// --- 
	
	Строка = ДПГ.НайтиПоИдентификатору(ИдентификаторСтроки);
	Если (Строка.ЭтоГруппа) Тогда
		ПеремещаемоеЗначение = Строка.ИдентификаторГруппы;
	Иначе
		ПеремещаемоеЗначение = Строка.Параметр;
	КонецЕсли; 
	
	// --- 
	
	ГруппаСтарыйРодитель = _ДПГ_ОпределитьСтрокуГруппуСтрокиДерева(Строка);
	ГруппаНовыйРодитель = _сф.к_НайтиСтроку(Объект.ГруппыПараметровГрузоперевозки,Новый Структура("Идентификатор",НовыйРодитель));
	
	Если (ГруппаСтарыйРодитель.Идентификатор <> НовыйРодитель) Тогда
		
		Попытка
			
			// удаляем из старого родителя
			_ДПГ_УдалитьЭлементГруппы(ПеремещаемоеЗначение, ГруппаСтарыйРодитель);
			
			// добавляем в новый
			_ДПГ_ДобавитьЭлементГруппы(ПеремещаемоеЗначение, ГруппаНовыйРодитель, НовыйПредыдущий);
			
			//Новый механизм
			_ДПГ_УстановитьНовогоВладельца(ИдентификаторСтроки,ГруппаНовыйРодитель.ИдентификаторГруппы);
			//Новый механизм
	
		Исключение
			
			ТекстОшибки = ОписаниеОшибки();
			Сообщить(ТекстОшибки);
			// --- 
			Возврат(_УФКС.Ответ(1,ТекстОшибки));
			
		КонецПопытки; 
		
	Иначе
		
		// перемещение в пределах родителя
		_ДПГ_ПереместитьЭлементГруппы(ПеремещаемоеЗначение, ГруппаНовыйРодитель, НовыйПредыдущий);
		
	КонецЕсли; 
	
	Возврат(_УФКС.Ответ());
	
	// --- 
КонецФункции

//Новый механизм
&наСервере
Процедура _ДПГ_УстановитьНовогоВладельца(ИдентификаторСтроки, ИдентификаторГруппы)
	
	ИдентификаторВладельца = ИдентификаторГруппы;
	
	Строка = ДПГ.НайтиПоИдентификатору(ИдентификаторСтроки);
	Если Строка.ЭтоГруппа Тогда
		мСтроки = Объект.ГруппыПараметровГрузоперевозки.НайтиСтроки(Новый Структура("Идентификатор",Строка.ИдентификаторГруппы));
		Если мСтроки.Количество() > 0 Тогда
			СтрокаДанных = мСтроки[0];	
		КонецЕсли;
		Если СтрокаДанных.ИдентификаторГруппы = ИдентификаторГруппы Тогда
			ИдентификаторВладельца = Неопределено;
		КонецЕсли;
	Иначе
		мСтроки = Объект.ПараметрыГрузоперевозки.НайтиСтроки(Новый Структура("Параметр",Строка.Параметр));
		Если мСтроки.Количество() > 0 Тогда
			СтрокаДанных = мСтроки[0];	
		КонецЕсли;
	КонецЕсли; 
	
	СтрокаДанных.ИдентификаторВладельца = ИдентификаторВладельца;
	
КонецПроцедуры
//Новый механизм

&НаСервере
Процедура _ДПГ_УдалитьСтрокуДерева(ИдентификаторСтроки)
	// --- 
	
	СтрокаДерева = ДПГ.НайтиПоИдентификатору(ИдентификаторСтроки);
	РодительСтрокиДерева = СтрокаДерева.ПолучитьРодителя();
	Если (РодительСтрокиДерева = Неопределено) Тогда
		РодительСтрокиДерева = ДПГ;
	КонецЕсли; 
	РодительСтрокиДерева.ПолучитьЭлементы().Удалить(СтрокаДерева);
	
	// --- 
КонецПроцедуры

#КонецОбласти 

#Область Копипаста_Грузоперевозка

&НаКлиенте
Процедура ДПГ_ПереместитьНаУровеньВверх(Команда)
	
	ИдентификаторТекущейСтроки = Элементы.ДПГ.ТекущаяСтрока;
	ТекущаяСтрока = ДПГ.НайтиПоИдентификатору(ИдентификаторТекущейСтроки);
	РодительСтроки = ТекущаяСтрока.ПолучитьРодителя();
	Если (РодительСтроки <> Неопределено) Тогда
		
		РодительРодителя = РодительСтроки.ПолучитьРодителя();
		НовыйРодитель = ТекущаяСтрока.ИдентификаторГруппы;
		
		// --- 
		МассивИдентификаторов = Новый Массив;
		МассивИдентификаторов.Добавить(ИдентификаторТекущейСтроки);
		Ответ = _ДПГ_ВыполнитьПеремещениеСтрок(МассивИдентификаторов, НовыйРодитель);
		Если (_УФКС.ВыполненоУспешно(Ответ)) Тогда
			
			// удаляем вставляемые действия
			Для каждого Идентификатор Из МассивИдентификаторов Цикл
				
				_ДПГ_УдалитьСтрокуДерева(Идентификатор);
				
			КонецЦикла; 
			
			// переформировываем элементы текущего действия
			ПолноеОбновление = Ложь;
			Если (РодительРодителя = Неопределено) Тогда
				
				ПолноеОбновление = Истина;
				_ДПГ_Обновить();
				ДПГ_ВосстановитьСостояниеСвертки();
				
			Иначе
				
				ДПГ_ВыполнитьПодгрузкуСтрок(РодительРодителя);
				
			КонецЕсли; 
						
		Иначе
			
			ПоказатьПредупреждение(,_УФКС.ПредставлениеОшибки(Ответ));
			
		КонецЕсли; 
		// --- 
		
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ДПГ_Строка_Вырезать(Команда)
	
	// снимаем признак нахождения в буфере
	Для каждого Стр Из ДПГ_БуферОбмена Цикл
		ИдентификаторСтроки = Число(Стр.Представление);
		СтрокаДерева = ДПГ.НайтиПоИдентификатору(ИдентификаторСтроки);
		Если (СтрокаДерева <> Неопределено) Тогда
			СтрокаДерева.Буфер = Ложь;
		КонецЕсли; 
	КонецЦикла; 
	ДПГ_БуферОбмена.Очистить();
	// --- 
	Для каждого Стр Из Элементы.ДПГ.ВыделенныеСтроки Цикл
		
		ВыделеннаяСтрока = ДПГ.НайтиПоИдентификатору(Стр);
		ВыделеннаяСтрока.Буфер = Истина;
		Если (ВыделеннаяСтрока.ЭтоГруппа) Тогда
			ДПГ_БуферОбмена.Добавить(ВыделеннаяСтрока.ИдентификаторГруппы, Формат(Стр,"ЧДЦ=; ЧН=; ЧГ="));
		Иначе
			ДПГ_БуферОбмена.Добавить(ВыделеннаяСтрока.Параметр, Формат(Стр,"ЧДЦ=; ЧН=; ЧГ="));	
		КонецЕсли; 
		
	КонецЦикла; 
	
КонецПроцедуры

&НаКлиенте
Процедура ДПГ_Строка_Вставить(Команда)
	
	МассивСтрок = Новый Массив;
	ИдентификаторТекущейСтроки = Элементы.ДПГ.ТекущаяСтрока;
	// --- 
	СтрокаДерева = ДПГ.НайтиПоИдентификатору(ИдентификаторТекущейСтроки);
	Если (СтрокаДерева.ЭтоГруппа) Тогда
		МассивСтрок.Добавить(СтрокаДерева.ИдентификаторГруппы);	
		НовыйРодитель = СтрокаДерева.ИдентификаторГруппы;
		НовыйПредыдущий = Неопределено;
	Иначе
		НовыйПредыдущий = СтрокаДерева.Параметр;
		НовыйРодительСтрока = СтрокаДерева.ПолучитьРодителя();
		Если (НовыйРодительСтрока <>  Неопределено) Тогда
			НовыйРодитель = НовыйРодительСтрока.ИдентификаторГруппы;
		Иначе
			НовыйРодитель = 0;
		КонецЕсли; 
	КонецЕсли; 
	
	РодительСтроки = СтрокаДерева.ПолучитьРодителя();
	Пока (РодительСтроки <> Неопределено) Цикл
		
		// всегда группа
		МассивСтрок.Добавить(РодительСтроки.ИдентификаторГруппы);
		РодительСтроки = РодительСтроки.ПолучитьРодителя();
		
	КонецЦикла; 
	// ---
	МассивПеремещаемыхСтрок = ДПГ_БуферОбмена.ВыгрузитьЗначения();
	// --- 
	ВставкаРазрешена = Истина;
	Для каждого ПеремещаемаяСтрока Из МассивПеремещаемыхСтрок Цикл
		
		Если (МассивСтрок.Найти(ПеремещаемаяСтрока) <> Неопределено) Тогда
			
			ВставкаРазрешена = Ложь;
			Прервать;
			
		КонецЕсли; 
		
	КонецЦикла; 
	// --- 
	Если (НЕ ВставкаРазрешена) Тогда
		
		ПоказатьПредупреждение(,"Вставка в иерархию с нарушением логической целостности.");
		Возврат;
		
	КонецЕсли; 
	
	// ---------------------------------------------------------------------------- 
	МассивИдентификаторов = Новый Массив;
	Для каждого ЭлементБуфера Из ДПГ_БуферОбмена Цикл
		
		МассивИдентификаторов.Добавить(Число(ЭлементБуфера.Представление));
		
	КонецЦикла; 
	// --- 
	Ответ = _ДПГ_ВыполнитьПеремещениеСтрок(МассивИдентификаторов, НовыйРодитель,НовыйПредыдущий);
	Если (_УФКС.ВыполненоУспешно(Ответ)) Тогда
		
		// удаляем вставляемые действия
		Для каждого Идентификатор Из МассивИдентификаторов Цикл
			
			_ДПГ_УдалитьСтрокуДерева(Идентификатор);
			
		КонецЦикла; 
		
		// очищаем буфер
		ДПГ_БуферОбмена.Очистить();
		
		// переформировываем элементы текущего действия
		ПолноеОбновление = Ложь;
		СтрокаДерева = ДПГ.НайтиПоИдентификатору(ИдентификаторТекущейСтроки);
		Если (СтрокаДерева.ЭтоГруппа) Тогда
			
			ТекущаяСтрока = ИдентификаторТекущейСтроки;
			ДПГ_ВыполнитьПодгрузкуСтрок(ТекущаяСтрока);
			
		Иначе
			
			СтрокаРодителя = СтрокаДерева.ПолучитьРодителя();
			Если (СтрокаРодителя = Неопределено) Тогда
				
				// обновить все
				// тут бы процедуру анализа новых ... TODO
				ПолноеОбновление = Истина;
				_ДПГ_Обновить();
				ДПГ_ВосстановитьСостояниеСвертки();
				
			Иначе
				
				ТекущаяСтрока = СтрокаРодителя.ПолучитьИдентификатор();
				ДПГ_ВыполнитьПодгрузкуСтрок(ТекущаяСтрока);
				
			КонецЕсли; 
			
		КонецЕсли; 
		
		
	Иначе
		
		ПоказатьПредупреждение(,_УФКС.ПредставлениеОшибки(Ответ));
		
	КонецЕсли; 
	
КонецПроцедуры

#КонецОбласти 

// ---------------------------------------------------------------------------- 

#Область ФормированиеДерева_Заявка 

&НаКлиенте
Процедура ДПЗ_Обновить()
	// --- 
	
	_ДПЗ_Обновить();
	ДПЗ_ВосстановитьСостояниеСвертки();
	
	// --- 
КонецПроцедуры

&НаСервере
Процедура _ДПЗ_Обновить()
	// --- 
	
	// получаем текущие группы 		
	Элементы.ДПЗ.НачальноеОтображениеДерева=НачальноеОтображениеДерева.НеРаскрывать;
	ДПЗ.ПолучитьЭлементы().Очистить();
	// ---------------------------------------------------------------------------- 
	Если (Объект.ГруппыПараметровЗаявки.Количество()=0) Тогда
		Корень = Объект.ГруппыПараметровЗаявки.Добавить();
		Корень.ИдентификаторыВедомых = ЗначениеВСтрокуВнутр(Новый Массив);
	Иначе
		Корень = Объект.ГруппыПараметровЗаявки[0];	
	КонецЕсли; 
	Если (НЕ Корень.Раскрывать) Тогда
		Корень.Раскрывать = Истина;
	КонецЕсли; 
	// --- 
	НаборПравДляПараметров = CW_ПраваДоступа.НаборПравДляПараметров();
	СвойстваПараметров = ПолучитьИзВременногоХранилища(АдресСвойствПараметров);
	// --- 
	ТаблицаКонтроляГрупп = _ДПЗ_ТаблицаКонтроляГрупп();
	ТаблицаКонтроляПараметров = _ДПЗ_ТаблицаКонтроляПараметров(НаборПравДляПараметров);
	// --- 
	_ДПЗ_СформироватьЭлементыДерева(Корень,Неопределено,НаборПравДляПараметров,СвойстваПараметров, ТаблицаКонтроляГрупп, ТаблицаКонтроляПараметров);
	
	// после формирования проверяем, нет ли потерянных групп, 
	// если есть, то засовываем их в корень и переформировываем дерево
	// сообщаем о потерянных группах
	
	МассивНеучтенныхГрупп = _сф.к_НайтиСтроки(ТаблицаКонтроляГрупп,Новый Структура("Видимость",Ложь));
	Если (МассивНеучтенныхГрупп.Количество() <> 0) Тогда
		
		// переносим каждую в корень
		Для каждого КонтрольнаяСтрокаГруппы Из МассивНеучтенныхГрупп Цикл
			
			_ДПЗ_ДобавитьЭлементГруппы(КонтрольнаяСтрокаГруппы.Идентификатор, Корень);
			
		КонецЦикла; 
		// --- 
		// переформировываем дерево
		ТаблицаКонтроляГрупп = _ДПЗ_ТаблицаКонтроляГрупп();
		ТаблицаКонтроляПараметров = _ДПЗ_ТаблицаКонтроляПараметров(НаборПравДляПараметров);
		_ДПЗ_СформироватьЭлементыДерева(Корень,Неопределено,НаборПравДляПараметров,СвойстваПараметров, ТаблицаКонтроляГрупп, ТаблицаКонтроляПараметров);
		// --- 
		ДПЗ_ТекущаяГруппа=0;
		ДПЗ_ТекущийПараметр = Неопределено;
		
	КонецЕсли; 
	
	// далее проверяем, нет ли потерянных/новых параметров, если есть
	// то добавляем их в корень и снова переформировываем дерево
	
	МассивНеучтенныхПараметров = _сф.к_НайтиСтроки(ТаблицаКонтроляПараметров,Новый Структура("Видимость",Ложь));
	Если (МассивНеучтенныхПараметров.Количество() <> 0) Тогда
		
		// переносим каждую в корень
		Для каждого КонтрольнаяСтрокаПараметра Из МассивНеучтенныхПараметров Цикл
			
			_ДПЗ_ДобавитьЭлементГруппы(КонтрольнаяСтрокаПараметра.Параметр, Корень);
			
		КонецЦикла; 
		// переформировываем дерево
		ТаблицаКонтроляГрупп = _ДПЗ_ТаблицаКонтроляГрупп();
		ТаблицаКонтроляПараметров = _ДПЗ_ТаблицаКонтроляПараметров(НаборПравДляПараметров);
		_ДПЗ_СформироватьЭлементыДерева(Корень,Неопределено,НаборПравДляПараметров,СвойстваПараметров, ТаблицаКонтроляГрупп, ТаблицаКонтроляПараметров);
		// --- 
		ДПЗ_ТекущаяГруппа=0;
		ДПЗ_ТекущийПараметр = Неопределено;
		
	КонецЕсли; 
	
	// --- 
КонецПроцедуры

&НаСервере
Функция _ДПЗ_ТаблицаКонтроляГрупп()
	// --- 
	
	ТаблицаКонтроляГрупп = Объект.ГруппыПараметровЗаявки.Выгрузить();
	ТаблицаКонтроляГрупп.Колонки.Добавить("Видимость");
	ТаблицаКонтроляГрупп.ЗаполнитьЗначения(Ложь,"Видимость");
	СтрокаКорня = _сф.к_ПервыйЭлемент(ТаблицаКонтроляГрупп);
	СтрокаКорня.Видимость = Истина;
	// --- 
	Возврат(ТаблицаКонтроляГрупп);
	
	// --- 
КонецФункции

&НаСервере
Функция _ДПЗ_ТаблицаКонтроляПараметров(НаборПрав)
	// --- 
	
	ТаблицаКонтроляПараметров = Объект.ПараметрыЗаявки.Выгрузить();
	// --- 
	ТаблицаКонтроляПараметров.Колонки.Добавить("Видимость");
	ТаблицаКонтроляПараметров.ЗаполнитьЗначения(Ложь,"Видимость");
	// --- 
	МассивУдаляемыхСтрок = Новый Массив;
	Для каждого СтрокаКонтроля Из ТаблицаКонтроляПараметров Цикл
		
		СтруктураПрав = НаборПрав["п_"+_сф.КлючПоСсылке(СтрокаКонтроля.Параметр)];
		Если (НЕ СтруктураПрав.Просмотр) Тогда
			
			МассивУдаляемыхСтрок.Добавить(СтрокаКонтроля);
			
		КонецЕсли;
		
	КонецЦикла; 
	_сф.к_УдалитьЭлементыПоМассиву(ТаблицаКонтроляПараметров, МассивУдаляемыхСтрок);
	// --- 
	Возврат(ТаблицаКонтроляПараметров);
	
	// --- 
КонецФункции

&НаСервере
Функция _ДПЗ_СформироватьЭлементыДерева(Группа,СтрокаДерева = Неопределено, НаборПрав, Свойства, ТаблицаКонтроляГрупп=Неопределено, ТаблицаКонтроляПараметров=Неопределено)
	// --- 
	
	Если (СтрокаДерева <> Неопределено) Тогда
		КоллекцияЭлементовДерева = СтрокаДерева.ПолучитьЭлементы();
	Иначе
		КоллекцияЭлементовДерева = ДПЗ.ПолучитьЭлементы();		
	КонецЕсли; 
	КоллекцияЭлементовДерева.Очистить();
	// --- 
	
	МассивПодчиненныхЭлементов = ЗначениеИзСтрокиВнутр(Группа.ИдентификаторыВедомых);
	МассивИдентификаторовДляУдаления = Новый Массив;
	Для каждого ПодчиненныйЭлемент Из МассивПодчиненныхЭлементов Цикл
		
		Если ТипЗнч(ПодчиненныйЭлемент) = Тип("ПланВидовХарактеристикСсылка.CW_ПараметрыГрузоперевозок") Тогда  
			ПодчиненныйЭлементОбъект = ПодчиненныйЭлемент.ПолучитьОбъект();
			Если ПодчиненныйЭлементОбъект = Неопределено Тогда
				Продолжить;
			КонецЕсли;                                                                                            
		Конецесли;

		ЭтоГруппа = (ТипЗнч(ПодчиненныйЭлемент)=Тип("Число"));
		// --- 	
		Если (ЭтоГруппа) Тогда
			
			ОтборПоИдентификаторуГруппы = Новый Структура("Идентификатор",ПодчиненныйЭлемент);
			СтрокаГруппы = _сф.к_НайтиСтроку(Объект.ГруппыПараметровЗаявки,ОтборПоИдентификаторуГруппы);
			// проверяем, что еще не выведена и записываем признак формирования
			Если (ТаблицаКонтроляГрупп <> Неопределено) Тогда
				
				КонтрольнаяСтрокаГруппы = _сф.к_НайтиСтроку(ТаблицаКонтроляГрупп, ОтборПоИдентификаторуГруппы);
				Если (КонтрольнаяСтрокаГруппы.Видимость) Тогда
					
					// ахтунг, зацикливание
					МассивИдентификаторовДляУдаления.Добавить(ПодчиненныйЭлемент);
					Продолжить;
					
				Иначе
					
					КонтрольнаяСтрокаГруппы.Видимость = Истина;
					
				КонецЕсли; 
				
			КонецЕсли; 
			// --- 
			Нстр = КоллекцияЭлементовДерева.Добавить();
			_ДПЗ_ЗаполнитьСтрокуДереваПоГруппе(Нстр, СтрокаГруппы);
			// --- 
			ДПЗ_УстановитьСостояниеСверткиСтроки(Нстр.ПолучитьИдентификатор(), Нстр.ИдентификаторГруппы, СтрокаГруппы.Раскрывать);

			_ДПЗ_СформироватьЭлементыДерева(СтрокаГруппы, Нстр, НаборПрав, Свойства, ТаблицаКонтроляГрупп, ТаблицаКонтроляПараметров);
			// --- 
			// устанавливаем признак разрешения удаления для группы
			УдалениеРазрешено = Истина;
			
			КоллекцияПодчиненных = Нстр.ПолучитьЭлементы();
			КоличествоСформированныхПодчиненных = КоллекцияПодчиненных.Количество();
			КоличествоПодчиненных = ЗначениеИзСтрокиВнутр(СтрокаГруппы.ИдентификаторыВедомых).Количество();
			Если (КоличествоСформированныхПодчиненных <> КоличествоПодчиненных) Тогда
				
				УдалениеРазрешено = Ложь;
				
			Иначе
				
				Для каждого ПодчиненнаяСтрока Из КоллекцияПодчиненных Цикл
					
					Если (НЕ ПодчиненнаяСтрока.УдалениеРазрешено) Тогда
						УдалениеРазрешено = Ложь;
						Прервать;
					КонецЕсли; 
					
				КонецЦикла; 
			КонецЕсли; 
			Нстр.УдалениеРазрешено = УдалениеРазрешено;
			
		КонецЕсли; 
		// --- 
		Если (НЕ ЭтоГруппа) Тогда
			
			// проверим права
			СтруктураПрав = НаборПрав["п_"+_сф.КлючПоСсылке(ПодчиненныйЭлемент)];
			Если (НЕ СтруктураПрав.Просмотр) Тогда
				
				Продолжить;
				
			КонецЕсли;
			// --- 
			Если (ТаблицаКонтроляПараметров <> Неопределено) Тогда
				
				ОтборПоПараметру = Новый Структура("Параметр",ПодчиненныйЭлемент);
				КонтрольнаяСтрокаПараметра = _сф.к_НайтиСтроку(ТаблицаКонтроляПараметров, ОтборПоПараметру);
				Если (КонтрольнаяСтрокаПараметра.Видимость) Тогда
					
					// ахтунг, параметр уже в какой-то группе, удаляем из текущей
					МассивИдентификаторовДляУдаления.Добавить(ПодчиненныйЭлемент);
					Продолжить;
					
				Иначе
					
					КонтрольнаяСтрокаПараметра.Видимость = Истина;
					
				КонецЕсли; 
				
			КонецЕсли; 
			// --- 
			Нстр = КоллекцияЭлементовДерева.Добавить();
			СП = Свойства.Получить(ПодчиненныйЭлемент);
			_ДПЗ_ЗаполнитьСтрокуДереваПоПараметру(Нстр, ПодчиненныйЭлемент, СП, СтруктураПрав);
			
		КонецЕсли; 
		
		
	КонецЦикла; 
	// --- 
	Если (МассивИдентификаторовДляУдаления.Количество() <> 0) Тогда
		
		Для каждого ИдентификаторДляУдаления Из МассивИдентификаторовДляУдаления Цикл
			
			МассивПодчиненныхЭлементов.Удалить(МассивПодчиненныхЭлементов.Найти(ИдентификаторДляУдаления));
			
		КонецЦикла; 
		Группа.ИдентификаторыВедомых = ЗначениеВСтрокуВнутр(МассивПодчиненныхЭлементов);
		
	КонецЕсли; 
	
	// --- 
КонецФункции

&НаСервере
Процедура _ДПЗ_ЗаполнитьСтрокуДереваПоПараметру(СтрокаДерева,Параметр,СвойстваПараметра=Неопределено, СтруктураПрав=Неопределено)
	// --- 
	
	Если (СвойстваПараметра = Неопределено) Тогда
		СвойстваПараметров = ПолучитьИзВременногоХранилища(АдресСвойствПараметров);
		СвойстваПараметра = СвойстваПараметров.Получить(Параметр);
		Если (СвойстваПараметра = Неопределено) Тогда
			СвойстваПараметров = CW_Мониторинг.ПолучитьСоответствиеСвойствПараметров();
			СвойстваПараметра = СвойстваПараметров.Получить(Параметр);
		КонецЕсли; 
	КонецЕсли; 
	
	Если (СтруктураПрав <> Неопределено) Тогда
		
		СтрокаДерева.УдалениеРазрешено = СтруктураПрав.Редактирование;
		
	КонецЕсли; 
	
	СтрокаДерева.Параметр = Параметр;	
	СтрокаДерева.Параметр_Представление = СвойстваПараметра.Наименование;	
	Если (СвойстваПараметра.ЭтоКонтрольнаяДата) Тогда
		СтрокаДерева.ИндексКартинки = 2;				
	ИначеЕсли (СвойстваПараметра.ДинамическийПараметр) Тогда 
		СтрокаДерева.ИндексКартинки = 3;
	Иначе
		СтрокаДерева.ИндексКартинки = 1;
	КонецЕсли; 
	// --- 
	СтрокаПараметра = _сф.к_НайтиСтроку(Объект.ПараметрыЗаявки,Новый Структура("Параметр", Параметр));
	СтрокаДерева.КонтрольЗаполнения = СтрокаПараметра.КонтрольЗаполнения;
	
	//Новый механизм
	СтрокаДерева.ИдентификаторВладельца = СтрокаПараметра.ИдентификаторВладельца;
