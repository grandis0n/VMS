&НаКлиенте
Процедура ДПЗ_ВыполнитьПодгрузкуСтрок(ИдентификаторСтрокиРодителя)
	// --- 
	
	СтрокаДерева = ДПЗ.НайтиПоИдентификатору(ИдентификаторСтрокиРодителя);
	СтрокаДерева.ПолучитьЭлементы().Очистить();
	_ДПЗ_ВыполнитьПодгрузку(ИдентификаторСтрокиРодителя);
	// --- 
	
	ДПЗ_ВосстановитьСостояниеСверткиСтроки(ИдентификаторСтрокиРодителя);
