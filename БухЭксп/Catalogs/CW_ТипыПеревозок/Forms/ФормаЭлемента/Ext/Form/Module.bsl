&НаКлиенте
Процедура ДПЗ_ПередНачаломИзменения(Элемент, Отказ)
	
	Если  НЕ (Элемент.ТекущийЭлемент = Элементы.ДПЗ_КонтрольЗаполнения) Тогда
		
		Отказ = Истина;
		Идентификатор = Элементы.ДПЗ.ТекущаяСтрока;
		СтрокаДПЗ = ДПЗ.НайтиПоИдентификатору(Идентификатор);
		Если (СтрокаДПЗ.ЭтоГруппа) Тогда
			
			ДоступнаСменаРежимаСвертки 	= ДПЗ_ПроверитьСостояниеВедомых(СтрокаДПЗ);
			СостояниеГруппы  			= ПолучитьНастройкуРаскрытияГруппы("ГруппыПараметровЗаявки", СтрокаДПЗ.ИдентификаторГруппы);
			
			ПараметрыФормы 	= Новый Структура("НаименованиеГруппы,ГруппаРазвернута,РежимГрузоперевозки,ДоступнаСменаРежимаСвертки", СтрокаДПЗ.НаименованиеГруппы,СостояниеГруппы, Ложь,ДоступнаСменаРежимаСвертки);
			оо 				= Новый ОписаниеОповещения("ДПЗ_ОбработатьВводНаименованияГруппы",ЭтотОбъект, Новый Структура("Редактирование",Истина)); 
			
			ОткрытьФорму("ПланВидовХарактеристик.CW_ПараметрыГрузоперевозок.Форма.ФормаВиртуальнойГруппы", ПараметрыФормы, ,,,, оо, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
			
		Иначе 
			ПараметрыФормы = Новый Структура("Ключ", СтрокаДПЗ.Параметр);
			оо = Новый ОписаниеОповещения("ОбработатьИзменениеПараметра",ЭтотОбъект,Новый Структура());
			ОткрытьФорму("ПланВидовХарактеристик.CW_ПараметрыГрузоперевозок.Форма.ФормаЭлемента", ПараметрыФормы, ,,,,оо, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
			
		КонецЕсли; 
		
	КонецЕсли; 
		
КонецПроцедуры

&наКлиенте
Функция ДПЗ_ПроверитьСостояниеВедомых(СтрокаДерева)
	
	ДоступностьСменыРежима = Истина;
	
	тЭлеметы = СтрокаДерева.ПолучитьЭлементы();
	ДПЗ_ПроверитьСостояниеВедомыхРекурсивно(тЭлеметы, ДоступностьСменыРежима);
	
	Возврат ДоступностьСменыРежима;
	
КонецФункции

&наКлиенте
Процедура ДПЗ_ПроверитьСостояниеВедомыхРекурсивно(тЭлеметы, ДоступностьСменыРежима)
	
	Если Не ДоступностьСменыРежима Тогда
		Возврат;
	КонецЕсли;
	
	Для каждого стрЭлемент из тЭлеметы Цикл
		Если  стрЭлемент.ЭтоГруппа Тогда
			ЭлементСостояния = ДПЗ_СостояниеСвертки.НайтиПоЗначению(стрЭлемент.ИдентификаторГруппы);
			Если ЭлементСостояния <> Неопределено Тогда
				Если ЭлементСостояния.Пометка Тогда
					ДоступностьСменыРежима = Ложь;
				КонецЕсли;
			КонецЕсли;
			Подчиненные = стрЭлемент.получитьЭлементы();
			ДПЗ_ПроверитьСостояниеВедомыхРекурсивно(подчиненные, ДоступностьСменыРежима);
		КонецЕсли;
	КонецЦикла;
		
КонецПроцедуры


#КонецОбласти 

#Область СостояниеСвертки_Заявка 

&НаСервере
Функция ДПЗ_УстановитьСостояниеСверткиСтроки(ИдентификаторСтроки, ИдентификаторГруппы, Развернута=Истина)
	
	ЭлементСостояния = ДПЗ_СостояниеСвертки.НайтиПоЗначению(ИдентификаторГруппы);
	Если (ЭлементСостояния = Неопределено) Тогда
		ЭлементСостояния = ДПЗ_СостояниеСвертки.Добавить(ИдентификаторГруппы);
	КонецЕсли; 
	ЭлементСостояния.Представление 	= Формат(ИдентификаторСтроки,"ЧДЦ=; ЧН=; ЧГ=");
	ЭлементСостояния.Пометка 		= Развернута;

КонецФункции

