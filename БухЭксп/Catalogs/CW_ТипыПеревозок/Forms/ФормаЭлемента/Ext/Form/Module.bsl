&НаСервере
Функция ДПЗаказ_УстановитьСостояниеСверткиСтроки(ИдентификаторСтроки, ИдентификаторГруппы, Развернута=Истина)
	
	ЭлементСостояния = ДПЗаказ_СостояниеСвертки.НайтиПоЗначению(ИдентификаторГруппы);
	Если (ЭлементСостояния = Неопределено) Тогда
		ЭлементСостояния = ДПЗаказ_СостояниеСвертки.Добавить(ИдентификаторГруппы);
	КонецЕсли; 
	ЭлементСостояния.Представление 	= Формат(ИдентификаторСтроки,"ЧДЦ=; ЧН=; ЧГ=");
	ЭлементСостояния.Пометка 		= Развернута;

КонецФункции

