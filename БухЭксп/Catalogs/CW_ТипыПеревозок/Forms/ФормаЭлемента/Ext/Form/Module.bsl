&НаСервере
Процедура УстановитьДоступностьСтраницПараметров()
	
	Элементы.СтраницыПараметров.ТолькоПросмотр = Объект.Ссылка.Пустая();
	
	//Страница параметры ГП
	Элементы.ДПГ_ДобавитьГруппу.Доступность 					= Не Объект.Ссылка.Пустая();
	Элементы.ДПГ_ПереместитьНаУровеньВверх.Доступность   		= Не Объект.Ссылка.Пустая();
	Элементы.ДПГ_ПереместитьВверх.Доступность           		= Не Объект.Ссылка.Пустая();
	Элементы.ДПГ_ПереместитьВниз.Доступность             		= Не Объект.Ссылка.Пустая();
	Элементы.ДПГ_ПоказатьКонтрольЗаполнения.Доступность    		= Не Объект.Ссылка.Пустая();
	Элементы.ДПГДПГ_ВосстановитьСверткуДерево.Доступность    	= Не Объект.Ссылка.Пустая(); 
	Элементы.ДПГ_СвернутьВсе.Доступность    					= Не Объект.Ссылка.Пустая();
	Элементы.ДПГ_РазвернутьВсе.Доступность    					= Не Объект.Ссылка.Пустая();
	
	Элементы.МенюГрузоперевозкаПеренестиПараметры.Доступность    		= Не Объект.Ссылка.Пустая();
	Элементы.ГрузоперевозкаПеренестиВСоставПараметровЗаявки.Доступность = Не Объект.Ссылка.Пустая();
	Элементы.ГрузоперевозкиПеренестиВСоставПараметровЗаказа.Доступность = Не Объект.Ссылка.Пустая();
	
	
	//Страница Параметры заявок
	Элементы.ДПЗ_ПоказатьКонтрольЗаполнения.Доступность		= Не Объект.Ссылка.Пустая();
	Элементы.ДПЗДПЗ_ПереместитьВниз.Доступность				= Не Объект.Ссылка.Пустая();
	Элементы.ДПЗДПЗ_ПереместитьВверх.Доступность			= Не Объект.Ссылка.Пустая();
	Элементы.ДПЗДПЗ_ПереместитьНаУровеньВверх.Доступность	= Не Объект.Ссылка.Пустая();
	Элементы.ДПЗДПЗ_ВосстановитьСверткуДерево.Доступность	= Не Объект.Ссылка.Пустая();
	Элементы.ДПЗ_СвернутьВсе.Доступность		= Не Объект.Ссылка.Пустая();
	Элементы.ДПЗ_РазвернутьВсе.Доступность		= Не Объект.Ссылка.Пустая();
	Элементы.ДПЗ_ДобавитьГруппу.Доступность		= Не Объект.Ссылка.Пустая();
	
	Элементы.МенюЗаявкаПеренестиПараметры.Доступность					= Не Объект.Ссылка.Пустая();
	Элементы.ЗаявкиПеренестиВСоставПараметровЗаказа.Доступность			= Не Объект.Ссылка.Пустая();
	Элементы.ЗаявкиПеренестиВСоставПараметровГрузопереовзки.Доступность	= Не Объект.Ссылка.Пустая();
	
	
	//Страница параметров заказа
	Элементы.ДПЗаказ_ДобавитьГруппу.Доступность	= Не Объект.Ссылка.Пустая();
	Элементы.ДПЗаказ_РазвернутьВсе.Доступность		= Не Объект.Ссылка.Пустая();
	Элементы.ДПЗаказ_СвернутьВсе.Доступность		= Не Объект.Ссылка.Пустая();
	Элементы.ДПЗаказ_ВосстановитьСверткуДерево.Доступность	= Не Объект.Ссылка.Пустая();
	Элементы.ДПЗаказ_ПереместитьНаУровеньВверх.Доступность	= Не Объект.Ссылка.Пустая();
	Элементы.ДПЗаказ_ПереместитьВверх.Доступность	= Не Объект.Ссылка.Пустая();
	Элементы.ДПЗаказ_ПереместитьВниз.Доступность	= Не Объект.Ссылка.Пустая();
	Элементы.ДПЗаказ_ПоказатьКонтрольЗаполнения.Доступность = Не Объект.Ссылка.Пустая();
	
	Элементы.МенюЗаказПеренестиПараметры.Доступность   					= Не Объект.Ссылка.Пустая();
	Элементы.ЗаказПеренестиВСоставПараметровЗаявки.Доступность   		= Не Объект.Ссылка.Пустая();
	Элементы.ЗаказПеренестиВСоставПараметровГрузопереовзки.Доступность  = Не Объект.Ссылка.Пустая();
	
КонецПроцедуры

