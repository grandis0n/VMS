&НаКлиенте
Процедура ДПЗаказ_ПередНачаломИзменения(Элемент, Отказ)
	
	Если  НЕ (Элемент.ТекущийЭлемент = Элементы.ДПЗаказ_КонтрольЗаполнения) Тогда
		
		Отказ = Истина;
		Идентификатор = Элементы.ДПЗаказ.ТекущаяСтрока;
		СтрокаДПЗаказ = ДПЗаказ.НайтиПоИдентификатору(Идентификатор);
		Если (СтрокаДПЗаказ.ЭтоГруппа) Тогда
			
			ДоступнаСменаРежимаСвертки 	= ДПЗаказ_ПроверитьСостояниеВедомых(СтрокаДПЗаказ);
			СостояниеГруппы  			= ПолучитьНастройкуРаскрытияГруппы("ГруппыПараметровЗаказа", СтрокаДПЗаказ.ИдентификаторГруппы);
			
			ПараметрыФормы 	= Новый Структура("НаименованиеГруппы,ГруппаРазвернута,РежимГрузоперевозки,ДоступнаСменаРежимаСвертки", СтрокаДПЗаказ.НаименованиеГруппы,СостояниеГруппы, Ложь,ДоступнаСменаРежимаСвертки);
			оо 				= Новый ОписаниеОповещения("ДПЗаказ_ОбработатьВводНаименованияГруппы",ЭтотОбъект, Новый Структура("Редактирование",Истина)); 
			
			ОткрытьФорму("ПланВидовХарактеристик.CW_ПараметрыГрузоперевозок.Форма.ФормаВиртуальнойГруппы", ПараметрыФормы, ,,,, оо, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
			
		Иначе 
			ПараметрыФормы = Новый Структура("Ключ", СтрокаДПЗаказ.Параметр);
			оо = Новый ОписаниеОповещения("ОбработатьИзменениеПараметра",ЭтотОбъект,Новый Структура());
			ОткрытьФорму("ПланВидовХарактеристик.CW_ПараметрыГрузоперевозок.Форма.ФормаЭлемента", ПараметрыФормы, ,,,,оо, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
			
		КонецЕсли; 
		
	КонецЕсли; 
		
КонецПроцедуры

&наКлиенте
Функция ДПЗаказ_ПроверитьСостояниеВедомых(СтрокаДерева)
	
	ДоступностьСменыРежима = Истина;
	
	тЭлеметы = СтрокаДерева.ПолучитьЭлементы();
	ДПЗаказ_ПроверитьСостояниеВедомыхРекурсивно(тЭлеметы, ДоступностьСменыРежима);
	
	Возврат ДоступностьСменыРежима;
	
КонецФункции

&наКлиенте
Процедура ДПЗаказ_ПроверитьСостояниеВедомыхРекурсивно(тЭлеметы, ДоступностьСменыРежима)
	
	Если Не ДоступностьСменыРежима Тогда
		Возврат;
	КонецЕсли;
	
	Для каждого стрЭлемент из тЭлеметы Цикл
		Если  стрЭлемент.ЭтоГруппа Тогда
			ЭлементСостояния = ДПЗаказ_СостояниеСвертки.НайтиПоЗначению(стрЭлемент.ИдентификаторГруппы);
			Если ЭлементСостояния <> Неопределено Тогда
				Если ЭлементСостояния.Пометка Тогда
					ДоступностьСменыРежима = Ложь;
				КонецЕсли;
			КонецЕсли;
			Подчиненные = стрЭлемент.получитьЭлементы();
			ДПЗаказ_ПроверитьСостояниеВедомыхРекурсивно(подчиненные, ДоступностьСменыРежима);
		КонецЕсли;
	КонецЦикла;
		
КонецПроцедуры


