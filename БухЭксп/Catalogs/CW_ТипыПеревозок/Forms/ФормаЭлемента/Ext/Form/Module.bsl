#Область ПодборПараметров 

&НаКлиенте
Процедура ПодборПараметров(Команда)
	
	ПараметрыФормыПодбора = Новый Структура;
	ПараметрыФормыПодбора.Вставить("МножественныйВыбор"	, Истина);
	ПараметрыФормыПодбора.Вставить("РежимВыбора"		, Истина);
	ПараметрыФормыПодбора.Вставить("ЗакрыватьПриВыборе"	, Истина);
	
	ДополнительныеПараметры = Новый Структура("ИмяСтраницы", Элементы.СтраницыПараметров.ТекущаяСтраница.Имя);
	
	ОписаниеОповещения 		= Новый ОписаниеОповещения("ПослеЗакрытияФормыПодбораПараметра", ЭтаФорма, ДополнительныеПараметры);
	
	ОткрытьФорму("ОбщаяФорма.CW_ПодборПараметровГрузоперевозок",ПараметрыФормыПодбора, ЭтаФорма,,,,ОписаниеОповещения,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияФормыПодбораПараметра(ВыбранныеЗначения, ДополнительныеПараметры) Экспорт
	
	Если ДополнительныеПараметры.ИмяСтраницы = "СтраницаПараметровГрузоперевозок" Тогда
		ДПГ_ОбработкаВыбораПараметра(ВыбранныеЗначения, Неопределено);
	ИначеЕсли ДополнительныеПараметры.ИмяСтраницы = "СтраницаПараметровЗаявок" Тогда 
		ДПЗ_ОбработкаВыбораПараметра(ВыбранныеЗначения, Неопределено);
	ИначеЕсли ДополнительныеПараметры.ИмяСтраницы = "СтраницаПараметровЗаказа" Тогда 
		ДПЗаказ_ОбработкаВыбораПараметра(ВыбранныеЗначения, Неопределено);
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	
	Если ИмяСобытия = "ПараметрИзменен" Тогда
		
		Если ДПГ.ПолучитьЭлементы().Количество() > 0 Тогда
			
			//AFR-240198
			ТекущиеДанные = Элементы.ДПГ.ТекущиеДанные;  
			Если ТекущиеДанные <> Неопределено Тогда
				НаименованиеГруппы = ТекущиеДанные.НаименованиеГруппы;
			//AFR-240198
				
				ДПГ_Обновить();	
				
			//AFR-240198
				ИдентификаторСтроки = ПолучитьСтрокуДерева(ДПГ, НаименованиеГруппы);
				Элементы.ДПГ.ТекущаяСтрока = ИдентификаторСтроки;   
			КонецЕсли;
			//AFR-240198
		КонецЕсли;
		Если ДПЗ.ПолучитьЭлементы().Количество() > 0 Тогда
			//AFR-240198
			ТекущиеДанные = Элементы.ДПЗ.ТекущиеДанные;  
			Если ТекущиеДанные <> Неопределено Тогда
				НаименованиеГруппы = ТекущиеДанные.НаименованиеГруппы;
			//AFR-240198
				
				ДПЗ_Обновить();	
				
			//AFR-240198
				ИдентификаторСтроки = ПолучитьСтрокуДерева(ДПЗ, НаименованиеГруппы);
				Элементы.ДПЗ.ТекущаяСтрока = ИдентификаторСтроки; 
			КонецЕсли;
			//AFR-240198
		КонецЕсли;
		Если ДПЗаказ.ПолучитьЭлементы().Количество() > 0 Тогда
			//AFR-240198
			ТекущиеДанные = Элементы.ДПЗаказ.ТекущиеДанные;  
			Если ТекущиеДанные <> Неопределено Тогда
				НаименованиеГруппы = ТекущиеДанные.НаименованиеГруппы;
			//AFR-240198
				
				ДПЗаказ_Обновить();	
				
			//AFR-240198
				ИдентификаторСтроки = ПолучитьСтрокуДерева(ДПЗаказ, НаименованиеГруппы);
				Элементы.ДПЗаказ.ТекущаяСтрока = ИдентификаторСтроки; 
			КонецЕсли;
			//AFR-240198
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьСтрокуДерева(Дерево, НаименованиеГруппы)
	
	ЭлементыДерева = Дерево.ПолучитьЭлементы(); 
	Для Каждого ЭлементДерева  из ЭлементыДерева Цикл
		Если ЭлементДерева.НаименованиеГруппы = НаименованиеГруппы Тогда
			Возврат ЭлементДерева.ПолучитьИдентификатор();
		КонецЕсли;
		Если ЭлементДерева.ЭтоГруппа Тогда
			ИдентификаторСтроки = ПолучитьСтрокуДерева(ЭлементДерева, НаименованиеГруппы);	
			Если ИдентификаторСтроки <> Неопределено Тогда
				Возврат ИдентификаторСтроки;
			КонецЕсли;
		КонецЕсли;                                                                        
	КонецЦикла;
	
КонецФункции

