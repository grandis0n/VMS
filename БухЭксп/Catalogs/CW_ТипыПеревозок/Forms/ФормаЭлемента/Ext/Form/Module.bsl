#Область ФормированиеДерева_Грузоперевозка 

&НаКлиенте
Процедура ДПГ_Обновить()
	// --- 
	
	_ДПГ_Обновить();
	ДПГ_ВосстановитьСостояниеСвертки();
	
	// --- 
КонецПроцедуры

&НаСервере
Процедура _ДПГ_Обновить()
	// --- 
	
	// получаем текущие группы 		
	Элементы.ДПГ.НачальноеОтображениеДерева=НачальноеОтображениеДерева.НеРаскрывать;
	ДПГ.ПолучитьЭлементы().Очистить();
	// ---------------------------------------------------------------------------- 
	Если (Объект.ГруппыПараметровГрузоперевозки.Количество()=0) Тогда
		Корень = Объект.ГруппыПараметровГрузоперевозки.Добавить();
		Корень.ИдентификаторыВедомых = ЗначениеВСтрокуВнутр(Новый Массив);
	Иначе
		Корень = Объект.ГруппыПараметровГрузоперевозки[0];	
	КонецЕсли; 
	Если (НЕ Корень.Раскрывать) Тогда
		Корень.Раскрывать = Истина;
	КонецЕсли; 
	// --- 
	НаборПравДляПараметров = CW_ПраваДоступа.НаборПравДляПараметров();
	СвойстваПараметров = ПолучитьИзВременногоХранилища(АдресСвойствПараметров);
	// --- 
	ТаблицаКонтроляГрупп = _ДПГ_ТаблицаКонтроляГрупп();
	ТаблицаКонтроляПараметров = _ДПГ_ТаблицаКонтроляПараметров(НаборПравДляПараметров);
	// --- 
	_ДПГ_СформироватьЭлементыДерева(Корень,Неопределено,НаборПравДляПараметров,СвойстваПараметров, ТаблицаКонтроляГрупп, ТаблицаКонтроляПараметров);
	
	// после формирования проверяем, нет ли потерянных групп, 
	// если есть, то засовываем их в корень и переформировываем дерево
	// сообщаем о потерянных группах
	
	МассивНеучтенныхГрупп = _сф.к_НайтиСтроки(ТаблицаКонтроляГрупп,Новый Структура("Видимость",Ложь));
	Если (МассивНеучтенныхГрупп.Количество() <> 0) Тогда
		
		// переносим каждую в корень
		Для каждого КонтрольнаяСтрокаГруппы Из МассивНеучтенныхГрупп Цикл
			
			_ДПГ_ДобавитьЭлементГруппы(КонтрольнаяСтрокаГруппы.Идентификатор, Корень);
			
		КонецЦикла; 
		// --- 
		// переформировываем дерево
		ТаблицаКонтроляГрупп = _ДПГ_ТаблицаКонтроляГрупп();
		ТаблицаКонтроляПараметров = _ДПГ_ТаблицаКонтроляПараметров(НаборПравДляПараметров);
		_ДПГ_СформироватьЭлементыДерева(Корень,Неопределено,НаборПравДляПараметров,СвойстваПараметров, ТаблицаКонтроляГрупп, ТаблицаКонтроляПараметров);
		// --- 
		ДПГ_ТекущаяГруппа=0;
		ДПГ_ТекущийПараметр = Неопределено;
		
	КонецЕсли; 
	
	// далее проверяем, нет ли потерянных/новых параметров, если есть
	// то добавляем их в корень и снова переформировываем дерево
	
	МассивНеучтенныхПараметров = _сф.к_НайтиСтроки(ТаблицаКонтроляПараметров,Новый Структура("Видимость",Ложь));
	Если (МассивНеучтенныхПараметров.Количество() <> 0) Тогда
		
		// переносим каждую в корень
		Для каждого КонтрольнаяСтрокаПараметра Из МассивНеучтенныхПараметров Цикл
			_ДПГ_ДобавитьЭлементГруппы(КонтрольнаяСтрокаПараметра.Параметр, Корень);
		КонецЦикла; 
		// переформировываем дерево
		ТаблицаКонтроляГрупп = _ДПГ_ТаблицаКонтроляГрупп();
		ТаблицаКонтроляПараметров = _ДПГ_ТаблицаКонтроляПараметров(НаборПравДляПараметров);
		_ДПГ_СформироватьЭлементыДерева(Корень,Неопределено,НаборПравДляПараметров,СвойстваПараметров, ТаблицаКонтроляГрупп, ТаблицаКонтроляПараметров);
		// --- 
		ДПГ_ТекущаяГруппа=0;
		ДПГ_ТекущийПараметр = Неопределено;
		
	КонецЕсли; 
	
	//КонтрольЗаполнения
	
	
	// --- 
КонецПроцедуры

&НаСервере
Функция _ДПГ_ТаблицаКонтроляГрупп()
	// --- 
	
	ТаблицаКонтроляГрупп = Объект.ГруппыПараметровГрузоперевозки.Выгрузить();
	ТаблицаКонтроляГрупп.Колонки.Добавить("Видимость");
	ТаблицаКонтроляГрупп.ЗаполнитьЗначения(Ложь,"Видимость");
	СтрокаКорня = _сф.к_ПервыйЭлемент(ТаблицаКонтроляГрупп);
	СтрокаКорня.Видимость = Истина;
	// --- 
	Возврат(ТаблицаКонтроляГрупп);
	
	// --- 
КонецФункции

&НаСервере
Функция _ДПГ_ТаблицаКонтроляПараметров(НаборПрав)
	// --- 
	
	ТаблицаКонтроляПараметров = Объект.ПараметрыГрузоперевозки.Выгрузить();
	// --- 
	ТаблицаКонтроляПараметров.Колонки.Добавить("Видимость");
	ТаблицаКонтроляПараметров.ЗаполнитьЗначения(Ложь,"Видимость");
	// --- 
	МассивУдаляемыхСтрок = Новый Массив;
	Для каждого СтрокаКонтроля Из ТаблицаКонтроляПараметров Цикл
		
		СтруктураПрав = НаборПрав["п_"+_сф.КлючПоСсылке(СтрокаКонтроля.Параметр)];
		Если (НЕ СтруктураПрав.Просмотр) Тогда
			
			МассивУдаляемыхСтрок.Добавить(СтрокаКонтроля);
			
		КонецЕсли;
		
	КонецЦикла; 
	_сф.к_УдалитьЭлементыПоМассиву(ТаблицаКонтроляПараметров, МассивУдаляемыхСтрок);
	// --- 
	Возврат(ТаблицаКонтроляПараметров);
	
	// --- 
КонецФункции

&НаСервере
Функция _ДПГ_СформироватьЭлементыДерева(Группа,СтрокаДерева = Неопределено, НаборПрав, Свойства, ТаблицаКонтроляГрупп=Неопределено, ТаблицаКонтроляПараметров=Неопределено)
	// --- 
	
	Если (СтрокаДерева <> Неопределено) Тогда
		КоллекцияЭлементовДерева = СтрокаДерева.ПолучитьЭлементы();
	Иначе
		КоллекцияЭлементовДерева = ДПГ.ПолучитьЭлементы();		
	КонецЕсли; 
	КоллекцияЭлементовДерева.Очистить();
	// --- 
	
	МассивПодчиненныхЭлементов = ЗначениеИзСтрокиВнутр(Группа.ИдентификаторыВедомых);
	МассивИдентификаторовДляУдаления = Новый Массив;
	Для каждого ПодчиненныйЭлемент Из МассивПодчиненныхЭлементов Цикл
		
		Если ТипЗнч(ПодчиненныйЭлемент) = Тип("ПланВидовХарактеристикСсылка.CW_ПараметрыГрузоперевозок") Тогда  
			ПодчиненныйЭлементОбъект = ПодчиненныйЭлемент.ПолучитьОбъект();
			Если ПодчиненныйЭлементОбъект = Неопределено Тогда
				Продолжить;
			КонецЕсли;                                                                                            
		Конецесли;

		ЭтоГруппа = (ТипЗнч(ПодчиненныйЭлемент)=Тип("Число"));
		// --- 	
		Если (ЭтоГруппа) Тогда
			
			ОтборПоИдентификаторуГруппы = Новый Структура("Идентификатор",ПодчиненныйЭлемент);
			СтрокаГруппы = _сф.к_НайтиСтроку(Объект.ГруппыПараметровГрузоперевозки,ОтборПоИдентификаторуГруппы);
			// проверяем, что еще не выведена и записываем признак формирования
			Если (ТаблицаКонтроляГрупп <> Неопределено) Тогда
				
				КонтрольнаяСтрокаГруппы = _сф.к_НайтиСтроку(ТаблицаКонтроляГрупп, ОтборПоИдентификаторуГруппы);
				Если (КонтрольнаяСтрокаГруппы.Видимость) Тогда
					
					// ахтунг, зацикливание
					МассивИдентификаторовДляУдаления.Добавить(ПодчиненныйЭлемент);
					Продолжить;
					
				Иначе
					
					КонтрольнаяСтрокаГруппы.Видимость = Истина;
					
				КонецЕсли; 
				
			КонецЕсли; 
			// --- 
			Нстр = КоллекцияЭлементовДерева.Добавить();
			_ДПГ_ЗаполнитьСтрокуДереваПоГруппе(Нстр, СтрокаГруппы);
			
			// --- 
			ДПГ_УстановитьСостояниеСверткиСтроки(Нстр.ПолучитьИдентификатор(), Нстр.ИдентификаторГруппы, СтрокаГруппы.Раскрывать);
		
			_ДПГ_СформироватьЭлементыДерева(СтрокаГруппы, Нстр, НаборПрав, Свойства, ТаблицаКонтроляГрупп, ТаблицаКонтроляПараметров);
			// --- 
			// устанавливаем признак разрешения удаления для группы
			УдалениеРазрешено = Истина;
			
			КоллекцияПодчиненных = Нстр.ПолучитьЭлементы();
			КоличествоСформированныхПодчиненных = КоллекцияПодчиненных.Количество();
			КоличествоПодчиненных = ЗначениеИзСтрокиВнутр(СтрокаГруппы.ИдентификаторыВедомых).Количество();
			Если (КоличествоСформированныхПодчиненных <> КоличествоПодчиненных) Тогда
				УдалениеРазрешено = Ложь;
			Иначе
				Для каждого ПодчиненнаяСтрока Из КоллекцияПодчиненных Цикл
					Если (НЕ ПодчиненнаяСтрока.УдалениеРазрешено) Тогда
						УдалениеРазрешено = Ложь;
						Прервать;
					КонецЕсли; 
				КонецЦикла; 
			КонецЕсли; 
			Нстр.УдалениеРазрешено = УдалениеРазрешено;
			
		КонецЕсли; 
		// --- 
		Если (НЕ ЭтоГруппа) Тогда
			
			// проверим права
			СтруктураПрав = НаборПрав["п_"+_сф.КлючПоСсылке(ПодчиненныйЭлемент)];
			Если (НЕ СтруктураПрав.Просмотр) Тогда
				
				Продолжить;
				
			КонецЕсли;
			// --- 
			Если (ТаблицаКонтроляПараметров <> Неопределено) Тогда
				
				ОтборПоПараметру = Новый Структура("Параметр",ПодчиненныйЭлемент);
				КонтрольнаяСтрокаПараметра = _сф.к_НайтиСтроку(ТаблицаКонтроляПараметров, ОтборПоПараметру);
				Если (КонтрольнаяСтрокаПараметра = Неопределено) Тогда
					
					МассивИдентификаторовДляУдаления.Добавить(ПодчиненныйЭлемент);
					Продолжить;
					
				Иначе
					Если (КонтрольнаяСтрокаПараметра.Видимость) Тогда
						
						// ахтунг, параметр уже в какой-то группе, удаляем из текущей
						МассивИдентификаторовДляУдаления.Добавить(ПодчиненныйЭлемент);
						Продолжить;
						
					Иначе
						
						КонтрольнаяСтрокаПараметра.Видимость = Истина;
						
					КонецЕсли;
				КонецЕсли; 
				
			КонецЕсли; 
			// --- 
			Нстр = КоллекцияЭлементовДерева.Добавить();
			СП = Свойства.Получить(ПодчиненныйЭлемент);
			_ДПГ_ЗаполнитьСтрокуДереваПоПараметру(Нстр, ПодчиненныйЭлемент, СП, СтруктураПрав);
			
		КонецЕсли; 
		
		
	КонецЦикла; 
	// --- 
	Если (МассивИдентификаторовДляУдаления.Количество() <> 0) Тогда
		
		Для каждого ИдентификаторДляУдаления Из МассивИдентификаторовДляУдаления Цикл
			
			МассивПодчиненныхЭлементов.Удалить(МассивПодчиненныхЭлементов.Найти(ИдентификаторДляУдаления));
			
		КонецЦикла; 
		Группа.ИдентификаторыВедомых = ЗначениеВСтрокуВнутр(МассивПодчиненныхЭлементов);
		
	КонецЕсли; 
	
	// --- 
КонецФункции

&НаСервере
Процедура _ДПГ_ЗаполнитьСтрокуДереваПоПараметру(СтрокаДерева,Параметр,СвойстваПараметра=Неопределено, СтруктураПрав=Неопределено)
	// --- 
	
	Если (СвойстваПараметра = Неопределено) Тогда
		СвойстваПараметров = ПолучитьИзВременногоХранилища(АдресСвойствПараметров);
		СвойстваПараметра = СвойстваПараметров.Получить(Параметр);
		Если (СвойстваПараметра = Неопределено) Тогда
			СвойстваПараметров = CW_Мониторинг.ПолучитьСоответствиеСвойствПараметров();
			СвойстваПараметра = СвойстваПараметров.Получить(Параметр);
		КонецЕсли; 
	КонецЕсли; 
	
	Если (СтруктураПрав <> Неопределено) Тогда
		
		СтрокаДерева.УдалениеРазрешено = СтруктураПрав.Редактирование;
		
	КонецЕсли; 
	
	СтрокаДерева.Параметр = Параметр;	
	СтрокаДерева.Параметр_Представление = СвойстваПараметра.Наименование;	
	Если (СвойстваПараметра.ЭтоКонтрольнаяДата) Тогда
		СтрокаДерева.ИндексКартинки = 2;				
	ИначеЕсли (СвойстваПараметра.ДинамическийПараметр) Тогда 
		СтрокаДерева.ИндексКартинки = 3;
	Иначе
		СтрокаДерева.ИндексКартинки = 1;
	КонецЕсли; 
	// --- 
	СтрокаПараметра = _сф.к_НайтиСтроку(Объект.ПараметрыГрузоперевозки,Новый Структура("Параметр", Параметр));
	СтрокаДерева.КонтрольЗаполнения        = СтрокаПараметра.КонтрольЗаполнения;
	СтрокаДерева.КонтрольЗаполненияРасходы = СтрокаПараметра.КонтрольЗаполненияРасходы;
	СтрокаДерева.КонтрольЗаполненияДоходы  = СтрокаПараметра.КонтрольЗаполненияДоходы;
	
	//Новый механизм
	СтрокаДерева.ИдентификаторВладельца = СтрокаПараметра.ИдентификаторВладельца;
	//Новый механизм

	// --- 
КонецПроцедуры

&НаСервере
Процедура _ДПГ_ЗаполнитьСтрокуДереваПоГруппе(СтрокаДерева, СтрокаГруппы)
	// --- 
	
	СтрокаДерева.ЭтоГруппа = Истина;
	СтрокаДерева.НаименованиеГруппы = СтрокаГруппы.Наименование;
	СтрокаДерева.Параметр_Представление = СтрокаГруппы.Наименование;
	СтрокаДерева.ИдентификаторГруппы = СтрокаГруппы.Идентификатор;
	СтрокаДерева.УдалениеРазрешено = Истина;
	// --- 
	СтрокаДерева.ИндексКартинки = 0;
	
	//Новый механизм
	СтрокаДерева.ИдентификаторВладельца = СтрокаГруппы.ИдентификаторВладельца;
	//Новый механизм
	// --- 
КонецПроцедуры

&НаКлиенте
Процедура ДПГ_ВыполнитьПодгрузкуСтрок(ИдентификаторСтрокиРодителя)
	// --- 
	
	СтрокаДерева = ДПГ.НайтиПоИдентификатору(ИдентификаторСтрокиРодителя);
	СтрокаДерева.ПолучитьЭлементы().Очистить();
	_ДПГ_ВыполнитьПодгрузку(ИдентификаторСтрокиРодителя);
	// --- 
	
	ДПГ_ВосстановитьСостояниеСверткиСтроки(ИдентификаторСтрокиРодителя);
	// --- 
	Элементы.ДПГ.Развернуть(ИдентификаторСтрокиРодителя);
	
	// --- 
КонецПроцедуры

&НаСервере
Процедура _ДПГ_ВыполнитьПодгрузку(ИдентификаторСтрокиРодителя)
	// --- 
	
	СтрокаРодителя = ДПГ.НайтиПоИдентификатору(ИдентификаторСтрокиРодителя);
	СтрокаГруппа = _сф.к_НайтиСтроку(Объект.ГруппыПараметровГрузоперевозки,Новый Структура("Идентификатор",СтрокаРодителя.ИдентификаторГруппы));
	// --- 
	НаборПравДляПараметров = CW_ПраваДоступа.НаборПравДляПараметров();
	СвойстваПараметров = ПолучитьИзВременногоХранилища(АдресСвойствПараметров);
	_ДПГ_СформироватьЭлементыДерева(СтрокаГруппа,СтрокаРодителя, НаборПравДляПараметров, СвойстваПараметров);
	
	// --- 
КонецПроцедуры

#КонецОбласти 

#Область СобытияДерева_Грузоперевозка

&НаКлиенте
Процедура ДПГ_ПриАктивизацииСтроки(Элемент)
	
	// --- 
	
КонецПроцедуры

&НаКлиенте
Процедура ДПГ_ПередНачаломИзменения(Элемент, Отказ)
	
	Если НЕ (Элемент.ТекущийЭлемент = Элементы.ДПГ_КонтрольЗаполнения 
		ИЛИ Элемент.ТекущийЭлемент = Элементы.ДПГ_КонтрольЗаполненияРасходы 
		ИЛИ Элемент.ТекущийЭлемент = Элементы.ДПГ_КонтрольЗаполненияДоходы) 
		Тогда
		
		Отказ = Истина;
		Идентификатор = Элементы.ДПГ.ТекущаяСтрока;
		СтрокаДПГ = ДПГ.НайтиПоИдентификатору(Идентификатор);
		Если (СтрокаДПГ.ЭтоГруппа) Тогда
			
			ДоступнаСменаРежимаСвертки 	= ДПГ_ПроверитьСостояниеВедомых(СтрокаДПГ);
			СостояниеГруппы  			= ПолучитьНастройкуРаскрытияГруппы("ГруппыПараметровГрузоперевозки", СтрокаДПГ.ИдентификаторГруппы);
			
			ПараметрыФормы		= Новый Структура("НаименованиеГруппы,ГруппаРазвернута,РежимГрузоперевозки,ДоступнаСменаРежимаСвертки", СтрокаДПГ.НаименованиеГруппы,СостояниеГруппы, Истина,ДоступнаСменаРежимаСвертки);
			оо 					= Новый ОписаниеОповещения("ДПГ_ОбработатьВводНаименованияГруппы",ЭтотОбъект, Новый Структура("Редактирование",Истина)); 
			
			ОткрытьФорму("ПланВидовХарактеристик.CW_ПараметрыГрузоперевозок.Форма.ФормаВиртуальнойГруппы", ПараметрыФормы, ,,,,оо, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
			
		Иначе 
			ПараметрыФормы = Новый Структура("Ключ", СтрокаДПГ.Параметр);
			оо = Новый ОписаниеОповещения("ОбработатьИзменениеПараметра",ЭтотОбъект,Новый Структура());
			ОткрытьФорму("ПланВидовХарактеристик.CW_ПараметрыГрузоперевозок.Форма.ФормаЭлемента", ПараметрыФормы, ,,,,оо, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
			
		КонецЕсли; 
		
	КонецЕсли; 
	
КонецПроцедуры     

&наКлиенте
Функция ДПГ_ПроверитьСостояниеВедомых(СтрокаДерева)
	
	ДоступностьСменыРежима = Истина;
	
	тЭлеметы = СтрокаДерева.ПолучитьЭлементы();
	ДПГ_ПроверитьСостояниеВедомыхРекурсивно(тЭлеметы, ДоступностьСменыРежима);
	
	Возврат ДоступностьСменыРежима;
	
КонецФункции

&наКлиенте
Процедура ДПГ_ПроверитьСостояниеВедомыхРекурсивно(тЭлеметы, ДоступностьСменыРежима)
	
	Если Не ДоступностьСменыРежима Тогда
		Возврат;
	КонецЕсли;
	
	Для каждого стрЭлемент из тЭлеметы Цикл
		Если  стрЭлемент.ЭтоГруппа Тогда
			ЭлементСостояния = ДПГ_СостояниеСвертки.НайтиПоЗначению(стрЭлемент.ИдентификаторГруппы);
			Если ЭлементСостояния <> Неопределено Тогда
				Если ЭлементСостояния.Пометка Тогда
					ДоступностьСменыРежима = Ложь;
				КонецЕсли;
			КонецЕсли;
			Подчиненные = стрЭлемент.получитьЭлементы();
			ДПГ_ПроверитьСостояниеВедомыхРекурсивно(подчиненные, ДоступностьСменыРежима);
		КонецЕсли;
	КонецЦикла;
		
КонецПроцедуры

&НаСервере
Функция ПолучитьНастройкуРаскрытияГруппы(ИмяТаблицы, Идентификатор)
	
	мНайденныеСтроки = Объект[ИмяТаблицы].НайтиСтроки(Новый Структура("Идентификатор",Идентификатор));
	
	Если мНайденныеСтроки.Количество() = 0 Тогда
		//Странно... группа есть, а строки нет
		//получим настройку из параметров
		Если ИмяТаблицы = "ГруппыПараметровГрузоперевозки" Тогда
			CW_Настройки.ПолучитьНастройкуПользователя(ПараметрыСеанса.ТекущийПользователь,"РазворачиватьДеревоПараметровГрузоперевозок");		
		Иначе  //ГруппыПараметровЗаявки
			CW_Настройки.ПолучитьНастройкуПользователя(ПараметрыСеанса.ТекущийПользователь,"РазворачиватьДеревоПараметровЗаявок");		
		КонецЕсли;
	Иначе
		Возврат мНайденныеСтроки[0].Раскрывать;
	КонецЕсли;
	
КонецФункции

