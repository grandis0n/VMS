			Если мНайденныеСтроки.Количество() > 0 Тогда
				ТекущаяСтрокаГруппы = мНайденныеСтроки[0];
				СтруктураГруппы = Новый Структура("НаименованиеГруппы,ГруппаРазвернута", СтрокаДерева.НаименованиеГруппы,ТекущаяСтрокаГруппы.Раскрывать);
				ИдентификаторГруппы = _ДПГ_ДобавитьГруппу(СтруктураГруппы, ИдентификаторГруппыРодителя);
			КонецЕсли;
			
		Иначе
			ИдентификаторГруппы =  мСтрокиГруппы_ДПГ[0].Идентификатор;
		КонецЕсли;
		
		ЭлементыДерева = СтрокаДерева.ПолучитьЭлементы();
		
		Для Каждого СтрокаГруппы из ЭлементыДерева цикл
			
			Если СтрокаГруппы.ЭтоГруппа Тогда
				ПеренестиЭлементыВГрузоперевозки(СтрокаГруппы, ИдентификаторГруппы);
			Иначе
				Если ДПГ_ДобавляемыйПараметрНовый(СтрокаГруппы.Параметр) Тогда
					ИдентификаторДобавленнойСтроки = _ДПГ_ДобавитьПараметр(СтрокаГруппы.Параметр,Истина,ИдентификаторГруппы);
				КонецЕсли;
				
			КонецЕсли;
		КонецЦикла;
		
	Иначе
		Если ДПГ_ДобавляемыйПараметрНовый(СтрокаДерева.Параметр) Тогда
			ИдентификаторДобавленнойСтроки = _ДПГ_ДобавитьПараметр(СтрокаДерева.Параметр,истина);
		КонецЕсли;
	КонецЕсли;
	
