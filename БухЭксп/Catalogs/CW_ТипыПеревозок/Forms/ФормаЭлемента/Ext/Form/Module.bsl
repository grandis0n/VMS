#Область СобытияФормы 

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЭтаФорма.ТолькоПросмотр = (НЕ CW_ПраваДоступа.ПравоДоступно("РедактированиеНастроекМониторинга"));
	Если (ЭтаФорма.ТолькоПросмотр) Тогда
		
		Элементы.ДПГ.ТолькоПросмотр = Истина;
		Элементы.ДПГ.ИзменятьСоставСтрок=Ложь;
		Элементы.ДПГ.ПоложениеКоманднойПанели=ПоложениеКоманднойПанелиЭлементаФормы.Нет;
		
	КонецЕсли; 
	
	// --- 
	
	Если (Объект.ГруппыПараметровГрузоперевозки.Количество()=0) Тогда
		
		НастоящийОбъект = РеквизитФормыВЗначение("Объект");
		НастоящийОбъект.ПроверитьИерархиюПараметров();
		ЗначениеВРеквизитФормы(НастоящийОбъект,"Объект");
		
	КонецЕсли; 
	
	СвойстваПараметров = CW_Мониторинг.ПолучитьСоответствиеСвойствПараметров();
	АдресСвойствПараметров = ПоместитьВоВременноеХранилище(СвойстваПараметров,УникальныйИдентификатор);
	// --- 
	
	ДПГ_ПоказыватьКоличествоПараметров = CW_Настройки.ПолучитьНастройкуПользователя(CW_Настройки.Пользователь(),"ПоказыватьКоличествоПараметровВГруппах");
	// --- 
	
	ИспользуютсяЗаявки =  ПолучитьФункциональнуюОпцию("CW_ИспользованиеЗаявок");
	ИспользуютсяЗаказы =  ПолучитьФункциональнуюОпцию("CW_ИспользованиеЗаказов") и ПолучитьФункциональнуюОпцию("CW_ИспользуютсяПараметрыВЗаказах");
	
	Элементы.ЗаказПеренестиВСоставПараметровЗаявки.Видимость 			= ИспользуютсяЗаявки;
	Элементы.ГрузоперевозкаПеренестиВСоставПараметровЗаявки.Видимость 	= ИспользуютсяЗаявки;

	Элементы.ЗаявкиПеренестиВСоставПараметровЗаказа.Видимость 			= ИспользуютсяЗаказы;
	Элементы.ГрузоперевозкиПеренестиВСоставПараметровЗаказа.Видимость 	= ИспользуютсяЗаказы;
	
	ТекущийИндексСтраницы = Неопределено;
	Если ИспользуютсяЗаявки Тогда
		Элементы.ИндексСтраницыПараметров.СписокВыбора.Добавить(1,"Заявки");
		ТекущийИндексСтраницы = 1;
	КонецЕсли;
	
	Если ИспользуютсяЗаказы Тогда
		Элементы.ИндексСтраницыПараметров.СписокВыбора.Добавить(2,"Заказы");
		Если ТекущийИндексСтраницы = Неопределено Тогда
			ТекущийИндексСтраницы = 2;
		КонецЕсли;
	КонецЕсли;
	
	Элементы.ИндексСтраницыПараметров.СписокВыбора.Добавить(0,"Грузоперевозки");
		Если ТекущийИндексСтраницы = Неопределено Тогда
			ТекущийИндексСтраницы = 0;
		КонецЕсли;
	
	Если ПолучитьФункциональнуюОпцию("CW_ИспользованиеБлокаСобственногоТранспорта") Тогда
		Элементы.ИндексСтраницыПараметров.СписокВыбора.Добавить(3, "Путевые листы");
	КонецЕсли;
	
	ИндексСтраницыПараметров = ТекущийИндексСтраницы;
	
	Элементы.СтраницаПараметровЗаявок.Видимость = ИспользуютсяЗаявки;
	Элементы.ИндексСтраницыПараметров.Видимость = Элементы.ИндексСтраницыПараметров.СписокВыбора.Количество() > 1;
	
	// Предопределенные значения параметров
	ВидСубъекта = Перечисления.CW_ВидыСубъектовСвязанныхПараметров.ТипПеревозки;
	CW_Отчеты.ДобавитьОтборКомпоновкиДанных("ВидСубъекта", ВидСравненияКомпоновкиДанных.Равно, ВидСубъекта, Истина, ПредопределенныеЗначенияПараметров.Отбор);
	// --- 
	_УправлениеЭлементамиФормы_КонтрольЗаполнения();
	_УправлениеЭлементамиФормы_ПредопределенныеЗначенияПараметров();
	_УправлениеЭлементамиФормы_Бюджет();
	
	ОбработатьВыборСтраницы();
	
	Если Параметры.Ключ.Пустая() Тогда
		//Времено на переходный период
		//Для новых объектов уже используется новый механизм хранения данных
		СлужебныйВыполненПереход = Истина;
		//Времено на переходный период
		
		//Предопределенные значения реквизитов шапки заказа и грузоперевозки
		ЗаполнитьСписокРеквизитовШапкиНаСервере();
		//Предопределенные значения реквизитов шапки заказа и грузоперевозки
	КонецЕсли;
	
	_УФС.ОтключитьИсториюВыбораЭлементовФормы(ЭтаФорма);
	
	УстановитьДоступностьСтраницПараметров();
	
	ЗаполнитьРеквизитыПутевыхЛистов();
	
	УстановитьВидимостьПараметра();
	
	//Внешние подклчюаемые команды
	CW_ПодключаемыеКомандыСервер.ПриСозданииНаСервере(ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	ЗаполнитьПредопределенныеЗначенияРеквизитов(ТекущийОбъект);
	
КонецПроцедуры   


&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	Для Каждого СтрокаТаблицы из Объект.ПредопределенныеЗначенияРеквизитов Цикл
		ИндексСтроки = Объект.ПредопределенныеЗначенияРеквизитов.Индекс(СтрокаТаблицы); 
		
		СтрокаОбъекта = ТекущийОбъект.ПредопределенныеЗначенияРеквизитов.Получить(ИндексСтроки); 
		
		ХранимоеЗначение = СтрокаТаблицы.ЗначениеРеквизита;
		Если ТипЗнч(СтрокаТаблицы.ЗначениеРеквизита) = тип("Строка") Тогда
			ХранимоеЗначение = СтрокаТаблицы.ЗначениеСтроковогоТипа;	
		КонецЕсли;
		
		СтрокаОбъекта.ХранилищеЗначения = Новый ХранилищеЗначения(ХранимоеЗначение);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	ЗаполнитьПредопределенныеЗначенияРеквизитов(ТекущийОбъект);
	
	_УправлениеЭлементамиФормы_ПредопределенныеЗначенияПараметров();
	
	УстановитьДоступностьСтраницПараметров();

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если (Элементы.СтраницаПараметровГрузоперевозок.Видимость) Тогда
		ДПГ_Обновить();	
		КонтрольЗаполненияРеквизитов = ЛОЖЬ;
		ПоказатьКонтрольЗаполненияГП();
	КонецЕсли; 
	// --- 
	Если (Элементы.СтраницаПараметровЗаявок.Видимость) Тогда
		ДПЗ_Обновить();	
		КонтрольЗаполненияЗаявки = ЛОЖЬ;
		ПоказатьКонтрольЗаполненияЗаявки();
	КонецЕсли;
	
	Если (Элементы.СтраницаПараметровЗаказа.Видимость) Тогда
		ДПЗаказ_Обновить();	
		КонтрольЗаполненияЗаказа = ЛОЖЬ;
		ПоказатьКонтрольЗаполненияЗаказа();;
	КонецЕсли;

	ДПГ_ВосстановитьСостояниеСвертки();
	ДПЗ_ВосстановитьСостояниеСвертки();
	ДПЗаказ_ВосстановитьСостояниеСвертки();
	
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
КонецПроцедуры

#КонецОбласти  


&наСервере
Процедура ЗаполнитьРеквизитыПутевыхЛистов()
	
	СписокРеквизитовПутевогоЛиста.Очистить();
	
	СписокРеквизитовПутевогоЛиста.Добавить(ПредопределенноеЗначение("Перечисление.CW_РеквизитыПутевыхЛистов.Номер"),,,БиблиотекаКартинок.CW_ЭлементСписка);
	СписокРеквизитовПутевогоЛиста.Добавить(ПредопределенноеЗначение("Перечисление.CW_РеквизитыПутевыхЛистов.Дата"),,,БиблиотекаКартинок.CW_ЭлементСписка);
	СписокРеквизитовПутевогоЛиста.Добавить(ПредопределенноеЗначение("Перечисление.CW_РеквизитыПутевыхЛистов.Прицеп"),,,БиблиотекаКартинок.CW_ЭлементСписка);
	СписокРеквизитовПутевогоЛиста.Добавить(ПредопределенноеЗначение("Перечисление.CW_РеквизитыПутевыхЛистов.ВыездФакт"),,,БиблиотекаКартинок.CW_ЭлементСписка);
