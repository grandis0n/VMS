#Область ДобавлениеЭлементов_Заявка 

&НаКлиенте
Процедура ДПЗ_ПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	Отказ = Истина;
	// --- 
	ПОВ = Новый ОписаниеОповещения("ДПЗ_ОбработкаВыбораПараметра",ЭтотОбъект); 
	
	ПарамерыФормыВыбора = Новый Структура;
	ПарамерыФормыВыбора.Вставить("Множественныйвыбор"	,Истина);
	
	ОткрытьФорму("ПланВидовХарактеристик.CW_ПараметрыГрузоперевозок.ФормаВыбора",ПарамерыФормыВыбора,Элемент,,,,ПОВ, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ДПЗ_ОбработкаВыбораПараметра(Ответ, ДополнительныеПараметры) Экспорт
	// --- 
	
	Если ТипЗнч(Ответ) = Тип("ПланВидовХарактеристикСсылка.CW_ПараметрыГрузоперевозок") Тогда
		Ответ = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Ответ);
	КонецЕсли;
	
	
	Если (Ответ <> Неопределено) Тогда
		Модифицированность = Истина;
		// --- 
		Для Каждого Параметр из Ответ Цикл
			
			Если ЭтоГруппа(Параметр) Тогда
				Продолжить;
			КонецЕсли;
			
			// проверяем, что параметр новый
			Если (ДПЗ_ДобавляемыйПараметрНовый(Параметр)) Тогда
				
				ИдентификаторДобавленнойСтроки = _ДПЗ_ДобавитьПараметр(Параметр);
				
				// ракрываем строку родителя, если свернута
				ДобавленнаяСтрока = ДПЗ.НайтиПоИдентификатору(ИдентификаторДобавленнойСтроки);
				РодительДобавленнойСтроки = ДобавленнаяСтрока.ПолучитьРодителя();
				Если (РодительДобавленнойСтроки <> Неопределено) Тогда
					
					ИдентификаторРодителяДобавленнойСтроки = РодительДобавленнойСтроки.ПолучитьИдентификатор();
					Если (НЕ Элементы.ДПЗ.Развернут(ИдентификаторРодителяДобавленнойСтроки)) Тогда
						Элементы.ДПЗ.Развернуть(ИдентификаторРодителяДобавленнойСтроки);
						ДПЗ_СохранитьСостояниеСверткиСтроки(ИдентификаторРодителяДобавленнойСтроки,Истина);
					КонецЕсли; 
					// --- 
					ДПЗ_ТекущаяГруппа = РодительДобавленнойСтроки.ИдентификаторГруппы;
					
				Иначе
					
					ДПЗ_ТекущаяГруппа = 0;
					
				КонецЕсли; 
				
				// позиционируемся на добавленный элемент
				Элементы.ДПЗ.ТекущаяСтрока = ИдентификаторДобавленнойСтроки;
				// --- 
				ДПЗ_ТекущийПараметр = ДобавленнаяСтрока.Параметр;
				
			КонецЕсли;
			
		КонецЦикла;
		
		// --- 
	КонецЕсли; 
	
	// --- 
КонецПроцедуры

&НаКлиенте
Функция ДПЗ_ДобавляемыйПараметрНовый(Параметр)
	// --- 
	
	Отбор = Новый Структура("Параметр",Параметр);
	СтрокиПараметра = Объект.ПараметрыЗаявки.НайтиСтроки(Отбор);
	Возврат(СтрокиПараметра.Количество()=0);
	
	// --- 
КонецФункции
  
&НаСервере
Функция ДПЗ_ТекущийРодитель()
	// --- 
	
	Если (Элементы.ДПЗ.ТекущаяСтрока <> Неопределено) Тогда
		
		ИдентификаторТекущейСтроки = Элементы.ДПЗ.ТекущаяСтрока;
		ТекущаяСтрока = ДПЗ.НайтиПоИдентификатору(ИдентификаторТекущейСтроки);
		РодительТекущейСтроки = ТекущаяСтрока.ПолучитьРодителя();
		Если (РодительТекущейСтроки <> Неопределено) Тогда
			Возврат(РодительТекущейСтроки);
		КонецЕсли; 
		
	КонецЕсли; 
	
	Возврат(ДПЗ);
	
	// --- 
КонецФункции

&НаСервере
Функция _ДПЗ_ДобавитьПараметр(Параметр,ПереносПараметров = ложь, ИдентификаторСтрокиРодителя=Неопределено)
	// --- 
	//Новый механизм
	ИдентификаторГруппыВладельца = Неопределено;
	//Новый механизм

	// добавляем в ТЧ параметров
	СтрокаТЧ = Объект.ПараметрыЗаявки.Добавить();
	СтрокаТЧ.Параметр = Параметр;
	
	Если ПереносПараметров Тогда
		
		Если ИдентификаторСтрокиРодителя <> Неопределено Тогда
			ТекущаяСтрока = ДПЗ.НайтиПоИдентификатору(ИдентификаторСтрокиРодителя);
			//Новый механизм
			ИдентификаторГруппыВладельца = ТекущаяСтрока.ИдентификаторГруппы;
			//Новый механизм
		Иначе
			ТекущаяСтрока = ДПЗ;
		Конецесли;
		
		ТР =  ТекущаяСтрока;
	Иначе
		// добавляем в дерево
		Если (Элементы.ДПЗ.ТекущаяСтрока <> Неопределено) Тогда
			ИдентификаторТекущейСтроки = Элементы.ДПЗ.ТекущаяСтрока;
			ТекущаяСтрока = ДПЗ.НайтиПоИдентификатору(ИдентификаторТекущейСтроки);
			Если (ТекущаяСтрока.ЭтоГруппа) Тогда
				ТР = ТекущаяСтрока;
			Иначе
				ТР = ДПЗ_ТекущийРодитель();	
			КонецЕсли; 
			
			//Новый механизм
			Если ТР <> ДПЗ Тогда
				ИдентификаторГруппыВладельца = ТР.ИдентификаторГруппы;
			КонецЕсли;
			//Новый механизм
		Иначе
			ТР = ДПЗ_ТекущийРодитель();	
		КонецЕсли; 
	КонецЕсли;
	
	//Новый механизм
	Если ИдентификаторГруппыВладельца <>  Неопределено Тогда
		ОтборСтрок = Новый Структура("Идентификатор",ТР.ИдентификаторГруппы);
		мСтрокиГрупп = Объект.ГруппыПараметровЗаявки.НайтиСтроки(ОтборСтрок);
		Если мСтрокиГрупп.Количество() > 0 Тогда
			СтрокаГруппы = мСтрокиГрупп[0];
			СтрокаТЧ.ИдентификаторВладельца = СтрокаГруппы.ИдентификаторГруппы; 	
		КонецЕсли;
	КонецЕсли; 
	//Новый механизм
	
	СтрокаДерева = ТР.ПолучитьЭлементы().Добавить();
	// заполняем строку дерева
	НаборПравДляПараметров = CW_ПраваДоступа.НаборПравДляПараметров();
	СтруктураПрав = НаборПравДляПараметров["п_"+_сф.КлючПоСсылке(Параметр)];
	_ДПЗ_ЗаполнитьСтрокуДереваПоПараметру(СтрокаДерева,Параметр,,СтруктураПрав);
	// записываем принадлежность параметра группе
	_ДПЗ_ДобавитьЭлементГруппы(Параметр, _ДПЗ_ОпределитьСтрокуГруппуСтрокиДерева(СтрокаДерева));
	// --- 
	Возврат(СтрокаДерева.ПолучитьИдентификатор());
	
	// --- 
КонецФункции

&НаСервере
Функция _ДПЗ_ОпределитьСтрокуГруппуСтрокиДерева(СтрокаДерева)
	// --- 
	
	РодительСтроки = СтрокаДерева.ПолучитьРодителя();
	Если (РодительСтроки = Неопределено) Тогда
		СтрокаГруппы = Объект.ГруппыПараметровЗаявки[0];
	Иначе
		Отбор = Новый Структура("Идентификатор", РодительСтроки.ИдентификаторГруппы);
		СтрокаГруппы = _сф.к_НайтиСтроку(Объект.ГруппыПараметровЗаявки, Отбор);
	КонецЕсли; 
	
	Возврат(СтрокаГруппы);
	
	// --- 
КонецФункции

&НаСервере
Процедура _ДПЗ_ДобавитьЭлементГруппы(Элемент, СтрокаГруппы, НовыйПредыдущий=Неопределено)
	// --- 
	
	МассивВедомых = ЗначениеИзСтрокиВнутр(СтрокаГруппы.ИдентификаторыВедомых);
	Если (НовыйПредыдущий =  Неопределено) Тогда
		МассивВедомых.Добавить(Элемент);
	Иначе
		
		ИндексПредыдущего = МассивВедомых.Найти(НовыйПредыдущий);
		Если (ИндексПредыдущего <> Неопределено) Тогда
			МассивВедомых.Вставить(ИндексПредыдущего,Элемент);
		Иначе
			МассивВедомых.Добавить(Элемент);
		КонецЕсли; 
		
	КонецЕсли; 
	СтрокаГруппы.ИдентификаторыВедомых = ЗначениеВСтрокуВнутр(МассивВедомых);
	Если (ТипЗнч(Элемент)=Тип("Число")) Тогда
		
		ДПЗ_ТекущаяГруппа = Элемент;
		ДПЗ_ТекущийПараметр = Неопределено;
		
	Иначе
		
		ДПЗ_ТекущаяГруппа = СтрокаГруппы.Идентификатор;
		ДПЗ_ТекущийПараметр = Элемент;
		
	КонецЕсли; 
	
	// --- 
КонецПроцедуры

&НаСервере
Процедура _ДПЗ_ПереместитьЭлементГруппы(Элемент, СтрокаГруппы, НовыйПредыдущий);
	// --- 
	
	МассивВедомых = ЗначениеИзСтрокиВнутр(СтрокаГруппы.ИдентификаторыВедомых);
	// --- 
	Если (НовыйПредыдущий = Неопределено ) Тогда
		
		ИндексЭлемента = МассивВедомых.Найти(Элемент);
		МассивВедомых.Удалить(ИндексЭлемента);
		МассивВедомых.Добавить(Элемент);
		
	Иначе
		
		ИндесНовогоПредыдущего = МассивВедомых.Найти(НовыйПредыдущий);
		ИндексЭлемента = МассивВедомых.Найти(Элемент);
		МассивВедомых.Удалить(ИндексЭлемента);
		МассивВедомых.Вставить(ИндесНовогоПредыдущего,Элемент);
		
	КонецЕсли; 
	// --- 
	СтрокаГруппы.ИдентификаторыВедомых = ЗначениеВСтрокуВнутр(МассивВедомых);
	
	// --- 
КонецПроцедуры

&НаСервере
Процедура _ДПЗ_УдалитьЭлементГруппы(Элемент, СтрокаГруппы)
	// --- 
	
	МассивВедомых = ЗначениеИзСтрокиВнутр(СтрокаГруппы.ИдентификаторыВедомых);
	МассивВедомых.Удалить(МассивВедомых.Найти(Элемент));
	СтрокаГруппы.ИдентификаторыВедомых = ЗначениеВСтрокуВнутр(МассивВедомых);
	
	// --- 
КонецПроцедуры
 
#КонецОбласти 

#Область ДобавлениеГруппЭлементов_Заявка

&НаКлиенте
Процедура ДПЗ_ДобавитьГруппу(Команда)
	
	// спрашиваем название группы
	ПараметрыФормы = Новый Структура("НоваяГруппа,РежимГрузоперевозки,ДоступнаСменаРежимаСвертки", Истина,Ложь,Истина);

	ПОВ = Новый ОписаниеОповещения("ДПЗ_ОбработатьВводНаименованияГруппы",ЭтотОбъект, Новый Структура()); 
	ОткрытьФорму("ПланВидовХарактеристик.CW_ПараметрыГрузоперевозок.Форма.ФормаВиртуальнойГруппы",ПараметрыФормы,,,,,ПОВ,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ДПЗ_ОбработатьВводНаименованияГруппы(Ответ, ДополнительныеПараметры) Экспорт 
	// --- 
	
	Если (Ответ <> Неопределено) Тогда
		Модифицированность = истина;
		РедактированиеГруппы = Ложь;
		ДополнительныеПараметры.Свойство("Редактирование",РедактированиеГруппы);
		Если (РедактированиеГруппы = Неопределено ) Тогда
			РедактированиеГруппы = Ложь;
		КонецЕсли; 
		Если (РедактированиеГруппы) Тогда
			
			ИдентификаторСтроки = _ДПЗ_ОбновитьГруппу(Элементы.ДПЗ.ТекущаяСтрока,Ответ);
			
		Иначе
			
			ИдентификаторСтроки = _ДПЗ_ДобавитьГруппу(Ответ);	
			
		КонецЕсли; 
		
		ИдентификаторГруппы = ДПЗ.НайтипоИдентификатору(ИдентификаторСтроки).ИдентификаторГруппы;
		ДПЗ_УстановитьСостояниеСверткиСтроки(ИдентификаторСтроки, ИдентификаторГруппы, Ответ.ГруппаРазвернута);
	//	ДПЗ_ВосстановитьСостояниеСверткиСтроки(ИдентификаторСтроки);
		
	КонецЕсли; 
	
	// --- 
КонецПроцедуры

&НаСервере
Функция _ДПЗ_ОбновитьГруппу(ИдентификаторСтрокиДерева,СтруктураПараметров)
	// --- 
	
	СтрокаДерева = ДПЗ.НайтиПоИдентификатору(ИдентификаторСтрокиДерева);
	СтрокаГруппы = _сф.к_НайтиСтроку(Объект.ГруппыПараметровЗаявки,Новый Структура("Идентификатор",СтрокаДерева.ИдентификаторГруппы));
	
	СтрокаГруппы.Наименование 			= СтруктураПараметров.НаименованиеГруппы;
	СтрокаГруппы.Раскрывать 			= СтруктураПараметров.ГруппаРазвернута;
	// --- 
	_ДПЗ_ЗаполнитьСтрокуДереваПоГруппе(СтрокаДерева, СтрокаГруппы);
	
	Возврат(ИдентификаторСтрокиДерева);
	
	// --- 
КонецФункции
 

&НаСервере
Функция _ДПЗ_ДобавитьГруппу(СтруктураПараметров, ИдентификаторГруппыРодителя= Неопределено)
	// --- 
	//Новый механизм
	ИдентификаторГруппыВладельца = Неопределено;
	//Новый механизм

	// создаем строку ТЧ
	СтрокаГруппы = Объект.ГруппыПараметровЗаявки.Добавить();
	СтрокаГруппы.Идентификатор 			= _ДПЗ_ИдентификаторНовойГруппы();
	
	СтрокаГруппы.Наименование 			= СтруктураПараметров.НаименованиеГруппы;
	СтрокаГруппы.Раскрывать 			= СтруктураПараметров.ГруппаРазвернута;
	
	СтрокаГруппы.ИдентификаторыВедомых 	= ЗначениеВСтрокуВнутр(Новый Массив);
	// --- 
	// создаем строку дерева
	Если ИдентификаторГруппыРодителя = Неопределено Тогда
		Если (Элементы.ДПЗ.ТекущаяСтрока <> Неопределено) Тогда
			ИдентификаторТекущейСтроки = Элементы.ДПЗ.ТекущаяСтрока;
			ТекущаяСтрока = ДПЗ.НайтиПоИдентификатору(ИдентификаторТекущейСтроки);
			Если (ТекущаяСтрока.ЭтоГруппа) Тогда
				ТР = ТекущаяСтрока;
			Иначе
				ТР = ДПЗ_ТекущийРодитель();	
			КонецЕсли; 
			
			//Новый механизм
			Если ТР <> ДПЗ Тогда
				ИдентификаторГруппыВладельца = ТР.ИдентификаторГруппы;
			КонецЕсли;
			//Новый механизм
			
		Иначе
			ТР = ДПЗ_ТекущийРодитель();	
		КонецЕсли; 
	Иначе
		ТР = ДПЗ.НайтиПоИдентификатору(ИдентификаторГруппыРодителя);
		
		//Новый механизм
		Если ТР <> Неопределено Тогда
			ИдентификаторГруппыВладельца = ТР.ИдентификаторГруппы;
		КонецЕсли;
		//Новый механизм
		
	КонецЕсли;
	
	//Новый механизм
	СтрокаГруппы.ИдентификаторГруппы = Новый УникальныйИдентификатор;
	Если ИдентификаторГруппыВладельца <>  Неопределено Тогда
		ОтборСтрок = Новый Структура("Идентификатор",ИдентификаторГруппыВладельца);
		мСтрокиГрупп = Объект.ГруппыПараметровЗаявки.НайтиСтроки(ОтборСтрок);
		Если мСтрокиГрупп.Количество() > 0 Тогда
			СтрокаГруппыВладельца = мСтрокиГрупп[0];
			СтрокаГруппы.ИдентификаторВладельца = СтрокаГруппыВладельца.ИдентификаторГруппы; 	
		КонецЕсли;
	КонецЕсли;
	//Новый механизм
	
	// --- 
	СтрокаДерева = ТР.ПолучитьЭлементы().Добавить();
	// заполняем
	_ДПЗ_ЗаполнитьСтрокуДереваПоГруппе(СтрокаДерева, СтрокаГруппы);
	// добавляем в массив элементов родителя
	_ДПЗ_ДобавитьЭлементГруппы(СтрокаГруппы.Идентификатор, _ДПЗ_ОпределитьСтрокуГруппуСтрокиДерева(СтрокаДерева));
	// --- 
	Возврат(СтрокаДерева.ПолучитьИдентификатор());
	
	// --- 
КонецФункции

&НаСервере
Функция _ДПЗ_ИдентификаторНовойГруппы()
	// --- 
	
	ТЗИ = Объект.ГруппыПараметровЗаявки.Выгрузить(,"Идентификатор");
	ТЗИ.Сортировать("Идентификатор Возр");
	ПоследнийИдентификатор = _сф.к_ПоследнийЭлемент(ТЗИ).Идентификатор;
	НовыйИдентификатор = ПоследнийИдентификатор+1;
	Возврат(НовыйИдентификатор);
	
	// --- 
КонецФункции
 

#КонецОбласти 

#Область УдалениеЭлементов_Заявка 

&НаКлиенте
Процедура ДПЗ_ПередУдалением(Элемент, Отказ)
	
	Отказ = Истина;
	// --- 
	Идентификатор = Элементы.ДПЗ.ТекущаяСтрока;
	СтрокаДерева = ДПЗ.НайтиПоИдентификатору(Идентификатор);
	// --- 
	Если (СтрокаДерева.УдалениеРазрешено) Тогда
		
		Модифицированность = истина;
		
		Если (СтрокаДерева.ЭтоГруппа) Тогда
			
			Если (СтрокаДерева.ПолучитьЭлементы().Количество() <> 0) Тогда
				
				ПОВ = Новый ОписаниеОповещения("ДПЗ_ОбработкаПодтвержденияУдаленияГруппы",ЭтотОбъект, Новый Структура()); 
				ПоказатьВопрос(ПОВ,"Группа будет удалена вместе с параметрами. Продолжить?", РежимДиалогаВопрос.ДаНет);
				
			Иначе
				
				ДПЗ_УдалитьСтрокуДерева(Идентификатор);
				
			КонецЕсли; 
			
		Иначе
			
			ДПЗ_УдалитьСтрокуДерева(Идентификатор);
			
		КонецЕсли; 
		
	Иначе
		
		_УФК.ВывестиПредупреждение("Недостаточно прав для данного действия");
		Возврат;
		
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ДПЗ_ОбработкаПодтвержденияУдаленияГруппы(Ответ, ДополнительныеПараметры) Экспорт 
	// --- 
	
	Если (Ответ <> Неопределено) Тогда
		
		Если (Ответ = КодВозвратаДиалога.Да) Тогда
			
			ДПЗ_УдалитьСтрокуДерева(Элементы.ДПЗ.ТекущаяСтрока);
			
		КонецЕсли; 
		
	КонецЕсли; 
	
	// --- 
КонецПроцедуры
  
&НаКлиенте
Процедура ДПЗ_УдалитьСтрокуДерева(Идентификатор)
	// --- 
	
	НоваяТекущаяСтрока = Неопределено;
	// --- 
	СтрокаДерева = ДПЗ.НайтиПоИдентификатору(Идентификатор);
	РодительСтрокиДерева = СтрокаДерева.ПолучитьРодителя();
	Если (РодительСтрокиДерева = Неопределено) Тогда
		КоллекцияСтрок = ДПЗ.ПолучитьЭлементы();
	Иначе
		КоллекцияСтрок = РодительСтрокиДерева.ПолучитьЭлементы();
	КонецЕсли; 
	КоличествоЭлементовКоллекции = КоллекцияСтрок.Количество();
	Если (КоличествоЭлементовКоллекции > 1) Тогда
		
		// получаем индекс
		ИндексУдаляемойСтроки = КоллекцияСтрок.Индекс(СтрокаДерева);
		Если (ИндексУдаляемойСтроки <> КоличествоЭлементовКоллекции-1) Тогда
			НоваяТекущаяСтрока = КоллекцияСтрок[ИндексУдаляемойСтроки+1].ПолучитьИдентификатор();
		Иначе 
			НоваяТекущаяСтрока = КоллекцияСтрок[ИндексУдаляемойСтроки-1].ПолучитьИдентификатор();
		КонецЕсли; 
		
	Иначе
		
		Если (РодительСтрокиДерева <> Неопределено) Тогда
			
			НоваяТекущаяСтрока = РодительСтрокиДерева.ПолучитьИдентификатор();
			
		КонецЕсли; 
		
	КонецЕсли; 
	
	// удаляем рекурсивно группы/параметры
	Результат = _ДПЗ_УдалитьПараметрыРекурсивно(Идентификатор);
	Если (_УФКС.ВыполненоУспешно(Результат)) Тогда
		
		// удаляем строку дерева
		_ДПЗ_УдалитьСтрокуДерева(Идентификатор);
		
		Если (НоваяТекущаяСтрока <> Неопределено ) Тогда
			
			Элементы.ДПЗ.ТекущаяСтрока = НоваяТекущаяСтрока;
			
		КонецЕсли; 
		
	КонецЕсли; 
	
	// --- 
КонецПроцедуры

&НаСервере
Функция _ДПЗ_УдалитьПараметрыРекурсивно(ИдентификаторСтроки)
	// --- 
	
	СтрокаДерева = ДПЗ.НайтиПоИдентификатору(ИдентификаторСтроки);
	Если (СтрокаДерева.ЭтоГруппа) Тогда
		ЭлементДПЗ = СтрокаДерева.ИдентификаторГруппы;
	Иначе
		ЭлементДПЗ = СтрокаДерева.Параметр;
	КонецЕсли; 
	
	// удаляем из родителя
	РодительСтрокиДерева = СтрокаДерева.ПолучитьРодителя();
	Если (РодительСтрокиДерева = Неопределено) Тогда
		СтрокаГруппы = Объект.ГруппыПараметровЗаявки[0];
	Иначе
		СтрокаГруппы = _сф.к_НайтиСтроку(Объект.ГруппыПараметровЗаявки,Новый Структура("Идентификатор", РодительСтрокиДерева.ИдентификаторГруппы));
	КонецЕсли; 
	_ДПЗ_УдалитьЭлементГруппы(ЭлементДПЗ, СтрокаГруппы);
	
	// физически удаляем
	_ДПЗ_УдалитьЭлементДПЗ(ЭлементДПЗ);
	// --- 
	Возврат(_УФКС.Ответ());
	
	// --- 
КонецФункции

&НаСервере
Процедура _ДПЗ_УдалитьЭлементДПЗ(ЭлементДПЗ)
	// --- 
	
	Если (ТипЗнч(ЭлементДПЗ)=Тип("Число")) Тогда
		
		СтрокаГруппы = _сф.к_НайтиСтроку(Объект.ГруппыПараметровЗаявки,Новый Структура("Идентификатор", ЭлементДПЗ));
		МассивВедомых = ЗначениеИзСтрокиВнутр(СтрокаГруппы.ИдентификаторыВедомых);
		Для каждого Ведомый Из МассивВедомых Цикл
			
			_ДПЗ_УдалитьЭлементДПЗ(Ведомый);
			
		КонецЦикла; 
		// --- 
		Объект.ГруппыПараметровЗаявки.Удалить(Объект.ГруппыПараметровЗаявки.Индекс(СтрокаГруппы));
		
	Иначе
		
		СтрокаПараметра = _сф.к_НайтиСтроку(Объект.ПараметрыЗаявки,Новый Структура("Параметр",ЭлементДПЗ));
		Объект.ПараметрыЗаявки.Удалить(Объект.ПараметрыЗаявки.Индекс(СтрокаПараметра));
		
	КонецЕсли; 
	
	// --- 
КонецПроцедуры
 

