&НаКлиенте
Процедура ПредопределенныеЗначенияРеквизитовВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = ложь;
	ОткрытьФормуРедактированияЗначения(ВыбраннаяСтрока);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуРедактированияЗначения(ВыбраннаяСтрока)
	
	Если ВыбраннаяСтрока <> Неопределено Тогда
		
		ТекущиеДанные = Объект.ПредопределенныеЗначенияРеквизитов.НайтиПоИдентификатору(ВыбраннаяСтрока);
		
		ОписаниеОпвещения = Новый ОписаниеОповещения("ЗавершитьРедактированияЗначенияРеквизитаШапки", ЭтотОбъект, ВыбраннаяСтрока);
		
		ЗначениеРеквизита = ТекущиеДанные.ЗначениеРеквизита;
		Если ТекущиеДанные.ИмяРеквизита = "Содержание"
			Или ТекущиеДанные.ИмяРеквизита = "Примечание" Тогда
			ЗначениеРеквизита = ТекущиеДанные.ЗначениеСтроковогоТипа;
		КонецЕсли;
		
		СтруктураПараметров = новый Структура;
		СтруктураПараметров.Вставить("ДляГрузоперевозки", 		ТекущиеДанные.ДляГрузоперевозки);
		СтруктураПараметров.Вставить("ДляЗаказа", 				ТекущиеДанные.ДляЗаказа);
		СтруктураПараметров.Вставить("ДляЗаявки", 				ТекущиеДанные.ДляЗаявки);
		СтруктураПараметров.Вставить("ЗначениеРеквизита", 		ЗначениеРеквизита);
		СтруктураПараметров.Вставить("ИмяРеквизита", 			ТекущиеДанные.ИмяРеквизита);
		СтруктураПараметров.Вставить("СинонимРеквизита", 		ТекущиеДанные.СинонимРеквизита);
		СтруктураПараметров.Вставить("ПерезаполнятьЗначение", 	ТекущиеДанные.ПерезаполнятьЗначение);
	
		ОткрытьФорму("Справочник.CW_ТипыПеревозок.Форма.ФормаРедактированияСтрокиЗначенийРеквизитов", СтруктураПараметров, ЭтаФорма,,,,ОписаниеОпвещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	КонецЕсли;

КонецПроцедуры  

&НаКлиенте
Процедура ЗавершитьРедактированияЗначенияРеквизитаШапки(Результат, ИдентификаторСтроки) Экспорт
	
	Если Результат <> Неопределено Тогда
		СтрокаТаблицы = Объект.ПредопределенныеЗначенияРеквизитов.НайтиПоИдентификатору(ИдентификаторСтроки);
		
		ЗаполнитьЗначенияСвойств(СтрокаТаблицы, Результат);  
		
		Если СтрокаТаблицы.ИмяРеквизита = "Содержание" 
			ИЛИ СтрокаТаблицы.ИмяРеквизита = "Примечание" Тогда
			СтрокаТаблицы.ЗначениеСтроковогоТипа = Результат.ЗначениеРеквизита;
		КонецЕсли;   
		
		Модифицированность = Истина;
	КонецЕсли;
	
	
КонецПроцедуры  

&НаКлиенте
Процедура ПредопределенныеЗначенияРеквизитовПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	Отказ = Истина;
	
	Режим = РежимДиалогаВопрос.ДаНет;
	Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаПриДобавлении", ЭтотОбъект);
	ПоказатьВопрос(Оповещение, "Нельзя добавлить строки табличной части. Обновить список доступных реквизитов?", Режим, 0);

КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияВопросаПриДобавлении(Результат, Параметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьСписокРеквизитовШапкиНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ПредопределенныеЗначенияРеквизитовПередУдалением(Элемент, Отказ)
	
	Отказ = Истина;
	
	Режим = РежимДиалогаВопрос.ДаНет;
	Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаПриУдалении", ЭтотОбъект, Элементы.ПредопределенныеЗначенияРеквизитов.ТекущаяСтрока);
	ПоказатьВопрос(Оповещение, "Нельзя удалать строки табличной части. Очистить значение в текущей строке?", Режим, 0);
	
КонецПроцедуры 

&НаКлиенте
Процедура ПослеЗакрытияВопросаПриУдалении(Результат, ИдентификаторСтроки) Экспорт
	
	Если Результат = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;
	
	Если ИдентификаторСтроки <> Неопределено Тогда
		НайденнаяСтрока  = Объект.ПредопределенныеЗначенияРеквизитов.НайтиПоИдентификатору(ИдентификаторСтроки);
		Если НайденнаяСтрока <> Неопределено Тогда
			НайденнаяСтрока.ЗначениеРеквизита 	= Неопределено;
			НайденнаяСтрока.ДляГрузоперевозки 	= Ложь;
			НайденнаяСтрока.ДляЗаказа 			= Ложь;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

