Процедура ДПЗ_ВосстановитьСостояниеСвертки()
	// --- 
	
	тЭлементы = ДПЗ.ПолучитьЭлементы();
	ДПЗ_ВосстановитьСостояниеСверткиРекунсивно(тЭлементы);

	
	// --- 
КонецПроцедуры

&НаКлиенте
Процедура ДПЗ_ВосстановитьСостояниеСверткиРекунсивно(тЭлементы)
	
	Для каждого тЭлемент Из тЭлементы Цикл
		
		тПодчиненные = тЭлемент.ПолучитьЭлементы();
		ДПЗ_ВосстановитьСостояниеСверткиРекунсивно(тПодчиненные);
		
		ДПЗ_ВосстановитьСостояниеСверткиСтроки(тЭлемент.ПолучитьИдентификатор());
		
	КонецЦикла; 
	
КонецПроцедуры


&НаКлиенте
Процедура ДПЗ_ВосстановитьСостояниеСверткиСтроки(Идентификатор)
	
	СтрокаДерева = ДПЗ.НайтиПоИдентификатору(Идентификатор);
	
	ЭлементСостояния = ДПЗ_СостояниеСвертки.НайтиПоЗначению(СтрокаДерева.ИдентификаторГруппы);
	
	Если ЭлементСостояния <> Неопределено Тогда
		
		Если ЭлементСостояния.Пометка Тогда
			Элементы.ДПЗ.Развернуть(СтрокаДерева.ПолучитьИдентификатор());
		Иначе
			Элементы.ДПЗ.Свернуть(СтрокаДерева.ПолучитьИдентификатор());
		конецЕсли;
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Функция ДПЗ_СохранитьСостояниеСверткиСтроки(ИдентификаторСтроки,Признак)
	// --- 
	
	СтрокаДерева = ДПЗ.НайтиПоИдентификатору(ИдентификаторСтроки);
	Если (СтрокаДерева = Неопределено) Тогда
		Возврат(Неопределено);
	КонецЕсли; 
	// --- 
	СтрокиГрупп = Объект.ГруппыПараметровЗаявки.НайтиСтроки(Новый Структура("Идентификатор",СтрокаДерева.ИдентификаторГруппы));
	Если (СтрокиГрупп.Количество() <> 0) Тогда
		СтрокаГруппы = СтрокиГрупп[0];
		СтрокаГруппы.Раскрывать = Признак;
	КонецЕсли; 
	// --- 
	ЭлементСостояния = ДПЗ_СостояниеСвертки.НайтиПоЗначению(СтрокаДерева.ИдентификаторГруппы);
	Если (ЭлементСостояния = Неопределено) Тогда
		ЭлементСостояния = ДПЗ_СостояниеСвертки.Добавить(СтрокаДерева.ИдентификаторГруппы);
	КонецЕсли; 
	ЭлементСостояния.Представление = Формат(ИдентификаторСтроки,"ЧДЦ=; ЧН=; ЧГ=");
	ЭлементСостояния.Пометка = Признак;
	
	// --- 
КонецФункции

