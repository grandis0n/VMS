&НаКлиенте
Процедура ДПЗаказ_ВыполнитьПодгрузкуСтрок(ИдентификаторСтрокиРодителя)
	// --- 
	
	СтрокаДерева = ДПЗаказ.НайтиПоИдентификатору(ИдентификаторСтрокиРодителя);
	СтрокаДерева.ПолучитьЭлементы().Очистить();
	_ДПЗаказ_ВыполнитьПодгрузку(ИдентификаторСтрокиРодителя);
	// --- 
	
	ДПЗаказ_ВосстановитьСостояниеСверткиСтроки(ИдентификаторСтрокиРодителя);
	// --- 
	Элементы.ДПЗаказ.Развернуть(ИдентификаторСтрокиРодителя);
	ДПЗаказ_СохранитьСостояниеСверткиСтроки(ИдентификаторСтрокиРодителя, Истина);
	
	// --- 
