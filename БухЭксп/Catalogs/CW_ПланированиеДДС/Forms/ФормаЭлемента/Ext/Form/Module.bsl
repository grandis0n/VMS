&НаСервере
Процедура ВидОперацииПлатежногоПорученияПриИзмененииНаСервере()

	Если Объект.ВидДвижения = ПредопределенноеЗначение("Перечисление.CW_ВидыДвиженияДДС.Приход")
		ИЛИ (Объект.ВидДвижения = ПредопределенноеЗначение("Перечисление.CW_ВидыДвиженияДДС.Расход") 
		и Объект.ВидОперацииПлатежногоПоручения = ПредопределенноеЗначение("Перечисление.ВидыОперацийСписаниеДенежныхСредств.ВозвратПокупателю") ) Тогда 
		
		Массив	= Новый Массив;
		Массив.Добавить(Новый ПараметрВыбора("Отбор.ВидДоговора", ПредопределенноеЗначение("Перечисление.ВидыДоговоровКонтрагентов.СПокупателем")));
		Элементы.Договор.ПараметрыВыбора = Новый ФиксированныйМассив(Массив);

	ИначеЕсли Объект.ВидДвижения = ПредопределенноеЗначение("Перечисление.CW_ВидыДвиженияДДС.Расход") Тогда  
		
		Массив	= Новый Массив();
		Массив.Добавить(Новый ПараметрВыбора("Отбор.ВидДоговора", ПредопределенноеЗначение("Перечисление.ВидыДоговоровКонтрагентов.СПоставщиком")));
		Элементы.Договор.ПараметрыВыбора = Новый ФиксированныйМассив(Массив);

	КонецЕсли;

КонецПроцедуры


