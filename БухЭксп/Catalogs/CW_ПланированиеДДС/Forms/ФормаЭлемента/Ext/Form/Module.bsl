&НаКлиенте
Процедура ДатаПриИзменении(Элемент)
	
	Если НачалоДня(Объект.Дата) = НачалоДня(ТекущаяДатаДокумента) Тогда
		// Изменение времени не влияет на поведение документа.
		ТекущаяДатаДокумента = Объект.Дата;
		Возврат;
	КонецЕсли;
	
	Если Год(Объект.Дата) <> Год(ТекущаяДатаДокумента) Тогда
		//Изменился год документа
		Объект.Код = "";
		ТекущаяДатаДокумента = Объект.Дата;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСумму(Команда)  
	
	Если Объект.ВариантЗаполненияРасшифровки = 0 Тогда
		ПараметрыПолученияСуммы = Новый Структура;
		ПараметрыПолученияСуммы.Вставить("ДатаСреза", Объект.Дата);
		ПараметрыПолученияСуммы.Вставить("ДокументОснование", Объект.ДокументОснование);
		ПараметрыПолученияСуммы.Вставить("Валюта", Объект.Валюта);
		
		Объект.Сумма = ПолучитьСуммуЗаявкиНаСервере(ПараметрыПолученияСуммы); 
	Иначе
		РассчитатьСуммаЗаявки();   
		
	КонецЕсли;                    
	
	ЗаполнитьСуммуВсегоНаСервере();
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьСуммуЗаявкиНаСервере(ПараметрыПолученияСуммы)
	
	Если Не ЗначениеЗаполнено(ПараметрыПолученияСуммы.ДокументОснование) Тогда
		Возврат 0;
	КонецЕсли;
	
	ВалютаРегламентированногоУчета = Константы.ВалютаРегламентированногоУчета.Получить();
	
	Если ТипЗнч(ПараметрыПолученияСуммы.ДокументОснование) = Тип("ДокументСсылка.CW_РасходыПоГрузоперевозке") Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	CW_ОперативнаяКредиторскаяЗадолженностьОстатки.Счет КАК Счет,
		               |	CW_ОперативнаяКредиторскаяЗадолженностьОстатки.Всего_ВалютаОстаток КАК Всего_ВалютаОстаток,
		               |	CW_ОперативнаяКредиторскаяЗадолженностьОстатки.ВсегоОстаток КАК ВсегоОстаток
		               |ИЗ
		               |	РегистрНакопления.CW_ОперативнаяКредиторскаяЗадолженность.Остатки(&ДатаСреза, Счет = &ДокументОснование) КАК CW_ОперативнаяКредиторскаяЗадолженностьОстатки";
		
		Запрос.УстановитьПараметр("ДатаСреза", Новый Граница(КонецДня(ПараметрыПолученияСуммы.ДатаСреза), ВидГраницы.Включая));
		Запрос.УстановитьПараметр("ДокументОснование", ПараметрыПолученияСуммы.ДокументОснование);
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			Если ПараметрыПолученияСуммы.Валюта = ВалютаРегламентированногоУчета Тогда
				Возврат Выборка.ВсегоОстаток;
			Иначе
				Возврат Выборка.Всего_ВалютаОстаток;
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат 0;
	
КонецФункции

