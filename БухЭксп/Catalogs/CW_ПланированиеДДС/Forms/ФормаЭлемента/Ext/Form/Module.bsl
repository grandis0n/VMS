&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)       
	
	ИспользуетсяПрогнозированиеДДСПоБюджету = ПолучитьФункциональнуюОпцию("CW_ИспользуетсяПрогнозированиеДДСПоБюджету");
	
	ПолныеПрава = CW_ПраваДоступа.ЭтоПолноправныйПользователь(ПараметрыСеанса.ТекущийПользователь, Истина);
	Если НЕ ПолныеПрава Тогда
		ГруппаПользователя = CW_ПраваДоступа_ПИ.ГруппаПользователя(ПараметрыСеанса.ТекущийПользователь);
		Если ГруппаПользователя = Справочники.CW_ГруппыПользователей.Администраторы ИЛИ 
			ГруппаПользователя.ПолныеПрава 
			Тогда
			ПолныеПрава = Истина;
		КонецЕсли;
	КонецЕсли;
	
	РольФинансовогоКонтролера 	= CW_ПраваДоступа.ПравоДоступно("РольФинансовогоКонтролера");
	
	Элементы.ВидОперацииПлатежногоПоручения.Видимость  	= Объект.ВидДвижения = ПредопределенноеЗначение("Перечисление.CW_ВидыДвиженияДДС.Расход");
	Элементы.СтавкаНДС.Видимость  						= Объект.ВидДвижения = ПредопределенноеЗначение("Перечисление.CW_ВидыДвиженияДДС.Расход");
	Элементы.СуммаНДС.Видимость  						= Объект.ВидДвижения = ПредопределенноеЗначение("Перечисление.CW_ВидыДвиженияДДС.Расход");

	Элементы.ГруппаПланОплатыБлокировка.ТолькоПросмотр = НЕ РольФинансовогоКонтролера;
	
	Если ПолныеПрава Тогда
		мДоступныеСтатьиПланирования = CW_ПланированиеДДС.ПолучитьвсеСтатьиДДС(Объект.ВидДвижения);
	Иначе
		мДоступныеСтатьиПланирования = CW_ПланированиеДДС.ИспользованиеСтатейДДС(ГруппаПользователя,Объект.ВидДвижения);
	КонецЕсли;
	
	СписокДоступныхСтатей.ЗагрузитьЗначения(мДоступныеСтатьиПланирования);
	
	Если Параметры.Ключ.Пустая() Тогда
		Объект.Дата		= ТекущаяДата();	
		Объект.Автор	= ПараметрыСеанса.ТекущийПользователь;	
		Если Не ЗначениеЗаполнено(Объект.Офис) Тогда
			Объект.Офис	= CW_ПланированиеДДС.ПолучитьОфис(ПараметрыСеанса.ТекущийПользователь);	
		КонецЕсли;
	КонецЕсли;
	
	УстановитьДоступныеТипыДокументаОснования();

	ПолучитьСтатусОбъекта();
	
	РеестрПлатежей = КритерииОтбора.CW_СтатьиПланированияПоРеестрам.ПолучитьРеестрПлатежей(Объект.Ссылка);
	
	Если НЕ РеестрПлатежей.Пустая() Тогда
		ТолькоПросмотр = Истина;
		Элементы.ЗаполнитьОснованиеОплаты.Доступность	= Ложь;
		Элементы.ЗаполнитьСрокОплаты.Доступность		= Ложь;
	КонецЕсли; 
	
	Элементы.НадписьРеестрПлатежей.Заголовок = Строка(РеестрПлатежей); 
	Элементы.НадписьРеестрПлатежей.Видимость = Не РольФинансовогоКонтролера и НЕ РеестрПлатежей.Пустая();
	Элементы.РеестрПлатежей.Видимость 		 = РольФинансовогоКонтролера и НЕ РеестрПлатежей.Пустая();
	Элементы.РасчетныйСчетКонтрагента.Видимость = ?(Объект.ВидДвижения = Перечисления.CW_ВидыДвиженияДДС.Расход, Истина,Ложь);
	
	ДанныеДоговора = CW_ПланированиеДДССервер.ПолучитьДанныеДоговора(Объект.Договор);
	ВалютаДоговора				= ДанныеДоговора.ВалютаДоговора;
	СтрВалютаДоговора 			= Строка(ДанныеДоговора.ВалютаДоговора)+ ?(ДанныеДоговора.РасчетыВУсловныхЕдиницах, " (у.е.)", ""); 
	
	ТекущаяДатаДокумента = Объект.Дата;
	ТекущаяОрганизация = Объект.Организация;
	
	Если ЗначениеЗаполнено(Объект.Организация) 
		И ЗначениеЗаполнено(Объект.ДокументОснование) 
		И (ТипЗнч(Объект.ДокументОснование) = Тип("ДокументСсылка.CW_РасходыПоГрузоперевозке") 
		ИЛИ ТипЗнч(Объект.ДокументОснование) = Тип("ДокументСсылка.CW_ДоходыПоГрузоперевозке")) Тогда
		
		ЗаполнитьПараметрыПланированияНаСервере();
		
	КонецЕсли;    
	
	ВидОперацииПлатежногоПорученияПриИзмененииНаСервере();

	//Для версии КОРП
	ВестиУчетПоПодразделениям					= ПолучитьФункциональнуюОпцию("ВестиУчетПоПодразделениям");
	Элементы.ПодразделениеОрганизации.Видимость	= ВестиУчетПоПодразделениям;
	//Для версии КОРП
	
	УстановитьВидимостьКнопкиЗаполнитьСодержание();
	ВариантЗаполненияРасшифровкиПриИзмененииНаСервере();
	
	//Подсистема.СтатусыДокументов
	CW_СтатусыДокументовСервер.ПриСозданииНаСервере(ЭтаФорма,Отказ, СтандартнаяОбработка);
	//Подсистема.СтатусыДокументов

	//Наличие прикрепленных файлов
	_УФКС.УстановитьНаличиеПрикрепленныхФайловПриСозданииФормыНаСервере(ЭтаФорма);
	//Наличие прикрепленных файлов
	
	//Подсистема.УчетПриложенийДоговоров
	CW_УчетПриложенийДоговоровСервер.ПриСозданииНаСервере(ЭтаФорма, Отказ, СтандартнаяОбработка);
	//Подсистема.УчетПриложенийДоговоров   
	
	//Подсистема.ДополнительныеРеквизиты
	ИспользоватьДопРеквизиты = CW_ДополнительныеРеквизитыСлужебный.ИспользуютсяДополниительныеРеквизиты();
	//Подсистема.ДополнительныеРеквизиты
	
	// СтандартныеПодсистемы.Свойства
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ИмяЭлементаДляРазмещения", "ГруппаДополнительныеРеквизиты");
	ДополнительныеПараметры.Вставить("ПроизвольныйОбъект", НЕ ИспользоватьДопРеквизиты); 
	УправлениеСвойствами.ПриСозданииНаСервере(ЭтотОбъект, ДополнительныеПараметры);
	// Конец СтандартныеПодсистемы.Свойства
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьКнопкиЗаполнитьСодержание()
	
	Если ПараметрыПланирования <> Неопределено Тогда
		Элементы.ЗаполнитьСодержание.Видимость = Объект.ВидДвижения = ПредопределенноеЗначение("Перечисление.CW_ВидыДвиженияДДС.Расход") 
				И ПараметрыПланирования.ИспользоватьАвтоматическоеПланирование 
				И ЗначениеЗаполнено(Объект.ДокументОснование)
				И (ТипЗнч(Объект.ДокументОснование) = Тип("ДокументСсылка.CW_РасходыПоГрузоперевозке") 
				ИЛИ ТипЗнч(Объект.ДокументОснование) = Тип("ДокументСсылка.CW_ДоходыПоГрузоперевозке"));
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПараметрыПланированияНаСервере()
	
	Если Объект.ДокументОснование <> Неопределено Тогда
		
		ИмяРеквизита = "Дата";
		Если ОбщегоНазначения.ЕстьРеквизитОбъекта("ДатаСчета", Объект.ДокументОснование.Метаданные()) Тогда
			ИмяРеквизита = "ДатаСчета";
		КонецЕсли;
		
		ПараметрыПланирования = РегистрыСведений.CW_ПараметрыПланированияДДС.ПолучитьПараметрыПланирования(Объект.Организация, Объект.ДокументОснование[ИмяРеквизита]);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	УстановитьЗаголовокФормы();

	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствамиКлиент.ПослеЗагрузкиДополнительныхРеквизитов(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.Свойства

КонецПроцедуры

&НаКлиенте
Процедура УстановитьЗаголовокФормы()
	
	Если Объект.ВидДвижения = ПредопределенноеЗначение("Перечисление.CW_ВидыДвиженияДДС.Приход") Тогда
		Элементы.ГруппаКонтрагент.Заголовок = "Плательщик средств";
		Элементы.ГруппаШапка.Заголовок = "План поступления";
		Заголовок = "План поступления" + ?(Объект.Ссылка.Пустая(), " (Создание)","");
	Иначе
		Элементы.ГруппаКонтрагент.Заголовок = "Получатель средств";
		Элементы.ГруппаШапка.Заголовок = "Заявка на расход";
		Заголовок = "Заявка на расход"+ ?(Объект.Ссылка.Пустая(), " (Создание)","");
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ДоговорПриИзменении(Элемент)
	
	ДанныеДоговора = ПолучитьДанныеДоговора(Объект.Договор);
	
	ВалютаДоговора				= ДанныеДоговора.ВалютаДоговора;
	СтрВалютаДоговора 			= Строка(ДанныеДоговора.ВалютаДоговора)+ ?(ДанныеДоговора.РасчетыВУсловныхЕдиницах, " (у.е.)", ""); 
	
	Объект.Валюта = ДанныеДоговора.Валюта;
	
	ПриИзмененииДоговораНаСервере();
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьДанныеДоговора(Договор)
	
	Возврат CW_ПланированиеДДССервер.ПолучитьДанныеДоговора(Договор);

КонецФункции

&НаСервере
Процедура ПриИзмененииДоговораНаСервере()
	
	УстановитьДоступныеТипыДокументаОснования();
	
	//Подсистема.УчетПриложенийДоговоров
	CW_УчетПриложенийДоговоровСервер.ПриИзмененииДоговораНаСервере(ЭтаФорма);
	//Подсистема.УчетПриложенийДоговоров
	
КонецПроцедуры

&НаСервере
Процедура УстановитьДоступныеТипыДокументаОснования()
	
	ОграничениеТипа = ПолучитьДоступныеТипыДокументаОснования();
	Элементы.ДокументОснование.ОграничениеТипа  = Новый ОписаниеТипов(ОграничениеТипа);
	
КонецПроцедуры

&НаСервере
Функция ПолучитьДоступныеТипыДокументаОснования()
	
	ЭтоДОговорПоГрузоперевозке = ТипЗнч(Объект.Договор) = Тип("СправочникСсылка.CW_ДоговорыПоГрузоперевозкам");
	
	мТипы = Новый Массив;
	
	Если Не ЗначениеЗаполнено(Объект.Договор) Тогда
		Возврат мТипы;
	КонецЕсли;
	
	Если Объект.ВидДвижения =  ПредопределенноеЗначение("Перечисление.CW_ВидыДвиженияДДС.Приход") Тогда
		Если ЭтоДОговорПоГрузоперевозке Тогда
			мТипы.Добавить(Тип("ДокументСсылка.CW_ДоходыПоГрузоперевозке"));
			
			//Подсистема.УчетПриложенийДоговоров
			Если Объект.Договор.ИспользуютсяПриложения Тогда
				Массив	= Новый Массив;
				Массив.Добавить(Новый ПараметрВыбора("Отбор.Организация", 			Объект.Организация));
				Массив.Добавить(Новый ПараметрВыбора("Отбор.Контрагент", 			Объект.Контрагент));
				Массив.Добавить(Новый ПараметрВыбора("Отбор.Договор", 				Объект.Договор));
				Массив.Добавить(Новый ПараметрВыбора("Отбор.ПриложениеКДоговору", 	Объект.ПриложениеКДоговору));
				
				Элементы.Договор.ПараметрыВыбора = Новый ФиксированныйМассив(Массив);
			КонецЕсли;
			//Подсистема.УчетПриложенийДоговоров
			
		Иначе
			мТипы.Добавить(Тип("ДокументСсылка.РеализацияТоваровУслуг"));
			мТипы.Добавить(Тип("ДокументСсылка.СчетНаОплатуПокупателю"));
		КонецЕсли;
	Иначе
		Если ЭтоДОговорПоГрузоперевозке Тогда
			мТипы.Добавить(Тип("ДокументСсылка.CW_РасходыПоГрузоперевозке")); 
			
			Если Объект.ВидОперацииПлатежногоПоручения = ПредопределенноеЗначение("Перечисление.ВидыОперацийСписаниеДенежныхСредств.ВозвратПокупателю") Тогда 
				мТипы.Добавить(Тип("ДокументСсылка.CW_ДоходыПоГрузоперевозке"));
				мТипы.Добавить(Тип("ДокументСсылка.CW_Оплата"));
				мТипы.Добавить(Тип("ДокументСсылка.CW_ДвижениеДенежныхСредств"));  
			КонецЕсли;
			
			//Подсистема.УчетПриложенийДоговоров
			Если Объект.Договор.ИспользуютсяПриложения Тогда
				Массив	= Новый Массив;
				Массив.Добавить(Новый ПараметрВыбора("Отбор.Организация", 			Объект.Организация));
				Массив.Добавить(Новый ПараметрВыбора("Отбор.Контрагент", 			Объект.Контрагент));
				Массив.Добавить(Новый ПараметрВыбора("Отбор.Договор", 				Объект.Договор));
				Массив.Добавить(Новый ПараметрВыбора("Отбор.ПриложениеКДоговору", 	Объект.ПриложениеКДоговору));
				
				Элементы.Договор.ПараметрыВыбора = Новый ФиксированныйМассив(Массив);
			КонецЕсли;
			//Подсистема.УчетПриложенийДоговоров
			
		Иначе
			мТипы.Добавить(Тип("ДокументСсылка.ПоступлениеТоваровУслуг"));
			мТипы.Добавить(Тип("ДокументСсылка.СчетНаОплатуПоставщика"));
			Если Объект.ВидОперацииПлатежногоПоручения = ПредопределенноеЗначение("Перечисление.ВидыОперацийСписаниеДенежныхСредств.ВозвратПокупателю") Тогда 
				мТипы.Добавить(Тип("ДокументСсылка.СписаниеСРасчетногоСчета"));
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Возврат мТипы; 
	
КонецФункции

&НаКлиенте
Процедура ЗаполнитьСтатьюПоОснованию(Команда)
	ЗаполнитьСтатьюПоОснованиюНаСервере();
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСтатьюПоОснованиюНаСервере()
	Если НЕ Объект.ДокументОснование = Неопределено И НЕ Объект.ДокументОснование.Пустая() Тогда  
		ЗаполнитьЗначенияСвойств(Объект,Объект.ДокументОснование,"Организация,Контрагент,Договор,Валюта");
		Объект.СрокОплаты 		= CW_Документы.ПолучитьСрокОплаты(Объект.ДокументОснование);
		Модифицированность = Истина;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьОснованиеОплаты(Команда)
	ЗаполнитьОснованиеОплатыНаСервере();
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьОснованиеОплатыНаСервере()
	
	Объект.ОснованиеОплаты 	= ПолучитьТекстОснованияОплаты(Объект.ДокументОснование);
	Модифицированность 		= Истина;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьТекстОснованияОплаты(ДокументОснование)
	
	Если НЕ ЗначениеЗаполнено(ДокументОснование) Тогда
		Возврат "";
	КонецЕсли;
	
	Если ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.CW_РасходыПоГрузоперевозке") 
		ИЛИ ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.CW_ДоходыПоГрузоперевозке") Тогда
		
		Возврат ДокументОснование.ПредставлениеДокумента;
		
	ИначеЕсли ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
		СтрокаАкт = "Акт №"+ДокументОснование.Номер+" от "+Формат(ДокументОснование.Дата,"ДФ='dd.MM.yyyy ""г.""'");
		СтрокаСЧФ = "";
		
		НайденнаяСчетФактура = ПолучитьДанныеСчетФактуры(ДокументОснование);	
		
		Если НайденнаяСчетФактура <> Неопределено Тогда
			СтрокаСЧФ = "Сч-ф №"+НайденнаяСчетФактура.Номер+" от "+Формат(НайденнаяСчетФактура.Дата,"ДФ='dd.MM.yyyy ""г.""'");
		КонецЕсли;
		
		Возврат СтрокаАкт + ?(ПустаяСтрока(СтрокаСЧФ), "", "; "+СтрокаСЧФ);
		
	ИначеЕсли ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ПоступлениеТоваровУслуг") Тогда 
		
		СтрокаАкт = "Акт №"+ДокументОснование.НомерВходящегоДокумента+" от "+Формат(ДокументОснование.ДатаВходящегоДокумента,"ДФ='dd.MM.yyyy ""г.""'");
		СтрокаСЧФ = "";
		
		НайденнаяСчетФактура = ПолучитьДанныеСчетФактуры(ДокументОснование);	
		
		Если НайденнаяСчетФактура <> Неопределено Тогда
			СтрокаСЧФ = "Сч-ф №"+НайденнаяСчетФактура.НомерВходящегоДокумента+" от "+Формат(НайденнаяСчетФактура.ДатаВходящегоДокумента,"ДФ='dd.MM.yyyy ""г.""'");
		КонецЕсли;
		
		Возврат СтрокаАкт + ?(ПустаяСтрока(СтрокаСЧФ), "", "; "+СтрокаСЧФ);
		
	ИначеЕсли ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.СчетНаОплатуПоставщика") 
		ИЛИ ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.СчетНаОплатуПокупателю") Тогда
		
		Возврат "Счет №"+ДокументОснование.Номер+" от "+Формат(ДокументОснование.Дата,"ДФ='dd.MM.yyyy ""г.""'");
		
	КонецЕсли;
	
	Возврат Строка(ДокументОснование);
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьДанныеСчетФактуры(ДокументОснование)
	
	ВидСчетаФактуры = ?(ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.РеализацияТоваровУслуг"), "СчетФактураВыданный","СчетФактураПолученный"); 
	
	Запрос = новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	СчетФактура.Ссылка КАК Ссылка
	               |ИЗ
	               |	Документ."+ВидСчетаФактуры+" КАК СчетФактура
	               |ГДЕ
	               |	СчетФактура.ДокументОснование = &ДокументОснование";
	
	Запрос.УстановитьПараметр("ДокументОснование", ДокументОснование);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

&НаКлиенте
Процедура ПланОплатыПриИзменении(Элемент) 
	
	Объект.Состояние = ?(ЗначениеЗаполнено(Объект.ПланОплаты),1,0); 
	Если Объект.Состояние = 1 Тогда
		Статус = ПредопределенноеЗначение("Перечисление.CW_СтатусыПланированияДДС.Согласована");  
	Иначе
		Статус = ПредопределенноеЗначение("Перечисление.CW_СтатусыПланированияДДС.План");  
	КонецЕсли;

	КонтролерДата();
	
КонецПроцедуры  

&НаКлиенте
Процедура ОчиститьСогласованиеОтмену(Команда)
	
	Объект.Состояние = 0;
	Объект.ПланОплаты = Неопределено;
	Статус = ПредопределенноеЗначение("Перечисление.CW_СтатусыПланированияДДС.План");  
	
	КонтролерДата();
	
КонецПроцедуры


&НаСервере
Процедура КонтролерДата()
	
	Если Объект.Состояние = 1 
		И 		ЗначениеЗаполнено(Объект.ПланОплаты) 
		И 		(ТипЗнч(Объект.ДокументОснование) = Тип("ДокументСсылка.CW_РасходыПоГрузоперевозке") 
		ИЛИ 	ТипЗнч(Объект.ДокументОснование) = Тип("ДокументСсылка.CW_ДоходыПоГрузоперевозке")) Тогда
		
		ДанныеДоговора = CW_ПланированиеДДССервер.ПолучитьДанныеДоговора(Объект.Договор);
		
		Если ДанныеДоговора.РасчетыВУсловныхЕдиницах Тогда
			
			Если НЕ ПараметрыПланирования = Неопределено 
				И ПараметрыПланирования.ПересчитыватьСуммуПриСогласовании  Тогда
				
				ДанныеКурса = CW_Финансы.ПолучитьКурсВалюты(ВалютаДоговора, Объект.ПланОплаты);
				Объект.Сумма = Объект.ДокументОснование.СуммаДокумента * ДанныеКурса.Курс / ДанныеКурса.Кратность;
				ПриИзмененииСуммыНаСервере();
				
			КонецЕсли;
			
		КонецЕсли;

	КонецЕсли; 
	
	Объект.Контролер 		= ПараметрыСеанса.ТекущийПользователь;
	Объект.ДатаПланирования = ТекущаяДата();
	
КонецПроцедуры

&НаКлиенте
Процедура СостояниеПриИзменении(Элемент)
	
	Если Объект.Состояние = 1 И НЕ ЗначениеЗаполнено(Объект.ПланОплаты) Тогда
		Объект.ПланОплаты = ТекущаяДата();
		Статус = ПредопределенноеЗначение("Перечисление.CW_СтатусыПланированияДДС.Согласована");
	ИначеЕсли Объект.Состояние = 2 Тогда
		Объект.ПланОплаты = Неопределено;	
		Статус =  ПредопределенноеЗначение("Перечисление.CW_СтатусыПланированияДДС.Отклонена");
	КонецЕсли; 
	
	КонтролерДата();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСрокОплатыНаСервере()
	
	СрокОплаты = Неопределено;
	
	Если ТипЗнч(Объект.ДокументОснование) = Тип("ДокументСсылка.CW_Оплата") 
		ИЛИ ТипЗнч(Объект.ДокументОснование) = Тип("ДокументСсылка.CW_ДвижениеДенежныхСредств") Тогда
		Возврат;	
	КонецЕсли;
	
	Если ТипЗнч(Объект.ДокументОснование) = Тип("ДокументСсылка.CW_РасходыПоГрузоперевозке") ИЛИ
		ТипЗнч(Объект.ДокументОснование) = Тип("ДокументСсылка.CW_ДоходыПоГрузоперевозке") Тогда
		
		СтруктураСрокОплаты = CW_Документы.ПолучитьСрокОплаты(Объект.ДокументОснование);
		СрокОплаты = СтруктураСрокОплаты.ДатаОплаты;
		
	Иначе 
		СтруктураСрокОплаты = СрокиОплатыДокументов.СрокОплатыДокументаРасчетов(
					Объект.ДокументОснование.Организация, 
					Объект.ДокументОснование,
					Объект.ДокументОснование.Дата, 
					Объект.ДокументОснование.ДоговорКонтрагента);
		
		СрокОплаты = СтруктураСрокОплаты.СрокОплаты;	
	КонецЕсли;
	
	Объект.СрокОплаты  = СрокОплаты;
	Модифицированность = Истина;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПланОплатыНаСервере()
	
	Если ТипЗнч(Объект.ДокументОснование) = Тип("ДокументСсылка.CW_РасходыПоГрузоперевозке") ИЛИ
		ТипЗнч(Объект.ДокументОснование) = Тип("ДокументСсылка.CW_ДоходыПоГрузоперевозке") Тогда
		
		ДанныеПланаОплаты   = CW_Документы.ПолучитьПланОплаты(Объект.ДокументОснование);
		Объект.ПланОплаты	= ДанныеПланаОплаты.Дата;
		
		Модифицированность = Истина;
		
	КонецЕсли;
	
КонецПроцедуры

