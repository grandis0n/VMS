&НаСервере
Процедура ЗаполнитьСуммуВсегоНаСервере()
	
    Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Валюты.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.Валюты КАК Валюты
	               |ГДЕ
	               |	Валюты.Код = &Код";
	
	Запрос.УстановитьПараметр("Код", "643");

	РезультатаЗапроса = Запрос.Выполнить();
	Выборка = РезультатаЗапроса.Выбрать();
	Если Выборка.Следующий() Тогда
		ВалютаРубль = Выборка.Ссылка;
	КонецЕсли;
	
	Если ВалютаРубль = Неопределено Тогда 
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Валюты ""Российский рубль"" (код 643) в справочнике ""Валюты"" не найдена!"); 
		Возврат;
	КонецЕсли;
	
	ДоговорвВРублях = Ложь;	
	Если ТипЗнч(Объект.Договор) = Тип("СправочникСсылка.CW_ДоговорыПоГрузоперевозкам") Тогда
		 ДоговорвВРублях = (Объект.Договор.ВалютаДоговора = ВалютаРубль) ИЛИ Объект.Договор.ВзаиморасчетыВУЕ;
	КонецЕсли;
	
	Если ТипЗнч(Объект.ДокументОснование) = Тип("ДокументСсылка.CW_ДоходыПоГрузоперевозке") Тогда
		
		СтруктураДоходы = Новый Структура;
		СтруктураДоходы.Вставить("Всего", 0);
		СтруктураДоходы.Вставить("Всего_Валюта", 0);
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	CW_ДоходыПоГрузоперевозкамОбороты.Всего_ВалютаОборот КАК Всего_Валюта,
		               |	CW_ДоходыПоГрузоперевозкамОбороты.ВсегоОборот КАК Всего
		               |ИЗ
		               |	РегистрНакопления.CW_ДоходыПоГрузоперевозкам.Обороты(, , Период, ДокументДоходов = &ДокументДоходов) КАК CW_ДоходыПоГрузоперевозкамОбороты";
		
		Запрос.УстановитьПараметр("ДокументДоходов", Объект.ДокументОснование);  
		
		РезультатЗапроса = Запрос.Выполнить();
		Выборка =  РезультатЗапроса.Выбрать();
		Если Выборка.Следующий() Тогда
			ЗаполнитьЗначенияСвойств(СтруктураДоходы, Выборка);	
		КонецЕсли;
		
		
		СтруктураОплата = Новый Структура;
		СтруктураОплата.Вставить("Всего", 0);
		СтруктураОплата.Вставить("Всего_Валюта", 0);
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	CW_ОперативнаяДебиторскаяЗадолженностьОбороты.Всего_ВалютаОборот КАК Всего_Валюта,
		               |	CW_ОперативнаяДебиторскаяЗадолженностьОбороты.ВсегоОборот КАК Всего
		               |ИЗ
		               |	РегистрНакопления.CW_ОперативнаяДебиторскаяЗадолженность.Обороты(, , Период, Счет = &Счет) КАК CW_ОперативнаяДебиторскаяЗадолженностьОбороты";
		
		Запрос.УстановитьПараметр("Счет", Объект.ДокументОснование);  
		
		РезультатЗапроса = Запрос.Выполнить();
		Выборка =  РезультатЗапроса.Выбрать();
		Если Выборка.Следующий() Тогда
			ЗаполнитьЗначенияСвойств(СтруктураОплата, Выборка);	
		КонецЕсли;    
		
		Если ДоговорвВРублях Тогда
			Объект.Сумма = СтруктураДоходы["Всего"] - СтруктураОплата["Всего"];
		Иначе
			Объект.Сумма = СтруктураДоходы["Всего_Валюта"] - СтруктураОплата["Всего_Валюта"];
		КонецЕсли;
		
	КонецЕсли;  
	
	Если ТипЗнч(Объект.ДокументОснование) = Тип("ДокументСсылка.CW_Оплата")
		Или ТипЗнч(Объект.ДокументОснование) = Тип("ДокументСсылка.CW_ДвижениеДенежныхСредств") Тогда
		
		СтруктураЗадолженность = Новый Структура;
		СтруктураЗадолженность.Вставить("Всего", 0);
		СтруктураЗадолженность.Вставить("Всего_Валюта", 0);
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	СУММА(CW_ОперативнаяДебиторскаяЗадолженность.Всего_Валюта) КАК Всего_Валюта,
		               |	СУММА(CW_ОперативнаяДебиторскаяЗадолженность.Всего) КАК Всего
		               |ИЗ
		               |	РегистрНакопления.CW_ОперативнаяДебиторскаяЗадолженность КАК CW_ОперативнаяДебиторскаяЗадолженность
		               |ГДЕ
		               |	CW_ОперативнаяДебиторскаяЗадолженность.Регистратор = &Регистратор
		               |	И CW_ОперативнаяДебиторскаяЗадолженность.ВидДвижения = &ВидДвижения
		               |	И CW_ОперативнаяДебиторскаяЗадолженность.ВидОперации = &ВидОперации";
		
		Запрос.УстановитьПараметр("Регистратор", Объект.ДокументОснование);  
		Запрос.УстановитьПараметр("ВидОперации", ПредопределенноеЗначение("Перечисление.CW_ВидыДвиженийПоОперативнойЗадолженности.Оплата"));  
		Запрос.УстановитьПараметр("ВидДвижения", ВидДвиженияНакопления.Расход);  
		
		РезультатЗапроса = Запрос.Выполнить();
		Выборка =  РезультатЗапроса.Выбрать();
		Если Выборка.Следующий() Тогда
			ЗаполнитьЗначенияСвойств(СтруктураЗадолженность, Выборка);	
		КонецЕсли;
		
		Если ДоговорвВРублях Тогда
			Объект.Сумма = СтруктураЗадолженность["Всего"];
		Иначе
			Объект.Сумма = СтруктураЗадолженность["Всего_Валюта"];
		КонецЕсли;
		
	КонецЕсли;  
	
	ПриИзмененииСуммыНаСервере();
	
	
КонецПроцедуры

&НаКлиенте
Процедура ДокументОснованиеПриИзменении(Элемент)
	ДокументОснованиеПриИзмененииНаСервере();
КонецПроцедуры

