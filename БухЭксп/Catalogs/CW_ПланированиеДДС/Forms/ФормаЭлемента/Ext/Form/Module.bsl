	ОткрытьФормуПодбораСтатейБюджета(Ложь, Истина);
	
КонецПроцедуры  

&НаКлиенте
Процедура ПодборСтатейБюджета(Команда)    
	
	ОткрытьФормуПодбораСтатейБюджета(Истина, Ложь);   
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуПодбораСтатейБюджета(МножественныйВыбор, ЗакрыватьПриВыборое)
	
	ПериодПрогноза = Новый СтандартныйПериод;
	ПериодПрогноза.ДатаНачала = Объект.Дата;
	ПериодПрогноза.ДатаОкончания = Объект.СрокОплаты;  
	
	Если Объект.ВидДвижения = ПредопределенноеЗначение("Перечисление.CW_ВидыДвиженияДДС.Расход") Тогда
		ВидСтатьиПланирования = ПредопределенноеЗначение("Перечисление.CW_ВидыСтатейПланирования.Расходы");	
	Иначе 
		ВидСтатьиПланирования = ПредопределенноеЗначение("Перечисление.CW_ВидыСтатейПланирования.Доходы");	
	КонецЕсли;
	
	СтруктураОтбора = Новый Структура;
	СтруктураОтбора.Вставить("ВидСтатьиПланирования", ВидСтатьиПланирования);
	
	ПараметрыФормы = новый Структура;
	ПараметрыФормы.Вставить("ПериодПрогноза", 		ПериодПрогноза);  
	ПараметрыФормы.Вставить("Контрагент", 			Объект.Контрагент);
	ПараметрыФормы.Вставить("Валюта", 				Объект.Валюта);
	ПараметрыФормы.Вставить("Отбор", 				СтруктураОтбора);
	ПараметрыФормы.Вставить("МножественныйВыбор", 	МножественныйВыбор);  
	ПараметрыФормы.Вставить("ЗакрыватьПриВыборое", 	ЗакрыватьПриВыборое);  
	
	ОткрытьФорму("Справочник.CW_ПланированиеДДС.Форма.ФормаПодбораСтатейВЗаявку", ПараметрыФормы, ЭтаФорма,,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры    

&НаКлиенте
Процедура РасшифровкаПослеУдаления(Элемент)
	РасшифровкаПослеУдаленияНаСервере();
КонецПроцедуры  

&НаСервере
Процедура РасшифровкаПослеУдаленияНаСервере()
	РассчитатьСуммаЗаявки();
КонецПроцедуры


&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;	
	КонецЕсли;   
	
	ОбработкаВыбораНаСервере(ВыбранноеЗначение);
	
КонецПроцедуры  

&НаСервере
Процедура ОбработкаВыбораНаСервере(ВыбранноеЗначение)
	
	Если ТипЗнч(ВыбранноеЗначение) = Тип("Массив") Тогда
		Для Каждого СтатьяБюджета из ВыбранноеЗначение Цикл
			ДобавитьСтатьюБюджета(СтатьяБюджета);
		КонецЦикла;
	Иначе
		ДобавитьСтатьюБюджета(ВыбранноеЗначение);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьСтатьюБюджета(СтатьяБюджета)
	
	Если ТипЗнч(СтатьяБюджета) <> Тип("СправочникСсылка.CW_ПлановыеСтатьиЗатратИДоходов") Тогда
		Возврат;
	КонецЕсли;
	
	Отбор = Новый Структура;
	Отбор.Вставить("СтатьяБюджета", СтатьяБюджета); 
	
	мСтроки = Объект.Расшифровка.НайтиСтроки(Отбор);
	Если мСтроки.Количество() > 0 Тогда
		Возврат;
	КонецЕсли;       
	
	Прогноз = РегистрыСведений.CW_ПрогнозОплатыПлановыхСтатейБюджета.ПолучитьПрогнозОплаты(СтатьяБюджета);
	
	НоваяСтрока = Объект.Расшифровка.Добавить();
	НоваяСтрока.СтатьяБюджета 	= СтатьяБюджета;
 	НоваяСтрока.Грузоперевозка 	= СтатьяБюджета.Владелец;
	НоваяСтрока.Прогноз 		= Прогноз;
 	НоваяСтрока.Сумма 			= СтатьяБюджета.СуммаВсего;
 	НоваяСтрока.СуммаНДС 		= СтатьяБюджета.СуммаНДС;
	НоваяСтрока.Валюта 			= СтатьяБюджета.Валюта; 
	НоваяСтрока.СтавкаНДС 		= СтатьяБюджета.СтавкаНДС; 
	
	КурсСтатьи = CW_Финансы.ПолучитьКурсВалюты(НоваяСтрока.Валюта, Объект.Дата);
	КурсЗаявки = CW_Финансы.ПолучитьКурсВалюты(Объект.Валюта, Объект.Дата);
	
	НоваяСтрока.СуммаВВалютеЗаявки = CW_Финансы.ПересчитатьИзВалютыВВалюту(НоваяСтрока.Сумма, 
														НоваяСтрока.Валюта, 
														Объект.Валюта, 
														КурсСтатьи.Курс, 
														КурсЗаявки.Курс, 
														КурсСтатьи.Кратность, 
														КурсЗаявки.Кратность);

	НоваяСтрока.СуммаНДСВВалютеЗаявки = CW_Финансы.ПересчитатьИзВалютыВВалюту(НоваяСтрока.СуммаНДС, 
														НоваяСтрока.Валюта, 
														Объект.Валюта, 
														КурсСтатьи.Курс, 
														КурсЗаявки.Курс, 
														КурсСтатьи.Кратность, 
														КурсЗаявки.Кратность);
	
	РассчитатьСуммаЗаявки();

КонецПроцедуры      

&НаСервере
Процедура РассчитатьСуммаЗаявки()
	
	Объект.Сумма 	= Объект.Расшифровка.Итог("СуммаВВалютеЗаявки");
	Объект.СуммаНДС = Объект.Расшифровка.Итог("СуммаНДСВВалютеЗаявки");    
	
	ТаблицаРасшифровка = Объект.Расшифровка.Выгрузить();
	ТаблицаРасшифровка.Свернуть("СтавкаНДС", "СуммаНДС"); 
	ТаблицаРасшифровка.Сортировать("СуммаНДС УБЫВ");
	
	Если ТаблицаРасшифровка.Количество() > 0 Тогда
		Объект.СтавкаНДС = ТаблицаРасшифровка[0].СтавкаНДС;	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьСтатью(Команда)
	
	ТекущиеДанные = Элементы.Расшифровка.ТекущиеДанные;
	ОткрытьСтатьюБюджета(ТекущиеДанные);
	
КонецПроцедуры 

&НаКлиенте
Процедура РасшифровкаВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка) 
	СтандартнаяОбработка = Ложь;

	ТекущиеДанные = Элементы.Расшифровка.ТекущиеДанные;
	ОткрытьСтатьюБюджета(ТекущиеДанные);
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьСтатьюБюджета(ТекущиеДанные)
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Ключ", ТекущиеДанные.СтатьяБюджета);
	
	ОткрытьФорму("Справочник.CW_ПлановыеСтатьиЗатратИДоходов.ФормаОбъекта", ПараметрыФормы, ЭтаФорма,,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	Если ИспользуетсяПрогнозированиеДДСПоБюджету Тогда
		ПроверитьДублированиеСтатей(Отказ);               
	КонецЕсли;

	//Подсистема.СтатусыДокументов
	CW_СтатусыДокументовСервер.ПередЗаписьюНаСервере(ЭтаФорма, Отказ, ТекущийОбъект, ПараметрыЗаписи);
	//Подсистема.СтатусыДокументов
	
	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствами.ПередЗаписьюНаСервере(ЭтотОбъект, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.Свойства
	
	
КонецПроцедуры

&наСервере
Процедура ПроверитьДублированиеСтатей(Отказ)  
	
	Расшифровка = Объект.Расшифровка.Выгрузить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 	 "ВЫБРАТЬ
	               	 |	CW_ПланированиеДДСРасшифровка.НомерСтроки КАК НомерСтроки,
	               	 |	CW_ПланированиеДДСРасшифровка.СтатьяБюджета КАК СтатьяБюджета
	               	 |ПОМЕСТИТЬ ВТ_ТаблицаДокумента
	               	 |ИЗ
	               	 |	&Расшифровка КАК CW_ПланированиеДДСРасшифровка
	               	 |;
	               	 |
	               	 |////////////////////////////////////////////////////////////////////////////////
	               	 |ВЫБРАТЬ
	               	 |	ВТ_ТаблицаДокумента.НомерСтроки КАК НомерСтроки,
	               	 |	ВТ_ТаблицаДокумента.СтатьяБюджета КАК СтатьяБюджета,
	               	 |	CW_ПланированиеДДСРасшифровка.Ссылка КАК Ссылка
	               	 |ИЗ
	               	 |	ВТ_ТаблицаДокумента КАК ВТ_ТаблицаДокумента
	               	 |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.CW_ПланированиеДДС.Расшифровка КАК CW_ПланированиеДДСРасшифровка
	               	 |		ПО ВТ_ТаблицаДокумента.СтатьяБюджета = CW_ПланированиеДДСРасшифровка.СтатьяБюджета
	               	 |ГДЕ
	               	 |	CW_ПланированиеДДСРасшифровка.Ссылка <> &Ссылка"; 
	 
	 Запрос.УстановитьПараметр("Ссылка",		Объект.Ссылка);
	 Запрос.УстановитьПараметр("Расшифровка", 	Расшифровка); 
	 
	 РезультатЗапроса = Запрос.Выполнить();  
	 Выборка = РезультатЗапроса.Выбрать();
	 Пока Выборка.Следующий() Цикл 
		 ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В строке "+Формат(Выборка.НомерСтроки, "ЧГ=0")+" статья бюджета """+СокрЛП(Выборка.СтатьяБюджета)+""" уже используется в заявке: "+ СокрЛП(Выборка.Ссылка)
				 ,,,,Отказ);
	 КонецЦикла;
	 
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	// СтандартныеПодсистемы.Свойства
	Если УправлениеСвойствамиКлиент.ОбрабатыватьОповещения(ЭтотОбъект, ИмяСобытия, Параметр) Тогда
		ОбновитьЭлементыДополнительныхРеквизитов();
		УправлениеСвойствамиКлиент.ПослеЗагрузкиДополнительныхРеквизитов(ЭтотОбъект);
		// СтандартныеПодсистемы.Свойства
		
		//Наличие прикрепленных файлов
	ИначеЕсли ИмяСобытия = "ОбновитьНаличиеПрикрепленныхФайлов" Тогда
		
		ОбработатьОповещениеОбновитьНаличиеПрикрепленныхФайлов();
		//Наличие прикрепленных файлов

		//Подсистема.СтатусыДокументов
	ИначеЕсли ИмяСобытия = "Изменение_СтатусДокумента" Тогда
		
		ОбработатьОповещениеИзменениеСтатусДокументаНаСервере();
		//Подсистема.СтатусыДокументов
	КонецЕсли;
	
КонецПроцедуры  

