Функция УстановкаПараметровСеанса(ИменаПараметровСеанса) Экспорт
	
	УстановленныеПараметры = Новый Массив;
	
	Если ИменаПараметровСеанса = Неопределено Тогда
		
		ГруппаПользователя = CW_ПраваДоступа_ПИ.ГруппаПользователя(ПараметрыСеанса.ТекущийПользователь);
		
		ПараметрыСеанса.CW_ГруппаПользователя = ГруппаПользователя;                                        
		УстановленныеПараметры.Добавить("CW_ГруппаПользователя");
		
		CW_ИспользуютсяОграниченияПоОрганизациям = ГруппаПользователя.ИспользуютсяОграниченияПоОрганизациям;
		Если Не Константы.CW_ОграничиватьДоступНаУровнеЗаписей.Получить() Тогда  
			CW_ИспользуютсяОграниченияПоОрганизациям = ложь;
		КонецЕсли;
			
		ПараметрыСеанса.CW_ИспользуютсяОграниченияПоОрганизациям = CW_ИспользуютсяОграниченияПоОрганизациям;
		УстановленныеПараметры.Добавить("CW_ИспользуютсяОграниченияПоОрганизациям");
		
		Если ОбщегоНазначения.ПодсистемаСуществует("CW_БухгалтерияЭкспедитораДляРоссии.CW_РеестрыНДС0") Тогда
			МодульCW_РеестрыНДС0Сервер = ОбщегоНазначения.ОбщийМодуль("CW_РеестрыНДС0Сервер");
			МодульCW_РеестрыНДС0Сервер.УстановкаПараметровСеанса(ИменаПараметровСеанса, УстановленныеПараметры);
		КонецЕсли;
		
		CW_ПроверкаЛицензии.УстановкаПараметровСеанса(ИменаПараметровСеанса, УстановленныеПараметры);
		
		Возврат УстановленныеПараметры;  
		
	КонецЕсли;
	
	Если ИменаПараметровСеанса.Найти("CW_ИдентификаторСеанса") <> Неопределено Тогда 
		CW_ПроверкаЛицензии.УстановкаПараметровСеанса(ИменаПараметровСеанса, УстановленныеПараметры);
	КонецЕсли;
	
	Возврат УстановленныеПараметры;
	
	
КонецФункции

