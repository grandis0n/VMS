Процедура ВключитьРабочийСтолБухгалтерияЭкспедитора() Экспорт
	
	Пользователь 		= ПользователиИнформационнойБазы.ТекущийПользователь();
	ХранилищеНастроек 	= ХранилищеСистемныхНастроек.Загрузить("Общее/НастройкиНачальнойСтраницы", "",, Пользователь.Имя);

	Если ХранилищеНастроек = Неопределено Тогда
		ХранилищеНастроек = Новый НастройкиНачальнойСтраницы;
		СоставФорм = Новый СоставФормНачальнойСтраницы;
	Иначе
		СоставФорм = ХранилищеНастроек.ПолучитьСоставФорм();
		СоставФорм.ЛеваяКолонка.Очистить();
	КонецЕсли; 
	
	ИмяФормыРабочегоСтола = ИмяФормыРабочийСтолБухгалтерияЭкспедитора();
	
	СоставФорм.ЛеваяКолонка.Добавить(ИмяФормыРабочегоСтола);

	ХранилищеНастроек.УстановитьСоставФорм(СоставФорм);
	
	ХранилищеСистемныхНастроек.Сохранить("Общее/НастройкиНачальнойСтраницы", "", ХранилищеНастроек,, Пользователь.Имя);
	
КонецПроцедуры

Процедура ОтключитьРабочийСтолБухгалтерияЭкспедитора()Экспорт
	
	ИмяФормыРабочегоСтола = ИмяФормыРабочийСтолБухгалтерияЭкспедитора();
	
	ХранилищеНастроек = ХранилищеСистемныхНастроек.Загрузить("Общее/НастройкиНачальнойСтраницы");
	Если ХранилищеНастроек = Неопределено Тогда
		Возврат;
	КонецЕсли;

	СоставФорм = ХранилищеНастроек.ПолучитьСоставФорм();
	
	ИндексФормы = СоставФорм.ЛеваяКолонка.Найти(ИмяФормыРабочегоСтола);
	Если ИндексФормы <> Неопределено Тогда
		СоставФорм.ЛеваяКолонка.Удалить(ИндексФормы);
	КонецЕсли;
	ИндексФормы = СоставФорм.ПраваяКолонка.Найти(ИмяФормыРабочегоСтола);
	Если ИндексФормы <> Неопределено Тогда
		СоставФорм.ПраваяКолонка.Удалить(ИндексФормы);
	КонецЕсли;
	
	ХранилищеНастроек.УстановитьСоставФорм(СоставФорм);
	ХранилищеСистемныхНастроек.Сохранить("Общее/НастройкиНачальнойСтраницы", "", ХранилищеНастроек);
	
КонецПроцедуры

Процедура ВключитьНачальнуюСтраницуБухгалтерияПредприятия() Экспорт

	Пользователь 		= ПользователиИнформационнойБазы.ТекущийПользователь();
	ХранилищеНастроек 	= ХранилищеСистемныхНастроек.Загрузить("Общее/НастройкиНачальнойСтраницы", "",, Пользователь.Имя);

	Если ХранилищеНастроек = Неопределено Тогда
		ХранилищеНастроек = Новый НастройкиНачальнойСтраницы;
		СоставФорм = Новый СоставФормНачальнойСтраницы;
	Иначе
		СоставФорм = ХранилищеНастроек.ПолучитьСоставФорм();
		СоставФорм.ЛеваяКолонка.Очистить();
		СоставФорм.ПраваяКолонка.Очистить();
	КонецЕсли; 
	
	ИмяФормыЛеваяКолонка  = "ОбщаяФорма.ИнформационнаяПанель";
	ИмяФормыПраваяКолонка = "Обработка.ИнформационныйЦентр.Форма.ИнформационныйЦентр";
	
	СоставФорм.ЛеваяКолонка.Добавить(ИмяФормыЛеваяКолонка);
  	СоставФорм.ПраваяКолонка.Добавить(ИмяФормыПраваяКолонка);

	ХранилищеНастроек.УстановитьСоставФорм(СоставФорм);
	
	ХранилищеСистемныхНастроек.Сохранить("Общее/НастройкиНачальнойСтраницы", "", ХранилищеНастроек,, Пользователь.Имя);
	
КонецПроцедуры

