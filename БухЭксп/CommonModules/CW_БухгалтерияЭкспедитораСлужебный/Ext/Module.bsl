Процедура УстановитьНачальныеЗначенияКонстант(АдресРезультата=Неопределено) Экспорт
	
	//ОсновнойЯзык
	ОсновнойЯзык = Константы.CW_ОсновнойЯзык.Получить();
	Если (НЕ ЗначениеЗаполнено(ОсновнойЯзык)) Тогда
		Константы.CW_ОсновнойЯзык.Установить(Справочники.CW_Языки.ru);
	КонецЕсли; 
	
	//ВалютаРегламентированногоУчета
	ВалютаРегламентированногоУчета = Константы.ВалютаРегламентированногоУчета.Получить();
	
	ВалютаРубль = Справочники.Валюты.НайтиПоКоду("643");
	Если ВалютаРубль.Пустая() тогда
		ВалютаРубль = Справочники.Валюты.НайтиПоКоду("RUB");
	КонецЕсли;
	Константы.CW_ВалютаРегламентированногоУчетаРубль.Установить(ВалютаРегламентированногоУчета =  ВалютаРубль);
	
	//ВариантРасчетаРублевойСуммыНДССтатейБюджета
	ЗначениеВарианта = ПредопределенноеЗначение("Перечисление.CW_ВариантРасчетаРублевойСуммыНДССтатейБюджета.РасчетПоКурсуНаДатуДокумента"); 
	Константы.CW_ВариантРасчетаРублевойСуммыНДССтатейБюджета.Установить(ЗначениеВарианта);
	
	
КонецПроцедуры  

Процедура ЗаполнитьПервоначальныеДанныеСправочникаТипыПеревозок(АдресРезультата=Неопределено) Экспорт
	
	мРеквизиты = Справочники.CW_ТипыПеревозок.ПолучитьМассивДоступныхРеквизитовШапки();

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	CW_ТипыПеревозок.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.CW_ТипыПеревозок КАК CW_ТипыПеревозок
	               |ГДЕ
	               |	CW_ТипыПеревозок.ПометкаУдаления = ЛОЖЬ
	               |	И CW_ТипыПеревозок.ЭтоГруппа = ЛОЖЬ";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		ТОбъект = Выборка.Ссылка.ПолучитьОбъект();
		
		Для Каждого ДанныеРеквизита из  мРеквизиты Цикл
			
			Отбор = Новый Структура("ИмяРеквизита",ДанныеРеквизита.Имя);
			
			мСтроки = ТОбъект.ПредопределенныеЗначенияРеквизитов.НайтиСтроки(Отбор); 
			Если мСтроки.Количество() = 0 Тогда
				НоваяСтрока = ТОбъект.ПредопределенныеЗначенияРеквизитов.Добавить();
				НоваяСтрока.ИмяРеквизита = ДанныеРеквизита.Имя;
				НоваяСтрока.СинонимРеквизита = ДанныеРеквизита.Синоним;
			КонецЕсли; 
			
		КонецЦикла;
		
		ТОбъект.Записать();
		
	КонецЦикла;
	
КонецПроцедуры  

