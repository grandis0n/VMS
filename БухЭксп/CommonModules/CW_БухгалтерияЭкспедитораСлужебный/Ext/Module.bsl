Процедура ДобавитьБазовыеПрава(Профиль, СоответствиеИдентификаторвМетаданных)
	
	мИсключения = Новый Массив;
	мИсключения.Добавить("БазовыеПраваВнешнихПользователейБСП");
	
	Для Каждого Метаданное из Метаданные.Роли Цикл
		Если мИсключения.Найти(Метаданное.Имя) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Если СтрНайти(ВРЕГ(Метаданное.Имя),"БАЗОВЫЕПРАВА") > 0 Тогда
			ИдентификатрБазовыеПрава 	= СоответствиеИдентификаторвМетаданных.Получить("Роль."+Метаданное.Имя);
			Если Профиль.Роли.Найти(ИдентификатрБазовыеПрава,"Роль") = Неопределено Тогда
				НоваяСтрока 			= Профиль.Роли.Добавить();
				НоваяСтрока.Роль 		= ИдентификатрБазовыеПрава;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ОбновлениеДанныеПоАвтоблоку(АдресРезультата=Неопределено) Экспорт

	Попытка
		// краткое наименование предопределенных документов автоблока
		ДокументПТС = Справочники.CW_ВидыДокументовТС.ПаспортТранспортногоСредства.ПолучитьОбъект();
