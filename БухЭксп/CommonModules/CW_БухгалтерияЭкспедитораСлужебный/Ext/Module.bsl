//Обязательные процедуры при переходе на каждый релиз  
 Процедура ОбновитьПараметрДатыЕжедневногоОбновления(АдресРезультата=Неопределено) Экспорт
	
	Попытка
		ПараметрДатыЕжедневногоОбновления = Константы.CW_ПараметрДатыЕжедневногоОбновления.Получить();
		Если (ПараметрДатыЕжедневногоОбновления.Пустая()) Тогда
			CW_Мониторинг.УстановитьПараметрДатыЕжедневногоОбновления();
		КонецЕсли; 
	Исключение
		СобытиеДляЖурналаРегистрации = Новый Структура;
		СобытиеДляЖурналаРегистрации.Вставить("ИмяСобытия"			, "Обновление: не удалось записать основной язык");
		СобытиеДляЖурналаРегистрации.Вставить("ПредставлениеУровня"	, "Ошибка");
		СобытиеДляЖурналаРегистрации.Вставить("Комментарий"			, ОписаниеОшибки());
		СобытиеДляЖурналаРегистрации.Вставить("ДатаСобытия"			, ТекущаяДата());
		
		СобытияДляЖурналаРегистрации = Новый СписокЗначений;
		СобытияДляЖурналаРегистрации.Добавить(СобытиеДляЖурналаРегистрации);
		
		ЖурналРегистрации.ЗаписатьСобытияВЖурналРегистрации(СобытияДляЖурналаРегистрации);			
	КонецПопытки; 
	
КонецПроцедуры // ОбязательныйВызов()

Процедура ГенерацияГруппПрофилейДоступа(АдресРезультата=Неопределено) Экспорт

	Попытка
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		|	ИдентификаторыОбъектовМетаданных.Ссылка КАК Идентификатор,
		|	ИдентификаторыОбъектовМетаданных.ПолноеИмя КАК ПолноеИмя
		|ИЗ
		|	Справочник.ИдентификаторыОбъектовМетаданных КАК ИдентификаторыОбъектовМетаданных";
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		СоответствиеИдентификаторвМетаданных = Новый Соответствие;
		Пока Выборка.Следующий() Цикл
			СоответствиеИдентификаторвМетаданных.Вставить(Выборка.ПолноеИмя, Выборка.Идентификатор);
		КонецЦикла;
		
		// ---------------------------------------------------------------------------- 
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		|	ПрофилиГруппДоступаРоли.Ссылка КАК Профиль,
		|	ПрофилиГруппДоступаРоли.Роль КАК Роль
		|ИЗ
		|	Справочник.ПрофилиГруппДоступа.Роли КАК ПрофилиГруппДоступаРоли";
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		СоответствиеПрофильРоль = Новый Соответствие;
		Пока Выборка.Следующий() Цикл
			СоответствиеПрофильРоль.Вставить(Выборка.Роль, Выборка.Профиль);
		КонецЦикла;     
		
		ИдентификатрБухгалтерияЭкспедитора 				= СоответствиеИдентификаторвМетаданных.Получить("Роль.БухгалтерияЭкспедитора");
		ИдентификатрБухгалтерияЭкспедитораАдминистратор = СоответствиеИдентификаторвМетаданных.Получить("Роль.БухгалтерияЭкспедитораАдминистратор");
		ИдентификатрБухгалтерияЭкспедитораМенеджер 		= СоответствиеИдентификаторвМетаданных.Получить("Роль.БухгалтерияЭкспедитораМенеджер");
		ИдентификатрБухгалтерияЭкспедитораСлужебная 	= СоответствиеИдентификаторвМетаданных.Получить("Роль.БухгалтерияЭкспедитораСлужебная");
		
		ЕстьИдентификатрБухгалтерияЭкспедитора  = ЗначениеЗаполнено(ИдентификатрБухгалтерияЭкспедитора);
		
		Если ЕстьИдентификатрБухгалтерияЭкспедитора  Тогда
			
			//Профиль администратора
			ПрофильАдминистратора = СоответствиеПрофильРоль.Получить(ИдентификатрБухгалтерияЭкспедитораАдминистратор);
			
			Если Не ЗначениеЗаполнено(ПрофильАдминистратора) Тогда 
				
				ДобавляемыеРоли = Новый Массив;
				ДобавляемыеРоли.Добавить(ИдентификатрБухгалтерияЭкспедитора);	
				ДобавляемыеРоли.Добавить(ИдентификатрБухгалтерияЭкспедитораАдминистратор);	
			
				// создаем новый профиль доступа
				НовыйПрофилиГруппДоступа = Справочники.ПрофилиГруппДоступа.СоздатьЭлемент();
				НовыйПрофилиГруппДоступа.Наименование = "Бухгалтерия экспедитора (Администратор)";
				
				Для Каждого Роль из ДобавляемыеРоли Цикл
					НоваяСтрока 		= НовыйПрофилиГруппДоступа.Роли.Добавить();
					НоваяСтрока.Роль 	= Роль;
				КонецЦикла;
				
				НовыйПрофилиГруппДоступа.Записать();
				
			Конецесли;
			
			//Профиль Менеджера
			ПрофильМенеджера = СоответствиеПрофильРоль.Получить(ИдентификатрБухгалтерияЭкспедитораМенеджер);
			
			Если Не ЗначениеЗаполнено(ПрофильМенеджера) Тогда
				
				ДобавляемыеРоли = Новый Массив;
				ДобавляемыеРоли.Добавить(ИдентификатрБухгалтерияЭкспедитора);	
				ДобавляемыеРоли.Добавить(ИдентификатрБухгалтерияЭкспедитораМенеджер);	
				ДобавляемыеРоли.Добавить(ИдентификатрБухгалтерияЭкспедитораМенеджер);
				
				ДобавлениеИзменениеДанныхФизическихЛицЗарплатаКадры = СоответствиеИдентификаторвМетаданных.Получить("Роль.ДобавлениеИзменениеДанныхФизическихЛицЗарплатаКадры");
				ДобавляемыеРоли.Добавить(ДобавлениеИзменениеДанныхФизическихЛицЗарплатаКадры);
				
				ЧтениеДанныхФизическихЛицЗарплатаКадры = СоответствиеИдентификаторвМетаданных.Получить("Роль.ЧтениеДанныхФизическихЛицЗарплатаКадры");
				ДобавляемыеРоли.Добавить(ЧтениеДанныхФизическихЛицЗарплатаКадры);
				
				РедактированиеПечатныхФорм = СоответствиеИдентификаторвМетаданных.Получить("Роль.РедактированиеПечатныхФорм");
				ДобавляемыеРоли.Добавить(РедактированиеПечатныхФорм);
				
				ДобавлениеИзменениеНоменклатуры = СоответствиеИдентификаторвМетаданных.Получить("Роль.ДобавлениеИзменениеНоменклатуры");
				ДобавляемыеРоли.Добавить(ДобавлениеИзменениеНоменклатуры);	
				
				НовыйПрофилиГруппДоступа = Справочники.ПрофилиГруппДоступа.СоздатьЭлемент();
				НовыйПрофилиГруппДоступа.Наименование = "Бухгалтерия Экспедитора (Менеджер)";
				
				//Добавим базовые права
				ДобавитьБазовыеПрава(НовыйПрофилиГруппДоступа, СоответствиеИдентификаторвМетаданных);
	
				Для Каждого Роль из ДобавляемыеРоли Цикл
					НоваяСтрока 		= НовыйПрофилиГруппДоступа.Роли.Добавить();
					НоваяСтрока.Роль 	= Роль;
				КонецЦикла;

				НовыйПрофилиГруппДоступа.Записать();
				
			Иначе
				
				ОбъектПрофильМенеджера 	= ПрофильМенеджера.ПолучитьОбъект();
				
				Если ПрофильМенеджера.Роли.Найти(ИдентификатрБухгалтерияЭкспедитора,"Роль") = Неопределено Тогда
					НоваяСтрока 			= ОбъектПрофильМенеджера.Роли.Добавить();
					НоваяСтрока.Роль 		= ИдентификатрБухгалтерияЭкспедитора;
				КонецЕсли;
				
				//Добавим базовые права
				ДобавитьБазовыеПрава(ОбъектПрофильМенеджера, СоответствиеИдентификаторвМетаданных);
				
				
				ОбъектПрофильМенеджера.Записать();
				
			КонецЕсли; 
			
			//Профиль Служебная
			ПрофильСлужебная = СоответствиеПрофильРоль.Получить(ИдентификатрБухгалтерияЭкспедитораСлужебная);
			
			Если Не ЗначениеЗаполнено(ПрофильСлужебная) Тогда
				
				НовыйПрофилиГруппДоступа = Справочники.ПрофилиГруппДоступа.СоздатьЭлемент();
				НовыйПрофилиГруппДоступа.Наименование = "Бухгалтерия Экспедитора (Служебная)";
				
				НоваяСтрока 		= НовыйПрофилиГруппДоступа.Роли.Добавить();
				НоваяСтрока.Роль 	= ИдентификатрБухгалтерияЭкспедитораСлужебная;
				
				НовыйПрофилиГруппДоступа.Записать();
				
			КонецЕсли; 
			
			
		КонеЦесли;
	Исключение
		
		СобытиеДляЖурналаРегистрации = Новый Структура;
		СобытиеДляЖурналаРегистрации.Вставить("ИмяСобытия"			, "Обновление: не удалось записать профили доступа");
		СобытиеДляЖурналаРегистрации.Вставить("ПредставлениеУровня"	, "Ошибка");
		СобытиеДляЖурналаРегистрации.Вставить("Комментарий"			, ОписаниеОшибки());
		СобытиеДляЖурналаРегистрации.Вставить("ДатаСобытия"			, ТекущаяДата());
		
		СобытияДляЖурналаРегистрации = Новый СписокЗначений;
		СобытияДляЖурналаРегистрации.Добавить(СобытиеДляЖурналаРегистрации);
		
		ЖурналРегистрации.ЗаписатьСобытияВЖурналРегистрации(СобытияДляЖурналаРегистрации);			
		
	КонецПопытки; 
	
	
КонецПроцедуры

Процедура ДополнитьРолиМенеджера(АдресРезультата = Неопределено) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ИдентификаторыОбъектовМетаданных.Ссылка КАК Идентификатор,
	|	ИдентификаторыОбъектовМетаданных.ПолноеИмя КАК ПолноеИмя
	|ИЗ
	|	Справочник.ИдентификаторыОбъектовМетаданных КАК ИдентификаторыОбъектовМетаданных";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	СоответствиеИдентификаторвМетаданных = Новый Соответствие;
	Пока Выборка.Следующий() Цикл
		СоответствиеИдентификаторвМетаданных.Вставить(Выборка.ПолноеИмя, Выборка.Идентификатор);
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ПрофилиГруппДоступаРоли.Ссылка КАК Профиль,
	|	ПрофилиГруппДоступаРоли.Роль КАК Роль
	|ИЗ
	|	Справочник.ПрофилиГруппДоступа.Роли КАК ПрофилиГруппДоступаРоли";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	СоответствиеПрофильРоль = Новый Соответствие;
	Пока Выборка.Следующий() Цикл
		СоответствиеПрофильРоль.Вставить(Выборка.Роль, Выборка.Профиль);
	КонецЦикла;     
	
	ИдентификатрБухгалтерияЭкспедитораМенеджер	= СоответствиеИдентификаторвМетаданных.Получить("Роль.БухгалтерияЭкспедитораМенеджер");
	ДобавлениеИзменениеНоменклатуры 			= СоответствиеИдентификаторвМетаданных.Получить("Роль.ДобавлениеИзменениеНоменклатуры");
	
	ПрофильМенеджера = СоответствиеПрофильРоль.Получить(ИдентификатрБухгалтерияЭкспедитораМенеджер);

	ОбъектПрофильМенеджера 	= ПрофильМенеджера.ПолучитьОбъект();
	Если ПрофильМенеджера.Роли.Найти(ДобавлениеИзменениеНоменклатуры,"Роль") = Неопределено Тогда
		НоваяСтрока 			= ОбъектПрофильМенеджера.Роли.Добавить();
		НоваяСтрока.Роль 		= ДобавлениеИзменениеНоменклатуры;
	КонецЕсли;
	
	ОбъектПрофильМенеджера.Записать();
	
КонецПроцедуры

Процедура ОбновитьСписокМетаданныхДляИсторииОбъектов(АдресРезультата=Неопределено) Экспорт 
	
	Запрос = новый запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	CW_МетаданныеКонфигурации.Ссылка КАК Ссылка,
	               |	CW_МетаданныеКонфигурации.ДляИсторииОбъектов КАК ДляИсторииОбъектов,
	               |	CW_МетаданныеКонфигурации.Наименование КАК Наименование
	               |ИЗ
	               |	Справочник.CW_МетаданныеКонфигурации КАК CW_МетаданныеКонфигурации";
	
	Выборка = Запрос.Выполнить().Выбрать(); 
	
	ПодсистемаБухгалтерияЭкспедитора = CW_ОбновлениеКонфигурацииСервер.ПодсистемаБухгалтерияЭкспедитора();
	
	Для каждого Метаданное Из ПодсистемаБухгалтерияЭкспедитора.Состав Цикл
		
		ИмяМетаданного = Метаданное.ПолноеИмя();
		Если Найти(ИмяМетаданного,"Справочник.") <> 0 ИЛИ Найти(ИмяМетаданного,"Документ.") <> 0 Тогда
			
			Выборка.Сбросить();
			Если Выборка.НайтиСледующий(Новый Структура("Наименование",ИмяМетаданного)) Тогда
				ОбъектМетаданоеКонфигурации = Выборка.Ссылка.ПолучитьОбъект();
			Иначе
				ОбъектМетаданоеКонфигурации = Справочники.CW_МетаданныеКонфигурации.СоздатьЭлемент();
			КонецЕсли;
			
			ОбъектМетаданоеКонфигурации.Наименование 			= ИмяМетаданного;
			ОбъектМетаданоеКонфигурации.ДляИсторииОбъектов 		= Истина;
			ОбъектМетаданоеКонфигурации.ОбменДанными.Загрузка 	= Истина;
			ОбъектМетаданоеКонфигурации.Записать();
			
		КонецЕсли; 
		
	КонецЦикла; 
	
	МассивИмен = Новый Массив;
	МассивИмен.Добавить("ПланВидовХарактеристик.CW_ПараметрыГрузоперевозок");
	МассивИмен.Добавить("Справочник.Контрагенты");
	МассивИмен.Добавить("Справочник.ДоговорыКонтрагентов");
	МассивИмен.Добавить("Справочник.Номенклатура");
	
	Для Каждого ИмяЭлемента из МассивИмен Цикл
		
		НайденнаяСсылка = Справочники.CW_МетаданныеКонфигурации.НайтиПоНаименованию(ИмяЭлемента);
		
		Если НайденнаяСсылка.Пустая() Тогда
			ОбъектМетаданоеКонфигурации = Справочники.CW_МетаданныеКонфигурации.СоздатьЭлемент();
		Иначе
			ОбъектМетаданоеКонфигурации = НайденнаяСсылка.ПолучитьОбъект();
		КонецЕсли;
		ОбъектМетаданоеКонфигурации.Наименование 			= ИмяЭлемента;
		ОбъектМетаданоеКонфигурации.ДляИсторииОбъектов 		= Истина;
		ОбъектМетаданоеКонфигурации.ОбменДанными.Загрузка 	= Истина;
		ОбъектМетаданоеКонфигурации.Записать();
		
	КонецЦикла;
	
КонецПроцедуры

