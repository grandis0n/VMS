
//см.CW_ОбновлениеКонфигурацииСервер.ПриДобавленииОбработчиковОбновления()
Процедура ПриДобавленииОбработчиковОбновления(Обработчики) Экспорт  
	
	//Общие процедуры обновления и первого запуска конфигурации   
	ДобавитьОбработчикиОбновленияИПервогоЗапуска(Обработчики);
	
	//Процедуры обновления на версию   
	ДобавитьПроцедурыОбновленияНаВерсию(Обработчики);
	//Процедуры обновления на версию   
	
	//"CW_ЛичныйКабинетКлиента"
	Если CW_ВерсииПодсистемСервер.СуществуетПодсистема("CW_БухгалтерияЭкспедитора.CW_ЛичныйКабинетКлиента") Тогда  
		Модуль_CW_ЛичныйКабинетКлиентаСлужебный = CW_ОбщегоНазначения.ОбщийМодуль("CW_ЛичныйКабинетКлиентаСлужебный");
		Модуль_CW_ЛичныйКабинетКлиентаСлужебный.ПриДобавленииОбработчиковОбновления(Обработчики);
	КонецЕсли; 
	//"CW_ЛичныйКабинетКлиента"    
	
	//"CW_ЭлектронныйОбменДанными"
	Если CW_ВерсииПодсистемСервер.СуществуетПодсистема("CW_БухгалтерияЭкспедитора.CW_ЭлектронныйОбменДанными") Тогда  
		Модуль_CW_ЭлектронныйОбменДаннымиСлужебный = CW_ОбщегоНазначения.ОбщийМодуль("CW_ЭлектронныйОбменДаннымиСлужебный");
		Модуль_CW_ЭлектронныйОбменДаннымиСлужебный.ПриДобавленииОбработчиковОбновления(Обработчики);
	КонецЕсли; 
	//"CW_ЭлектронныйОбменДанными"   
	
	//"CW_РаботаСПодключаемымиОбъектами"
	Если CW_ВерсииПодсистемСервер.СуществуетПодсистема("CW_БухгалтерияЭкспедитора.CW_РаботаСПодключаемымиОбъектами") Тогда  
		Модуль_CW_РаботаСПодключаемымиОбъектамиСлужебный = CW_ОбщегоНазначения.ОбщийМодуль("CW_РаботаСПодключаемымиОбъектамиСлужебный");
		Модуль_CW_РаботаСПодключаемымиОбъектамиСлужебный.ПриДобавленииОбработчиковОбновления(Обработчики);
	КонецЕсли; 
	//"CW_РаботаСПодключаемымиОбъектами"
	
	
КонецПроцедуры

