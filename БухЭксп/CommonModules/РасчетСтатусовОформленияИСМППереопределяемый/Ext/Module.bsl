//Формирует дополнительную таблицу дат учета в запрос статсуов
//Параметры: нет
//
//Возвращаемое значение: ТаблицаДатаНачалаУчета Тип("ТаблицаЗначений")
//
Функция ТаблицаДатаНачалаУчета() Экспорт
	
	ВидыПродукции = КонструкторИСМПКлиентСервер.ВидыПродукцииПрослеживаемогоПеремещенияМеждуМОД();
	
	ТаблицаДатаНачалаУчета = Новый ТаблицаЗначений;
	ТаблицаДатаНачалаУчета.Колонки.Добавить("ВидПродукции"						, Новый ОписаниеТипов("СправочникСсылка.ВидыПродукцииИС"));
	ТаблицаДатаНачалаУчета.Колонки.Добавить("ДатаНачалаУчетаПеремещенияМеждуМОД", ОбщегоНазначения.ОписаниеТипаДата(ЧастиДаты.Дата));
	
