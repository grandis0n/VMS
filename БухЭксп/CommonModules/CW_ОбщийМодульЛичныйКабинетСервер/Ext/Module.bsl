Процедура ОтправитьПользователюПароль(ПараметрыПроцедуры, АдресРезультата) Экспорт
	
	РегистрационныйНомер 	= CW_ПроверкаЛицензии.ПолучитьРегистрационныйНомер();

	СтруктураJSON = Новый Структура;	
	СтруктураJSON.Вставить("regnumber",	XMLСтрока(РегистрационныйНомер));
	СтруктураJSON.Вставить("userid", 	XMLСтрока(ПараметрыПроцедуры.ИдентифкаторПользователя));
	СтруктураJSON.Вставить("email",		XMLСтрока(ПараметрыПроцедуры.ЭлектроннаяПочта));   
	СтруктураJSON.Вставить("requirepasswordchange", XMLСтрока(Истина));   
	
	ПараметрыHTTPЗапроса = CW_РаботаСВнешнимиРесурсамиСервер.ПодготовитьHTTPЗапрос("lkk_sendpassword", СтруктураJSON);

	Ответ 		= CW_РаботаСВнешнимиРесурсамиСервер.ПолучитьДанныеССервера(ПараметрыHTTPЗапроса.HTTPСоединение, ПараметрыHTTPЗапроса.HTTPЗапрос, "POST");   
	Если Ответ = Неопределено Тогда
		ВызватьИсключение "Отсутствует соединение с интернетом";
	КонецЕсли;
	
	Если Ответ.КодСостояния <> 200 Тогда
		СоответствиеКодовСостояний = CW_ОбщийМодульЛичныйКабинетКлиентСервер.ПолучитьОписаниеКодовСостояний();	
		ОписаниеОшибки = СоответствиеКодовСостояний.Получить(Ответ.КодСостояния);	
		ВызватьИсключение "Код состояния: " + Ответ.КодСостояния + " - " + ОписаниеОшибки;
	КонецЕсли;    
	
	СтруктураJSON = CW_РаботаСВнешнимиРесурсамиСервер.ПрочитатьHTTPСервисВОбъект(Ответ);	
	
	Если СтруктураJSON.Свойство("error") Тогда
		ТекстОщибки = XMLЗначение(тип("Строка"),	СтруктураJSON.error);  
	КонецЕсли;
	
	Результат = Новый Структура;
