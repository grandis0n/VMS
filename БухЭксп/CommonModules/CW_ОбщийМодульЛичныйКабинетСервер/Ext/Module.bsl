Функция ПолучитьИнформациюЛичногоКабинета(ПолучитьЛоготип = Ложь, УникальныйИдентифкатор=Неопределено) Экспорт
	
	СервисДоступен 		= Ложь;
	МассивОрганизаций 	= новый Массив;
	ДанныеУчетнойЗаписи = новый Структура;
	
	РегистрационныйНомер 	= CW_ПроверкаЛицензии.ПолучитьРегистрационныйНомер();
	
	СтруктураJSON = Новый Структура;
	СтруктураJSON.Вставить("regnumber", XMLСтрока(РегистрационныйНомер));
	СтруктураJSON.Вставить("getlogo", 	XMLСтрока(ПолучитьЛоготип));      
	
	ПараметрыHTTPЗапроса = CW_РаботаСВнешнимиРесурсамиСервер.ПодготовитьHTTPЗапрос("lkk_reginfo", СтруктураJSON);
	
	Если ПараметрыHTTPЗапроса.УказаныРегистрационныеДанные Тогда
		
		Ответ = CW_РаботаСВнешнимиРесурсамиСервер.ПолучитьДанныеССервера(ПараметрыHTTPЗапроса.HTTPСоединение, ПараметрыHTTPЗапроса.HTTPЗапрос, "GET"); 
		Если Ответ = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		
		СервисДоступен = Ответ.КодСостояния = 200;
		Если СервисДоступен Тогда  
			
			СтруктураJSON = CW_РаботаСВнешнимиРесурсамиСервер.ПрочитатьHTTPСервисВОбъект(Ответ);
			
			regnumber 		= XMLЗначение(тип("Строка"), 	СтруктураJSON.regnumber);
			currentrate		= XMLЗначение(тип("Строка"), 	СтруктураJSON.currentrate);
			startdate 		= XMLЗначение(тип("Дата"), 		СтруктураJSON.startdate);
			enddate 		= XMLЗначение(тип("Дата"), 		СтруктураJSON.enddate);
			startdateaf		= XMLЗначение(тип("Дата"), 		СтруктураJSON.startdateaf);
			enddateaf 		= XMLЗначение(тип("Дата"), 		СтруктураJSON.enddateaf);
			userslimit 		= XMLЗначение(тип("Число"), 	СтруктураJSON.userslimit);
			userstotal 		= XMLЗначение(тип("Число"), 	СтруктураJSON.userstotal);
			allowed 		= XMLЗначение(тип("Булево"), 	СтруктураJSON.allowed);
			clientempty		= XMLЗначение(тип("Булево"), 	СтруктураJSON.clientempty);
			withoutpay 		= XMLЗначение(тип("Булево"), 	СтруктураJSON.withoutpay);     
			
			name 		= XMLЗначение(тип("Строка"), 	СтруктураJSON.name);
			nameen 		= XMLЗначение(тип("Строка"), 	СтруктураJSON.nameen);
			phone 		= XMLЗначение(тип("Строка"), 	СтруктураJSON.phone);
			website 	= XMLЗначение(тип("Строка"), 	СтруктураJSON.website);
			email 		= XMLЗначение(тип("Строка"), 	СтруктураJSON.email);
			emailowner 	= XMLЗначение(тип("Строка"), 	СтруктураJSON.emailowner); 
			
			displayname	= XMLЗначение(тип("Строка"), 	СтруктураJSON.displayname);
			timezone 	= XMLЗначение(тип("Строка"), 	СтруктураJSON.timezone);
			Если Не ПустаяСтрока(timezone) Тогда
				ЧасовойПоясПредставление = "("+ПредставлениеЧасовогоПояса(timezone)+") "+СокрЛП(timezone);
			КонецЕсли;  
			
			ДанныеУчетнойЗаписи  = CW_РаботаСВнешнимиРесурсамиСервер.СтрокаJSONВОбъект(СтруктураJSON.mailaccount);
			
			МассивОрганизаций = СтруктураJSON.allowedorganization; 
			
			Если СтруктураJSON.Свойство("logo") Тогда   
				Если ПустаяСтрока(СтруктураJSON.logo.data) Тогда
					АдресЛоготипа = "";
				Иначе
					ДвоичныеДанные 	= Base64Значение(СтруктураJSON.logo.data);
					АдресЛоготипа 	= ПоместитьВоВременноеХранилище(ДвоичныеДанные, УникальныйИдентифкатор);
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;   
	
	РазрешенныеОрганизации = Новый Массив;
	Для Каждого idОрганизации из МассивОрганизаций Цикл
		ОрганизацияСсылка = Справочники.Организации.ПолучитьСсылку(XMLЗначение(Тип("УникальныйИдентификатор"), idОрганизации));
		ОрганизацияОбъект = ОрганизацияСсылка.ПолучитьОбъект();
		Если ОрганизацияОбъект <> Неопределено Тогда
			РазрешенныеОрганизации.Добавить(ОрганизацияСсылка);	
		КонецЕсли;
	КонецЦикла;
	
	Результат = Новый Структура;
	Результат.Вставить("ЛогинУказан", 			ПараметрыHTTPЗапроса.УказаныРегистрационныеДанные );
	Результат.Вставить("РегНомер", 				regnumber);
	Результат.Вставить("ТекущийТариф", 			currentrate);
	Результат.Вставить("ДатаНачала",			startdate);
	Результат.Вставить("ДатаОкончания",			enddate);
	Результат.Вставить("ДатаНачалаAF",			startdateaf);
	Результат.Вставить("ДатаОкончанияAF",		enddateaf);
	Результат.Вставить("ЛимитПользователей", 	userslimit);
	Результат.Вставить("ВсегоПользователей", 	userstotal); 
	Результат.Вставить("Разрешено", 			allowed); 
	
	Результат.Вставить("КлиентПустой", 			clientempty);
	Результат.Вставить("СервисДоступен", 		СервисДоступен);
	Результат.Вставить("БезОплаты", 			withoutpay);
	Результат.Вставить("АдресЛоготипа", 		АдресЛоготипа);
	
	Результат.Вставить("ЧасовойПояс", 				timezone);
	Результат.Вставить("ЧасовойПоясПредставление",	ЧасовойПоясПредставление);
	
	Результат.Вставить("НазваниеКомпании", 		name);
	Результат.Вставить("НазваниеКомпанииАнгл", 	nameen);
	Результат.Вставить("Сайт", 					website);
	Результат.Вставить("Телефоны", 				phone);
	Результат.Вставить("ЭлектроннаяПочта", 					email);
	Результат.Вставить("ЭлектроннаяПочтаДляРегистрации",	emailowner);  
	Результат.Вставить("ОтображаемоеИмяАдресаПриРассылке",	displayname);  
	
	Результат.Вставить("РазрешенныеОрганизации", РазрешенныеОрганизации);
	Результат.Вставить("ДанныеУчетнойЗаписи", 	 ДанныеУчетнойЗаписи); 
	
	Возврат Результат;
	
КонецФункции

