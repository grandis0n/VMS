Функция ПроверитьВозможностьРаботыВСервисе() Экспорт
	
	РегистрационныйНомер 		= CW_ПроверкаЛицензии.ПолучитьРегистрационныйНомер();
	
	СтруктураJSON = Новый Структура;
	СтруктураJSON.Вставить("regnumber", 	XMLСтрока(РегистрационныйНомер)); 

	ПараметрыHTTPЗапроса = CW_РаботаСВнешнимиРесурсамиСервер.ПодготовитьHTTPЗапрос("lkk_checkaccess", СтруктураJSON);
	
	Ответ = CW_РаботаСВнешнимиРесурсамиСервер.ПолучитьДанныеССервера(ПараметрыHTTPЗапроса.HTTPСоединение, ПараметрыHTTPЗапроса.HTTPЗапрос, "GET");
	Если Ответ = Неопределено Тогда  
		ВызватьИсключение "Отсутствует соединение с интернетом";
	КонецЕсли;
	
	СтруктураJSON = CW_РаботаСВнешнимиРесурсамиСервер.ПрочитатьHTTPСервисВОбъект(Ответ);
	
	Результат = Новый Структура;
	Результат.Вставить("КодСостояния", 	Ответ.КодСостояния);
	Результат.Вставить("Описание", 		XMLЗначение(Тип("Строка"), СтруктураJSON.info));
	
	Возврат Результат;
	
КонецФункции

Функция СоздатьОбновитьПользователяЛичногоКабинета() Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	ЛогинПароль = CW_РаботаСВнешнимиРесурсамиСервер.ПолучитьЛогинПарольПользователя();
	Если Не ЗначениеЗаполнено(ЛогинПароль.Логин) 
		или Не ЗначениеЗаполнено(ЛогинПароль.Пароль) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Пользователь = Справочники.Пользователи.ПустаяСсылка();
	
	ПользовательИБ = ПользователиИнформационнойБазы.НайтиПоИмени(ЛогинПароль.Логин);
	Если ПользовательИБ <> Неопределено Тогда
		Пользователь = Справочники.Пользователи.НайтиПоРеквизиту("ИдентификаторПользователяИБ", ПользовательИБ.УникальныйИдентификатор);
	КонецЕсли;
	
	СоздатьПользователя = Ложь;
	Если Пользователь.Пустая() Тогда
		Если ПользовательИБ <> Неопределено Тогда
			ПользовательИБ.Удалить();
		КонецЕсли;
		СоздатьПользователя = Истина;
	КонецЕсли;
	
	ОписаниеПользователяИБ = Пользователи.НовоеОписаниеПользователяИБ();
	ОписаниеПользователяИБ.Имя 							= ЛогинПароль.Логин;
	ОписаниеПользователяИБ.ПолноеИмя 					= ЛогинПароль.Логин;
	ОписаниеПользователяИБ.АутентификацияСтандартная 	= Истина;
	ОписаниеПользователяИБ.ЗапрещеноИзменятьПароль	 	= Истина;
	ОписаниеПользователяИБ.ЗапрещеноИзменятьПароль	 	= Истина;
	ОписаниеПользователяИБ.Пароль	 					= ЛогинПароль.Пароль;
	
	мРоли = Новый Массив;
	мРоли.Добавить("БухгалтерияЭкспедитора");
	мРоли.Добавить("БухгалтерияЭкспедитораВнешнееСоединение");
	
	ОписаниеПользователяИБ.Вставить("Роли", мРоли);
	
	ОписаниеПользователяИБ.Вставить("Действие", "Записать");
	
	Если СоздатьПользователя Тогда
		СпрПользователи = Справочники.Пользователи.СоздатьЭлемент();
	Иначе
		СпрПользователи = Пользователь.ПолучитьОбъект();
	КонецЕсли;

	СпрПользователи.Наименование 	= ЛогинПароль.Логин;
	СпрПользователи.Служебный 		= истина;
	
	СпрПользователи.ДополнительныеСвойства.Вставить("ОписаниеПользователяИБ", 		ОписаниеПользователяИБ);
	СпрПользователи.ДополнительныеСвойства.Вставить("ПривелигированныйРежимЗаписи", Истина);
	
	СпрПользователи.Записать();
	
	Возврат истина;
			
КонецФункции


