//Перевод в архив
Процедура ПереводГрузоперевозокВАрхив(ПараметрыПроцедуры = Неопределено, АдресРезультата= Неопределено) Экспорт
	
	мПрофили = Новый Массив;
	ПеревестиГрузоперевозокиВАрхив(мПрофили);
	
КонецПроцедуры

Процедура ПеревестиГрузоперевозокиВАрхив(мПрофили) Экспорт
	
	УстановленОтборПоПрофлям = мПрофили.Количество() <> 0; 
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("мПрофили", мПрофили);
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	CW_ВебПрофилиПеревозок.Ссылка КАК Ссылка,
	               |	CW_ВебПрофилиПеревозок.НастройкиОсновногоОтбора КАК НастройкиОсновногоОтбора,
	               |	CW_ВебПрофилиПеревозок.ПараметрПереводаВАрхив КАК ПараметрПереводаВАрхив,
	               |	CW_ВебПрофилиПеревозок.ПараметрПереводаВАрхив.ЭтоКонтрольнаяДата КАК ПараметрКонтрольнаяДата,
	               |	CW_ВебПрофилиПеревозок.ОтсрочкаПереводаВАрхив КАК Дни,
	               |	CW_ВебПрофилиПеревозок.ИдентификаторАрхива КАК ИдентификаторАрхива
	               |ИЗ
	               |	Справочник.CW_ВебПрофилиПеревозок КАК CW_ВебПрофилиПеревозок
	               |ГДЕ
	               |	CW_ВебПрофилиПеревозок.ПометкаУдаления = ЛОЖЬ
	               |	И CW_ВебПрофилиПеревозок.Активный = ИСТИНА
	               |	И CW_ВебПрофилиПеревозок.АвтоматическиПереводитьВАрхив = ИСТИНА
           		   |	//ОтборПрофилей"; 

	Если УстановленОтборПоПрофлям Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст,"//ОтборПрофилей", " И CW_ВебПрофилиПеревозок.Ссылка В(&мПрофили)"); 
	КонецЕсли;
	
	Выборка = запрос.Выполнить().Выбрать();
	
	мГрузоперевозокиДляПереводаВАрхив = Новый Массив;
	
	Пока Выборка.Следующий() Цикл
		
		СКД = Справочники.CW_ВебПрофили.ПолучитьМакет("СхемаПараметров");
	
		СтрокаПоляКомпоновки = "Ссылка."+Выборка.ПараметрПереводаВАрхив.Идентификатор;
		Если Выборка.ПараметрКонтрольнаяДата Тогда
			СтрокаПоляКомпоновки = СтрокаПоляКомпоновки + "_ЗначениеФакт";
		КонецЕсли;
		ИмяПоляКомпоновки = СокрЛП(Новый ПолеКомпоновкиДанных(СтрокаПоляКомпоновки));
		
		НастройкиОсновногоОтбора	= Выборка.НастройкиОсновногоОтбора.Получить();
		
		НастройкиКомпоновкиДанных 	= СКД.НастройкиПоУмолчанию;
		
		ТаблицаЗначений = Новый ТаблицаЗначений;    
		ПроцессорВыводаВКоллекциюЗначений = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;    
		ПроцессорВыводаВКоллекциюЗначений.УстановитьОбъект(ТаблицаЗначений);    
		
		КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
		КомпоновщикНастроек = Новый КомпоновщикНастроекКомпоновкиДанных;
		КомпоновщикНастроек.ЗагрузитьНастройки(СКД.НастройкиПоУмолчанию);
		
		КомпоновщикНастроек.Настройки.Выбор.Элементы.Очистить();
		
		ВычисляемоеПоле = СКД.ВычисляемыеПоля.Добавить();
		ВычисляемоеПоле.ПутьКДанным = 	"КонтрольнаяДата";
		ВычисляемоеПоле.Выражение 	= 	"ВЫБОР КОГДА ISNULL("+ИмяПоляКомпоновки+", ДАТАВРЕМЯ(1,1,1)) = ДАТАВРЕМЯ(1,1,1) ТОГДА
										| ДАТАВРЕМЯ(1,1,1)
										|ИНАЧЕ
										|	НАЧАЛОПЕРИОДА(ДОБАВИТЬКДАТЕ(ISNULL("+ИмяПоляКомпоновки+", ДАТАВРЕМЯ(1,1,1)) , ""ДЕНЬ"", "+Формат(Выборка.Дни,"ЧДЦ=0; ЧН=0; ЧГ=")+ "), ""ДЕНЬ"")
										|КОНЕЦ";
		
		НовоеПоле = КомпоновщикНастроек.Настройки.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
		НовоеПоле.Заголовок 	= "Ссылка";
		НовоеПоле.Поле 			= Новый ПолеКомпоновкиДанных("Ссылка");
		НовоеПоле.Использование = Истина;
		
		НовоеПоле = КомпоновщикНастроек.Настройки.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
		НовоеПоле.Заголовок 	= ИмяПоляКомпоновки;
		НовоеПоле.Поле 			= Новый ПолеКомпоновкиДанных(СтрокаПоляКомпоновки);
		НовоеПоле.Использование = Истина;
		
		НовоеПоле = КомпоновщикНастроек.Настройки.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
		НовоеПоле.Заголовок 	= "КонтрольнаяДата";
		НовоеПоле.Поле 			= Новый ПолеКомпоновкиДанных("КонтрольнаяДата");
		НовоеПоле.Использование = Истина;
		
		НастройкиОсновногоОтбора = Выборка.НастройкиОсновногоОтбора.Получить();
		Если НастройкиОсновногоОтбора <> Неопределено Тогда
			Для Каждого ЭлементОтбора Из НастройкиОсновногоОтбора.Отбор.Элементы Цикл
				ЭлементОтбораСКД = КомпоновщикНастроек.Настройки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
				ЗаполнитьЗначенияСвойств(ЭлементОтбораСКД, ЭлементОтбора);
			КонецЦикла;
		КонецЕсли;  

		ГруппаОтбораИ = КомпоновщикНастроек.Настройки.Отбор.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
		ГруппаОтбораИ.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИ;
		ГруппаОтбораИ.Использование = Истина;
		
		ЭлементОтбораСКД = ГруппаОтбораИ.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбораСКД.ЛевоеЗначение 	= Новый ПолеКомпоновкиДанных("КонтрольнаяДата");
		ЭлементОтбораСКД.ВидСравнения 	= ВидСравненияКомпоновкиДанных.МеньшеИлиРавно;
		ЭлементОтбораСКД.ПравоеЗначение = НачалоДня(ТекущаяДата());
		
		ЭлементОтбораСКД = ГруппаОтбораИ.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбораСКД.ЛевоеЗначение 	= Новый ПолеКомпоновкиДанных(СтрокаПоляКомпоновки);
		ЭлементОтбораСКД.ВидСравнения 	= ВидСравненияКомпоновкиДанных.НеРавно;
		ЭлементОтбораСКД.ПравоеЗначение = Дата(1,1,1);
		
		ГруппаОтбораИЛИ = КомпоновщикНастроек.Настройки.Отбор.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
		ГруппаОтбораИЛИ.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИли;
		ГруппаОтбораИЛИ.Использование = Истина;
		
		ЭлементОтбораСКД = ГруппаОтбораИЛИ.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбораСКД.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Ссылка."+Выборка.ИдентификаторАрхива.Идентификатор);
		ЭлементОтбораСКД.ВидСравнения = ВидСравненияКомпоновкиДанных.НеРавно;
		ЭлементОтбораСКД.ПравоеЗначение = Истина;
		
		ЭлементОтбораСКД = ГруппаОтбораИЛИ.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбораСКД.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Ссылка."+Выборка.ИдентификаторАрхива.Идентификатор);
		ЭлементОтбораСКД.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено;
		
		ЭлементОтбораСКД = ГруппаОтбораИЛИ.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбораСКД.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Ссылка."+Выборка.ИдентификаторАрхива.Идентификатор);
		ЭлементОтбораСКД.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		ЭлементОтбораСКД.ПравоеЗначение = null;
	
		МакетКомпоновки = КомпоновщикМакета.Выполнить(СКД,КомпоновщикНастроек.Настройки, , , Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
		ПроцессорКомпоновкиДанных = Новый ПроцессорКомпоновкиДанных;    
		ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновки);
		
		ТаблицаГрузоперевозок = ПроцессорВыводаВКоллекциюЗначений.Вывести(ПроцессорКомпоновкиДанных);
		
		//Перевод в архив
		Для Каждого СтрокаТаблицы из ТаблицаГрузоперевозок Цикл
			
			ТГрузоперевозка	= СтрокаТаблицы.Ссылка.ПолучитьОбъект(); 
			ПараметрыОтбора = Новый Структура("Параметр", Выборка.ИдентификаторАрхива);
			
			мСтроки = ТГрузоперевозка.ПараметрыГрузоперевозки.НайтиСтроки(ПараметрыОтбора); 
			Если мСтроки.Количество() > 0 Тогда
				СтрокаПараметров = мСтроки[0];
				СтрокаПараметров.Значение = истина;
			Иначе
				СтрокаПараметров 			= ТГрузоперевозка.ПараметрыГрузоперевозки.Добавить();
				СтрокаПараметров.Параметр 	= Выборка.ИдентификаторАрхива;
				СтрокаПараметров.Значение 	= истина;
			КонецЕсли;
			
			ТГрузоперевозка.Записать();
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры


Процедура ПереводЗаявокВАрхив(ПараметрыПроцедуры = Неопределено, АдресРезультата= Неопределено) Экспорт

	мПрофили = Новый Массив;
	ПеревестиЗаявкиВАрхив(мПрофили);

КонецПроцедуры  

Процедура ПеревестиЗаявкиВАрхив(мПрофили) Экспорт
	
	УстановленОтборПоПрофлям = мПрофили.Количество() <> 0; 
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("мПрофили", мПрофили);
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	CW_ВебПрофилиЗаявок.Ссылка КАК Ссылка,
	               |	CW_ВебПрофилиЗаявок.НастройкиОсновногоОтбора КАК НастройкиОсновногоОтбора,
	               |	CW_ВебПрофилиЗаявок.ПараметрПереводаВАрхив КАК ПараметрПереводаВАрхив,
	               |	CW_ВебПрофилиЗаявок.ПараметрПереводаВАрхив.ЭтоКонтрольнаяДата КАК ПараметрКонтрольнаяДата,
	               |	CW_ВебПрофилиЗаявок.ОтсрочкаПереводаВАрхив КАК Дни,
	               |	CW_ВебПрофилиЗаявок.ИдентификаторАрхива КАК ИдентификаторАрхива
	               |ИЗ
	               |	Справочник.CW_ВебПрофилиЗаявок КАК CW_ВебПрофилиЗаявок
	               |ГДЕ
	               |	CW_ВебПрофилиЗаявок.ПометкаУдаления = ЛОЖЬ
	               |	И CW_ВебПрофилиЗаявок.Активный = ИСТИНА
	               |	И CW_ВебПрофилиЗаявок.АвтоматическиПереводитьВАрхив = ИСТИНА
           		   |	//ОтборПрофилей"; 

	Если УстановленОтборПоПрофлям Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст,"//ОтборПрофилей", " И CW_ВебПрофилиЗаявок.Ссылка В(&мПрофили)"); 
	КонецЕсли;
	
	Выборка = запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		СКД = ПолучитьОбщийМакет("CW_ЗаявкиСхемаПараметров");
	
		СтрокаПоляКомпоновки = "Ссылка."+Выборка.ПараметрПереводаВАрхив.Идентификатор;
		Если Выборка.ПараметрКонтрольнаяДата Тогда
			СтрокаПоляКомпоновки = СтрокаПоляКомпоновки + "_ЗначениеФакт";
		КонецЕсли;
		ИмяПоляКомпоновки = СокрЛП(Новый ПолеКомпоновкиДанных(СтрокаПоляКомпоновки));
		
		НастройкиКомпоновкиДанных = СКД.НастройкиПоУмолчанию;   
		
		ТаблицаЗначений = Новый ТаблицаЗначений;    
		ПроцессорВыводаВКоллекциюЗначений = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;    
		ПроцессорВыводаВКоллекциюЗначений.УстановитьОбъект(ТаблицаЗначений);    
		
		КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
		КомпоновщикНастроек = Новый КомпоновщикНастроекКомпоновкиДанных;
		КомпоновщикНастроек.ЗагрузитьНастройки(СКД.НастройкиПоУмолчанию);
		
		КомпоновщикНастроек.Настройки.Выбор.Элементы.Очистить();
		
		ВычисляемоеПоле = СКД.ВычисляемыеПоля.Добавить();
		ВычисляемоеПоле.ПутьКДанным = 	"КонтрольнаяДата";
		ВычисляемоеПоле.Выражение 	= 	"ВЫБОР КОГДА ISNULL("+ИмяПоляКомпоновки+", ДАТАВРЕМЯ(1,1,1)) = ДАТАВРЕМЯ(1,1,1) ТОГДА
										| ДАТАВРЕМЯ(1,1,1)
										|ИНАЧЕ
										|	НАЧАЛОПЕРИОДА(ДОБАВИТЬКДАТЕ(ISNULL("+ИмяПоляКомпоновки+", ДАТАВРЕМЯ(1,1,1)) , ""ДЕНЬ"", "+Формат(Выборка.Дни,"ЧДЦ=0; ЧН=0; ЧГ=")+ "), ""ДЕНЬ"")
										|КОНЕЦ";
		
		НовоеПоле = КомпоновщикНастроек.Настройки.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
		НовоеПоле.Заголовок 	= "Ссылка";
		НовоеПоле.Поле 			= Новый ПолеКомпоновкиДанных("Ссылка");
		НовоеПоле.Использование = Истина;
		
		НовоеПоле = КомпоновщикНастроек.Настройки.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
		НовоеПоле.Заголовок 	= ИмяПоляКомпоновки;
		НовоеПоле.Поле 			= Новый ПолеКомпоновкиДанных(СтрокаПоляКомпоновки);
		НовоеПоле.Использование = Истина;
		
		НовоеПоле = КомпоновщикНастроек.Настройки.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
		НовоеПоле.Заголовок 	= "КонтрольнаяДата";
		НовоеПоле.Поле 			= Новый ПолеКомпоновкиДанных("КонтрольнаяДата");
		НовоеПоле.Использование = Истина;
		
		НастройкиОсновногоОтбора = Выборка.НастройкиОсновногоОтбора.Получить();
		Если НастройкиОсновногоОтбора <> Неопределено Тогда
