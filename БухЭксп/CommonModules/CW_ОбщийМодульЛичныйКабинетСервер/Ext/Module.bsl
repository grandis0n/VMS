//Задания отправки
Процедура ПолучитьИнформациюПоЗаданиям(ПараметрыПроцедуры, АдресРезультата) Экспорт   
	
	РегистрационныйНомер 	= CW_ПроверкаЛицензии.ПолучитьРегистрационныйНомер();

	СтруктураJSON = Новый Структура;
	СтруктураJSON.Вставить("regnumber", XMLСтрока(РегистрационныйНомер));
	СтруктураJSON.Вставить("userid", 	XMLСтрока(ПараметрыПроцедуры.ИдентифкаторПользователя));
	СтруктураJSON.Вставить("master", 	XMLСтрока(ПараметрыПроцедуры.ОсновнойПрофиль));
	
	ПараметрыHTTPЗапроса = CW_РаботаСВнешнимиРесурсамиСервер.ПодготовитьHTTPЗапрос("lkk_taskssending", СтруктураJSON);

	Ответ = CW_РаботаСВнешнимиРесурсамиСервер.ПолучитьДанныеССервера(ПараметрыHTTPЗапроса.HTTPСоединение, ПараметрыHTTPЗапроса.HTTPЗапрос, "GET");   
	Если Ответ = Неопределено Тогда 
		ВызватьИсключение "Отсутствует интернет-соединение";
	КонецЕсли;  
	Если Ответ.КодСостояния <> 200 Тогда 
		ВызватьИсключение Ответ.ПолучитьТелоКакСтроку();
	КонецЕсли;  

	ОтветJSON = Ответ.ПолучитьТелоКакСтроку();
	
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(ОтветJSON);  
	
	МассивJSON = ПрочитатьJSON(ЧтениеJSON);
	ЧтениеJSON.Закрыть();   
	
	Результат = Новый Массив;
	
	Для Каждого НастройкиЗадания из МассивJSON Цикл   
	
		Структура = Новый Структура;
		Структура.Вставить("НомерЗадания",			XMLЗначение(Тип("Число"),  НастройкиЗадания.number));
		Структура.Вставить("ИдентификаторЗадания", 	XMLЗначение(Тип("Строка"), НастройкиЗадания.taskid));
		Структура.Вставить("ЧасовойПояс", 			XMLЗначение(Тип("Строка"), НастройкиЗадания.timezone));
		Структура.Вставить("стрДни",				XMLЗначение(Тип("Строка"), НастройкиЗадания.days));
		Структура.Вставить("Используетвся", 		XMLЗначение(Тип("Булево"), НастройкиЗадания.use));
		Структура.Вставить("ДатаНачала", 			XMLЗначение(Тип("Дата"),   НастройкиЗадания.start));
		Структура.Вставить("ВремяНачала", 			XMLЗначение(Тип("Дата"),   НастройкиЗадания.starttime));
		Структура.Вставить("Получатели", 			XMLЗначение(Тип("Строка"), НастройкиЗадания.recipient));
		Структура.Вставить("Копии", 				XMLЗначение(Тип("Строка"), НастройкиЗадания.copy));
		Структура.Вставить("ОтправлятьПакет", 		XMLЗначение(Тип("Булево"), НастройкиЗадания.package)); 
		
		filetemplate = "";
		Если НастройкиЗадания.Свойство("filetemplate") Тогда
			filetemplate = НастройкиЗадания.filetemplate;
		КонецЕсли;
		Структура.Вставить("ШаблонИмениФайла", 		XMLЗначение(Тип("Строка"), filetemplate)); 
		
		
		ТаблицаПрофилей = Новый ТаблицаЗначений;
		ТаблицаПрофилей.Колонки.Добавить("Профиль", 	Новый ОписаниеТипов("Строка"));
		ТаблицаПрофилей.Колонки.Добавить("Статус", Новый ОписаниеТипов("Число")); 
		
		Для Каждого ДанныеПрофиля из НастройкиЗадания.profiles Цикл
			НоваяСтрока = ТаблицаПрофилей.Добавить();
			НоваяСтрока.Профиль	= XMLЗначение(Тип("Строка"), ДанныеПрофиля.id);
			НоваяСтрока.Статус 	= XMLЗначение(Тип("Число"),  ДанныеПрофиля.variant);
		КонецЦикла; 
		
		Структура.Вставить("ТаблицаПрофилей", 		ТаблицаПрофилей);   
				
		Результат.Добавить(Структура);
		
	КонецЦикла;
	
	ПоместитьВоВременноеХранилище(Результат, АдресРезультата);
	
КонецПроцедуры

Процедура ЗаписатьЗаданияОтправки(ПараметрыПроцедуры, АдресРезультата) Экспорт 
	
	РегистрационныйНомер 	 = CW_ПроверкаЛицензии.ПолучитьРегистрационныйНомер();
	
	МассивЗаданий = Новый Массив;
	Для Каждого СтрукутраЗадания из ПараметрыПроцедуры.МассивНастроекДляЗаписи Цикл  
		
		СтруктураЗадания = Новый Структура;
		СтруктураЗадания.Вставить("master",		XMLСтрока(СтрукутраЗадания.ОсновнойПрофиль));
		СтруктураЗадания.Вставить("number",		XMLСтрока(СтрукутраЗадания.НомерЗадания));
		СтруктураЗадания.Вставить("taskid",		XMLСтрока(СтрукутраЗадания.ИдентификаторЗадания));
		СтруктураЗадания.Вставить("use",		XMLСтрока(СтрукутраЗадания.Использование));
		СтруктураЗадания.Вставить("start",		XMLСтрока(СтрукутраЗадания.ДатаНачала));
		СтруктураЗадания.Вставить("starttime",	XMLСтрока(СтрукутраЗадания.ВремяНачала));
		СтруктураЗадания.Вставить("days",		XMLСтрока(СтрукутраЗадания.ДниНедели));
		
		СтруктураЗадания.Вставить("recipient",	XMLСтрока(СтрукутраЗадания.Получатели));
		СтруктураЗадания.Вставить("copy",		XMLСтрока(СтрукутраЗадания.Копии));
		СтруктураЗадания.Вставить("package",	XMLСтрока(СтрукутраЗадания.ОтправлятьПакет));  
		
  		СтруктураЗадания.Вставить("filetemplate", XMLСтрока(СтрукутраЗадания.ШаблонИмениФайла));

		МассивПрофилей = Новый Массив;
		//Настройки профилей
		Для Каждого СтрокаНастроек из СтрукутраЗадания.НастройкиПрофилей Цикл	
			СтруктураПрофиля = Новый Структура;
			СтруктураПрофиля.Вставить("id", 		XMLСтрока(СтрокаНастроек.Профиль));
			СтруктураПрофиля.Вставить("variant",	XMLСтрока(СтрокаНастроек.Статус));
			
			МассивПрофилей.Добавить(СтруктураПрофиля);	
		КонецЦикла; 
		//Настройки профилей     
		
		СтруктураЗадания.Вставить("profiles", МассивПрофилей); 
		
		МассивЗаданий.Добавить(СтруктураЗадания);
	КонецЦикла;  
	
	СтруктураJSON = Новый Структура;  
	СтруктураJSON.Вставить("regnumber", XMLСтрока(РегистрационныйНомер));
	СтруктураJSON.Вставить("userid", 	XMLСтрока(ПараметрыПроцедуры.ИдентифкаторПользователя));
	СтруктураJSON.Вставить("tasks", 	МассивЗаданий);
	
	ПараметрыHTTPЗапроса = CW_РаботаСВнешнимиРесурсамиСервер.ПодготовитьHTTPЗапрос("lkk_savetasks", СтруктураJSON);
	
	Ответ = CW_РаботаСВнешнимиРесурсамиСервер.ПолучитьДанныеССервера(ПараметрыHTTPЗапроса.HTTPСоединение, ПараметрыHTTPЗапроса.HTTPЗапрос, "POST");   
	Если Ответ = Неопределено Тогда  
		КодСостояния	= 503;
		ТекстСостояния 	= "Сервис временно недоступен";
	КонецЕсли;       
	
	СтруктураОтвета = Новый Структура;

	ОтветJSON = Ответ.ПолучитьТелоКакСтроку();
	Если Ответ.КодСостояния <> 200 Тогда 
		СтруктураОтвета.Вставить("КодСостояния",	Ответ.КодСостояния);
		СтруктураОтвета.Вставить("Тело",			ОтветJSON);
	КонецЕсли;  
	
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(ОтветJSON);  
	
	МассивJSON = ПрочитатьJSON(ЧтениеJSON);
	ЧтениеJSON.Закрыть();   

	Массив = новый Массив;
	Для Каждого НастройкиЗадания из МассивJSON Цикл  
		Структура = новый Структура;
		Структура.Вставить("НомерЗадания",			XMLЗначение(Тип("Строка"), НастройкиЗадания.number));
		Структура.Вставить("ИдентификаторЗадания",	XMLЗначение(Тип("УникальныйИдентификатор"),НастройкиЗадания.id));
		Массив.Добавить(Структура);
	КонецЦикла;  
	
	СтруктураОтвета.Вставить("Задания",			Массив);
	
	ПоместитьВоВременноеХранилище(СтруктураОтвета, АдресРезультата);
	
КонецПроцедуры

Процедура ВыполнитьЗаданиеОтправки(ПараметрыПроцедуры, АдресРезультата) Экспорт 

	РегистрационныйНомер = CW_ПроверкаЛицензии.ПолучитьРегистрационныйНомер();

	СтруктураJSON = Новый Структура;
	СтруктураJSON.Вставить("regnumber",	XMLСтрока(РегистрационныйНомер));
	СтруктураJSON.Вставить("taskid", 	XMLСтрока(ПараметрыПроцедуры.ИдентификаторЗадания));  
	
	ПараметрыHTTPЗапроса = CW_РаботаСВнешнимиРесурсамиСервер.ПодготовитьHTTPЗапрос("lkk_runtasks", СтруктураJSON);

	Ответ = CW_РаботаСВнешнимиРесурсамиСервер.ПолучитьДанныеССервера(ПараметрыHTTPЗапроса.HTTPСоединение, ПараметрыHTTPЗапроса.HTTPЗапрос, "POST");   
	Если Ответ = Неопределено Тогда  
		КодСостояния	= 503;
		ТекстСостояния 	= "Сервис временно недоступен";
	КонецЕсли;  
	
	Тело = Ответ.ПолучитьТелоКакСтроку();
	
	ПоместитьВоВременноеХранилище(Тело, АдресРезультата);
	
КонецПроцедуры

Функция СериализацияXDTO_JSON(Объект) Экспорт
	
	ЗаписьJSON = Новый ЗаписьJSON;
    ПараметрыЗаписиJSON = Новый ПараметрыЗаписиJSON(,Символы.Таб);
	ЗаписьJSON.УстановитьСтроку(ПараметрыЗаписиJSON);
	
	СериализаторXDTO.ЗаписатьJSON(ЗаписьJSON,Объект, НазначениеТипаXML.Явное);
	
	Возврат  ЗаписьJSON.Закрыть();
	
КонецФункции 

Функция СериализацияJSON_XDTO(СтрокаJSON) Экспорт
	
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(СтрокаJSON);
	
	Попытка
		ОбъектXDTO = СериализаторXDTO.ПрочитатьJSON(ЧтениеJSON);
	Исключение       
		Возврат Неопределено;	
	КонецПопытки;
	
	ЧтениеJSON.Закрыть();
	
	Возврат ОбъектXDTO;
	
КонецФункции


