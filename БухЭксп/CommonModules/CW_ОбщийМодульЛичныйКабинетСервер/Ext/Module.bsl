Процедура ОтправитьПользователюПриглашение(ПараметрыПроцедуры, АдресРезультата) Экспорт
	
	РегистрационныйНомер 	= CW_ПроверкаЛицензии.ПолучитьРегистрационныйНомер();

	СтруктураJSON = Новый Структура;
	СтруктураJSON.Вставить("regnumber",	XMLСтрока(РегистрационныйНомер));
	СтруктураJSON.Вставить("userid", 	XMLСтрока(ПараметрыПроцедуры.ИдентифкаторПользователя));
	СтруктураJSON.Вставить("email",		XMLСтрока(ПараметрыПроцедуры.ЭлектроннаяПочта));
	
	ПараметрыHTTPЗапроса = CW_РаботаСВнешнимиРесурсамиСервер.ПодготовитьHTTPЗапрос("lkk_sendinvitation", СтруктураJSON);

	Ответ 		= CW_РаботаСВнешнимиРесурсамиСервер.ПолучитьДанныеССервера(ПараметрыHTTPЗапроса.HTTPСоединение, ПараметрыHTTPЗапроса.HTTPЗапрос, "POST");   
	Если Ответ = Неопределено Тогда
		ВызватьИсключение "Отсутствует интернет-соединение";
	КонецЕсли;
	
	СтруктураJSON = CW_РаботаСВнешнимиРесурсамиСервер.ПрочитатьHTTPСервисВОбъект(Ответ);      
	Если Ответ.КодСостояния <> 200 Тогда
		СоответствиеКодовСостояний = CW_ОбщийМодульЛичныйКабинетКлиентСервер.ПолучитьОписаниеКодовСостояний();	
		ОписаниеОшибки = СоответствиеКодовСостояний.Получить(Ответ.КодСостояния);	
		ВызватьИсключение "Код состояния: " + Ответ.КодСостояния + " - " + ОписаниеОшибки;
	КонецЕсли;
	
	ТекстОшибки = "";
	Если СтруктураJSON.Свойство("error") Тогда
		ТекстОшибки = XMLЗначение(тип("Строка"),	СтруктураJSON.error);
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("КодСостояния",		Ответ.КодСостояния);
	Результат.Вставить("ОшибкаОтправки", 	ЗначениеЗаполнено(ТекстОшибки));
	Результат.Вставить("ТекстОшибки", 		ТекстОшибки);
	
	ПоместитьВоВременноеХранилище(Результат, АдресРезультата);
		
КонецПроцедуры

//Фоновая отмена счетов
Процедура ВыполнитьОтменуСчетов(ПараметрыПроцедуры, АдресРезультата) Экспорт
	
	МассивJSON = Новый Массив;
	Для каждого СтрокаТаблицы из ПараметрыПроцедуры.ТаблицаСчетов Цикл
		МассивJSON.Добавить(XMLСтрока(СтрокаТаблицы.ИдентифкаторСчета));
	КонецЦикла;   
	
	СтруктураJSON = Новый Структура;   
	СтруктураJSON.Вставить("NotifyCRM", Истина);

	СтруктураРегНомера = Новый Структура;
	СтруктураРегНомера.Вставить(XMLСтрока(СокрЛП("_"+ПараметрыПроцедуры.РегистрационныйНомер)), МассивJSON); 
	
