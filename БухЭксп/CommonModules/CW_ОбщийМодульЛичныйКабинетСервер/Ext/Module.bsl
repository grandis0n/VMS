	СтруктураJSON.Вставить("userid", 	XMLСтрока(ПараметрыПроцедуры.ИдентифкаторПользователя));
	
	ПараметрыHTTPЗапроса = CW_РаботаСВнешнимиРесурсамиСервер.ПодготовитьHTTPЗапрос("main_checkuser", СтруктураJSON);

	Ответ 		= CW_РаботаСВнешнимиРесурсамиСервер.ПолучитьДанныеССервера(ПараметрыHTTPЗапроса.HTTPСоединение, ПараметрыHTTPЗапроса.HTTPЗапрос, "GET");  
	Если Ответ = Неопределено Тогда
