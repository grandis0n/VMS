#Область ПОДГОТОВКА_НАБОРОВ_ДОКУМЕНТА_К_ПРОВЕДЕНИЮ

//подгтовка регистров документа к записи данных
Процедура ПодготовитьДвженияКПроведению(Объект) Экспорт
	
	Для Каждого НаборЗаписей Из Объект.Движения Цикл
		
		Если НаборЗаписей.Количество() > 0 Тогда
			НаборЗаписей.Очистить();
		КонецЕсли;
		
	КонецЦикла;
	
	МассивИменРегистров = ПолучитьИспользуемыеРегистры(Объект);
	Для Каждого ИмяРегистра Из МассивИменРегистров Цикл
		Объект.Движения[ИмяРегистра].Записывать = Истина;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти


#Область ВСПОМОГАТЕЛЬНЫЕ_ТАБЛИЦЫ

Функция ПолучитьИспользуемыеРегистры(Объект) Экспорт
	
	МассивИменРегистров = Новый Массив;
	
	Для Каждого движение из  Объект.Метаданные().Движения Цикл
		МассивИменРегистров.Добавить(движение.Имя);
	КонецЦикла;

	Возврат МассивИменРегистров;
	   
КонецФункции

// 	Возвращают таблицы значений для соответсвующего регитстра
// 
Функция ПодготовитьТаблицыДанныхДляПроведения(МассивИменРегистров) Экспорт
	
	мДобавляемыеСтандарнтыеРеквизты = Новый Массив;
	мДобавляемыеСтандарнтыеРеквизты.Добавить("Период");	
	мДобавляемыеСтандарнтыеРеквизты.Добавить("ВидДвижения");	

	СтркутраДанныхДляПроведения = новый Структура;
	
	Для каждого  ИмяРегистра из МассивИменРегистров Цикл
		
		мдРегистр = ПолучитьОбъектМетаданных(ИмяРегистра);

		Если мдРегистр = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ТаблицаДанных = новый ТаблицаЗначений;
		
		Для каждого СтандартныйРеквизит из мдРегистр.СтандартныеРеквизиты Цикл
			Если мДобавляемыеСтандарнтыеРеквизты.Найти(СтандартныйРеквизит.Имя) <> Неопределено Тогда
				ТаблицаДанных.Колонки.Добавить(СтандартныйРеквизит.Имя, СтандартныйРеквизит.Тип);
			КонецЕсли;
		КонецЦикла;
		
		Для каждого Измерение из мдРегистр.Измерения Цикл
			ТаблицаДанных.Колонки.Добавить(Измерение.Имя, Измерение.Тип);
		КонецЦикла;
		
		Для каждого Ресурс из мдРегистр.Ресурсы Цикл
			ТаблицаДанных.Колонки.Добавить(Ресурс.Имя, Ресурс.Тип);
		КонецЦикла;
		
		Для каждого Реквизит из мдРегистр.Реквизиты Цикл
			ТаблицаДанных.Колонки.Добавить(Реквизит.Имя, Реквизит.Тип);
		КонецЦикла;
		
		СтркутраДанныхДляПроведения.Вставить(ИмяРегистра, ТаблицаДанных);
		
	КонецЦикла;
	
	Возврат СтркутраДанныхДляПроведения;
	
КонецФункции

Функция ПолучитьОбъектМетаданных(ИмяРегистра)
	
	мдРегистра = Метаданные.РегистрыНакопления.Найти(ИмяРегистра);
	
	Если мдРегистра = Неопределено Тогда
		мдРегистра = Метаданные.РегистрыСведений.Найти(ИмяРегистра);
	КонецЕсли;
	
	Возврат мдРегистра;
	
КонецФункции

Функция ПолучитьУстанавливаемыеПараметры() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	CW_ПараметрытранспортныхСредств.ИмяПредопределенныхДанных КАК Имя,
		|	CW_ПараметрытранспортныхСредств.Ссылка КАК ПараметрСсылка
		|ИЗ
		|	ПланВидовХарактеристик.CW_ПараметрыТранспортныхСредств КАК CW_ПараметрытранспортныхСредств
		|ГДЕ
		|	CW_ПараметрытранспортныхСредств.Ссылка <> &РегистрационныйЗнак";
	
	Запрос.УстановитьПараметр("РегистрационныйЗнак", ПланыВидовХарактеристик.CW_ПараметрыТранспортныхСредств.РегистрационныйЗнак);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	СтруктураПараметров = Новый Структура;
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		СтруктураПараметров.Вставить(ВыборкаДетальныеЗаписи.Имя, ВыборкаДетальныеЗаписи.ПараметрСсылка);
	КонецЦикла;
	
	Возврат СтруктураПараметров;
	
КонецФункции

#КонецОбласти


#Область ЗАПИСЬ_ДВИЖЕНИЙ_ДОКУМЕНТОВ

//Процедура ЗарегистрироватьДвиженияДокумента
//
// Записывает движения документов по уччету совбсвенного транспорта
//
//Параметры:
// 		ОбъектДвижения 			- Движения документа
// 		ДанныеДляПроведения 	- Структура с таблицами значений см. вспомогательные таблицы, ключ структуры должен соответствовать имени записываемого регистра
// 		мСписокИменРегистров 	- Массив имен записываемых регистров;
//
Процедура ЗарегистрироватьДвиженияДокумента(ОбъектДвижения, ДанныеДляПроведения, мСписокИменРегистров) Экспорт
	
	Для Каждого ИмяРегистра Из мСписокИменРегистров Цикл
		
		Если ДанныеДляПроведения.Свойство(ИмяРегистра)  Тогда
			
			ТаблицаДвижений = ДанныеДляПроведения[ИмяРегистра];
			
			Если ТипЗнч(ТаблицаДвижений) = Тип("ТаблицаЗначений") Тогда
				
				Движения = ОбъектДвижения[ИмяРегистра];
				Движения.Загрузить(ТаблицаДвижений);
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти


#Область РАСЧЕТ_НОРМ_РАСХОДА_ТОПЛИВА

Функция ПолучитьДействующуюФормулуНормрасходатранспортныхСредств(ДатаСреза, ТранспортноеСредство) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	CW_ФормулыРасчетанормРасходаТопливаТранспортныхСредствСрезПоследних.ТранспортноеСредство КАК ТранспортноеСредство,
		|	CW_ФормулыРасчетанормРасходаТопливаТранспортныхСредствСрезПоследних.ФормулаРасчетаНормыРасходаТоплива КАК ФормулаРасчетаНормыРасходаТоплива,
		|	CW_ФормулыРасчетанормРасходаТопливаТранспортныхСредствСрезПоследних.ДействуетДо КАК ДействуетДо
		|ИЗ
		|	РегистрСведений.CW_ФормулыРасчетаНормРасходаТопливаТранспортныхСредств.СрезПоследних(&ДатаСреза, ТранспортноеСредство = &ТранспортноеСредство) КАК CW_ФормулыРасчетанормРасходаТопливаТранспортныхСредствСрезПоследних
		|ГДЕ
		|	CW_ФормулыРасчетанормРасходаТопливаТранспортныхСредствСрезПоследних.ТранспортноеСредство = &ТранспортноеСредство";
	
	Запрос.УстановитьПараметр("ДатаСреза"			, ДатаСреза);
	Запрос.УстановитьПараметр("ТранспортноеСредство", ТранспортноеСредство);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	ПараметрыФормулы = Новый Структура("ДействуетДо,ФормулаРасчетаНормыРасходаТоплива");
	
	Если ВыборкаДетальныеЗаписи.Следующий() тогда
		
		Если не ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.ФормулаРасчетаНормыРасходаТоплива) Тогда
			Возврат Неопределено;
		КонецЕсли;
		
		Если ВыборкаДетальныеЗаписи.ДействуетДо < ДатаСреза Тогда
			Возврат Неопределено;
		КонецЕсли;
		
		ПараметрыФормулы.ФормулаРасчетаНормыРасходаТоплива = ВыборкаДетальныеЗаписи.ФормулаРасчетаНормыРасходаТоплива;
		ПараметрыФормулы.ДействуетДо = ВыборкаДетальныеЗаписи.ДействуетДо;
		
	КонецЕсли;
	
	Возврат ПараметрыФормулы;
	
КонецФункции

