//
Функция ПолучитьПараметрТранспортногоСредства(СтруктураДанных) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	CW_ПараметрыТССрезПоследних.ТранспортноеСредство КАК ТранспортноеСредство,
	               |	CW_ПараметрыТССрезПоследних.ПараметрТранпортногоСредства КАК ПараметрТранпортногоСредства,
	               |	CW_ПараметрыТССрезПоследних.Значение КАК Значение
	               |ИЗ
	               |	РегистрСведений.CW_ПараметрыТС.СрезПоследних(
	               |			&ДатаСреза,
	               |			ТранспортноеСредство = &ТранспортноеСредство
	               |				И ПараметрТранпортногоСредства = &ПараметрТранпортногоСредства) КАК CW_ПараметрыТССрезПоследних";
	
	Запрос.УстановитьПараметр("ДатаСреза"						, СтруктураДанных.ДатаСреза);
	Запрос.УстановитьПараметр("ТранспортноеСредство"			, СтруктураДанных.ТранспортноеСредство);
	Запрос.УстановитьПараметр("ПараметрТранпортногоСредства"	, СтруктураДанных.ПараметрТранпортногоСредства);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Значение;
	КонецЕсли;
	
	Возврат Неопределено;
	
	
КонецФункции


