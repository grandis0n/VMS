Функция ПредставлениеДокументаРасчетовСоСпискомГрузоперевозок(док, флДетализироватьПоГрузоперевозкам, флДетализироватьПоЗаказам) Экспорт
	// для отчетов CW_ВзаиморасчетыСПокупателями CW_ВзаиморасчетыСПоставщиками
	
	тз = Новый ТаблицаЗначений;
	
	Если ТипЗнч(док)=Тип("ДокументСсылка.ПоступлениеТоваровУслуг") Тогда
		Если флДетализироватьПоГрузоперевозкам Тогда
			з = Новый Запрос(
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
				|	CW_РасходыПоГрузоперевозкеУслуги.Ссылка,
				|	CW_РасходыПоГрузоперевозкеУслуги.Грузоперевозка,
				|	CW_РасходыПоГрузоперевозкеУслуги.Ссылка.ПредставлениеДокумента КАК ПредставлениеДокумента
				|ИЗ
				|	Документ.CW_РасходыПоГрузоперевозке.Услуги КАК CW_РасходыПоГрузоперевозкеУслуги
				|ГДЕ
				|	CW_РасходыПоГрузоперевозкеУслуги.Ссылка.ВедомыйДокумент = &ВедомыйДокумент"
			);
			з.УстановитьПараметр("ВедомыйДокумент", док);
			тз = з.Выполнить().Выгрузить();
		ИначеЕсли флДетализироватьПоЗаказам Тогда
			з = Новый Запрос(
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
				|	CW_РасходыПоГрузоперевозкеУслуги.Ссылка,
				|	CW_РасходыПоГрузоперевозкеУслуги.Грузоперевозка.Заказ КАК Заказ,
				|	CW_РасходыПоГрузоперевозкеУслуги.Ссылка.ПредставлениеДокумента КАК ПредставлениеДокумента
				|ИЗ
				|	Документ.CW_РасходыПоГрузоперевозке.Услуги КАК CW_РасходыПоГрузоперевозкеУслуги
				|ГДЕ
				|	CW_РасходыПоГрузоперевозкеУслуги.Ссылка.ВедомыйДокумент = &ВедомыйДокумент
				|	И CW_РасходыПоГрузоперевозкеУслуги.Грузоперевозка.Заказ <> &Заказ"
			);
			з.УстановитьПараметр("ВедомыйДокумент", док);
			з.УстановитьПараметр("Заказ", Справочники.CW_Заказы.ПустаяСсылка());
			тз = з.Выполнить().Выгрузить();			
		КонецЕсли;	
	ИначеЕсли ТипЗнч(док)=Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
		Если флДетализироватьПоГрузоперевозкам Тогда
			з = Новый Запрос(
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
				|	CW_ДоходыПоГрузоперевозкеУслуги.Ссылка,
				|	CW_ДоходыПоГрузоперевозкеУслуги.Грузоперевозка,
				|	CW_ДоходыПоГрузоперевозкеУслуги.Ссылка.ПредставлениеДокумента КАК ПредставлениеДокумента
				|ИЗ
				|	Документ.CW_ДоходыПоГрузоперевозке.Услуги КАК CW_ДоходыПоГрузоперевозкеУслуги
				|ГДЕ
				|	CW_ДоходыПоГрузоперевозкеУслуги.Ссылка.ВедомыйДокумент = &ВедомыйДокумент"
			);
			з.УстановитьПараметр("ВедомыйДокумент", док);
			тз = з.Выполнить().Выгрузить();
		ИначеЕсли флДетализироватьПоЗаказам Тогда
			з = Новый Запрос(
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
				|	CW_ДоходыПоГрузоперевозкеУслуги.Ссылка,
				|	CW_ДоходыПоГрузоперевозкеУслуги.Грузоперевозка.Заказ КАК Заказ,
				|	CW_ДоходыПоГрузоперевозкеУслуги.Ссылка.ПредставлениеДокумента КАК ПредставлениеДокумента
				|ИЗ
				|	Документ.CW_ДоходыПоГрузоперевозке.Услуги КАК CW_ДоходыПоГрузоперевозкеУслуги
				|ГДЕ
				|	CW_ДоходыПоГрузоперевозкеУслуги.Ссылка.ВедомыйДокумент = &ВедомыйДокумент
				|	И CW_ДоходыПоГрузоперевозкеУслуги.Грузоперевозка.Заказ <> &Заказ"
			);
			з.УстановитьПараметр("ВедомыйДокумент", док);
