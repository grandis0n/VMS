Функция НайтиЭлементОтбораКомпоновкиДанных(ИмяОтбора, Отбор) Экспорт 
	
	Если 0=Отбор.Элементы.Количество() Тогда 
		Возврат Неопределено;
	КонецЕсли;
	
	Для ы=0 По Отбор.Элементы.Количество()-1 Цикл
		эл = Отбор.Элементы.Получить(ы);
		Если СокрЛП(эл.ЛевоеЗначение)=ИмяОтбора Тогда 
			Возврат эл;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

Функция ДобавитьОтборКомпоновкиДанных(ИмяОтбора, ВидСравненияОтбора, ПравоеЗначениеОтбора, ИспользованиеОтбора, Отбор) Экспорт 
	
	эл = НайтиЭлементОтбораКомпоновкиДанных(ИмяОтбора, Отбор);
	
	Если Неопределено = эл Тогда 
		эл = Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		эл.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ИмяОтбора);
	КонецЕсли;
	
	эл.ВидСравнения = ВидСравненияОтбора;
	эл.ПравоеЗначение = ПравоеЗначениеОтбора;
	эл.Использование  = ИспользованиеОтбора;
	
	Возврат эл;
	
КонецФункции

Функция УдалитьОтборКомпоновкиДанных(ИмяОтбора, Отбор) Экспорт 
	
	эл = НайтиЭлементОтбораКомпоновкиДанных(ИмяОтбора, Отбор);
	
	Если НЕ Неопределено = эл Тогда 
		Отбор.Элементы.Удалить(эл);
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

Функция ОтключитьВсеОтборыКомпоновкиДанных(Отбор) Экспорт 
	
	Для ы=0 По Отбор.Элементы.Количество()-1 Цикл
		эл = Отбор.Элементы.Получить(ы);
		эл.Использование = Ложь;
	КонецЦикла;

КонецФункции

Функция НайтиПараметрДанныхКомпоновкиДанных(ИмяПараметра, ПараметрыДанных)
	
	Если 0=ПараметрыДанных.Элементы.Количество() Тогда 
		Возврат Неопределено;
	КонецЕсли;

	Для ы=0 По ПараметрыДанных.Элементы.Количество()-1 Цикл
		эл = ПараметрыДанных.Элементы.Получить(ы);
		Если СокрЛП(ПараметрыДанных.Элементы[ы].Параметр)=ИмяПараметра Тогда 
			Возврат эл;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

Функция УстановитьЗначениеПараметраДанныхКомпоновкиДанных(ИмяПараметра, ЗначениеПараметра, ПараметрыДанных) Экспорт 
	
	эл = НайтиПараметрДанныхКомпоновкиДанных(ИмяПараметра, ПараметрыДанных);
	Если Неопределено=эл Тогда 
		эл = ПараметрыДанных.Элементы.Добавить();
		эл.Параметр = Новый ПараметрКомпоновкиДанных(ИмяПараметра);
	КонецЕсли;
	
	ПараметрыДанных.УстановитьЗначениеПараметра(ИмяПараметра, ЗначениеПараметра);
	
	Возврат эл;
	
КонецФункции

Функция НайтиЭлементГруппировкиКомпоновкиДанных(ИмяГруппировки, НастройкиСтруктура) Экспорт 
	
	Если 0=НастройкиСтруктура.Количество() Тогда 
		Возврат Неопределено;
	КонецЕсли;
	
	Для ы=0 По НастройкиСтруктура.Количество()-1 Цикл
		
		эл = НастройкиСтруктура.Получить(ы);
		
		флПолеНайдено = Ложь;
		Если ТипЗнч(эл) = Тип("ГруппировкаКомпоновкиДанных") Тогда 
			Для Каждого поле Из эл.ПоляГруппировки.Элементы Цикл
				Если СокрЛП(поле.Поле) = ИмяГруппировки Тогда 
					флПолеНайдено = Истина;
				Иначе 
					// ищем дальше
				КонецЕсли;
			КонецЦикла;
		Иначе 
			// желательно будет отработать и другие варианты
		КонецЕсли;
		
		Если флПолеНайдено Тогда 
			Возврат эл;
		Иначе 
			элИзПодчиненных = НайтиЭлементГруппировкиКомпоновкиДанных(ИмяГруппировки, эл.Структура);
			Если НЕ Неопределено=элИзПодчиненных Тогда 
				Возврат элИзПодчиненных;
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
	// прошлись по всем уровням, но ничего не нашли
	Возврат Неопределено;
	
КонецФункции

Функция НайтиПоследнийЭлементГруппировкиКомпоновкиДанных(НастройкиСтруктура) Экспорт 
	
	Если 0=НастройкиСтруктура.Количество() Тогда 
		// это последний элемент по вложенности
		Возврат НастройкиСтруктура;
	КонецЕсли;
	
	// есть подчиненные
	Для ы=0 По НастройкиСтруктура.Количество()-1 Цикл
		эл = НастройкиСтруктура.Получить(ы);
		элИзПодчиненных = НайтиПоследнийЭлементГруппировкиКомпоновкиДанных(эл.Структура);
		Возврат элИзПодчиненных;
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

Функция ДобавитьГруппировкуКомпоновкиДанных(ИмяГруппировки, НастройкиСтруктура) Экспорт 

	// вдруг уже есть?
	эл = НайтиЭлементГруппировкиКомпоновкиДанных(ИмяГруппировки, НастройкиСтруктура);
	
	Если Неопределено = эл Тогда 
		// еще нету, значит, добавляем
		элПоследний = НайтиПоследнийЭлементГруппировкиКомпоновкиДанных(НастройкиСтруктура);
		эл = элПоследний.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
		пг = эл.ПоляГруппировки.Элементы.Добавить(Тип("ПолеГруппировкиКомпоновкиДанных"));
		пг.Использование = Истина;
		пг.Поле = Новый ПолеКомпоновкиДанных(ИмяГруппировки);
		эл.Использование = Истина;
		эл.Порядок.Элементы.Добавить(Тип("АвтоЭлементПорядкаКомпоновкиДанных"));
		эл.Выбор.Элементы.Добавить(Тип("АвтоВыбранноеПолеКомпоновкиДанных"));
	КонецЕсли;
	
	// уже был или только что добавлен, включим
	эл.Состояние = СостояниеЭлементаНастройкиКомпоновкиДанных.Включен;
	
	Возврат эл;
	
КонецФункции

Процедура ПеренестиПодчиненныеЭлементыГруппировкиКомпоновкиДанных(элИсточник, элПриемник)

	Для Каждого элПодчиненный Из элИсточник.Структура Цикл
		Если ТипЗнч(элПодчиненный) = Тип("ГруппировкаКомпоновкиДанных") Тогда 
			элПереноса = элПриемник.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
			Для Каждого пгПодчиненного Из элПодчиненный.ПоляГруппировки.Элементы Цикл
				пг = элПереноса.ПоляГруппировки.Элементы.Добавить(Тип("ПолеГруппировкиКомпоновкиДанных"));
				пг.Использование = пгПодчиненного.Использование;
				пг.Поле = пгПодчиненного.Поле;
			КонецЦикла;
			элПереноса.Использование = элПодчиненный.Использование;
			элПереноса.Порядок.Элементы.Добавить(Тип("АвтоЭлементПорядкаКомпоновкиДанных"));
			элПереноса.Выбор.Элементы.Добавить(Тип("АвтоВыбранноеПолеКомпоновкиДанных"));
			ПеренестиПодчиненныеЭлементыГруппировкиКомпоновкиДанных(элПодчиненный, элПереноса);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция УдалитьГруппировкуКомпоновкиДанных(ИмяГруппировки, НастройкиСтруктура) Экспорт 
	
	эл = НайтиЭлементГруппировкиКомпоновкиДанных(ИмяГруппировки, НастройкиСтруктура);
	
	Если НЕ Неопределено = эл Тогда 
		ПеренестиПодчиненныеЭлементыГруппировкиКомпоновкиДанных(эл, эл.Родитель); // если удаляем из середины дерева
		эл.Родитель.Структура.Удалить(эл);
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

Функция УдалитьВсеГруппировкиКомпоновкиДанных(НастройкиСтруктура) Экспорт 
	
	Если 0=НастройкиСтруктура.Количество() Тогда 
		// это последний элемент по вложенности
		Возврат НастройкиСтруктура;
	КонецЕсли;
	
	// есть элементы
	Для ы=0 По НастройкиСтруктура.Количество()-1 Цикл
		НастройкиСтруктура.Удалить(ы);
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

// устанавливает в компоновщике видимость показателей согласно флажкам из сзПоказатели; те элементы, которых нет в списке - просто не трогает; возвращает Истина, если успешно отмечен хотя бы один из показателей
Функция ПрименитьНастройкуСоставаПоказателей(НастройкиВыбор, сзПоказатели) Экспорт 
	
	Если 0=НастройкиВыбор.Элементы.Количество() Тогда 
		Возврат Ложь;
	КонецЕсли;

	флОтмеченХотяБыОдинПоказатель = Ложь;
	Для Каждого элПоказатели Из сзПоказатели Цикл
		
		ИмяПараметра = элПоказатели.Значение;
		Для ы=0 По НастройкиВыбор.Элементы.Количество()-1 Цикл
			элВыбора = НастройкиВыбор.Элементы.Получить(ы);
			Если ТипЗнч(элВыбора) = Тип("ГруппаВыбранныхПолейКомпоновкиДанных") Тогда 
				// для групп
				флЧтоТоОтметилиВГруппе = ПрименитьНастройкуСоставаПоказателей(элВыбора, сзПоказатели);
				флОтмеченХотяБыОдинПоказатель = флОтмеченХотяБыОдинПоказатель ИЛИ флЧтоТоОтметилиВГруппе;
			Иначе 
				// для элементов
				Если Лев(элВыбора.Поле, СтрДлина(ИмяПараметра)) = ИмяПараметра Тогда 
					// Имя поля начинается с того, что мы ищем
					элВыбора.Использование = элПоказатели.Пометка;
					Если элПоказатели.Пометка Тогда 
						флОтмеченХотяБыОдинПоказатель = Истина;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат флОтмеченХотяБыОдинПоказатель;
	
КонецФункции

// поиск и замена текста в табличном документе, заодно возможность немного отформатировать найденную область
Функция ЗаменитьТекстВТаблицеРезультата(ТабДок, стрЧтоИщем, стрНаЧтоМеняем, НовоеГоризонтальноеПоложение=Неопределено, МаксНомерСтрокиПоиска=Неопределено) Экспорт 
	
	ПредНайденнаяОбласть = Неопределено;
	
	Если ЗначениеЗаполнено(МаксНомерСтрокиПоиска) Тогда 
		ГдеИскать = ТабДок.Область(1,,МаксНомерСтрокиПоиска,);
	Иначе 
		ГдеИскать = Неопределено;
	КонецЕсли;
	
	Пока Истина Цикл
	
		НайденнаяОбласть = ТабДок.НайтиТекст(стрЧтоИщем, ПредНайденнаяОбласть, ГдеИскать); 
		Если Неопределено=НайденнаяОбласть Тогда 
			Прервать;
		Иначе 
			ПредНайденнаяОбласть = НайденнаяОбласть;
		КонецЕсли;
		//Если ЗначениеЗаполнено(МаксНомерСтрокиПоиска) И (НайденнаяОбласть.Верх > МаксНомерСтрокиПоиска) Тогда 
		//	Прервать;
		//КонецЕсли;
			
		Если стрЧтоИщем<>стрНаЧтоМеняем Тогда 
			НайденнаяОбласть.Текст = СтрЗаменить(НайденнаяОбласть.Текст, стрЧтоИщем, стрНаЧтоМеняем);
		КонецЕсли;
			
		Если НЕ Неопределено=НовоеГоризонтальноеПоложение Тогда 
			НайденнаяОбласть.ГоризонтальноеПоложение = НовоеГоризонтальноеПоложение;
		КонецЕсли;
		
	КонецЦикла;
	
	//НайденнаяОбласть.Шрифт =Новый Шрифт(НайденнаяОбласть.Шрифт, , 10);

КонецФункции

Функция УжатьПоВысотеСтрокиПередИПослеЗаголовка(ТабДок) Экспорт

	ТабДок.Область(1, , 1, ).ВысотаСтроки = 1;
	ТабДок.Область(3, , 3, ).ВысотаСтроки = 1;
	ТабДок.ФиксацияСверху = ТабДок.ФиксацияСверху; // Маразм? Но иначе прокручиваемая область появится изначально уже слегка прокученной

КонецФункции

Функция ПредставлениеПустогоКонтрагента(Контрагент) Экспорт
	
	Если Не ЗначениеЗаполнено(Контрагент) Тогда
		Возврат "<Неопределен>";
	КонецЕсли;
	
	Возврат Контрагент;
	
КонецФункции

