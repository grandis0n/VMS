				Стр = "Счет №" + СокрЛП(НомерСчета) + " от " + Формат(Док.ДатаСчета, "ДЛФ=Д");
			КонецЕсли; 
			
		ИначеЕсли (ТипЗнч(док) = Тип("ДокументСсылка.CW_РасходыПоГрузоперевозке")) Тогда
			
			Если (док.ПредъявленСчет) Тогда
				Стр = "Счет №" + СокрЛП(Док.НомерСчета) + " от " + Формат(Док.ДатаСчета, "ДЛФ=Д");
				
			ИначеЕсли (док.ПредъявленАкт) Тогда
				
				Если (Стр <> "") Тогда
					Стр = Стр + "; ";
				КонецЕсли; 
				Стр = Стр + "Акт №" + СокрЛП(Док.НомерАкта) + " от " + Формат(Док.ДатаАкта, "ДЛФ=Д");
				
			КонецЕсли; 
			
		КонецЕсли; 
		
	ИначеЕсли док = Неопределено Тогда	
		Стр = "";
	Иначе	
		Стр = док.ПредставлениеДокумента;
	КонецЕсли;	
		
	Возврат Стр;
	
КонецФункции
Функция ПредставлениеДокументовПоступления(Док, ФормированиеОтчета) Экспорт
	// для отчетов CW_ВедомостьОперативныхВзаиморасчетовСПоставщиками 
	// Признак = 1 - представление счета
	// Признак = 2 - представление ссылки
	
	Стр = "";
	
	Если ТипЗнч(док) = Тип("ДокументСсылка.CW_ДоходыПоГрузоперевозке") ИЛИ ТипЗнч(док) = Тип("ДокументСсылка.CW_РасходыПоГрузоперевозке") Тогда
		
		Если (ТипЗнч(док) = Тип("ДокументСсылка.CW_ДоходыПоГрузоперевозке")) Тогда
			
			// по актам
			Если (ФормированиеОтчета=0) Тогда
				Стр = Док.ПредставлениеДокумента;
			Иначе
				НомерСчета = CW_Документы.ПолучитьНомерНаПечать(док, "НомерСчета", "ДатаСчета");
				Стр = "Счет №" + СокрЛП(НомерСчета) + " от " + Формат(Док.ДатаСчета, "ДЛФ=Д");
			КонецЕсли; 
			
		ИначеЕсли (ТипЗнч(док) = Тип("ДокументСсылка.CW_РасходыПоГрузоперевозке")) Тогда
			
			// по актам
			Если (ФормированиеОтчета=0) Тогда
				Стр = Док.ПредставлениеДокумента;
			Иначе
				Стр = "Счет №" + СокрЛП(Док.НомерСчета) + " от " + Формат(Док.ДатаСчета, "ДЛФ=Д");
			КонецЕсли; 
			
		КонецЕсли; 
		
	ИначеЕсли док = Неопределено Тогда	
		Стр = "";
	Иначе	
		Стр = док.Метаданные().Синоним + " №"+СокрЛП(Док.Номер)+" от "+Формат(Док.Дата, "ДЛФ=Д")//док.ПредставлениеДокумента;
	КонецЕсли;	
		
	Возврат Стр;
	
КонецФункции

// --- 
Функция СсылкаДляРасшифровкиПоДокументуРасчетов(док) Экспорт
	// для отчетов, чтобы по поступлению/реализации находить ведущий документ
	
	Если ТипЗнч(док)=Тип("ДокументСсылка.ПоступлениеТоваровУслуг") Тогда
		з = Новый Запрос(
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
			|	док.Ссылка
			|ИЗ
			|	Документ.CW_РасходыПоГрузоперевозке КАК док
			|ГДЕ
			|	док.ВедомыйДокумент = &ВедомыйДокумент"
		);
		з.УстановитьПараметр("ВедомыйДокумент", док);
		тз = з.Выполнить().Выгрузить();
		
	ИначеЕсли ТипЗнч(док)=Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
		з = Новый Запрос(
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
			|	док.Ссылка
			|ИЗ
			|	Документ.CW_ДоходыПоГрузоперевозке КАК док
			|ГДЕ
			|	док.ВедомыйДокумент = &ВедомыйДокумент"
		);
		з.УстановитьПараметр("ВедомыйДокумент", док);
		тз = з.Выполнить().Выгрузить();
		
	Иначе
		Возврат док;
		
	КонецЕсли;
	
	Если тз.Количество()=0 Тогда
		// не нашли ведущего документа или у него пуста таб.часть
		Возврат док;
	КонецЕсли;
	
	Возврат тз[0].Ссылка;
	
КонецФункции //

