//Процедура УстановитьПараметрыВыводаКомпоновкиДанных(НастройкиСКД, СтркутураПараметров)
//
// 	Устанавилвает параметры вывода СКД
//
// 	Парамеры:
// 		НастройкиСКД - Настройки компановки данных отчета;
//		СтркутураПараметров - "Структура" 
//				- Ключ 		- имя параметра;
//				- Значение 	- устанавилваемео значение параметра;
//
//		Если значение = Неопределено, то у параметра снимается флаг "Использование"
//
Процедура УстановитьПараметрыВыводаКомпоновкиДанных(НастройкиСКД, СтркутураПараметров) Экспорт
	
	Для Каждого ЭлементСтркутуры из СтркутураПараметров Цикл
		
		_Параметр = НастройкиСКД.ПараметрыВывода.Элементы.Найти(ЭлементСтркутуры.Ключ);
		
		Если _Параметр <> Неопределено Тогда
			_Параметр.Значение 			= ЭлементСтркутуры.Значение;
			_Параметр.Использование 	= ЭлементСтркутуры.Значение <> Неопределено;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

//Процедура УстановитьВыбранныеПоляКомпоновкиДанных(НастройкиСКД , мПоляОтчета)
//
// 	Добавляет в настройку СКД выводимые поля отчета
//
// 	Парамеры:
// 		НастройкиСКД 	- Настройки компановки данных отчета;
//      мПоляОтчета 	- "Массив"
//
Процедура УстановитьВыбранныеПоляКомпоновкиДанных(НастройкиСКД , мПоляОтчета) Экспорт
	
	Для каждого Поле Из мПоляОтчета Цикл
		
		ПолеВыбора = НастройкиСКД.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
		
		Если ПолеВыбора <> Неопределено Тогда
			ПолеВыбора.Поле		 		= Новый ПолеКомпоновкиДанных(Поле);
			ПолеВыбора.Использование 	= Истина;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

//Процедура УстановитьПоказателиКомпоновкиДанны(НастройкиСКД , Показатели)
//
// 	Добавляет в настройку СКД выводимые поля отчета
//
// 	Парамеры:
// 		НастройкиСКД - Настройки компановки данных отчета;
//      Показатели 		- "Список значений" с пометками
//
Процедура УстановитьПоказателиКомпоновкиДанных(НастройкиСКД, Показатели) Экспорт
	
	Для Каждого Показатель из Показатели Цикл
		ПолеВыбора = НастройкиСКД.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
		
		Если ПолеВыбора <> Неопределено Тогда
			ПолеВыбора.Поле 			= Новый ПолеКомпоновкиДанных(Показатель.Значение);
			ПолеВыбора.Использование 	= Показатель.Пометка;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

//Процедура УстановитьГруппировкиОтчетаКомпановкиДанных(НастройкиСКД_Структура, ПоляГруппировки, ПоГоризонтали=Ложь)
//
// 	Добавляет в настройку СКД группировки
//
// 	Парамеры:
// 		НастройкиСКД_Структура 	- Стркутура настрйоки СКД компановки данных отчета;
//      ПоляГруппировки 		- "Таблица значений"
//									колонки:
//									ИмяПоля 	- Имя поля группировки;
//									Сортировка 	- Направление сортировкидля поля;
//     ПоГоризонтали			- признак вывода группирвоко оттчет апо горизонтали, в отдельных колонках.
//									Значение по умолчанию  = ЛОЖЬ;
//
Процедура УстановитьГруппировкиОтчетаКомпановкиДанных(НастройкиСКД_Структура, ПоляГруппировки, ПоГоризонтали=Ложь) Экспорт
	
	Если ПоГоризонтали Тогда   
		//Добавляем пустую группировку
		НоваяГруппировка = ДобавитьГруппировкуКомпоновкиДанных("", НастройкиСКД_Структура);
	КонецЕсли;
	
	Для Каждого Группировка Из ПоляГруппировки Цикл

		Если Не ПоГоризонтали Тогда
		//	//Добавляем каждую последующую группировку
		//	ПозицияПервойТочки = СтрНайти(Группировка.ИмяПоля,".");
		//	ИмяПоляГруппировки = ?(ПозицияПервойТочки = 0, Группировка.ИмяПоля,Сред(Группировка.ИмяПоля,ПозицияПервойТочки+1));
		//	
			НоваяГруппировка = ДобавитьГруппировкуКомпоновкиДанных(Группировка.ИмяПоля, НастройкиСКД_Структура);
		Иначе
			//Заполняем группировку полями группирвоки
			ПолеГруппировки 				= НоваяГруппировка.ПоляГруппировки.Элементы.Добавить(Тип("ПолеГруппировкиКомпоновкиДанных"));
			ПолеГруппировки.Поле 			= Новый ПолеКомпоновкиДанных(Группировка.ИмяПоля);
			ПолеГруппировки.Использование 	= Истина;
			
			НовоеАвтоПолеВыбора = НоваяГруппировка.Выбор.Элементы.Добавить(Тип("АвтоВыбранноеПолеКомпоновкиДанных"));
			НовоеАвтоПолеВыбора.Использование	= Истина;
			
			ЭлементПорядка = НоваяГруппировка.Порядок.Элементы.Добавить(Тип("ЭлементПорядкаКомпоновкиДанных"));
			ЭлементПорядка.Поле = Новый ПолеКомпоновкиДанных(Группировка.ИмяПоля);
			
			НС = ?(Группировка.Сортировка = Перечисления.CW_НаправлениеСортировки.ПоВозрастанию, НаправлениеСортировкиКомпоновкиДанных.Возр, НаправлениеСортировкиКомпоновкиДанных.Убыв);
			
			ЭлементПорядка.ТипУпорядочивания = НС;
			ЭлементПорядка.Использование = Истина;

		КонецЕсли;
		
	КонецЦикла; 
	
КонецПроцедуры

Процедура ПриЗагрузкеПользовательскихНастроекНаСервере(ФормаОтчета, ПользовательскиеНастройки) Экспорт
	
	ДополнительныеСвойства = ПользовательскиеНастройки.ДополнительныеСвойства;
	
	Для Каждого ЭлементСтруктуры Из ДополнительныеСвойства Цикл
		
		Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ФормаОтчета, ЭлементСтруктуры.Ключ) Тогда
			Если ТипЗнч(ЭлементСтруктуры.Значение) = Тип("ТаблицаЗначений") 
				и ЭлементСтруктуры.Значение.Количество() > 0 Тогда 
				ФормаОтчета[ЭлементСтруктуры.Ключ].Загрузить(ЭлементСтруктуры.Значение); 
			ИначеЕсли ТипЗнч(ЭлементСтруктуры.Значение) = Тип("ДанныеФормыКоллекция")  
				и ЭлементСтруктуры.Значение.Количество() > 0 Тогда 
				ФормаОтчета[ЭлементСтруктуры.Ключ].Загрузить(ЭлементСтруктуры.Значение.Выгрузить()); 
			Иначе
				Если ЗначениеЗаполнено(ЭлементСтруктуры.Значение) Тогда
					ФормаОтчета[ЭлементСтруктуры.Ключ] = ЭлементСтруктуры.Значение;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
	Если  ДополнительныеСвойства.Свойство("Отбор") Тогда
		Если  ДополнительныеСвойства.Свойство("ИмяКомпоновщика") Тогда
			ОсновнойКомпоновщикНаФорме = ФормаОтчета[ДополнительныеСвойства.ИмяКомпоновщика];
			ОсновнойКомпоновщикНаФорме.ЗагрузитьНастройки(ДополнительныеСвойства.Отбор);
		Иначе
			ФормаОтчета.Отчет.КомпоновщикНастроек.ЗагрузитьНастройки(ДополнительныеСвойства.Отбор);
		КонецЕсли;
	КонецЕсли;
	
	Если  ДополнительныеСвойства.Свойство("ИсточникКопирования") Тогда
		
		ИсточникКопирования =	ДополнительныеСвойства.ИсточникКопирования;   
		Если  ДополнительныеСвойства.Свойство("ИмяКомпоновщикаКопирования") Тогда
			КомпоновщикНаФорме = ФормаОтчета[ДополнительныеСвойства.ИмяКомпоновщикаКопирования];
			
			_УФС.СкопироватьОтбор(ИсточникКопирования.Отбор,КомпоновщикНаФорме.Настройки.Отбор);
		КонецЕсли;
		
	КонецЕсли;
	
	
КонецПроцедуры


Процедура СкопироватьОтбор(ОтборИсточник, ОтборПриемник, ИмяПоляОбъекта=Неопределено) Экспорт

	Для Каждого ЭлементОтбора из ОтборИсточник.Элементы Цикл   
		
		Если ТипЗнч(ЭлементОтбора) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") Тогда    
			ГруппаОтбора = ОтборПриемник.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));  
			ГруппаОтбора.ТипГруппы =  ЭлементОтбора.ТипГруппы;
			
			СкопироватьОтбор(ЭлементОтбора, ГруппаОтбора, ИмяПоляОбъекта);  
			Продолжить;
		КонецЕсли;
		
		ИмяПоля = СокрЛП(ЭлементОтбора.ЛевоеЗначение);
		Если ЗначениеЗаполнено(ИмяПоляОбъекта) Тогда
			Если СтрНачинаетсяС(ИмяПоля, "Ссылка.") Тогда
				ИмяПоля = Сред(СокрЛП(ЭлементОтбора.ЛевоеЗначение), 8);
				ИмяПоля = ИмяПоляОбъекта +"."+ИмяПоля;
			ИначеЕсли ИмяПоля = "Ссылка" Тогда
				ИмяПоля =  ИмяПоляОбъекта; 
			Иначе
				ИмяПоля =  ИмяПоляОбъекта+"."+ИмяПоля;
			КонецЕсли;  
		КонеЦесли;
	
		НовыйЭлементОтбора = ОтборПриемник.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		НовыйЭлементОтбора.ЛевоеЗначение 	= Новый ПолеКомпоновкиДанных(ИмяПоля);
		НовыйЭлементОтбора.ВидСравнения 	= ЭлементОтбора.ВидСравнения;
		НовыйЭлементОтбора.ПравоеЗначение 	= ЭлементОтбора.ПравоеЗначение; 
		НовыйЭлементОтбора.Использование 	= Истина; 
		НовыйЭлементОтбора.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;  
		
	КонецЦикла;
	
КонецПроцедуры

