Функция НоваяСтруктураНастроекПечати() Экспорт
	
	Параметры = Новый Структура;
	Параметры.Вставить("ПодключаемыйОбъект", 	Неопределено);
	Параметры.Вставить("ШаблонПредставления", 	"");
	Параметры.Вставить("ДляРассылки", 			Ложь);
	Параметры.Вставить("ПодписьИПечать",		Ложь);
	Параметры.Вставить("Настройки", 			Неопределено); 
	
	Возврат Параметры;

КонецФункции

//Обработчики После Записи
Функция ПолучитьОбработчикиПослеЗаписи(ТипОбъекта) Экспорт 
	
	Результат				= Новый Массив;
	ИдентификаторОбъекта	= ОбщегоНазначения.ИдентификаторОбъектаМетаданных(ТипОбъекта);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	CW_ПодключаемыеОбъектыНазначениеОбъекта.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.CW_ПодключаемыеОбъекты.НазначениеОбъекта КАК CW_ПодключаемыеОбъектыНазначениеОбъекта
	               |ГДЕ
	               |	CW_ПодключаемыеОбъектыНазначениеОбъекта.Назначение = &ИдентификаторОбъекта
	               |	И CW_ПодключаемыеОбъектыНазначениеОбъекта.Ссылка.ПометкаУдаления = ЛОЖЬ
	               |	И CW_ПодключаемыеОбъектыНазначениеОбъекта.Ссылка.НеИспользуется = ЛОЖЬ
	               |	И CW_ПодключаемыеОбъектыНазначениеОбъекта.Ссылка.Вид = ""ОбработчикПослеЗаписи""
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	CW_ПодключаемыеОбъектыНазначениеОбъекта.Ссылка.Индекс";
	
	Запрос.УстановитьПараметр("ИдентификаторОбъекта", ИдентификаторОбъекта);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Добавить(Выборка.Ссылка);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьПараметрыВнешнегоОбработчика(ВнешнийОбъект) Экспорт
	
	Ответ = Новый Структура;
	
	Если ВнешнийОбъект.МетодыОбъекта.Количество() > 0 Тогда
		//всегда один метод!!!
		ИмяМетода =  ВнешнийОбъект.МетодыОбъекта[0].Метод;
		Ответ.Вставить("Метод", ИмяМетода);
	КонецЕсли;
	
	ИмяФормы =  "";
	Если _ПО.ПодключитьОбработку(ВнешнийОбъект) Тогда	
		ИмяФормы = _ПО.ПолучитьПолноеИмяФормыПоТипу(ВнешнийОбъект, "Форма");
	КонецЕсли;
	Ответ.Вставить("ИмяФормы", ИмяФормы);
		
	Возврат Ответ;

КонецФункции
//Обработчики перед записью

// Опиание подключаемых обработок
Функция СведенияОПодключаемомОбъекте(ВерсияПодсистемы = "") Экспорт
	
	СтруктураОписания = Новый Структура;
	
	СтруктураОписания.Вставить("Тип",						"");
	СтруктураОписания.Вставить("Вид",						"");
	СтруктураОписания.Вставить("Наименование",				"");
	СтруктураОписания.Вставить("Описание",					"");
	СтруктураОписания.Вставить("Поставщик",					"CoralWay");
	СтруктураОписания.Вставить("Версия",					"0.0.0.0");
	СтруктураОписания.Вставить("ВерсияПодсистемы",			?(ВерсияПодсистемы = "", "0.0.0.0", ВерсияПодсистемы));
	СтруктураОписания.Вставить("МинимальнаяВерсияМодуля",	"");
	
	СтруктураОписания.Вставить("Индекс",					0);
	
	СтруктураОписания.Вставить("ВыполнятьВФоне",			Ложь);
	
	СтруктураОписания.Вставить("РасполагатьНаРабочемСтоле",	Ложь);
	СтруктураОписания.Вставить("Настройка", 				Ложь);
	СтруктураОписания.Вставить("НастройкаСубъекта", 		Ложь);
	СтруктураОписания.Вставить("ИсторияИзменений", 			Ложь);
	
	СтруктураОписания.Вставить("НазначениеОбъекта", 		Новый Массив);
 	СтруктураОписания.Вставить("МетодыОбъекта", 			Новый Массив);
	СтруктураОписания.Вставить("Формы", 					Новый Массив);
	СтруктураОписания.Вставить("КомандыОбъекта", 			Новый Массив);
	СтруктураОписания.Вставить("ПараметрыВнешнейКоманды", 	Новый Массив);   
	СтруктураОписания.Вставить("ИмяВидаПодписки", 			"");   
	
	ТаблицаМакросов = ПолучитьНовуюТаблицуМакросов();
	СтруктураОписания.Вставить("ТаблицаМакросов", 			ТаблицаМакросов);
	
	Возврат СтруктураОписания;

КонецФункции

