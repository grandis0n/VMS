Процедура ПриСозданииНаСервере(ФормаОбъекта) Экспорт
	
	ИмяОбъектаМетаданных 	= CW_Обмены_ПИ.ПолучитьИмяМетаданногоПоИмениФормы(ФормаОбъекта.ИмяФормы);	
	СсылкаНаМетаданное  	= CW_Обмены_ПИ.МетаданноеКонфигурации(ИмяОбъектаМетаданных);
	ГруппаПользователя  	= CW_ПраваДоступа_ПИ.ГруппаПользователя(ПараметрыСеанса.ТекущийПользователь);
	ИмяФормыОбъкта			= CW_Обмены_ПИ.ПолучитьИмяФормыПоПолномуИмениФормы(ФормаОбъекта.ИмяФормы);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	CW_ВнешниеКоманды.Обработка КАК Обработка,
	               |	CW_ВнешниеКоманды.Метаданное КАК Метаданное,
	               |	CW_ВнешниеКоманды.ИмяТабличнойЧасти КАК ИмяТабличнойЧасти,
	               |	CW_ВнешниеКоманды.ИмяФормыОбъкта КАК ИмяФормыОбъкта,
	               |	CW_ВнешниеКоманды.Наименование КАК Наименование,
	               |	CW_ВнешниеКоманды.ИмяКоманды КАК ИмяКоманды,
	               |	CW_ВнешниеКоманды.ИмяКартинки КАК ИмяКартинки,
	               |	CW_ВнешниеКоманды.ГруппыДоступа КАК ГруппыДоступа,
	               |	CW_ВнешниеКоманды.Индекс КАК Индекс,
	               |	CW_ВнешниеКоманды.РасположениеГруппы КАК РасположениеГруппы,
	               |	CW_ВнешниеКоманды.ПередЭлементом КАК ПередЭлементом
	               |ИЗ
	               |	РегистрСведений.CW_ВнешниеКоманды КАК CW_ВнешниеКоманды
	               |ГДЕ
	               |	CW_ВнешниеКоманды.Метаданное = &Метаданное
	               |	И CW_ВнешниеКоманды.ИмяФормыОбъкта = &ИмяФормыОбъкта
	               |	И CW_ВнешниеКоманды.Обработка.ПометкаУдаления = ЛОЖЬ
	               |	И CW_ВнешниеКоманды.Обработка.НеИспользуется = ЛОЖЬ
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Индекс
	               |АВТОУПОРЯДОЧИВАНИЕ";

	
	Запрос.УстановитьПараметр("Метаданное"		, СсылкаНаМетаданное); 
	Запрос.УстановитьПараметр("ИмяФормыОбъкта"	, ИмяФормыОбъкта); 
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если Не РезультатЗапроса.Пустой() Тогда
		
		Выборка = РезультатЗапроса.Выбрать();
		
		Префикс =  1;
		Пока Выборка.Следующий() Цикл
			
			МассивГрупп = Выборка.ГруппыДоступа.Получить();
			
			Если МассивГрупп <> Неопределено тогда
				
				Если МассивГрупп.Найти(ГруппаПользователя) <> Неопределено Тогда
					
					СоздатьКомандуФормы(Формаобъекта, Выборка.ИмяКоманды);
					
					УИДОбъекта = Выборка.Обработка.УникальныйИдентификатор();
					ИмяКоманды = ПолучитьИмяКомандыВнешнего(УИДОбъекта, Префикс);
					
					ПрефиксЭлемента 	= ?(ЗначениеЗаполнено(Выборка.ИмяТабличнойЧасти), Выборка.ИмяТабличнойЧасти,"Форма");
					ИмяЭлементаГруппы 	= ПрефиксЭлемента + "ВнешниеКоманды";
					
					ПараметрыКнопки = новый Структура;
					ПараметрыКнопки.Вставить("Имя"					, ИмяКоманды);
					ПараметрыКнопки.Вставить("ИмяКоманды"			, Выборка.ИмяКоманды);
					ПараметрыКнопки.Вставить("ИмяКартинки"			, Выборка.ИмяКартинки);
					ПараметрыКнопки.Вставить("Заголовок"			, Выборка.Наименование);
					ПараметрыКнопки.Вставить("ИмяТабличнойЧасти"	, Выборка.ИмяТабличнойЧасти);
					ПараметрыКнопки.Вставить("ИмяЭлементаГруппы"	, ИмяЭлементаГруппы);
					ПараметрыКнопки.Вставить("ИмяФормыОбъкта"		, Выборка.ИмяФормыОбъкта);
					ПараметрыКнопки.Вставить("РасположениеГруппы"	, Выборка.РасположениеГруппы);
					ПараметрыКнопки.Вставить("ПередЭлементом"		, Выборка.ПередЭлементом);
					
					ДобавитьКнопкуНаФорму(Формаобъекта, ПараметрыКнопки);
					
					Префикс = Префикс + 1;
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
	Конецесли;
	
КонецПроцедуры

Функция ПолучитьИмяКомандыВнешнего(УИДОбъекта, Префикс)
	
	стрУИД = СтрЗаменить(УИДОбъекта,"-","_");
	Возврат	"_"+Формат(Префикс,"ЧГ=0")+"_УИД_"+стрУИД;  
	
КонецФункции

Процедура СоздатьКомандуФормы(Формаобъекта, ИмяКоманды)
	
	Если Формаобъекта.Команды.Найти(ИмяКоманды) = Неопределено Тогда
		
		// создадим команду
		НоваяКоманда = Формаобъекта.Команды.Добавить(ИмяКоманды); 			// Имя нашей команды
		НоваяКоманда.Заголовок  = "Выполнить внешнюю команду"; 			// заголовок
		НоваяКоманда.Действие   = "ВнешняяКоманда_ВыполнитьКоманду"; 	// Имя функции/процедуры	
		
	КонецЕсли;

КонецПроцедуры

Процедура ДобавитьКнопкуНаФорму(Формаобъекта, ПараметрыКнопки)
	
	РасположениеКоманды = Формаобъекта.Элементы.Найти(ПараметрыКнопки.ИмяЭлементаГруппы);
	
	Если РасположениеКоманды = Неопределено Тогда
		
		РасположениеГруппы 	= Неопределено;
		ПередЭлементом 		= Неопределено;
	
		Если ЗначениеЗаполнено(ПараметрыКнопки.РасположениеГруппы) Тогда
			РасположениеГруппы = Формаобъекта.Элементы[ПараметрыКнопки.РасположениеГруппы];
		КонецЕсли;
		
		Если РасположениеГруппы  = Неопределено Тогда
			Если  ЗначениеЗаполнено(ПараметрыКнопки.ИмяТабличнойЧасти) Тогда
				ТаблицаФормы = Формаобъекта.Элементы[ПараметрыКнопки.ИмяТабличнойЧасти];
				Если ТаблицаФормы.ПоложениеКоманднойПанели <> ПоложениеКоманднойПанелиЭлементаФормы.Нет Тогда
					РасположениеГруппы = Формаобъекта.Элементы[ПараметрыКнопки.ИмяТабличнойЧасти].КоманднаяПанель;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		//Для формы объекта
		Если ЗначениеЗаполнено(ПараметрыКнопки.ПередЭлементом) Тогда
			ПередЭлементом = Формаобъекта.Элементы[ПараметрыКнопки.ПередЭлементом];
		КонецЕсли;
		
		мДанныеФормы 	= СтрРазделить(Формаобъекта.ИмяФормы,".",Ложь);
		ИмяФормыОбъекта = мДанныеФормы[1];
		Если СтрНайти("CW_ЖурналГрузоперевозок,CW_ЖурналЗаявок,CW_ЖурналЗаказов,CW_ЖурналПланированияДДС", ИмяФормыОбъекта) > 0 Тогда
			Если РасположениеГруппы = Неопределено Тогда 
				РасположениеГруппы  = Формаобъекта.Элементы.Найти("ГруппаКоманднаяПанель");
			КонецЕсли;
			Если ПередЭлементом = Неопределено Тогда
				ПередЭлементом 	= РасположениеГруппы.ПодчиненныеЭлементы.Найти("ЖурналГруппа1");
			КонецЕсли;
		КонецЕсли;

		Если РасположениеГруппы  = Неопределено Тогда
			РасположениеГруппы = Формаобъекта.КоманднаяПанель;
		КонецЕсли;
	
		Если ПередЭлементом = Неопределено Тогда
			ПередЭлементом = РасположениеГруппы.ПодчиненныеЭлементы.Найти("ФормаЗакрыть");	
		КонецЕсли;
		
		Если ПередЭлементом = Неопределено Тогда
			//Форма списка документов
			ПередЭлементом 		= РасположениеГруппы.ПодчиненныеЭлементы.Найти("ФормаОбновить");
		КонецЕсли;
		
		РасположениеКоманды = Формаобъекта.Элементы.Вставить(ПараметрыКнопки.ИмяЭлементаГруппы 	,  	// Первый параметр - имя кнопки
		Тип("ГруппаФормы"),  					// Второй параметр 		- тип элемента управления
		РасположениеГруппы,                     // Третий параметр 		- место расположения на форме
		ПередЭлементом                          // Четвертый параметр 	- Элемент перед которым нужно вставить группу
		);	                     
		
		РасположениеКоманды.Вид = ВидГруппыФормы.Подменю;
		
		Если РасположениеКоманды <> Неопределено Тогда 
			РасположениеКоманды.Картинка	= БиблиотекаКартинок.CW_Расширение;
		КонецЕсли; 
		
		РасположениеКоманды.Заголовок	= "Дополнительно";
		
	КонецЕсли;
	
	//Ссмылки на форме
	НайденныйЭлемент =  Формаобъекта.Элементы.Найти(ПараметрыКнопки.Имя);
	
	Если НайденныйЭлемент <> Неопределено Тогда
		Формаобъекта.Элементы.Удалить(НайденныйЭлемент);
	КонецЕсли;
	
	// создадим кнопку
	НовыйЭлемент        = Формаобъекта.Элементы.Добавить(ПараметрыКнопки.Имя 	,  	// Первый параметр - имя кнопки
											Тип("КнопкаФормы")		,  	// Второй параметр - тип элемента управления
											РасположениеКоманды)	;	// Третий параметр - место расположения на форме
	
	НовыйЭлемент.Вид    		= ВидКнопкиФормы.КнопкаКоманднойПанели; // вид кнопки
	НовыйЭлемент.Заголовок  	= ПараметрыКнопки.Заголовок;
	НовыйЭлемент.ИмяКоманды 	= ПараметрыКнопки.ИмяКоманды;
	НовыйЭлемент.Картинка 		= ?(ЗначениеЗаполнено(ПараметрыКнопки.ИмяКартинки), БиблиотекаКартинок[ПараметрыКнопки.ИмяКартинки], БиблиотекаКартинок.ЗеленыйШар);
	
КонецПроцедуры

Функция ПолучитьПараметрыВнешнейКоманды(ПараметрыВнешнейКоманды)  Экспорт
	
	Ответ = Новый Структура("ПодключаемыйОбъект, ИмяМетода, ИмяФормы", Неопределено, "","");
	
	ИмяОбъектаМетаданных 	= CW_Обмены_ПИ.ПолучитьИмяМетаданногоПоИмениФормы(ПараметрыВнешнейКоманды.ИмяФормыОбъекта);	
	СсылкаНаМетаданное  	= CW_Обмены_ПИ.МетаданноеКонфигурации(ИмяОбъектаМетаданных);

	Запрос = Новый Запрос;
	запрос.Текст = "ВЫБРАТЬ
	               |	CW_ВнешниеКоманды.Обработка КАК ПодключаемыйОбработчик
	               |ИЗ
	               |	РегистрСведений.CW_ВнешниеКоманды КАК CW_ВнешниеКоманды
	               |ГДЕ
	               |	CW_ВнешниеКоманды.ИмяКоманды 	= &ИдентификаторКоманды
	               |	И CW_ВнешниеКоманды.Метаданное 	= &СсылкаНаМетаданное";
	
	Запрос.УстановитьПараметр("ИдентификаторКоманды", ПараметрыВнешнейКоманды.ИдентификаторКоманды);
	Запрос.УстановитьПараметр("СсылкаНаМетаданное"	, СсылкаНаМетаданное);
	
	РезультатЗапроса = запрос.Выполнить();
	
	Если Не РезультатЗапроса.Пустой() Тогда
		
		//Должна быть только одна команда с таким идентифкатором
		Выборка = РезультатЗапроса.Выбрать();
		Если Выборка.Следующий() Тогда
			
			Ответ.ПодключаемыйОбъект 	=  Выборка.ПодключаемыйОбработчик;
			
			Если   Выборка.ПодключаемыйОбработчик.МетодыОбъекта.Количество() > 0 Тогда
				//всегда один метод!!!
				Ответ.ИмяМетода =  Выборка.ПодключаемыйОбработчик.МетодыОбъекта[0].Метод;
			КонецЕсли;
			
			Если _ПО.ПодключитьОбработку( Выборка.ПодключаемыйОбработчик) Тогда	
				Ответ.ИмяФормы = _ПО.ПолучитьПолноеИмяФормыПоТипу( Выборка.ПодключаемыйОбработчик,"Форма");
			КонецЕсли;
			
		КонецЕсли;
		
		Возврат Ответ;
		
	КонецЕсли;
	
	Возврат Неопределено;

КонецФункции

