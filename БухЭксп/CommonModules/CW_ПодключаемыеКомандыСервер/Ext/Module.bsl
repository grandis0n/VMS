// Процедура - Установить методы внешней команды
// Параметры:
//  СтруктураОписания	 - 	 структура, в которую будет добавлено опиание параметров внешней команды
//  ИмяМетода			 - 	 имя добавляемого метода, доступные имена: ОткрытьФорму  ВыполнитьВнешнююКомандуНаКлиенте 
//
Процедура УстановитьМетодыВнешнегоОбъекта(СтруктураОписания, ИмяМетода) Экспорт
	
	мМетоды = Новый Массив;
	
	Если СтруктураОписания.Свойство("Методы") Тогда
		мМетоды = СтруктураОписания.Методы;
	КонецЕсли;
	
	Если мМетоды.Найти(ИмяМетода) = Неопределено Тогда
		мМетоды.Добавить(ИмяМетода);
	КонецЕсли;
	
	СтруктураОписания.Вставить("Методы", мМетоды);
	
КонецПроцедуры

//Процедура - Установить описание форм команды
//
//	СОздает описание форм обраблотки 
//
// Параметры:
//  СтруктураОписания	 - 	 структура, в которую будет добавлено опиание параметров внешней команды
//  ТипФормы			 - 	 тип формы: ФормаОбъекта, ФормаНастроек 
//  Имяформы			 - 	 Имя формы обработки, как оно задано в конфигураторе
//
Процедура УстановитьФормыВнешнегоОбъекта(СтруктураОписания, ТипФормы, Имяформы) Экспорт
	
	МассивФорм = Новый Массив;
	Если СтруктураОписания.Свойство("Формы") Тогда
		МассивФорм = СтруктураОписания.Формы;
	КонецЕсли;

	//Формируем структуру форм комнады
	СтруктураФормКоманды = новый Структура;
	СтруктураФормКоманды.Вставить("Тип"			, 	ТипФормы);
	СтруктураФормКоманды.Вставить("Имя"			, 	Имяформы);
	
	МассивФорм.Добавить(СтруктураФормКоманды);
	
	СтруктураОписания.Вставить("Формы"			,	МассивФорм);

КонецПроцедуры

Процедура УстановитьИмяФормыОбъекта(СтруктураОписания, ИмяФормы) Экспорт
	
	МассивФорм = Новый Массив;
	Если СтруктураОписания.Свойство("Формы") Тогда
		МассивФорм = СтруктураОписания.Формы;
	КонецЕсли;

	//Формируем структуру форм комнады
	СтруктураФормКоманды = новый Структура;
	СтруктураФормКоманды.Вставить("Тип", "ФормаОбъекта");
	СтруктураФормКоманды.Вставить("Имя", Имяформы);
	
	МассивФорм.Добавить(СтруктураФормКоманды);
	
	СтруктураОписания.Вставить("Формы",		МассивФорм);

КонецПроцедуры

