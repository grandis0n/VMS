Процедура УстановитьОписаниеВнешнегоМакроса(СтруктураОписания, ИмяМакроса, ПредставлениеМакроса, МетодМакроса) Экспорт
	
	Если СтруктураОписания.Свойство("ТаблицаМакросов") Тогда
		ТаблицаМакросов = СтруктураОписания.ТаблицаМакросов;  
	Иначе
		ТаблицаМакросов = ПустаяТаблицаМакросов();
	КонецЕсли;    
	
	СтрокаМакроса = ТаблицаМакросов.Добавить();
	СтрокаМакроса.ИмяМакроса 			= ИмяМакроса;
	СтрокаМакроса.ПредставлениеМакроса 	= ПредставлениеМакроса;
	СтрокаМакроса.МетодМакроса 			= МетодМакроса;
	
КонецПроцедуры

Функция ПустаяТаблицаМакросов()
	
	ТаблицаМакросов = Новый ТаблицаЗначений;
	ТаблицаМакросов.Колонки.Добавить("ИмяМакроса", 				Новый ОписаниеТипов("Строка"));
	ТаблицаМакросов.Колонки.Добавить("ПредставлениеМакроса", 	Новый ОписаниеТипов("Строка"));
	ТаблицаМакросов.Колонки.Добавить("МетодМакроса", 			Новый ОписаниеТипов("Строка"));
	
	Возврат ТаблицаМакросов;
	
КонецФункции

Процедура УстановитьМакросыШаблонаПредставленияОбъекта(СтруктураОписания, ИмяМакроса, ПредставлениеМакроса, МетодМакроса) Экспорт
	
	Если СтруктураОписания.Свойство("ТаблицаМакросов") Тогда
		ТаблицаМакросов = СтруктураОписания.ТаблицаМакросов;
	Иначе
		ТаблицаМакросов = ПолучитьНовуюТаблицуМакросов();
	КонецЕсли;

	НоваяСтрока = ТаблицаМакросов.Добавить();
	НоваяСтрока.ИмяМакроса 				= ИмяМакроса;
	НоваяСтрока.ПредставлениеМакроса 	= ПредставлениеМакроса;
	НоваяСтрока.МетодМакроса 			= МетодМакроса;
	
	СтруктураОписания.Вставить("ТаблицаМакросов", ТаблицаМакросов);

КонецПроцедуры


// Процедура - Установить параметры внешей команды
//
// СОздает описание команды 
//
// Параметры:
//  СтруктураОписания	 - 	 структура, в которую будет добавлено опиание параметров внешней команды
//  ИмяМетаданных		 - 	 имя объекта метаданных, для которго добавляется команда 
//  ИмяФормыОбъкта		 - 	 имя формы объекта
//  ИмяТабличнойЧасти	 - 	 имя табличной части 
//  Расположение		 - 	 группа на форме 
//  ПередЭлементом		 - 	 элементы формы, перед которым должна быть помещена команда 
//  ПредставлениеКоманды - 	 представление команды 
//
Процедура УстановитьПараметрыВнешнейКоманды(СтруктураОписания, ИмяМетаданного, ИмяФормыОбъкта, ИмяТабличнойЧасти="", Расположение="", ПередЭлементом="",ПредставлениеКоманды) Экспорт
	
	МассивПараметровВнешнейКоманды = Новый Массив;
	Если СтруктураОписания.Свойство("ПараметрыВнешнейКоманды") Тогда
		МассивПараметровВнешнейКоманды = СтруктураОписания.ПараметрыВнешнейКоманды;
	КонецЕсли;
	
	СтруктураВнешнейКоманды = Новый Структура;
	СтруктураВнешнейКоманды.Вставить("ПредставлениеКоманды"		, 	ПредставлениеКоманды);
	СтруктураВнешнейКоманды.Вставить("МетаданныеКонфигурации"	, 	ИмяМетаданного);
	СтруктураВнешнейКоманды.Вставить("ИмяФормыОбъкта"			, 	ИмяФормыОбъкта);
	
	//Расположение группы дополнительных внешних команд, 
	//в случае, если не указано свойство "РасположениеГруппы", то группа внешних команд будет расположена в группе "КоманднаяПанель"
	СтруктураВнешнейКоманды.Вставить("РасположениеГруппы"		, 	Расположение);  //Тип "ГруппаФормы"
	
	//Указывается имя элемента (группы) преред которым будет расположена группа дополнительных команд, 
	//по умолчанию пред группами: ФормаЗакрыть - для справочников, ФормаОбновить - для документов и ЖурналГруппа1 - для журналов
	//в случае если указана "РасположениеГруппы" и не указано "ПередЭлементом", группа "ДополнительныеКоманды" будет размещена в конце группы "РасположениеГруппы"
	СтруктураВнешнейКоманды.Вставить("ПередЭлементом"			, 	ПередЭлементом);  //Тип "ГруппаФормы"
	
	//если указаны совойста "РасположениеГруппы" и "ПередЭлементом", заполнение свояства "ИмяТабличнойЧасти" необязатлеьно
	СтруктураВнешнейКоманды.Вставить("ИмяТабличнойЧасти"		, 	ИмяТабличнойЧасти);
	
	МассивПараметровВнешнейКоманды.Добавить(СтруктураВнешнейКоманды);
	
	СтруктураОписания.Вставить("ПараметрыВнешнейКоманды" ,	МассивПараметровВнешнейКоманды);

КонецПроцедуры

Процедура УстановитьКомандыВнешнегоОбъекта(СтруктураОписания, ИмяКоманды, ПредставлениеКоманды, ИмяКартинки=Неопределено,ОсновнаяКоманда=Ложь) Экспорт
	
	МассивОписанийКоманд = Новый Массив;
	Если СтруктураОписания.Свойство("КомандыОбъекта") Тогда
		МассивОписанийКоманд = СтруктураОписания.КомандыОбъекта;
	КонецЕсли;
	
	СтруктураКомандОбъекта = Новый Структура;
	СтруктураКомандОбъекта.Вставить("ИмяКоманды"			, ИмяКоманды);
	СтруктураКомандОбъекта.Вставить("ПредставлениеКоманды"	, ПредставлениеКоманды);
	СтруктураКомандОбъекта.Вставить("ИмяКартинки"			, ИмяКартинки);
	СтруктураКомандОбъекта.Вставить("ОсновнаяКоманда"		, ОсновнаяКоманда);
	
	МассивОписанийКоманд.Добавить(СтруктураКомандОбъекта);
	
	СтруктураОписания.Вставить("КомандыОбъекта", МассивОписанийКоманд);

КонецПроцедуры

// Процедура - Установить метаданные внешнего объекта
//
//	Остатавилвивет имя метаданных для которого доступна внешняя подписка
//
// Параметры:
//  СтруктураОписания	 - 	 структура, в которую будет добавлено опиание параметров внешней команды
//  ИмяМетаданных		 - 	 - 
//
Процедура  УстановитьМетаданныеВнешнейПодписки(СтруктураОписания, ИмяМетаданного) Экспорт 
	
	Массив = Новый Массив;
	Если СтруктураОписания.Свойство("МетаданныеПодписки") Тогда
		Массив = СтруктураОписания.МетаданныеПодписки;
	КонецЕсли;
	
	Массив.Добавить(ИмяМетаданного);
	
	СтруктураОписания.Вставить("МетаданныеПодписки", Массив);
	
КонецПроцедуры

// Процедура - Установить метаданные внешнего объекта
//
// Параметры:
//  СтруктураОписания	 - 	 - 
//  ИмяМетаданного		 - 	 - 
//
Процедура  УстановитьМетаданныеВнешнегоОбъекта(СтруктураОписания, ИмяМетаданного) Экспорт 
	
	Массив = Новый Массив;
	Если СтруктураОписания.Свойство("ИмяМетаданного") Тогда
		Массив = СтруктураОписания.ИмяМетаданного;
	КонецЕсли;
	
	Массив.Добавить(ИмяМетаданного);
	
	СтруктураОписания.Вставить("ИмяМетаданного", Массив);
	
КонецПроцедуры

// Процедура - Установить назначения внешнего объекта
//
// Параметры:
//  СтруктураОписания	 - 	 - 
//  ИмяМетаданного		 - 	 - 
//
Процедура  УстановитьНазначениеВнешнегоОбъекта(СтруктураОписания, ИмяМетаданного) Экспорт 
	
	Массив = Новый Массив;
	Если СтруктураОписания.Свойство("НазначениеОбъекта") Тогда
		Массив = СтруктураОписания.НазначениеОбъекта;
	КонецЕсли;
	
	Массив.Добавить(ИмяМетаданного);
	
	СтруктураОписания.Вставить("НазначениеОбъекта", Массив);
	
КонецПроцедуры

Процедура ОбновитьРегистрациюПечатнойФормы(ПарамерыРегистрации) Экспорт
	
	ВнешняяОбработка 		=  ПарамерыРегистрации.ПодключаемыйОбъект;
	ПредставлениеОбработки 	= ?(ПустаяСтрока(ПарамерыРегистрации.Представление), СокрЛП(ВнешняяОбработка), ПарамерыРегистрации.Представление);
	
	Попытка
		
		Набор = РегистрыСведений.CW_ВнешниеПечатныеФормы.СоздатьНаборЗаписей();
		Набор.Отбор.Обработка.Установить(ВнешняяОбработка);
		Набор.Записать(Истина);
		
		Если ВнешняяОбработка.ПометкаУдаления Тогда
			Возврат;
		КонецЕсли; 
		
		Для Каждого Метаданное Из ПарамерыРегистрации.ИменаМетаданных Цикл
			
			Запись = Набор.Добавить();
			Запись.Обработка 	= ВнешняяОбработка;
			Запись.Метаданное 	= CW_Обмены_ПИ.МетаданноеКонфигурации(Метаданное);
			
			Запись.Наименование = ПредставлениеОбработки;
			Запись.Индекс 		= ВнешняяОбработка.Индекс;
			
		КонецЦикла; 
		
		Набор.Записать(Истина);
		
	Исключение  
		
		ВызватьИсключение ОписаниеОшибки();
		
	КонецПопытки; 
	
КонецПроцедуры

Функция НоваяСтруктураПараметрыРегистрации() Экспорт

	ПарамерыРегистрации = Новый Структура;
	ПарамерыРегистрации.Вставить("ПодключаемыйОбъект", 	Неопределено);
	ПарамерыРегистрации.Вставить("Представление", 		"");
	ПарамерыРегистрации.Вставить("ИменаМетаданных", 	Новый Массив);
	
	Возврат ПарамерыРегистрации;
	
КонецФункции

Функция НоваяСтруктураРезультатаПечати() Экспорт
	
	ПараметрыВывода = Новый Структура("Количество,Печать", 1, Истина);
	
	РезультатПечати = Новый Структура;
	РезультатПечати.Вставить("Представление", 				"");
	РезультатПечати.Вставить("Параметры", 					ПараметрыВывода);
	РезультатПечати.Вставить("ПечатнаяФорма", 				Новый ТабличныйДокумент);
	РезультатПечати.Вставить("АдресЭлПочты", 				"");
	РезультатПечати.Вставить("АдресЭлПочтыКопия", 			"");
	РезультатПечати.Вставить("АдресЭлПочтыСкрытаяКопия", 	"");
	
	Возврат РезультатПечати;
	
КонецФункции


//Описание подключаемых обработок

// Функция - Получить представление по шаблону
//
// Параметры:
//  ПодключаемыйОбъект				 - 	 Модуль внешнего объекта 
//  ПараметрыПодключаемогоОбъекта	 - 	 Структура параметров подключаемого объекта
//			Свойства:
//				- ПодключаемыйОбъект 	- ссылка "Справочник.CW_подключаемыеОбъекты";
//				- ШаблонПредставления 	- шаблон представления печатной формы;
//				- Представление 		- Представление печатной формы, которое будет установлено, если не заполнен шаблон
//  ПараметрыПроцедуры				 - 	 структура с произволным составом свойств, передается в функцию метода макроса в качестве параметра
// 
// Возвращаемое значение:
//   - Строка -  Заполненный шаблон представления печатной формы
//
Функция ПолучитьПредставлениеПоШаблону(ПодключаемыйОбъект, ПараметрыПодключаемогоОбъекта, ПараметрыПроцедуры = Неопределено) Экспорт

	Если ТипЗнч(ПараметрыПодключаемогоОбъекта) <> Тип("Структура") Тогда
		Возврат "";
	КонецЕсли;
	
	ШаблонПредставления = СокрЛП(ПараметрыПодключаемогоОбъекта.ШаблонПредставления);
	Если Не ЗначениеЗаполнено(ШаблонПредставления) Тогда
		Возврат ПараметрыПодключаемогоОбъекта.Представление;	
	КонецЕсли;
	
	Для Каждого СтрокаМакросов из ПараметрыПодключаемогоОбъекта.ПодключаемыйОбъект.Макросы Цикл
		//ИмяМакроса 		= "["+СокрЛП(СтрокаМакросов.ИмяМакроса)+"]";
		ИмяМакроса 		= СокрЛП(СтрокаМакросов.ИмяМакроса);
		ИмяМетода  		= СокрЛП(СтрокаМакросов.МетодМакроса);
		ЗначениеМакроса = Вычислить("ПодключаемыйОбъект."+ИмяМетода);
		
		ШаблонПредставления = СтрЗаменить(ШаблонПредставления, ИмяМакроса, ЗначениеМакроса);
	КонецЦикла;

	Возврат ШаблонПредставления;
	
КонецФункции

Функция ПолучитьМассивПредопределенныхМакросов()
	
	Массив = Новый Массив;
	Массив.Добавить("[НомерДокумента]");
	Массив.Добавить("[ДатаДокумента, dd.MM.yyyy]");
	Массив.Добавить("[ДатаДокумента, dd.MM.yy]");

	Возврат Массив;
	
КонецФункции

