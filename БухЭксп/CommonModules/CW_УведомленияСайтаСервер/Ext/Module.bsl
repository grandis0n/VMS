Процедура УдалениеУстаревшихУведомлений(АдресРезультата=Неопределено) Экспорт
	
	//УстановитьБезопасныйРежим(Истина);
	
	Версия = "";

	ОписаниеПодсистем = Новый Структура;
	CW_БухгалтерияЭкспедитораСервер.ПриДобавленииПодсистем(ОписаниеПодсистем);
	ОписаниеПодсистем.Свойство("CW_БухгалтерияЭкспедитора",Версия); 

	Запрос = Новый Запрос; 
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("Пользователь", 	ПараметрыСеанса.ТекущийПользователь);
	Запрос.УстановитьПараметр("Версия", 		Версия);

	Запрос.Текст = "ВЫБРАТЬ
	               |	CW_УведомленияСайта.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.CW_УведомленияСайта КАК CW_УведомленияСайта
	               |ГДЕ
	               |	CW_УведомленияСайта.ПометкаУдаления = ЛОЖЬ
	               |	И CW_УведомленияСайта.Версия <> &Версия";
	
	РезультатЗапроса = Запрос.Выполнить(); 
	
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий()Цикл  
		УведомленияСайтаОбъект = Выборка.Ссылка.получитьОбъект();
		УведомленияСайтаОбъект.Удалить();
	КонецЦикла;
	
КонецПроцедуры


Процедура CW_ЗагрузитьУведомленияРегламент() Экспорт
	
	ЗагрузитьУведомления();
	
КонецПроцедуры

Процедура ЗагрузитьУведомления(ПараметрыПроцедуры = Неопределено, АдресРезультата = Неопределено) Экспорт
	
   УстановитьПривилегированныйРежим(Истина);
	
   КороткоеИмя = CW_ОбновлениеКонфигурацииСервер.ПолучитьКороткоеИмяКонфигурации();   
   ИмяФайла 	= ПолучитьИмяФайлаУведомлений();   
   
   Уведомления_ИмяХоста 	= "www.coralway.ru";
   Уведомления_ПутьКФайлу 	= "/products/programs_cw/"+КороткоеИмя+"/Messages/"+ИмяФайла;
   
   ИмяВременногоФайла = ПолучитьИмяВременногоФайла("txt");
   
   Попытка
	   Соединение = Новый HTTPСоединение(Уведомления_ИмяХоста);
	   Соединение.Получить(Уведомления_ПутьКФайлу, ИмяВременногоФайла);
   Исключение
	   ЗаписьЖурналаРегистрации("УведомленияСайта",УровеньЖурналаРегистрации.Предупреждение, Метаданные.Справочники.CW_УведомленияСайта,, ОписаниеОшибки());
	   Возврат;
   КонецПопытки;
   
   ТекстовыйДокумент = новый ТекстовыйДокумент;
   ТекстовыйДокумент.Прочитать(ИмяВременногоФайла, КодировкаТекста.UTF8);
   
   СтрокаJSON = ТекстовыйДокумент.ПолучитьТекст();
   
   ЧтениеJSON = Новый ЧтениеJSON;
   ЧтениеJSON.УстановитьСтроку(СтрокаJSON);  
   
   СоответствиеУведомлений = ПрочитатьJSON(ЧтениеJSON, Истина);
   ЧтениеJSON.Закрыть();  
   
   Для Каждого КлючЗначение из СоответствиеУведомлений Цикл
	   
	   УведомлениеСсылка = XMLЗначение(Тип("СправочникСсылка.CW_УведомленияСайта"),КлючЗначение.Ключ);    
	   ДанныеУведомления = КлючЗначение.Значение;  
	   ВерсияУведомления = ДанныеУведомления.Получить("Version"); 
	   
	   УведомлениеОбъект = УведомлениеСсылка.ПолучитьОбъект();
	   Если УведомлениеОбъект = Неопределено Тогда  
		   УведомлениеОбъект 	= Справочники.CW_УведомленияСайта.СоздатьЭлемент(); 
		   УведомлениеОбъект.УстановитьСсылкуНового(УведомлениеСсылка); 
	   КонецЕсли;
	   
	   Если ВерсияУведомления <> УведомлениеОбъект.Версия Тогда  

		   УведомлениеОбъект.Наименование 	= ДанныеУведомления.Получить("Name");
		   УведомлениеОбъект.Релиз 			= ДанныеУведомления.Получить("Release");   
		   УведомлениеОбъект.ТекстСообщения	= ДанныеУведомления.Получить("Message");   
		   УведомлениеОбъект.Версия			= ДанныеУведомления.Получить("Version");   
	   
		   Релиз 		= ДанныеУведомления.Получить("Release"); 
		   Релиз 		= ?(Релиз = Неопределено, "0.0.0.0", Релиз);
		   мРазряды 	= СтрРазделить(Релиз,".", ложь);
		   
		   УведомлениеОбъект.Разряд1 = мРазряды[0];
		   УведомлениеОбъект.Разряд2 = мРазряды[1];
		   УведомлениеОбъект.Разряд3 = мРазряды[2];
		   УведомлениеОбъект.Разряд3 = мРазряды[3];
		   
		   СоответствиеВложений = ДанныеУведомления.Получить("Attachments");
		   
		   Вложения = Новый Структура;
		   Для Каждого Вложение из  СоответствиеВложений Цикл  
			   ДвоичныеДанные = Base64Значение(Вложение.Значение);
			   Картинка = Новый Картинка(ДвоичныеДанные);
			   
			   Вложения.Вставить(Вложение.Ключ, Картинка);
		   КонецЦикла;    
		   
		   ТекстHTML = ДанныеУведомления.Получить("TextHTML");   
		   
		   СтрукутраHTML = Новый Структура;
		   СтрукутраHTML.Вставить("ТекстHTML", ТекстHTML);
		   СтрукутраHTML.Вставить("Вложения",  Вложения);
		   
		   УведомлениеОбъект.ХранилищеHTML = Новый ХранилищеЗначения(СтрукутраHTML);  
		   
		   УведомлениеОбъект.Записать();
		   
		   
		   РегистрыСведений.CW_ПрочитанныеУведомления.ОтменитьПрочтениеУведомления(УведомлениеСсылка);
		   
	   КонецЕсли;
	   
   КонецЦикла;
   
КонецПроцедуры                               


Функция ПолучитьURLУведомлений() 
   
   КороткоеИмя = CW_ОбновлениеКонфигурацииСервер.ПолучитьКороткоеИмяКонфигурации();   
   ИмяФайла 	= ПолучитьИмяФайлаУведомлений();   
   
   Если КороткоеИмя = "" или ИмяФайла = "" Тогда
	   Возврат "";
   КонецЕсли;
   
   Возврат "/products/programs_cw/"+КороткоеИмя+"/Messages/"+ИмяФайла;     
   
КонецФункции    

Функция ПолучитьИмяФайлаУведомлений()
	
	Если CW_ВерсииПодсистемСервер.СуществуетПодсистема("CW_БухгалтерияЭкспедитораДляРоссии") Тогда  
		Модуль_CW_БухгалтерияЭкспедитораДляРоссииСервер = CW_ОбщегоНазначения.ОбщийМодуль("CW_БухгалтерияЭкспедитораДляРоссииСервер");
		Возврат Модуль_CW_БухгалтерияЭкспедитораДляРоссииСервер.ПолучитьИмяФайлаУведомлений();	
	КонецЕсли;
	
	Если CW_ВерсииПодсистемСервер.СуществуетПодсистема("CW_БухгалтерияЭкспедитораДляКазахстана") Тогда  
		Модуль_CW_БухгалтерияЭкспедитораДляКазахстанаСервер = CW_ОбщегоНазначения.ОбщийМодуль("CW_БухгалтерияЭкспедитораДляКазахстанаСервер");
		Возврат Модуль_CW_БухгалтерияЭкспедитораДляКазахстанаСервер.ПолучитьИмяФайлаУведомлений();	
	КонецЕсли; 
	
	Если CW_ВерсииПодсистемСервер.СуществуетПодсистема("CW_БухгалтерияЭкспедитораДляБелоруси") Тогда  
		Модуль_CW_БухгалтерияЭкспедитораДляБеларусиСервер = CW_ОбщегоНазначения.ОбщийМодуль("CW_БухгалтерияЭкспедитораДляБелорусиСервер");
		Возврат Модуль_CW_БухгалтерияЭкспедитораДляБеларусиСервер.ПолучитьИмяФайлаУведомлений();	
	КонецЕсли;
	
	Если CW_ВерсииПодсистемСервер.СуществуетПодсистема("CW_БухгалтерияЭкспедитораДляУзбекистана") Тогда  
		Модуль_CW_БухгалтерияЭкспедитораДляУзбекистанаСервер = CW_ОбщегоНазначения.ОбщийМодуль("CW_БухгалтерияЭкспедитораДляУзбекистанаСервер");
		Возврат Модуль_CW_БухгалтерияЭкспедитораДляУзбекистанаСервер.ПолучитьИмяФайлаУведомлений();	
	КонецЕсли;
	
   Возврат "";
   
КонецФункции

Функция ЕстьНепрочитанныеУведомления() Экспорт
	
	ИмяОсновнойПодсистемы 	= CW_ВерсииПодсистемСервер.ИмяОсновнойПодсистемы();
    ОсновнаяПоставка 		= CW_ВерсииПодсистемСервер.ОсновнаяПоставка();  
	Релиз 					= ОсновнаяПоставка[ИмяОсновнойПодсистемы];
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	CW_УведомленияСайта.Ссылка КАК Ссылка,
	               |	ВЫБОР
	               |		КОГДА CW_ПрочитанныеУведомления.Уведомление ЕСТЬ NULL
	               |			ТОГДА ЛОЖЬ
	               |		ИНАЧЕ ИСТИНА
	               |	КОНЕЦ КАК Прочитано
	               |ИЗ
	               |	Справочник.CW_УведомленияСайта КАК CW_УведомленияСайта
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.CW_ПрочитанныеУведомления КАК CW_ПрочитанныеУведомления
	               |		ПО CW_УведомленияСайта.Ссылка = CW_ПрочитанныеУведомления.Уведомление
	               |			И (CW_ПрочитанныеУведомления.Пользователь = &Пользователь)
	               |ГДЕ
	               |	ВЫБОР
	               |			КОГДА CW_ПрочитанныеУведомления.Уведомление ЕСТЬ NULL
	               |				ТОГДА ЛОЖЬ
	               |			ИНАЧЕ ИСТИНА
	               |		КОНЕЦ = ЛОЖЬ
	               |	И CW_УведомленияСайта.ПометкаУдаления = ЛОЖЬ
	               |	И CW_УведомленияСайта.Релиз = &Релиз";  
	
	Запрос.УстановитьПараметр("Пользователь", 	ПараметрыСеанса.ТекущийПользователь);
	Запрос.УстановитьПараметр("Релиз", 			Релиз);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат Не РезультатЗапроса.Пустой();
	
КонецФункции
	
	
