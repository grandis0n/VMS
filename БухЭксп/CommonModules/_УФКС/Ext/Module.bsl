// СД - Структура действия
Функция СД(Модуль,Выполнение,Команда,Параметры=Неопределено) Экспорт 
	// --- 
	
	// исполнение: клиент/сервер
	
	СД = Новый Структура;
	СД.Вставить("Модуль",Модуль);
	СД.Вставить("Выполнение",Выполнение);
	СД.Вставить("Команда",Команда);
	СД.Вставить("Параметры",Параметры);
	// --- 
	Возврат(СД);
	
	// --- 
КонецФункции

// --- 

Функция СформироватьПараметрыВыбораПоля(СтруктураПараметров) Экспорт 
	// --- 
	
	ПараметрыВыбора = Новый Массив;
	
	Для каждого КлючЗначение Из СтруктураПараметров Цикл
		
		ПараметрыВыбора.Добавить(Новый ПараметрВыбора("Отбор."+КлючЗначение.Ключ,КлючЗначение.Значение));
		
	КонецЦикла; 
	
	Возврат(Новый ФиксированныйМассив(ПараметрыВыбора));
	
	// --- 
КонецФункции


Функция СформироватьПараметрВыбораПоля(Имя,Значение) Экспорт 
	// --- 
	
	//Возврат(СформироватьПараметрыВыбораПоля(Новый Структура(Имя,Значение)));
	
	ПараметрыВыбора = Новый Массив;
	ПараметрыВыбора.Добавить(Новый ПараметрВыбора(Имя,Значение));
	
	Возврат(Новый ФиксированныйМассив(ПараметрыВыбора));
	
	// --- 
КонецФункции

