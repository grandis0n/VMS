// функция возвращает стандартную структуру ответа
Функция Ответ(Код=0,ОписаниеОшибки="") Экспорт 
	// --- 
	
	СтруктураОтвета = Новый Структура;
	СтруктураОтвета.Вставить("Код", Код);
	СтруктураОтвета.Вставить("ОписаниеОшибки",ОписаниеОшибки);
	Возврат(СтруктураОтвета);	
	
	// --- 
КонецФункции

// функция проверяет ответ
Функция ВыполненоУспешно(Ответ) Экспорт 
	// --- 
	
	Код = Неопределено;
	
	Если ТипЗнч(Ответ) = Тип("Структура") Тогда
		
		Если Ответ.Свойство("Код",Код) Тогда
			
			Если Код = 0 Тогда
				
				Возврат(Истина);
				
			Иначе
				
				Возврат(Ложь);
				
			КонецЕсли; 
			
		Иначе
			
			Возврат(Ложь);
			
		КонецЕсли; 
		
	Иначе
		
		Возврат(Ложь);
		
	КонецЕсли; 
	
	// --- 
КонецФункции

// возвращает описание ошибки
Функция ПредставлениеОшибки(Ответ) Экспорт 
	// --- 
	
	ТекстОшибки = "<не указано>";
	
	Если ТипЗнч(Ответ) = Тип("Структура") Тогда
		
		Ответ.Свойство("ОписаниеОшибки",ТекстОшибки);
		
	КонецЕсли; 
	
	Возврат(ТекстОшибки);
	
	// --- 
КонецФункции
  

// --- 

Функция ИнформационнаяБазаФайловая(Знач СтрокаСоединенияИнформационнойБазы = "") Экспорт
			
	Если ПустаяСтрока(СтрокаСоединенияИнформационнойБазы) Тогда
		СтрокаСоединенияИнформационнойБазы =  СтрокаСоединенияИнформационнойБазы();
	КонецЕсли;
	Возврат Найти(Врег(СтрокаСоединенияИнформационнойБазы), "FILE=") = 1;
	
КонецФункции 

//Наличие прикрепленных файло
Процедура УстановитьНаличиеПрикрепленныхФайловПриСозданииФормыНаСервере(Форма) Экспорт
	
	Объект = Форма.Объект;
	АдресКартинкиФайлов 		= _УФС.ПолучитьАдресКартинкиФайлов(Объект.Ссылка, Форма.УникальныйИдентификатор);
	Форма.АдресКартинкиФайлов  	= АдресКартинкиФайлов;
	
КонецПроцедуры
