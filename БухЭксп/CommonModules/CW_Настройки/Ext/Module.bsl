Функция ПараметрУчетнойПолитики(Дата, Организация, ИмяПараметра, кэшСтрокаПараметров=Неопределено) Экспорт
	
	Если Дата = Неопределено Тогда
		Дата = ТекущаяДата();
	КонецЕсли; 
	
	Если Неопределено = кэшСтрокаПараметров Тогда 
		СтрокаПараметров = ПараметрыУчетнойПолитики(Дата, Организация);
		кэшСтрокаПараметров = СтрокаПараметров;
	Иначе 
		СтрокаПараметров = кэшСтрокаПараметров;
	КонецЕсли;
	
	ЗначениеПараметра = Неопределено;
	СтрокаПараметров.Свойство(СокрЛП(ИмяПараметра), ЗначениеПараметра);
	
	// принудительное изменение параметров учетной политики в связи с изменением законодательства
	// (в учетной политике эти параметры блокируются для изменения и не визуализируются)
	#Область ПринудительнаяУстановкаПараметров
	
		Если ИмяПараметра = "ОбщаяСуммаСчетФактурыВСтрокахСводных" Тогда
			
			// в соответствии с постановлением Правительства РФ №981
			Если Дата >= Дата(2017,10,1) Тогда
				ЗначениеПараметра = Ложь;
			КонецЕсли; 
		КонецЕсли; 
		
		Если ИмяПараметра = ("СчетаФактурыПоПостановлению1137") или 
			(ИмяПараметра = "ТребованияПостановления735") 
		Тогда
			
			// в соответствии с постановлением Правительства РФ №735
			Если Дата >= Дата(2015,1,1) Тогда
				ЗначениеПараметра = Истина;
			КонецЕсли; 
		КонецЕсли; 
		
	#КонецОбласти 
	
	Возврат ЗначениеПараметра;
КонецФункции

//CW_Настройки.ПараметрыУчетнойПолитики(Дата, Организация)
Функция ПараметрыУчетнойПолитики(Дата, Организация) Экспорт
	
	Результат = Новый Структура;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	CW_УчетнаяПолитикаСрезПоследних.*
		|ИЗ
		|	РегистрСведений.CW_УчетнаяПолитика.СрезПоследних(
		|			&Дата,
		|			Организация = &Организация
		|	) КАК CW_УчетнаяПолитикаСрезПоследних";

	Запрос.УстановитьПараметр("Дата", 			Дата); 
	Запрос.УстановитьПараметр("Организация", 	Организация);    
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		ШаблонТекста = "Для организации %1 на дату %2 отсутствуют параметры учетной политики модуля ""Бухгалтерия экспедитора""";	
		
		ТекстОшибки = СтрШаблон(ШаблонТекста,СокрЛП(Организация), Формат(Дата, "ДФ=dd.MM.yyyy")); 
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	Для Каждого Колонка из РезультатЗапроса.Колонки Цикл  
		Результат.Вставить(Колонка.Имя);
	КонецЦикла; 
	
	Выборка.Следующий();
	ЗаполнитьЗначенияСвойств(Результат, Выборка);
	
	Возврат Результат;
	 
КонецФункции

Функция ПараметрУчетнойПолитикиУСН(Дата, Организация, ИмяПараметра, кэшСтрокаПараметров=Неопределено) Экспорт
	
	Если НЕ _сф.Определено(Дата) Тогда
		Дата = ТекущаяДата();
	КонецЕсли; 
	
	Если Неопределено = кэшСтрокаПараметров Тогда 
		СтрокаПараметров = ПараметрыУчетнойПолитикиУСН(Дата, Организация);
		кэшСтрокаПараметров = СтрокаПараметров;
	Иначе 
		СтрокаПараметров = кэшСтрокаПараметров;
	КонецЕсли;
	
	ЗначениеПараметра = Неопределено;
	СтрокаПараметров.Свойство(СокрЛП(ИмяПараметра), ЗначениеПараметра);
	
	Возврат ЗначениеПараметра;
КонецФункции

Функция ПараметрыУчетнойПолитикиУСН(Дата, Организация) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НастройкиУчетаУСНСрезПоследних.*
		|ИЗ
		|	РегистрСведений.НастройкиУчетаУСН.СрезПоследних(
		|			&Дата,
		|			Организация = &Организация
		|	) КАК НастройкиУчетаУСНСрезПоследних"
	;
	Запрос.УстановитьПараметр("Дата", Дата); 
	Запрос.УстановитьПараметр("Организация", Организация);
	ТЗ = Запрос.Выполнить().Выгрузить();
	
	Если _сф.Количество(ТЗ)=0 Тогда
		Если ЗначениеЗаполнено(Организация) Тогда 
			Сообщить("У организации "+Организация+" на дату "+Дата+" не установлены параметры учетной политики (БЭ)!");
		КонецЕсли;
		СтрокаПараметров = ТЗ.Добавить();
		Для Каждого колонкаТЗ Из тз.Колонки Цикл
			Для Каждого типЗначения Из колонкаТЗ.ТипЗначения.Типы() Цикл
				Если типЗначения <> Тип("Null") Тогда 
					масс = Новый Массив;
					масс.Добавить(типЗначения);
					оп = Новый ОписаниеТипов(масс);
					СтрокаПараметров[колонкаТЗ.Имя] = оп.ПривестиЗначение(Неопределено);
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	Иначе
		СтрокаПараметров = ТЗ[0];
	КонецЕсли;
	
	СП = _сф.ст_СоздатьИзТаблицы(ТЗ);
	_сф.ст_ЗаполнитьПоСтрокеТаблицы(СП,СтрокаПараметров);
	
	Возврат(СП);
	 
КонецФункции

Функция ПараметрГлобальнойУчетнойПолитики(Дата, Организация, ИмяПараметра, кэшСтрокаПараметров=Неопределено) Экспорт
	
	Если Дата=Неопределено Тогда
		Дата = ТекущаяДата();
	КонецЕсли; 
	
	Если Неопределено=кэшСтрокаПараметров Тогда 
		СтрокаПараметров = ПараметрыГлобальнойУчетнойПолитики(Дата, Организация);
		кэшСтрокаПараметров = СтрокаПараметров;
	Иначе 
		СтрокаПараметров = кэшСтрокаПараметров;
	КонецЕсли;
	
	// СтрокаПараметров это СтрокаТаблицыЗначений, причем строка возвращается всегда, даже когда ничего не найдено
	// а вот будет ли параметр в структуре колонок - это вопрос
	Если (СтрокаПараметров.Свойство(СокрЛП(ИмяПараметра))) Тогда
		ЗначениеПараметра = СтрокаПараметров[СокрЛП(ИмяПараметра)];
	Иначе
		ЗначениеПараметра = Неопределено;
	КонецЕсли; 
		
	Возврат ЗначениеПараметра;
	
КонецФункции      

