// Возвращает дату начала ведения бухгалтерского учета в модуле для указанной организации 
Функция ПолучитьДатуНачалаВеденияУчета(Организация) Экспорт
	
	Если Организация.Пустая() Тогда
		Возврат(Неопределено);	
	Иначе	
		Запрос = Новый Запрос("ВЫБРАТЬ
		                      |	CW_НачалоВеденияУчета.ДатаНачалаВеденияУчета
		                      |ИЗ
		                      |	РегистрСведений.CW_НачалоВеденияУчета КАК CW_НачалоВеденияУчета
		                      |ГДЕ
		                      |	CW_НачалоВеденияУчета.Организация = &Организация");
							  
		Запрос.УстановитьПараметр("Организация", Организация);					  
		
		ТЗ = Запрос.Выполнить().Выгрузить();
		Для каждого Стр Из ТЗ Цикл
			Возврат(Стр.ДатаНачалаВеденияУчета);	
		КонецЦикла; 
	КонецЕсли; // организация заполнена	
КонецФункции  

