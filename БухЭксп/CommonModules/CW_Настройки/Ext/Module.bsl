	Возврат(ПараметрыСеанса.ТекущийПользователь);
	
	// --- 
КонецФункции


// Функция - ПолучитьНастройкуПользователя()
//
// Параметры:
//    Пользователь – пользователь, для которого получается настройка. Если пользователь не указан, то настройка возвращается для текущего пользователя.
//    ИмяНастройки – строка с названием настройки.
// 
// Возвращаемое значение:
//    Возвращает значение индивидуальной настройки пользователя. Если передано несуществующее имя настройки, то возвращается Неопределено. 
//
Функция ПолучитьНастройкуПользователя(Знач Пользователь=Неопределено, ИмяНастройки, ПечатныеФормы = Ложь) Экспорт 
	
	НастройкиПользователя = ПолучитьНастройкиПользователя(Пользователь);
	
	Если НастройкиПользователя.Свойство(ИмяНастройки) Тогда
		ЗначениеНастройки = НастройкиПользователя[ИмяНастройки]; 
		Если Не ЗначениеЗаполнено(ЗначениеНастройки) и ПечатныеФормы Тогда
			Возврат Неопределено;
		КонецЕсли;
		Возврат ЗначениеНастройки;
	КонецЕсли;
	
	Возврат Неопределено;

КонецФункции

Функция ПолучитьНастройкиПользователя(Знач Пользователь=Неопределено) Экспорт 
	
	Пользователь = ?(Пользователь = Неопределено, ПараметрыСеанса.ТекущийПользователь, Пользователь);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ *
	|ИЗ
	|	РегистрСведений.CW_НастройкиПользователей КАК CW_НастройкиПользователей
	|ГДЕ CW_НастройкиПользователей.Пользователь = &Пользователь";
	
	Запрос.УстановитьПараметр("Пользователь", Пользователь);

	РезультатЗапроса = Запрос.Выполнить();
	
	СтруктураПараметров = Новый Структура;
	Для Каждого Колонка из РезультатЗапроса.Колонки Цикл  
		
		ДоступныеТипы = Колонка.ТипЗначения.Типы(); 
		Индекс = ДоступныеТипы.Найти(тип("Null"));
		Если Индекс <> Неопределено Тогда
			ДоступныеТипы.Удалить(Индекс);
		КонецЕсли;  
		
		Если ДоступныеТипы.Количество() = 1 Тогда
			ОписаниеТипа = Новый ОписаниеТипов(ДоступныеТипы);
			ПустоеЗначение = ОписаниеТипа.ПривестиЗначение(Неопределено);
		КонецЕсли;
		
		СтруктураПараметров.Вставить(Колонка.Имя, ПустоеЗначение);
	КонецЦикла;   
	
	Выборка = РезультатЗапроса.Выбрать();
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(СтруктураПараметров, Выборка);
	КонецЕсли;
	
	Возврат СтруктураПараметров;
	
КонецФункции

Функция ПолучитьФизЛицоПользователя(Пользователь) Экспорт 
	// --- 
	
	Возврат Пользователь.ФизическоеЛицо;
	
	// --- 
КонецФункции
  
Функция ПараметрДоговора(Дата, ОбъектПараметров, ИмяПараметра) Экспорт
	
	Если (Дата=Неопределено) Тогда
		Дата = ТекущаяДата();
	КонецЕсли; 
	
	Если ТипЗнч(ОбъектПараметров) = Тип("СправочникСсылка.CW_ДоговорыПоГрузоперевозкам") Тогда
		Организация = ОбъектПараметров.Организация;
	Иначе
		Организация = ОбъектПараметров.Договор.Организация;
	КонецЕсли;
	
	Если ИмяПараметра = "РасчетныйСчетОрганизации" Тогда 
		Возврат Организация.ОсновнойБанковскийСчет;
	КонецЕсли;
	
	Если Найти("/ДопИнфоДляПечатиСчетовПодвалРус/ДопИнфоДляПечатиСчетовПодвалАнгл/", ИмяПараметра)<>0 Тогда 
		Возврат ПараметрУчетнойПолитики(Дата, Организация, ИмяПараметра);
	КонецЕсли;
	
	ЗначениеПараметра = Неопределено;
	
	СтруктураПараметров = ПараметрыДоговора(Дата, ОбъектПараметров, ИмяПараметра);
	СтруктураПараметров.Свойство(СокрЛП(ИмяПараметра), ЗначениеПараметра);

	Возврат ЗначениеПараметра;
	
КонецФункции

Функция ПараметрыДоговора(Дата, ОбъектПараметров, ИмяПараметра="") Экспорт
	
	СтруктураПараметров = Новый Структура;

	Если ТипЗнч(ОбъектПараметров) = Тип("СправочникСсылка.CW_ДоговорыПоГрузоперевозкам") Тогда
		ДоговорВладелец		= ОбъектПараметров.Владелец;
		ОрганизацияДоговора = ОбъектПараметров.Организация;
		ВалютаДоговора 		= ОбъектПараметров.ВалютаДоговора;
	Иначе
		ДоговорВладелец		= ОбъектПараметров.Договор.Владелец;
		ОрганизацияДоговора = ОбъектПараметров.Договор.Организация;
		ВалютаДоговора 		= ОбъектПараметров.Договор.ВалютаДоговора;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	*
	|ИЗ
	|	РегистрСведений.CW_ПараметрыДоговоров.СрезПоследних(&Дата, Договор = &Договор) КАК CW_ПараметрыДоговоровСрезПоследних";
	
	Запрос.УстановитьПараметр("Дата", 		Дата); 
	Запрос.УстановитьПараметр("Договор", 	ОбъектПараметров);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Для Каждого Колонка из РезультатЗапроса.Колонки Цикл 
		Если СтрНачинаетсяС(Колонка.Имя, "УДАЛИТЬ") Тогда
			Продолжить;
		КонецЕсли;
		
		мТипыЗначения  = Колонка.ТипЗначения.Типы();
		ИндексТипаNull = мТипыЗначения.Найти(Тип("Null"));
		Если ИндексТипаNull <> Неопределено Тогда
			мТипыЗначения.Удалить(ИндексТипаNull);
		КонецЕсли;
		
		ПустоеЗначение = Неопределено;
		Если мТипыЗначения.Количество() = 1  Тогда
			мТип = Новый Массив;
			мТип.Добавить(мТипыЗначения[0]);
			
			ОграничениеТипа = Новый ОписаниеТипов(мТип);
			ПустоеЗначение  = ОграничениеТипа.ПривестиЗначение(ПустоеЗначение);
		Конецесли;
		
		СтруктураПараметров.Вставить(Колонка.Имя, ПустоеЗначение);
	КонецЦикла;
	
	Если РезультатЗапроса.Пустой() Тогда
		Если ЗначениеЗаполнено(ОбъектПараметров) Тогда
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Для договора "+Строка(ОбъектПараметров)+" с "+Строка(ДоговорВладелец)+" на дату "+Формат(Дата,"ДФ=dd.MM.yyyy")+" не установлены параметры!";
			Сообщение.Сообщить(); 
			Возврат СтруктураПараметров;
		КонецЕсли;
	КонецЕсли;
	
	
	Выборка  = РезультатЗапроса.Выбрать();
	Если Выборка.Следующий() Тогда
		
		ЗаполнитьЗначенияСвойств(СтруктураПараметров, Выборка);
	
		СведенияОбОрганизации = CW_БухгалтерияЭкспедитораСерверПереопределяемый.СведенияОЮрФизЛице(ОрганизацияДоговора, Дата);
		
		//из карточки организации(0), фиксированные(1), динамические(2)  
		Если Выборка.РежимПодписей = 0 Тогда
			
			Если СведенияОбОрганизации.Свойство("ДолжностьРуководителяПредставление") Тогда
				СтруктураПараметров.ДолжностьРуководителяОрганизации 	= СведенияОбОрганизации.ДолжностьРуководителяПредставление;
			КонецЕсли;
			Если СведенияОбОрганизации.Свойство("Руководитель") Тогда
				СтруктураПараметров.РуководительОрганизации  			= СведенияОбОрганизации.Руководитель;
			КонецЕсли;

		ИначеЕсли Выборка.РежимПодписей = 2 Тогда  
			
			ВыборкаЛицПодписывающихДокументы = ПолучитьПодписиОтветственныхЛиц(Выборка.ВариантПодписей, ОрганизацияДоговора, Дата);
			Если ВыборкаЛицПодписывающихДокументы <> Неопределено Тогда
				ЗаполнитьЗначенияСвойств(СтруктураПараметров, ВыборкаЛицПодписывающихДокументы);	
			КонецЕсли; 
			
		КонецЕсли;
		
		Если Выборка.ИзКарточкиОрганизации тогда    
			СтруктураПараметров.АдресОрганизации 		 	= СокрЛП(СведенияОбОрганизации.ЮридическийАдрес);	
			СтруктураПараметров.ТелефонОрганизации 		 	= СокрЛП(СведенияОбОрганизации.Телефоны);	
			СтруктураПараметров.РасчетныйСчетОрганизации 	= БухгалтерскийУчетПереопределяемый.ПолучитьБанковскийСчетПоУмолчанию(ОрганизацияДоговора,ВалютаДоговора);	
		КонецЕсли;
		
		Если Выборка.РеквизитыИзКарточкиКонтрагента тогда  
			
			СведенияОКонтрагенте = CW_БухгалтерияЭкспедитораСерверПереопределяемый.СведенияОЮрФизЛице(ДоговорВладелец, Дата);
			
			СтруктураПараметров.ЭлектронныйАдресКонтрагента	= СокрЛП(СведенияОКонтрагенте.Email);	
			СтруктураПараметров.Адрес 		 	= СокрЛП(СведенияОКонтрагенте.ЮридическийАдрес);	
			СтруктураПараметров.Телефон 		= СокрЛП(СведенияОКонтрагенте.Телефоны);	
			СтруктураПараметров.РасчетныйСчет  	= БухгалтерскийУчетПереопределяемый.ПолучитьБанковскийСчетПоУмолчанию(ДоговорВладелец, ВалютаДоговора);	
			
		КонецЕсли;
		
	КонецЕсли; 
	
	СтруктураПараметров.Вставить("ПорядокРасчета", 				СтруктураПараметров.УсловияОплаты.ПорядокРасчета);
	СтруктураПараметров.Вставить("ПодключаемаяОбработка", 		СтруктураПараметров.УсловияОплаты.ПодключаемаяОбработка);
	СтруктураПараметров.Вставить("СпособРасчетаОтсрочки", 		СтруктураПараметров.УсловияОплаты.СпособРасчетаОтсрочки);
	СтруктураПараметров.Вставить("ПроизводственныйКалендарь", 	СтруктураПараметров.УсловияОплаты.ПроизводственныйКалендарь);
	СтруктураПараметров.Вставить("ВариантПереносаДаты", 		СтруктураПараметров.УсловияОплаты.ВариантПереносаДаты);
	
	Если ПустаяСтрока(ИмяПараметра) Тогда 
		Возврат СтруктураПараметров;
	КонецЕсли;
	
	мПолучаемыеПараметры = СтрРазделить(ИмяПараметра, ";",Ложь);  
	
	РезультатСтруктура = Новый Структура;
	Для Каждого Параметр из мПолучаемыеПараметры Цикл
		РезультатСтруктура.Вставить(Параметр,  СтруктураПараметров[Параметр]); 
	КонецЦикла;  
	
	Если РезультатСтруктура.Свойство("УсловияОплаты") Тогда
		РезультатСтруктура.Вставить("ПорядокРасчета", 				СтруктураПараметров.ПорядокРасчета);
		РезультатСтруктура.Вставить("ПодключаемаяОбработка", 		СтруктураПараметров.ПодключаемаяОбработка);
		РезультатСтруктура.Вставить("СпособРасчетаОтсрочки", 		СтруктураПараметров.СпособРасчетаОтсрочки);
		РезультатСтруктура.Вставить("ПроизводственныйКалендарь", 	СтруктураПараметров.ПроизводственныйКалендарь);
		РезультатСтруктура.Вставить("ВариантПереносаДаты", 			СтруктураПараметров.ВариантПереносаДаты);
	КонецЕсли;
	
	
	Возврат РезультатСтруктура;
	
	 
КонецФункции

Функция ПолучитьТекстЗапросаПараметров(СтрокаИменПараметров)
	
	Если ПустаяСтрока(СтрокаИменПараметров) Тогда
		Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	CW_ПараметрыДоговоровСрезПоследних.*
		|ИЗ
		|	РегистрСведений.CW_ПараметрыДоговоров.СрезПоследних(&Дата, Договор = &Договор) КАК CW_ПараметрыДоговоровСрезПоследних";
	Иначе
		Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	CW_ПараметрыДоговоровСрезПоследних.Договор КАК Договор,";
		
		мИменаПараметров 	= СтрРазделить(СтрокаИменПараметров, ";", Ложь); 
		ГраницаЦикла 		= мИменаПараметров.Количество()-1;
		Для Индекс = 0 по ГраницаЦикла Цикл
			Текст = Текст +"
			|	CW_ПараметрыДоговоровСрезПоследних."+мИменаПараметров[Индекс]+" КАК "+мИменаПараметров[Индекс]+ ?(Индекс<ГраницаЦикла,",","");
			
		КонецЦикла;
		Текст = Текст +"
		|ИЗ
		|	РегистрСведений.CW_ПараметрыДоговоров.СрезПоследних(&Дата, Договор = &Договор) КАК CW_ПараметрыДоговоровСрезПоследних";
	КонецЕсли;
	
	Возврат Текст;

КонецФункции

// Функция - ПолучитьЗначениеПараметраДоговора
//
// Параметры:
//  ОбъектПараметров	- Ссылка "CW_ДоговорыПоГрузоперевозкам" ИЛИ Ссылка "CW_ПриложенияКДоговорам"
//  ИмяПараметра 		- Имя параметра; 
// 
// Возвращаемое значение:
//   - значение переданного параметра
//
Функция ПолучитьЗначениеПараметраДоговора(Дата, ОбъектПараметров, ИмяПараметра) Экспорт
	
	СтруктураПараметровДоговора = ПараметрыДоговора(Дата, ОбъектПараметров, ИмяПараметра);
	
	Возврат СтруктураПараметровДоговора[ИмяПараметра];
	
КонецФункции

// Функция - Получить параметры договора
//
// Параметры:
//  Параметры	 - 	 Структура параметров:
//						- Дата 					- Дата получения параметров;
//						- Договор 				- Ссылка "CW_ДоговорыПоГрузоперевозкам"
//						- ПриложениеКДоговору 	- Ссылка "CW_ПриложенияКДоговорам"
//  ИмяПараметра - 	Список имен параметров, разделенный ";" 
// 
// Возвращаемое значение:
//   - структуру со значенисями всех переданных имен парамтеров
//
Функция ПолучитьПараметрыДоговора(Параметры, ИмяПараметра="") Экспорт
	
	ОбъектПараметров = Неопределено;
	Если ПолучитьФункциональнуюОпцию("CW_ВедетсяУчетПриложенийПоДоговорам") Тогда
		Параметры.Свойство("ПриложениеКДоговору", ОбъектПараметров);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ОбъектПараметров) Тогда
		Параметры.Свойство("Договор", ОбъектПараметров);
	КонецЕсли;
	
	Возврат ПараметрыДоговора(Параметры.Дата, ОбъектПараметров, ИмяПараметра);
	
КонецФункции

Функция ПустаяСтруктураПолученияПараметровДоговора() Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Дата",	Неопределено);
	Результат.Вставить("Договор", Неопределено);
	Результат.Вставить("ПриложениеКДоговору", Неопределено);
	
	Возврат Результат;
	
КонецФункции


Функция ПолучитьПодписиОтветственныхЛиц(Вариант,Организация, ДатаСреза)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	CW_ЛицаПодписывающиеДокументыСрезПоследних.Вариант КАК Вариант,
	               |	CW_ЛицаПодписывающиеДокументыСрезПоследних.Организация КАК Организация,
	               |	CW_ЛицаПодписывающиеДокументыСрезПоследних.Руководитель КАК РуководительОрганизации,
	               |	CW_ЛицаПодписывающиеДокументыСрезПоследних.РуководительДолжность КАК ДолжностьРуководителяОрганизации,
	               |	CW_ЛицаПодписывающиеДокументыСрезПоследних.РуководительДолжностьАнгл КАК ДолжностьРуководителяОрганизацииАнгл,
	               |	CW_ЛицаПодписывающиеДокументыСрезПоследних.РуководительОснование КАК РуководительОснование,
	               |	CW_ЛицаПодписывающиеДокументыСрезПоследних.РуководительОснованиеАнгл КАК РуководительОснованиеАнгл,
	               |	CW_ЛицаПодписывающиеДокументыСрезПоследних.ГлБухгалтер КАК ГлавныйБухгалтерОрганизации,
	               |	CW_ЛицаПодписывающиеДокументыСрезПоследних.ГлБухгалтерОснование КАК ГлавныйБухгалтерОснование,
	               |	CW_ЛицаПодписывающиеДокументыСрезПоследних.ГлБухгалтерОснованиеАнгл КАК ГлавныйБухгалтерОснованиеАнгл
	               |ИЗ
	               |	РегистрСведений.CW_ЛицаПодписывающиеДокументы.СрезПоследних(
	               |			&ДатаСреза,
	               |			Вариант = &Вариант
	               |				И Организация = &Организация) КАК CW_ЛицаПодписывающиеДокументыСрезПоследних";
	
	запрос.УстановитьПараметр("ДатаСреза", 		ДатаСреза);
	запрос.УстановитьПараметр("Вариант", 		Вариант);
	запрос.УстановитьПараметр("Организация", 	Организация);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

