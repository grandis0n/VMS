
// Заполняет основные сведения о библиотеке или основной конфигурации.
// 
// Параметры:
//  Описание - Структура:
//
//   * Имя                 - Строка - имя подсисетмы, например, "CW_БухгалтерияЭкспедитора".
//   * Версия              - Строка - версия в формате из 4-х цифр, например, "2.1.3.1".
//
Процедура ПриДобавленииПодсистем(ОписаниеПодсистем) Экспорт
	
	//CW_БухгалтерияЭкспедитора
	Если СуществуетПодсистема("CW_БухгалтерияЭкспедитора") Тогда  
		Модуль_CW_БухгалтерияЭкспедитораСервер = CW_ОбщегоНазначения.ОбщийМодуль("CW_БухгалтерияЭкспедитораСервер");
		Модуль_CW_БухгалтерияЭкспедитораСервер.ПриДобавленииПодсистем(ОписаниеПодсистем);	
