Функция СуществуетПодсистема(ИмяПодсистемы) Экспорт  
	
	ИменаПодсистем = CW_ВерсииПодсистемСерверПовтИсп.ИменаПодсистем();
	Возврат ИменаПодсистем.Получить(ИмяПодсистемы) <> Неопределено;
	
КонецФункции   

Функция ТребуетсяОбновлениеПодсистем() Экспорт
	
	УстановленныеПодсистемы		= УстановленныеВерсииПодсистем(); 

	ОписаниеПодсистем = Новый Структура;
	ПриДобавленииПодсистем(ОписаниеПодсистем); 
	
	Для Каждого КлючЗначение из ОписаниеПодсистем Цикл
		
		УстановленнаяВерсия = Неопределено;
		УстановленныеПодсистемы.Свойство(КлючЗначение.Ключ, УстановленнаяВерсия);
		
		Если УстановленнаяВерсия = Неопределено Тогда 
			//Подсистема не установлена, нужно запустить обновление
			Возврат Истина;	
		КонецЕсли;
		
		ТребуетсяОбновление = СравнитьВерсииПодсистем(УстановленнаяВерсия, КлючЗначение.Значение);    
		Если ТребуетсяОбновление Тогда
			Возврат Истина;	
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции   

Функция ЭтоПервыйЗапуск() Экспорт
	
	УстановленнаяПодсистема = ОсновнаяПоставка();
	ИмяПодсистемы 			= ИмяОсновнойПодсистемы();  
	
	УстановленнаяВерсия = Неопределено;
	УстановленнаяПодсистема.Свойство(ИмяПодсистемы, УстановленнаяВерсия);
	
	Если УстановленнаяВерсия = Неопределено Или УстановленнаяВерсия = "0.0.0.0" Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции
	

Функция СравнитьВерсииПодсистем(УстановленнаяВерсия, ТекущаяВерсия) Экспорт
	
	Если УстановленнаяВерсия = ТекущаяВерсия тогда
		Возврат Ложь; 
	КонецЕсли;
	
	мТекущаяВерсия 			= СтрРазделить(ТекущаяВерсия, ".");
	мУстановленнаяВерсия 	= СтрРазделить(УстановленнаяВерсия, ".");  
	
	Для Индекс = 0 по мТекущаяВерсия.ВГраница() Цикл
		РазрядТекущаяВерсия 		= Число(мТекущаяВерсия.Получить(Индекс));
		РазрядУстановленнаяВерсия 	= Число(мУстановленнаяВерсия.Получить(Индекс));
		
		Если РазрядУстановленнаяВерсия < РазрядТекущаяВерсия Тогда
			//Если разряд устанолвенной весрии меньше разряда текущей версии подсистемы, то возвращаем "Истина", требуется обновление
			Возврат Истина;
		КонецЕсли;
	КонецЦикла; 
	
	Возврат Ложь;
	
КонецФункции  

Функция УстановленныеВерсииПодсистем() Экспорт

	Подсистемы = Новый Структура;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	CW_ВерсииПодсистем.ИмяПодсистемы КАК ИмяПодсистемы,
	               |	CW_ВерсииПодсистем.Версия КАК Версия
	               |ИЗ
	               |	РегистрСведений.CW_ВерсииПодсистем КАК CW_ВерсииПодсистем";
	
	Результат = Запрос.Выполнить();

	Выборка = Результат.Выбрать();
	Пока Выборка.Следующий() Цикл
		Подсистемы.Вставить(Выборка.ИмяПодсистемы, Выборка.Версия);
	КонецЦикла;
	
	Возврат Подсистемы;
	
КонецФункции  

Функция ОсновнаяПоставка() Экспорт

	Подсистемы = Новый Структура;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	CW_ВерсииПодсистем.ИмяПодсистемы КАК ИмяПодсистемы,
	               |	CW_ВерсииПодсистем.Версия КАК Версия
	               |ИЗ
	               |	РегистрСведений.CW_ВерсииПодсистем КАК CW_ВерсииПодсистем
	               |ГДЕ
	               |	CW_ВерсииПодсистем.ОсновнаяПоставка = ИСТИНА";
	
	Результат = Запрос.Выполнить();

	Выборка = Результат.Выбрать();
	Пока Выборка.Следующий() Цикл
		Подсистемы.Вставить(Выборка.ИмяПодсистемы, Выборка.Версия);
	КонецЦикла;
	
	Возврат Подсистемы;
	
КонецФункции


//Процедуры типовой конфигуарции
Функция ТекущаяВерсияБухгалтерияПредприятия() Экспорт
	
	ТекущаяВерсия = Неопределено;
	
	ВерсииПодсистем = ВерсииПодсистемБухгалтерияПредприятия();
	ВерсииПодсистем.Свойство(СокрЛП(Метаданные.Имя), ТекущаяВерсия);

	Возврат ?(ТекущаяВерсия = Неопределено, "0.0.0.0", ТекущаяВерсия);

КонецФункции   

Функция ВерсииПодсистемБухгалтерияПредприятия() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ВерсииПодсистем.ИмяПодсистемы КАК ИмяПодсистемы,
	               |	ВерсииПодсистем.Версия КАК Версия
	               |ИЗ
	               |	РегистрСведений.ВерсииПодсистем КАК ВерсииПодсистем";
	
	Результат = Запрос.Выполнить();
	
	Подсистемы = Новый Структура;
	Выборка = Результат.Выбрать();
	Пока Выборка.Следующий() Цикл
		Подсистемы.Вставить(Выборка.ИмяПодсистемы, Выборка.Версия);
	КонецЦикла;
	
	Возврат Подсистемы;
	
КонецФункции   

Функция ПроверитьСоответствиеВерсийТиповойБухгалтерии() Экспорт
	
	РекомендуемаяВерсияБухгалтерии 	= РекомендуемаяВерсияБухгалтерияПредприятия();
	ТекущаяВерсияБухгалтерии 		= ТекущаяВерсияБухгалтерияПредприятия();
	
	РазделительРекомендуемая = Найти(РекомендуемаяВерсияБухгалтерии, ".");
	
	//  РазделительРекомендуемая = 0 - для последней цифры версии
	//-----------------------------------------------------------
	Пока РазделительРекомендуемая >= 0 Цикл
		СравниваемаяЦифраРекомендуемая = ?(РазделительРекомендуемая <> 0,Число(Лев(РекомендуемаяВерсияБухгалтерии, РазделительРекомендуемая - 1)),Число(РекомендуемаяВерсияБухгалтерии));		
		
		РазделительТекущая = Найти(ТекущаяВерсияБухгалтерии, ".");
		СравниваемаяЦифраТекущая = ?(РазделительТекущая <> 0,Число(Лев(ТекущаяВерсияБухгалтерии, РазделительТекущая - 1)),Число(ТекущаяВерсияБухгалтерии));
		
		Если СравниваемаяЦифраТекущая < СравниваемаяЦифраРекомендуемая Тогда
			Возврат Ложь;
		Иначе
			РекомендуемаяВерсияБухгалтерии = Прав(РекомендуемаяВерсияБухгалтерии, СтрДлина(РекомендуемаяВерсияБухгалтерии) - РазделительРекомендуемая);
			РазделительРекомендуемая = Найти(РекомендуемаяВерсияБухгалтерии, ".");
			
			ТекущаяВерсияБухгалтерии = Прав(ТекущаяВерсияБухгалтерии, СтрДлина(ТекущаяВерсияБухгалтерии) - РазделительТекущая);
			РазделительТекущая = Найти(ТекущаяВерсияБухгалтерии, ".");
			
		КонецЕсли; 
		Если РазделительРекомендуемая = 0 Тогда
			Прервать;
		КонецЕсли; 		
	КонецЦикла; 
	
	Возврат Истина;
	
КонецФункции
//Процедуры типовой конфигуарции
