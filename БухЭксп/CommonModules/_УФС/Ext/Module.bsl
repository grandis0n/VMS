&НаСервере
Функция ПроверитьНастрокуКолонок(ИмяСписка,Знач Настройка,Знач СтандартнаяНастройка) Экспорт 
	// --- 
	
	// удаляем несуществующие колонки колонки, проверяем параметры существующих
	// в стандартных помечаем задействованные, оставшиеся незадействованными добавляем невидимыми
	
	МассивКолонокКУдалению = Новый Массив;
	СтандартнаяНастройка.Колонки.Добавить("_Актив");
	СтандартнаяНастройка.ЗаполнитьЗначения(Ложь,"_Актив");
	// --- 
	
	Для каждого СтрокаНастройки Из Настройка Цикл
		
		//  пробуем найти
		СтрокаСтандартнойНастройки = СтандартнаяНастройка.Найти(СтрокаНастройки.Имя,"Имя");
		Если СтрокаСтандартнойНастройки = Неопределено Тогда
			
			МассивКолонокКУдалению.Добавить(СтрокаНастройки);
			
		Иначе
			
			// переносим заголовок и тип
			_сф.Заполнить(СтрокаНастройки,СтрокаСтандартнойНастройки,"Заголовок,Тип");
			
			// помечаем строку стандартной настройки
			СтрокаСтандартнойНастройки._Актив = Истина;
			
		КонецЕсли; 
		
	КонецЦикла; 
	
	// удаляем устаревшие
	Для каждого СтрокаНастройки Из МассивКолонокКУдалению Цикл
		
		Настройка.Удалить(СтрокаНастройки);
		
	КонецЦикла; 
	
	// добавляем новые
	МассивДобавляемыхКолонок = СтандартнаяНастройка.НайтиСтроки(Новый Структура("_Актив",Ложь));
	Для каждого СтрокаСтандартнойНастройки Из МассивДобавляемыхКолонок Цикл
		
		Нстр = Настройка.Добавить();
		_сф.Заполнить(Нстр,СтрокаСтандартнойНастройки,,"Видимость");
		
	КонецЦикла; 
	
	Возврат(Настройка);
	
	// --- 
КонецФункции

