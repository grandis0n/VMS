&НаСервере
Процедура ОтключитьИсториюВыбораЭлементовФормы(Форма, МассивИсключаемыхРеквизитов=Неопределено) Экспорт 
	// --- 
	
	Если (МассивИсключаемыхРеквизитов = Неопределено) Тогда
		
		МассивИсключаемыхРеквизитов = Новый Массив;
		
	КонецЕсли; 
	ЕстьИсключаемые = (МассивИсключаемыхРеквизитов.Количество() <> 0);
	
	Для каждого ЭлементФормы Из Форма.Элементы Цикл
		
		Если (ТипЗнч(ЭлементФормы) = Тип("ПолеФормы")) Тогда
			
			Если (ЭлементФормы.Вид = ВидПоляФормы.ПолеВвода) Тогда
				
				ОтключитьИсторию = Истина;
				Если (ЕстьИсключаемые) Тогда
					
					Если (МассивИсключаемыхРеквизитов.Найти(ЭлементФормы.ПутьКДанным) <> Неопределено) Тогда
						
						ОтключитьИсторию = Ложь;
						
					КонецЕсли; 
					
				КонецЕсли; 
				Если (ОтключитьИсторию) Тогда
					
					ОтключитьИсториюВыбораДляЭлемента(ЭлементФормы);
					
				КонецЕсли;
				ВключитьКлассическийВидЭлементаФормы(ЭлементФормы);
				
			КонецЕсли; 
			
		КонецЕсли; 
		
	КонецЦикла; 
	
	// --- 
КонецПроцедуры
 

