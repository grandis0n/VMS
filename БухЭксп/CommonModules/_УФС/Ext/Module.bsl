//Процедуры огрангичения списка номенклатуры по договору
&НаСервере
Функция ОбновитьСписокУслугПоДоговору(ДатаСреза, Договор, Форма=Неопределено) Экспорт
	
	Если Не ЗначениеЗаполнено(ДатаСреза) Тогда
		ДатаСреза = ТекущаяДата();
	Конецесли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	CW_УслугиПоДоговоруГрузоперевозкиСрезПоследних.Договор КАК Договор,
	               |	CW_УслугиПоДоговоруГрузоперевозкиСрезПоследних.УслугиПоДоговруГрузоперевозки КАК УслугиПоДоговруГрузоперевозки
	               |ПОМЕСТИТЬ ВТ_ТекущийДокумент
	               |ИЗ
	               |	РегистрСведений.CW_УслугиПоДоговоруГрузоперевозки.СрезПоследних(&ДатаСреза, Договор = &Договор) КАК CW_УслугиПоДоговоруГрузоперевозкиСрезПоследних
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	CW_УслугиПоДоговоруГрузоперевозкиНоменклатураПоДоговору.Номенклатура КАК Номенклатура,
	               |	CW_УслугиПоДоговоруГрузоперевозкиНоменклатураПоДоговору.Груз КАК Груз,
	               |	CW_УслугиПоДоговоруГрузоперевозкиНоменклатураПоДоговору.Клиент КАК Клиент,
	               |	CW_УслугиПоДоговоруГрузоперевозкиНоменклатураПоДоговору.ПорядокОтражения КАК ПорядокОтражения,
	               |	CW_УслугиПоДоговоруГрузоперевозкиНоменклатураПоДоговору.СтавкаНДС КАК СтавкаНДС,
	               |	CW_УслугиПоДоговоруГрузоперевозкиНоменклатураПоДоговору.ВариантРасчетаНДС КАК ВариантРасчетаНДС,
	               |	CW_УслугиПоДоговоруГрузоперевозкиНоменклатураПоДоговору.Цена КАК Цена,
	               |	CW_УслугиПоДоговоруГрузоперевозкиНоменклатураПоДоговору.ЦенаБезНДС КАК ЦенаБезНДС,
	               |	CW_УслугиПоДоговоруГрузоперевозкиНоменклатураПоДоговору.Валюта КАК Валюта
	               |ИЗ
	               |	Документ.CW_УслугиПоДоговоруГрузоперевозки.НоменклатураПоДоговору КАК CW_УслугиПоДоговоруГрузоперевозкиНоменклатураПоДоговору
	               |ГДЕ
	               |	CW_УслугиПоДоговоруГрузоперевозкиНоменклатураПоДоговору.Ссылка В
	               |			(ВЫБРАТЬ
	               |				ВТ_ТекущийДокумент.УслугиПоДоговруГрузоперевозки КАК УслугиПоДоговруГрузоперевозки
	               |			ИЗ
	               |				ВТ_ТекущийДокумент КАК ВТ_ТекущийДокумент)
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Номенклатура
	               |АВТОУПОРЯДОЧИВАНИЕ";
	
	Запрос.УстановитьПараметр("ДатаСреза"	, ДатаСреза);
	Запрос.УстановитьПараметр("Договор"		, Договор);
	
	РезультатЗапроса = Запрос.Выполнить(); 
	Если РезультатЗапроса.Пустой() Тогда
		Возврат "";
	КонецЕсли;      
	
	ВалютаДоговора 		= Договор.ВалютаДоговора;
	КурсВалютыДоговра 	= CW_Финансы.ПолучитьКурсВалюты(ВалютаДоговора, ДатаСреза);
	
	кэшКурсов = Новый Соответствие;
	
	ТаблицаУслуг = РезультатЗапроса.Выгрузить();
	Для Каждого СтрокаТаблицы из ТаблицаУслуг Цикл
		Если СтрокаТаблицы.Валюта = ВалютаДоговора Тогда
			Продолжить;
		КонецЕсли;  
		
		КурсВалюты = кэшКурсов.Получить(СтрокаТаблицы.Валюта);
		
		Если КурсВалюты = Неопределено Тогда
			КурсВалюты = CW_Финансы.ПолучитьКурсВалюты(СтрокаТаблицы.Валюта, ДатаСреза);
			кэшКурсов.Вставить(СтрокаТаблицы.Валюта, КурсВалюты); 
		КонецЕсли;
		
		СтрокаТаблицы.Цена = CW_Финансы.ПересчитатьИзВалютыВВалюту(СтрокаТаблицы.Цена,
			СтрокаТаблицы.Валюта, ВалютаДоговора, КурсВалюты.Курс, КурсВалютыДоговра.Курс, КурсВалюты.Кратность, КурсВалютыДоговра.Кратность);     
		
		СтрокаТаблицы.ЦенаБезНДС = CW_Финансы.ПересчитатьИзВалютыВВалюту(СтрокаТаблицы.ЦенаБезНДС,
			СтрокаТаблицы.Валюта, ВалютаДоговора, КурсВалюты.Курс, КурсВалютыДоговра.Курс, КурсВалюты.Кратность, КурсВалютыДоговра.Кратность);     
	КонецЦикла;
	
	Возврат ПоместитьВоВременноеХранилище(ТаблицаУслуг, ?(Форма= Неопределено, "",Форма.УникальныйИдентификатор));
	
КонецФункции

&НаСервере
Функция ПолучитьУслугиДоговора(АдресУслугПоДоговору) Экспорт
	
	Если ЭтоАдресВременногоХранилища(АдресУслугПоДоговору) Тогда
		
		ТаблицаУслуг = ПолучитьИзВременногоХранилища(АдресУслугПоДоговору);
		Если ТипЗнч(ТаблицаУслуг) = Тип("ТаблицаЗначений") Тогда 
			времТаблица = ТаблицаУслуг.Скопировать();
			времТаблица.Свернуть("Номенклатура",);
			Возврат времТаблица.ВыгрузитьКолонку("Номенклатура");
		КонецЕсли;
		
	Конецесли;
	
	Возврат Новый Массив;
	
КонецФункции

&НаСервере
Процедура УстановитьСписокУслуг(СтруктураДанных) Экспорт
	
	Если СтруктураДанных.ЕстьОграниченияПоСпискуУслуг Тогда
		СтруктураДанных.ЭлементФормы.РежимВыбораИзСписка 	= Истина;
		СтруктураДанных.ЭлементФормы.ИсторияВыбораПриВводе	= ИсторияВыбораПриВводе.НеИспользовать;
		Если ЭтоАдресВременногоХранилища(СтруктураДанных.АдресУслугПоДоговору) Тогда
			СтруктураДанных.ЭлементФормы.СписокВыбора.ЗагрузитьЗначения(ПолучитьУслугиДоговора(СтруктураДанных.АдресУслугПоДоговору));
		КонецЕсли;
		
	Иначе
		СтруктураДанных.ЭлементФормы.РежимВыбораИзСписка   = Ложь;
		СтруктураДанных.ЭлементФормы.ИсторияВыбораПриВводе	= ИсторияВыбораПриВводе.Авто;
		СтруктураДанных.ЭлементФормы.СписокВыбора.Очистить();		
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьУслугуДоговораПоПараметрам(СтруктураПараметров) Экспорт

	тУслугиПоДоговору = ПолучитьИзВременногоХранилища(СтруктураПараметров.АдресУслугПоДоговору);
	
	МассивГрузы = Новый Массив;
	МассивГрузы.Добавить(Справочники.CW_Грузы.ПустаяСсылка());
	Если СтруктураПараметров.УстанавливатьЦенуВЗависимостиОтГруза Тогда
		МассивГрузы.Добавить(СтруктураПараметров.Груз);
	КонецЕсли;
	
	МассивКлиенты = Новый Массив;
	МассивКлиенты.Добавить(Справочники.Контрагенты.ПустаяСсылка());
	Если  СтруктураПараметров.УстанавливатьЦенуВЗависимостиОтКлиента Тогда
		МассивКлиенты.Добавить(СтруктураПараметров.Клиент);
	КонецЕсли;
	
	Запрос= Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	запрос.Текст = "ВЫБРАТЬ
	               |	ВнешняяТаблицаУслуг.Номенклатура КАК Номенклатура,
	               |	ВнешняяТаблицаУслуг.Груз КАК Груз,
	               |	ВнешняяТаблицаУслуг.Клиент КАК Клиент,
	               |	ВнешняяТаблицаУслуг.ПорядокОтражения КАК ПорядокОтражения,
	               |	ВнешняяТаблицаУслуг.Цена КАК Цена,
	               |	ВнешняяТаблицаУслуг.СтавкаНДС КАК СтавкаНДС,
	               |	ВнешняяТаблицаУслуг.ВариантРасчетаНДС КАК ВариантРасчетаНДС,
	               |	ВнешняяТаблицаУслуг.ЦенаБезНДС КАК ЦенаБезНДС
	               |ПОМЕСТИТЬ ВТ_ТаблицаУслуг
	               |ИЗ
	               |	&ВнешняяТаблицаУслуг КАК ВнешняяТаблицаУслуг
	               |ГДЕ
	               |	ВнешняяТаблицаУслуг.Номенклатура = &Номенклатура
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ_ТаблицаУслуг.Номенклатура КАК Номенклатура,
	               |	ВТ_ТаблицаУслуг.Груз КАК Груз,
	               |	ВТ_ТаблицаУслуг.Клиент КАК Клиент,
	               |	ВТ_ТаблицаУслуг.ПорядокОтражения КАК ПорядокОтражения,
	               |	ВТ_ТаблицаУслуг.Цена КАК Цена,
	               |	ВТ_ТаблицаУслуг.СтавкаНДС КАК СтавкаНДС,
	               |	ВТ_ТаблицаУслуг.ВариантРасчетаНДС КАК ВариантРасчетаНДС,
	               |	ВТ_ТаблицаУслуг.ЦенаБезНДС КАК ЦенаБезНДС
	               |ИЗ
	               |	ВТ_ТаблицаУслуг КАК ВТ_ТаблицаУслуг
	               |ГДЕ
	               |	ВТ_ТаблицаУслуг.Груз В(&МассивГрузов)
	               |	И ВТ_ТаблицаУслуг.Клиент В(&МассивКлиентов)
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Клиент УБЫВ,
	               |	Груз УБЫВ";
	
	Запрос.УстановитьПараметр("ВнешняяТаблицаУслуг"	, тУслугиПоДоговору);
	Запрос.УстановитьПараметр("Номенклатура"		, СтруктураПараметров.Номенклатура);
	Запрос.УстановитьПараметр("МассивГрузов"		, МассивГрузы);
	Запрос.УстановитьПараметр("МассивКлиентов"		, МассивКлиенты);
	
	РезультатЗапроса = запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции


//Обновление количества
&НаСервере
Процедура ОбработатьтаблицуУслугНаСервере(ВремТаблицаУслуги, УстановитьНольЕслиНеЗадан) Экспорт
	
	Для Каждого СтрокаТекущая из ВремТаблицаУслуги Цикл
		
		СтароеЗначениеКоличества = СтрокаТекущая.Количество;
		
		ДанныеСтроки = Новый Структура;
		ДанныеСтроки.Вставить("Грузоперевозка"	, СтрокаТекущая.Грузоперевозка);
		ДанныеСтроки.Вставить("Номенклатура"	, СтрокаТекущая.Номенклатура);
		
		ЗначениеПараметра = ПолучитьЗначениеПараметра(ДанныеСтроки, УстановитьНольЕслиНеЗадан);
		
		Если ЗначениеПараметра <> Неопределено Тогда
			Если СтароеЗначениеКоличества <> ЗначениеПараметра Тогда
				СтрокаТекущая.Количество =  ЗначениеПараметра;
				ПересчитатьДанныеСтроки(СтрокаТекущая);
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ПересчитатьДанныеСтроки(СтрокаТекущая)
	
	СтрокаТекущая.Сумма = СтрокаТекущая.Цена * СтрокаТекущая.Количество;
	СтрокаТекущая.НДС 	= СтрокаТекущая.Сумма * CW_Финансы.ПолучитьСтавкуНДС(СтрокаТекущая.СтавкаНДС)/100;
	СтрокаТекущая.Всего = СтрокаТекущая.Сумма + СтрокаТекущая.НДС;
	
КонецПроцедуры


&НаСервере
Функция ПолучитьЗначениеПараметра(ДанныеСтроки, УстановитьНольЕслиНеЗадан)
	
	СтруктураПараметров = новый Структура;
	СтруктураПараметров.Вставить("ТипПеревозки"		, ДанныеСтроки.Грузоперевозка.ТипПеревозки);
	СтруктураПараметров.Вставить("Номенклатура"		, ДанныеСтроки.Номенклатура);
	СтруктураПараметров.Вставить("ЕдиницаИзмерения"	, ДанныеСтроки.Номенклатура.ЕдиницаИзмерения);
	
	НайденныйПараметр 	= CW_Документы.ПолучитьПараметрДляПодстановкиЗначенияВКоличество(СтруктураПараметров);
	
	ЗначениеПараметра = Неопределено;
	
	Если НайденныйПараметр <> Неопределено Тогда
		
		//Получаем только первое значение
		Запрос = новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	CW_ХарактеристикиГрузоперевозок.Грузоперевозка КАК Грузоперевозка,
		               |	CW_ХарактеристикиГрузоперевозок.Параметр КАК Параметр,
		               |	CW_ХарактеристикиГрузоперевозок.Значение КАК Значение
		               |ИЗ
		               |	РегистрСведений.CW_ХарактеристикиГрузоперевозок КАК CW_ХарактеристикиГрузоперевозок
		               |ГДЕ
		               |	CW_ХарактеристикиГрузоперевозок.Грузоперевозка = &Грузоперевозка
		               |	И CW_ХарактеристикиГрузоперевозок.Параметр = &Параметр";  
		
		Запрос.УстановитьПараметр("Грузоперевозка", ДанныеСтроки.Грузоперевозка);
		Запрос.УстановитьПараметр("Параметр", 		НайденныйПараметр);
		
		РезультатаЗапроса = Запрос.Выполнить();
		Выборка = РезультатаЗапроса.Выбрать();
		Если Выборка.Следующий() тогда
			ЗначениеПараметра =  Выборка.Значение;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(ЗначениеПараметра) Тогда
			ЗначениеПараметра = ?(УстановитьНольЕслиНеЗадан,0,1);
		КонецЕсли;
		
	КонецЕсли;	
	
	Возврат  ЗначениеПараметра;
	
КонецФункции

&НаСервере
Процедура ПриСозданииФормыСписка(ФормаОбъекта) Экспорт
	
	РедактированиеЗапрещено = Ложь;
	
	ТипОбъекта = _сф.стр_ПолучитьСтроку(ФормаОбъекта.ИмяФормы,".",1);
	ИмяОбъекта = _сф.стр_ПолучитьСтроку(ФормаОбъекта.ИмяФормы,".",2);
	
	РедактированиеЗапрещено = РегистрыСведений.CW_ДоступныеСправочникиПоГруппамПользователей.РедактированиеОбъектаЗапрещено(ТипОбъекта+"."+ИмяОбъекта);

	ФормаОбъекта.ТолькоПросмотр = РедактированиеЗапрещено;
	
	ЭлементФормы = ФормаОбъекта.Элементы.Найти("Список");
	Если ЭлементФормы <> Неопределено Тогда
		ЭлементФормы.ИзменятьСоставСтрок = НЕ РедактированиеЗапрещено;
		ЭлементФормы.ТолькоПросмотр		 = РедактированиеЗапрещено;
	КонецЕсли;
	
КонецПроцедуры

#Область ДополнительныеКолонкиДокументов

Процедура ОбновитьСписокДополнительныхКолонокФормы(ФормаОбъекта, ИмяНастройки) Экспорт
	
	ФормаОбъекта.СписокДополнительныхКолонок.Очистить();
	
	СоответствиеПараметров = Новый Соответствие;
	
	Справочники.CW_Грузоперевозки.ПолучитьСписокРеквизитовШапкиДляВыводаНаФорму(СоответствиеПараметров, ФормаОбъекта.СписокДополнительныхКолонок);
	ПланыВидовХарактеристик.CW_ПараметрыГрузоперевозок.ПолучиьСписокПараметровДляВыводаНаФорму(СоответствиеПараметров, ФормаОбъекта.СписокДополнительныхКолонок);
	
	ФормаОбъекта.СписокДоступныхПараметров.Добавить(СоответствиеПараметров);	
	
	//Настройки = Неопределено;
	Настройки = ХранилищеСистемныхНастроек.Загрузить(ФормаОбъекта.ИмяФормы, ИмяНастройки);
	Если Настройки <> Неопределено Тогда
		Если Настройки.Свойство("ВыбранныеКолонки") Тогда
			ФормаОбъекта.СписокВыбранныеКолонки.ЗагрузитьЗначения(Настройки.ВыбранныеКолонки);
			Для Каждого ЭлементМассива из Настройки.ВыбранныеКолонки Цикл
				ЭлементСписка = ФормаОбъекта.СписокДополнительныхКолонок.НайтиПоЗначению(ЭлементМассива);
				Если ЭлементСписка <> Неопределено Тогда
					ЭлементСписка.Пометка = истина;
				КонецЕсли;
			КонецЦикла;
			
			ДополнитьДинамическиеКолонки(ФормаОбъекта);
			
		КонецЕсли;
	КонецЕсли;	
	
КонецПроцедуры

Процедура ДополнитьДинамическиеКолонки(ФормаОбъекта) Экспорт
	
    МассивДобавляемыхКолонокРезультатПоиска = Новый Массив;
	МассивУдаляемыхКолонокРезультатПоиска 	 = Новый Массив;
	
	мТипыРеквизитв = Новый Массив;
	мТипыРеквизитв.Добавить(Тип("Строка"));
	мТипыРеквизитв.Добавить(Тип("Число"));
	мТипыРеквизитв.Добавить(Тип("Дата"));
	мТипыРеквизитв.Добавить(Тип("Булево"));
	мТипыРеквизитв.Добавить(Справочники.ТипВсеСсылки());
	
	РеквизитыТаблицы = ФормаОбъекта.ПолучитьРеквизиты("Объект.Услуги");
	
	мРеквизитыТаблицы = Новый массив;
	Для Каждого Реквизит из РеквизитыТаблицы Цикл
		мРеквизитыТаблицы.Добавить(Реквизит.имя);
	КонецЦикла;

	СписокДобавляемыхДополнительныхКолонок = новый СписокЗначений;
	
	Для Каждого ЭлементСписка из ФормаОбъекта.СписокДополнительныхКолонок Цикл
		Если ЭлементСписка.Пометка тогда
			//РезультатПоиска
			Если мРеквизитыТаблицы.Найти("_"+ЭлементСписка.Значение) = Неопределено Тогда
				МассивДобавляемыхКолонокРезультатПоиска.Добавить(Новый РеквизитФормы("_"+ЭлементСписка.Значение, Новый ОписаниеТипов(мТипыРеквизитв), "Объект.Услуги",ЭлементСписка.Представление,Ложь));
			КонецЕсли;
			СписокДобавляемыхДополнительныхКолонок.Добавить(ЭлементСписка.Значение,ЭлементСписка.Представление,ЭлементСписка.Пометка); 
		Иначе
			УдаляемыйРеквизит = мРеквизитыТаблицы.Найти("_"+ЭлементСписка.Значение);
			Если УдаляемыйРеквизит <> Неопределено Тогда
				МассивУдаляемыхКолонокРезультатПоиска.Добавить("Объект.Услуги."+мРеквизитыТаблицы[УдаляемыйРеквизит]);
			КонецЕсли;
		КонецЕсли
	КонецЦикла;
	
	//РезультатПоиска
	ФормаОбъекта.ИзменитьРеквизиты(МассивДобавляемыхКолонокРезультатПоиска,МассивУдаляемыхКолонокРезультатПоиска);
	
	//Выводим на форме
	РасположениеКолонок = ФормаОбъекта.Элементы.Найти("УслугиДополнительныеКолонки");
	Если РасположениеКолонок = Неопределено тогда
		РасположениеКолонок = ФормаОбъекта.Элементы.Услуги;
	Конецесли;
	
	ВсегоКолонок = СписокДобавляемыхДополнительныхКолонок.Количество();
	Индекс = 0;
	
	СооветствиеГрупп = новый Соответствие;
	Для Индекс = 0 По  ВсегоКолонок Цикл
		Если Индекс%3 = 0 Тогда
			НайденныйЭлемент = ФормаОбъекта.Элементы.Найти("УслугиДополнительныеКолонки_"+Формат(Индекс,"ЧГ=0"));
			Если найденныйЭлемент <> Неопределено Тогда
				//Удаляем с формы
				ФормаОбъекта.Элементы.Удалить(НайденныйЭлемент);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Для Индекс = 0 По  ВсегоКолонок Цикл
		Если Индекс%3 = 0 Тогда
			НайденныйЭлемент = ФормаОбъекта.Элементы.Найти("УслугиДополнительныеКолонки_"+Формат(Индекс,"ЧГ=0"));
			Если найденныйЭлемент = Неопределено Тогда
				
				нЭлемент 				= ФормаОбъекта.Элементы.Добавить("УслугиДополнительныеКолонки_"+Формат(Индекс,"ЧГ=0"), Тип("ГруппаФормы"), РасположениеКолонок); 
				нЭлемент.Группировка 	= ГруппировкаКолонок.Вертикальная; 
				нЭлемент.ТолькоПросмотр = истина;
			КонецЕсли;
			
			СооветствиеГрупп.Вставить(Индекс, нЭлемент); 
		КонецЕсли;
	КонецЦикла;

	Для Каждого ЭлементСписка  из ФормаОбъекта.СписокДополнительныхКолонок Цикл
		//РезультатПоиска_
		НайденныйЭлемент = ФормаОбъекта.Элементы.Найти("Услуги_"+ЭлементСписка.Значение);
		Если найденныйЭлемент <> Неопределено Тогда
			//Удаляем с формы
			ФормаОбъекта.Элементы.Удалить(НайденныйЭлемент);
		КонецЕсли;
	КонецЦикла;
	
	Индекс = 0;
	Для Каждого ЭлементСписка  из СписокДобавляемыхДополнительныхКолонок Цикл
		
		Если Индекс%3 = 0 Тогда
			РасположениеКолонок = СооветствиеГрупп.Получить(Индекс);
		КонецЕсли;
		
		Если ФормаОбъекта.Элементы.Найти("Услуги_"+ЭлементСписка.Значение) = Неопределено  тогда
			//РезультатПоиска
			нЭлемент 				= ФормаОбъекта.Элементы.Добавить("Услуги_"+ЭлементСписка.Значение, Тип("ПолеФормы"), РасположениеКолонок); 
			нЭлемент.Вид 			= ВидПоляФормы.ПолеВвода; 
			нЭлемент.ПутьКДанным 	= "Объект.Услуги."+"_"+ЭлементСписка.Значение;
			нЭлемент.ТолькоПросмотр = истина;
		Конецесли;
		Индекс = Индекс + 1;
	КонецЦикла;
	
КонецПроцедуры

//В процедуры и функции передается структура следующего вида:
//	СтуктураПараметров = Новый Структура;
//	СтуктураПараметров.Вставить("Объект"				, );
//	СтуктураПараметров.Вставить("ТаблицаДокумента"		, );
//	СтуктураПараметров.Вставить("ВыбранныеКолонки"		, );
//	СтуктураПараметров.Вставить("СоответствиеПараметров", );
//	СтуктураПараметров.Вставить("мГрузоперевозки"		, );
//
Процедура ОбновитьЗначенияПараметровГрузоперевозок(СтруктураПараметров) Экспорт
	
	ВыборкаЗначенийДополнительныхКолонок = ПолучитьЗначенияДополнительныхКолонокТаблицы(СтруктураПараметров);
	
	Для Каждого СтрокаУслуг из СтруктураПараметров.ТаблицаДокумента Цикл
		Для Каждого ЭлементСписка из СтруктураПараметров.ВыбранныеКолонки Цикл
			
			СтрокаСоответствия = СтруктураПараметров.СоответствиеПараметров.Получить(ЭлементСписка);
			Если СтрокаСоответствия <> Неопределено Тогда
				
				Если СтрокаСоответствия.ЭтоПараметр Тогда
					ОтборВыборки = Новый Структура("Грузоперевозка,Параметр",СтрокаУслуг.Грузоперевозка, СтрокаСоответствия.Значение); 
				Иначе
					ОтборВыборки = Новый Структура("Грузоперевозка",СтрокаУслуг.Грузоперевозка); 
				КонецЕсли;
				
				Если  ВыборкаЗначенийДополнительныхКолонок <> Неопределено Тогда
					ВыборкаЗначенийДополнительныхКолонок.Сбросить();
					Если ВыборкаЗначенийДополнительныхКолонок.НайтиСледующий(ОтборВыборки) Тогда
						Если СтрокаСоответствия.ЭтоПараметр Тогда 
							Если СтрЗаканчиваетсяНа(ЭлементСписка, "План") Тогда
								СтрокаУслуг["_"+ЭлементСписка] = ВыборкаЗначенийДополнительныхКолонок.ЗначениеПлан;
							ИначеЕсли СтрЗаканчиваетсяНа(ЭлементСписка, "Факт") Тогда  
								СтрокаУслуг["_"+ЭлементСписка] = ВыборкаЗначенийДополнительныхКолонок.ЗначениеФакт;
							Иначе
								СтрокаУслуг["_"+ЭлементСписка] = ВыборкаЗначенийДополнительныхКолонок.Значение;
							КонецЕсли;
						Иначе
							СтрокаУслуг["_"+ЭлементСписка] = ВыборкаЗначенийДополнительныхКолонок[СтрокаСоответствия.Значение];
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;  
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьЗначенияДополнительныхКолонокТаблицы(СтруктураПараметров)
	
	мПараметры = Новый Массив;
	мРеквизиты = Новый Массив;
	Для Каждого ЭлементМассива из СтруктураПараметров.ВыбранныеКолонки Цикл
		СтрокаСоответствия = СтруктураПараметров.СоответствиеПараметров.Получить(ЭлементМассива);
		Если СтрокаСоответствия <> Неопределено Тогда
			Если СтрокаСоответствия.ЭтоПараметр Тогда
				мПараметры.Добавить(СтрокаСоответствия.Значение);
			Иначе
				мРеквизиты.Добавить(СтрокаСоответствия.Значение);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	//формируем масив заказов
	мЗаказы = Новый Массив;
	Для Каждого Грузоперевозка из СтруктураПараметров.мГрузоперевозки Цикл
		Если Не ЗначениеЗаполнено(Грузоперевозка.Заказ) Тогда
			Продолжить;
		КонецЕсли;
		Если мЗаказы.Найти(Грузоперевозка.Заказ) = Неопределено Тогда
			мЗаказы.Добавить(Грузоперевозка.Заказ);	
		КонецЕсли;
	КонецЦикла;
	//КОНЕЦ формируем масив заказов
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = "ВЫБРАТЬ";
	
	Для Каждого ЭлементМассива из мРеквизиты Цикл
		Запрос.Текст = Запрос.Текст + "			   
		|	CW_Грузоперевозки."+ЭлементМассива+" КАК "+ЭлементМассива+",";
	КонецЦикла;
	
	Запрос.Текст = Запрос.Текст + "			   
	|	CW_Грузоперевозки.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ ВТ_Грузоперевозки
	|ИЗ
	|	Справочник.CW_Грузоперевозки КАК CW_Грузоперевозки
	|ГДЕ
	|	CW_Грузоперевозки.Ссылка В(&мГрузоперевозки)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	CW_ХарактеристикиГрузоперевозок.Грузоперевозка КАК Грузоперевозка,
	|	CW_ХарактеристикиГрузоперевозок.Параметр КАК Параметр,
	|	CW_ХарактеристикиГрузоперевозок.Значение КАК Значение,
	|	CW_ХарактеристикиГрузоперевозок.ЗначениеПлан КАК ЗначениеПлан,
	|	CW_ХарактеристикиГрузоперевозок.ЗначениеФакт КАК ЗначениеФакт
	|ПОМЕСТИТЬ ВТ_ПараметрыГрузоперевозок
	|ИЗ
	|	РегистрСведений.CW_ХарактеристикиГрузоперевозок КАК CW_ХарактеристикиГрузоперевозок
	|ГДЕ
	|	CW_ХарактеристикиГрузоперевозок.Грузоперевозка В(&мГрузоперевозки)
	|	И CW_ХарактеристикиГрузоперевозок.Параметр В(&мПараметры)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
  	|ВЫБРАТЬ
	|	CW_ХарактеристикиЗаказов.Заказ КАК Заказ,
	|	CW_ХарактеристикиЗаказов.Параметр КАК Параметр,
	|	CW_ХарактеристикиЗаказов.Значение КАК Значение,
	|	CW_ХарактеристикиЗаказов.ЗначениеПлан КАК ЗначениеПлан,
	|	CW_ХарактеристикиЗаказов.ЗначениеФакт КАК ЗначениеФакт
	|ПОМЕСТИТЬ ВТ_ПараметрыЗаказов
	|ИЗ
	|	РегистрСведений.CW_ХарактеристикиЗаказов КАК CW_ХарактеристикиЗаказов
	|ГДЕ
	|	&ЕстьЗаказы
	|	И CW_ХарактеристикиЗаказов.Заказ В(&мЗаказы)
	|	И CW_ХарактеристикиЗаказов.Параметр В(&мПараметры)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Грузоперевозки.Ссылка КАК Грузоперевозка,";
	
	Для Каждого ЭлементМассива из мРеквизиты Цикл
		Запрос.Текст = Запрос.Текст + "			   
		|	ВТ_Грузоперевозки."+ЭлементМассива+" КАК "+ЭлементМассива+",";
	КонецЦикла;
	
	Запрос.Текст = Запрос.Текст + "			   
	|	ЕСТЬNULL(ВТ_ПараметрыГрузоперевозок.Параметр, ЕСТЬNULL(ВТ_ПараметрыЗаказов.Параметр, НЕОПРЕДЕЛЕНО)) КАК Параметр,
	|	ЕСТЬNULL(ВТ_ПараметрыГрузоперевозок.Значение, ЕСТЬNULL(ВТ_ПараметрыЗаказов.Значение, НЕОПРЕДЕЛЕНО)) КАК Значение,
	|	ЕСТЬNULL(ВТ_ПараметрыГрузоперевозок.ЗначениеПлан, ЕСТЬNULL(ВТ_ПараметрыЗаказов.ЗначениеПлан, НЕОПРЕДЕЛЕНО)) КАК ЗначениеПлан,
	|	ЕСТЬNULL(ВТ_ПараметрыГрузоперевозок.ЗначениеФакт, ЕСТЬNULL(ВТ_ПараметрыЗаказов.ЗначениеФакт, НЕОПРЕДЕЛЕНО)) КАК ЗначениеФакт
	|ИЗ
	|	ВТ_Грузоперевозки КАК ВТ_Грузоперевозки
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ПараметрыГрузоперевозок КАК ВТ_ПараметрыГрузоперевозок
	|		ПО ВТ_Грузоперевозки.Ссылка = ВТ_ПараметрыГрузоперевозок.Грузоперевозка
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ПараметрыЗаказов КАК ВТ_ПараметрыЗаказов
	|		ПО ВТ_Грузоперевозки.Ссылка.Заказ = ВТ_ПараметрыЗаказов.Заказ";
	
	Запрос.УстановитьПараметр("мГрузоперевозки",	СтруктураПараметров.мГрузоперевозки);
	Запрос.УстановитьПараметр("мЗаказы"	, 			мЗаказы);
	Запрос.УстановитьПараметр("мПараметры", 		мПараметры);
	Запрос.УстановитьПараметр("ЕстьЗаказы", 		мЗаказы.Количество() > 0);
	
	Возврат Запрос.Выполнить().Выбрать(); 
	
КонецФункции

Процедура ОбновитьЗначенияПараметровГрузоперевозкиПоСтроке(СтрокаТабличнойЧасти, СтруктураПараметров) Экспорт
	
	Если СтруктураПараметров.ВыбранныеКолонки.Количество() > 0 Тогда
		
		мГрузопереовзки = Новый Массив;
		мГрузопереовзки.Добавить(СтрокаТабличнойЧасти.Грузоперевозка);
		
		ВыборкаЗначенийДополнительныхКолонок = ПолучитьЗначенияДополнительныхКолонокТаблицы(СтруктураПараметров);
		
		Если  ВыборкаЗначенийДополнительныхКолонок <> Неопределено Тогда
			
			Для Каждого идКолонки из СтруктураПараметров.ВыбранныеКолонки Цикл
				
				СтрокаСоответствия = СтруктураПараметров.СоответствиеПараметров.Получить(идКолонки);
				
				Если СтрокаСоответствия.ЭтоПараметр Тогда
					ОтборВыборки = Новый Структура("Грузоперевозка,Параметр",СтрокаТабличнойЧасти.Грузоперевозка, СтрокаСоответствия.Значение); 
				Иначе
					ОтборВыборки = Новый Структура("Грузоперевозка",СтрокаТабличнойЧасти.Грузоперевозка); 
				КонецЕсли;

				ВыборкаЗначенийДополнительныхКолонок.Сбросить();
				Если ВыборкаЗначенийДополнительныхКолонок.НайтиСледующий(ОтборВыборки) Тогда
					
					Если СтрокаСоответствия.ЭтоПараметр Тогда
						СтрокаТабличнойЧасти["_"+идКолонки] = ВыборкаЗначенийДополнительныхКолонок.Значение;
					Иначе
						СтрокаТабличнойЧасти["_"+идКолонки] = ВыборкаЗначенийДополнительныхКолонок[СтрокаСоответствия.Значение];
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЦикла;  
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти


#Область Подписанты_для_Документов

Функция ПолучитьОтветственныхЛиц(тОрганизация, ПодразделениеОрганизации) Экспорт
	
	//Для версии КОРП
	ВестиУчетПоПодразделениям	= ПолучитьФункциональнуюОпцию("ВестиУчетПоПодразделениям");
	//Для версии КОРП
	
	Запрос = Новый Запрос;
	Запрос.Текст = 	"ВЫБРАТЬ
					|	УполномоченныеЛицаОрганизаций.ЗаКогоПодписывает КАК ЗаКогоПодписывает,
					|	УполномоченныеЛицаОрганизаций.УполномоченноеЛицо КАК УполномоченноеЛицо,
					|	УполномоченныеЛицаОрганизаций.ОснованиеПраваПодписи.Представление КАК НомерДатаПриказа
					|ИЗ
					|	РегистрСведений.УполномоченныеЛицаОрганизаций КАК УполномоченныеЛицаОрганизаций
					|ГДЕ
					|	УполномоченныеЛицаОрганизаций.Организация = &Организация
					|	И УполномоченныеЛицаОрганизаций.Пользователь = &Пользователь
					//Для версии КОРП
					|	И ВЫБОР
					|			КОГДА &ВестиУчетПоПодразделениям
					|				ТОГДА УполномоченныеЛицаОрганизаций.ПодразделениеОрганизации = &ПодразделениеОрганизации
					|			ИНАЧЕ ИСТИНА
					|		КОНЕЦ";
					//Для версии КОРП
	
	Запрос.УстановитьПараметр("Организация"		, тОрганизация);
	Запрос.УстановитьПараметр("Пользователь"	, CW_Настройки.Пользователь()); 
	
	//Для версии КОРП
	Запрос.УстановитьПараметр("ВестиУчетПоПодразделениям"		, ВестиУчетПоПодразделениям);
	Запрос.УстановитьПараметр("ПодразделениеОрганизации"		, ПодразделениеОрганизации);
	//Для версии КОРП
	
	РезультатЗапроса = Запрос.Выполнить();
	
	СоответствиеУполномоченныеЛицаОрганизаций = новый Соответствие;
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		ДанныеПодписанта = Новый Структура("УполномоченноеЛицо,НомерДатаПриказа");
		ЗаполнитьЗначенияСвойств(ДанныеПодписанта, Выборка);
		
		СоответствиеУполномоченныеЛицаОрганизаций.Вставить(Выборка.ЗаКогоПодписывает,ДанныеПодписанта);
	
	КонецЦикла;

	Возврат СоответствиеУполномоченныеЛицаОрганизаций;
	
КонецФункции

#КонецОбласти

#Область Перенаправление_на_другую_форму

Процедура CW_ОбработкаПолученияФормыОбработкаПолученияФормы(Источник, ВидФормы, Параметры, ВыбраннаяФорма, ДополнительнаяИнформация, СтандартнаяОбработка) Экспорт
	
	ИспользованиеВнешнихПодключаемыхФормОбъектов = ПолучитьФункциональнуюОпцию("CW_ИспользованиеВнешнихПодключаемыхФормОбъектов");
	
	Если ИспользованиеВнешнихПодключаемыхФормОбъектов Тогда
		
		ПараметрыПолученияФормы = Новый Структура("Источник,ВидФормы", Источник, ВидФормы);
		НоваяВыбраннаяФорма 	= _ПО.ПолучитьИмяВыбраннойФормы(ПараметрыПолученияФормы);
		
		Если НоваяВыбраннаяФорма <> Неопределено Тогда
			СтандартнаяОбработка 	= Ложь;
			ВыбраннаяФорма 			= НоваяВыбраннаяФорма;
		КонецЕсли;
			
	Конецесли;
	
КонецПроцедуры

#КонецОбласти

Процедура ЗаполнитьПредопределенныеЗначенияРеквизитовШапки(Объект, ТипПеревозки, Назначение = "ДляГрузоперевозки") Экспорт
	
	ПредопределенныеЗначенияРеквизитов = Справочники.CW_ТипыПеревозок.ПолучитьЗначенияПредопределенныхЗначенийРеквизитовШапки(ТипПеревозки, Назначение);
	Для Каждого ЭлементСтруктуры из ПредопределенныеЗначенияРеквизитов Цикл
		Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Объект, ЭлементСтруктуры.Ключ) Тогда
			
			ЗначениеРеквизита = ЭлементСтруктуры.Значение;
			Если ЗначениеЗаполнено(Объект[ЭлементСтруктуры.Ключ]) Тогда
				Если ЗначениеРеквизита.ПерезаполнятьЗначение Тогда
					Объект[ЭлементСтруктуры.Ключ] = ЗначениеРеквизита.Значение;
				КонецЕсли;
			Иначе
				Объект[ЭлементСтруктуры.Ключ] = ЗначениеРеквизита.Значение;
			КонецЕсли;
			
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры


//Наличие прикрепленных файлов
Функция ЗапрашиватьТипФайлаПриДобавленииВАрхив() Экспорт
	
	Возврат Константы.CW_ЗапрашиватьТипФайлаПриДобавленииВАрхив.Получить();
	
КонецФункции

Функция ПолучитьАдресКартинкиФайлов(ОбъектАрхива, УникальныйИдентификатор) Экспорт
	
	ЕстьФайлы 	= Справочники.CW_ОбъектыАрхива.ЕстьПрикрикрепленныеФайлыОбъекта(ОбъектАрхива);
	
	Возврат ПоместитьВоВременноеХранилище(?(ЕстьФайлы,БиблиотекаКартинок.CW_Архив, БиблиотекаКартинок.CW_СерыйПлюс), УникальныйИдентификатор);
	
КонецФункции

Функция ПрикрепитьФайлы(ОбъектАрхива, МассивФайлов, ТипДокумента=Неопределено, Комментарий = Неопределено) Экспорт
	
	ЗначениеВозврата = Истина;
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	ТомаАрхива.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.CW_ТомаАрхива КАК ТомаАрхива
	               |ГДЕ
	               |	ТомаАрхива.Основной = ИСТИНА";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ТомАрхива = Выборка.Ссылка;
	Иначе
		ТомАрхива = ПредопределенноеЗначение("Справочник.CW_ТомаАрхива.ПустаяСсылка");
	КонецЕсли; 
	
	Для каждого СтруктураФайла Из МассивФайлов Цикл
		
		Попытка
			
			НачатьТранзакцию();
			
			ДвоичныеДанныеФайла = ПолучитьИзВременногоХранилища(СтруктураФайла.Хранение);
			РазмерБайт 			= ДвоичныеДанныеФайла.Размер();
			
			// создаем объект архива
			СпрОбъектыАрхива = Справочники.CW_ОбъектыАрхива.СоздатьЭлемент();
			// --- 
			СпрОбъектыАрхива.Владелец 		= ОбъектАрхива;
			СпрОбъектыАрхива.Объект 		= ОбъектАрхива;
			СпрОбъектыАрхива.ИмяФайла 		= СтруктураФайла.Имя;
			СпрОбъектыАрхива.Расширение 	= _сф.ф_РасширениеФайла(СпрОбъектыАрхива.ИмяФайла);
			СпрОбъектыАрхива.Размер 		= РазмерБайт;
			СпрОбъектыАрхива.Наименование 	= СпрОбъектыАрхива.ИмяФайла;
			СпрОбъектыАрхива.Том 			= ТомАрхива;
			СпрОбъектыАрхива.ТипДокумента	= ТипДокумента;  
			СпрОбъектыАрхива.Комментарий	= Комментарий;
			СпрОбъектыАрхива.Записать();
			// --- 
			Ответ = _ФА.ЗагрузитьФайлАрхива(СпрОбъектыАрхива.Ссылка,СтруктураФайла.Хранение);
			Если (_УФКС.ВыполненоУспешно(Ответ)) Тогда
				СпрОбъектыАрхива.ФайлЗагружен = Истина;
				СпрОбъектыАрхива.Записать();
			Иначе
				
				Сообщение = Новый СообщениеПользователю;
				Сообщение.Текст = _УФКС.ПредставлениеОшибки(Ответ);
				Сообщение.Сообщить();
				
				ВызватьИсключение "Ошибка прикрепления файла";
				
			КонецЕсли; 
			
			ЗафиксироватьТранзакцию();
			
		Исключение
			
