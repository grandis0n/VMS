			Значение = СтрЗаменить(Значение,")","");
			Значение = СтрЗаменить(Значение,"-","");
			Значение = СтрЗаменить(Значение," ","");
			Значение = СтрЗаменить(Значение,"<","");
			Значение = СтрЗаменить(Значение,">","");
			Значение = СтрЗаменить(Значение,"/","");
			Значение = СтрЗаменить(Значение,"\","");
			Возврат(Новый Структура("Действие,СтрокаКоманды","ЗапуститьПриложение",ТипКИ.КомандаДействия+Значение));	
			
		Иначе
			
			Возврат(Новый Структура("Действие,СтрокаКоманды","ЗапуститьПриложение",ТипКИ.КомандаДействия+СокрЛП(КИ.Наименование)));	
			
		КонецЕсли; 
		
		
		
	ИначеЕсли (ДействиеКИ = Перечисления.CW_ДействияДляТиповКонтактнойИнформации.Обработчик) Тогда 
		
		// ...
		
	КонецЕсли; 
	
	// --- 
