&НаСервере
	Функция ДобавитьПростоеУсловноеОформление(Элемент, ПолеОтбора, ВидСравненияОтбора=Неопределено, Значение, ОформляемоеПоле, ИмяПараметра, ЗначениеПараметра=Неопределено) Экспорт 
	
	ЭлементУО = Элемент.УсловноеОформление.Элементы.Добавить();
	// --- 
	ОтборУО = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборУО.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ПолеОтбора);
	ОтборУО.ВидСравнения = ?(ВидСравненияОтбора=Неопределено,ВидСравненияКомпоновкиДанных.Равно,ВидСравненияОтбора);
	ОтборУО.ПравоеЗначение = Значение;
	ОтборУО.Использование = Истина;
	// --- 
	Если ЗначениеЗаполнено(ОформляемоеПоле) Тогда 
		ПолеУО = ЭлементУО.Поля.Элементы.Добавить();
		ПолеУО.Поле = Новый ПолеКомпоновкиДанных(ОформляемоеПоле);
		ПолеУО.Использование = Истина;
	КонецЕсли;
	// --- 
	Если ТипЗнч(ИмяПараметра)=Тип("Строка") Тогда
		
		ЭлементУО.Оформление.УстановитьЗначениеПараметра(ИмяПараметра, ЗначениеПараметра);
		
	ИначеЕсли ТипЗнч(ИмяПараметра)=Тип("Структура") Тогда
		
		//ИмяПараметра = Новый Структура;
		Для каждого КлючЗначение Из ИмяПараметра Цикл
			
			ЭлементУО.Оформление.УстановитьЗначениеПараметра(КлючЗначение.Ключ, КлючЗначение.Значение);
			
		КонецЦикла; 
		
	КонецЕсли;
	
	// --- 
	ЭлементУО.Использование = Истина;
	
	Возврат(ЭлементУО);
	
КонецФункции

