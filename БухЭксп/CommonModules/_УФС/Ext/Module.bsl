&НаСервере
Функция ПараметрыОткрытияКонтактнойИнформации(КИ) Экспорт 
	// --- 
	
	ТипКИ = КИ.ВидКИ.ТипКИ;
	ДействиеКИ = ТипКИ.Действие;
	
	Если (ДействиеКИ = Перечисления.CW_ДействияДляТиповКонтактнойИнформации.Нет) Тогда
		
		Возврат(Новый Структура("Действие,ТекстСообщения","ПоказатьПредупреждение","Действие для типа контактной информации не назначено."));
		
	ИначеЕсли (ДействиеКИ = Перечисления.CW_ДействияДляТиповКонтактнойИнформации.НаписатьПисьмо) Тогда 
		
		Возврат(Новый Структура("Действие,СтрокаКоманды","ЗапуститьПриложение","mailto:"+КИ.Наименование));
		
	ИначеЕсли (ДействиеКИ = Перечисления.CW_ДействияДляТиповКонтактнойИнформации.НайтиАдрес) Тогда 
		
		Возврат(Новый Структура("Действие,СтрокаКоманды","ЗапуститьПриложение","http://maps.google.com/maps?q="+СокрЛП(КИ.Наименование)));
		
	ИначеЕсли (ДействиеКИ = Перечисления.CW_ДействияДляТиповКонтактнойИнформации.ОткрытьСсылку) Тогда 
		
		Возврат(Новый Структура("Действие,СтрокаКоманды","ЗапуститьПриложение",КИ.Наименование));
		
	ИначеЕсли (ДействиеКИ = Перечисления.CW_ДействияДляТиповКонтактнойИнформации.КомандаСистемы) Тогда 
		
		Если (Найти(ТипКИ.КомандаДействия,"callto") <> 0) Тогда
			
			Значение = СокрЛП(КИ.Наименование);
