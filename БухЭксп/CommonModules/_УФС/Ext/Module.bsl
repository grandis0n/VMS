// ПРОЦЕДУРЫ СПИСКОВ

&НаСервере
Процедура СоздатьОбвязкуДинамическогоСписка(Форма, ИмяДС, ИмяТаблицыДС) Экспорт 
	// --- 
	
	// инициализируем список и создаём реквизиты формы
	
	// входящий параметр "имя", например "Коносаменты"
	// входящий параметр "таблица", например "Справочник.ОкеанскиеКоносаменты" 
	
	//ИмяДС = "Коносаменты";
	//ИмяТаблицыДС = "Справочник.ОкеанскиеКоносаменты";
		
	// реквизит "_Настройка"
	_Настройка_Коносаменты = Новый Структура;
	_Настройка_Коносаменты.Вставить("ИмяСписка",ИмяДС);
	_Настройка_Коносаменты.Вставить("ИмяТаблицы",ИмяТаблицыДС);
	_Настройка_Коносаменты.Вставить("НастройкаКолонок",_Настройка_Коносаменты.ИмяСписка+"_НастройкаКолонок");
	_Настройка_Коносаменты.Вставить("КолонкиСписка",_Настройка_Коносаменты.ИмяСписка+"_КолонкиСписка");
	_Настройка_Коносаменты.Вставить("СтекОтборов",_Настройка_Коносаменты.ИмяСписка+"_СтекОтборов");
	
	МассивДобавляемыхРеквизитов = Новый Массив;
	
	// --- 
	// реквизит "_Настройка"
	МассивДобавляемыхРеквизитов.Добавить(Новый РеквизитФормы(ИмяДС+"_Настройка",Новый ОписаниеТипов("Строка")));
	
	// --- 
	// реквизит "_НастройкаКолонок" - настройка

	ИмяРеквизита = ИмяДС+"_НастройкаКолонок";
	МассивДобавляемыхРеквизитов.Добавить(Новый РеквизитФормы(ИмяРеквизита,Новый ОписаниеТипов("ТаблицаЗначений")));
	// колонки
	МассивДобавляемыхРеквизитов.Добавить(Новый РеквизитФормы("Имя",Новый ОписаниеТипов("Строка"),ИмяРеквизита));
	МассивДобавляемыхРеквизитов.Добавить(Новый РеквизитФормы("Заголовок",Новый ОписаниеТипов("Строка"),ИмяРеквизита));
	МассивДобавляемыхРеквизитов.Добавить(Новый РеквизитФормы("Тип",Новый ОписаниеТипов("Строка"),ИмяРеквизита));
	МассивДобавляемыхРеквизитов.Добавить(Новый РеквизитФормы("ПрямоеРедактирование",Новый ОписаниеТипов("Булево"),ИмяРеквизита));
	МассивДобавляемыхРеквизитов.Добавить(Новый РеквизитФормы("ГоризонтальноеПоложение",Новый ОписаниеТипов("Строка"),ИмяРеквизита));
	МассивДобавляемыхРеквизитов.Добавить(Новый РеквизитФормы("Видимость",Новый ОписаниеТипов("Булево"),ИмяРеквизита));
	МассивДобавляемыхРеквизитов.Добавить(Новый РеквизитФормы("Ширина",Новый ОписаниеТипов("Число"),ИмяРеквизита));
	МассивДобавляемыхРеквизитов.Добавить(Новый РеквизитФормы("ОтображатьЗаголовок",Новый ОписаниеТипов("Булево"),ИмяРеквизита));
	МассивДобавляемыхРеквизитов.Добавить(Новый РеквизитФормы("Шрифт",Новый ОписаниеТипов("Строка"),ИмяРеквизита));
	МассивДобавляемыхРеквизитов.Добавить(Новый РеквизитФормы("ЦветТекста",Новый ОписаниеТипов("Строка"),ИмяРеквизита));
	МассивДобавляемыхРеквизитов.Добавить(Новый РеквизитФормы("ЦветФона",Новый ОписаниеТипов("Строка"),ИмяРеквизита));
	МассивДобавляемыхРеквизитов.Добавить(Новый РеквизитФормы("ФиксацияВТаблице",Новый ОписаниеТипов("Строка"),ИмяРеквизита));
	
	// --- 
	// реквизит "_КолонкиСписка" - текущие колонки
    МассивДобавляемыхРеквизитов.Добавить(Новый РеквизитФормы(ИмяДС+"_КолонкиСписка",Новый ОписаниеТипов("СписокЗначений")));
	
	// --- 
	// реквизит "_СтекОтборов"
	МассивДобавляемыхРеквизитов.Добавить(Новый РеквизитФормы(ИмяДС+"_СтекОтборов",Новый ОписаниеТипов("ТаблицаЗначений")));
	// колонки
	МассивДобавляемыхРеквизитов.Добавить(Новый РеквизитФормы("Имя",Новый ОписаниеТипов("Строка"),ИмяДС+"_СтекОтборов"));
	МассивДобавляемыхРеквизитов.Добавить(Новый РеквизитФормы("Идентификатор",Новый ОписаниеТипов("Строка"),ИмяДС+"_СтекОтборов"));
	
	// --- 
	// реквизит "РежимРедактированияСписка"
	МассивДобавляемыхРеквизитов.Добавить(Новый РеквизитФормы(ИмяДС+"_РежимРедактированияСписка",Новый ОписаниеТипов("Булево")));	
	// реквизит "РежимОтображенияАрхивных"
	МассивДобавляемыхРеквизитов.Добавить(Новый РеквизитФормы(ИмяДС+"_РежимОтображенияАрхивных",Новый ОписаниеТипов("Булево")));	
	
	// --- 
	Форма.ИзменитьРеквизиты(МассивДобавляемыхРеквизитов);
	
	// ----------------------------------------------------------------------------  
	// заполняем
	
	Форма[ИмяДС+"_Настройка"] = ПоместитьВоВременноеХранилище(_Настройка_Коносаменты,Форма.УникальныйИдентификатор);
	
	// --- 
КонецПроцедуры

&НаСервере
Функция ДобавитьЭлементНастройкиСписка(Список,ПараметрыСписка,Имя,Заголовок=Неопределено,Тип,Видимость=Истина,ПрямоеРедактирование=Ложь,СтруктураПараметров) Экспорт 
	
	// --- 
		
	Нстр = Список.Добавить();
	Нстр.Имя = Имя;
	
	Если Заголовок = Неопределено Тогда
		
		// имя таблицы
		ИмяТаблицы = ПараметрыСписка.ИмяТаблицы;
		ТипТаблицы = _сф.стр_ПолучитьСтроку(ИмяТаблицы,".",1);
		Таблица = _сф.стр_ПолучитьСтроку(ИмяТаблицы,".",2);
		
		Если ТипТаблицы = "Справочник" Тогда
			
			Если Имя = "Наименование" ИЛИ Имя = "Код" Тогда
				
				Синоним = Метаданные.Справочники[Таблица].СтандартныеРеквизиты[Имя].Синоним;
				Нстр.Заголовок = ?(СокрЛП(Синоним)="",Имя,Синоним);
				
			Иначе
				
				Нстр.Заголовок = Метаданные.Справочники[Таблица].Реквизиты[Имя].Синоним;
				
			КонецЕсли; 
			
		ИначеЕсли ТипТаблицы = "Документ" Тогда
			
			Нстр.Заголовок = Метаданные.Документы[Таблица].Реквизиты[Имя].Синоним;
			
		Иначе
			
			Нстр.Заголовок = Заголовок;
			
		КонецЕсли; 
				
	Иначе
		
		Нстр.Заголовок = Заголовок;
		
	КонецЕсли; 
	
	Нстр.Тип = Тип;
	Нстр.Видимость = Видимость;
	Нстр.ПрямоеРедактирование = ПрямоеРедактирование;
	// --- 
	Нстр.ГоризонтальноеПоложение = СтруктураПараметров.ГоризонтальноеПоложение;
	Нстр.Ширина = СтруктураПараметров.Ширина;
	Нстр.ОтображатьЗаголовок = СтруктураПараметров.ОтображатьЗаголовок;
	Нстр.Шрифт = СтруктураПараметров.Шрифт;
	Нстр.ЦветТекста = СтруктураПараметров.ЦветТекста;
	Нстр.ЦветТекста = СтруктураПараметров.ЦветТекста;
	
	Возврат(Нстр);
	
КонецФункции

&НаСервере
Функция ПСПК(Ширина=0,ОтображатьЗаголовок=Истина,ГоризонтальноеПоложениеТекста=Неопределено,Шрифт=Неопределено,ЦветТекста=Неопределено,ЦветФона=Неопределено) Экспорт 
	
	Если ГоризонтальноеПоложениеТекста=Неопределено Тогда
		
		ГоризонтальноеПоложениеТекста = ГоризонтальноеПоложениеЭлемента.Центр;
		
	КонецЕсли; 
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("Ширина",Ширина);
	СтруктураПараметров.Вставить("ОтображатьЗаголовок",ОтображатьЗаголовок);
	СтруктураПараметров.Вставить("ГоризонтальноеПоложение",ГоризонтальноеПоложениеТекста);
	СтруктураПараметров.Вставить("Шрифт",Шрифт);
	СтруктураПараметров.Вставить("ЦветТекста",ЦветТекста);
	СтруктураПараметров.Вставить("ЦветФона",ЦветФона);
	
	Возврат(СтруктураПараметров);
	
КонецФункции

