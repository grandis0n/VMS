// ПРОЦЕДУРЫ ОТБОРОВ И УСЛОВНОГО ОФОРМЛЕНИЯ

&НаСервере
Функция ДобавитьОтбор(Отбор,ИмяПоля,ВидСравнения=Неопределено,Значение) Экспорт 
	
	ОДС = Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОДС.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ИмяПоля);
	ОДС.ВидСравнения = ?(ВидСравнения=Неопределено,ВидСравненияКомпоновкиДанных.Равно,ВидСравнения);
	ОДС.ПравоеЗначение = Значение;
	ОДС.Использование = Истина;
	
	Возврат(ОДС);
	
КонецФункции

&НаСервере
Процедура СкопироватьОтбор(Источник,Получатель, Очищать=Истина) Экспорт 
	
	Если Очищать Тогда
		Получатель.Элементы.Очистить();   
	КонецЕсли;
	
	Для каждого ЭлементОтбора Из Источник.Элементы Цикл
		
		Если ТипЗнч(ЭлементОтбора)=Тип("ГруппаЭлементовОтбораКомпоновкиДанных") Тогда
			
			// создаем группу в получателе и уходим в рекурсию
			
			НГО = Получатель.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
			ЗаполнитьЗначенияСвойств(НГО,ЭлементОтбора);
			
			СкопироватьОтбор(ЭлементОтбора,НГО, Очищать);
			
		КонецЕсли; 
		// --- 
		Если ТипЗнч(ЭлементОтбора)=Тип("ЭлементОтбораКомпоновкиДанных") Тогда
			
			// создаем элемент и заполняем
			НЭО = Получатель.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));			
			ЗаполнитьЗначенияСвойств(НЭО,ЭлементОтбора);
			
		КонецЕсли;  
		
	КонецЦикла; 
	
КонецПроцедуры

&НаСервере
Процедура СкопироватьПорядок(Источник,Получатель) Экспорт 
	// --- 
	
	Получатель.Элементы.Очистить();
	
	Для каждого ЭлементПорядка Из Источник.Элементы Цикл
		
		Если ТипЗнч(ЭлементПорядка)=Тип("ЭлементПорядкаКомпоновкиДанных") Тогда
			
			НЭП = Получатель.Элементы.Добавить(Тип("ЭлементПорядкаКомпоновкиДанных"));
			ЗаполнитьЗначенияСвойств(НЭП,ЭлементПорядка);
			
		КонецЕсли;  
		// --- 		
		Если ТипЗнч(ЭлементПорядка)=Тип("АвтоЭлементПорядкаКомпоновкиДанных") Тогда
			
			НЭП = Получатель.Элементы.Добавить(Тип("АвтоЭлементПорядкаКомпоновкиДанных"));
			ЗаполнитьЗначенияСвойств(НЭП,ЭлементПорядка);
			
		КонецЕсли;  

		
	КонецЦикла; 
	
	// --- 
КонецПроцедуры

&НаСервере
Процедура СкопироватьГруппировку(Источник,Получатель) Экспорт 
	// --- 
	
	Получатель.Элементы.Очистить();
	
	Для каждого эл Из Источник.Элементы Цикл
		
		Если ТипЗнч(эл)=Тип("ПолеГруппировкиКомпоновкиДанных") Тогда
			
			НЭП = Получатель.Элементы.Добавить(ТипЗнч(эл));
			ЗаполнитьЗначенияСвойств(НЭП,эл);
			
		КонецЕсли;  
		
	КонецЦикла; 
	
	// --- 
КонецПроцедуры

