	               |ГДЕ
	               |	Номенклатура.Родитель = &Родитель
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Ссылка";
	// --- 
	Возврат(_сф.ВыполнитьЗапрос(ТекстЗапроса, Новый Структура("Родитель", КУ),Истина,"Ссылка", ПустаяНоменклатура));
	
