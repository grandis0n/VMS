#Область ОригиналыДокументов 

Функция ПодготовитьСтруктуруДляЗаписиналичияОригиналовДокументов(ДанныеДлязаписи) Экспорт
	
	УстанавливатьПризнакНаличия = Константы.CW_УстанавливатьПризнакНаличияОригиналовДляСчетов.Получить();
	
	СтруктураПараметров = Новый Структура("Ссылка,Признак,ДатаВозврата,Организация,Контрагент,Договор,ВедомыйДокумент,ДатаСчета,Счет,Акт",
											ДанныеДлязаписи.Ссылка,
											ДанныеДлязаписи.Признак,
											ДанныеДлязаписи.ДатаВозврата,
											Неопределено,
											Неопределено,
											Неопределено,
											Неопределено,
											Дата(1,1,1),
											ложь,
											ложь);
	
											
	// получим данные документа
	Если ТипЗнч(ДанныеДлязаписи.Ссылка) = Тип("ДокументСсылка.CW_ДоходыПоГрузоперевозке") Тогда
		ПолеСчет 	= "ФормируетсяСчет";
		ПолеАкт 	= "ФормируетсяАкт";
		ИмяТаблицы 	= "CW_ДоходыПоГрузоперевозке";
	Иначе
		ПолеСчет 	= "ПредъявленСчет";
		ПолеАкт 	= "ПредъявленАкт";
		ИмяТаблицы 	= "CW_РасходыПоГрузоперевозке";
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
					|	ТекущийДокумент.Ссылка КАК Ссылка,
					|	ТекущийДокумент.Организация КАК Организация,
					|	ТекущийДокумент.Контрагент КАК Контрагент,
					|	ТекущийДокумент.Договор КАК Договор,
					|	ТекущийДокумент.ВедомыйДокумент КАК ВедомыйДокумент,
					|	ТекущийДокумент.ДатаСчета КАК ДатаСчета,
					|	ТекущийДокумент."+ПолеСчет+" КАК Счет,
					|	ТекущийДокумент."+ПолеАкт+" КАК Акт
					|ИЗ
					|	Документ."+ИмяТаблицы+" КАК ТекущийДокумент
					|ГДЕ
					|	ТекущийДокумент.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", ДанныеДлязаписи.Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(СтруктураПараметров,Выборка);
	КонецЕсли;
	
	Возврат СтруктураПараметров;
	
КонецФункции

Функция ПолучитьПризнакНаличияИДатуВозвратаОригиналов(Документ) Экспорт 
	
	СтруктураДанных = Новый Структура("ОригиналыПредоставлены,ДатаПолучения", Ложь, Дата(1,1,1)); 
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	CW_ПризнакНаличияОригиналовДокументов.ДокументСсылка КАК ДокументСсылка,
	               |	CW_ПризнакНаличияОригиналовДокументов.ОригиналыПредоставлены КАК ОригиналыПредоставлены,
	               |	CW_ПризнакНаличияОригиналовДокументов.ДатаПолучения КАК ДатаПолучения
	               |ИЗ
	               |	РегистрСведений.CW_ПризнакНаличияОригиналовДокументов КАК CW_ПризнакНаличияОригиналовДокументов
	               |ГДЕ
	               |	CW_ПризнакНаличияОригиналовДокументов.ДокументСсылка = &ДокументСсылка";
	
	Запрос.УстановитьПараметр("ДокументСсылка", Документ);

	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(СтруктураДанных,Выборка);
	КонецЕсли;
	
	Возврат СтруктураДанных;
	
КонецФункции

//Функция УстановитьПризнакНаличияиДатуВозвартаОригиналов(СтруктураПараметров) Экспорт 
Функция УстановитьПризнакНаличияИдатуВозвратаОригиналов(СтруктураПараметров) Экспорт 
	
	//Отсутствующие оригиналы документов
	НаборЗаписей = РегистрыСведений.CW_ОтсутствующиеОригиналыДокументов.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Документ.Значение 		= СтруктураПараметров.Ссылка;
	НаборЗаписей.Отбор.Документ.Использование 	= Истина;
	НаборЗаписей.Очистить();
	
	Если НЕ СтруктураПараметров.Признак Тогда
		Запись = НаборЗаписей.Добавить();
		Запись.Документ 	= СтруктураПараметров.Ссылка;
		Запись.Организация 	= СтруктураПараметров.Организация;
		Запись.Контрагент 	= СтруктураПараметров.Контрагент;
		Запись.Договор 		= СтруктураПараметров.Договор;
	КонецЕсли; 
	
	НаборЗаписей.Записать(Истина);
	
	//Признак наличия оригиналов документо
	НаборНаличияОригиналов = РегистрыСведений.CW_ПризнакНаличияОригиналовДокументов.СоздатьНаборЗаписей();
	НаборНаличияОригиналов.Отбор.ДокументСсылка.Установить(СтруктураПараметров.Ссылка);
	НаборНаличияОригиналов.Очистить();
	
	Запись = НаборНаличияОригиналов.Добавить();
	Запись.ДокументСсылка 			= СтруктураПараметров.Ссылка;
	Запись.ОригиналыПредоставлены 	= СтруктураПараметров.Признак;
	Запись.ДатаПолучения 			= СтруктураПараметров.ДатаВозврата;
	НаборНаличияОригиналов.Записать(Истина);
	
	//Запись статусов документов
	НовыйСтатус 		= Неопределено;
	МассивДокументов 	= Новый Массив;

	Если ТипЗнч(СтруктураПараметров.Ссылка) = Тип("ДокументСсылка.CW_ДоходыПоГрузоперевозке") Тогда
		
		Если СтруктураПараметров.Признак Тогда
			НовыйСтатус = Перечисления.СтатусыДокументовРеализации.Подписан;
		Иначе
			НовыйСтатус = Перечисления.СтатусыДокументовРеализации.НеПодписан;
		КонецЕсли; 
		Если ЗначениеЗаполнено(СтруктураПараметров.ВедомыйДокумент) Тогда
			МассивДокументов.Добавить(СтруктураПараметров.ВедомыйДокумент);	
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(СтруктураПараметров.Ссылка) = Тип("ДокументСсылка.CW_РасходыПоГрузоперевозке") Тогда 
		
		Если СтруктураПараметров.Признак Тогда
			НовыйСтатус = Перечисления.СтатусыДокументовПоступления.ОригиналПолучен;
		Иначе
			НовыйСтатус = Перечисления.СтатусыДокументовПоступления.ОригиналНеПолучен;
		КонецЕсли;
		Если ЗначениеЗаполнено(СтруктураПараметров.ВедомыйДокумент) Тогда
			МассивДокументов.Добавить(СтруктураПараметров.ВедомыйДокумент);	
		КонецЕсли;
		
	КонецЕсли; 
	
	Если НовыйСтатус <> Неопределено Тогда
		УстановитьПривилегированныйРежим(Истина);
		
		СтатусыДокумента = РегистрыСведений.СтатусыДокументов.НовыеСтатусыДокумента();
		СтатусыДокумента.Статус            = НовыйСтатус;
		
		РегистрыСведений.СтатусыДокументов.УстановитьСтатусыДокументов(МассивДокументов, СтатусыДокумента);	
		
		УстановитьПривилегированныйРежим(Ложь);
	КонецЕсли; 
	
КонецФункции

