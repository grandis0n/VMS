#Область ПоследниеДоговоры 

Функция ПолучитьПоследнийДоговор(Контрагент, Организация, ВидДоговора) Экспорт 
	
	// Если в настройках пользователя установлено получать последний договор, то пробуем найти его
	// Если в настройках флажок не установлен,либо договор не найден, то всегда проверяем, если у контрагента только один договор, то берём его
	// Иначе возвращаем Неопределено 
	
	НайденныйДоговор = ПредопределенноеЗначение("Справочник.CW_ДоговорыПоГрузоперевозкам.ПустаяСсылка");
	Если ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком Тогда 
		ИмяНастройкиПользователя = "ПодставлятьПоследнийДоговорВЗатратныхДокументах";
	ИначеЕсли ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПокупателем Тогда 
		ИмяНастройкиПользователя = "ПодставлятьПоследнийДоговорВДоходныхДокументах";
	Иначе
		ИмяНастройкиПользователя = "";
	КонецЕсли;
	
	ПолучитьПоследний = Истина;
	Если Не ПустаяСтрока(ИмяНастройкиПользователя) Тогда
		ПолучитьПоследний = CW_Настройки.ПолучитьНастройкуПользователя( , ИмяНастройкиПользователя);
	КонецЕсли;
	
	Если ПолучитьПоследний Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст= "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		              |	CW_ПоследниеИспользованныеДоговоры.Договор КАК Договор
		              |ИЗ
		              |	РегистрСведений.CW_ПоследниеИспользованныеДоговоры КАК CW_ПоследниеИспользованныеДоговоры
		              |ГДЕ
		              |	CW_ПоследниеИспользованныеДоговоры.Контрагент = &Контрагент
		              |	И CW_ПоследниеИспользованныеДоговоры.Организация = &Организация
		              |	И CW_ПоследниеИспользованныеДоговоры.ВидДоговора = &ВидДоговора";
		
		Запрос.УстановитьПараметр("Организация", 	Организация); 
		Запрос.УстановитьПараметр("Контрагент", 	Контрагент);
		Запрос.УстановитьПараметр("ВидДоговора",	ВидДоговора);
		
		РезультатЗапроса = Запрос.Выполнить();
		Выборка = РезультатЗапроса.Выбрать();
		
		Если Выборка.Следующий() Тогда
			НайденныйДоговор = Выборка.Договор;
		КонецЕсли;
		
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(НайденныйДоговор) Тогда
		
		// пробуем установить единственный, если имеется, исключая помеченные на удаление и закрытые
		Запрос = Новый Запрос;
		Запрос.Текст = 	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		               	|	CW_ДоговорыПоГрузоперевозкам.Ссылка КАК Ссылка
		               	|ИЗ
		               	|	Справочник.CW_ДоговорыПоГрузоперевозкам КАК CW_ДоговорыПоГрузоперевозкам
		               	|ГДЕ
		               	|	CW_ДоговорыПоГрузоперевозкам.Владелец = &Владелец
		               	|	И CW_ДоговорыПоГрузоперевозкам.ВидДоговора = &ВидДоговора
		               	|	И НЕ CW_ДоговорыПоГрузоперевозкам.ПометкаУдаления
		               	|	И CW_ДоговорыПоГрузоперевозкам.Организация = &Организация
		               	|	И CW_ДоговорыПоГрузоперевозкам.Закрыт = ЛОЖЬ";
		
		Запрос.УстановитьПараметр("Организация", 	Организация); 
		Запрос.УстановитьПараметр("Владелец", 		Контрагент);
		Запрос.УстановитьПараметр("ВидДоговора", 	ВидДоговора);
		
		РезультатЗапроса = Запрос.Выполнить();
		Выборка = РезультатЗапроса.Выбрать();
		
		Если Выборка.Количество() = 1 Тогда
			Выборка.Следующий();
			НайденныйДоговор = Выборка.Ссылка;
		КонецЕсли;
		
	КонецЕсли; 

	Возврат НайденныйДоговор;
	
КонецФункции 

