#Область ВидФормы 

Процедура ОпределитьВозможностьОткрытияОбъектаМодуля(ТипИсточника=Неопределено, Грузоперевозка=Неопределено, Отказ) Экспорт

	CW_ПроверкаЛицензии.УстановитьОбщиеПараметрыМодуля();

	Если ТипИсточника = Неопределено Тогда  
		//Тип документа не передан
		Возврат;
	КонецЕсли;     
	
	СоответствиеРолей 	= ПолучитьСоответствиеПравГруппыПользователейТипуДокумента();
	ПроверяемаяРоль 	= СоответствиеРолей.Получить(ТипИсточника); 
	Если ПроверяемаяРоль <> Неопределено Тогда
		ПравоДоступно = CW_ПраваДоступа.ПравоДоступно(ПроверяемаяРоль);
		Если Не ПравоДоступно Тогда
			Отказ = Истина;
			ВызватьИсключение "Недостаточно прав для просмотра.";
		КонецЕсли;
	КонецЕсли;
	
	Если ТипИсточника = Тип("СправочникМенеджер.CW_Грузоперевозки") 
		и ТипЗнч(Грузоперевозка) = Тип("СправочникСсылка.CW_Грузоперевозки") Тогда
		ГруппаПользователя = CW_ПраваДоступа_ПИ.ГруппаПользователя(CW_Настройки.Пользователь());	
		Если Не ГруппаПользователя.ПолныеПрава и ГруппаПользователя.ФильтрГрузоперевозок Тогда
			ФильтрГрузоперевозок 	=  ГруппаПользователя.ХранилищеФильтраГрузоперевозок.Получить();
			ПроверкаВыполнена 		= CW_Мониторинг.ВыполнитьПроверкуДополнительногоКонтроля(ФильтрГрузоперевозок, Грузоперевозка);
			Если Не ПроверкаВыполнена Тогда
				Отказ = Истина;
				ВызватьИсключение "Недостаточно прав для просмотра.";
			КонецЕсли;
		КонецЕсли;
	КонецЕсли; 
	
КонецПроцедуры

Функция ПолучитьСоответствиеПравГруппыПользователейТипуДокумента()
	
	СоответствиеРолей = Новый Соответствие;
	СоответствиеРолей.Вставить(Тип("ДокументМенеджер.CW_ДоходыПоГрузоперевозке"), 	"ПросмотрФинансов_Доходы");
	СоответствиеРолей.Вставить(Тип("ДокументМенеджер.CW_РасходыПоГрузоперевозке"), 	"ПросмотрФинансов_Расходы");
	
	СоответствиеРолей.Вставить(Тип("ДокументМенеджер.CW_ЗакрытиеГрузоперевозки"), 	"ПросмотрФинансов");   
	СоответствиеРолей.Вставить(Тип("ДокументМенеджер.CW_ПрайсКонтрагента"), 		"ПросмотрФинансов");
	
	СоответствиеРолей.Вставить(Тип("ДокументМенеджер.CW_КорректировкаОперативнойЗадолженности"), 	"ПросмотрФинансов_ОперативныйУчет");
	СоответствиеРолей.Вставить(Тип("ДокументМенеджер.CW_КорректировкаРаспределенияОплатДляУСН"), 	"ПросмотрФинансов_ОперативныйУчет");
	СоответствиеРолей.Вставить(Тип("ДокументМенеджер.CW_Оплата"), 									"ПросмотрФинансов_ОперативныйУчет");
	СоответствиеРолей.Вставить(Тип("ДокументМенеджер.ПоступлениеНаРасчетныйСчет"), 					"ПросмотрФинансов_ОперативныйУчет");
	СоответствиеРолей.Вставить(Тип("ДокументМенеджер.CW_ДвижениеДенежныхСредств"), 					"ПросмотрФинансов_ОперативныйУчет");
	СоответствиеРолей.Вставить(Тип("ДокументМенеджер.CW_КорректировкаАктированияСчетов"), 			"ПросмотрФинансов_ОперативныйУчет");
	
	Возврат СоответствиеРолей;

КонецФункции  

Процедура ОтображениеКнопокКоманднойПанелиФормыСписка(Форма) Экспорт 
	// --- 
	
	СОК = Новый Соответствие;
	СОК.Вставить("Выбрать", ОтображениеКнопки.Текст);
	СОК.Вставить("Добавить", ОтображениеКнопки.Картинка);
	СОК.Вставить("Скопировать", ОтображениеКнопки.Картинка);
	СОК.Вставить("Изменить", ОтображениеКнопки.Картинка);
	СОК.Вставить("УстановитьПометкуУдаления", ОтображениеКнопки.Картинка);
	// --- 
	СОК.Вставить("УстановитьИнтервал", ОтображениеКнопки.Картинка);
	// --- 
	СОК.Вставить("Найти", ОтображениеКнопки.КартинкаИТекст);
	СОК.Вставить("ОтменитьПоиск", ОтображениеКнопки.Картинка);
	// --- 
	СОК.Вставить("Провести", ОтображениеКнопки.Картинка);
	СОК.Вставить("ОтменаПроведения", ОтображениеКнопки.Картинка);
	СОК.Вставить("ОбщаяКомандаCW_ДвиженияДокумента", ОтображениеКнопки.Картинка);
	// --- 
	СОК.Вставить("НастройкаСписка", ОтображениеКнопки.Картинка);
	СОК.Вставить("ОтборСортировка", ОтображениеКнопки.Картинка);
	СОК.Вставить("ВывестиСписок", ОтображениеКнопки.Картинка);
	// --- 
	СОК.Вставить("Обновить", ОтображениеКнопки.Картинка);
	
	
	Для каждого Элемент Из Форма.Элементы Цикл
		
		Если (ТипЗнч(Элемент) = Тип("КнопкаФормы")) Тогда
			
			Если (Найти(Элемент.Имя,"Форма") <> 0) Тогда
				
				Элемент.ТолькоВоВсехДействиях = Ложь;
				
				ИмяЭлемента = Элемент.Имя;
				ИмяКоманды = СтрЗаменить(ИмяЭлемента,"Форма","");
				
				Отображение = СОК.Получить(ИмяКоманды);
				Если (Отображение <> Неопределено) Тогда
					Элемент.Отображение = Отображение;
				Иначе
					Элемент.Отображение = ОтображениеКнопки.Картинка;
				КонецЕсли; 
				
			КонецЕсли; 
			
		КонецЕсли; 
		
	КонецЦикла; 
	
	// --- 
КонецПроцедуры

