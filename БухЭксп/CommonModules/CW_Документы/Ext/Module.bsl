Функция РабочееВремя() Экспорт
	// --- 
	
	ДатаСтрокой = Формат(ПолучитьРабочуюДату(),"ДФ=yyyyMMdd");
	ВремяСтрокой = Формат(ТекущаяДата(),"ДФ=HHmmss");
	мНоваяДата = Дата(ДатаСтрокой+ВремяСтрокой);
	// --- 
	Возврат(мНоваяДата);
	
	// --- 
