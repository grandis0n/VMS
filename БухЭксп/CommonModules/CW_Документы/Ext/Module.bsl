Функция ПолучитьВедущийДокумент(ВедомыйДокумент) Экспорт 
	// --- 
	
	Если ТипЗнч(ВедомыйДокумент) = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		               |	CW_ДоходыПоГрузоперевозке.Ссылка КАК Ссылка
		               |ИЗ
		               |	Документ.CW_ДоходыПоГрузоперевозке КАК CW_ДоходыПоГрузоперевозке
		               |ГДЕ
		               |	CW_ДоходыПоГрузоперевозке.ВедомыйДокумент = &ВедомыйДокумент";
					   
		Запрос.УстановитьПараметр("ВедомыйДокумент", ВедомыйДокумент);
		ТЗ = Запрос.Выполнить().Выгрузить();
        Если ТЗ.Количество() <> 0 Тогда
			
			Возврат(_сф.к_ПервыйЭлемент(ТЗ).Ссылка);
			
		Иначе
			
			Возврат(Неопределено);
			
		КонецЕсли; 
		
	ИначеЕсли ТипЗнч(ВедомыйДокумент) = Тип("ДокументСсылка.ПоступлениеТоваровУслуг") Тогда 
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	CW_РасходыПоГрузоперевозке.Ссылка
		|ИЗ
		|	Документ.CW_РасходыПоГрузоперевозке КАК CW_РасходыПоГрузоперевозке
		|ГДЕ
		|	CW_РасходыПоГрузоперевозке.ВедомыйДокумент = &ВедомыйДокумент";
		Запрос.УстановитьПараметр("ВедомыйДокумент", ВедомыйДокумент);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			
			Возврат(Выборка.Ссылка);
			
		Иначе
			
			Возврат(Неопределено);
			
		КонецЕсли; 
		
	ИначеЕсли (ТипЗнч(ВедомыйДокумент) = Тип("ДокументСсылка.КорректировкаПоступления")) Тогда 
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		               |	CW_РасходыПоГрузоперевозке.Ссылка
		               |ИЗ
		               |	Документ.CW_РасходыПоГрузоперевозке КАК CW_РасходыПоГрузоперевозке
		               |ГДЕ
		               |	CW_РасходыПоГрузоперевозке.ВедомыйДокументКорректировки = &ВедомыйДокумент";
		Запрос.УстановитьПараметр("ВедомыйДокумент", ВедомыйДокумент);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			
			Возврат(Выборка.Ссылка);
			
		Иначе
			
			Возврат(Неопределено);
			
		КонецЕсли;
		
	ИначеЕсли (ТипЗнч(ВедомыйДокумент) = Тип("ДокументСсылка.КорректировкаРеализации")) Тогда 
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		               |	CW_ДоходыПоГрузоперевозке.Ссылка
		               |ИЗ
		               |	Документ.CW_ДоходыПоГрузоперевозке КАК CW_ДоходыПоГрузоперевозке
		               |ГДЕ
		               |	CW_ДоходыПоГрузоперевозке.ВедомыйДокументКорректировки = &ВедомыйДокумент";
		Запрос.УстановитьПараметр("ВедомыйДокумент", ВедомыйДокумент);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			
			Возврат(Выборка.Ссылка);
			
		Иначе
			
			Возврат(Неопределено);
			
		КонецЕсли;
		
	Иначе
		
		Возврат(Неопределено);
		
	КонецЕсли; 
		
	// --- 
КонецФункции

