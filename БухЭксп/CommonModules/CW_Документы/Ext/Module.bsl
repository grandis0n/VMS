#Область НомераДокументов 

Функция ПроверкаНомера(Документ, РежимЗаписи, ВедущийДокумент ,Отказ) Экспорт
	
	Попытка
		Документ.Записать(РежимЗаписи); 
	Исключение
		
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Не удалось записать документ """+Строка(Документ)+""". По причине: "+ ОписаниеОшибки();
		Сообщение.Сообщить();
		
		Если (НЕ ТранзакцияАктивна()) Тогда
			ОтменитьТранзакцию();
		КонецЕсли; 
		
		Отказ = Истина;
	КонецПопытки;
	
	Возврат(Отказ);
КонецФункции

