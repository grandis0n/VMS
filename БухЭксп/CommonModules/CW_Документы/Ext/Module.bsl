#Область СрокиОплаты

Функция ПолучитьПланОплаты(Документ) Экспорт 
	
	Ответ = Новый Структура("Дата,Примечание",Неопределено,Неопределено);
	
	СоответствиеИмяТаблицы = ПолучитьСоответствиеИмениРегистраТипуДокумента();
	
	ИмяТаблицы = СоответствиеИмяТаблицы.Получить(ТипЗнч(Документ));
	Если ИмяТаблицы = Неопределено Тогда
		Возврат Ответ;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	CW_ПланОплаты.ПлановаяДата КАК ПлановаяДата,
	               |	CW_ПланОплаты.Описание КАК Описание
	               |ИЗ
	               |	РегистрСведений."+ИмяТаблицы+" КАК CW_ПланОплаты
	               |ГДЕ
	               |	CW_ПланОплаты.Счет = &Счет";
	
	Запрос.УстановитьПараметр("Счет", Документ); 
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	Если Выборка.Следующий() Тогда
		Ответ.Дата 			= Выборка.ПлановаяДата;
		Ответ.Примечание 	= Выборка.Описание;
	КонецЕсли;
	
	Возврат Ответ;
	
КонецФункции  

&НаСервере
Функция ПолучитьСоответствиеИмениРегистраТипуДокумента()
	
	Соответствие = новый Соответствие;
	
	Соответствие.Вставить(Тип("ДокументСсылка.CW_РасходыПоГрузоперевозке"), "CW_ПланОплатыВходящихСчетов");
	Соответствие.Вставить(Тип("ДокументСсылка.CW_РасходыПоПриобретениям"),  "CW_ПланОплатыВходящихСчетов");
	
	Соответствие.Вставить(Тип("ДокументСсылка.CW_ДоходыПоГрузоперевозке"),  	 "CW_ПланОплатыИсходящихСчетов");
	Соответствие.Вставить(Тип("ДокументСсылка.CW_РеализацияПрочихТоваровУслуг"), "CW_ПланОплатыИсходящихСчетов");
	
	Возврат Соответствие;
	
КонецФункции


Функция ПолучитьСрокОплаты(Документ) Экспорт 
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	CW_СрокиОплатыСчетов.ДатаОплаты КАК ДатаОплаты,
	               |	CW_СрокиОплатыСчетов.Описание КАК Описание,
	               |	CW_СрокиОплатыСчетов.РучноеРедактирование КАК РучноеРедактирование
	               |ИЗ
	               |	РегистрСведений.CW_СрокиОплатыСчетов КАК CW_СрокиОплатыСчетов
	               |ГДЕ
	               |	CW_СрокиОплатыСчетов.Счет = &Счет";
	
	Запрос.УстановитьПараметр("Счет", Документ);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Ответ 	= Новый Структура("ДатаОплаты,Описание,РучноеРедактирование",Дата(1,1,1),"",Ложь);
	
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(Ответ, Выборка);
	КонецЕсли;
	
	Возврат(Ответ);
	
КонецФункции  

Функция УстановитьСрокОплаты(ДанныеДляЗаписи) Экспорт
	
	НаборЗаписей = РегистрыСведений.CW_СрокиОплатыСчетов.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Счет.Установить(ДанныеДляЗаписи.Счет);
	НаборЗаписей.Записать(Истина);
	
	Если ЗначениеЗаполнено(ДанныеДляЗаписи.ДатаОплаты) Или ЗначениеЗаполнено(ДанныеДляЗаписи.Описание) Тогда
		
		Запись 				= НаборЗаписей.Добавить();
		ЗаполнитьЗначенияСвойств(Запись,ДанныеДляЗаписи);
		
		Попытка
		
			НаборЗаписей.Записать(Истина);
		
		Исключение
			
			Возврат(_УФКС.Ответ(1,ОписаниеОшибки()));
		
		КонецПопытки; 
		
	КонецЕсли;
	
	// ---  
	ИспользоватьПланирование = Ложь;
	Если ТипЗнч(ДанныеДляЗаписи.Счет) = Тип("ДокументСсылка.CW_ДоходыПоГрузоперевозке")
		ИЛИ  ТипЗнч(ДанныеДляЗаписи.Счет) = Тип("ДокументСсылка.CW_РеализацияПрочихТоваровУслуг") Тогда
		
		ИспользоватьПланирование = ПолучитьФункциональнуюОпцию("ИспользоватьПланированиеПлатежейОтПокупателей");

	ИначеЕсли ТипЗнч(ДанныеДляЗаписи.Счет) = Тип("ДокументСсылка.CW_РасходыПоГрузоперевозке")
		ИЛИ  ТипЗнч(ДанныеДляЗаписи.Счет) = Тип("ДокументСсылка.CW_РасходыПоПриобретениям") Тогда 
		
		ИспользоватьПланирование = ПолучитьФункциональнуюОпцию("ИспользоватьПланированиеПлатежейПоставщикам");
		
	КонецЕсли;
	
	Если ИспользоватьПланирование Тогда
		// дублируем срок оплаты через стандартный механизм БП
		СрокиОплатыДокументов.ЗаписатьСрокОплатыДокумента(ДанныеДляЗаписи.Счет.ВедомыйСчет, ДанныеДляЗаписи.ДатаОплаты);
	КонецЕсли;
	
	// --- 

	Возврат(_УФКС.Ответ());

КонецФункции // УстановитьСрокОплаты(СтруктураДанных)()

//Функция РассчитатьСрокОплаты(СтруктураПараметров) Экспорт
//
// Возвращает рассчитаннй срок оплаты по документу
//
// Параметры:
//  СтруктураПараметров - Структура;
//	
// Заполнение параметра "СтруктураПараметров" выполянется в функции
// ПодготовитьДанныеДляРасчетаСрокаОплаты() текущего общего модуля.
//
Функция РассчитатьСрокОплаты(СтруктураПараметров) Экспорт
	
	ДатаСтарта	= Дата(1,1,1);
	ДатаОплаты	= Дата(1,1,1);

	ПорядокРасчета 				= ПредопределенноеЗначение("Перечисление.CW_ПорядокРасчетаДляУсловияОплаты.ОтсрочкаОтДатыСчета");
	ПроизводственныйКалендарь 	= ПредопределенноеЗначение("Справочник.ПроизводственныеКалендари.ПустаяСсылка");
	СпособРасчетаОтсрочки 		= 0;
	ВариантПереносаДаты			= 0;
	Отказ						= Ложь;
	
	Если Не ЗначениеЗаполнено(СтруктураПараметров.Договор) 
		ИЛИ Не ЗначениеЗаполнено(СтруктураПараметров.Ссылка) Тогда
		Возврат ДатаСтарта;
	КонецЕсли;
	
	ПолучаемыеПараметры = "УсловияОплаты;КоличествоДнейПросрочки";
	ПараметрыДоговора 	= CW_Настройки.ПолучитьПараметрыДоговора(СтруктураПараметров,ПолучаемыеПараметры);
	
	Если Не ЗначениеЗаполнено(ПараметрыДоговора.УсловияОплаты) Тогда
		Возврат Дата(1,1,1);
	КонецЕсли;
	
	Если Не СтруктураПараметров.ЕстьСчет 
		И (ПараметрыДоговора.ПорядокРасчета = ПредопределенноеЗначение("Перечисление.CW_ПорядокРасчетаДляУсловияОплаты.ОтсрочкаОтДатыСчета") 
			ИЛИ ПараметрыДоговора.ПорядокРасчета = ПредопределенноеЗначение("Перечисление.CW_ПорядокРасчетаДляУсловияОплаты.ОтсрочкаОтДатыПолученияПередачиСчета"))	Тогда
		Возврат ДатаСтарта;
	КонецЕсли;
	
	Если Не СтруктураПараметров.ЕстьАкт И ПараметрыДоговора.ПорядокРасчета = ПредопределенноеЗначение("Перечисление.CW_ПорядокРасчетаДляУсловияОплаты.ОтсрочкаОтДатыВозвратаАкта") Тогда
		Возврат ДатаСтарта;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПараметрыДоговора.УсловияОплаты) Тогда
		ПорядокРасчета 				= ПараметрыДоговора.ПорядокРасчета;
		СпособРасчетаОтсрочки 		= ПараметрыДоговора.СпособРасчетаОтсрочки;
		ПроизводственныйКалендарь 	= ПараметрыДоговора.ПроизводственныйКалендарь;
		ВариантПереносаДаты 		= ПараметрыДоговора.ВариантПереносаДаты;
	КонецЕсли;
	
	Если ПорядокРасчета = ПредопределенноеЗначение("Перечисление.CW_ПорядокРасчетаДляУсловияОплаты.ПодключаемаяОбработка") Тогда 
		ПодключаемыйОбъект 	= ПараметрыДоговора.ПодключаемаяОбработка;
		
		Если ЗначениеЗаполнено(ПодключаемыйОбъект) Тогда
			
			Обработка = _ПО.ПолучитьОбработку(ПодключаемыйОбъект);
			
			Попытка
				
				Обработка.СсылкаНаОбъект 	= СтруктураПараметров.Ссылка;
				Результат					= Обработка.ВыполнитьКоманду(Новый Структура("ПодключаемыйОбъект",ПодключаемыйОбъект));
				
				Ошибка = Ложь;
				Результат.Свойство("Ошибка", Ошибка);
				Ошибка = ?(Ошибка=Неопределено, ложь, Ошибка);
				
				Если Ошибка Тогда
					ТекстСообщения =  "Не удалось рассчитать срок оплаты для <" + СтруктураПараметров.Ссылка + ">: " + Результат.ОписаниеОшибки;
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,,,Отказ);
				КонецЕсли;
				
				Если НЕ Отказ Тогда
					Результат.Свойство("ДатаОплаты", ДатаОплаты);
					ДатаОплаты = ?(ДатаОплаты=Неопределено, Дата(1,1,1), ДатаОплаты);
				КонецЕсли;
				
			Исключение
				ТекстСообщения =  "Не удалось рассчитать срок оплаты для <" + СтруктураПараметров.Ссылка + ">: " + Результат.ОписаниеОшибки;
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			КонецПопытки; 
			
		КонецЕсли; 
		
		Возврат ДатаОплаты;
		
	КонецЕсли; 
		
	Если СтруктураПараметров.ЕстьСчет Тогда
		Если ПорядокРасчета = ПредопределенноеЗначение("Перечисление.CW_ПорядокРасчетаДляУсловияОплаты.ОтсрочкаОтДатыСчета") Тогда
			ДатаСтарта = ?(ЗначениеЗаполнено(СтруктураПараметров.ДатаСчета),СтруктураПараметров.ДатаСчета, СтруктураПараметров.Дата);
		КонецЕсли;
		Если ПорядокРасчета = ПредопределенноеЗначение("Перечисление.CW_ПорядокРасчетаДляУсловияОплаты.ОтсрочкаОтДатыПолученияПередачиСчета") Тогда
			СтруктураДанных	= ПолучитьПризнакНаличияИДатуВозвратаОригиналов(СтруктураПараметров.Ссылка);
			ДатаСтарта		= СтруктураДанных.ДатаПолучения;
		КонецЕсли;
	КонецЕсли;
		
	Если СтруктураПараметров.ЕстьАкт И ПорядокРасчета = ПредопределенноеЗначение("Перечисление.CW_ПорядокРасчетаДляУсловияОплаты.ОтсрочкаОтДатыВозвратаАкта") Тогда
		СтруктураДанных	= ПолучитьПризнакНаличияИДатуВозвратаОригиналов(СтруктураПараметров.Ссылка);
		ДатаСтарта		= СтруктураДанных.ДатаПолучения;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДатаСтарта) Тогда
		Если СпособРасчетаОтсрочки = 0 Тогда
			//по календраным дням
			Если ВариантПереносаДаты = 0 Тогда
				ДатаОплаты = ДатаСтарта + 24*3600 * ПараметрыДоговора.КоличествоДнейПросрочки;
			Иначе
				ДатаОплаты = ПолучитьДатуПоКоличествуРабочихДней(ДатаСтарта, ПроизводственныйКалендарь, ПараметрыДоговора.КоличествоДнейПросрочки, СпособРасчетаОтсрочки, ВариантПереносаДаты);
			КонецЕсли;
		Иначе
			//По рабочим дням
			ДатаОплаты = ПолучитьДатуПоКоличествуРабочихДней(ДатаСтарта, ПроизводственныйКалендарь, ПараметрыДоговора.КоличествоДнейПросрочки, СпособРасчетаОтсрочки, ВариантПереносаДаты);
		КонецЕсли;
	КонецЕсли;
	
	Возврат ДатаОплаты;
	
КонецФункции // РассчитатьСрокОплаты()

Функция ПолучитьДатуПоКоличествуРабочихДней(ДатаСтарта, ПроизводственныйКалендарь, КоличествоДней, СпособРасчетаОтсрочки, ВариантПереносаДаты)
	
	КоличествоДней = ?(	КоличествоДней = 0, 1,	КоличествоДней);
	
	мВидыДней = Новый Массив;
	мВидыДней.Добавить(ПредопределенноеЗначение("Перечисление.ВидыДнейПроизводственногоКалендаря.Рабочий"));
	мВидыДней.Добавить(ПредопределенноеЗначение("Перечисление.ВидыДнейПроизводственногоКалендаря.Предпраздничный"));
	
	Запрос = Новый Запрос;
	
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ "+Формат(КоличествоДней,"ЧГ=0")+"
	|	ДанныеПроизводственногоКалендаря.Дата КАК Дата,
	|	ДанныеПроизводственногоКалендаря.ВидДня КАК ВидДня
	|ПОМЕСТИТЬ ВТ_ДниОтсрочки
	|ИЗ
	|	РегистрСведений.ДанныеПроизводственногоКалендаря КАК ДанныеПроизводственногоКалендаря
	|ГДЕ
	|	ДанныеПроизводственногоКалендаря.ПроизводственныйКалендарь = &ПроизводственныйКалендарь
	|	//УсловиеВидыДней
	|	И ДанныеПроизводственногоКалендаря.Дата > &ДатаСтарта
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата";
	
	Запрос.УстановитьПараметр("ДатаСтарта", НачалоДня(ДатаСтарта));
	Запрос.УстановитьПараметр("мВидыДней", 	мВидыДней);
	Запрос.УстановитьПараметр("ПроизводственныйКалендарь", ПроизводственныйКалендарь);
	
	Если СпособРасчетаОтсрочки = 1 Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "//УсловиеВидыДней", "И ДанныеПроизводственногоКалендаря.ВидДня В(&мВидыДней)");	
	КонецЕсли;
	
	Запрос.Выполнить();
	
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	|	ВТ_ДниОтсрочки.Дата КАК Дата,
	|  ВТ_ДниОтсрочки.ВидДня КАК ВидДня
	|ИЗ
	|	ВТ_ДниОтсрочки КАК ВТ_ДниОтсрочки
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата УБЫВ";
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	Если Выборка.Следующий() Тогда
		ДатаСтарта 		= Выборка.Дата;
		ТекущийВидДня 	= Выборка.ВидДня;
	КонецЕсли;
	
	Если СпособРасчетаОтсрочки = 1 Тогда
		Возврат ДатаСтарта;
	КонецЕсли;
	
	Если СпособРасчетаОтсрочки = 0 Тогда
		//по календарным дням с переносм дней
		
		Если ВариантПереносаДаты = 1 Тогда
			
			Если мВидыДней.Найти(ТекущийВидДня) <> Неопределено Тогда
				//уже ваыпало на рабочий день
				Возврат ДатаСтарта;
			КонецЕсли;
			
			//На следующий рабочий день
			Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
			|	ДанныеПроизводственногоКалендаря.Дата КАК Дата
			|ИЗ
			|	РегистрСведений.ДанныеПроизводственногоКалендаря КАК ДанныеПроизводственногоКалендаря
			|ГДЕ
			|	ДанныеПроизводственногоКалендаря.Дата > &НоваяДатаСтарта
			|	И ДанныеПроизводственногоКалендаря.ВидДня В(&мВидыДней)
			|	И ДанныеПроизводственногоКалендаря.ПроизводственныйКалендарь = &ПроизводственныйКалендарь
			|
			|УПОРЯДОЧИТЬ ПО
			|	Дата";
			
			Запрос.УстановитьПараметр("НоваяДатаСтарта", НачалоДня(ДатаСтарта));
			
			РезультатЗапроса = Запрос.Выполнить();
			Выборка = РезультатЗапроса.Выбрать();
			
			Если Выборка.Следующий() Тогда
				Возврат Выборка.Дата;
			КонецЕсли;
			
		КонецЕсли;
		
		Если ВариантПереносаДаты = 2 Тогда
			//На предыдущий рабочий день
			
			Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
			|	ВТ_ДниОтсрочки.Дата КАК Дата
			|ИЗ
			|	ВТ_ДниОтсрочки КАК ВТ_ДниОтсрочки
			|ГДЕ
			|	ВТ_ДниОтсрочки.ВидДня В (&мВидыДней)
			|
			|УПОРЯДОЧИТЬ ПО
			|	Дата УБЫВ";
			
			РезультатЗапроса = Запрос.Выполнить();
			Выборка = РезультатЗапроса.Выбрать();
			
			Если Выборка.Следующий() Тогда
				Возврат Выборка.Дата;
			КонецЕсли;
		КонецЕсли;
		
		
	КонецЕсли;
	
	Возврат ДатаСтарта;
	
КонецФункции

//Функция ПодготовитьДанныеДляРасчетаСрокаОплаты(Объект) Экспорт
//
// Возвращает структуру с данными необходимыми для расчета срока оплаты по
// в соответсвии с условиями договора;
//
// Параметры:
//		Объект - объект формы из которой выполянеся вызов
//
Функция ПодготовитьДанныеДляРасчетаСрокаОплаты(Объект) Экспорт
	
	ДоходыРасходы = ТипЗнч(Объект.Ссылка)= Тип("ДокументСсылка.CW_ДоходыПоГрузоперевозке")
					ИЛИ ТипЗнч(Объект.Ссылка)= Тип("ДокументСсылка.CW_РеализацияПрочихТоваровУслуг");
	
	СтруктураВозврата = Новый Структура;
	СтруктураВозврата.Вставить("Ссылка"		, Объект.Ссылка);
	СтруктураВозврата.Вставить("Дата"		, Объект.Дата);
	СтруктураВозврата.Вставить("Договор"	, Объект.Договор);
	
	Если ОбщегоНазначения.ЕстьРеквизитОбъекта("ПриложениеКДоговору", Объект.Ссылка.Метаданные()) Тогда
		СтруктураВозврата.Вставить("ПриложениеКДоговору" , Объект.ПриложениеКДоговору);
	КонецЕсли;
	
	СтруктураВозврата.Вставить("ДатаСчета"	, Объект.ДатаСчета);
	СтруктураВозврата.Вставить("ЕстьСчет"	, ?(ДоходыРасходы, Объект.ФормируетсяСчет, 	Объект.ПредъявленСчет));
	СтруктураВозврата.Вставить("ЕстьАкт"	, ?(ДоходыРасходы, Объект.ФормируетсяАкт,	Объект.ПредъявленАкт));
	
	Возврат СтруктураВозврата;
	
КонецФункции

#КонецОбласти 

#Область Последовательности 

Процедура ПеренестиПризнакВосстановленияПоследовательности(ОбъектИсточник,ОбъектПриемник) Экспорт 
	// --- 
	
	ТекущийПризнак = _сф.ст_ПолучитьСвойство(ОбъектИсточник.ДополнительныеСвойства,"ПроведенВХронологическойПоследовательности");
	Если (ТекущийПризнак <> Неопределено) Тогда
		Если (ТекущийПризнак = Истина) Тогда
			_сф.ст_УстановитьСвойство(ОбъектПриемник.ДополнительныеСвойства,"ПроведенВХронологическойПоследовательности",ТекущийПризнак);		
		КонецЕсли; 
	КонецЕсли; 
	
	// --- 
КонецПроцедуры

#КонецОбласти

#Область КоличествоВтабличнуюЧасть

//Функция ПолучитьПараметрДляПодстановкиЗначенияВКоличество() Экспорт
//
// Получение парамтера грузоперевозки для подстановки его значения в поле "Количество" 
//  документов ДОходы по грузоперевозкам и Расходы по грузопереовзкам
//
// Параметры функции
// 	СтруктураПараметров - струкутура парамтродя для подстанвоки в запрос.
//
// Поля стуркутры:
// 		ТипПеревозки,Номенклатура,ЕдиницаИзмерения
//
Функция ПолучитьПараметрДляПодстановкиЗначенияВКоличество(СтруктураПараметров) Экспорт
	
	//Проерим наличие даныне в регистре
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	CW_НастройкаПолученияКоличестваИзПараметровГрузоперевозки.ТипПеревозки КАК ТипПеревозки,
		|	CW_НастройкаПолученияКоличестваИзПараметровГрузоперевозки.Номенклатура КАК Номенклатура,
		|	CW_НастройкаПолученияКоличестваИзПараметровГрузоперевозки.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
		|	CW_НастройкаПолученияКоличестваИзПараметровГрузоперевозки.ПараметрГрузоперевозки КАК ПараметрГрузоперевозки
		|ИЗ
		|	РегистрСведений.CW_НастройкаПолученияКоличестваИзПараметровГрузоперевозки КАК CW_НастройкаПолученияКоличестваИзПараметровГрузоперевозки";
	
	РезультатЗапроса = Запрос.Выполнить();

	Если РезультатЗапроса.Пустой() тогда
		Возврат Неопределено;
	КонецЕсли;
	
	СписокНоменклатуры = Новый Массив;
	СписокНоменклатуры.Добавить(СтруктураПараметров.Номенклатура);   
	
	
	МассивТипПеревозки = Новый Массив;
	МассивТипПеревозки.Добавить(Справочники.CW_ТипыПеревозок.ПустаяСсылка());
	МассивТипПеревозки.Добавить(СтруктураПараметров.ТипПеревозки);
	
	МассивЕдиницаИзмерения = Новый Массив;
	МассивЕдиницаИзмерения.Добавить(Справочники.КлассификаторЕдиницИзмерения.ПустаяСсылка());
	МассивЕдиницаИзмерения.Добавить(СтруктураПараметров.ЕдиницаИзмерения);
	
	//Проерим наличие групп номеклатуры в регистре
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	CW_НастройкаПолученияКоличестваИзПараметровГрузоперевозки.Номенклатура КАК Номенклатура
		|ИЗ
		|	РегистрСведений.CW_НастройкаПолученияКоличестваИзПараметровГрузоперевозки КАК CW_НастройкаПолученияКоличестваИзПараметровГрузоперевозки
		|ГДЕ
		|	CW_НастройкаПолученияКоличестваИзПараметровГрузоперевозки.Номенклатура.ЭтоГруппа";
	
	РезультатЗапроса = Запрос.Выполнить();

	ЕстьГруппыНоменгклатуры = Не РезультатЗапроса.Пустой(); 
	
	ТаблицаИерархии = Новый ТаблицаЗначений;
	ТаблицаИерархии.Колонки.Добавить("Элемент"	,	Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТаблицаИерархии.Колонки.Добавить("Родитель"	,	Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТаблицаИерархии.Колонки.Добавить("Уровень"	,	ОбщегоНазначения.ОписаниеТипаЧисло(10, 0));
	
	//Подготовка данных для формирвоания запроса
	Если ЕстьГруппыНоменгклатуры Тогда
		
		СоответствиеЭлементовИГрупп = ОбщегоНазначенияБПВызовСервера.ПолучитьСписокВышеСтоящихГруппЭлементов(СписокНоменклатуры);
		
		Для каждого Номенклатура Из СписокНоменклатуры Цикл
			
			НоваяСтрока = ТаблицаИерархии.Добавить();
			НоваяСтрока.Элемент		= Номенклатура;
			
			НоваяСтрока = ТаблицаИерархии.Добавить();
			НоваяСтрока.Элемент		= Номенклатура;
			НоваяСтрока.Родитель	= Номенклатура;
			
			СписокГрупп = СоответствиеЭлементовИГрупп.Получить(Номенклатура);
			Если СписокГрупп = Неопределено Тогда
				НоваяСтрока.Уровень = 1;
				Продолжить;
			КонецЕсли;
			
			КоличествоВышеСтоящихГрупп = СписокГрупп.Количество();
			
			НоваяСтрока.Уровень = КоличествоВышеСтоящихГрупп + 1;
			
			Для Индекс = 1 По КоличествоВышеСтоящихГрупп Цикл
				НоваяСтрока = ТаблицаИерархии.Добавить();
				НоваяСтрока.Элемент	= Номенклатура;
				НоваяСтрока.Родитель= СписокГрупп[Индекс - 1];
				НоваяСтрока.Уровень	= КоличествоВышеСтоящихГрупп - Индекс + 1;
			КонецЦикла;
			
		КонецЦикла;
		
	Иначе
		
		Для каждого Номенклатура Из СписокНоменклатуры Цикл
			
			ВидНоменклатуры = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Номенклатура,	"ВидНоменклатуры");
			
			НоваяСтрока = ТаблицаИерархии.Добавить();
			НоваяСтрока.Элемент		= Номенклатура;
			
			НоваяСтрока = ТаблицаИерархии.Добавить();
			НоваяСтрока.Элемент		= Номенклатура;
			НоваяСтрока.Родитель	= Номенклатура;
			НоваяСтрока.Уровень = 1;
			
		КонецЦикла;
		
	КонецЕсли;
	
	НоваяСтрока = ТаблицаИерархии.Добавить();	// Корень

	МассивНоменклатуры = ОбщегоНазначения.ВыгрузитьКолонку(ТаблицаИерархии, "Родитель", Истина);
	
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("МассивТипПеревозки"		,	МассивТипПеревозки);
	Запрос.УстановитьПараметр("МассивЕдиницаИзмерения"	,	МассивЕдиницаИзмерения);
	Запрос.УстановитьПараметр("МассивНоменклатуры"		,	МассивНоменклатуры);
	Запрос.УстановитьПараметр("ТаблицаИерархии"			,	ТаблицаИерархии);
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	ТаблицаИерархии.Элемент КАК Элемент,
	               |	ТаблицаИерархии.Родитель КАК Родитель,
	               |	ТаблицаИерархии.Уровень КАК Уровень
	               |ПОМЕСТИТЬ ВТТаблицаИерархии
	               |ИЗ
	               |	&ТаблицаИерархии КАК ТаблицаИерархии
	               |
	               |ИНДЕКСИРОВАТЬ ПО
	               |	Родитель
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ТаблицаИерархии.Элемент КАК Элемент,
	               |	ТаблицаИерархии.Родитель КАК Родитель,
	               |	ТаблицаИерархии.Уровень КАК Уровень
	               |ПОМЕСТИТЬ ВТТаблицаИерархииСВидами
	               |ИЗ
	               |	ВТТаблицаИерархии КАК ТаблицаИерархии
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Номенклатура
	               |		ПО ТаблицаИерархии.Элемент = Номенклатура.Ссылка
	               |
	               |ИНДЕКСИРОВАТЬ ПО
	               |	Родитель
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ТаблицаИерархии.Элемент КАК Номенклатура,
	               |	ТаблицаИерархии.Родитель КАК Родитель,
	               |	CW_НастройкаПолученияКоличестваИзПараметровГрузоперевозки.ТипПеревозки КАК ТипПеревозки,
	               |	CW_НастройкаПолученияКоличестваИзПараметровГрузоперевозки.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	               |	ТаблицаИерархии.Уровень КАК Уровень,
	               |	CW_НастройкаПолученияКоличестваИзПараметровГрузоперевозки.ПараметрГрузоперевозки КАК ПараметрГрузоперевозки
	               |ИЗ
	               |	ВТТаблицаИерархииСВидами КАК ТаблицаИерархии
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.CW_НастройкаПолученияКоличестваИзПараметровГрузоперевозки КАК CW_НастройкаПолученияКоличестваИзПараметровГрузоперевозки
	               |		ПО ТаблицаИерархии.Родитель = CW_НастройкаПолученияКоличестваИзПараметровГрузоперевозки.Номенклатура
	               |ГДЕ
	               |	CW_НастройкаПолученияКоличестваИзПараметровГрузоперевозки.Номенклатура В(&МассивНоменклатуры)
	               |	И CW_НастройкаПолученияКоличестваИзПараметровГрузоперевозки.ТипПеревозки В(&МассивТипПеревозки)
	               |	И CW_НастройкаПолученияКоличестваИзПараметровГрузоперевозки.ЕдиницаИзмерения В(&МассивЕдиницаИзмерения)
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Уровень УБЫВ,
	               |	ТипПеревозки УБЫВ,
	               |	Номенклатура УБЫВ,
	               |	ЕдиницаИзмерения УБЫВ";
			
	РезультатЗапроса = Запрос.Выполнить();
	
	Если Не РезультатЗапроса.Пустой() Тогда
		
		Выборка = РезультатЗапроса.Выбрать();
		
		Если Выборка.Следующий() Тогда
			Возврат Выборка.ПараметрГрузоперевозки;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

#КонецОбласти

#Область Контроль_Услуг_По_Протоколу

//ПроверитьСоответствиеУслугПоДоговору(МассивУслугДоговора, ТаблицаУслуг, Отказ)
//	Вызывается из документов "Доходы по грузоперевозке" и "расходы по груопереовзке" перед их записью
//
//	Контроль услуг по документу на соответствие протоколу согласования цен.
//
//	Параметры:
// 		МассивУслугДоговора - массив услуг по протоколу согласоавния цен;
// 		ТаблицаУслуг 		- Таблица "Услуги" проверяемого документа;
//		Отказ				- в случае сли какая либо услуга документа 
//							отсутствует в масиве услуг, в параметр передается ИСТИНА
//
Процедура ПроверитьСоответствиеУслугПоДоговору(МассивУслугДоговора, МассивУслугиДокумента, Отказ) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Номенклатура.Ссылка КАК УслугаДоговора
	               |ПОМЕСТИТЬ ВТ_УслугиПоДоговору
	               |ИЗ
	               |	Справочник.Номенклатура КАК Номенклатура
	               |ГДЕ
	               |	Номенклатура.Ссылка В(&МассивУслугДоговора)
	               |	И НЕ Номенклатура.ПометкаУдаления
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	Номенклатура.Ссылка
	               |
	               |ИНДЕКСИРОВАТЬ ПО
	               |	УслугаДоговора
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	Номенклатура.Ссылка КАК Номенклатура
	               |ПОМЕСТИТЬ ВТ_УслугиДокумента
	               |ИЗ
	               |	Справочник.Номенклатура КАК Номенклатура
	               |ГДЕ
	               |	Номенклатура.Ссылка В(&МассивУслугиДокумента)
	               |	И НЕ Номенклатура.ПометкаУдаления
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	Номенклатура.Ссылка
	               |
	               |ИНДЕКСИРОВАТЬ ПО
	               |	Номенклатура";
	
	Запрос.УстановитьПараметр("МассивУслугДоговора" 	, МассивУслугДоговора);	
	Запрос.УстановитьПараметр("МассивУслугиДокумента"	, МассивУслугиДокумента);	
	Запрос.Выполнить();
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	ВТ_УслугиДокумента.Номенклатура КАК Номенклатура,
	               |	ПРЕДСТАВЛЕНИЕ(ВТ_УслугиДокумента.Номенклатура) КАК НоменклатураПредставление,
	               |	ВЫБОР
	               |		КОГДА ВТ_УслугиПоДоговору.УслугаДоговора ЕСТЬ NULL
	               |			ТОГДА ЛОЖЬ
	               |		ИНАЧЕ ИСТИНА
	               |	КОНЕЦ КАК ЕстьВПротоколе
	               |ПОМЕСТИТЬ ВТ_Контроль
	               |ИЗ
	               |	ВТ_УслугиДокумента КАК ВТ_УслугиДокумента
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_УслугиПоДоговору КАК ВТ_УслугиПоДоговору
	               |		ПО ВТ_УслугиДокумента.Номенклатура = ВТ_УслугиПоДоговору.УслугаДоговора";
	
	Запрос.Выполнить();
	
	Запрос.Текст = "УНИЧТОЖИТЬ ВТ_УслугиПоДоговору";
	Запрос.Выполнить();
		
	Запрос.Текст = "УНИЧТОЖИТЬ ВТ_УслугиДокумента";
	Запрос.Выполнить();
	
	Запрос.Текст  = "ВЫБРАТЬ
	               |	ВТ_Контроль.Номенклатура КАК Номенклатура,
	               |	ВТ_Контроль.НоменклатураПредставление КАК НоменклатураПредставление,
	               |	ВТ_Контроль.ЕстьВПротоколе КАК ЕстьВПротоколе
	               |ИЗ
	               |	ВТ_Контроль КАК ВТ_Контроль
	               |ГДЕ
	               |	НЕ ВТ_Контроль.ЕстьВПротоколе";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если Не РезультатЗапроса.Пустой() Тогда
		
		Выборка = РезультатЗапроса.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = Выборка.НоменклатураПредставление +" отсутствует в протоколе согласования цен!";
			Сообщение.Сообщить();
	
		КонецЦикла;
		
		Отказ = Истина;

	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

//Заполнение документов
Процедура ЗаполнениеДокументов(Объект) Экспорт
	
	Если Объект.Дата = Дата(1,1,1) Тогда
		Объект.Дата = CW_Настройки.ТекущаяДатаПользователя();
	КонецЕсли;
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Объект, "Организация") Тогда
		Если Объект.Организация.Пустая() Тогда
			Объект.Организация = CW_Настройки.ОсновнаяОрганизация();
		КонецЕсли;
	КонецЕсли;
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Объект, "Ответственный") Тогда
		Если Объект.Ответственный.Пустая() Тогда
			Объект.Ответственный = ПараметрыСеанса.ТекущийПользователь;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры
//Заполнение документов

Процедура УстановитьПараметрыФункциональныхОпцийФормы(Форма) Экспорт  
	
	ГруппаПользователя 		 = CW_ПраваДоступа_ПИ.ГруппаПользователя(ПараметрыСеанса.ТекущийПользователь);
	
	УстанавилваемыеПараметры = Новый Структура;
	УстанавилваемыеПараметры.Вставить("CW_ГруппаПользователя", 	ГруппаПользователя);
	
	Форма.УстановитьПараметрыФункциональныхОпцийФормы(УстанавилваемыеПараметры);
	
КонецПроцедуры
	

Функция НужноПоказатьПередКорректировкой(Объект) Экспорт 
	
	Если НЕ Объект.Корректировка Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если НЕ Объект.КорректируемыйДокумент.Корректировка Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если Объект.ВидОперацииКорректировки = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсправленияПоступленияРеализации.ИсправлениеОшибки")
		И Объект.КорректируемыйДокумент.ВидОперацииКорректировки = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсправленияПоступленияРеализации.СогласованноеИзменение") Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции 


Процедура ПередЗаписьюНаСервере(Форма, Отказ) Экспорт

	Объект 				= Форма.Объект;
	МетаданныеОбъекта 	= Объект.Ссылка.Метаданные();
	
	Если Не ОбщегоНазначения.ЕстьРеквизитОбъекта("Договор", МетаданныеОбъекта) Тогда 
		Возврат;
	КонецЕсли;
	
	ДоговорПоГрузоперевозке = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Ссылка, "Договор");
	Если ТипЗнч(ДоговорПоГрузоперевозке) = Тип("СправочникСсылка.CW_ДоговорыПоГрузоперевозкам") Тогда
		ПроверитьСоответствиедоговораУчетному(ДоговорПоГрузоперевозке, Отказ)	
	КонецЕсли;
	
КонецПроцедуры

Процедура ПроверитьСоответствиедоговораУчетному(ДоговорПоГрузоперевозке, Отказ = Ложь) Экспорт
	
	Если Не ДоговорПоГрузоперевозке.БухгалтерскийУчет Тогда
		//Ничего не делаем
		Возврат;
	КонецЕсли;     
	
	УчетныйДоговор = ДоговорПоГрузоперевозке.УчетныйДоговор;
	
	Если ДоговорПоГрузоперевозке.БухгалтерскийУчет 
		и Не ЗначениеЗаполнено(УчетныйДоговор) Тогда
		ОбщегоНазначения.СообщитьПользователю("Для договора "+СокрЛП(ДоговорПоГрузоперевозке)+" не указан учётный договор!",,,,Отказ);
		Возврат;
	КонецЕсли;   
	
	Если ДоговорПоГрузоперевозке.ВалютаДоговора <> УчетныйДоговор.ВалютаВзаиморасчетов Тогда 
		ОбщегоНазначения.СообщитьПользователю("Валюта договора по грузоперевозке ("+ДоговорПоГрузоперевозке.ВалютаДоговора+") отличается от валюты учетного договора ("+УчетныйДоговор.ВалютаВзаиморасчетов +")!",,,,Отказ);
	КонецЕсли;
	
	Если ДоговорПоГрузоперевозке.Владелец <> УчетныйДоговор.Владелец Тогда 
		ОбщегоНазначения.СообщитьПользователю("Контрагент договора по грузоперевозке ("+ ДоговорПоГрузоперевозке.Владелец+") отличается от контрагента учетного договора ("+УчетныйДоговор.Владелец+")!",,,,Отказ);
	КонецЕсли;
	
	Если ДоговорПоГрузоперевозке.ВидДоговора <> УчетныйДоговор.ВидДоговора Тогда 
		ОбщегоНазначения.СообщитьПользователю("Вид договора по грузоперевозке ("+ДоговорПоГрузоперевозке.ВидДоговора+") отличается от учетного договора ("+УчетныйДоговор.ВидДоговора+")!",,,,Отказ);
	КонецЕсли;
	
	Если ДоговорПоГрузоперевозке.ВалютаДоговора <> Константы.ВалютаРегламентированногоУчета.Получить() 
		И ДоговорПоГрузоперевозке.ВзаиморасчетыВУЕ <> УчетныйДоговор.РасчетыВУсловныхЕдиницах Тогда 
		ОбщегоНазначения.СообщитьПользователю("Признак ""Взаиморасчеты в у.е."" отличается от учетного договора ("+УчетныйДоговор.ВидДоговора+")!",,,,Отказ);
	КонецЕсли;
	
	//Для версии КОРП 
	ОрганизацияДоговора = ДоговорПоГрузоперевозке.Организация;
	Если ВариантыПриложений.ЭтоВерсияКОРП() Тогда 	 
		ОрганизацияДоговора = ДоговорПоГрузоперевозке.Организация.ГоловнаяОрганизация;
	КонецЕсли;
	//КОНЕЦ Для версии КОРП     
	
	Если ОрганизацияДоговора <> УчетныйДоговор.Организация Тогда 
		ОбщегоНазначения.СообщитьПользователю("Организация договора по грузоперевозке ("+ ОрганизацияДоговора+") отличается от организации учетного договора ("+УчетныйДоговор.Организация+")!",,,,Отказ);
	КонецЕсли;    
	
	
КонецПроцедуры


Функция ПолучитьПлановыйСрокОплаты(ПараметрКоманды, ПлатежныйКалендарь, СоответствиеОстатков = Неопределено) Экспорт

	Если СоответствиеОстатков <> Неопределено Тогда
		ЕстьОстатокЗадолженности = СоответствиеОстатков.Получить(ПараметрКоманды);
		Если ЕстьОстатокЗадолженности = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;                              
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.Текст = "ВЫБРАТЬ
	|	CW_ДанныеПлатежногоКалендаря.Дата КАК Дата
	|ПОМЕСТИТЬ ВТ_ПлатежныеДаты
	|ИЗ
	|	РегистрСведений.CW_ДанныеПлатежногоКалендаря КАК CW_ДанныеПлатежногоКалендаря
	|ГДЕ
	|	CW_ДанныеПлатежногоКалендаря.ПлатежныйКалендарь = &ПлатежныйКалендарь
	|	И CW_ДанныеПлатежногоКалендаря.Дата >= &ТекущаяДата";
	
	Запрос.УстановитьПараметр("ПлатежныйКалендарь", ПлатежныйКалендарь);     
	Запрос.УстановитьПараметр("ТекущаяДата", 		ТекущаяДата());     
	
	Запрос.Выполнить();
	
	ДанныеСрокаОплаты 	= CW_Документы.ПолучитьСрокОплаты(ПараметрКоманды);
	Если ДанныеСрокаОплаты.ДатаОплаты > НачалоДня(ТекущаяДата()) Тогда  
		
		Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
		|	ВТ_ПлатежныеДаты.Дата КАК Дата
		|ИЗ
		|	ВТ_ПлатежныеДаты КАК ВТ_ПлатежныеДаты
		|ГДЕ
		|	ВТ_ПлатежныеДаты.Дата <= &СрокОплаты
		|
		|УПОРЯДОЧИТЬ ПО
		|	Дата УБЫВ
		|АВТОУПОРЯДОЧИВАНИЕ";
		
		Запрос.УстановитьПараметр("СрокОплаты", НачалоДня(ДанныеСрокаОплаты.ДатаОплаты));  	
		
		РезультатЗапроса = Запрос.Выполнить();
		
		Выборка = РезультатЗапроса.Выбрать();
		Если Выборка.Следующий() тогда
			ДатаСрокОплаты = Выборка.Дата;
		КонецЕсли; 
		
	КонецЕсли;   
	
	Если ДатаСрокОплаты = Неопределено   
		ИЛИ ДанныеСрокаОплаты.ДатаОплаты <= НачалоДня(ТекущаяДата()) Тогда   
	
		Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
		|	ВТ_ПлатежныеДаты.Дата КАК Дата
		|ИЗ
		|	ВТ_ПлатежныеДаты КАК ВТ_ПлатежныеДаты
		|ГДЕ
		|	ВТ_ПлатежныеДаты.Дата >= &СрокОплаты
		|
		|УПОРЯДОЧИТЬ ПО
		|	Дата ВОЗР
		|АВТОУПОРЯДОЧИВАНИЕ";
		
		Запрос.УстановитьПараметр("СрокОплаты", НачалоДня(ТекущаяДата()));  	
		
		РезультатЗапроса = Запрос.Выполнить();
		
		Выборка = РезультатЗапроса.Выбрать();
		Если Выборка.Следующий() тогда
			ДатаСрокОплаты = Выборка.Дата;
		КонецЕсли; 
		
	КонецЕсли;    
 	
	Возврат ДатаСрокОплаты;
	
КонецФункции  

Процедура ЗаписатьДанныеПервичногоДокумента(Объект) Экспорт
	
	ДанныеДокумента = Новый Структура;
	ДанныеДокумента.Вставить("Ссылка",		Объект.Ссылка);
	ДанныеДокумента.Вставить("Организация",	Объект.Организация);
	ДанныеДокумента.Вставить("Контрагент",  Объект.Контрагент);
	
	//Исключем дублирование записей
	РегистрыСведений.CW_ДанныеПервичныхДокументов.ОчиститьНаборПоУсловиям(ДанныеДокумента);
	
	Если Объект.ФормируетсяСчет Тогда 
		НомерДляПечати 	= CW_Документы.ПолучитьНомерНаПечать(Новый Структура("Организация, Номер, Дата", Объект.Организация, Объект.НомерСчета, Объект.ДатаСчета));	
		РегистрыСведений.CW_ДанныеПервичныхДокументов.ЗаписатьДанныеПервичногоДокумента(ДанныеДокумента, Перечисления.CW_ВидыПервичныхДокументов.Счет, НомерДляПечати, Объект.НомерСчета, Объект.ДатаСчета);
	КонецЕсли;
	
	Если Объект.ФормируетсяАкт Тогда
		НомерДляПечати 	= CW_Документы.ПолучитьНомерНаПечать(Новый Структура("Организация, Номер, Дата", Объект.Организация, Объект.НомерАкта, Объект.ДатаАкта));	 
		РегистрыСведений.CW_ДанныеПервичныхДокументов.ЗаписатьДанныеПервичногоДокумента(ДанныеДокумента, Перечисления.CW_ВидыПервичныхДокументов.Акт, НомерДляПечати, Объект.НомерАкта, Объект.ДатаАкта);
	КонецЕсли;
	
	Если Объект.ФормируетсяСчетФактура Тогда
		НомерДляПечати 	= CW_Документы.ПолучитьНомерНаПечать(Новый Структура("Организация, Номер, Дата", Объект.Организация, Объект.НомерСчетаФактуры, Объект.ДатаСчетаФактуры));	 
		РегистрыСведений.CW_ДанныеПервичныхДокументов.ЗаписатьДанныеПервичногоДокумента(ДанныеДокумента, Перечисления.CW_ВидыПервичныхДокументов.СчетФактура, НомерДляПечати, Объект.НомерСчетаФактуры, Объект.ДатаСчетаФактуры);
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьСтавкуНДС(ПараметрыФункции) Экспорт
	
	Возврат CW_БухгалтерияЭкспедитораСерверПереопределяемый. ПолучитьСтавкуНДС(ПараметрыФункции);

КонецФункции


Процедура ПроверитьСрокДействияДоговора(Объект, СтруктураПараметров, Отказ) Экспорт  
	
	Если СтруктураПараметров.КонтролироватьСрокДоговоров 
		И ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Объект, "Договор")
		И ЗначениеЗаполнено(Объект.Договор) 
		И НЕ Объект.Договор.Пролонгация Тогда
		
		Если ЗначениеЗаполнено(Объект.Договор.СрокДействияДоговора)
			И Объект.Дата > КонецДня(Объект.Договор.СрокДействияДоговора) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Строка(Объект.Ссылка)+": дата документа больше даты окончания действия договора!",,,,Отказ);
		КонецЕсли;
	КонецЕсли; 
	
	Если СтруктураПараметров.КонтролироватьСрокПриложения
		И ПолучитьФункциональнуюОпцию("CW_ВедетсяУчетПриложенийПоДоговорам")
		И ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Объект, "ПриложениеКДоговору") 
		И ЗначениеЗаполнено(Объект.ПриложениеКДоговору) Тогда
		
		Если ЗначениеЗаполнено(Объект.ПриложениеКДоговору.СрокДействия)
			И Объект.Дата > КонецДня(Объект.ПриложениеКДоговору.СрокДействия) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Строка(Объект.Ссылка)+": дата документа больше даты окончания действия приложения к договору!",,,,Отказ);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры  

Функция ПустаяСтруктураКонтроляСрокаДействияДоговора() Экспорт
	
	Структура = Новый Структура;
	Структура.Вставить("КонтролироватьСрокДоговоров", 	Ложь);
	Структура.Вставить("КонтролироватьСрокПриложения", Ложь);
	
	Возврат Структура;

КонецФункции
