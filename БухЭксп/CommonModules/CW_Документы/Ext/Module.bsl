Функция ПрефиксОрганизации(Организация) Экспорт 
	// --- 
	
	ПрефиксИнформационнойБазы = "";
	ПрефиксацияОбъектовСобытия.ПриОпределенииПрефиксаИнформационнойБазы(ПрефиксИнформационнойБазы);
	ПрефиксИнформационнойБазы = ?(ПрефиксИнформационнойБазы = "","00",ПрефиксИнформационнойБазы);

	ПрефиксОрганизации        	= Организация.Префикс;
	
	ДополнитьСтрокуНулямиСлева(ПрефиксОрганизации, 2);
	
	// --- 
	ШаблонПрефикса = "[ОР][ИБ]-";
	ШаблонПрефикса = СтрЗаменить(ШаблонПрефикса, "[ОР]", ПрефиксОрганизации);
	ШаблонПрефикса = СтрЗаменить(ШаблонПрефикса, "[ИБ]", ПрефиксИнформационнойБазы);
	// --- 
	Возврат(ШаблонПрефикса);
	
	// --- 
КонецФункции


Функция ПолучитьНомерНаПечать(Документ, ИмяРеквизитаНомер="Номер", ИмяРеквизитаДата="Дата") Экспорт 

	// На входе документ - объект, ссылка или структура, обязательно с полем "Организация", 
	Организация = Документ.Организация;
	
	// и с полем номера, по умлочанию "Номер", конкретное имя реквизита можно уточнить
	Номер = СокрЛП(Документ[ИмяРеквизитаНомер]);
	
	// если это документ, то дата всегда есть, но на случай структуры придётся проверить
	Если ТипЗнч(Документ)=Тип("Структура") И НЕ Документ.Свойство("Дата") Тогда 
		Дата = ТекущаяДата();
	Иначе 
		Дата = Документ[ИмяРеквизитаДата];
	КонецЕсли;
	
	// проверим на наличие опции вывода на печать полного номера 
	ВыводитьНаПечатьПолныйНомерДокумента = ложь;
	Если ЗначениеЗаполнено(Организация) и Дата <> Дата(1,1,1) Тогда
		ВыводитьНаПечатьПолныйНомерДокумента = CW_Настройки.ПараметрУчетнойПолитики(Дата, Организация, "ВыводитьНаПечатьПолныйНомерДокумента");
		Если ВыводитьНаПечатьПолныйНомерДокумента Тогда 
			Возврат Номер;
		КонецЕсли;                                                     
	КонецЕсли;
	
	// попытаемся найти позицию дефиса и если его найдем,
	// то все что будет левее этой позиции будем считать префиксом,
	// с которым нужно будет разобраться подлежит он выводу на печать или нет.
	ПозицияДефиса 	= СтрНайти(Номер,"-");
	Если ПозицияДефиса > 0 Тогда
		
		// исходный префикс - то, что до символа "-"
		ПрефиксНомера 	= Лев(Номер,ПозицияДефиса);
		
		// это остаток номера, который нужно вывести на печать в любом случае
		Номер = Сред(Номер,ПозицияДефиса + 1);
		
		ПрефиксИнформационнойБазы 	= "";
		ПрефиксацияОбъектовСобытия.ПриОпределенииПрефиксаИнформационнойБазы(ПрефиксИнформационнойБазы);
		
		ПолныйПрефиксПоШаблону 		= ПрефиксОрганизации(Организация);
		СтрокаПрефиксОрганизации 	= ?(Организация.Префикс 		= "","00", Организация.Префикс);
		ПрефиксИнформационнойБазы 	= ?(ПрефиксИнформационнойБазы 	= "","00",ПрефиксИнформационнойБазы) + "-";
		
		ВсеНули 		= Лев("00000000",ПозицияДефиса-1)+"-";
		
		// пытаемся вырезать стандартный префикс
		НовыйПрефиксНомера = СтрЗаменить(ПрефиксНомера, ПолныйПрефиксПоШаблону, "");
		
		// пытаемся вырезать префикс, состоящий из нулей
		НовыйПрефиксНомера = СтрЗаменить(НовыйПрефиксНомера, ВсеНули, "");
		
		// если длина префикса равна или превышает 5 символов, то есть основания 
		// полагать, что он сформирован по шаблону типовой конфигурации
		Если ПозицияДефиса >= 5 Тогда
			
			// если первые 2 символа совпадают с префиксом организации, то обрезаем их
			Если Лев(НовыйПрефиксНомера,2) =  СтрокаПрефиксОрганизации Тогда
				НовыйПрефиксНомера = Сред(НовыйПрефиксНомера,3);
			КонецЕсли;
			
			// если последние 3 символа совпадают с префиксом ИБ или с пустым префиксом ИБ 
			// (условие на тот случай если с некоторого момента времени префикс ИБ был добавлен),
			// то обрезаем их
			Если Прав(НовыйПрефиксНомера,3) = ПрефиксИнформационнойБазы  Тогда
				НовыйПрефиксНомера = СтрЗаменить(НовыйПрефиксНомера	, ПрефиксИнформационнойБазы, "");
			КонецЕсли;
			
			Если Прав(НовыйПрефиксНомера,3) = "00-" Тогда
				НовыйПрефиксНомера = СтрЗаменить(НовыйПрефиксНомера	, "00-", "");
			КонецЕсли;
			
			// если в оставшейся части в префиксе найдем букву, то такой префикс
			// не подлежит выводу на печать, т.к. мог быть получен в результате 
			// смены префикса организации
			СтрокаЧисел	 	= "0123456789";
			ЧислоСимволов 	=  СтрДлина(НовыйПрефиксНомера)-1;
			Для поз = 1 по ЧислоСимволов Цикл
				ТекущийСимвол = Сред(НовыйПрефиксНомера,Поз,1);
				Если СтрНайти(СтрокаЧисел, ТекущийСимвол) = 0 Тогда
					НовыйПрефиксНомера = "";
					Прервать;
				КонецЕсли;
			КонецЦикла;
			
		// если изначальный префикс меньше 5 символов, то считаем такой префикс
		// не подлежащий выводу на печать (префикс, который мог быть сформирован в старом формате)
		Иначе
			НовыйПрефиксНомера = "";
		КонецЕсли;
		
	// если "-" не нашли, то попытаемся "вырезать" из номера префикс
 	ИначеЕсли СтрНайти(Номер, Организация.Префикс) = 1 Тогда

       Номер = СтрЗаменить(Номер,Организация.Префикс,"");
       НовыйПрефиксНомера = "";    
	
	// если в исходном номере не было "-"	
	Иначе 
		НовыйПрефиксНомера = "";	
	КонецЕсли;
	
	// если префикс пустой, то попытаемся убрать ведущие нули
	Если СокрЛП(НовыйПрефиксНомера) = "" Тогда
		Пока Лев(Номер, 1) = "0" Цикл
			Номер = Сред(Номер, 2);  
		КонецЦикла;	
	КонецЕсли;
	
	Возврат СокрЛП(НовыйПрефиксНомера) + Номер;
КонецФункции

Процедура ДополнитьСтрокуНулямиСлева(Строка, ДлинаСтроки)
	
	// ВызовБП
	Строка = _сф.стр_ДополнитьСтроку(Строка, ДлинаСтроки, "0", "Слева");
	
КонецПроцедуры

