// разбивает имя файла на путь,имя и расширение
Функция ф_СтруктураФайла(Знач ПолноеИмя) Экспорт 
	// --- 
	
	СтруктураИмени = ст_Создать("Путь,Имя,Расширение");
	
	// сначала определяем, есть ли у файла путь
	// пробуем определить разделитель
	Разделитель = Неопределено;
	Если Найти(ПолноеИмя,"\") <> 0 Тогда
		
		Разделитель = "\";
		
	ИначеЕсли Найти(ПолноеИмя,"/") <> 0 Тогда 
		
		Разделитель = "/"; 
		
	КонецЕсли; 
	// --- 
	Если Разделитель=Неопределено Тогда
		
		// пути нет
		СтруктураИмени.Путь="";
		ИмяБезПути = ПолноеИмя;
		
		
	Иначе
		
		// определяем часть имени без пути
		ИмяБезПути = стр_ПоследняяСтрока(ПолноеИмя,Разделитель);
		СтруктураИмени.Путь = стр_Подстрока(ПолноеИмя,"Л",стр_Длина(ПолноеИмя)-стр_Длина(ИмяБезПути));
		
	КонецЕсли;  
	
	// --- 
	
	Строки = стр_РазбитьНаСтроки(ИмяБезПути,".");
	Если стр_ЧислоСтрок(Строки) =1 Тогда
		
