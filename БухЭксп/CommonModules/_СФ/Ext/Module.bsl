// добавляет колонки таблицы и заполняет по коллекции
// см. т_Создать
Процедура т_ДобавитьКолонки(Таблица,ИменаКолонок,Источник=Неопределено) Экспорт
	
	МассивПолей = ПоляПоСтроке(ИменаКолонок);
	МассивИменПолей = м_Создать("Ключ",МассивПолей);	
	// --- 
	Для каждого ИмяПоля Из МассивИменПолей Цикл
		Таблица.Колонки.Добавить(ИмяПоля);
	КонецЦикла;
	// --- 
	
	Если Источник <> Неопределено Тогда
		
		Поля = со_Создать("Ключ",,МассивПолей);
		Для каждого ЭлементыКоллекции Из Источник Цикл
			
			Нстр = Таблица.Добавить();
			Для каждого СтрПоле Из Поля Цикл
				Поле = Поля.Получить(СтрПоле.Ключ);
				Если Поле.Заполнение Тогда
					Нстр[Поле.Ключ]=ЗначениеПоПутиДанных(ЭлементыКоллекции,Поле.Адрес);	
				КонецЕсли; 
				
			КонецЦикла; 
						
		КонецЦикла; 
		
	КонецЕсли; 
	
КонецПроцедуры

