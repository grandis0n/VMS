// сворачивает таблицу по всем оставшимся колонкам, кроме указанных
Процедура т_СвернутьПоКолонкамСуммирования(Таблица,КолонкиСуммирования) Экспорт 
	
	СписокКолонокТаблицы = сп_СоздатьИзКоллекции(Таблица.Колонки,"Имя",Истина);
	СписокКолонокСуммирования = сп_СоздатьИзСтроки(КолонкиСуммирования);
	
	Для каждого ЭлементСписка Из СписокКолонокТаблицы  Цикл
		
		 ЭлементСписка.Пометка = ?(СписокКолонокСуммирования.НайтиПоЗначению(ЭлементСписка.Значение)<>Неопределено,Ложь,Истина);
		
	КонецЦикла; 
	
	КолонкиГруппировок = сп_Представление(СписокКолонокТаблицы,",",Ложь,Истина);
	
	Таблица.Свернуть(КолонкиГруппировок,КолонкиСуммирования);
	
КонецПроцедуры

