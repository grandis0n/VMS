// является ли тип ссылочным
Функция тип_Ссылочный(ПроверяемыйТип) Экспорт 
	// --- 
	
	Если ПроверяемыйТип = Неопределено Тогда
		
		Возврат(Ложь);
		
	ИначеЕсли ПроверяемыйТип = Тип("Строка") Тогда 
		
		 Возврат(Ложь);
		 
	ИначеЕсли ПроверяемыйТип = Тип("Число") Тогда 
		
		 Возврат(Ложь);
		 
	ИначеЕсли ПроверяемыйТип = Тип("Дата") Тогда 
		
		 Возврат(Ложь);
		 
	ИначеЕсли ПроверяемыйТип = Тип("Дата") Тогда 
		
		 Возврат(Ложь);	
	               		 
	Иначе
		 
		 Если Справочники.ТипВсеСсылки().СодержитТип(ПроверяемыйТип) Тогда
			 
			 Возврат(Истина);
			 
		 КонецЕсли;
		 
		  Если Документы.ТипВсеСсылки().СодержитТип(ПроверяемыйТип) Тогда
			 
			 Возврат(Истина);
			 
		 КонецЕсли;
		 
		  Если Перечисления.ТипВсеСсылки().СодержитТип(ПроверяемыйТип) Тогда
			 
			 Возврат(Истина);
			 
		 КонецЕсли;
		 
		  Если ПланыВидовХарактеристик.ТипВсеСсылки().СодержитТип(ПроверяемыйТип) Тогда
			 
			 Возврат(Истина);
			 
		 КонецЕсли;
		 
		  Если ПланыСчетов.ТипВсеСсылки().СодержитТип(ПроверяемыйТип) Тогда
			 
			 Возврат(Истина);
			 
		 КонецЕсли;
		 
		  Если ПланыВидовРасчета.ТипВсеСсылки().СодержитТип(ПроверяемыйТип) Тогда
			 
			 Возврат(Истина);
			 
		 КонецЕсли;
		 
	 КонецЕсли; 
	 
	 Возврат(Ложь);
	
	// --- 
КонецФункции

