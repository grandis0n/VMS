// представление списка
Функция сп_Представление(Список,Разделитель=",",флИспользоватьПредставление=Истина, ЗначениеПометки=Неопределено) Экспорт 
	
	Представление = "";
	
	Если ЗначениеПометки = Неопределено Тогда
		
		Для каждого Стр Из Список Цикл
			
			Если Представление <> "" Тогда
				
				Представление = Представление + Разделитель;
				
			КонецЕсли; 
			
			Представление = Представление + ?(флИспользоватьПредставление,Стр.Представление,Строка(Стр.Значение));
			
		КонецЦикла;
		
	Иначе
		
		Для каждого Стр Из Список Цикл
			
			Если Стр.Пометка = ЗначениеПометки Тогда
				
				Если Представление <> "" Тогда
					
					Представление = Представление + Разделитель;
					
				КонецЕсли; 
				
				Представление = Представление + ?(флИспользоватьПредставление,Стр.Представление,Строка(Стр.Значение));
				
				
			КонецЕсли; 
						
		КонецЦикла;
		
	КонецЕсли; 
	
	Возврат(Представление);
	
КонецФункции

// объединение списков
Функция сп_ОбъединениеСписков(Список1,Список2) Экспорт 
	
	Список = Список1.Скопировать();
	
	Для каждого Элемент Из Список2 Цикл
		
		Если Список.НайтиПоЗначению(Элемент.Значение)=Неопределено Тогда
			
			Список.Добавить(Элемент.Значение,Элемент.Представление,Элемент.Пометка,Элемент.Картинка);
			
		КонецЕсли; 
		
	КонецЦикла; 	
	
	Возврат(Список);
	
КонецФункции

