
#Область ОбщегоНазначения

// установка значения с проверкой
Процедура УстановитьЗначение(Переменная,Значение) Экспорт 
	
	Если Переменная <> Значение Тогда
		
		Переменная = Значение;
		
	КонецЕсли; 
	
КонецПроцедуры

// проверяет на пустое значение
Функция ПустоеЗначение(Значение) Экспорт
	//Назначение: Проверяет, является ли значение пустым
	//ДатаСоздания: 20080101
	//Автор: 1С
	//Тестирована: Да
	//$Значение: Значение, заполенение которого надо проверить
	//$Результат: Истина - значение не заполнено, ложь - иначе.
	//Описание:
	//	Взято из типовых конфигураций
	Перем Результат, ТипЗначения;
	Результат = Ложь;
	ТипЗначения = ТипЗнч(Значение);

	// Сначала примитивные типы
	Если Значение = Неопределено Тогда
		Результат = Истина;
	ИначеЕсли Значение = NULL Тогда
		Результат = Истина;
	ИначеЕсли ТипЗначения = Тип("Строка") Тогда
		Если стр_Сократить(Значение) = "" Тогда
			Результат = Истина;
		КонецЕсли; 
	ИначеЕсли ТипЗначения = Тип("Число") Тогда
		Если Значение = 0 Тогда
			Результат = Истина;
		КонецЕсли; 
	ИначеЕсли ТипЗначения = Тип("Дата") Тогда
		Если Значение = Дата('00010101') Тогда
			Результат = Истина;
		КонецЕсли; 
	ИначеЕсли ТипЗначения = Тип("Булево") Тогда
		Результат = Ложь; // Булево будем считать не пустым
		
	// Для остальных будем считать значение пустым, если оно равно
	// дефолтному значению своего типа
	Иначе
		Если Значение = Новый(ТипЗначения) Тогда
			Результат = Истина;
		КонецЕсли; 
	КонецЕсли; 

	Возврат Результат;
КонецФункции // обПусто

// проверяет на непустое значение
Функция НеПустоеЗначение(Объект) Экспорт
	//Назначение: Проверяет, является ли значение непустым
	//ДатаСоздания: 20080101
	//Автор: 1С
	//Тестирована: Да
	//$Значение: Значение, заполенение которого надо проверить
	//$Результат: Ложь - значение не заполнено, истина - иначе.

	Возврат НЕ ПустоеЗначение(Объект);
	
КонецФункции

