// создает ТЗ с заданным набором колонок
// Источник: массив, коллекция, ТЗ, списокXDTO и прочие с возможностью перебора
// ИменаКолонок: "Колонка1:АдресДанных,Колонка2,Колонка3:"
Функция т_Создать(ИменаКолонок,Источник=Неопределено) Экспорт 
	
	Таблица = Новый ТаблицаЗначений;
	// --- 
	т_ДобавитьКолонки(Таблица,ИменаКолонок,Источник);
	// --- 
	Возврат(Таблица);
	
