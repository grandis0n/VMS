// создает структуру. если переданы поля, то создает поля
Функция ст_Создать(ИменаПолей="",Объект=Неопределено) Экспорт 
	
	Структура = Новый Структура;
	
	Если ИменаПолей <> "" Тогда
		
		Если Объект = Неопределено Тогда
			
			МассивПолей = м_СоздатьИзСтроки(ИменаПолей,",");
			Для каждого Элемент Из МассивПолей Цикл
				
				Структура.Вставить(Элемент,Неопределено);
				
			КонецЦикла;
			
		Иначе
			
			ст_ДобавитьСвойства(Структура,ИменаПолей,Объект);
			
		КонецЕсли; 
		
	КонецЕсли; 
	
	Возврат(Структура);
	
КонецФункции

// заполнение структуры по полям объекта
Процедура ст_ДобавитьСвойства(Структура,Свойства,Объект=Неопределено) Экспорт 
	// --- 
	
	// ИмяПоля:Реквизит.Подреквизит1.Подреквизит2,ИмяПоля2
	// 
	
	Свойства = СтрЗаменить(Свойства,Символы.ПС,"");
	
	Если Свойства = "*" Тогда
		
		 Если ТипЗнч(Объект)=Тип("Структура") Тогда
			 
			 Для каждого КлючЗначение Из Объект Цикл
				 
				 ст_УстановитьСвойство(Структура,КлючЗначение.Ключ,КлючЗначение.Значение);
				 
			 КонецЦикла; 
			 
		 КонецЕсли; 
		 
		 Если ТипЗнч(Объект)=Тип("ОбъектXDTO") Тогда
			 
			Для каждого Свойство Из Объект.Свойства() Цикл
				 
				 ст_УстановитьСвойство(Структура,Свойство.Имя,Объект[Свойство.Имя]);
				 
			 КонецЦикла;			 
			 
		 КонецЕсли; 
		
	 Иначе
		 
		 МассивСвойств = м_СоздатьИзСтроки(Свойства);
		 Для каждого Свойство Из МассивСвойств Цикл
			 
			 СтруктураСвойства = _СтруктураПоля(Свойство); 
			 ст_УстановитьСвойство(Структура,СтруктураСвойства.Ключ,?(СтруктураСвойства.Заполнение,ЗначениеПоПутиДанных(Объект,СтруктураСвойства.Адрес),Неопределено));
			 
		 КонецЦикла; 
		 
	 КонецЕсли;  
	
	// --- 
КонецПроцедуры

// заполнение структуры по полям объекта (без ст_УстановитьСвойство(), можно использовать для заполнения объектов)
Процедура ст_ЗаполнитьСвойства(Структура,Свойства,Объект) Экспорт 
	// --- 
	
	// ИмяПоля:Реквизит.Подреквизит1.Подреквизит2,ИмяПоля2
	// 
	
	Свойства = СтрЗаменить(Свойства,Символы.ПС,"");
	
	Если Свойства = "*" Тогда
		
		 Если ТипЗнч(Объект)=Тип("Структура") Тогда
			 
			 Для каждого КлючЗначение Из Объект Цикл
				 
				 Структура[КлючЗначение.Ключ]=КлючЗначение.Значение;
				 
			 КонецЦикла; 
			 
		 КонецЕсли; 
		
	 Иначе
		 
		 МассивСвойств = м_СоздатьИзСтроки(Свойства);
		 Для каждого Свойство Из МассивСвойств Цикл
			 
			 СтруктураСвойства = _СтруктураПоля(Свойство); 
			 Структура[СтруктураСвойства.Ключ]=ЗначениеПоПутиДанных(Объект,СтруктураСвойства.Адрес);
			 
		 КонецЦикла; 
		 
	 КонецЕсли;
	
	// --- 
КонецПроцедуры

