		Если Реквизит="" Тогда
			
			Список.Добавить(Элемент);
			
		Иначе
			
			Если НеПустоеЗначение(Элемент[Реквизит]) Тогда
				
				Список.Добавить(Элемент[Реквизит]);
				
			КонецЕсли; 
			
		КонецЕсли; 
				
	КонецЦикла; 
	
	Если Пометка Тогда
		
		Список.ЗаполнитьПометки(Пометка);
		
	КонецЕсли; 
	
	Возврат(Список);
	
