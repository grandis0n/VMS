// универсальный итог, для ТЗ, списка и массива
Функция Итог(Коллекция, Реквизит="", ФорматИтога=Неопределено) Экспорт 
	// --- 
	
	Если ТипЗнч(Коллекция)=Тип("СписокЗначений") Тогда 
		
		Сумма = 0;
		Если Реквизит="" Тогда
			
			Для каждого Стр Из Коллекция Цикл
				
				Инкремент(Сумма, Стр.Значение);
				
			КонецЦикла;
			
		Иначе
			
			Для каждого Стр Из Коллекция Цикл
				
				Инкремент(Сумма, Стр.Значение[Реквизит]);
				
			КонецЦикла;
			
		КонецЕсли; 
		
		Результат = Сумма;
		
	ИначеЕсли ТипЗнч(Коллекция)=Тип("Массив") Тогда 
		
		Сумма = 0;
		Если Реквизит="" Тогда
			
			Для каждого Стр Из Коллекция Цикл
				
				Инкремент(Сумма, Стр);
				
			КонецЦикла; 
			
		Иначе
			
			Для каждого Стр Из Коллекция Цикл
				
				Инкремент(Сумма, Стр[Реквизит]);
				
			КонецЦикла; 
			
		КонецЕсли;
		
		Результат = Сумма; 
		
	Иначе
		
		// ТЗ или ТЧ
		Результат = Коллекция.Итог(Реквизит);
				
	КонецЕсли; 
	
	Если ФорматИтога <> Неопределено Тогда
		
		Возврат(Формат(Результат,ФорматИтога));
		
	Иначе
		
		Возврат(Результат); 
		
	КонецЕсли; 
	
	// --- 
КонецФункции

