КонецФункции

// добавляет в массив уникально
Процедура м_ДобавитьУникально(Массив,Значение) Экспорт
	
	Если Массив.Найти(Значение)=Неопределено Тогда
		
		Массив.Добавить(Значение);
		
	КонецЕсли; 
	
КонецПроцедуры

// копирует массив
Функция м_СкопироватьМассив(Массив) Экспорт
	
	//Назначение: Копирует массив. Почему-то в 1С можно скопировать список, таблицу значений, дерево значений, но не структуру
	//ДатаСоздания: 20070620
	//Автор: Fixin
	//Тестирована: Нет
	Рез=Новый Массив();
	Для Каждого Эл ИЗ Массив Цикл
		Рез.Добавить(Эл);
	КонецЦикла;
	Возврат Рез;
	
КонецФункции

// копирует только уникальные значения массива
Функция м_СкопироватьУникальныеЗначения(Массив) Экспорт
	
	НовыйМассив = Новый Массив;
	Для каждого Элемент Из Массив Цикл
		
		м_ДобавитьУникально(НовыйМассив,Элемент);
		
	КонецЦикла; 
	
	Возврат(НовыйМассив);
	
КонецФункции

// объединяет массивы
Функция м_ОбъединитьМассивы(М1,М2, флНовый=Истина) Экспорт
	
	//Назначение: Объединяет массивы
	//ДатаСоздания: 20070610
	//Автор: Fixin
	//Тестирована: Нет
	Если флНовый Тогда
		Получатель=м_СкопироватьМассив(М1);
	Иначе
		Получатель=М1;
	КонецЕсли;
	
	Для Каждого Эл ИЗ М2 Цикл
		
		м_ДобавитьУникально(Получатель,Эл);
		//Получатель.Добавить(Эл);
	КонецЦикла;
	
	Возврат Получатель;
	
КонецФункции

// возвращает пересечение массивов
Функция м_ПересечьМассивы(М1,М2) Экспорт
	
	Если М1.Количество() >= М2.Количество() Тогда
		
		БольшойМассив = М1;
		МалыйМассив = М2;
		
	Иначе
		
		БольшойМассив = М2;
		МалыйМассив = М1;
		
	КонецЕсли; 
	
	ВозвращаемыйМассив = Новый Массив;
	
	Для каждого Элемент Из МалыйМассив Цикл
		
		Если БольшойМассив.Найти(Элемент)=Неопределено Тогда
			
			м_ДобавитьУникально(ВозвращаемыйМассив, Элемент);
			
		КонецЕсли; 
		
	КонецЦикла; 
	
	Возврат(ВозвращаемыйМассив);
	
КонецФункции

// массив в строку
Функция м_Представление(Массив,Разделитель=",",Реквизит=Неопределено) Экспорт 
	
	Представление = "";
	
	флИспользоватьРеквизит = ?(Реквизит=Неопределено,Ложь,Истина);
	
	Для каждого Стр Из Массив Цикл
		
		Если Представление <> "" Тогда
			
			Представление = Представление + Разделитель;
			
		КонецЕсли; 
		
		Представление = Представление + ?(флИспользоватьРеквизит, СокрЛП(Строка(Стр[Реквизит])), СокрЛП(Строка(Стр)));
		
	КонецЦикла;
	
	Возврат(Представление);
	
КонецФункции


