// создание списка
// СоответствиеРеквизитов: "Значение:Адрес1,Представление:Адрес2,Пометка:Адрес3", обязательно только значение
Функция сп_Создать(СоответствиеРеквизитов=Неопределено,Источник=Неопределено) Экспорт 
	
	Список = Новый СписокЗначений;
	// --- 
	Если Источник = Неопределено Тогда
		
		Возврат(Список);
		
	Иначе
		
		сп_Добавить(Список,СоответствиеРеквизитов,Источник);
		
	КонецЕсли; 
	// --- 
	Возврат(Список);
	
КонецФункции

// добавление элементов по коллекции
// см. сп_Создать
Функция сп_Добавить(Список,СоответствиеРеквизитов=Неопределено,Источник=Неопределено) Экспорт 
	// --- 
	
	Если СоответствиеРеквизитов = Неопределено Тогда
		
		Для каждого ЭлементКоллекции Из Источник Цикл
			
			Список.Добавить(ЭлементКоллекции);
			
		КонецЦикла; 
		
	Иначе
		
		МассивПолей = ПоляПоСтроке(СоответствиеРеквизитов);
		// анализируем
		АдресЗначения = "";
		АдресПредставления = "";
		АдресПометки = "";
		Для каждого Поле Из МассивПолей Цикл
			
			Если Поле.Заполнение Тогда
				
				Если Поле.Ключ = "Значение" Тогда
					
					АдресЗначения = Поле.Адрес;
					
				ИначеЕсли Поле.Ключ = "Представление" Тогда 
					
					АдресПредставления = Поле.Адрес; 
					
				ИначеЕсли Поле.Ключ = "Пометка" Тогда 
					
					АдресПометки = Поле.Адрес; 
					
				КонецЕсли; 
				
			КонецЕсли; 
			
		КонецЦикла; 
		// --- 
		Если АдресЗначения <> "" Тогда
			
			Для каждого ЭлементКоллекции Из Источник Цикл
				
				Список.Добавить(ЗначениеПоПутиДанных(ЭлементКоллекции,АдресЗначения),
				?(АдресПредставления <> "",ЗначениеПоПутиДанных(ЭлементКоллекции,АдресПредставления),Неопределено),
				?(АдресПометки <> "",ЗначениеПоПутиДанных(ЭлементКоллекции,АдресПометки),Неопределено));
				
			КонецЦикла; 
			
		КонецЕсли; 
		
	КонецЕсли; 
	
	// --- 
КонецФункции
  
