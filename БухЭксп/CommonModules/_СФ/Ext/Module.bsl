КонецФункции

Функция ВыполнитьЗапрос(Запрос, ПараметрыЗапроса = Неопределено, ПерваяСтрока=Ложь, РеквизитПервойСтроки=Неопределено,ВозвращаемоеЗначениеНезаполненного=Неопределено) Экспорт 
	
	Если (ТипЗнч(Запрос)=Тип("Строка")) Тогда
		
		ЗапросОбъект = Новый Запрос(Запрос);
		
	Иначе
		
		ЗапросОбъект = Запрос;
		
	КонецЕсли; 
	
	Если (ПараметрыЗапроса <> Неопределено) Тогда
		
		Для каждого КлючЗначение Из ПараметрыЗапроса Цикл
			
			ЗапросОбъект.УстановитьПараметр(КлючЗначение.Ключ, ПараметрыЗапроса[КлючЗначение.Ключ]); 
			
		КонецЦикла; 
		
	КонецЕсли; 
	
	ТЗ = ЗапросОбъект.Выполнить().Выгрузить();
	Если (НЕ ПерваяСтрока) Тогда
		
		Возврат(ТЗ);
		
	Иначе
		
		СтрокаРезультата = к_ПервыйЭлемент(ТЗ);
		Если (СтрокаРезультата = Неопределено) Тогда
			
			Возврат(ВозвращаемоеЗначениеНезаполненного);
			
		Иначе
			
			Если (РеквизитПервойСтроки = Неопределено) Тогда
				
				Возврат(СтрокаРезультата);
				
			Иначе
				
				ЗначениеРеквизита = СтрокаРезультата[РеквизитПервойСтроки];
				// --- 
				Если (ВозвращаемоеЗначениеНезаполненного <> Неопределено) Тогда
					
					Если (НЕ ЗначениеЗаполнено(ЗначениеРеквизита)) Тогда
						
						Возврат(ВозвращаемоеЗначениеНезаполненного);
						
					КонецЕсли; 
					
				КонецЕсли; 
				// --- 
				Возврат(ЗначениеРеквизита);
				
			КонецЕсли; 
			
		КонецЕсли; 
		
	КонецЕсли; 
	
КонецФункции
 

