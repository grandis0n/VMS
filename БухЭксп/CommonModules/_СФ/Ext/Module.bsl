// обёртка над Лев,Прав
Функция стр_Подстрока(Строка,Режим,Аргумент1,Аргумент2=Неопределено) Экспорт 
	// --- 
	
	Если Режим = "Л" Тогда
		
		Возврат(Лев(Строка,Аргумент1));
		
	ИначеЕсли Режим = "П" Тогда 
		
		 Возврат(Прав(Строка,Аргумент1));
		 
	ИначеЕсли Режим = "С" Тогда 
		
		Если Аргумент2 = Неопределено Тогда
			
			Возврат(Сред(Строка,Аргумент1));
			
		Иначе
			
			Возврат(Сред(Строка,Аргумент1,Аргумент2));
			
		КонецЕсли; 
		
	КонецЕсли; 
	
	// --- 
КонецФункции

