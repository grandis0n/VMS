// размер в человеческих единицах
Функция ф_ПриведенныйРазмер(Знач Размер) Экспорт 
	
	СписокЕдиниц = Новый СписокЗначений;
	СписокЕдиниц.Добавить("байт","Б");
	СписокЕдиниц.Добавить("килобайт","Кб");
	СписокЕдиниц.Добавить("мегабайт","Мб");
	СписокЕдиниц.Добавить("гигабайт","Гб");
	СписокЕдиниц.Добавить("терабайт","Тб");
	СписокЕдиниц.Добавить("петабайт","Пб");
	
	Разряд = 1;
	
	Пока 1 = 1 Цикл
		
		Результат = Размер/1024;
		Если Результат < 1024 Тогда
			СтрокаРазмера = Формат(Результат,"ЧЦ=10; ЧДЦ=1; ЧРГ=")+" "+СписокЕдиниц[Разряд-1].Представление;
			Возврат(СтрокаРазмера);
		Иначе
			Если Разряд = 6 Тогда
				СтрокаРазмера = Формат(Результат,"ЧЦ=10; ЧДЦ=1; ЧРГ=")+" "+СписокЕдиниц[Разряд-1].Представление;
				Возврат(СтрокаРазмера);
			Иначе
				Размер = Результат;
				Разряд = Разряд + 1;
			КонецЕсли; 
		КонецЕсли; 
	КонецЦикла; 
	
КонецФункции

