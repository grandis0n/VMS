// получает значение через точку 
// пример ф(Объект,"Реквизит1.Подреквизит1")
Функция ЗначениеПоПутиДанных(Объект,Адрес) Экспорт 
	// --- 
	
	// определяем, является ли адрес составным
	Если Найти(Адрес,".") <> 0 Тогда
		
		// это составной
		
		СтекРеквизитов = м_СоздатьИзСтроки(Адрес,".");
		ТекущийОбъект = Объект;
		Значение = Неопределено;
		Для каждого Реквизит Из СтекРеквизитов Цикл
			
			Попытка
				
				ТекущийОбъект = ТекущийОбъект[Реквизит];
				
			Исключение
				
				ТекущийОбъект = Неопределено;
				Прервать;
				
			КонецПопытки; 
			
		КонецЦикла; 
		
		Значение = ТекущийОбъект;
		
	Иначе
		
		Попытка
			Значение = Объект[Адрес];
		Исключение
		    Значение = Неопределено;
		КонецПопытки;		
		
	КонецЕсли; 
	
	Возврат(Значение);
	
	// --- 
КонецФункции

// проверяет условие
Функция Условие(ЛевоеЗначение,ВидСравненияКД,ПравоеЗначение=Неопределено) Экспорт 
	// --- 
	
	Если ВидСравненияКД=ВидСравненияКомпоновкиДанных.Равно Тогда 
		
		Возврат( (ЛевоеЗначение = ПравоеЗначение) );
		
	ИначеЕсли  ВидСравненияКД=ВидСравненияКомпоновкиДанных.НеРавно Тогда
		
		Возврат( НЕ (ЛевоеЗначение = ПравоеЗначение) );
		
	ИначеЕсли ВидСравненияКД=ВидСравненияКомпоновкиДанных.Заполнено Тогда 
		
		Возврат(ЗначениеЗаполнено(ЛевоеЗначение));
		
	ИначеЕсли ВидСравненияКД=ВидСравненияКомпоновкиДанных.НеЗаполнено Тогда 
		
		Возврат(НЕ ЗначениеЗаполнено(ЛевоеЗначение)); 
		
	ИначеЕсли ВидСравненияКД=ВидСравненияКомпоновкиДанных.Больше Тогда
		
		Возврат(ЛевоеЗначение > ПравоеЗначение);
		
	ИначеЕсли ВидСравненияКД=ВидСравненияКомпоновкиДанных.БольшеИлиРавно Тогда 
		
		Возврат(ЛевоеЗначение >= ПравоеЗначение);
		
	ИначеЕсли ВидСравненияКД=ВидСравненияКомпоновкиДанных.Меньше Тогда 
		
		Возврат(ЛевоеЗначение < ПравоеЗначение);
		
	ИначеЕсли ВидСравненияКД=ВидСравненияКомпоновкиДанных.МеньшеИлиРавно Тогда 
		
		Возврат(ЛевоеЗначение <= ПравоеЗначение);
		
	ИначеЕсли ВидСравненияКД=ВидСравненияКомпоновкиДанных.ВСписке Тогда 
		
		Возврат( (ПравоеЗначение.Найти(ЛевоеЗначение) <> Неопределено) );
		
	ИначеЕсли ВидСравненияКД=ВидСравненияКомпоновкиДанных.НеВСписке Тогда 
		
		Возврат( (ПравоеЗначение.Найти(ЛевоеЗначение) = Неопределено) );
		
	ИначеЕсли ВидСравненияКД=ВидСравненияКомпоновкиДанных.Содержит Тогда 
		
		Возврат(Найти(Строка(ЛевоеЗначение),ПравоеЗначение) <> 0 );
		
	ИначеЕсли ВидСравненияКД=ВидСравненияКомпоновкиДанных.НеСодержит Тогда 
		
		Возврат(Найти(Строка(ЛевоеЗначение),ПравоеЗначение) = 0 );
		
	КонецЕсли; 
	
	// --- 
КонецФункции

