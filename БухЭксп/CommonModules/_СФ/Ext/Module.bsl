// функция возвращает массив макросов по заданному критерию
Функция стр_СписокМакросов(Шаблон,Критерий="[]") Экспорт 
	// --- 
	
	МассивМакросов = Новый Массив;
	
	// --- 
	СтрокаШаблона = "";
	// формируем однострочную строку
	Если стр_ЧислоСтрок(Шаблон) > 1 Тогда
		
		Для Счетчик=1 По стр_ЧислоСтрок(Шаблон) Цикл
			
			стр_Добавить(СтрокаШаблона,стр_ПолучитьСтроку(Шаблон,,Счетчик));
			
		КонецЦикла; 
		
	Иначе
		
		стр_Добавить(СтрокаШаблона,Шаблон);
		
	КонецЕсли;
	// --- 
	ОткрывающийСимволМакроса = стр_Подстрока(Критерий,"Л",1);
	ЗакрывающийСимволМакроса = стр_Подстрока(Критерий,"П",1);
	// ---
	флПродолжения=Истина;
	Пока флПродолжения Цикл
		
		// нашли открывающий
		ПозицияОткрывающегоСимвола = Найти(СтрокаШаблона,ОткрывающийСимволМакроса);
		Если ПозицияОткрывающегоСимвола <> 0 Тогда
			
			// обрезаем начало
			СтрокаШаблона = стр_Подстрока(СтрокаШаблона,"С",ПозицияОткрывающегоСимвола+1);
			//ищем закрывающий
			ПозицияЗакрывающегоСимвола = Найти(СтрокаШаблона,ЗакрывающийСимволМакроса);
			Если ПозицияЗакрывающегоСимвола <> 0 Тогда
				
				// выделяем макрос
				Макрос = стр_Подстрока(СтрокаШаблона,"Л",ПозицияЗакрывающегоСимвола-1);
				Макрос = стр_Заменить(Макрос,ОткрывающийСимволМакроса,"");
				Макрос = стр_Заменить(Макрос,ЗакрывающийСимволМакроса,"");
				МассивМакросов.Добавить(Макрос);
				// обрезаем строку
				СтрокаШаблона = стр_Подстрока(СтрокаШаблона,"С",ПозицияЗакрывающегоСимвола+1);
				
			Иначе
				
				флПродолжения=Ложь;
				
			КонецЕсли; 
			
		Иначе
			
			флПродолжения=Ложь;
			
		КонецЕсли; 
		
	КонецЦикла; 
	
	// --- 
	Возврат(МассивМакросов);
	
	// --- 
КонецФункции

