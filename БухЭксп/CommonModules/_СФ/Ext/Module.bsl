// аналогично созданию ТЗ, 
// если колонок данных несколько, то они формируют структуру
Функция со_Создать(КолонкаИндекса=Неопределено,КолонкиДанных="",Источник=Неопределено) Экспорт
	
	Соответствие = Новый Соответствие;
	Если КолонкаИндекса <> Неопределено Тогда
		со_ДобавитьЭлементы(Соответствие,КолонкаИндекса,КолонкиДанных,Источник);		
	КонецЕсли; 
	
	Возврат(Соответствие);
КонецФункции

// добавляет элементы соотвествия из коллекции
Процедура со_ДобавитьЭлементы(Соответствие,РеквизитИндекса,КолонкиДанных="",Источник) Экспорт 
	// --- 
	
	МассивКолонокДанных = м_СоздатьИзСтроки(КолонкиДанных,",");
	ФормироватьСтруктуруДанных = (МассивКолонокДанных.Количество() > 1);
	
	// формируем структуру колонок данных
	Если ФормироватьСтруктуруДанных Тогда
		
		СоКД = Новый Соответствие;
		ШаблонСтруктуры = _сф.ст_Создать();
		Для каждого Свойство Из МассивКолонокДанных Цикл
			
			СтруктураСвойства = _СтруктураПоля(Свойство); 
			СоКД.Вставить(СтруктураСвойства.Ключ,СтруктураСвойства.Адрес);
			ШаблонСтруктуры.Вставить(СтруктураСвойства.Ключ);
			
		КонецЦикла; 
		
		Для каждого СтрокаИсточника Из Источник Цикл
			
			СД = ст_Скопировать(ШаблонСтруктуры);
			Для каждого ЭлементСоКД Из СоКД Цикл
				
				СД[ЭлементСоКД.Ключ]=ЗначениеПоПутиДанных(СтрокаИсточника,ЭлементСоКД.Значение);
				
			КонецЦикла; 
			Соответствие.Вставить(ЗначениеПоПутиДанных(СтрокаИсточника,РеквизитИндекса),СД);
			
		КонецЦикла;
		
	Иначе
		
		Для каждого ЭлементКоллекции Из Источник Цикл
			
			Если КолонкиДанных = "" Тогда
				
				Соответствие.Вставить(ЗначениеПоПутиДанных(ЭлементКоллекции,РеквизитИндекса),ЭлементКоллекции);
				
			Иначе
				
				Адрес = _СтруктураПоля(КолонкиДанных).Адрес;
				Соответствие.Вставить(ЗначениеПоПутиДанных(ЭлементКоллекции,РеквизитИндекса),ЗначениеПоПутиДанных(ЭлементКоллекции,Адрес));	
				
			КонецЕсли; 
			
			
		КонецЦикла; 
		
	КонецЕсли; 
	
	Возврат
	
	// --- 
КонецПроцедуры

