// формирование списка по строке
Функция сп_СоздатьИзСтроки(Строка,Разделитель=",",Пометка=Ложь) Экспорт 
	
	Строки = СтрЗаменить(Строка,Разделитель,Символы.ПС);
	Список = Новый СписокЗначений;
	
	Для Индекс=1 По СтрЧислоСтрок(Строки) Цикл
		
		Список.Добавить(СтрПолучитьСтроку(Строки,Индекс));
		
	КонецЦикла; 
	
	Если Пометка Тогда
		
		Список.ЗаполнитьПометки(Пометка);
		
	КонецЕсли; 
	
	Возврат(Список);
	
КонецФункции

