// получает строку, если задан разделитель - разбивает по нему и возвращает строку
Функция стр_ПолучитьСтроку(Строка,Разделитель=Неопределено,НомерСтроки) Экспорт 
	
	Если Разделитель=Неопределено Тогда
		
		Возврат(СтрПолучитьСтроку(Строка,НомерСтроки));
		
	Иначе
		
		Строки = стр_РазбитьНаСтроки(Строка,Разделитель);
		Возврат(СтрПолучитьСтроку(Строки,НомерСтроки));
		
	КонецЕсли; 
	
КонецФункции

