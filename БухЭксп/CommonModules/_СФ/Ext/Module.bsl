Процедура УстановитьПоУсловию(Переменная,Значение,Условие=Неопределено) Экспорт 
	// --- 
	
	Если Условие=Неопределено Тогда
		
		Если ЗначениеЗаполнено(Значение) Тогда
			
			Переменная = Значение;
			
		КонецЕсли;
		
	ИначеЕсли Условие=Истина Тогда 
		
		 Переменная = Значение;
		
	КонецЕсли; 
	
	// --- 
КонецПроцедуры

