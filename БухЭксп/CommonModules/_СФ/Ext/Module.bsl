// формирует таблицу значений из элементов коллекции или реквизитов элементов коллекции
Функция т_СоздатьИзКоллекции(Коллекция, Реквизит="") Экспорт
	
	Таблица = Новый ТаблицаЗначений;
	
	флФормироватьПоРеквизиту = ?(Реквизит="",Ложь,Истина);
	
	Если НЕ флФормироватьПоРеквизиту Тогда
		
		Таблица.Колонки.Добавить("Элемент");
		
	Иначе
		
		Таблица.Колонки.Добавить(Реквизит);
		
	КонецЕсли; 
	
	Для каждого Стр Из Коллекция Цикл
		
		Если флФормироватьПоРеквизиту Тогда
			
			Нстр = Таблица.Добавить();
			Нстр[Реквизит]=Стр[Реквизит];
			
		Иначе
			
			Нстр = Таблица.Добавить();
			Нстр["Элемент"]=Стр;
			
		КонецЕсли; 
		
	КонецЦикла; 
	
	Возврат(Таблица);
	
КонецФункции

// формирует представление значений колонки таблицы
Функция т_ПредставлениеКолонки(Таблица,ИмяКолонки,Разделитель=",") Экспорт
	
	Представление = "";
	
	Для каждого Стр Из Таблица Цикл
		
		Если Представление <> "" Тогда
			
			Представление = Представление + Разделитель;
			
		КонецЕсли; 
		
		Представление = Представление + стр_Сократить(Стр[ИмяКолонки]);
		
	КонецЦикла; 
	
	Возврат(Представление);
	
КонецФункции

// ообъединяет таблицы по заданному набору колонок или целиком
Функция т_ОбъединитьТаблицы(Таблица1,Таблица2,НаборКолонок=Неопределено) Экспорт 
	
	// если в качестве набора колонок передано "неопределено", то формируется объединение колонок - 
	// если "" - формируется таблица только с общими колонками
	// если список через запятую - указанные колонки
	
	Если НаборКолонок = Неопределено Тогда
		
		СписокКолонок1 = сп_СоздатьИзКоллекции(Таблица1.Колонки,"Имя");
		СписокКолонок2 = сп_СоздатьИзКоллекции(Таблица2.Колонки,"Имя");
		
		СписокКолонок = сп_ОбъединениеСписков(СписокКолонок1,СписокКолонок2);
				
		Таблица = Новый ТаблицаЗначений;
		Для каждого Колонка Из СписокКолонок Цикл
			
			Таблица.Колонки.Добавить(Колонка.Значение);
			
		КонецЦикла; 
		
		Для каждого СтрокаТЗ Из Таблица1 Цикл
			
			Нстр = Таблица.Добавить();
			ЗаполнитьЗначенияСвойств(Нстр,СтрокаТЗ);
			
		КонецЦикла; 
		Для каждого СтрокаТЗ Из Таблица2 Цикл
			
			Нстр = Таблица.Добавить();
			ЗаполнитьЗначенияСвойств(Нстр,СтрокаТЗ);
			
		КонецЦикла; 
		
		Возврат(Таблица);
		
	ИначеЕсли НаборКолонок = "" Тогда
		
		СписокКолонок1 = сп_СоздатьИзКоллекции(Таблица1.Колонки,"Имя");
		СписокКолонок2 = сп_СоздатьИзКоллекции(Таблица2.Колонки,"Имя");
		
		СписокКолонок = Новый СписокЗначений; // здесь должна быть функция пересечения колонок
		
		Таблица = Новый ТаблицаЗначений;
		Для каждого Колонка Из СписокКолонок Цикл
			
			Таблица.Колонки.Добавить(Колонка.Значение);
			
		КонецЦикла;
		
		Для каждого СтрокаТЗ Из Таблица1 Цикл
			
			Нстр = Таблица.Добавить();
			ЗаполнитьЗначенияСвойств(Нстр,СтрокаТЗ);
			
		КонецЦикла; 
		Для каждого СтрокаТЗ Из Таблица2 Цикл
			
			Нстр = Таблица.Добавить();
			ЗаполнитьЗначенияСвойств(Нстр,СтрокаТЗ);
			
		КонецЦикла; 
		
		Возврат(Таблица);
		
	Иначе
		
		СписокКолонок = сп_СоздатьИзСтроки(НаборКолонок);		
		Таблица = Новый ТаблицаЗначений;
		Для каждого Колонка Из СписокКолонок Цикл
			
			Таблица.Колонки.Добавить(Колонка.Значение);
			
		КонецЦикла; 
		
		Для каждого СтрокаТЗ Из Таблица1 Цикл
			
			Нстр = Таблица.Добавить();
			ЗаполнитьЗначенияСвойств(Нстр,СтрокаТЗ);
			
		КонецЦикла; 
		Для каждого СтрокаТЗ Из Таблица2 Цикл
			
			Нстр = Таблица.Добавить();
			ЗаполнитьЗначенияСвойств(Нстр,СтрокаТЗ);
			
		КонецЦикла; 
		
		Возврат(Таблица);
				
	КонецЕсли; 
		
КонецФункции

// функция быстрого добавления строки таблицы, до 8 колонок
Функция т_ДобавитьСтроку(Таблица,Колонка1=Неопределено,Колонка2=Неопределено,Колонка3=Неопределено,Колонка4=Неопределено,Колонка5=Неопределено,Колонка6=Неопределено,Колонка7=Неопределено,Колонка8=Неопределено) Экспорт 
	// --- 
	
	СписокАргументов = Новый СписокЗначений;
	СписокАргументов.Добавить(Колонка1);
	СписокАргументов.Добавить(Колонка2);
	СписокАргументов.Добавить(Колонка3);
	СписокАргументов.Добавить(Колонка4);
	СписокАргументов.Добавить(Колонка5);
	СписокАргументов.Добавить(Колонка6);
	СписокАргументов.Добавить(Колонка7);
	СписокАргументов.Добавить(Колонка8);
	
	Нстр = Таблица.Добавить();
	
	Для каждого Колонка Из Таблица.Колонки Цикл
		
		Нстр[Колонка.Имя]=СписокАргументов[Таблица.Колонки.Индекс(Колонка)].Значение;
		
	КонецЦикла; 
	
	Возврат(Нстр);
	
	// --- 
КонецФункции

// группирует таблицу
Функция т_Сгруппировать(Таблица,РеквизитыГруппировки,Ресурсы) Экспорт 
	// --- 
	
	// формируем новую таблицу: реквизиты группировки - ресурсы
	МассивРеквизитовГруппировки = ПоляПоСтроке(РеквизитыГруппировки);
	МассивРесурсов = ПоляПоСтроке(Ресурсы);
	// --- 
	НоваяТаблица = т_Создать(РеквизитыГруппировки+","+Ресурсы,Таблица);
	// --- 
	КолонкиГруппировки = м_Представление(МассивРеквизитовГруппировки,",","Ключ");
	ТаблицаГруппировки = т_СкопироватьСвернуть(НоваяТаблица,КолонкиГруппировки);
	// добавляем колонку со значением
	т_ДобавитьКолонку(ТаблицаГруппировки,"Элементы");
	// --- 
	// теперь производим свертку
	ФормироватьСтруктуру = (Количество(МассивРесурсов)<>1);
	КолонкиРесурсов = м_Представление(МассивРесурсов,",","Ключ");
	Если ФормироватьСтруктуру Тогда
		
		Шаблон = ст_Создать(КолонкиРесурсов);
		
	КонецЕсли; 
	// --- 
	Отбор = ст_Создать(КолонкиГруппировки);
	// --- 
	Для каждого НаборИзмерений Из ТаблицаГруппировки Цикл
		
		ст_ЗаполнитьПоСтрокеТаблицы(Отбор,НаборИзмерений);
		Результат = к_НайтиСтроки(НоваяТаблица,Отбор);
		Элементы = м_Создать();
		Для каждого СтрокаРезультата Из Результат Цикл
			
			Если ФормироватьСтруктуру Тогда
				
				НовыйЭлемент = ст_Скопировать(Шаблон);
				ст_ЗаполнитьПоСтрокеТаблицы(НовыйЭлемент,СтрокаРезультата);
				Элементы.Добавить(НовыйЭлемент);
				
			Иначе
				
				Элементы.Добавить(СтрокаРезультата[КолонкиРесурсов]);
				
			КонецЕсли; 
			
		КонецЦикла; 
		НаборИзмерений.Элементы = Элементы;
		
	КонецЦикла; 
	
	// --- 
	
	Возврат(ТаблицаГруппировки);
	
	// --- 
КонецФункции

