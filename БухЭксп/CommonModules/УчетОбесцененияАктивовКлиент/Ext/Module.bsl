// Модуль предназначен для работы с подсистемой ОбесценениеЗапасов, поставляемой в составе версии КОРП.
// Содержимое модуля отличается в версиях ПРОФ и КОРП.
// В версии ПРОФ отсутствует:
// - тело экспортных процедур (остаются только сигнатуры методов)
// - неэкспортные процедуры и все функции.
// Поэтому не допускается реализация в модуле экспортных функций: вместо них следует использовать процедуры с возвращаемым параметром.

#Область ПрограммныйИнтерфейс

// Открывает форму списка документов "ОбесценениеЗапасов" при выборе соответствующей команды меню закрытия месяца.
//
// Параметры:
//   Форма - УправляемаяФорма - форма, из которой вызывается процедура
//   Команда - Строка - идентификатор команды меню. Обрабатывается только команда "ОбесценениеЗапасов"
//   СтрокаТаблицы - Строка табличной части - содержит ссылку для идентификации открываемой формы
//
Процедура НажатиеКнопкиМенюФормыЗакрытиеМесяца(Форма, Команда, СтрокаТаблицы) Экспорт

	Если Команда = "ОбесценениеЗапасов" Тогда
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("Организация", Форма.Объект.Организация);
		ПараметрыФормы.Вставить("Период",      КонецМесяца(Форма.Объект.ПериодРегистрации));
		
		ОткрытьФорму(
			"Документ.ОбесценениеЗапасов.ФормаСписка",
			ПараметрыФормы,
			Форма,
			СтрокаТаблицы.Ссылка);
			
	КонецЕсли;

КонецПроцедуры

// Открывает форму списка документа "Обесценение запасов" в режиме простого интерфейса.
//
// Параметры:
//   Форма - УправляемаяФорма - форма-владелец, в окне которой будет открыта форма списка
//   ОткрытыеФормы - Соответствие, Неопределено - коллекция открытых форм для поиска дубликатов
//
Процедура ОбесценениеЗапасовПростойИнтерфейс(Форма, ОткрытыеФормы) Экспорт

	ПростойИнтерфейсКлиент.ОткрытьФормуВОкнеФормы("Документ.ОбесценениеЗапасов.ФормаСписка",
		Форма, , , ОткрытыеФормы);

КонецПроцедуры

#КонецОбласти