Функция ПолучитьСтавкуНДС(ПараметрыФункции) Экспорт
	
	ПодставлятьСтавкуНДС = ?(ПараметрыФункции.Свойство("ПодставлятьСтавкуНДС"),ПараметрыФункции.ПодставлятьСтавкуНДС,Ложь);
	
	Если ПодставлятьСтавкуНДС Тогда
		СтавкаНДС = СтавкаНДС(ПараметрыФункции.Номенклатура, ПараметрыФункции.Дата);
	Иначе
		ДатаСтавки = ?(ПараметрыФункции.Дата = Неопределено, ТекущаяДата(), ПараметрыФункции.Дата);
		Если ПараметрыФункции.ТипДвижения = "ДОХОДЫ" Тогда 
			СтавкаНДС = УчетНДСКлиентСервер.СтавкаНДСПриРеализации(ДатаСтавки, ПараметрыФункции.Организация);
		КонецЕсли;  
		
		Если ПараметрыФункции.ТипДвижения = "РАСХОДЫ" Тогда 
			Если ПараметрыФункции.Договор.БухгалтерскийУчет 
				И ЗначениеЗаполнено(ПараметрыФункции.Договор.УчетныйДоговор) Тогда
				СтавкаНДС = ПараметрыФункции.Договор.УчетныйДоговор.СтавкаНДС;  
			КонецЕсли;
			Если Не ЗначениеЗаполнено(СтавкаНДС) Тогда
				СтавкаНДС = СтавкаНДС(ПараметрыФункции.Номенклатура, ДатаСтавки);
			КонецЕсли; 
		КонецЕсли; 
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(СтавкаНДС) Тогда  
		СтавкаНДС = Перечисления.СтавкиНДС.БезНДС;	
	КонецЕсли;
	
	Возврат СтавкаНДС;
	
КонецФункции 

