Процедура СоздатьДокументыСчетФактураВыданныйСВидомНалоговыйАгент(Объект) Экспорт 
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	CW_СчетаФактурыНалоговыхАгентов.Контрагент КАК Контрагент,
	|	CW_СчетаФактурыНалоговыхАгентов.ДоговорКонтрагента КАК ДоговорКонтрагента,
	|	CW_СчетаФактурыНалоговыхАгентов.СчетФактура КАК СчетФактура
	|ИЗ
	|	РегистрСведений.CW_СчетаФактурыНалоговыхАгентов КАК CW_СчетаФактурыНалоговыхАгентов
	|ГДЕ
	|	CW_СчетаФактурыНалоговыхАгентов.ВедущийДокумент = &ВедущийДокумент";  
	
	Запрос.УстановитьПараметр("ВедущийДокумент", Объект.Ссылка);
	
	РезультатСчетаФактурыНалоговогоАгента 	= Запрос.Выполнить();
	ВыборкаСчетаФактурыНалоговогоАгента 	= РезультатСчетаФактурыНалоговогоАгента.Выбрать();
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	CW_ДоходыПоГрузоперевозкам.ДокументРасходов.Контрагент КАК Поставщик,
	|	ВЫБОР
	|		КОГДА CW_ДоходыПоГрузоперевозкам.ПриложениеКДоговору = ЗНАЧЕНИЕ(Справочник.CW_ПриложенияКДоговорам.ПустаяССЫлка)
	|			ТОГДА CW_ДоходыПоГрузоперевозкам.ДокументРасходов.Договор.УчетныйДоговор
	|		ИНАЧЕ CW_ДоходыПоГрузоперевозкам.ДокументРасходов.ПриложениеКДоговору.УчетныйДоговор
	|	КОНЕЦ КАК УчетныйДоговор,
	|	ВЫБОР
	|		КОГДА CW_ДоходыПоГрузоперевозкам.ПриложениеКДоговору = ЗНАЧЕНИЕ(Справочник.CW_ПриложенияКДоговорам.ПустаяССЫлка)
	|			ТОГДА CW_ДоходыПоГрузоперевозкам.ДокументРасходов.Договор
	|		ИНАЧЕ CW_ДоходыПоГрузоперевозкам.ДокументРасходов.ПриложениеКДоговору
	|	КОНЕЦ КАК ДоговорПриложение,
	|	CW_ДоходыПоГрузоперевозкам.СтавкаНДС КАК СтавкаНДС,
	|	CW_ДоходыПоГрузоперевозкам.Сумма КАК Сумма,
	|	CW_ДоходыПоГрузоперевозкам.НДС КАК НДС,
	|	CW_ДоходыПоГрузоперевозкам.Всего КАК Всего
	|ПОМЕСТИТЬ ВТ_Перевыставления
	|ИЗ
	|	РегистрНакопления.CW_ДоходыПоГрузоперевозкам КАК CW_ДоходыПоГрузоперевозкам
	|ГДЕ
	|	CW_ДоходыПоГрузоперевозкам.Регистратор = &Регистратор
	|	И CW_ДоходыПоГрузоперевозкам.ПорядокОтражения = ЗНАЧЕНИЕ(Перечисление.CW_ПорядокОтраженияДоходов.Перевыставление)
	|	И CW_ДоходыПоГрузоперевозкам.СтавкаНДС <> Значение(Перечисление.СтавкиНДС.БезНДС)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Перевыставления.Поставщик КАК Поставщик,
	|	ВТ_Перевыставления.УчетныйДоговор КАК УчетныйДоговор,
	|	ВТ_Перевыставления.УчетныйДоговор.НаименованиеДляСчетаФактурыНаАванс КАК Номенклатура,
	|	ВТ_Перевыставления.СтавкаНДС КАК СтавкаНДС,
	|	СУММА(ВТ_Перевыставления.Сумма) КАК Сумма,
	|	СУММА(ВТ_Перевыставления.НДС) КАК НДС,
	|	СУММА(ВТ_Перевыставления.Всего) КАК Всего
	|ИЗ
	|	ВТ_Перевыставления КАК ВТ_Перевыставления
	|ГДЕ
	|	ВТ_Перевыставления.ДоговорПриложение.БухгалтерскийУчет = ИСТИНА
	|	И ВТ_Перевыставления.УчетныйДоговор.УчетАгентскогоНДС = ИСТИНА
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_Перевыставления.Поставщик,
	|	ВТ_Перевыставления.УчетныйДоговор,
	|	ВТ_Перевыставления.СтавкаНДС,
	|	ВТ_Перевыставления.УчетныйДоговор.НаименованиеДляСчетаФактурыНаАванс"; 
	
	Запрос.УстановитьПараметр("Регистратор", Объект.Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();   
	
	ОтветственныеЛица = ОтветственныеЛицаБППереопределяемый.ОтветственныеЛица(Объект.Организация, Объект.Дата);
	
	Выборка = РезультатЗапроса.Выбрать();   

	Пока Выборка.Следующий() Цикл  
		
		Отбор = Новый Структура;
		Отбор.Вставить("Контрагент", 			Выборка.Поставщик);
		Отбор.Вставить("ДоговорКонтрагента", 	Выборка.УчетныйДоговор); 
		
		СчетФактураНалоговогоАгентаСсылка = Неопределено;
		
		ВыборкаСчетаФактурыНалоговогоАгента.Сбросить();
		Если ВыборкаСчетаФактурыНалоговогоАгента.НайтиСледующий(Отбор) Тогда
			СчетФактураНалоговогоАгентаСсылка = ВыборкаСчетаФактурыНалоговогоАгента.СчетФактура;	
		КонецЕсли;
		
		Если СчетФактураНалоговогоАгентаСсылка <> Неопределено Тогда
			СчетФактураНалоговогоАгента = СчетФактураНалоговогоАгентаСсылка.ПолучитьОбъект();   
		Иначе
			СчетФактураНалоговогоАгента = Документы.СчетФактураВыданный.СоздатьДокумент();
			СчетФактураНалоговогоАгента.ВидСчетаФактуры 	= ПредопределенноеЗначение("Перечисление.ВидСчетаФактурыВыставленного.НалоговыйАгент");
			СчетФактураНалоговогоАгента.КодВидаОперации 	= "06";
			СчетФактураНалоговогоАгента.Руководитель 		= ОтветственныеЛица.Руководитель;
			СчетФактураНалоговогоАгента.ГлавныйБухгалтер 	= ОтветственныеЛица.ГлавныйБухгалтер;
			СчетФактураНалоговогоАгента.ДокументОснование 	= Объект.ВедомыйДокумент;
		КонецЕсли;
		
		СчетФактураНалоговогоАгента.Дата 				= Объект.ДатаСчетаФактуры;                                                                        
		СчетФактураНалоговогоАгента.Организация 		= Объект.Организация;
		СчетФактураНалоговогоАгента.Контрагент 			= Выборка.Поставщик;
		СчетФактураНалоговогоАгента.ДоговорКонтрагента 	= Выборка.УчетныйДоговор;
		
		СчетФактураНалоговогоАгента.Авансы.Очистить();
		
		СтрокаАвансы = СчетФактураНалоговогоАгента.Авансы.Добавить();
		СтрокаАвансы.Номенклатура 	= Выборка.Номенклатура; 
		СтрокаАвансы.Содержание 	= СокрЛП(Выборка.Номенклатура); 
		
		СтрокаАвансы.СтавкаНДС 	= Выборка.СтавкаНДС; 
		СтрокаАвансы.Сумма 		= Выборка.Всего; 
		СтрокаАвансы.СуммаНДС 	= Выборка.НДС; 
		
		Попытка
			СчетФактураНалоговогоАгента.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
			СчетФактураНалоговогоАгента.Записать(РежимЗаписиДокумента.Запись);
		КонецПопытки; 
		
		ИзмеренияРегистра = Новый Структура;
		ИзмеренияРегистра.Вставить("ВедущийДокумент", 		Объект.Ссылка);
		ИзмеренияРегистра.Вставить("Контрагент", 			Выборка.Поставщик);
		ИзмеренияРегистра.Вставить("ДоговорКонтрагента", 	Выборка.УчетныйДоговор); 
		ИзмеренияРегистра.Вставить("СчетФактура", 			СчетФактураНалоговогоАгента.Ссылка); 
		
		РегистрыСведений.CW_СчетаФактурыНалоговыхАгентов.ДобавитьЗаписьВедомыеДокументы(ИзмеренияРегистра);
		
	КонецЦикла;
	
	Если Выборка.Количество() > 0 Тогда
		СчетФактура = Объект.ВедомыйСчетФактура.ПолучитьОбъект();
		Попытка
			СчетФактура.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
			СчетФактура.Записать(РежимЗаписиДокумента.Запись);
		КонецПопытки;                  
	КонецЕсли;
	
	
КонецПроцедуры
