		Модуль_CW_РеестрыНДС0Сервер = CW_ОбщегоНазначения.ОбщийМодуль("CW_РеестрыНДС0Сервер");
		Если Модуль_CW_РеестрыНДС0Сервер <> Неопределено Тогда
			Модуль_CW_РеестрыНДС0Сервер.ПриДобавленииПодсистем(ОписаниеПодсистем);	
		КонецЕсли;
	КонецЕсли; 	 
	//CW_РеестрыНДС0  
	
  	//CW_ДоходыНерезидентов
	Если CW_ВерсииПодсистемСервер.СуществуетПодсистема("CW_БухгалтерияЭкспедитораДляРоссии.CW_ДоходыНерезидентов") Тогда  
		Модуль_CW_ДоходыНерезидентовСервер = CW_ОбщегоНазначения.ОбщийМодуль("CW_ДоходыНерезидентовСервер");
		Если Модуль_CW_ДоходыНерезидентовСервер <> Неопределено Тогда
			Модуль_CW_ДоходыНерезидентовСервер.ПриДобавленииПодсистем(ОписаниеПодсистем);	
		КонецЕсли;
	КонецЕсли; 	 
	//CW_ДоходыНерезидентов
	
	//CW_ОбменГИСЭПД
	Если CW_ВерсииПодсистемСервер.СуществуетПодсистема("CW_БухгалтерияЭкспедитораДляРоссии.CW_ОбменГИСЭПД") Тогда  
		Модуль_CW_ОбменГИСЭПДСервер = CW_ОбщегоНазначения.ОбщийМодуль("CW_ОбменГИСЭПДСервер");
		Если Модуль_CW_ОбменГИСЭПДСервер <> Неопределено Тогда
			Модуль_CW_ОбменГИСЭПДСервер.ПриДобавленииПодсистем(ОписаниеПодсистем);	
		КонецЕсли;
	КонецЕсли; 	 
	//CW_ОбменГИСЭПД
	
