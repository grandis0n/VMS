Функция ПараметрыУчетнойПолитикиБП(Организация, Дата) Экспорт

	УстановитьПривилегированныйРежим(Истина);
	
	ПараметрыУчетнойПолитики = Новый Структура("СистемаНалогообложения,ДатаПереходаНаУСН,ОбъектНалогообложенияУСН,РаздельныйУчетНДСНаСчете19,СложныйУчетНДС,ПлательщикНДСПрименяющийУСН"); 
	
	Если Не ЗначениеЗаполнено(Организация) Тогда
		Возврат ПараметрыУчетнойПолитики;
	КонецЕсли;
	
	ТЗНастройкиНалогообложения = НастройкиУчета.УчетнаяПолитикаНалоговыйУчет(Дата,Организация);
	Если ТЗНастройкиНалогообложения <> Неопределено Тогда
		НастройкиНалогообложения = ТЗНастройкиНалогообложения[0];
		ПараметрыУчетнойПолитики.Вставить("СистемаНалогообложения",НастройкиНалогообложения.СистемаНалогообложения);
		ПараметрыУчетнойПолитики.Вставить("ДатаПереходаНаУСН",НастройкиНалогообложения.ДатаПереходаНаУСН);
		ПараметрыУчетнойПолитики.Вставить("ОбъектНалогообложенияУСН",НастройкиНалогообложения.ОбъектНалогообложенияУСН);  
		ПараметрыУчетнойПолитики.Вставить("ПлательщикНДСПрименяющийУСН",НастройкиНалогообложения.ПлательщикНДСПрименяющийУСН);
	Иначе
		Сообщить("Не задана учётная политика по налогообложению");
	КонецЕсли; 

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	НастройкиУчетаНДССрезПоследних.УпрощенныйУчетНДС,
	|	НастройкиУчетаНДССрезПоследних.РаздельныйУчетНДСНаСчете19,
	|	НастройкиУчетаНДССрезПоследних.СложныйУчетНДС
	|ИЗ
	|	РегистрСведений.НастройкиУчетаНДС.СрезПоследних(&Дата, Организация = &Организация) КАК НастройкиУчетаНДССрезПоследних";
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("Организация", Организация);
	НастройкиНДС = _сф.ВыполнитьЗапрос(Запрос,,Истина);
	Если (НастройкиНДС <> Неопределено) Тогда
		ПараметрыУчетнойПолитики.Вставить("РаздельныйУчетНДСНаСчете19",НастройкиНДС.РаздельныйУчетНДСНаСчете19);
		ПараметрыУчетнойПолитики.Вставить("СложныйУчетНДС",НастройкиНДС.СложныйУчетНДС);
	Иначе
		ПараметрыУчетнойПолитики.Вставить("РаздельныйУчетНДСНаСчете19",Ложь);
		ПараметрыУчетнойПолитики.Вставить("СложныйУчетНДС",Ложь);
	КонецЕсли; 
	
	Возврат ПараметрыУчетнойПолитики;

КонецФункции

