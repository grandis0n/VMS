Функция ПолучитьНДСДляУСН(Организация, Дата) Экспорт

	//5% (при доходе до 250 млн рублей)(0), 
	//7% (при доходе до 450 млн рублей)(1), 
	//20% (при доходе свыше 450 млн рублей или добровольно, с правом на вычет)(2)
	
	СоответствиеСтавок = Новый Соответствие;
	СоответствиеСтавок.Вставить(0, ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС5"));
	СоответствиеСтавок.Вставить(1, ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС7"));
	СоответствиеСтавок.Вставить(2, ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС20"));  
	
	СтавкаНалогообложенияПриУСН = СтавкаНалогообложенияПриУСН(Организация, Дата);
	ИндексСтавкиНДС = НастройкиСистемыНалогообложенияФормы.ИндексСтавкиНДСПоЗначению(СтавкаНалогообложенияПриУСН);
	
	СтавкаНДС = СоответствиеСтавок.Получить(ИндексСтавкиНДС);
	Если СтавкаНДС = Неопределено Тогда
		СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.ПустаяСсылка");
	КонецЕсли;
	
	Возврат СтавкаНДС;
	
КонецФункции  

Функция СтавкаНалогообложенияПриУСН(Организация, Дата)
	
	// Получим значение ставки НДС в следующем году
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("КонецГода", 	 КонецГода(Дата));
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	НастройкиУчетаНДС.СтавкаНалогообложенияПриУСН КАК СтавкаНалогообложенияПриУСН
	|ИЗ
	|	РегистрСведений.НастройкиУчетаНДС КАК НастройкиУчетаНДС
	|ГДЕ
	|	НастройкиУчетаНДС.Период > &КонецГода
	|	И НастройкиУчетаНДС.Организация = &Организация
	|
	|УПОРЯДОЧИТЬ ПО
	|	НастройкиУчетаНДС.Период";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.СтавкаНалогообложенияПриУСН;
	КонецЕсли;

	Возврат Перечисления.ВидыСтавокНДС.ПустаяСсылка();
	
КонецФункции



