Функция ПолучитьСпискиВыбораЗначенияТекущегоТитула(ТекущийТитул) Экспорт
	
	Соответствие = Новый Соответствие;

	Если ТекущийТитул = ПредопределенноеЗначение("Перечисление.ТипыЭлементовРегламентаЭДО.ЭЗЗ_Титул1") Тогда 
		Соответствие.Вставить("ТитулГрузоотправителяУполномоченныеЛица_Полномочия", 			СписокПолномочий());
		Соответствие.Вставить("ТитулГрузоотправителяАдресаПунктовПогрузкиИВыгрузки_Операция", 	СписокОпераций());
		Соответствие.Вставить("ТитулГрузоотправителяГрузы_МетодОпределенияМассыГруза", 			СписокМетодовОпеределенияМассы());
		Соответствие.Вставить("ТитулГрузоотправителяФункция", 									СписокФункций());
	КонецЕсли; 
	
	Если ТекущийТитул = ПредопределенноеЗначение("Перечисление.ТипыЭлементовРегламентаЭДО.ЭЗЗ_Титул2") Тогда 
		Соответствие.Вставить("ВариантПодтверждения", 								СписокВариантовПодтверждения());
		Соответствие.Вставить("ТитулПеревозчикаНалоговаяСтавка ", 					ПолучитьСписокНалоговыхСтавок());
		Соответствие.Вставить("ТитулПеревозчикаТранспортноеСредствоТипВладения", 	ПолучитьСписокТиповВладения()); 
		Соответствие.Вставить("ТитулПеревозчикаПрицепы_ТипВладения", 				ПолучитьСписокТиповВладения()); 
	КонецЕсли;
      
	Если ТекущийТитул = ПредопределенноеЗначение("Перечисление.ТипыЭлементовРегламентаЭДО.ЭТрН_Титул1") Тогда  
		Соответствие.Вставить("ТитулГрузоотправителяГрузы_ОтгрузочноеНаименованиеГруза", 		СписокОтгрузочноеНаименованиеГруза());
		Соответствие.Вставить("ТитулГрузоотправителяПереченьМаркировокГруза_МаркировкаГруза", 	СписокМаркировкаГруза());
		Соответствие.Вставить("ТитулГрузоотправителяЛицоИмеющееПолномочияПереадресовки", 		ПолучитьСписокПолномочийПереадресовки());
		Соответствие.Вставить("ТитулГрузоотправителяСпособПередачиУказанияНаПереадресовку", 	ПолучитьСписокСпособаПередачиУказанияНаПереадресовку());
		Соответствие.Вставить("ТитулГрузоотправителяЛицоОсуществляющееПогрузкуЯвляетсяГрузоотправителем", ПолучитьСписокЛицОсуществляющееПогрузку());
		Соответствие.Вставить("ТитулГрузоотправителяКодМетодаОпределенияМассыГруза", 			СписокМетодовОпеределенияМассы());
		Соответствие.Вставить("ТитулГрузоотправителяВладелецПунктаПогрузкиЯвляетсяГрузоотправителем", СписокВладелецПунктаПогрузки());
		Соответствие.Вставить("ТитулГрузоотправителяОтметкиГрузоотправителя_ОписаниеОбстоятельств", СписокОписаниеОбстоятельств()); 
		Соответствие.Вставить("ТитулГрузоотправителяТранспортноеСредствоТипВладения", 	ПолучитьСписокТиповВладения()); 
		Соответствие.Вставить("ТитулГрузоотправителяПрицепы_ТипВладения", 				ПолучитьСписокТиповВладения()); 
		Соответствие.Вставить("ВариантОснованияПолномочий", 							СписокВариантОснованияПолномочий());
		
		Соответствие.Вставить("ТитулГрузоотправителяТранспортноеСредствоТип",	СписокТиповТС());
		Соответствие.Вставить("ТитулГрузоотправителяПрицепы_Тип",				СписокТиповПрицепов());

	КонецЕсли; 	 
	
	Если ТекущийТитул = ПредопределенноеЗначение("Перечисление.ТипыЭлементовРегламентаЭДО.ЭПЛ_Титул1") Тогда  
		Соответствие.Вставить("ТитулОформлениеПризнакНачалаРейса", 			СписокПризнакНачалаРейса());
		Соответствие.Вставить("ТитулОформлениеСведенияОВидеПеревозки", 		СписокСведенияОВидеПеревозки());
		Соответствие.Вставить("ТитулОформлениеВидКоммерческойПеревозки", 	СписокВидКоммерческойПеревозки());
		Соответствие.Вставить("ТитулОформлениеВидСообщения", 				СписокВидСообщения());
		Соответствие.Вставить("ТитулОформлениеОформительСтатус", 			СписокОформительСтатус());
		Соответствие.Вставить("ВариантМедосмотр", 							СписокВариантКонтроля());
		Соответствие.Вставить("ВариантТехконтроль", 						СписокВариантКонтроля());
		Соответствие.Вставить("ВариантПоказанияОдометра", 					СписокВариантКонтроля());
		Соответствие.Вставить("ТитулОформлениеПризнакФормированияПутевогоЛистаНаОдинДень", 	СписокПризнакФормированияПутевогоЛиста());
		Соответствие.Вставить("ТитулОформлениеТранспортноеСредствоТипВладения",	ПолучитьСписокТиповВладения());
		Соответствие.Вставить("ТитулОформлениеТранспортноеСредствоПрицепы_ТитулОформлениеТранспортноеСредствоТипВладения",	ПолучитьСписокТиповВладения());
	КонецЕсли; 	 
	
	Если ТекущийТитул = ПредопределенноеЗначение("Перечисление.ТипыЭлементовРегламентаЭДО.ЭПЛ_Титул2") Тогда  
		Соответствие.Вставить("ВариантМедработник", 			СписокМедработник());
		Соответствие.Вставить("ТитулМедосмотрВидМедосмотра",	СписокВидМедосмотра());
	КонецЕсли; 	     
	
	Если ТекущийТитул = ПредопределенноеЗначение("Перечисление.ТипыЭлементовРегламентаЭДО.ЭПЛ_Титул3") Тогда  
		Соответствие.Вставить("ТитулВыпускРезультатПроведенияПредсменногоКонтроля", СписокРезультатПроведенияПредсменногоКонтроля());
		Соответствие.Вставить("ТитулВыпускТранспортноеСредствоТипВладения",	ПолучитьСписокТиповВладения());
		Соответствие.Вставить("ТитулВыпускТранспортноеСредствоПрицепы_ТитулВыпускТранспортноеСредствоТипВладения",	ПолучитьСписокТиповВладения());
	КонецЕсли; 
	
	Если ТекущийТитул = ПредопределенноеЗначение("Перечисление.ТипыЭлементовРегламентаЭДО.ЭПЛ_Титул4") Тогда  
		Соответствие.Вставить("ТитулВыездПризнакНачалаРейса", СписокПризнакНачалаРейса());
	КонецЕсли;   
	
	Если ТекущийТитул = ПредопределенноеЗначение("Перечисление.ТипыЭлементовРегламентаЭДО.ЭПЛ_Титул5") Тогда  
		Соответствие.Вставить("ТитулЗаездПризнакОкончанияРейса", СписокПризнакОкончанияРейса());
	КонецЕсли; 
	
	Если ТекущийТитул = ПредопределенноеЗначение("Перечисление.ТипыЭлементовРегламентаЭДО.ЭСВ_Титул1_1") Тогда  
		Соответствие.Вставить("ВидОперации", СписокВидаОперацииЭСВ());
		Соответствие.Вставить("ТитулПеревозчикаОписаниеГруза_ОтгрузочноеНаименованиеГруза", СписокОтгрузочноеНаименованиеГруза());
		Соответствие.Вставить("ТитулПеревозчикаТранспортноеСредствоТипВладения", 	ПолучитьСписокТиповВладения()); 
		Соответствие.Вставить("ТитулПеревозчикаПрицепы_ТипВладения", 				ПолучитьСписокТиповВладения()); 
		
		Соответствие.Вставить("ТитулПеревозчикаТранспортноеСредствоТип",	СписокТиповТС());
		Соответствие.Вставить("ТитулПеревозчикаПрицепы_Тип",				СписокТиповПрицепов());
		
	КонецЕсли; 
	
	Возврат Соответствие;  
	
КонецФункции

Функция СписокМаркировкаГруза()

	СписокЗначений = Новый СписокЗначений;
	СписокЗначений.ЗагрузитьЗначения(ОбменСГИСЭПДКлиентСервер.ПолучитьМассивМаркировокГруза());

	Возврат СписокЗначений; 

КонецФункции

Функция СписокФункций()
	
	//Функции
	//Погрузка(Погрузка), Выгрузка(Выгрузка)     
	
	СписокЗначений = Новый СписокЗначений;
	СписокЗначений.Добавить("Заказ", "Заказ");
	СписокЗначений.Добавить("Заявка", "Заявка");
	
	Возврат СписокЗначений; 
	
КонецФункции

Функция СписокМетодовОпеределенияМассы()
	//Метод определения массы:
	//Взвешивание по общей массе(01), 
	//Взвешивание поосно(02), 
	//Расчетная масса груза(03)    
	
	СписокЗначений = Новый СписокЗначений;
	СписокЗначений.Добавить("01", "Взвешивание по общей массе");
	СписокЗначений.Добавить("02", "Взвешивание поосно");
	СписокЗначений.Добавить("03", "Расчетная масса груза"); 
	
	Возврат СписокЗначений; 
КонецФункции   

Функция СписокПолномочий()
	
	//Полномочия
	//заполнение и подписание заказа (заявки)(1), 
	//погрузка груза в транспортное средство, заполнение и подписание транспортной накладной(2), 
	//осуществление платежей по договору перевозки(3)  

	СписокЗначений = Новый СписокЗначений;
	СписокЗначений.Добавить("1", "заполнение и подписание заказа (заявки)");
	СписокЗначений.Добавить("2", "погрузка груза в транспортное средство, заполнение и подписание транспортной накладной");
	СписокЗначений.Добавить("3", "осуществление платежей по договору перевозки"); 
	
	Возврат СписокЗначений; 
	
КонецФункции 

