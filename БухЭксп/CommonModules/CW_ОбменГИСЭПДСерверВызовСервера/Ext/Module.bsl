Функция ПолучитьСписокТиповВладения()

	//собственность(1), совместная собственность супругов(2), аренда(3), лизинг(4), безвозмездное пользование(5)
	
	СписокЗначений = Новый СписокЗначений;
	СписокЗначений.Добавить("1", "собственность");
	СписокЗначений.Добавить("2", "совместная собственность супругов");
	СписокЗначений.Добавить("3", "аренда");
	СписокЗначений.Добавить("4", "лизинг");
	СписокЗначений.Добавить("5", "безвозмездное пользование");
	
	Возврат СписокЗначений;
	
КонецФункции 

Функция ПолучитьСписокНалоговыхСтавок()
	
	//0%(0%), 10%(10%), 20%(20%), 22%(22%), 
	//10/110(10/110),20/120(20/120), 22/122(22/122),
	//без НДС(без НДС), НДС исчисляется налоговым агентом(НДС исчисляется налоговым агентом)  	
	
	СписокЗначений = Новый СписокЗначений;
	СписокЗначений.Добавить("0%",  "0%");
	СписокЗначений.Добавить("10%", "10%");
	СписокЗначений.Добавить("20%", "20%");
	СписокЗначений.Добавить("22%", "22%");  
	
	СписокЗначений.Добавить("10/110", "10/110");
	СписокЗначений.Добавить("20/120", "20/120");
	СписокЗначений.Добавить("22/122", "22/122"); 
	
	СписокЗначений.Добавить("без НДС", "без НДС");
	СписокЗначений.Добавить("НДС исчисляется налоговым агентом", "НДС исчисляется налоговым агентом");
	
	Возврат СписокЗначений;
	
КонецФункции 

Функция ПолучитьСписокПолномочийПереадресовки()
	
	//Грузоотправитель(Грузоотправитель), Грузополучатель(Грузополучатель)
	
	СписокЗначений = Новый СписокЗначений;
	СписокЗначений.Добавить("Грузоотправитель",  	"Грузоотправитель");
	СписокЗначений.Добавить("Грузополучатель",  	"Грузополучатель");
	
