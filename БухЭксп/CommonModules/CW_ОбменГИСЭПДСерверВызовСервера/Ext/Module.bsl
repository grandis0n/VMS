Функция СписокОбластейТипБлево(ТекущийТитул) Экспорт
	
	Массив = Новый Массив;
	
	Если ТекущийТитул = ПредопределенноеЗначение("Перечисление.ТипыЭлементовРегламентаЭДО.ЭЗЗ_Титул1") Тогда 
		Массив.Добавить("ВариантПоДоверенностиЗаГрузоотправителя");	
		Массив.Добавить("ТитулГрузоотправителяГрузы_ВозможностьРаспределенияПоДлинеПлатформы");	
		Массив.Добавить("ТитулГрузоотправителяГрузы_ДелимостьГруза");	
		Массив.Добавить("ТитулГрузоотправителяГрузы_УчастиеВодителяВПогрузкеГрузаВКонтейнер");	
		Массив.Добавить("ТитулГрузоотправителяГрузы_ПриемГруженогоКонтейнера");	
	КонецЕсли;

	Если ТекущийТитул = ПредопределенноеЗначение("Перечисление.ТипыЭлементовРегламентаЭДО.ЭЗЗ_Титул2") Тогда 
		Массив.Добавить("ВариантПоДоверенностиЗаПеревозчика");	
	КонецЕсли;  
	
	Если ТекущийТитул = ПредопределенноеЗначение("Перечисление.ТипыЭлементовРегламентаЭДО.ЭТрН_Титул1") Тогда 
		Массив.Добавить("ВариантПоДоверенности");	
		Массив.Добавить("ТитулГрузоотправителяЭкспедитор");	
		Массив.Добавить("ГрузоотправительЯвляетсяГрузополучателем");	
		Массив.Добавить("ТитулГрузоотправителяГрузы_ИмеетУчетВГИС");	
		Массив.Добавить("ТитулГрузоотправителяТитулГрузоотправителяЗапрещениеПерегрузки");	
		Массив.Добавить("ТитулГрузоотправителяОтправлятьQR");	
	КонецЕсли;

	Если ТекущийТитул = ПредопределенноеЗначение("Перечисление.ТипыЭлементовРегламентаЭДО.ЭСВ_Титул1_1") Тогда 
		Массив.Добавить("ТитулПеревозчикаОписаниеГруза_ДелимостьГруза");	 
		Массив.Добавить("ТитулПеревозчикаСведенияОКонтейнерах_НаличиеТабличкиВозможностьРаботыПодПломбами");	 
	КонецЕсли;

	Возврат Массив;
	
КонецФункции      

Функция СписокОбластейАдресов(ТекущийТитул) Экспорт
	
	Массив = Новый Массив;
	Если ТекущийТитул = ПредопределенноеЗначение("Перечисление.ТипыЭлементовРегламентаЭДО.ЭЗЗ_Титул1") Тогда    
		Массив.Добавить("ПредставлениеТитулГрузоотправителяАдресПогрузки");	
		Массив.Добавить("ТитулГрузоотправителяАдресаПунктовПогрузкиИВыгрузки_ПредставлениеАдресПунктаПогрузки");	
	КонецЕсли;   
	
	Если ТекущийТитул = ПредопределенноеЗначение("Перечисление.ТипыЭлементовРегламентаЭДО.ЭТрН_Титул1") Тогда    
		Массив.Добавить("ПредставлениеТитулГрузоотправителяГрузополучательАдресДоставки");	 
		Массив.Добавить("ПредставлениеТитулГрузоотправителяАдресПогрузки");	 
	КонецЕсли;   

	Если ТекущийТитул = ПредопределенноеЗначение("Перечисление.ТипыЭлементовРегламентаЭДО.ЭПЛ_Титул1") Тогда    
		Массив.Добавить("ПредставлениеТитулОформлениеАдресМестаОтправления");	 
		Массив.Добавить("ТитулОформлениеАдресаПунктовПогрузкиИВыгрузки_АдресПунктаПогрузкиПредставление");	 
	КонецЕсли;   
	
	Если ТекущийТитул = ПредопределенноеЗначение("Перечисление.ТипыЭлементовРегламентаЭДО.ЭСВ_Титул1_1") Тогда    
		Массив.Добавить("ПредставлениеТитулПеревозчикаАдресВыгрузки");	 
	КонецЕсли;   
	
	Возврат Массив;
	
КонецФункции

