#Область ПрограммныйИнтерфейс

// Обработчик изменения состояния новостей.
//
// Параметры - см. ОбработкаНовостейПереопределяемый.ПослеИзмененияСостоянияНовостей()
//
Процедура ПослеИзмененияСостоянияНовостей(ВыбранныеПользователи, ВыбранныеНовости, ПредыдущееСостояние, НовоеСостояние) Экспорт
	
	Если Не ОбщегоНазначения.РазделениеВключено() Тогда
		Возврат;
	КонецЕсли;
	
	// Обрабатываем сценарии только для интерактивного изменения свойств новостей текущим пользователем. То есть, ожидаем
	// в массиве только одного текущего пользователя.
	Если ТипЗнч(ВыбранныеПользователи) <> Тип("Массив")
		 Или ВыбранныеПользователи.Количество() <> 1
		 Или ВыбранныеПользователи[0] <> Пользователи.ТекущийПользователь() Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ВыбранныеНовости) Тогда
		Возврат;
	КонецЕсли;
	
	// Определим, можно ли новости считать прочитанными, исходя из их состояния. Считаем, что новости прочитаны в данном
	// событии в том случае, если в новом состоянии они и прочтены, и отключено оповещение, а ранее значения этих свойств
	// отличались. Если новости нельзя считать прочитанными, то дальнейшая обработка не выполняется.
	Если Не (
		 НовоеСостояние.Прочтена = Истина И НовоеСостояние.ОповещениеВключено = Ложь // сейчас прочитаны
		 И (ПредыдущееСостояние.Прочтена <> Истина Или ПредыдущееСостояние.ОповещениеВключено <> Ложь) // а ранее - нет
		 ) Тогда
		Возврат;
	КонецЕсли;
	
	ИдентификаторПользователяСервиса = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(
		ВыбранныеПользователи[0], "ИдентификаторПользователяСервиса");
	
	Параметры = Новый Структура;
	Параметры.Вставить("УИННовостей", Новый Массив);
	Параметры.Вставить("ИдентификаторПользователяСервиса", Строка(ИдентификаторПользователяСервиса));
	
	УИННовостей = ОбщегоНазначения.ЗначениеРеквизитаОбъектов(ВыбранныеНовости, "УИННовости");
	ДополнительныеПараметры = Новый Соответствие;
	
	Для Каждого Новость Из ВыбранныеНовости Цикл
		УИННовости = УИННовостей[Новость];
		Если ПустаяСтрока(УИННовости) Тогда
			Продолжить;
		КонецЕсли;
		
		ДополнительныеПараметрыНовости = Новый Структура;
		Отказ = Ложь;
		ДополнитьПараметрыПрочтенияНовости(Новость, ДополнительныеПараметрыНовости, Отказ);
		
		Если Отказ Тогда
			Продолжить;
		КонецЕсли;
		
		Параметры.УИННовостей.Добавить(УИННовости);
		
		Если ДополнительныеПараметрыНовости.Количество() > 0 Тогда
			КлючДополнительныхПараметров = АсинхронноеПолучениеДанныхБПНовости.ПреобразоватьКлючДополнительныхПараметров(УИННовости);
			ДополнительныеПараметры.Вставить(КлючДополнительныхПараметров, ДополнительныеПараметрыНовости);
		КонецЕсли;
	КонецЦикла;
	
	Если Параметры.УИННовостей.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если ДополнительныеПараметры.Количество() > 0 Тогда
		Параметры.Вставить("ДополнительныеПараметры", ДополнительныеПараметры);
	КонецЕсли;
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияПроцедуры();
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = НСтр("ru = 'Синхронизация прочтения новостей'");
	ПараметрыВыполнения.ОжидатьЗавершение = 0;
	ПараметрыВыполнения.ЗапуститьВФоне = Истина;
	
	ОтборПриложений = АсинхронноеПолучениеДанныхБП.НовыйОтборПриложений();
	ОтборПриложений.ИмяВидаПриложения = ОбщегоНазначенияБП.ИменаКонфигурацийБП();
	ОтборПриложений.СостояниеПриложения = Перечисления.СостоянияПриложений.Используется;
	
	ДлительныеОперации.ВыполнитьПроцедуру(
		ПараметрыВыполнения,
		"АсинхронноеПолучениеДанныхБП.ОповеститьПриложенияПользователя",
		"news_read",
		Параметры,
		ОтборПриложений,
		НСтр("ru = 'Прочтение новостей'"));
	
КонецПроцедуры

// Вызывается перед отправкой информации о прочтении новости в другие приложения.
// Дополняет параметры необходимыми данными (например, хэшем функциональных опций).
//
// Параметры:
//  Новость       - СправочникСсылка.Новости
//  Параметры     - Структура - дополнительные параметры для конкретной новости
//  Отказ         - Булево - если Истина, синхронизация прочтения отменяется
//
Процедура ДополнитьПараметрыПрочтенияНовости(Новость, Параметры, Отказ) Экспорт
	
	Если СтрНайти(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Новость, "Подзаголовок"), "Новое в версии") > 0 Тогда
		Хэш = ВычислитьХэшФОДляНовости(Новость);
		Параметры.Вставить("ХэшФО", Хэш);
	КонецЕсли;
	
КонецПроцедуры

// Вызывается при получении информации о прочтении новости из другого приложения.
// Проверяет, можно ли пометить новость прочитанной в текущем приложении (совпадают ли ФО).
//
// Параметры:
//  Новость       - СправочникСсылка.Новости
//  Параметры     - Соответствие, Неопределено - дополнительные параметры для конкретной новости
//  Отказ         - Булево - если Истина, новость не будет помечена прочитанной
//
Процедура ОбработатьЗапросПрочтенияНовостиОтВнешнегоПриложения(Новость, Параметры, Отказ) Экспорт
	
	Если Параметры = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ХэшФОВнешний = Параметры.Получить("ХэшФО");
	Если ХэшФОВнешний = Неопределено Тогда
		Возврат;
	КонецЕсли;
		
	ХэшФОЛокальный = ВычислитьХэшФОДляНовости(Новость);
	Если ХэшФОВнешний <> ХэшФОЛокальный Тогда
		Отказ = Истина;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ВычислитьХэшФОДляНовости(Новость)
	
	ТекстХТМЛ = ОбработкаНовостейСлужебный.ПолучитьХТМЛТекстНовостей(Новость);
	Если ТипЗнч(ТекстХТМЛ) = Тип("Массив") И ТекстХТМЛ.Количество() > 0 Тогда
		ТекстХТМЛ = ТекстХТМЛ[0];
	КонецЕсли;
	
	Если ПустаяСтрока(ТекстХТМЛ) Тогда
		Возврат "";
	КонецЕсли;
	
	МассивИменФО = Новый Массив;
	
	Попытка
		ЧтениеHTML = Новый ЧтениеHTML;
		ЧтениеHTML.УстановитьСтроку(ТекстХТМЛ);
		ПостроительDOM = Новый ПостроительDOM;
		ДокументDOM = ПостроительDOM.Прочитать(ЧтениеHTML);
		ЧтениеHTML.Закрыть();
		
		ЭлементыР = ДокументDOM.ПолучитьЭлементыПоИмени("p");
		
		Для Каждого ЭлементР Из ЭлементыР Цикл
			ИмяКлассов = ЭлементР.ИмяКласса;
			Если Лев(ИмяКлассов, 2) = "FO" Тогда
				ИмяКлассов = СтрЗаменить(ИмяКлассов, "FO ", "");
				МассивКлассов = СтрРазделить(ИмяКлассов, "-");
				Для Каждого ИмяФО Из МассивКлассов Цикл
					Если МассивИменФО.Найти(ИмяФО) = Неопределено Тогда
						МассивИменФО.Добавить(ИмяФО);
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;
	Исключение
		// Ошибка разбора HTML
		Возврат "";
	КонецПопытки;
	
	Если МассивИменФО.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	
	// Отсортируем массив для стабильности хэша
	СписокДляСортировки = Новый СписокЗначений;
	СписокДляСортировки.ЗагрузитьЗначения(МассивИменФО);
	СписокДляСортировки.СортироватьПоЗначению();
	
	СтрокаЗначений = "";
	ИспользуетсяСервисЭТК = СервисЭлектронныхТрудовыхКнижек.ИспользуетсяСервисЭлектронныхТрудовыхКнижек();
	
	Для Каждого Элемент Из СписокДляСортировки Цикл
		ИмяФО = Элемент.Значение;
		ЗначениеФО = Ложь;
		
		ТекущаяФО = Метаданные.ФункциональныеОпции.Найти(ИмяФО);
		Если ТекущаяФО <> Неопределено И ТекущаяФО.Хранение.Тип = Новый ОписаниеТипов("Булево") Тогда
			ЗначениеФО = ПолучитьФункциональнуюОпцию(ИмяФО);
		ИначеЕсли ИмяФО = "ТолькоДляКоробочныхВерсий" Тогда
			ЗначениеФО = Не ОбщегоНазначения.РазделениеВключено();
		ИначеЕсли ИмяФО = "ТолькоДляОблачныхВерсий" Тогда
			ЗначениеФО = ОбщегоНазначения.РазделениеВключено();
		ИначеЕсли ИмяФО = "ЭтоБизнесСтарт" Тогда
			ЗначениеФО = (ОбщегоНазначения.РазделениеВключено() И ОбщегоНазначенияБП.ЭтоВитринаБизнесСтарта());
		ИначеЕсли ИмяФО = "ЭтоНеБизнесСтарт" Тогда
			ЗначениеФО = Не (ОбщегоНазначения.РазделениеВключено() И ОбщегоНазначенияБП.ЭтоВитринаБизнесСтарта());
		ИначеЕсли СтрНайти(НРег(ИмяФО), "версияконфигурации") > 0 Тогда
			ЗначениеФО = ОбщегоНазначенияБП.ПолучитьЗначениеФункциональности(ИмяФО);
		ИначеЕсли ИспользуетсяСервисЭТК И ИмяФО = "ИнтерфейсЭлектронныхТрудовыхКнижек" Тогда
			ЗначениеФО = Истина;
		КонецЕсли;
		
		СтрокаЗначений = СтрокаЗначений + ИмяФО + "=" + Строка(ЗначениеФО) + ";";
	КонецЦикла;
	
	Если ПустаяСтрока(СтрокаЗначений) Тогда
		Возврат "";
	КонецЕсли;
	
	Хеширование = Новый ХешированиеДанных(ХешФункция.MD5);
	Хеширование.Добавить(СтрокаЗначений);
	Возврат СтрЗаменить(Строка(Хеширование.ХешСумма), " ", "");
	
КонецФункции

#КонецОбласти