КонецПроцедуры

Функция ПолучитьПустуюТаблицуЗначенийРеквизитов() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 0
	|	ЗначенияРеквизитовДокументовЭПД.Титул КАК Титул,
	|	ЗначенияРеквизитовДокументовЭПД.НомерВерсии КАК НомерВерсии,
	|	ЗначенияРеквизитовДокументовЭПД.ИмяТабличнойЧасти КАК ИмяТабличнойЧасти,
	|	ЗначенияРеквизитовДокументовЭПД.НомерСтрокиРеквизита КАК НомерСтрокиРеквизита,
	|	ЗначенияРеквизитовДокументовЭПД.ИмяРеквизита КАК ИмяРеквизита,
	|	НЕОПРЕДЕЛЕНО КАК ЗначениеРеквизита
	|ИЗ
	|	РегистрСведений.ЗначенияРеквизитовДокументовЭПД КАК ЗначенияРеквизитовДокументовЭПД";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат РезультатЗапроса.Выгрузить();
	
КонецФункции

Процедура СформироватьАлгоритмыЗаполненияРеквизитовЭПД(ПараметрыПроцедуры, АдресРезультата) Экспорт  
	
	Результат = Новый Структура;
	
	СоответствиеРезультатов = Новый Соответствие;
	СоответствиеРезультатов.Вставить("ЗначениеРеквизита", 	Перечисления.CW_ОбменГИСЭПДВидыРезультатов.ЗначениеРеквизита);
	СоответствиеРезультатов.Вставить("ТабличнаяЧасть", 		Перечисления.CW_ОбменГИСЭПДВидыРезультатов.ТабличнаяЧасть);
	
	МакетИменПолей = Справочники.CW_ОбменГИСЭПДНастройкиЗаполненияЭПД.ПолучитьМакет("СоответствиеИменПолей");
	ОбластьТитула  = МакетИменПолей.ПолучитьОбласть(ПараметрыПроцедуры.ИмяОбласти); 
	
	//Подготовка таблицы настроек по макету
	ТаблицаНастроек = Новый ТаблицаЗначений;
	ТаблицаНастроек.Колонки.Добавить("ИмяОбласти",				Новый ОписаниеТипов("Строка"));
	ТаблицаНастроек.Колонки.Добавить("ЗаголовокОбласти", 		Новый ОписаниеТипов("Строка"));
	ТаблицаНастроек.Колонки.Добавить("ТипЗначения",				Неопределено);
	ТаблицаНастроек.Колонки.Добавить("ВозвращаемоеЗначение",	Новый ОписаниеТипов("ПеречислениеСсылка.CW_ОбменГИСЭПДВидыРезультатов"));
	ТаблицаНастроек.Колонки.Добавить("Обязательное",			Новый ОписаниеТипов("Булево"));
	ТаблицаНастроек.Колонки.Добавить("ОписаниеЗначения",		Новый ОписаниеТипов("Строка"));
	ТаблицаНастроек.Колонки.Добавить("Комментарий",				Новый ОписаниеТипов("Строка"));
	
	Для НомерСтроки = 1 по ОбластьТитула.ВысотаТаблицы Цикл
		НоваяСтрока = ТаблицаНастроек.Добавить();
		НоваяСтрока.ИмяОбласти 			 = СокрЛП(ОбластьТитула.Область(НомерСтроки, 1, НомерСтроки, 1).Текст);	
		НоваяСтрока.ЗаголовокОбласти	 = СокрЛП(ОбластьТитула.Область(НомерСтроки, 3, НомерСтроки, 3).Текст);	
		НоваяСтрока.ВозвращаемоеЗначение = СоответствиеРезультатов.Получить(СокрЛП(ОбластьТитула.Область(НомерСтроки, 4, НомерСтроки, 4).Текст));
		НоваяСтрока.Обязательное 		 = (ВРег(СокрЛП(ОбластьТитула.Область(НомерСтроки, 5, НомерСтроки, 5).Текст)) = "ДА");	
		НоваяСтрока.ОписаниеЗначения	 = СокрЛП(ОбластьТитула.Область(НомерСтроки, 6, НомерСтроки, 6).Текст);	
		НоваяСтрока.Комментарий	 		 = СокрЛП(ОбластьТитула.Область(НомерСтроки, 7, НомерСтроки, 7).Текст);	
		
		ОписаниеТипаЗначения = СокрЛП(ОбластьТитула.Область(НомерСтроки, 2, НомерСтроки, 2).Текст); 
		Если Не ПустаяСтрока(ОписаниеТипаЗначения) Тогда
			МассивИменТипов = СтрРазделить(ОписаниеТипаЗначения,";");
			
			Типы = Новый Массив;
			Для Каждого ИмяТипа из МассивИменТипов Цикл
				Типы.Добавить(Тип(ИмяТипа));	
			КонецЦикла;
			
			НоваяСтрока.ТипЗначения = Новый ОписаниеТипов(Типы);
		КонецЕсли;
		
	КонецЦикла;   
	
	РодительТипДокумента = ПолучитьРодителяАлгоритмовЗаполненияЭПД(
		СокрЛП(ПараметрыПроцедуры.ТипДокументаЭПД), 
		ПараметрыПроцедуры.ТипОбъекта);
	
	РодительТекущийТитул = ПолучитьРодителяАлгоритмовЗаполненияЭПД(
		СокрЛП(ПараметрыПроцедуры.ТекущийТитул), 
		ПараметрыПроцедуры.ТипОбъекта,
		РодительТипДокумента);
		
	//Формирование элементов справочника   
	Для Каждого СтрокаНастроек из ТаблицаНастроек Цикл 
		СсылкаАлгоритмы = Справочники.CW_ОбменГИСЭПДАлгоритмыЗаполненияРеквизитовЭПД.НайтиПоНаименованию(СокрЛП(СтрокаНастроек.ЗаголовокОбласти), Истина, РодительТекущийТитул);
		Если Не СсылкаАлгоритмы.Пустая() Тогда 
			АлгоритмыОбъект =  СсылкаАлгоритмы.ПолучитьОбъект(); 
		Иначе
			АлгоритмыОбъект = Справочники.CW_ОбменГИСЭПДАлгоритмыЗаполненияРеквизитовЭПД.СоздатьЭлемент();
			АлгоритмыОбъект.Родитель	 = РодительТекущийТитул;
			АлгоритмыОбъект.Наименование = СокрЛП(СтрокаНастроек.ЗаголовокОбласти);
			
		КонецЕсли;
		
		АлгоритмыОбъект.ТипОбъекта 						= ПараметрыПроцедуры.ТипОбъекта;
		АлгоритмыОбъект.ВозвращаемоеЗначение			= СтрокаНастроек.ВозвращаемоеЗначение;
		АлгоритмыОбъект.ОписаниеВозвращаемогоЗначения	= СтрокаНастроек.ОписаниеЗначения; 
		АлгоритмыОбъект.Комментарий						= СтрокаНастроек.Комментарий; 
		АлгоритмыОбъект.Записать();    
		
		Результат.Вставить(СтрокаНастроек.ИмяОбласти, АлгоритмыОбъект.Ссылка);
	КонецЦикла;   
	
	ПоместитьВоВременноеХранилище(Результат, АдресРезультата);
	
КонецПроцедуры

Функция ПолучитьРодителяАлгоритмовЗаполненияЭПД(Знач Наименование, Знач ТипОбъекта, Знач ТекущийРодитель=Неопределено)
	
	НайденныйРодитель = Справочники.CW_ОбменГИСЭПДАлгоритмыЗаполненияРеквизитовЭПД.НайтиПоНаименованию(Наименование, Истина, ТекущийРодитель);
	Если Не НайденныйРодитель.Пустая() Тогда
		Возврат НайденныйРодитель;
	КонецЕсли;
	
	РодительОбъект = Справочники.CW_ОбменГИСЭПДАлгоритмыЗаполненияРеквизитовЭПД.СоздатьГруппу();
	РодительОбъект.Наименование = Наименование;
	РодительОбъект.ТипОбъекта 	= ТипОбъекта;
	РодительОбъект.Родитель 	= ТекущийРодитель;
	РодительОбъект.Записать();
	
	Возврат РодительОбъект.Ссылка;
	
КонецФункции


Процедура ЗаполнитьЭПД(ПараметрыПроцедуры, АдресРезультата) Экспорт
	
	ИмяДокументаПоТипу = CW_ОбменГИСЭПДПереопределяемый.ИмяДокументаПоТипу(ПараметрыПроцедуры.ТипДокументаЭПД);
	
	Если ЗначениеЗаполнено(ПараметрыПроцедуры.ЭлектронныйПеревозочныйДокумент) Тогда
		ОбъектЭПД = ПараметрыПроцедуры.ЭлектронныйПеревозочныйДокумент.ПолучитьОбъект(); 
	Иначе
		ОбъектЭПД = Документы[ИмяДокументаПоТипу].СоздатьДокумент();
	КонецЕсли; 
	
	ОбъектЭПД.Дата 			= ПараметрыПроцедуры.Дата;
	ОбъектЭПД.Организация 	= ПараметрыПроцедуры.Организация;
	ОбъектЭПД.ТекущийТитул 	= ПараметрыПроцедуры.ВерсияТитула.Титул;
	ОбъектЭПД.ТекущийШаг 	= ПараметрыПроцедуры.ТекущийШаг;  
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ОбъектЭПД, "СсылкаТитулГрузоотправителяГрузоотправитель") Тогда
		ОбъектЭПД.СсылкаТитулГрузоотправителяГрузоотправитель = ПараметрыПроцедуры.СсылкаТитулГрузоотправителяГрузоотправитель;
	КонецЕсли;
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ОбъектЭПД, "СсылкаТитулГрузоотправителяПеревозчик") Тогда
		ОбъектЭПД.СсылкаТитулГрузоотправителяПеревозчик = ПараметрыПроцедуры.СсылкаТитулГрузоотправителяПеревозчик;
	КонецЕсли;
	
	ПрефиксХранимыхДанных 	= "ХранимыеДанные";
	
	СтруктураРеквизитов 	= новый Структура;   
	
	Для Каждого СтрокаТаблицы из ПараметрыПроцедуры.ТаблицаЗначенийРеквизитов Цикл 
		
		Если СтрНайти(СтрокаТаблицы.ИмяРеквизита, "Ссылка" ) > 0 Тогда
			ЗаполнитьРеквизитыПоСсылке(СтрокаТаблицы, 
				СтруктураРеквизитов, 
				СтрокаТаблицы.ЗначениеРеквизита, 
				ПараметрыПроцедуры.ПрефиксТитула);
		КонецЕсли; 
		
		Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ОбъектЭПД, СтрокаТаблицы.ИмяРеквизита) Тогда
			ОбъектЭПД[СтрокаТаблицы.ИмяРеквизита] = СтрокаТаблицы.ЗначениеРеквизита;	
		КонецЕсли;
		
		ЧастиИмени = Новый Массив;    
		Если Не ПустаяСтрока(СтрокаТаблицы.ИмяТабличнойЧасти) Тогда
			ЧастиИмени.Добавить(СтрокаТаблицы.ИмяТабличнойЧасти);      
		КонецЕсли;
		Если СтрокаТаблицы.НомерСтрокиРеквизита > 0 Тогда
			ЧастиИмени.Добавить(СтрокаТаблицы.НомерСтрокиРеквизита);
		КонецЕсли;
		ЧастиИмени.Добавить(СтрокаТаблицы.ИмяРеквизита);
		
		НовыйКлюч 		= СтрСоединить(ЧастиИмени, "__");	
		НовоеЗначение 	= СтрокаТаблицы.ЗначениеРеквизита;   
		
		Если СтрНайти(СтрокаТаблицы.ИмяРеквизита, ПрефиксХранимыхДанных) > 0 Тогда
			Если ТипЗнч(НовоеЗначение) = Тип("Структура") Тогда
				СсылкаХранимыеДанные = ПолучитьСсылкуНаХранимыеДанные(НовоеЗначение);
				СтруктураРеквизитов.Вставить(НовыйКлюч, СсылкаХранимыеДанные); 
				
				Если СтрНайти(НовыйКлюч, "СторонаПодписавшаяДокумент") > 0 Тогда
					Для Каждого Строка из СсылкаХранимыеДанные.Данные Цикл     
						НовыйКлючХранимыхДанных = СтрокаТаблицы.ИмяТабличнойЧасти+"__"+СтрокаТаблицы.НомерСтрокиРеквизита+"__"+Строка.Имя;		
						СтруктураРеквизитов.Вставить(НовыйКлючХранимыхДанных, Строка.Значение);
					КонецЦикла;
				КонецЕсли;
			КонецЕсли;  
		ИначеЕсли ТипЗнч(НовоеЗначение) = Тип("Структура") Тогда
			Если  НовоеЗначение.Свойство("Тип")
				и НовоеЗначение.Тип = Тип("СправочникСсылка.СтроковыеЗначенияЭПД") Тогда
				СсылкаСтроковыеЗначенияЭПД = Справочники.СтроковыеЗначенияЭПД.НайтиПоНаименованию(НовоеЗначение.Наименование,Истина);
				Если СсылкаСтроковыеЗначенияЭПД.Пустая() Тогда
					ОбъектСтроковыеЗначенияЭПД = Справочники.СтроковыеЗначенияЭПД.СоздатьЭлемент();
					ОбъектСтроковыеЗначенияЭПД.Наименование = НовоеЗначение.Наименовани;
					ОбъектСтроковыеЗначенияЭПД.Записать();
					СсылкаСтроковыеЗначенияЭПД =  ОбъектСтроковыеЗначенияЭПД.Ссылка;  
				КонецЕсли;   
				СтруктураРеквизитов.Вставить(НовыйКлюч, СсылкаСтроковыеЗначенияЭПД);  
			КонецЕсли;
		Иначе
			СтруктураРеквизитов.Вставить(НовыйКлюч, НовоеЗначение);
		КонецЕсли;  
		
	КонецЦикла;
	
	ОбъектЭПД.ДополнительныеСвойства.Вставить("ВерсияТитула", 			ПараметрыПроцедуры.ВерсияТитула);
	ОбъектЭПД.ДополнительныеСвойства.Вставить("СтруктураРеквизитов", 	СтруктураРеквизитов);
	ОбъектЭПД.Записать(); 
	
	
	ПоместитьВоВременноеХранилище(ОбъектЭПД.Ссылка, АдресРезультата)
	
КонецПроцедуры

Процедура ЗаполнитьРеквизитыПоСсылке(СтрокаТаблицы, КонтейнерРеквизитов, ЗначениеРеквизита, ПрефиксТитула) 
	
	ПрефиксРеквизитов = СтрЗаменить(СтрокаТаблицы.ИмяРеквизита, "Ссылка", "");   
	
	Если ТипЗнч(ЗначениеРеквизита) = ОбменСГИСЭПДКлиентСервер.ПолучитьТипОрганизация()
		Или ТипЗнч(ЗначениеРеквизита) = ОбменСГИСЭПДКлиентСервер.ПолучитьТипКонтрагент() Тогда
		ЗаполнитьРеквизитыУчастника(ЗначениеРеквизита, ПрефиксРеквизитов, 
			СтрокаТаблицы, КонтейнерРеквизитов, ПрефиксТитула);
	КонецЕсли;
	
КонецПроцедуры

// Заполняет реквизиты участника.
// 
// Параметры:
//  Участник - СправочникСсылка.Организации, СправочникСсылка.Контрагенты - Участник
//  ПрефиксРеквизитов - Строка - Префикс реквизитов
//  КонтейнерРеквизитов - Структура, ДанныеФормыЭлементКоллекции - Контейнер реквизитов
//  Форма - ФормаКлиентскогоПриложения 
//  ПрефиксТитула - Неопределено, Строка - Префикс титула
Процедура ЗаполнитьРеквизитыУчастника(Участник, ПрефиксРеквизитов, СтрокаТаблицы, КонтейнерРеквизитов, ПрефиксТитула=Неопределено) 
	
	ПостфиксТелефоны = "НомераТелефонов";
	ПостфиксЭлПочта = "АдресаЭлектроннойПочты";
	
	ЕстьТелефоны = Ложь;
	ЕстьЭлПочта = Ложь;
	Если ПрефиксРеквизитов <> "Заказчик" Тогда
		ЕстьТелефоны = Истина;
		ЕстьЭлПочта = Истина;
	КонецЕсли;
	
	ПрефиксПодчиненныхТаблиц = "";
	Если ПрефиксТитула <> Неопределено И СтрНачинаетсяС(ПрефиксРеквизитов, ПрефиксТитула) = Ложь Тогда
		ПрефиксПодчиненныхТаблиц = ПрефиксТитула;
	КонецЕсли;
	
	#Если Сервер Тогда
		МодульОбменСГИСЭПД = ОбменСГИСЭПД;
	#Иначе
		МодульОбменСГИСЭПД = ОбменСГИСЭПДВызовСервера;
	#КонецЕсли
	
	РеквизитыУчастника = МодульОбменСГИСЭПД.ПолучитьРеквизитыУчастника(Участник, Ложь);
	
	ПрефиксКонтактов = "";
	ПрефиксАдреса = "";
	Если ПрефиксРеквизитов = "ТитулФрахтователяФрахтователь"
		Или ПрефиксРеквизитов = "ТитулФрахтователяФрахтовщик"
		Или ПрефиксРеквизитов = "ТитулФрахтователяСоставитель"
		Или ПрефиксРеквизитов = "ТитулФрахтовщикаСоставитель" Тогда
		Если РеквизитыУчастника.Свойство("ЮЛ_ИНН") И ЗначениеЗаполнено(РеквизитыУчастника.ЮЛ_ИНН) Тогда
			ПрефиксКонтактов = "ЮЛ";
			ПрефиксАдреса = "ЮЛ";
		Иначе
			ПрефиксКонтактов = "ФЛ";
			ПрефиксАдреса = Неопределено;
		КонецЕсли;
	ИначеЕсли ПрефиксРеквизитов = "ТитулФрахтовщикаФрахтовщик"
		Или ПрефиксРеквизитов = "ТитулПеревозчикаПеревозчик"
		Или ПрефиксРеквизитов = "ТитулПеревозчикаГрузоотправитель"
		Или ПрефиксРеквизитов = "ТитулПеревозчикаГрузополучатель"
		Или ПрефиксРеквизитов = "ТитулПеревозчикаЛицоОсуществляющееПогрузку"
		Или ПрефиксРеквизитов = "ТитулПеревозчикаЛицоОсуществляющееПриемку"
		Или ПрефиксРеквизитов = "ДопТитулПеревозчикаПеревозчик"
		Или ПрефиксРеквизитов = "ДопТитулПеревозчикаГрузоотправитель"
		Или ПрефиксРеквизитов = "ДопТитулПеревозчикаГрузополучатель"
		Или ПрефиксРеквизитов = "ДопТитулПеревозчикаЛицоОсуществляющееПогрузку"
		Или ПрефиксРеквизитов = "ДопТитулПеревозчикаЛицоОсуществляющееПриемку" Тогда
		Если (РеквизитыУчастника.Свойство("ЮЛ_ИНН") И ЗначениеЗаполнено(РеквизитыУчастника.ЮЛ_ИНН))
			ИЛИ (РеквизитыУчастника.Свойство("ЮЛ_КПП") И ЗначениеЗаполнено(РеквизитыУчастника.ЮЛ_КПП)) Тогда
			ПрефиксКонтактов = "ЮЛ";
			ПрефиксАдреса = "ЮЛ";
		Иначе
			ПрефиксКонтактов = "ИП";
			ПрефиксАдреса = Неопределено;
		КонецЕсли;	
	КонецЕсли;
	
	СтруктураДляЗаполнения = Новый Структура;
	Для Каждого КиЗ Из РеквизитыУчастника Цикл
		Если КиЗ.Ключ <> ПостфиксТелефоны И КиЗ.Ключ <> ПостфиксЭлПочта Тогда
			Если СтрНачинаетсяС(КиЗ.Ключ, "Адрес") И ПрефиксАдреса <> Неопределено Тогда
				КороткоеИмя = ПрефиксАдреса + КиЗ.Ключ;	
			Иначе
				КороткоеИмя = КиЗ.Ключ
			КонецЕсли;   
			
			Если Не ПустаяСтрока(СтрокаТаблицы.ИмяТабличнойЧасти) Тогда
				ИмяРеквизита = СтрокаТаблицы.ИмяТабличнойЧасти +"__"+ СтрокаТаблицы.НомерСтрокиРеквизита + "__" + ПрефиксРеквизитов + КороткоеИмя ; 
			Иначе
				ИмяРеквизита = ПрефиксРеквизитов + КороткоеИмя;
			КонецЕсли; 
			
			СтруктураДляЗаполнения.Вставить(ИмяРеквизита, КиЗ.Значение);
		КонецЕсли;
	КонецЦикла;
	
	Если ТипЗнч(КонтейнерРеквизитов) = Тип("Структура") Тогда
		Для Каждого КиЗ Из СтруктураДляЗаполнения Цикл
			КонтейнерРеквизитов.Вставить(КиЗ.Ключ, КиЗ.Значение);	
		КонецЦикла;	
	Иначе
		ЗаполнитьЗначенияСвойств(КонтейнерРеквизитов, СтруктураДляЗаполнения);
	КонецЕсли;
	
	Если ЕстьТелефоны = Истина И РеквизитыУчастника.Свойство(ПостфиксТелефоны) Тогда
		НомерСтроки = 0;
		Для Каждого Телефон Из РеквизитыУчастника[ПостфиксТелефоны] Цикл
			НомерСтроки = НомерСтроки + 1;
			КонтейнерРеквизитов.Вставить(ПрефиксПодчиненныхТаблиц + ПрефиксРеквизитов + ПрефиксКонтактов + ПостфиксТелефоны 
			+ "__" + НомерСтроки + "__Телефон", Телефон);
		КонецЦикла;
	КонецЕсли;

	Если ЕстьЭлПочта = Истина И РеквизитыУчастника.Свойство(ПостфиксЭлПочта) Тогда
		НомерСтроки = 0;
		Для Каждого АдресЭлектроннойПочты Из РеквизитыУчастника[ПостфиксЭлПочта] Цикл
			НомерСтроки = НомерСтроки + 1;
			КонтейнерРеквизитов.Вставить(ПрефиксПодчиненныхТаблиц + ПрефиксРеквизитов + ПрефиксКонтактов + ПостфиксЭлПочта 
			+ "__" + НомерСтроки + "__АдресЭлектроннойПочты", АдресЭлектроннойПочты);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьСсылкуНаХранимыеДанные(ХранимыеДанные) 
	
	ПрефиксХранимыхДанных 	= "ХранимыеДанные";     
	
	ВремДанные = ХранимыеДанные.Данные.Скопировать(); 
	ВремДанные.Очистить();
	
	Для Каждого СтрокаТЧ Из ХранимыеДанные.Данные Цикл  
		Если СтрНайти(СтрокаТЧ.Имя, ПрефиксХранимыхДанных) > 0 Тогда 
			Если ТипЗнч(СтрокаТЧ.Значение) = Тип("Структура") Тогда 
				СсылкаХранимыеДанные = ПолучитьСсылкуНаХранимыеДанные(СтрокаТЧ.Значение); 
				
				НоваяСтрока = ВремДанные.Добавить();	
				ЗаполнитьЗначенияСвойств(НоваяСтрока,СтрокаТЧ);	
				НоваяСтрока.Значение = СсылкаХранимыеДанные;
			КонецЕсли;   
			
			Если СтрНайти(СтрокаТЧ.Имя, "СторонаПодписавшаяДокумент") > 0 Тогда
				Для Каждого Строка из СсылкаХранимыеДанные.Данные Цикл  
					НоваяСтрока = ВремДанные.Добавить();	
					ЗаполнитьЗначенияСвойств(НоваяСтрока,Строка);	
					
					НоваяСтрока.ИмяТабличнойЧасти = СтрокаТЧ.ИмяТабличнойЧасти;
					НоваяСтрока.НомерСтрокиТЧ     = СтрокаТЧ.НомерСтрокиТЧ; 
				КонецЦикла;
			КонецЕсли;
		Иначе
			НоваяСтрока = ВремДанные.Добавить();	
			ЗаполнитьЗначенияСвойств(НоваяСтрока,СтрокаТЧ);	
		КонецЕсли;
	КонецЦикла; 
	ХранимыеДанные.Данные = ВремДанные;
	
	
	МассивРеквизитов = Новый Массив;
	Для Каждого СтрокаТЧ Из ХранимыеДанные.Данные Цикл  
		Если СтрокаТЧ.ИмяТабличнойЧасти = "" Тогда
			СтруктураРеквизита = Новый Структура;
			СтруктураРеквизита.Вставить("Имя", 				СтрокаТЧ.Имя);
			СтруктураРеквизита.Вставить("Значение", 		СтрокаТЧ.Значение);
			СтруктураРеквизита.Вставить("Представление", 	СтрокаТЧ.Представление);
			
			МассивРеквизитов.Добавить(СтруктураРеквизита);
		КонецЕсли;
	КонецЦикла;
	
	НаименованиеХранимыхДанных = ОбменСГИСЭПД.ПредставлениеХранимыхДанныхЭПД(МассивРеквизитов, ХранимыеДанные.ИмяОбъекта, ХранимыеДанные.ГруппаДанных);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	|	ХранимыеДанныеЭПД.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ХранимыеДанныеЭПД КАК ХранимыеДанныеЭПД
	|ГДЕ
	|	ХранимыеДанныеЭПД.Наименование = &Наименование
	|	И ХранимыеДанныеЭПД.ГруппаДанных = &ГруппаДанных";  
	
	Запрос.УстановитьПараметр("Наименование", НаименованиеХранимыхДанных);
	Запрос.УстановитьПараметр("ГруппаДанных", ХранимыеДанные.ГруппаДанных);
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;	
	КонецЕсли;
	
	ОбъектХранимыеДанныеЭПД = Справочники.ХранимыеДанныеЭПД.СоздатьЭлемент();
	ЗаполнитьЗначенияСвойств(ОбъектХранимыеДанныеЭПД, ХранимыеДанные, ,"Данные"); 
	
	Для Каждого СтруктураСтроки из ХранимыеДанные.Данные Цикл
		НоваяСтрока = ОбъектХранимыеДанныеЭПД.Данные.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока,СтруктураСтроки); 
	КонецЦикла; 
	
	ОбъектХранимыеДанныеЭПД.Записать();
	
	Возврат ОбъектХранимыеДанныеЭПД.Ссылка;
	
КонецФункции

  
Функция ПривестиИмяОбласти(Знач ОбластьИмя) Экспорт
	
	ПриведенныеИменаРеквизитов = ПриведенныеИменаРеквизитов();
	
	НовОбластьИмя = ОбластьИмя;
	Для Каждого КлючЗначение из ПриведенныеИменаРеквизитов Цикл
		НовОбластьИмя = СтрЗаменить(НовОбластьИмя, КлючЗначение.Значение, КлючЗначение.Ключ);	
	КонецЦикла;  
	
	Возврат НовОбластьИмя;
	
КонецФункции  

Функция ВостановитьПриведенноеИмяРеквизита(Знач ПриведенноеИмяРеквизита) Экспорт
	
	ПриведенныеИменаРеквизитов = CW_ОбменГИСЭПДДополнительный.ПриведенныеИменаРеквизитов();
	
	НовИмяРеквизита = ПриведенныеИменаРеквизитов.Получить(ПриведенноеИмяРеквизита);
	НовИмяРеквизита = ?(НовИмяРеквизита = Неопределено, ПриведенноеИмяРеквизита, НовИмяРеквизита);
	
	Возврат НовИмяРеквизита;

КонецФункции

Функция ПриведенныеИменаРеквизитов() Экспорт

	Именареквизитов = Новый Соответствие;
	Именареквизитов.Вставить("ФЛИНН", 	"ФЛ_ИНН");
	Именареквизитов.Вставить("ИПИНН", 	"ИП_ИНН");
	Именареквизитов.Вставить("ЮЛИНН", 	"ЮЛ_ИНН");
	Именареквизитов.Вставить("ЮЛКПП", 	"ЮЛ_КПП");
	Именареквизитов.Вставить("ЮЛОГРН", 	"ЮЛ_ОГРН");
	
	Возврат Именареквизитов;
	
КонецФункции  
