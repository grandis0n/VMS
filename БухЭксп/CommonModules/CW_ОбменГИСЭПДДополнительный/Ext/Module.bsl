Функция ПолучитьМассивСвойствСтруктуры(ТипДокумента, ТекущийТитул) Экспорт
	
	Макет = CW_ОбменГИСЭПДПереопределяемый.МакетСоответствийИменРеквизитов(ТипДокумента);
	
	ИнформацияПоПрефиксамТитула = CW_ОбменГИСЭПДПереопределяемый.ПрефиксТитулаПоЭлементуРегламентаЭДО(ТекущийТитул);
	ПрефиксТитула = ИнформацияПоПрефиксамТитула.ВПрограмме;
	
	Массив = Новый Массив;
	
	ОбластьМакета = Макет.ПолучитьОбласть(ПрефиксТитула); 
	Для Строка = 1 по ОбластьМакета.ВысотаТаблицы Цикл 
		ИмяРеквизита = СокрЛП(ОбластьМакета.Область(Строка, 1, Строка, 1).Текст);
		ИмяРеквизита = СтрЗаменить(ИмяРеквизита, ".", "_");
		
		Массив.Добавить(ИмяРеквизита);	
	КонецЦикла; 
	
	Возврат Массив;
	
КонецФункции

Функция ЗаписываемыеПоляПоТитулу(Титул)

	ДанныеПолей = Новый Массив;
	
