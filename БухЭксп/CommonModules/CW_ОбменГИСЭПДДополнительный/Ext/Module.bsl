		СтрокаСпециальныеУсловияДвижения.ИдентификаторСтроки 			= "ТитулПеревозчикаСпециальныеУсловияДвижения_ИдентификаторСтроки";
		СтрокаСпециальныеУсловияДвижения.ИдентификаторСтрокиРодителя 	= "ТитулПеревозчикаСпециальныеУсловияДвижения_ИдентификаторСтрокиРодителя";

		Соответствие.Вставить("СпециальныеУсловияДвижения", ДеревоОснованияВладенияТС);
		
	КонецЕсли;
	
	Возврат Соответствие;
	
КонецФункции

Функция СоздатьДеревоИдентификаторов()
	
	ДеревоОбластей = Новый ДеревоЗначений;
	ДеревоОбластей.Колонки.Добавить("ИдентификаторСтроки");
	ДеревоОбластей.Колонки.Добавить("ИдентификаторСтрокиРодителя");

	Возврат ДеревоОбластей;

КонецФункции

Процедура УстановитьУИДДляСтроки(ТабДокумент, Строки, НачИндекс) 
	
	Для Каждого Строка из Строки Цикл  
		
		ИмяОбласти = Строка.ИдентификаторСтроки + НачИндекс;
		Область =  ТабДокумент.Области.Найти(ИмяОбласти); 
		Если Область <> Неопределено Тогда
			Область.Значение = Строка(Новый УникальныйИдентификатор); 
			
			Если ЗначениеЗаполнено(Строка.ИдентификаторСтрокиРодителя) Тогда 
				ИмяОбластиРодитель	= Строка.Родитель.ИдентификаторСтроки + НачИндекс;
				
				ОбластьВладелец 	= ТабДокумент.Области.Найти(ИмяОбластиРодитель); 
				Если ОбластьВладелец <> Неопределено Тогда
					НовИмяОбласти = Строка.ИдентификаторСтрокиРодителя + НачИндекс;
					НовОбласть 	= ТабДокумент.Области.Найти(НовИмяОбласти); 
					Если НовОбласть <> Неопределено Тогда
						НовОбласть.Значение 	= ОбластьВладелец.Значение;      
					КонецЕсли; 
				КонецЕсли; 
			КонецЕсли; 
		КонецЕсли; 
		
		Если Строка.Строки.Количество() > 0 Тогда
			УстановитьУИДДляСтроки(ТабДокумент, Строка.Строки, НачИндекс);	
		КонецЕсли;   
		
	КонецЦикла;
	
КонецПроцедуры

Функция ВысотаМногострочнойЧасти(ИмяГруппы, ТаблДок = Неопределено) Экспорт
	
	ИскомаяОбласть1 = ТаблДок.Области.Найти("МногострочнаяЧасть" + ИмяГруппы); 
	
	Для каждого ИскомаяОбласть2 Из ТаблДок.Области Цикл  
		Если СтрНачинаетсяС(ИскомаяОбласть2.Имя, "ДобавлениеСтроки" + ИмяГруппы) Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Возврат ИскомаяОбласть2.Верх - ИскомаяОбласть1.Верх;
	
КонецФункции

Функция ПолучитьВычисляемуюФункциюЯчейки(ПараметрКоманды, ТипОбъекта, ЗначениеЯчейки, НомерСтроки=Неопределено) Экспорт

	Для Каждого СтрокаТаблицы из ЗначениеЯчейки.ФункцииЗначения Цикл 
		
		Если НомерСтроки <> Неопределено Тогда 
			
			ЧетнаяСтрока = (НомерСтроки%2 = 0);
			Если СтрокаТаблицы.ОтборПоНомеруСтроки = "Четные"
				И НЕ ЧетнаяСтрока Тогда
				Продолжить;
			КонецЕсли;
			
			Если СтрокаТаблицы.ОтборПоНомеруСтроки = "Нечетные"
				И ЧетнаяСтрока Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		
		Успешно = УсловиеОтбораВыполняется(ПараметрКоманды, ТипОбъекта, СтрокаТаблицы.ХранилищеОтбора);
		Если Успешно Тогда 
			Возврат СтрокаТаблицы.ФункцияЗначения;
		КонецЕсли;
	КонецЦикла;
	
КонецФункции   

Функция ПолучитьМассивСтрок(ПараметрыФункции) Экспорт 
	
	НастройкиОтбора = ПараметрыФункции.ВычисляемаяФункция.ХранилищеНастроек.Получить();   
	
	СоответствиеОбщегоМакетаПоИмени = CW_КлючевыеПоказателиСервер.ПолучитьСоответствиеИмениМакета();
	ИмяМакета	= СоответствиеОбщегоМакетаПоИмени.Получить(ПараметрыФункции.ВычисляемаяФункция.ИмяМакета);
	Схема		= ПолучитьОбщийМакет(ИмяМакета);
	
	АдресСхемы 	= ПоместитьВоВременноеХранилище(Схема, Новый УникальныйИдентификатор);
	
	ИсточникДоступныхНастроек = Новый ИсточникДоступныхНастроекКомпоновкиДанных(АдресСхемы);
	
	КомпоновщикНастроек = Новый КомпоновщикНастроекКомпоновкиДанных;
	КомпоновщикНастроек.Инициализировать(ИсточникДоступныхНастроек); 
	КомпоновщикНастроек.ЗагрузитьНастройки(Схема.НастройкиПоУмолчанию);
	
	Для Каждого СтрокаНастроек из НастройкиОтбора Цикл
		ЭлементОтбора = КомпоновщикНастроек.Настройки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		
		НовыеПараметрыФункции = Новый Структура; 
		НовыеПараметрыФункции.Вставить("ВычисляемаяФункция", 	СтрокаНастроек.Значение);
		НовыеПараметрыФункции.Вставить("ПараметрКоманды",		ПараметрыФункции.ПараметрКоманды);
		НовыеПараметрыФункции.Вставить("ТипОбъекта",			ПараметрыФункции.ТипОбъекта); 
		
		ПравоеЗначение = ВычислитьЗначениеЯчейки(НовыеПараметрыФункции); 
		Если ТипЗнч(ПравоеЗначение)= Тип("Структура") Тогда
			ПравоеЗначение = ПравоеЗначение.Значение;	
		КонецЕсли;
		
		ЭлементОтбора.ЛевоеЗначение 	= Новый ПолеКомпоновкиДанных(СтрокаНастроек.ПутьКДанным);
		ЭлементОтбора.ВидСравнения 		= СтрокаНастроек.ВидСравнения;
		ЭлементОтбора.ПравоеЗначение 	= ПравоеЗначение;
		ЭлементОтбора.Использование 	= Истина;
		
	КонецЦикла;

	КомпоновщикМакета 	= Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки 	= КомпоновщикМакета.Выполнить(Схема, КомпоновщикНастроек.Настройки, , , Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	
	ПроцессорКомпоновкиДанных 	= Новый ПроцессорКомпоновкиДанных;    
	ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновки);
	
	ТаблицаЗначений = Новый ТаблицаЗначений;
	
	ПроцессорВыводаРезультата 	= Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;    
	ПроцессорВыводаРезультата.УстановитьОбъект(ТаблицаЗначений);
	ПроцессорВыводаРезультата.Вывести(ПроцессорКомпоновкиДанных); 
	
	Массив = Новый Массив;
	
	Для Каждого СтрокаТаблицы из ТаблицаЗначений Цикл
		Для Индекс = 1 по ПараметрыФункции.ВычисляемаяФункция.Множитель Цикл
			Массив.Добавить(СтрокаТаблицы.Ссылка);	
		КонецЦикла;
	КонецЦикла;
	
	Возврат Массив;
	
КонецФункции   

Функция УсловиеОтбораВыполняется(ПараметрКоманды, ТипОбъекта, ХранилищеОтбора)
	
	СхемаКомпоновкиДанных 	= CW_ОбменГИСЭПДДополнительный.ПолучитьСхемуКомпоновкиДанных(ТипОбъекта);
	Настройки 				= СхемаКомпоновкиДанных.НастройкиПоУмолчанию;
	
	НастройкиОтбора 		= ХранилищеОтбора.Получить();
	Если НастройкиОтбора <> Неопределено Тогда
		_УФС.СкопироватьОтбор(НастройкиОтбора.Отбор, Настройки.Отбор);
	КонецЕсли;
	
	ЭлементОтбора 					= Настройки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение 	= Новый ПолеКомпоновкиДанных("Ссылка");
	ЭлементОтбора.ВидСравнения 		= ВидСравненияКомпоновкиДанных.Равно;
	ЭлементОтбора.ПравоеЗначение 	= ПараметрКоманды;
	ЭлементОтбора.Использование	 	= Истина;
	
	ДанныеРасшифровки = Новый ДанныеРасшифровкиКомпоновкиДанных;
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, Настройки, ДанныеРасшифровки,,Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	
	ПроцессорКомпоновкиДанных = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновки, , ДанныеРасшифровки);
	
	Результат = Новый ТаблицаЗначений;
	
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	ПроцессорВывода.УстановитьОбъект(Результат);
	
	ПроцессорВывода.Вывести(ПроцессорКомпоновкиДанных);  
	
	Возврат Результат.Количество() > 0;
	
КонецФункции

Функция ВычислитьЗначениеЯчейки(ПараметрыФункции) Экспорт 
	
	ВычисляемаяФункция 	= ПараметрыФункции.ВычисляемаяФункция;  
	
	//Аргументы функций
	ПараметрКоманды = ПараметрыФункции.ПараметрКоманды;  
	
	НомерСтроки = 1;
	Если ПараметрыФункции.Свойство("НомерСтроки") Тогда
		НомерСтроки 	= ПараметрыФункции.НомерСтроки;    
	КонецЕсли;
	
	//Реквизит / свойство(0)  
	Если ВычисляемаяФункция.СпособПолученияЗначения = 0 Тогда 
		Возврат ПолучитьЗначениеПараметраОбъекта(ПараметрыФункции);  
	КонецЕсли;
	
	//Фиксированное значение(2)
	Если ВычисляемаяФункция.СпособПолученияЗначения = 1 Тогда
		Возврат ВычисляемаяФункция.Значение; 
	КонецЕсли;    
	
	//Формула(3)	
	Если ВычисляемаяФункция.СпособПолученияЗначения = 2 Тогда
		
		ДанныеФормулы 		= ПолучитьДанныеДляРасчетаФункции(ВычисляемаяФункция.ТекстФормулы, ПараметрыФункции);
		ПоказателиФормулы	= ДанныеФормулы.ПоказателиФормулы; 
		
		Попытка    
			Возврат Вычислить(ДанныеФормулы.Формула);
		Исключение 
		КонецПопытки;  
		
	КонецЕсли;    
	
КонецФункции   

Функция ПолучитьДанныеДляРасчетаФункции(Знач Формула, Знач ПараметрыФункции) 
	
	СтрокаЦифр 			= "0123456789"; 
	
	ПоказателиФормулы 	= Новый Структура; 
	ПоказателиФормулы.Вставить("ПараметрКоманды", ПараметрыФункции.ПараметрКоманды);
	
	МассивПоказателей 		= CW_ОбменГИСЭПДПовторноеИспользование.ПолучитьВложенныеФункцииФормулы();
	СоответствиеФункций 	= CW_ОбменГИСЭПДПовторноеИспользование.ПолучитьСоответствиеФункций();
	
	РазделителиФормулы 		= " +-/*?=<>()," + Символы.ВК + Символы.ВТаб + Символы.НПП + Символы.ПС + Символы.ПФ + Символы.Таб;
	ЗарезервированныеСлова 	= СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок("ЦЕЛ,INT,ОКР,ROUND,МАКС,MAX,МИН,MIN,И,ИЛИ,НЕ,OR,AND,NOT");
	
	Слова = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивСлов(Формула, РазделителиФормулы);
	Для Каждого Слово Из Слова Цикл
		// Это число
		Если СтрНайти(СтрокаЦифр, СтрЗаменить(Слово, ".", "")) > 0 Тогда
			Продолжить;
		КонецЕсли;
		// Это зарезервированное слово.
		Если ЗарезервированныеСлова.Найти(ВРег(Слово)) <> Неопределено Тогда 
			Продолжить;
		КонецЕсли;     
		// Это должен быть другая функция 
		мСлова = СтрРазделить(Слово, ".", Ложь);
		Если мСлова.Количество() > 1 Тогда  
			//Если это вложенная функция, то всегда начинается с ее имени
			Слово = мСлова[0];
		КонецЕсли;
		Если МассивПоказателей.Найти(Слово) <> Неопределено 
			и ПоказателиФормулы.Свойство(Слово) = Ложь Тогда  
			
			ВложеннаяФункция = СоответствиеФункций.Получить(Слово); 
			
			ПараметрыФункции.Вставить("ВычисляемаяФункция", ВложеннаяФункция);
			
			ЗначениеВложеннойФункции = ВычислитьЗначениеЯчейки(ПараметрыФункции);
			Если ТипЗнч(ЗначениеВложеннойФункции)= Тип("Структура") Тогда
				ЗначениеВложеннойФункции = ЗначениеВложеннойФункции.Значение;	
			КонецЕсли;
			
			ПоказателиФормулы.Вставить(Слово, ЗначениеВложеннойФункции);  
			
			Формула = СтрЗаменить(Формула, Слово , "ПоказателиФормулы."+Слово);
		КонецЕсли; 
		
	КонецЦикла;
	
	ДанныеДляРасчета = Новый Структура;
	ДанныеДляРасчета.Вставить("Формула", 			Формула);
	ДанныеДляРасчета.Вставить("ПоказателиФормулы", 	ПоказателиФормулы);
	
	Возврат ДанныеДляРасчета;
	
КонецФункции  

Функция ПолучитьЗначениеПараметраОбъекта(ПараметрыФункции) Экспорт

	ПолучатьХранимыеДанные 	= ложь;
	ПутьКДанным 			= ПараметрыФункции.ВычисляемаяФункция.ПутьКДанным;
	ЗначениеСвойства 		= ВыполнитьСКД(ПараметрыФункции, ПутьКДанным);   
	
	Если СтрЗаканчиваетсяНа(ПараметрыФункции.ВычисляемаяФункция.ПутьКДанным, "]") Тогда
		ПозНачала		= СтрНайти(ПараметрыФункции.ВычисляемаяФункция.ПутьКДанным, "[", НаправлениеПоиска.СКонца);
		ПутьКДанным		= Лев(ПараметрыФункции.ВычисляемаяФункция.ПутьКДанным, ПозНачала-2); 
		ОбъектПараметра	= ВыполнитьСКД(ПараметрыФункции, ПутьКДанным);
		
		ИдентификаторПараметра 	= Сред(ПараметрыФункции.ВычисляемаяФункция.ПутьКДанным, ПозНачала);
		ИдентификаторПараметра	= СтрЗаменить(ИдентификаторПараметра, "]", "");
		ИдентификаторПараметра	= СтрЗаменить(ИдентификаторПараметра, "[", "");  
		
		МониторинговыйПараметр = ПланыВидовХарактеристик.CW_ПараметрыГрузоперевозок.НайтиПоРеквизиту("Идентификатор",ИдентификаторПараметра); 
		
		Если Не МониторинговыйПараметр.Пустая() Тогда
			ПолучатьХранимыеДанные = МониторинговыйПараметр.ИспользоватьФормуВводаАдреса 
			или МониторинговыйПараметр.СохранятьПолноеЗначениеПараметра;	
			
			Если ПолучатьХранимыеДанные Тогда
				ЗначениеСвойства = ПолучитьХранимыеДанные(ОбъектПараметра, МониторинговыйПараметр);	
			КонецЕсли;
		КонецЕсли; 
		
	КонецЕсли;
	
	Возврат ЗначениеСвойства;
	
КонецФункции

Функция ВыполнитьСКД(Знач ПараметрыФункции, Знач ПутьКДанным)
	
	
	Схема = CW_ОбменГИСЭПДДополнительный.ПолучитьСхемуКомпоновкиДанных(ПараметрыФункции.ТипОбъекта);
	
	НаборДанных = Схема.НаборыДанных.Получить(0);
	НаборДанных.Запрос = СтрЗаменить(НаборДанных.Запрос, "ВЫБРАТЬ", "ВЫБРАТЬ ПЕРВЫЕ 1"); 
	
	АдресСхемы 	= ПоместитьВоВременноеХранилище(Схема, Новый УникальныйИдентификатор);
	
	ИсточникДоступныхНастроек = Новый ИсточникДоступныхНастроекКомпоновкиДанных(АдресСхемы);
	
	КомпоновщикНастроек = Новый КомпоновщикНастроекКомпоновкиДанных;
	КомпоновщикНастроек.Инициализировать(ИсточникДоступныхНастроек);
	КомпоновщикНастроек.ЗагрузитьНастройки(Схема.НастройкиПоУмолчанию);
	
	ПолеВыбор = КомпоновщикНастроек.Настройки.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных")); 
	ПолеВыбор.Поле 			= Новый ПолеКомпоновкиДанных(ПутьКДанным); 
	ПолеВыбор.Использование = Истина; 
	
	ЭлементОтбора = КомпоновщикНастроек.Настройки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных")); 
	ЭлементОтбора.ЛевоеЗначение 	= Новый ПолеКомпоновкиДанных("Ссылка");
	ЭлементОтбора.ВидСравнения  	= ВидСравненияКомпоновкиДанных.Равно;
	ЭлементОтбора.ПравоеЗначение	= ПараметрыФункции.ПараметрКоманды;
	ЭлементОтбора.Использование 	= Истина;   
	
	ДанныеРасшифровки = Новый ДанныеРасшифровкиКомпоновкиДанных;
	
	КомпоновщикМакета 	= Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки 	= КомпоновщикМакета.Выполнить(Схема, КомпоновщикНастроек.Настройки, ДанныеРасшифровки, , Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	
	ПроцессорКомпоновкиДанных 	= Новый ПроцессорКомпоновкиДанных;    
	ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновки,,ДанныеРасшифровки);
	
	ТаблицаЗначений = Новый ТаблицаЗначений;
	
	ПроцессорВыводаРезультата 	= Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;    
	ПроцессорВыводаРезультата.УстановитьОбъект(ТаблицаЗначений);
	ПроцессорВыводаРезультата.Вывести(ПроцессорКомпоновкиДанных); 
	
	ЧастиПоля = СтрРазделить(ПутьКДанным, ".");
	Если ЧастиПоля.Количество() = 1 Тогда
		Колонка = ТаблицаЗначений.Колонки[0];
	Иначе
		Колонка = ТаблицаЗначений.Колонки[1];
	КонецЕсли;    
	
	Если ТаблицаЗначений.Количество() = 1 Тогда
		Возврат ТаблицаЗначений[0][Колонка.Имя];
	КонецЕсли;
	
	Типы = Колонка.ТипЗначения.Типы();
	Если Типы.Найти(Тип("Null")) <> Неопределено Тогда
		Типы.Удалить(Типы.Найти(Тип("Null")));	
	КонецЕсли;                       
	
	ОписаниеТипов = Новый ОписаниеТипов(Типы);
	
	Возврат ОписаниеТипов.ПривестиЗначение(Неопределено);

КонецФункции  

Функция ПолучитьХранимыеДанные(ОбъектПараметра, Параметр) Экспорт

	Если ТипЗнч(ОбъектПараметра) = Тип("СправочникСсылка.CW_Грузоперевозки") Тогда 
		ИмяРегистра	= "CW_ХарактеристикиГрузоперевозок";  
		Условие		= "И Характеристики.Грузоперевозка = &ОбъектПараметра";
	КонецЕсли;  
	Если ТипЗнч(ОбъектПараметра) = Тип("СправочникСсылка.CW_Заказы") Тогда
		ИмяРегистра = "CW_ХарактеристикиЗаказов";
		Условие		= "И Характеристики.Заказ = &ОбъектПараметра";
	КонецЕсли;  
	Если ТипЗнч(ОбъектПараметра) = Тип("СправочникСсылка.CW_Заявки") Тогда
		ИмяРегистра = "CW_ХарактеристикиЗаявок";
		Условие		= "И Характеристики.Заявка = &ОбъектПараметра";
	КонецЕсли;  
	Если ТипЗнч(ОбъектПараметра) = Тип("СправочникСсылка.CW_ДоговорыПоГрузоперевозкам") 
		или ТипЗнч(ОбъектПараметра) = Тип("СправочникСсылка.CW_ПриложенияКДоговорам") Тогда
		ИмяРегистра = "CW_ХарактеристикиДоговоровИПриложений";
		Условие		= "И Характеристики.Объект = &ОбъектПараметра";
	КонецЕсли;  
	
	Запрос = Новый Запрос; 
	Запрос.УстановитьПараметр("ОбъектПараметра", 	ОбъектПараметра);
	Запрос.УстановитьПараметр("Параметр", 			Параметр);
	
	Запрос.Текст = "ВЫБРАТЬ
	|	Характеристики.ХранилищеДанных КАК ХранилищеДанных
	|ИЗ
	|	РегистрСведений."+ИмяРегистра+" КАК Характеристики
	|ГДЕ
	|	Характеристики.Параметр = &Параметр 
	|	"+Условие;  
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	Если Выборка.Следующий() Тогда
		ХранимыеДанные = Выборка.ХранилищеДанных.Получить();
		Если ХранимыеДанные <> Неопределено Тогда
			Возврат ХранимыеДанные;
		Конецесли;
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

Функция ПолучитьСвязанныйДокументЭПД(ЭПД) Экспорт
	
	Возврат РегистрыСведений.CW_ОбменГИСЭПДСвязанныеДокументыЭПД.ПолучитьСвязанныйДокументЭПД(ЭПД);
	
КонецФункции 

