Функция ПолучитьДоступныеТипыДокументовЭДО() Экспорт
	
	ТипыДокументовЭПД = Новый Массив;
	ТипыДокументовЭПД.Добавить(Перечисления.ТипыДокументовЭДО.ЭЗЗ);
	ТипыДокументовЭПД.Добавить(Перечисления.ТипыДокументовЭДО.ЭТрН);
	ТипыДокументовЭПД.Добавить(Перечисления.ТипыДокументовЭДО.ЭПЛ);
	//ТипыДокументовЭПД.Добавить(Перечисления.ТипыДокументовЭДО.ЭСВ);
	
	Возврат ТипыДокументовЭПД;
	
КонецФункции   

Функция ПолучитьСтруктуруПараметровДокументовЭПД(Знач ТипыДокументовЭПД) Экспорт
	
	ТипыЭлементовРегламентаЭДО = Перечисления.ТипыЭлементовРегламентаЭДО;
	
	Настройки = Новый Соответствие;     
	
	Для Каждого ТипДокумента из ТипыДокументовЭПД Цикл
		
		Если ТипДокумента = ПредопределенноеЗначение("Перечисление.ТипыДокументовЭДО.ЭЗЗ") Тогда  
			ПараметрыДокументаЭПД = СтруктураПараметровЭЗЗ(ТипДокумента, ТипыЭлементовРегламентаЭДО);
			
			Настройки.Вставить(ТипДокумента, ПараметрыДокументаЭПД);
		КонецЕсли;     
		
		Если ТипДокумента = ПредопределенноеЗначение("Перечисление.ТипыДокументовЭДО.ЭТрН") Тогда  
			ПараметрыДокументаЭПД = СтруктураПараметровЭТрН(ТипДокумента, ТипыЭлементовРегламентаЭДО);
			
			Настройки.Вставить(ТипДокумента, ПараметрыДокументаЭПД);
		КонецЕсли;
		
		Если ТипДокумента = ПредопределенноеЗначение("Перечисление.ТипыДокументовЭДО.ЭПЛ") Тогда  
			ПараметрыДокументаЭПД = СтруктураПараметровЭПЛ(ТипДокумента, ТипыЭлементовРегламентаЭДО);
			
			Настройки.Вставить(ТипДокумента, ПараметрыДокументаЭПД);
		КонецЕсли; 
		
		Если ТипДокумента = ПредопределенноеЗначение("Перечисление.ТипыДокументовЭДО.ЭСВ") Тогда  
			ПараметрыДокументаЭПД = СтруктураПараметровЭСВ(ТипДокумента, ТипыЭлементовРегламентаЭДО);
			
			Настройки.Вставить(ТипДокумента, ПараметрыДокументаЭПД);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Настройки;
	
КонецФункции

Функция СтруктураПараметровЭТрН(Знач ТипДокумента, Знач ТипыЭлементовРегламентаЭДО)
	
	ЭТрН_Титулы = Новый Массив;
	ЭТрН_Титулы.Добавить(ТипыЭлементовРегламентаЭДО.ЭТрН_Титул1);
