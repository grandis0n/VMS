Функция ПолучитьРеквизитыУчастника(Участник, ПрефиксРеквизитов, ПрефиксТитула = Неопределено) Экспорт
	
	ПостфиксТелефоны = "НомераТелефонов";
	ПостфиксЭлПочта = "АдресаЭлектроннойПочты";
	
	ЕстьТелефоны = Ложь;
	ЕстьЭлПочта = Ложь;
	Если ПрефиксРеквизитов <> "Заказчик" Тогда
		ЕстьТелефоны = Истина;
		ЕстьЭлПочта = Истина;
	КонецЕсли;
	
	ПрефиксПодчиненныхТаблиц = "";
	Если ПрефиксТитула <> Неопределено И СтрНачинаетсяС(ПрефиксРеквизитов, ПрефиксТитула) = Ложь Тогда
		ПрефиксПодчиненныхТаблиц = ПрефиксТитула;
	КонецЕсли;
	
	РеквизитыУчастника = CW_ОбменГИСЭПДПереопределяемый.ПолучитьРеквизитыУчастника(Участник, Ложь);
	
	ПрефиксКонтактов = "";
	ПрефиксАдреса = "";
	Если ПрефиксРеквизитов = "ТитулФрахтователяФрахтователь"
		Или ПрефиксРеквизитов = "ТитулФрахтователяФрахтовщик"
		Или ПрефиксРеквизитов = "ТитулФрахтователяСоставитель"
		Или ПрефиксРеквизитов = "ТитулФрахтовщикаСоставитель" Тогда
		Если РеквизитыУчастника.Свойство("ЮЛ_ИНН") И ЗначениеЗаполнено(РеквизитыУчастника.ЮЛ_ИНН) Тогда
			ПрефиксКонтактов = "ЮЛ";
			ПрефиксАдреса = "ЮЛ";
		Иначе
			ПрефиксКонтактов = "ФЛ";
			ПрефиксАдреса = Неопределено;
		КонецЕсли;
	ИначеЕсли ПрефиксРеквизитов = "ТитулФрахтовщикаФрахтовщик"
		Или ПрефиксРеквизитов = "ТитулПеревозчикаПеревозчик"
		Или ПрефиксРеквизитов = "ТитулПеревозчикаГрузоотправитель"
		Или ПрефиксРеквизитов = "ТитулПеревозчикаГрузополучатель"
		Или ПрефиксРеквизитов = "ТитулПеревозчикаЛицоОсуществляющееПогрузку"
		Или ПрефиксРеквизитов = "ТитулПеревозчикаЛицоОсуществляющееПриемку"
		Или ПрефиксРеквизитов = "ДопТитулПеревозчикаПеревозчик"
		Или ПрефиксРеквизитов = "ДопТитулПеревозчикаГрузоотправитель"
		Или ПрефиксРеквизитов = "ДопТитулПеревозчикаГрузополучатель"
		Или ПрефиксРеквизитов = "ДопТитулПеревозчикаЛицоОсуществляющееПогрузку"
		Или ПрефиксРеквизитов = "ДопТитулПеревозчикаЛицоОсуществляющееПриемку" Тогда
		Если (РеквизитыУчастника.Свойство("ЮЛ_ИНН") И ЗначениеЗаполнено(РеквизитыУчастника.ЮЛ_ИНН))
			ИЛИ (РеквизитыУчастника.Свойство("ЮЛ_КПП") И ЗначениеЗаполнено(РеквизитыУчастника.ЮЛ_КПП)) Тогда
			ПрефиксКонтактов = "ЮЛ";
			ПрефиксАдреса = "ЮЛ";
		Иначе
			ПрефиксКонтактов = "ИП";
			ПрефиксАдреса = Неопределено;
		КонецЕсли;	
	КонецЕсли;
	
	СтруктураДляЗаполнения = Новый Структура;
	Для Каждого КиЗ Из РеквизитыУчастника Цикл
		Если КиЗ.Ключ <> ПостфиксТелефоны И КиЗ.Ключ <> ПостфиксЭлПочта Тогда
			Если СтрНачинаетсяС(КиЗ.Ключ, "Адрес") И ПрефиксАдреса <> Неопределено Тогда
				КороткоеИмя = ПрефиксАдреса + КиЗ.Ключ;	
			Иначе
				КороткоеИмя = КиЗ.Ключ
			КонецЕсли;
			МассивЧастей = СтрРазделить(ПрефиксРеквизитов, "_");
			ИмяРеквизита = МассивЧастей[МассивЧастей.ВГраница()] + КороткоеИмя;
			СтруктураДляЗаполнения.Вставить(ИмяРеквизита, КиЗ.Значение);
		КонецЕсли;
	КонецЦикла;
	
    Возврат СтруктураДляЗаполнения;
	
КонецФункции

Процедура УстановитьПараметрыТиповДокументовЭПД(Форма) Экспорт
	
	ТипыДокументовЭПД = CW_ОбменГИСЭПДДополнительный.ПолучитьДоступныеТипыДокументовЭДО(); 
	СтруктураПараметрыДокументовЭПД = CW_ОбменГИСЭПДДополнительный.ПолучитьСтруктуруПараметровДокументовЭПД(ТипыДокументовЭПД);
	
	Форма.ПараметрыДокументовЭПД 		= Новый ФиксированноеСоответствие(СтруктураПараметрыДокументовЭПД);
	Форма.ДоступныеТипыДокументовЭПД 	= Новый ФиксированныйМассив(ТипыДокументовЭПД);
	
	Форма.Элементы.ТипДокументаЭПД.СписокВыбора.ЗагрузитьЗначения(ТипыДокументовЭПД);

КонецПроцедуры


Процедура УстановитьСписокВыбораТитула(Форма) Экспорт
	
	ЭлементыФормы = Форма.Элементы;
	
	ЭлементыФормы.ТекущийТитул.СписокВыбора.Очистить();   
	Если Форма.ПараметрыДокументовЭПД = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыДокументаЭПД = Форма.ПараметрыДокументовЭПД.Получить(Форма.Объект.ТипДокументаЭПД); 
	Если ТипЗнч(ПараметрыДокументаЭПД) = Тип("ФиксированнаяСтруктура") тогда   
		ЭлементыФормы.ТекущийТитул.СписокВыбора.ЗагрузитьЗначения(Новый Массив(ПараметрыДокументаЭПД["Титулы"]));
	КонецЕсли; 
	
КонецПроцедуры 

Процедура ЗаполнитьДоступныеТипыОбъектов(Форма) Экспорт
	
	Элементы = Форма.Элементы;
	
	Элементы.ТипОбъекта.СписокВыбора.Очистить();
	
	Массив = Метаданные.ОпределяемыеТипы.CW_ОбменГИСЭПД_ОснованияЭПД.Тип.Типы();

	Если Не ПолучитьФункциональнуюОпцию("CW_ИспользованиеБлокаСобственногоТранспорта") Тогда
		Массив.Удалить(Тип("ДокументСсылка.CW_ПутевойЛист"));                               
	КонецЕсли;
	
	Идентификаторы = ОбщегоНазначения.ИдентификаторыОбъектовМетаданных(Массив);
	Для Каждого КлючЗначение из Идентификаторы Цикл
		Элементы.ТипОбъекта.СписокВыбора.Добавить(КлючЗначение.Значение);
	КонецЦикла;

КонецПроцедуры  

Функция ПолучитьСхемуКомпоновкиДанных(ИдентификаторОбъектаМетаданных) Экспорт
	
	Схема = ПолучитьОбщийМакет("CW_ОбменГИСЭПДСхемаОтбора");  
	НаборДанных = Схема.НаборыДанных.Получить(0);              
	НаборДанных.Запрос = СтрЗаменить(НаборДанных.Запрос, "//ТипОбъекта", ИдентификаторОбъектаМетаданных.ПолноеИмя); 
	
	ПолеСсылка = НаборДанных.Поля[0];
	ПолеСсылка.Заголовок = ИдентификаторОбъектаМетаданных.Синоним;
	
	Возврат Схема;

КонецФункции

Процедура ПолучитьДанныеДокументаЭПД(ПараметрыПроцедуры, АдресРезультата=Неопределено) Экспорт
	
	ПараметрКоманды	= ПараметрыПроцедуры.ПараметрКоманды;;
	РезультатВыбора	= ПараметрыПроцедуры.РезультатВыбора; 

	КонтактнаяИнформация = Новый Структура;
	
	ИмяДокумента 			= CW_ОбменГИСЭПДПереопределяемый.ИмяДокументаПоТипу(РезультатВыбора.ТипДокументаЭПД);
	ТипыДокументовЭПД 		= CW_ОбменГИСЭПДДополнительный.ПолучитьДоступныеТипыДокументовЭДО(); 
	ПараметрыДокументовЭПД 	= CW_ОбменГИСЭПДДополнительный.ПолучитьСтруктуруПараметровДокументовЭПД(ТипыДокументовЭПД);
	ВидДокумента 			= ЭлектронныеДокументыЭДО.ВидДокументаПоТипу(РезультатВыбора.ТипДокументаЭПД);
	
	ПараметрыДокументаЭПД 	= ПараметрыДокументовЭПД.Получить(РезультатВыбора.ТипДокументаЭПД);
	ИмяМакета 				= ПараметрыДокументаЭПД["Макеты"].Получить(РезультатВыбора.ТекущийТитул); 
	МакетЭПД 				= Справочники.CW_ОбменГИСЭПДПроформыТитуловЭПД.ПолучитьМакет(ИмяМакета);
	
	ИнформацияПоПрефиксамТитула = CW_ОбменГИСЭПДПереопределяемый.ПрефиксТитулаПоЭлементуРегламентаЭДО(РезультатВыбора.ТекущийТитул);
	ПрефиксТитула 				= ИнформацияПоПрефиксамТитула.ВПрограмме;

	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.Вывести(МакетЭПД); 
	
	Для Каждого Область из ТабличныйДокумент.Области Цикл
		Если СтрНайти(Область.Имя, "Титул") > 0
			И СтрНайти(Область.Имя, "ИдентификаторСтроки") = 0 Тогда
			Область.Значение = Область.ТипЗначения.ПривестиЗначение(Неопределено);
		КонецЕсли;
	КонецЦикла;    
	
	УстановитьИдентификаторыСтрок(РезультатВыбора.ТекущийТитул, ТабличныйДокумент, "_1"); 
	УстановитьИдентификаторыСтрок(РезультатВыбора.ТекущийТитул, ТабличныйДокумент, "_2"); 
	УстановитьИдентификаторыСтрок(РезультатВыбора.ТекущийТитул, ТабличныйДокумент, "_3"); 

	ДанныеЗаполнения = Новый Структура;
	ДанныеЗаполнения.Вставить("ТекущийТитул", 		РезультатВыбора.ТекущийТитул);
	ДанныеЗаполнения.Вставить("ТипДокументаЭПД", 	РезультатВыбора.ТипДокументаЭПД);
	ДанныеЗаполнения.Вставить("ВидДокумента", 		ВидДокумента);
	ДанныеЗаполнения.Вставить("ОбъектОснование", 	ПараметрКоманды); 
	
	РезультатВыполненя = Новый Структура;
	РезультатВыполненя.Вставить("Макет", 				ТабличныйДокумент);
	РезультатВыполненя.Вставить("КонтактнаяИнформация", КонтактнаяИнформация);  
	РезультатВыполненя.Вставить("ДанныеЗаполнения", 	ДанныеЗаполнения);  
	
	//Получаем Соответствие реквизитов  
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	|	CW_ОбменГИСЭПДНастройкиЗаполненияЭПД.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.CW_ОбменГИСЭПДНастройкиЗаполненияЭПД КАК CW_ОбменГИСЭПДНастройкиЗаполненияЭПД
	|ГДЕ
	|	CW_ОбменГИСЭПДНастройкиЗаполненияЭПД.ТипДокументаЭПД = &ТипДокументаЭПД
	|	И CW_ОбменГИСЭПДНастройкиЗаполненияЭПД.ТекущийТитул = &ТекущийТитул
	|	И CW_ОбменГИСЭПДНастройкиЗаполненияЭПД.ТипОбъекта = &ТипОбъекта
	|	И CW_ОбменГИСЭПДНастройкиЗаполненияЭПД.ПометкаУдаления = ЛОЖЬ
	|	И CW_ОбменГИСЭПДНастройкиЗаполненияЭПД.Основная = ИСТИНА";
	
	Запрос.УстановитьПараметр("ТипДокументаЭПД", 	РезультатВыбора.ТипДокументаЭПД);
	Запрос.УстановитьПараметр("ТекущийТитул", 		РезультатВыбора.ТекущийТитул);
	Запрос.УстановитьПараметр("ТипОбъекта", 		РезультатВыбора.ТипОбъекта);
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда 
		ПоместитьВоВременноеХранилище(РезультатВыполненя, АдресРезультата); 
		Возврат;
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	Выборка.Следующий();
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ 
	|	CW_ОбменГИСЭПДЗначенияНастроекЗаполненияЭПД.ИмяТабличнойЧасти КАК ИмяТабличнойЧасти,
	|	CW_ОбменГИСЭПДЗначенияНастроекЗаполненияЭПД.ИмяОбласти КАК ИмяОбласти,
	|	CW_ОбменГИСЭПДЗначенияНастроекЗаполненияЭПД.АлгоритмЗаполнения КАК АлгоритмЗаполнения
	|ИЗ
	|	РегистрСведений.CW_ОбменГИСЭПДЗначенияНастроекЗаполненияЭПД КАК CW_ОбменГИСЭПДЗначенияНастроекЗаполненияЭПД
	|ГДЕ
	|	CW_ОбменГИСЭПДЗначенияНастроекЗаполненияЭПД.НастройкаЗаполнения = &НастройкаЗаполнения";  
	
	Запрос.УстановитьПараметр("НастройкаЗаполнения", Выборка.Ссылка);

	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		ПоместитьВоВременноеХранилище(РезультатВыполненя, АдресРезультата); 
		Возврат;
	КонецЕсли;
	
	ЗначенияРеквизитов	= Новый Структура;  

	мОбластиАдресов		= CW_ОбменГИСЭПДСерверВызовСервера.СписокОбластейАдресов(РезультатВыбора.ТекущийТитул);    
	
	ПолнаяТаблицаНастроек = РезультатЗапроса.Выгрузить(); 
	
	Отбор = Новый Структура;
	Отбор.Вставить("ИмяТабличнойЧасти", "");
	ТаблицаНастроек = ПолнаяТаблицаНастроек.НайтиСтроки(Отбор); 
	
	Для Каждого СтрокаТаблицы из ТаблицаНастроек Цикл      
		Если Не ЗначениеЗаполнено(СтрокаТаблицы.АлгоритмЗаполнения) Тогда
			Продолжить;
		Конецесли;   
		
		ИмяОбласти = СтрокаТаблицы.ИмяОбласти; 
		
		ВычисляемаяФункция = ПолучитьВычисляемуюФункциюЯчейки(ПараметрКоманды, РезультатВыбора.ТипОбъекта, СтрокаТаблицы.АлгоритмЗаполнения);
		Если ВычисляемаяФункция = Неопределено Тогда
			Продолжить;
		КонецЕсли;    
		
		Если ВычисляемаяФункция.ВозвращаемоеЗначение = Перечисления.CW_ОбменГИСЭПДВидыРезультатов.ЗначениеРеквизита Тогда
			
			ПараметрыФункции = Новый Структура;
			ПараметрыФункции.Вставить("ВычисляемаяФункция", ВычисляемаяФункция);
			ПараметрыФункции.Вставить("ПараметрКоманды",	ПараметрКоманды);
			ПараметрыФункции.Вставить("ТипОбъекта",			РезультатВыбора.ТипОбъекта); 
			
			ЗначениеЯчейки = ВычислитьЗначениеЯчейки(ПараметрыФункции);
			
			Область = ТабличныйДокумент.Области.Найти(ИмяОбласти);
			Если Область <> Неопределено Тогда 
				
				Если ЗначениеЗаполнено(ЗначениеЯчейки) Тогда
					
					Область.Значение = ЗначениеЯчейки;
					
					ИмяОбластиБезПрефикса = ИмяОбластиБезПрефикса(Область.Имя);
					Если мОбластиАдресов.Найти(ИмяОбластиБезПрефикса) <> Неопределено Тогда 
						
						ИндексСтроки	= ИндексПоказателя(Область.Имя);
						СтрокаСИндексом = СтрокаСИндексомПоказателя(ИндексСтроки);  
						
						Если ТипЗнч(ЗначениеЯчейки) = Тип("Строка") Тогда  
							Если СтрНачинаетсяС(ЗначениеЯчейки, "<КонтактнаяИнформация xmlns") Тогда
								КонтактнаяИнформацияАдреса = ЗначениеЯчейки;
							Иначе
								ПараметрыАдреса = РаботаСАдресами.РазложитьПредставлениеАдресаПоПолям(ЗначениеЯчейки);
								КонтактнаяИнформацияАдреса = ОбменСГИСЭПДВызовСервера.КонтактнаяИнформацияВXML(
									ПараметрыАдреса,
									ЗначениеЯчейки,
									ПредопределенноеЗначение("Перечисление.ТипыКонтактнойИнформации.Адрес"));
							КонецЕсли;
						КонецЕсли;
						
						СтруктураПараметров = Новый Структура("БезПредставлений, ПроверитьАдрес, КодыАдреса", Ложь, Истина, Истина);
						СтруктураАдреса = CW_ОбменГИСЭПДСерверВызовСервера.СведенияОбАдресе(КонтактнаяИнформацияАдреса, СтруктураПараметров);
						
						СтруктураРеквизитовАдреса = ПолучитьРеквизитыАдреса(СтруктураАдреса, ИмяОбластиБезПрефикса, СтрокаСИндексом);
						СтруктураРеквизитовАдреса.Вставить(Область.Имя, СтруктураАдреса.Представление);   
						
						ДанныеАдреса = Новый Структура;
						ДанныеАдреса.Вставить("КонтактнаяИнформация", 		КонтактнаяИнформацияАдреса);
						ДанныеАдреса.Вставить("СтруктураАдреса",			СтруктураАдреса); 
						ДанныеАдреса.Вставить("СтруктураРеквизитовАдреса",	СтруктураРеквизитовАдреса); 
						
						КонтактнаяИнформация.Вставить(Область.Имя, ДанныеАдреса);  
						
						Область.Значение = СтруктураАдреса.Представление;
						
					КонецЕсли;
					
					ЗначенияРеквизитов.Вставить(ИмяОбласти, Область.Значение);  

				КонецЕсли;

			КонецЕсли; 
			
		КонецЕсли;
		
		Если ВычисляемаяФункция.ВозвращаемоеЗначение = Перечисления.CW_ОбменГИСЭПДВидыРезультатов.ТабличнаяЧасть Тогда
			
			ОтборМногострочнаяЧасть = Новый Структура;
			ОтборМногострочнаяЧасть.Вставить("ИмяТабличнойЧасти", ИмяОбласти);
			
			НайденныеСтроки = ПолнаяТаблицаНастроек.НайтиСтроки(ОтборМногострочнаяЧасть);
			Если НайденныеСтроки.Количество() =0 Тогда 
				//Неправильная настройка
				Продолжить;
			КонецЕсли;  
			
			ПараметрыФункции = Новый Структура;
			ПараметрыФункции.Вставить("ВычисляемаяФункция", ВычисляемаяФункция);
			ПараметрыФункции.Вставить("ПараметрКоманды",	ПараметрКоманды);
			ПараметрыФункции.Вставить("ТипОбъекта",			РезультатВыбора.ТипОбъекта); 
			
			МассивСтрок = ПолучитьМассивСтрок(ПараметрыФункции);
			
			Для Индекс = 0 по МассивСтрок.ВГраница() Цикл
				
				Если Индекс > 0 Тогда
					ДобавитьСтроку(РезультатВыбора.ТекущийТитул, ТабличныйДокумент, Индекс, ИмяОбласти, МакетЭПД);  
				КонецЕсли;
				
				НовыйПараметрКоманды = МассивСтрок.Получить(Индекс);
				
				Для каждого СтрокаМногострочнойЧасти из НайденныеСтроки Цикл   
					
					НовыйТипОбъекта = ОбщегоНазначения.ИдентификаторОбъектаМетаданных(ТипЗнч(НовыйПараметрКоманды));
					НомерСтроки 	=  Индекс + 1;
					НоваяВычисляемаяФункция = ПолучитьВычисляемуюФункциюЯчейки(НовыйПараметрКоманды, НовыйТипОбъекта, СтрокаМногострочнойЧасти.АлгоритмЗаполнения, НомерСтроки);
					Если НоваяВычисляемаяФункция = Неопределено Тогда
						Продолжить;
					КонецЕсли;    
					
					НовыеПараметрыФункции = Новый Структура;
					НовыеПараметрыФункции.Вставить("ВычисляемаяФункция", 	НоваяВычисляемаяФункция);
					НовыеПараметрыФункции.Вставить("ПараметрКоманды",		НовыйПараметрКоманды);
					НовыеПараметрыФункции.Вставить("ТипОбъекта",			НовыйТипОбъекта); 
					НовыеПараметрыФункции.Вставить("НомерСтроки",			Индекс+1); 
					
					ЗначениеЯчейки = ВычислитьЗначениеЯчейки(НовыеПараметрыФункции); 
					
					ДопИндекс 		= "";
					НовИндекс 		= СтрокаСИндексомПоказателя(Индекс+1);
					
					ПривОбластьИмя 	= ПривестиИмяОбласти(СтрокаМногострочнойЧасти.ИмяОбласти);
					ЧастиИмени 		= СтрРазделить(ПривОбластьИмя, "_");   
					Если ЧастиИмени.Количество() = 4 Тогда
						ДопИндекс = "_"+ЧастиИмени[2]; 
					КонецЕсли;
					
					ИмяРеквизита 	= ВостановитьПриведенноеИмяРеквизита(ЧастиИмени[1]);
					НовИмяОбласти 	= ЧастиИмени[0]+"_"+ИмяРеквизита+ДопИндекс+ НовИндекс;
					
					Область = ТабличныйДокумент.Области.Найти(НовИмяОбласти);
					Если Область <> Неопределено Тогда
						Если ЗначениеЗаполнено(ЗначениеЯчейки) Тогда
							
							Область.Значение = ЗначениеЯчейки;  
							
							ИмяОбластиБезПрефикса = ИмяОбластиБезПрефикса(Область.Имя);
							Если мОбластиАдресов.Найти(ИмяОбластиБезПрефикса) <> Неопределено Тогда  
								
								ИндексСтроки	= ИндексПоказателя(Область.Имя);
								СтрокаСИндексом = СтрокаСИндексомПоказателя(ИндексСтроки);
								
								Если ТипЗнч(ЗначениеЯчейки) = Тип("Строка") Тогда  
									Если СтрНачинаетсяС(ЗначениеЯчейки, "<КонтактнаяИнформация xmlns") Тогда
										КонтактнаяИнформацияАдреса = ЗначениеЯчейки;
									Иначе
										ПараметрыАдреса = РаботаСАдресами.РазложитьПредставлениеАдресаПоПолям(ЗначениеЯчейки);
										КонтактнаяИнформацияАдреса = ОбменСГИСЭПДВызовСервера.КонтактнаяИнформацияВXML(
										ПараметрыАдреса,
										ЗначениеЯчейки,
										ПредопределенноеЗначение("Перечисление.ТипыКонтактнойИнформации.Адрес"));
									КонецЕсли;
								КонецЕсли;
								
								СтруктураПараметров = Новый Структура("БезПредставлений, ПроверитьАдрес, КодыАдреса", Ложь, Истина, Истина);
								СтруктураАдреса = CW_ОбменГИСЭПДСерверВызовСервера.СведенияОбАдресе(КонтактнаяИнформацияАдреса, СтруктураПараметров);
								
								СтруктураРеквизитовАдреса = ПолучитьРеквизитыАдреса(СтруктураАдреса, ИмяОбластиБезПрефикса, СтрокаСИндексом);
								СтруктураРеквизитовАдреса.Вставить(Область.Имя, СтруктураАдреса.Представление);
								
								ДанныеАдреса = Новый Структура;
								ДанныеАдреса.Вставить("КонтактнаяИнформация", 		КонтактнаяИнформацияАдреса);
								ДанныеАдреса.Вставить("СтруктураАдреса",			СтруктураАдреса); 
								ДанныеАдреса.Вставить("СтруктураРеквизитовАдреса",	СтруктураРеквизитовАдреса); 
								
								КонтактнаяИнформация.Вставить(Область.Имя, ДанныеАдреса);  
								
								Область.Значение = СтруктураАдреса.Представление;
							КонецЕсли; 
							
						КонецЕсли; 
						
					КонецЕсли; 
					
				КонецЦикла; 
				
			КонецЦикла; 
			
		КонецЕсли; 
		
	КонецЦикла;  
	
	Если РезультатВыбора.ТекущийТитул = Перечисления.ТипыЭлементовРегламентаЭДО.ЭЗЗ_Титул1 Тогда
		АдресаПунктовПогрузкиИВыгрузкиНомерПп = ТабличныйДокумент.Область("ТитулГрузоотправителяАдресаПунктовПогрузкиИВыгрузки_НомерПп_1");
		АдресаПунктовПогрузкиИВыгрузкиНомерПп.Значение = 1;  
	КонецЕсли;

	РезультатВыполненя.Вставить("Макет", 				ТабличныйДокумент);
	РезультатВыполненя.Вставить("КонтактнаяИнформация", КонтактнаяИнформация);  
	
	Для Каждого КлючЗначение из ЗначенияРеквизитов Цикл
		Если ТипЗнч(КлючЗначение.Значение) = Тип("СправочникСсылка.Организации") Тогда
			РезультатВыполненя.ДанныеЗаполнения.Вставить("Организация", КлючЗначение.Значение);
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	ПоместитьВоВременноеХранилище(РезультатВыполненя, АдресРезультата);
	
КонецПроцедуры    

Процедура ДобавитьСтроку(ТекущийТитул, ТабличныйДокумент, Знач Индекс, Знач ИмяГруппы, Знач Макет) 
	
	ИнформацияПоПрефиксамТитула = CW_ОбменГИСЭПДПереопределяемый.ПрефиксТитулаПоЭлементуРегламентаЭДО(ТекущийТитул);
	ПрефиксТитула 				= ИнформацияПоПрефиксамТитула.ВПрограмме;  

	ИмяГруппы 			= СтрЗаменить(ИмяГруппы, ПрефиксТитула,""); 
	НомерСтрокиИндекс 	= СтрокаСИндексомПоказателя(Индекс);
	ИмяОбластиПреемника	= "ДобавлениеСтроки" + ИмяГруппы+НомерСтрокиИндекс;
	
	НачИндекс 			= "_1";
	
	ВремТаблДок 		= Макет.ПолучитьОбласть();
	ИскомаяОбластьМнЧ 	= ВремТаблДок.Области.Найти("МногострочнаяЧасть" + ИмяГруппы);
	
	ВремТаблДок 		= ВремТаблДок.ПолучитьОбласть(ИскомаяОбластьМнЧ.Верх, , 
									ИскомаяОбластьМнЧ.Верх + ВысотаМногострочнойЧасти(ИмяГруппы, Макет) - 1, );
	
	ПреИндекс_Число = ИндексПоказателя(ИмяОбластиПреемника);
	ПреИндекс = СтрокаСИндексомПоказателя(ПреИндекс_Число);
	
	НовИндекс_Число = ПреИндекс_Число + 1;
	НовИндекс = СтрокаСИндексомПоказателя(НовИндекс_Число);
	
	НачПостфикс = ИмяГруппы + НачИндекс;
	ПреПостфикс = ИмяГруппы + ПреИндекс;
	НовПостфикс = ИмяГруппы + НовИндекс;  

	МассивИменОбластей = ПолучитьМассивИменОбластейМногострочнойЧасти(ВремТаблДок);
	Для каждого ОбластьИмя Из МассивИменОбластей Цикл
		
		НачИмяОбл = ОбластьИмя + НачИндекс;
		НовИмяОбл = ОбластьИмя + НовИндекс;
	            
		ОбластьЯчейки = ВремТаблДок.Области[НачИмяОбл];
		ОбластьЯчейки.Имя = НовИмяОбл;
		
		Если ОбластьЯчейки.СодержитЗначение = Истина Тогда
			ОбластьЯчейки.Очистить();
		КонецЕсли; 
		
		Если ОбластьИмя = "ТитулГрузоотправителяАдресаПунктовПогрузкиИВыгрузки_НомерПп" Тогда
			ОбластьЯчейки.Значение = Строка(НовИндекс_Число);	
		КонецЕсли;
		
	КонецЦикла;
	
	УстановитьИдентификаторыСтрок(ТекущийТитул, ВремТаблДок, НовИндекс); 
	
	Обл = ВремТаблДок.Область("УдалитьСтроку" + НачПостфикс);
	Обл.Имя = "УдалитьСтроку" + НовПостфикс;
	
	Обл = ВремТаблДок.Область("УдалитьСтроку" + НовПостфикс);
	Обл.Гиперссылка = Истина;
	Обл.Текст = "х";
	Если НовИндекс_Число = 2 Тогда
		Обл = ТабличныйДокумент.Области.Найти("УдалитьСтроку" + ПреПостфикс);
		Обл.Гиперссылка = Истина;
		Обл.Текст = "х";
	КонецЕсли; 
	
	Обл = ТабличныйДокумент.Области.Найти("ДобавитьСтроку" + ПреПостфикс);
	Обл.Имя = "ДобавитьСтроку" + НовПостфикс;   
	
	Обл = ТабличныйДокумент.Области.Найти("ДобавитьСтрокуЗначок" + ПреПостфикс);
	Обл.Имя = "ДобавитьСтрокуЗначок" + НовПостфикс;
	
	ОблПреемник = ТабличныйДокумент.Области.Найти(ИмяОбластиПреемника);  
	ОблПреемник.Имя = "ДобавлениеСтроки" + НовПостфикс;
	
	ВремТаблДок.Область("МногострочнаяЧасть" + ИмяГруппы).Имя = "";
	
	ВставляемаяОбласть = ВремТаблДок.Область(1, , ВремТаблДок.ВысотаТаблицы, ); 
	
	ТабличныйДокумент.ВставитьОбласть(ВставляемаяОбласть, ОблПреемник, ТипСмещенияТабличногоДокумента.ПоВертикали);
	
КонецПроцедуры  

Функция ПолучитьДополнительныеИндексыОбластейТитула() Экспорт
	
	ДопИндексы = Новый Соответствие;
	ДопИндексы.Вставить(Перечисления.ТипыЭлементовРегламентаЭДО.ЭЗЗ_Титул1,	 "_2;_1_1;_2_1"); 
	ДопИндексы.Вставить(Перечисления.ТипыЭлементовРегламентаЭДО.ЭЗЗ_Титул2,	 "_2;_3;_1_1;_2_1;_3_1;"); 
	ДопИндексы.Вставить(Перечисления.ТипыЭлементовРегламентаЭДО.ЭТрН_Титул1, "_2;_3"); 
	ДопИндексы.Вставить(Перечисления.ТипыЭлементовРегламентаЭДО.ЭПЛ_Титул1,	 "_2;_3"); 
	ДопИндексы.Вставить(Перечисления.ТипыЭлементовРегламентаЭДО.ЭПЛ_Титул3,	 "_2;_3"); 
	ДопИндексы.Вставить(Перечисления.ТипыЭлементовРегламентаЭДО.ЭПЛ_Титул3,	 "_2;_3");

	Возврат ДопИндексы;  
	
КонецФункции

Функция ПолучитьРеквизитыАдреса(СтруктураАдреса, ИмяЭлемента, ИндексСтроки="") 
	
	Префикс = СтрЗаменить(ИмяЭлемента, "Представление", "");
	
	СтруктураДанныеАдреса = Новый Структура;   
	
	Если СтруктураАдреса.ТипАдреса = "ВСвободнойФорме"
		Или ЗначениеЗаполнено(СтруктураАдреса.Территория) Тогда
		СтруктураДанныеАдреса.Вставить(Префикс + "Представление" + ИндексСтроки, СтруктураАдреса.Представление);
		СтруктураДанныеАдреса.Вставить(Префикс + "КодСтраны"  + ИндексСтроки, СтруктураАдреса.КодСтраны);	
	Иначе	
		СтруктураДанныеАдреса.Вставить(Префикс + "Индекс" + ИндексСтроки, СтруктураАдреса.Индекс);
		СтруктураДанныеАдреса.Вставить(Префикс + "КодРегиона" + ИндексСтроки, СтруктураАдреса.КодРегиона);
		СтруктураДанныеАдреса.Вставить(Префикс + "Город" + ИндексСтроки, СтруктураАдреса.Город + ?(СтруктураАдреса.ГородТипКраткий = "", "", " ") + СтруктураАдреса.ГородТипКраткий);
		СтруктураДанныеАдреса.Вставить(Префикс + "Район" + ИндексСтроки, СтруктураАдреса.Район + ?(СтруктураАдреса.РайонТипКраткий = "", "", " ") + СтруктураАдреса.РайонТипКраткий);
		СтруктураДанныеАдреса.Вставить(Префикс + "НаселенныйПункт" + ИндексСтроки, СтруктураАдреса.НаселенныйПункт + ?(СтруктураАдреса.НаселенныйПунктТипКраткий = "", "", " ") + СтруктураАдреса.НаселенныйПунктТипКраткий);
		СтруктураДанныеАдреса.Вставить(Префикс + "Улица" + ИндексСтроки, СтруктураАдреса.Улица + ?(СтруктураАдреса.УлицаТипКраткий = "", "", " ") + СтруктураАдреса.УлицаТипКраткий);
		СтруктураДанныеАдреса.Вставить(Префикс + "Дом" + ИндексСтроки, СтруктураАдреса.Здание.Номер);
		Если СтруктураАдреса.Корпуса.Количество() > 0 Тогда
			СтруктураДанныеАдреса.Вставить(Префикс + "Корпус" + ИндексСтроки, СтруктураАдреса.Корпуса[0].Номер);
		КонецЕсли;	
	КонецЕсли;    
	
	Возврат СтруктураДанныеАдреса;
	
КонецФункции

Процедура УстановитьИдентификаторыСтрок(ТекущийТитул, ОбластьПоиска, Знач ТекущийИндекс, 
	Знач ОбластьПоискаРодителя=Неопределено, Знач ИндексСтрокиРодителя="") Экспорт
	
	ИменаОблатейРодителей 	= СоответствиеИменаОбластейРодителей(ТекущийТитул); 
	ОбластьПоискаРодителя 	= ?(ОбластьПоискаРодителя=Неопределено, ОбластьПоиска, ОбластьПоискаРодителя);
	ИндексСтрокиРодителя 	= ?(ПустаяСтрока(ИндексСтрокиРодителя), ТекущийИндекс, ИндексСтрокиРодителя);
	
	МассивИменОбластейБезПрефиксов = ПолучитьМассивИменОбластейМногострочнойЧасти(ОбластьПоиска); 
	
	ИдентификаторыОбластейРодителей = Новый Соответствие;
	
	//Сначала установим идентифкаторы первичных строк   
	Для каждого ИмяОбластиБезПрефикса Из МассивИменОбластейБезПрефиксов Цикл
		
		ЧастиИмени = СтрРазделить(ИмяОбластиБезПрефикса, "_"); 
		Если ЧастиИмени.Найти("ИдентификаторСтроки") = Неопределено Тогда
			Продолжить;	
		КонецЕсли;
		
		ИдентификаторОбласти = Строка(Новый УникальныйИдентификатор);
		
		Область = ОбластьПоиска.Области.Найти(ИмяОбластиБезПрефикса+ТекущийИндекс); 
		Если Область <> Неопределено Тогда
			Область.Значение = ИдентификаторОбласти;     
			ИдентификаторыОбластейРодителей.Вставить(ИмяОбластиБезПрефикса+ТекущийИндекс, ИдентификаторОбласти);
		КонецЕсли;
	КонецЦикла;
	
	//Установим удентификаторы областей родителей 
	Для каждого ИмяОбластиБезПрефикса Из МассивИменОбластейБезПрефиксов Цикл 
		
		ЧастиИмени = СтрРазделить(ИмяОбластиБезПрефикса, "_"); 
		Если ЧастиИмени.Найти("ИдентификаторСтрокиРодителя") = Неопределено Тогда
			Продолжить;	
		КонецЕсли;
		
		ИмяОбластиРодителя = ИменаОблатейРодителей.Получить(ИмяОбластиБезПрефикса); 
		Если ИмяОбластиРодителя <> Неопределено Тогда 
			ИдентификаторОбластиРодителя = ИдентификаторыОбластейРодителей.Получить(ИмяОбластиРодителя+ИндексСтрокиРодителя);
			Если ИдентификаторОбластиРодителя <> Неопределено Тогда
				Область = ОбластьПоиска.Области.Найти(ИмяОбластиБезПрефикса+ТекущийИндекс); 
				Если Область <> Неопределено Тогда
					Область.Значение = ИдентификаторОбластиРодителя;
				КонецЕсли;                                   
			КонецЕсли;                                   
		КонецЕсли; 
		
	КонецЦикла;  

КонецПроцедуры 

Функция СоответствиеИменаОбластейРодителей(ТекущийТитул)
	
	Соответствие = Новый Соответствие;
  	Если ТекущийТитул = Перечисления.ТипыЭлементовРегламентаЭДО.ЭЗЗ_Титул1 Тогда
		Соответствие.Вставить("ТитулГрузоотправителяРеквизитыСторонПодтвержденияПолномочий_ИдентификаторСтрокиРодителя_1", 					
			"ТитулГрузоотправителяУполномоченныеЛица_ИдентификаторСтроки");     
		
		Соответствие.Вставить("ТитулГрузоотправителяРеквизитыСторонПодтвержденияПолномочий_ИдентификаторСтрокиРодителя_2", 					
			"ТитулГрузоотправителяУполномоченныеЛица_ИдентификаторСтроки");     
		
		Соответствие.Вставить("ТитулГрузоотправителяГрузыПунктыПогрузкиВыгрузки_ИдентификаторСтрокиРодителя",
			"ТитулГрузоотправителяГрузы_ИдентификаторСтроки"); 
		
		Соответствие.Вставить("ТитулГрузоотправителяСтороныДоговораНаВыполнениеУслуг_ИдентификаторСтрокиРодителя_1", 					
			"ТитулГрузоотправителяГрузы_ИдентификаторСтроки");        
		Соответствие.Вставить("ТитулГрузоотправителяСтороныДоговораНаВыполнениеУслуг_ИдентификаторСтрокиРодителя_2", 					
			"ТитулГрузоотправителяГрузы_ИдентификаторСтроки");        
		
	КонецЕсли;  
		
	Если ТекущийТитул = Перечисления.ТипыЭлементовРегламентаЭДО.ЭЗЗ_Титул2 Тогда 
		Соответствие.Вставить("ТитулПеревозчикаВодительНомераТелефонов_ИдентификаторСтрокиРодителя", 					
			"ТитулПеревозчикаВодители_ИдентификаторСтроки"); 
		
		Соответствие.Вставить("ТитулПеревозчикаОснованиеВладенияТСРеквизитыСторон_ИдентификаторСтрокиРодителя",
			"ТитулПеревозчикаОснованиеВладенияТСРеквизитыСторон_ИдентификаторСтроки"); 
		
		Соответствие.Вставить("ТитулПеревозчикаОснованияВладенияПрицепом_ИдентификаторСтрокиРодителя", 					
			"ТитулПеревозчикаПрицепы_ИдентификаторСтроки");
		
 		Соответствие.Вставить("ТитулПеревозчикаОснованияВладенияПрицепомРеквизитыСторон_ИдентификаторСтрокиРодителя",	
			"ТитулПеревозчикаОснованияВладенияПрицепомРеквизитыСторон_ИдентификаторСтроки"); 
	КонецЕсли;  
	
	Если ТекущийТитул = Перечисления.ТипыЭлементовРегламентаЭДО.ЭТрН_Титул1 Тогда 
		Соответствие.Вставить("ТитулГрузоотправителяПереченьМаркировокГруза_ИдентификаторСтрокиРодителя", 					
			"ТитулГрузоотправителяГрузы_ИдентификаторСтроки");
		
		Соответствие.Вставить("ТитулГрузоотправителяИдентификационныеНомераУчетныхЕдиниц_ИдентификаторСтрокиРодителя",
			"ТитулГрузоотправителяГрузы_ИдентификаторСтроки");
		
		Соответствие.Вставить("ТитулГрузоотправителяСведенияОбОпасныхГрузах_ИдентификаторСтрокиРодителя", 					
			"ТитулГрузоотправителяГрузы_ИдентификаторСтроки");
		
		Соответствие.Вставить("ТитулГрузоотправителяСведенияОКонтейнерах_ИдентификаторСтрокиРодителя",	
			"ТитулГрузоотправителяГрузы_ИдентификаторСтроки");  
		
		Соответствие.Вставить("ТитулГрузоотправителяИдентификационныеНомераКонтейнеров_ИдентификаторСтрокиРодителя",	
			"ТитулГрузоотправителяСведенияОКонтейнерах_ИдентификаторСтроки");
		
