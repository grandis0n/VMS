Функция ПроверитьИспользованиеСервиса(ЗапросСервера = Ложь) Экспорт
	
	Используется = Константы.CW_ОбменГИСЭПДИспользуется.Получить(); 
	Если Не Используется Тогда
		Возврат Ложь;
	КонецЕсли; 
	
	РегистрационныйНомер = CW_ПроверкаЛицензии.ПолучитьРегистрационныйНомер();
	Результат = CW_БухгалтерияЭкспедитораСервер.ПроверитьНаличиеПодписки(РегистрационныйНомер, "AF");  
	Если Результат.КодСостояния <> 200 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	КонтрольноеСвойство	 = ПолучитьКонтрольноеСвойство();
	ОбязательныеСвойства = ПолучитьМассивСвойств();
	
	ХранилищеНастроек 			= Константы.CW_ОбменГИСЭПДДополнительныеНастройки.Получить(); 
	ФиксированноеСоответствие	= ХранилищеНастроек.Получить();  
	Если ФиксированноеСоответствие = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Соответствие = Новый Соответствие(ФиксированноеСоответствие); 
	
	Если Используется Тогда
		Для Каждого Свойство из ОбязательныеСвойства Цикл
			ЗначениеСвойства = Соответствие.Получить(Свойство);   
			Если ЗначениеСвойства = Неопределено Тогда
				Возврат Ложь;
			КонеЦесли;
		КонецЦикла;            
	КонецЕсли;
	
	Ключ = Соответствие.Получить(КонтрольноеСвойство);
	СтруктураJSON = РасшифроватьКлюч(Ключ);
	
	ОбновитьКлюч = Ложь;
	Если XMLЗначение(Тип("Дата"), СтруктураJSON.datereceipt) < НачалоДня(ТекущаяДата()) Тогда
		//Проверяем один раз в день
		Результат = ПолучитьСведенияОСервисе();  
		Если Результат <> Неопределено Тогда
			ОбновитьКлюч = Истина;  
			СтруктураJSON = РасшифроватьКлюч(Результат.key);
		КонецЕсли;
	КонецЕсли;
	
	//Проверяем стуктуру ключа
	Если XMLЗначение(Тип("Строка"), СтруктураJSON.regnumber) <> РегистрационныйНомер Тогда
		Возврат Ложь;
	КонецЕсли;
	Если XMLЗначение(Тип("Дата"), СтруктураJSON.enddate) < НачалоДня(XMLЗначение(Тип("Дата"), СтруктураJSON.datereceipt)) Тогда
		Возврат Ложь;
	КонецЕсли; 
	Если XMLЗначение(Тип("Булево"), СтруктураJSON.use) <> Истина Тогда
		Возврат Ложь;
	КонецЕсли; 
	
	УстановитьПривилегированныйРежим(Истина);
	Если ОбновитьКлюч Тогда
		СтрокаBase64 = ЗашифроватьНовыйКлюч(СтруктураJSON);
		Соответствие.Вставить(КонтрольноеСвойство, СтрокаBase64);  
		
		ФиксированноеСоответствие	= Новый ФиксированноеСоответствие(Соответствие); 
		Константы.CW_ОбменГИСЭПДДополнительныеНастройки.Установить(Новый ХранилищеЗначения(ФиксированноеСоответствие)); 
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

Функция ПолучитьСведенияОСервисе()
	
	РегистрационныйНомер = CW_ПроверкаЛицензии.ПолучитьРегистрационныйНомер();
	Если ПустаяСтрока(РегистрационныйНомер) Тогда 
		Возврат Неопределено
	КонецЕсли;
	
	КонтрольноеСвойство = ПолучитьКонтрольноеСвойство();
	
	СтруктураJSON = Новый Структура;
	СтруктураJSON.Вставить("regnumber",		XMLСтрока(РегистрационныйНомер));
	СтруктураJSON.Вставить("service",		"ESD");
	
	ПараметрыHTTPЗапроса = CW_РаботаСВнешнимиРесурсамиСервер.ПодготовитьHTTPЗапрос("esd_used", СтруктураJSON);
	
	Ответ = CW_РаботаСВнешнимиРесурсамиСервер.ПолучитьДанныеССервера(ПараметрыHTTPЗапроса.HTTPСоединение, ПараметрыHTTPЗапроса.HTTPЗапрос, "GET");   
	
	Если Ответ = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если Ответ.КодСостояния = 200 Тогда    
		СтрокаJSON = Ответ.ПолучитьТелоКакСтроку();
		
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(СтрокаJSON);  
		
		СтруктураJSON = ПрочитатьJSON(ЧтениеJSON);
		ЧтениеJSON.Закрыть();  
		
		Возврат СтруктураJSON;
	КонецЕсли; 
	
	Возврат Неопределено;
	
КонецФункции

Функция ЗавершитьПодклчюениеПодписки(ПараметрыПроцедуры) Экспорт
	
	СтруктураОтвет = Новый Структура;
	СтруктураОтвет.Вставить("Успешно", Ложь);
	
	КонтрольноеСвойство = ПолучитьКонтрольноеСвойство();
	
	СтруктураJSON = Новый Структура;
	СтруктураJSON.Вставить("regnumber",	XMLСтрока(ПараметрыПроцедуры.РегистрационныйНомер));
	СтруктураJSON.Вставить("service",	"ESD");
	
	ПараметрыHTTPЗапроса = CW_РаботаСВнешнимиРесурсамиСервер.ПодготовитьHTTPЗапрос("esd_activation", СтруктураJSON);
	
	Ответ = CW_РаботаСВнешнимиРесурсамиСервер.ПолучитьДанныеССервера(ПараметрыHTTPЗапроса.HTTPСоединение, ПараметрыHTTPЗапроса.HTTPЗапрос, "POST");   
	
	Если Ответ = Неопределено Тогда
		
		СтруктураОтвет.Вставить("Сообщение", 	"Отсутствует интернет-соединение!");
		
	Иначе
		
		СтруктураОтвет.Вставить("Успешно",	Ответ.КодСостояния = 200);
		
		Если Ответ.КодСостояния = 200 Тогда   
			
			СтрокаJSON = Ответ.ПолучитьТелоКакСтроку();
			
			ЧтениеJSON = Новый ЧтениеJSON;
			ЧтениеJSON.УстановитьСтроку(СтрокаJSON);  
			
			СтруктураJSON = ПрочитатьJSON(ЧтениеJSON);
			ЧтениеJSON.Закрыть();     
			
			ЗаписатьКлюч(СтруктураJSON.key);
			Константы.CW_ОбменГИСЭПДИспользуется.Установить(Истина);
			
		Иначе  
			
			Сообщение = Ответ.ПолучитьТелокакСтроку();
			Если ПустаяСтрока(Сообщение) Тогда
				ОписаниеКодовСостояний 	= CW_ОбщийМодульЛичныйКабинетКлиентСервер.ПолучитьОписаниеКодовСостояний();	
				Сообщение = "Код ошибки: "+ Ответ.КодСостояния +" - "+ ОписаниеКодовСостояний.Получить(Ответ.КодСостояния); 
			КонецЕсли; 
			
		КонецЕсли; 
		
		СтруктураОтвет.Вставить("Сообщение", Сообщение);
		
	КонецЕсли;    
	
	Возврат СтруктураОтвет;
	
КонецФункции   

