Процедура ЗаписатьКлюч(Знач Ключ)
	
	КонтрольноеСвойство = ПолучитьКонтрольноеСвойство();
	
	МассивСвойств 	= ПолучитьМассивСвойств();
	
	Соответствие = Новый Соответствие;
	Соответствие.Вставить(КонтрольноеСвойство, Ключ);  
	
	Для Индекс = 0 По МассивСвойств.ВГраница() Цикл   
		
		ПотокВПамяти 	  = Новый ПотокВПамяти;  
		ТекстовыйДокумент = Новый ТекстовыйДокумент;
		ТекстовыйДокумент.УстановитьТекст(Сред(Ключ, Индекс+1));  
		ТекстовыйДокумент.Записать(ПотокВПамяти);
		ДвоичныеДанные 	= ПотокВПамяти.ЗакрытьИПолучитьДвоичныеДанные();
		
		Свойсттво 			= МассивСвойств.Получить(Индекс);
		ЗначениеСвойства 	= Base64Строка(ДвоичныеДанные);
		Соответствие.Вставить(Свойсттво, ЗначениеСвойства);  
	КонецЦикла;
	
	ФиксированноеСоответствие = Новый ФиксированноеСоответствие(Соответствие); 
	
	Константы.CW_ОбменГИСЭПДДополнительныеНастройки.Установить(Новый ХранилищеЗначения(ФиксированноеСоответствие));
	
КонецПроцедуры

Функция РасшифроватьКлюч(Знач Ключ)
	
	ДвоичныеДанные 		= Base64Значение(Ключ);  
	ПотокВПамяти 		= ДвоичныеДанные.ОткрытьПотокДляЧтения();
	ТекстовыйДокумент 	= Новый ТекстовыйДокумент;
	ТекстовыйДокумент.Прочитать(ПотокВПамяти);
	
	СтрокаJSON = ТекстовыйДокумент.ПолучитьТекст();
	
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(СтрокаJSON);  
	
	//СтруктураJSON: regnumber, service,id,enddate,use,datereceipt
	СтруктураJSON = ПрочитатьJSON(ЧтениеJSON); 
	ЧтениеJSON.Закрыть();  
	
	Возврат СтруктураJSON;
	
КонецФункции 

Функция ЗашифроватьНовыйКлюч(Знач СтруктураJSON)
	
	ПараметрыЗаписиJSON = Новый ПараметрыЗаписиJSON(,Символы.Таб);	  
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.ПроверятьСтруктуру = Ложь;
	ЗаписьJSON.УстановитьСтроку(ПараметрыЗаписиJSON);
	
	ЗаписатьJSON(ЗаписьJSON, СтруктураJSON);
	
	СтрокаJSON = ЗаписьJSON.Закрыть(); 
	
	ТекстовыйДокумент = Новый ТекстовыйДокумент;
	ТекстовыйДокумент.УстановитьТекст(СтрокаJSON);    
	
	ПотокВПамяти = Новый ПотокВПамяти;
	ТекстовыйДокумент.Записать(ПотокВПамяти);
	
	ДвоичныеДанные 	= ПотокВПамяти.ЗакрытьИПолучитьДвоичныеДанные();
	СтрокаBase64 	= Base64Строка(ДвоичныеДанные);
	
	Возврат СтрокаBase64;
	
КонецФункции

