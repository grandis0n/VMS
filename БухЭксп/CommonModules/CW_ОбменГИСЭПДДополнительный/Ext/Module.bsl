	//ЭТрН_Макеты_Настройки.Вставить(ТипыЭлементовРегламентаЭДО.ЭТрН_Титул2, "Настройки_ЭТрН_Титул2");   
	//ЭТрН_Макеты_Настройки.Вставить(ТипыЭлементовРегламентаЭДО.ЭТрН_Титул3, "Настройки_ЭТрН_Титул3");
