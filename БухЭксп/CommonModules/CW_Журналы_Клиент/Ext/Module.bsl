&НаКлиенте
Функция СохранитьНастройку_Диалог(УФ,ПроцедураОбратногоВызова)
	
	ПОВ = Новый ОписаниеОповещения("ОбработкаСохраненияНастроек",ЭтотОбъект,Новый Структура("ПОВ",ПроцедураОбратногоВызова));
	Если (ЭтоФормаЖурналаГрузоперевозок(УФ) ИЛИ ЭтоФормаЗаказа(УФ) ИЛИ ЭтоФормаЗаявки(УФ)) Тогда
		КлючОбъекта = "ОбработкаОбъект.CW_ЖурналГрузоперевозок";
	ИначеЕсли (ЭтоФормаЖурналаЗаявок(УФ)) Тогда 
		КлючОбъекта = "ОбработкаОбъект.CW_ЖурналЗаявок";
	ИначеЕсли (ЭтоФормаЖурналаЗаказов(УФ)) Тогда 
		КлючОбъекта = "ОбработкаОбъект.CW_ЖурналЗаказов";
	КонецЕсли; 
	ПараметрыФормы = Новый Структура("КлючОбъекта,РежимОткрытия,РежимВыбора,ИмяФормыВладельца",КлючОбъекта,"Сохранение",Истина,УФ.ИмяФормы);
	ОткрытьФорму("Справочник.CW_НастройкиПользователей.Форма.ФормаУправленияНастройками", ПараметрыФормы,,,,,ПОВ,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
