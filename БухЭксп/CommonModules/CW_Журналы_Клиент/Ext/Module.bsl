&НаКлиенте
Функция УдалитьДинамическийПараметр(УФ,ПроцедураОбратногоВызова)
	// --- 
	
	ПОВ = Новый ОписаниеОповещения("ОбработкаУдаленияДинамическогоПараметра",ЭтотОбъект,Новый Структура("УФ,ПОВ",УФ,ПроцедураОбратногоВызова));
	ПФ = Новый Структура("Отбор",Новый Структура("ДинамическийПараметр",Истина));
	ОткрытьФорму("ПланВидовХарактеристик.CW_ПараметрыГрузоперевозок.ФормаВыбора",ПФ,,,,,ПОВ,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
	// --- 
КонецФункции

&НаКлиенте
Процедура ОбработкаУдаленияДинамическогоПараметра(Ответ, ДополнительныеПараметры) Экспорт
	// --- 
	
	Если (Ответ <> Неопределено) Тогда
		
		МассивВыбранных = Новый Массив;
		Для каждого Стр Из ДополнительныеПараметры.УФ.Элементы.Журнал.ВыделенныеСтроки Цикл
			
			МассивВыбранных.Добавить(ДополнительныеПараметры.УФ.Журнал_Данные.НайтиПоИдентификатору(Стр).ссылка);
			
		КонецЦикла; 
		ВыполнитьОбработкуОповещения(ДополнительныеПараметры.ПОВ,_УФКС.СД("Журналы","сервер","/УдалитьДинамическийПараметр",Новый Структура("Параметр,Грузоперевозки",Ответ,МассивВыбранных)));
		
	КонецЕсли; 
	
	// --- 
КонецПроцедуры
  

#КонецОбласти 