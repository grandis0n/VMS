&НаКлиенте
Функция УстановитьОтборПоСтатусам(УФ, ПроцедураОбратногоВызова)
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("УФ", 	УФ);
	ДополнительныеПараметры.Вставить("ПОВ", ПроцедураОбратногоВызова);
	
	Оповещение = Новый ОписаниеОповещения("ОбработкаИзменениеОтбораПоСтатусам",ЭтотОбъект,ДополнительныеПараметры);
	
	АдресНастроекОтбора = ПоместитьВоВременноеХранилище(УФ.Журнал_СтруктураНастроек["ОтборПоСтатусам"]);
	ВыводитьАрхивные 	= ?(ЭтоФормаЗаказа(УФ) ИЛИ ЭтоФормаЗаявки(УФ),Истина,УФ.ВыводитьАрхивные);
	
	ПараметрыФормыОтбора = Новый Структура;
	ПараметрыФормыОтбора.Вставить("АдресНастроекОтбора", АдресНастроекОтбора);
	ПараметрыФормыОтбора.Вставить("ВыводитьАрхивные",	 ВыводитьАрхивные);
	ПараметрыФормыОтбора.Вставить("ИмяФормыИсточника",	 УФ.ИмяФормы);

	ОткрытьФорму("ОбщаяФорма.CW_ФормаОтбораПоСтатусам",ПараметрыФормыОтбора,УФ,,,,Оповещение,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецФункции

&НаКлиенте
Процедура ОбработкаИзменениеОтбораПоСтатусам(Ответ, ДополнительныеПараметры) Экспорт 

	Если (Ответ <> Неопределено) Тогда
		
		ДополнительныеПараметры.УФ.Журнал_СтруктураНастроек["ОтборПоСтатусам"] = Ответ.Список;
		//Если (НЕ ЭтоФормаЗаказа(ДополнительныеПараметры.УФ) И НЕ ЭтоФормаЗаявки(ДополнительныеПараметры.УФ)) Тогда
		//	ДополнительныеПараметры.УФ.ВыводитьАрхивные = Ответ.ВыводитьАрхивные;
		//КонецЕсли; 
		ДополнительныеПараметры.УФ.Журнал_ТекущаяНастройка = Неопределено;
		Если (ЭтоФормаЖурналаГрузоперевозок(ДополнительныеПараметры.УФ)) Тогда
			ДополнительныеПараметры.УФ.Журнал_НастройкаИзменена = Истина;
		КонецЕсли; 
		Если (НЕ ДополнительныеПараметры.УФ.Журнал_РежимНастройки) Тогда
			ВыполнитьОбработкуОповещения(ДополнительныеПараметры.ПОВ,_УФКС.СД("Журналы","сервер","/УстановитьОтборПоСтатусам"));
		КонецЕсли; 
		
	КонецЕсли; 
КонецПроцедуры

