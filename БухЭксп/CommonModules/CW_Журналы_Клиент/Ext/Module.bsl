		Если (НЕ ДополнительныеПараметры.УФ.Журнал_РежимНастройки) Тогда
			ВыполнитьОбработкуОповещения(ДополнительныеПараметры.ПОВ,_УФКС.СД("Журналы","сервер","/УстановитьОтборПоФинансовымСтатусам"));
		КонецЕсли; 
		
	КонецЕсли; 
	
КонецПроцедуры


#КонецОбласти 

&НаКлиенте
Функция СортировкаКолонки_ОпределитьНужныйПорядокПоНажатию(УФ, ПорядокНажатый)
	
	Если ПорядокНажатый = "Возр" Тогда
		
		Если УФ.Элементы.ЖурналСортироватьПоВозрастанию.Пометка Тогда
			УФ.Элементы.ЖурналСортироватьПоВозрастанию.Пометка=Ложь;
			Возврат(_УФКС.СД("Журналы","сервер","/СортировкаКолонки","Нет"));
		Иначе
			УФ.Элементы.ЖурналСортироватьПоВозрастанию.Пометка=Истина;
			УФ.Элементы.ЖурналСортироватьПоУбыванию.Пометка=Ложь;
			Возврат(_УФКС.СД("Журналы","сервер","/СортировкаКолонки","Возр"));
		КонецЕсли;
		
	ИначеЕсли ПорядокНажатый = "Убыв" Тогда
		
		Если УФ.Элементы.ЖурналСортироватьПоУбыванию.Пометка Тогда
			УФ.Элементы.ЖурналСортироватьПоУбыванию.Пометка=Ложь;
			Возврат(_УФКС.СД("Журналы","сервер","/СортировкаКолонки","Нет"));
		Иначе
			УФ.Элементы.ЖурналСортироватьПоУбыванию.Пометка=Истина;
			УФ.Элементы.ЖурналСортироватьПоВозрастанию.Пометка=Ложь;
			Возврат(_УФКС.СД("Журналы","сервер","/СортировкаКолонки","Убыв"));
		КонецЕсли;
		
	КонецЕсли; 
	
КонецФункции

#Область ОтборПоПериоду


&НаКлиенте
Функция ОтборПоПериодуДиалог(УФ,Параметры, ПроцедураОбратногоВызова)
	// --- 
	
	// пытаемся найти границы периода в текущем отборе
	
	// определяем поле компоновки данных
	ИмяКолонки = СтрЗаменить(УФ.Элементы.Журнал.ТекущийЭлемент.Имя, "Журнал_", "");
	Строки = УФ.Журнал_ОписаниеКолонок.НайтиСтроки(Новый Структура("Имя",ИмяКолонки));
	СтрокаКолонки = Строки[0];
	СтрокаПоляКомпоновки = СтрокаКолонки.СтрокаПоляКомпоновки;
	
	// анализируем свойства колонки
	ТребуетсяУточнениеОтбора = Ложь;
	Если (СтрокаКолонки.КонтрольнаяДатаГрузоперевозки И НЕ СтрокаКолонки.КонтрольнаяДатаПлан И НЕ СтрокаКолонки.КонтрольнаяДатаФакт) Тогда
		
		ТребуетсяУточнениеОтбора = Истина; 
		
	КонецЕсли; 
	// --- 
	Если (ТребуетсяУточнениеОтбора) Тогда
		
		ПОВ = Новый ОписаниеОповещения("ОбработкаУточненияВариантаОтбора",ЭтотОбъект, Новый Структура("УФ,СтрокаПоляКомпоновки,ПроцедураОбратногоВызова",УФ,СтрокаПоляКомпоновки,ПроцедураОбратногоВызова)); 
		СписокВыбора = Новый СписокЗначений;
		СписокВыбора.Добавить(1,"Фактическое значение");
		СписокВыбора.Добавить(2,"Плановое значение");
		СписокВыбора.Добавить(3,"Любое значение");
		СписокВыбора.ПоказатьВыборЭлемента(ПОВ,"Выберите вариант отбора");
		
	Иначе
		
		ПоказатьДиалогВыбораПериода(УФ,СтрокаПоляКомпоновки,ПроцедураОбратногоВызова);
		
	КонецЕсли; 
	
	// --- 
		
	// --- 
КонецФункции

&НаКлиенте
Процедура ОбработкаУточненияВариантаОтбора(Ответ, ДополнительныеПараметры) Экспорт 
	// --- 
	
	Если (Ответ <> Неопределено) Тогда
		
		Если (Ответ.Значение = 1 ИЛИ Ответ.Значение = 2) Тогда
			
			// дорабатываем поле компоновки
			СтрокаПоляКомпоновки = ДополнительныеПараметры.СтрокаПоляКомпоновки;
			СтрокаПоляКомпоновки = СтрЗаменить(СтрокаПоляКомпоновки,"]","");
			Если (Ответ.Значение = 1) Тогда
				СтрокаПоляКомпоновки = СтрокаПоляКомпоновки + "_ЗначениеФакт";
			Иначе
				СтрокаПоляКомпоновки = СтрокаПоляКомпоновки + "_ЗначениеПлан";
			КонецЕсли; 
			СтрокаПоляКомпоновки = СтрокаПоляКомпоновки + "]";
			// --- 
			ПоказатьДиалогВыбораПериода(ДополнительныеПараметры.УФ,СтрокаПоляКомпоновки,ДополнительныеПараметры.ПроцедураОбратногоВызова);
			
		Иначе
			
			ПоказатьДиалогВыбораПериода(ДополнительныеПараметры.УФ,ДополнительныеПараметры.СтрокаПоляКомпоновки,ДополнительныеПараметры.ПроцедураОбратногоВызова);
			
		КонецЕсли; 
		
	КонецЕсли; 
	
	// --- 
КонецПроцедуры
  

&НаКлиенте
Процедура ПоказатьДиалогВыбораПериода(УФ,СтрокаПоляКомпоновкиДанных,ПроцедураОбратногоВызова)
	// --- 
	
	НачалоПериода = Дата(1,1,1);
	ИдентификаторСтрокиНачалаПериода = Неопределено;
	КонецПериода =  Дата(1,1,1);
	ИдентификаторСтрокиКонцаПериода = Неопределено;

	ПолеКомпоновки = Новый ПолеКомпоновкиДанных(СтрокаПоляКомпоновкиДанных);
	ПравоеЗначение = СтрЗаменить(СтрокаПоляКомпоновкиДанных,"_ЗначениеПлан","");
	ПравоеЗначение = СтрЗаменить(СтрокаПоляКомпоновкиДанных,"_ЗначениеФакт","");
	// --- 
	Для каждого СтрокаОтбора Из УФ.Журнал_КомпоновщикНастроек.Настройки.Отбор.Элементы Цикл
		
		Если (ТипЗнч(СтрокаОтбора) = Тип("ЭлементОтбораКомпоновкиДанных")) Тогда
			
			ЛевоеЗначение = Строка(СтрокаОтбора.ЛевоеЗначение);
			ЛевоеЗначение = СтрЗаменить(ЛевоеЗначение,"_ЗначениеПлан","");
			ЛевоеЗначение = СтрЗаменить(ЛевоеЗначение,"_ЗначениеФакт","");
			
			// Строка(СтрокаОтбора.ЛевоеЗначение)
			Если (ЛевоеЗначение = ПравоеЗначение) Тогда
				
				Если (СтрокаОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.БольшеИлиРавно) Тогда
					
					НачалоПериода = СтрокаОтбора.ПравоеЗначение;
					ИдентификаторСтрокиНачалаПериода = УФ.Журнал_КомпоновщикНастроек.Настройки.Отбор.ПолучитьИдентификаторПоОбъекту(СтрокаОтбора);
					
				ИначеЕсли (СтрокаОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.МеньшеИлиРавно) Тогда 
					
					КонецПериода = СтрокаОтбора.ПравоеЗначение; 
					ИдентификаторСтрокиКонцаПериода = УФ.Журнал_КомпоновщикНастроек.Настройки.Отбор.ПолучитьИдентификаторПоОбъекту(СтрокаОтбора);
					
				КонецЕсли; 
				
			КонецЕсли; 
			
		КонецЕсли; 
		
	КонецЦикла; 
	
	
	
	ПОВ = Новый ОписаниеОповещения("ОбработкаВыбораПериодаОтбора",ЭтотОбъект, Новый Структура("УФ,Полекомпоновки,ИСНП,ИСКП,ПОВ",УФ,ПолеКомпоновки,ИдентификаторСтрокиНачалаПериода,ИдентификаторСтрокиКонцаПериода,ПроцедураОбратногоВызова)); 
	Если (КонецПериода <> Дата(1,1,1)) Тогда
		КонецПериода = КонецДня(КонецПериода);
	КонецЕсли; 
	Период = Новый СтандартныйПериод(НачалоДня(НачалоПериода),КонецПериода);
	ДиалогПериода = Новый ДиалогРедактированияСтандартногоПериода;
	ДиалогПериода.Период = Период;
	ДиалогПериода.Показать(ПОВ);
	
	// --- 
КонецПроцедуры
  

&НаКлиенте
Процедура ОбработкаВыбораПериодаОтбора(Ответ, ДополнительныеПараметры) Экспорт 
	// --- 
	
	Если (Ответ <> Неопределено) Тогда
		
		УФ = ДополнительныеПараметры.УФ;
		
		Если (Ответ.ДатаНачала = Дата(1,1,1)) Тогда
			
			// удаляем строку отбора
			Если (ДополнительныеПараметры.ИСНП <> Неопределено) Тогда
				
				СтрокаОтбора = УФ.Журнал_КомпоновщикНастроек.Настройки.Отбор.ПолучитьОбъектПоИдентификатору(ДополнительныеПараметры.ИСНП);
				УФ.Журнал_КомпоновщикНастроек.Настройки.Отбор.Элементы.Удалить(СтрокаОтбора);
				
			КонецЕсли; 			
			
		Иначе
			
			Если (ДополнительныеПараметры.ИСНП <> Неопределено) Тогда
				СтрокаОтбора = УФ.Журнал_КомпоновщикНастроек.Настройки.Отбор.ПолучитьОбъектПоИдентификатору(ДополнительныеПараметры.ИСНП);
			Иначе
				СтрокаОтбора = УФ.Журнал_КомпоновщикНастроек.Настройки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
				СтрокаОтбора.ЛевоеЗначение = ДополнительныеПараметры.ПолеКомпоновки;
				СтрокаОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.БольшеИлиРавно;
			КонецЕсли; 
			
			СтрокаОтбора.ПравоеЗначение = НачалоДня(Ответ.ДатаНачала);
			СтрокаОтбора.Использование = Истина;
			
		КонецЕсли;
		// --- 
		Если (Ответ.ДатаОкончания = Дата(1,1,1)) Тогда
			
			// удаляем строку отбора
			Если (ДополнительныеПараметры.ИСКП <> Неопределено) Тогда
				
				СтрокаОтбора = УФ.Журнал_КомпоновщикНастроек.Настройки.Отбор.ПолучитьОбъектПоИдентификатору(ДополнительныеПараметры.ИСКП);
				УФ.Журнал_КомпоновщикНастроек.Настройки.Отбор.Элементы.Удалить(СтрокаОтбора);
				
			КонецЕсли; 			
			
		Иначе
			
			Если (ДополнительныеПараметры.ИСКП <> Неопределено) Тогда
				СтрокаОтбора = УФ.Журнал_КомпоновщикНастроек.Настройки.Отбор.ПолучитьОбъектПоИдентификатору(ДополнительныеПараметры.ИСКП);
			Иначе
				СтрокаОтбора = УФ.Журнал_КомпоновщикНастроек.Настройки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
				СтрокаОтбора.ЛевоеЗначение = ДополнительныеПараметры.ПолеКомпоновки;
				СтрокаОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.МеньшеИлиРавно;
			КонецЕсли; 
			
			СтрокаОтбора.ПравоеЗначение = КонецДня(Ответ.ДатаОкончания);
			СтрокаОтбора.Использование = Истина;
			
		КонецЕсли; 
		
		// --- 
		
		ВыполнитьОбработкуОповещения(ДополнительныеПараметры.ПОВ,_УФКС.СД("Журналы","сервер","/ОбновитьДанныеПриИзмененииОтбора"));
		
		
	КонецЕсли; 
	
	// --- 
КонецПроцедуры
  

#КонецОбласти 

#Область ОтборПоСпискуЗначений 

&НаКлиенте
Функция ПолучитьОписаниеОповещенияТекущегоМодуля(ДополнительныеПараметры) Экспорт
	
	Возврат Новый ОписаниеОповещения("ОбработкаИзмененияОтбораПоСпискуЗначений",ЭтотОбъект, ДополнительныеПараметры);
	
КонецФункции

&НаКлиенте
Функция ОтборПоСпискуЗначенийДиалог(УФ,ПараметрыФормы, ПроцедураОбратногоВызова)
	
	ПОВ = Новый ОписаниеОповещения("ОбработкаИзмененияОтбораПоСпискуЗначений",ЭтотОбъект,Новый Структура("УФ,ПОВ,ПараметрыФормы",УФ,ПроцедураОбратногоВызова,ПараметрыФормы));
	ОткрытьФорму("ОбщаяФорма.CW_ЖурналГрузоперевозок_ОтборПоСпискуЗначений", ПараметрыФормы,,,,,ПОВ,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецФункции

&НаКлиенте
Процедура ОбработкаИзмененияОтбораПоСпискуЗначений(ОтборПоСписку, ДополнительныеПараметры) Экспорт
	// --- 
	
	Если (ОтборПоСписку <> Неопределено) Тогда
		
		Отб = ДополнительныеПараметры.УФ.Журнал_КомпоновщикНастроек.Настройки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		Отб.Использование = Истина;
		Мас = ДополнительныеПараметры.УФ.Журнал_ОписаниеКолонок.НайтиСтроки(Новый Структура("Имя", ДополнительныеПараметры.ПараметрыФормы.Имяколонки));
		Если Мас.Количество() = 1 Тогда
			
			Отб.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(Мас[0].СтрокаПоляКомпоновки);
			Отб.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке;
			Отб.ПравоеЗначение = ОтборПоСписку;
			// --- 
			ВыполнитьОбработкуОповещения(ДополнительныеПараметры.ПОВ,_УФКС.СД("Журналы","сервер","/ОбновитьДанныеПриИзмененииОтбора"));
			
		Иначе
			
			ВыполнитьОбработкуОповещения(ДополнительныеПараметры.ПОВ,_УФКС.СД("Журналы","клиент","/Предупреждение","Не удалось наложить отбор!"));
			
		КонецЕсли;	
		
	КонецЕсли;
	
	// --- 
КонецПроцедуры
  

#КонецОбласти 

#Область ОтборПоТексту 

&НаКлиенте
Функция ОтборКонтейнеровПоТекстуДиалог(УФ,ПроцедураОбратногоВызова)
	
	ПОВ = Новый ОписаниеОповещения("ОбработкаИзмененияОтбораПоТексту",ЭтотОбъект,Новый Структура("УФ,ПОВ",УФ,ПроцедураОбратногоВызова));
	
	ПараметрыФормы  = Новый Структура;
	ПоказатьНастройки = ЭтоФормаЖурналаГрузоперевозок(УФ) или ЭтоФормаЖурналаЗаявок(УФ) или ЭтоФормаЖурналаЗаказов(УФ);
	ПараметрыФормы.Вставить("ПоказатьНастройки",ПоказатьНастройки);
	
	Если ЭтоФормаЗаказа(УФ) или ЭтоФормаЗаявки(УФ) Тогда
		ПараметрыФормы.Вставить("ОбъектСсылка", УФ.Объект.Ссылка);
	КонецЕсли;
	
	ОткрытьФорму("ОбщаяФорма.CW_ЖурналГрузоперевозок_ОтборКонтейнеровПоТексту",ПараметрыФормы,УФ,,,,ПОВ,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецФункции

&НаКлиенте
Процедура ОбработкаИзмененияОтбораПоТексту(ОтборПоТексту, ДополнительныеПараметры) Экспорт
	// --- 
	
	Если (ОтборПоТексту <> Неопределено) Тогда
		
		Сп = Новый Массив; 
		УчестьОтбор = Ложь; 
		УчестьСтатусы = Ложь;
		
		ОтборПоТексту.Свойство("НастройкиОтбора", Сп);
		ОтборПоТексту.Свойство("УчестьОтбор", УчестьОтбор);
		ОтборПоТексту.Свойство("УчестьСтатусы", УчестьСтатусы);
		
		Если (НЕ УчестьОтбор) Тогда
			ДополнительныеПараметры.УФ.Журнал_КомпоновщикНастроек.Настройки.Отбор.Элементы.Очистить();
		КонецЕсли;	
		
		Отб = ДополнительныеПараметры.УФ.Журнал_КомпоновщикНастроек.Настройки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		Отб.Использование = Истина;
		Отб.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Ссылка");
		Отб.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке;
		СписокОтбора = Новый СписокЗначений;
		СписокОтбора.ЗагрузитьЗначения(Сп);
		Отб.ПравоеЗначение = СписокОтбора;
		
		ВыполнитьОбработкуОповещения(ДополнительныеПараметры.ПОВ,_УФКС.СД("Журналы","сервер","/ОбновитьДанныеПриИзмененииОтбора",Новый Структура("ОбновлятьОтборПоСтатусам,ОбновлятьОтборПоФинансовымСтатусам",УчестьСтатусы,УчестьСтатусы)));
		
	КонецЕсли;	
	
	// --- 
КонецПроцедуры
  

#КонецОбласти 

#КонецОбласти 

#Область Раскраска 

&НаКлиенте
Функция Раскрасить_Диалог(УФ,ПроцедураОбратногоВызова)
	
	Элементы = УФ.Элементы;
	Журнал_Данные = УФ.Журнал_Данные;
	
	МассивСсылок = Новый Массив;
	Для каждого Стр Из Элементы.Журнал.ВыделенныеСтроки Цикл
		Если НЕ ТипЗнч(Стр) = Тип("СтрокаГруппировкиДинамическогоСписка") Тогда 
			МассивСсылок.Добавить(Журнал_Данные.НайтиПоИдентификатору(Стр).Ссылка);
		КонецЕсли;
	КонецЦикла; 
	Если МассивСсылок.Количество() = 0 Тогда
		Возврат(Неопределено);
	КонецЕсли; 

	// дадим выбрать цвет
	ПОВ = Новый ОписаниеОповещения("ОбработкаИзмененияРаскраски",ЭтотОбъект,Новый Структура("УФ,ПОВ,МассивСсылок",УФ,ПроцедураОбратногоВызова,МассивСсылок));
	ОткрытьФорму("Справочник.CW_Цвета.Форма.ФормаВыбора",,,,,,ПОВ,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецФункции

&НаКлиенте
Процедура ОбработкаИзмененияРаскраски(Результат, ДополнительныеПараметры) Экспорт
	// --- 
	
	Если (Результат <> Неопределено) Тогда
		
		Параметры = Новый Структура("МассивСсылок, ЭлементСправочникаЦвета", ДополнительныеПараметры.МассивСсылок, Результат);
		ВыполнитьОбработкуОповещения(ДополнительныеПараметры.ПОВ,_УФКС.СД("Журналы","сервер","/РаскраситьУстановкаЦветаИОформления",Параметры));
		
	КонецЕсли; 
	
	// --- 
КонецПроцедуры
  

#КонецОбласти 

#Область Эксель

&НаКлиенте
Функция ОткрытьЛибоРедактировать(УФ, ВыбраннаяСтрока, ПроцедураОбратногоВызова) Экспорт 
	
	Элементы = УФ.Элементы;
	Журнал_СтруктураНастроек = УФ.Журнал_СтруктураНастроек;
	
	РежимОткрытия = Истина;
	
	Если (Журнал_СтруктураНастроек["РежимЕкселя"]) Тогда  
		
		// проверяем, что колонка редактируется
		ИмяКолонки = НРег(СтрЗаменить(Элементы.Журнал.ТекущийЭлемент.Имя,"Журнал_",""));
		ПараметрыКолонки = ПараметрыКолонки(УФ, ИмяКолонки);
		Если (ПараметрыКолонки = Неопределено) Тогда
			Возврат(Неопределено);
		КонецЕсли; 
		Если (ПараметрыКолонки.РежимПрямогоРедактирования) Тогда
			
			МассивВыделенных = ПолучитьМассивВыделенныхГрузоперевозок(УФ);
			
			Если НЕ ПараметрыКолонки.РежимМножественногоРедактирования И МассивВыделенных.Количество() > 1 Тогда
				
				РежимОткрытия = Ложь;
				_УФК.ВывестиПредупреждение("Множественное редактирование невозможно.");
				
			Иначе
				
				Отказ = Ложь;
				Если ПараметрыКолонки.ИспользованиеОтбора Тогда
					СтруктураПараметров = новый Структура;
					СтруктураПараметров.Вставить("ОбъектХарактеристики"				, ПараметрыКолонки.ОбъектХарактеристики);
					СтруктураПараметров.Вставить("МассивСсылок"						, МассивВыделенных);
					СтруктураПараметров.Вставить("ЭтоФормаЖурналаГрузоперевозок"	, ЭтоФормаЖурналаГрузоперевозок(УФ));
					СтруктураПараметров.Вставить("ЭтоФормаЖурналаЗаявок"			, ЭтоФормаЖурналаЗаявок(УФ));
					СтруктураПараметров.Вставить("ЭтоФормаЖурналаЗаказов"			, ЭтоФормаЖурналаЗаказов(УФ));
					СтруктураПараметров.Вставить("ЭтоФормаЗаказа"					, ЭтоФормаЗаказа(УФ));
					
					Отказ = CW_Журналы_Сервер.ПроверитьНаличиеОтбора(СтруктураПараметров);
				КонецЕсли;  
				
				РежимОткрытия = Ложь;
				Если Не Отказ Тогда
					Возврат(ПроизвестиРедактирование(ПроцедураОбратногоВызова,УФ,МассивВыделенных, ПараметрыКолонки));	
				Иначе
					_УФК.ВывестиПредупреждение("Множественное редактирование невозможно.
												|Необходимо, чтобы значения реквзитов отбора параметра ("+ПараметрыКолонки.Заголовок+") были идентичными!");
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли; 
		
	КонецЕсли;

	Если (РежимОткрытия) Тогда
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("Ключ", УФ.Журнал_Данные.НайтиПоИдентификатору(ВыбраннаяСтрока)["ссылка"]);
		ПараметрыФормы.Вставить("НеРассчитыватьСтатусыПриЗаписи", Истина);
		
		Если (ЭтоФормаЖурналаГрузоперевозок(УФ)) Тогда
			ОткрытьФорму("Справочник.CW_Грузоперевозки.ФормаОбъекта", ПараметрыФормы, Элементы.Журнал);
		ИначеЕсли (ЭтоФормаЗаказа(УФ)) Тогда 
			ОткрытьФорму("Справочник.CW_Грузоперевозки.ФормаОбъекта", ПараметрыФормы, Элементы.Журнал);
		ИначеЕсли (ЭтоФормаЗаявки(УФ)) Тогда 
			ОткрытьФорму("Справочник.CW_Грузоперевозки.ФормаОбъекта", ПараметрыФормы, Элементы.Журнал);
		ИначеЕсли (ЭтоФормаЖурналаЗаявок(УФ)) Тогда 
			ОткрытьФорму("Справочник.CW_Заявки.ФормаОбъекта", ПараметрыФормы, Элементы.Журнал,,,,,РежимОткрытияОкнаФормы.Независимый);
		ИначеЕсли (ЭтоФормаЖурналаЗаказов(УФ)) Тогда 
			ОткрытьФорму("Справочник.CW_Заказы.ФормаОбъекта", ПараметрыФормы, Элементы.Журнал,,,,,РежимОткрытияОкнаФормы.Независимый);
		КонецЕсли; 
				
	КонецЕсли;
	
	Возврат(Неопределено);
	
КонецФункции

#КонецОбласти 

#Область ОчисткаЗначений 

&НаКлиенте
Функция ОчиститьЗначения_ЗадатьВопрос(УФ, ПроцедураОбратногоВызова)
	
	Элементы = УФ.Элементы;
	Журнал_ОписаниеКолонок = УФ.Журнал_ОписаниеКолонок;
	
	// очищаем
	ИмяКолонки = НРег(СтрЗаменить(Элементы.Журнал.ТекущийЭлемент.Имя,"Журнал_",""));
	НайденныеКолонки = Журнал_ОписаниеКолонок.НайтиСтроки(Новый Структура("Имя",ИмяКолонки));
	
	Если (НайденныеКолонки.Количество() <> 0) Тогда
		
		ПараметрыКолонки = НайденныеКолонки[0];
		
		Если ПараметрыКолонки.РежимПрямогоРедактирования Тогда
			
			ПОВ_Очистка = Новый ОписаниеОповещения("ОбработкаОчисткиЗначений",ЭтотОбъект,Новый Структура("ПОВ,УФ,ПараметрыКолонки",ПроцедураОбратногоВызова, УФ, ПараметрыКолонки));
			
			ПОВ_ВопросОбОчистке = Новый ОписаниеОповещения("ОбработкаОтветаОбОчисткеЗначений",ЭтотОбъект,Новый Структура("ПОВ",ПОВ_Очистка));
	
			Если Элементы.Журнал.ВыделенныеСтроки.Количество() = 1 Тогда
				ТекстВопроса = "Очистить значение для выделенного объекта?";
			Иначе
				ТекстВопроса = "Очистить значение для выделенных объектов ("+Строка(Элементы.Журнал.ВыделенныеСтроки.Количество())+")?";
			КонецЕсли; 
			
			ПоказатьВопрос(ПОВ_ВопросОбОчистке, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
			
		КонецЕсли; 
		
	КонецЕсли;
	
	Возврат(Неопределено);
	
КонецФункции

&НаКлиенте
Процедура ОбработкаОтветаОбОчисткеЗначений(Ответ, ДополнительныеПараметры) Экспорт 
	// --- 
	
	Если Ответ=КодВозвратаДиалога.Да Тогда
		ВыполнитьОбработкуОповещения(ДополнительныеПараметры.ПОВ);
	КонецЕсли; 
	
	// --- 
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОчисткиЗначений(Ответ, ДополнительныеПараметры) Экспорт 
	// --- 
	
	ВыполнитьОбработкуОповещения(ДополнительныеПараметры.ПОВ,ПроизвестиРедактирование(ДополнительныеПараметры.ПОВ,ДополнительныеПараметры.УФ,ПолучитьМассивВыделенныхГрузоперевозок(ДополнительныеПараметры.УФ), ДополнительныеПараметры.ПараметрыКолонки, Истина));
	
	// --- 
КонецПроцедуры
  

#КонецОбласти 

&НаКлиенте
Функция ПолучитьМассивВыделенныхГрузоперевозок(УФ)
	
	Массив = Новый Массив;
	Для каждого ИдентификаторСтроки Из УФ.Элементы.Журнал.ВыделенныеСтроки Цикл   
		
		СтрокаТекущая =  УФ.Журнал_Данные.НайтиПоИдентификатору(ИдентификаторСтроки);
		//РаботаСАрхивомОбъектов  
		Если CW_АрхивОбъектовСервер.ВАрхиве(СтрокаТекущая.Ссылка) Тогда
			Продолжить;
		КонецЕсли ;     
		//РаботаСАрхивомОбъектов   
		
		Массив.Добавить(СтрокаТекущая.Ссылка);  
		
	КонецЦикла;

	Возврат Массив;
	
КонецФункции    


&НаКлиенте
Функция ПараметрыКолонки(УФ, ИмяКолонки)
	
	массСтрокОписанияКолонки = УФ.Журнал_ОписаниеКолонок.НайтиСтроки(Новый Структура("Имя", ИмяКолонки));
	Если (массСтрокОписанияКолонки.Количество() <> 0) Тогда
		Возврат(массСтрокОписанияКолонки[0]);
	Иначе
		Возврат(Неопределено);
	КонецЕсли; 
	
КонецФункции

#Область Редактирование 

&НаКлиенте
Функция ПроизвестиРедактирование(ПроцедураОбратногоВызова,Форма,МассивСсылок, ПараметрыКолонки, РежимОчистки=Ложь)
	
	Если Не ЭтоФормаЗаказа(Форма) и Не ЭтоФормаЗаявки(Форма) Тогда
		Форма.АктивноРедактированиеВРежимеExcel = Истина;             
	КонецЕсли;
	
	ЭтоПараметр = (ПараметрыКолонки.ПараметрГрузоперевозки ИЛИ ПараметрыКолонки.КонтрольнаяДатаГрузоперевозки);
	ЭтоРеквизит = (НЕ ЭтоПараметр);
	
	Если (ЭтоПараметр) Тогда
		// если это параметр грузоперевозки
		ВыбраннаяФорма 			= Неопределено;
		ТолькоПросмотрПарамера 	= CW_Журналы_Сервер.ТолькоПросмотрПараметра(ПараметрыКолонки.ОбъектХарактеристики);

		СвойстваПараметра = CW_Мониторинг.СтруктураСвойствПараметра(ПараметрыКолонки.ОбъектХарактеристики);
		ПОВ = Новый ОписаниеОповещения("ОбработатьРезультатРедактированияПараметра",ЭтотОбъект, Новый Структура("УФ,ПОВ,ВидОперации,СвойстваПараметра,МассивСсылок,Параметр",Форма,ПроцедураОбратногоВызова,"Параметр",СвойстваПараметра,МассивСсылок,ПараметрыКолонки.ОбъектХарактеристики));
		
		Если (НЕ РежимОчистки) Тогда
			
			АдресОбъекта = Неопределено;
			Если МассивСсылок.Количество() > 0 Тогда   
				ВыделеннаяСтрока = Форма.Журнал_Данные.НайтиПоИдентификатору(Форма.Элементы.Журнал.ТекущаяСтрока);
				АдресОбъекта = CW_Журналы_Сервер.АдресОбъекта(ВыделеннаяСтрока.ссылка, Форма.УникальныйИдентификатор)
			КонецЕсли;
			
			ПараметрыФормы = Новый Структура;
			ПараметрыФормы.Вставить("Режим", 					"РедактированиеСписка");
			ПараметрыФормы.Вставить("Параметр", 				ПараметрыКолонки.ОбъектХарактеристики);
			ПараметрыФормы.Вставить("АдресСвойствПараметра", 	ПоместитьВоВременноеХранилище(СвойстваПараметра,Форма.УникальныйИдентификатор));
			ПараметрыФормы.Вставить("РедактируемыеОбъекты", 	МассивСсылок);
			ПараметрыФормы.Вставить("РежимОчистки", 			РежимОчистки);
			ПараметрыФормы.Вставить("ТолькоПросмотр", 			ТолькоПросмотрПарамера);
			ПараметрыФормы.Вставить("АдресОбъекта", 			АдресОбъекта);
			// --- 
			Если СвойстваПараметра.ИспользоватьФормуВыбораОбъекта тогда
				
				Если Не ТолькоПросмотрПарамера Тогда
					ВыбраннаяФорма = СвойстваПараметра.ИмяФормыВыбора;
					
					ПараметрыФормы.Вставить("РежимВыбора"		, Истина);
					ПараметрыФормы.Вставить("ЗакрыватьПриВыборе", Истина);
					
					Если СвойстваПараметра.ИспользуютсяДополнительныеЗначения Тогда
						ПараметрыФормы.Вставить("Отбор", Новый Структура("Владелец",ПараметрыКолонки.ОбъектХарактеристики));
					КонецЕсли;
					
				КонецЕсли;
				
			Иначе
				Если СвойстваПараметра.ИспользуетсяВнешняяОбработкаПередНачаломИзменения Тогда
					
					СтруктураПараметров = _ПО.ПолучитьИмяФормыНаСервере(ПараметрыКолонки.ОбъектХарактеристики, АдресОбъекта);
					ВыбраннаяФорма 		= "ПланВидовХарактеристик.CW_ПараметрыГрузоперевозок.Форма.ФормаРедактирования";

					ОбработчикНеИспользуется = Ложь;
					Если СтруктураПараметров.Свойство("НеИспользуется") Тогда
						ОбработчикНеИспользуется = СтруктураПараметров.НеИспользуется;
					КонецЕсли;
					
					Если СтруктураПараметров.Свойство("ТолькоПросмотр") Тогда
						Если  НЕ ПараметрыФормы.ТолькоПросмотр Тогда
							ПараметрыФормы.ТолькоПросмотр =  СтруктураПараметров.ТолькоПросмотр;
						КонецЕсли;
					КонецЕсли;
					
					Если СтруктураПараметров.Свойство("ПодключаемыйОбъект") Тогда
						ПараметрыФормы.Вставить("ПодключаемыйОбъект",СтруктураПараметров.ПодключаемыйОбъект);
					КонецЕсли; 
					
					Если ОбработчикНеИспользуется ИЛИ 
						СтруктураПараметров.РежимОткрытия = 1 Тогда
						ВыбраннаяФорма = "ПланВидовХарактеристик.CW_ПараметрыГрузоперевозок.Форма.ФормаРедактирования";
				    ИначеЕсли	СтруктураПараметров.РежимОткрытия = 0 Тогда
						ВыбраннаяФорма = СтруктураПараметров.ИмяФормы;
					КонецЕсли;
					
				Иначе
					ВыбраннаяФорма = "ПланВидовХарактеристик.CW_ПараметрыГрузоперевозок.Форма.ФормаРедактирования";
				КонецЕсли;

			КонецЕсли;
			
			Если ВыбраннаяФорма <> Неопределено Тогда
				ОткрытьФорму(ВыбраннаяФорма, ПараметрыФормы,Форма,,,,ПОВ,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
			КонецЕсли;
	
			Возврат(Неопределено);
			
		ИначеЕсли (РежимОчистки) Тогда
			
			СтруктураЗначения = Новый Структура;
			СтруктураЗначения.Вставить("Параметр",     ПараметрыКолонки.ОбъектХарактеристики);
			СтруктураЗначения.Вставить("РежимОчистки", Истина);
			СтруктураЗначения.Вставить("Значение",     Неопределено);
			// --- 
			ВыполнитьОбработкуОповещения(ПОВ,СтруктураЗначения);
			Возврат(Неопределено);
			
		КонецЕсли; 
		
	КонецЕсли;
	
	// --- 
	
	Если (ЭтоРеквизит) Тогда
		
		// редактирование реквизитов
		ИмяРеквизита = СтрЗаменить(ПараметрыКолонки.СтрокаПоляКомпоновки, "Ссылка.", "");
		ПОВ = Новый ОписаниеОповещения("ОбработатьРезультатРедактированияПараметра",ЭтотОбъект, Новый Структура("УФ,ПОВ,ВидОперации,МассивСсылок",Форма,ПроцедураОбратногоВызова,"Реквизит",МассивСсылок));
		ПОВ_ИзменениеРеквизита = Новый ОписаниеОповещения("ОбработкаИзмененияЗначенияРеквизита",ЭтотОбъект, Новый Структура("УФ,ПОВ,ПОВ_Редактирования,ИмяРеквизита,РежимОчистки",Форма,ПроцедураОбратногоВызова,ПОВ,ИмяРеквизита,РежимОчистки));
		
		Если (НЕ РежимОчистки) Тогда
			
			СтруктураТаблицы = CW_Журналы_Сервер.ИмяТаблицыПоОписаниюТипов(ПараметрыКолонки.ТипЗначения);
			
			ВыделеннаяСтрока = Форма.Журнал_Данные.НайтиПоИдентификатору(Форма.Элементы.Журнал.ТекущаяСтрока);
			ЗначениеПоля 	 = ВыделеннаяСтрока[ПараметрыКолонки.Имя]; 
			
			Если ЗначениеЗаполнено(СтруктураТаблицы.ИмяТаблицы) тогда
				//Ссылка
				ПараметрыФормы = Новый Структура;
				ПараметрыФормы.Вставить("РежимВыбора", Истина);
				ПараметрыФормы.Вставить("МножественыйВыбор", Ложь);
				
				ПараметрыФормы.Вставить("ТекущаяСтрока", ЗначениеПоля);
				
				ОткрытьФорму(СтруктураТаблицы.ИмяТаблицы+".ФормаВыбора",ПараметрыФормы,,,,,ПОВ_ИзменениеРеквизита,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
			Иначе
				//Примитивынй
				Если СтруктураТаблицы.ТипРеквизита = тип("Строка") Тогда 
					ПоказатьВводСтроки(ПОВ_ИзменениеРеквизита,ЗначениеПоля,ПараметрыКолонки.Заголовок,,Истина);
				Иначе
					ПоказатьВводЗначения(ПОВ_ИзменениеРеквизита,ЗначениеПоля,ПараметрыКолонки.Заголовок, СтруктураТаблицы.ТипРеквизита); 
				КонецЕсли;
			КонецЕсли;
			
			Возврат(Неопределено);
			
		КонецЕсли;
			
		Если (РежимОчистки) Тогда
			
			ВыполнитьОбработкуОповещения(ПОВ_ИзменениеРеквизита,Неопределено);
			Возврат(Неопределено);
			
		КонецЕсли; 
		
	КонецЕсли; 
	 	
КонецФункции



&НаКлиенте
Процедура ОбработкаИзмененияЗначенияРеквизита(НовоеЗначениеРеквизита,ДополнительныеПараметры) Экспорт 
	// --- 
	
	Если НовоеЗначениеРеквизита <> Неопределено ИЛИ ДополнительныеПараметры.РежимОчистки Тогда
		
		СтруктураЗначения=Новый Структура;
		СтруктураЗначения.Вставить("Реквизит",     ДополнительныеПараметры.ИмяРеквизита);
		СтруктураЗначения.Вставить("РежимОчистки", ДополнительныеПараметры.РежимОчистки);
		СтруктураЗначения.Вставить("Значение",     НовоеЗначениеРеквизита);
		// --- 
		ВыполнитьОбработкуОповещения(ДополнительныеПараметры.ПОВ_Редактирования,СтруктураЗначения);
		
	КонецЕсли; 
	
	// --- 
КонецПроцедуры
  

&НаКлиенте
Процедура ОбработатьРезультатРедактированияПараметра(СтруктураЗначения, ДополнительныеПараметры) Экспорт 

	Если (СтруктураЗначения <> Неопределено) Тогда 
		
		Если ТипЗнч(СтруктураЗначения) <> Тип("Структура") Тогда
			//В случае если ответ форме не имеет тип структура, поместим его в структуру для последующей обработки
			СтруктураЗначения = _ПО.ПолучитьСтруктуруОтветаВнешнейФормы(СтруктураЗначения, ДополнительныеПараметры.Параметр);
		КонецЕсли;

		Параметры = Новый Структура("МассивСсылок, ВидОперации, СтруктураЗначения, СписокВедомых, СписокАдресовЗначенийПараметров");
		Параметры.МассивСсылок = ДополнительныеПараметры.МассивСсылок;
		Параметры.ВидОперации = ДополнительныеПараметры.ВидОперации;
		Параметры.СтруктураЗначения = СтруктураЗначения;
		Если (ДополнительныеПараметры.Свойство("СвойстваПараметра") <> Ложь) Тогда
			Параметры.СписокВедомых = ДополнительныеПараметры.СвойстваПараметра.СписокВедомых.ВыгрузитьЗначения();
		КонецЕсли; 
		
		Если ДополнительныеПараметры.УФ.СписокАдресовЗначенийПараметров.Количество() > 0 Тогда
			Параметры.Вставить("СписокАдресовЗначенийПараметров", ДополнительныеПараметры.УФ.СписокАдресовЗначенийПараметров);	
		КонецЕсли;  
		
		//По зявке AFR-240470 от 26.11.2024 
		МассивУдаляемых = Новый Массив;
		Для Каждого ПроверяемаяСсылка из Параметры.МассивСсылок Цикл 
			
			Если ТипЗнч(ПроверяемаяСсылка) = Тип("СправочникСсылка.CW_Заявки") Тогда 
				Продолжить;
			КонецЕсли; 
			
			ДатуЗакрытияМониторинга = CW_Мониторинг.ПолучитьДатуЗакрытияМониторинга(ПроверяемаяСсылка);
			Если ДатуЗакрытияМониторинга <> Дата(1,1,1) Тогда
				МассивУдаляемых.Добавить(ПроверяемаяСсылка);   
				Сообщить("Для "+СокрЛП(ПроверяемаяСсылка)+" установлена блокировка (логистических) мониторинговых параметров. Изменения значения параметра не возможно!");
			КонецЕсли;
		КонецЦикла;   
		
		Для Каждого УдаляемаяСсылка из МассивУдаляемых Цикл
			Параметры.МассивСсылок.Удалить(Параметры.МассивСсылок.Найти(УдаляемаяСсылка));			
		КонецЦикла;
		//---по зявке AFR-240470 от 26.11.2024 
		
		ВыполнитьОбработкуОповещения(ДополнительныеПараметры.ПОВ,_УФКС.СД("Журналы","сервер","/ПроизвестиРедактирование", Параметры));
		
		ОповещениеООбновитьСтатусыОбъектов = Новый ОписаниеОповещения("ОбновитьСтатусыОбъектов", ДополнительныеПараметры.УФ, ДополнительныеПараметры);
		ВыполнитьОбработкуОповещения(ОповещениеООбновитьСтатусыОбъектов, Истина);
		
		Оповестить("ОбновитьДеревоПараметровГрузоперевозкиПоЗаказу", ДополнительныеПараметры.МассивСсылок);
		
	КонецЕсли;
	
	Если Не ЭтоФормаЗаказа(ДополнительныеПараметры.УФ) 
		и Не ЭтоФормаЗаявки(ДополнительныеПараметры.УФ) Тогда
		ДополнительныеПараметры.УФ.АктивноРедактированиеВРежимеExcel = Ложь;
	КонецЕсли;

КонецПроцедуры

