#Область СуммаВыделенных 

&НаКлиенте
Функция СуммаВыделенныхЯчеек(УФ)
	
	Элементы = УФ.Элементы;
	Журнал_Данные = УФ.Журнал_Данные;
	
	СуммаЗначений 			= 0;
	МинимальноеЗначение 	= Неопределено;
	МаксимальноеЗначение 	= Неопределено;
	
	Для каждого Стр Из Элементы.Журнал.ВыделенныеСтроки Цикл
		
		СтрокаЖурнала 	= Журнал_Данные.НайтиПоИдентификатору(Стр);
		ЗначениеЯчейки	= СтрокаЖурнала[СтрЗаменить(Элементы.Журнал.ТекущийЭлемент.Имя,"Журнал_","")];
		
		Если ТипЗнч(ЗначениеЯчейки)=Тип("Число") Тогда
			_сф.Инкремент(СуммаЗначений,ЗначениеЯчейки);
		КонецЕсли; 
		
		Если  МинимальноеЗначение = Неопределено Тогда
			МинимальноеЗначение = ЗначениеЯчейки;
		Иначе
			МинимальноеЗначение = ?(ЗначениеЯчейки < МинимальноеЗначение, ЗначениеЯчейки, МинимальноеЗначение); 
		КонецЕсли;
		
		Если  МаксимальноеЗначение = Неопределено Тогда
			МаксимальноеЗначение = ЗначениеЯчейки;
		Иначе
			МаксимальноеЗначение = ?(ЗначениеЯчейки > МаксимальноеЗначение, ЗначениеЯчейки, МаксимальноеЗначение); 
		КонецЕсли;
		
	КонецЦикла; 
	
	КоличествоЗначений  =  Элементы.Журнал.ВыделенныеСтроки.Количество();
	СреднееЗначение		= ?(КоличествоЗначений=0,0, СуммаЗначений/КоличествоЗначений);
	
	СтркутраПараметров = Новый Структура;
	СтркутраПараметров.Вставить("КоличествоЗначений"	, КоличествоЗначений);
	СтркутраПараметров.Вставить("СреднееЗначение"		, СреднееЗначение);
	СтркутраПараметров.Вставить("МинимальноеЗначение"	, МинимальноеЗначение);
	СтркутраПараметров.Вставить("МаксимальноеЗначение"	, МаксимальноеЗначение);
	СтркутраПараметров.Вставить("СуммаЗначений"			, СуммаЗначений);
	
	
	ОткрытьФорму("ОбщаяФорма.CW_ВычислитьЗначениеЖурнала",СтркутраПараметров,УФ,,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
Конецфункции

