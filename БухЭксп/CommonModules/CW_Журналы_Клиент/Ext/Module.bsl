&НаКлиенте
Процедура ВыборПодключаемыхГрузоперевозок(Ответ, ДополнительныеПараметры) Экспорт
	// --- 
	
	ПОВ = Новый ОписаниеОповещения("ОбработкаВыбораГрузоперевозок",ЭтотОбъект,Новый Структура("УФ,ПОВ",ДополнительныеПараметры.УФ,ДополнительныеПараметры.ПОВ));
	// --- 
	ПараметрыФормы = Новый Структура;
	Отбор =  Новый Структура("Заказ", ПредопределенноеЗначение("Справочник.CW_Заказы.ПустаяСсылка"));
	Если (ЗначениеЗаполнено(ДополнительныеПараметры.УФ.Объект.Клиент)) Тогда
		ПараметрыФормы.Вставить("Клиент",ДополнительныеПараметры.УФ.Объект.Клиент);
	КонецЕсли; 
	ПараметрыФормы.Вставить("Отбор",Отбор);
	// ДополнительныеПараметры.УФ.Объект.Клиент
	ПараметрыФормы.Вставить("МножественныйВыбор", 	Истина);
	ПараметрыФормы.Вставить("РежимВыбора",			Истина);
	// --- 
	ОткрытьФорму("Справочник.CW_Грузоперевозки.ФормаВыбора", ПараметрыФормы, ДополнительныеПараметры.УФ.Элементы.Журнал,,,,ПОВ,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
	// --- 
