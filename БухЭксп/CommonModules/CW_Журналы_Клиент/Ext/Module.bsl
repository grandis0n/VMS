&НаКлиенте
Функция ВыполнитьДействие(УФ, СтруктураДействия, ПроцедураОбратногоВызова = Неопределено) Экспорт 
	
	ИмяКоманды = СтруктураДействия.Команда;
	Параметры = СтруктураДействия.Параметры;
	// --- 
	Отладка = УФ.Отладка;
	Если (Отладка) Тогда
		Сообщить("Клиент: """+ИмяКоманды+"""");
	КонецЕсли; 
	
	// ---------------------------------------------------------------------------- 
	
	Если (ИмяКоманды = "/ОткрытьЛибоРедактировать") Тогда
		
		Возврат(ОткрытьЛибоРедактировать(УФ,Параметры,ПроцедураОбратногоВызова));
		
	// ---------------------------------------------------------------------------- 
	ИначеЕсли (ИмяКоманды = "/ОповеститьОбИзменении") Тогда
		
		Для каждого Элемент Из Параметры Цикл
			
			ОповеститьОбИзменении(Элемент);
			
		КонецЦикла; 
		// --- 
		Возврат(Неопределено);
		
	// ---------------------------------------------------------------------------- 
	ИначеЕсли (ИмяКоманды = "/ДиалогПодтвержденияНастройки") Тогда
		
		ОткрытьФорму("ОбщаяФорма.CW_ДиалогПодтвержденияНастройкиЖурнала",Новый Структура("СтруктураНастройки",Параметры.СтруктураНастройки),,Истина,,,Параметры.ПОВ,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		Возврат(Неопределено); 
		
	// ---------------------------------------------------------------------------- 
	ИначеЕсли (ИмяКоманды = "/РежимЕкселя") Тогда
		
		// проксируется на сервер
		Возврат(_УФКС.СД("Журналы","сервер",ИмяКоманды));
		
	// ---------------------------------------------------------------------------- 	
	ИначеЕсли (ИмяКоманды = "/Обновить") Тогда 
		
		// проксируется на сервер
		Возврат(_УФКС.СД("Журналы","сервер",ИмяКоманды));
		
	// ---------------------------------------------------------------------------- 
	ИначеЕсли (ИмяКоманды = "/ДиалогПодтвержденияПометкиУдаления") Тогда 
		
		Возврат(ДиалогПодтвержденияПометкиУдаления(УФ,Параметры, ПроцедураОбратногоВызова));
		
	// ---------------------------------------------------------------------------- 
	ИначеЕсли (ИмяКоманды = "/ОтборПоЗначению") Тогда 
		
		Если (НЕ УФ.Журнал_РежимНастройки) Тогда
			
			// проксируется на сервер
			Возврат(_УФКС.СД("Журналы","сервер",ИмяКоманды));	
			
		КонецЕсли; 
		
	// ---------------------------------------------------------------------------- 
	ИначеЕсли (ИмяКоманды = "/СброситьСортировку") Тогда 
		
		Если (НЕ УФ.Журнал_РежимНастройки) Тогда
			
			// проксируется на сервер
			Возврат(_УФКС.СД("Журналы","сервер",ИмяКоманды));
			
		КонецЕсли; 
		
	// ---------------------------------------------------------------------------- 
	ИначеЕсли (ИмяКоманды = "/ОтборПоСпискуЗначений") Тогда 
		
		Если (НЕ УФ.Журнал_РежимНастройки) Тогда
			
			// определяем текущую колонку
			ТекущийЭлемент = УФ.Элементы.Журнал.ТекущийЭлемент;
			Если (ТекущийЭлемент <> Неопределено) Тогда
				Если Найти(ТекущийЭлемент.Имя, "Журнал_") <> 0 Тогда
					ИмяКолонки = СтрЗаменить(ТекущийЭлемент.Имя, "Журнал_", "");
					Возврат(_УФКС.СД("Журналы","сервер","/ОтборПоСпискуЗначенийПараметрыДиалога",ИмяКолонки)); 
				Иначе
					Возврат(Неопределено);
				КонецЕсли;
			Иначе
				Возврат(Неопределено);
			КонецЕсли;
			
		КонецЕсли; 
		
	// ---------------------------------------------------------------------------- 
	ИначеЕсли (ИмяКоманды = "/ОтборПоПериоду") Тогда 
		
		Если (НЕ УФ.Журнал_РежимНастройки) Тогда
			
			Возврат(ОтборПоПериодуДиалог(УФ,Параметры, ПроцедураОбратногоВызова));
			
		КонецЕсли;  
		
	// ---------------------------------------------------------------------------- 
	ИначеЕсли (ИмяКоманды = "/Выбрать") Тогда 
		
		Возврат(Выбрать(УФ)); 
		
	// ---------------------------------------------------------------------------- 
	ИначеЕсли (ИмяКоманды = "/ОтборПоСпискуЗначенийДиалог") Тогда 
		
		Если (НЕ УФ.Журнал_РежимНастройки) Тогда
			Возврат(ОтборПоСпискуЗначенийДиалог(УФ,Параметры, ПроцедураОбратногоВызова)); 	
		КонецЕсли; 
		
	// ---------------------------------------------------------------------------- 
	ИначеЕсли (ИмяКоманды = "/ОтборКонтейнеровПоТексту") Тогда 
		
		Возврат(ОтборКонтейнеровПоТекстуДиалог(УФ,ПроцедураОбратногоВызова)); 
		
	// ---------------------------------------------------------------------------- 
	ИначеЕсли (ИмяКоманды = "/ОчиститьЗначения") Тогда 
		
		Возврат(ОчиститьЗначения_ЗадатьВопрос(УФ, ПроцедураОбратногоВызова));
		
	// ---------------------------------------------------------------------------- 
	ИначеЕсли (ИмяКоманды = "/ОтборИСортировка") Тогда 
		
		Возврат(ОтборИСортировка_Диалог(УФ, ПроцедураОбратногоВызова));
		
	// ---------------------------------------------------------------------------- 
	ИначеЕсли (ИмяКоманды = "/ОтборПоСтатусам") Тогда 
		
		Возврат(УстановитьОтборПоСтатусам(УФ,ПроцедураОбратногоВызова));
		
	// ---------------------------------------------------------------------------- 
	ИначеЕсли (ИмяКоманды = "/ОтборПоФинансовымСтатусам") Тогда 
		
		Возврат(УстановитьОтборПоФинансовымСтатусам(УФ,ПроцедураОбратногоВызова));
		
	// ---------------------------------------------------------------------------- 
	ИначеЕсли (ИмяКоманды = "/ОтключитьОтбор") Тогда 
		
		Возврат(ОтключитьОтбор(УФ));
		
	// ---------------------------------------------------------------------------- 
	ИначеЕсли (ИмяКоманды = "/СортироватьПоВозрастанию") Тогда 
		
		Возврат(СортировкаКолонки_ОпределитьНужныйПорядокПоНажатию(УФ,"Возр"));
		
	// ---------------------------------------------------------------------------- 
	ИначеЕсли (ИмяКоманды = "/СортироватьПоУбыванию") Тогда 
		
		Возврат(СортировкаКолонки_ОпределитьНужныйПорядокПоНажатию(УФ,"Убыв"));
		
	// ---------------------------------------------------------------------------- 
	ИначеЕсли (ИмяКоманды = "/Раскрасить") Тогда 
		
		Возврат(Раскрасить_Диалог(УФ, ПроцедураОбратногоВызова));
		
	// ---------------------------------------------------------------------------- 
	ИначеЕсли (ИмяКоманды = "/СуммаВыделенныхЯчеек") Тогда 
		
		Возврат(СуммаВыделенныхЯчеек(УФ));
		
	// ---------------------------------------------------------------------------- 
	ИначеЕсли (ИмяКоманды = "/СохранитьНастройку") Тогда 
		
		Возврат(СохранитьНастройку_Диалог(УФ,ПроцедураОбратногоВызова));
		
	// ---------------------------------------------------------------------------- 
	ИначеЕсли (ИмяКоманды = "/ЗагрузитьНастройку") Тогда 
		
		Возврат(ЗагрузитьНастройку_Диалог(УФ,ПроцедураОбратногоВызова));
		
	// ---------------------------------------------------------------------------- 
	ИначеЕсли (ИмяКоманды = "/УстановитьТекстСтатуснойСтроки") Тогда 
		
		 Возврат(УстановитьТекстСтатуснойСтроки(УФ));
		 
	// ---------------------------------------------------------------------------- 
	ИначеЕсли (ИмяКоманды = "/УстановитьЗаголовкиКолонок") Тогда 
		
		 Возврат(УстановитьЗаголовкиКолонок(УФ));
		 
	// ---------------------------------------------------------------------------- 
	ИначеЕсли (ИмяКоманды = "/Предупреждение") Тогда 
		
		_УФК.ВывестиПредупреждение(Параметры);
		Возврат(Неопределено);
		
	// ---------------------------------------------------------------------------- 
	ИначеЕсли (ИмяКоманды = "/НастройкаСписка") Тогда 
		
		Если (Параметры = Неопределено) Тогда
			// проксируется на сервер
			Возврат(_УФКС.СД("Журналы","сервер",ИмяКоманды));
		Иначе
			Возврат(НастройкаСписка_Диалог(УФ, Параметры,ПроцедураОбратногоВызова)); 	
		КонецЕсли; 
		
	// ---------------------------------------------------------------------------- 
	ИначеЕсли (ИмяКоманды = "/ФормированиеДокументовПоБюджету") Тогда 
		
		Возврат(СформироватьДокументыПоБюджету(УФ)); 
		
	// ---------------------------------------------------------------------------- 
	ИначеЕсли (ИмяКоманды = "/ДобавитьДинамическийПараметр") Тогда 
		
		Возврат(ДобавитьДинамическийПараметр(УФ,ПроцедураОбратногоВызова)); 
		
	// ---------------------------------------------------------------------------- 
	ИначеЕсли (ИмяКоманды = "/УдалитьДинамическийПараметр") Тогда 
		
		Возврат(УдалитьДинамическийПараметр(УФ,ПроцедураОбратногоВызова)); 
		
	// ---------------------------------------------------------------------------- 
	ИначеЕсли (ИмяКоманды = "/ПересчитатьДинамическиеПараметры") Тогда 
		
		// проксируется на сервер
		Возврат(_УФКС.СД("Журналы","сервер",ИмяКоманды));
		
	// ---------------------------------------------------------------------------- 
	ИначеЕсли (ИмяКоманды = "/ФинансовыйОтчет") Тогда 
		
		Если (Параметры = Неопределено) Тогда
			Возврат(_УФКС.СД("Журналы","сервер","/ФинансовыйОтчетПараметры"));
		Иначе
			Возврат(ФинансовыйОтчет(Параметры));
		КонецЕсли; 
		
	// ---------------------------------------------------------------------------- 
	ИначеЕсли (ИмяКоманды = "/ПодключитьГрузоперевозки") Тогда 
		
		Возврат(ПодключитьГрузоперевозки(УФ, ПроцедураОбратногоВызова)); 
		
	// ---------------------------------------------------------------------------- 
	Иначе 
		
		Сообщить("Клиент: неизвестная команда """+ИмяКоманды+"""");
		Возврат(Неопределено);
		
	КонецЕсли;
	
КонецФункции

