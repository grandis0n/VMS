&НаКлиенте
Функция УстановитьЗаголовкиКолонок(УФ) Экспорт 
	
	Для каждого СтрокаОписанияКолонки Из УФ.Журнал_ОписаниеКолонок Цикл
		
		Попытка
			ИмяКолонки = "Журнал"+"_"+СтрокаОписанияКолонки.Имя;	
		Исключение
		    Продолжить;
		КонецПопытки; 
		
		КолонкаЭлемент = УФ.Элементы.Найти(ИмяКолонки);
		
		Если (КолонкаЭлемент <> Неопределено) Тогда
			
			КолонкаЭлемент.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Авто;
			КолонкаЭлемент.Заголовок          = СтрокаОписанияКолонки.Заголовок;
			КолонкаЭлемент.ОтображатьВШапке   = Истина;
			
			Если строкаОписанияКолонки.Сортировка = УФ.Перечисления_CW_ПорядокСортировки_ПоВозрастанию Тогда
				
				КолонкаЭлемент.Заголовок     = " "+СтрокаОписанияКолонки.Заголовок; // NB! меняя только картинку, не вызываем обновления формы, приходится также трогать заголовок
				КолонкаЭлемент.КартинкаШапки = БиблиотекаКартинок.CW_СортировкаAZ;
				
			ИначеЕсли СтрокаОписанияКолонки.Сортировка = УФ.Перечисления_CW_ПорядокСортировки_ПоУбыванию Тогда 
				
				КолонкаЭлемент.Заголовок     = " "+СтрокаОписанияКолонки.Заголовок; // NB! меняя только картинку, не вызываем обновления формы, приходится также трогать заголовок
				КолонкаЭлемент.КартинкаШапки = БиблиотекаКартинок.CW_СортировкаZA;
				
			Иначе
				
				КолонкаЭлемент.КартинкаШапки = Новый Картинка;
				
			КонецЕсли; 
			
		КонецЕсли; 
		
	КонецЦикла; 
	
	Возврат(Неопределено);
	
КонецФункции

&НаКлиенте
Функция УстановитьТекстСтатуснойСтроки(УФ) Экспорт 
	
	НовыйТекстСтатуснойСтроки = "Количество: "+Формат(УФ.Журнал_КоличествоДоступныхСтрок, "ЧЦ=15; ЧДЦ=0; ЧН=; ЧГ=");
	Если УФ.Журнал_КоличествоВыделенныхСтрок > 1 Тогда
		НовыйТекстСтатуснойСтроки = НовыйТекстСтатуснойСтроки + "; выделено: "+Формат(УФ.Журнал_КоличествоВыделенныхСтрок,"ЧЦ=15; ЧДЦ=0; ЧН=; ЧГ=");
	КонецЕсли; 
	Если СокрЛП(УФ.Журнал_РасшифровкаОтбора) <> "" Тогда
		НовыйТекстСтатуснойСтроки = НовыйТекстСтатуснойСтроки + УФ.Журнал_РасшифровкаОтбора;
	КонецЕсли; 
	УФ.Журнал_ТекстСтатуснойСтроки = НовыйТекстСтатуснойСтроки;
	
	// если вызвано из формы Заказа
	Если (УФ.Объект.Свойство("Ссылка")) Тогда 
		УФ.Элементы.СтраницаЖурналГрузоперевозок.Заголовок = "Грузоперевозки ("+Формат(УФ.Журнал_КоличествоДоступныхСтрок,"ЧДЦ=; ЧН=; ЧГ=")+")";
	КонецЕсли;
	
	Возврат(Неопределено);
	
КонецФункции

