#Область ОтборСортировка 

&НаКлиенте
Функция ОтборИСортировка_Диалог(УФ, ПроцедураОбратногоВызова)
	
	АдресНастроекКомпоновщик 	= ПоместитьВоВременноеХранилище(УФ.Журнал_КомпоновщикНастроек.Настройки, УФ.УникальныйИдентификатор);
	ВыводитьАрхивные 			= ?(ЭтоФормаЗаказа(УФ) ИЛИ ЭтоФормаЗаявки(УФ), Истина, УФ.ВыводитьАрхивные);
	
	// открываем форму настройки отбора и сортировки
	ОписаниеОповещения = Новый ОписаниеОповещения("ОбработкаИзмененияОтбораИСортировки",ЭтотОбъект,Новый Структура("УФ,ПОВ",УФ,ПроцедураОбратногоВызова));
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("СхемаКомпоновки", 			УФ.Журнал_СхемаКомпоновки);	
	ПараметрыФормы.Вставить("НастройкиКомпоновщика", 	АдресНастроекКомпоновщик);	
	ПараметрыФормы.Вставить("ВыводитьАрхивные", 		ВыводитьАрхивные);	

	ОткрытьФорму("ОбщаяФорма.CW_ЖурналГрузоперевозок_НастройкаОтбора",ПараметрыФормы,,,,,ОписаниеОповещения,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецФункции

&НаКлиенте
Процедура ОбработкаИзмененияОтбораИСортировки(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ = Неопределено Тогда
		Возврат;	
	КонецЕсли;
	
	ДополнительныеПараметры.УФ.Журнал_ТекущаяНастройка = Неопределено;
	ДополнительныеПараметры.УФ.Журнал_КомпоновщикНастроек.ЗагрузитьНастройки(ПолучитьИзВременногоХранилища(Ответ.АдресНастроек));
	
	Если (НЕ ЭтоФормаЗаказа(ДополнительныеПараметры.УФ) И НЕ ЭтоФормаЗаявки(ДополнительныеПараметры.УФ)) Тогда
		ДополнительныеПараметры.УФ.ВыводитьАрхивные = Ответ.ВыводитьАрхивные;
	КонецЕсли;        
	
	Если (НЕ ДополнительныеПараметры.УФ.Журнал_РежимНастройки) Тогда
		ВыполнитьОбработкуОповещения(ДополнительныеПараметры.ПОВ,_УФКС.СД("Журналы","сервер","/ОбновитьДанныеПриИзмененииОтбора"));	
	КонецЕсли;      
	
	
КонецПроцедуры
  

&НаКлиенте
Функция ОтключитьОтбор(УФ)
	
	УФ.Журнал_ТекущаяНастройка = Неопределено;
	УФ.Журнал_КомпоновщикНастроек.Настройки.Отбор.Элементы.Очистить();
	Если (НЕ УФ.Журнал_РежимНастройки) Тогда
		Возврат(_УФКС.СД("Журналы","сервер","/ОбновитьДанныеПриИзмененииОтбора"));	
	КонецЕсли; 
	
КонецФункции

