	// --- 
	
	Если (Ответ = КодВозвратаДиалога.ОК) Тогда
		
		ДополнительныеПараметры.УФ.Записать();
		ВыполнитьОбработкуОповещения(ДополнительныеПараметры.ПОВ_ВыборГрузоперевозок);
		
	КонецЕсли; 
	
