	ПараметрыФормы.Вставить("ВидДоговора",ПредопределенноеЗначение("Перечисление.ВидыДоговоровКонтрагентов.СПокупателем"));
	ОткрытьФорму("Справочник.CW_ПлановыеСтатьиЗатратИДоходов.Форма.ФормаЗаполненияПоБюджету", ПараметрыФормы);
	Возврат(Неопределено);
	
