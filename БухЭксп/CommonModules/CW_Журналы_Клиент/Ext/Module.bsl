&НаКлиенте
Процедура ЖурналПередНачаломДобавления(УФ, Элемент, Отказ, Копирование, Родитель, Группа) Экспорт 
	
	Журнал_Данные = УФ.Журнал_Данные;
	Элементы = УФ.Элементы;
	
	Отказ = Истина;
	
	// необходимо проверить права на создание/копирование г/п
	Если (НЕ CW_Журналы_Сервер.ЕстьПравоСоздания(УФ.ИмяФормы)) Тогда
		
		_УФК.ВывестиПредупреждение("Недостаточно прав.");
		Возврат;
		
	КонецЕсли; 
	
	Если Копирование Тогда
		
		ТекущийОбъект = Журнал_Данные.НайтиПоИдентификатору(Элементы.Журнал.ТекущаяСтрока)["ссылка"];
		Если ТекущийОбъект = Неопределено Тогда
			_УФК.ВывестиПредупреждение("Не выделена грузоперевозка!",,"Предупреждение");
			Возврат;
		КонецЕсли; 
		
		ПараметрыФормы = Новый Структура("ЗначениеКопирования", ТекущийОбъект);
		ПараметрыФормы.Вставить("ОчищатьФактическиеДаты", Ложь);
		ПараметрыФормы.Вставить("НеРассчитыватьСтатусыПриЗаписи", Истина);
		Если (ЭтоФормаЖурналаГрузоперевозок(УФ) ИЛИ ЭтоФормаЗаказа(УФ) ИЛИ ЭтоФормаЗаявки(УФ)) Тогда
			ОткрытьФорму("Справочник.CW_Грузоперевозки.ФормаОбъекта", ПараметрыФормы, Элемент);
		ИначеЕсли (ЭтоФормаЖурналаЗаявок(УФ)) Тогда 
			ОткрытьФорму("Справочник.CW_Заявки.ФормаОбъекта", ПараметрыФормы, Элемент);
		ИначеЕсли (ЭтоФормаЖурналаЗаказов(УФ)) Тогда 
			ОткрытьФорму("Справочник.CW_Заказы.ФормаОбъекта", ПараметрыФормы, Элемент);
		КонецЕсли; 
		
	Иначе
		
		// создание нового
		ПараметрыФормы = Новый Структура();
		ПараметрыФормы.Вставить("НеРассчитыватьСтатусыПриЗаписи", Истина);
		
		// если вызвано из Заказа, то заполняем реквизиты по Заказу
		ссылкаЗаказ = Неопределено;
		Если (ЭтоФормаЗаявки(УФ)) Тогда
			ПараметрыФормы.Вставить("ЗначенияЗаполнения", Новый Структура("Заявка", УФ.Объект.Ссылка));
		КонецЕсли; 
		Если (ЭтоФормаЗаказа(УФ)) Тогда
			Если УФ.Объект.Свойство("Ссылка", ссылкаЗаказ) Тогда 
				// вызов из формы справочника Заказы
				Если НЕ ЗначениеЗаполнено(ссылкаЗаказ) Тогда 
					// заказ новый, либо изменён
					Отказ = Истина;
					_УФК.ВывестиПредупреждение("Заказ необходимо записать!");
					Возврат;
				КонецЕсли;
				// добавим структуру данных заполнения только ссылку на Заказ -- чтобы не переключеть лишний раз в серверный режим
				//  грузоперевозка сама возьмёт значения реквизитов в обработке заполнения
				ПараметрыФормы.Вставить("ЗначенияЗаполнения", Новый Структура("Заказ", ссылкаЗаказ));
				
			КонецЕсли;	
		КонецЕсли; 
		
		// --- 
		
		Если (ЭтоФормаЖурналаГрузоперевозок(УФ) ИЛИ ЭтоФормаЗаказа(УФ) ИЛИ ЭтоФормаЗаявки(УФ)) Тогда
			ОткрытьФорму("Справочник.CW_Грузоперевозки.ФормаОбъекта", ПараметрыФормы, Элемент);
		ИначеЕсли (ЭтоФормаЖурналаЗаявок(УФ)) Тогда 
			ОткрытьФорму("Справочник.CW_Заявки.ФормаОбъекта", ПараметрыФормы, Элемент);
		ИначеЕсли (ЭтоФормаЖурналаЗаказов(УФ)) Тогда 
			ОткрытьФорму("Справочник.CW_Заказы.ФормаОбъекта", ПараметрыФормы, Элемент);
		КонецЕсли;
		
	КонецЕсли; 
	
КонецПроцедуры

#Область ОчисткаПометкаУдаления 

&НаКлиенте
Функция ЗадатьВопросыОчиститьЛибоПометитьНаУдаление(УФ, ПроцедураОбратногоВызова) Экспорт 
	
	Журнал_СтруктураНастроек = УФ.Журнал_СтруктураНастроек;
	Элементы = УФ.Элементы;
	// --- 
	Отказ = Истина;
	РежимУдаления = Истина;
	
	Если (РежимУдаления) Тогда
		
		// помечаем выделенные на удаление
		Если Элементы.Журнал.ВыделенныеСтроки.Количество() <> 1 Тогда
			ТекстВопроса = "Изменить пометку удаления для выделенных объектов ("+Строка(Элементы.Журнал.ВыделенныеСтроки.Количество())+")?";
		Иначе
			ТекстВопроса = "Изменить пометку удаления?";
		КонецЕсли;
		ПОВ = Новый ОписаниеОповещения("ОбработкаРезультатаВопросаОбУдалении",ЭтотОбъект,Новый Структура("УФ,ПОВ",УФ,ПроцедураОбратногоВызова));
		ПоказатьВопрос(ПОВ, ТекстВопроса, РежимДиалогаВопрос.ДаНет); 
		
	КонецЕсли; 
	
КонецФункции

&НаКлиенте
Процедура ОбработкаРезультатаВопросаОбУдалении(Ответ,ДополнительныеПараметры) Экспорт 
	// --- 
	
	Если (Ответ=КодВозвратаДиалога.Да) Тогда
		
		// проверяем, что выделенные г/п не содержат бюджетов и не включены в документы
		МассивГрузоперевозок = ПолучитьМассивВыделенныхГрузоперевозок(ДополнительныеПараметры.УФ);
		ВыполнитьОбработкуОповещения(ДополнительныеПараметры.ПОВ,_УФКС.СД("Журналы","сервер","/ПроверитьВозможностьПометкиУдаления",МассивГрузоперевозок));
		
		//ВыполнитьОбработкуОповещения(ДополнительныеПараметры.ПОВ,_УФКС.СД("Журналы","сервер","/ИзменитьПометкуУдаления",МассивГрузоперевозок));
		
		
	КонецЕсли; 
	
	// --- 
КонецПроцедуры
  

#КонецОбласти 

&НаКлиенте
Процедура ЖурналПриАктивизацииЯчейки(УФ, Элемент) Экспорт 
	
	НовоеКоличествоВыделенныхСтрок = УФ.Элементы.Журнал.ВыделенныеСтроки.Количество();
	Если УФ.Журнал_КоличествоВыделенныхСтрок <> НовоеКоличествоВыделенныхСтрок Тогда
		УФ.Журнал_КоличествоВыделенныхСтрок = НовоеКоличествоВыделенныхСтрок;
		УстановитьТекстСтатуснойСтроки(УФ);
	КонецЕсли; 
			
КонецПроцедуры

&НаКлиенте
Процедура ЖурналПриАктивизацииПоля(УФ, Элемент) Экспорт 
	
	Элементы = УФ.Элементы;
	Журнал_ОписаниеКолонок = УФ.Журнал_ОписаниеКолонок;
	
	Если (Элементы.Журнал.ТекущийЭлемент = Неопределено) Тогда
		Возврат;
	КонецЕсли; 
	
	ИмяКолонки = СтрЗаменить(Элементы.Журнал.ТекущийЭлемент.Имя, "Журнал_", "");
	// --- 
	ОтборУстановлен = Ложь;
	ОтборПоПериоду = Ложь;
	СуммаДоступна = Ложь;
	Сортировка = УФ.Перечисления_CW_ПорядокСортировки_Нет;
	
	СвойстваКолонки = УФ.Журнал_СписокСвойствКолонок.НайтиПоЗначению(ИмяКолонки);
	Если (СвойстваКолонки <> Неопределено) Тогда
		
		СтрокаКолонки = Журнал_ОписаниеКолонок.НайтиПоИдентификатору(Число(СвойстваКолонки.Представление));
		Если (СтрокаКолонки <> Неопределено) Тогда
			
			Если СтрокаКолонки.УстановленОтбор Тогда
				ОтборУстановлен = Истина;
			КонецЕсли; 
			
			Если СтрокаКолонки.ТипЗначения.Типы()[0] = Тип("Дата") Тогда
				ОтборПоПериоду = Истина;
			КонецЕсли;
			
			Если СтрокаКолонки.ТипЗначения.Типы()[0] = Тип("Число") Тогда
				СуммаДоступна = Истина;
			КонецЕсли; 
			
			Сортировка = СтрокаКолонки.Сортировка; 
			
		КонецЕсли; 
		
	КонецЕсли; 
	
	Если (НЕ ЭтоФормаЗаказа(УФ) И НЕ ЭтоФормаЗаявки(УФ)) Тогда
		
		Элементы.ЖурналОтборПоЗначению.Пометка = ОтборУстановлен;
		
	КонецЕсли; 
	
	Если (НЕ ЭтоФормаЗаказа(УФ) И НЕ ЭтоФормаЗаявки(УФ)) Тогда
		
		Элементы.ЖурналОтборПоПериоду.Доступность = ОтборПоПериоду;
		
	КонецЕсли; 
	
	Элементы.ЖурналСуммаВыделенныхЯчеек.Доступность = СуммаДоступна;

	Если Сортировка=УФ.Перечисления_CW_ПорядокСортировки_Нет Тогда
		Элементы.ЖурналСортироватьПоВозрастанию.Пометка=Ложь;
		Элементы.ЖурналСортироватьПоУбыванию.Пометка=Ложь;
	ИначеЕсли Сортировка=УФ.Перечисления_CW_ПорядокСортировки_ПоВозрастанию Тогда 
		Элементы.ЖурналСортироватьПоВозрастанию.Пометка=Истина;
		Элементы.ЖурналСортироватьПоУбыванию.Пометка=Ложь;
	ИначеЕсли Сортировка=УФ.Перечисления_CW_ПорядокСортировки_ПоУбыванию Тогда 
		Элементы.ЖурналСортироватьПоВозрастанию.Пометка=Ложь;
		Элементы.ЖурналСортироватьПоУбыванию.Пометка=Истина;
	КонецЕсли; 
	
КонецПроцедуры

