Процедура ОбработкаВыбораГрузоперевозок(Грузоперевозки, ДополнительныеПараметры) Экспорт
	// --- 
	
	Если (Грузоперевозки <> Неопределено) Тогда 
		
		Если (ТипЗнч(Грузоперевозки)<>Тип("Массив")) Тогда 
			СсылкаГП = Грузоперевозки;
			масс = Новый Массив();
			масс.Добавить(СсылкаГП);
		Иначе
			масс = Грузоперевозки;
		КонецЕсли;
		// --- 
		ВыполнитьОбработкуОповещения(ДополнительныеПараметры.ПОВ,_УФКС.СД("Журналы","сервер","/ПодключитьГрузоперевозки",масс));
		
	КонецЕсли;
	
