#Область НастройкиАвторизации

Процедура СохранитьНастройкиАвторизации(НастройкаИнтеграции, Токен) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	ОбщегоНазначения.ЗаписатьДанныеВБезопасноеХранилище(НастройкаИнтеграции, Токен, ИмяТокена());
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

Функция ПрочитатьНастройкиАвторизации(НастройкаИнтеграции)
	
	УстановитьПривилегированныйРежим(Истина);
	
	Возврат ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища(НастройкаИнтеграции, ИмяТокена());
КонецФункции

Функция ИмяТокена()
	Возврат "Токен_Версия_1_4";
КонецФункции

Функция ИнтеграцияНастроена(НастройкаИнтеграции) Экспорт
	Возврат ЗначениеЗаполнено(ПрочитатьНастройкиАвторизации(НастройкаИнтеграции));
КонецФункции 

#КонецОбласти

#Область Токен

// Возвращает данные токена по настройке интеграции
//
// Параметры:
//  НастройкаИнтеграции	 - СправочникСсылка.НастройкиИнтеграцииМаркетплейс - настройка интеграции
// 
// Возвращаемое значение:
//  Структура - см. ДанныеТокена
//
Функция ДанныеТокенаПоНастройкеИнтеграции(НастройкаИнтеграции) Экспорт
	
	Токен = ПрочитатьНастройкиАвторизации(НастройкаИнтеграции);
	Возврат ДанныеТокена(Токен);
	
КонецФункции

// Возвращает информацию о токене доступа к API Wildberries
//
// Параметры:
//  Токен	 - Строка - токен API Wildberries
// 
// Возвращаемое значение:
//  Структура - 
//     * ТекстОшибки - Строка - описание ошибки токена
//     * СрокДействия - Дата - срок действия токена
//     * Категории - Массив - категории, доступные в токене
//     * КодТипаТокена - Число - код типа токена (0,1,2,3,4)
//     * ТипТокена - Строка - представление типа токена, см. функцию ТипТокена
//     * ДоступнаяФункциональность - Массив - доступные действия в программе с API Wildberries
//     * НедоступнаяФункциональность - Массив - недоступные, из-за отсутствия необходимых категорий, действия
//
Функция ДанныеТокена(Токен) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("ТекстОшибки", "");
	Результат.Вставить("СрокДействия", Дата(1, 1, 1));
	Результат.Вставить("КодТипаТокена", 0);
	Результат.Вставить("ТипТокена", "");
	Результат.Вставить("Категории", Новый Массив);
	Результат.Вставить("ДоступнаяФункциональность", Новый Массив);
	Результат.Вставить("НедоступнаяФункциональность", Новый Массив);
	
	ПараметрыТокена = ДекодироватьТокен(Токен);
	
	Если Не ПустаяСтрока(ПараметрыТокена.ТекстОшибки) Тогда
		Результат.ТекстОшибки = ПараметрыТокена.ТекстОшибки;
		Возврат Результат;
	КонецЕсли;
	
	Если ПараметрыТокена.Данные["t"] Тогда
		Результат.ТекстОшибки = НСтр("ru = 'Токен предназначен для тестового контура'");
		Возврат Результат;
	КонецЕсли;
	
	Результат.СрокДействия = МестноеВремя(Дата(1970, 1, 1) + ПараметрыТокена.Данные["exp"], "GMT"); // RFC 7519
	Если УниверсальноеВремя(ТекущаяДатаСеанса()) > Результат.СрокДействия Тогда
		Результат.ТекстОшибки = НСтр("ru = 'Срок действия токена истек'");
		Возврат Результат;
	ИначеЕсли УниверсальноеВремя(ТекущаяДатаСеанса() + ПорогИстекающегоСрокаТокена()) > Результат.СрокДействия Тогда
		КоличествоДней = Цел((Результат.СрокДействия - УниверсальноеВремя(ТекущаяДатаСеанса()))/(24*60*60));
		Результат.ТекстОшибки = СтрШаблон(НСтр("ru = 'Действует до %1 (осталось %2)'"),
			Формат(Результат.СрокДействия, "ДФ=dd.MM.yyyy"),
			ПолучитьСклоненияСтрокиПоЧислу(, КоличествоДней, "день", "ЧС=Количественное", "ПД=Винительный")[0]);
	КонецЕсли;
	
	Результат.ТипТокена = ТипТокена(ПараметрыТокена, Результат.КодТипаТокена);
	
	Результат.Категории = ДоступныеКатегории(ПараметрыТокена);
	
	ВыгрузкаОстатковТоваров = ДоступнаВыгрузкаОстатковТоваров(ПараметрыТокена);
	Если ВыгрузкаОстатковТоваров.ФункциональностьДоступна Тогда
		Результат.ДоступнаяФункциональность.Добавить(ВыгрузкаОстатковТоваров);
	Иначе
		Результат.НедоступнаяФункциональность.Добавить(ВыгрузкаОстатковТоваров);
	КонецЕсли;
	
	ЗагрузкаКаталогаТоваров = ДоступнаЗагрузкаКаталогаТоваров(ПараметрыТокена);
	Если ЗагрузкаКаталогаТоваров.ФункциональностьДоступна Тогда
		Результат.ДоступнаяФункциональность.Добавить(ЗагрузкаКаталогаТоваров);
	Иначе
		Результат.НедоступнаяФункциональность.Добавить(ЗагрузкаКаталогаТоваров);
	КонецЕсли;
	
	ЗагрузкаОтчетовОПродажах = ДоступнаЗагрузкаОтчетовОПродажах(ПараметрыТокена);
	Если ЗагрузкаОтчетовОПродажах.ФункциональностьДоступна Тогда
		Результат.ДоступнаяФункциональность.Добавить(ЗагрузкаОтчетовОПродажах);
	Иначе
		Результат.ТекстОшибки = НСтр("ru = 'Необходимо пересоздать токен доступа'");
		Результат.НедоступнаяФункциональность.Добавить(ЗагрузкаОтчетовОПродажах);
	КонецЕсли;
	
	ЗагрузкаУведомленийОВыкупе = ДоступнаЗагрузкаУведомленийОВыкупе(ПараметрыТокена);
	Если ЗагрузкаУведомленийОВыкупе.ФункциональностьДоступна Тогда
		Результат.ДоступнаяФункциональность.Добавить(ЗагрузкаУведомленийОВыкупе);
	Иначе
		Результат.ТекстОшибки = НСтр("ru = 'Необходимо пересоздать токен доступа'");
		Результат.НедоступнаяФункциональность.Добавить(ЗагрузкаУведомленийОВыкупе);
	КонецЕсли;
	
	ЗагрузкаРеестровПродажЮрлицам = ДоступнаЗагрузкаРеестровПродажЮрлицам(ПараметрыТокена);
	Если ЗагрузкаРеестровПродажЮрлицам.ФункциональностьДоступна Тогда
		Результат.ДоступнаяФункциональность.Добавить(ЗагрузкаРеестровПродажЮрлицам);
	Иначе
		Результат.НедоступнаяФункциональность.Добавить(ЗагрузкаРеестровПродажЮрлицам);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Определяет наличие состояний токенов, о которых необходимо оповестить пользователя
// 
// Возвращаемое значение:
//  Булево - результат диагностики токенов
//
Функция ЕстьПроблемыСТокенами() Экспорт
	
	Ошибки = НастройкиИнтеграцииСОшибками();
	
	Возврат ЗначениеЗаполнено(Ошибки);
	
КонецФункции

// Возвращает текст предупреждения о наличии проблем с токенами
//
// Параметры:
//  Шаблон	 - Строка - возможно использование шаблона текста
// 
// Возвращаемое значение:
//  Строка - текст предупреждения
//
Функция ТекстПроблемСТокенами(Знач Шаблон = Неопределено) Экспорт
	
	Ошибки = НастройкиИнтеграцииСОшибками();
	
	ТекстТокен = ?(Ошибки.Количество() = 1, НСтр("ru = 'токен'"), НСтр("ru = 'токены'"));
	
	Если Шаблон = Неопределено Тогда
		Шаблон = НСтр("ru = 'Проверьте %1 доступа к API Wildberries'");
	КонецЕсли;
	
	Возврат СтрШаблон(Шаблон, ТекстТокен);
	
КонецФункции

// Возвращает параметры формы с предупреждениями о состоянии токена
// 
// Возвращаемое значение:
//  Структура - 
//     * ПараметрыФормы - Структура - параметры формы
//     * ИмяФормы - Строка - имя формы
//
Функция ПараметрыОткрытияФормыПроблемСТокенами() Экспорт
	
	Ошибки = НастройкиИнтеграцииСОшибками();
	ЛимитированныеТокены = НастройкиИнтеграцииСЛимитированнымиТокенами();
	
	Результат = Новый Структура;
	
	Если Ошибки.Количество() = 0 И ЛимитированныеТокены.Количество() = 1 Тогда
		Результат.Вставить("ПараметрыФормы", Новый Структура("Ключ", ЛимитированныеТокены[0]));
		Результат.Вставить("ИмяФормы", "Справочник.НастройкиИнтеграцииМаркетплейс.Форма.ФормаЭлемента");
	ИначеЕсли Ошибки.Количество() = 1 Тогда
		Результат.Вставить("ПараметрыФормы", Новый Структура("Ключ", Ошибки[0]));
		Результат.Вставить("ИмяФормы", "Справочник.НастройкиИнтеграцииМаркетплейс.Форма.ФормаЭлемента");
	Иначе
		Результат.Вставить("ПараметрыФормы", Новый Структура("ВидМаркетплейса", Перечисления.ВидыМаркетплейсов.Wildberries));
		Результат.Вставить("ИмяФормы", "Справочник.НастройкиИнтеграцииМаркетплейс.ФормаСписка");
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Возвращает данные для отображения в динамическом списке формы Справочник.НастройкиИнтеграцииМаркетплейс.ФормаСписка
// 
// Возвращаемое значение:
//  Соответствие - 
//     * Ключ - СправочникСсылка.НастройкиИнтеграцииМаркетплейс
//     * Значение - Структура - наличие предупреждения и состояние токена
//
Функция СостоянияТокенов() Экспорт
	
	Результат = Новый Соответствие;
	
	ДанныеТокенов = ДанныеВсехТокенов();
	
	Если Не ЗначениеЗаполнено(ДанныеТокенов) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Для Каждого ДанныеТокена Из ДанныеТокенов Цикл
		СостояниеТокена = Новый Структура("ЕстьОшибка, Состояние", Ложь, "");
		Если ЗначениеЗаполнено(ДанныеТокена.Значение.ТекстОшибки) Тогда
			СостояниеТокена.ЕстьОшибка = Истина;
			СостояниеТокена.Состояние = ДанныеТокена.Значение.ТекстОшибки;
		Иначе
			СостояниеТокена.ЕстьОшибка = Ложь;
			СостояниеТокена.Состояние = СтрШаблон(НСтр("ru = '%1, действует до %2'"),
				ДанныеТокена.Значение.ТипТокена,
				Формат(ДанныеТокена.Значение.СрокДействия, "ДФ=dd.MM.yyyy"));
		КонецЕсли;
		Результат.Вставить(ДанныеТокена.Ключ, СостояниеТокена);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция НастройкиИнтеграцииСОшибками()
	
	Результат = Новый Массив;
	
	ДанныеТокенов = ДанныеВсехТокенов();
	
	Если Не ЗначениеЗаполнено(ДанныеТокенов) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Для Каждого ДанныеТокена Из ДанныеТокенов Цикл
		Если ЗначениеЗаполнено(ДанныеТокена.Значение.ТекстОшибки) Тогда
			Результат.Добавить(ДанныеТокена.Ключ);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Возвращает настройки интеграции, в которых используется токен отличный от персонального
// 
// Возвращаемое значение:
//  Массив - список настроек интеграции, которые содержат токены с сущуственными лимитами (1 раз в 24 часа) запросов
//
Функция НастройкиИнтеграцииСЛимитированнымиТокенами() Экспорт
	
	Результат = Новый Массив;
	
	ДанныеТокенов = ДанныеВсехТокенов();
	
	Если Не ЗначениеЗаполнено(ДанныеТокенов) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Для Каждого ДанныеТокена Из ДанныеТокенов Цикл
		// только персональный тип токена позволяет получать данные без существенных ограничений по времени
		Если ДанныеТокена.Значение.КодТипаТокена <> КодПерсональногоТипаТокена() Тогда
			Результат.Добавить(ДанныеТокена.Ключ);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ДанныеВсехТокенов()
	
	Результат = Новый Соответствие;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	НастройкиИнтеграцииМаркетплейс.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.НастройкиИнтеграцииМаркетплейс КАК НастройкиИнтеграцииМаркетплейс
	|ГДЕ
	|	НастройкиИнтеграцииМаркетплейс.ВидМаркетплейса = ЗНАЧЕНИЕ(Перечисление.ВидыМаркетплейсов.Wildberries)
	|	И НЕ НастройкиИнтеграцииМаркетплейс.ПометкаУдаления";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ДанныеТокена = ДанныеТокенаПоНастройкеИнтеграции(Выборка.Ссылка);
		Результат.Вставить(Выборка.Ссылка, ДанныеТокена);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ДоступныеКатегории(ПараметрыТокена)
	
	Результат = Новый Массив;
	Если ПараметрыТокена.Данные["s"] = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	КатегорииМаркетплейса = КатегорииМаркетплейса();
	Для Каждого Категория Из КатегорииМаркетплейса Цикл
		Если ПроверитьБит(ПараметрыТокена.Данные["s"], Категория.Ключ) Тогда
			Результат.Добавить(Категория.Значение);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ТипТокена(ПараметрыТокена, КодТипаТокена)
	
	ТипТокена = "";
	КодТипаТокена = 0;
	Если ПараметрыТокена.Данные.Свойство("acc", КодТипаТокена) Тогда
		Если КодТипаТокена = 1 Тогда
			ТипТокена = НСтр("ru = 'Базовый токен'");
		ИначеЕсли КодТипаТокена = 2 Тогда
			ТипТокена = НСтр("ru = 'Тестовый токен'");
		ИначеЕсли КодТипаТокена = 3 Тогда
			ТипТокена = НСтр("ru = 'Персональный токен'");
		ИначеЕсли КодТипаТокена = 4 Тогда
			ТипТокена = НСтр("ru = 'Сервисный токен'");
		КонецЕсли;
	КонецЕсли;
	
	Возврат ТипТокена;
	
КонецФункции

// Определяет является ли тип токена персональным (наивысший доступ)
//
// Параметры:
//  Токен	 - Строка - токен доступа
// 
// Возвращаемое значение:
//  Булево - результат проверки
//
Функция ИспользуетсяПерсональныйТокенДоступа(Токен) Экспорт
	
	ДанныеТокена = ДанныеТокена(Токен);
	
	Возврат ДанныеТокена.КодТипаТокена = КодПерсональногоТипаТокена();
	
КонецФункции

Функция ДоступнаВыгрузкаОстатковТоваров(ПараметрыТокена)
	
	Возврат ДоступнаФункциональность(ПараметрыТокена, НСтр("ru = 'Выгрузка остатков товаров'"), "4");
	
КонецФункции

Функция ДоступнаЗагрузкаКаталогаТоваров(ПараметрыТокена)
	
	Возврат ДоступнаФункциональность(ПараметрыТокена, НСтр("ru = 'Загрузка каталога товаров'"), "1");
	
КонецФункции

Функция ДоступнаЗагрузкаОтчетовОПродажах(ПараметрыТокена)
	
	Возврат ДоступнаФункциональность(ПараметрыТокена, НСтр("ru = 'Загрузка отчетов о продажах'"), "13");
	
КонецФункции

Функция ДоступнаЗагрузкаУведомленийОВыкупе(ПараметрыТокена)
	
	Возврат ДоступнаФункциональность(ПараметрыТокена, НСтр("ru = 'Загрузка уведомлений о выкупе'"), "12");
	
КонецФункции

Функция ДоступнаЗагрузкаРеестровПродажЮрлицам(ПараметрыТокена)
	
	Возврат ДоступнаФункциональность(ПараметрыТокена, НСтр("ru = 'Загрузка реестров продаж юрлицам'"), "12");
	
КонецФункции

Функция ДоступнаФункциональность(ПараметрыТокена, НаименованиеФункциональности, КлючиКатегорииДоступаСтрокой)
	
	КатегорииМаркетплейса = КатегорииМаркетплейса();
	
	НедоступныеКатегории = Новый Массив;
	
	Ключи = СтрРазделить(КлючиКатегорииДоступаСтрокой, ",");
	Для Каждого Ключ Из Ключи Цикл
		Если ПараметрыТокена.Данные["s"] = Неопределено
			Или Не ПроверитьБит(ПараметрыТокена.Данные["s"], Число(Ключ)) Тогда
			НедоступныеКатегории.Добавить(КатегорииМаркетплейса.Получить(Число(Ключ)));
		КонецЕсли;
	КонецЦикла;
	
	Результат = Новый Структура("Наименование, НедоступныеКатегории, ФункциональностьДоступна",
		НаименованиеФункциональности,
		НедоступныеКатегории,
		НедоступныеКатегории.Количество() = 0);
	
	Возврат Результат;
	
КонецФункции

Функция КатегорииМаркетплейса()
	
	КатегорииМаркетплейса = Новый Соответствие;
	КатегорииМаркетплейса.Вставить(1, НСтр("ru = 'Контент'"));
	КатегорииМаркетплейса.Вставить(4, НСтр("ru = 'Маркетплейс'"));
	КатегорииМаркетплейса.Вставить(12, НСтр("ru = 'Документы'"));
	КатегорииМаркетплейса.Вставить(13, НСтр("ru = 'Финансы'"));
	
	Возврат КатегорииМаркетплейса;
	
КонецФункции

Функция ДекодироватьТокен(Токен)
	
	Результат = Новый Структура("Данные, ТекстОшибки", Новый Структура, "");
	
	Если Не ЗначениеЗаполнено(Токен) Тогда
		Результат.ТекстОшибки = НСтр("ru = 'Токен не выбран'");
		Возврат Результат;
	КонецЕсли;
	
	ЭлементыТокена = СтрРазделить(Токен, ".");
	Если ЭлементыТокена.Количество() <> 3 Тогда
		Результат.ТекстОшибки = НСтр("ru = 'Токен не соответствует формату Wildberries'");
		Возврат Результат;
	КонецЕсли;
	
	Значение = СтрЗаменить(СтрЗаменить(ЭлементыТокена[1], "-", "+"), "_", "/");
	Остаток = СтрДлина(Значение) % 4;
	
	Если Остаток = 1 Тогда
		Результат.ТекстОшибки = НСтр("ru = 'Токен не соответствует формату Wildberries'");
		Возврат Результат;
	ИначеЕсли Остаток = 2 Тогда
		Значение = Значение + "==";
	ИначеЕсли Остаток = 3 Тогда
		Значение = Значение + "=";
	КонецЕсли;
	
	СтрокаJSON = ПолучитьСтрокуИзДвоичныхДанных(Base64Значение(Значение));
	
	Попытка
		Результат.Данные = ОбменСМаркетплейс.ИзJSON(СтрокаJSON);
		Если ТипЗнч(Результат.Данные) <> Тип("Структура")
			Или Не Результат.Данные.Свойство("s")
			Или Не Результат.Данные.Свойство("t")
			Или Не Результат.Данные.Свойство("acc")
			Или Не Результат.Данные.Свойство("exp") Тогда
			Результат.ТекстОшибки = НСтр("ru = 'Токен не соответствует формату Wildberries'");
		КонецЕсли;
	Исключение
		Результат.ТекстОшибки = НСтр("ru = 'Токен не соответствует формату Wildberries'");
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

