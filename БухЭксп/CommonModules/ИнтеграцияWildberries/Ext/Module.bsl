// Приостанавливает работу программы на указанное количество секунд.
//
Процедура Приостановить(Секунд)
	
	Если ОбщегоНазначения.ИнформационнаяБазаФайловая() Тогда
		
		ПараметрыЗапускаПрограммы = ФайловаяСистема.ПараметрыЗапускаПрограммы();
		ПараметрыЗапускаПрограммы.ДождатьсяЗавершения = Истина;
		ФайловаяСистема.ЗапуститьПрограмму("timeout " + Секунд, ПараметрыЗапускаПрограммы);
		
	Иначе
		
		МодульОбщегоНазначенияБТС = ОбщегоНазначения.ОбщийМодуль("ОбщегоНазначенияБТС");
		МодульОбщегоНазначенияБТС.Пауза(Секунд);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбновитьЛимитыЗапросов(ПараметрыЗапроса, АдресЗапроса, ЗаголовкиОтвета)
	
	// Количество запросов, которое можно выполнить на данный момент без пауз.
	ЗаголовокОстатокЗапросов = "X-Ratelimit-Remaining";
	
	// Если X-Ratelimit-Remaining равен 0 и вы сделали следующий запрос без задержки,
	// в ответ вы получите ошибку 429.
	Остаток = ЗаголовкиОтвета.Получить(ЗаголовокОстатокЗапросов);
	Результат = Остаток <> Неопределено И Строка(Остаток) = "0";
	
	ЛимитыЗапросов = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ПараметрыЗапроса, "ЛимитыЗапросов", Новый Соответствие);
	ЛимитыЗапросов.Вставить(АдресЗапроса, Результат);
	
КонецПроцедуры

Функция ПревышенЛимитЗапросов(ПараметрыЗапроса, АдресЗапроса)
	
	ЛимитыЗапросов = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ПараметрыЗапроса, "ЛимитыЗапросов", Новый Соответствие);
	Результат = ЛимитыЗапросов.Получить(АдресЗапроса);
	
	Возврат Результат <> Неопределено И Результат;
	
КонецФункции

Функция СообщениеОПревышенииЛимитовЗапросов(ЗаголовкиОтвета, Токен)
	
	// X-Ratelimit-Retry — через сколько секунд вы можете повторить запрос.
	// Если вы сделаете попытку раньше, вы все равно будете получать ошибку 429
	ЗаголовокПовторногоЗапроса = "X-Ratelimit-Retry";
	
	ПредложитьЗагрузкаЧерезФайлы = Ложь;
	
	Ответ = НСтр("ru = 'Превышен лимит запросов к API Wildberries. '");
	
	Значение = ЗаголовкиОтвета.Получить(ЗаголовокПовторногоЗапроса);
	Если Значение = Неопределено Или Строка(Значение) = "0" Тогда
		Ответ = Ответ + НСтр("ru = 'Повторите позже. '");
	Иначе
		Остаток = СтроковыеФункцииКлиентСервер.СтрокаВЧисло(Значение);
		Если Остаток = Неопределено Тогда
			Ответ = Ответ + НСтр("ru = 'Повторите позже. '");
		ИначеЕсли Остаток < 59 * 60 Тогда
			КоличествоМинут = Цел(Остаток / 60) + 1;
			ПредставлениеМинут = НСтр("ru = ';%1 минуту;;%1 минуты;%1 минут;%1 минуты'");
			Ответ = Ответ + СтрШаблон(НСтр("ru = 'Повторите попытку через %1. '"),
				СтроковыеФункцииКлиентСервер.СтрокаСЧисломДляЛюбогоЯзыка(ПредставлениеМинут, КоличествоМинут));
			ПредложитьЗагрузкаЧерезФайлы = КоличествоМинут > 1;
		Иначе
			КоличествоЧасов = Цел(Остаток / (60 * 60)) + 1;
			ПредставлениеЧасов = НСтр("ru = ';%1 час;;%1 часа;%1 часов;%1 часа'");
			Ответ = Ответ + СтрШаблон(НСтр("ru = 'Повторите попытку через %1. '"),
				СтроковыеФункцииКлиентСервер.СтрокаСЧисломДляЛюбогоЯзыка(ПредставлениеЧасов, КоличествоЧасов));
			ПредложитьЗагрузкаЧерезФайлы = Истина;
		КонецЕсли;
	КонецЕсли;
	
	ИспользуетсяПерсональныйТокен = ИспользуетсяПерсональныйТокенДоступа(Токен);
	Если Не ИспользуетсяПерсональныйТокен Тогда
		Ответ = Ответ + Символы.ПС + НСтр("ru = 'Обратите внимание, что для Базового токена действуют строгие лимиты на количество запросов в сутки. '");
	КонецЕсли;
	Если ПредложитьЗагрузкаЧерезФайлы Тогда
		Ответ = Ответ + НСтр("ru = 'В качестве альтернативы вы можете загрузить отчеты с помощью файлов.'");
	КонецЕсли;
	
	ОбменСМаркетплейс.ЗарегистрироватьОшибкуОбмена(Ответ, Перечисления.ВидыМаркетплейсов.Wildberries);
	
	Возврат Ответ;
	
КонецФункции

