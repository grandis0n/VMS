Функция ИерархияЭлементовСправочникаОКПД2(Знач КодОКПД2) Экспорт
	
	ДоступныеОКПД2 = Новый Массив;
	
	Пока КодОКПД2 <> "" Цикл
		ДоступныеОКПД2.Добавить(КодОКПД2);
		ПозицияТочки = СтрНайти(КодОКПД2, ".", НаправлениеПоиска.СКонца);
		КодОКПД2 = ?(ПозицияТочки > 0, Лев(КодОКПД2, ПозицияТочки - 1), "");
	КонецЦикла;
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Код", ДоступныеОКПД2);
	Запрос.Текст = "ВЫБРАТЬ Ссылка Из Справочник.КлассификаторОКПД2 ГДЕ Код В (&Код)";
	СсылкиОКПД2 = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	СсылкиОКПД2.Добавить(Справочники.КлассификаторОКПД2.ПустаяСсылка());
	
	Возврат СсылкиОКПД2;
	
КонецФункции

// Получает ТН ВЭД
//
// Параметры:
//  КодТНВЭД - Строка - Код по классификатору товарной номенклатуры внешнеэкономической деятельности
//
// Возвращаемое значение:
//   Произвольный - элемент классификатора (если он определен в конфигурации)
//
Функция КлассификаторТНВЭДПоКоду(КодТНВЭД) Экспорт
	
	ТНВЭД = Неопределено;
	
	КлассификаторТНВЭД(КодТНВЭД, ТНВЭД);
	
	Возврат ТНВЭД;
	
КонецФункции

//Получение ссылки ТН ВЭД по коду.
//
//Параметры:
//  КодТНВЭД - Строка - Код по классификатору товарной номенклатуры внешнеэкономической деятельности.
//  ТНВЭД - Произвольный - искомый элемент.
//
Процедура КлассификаторТНВЭД(КодТНВЭД, ТНВЭД) Экспорт
	
	ТНВЭД = Справочники.КлассификаторТНВЭД.НайтиПоКоду(КодТНВЭД);
	
КонецПроцедуры

Процедура ЗаполнитьКодЕдиницыИзмеренияВТаблицеТоваров(ТаблицаТоваров)
	
	Если ТаблицаТоваров.Колонки.Найти("ЕдиницаИзмеренияКод") = Неопределено Тогда
		ТаблицаТоваров.Колонки.Добавить("ЕдиницаИзмеренияКод", ОбщегоНазначения.ОписаниеТипаСтрока(5));
	КонецЕсли;
	
	Для Каждого СтрокаТовары Из ТаблицаТоваров Цикл
		Если ЗначениеЗаполнено(СтрокаТовары.Номенклатура) Тогда
			СтрокаТовары.ЕдиницаИзмеренияКод = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаТовары.Номенклатура.ЕдиницаИзмерения, "Код");
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

