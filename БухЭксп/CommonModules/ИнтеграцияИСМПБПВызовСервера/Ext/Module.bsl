//Если единица штучная(Экономическая, безразмерная) тогда Истина иначе Ложь
//Параметры: ЕдиницаИзмерения Тип("СправочникСсылка.КлассификаторЕдиницИзмерения")
//
//Возвращаемое значение: ШтучнаяЕдиница тип("Булево")
//
Функция ЭтоШтучнаяЕдиница(ЕдиницаИзмерения) Экспорт
	
	ШтучнаяЕдиница = Ложь;
	
	СтрокаКодовШтучныхЕдиниц 	= "715, 778, 780, 781, 796, 797, 798, 799, 800";
	КодЕдиницы 					= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЕдиницаИзмерения, "Код");
	Если СтрНайти(СтрокаКодовШтучныхЕдиниц, КодЕдиницы) > 0 Тогда
		ШтучнаяЕдиница = Истина;
	КонецЕсли;	
	
	Возврат ШтучнаяЕдиница;
	
КонецФункции

//Если единица мерная(Вес, объем, длина) тогда Истина иначе Ложь
//Параметры: ЕдиницаИзмерения Тип("СправочникСсылка.КлассификаторЕдиницИзмерения")
//
//Возвращаемое значение: МернаяЕдиница тип("Булево")
//
Функция ЭтоМернаяЕдиница(ЕдиницаИзмерения) Экспорт
	
	МернаяЕдиница = Ложь;
	
	СтрокаКодовМерныхЕдиниц = "
	|003, 004, 005, 006, 008, 009, 018, 039, 041, 043, 047,
	|110, 111, 112, 113, 116, 118, 122, 126, 131, 132, 133, 159,
	|160, 161, 162, 163, 164, 166, 168, 170, 173, 181, 185";
	
	КодЕдиницы = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЕдиницаИзмерения, "Код");
	Если СтрНайти(СтрокаКодовМерныхЕдиниц, КодЕдиницы) > 0 Тогда
		МернаяЕдиница = Истина;
	КонецЕсли;	
	
	Возврат МернаяЕдиница;

КонецФункции

