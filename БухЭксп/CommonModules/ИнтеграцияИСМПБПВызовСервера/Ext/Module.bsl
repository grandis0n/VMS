//Проверяет что номенклатура это алкогольгаяпродукция( не пиво)
//Параметры: -Номенклатура Тип("СправочникСсылка.Номенлатура")
//
//Возвращаемое значение: ЭтоАлкоголь Тип("Булево")
//
Функция ЭтоАлкогольнаяПродукция(Номенклатура) Экспорт
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ОписаниеНоменклатурыИС.КлючВидовПродукции КАК ВидПродукции
	|ИЗ
	|	РегистрСведений.ОписаниеНоменклатурыИС КАК ОписаниеНоменклатурыИС
	|ГДЕ
	|	ОписаниеНоменклатурыИС.Номенклатура = &Номенклатура
	|	И ОписаниеНоменклатурыИС.КлючВидовПродукции.ВидПродукцииЕГАИС <> ЗНАЧЕНИЕ(Справочник.ВидыПродукцииИС.ПустаяСсылка)";
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	
	РезультатВыполненияЗапроса = Запрос.Выполнить();
	
	Возврат Не РезультатВыполненияЗапроса.Пустой();
		
КонецФункции

