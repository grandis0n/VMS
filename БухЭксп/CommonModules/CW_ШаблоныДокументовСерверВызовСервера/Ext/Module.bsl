Функция ПолучитьИсходныеРазмерыКартинкиXML(ТабличныйДокумент, ИмяКартикни) Экспорт
	
	РазмерыРиснука = Неопределено;
	РазмерыКартинокШаблонов = CW_ШаблоныДокументовСерверВызовСервера.ПолучитьРазмерыКартинок(); 
	Если РазмерыКартинокШаблонов <> Неопределено Тогда
		РазмерыКартинокШаблонов.Свойство(ИмяКартикни, РазмерыРиснука);
	КонецЕсли;
	
	Если РазмерыРиснука <> Неопределено Тогда 
		Возврат РазмерыРиснука;
	КонецЕсли; 
	
	//Считаем исходными текущие данные картикни
	Рисунок = CW_ШаблоныДокументовСерверВызовСервера.СуществуетКартикаМакета(ТабличныйДокумент, ИмяКартикни);	
	
	РазмерыРиснука = Новый Структура;     
	
	Если Рисунок <> Неопределено Тогда
		РазмерыРиснука.Вставить("Ширина", Рисунок.Ширина);
		РазмерыРиснука.Вставить("Высота", Рисунок.Высота);
	КонецЕсли;
	
	Возврат РазмерыРиснука;
	
КонецФункции

Функция ПолучитьСхемуКомпоновкиДанных(Знач ТипЗначенияОбъекта) Экспорт
	
	ИдентификаторОбъектаМетаданных = ОбщегоНазначения.ИдентификаторОбъектаМетаданных(ТипЗначенияОбъекта);
	
	Схема = Справочники.CW_МакросыШаблоновДокументов.ПолучитьМакет("МакетРеквизитов");  
	НаборДанных = Схема.НаборыДанных.Получить(0);
	НаборДанных.Запрос = СтрЗаменить(НаборДанных.Запрос, "//ПолноеИмя", ИдентификаторОбъектаМетаданных.ПолноеИмя); 
	НаборДанных.Запрос = СтрЗаменить(НаборДанных.Запрос, "//Имя", 	    ИдентификаторОбъектаМетаданных.Имя);  
	
	ПолеСсылка = НаборДанных.Поля[0];
	ПолеСсылка.Заголовок = ИдентификаторОбъектаМетаданных.Синоним;
	
	Возврат Схема;

КонецФункции 

