//Обязательные процедуры при переходе на каждый релиз
Процедура УдалитьУстановленныеРасширения(АдресРезультата=Неопределено) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);   
	
	ИмяОсновнойПодсистемы 	= CW_ВерсииПодсистемСервер.ИмяОсновнойПодсистемы();
	ОписаниеПодсистем 		= Новый Структура;
	CW_ОбновлениеКонфигурацииСервер.ПриДобавленииПодсистем(ОписаниеПодсистем); 
	
	ТекущаяВерсия 		= Неопределено;
	ОписаниеПодсистем.Свойство(ИмяОсновнойПодсистемы, ТекущаяВерсия); 
	Если ТекущаяВерсия = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ВсеРасширения = РасширенияКонфигурации.Получить();
	
	ИдентификаторыРасширений = Новый Массив;
	Для Каждого Расширение Из ВсеРасширения Цикл
		Если Не CW_ИсправленияКонфигурации.ЭтоИсправление(Расширение)Тогда
			Продолжить;
		КонецЕсли;
		Если Не CW_ИсправленияКонфигурации.ЭтоУдаляемоеИсправление(Расширение, ТекущаяВерсия)Тогда
			Продолжить;
		КонецЕсли;
		
		ИдентификаторыРасширений.Добавить(Расширение.УникальныйИдентификатор);
	КонецЦикла;
	
	ТекстОшибки = "";
	Справочники.ВерсииРасширений.УдалитьРасширения(ИдентификаторыРасширений, ТекстОшибки);
	УстановитьПривилегированныйРежим(Ложь);
	ТребуетсяПерезапуск = Ложь;
	
	Если ПустаяСтрока(ТекстОшибки) Тогда
		ТребуетсяПерезапуск = ИдентификаторыРасширений.Количество() > 0;
	КонецЕсли;
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("ТребуетсяПерезапуск", ТребуетсяПерезапуск);
	
	ПоместитьВоВременноеХранилище(СтруктураПараметров, АдресРезультата);
	
КонецПроцедуры
