Процедура ВыполнитьОтложенноеОбновление() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	CW_ОбработчикиОбновления.ИмяОбработчика КАК ИмяОбработчика,
	               |	CW_ОбработчикиОбновления.ИмяПодсистемы КАК ИмяПодсистемы,
	               |	CW_ОбработчикиОбновления.НачальноеЗаполнение КАК НачальноеЗаполнение,
	               |	CW_ОбработчикиОбновления.ПриКаждомОбновлении КАК ПриКаждомОбновлении,
	               |	CW_ОбработчикиОбновления.ОчередьВыполнения КАК ОчередьВыполнения,
	               |	CW_ОбработчикиОбновления.Версия КАК Версия,
	               |	0 КАК Разряд_1,
	               |	0 КАК Разряд_2,
	               |	0 КАК Разряд_3,
	               |	0 КАК Разряд_4
	               |ИЗ
	               |	РегистрСведений.CW_ОбработчикиОбновления КАК CW_ОбработчикиОбновления
	               |ГДЕ
	               |	CW_ОбработчикиОбновления.Статус = ЗНАЧЕНИЕ(Перечисление.CW_СтатусыОбработчиковОбновления.НеВыполнялся)
	               |	И CW_ОбработчикиОбновления.РежимВыполнения = ЗНАЧЕНИЕ(Перечисление.CW_РежимыВыполненияОбработчиков.Отложенно)
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	CW_ОбработчикиОбновления.НачальноеЗаполнение УБЫВ,
	               |	CW_ОбработчикиОбновления.ОчередьВыполнения
	               |АВТОУПОРЯДОЧИВАНИЕ";

	РезультатЗапроса = Запрос.Выполнить(); 
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	ТаблицаЗапроса = РезультатЗапроса.Выгрузить();
	
	Для Каждого СтрокаТаблицы из ТаблицаЗапроса Цикл  
		
		Если СтрокаТаблицы.Версия = "*" тогда
			Продолжить;
		КонецЕсли;
		
		мРазряды = СтрРазделить(СтрокаТаблицы.Версия, ".");
		
		СтрокаТаблицы.Разряд_1 = Число(мРазряды[0]);	
		СтрокаТаблицы.Разряд_2 = Число(мРазряды[1]);	
		СтрокаТаблицы.Разряд_3 = Число(мРазряды[2]);	
		СтрокаТаблицы.Разряд_4 = Число(мРазряды[3]);	

	КонецЦикла;   
	
	ТаблицаЗапроса.Сортировать("Версия ВОЗР, Разряд_1 ВОЗР, Разряд_2 ВОЗР, Разряд_3 ВОЗР, Разряд_4 ВОЗР, НачальноеЗаполнение УБЫВ, ПриКаждомОбновлении УБЫВ, ОчередьВыполнения ВОЗР");	
	
	Для Каждого СтрокаТаблицы из ТаблицаЗапроса Цикл     
		РезульатВыполнения = ВыполнитьЗаданиеНаСервере(СтрокаТаблицы.ИмяОбработчика);  
	КонецЦикла;  
	
	//После выполнения отключаем задение
	CW_ОбновлениеКонфигурацииСервер.УстановитьИспользованиеОтложенногоВыпоненияОбработок();
	
КонецПроцедуры

Функция ВыполнитьЗаданиеНаСервере(ИмяОбработчика) Экспорт
	
	Возврат CW_ОбновлениеКонфигурацииСервер.ВыполнитьЗаданиеНаСервере(ИмяОбработчика);
	
КонецФункции   

