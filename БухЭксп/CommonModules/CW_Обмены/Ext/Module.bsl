// запуск регламентного задания выгрузки
Процедура РегламентнаяВыгрузка(Обмен,Параметры) Экспорт 
	// --- 
	
	Отладка = Ложь;
	
	Попытка
		
		Если Отладка Тогда
			
			Таймер = _сф.Таймер_Старт();
			
		КонецЕсли; 
		
		// В регламентном задании в разделе "параметры" должны быть прописаны два поля: обмен и параметры (sic!)? параметры - произвольная структура
		ОбработкаОбъект = _ПО.ПолучитьОбработку(Обмен.Обработка);	
		// регламентный вызов из внешней обработки
		Ответ = ОбработкаОбъект.РегламентныйВызовВыгрузки(Обмен,Параметры);
		
		Если Ответ.Код = 0 Тогда
			
			Если Отладка Тогда
				
				_сф.Таймер_Стоп(Таймер);
				CW_Журнал.ОтладочноеСообщение("Обмен.Общие","Выгрузка по обмену """+Строка(Обмен)+""" выполнена за "+_сф.Таймер_Представление(Таймер)+".");
				
			КонецЕсли; 
			
		КонецЕсли; 
		
				
	Исключение
		
		// регистрируем ошибку
		CW_Журнал.ЗаписатьСообщение("Обмен.Общие","error","Вызов регламентной выгрузки:"+Символы.ПС+"Обмен="+Строка(Обмен)+Символы.ПС+ОписаниеОшибки());
		
	КонецПопытки; 
		
	// --- 
КонецПроцедуры

