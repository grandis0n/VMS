Функция ОбъектРегистрируется(Объект) Экспорт 
	// --- 
	
	МС = CW_Обмены_ПИ.МетаданноеКонфигурации(Объект.Метаданные().ПолноеИмя());	
	Возврат(CW_Обмены_ПИ.МетаданноеРегистрируется(МС)); 
	
	// --- 
КонецФункции

