Функция ЗаписатьСоответствиеВРегистр(ПараметрыЗагрузки,СинхроСтрока) Экспорт 
	
	Попытка
		
		// удаление существующей записи(ей)
		Набор = РегистрыСведений.CW_СинхронизацияОбъектов.СоздатьНаборЗаписей();
		Если ПараметрыЗагрузки.ИспользуетсяUID Тогда
			Набор.Отбор.Источник_УИД.Значение = СинхроСтрока.Источник_УИД;
			Набор.Отбор.Источник_УИД.Использование = Истина;
		Иначе
			Набор.Отбор.Источник_СИ.Значение = СинхроСтрока.Источник_СИ;
			Набор.Отбор.Источник_СИ.Использование = Истина;
		КонецЕсли; 
		Набор.Отбор.Источник_Идентификатор.Значение = ПараметрыЗагрузки.Обмен;
		Набор.Отбор.Источник_Идентификатор.Использование = Истина;
		
		Набор.Записать(Истина);
		Набор.Очистить();
		
		// --- 
		
		Запись = РегистрыСведений.CW_СинхронизацияОбъектов.СоздатьМенеджерЗаписи();
		
		Запись.Источник_Тип				= СинхроСтрока.Источник_Тип;
		Запись.Источник_УИД				= СинхроСтрока.Источник_УИД;
		Запись.Источник_СИ				= СинхроСтрока.Источник_СИ;
		Запись.Приемник_Объект			= СинхроСтрока.Приемник_Объект;
		Если (Синхрострока.Синхронизировано И НЕ СинхроСтрока.СозданиеНового) Тогда
			Запись.Приемник_УИД				= СинхроСтрока.Приемник_Объект.УникальныйИдентификатор();
			Запись.флНезавершена		= Ложь;
		Иначе
			Запись.Приемник_УИД				= СинхроСтрока.Приемник_УИД;	
		КонецЕсли; 
		Запись.Источник_Наименование	= СинхроСтрока.Источник_Наименование;
		Запись.Источник_Идентификатор	= ПараметрыЗагрузки.Обмен;
		
		Если Запись.Приемник_УИД = ПолучитьУИД(Неопределено) Тогда
			
			Запись.флНезавершена = Истина;
			
		КонецЕсли;
		
		Запись.Записать();
		
		Возврат(_УФКС.Ответ());
		
	Исключение
		
		Возврат(_УФКС.Ответ(1,ОписаниеОшибки()));
		
	КонецПопытки;
	
КонецФункции

Функция ПолучитьУИД(Строка) Экспорт 
	// --- 
	
	ПустойУИД = "00000000-0000-0000-0000-000000000000";
	
	Если Строка = Неопределено Тогда
		
		Возврат(Новый УникальныйИдентификатор(ПустойУИД));
		
	КонецЕсли; 
	Если Строка = "Неопределено" Тогда
		
		Возврат(Новый УникальныйИдентификатор(ПустойУИД));
		
	КонецЕсли; 
	
	Возврат(Новый УникальныйИдентификатор(Строка));
	
	// --- 
КонецФункции

