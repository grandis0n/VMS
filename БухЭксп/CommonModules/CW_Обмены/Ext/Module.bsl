Процедура ЗаписатьПараметрыРегистрации(Объект,СтруктураПараметровРегистрации,Отказ) Экспорт 
	// --- 
	
	СП = СтруктураПараметровРегистрации;
	
	// грохаем то, что уже есть по комбинации обмен-объект
	// --- 
	НЗ = РегистрыСведений.CW_ТаблицаРегистрацииИзменений.СоздатьНаборЗаписей();
	// --- 
	НЗ.Отбор.Обмен.Значение = СП.Обмен;
	НЗ.Отбор.Обмен.Использование = Истина;
	НЗ.Отбор.Объект.Значение = Объект.Ссылка;
	НЗ.Отбор.Объект.Использование = Истина;
	Если _сф.ст_ПолучитьСвойство(СП,"Объект") <> Неопределено Тогда
		НЗ.Отбор.Объект.Значение = _сф.ст_ПолучитьСвойство(СП,"Объект");
	КонецЕсли; 
	// --- 
	НЗ.Прочитать();
	// --- 
	// смотрим, не было ли у зарегистрированных объектов отметки новых
	ТО = _сф.т_Создать("Обмен,Объект,ЭтоНовый");
	Для каждого Стр Из НЗ Цикл
		
		Если Стр.ПризнакСозданияОбъекта Тогда
			
			Нстр = ТО.Добавить();
			Нстр.Обмен = Стр.Обмен;
			Нстр.Объект = Стр.Объект;
			// --- 
			Нстр.ЭтоНовый = Стр.ПризнакСозданияОбъекта;
			
		КонецЕсли; 
		
	КонецЦикла; 
	
	// --- 
	НЗ.Очистить();
	НЗ.Записать(Истина);
	
	// формируем записи
	Для каждого СтруктураЗаписи Из СП.МассивЗаписей Цикл
		
		Запись = РегистрыСведений.CW_ТаблицаРегистрацииИзменений.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(Запись,СтруктураЗаписи);
		Если СтруктураЗаписи.Объект = Неопределено Тогда
			
			Запись.Объект = Объект.Ссылка;
			
		Иначе
			
			Если НЕ ЗначениеЗаполнено(СтруктураЗаписи.Объект) Тогда
				
				Запись.Объект = Объект.Ссылка;
				
			КонецЕсли; 
			
		КонецЕсли; 
		// проверяем, что объект не новый
		Запись.ПризнакСозданияОбъекта = СтруктураЗаписи.ЭтоНовый;
		СтрокаТО = _сф.к_НайтиСтроку(ТО,Новый Структура("Обмен,Объект",Запись.Обмен,Запись.Объект));
		Если СтрокаТО <> Неопределено Тогда
			
			Запись.ПризнакСозданияОбъекта = Истина;
			
		КонецЕсли; 
		// --- 
		Запись.Записать(Истина);
		
	КонецЦикла; 
		
	// --- 
КонецПроцедуры

// ---------------------------------------------------------------------------- 

Процедура УстановитьСтатусОбъекта(Обмен,ПараметрыОбъекта,Статус=Неопределено,СообщениеСсылка=Неопределено) Экспорт 
	// --- 
	
	// получаем запись 
	НЗ = РегистрыСведений.CW_ТаблицаРегистрацииИзменений.СоздатьНаборЗаписей();
	_сф.УстановитьОтбор(НЗ.Отбор,"Обмен",Обмен);
	_сф.УстановитьОтбор(НЗ.Отбор,"Объект",ПараметрыОбъекта.Объект);
	НЗ.Прочитать();
	
	// меняем статус
	
	Запись = _сф.к_ПервыйЭлемент(НЗ);
	Если (Статус <> Неопределено) Тогда
		Запись.Статус = Статус;
		Запись.ОшибкаВыгрузки = Ложь;
	Иначе
		Запись.ОшибкаВыгрузки = Истина;
	КонецЕсли; 
	
	Если (СообщениеСсылка <> Неопределено) Тогда
		Запись.ОписаниеОшибки = СообщениеСсылка;
	КонецЕсли;
	
	Если Статус = Перечисления.CW_СтатусыВыгрузки.Выгружен Тогда
		
		Запись.ПризнакСозданияОбъекта = Ложь;
		
	КонецЕсли; 
	
	// --- 
	
	НЗ.Записать(Истина);
	
	// --- 
КонецПроцедуры
// --- 
Процедура УдалитьРегистрациюОбъекта(Обмен,ПараметрыОбъекта) Экспорт 
	
	// получаем запись 
	НЗ = РегистрыСведений.CW_ТаблицаРегистрацииИзменений.СоздатьНаборЗаписей();
	_сф.УстановитьОтбор(НЗ.Отбор,"Обмен",Обмен);
	_сф.УстановитьОтбор(НЗ.Отбор,"Объект",ПараметрыОбъекта.Объект);
	НЗ.Прочитать();
	
	Запись = _сф.к_ПервыйЭлемент(НЗ);
	Если (Запись.Статус = Перечисления.CW_СтатусыВыгрузки.Выгружен) Тогда
		
		НЗ.Очистить();
		
	КонецЕсли; 
	
	// --- 
	
	НЗ.Записать(Истина);
	
	
КонецПроцедуры

