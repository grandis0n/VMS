Функция СтруктураЗаписиТаблицыРегистрации(Объект,СО) Экспорт 
	// --- 
	
	СЗ = _сф.ст_Создать("Обмен,Метаданное,Объект,ЭтоНовый,ДатаИзменения,РежимЗаписи,Статус");
	СЗ.Обмен 			= СО.Обмен;
	СЗ.Метаданное 		= СО.Метаданное;
	СЗ.Объект			= Объект.Ссылка;
	СЗ.ЭтоНовый			= _сф.ст_ПолучитьСвойство(СО,"ЭтоНовый");
	Если СЗ.ЭтоНовый = Неопределено Тогда
		
		СЗ.ЭтоНовый  = Ложь;
		
	КонецЕсли; 
	СЗ.ДатаИзменения 	= СО.ДатаИзменения;
	СЗ.РежимЗаписи		= СО.РежимЗаписи;
	СЗ.Статус			= Перечисления.CW_СтатусыВыгрузки.Зарегистрирован;
	
	Возврат(СЗ);
	
	// --- 
КонецФункции

Функция РежимЗаписиОбъекта(Объект,ПараметрыРегистрации,Режим=Неопределено) Экспорт 
	
	Если Найти(ПараметрыРегистрации.Метаданное.Наименование,"Справочник.") <> 0 Тогда
		// справочники
		Если Объект.ПометкаУдаления Тогда
			Возврат Перечисления.CW_РежимыЗаписи.ПометкаУдаления;
		Иначе
			Возврат Перечисления.CW_РежимыЗаписи.Запись;
		КонецЕсли; 
		
	ИначеЕсли Найти(ПараметрыРегистрации.Метаданное.Наименование,"Документ.") <> 0 Тогда 
		// документы
		Если Объект.ПометкаУдаления Тогда
			Возврат Перечисления.CW_РежимыЗаписи.ПометкаУдаления;
			
		ИначеЕсли Режим = РежимЗаписиДокумента.Проведение Тогда
			Возврат Перечисления.CW_РежимыЗаписи.Проведение;
			
		ИначеЕсли Режим = РежимЗаписиДокумента.ОтменаПроведения Тогда 
			Возврат Перечисления.CW_РежимыЗаписи.ОтменаПроведения;
			
		ИначеЕсли Режим = РежимЗаписиДокумента.Запись Тогда 
			Возврат Перечисления.CW_РежимыЗаписи.Запись;
			
		Иначе
			Возврат Перечисления.CW_РежимыЗаписи.Запись;
			
		КонецЕсли;		 
		
	КонецЕсли; 
	
КонецФункции

