Функция ИдентификаторДляВнешнейБД(Обмен,Объект) Экспорт 
	// --- 
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	CW_ИдентификаторыОбъектовДляВнешнихБД.Идентификатор
	|ИЗ
	|	РегистрСведений.CW_ИдентификаторыОбъектовДляВнешнихБД КАК CW_ИдентификаторыОбъектовДляВнешнихБД
	|ГДЕ
	|	CW_ИдентификаторыОбъектовДляВнешнихБД.Обмен = &Обмен
	|	И CW_ИдентификаторыОбъектовДляВнешнихБД.Объект = &Объект";
	Запрос.УстановитьПараметр("Обмен", Обмен);
	Запрос.УстановитьПараметр("Объект", Объект); 
	ТЗ = Запрос.Выполнить().Выгрузить();
	
	Если ТЗ.Количество() = 0 Тогда
		
		Возврат(Неопределено);
		
	Иначе
		
		ИД = _сф.к_ПервыйЭлемент(ТЗ).Идентификатор;
		
		Если СокрЛП(ИД) = "" Тогда
			
			Возврат(Неопределено);
			
		Иначе
			
			Возврат(ИД);
			
		КонецЕсли; 
		
	КонецЕсли; 
	
	// --- 
КонецФункции

Функция УстановитьИдентификаторДляВнешнейБД(СО,Объект,Идентификатор,ИдентификаторСинхронизации=Неопределено,Дата=Неопределено,Номер=Неопределено) Экспорт 
	// --- 
	
	Попытка
		
		Запись = РегистрыСведений.CW_СинхронизацияОбъектов.СоздатьМенеджерЗаписи();
		// --- 
		Запись.Источник_Идентификатор = СО.Обмен;
		Запись.Источник_СИ = ?(ИдентификаторСинхронизации=Неопределено,Идентификатор,ИдентификаторСинхронизации);
		Запись.Приемник_Объект = Объект;
		Запись.Приемник_УИД = Объект.УникальныйИдентификатор();
		// --- 
		Запись.Источник_Наименование = Строка(Объект);
		Запись.Источник_Тип = Строка(СО.Метаданное);
		Запись.ПолитикаСинхронизации = Перечисления.CW_ПолитикаСинхронизацииОбъектов.Первичная;
		// --- 
		Запись.Записать(Истина);
		
		// ---------------------------------------------------------------------------- 
		
		Запись = РегистрыСведений.CW_ИдентификаторыОбъектовДляВнешнихБД.СоздатьМенеджерЗаписи();
		Запись.Обмен = СО.Обмен;
		Запись.Метаданное = СО.Метаданное;
		Запись.Объект = Объект;
		Запись.Идентификатор = Идентификатор;
		// --- 
		Запись.Дата = ?(Дата=Неопределено,ТекущаяДата(),Дата);
		Запись.Номер = ?(Номер=Неопределено,0,Номер); 
		// --- 
		Запись.Записать(Истина);
		
		// ---------------------------------------------------------------------------- 
		
		Возврат(_УФКС.Ответ());
		
	Исключение
		
		Возврат(_УФКС.Ответ(1));
		
	КонецПопытки; 
	
	
	
	
	// --- 
КонецФункции

// --- 

Функция ИнкрементСчетчика(Счетчик) Экспорт 
	// --- 
	
	НЗ = РегистрыСведений.CW_Счетчики.СоздатьНаборЗаписей();
	_сф.УстановитьОтбор(НЗ.Отбор,"Счетчик",Счетчик);
	НЗ.Прочитать();
	
	Если НЗ.Количество() = 0 Тогда
		
		// неинициализированный счетчик
		НовоеЗначение = 1;
		// --- 
		Запись = НЗ.Добавить();
		Запись.Счетчик = Счетчик;
		Запись.Значение = НовоеЗначение;
		НЗ.Записать(Истина);
		
	Иначе
		
		Запись = _сф.к_ПервыйЭлемент(НЗ);
		НовоеЗначение = Запись.Значение+1;
		Запись.Значение = НовоеЗначение;
		НЗ.Записать(Истина);
		
	КонецЕсли; 
	
	Возврат(НовоеЗначение);
	
	// --- 
КонецФункции
  
