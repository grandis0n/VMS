		|
		|СГРУППИРОВАТЬ ПО
		|	CW_ДоходыПоГрузоперевозкамОбороты.Контрагент,
		|	CW_ДоходыПоГрузоперевозкамОбороты.Валюта,
		|	CW_ДоходыПоГрузоперевозкамОбороты.ДокументДоходов.Организация
		|;
		|";
		
	Иначе
		
		Запрос.Текст = Запрос.Текст + Символы.ПС + 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	CW_РасходыПоГрузоперевозкамОбороты.Контрагент КАК Клиент,
		|	CW_РасходыПоГрузоперевозкамОбороты.Валюта,
		|	СУММА(CW_РасходыПоГрузоперевозкамОбороты.Всего_ВалютаОборот) КАК СуммаФакт,
		|	CW_РасходыПоГрузоперевозкамОбороты.ДокументРасходов.Организация КАК Организация
		|ПОМЕСТИТЬ втФакт
		|ИЗ
		|	РегистрНакопления.CW_РасходыПоГрузоперевозкам.Обороты(
		|			,
		|			,
		|			,
		|			Грузоперевозка В (&Грузоперевозки)
		|				И ВЫБОР
		|					КОГДА &ПоСчетам
		|						ТОГДА ЭтоСчет
		|					ИНАЧЕ ЭтоАкт
		|				КОНЕЦ) КАК CW_РасходыПоГрузоперевозкамОбороты
		|
		|СГРУППИРОВАТЬ ПО
		|	CW_РасходыПоГрузоперевозкамОбороты.Контрагент,
		|	CW_РасходыПоГрузоперевозкамОбороты.Валюта,
		|	CW_РасходыПоГрузоперевозкамОбороты.ДокументРасходов.Организация
		|;
		|";
		
	КонецЕсли; 
	
	Запрос.Текст = Запрос.Текст + Символы.ПС + 
	"////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втПоБюджету.Организация,
	|	ЕСТЬNULL(втПоБюджету.Клиент, втФакт.Клиент) КАК Клиент,
	|	ЕСТЬNULL(втПоБюджету.Валюта, втФакт.Валюта) КАК Валюта,
	|	ЕСТЬNULL(втПоБюджету.СуммаПоБюджету, 0) КАК СуммаПоБюджету,
	|	ЕСТЬNULL(втФакт.СуммаФакт, 0) КАК СуммаФакт,
	|	ЕСТЬNULL(втПоБюджету.СуммаПоБюджету, 0) - ЕСТЬNULL(втФакт.СуммаФакт, 0) КАК Сальдо
