		|	CW_ДоходыПоГрузоперевозкамОбороты.ДокументДоходов.Организация КАК Организация
		|ПОМЕСТИТЬ втФакт
		|ИЗ
		|	РегистрНакопления.CW_ДоходыПоГрузоперевозкам.Обороты(
		|			,
		|			,
		|			,
		|			Грузоперевозка В (&Грузоперевозки)
		|				И ЭтоАкт) КАК CW_ДоходыПоГрузоперевозкамОбороты
		|
		|СГРУППИРОВАТЬ ПО
		|	CW_ДоходыПоГрузоперевозкамОбороты.Контрагент,
		|	CW_ДоходыПоГрузоперевозкамОбороты.Валюта,
		|	CW_ДоходыПоГрузоперевозкамОбороты.ДокументДоходов.Организация
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	втПоБюджету.Организация,
		|	ЕСТЬNULL(втПоБюджету.Клиент, втФакт.Клиент) КАК Клиент,
		|	ЕСТЬNULL(втПоБюджету.Валюта, втФакт.Валюта) КАК Валюта,
		|	ЕСТЬNULL(втПоБюджету.СуммаПоБюджету, 0) КАК СуммаПоБюджету,
		|	ЕСТЬNULL(втФакт.СуммаФакт, 0) КАК СуммаФакт,
		|	ЕСТЬNULL(втПоБюджету.СуммаПоБюджету, 0) - ЕСТЬNULL(втФакт.СуммаФакт, 0) КАК Сальдо
		|ИЗ
		|	втПоБюджету КАК втПоБюджету
		|		ПОЛНОЕ СОЕДИНЕНИЕ втФакт КАК втФакт
		|		ПО втПоБюджету.Клиент = втФакт.Клиент
		|			И втПоБюджету.Валюта = втФакт.Валюта
		|			И втПоБюджету.Организация = втФакт.Организация"
	);
	
	з.УстановитьПараметр("ВерсияБюджета", ВерсияБюджета);
	Если ТипЗнч(ОбъектСсылка) = Тип("СправочникСсылка.CW_Грузоперевозки") ИЛИ НЕ ЗначениеЗаполнено(ОбъектСсылка) Тогда 
		з.УстановитьПараметр("Грузоперевозка", ОбъектСсылка);
	Иначе 
		з.Текст = СтрЗаменить(
			з.Текст, 
			"&Грузоперевозка", 
			"ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	CW_Грузоперевозки.Ссылка
			|ИЗ
			|	Справочник.CW_Грузоперевозки КАК CW_Грузоперевозки
			|ГДЕ
			|	CW_Грузоперевозки.Заказ = &Заказ"
		);
		з.УстановитьПараметр("Заказ", ОбъектСсылка);
	КонецЕсли;
	тз = з.Выполнить().Выгрузить();
	
	Возврат тз;
	
