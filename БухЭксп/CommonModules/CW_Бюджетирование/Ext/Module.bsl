Процедура СкопироватьСтатьюПоГрузоперевозкам(Выборка, мГрузоперевозки, ВерсияБюджета, ВыборкаСтатьиБюджета, РассчитыватьПрогнозОплаты)
	
	Если ВыборкаСтатьиБюджета <> Неопределено Тогда
		ПараметрыОтбора = Новый Структура("ВидСтатьиПланирования,Контрагент,Номенклатура,Валюта,Организация,ПорядокОтраженияРасходов,ПорядокОтраженияДоходов");
		
		ЗаполнитьЗначенияСвойств(ПараметрыОтбора, Выборка);
		ПараметрыОтбора.Вставить("ВерсияБюджета", ВерсияБюджета);
	КонецЕсли; 
	
	СтатьиБюджета = Новый Массив;
	
	Для Каждого Грузоперевозка из мГрузоперевозки Цикл 
		Если ВыборкаСтатьиБюджета <> Неопределено Тогда
			ПараметрыОтбора.Вставить("Владелец", Грузоперевозка);
			
			ВыборкаСтатьиБюджета.Сбросить();
			Если ВыборкаСтатьиБюджета.НайтиСледующий(ПараметрыОтбора) Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		
		НоваяСтатья = Выборка.Ссылка.Скопировать();
		НоваяСтатья.Владелец 		= Грузоперевозка; 
		НоваяСтатья.ВерсияБюджета 	= ВерсияБюджета;
		
		ЗаполнитьЗначенияСвойств(НоваяСтатья, Выборка,"Сумма,СуммаВсего,СуммаНДС,Количество,СуммаВсегоРуб,СуммаНДСРуб,СуммаРуб,СтавкаНДС");
		
		НоваяСтатья.Цена 	= Выборка.Сумма / ?(Выборка.Количество=0, 1, Выборка.Количество);      
		НоваяСтатья.ЦенаРуб = Выборка.СуммаРуб / ?(Выборка.Количество=0, 1, Выборка.Количество);      
		
		НоваяСтатья.ТипКурсаВалюты = 1;      
		Если Выборка.СуммаВсего <> 0 Тогда  
			НоваяСтатья.Курс = Окр(Выборка.СуммаВсегоРуб/Выборка.СуммаВсего, 4);
		Иначе
			НоваяСтатья.Курс = 1;	
		КонецЕсли;
		
		НоваяСтатья.Записать(); 
		
		СтатьиБюджета.Добавить(НоваяСтатья.Ссылка);
		
	КонецЦикла; 
	
	Если РассчитыватьПрогнозОплаты Тогда  
		Справочники.CW_ПлановыеСтатьиЗатратИДоходов.РассчитатьПрогнозОплаты(СтатьиБюджета);
	КонецЕсли;
	
	
КонецПроцедуры

Процедура СкопироватьСтатьюПоГрузоперевозкамПропорционально(Выборка, мГрузоперевозки, ВерсияБюджета, ВыборкаСтатьиБюджета, РассчитыватьПрогнозОплаты)
	
	Если ВыборкаСтатьиБюджета <> Неопределено Тогда
		ПараметрыОтбора = Новый Структура("ВидСтатьиПланирования,Контрагент,Номенклатура,Валюта,Организация,ПорядокОтраженияРасходов,ПорядокОтраженияДоходов");
		
		ЗаполнитьЗначенияСвойств(ПараметрыОтбора, Выборка);
		ПараметрыОтбора.Вставить("ВерсияБюджета", ВерсияБюджета);
	КонецЕсли;
	
	//Кэшируем суммы по статье
	Сумма 		= Выборка.Сумма;
	СуммаНДС  	= Выборка.СуммаНДС;
	СуммаВсего  = Выборка.СуммаВсего;
	
	СуммаРуб		= Выборка.СуммаРуб;
	СуммаНДСРуб  	= Выборка.СуммаНДСРуб;
	СуммаВсегоРуб  	= Выборка.СуммаВсегоРуб;   
	//---Кэшируем суммы по статье
	
	Курс = 1;
	Если Выборка.СуммаВсего <> 0 Тогда
		Курс = Окр(Выборка.СуммаВсегоРуб/Выборка.СуммаВсего, 4);
	КонецЕсли;

	ЗначениеСтавки = CW_Финансы.ПолучитьСтавкуНДС(Выборка.СтавкаНДС)/100;
	
	СуммаРаспределено 		= 0;
	СуммаНДСРаспределено 	= 0;
	СуммаВсегоРаспределено 	= 0;

	СуммаРубРаспределено 		= 0;
	СуммаНДСРубРаспределено 	= 0;
	СуммаВсегоРубРаспределено 	= 0;
	
	СтатьиБюджета = Новый Массив;
	
	Для индекс = 0 по мГрузоперевозки.ВГраница() Цикл
		
		Грузоперевозка = мГрузоперевозки[индекс];
		
		Если ВыборкаСтатьиБюджета <> Неопределено Тогда
			ПараметрыОтбора.Вставить("Владелец", Грузоперевозка);
			
			ВыборкаСтатьиБюджета.Сбросить();
			Если ВыборкаСтатьиБюджета.НайтиСледующий(ПараметрыОтбора) Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		
		НоваяСтатья = Выборка.Ссылка.Скопировать();
		НоваяСтатья.Владелец 		= Грузоперевозка; 
		НоваяСтатья.ВерсияБюджета 	= ВерсияБюджета; 
		
		НоваяСтатья.Количество 		= Выборка.Количество;  
		НоваяСтатья.СтавкаНДС 		= Выборка.СтавкаНДС;  
		
		НоваяСтатья.СуммаВсего	= Окр(Выборка.СуммаВсего / мГрузоперевозки.Количество(), 2); 
		НоваяСтатья.СуммаНДС 	= НоваяСтатья.СуммаВсего * ЗначениеСтавки / (1+ЗначениеСтавки);  
		НоваяСтатья.Сумма 		= НоваяСтатья.СуммаВсего - НоваяСтатья.СуммаНДС;
		
		НоваяСтатья.СуммаВсегоРуб	= НоваяСтатья.СуммаВсего * Курс; 
		НоваяСтатья.СуммаНДСРуб 	= НоваяСтатья.СуммаНДС * Курс;  
		НоваяСтатья.СуммаРуб 		= НоваяСтатья.Сумма * Курс;
		
		НоваяСтатья.Цена 		= НоваяСтатья.Сумма		/ ?(НоваяСтатья.Количество=0, 1, НоваяСтатья.Количество);      
		НоваяСтатья.ЦенаРуб 	= НоваяСтатья.СуммаРуб 	/ ?(НоваяСтатья.Количество=0, 1, НоваяСтатья.Количество);      
		
		СуммаВсегоРаспределено 	= СуммаВсегоРаспределено + НоваяСтатья.СуммаВсего;
		СуммаНДСРаспределено 	= СуммаНДСРаспределено + НоваяСтатья.СуммаНДС;
		СуммаРаспределено 		= СуммаРаспределено + НоваяСтатья.Сумма;    
		
		СуммаВсегоРубРаспределено 	= СуммаВсегоРубРаспределено + НоваяСтатья.СуммаВсегоРуб;
		СуммаНДСРубРаспределено 	= СуммаНДСРубРаспределено + НоваяСтатья.СуммаНДСРуб;
		СуммаРубРаспределено 		= СуммаРубРаспределено + НоваяСтатья.СуммаРуб;  
		
		Если индекс = мГрузоперевозки.Количество() - 1 Тогда
			//Последняя грузоперевозка   
			НоваяСтатья.Сумма 		= НоваяСтатья.Сумма + (Сумма - СуммаРаспределено);
			НоваяСтатья.СуммаНДС 	= НоваяСтатья.СуммаНДС + (СуммаНДС - СуммаНДСРаспределено);
			НоваяСтатья.СуммаВсего 	= НоваяСтатья.СуммаВсего + (СуммаВсего - СуммаВсегоРаспределено);
			
			НоваяСтатья.СуммаРуб 		= НоваяСтатья.СуммаРуб + (СуммаРуб - СуммаРубРаспределено);
			НоваяСтатья.СуммаНДСРуб 	= НоваяСтатья.СуммаНДСРуб + (СуммаНДСРуб - СуммаНДСРубРаспределено);
			НоваяСтатья.СуммаВсегоРуб 	= НоваяСтатья.СуммаВсегоРуб + (СуммаВсегоРуб - СуммаВсегоРубРаспределено);
			
		КонецЕсли;
		
		НоваяСтатья.Записать();  
		
		СтатьиБюджета.Добавить(НоваяСтатья.Ссылка);
	
	КонецЦикла;

	Если РассчитыватьПрогнозОплаты Тогда  
		Справочники.CW_ПлановыеСтатьиЗатратИДоходов.РассчитатьПрогнозОплаты(СтатьиБюджета);
	КонецЕсли;

КонецПроцедуры

Функция ПолучитьПустыеПараметрыОтбораСтатейБюджета() Экспорт
	
	Соответствие = Новый Соответствие;
	Соответствие.Вставить("Организация",	 	Ложь);
	Соответствие.Вставить("Контрагент", 		Ложь);
	Соответствие.Вставить("Договор", 			Ложь);
	Соответствие.Вставить("Валюта", 			Ложь);
	Соответствие.Вставить("Номенклатура", 		Ложь);
	Соответствие.Вставить("ПорядокОтражения", 	Ложь);
	Соответствие.Вставить("СтавкаНДС",			Ложь);
	Соответствие.Вставить("СуммаВсего", 				Ложь);
	Соответствие.Вставить("СтатьяИспользуетсяОднократно", Ложь);
	
	Если ПолучитьФункциональнуюОпцию("CW_ВедетсяУчетПриложенийПоДоговорам") Тогда
		Соответствие.Вставить("ПриложениеКДоговору",Ложь);
	КонецЕсли;
	
	Возврат Соответствие;
	
КонецФункции

Процедура УстановитьЗначенияПараметровОтбора( Знач ИмяКонстанты, Знач ПараметрыОтбора) Экспорт
	
	Константы[ИмяКонстанты].Установить(Новый ХранилищеЗначения(ПараметрыОтбора));

КонецПроцедуры   

Функция ПолучитьЗначенияПараметровОтбора(ИмяКонстанты) Экспорт

	ПустыеПараметрыОтбора 	= ПолучитьПустыеПараметрыОтбораСтатейБюджета();
	
	ХранилищеОтбора = Константы[ИмяКонстанты].Получить(); 
	
	НастройкиОтбора = ХранилищеОтбора.Получить(); 	
	Если НастройкиОтбора = Неопределено Тогда
		НастройкиОтбора = ПустыеПараметрыОтбора;
	КонецЕсли; 
	
	//При изменении состава настроек нужно проверить их полноту
	Для Каждого КлючЗначение из ПустыеПараметрыОтбора Цикл
		Если НастройкиОтбора.Получить(КлючЗначение.Ключ) = Неопределено Тогда
			НастройкиОтбора.Вставить(КлючЗначение.Ключ, КлючЗначение.Значение);	
		КонецЕсли;
	КонецЦикла;
	
	// проверка на значения, которые больше не поддерживаются 
	Для Каждого КлючЗначение из НастройкиОтбора Цикл
		Если ПустыеПараметрыОтбора.Получить(КлючЗначение.Ключ) = Неопределено Тогда
			НастройкиОтбора.Удалить(КлючЗначение.Ключ);	
		КонецЕсли;
	КонецЦикла;
	
	Возврат НастройкиОтбора; 
	
КонецФункции 

Функция ВедетсяУчетСтатейБюджетаВДокументах() Экспорт
	Возврат ПолучитьФункциональнуюОпцию("CW_УчетСтатейБюджетаВДокументах");
КонецФункции

//Заполнение статей баюджета в документ
Функция ПолучитьСтатьиБюджетаВФоне(Знач Объект, ВыделенныеСтроки, ЗапуститьВФоне) Экспорт
	
	ВерсияСтатьиБюджета = Константы.CW_ВерсияСтатьиБюджетаДляОтбора.Получить();
	ХранилищеПараметров = Константы.CW_ПараметрыОтбораДоходов.Получить();  
	ПараметрыПодбора 	= ХранилищеПараметров.Получить();
	
	Если ПараметрыПодбора = Неопределено Тогда
		ПараметрыПодбора = ПолучитьПустыеПараметрыОтбораСтатейБюджета();
	КонецЕсли;
	
	СоответствиеИменКолонок = Новый Соответствие;
	
	ТаблицаПодбора = Новый ТаблицаЗначений;
	ТаблицаПодбора.Колонки.Добавить("ИдентификаторСтроки", 	Новый ОписаниеТипов("Число"));
	ТаблицаПодбора.Колонки.Добавить("Владелец",				Новый ОписаниеТипов("СправочникСсылка.CW_Грузоперевозки"));

	мДополнительныеПоля = новый Массив;
	
	Если ЗначениеЗаполнено(ВерсияСтатьиБюджета) Тогда
		ТаблицаПодбора.Колонки.Добавить("ВерсияБюджета", Новый ОписаниеТипов("СправочникСсылка.CW_ВерсииБюджетов"));
		мДополнительныеПоля.Добавить("ВерсияБюджета");
	КонецЕсли; 
	
	МетаданныеСтатьи = Метаданные.Справочники.CW_ПлановыеСтатьиЗатратИДоходов;
	Реквизиты = МетаданныеСтатьи.Реквизиты;
	
	Для Каждого КлючЗначение из ПараметрыПодбора Цикл
		Если Не КлючЗначение.Значение 
			или КлючЗначение.Ключ = "СтатьяИспользуетсяОднократно" Тогда
			Продолжить;
		КонецЕсли; 
		ИмяКолонки = КлючЗначение.Ключ;
		Если КлючЗначение.Ключ = "ПорядокОтражения" Тогда
			ИмяКолонки =  "ПорядокОтраженияДоходов"; 
		КонецЕсли; 
		
		мДополнительныеПоля.Добавить(ИмяКолонки);
		
		РеквизитСтатьи = Реквизиты.Найти(ИмяКолонки);
		
		ТаблицаПодбора.Колонки.Добавить(ИмяКолонки, РеквизитСтатьи.Тип);  
		
		СоответствиеИменКолонок.Вставить(КлючЗначение.Ключ, ИмяКолонки);
		
	КонецЦикла;
	
	МетаданныеОбъекта = Объект.Ссылка.Метаданные();
	
	//Заполнение таблицы подбора 
	Для Каждого ИдентификаторСтроки  из ВыделенныеСтроки Цикл 
		
		СтрокаУслуги = Объект.Услуги.НайтиПоИдентификатору(ИдентификаторСтроки);
		Если ЗначениеЗаполнено(СтрокаУслуги.СтатьяБюджета) Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = ТаблицаПодбора.Добавить();
		НоваяСтрока.ИдентификаторСтроки = ИдентификаторСтроки;   
		НоваяСтрока.Владелец 			= СтрокаУслуги.Грузоперевозка;
		
		Если ЗначениеЗаполнено(ВерсияСтатьиБюджета) Тогда
			НоваяСтрока.ВерсияБюджета = ВерсияСтатьиБюджета;
		КонецЕсли;
		
		Для Каждого КлючЗначение из ПараметрыПодбора Цикл
			Если Не КлючЗначение.Значение 
				или КлючЗначение.Ключ = "СтатьяИспользуетсяОднократно" Тогда
				Продолжить;
			КонецЕсли; 
			
			ИмяКолонки = СоответствиеИменКолонок.Получить(КлючЗначение.Ключ);   
			РеквизитОбъекта = ?(КлючЗначение.Ключ = "СуммаВсего","Всего",КлючЗначение.Ключ);
			
			Если ОбщегоНазначения.ЕстьРеквизитОбъекта(РеквизитОбъекта, МетаданныеОбъекта) Тогда
				НоваяСтрока[ИмяКолонки] = Объект[РеквизитОбъекта];
			КонецЕсли; 
			
			Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(СтрокаУслуги, РеквизитОбъекта) Тогда
				НоваяСтрока[ИмяКолонки] = СтрокаУслуги[РеквизитОбъекта];
			КонецЕсли;   
			
		КонецЦикла;
		
	КонецЦикла;
	//---Заполнение таблицы подбора  
	
	ДоходыРасходы = "ДОХОДЫ";
	Если ТипЗнч(Объект.Ссылка) = Тип("ДокументСсылка.CW_РасходыПоГрузоперевозке") Тогда
		ДоходыРасходы = "РАСХОДЫ";
	КонецЕсли;
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(Новый УникальныйИдентификатор);
	ПараметрыВыполнения.ОжидатьЗавершение    = 0;  // запускать сразу  
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = "";  
	ПараметрыВыполнения.ЗапуститьВФоне     = ЗапуститьВФоне;  
	ПараметрыВыполнения.ЗапуститьНеВФоне   = Не ЗапуститьВФоне;   
	ПараметрыПроцедуры = Новый Структура;  
	ПараметрыПроцедуры.Вставить("ДоходыРасходы", 				ДоходыРасходы);  
	ПараметрыПроцедуры.Вставить("ТекущийДокумент", 				Объект.Ссылка);  
	ПараметрыПроцедуры.Вставить("ТаблицаПодбора", 				ТаблицаПодбора);   
	ПараметрыПроцедуры.Вставить("ДополнительныеПоля",			мДополнительныеПоля);  
	ПараметрыПроцедуры.Вставить("СтатьяИспользуетсяОднократно",	ПараметрыПодбора["СтатьяИспользуетсяОднократно"]); 

	
	Возврат ДлительныеОперации.ВыполнитьВФоне("CW_Бюджетирование.ПолучитьСтатьиБюджета", ПараметрыПроцедуры, ПараметрыВыполнения);  
	
КонецФункции

Процедура ПолучитьСтатьиБюджета(ПараметрыПроцедуры, АдресРезультата) Экспорт
	
	Если ПараметрыПроцедуры.ТаблицаПодбора.Количество() = 0 Тогда
		ПоместитьВоВременноеХранилище(Неопределено, АдресРезультата);
		Возврат;
	КонецЕсли;
	
	мПоляСоединения = Новый Массив;
	Для Каждого ИмяКолонки из ПараметрыПроцедуры.ДополнительныеПоля Цикл
		мПоляСоединения.Добавить("И ВТ_ТаблицаУсловий."+ИмяКолонки+" = CW_ПлановыеСтатьиЗатратИДоходов."+ИмяКолонки);
	КонецЦикла;    
	
	ПоляСоединения = СтрСоединить(мПоляСоединения, Символы.ПС);

	Запрос = Новый Запрос;  
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;

	Запрос.УстановитьПараметр("ТаблицаПодбора", 	ПараметрыПроцедуры.ТаблицаПодбора);
	Запрос.УстановитьПараметр("ТекущийДокумент", 	ПараметрыПроцедуры.ТекущийДокумент);
	
	Запрос.Текст = "ВЫБРАТЬ *
	               |ПОМЕСТИТЬ ВТ_ТаблицаУсловий
	               |ИЗ
	               |	&ТаблицаПодбора КАК ТаблицаПодбора
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ_ТаблицаУсловий.ИдентификаторСтроки КАК ИдентификаторСтроки,
	               |	CW_ПлановыеСтатьиЗатратИДоходов.Ссылка КАК СтатьяБюджета
	               |ПОМЕСТИТЬ ВТ_ПодобранныеСтатьи
	               |ИЗ
	               |	ВТ_ТаблицаУсловий КАК ВТ_ТаблицаУсловий
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.CW_ПлановыеСтатьиЗатратИДоходов КАК CW_ПлановыеСтатьиЗатратИДоходов
	               |		ПО ВТ_ТаблицаУсловий.Владелец = CW_ПлановыеСтатьиЗатратИДоходов.Владелец
            	   |			//УСЛОВИЯ_СОЕДИНЕНИЯ
	               |ГДЕ
	               |	CW_ПлановыеСтатьиЗатратИДоходов.ПометкаУдаления = ЛОЖЬ";  
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "//УСЛОВИЯ_СОЕДИНЕНИЯ", ПоляСоединения);

	Запрос.Выполнить();
	
	ДобавитьВременнуюТаблицуИспользуемыеСтатьи(Запрос, ПараметрыПроцедуры.ДоходыРасходы);

	Запрос.Текст = "ВЫБРАТЬ 
	               |	ВТ_ПодобранныеСтатьи.ИдентификаторСтроки КАК ИдентификаторСтроки,
	               |	ВТ_ПодобранныеСтатьи.СтатьяБюджета КАК СтатьяБюджета
	               |ИЗ
	               |	ВТ_ПодобранныеСтатьи КАК ВТ_ПодобранныеСтатьи
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ИспользуемыеСтатьи КАК ВТ_ИспользуемыеСтатьи
	               |		ПО ВТ_ПодобранныеСтатьи.СтатьяБюджета = ВТ_ИспользуемыеСтатьи.СтатьяБюджета
	               |ГДЕ
	               |	ИСТИНА
	               |	//УСЛОВИЕ_ТОЛЬКО_ИСПОЛЬЗУЕМЫЕ"; 
	
	Если ПараметрыПроцедуры.СтатьяИспользуетсяОднократно Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "//УСЛОВИЕ_ТОЛЬКО_ИСПОЛЬЗУЕМЫЕ", 
				   "И ВЫБОР
	               |			КОГДА ВТ_ИспользуемыеСтатьи.СтатьяБюджета ЕСТЬ NULL
	               |				ТОГДА ЛОЖЬ
	               |			ИНАЧЕ ИСТИНА
	               |		КОНЕЦ = ЛОЖЬ");
	КонецЕсли;
	
	РезультатЗапроса = 	Запрос.Выполнить();
	
	ПоместитьВоВременноеХранилище(РезультатЗапроса.Выгрузить(), АдресРезультата);
	
КонецПроцедуры

Процедура ДобавитьВременнуюТаблицуИспользуемыеСтатьи(Знач Запрос, Знач ВидДвижения)
	
	Если ВидДвижения = "ДОХОДЫ" Тогда
		Запрос.Текст = "ВЫБРАТЬ 
		|	CW_ДоходыПоГрузоперевозкамОбороты.СтатьяБюджета КАК СтатьяБюджета,
		|	CW_ДоходыПоГрузоперевозкамОбороты.ВсегоОборот КАК ВсегоОборот
		|ПОМЕСТИТЬ ВТ_ИспользуемыеСтатьи
		|ИЗ
		|	РегистрНакопления.CW_ДоходыПоГрузоперевозкам.Обороты(
		|			,
		|			,
		|			Период, 
		|			ДокументДоходов <> &ТекущийДокумент
		|			И СтатьяБюджета В
		|				(ВЫБРАТЬ
		|					ВТ_ПодобранныеСтатьи.СтатьяБюджета КАК СтатьяБюджета
		|				ИЗ
		|					ВТ_ПодобранныеСтатьи КАК ВТ_ПодобранныеСтатьи)) КАК CW_ДоходыПоГрузоперевозкамОбороты";
	КонецЕсли;    
	
	Если ВидДвижения = "РАСХОДЫ" Тогда
		Запрос.Текст = "ВЫБРАТЬ
		|	CW_РасходыПоГрузоперевозкамОбороты.СтатьяБюджета КАК СтатьяБюджета,
		|	CW_РасходыПоГрузоперевозкамОбороты.ВсегоОборот КАК ВсегоОборот
		|ПОМЕСТИТЬ ВТ_ИспользуемыеСтатьи
		|ИЗ
		|	РегистрНакопления.CW_РасходыПоГрузоперевозкам.Обороты(
		|			,
		|			,
		|			Период,
		|			ДокументРасходов <> &ТекущийДокумент
		|				И СтатьяБюджета В
		|					(ВЫБРАТЬ
		|						ВТ_ПодобранныеСтатьи.СтатьяБюджета КАК СтатьяБюджета
		|					ИЗ
		|						ВТ_ПодобранныеСтатьи КАК ВТ_ПодобранныеСтатьи)) КАК CW_РасходыПоГрузоперевозкамОбороты";
	КонецЕсли;
	
	Запрос.Выполнить();
	
КонецПроцедуры

Функция ПолучитьПараметрыФормыОтчетаАнализИсполненияБюджетаГрузоперевозок(ПараметрКоманды) Экспорт  
	
	Если ТипЗнч(ПараметрКоманды[0]) = Тип("СправочникСсылка.CW_Грузоперевозки") Тогда
		ЗначениеОтбора = ПараметрКоманды;
	КонецЕсли;
	Если ТипЗнч(ПараметрКоманды[0]) = Тип("СправочникСсылка.CW_Заказы") Тогда
		ЗначениеОтбора = Справочники.CW_Заказы.ПолучитьМассивГрузоперевозокЗаказа(ПараметрКоманды);
	КонецЕсли;
	Если ТипЗнч(ПараметрКоманды[0]) = Тип("СправочникСсылка.CW_Заявки") Тогда
		ЗначениеОтбора = Справочники.CW_Заявки.ПолучитьМассивГрузоперевозокЗаявки(ПараметрКоманды);
	КонецЕсли;
	
	Если ТипЗнч(ПараметрКоманды[0]) = Тип("ДокументСсылка.CW_ДоходыПоГрузоперевозке") Тогда
		ЗначениеОтбора = ПолучитьМассивГрузоперевозокДокументов(ПараметрКоманды, "CW_ДоходыПоГрузоперевозке");
	КонецЕсли;
	Если ТипЗнч(ПараметрКоманды[0]) = Тип("ДокументСсылка.CW_РасходыПоГрузоперевозке") Тогда
		ЗначениеОтбора = ПолучитьМассивГрузоперевозокДокументов(ПараметрКоманды, "CW_РасходыПоГрузоперевозке");
	КонецЕсли;
	
	ТОтчет = Отчеты.CW_АнализИсполненияБюджетаГрузоперевозок.Создать();

	БухгалтерскиеОтчетыКлиентСервер.ДобавитьОтбор(
	ТОтчет.КомпоновщикНастроек,
	"Грузоперевозка",
	ЗначениеОтбора,
	ВидСравненияКомпоновкиДанных.ВСписке,
	Истина,
	Ложь);   

	ВерсияБюджета = Константы.CW_БазоваяВерсияБюджета.Получить();
	
	// условие отбора по основной версии, прописанной в параметрах команды
	// или гнлроеделенной версии (вариант, когда введен документ, но статья бюджета не указана)
	Если ЗначениеЗаполнено(ВерсияБюджета) Тогда 
		
		ГруппаОтбора = ТОтчет.КомпоновщикНастроек.Настройки.Отбор.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));	
       	ГруппаОтбора.ТипГруппы 		= ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИли;
		ГруппаОтбора.Использование 	= Истина;
		
		БухгалтерскиеОтчетыКлиентСервер.ДобавитьОтбор(
		ГруппаОтбора,
		"ВерсияБюджета",
		ВерсияБюджета,
		ВидСравненияКомпоновкиДанных.ВСписке,
		Истина,
		Ложь); 
		
		БухгалтерскиеОтчетыКлиентСервер.ДобавитьОтбор(
		ГруппаОтбора,
		"ВерсияБюджета",
		,
		ВидСравненияКомпоновкиДанных.НеЗаполнено,
		Истина,
		Ложь);  
		
	КонецЕсли;                                                                                
	
	// условие выборки доходных и расходных документов, отражающих факт использования статей
	// по умолчанию анализируем только акты
	ГруппаОтбора = ТОтчет.КомпоновщикНастроек.Настройки.Отбор.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));	
   	ГруппаОтбора.ТипГруппы 		= ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИли;
	ГруппаОтбора.Использование 	= Истина;
	
	// условие для вывода в отчет бюджетных статей 
	БухгалтерскиеОтчетыКлиентСервер.ДобавитьОтбор(
	ГруппаОтбора,
	"Регистратор",
	Неопределено,
	ВидСравненияКомпоновкиДанных.НеЗаполнено,
	Истина,
	Ложь);   
	
	// акты документа "Расходы по грузоперевозкам"
	БухгалтерскиеОтчетыКлиентСервер.ДобавитьОтбор(
	ГруппаОтбора,
	"Регистратор.ПредъявленАкт",
	Истина,
	ВидСравненияКомпоновкиДанных.Равно,
	Истина,
	Ложь); 
	
	// акты документа "Доходы по грузоперевозкам"
	БухгалтерскиеОтчетыКлиентСервер.ДобавитьОтбор(
	ГруппаОтбора,
	"Регистратор.ФормируетсяАкт",
	Истина,
	ВидСравненияКомпоновкиДанных.Равно,
	Истина,
	Ложь); 
	
	
	// счета документа "Расходы по грузоперевозкам" (по умолчанию условие отключено)
	БухгалтерскиеОтчетыКлиентСервер.ДобавитьОтбор(
	ГруппаОтбора,
	"Регистратор.ПредъявленСчет",
	Ложь,
	ВидСравненияКомпоновкиДанных.Равно,
	Ложь,
	Ложь); 
	
	// счета документа "Доходы по грузоперевозкам" (по умолчанию условие отключено)
	БухгалтерскиеОтчетыКлиентСервер.ДобавитьОтбор(
	ГруппаОтбора,
	"Регистратор.ФормируетсяСчет",
	Ложь,
	ВидСравненияКомпоновкиДанных.Равно,
	Ложь,
	Ложь); 
	
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("СформироватьПриОткрытии", 		Истина);
	ПараметрыФормы.Вставить("ПользовательскиеНастройки", 	ТОтчет.КомпоновщикНастроек.ПользовательскиеНастройки);
 	ПараметрыФормы.Вставить("Вариант", 						ТОтчет.КомпоновщикНастроек.Настройки);

	Возврат ПараметрыФормы;
	
КонецФункции  

Функция ПолучитьМассивГрузоперевозокДокументов(ПараметрКоманды, ИмяДокумента) 
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ТаблицаУслуги.Грузоперевозка КАК Грузоперевозка
	|ИЗ
	|	Документ."+ИмяДокумента+".Услуги КАК ТаблицаУслуги
	|ГДЕ
	|	ТаблицаУслуги.Ссылка В(&ПараметрКоманды)";
	
	Запрос.УстановитьПараметр("ПараметрКоманды", ПараметрКоманды);  
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("Грузоперевозка");
	
КонецФункции

Функция СоздатьСтатьиБюжетаВФоне(ПараметрыПроцедуры) Экспорт 
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(Новый УникальныйИдентификатор);
	ПараметрыВыполнения.ОжидатьЗавершение    = 0;  // запускать сразу  
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = "";  
	ПараметрыВыполнения.ЗапуститьВФоне     = Истина;  
	ПараметрыВыполнения.ЗапуститьНеВФоне    = ложь;   
	
	Возврат ДлительныеОперации.ВыполнитьВФоне("CW_Бюджетирование.СоздатьСтатьиБюджета",ПараметрыПроцедуры, ПараметрыВыполнения);  
	
КонецФункции     

Процедура СоздатьСтатьиБюджета(ПараметрыПроцедуры, АдресРезультата) Экспорт

	ДанныеОбъекта = ПараметрыПроцедуры.ДанныеОбъекта; 
	
	ВалютаРегламентированногоУчета 	= Константы.ВалютаРегламентированногоУчета.Получить();
	ИспользуетсяДоговорИПриложение 	= ПолучитьФункциональнуюОпцию("CW_УказыватьДоговорДляПлановыхСтатейБюджета");
	ИспользуетсяПрогнозПоБюджету 	= ПолучитьФункциональнуюОпцию("CW_ИспользуетсяПрогнозированиеДДСПоБюджету"); 
	
	Результат = Новый Соответствие;  
	
	НачатьТранзакцию();
	
	Для Каждого ДанныеСтроки из ПараметрыПроцедуры.ДанныеСтрок Цикл 
		СсылкаСтатьиБюджета = Справочники.CW_ПлановыеСтатьиЗатратИДоходов.ПолучитьСсылку(Новый УникальныйИдентификатор);
		Результат.Вставить(ДанныеСтроки.ИдентификаторСтроки, СсылкаСтатьиБюджета);
		
		УчитыватьНДСВСебестоимости = CW_Настройки.ПараметрУчетнойПолитики(ДанныеОбъекта.Дата, ДанныеОбъекта.Организация, "УчитыватьНДСВСебестоимости");
		
		НоваяСтатьяБюджета = Справочники.CW_ПлановыеСтатьиЗатратИДоходов.СоздатьЭлемент();
		НоваяСтатьяБюджета.Владелец 					=  ДанныеСтроки.Грузоперевозка;
		НоваяСтатьяБюджета.ВерсияБюджета 				=  ПараметрыПроцедуры.ВерсияБюджета;
		НоваяСтатьяБюджета.ВидСтатьиПланирования		=  ПараметрыПроцедуры.ВидСтатьиПланирования;
		НоваяСтатьяБюджета.Организация 					=  ДанныеОбъекта.Организация;
		НоваяСтатьяБюджета.Контрагент 					=  ДанныеОбъекта.Контрагент;
		НоваяСтатьяБюджета.Номенклатура 				=  ДанныеСтроки.Номенклатура;
		НоваяСтатьяБюджета.ЕдиницаИзмерения 			=  ДанныеСтроки.Номенклатура.ЕдиницаИзмерения;  
		НоваяСтатьяБюджета.УчитыватьНДСВСебестоимости 	=  УчитыватьНДСВСебестоимости;
		
		Если ИспользуетсяДоговорИПриложение Тогда
			НоваяСтатьяБюджета.Договор =  ДанныеОбъекта.Договор;   
			
			Если ДанныеОбъекта.Договор.ИспользуютсяПриложения Тогда
				НоваяСтатьяБюджета.ПриложениеКДоговору	=  ДанныеОбъекта.ПриложениеКДоговору;
			КонецЕсли;
		Конецесли;     
		
		Если ПараметрыПроцедуры.ВидСтатьиПланирования = Перечисления.CW_ВидыСтатейПланирования.Доходы Тогда
			НоваяСтатьяБюджета.ПорядокОтраженияДоходов = ДанныеСтроки.ПорядокОтражения;                                                     
		Иначе
			НоваяСтатьяБюджета.ПорядокОтраженияРасходов = ДанныеСтроки.ПорядокОтражения;
		КонецЕсли;
		
		НоваяСтатьяБюджета.СтавкаНДС 	= ДанныеСтроки.СтавкаНДС;
		ПроцентНДС 						= CW_Финансы.ПолучитьСтавкуНДС(ДанныеСтроки.СтавкаНДС);
	
		НоваяСтатьяБюджета.Количество 	= ДанныеСтроки.Количество;
		НоваяСтатьяБюджета.Цена 		= ДанныеСтроки.Цена;
		НоваяСтатьяБюджета.Сумма 		= ?(УчитыватьНДСВСебестоимости, ДанныеСтроки.Всего, ДанныеСтроки.Сумма);
		НоваяСтатьяБюджета.СуммаНДС 	= ДанныеСтроки.НДС;
		НоваяСтатьяБюджета.СуммаВсего 	= ДанныеСтроки.Всего;
		
		НоваяСтатьяБюджета.Валюта =  ДанныеОбъекта.Валюта; 
		НоваяСтатьяБюджета.ТипКурсаВалюты =  1;
		
		Если ДанныеОбъекта.Валюта = ВалютаРегламентированногоУчета Тогда
			НоваяСтатьяБюджета.Курс	     = 1;
			НоваяСтатьяБюджета.Кратность = 1; 
		Иначе
			Если ДанныеОбъекта.УЕ_ПользовательскийКурс Тогда
				НоваяСтатьяБюджета.Курс	     = ДанныеОбъекта.УЕ_Курс;
				НоваяСтатьяБюджета.Кратность = ДанныеОбъекта.УЕ_Кратность; 
			Иначе
				КурсКратность = CW_Финансы.ПолучитьКурсВалюты(ДанныеОбъекта.Валюта, ДанныеОбъекта.ДатаКурса);
				НоваяСтатьяБюджета.Курс	     = КурсКратность.Курс;
				НоваяСтатьяБюджета.Кратность = КурсКратность.Кратность; 
			КонецЕсли;
		КонецЕсли; 
		
		НоваяСтатьяБюджета.СуммаРуб = CW_Финансы.ПересчитатьИзВалютыВВалюту(
			?(УчитыватьНДСВСебестоимости, ДанныеСтроки.Всего, ДанныеСтроки.Сумма),
			ДанныеОбъекта.Валюта, 
			ВалютаРегламентированногоУчета, 
			НоваяСтатьяБюджета.Курс, 1, 
			НоваяСтатьяБюджета.Кратность, 1); 
			
			НоваяСтатьяБюджета.СуммаНДСРуб = CW_Финансы.РассчитатьСуммуНДС(
			НоваяСтатьяБюджета.СуммаРуб, 
			Истина,
			УчитыватьНДСВСебестоимости, 
			ПроцентНДС);  
			
		Если ДанныеСтроки.Количество <> 0 Тогда  
			Если УчитыватьНДСВСебестоимости Тогда
				НоваяСтатьяБюджета.ЦенаРуб = (НоваяСтатьяБюджета.СуммаРуб-НоваяСтатьяБюджета.СуммаНДСРуб) / ДанныеСтроки.Количество;
			Иначе
				НоваяСтатьяБюджета.ЦенаРуб = НоваяСтатьяБюджета.СуммаРуб / ДанныеСтроки.Количество;
			КонецЕсли;
		КонецЕсли;
		
		Если УчитыватьНДСВСебестоимости Тогда
			НоваяСтатьяБюджета.СуммаВсегоРуб = НоваяСтатьяБюджета.СуммаРуб;
		Иначе
			НоваяСтатьяБюджета.СуммаВсегоРуб = НоваяСтатьяБюджета.СуммаРуб + НоваяСтатьяБюджета.СуммаНДСРуб;
		КонецЕсли;
		
		НоваяСтатьяБюджета.Комментарий 		= "#Создана по данным строки документа";
		НоваяСтатьяБюджета.CW_Автор 		= ПараметрыСеанса.ТекущийПользователь;
		НоваяСтатьяБюджета.CW_ДатаСоздания 	= ТекущаяДата();
	
		НоваяСтатьяБюджета.УстановитьСсылкуНового(СсылкаСтатьиБюджета);
		
		НоваяСтатьяБюджета.Записать(); 
		
		Если ИспользуетсяПрогнозПоБюджету Тогда 
			
			ПараметрыРасчета = Новый Структура;
			ПараметрыРасчета.Вставить("ВариантПрогноза", 			НоваяСтатьяБюджета.ВариантПрогноза);
			ПараметрыРасчета.Вставить("Владелец", 					НоваяСтатьяБюджета.Владелец);
			ПараметрыРасчета.Вставить("ПрогнозКонтрольнаяДата", 	НоваяСтатьяБюджета.ПрогнозКонтрольнаяДата);
			ПараметрыРасчета.Вставить("ПрогнозКоличествоДней", 		НоваяСтатьяБюджета.ПрогнозКоличествоДней);
			ПараметрыРасчета.Вставить("ПрогнозКоличествоДнейПлан", 	НоваяСтатьяБюджета.ПрогнозКоличествоДнейПлан);
			
			ПараметрыРасчета.Вставить("ПрогнозДата",	 			Дата(1,1,1));
			ПараметрыРасчета.Вставить("ДатаНачалаПеревозки", 		НоваяСтатьяБюджета.Владелец.ДатаСделкиФ);
			
			ПрогнозДата = Справочники.CW_ПлановыеСтатьиЗатратИДоходов.РассчитатьПрогнозОплатыСтатьиБюджета(ПараметрыРасчета); 
			
			РегистрыСведений.CW_ПрогнозОплатыПлановыхСтатейБюджета.ЗаписатьПрогнозОплаты(СсылкаСтатьиБюджета, ПрогнозДата);
			
		Конецесли;
		
	КонецЦикла;    
	
	ЗафиксироватьТранзакцию();
	
	ПоместитьВоВременноеХранилище(Результат, АдресРезультата);
	
КонецПроцедуры  

Функция ОбновитьСтатьиБюджетаВФоне(ПараметрыПроцедуры) Экспорт 
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(Новый УникальныйИдентификатор);
	ПараметрыВыполнения.ОжидатьЗавершение    = 0;  // запускать сразу  
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = "";  
	ПараметрыВыполнения.ЗапуститьВФоне     = Истина;  
	ПараметрыВыполнения.ЗапуститьНеВФоне    = ложь;   
	
	Возврат ДлительныеОперации.ВыполнитьВФоне("CW_Бюджетирование.ОбновитьСтатьиБюджета",ПараметрыПроцедуры, ПараметрыВыполнения);  
	
КонецФункции 

Процедура ОбновитьСтатьиБюджета(ПараметрыПроцедуры, АдресРезультата) Экспорт

  	ВалютаРегламентированногоУчета 	= Константы.ВалютаРегламентированногоУчета.Получить();

	Для Каждого КлючЗначение из ПараметрыПроцедуры.ПараметрыСтатейБюджета Цикл
		
		СтатьяБюджетаОбъект = КлючЗначение.Ключ.ПолучитьОбъект();
		
		ЗаполнитьЗначенияСвойств(СтатьяБюджетаОбъект, КлючЗначение.Значение);
		
		ПроцентНДС = CW_Финансы.ПолучитьСтавкуНДС(СтатьяБюджетаОбъект.СтавкаНДС);
	
		СтатьяБюджетаОбъект.СуммаРуб = CW_Финансы.ПересчитатьИзВалютыВВалюту(
			СтатьяБюджетаОбъект.Сумма,
			СтатьяБюджетаОбъект.Валюта, 
			ВалютаРегламентированногоУчета, 
			СтатьяБюджетаОбъект.Курс, 1, 
			СтатьяБюджетаОбъект.Кратность, 1); 
			
		СтатьяБюджетаОбъект.СуммаНДСРуб = CW_Финансы.РассчитатьСуммуНДС(
			СтатьяБюджетаОбъект.СуммаРуб, 
			Истина, 
			Ложь, 
			ПроцентНДС);
			
		Если СтатьяБюджетаОбъект.Количество <> 0 Тогда
			СтатьяБюджетаОбъект.ЦенаРуб = СтатьяБюджетаОбъект.СуммаРуб / СтатьяБюджетаОбъект.Количество;
		КонецЕсли;

		СтатьяБюджетаОбъект.СуммаВсегоРуб = СтатьяБюджетаОбъект.СуммаРуб + СтатьяБюджетаОбъект.СуммаНДСРуб;

		СтатьяБюджетаОбъект.CW_Редактор				= ПараметрыСеанса.ТекущийПользователь;
		СтатьяБюджетаОбъект.CW_ДатаРедактирования 	= ТекущаяДата();
		
        СтатьяБюджетаОбъект.записать();
		
	КонецЦикла;

КонецПроцедуры

Функция ВыполнитьУдалениеСтатьиБюдежта(Форма, ДополнительныеПараметры) Экспорт
	
	Если Форма.БюджетУтвержден Тогда
		Отказ = Истина;
		Возврат "Невозможно удалить утвержденный бюджет!";
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);  
	
	МассивСтатей = Новый Массив;
	Для Каждого ИдентификаторСтроки из ДополнительныеПараметры.ВыделенныеСтроки Цикл
		СтрокаТекущая = Форма[ДополнительныеПараметры.ИмяТаблицы].НайтиПоИдентификатору(ИдентификаторСтроки);   
		МассивСтатей.Добавить(СтрокаТекущая.СтатьяСсылка);
	КонецЦикла; 
	
	СтатьиСоСсылками = ПроверитьВозможностьУдаленияСтатейБюджета(МассивСтатей);
	
	Для Каждого ИдентификаторСтроки из ДополнительныеПараметры.ВыделенныеСтроки Цикл
		СтрокаТекущая = Форма[ДополнительныеПараметры.ИмяТаблицы].НайтиПоИдентификатору(ИдентификаторСтроки);    
		Если СтатьиСоСсылками.Найти(СтрокаТекущая.СтатьяСсылка) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		СтатьяОбъект  = СтрокаТекущая.СтатьяСсылка.ПолучитьОбъект();
		СтатьяОбъект.Удалить();   
		
		Форма[ДополнительныеПараметры.ИмяТаблицы].Удалить(СтрокаТекущая);	
	КонецЦикла;  
	
	Форма.Элементы.ГруппаБюджетДоходы.Заголовок		= "Доходы ("+Форма.БюджетДоходы.Количество()+")";
	Форма.Элементы.ГруппаБюджетЗатраты.Заголовок  	= "Расходы ("+Форма.БюджетРасходы.Количество()+")";
	
	Возврат "";
	
КонецФункции

Функция ПроверитьВозможностьУдаленияСтатейБюджета(Знач МассивСтатей) Экспорт
	
	СтатьиСоСсылками = Новый Массив;
	
	ИсключитьОбъекты = Новый Массив;
	ИсключитьОбъекты.Добавить(Метаданные.РегистрыСведений.CW_ПрогнозОплатыПлановыхСтатейБюджета);
	
	ТаблицаСсылок = НайтиПоСсылкам(МассивСтатей,,,ИсключитьОбъекты); 
	Статья = Неопределено;
	Для Каждого СтрокаТаблицы из ТаблицаСсылок Цикл  
		Если Статья <> СтрокаТаблицы[0] Тогда
			Сообщить("На удаляемую статью "+СокрЛП(СтрокаТаблицы[0])+"  найдены ссылки:");
			Сообщить("- "+СокрЛП(СтрокаТаблицы[1]));
			Статья = СтрокаТаблицы[0];
		Иначе
			Сообщить("- "+СокрЛП(СтрокаТаблицы[1]));
		КонецЕсли; 
		
		Если СтатьиСоСсылками.Найти(СтрокаТаблицы[0]) = Неопределено Тогда
			СтатьиСоСсылками.Добавить(СтрокаТаблицы[0]);                     
		КонецЕсли;
	КонецЦикла;  
	
	Возврат СтатьиСоСсылками;
	
КонецФункции


//Пересчет показателй статьи бюджета
Процедура ПриИзмененииЦеныСтатьиБюджета(Объект) Экспорт
	
	СтавкаНДСПроцент 	= CW_Финансы.ПолучитьСтавкуНДС(Объект.СтавкаНДС); 
	ЦенаРуб 			= Окр(Объект.Цена * Объект.Курс / Объект.Кратность, 2);
	
	Если Объект.Количество = 0 Тогда
		Объект.Количество = 1;
	КонецЕсли;
	
	Если Объект.ЦенаСНДС Тогда
		Объект.СуммаВсего 		= Окр(Объект.Цена * Объект.Количество,2); 
		Объект.СуммаВсегоРуб 	= Окр(Объект.СуммаВсего * Объект.Курс / Объект.Кратность,2);   
		
		Объект.СуммаНДС 		= Окр(Объект.СуммаВсего * СтавкаНДСПроцент/(100 + СтавкаНДСПроцент),2);
		Объект.СуммаНДСРуб 		= Окр(Объект.СуммаВсегоРуб * СтавкаНДСПроцент/(100 + СтавкаНДСПроцент),2);
		
		
		Если Объект.УчитыватьНДСВСебестоимости Тогда
			Объект.Сумма = Объект.СуммаВсего; 
			Объект.СуммаРуб = Объект.СуммаВсегоРуб; 
		Иначе
			Объект.Сумма = Объект.СуммаВсего -  Объект.СуммаНДС;
			Объект.СуммаРуб = Объект.СуммаВсегоРуб -  Объект.СуммаНДСРуб;
		КонецЕсли;
	Иначе  
		Объект.Сумма 			= Окр(Объект.Количество * Объект.Цена,2);
		Объект.СуммаРуб 		= Окр(Объект.Сумма * Объект.Курс / Объект.Кратность, 2);     
		
		Объект.СуммаНДС 		= Окр(Объект.Сумма * СтавкаНДСПроцент/100,2);
		Объект.СуммаНДСРуб 		= Окр(Объект.СуммаРуб * СтавкаНДСПроцент/100,2);
		
		
		Объект.СуммаВсего = Объект.Сумма +  Объект.СуммаНДС;
		Объект.СуммаВсегоРуб = Объект.СуммаРуб + Объект.СуммаНДСРуб;  
		
		Если Объект.УчитыватьНДСВСебестоимости Тогда
			Объект.Сумма = Объект.СуммаВсего; 
			Объект.СуммаРуб = Объект.СуммаВсегоРуб;    
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры  

Процедура ПриИзмененииСуммыНДССтатьиБюджета(Объект) Экспорт 
	
	// при изменении суммы НДС исходим из того, что сумма Всего меняться не должна
	СтавкаНДСПроцент 	= CW_Финансы.ПолучитьСтавкуНДС(Объект.СтавкаНДС); 
	Объект.СуммаНДСРуб 	= Окр(Объект.СуммаНДС * Объект.Курс / ?(Объект.Кратность=0,1, Объект.Кратность), 2);
	
	// пересчет суммы выполняет только в случае, если НДС не включен в сумму
	Если Объект.УчитыватьНДСВСебестоимости = Ложь Тогда   
		Объект.Сумма 		= Объект.СуммаВсего - Объект.СуммаНДС;
		Объект.СуммаРуб		= Объект.СуммаВсегоРуб - Объект.СуммаНДСРуб;
	КонецЕсли;  
	
	Если Объект.ЦенаСНДС Тогда
		Объект.Цена = ?(Объект.Количество = 0, Объект.СуммаВсего, Окр(Объект.СуммаВсего/Объект.Количество,2));
		Объект.ЦенаРуб = ?(Объект.Количество = 0, Объект.СуммаВсегоРуб, Окр(Объект.СуммаВсегоРуб/Объект.Количество,2));
	Иначе
		Объект.Цена 		= ?(Объект.Количество = 0, Объект.Сумма, Окр((Объект.СуммаВсего-Объект.СуммаНДС)/Объект.Количество,2));
		Объект.ЦенаРуб 		= ?(Объект.Количество = 0, Объект.СуммаРуб, Окр((Объект.СуммаВсегоРуб-Объект.СуммаНДСРуб)/Объект.Количество,2));
	КонецЕсли;

КонецПроцедуры 

Процедура ПриИзмененииСуммыСтатьиБюджета(Объект) Экспорт   
	
	СтавкаНДСПроцент 	= CW_Финансы.ПолучитьСтавкуНДС(Объект.СтавкаНДС); 
	
	Если Объект.УчитыватьНДСВСебестоимости Тогда
		Объект.СуммаНДС 	= Окр(Объект.Сумма * СтавкаНДСПроцент / (100 + СтавкаНДСПроцент),2);
		Объект.СуммаВсего 	= Объект.Сумма;      
		
		Объект.СуммаВсегоРуб 	= Окр(Объект.СуммаВсего * Объект.Курс / ?(Объект.Кратность=0,1, Объект.Кратность), 2);
		Объект.СуммаРуб			= Объект.СуммаВсегоРуб;
		Объект.СуммаНДСРуб		= Окр(Объект.СуммаВсегоРуб * СтавкаНДСПроцент/(100+СтавкаНДСПроцент),2);
	Иначе
		Объект.СуммаРуб 	= Окр(Объект.Сумма * Объект.Курс / ?(Объект.Кратность=0,1, Объект.Кратность), 2); 
		Объект.СуммаНДС 	= Окр(Объект.Сумма * СтавкаНДСПроцент/100,2);
		Объект.СуммаНДСРуб 	= Окр(Объект.СуммаРуб * СтавкаНДСПроцент/100,2);   
		
		Объект.СуммаВсего 		= Объект.Сумма + Объект.СуммаНДС;      
		Объект.СуммаВсегоРуб 	= Объект.СуммаРуб + Объект.СуммаНДСРуб;
	КонецЕсли;

	Если Объект.ЦенаСНДС Тогда
		Объект.Цена = ?(Объект.Количество = 0, Объект.СуммаВсего, Окр(Объект.СуммаВсего/Объект.Количество,2));
		Объект.ЦенаРуб = ?(Объект.Количество = 0, Объект.СуммаВсегоРуб, Окр(Объект.СуммаВсегоРуб/Объект.Количество,2));
	Иначе
		Объект.Цена 		= ?(Объект.Количество = 0, Объект.Сумма, Окр((Объект.СуммаВсего-Объект.СуммаНДС)/Объект.Количество,2));
		Объект.ЦенаРуб 		= ?(Объект.Количество = 0, Объект.СуммаРуб, Окр((Объект.СуммаВсегоРуб-Объект.СуммаНДСРуб)/Объект.Количество,2));
	КонецЕсли;

КонецПроцедуры

Процедура ПриИзмененииСуммыВсегоСтатьиБюджета(Объект) Экспорт
	
	СтавкаНДСПроцент 	= CW_Финансы.ПолучитьСтавкуНДС(Объект.СтавкаНДС);  
		
	Объект.СуммаНДС 		= Окр(Объект.СуммаВсего * СтавкаНДСПроцент / (100 + СтавкаНДСПроцент),2);
	Объект.СуммаВсегоРуб 	= Окр(Объект.СуммаВсего * Объект.Курс / ?(Объект.Кратность=0,1, Объект.Кратность), 2);
	Объект.СуммаНДСРуб		= Окр(Объект.СуммаВсегоРуб * СтавкаНДСПроцент/(100+СтавкаНДСПроцент),2);
	
	Если Объект.УчитыватьНДСВСебестоимости Тогда
		Объект.Сумма 		= Объект.СуммаВсего;
		Объект.СуммаРуб 	= Объект.СуммаВсегоРуб; 
	Иначе
		Объект.Сумма 		= Объект.СуммаВсего - Объект.СуммаНДС;    
		Объект.СуммаРуб 	= Объект.СуммаВсегоРуб - Объект.СуммаНДСРуб;    
	КонецЕсли;  
	
	Если Объект.ЦенаСНДС Тогда
		Объект.Цена = ?(Объект.Количество = 0, Объект.СуммаВсего, Окр(Объект.СуммаВсего/Объект.Количество,2));
		Объект.ЦенаРуб = ?(Объект.Количество = 0, Объект.СуммаВсегоРуб, Окр(Объект.СуммаВсегоРуб/Объект.Количество,2));
	Иначе
		Объект.Цена 		= ?(Объект.Количество = 0, Объект.Сумма, Окр((Объект.СуммаВсего-Объект.СуммаНДС)/Объект.Количество,2));
		Объект.ЦенаРуб 		= ?(Объект.Количество = 0, Объект.СуммаРуб, Окр((Объект.СуммаВсегоРуб-Объект.СуммаНДСРуб)/Объект.Количество,2));
	КонецЕсли;
	
КонецПроцедуры
//Пересчет показателй статьи бюджета

Функция ПолучитьМассивСтатейБюджета(ЭтаФорма, ВыделенныеСтроки, ИмяТаблицы) Экспорт
	
	МассивСтатей = Новый Массив;
	Для Каждого ИдентификаторСтроки из ВыделенныеСтроки Цикл
		СтрокаТаблицы = ЭтаФорма[ИмяТаблицы].НайтиПоИдентификатору(ИдентификаторСтроки); 
		Если МассивСтатей.Найти(СтрокаТаблицы.СтатьяСсылка) = Неопределено Тогда
			МассивСтатей.Добавить(СтрокаТаблицы.СтатьяСсылка);
		КонецЕсли;
	КонецЦикла;  
	
	Возврат МассивСтатей;
	
КонецФункции   

Функция ПриНачалеПересчетаСтатейБюджета(ДатаКурса, ДопоплнительныеПараметры) Экспорт
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(Новый УникальныйИдентификатор);
	ПараметрыВыполнения.ОжидатьЗавершение    = 0;  // запускать сразу  
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = "";  
	ПараметрыВыполнения.ЗапуститьВФоне     = Истина;  
	ПараметрыВыполнения.ЗапуститьНеВФоне   = ложь;   
	
	ПараметрыПроцедуры = Новый Структура;  
	ПараметрыПроцедуры.Вставить("ДатаКурса",		ДатаКурса);  
	ПараметрыПроцедуры.Вставить("СтатьиБюджета", 	ДопоплнительныеПараметры.СтатьиБюджета);  

	Возврат ДлительныеОперации.ВыполнитьВФоне("CW_Бюджетирование.ВыполнитьПересчетБюджетаПоКурсу",ПараметрыПроцедуры, ПараметрыВыполнения);  
	
КонецФункции   

Процедура ВыполнитьПересчетБюджетаПоКурсу(ПараметрыПроцедуры, АдресРезультата) Экспорт
	
	ВалютаРегламентированногоУчета = Константы.ВалютаРегламентированногоУчета.Получить();  
	ДатаКурса = ?(ПараметрыПроцедуры.ДатаКурса = Неопределено, ТекущаяДата(), ПараметрыПроцедуры.ДатаКурса);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	CW_ПлановыеСтатьиЗатратИДоходов.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.CW_ПлановыеСтатьиЗатратИДоходов КАК CW_ПлановыеСтатьиЗатратИДоходов
	|ГДЕ
	|	CW_ПлановыеСтатьиЗатратИДоходов.Ссылка В(&СтатьиБюджета)
	|	И CW_ПлановыеСтатьиЗатратИДоходов.Валюта <> &ВалютаРегламентированногоУчета
	|	И CW_ПлановыеСтатьиЗатратИДоходов.ТипКурсаВалюты <> 2"; 
	
	Запрос.УстановитьПараметр("ВалютаРегламентированногоУчета", ВалютаРегламентированногоУчета);
	Запрос.УстановитьПараметр("СтатьиБюджета", ПараметрыПроцедуры.СтатьиБюджета);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл     
		
		СтатьяОбъект = Выборка.Ссылка.ПолучитьОбъект();
	
		КурсКратность = CW_Финансы.ПолучитьКурсВалюты(СтатьяОбъект.Валюта, ДатаКурса);
		
		СтатьяОбъект.ТипКурсаВалюты = 1; //Ставим фиксированный   
		СтатьяОбъект.Курс 		= КурсКратность.Курс;   
		СтатьяОбъект.Кратность 	= КурсКратность.Кратность;    
		
		ПересчитатьСтатьюБюджетаПоКурсу(СтатьяОбъект, КурсКратность);
		
		СтатьяОбъект.Записать();
		
	КонецЦикла;
	
КонецПроцедуры     

Процедура ПересчитатьСтатьюБюджетаПоКурсу(СтатьяБюджета, КурсКратность=Неопределено, ДатаКурса=Неопределено) Экспорт
	
	ДатаКурса = ?(ДатаКурса = Неопределено, ТекущаяДата(), ДатаКурса); 
	Если КурсКратность = Неопределено Тогда
		КурсКратность = CW_Финансы.ПолучитьКурсВалюты(СтатьяБюджета.Валюта, ДатаКурса);  
	КонецЕсли; 
	
	Если СтатьяБюджета.ТипКурсаВалюты <> 0 Тогда
		КурсКратность.Курс = СтатьяБюджета.Курс;
		КурсКратность.Кратность = СтатьяБюджета.Кратность;
	КонецЕсли;

	СтавкаНДСПроцент	= CW_Финансы.ПолучитьСтавкуНДС(СтатьяБюджета.СтавкаНДС);
	
	СтатьяБюджета.СуммаВсегоРуб	= Окр(СтатьяБюджета.СуммаВсего * КурсКратность.Курс / КурсКратность.Кратность, 2);
	СтатьяБюджета.СуммаНДСРуб	= СтатьяБюджета.СуммаВсегоРуб * СтавкаНДСПроцент/(100+СтавкаНДСПроцент);
	СтатьяБюджета.СуммаРуб		= СтатьяБюджета.СуммаВсегоРуб - СтатьяБюджета.СуммаНДСРуб;
	
КонецПроцедуры


//Сортировка бюджетов  
Процедура СортироватьТаблицуБюджета(Форма, Знач ИмяТаблицы, Знач Направление) Экспорт
	
	ИмяКолонки = ПолучитьИмяКолонки(Форма, ИмяТаблицы); 
	
	СтрокаСортировки = ИмяКолонки + " "+Направление;
	
	Форма[ИмяТаблицы].Сортировать(СтрокаСортировки);  
	
	ПолеСортировки = ПустаяСтруктураПолеСортировки();
	ПолеСортировки.ИмяПоля		= ИмяКолонки;
	ПолеСортировки.Направление	= Направление;

	УстановитьЗагловокиКолонокТаблицы(Форма, ИмяТаблицы, ПолеСортировки);
	
	СохранитьДанныеСортировки(Форма, ИмяТаблицы, ПолеСортировки);
	
КонецПроцедуры

Процедура УстановитьЗагловокиКолонокТаблицы(Форма, Знач ИмяТаблицы, Знач ПолеСортировки)
	
	СимволыНаправления = Новый Соответствие;
	СимволыНаправления.Вставить("ВОЗР", Символ(8593));
	СимволыНаправления.Вставить("УБЫВ", Символ(8595)); 
	
	СимволСортировки = СимволыНаправления.Получить(ПолеСортировки.Направление); 
	Если СимволСортировки = Неопределено Тогда
		СимволСортировки = "";
	КонецЕсли; 

	РеквизитыТаблицы = Форма.ПолучитьРеквизиты(ИмяТаблицы);
	Для Каждого Реквизит из РеквизитыТаблицы Цикл
		ЭлементФормы = Форма.Элементы.Найти(ИмяТаблицы+Реквизит.Имя); 
		Если ЭлементФормы <> Неопределено Тогда
			ЭлементФормы.Заголовок = Реквизит.Заголовок + ?(Реквизит.Имя = ПолеСортировки.ИмяПоля,  Символы.НПП + СимволСортировки, "");
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры 

Функция ПолучитьИмяКолонки(Форма, ИмяЭлмента) Экспорт
	
	Элементы 	= Форма.Элементы;
	ПутьКДанным = Элементы[ИмяЭлмента].ТекущийЭлемент.ПутьКДанным;
	мСоставПути = СтрРазделить(ПутьКДанным,".");
	
	Если мСоставПути.Количество() > 1 Тогда 
		Возврат мСоставПути[1];                
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Процедура СохранитьДанныеСортировки(Форма, Знач ИмяТаблицы, Знач ПолеСортировки)
	
	ДанныеСортировки = Новый Структура;
	Если ТипЗнч(Форма.ДанныеСортировки) = Тип("ФиксированнаяСтруктура") Тогда
		ДанныеСортировки = Новый Структура(Форма.ДанныеСортировки);
	КонецЕсли;   
	
	ДанныеСортировки.Вставить(ИмяТаблицы, Новый ФиксированнаяСтруктура(ПолеСортировки));
	
	Форма.ДанныеСортировки = Новый ФиксированнаяСтруктура(ДанныеСортировки);  
	
КонецПроцедуры

Процедура ВосстановитьСортировкуТаблицы(Форма, Знач ИмяТаблицы) Экспорт
	
	ДанныеСортировки = Новый Структура;
	Если ТипЗнч(Форма.ДанныеСортировки) = Тип("ФиксированнаяСтруктура") Тогда 
		ДанныеСортировки = Новый Структура(Форма.ДанныеСортировки);
	КонецЕсли;
	
	Если ДанныеСортировки.Свойство(ИмяТаблицы) Тогда
		Если ТипЗнч(ДанныеСортировки[ИмяТаблицы]) = Тип("ФиксированнаяСтруктура") Тогда  
			ПолеСортировки = Новый Структура(ДанныеСортировки[ИмяТаблицы]);
		КонецЕсли;
		
		Если ПолеСортировки <>Неопределено Тогда 
			Форма[ИмяТаблицы].Сортировать(ПолеСортировки.ИмяПоля+ " "+ПолеСортировки.Направление);
			УстановитьЗагловокиКолонокТаблицы(Форма, ИмяТаблицы, ПолеСортировки);  
		КонецЕсли;
	КонецЕсли;  
	
КонецПроцедуры 

Функция ПустаяСтруктураПолеСортировки()

	ПолеСортировки = Новый Структура;
	ПолеСортировки.Вставить("ИмяПоля",		Неопределено);
	ПолеСортировки.Вставить("Направление",	Неопределено);  
	
	Возврат ПолеСортировки;
	
КонецФункции
