// для грузоперевозки или заказа возвращает таблицу ссылок на ИСПОЛЬЗУЕМЫЕ (в статьях, константах, настройках пользователя) элементы справочника CW_ВерсииБюджета в порядке использования 
Функция _ПолучитьТаблицуИспользованияВерсийБюджета(ОбъектСсылка, флВесьСправочник=Ложь) Экспорт 
	
	Если (ТипЗнч(ОбъектСсылка)=Тип("СправочникСсылка.CW_ВариантыБюджетовПоЗаявкам")) Тогда
		
		Возврат(Новый ТаблицаЗначений);
		
	Иначе
		
		// массив возврата будет отсортирован по порядку использования (дата изменения); 
		// если есть утверждённые версии, то они пойдут в начале списка
		// в массиве всегда как минимум один элемент - если статей по объекту не введено, то 
		// на версию из настроек пользователя, либо из констант, либо предопределенная "Основная")
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	CW_ПлановыеСтатьиЗатратИДоходов.ВерсияБюджета КАК ВерсияБюджета,
		|	МАКСИМУМ(CW_ПлановыеСтатьиЗатратИДоходов.CW_ДатаРедактирования) КАК ДатаРедактирования,
		|	ИСТИНА КАК ЭтоИспользуемаяВерсия,
		|	ЛОЖЬ КАК ЭтоУтвержденнаяВерсия,
		|	ЛОЖЬ КАК ЭтоБазоваяВерсияИзКонстанты,
		|	ЛОЖЬ КАК ЭтоОсновнаяВерсияДляПользователя,
		|	ЛОЖЬ КАК ЭтоПредопределеннаяВерсия,
		|	КОЛИЧЕСТВО(CW_ПлановыеСтатьиЗатратИДоходов.Ссылка) КАК КоличествоСтатей
		|ПОМЕСТИТЬ втУпомянутыеВерсии
		|ИЗ
		|	Справочник.CW_ПлановыеСтатьиЗатратИДоходов КАК CW_ПлановыеСтатьиЗатратИДоходов
		|ГДЕ
		|	CW_ПлановыеСтатьиЗатратИДоходов.Владелец В(&Грузоперевозка)
		|
		|СГРУППИРОВАТЬ ПО
		|	CW_ПлановыеСтатьиЗатратИДоходов.ВерсияБюджета
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	CW_УтверждениеБюджетов.ВерсияБюджета,
		|	ДАТАВРЕМЯ(1, 1, 1),
		|	ЛОЖЬ,
		|	ИСТИНА,
		|	ЛОЖЬ,
		|	ЛОЖЬ,
		|	ЛОЖЬ,
		|	0
		|ИЗ
		|	РегистрСведений.CW_УтверждениеБюджетов КАК CW_УтверждениеБюджетов
		|ГДЕ
		|	CW_УтверждениеБюджетов.Объект = &ОбъектВКоторомУтверждаетсяБюджет
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	CW_ВерсииБюджетов.Ссылка,
		|	ДАТАВРЕМЯ(1, 1, 1),
		|	ЛОЖЬ,
		|	ЛОЖЬ,
		|	ЛОЖЬ,
		|	ЛОЖЬ,
		|	ЛОЖЬ,
		|	0
		|ИЗ
		|	Справочник.CW_ВерсииБюджетов КАК CW_ВерсииБюджетов
		|ГДЕ
		|	&флВесьСправочник
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	CW_НастройкиПользователей.ОсновнаяВерсияБюджета,
		|	ДАТАВРЕМЯ(1, 1, 1),
		|	ЛОЖЬ,
		|	ЛОЖЬ,
		|	ЛОЖЬ,
		|	ИСТИНА,
		|	ЛОЖЬ,
		|	0
		|ИЗ
		|	РегистрСведений.CW_НастройкиПользователей КАК CW_НастройкиПользователей
		|ГДЕ
		|	CW_НастройкиПользователей.Пользователь = &Пользователь
		|	И CW_НастройкиПользователей.ОсновнаяВерсияБюджета <> ЗНАЧЕНИЕ(Справочник.CW_ВерсииБюджетов.ПустаяСсылка)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	CW_БазоваяВерсияБюджета.Значение,
		|	ДАТАВРЕМЯ(1, 1, 1),
		|	ЛОЖЬ,
		|	ЛОЖЬ,
		|	ИСТИНА,
		|	ЛОЖЬ,
		|	ЛОЖЬ,
		|	0
		|ИЗ
		|	Константа.CW_БазоваяВерсияБюджета КАК CW_БазоваяВерсияБюджета
		|ГДЕ
		|	CW_БазоваяВерсияБюджета.Значение <> ЗНАЧЕНИЕ(Справочник.CW_ВерсииБюджетов.ПустаяСсылка)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	CW_ВерсииБюджетов.Ссылка,
		|	ДАТАВРЕМЯ(1, 1, 1),
		|	ЛОЖЬ,
		|	ЛОЖЬ,
		|	ЛОЖЬ,
		|	ЛОЖЬ,
		|	ИСТИНА,
		|	0
		|ИЗ
		|	Справочник.CW_ВерсииБюджетов КАК CW_ВерсииБюджетов
		|ГДЕ
		|	CW_ВерсииБюджетов.Ссылка = ЗНАЧЕНИЕ(Справочник.CW_ВерсииБюджетов.Основная)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ 
		|	втУпомянутыеВерсии.ВерсияБюджета КАК ВерсияБюджета,
		|	МАКСИМУМ(втУпомянутыеВерсии.ДатаРедактирования) КАК ДатаРедактирования,
		|	МАКСИМУМ(втУпомянутыеВерсии.ЭтоИспользуемаяВерсия) КАК ЭтоИспользуемаяВерсия,
		|	МАКСИМУМ(втУпомянутыеВерсии.ЭтоУтвержденнаяВерсия) КАК ЭтоУтвержденнаяВерсия,
		|	МАКСИМУМ(втУпомянутыеВерсии.ЭтоБазоваяВерсияИзКонстанты) КАК ЭтоБазоваяВерсияИзКонстанты,
		|	МАКСИМУМ(втУпомянутыеВерсии.ЭтоОсновнаяВерсияДляПользователя) КАК ЭтоОсновнаяВерсияДляПользователя,
		|	СУММА(втУпомянутыеВерсии.КоличествоСтатей) КАК КоличествоСтатей,
		|	МАКСИМУМ(втУпомянутыеВерсии.ЭтоПредопределеннаяВерсия) КАК ЭтоПредопределеннаяВерсия,
		|	втУпомянутыеВерсии.ВерсияБюджета.ПометкаУдаления КАК ПометкаУдаления
		|ИЗ
		|	втУпомянутыеВерсии КАК втУпомянутыеВерсии
		|
		|СГРУППИРОВАТЬ ПО
		|	втУпомянутыеВерсии.ВерсияБюджета,
		|	втУпомянутыеВерсии.ВерсияБюджета.ПометкаУдаления
		|
		|УПОРЯДОЧИТЬ ПО
		|	ВЫБОР
		|		КОГДА &флВесьСправочник
		|			ТОГДА втУпомянутыеВерсии.ВерсияБюджета.Наименование
		|		ИНАЧЕ 1
		|	КОНЕЦ,
		|	МАКСИМУМ(втУпомянутыеВерсии.ЭтоОсновнаяВерсияДляПользователя) УБЫВ,
		|	МАКСИМУМ(втУпомянутыеВерсии.ЭтоБазоваяВерсияИзКонстанты) УБЫВ,
		|	МАКСИМУМ(втУпомянутыеВерсии.ЭтоУтвержденнаяВерсия) УБЫВ,
		|	МАКСИМУМ(втУпомянутыеВерсии.ДатаРедактирования) УБЫВ,
		|	МАКСИМУМ(втУпомянутыеВерсии.ЭтоПредопределеннаяВерсия) УБЫВ";
		
		Запрос.УстановитьПараметр("Пользователь"						, CW_Настройки.Пользователь());
		Запрос.УстановитьПараметр("ОбъектВКоторомУтверждаетсяБюджет"	, ОбъектСсылка);
		Запрос.УстановитьПараметр("флВесьСправочник"					, флВесьСправочник);
		
		Если ТипЗнч(ОбъектСсылка) = Тип("СправочникСсылка.CW_Грузоперевозки") ИЛИ НЕ ЗначениеЗаполнено(ОбъектСсылка) Тогда 
			Запрос.УстановитьПараметр("Грузоперевозка", ОбъектСсылка);
		Иначе 
			Запрос.Текст = СтрЗаменить(
			Запрос.Текст, 
			"&Грузоперевозка", 
			"ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	CW_Грузоперевозки.Ссылка
			|ИЗ
			|	Справочник.CW_Грузоперевозки КАК CW_Грузоперевозки
			|ГДЕ
			|	CW_Грузоперевозки.Заказ = &Заказ"
			);
			Запрос.УстановитьПараметр("Заказ", ОбъектСсылка);
		КонецЕсли;
		
		РезультатЗапроса = Запрос.Выполнить();
		
		Если РезультатЗапроса.Пустой() Тогда
			//Странно!
			Возврат Новый ТаблицаЗначений;
		КонецЕсли;
		
		Возврат РезультатЗапроса.Выгрузить();
		
	КонецЕсли; 
		
КонецФункции

// для копирования бюджета - возвращает массив ссылок на НЕИСПОЛЬЗУЕМЫЕ элементы справочника CW_ВерсииБюджета
Функция _ПолучитьМассивНЕИспользуемыхВерсийБюджета(ОбъектСсылка) Экспорт 
	
	// массив возврата будет отсортирован по алфавиту
	// массив может оказаться пустым
	
	Если НЕ ЗначениеЗаполнено(ОбъектСсылка) Тогда 
		// новая грузоперевока/заказ
		масс = Новый Массив;
	Иначе 
		// не новая грузоперевозка/заказ
		з = Новый Запрос(
			"ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	CW_ВерсииБюджетов.Ссылка КАК ВерсияБюджета,
			|	CW_ВерсииБюджетов.Наименование КАК Наименование
			|ИЗ
			|	Справочник.CW_ВерсииБюджетов КАК CW_ВерсииБюджетов
			|ГДЕ
			|	НЕ CW_ВерсииБюджетов.Ссылка В
			|				(ВЫБРАТЬ РАЗЛИЧНЫЕ
			|					CW_ПлановыеСтатьиЗатратИДоходов.ВерсияБюджета
			|				ИЗ
			|					Справочник.CW_ПлановыеСтатьиЗатратИДоходов КАК CW_ПлановыеСтатьиЗатратИДоходов
			|				ГДЕ
			|					CW_ПлановыеСтатьиЗатратИДоходов.Владелец В (&Грузоперевозка))
			|
			|УПОРЯДОЧИТЬ ПО
			|	Наименование"
		);
		Если ТипЗнч(ОбъектСсылка) = Тип("СправочникСсылка.CW_Грузоперевозки") ИЛИ НЕ ЗначениеЗаполнено(ОбъектСсылка) Тогда 
			з.УстановитьПараметр("Грузоперевозка", ОбъектСсылка);
		Иначе 
			з.Текст = СтрЗаменить(
				з.Текст, 
				"&Грузоперевозка", 
				"ВЫБРАТЬ РАЗЛИЧНЫЕ
				|	CW_Грузоперевозки.Ссылка
				|ИЗ
				|	Справочник.CW_Грузоперевозки КАК CW_Грузоперевозки
				|ГДЕ
				|	CW_Грузоперевозки.Заказ = &Заказ"
			);
			з.УстановитьПараметр("Заказ", ОбъектСсылка);
		КонецЕсли;
		масс = з.Выполнить().Выгрузить().ВыгрузитьКолонку("ВерсияБюджета");

	КонецЕсли;
	
	Возврат масс;
	
КонецФункции

// возвращает массив ссылок на статьи по заданной версии бюджета для заданной грузоперевозки, либо для грузоперевозок по Заказу
Функция _ПолучитьМассивСтатейБюджета(ОбъектСсылка, ВерсияБюджета) Экспорт 
	
	// массив может оказаться пустым
	
	Если НЕ ЗначениеЗаполнено(ОбъектСсылка) Тогда 
		// новая грузоперевока/заказ
		масс = Новый Массив;
	Иначе 
		// не новая грузоперевозка/заказ
		з = Новый Запрос(
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
			|	CW_ПлановыеСтатьиЗатратИДоходов.Ссылка
			|ИЗ
			|	Справочник.CW_ПлановыеСтатьиЗатратИДоходов КАК CW_ПлановыеСтатьиЗатратИДоходов
			|ГДЕ
			|	CW_ПлановыеСтатьиЗатратИДоходов.ВерсияБюджета = &ВерсияБюджета
			|	И CW_ПлановыеСтатьиЗатратИДоходов.Владелец В(&Грузоперевозка)"
		);
		Если ТипЗнч(ОбъектСсылка) = Тип("СправочникСсылка.CW_Грузоперевозки") ИЛИ НЕ ЗначениеЗаполнено(ОбъектСсылка) Тогда 
			з.УстановитьПараметр("Грузоперевозка", ОбъектСсылка);
		Иначе 
			з.Текст = СтрЗаменить(
				з.Текст, 
				"&Грузоперевозка", 
				"ВЫБРАТЬ РАЗЛИЧНЫЕ
				|	CW_Грузоперевозки.Ссылка
				|ИЗ
				|	Справочник.CW_Грузоперевозки КАК CW_Грузоперевозки
				|ГДЕ
				|	CW_Грузоперевозки.Заказ = &Заказ"
			);
			з.УстановитьПараметр("Заказ", ОбъектСсылка);
		КонецЕсли;
		з.УстановитьПараметр("ВерсияБюджета", ВерсияБюджета);
		масс = з.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");

	КонецЕсли;
	
	Возврат масс;
	
КонецФункции

// таблицы затрат и доходов по заданной версии бюджета -- в разрезе одной грузоперевозки - развернутые по статьям
Функция _ПолучитьТаблицыБюджета_ПоГрузоперевозке(ОбъектСсылка, ОбъектЗаказ, ВерсияБюджета, ВариантБюджетаЗаявки, флЗатраты, флДоходы) Экспорт 
	
	Если ЗначениеЗаполнено(ОбъектЗаказ) Тогда 
		ОбъектБюджета = ОбъектЗаказ;
	Иначе 
		ОбъектБюджета = ОбъектСсылка;
	КонецЕсли;  
	
	Если ТипЗнч(ОбъектСсылка) = Тип("СправочникСсылка.CW_Заявки") Тогда
		ВладелецБюджета 			= ВариантБюджетаЗаявки;     
		ВерсияБюджетаУтвреждения 	= ВариантБюджетаЗаявки;
	Иначе
		ВладелецБюджета 			= ОбъектСсылка;
		ВерсияБюджетаУтвреждения 	= ВерсияБюджета;
	КонецЕсли;
	
	з = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	CW_ПлановыеСтатьиЗатратИДоходов.Ссылка КАК СтатьяСсылка,
		|	CW_ПлановыеСтатьиЗатратИДоходов.Контрагент КАК Контрагент,
		|	CW_ПлановыеСтатьиЗатратИДоходов.Номенклатура КАК Номенклатура,
		|	CW_ПлановыеСтатьиЗатратИДоходов.Валюта КАК Валюта,
		|	CW_ПлановыеСтатьиЗатратИДоходов.Курс КАК Курс,
		|	CW_ПлановыеСтатьиЗатратИДоходов.СтавкаНДС КАК СтавкаНДС,
		|	CW_ПлановыеСтатьиЗатратИДоходов.Количество КАК Количество,
		|	CW_ПлановыеСтатьиЗатратИДоходов.Сумма КАК Сумма,
		|	CW_ПлановыеСтатьиЗатратИДоходов.СуммаНДС КАК СуммаНДС,
		|	CW_ПлановыеСтатьиЗатратИДоходов.СуммаВсего КАК СуммаВсего,
		|	CW_ПлановыеСтатьиЗатратИДоходов.СуммаРуб КАК СуммаРуб,
		|	CW_ПлановыеСтатьиЗатратИДоходов.СуммаНДСРуб КАК СуммаНДСРуб,
		|	CW_ПлановыеСтатьиЗатратИДоходов.СуммаВсегоРуб КАК СуммаВсегоРуб,
		|	CW_ПлановыеСтатьиЗатратИДоходов.ВидСтатьиПланирования КАК ВидСтатьиПланирования,
		|	CW_ПлановыеСтатьиЗатратИДоходов.Организация КАК Организация,
		|	CW_ПлановыеСтатьиЗатратИДоходов.Комментарий КАК Комментарий,
		|	CW_ПлановыеСтатьиЗатратИДоходов.ПорядокОтраженияРасходов КАК ПорядокОтраженияРасходов,
		|	CW_ПлановыеСтатьиЗатратИДоходов.ПорядокОтраженияДоходов КАК ПорядокОтраженияДоходов,
		|	CW_ПлановыеСтатьиЗатратИДоходов.Договор КАК Договор,
		|	CW_ПлановыеСтатьиЗатратИДоходов.ПриложениеКДоговору КАК ПриложениеКДоговору,
		|	CW_ПлановыеСтатьиЗатратИДоходов.СрокДействия КАК СрокДействия
		|ПОМЕСТИТЬ вт
		|ИЗ
		|	Справочник.CW_ПлановыеСтатьиЗатратИДоходов КАК CW_ПлановыеСтатьиЗатратИДоходов
		|ГДЕ
		|	CW_ПлановыеСтатьиЗатратИДоходов.Владелец = &ВладелецБюджета
		|	И CW_ПлановыеСтатьиЗатратИДоходов.ВерсияБюджета = &ВерсияБюджета
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	вт.СтатьяСсылка КАК СтатьяСсылка,
		|	вт.Контрагент КАК Контрагент,
		|	вт.Номенклатура КАК Номенклатура,
		|	вт.Валюта КАК Валюта,
		|	вт.Курс КАК Курс,
		|	вт.СтавкаНДС КАК СтавкаНДС,
		|	вт.Количество КАК Количество,
