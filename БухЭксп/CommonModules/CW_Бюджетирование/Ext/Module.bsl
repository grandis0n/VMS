	з.УстановитьПараметр("Валюта",                структураОтбор.Валюта);
	з.УстановитьПараметр("СтавкаНДС",             структураОтбор.СтавкаНДС);
	з.УстановитьПараметр("Организация",           структураОтбор.Организация);
	
	Возврат з.Выполнить().Выгрузить().ВыгрузитьКолонку("Грузоперевозка");
	
