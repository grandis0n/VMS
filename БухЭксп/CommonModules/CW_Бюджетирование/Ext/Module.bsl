		табЗатрат.Колонки.Добавить("ПиктограммаКурса");
		Для Каждого Стр из табЗатрат Цикл
			ТекКурс = CW_Финансы.ПолучитьКурсВалюты(Стр.Валюта, ТекущаяДата());
			Если ТекКурс.Курс < Стр.Курс Тогда
				Стр.ПиктограммаКурса = 1;
			ИначеЕсли ТекКурс.Курс > Стр.Курс Тогда
				Стр.ПиктограммаКурса = 2;
			Иначе
				Стр.ПиктограммаКурса = 0;
			КонецЕсли;	
		КонецЦикла;
		
		табДоходы.Колонки.Добавить("ПиктограммаКурса");
