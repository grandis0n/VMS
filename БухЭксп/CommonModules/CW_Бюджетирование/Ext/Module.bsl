				   |	ВТ_ДанныеБюджетов.ПриложениеКДоговору,
				   |	ВТ_ДанныеБюджетов.Номенклатура,
				   |	ВТ_ДанныеБюджетов.Валюта,
				   |	ВТ_ДанныеБюджетов.СтавкаНДС,
				   |	ВТ_ДанныеБюджетов.Организация";
	
	
	РезультатЗатраты 	= Запрос.Выполнить();
	ТаблицаЗатрат 		= РезультатЗатраты.Выгрузить();

	//ДОХОДЫ
	Запрос.Текст = "ВЫБРАТЬ
	               |	ВТ_ДанныеБюджетов.СтатьяСсылка КАК СтатьяСсылка,
	               |	ВТ_ДанныеБюджетов.Грузоперевозка КАК Грузоперевозка,
	               |	ВТ_ДанныеБюджетов.Контрагент КАК Контрагент,
	               |	ВТ_ДанныеБюджетов.Договор КАК Договор,
	               |	ВТ_ДанныеБюджетов.ПриложениеКДоговору КАК ПриложениеКДоговору,
	               |	ВТ_ДанныеБюджетов.Номенклатура КАК Номенклатура,
	               |	ВТ_ДанныеБюджетов.Валюта КАК Валюта,
	               |	ВТ_ДанныеБюджетов.СтавкаНДС КАК СтавкаНДС,
	               |	СУММА(ВТ_ДанныеБюджетов.Количество) КАК Количество,
	               |	СУММА(ВТ_ДанныеБюджетов.Сумма) КАК Сумма,
	               |	СУММА(ВТ_ДанныеБюджетов.СуммаНДС) КАК СуммаНДС,
	               |	СУММА(ВТ_ДанныеБюджетов.СуммаВсего) КАК СуммаВсего,
	               |	СУММА(ВТ_ДанныеБюджетов.СуммаРуб) КАК СуммаРуб,
	               |	СУММА(ВТ_ДанныеБюджетов.СуммаНДСРуб) КАК СуммаНДСРуб,
	               |	СУММА(ВТ_ДанныеБюджетов.СуммаВсегоРуб) КАК СуммаВсегоРуб,
	               |	ВТ_ДанныеБюджетов.Курс КАК Курс,
	               |	ВТ_ДанныеБюджетов.Организация КАК Организация
	               |ПОМЕСТИТЬ ВТ_Доходы
	               |ИЗ
	               |	ВТ_ДанныеБюджетов КАК ВТ_ДанныеБюджетов
	               |ГДЕ
	               |	&флДоходы
	               |	И ВТ_ДанныеБюджетов.ВидСтатьиПланирования = ЗНАЧЕНИЕ(Перечисление.CW_ВидыСтатейПланирования.Доходы)
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ВТ_ДанныеБюджетов.Курс,
	               |	ВТ_ДанныеБюджетов.СтатьяСсылка,
	               |	ВТ_ДанныеБюджетов.Грузоперевозка,
	               |	ВТ_ДанныеБюджетов.Контрагент,
	               |	ВТ_ДанныеБюджетов.Договор,
	               |	ВТ_ДанныеБюджетов.ПриложениеКДоговору,
	               |	ВТ_ДанныеБюджетов.Номенклатура,
	               |	ВТ_ДанныеБюджетов.Валюта,
	               |	ВТ_ДанныеБюджетов.СтавкаНДС,
	               |	ВТ_ДанныеБюджетов.Организация
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ_Доходы.СтатьяСсылка КАК СтатьяСсылка,
	               |	ВТ_Доходы.Грузоперевозка КАК Грузоперевозка,
	               |	ВТ_Доходы.Контрагент КАК Контрагент,
	               |	ВТ_Доходы.Договор КАК Договор,
	               |	ВТ_Доходы.ПриложениеКДоговору КАК ПриложениеКДоговору,
	               |	ВТ_Доходы.Номенклатура КАК Номенклатура,
	               |	ВТ_Доходы.Валюта КАК Валюта,
	               |	ВТ_Доходы.СтавкаНДС КАК СтавкаНДС,
	               |	ВТ_Доходы.Количество КАК Количество,
	               |	ВТ_Доходы.Сумма КАК Сумма,
	               |	ВТ_Доходы.СуммаНДС КАК СуммаНДС,
	               |	ВТ_Доходы.СуммаВсего КАК СуммаВсего,
	               |	ВТ_Доходы.СуммаРуб КАК СуммаРуб,
	               |	ВТ_Доходы.СуммаНДСРуб КАК СуммаНДСРуб,
	               |	ВТ_Доходы.СуммаВсегоРуб КАК СуммаВсегоРуб,
	               |	ВТ_Доходы.Курс КАК Курс,
	               |	ВТ_Доходы.Организация КАК Организация,
	               |	ВТ_Доходы.СтатьяСсылка.Комментарий КАК Комментарий,
	               |	ВЫБОР
	               |		КОГДА CW_ДоходыПоГрузоперевозкамОбороты.СтатьяБюджета ЕСТЬ NULL
	               |			ТОГДА 0
	               |		ИНАЧЕ 1
	               |	КОНЕЦ КАК ИспользуетсяВДокументах
	               |ИЗ
	               |	ВТ_Доходы КАК ВТ_Доходы
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.CW_ДоходыПоГрузоперевозкам.Обороты(, , Период, ) КАК CW_ДоходыПоГрузоперевозкамОбороты
	               |		ПО ВТ_Доходы.СтатьяСсылка = CW_ДоходыПоГрузоперевозкамОбороты.СтатьяБюджета
	               |ИТОГИ
	               |	СУММА(Сумма),
	               |	СУММА(СуммаНДС),
	               |	СУММА(СуммаВсего),
	               |	СУММА(СуммаРуб),
	               |	СУММА(СуммаНДСРуб),
	               |	СУММА(СуммаВсегоРуб)
	               |ПО
	               |	Грузоперевозка";
	
	РезультатДеревоДоходы 	= Запрос.Выполнить();      
	ВыборкаДоходы 			= РезультатДеревоДоходы.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	ВТ_ДанныеБюджетов.Контрагент КАК Контрагент,
	               |	ВТ_ДанныеБюджетов.Договор КАК Договор,
	               |	ВТ_ДанныеБюджетов.ПриложениеКДоговору КАК ПриложениеКДоговору,
	               |	ВТ_ДанныеБюджетов.Номенклатура КАК Номенклатура,
	               |	ВТ_ДанныеБюджетов.Валюта КАК Валюта,
	               |	ВТ_ДанныеБюджетов.СтавкаНДС КАК СтавкаНДС,
	               |	СУММА(ВТ_ДанныеБюджетов.Количество) КАК Количество,
	               |	СУММА(ВТ_ДанныеБюджетов.Сумма) КАК Сумма,
	               |	СУММА(ВТ_ДанныеБюджетов.СуммаНДС) КАК СуммаНДС,
	               |	СУММА(ВТ_ДанныеБюджетов.СуммаВсего) КАК СуммаВсего,
	               |	СУММА(ВТ_ДанныеБюджетов.СуммаРуб) КАК СуммаРуб,
	               |	СУММА(ВТ_ДанныеБюджетов.СуммаНДСРуб) КАК СуммаНДСРуб,
	               |	СУММА(ВТ_ДанныеБюджетов.СуммаВсегоРуб) КАК СуммаВсегоРуб,
	               |	ВТ_ДанныеБюджетов.Организация КАК Организация
				   |ИЗ
	               |	ВТ_ДанныеБюджетов КАК ВТ_ДанныеБюджетов
	               |ГДЕ
				   |	&флДоходы
				   |	И ВТ_ДанныеБюджетов.ВидСтатьиПланирования = ЗНАЧЕНИЕ(Перечисление.CW_ВидыСтатейПланирования.Доходы)
				   |
				   |СГРУППИРОВАТЬ ПО
				   |	ВТ_ДанныеБюджетов.Контрагент,
				   |	ВТ_ДанныеБюджетов.Договор,
				   |	ВТ_ДанныеБюджетов.ПриложениеКДоговору,
				   |	ВТ_ДанныеБюджетов.Номенклатура,
	               |	ВТ_ДанныеБюджетов.Валюта,
	               |	ВТ_ДанныеБюджетов.СтавкаНДС,
	               |	ВТ_ДанныеБюджетов.Организация";
	
	РезультатДоходы 	= Запрос.Выполнить();
	ТаблицаДоходы 		= РезультатДоходы.Выгрузить();
	
	//УТВЕРЖДЕН
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	CW_УтверждениеБюджетов.Объект КАК Объект,
	               |	CW_УтверждениеБюджетов.ВерсияБюджета КАК ВерсияБюджета
	               |ИЗ
	               |	РегистрСведений.CW_УтверждениеБюджетов КАК CW_УтверждениеБюджетов
	               |ГДЕ
	               |	CW_УтверждениеБюджетов.Объект = &ОбъектВКоторомУтверждаетсяБюджет
	               |	И CW_УтверждениеБюджетов.ВерсияБюджета = &ВерсияБюджета";
		
	Запрос.УстановитьПараметр("ОбъектВКоторомУтверждаетсяБюджет", ЗаказСсылка); // грузоперевозки по заказу можно утверждать только на уровне заказа
	Запрос.УстановитьПараметр("ВерсияБюджета"					, ВерсияБюджета);
	
	РезультатУтвержден 	= Запрос.Выполнить();

	Структура = Новый Структура(
		"тзЗатраты, тзДоходы, БюджетУтвержден, ВыборкаЗатраты, ВыборкаДоходы", 
		ТаблицаЗатрат, 
		ТаблицаДоходы,
		НЕ РезультатУтвержден.Пустой(),
		ВыборкаЗатраты,
		ВыборкаДоходы
		);

	Возврат Структура;
	
КонецФункции

Функция _ПолучитьТаблицуБюджетаДляРедактированияИзЗаказа(СтруктураОтбор, Грузоперевозка=Неопределено) Экспорт 

	Попытка 
		ВыбранаГруппа = СтруктураОтбор.ВыбранаГруппа;
	Исключение
		ВыбранаГруппа = Ложь
	КонецПопытки;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	CW_ПлановыеСтатьиЗатратИДоходов.Ссылка КАК СтатьяСсылка,
	               |	CW_ПлановыеСтатьиЗатратИДоходов.Владелец КАК Грузоперевозка,
	               |	CW_ПлановыеСтатьиЗатратИДоходов.ВидСтатьиПланирования КАК ВидСтатьиПланирования,
	               |	CW_ПлановыеСтатьиЗатратИДоходов.Контрагент КАК Контрагент,
	               |	CW_ПлановыеСтатьиЗатратИДоходов.Номенклатура КАК Номенклатура,
	               |	CW_ПлановыеСтатьиЗатратИДоходов.Валюта КАК Валюта,
	               |	CW_ПлановыеСтатьиЗатратИДоходов.СтавкаНДС КАК СтавкаНДС,
	               |	CW_ПлановыеСтатьиЗатратИДоходов.Курс КАК Курс,
	               |	CW_ПлановыеСтатьиЗатратИДоходов.Количество КАК Количество,
	               |	CW_ПлановыеСтатьиЗатратИДоходов.Сумма КАК Сумма,
	               |	CW_ПлановыеСтатьиЗатратИДоходов.СуммаНДС КАК СуммаНДС,
	               |	CW_ПлановыеСтатьиЗатратИДоходов.СуммаВсего КАК СуммаВсего,
	               |	CW_ПлановыеСтатьиЗатратИДоходов.СуммаРуб КАК СуммаРуб,
	               |	CW_ПлановыеСтатьиЗатратИДоходов.СуммаНДСРуб КАК СуммаНДСРуб,
	               |	CW_ПлановыеСтатьиЗатратИДоходов.СуммаВсегоРуб КАК СуммаВсегоРуб,
	               |	CW_ПлановыеСтатьиЗатратИДоходов.ПорядокОтраженияРасходов КАК ПорядокОтраженияРасходов,
	               |	CW_ПлановыеСтатьиЗатратИДоходов.ПорядокОтраженияДоходов КАК ПорядокОтраженияДоходов,
	               |	CW_ПлановыеСтатьиЗатратИДоходов.КонтрольнаяДатаКурсаДляПроверки КАК КонтрольнаяДатаКурсаДляПроверки,
	               |	CW_ПлановыеСтатьиЗатратИДоходов.Комментарий КАК Комментарий,
	               |	CW_ПлановыеСтатьиЗатратИДоходов.Договор КАК Договор,
	               |	CW_ПлановыеСтатьиЗатратИДоходов.ПриложениеКДоговору КАК ПриложениеКДоговору,
	               |	ЕСТЬNULL(CW_ПрогнозОплатыПлановыхСтатейБюджета.ПрогнозДата, ДАТАВРЕМЯ(1, 1, 1)) КАК ПлановаяДатаОплаты,
	               |	CW_ПлановыеСтатьиЗатратИДоходов.Цена КАК Цена,
	               |	CW_ПлановыеСтатьиЗатратИДоходов.ЦенаРуб КАК ЦенаРуб,
	               |	CW_ПлановыеСтатьиЗатратИДоходов.Кратность КАК Кратность,
	               |	ВЫБОР
	               |		КОГДА CW_ПлановыеСтатьиЗатратИДоходов.Владелец.ПометкаУдаления
	               |			ТОГДА 4
	               |		ИНАЧЕ 3 + ВЫБОР
	               |				КОГДА CW_ПлановыеСтатьиЗатратИДоходов.Владелец.Предопределенный
	               |					ТОГДА 2
	               |				ИНАЧЕ 0
	               |			КОНЕЦ
	               |	КОНЕЦ КАК ИндексКартинки
	               |ИЗ
	               |	Справочник.CW_ПлановыеСтатьиЗатратИДоходов КАК CW_ПлановыеСтатьиЗатратИДоходов
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.CW_ПрогнозОплатыПлановыхСтатейБюджета КАК CW_ПрогнозОплатыПлановыхСтатейБюджета
	               |		ПО CW_ПлановыеСтатьиЗатратИДоходов.Ссылка = CW_ПрогнозОплатыПлановыхСтатейБюджета.СтатьяБюджета
	               |ГДЕ
	               |	ВЫБОР
	               |			КОГДА &ВыбранВладелец
	               |				ТОГДА CW_ПлановыеСтатьиЗатратИДоходов.Владелец = &Владелец
	               |			ИНАЧЕ CW_ПлановыеСтатьиЗатратИДоходов.Владелец В
	               |					(ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |						CW_Грузоперевозки.Ссылка
	               |					ИЗ
	               |						Справочник.CW_Грузоперевозки КАК CW_Грузоперевозки
	               |					ГДЕ
	               |						CW_Грузоперевозки.Заказ = &Заказ)
	               |		КОНЕЦ
	               |	И CW_ПлановыеСтатьиЗатратИДоходов.ВерсияБюджета = &ВерсияБюджета
	               |	И CW_ПлановыеСтатьиЗатратИДоходов.ВидСтатьиПланирования = &ВидСтатьиПланирования
	               |	И ВЫБОР
	               |			КОГДА &ВыбранаГруппа
	               |				ТОГДА ИСТИНА
	               |			ИНАЧЕ CW_ПлановыеСтатьиЗатратИДоходов.Контрагент = &Контрагент
	               |					И CW_ПлановыеСтатьиЗатратИДоходов.Номенклатура = &Номенклатура
	               |					И CW_ПлановыеСтатьиЗатратИДоходов.СтавкаНДС = &СтавкаНДС
	               |					И CW_ПлановыеСтатьиЗатратИДоходов.Организация = &Организация
	               |					И CW_ПлановыеСтатьиЗатратИДоходов.Валюта = &Валюта
	               |		КОНЕЦ";
	
	Запрос.УстановитьПараметр("Заказ",                 СтруктураОтбор.ЗаказСсылка);
	Запрос.УстановитьПараметр("ВерсияБюджета",         СтруктураОтбор.ВерсияБюджета);
	Запрос.УстановитьПараметр("ВидСтатьиПланирования", СтруктураОтбор.ВидСтатьиПланирования);
	Запрос.УстановитьПараметр("Контрагент",            СтруктураОтбор.Контрагент);
	Запрос.УстановитьПараметр("Номенклатура",          СтруктураОтбор.Номенклатура);
	Запрос.УстановитьПараметр("Валюта",                СтруктураОтбор.Валюта);
	Запрос.УстановитьПараметр("СтавкаНДС",             СтруктураОтбор.СтавкаНДС);
	Запрос.УстановитьПараметр("Организация",           СтруктураОтбор.Организация);
	Запрос.УстановитьПараметр("ВыбранаГруппа",         ВыбранаГруппа);
	Запрос.УстановитьПараметр("Владелец",              Грузоперевозка);
	Запрос.УстановитьПараметр("ВыбранВладелец",        ЗначениеЗаполнено(Грузоперевозка));
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Функция _ПолучитьМассивГрузоперевозокДляДобавленияПриРедактированииИзЗаказа(структураОтбор) Экспорт 
	
	з = Новый Запрос(
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	CW_Грузоперевозки.Ссылка КАК Грузоперевозка
		|ПОМЕСТИТЬ вт
		|ИЗ
		|	Справочник.CW_Грузоперевозки КАК CW_Грузоперевозки
		|ГДЕ
		|	CW_Грузоперевозки.Заказ = &Заказ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	вт.Грузоперевозка
		|ИЗ
		|	вт КАК вт
		|ГДЕ
		|	НЕ вт.Грузоперевозка В
		|				(ВЫБРАТЬ РАЗЛИЧНЫЕ
		|					CW_ПлановыеСтатьиЗатратИДоходов.Владелец КАК Грузоперевозка
		|				ИЗ
		|					Справочник.CW_ПлановыеСтатьиЗатратИДоходов КАК CW_ПлановыеСтатьиЗатратИДоходов
		|				ГДЕ
		|					CW_ПлановыеСтатьиЗатратИДоходов.Владелец В
		|						(ВЫБРАТЬ РАЗЛИЧНЫЕ
		|							вт.Грузоперевозка
		|						ИЗ
		|							вт)
		|					И CW_ПлановыеСтатьиЗатратИДоходов.ВерсияБюджета = &ВерсияБюджета
		|					И (&ВидСтатьиПланирования = НЕОПРЕДЕЛЕНО
		|						ИЛИ CW_ПлановыеСтатьиЗатратИДоходов.ВидСтатьиПланирования = &ВидСтатьиПланирования)
		|					И (&Контрагент = НЕОПРЕДЕЛЕНО
		|						ИЛИ CW_ПлановыеСтатьиЗатратИДоходов.Контрагент = &Контрагент)
		|					И (&Номенклатура = НЕОПРЕДЕЛЕНО
		|						ИЛИ CW_ПлановыеСтатьиЗатратИДоходов.Номенклатура = &Номенклатура)
		|					И (&Валюта = НЕОПРЕДЕЛЕНО
		|						ИЛИ CW_ПлановыеСтатьиЗатратИДоходов.Валюта = &Валюта)
		|					И (&СтавкаНДС = НЕОПРЕДЕЛЕНО
		|						ИЛИ CW_ПлановыеСтатьиЗатратИДоходов.СтавкаНДС = &СтавкаНДС)
		|					И (&Организация = НЕОПРЕДЕЛЕНО
		|						ИЛИ CW_ПлановыеСтатьиЗатратИДоходов.Организация = &Организация))"
	);
	з.УстановитьПараметр("Заказ",                 структураОтбор.ЗаказСсылка);
	з.УстановитьПараметр("ВерсияБюджета",         структураОтбор.ВерсияБюджета);
	з.УстановитьПараметр("ВидСтатьиПланирования", структураОтбор.ВидСтатьиПланирования);
	з.УстановитьПараметр("Контрагент",            структураОтбор.Контрагент);
