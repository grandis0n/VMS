Функция ПолучитьРедактиуемыеРеквизитыОбъекта(Знач ИмяТаблицы) Экспорт
	
	Возврат Справочники.CW_ПлановыеСтатьиЗатратИДоходов.ПолучитьРедактируемыеРеквизитыОбъекта(ИмяТаблицы);
	
КонецФункции

Функция НачатьИзменениеРеквизитовВФоне(ПараметрыПроцедуры) Экспорт
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(Новый УникальныйИдентификатор);
	ПараметрыВыполнения.ОжидатьЗавершение 			= 0; // запускать сразу
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = "Редактирование реквизитов статей бюджета";
	ПараметрыВыполнения.ЗапуститьВФоне 				= Истина;
	ПараметрыВыполнения.ЗапуститьНеВФоне 			= ложь;
	
	Возврат ДлительныеОперации.ВыполнитьВФоне("Справочники.CW_ПлановыеСтатьиЗатратИДоходов.ВыполнитьИзменениеРеквитовОбъектов", ПараметрыПроцедуры, ПараметрыВыполнения);
	
КонецФункции 

Функция БюджетУтвержден(ВерсияБюджета, ОбъектыБюджета) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	CW_УтверждениеБюджетов.ВерсияБюджета КАК ВерсияБюджета
	|ИЗ
	|	РегистрСведений.CW_УтверждениеБюджетов КАК CW_УтверждениеБюджетов
	|ГДЕ
	|	CW_УтверждениеБюджетов.ВерсияБюджета = &ВерсияБюджета
	|	И CW_УтверждениеБюджетов.Объект В (&ОбъектыБюджета)"; 
	
	Запрос.УстановитьПараметр("ВерсияБюджета", ВерсияБюджета);
	Запрос.УстановитьПараметр("ОбъектыБюджета", ОбъектыБюджета);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат Не РезультатЗапроса.Пустой();
	
КонецФункции

Процедура РассчитатьПрогнозОплатыПриИзменениииПараметра(МассивСсылок, Параметр) Экспорт    
	
	Если Не ПолучитьФункциональнуюОпцию("CW_ИспользуетсяПрогнозированиеДДСПоБюджету") Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(Новый УникальныйИдентификатор);
	ПараметрыВыполнения.ОжидатьЗавершение   = 0;  // запускать сразу  
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = "";  
	ПараметрыВыполнения.ЗапуститьВФоне     	= Истина;  
	ПараметрыВыполнения.ЗапуститьНеВФоне    = ложь;   

	ПараметрыПроцедуры = Новый Структура;  
	ПараметрыПроцедуры.Вставить("МассивСсылок", МассивСсылок);  
	ПараметрыПроцедуры.Вставить("Параметр", 	Параметр);   

	ДлительныеОперации.ВыполнитьВФоне("CW_Бюджетирование.ВыполнитьРасчетПрогнозаОплатыПриИзменениииПараметра" ,ПараметрыПроцедуры, ПараметрыВыполнения);  
	
КонецПроцедуры    

Процедура ВыполнитьРасчетПрогнозаОплатыПриИзменениииПараметра(ПараметрыПроцедуры, АдресРезультата) Экспорт  
	
	Если ТипЗнч(ПараметрыПроцедуры.МассивСсылок) = Тип("Массив")
		И ПараметрыПроцедуры.МассивСсылок.Количество() > 0 Тогда 
		Если ТипЗнч(ПараметрыПроцедуры.МассивСсылок[0]) = Тип("СправочникСсылка.CW_Грузоперевозки") Тогда
			Владельцы = ПараметрыПроцедуры.МассивСсылок; 
		КонецЕсли;
		Если ТипЗнч(ПараметрыПроцедуры.МассивСсылок[0]) = Тип("СправочникСсылка.CW_Заказы") Тогда
			Владельцы = Справочники.CW_Заказы.ПолучитьМассивГрузоперевозокЗаказа(ПараметрыПроцедуры.МассивСсылок); 
		КонецЕсли;
	КонецЕсли;    
	
	Если Владельцы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	CW_ПлановыеСтатьиЗатратИДоходов.Ссылка КАК Ссылка,
	|	CW_ПлановыеСтатьиЗатратИДоходов.Владелец.ДатаСделкиФ КАК ДатаНачалаПеревозки,
	|	CW_ПлановыеСтатьиЗатратИДоходов.ВариантПрогноза КАК ВариантПрогноза,
	|	CW_ПлановыеСтатьиЗатратИДоходов.Владелец КАК Владелец,
	|	CW_ПлановыеСтатьиЗатратИДоходов.ПрогнозКонтрольнаяДата КАК ПрогнозКонтрольнаяДата,
	|	CW_ПлановыеСтатьиЗатратИДоходов.ПрогнозКоличествоДней КАК ПрогнозКоличествоДней,
	|	CW_ПлановыеСтатьиЗатратИДоходов.ПрогнозКоличествоДнейПлан КАК ПрогнозКоличествоДнейПлан
	|ИЗ
	|	Справочник.CW_ПлановыеСтатьиЗатратИДоходов КАК CW_ПлановыеСтатьиЗатратИДоходов
	|ГДЕ
	|	CW_ПлановыеСтатьиЗатратИДоходов.Владелец В(&Владельцы)
	|	И CW_ПлановыеСтатьиЗатратИДоходов.ВариантПрогноза = 1
	|	И CW_ПлановыеСтатьиЗатратИДоходов.ПрогнозКонтрольнаяДата = &Параметр";  
	
	Запрос.УстановитьПараметр("Владельцы", 	Владельцы);
	Запрос.УстановитьПараметр("Параметр", 	ПараметрыПроцедуры.Параметр);
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли;  
	
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		
		ПараметрыРасчета = Новый Структура;
		ПараметрыРасчета.Вставить("ВариантПрогноза", 			Выборка.ВариантПрогноза);
		ПараметрыРасчета.Вставить("Владелец", 					Выборка.Владелец);
		ПараметрыРасчета.Вставить("ПрогнозКонтрольнаяДата", 	Выборка.ПрогнозКонтрольнаяДата);
		ПараметрыРасчета.Вставить("ПрогнозКоличествоДней", 		Выборка.ПрогнозКоличествоДней);
		ПараметрыРасчета.Вставить("ПрогнозКоличествоДнейПлан", 	Выборка.ПрогнозКоличествоДнейПлан);
		
		ПараметрыРасчета.Вставить("ПрогнозДата",	 			Дата(1,1,1));
		ПараметрыРасчета.Вставить("ДатаНачалаПеревозки", 		Выборка.ДатаНачалаПеревозки);
		
		ПрогнозДата = Справочники.CW_ПлановыеСтатьиЗатратИДоходов.РассчитатьПрогнозОплатыСтатьиБюджета(ПараметрыРасчета); 
		
		РегистрыСведений.CW_ПрогнозОплатыПлановыхСтатейБюджета.ЗаписатьПрогнозОплаты(Выборка.Ссылка, ПрогнозДата);
		
	КонецЦикла;	
	
КонецПроцедуры