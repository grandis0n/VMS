	// --- 
	Если ТипЗнч(ОбъектСсылка) = Тип("СправочникСсылка.CW_Грузоперевозки") ИЛИ НЕ ЗначениеЗаполнено(ОбъектСсылка) Тогда 
		Запрос.УстановитьПараметр("Грузоперевозки", ОбъектСсылка);
	Иначе 
		Запрос.Текст = СтрЗаменить(
			Запрос.Текст, 
			"&Грузоперевозки", 
			"ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	CW_Грузоперевозки.Ссылка
			|ИЗ
			|	Справочник.CW_Грузоперевозки КАК CW_Грузоперевозки
			|ГДЕ
			|	CW_Грузоперевозки.Заказ = &Заказ"
		);
		Запрос.УстановитьПараметр("Заказ", ОбъектСсылка);
	КонецЕсли;
	// --- 
	ТЗ = Запрос.Выполнить().Выгрузить();
	// --- 
	Если Договор <> Неопределено Тогда
		
