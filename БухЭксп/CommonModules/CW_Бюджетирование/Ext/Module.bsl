Функция СкопироватьБюджеты(СтараяГрузоперевозка,НоваяГрузоперевозка,ВерсииБюджетов, ОчищатьПоказатели = Неопределено) Экспорт 
	// --- 
	
	Если (ОчищатьПоказатели = Неопределено) Тогда
		ОчищатьПоказатели = Ложь;
	КонецЕсли; 
	
	ПересчитыватьВалютныеСуммы = CW_Настройки.ПолучитьНастройкуПользователя(CW_Настройки.Пользователь(), "ПересчитыватьВалютныеСуммыПриКопированииБюджетов");
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	CW_ПлановыеСтатьиЗатратИДоходов.Ссылка
	|ИЗ
	|	Справочник.CW_ПлановыеСтатьиЗатратИДоходов КАК CW_ПлановыеСтатьиЗатратИДоходов
	|ГДЕ
	|	CW_ПлановыеСтатьиЗатратИДоходов.Владелец = &Владелец
	|	И CW_ПлановыеСтатьиЗатратИДоходов.ПометкаУдаления = ЛОЖЬ
	|	И CW_ПлановыеСтатьиЗатратИДоходов.ВерсияБюджета В (&ВерсииБюджетов)";
	Запрос.УстановитьПараметр("Владелец", СтараяГрузоперевозка);
	Запрос.УстановитьПараметр("ВерсииБюджетов", ВерсииБюджетов); 
	ТЗ = Запрос.Выполнить().Выгрузить();
	// --- 
	Попытка
		
		Для каждого СБ Из ТЗ Цикл
			
			нСБ = СБ.Ссылка.Скопировать();
			нСБ.Владелец = НоваяГрузоперевозка;
			Если (ОчищатьПоказатели) Тогда
				нСБ.ОчиститьПоказатели();
			КонецЕсли; 
			Если (ПересчитыватьВалютныеСуммы) Тогда 
				CW_Бюджетирование.ПересчитатьСтатьюБюджетаПоКурсу(нСБ);	
			КонецЕсли; 
			нСБ.Записать();
			
		КонецЦикла; 
		
	Исключение
	    Сообщить(ОписаниеОшибки());
		Возврат(_УФКС.Ответ(1));
	КонецПопытки; 
	
	Возврат(_УФКС.Ответ()); 
	
	// --- 
КонецФункции

Функция ПолучитьДатуКурсаПлановойСтатьи(Владелец, Параметр, Знач ДатаПоУмолчанию=Неопределено) Экспорт 
	
	ДатаПоУмолчанию = ?(ЗначениеЗаполнено(ДатаПоУмолчанию), ДатаПоУмолчанию, ТекущаяДата());

	ПолучитьПараметрЗаказа = Ложь;
	Если ТипЗнч(Владелец) = Тип("СправочникСсылка.CW_Грузоперевозки") Тогда
		ОсновнойРегистр = "CW_ХарактеристикиГрузоперевозок";
		ПолучитьПараметрЗаказа = Истина;    
		ВладелецХарактеристик 	= Владелец;
		Заказ 					= Владелец.Заказ
	ИначеЕсли ТипЗнч(Владелец) = Тип("СправочникСсылка.CW_ВариантыБюджетовПоЗаявкам") Тогда
		ОсновнойРегистр = "CW_ХарактеристикиЗаявок";	
		ВладелецХарактеристик = Владелец.Владелец;
	КонецЕсли;
	
	Запрос = Новый Запрос; 
	Запрос.УстановитьПараметр("Владелец", 	ВладелецХарактеристик);
	Запрос.УстановитьПараметр("Заказ", 		Заказ);
	Запрос.УстановитьПараметр("Параметр", 	Параметр);
	
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	|	CW_Характеристики.Параметр КАК Параметр,
	|	CW_Характеристики.Параметр.ЭтоКонтрольнаяДата КАК ЭтоКонтрольнаяДата,
	|	CW_Характеристики.Значение КАК Значение,
	|	CW_Характеристики.ЗначениеФакт КАК ЗначениеФакт
	|ИЗ
	|	РегистрСведений."+ОсновнойРегистр+" КАК CW_Характеристики
	|ГДЕ
	|	CW_Характеристики.Параметр = &Параметр
	|	//УсловиеВладелец";     
	
	Если ТипЗнч(Владелец) = Тип("СправочникСсылка.CW_Грузоперевозки") Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "//УсловиеВладелец", "И CW_Характеристики.Грузоперевозка = &Владелец");    
	КонецЕсли;
	Если ТипЗнч(Владелец) = Тип("СправочникСсылка.CW_ВариантыБюджетовПоЗаявкам") Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "//УсловиеВладелец", "И CW_Характеристики.Заявка = &Владелец");    
	КонецЕсли;
	
	РезультатЗапросаОсновной = Запрос.Выполнить();
	
	Если ПолучитьПараметрЗаказа и ЗначениеЗаполнено(Заказ) Тогда

		Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
		|	CW_ХарактеристикиЗаказов.Параметр КАК Параметр,
		|	CW_ХарактеристикиЗаказов.Параметр.ЭтоКонтрольнаяДата КАК ЭтоКонтрольнаяДата,
		|	CW_ХарактеристикиЗаказов.Значение КАК Значение,
		|	CW_ХарактеристикиЗаказов.ЗначениеФакт КАК ЗначениеФакт
		|ИЗ
		|	РегистрСведений.CW_ХарактеристикиЗаказов КАК CW_ХарактеристикиЗаказов
		|ГДЕ
		|	CW_ХарактеристикиЗаказов.Заказ = &Заказ
		|	И CW_ХарактеристикиЗаказов.Параметр = &Параметр";  
		
		РезультатЗапросаДополнительный = Запрос.Выполнить();
		
	КонецЕсли;  
	
	Ответ = Новый Структура("Дата,Автомат", Дата(1,1,1), Ложь);
	
	ВыборкаОсновной = РезультатЗапросаОсновной.Выбрать();
	Если ВыборкаОсновной.Следующий() Тогда 
		Если ВыборкаОсновной.ЭтоКонтрольнаяДата Тогда
			Ответ.Вставить("Дата", ВыборкаОсновной.ЗначениеФакт);
		Иначе
			Ответ.Вставить("Дата", ВыборкаОсновной.Значение);
		Конецесли;   
	КонецЕсли;
	
	Если ПолучитьПараметрЗаказа и ЗначениеЗаполнено(Заказ) и Не ЗначениеЗаполнено(Ответ.Дата) Тогда
		ВыборкаДополнительный = РезультатЗапросаДополнительный.Выбрать();
		Если ВыборкаДополнительный.Следующий() Тогда 
			Если ВыборкаДополнительный.ЭтоКонтрольнаяДата Тогда
				Ответ.Вставить("Дата", ВыборкаДополнительный.ЗначениеФакт);
			Иначе
				Ответ.Вставить("Дата", ВыборкаДополнительный.Значение);
			Конецесли;
		КонецЕсли;
	КонецЕсли; 
	
	Если Не ЗначениеЗаполнено(Ответ.Дата) Тогда
		Ответ.Вставить("Дата", 		ДатаПоУмолчанию);
		Ответ.Вставить("Автомат", 	Истина);
	КонецЕсли;
	
	Возврат Ответ;
	
КонецФункции	

Функция ПолучитьОсновнуюВерсиюБюджета() Экспорт
	
	ОсновнаяВерсияБюджета = CW_Настройки.ПолучитьНастройкуПользователя(ПараметрыСеанса.ТекущийПользователь, "ОсновнаяВерсияБюджета");
	
	Если Не ЗначениеЗаполнено(ОсновнаяВерсияБюджета) Тогда
		ОсновнаяВерсияБюджета  = Константы.CW_БазоваяВерсияБюджета.Получить();
	КонецЕсли;   
	
	Возврат  ОсновнаяВерсияБюджета
	
КонецФункции

Процедура РассчитатьПрогнозОплаты(ОбъектПрогноза) Экспорт
	
	ПараметрыПроцедуры = Новый Структура;
	ПараметрыПроцедуры.Вставить("ОбъектПрогноза", ОбъектПрогноза);
	
	мПараметрыПроцедуры = Новый Массив;
	мПараметрыПроцедуры.Добавить(ПараметрыПроцедуры);
	
	ФоновыеЗадания.Выполнить("CW_Бюджетирование.РассчитатьПрогнозОплатыВФоне", мПараметрыПроцедуры, , "Расчет прогноза оплты");

КонецПроцедуры   

Процедура РассчитатьПрогнозОплатыВФоне(ПараметрыПроцедуры, АдресРезультата=Неопределено) Экспорт
	
	МассивВладельцев = Новый Массив;
	Если ТипЗнч(ПараметрыПроцедуры.ОбъектПрогноза) = Тип("СправочникСсылка.CW_Грузоперевозки") Тогда
		МассивВладельцев.Добавить(ПараметрыПроцедуры.ОбъектПрогноза);
	ИначеЕсли ТипЗнч(ПараметрыПроцедуры.ОбъектПрогноза) = Тип("СправочникСсылка.CW_Заявки") Тогда  
		ЗаполнитьВладельцевБюджетаПоЗаявке(ПараметрыПроцедуры.ОбъектПрогноза, МассивВладельцев);
	ИначеЕсли ТипЗнч(ПараметрыПроцедуры.ОбъектПрогноза) = Тип("СправочникСсылка.CW_Заказы") Тогда  
		ЗаполнитьВладельцевБюджетаПоЗаказу(ПараметрыПроцедуры.ОбъектПрогноза, МассивВладельцев);
	Иначе 
		ВызватьИсключение "Неправильный объект расчета прогноза оплаты"; 
	КонецЕсли; 
	
	СтатьиБюджета = ПолучитьСтатьиБюджетаДляРасчета(МассивВладельцев);
	
	Справочники.CW_ПлановыеСтатьиЗатратИДоходов.РассчитатьПрогнозОплаты(СтатьиБюджета);
	
КонецПроцедуры  

Процедура ЗаполнитьВладельцевБюджетаПоЗаявке(Заявка, МассивВладельцев)  
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	CW_ВариантыБюджетовПоЗаявкам.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.CW_ВариантыБюджетовПоЗаявкам КАК CW_ВариантыБюджетовПоЗаявкам
	               |ГДЕ
	               |	CW_ВариантыБюджетовПоЗаявкам.Владелец = &Заявка
	               |	И CW_ВариантыБюджетовПоЗаявкам.ПометкаУдаления = ЛОЖЬ";  
	
	Запрос.УстановитьПараметр("Заявка", Заявка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл  
		Если МассивВладельцев.Найти(Выборка.Ссылка) = Неопределено Тогда
			МассивВладельцев.Добавить(Выборка.Ссылка);
		КонецЕсли;
	КонецЦикла; 
	
КонецПроцедуры

Процедура ЗаполнитьВладельцевБюджетаПоЗаказу(Заказ, МассивВладельцев)  
	
	МассивГрузоперевозок = Справочники.CW_Заказы.ПолучитьМассивГрузоперевозокЗаказа(Заказ);
	
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(МассивВладельцев, МассивГрузоперевозок, Истина);
	
КонецПроцедуры


Функция ПолучитьСтатьиБюджетаДляРасчета(МассивВладельцев)
	
	МассивСтатей = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	CW_ПлановыеСтатьиЗатратИДоходов.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.CW_ПлановыеСтатьиЗатратИДоходов КАК CW_ПлановыеСтатьиЗатратИДоходов
	               |ГДЕ
	               |	CW_ПлановыеСтатьиЗатратИДоходов.Владелец В(&Владелец)
	               |	И CW_ПлановыеСтатьиЗатратИДоходов.ПометкаУдаления = ЛОЖЬ
	               |	И CW_ПлановыеСтатьиЗатратИДоходов.ВариантПрогноза < 2"; 
	
	Запрос.УстановитьПараметр("Владелец", МассивВладельцев);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл  
		Если МассивСтатей.Найти(Выборка.Ссылка) = Неопределено Тогда
			МассивСтатей.Добавить(Выборка.Ссылка);
		КонецЕсли;
	КонецЦикла; 
	
	Возврат МассивСтатей;
	
КонецФункции


Функция ПолучитьЗначенияПараметров(ВладелецПараметров, МассивПараметров) Экспорт
	
	Соответствие = Новый Соответствие;
	
	Если ТипЗнч(ВладелецПараметров) = Тип("СправочникСсылка.CW_Грузоперевозки") Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	CW_ХарактеристикиГрузоперевозок.Параметр КАК Параметр,
		               |	CW_ХарактеристикиГрузоперевозок.Значение КАК Значение,
		               |	НЕОПРЕДЕЛЕНО КАК ЗначениеЗаказа
		               |ИЗ
		               |	РегистрСведений.CW_ХарактеристикиГрузоперевозок КАК CW_ХарактеристикиГрузоперевозок
		               |ГДЕ
		               |	CW_ХарактеристикиГрузоперевозок.Грузоперевозка = &Грузоперевозка
		               |	И CW_ХарактеристикиГрузоперевозок.Параметр В(&МассивПараметров)
		               |
		               |ОБЪЕДИНИТЬ ВСЕ
		               |
		               |ВЫБРАТЬ
		               |	CW_ХарактеристикиЗаказов.Параметр,
		               |	НЕОПРЕДЕЛЕНО,
		               |	CW_ХарактеристикиЗаказов.Значение
		               |ИЗ
		               |	РегистрСведений.CW_ХарактеристикиЗаказов КАК CW_ХарактеристикиЗаказов
		               |ГДЕ
		               |	CW_ХарактеристикиЗаказов.Заказ = &Заказ
		               |	И CW_ХарактеристикиЗаказов.Параметр В(&МассивПараметров)";      
		
		Запрос.УстановитьПараметр("Грузоперевозка",   ВладелецПараметров);
		Запрос.УстановитьПараметр("Заказ",   		  ВладелецПараметров.Заказ);
		Запрос.УстановитьПараметр("МассивПараметров", МассивПараметров);   
		
		РезультатЗапроса = Запрос.Выполнить();
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл 
			ЗначениеПараметра =  Выборка.Значение;
			Если НЕ ЗначениеЗаполнено(ЗначениеПараметра) Тогда
				ЗначениеПараметра = Выборка.ЗначениеЗаказа;
			КонецЕсли;
			Соответствие.Вставить(Выборка.Параметр, ЗначениеПараметра);
		КонецЦикла;
		
	КонецЕсли;    
	
	Если ТипЗнч(ВладелецПараметров) = Тип("СправочникСсылка.CW_ВариантыБюджетовПоЗаявкам") Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	CW_ХарактеристикиЗаявок.Параметр КАК Параметр,
		               |	CW_ХарактеристикиЗаявок.Значение КАК Значение
		               |ИЗ
		               |	РегистрСведений.CW_ХарактеристикиЗаявок КАК CW_ХарактеристикиЗаявок
		               |ГДЕ
		               |	CW_ХарактеристикиЗаявок.Параметр В(&МассивПараметров)
		               |	И CW_ХарактеристикиЗаявок.Заявка = &Заявка";      
		
		Запрос.УстановитьПараметр("Заявка",   			ВладелецПараметров.Владелец);
		Запрос.УстановитьПараметр("МассивПараметров", 	МассивПараметров);   
		
		РезультатЗапроса = Запрос.Выполнить();
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
			Соответствие.Вставить(Выборка.Параметр, Выборка.Значение);
		КонецЦикла;

	КонецЕсли;
	
	Возврат Соответствие;
	
КонецФункции

Функция ПолучитьНастройкиПараметровЗаполнения() Экспорт   
	
	Соответствие = Новый Соответствие;
	
	ПараметрДоговор = Константы.CW_ПараметрДоговораПлательщика.Получить();
	Соответствие.Вставить(ПараметрДоговор, "Договор");
	
	Если  ПолучитьФункциональнуюОпцию("CW_ВедетсяУчетПриложенийПоДоговорам") Тогда
		ПараметрПриложенияДоговора = Константы.CW_ПараметрПриложенияДоговора.Получить();
		Соответствие.Вставить(ПараметрПриложенияДоговора, 	"ПриложениеКДоговору");
	КонецЕсли;
	
	МассивПараметов = новый Массив; 
	Если ЗначениеЗаполнено(ПараметрДоговор) Тогда
		МассивПараметов.Добавить(ПараметрДоговор);
	КонецЕсли;
	Если ЗначениеЗаполнено(ПараметрПриложенияДоговора) Тогда
		МассивПараметов.Добавить(ПараметрПриложенияДоговора);
	КонецЕсли;     
	
	Структура = Новый Структура;
	Структура.Вставить("СоответствиеРеквизитов", 	Соответствие);
	Структура.Вставить("МассивПараметов", 			МассивПараметов);
	
	Возврат Структура;

КонецФункции


Функция ЗаполнитьБюджетыПоЗаявке(ПараметрыПроцедуры, АдресРезультата=Неопределено) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	РассчитыватьПрогнозОплаты = ПолучитьФункциональнуюОпцию("CW_ИспользуетсяПрогнозированиеДДСПоБюджету");
	
	Если ПараметрыПроцедуры.УдалитьСуществующиеСтатьиБюджета Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		|	CW_ПлановыеСтатьиЗатратИДоходов.Ссылка КАК Ссылка,
		|	CW_ПлановыеСтатьиЗатратИДоходов.Владелец КАК Владелец,
		|	CW_ПлановыеСтатьиЗатратИДоходов.ВерсияБюджета КАК ВерсияБюджета,
		|	CW_ПлановыеСтатьиЗатратИДоходов.ВидСтатьиПланирования КАК ВидСтатьиПланирования,
		|	CW_ПлановыеСтатьиЗатратИДоходов.Контрагент КАК Контрагент,
		|	CW_ПлановыеСтатьиЗатратИДоходов.Номенклатура КАК Номенклатура,
		|	CW_ПлановыеСтатьиЗатратИДоходов.Валюта КАК Валюта,
		|	CW_ПлановыеСтатьиЗатратИДоходов.Организация КАК Организация,
		|	CW_ПлановыеСтатьиЗатратИДоходов.ПорядокОтраженияРасходов КАК ПорядокОтраженияРасходов,
		|	CW_ПлановыеСтатьиЗатратИДоходов.ПорядокОтраженияДоходов КАК ПорядокОтраженияДоходов
		|ИЗ
		|	Справочник.CW_ПлановыеСтатьиЗатратИДоходов КАК CW_ПлановыеСтатьиЗатратИДоходов
		|ГДЕ
		|	CW_ПлановыеСтатьиЗатратИДоходов.Владелец В(&мГрузоперевозки)
		|	И CW_ПлановыеСтатьиЗатратИДоходов.ВерсияБюджета = &ВерсияБюджета";
		
		Запрос.УстановитьПараметр("мГрузоперевозки", 	ПараметрыПроцедуры.Грузоперевозки);
		Запрос.УстановитьПараметр("ВерсияБюджета", 		ПараметрыПроцедуры.ВерсияБюджетаГрузоперевозки);
		
		РезультатЗапроса = Запрос.Выполнить();
		ВыборкаСтатьиБюджетаГрузоперевозок = РезультатЗапроса.Выбрать();
		
		Если ПараметрыПроцедуры.РежимКопированияБюджета = 0 Тогда
			Пока ВыборкаСтатьиБюджетаГрузоперевозок.Следующий() Цикл
				СтатьяОбъект = ВыборкаСтатьиБюджетаГрузоперевозок.Ссылка.ПолучитьОбъект();
				Попытка
					СтатьяОбъект.Удалить();
				Исключение
					СтатьяОбъект.УстановитьПометкуУдаления(Истина);
				КонецПопытки;
			КонецЦикла;
			
			ВыборкаСтатьиБюджетаГрузоперевозок = Неопределено;
		КонецЕсли; 
		
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("СписокВариантовБюджета", ПараметрыПроцедуры.СписокВариантовБюджета); 
	
	Запрос.Текст = "ВЫБРАТЬ
	|	МАКСИМУМ(CW_ПлановыеСтатьиЗатратИДоходов.Ссылка) КАК Ссылка,
	|	CW_ПлановыеСтатьиЗатратИДоходов.ВидСтатьиПланирования КАК ВидСтатьиПланирования,
	|	CW_ПлановыеСтатьиЗатратИДоходов.Организация КАК Организация,
	|	CW_ПлановыеСтатьиЗатратИДоходов.Контрагент КАК Контрагент,
	|	CW_ПлановыеСтатьиЗатратИДоходов.Номенклатура КАК Номенклатура,
	|	CW_ПлановыеСтатьиЗатратИДоходов.Валюта КАК Валюта,
	|	CW_ПлановыеСтатьиЗатратИДоходов.ПорядокОтраженияРасходов КАК ПорядокОтраженияРасходов,
	|	CW_ПлановыеСтатьиЗатратИДоходов.ПорядокОтраженияДоходов КАК ПорядокОтраженияДоходов,
	|	CW_ПлановыеСтатьиЗатратИДоходов.ПорядокРаспределенияСуммы КАК ПорядокРаспределенияСуммы,
