&НаКлиенте
Функция ДекларацииОткрыть(УФ, Параметры)
	// --- 
	
	Если НЕ Параметры = Неопределено Тогда
		
		Элемент = Параметры.Элемент;
		РеквизитТаблица = Элемент.Имя;
		// --- 
		Если (Параметры.Свойство("ВыбраннаяСтрока")) Тогда
			
			РасчетДТ = УФ[РеквизитТаблица].НайтиПоИдентификатору(Параметры.ВыбраннаяСтрока).РасчетДТ;
			ПроектДТ = УФ[РеквизитТаблица].НайтиПоИдентификатору(Параметры.ВыбраннаяСтрока).ПроектДТ; 
			
		Иначе
			
			РасчетДТ = УФ[РеквизитТаблица].НайтиПоИдентификатору(Элемент.ТекущаяСтрока).РасчетДТ;
			ПроектДТ = УФ[РеквизитТаблица].НайтиПоИдентификатору(Элемент.ТекущаяСтрока).ПроектДТ; 
			
		КонецЕсли; 
	Иначе
		
		Если УФ.ТекущийЭлемент.ТекущиеДанные = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли; 
		
		РасчетДТ = УФ.ТекущийЭлемент.ТекущиеДанные.РасчетДТ;
		ПроектДТ = УФ.ТекущийЭлемент.ТекущиеДанные.ПроектДТ;
		
	КонецЕсли; 
		
	Попытка
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("Ключ", РасчетДТ);
		ПараметрыФормы.Вставить("Основание", ПроектДТ);
		ОткрытьФорму("Справочник.CW_РасчетыДТ.Форма.ФормаЭлемента", ПараметрыФормы,УФ);
	Исключение
	КонецПопытки; 
	
	// --- 
КонецФункции

