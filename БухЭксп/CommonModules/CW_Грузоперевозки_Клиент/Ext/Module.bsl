Процедура ОбработкаИзмененияДатыЗакрытия(Ответ, ДополнительныеПараметры) Экспорт
	// --- 
	
	Если (_УФКС.ВыполненоУспешно(Ответ)) Тогда
		
		ВыполнитьОбработкуОповещения(ДополнительныеПараметры.ПОВ,_УФКС.СД("Грузоперевозки","сервер","/ОбновитьДатуЗакрытия"));
		
	КонецЕсли; 
	
	// --- 
КонецПроцедуры

&НаКлиенте
Функция ОтображениеПримечания(УФ)
	// --- 
	
	Элементы = УФ.Элементы;
	
	Если Элементы.Примечание.Видимость Тогда
		
		Элементы.Примечание.Видимость = Ложь;
		
	Иначе
		
		Элементы.Примечание.Видимость = Истина;
		
	КонецЕсли; 
	
	Если ФормаГрузоперевозки(УФ) тогда
		
		Элементы.ДеревоПараметровОтображениеКомментария.Пометка = Элементы.Примечание.Видимость;
		
	ИначеЕсли ФормаЗаказа(УФ) Тогда
		
		Элементы.ЖурналФорма_ОтображениеПримечания.Пометка = Элементы.Примечание.Видимость;
	
	КонецЕсли;
	
	// --- 
КонецФункции

#Область Бюджет 

&НаКлиенте
Функция БюджетДобавить(УФ,Элемент, Копирование)
	
	Параметры 		= Новый Структура();
	РеквизитТаблица = Элемент.Имя;
	Грузоперевозка  = Неопределено;
	ЭтоДерево 		= Ложь;

	Если Элемент.Имя = "БюджетРасходы" или Элемент.Имя =  "БюджетРасходыДерево" Тогда
		
		ВидСтатьи = ПредопределенноеЗначение("Перечисление.CW_ВидыСтатейПланирования.Расходы");
		
		Если Элемент.Имя =  "БюджетРасходыДерево" и Не Элемент.ТекущаяСтрока = Неопределено Тогда
			ЭтоДерево = истина;
			СтрокаТаблицы = УФ["БюджетРасходыДерево"].НайтиПоИдентификатору(Элемент.ТекущаяСтрока);
			Если СтрокаТаблицы <> Неопределено Тогда
				СтрокаРодитель  =  СтрокаТаблицы.ПолучитьРодителя();
				Если   СтрокаРодитель <> Неопределено Тогда
					Грузоперевозка  = СтрокаРодитель.Контрагент;
				Иначе
					Грузоперевозка  = СтрокаТаблицы.Контрагент;
				КонецЕсли;
			Конецесли;
		КонецЕсли;
		
	ИначеЕсли Элемент.Имя = "БюджетДоходы" или  Элемент.Имя =  "БюджетДоходыДерево"  Тогда 
		
		ВидСтатьи = ПредопределенноеЗначение("Перечисление.CW_ВидыСтатейПланирования.Доходы"); 
		
		Если Элемент.Имя =  "БюджетДоходыДерево" и Не Элемент.ТекущаяСтрока = Неопределено Тогда
			ЭтоДерево = истина;
			СтрокаТаблицы = УФ["БюджетДоходыДерево"].НайтиПоИдентификатору(Элемент.ТекущаяСтрока);
			Если СтрокаТаблицы <> Неопределено Тогда
				СтрокаРодитель  =  СтрокаТаблицы.ПолучитьРодителя();
				Если   СтрокаРодитель <> Неопределено Тогда
					Грузоперевозка  = СтрокаРодитель.Контрагент;
				Иначе
					Грузоперевозка  = СтрокаТаблицы.Контрагент;
				КонецЕсли;
			Конецесли;
		КонецЕсли;
		
	КонецЕсли; 
	
	Если (ФормаГрузоперевозки(УФ)) Тогда
		
		СтруктураЗаполнения = Новый Структура;
		СтруктураЗаполнения.Вставить("ВерсияБюджета",         УФ.БюджетТекущаяВерсия);
		СтруктураЗаполнения.Вставить("ВидСтатьиПланирования", ВидСтатьи);
		СтруктураЗаполнения.Вставить("Владелец",              УФ.Объект.Ссылка);

		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("ТолькоПросмотр",        УФ.ТолькоПросмотр);
		ПараметрыФормы.Вставить("ЗначенияЗаполнения", СтруктураЗаполнения);
		Если (Копирование) Тогда
			ЗначениеКопирования = УФ[РеквизитТаблица].НайтиПоИдентификатору(Элемент.ТекущаяСтрока).СтатьяСсылка;
			ПараметрыФормы.Вставить("ЗначениеКопирования ", ЗначениеКопирования);
		КонецЕсли; 
		
		Если ВидСтатьи = ПредопределенноеЗначение("Перечисление.CW_ВидыСтатейПланирования.Доходы") Тогда
			СтруктураПараметров = Новый Структура;
			СтруктураПараметров.Вставить("Объект"				, УФ.Объект);
			СтруктураПараметров.Вставить("ЭтоВариантБюджета"	, Ложь);
			СтруктураПараметров.Вставить("Контрагент"			, УФ.Объект.Клиент);
			
			СтруктураЗаполнения.Вставить("Контрагент",CW_Финансы.ВернутьПлательщика(СтруктураПараметров));
		КонецЕсли; 
		
		ОткрытьФорму("Справочник.CW_ПлановыеСтатьиЗатратИДоходов.ФормаОбъекта", ПараметрыФормы, Элемент);	
		
	ИначеЕсли (ФормаЗаявки(УФ)) Тогда 
		
		СтруктураЗаполнения = Новый Структура;
		СтруктураЗаполнения.Вставить("ВерсияБюджета",         УФ.БюджетТекущаяВерсия);
		СтруктураЗаполнения.Вставить("ВидСтатьиПланирования", ВидСтатьи);
		СтруктураЗаполнения.Вставить("Владелец",              УФ.ВариантБюджета);
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("ТолькоПросмотр",        УФ.ТолькоПросмотр);
		ПараметрыФормы.Вставить("ЗначенияЗаполнения", СтруктураЗаполнения);
		Если (Копирование) Тогда
			ЗначениеКопирования = УФ[РеквизитТаблица].НайтиПоИдентификатору(Элемент.ТекущаяСтрока).СтатьяСсылка;
			ПараметрыФормы.Вставить("ЗначениеКопирования ", ЗначениеКопирования);
		КонецЕсли; 
		
		Если ВидСтатьи = ПредопределенноеЗначение("Перечисление.CW_ВидыСтатейПланирования.Доходы") Тогда
			
			СтруктураПараметров = Новый Структура;
			СтруктураПараметров.Вставить("Объект"				, УФ.Объект);
			СтруктураПараметров.Вставить("ЭтоВариантБюджета"	, Ложь);
			СтруктураПараметров.Вставить("Контрагент"			, УФ.Объект.Контрагент);
			
			СтруктураЗаполнения.Вставить("Контрагент",CW_Финансы.ВернутьПлательщика(СтруктураПараметров));
			
		КонецЕсли; 
		
		ОткрытьФорму("Справочник.CW_ПлановыеСтатьиЗатратИДоходов.ФормаОбъекта", ПараметрыФормы, Элемент);	
		
	ИначеЕсли (ФормаЗаказа(УФ)) Тогда 
		
		ДанныеЗаполнения = Новый Структура;
		ДанныеЗаполнения.Вставить("ЗаказСсылка",           УФ.Объект.Ссылка);
		ДанныеЗаполнения.Вставить("ВерсияБюджета",         УФ.БюджетТекущаяВерсия);
		ДанныеЗаполнения.Вставить("ВидСтатьиПланирования", ВидСтатьи);
		Если ВидСтатьи=ПредопределенноеЗначение("Перечисление.CW_ВидыСтатейПланирования.Доходы") Тогда
			ДанныеЗаполнения.Вставить("Контрагент", УФ.Объект.Клиент);
		КонецЕсли;
		ДанныеЗаполнения.Вставить("Грузоперевозка"	, Грузоперевозка);
		ДанныеЗаполнения.Вставить("Владелец"		, Грузоперевозка);
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("ТолькоПросмотр"	, УФ.ТолькоПросмотр);
		
		Если ЭтоДерево Тогда
			ПараметрыФормы.Вставить("ЗначенияЗаполнения"	, ДанныеЗаполнения);
			ОткрытьФорму("Справочник.CW_ПлановыеСтатьиЗатратИДоходов.ФормаОбъекта", ПараметрыФормы, Элемент);
		Иначе
			ПараметрыФормы.Вставить("ЗначенияЗаполнения"	, ДанныеЗаполнения);
			ОткрытьФорму("Справочник.CW_ПлановыеСтатьиЗатратИДоходов.Форма.ФормаРедактированияГруппыСтатей", ПараметрыФормы, Элемент);
		КонецЕсли;
		
	КонецЕсли; 
	                 
КонецФункции


&НаКлиенте
Функция БюджетОткрыть(УФ,Параметры)
	// --- 
	ЭтоДерево 		= Ложь;
	Отказ			= Ложь;

	Элемент = Параметры.Элемент;
	РеквизитТаблица = Элемент.Имя;
	// --- 
	Если (Параметры.Свойство("ВыбраннаяСтрока")) Тогда
		
		СтрокаТаблицы = УФ[РеквизитТаблица].НайтиПоИдентификатору(Параметры.ВыбраннаяСтрока);
		
	Иначе
		
		СтрокаТаблицы = УФ[РеквизитТаблица].НайтиПоИдентификатору(Элемент.ТекущаяСтрока);
		
	КонецЕсли; 
	
	Если Элемент.Имя = "БюджетРасходы"  Тогда
		
		ВидСтатьи = ПредопределенноеЗначение("Перечисление.CW_ВидыСтатейПланирования.Расходы");
		
	Иначеесли Элемент.Имя =  "БюджетРасходыДерево" Тогда
		
		ВидСтатьи 		= ПредопределенноеЗначение("Перечисление.CW_ВидыСтатейПланирования.Расходы");
		ЭтоДерево 		= Истина;
		СтрокаРодитель  =  СтрокаТаблицы.ПолучитьРодителя();
		
		Если СтрокаРодитель = Неопределено Тогда
			Отказ = истина;
		КонецЕсли;
		
	ИначеЕсли Элемент.Имя = "БюджетДоходы" Тогда 
		
		ВидСтатьи = ПредопределенноеЗначение("Перечисление.CW_ВидыСтатейПланирования.Доходы"); 
		
	ИначеЕсли Элемент.Имя =  "БюджетДоходыДерево"  Тогда 	
		
		ВидСтатьи 		= ПредопределенноеЗначение("Перечисление.CW_ВидыСтатейПланирования.Доходы"); 
		ЭтоДерево 		= Истина;
		СтрокаРодитель  =  СтрокаТаблицы.ПолучитьРодителя();
		
		Если СтрокаРодитель = Неопределено Тогда
			Отказ = истина;
		КонецЕсли;
		
	КонецЕсли;  
	// --- 
	Если (ФормаГрузоперевозки(УФ)) Тогда
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("Ключ", СтрокаТаблицы.СтатьяСсылка);
		ПараметрыФормы.Вставить("ТолькоПросмотр", УФ.БюджетУтвержден);
		// --- 
		ОткрытьФорму("Справочник.CW_ПлановыеСтатьиЗатратИДоходов.ФормаОбъекта", ПараметрыФормы, Элемент);
		
	ИначеЕсли (ФормаЗаявки(УФ)) Тогда 
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("Ключ", СтрокаТаблицы.СтатьяСсылка);
		ПараметрыФормы.Вставить("ТолькоПросмотр", УФ.БюджетУтвержден);
		// --- 
		ОткрытьФорму("Справочник.CW_ПлановыеСтатьиЗатратИДоходов.ФормаОбъекта", ПараметрыФормы, Элемент);
		
	ИначеЕсли (ФормаЗаказа(УФ)) Тогда
		
		Если ЭтоДерево и не Отказ Тогда
			
			ПараметрыФормы = Новый Структура;
			ПараметрыФормы.Вставить("Ключ", СтрокаТаблицы.СтатьяСсылка);
			ПараметрыФормы.Вставить("ТолькоПросмотр", УФ.БюджетУтвержден);
			
			ОткрытьФорму("Справочник.CW_ПлановыеСтатьиЗатратИДоходов.ФормаОбъекта", ПараметрыФормы, Элемент);
			
		Иначе
			ДанныеЗаполнения = Новый Структура();
			ДанныеЗаполнения.Вставить("ЗаказСсылка",           	УФ.Объект.Ссылка);
			ДанныеЗаполнения.Вставить("ВерсияБюджета",         	УФ.БюджетТекущаяВерсия);
			ДанныеЗаполнения.Вставить("ВидСтатьиПланирования", 	ВидСтатьи);
			ДанныеЗаполнения.Вставить("Контрагент",            	СтрокаТаблицы.Контрагент);
			ДанныеЗаполнения.Вставить("Номенклатура",          	СтрокаТаблицы.Номенклатура);
			ДанныеЗаполнения.Вставить("Валюта",                	СтрокаТаблицы.Валюта);
			ДанныеЗаполнения.Вставить("СтавкаНДС",             	СтрокаТаблицы.СтавкаНДС);
			ДанныеЗаполнения.Вставить("Организация",			СтрокаТаблицы.Организация);
			
			ПараметрыФормы = Новый Структура;
			ПараметрыФормы.Вставить("ЗначенияЗаполнения",		ДанныеЗаполнения);
			ПараметрыФормы.Вставить("ТолькоПросмотр", 			УФ.БюджетУтвержден);
			
			ОткрытьФорму("Справочник.CW_ПлановыеСтатьиЗатратИДоходов.Форма.ФормаРедактированияГруппыСтатей", ПараметрыФормы, Элемент);
			
		КонецЕсли;
	КонецЕсли; 
	
	// --- 
КонецФункции

&НаКлиенте
Функция БюджетУдалить(УФ, Параметры, ПроцедураОбратногоВызова)
	// --- 
	
	Элемент = Параметры.Элемент;
	РеквизитТаблица = Элемент.Имя;
	
	Если (УФ.БюджетУтвержден) Тогда
		
		Возврат(Неопределено);
		
	КонецЕсли; 
	
	Если (ФормаГрузоперевозки(УФ) ИЛИ ФормаЗаявки(УФ)) Тогда
		
		СтатьяСсылка = УФ[РеквизитТаблица].НайтиПоИдентификатору(Элемент.ТекущаяСтрока).СтатьяСсылка;
		ПОВ = Новый ОписаниеОповещения("ОбработкаВопросаУдаленияСтрокиБюджета",ЭтотОбъект,Новый Структура("Аналитика,ПОВ",СтатьяСсылка,ПроцедураОбратногоВызова));		
		
	Иначе
		Грузоперевозка = Неопределено;
		СтрокаТаблицы = УФ[РеквизитТаблица].НайтиПоИдентификатору(Элемент.ТекущаяСтрока);
		
		Если Элемент.Имя = "БюджетРасходы" ИЛИ Элемент.Имя = "БюджетРасходыДерево" Тогда
			
			ВидСтатьи = ПредопределенноеЗначение("Перечисление.CW_ВидыСтатейПланирования.Расходы");
			
		ИначеЕсли Элемент.Имя = "БюджетДоходы" ИЛИ Элемент.Имя = "БюджетДоходыДерево" Тогда 
			
			ВидСтатьи = ПредопределенноеЗначение("Перечисление.CW_ВидыСтатейПланирования.Доходы"); 
			
		КонецЕсли;
		
		ВыбранаГруппа = Ложь;
		Если Элемент.Имя = "БюджетРасходыДерево" ИЛИ   Элемент.Имя = "БюджетДоходыДерево" тогда
			СтрокаРодитель  =  СтрокаТаблицы.ПолучитьРодителя();
			Если СтрокаРодитель <> Неопределено Тогда
				Грузоперевозка  = СтрокаРодитель.Контрагент;
			Иначе
				Грузоперевозка  = СтрокаТаблицы.Контрагент;
				ВыбранаГруппа 	= Истина;
			КонецЕсли;
		КонецЕсли;
		
		Отбор = Новый Структура;
		Отбор.Вставить("ЗаказСсылка",           УФ.Объект.Ссылка);
		Отбор.Вставить("ВерсияБюджета",         УФ.БюджетТекущаяВерсия);
		Отбор.Вставить("ВидСтатьиПланирования", ВидСтатьи);
		Отбор.Вставить("Контрагент",            СтрокаТаблицы.Контрагент);
		Отбор.Вставить("Номенклатура",          СтрокаТаблицы.Номенклатура);
		Отбор.Вставить("Валюта",                СтрокаТаблицы.Валюта);
		Отбор.Вставить("СтавкаНДС",             СтрокаТаблицы.СтавкаНДС);
		Отбор.Вставить("Организация",           СтрокаТаблицы.Организация);
		Отбор.Вставить("Грузоперевозка",        Грузоперевозка);
		Отбор.Вставить("ВыбранаГруппа",         ВыбранаГруппа);
		
		ПОВ = Новый ОписаниеОповещения("ОбработкаВопросаУдаленияСтрокиБюджета",ЭтотОбъект,Новый Структура("Аналитика,ПОВ",Отбор,ПроцедураОбратногоВызова));		
		
	КонецЕсли; 
	
	ПоказатьВопрос(ПОВ,
			"Удалить строку?
			|Отменить удаление будет невозможно."
			, РежимДиалогаВопрос.ОКОтмена);
	
	// --- 
КонецФункции


&НаКлиенте
