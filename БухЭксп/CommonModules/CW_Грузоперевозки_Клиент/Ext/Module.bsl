&НаКлиенте
Функция БюджетЗаполнитьДоходыПоРасходам(УФ, ДоходыВРасходы = Ложь, РежимДерево = ложь)
	// --- 
	Грузоперевозка = Неопределено;
	
	Если  РежимДерево тогда
		Если ДоходыВРасходы Тогда
			Элемент = УФ.Элементы.БюджетДоходыДерево;
		Иначе
			Элемент = УФ.Элементы.БюджетРасходыДерево;
		КонецЕсли;
	Иначе
		Если ДоходыВРасходы Тогда
			Элемент = УФ.Элементы.БюджетДоходы;
		Иначе
			Элемент = УФ.Элементы.БюджетРасходы;
		КонецЕсли;
	КонецЕсли;
	РеквизитТаблица = Элемент.Имя;
	// --- 
	МассивСтрок = Новый Массив;
	
	
	Для каждого ВыделеннаяСтрока Из Элемент.ВыделенныеСтроки Цикл
		СтрокаТаблицы = УФ[РеквизитТаблица].НайтиПоИдентификатору(ВыделеннаяСтрока);
		Если (СтрокаТаблицы <> Неопределено) Тогда
			МассивСтрок.Добавить(СтрокаТаблицы);	
		КонецЕсли; 
	КонецЦикла; 
	// --- 
	Если (МассивСтрок.Количество() <> 0) Тогда
		
		Если (ФормаГрузоперевозки(УФ)) Тогда
			
			МассивСсылок = Новый Массив;
			Для каждого СтрокаТаблицы Из МассивСтрок Цикл
				МассивСсылок.Добавить(СтрокаТаблицы.СтатьяСсылка);
			КонецЦикла; 
			ПараметрыЗаполнения = Новый Структура;
			ПараметрыЗаполнения.Вставить("Объект"			, УФ.Объект.Ссылка);
			ПараметрыЗаполнения.Вставить("ВерсияБюджета"	, УФ.БюджетТекущаяВерсия);
			ПараметрыЗаполнения.Вставить("МассивСсылок"		, МассивСсылок);
			ПараметрыЗаполнения.Вставить("ДоходыВРасходы"	, ДоходыВРасходы);
			ПараметрыЗаполнения.Вставить("РежимДерево"		, РежимДерево);
			
			Возврат(_УФКС.СД("Грузоперевозки","сервер","/БюджетЗаполнитьДоходыПоРасходам",ПараметрыЗаполнения));	
			
		ИначеЕсли (ФормаЗаказа(УФ)) Тогда 
			
			Если РежимДерево тогда
				
				ПараметрыЗаполнения = Новый Структура;
				ПараметрыЗаполнения.Вставить("Объект"			, УФ.Объект.Ссылка);
				ПараметрыЗаполнения.Вставить("ВерсияБюджета"	, УФ.БюджетТекущаяВерсия);
				ПараметрыЗаполнения.Вставить("ДоходыВРасходы"	, ДоходыВРасходы);
				ПараметрыЗаполнения.Вставить("РежимДерево"		, РежимДерево);
				
				МассивСсылок = Новый Массив;
				
				Для каждого СтрокаТаблицы Из МассивСтрок Цикл
					
					СтрокаРодитель  = СтрокаТаблицы.ПолучитьРодителя();
					Если СтрокаРодитель <> Неопределено тогда
						
						Если МассивСсылок.Найти(СтрокаТаблицы.СтатьяСсылка) = Неопределено Тогда
							МассивСсылок.Добавить(СтрокаТаблицы.СтатьяСсылка);
						КонецЕсли;
						
					Иначе //Это родитель
						
						мСтрокиТаблицы = СтрокаТаблицы.ПолучитьЭлементы();
						Для каждого СтрокаМассива Из мСтрокиТаблицы Цикл
							Если МассивСсылок.Найти(СтрокаМассива.СтатьяСсылка) = Неопределено Тогда
								МассивСсылок.Добавить(СтрокаМассива.СтатьяСсылка);
							КонецЕсли;
						КонецЦикла;
						
					КонецЕсли;
					
				КонецЦикла;
				
				ПараметрыЗаполнения.Вставить("МассивСсылок", МассивСсылок);
				
				Возврат(_УФКС.СД("Грузоперевозки","сервер","/БюджетЗаполнитьДоходыПоРасходам",ПараметрыЗаполнения)); 
				
			Иначе
				
				
				МассивСтруктур = Новый Массив;
				Для каждого СтрокаТаблицы Из МассивСтрок Цикл
					
					СтруктураСтроки = Новый Структура();
					СтруктураСтроки.Вставить("Заказ",		           	УФ.Объект.Ссылка);
					СтруктураСтроки.Вставить("ВерсияБюджета",         	УФ.БюджетТекущаяВерсия);
					СтруктураСтроки.Вставить("Номенклатура",          	СтрокаТаблицы.Номенклатура);
					СтруктураСтроки.Вставить("Валюта",                	СтрокаТаблицы.Валюта);
					СтруктураСтроки.Вставить("СтавкаНДС",             	СтрокаТаблицы.СтавкаНДС);
					СтруктураСтроки.Вставить("Организация",				СтрокаТаблицы.Организация);
					СтруктураСтроки.Вставить("Контрагент",            	СтрокаТаблицы.Контрагент);
					
					СтруктураСтроки.Вставить("Грузоперевозка"			, Неопределено);
					СтруктураСтроки.Вставить("ГрузоперевозкаВыбрана"	, Ложь);
					
					МассивСтруктур.Добавить(СтруктураСтроки);
					
				КонецЦикла; 
				
				ПараметрыЗаполнения = Новый Структура;
				ПараметрыЗаполнения.Вставить("Объект"				, УФ.Объект.Ссылка);
				ПараметрыЗаполнения.Вставить("ВерсияБюджета"		, УФ.БюджетТекущаяВерсия);
				ПараметрыЗаполнения.Вставить("МассивСсылок"			, МассивСтруктур);
				ПараметрыЗаполнения.Вставить("ДоходыВРасходы"		, ДоходыВРасходы);
				ПараметрыЗаполнения.Вставить("РежимДерево"		, РежимДерево);
				
				// --- 
				Возврат(_УФКС.СД("Грузоперевозки","сервер","/БюджетЗаполнитьДоходыПоРасходам",ПараметрыЗаполнения));
				
			КонецЕсли;
		КонецЕсли; 
		
	КонецЕсли; 	
	
	// --- 
КонецФункции

&НаКлиенте
Функция ПересчетСтатейБюджетаПоКурсу(УФ, ВидСтатьиБюджета, ПроцедураОбратногоВызова, Грузоперевозка = Неопределено)
	
	ПОВ = Новый ОписаниеОповещения("ОбработкаВыбораДатыКурса",ЭтотОбъект, Новый Структура("ПОВ,ВидСтатьиБюджета,Грузоперевозка",ПроцедураОбратногоВызова, ВидСтатьиБюджета,Грузоперевозка)); 
	
	ДатаКурса = ТекущаяДата();
	ПоказатьВводДаты(ПОВ, ДатаКурса, "Дата курса", ЧастиДаты.Дата);
	
КонецФункции

&НаКлиенте
Процедура ОбработкаВыбораДатыКурса(Ответ, ДополнительныеПараметры) Экспорт 
	// --- 
	
	Если (Ответ <> Неопределено) Тогда
		
		Если (Ответ <> Дата(1,1,1)) Тогда
			
			ВыполнитьОбработкуОповещения(ДополнительныеПараметры.ПОВ,_УФКС.СД("Грузоперевозки","сервер","/ПересчетСтатейБюджетаПоКурсу",Новый Структура("Грузоперевозка,ВидСтатьиБюджета,ДатаКурса,ТипКурсаВалюты",ДополнительныеПараметры.Грузоперевозка,ДополнительныеПараметры.ВидСтатьиБюджета,Ответ,1)));
			
		КонецЕсли; 
		
	КонецЕсли; 
	
	// --- 
КонецПроцедуры
  

