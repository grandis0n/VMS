&НаКлиенте
Функция ВыполнитьДействие(УФ, СтруктураДействия, ПроцедураОбратногоВызова = Неопределено) Экспорт 
	
	ИмяКоманды = СтруктураДействия.Команда;
	Параметры = СтруктураДействия.Параметры;

	Отладка = УФ.Отладка;
	Если (Отладка) Тогда
		Сообщить("Клиент: """+ИмяКоманды+"""");
	КонецЕсли; 
	
	Если (ИмяКоманды = "/Предупреждение") Тогда 
		
		_УФК.ВывестиПредупреждение(Параметры);
		Возврат(Неопределено);
		
	ИначеЕсли (ИмяКоманды = "/ФормаЗаписать") Тогда
		
		Возврат(ЗаписатьФорму(УФ));
		
	#Область Бюджет 
	
	ИначеЕсли (ИмяКоманды = "/БюджетИнициализация") Тогда
		
		// проксируется на сервер
		Возврат(_УФКС.СД("Грузоперевозки","сервер",ИмяКоманды));
		
	ИначеЕсли (ИмяКоманды = "/БюджетВыбратьИзСписка") Тогда
		
		Возврат(БюджетВыбратьИзСписка(УФ));
		
	ИначеЕсли (ИмяКоманды = "/БюджетВыбрать") Тогда
		
		Возврат(БюджетВыбрать(УФ,ПроцедураОбратногоВызова));
		
	ИначеЕсли (ИмяКоманды = "/БюджетОбновить") Тогда
		
		// проксируется на сервер
		Возврат(_УФКС.СД("Грузоперевозки","сервер",ИмяКоманды));
		
	ИначеЕсли ИмяКоманды = "/БюджетРасходыОбновить"  Тогда
		
		// проксируется на сервер
		Возврат(_УФКС.СД("Грузоперевозки","сервер",ИмяКоманды));
		
	ИначеЕсли ИмяКоманды = "/БюджетДоходыОбновить" Тогда
		
		// проксируется на сервер
		Возврат(_УФКС.СД("Грузоперевозки","сервер",ИмяКоманды));
		
	ИначеЕсли (ИмяКоманды = "/БюджетДобавить") Тогда
		
		Возврат(БюджетДобавить(УФ,Параметры.Элемент,Параметры.Копирование));
		
	ИначеЕсли (ИмяКоманды = "/БюджетОткрыть") Тогда
		
		Возврат(БюджетОткрыть(УФ,Параметры));
		
	ИначеЕсли (ИмяКоманды = "/БюджетУдалить") Тогда
		
		Возврат(БюджетУдалить(УФ,Параметры,ПроцедураОбратногоВызова));
		
	ИначеЕсли (ИмяКоманды = "/БюджетКонтрагенты") Тогда
		
		Если (Параметры = Неопределено) Тогда
			Возврат(_УФКС.СД("Грузоперевозки","сервер","/БюджетКонтрагентыПолучить"));
		Иначе
			Возврат(БюджетКонтрагенты(УФ,Параметры,ПроцедураОбратногоВызова));	
		КонецЕсли; 
		
	ИначеЕсли (ИмяКоманды = "/БюджетЗаполнить") Тогда
		
		Возврат(_УФКС.СД("Грузоперевозки","сервер","/БюджетЗаполнитьОбработкиЗаполнения"));
		
	ИначеЕсли ИмяКоманды = "/БюджетЗаполнитьДоходыПоРасходам"  Тогда
		
		Возврат(БюджетЗаполнитьДоходыПоРасходам(УФ,Ложь, Ложь));
		
	ИначеЕсли ИмяКоманды = "/БюджетЗаполнитьДоходыПоРасходамДерево"  Тогда
		
		Возврат(БюджетЗаполнитьДоходыПоРасходам(УФ, Ложь ,Истина));
		
	ИначеЕсли  ИмяКоманды = "/БюджетЗаполнитьРасходыПоДоходам"  Тогда

		Возврат(БюджетЗаполнитьДоходыПоРасходам(УФ,Истина, Ложь));
	
	ИначеЕсли ИмяКоманды = "/БюджетЗаполнитьРасходыПоДоходамДерево"  Тогда
		
		Возврат(БюджетЗаполнитьДоходыПоРасходам(УФ,Истина ,Истина));
		
	ИначеЕсли ИмяКоманды = "/БюджетРасходыПересчитатьПоКурсу" Тогда
		
		ВидСтатьи = ПредопределенноеЗначение("Перечисление.CW_ВидыСтатейПланирования.Расходы");
		Возврат(ПересчетСтатейБюджетаПоКурсу(УФ, ВидСтатьи, ПроцедураОбратногоВызова));
		
	ИначеЕсли ИмяКоманды = "/БюджетРасходыДеревоПересчитатьПоКурсу" Тогда
		
		СтрокаТаблицы = УФ.БюджетРасходыДерево.НайтиПоИдентификатору(УФ.Элементы.БюджетРасходыДерево.ТекущаяСтрока);
		Если СтрокаТаблицы <> Неопределено Тогда
			СтрокаРодитель  =  СтрокаТаблицы.ПолучитьРодителя();
			Если   СтрокаРодитель <> Неопределено Тогда
				Грузоперевозка  = СтрокаРодитель.Контрагент;
			Иначе
				Грузоперевозка  = СтрокаТаблицы.Контрагент;
			КонецЕсли;
		Конецесли;

		ВидСтатьи = ПредопределенноеЗначение("Перечисление.CW_ВидыСтатейПланирования.Расходы");
		Возврат(ПересчетСтатейБюджетаПоКурсу(УФ, ВидСтатьи, ПроцедураОбратногоВызова,Грузоперевозка));
		
	ИначеЕсли ИмяКоманды = "/БюджетДоходыПересчитатьПоКурсу"  Тогда
		
		ВидСтатьи = ПредопределенноеЗначение("Перечисление.CW_ВидыСтатейПланирования.Доходы");
		Возврат(ПересчетСтатейБюджетаПоКурсу(УФ, ВидСтатьи, ПроцедураОбратногоВызова));
		
	ИначеЕсли ИмяКоманды = "/БюджетДоходыДеревоПересчитатьПоКурсу" Тогда
		
		СтрокаТаблицы = УФ.БюджетДоходыДерево.НайтиПоИдентификатору(УФ.Элементы.БюджетДоходыДерево.ТекущаяСтрока);
		Если СтрокаТаблицы <> Неопределено Тогда
			СтрокаРодитель  =  СтрокаТаблицы.ПолучитьРодителя();
			Если   СтрокаРодитель <> Неопределено Тогда
				Грузоперевозка  = СтрокаРодитель.Контрагент;
			Иначе
				Грузоперевозка  = СтрокаТаблицы.Контрагент;
			КонецЕсли;
		Конецесли;

		ВидСтатьи = ПредопределенноеЗначение("Перечисление.CW_ВидыСтатейПланирования.Расходы");
		Возврат(ПересчетСтатейБюджетаПоКурсу(УФ, ВидСтатьи, ПроцедураОбратногоВызова,Грузоперевозка));
		
	#КонецОбласти 
	
	#Область Финансы
	
	ИначеЕсли (ИмяКоманды = "/ФинансыОбновить") Тогда 
		
		// проксируется на сервер
		Возврат(_УФКС.СД("Грузоперевозки","сервер",ИмяКоманды));
		
	ИначеЕсли (ИмяКоманды = "/ФинансыРасходыОбновить") Тогда
		
		// проксируется на сервер
		Возврат(_УФКС.СД("Грузоперевозки","сервер",ИмяКоманды));
		
	ИначеЕсли (ИмяКоманды = "/ФинансыТранспортОбновить") Тогда
		
		// проксируется на сервер
		Возврат(_УФКС.СД("Грузоперевозки","сервер",ИмяКоманды));
		
	ИначеЕсли (ИмяКоманды = "/ФинансыДоходыОбновить") Тогда
		
		// проксируется на сервер
		Возврат(_УФКС.СД("Грузоперевозки","сервер",ИмяКоманды));	
		
	ИначеЕсли (ИмяКоманды = "/ФинансыДобавить") Тогда
		
		Возврат(ФинансыДобавить(УФ,Параметры.Элемент,Параметры.Копирование));
		
	ИначеЕсли (ИмяКоманды = "/ФинансыОткрыть") Тогда
		
		Возврат(ФинансыОткрыть(УФ,Параметры));
		
	ИначеЕсли (ИмяКоманды = "/ФинансыУдалить") Тогда
		
		Возврат(ФинансыУдалить(УФ,Параметры, ПроцедураОбратногоВызова));
		
	ИначеЕсли (ИмяКоманды = "/ФинансыРасходыОтобразитьСтатьи") Тогда
		
		Возврат(ФинансыРасходыОтобразитьСтатьи(УФ));
		
	ИначеЕсли (ИмяКоманды = "/ФинансыТранспортОтобразитьСтатьи") Тогда
		
		Возврат(ФинансыТраснпортОтобразитьСтатьи(УФ));

	ИначеЕсли (ИмяКоманды = "/ФинансыДоходыОтобразитьСтатьи") Тогда
		
		Возврат(ФинансыДоходыОтобразитьСтатьи(УФ));
		
	ИначеЕсли (ИмяКоманды = "/ФинансыРасходыДобавитьПоБюджету") Тогда
		
		Возврат(ФинансыРасходыДобавитьПоБюджету(УФ, ПроцедураОбратногоВызова));
		
	ИначеЕсли (ИмяКоманды = "/ФинансыДоходыДобавитьПоБюджету") Тогда
		
		Возврат(ФинансыДоходыДобавитьПоБюджету(УФ,ПроцедураОбратногоВызова));
		
	#КонецОбласти 
	
	#Область Декларации
	
	ИначеЕсли (ИмяКоманды = "/ДекларацииОбновить") Тогда 
		
		// проксируется на сервер
		Возврат(_УФКС.СД("Грузоперевозки","сервер",ИмяКоманды));

	ИначеЕсли (ИмяКоманды = "/ДекларацииОткрыть") Тогда
		
		Возврат(ДекларацииОткрыть(УФ,Параметры));
	
	#КонецОбласти
	
	#Область Параметры 
		
	ИначеЕсли (ИмяКоманды = "/ПерезаполнитьПараметрыПоШаблону") Тогда
		
		Возврат(ПерезаполнитьПараметрыПоШаблону(УФ, ПроцедураОбратногоВызова));
		
	ИначеЕсли (ИмяКоманды = "/ЗаполнитьПредопределенныеЗначенияПараметровДляРеквизита") Тогда
		
		// проксируется на сервер
		Возврат(_УФКС.СД("Грузоперевозки","сервер",ИмяКоманды,Параметры));
		
	ИначеЕсли (ИмяКоманды = "/ПерезаполнитьПредопределенныеПараметры") Тогда
		
		// проксируется на сервер
		Возврат(ПерезаполнитьПредопределенныеПараметры(УФ,Параметры));
	
	ИначеЕсли (ИмяКоманды = "/ДеревоПараметровСвернутьВсе") Тогда
		
		// проксируется на сервер
		Возврат(ДеревоПараметровСвернутьВсе(УФ));
		
	ИначеЕсли (ИмяКоманды = "/ДеревоПараметровРазвернутьВсе") Тогда
		
		// проксируется на сервер
		Возврат(ДеревоПараметровРазвернутьВсе(УФ));
		
	ИначеЕсли (ИмяКоманды = "/СохранитьСостояниеСвертки") Тогда
		
		// проксируется на сервер
		Возврат(СохранитьСостояниеСвертки(УФ));
		
	ИначеЕсли (ИмяКоманды = "/ВосстановитьСостояниеСвертки") Тогда
		
		// проксируется на сервер
		Возврат(ВосстановитьСостояниеСвертки(УФ));
		
	#КонецОбласти 
		
	#Область Отчеты 
	
	ИначеЕсли (ИмяКоманды = "/ОтчетПоГрузоперевозке") Тогда
		
		Возврат(ОтчетПоГрузоперевозке(УФ));
		
	ИначеЕсли (ИмяКоманды = "/ОтчетНеперевыставленныеЗатраты") Тогда
		
		Возврат(ОтчетНеперевыставленныеЗатраты(УФ));
		
	ИначеЕсли (ИмяКоманды = "/ОтчетПланФакторныйАнализБюджета") Тогда
		
		Возврат(ОтчетПланФакторныйАнализБюджета(УФ));
		
	ИначеЕсли (ИмяКоманды = "/ОтчетНеактированныеВходящиеСчета") Тогда
		
		Возврат(ОтчетНеактированныеВходящиеСчета(УФ));
		
	ИначеЕсли (ИмяКоманды = "/ОтчетНеактированныеИсходящиеСчета") Тогда
		
		Возврат(ОтчетНеактированныеИсходящиеСчета(УФ));
		
	ИначеЕсли (ИмяКоманды = "/ОтчетАнализПрибыли") Тогда

		Возврат(ОтчетАнализПрибыли(УФ));
		
	#КонецОбласти 
	
	ИначеЕсли (ИмяКоманды = "/ИзменитьДатуЗакрытия") Тогда
		
		Возврат(ИзменитьДатуЗакрытия(УФ, ПроцедураОбратногоВызова));
		
	ИначеЕсли (ИмяКоманды = "/ОтображениеПримечания") Тогда
		
		Возврат(ОтображениеПримечания(УФ));
	
	ИначеЕсли (ИмяКоманды = "/Предупреждение") Тогда 
		
		_УФК.ВывестиПредупреждение(Параметры);
		Возврат(Неопределено);
		
	Иначе 
		
		Сообщить("Клиент: неизвестная команда """+ИмяКоманды+"""");
		Возврат(Неопределено);
		
	КонецЕсли;
	
КонецФункции

