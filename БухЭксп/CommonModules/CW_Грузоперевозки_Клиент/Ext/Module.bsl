#Область Финансы 

&НаКлиенте
Функция ФинансыДобавить(УФ,Элемент, Копирование)
	// --- 
	
	РеквизитТаблица = Элемент.Имя;
	Если (Элемент.Имя = "ФинансыРасходы") Тогда
		
		ИмяФормы = "Документ.CW_РасходыПоГрузоперевозке.ФормаОбъекта";
		
	ИначеЕсли (Элемент.Имя = "ФинансыДоходы") Тогда 
		
		ИмяФормы = "Документ.CW_ДоходыПоГрузоперевозке.ФормаОбъекта";
		
	КонецЕсли; 
		
	// --- 
	ПараметрыФормы = Новый Структура;
	Если Копирование Тогда
		ПараметрыФормы.Вставить("ЗначениеКопирования", УФ[РеквизитТаблица].НайтиПоИдентификатору(УФ.Элементы[РеквизитТаблица].ТекущаяСтрока).Документ);
	Иначе
		ПараметрыФормы.Вставить("Основание", УФ.Объект.Ссылка);
	КонецЕсли; 
	
	ФормаДокумента = ОткрытьФорму(ИмяФормы,ПараметрыФормы,Элемент);
	
	// --- 
КонецФункции

&НаКлиенте
Функция ФинансыОткрыть(УФ, Параметры)
	// --- 
	
	Элемент = Параметры.Элемент;
	РеквизитТаблица = Элемент.Имя;
	// --- 
	Если (Параметры.Свойство("ВыбраннаяСтрока")) Тогда
		
		Документ = УФ[РеквизитТаблица].НайтиПоИдентификатору(Параметры.ВыбраннаяСтрока).Документ;
		
	Иначе
		
		Документ = УФ[РеквизитТаблица].НайтиПоИдентификатору(Элемент.ТекущаяСтрока).Документ;
		
	КонецЕсли; 
	Если (Элемент.Имя = "ФинансыРасходы") Тогда
		
		ИмяФормы = "Документ.CW_РасходыПоГрузоперевозке.ФормаОбъекта";
		
	ИначеЕсли (Элемент.Имя = "ФинансыДоходы") Тогда 
		
		ИмяФормы = "Документ.CW_ДоходыПоГрузоперевозке.ФормаОбъекта";
		
	КонецЕсли; 
	
	Попытка
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("Ключ", Документ);
		ОткрытьФорму(ИмяФормы, ПараметрыФормы,Элемент);
	Исключение
	КонецПопытки; 
	
	// --- 
КонецФункции

&НаКлиенте
Функция ФинансыУдалить(УФ,Параметры, ПроцедураОбратногоВызова)
	// --- 
	
	ПОВ = Новый ОписаниеОповещения("ОбработкаОтветаУдаленияДокументаФинансов",ЭтотОбъект, Новый Структура("УФ,ПОВ,Параметры",УФ,ПроцедураОбратногоВызова, Параметры));
	ПоказатьВопрос(ПОВ,"Установить пометку удаления?",РежимДиалогаВопрос.ДаНет);
	
	// --- 
КонецФункции

&НаКлиенте
Процедура ОбработкаОтветаУдаленияДокументаФинансов(Ответ, ДополнительныеПараметры) Экспорт
	// --- 
	
	Если (Ответ = КодВозвратаДиалога.Да) Тогда
		
		Элемент = ДополнительныеПараметры.Параметры.Элемент;
		РеквизитТаблица = Элемент.Имя;
		// --- 
		Документ = ДополнительныеПараметры.УФ[РеквизитТаблица].НайтиПоИдентификатору(Элемент.ТекущаяСтрока).Документ;
		
		ВыполнитьОбработкуОповещения(ДополнительныеПараметры.ПОВ,_УФКС.СД("Грузоперевозки","сервер","/ФинансыУдалить",Документ));
		
	КонецЕсли; 
	
	// --- 
КонецПроцедуры
  
&НаКлиенте
Функция ФинансыТраснпортОтобразитьСтатьи(УФ)
	// ---    
	
	Если УФ.ФинансыТранспортОтображатьПостатейно Тогда
		УФ.ФинансыТранспортОтображатьПостатейно = Ложь;
	Иначе
		УФ.ФинансыТранспортОтображатьПостатейно = Истина;
	КонецЕсли; 
	
	Настройка = Новый структура("ОтображатьПостатейно", УФ.ФинансыТранспортОтображатьПостатейно); 
	CW_Грузоперевозки_Сервер._СохранитьЗначение("ОтображатьПостатейно", Настройка); 
	
	УФ.Элементы.Форма_ФинансыТранспортОтобразитьСтатьи.Пометка = УФ.ФинансыТранспортОтображатьПостатейно;
	Возврат(_УФКС.СД("Грузоперевозки","сервер","/ФинансыТранспортОбновить"));
	
	// --- 
КонецФункции


&НаКлиенте
