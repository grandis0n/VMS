&НаКлиенте
Функция ПолучитьСтруктуруИтоговТаблицыФормы(Форма, ИмяТаблицы) Экспорт
	
	ЭлементФормы 	= Форма.Элементы[ИмяТаблицы];  
	ИмяКолонки 		= ЭлементФормы.ТекущийЭлемент.Имя;  
	ТаблицаФормы 	= Форма[ИмяТаблицы];   

	Если ИмяТаблицы = "БюджетРасходы" Тогда
		
		ИмяКолонки = СтрЗаменить(ИмяКолонки, "БюджетРасходы", "");
		ИмяКолонки = СтрЗаменить(ИмяКолонки, "БюджетЗатраты", "");
		
	ИначеЕсли ИмяТаблицы = "БюджетРасходыДерево" Тогда 
		
		ИмяКолонки = СтрЗаменить(ИмяКолонки, "БюджетРасходыДерево", "");  

	ИначеЕсли ИмяТаблицы = "БюджетДоходы" Тогда 
		
		ИмяКолонки = СтрЗаменить(ИмяКолонки, "БюджетДоходы", "");
		
	ИначеЕсли ИмяТаблицы = "БюджетДоходыДерево" Тогда 
		
		ИмяКолонки = СтрЗаменить(ИмяКолонки, "БюджетДоходыДерево", "");  

	ИначеЕсли ИмяТаблицы = "ФинансыРасходы" Тогда 
		
		ИмяКолонки = СтрЗаменить(ИмяКолонки, "Затраты", "");
		
	ИначеЕсли ИмяТаблицы = "ФинансыДоходы" Тогда 
		
		ИмяКолонки = СтрЗаменить(ИмяКолонки, "Доходы", "");
		
	КонецЕсли;   

	
	// массив строк отсутствует
	Попытка 
		ИдентификаторСтроки 	= ЭлементФормы.ВыделенныеСтроки[0];  
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
	СтрокаТаблицы 			= ТаблицаФормы.НайтиПоИдентификатору(ИдентификаторСтроки);
	ЗначениеЯчейки 			= СтрокаТаблицы[ИмяКолонки]; 
	
	Если ТипЗнч(ЗначениеЯчейки) <> Тип("Число") Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	СуммаЗначений 		= 0;
	КоличествоЗначений  	= ЭлементФормы.ВыделенныеСтроки.Количество();
	МинимальноеЗначение 	= Неопределено;
	МаксимальноеЗначение 	= Неопределено;
	
	Если ТипЗнч(ТаблицаФормы) <> Тип("ДинамическийСписок") Тогда
		Для каждого ИдентификаторСтроки Из ЭлементФормы.ВыделенныеСтроки Цикл
			
			СтрокаТаблицы 	= ТаблицаФормы.НайтиПоИдентификатору(ИдентификаторСтроки);
			ЗначениеЯчейки 	= СтрокаТаблицы[ИмяКолонки]; 
			
			Если ТипЗнч(ЗначениеЯчейки) = Тип("Число") Тогда
				СуммаЗначений = СуммаЗначений + ЗначениеЯчейки;
			КонецЕсли; 
			
			Если  МинимальноеЗначение = Неопределено Тогда
				МинимальноеЗначение = ЗначениеЯчейки;
			Иначе
				МинимальноеЗначение =  Мин(ЗначениеЯчейки, МинимальноеЗначение); 
			КонецЕсли;
			
			Если  МаксимальноеЗначение = Неопределено Тогда
				МаксимальноеЗначение = ЗначениеЯчейки;
			Иначе
				МаксимальноеЗначение = Макс(ЗначениеЯчейки, МинимальноеЗначение); ; 
			КонецЕсли;
			
		КонецЦикла;  
	КонецЕсли;
	
	СреднееЗначение		= ?(КоличествоЗначений=0,0, СуммаЗначений/КоличествоЗначений);
	
	СтркутраПараметров = Новый Структура;
	СтркутраПараметров.Вставить("КоличествоЗначений"	, КоличествоЗначений);
	СтркутраПараметров.Вставить("СреднееЗначение"		, СреднееЗначение);
	СтркутраПараметров.Вставить("МинимальноеЗначение"	, МинимальноеЗначение);
	СтркутраПараметров.Вставить("МаксимальноеЗначение"	, МаксимальноеЗначение);
	СтркутраПараметров.Вставить("СуммаЗначений"			, СуммаЗначений);
	
	Возврат СтркутраПараметров
	
КонецФункции

Процедура ОткрытьФормуВычисленияЗначений(Знач СтркутраПараметров, Форма) Экспорт
	
	Если СтркутраПараметров = Неопределено Тогда
		ПоказатьПредупреждение(, "По выбранной колонке невозможно просуммировать значения!");
		Возврат;
	КонецЕсли;
	
	ОткрытьФорму("ОбщаяФорма.CW_ВычислитьЗначениеЖурнала",СтркутраПараметров, Форма,,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры 