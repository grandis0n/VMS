	// --- 
КонецПроцедуры
  

&НаКлиенте
Функция БюджетВыбратьИзСписка(УФ)
	// --- 
	
	пустаяКартинка = Новый Картинка;
	сз = Новый СписокЗначений;
	Для Каждого строкаТЗ Из УФ.БюджетВерсии Цикл
		сз.Добавить(строкаТЗ.ВерсияБюджета, , строкаТЗ.ЭтоУтвержденнаяВерсия, ?(строкаТЗ.ЭтоУтвержденнаяВерсия, БиблиотекаКартинок.CW_Замок, БиблиотекаКартинок.CW_ЭлементСписка));
	КонецЦикла;
	
	эл = УФ.ВыбратьИзСписка(сз, УФ.Элементы.БюджетТекущаяВерсия);
	Если (эл <> Неопределено) Тогда 
		УФ.БюджетТекущаяВерсия = эл.Значение;
		Возврат(_УФКС.СД("Грузоперевозки","сервер","/БюджетОбновить"));
	КонецЕсли;
	
	// --- 
КонецФункции

#Область ВыборВерсииБюджета 

&НаКлиенте
Функция БюджетВыбрать(УФ, ПроцедураОбратногоВызова)
	// --- 
	
	Если (ФормаЗаказа(УФ)) Тогда
		
		ПараметрыФормы = Новый Структура(
		"Заказ, Грузоперевозка, ВыбраннаяВерсия", 
		УФ.Объект.Ссылка,
		Неопределено,
		УФ.БюджетТекущаяВерсия
		);
		
	Иначе
		
		ПараметрыФормы = Новый Структура(
		"Заказ, Грузоперевозка, ВыбраннаяВерсия", 
		УФ.Объект.Заказ,
		УФ.Объект.Ссылка,
		УФ.БюджетТекущаяВерсия
		);
		
	КонецЕсли; 
	
	ПОВ = Новый ОписаниеОповещения("ОбработкаИзмененияВерсииБюджета",ЭтотОбъект,Новый Структура("УФ,ПОВ",УФ,ПроцедураОбратногоВызова));
	ПараметрыФормы.Вставить("ЭтоГрузоперевозка",ФормаГрузоперевозки(УФ));
	ОткрытьФорму("Справочник.CW_ВерсииБюджетов.Форма.ФормаУправленияВерсиями", ПараметрыФормы,УФ,,,,ПОВ,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
	// --- 
КонецФункции

&НаКлиенте
Процедура ОбработкаИзмененияВерсииБюджета(ВыбраннаяВерсия, ДополнительныеПараметры) Экспорт
	// --- 
	
	Если ЗначениеЗаполнено(ВыбраннаяВерсия) И (ДополнительныеПараметры.УФ.БюджетТекущаяВерсия <> ВыбраннаяВерсия) Тогда 
		// выбрана другая версия
		ДополнительныеПараметры.УФ.БюджетТекущаяВерсия = ВыбраннаяВерсия;
		
	КонецЕсли;
	ВыполнитьОбработкуОповещения(ДополнительныеПараметры.ПОВ,_УФКС.СД("Грузоперевозки","сервер","/БюджетОбновить"));
	
	// --- 
КонецПроцедуры

