&НаКлиенте
Функция ОтчетАнализПрибыли(УФ)
	// --- 
	
	ПараметрыФормы = Новый Структура;
	// --- 
	ПараметрыФормы.Вставить("ВнешнийВызов",Истина);
	
	ПараметрыОтчета = Новый Структура;
	ПараметрыОтчета.Вставить("Данные",1);
	Если (ТипЗнч(УФ.Объект.Ссылка) = Тип("СправочникСсылка.CW_Грузоперевозки")) Тогда
		ПараметрыОтчета.Вставить("Грузоперевозка",УФ.Объект.Ссылка);
	ИначеЕсли (ТипЗнч(УФ.Объект.Ссылка) = Тип("СправочникСсылка.CW_Заказы")) Тогда 
		ПараметрыОтчета.Вставить("Заказ",УФ.Объект.Ссылка);
	Иначе
		Возврат(Неопределено);
	КонецЕсли;
	ПараметрыОтчета.Вставить("ИсключатьВнутрихолдинговыеВзаиморасчеты",Истина);
	ПараметрыОтчета.Вставить("ВыводитьРасходыДоходы",Истина);
	// --- 
	ПараметрыФормы.Вставить("Параметры",ПараметрыОтчета);
	
	Показатели = Новый Массив;
	Показатели.Добавить("Всего");
	// --- 
	ПараметрыФормы.Вставить("Показатели",Показатели);
	
	Разделы = Новый Массив;
	Разделы.Добавить("План");
	Разделы.Добавить("Факт");
	Разделы.Добавить("Отклонение");
	// --- 
	ПараметрыФормы.Вставить("Разделы",Разделы);
	
	Группировки = Новый СписокЗначений;
	Группировки.Добавить("Грузоперевозка.Клиент","Грузоперевозка.Клиент");
	Группировки.Добавить("Грузоперевозка","Грузоперевозка");
	Группировки.Добавить("Номенклатура","Номенклатура");
	// --- 
	ПараметрыФормы.Вставить("Группировки",Группировки);
	
	// --- 
	ОткрытьФорму("Отчет.CW_АнализПрибылиПоГрузоперевозкам.Форма.ФормаОтчета",ПараметрыФормы,УФ,Истина);
	
	// --- 
КонецФункции

&НаКлиенте
Процедура ОткытьОтчетАнализПрибылиПоГрузоперевозкам(Форма, Знач Грузоперевозки) Экспорт
	
	СписоркГрузоперевозок = Новый СписокЗначений;
	СписоркГрузоперевозок.ЗагрузитьЗначения(Грузоперевозки);
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ВнешнийВызов", Истина);   
	ПараметрыФормы.Вставить("СформироватьПриОткрытии", Ложь);   
	ПараметрыФормы.Вставить("Данные",			1);
	ПараметрыФормы.Вставить("Грузоперевозки", 	Грузоперевозки);
	
	ПараметрыОтчета = Новый Структура;
	ПараметрыОтчета.Вставить("Данные",			1);
	ПараметрыОтчета.Вставить("Грузоперевозки", 	СписоркГрузоперевозок);
	
	ПараметрыФормы.Вставить("Параметры", ПараметрыОтчета);
	
	Показатели = Новый Массив;
	ПараметрыФормы.Вставить("Показатели",Показатели);
	
	Разделы = Новый Массив;
	ПараметрыФормы.Вставить("Разделы",Разделы);
	
	Группировки = Новый СписокЗначений;
	ПараметрыФормы.Вставить("Группировки",Группировки);
	
	ОткрытьФорму("Отчет.CW_АнализПрибылиПоГрузоперевозкам.Форма.ФормаОтчета", ПараметрыФормы, Форма, Истина);

