#Область ПерезаполнениеПараметровПоШаблону 

&НаКлиенте
Функция ПерезаполнитьПараметрыПоШаблону(УФ, ПроцедураОбратногоВызова)
	// --- 
	
	Если (УФ.ГруппаПользователя.Пустая()) Тогда
		
		_УФК.ВывестиПредупреждение("Для возможности заполнения параметров необходимо произвести настройку прав доступа");
		Возврат(Неопределено);
		
	КонецЕсли; 
	
	// удаляем параметры, которых нет в текущем типе г/п
	ПОВ_Удаление = Новый ОписаниеОповещения("ОбработкаУдаленияНетиповыхПараметров",ЭтотОбъект, Новый Структура("ПОВ",ПроцедураОбратногоВызова));
	УдалятьНетиповые = Ложь;
	Если (УФ.Объект.ПараметрыГрузоперевозки.Количество() = 0) Тогда
		
		УдалятьНетиповые = Истина;
		ВыполнитьОбработкуОповещения(ПОВ_Удаление,УдалятьНетиповые);
		
	Иначе
		
		ПОВ_ВопросУдаления = Новый ОписаниеОповещения("ОбработкаВопросаУдаленияНетиповыхПараметров",ЭтотОбъект,Новый Структура("ПОВ",ПОВ_Удаление));
		ПоказатьВопрос(ПОВ_ВопросУдаления,"Параметры, не соответствующие типу перевозки, будут удалены. Продолжить?", РежимДиалогаВопрос.ДаНет);
		
	КонецЕсли; 
	
	// --- 
КонецФункции

&НаКлиенте
Процедура ОбработкаВопросаУдаленияНетиповыхПараметров(Ответ, ДополнительныеПараметры) Экспорт
 	// --- 
	
	УдалятьНетиповые = Ложь;
	Если Ответ=КодВозвратаДиалога.Да Тогда
		
		УдалятьНетиповые=Истина;
		
	КонецЕсли;  
	// --- 
	ВыполнитьОбработкуОповещения(ДополнительныеПараметры.ПОВ,УдалятьНетиповые);
	
	// --- 
КонецПроцедуры
  

&НаКлиенте
Процедура ОбработкаУдаленияНетиповыхПараметров(УдалятьНетиповые, ДополнительныеПараметры) Экспорт 
	// --- 
	
	Если (УдалятьНетиповые) Тогда
		
		ВыполнитьОбработкуОповещения(ДополнительныеПараметры.ПОВ,_УФКС.СД("Грузоперевозки","сервер","/УдалитьНетиповыеПараметры"));
		
	КонецЕсли;  
	
	// --- 
КонецПроцедуры
  

#КонецОбласти 

&НаКлиенте
Функция СохранитьСостояниеСвертки(УФ)
	// --- 
	
	УФ.СостояниеСвертки.Очистить();
	Для каждого Стр Из УФ.ДеревоПараметров.ПолучитьЭлементы() Цикл
		
		УФ.СостояниеСвертки.Добавить(Стр.Параметр,,УФ.Элементы.ДеревоПараметров.Развернут(Стр.ПолучитьИдентификатор()));
		
	КонецЦикла; 
	
	Возврат(Неопределено);
	
	// --- 
КонецФункции

&НаКлиенте
Функция ВосстановитьСостояниеСвертки(УФ)
	// --- 
	
	Если УФ.ТребуетсяВосстановитьСостояниеСвертки Тогда
		
		УФ.ТребуетсяВосстановитьСостояниеСвертки=Ложь;
		
		Для каждого Стр Из УФ.ДеревоПараметров.ПолучитьЭлементы() Цикл
			
			СтрокаСостояния = УФ.СостояниеСвертки.НайтиПоЗначению(Стр.Параметр);
			Если СтрокаСостояния <> Неопределено Тогда
				
				Разворачивать = СтрокаСостояния.Пометка;
				Если Разворачивать = Неопределено Тогда
					
					Разворачивать = Истина;
					
				КонецЕсли; 
				Если Разворачивать Тогда
					
					УФ.Элементы.ДеревоПараметров.Развернуть(Стр.ПолучитьИдентификатор());
					
				КонецЕсли; 
				
			Иначе
				
				УФ.Элементы.ДеревоПараметров.Развернуть(Стр.ПолучитьИдентификатор());
				
			КонецЕсли; 
			
		КонецЦикла; 
		
	КонецЕсли; 
	
	Возврат(Неопределено);
	
	// --- 
КонецФункции

// --- 

&НаКлиенте
Функция ПерезаполнитьПредопределенныеПараметры(УФ,Параметры)
	// --- 
	
	ЭтаФорма = УФ;
	Элементы=УФ.Элементы;
	Объект = УФ.Объект;
	
	Структурапараметров = Новый Структура("ИмяРеквизита,ЗначениеРеквизита",ЭтаФорма.ТекущийЭлемент.Имя,Объект[ЭтаФорма.ТекущийЭлемент.Имя]);
	
	Возврат(_УФКС.СД("Грузоперевозки","сервер","/ЗаполнитьПредопределенныеЗначенияПараметровДляРеквизита",Структурапараметров));
		
	// --- 
КонецФункции

// --- 

&НаКлиенте
Функция ДеревоПараметровСвернутьВсе(УФ)
	
	Для каждого Стр Из УФ.ДеревоПараметров.ПолучитьЭлементы() Цикл
		
		УФ.Элементы.ДеревоПараметров.Свернуть(Стр.ПолучитьИдентификатор());
		
	КонецЦикла;
	
КонецФункции

&НаКлиенте
Функция ДеревоПараметровРазвернутьВсе(УФ)
	
	Для каждого Стр Из УФ.ДеревоПараметров.ПолучитьЭлементы() Цикл
		
		УФ.Элементы.ДеревоПараметров.Развернуть(Стр.ПолучитьИдентификатор());
		
	КонецЦикла; 
	
КонецФункции

&НаКлиенте
Функция ИзменитьДатуЗакрытия(УФ, ПроцедураОбратногоВызова)
	// --- 
	
	ПОВ = Новый ОписаниеОповещения("ОбработкаИзмененияДатыЗакрытия",ЭтотОбъект,Новый Структура("ПОВ",ПроцедураОбратногоВызова));
	ПФ = Новый Структура("ДатаЗакрытия,Аналитика",УФ.ДатаЗакрытия,УФ.Объект.Ссылка);
	ОткрытьФорму("ОбщаяФорма.CW_УстановкаДатыБлокировкиДокументов",ПФ,,,,,ПОВ,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
	// --- 
