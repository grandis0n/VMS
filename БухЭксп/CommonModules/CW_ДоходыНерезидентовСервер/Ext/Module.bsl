Процедура ПолучитьСчетНаПродлениеПодписки(ПараметрыПроцедуры, АдресРезультата) Экспорт
	
	СтруктураJSON = Новый Структура;
	СтруктураJSON.Вставить("software",		XMLСтрока(ПараметрыПроцедуры.ПрограммныйПродукт));
	СтруктураJSON.Вставить("regnumber",		XMLСтрока(ПараметрыПроцедуры.РегистрационныйНомер));
	СтруктураJSON.Вставить("rateid",		XMLСтрока(ПараметрыПроцедуры.ИдентифкаторТарифа));
	СтруктураJSON.Вставить("startdate",		XMLСтрока(ПараметрыПроцедуры.ДатаНачала));
	СтруктураJSON.Вставить("months",		XMLСтрока(ПараметрыПроцедуры.КоличествоМесяцев));	
	СтруктураJSON.Вставить("count",			XMLСтрока(ПараметрыПроцедуры.Количество));	
	СтруктураJSON.Вставить("email",			XMLСтрока(ПараметрыПроцедуры.АдресПолучателя));

	ПараметрыHTTPЗапроса = CW_РаботаСВнешнимиРесурсамиСервер.ПодготовитьHTTPЗапрос("main_paymentinvoice", СтруктураJSON);

	Ответ = CW_РаботаСВнешнимиРесурсамиСервер.ПолучитьДанныеССервера(ПараметрыHTTPЗапроса.HTTPСоединение, ПараметрыHTTPЗапроса.HTTPЗапрос, "POST");   
	Если Ответ = Неопределено Тогда  
		КодСостояния	= 503;
		ТекстСостояния 	= "Сервис временно недоступен";
	Иначе
		КодСостояния	= Ответ.КодСостояния;
		ТекстСостояния 	= Ответ.ПолучитьТелоКакСтроку();
	КонецЕсли;
	
	СтруктураОтвета = Новый Структура;
	СтруктураОтвета.Вставить("КодСостояния",	КодСостояния);
	СтруктураОтвета.Вставить("ТекстСостояния",	ТекстСостояния);
	
	ПоместитьВоВременноеХранилище(СтруктураОтвета, АдресРезультата);
	
КонецПроцедуры

Функция ПолучитьРегистрационнуюИнформациюСервиса() Экспорт
	
	СтруктураОтвет 			= Новый Структура;
	
	РегистрационныйНомер 	= CW_ПроверкаЛицензии.ПолучитьРегистрационныйНомер();
	
	СтруктураJSON = Новый Структура;
	СтруктураJSON.Вставить("regnumber",	XMLСтрока(РегистрационныйНомер));
	СтруктураJSON.Вставить("service",	"ДоходыНерезидентов");
	
	ПараметрыHTTPЗапроса = CW_РаботаСВнешнимиРесурсамиСервер.ПодготовитьHTTPЗапрос("inc_reginfo", СтруктураJSON);
	
	Если ПараметрыHTTPЗапроса.УказаныРегистрационныеДанные Тогда
		
		Ответ = CW_РаботаСВнешнимиРесурсамиСервер.ПолучитьДанныеССервера(ПараметрыHTTPЗапроса.HTTPСоединение, ПараметрыHTTPЗапроса.HTTPЗапрос, "GET"); 
		
		Если Ответ = Неопределено Тогда 
			ЗаписьЖурналаРегистрации("CW_ДоходыНерезидентов", УровеньЖурналаРегистрации.Ошибка,,,"Отсутствует интернет-соединение!",);
		Иначе
			
			Сообщение = Ответ.ПолучитьТелокакСтроку();
			
			Если Ответ.КодСостояния <> 200 Тогда    
				Если ПустаяСтрока(Сообщение) Тогда
					ОписаниеКодовСостояний 	= CW_ОбщийМодульЛичныйКабинетКлиентСервер.ПолучитьОписаниеКодовСостояний();	
					Сообщение = "Код ошибки: "+ Ответ.КодСостояния +" - "+ ОписаниеКодовСостояний.Получить(Ответ.КодСостояния); 
				КонецЕсли;  
				ЗаписьЖурналаРегистрации("Доходы нерезидента", УровеньЖурналаРегистрации.Ошибка,,,Сообщение,);
			Иначе
				
				ЧтениеJSON = Новый ЧтениеJSON;
				ЧтениеJSON.УстановитьСтроку(Сообщение);  
				
				СтруктураJSON = ПрочитатьJSON(ЧтениеJSON);
				ЧтениеJSON.Закрыть(); 
				
				СтруктураОтвет.Вставить("ДатаНачала", 		XMLЗначение(Тип("Дата"),	СтруктураJSON.ДатаНачала));
				СтруктураОтвет.Вставить("ДатаОкончания", 	XMLЗначение(Тип("Дата"),	СтруктураJSON.ДатаОкончания));
				СтруктураОтвет.Вставить("РегНомер",			XMLЗначение(Тип("Строка"),	СтруктураJSON.РегНомер));	
				СтруктураОтвет.Вставить("НазваниеКомпании",	XMLЗначение(Тип("Строка"),	СтруктураJSON.НазваниеКомпании));	
				СтруктураОтвет.Вставить("ТекущийТариф",		XMLЗначение(Тип("Строка"),	СтруктураJSON.ТекущийТариф));	
				
			КонецЕсли; 
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат СтруктураОтвет;
		
КонецФункции

//Создание дополнительных реквизитов
Процедура СоздатьРеквизиты2023Кв4() Экспорт  
	
	МакетСоставаПоказателей = Отчеты.РегламентированныйОтчетДоходыИностраннымОрганизациям.ПолучитьМакет("СпискиВыбора2023Кв4");
	
	КоллекцияСписковВыбора = Новый Соответствие;
	Для Каждого Область Из МакетСоставаПоказателей.Области Цикл
		Если Область.ТипОбласти = ТипОбластиЯчеекТабличногоДокумента.Строки Тогда
			ВерхОбласти = Область.Верх;
			НизОбласти = Область.Низ;
			ТаблСписка = Новый ТаблицаЗначений;
			ТаблСписка.Колонки.Добавить("Код",,,
			МакетСоставаПоказателей.Область(ВерхОбласти, 1, ВерхОбласти, 1).ШиринаКолонки);
			ТаблСписка.Колонки.Добавить("Название",,,
			МакетСоставаПоказателей.Область(ВерхОбласти, 2, ВерхОбласти, 2).ШиринаКолонки);
			Для НомСтр = ВерхОбласти По НизОбласти Цикл
				КодПоказателя = СокрП(МакетСоставаПоказателей.Область(НомСтр, 1).Текст);
				Если КодПоказателя <> "###" Тогда
					НовСтрока = ТаблСписка.Добавить();
					НовСтрока.Код = КодПоказателя;
					НовСтрока.Название = СокрП(МакетСоставаПоказателей.Область(НомСтр, 2).Текст);
				КонецЕсли;
			КонецЦикла;
			КоллекцияСписковВыбора.Вставить(Область.Имя, ТаблСписка);
		КонецЕсли;
	КонецЦикла;  
	
	ИменаДополнительныхРеквизитов = Новый Структура; 
	ИменаДополнительныхРеквизитов.Вставить("ПризнакНаличияВедомостиБанковскогоКонтроля", 		СвойстваПризнакНаличияВедомостиБанковскогоКонтроля(КоллекцияСписковВыбора));
	ИменаДополнительныхРеквизитов.Вставить("НомерВедомостиБанковскогоКонтроля", 				СвойстваНомерВедомостиБанковскогоКонтроля());
	ИменаДополнительныхРеквизитов.Вставить("КодДохода", 										СвойстваКодДохода(КоллекцияСписковВыбора));
	ИменаДополнительныхРеквизитов.Вставить("СимволДохода", 										СвойстваСимволДохода(КоллекцияСписковВыбора));
	ИменаДополнительныхРеквизитов.Вставить("ОснованиеОсвобожденияОтИсчисленияИУдержанияНалога", СвойстваОснованиеОсвобожденияОтИсчисленияИУдержанияНалога(КоллекцияСписковВыбора));
	
	Для Каждого КлючЗначение из ИменаДополнительныхРеквизитов Цикл   
		
		ДанныеДопРеквизита = КлючЗначение.Значение;
		
		НайденнаяСсылка = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоРеквизиту("ИдентификаторДляФормул", КлючЗначение.Ключ);  
		УстановитьСсылкуНового = ложь;
		Если НайденнаяСсылка.Пустая() Тогда 
			ДополнительныеРеквизитыОбъект =  ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.СоздатьЭлемент();
			НайденнаяСсылка = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.ПолучитьСсылку(Новый УникальныйИдентификатор); 
			УстановитьСсылкуНового = Истина;
		Иначе
			ДополнительныеРеквизитыОбъект =  НайденнаяСсылка.ПолучитьОбъект();
		КонецЕсли; 
		
		ЗаполнитьЗначенияСвойств(ДополнительныеРеквизитыОбъект, ДанныеДопРеквизита); 
		
		Если ТипЗнч(ДанныеДопРеквизита.Значения) = Тип("ТаблицаЗначений")
			и ДанныеДопРеквизита.Значения.Количество() > 0 Тогда
			
			Для Каждого СтрокаТаблицы из ДанныеДопРеквизита.Значения Цикл   
				
				СтрокаТаблицыКод = ?(ПустаяСтрока(СтрокаТаблицы.Код), "<Пустое значение>", СтрокаТаблицы.Код);
				
				СсылкаЗначенияСвойствОбъектов  = Справочники.ЗначенияСвойствОбъектов.НайтиПоНаименованию(СтрокаТаблицыКод,,,НайденнаяСсылка); 
				Если Не СсылкаЗначенияСвойствОбъектов.Пустая() Тогда
					Продолжить;
				КонецЕсли;
				
				ОбъектЗначенияСвойствОбъектов =  Справочники.ЗначенияСвойствОбъектов.СоздатьЭлемент(); 
				ОбъектЗначенияСвойствОбъектов.Владелец 				= НайденнаяСсылка;
				ОбъектЗначенияСвойствОбъектов.Наименование			= СтрокаТаблицыКод;
				ОбъектЗначенияСвойствОбъектов.ПолноеНаименование 	= СтрокаТаблицы.Название;
				ОбъектЗначенияСвойствОбъектов.Записать();	
				
			КонецЦикла; 
			
		КонецЕсли;    
		
		Если УстановитьСсылкуНового Тогда
			ДополнительныеРеквизитыОбъект.УстановитьСсылкуНового(НайденнаяСсылка);
		КонецЕсли;
		
		ДополнительныеРеквизитыОбъект.Записать();   
		
		
		СсылкаНаборСвойств 	= ПредопределенноеЗначение("Справочник.НаборыДополнительныхРеквизитовИСведений.Справочник_ДоговорыКонтрагентов");	
		НаборСвойств		= СсылкаНаборСвойств.ПолучитьОбъект();
		
		НайденнаяСтрока = НаборСвойств.ДополнительныеРеквизиты.Найти(ДополнительныеРеквизитыОбъект.Ссылка, "Свойство");
		Если НайденнаяСтрока = Неопределено Тогда
			НайденнаяСтрока =  НаборСвойств.ДополнительныеРеквизиты.Добавить();
			НайденнаяСтрока.Свойство =  ДополнительныеРеквизитыОбъект.Ссылка;
		КонецЕсли;
		
		НайденнаяСтрока.ПометкаУдаления = Ложь;
		
		НаборСвойств.Записать();
		
	КонецЦикла;
	
КонецПроцедуры

