//Профиль доступа 
Процедура ОбновитьПрофилиПользователей(ПараметрыПроцедуры) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если ПолучитьФункциональнуюОпцию("CW_ДоходыНерезидентовИспользуется") Тогда  
		
		Модуль_CW_ДоходыНерезидентовСервер = CW_ОбщегоНазначения.ОбщийМодуль("CW_ДоходыНерезидентовСервер");
		Профиль = Модуль_CW_ДоходыНерезидентовСервер.СоздатьПрофильДоступа();
		
		Запрос = новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		|	РегистрСведенийCW_ПараметрыПользователей.Пользователь КАК Пользователь,
		|	ЕСТЬNULL(ГруппыДоступа.Ссылка, НЕОПРЕДЕЛЕНО) КАК ПерсональнаяГруппаДоступа
		|ИЗ
		|	РегистрСведений.CW_ПараметрыПользователей КАК РегистрСведенийCW_ПараметрыПользователей
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ГруппыДоступа КАК ГруппыДоступа
		|		ПО РегистрСведенийCW_ПараметрыПользователей.Пользователь = ГруппыДоступа.Пользователь
		|			И (ГруппыДоступа.Профиль = &Профиль)
		|ГДЕ
		|	РегистрСведенийCW_ПараметрыПользователей.Группа = &Группа"; 
		
		Запрос.УстановитьПараметр("Группа", 	ПараметрыПроцедуры.ГруппаПользователей);
		Запрос.УстановитьПараметр("Профиль", 	Профиль);
		
		РезультатЗапроса = Запрос.Выполнить();
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл  
			
			Если ЗначениеЗаполнено(Выборка.ПерсональнаяГруппаДоступа) тогда
				ОбъектГруппаДоступа = Выборка.ПерсональнаяГруппаДоступа.ПолучитьОбъект();
				ОбъектГруппаДоступа.ПометкаУдаления = Ложь;   
			Иначе
				ОбъектГруппаДоступа = Справочники.ГруппыДоступа.СоздатьЭлемент();
				ОбъектГруппаДоступа.Родитель     	= Справочники.ГруппыДоступа.РодительПерсональныхГруппДоступа();
				ОбъектГруппаДоступа.Наименование 	= "Сервис ""Доходы нерезидентов""";
				ОбъектГруппаДоступа.Профиль 		= Профиль;
				ОбъектГруппаДоступа.Пользователь 	= Выборка.Пользователь;
				ОбъектГруппаДоступа.Комментарий 	= "Обеспечивает доступ к данным сервиса ""Доходы нерезидентов""";    
			КонецЕсли; 
			
			ОбъектГруппаДоступа.Пользователи.Очистить(); 
			
			Если ПараметрыПроцедуры.ДоходыНерезидентов Тогда
				ОбъектГруппаДоступа.Пользователи.Добавить().Пользователь = Выборка.Пользователь;
			КонецЕсли;	
			
			ОбъектГруппаДоступа.Записать();
			
		КонецЦикла; 
		
	КонецЕсли;   
	
КонецПроцедуры

Функция СоздатьПрофильДоступа() Экспорт
	
	ИдентификаторПрофиля = CW_ДоходыНерезидентовСервер.ПолучитьИдентификаторПрофиляГруппыДоступа();
	
	СсылкаПрофиль = Справочники.ПрофилиГруппДоступа.НайтиПоРеквизиту("ИдентификаторПоставляемыхДанных", ИдентификаторПрофиля);  
	Если СсылкаПрофиль.Пустая() Тогда
		ИдентификаторОбъектаМетаданныхРоль = ОбщегоНазначения.ИдентификаторОбъектаМетаданных(Метаданные.Роли.CW_ДоходыНерезидентовИспользованиеСервиса);
		
		// создаем новый профиль доступа
		НовыйПрофиль = Справочники.ПрофилиГруппДоступа.СоздатьЭлемент();
		НовыйПрофиль.Наименование = "Сервис ""Доходы нерезидентов""";
		НовыйПрофиль.Комментарий  = "Доступ к сервису ""Доходы нерезидентов"""; 
		НовыйПрофиль.ИдентификаторПоставляемыхДанных =  ИдентификаторПрофиля;
		
		НоваяСтрока 		= НовыйПрофиль.Роли.Добавить();
		НоваяСтрока.Роль 	= ИдентификаторОбъектаМетаданныхРоль; 
		
		СтрокаНазначение = НовыйПрофиль.Назначение.Добавить();
		СтрокаНазначение.ТипПользователей = ПредопределенноеЗначение("Справочник.Пользователи.ПустаяСсылка");
		
		НовыйПрофиль.Записать(); 
		
		СсылкаПрофиль = НовыйПрофиль.Ссылка;
		
	КонецЕсли; 
	
	Возврат СсылкаПрофиль;
	
КонецФункции   

Функция ПолучитьИдентификаторПрофиляГруппыДоступа() Экспорт

	Возврат Новый УникальныйИдентификатор("9150fcf6-1914-466e-8b8f-415e2dbbfdb6");
	
КонецФункции  
