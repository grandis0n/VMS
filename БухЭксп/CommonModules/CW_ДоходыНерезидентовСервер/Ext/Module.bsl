Функция ПоказыватьРекламуПриСтартеПользователя(ИмяПользователя = Неопределено) Экспорт

	КлючОбъекта = ВРег("CW_ДоходыНерезидентовПоказРекламы");

	Результат = ХранилищеОбщихНастроек.Загрузить(КлючОбъекта,"",, ИмяПользователя);
	
	Если ТипЗнч(Результат) <> Тип("Булево") Тогда
		Результат = Ложь;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

