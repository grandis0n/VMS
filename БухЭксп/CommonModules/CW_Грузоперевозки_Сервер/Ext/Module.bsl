&НаСервере
Функция ВыполнитьДействие(УФ, СтруктураДействия) Экспорт 
	
	ИмяКоманды = СтруктураДействия.Команда;
	Параметры = СтруктураДействия.Параметры;

	Отладка = УФ.Отладка;
	Если (Отладка) Тогда
		Сообщить("Сервер: """+ИмяКоманды+"""");
	КонецЕсли; 
	
	Если (ИмяКоманды = "/ВыполнитьДействие") Тогда 
		
		// если вдруг понадобится выполнить серверное действие с возвратом на клиента
		Возврат(Параметры);
		
	#Область Общие
	
	ИначеЕсли (ИмяКоманды = "/ИнициализацияФормы") Тогда 
		
		// если вдруг понадобится выполнить серверное действие с возвратом на клиента
		Возврат(ИнициализацияФормы(УФ));
		
	ИначеЕсли (ИмяКоманды = "/Заголовок") Тогда 
		
		// если вдруг понадобится выполнить серверное действие с возвратом на клиента
		Возврат(УстановитьЗаголовок(УФ));
	
	ИначеЕсли (ИмяКоманды = "/ПраваДоступа") Тогда 
		
		// если вдруг понадобится выполнить серверное действие с возвратом на клиента
		Возврат(ПраваДоступа(УФ));
		
	ИначеЕсли (ИмяКоманды = "/УправлениеЭлементамиФормы") Тогда 
		
		Возврат(УправлениеЭлементамиФормы(УФ)); 
		
	ИначеЕсли (ИмяКоманды = "/ОтборДокументовФинансовогоРезультата") Тогда 
		
		Возврат(ОтборДокументовФинансовогоРезультата(УФ)); 
		
	ИначеЕсли (ИмяКоманды = "/ПроверитьНомерКонтейнера") Тогда 
		
		Возврат(ПроверитьНомерКонтейнера(УФ));
		
	#КонецОбласти
	
	#Область Параметры
	
	ИначеЕсли (ИмяКоманды = "/ДеревоПараметровОбновить") Тогда 
		
		Возврат(ДеревоПараметровОбновить(УФ));
		
	ИначеЕсли (ИмяКоманды = "/ЗаполнитьПараметрыИзТипаПеревозки") Тогда 
		
		Возврат(ЗаполнитьПараметрыИзТипаПеревозки(УФ,?(Параметры=Неопределено,Ложь,Параметры)));
		
	ИначеЕсли (ИмяКоманды = "/УдалитьНетиповыеПараметры") Тогда 
		
		Возврат(УдалитьНетиповыеПараметры(УФ));
		
	ИначеЕсли (ИмяКоманды = "/ЗаполнитьПредопределенныеПараметры") Тогда 
		
		Возврат(ЗаполнитьПредопределенныеПараметры(УФ)); 
	
	ИначеЕсли (ИмяКоманды = "/ЗаполнитьПредопределенныеЗначенияПараметровДляРеквизита") Тогда 
		
		Возврат(ЗаполнитьПредопределенныеЗначенияПараметровДляРеквизита(УФ,Параметры));
		
	ИначеЕсли (ИмяКоманды = "/ЗафиксироватьНачальныйПорядокПараметров") Тогда 
		
		Возврат(ЗафиксироватьНачальныйПорядокПараметров(УФ));
		
	ИначеЕсли (ИмяКоманды = "/ЗафиксироватьКонечныйПорядокПараметров") Тогда 
		
		Возврат(ЗафиксироватьКонечныйПорядокПараметров(УФ));
		
	ИначеЕсли (ИмяКоманды = "/ПроверитьПорядокПараметров") Тогда 
		
		Возврат(ПроверитьПорядокПараметров(УФ));
		
	ИначеЕсли (ИмяКоманды = "/ДеревоПараметровОбновитьПараметр") Тогда 
		
		Возврат(ДеревоПараметровОбновитьПараметр(УФ,Параметры));
		
	ИначеЕсли (ИмяКоманды = "/ДеревоПараметровУдалитьПараметр") Тогда 
		
		Возврат(ДеревоПараметровУдалитьПараметр(УФ,Параметры));
		
	#КонецОбласти
		
	#Область Бюджет
		
	ИначеЕсли (ИмяКоманды = "/БюджетИнициализация") Тогда 
		
		Возврат(БюджетИнициализация(УФ)); 
		
	ИначеЕсли (ИмяКоманды = "/БюджетОбновитьТаблицу") Тогда 
		
		Возврат(ОбновитьТаблицуБюджетов(УФ)); 
		
	ИначеЕсли (ИмяКоманды = "/БюджетРасходыОбновить") Тогда 
		
		Возврат(БюджетОбновить(УФ,Истина,Ложь)); 
		
	ИначеЕсли (ИмяКоманды = "/БюджетРасходыОбновитьИтоги") Тогда 
		
		Возврат(БюджетОбновитьИтоги(УФ,Истина,Ложь)); 
		
	ИначеЕсли (ИмяКоманды = "/БюджетДоходыОбновить") Тогда 
		
		Возврат(БюджетОбновить(УФ,Ложь,Истина)); 
		
	ИначеЕсли (ИмяКоманды = "/БюджетДоходыОбновитьИтоги") Тогда 
		
		Возврат(БюджетОбновитьИтоги(УФ,Ложь,Истина)); 
		
	ИначеЕсли (ИмяКоманды = "/БюджетОбновить") Тогда 
		
		Возврат(БюджетОбновить(УФ,Истина,Истина)); 
		
	ИначеЕсли (ИмяКоманды = "/БюджетУдалить") Тогда 
		
		Возврат(БюджетУдалить(УФ,Параметры)); 
		
	ИначеЕсли (ИмяКоманды = "/БюджетКонтрагентыПолучить") Тогда 
		
		Возврат(БюджетКонтрагентыПолучить(УФ)); 
		
	ИначеЕсли (ИмяКоманды = "/БюджетКонтрагентыУстановить") Тогда 
		
		Возврат(БюджетКонтрагентыУстановить(УФ,Параметры)); 
		
	ИначеЕсли (ИмяКоманды = "/БюджетЗаполнитьОбработкиЗаполнения") Тогда 
		
		Возврат(БюджетЗаполнитьОбработкиЗаполнения(УФ)); 
		
	ИначеЕсли (ИмяКоманды = "/БюджетЗаполнитьДоходыПоРасходам") Тогда 
		
		Возврат(БюджетЗаполнитьДоходыПоРасходам(УФ, Параметры)); 
		
	ИначеЕсли (ИмяКоманды = "/ПересчетСтатейБюджетаПоКурсу") Тогда 
		
		Возврат(ПересчетСтатейБюджетаПоКурсу(УФ,Параметры)); 
		
	#КонецОбласти
	
	#Область Финансы
	
	ИначеЕсли (ИмяКоманды = "/ФинансыОбновить") Тогда 
		
		Возврат(ФинансыОбновить(УФ,Истина,Истина,Истина)); 
	
	ИначеЕсли (ИмяКоманды = "/ФинансыРасходыОбновить") Тогда 
		
		Возврат(ФинансыОбновить(УФ,Истина,Ложь,Ложь)); 
		
	ИначеЕсли (ИмяКоманды = "/ФинансыТранспортОбновить") Тогда 
		
		Возврат(ФинансыОбновить(УФ,Ложь,Ложь,Истина)); 

	ИначеЕсли (ИмяКоманды = "/ФинансыРезультатОбновить") Тогда 
		
		Возврат(ФинансыОбновить(УФ,Ложь,Ложь,Ложь)); 
		
	ИначеЕсли (ИмяКоманды = "/ФинансыРасходыОбновитьИтоги") Тогда 
		
		Возврат(ФинансыОбновитьИтоги(УФ)); 
		
	ИначеЕсли (ИмяКоманды = "/ФинансыДоходыОбновить") Тогда 
		
		Возврат(ФинансыОбновить(УФ,Ложь,Истина,Ложь)); 
		
	ИначеЕсли (ИмяКоманды = "/ФинансыДоходыОбновитьИтоги") Тогда 
		
		Возврат(ФинансыОбновитьИтоги(УФ)); 
		
	ИначеЕсли (ИмяКоманды = "/ФинансыУдалить") Тогда 
		
		Возврат(ФинансыУдалить(УФ,Параметры)); 
	
	#КонецОбласти 
	
	#Область Декларации
	
	ИначеЕсли (ИмяКоманды = "/ДекларацииОбновить") Тогда 
		
		Возврат(ДекларацииОбновить(УФ)); 
	
	#КонецОбласти
	
	#Область Связи

	ИначеЕсли (ИмяКоманды = "/ОтборСвязей") Тогда 
		
		Возврат(ОтборСвязей(УФ)); 

	#КонецОбласти 
	
	ИначеЕсли (ИмяКоманды = "/ОбновитьДатуЗакрытия") Тогда 
		
		Возврат(ОбновитьДатуЗакрытия(УФ));
		
	Иначе 
		
		Сообщить("Сервер: неизвестная команда """+ИмяКоманды+"""");
		Возврат(Неопределено);
		
	КонецЕсли;
	
КонецФункции

&НаСервере
Функция ФормаГрузоперевозки(УФ)
	// --- 
	
	Возврат( УФ.ИмяФормы = "Справочник.CW_Грузоперевозки.Форма.ФормаЭлемента" );
	
	// --- 
КонецФункции

&НаСервере
Функция ФормаЗаказа(УФ)
	// --- 
	
	Возврат( УФ.ИмяФормы = "Справочник.CW_Заказы.Форма.ФормаЭлемента" );
	
	// --- 
КонецФункции

&НаСервере
Функция ФормаЗаявки(УФ)
	// --- 
	
	Возврат( УФ.ИмяФормы = "Справочник.CW_Заявки.Форма.ФормаЭлемента" );
	
	// --- 
КонецФункции

&НаСервере
Функция ИнициализацияФормы(УФ)
	// --- 
	
	Объект = УФ.Объект;
	Если (Объект.Ссылка.Пустая()) Тогда
		УФ.Модифицированность = Истина;
	КонецЕсли; 
	// --- 
	СеансоваяНастройка = _УФС.ЗагрузитьСеансовыеНастройки(УФ);
	Если (СеансоваяНастройка <> Неопределено) Тогда
		
		СеансоваяНастройка.Свойство("ФинансыРасходыОтображатьПостатейно",УФ.ФинансыРасходыОтображатьПостатейно);
		УФ.Элементы.Форма_ФинансыРасходыОтобразитьСтатьи.Пометка = УФ.ФинансыРасходыОтображатьПостатейно;
		
		СеансоваяНастройка.Свойство("ФинансыДоходыОтображатьПостатейно",УФ.ФинансыДоходыОтображатьПостатейно);
		УФ.Элементы.Форма_ФинансыДоходыОтобразитьСтатьи.Пометка = УФ.ФинансыДоходыОтображатьПостатейно;
		
		СеансоваяНастройка.Свойство("ФинансыТранспортОтображатьПостатейно",УФ.ФинансыТранспортОтображатьПостатейно);
		УФ.Элементы.Форма_ФинансыТранспортОтобразитьСтатьи.Пометка = УФ.ФинансыТранспортОтображатьПостатейно;
		
	КонецЕсли;
	
	// инициализация формы грузоперевозки
	Если (ФормаГрузоперевозки(УФ)) Тогда
		
		_сф.УстановитьЕслиНезаполнено(Объект.ДатаСделкиФ,ТекущаяДата());
		// --- 
		//УФ.Элементы.Представление.КнопкаОткрытия = ПолучитьФункциональнуюОпцию("CW_ИспользованиеМониторингаОборудования");
		// --- 
		Пользователь=CW_Настройки.Пользователь();
		НП = CW_Настройки.ПолучитьНастройкиПользователя(Пользователь);
		// --- 
		УФ.ВРУ = CW_Настройки.ВалютаРегламентированногоУчета(); 
		УФ.ПроверятьНомерКонтейнера = НП.ПроверятьНомерКонтейнера;
		УФ.ОтображениеФинансовогоРезультата = НП.ОтображениеФинРез;
		УФ.ВыводитьРезультатВВалютеДокументов = НП.ВыводитьФинансовыйРезультатВВалютеДокументов;
		УФ.КонтролироватьПросрочкуПлановыхДат = НП.КонтролироватьПросрочкуПлановыхДат;
		УФ.ПоказыватьКоличествоПараметров = НП.ПоказыватьКоличествоПараметровВГруппах;
		// --- 
		УФ.Элементы.СтраницаДекларации.Видимость = (Константы.CW_ВедетсяУчетДТ.Получить());
		УФ.Элементы.СтраницаСвязи.Видимость = ПолучитьФункциональнуюОпцию("CW_ИспользованиеМеханизмаСвязейГрузоперевозок");
		
		// заполнение при копировании
		Если (УФ.ОбъектКопирования.Пустая()) Тогда
			
			Если (Объект.Ссылка.Пустая() И НЕ Объект.ТипПеревозки.Пустая()) Тогда
				
				ЗаполнитьПараметрыИзТипаПеревозки(УФ);
				
			КонецЕсли;
			
		КонецЕсли; 
		
		// --- 
		ПроверитьНомерКонтейнера(УФ);
		ОбновитьДатуЗакрытия(УФ);
		ПраваДоступа(УФ);
		БюджетИнициализация(УФ);
		ОтборДокументовФинансовогоРезультата(УФ);
		Если (УФ.Элементы.СтраницаСвязи.Видимость) Тогда
			ОтборСвязей(УФ);	
		КонецЕсли; 
		ЗаполнитьПредопределенныеПараметры(УФ);
		УправлениеЭлементамиФормы(УФ);
		
		// обязательные реквизиты
		//УФ.Элементы.Клиент.Видимость = ПолучитьФункциональнуюОпцию("CW_ИспользованиеКлиент");
		УФ.Элементы.Клиент.АвтоОтметкаНезаполненного = Объект.ТипПеревозки.КонтрольЗаполненияКлиента;
		// --- 
		УФ.Элементы.Груз.Видимость = Константы.CW_Мониторинг_Груз.Получить();
		УФ.Элементы.Груз.АвтоОтметкаНезаполненного = Объект.ТипПеревозки.КонтрольЗаполненияГруза;
		// --- 
		УФ.Элементы.Маршрут.Видимость = Константы.CW_Мониторинг_Маршрут.Получить();
		УФ.Элементы.Маршрут.АвтоОтметкаНезаполненного = Объект.ТипПеревозки.КонтрольЗаполненияМаршрута;
		// --- 
		УФ.Элементы.ОперативныйМенеджер.Видимость = Константы.CW_Мониторинг_ОперативныйМенеджер.Получить();
		УФ.Элементы.ОперативныйМенеджер.АвтоОтметкаНезаполненного = Объект.ТипПеревозки.КонтрольЗаполненияОперативногоМенеджера;
		// --- 
		УФ.Элементы.МенеджерПродаж.Видимость = Константы.CW_Мониторинг_МенеджерПродаж.Получить();
		УФ.Элементы.МенеджерПродаж.АвтоОтметкаНезаполненного = Объект.ТипПеревозки.КонтрольЗаполненияМенеджераПродаж;
		
		// --- 
		Элемент = УФ.Элементы.БюджетТекущаяВерсия;
		Элемент.РедактированиеТекста=Ложь;
		Элемент.РежимВыбораИзСписка=Ложь;
		Элемент.КнопкаВыбора=Истина;
		Элемент.ОтображениеКнопкиВыбора = ОтображениеКнопкиВыбора.ОтображатьВПолеВвода;
		Элемент.КнопкаВыпадающегоСписка=Ложь;
		Элемент.СписокВыбора.Очистить();
		// --- 
		Элемент.ИсторияВыбораПриВводе=ИсторияВыбораПриВводе.НеИспользовать;
		
		// --- 
		
		ГруппаПользователя = CW_ПраваДоступа_ПИ.ГруппаПользователя(CW_Настройки.Пользователь());
		Если (ГруппаПользователя.ОграничениеПоТипамГрузоперевозок) Тогда
			
			УФ.Элементы.ТипПеревозки.РежимВыбораИзСписка=Истина;
			УФ.Элементы.ТипПеревозки.ОтображениеКнопкиВыбора = ОтображениеКнопкиВыбора.ОтображатьВПолеВвода;
			УФ.Элементы.ТипПеревозки.ИсторияВыбораПриВводе=ИсторияВыбораПриВводе.НеИспользовать;
			// --- 
			УФ.Элементы.ТипПеревозки.СписокВыбора.Очистить();
			МассивДоступныхТипов = Новый Массив;
			Для каждого Стр Из ГруппаПользователя.ДоступныеТипыГрузоперевозок Цикл
				УФ.Элементы.ТипПеревозки.СписокВыбора.Добавить(Стр.ТипГрузоперевозки);
				МассивДоступныхТипов.Добавить(Стр.ТипГрузоперевозки);
			КонецЦикла; 
			
			Если (НЕ Объект.ТипПеревозки.Пустая()) Тогда
				Если (МассивДоступныхТипов.Найти(Объект.ТипПеревозки) = Неопределено) Тогда
					УФ.Элементы.ТипПеревозки.Доступность = Ложь;
				КонецЕсли; 	
			КонецЕсли; 
			
		КонецЕсли; 
		
		//УстановитьЗаголовок(УФ);
		
	// Инициализация формы заказа
	ИначеЕсли (ФормаЗаказа(УФ)) Тогда 
		
		Если НЕ ЗначениеЗаполнено(Объект.ДатаСделкиФ) Тогда
			Объект.ДатаСделкиФ=ТекущаяДата();
		КонецЕсли; 
		
		Пользователь=CW_Настройки.Пользователь();
		НП = CW_Настройки.ПолучитьНастройкиПользователя(Пользователь);
		// --- 
		УФ.КонтролироватьПросрочкуПлановыхДат = НП.КонтролироватьПросрочкуПлановыхДат;
	
		УФ.ОтображениеФинансовогоРезультата = CW_Настройки.ПолучитьНастройкуПользователя(CW_Настройки.Пользователь(), "ОтображениеФинРез");
		УФ.ВыводитьРезультатВВалютеДокументов = CW_Настройки.ПолучитьНастройкуПользователя(CW_Настройки.Пользователь(), "ВыводитьФинансовыйРезультатВВалютеДокументов");
		УФ.ВРУ = CW_Настройки.ВалютаРегламентированногоУчета();
		
		//УФ.Элементы.Заявка.Видимость = ПолучитьФункциональнуюОпцию("CW_ИспользованиеЗаявок");
		// ---------------------------------------------------------------------------- 
		УФ.Элементы.СтраницаДекларации.Видимость = (Константы.CW_ВедетсяУчетДТ.Получить());
		
		Если (ПолучитьФункциональнуюОпцию("CW_ИспользованиеБюджетирования")) Тогда 
			БюджетИнициализация(УФ);
		Иначе 
			УФ.Элементы.СтраницаБюджет.Видимость = Ложь;
			УФ.Элементы.Форма_ФинансыРасходыДобавитьПоБюджету.Видимость = Ложь;
			УФ.Элементы.Форма_ФинансыДоходыДобавитьПоБюджету.Видимость = Ложь;
		КонецЕсли;
		
		ПраваДоступа(УФ);
		ОтборДокументовФинансовогоРезультата(УФ);
		УправлениеЭлементамиФормы(УФ); 
		
		// --- 
		
		ГруппаПользователя = CW_ПраваДоступа_ПИ.ГруппаПользователя(CW_Настройки.Пользователь());
		Если (ГруппаПользователя.ОграничениеПоТипамГрузоперевозок) Тогда
			
			УФ.Элементы.ТипПеревозки.РежимВыбораИзСписка=Истина;
			УФ.Элементы.ТипПеревозки.ОтображениеКнопкиВыбора = ОтображениеКнопкиВыбора.ОтображатьВПолеВвода;
			УФ.Элементы.ТипПеревозки.ИсторияВыбораПриВводе=ИсторияВыбораПриВводе.НеИспользовать;
			// --- 
			УФ.Элементы.ТипПеревозки.СписокВыбора.Очистить();
			МассивДоступныхТипов = Новый Массив;
			Для каждого Стр Из ГруппаПользователя.ДоступныеТипыГрузоперевозок Цикл
				УФ.Элементы.ТипПеревозки.СписокВыбора.Добавить(Стр.ТипГрузоперевозки);
				МассивДоступныхТипов.Добавить(Стр.ТипГрузоперевозки);
			КонецЦикла; 
			
			Если (НЕ Объект.ТипПеревозки.Пустая()) Тогда
				Если (МассивДоступныхТипов.Найти(Объект.ТипПеревозки) = Неопределено) Тогда
					Если (НЕ Объект.Ссылка.Пустая()) Тогда
						УФ.ТолькоПросмотр = Истина;	
					КонецЕсли; 
				КонецЕсли;	
			КонецЕсли; 
			
		КонецЕсли; 
		
		Если (НЕ ГруппаПользователя.ПолныеПрава) Тогда
			
			Если (НЕ ГруппаПользователя.ПравоРедактироватьНомерЗаказа) Тогда
				
				УФ.Элементы.Наименование.Доступность = Ложь;
				
			КонецЕсли; 
			
		КонецЕсли; 
		
		// --- 
		
		Элемент = УФ.Элементы.БюджетТекущаяВерсия;
		Элемент.РедактированиеТекста=Ложь;
		Элемент.РежимВыбораИзСписка=Ложь;
		Элемент.КнопкаВыбора=Истина;
		Элемент.ОтображениеКнопкиВыбора = ОтображениеКнопкиВыбора.ОтображатьВПолеВвода;
		Элемент.КнопкаВыпадающегоСписка=Ложь;
		Элемент.СписокВыбора.Очистить();
		// --- 
		Элемент.ИсторияВыбораПриВводе=ИсторияВыбораПриВводе.НеИспользовать;
		
		// --- 
		
	КонецЕсли; 
	
	// --- 
	
	_УФС.ОтключитьИсториюВыбораЭлементовФормы(УФ);
	
	// --- 
КонецФункции

&НаСервере
Функция УстановитьЗаголовок(УФ)
	// --- 
	
	Если (ЗначениеЗаполнено(УФ.Объект.Ссылка)) Тогда
		
		ТекстЗаголовка = "";
		Если (ЗначениеЗаполнено(УФ.Объект.CW_Представление)) Тогда
			ТекстЗаголовка = СокрЛП(УФ.Объект.CW_Представление);
		КонецЕсли; 
		ТекстСтатуса = Строка(УФ.ЛогистическийСтатус);
		
		Если (ПолучитьФункциональнуюОпцию("CW_ИспользоватьФинансовыеСтатусыГрузоперевозок")) Тогда
			Если CW_ФинансовыеСтатусыСервер.ФинансовыеСтатусыДоступныДляОбъкта(ТипЗнч(УФ.Объект.Ссылка)) Тогда
				
				СоответствиеПервогоСтатуса 	= Справочники.CW_ФинансовыеСтатусы.ПолучитьСоответствиеНеопредленногоСтатуса();
				ПервыйСтатус 				= СоответствиеПервогоСтатуса.Получить(ТипЗнч(УФ.Объект.Ссылка));
				СтрокаФинансовогоСтатуса    = Строка(ПервыйСтатус);
				
				ТекстСтатуса = ТекстСтатуса + " / "+СтрокаФинансовогоСтатуса;
			КонецЕсли;
		КонецЕсли; 
		
		ТекстЗаголовка = ТекстЗаголовка+ " ("+ТекстСтатуса+")";
		// --- 
		УФ.Заголовок = ТекстЗаголовка;
		
	Иначе
		
		Если (ЗначениеЗаполнено(УФ.Объект.CW_Представление)) Тогда
			
			УФ.Заголовок = "Новая грузоперевозка: "+УФ.Объект.CW_Представление;
			
		Иначе
			
			УФ.Заголовок = "Новая грузоперевозка";
			
		КонецЕсли; 
		
	КонецЕсли; 	
	
	// --- 
КонецФункции
 
&НаСервере
Функция ПолучитьСтруктуруРедактируемыхРеквизитовШапки(ЭтоГрузоперевозка) Экспорт
	
	СтркутураРеквизитовШапки = Новый Структура;
	
	Если ЭтоГрузоперевозка Тогда
		СтркутураРеквизитовШапки.Вставить("Представление"		, CW_ПраваДоступа.ПравоДоступно("РедактированиеОсновныхСвойствГрузоперевозок_Представление"));
		СтркутураРеквизитовШапки.Вставить("Типоразмер"			, CW_ПраваДоступа.ПравоДоступно("РедактированиеОсновныхСвойствГрузоперевозок_Типоразмер"));
		СтркутураРеквизитовШапки.Вставить("Заказ"				, CW_ПраваДоступа.ПравоДоступно("РедактированиеОсновныхСвойствГрузоперевозок_Заказ"));
	КонецЕсли;
	
	СтркутураРеквизитовШапки.Вставить("Код"					, CW_ПраваДоступа.ПравоДоступно("РедактированиеОсновныхСвойствГрузоперевозок_Код"));
	СтркутураРеквизитовШапки.Вставить("ДатаСделкиФ"			, CW_ПраваДоступа.ПравоДоступно("РедактированиеОсновныхСвойствГрузоперевозок_ДатаСделкиФ"));
	СтркутураРеквизитовШапки.Вставить("ТипПеревозки"		, CW_ПраваДоступа.ПравоДоступно("РедактированиеОсновныхСвойствГрузоперевозок_ТипПеревозки"));
	СтркутураРеквизитовШапки.Вставить("МенеджерПродаж"		, CW_ПраваДоступа.ПравоДоступно("РедактированиеОсновныхСвойствГрузоперевозок_МенеджерПродаж"));
	СтркутураРеквизитовШапки.Вставить("ОперативныйМенеджер"	, CW_ПраваДоступа.ПравоДоступно("РедактированиеОсновныхСвойствГрузоперевозок_ОперативныйМенеджер"));
	СтркутураРеквизитовШапки.Вставить("Клиент"				, CW_ПраваДоступа.ПравоДоступно("РедактированиеОсновныхСвойствГрузоперевозок_Клиент"));
	СтркутураРеквизитовШапки.Вставить("Маршрут"				, CW_ПраваДоступа.ПравоДоступно("РедактированиеОсновныхСвойствГрузоперевозок_Маршрут"));
	СтркутураРеквизитовШапки.Вставить("Груз"				, CW_ПраваДоступа.ПравоДоступно("РедактированиеОсновныхСвойствГрузоперевозок_Груз"));
	СтркутураРеквизитовШапки.Вставить("Заявка"				, CW_ПраваДоступа.ПравоДоступно("РедактированиеОсновныхСвойствГрузоперевозок_Заявка"));
	
	Возврат СтркутураРеквизитовШапки;
	
КонецФункции

// Управляет видимостью и доступностью элементов форм "Грузоперевозка" и "Заказ"
// в зависимости от прав пользователя
&НаСервере
Функция ПраваДоступа(УФ)
	
	БлокироватьОбъекты 	= CW_АрхивОбъектовСервер.БлокироватьОбъектыПриПереводеВАрхив(); 
	Архив	= УФ.Объект.Архив и БлокироватьОбъекты;
	
	// получим права
	ПравоЗакрытияМониторинга = CW_ПраваДоступа.ПравоДоступно("БлокировкаМониторинга");
	ПравоОтменыЗакрытияМониторинга = CW_ПраваДоступа.ПравоДоступно("ОтменаБлокировкиМониторинга");
	ДобавлениеГрузоперевозок = CW_ПраваДоступа.ПравоДоступно("ДобавлениеГрузоперевозок");
	ПросмотрБюджетов = CW_ПраваДоступа.ПравоДоступно("ПросмотрБюджетов");
	ПросмотрФинансов = CW_ПраваДоступа.ПравоДоступно("ПросмотрФинансов");
	ПросмотрРасходов = CW_ПраваДоступа.ПравоДоступно("ПросмотрФинансов_Расходы");
	ПросмотрДоходов = CW_ПраваДоступа.ПравоДоступно("ПросмотрФинансов_Доходы");
	ПравоАнализаЭкономики = CW_ПраваДоступа.ПравоДоступно("АнализЭкономикиГрузоперевозок"); 
	ЕстьПравоРедактированиеОсновныхСвойствГрузоперевозок = CW_ПраваДоступа.ПравоДоступно("РедактированиеОсновныхСвойствГрузоперевозок");
	
	
	ИспользуетсяБлокировка = УФ.ИспользуетсяБлокировкаМониторинга;
	БлокировкаМониторинга = Ложь;
	Если (ИспользуетсяБлокировка) Тогда
		БлокировкаМониторинга = ЗначениеЗаполнено(УФ.ДатаБлокировкиМониторинга);
	КонецЕсли; 
	
	// форма грузоперевозки
	Если (ФормаГрузоперевозки(УФ)) Тогда
		
		УФ.ГруппаПользователя = CW_ПраваДоступа_ПИ.ГруппаПользователя(CW_Настройки.Пользователь());
		Если (УФ.ГруппаПользователя.ПолныеПрава) Тогда
			УФ.ГруппаПользователя = Справочники.CW_ГруппыПользователей.Администраторы;
		КонецЕсли;
		
		Если ЕстьПравоРедактированиеОсновныхСвойствГрузоперевозок Тогда
			СтркутураРеквизитовШапки = ПолучитьСтруктуруРедактируемыхРеквизитовШапки(истина);
		КонецЕсли;
		
		ТолькоПросмотрШапки =  (НЕ ЕстьПравоРедактированиеОсновныхСвойствГрузоперевозок  ИЛИ БлокировкаМониторинга);
		Если Не ТолькоПросмотрШапки Тогда
			
			//по списку реквизитов
			Для Каждого ЭлементСтркутуры из СтркутураРеквизитовШапки Цикл
				УФ.Элементы[ЭлементСтркутуры.Ключ].ТолькоПросмотр = Не ЭлементСтркутуры.Значение;
			КонецЦикла;
		КонецЕсли;
		
		УФ.Элементы.ГруппаШапка.ТолькоПросмотр = ТолькоПросмотрШапки;
		УФ.Элементы.Заказ.ТолькоПросмотр = (НЕ ДобавлениеГрузоперевозок ИЛИ БлокировкаМониторинга);
		УФ.Элементы.ПерезаполнитьРеквизитыШапкиПоЗаказу.Доступность = Не УФ.Элементы.Заказ.ТолькоПросмотр и НЕ Архив;
		
		Если (ИспользуетсяБлокировка) Тогда
			ВидимостьКнопки = ПравоЗакрытияМониторинга;
			Если (БлокировкаМониторинга)  Тогда
				ВидимостьКнопки = ПравоОтменыЗакрытияМониторинга;
			КонецЕсли; 
			ВидимостьКнопки = ВидимостьКнопки И НЕ ЗначениеЗаполнено(УФ.Объект.Заказ);
			УФ.Элементы.ИзменитьДатуБлокировкиГрузоперевозок.Видимость = ВидимостьКнопки;
		КонецЕсли; 
		
		// параметры
		УФ.Элементы.ДПГ.ИзменятьСоставСтрок = (НЕ БлокировкаМониторинга);
		УФ.Элементы.ДПГ_ПерезаполнитьПараметрыПоШаблону.Доступность = (НЕ БлокировкаМониторинга) и НЕ Архив;
		//УФ.Элементы.ГруппаШапка.ТолькоПросмотр = (БлокировкаМониторинга);
		УФ.Элементы.ПерезаполнитьРеквизитыШапкиПоЗаказу.Доступность = (НЕ БлокировкаМониторинга) и НЕ Архив;
		УФ.Элементы.Форма_ПроверитьНомерГрузоперевозки.Доступность = (НЕ БлокировкаМониторинга) и НЕ Архив;
		
		УФ.Элементы.ДеревоПараметровРедактировать.Доступность 			= НЕ БлокировкаМониторинга и НЕ Архив;
		УФ.Элементы.ДПГДПГ_ДобавитьГруппу.Доступность 					= НЕ БлокировкаМониторинга и НЕ Архив;
		УФ.Элементы.ДПГКонтекстноеМенюСтрока_Вставить.Доступность		= НЕ БлокировкаМониторинга и НЕ Архив;
		УФ.Элементы.ДПГКонтекстноеМенюСтрока_Вырезать.Доступность		= НЕ БлокировкаМониторинга и НЕ Архив;
		УФ.Элементы.ДПГКонтекстноеМенюДПГ_ДобавитьГруппу.Доступность	= НЕ БлокировкаМониторинга и НЕ Архив;
		УФ.Элементы.ДПГКонтекстноеМенюИзменить.Доступность				= НЕ БлокировкаМониторинга и НЕ Архив;

		//УФ.ТолькоПросмотр = БлокировкаМониторинга;
		//УФ.Элементы.Комментарий.ТолькоПросмотр = Ложь;
		
		// закладка бюджетов
		УФ.Элементы.СтраницаБюджет.Доступность = (ПросмотрБюджетов И ПолучитьФункциональнуюОпцию("CW_ИспользованиеБюджетирования"));
		Если (УФ.Элементы.СтраницаБюджет.Доступность) Тогда
			
			ПравоРедактирования = CW_ПраваДоступа.ПравоДоступно("РедактированиеБюджетов");
			Если НЕ ПравоРедактирования Тогда
				
				УФ.Элементы.БюджетРасходы.ИзменятьСоставСтрок = Ложь;
				УФ.Элементы.БюджетРасходы.ТолькоПросмотр = Истина;
				// --- 
				УФ.Элементы.БюджетДоходы.ИзменятьСоставСтрок = Ложь;
				УФ.Элементы.БюджетДоходы.ТолькоПросмотр = Истина;
				
				УФ.Элементы.БюджетДоходы.ТолькоПросмотр = Истина;
				
			КонецЕсли; 
			
			УФ.Элементы.БюджетДоходыФорма_БюджетДоходыПересчитатьПоКурсу.Доступность  = ПравоРедактирования или НЕ Архив;
			УФ.Элементы.БюджетДоходыФорма_БюджетЗаполнитьРасходыПоДоходам.Доступность = ПравоРедактирования или НЕ Архив;
			
			УФ.Элементы.БюджетРасходыФорма_БюджетЗаполнитьДоходыПоРасходам.Доступность = ПравоРедактирования или НЕ Архив;
			УФ.Элементы.БюджетРасходыФорма_БюджетРасходыПересчитатьПоКурсу.Доступность = ПравоРедактирования или НЕ Архив;

		КонецЕсли; 
		
		// закладка финансов
		УФ.Элементы.СтраницаФинансы.Доступность = ПросмотрФинансов;
		Если (УФ.Элементы.СтраницаФинансы.Доступность) Тогда
			
			УФ.Элементы.ГруппаРасходы.Видимость = ПросмотрРасходов;
			Если (ПросмотрРасходов) Тогда
				
				ПравоРедактирования_Расходы = (CW_ПраваДоступа.ПравоДоступно("РедактированиеФинансов_Расходы_Счета") ИЛИ CW_ПраваДоступа.ПравоДоступно("РедактированиеФинансов_Расходы_Акты"));
				УФ.РедактированиеРасходов = ПравоРедактирования_Расходы;
				Если (НЕ ПравоРедактирования_Расходы) Тогда
					
					УФ.Элементы.ФинансыРасходы.ИзменятьСоставСтрок = Ложь;
					УФ.Элементы.ФинансыРасходы.ТолькоПросмотр = Истина;
					// --- 
					УФ.Элементы.Форма_ФинансыРасходыДобавитьПоБюджету.Доступность = НЕ Архив;
					
				КонецЕсли; 
				
			КонецЕсли; 
			
			УФ.Элементы.ГруппаДоходы.Видимость = ПросмотрДоходов;
			Если (ПросмотрДоходов) Тогда
				
				ПравоРедактирования_Доходы = (CW_ПраваДоступа.ПравоДоступно("РедактированиеФинансов_Доходы_Счета") ИЛИ CW_ПраваДоступа.ПравоДоступно("РедактированиеФинансов_Доходы_Акты"));
				УФ.РедактированиеДоходов = ПравоРедактирования_Доходы;
				Если (НЕ ПравоРедактирования_Доходы) Тогда
					
					УФ.Элементы.ФинансыДоходы.ИзменятьСоставСтрок = Ложь;
					УФ.Элементы.ФинансыДоходы.ТолькоПросмотр = Истина;
					// --- 
					УФ.Элементы.Форма_ФинансыДоходыДобавитьПоБюджету.Доступность = НЕ Архив;
					
				КонецЕсли; 
				
			КонецЕсли; 
			
			// фин.результат список
			УФ.Элементы.ГруппаФинансовыйРезультатСписок.Видимость = (ПросмотрРасходов И ПросмотрДоходов) И ПолучитьФункциональнуюОпцию("CW_ИспользованиеСхемыПеревыставленияПоСтавкам");
			// игого и закрытие г/п
			УФ.Элементы.ГруппаПодвалФинансов.Видимость = (ПросмотрРасходов И ПросмотрДоходов);
			
		КонецЕсли;
		УФ.Элементы.СтраницаСвязи.Доступность = (УФ.Элементы.СтраницаСвязи.Видимость И CW_ПраваДоступа.ПравоДоступно("РедактированиеОсновныхСвойствГрузоперевозок"));
		УФ.Элементы.СтраницаСвязи.ТолькоПросмотр = (БлокировкаМониторинга);
		
		// управление доступностью отчетов
		УФ.Элементы.Форма_ОтчетПоГрузоперевозке.Видимость = (ПросмотрРасходов И ПросмотрДоходов и ПравоАнализаЭкономики);
		УФ.Элементы.Форма_ОтчетНеперевыставленныеЗатраты.Видимость = (ПросмотрРасходов И ПросмотрДоходов);
		УФ.Элементы.Форма_ОтчетПланФакторныйАнализБюджета.Видимость = (ПросмотрРасходов И ПросмотрДоходов И ПросмотрБюджетов и ПравоАнализаЭкономики);
		УФ.Элементы.Форма_ОтчетАнализПрибыли.Видимость = (ПросмотрРасходов И ПросмотрДоходов И ПросмотрБюджетов и ПравоАнализаЭкономики);
		УФ.Элементы.ФормаОбщаяКомандаCW_ОтчетВедомостьНеперевыставленныхЗатрат.Видимость = (ПросмотрРасходов И ПросмотрДоходов);
		УФ.Элементы.ФормаФорма_ОтчетНеактированныеВходящиеСчета.Видимость = ПросмотрРасходов;
		УФ.Элементы.ФормаФорма_ОтчетНеактированныеИсходящиеСчета.Видимость = ПросмотрДоходов;
		
	// форма заказа
	ИначеЕсли (ФормаЗаказа(УФ)) Тогда
		
		ЕстьПравоРедактированиеОсновныхСвойствГрузоперевозок = CW_ПраваДоступа.ПравоДоступно("РедактированиеОсновныхСвойствГрузоперевозок");
		
		Если ЕстьПравоРедактированиеОсновныхСвойствГрузоперевозок Тогда
			СтркутураРеквизитовШапки = ПолучитьСтруктуруРедактируемыхРеквизитовШапки(Ложь);
		КонецЕсли;
		
		ТолькоПросмотрШапки =  (НЕ ЕстьПравоРедактированиеОсновныхСвойствГрузоперевозок  ИЛИ БлокировкаМониторинга);
		
		Если Не ТолькоПросмотрШапки Тогда
			//По списку реквизитов
			Для Каждого ЭлементСтркутуры из СтркутураРеквизитовШапки Цикл
				УФ.Элементы[ЭлементСтркутуры.Ключ].ТолькоПросмотр = Не ЭлементСтркутуры.Значение;
			КонецЦикла;
		КонецЕсли;
		
		// реквизиты шапки
		УФ.Элементы.ГруппаШапка.ТолькоПросмотр = ТолькоПросмотрШапки;
		
		// г/п
		УФ.Элементы.Журнал.ИзменятьСоставСтрок = (CW_ПраваДоступа.ПравоДоступно("ДобавлениеГрузоперевозок") И НЕ БлокировкаМониторинга);
		
		// параметры
		УФ.Элементы.ДПГ.ИзменятьСоставСтрок = (НЕ БлокировкаМониторинга);
		УФ.Элементы.ДПГ_ПерезаполнитьПараметрыПоШаблону.Доступность = (НЕ БлокировкаМониторинга)  и НЕ Архив;
		
		УФ.Элементы.ЖурналДобавитьГрузоперевозокиСписком.Доступность 	= НЕ БлокировкаМониторинга и НЕ Архив;
		УФ.Элементы.ДПГДПГ_ДобавитьГруппу.Доступность 					= НЕ БлокировкаМониторинга и НЕ Архив;
		УФ.Элементы.ДеревоПараметровРедактировать.Доступность 			= НЕ БлокировкаМониторинга и НЕ Архив;
		
		Если (ИспользуетсяБлокировка) Тогда
			ВидимостьКнопки = ПравоЗакрытияМониторинга;
			Если (БлокировкаМониторинга) Тогда
				ВидимостьКнопки = ПравоОтменыЗакрытияМониторинга;
			КонецЕсли; 
			УФ.Элементы.ИзменитьДатуБлокировкиГрузоперевозок.Видимость = ВидимостьКнопки;
		КонецЕсли; 
		
		// закладка бюджетов
		ПросмотрБюджетов = CW_ПраваДоступа.ПравоДоступно("ПросмотрБюджетов");
		УФ.Элементы.СтраницаБюджет.Доступность = ПросмотрБюджетов И ПолучитьФункциональнуюОпцию("CW_ИспользованиеБюджетирования");
		Если УФ.Элементы.СтраницаБюджет.Доступность Тогда
			
			ПравоРедактирования = CW_ПраваДоступа.ПравоДоступно("РедактированиеБюджетов");
			Если НЕ ПравоРедактирования Тогда
				
				УФ.Элементы.БюджетРасходы.ИзменятьСоставСтрок 	= Ложь;
				УФ.Элементы.БюджетРасходы.ТолькоПросмотр 		= Истина;
				// --- 
				УФ.Элементы.БюджетДоходы.ИзменятьСоставСтрок 	= Ложь;
				УФ.Элементы.БюджетДоходы.ТолькоПросмотр 		= Истина;
				
				УФ.Элементы.БюджетРасходыДерево.ИзменятьСоставСтрок = Ложь;
				УФ.Элементы.БюджетРасходыДерево.ТолькоПросмотр 		= Истина;
				// --- 
				УФ.Элементы.БюджетДоходыДерево.ИзменятьСоставСтрок 	= Ложь;
				УФ.Элементы.БюджетДоходыДерево.ТолькоПросмотр 		= Истина;
				
			КонецЕсли; 
			
			УФ.Элементы.БюджетРасходыФорма_БюджетЗаполнитьДоходыПоРасходам.Доступность 	= ПравоРедактирования или Архив;
			УФ.Элементы.БюджетРасходыФорма_БюджетРасходыПересчитатьПоКурсу.Доступность	= ПравоРедактирования или Архив;
			
			УФ.Элементы.БюджетДоходыФорма_БюджетЗаполнитьРасходыПоДоходам.Доступность 	= ПравоРедактирования или Архив;
			УФ.Элементы.БюджетДоходыФорма_БюджетДоходыПересчитатьПоКурсу.Доступность 	= ПравоРедактирования или Архив;
			
			УФ.Элементы.БюджетРасходыФорма_БюджетЗаполнитьДоходыПоРасходам.Доступность 	= ПравоРедактирования или Архив;
			УФ.Элементы.БюджетРасходыФорма_БюджетРасходыПересчитатьПоКурсу.Доступность	= ПравоРедактирования или Архив;
			
			УФ.Элементы.БюджетДоходыФорма_БюджетЗаполнитьРасходыПоДоходам.Доступность 	= ПравоРедактирования или Архив;
			УФ.Элементы.БюджетДоходыФорма_БюджетДоходыПересчитатьПоКурсу.Доступность 	= ПравоРедактирования или Архив;
			
			
			УФ.Элементы.БюджетРасходыФорма_БюджетРасходыДеревоПересчитатьПоКурсу.Доступность 	= ПравоРедактирования или Архив;
			УФ.Элементы.Форма_БюджетЗаполнитьДоходыПоРасходамДерево.Доступность 				= ПравоРедактирования или Архив;

			УФ.Элементы.БюджетДоходыДеревоФорма_БюджетЗаполнитьРасходыПоДоходамДерево.Доступность 	= ПравоРедактирования или Архив;
			УФ.Элементы.БюджетДоходыФорма_БюджетДоходыДеревоПересчитатьПоКурсу.Доступность 			= ПравоРедактирования или Архив;

		КонецЕсли;
		
		// закладка финансов
		УФ.Элементы.СтраницаФинансы.Доступность = CW_ПраваДоступа.ПравоДоступно("ПросмотрФинансов");
		УФ.ПросмотрРасходов = CW_ПраваДоступа.ПравоДоступно("ПросмотрФинансов_Расходы");
		УФ.ПросмотрДоходов = CW_ПраваДоступа.ПравоДоступно("ПросмотрФинансов_Доходы");
		Если УФ.Элементы.СтраницаФинансы.Доступность Тогда
			
			УФ.Элементы.ГруппаРасходы.Видимость = УФ.ПросмотрРасходов;
			Если (УФ.ПросмотрРасходов) Тогда
				
				ПравоРедактирования_Расходы = (CW_ПраваДоступа.ПравоДоступно("РедактированиеФинансов_Расходы_Счета") ИЛИ CW_ПраваДоступа.ПравоДоступно("РедактированиеФинансов_Расходы_Акты"));
				УФ.РедактированиеРасходов = ПравоРедактирования_Расходы;
				Если (НЕ ПравоРедактирования_Расходы) Тогда
					
					УФ.Элементы.ФинансыРасходы.ИзменятьСоставСтрок = Ложь;
					УФ.Элементы.ФинансыРасходы.ТолькоПросмотр = Истина;
					// --- 
					УФ.Элементы.Форма_ФинансыРасходыДобавитьПоБюджету.Доступность = Ложь;
					
				КонецЕсли; 
				
			КонецЕсли; 
			
			// --- 
			
			УФ.Элементы.ГруппаДоходы.Видимость = УФ.ПросмотрДоходов;
			Если (УФ.ПросмотрДоходов) Тогда
				
				ПравоРедактирования_Доходы = (CW_ПраваДоступа.ПравоДоступно("РедактированиеФинансов_Доходы_Счета") ИЛИ CW_ПраваДоступа.ПравоДоступно("РедактированиеФинансов_Доходы_Акты"));
				УФ.РедактированиеДоходов = ПравоРедактирования_Доходы;
				Если (НЕ ПравоРедактирования_Доходы) Тогда
					
					УФ.Элементы.ФинансыДоходы.ИзменятьСоставСтрок = Ложь;
					УФ.Элементы.ФинансыДоходы.ТолькоПросмотр = Истина;
					// --- 
					УФ.Элементы.Форма_ФинансыДоходыДобавитьПоБюджету.Доступность = Ложь;
					
				КонецЕсли; 
				
			КонецЕсли; 
			
			// --- 
			
			// фин.результат список
			УФ.Элементы.ГруппаФинансовыйРезультатСписок.Видимость = (УФ.ПросмотрРасходов И УФ.ПросмотрДоходов) И ПолучитьФункциональнуюОпцию("CW_ИспользованиеСхемыПеревыставленияПоСтавкам");
			// игого и закрытие г/п
			УФ.Элементы.ГруппаПодвалФинансов.Видимость = (УФ.ПросмотрРасходов И УФ.ПросмотрДоходов);
			
			// --- 
			
		КонецЕсли;
		
		// управление доступностью отчетов
		УФ.Элементы.Форма_ОтчетПоГрузоперевозке.Видимость = (ПросмотрРасходов И ПросмотрДоходов и ПравоАнализаЭкономики);
		УФ.Элементы.Форма_ОтчетНеперевыставленныеЗатраты.Видимость = (ПросмотрРасходов И ПросмотрДоходов);
		УФ.Элементы.Форма_ОтчетПланФакторныйАнализБюджета.Видимость = (ПросмотрРасходов И ПросмотрДоходов И ПросмотрБюджетов и ПравоАнализаЭкономики);
		УФ.Элементы.Форма_ОтчетАнализПрибыли.Видимость = (ПросмотрРасходов И ПросмотрДоходов И ПросмотрБюджетов и ПравоАнализаЭкономики);
		УФ.Элементы.ФормаОбщаяКомандаCW_ОтчетВедомостьНеперевыставленныхЗатрат.Видимость = (ПросмотрРасходов И ПросмотрДоходов);
		УФ.Элементы.ФормаФорма_ОтчетНеактированныеВходящиеСчета.Видимость = ПросмотрРасходов;
		УФ.Элементы.ФормаФорма_ОтчетНеактированныеИсходящиеСчета.Видимость = ПросмотрДоходов;
	
	КонецЕсли; // анализ формы "Грузоперевозка" или "Заказ" 
	
КонецФункции
 
&НаСервере
Функция УправлениеЭлементамиФормы(УФ)
	// --- 
	
	Если (ФормаГрузоперевозки(УФ)) Тогда
		
		УФ.Элементы.Примечание.Видимость = (ЗначениеЗаполнено(УФ.Объект.Примечание));
		УФ.Элементы.ДеревоПараметровОтображениеКомментария.Пометка = УФ.Элементы.Примечание.Видимость;
		// --- 
		
		Этоновый = УФ.Объект.Ссылка.Пустая();
		УФ.Элементы.СтраницаФинансы.Видимость = (НЕ Этоновый И УФ.Элементы.СтраницаФинансы.Доступность);
		УФ.Элементы.СтраницаСвязи.Видимость = (НЕ Этоновый И УФ.Элементы.СтраницаСвязи.Доступность);
		Если (УФ.Элементы.СтраницаФинансы.Видимость) Тогда
			УФ.Элементы.ГруппаЗакрытиеФинансов.Видимость = ПолучитьФункциональнуюОпцию("CW_ИспользованиеБлокировкиФинансов");
		КонецЕсли; 
		УФ.Элементы.СтраницаБюджет.Видимость = (НЕ Этоновый И УФ.Элементы.СтраницаБюджет.Доступность);
		// --- 
		УФ.Элементы.ФормаГруппаОтчеты.Видимость = (НЕ Этоновый);
		// --- 
		//УФ.Элементы.ФормаОбщаяКомандаCW_Печать.Видимость = (НЕ Этоновый);
		// --- 
		Если (НЕ Этоновый) Тогда
			
			ОбновитьДатуЗакрытия(УФ);
			// --- 
			УФ.ВыявлениеРезультата.Параметры.УстановитьЗначениеПараметра("Аналитика",УФ.Объект.Ссылка);
			_УФС.ДобавитьОтбор(УФ.ВыявлениеРезультата.Отбор,"Аналитика",,УФ.Объект.Ссылка);
			
		//	УФ.Элементы.ГруппаФинансовыйРезультатСписок.Видимость = (УФ.Объект.Заказ.Пустая());
			
		КонецЕсли; 
		
		Если (УФ.Элементы.СтраницаФинансы.Видимость) Тогда
			
			УФ.Элементы.Форма_ФинансыРасходыОтобразитьСтатьи.Пометка 	= УФ.ФинансыРасходыОтображатьПостатейно;
			УФ.Элементы.Форма_ФинансыДоходыОтобразитьСтатьи.Пометка 	= УФ.ФинансыДоходыОтображатьПостатейно;
			УФ.Элементы.Форма_ФинансыТранспортОтобразитьСтатьи.Пометка	= УФ.ФинансыТранспортОтображатьПостатейно;
			
		КонецЕсли; 
		
		Если (УФ.Объект.ТипПеревозки.ВидПеревозки=Перечисления.CW_ВидыПеревозок.Контейнер) Тогда
			
			УФ.Элементы.Типоразмер.Видимость=Истина;
			УФ.Элементы.Представление.Заголовок="Контейнер";
			
		ИначеЕсли (УФ.Объект.ТипПеревозки.ВидПеревозки=Перечисления.CW_ВидыПеревозок.Прочее) Тогда 
			
			УФ.Элементы.Типоразмер.Видимость=Ложь;
			УФ.Элементы.Представление.Заголовок="Представление";
			
		Иначе
			
			УФ.Элементы.Типоразмер.Видимость=Ложь;
			УФ.Элементы.Представление.Заголовок="Представление";
			
		КонецЕсли; 
		
		Если (УФ.Элементы.СтраницаБюджет.Доступность) Тогда
			
			УФ.Элементы.Форма_БюджетКонтрагенты.Видимость = (Константы.CW_ОграничиватьВыборКонтрагентовПоБюджету.Получить() 
			И CW_ПраваДоступа.ПравоДоступно("НоминированиеКонтрагентовПоБюджету")
			И УФ.Объект.Заказ.Пустая());
			Если УФ.Элементы.Форма_БюджетКонтрагенты.Видимость Тогда
				
				УФ.Элементы.Форма_БюджетКонтрагенты.Заголовок = "Контрагенты"+?(УФ.Объект.КонтрагентыПоБюджету.Количество()=0,""," ("+Строка(УФ.Объект.КонтрагентыПоБюджету.Количество())+")");
				
			КонецЕсли;
			
		КонецЕсли;
		
		//ОборудованиеПривязано = (ЗначениеЗаполнено(УФ.Объект.ОтслеживаемоеОборудование));
		//Если Не УФ.Элементы.Представление.ТолькоПросмотр Тогда
		//	УФ.Элементы.Представление.ТолькоПросмотр = ОборудованиеПривязано;
		//КонецЕсли;
		//Если НЕ	УФ.Элементы.Типоразмер.ТолькоПросмотр Тогда
		//	УФ.Элементы.Типоразмер.ТолькоПросмотр = ОборудованиеПривязано;
		//КонецЕсли;
		
		// отметка комментарий
		Если СокрЛП(УФ.Объект.Комментарий) = "" Тогда
			
			УФ.Элементы.СтраницаКомментарий.Заголовок = "Комментарий";
			
		Иначе
			
			УФ.Элементы.СтраницаКомментарий.Заголовок = "Комментарий (*)";
			
		КонецЕсли; 
		
	ИначеЕсли (ФормаЗаказа(УФ)) Тогда 
		
		Этоновый = УФ.Объект.Ссылка.Пустая();
		
		УФ.Элементы.Примечание.Видимость = (ЗначениеЗаполнено(УФ.Объект.Примечание));

		УФ.Элементы.СтраницаФинансы.Видимость = НЕ Этоновый И УФ.Элементы.СтраницаФинансы.Доступность;
		Если (УФ.Элементы.СтраницаФинансы.Видимость) Тогда
			УФ.Элементы.ГруппаЗакрытиеФинансов.Видимость = ПолучитьФункциональнуюОпцию("CW_ИспользованиеБлокировкиФинансов");
		КонецЕсли;
		УФ.Элементы.СтраницаЖурналГрузоперевозок.Видимость = НЕ Этоновый;
		УФ.Элементы.СтраницаБюджет.Видимость = НЕ Этоновый И УФ.Элементы.СтраницаБюджет.Доступность;
		///УФ.Элементы.ФормаОбщаяКомандаCW_Печать.Видимость = НЕ Этоновый;
		УФ.Элементы.ФормаГруппаОтчеты.Видимость = НЕ Этоновый;
		// --- 
		Если НЕ Этоновый Тогда
			
			ОбновитьДатуЗакрытия(УФ);
			
		КонецЕсли; 
		
		Если УФ.Элементы.СтраницаФинансы.Видимость Тогда
			
			УФ.Элементы.РасходыНоменклатура.Видимость 					= УФ.ФинансыРасходыОтображатьПостатейно;
			УФ.Элементы.ДоходыНоменклатура.Видимость 					= УФ.ФинансыДоходыОтображатьПостатейно;
			УФ.Элементы.Форма_ФинансыТранспортОтобразитьСтатьи.Пометка	= УФ.ФинансыТранспортОтображатьПостатейно;
		
		КонецЕсли; 
		
		// --- 	
		
		Если УФ.Элементы.СтраницаБюджет.Доступность Тогда
			
			УФ.Элементы.Форма_БюджетКонтрагенты.Видимость = (Константы.CW_ОграничиватьВыборКонтрагентовПоБюджету.Получить() И CW_ПраваДоступа.ПравоДоступно("НоминированиеКонтрагентовПоБюджету"));
			Если УФ.Элементы.Форма_БюджетКонтрагенты.Видимость Тогда
				
				УФ.Элементы.Форма_БюджетКонтрагенты.Заголовок = "Контрагенты"+?(УФ.Объект.КонтрагентыПоБюджету.Количество()=0,""," ("+Строка(УФ.Объект.КонтрагентыПоБюджету.Количество())+")");
				
			КонецЕсли; 
			
		КонецЕсли; 
		
		// --- 
		
		Если СокрЛП(УФ.Объект.Комментарий) = "" Тогда
			
			УФ.Элементы.СтраницаКомментарий.Заголовок = "Комментарий";
			
		Иначе
			
			УФ.Элементы.СтраницаКомментарий.Заголовок = "Комментарий *";
			
		КонецЕсли;
		
		// ---   
		
	КонецЕсли; 
	
	// --- 
КонецФункции

&НаСервере
Функция ОбновитьДатуЗакрытия(УФ)
	// --- 
	БлокироватьОбъекты 	= CW_АрхивОбъектовСервер.БлокироватьОбъектыПриПереводеВАрхив(); 
	Архив	= УФ.Объект.Архив и БлокироватьОбъекты;
	
	УФ.ДатаЗакрытия = CW_Мониторинг.ПолучитьДатуЗакрытия(УФ.Объект.Ссылка);
	Если УФ.ДатаЗакрытия = Дата(1,1,1) Тогда
		
		Текст = "Дата блокировки:  <Нет>";
		УФ.Элементы.ВыявлениеРезультата.ТолькоПросмотр = Ложь;
		
	Иначе
		
		Текст = "Дата блокировки:  "+Формат(УФ.ДатаЗакрытия,"ДФ=dd.MM.yyyy");
		УФ.Элементы.ВыявлениеРезультата.ТолькоПросмотр = Истина;
		
	КонецЕсли; 
	УФ.Элементы.НадписьЗакрытие.Заголовок = Текст;
	
	// определяем видимость кнопки редактирования закрытия
	Если (ФормаГрузоперевозки(УФ)) Тогда
		ВидимостьЗакрытия = CW_ПраваДоступа.ПравоДоступно("ЗакрытиеГрузоперевозок") И УФ.Объект.Заказ.Пустая();
	Иначе
		ВидимостьЗакрытия = CW_ПраваДоступа.ПравоДоступно("ЗакрытиеГрузоперевозок");
	КонецЕсли; 
	
	Если ВидимостьЗакрытия Тогда
		Если (НЕ CW_ПраваДоступа.ПравоДоступно("ОтменаЗакрытияГрузоперевозок")) И УФ.ДатаЗакрытия <> Дата(1,1,1) Тогда
			ВидимостьЗакрытия = Ложь;
		КонецЕсли;
	КонецЕсли; 
	УФ.Элементы.Форма_ИзменитьДатуЗакрытия.Видимость = ВидимостьЗакрытия;
	
	// блокируем создание документов
	ДатаЗакрытияУстановлена = (УФ.ДатаЗакрытия <> Дата(1,1,1));
	// --- 
	Если (УФ.РедактированиеРасходов) Тогда
		УФ.Элементы.ФинансыРасходы.ТолькоПросмотр = (ДатаЗакрытияУстановлена);
		УФ.Элементы.ФинансыРасходы.ИзменятьСоставСтрок = (НЕ ДатаЗакрытияУстановлена);
		УФ.Элементы.Форма_ФинансыРасходыДобавитьПоБюджету.Доступность = (НЕ ДатаЗакрытияУстановлена) и Не Архив;;	
	КонецЕсли; 
	// --- 
	Если (УФ.РедактированиеДоходов) Тогда
		УФ.Элементы.ФинансыДоходы.ТолькоПросмотр = (ДатаЗакрытияУстановлена);
		УФ.Элементы.ФинансыДоходы.ИзменятьСоставСтрок = (НЕ ДатаЗакрытияУстановлена);
		УФ.Элементы.Форма_ФинансыДоходыДобавитьПоБюджету.Доступность = (НЕ ДатаЗакрытияУстановлена) и Не Архив;
	КонецЕсли; 
	
	Если (ФормаЗаказа(УФ)) Тогда
		Если (УФ.ГрузоперевозкиИнициализированы) Тогда
			Возврат(_УФКС.СД("Журналы","сервер","/Обновить"));
		Иначе
			Возврат(Неопределено);
		КонецЕсли; 
	ИначеЕсли (ФормаГрузоперевозки(УФ)) Тогда 
		Возврат(_УФКС.СД("Грузоперевозки","клиент","/ФормаЗаписать"));
	Иначе
		Возврат(Неопределено);
	КонецЕсли; 
	
	// --- 
КонецФункции
 
&НаСервере
Функция ЗаполнитьПараметрыИзТипаПеревозки(УФ,Перезаполнить=Ложь)
	// --- 
	
	Если (Перезаполнить) Тогда
		
		УФ.Объект.ПараметрыГрузоперевозки.Загрузить(УФ.Объект.ТипПеревозки.ПараметрыГрузоперевозки.Выгрузить());
		
	Иначе
		
		// интеллектуальный алгоритм - добавляем только новые параметры
		Для каждого СтрокаПараметра Из УФ.Объект.ТипПеревозки.ПараметрыГрузоперевозки Цикл
			
			Параметр = СтрокаПараметра.Параметр;
			// --- 
			СтрокаПараметра = CW_Мониторинг.СтрокаПараметра(УФ.Объект,Параметр);
			Если (СтрокаПараметра = Неопределено) Тогда
				
				Нстр = УФ.Объект.ПараметрыГрузоперевозки.Добавить();
				Нстр.Параметр = Параметр;
				Нстр.Значение = Параметр.ТипЗначения.ПривестиЗначение(Неопределено); 
	
			КонецЕсли; 
			
		КонецЦикла; 
		
	КонецЕсли; 
	
	// --- 
КонецФункции

&НаСервере
Функция ЗаполнитьПредопределенныеПараметры(УФ)
	// --- 
	
	Если (УФ.Объект.Ссылка.Пустая()) Тогда
		
		МассивПроверяемыхРеквизитов = _сф.м_СоздатьИзСтроки("Клиент,Маршрут,ТипПеревозки,Груз,Типоразмер");
		Для каждого Реквизит Из МассивПроверяемыхРеквизитов Цикл
			Если (ЗначениеЗаполнено(УФ.Объект[Реквизит])) Тогда
				ПП = CW_Мониторинг.ПолучитьПредопределенныеПараметры(УФ.Объект[Реквизит],Реквизит);
				Если (_УФКС.ВыполненоУспешно(ПП)) Тогда
					CW_Мониторинг.ДобавитьПредопределенныеПараметры(УФ.Объект,ПП.Параметры);
				КонецЕсли; 
			КонецЕсли; 	
		КонецЦикла;
		
	КонецЕсли; 	
	
	// --- 
КонецФункции

&НаСервере
Функция ПроверитьНомерКонтейнера(УФ)
	// --- 
	
	Если УФ.Объект.ТипПеревозки.ВидПеревозки=Перечисления.CW_ВидыПеревозок.Контейнер И УФ.ПроверятьНомерКонтейнера Тогда
		
		УФ.ОшибкаНомераКонтейнера = (НЕ CW_Мониторинг.НомерКонтейнераКорректный(УФ.Объект.CW_Представление));
		
	Иначе
		
		УФ.ОшибкаНомераКонтейнера=Ложь;		
		
	КонецЕсли;
	
	// --- 
КонецФункции

&НаСервере
Функция УдалитьНетиповыеПараметры(УФ)
	// --- 
	
	// удаляем только те, на которые есть права редактирования (!!!)
	// добавляем все
	НаборПрав = УФ.ПраваНаПараметры[0].Значение;
	// --- 
	
	ПараметрыТипа = УФ.Объект.ТипПеревозки.ПараметрыГрузоперевозки;
	МассивПараметровДляУдаления = Новый Массив;
	Для каждого Стр Из УФ.Объект.ПараметрыГрузоперевозки Цикл
		
		Если _сф.к_НайтиСтроку(ПараметрыТипа,"Параметр",Стр.Параметр) = Неопределено Тогда
			
			СтруктураПрав = НаборПрав["п_"+_сф.КлючПоСсылке(Стр.Параметр)];
			
			Если СтруктураПрав.Редактирование Тогда
				
				МассивПараметровДляУдаления.Добавить(Стр);
				
			КонецЕсли;
			
		КонецЕсли; 
		
	КонецЦикла; 
	// --- 
	_сф.к_УдалитьЭлементыПоМассиву(УФ.Объект.ПараметрыГрузоперевозки,МассивПараметровДляУдаления);
	
	// теперь добавляем те параметры, которых не хватает
	Для каждого Стр Из ПараметрыТипа Цикл
		
		Если _сф.к_НайтиСтроку(УФ.Объект.ПараметрыГрузоперевозки,"Параметр",Стр.Параметр) = Неопределено Тогда
			
			Нстр = УФ.Объект.ПараметрыГрузоперевозки.Добавить();
			Нстр.Параметр = Стр.Параметр;
			
		КонецЕсли; 
		
	КонецЦикла; 
	
	ДеревоПараметровОбновить(УФ);
	
	Возврат(_УФКС.СД("Грузоперевозки","клиент","/ДеревоПараметровРазвернутьВсе"));
	
	// --- 
КонецФункции

&НаСервере
Функция ДеревоПараметровОбновить(УФ)
	// --- 
	
	Элементы=УФ.Элементы;
	Объект = УФ.Объект;
	// --- 
	
	СоответствиеСвойствПараметров = CW_Мониторинг.ПолучитьСоответствиеСвойствПараметров();
	
	// сохраняем
	УФ.ТребуетсяВосстановитьСостояниеСвертки=Истина;
	Если (Элементы.ДеревоПараметров.ТекущаяСтрока) <> Неопределено Тогда
		
		СтрокаДерева = УФ.ДеревоПараметров.НайтиПоИдентификатору(Элементы.ДеревоПараметров.ТекущаяСтрока);
		
		Если СтрокаДерева.ИндексКартинки = 0 Тогда
			
			ТекущаяГруппа = СтрокаДерева.Параметр;
			ТекущийПараметр = Неопределено;
			
		Иначе
			
			ТекущаяГруппа = СтрокаДерева.Параметр.Родитель;
			ТекущийПараметр = СтрокаДерева.Параметр;	 
			
		КонецЕсли; 
		
	Иначе
		
		ТекущаяГруппа = Неопределено;
		ТекущийПараметр = Неопределено;
		
	КонецЕсли; 
	
	// очищаем дерево
	УФ.ДеревоПараметров.ПолучитьЭлементы().Очистить();
	
	// получаем права на параметры
	УФ.ПраваНаПараметры.Очистить();
	УФ.ПраваНаПараметры.Добавить(CW_ПраваДоступа.НаборПравДляПараметров());
	НаборПрав = УФ.ПраваНаПараметры[0].Значение;
	// --- 
	
	ТЗ = _сф.т_Создать("Параметр,Значение,Родитель,ЗначениеПлан,ЗначениеФакт,Примечание");
	МассивДинамическихПараметров = Новый Массив;
	СоответствиеСвойствПараметров = CW_Мониторинг.ПолучитьСоответствиеСвойствПараметров();
	Для каждого Стр Из Объект.ПараметрыГрузоперевозки Цикл
		СП = СоответствиеСвойствПараметров.Получить(Стр.Параметр);
		Если (СП.ДинамическийПараметр) Тогда
			УФ.ЕстьДинамическиеПараметры = Истина;
			МассивДинамическихПараметров.Добавить(Стр.Параметр);
		КонецЕсли; 
	КонецЦикла; 
	Если (УФ.ЕстьДинамическиеПараметры) Тогда
		
		// пересчитываем и показываем
		ТаблицаДП = CW_Мониторинг.ДинамическиеПараметрыОбъекта(УФ.Объект,СоответствиеСвойствПараметров,МассивДинамическихПараметров,Объект.ПараметрыГрузоперевозки.Выгрузить());
		
	КонецЕсли; 
	// --- 
	Для каждого Стр Из Объект.ПараметрыГрузоперевозки Цикл
		
		СП = СоответствиеСвойствПараметров.Получить(Стр.Параметр);
		Если (СП.ДинамическийПараметр) Тогда
			
			// берем значения из таблицы динамических параметров
			Отбор = Новый Структура("Параметр",Стр.Параметр);
			СтрокаПараметра = _сф.к_НайтиСтроку(ТаблицаДП, Отбор);
			Если (СтрокаПараметра <> Неопределено) Тогда
				Стр.Значение = СтрокаПараметра.Значение;
			КонецЕсли; 
			
		КонецЕсли; 
		
		// проверяем на право просмотра
		СтруктураПрав = НаборПрав["п_"+_сф.КлючПоСсылке(Стр.Параметр)];
		Если (СтруктураПрав.Просмотр) Тогда
			
			Нстр = ТЗ.Добавить();
			Нстр.Параметр = Стр.Параметр;
			Нстр.Значение = Стр.Значение;
			Нстр.Примечание = Стр.Примечание;
			Нстр.ЗначениеПлан = Стр.ЗначениеПлан;
			Нстр.ЗначениеФакт = Стр.ЗначениеФакт;
			Нстр.Родитель = СП.Родитель;
			
		КонецЕсли; 
		
	КонецЦикла; 
	
	// --- 
	Родители = ТЗ.Скопировать(,"Родитель");
	МассивРодителей = Новый Массив;
	Для каждого Стр Из ТЗ Цикл
		
		_сф.м_ДобавитьУникально(МассивРодителей,Стр.Родитель);
		
	КонецЦикла; 
	
	// --- 
	Родители.Свернуть("Родитель");
	Родители.ЗагрузитьКолонку(МассивРодителей,"Родитель");
	
	ТДата = ТекущаяДата();
	
	// формируем дерево
	Для каждого Стр Из Родители Цикл
		
		Нстр = УФ.ДеревоПараметров.ПолучитьЭлементы().Добавить();
		Нстр.Параметр_Представление = ?(Строка(Стр.Родитель)="","<без группы>",Строка(Стр.Родитель));
		Нстр.Параметр = Стр.Родитель;
		Нстр.ЭтоГруппа = Истина;
		Нстр.ИндексКартинки=0;
		
		// выбираем параметры по родителю
		КоличествоПараметров = 0;
		ТЗП = ТЗ.Скопировать(Новый Структура("Родитель",Стр.Родитель));
		Для каждого СтрокаПараметра Из ТЗП Цикл
			
			Если ЗначениеЗаполнено(СтрокаПараметра.Параметр)  Тогда
				
				пстр = нстр.ПолучитьЭлементы().Добавить();
				ДеревоПараметровОбновитьСтрокуДереваПоСтрокеПараметра(УФ,СоответствиеСвойствПараметров,пстр,СтрокаПараметра);
				_сф.Инкремент(КоличествоПараметров);
				
			КонецЕсли; 
			
		КонецЦикла; 
		
		ДеревоПараметровОбновитьПредставлениеГруппы(УФ,Нстр);
		//Если (УФ.ПоказыватьКоличествоПараметров) Тогда
		//	Нстр.Параметр_Представление = ?(Строка(Стр.Родитель)="","<без группы>",Строка(Стр.Родитель))+" ("+Строка(КоличествоПараметров)+")";
		//Иначе
		//	Нстр.Параметр_Представление = ?(Строка(Стр.Родитель)="","<без группы>",Строка(Стр.Родитель));
		//КонецЕсли; 
		
	КонецЦикла;
	
	// пробуем восстановить текущую строку
	Если (ТекущаяГруппа <> Неопределено) Тогда
		
		Для каждого Стр Из УФ.ДеревоПараметров.ПолучитьЭлементы() Цикл
			
			Если Стр.Параметр = ТекущаяГруппа Тогда
				
				Если (ТекущийПараметр <> Неопределено) Тогда
					
					// пробуем найти в дочерних
					Для каждого СтрП Из Стр.ПолучитьЭлементы() Цикл
						
						Если (СтрП.Параметр = ТекущийПараметр) Тогда
							
							Элементы.ДеревоПараметров.ТекущаяСтрока = СтрП.ПолучитьИдентификатор();
							Возврат(Неопределено);
							
						КонецЕсли; 
						
					КонецЦикла; 
					
				Иначе
					
					Элементы.ДеревоПараметров.ТекущаяСтрока = Стр.ПолучитьИдентификатор();
					Возврат(Неопределено);
					
				КонецЕсли; 
				
			КонецЕсли; 
			
		КонецЦикла; 
		
	КонецЕсли; 
	
	// --- 
КонецФункции

&НаСервере
Функция ДеревоПараметровОбновитьПараметр(УФ,Параметры)
	// --- 
	
	СтруктураПараметра = _сф.ст_ПолучитьСвойство(Параметры,"СтруктураПараметра");
	СписокВедомых = _сф.ст_ПолучитьСвойство(Параметры,"СписокВедомых");
	
	Элементы=УФ.Элементы;
	Объект = УФ.Объект;
	// --- 
	
	СоответствиеСвойствПараметров = CW_Мониторинг.ПолучитьСоответствиеСвойствПараметров();
	
	// пробуем найти 
	ЭтоНовый = Ложь;
	СтрокаПараметра = _сф.к_НайтиСтроку(Объект.ПараметрыГрузоперевозки,_сф.ст_Отбор("Параметр",СтруктураПараметра.Параметр));
	Если СтрокаПараметра = Неопределено Тогда
		ЭтоНовый=Истина;
		СтрокаПараметра = Объект.ПараметрыГрузоперевозки.Добавить();
	КонецЕсли; 
	
	ЗаполнитьЗначенияСвойств(СтрокаПараметра,СтруктураПараметра);
	СП = СоответствиеСвойствПараметров.Получить(СтрокаПараметра.Параметр);
	Если СП.ЭтоКонтрольнаяДата Тогда
		СтрокаПараметра.Значение = ?(СтрокаПараметра.ЗначениеФакт <> Дата(1,1,1),СтрокаПараметра.ЗначениеФакт,СтрокаПараметра.ЗначениеПлан);
	КонецЕсли; 
	
	// отражаем изменения/ добавляем в дерево
	Если НЕ ЭтоНовый Тогда
		
		Для каждого СтрокаГруппы Из УФ.ДеревоПараметров.ПолучитьЭлементы() Цикл
			
			Если СтрокаГруппы.Параметр = СтрокаПараметра.Параметр.Родитель Тогда
				
				Для каждого СтрокаЭлемента Из СтрокаГруппы.ПолучитьЭлементы() Цикл
					
					Если СтрокаЭлемента.Параметр = СтрокаПараметра.Параметр Тогда
						
						ДеревоПараметровОбновитьСтрокуДереваПоСтрокеПараметра(УФ,СоответствиеСвойствПараметров,СтрокаЭлемента,СтрокаПараметра);
						// пересчитываем динамические параметры
						ПересчитатьДинамическиеПараметры(УФ,СтрокаПараметра.Параметр);
						Продолжить;
						
					КонецЕсли; 
					
				КонецЦикла; 
				Продолжить;
				
			КонецЕсли; 
			
		КонецЦикла; 
		
	Иначе
		
		// необходимо добавить группу/параметр
		// проверяем наличие группы
		СтрокаГруппыПараметра = Неопределено;
		Для каждого СтрокаГруппы Из УФ.ДеревоПараметров.ПолучитьЭлементы() Цикл
			
			Если СтрокаГруппы.Параметр = СтрокаПараметра.Параметр.Родитель Тогда
				
				СтрокаГруппыПараметра = СтрокаГруппы;
				Продолжить;
				
			КонецЕсли;
			
		КонецЦикла; 
		Если СтрокаГруппыПараметра = Неопределено Тогда
			
			// добавляем
			// определяем, куда добавлять
			Родители = Объект.ПараметрыГрузоперевозки.Выгрузить(,"Параметр");
			Родители.Колонки.Добавить("Родитель");
			Родители.Колонки.Добавить("Код");
			Для каждого Стр Из Родители Цикл
				
				Стр.Родитель = Стр.Параметр.Родитель;
				Стр.Код = Стр.Родитель.Код;
				
			КонецЦикла; 
			Родители.Свернуть("Родитель,Код");
			Родители.Сортировать("Код Возр");
			// --- 
			Родитель = СП.Родитель;
			Отбор = _сф.ст_Отбор("Родитель",Родитель);
			СтрокаТекущейГруппы = _сф.к_ПервыйЭлемент(Родители.НайтиСтроки(Отбор));
			ИндексГруппы = Родители.Индекс(СтрокаТекущейГруппы);
			// --- 
			СтрокаГруппыПараметра = УФ.ДеревоПараметров.ПолучитьЭлементы().Вставить(ИндексГруппы);
			
			СтрокаГруппыПараметра.Параметр_Представление = ?(Строка(Родитель)="","<без группы>",Строка(Родитель));
			СтрокаГруппыПараметра.Параметр = Родитель;
			СтрокаГруппыПараметра.ЭтоГруппа = Истина;
			СтрокаГруппыПараметра.ИндексКартинки=0;
			
		КонецЕсли; 
		
		// теперь добавляем к строке родителя строку параметра
		СтрокаДерева = СтрокаГруппыПараметра.ПолучитьЭлементы().Добавить();		
		ДеревоПараметровОбновитьСтрокуДереваПоСтрокеПараметра(УФ,СоответствиеСвойствПараметров,СтрокаДерева,СтрокаПараметра);
		Элементы.ДеревоПараметров.ТекущаяСтрока = СтрокаДерева.ПолучитьИдентификатор();
		// пересчитываем динамические параметры
		ПересчитатьДинамическиеПараметры(УФ,СтрокаПараметра.Параметр);
		
		//Если (УФ.ПоказыватьКоличествоПараметров) Тогда
			
		ДеревоПараметровОбновитьПредставлениеГруппы(УФ,СтрокаГруппыПараметра);
			
		//КонецЕсли;
		
	КонецЕсли; 
	
	Если (СписокВедомых <> Неопределено И СтруктураПараметра.ПараметрИзменен) Тогда
		
		Для каждого ВП Из СписокВедомых Цикл
			
			СтрокаПараметра = _сф.к_НайтиСтроку(Объект.ПараметрыГрузоперевозки,"Параметр",ВП.Значение);
			Если СтрокаПараметра <> Неопределено Тогда
				
				СтрокаПараметра.Значение = Неопределено;
				СтрокаПараметра.Примечание = "";
				
				// теперь находим в дереве и обновляем
				СтрокаЭлемента = НайтиПараметрВДереве(УФ,СтрокаПараметра.Параметр);
				ДеревоПараметровОбновитьСтрокуДереваПоСтрокеПараметра(УФ,СоответствиеСвойствПараметров,СтрокаЭлемента,СтрокаПараметра);
				// пересчитываем динамические параметры
				ПересчитатьДинамическиеПараметры(УФ,СтрокаПараметра.Параметр);
				
			КонецЕсли; 
			
		КонецЦикла; 
		
	КонецЕсли; 
	
	// --- 
КонецФункции

&НаСервере
Процедура ДеревоПараметровОбновитьСтрокуДереваПоСтрокеПараметра(УФ,СоответствиеСвойствПараметров,СтрокаДерева,СтрокаПараметра)
	
	ТДата = ТекущаяДата();
	СП = СоответствиеСвойствПараметров.Получить(СтрокаПараметра.Параметр);
	// --- 
	ЭтоКонтрольнаяДата = СП.ЭтоКонтрольнаяДата;
	ДинамическийПараметр = СП.ДинамическийПараметр;
	ТипПеревозки = УФ.Объект.ТипПеревозки;
	
	// --- 
	СтрокаДерева.Параметр = СтрокаПараметра.Параметр;
	СтрокаДерева.Параметр_Представление = СП.Наименование;
	СтрокаДерева.Значение = СтрокаПараметра.Значение;
	СтрокаДерева.Примечание = СтрокаПараметра.Примечание;
	// --- 
	
	// контроль заполнения
	СтрокаКонтроляЗаполненияПараметра = ТипПеревозки.ПараметрыГрузоперевозки.Найти(СтрокаПараметра.Параметр,"Параметр");
	Если (СтрокаКонтроляЗаполненияПараметра <> Неопределено) Тогда
		
		СтрокаДерева.КонтрольЗаполнения = СтрокаКонтроляЗаполненияПараметра.КонтрольЗаполнения;
		
	КонецЕсли; 
	ТекущееЗначениеКонтроляЗаполнения = СтрокаДерева.ЗначениеНезаполнено;
	Если (ЭтоКонтрольнаяДата) Тогда
		
		СтрокаДерева.ЗначениеНезаполнено = (СтрокаДерева.КонтрольЗаполнения И НЕ ЗначениеЗаполнено(СтрокаПараметра.ЗначениеФакт));
		
	Иначе
		
		СтрокаДерева.ЗначениеНезаполнено = (СтрокаДерева.КонтрольЗаполнения И НЕ ЗначениеЗаполнено(СтрокаПараметра.Значение));
		
	КонецЕсли; 
	Если (ТекущееЗначениеКонтроляЗаполнения <> СтрокаДерева.ЗначениеНезаполнено) Тогда
		
		ЗначениеНеЗаполнено = Ложь;
		// требуется проверить отметку контроля заполнения у родителя
		СтрокаРодителя = СтрокаДерева.ПолучитьРодителя();
		Для каждого Стр Из СтрокаРодителя.ПолучитьЭлементы() Цикл
			
			Если (Стр.КонтрольЗаполнения И Стр.ЗначениеНезаполнено) Тогда
				
				ЗначениеНеЗаполнено = Истина;
				Прервать;
				
			КонецЕсли; 
			
		КонецЦикла; 
		СтрокаРодителя.ЗначениеНезаполнено = ЗначениеНеЗаполнено;
		
	КонецЕсли; 
	
	// формат вывода 
	ТипЗначенияПараметра = СП.ТипЗначения;
	ТипПараметра = СП.ТипЗначения.Типы()[0];
	// --- 
	Если (ЭтоКонтрольнаяДата) Тогда
		
		Если СП.ФорматВывода <> "" Тогда
			СтрокаДерева.Значение_Представление = Формат(СтрокаДерева.Значение,СП.ФорматВывода);
		Иначе
			
			Если (НЕ СП.КонтрольнаяДатаИспользуетВремя) Тогда
				СтрокаДерева.Значение_Представление = Формат(СтрокаДерева.Значение,"ДФ=dd.MM.yyyy");
			Иначе
				СтрокаДерева.Значение_Представление = Формат(СтрокаДерева.Значение,"ДФ='dd.MM.yyyy HH:mm'");
			КонецЕсли; 
			
		КонецЕсли; 
		
	Иначе
		
		Если (ТипПараметра = Тип("Булево") ИЛИ ТипПараметра = Тип("Дата") ИЛИ ТипПараметра=Тип("Число")) Тогда
			
			Если (СП.ФорматВывода <> "") Тогда
				
				СтрокаДерева.Значение_Представление = Формат(СтрокаДерева.Значение,СП.ФорматВывода);
				
			Иначе
				
				СтрокаДерева.Значение_Представление = Формат(СтрокаДерева.Значение);
				
				Если ТипПараметра = Тип("Дата") Тогда
					
					ФорматВывода = "";
					ЧастьДаты = ТипЗначенияПараметра.КвалификаторыДаты.ЧастиДаты;
					Если ЧастьДаты = ЧастиДаты.Дата Тогда
						
						// формат дат по умолчанию
						ФорматВывода = "ДФ=dd.MM.yyyy";
						
					ИначеЕсли ЧастьДаты = ЧастиДаты.Время Тогда 
						
						// формат дат по умолчанию
						ФорматВывода = "ДФ=HH:mm:ss";
						
					ИначеЕсли ЧастьДаты = ЧастиДаты.ДатаВремя Тогда 
						
						// формат дат по умолчанию
						ФорматВывода = "ДЛФ=";
						
					КонецЕсли;
					
					СтрокаДерева.Значение_Представление = Формат(СтрокаДерева.Значение,ФорматВывода);
					
				КонецЕсли; 
				
			КонецЕсли;
			
		Иначе
			
			СтрокаДерева.Значение_Представление = Строка(СтрокаДерева.Значение);
			
		КонецЕсли; 					
		
	КонецЕсли; 
	
	// статус план/факт
	Если (ЭтоКонтрольнаяДата) Тогда
		
		Если СтрокаПараметра.ЗначениеФакт <> Дата(1,1,1) Тогда
			
			СтрокаДерева.ПланФакт=Истина;
			СтрокаДерева.ПланПросрочен=Ложь;
			
		Иначе
			
			СтрокаДерева.ПланФакт=Ложь;
			
			Если (СтрокаПараметра.ЗначениеПлан <> Дата(1,1,1)) И (СтрокаПараметра.ЗначениеПлан - НачалоДня(ТДата) <= СП.ЛимитПросрочкиКонтрольнойДаты * 60*60*24) Тогда
				СтрокаДерева.ПланПросрочен=Истина;
			Иначе	
				СтрокаДерева.ПланПросрочен=Ложь;
			КонецЕсли; 
			
		КонецЕсли; 
		
	КонецЕсли; 
	
	// картинка
	Если (ЭтоКонтрольнаяДата) Тогда
		СтрокаДерева.ИндексКартинки = 2;
	ИначеЕсли (ДинамическийПараметр) Тогда
		СтрокаДерева.ИндексКартинки = 3;
	Иначе
		СтрокаДерева.ИндексКартинки = 1;
	КонецЕсли;
	
	// --- 
КонецПроцедуры

&НаСервере
Функция ПересчитатьДинамическиеПараметры(УФ,ИзменившийсяПараметр=Неопределено)
	// --- 
	
	Если (УФ.ЕстьДинамическиеПараметры) Тогда
		
		// пересчитываем и показываем
		СоответствиеСвойствПараметров = CW_Мониторинг.ПолучитьСоответствиеСвойствПараметров();
		ТаблицаДП = CW_Мониторинг.ДинамическиеПараметрыОбъекта(УФ.Объект,СоответствиеСвойствПараметров,,УФ.Объект.ПараметрыГрузоперевозки.Выгрузить());
		Для каждого Стр Из ТаблицаДП Цикл
			
			// в ТЧ
			Отбор = Новый Структура("Параметр",Стр.Параметр);
			СтрокаПараметра = _сф.к_НайтиСтроку(УФ.Объект.ПараметрыГрузоперевозки,Отбор);
			Если (СтрокаПараметра <> Неопределено) Тогда
				СтрокаПараметра.Значение = Стр.Значение;
				
				// в дереве
				Для каждого СтрокаГруппы Из УФ.ДеревоПараметров.ПолучитьЭлементы() Цикл
					
					Если СтрокаГруппы.Параметр = СтрокаПараметра.Параметр.Родитель Тогда
						
						Для каждого СтрокаЭлемента Из СтрокаГруппы.ПолучитьЭлементы() Цикл
							
							Если СтрокаЭлемента.Параметр = СтрокаПараметра.Параметр Тогда
								
								ДеревоПараметровОбновитьСтрокуДереваПоСтрокеПараметра(УФ,СоответствиеСвойствПараметров,СтрокаЭлемента,СтрокаПараметра);
								Продолжить;
								
							КонецЕсли; 
							
						КонецЦикла; 
						Продолжить;
						
					КонецЕсли; 
					
				КонецЦикла; 
				
			КонецЕсли; 
			
		КонецЦикла; 
		
	КонецЕсли;
	
	// --- 
КонецФункции

&НаСервере
Функция НайтиПараметрВДереве(УФ,Параметр)
	// --- 
	
	Для каждого Группа Из УФ.ДеревоПараметров.ПолучитьЭлементы() Цикл
		
		Если Группа.Параметр = Параметр.Родитель Тогда
			
			Для каждого ЭлементГруппы Из Группа.ПолучитьЭлементы() Цикл
				
				Если ЭлементГруппы.Параметр = Параметр Тогда
					
					Возврат(ЭлементГруппы);
					
				КонецЕсли; 
				
			КонецЦикла; 
			
		КонецЕсли; 
		
	КонецЦикла; 
	
	// --- 
КонецФункции

&НаСервере
Функция ДеревоПараметровОбновитьПредставлениеГруппы(УФ,СтрокаГруппы)
	// --- 
	
	СтрокаГруппы.Параметр_Представление = ?(Строка(СтрокаГруппы.Параметр)="","<без группы>",Строка(СтрокаГруппы.Параметр))+" ("+Строка(СтрокаГруппы.ПолучитьЭлементы().Количество())+")";
	ЕстьНезаполненные = Ложь;
	ЕстьКонтроллируемые = Ложь;
	Элементы = СтрокаГруппы.ПолучитьЭлементы();
	Для каждого Элемент Из Элементы Цикл
		Если (Элемент.ЗначениеНезаполнено И Элемент.КонтрольЗаполнения) Тогда
			ЕстьНезаполненные = Истина;
			ЕстьКонтроллируемые = Истина;
			Прервать;
		КонецЕсли; 
	КонецЦикла; 
	СтрокаГруппы.ЗначениеНезаполнено = ЕстьНезаполненные;
	СтрокаГруппы.КонтрольЗаполнения = ЕстьКонтроллируемые;
	
	// --- 
КонецФункции

&НаСервере
Функция ДеревоПараметровУдалитьПараметр(УФ,Параметры)
	// --- 
	
	Параметр = _сф.ст_ПолучитьСвойство(Параметры,"Параметр");
	СписокВедомых = _сф.ст_ПолучитьСвойство(Параметры,"СписокВедомых");
	
	СтрокаПараметра = _сф.к_НайтиСтроку(УФ.Объект.ПараметрыГрузоперевозки,_сф.ст_Отбор("Параметр",Параметр));
	УдалитьПараметрИзДерева(УФ,СтрокаПараметра.Параметр);
	УФ.Объект.ПараметрыГрузоперевозки.Удалить(СтрокаПараметра);
	// --- 
	Если СписокВедомых <> Неопределено Тогда
		
		Для каждого ВП Из СписокВедомых Цикл
			
			СтрокаПараметра = _сф.к_НайтиСтроку(УФ.Объект.ПараметрыГрузоперевозки,"Параметр",ВП.Значение);
			Если СтрокаПараметра <> Неопределено Тогда
				
				УдалитьПараметрИзДерева(УФ,СтрокаПараметра.Параметр);
				УФ.Объект.ПараметрыГрузоперевозки.Удалить(СтрокаПараметра);
				
			КонецЕсли; 
			
		КонецЦикла;
		
	КонецЕсли; 
	
	// --- 
КонецФункции

&НаСервере
Функция УдалитьПараметрИзДерева(УФ,Параметр)
	// --- 
	
	// удаляем из дерева
	СтрокаЭлемента = НайтиПараметрВДереве(УФ,Параметр);
	СтрокаГруппы = СтрокаЭлемента.ПолучитьРодителя();
	
	ЭлементыГруппы = СтрокаГруппы.ПолучитьЭлементы();
	ЭлементыГруппы.Удалить(ЭлементыГруппы.Индекс(СтрокаЭлемента));
	
	// проверяем количество оставшихся
	Если (ЭлементыГруппы.Количество()=0) Тогда
		
		// удаляем
		ЭлементыДерева = УФ.ДеревоПараметров.ПолучитьЭлементы();
		ЭлементыДерева.Удалить(ЭлементыДерева.Индекс(СтрокаГруппы));
		
	Иначе
		
		ДеревоПараметровОбновитьПредставлениеГруппы(УФ,СтрокаГруппы);
		УФ.Элементы.ДеревоПараметров.ТекущаяСтрока = СтрокаГруппы.ПолучитьИдентификатор();
		
	КонецЕсли; 
	
	// --- 
КонецФункции

&НаСервере
Функция ЗаполнитьПредопределенныеЗначенияПараметровДляРеквизита(УФ,Параметры)
	// --- 
	
	
	Ответ = ПолучитьПредопределенныеПараметры(УФ,Параметры);
	Если (_УФКС.ВыполненоУспешно(Ответ)) Тогда
		//СохранитьСостояниеСвертки();
		СП = ПолучитьПредопределенныеПараметры(УФ,Параметры);
		Если (_УФКС.ВыполненоУспешно(СП)) Тогда
			Результат = ДобавитьПредопределенныеПараметры(УФ,СП.Параметры);
			Если (_УФКС.ВыполненоУспешно(Результат)) Тогда
				Возврат(_УФКС.СД("Грузоперевозки","сервер","/ДеревоПараметровОбновить"));
				//ВосстановитьСостояниеСвертки();
			КонецЕсли;
		КонецЕсли; 
		
	КонецЕсли; 
	
	// --- 
КонецФункции

&НаСервере
Функция ПолучитьПредопределенныеПараметры(УФ,Параметры)
	// --- 
	
	Возврат(CW_Мониторинг.ПолучитьПредопределенныеПараметры(Параметры.ЗначениеРеквизита,Параметры.ИмяРеквизита,УФ.УникальныйИдентификатор));
	
	// --- 
КонецФункции

&НаСервере
Функция ДобавитьПредопределенныеПараметры(УФ,АдресПараметров)
	// --- 
	
	Возврат(CW_Мониторинг.ДобавитьПредопределенныеПараметры(УФ.Объект,АдресПараметров));
	
