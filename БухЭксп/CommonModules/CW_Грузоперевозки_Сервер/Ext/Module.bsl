			|	CW_АктированиеВходящихСчетовОстатки.ВсегоОстаток КАК НеактированныйОстаток,
			|	ЕСТЬNULL(CW_СтатусыДокументовСрезПоследних.СтатусДокумента, НЕОПРЕДЕЛЕНО) КАК СтатусДокумента,
			|	CW_РасходыПоГрузоперевозкам.ДокументРасходов.ПлановоеНачисление КАК ПлановоеНачисление
			|ПОМЕСТИТЬ ВТ
			|ИЗ
			|	РегистрНакопления.CW_РасходыПоГрузоперевозкам КАК CW_РасходыПоГрузоперевозкам
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.CW_ОтсутствующиеОригиналыДокументов КАК CW_ОтсутствующиеОригиналыДокументов
			|		ПО CW_РасходыПоГрузоперевозкам.ДокументРасходов = CW_ОтсутствующиеОригиналыДокументов.Документ
			|			И CW_РасходыПоГрузоперевозкам.Контрагент = CW_ОтсутствующиеОригиналыДокументов.Контрагент
			|			И CW_РасходыПоГрузоперевозкам.Договор = CW_ОтсутствующиеОригиналыДокументов.Договор
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.CW_АктированиеВходящихСчетов.Остатки(
			|				&ТД,
			|				Грузоперевозка В
			|					(ВЫБРАТЬ
			|						Справочник.CW_Грузоперевозки.Ссылка
			|					ИЗ
			|						Справочник.CW_Грузоперевозки
			|					ГДЕ
			|						Справочник.CW_Грузоперевозки.Заказ = &Ссылка)) КАК CW_АктированиеВходящихСчетовОстатки
			|		ПО CW_РасходыПоГрузоперевозкам.ДокументРасходов = CW_АктированиеВходящихСчетовОстатки.Счет
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.CW_СтатусыДокументов.СрезПоследних КАК CW_СтатусыДокументовСрезПоследних
			|		ПО (CW_РасходыПоГрузоперевозкам.ДокументРасходов = (ВЫРАЗИТЬ(CW_СтатусыДокументовСрезПоследних.Документ КАК Документ.CW_РасходыПоГрузоперевозке)))
			|ГДЕ
			|	CW_РасходыПоГрузоперевозкам.Грузоперевозка В
			|			(ВЫБРАТЬ
			|				Справочник.CW_Грузоперевозки.Ссылка
			|			ИЗ
			|				Справочник.CW_Грузоперевозки
			|			ГДЕ
			|				Справочник.CW_Грузоперевозки.Заказ = &Ссылка)
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	CW_РасходыПоГрузоперевозкамПлан.Грузоперевозка,
			|	CW_РасходыПоГрузоперевозкамПлан.Контрагент,
			|	CW_РасходыПоГрузоперевозкамПлан.Договор,
			|	CW_РасходыПоГрузоперевозкамПлан.ДокументРасходов,
			|	CW_РасходыПоГрузоперевозкамПлан.ДокументРасходов.ПредставлениеДокумента,
			|	CW_РасходыПоГрузоперевозкамПлан.Номенклатура,
			|	CW_РасходыПоГрузоперевозкамПлан.Валюта,
			|	CW_РасходыПоГрузоперевозкамПлан.ЭтоСчет,
			|	CW_РасходыПоГрузоперевозкамПлан.Всего_Валюта,
			|	CW_РасходыПоГрузоперевозкамПлан.Всего,
			|	CW_РасходыПоГрузоперевозкамПлан.Сумма,
			|	CW_РасходыПоГрузоперевозкамПлан.НДС,
			|	CW_РасходыПоГрузоперевозкамПлан.ДокументРасходов.Дата,
			|	CW_РасходыПоГрузоперевозкамПлан.ДокументРасходов.Организация,
			|	NULL,
			|	0,
			|	CW_РасходыПоГрузоперевозкамПлан.ДокументРасходов.ПлановоеНачисление
			|ИЗ
			|	РегистрНакопления.CW_РасходыПоГрузоперевозкамПлан КАК CW_РасходыПоГрузоперевозкамПлан
			|ГДЕ
			|	CW_РасходыПоГрузоперевозкамПлан.Грузоперевозка В
			|			(ВЫБРАТЬ
			|				Справочник.CW_Грузоперевозки.Ссылка
			|			ИЗ
			|				Справочник.CW_Грузоперевозки
			|			ГДЕ
			|				Справочник.CW_Грузоперевозки.Заказ = &Ссылка)
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ВТ.Грузоперевозка,
			|	ВТ.Контрагент,
			|	ВТ.Договор,
			|	ВТ.Документ,
			|	ВТ.ПредставлениеДокумента,
			|	ВТ.Номенклатура,
			|	ВТ.Валюта,
			|	ВТ.ЭтоСчет,
			|	ВТ.ВсегоВал,
			|	ВТ.Всего,
			|	ВТ.Сумма,
			|	ВТ.НДС,
			|	ВТ.Дата,
			|	ВТ.Организация,
			|	ВТ.СтатусДокумента,
			|	ВЫБОР
			|		КОГДА ЕСТЬNULL(ВТ.ДокументБезОригиналов, ИСТИНА) = ИСТИНА
			|			ТОГДА ИСТИНА
			|		ИНАЧЕ ЛОЖЬ
			|	КОНЕЦ КАК ОригиналыПредоставлены,
			|	ВТ.НеактированныйОстаток,
			|	ВТ.ПлановоеНачисление
			|ИЗ
			|	ВТ КАК ВТ
			|
			|УПОРЯДОЧИТЬ ПО
			|	ВТ.Контрагент,
			|	ВТ.Договор,
			|	ВТ.Документ,
			|	ВТ.Номенклатура,
			|	ВТ.Валюта,
			|	ВТ.Грузоперевозка,
			|	ВТ.ЭтоСчет";
			Запрос.УстановитьПараметр("Ссылка", ?(ЗначениеЗаполнено(УФ.Объект.Ссылка), УФ.Объект.Ссылка, Неопределено));
			Запрос.УстановитьПараметр("ТД", ТекущаяДата()); 
			ТЗ = Запрос.Выполнить().Выгрузить();
			
		КонецЕсли; 
		
		// отредактировано CW (КС)..
		//--------------------------
		// анализируем, надо ли разворачивать постатейно
		Если (УФ.ФинансыРасходыОтображатьПостатейно) Тогда
			ТЗ.Свернуть("Контрагент,Организация,Документ,Дата,ПредставлениеДокумента,Валюта,Номенклатура,ЭтоСчет,ОригиналыПредоставлены,ПредставлениеДокумента,СтатусДокумента,ПлановоеНачисление","ВсегоВал,Всего,Сумма,НДС,НеактированныйОстаток");
		Иначе
			ТЗ.Свернуть("Контрагент,Организация,Документ,Дата,ПредставлениеДокумента,Валюта,ЭтоСчет,ОригиналыПредоставлены,ПредставлениеДокумента,СтатусДокумента,ПлановоеНачисление","ВсегоВал,Всего,Сумма,НДС,НеактированныйОстаток");
		КонецЕсли; 
		ТЗ.Сортировать("Дата Возр");
		УФ.Элементы.РасходыНоменклатура.Видимость = УФ.ФинансыРасходыОтображатьПостатейно;
		
		УФ.ФинансыРасходы.Загрузить(ТЗ);
		
		// количество документов
		ТЗД = ТЗ.Скопировать(,"Документ");
		ТЗД.Свернуть("Документ");
		КоличествоЗатратных = ТЗД.Количество();
		УФ.Элементы.ГруппаРасходы.Заголовок = "Расходы"+?(КоличествоЗатратных=0,""," ("+Строка(КоличествоЗатратных)+")");
		
		
	КонецЕсли; 
	
	// --- 
КонецФункции

&НаСервере
Процедура ФинансыТранспортОбновить(УФ)
	
	ЭтоФормаГрузоперевозки 	= ФормаГрузоперевозки(УФ);
	ЭтоФормаЗаказа			= ФормаЗаказа(УФ);
	
	Если ЭтоФормаГрузоперевозки ИЛИ ЭтоФормаЗаказа Тогда
		
		ИспользованиеБлокаСобственногоТранспорта 		= ПолучитьФункциональнуюОпцию("CW_ИспользованиеБлокаСобственногоТранспорта");
		
		УФ.Элементы.ГруппаФинансыТранспорт.Видимость 	= ИспользованиеБлокаСобственногоТранспорта;
		
		Если ЭтоФормаГрузоперевозки Тогда
			УсловиеОтбора = "Грузоперевозка = &ОбъектОтбора";
		КонецЕсли;
		Если ЭтоФормаЗаказа Тогда
			УсловиеОтбора = "Грузоперевозка.Заказ = &ОбъектОтбора";
		КонецЕсли;
		
		// формируем ТЗ затрат
		Если ИспользованиеБлокаСобственногоТранспорта Тогда
			
			Запрос = Новый Запрос;
			Запрос.Текст = "ВЫБРАТЬ
			               |	CW_РасходыПоГрузоперевозкамтранспортныхСредствОбороты.ПутевойЛист КАК ПутевойЛист,
			               |	CW_РасходыПоГрузоперевозкамтранспортныхСредствОбороты.ДокументРасходов КАК ДокументРасходов,
			               |	CW_РасходыПоГрузоперевозкамтранспортныхСредствОбороты.Номенклатура КАК Номенклатура,
			               |	CW_РасходыПоГрузоперевозкамтранспортныхСредствОбороты.СтатьяЗатрат КАК СтатьяЗатрат,
			               |	CW_РасходыПоГрузоперевозкамтранспортныхСредствОбороты.Валюта КАК Валюта,
			               |	НЕ CW_РасходыПоГрузоперевозкамтранспортныхСредствОбороты.ЭтоАкт КАК ЭтоСчет,
			               |	СУММА(CW_РасходыПоГрузоперевозкамтранспортныхСредствОбороты.ВсегоОборот) КАК Всего,
			               |	СУММА(CW_РасходыПоГрузоперевозкамтранспортныхСредствОбороты.СуммаОборот) КАК Сумма,
			               |	СУММА(CW_РасходыПоГрузоперевозкамтранспортныхСредствОбороты.НДСОборот) КАК НДС,
			               |	СУММА(CW_РасходыПоГрузоперевозкамтранспортныхСредствОбороты.Всего_ВалютаОборот) КАК ВсегоВал
			               |ИЗ
			               |	РегистрНакопления.CW_РасходыПоГрузоперевозкамТранспортныхСредств.Обороты(, , Период, "+УсловиеОтбора+") КАК CW_РасходыПоГрузоперевозкамтранспортныхСредствОбороты
			               |
			               |СГРУППИРОВАТЬ ПО
			               |	CW_РасходыПоГрузоперевозкамтранспортныхСредствОбороты.ДокументРасходов,
			               |	CW_РасходыПоГрузоперевозкамтранспортныхСредствОбороты.ПутевойЛист,
			               |	CW_РасходыПоГрузоперевозкамтранспортныхСредствОбороты.Номенклатура,
			               |	CW_РасходыПоГрузоперевозкамтранспортныхСредствОбороты.СтатьяЗатрат,
			               |	CW_РасходыПоГрузоперевозкамтранспортныхСредствОбороты.Валюта,
			               |	CW_РасходыПоГрузоперевозкамтранспортныхСредствОбороты.ЭтоАкт";
			
			Запрос.УстановитьПараметр("ОбъектОтбора", УФ.Объект.Ссылка);
			                                                                       
			РезультатЗапроса = Запрос.Выполнить();
			
			Если РезультатЗапроса.Пустой() Тогда
				
				УФ.Элементы.ГруппаФинансыТранспорт.Видимость = Ложь;
				Возврат;
				
			КонецЕсли;
			
			ТЗ = РезультатЗапроса.Выгрузить();
			
			// анализируем, надо ли разворачивать постатейно
			Если (УФ.ФинансыТранспортОтображатьПостатейно) Тогда
				ТЗ.Свернуть("ПутевойЛист,ДокументРасходов,Номенклатура,СтатьяЗатрат,Валюта,ЭтоСчет","Всего,Сумма,Сумма,НДС,ВсегоВал");
			Иначе
				ТЗ.Свернуть("ПутевойЛист,ДокументРасходов,СтатьяЗатрат,Валюта,ЭтоСчет","Всего,Сумма,Сумма,НДС,ВсегоВал");
			КонецЕсли; 
			ТЗ.Сортировать("ПутевойЛист Возр");
			
			УФ.Элементы.ФинансыТранспортНоменклатура.Видимость = УФ.ФинансыТранспортОтображатьПостатейно;
			
			УФ.ФинансыТранспорт.Загрузить(ТЗ);
			
			// количество документов
			ТЗД = ТЗ.Скопировать(,"ДокументРасходов");
			ТЗД.Свернуть("ДокументРасходов");
			КоличествоЗатратных = ТЗД.Количество();
			УФ.Элементы.ГруппаФинансыТранспорт.Заголовок = "Транспорт "+?(КоличествоЗатратных=0,""," ("+Строка(КоличествоЗатратных)+")");
			
		КонецЕсли; 		
		
	КонецЕсли; 
	
КонецПроцедуры

&НаСервере
Функция ФинансыДоходыОбновить(УФ)
	
	Если (ФормаГрузоперевозки(УФ)) Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		               |	CW_ДоходыПоГрузоперевозкам.Грузоперевозка КАК Грузоперевозка,
		               |	CW_ДоходыПоГрузоперевозкам.Контрагент КАК Контрагент,
		               |	CW_ДоходыПоГрузоперевозкам.Договор КАК Договор,
		               |	CW_ДоходыПоГрузоперевозкам.ДокументДоходов КАК Документ,
		               |	CW_ДоходыПоГрузоперевозкам.ДокументДоходов.ПредставлениеДокумента КАК ПредставлениеДокумента,
		               |	CW_ДоходыПоГрузоперевозкам.Номенклатура КАК Номенклатура,
		               |	CW_ДоходыПоГрузоперевозкам.Валюта КАК Валюта,
		               |	НЕ CW_ДоходыПоГрузоперевозкам.ЭтоАкт КАК ЭтоСчет,
		               |	CW_ДоходыПоГрузоперевозкам.Всего_Валюта КАК ВсегоВал,
		               |	CW_ДоходыПоГрузоперевозкам.Всего КАК Всего,
		               |	CW_ДоходыПоГрузоперевозкам.Сумма КАК Сумма,
		               |	CW_ДоходыПоГрузоперевозкам.НДС КАК НДС,
		               |	CW_ДоходыПоГрузоперевозкам.ДокументДоходов.Дата КАК Дата,
		               |	CW_ДоходыПоГрузоперевозкам.ДокументДоходов.Организация КАК Организация,
		               |	CW_ОтсутствующиеОригиналыДокументов.Документ КАК ДокументБезОригиналов,
		               |	CW_АктированиеИсходящихСчетовОстатки.ВсегоОстаток КАК НеактированныйОстаток,
		               |	ЕСТЬNULL(CW_НаличиеФайловАрхиваПоОбъектам.Признак, ЛОЖЬ) КАК Файлы,
		               |	ЕСТЬNULL(CW_СтатусыДокументовСрезПоследних.СтатусДокумента, НЕОПРЕДЕЛЕНО) КАК СтатусДокумента
		               |ПОМЕСТИТЬ ВТ
		               |ИЗ
		               |	РегистрНакопления.CW_ДоходыПоГрузоперевозкам КАК CW_ДоходыПоГрузоперевозкам
		               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.CW_ОтсутствующиеОригиналыДокументов КАК CW_ОтсутствующиеОригиналыДокументов
		               |		ПО CW_ДоходыПоГрузоперевозкам.ДокументДоходов = CW_ОтсутствующиеОригиналыДокументов.Документ
		               |			И CW_ДоходыПоГрузоперевозкам.Контрагент = CW_ОтсутствующиеОригиналыДокументов.Контрагент
		               |			И CW_ДоходыПоГрузоперевозкам.Договор = CW_ОтсутствующиеОригиналыДокументов.Договор
		               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.CW_АктированиеИсходящихСчетов.Остатки(&ТД, Грузоперевозка = &Грузоперевозка) КАК CW_АктированиеИсходящихСчетовОстатки
		               |		ПО CW_ДоходыПоГрузоперевозкам.ДокументДоходов = CW_АктированиеИсходящихСчетовОстатки.Счет
		               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.CW_НаличиеФайловАрхиваПоОбъектам КАК CW_НаличиеФайловАрхиваПоОбъектам
		               |		ПО CW_ДоходыПоГрузоперевозкам.ДокументДоходов = CW_НаличиеФайловАрхиваПоОбъектам.Объект
		               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.CW_СтатусыДокументов.СрезПоследних КАК CW_СтатусыДокументовСрезПоследних
		               |		ПО (CW_ДоходыПоГрузоперевозкам.ДокументДоходов = (ВЫРАЗИТЬ(CW_СтатусыДокументовСрезПоследних.Документ КАК Документ.CW_ДоходыПоГрузоперевозке)))
		               |ГДЕ
		               |	CW_ДоходыПоГрузоперевозкам.Грузоперевозка = &Грузоперевозка
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ
		               |	ВТ.Грузоперевозка КАК Грузоперевозка,
		               |	ВТ.Контрагент КАК Контрагент,
		               |	ВТ.Договор КАК Договор,
		               |	ВТ.Документ КАК Документ,
		               |	ВТ.ПредставлениеДокумента КАК ПредставлениеДокумента,
		               |	ВТ.Номенклатура КАК Номенклатура,
		               |	ВТ.Валюта КАК Валюта,
		               |	ВТ.ЭтоСчет КАК ЭтоСчет,
		               |	ВТ.ВсегоВал КАК ВсегоВал,
		               |	ВТ.Всего КАК Всего,
		               |	ВТ.Сумма КАК Сумма,
		               |	ВТ.НДС КАК НДС,
		               |	ВТ.Дата КАК Дата,
		               |	ВТ.Организация КАК Организация,
		               |	ВЫБОР
		               |		КОГДА ЕСТЬNULL(ВТ.ДокументБезОригиналов, ИСТИНА) = ИСТИНА
		               |			ТОГДА ИСТИНА
		               |		ИНАЧЕ ЛОЖЬ
		               |	КОНЕЦ КАК ОригиналыПредоставлены,
		               |	ВТ.НеактированныйОстаток КАК НеактированныйОстаток,
		               |	ВТ.Файлы КАК Файлы,
		               |	ВТ.СтатусДокумента КАК СтатусДокумента
		               |ИЗ
		               |	ВТ КАК ВТ
		               |
		               |УПОРЯДОЧИТЬ ПО
		               |	ВТ.Контрагент,
		               |	ВТ.Договор,
		               |	ВТ.Документ,
		               |	ВТ.Номенклатура,
		               |	ВТ.Валюта,
		               |	ВТ.Грузоперевозка,
		               |	ВТ.ЭтоСчет";
		Запрос.УстановитьПараметр("Грузоперевозка", УФ.Объект.Ссылка);
		Запрос.УстановитьПараметр("ТД", ТекущаяДата());
		ТЗ = Запрос.Выполнить().Выгрузить();
		
	Иначе
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		               |	CW_ДоходыПоГрузоперевозкам.Грузоперевозка КАК Грузоперевозка,
		               |	CW_ДоходыПоГрузоперевозкам.Контрагент КАК Контрагент,
		               |	CW_ДоходыПоГрузоперевозкам.Договор КАК Договор,
		               |	CW_ДоходыПоГрузоперевозкам.ДокументДоходов КАК Документ,
		               |	CW_ДоходыПоГрузоперевозкам.ДокументДоходов.ПредставлениеДокумента КАК ПредставлениеДокумента,
		               |	CW_ДоходыПоГрузоперевозкам.Номенклатура КАК Номенклатура,
		               |	CW_ДоходыПоГрузоперевозкам.Валюта КАК Валюта,
		               |	НЕ CW_ДоходыПоГрузоперевозкам.ЭтоАкт КАК ЭтоСчет,
		               |	CW_ДоходыПоГрузоперевозкам.Всего_Валюта КАК ВсегоВал,
		               |	CW_ДоходыПоГрузоперевозкам.Всего КАК Всего,
		               |	CW_ДоходыПоГрузоперевозкам.Сумма КАК Сумма,
		               |	CW_ДоходыПоГрузоперевозкам.НДС КАК НДС,
		               |	CW_ДоходыПоГрузоперевозкам.ДокументДоходов.Дата КАК Дата,
		               |	CW_ДоходыПоГрузоперевозкам.ДокументДоходов.Организация КАК Организация,
		               |	CW_ОтсутствующиеОригиналыДокументов.Документ КАК ДокументБезОригиналов,
		               |	CW_АктированиеИсходящихСчетовОстатки.ВсегоОстаток КАК НеактированныйОстаток,
		               |	ЕСТЬNULL(CW_НаличиеФайловАрхиваПоОбъектам.Признак, ЛОЖЬ) КАК Файлы,
		               |	ЕСТЬNULL(CW_СтатусыДокументовСрезПоследних.СтатусДокумента, НЕОПРЕДЕЛЕНО) КАК СтатусДокумента
		               |ПОМЕСТИТЬ ВТ
		               |ИЗ
		               |	РегистрНакопления.CW_ДоходыПоГрузоперевозкам КАК CW_ДоходыПоГрузоперевозкам
		               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.CW_ОтсутствующиеОригиналыДокументов КАК CW_ОтсутствующиеОригиналыДокументов
		               |		ПО CW_ДоходыПоГрузоперевозкам.ДокументДоходов = CW_ОтсутствующиеОригиналыДокументов.Документ
		               |			И CW_ДоходыПоГрузоперевозкам.Контрагент = CW_ОтсутствующиеОригиналыДокументов.Контрагент
		               |			И CW_ДоходыПоГрузоперевозкам.Договор = CW_ОтсутствующиеОригиналыДокументов.Договор
		               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.CW_АктированиеИсходящихСчетов.Остатки(
		               |				&ТД,
		               |				Грузоперевозка В
		               |					(ВЫБРАТЬ
		               |						Справочник.CW_Грузоперевозки.Ссылка
		               |					ИЗ
		               |						Справочник.CW_Грузоперевозки
		               |					ГДЕ
		               |						Справочник.CW_Грузоперевозки.Заказ = &Ссылка)) КАК CW_АктированиеИсходящихСчетовОстатки
		               |		ПО CW_ДоходыПоГрузоперевозкам.ДокументДоходов = CW_АктированиеИсходящихСчетовОстатки.Счет
		               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.CW_НаличиеФайловАрхиваПоОбъектам КАК CW_НаличиеФайловАрхиваПоОбъектам
		               |		ПО CW_ДоходыПоГрузоперевозкам.ДокументДоходов = CW_НаличиеФайловАрхиваПоОбъектам.Объект
		               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.CW_СтатусыДокументов.СрезПоследних КАК CW_СтатусыДокументовСрезПоследних
		               |		ПО (CW_ДоходыПоГрузоперевозкам.ДокументДоходов = (ВЫРАЗИТЬ(CW_СтатусыДокументовСрезПоследних.Документ КАК Документ.CW_ДоходыПоГрузоперевозке)))
		               |ГДЕ
		               |	CW_ДоходыПоГрузоперевозкам.Грузоперевозка В
		               |			(ВЫБРАТЬ
		               |				Справочник.CW_Грузоперевозки.Ссылка
		               |			ИЗ
		               |				Справочник.CW_Грузоперевозки
		               |			ГДЕ
		               |				Справочник.CW_Грузоперевозки.Заказ = &Ссылка)
		               |	И CW_ДоходыПоГрузоперевозкам.Регистратор.ПометкаУдаления = ЛОЖЬ
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ
		               |	ВТ.Грузоперевозка КАК Грузоперевозка,
		               |	ВТ.Контрагент КАК Контрагент,
		               |	ВТ.Договор КАК Договор,
		               |	ВТ.Документ КАК Документ,
		               |	ВТ.ПредставлениеДокумента КАК ПредставлениеДокумента,
		               |	ВТ.Номенклатура КАК Номенклатура,
		               |	ВТ.Валюта КАК Валюта,
		               |	ВТ.ЭтоСчет КАК ЭтоСчет,
		               |	ВТ.ВсегоВал КАК ВсегоВал,
		               |	ВТ.Всего КАК Всего,
		               |	ВТ.Сумма КАК Сумма,
		               |	ВТ.НДС КАК НДС,
		               |	ВТ.Дата КАК Дата,
		               |	ВТ.Организация КАК Организация,
		               |	ВЫБОР
		               |		КОГДА ЕСТЬNULL(ВТ.ДокументБезОригиналов, ИСТИНА) = ИСТИНА
		               |			ТОГДА ИСТИНА
		               |		ИНАЧЕ ЛОЖЬ
		               |	КОНЕЦ КАК ОригиналыПредоставлены,
		               |	ВТ.НеактированныйОстаток КАК НеактированныйОстаток,
		               |	ВТ.Файлы КАК Файлы,
		               |	ВТ.СтатусДокумента КАК СтатусДокумента
		               |ИЗ
		               |	ВТ КАК ВТ
		               |
		               |УПОРЯДОЧИТЬ ПО
		               |	ВТ.Контрагент,
		               |	ВТ.Договор,
		               |	ВТ.Документ,
		               |	ВТ.Номенклатура,
		               |	ВТ.Валюта,
		               |	ВТ.Грузоперевозка,
		               |	ВТ.ЭтоСчет";
		Запрос.УстановитьПараметр("Ссылка", ?(ЗначениеЗаполнено(УФ.Объект.Ссылка), УФ.Объект.Ссылка, Неопределено));
		Запрос.УстановитьПараметр("ТД", ТекущаяДата());
		ТЗ = Запрос.Выполнить().Выгрузить();
		
	КонецЕсли; 
	
	// анализируем, надо ли разворачивать постатейно
	Если (УФ.ФинансыДоходыОтображатьПостатейно) Тогда
		ТЗ.Свернуть("Контрагент,Организация,Документ,Дата,ПредставлениеДокумента,Валюта,Номенклатура,ЭтоСчет,ОригиналыПредоставлены,ПредставлениеДокумента,Файлы,СтатусДокумента","ВсегоВал,Всего,Сумма,НДС,НеактированныйОстаток");
	Иначе
		ТЗ.Свернуть("Контрагент,Организация,Документ,Дата,ПредставлениеДокумента,Валюта,ЭтоСчет,ОригиналыПредоставлены,ПредставлениеДокумента,Файлы,СтатусДокумента","ВсегоВал,Всего,Сумма,НДС,НеактированныйОстаток");
	КонецЕсли; 
	ТЗ.Сортировать("Дата Возр");
	УФ.Элементы.ДоходыНоменклатура.Видимость = УФ.ФинансыДоходыОтображатьПостатейно;
	
	УФ.ФинансыДоходы.Загрузить(ТЗ);
	
	// количество документов
	ТЗД = ТЗ.Скопировать(,"Документ");
	ТЗД.Свернуть("Документ");
	КоличествоДоходных = ТЗД.Количество();
	УФ.Элементы.ГруппаДоходы.Заголовок = "Доходы"+?(КоличествоДоходных=0,""," ("+Строка(КоличествоДоходных)+")");
	
