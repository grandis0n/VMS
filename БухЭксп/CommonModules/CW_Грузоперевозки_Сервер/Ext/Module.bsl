&НаСервере
Функция ФинансыУдалить(УФ,Параметры)
	
	Попытка
		Объект = Параметры.ПолучитьОбъект();
		Объект.УстановитьПометкуУдаления(НЕ Объект.ПометкаУдаления);
	Исключение
	    //ОписаниеОшибки()
	КонецПопытки; 
	
	ФинансыОбновить(УФ,Истина, Истина,Ложь);
	
