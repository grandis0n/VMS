Функция ПолучитьСведенияПоГрузоперевозкам(МассивГрузоперевозок) Экспорт
	
	Запрос = новый Запрос;
	запрос.Текст = "ВЫБРАТЬ
	               |	CW_Грузоперевозки.Ссылка КАК Ссылка,
	               |	CW_Грузоперевозки.ПометкаУдаления КАК ПометкаУдаления,
	               |	ВЫБОР
	               |		КОГДА CW_Грузоперевозки.Заказ = ЗНАЧЕНИЕ(Справочник.CW_Заказы.ПустаяСсылка)
	               |			ТОГДА ВЫБОР
	               |					КОГДА CW_ЗакрытиеФинансов.ДатаЗакрытия ЕСТЬ NULL
	               |						ТОГДА ЛОЖЬ
	               |					ИНАЧЕ ИСТИНА
	               |				КОНЕЦ
	               |		ИНАЧЕ ВЫБОР
	               |				КОГДА CW_ЗакрытиеФинансовЗаказ.ДатаЗакрытия ЕСТЬ NULL
	               |					ТОГДА ЛОЖЬ
	               |				ИНАЧЕ ИСТИНА
	               |			КОНЕЦ
	               |	КОНЕЦ КАК Заблокирована,
	               |	ЕСТЬNULL(CW_ЗначенияФинансовыхСтатусовОбъектов.ФинансовыйСтатус.СсылкаКартинки, """") КАК КартинкаФинансовыйСтатус
	               |ИЗ
	               |	Справочник.CW_Грузоперевозки КАК CW_Грузоперевозки
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.CW_ЗакрытиеФинансов КАК CW_ЗакрытиеФинансов
	               |		ПО CW_Грузоперевозки.Ссылка = CW_ЗакрытиеФинансов.Аналитика
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.CW_ЗакрытиеФинансов КАК CW_ЗакрытиеФинансовЗаказ
	               |		ПО CW_Грузоперевозки.Заказ = CW_ЗакрытиеФинансовЗаказ.Аналитика
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.CW_ЗначенияФинансовыхСтатусовОбъектов КАК CW_ЗначенияФинансовыхСтатусовОбъектов
	               |		ПО CW_Грузоперевозки.Ссылка = CW_ЗначенияФинансовыхСтатусовОбъектов.ОбъектСтатуса
	               |ГДЕ
	               |	CW_Грузоперевозки.Ссылка В(&МассивГрузоперевозок)";
	
	Запрос.УстановитьПараметр("МассивГрузоперевозок", МассивГрузоперевозок);
	
	РезультатЗапроса = Запрос.Выполнить();

	Выборка = РезультатЗапроса.Выбрать();
	
	СвойстваГрузоперевозок = Новый Соответствие;
	
	Пока Выборка.Следующий() Цикл
		
		СтруктураСвойств = новый Структура("ПометкаУдаления, Заблокирована, КартинкаФинансовыйСтатус", Выборка.ПометкаУдаления, Выборка.Заблокирована, Выборка.КартинкаФинансовыйСтатус);
		
		СвойстваГрузоперевозок.Вставить(Выборка.Ссылка, СтруктураСвойств);
		
	КонецЦикла;
	
	Возврат СвойстваГрузоперевозок;
	
КонецФункции

Функция ПолучитьСтруктуруИтоговДинамическогоСписка(форма, ИмяТаблицы) Экспорт
	
	ЭлементФормы 	= форма.Элементы[ИмяТаблицы];  
	ИмяКолонки 		= ЭлементФормы.ТекущийЭлемент.Имя;  
	ТаблицаФормы 	= форма[ИмяТаблицы];   
	
	Если ИмяТаблицы = "ОтчетЭкспедитора" Тогда 
		//Динамический список   
		
		мДоступныеКолонки = новый Массив; 
		мДоступныеКолонки.Добавить("Сумма");
		мДоступныеКолонки.Добавить("СуммаНДС");
		мДоступныеКолонки.Добавить("Всего");
		
		ИмяКолонки 	= СтрЗаменить(ЭлементФормы.ТекущийЭлемент.Имя, "ОтчетЭкспедитора", "");  
		
		Если мДоступныеКолонки.Найти(ИмяКолонки) = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли; 
		
	КонецЕсли;	
	
	Если ТипЗнч(ТаблицаФормы) = Тип("ДинамическийСписок") Тогда
		ДанныеИтогов = CW_БухгалтерияЭкспедитораСерверПереопределяемый.ИтогиДинамическогоСписка(Форма.ОтчетЭкспедитора, ИмяКолонки);
		СуммаЗначений = ДанныеИтогов[ИмяКолонки];   
	КонецЕсли;
	
	Если ТипЗнч(СуммаЗначений) <> Тип("Число") Тогда
		Возврат Неопределено;
	КонецЕсли;   
	
	СтркутраПараметров = Новый Структура;
	СтркутраПараметров.Вставить("КоличествоЗначений", 	ЭлементФормы.ВыделенныеСтроки.Количество());
	СтркутраПараметров.Вставить("СуммаЗначений", 		СуммаЗначений);
	
	СтркутраПараметров.Вставить("МаксимальноеЗначениеПоказать",	Ложь);
	СтркутраПараметров.Вставить("МинимальноеЗначениеПоказать", 	Ложь);
	СтркутраПараметров.Вставить("СреднееЗначениеПоказать", 		Ложь);
	
	Возврат СтркутраПараметров

КонецФункции
