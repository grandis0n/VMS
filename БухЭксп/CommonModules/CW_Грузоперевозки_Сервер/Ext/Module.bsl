КонецФункции

&НаСервере
Функция ЗафиксироватьНачальныйПорядокПараметров(УФ)
	// --- 
	
	// фиксируем порядок элементов
	УФ.НачальныйПорядокПараметров.Очистить();
	Для каждого Стр Из УФ.ДеревоПараметров.ПолучитьЭлементы() Цикл
		
		Для каждого СтрП Из Стр.ПолучитьЭлементы() Цикл
			
			УФ.НачальныйПорядокПараметров.Добавить(СтрП.Параметр);
			
		КонецЦикла; 
		
	КонецЦикла;
	
	// --- 
КонецФункции

&НаСервере
Функция ЗафиксироватьКонечныйПорядокПараметров(УФ)
	// --- 
	
	// фиксируем порядок элементов
	УФ.КонечныйПорядокПараметров.Очистить();
	Для каждого Стр Из УФ.ДеревоПараметров.ПолучитьЭлементы() Цикл
		
		Для каждого СтрП Из Стр.ПолучитьЭлементы() Цикл
			
			УФ.КонечныйПорядокПараметров.Добавить(СтрП.Параметр);
			
		КонецЦикла; 
		
	КонецЦикла;
	
	// --- 
КонецФункции

&НаСервере
Функция ПроверитьПорядокПараметров(УФ)
	// --- 
	
	Попытка
		
		Объект = УФ.Объект;
		
		ТребуетсяПерезаполнение = Ложь;
		
		// создаём копию ТЧ параметров
		ТПараметров = Объект.ПараметрыГрузоперевозки.Выгрузить();
		ТПараметров.Колонки.Добавить("Индекс");
		Индекс = 0;
		Для каждого Стр Из ТПараметров Цикл
			
			_сф.Инкремент(Индекс);
			// --- 
			Стр.Индекс = Индекс;
			
		КонецЦикла; 
		
		// сопоставляем начальный слепок с конечным
		ТСопоставления = _сф.т_Создать("Параметр,НВИ,КВИ,ИТЧ,ПН,ПУ");
		Индекс = 0;
		Для каждого Стр Из УФ.НачальныйПорядокПараметров Цикл
			
			_сф.Инкремент(Индекс);
			// --- 
			Нстр = ТСопоставления.Добавить();
			Нстр.Параметр = Стр.Значение;
			Нстр.НВИ = Индекс;
			Нстр.КВИ = 0;
			Нстр.ПН = Ложь;
			Нстр.ПУ = Ложь;
			Нстр.ИТЧ = 0;
			
		КонецЦикла; 
		Индекс = 0;
		Для каждого Стр Из УФ.КонечныйПорядокПараметров Цикл
			
			_сф.Инкремент(Индекс);
			// --- 
			
			// пробуем спозиционироваться на строку
			СтрокаПараметра = _сф.к_НайтиСтроку(ТСопоставления,_сф.ст_Отбор("Параметр",Стр.Значение));
			Если СтрокаПараметра = Неопределено Тогда
				
				// добавляем как новую
				Нстр = ТСопоставления.Добавить();
				Нстр.Параметр = Стр.Значение;
				Нстр.НВИ = 0;
				Нстр.КВИ = Индекс;
				Нстр.ПН = Истина;
				Нстр.ПУ = Ложь;
				Нстр.ИТЧ = 0;
				
			Иначе
				
				СтрокаПараметра.КВИ = Индекс;
				
			КонецЕсли; 
			
		КонецЦикла; 
		// помечаем удаленные (КВИ=0)
		Для каждого Стр Из ТСопоставления Цикл
			
			Если Стр.КВИ = 0 Тогда
				
				Стр.ПУ = Истина;
				
			КонецЕсли; 
			
		КонецЦикла; 
		_сф.к_УдалитьЭлементыПоОтбору(ТСопоставления,_сф.ст_Отбор("ПУ",Истина));
		// --- 
		ТСопоставления.Сортировать("НВИ Возр");
		// делаем нумерацию новых, новые идут в конце
		ИндексНовых = _сф.Количество(ТСопоставления.Скопировать(_сф.ст_Отбор("ПН",Ложь)))+1;
		Для каждого Стр Из ТСопоставления Цикл
			
			Если Стр.ПН Тогда
				
				Стр.НВИ = ИндексНовых;
				ИндексНовых = ИндексНовых +1;
				
			КонецЕсли; 
			
		КонецЦикла; 
		// --- 
		Для каждого Стр Из ТСопоставления Цикл
			
			Если Стр.НВИ <> Стр.КВИ Тогда
				
				ТребуетсяПерезаполнение = Истина;
				// --- 
				
				// ищем НВИ = тек КВИ
				СтрокаНВИ = _сф.к_НайтиСтроку(ТСопоставления,_сф.ст_Отбор("НВИ",Стр.КВИ));
				// индекс ТЧ для Параметра
				ИТЧ = ТПараметров.Индекс(_сф.к_НайтиСтроку(ТПараметров,_сф.ст_Отбор("Параметр",СтрокаНВИ.Параметр)))+1;
				// устанавливаем
				_сф.к_НайтиСтроку(ТПараметров,_сф.ст_Отбор("Параметр",Стр.Параметр)).Индекс = ИТЧ;
				
			КонецЕсли; 
			
		КонецЦикла; 
		
		ТПараметров.Сортировать("Индекс Возр");
		
		// ---------------------------------------------------------------------------- 
		
		Если ТребуетсяПерезаполнение Тогда
			
			Объект.ПараметрыГрузоперевозки.Загрузить(ТПараметров);
			
		КонецЕсли; 
		
	Исключение
		//ОписаниеОшибки()
	КонецПопытки; 
	
КонецФункции

#Область Бюджет 

&НаСервере
Функция БюджетИнициализация(УФ)
	// --- 
	
	ИспользованиеБюджетов = ПолучитьФункциональнуюОпцию("CW_ИспользованиеБюджетирования");
	// --- 
	УФ.Элементы.СтраницаБюджет.Видимость = ИспользованиеБюджетов;
	УФ.Элементы.Форма_ФинансыРасходыДобавитьПоБюджету.Видимость = ИспользованиеБюджетов;
	УФ.Элементы.Форма_ФинансыДоходыДобавитьПоБюджету.Видимость = ИспользованиеБюджетов;
	
	Если (ИспользованиеБюджетов) Тогда 
		
		УФ.Перечисления_CW_ВидыСтатейПланирования_Расходы = Перечисления.CW_ВидыСтатейПланирования.Расходы;
		УФ.Перечисления_CW_ВидыСтатейПланирования_Доходы = Перечисления.CW_ВидыСтатейПланирования.Доходы;
		
	КонецЕсли;
	
	// ---------------------------------------------------------------------------- 
	Возврат(Неопределено);
	
	// --- 
КонецФункции

&НаСервере
Функция ОбновитьТаблицуБюджетов(УФ)
	// --- 
	
	Если (УФ.Объект.Ссылка.Пустая()) Тогда
		Возврат(Неопределено);
	КонецЕсли; 
	
	Если (ТипЗнч(УФ.Объект.Ссылка)=Тип("СправочникСсылка.CW_ВариантыБюджетовПоЗаявкам")) Тогда
		
		Если (ЗначениеЗаполнено(УФ.Объект.ВариантБюджета)) Тогда
			ОбъектВКоторомУтверждаетсяБюджет = УФ.Объект.ВариантБюджета;
		Иначе
			Возврат(Неопределено);
		КонецЕсли; 
		
	Иначе
		
		Если (ФормаГрузоперевозки(УФ)) Тогда
			Если ЗначениеЗаполнено(УФ.Объект.Заказ) Тогда 
				ОбъектВКоторомУтверждаетсяБюджет = УФ.Объект.Заказ;
			Иначе 
				ОбъектВКоторомУтверждаетсяБюджет = УФ.Объект.Ссылка;
			КонецЕсли;
		Иначе
			ОбъектВКоторомУтверждаетсяБюджет = УФ.Объект.Ссылка;
		КонецЕсли; 
		
	КонецЕсли; 
	
	тз = CW_Бюджетирование._ПолучитьТаблицуИспользованияВерсийБюджета(ОбъектВКоторомУтверждаетсяБюджет);
	Если (НЕ ЗначениеЗаполнено(УФ.БюджетТекущаяВерсия)) Тогда
		
		Если тз.Количество()>0 Тогда 
			УФ.БюджетТекущаяВерсия = тз[0].ВерсияБюджета;
			УФ.БюджетУтвержден     = тз[0].ЭтоУтвержденнаяВерсия;
		КонецЕсли;
		
	КонецЕсли; 
	
	УФ.БюджетВерсии.Загрузить(тз);
	
	// --- 
КонецФункции
 
&НаСервере
Функция БюджетОбновить(УФ,Расходы,Доходы)
	// --- 
	БлокироватьОбъекты 	= CW_АрхивОбъектовСервер.БлокироватьОбъектыПриПереводеВАрхив(); 
	Архив	= УФ.Объект.Архив и БлокироватьОбъекты;
	
	Элементы = УФ.Элементы;
	Объект = УФ.Объект;
	// --- 
	
	Если (УФ.БюджетТекущаяВерсия.Пустая()) Тогда
		ОбновитьТаблицуБюджетов(УФ);
	КонецЕсли; 
	
	Если (ФормаГрузоперевозки(УФ)) Тогда
		Ответ = CW_Бюджетирование._ПолучитьТаблицыБюджета_ПоГрузоперевозке(Объект.Ссылка, Объект.Заказ, УФ.БюджетТекущаяВерсия, Неопределено, Расходы, Доходы);
	ИначеЕсли (ФормаЗаявки(УФ)) Тогда 
		Ответ = CW_Бюджетирование._ПолучитьТаблицыБюджета_ПоГрузоперевозке(Объект.Ссылка, Неопределено, УФ.БюджетТекущаяВерсия, Объект.ВариантБюджета, Расходы, Доходы);
	ИначеЕсли (ФормаЗаказа(УФ)) Тогда 
		Ответ = CW_Бюджетирование._ПолучитьТаблицыБюджета_ПоЗаказу(Объект.Ссылка, УФ.БюджетТекущаяВерсия,Расходы, Доходы);
	КонецЕсли; 
	
	Если (Расходы) Тогда 
		УФ.БюджетРасходы.Загрузить(Ответ.тзЗатраты);
		Если (ФормаЗаказа(УФ)) Тогда 
			БюджетРасходыДерево = УФ.РеквизитФормыВЗначение("БюджетРасходыДерево");
			БюджетРасходыДерево.Строки.Очистить();
			ЗаполнитьДеревоЗначений(Ответ.ВыборкаЗатраты, БюджетРасходыДерево);
			УФ.ЗначениеВРеквизитФормы(БюджетРасходыДерево, "БюджетРасходыДерево");
		КонецЕсли;
	КонецЕсли;
	
	Если (Доходы) Тогда 
		УФ.БюджетДоходы.Загрузить(Ответ.тзДоходы);
		Если (ФормаЗаказа(УФ)) Тогда 
			БюджетДоходыДерево = УФ.РеквизитФормыВЗначение("БюджетДоходыДерево");
			БюджетДоходыДерево.Строки.Очистить();
			ЗаполнитьДеревоЗначений( Ответ.ВыборкаДоходы, БюджетДоходыДерево);
			УФ.ЗначениеВРеквизитФормы(БюджетДоходыДерево, "БюджетДоходыДерево");
		КонецЕсли;
	КонецЕсли;
	
	УФ.БюджетУтвержден = Ответ.БюджетУтвержден;
	
	// добавим в список выбора, если там ещё нет текущей версии
	Если (УФ.БюджетДоходы.Количество() <> 0 ИЛИ УФ.БюджетРасходы.Количество() <> 0) Тогда 
		
		строкаТЗ = _сф.к_НайтиСтроку(УФ.БюджетВерсии, "ВерсияБюджета", УФ.БюджетТекущаяВерсия);
		Если (строкаТЗ = Неопределено) Тогда 
			строкаТЗ = УФ.БюджетВерсии.Добавить();
		КонецЕсли;
		строкаТЗ.ЭтоУтвержденнаяВерсия = УФ.БюджетУтвержден;
		
	КонецЕсли;
	
	// ---------------------------------------------------------------------------- 
	
	// обновление итогов
	БюджетОбновитьИтоги(УФ,Расходы,Доходы);
	
	// управление доступностью
	Если (УФ.БюджетУтвержден) Тогда 
		
		// если бюджет утверждён, не даём его изменять
		Элементы.БюджетДоходы.ИзменятьСоставСтрок 	= Ложь;
		Элементы.БюджетРасходы.ИзменятьСоставСтрок 	= Ложь;
		
		Элементы.БюджетРасходыФорма_БюджетЗаполнитьДоходыПоРасходам.Доступность 		= Не Архив;
		Элементы.БюджетДоходыФорма_БюджетЗаполнитьРасходыПоДоходам.Доступность 			= Не Архив;
		
		Элементы.БюджетДоходыФорма_БюджетДоходыПересчитатьПоКурсу.Доступность 		= Не Архив;
		Элементы.БюджетРасходыФорма_БюджетРасходыПересчитатьПоКурсу.Доступность 	= Не Архив;

		
		Если (ФормаЗаказа(УФ)) Тогда 
			Элементы.БюджетДоходыДерево.ИзменятьСоставСтрок 	= Ложь;
			Элементы.БюджетРасходыДерево.ИзменятьСоставСтрок 	= Ложь;
			
			Элементы.Форма_БюджетЗаполнитьДоходыПоРасходамДерево.Доступность 					= Не Архив;
			Элементы.БюджетДоходыДеревоФорма_БюджетЗаполнитьРасходыПоДоходамДерево.Доступность  = Не Архив;
			
			Элементы.БюджетДоходыФорма_БюджетДоходыДеревоПересчитатьПоКурсу.Доступность 	= Не Архив;
			Элементы.БюджетРасходыФорма_БюджетРасходыДеревоПересчитатьПоКурсу.Доступность   = Не Архив;
			
		КонецЕсли;
		
		Элементы.СтатусУтверждения.Заголовок = _ПолучитьТексЗаголовкаСтатусаУтвержденияБюджета(УФ);	
		
	Иначе 
		
		// если бюджет не утверждён, изменять его можно
		Элементы.БюджетДоходы.ИзменятьСоставСтрок = Истина;
		Элементы.БюджетРасходы.ИзменятьСоставСтрок = Истина; 
		
		Элементы.БюджетРасходыФорма_БюджетЗаполнитьДоходыПоРасходам.Доступность 		= Не Архив;
		Элементы.БюджетДоходыФорма_БюджетЗаполнитьРасходыПоДоходам.Доступность 			= Не Архив;
		
		Элементы.БюджетДоходыФорма_БюджетДоходыПересчитатьПоКурсу.Доступность 		= Не Архив;
		Элементы.БюджетРасходыФорма_БюджетРасходыПересчитатьПоКурсу.Доступность 	= Не Архив;
	
		Если (ФормаЗаказа(УФ)) Тогда
			Элементы.БюджетДоходыДерево.ИзменятьСоставСтрок 	= Истина;
			Элементы.БюджетРасходыДерево.ИзменятьСоставСтрок 	= Истина;
			
			Элементы.Форма_БюджетЗаполнитьДоходыПоРасходамДерево.Доступность 					= Не Архив;
			Элементы.БюджетДоходыДеревоФорма_БюджетЗаполнитьРасходыПоДоходамДерево.Доступность  = Не Архив;
			
			Элементы.БюджетДоходыФорма_БюджетДоходыДеревоПересчитатьПоКурсу.Доступность 	= Не Архив;
			Элементы.БюджетРасходыФорма_БюджетРасходыДеревоПересчитатьПоКурсу.Доступность   = Не Архив;
		КонецЕсли;
		
		Элементы.СтатусУтверждения.Заголовок = "Не утвержден";	
	
	КонецЕсли;
	
	// --- 
КонецФункции

&НаСервере
процедура ЗаполнитьДеревоЗначений(Источник, Приемник)
	
	Пока Источник.Следующий() Цикл //Грузоперевозки
		
		СтрокаДерева 				= Приемник.Строки.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаДерева, Источник);
		СтрокаДерева.Контрагент 	= Источник.грузоперевозка;
		СтрокаДерева.Пиктограмма 	= 0;
		
		Детали = Источник.Выбрать();
		
		Пока Детали.Следующий() Цикл  //Детали
			
			СтрокаДетали = СтрокаДерева.Строки.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаДетали, Детали);
			СтрокаДетали.Пиктограмма 	= 3;
			
		КонецЦикла; //Детали
		
	КонецЦикла;//Грузоперевозки
	
КонецПроцедуры

&НаСервере
Функция _ПолучитьТексЗаголовкаСтатусаУтвержденияБюджета(УФ) Экспорт
	
	Объект = УФ.Объект;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	CW_ИсторияУтверждениеБюджетовСрезПоследних.Период КАК Дата,
	               |	CW_ИсторияУтверждениеБюджетовСрезПоследних.Пользователь КАК Пользователь
	               |ИЗ
	               |	РегистрСведений.CW_ИсторияУтверждениеБюджетов.СрезПоследних(
	               |			,
	               |			Объект = &Объект
	               |				И ВерсияБюджета = &ВерсияБюджета
	               |				И ПризнакУтверждения = ИСТИНА) КАК CW_ИсторияУтверждениеБюджетовСрезПоследних
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Дата УБЫВ
	               |АВТОУПОРЯДОЧИВАНИЕ";  
	
	Если ФормаЗаявки(УФ) Тогда
		Запрос.УстановитьПараметр("ВерсияБюджета", Объект.ВариантБюджета);
	Иначе
		Запрос.УстановитьПараметр("ВерсияБюджета", УФ.БюджетТекущаяВерсия);
	КонецЕсли;
	
	Если ФормаГрузоперевозки(УФ) Тогда
		Если Объект.Заказ.Пустая() Тогда
			Запрос.УстановитьПараметр("Объект", Объект.Ссылка);
		Иначе
			Запрос.УстановитьПараметр("Объект", Объект.Заказ);
		КонецЕсли; 
	Иначе
		Запрос.УстановитьПараметр("Объект", Объект.Ссылка);
	КонецЕсли;
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат "Утвержден "+Формат(Выборка.Дата,"ДФ=dd.MM.yyyy")+" ("+Строка(Выборка.Пользователь)+")";
	КонецЕсли;
	
	Возврат "Утвержден";
		
КонецФункции

&НаСервере
Функция БюджетОбновитьИтоги(УФ,флОбновлятьЗатраты=Истина, флОбновлятьДоходы=Истина)
	
	// обновление итогов
	ФорматВывода = "ЧЦ=15; ЧДЦ=2; ЧН=";
	// --- 
	ИсключатьВнутриХолдинговые = CW_Настройки.ПолучитьНастройкуПользователя(,"ИсключатьВнутрихолдинговыеВзаиморасчеты"); 
	Если (ИсключатьВнутриХолдинговые = Неопределено) Тогда
		ИсключатьВнутриХолдинговые = Ложь;		                                           
	КонецЕсли; 
	// --- 
	ВыводитьРезультатВБазовойВалюте = Истина;
	ВыводитьРасходыВБазовойВалюте = Истина;
	ВыводитьДоходыВБазовойВалюте = Истина;
	
	Если (УФ.ВыводитьРезультатВВалютеДокументов) Тогда
		
		// проверяем, что все документы в одной валюте
		ОбщаяВалюта = ПредопределенноеЗначение("Справочник.Валюты.ПустаяСсылка");;
		ВалютыРасходов = УФ.БюджетРасходы.Выгрузить(,"Валюта");
		ВалютыРасходов.Свернуть("Валюта"); 
		ВалютыДоходов = УФ.БюджетДоходы.Выгрузить(,"Валюта");
		ВалютыДоходов.Свернуть("Валюта");
		
		Если (ВалютыРасходов.Количество()=1) Тогда
			ВалютаРасходов = ВалютыРасходов[0].Валюта;
			ВыводитьРасходыВБазовойВалюте = Ложь;
		Иначе
			ВалютаРасходов = ПредопределенноеЗначение("Справочник.Валюты.ПустаяСсылка");;
		КонецЕсли; 
		
		Если (ВалютыДоходов.Количество()=1) Тогда
			ВалютаДоходов = ВалютыДоходов[0].Валюта;
			ВыводитьДоходыВБазовойВалюте = Ложь;
		Иначе
			ВалютаДоходов = ПредопределенноеЗначение("Справочник.Валюты.ПустаяСсылка");;
		КонецЕсли; 
		
		Если (ВалютаРасходов = ВалютаДоходов И НЕ ВалютаРасходов.Пустая()) Тогда
			ВыводитьРезультатВБазовойВалюте=Ложь;
			ОбщаяВалюта = ВалютаРасходов;
		ИначеЕсли (ВалютаРасходов.Пустая() И НЕ ВалютаДоходов.Пустая() И ВалютыРасходов.Количество()=0) Тогда 
			ВыводитьРезультатВБазовойВалюте=Ложь;
			ОбщаяВалюта = ВалютаДоходов;
		ИначеЕсли (НЕ ВалютаРасходов.Пустая() И ВалютаДоходов.Пустая() И ВалютыДоходов.Количество()=0) Тогда 
			ВыводитьРезультатВБазовойВалюте=Ложь;
			ОбщаяВалюта = ВалютаРасходов;
		КонецЕсли; 
		
	КонецЕсли;
	
	Если (флОбновлятьЗатраты) Тогда 
		
		Если (ВыводитьРасходыВБазовойВалюте) Тогда
			УФ.Элементы.БюджетРасходыИтого.Заголовок = 
			"Расходы: "+Формат(УФ.БюджетРасходы.Итог("СуммаВсегоРуб"),ФорматВывода)+" "+Строка(УФ.ВРУ)
			+", расходы без НДС: "+Формат(УФ.БюджетРасходы.Итог("СуммаРуб"),ФорматВывода)+" "+Строка(УФ.ВРУ);
		Иначе
			УФ.Элементы.БюджетРасходыИтого.Заголовок = 
			"Расходы: "+Формат(УФ.БюджетРасходы.Итог("СуммаВсего"),ФорматВывода)+" "+Строка(ВалютаРасходов)
			+", расходы без НДС: "+Формат(УФ.БюджетРасходы.Итог("Сумма"),ФорматВывода)+" "+Строка(ВалютаРасходов);
		КонецЕсли; 
		
		Если ФормаЗаказа(УФ) Тогда
			Если УФ.ВариантГруппировкиБюджетаРасходыДерево Тогда
				ЭлементыДерева = УФ.БюджетРасходыДерево.ПолучитьЭлементы();
				УФ.Элементы.ГруппаБюджетЗатраты.Заголовок = "Расходы ("+ЭлементыДерева.Количество()+")";
			Иначе
				УФ.Элементы.ГруппаБюджетЗатраты.Заголовок = "Расходы ("+УФ.БюджетРасходы.Количество()+")";
			КонецЕсли;
		Иначе
			УФ.Элементы.ГруппаБюджетЗатраты.Заголовок = "Расходы ("+УФ.БюджетРасходы.Количество()+")";
		КонецЕсли;
		
	КонецЕсли;
	
	Если (флОбновлятьДоходы) Тогда 
		
		Если (ВыводитьДоходыВБазовойВалюте) Тогда
			УФ.Элементы.БюджетДоходыИтого.Заголовок = 
			"Доходы: "+Формат(УФ.БюджетДоходы.Итог("СуммаВсегоРуб"),ФорматВывода)+" "+Строка(УФ.ВРУ)
			+", доходы без НДС: "+Формат(УФ.БюджетДоходы.Итог("СуммаРуб"),ФорматВывода)+" "+Строка(УФ.ВРУ);
		Иначе
			УФ.Элементы.БюджетДоходыИтого.Заголовок = 
			"Доходы: "+Формат(УФ.БюджетДоходы.Итог("СуммаВсего"),ФорматВывода)+" "+Строка(ВалютаДоходов)
			+", доходы без НДС: "+Формат(УФ.БюджетДоходы.Итог("Сумма"),ФорматВывода)+" "+Строка(ВалютаДоходов);
		КонецЕсли; 
		
		Если ФормаЗаказа(УФ) Тогда
			Если УФ.ВариантГруппировкиБюджетаДоходыДерево  Тогда
				ЭлементыДерева = УФ.БюджетДоходыДерево.ПолучитьЭлементы();
				УФ.Элементы.ГруппаБюджетДоходы.Заголовок = "Доходы ("+ЭлементыДерева.Количество()+")";
			Иначе
				УФ.Элементы.ГруппаБюджетДоходы.Заголовок = "Доходы ("+УФ.БюджетДоходы.Количество()+")";
			КонецЕсли;
		Иначе
			УФ.Элементы.ГруппаБюджетДоходы.Заголовок = "Доходы ("+УФ.БюджетДоходы.Количество()+")";
		КонецЕсли;
		
	КонецЕсли;
	
	Если (ВыводитьРезультатВБазовойВалюте) Тогда
			УФ.Элементы.БюджетФинансовыйРезультатИтого.Заголовок = 
			"Прибыль: "+Формат(УФ.БюджетДоходы.Итог("СуммаВсегоРуб") - УФ.БюджетРасходы.Итог("СуммаВсегоРуб"),ФорматВывода)+" "+Строка(УФ.ВРУ)
			+", прибыль без НДС: "+Формат(УФ.БюджетДоходы.Итог("СуммаРуб") - УФ.БюджетРасходы.Итог("СуммаРуб"),ФорматВывода)+" "+Строка(УФ.ВРУ);
		Иначе
			УФ.Элементы.БюджетФинансовыйРезультатИтого.Заголовок = 
			"Прибыль: "+Формат(УФ.БюджетДоходы.Итог("СуммаВсего") - УФ.БюджетРасходы.Итог("СуммаВсего"),ФорматВывода)+" "+Строка(ОбщаяВалюта)
			+", прибыль без НДС: "+Формат(УФ.БюджетДоходы.Итог("Сумма") - УФ.БюджетРасходы.Итог("Сумма"),ФорматВывода)+" "+Строка(ОбщаяВалюта);
			
		КонецЕсли;
		
	// ---------------------------------------------------------------------------- 
		
	Если (ИсключатьВнутриХолдинговые) Тогда
		
		КонтрагентыХолдинга = CW_Финансы.ПолучитьКонтрагентовХолдинга(); 
		
		ТЗ_Расходы = УФ.БюджетРасходы.Выгрузить();
		МассивУдаляемых = Новый Массив;
		Для каждого Стр Из ТЗ_Расходы Цикл
			
			Если (КонтрагентыХолдинга.Найти(Стр.Контрагент) <> Неопределено) Тогда
				МассивУдаляемых.Добавить(Стр);
			КонецЕсли; 
			
		КонецЦикла; 
		_сф.к_УдалитьЭлементыПоМассиву(ТЗ_Расходы,МассивУдаляемых);
		// --- 
		ТЗ_Доходы = УФ.БюджетДоходы.Выгрузить();
		МассивУдаляемых = Новый Массив;
		Для каждого Стр Из ТЗ_Доходы Цикл
			
			Если (КонтрагентыХолдинга.Найти(Стр.Контрагент) <> Неопределено) Тогда
				МассивУдаляемых.Добавить(Стр);
			КонецЕсли; 
			
		КонецЦикла; 
		_сф.к_УдалитьЭлементыПоМассиву(ТЗ_Доходы,МассивУдаляемых);
		
		// --- 
		
		Если (ВыводитьРасходыВБазовойВалюте) Тогда
			УФ.Элементы.БюджетРасходыИтого.Заголовок = 
			"Расходы: "+Формат(ТЗ_Расходы.Итог("СуммаВсегоРуб"),ФорматВывода)+" "+Строка(УФ.ВРУ)
			+", расходы без НДС: "+Формат(ТЗ_Расходы.Итог("СуммаРуб"),ФорматВывода)+" "+Строка(УФ.ВРУ);
		Иначе
			УФ.Элементы.БюджетРасходыИтого.Заголовок = 
			"Расходы: "+Формат(ТЗ_Расходы.Итог("СуммаВсего"),ФорматВывода)+" "+Строка(ВалютаРасходов)
			+", расходы без НДС: "+Формат(ТЗ_Расходы.Итог("Сумма"),ФорматВывода)+" "+Строка(ВалютаРасходов);
		КонецЕсли; 
		
		// --- 
		
		Если (ВыводитьДоходыВБазовойВалюте) Тогда
			УФ.Элементы.БюджетДоходыИтого.Заголовок = 
			"Доходы: "+Формат(ТЗ_Доходы.Итог("СуммаВсегоРуб"),ФорматВывода)+" "+Строка(УФ.ВРУ)
			+", доходы без НДС: "+Формат(ТЗ_Доходы.Итог("СуммаРуб"),ФорматВывода)+" "+Строка(УФ.ВРУ);
		Иначе
			УФ.Элементы.БюджетДоходыИтого.Заголовок = 
			"Доходы: "+Формат(ТЗ_Доходы.Итог("СуммаВсего"),ФорматВывода)+" "+Строка(ВалютаДоходов)
			+", доходы без НДС: "+Формат(ТЗ_Доходы.Итог("Сумма"),ФорматВывода)+" "+Строка(ВалютаДоходов);
		КонецЕсли; 
		
		// --- 
		
		Если (ВыводитьРезультатВБазовойВалюте) Тогда
			УФ.Элементы.БюджетФинансовыйРезультатИтого.Заголовок = 
			"Прибыль: "+Формат(ТЗ_Доходы.Итог("СуммаВсегоРуб") - ТЗ_Расходы.Итог("СуммаВсегоРуб"),ФорматВывода)+" "+Строка(УФ.ВРУ)
			+", прибыль без НДС: "+Формат(ТЗ_Доходы.Итог("СуммаРуб") - ТЗ_Расходы.Итог("СуммаРуб"),ФорматВывода)+" "+Строка(УФ.ВРУ);
		Иначе
			УФ.Элементы.БюджетФинансовыйРезультатИтого.Заголовок = 
			"Прибыль: "+Формат(ТЗ_Доходы.Итог("СуммаВсего") - ТЗ_Расходы.Итог("СуммаВсего"),ФорматВывода)+" "+Строка(ОбщаяВалюта)
			+", прибыль без НДС: "+Формат(ТЗ_Доходы.Итог("Сумма") - ТЗ_Расходы.Итог("Сумма"),ФорматВывода)+" "+Строка(ОбщаяВалюта);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецФункции

&НаСервере
Функция БюджетУдалить(УФ,Параметры)
	// --- 
	
	Если (ФормаГрузоперевозки(УФ) ИЛИ ФормаЗаявки(УФ)) Тогда
		
		СтатьяСсылка = Параметры;
		
		ЭтоРасходы = (СтатьяСсылка.ВидСтатьиПланирования = Перечисления.CW_ВидыСтатейПланирования.Расходы);
		ЭтоДоходы = (СтатьяСсылка.ВидСтатьиПланирования = Перечисления.CW_ВидыСтатейПланирования.Доходы);
		
		Попытка
			УстановитьПривилегированныйРежим(Истина);
			об = СтатьяСсылка.ПолучитьОбъект();
			об.Удалить();
		Исключение
			Возврат(_УФКС.СД("Грузоперевозки","клиент","/Предупреждение","Ошибка удаления: "+ОписаниеОшибки()));
		КонецПопытки; 
		
	Иначе
		
		Отбор = Параметры;
		// --- 
		
		ЭтоРасходы = (Отбор.ВидСтатьиПланирования = Перечисления.CW_ВидыСтатейПланирования.Расходы);
		ЭтоДоходы = (Отбор.ВидСтатьиПланирования = Перечисления.CW_ВидыСтатейПланирования.Доходы);
		
		Попытка
			
			УстановитьПривилегированныйРежим(Истина);
			НачатьТранзакцию();       
			тз=CW_Бюджетирование._ПолучитьТаблицуБюджетаДляРедактированияИзЗаказа(Отбор,?(Отбор.Свойство("Грузоперевозка"), Отбор.Грузоперевозка,Неопределено));
			Для Каждого строкаТЗ Из тз Цикл 
				об = строкаТЗ.СтатьяСсылка.ПолучитьОбъект();
				об.Удалить();
			КонецЦикла;
			ЗафиксироватьТранзакцию();
			
		Исключение
			Возврат(_УФКС.СД("Грузоперевозки","клиент","/Предупреждение","Ошибка удаления: "+ОписаниеОшибки()));
		КонецПопытки; 
		
	КонецЕсли; 
	
	БюджетОбновить(УФ,ЭтоРасходы,ЭтоДоходы);
	
	// --- 
КонецФункции

&НаСервере
Функция БюджетКонтрагентыПолучить(УФ)
	// --- 
	
	Возврат(_УФКС.СД("Грузоперевозки","клиент","/БюджетКонтрагенты",УФ.Объект.КонтрагентыПоБюджету.Выгрузить().ВыгрузитьКолонку("Контрагент")));
	
	// --- 
КонецФункции

&НаСервере
Функция БюджетКонтрагентыУстановить(УФ,Параметры)
	// --- 
	
	УФ.Объект.КонтрагентыПоБюджету.Очистить();
	// --- 
	Для каждого Стр Из Параметры Цикл
		
		Нстр = УФ.Объект.КонтрагентыПоБюджету.Добавить();
		Нстр.Контрагент = Стр;
		
	КонецЦикла; 
	УФ.Элементы.Форма_БюджетКонтрагенты.Заголовок = "Контрагенты"+?(УФ.Объект.КонтрагентыПоБюджету.Количество()=0,""," ("+Строка(УФ.Объект.КонтрагентыПоБюджету.Количество())+")");
	
	Возврат(_УФКС.СД("Грузоперевозки","клиент","/ФормаЗаписать"));
	
	// --- 
КонецФункции

&НаСервере
Функция БюджетЗаполнитьОбработкиЗаполнения(УФ)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	CW_ПодключаемыеОбъекты.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.CW_ПодключаемыеОбъекты КАК CW_ПодключаемыеОбъекты
	               |ГДЕ
	               |	CW_ПодключаемыеОбъекты.ТипВнешнегоОбъекта = Значение(Перечисление.CW_ТипыПодключаемыхОбъектов.ВнешняяОбработка)
	               |	И CW_ПодключаемыеОбъекты.Вид = &Вид
	               |	И CW_ПодключаемыеОбъекты.ПометкаУдаления = ЛОЖЬ
	               |	И CW_ПодключаемыеОбъекты.НеИспользуется = ЛОЖЬ";
	Запрос.УстановитьПараметр("Тип", "Обработка");
	Запрос.УстановитьПараметр("Вид", "ЗаполнениеБюджета");

	МассивОбработок = Новый Массив;
	
	ТЗ = Запрос.Выполнить().Выгрузить();
	Для каждого Стр Из ТЗ Цикл
		
		СО = Новый Структура("Обработка,Интерактив",Стр.Ссылка,Ложь);
		Отбор = Новый Структура("ТипФормы","ФормаНастроекЗаполнения");
		СтрокаФормы = _сф.к_НайтиСтроку(Стр.Ссылка.ФормыОбъекта,Отбор);
		Если (СтрокаФормы <> Неопределено) Тогда
			
			СО.Интерактив = Истина;
			
		КонецЕсли; 
		МассивОбработок.Добавить(СО);
		
	КонецЦикла; 
	Если (МассивОбработок.Количество()=0) Тогда
		
		Возврат(_УФКС.СД("Грузоперевозки","клиент","/Предупреждение","Обработок заполнения не обнаружено"));
	Иначе
		Ответ = _УФКС.Ответ();
		Ответ.Вставить("Обработки",МассивОбработок);
		Возврат(_УФКС.СД("Грузоперевозки","клиент","/Предупреждение",Ответ));
		Возврат(Ответ);
	КонецЕсли; 
	
КонецФункции

&НаСервере 
Функция БюджетЗаполнитьДоходыПоРасходам(УФ,Параметры) Экспорт
	
	Если (УФ.БюджетУтвержден) Тогда
		Возврат(Неопределено);
	КонецЕсли; 
	
	// Параметры - массив
	МассивСтатей = Новый Массив;
	Если (ФормаГрузоперевозки(УФ) ИЛИ ФормаЗаявки(УФ)) или Параметры.РежимДерево Тогда
		
		Для каждого Статья Из Параметры.МассивСсылок Цикл   		
			МассивСтатей.Добавить(Статья);
		КонецЦикла; 
		
	Иначе
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	CW_ПлановыеСтатьиЗатратИДоходов.Ссылка КАК Ссылка
		               |ИЗ
		               |	Справочник.CW_ПлановыеСтатьиЗатратИДоходов КАК CW_ПлановыеСтатьиЗатратИДоходов
		               |ГДЕ
		               |	CW_ПлановыеСтатьиЗатратИДоходов.ВерсияБюджета = &ВерсияБюджета
		               |	И CW_ПлановыеСтатьиЗатратИДоходов.ВидСтатьиПланирования = &ВидСтатьиПланирования
		               |	И CW_ПлановыеСтатьиЗатратИДоходов.Контрагент = &Контрагент
		               |	И CW_ПлановыеСтатьиЗатратИДоходов.Номенклатура = &Номенклатура
		               |	И CW_ПлановыеСтатьиЗатратИДоходов.Валюта = &Валюта
		               |	И CW_ПлановыеСтатьиЗатратИДоходов.СтавкаНДС = &СтавкаНДС
		               |	И CW_ПлановыеСтатьиЗатратИДоходов.Организация = &Организация
		               |	И CW_ПлановыеСтатьиЗатратИДоходов.Владелец.Заказ = &Заказ
		               |	И CW_ПлановыеСтатьиЗатратИДоходов.ПометкаУдаления = ЛОЖЬ
		               |	И ВЫБОР
		               |			КОГДА &ГрузоперевозкаВыбрана
		               |				ТОГДА CW_ПлановыеСтатьиЗатратИДоходов.Владелец = &Грузоперевозка
		               |			ИНАЧЕ ИСТИНА
		               |		КОНЕЦ";
		
		Для каждого СтруктураПараметров Из Параметры.МассивСсылок Цикл
			
			Если Параметры.ДоходыВРасходы Тогда
				СтруктураПараметров.Вставить("ВидСтатьиПланирования",Перечисления.CW_ВидыСтатейПланирования.Доходы);
			Иначе
				СтруктураПараметров.Вставить("ВидСтатьиПланирования",Перечисления.CW_ВидыСтатейПланирования.Расходы);
			КонецЕсли;
			
			ТЗСтатей = _сф.ВыполнитьЗапрос(Запрос, СтруктураПараметров);
			Для каждого Стр Из ТЗСтатей Цикл
				МассивСтатей.Добавить(Стр.Ссылка);
			КонецЦикла; 
			
		КонецЦикла; 
		
	КонецЕсли; 
	
	// теперь получаем таблицу данных по найденным статья
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	CW_ПлановыеСтатьиЗатратИДоходов.Ссылка КАК Ссылка,
	               |	CW_ПлановыеСтатьиЗатратИДоходов.Владелец КАК Владелец,
	               |	CW_ПлановыеСтатьиЗатратИДоходов.Контрагент КАК Контрагент,
	               |	CW_ПлановыеСтатьиЗатратИДоходов.Номенклатура КАК Номенклатура,
	               |	CW_ПлановыеСтатьиЗатратИДоходов.Валюта КАК Валюта,
	               |	CW_ПлановыеСтатьиЗатратИДоходов.СтавкаНДС КАК СтавкаНДС,
	               |	CW_ПлановыеСтатьиЗатратИДоходов.Сумма КАК Сумма,
	               |	CW_ПлановыеСтатьиЗатратИДоходов.СуммаНДС КАК СуммаНДС,
	               |	CW_ПлановыеСтатьиЗатратИДоходов.СуммаВсего КАК СуммаВсего,
	               |	CW_ПлановыеСтатьиЗатратИДоходов.СуммаРуб КАК СуммаРуб,
	               |	CW_ПлановыеСтатьиЗатратИДоходов.СуммаНДСРуб КАК СуммаНДСРуб,
	               |	CW_ПлановыеСтатьиЗатратИДоходов.СуммаВсегоРуб КАК СуммаВсегоРуб,
	               |	CW_ПлановыеСтатьиЗатратИДоходов.Организация КАК Организация,
	               |	CW_ПлановыеСтатьиЗатратИДоходов.ПорядокОтраженияРасходов КАК ПорядокОтраженияРасходов,
	               |	CW_ПлановыеСтатьиЗатратИДоходов.ВерсияБюджета КАК ВерсияБюджета,
	               |	CW_ПлановыеСтатьиЗатратИДоходов.ВидСтатьиПланирования КАК ВидСтатьиПланирования,
	               |	CW_ПлановыеСтатьиЗатратИДоходов.Владелец.Владелец.Контрагент КАК КонтрагентВладельца,
	               |	CW_ПлановыеСтатьиЗатратИДоходов.Комментарий КАК Комментарий,
	               |	CW_ПлановыеСтатьиЗатратИДоходов.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	               |	CW_ПлановыеСтатьиЗатратИДоходов.Кратность КАК Кратность,
	               |	CW_ПлановыеСтатьиЗатратИДоходов.ТипКурсаВалюты КАК ТипКурсаВалюты,
	               |	CW_ПлановыеСтатьиЗатратИДоходов.Количество КАК Количество,
	               |	CW_ПлановыеСтатьиЗатратИДоходов.Цена КАК Цена,
	               |	CW_ПлановыеСтатьиЗатратИДоходов.ЦенаРуб КАК ЦенаРуб,
	               |	CW_ПлановыеСтатьиЗатратИДоходов.ВариантНаценки КАК ВариантНаценки,
	               |	CW_ПлановыеСтатьиЗатратИДоходов.ЗначениеНаценки КАК ЗначениеНаценки,
	               |	CW_ПлановыеСтатьиЗатратИДоходов.ЦенаСНДС КАК ЦенаСНДС,
	               |	CW_ПлановыеСтатьиЗатратИДоходов.УчитыватьНДСВСебестоимости КАК УчитыватьНДСВСебестоимости,
	               |	CW_ПлановыеСтатьиЗатратИДоходов.КонтрольнаяДатаКурсаДляПроверки КАК КонтрольнаяДатаКурсаДляПроверки
	               |ИЗ
	               |	Справочник.CW_ПлановыеСтатьиЗатратИДоходов КАК CW_ПлановыеСтатьиЗатратИДоходов
	               |ГДЕ
	               |	CW_ПлановыеСтатьиЗатратИДоходов.Ссылка В(&Ссылки)";
	
	Запрос.УстановитьПараметр("Ссылки", МассивСтатей);    
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	ТЗ = Запрос.Выполнить().Выгрузить();
	Для каждого Стр Из ТЗ Цикл
		
		ЭтоВариантБюджета = ТипЗнч(Стр.Владелец) = Тип("СправочникСсылка.CW_ВариантыБюджетовПоЗаявкам");
		
		СтруктураПараметров = Новый Структура;
		СтруктураПараметров.Вставить("Объект"				, Стр.Владелец);
		СтруктураПараметров.Вставить("ЭтоВариантБюджета"	, ЭтоВариантБюджета);
		
		Если ЭтоВариантБюджета Тогда
			СтруктураПараметров.Вставить("Контрагент"			, Стр.КонтрагентВладельца);
		Иначе
			СтруктураПараметров.Вставить("Контрагент"			, Стр.Владелец.Клиент);
		КонецЕсли;
	
		Стр.Контрагент = CW_Финансы.ВернутьПлательщика(СтруктураПараметров);
		
	КонецЦикла; 
	
	Если Параметры.ДоходыВРасходы Тогда
		ТЗ.ЗаполнитьЗначения(Перечисления.CW_ВидыСтатейПланирования.Расходы,"ВидСтатьиПланирования");
	Иначе
		ТЗ.ЗаполнитьЗначения(Перечисления.CW_ВидыСтатейПланирования.Доходы,"ВидСтатьиПланирования");
	КонецЕсли;
	
	ТЗ.Свернуть("Владелец,ВидСтатьиПланирования,ВерсияБюджета,Организация,Контрагент,Валюта,Номенклатура,СтавкаНДС,ПорядокОтраженияРасходов,Комментарий,ЕдиницаИзмерения,Кратность,ТипКурсаВалюты,Цена, ЦенаРуб,ВариантНаценки,ЗначениеНаценки,ЦенаСНДС,УчитыватьНДСВСебестоимости,КонтрольнаяДатаКурсаДляПроверки","Количество,Сумма,СуммаНДС,СуммаВсего,СуммаРуб,СуммаНДСРуб,СуммаВсегоРуб");
	
	мВалютыТЗ 	= ТЗ.ВыгрузитьКолонку("Валюта");
	мВалюты 	= Новый Массив;
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(мВалюты, мВалютыТЗ, Истина);
	
	СоответствиеКурсовВалют = Новый Соответствие;
	
	Для Каждого Валюта из мВалюты Цикл
		ДанныеКурса = CW_Финансы.ПолучитьКурсВалюты(Валюта, ТекущаяДата());
		СоответствиеКурсовВалют.Вставить(Валюта, ДанныеКурса);
	КонецЦикла;

	ВалютаРегламентированногоУчета = Константы.ВалютаРегламентированногоУчета.Получить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	CW_ПлановыеСтатьиЗатратИДоходов.Ссылка
	|ИЗ
	|	Справочник.CW_ПлановыеСтатьиЗатратИДоходов КАК CW_ПлановыеСтатьиЗатратИДоходов
	|ГДЕ
	|	CW_ПлановыеСтатьиЗатратИДоходов.ВерсияБюджета = &ВерсияБюджета
	|	И CW_ПлановыеСтатьиЗатратИДоходов.ВидСтатьиПланирования = &ВидСтатьиПланирования
	|	И CW_ПлановыеСтатьиЗатратИДоходов.Контрагент = &Контрагент
	|	И CW_ПлановыеСтатьиЗатратИДоходов.Номенклатура = &Номенклатура
	|	И CW_ПлановыеСтатьиЗатратИДоходов.Валюта = &Валюта
	|	И CW_ПлановыеСтатьиЗатратИДоходов.СтавкаНДС = &СтавкаНДС
	|	И CW_ПлановыеСтатьиЗатратИДоходов.Организация = &Организация
	|	И CW_ПлановыеСтатьиЗатратИДоходов.Владелец = &Владелец";
	
	Попытка
		
		НачатьТранзакцию();
		
		Для каждого Стр Из ТЗ Цикл
			
			УчитыватьНДСВСебестоимости = Ложь;
			Если Параметры.ДоходыВРасходы Тогда
				УчитыватьНДСВСебестоимости = CW_Настройки.ПараметрУчетнойПолитики(ТекущаяДата(), Стр.Организация, "УчитыватьНДСВСебестоимости");
			Иначе 
				УчитыватьНДСВСебестоимости = Ложь;
			КонецЕсли;
			
			Запрос.УстановитьПараметр("Владелец", Стр.Владелец); 
			Запрос.УстановитьПараметр("ВерсияБюджета", Стр.ВерсияБюджета);
			Запрос.УстановитьПараметр("ВидСтатьиПланирования", Стр.ВидСтатьиПланирования);
			Запрос.УстановитьПараметр("Контрагент", Стр.Контрагент);
			Запрос.УстановитьПараметр("Номенклатура", Стр.Номенклатура);
			Запрос.УстановитьПараметр("Валюта", Стр.Валюта);
			Запрос.УстановитьПараметр("СтавкаНДС", Стр.СтавкаНДС);
			Запрос.УстановитьПараметр("Организация", Стр.Организация); 

			СтатьяСсылка = _сф.ВыполнитьЗапрос(Запрос,,Истина,"Ссылка",Неопределено);
			Если (СтатьяСсылка <>  Неопределено) Тогда
				Статья = СтатьяСсылка.ПолучитьОбъект();
				Если (Статья.ПометкаУдаления) Тогда
					Статья.УстановитьПометкуУдаления(Ложь);
				КонецЕсли; 
			Иначе
				Статья = Справочники.CW_ПлановыеСтатьиЗатратИДоходов.СоздатьЭлемент();
			КонецЕсли;    
			
			ИсключаяСвойства = "";
			Если Стр.ВидСтатьиПланирования = ПредопределенноеЗначение("Перечисление.CW_ВидыСтатейПланирования.Доходы") Тогда
				ИсключаяСвойства = "ВариантНаценки,ЗначениеНаценки";                                                                                         
			КонецЕсли;
			
			ЗаполнитьЗначенияСвойств(Статья,Стр,,ИсключаяСвойства);
			
			Статья.УчитыватьНДСВСебестоимости = УчитыватьНДСВСебестоимости;
	
			Если Стр.ПорядокОтраженияРасходов = Перечисления.CW_ПорядокОтраженияЗатрат.Перевыставление Тогда
				Статья.ПорядокОтраженияДоходов = Перечисления.CW_ПорядокОтраженияДоходов.Перевыставление;
			ИначеЕсли Стр.ПорядокОтраженияРасходов = Перечисления.CW_ПорядокОтраженияЗатрат.Затраты Тогда
				Статья.ПорядокОтраженияДоходов = Перечисления.CW_ПорядокОтраженияДоходов.СобственнаяУслуга;
			ИначеЕсли Стр.ПорядокОтраженияРасходов = Перечисления.CW_ПорядокОтраженияЗатрат.ПеревыставлениеПоСтавкам Тогда
				Статья.ПорядокОтраженияДоходов = Перечисления.CW_ПорядокОтраженияДоходов.ПеревыставлениеПоСтавкам;
			КонецЕсли;
			
			ДанныеКурса = СоответствиеКурсовВалют.Получить(Стр.Валюта);
			Статья.Курс 		= ДанныеКурса.Курс;
			Статья.Кратность 	= ДанныеКурса.Кратность; 
			Статья.Количество = ?(Статья.Количество = 0,1,Статья.Количество);
			
			//Применяем наценку если есть   
			ТребуетсяПересчетСуммовыхПоказателей = Статья.УчитыватьНДСВСебестоимости <> Стр.УчитыватьНДСВСебестоимости;
			Если Стр.ВариантНаценки = ПредопределенноеЗначение("Перечисление.CW_ВариантыНаценки.Процент") Тогда
				Статья.СуммаВсего = Статья.СуммаВсего + (Окр(Статья.СуммаВсего/100 * Стр.ЗначениеНаценки, 2));
				ТребуетсяПересчетСуммовыхПоказателей = Истина;
			КонецЕсли;
			
			Если Стр.ВариантНаценки = ПредопределенноеЗначение("Перечисление.CW_ВариантыНаценки.Сумма") Тогда
				Статья.СуммаВсего = Статья.СуммаВсего +  Стр.ЗначениеНаценки;
				ТребуетсяПересчетСуммовыхПоказателей = Истина;
			КонецЕсли;  
			//Конец применения наценки
			
			
			// в случае, если перенос статей осуществляется из заявки, 
			// то анализируем вариант изменения валюты
			Если ФормаЗаявки(УФ) Тогда
				
				// перенос осуществляется с изменением валюты, указанной в варианте бюджета
				Если Параметры.ВариантВалютыБюджета = 1 Тогда
					
					Валюта 		= Параметры.Объект.Валюта;
					Курс 		= Параметры.Объект.Курс;	
					Кратность 	= Параметры.Объект.Кратность;
					
					Если Валюта.Пустая() Тогда
						Валюта 		= ВалютаРегламентированногоУчета;
						Курс 		= 1;
						Кратность 	= 1;
					КонецЕсли;
					
					Статья.Валюта 		= Валюта;	
					Статья.Курс 		= Курс;	
					Статья.Кратность 	= Кратность;	
					
					Статья.СуммаВсего 	= Окр(Статья.СуммаВсегоРуб / (Статья.Курс/Статья.Кратность), 2);   
					ТребуетсяПересчетСуммовыхПоказателей = Истина;
					
				КонецЕсли;
			КонецЕсли; // перенос осуществляется из формы заявки
			
			
			Если ТребуетсяПересчетСуммовыхПоказателей Тогда
				СтавкаНДСПроцент = CW_Финансы.ПолучитьСтавкуНДС(Статья.СтавкаНДС); 
				
				// расчет валютных показателей
				Статья.СуммаНДС = Окр(Статья.СуммаВсего * СтавкаНДСПроцент / (100 + СтавкаНДСПроцент),2); 
				Если УчитыватьНДСВСебестоимости Тогда
					Статья.Сумма = Статья.СуммаВсего;
				Иначе
					Статья.Сумма = Статья.СуммаВсего - Статья.СуммаНДС;
				КонецЕсли; 
				
				Если Статья.ЦенаСНДС Тогда
					Статья.Цена = Окр(Статья.СуммаВсего/Статья.Количество,2);
				Иначе
					Статья.Цена = Окр(Статья.Сумма/Статья.Количество,2);
				КонецЕсли;
				
				// расчет рублевых показателей
				Статья.СуммаВсегоРуб 	= Окр(Статья.СуммаВсего * Статья.Курс / ?(Статья.Кратность=0,1, Статья.Кратность), 2);
				Статья.СуммаНДСРуб		= Окр(Статья.СуммаВсегоРуб * СтавкаНДСПроцент/(100+СтавкаНДСПроцент),2);
				
				Если УчитыватьНДСВСебестоимости Тогда    
					Статья.СуммаРуб 		= Статья.СуммаВсегоРуб ;
				Иначе
					Статья.СуммаРуб 		= Статья.СуммаВсегоРуб - Статья.СуммаНДСРуб;
				КонецЕсли; 
				
				Если Статья.ЦенаСНДС Тогда
					Статья.ЦенаРуб = Окр(Статья.СуммаВсегоРуб/Статья.Количество,2);
				Иначе
					Статья.ЦенаРуб = Окр(Статья.СуммаРуб/Статья.Количество,2);
				КонецЕсли;
				
			КонецЕсли;   
			
			Статья.Записать(); 
			
			//AFR-260062  
			ИспользуетсяПрогнозированиеДДСПоБюджету = ПолучитьФункциональнуюОпцию("CW_ИспользуетсяПрогнозированиеДДСПоБюджету"); 
			Если ИспользуетсяПрогнозированиеДДСПоБюджету
				И ТипЗнч(Статья.Владелец) = Тип("СправочникСсылка.CW_Грузоперевозки") Тогда
				ПараметрыРасчета = Новый Структура;
				ПараметрыРасчета.Вставить("ВариантПрогноза", 			Статья.ВариантПрогноза);
				ПараметрыРасчета.Вставить("Владелец", 					Статья.Владелец);
				ПараметрыРасчета.Вставить("ПрогнозКонтрольнаяДата", 	Статья.ПрогнозКонтрольнаяДата);
				ПараметрыРасчета.Вставить("ПрогнозКоличествоДней", 		Статья.ПрогнозКоличествоДней);
				ПараметрыРасчета.Вставить("ПрогнозКоличествоДнейПлан", 	Статья.ПрогнозКоличествоДнейПлан);
				
				ПараметрыРасчета.Вставить("ПрогнозДата",	 			Дата(1,1,1));
				ПараметрыРасчета.Вставить("ДатаНачалаПеревозки", 		Статья.Владелец.ДатаСделкиФ);
				
				ПрогнозДата = Справочники.CW_ПлановыеСтатьиЗатратИДоходов.РассчитатьПрогнозОплатыСтатьиБюджета(ПараметрыРасчета); 
				РегистрыСведений.CW_ПрогнозОплатыПлановыхСтатейБюджета.ЗаписатьПрогнозОплаты(Статья.Ссылка, ПрогнозДата);
			КонецЕсли;
			//---AFR-260062

			
		КонецЦикла; 
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		
		Если (ТранзакцияАктивна()) Тогда
			
			ОтменитьТранзакцию();
			Сообщить(ОписаниеОшибки());
			
		КонецЕсли; 
		
	КонецПопытки; 
	
	Если Параметры.ДоходыВРасходы Тогда
		 Ответ = _УФКС.СД("Грузоперевозки","сервер","/БюджетРасходыОбновить");
	Иначе
		 Ответ = _УФКС.СД("Грузоперевозки","сервер","/БюджетДоходыОбновить");
	КонецЕсли;
	
	Возврат Ответ;
	
	// --- 
КонецФункции

&НаСервере
Функция ПересчетСтатейБюджетаПоКурсу(УФ,Параметры)
	// --- 
	
	Если (УФ.БюджетУтвержден) Тогда
		
		Возврат(Неопределено);
		
	КонецЕсли; 
	
	ВидСтатьиБюджета = Параметры.ВидСтатьиБюджета;
	ДатаКурса = Параметры.ДатаКурса;
	ВРУ = CW_Настройки.ВалютаРегламентированногоУчета();
	Если (НЕ ФормаЗаявки(УФ)) Тогда
		Объект = УФ.Объект.Ссылка;
	Иначе
		Объект = УФ.Объект.ВариантБюджета;
	КонецЕсли; 
	
	// --- 
	
	Если (ФормаЗаказа(УФ)) Тогда
		
		Если Значениезаполнено(Параметры.Грузоперевозка) Тогда
			МассивГП = Новый Массив;
			МассивГП.Добавить(Параметры.Грузоперевозка);
		Иначе
			МассивГП = CW_Мониторинг.ГрузоперевозкиЗаказа(Объект);
		КонецЕсли;
		
	Иначе
		
		МассивГП = Новый Массив;
		МассивГП.Добавить(Объект);
		
	КонецЕсли;
	// --- 
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	CW_ПлановыеСтатьиЗатратИДоходов.Ссылка,
	               |	CW_ПлановыеСтатьиЗатратИДоходов.ПорядокОтраженияРасходов
	               |ИЗ
	               |	Справочник.CW_ПлановыеСтатьиЗатратИДоходов КАК CW_ПлановыеСтатьиЗатратИДоходов
	               |ГДЕ
	               |	CW_ПлановыеСтатьиЗатратИДоходов.Владелец В(&Владельцы)
	               |	И CW_ПлановыеСтатьиЗатратИДоходов.ВерсияБюджета = &ВерсияБюджета
	               |	И CW_ПлановыеСтатьиЗатратИДоходов.ВидСтатьиПланирования = &ВидСтатьи
	               |	И CW_ПлановыеСтатьиЗатратИДоходов.ПометкаУдаления = ЛОЖЬ
	               |	И CW_ПлановыеСтатьиЗатратИДоходов.Валюта <> &ВРУ";
	Запрос.УстановитьПараметр("Владельцы", МассивГП);
	Запрос.УстановитьПараметр("ВерсияБюджета", УФ.БюджетТекущаяВерсия);
	Запрос.УстановитьПараметр("ВидСтатьи", ВидСтатьиБюджета); 
	Запрос.УстановитьПараметр("ВРУ", ВРУ);
	// --- 
	ТЗ = Запрос.Выполнить().Выгрузить();
	Для каждого Стр Из ТЗ Цикл
		
		Статья = Стр.Ссылка.ПолучитьОбъект();
		Статья.ПересчитатьПоКурсуНаДату(ДатаКурса); 
		
		Если Параметры.Свойство("ТипКурсаВалюты") Тогда
			Статья.ТипКурсаВалюты = Параметры.ТипКурсаВалюты;
		КонецЕсли;
		
		Статья.Записать();
		
	КонецЦикла; 
	
	// --- 
	Если (ВидСтатьиБюджета = Перечисления.CW_ВидыСтатейПланирования.Доходы) Тогда
		
		Возврат(_УФКС.СД("Грузоперевозки","сервер","/БюджетДоходыОбновить"));
		
	ИначеЕсли (ВидСтатьиБюджета = Перечисления.CW_ВидыСтатейПланирования.Расходы) Тогда
		
		Возврат(_УФКС.СД("Грузоперевозки","сервер","/БюджетРасходыОбновить"));
		
	КонецЕсли; 
	
	// --- 
КонецФункции

#КонецОбласти 

#Область Финансы 

&НаСервере
Функция ФинансыОбновить(УФ,	Расходы,	Доходы,	Транспорт)
	// --- 
	
	Если (Расходы) Тогда
		ФинансыРасходыОбновить(УФ);	
	КонецЕсли; 
	
	Если (Доходы) Тогда
		ФинансыДоходыОбновить(УФ);	
	КонецЕсли; 
	
	Если Транспорт  Тогда
		ФинансыТранспортОбновить(УФ);	
	КонецЕсли;
	
	ФинансыРезультатОбновить(УФ);
	// --- 
	ФинансыОбновитьИтоги(УФ);
	
	// --- 
КонецФункции
 
&НаСервере
Функция ФинансыОбновитьИтоги(УФ)
	// --- 
	
	ИспользованиеБлокаСобственногоТранспорта = ПолучитьФункциональнуюОпцию("CW_ИспользованиеБлокаСобственногоТранспорта");
	
	ФорматВывода = "ЧЦ=15; ЧДЦ=2; ЧН=";
	// --- 
	Сп = Новый СписокЗначений;
	Если (ФормаГрузоперевозки(УФ)) Тогда
		Сп.Добавить(УФ.Объект.Ссылка);
	Иначе
		гп = CW_Мониторинг.ГрузоперевозкиЗаказа(УФ.Объект.Ссылка);
		Для каждого стр  Из гп Цикл
			сп.Добавить(стр);
		КонецЦикла; 
	КонецЕсли; 
	
	ФинРез = CW_Финансы.ПолучитьФинРез(Сп,УФ.ОтображениеФинансовогоРезультата);
	
	СчетаАкты = "";
	Если (УФ.ОтображениеФинансовогоРезультата=0) Тогда
		СчетаАкты = " (по актам)";
		
	// добавлено CW (КС)..
	//--------------------
	ИначеЕсли (УФ.ОтображениеФинансовогоРезультата = 2) Тогда
		СчетаАкты = " (по план. начис.)";
		
	ИначеЕсли (УФ.ОтображениеФинансовогоРезультата = 3) Тогда
		СчетаАкты = " (по актам и план. начис.)";
	
	// конец изменений	
		
	Иначе
		СчетаАкты = " (по счетам)";
	КонецЕсли; 
	
	// Прибыль
	ВыводитьРезультатВБазовойВалюте = Истина;
	ВыводитьРасходыВБазовойВалюте = Истина;
	ВыводитьДоходыВБазовойВалюте = Истина;
	Если (УФ.ВыводитьРезультатВВалютеДокументов) Тогда
		
		// проверяем, что все документы в одной валюте
		ОбщаяВалюта = Справочники.Валюты.ПустаяСсылка();
		ВалютыРасходов = УФ.ФинансыРасходы.Выгрузить(,"Валюта");
		ВалютыРасходов.Свернуть("Валюта"); 
		ВалютыДоходов = УФ.ФинансыДоходы.Выгрузить(,"Валюта");
		ВалютыДоходов.Свернуть("Валюта");
		
		Если ИспользованиеБлокаСобственногоТранспорта и ФормаГрузоперевозки(УФ) Тогда
			ВалютыТранспорт = УФ.ФинансыТранспорт.Выгрузить(,"Валюта");
			ВалютыТранспорт.Свернуть("Валюта");
		КонецЕсли;
		
		Если (ВалютыРасходов.Количество()=1) Тогда
			ВалютаРасходов = ВалютыРасходов[0].Валюта;
			ВыводитьРасходыВБазовойВалюте = Ложь;
		Иначе
			ВалютаРасходов = Справочники.Валюты.ПустаяСсылка();
		КонецЕсли; 
		
		Если (ВалютыДоходов.Количество()=1) Тогда
			ВалютаДоходов = ВалютыДоходов[0].Валюта;
			ВыводитьДоходыВБазовойВалюте = Ложь;
		Иначе
			ВалютаДоходов = Справочники.Валюты.ПустаяСсылка();
		КонецЕсли;
		
		Если ИспользованиеБлокаСобственногоТранспорта и ФормаГрузоперевозки(УФ) Тогда
			Если (ВалютыТранспорт.Количество()=1) Тогда
				ВалютаТранспорт = ВалютыТранспорт[0].Валюта;
				ВыводитьтранспортВБазовойВалюте = Ложь;
			Иначе
				ВалютаТранспорт = Справочники.Валюты.ПустаяСсылка();
			КонецЕсли; 
		КонецЕсли;
	
		Если (ВалютаРасходов = ВалютаДоходов  И НЕ ВалютаРасходов.Пустая()) Тогда
			ВыводитьРезультатВБазовойВалюте=Ложь;
			ОбщаяВалюта = ВалютаРасходов;
		ИначеЕсли (ВалютаРасходов.Пустая()  И НЕ ВалютаДоходов.Пустая() И ВалютыРасходов.Количество()=0) Тогда 
			ВыводитьРезультатВБазовойВалюте=Ложь;
			ОбщаяВалюта = ВалютаДоходов;
		ИначеЕсли (НЕ ВалютаРасходов.Пустая() И ВалютаДоходов.Пустая() И ВалютыДоходов.Количество()=0) Тогда 
			ВыводитьРезультатВБазовойВалюте=Ложь;
			ОбщаяВалюта = ВалютаРасходов;
		КонецЕсли; 
		
	КонецЕсли;
	
	// ---------------------------------------------------------------------------- 
	
	Если (ВыводитьРасходыВБазовойВалюте) Тогда
		
		// Расходы
		ТекстИтога = "";
		_сф.стр_Добавить(ТекстИтога , "Расходы"+СчетаАкты+": " + Формат(ФинРез.Итог("РасходыВсего"), ФорматВывода) + " " + Строка(УФ.ВРУ));
		_сф.стр_Добавить(ТекстИтога , ", " + "расходы без НДС: " + Формат(ФинРез.Итог("РасходыСумма"), ФорматВывода) + " " + Строка(УФ.ВРУ));
		
	Иначе
		
		ТекстИтога = "";
		_сф.стр_Добавить(ТекстИтога , "Расходы"+СчетаАкты+": " + Формат(ФинРез.Итог("РасходыВсегоВалюта"), ФорматВывода) + " " + Строка(ВалютаРасходов));
		
	КонецЕсли; 
	УФ.Элементы.РасходыИтого.Заголовок = ТекстИтога;
	
	// --- 
	
	Если (ВыводитьДоходыВБазовойВалюте) Тогда
		
		// Доходы
		ТекстИтога = "";
		_сф.стр_Добавить(ТекстИтога, "Доходы"+СчетаАкты+": " + Формат(ФинРез.Итог("ДоходыВсего"), ФорматВывода) + " " + Строка(УФ.ВРУ));
		_сф.стр_Добавить(ТекстИтога, ", " + "доходы без НДС: " + Формат(ФинРез.Итог("ДоходыСумма"), ФорматВывода) + " " + Строка(УФ.ВРУ));
		
	Иначе
		
		ТекстИтога = "";
		_сф.стр_Добавить(ТекстИтога, "Доходы"+СчетаАкты+": " + Формат(ФинРез.Итог("ДоходыВсегоВалюта"), ФорматВывода) + " " + Строка(ВалютаДоходов));
		
	КонецЕсли; 
	УФ.Элементы.ДоходыИтого.Заголовок = ТекстИтога;
	
	// --- 
	Если ФормаГрузоперевозки(УФ) Тогда
		
		Если ИспользованиеБлокаСобственногоТранспорта Тогда
			
			Если (ВыводитьДоходыВБазовойВалюте) Тогда
				
				// Транспорт
				ТекстИтога = "";
				_сф.стр_Добавить(ТекстИтога, "транспортные расходы: " + Формат(ФинРез.Итог("ТранспортВсего"), ФорматВывода) + " " + Строка(УФ.ВРУ));
				_сф.стр_Добавить(ТекстИтога, ", " + "транспорт без НДС: " + Формат(ФинРез.Итог("ТранспортСумма"), ФорматВывода) + " " + Строка(УФ.ВРУ));
				
			Иначе
				
				ТекстИтога = "";
				_сф.стр_Добавить(ТекстИтога, "транспортные расходы: " + Формат(ФинРез.Итог("ТранспортВсегоВалюта"), ФорматВывода) + " " + Строка(ВалютаТранспорт));
				
			КонецЕсли; 
			УФ.Элементы.ФинансыТранспортИтого.Заголовок = ТекстИтога;
			
		КонецЕсли;
		
	КонецЕсли;

	// --- 
	
	Если (ВыводитьРезультатВБазовойВалюте) Тогда
		
		ТекстИтога = "";
		_сф.стр_Добавить(ТекстИтога, "Прибыль"+СчетаАкты+": " + Формат(ФинРез.Итог("ПрибыльВсего") - ?(ИспользованиеБлокаСобственногоТранспорта,ФинРез.Итог("ТранспортВсего"),0), ФорматВывода) + " " + Строка(УФ.ВРУ));
		_сф.стр_Добавить(ТекстИтога, ", "+"прибыль без НДС: " + Формат(ФинРез.Итог("ПрибыльСумма") - ?(ИспользованиеБлокаСобственногоТранспорта,ФинРез.Итог("ТранспортСумма"),0), ФорматВывода) + " " + Строка(УФ.ВРУ));
		
	Иначе
		
		ТекстИтога = "";
		_сф.стр_Добавить(ТекстИтога, "Прибыль"+СчетаАкты+": " + Формат(ФинРез.Итог("ПрибыльВсегоВалюта")- ?(ИспользованиеБлокаСобственногоТранспорта,ФинРез.Итог("ТранспортВсегоВалюта"),0), ФорматВывода) + " " + Строка(ОбщаяВалюта));
		
	КонецЕсли; 
	УФ.Элементы.ФинансовыйРезультатИтого.Заголовок = ТекстИтога;	
	
	// --- 
КонецФункции

&НаСервере
Функция ФинансыРасходыОбновить(УФ)
	// --- 
	
	Если (CW_Конфигурация.КонфигурацияДляРФ()) Тогда
		
		// формируем ТЗ затрат
		Если (ФормаГрузоперевозки(УФ)) Тогда
			
			Запрос = Новый Запрос;
			Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
			               |	CW_РасходыПоГрузоперевозкам.Грузоперевозка КАК Грузоперевозка,
			               |	CW_РасходыПоГрузоперевозкам.Контрагент КАК Контрагент,
			               |	CW_РасходыПоГрузоперевозкам.Договор КАК Договор,
			               |	CW_РасходыПоГрузоперевозкам.ДокументРасходов КАК Документ,
			               |	CW_РасходыПоГрузоперевозкам.ДокументРасходов.ПредставлениеДокумента КАК ПредставлениеДокумента,
			               |	CW_РасходыПоГрузоперевозкам.Номенклатура КАК Номенклатура,
			               |	CW_РасходыПоГрузоперевозкам.Валюта КАК Валюта,
			               |	НЕ CW_РасходыПоГрузоперевозкам.ЭтоАкт КАК ЭтоСчет,
			               |	CW_РасходыПоГрузоперевозкам.Всего_Валюта КАК ВсегоВал,
			               |	CW_РасходыПоГрузоперевозкам.Всего КАК Всего,
			               |	CW_РасходыПоГрузоперевозкам.Сумма КАК Сумма,
			               |	CW_РасходыПоГрузоперевозкам.НДС КАК НДС,
			               |	CW_РасходыПоГрузоперевозкам.ДокументРасходов.Дата КАК Дата,
			               |	CW_РасходыПоГрузоперевозкам.ДокументРасходов.Организация КАК Организация,
			               |	CW_ОтсутствующиеОригиналыДокументов.Документ КАК ДокументБезОригиналов,
			               |	CW_АктированиеВходящихСчетовОстатки.ВсегоОстаток КАК НеактированныйОстаток,
			               |	ЕСТЬNULL(CW_СтатусыДокументовСрезПоследних.СтатусДокумента, НЕОПРЕДЕЛЕНО) КАК СтатусДокумента,
			               |	ЕСТЬNULL(CW_НаличиеФайловАрхиваПоОбъектам.Признак, ЛОЖЬ) КАК Файлы
			               |ПОМЕСТИТЬ ВТ
			               |ИЗ
			               |	РегистрНакопления.CW_РасходыПоГрузоперевозкам КАК CW_РасходыПоГрузоперевозкам
			               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.CW_ОтсутствующиеОригиналыДокументов КАК CW_ОтсутствующиеОригиналыДокументов
			               |		ПО CW_РасходыПоГрузоперевозкам.ДокументРасходов = CW_ОтсутствующиеОригиналыДокументов.Документ
			               |			И CW_РасходыПоГрузоперевозкам.Контрагент = CW_ОтсутствующиеОригиналыДокументов.Контрагент
			               |			И CW_РасходыПоГрузоперевозкам.Договор = CW_ОтсутствующиеОригиналыДокументов.Договор
			               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.CW_АктированиеВходящихСчетов.Остатки(&ТД, Грузоперевозка = &Грузоперевозка) КАК CW_АктированиеВходящихСчетовОстатки
			               |		ПО CW_РасходыПоГрузоперевозкам.ДокументРасходов = CW_АктированиеВходящихСчетовОстатки.Счет
			               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.CW_СтатусыДокументов.СрезПоследних КАК CW_СтатусыДокументовСрезПоследних
			               |		ПО (CW_РасходыПоГрузоперевозкам.ДокументРасходов = (ВЫРАЗИТЬ(CW_СтатусыДокументовСрезПоследних.Документ КАК Документ.CW_РасходыПоГрузоперевозке)))
			               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.CW_НаличиеФайловАрхиваПоОбъектам КАК CW_НаличиеФайловАрхиваПоОбъектам
			               |		ПО CW_РасходыПоГрузоперевозкам.ДокументРасходов = CW_НаличиеФайловАрхиваПоОбъектам.Объект
			               |ГДЕ
			               |	CW_РасходыПоГрузоперевозкам.Грузоперевозка = &Грузоперевозка
			               |	И CW_РасходыПоГрузоперевозкам.Регистратор.ПометкаУдаления = ЛОЖЬ
			               |;
			               |
			               |////////////////////////////////////////////////////////////////////////////////
			               |ВЫБРАТЬ
			               |	ВТ.Грузоперевозка КАК Грузоперевозка,
