&НаСервере
Функция ФинансыРезультатОбновить(УФ)
	
	Если (УФ.Объект.Ссылка.Пустая()) Тогда
		Возврат(Неопределено);
	КонецЕсли; 
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДокументCW_ЗакрытиеГрузоперевозки.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.CW_ЗакрытиеГрузоперевозки КАК ДокументCW_ЗакрытиеГрузоперевозки
		|ГДЕ
		|	ДокументCW_ЗакрытиеГрузоперевозки.Аналитика = &Аналитика
		|	И ДокументCW_ЗакрытиеГрузоперевозки.ПометкаУдаления = ЛОЖЬ";
	Запрос.УстановитьПараметр("Аналитика", УФ.Объект.Ссылка);
	ТЗРез = Запрос.Выполнить().Выгрузить();
	
	УФ.Элементы.ГруппаФинансовыйРезультатСписок.Заголовок = "Результат" + ?(ТЗРез.Количество() = 0, "", " (" + ТЗРез.Количество() + ")");
	
КонецФункции

&НаСервере
Функция ОтборДокументовФинансовогоРезультата(УФ)
	
	УФ.ВыявлениеРезультата.Параметры.УстановитьЗначениеПараметра("Аналитика",УФ.Объект.Ссылка);
	УФ.ВыявлениеРезультата.Отбор.Элементы.Очистить();
	_УФС.ДобавитьОтбор(УФ.ВыявлениеРезультата.Отбор,"Аналитика",,УФ.Объект.Ссылка);
	
