Функция ПодготовитьСтруктуруОписаниеПодсистем() Экспорт
	
	ОписаниеПодсистем = Новый Структура;
	ОписаниеПодсистем.Вставить("ИмяПодсистемы", 	"");
	ОписаниеПодсистем.Вставить("Версия", 			"");
	
	Возврат ОписаниеПодсистем
	
КонецФункции

Функция СравнитьВерсии(ТекущаяВерсия, ВерсияКонфигурации) Экспорт  
	
	Если СокрЛП(ТекущаяВерсия) = СокрЛП(ВерсияКонфигурации) Тогда
		Возврат Истина;
	КонецЕсли;
	
	мВерсияКонфигурации	= СтрРазделить(СокрЛП(ВерсияКонфигурации),	".");
	мТекущаяВерсия 		= СтрРазделить(СокрЛП(ТекущаяВерсия),		".");
	
	СоответствуетМинимальнойВерсии   = Истина;
	СоответствуетРекомендуемойВерсии = Истина;
	
	Для Индекс = 0 по мТекущаяВерсия.ВГраница() Цикл
		
		индТекущаяВерсия 		= Число(мТекущаяВерсия.Получить(Индекс));
		индВерсияКонфигурации 	= Число(мВерсияКонфигурации.Получить(Индекс));
		
		Если индТекущаяВерсия > индВерсияКонфигурации Тогда
			//Если текущий разряд весрии больше чем разряд версии базы данных, то возвращаем "Истина"
			Возврат Истина;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Ложь

КонецФункции // СравнитьВерсии()


