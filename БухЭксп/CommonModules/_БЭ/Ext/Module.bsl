Функция ПереопределяемыйМодуль() Экспорт
	
	Если (ЭтоРедакция_3()) Тогда
		
		Обработка = Обработки.CW_ПереопределяемыеФункции_Редакция3.Создать();
		
	Иначе
		
		Обработка = Обработки.CW_ПереопределяемыеФункции_Редакция2.Создать();
		
	КонецЕсли; 
	
	Возврат(Обработка);
	
КонецФункции
Функция ЭтоРедакция_3() Экспорт 
	
	Версия = Метаданные.Версия;
	Если (Лев(Версия,1)="3") Тогда
		Возврат(Истина);
	Иначе
		Возврат(Ложь);
	КонецЕсли; 
	
