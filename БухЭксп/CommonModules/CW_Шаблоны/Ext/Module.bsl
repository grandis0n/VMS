	               |АВТОУПОРЯДОЧИВАНИЕ";  
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		СписокМакросов.Добавить("(мш) " + СокрЛП(Выборка.Наименование), "(мш) " + СокрЛП(Выборка.Наименование));
	КонецЦикла;
				   
	Возврат СписокМакросов; 
	
