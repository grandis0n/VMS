				Продолжить;
			КонецПопытки;	
			Путь = СтруктураМакроса.Реквизит;
			ФорматнаяСтрока = _сф.ст_ПолучитьСвойство(СтруктураМакроса,"ФорматнаяСтрока");
			// --- 
			Если (Сборник И СтруктураМакроса.Сборник) Тогда
				
				МассивЗначений = Новый Массив;
				Для каждого Стр Из СтрокиТЧ Цикл
					
					Значение = _сф.ЗначениеПоПутиДанных(Стр,Путь);
					
					//Переводим
					Если СтруктураМакроса.ВозможностьПеревода Тогда
						Если ЗначениеЗаполнено(КодЯзыка) Тогда
							ПутьОбъектаПеревода = СтруктураМакроса.ОбъектПеревода;
							ОбъектПеревода 		= _сф.ЗначениеПоПутиДанных(Стр,ПутьОбъектаПеревода);
							Значение 			= ПолучитьПереводЗначения(ОбъектПеревода,КодЯзыка);
						КонецЕсли;
					КонецЕсли;
					
					_сф.м_ДобавитьУникально(МассивЗначений,Значение);
					
				КонецЦикла; 
				инд = 0;
				Для каждого Стр Из МассивЗначений Цикл
					Если (ФорматнаяСтрока <> Неопределено) Тогда
						МассивЗначений[инд] = Формат(Стр,ФорматнаяСтрока);
					Иначе
						МассивЗначений[инд] = Строка(Стр);
					КонецЕсли; 
					инд = инд + 1;
				КонецЦикла; 
				СтрокаЗамены = _сф.м_Представление(МассивЗначений,", ");
				
			Иначе
				
				Если (Источник = "Строка") Тогда
					Значение = _сф.ЗначениеПоПутиДанных(СтрокаТЧ,Путь);
					
				// макросы, представляющие из себя фиксированное значение	
				ИначеЕсли (Источник = "Значение") Тогда 
					Значение = СтруктураМакроса.Реквизит;
					
				ИначеЕсли (Источник="Курс") Тогда 
					ДатаКурса = _сф.ЗначениеПоПутиДанных(Объект,Путь);
					Курс = CW_Финансы.ПолучитьКурсВалюты(Объект.Договор.ВалютаДоговора,ДатаКурса);
					Значение = Формат(Курс.Курс,"ЧДЦ=4; ЧН=");
					
				ИначеЕсли (Источник="КурсПриложения") Тогда 
					ДатаКурса = _сф.ЗначениеПоПутиДанных(Объект,Путь);
					Курс = CW_Финансы.ПолучитьКурсВалюты(Объект.ПриложениеКДоговору.ВалютаДоговора,ДатаКурса);
					Значение = Формат(Курс.Курс,"ЧДЦ=4; ЧН=");
				
				ИначеЕсли Макрос = "СрокОплаты" Тогда
					СрокОплаты = CW_Документы.ПолучитьСрокОплаты(Объект);
					Если ЗначениеЗаполнено(СрокОплаты.ДатаОплаты) Тогда
						Значение = Формат(СрокОплаты.ДатаОплаты,ФорматнаяСтрока);
					Иначе
						Значение = "";
					КонецЕсли;	
				ИначЕесли (Источник = "Функция") Тогда
					Значение 		= _сф.ЗначениеПоПутиДанных(Объект,Путь);
					ИмяКоманды 		= СтруктураМакроса.Команда;
					СтрокаКоманды 	= СтруктураМакроса.СтрокаКоманды;
					
					Если ИмяКоманды = "Вычислить" Тогда
						Значение = Вычислить(СтрокаКоманды);                    
					Иначе
						Значение = "";
					КонецЕсли;
				Иначе
					Значение = _сф.ЗначениеПоПутиДанных(Объект,Путь);
				КонецЕсли;
				
				//Применение форматной строки
				Если (ФорматнаяСтрока <> Неопределено) Тогда
					Значение = Формат(Значение,ФорматнаяСтрока);
				Иначе
					Значение = Строка(Значение);
				КонецЕсли;
				СтрокаЗамены = Значение;
				
				//ПЕРЕВОД
				Если СтруктураМакроса.ВозможностьПеревода Тогда
					Если ЗначениеЗаполнено(КодЯзыка) Тогда
						ПутьОбъектаПеревода = СтруктураМакроса.ОбъектПеревода;
						ОбъектПеревода 		= _сф.ЗначениеПоПутиДанных(СтрокаТЧ,ПутьОбъектаПеревода);
						СтрокаЗамены 		= ПолучитьПереводЗначения(ОбъектПеревода,КодЯзыка);
					КонецЕсли;
				КонецЕсли;
				
			КонецЕсли; 
			
			Текст =_сф.стр_Заменить(Текст,стрМакрос,СтрокаЗамены);
			
		КонецЦикла; 
		
		Если ТипЗнч(Объект) <> Тип("Структура") Тогда
			// дополнительные реквизиты
			ТипОбъекта 		= ТипЗнч(Объект.Ссылка);
			Метаданное 		= Метаданные.НайтиПоТипу(ТипОбъекта);
			ТабличнаяЧасть 	= Метаданное.ТабличныеЧасти.Найти("ДополнительныеРеквизиты");
			
			Если ТабличнаяЧасть <> Неопределено Тогда
				
				СоответствиеСвойств			= Новый Соответствие;
				СоответствиеЯзыкПеревода	= Новый Соответствие;
				//ТабличнаяЧастьОбъекта 		= Объект.ДополнительныеРеквизиты;
				
				Для каждого Макрос Из МассивМакросовДопРеквизитов Цикл
					
					стрМакрос 	= _сф.стр_Обернуть(Макрос,"%%");
					
					СтрСвойство = Сред(Макрос,5);
					СоответствиеСвойств.Вставить(Макрос, СтрСвойство); 
					
					//проверим необходимость перевода
					КодЯзыка = Неопределено;
					Если МассивМакросовТребуетсяПеревод.Найти(Макрос) <> Неопределено Тогда
						//Обрабатываем перервод
						КодЯзыка  = ПолчитьКодЯзыкаПереовда(Макрос); 
						//удалим код языка из макроса
						ИдентификаторМакроса 	= СтрЗаменить(Макрос,КодЯзыка,"");
						Если ЗначениеЗаполнено(КодЯзыка) тогда
							СоответствиеЯзыкПеревода.Вставить(Макрос,КодЯзыка); 
							
							СтрСвойство = Сред(ИдентификаторМакроса,5);
							СоответствиеСвойств.Вставить(Макрос, СтрСвойство); 
						КонецЕсли;
					КонецЕсли;
					
					ИмяСвойства = СоответствиеСвойств.Получить(Макрос);
					если ИмяСвойства = Неопределено Тогда
						Текст = СтрЗаменить(Текст,стрМакрос,"");
						Продолжить;
					КонецЕсли;
					
					Свойство = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоРеквизиту("Имя",ИмяСвойства);
					Если Свойство.Пустая() Тогда
						Текст = СтрЗаменить(Текст,стрМакрос,"");
						Продолжить;
					КонецЕсли;
					
					//НайденнаяСтрока 	= ТабличнаяЧастьОбъекта.Найти(Свойство, "Свойство");
					//Если НайденнаяСтрока = Неопределено Тогда
					МассивНайденныхСтрок = Объект.ДополнительныеРеквизиты.НайтиСтроки(Новый Структура("Свойство", Свойство));
					Если 0=МассивНайденныхСтрок.Количество() Тогда 
						Текст = СтрЗаменить(Текст,стрМакрос,"");
						Продолжить;
					КонеЦЕсли;
					
					//Значение = НайденнаяСтрока.Значение;
					Значение = МассивНайденныхСтрок[0].Значение;
					
					//Применение форматной строки
					ФорматнаяСтрока = Свойство.ФорматСвойства;
					Если ЗначениеЗаполнено(ФорматнаяСтрока) Тогда
						Значение = Формат(Значение, ФорматнаяСтрока);
					КонецЕсли;
					
					//ПЕРЕВОД    
					КодЯзыка = СоответствиеЯзыкПеревода.Получить(Макрос);
					Если ЗначениеЗаполнено(КодЯзыка) Тогда
						Если Справочники.ТипВсеСсылки().СодержитТип(ТипЗНЧ(Значение)) Тогда
							Значение = ПолучитьПереводЗначения(Значение,КодЯзыка);
						КонецЕсли;
					КонецЕсли;
					
					Если Справочники.ТипВсеСсылки().СодержитТип(ТипЗНЧ(Значение)) Тогда
						ТипЗначенияОбъекта	= ТипЗнч(Значение);
						Метаданное 			= Метаданные.НайтиПоТипу(ТипЗначенияОбъекта);
						
						ЕстьРеквизит = ОбщегоНазначения.ЕстьРеквизитОбъекта("ПолноеНаименование",Метаданное);
						Если ЕстьРеквизит Тогда
							Если ЗначениеЗаполнено(Значение.ПолноеНаименование) Тогда
								Значение = Значение.ПолноеНаименование;	
							КонецЕсли;
						КонецЕсли;
					КонецЕсли;
					
					Текст = СтрЗаменить(Текст,стрМакрос,СокрЛП(Значение));
					
				КонецЦикла; 
				
			КонецЕсли;
		КонецЕсли;

		//Параметры	
		Для каждого Макрос Из МассивМакросовПараметров Цикл        
			
			МассивСтрок = Новый Массив;
			
			Если Сборник Тогда
				МассивСтрок = СтрокиТЧ;
			Иначе
				МассивСтрок.Добавить(СтрокаТЧ);
			КонецЕсли;
			
			СтрокаЗамены = ПолучитьЗначениеПараметраГрузоперевозки(ТаблицаПараметровГрузоперевозок, МассивСтрок, Макрос);
			
			Текст = СтрЗаменить(Текст, "%"+Макрос+"%", СтрокаЗамены);
		КонецЦикла;   
		//--Параметры
		
		//Справочник
		СоответствиеЯзыкПереводаСправочник	= Новый Соответствие;
		Для каждого Макрос Из МассивМакросовСправочник Цикл
			КодЯзыка = Неопределено;
			НаименованиеСправочника	= Сред(Макрос, 6);
			Если МассивМакросовТребуетсяПеревод.Найти(Макрос) <> Неопределено Тогда
				//Обрабатываем перервод
				КодЯзыка  = ПолчитьКодЯзыкаПереовда(Макрос); 
				//удалим код языка из макроса
				НаименованиеСправочника	= СтрЗаменить(Макрос,КодЯзыка,"");
			КонецЕсли;        
			
			МакросСсылка = Справочники.CW_МакросыШаблоновУслуг.НайтиПоНаименованию(НаименованиеСправочника); 
			Если МакросСсылка.Пустая() Тогда
				Продолжить;
			КонецЕсли;
			
			Параметр 				= МакросСсылка.МониторинговыйПараметр;
			Отбор 					= Новый Структура("Параметр", Параметр);
			
			ПутьКРеквизитуЗначения	= МакросСсылка.РеквизитПараметра;
			ЭтоДата 				= Параметр.ТипЗначения = Новый ОписаниеТипов("Дата", Новый КвалификаторыДаты(ЧастиДаты.Дата));
			ЭтоБулево 				= Параметр.ТипЗначения = Новый ОписаниеТипов("Булево");
			ЭтоЧисло				= Параметр.ЭтоЧисло;
			
			Если Сборник Тогда
				
				МассивЗначений = Новый Массив; 
				
				Для каждого Стр Из СтрокиТЧ Цикл  
					
					ПараметрыГрузоперевозки = ТаблицаПараметровГрузоперевозок.Скопировать(Новый Структура("Грузоперевозка", Стр.Грузоперевозка));
					
					мНайденныеСтроки = ПараметрыГрузоперевозки.НайтиСтроки(Отбор);
					Если мНайденныеСтроки.Количество() > 0 Тогда
						СтрокаПараметра	= мНайденныеСтроки[0];
					КонецЕсли;
					Если СтрокаПараметра = Неопределено 
						И ЗначениеЗаполнено(Стр.Грузоперевозка.Заказ) Тогда  
						
						мНайденныеСтроки = Стр.Грузоперевозка.Заказ.ПараметрыЗаказа.НайтиСтроки(Отбор);
						Если мНайденныеСтроки.Количество() > 0 Тогда
							СтрокаПараметра	= мНайденныеСтроки[0];
						КонецЕсли;
					КонецЕсли;
					
					Если СтрокаПараметра = Неопределено Тогда
						Продолжить;
					КонецЕсли; 
					
					ЗначениеПараметра = СтрокаПараметра.Значение;
					ВозможноПолучениеРеквизита = Ложь;
					
					Если Параметр.ЭтоКонтрольнаяДата Тогда 
						ФорматВывода = "ДФ=dd.MM.yyyy";
						Если НЕ ПустаяСтрока(Параметр.ФорматВывода) Тогда 
							ФорматВывода = Параметр.ФорматВывода;
						КонецЕсли;
						ЗначениеПараметра = Формат(СтрокаПараметра.ЗначениеФакт, ФорматВывода);
					ИначеЕсли ЭтоЧисло или ЭтоБулево или ЭтоДата Тогда
						ФорматВывода = "";
						Если НЕ ПустаяСтрока(Параметр.ФорматВывода) Тогда 
							ФорматВывода = Параметр.ФорматВывода;
						КонецЕсли;
						ЗначениеПараметра = Формат(СтрокаПараметра.Значение, ФорматВывода);
						
					Иначе //Ссылка   
						ВозможноПолучениеРеквизита = Истина;
						ЗначениеПараметра = СтрокаПараметра.Значение;
					КонецЕсли;  
					
					Если Не ПустаяСтрока(ПутьКРеквизитуЗначения) и ВозможноПолучениеРеквизита Тогда
						ЗначениеПараметра =	Вычислить("ЗначениеПараметра."+ПутьКРеквизитуЗначения);
					КонецЕсли;
					
					Если ЭтоЧисло Тогда
						МассивЗначений.Добавить(ЗначениеПараметра);
					ИначеЕсли МассивЗначений.Найти(ЗначениеПараметра) = Неопределено Тогда
						МассивЗначений.Добавить(ЗначениеПараметра);
					КонецЕсли;    
					
				КонецЦикла; 
				
				СтрокаЗамены = СтрСоединить(МассивЗначений, ", ");
				
			Иначе   
				
				ПараметрыГрузоперевозки = ТаблицаПараметровГрузоперевозок.Скопировать(Новый Структура("Грузоперевозка", СтрокаТЧ.Грузоперевозка));
				
				мНайденныеСтроки = ПараметрыГрузоперевозки.НайтиСтроки(Отбор);
				Если мНайденныеСтроки.Количество() > 0 Тогда
					СтрокаПараметра	= мНайденныеСтроки[0];
				КонецЕсли;
				Если СтрокаПараметра = Неопределено 
					И ЗначениеЗаполнено(СтрокаТЧ.Грузоперевозка.Заказ) Тогда  
					
					мНайденныеСтроки = СтрокаТЧ.Грузоперевозка.Заказ.ПараметрыЗаказа.НайтиСтроки(Отбор);
					Если мНайденныеСтроки.Количество() > 0 Тогда
						СтрокаПараметра	= мНайденныеСтроки[0];
					КонецЕсли;
				КонецЕсли;
				
				Если СтрокаПараметра = Неопределено Тогда
					Продолжить;
				КонецЕсли; 
				
				ЗначениеПараметра = СтрокаПараметра.Значение;
				ВозможноПолучениеРеквизита = Ложь;
				
				Если Параметр.ЭтоКонтрольнаяДата Тогда 
					ФорматВывода = "ДФ=dd.MM.yyyy";
					Если НЕ ПустаяСтрока(Параметр.ФорматВывода) Тогда 
						ФорматВывода = Параметр.ФорматВывода;
					КонецЕсли;
					ЗначениеПараметра = Формат(СтрокаПараметра.ЗначениеФакт, ФорматВывода);
				ИначеЕсли ЭтоЧисло или ЭтоБулево или ЭтоДата Тогда
					ФорматВывода = "";
					Если НЕ ПустаяСтрока(Параметр.ФорматВывода) Тогда 
						ФорматВывода = Параметр.ФорматВывода;
					КонецЕсли;
					ЗначениеПараметра = Формат(СтрокаПараметра.Значение, ФорматВывода);
					
				Иначе //Ссылка   
					ВозможноПолучениеРеквизита = Истина;
					ЗначениеПараметра = СтрокаПараметра.Значение;
				КонецЕсли;  
				
				Если Не ПустаяСтрока(ПутьКРеквизитуЗначения) и ВозможноПолучениеРеквизита Тогда
					ЗначениеПараметра =	Вычислить("ЗначениеПараметра."+ПутьКРеквизитуЗначения);  
				КонецЕсли;    
				
				СтрокаЗамены = СокрЛП(ЗначениеПараметра);
				
			КонецЕсли;
			
			Текст 	=_сф.стр_Заменить(Текст,_сф.стр_Обернуть(Макрос,"%%"),СтрокаЗамены);
			
		КонецЦикла; 
		//--Справочник
	
		
		Если ЕстьПовтояремыеГруппыМакросов Тогда
			//Обрабатываем повтряемые группы макросов
			Для каждого ЭлементПодМакроса из СоответствиеПовторяемыеМакросов Цикл
				
				Если ТипЗнч(Объект) = Тип("ДокументСсылка.CW_ДоходыПоГрузоперевозке") или
					ТипЗнч(Объект) = Тип("ДокументСсылка.CW_РасходыПоГрузоперевозке") или
					ТипЗнч(Объект) = Тип("ДокументСсылка.CW_ОтчетЭкспедитора") Тогда
					
					Если ТипЗнч(СтрокиТЧ)= Тип("ДокументТабличнаяЧасть.CW_ДоходыПоГрузоперевозке.Услуги") или
						ТипЗнч(СтрокиТЧ)= Тип("ДокументТабличнаяЧасть.CW_РасходыПоГрузоперевозке.Услуги") или
						ТипЗнч(СтрокиТЧ)= Тип("ДокументТабличнаяЧасть.CW_ОтчетЭкспедитора.Услуги") Тогда
						
						тСтроки = СтрокиТЧ.Выгрузить();
						
					ИначеЕсли ТипЗнч(СтрокиТЧ)= Тип("ТаблицаЗначений") Тогда
						
						тСтроки = СтрокиТЧ.Скопировать();
						
					Иначе
						
						тСтроки = Объект.Услуги.Выгрузить();
						
					КонецЕсли;
					
					СтрокаПодМакроса = ЭлементПодМакроса.Значение;
					
					Если СтрНайти(СтрокаМакроса,"%ГрГП%") > 0 Тогда
						//нужна группирвока
						СтрокаПодМакроса 	= СтрЗаменить(СтрокаПодМакроса,"%ГрГП%","");
						тСтроки 			= ПодготовитьСвернутуюТаблицу(тСтроки, ХэшРеквизитов, СтрокаПодМакроса);
						
						тГрузопереовозок =  тСтроки.скопировать();
						тГрузопереовозок.Свернуть("Грузоперевозка");
						
						мЗначенияПодМакроса = Новый Массив;
						Для каждого строкаГП  из тГрузопереовозок Цикл
							Отбор = Новый Структура("Грузоперевозка",строкаГП.Грузоперевозка);
							мСтроки = тСтроки.НайтиСтроки(Отбор);
							
							ТекстПодМакроса = ОбработатьШаблонНоменклатуры(СтрокаПодМакроса, Объект, ,мСтроки);
							Если мЗначенияПодМакроса.Найти(ТекстПодМакроса) = Неопределено Тогда 
								мЗначенияПодМакроса.Добавить(ТекстПодМакроса);                 
							КонецЕсли;
							
						КонецЦикла;
						
					Иначе	
						
						мЗначенияПодМакроса = ОбработатьШаблонНоменклатурыФрагмент(Объект, СтрокаПодМакроса, тСтроки);
						
					КонецЕсли;
					
					ЗначениеПодМакроса = СтрСоединить(мЗначенияПодМакроса,"; ");
					
					Текст = СтрЗаменить(Текст,"%"+ЭлементПодМакроса.Ключ+"%",ЗначениеПодМакроса);
					
				КонецЕсли;
				
				
			КонецЦикла;
			
		КонецЕсли;

		
		//Заменяем переносы строк при их наличии в шаблоне
		Текст = СтрЗаменить(Текст,"%НоваяСтрока%",Символы.ПС);
		
		//Текст = СтрЗаменить(Текст,"%","");
		//Текст = СтрЗаменить(Текст,"(пг)","");
		
	Исключение
		Сообщить(ОписаниеОшибки());
		Возврат("-");
	КонецПопытки; 
	
	//вывод параметров
	Возврат(Текст); 
	
КонецФункции


Функция ПолучитьЗначениеПараметраГрузоперевозки(Знач ПараметрыГрузоперевозки, Знач МассивСтрок, Знач Макрос)
	
	КодЯзыка 	= ПолчитьКодЯзыкаПереовда(Макрос); 
	Макрос 		= СтрЗаменить(Макрос, КодЯзыка, "");
	мМакрос 	= СтрРазделить(Макрос,".");
	
	Идентификатор 	= мМакрос[0];
	ИмяЗначения 	= "Значение"; 
	
	Если мМакрос.Количество() > 1 Тогда   
		//ЗначениеПлан   ЗначениеФакт
		ИмяЗначения = ИмяЗначения+мМакрос[1];          
	КонецЕсли;    
	
	Запрос = Новый Запрос;
	Запрос.Текст =	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	CW_ПараметрыГрузоперевозок.Ссылка КАК Параметр,
	|	CW_ПараметрыГрузоперевозок.ТипЗначения КАК ТипЗначения,
	|	CW_ПараметрыГрузоперевозок.ФорматВывода КАК ФорматВывода,
	|	CW_ПараметрыГрузоперевозок.ЭтоКонтрольнаяДата КАК ЭтоКонтрольнаяДата,
	|	CW_ПараметрыГрузоперевозок.СохранятьПолноеЗначениеПараметра КАК СохранятьПолноеЗначениеПараметра
	|ИЗ
	|	ПланВидовХарактеристик.CW_ПараметрыГрузоперевозок КАК CW_ПараметрыГрузоперевозок
	|ГДЕ
	|	CW_ПараметрыГрузоперевозок.Идентификатор = &Идентификатор";
	
	Запрос.УстановитьПараметр("Идентификатор", Идентификатор);
	
	РезультатЗапроса = Запрос.Выполнить();   
	Если РезультатЗапроса.Пустой() Тогда
		Возврат "";
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	Выборка.Следующий();   
	
	ПустоеЗначение 	= Выборка.ТипЗначения.ПривестиЗначение(Неопределено); 
	ТипПустого		= ТипЗнч(ПустоеЗначение);

	ФорматВывода = Выборка.ФорматВывода; 
	Если ТипПустого = тип("Дата")
		и ПустаяСтрока(ФорматВывода) Тогда
		ФорматВывода = "ДЛФ=D"; 
	КонецЕсли;
	
	ЗначенияПараметра = Новый Соответствие;
	
	Для каждого СтрокаМассива Из МассивСтрок Цикл 
		
		ЗначениеПараметра = Неопределено;
	
		Отбор = Новый Структура;
		Отбор.Вставить("Параметр", 			Выборка.Параметр);
		Отбор.Вставить("Грузоперевозка", 	СтрокаМассива.Грузоперевозка);
		
		НайденныеСтроки = ПараметрыГрузоперевозки.НайтиСтроки(Отбор);
		Если НайденныеСтроки.Количество() > 0 тогда
			//тут всегда одна строка
			НайденнаяСтрока = НайденныеСтроки[0];
		КонецЕсли;
		
		Если НайденнаяСтрока = Неопределено 
			И ЗначениеЗаполнено(СтрокаМассива.Грузоперевозка.Заказ) Тогда
			
			ПараметрыЗаказа = СтрокаМассива.Грузоперевозка.Заказ.ПараметрыЗаказа;
			
			НайденнаяСтрока = ПараметрыЗаказа.Найти(Выборка.Параметр, "Параметр");  
		КонецЕсли;  
		
		Если НайденнаяСтрока = Неопределено Тогда
			Продолжить;
		КонецЕсли; 
		
		Если Выборка.СохранятьПолноеЗначениеПараметра Тогда
			ЗначениеПараметра = НайденнаяСтрока["ХранилищеДанных"].Получить(); 
		КонецЕсли;  
		
		Если Не ЗначениеЗаполнено(ЗначениеПараметра) Тогда
			ЗначениеПараметра = НайденнаяСтрока[ИмяЗначения]; 
		КонецЕсли;
		
		ТекущиеЗначения = ЗначенияПараметра.Получить(Выборка.Параметр); 
		Если ТекущиеЗначения = Неопределено Тогда 
			Если ТипПустого = тип("Число") Тогда
				ТекущиеЗначения = 0;
			Иначе
				ТекущиеЗначения = Новый Массив;
			КонецЕсли;
		КонецЕсли; 
		
		Если ТипЗнч(ТекущиеЗначения) = Тип("Число") Тогда   
			ТекущиеЗначения = ТекущиеЗначения + ЗначениеПараметра;
		Иначе    
			Если Справочники.ТипВсеСсылки().СодержитТип(ТипПустого) Тогда
				Если ЗначениеЗаполнено(КодЯзыка) Тогда
					ЗначениеПараметра = ПолучитьПереводЗначения(ЗначениеПараметра, КодЯзыка);
				Иначе
					ЗначениеПараметра = Строка(ЗначениеПараметра);
				КонецЕсли;
			Иначе
				Если Не ПустаяСтрока(ФорматВывода) Тогда
					ЗначениеПараметра = Формат(ЗначениеПараметра, ФорматВывода);
				Иначе
					ЗначениеПараметра = Строка(ЗначениеПараметра);
				КонецЕсли;
			КонецЕсли;
			
			Если ТекущиеЗначения.Найти(ЗначениеПараметра) = Неопределено Тогда 
				ТекущиеЗначения.Добавить(ЗначениеПараметра);
			КонецЕсли;
		КонецЕсли;
		
		ЗначенияПараметра.Вставить(Выборка.Параметр, ТекущиеЗначения);
		
	КонецЦикла; 
	
	ТекущиеЗначения = ЗначенияПараметра.Получить(Выборка.Параметр); 
	Если ТекущиеЗначения = Неопределено  Тогда  
		Возврат "";
	КонецЕсли;
	
	Если ТипЗнч(ТекущиеЗначения) = Тип("Число") Тогда   
		Если Не ПустаяСтрока(ФорматВывода) Тогда
			СтрокаЗамены = Формат(ТекущиеЗначения, ФорматВывода);
		Иначе
			СтрокаЗамены = Строка(ТекущиеЗначения);
		КонецЕсли;
	Иначе
		СтрокаЗамены = СтрСоединить(ТекущиеЗначения, ", ");	
	КонецЕсли;

	Возврат СтрокаЗамены;
	
КонецФункции

Функция ПолучитьНомерДатуАкта(Объект, ИмяРеквизита, ФорматнаяСтрока="") Экспорт
	
	ЭтоАкт  = Ложь;
	ЭтоСчет = Ложь;
	
	ИмяОбъектаМетаданных = Объект.Метаданные().Имя;
	
	Если ТипЗнч(Объект) = Тип("ДокументСсылка.CW_ДоходыПоГрузоперевозке") Тогда
		ЭтоАкт 	= Объект["ФормируетсяАкт"];
		ЭтоСчет = Объект["ФормируетсяСчет"];
	ИначеЕсли ТипЗнч(Объект) = Тип("ДокументСсылка.CW_РасходыПоГрузоперевозке") Тогда
		ЭтоАкт 	= Объект["ПредъявленАкт"];
		ЭтоСчет = Объект["ПредъявленСчет"];
	КонецЕсли;
	
	Если НЕ ЭтоАкт и Не ЭтоСчет Тогда
		Возврат Объект.Дата;
	КонецЕсли;
	
	Если ЭтоАкт Тогда
		
		Значение = Формат(Объект[ИмяРеквизита], ФорматнаяСтрока);
		Возврат Значение;
		
	ИначеЕсли ЭтоСчет Тогда

		Запрос = новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	ВЫРАЗИТЬ(CW_СвязанныеДокументы.Ссылка КАК Документ."+ИмяОбъектаМетаданных+") КАК Ссылка,
		               |	CW_СвязанныеДокументы.Ссылка.Организация КАК Организация,
		               |	CW_СвязанныеДокументы.Ссылка.НомерАкта КАК НомерАкта,
		               |	CW_СвязанныеДокументы.Ссылка.ДатаАкта КАК ДатаАкта
		               |ИЗ
		               |	КритерийОтбора.CW_СвязанныеДокументы(&Объект) КАК CW_СвязанныеДокументы
					   |ГДЕ
					   | CW_СвязанныеДокументы.Ссылка ССЫЛКА Документ."+ИмяОбъектаМетаданных+"";
		
		Запрос.УстановитьПараметр("Объект", Объект);
		РезультатЗапроса = Запрос.Выполнить();
		Выборка = РезультатЗапроса.Выбрать();
		
		МассивЗначений = новый Массив;
		Пока Выборка.Следующий() Цикл
			Значение = Выборка[ИмяРеквизита];
			
			Если Не ПустаяСтрока(ФорматнаяСтрока) Тогда
				Значение = Формат(Значение, ФорматнаяСтрока);
			Иначе //Получаем номер
				СтруктураПараметров = Новый Структура;
				СтруктураПараметров.Вставить("Организация", Выборка.Организация);
				СтруктураПараметров.Вставить("Номер", 		Выборка[ИмяРеквизита]);
				СтруктураПараметров.Вставить("Дата", 		Выборка.ДатаАкта);
				
				Значение = CW_Документы.ПолучитьНомерНаПечать(СтруктураПараметров);
				
			КонецЕсли;
			
			мЗначение = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Значение);
			ОбщегоНазначенияКлиентСервер.ДополнитьМассив(МассивЗначений,мЗначение, Истина);
		КонецЦикла;
		
		СтрЗначений = СтрСоединить(МассивЗначений,", ");
		
	КонецЕсли;
	
	Возврат СтрЗначений;
		
		
КонецФункции

Функция КоличествоГрузоперевозок(СтрокаТаблицы = Неопределено, СтрокиТаблицы = Неопределено) Экспорт
	
	Если СтрокиТаблицы = Неопределено 
		И СтрокаТаблицы <> Неопределено Тогда
		Возврат 1;
	КонецЕсли;
	
	МассивГрузоперевозок = Новый Массив;
	Для Каждого ТекущаяСтрока  из СтрокиТаблицы Цикл
		ЗначениеВМассиве = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ТекущаяСтрока.Грузоперевозка);
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(МассивГрузоперевозок, ЗначениеВМассиве, Истина);
	КонецЦикла;

	Возврат МассивГрузоперевозок.Количество();
	
КонецФункции

Функция ОбработатьШаблонНоменклатурыФрагмент(Знач Объект, Знач СтрокаПодМакроса, Знач тСтроки)
	
	мЗначенияПодМакроса = Новый Массив;
	Для Каждого СтрокаТаблицы из тСтроки Цикл
		ТекстПодМакроса = ОбработатьШаблонНоменклатуры(СтрокаПодМакроса, Объект, СтрокаТаблицы);
		Если мЗначенияПодМакроса.Найти(ТекстПодМакроса) = Неопределено Тогда 
			мЗначенияПодМакроса.Добавить(ТекстПодМакроса);                 
		КонецЕсли;
	КонецЦикла;
	Возврат мЗначенияПодМакроса;
	
КонецФункции

Функция ПодготовитьСвернутуюТаблицу(тСтроки, ХэшРеквизитов, ЭлементПодМакроса)
	
	Если тСтроки.количество() = 0 тогда
		Возврат тСтроки;
	КонецЕсли;  
	
	тСтроки.Колонки.Добавить("Заказ"); 
	Для Каждого СтрокаТаблицы из тСтроки Цикл   
		Если ТипЗнч(СтрокаТаблицы.Грузоперевозка)= Тип("СправочникСсылка.CW_Грузоперевозки") Тогда
			СтрокаТаблицы.Заказ  = СтрокаТаблицы.Грузоперевозка.Заказ;	                              
		КонецЕсли;
	КонецЦикла;    

	ПерваяСтрока = тСтроки[0];

	МассивСвертки 	= новый Массив;
	МассивСумм 		= новый Массив;
	
	Для Каждого Колонка из тСтроки.Колонки Цикл 
		
		ИмяРеквизита = Колонка.Имя;
		
		Если ТипЗнч(ПерваяСтрока[Колонка.Имя]) = Тип("Число") тогда  
			Если МассивСумм.Найти(ИмяРеквизита) = Неопределено Тогда
				МассивСумм.Добавить(ИмяРеквизита);
			КонецЕсли;
		Иначе
			Если МассивСвертки.Найти(ИмяРеквизита) = Неопределено Тогда
				МассивСвертки.Добавить(ИмяРеквизита);
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
	СтрокаСвертки 	= СтрСоединить(МассивСвертки,",");
	СтрокаСумм 		= СтрСоединить(МассивСумм,",");
	
	Если ПустаяСтрока(СтрокаСвертки) Тогда
		Возврат тСтроки;
	КонецЕсли; 

	тСтроки.Свернуть(СтрокаСвертки,СтрокаСумм);	
	
	Возврат тСтроки;
	
КонецФункции

Функция ПолучитьПереводЗначения(ОбъектПеревода, КодЯзыка)
	
	Если Справочники.ТипВсеСсылки().СодержитТип(ТипЗнч(ОбъектПеревода)) Тогда
		
		КодЯзыка = СтрЗаменить(КодЯзыка,"<","");
		КодЯзыка = СтрЗаменить(КодЯзыка,">","");
		//получим переовд для значения
		ЯзыкПеревода = Справочники.CW_Языки.НайтиПоКоду(КодЯзыка);
		
		Если Не ЯзыкПеревода.Пустая() Тогда
			Запрос = Новый запрос;
			запрос.Текст  = "ВЫБРАТЬ
			                |	CW_Переводы.ОбъектПеревода КАК ОбъектПеревода,
			                |	CW_Переводы.Язык КАК Язык,
			                |	CW_Переводы.Перевод КАК Перевод
			                |ИЗ
			                |	РегистрСведений.CW_Переводы КАК CW_Переводы
			                |ГДЕ
			                |	CW_Переводы.ОбъектПеревода = &ОбъектПеревода
			                |	И CW_Переводы.Язык = &Язык";
			
			Запрос.УстановитьПараметр("ОбъектПеревода", ОбъектПеревода);			
			Запрос.УстановитьПараметр("Язык", ЯзыкПеревода);
			
			Выборка = запрос.Выполнить().Выбрать();
			
			Если Выборка.Следующий() Тогда
				
				Возврат Выборка.Перевод;
				
			КонецЕсли;
			
		КонецЕсли;
		
		Возврат "";
		
	КонецЕсли;
	
	Возврат  ОбъектПеревода;
	
КонецФункции

Функция ПолчитьКодЯзыкаПереовда(стрМакрос)
	//Обрабатываем перервод
	ПервыйСимвол = СтрНайти(стрМакрос,"<"); 
	ВторойСимвол = СтрНайти(стрМакрос,">");
	
	Если ПервыйСимвол=0 или ВторойСимвол=0 Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат Сред(стрМакрос,ПервыйСимвол,ВторойСимвол-(ПервыйСимвол-1)); 
	
КонецФункции

Функция ОбработатьШаблонСтатусаОборудования(Знач Шаблон, Грузоперевозка, ИсходнаяСтрокаСтатуса) Экспорт 
	// --- 
	
	СтрокаСтатуса = Новый Структура;
	СтрокаСтатуса.Вставить("Статус", 			ИсходнаяСтрокаСтатуса.Статус);
	СтрокаСтатуса.Вставить("Значение", 			ИсходнаяСтрокаСтатуса.ЗначениеКонтрольнойДаты);
	СтрокаСтатуса.Вставить("КонтрольнаяДата", 	ИсходнаяСтрокаСтатуса.КонтрольнаяДата);
	СтрокаСтатуса.Вставить("Грузоперевозка", 	Грузоперевозка);
	
	Попытка
		
		Текст = Шаблон;
		// --- 		
		ХэшРеквизитов = Новый Соответствие;
		// --- 
		ХэшРеквизитов.Вставить("%Статус%",Новый Структура("Сборник,Источник,Реквизит",Ложь,"Строка","Статус"));
		ХэшРеквизитов.Вставить("%ДатаСтатуса%",Новый Структура("Сборник,Источник,Реквизит",Ложь,"Строка","Значение"));
		ХэшРеквизитов.Вставить("%КонтрольнаяДатаСтатуса%",Новый Структура("Сборник,Источник,Реквизит",Ложь,"Строка","КонтрольнаяДата"));
		ХэшРеквизитов.Вставить("%ОтслеживаемоеОборудование%",Новый Структура("Сборник,Источник,Реквизит",Ложь,"Строка","Грузоперевозка.ОтслеживаемоеОборудование"));
		// --- 
		ХэшРеквизитов.Вставить("%Грузоперевозка%",Новый Структура("Сборник,Источник,Реквизит",Ложь,"Строка","Грузоперевозка"));
		ХэшРеквизитов.Вставить("%Номер грузоперевозки%",Новый Структура("Сборник,Источник,Реквизит",Ложь,"Строка","Грузоперевозка.Код"));
		ХэшРеквизитов.Вставить("%Заказ%",Новый Структура("Сборник,Источник,Реквизит",Ложь,"Строка","Грузоперевозка.Заказ"));
		ХэшРеквизитов.Вставить("%Клиент%",Новый Структура("Сборник,Источник,Реквизит",Ложь,"Строка","Грузоперевозка.Клиент"));
		ХэшРеквизитов.Вставить("%ДатаЗаказа%",Новый Структура("Сборник,Источник,Реквизит,ФорматнаяСтрока",Ложь,"Строка","Грузоперевозка.Заказ.ДатаСделкиФ","ДФ=dd.MM.yyyy"));
		ХэшРеквизитов.Вставить("%Типоразмер%",Новый Структура("Сборник,Источник,Реквизит",Ложь,"Строка","Грузоперевозка.Типоразмер"));
		ХэшРеквизитов.Вставить("%ТипКонтейнера%",Новый Структура("Сборник,Источник,Реквизит",Ложь,"Строка","Грузоперевозка.Типоразмер.Тип"));
		ХэшРеквизитов.Вставить("%РазмерКонтейнера%",Новый Структура("Сборник,Источник,Реквизит",Ложь,"Строка","Грузоперевозка.Типоразмер.Размер"));
		ХэшРеквизитов.Вставить("%Типоразмер%",Новый Структура("Сборник,Источник,Реквизит",Ложь,"Строка","Грузоперевозка.Типоразмер"));
		ХэшРеквизитов.Вставить("%Груз%",Новый Структура("Сборник,Источник,Реквизит",Ложь,"Строка","Грузоперевозка.Груз"));
		ХэшРеквизитов.Вставить("%Маршрут%",Новый Структура("Сборник,Источник,Реквизит",Ложь,"Строка","Грузоперевозка.Маршрут"));
		// --- 
		ХэшРеквизитов.Вставить("%Всего%"	,Новый Структура("Сборник,Источник,Реквизит,ФорматнаяСтрока",Истина,"Строка","Всего", "ЧДЦ=2"));
		ХэшРеквизитов.Вставить("%НДС%"		,Новый Структура("Сборник,Источник,Реквизит,ФорматнаяСтрока",Истина,"Строка","НДС", "ЧДЦ=2"));
		ХэшРеквизитов.Вставить("%БезНДС%"	,Новый Структура("Сборник,Источник,Реквизит,ФорматнаяСтрока",Истина,"Строка","Сумма", "ЧДЦ=2"));
		// ----
	
		// разбиваем все макросы шаблона на реквизиты и параметры
		МассивМакросовРеквизитов = Новый Массив;
		МассивМакросовПараметров = Новый Массив;
		ВсеМакросыШаблона = _сф.стр_СписокМакросов(Шаблон,"%%");	
		Для каждого Макрос Из ВсеМакросыШаблона Цикл
			
			Если (Найти(Макрос, "(пг)") > 0 ИЛИ Найти(Макрос, "(кд)") > 0) Тогда
				МассивМакросовПараметров.Добавить(Макрос);
			Иначе
				МассивМакросовРеквизитов.Добавить(Макрос);
			КонецЕсли; 
			
		КонецЦикла; 
		
		// реквизиты
		Для каждого Макрос Из МассивМакросовРеквизитов Цикл
			
			стрМакрос = _сф.стр_Обернуть(Макрос,"%%");
			// --- 
			СтруктураМакроса = ХэшРеквизитов.Получить(стрМакрос);
			Попытка
				Источник = СтруктураМакроса.Источник;
			Исключение
				//ВнМакрос = стрМакрос;
				//СтрокаЗамены = ПроверитьВнешниеМакросы(ВнМакрос, Объект);
				//Текст = _сф.стр_Заменить(Текст,стрМакрос,СтрокаЗамены);
				Продолжить;
			КонецПопытки;	
			Путь = СтруктураМакроса.Реквизит;
			ФорматнаяСтрока = _сф.ст_ПолучитьСвойство(СтруктураМакроса,"ФорматнаяСтрока");
			// --- 
			Если (Источник = "Строка") Тогда
				Значение = _сф.ЗначениеПоПутиДанных(СтрокаСтатуса,Путь);
			Иначе
				Значение = _сф.ЗначениеПоПутиДанных(Грузоперевозка,Путь);
			КонецЕсли;
			Если (ФорматнаяСтрока <> Неопределено) Тогда
				Значение = Формат(Значение,ФорматнаяСтрока);
			Иначе
				Значение = Строка(Значение);
			КонецЕсли;
			СтрокаЗамены = Значение;
			
			Текст=_сф.стр_Заменить(Текст,стрМакрос,СтрокаЗамены);
			
		КонецЦикла; 
		
		// параметры
		Для каждого Макрос Из МассивМакросовПараметров Цикл
			
			// ищем ссылку на параметр
			
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ
			|	CW_ПараметрыГрузоперевозок.Ссылка
			|ИЗ
			|	ПланВидовХарактеристик.CW_ПараметрыГрузоперевозок КАК CW_ПараметрыГрузоперевозок
			|ГДЕ
			|	CW_ПараметрыГрузоперевозок.Идентификатор = &Идентификатор";
			Запрос.УстановитьПараметр("Идентификатор", Макрос);
			ТЗП = Запрос.Выполнить().Выгрузить();
			Если ТЗП.Количество() = 0 Тогда
				Текст=_сф.стр_Заменить(Текст,_сф.стр_Обернуть(Макрос,"%%"),"");
				Продолжить;
			КонецЕсли;
			
			Параметр = _сф.к_ПервыйЭлемент(ТЗП).Ссылка;
			ЭтоДата = (Параметр.ТипЗначения = Новый ОписаниеТипов("Дата", Новый КвалификаторыДаты(ЧастиДаты.Дата)));
			
			Отбор = Новый Структура("Параметр",Параметр);
			СтрокаПараметра = _сф.к_НайтиСтроку(СтрокаСтатуса.Грузоперевозка.ПараметрыГрузоперевозки,Отбор);
			Если (СтрокаПараметра <> Неопределено) Тогда
				
				Если (Параметр.ЭтоКонтрольнаяДата) Тогда
					Значение = Формат(СтрокаПараметра.ЗначениеФакт,"ДФ=dd.MM.yyyy");
				Иначе
					Если (ЭтоДата) Тогда
						Значение = Формат(СтрокаПараметра.Значение,"ДФ=dd.MM.yyyy");
					Иначе
						Значение = СтрокаПараметра.Значение;
					КонецЕсли;
				КонецЕсли; 
				СтрокаЗамены = Строка(Значение);
				
			Иначе
				
				СтрокаЗамены = "";
				
			КонецЕсли; 
			
			Текст=_сф.стр_Заменить(Текст,_сф.стр_Обернуть(Макрос,"%%"),СтрокаЗамены);
			
		КонецЦикла; 
		
		Текст = СтрЗаменить(Текст,"%","");
		Текст = СтрЗаменить(Текст,"(пг)","");
		
	Исключение
		Сообщить(ОписаниеОшибки());
		Возврат("-");
	КонецПопытки; 
	
	//вывод параметров
	Возврат(Текст); 
	
КонецФункции
// --- 
Функция ПроверитьВнешниеМакросы(Знач Текст, Объект, СтрокиТЧ = Неопределено)
	
	Запрос = Новый Запрос();
	Запрос.Текст =
		"ВЫБРАТЬ
		|	CW_ПодключаемыеОбъекты.Ссылка КАК Обработка
		|ИЗ
		|	Справочник.CW_ПодключаемыеОбъекты КАК CW_ПодключаемыеОбъекты
		|ГДЕ
		|	CW_ПодключаемыеОбъекты.Вид = &Вид
		|	И CW_ПодключаемыеОбъекты.НеИспользуется = ЛОЖЬ";
	Запрос.УстановитьПараметр("Вид", "ВнешнийМакрос");
	ТЗ = Запрос.Выполнить().Выгрузить();
	
	Если ТЗ.Количество() = 1 Тогда
		Обработка = ТЗ[0].Обработка;
	Иначе
		Возврат Текст;
	КонецЕсли;	
	
	Структ = Новый Структура("Действие,Текст,Объект, СтрокиТЧ", "ОбработкаМакросов", Текст, Объект, СтрокиТЧ);
	ПараметрыОбработки = Новый Структура("Объект", ПоместитьВоВременноеХранилище(Структ));
	
	ОбработкаОбъект = _ПО.ПолучитьОбработку(Обработка);
	Если (ОбработкаОбъект = Неопределено) Тогда
		Сообщить("Ошибка подключения внешней команды");
		Возврат(_УФКС.Ответ(1));
	КонецЕсли; 
	
	Попытка
		Ответ = ОбработкаОбъект.ВыполнитьКоманду(Обработка, ПараметрыОбработки);
	Исключение
	КонецПопытки; 
	
	Если Ответ <> Неопределено Тогда
		Возврат ПолучитьИзВременногоХранилища(Ответ.Адрес);
	КонецЕсли;	
	
	ОбработкаОбъект = Неопределено;
	
	Возврат Текст;	
	
КонецФункции	


