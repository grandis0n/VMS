// Процедура - Установить представление номенклатуры в строке
//
// Устанавливает представление в реквизит "Представление" текущей строки представление номенклатуры полученное из шаблн апо переданым параметрам
//
// Параметры:
//  ТекущаяСтрока	 - 	 Строка объекта, в которой будет установлено представление номенклатуры, сформированное по шаблону 
//  ПараметрыШаблона - 	 Параметры получения предсставления 
//
////ПРИМЕР ВЫЗОВА:
////  ПараметрыШаблона = CW_Шаблоны.ПолучитьПараметрШаблонаУслуг();
////		
//// 	ПараметрыШаблона.Номенклатура 			= <Номенклатура>;
////	ПараметрыШаблона.Объект 				= <Объект>;
////	ПараметрыШаблона.Дата 					= <Дата>;
//// 	ПараметрыШаблона.Договор 				= <Договор>;
////	ПараметрыШаблона.ВидДоговора 			= <ВидДоговора>;
////	ПараметрыШаблона.ПриложениеКДоговору 	= <ПриложениеКДоговору>;
////
////	CW_Шаблоны.УстановитьПредставлениеНоменклатурыВСтроке(<ТекущаяСтрока>, ПараметрыШаблона);
///
Процедура УстановитьПредставлениеНоменклатурыВСтроке(ТекущаяСтрока, ПараметрыШаблона) Экспорт
	
	Если Не ЗначениеЗаполнено(ПараметрыШаблона.Номенклатура) Тогда
		ТекущаяСтрока[ПараметрыШаблона.ИмяРеквизитаСтроки] = "";
		Возврат;
	КонецЕсли;
	
	//Проерим наличие данынх в регистре
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	CW_ШаблоныУслуг.Номенклатура КАК Номенклатура,
	|	CW_ШаблоныУслуг.Договор КАК Договор,
	|	CW_ШаблоныУслуг.РасходнаяСтатья КАК РасходнаяСтатья,
	|	CW_ШаблоныУслуг.ДоходнаяСтатья КАК ДоходнаяСтатья
	|ИЗ
	|	РегистрСведений.CW_ШаблоныУслуг КАК CW_ШаблоныУслуг";
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() тогда
		ТекущаяСтрока[ПараметрыШаблона.ИмяРеквизитаСтроки] = ПараметрыШаблона.Номенклатура.НаименованиеПолное;
		Возврат;
	КонецЕсли;

	ЯзыкПечатиДокументов = ПараметрыШаблона.ЯзыкПечатиДокументов;
	
	Если ЯзыкПечатиДокументов = Неопределено Тогда
		СтруктураПараметров = CW_Настройки.ПустаяСтруктураПолученияПараметровДоговора();
		СтруктураПараметров.Дата 				= ПараметрыШаблона.Дата;
		СтруктураПараметров.Договор 			= ПараметрыШаблона.Договор;
		СтруктураПараметров.ПриложениеКДоговору = ПараметрыШаблона.ПриложениеКДоговору;
		
		ПараметрыДоговора	= CW_Настройки.ПолучитьПараметрыДоговора(СтруктураПараметров, "ЯзыкПечатиДокументов");
		ПараметрыДоговора.Свойство("ЯзыкПечатиДокументов", ЯзыкПечатиДокументов); 
	КонецЕсли;
	
	Если ЯзыкПечатиДокументов = Неопределено Тогда
		ТекущаяСтрока[ПараметрыШаблона.ИмяРеквизитаСтроки] = "<для договора не указан язык печати документов>";
		Возврат;
	КонецЕсли;
	
	//Проерим наличие групп номеклатуры в регистре
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	CW_ШаблоныУслуг.Номенклатура КАК Номенклатура
		|ИЗ
		|	РегистрСведений.CW_ШаблоныУслуг КАК CW_ШаблоныУслуг
		|ГДЕ
		|	CW_ШаблоныУслуг.Номенклатура.ЭтоГруппа";
	
	РезультатЗапроса = Запрос.Выполнить();

	ЕстьГруппыНоменклатуры = Не РезультатЗапроса.Пустой(); 
	
	ТаблицаИерархии = Новый ТаблицаЗначений;
	ТаблицаИерархии.Колонки.Добавить("Элемент"	,	Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТаблицаИерархии.Колонки.Добавить("Родитель"	,	Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТаблицаИерархии.Колонки.Добавить("Уровень"	,	ОбщегоНазначения.ОписаниеТипаЧисло(10, 0));
	
	СписокНоменклатуры = Новый Массив;
	СписокНоменклатуры.Добавить(ПараметрыШаблона.Номенклатура);   

	//Подготовка данных для формирвоания запроса
	Если ЕстьГруппыНоменклатуры Тогда
		
		СоответствиеЭлементовИГрупп = ОбщегоНазначенияБПВызовСервера.ПолучитьСписокВышеСтоящихГруппЭлементов(СписокНоменклатуры);
		
		Для каждого Номенклатура Из СписокНоменклатуры Цикл
			
			НоваяСтрока = ТаблицаИерархии.Добавить();
			НоваяСтрока.Элемент		= Номенклатура;
			
			НоваяСтрока = ТаблицаИерархии.Добавить();
			НоваяСтрока.Элемент		= Номенклатура;
			НоваяСтрока.Родитель	= Номенклатура;
			
			СписокГрупп = СоответствиеЭлементовИГрупп.Получить(Номенклатура);
			Если СписокГрупп = Неопределено Тогда
				НоваяСтрока.Уровень = 1;
				Продолжить;
			КонецЕсли;
			
			КоличествоВышеСтоящихГрупп = СписокГрупп.Количество();
			
			НоваяСтрока.Уровень = КоличествоВышеСтоящихГрупп + 1;
			
			Для Индекс = 1 По КоличествоВышеСтоящихГрупп Цикл
				НоваяСтрока = ТаблицаИерархии.Добавить();
				НоваяСтрока.Элемент	= Номенклатура;
				НоваяСтрока.Родитель= СписокГрупп[Индекс - 1];
				НоваяСтрока.Уровень	= КоличествоВышеСтоящихГрупп - Индекс + 1;
			КонецЦикла;
			
		КонецЦикла;
		
	Иначе
		
		Для каждого Номенклатура Из СписокНоменклатуры Цикл
			
			НоваяСтрока = ТаблицаИерархии.Добавить();
			НоваяСтрока.Элемент		= Номенклатура;
			
			НоваяСтрока = ТаблицаИерархии.Добавить();
			НоваяСтрока.Элемент		= Номенклатура;
			НоваяСтрока.Родитель	= Номенклатура;
			НоваяСтрока.Уровень = 1;
			
		КонецЦикла;
		
	КонецЕсли;
	
	НоваяСтрока = ТаблицаИерархии.Добавить();	// Корень

	МассивНоменклатуры = ОбщегоНазначения.ВыгрузитьКолонку(ТаблицаИерархии, "Родитель", Истина);
	
	МассивДоговоров = Новый Массив;
	МассивДоговоров.Добавить(Справочники.CW_ДоговорыПоГрузоперевозкам.ПустаяСсылка());
	МассивДоговоров.Добавить(ПараметрыШаблона.Договор);
	
	МассивПриложений = Новый Массив;
	МассивПриложений.Добавить(Справочники.CW_ПриложенияКДоговорам.ПустаяСсылка());
	МассивПриложений.Добавить(ПараметрыШаблона.ПриложениеКДоговору);
	
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("МассивНоменклатуры",	МассивНоменклатуры);
	Запрос.УстановитьПараметр("МассивДоговоров",	МассивДоговоров);
	Запрос.УстановитьПараметр("МассивПриложений",	МассивПриложений);
	Запрос.УстановитьПараметр("ТаблицаИерархии",	ТаблицаИерархии);
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	ТаблицаИерархии.Элемент КАК Элемент,
	               |	ТаблицаИерархии.Родитель КАК Родитель,
	               |	ТаблицаИерархии.Уровень КАК Уровень
	               |ПОМЕСТИТЬ ВТТаблицаИерархии
	               |ИЗ
	               |	&ТаблицаИерархии КАК ТаблицаИерархии
	               |
	               |ИНДЕКСИРОВАТЬ ПО
	               |	Родитель
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ТаблицаИерархии.Элемент КАК Номенклатура,
	               |	ТаблицаИерархии.Родитель КАК Родитель,
	               |	ТаблицаИерархии.Уровень КАК Уровень,
	               |	CW_ШаблоныУслуг.Договор КАК Договор,
	               |	CW_ШаблоныУслуг.ПриложениеКДоговору КАК ПриложениеКДоговору,
	               |	CW_ШаблоныУслуг.Шаблон КАК Шаблон,
	               |	CW_ШаблоныУслуг.ШаблонАнглийский КАК ШаблонАнглийский
	               |ИЗ
	               |	ВТТаблицаИерархии КАК ТаблицаИерархии
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.CW_ШаблоныУслуг КАК CW_ШаблоныУслуг
	               |		ПО ТаблицаИерархии.Родитель = CW_ШаблоныУслуг.Номенклатура
	               |ГДЕ
				   |	//ОтборПоВидуСтатьи
	               |	И CW_ШаблоныУслуг.Номенклатура В(&МассивНоменклатуры)
	               |	И CW_ШаблоныУслуг.Договор В(&МассивДоговоров)
	               |	И CW_ШаблоныУслуг.ПриложениеКДоговору В(&МассивПриложений)
				   |
				   |УПОРЯДОЧИТЬ ПО
				   |	Уровень УБЫВ,
				   |	ПриложениеКДоговору УБЫВ,
				   |	Договор УБЫВ,
				   |	Номенклатура УБЫВ";
				   

	Если ПараметрыШаблона.ВидДоговора = ПредопределенноеЗначение("Перечисление.ВидыДоговоровКонтрагентов.СПокупателем") Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "//ОтборПоВидуСтатьи", "CW_ШаблоныУслуг.ДоходнаяСтатья = ИСТИНА");
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "//ОтборПоВидуСтатьи", "CW_ШаблоныУслуг.РасходнаяСтатья = ИСТИНА");
	КонецЕсли;
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ПредставлениеНоменклатуры = "";
	Если Не РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		Если Выборка.Следующий() Тогда
			
			Если ЯзыкПечатиДокументов = 0 Тогда //Русский
				ПредставлениеНоменклатуры = ОбработатьШаблонНоменклатуры(Выборка.Шаблон, ПараметрыШаблона.Объект, ТекущаяСтрока);
			ИначеЕсли ЯзыкПечатиДокументов = 1 Тогда //Английский
				ПредставлениеНоменклатуры = ОбработатьШаблонНоменклатуры(Выборка.ШаблонАнглийский, ПараметрыШаблона.Объект, ТекущаяСтрока);
			ИначеЕсли ЯзыкПечатиДокументов = 2 Тогда //Англо-русский
				ПредставлениеНоменклатурыНаРусском 		= ОбработатьШаблонНоменклатуры(Выборка.Шаблон, ПараметрыШаблона.Объект, ТекущаяСтрока);
				ПредставлениеНоменклатурыНаАнглийском 	= ОбработатьШаблонНоменклатуры(Выборка.ШаблонАнглийский, ПараметрыШаблона.Объект, ТекущаяСтрока);
				
				Если НЕ ПустаяСтрока(ПредставлениеНоменклатурыНаРусском) Тогда
					ПредставлениеНоменклатуры  = ПредставлениеНоменклатурыНаРусском;
					Если НЕ ПустаяСтрока(ПредставлениеНоменклатурыНаАнглийском) Тогда
						ПредставлениеНоменклатуры = ПредставлениеНоменклатуры + " / ";
					КонецЕсли;
				КонецЕсли;
				Если НЕ ПустаяСтрока(ПредставлениеНоменклатурыНаАнглийском) Тогда
					ПредставлениеНоменклатуры = ПредставлениеНоменклатуры + ПредставлениеНоменклатурыНаАнглийском;
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
	КонецЕсли;
	
	Если ПустаяСтрока(ПредставлениеНоменклатуры) Тогда
		ПредставлениеНоменклатуры = ПараметрыШаблона.Номенклатура.НаименованиеПолное;
	КонецЕсли;
	
	ТекущаяСтрока[ПараметрыШаблона.ИмяРеквизитаСтроки] = ПредставлениеНоменклатуры;

КонецПроцедуры

// Функция - Получить параметр шаблона услуг
// 
// Формирует и возвращает структуру парметров для формирования представления номенклатуры
//
// Возвращаемое значение:
//   - Структура параметров для формирования представления
//
Функция ПолучитьПараметрШаблонаУслуг() Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Номенклатура", 	Неопределено);
	Результат.Вставить("Объект", 		Неопределено);
	Результат.Вставить("Дата", 			Неопределено);
	Результат.Вставить("Договор", 		Неопределено);
	Результат.Вставить("ВидДоговора", 	Неопределено);
	Результат.Вставить("ПриложениеКДоговору", 	Неопределено);
	
	//определяются в процедуре назначения
	Результат.Вставить("ЯзыкПечатиДокументов",	Неопределено);
	Результат.Вставить("ИмяРеквизитаСтроки", 	"Представление");
	
	Возврат Результат;
	
КонецФункции


// Устарела. Вместо УстановитьПредставлениеНоменклатуры следует использовать процедуру: УстановитьПредставлениеНоменклатурыВСтроке
//
// Параметры:
//  СтрокаТЧ - 	 Строка табличной части, в реквизито которой будет установлено представление номенклатуры 
//  Договор	 - 	 Договор объекта. 
//  Объект	 - 	 Объект 
//  Язык	 - 	 Язык полцчения шаблона 
//
Процедура УстановитьПредставлениеНоменклатуры(СтрокаТЧ, Договор, Объект, Язык = Неопределено) Экспорт 
	
	// в переданной строке номенклатура не указана
	Если СтрокаТЧ.Номенклатура.Пустая() Тогда 
		СтрокаТЧ.Представление = "";
		Возврат; 
	КонецЕсли;
	
	Запрос = Новый Запрос;
	
	// сначала пытаемся найти шаблон номенклатуры в привязке к договору
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	CW_ШаблоныУслуг.Договор,
	               |	CW_ШаблоныУслуг.Шаблон,
				   |	CW_ШаблоныУслуг.ШаблонАнглийский
	               |ИЗ
	               |	РегистрСведений.CW_ШаблоныУслуг КАК CW_ШаблоныУслуг
	               |ГДЕ
	               |	CW_ШаблоныУслуг.Номенклатура = &Номенклатура
	               |	И CW_ШаблоныУслуг.Договор = &Договор
	               |	И ВЫБОР
	               |			КОГДА &ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровКонтрагентов.СПокупателем)
	               |				ТОГДА CW_ШаблоныУслуг.ДоходнаяСтатья = ИСТИНА
	               |			ИНАЧЕ CW_ШаблоныУслуг.РасходнаяСтатья = ИСТИНА
	               |		КОНЕЦ";
	Запрос.УстановитьПараметр("Номенклатура", СтрокаТЧ.Номенклатура);
	Запрос.УстановитьПараметр("ВидДоговора",Договор.ВидДоговора);
	Запрос.УстановитьПараметр("Договор", Договор);
	ТЗ = Запрос.Выполнить().Выгрузить();
	
	Если ТЗ.Количество() = 0 Тогда
		
		Запрос.УстановитьПараметр("Номенклатура", Справочники.Номенклатура.ПустаяСсылка());
		Запрос.УстановитьПараметр("Договор", Договор);
		ТЗ = Запрос.Выполнить().Выгрузить();
		
	КонецЕсли; 
	
	Если ТЗ.Количество() = 0 Тогда
		
		Запрос.УстановитьПараметр("Номенклатура", СтрокаТЧ.Номенклатура);
		Запрос.УстановитьПараметр("Договор", Справочники.CW_ДоговорыПоГрузоперевозкам.ПустаяСсылка());
		ТЗ = Запрос.Выполнить().Выгрузить();
		
	КонецЕсли; 
	
	Если ТЗ.Количество() = 0 Тогда
		
		Запрос2 = Новый Запрос;
		Запрос2.Текст =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	Номенклатура.Ссылка КАК Ссылка
			|ИЗ
			|	Справочник.Номенклатура КАК Номенклатура
			|ГДЕ
			|	Номенклатура.Ссылка = &Ссылка
			|ИТОГИ ПО
			|	Ссылка ТОЛЬКО ИЕРАРХИЯ";
		Запрос2.УстановитьПараметр("Ссылка", СтрокаТЧ.Номенклатура);
		ТЗИ = Запрос2.Выполнить().Выгрузить();
		
		Запрос3 = Новый Запрос;
		Запрос3.Текст =
			"ВЫБРАТЬ
			|	CW_ШаблоныУслуг.Шаблон
			|ИЗ
			|	РегистрСведений.CW_ШаблоныУслуг КАК CW_ШаблоныУслуг
			|ГДЕ
			|	CW_ШаблоныУслуг.Номенклатура В (&ТЗИ)
			|	И CW_ШаблоныУслуг.Номенклатура.ЭтоГруппа = ИСТИНА";
		Запрос3.УстановитьПараметр("ТЗИ", ТЗИ);
		ТЗШ = Запрос3.Выполнить().Выгрузить();
		
		Если ТЗШ.Количество() > 0 Тогда
			Стр = ТЗ.Добавить();
			Стр.Шаблон = ТЗШ[ТЗШ.Количество() - 1].Шаблон;
		КонецЕсли;	
		
	КонецЕсли;	
	
	Если ТЗ.Количество() = 0 Тогда
		
		Запрос.УстановитьПараметр("Номенклатура", Справочники.Номенклатура.ПустаяСсылка());
		Запрос.УстановитьПараметр("Договор", Справочники.CW_ДоговорыПоГрузоперевозкам.ПустаяСсылка());
		ТЗ = Запрос.Выполнить().Выгрузить();
		
	КонецЕсли; 	
	
	Если (ТЗ.Количество() <> 0) Тогда
		
		Если Язык = Неопределено Тогда
			
			СтруктураПараметров = CW_Настройки.ПустаяСтруктураПолученияПараметровДоговора();
			СтруктураПараметров.Дата	= Объект.Дата;
			СтруктураПараметров.Договор	= Договор;
			
			Если ОбщегоНазначения.ЕстьРеквизитОбъекта("ПриложениеКДоговору",Объект.Ссылка.Метаданные()) Тогда
				СтруктураПараметров.ПриложениеКДоговору = Объект.ПриложениеКДоговору;
			КонецЕсли;
			
			ПараметрыДоговора	= CW_Настройки.ПолучитьПараметрыДоговора(СтруктураПараметров, "ЯзыкПечатиДокументов");
			ПараметрыДоговора.Свойство("ЯзыкПечатиДокументов", Язык); 
			
		КонецЕсли;  	
		
		Если (Язык=Неопределено) Тогда
			СтрокаТЧ.Представление = "<для договора не указан язык печати документов>";
		ИначеЕсли (Язык=0) Тогда 
			СтрокаТЧ.Представление = ОбработатьШаблонНоменклатуры(ТЗ[0].Шаблон,Объект,СтрокаТЧ);
		ИначеЕсли (Язык=1) Тогда 
			СтрокаТЧ.Представление = ОбработатьШаблонНоменклатуры(ТЗ[0].ШаблонАнглийский,Объект,СтрокаТЧ);
		ИначеЕсли (Язык=2) Тогда 
			ТекстР = ОбработатьШаблонНоменклатуры(ТЗ[0].Шаблон,Объект,СтрокаТЧ);
			ТекстА = ОбработатьШаблонНоменклатуры(ТЗ[0].ШаблонАнглийский,Объект,СтрокаТЧ);
			стрПредставление = "";
			Если (СокрЛП(ТекстР)<>"") Тогда
				стрПредставление = ТекстР;
				Если (СокрЛП(ТекстА)<>"") Тогда
					_сф.стр_Добавить(стрПредставление," / ");
				КонецЕсли; 
			КонецЕсли; 
			_сф.стр_Добавить(стрПредставление,ТекстА);
			
			СтрокаТЧ.Представление = стрПредставление;
		КонецЕсли; 
		
		Возврат;
		
	Иначе
		
		СтрокаТЧ.Представление = СтрокаТЧ.Номенклатура.НаименованиеПолное;
		Возврат;
		
	КонецЕсли;
		
КонецПроцедуры

