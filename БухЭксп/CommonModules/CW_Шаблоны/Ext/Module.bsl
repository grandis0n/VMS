Функция ОбработатьШаблонНоменклатуры(Знач Шаблон, Объект, СтрокаТЧ = Неопределено, СтрокиТЧ = Неопределено) Экспорт 
	
	Если СтрокаТЧ = Неопределено Тогда
		СтрокаТЧ = _сф.к_ПервыйЭлемент(СтрокиТЧ);
	КонецЕсли; 
	Сборник = (СтрокиТЧ <> Неопределено);
	
	МассивГрузоперевозок = Новый Массив;
	
	Если СтрокиТЧ <> Неопределено Тогда
		Для Каждого СтрокаТаблицы из СтрокиТЧ Цикл  
			Если МассивГрузоперевозок.Найти(СтрокаТаблицы.Грузоперевозка) = Неопределено Тогда
				МассивГрузоперевозок.Добавить(СтрокаТаблицы.Грузоперевозка);	                 
			КонецЕсли;
		КонецЦикла;  
	Иначе
		МассивГрузоперевозок.Добавить(СтрокаТЧ.Грузоперевозка);	                 
	Конецесли; 
	
	ТаблицаПараметровГрузоперевозок = РегистрыСведений.CW_ХарактеристикиГрузоперевозок.ПолучитьТаблицуПараметровОбъекта(МассивГрузоперевозок);
	
	Попытка
		
		Текст = Шаблон;
		
		#Область Соответствия_реквизитов
		
		ХэшРеквизитов = Новый Соответствие;
		
		// Реквизит: путь относительно СтрокаТЧ   ДатаСделкиФ
		ХэшРеквизитов.Вставить("%Номенклатура%"			, Новый Структура("ВозможностьПеревода,Сборник,Источник,ОбъектПеревода,Реквизит"	,Истина	, Ложь		,"Строка"	,"Номенклатура"	 	,"Номенклатура.НаименованиеПолное"));
		ХэшРеквизитов.Вставить("%Грузоперевозка%"		, Новый Структура("ВозможностьПеревода,Сборник,Источник,Реквизит"					,Ложь	, Истина	,"Строка"						,"Грузоперевозка.CW_Представление"));
		ХэшРеквизитов.Вставить("%ДатаГрузопереовзки%"	, Новый Структура("ВозможностьПеревода,Сборник,Источник,Реквизит,ФорматнаяСтрока"	,Ложь	, Истина	,"Строка"						,"Грузоперевозка.ДатаСделкиФ" 		,"ДФ=dd.MM.yyyy"));
		
		ХэшРеквизитов.Вставить("%НомерГрузоперевозки%"	,Новый Структура("ВозможностьПеревода,Сборник,Источник,Реквизит"				,Ложь	,Истина	,"Строка","Грузоперевозка.Код"));
		ХэшРеквизитов.Вставить("%Заказ%"				,Новый Структура("ВозможностьПеревода,Сборник,Источник,Реквизит"				,Ложь	,Истина	,"Строка","Грузоперевозка.Заказ"));
		ХэшРеквизитов.Вставить("%ДатаЗаказа%"			,Новый Структура("ВозможностьПеревода,Сборник,Источник,Реквизит,ФорматнаяСтрока",Ложь	,Истина ,"Строка","Грузоперевозка.Заказ.ДатаСделкиФ","ДФ=dd.MM.yyyy"));
