			ЭлементОтбораСКД.ПравоеЗначение = Ложь;
			
			ЭлементОтбораСКД = ГруппаОтбора.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
			ЭлементОтбораСКД.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Ссылка."+Профиль.ИдентификаторАрхива.Идентификатор);
