Функция ПолучитьПараметрыКомплекта(КомплектПечатныхФорм) Экспорт
	
	Ответ = Новый Структура;   
	
	//Счета
	Отбор = Новый Структура;
	Отбор.Вставить("ВидДокументаКомплекта", ПредопределенноеЗначение("Перечисление.CW_ВидыДокументовКомплекта.Счет"));
	
	мСтроки = КомплектПечатныхФорм.СоставКомплекта.НайтиСтроки(Отбор);
	Ответ.Вставить("УказанаПечатнаяФормаСчета", мСтроки.Количество() > 0);
	
	//Реализации
	Отбор = Новый Структура;
	Отбор.Вставить("ВидДокументаКомплекта", ПредопределенноеЗначение("Перечисление.CW_ВидыДокументовКомплекта.Реализация"));
	
	мСтроки = КомплектПечатныхФорм.СоставКомплекта.НайтиСтроки(Отбор);
	Ответ.Вставить("УказанаПечатнаяФормаРеализации", мСтроки.Количество() > 0);
	
	//Отчет экспедитора
	Отбор = Новый Структура;
	Отбор.Вставить("ВидДокументаКомплекта", ПредопределенноеЗначение("Перечисление.CW_ВидыДокументовКомплекта.ОтчетЭкспедитора"));
	
	мСтроки = КомплектПечатныхФорм.СоставКомплекта.НайтиСтроки(Отбор);
	Ответ.Вставить("УказанаПечатнаяФормаОтчетаЭкспедитора", мСтроки.Количество() > 0);
	
	Возврат Ответ;
	
КонецФункции

Функция НужноПечатьФорму(Документ, ПечатнаяФорма, СоставКомплекта) Экспорт
	
	Если ТипЗнч(Документ) <> тип("ДокументСсылка.CW_ДоходыПоГрузоперевозке") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	НужноПечатать = Ложь;
	
	Если Документ.ФормируетсяСчет Тогда
		СтрокаКомплекта = СоставКомплекта.Найти(ПредопределенноеЗначение("Перечисление.CW_ВидыДокументовКомплекта.Счет"),"ВидДокументаКомплекта");
		Если СтрокаКомплекта <> Неопределено Тогда
			НавигационнаяСсылкаМакетаКомплекта = ПолучитьНавигационнуюСсылку(СтрокаКомплекта.ПодключаемыйОбъект);
			НужноПечатать =  НавигационнаяСсылкаМакетаКомплекта = ПечатнаяФорма.НавигационнаяСсылка;
		КонецЕсли;
	КонецЕсли; 
	
	Если Документ.ФормируетсяАкт или Документ.ФормируетсяСчетФактура Тогда
		СтрокаКомплекта = СоставКомплекта.Найти(ПредопределенноеЗначение("Перечисление.CW_ВидыДокументовКомплекта.Реализация"),"ВидДокументаКомплекта");
		Если СтрокаКомплекта <> Неопределено Тогда
			НавигационнаяСсылкаМакетаКомплекта = ПолучитьНавигационнуюСсылку(СтрокаКомплекта.ПодключаемыйОбъект);
			НужноПечатать =  НавигационнаяСсылкаМакетаКомплекта = ПечатнаяФорма.НавигационнаяСсылка;
		КонецЕсли;
	КонецЕсли;
	
	Возврат НужноПечатать;
	
КонецФункции

Функция ПроверитьЗадолженность(ВебПрофиль, КодЯзыка) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);

	СКД = Справочники.CW_ВебПрофили.ПолучитьМакет("ДебиторскаяЗадолженность");
	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	КомпоновщикНастроек = Новый КомпоновщикНастроекКомпоновкиДанных;
	КомпоновщикНастроек.ЗагрузитьНастройки(СКД.НастройкиПоУмолчанию);  
	
	Настройки 	= ВебПрофиль.НастройкиОтбораОтчетЗадоженность.Получить();
	Для Каждого ЭлементОтбораДС Из Настройки.Отбор.Элементы Цикл
		ЭлементОтбораСКД = КомпоновщикНастроек.Настройки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЗаполнитьЗначенияСвойств(ЭлементОтбораСКД, ЭлементОтбораДС);
	КонецЦикла;
	
   	МакетКомпоновки = КомпоновщикМакета.Выполнить(СКД, КомпоновщикНастроек.Настройки, , , Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	ПроцессорКомпоновкиДанных = Новый ПроцессорКомпоновкиДанных;    
	ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновки);

	ТРезультат	= Новый ТаблицаЗначений;    
	ПроцессорВыводаВТЗ = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;    
	ПроцессорВыводаВТЗ.УстановитьОбъект(ТРезультат);    
	ТРезультат = ПроцессорВыводаВТЗ.Вывести(ПроцессорКомпоновкиДанных);   
	
	Запрос = новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ТаблицаЗапроса.Валюта КАК Валюта,
	               |	ТаблицаЗапроса.Счет КАК Счет,
	               |	ТаблицаЗапроса.ПросроченноВалСумма КАК ПросроченноСумма
	               |ПОМЕСТИТЬ ВТ_Таблица
	               |ИЗ
	               |	&ТаблицаЗапроса КАК ТаблицаЗапроса
	               |ГДЕ
	               |	ТаблицаЗапроса.ПросроченноВалСумма > 0
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ_Таблица.Валюта КАК Валюта,
	               |	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВТ_Таблица.Счет) КАК Счет,
	               |	СУММА(ВТ_Таблица.ПросроченноСумма) КАК ПросроченноСумма
	               |ИЗ
	               |	ВТ_Таблица КАК ВТ_Таблица
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ВТ_Таблица.Валюта";
	
	Запрос.УстановитьПараметр("ТаблицаЗапроса", ТРезультат);  
	
	КодСостояния	= 200;
	ТекстОповещения = "";
	
	РезультатЗапроса 	= Запрос.Выполнить(); 
	Выборка = РезультатЗапроса.Выбрать();
	Если НЕ РезультатЗапроса.Пустой() Тогда 
		
		МассивСтрок_RU = Новый Массив;
		МассивСтрок_EN = Новый Массив;
		
		КодСостояния = 302; 
		
		МассивСтрок_RU.Добавить(Новый ФорматированнаяСтрока("Уважаемый клиент!", Новый Шрифт(,,Истина))); 
		МассивСтрок_RU.Добавить(Новый ФорматированнаяСтрока(Символы.ПС));
		МассивСтрок_RU.Добавить(Новый ФорматированнаяСтрока("Ваша компания имеет просроченную задолженность:"));
		МассивСтрок_RU.Добавить(Новый ФорматированнаяСтрока(Символы.ПС));
		
		МассивСтрок_EN.Добавить(Новый ФорматированнаяСтрока("Dear customer!", Новый Шрифт(,,Истина))); 
		МассивСтрок_EN.Добавить(Новый ФорматированнаяСтрока(Символы.ПС));
		МассивСтрок_EN.Добавить(Новый ФорматированнаяСтрока("Your company has overdue debt:"));
		МассивСтрок_EN.Добавить(Новый ФорматированнаяСтрока(Символы.ПС));
		
		ШаблонСтроки_RU = " - по %1 счетам(у) на сумму %2 %3";  
		ШаблонСтроки_EN = " - on %1 invoice(s) in the amount of %2 %3";			
		
		Пока Выборка.Следующий() Цикл   
			
			МассивСтрок_RU.Добавить(Новый ФорматированнаяСтрока(" - по "));
			МассивСтрок_RU.Добавить(Новый ФорматированнаяСтрока(СокрЛП(Выборка.Счет), Новый Шрифт(,,,,Истина))); 
			МассивСтрок_RU.Добавить(Новый ФорматированнаяСтрока(" счетам(у)", Новый Шрифт(,,,,Истина)));
			МассивСтрок_RU.Добавить(Новый ФорматированнаяСтрока(" на сумму "));
			МассивСтрок_RU.Добавить(Новый ФорматированнаяСтрока(Формат(Выборка.ПросроченноСумма,"ЧДЦ=2"), Новый Шрифт(,,Истина))); 
			МассивСтрок_RU.Добавить(Новый ФорматированнаяСтрока(" " + СокрЛП(Выборка.Валюта), Новый Шрифт(,,Истина))); 
			МассивСтрок_RU.Добавить(Новый ФорматированнаяСтрока(Символы.ПС));
			
			МассивСтрок_EN.Добавить(Новый ФорматированнаяСтрока("- on "));
			МассивСтрок_EN.Добавить(Новый ФорматированнаяСтрока(СокрЛП(Выборка.Счет), Новый Шрифт(,,,,Истина))); 
			МассивСтрок_EN.Добавить(Новый ФорматированнаяСтрока(" invoice(s)", Новый Шрифт(,,,,Истина))); 
			МассивСтрок_EN.Добавить(Новый ФорматированнаяСтрока(" in the amount of ")); 
			МассивСтрок_EN.Добавить(Новый ФорматированнаяСтрока(Формат(Выборка.ПросроченноСумма,"Л=en; ЧДЦ=2"), Новый Шрифт(,,Истина))); 
			МассивСтрок_EN.Добавить(Новый ФорматированнаяСтрока(" " + СокрЛП(Выборка.Валюта), Новый Шрифт(,,Истина))); 
			МассивСтрок_EN.Добавить(Новый ФорматированнаяСтрока(Символы.ПС));

		КонецЦикла;  
		
		МассивСтрок_RU.Добавить(Новый ФорматированнаяСтрока(Символы.ПС));
		МассивСтрок_RU.Добавить(Новый ФорматированнаяСтрока("Более подробную информацию о сумме долга Вы можете найти в разделе ""Отчеты"".", Новый Шрифт(,,Истина)));

		МассивСтрок_EN.Добавить(Новый ФорматированнаяСтрока(Символы.ПС));
		МассивСтрок_EN.Добавить(Новый ФорматированнаяСтрока("You can you can find more detailed information about the amount of debt in the ""Reports"" section.", Новый Шрифт(,,Истина)));
		
		СтруктураОповещения = Новый Структура;
		СтруктураОповещения.Вставить("ru", МассивСтрок_RU);
		СтруктураОповещения.Вставить("en", МассивСтрок_EN);
		
		МассивСтрок = СтруктураОповещения[НРег(КодЯзыка)]; 
		ФорматированнаяСтрока = новый ФорматированнаяСтрока(МассивСтрок);

		ФорматированныйДокумент = Новый ФорматированныйДокумент;
		ФорматированныйДокумент.УстановитьФорматированнуюСтроку(ФорматированнаяСтрока); 
		
		ФорматированныйДокумент.ПолучитьHTML(ТекстОповещения,  Новый Структура);

	КонецЕсли;  
	
	Результат = Новый Структура;
	Результат.Вставить("КодСостояния",		КодСостояния);
	Результат.Вставить("ТекстОповещения",	ТекстОповещения);
	
	Возврат Результат;

КонецФункции

 
Функция ПолучитьТаблицуДокументов(ОсновнойПрофиль, ДатаНачала, ДатаОкончания, ПараметрыКомплекта) Экспорт
	
	СКД = Справочники.CW_ВебПрофили.ПолучитьМакет("СхемаОтбораДокументов");
	
	Настройки = ОсновнойПрофиль.НастройкиОтбораДокументов.Получить();
	
	ТаблицаЗначений = Новый ТаблицаЗначений;    
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;    
	ПроцессорВывода.УстановитьОбъект(ТаблицаЗначений);    
	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	КомпоновщикНастроек = Новый КомпоновщикНастроекКомпоновкиДанных;
	КомпоновщикНастроек.ЗагрузитьНастройки(СКД.НастройкиПоУмолчанию); 
	
	Для Каждого КлючЗначение из ПараметрыКомплекта Цикл
		КомпоновщикНастроек.Настройки.ПараметрыДанных.УстановитьЗначениеПараметра(КлючЗначение.Ключ, КлючЗначение.Значение);
	КонецЦикла;   
	
	КомпоновщикНастроек.Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("ДатаНачала", 	ДатаНачала);
	КомпоновщикНастроек.Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("ДатаОкончания", 	ДатаОкончания);
	
	Если Настройки <> Неопределено Тогда
		Для Каждого ЭлементОтбораДС Из Настройки.Отбор.Элементы Цикл
			ЭлементОтбора = КомпоновщикНастроек.Настройки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
			ЗаполнитьЗначенияСвойств(ЭлементОтбора, ЭлементОтбораДС);
		КонецЦикла;
	КонецЕсли;

	МакетКомпоновки = КомпоновщикМакета.Выполнить(СКД, КомпоновщикНастроек.Настройки, , , Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	ПроцессорКомпоновкиДанных = Новый ПроцессорКомпоновкиДанных;    
	ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновки);

	ТаблицаДокументов = ПроцессорВывода.Вывести(ПроцессорКомпоновкиДанных);
	
	Возврат ТаблицаДокументов;
	
КонецФункции  

Функция ПолучитьДанныеОтчетаПоЗадолженности(ВебПрофиль, КлючВарианта = "") Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	СКД = Отчеты.CW_ЛичныйКабинетДебиторскаЗадолженность.ПолучитьМакет("ОсновнаяСхемаКомпоновкиДанных");
	
	Если Не ПустаяСтрока(КлючВарианта) Тогда
		ВариантОтчета = Справочники.ВариантыОтчетов.НайтиПоРеквизиту("КлючВарианта", КлючВарианта);
	КонецЕсли;
	
	КомпоновщикНастроек = Новый КомпоновщикНастроекКомпоновкиДанных;
	
	Если ЗначениеЗаполнено(ВариантОтчета) Тогда    
		НастройкиВариантаОтчета = ВариантОтчета.Настройки.Получить();
		КомпоновщикНастроек.ЗагрузитьНастройки(НастройкиВариантаОтчета);
	Иначе
		КомпоновщикНастроек.ЗагрузитьНастройки(СКД.НастройкиПоУмолчанию); 
	КонецЕсли;
	
	НастройкиОтбораПрофиля 	= ВебПрофиль.НастройкиОтбораОтчетЗадоженность.Получить();
	Для Каждого ЭлементОтбораПрофиля Из НастройкиОтбораПрофиля.Отбор.Элементы Цикл
		ЭлементОтбораОтчета = КомпоновщикНастроек.Настройки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЗаполнитьЗначенияСвойств(ЭлементОтбораОтчета, ЭлементОтбораПрофиля);
	КонецЦикла;        
	
	ДанныеРасшифровки 	= Новый ДанныеРасшифровкиКомпоновкиДанных;

	КомпоновщикМакета 	= Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СКД, КомпоновщикНастроек.Настройки, ДанныеРасшифровки);
	ПроцессорКомпоновкиДанных = Новый ПроцессорКомпоновкиДанных;    
	ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновки,,ДанныеРасшифровки);
	
	ТабличныйДокумент	= Новый ТабличныйДокумент;    
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;    
	ПроцессорВывода.УстановитьДокумент(ТабличныйДокумент);
	ПроцессорВывода.Вывести(ПроцессорКомпоновкиДанных); 
	
	//Обработка расшифровку для передачи в ЛКК   
	Расшифровка = ОбработатьРезультатРасшифровки(ДанныеРасшифровки, "Счет");
	
	ДанныеОтчета = Новый Структура;
	ДанныеОтчета.Вставить("Результат",		ТабличныйДокумент);
	ДанныеОтчета.Вставить("Расшифровка",	Расшифровка);
	
	Возврат ДанныеОтчета;

КонецФункции

Функция ОбработатьРезультатРасшифровки(Знач ДанныеРасшифровки, Поля="")
	
	Расшифровка = Новый Соответствие;
	Для Каждого ЭлементРасшифровки из ДанныеРасшифровки.Элементы Цикл
		Если ТипЗнч(ЭлементРасшифровки) <> Тип("ЭлементРасшифровкиКомпоновкиДанныхПоля") Тогда
			Продолжить;
		КонецЕсли;
		Если ЭлементРасшифровки.ОсновноеДействие <> ДействиеОбработкиРасшифровкиКомпоновкиДанных.ОткрытьЗначение Тогда 
			Продолжить;
		КонецЕсли;   
		
		ТекущееЗначение = Неопределено;
		ПервоеПоле = ЭлементРасшифровки.ПолучитьПоля()[0]; 
		Если ПустаяСтрока(Поля) Тогда 
			ТекущееЗначение = XMLСтрока(ПервоеПоле.Значение); 
		ИначеЕсли СтрНайти(Поля, ПервоеПоле.Поле) > 0 Тогда 
			ТекущееЗначение = XMLСтрока(ПервоеПоле.Значение); 
		КонецЕсли;
		
		Если ТекущееЗначение <> Неопределено Тогда
			Расшифровка.Вставить(ЭлементРасшифровки.Идентификатор, ТекущееЗначение); 
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Расшифровка;

КонецФункции      

Функция ПолучитьТаблицуГрузоперевозок(ВебПрофиль, Вариант) Экспорт
	
	УбратьСсылкуНаГП = Ложь;
	
	СКД = Справочники.CW_ВебПрофили.ПолучитьМакет("СхемаПараметров");
	
	Настройки = ВебПрофиль.НастройкиОсновногоОтбора.Получить();
	НастройкиКомпоновкиДанных     = СКД.НастройкиПоУмолчанию;
	
	Таб = Новый ТаблицаЗначений;    
	ПроцессорВыводаВТЗ = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;    
	ПроцессорВыводаВТЗ.УстановитьОбъект(Таб);    
	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	КомпоновщикНастроек = Новый КомпоновщикНастроекКомпоновкиДанных;
	КомпоновщикНастроек.ЗагрузитьНастройки(СКД.НастройкиПоУмолчанию);   
	
	ВыводитьФинансовыеДокументы = ВебПрофиль.ОсновнойПрофиль.ВыводитьФинансовыеДокументы; 
	
	КомпоновщикНастроек.Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("ТребуютсяДокументы", ВыводитьФинансовыеДокументы);
	КомпоновщикНастроек.Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("ТребуютсяФайлы", 	ВебПрофиль.ВыгружатьФайлы);

	КомпоновщикНастроек.Настройки.Выбор.Элементы.Очистить();
	
	Для Каждого Стр Из ВебПрофиль.СтруктураПрофиля Цикл
		НовоеПоле = КомпоновщикНастроек.Настройки.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
		НовоеПоле.Заголовок = Стр.Заголовок;
		НовоеПоле.Поле = Новый ПолеКомпоновкиДанных(Стр.СтрокаПоляКомпоновки);
		НовоеПоле.Использование = Истина;
	КонецЦикла;
	
	СсылкаНаГП =  ВебПрофиль.СтруктураПрофиля.Найти("Ссылка","СтрокаПоляКомпоновки");
	Если СсылкаНаГП = Неопределено Тогда
		НовоеПоле = КомпоновщикНастроек.Настройки.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
		НовоеПоле.Поле = Новый ПолеКомпоновкиДанных("Ссылка");
		НовоеПоле.Использование = Истина;
		УбратьСсылкуНаГП = Истина;		
	КонецЕсли;
	
	НовоеПоле = КомпоновщикНастроек.Настройки.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
	НовоеПоле.Поле = Новый ПолеКомпоновкиДанных("ЕстьФайлы");
	НовоеПоле.Использование = Истина;
	
	НовоеПоле = КомпоновщикНастроек.Настройки.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
	НовоеПоле.Поле = Новый ПолеКомпоновкиДанных("ЕстьДокументы");
	НовоеПоле.Использование = Истина;
	
	мТипыДокументов = ВебПрофиль.ТипыФайлов.ВыгрузитьКолонку("Тип");
	
	Если мТипыДокументов.Количество() > 0 Тогда
		СписокТипыДокументов = Новый СписокЗначений;
		СписокТипыДокументов.ЗагрузитьЗначения(мТипыДокументов);
		
		КомпоновщикНастроек.Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("ТипыДокументов", СписокТипыДокументов);
		КомпоновщикНастроек.Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("ЕстьОграниченияПоТипуДокументов", Истина);
	КонецЕсли;
	
	Если Настройки <> Неопределено Тогда
		_УФС.СкопироватьОтбор(Настройки.Отбор, КомпоновщикНастроек.Настройки.Отбор);	
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ВебПрофиль.ИдентификаторАрхивныхГрузоперевозок) Тогда 
		Если Вариант = 0 Тогда 
			ГруппаОтбора = КомпоновщикНастроек.Настройки.Отбор.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
			ГруппаОтбора.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИли;
			ГруппаОтбора.Использование = Истина;
			
			ЭлементОтбораСКД = ГруппаОтбора.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
			ЭлементОтбораСКД.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Ссылка."+ВебПрофиль.ИдентификаторАрхивныхГрузоперевозок.Идентификатор);
			ЭлементОтбораСКД.ВидСравнения = ВидСравненияКомпоновкиДанных.НеРавно;
			ЭлементОтбораСКД.ПравоеЗначение = Истина;   
			
			ЭлементОтбораСКД = ГруппаОтбора.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
			ЭлементОтбораСКД.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Ссылка."+ВебПрофиль.ИдентификаторАрхивныхГрузоперевозок.Идентификатор);
			ЭлементОтбораСКД.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено;
			
		ИначеЕсли Вариант = 1 Тогда   
			ЭлементОтбораСКД = КомпоновщикНастроек.Настройки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
			ЭлементОтбораСКД.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Ссылка."+ВебПрофиль.ИдентификаторАрхивныхГрузоперевозок.Идентификатор);
			ЭлементОтбораСКД.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
			ЭлементОтбораСКД.ПравоеЗначение = Истина;   
		КонецЕсли;
	КонецЕсли;
	
	//Сортировка
	Если ВебПрофиль.ПоляСортировки.Количество() > 0 Тогда
		Для Каждого СтрокаПорядка из  ВебПрофиль.ПоляСортировки Цикл
			ЭлементПорядка = КомпоновщикНастроек.Настройки.Порядок.Элементы.Добавить(Тип("ЭлементПорядкаКомпоновкиДанных"));
			ЭлементПорядка.Поле = Новый ПолеКомпоновкиДанных(СтрокаПорядка.СтрокаПоляКомпоновки); 
			ЭлементПорядка.Использование = истина;
			Если СтрокаПорядка.Сортировка = ПредопределенноеЗначение("Перечисление.CW_ПорядокСортировки.ПоВозрастанию") Тогда
				ЭлементПорядка.ТипУпорядочивания = НаправлениеСортировкиКомпоновкиДанных.Возр;
			Иначе
				ЭлементПорядка.ТипУпорядочивания = НаправлениеСортировкиКомпоновкиДанных.Убыв;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	//Сортировка
	
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СКД,КомпоновщикНастроек.Настройки, , , Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	ПроцессорКомпоновкиДанных = Новый ПроцессорКомпоновкиДанных;    
	ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновки);
	Таб = ПроцессорВыводаВТЗ.Вывести(ПроцессорКомпоновкиДанных);
	
	Возврат Таб;
	
КонецФункции
 
Функция ПолучитьТаблицуЗаявок(Знач Профиль, Знач ШаблонПрофиля, Знач СтатусЗаявок, Знач Язык="RU", СкрытьПолеСсылка) Экспорт
	
	СКД = ПолучитьОбщийМакет("CW_ЗаявкиСхемаПараметров");
	
	НастройкиОсновногоОтбора  = Профиль.НастройкиОсновногоОтбора.Получить();
	НастройкиКомпоновкиДанных = СКД.НастройкиПоУмолчанию;  
	
	КомпоновщикНастроек = Новый КомпоновщикНастроекКомпоновкиДанных;
	КомпоновщикНастроек.ЗагрузитьНастройки(СКД.НастройкиПоУмолчанию);   
	
	//Формирование колонок таблицы  
	ДобавитьПолеСсылка = Истина;
	КомпоновщикНастроек.Настройки.Выбор.Элементы.Очистить();    
	Для Каждого СтрокаТаблицы Из ШаблонПрофиля.СтруктураПрофиля Цикл
		НовоеПоле = КомпоновщикНастроек.Настройки.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
		НовоеПоле.Использование = Истина;
		НовоеПоле.Поле 			= Новый ПолеКомпоновкиДанных(СтрокаТаблицы.СтрокаПоляКомпоновки);    
		НовоеПоле.Заголовок 	= НСтр("ru='"+СтрокаТаблицы.ЗаголовокRU+"';en='"+СтрокаТаблицы.ЗаголовокEN+"'", Язык);
		
		Если СтрокаТаблицы.СтрокаПоляКомпоновки = "Ссылка" Тогда
			ДобавитьПолеСсылка 	= Ложь; 
			СкрытьПолеСсылка 	= Истина;
		КонецЕсли;
	КонецЦикла;  
	
	Если ДобавитьПолеСсылка Тогда
		НовоеПоле = КомпоновщикНастроек.Настройки.Выбор.Элементы.Вставить(0, Тип("ВыбранноеПолеКомпоновкиДанных"));
		НовоеПоле.Использование = Истина;
		НовоеПоле.Поле = Новый ПолеКомпоновкиДанных("Ссылка");
		НовоеПоле.Заголовок 	= НСтр("ru='Заявка';en='Request'", Язык);
	КонецЕсли;
	
	Если Профиль.ВыгружатьФайлы Тогда
		НовоеПоле = КомпоновщикНастроек.Настройки.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
		НовоеПоле.Поле 			= Новый ПолеКомпоновкиДанных("ЕстьФайлы");
		НовоеПоле.Использование = Истина;
	КонецЕсли;  
	//Формирование колонок таблицы 
	
	//Параметры данных   
	КомпоновщикНастроек.Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("ТребуютсяФайлы", Профиль.ВыгружатьФайлы);
	
	мТипыДокументов = Профиль.ТипыФайлов.ВыгрузитьКолонку("Тип");
	Если мТипыДокументов.Количество() > 0 Тогда
		СписокТипыДокументов = Новый СписокЗначений;
		СписокТипыДокументов.ЗагрузитьЗначения(мТипыДокументов);
		
		КомпоновщикНастроек.Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("ТипыДокументов", СписокТипыДокументов);
		КомпоновщикНастроек.Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("ЕстьОграниченияПоТипуДокументов", Истина);
	КонецЕсли;
	//Параметры данных
	
	//Отбор  
	Если НастройкиОсновногоОтбора <> Неопределено Тогда
		_УФС.СкопироватьОтбор(НастройкиОсновногоОтбора.Отбор, КомпоновщикНастроек.Настройки.Отбор);	
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Профиль.ИдентификаторАрхива) Тогда
		Если СтатусЗаявок = 0 Тогда //Открытые
			ГруппаОтбора = КомпоновщикНастроек.Настройки.Отбор.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
			ГруппаОтбора.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИли;
			ГруппаОтбора.Использование = Истина;
			
			ЭлементОтбораСКД = ГруппаОтбора.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
			ЭлементОтбораСКД.ЛевоеЗначение 	= Новый ПолеКомпоновкиДанных("Ссылка."+Профиль.ИдентификаторАрхива.Идентификатор);
			ЭлементОтбораСКД.ВидСравнения 	= ВидСравненияКомпоновкиДанных.Равно;
			ЭлементОтбораСКД.ПравоеЗначение = Ложь;
			
			ЭлементОтбораСКД = ГруппаОтбора.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
			ЭлементОтбораСКД.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Ссылка."+Профиль.ИдентификаторАрхива.Идентификатор);
			ЭлементОтбораСКД.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено;
		КонецЕсли;
		
		Если СтатусЗаявок = 1 Тогда //в архиве
			ЭлементОтбораСКД = КомпоновщикНастроек.Настройки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
			ЭлементОтбораСКД.ЛевоеЗначение 	= Новый ПолеКомпоновкиДанных("Ссылка."+Профиль.ИдентификаторАрхива.Идентификатор);
			ЭлементОтбораСКД.ВидСравнения 	= ВидСравненияКомпоновкиДанных.Равно;
			ЭлементОтбораСКД.ПравоеЗначение = Истина;
		КонецЕсли;   
	КонецЕсли;
	//Отбор  
	
	//Сортировка
	Если ШаблонПрофиля.ПоляСортировки.Количество() > 0 Тогда 
		
		Для Каждого СтрокаПорядка из ШаблонПрофиля.ПоляСортировки Цикл 
			ТипУпорядочивания = НаправлениеСортировкиКомпоновкиДанных.Возр;
			Если СтрокаПорядка.Сортировка = ПредопределенноеЗначение("Перечисление.CW_ПорядокСортировки.ПоУбыванию") Тогда
				ТипУпорядочивания = НаправлениеСортировкиКомпоновкиДанных.Убыв;
			КонецЕсли; 
			
			ЭлементПорядка	= КомпоновщикНастроек.Настройки.Порядок.Элементы.Добавить(Тип("ЭлементПорядкаКомпоновкиДанных"));
			ЭлементПорядка.Поле 			= Новый ПолеКомпоновкиДанных(СтрокаПорядка.СтрокаПоляКомпоновки); 
			ЭлементПорядка.Использование 	= Истина;   
			ЭлементПорядка.ТипУпорядочивания = ТипУпорядочивания;
		КонецЦикла;  
		
	КонецЕсли;
	//Сортировка          

	КомпоновщикМакета 	= Новый КомпоновщикМакетаКомпоновкиДанных;
 	МакетКомпоновки 	= КомпоновщикМакета.Выполнить(СКД, КомпоновщикНастроек.Настройки, , , Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));

	ТаблицаЗначений = Новый ТаблицаЗначений;    

	ПроцессорКомпоновкиДанных 	= Новый ПроцессорКомпоновкиДанных;    
	ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновки);
	
	ПроцессорВыводаРезультата 	= Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;    
	ПроцессорВыводаРезультата.УстановитьОбъект(ТаблицаЗначений); 
	ПроцессорВыводаРезультата.Вывести(ПроцессорКомпоновкиДанных);
	
	Возврат ТаблицаЗначений;
	
КонецФункции

