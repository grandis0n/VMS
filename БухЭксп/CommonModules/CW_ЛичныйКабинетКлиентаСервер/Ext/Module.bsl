
// Заполняет основные сведения о библиотеке или основной конфигурации.
// 
// Параметры:
//  Описание - Структура:
//
//   * Имя                 - Строка - имя подсисетмы, например, "CW_БухгалтерияЭкспедитора".
//   * Версия              - Строка - версия в формате из 4-х цифр, например, "2.1.3.1".
//
Процедура ПриДобавленииПодсистем(ОписаниеПодсистем) Экспорт

	ОписаниеПодсистем.Вставить("CW_ЛичныйКабинетКлиента", "8.3.7.9");

КонецПроцедуры    

// Процедура - При создании на сервере
//  ВЫзывается при создании формы рабочего стола
//
Процедура ПриСозданииНаСервере(Форма, Отказ, СтандартнаяОбработка) Экспорт
	
	Форма.ИспользуетсяЛичныйКабинет = ПолучитьФункциональнуюОпцию("CW_ЛичныйКабинетИспользуется");
	Если Форма.ИспользуетсяЛичныйКабинет Тогда
		CW_ОбщийМодульЛичныйКабинетСервер.СоздатьОбновитьПользователяЛичногоКабинета();
	КонецЕсли;

	ГруппаПользователя = CW_ПраваДоступа_ПИ.ГруппаПользователя(ПараметрыСеанса.ТекущийПользователь);
	
	ПараметрыОпции = Новый Структура;
	ПараметрыОпции.Вставить("CW_ГруппаПользователя", ГруппаПользователя); 
	ЛичныйКабинетУправлениеПрофилями = ПолучитьФункциональнуюОпцию("CW_ЛичныйКабинетУправлениеПрофилямиДоступа", ПараметрыОпции);
	
	Форма.Элементы.СтраницаЛичныйКабинет.Видимость = Форма.ИспользуетсяЛичныйКабинет и ЛичныйКабинетУправлениеПрофилями;
	
КонецПроцедуры        

Функция ПолучитьДанныеПользователя(ИмяПользователя) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	CW_ВебПользователиЛКК.Ссылка КАК Пользователь,
	               |	CW_ВебПользователиЛКК.ВыгружатьПечатныеФормы КАК ВыгружатьПечатныеФормы,
	               |	CW_ВебПользователиЛКК.ВыгружатьФайлы КАК ВыгружатьФайлы,
	               |	CW_ВебПользователиЛКК.Язык КАК Язык
	               |ИЗ
	               |	Справочник.CW_ВебПользователиЛКК КАК CW_ВебПользователиЛКК
	               |ГДЕ
	               |	CW_ВебПользователиЛКК.ЭлектроннаяПочта = &ИмяПользователя";
	
	Запрос.УстановитьПараметр("ИмяПользователя", ИмяПользователя);
	РезультатЗапроса = Запрос.Выполнить();   
	
	Выборка = РезультатЗапроса.Выбрать();
	Если Выборка.Следующий() Тогда  
		ДанныеПользователя = Новый Структура;
		ДанныеПользователя.Вставить("Пользователь", 			Выборка.Пользователь);
		ДанныеПользователя.Вставить("ВыгружатьФайлы", 			Выборка.ВыгружатьФайлы);
		ДанныеПользователя.Вставить("ВыгружатьПечатныеФормы", 	Выборка.ВыгружатьПечатныеФормы);
		ДанныеПользователя.Вставить("Язык", 					Выборка.Язык);
		Возврат ДанныеПользователя;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции 

Функция ПолучитьПрофилиПользователя(ДанныеПользователя, ОсновнойПрофиль=Неопределено, Раздел) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	CW_ПользователиВебПрофилей.Пользователь КАК Пользователь,
	               |	CW_ПользователиВебПрофилей.ОсновнойПрофиль КАК ОсновнойПрофиль,
	               |	CW_ПользователиВебПрофилей.ВебПрофиль КАК ВебПрофиль,
	               |	CW_ПользователиВебПрофилей.Основной КАК Основной,
	               |	CW_ПользователиВебПрофилей.ВебПрофиль.ПредставлениеRU КАК ПредставлениеRU,
	               |	CW_ПользователиВебПрофилей.ВебПрофиль.ПредставлениеEN КАК ПредставлениеEN,
	               |	CW_ПользователиВебПрофилей.ВебПрофиль.ВыгружатьФайлы КАК ВыгружатьФайлы,
	               |	CW_ПользователиВебПрофилей.ВебПрофиль.РазрешеноПрикреплятьФайлы КАК РазрешеноПрикреплятьФайлы,
	               |	CW_ПользователиВебПрофилей.ОсновнойПрофиль.ДоступноСозданиеЗавок КАК ДоступноСозданиеЗавок
	               |ИЗ
				   |	РегистрСведений.CW_ПользователиВебПрофилей КАК CW_ПользователиВебПрофилей
				   |ГДЕ
				   |	CW_ПользователиВебПрофилей.Раздел = &Раздел
				   |	И CW_ПользователиВебПрофилей.Пользователь = &Пользователь
				   |	И CW_ПользователиВебПрофилей.ВебПрофиль.Активный = ИСТИНА
				   |	//Условие_ОсновнойПрофиль 
				   |
				   |УПОРЯДОЧИТЬ ПО
	               |	Основной УБЫВ"; 
	
	Запрос.УстановитьПараметр("ОсновнойПрофиль",	ОсновнойПрофиль);
	Запрос.УстановитьПараметр("Раздел", 			Раздел);
	Запрос.УстановитьПараметр("Пользователь", 		ДанныеПользователя.Пользователь);  
	
	Если ЗначениеЗаполнено(ОсновнойПрофиль) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "//Условие_ОсновнойПрофиль", "И CW_ПользователиВебПрофилей.ОсновнойПрофиль = &ОсновнойПрофиль");	
	КонецЕсли;
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Функция ПолучитьПараметрыПрофиляПользователя(ДанныеПользователя) Экспорт
	
	ПараметрыПрофиля = Новый Структура("ДоступенМониторинг, ДоступенЗаявки, ДоступенДокументы, ДоступенОтчеты, УведомлятьОЗадолженности", Ложь, Ложь,Ложь,Ложь,Ложь);
	
	Запрос = новый Запрос;   
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос.УстановитьПараметр("Пользователь", ДанныеПользователя.Пользователь);  
	
	Запрос.Текст = "ВЫБРАТЬ 
	|	CW_ПользователиВебПрофилей.ВебПрофиль КАК ВебПрофиль,
	|	CW_ПользователиВебПрофилей.ВебПрофиль.Владелец КАК ОсновнойПрофиль,
	|	CW_ПользователиВебПрофилей.Раздел КАК Раздел
	|ПОМЕСТИТЬ ВТ_ДоступныеПрофили
	|ИЗ
	|	РегистрСведений.CW_ПользователиВебПрофилей КАК CW_ПользователиВебПрофилей
	|ГДЕ
	|	CW_ПользователиВебПрофилей.Пользователь = &Пользователь
	|	И CW_ПользователиВебПрофилей.ВебПрофиль.Активный = ИСТИНА"; 
	
	Запрос.Выполнить();
	
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	|	ВТ_ДоступныеПрофили.ВебПрофиль КАК ВебПрофиль,
	|	ВТ_ДоступныеПрофили.ОсновнойПрофиль КАК ОсновнойПрофиль,
	|	ВТ_ДоступныеПрофили.Раздел КАК Раздел
	|ИЗ
	|	ВТ_ДоступныеПрофили КАК ВТ_ДоступныеПрофили
	|ГДЕ
	|	ВТ_ДоступныеПрофили.Раздел = ""ГРУЗОПЕРЕВОЗКИ""";

	РезультатЗапроса = Запрос.Выполнить();     
	ПараметрыПрофиля.Вставить("ДоступенМониторинг", НЕ РезультатЗапроса.Пустой());
	
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	|	ВТ_ДоступныеПрофили.ВебПрофиль КАК ВебПрофиль,
	|	ВТ_ДоступныеПрофили.ОсновнойПрофиль КАК ОсновнойПрофиль,
	|	ВТ_ДоступныеПрофили.Раздел КАК Раздел
	|ИЗ
	|	ВТ_ДоступныеПрофили КАК ВТ_ДоступныеПрофили
	|ГДЕ
	|	ВТ_ДоступныеПрофили.Раздел = ""ЗАЯВКИ""";
	
	РезультатЗапроса = Запрос.Выполнить();     
	ПараметрыПрофиля.Вставить("ДоступенЗаявки", НЕ РезультатЗапроса.Пустой());
	
	
	Запрос.Текст = "ВЫБРАТЬ
	|	МАКСИМУМ(CW_ВебПрофили.ВыводитьФинансовыеДокументы) КАК ДоступныхДокументы,
	|	МАКСИМУМ(CW_ВебПрофили.ВыводитьЗадолженность) КАК ДоступныОтчеты,
	|	МАКСИМУМ(CW_ВебПрофили.УведомлятьОЗадолженности) КАК УведомлятьОЗадолженности
	|ИЗ
	|	РегистрСведений.CW_ДоступныеПользователи КАК CW_ДоступныеПользователи
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.CW_ВебПрофили КАК CW_ВебПрофили
	|		ПО CW_ДоступныеПользователи.ВебПрофиль = CW_ВебПрофили.Ссылка
	|ГДЕ
	|	CW_ДоступныеПользователи.Пользователь = &Пользователь";   
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка	 = РезультатЗапроса.Выбрать();
	Если Выборка.Следующий() Тогда 
		ЗаполнитьЗначенияСвойств(ПараметрыПрофиля, Выборка);
	КонецЕсли; 
	
	Возврат ПараметрыПрофиля;
	
КонецФункции

Процедура ПолучитьОсновыеПрофилиПользователя(Пользователь, МассивПрофилей)   Экспорт

	Запрос = новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	CW_ДоступныеПользователи.ВебПрофиль КАК ВебПрофиль,
	               |	CW_ДоступныеПользователи.Пользователь КАК Пользователь
	               |ИЗ
	               |	РегистрСведений.CW_ДоступныеПользователи КАК CW_ДоступныеПользователи
	               |ГДЕ
	               |	CW_ДоступныеПользователи.Пользователь = &Пользователь";  
	
	Запрос.УстановитьПараметр("Пользователь", Пользователь);
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		  МассивПрофилей.Добавить(Выборка.ВебПрофиль);
	КонецЦикла;
	
КонецПроцедуры  

Функция ПолучитьДанныеПрофиляГрузоперевозок(Профиль) ЭКспорт
	
	ДанныеПрофиля = Новый Структура("Ссылка,ПредставлениеНаРусском,ПредставлениеНаАнглийском,ВыгружатьФайлы,ВыводитьФинансовыеДокументы,ВыводитьЗадолженность,УведомлятьОЗадолженности");
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	CW_ВебПрофили.Ссылка КАК Ссылка,
	               |	CW_ВебПрофили.ПредставлениеНаРусском КАК ПредставлениеНаРусском,
	               |	CW_ВебПрофили.ПредставлениеНаАнглийском КАК ПредставлениеНаАнглийском,
	               |	CW_ВебПрофили.ВыгружатьФайлы КАК ВыгружатьФайлы,
	               |	CW_ВебПрофили.ОсновнойПрофиль.ВыводитьФинансовыеДокументы КАК ВыводитьФинансовыеДокументы,
	               |	CW_ВебПрофили.ОсновнойПрофиль.ВыводитьЗадолженность КАК ВыводитьЗадолженность,
	               |	CW_ВебПрофили.ОсновнойПрофиль.УведомлятьОЗадолженности КАК УведомлятьОЗадолженности
	               |ИЗ
	               |	Справочник.CW_ВебПрофили КАК CW_ВебПрофили
	               |ГДЕ
	               |	CW_ВебПрофили.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", 	Профиль);
	
	Выборка =  Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(ДанныеПрофиля, Выборка);
	КонецЕсли;
	
	Возврат ДанныеПрофиля;
	
КонецФункции  

