Процедура МониторПоддержкиПолучитьИнформацию(ПараметрыПроцедуры, АдресРезультата) Экспорт
	
	СервисИспользуется = Константы.CW_РеестрыНДС0Используется.Получить();
	
	СтруктураРеестрыНДС0 = Новый Структура;
	СтруктураРеестрыНДС0.Вставить("Используется",   			СервисИспользуется); 
	СтруктураРеестрыНДС0.Вставить("Ошибка", 					Ложь);	
	СтруктураРеестрыНДС0.Вставить("СоответствуетМинимальной", 	Ложь);	
	СтруктураРеестрыНДС0.Вставить("ИгнорироватьМинимальнуюВерсию", 		Ложь);	
	СтруктураРеестрыНДС0.Вставить("ИгнорироватьРекомендуемуюВервсию", 	Ложь);	
	СтруктураРеестрыНДС0.Вставить("МинимальнаяВерсия", 				"<...>");	
	СтруктураРеестрыНДС0.Вставить("РекомендуемаяВерсия", 			"<...>");	
	СтруктураРеестрыНДС0.Вставить("Тариф", 							"<...>");	
	СтруктураРеестрыНДС0.Вставить("ДатаНачала", 					"<...>");	
	СтруктураРеестрыНДС0.Вставить("ДатаОкончания", 					"<...>");	
	СтруктураРеестрыНДС0.Вставить("АвтоматическиВыписыватьСчета",	Ложь); 
	
	Если СервисИспользуется Тогда
		Результат = СведенияСервисеРеестрыНДС0();
		
		Если Результат = Неопределено или Результат.КодСостояния <> 200 Тогда
			СтруктураРеестрыНДС0.Вставить("Ошибка", Истина);
		Иначе
			СтруктураРеестрыНДС0.Вставить("МинимальнаяВерсия", 			Результат.МинимальнаяВерсия);	
			СтруктураРеестрыНДС0.Вставить("РекомендуемаяВерсия", 		Результат.РекомендуемаяВерсия);	
			СтруктураРеестрыНДС0.Вставить("СоответствуетМинимальной", 	Результат.СоответствуетМинимальной);	
			СтруктураРеестрыНДС0.Вставить("ИгнорироватьМинимальнуюВерсию", 		Результат.ИгнорироватьМинимальнуюВерсию);	
			СтруктураРеестрыНДС0.Вставить("ИгнорироватьРекомендуемуюВервсию", 	Результат.ИгнорироватьРекомендуемуюВервсию);	
			СтруктураРеестрыНДС0.Вставить("АвтоматическиВыписыватьСчета", 		Результат.АвтоматическиВыписыватьСчета);	
			
			СтруктураРеестрыНДС0.Вставить("Тариф", 			Результат.Тариф);	
			СтруктураРеестрыНДС0.Вставить("ДатаНачала", 	Результат.ДатаНачала);	
			СтруктураРеестрыНДС0.Вставить("ДатаОкончания", 	Результат.ДатаОкончания);	
		КонецЕсли;
		
	КонецЕсли;
	
	ПоместитьВоВременноеХранилище(СтруктураРеестрыНДС0, АдресРезультата);
	
КонецПроцедуры


Функция СведенияСервисеРеестрыНДС0() Экспорт
	
	Результат = Новый Структура;   
	Результат.Вставить("КодСостояния",				Неопределено);
	Результат.Вставить("МинимальнаяВерсия",			"<...>"); 
	Результат.Вставить("РекомендуемаяВерсия",		"<...>"); 
	Результат.Вставить("Тариф",			 			"<...>"); 
	Результат.Вставить("ДатаНачала",				"<...>"); 
	Результат.Вставить("ДатаОкончания",	 			"<...>"); 
 	Результат.Вставить("Состояние",	 				"<...>"); 
	Результат.Вставить("СоответствуетМинимальной",			Ложь); 
    Результат.Вставить("ИгнорироватьМинимальнуюВерсию",		Ложь); 
	Результат.Вставить("ИгнорироватьРекомендуемуюВервсию",	Ложь); 
	Результат.Вставить("АвтоматическиВыписыватьСчета",		Ложь); 

	РегистрационныйНомер 	= CW_ПроверкаЛицензии.ПолучитьРегистрационныйНомер();
	
	Если ПустаяСтрока(РегистрационныйНомер) Тогда
		Результат.Вставить("КодСостояния",	403);
		Результат.Вставить("Состояние",		"Программный продукт не зарегистрирован!");
		Возврат Результат;
	КонецЕсли;
	
	versionaf = CW_ОбновлениеКонфигурацииСервер.УстановленнаяВерсияПодсистемы(); 
	
	СтруктураJSON = Новый Структура;
	СтруктураJSON.Вставить("versionaf",	XMLСтрока(versionaf));
	СтруктураJSON.Вставить("regnumber",	XMLСтрока(РегистрационныйНомер)); 

	ПараметрыHTTPЗапроса = CW_РаботаСВнешнимиРесурсамиСервер.ПодготовитьHTTPЗапрос("vat_vatinfo", СтруктураJSON);
	
	Ответ = CW_РаботаСВнешнимиРесурсамиСервер.ПолучитьДанныеССервера(ПараметрыHTTPЗапроса.HTTPСоединение, ПараметрыHTTPЗапроса.HTTPЗапрос, "GET");
	Если Ответ = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Результат.Вставить("КодСостояния", Ответ.КодСостояния);
	
	Если Ответ.КодСостояния = 200 Тогда
		
		Тело = Ответ.ПолучитьТелоКакСтроку();  
		
		СтруктураОтветJSON = CW_РаботаСВнешнимиРесурсамиСервер.ПрочитатьHTTPСервисВОбъект(Ответ);
		
		Результат.Вставить("МинимальнаяВерсия",			XMLЗначение(тип("Строка"), 	СтруктураОтветJSON.minversionaf)); 
		Результат.Вставить("РекомендуемаяВерсия",		XMLЗначение(тип("Строка"), 	СтруктураОтветJSON.recversionaf)); 
		Результат.Вставить("Тариф",			 			XMLЗначение(тип("Строка"), 	СтруктураОтветJSON.rate)); 
		Результат.Вставить("ДатаНачала",				XMLЗначение(тип("Дата"), 	СтруктураОтветJSON.startdate)); 
		Результат.Вставить("ДатаОкончания",	 			XMLЗначение(тип("Дата"), 	СтруктураОтветJSON.enddate)); 
		Результат.Вставить("СоответствуетМинимальной",	XMLЗначение(тип("Булево"), 	СтруктураОтветJSON.respondmin)); 
		
		Результат.Вставить("ИгнорироватьМинимальнуюВерсию",		XMLЗначение(тип("Булево"), 	СтруктураОтветJSON.ignoreminversionaf));	
		Результат.Вставить("ИгнорироватьРекомендуемуюВервсию", 	XMLЗначение(тип("Булево"), 	СтруктураОтветJSON.ignorerecversionaf));	
		Результат.Вставить("АвтоматическиВыписыватьСчета", 		XMLЗначение(Тип("Булево"),	СтруктураОтветJSON.autoinvoice));  
		
	КонецЕсли;
	
	Возврат Результат;   
	
КонецФункции


Процедура ОбновитьДанныеАвтоматическойВыпискиСчетов(ПараметрыПроцедуры, АдресРезультата) Экспорт

	Результат = Новый Структура;
	
	СервисИспользуется = Константы.CW_РеестрыНДС0Используется.Получить();
	
	Если СервисИспользуется Тогда 
		
		РегистрационныйНомер = CW_ПроверкаЛицензии.ПолучитьРегистрационныйНомер();
		Если ПустаяСтрока(РегистрационныйНомер) Тогда
			Результат.Вставить("КодСостояния",	403);
			Результат.Вставить("Состояние",		"Программный продукт не зарегистрирован!");
		Иначе
			
			versionaf = CW_ОбновлениеКонфигурацииСервер.УстановленнаяВерсияПодсистемы(); 
			
			СтруктураJSON = Новый Структура;
			СтруктураJSON.Вставить("regnumber",		XMLСтрока(РегистрационныйНомер)); 
			СтруктураJSON.Вставить("autoinvoice",	XMLСтрока(ПараметрыПроцедуры.Значение)); 
			
			ПараметрыHTTPЗапроса = CW_РаботаСВнешнимиРесурсамиСервер.ПодготовитьHTTPЗапрос("vat_autoinvoice", СтруктураJSON);
			
			Ответ = CW_РаботаСВнешнимиРесурсамиСервер.ПолучитьДанныеССервера(ПараметрыHTTPЗапроса.HTTPСоединение, ПараметрыHTTPЗапроса.HTTPЗапрос, "POST");
			Результат.Вставить("КодСостояния", 	Ответ.КодСостояния);
			Результат.Вставить("Состояние", 	Ответ.ПолучитьтелоКакСтроку());
			
		КонецЕсли;
		
	КонецЕсли;
	
	ПоместитьВоВременноеХранилище(Результат, АдресРезультата);
	
КонецПроцедуры  


