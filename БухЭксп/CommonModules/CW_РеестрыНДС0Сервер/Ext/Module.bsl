Функция ПолучитьПриложениеПриказа(Знач Приказ, Знач ВидТранспорта) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	CW_РеестрыНДС0ЯчейкиПриложений.Ссылка КАК Ссылка
	|ИЗ
	|	ПланВидовХарактеристик.CW_РеестрыНДС0ЯчейкиПриложений КАК CW_РеестрыНДС0ЯчейкиПриложений
	|ГДЕ
	|	CW_РеестрыНДС0ЯчейкиПриложений.ЭтоГруппа = ИСТИНА
	|	И CW_РеестрыНДС0ЯчейкиПриложений.ПриложениеПоВидуТранспорта = &ВидТранспорта
	|	И CW_РеестрыНДС0ЯчейкиПриложений.Родитель = &ПриказФНС";  
	
	Запрос.УстановитьПараметр("ПриказФНС", 		Приказ);
	Запрос.УстановитьПараметр("ВидТранспорта", 	ВидТранспорта); 
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
КонецФункции


