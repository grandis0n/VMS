Функция ПолучитьПредопределенныеПараметры(Субъект,ИмяРеквизита, ИдентификаторФормы=Неопределено) Экспорт 
	// --- 
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	CW_ПредопределенныеЗначенияПараметров.Параметр КАК Параметр,
	               |	CW_ПредопределенныеЗначенияПараметров.Значение КАК Значение,
	               |	CW_ПредопределенныеЗначенияПараметров.ДобавлятьАвтоматически КАК Добавлять,
	               |	CW_ПредопределенныеЗначенияПараметров.ПерезаполнятьАвтоматически КАК Перезаполнять,
	               |	CW_ПредопределенныеЗначенияПараметров.ДляГрузоперевозок КАК ДляГрузоперевозок,
	               |	CW_ПредопределенныеЗначенияПараметров.ДляЗаявок КАК ДляЗаявок,
	               |	CW_ПредопределенныеЗначенияПараметров.ДляЗаказов КАК ДляЗаказов
	               |ИЗ
	               |	РегистрСведений.CW_ПредопределенныеЗначенияПараметров КАК CW_ПредопределенныеЗначенияПараметров
	               |ГДЕ
	               |	CW_ПредопределенныеЗначенияПараметров.ВидСубъекта = &ВидСубъекта
	               |	И CW_ПредопределенныеЗначенияПараметров.Субъект = &Субъект";
	
	Запрос.УстановитьПараметр("ВидСубъекта"	, ВидСубъекта(ИмяРеквизита));
	Запрос.УстановитьПараметр("Субъект"		, Субъект); 

	РезультатЗапроса = Запрос.Выполнить();
	
	Если Не РезультатЗапроса.Пустой() Тогда
		
		Ответ = _УФКС.Ответ();
		Если (ИдентификаторФормы <> Неопределено) Тогда
			
			Ответ.Вставить("Параметры",ПоместитьВоВременноеХранилище(РезультатЗапроса.Выгрузить(),ИдентификаторФормы));
			
		Иначе
			
			Ответ.Вставить("Параметры",РезультатЗапроса.Выгрузить());
			
		КонецЕсли; 
		Возврат(Ответ);
		
	Иначе
		Возврат(_УФКС.Ответ(1));
	КонецЕсли; 
	
	// --- 
КонецФункции
Функция ДобавитьПредопределенныеПараметры(Объект,АдресПараметров) Экспорт 
	// --- 
	
	Если (ЭтоАдресВременногоХранилища(АдресПараметров)) Тогда
		ТЗПараметров = ПолучитьИзВременногоХранилища(АдресПараметров);
	Иначе
		ТЗПараметров = АдресПараметров;
	КонецЕсли; 
	
	Если ТипЗнч(Объект.Ссылка) = Тип("СправочникСсылка.CW_Заявки") Тогда
		Отбор = Новый Структура;
		Отбор.Вставить("ДляЗаявок", Истина);
	ИначеЕсли   ТипЗнч(Объект.Ссылка) = Тип("СправочникСсылка.CW_Грузоперевозки") Тогда
		Отбор = Новый Структура;
		Отбор.Вставить("ДляГрузоперевозок", Истина);
	ИначеЕсли   ТипЗнч(Объект.Ссылка) = Тип("СправочникСсылка.CW_Заказы") Тогда
		Отбор = Новый Структура;
		Отбор.Вставить("ДляЗаказов", Истина);
	КонецЕсли; 
	
	МассивПараметров = ТЗПараметров.НайтиСтроки(Отбор);
	
	ЕстьИзменения 			= Ложь;
	ИмяТЧ 					= ТабличнаяЧастьПараметровОбъекта(Объект);
	
	Если (ТипЗнч(Объект[ИмяТЧ])=Тип("ТаблицаЗначений")) Тогда
		ТаблицаПараметровГП = Объект[ИмяТЧ];
	Иначе
		ТаблицаПараметровГП = Объект[ИмяТЧ].Выгрузить();
	КонецЕсли; 
	
	Для каждого Стр Из МассивПараметров Цикл
		
		СтрокаПараметра = _сф.к_НайтиСтроку(ТаблицаПараметровГП,"Параметр",Стр.Параметр);
		Если (СтрокаПараметра = Неопределено) Тогда
			
			Если (Стр.Добавлять) Тогда
				СтрокаПараметра = ТаблицаПараметровГП.Добавить();
				СтрокаПараметра.Параметр = Стр.Параметр;
				СтрокаПараметра.Значение = Стр.Значение;
				ЕстьИзменения = Истина;
			КонецЕсли; 
			
		Иначе
			
			Если (Стр.Перезаполнять) или Не ЗначениеЗаполнено(СтрокаПараметра.Значение) Тогда // условие "или" по AFR-250093 от 06.03.2025 20:19:03
				                         
				СтрокаПараметра.Значение = Стр.Значение;
				ЕстьИзменения = Истина;
				
			КонецЕсли; 
			
		КонецЕсли; 
		
	КонецЦикла; 
	
	Если (ЕстьИзменения) Тогда
		Объект[ИмяТЧ].Загрузить(ТаблицаПараметровГП);
	КонецЕсли; 
	
	Возврат(_УФКС.Ответ(?(ЕстьИзменения,0,1)));
	
	// --- 
