Функция ТаблицаЗакрытыхГрузоперевозок(Объект) Экспорт 
	// --- 
	
	Грузоперевозки = Объект.Услуги.Выгрузить(,"Грузоперевозка");
	Грузоперевозки.Свернуть("Грузоперевозка");
	_сф.т_ДобавитьКолонки(Грузоперевозки,"Аналитика,Заказ,ДатаЗакрытия");
	Для каждого Стр Из Грузоперевозки Цикл
		Стр.Заказ = Стр.Грузоперевозка.Заказ;
		Стр.ДатаЗакрытия = Дата(1,1,1);
		Если Стр.Грузоперевозка.Заказ.Пустая() Тогда
			Стр.Аналитика = Стр.Грузоперевозка;
		Иначе
			Стр.Аналитика = Стр.Грузоперевозка.Заказ;
		КонецЕсли; 
	КонецЦикла; 
	ТЗАналитики = Грузоперевозки.Скопировать(,"Аналитика");
	ТЗАналитики.Свернуть("Аналитика");
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	CW_ЗакрытиеФинансов.ДатаЗакрытия,
	               |	CW_ЗакрытиеФинансов.Аналитика
	               |ИЗ
	               |	РегистрСведений.CW_ЗакрытиеФинансов КАК CW_ЗакрытиеФинансов
	               |ГДЕ
	               |	CW_ЗакрытиеФинансов.Аналитика В(&Аналитика)";
	Запрос.УстановитьПараметр("Аналитика", ТЗАналитики.ВыгрузитьКолонку("Аналитика"));
	ТЗ = Запрос.Выполнить().Выгрузить();
	
	Для каждого Стр Из ТЗ Цикл
		
		Отбор = Новый Структура("Аналитика",Стр.Аналитика);
		Строки = Грузоперевозки.НайтиСтроки(Отбор);
		Для каждого СтрГп Из Строки Цикл
			
			СтрГп.ДатаЗакрытия = Стр.ДатаЗакрытия;
			
		КонецЦикла; 
		
	КонецЦикла; 
	
	_сф.к_УдалитьЭлементыПоОтбору(Грузоперевозки,_сф.ст_Отбор("ДатаЗакрытия",Дата(1,1,1)));
	
	Возврат(Грузоперевозки);
	
