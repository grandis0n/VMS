	//	УстановитьПривилегированныйРежим(Истина);	
	//	КопияГрузоперевозки.Удалить();	
	//	УстановитьПривилегированныйРежим(Ложь);	
	//КонецЕсли; 
	
	Возврат  ЗначениеВозврата;
	
КонецФункции

Функция ПроверитьНаличиеСсылкиВОтборе(ЭлементыОбора)
	
	Для Каждого ЭлементОтбора Из ЭлементыОбора Цикл
		
		Если ТипЗнч(ЭлементОтбора) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") Тогда
			Возврат ПроверитьНаличиеСсылкиВОтборе(ЭлементОтбора.Элементы);
		Иначе
			Если ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Ссылка") Тогда
				Возврат Ложь;
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат истина;
	
КонецФункции

