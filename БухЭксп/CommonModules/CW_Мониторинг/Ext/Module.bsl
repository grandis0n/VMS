#Область Нумерация

Функция ПолучитьНомерГрузоперевозкиНаПечать(Грузоперевозка) Экспорт

	НумерацияВПределахЗаказа = Константы.CW_АвтоматическаяНумерацияВПределахЗаказа.Получить();	
	
	КодПеревозки  = Грузоперевозка.Код;
	ПрефиксЗаказа = "";	
	Если НумерацияВПределахЗаказа Тогда 
		ПозицияТире   			= СтрНайти(Грузоперевозка.Код, "-");
		КодПеревозки  			= Сред(Грузоперевозка.Код, ПозицияТире+1);
		ПрефиксЗаказа 			= Лев(Грузоперевозка.Код, ПозицияТире); 
		ПрефиксЗаказаБезТире 	= Лев(Грузоперевозка.Код, ПозицияТире-1); 
		
		Попытка
			ПрефиксЗаказаБезТире = Число(ПрефиксЗаказаБезТире);
		Исключение
			ПрефиксЗаказаБезТире = СокрЛП(ПрефиксЗаказаБезТире);   
		КонецПопытки; 
		
		Если ТипЗнч(ПрефиксЗаказаБезТире)= Тип("Число")
			и ПрефиксЗаказаБезТире = 0 Тогда
			ПрефиксЗаказа = "";	
		КонецЕсли;
		
	КонецЕсли;
	
	Попытка
		НомерПеревозки = Число(КодПеревозки);
	Исключение
		НомерПеревозки = СокрЛП(КодПеревозки);   
	КонецПопытки; 
	
	Возврат СтрШаблон("%1%2", ПрефиксЗаказа, Формат(НомерПеревозки,"ЧГ=0"));   
	
КонецФункции


#КонецОбласти 

#Область Параметры 


Функция ПолучитьИндексПиктограммыПараметра(Ссылка) Экспорт

	Возврат ПланыВидовХарактеристик.CW_ПараметрыГрузоперевозок.ПолучитьИндексПиктограммыПараметра(Ссылка);
	
КонецФункции   

Функция СтрокаПараметра(Объект,Параметр) Экспорт 
	// --- 
	
	ИмяТЧ = ТабличнаяЧастьПараметровОбъекта(Объект);
	Если ИмяТЧ <> Неопределено Тогда
		СтрокаПараметра = _сф.к_НайтиСтроку(Объект[ИмяТЧ],Новый Структура("Параметр",Параметр));
	КонецЕсли;
	Возврат(СтрокаПараметра);
	
	// --- 
КонецФункции
Функция ТабличнаяЧастьПараметровОбъекта(Объект) Экспорт 
	
	ИмяТЧ = Неопределено;
	
	ТипОбъекта = ТипЗнч(Объект);
	Если ТипОбъекта = Тип("Структура") Тогда
		Если  Объект.Свойство("ТаблицаПараметров") Тогда
			ИмяТЧ = "ТаблицаПараметров";
		КонецЕсли;
	Иначе
		//тут проверяем ссылку
		ТипСсылкиОбъекта = ТипЗнч(Объект.Ссылка);
		Если ТипСсылкиОбъекта = Тип("СправочникСсылка.CW_Заявки") Тогда
			ИмяТЧ = "ПараметрыЗаявки";
		ИначеЕсли ТипСсылкиОбъекта = Тип("СправочникСсылка.CW_Грузоперевозки") Тогда
			ИмяТЧ = "ПараметрыГрузоперевозки";
		ИначеЕсли ТипСсылкиОбъекта = Тип("СправочникСсылка.CW_Заказы") Тогда
			ИмяТЧ = "ПараметрыЗаказа";
		КонецЕсли; 
	КонецЕсли;
	
	Возврат ИмяТЧ;
	
КонецФункции
Функция ПараметрГрузоперевозки(Грузоперевозка, Параметр) Экспорт 
	// --- 
	
	СтрокаПГ = _сф.к_НайтиСтроку(Грузоперевозка.ПараметрыГрузоперевозки,"Параметр",Параметр);
	Если (СтрокаПГ=Неопределено) Тогда
		
		Возврат(Неопределено);
		
	Иначе
		
		Возврат(СтруктураПараметраГрузоперевозки(СтрокаПГ));
		
	КонецЕсли; 
	
	// --- 
КонецФункции
Функция СтруктураПараметраГрузоперевозки(СтрокаПараметра) Экспорт 

	СтруктураПараметра = CW_МониторинговыеПараметрыСервер.ПолучитьПустуюСтруктуруРедактированияПараметров();
	СтруктураПараметра.Параметр		= СтрокаПараметра.Параметр;
	СтруктураПараметра.Значение 	= СтрокаПараметра.Значение;
	СтруктураПараметра.ЗначениеПлан = СтрокаПараметра.ЗначениеПлан;
	СтруктураПараметра.ЗначениеФакт = СтрокаПараметра.ЗначениеФакт;
	СтруктураПараметра.Примечание 	= СтрокаПараметра.Примечание;
	
	Возврат СтруктураПараметра;
	
	// --- 
КонецФункции
Функция СтруктураСвойствПараметра(Параметр) Экспорт 
	
	Ответ = _сф.ст_Создать("Ведомый,СписокВедущих,Ведущий,СписокВедомых,СписокВедомыхСтрокой,ДинамическийПараметр,ИспользуетсяВнешняяОбработкаПередНачаломИзменения,ИспользоватьФормуВыбораОбъекта, ИмяФормыВыбора, ИспользуютсяДополнительныеЗначения,СохранятьПолноеЗначениеПараметра");
	
	Ответ.Ведомый = Параметр.ЭтоВедомыйПараметр;
	Ответ.ДинамическийПараметр = Параметр.ДинамическийПараметр;
	СписокВедущих = Новый СписокЗначений;
	Для каждого СтрОтбора Из Параметр.ПараметрыОтбора.Выгрузить(_сф.ст_Отбор("ИспользоватьПГ",Истина)) Цикл
		Если (СписокВедущих.НайтиПоЗначению(СтрОтбора.Значение) = Неопределено) Тогда
			СписокВедущих.Добавить(СтрОтбора.Значение);
		КонецЕсли; 
	КонецЦикла;
	Ответ.СписокВедущих = СписокВедущих;

	СписокВедомых = Новый СписокЗначений;
	ЗаполнитьСписокВедомыхПараметров(Параметр, СписокВедомых);
	Ответ.Ведущий = (СписокВедомых.Количество() <> 0);
	Ответ.СписокВедомых = СписокВедомых;
	Ответ.СписокВедомыхСтрокой = _сф.сп_Представление(СписокВедомых,",",Ложь);
	
	Ответ.ИспользуетсяВнешняяОбработкаПередНачаломИзменения = Параметр.ИспользуетсяОбработкаПередНачаломВыбора;
	Ответ.ИспользоватьФормуВыбораОбъекта 					= Параметр.ИспользоватьФормуВыбораОбъекта;
	Ответ.ИспользуютсяДополнительныеЗначения 				= Параметр.ИспользуютсяДополнительныеЗначения;
	Ответ.СохранятьПолноеЗначениеПараметра = CW_МониторинговыеПараметрыСервер.ИспользуетсяСохранениеПолногоЗначения(Параметр);
	
	Если Параметр.ИспользоватьФормуВыбораОбъекта Тогда   
		ИмяМетаданного 			= Параметр.ТипЗначения.ПривестиЗначение().Метаданные().ПолноеИмя();
		Ответ.ИмяФормыВыбора 	= ИмяМетаданного+".ФормаВыбора";    
	КонецЕсли;   
	
	Возврат(Ответ);
	
КонецФункции

Функция ПолучитьСоответствиеСвойствПараметров() Экспорт 
	Возврат(CW_Мониторинг_ПИ.ПолучитьСоответствиеСвойствПараметров());
КонецФункции

Процедура ЗаполнитьСписокВедомыхПараметров(Параметр, СписокПараметров)
	
	// рекурсивная функция получение списка зависимых параметров
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	CW_ПараметрыГрузоперевозок.Ссылка
	|ИЗ
	|	ПланВидовХарактеристик.CW_ПараметрыГрузоперевозок.ПараметрыОтбора КАК CW_ПараметрыГрузоперевозок
	|ГДЕ
	|	CW_ПараметрыГрузоперевозок.Значение = &Значение
	|	И CW_ПараметрыГрузоперевозок.ИспользоватьПГ = ИСТИНА";
	
	Запрос.УстановитьПараметр("Значение", Параметр);
	ТаблицаВедомыхПГ = Запрос.Выполнить().Выгрузить();
	ТаблицаВедомыхПГ.Свернуть("Ссылка");
	
	Для каждого Стр Из ТаблицаВедомыхПГ Цикл
		Если СписокПараметров.НайтиПоЗначению(Стр.Ссылка) = Неопределено Тогда
			СписокПараметров.Добавить(Стр.Ссылка);
			ЗаполнитьСписокВедомыхПараметров(Стр.Ссылка, СписокПараметров);
		КонецЕсли; 
	КонецЦикла; 
		
КонецПроцедуры

