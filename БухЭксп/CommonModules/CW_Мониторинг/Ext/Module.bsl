#Область ДинамическиеПараметры 

Процедура CW_ПересчетДинамическихПараметров() Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если (ПолучитьФункциональнуюОпцию("CW_ИспользованиеДинамическихПараметров") = Ложь) Тогда
		Возврат;
	КонецЕсли; 
	
	ПараметрДатыСледующегоОбновления = Константы.CW_ПараметрДатыЕжедневногоОбновления.Получить();
	Если (НЕ ЗначениеЗаполнено(ПараметрДатыСледующегоОбновления)) Тогда
		УстановитьПараметрДатыЕжедневногоОбновления();	
		ПараметрДатыСледующегоОбновления = Константы.CW_ПараметрДатыЕжедневногоОбновления.Получить();
	КонецЕсли; 
	
	СоответствиеСвойствПараметров = _БЭ.ПолучитьСоответствиеСвойствПараметров();
	
	Таймер = _сф.Таймер_Старт();
	
	Запрос = Новый Запрос; 
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.Текст = "ВЫБРАТЬ
	               |	CW_ЗакрытиеМониторинга.Аналитика КАК ГрузопереовзкаСсылка
	               |ПОМЕСТИТЬ ВТ_ЗаблокированныеПоМониторигу
	               |ИЗ
	               |	РегистрСведений.CW_ЗакрытиеМониторинга КАК CW_ЗакрытиеМониторинга
	               |ГДЕ
	               |	CW_ЗакрытиеМониторинга.Аналитика ССЫЛКА Справочник.CW_Грузоперевозки
	               |	И CW_ЗакрытиеМониторинга.ДатаЗакрытия < &НачалоТекущегоДня
	               |
	               |ИНДЕКСИРОВАТЬ ПО
	               |	ГрузопереовзкаСсылка
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	CW_Грузоперевозки.Ссылка КАК Ссылка
	               |ПОМЕСТИТЬ ВТ_Исключения
	               |ИЗ
	               |	Справочник.CW_Грузоперевозки КАК CW_Грузоперевозки
	               |ГДЕ
	               |	CW_Грузоперевозки.Архив
	               |	И НЕ CW_Грузоперевозки.Ссылка В
	               |				(ВЫБРАТЬ
	               |					ВТ_ЗаблокированныеПоМониторигу.ГрузопереовзкаСсылка КАК ГрузопереовзкаСсылка
	               |				ИЗ
	               |					ВТ_ЗаблокированныеПоМониторигу КАК ВТ_ЗаблокированныеПоМониторигу)
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ВТ_ЗаблокированныеПоМониторигу.ГрузопереовзкаСсылка
	               |ИЗ
	               |	ВТ_ЗаблокированныеПоМониторигу КАК ВТ_ЗаблокированныеПоМониторигу";
	
	Запрос.УстановитьПараметр("НачалоТекущегоДня", НачалоДня(ТекущаяДата()));
	
	//Получаем грузоперевозки, которые не обрабатываем
	Запрос.Выполнить();
	
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	CW_ХарактеристикиГрузоперевозок.Грузоперевозка КАК Грузоперевозка
	               |ИЗ
	               |	РегистрСведений.CW_ХарактеристикиГрузоперевозок КАК CW_ХарактеристикиГрузоперевозок
	               |ГДЕ
	               |	CW_ХарактеристикиГрузоперевозок.Параметр = &Параметр
	               |	И CW_ХарактеристикиГрузоперевозок.Значение < &Значение
	               |	И НЕ CW_ХарактеристикиГрузоперевозок.Грузоперевозка В
	               |				(ВЫБРАТЬ
	               |					ВТ_Исключения.Ссылка КАК Ссылка
	               |				ИЗ
	               |					ВТ_Исключения КАК ВТ_Исключения)";

	Запрос.УстановитьПараметр("Параметр", ПараметрДатыСледующегоОбновления);
	Запрос.УстановитьПараметр("Значение", КонецДня(ТекущаяДата())+1); 
	
	Выборка 					= Запрос.Выполнить().Выбрать();
	КоличествоГрузоперевозок 	= Выборка.Количество();
	ЕстьОшибки 					= Ложь;
	
	Пока Выборка.Следующий() Цикл
		
		Ответ = ПересчитатьДинамическиеПараметрыОбъекта(Выборка.Грузоперевозка,СоответствиеСвойствПараметров);
		
		Если НЕ _УФКС.ВыполненоУспешно(Ответ) Тогда
			ЕстьОшибки = истина;
		КонецЕсли; 
		
	КонецЦикла; 
	
	_сф.Таймер_Стоп(Таймер);
	
	Если ЕстьОшибки Тогда
		
		ТекстСообщения = "Пересчет параметров:"+Символы.ПС;
		CW_Журнал.ЗаписатьСообщение("БЭ.ПересчетДинамическихПараметров","error",ТекстСообщения);
		
	Иначе
		
		ТекстСообщения = "Пересчет параметров завершен успешно."+Символы.ПС;
		ТекстСообщения = ТекстСообщения + "Количество грузоперевозк: "+Формат(КоличествоГрузоперевозок,"ЧДЦ=");
		
		Если (КоличествоГрузоперевозок <> 0) Тогда
			
			ТекстСообщения = ТекстСообщения+Символы.ПС;
			ТекстСообщения = ТекстСообщения + "Время пересчёта: "+ _сф.Таймер_Представление(Таймер,Истина)+Символы.ПС;
			ТекстСообщения = ТекстСообщения + "Скорость пересчёта: "+ Формат(Окр(КоличествоГрузоперевозок*1000/_сф.Таймер_Интервал(Таймер),2),"ЧДЦ=2; ЧГ=")+" шт/с";
			
		КонецЕсли; 
				
		CW_Журнал.ЗаписатьСообщение("БЭ.ПересчетДинамическихПараметров","info",ТекстСообщения);
		
	КонецЕсли; 
	
КонецПроцедуры
Функция ПересчитатьДинамическиеПараметрыОбъекта(Грузоперевозка, СоответствиеСвойствПараметров=Неопределено) Экспорт
	// --- 
	
	Если (СоответствиеСвойствПараметров = Неопределено) Тогда
		СоответствиеСвойствПараметров = ПолучитьСоответствиеСвойствПараметров();
	КонецЕсли; 
	
	// --- 
	
	Попытка
		
		ТаблицаПараметров = ДинамическиеПараметрыОбъекта(Грузоперевозка, СоответствиеСвойствПараметров);
		Для каждого Стр Из ТаблицаПараметров Цикл
			
			Запись = РегистрыСведений.CW_ХарактеристикиГрузоперевозок.СоздатьМенеджерЗаписи();
			// --- 
			Запись.Грузоперевозка = Грузоперевозка;
			Запись.Параметр = Стр.Параметр;
			Запись.Значение = Стр.Значение;
			// --- 
			Запись.Записать(Истина);
			
		КонецЦикла; 
		
	Исключение
		Возврат(_УФКС.Ответ(1,ОписаниеОшибки()));
	КонецПопытки; 
	
	Возврат(_УФКС.Ответ());
	
	// --- 
КонецФункции
Функция ДинамическиеПараметрыОбъекта(Грузоперевозка, СоответствиеСвойствПараметров, МассивПараметров=Неопределено,ТаблицаПараметровГрузоперевозки=Неопределено) Экспорт
	// --- 
	
	ЕстьЕжедневные = Ложь;
	// --- 
	
	Если (ТаблицаПараметровГрузоперевозки = Неопределено) Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		|	CW_ГрузоперевозкиПараметрыОбъекта.Параметр,
		|	CW_ГрузоперевозкиПараметрыОбъекта.Параметр.Идентификатор КАК Идентификатор,
		|	CW_ГрузоперевозкиПараметрыОбъекта.Значение,
		|	CW_ГрузоперевозкиПараметрыОбъекта.ЗначениеПлан,
		|	CW_ГрузоперевозкиПараметрыОбъекта.ЗначениеФакт,
		|	CW_ГрузоперевозкиПараметрыОбъекта.Параметр.ДинамическийПараметр КАК ДинамическийПараметр
		|ИЗ
		|	Справочник.CW_Грузоперевозки.ПараметрыГрузоперевозки КАК CW_ГрузоперевозкиПараметрыОбъекта
		|ГДЕ
		|	CW_ГрузоперевозкиПараметрыОбъекта.Ссылка = &Ссылка";
		Запрос.УстановитьПараметр("Ссылка", Грузоперевозка.Ссылка);
		ТаблицаПараметровГрузоперевозки = Запрос.Выполнить().Выгрузить();
		
	Иначе
		
		ТаблицаПараметровГрузоперевозки.Колонки.Добавить("Идентификатор");
		ТаблицаПараметровГрузоперевозки.Колонки.Добавить("ДинамическийПараметр");
		Для каждого Стр Из ТаблицаПараметровГрузоперевозки Цикл
			
			СвойстваПараметра = СоответствиеСвойствПараметров.Получить(Стр.Параметр);
			Стр.Идентификатор = СвойстваПараметра.Идентификатор;
			Стр.ДинамическийПараметр = СвойстваПараметра.ДинамическийПараметр;
			
		КонецЦикла; 
		
	КонецЕсли; 
	
	Если (МассивПараметров = Неопределено) Тогда
		
		Отбор = Новый Структура("ДинамическийПараметр",Истина);
		МассивПараметров = ТаблицаПараметровГрузоперевозки.Скопировать(Отбор,"Параметр").ВыгрузитьКолонку("Параметр");
		
	КонецЕсли; 
	
	// ---------------------------------------------------------------------------- 
	
	// определяем порядок расчета 
	ТаблицаРанжирования = _сф.т_Создать("Параметр,Индекс");
	Для каждого Стр Из МассивПараметров Цикл
		
		Нстр = ТаблицаРанжирования.Добавить();
		Нстр.Параметр = Стр;
		Нстр.Индекс = 0;
		
		Если (НЕ ЕстьЕжедневные) Тогда
			СвойстваПараметра = СоответствиеСвойствПараметров.Получить(Стр);
			Если (СвойстваПараметра.ЕжедневныйПересчет) Тогда
				ЕстьЕжедневные = Истина;
			КонецЕсли; 	
		КонецЕсли; 
		
	КонецЦикла; 
	// --- 
	Для каждого Стр Из ТаблицаРанжирования Цикл
		
		ОпределитьИндекс(СоответствиеСвойствПараметров, Стр.Параметр, Стр.Индекс);
		
	КонецЦикла; 
	// --- 
	ТаблицаРанжирования.Сортировать("Индекс Возр");
	
	// ---------------------------------------------------------------------------- 
	
	ТаблицаДП = Справочники.CW_Грузоперевозки.ПустаяСсылка().ПараметрыГрузоперевозки.Выгрузить();
	ЕстьЕжедневные = Ложь;
	Для каждого Стр Из ТаблицаРанжирования Цикл
		
		СП = СоответствиеСвойствПараметров.Получить(Стр.Параметр);
		Ответ = ВычислитьДинамическийПараметр(Стр.Параметр, Грузоперевозка, ТаблицаПараметровГрузоперевозки, ТаблицаДП);
		Если (_УФКС.ВыполненоУспешно(Ответ)) Тогда
			
			Нстр = ТаблицаДП.Добавить();
			Нстр.Параметр = Стр.Параметр;
			Если (НЕ ЕстьЕжедневные) Тогда
				Если (СП.ЕжедневныйПересчет) Тогда
					ЕстьЕжедневные = Истина;
				КонецЕсли; 
			КонецЕсли; 
			Нстр.Значение = Ответ.Результат;
			
		КонецЕсли; 
		
	КонецЦикла; 
	
	Если (ЕстьЕжедневные) Тогда
		
		// добавляем запись по дате следующего обновления
		ПараметрДатыСледующегоОбновления = Константы.CW_ПараметрДатыЕжедневногоОбновления.Получить();
		Если (НЕ ЗначениеЗаполнено(ПараметрДатыСледующегоОбновления)) Тогда
			УстановитьПараметрДатыЕжедневногоОбновления();	
			ПараметрДатыСледующегоОбновления = Константы.CW_ПараметрДатыЕжедневногоОбновления.Получить();
		КонецЕсли; 
		// пытаемся найти
		Отбор = Новый Структура("Параметр",ПараметрДатыСледующегоОбновления);
		Нстр = _сф.к_НайтиСтроку(ТаблицаДП,Отбор);
		Если (Нстр = Неопределено) Тогда
			Нстр = ТаблицаДП.Добавить();	
		КонецЕсли; 
		Нстр.Параметр = ПараметрДатыСледующегоОбновления;
		Нстр.Значение = НачалоДня(КонецДня(ТекущаяДата())+1);
		
	КонецЕсли; 
	
	Возврат(ТаблицаДП);
	
	// --- 
КонецФункции
Процедура УстановитьПараметрДатыЕжедневногоОбновления() Экспорт 
	// --- 
	
	УстановитьПривилегированныйРежим(Истина);
	
	ПДЕО = ПланыВидовХарактеристик.CW_ПараметрыГрузоперевозок.СоздатьЭлемент();
	// --- 
	ПДЕО.ТолькоПросмотр = Истина;
	ПДЕО.Служебный = Истина;
	ПДЕО.Наименование = "Дата планового обновления";
	ПДЕО.ЭтоКонтрольнаяДата = Ложь;
	// --- 
	ПДЕО.Записать();
	
	Константы.CW_ПараметрДатыЕжедневногоОбновления.Установить(ПДЕО.Ссылка);
	
	УстановитьПривилегированныйРежим(Ложь);
	
	// --- 
КонецПроцедуры
Функция СписокМакросовДинамическихПараметров() Экспорт 
	
	ТаблицаМакросов = Новый ТаблицаЗначений;
	ТаблицаМакросов.Колонки.Добавить("Макрос", 			Новый ОписаниеТипов("Строка"));
	ТаблицаМакросов.Колонки.Добавить("Описание", 		Новый ОписаниеТипов("Строка"));
	ТаблицаМакросов.Колонки.Добавить("Параметр",		Новый ОписаниеТипов("ПланВидовХарактеристикСсылка.CW_ПараметрыГрузоперевозок"));
	ТаблицаМакросов.Колонки.Добавить("ИндексКартинки", 	Новый ОписаниеТипов("Число"));
	
	//Реквизиты
	НоваяяСтрока =  ТаблицаМакросов.Добавить();
	НоваяяСтрока.Макрос    			= "{Ссылка}";
	НоваяяСтрока.Описание           = "Ссылка";
	НоваяяСтрока.Параметр           = Неопределено;
	НоваяяСтрока.ИндексКартинки     = 4;
	
	НоваяяСтрока =  ТаблицаМакросов.Добавить();
	НоваяяСтрока.Макрос    			= "{Клиент}";
	НоваяяСтрока.Описание           = "Клиент";
	НоваяяСтрока.Параметр           = Неопределено;
	НоваяяСтрока.ИндексКартинки     = 4;
	
	НоваяяСтрока =  ТаблицаМакросов.Добавить();
	НоваяяСтрока.Макрос    			= "{Груз}";
	НоваяяСтрока.Описание           = "Груз";
	НоваяяСтрока.Параметр           = Неопределено;
	НоваяяСтрока.ИндексКартинки     = 4;
		
	НоваяяСтрока =  ТаблицаМакросов.Добавить();
	НоваяяСтрока.Макрос    			= "{Маршрут}";
	НоваяяСтрока.Описание           = "Маршрут";
	НоваяяСтрока.Параметр           = Неопределено;
	НоваяяСтрока.ИндексКартинки     = 4;
	
	НоваяяСтрока =  ТаблицаМакросов.Добавить();
	НоваяяСтрока.Макрос    			= "{Типоразмер}";
	НоваяяСтрока.Описание           = "Типоразмер контейнера";
	НоваяяСтрока.Параметр           = Неопределено;
	НоваяяСтрока.ИндексКартинки     = 4;
	//Реквизиты
	
	//Параметры
	Запрос = новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	CW_ПараметрыГрузоперевозок.Ссылка КАК Ссылка,
	               |	CW_ПараметрыГрузоперевозок.Идентификатор КАК Идентификатор,
	               |	CW_ПараметрыГрузоперевозок.ДинамическийПараметр КАК ДинамическийПараметр,
	               |	CW_ПараметрыГрузоперевозок.ЭтоКонтрольнаяДата КАК ЭтоКонтрольнаяДата
	               |ИЗ
	               |	ПланВидовХарактеристик.CW_ПараметрыГрузоперевозок КАК CW_ПараметрыГрузоперевозок
	               |ГДЕ
	               |	CW_ПараметрыГрузоперевозок.ЭтоГруппа = ЛОЖЬ
	               |	И CW_ПараметрыГрузоперевозок.ПометкаУдаления = ЛОЖЬ";
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		НоваяяСтрока =  ТаблицаМакросов.Добавить();
		НоваяяСтрока.Макрос    			= "{%" +Выборка.Идентификатор+"%}";
		НоваяяСтрока.Описание           = Строка(Выборка.Ссылка);
		НоваяяСтрока.Параметр           = Выборка.Ссылка;
		
		Если Выборка.ДинамическийПараметр Тогда
			НоваяяСтрока.ИндексКартинки     = 3;
		ИначеЕсли Выборка.ЭтоКонтрольнаяДата Тогда
			НоваяяСтрока.ИндексКартинки     = 2;
		Иначе
			НоваяяСтрока.ИндексКартинки     = 1;
		КонецЕсли;
		
	КонецЦикла;
	//Параметры
	
	Возврат ТаблицаМакросов;
	
КонецФункции

// --- 
Процедура ОпределитьИндекс(СоответствиеСвойствПараметров,Параметр,Индекс)
	// --- 
	
	СП = СоответствиеСвойствПараметров.Получить(Параметр);
	Если (СП.ЕстьИспользуемыеПараметры) Тогда
		
		Для каждого ИспользуемыеПараметр Из СП.ИспользуемыеПараметры Цикл
			Если (ЗначениеЗаполнено(ИспользуемыеПараметр)) Тогда
				
				СИП = СоответствиеСвойствПараметров.Получить(ИспользуемыеПараметр);
				Если (СИП.ДинамическийПараметр) Тогда
					
					_сф.Инкремент(Индекс);
					ОпределитьИндекс(СоответствиеСвойствПараметров, ИспользуемыеПараметр, Индекс);
					
				КонецЕсли; 
				
			КонецЕсли; 
			
		КонецЦикла; 
		
	КонецЕсли; 
	
	// --- 
КонецПроцедуры
Функция ВычислитьДинамическийПараметр(Параметр, Грузоперевозка, ТаблицаПараметров, ТаблицаРезультата)
	// --- 
	
	Формула = Параметр.ПодготовленнаяФормула;
	// --- 
	
	// анализируем формулу
	// определяем макросы, определяем значения, добавляем в массив переменных
	// подставляем вместо макросов элементы массива переменных
	МП = Новый Массив; // Массив переменных
	
	ТаблицаЗаменыРеквизитов = Новый Соответствие;
	ТаблицаЗаменыРеквизитов.Вставить("Дата","ДатаСделкиФ");
	// --- 
	
	СоответствиеПараметровГрузоперевозки = _сф.со_Создать("Идентификатор","",ТаблицаПараметров);
	
	ТипЗначенияПараметров = ПолучитьСоответствиеТиповЗначения(); 
	
	МакросыФормулы = _сф.стр_СписокМакросов(Формула,"{}");
	Для каждого Макрос Из МакросыФормулы Цикл
		
		ЗначениеПараметра = Неопределено;
		// ---------------------------------------------------------------------------- 
		
		// определяем, является реквизит параметром или реквизитом
		// если есть %%, то параметр
		Если (Найти(Макрос,"%")<>0) Тогда
			
			// это параметр
			Макрос = СтрЗаменить(Макрос,"%","");
			Если (Найти(Макрос,".") <>0 ) Тогда
				
				СтруктураМакроса = _сф.ст_СоздатьИзМаркированнойСтроки(Макрос,".","Идентификатор,Значение");
				ИдентификаторМакроса = СтруктураМакроса.Идентификатор;
				ЗначениеКД = СтруктураМакроса.Значение;
				
			Иначе
				
				ИдентификаторМакроса = Макрос;
				ЗначениеКД = Неопределено;
				
			КонецЕсли; 
			
			// пробуем получить из соответствия
			ДинамическийПараметр = Ложь;
			СтруктураЗначения = СоответствиеПараметровГрузоперевозки.Получить(ИдентификаторМакроса);
			Если (СтруктураЗначения <> Неопределено) Тогда
				
				ДинамическийПараметр = СтруктураЗначения.ДинамическийПараметр;
				Если (НЕ ДинамическийПараметр) Тогда
					Если (ЗначениеКД <> Неопределено) Тогда
						ЗначениеПараметра = СтруктураЗначения["Значение"+ЗначениеКД];
					Иначе
						ЗначениеПараметра = СтруктураЗначения["Значение"];
					КонецЕсли;	
				КонецЕсли; 
				
				Если (ДинамическийПараметр) Тогда
					
					// пробуем получить из таблицы динамических параметров
					Отбор = Новый Структура("Параметр",СтруктураЗначения.Параметр);
					СтрокаЗначения = _сф.к_НайтиСтроку(ТаблицаРезультата,Отбор);
					
					Если (СтрокаЗначения <> Неопределено) Тогда
						ЗначениеПараметра = СтрокаЗначения.Значение;
					КонецЕсли; 
					
				КонецЕсли; 
				
				Если ЗначениеПараметра = Неопределено Тогда
					ЗначениеПараметра = СтруктураЗначения.Параметр.ТипЗначения.ПривестиЗначение(ЗначениеПараметра);
				КонецЕсли; 
				
			Иначе
				ТипЗначенияПараметра 	= ТипЗначенияПараметров.Получить(ИдентификаторМакроса);
				Если ТипЗначенияПараметра <> Неопределено Тогда
					ЗначениеПараметра 	= ТипЗначенияПараметра.ПривестиЗначение();
				КонецЕсли;
			КонецЕсли; 

			
			Если (ЗначениеПараметра <> Неопределено) Тогда
				
				// получаем индекс добавляемой переменной
				МП.Добавить(ЗначениеПараметра);
				ИндексПеременной = МП.Количество()-1;
				СтрокаЗамены = "МП["+Формат(ИндексПеременной,"ЧДЦ=; ЧН=; ЧГ=")+"]";
				// --- 
				Формула = СтрЗаменить(Формула,_сф.стр_Обернуть(_сф.стр_Обернуть(Макрос,"%%"),"{}"),СтрокаЗамены);
				
			КонецЕсли; 
			
		Иначе
			
			// это реквизит
			// пробуем найти по таблице замены
			Соответствие = ТаблицаЗаменыРеквизитов.Получить(Макрос);
			Если (Соответствие = Неопределено) Тогда
				
				Соответствие = Макрос;
				
			КонецЕсли; 
			// --- 
			Формула = СтрЗаменить(Формула,_сф.стр_Обернуть(Макрос,"{}"),"Грузоперевозка."+Соответствие);
			
		КонецЕсли; 
		
	КонецЦикла; 
	
	// формируем таблицу замены функций
	// ---------------------------------------------------------------------------- 
	СЗ = Новый Соответствие;
	СЗ.Вставить("РазностьДат(","ДП_РазностьДат(");
	//СЗ.Вставить("ПлановоеЗначение(","ПлановоеЗначениеКонтрольнойДаты(Грузоперевозка,");
	Для каждого Стр Из СЗ Цикл
		
		Формула = СтрЗаменить(Формула,Стр.Ключ,Стр.Значение);
		
	КонецЦикла; 
	
	Результат = Неопределено;
	Текст = "Результат = "+ Формула;
	
	Попытка
		Выполнить(текст);	
	Исключение
	    Возврат(_УФКС.Ответ(1,ОписаниеОшибки()));
	КонецПопытки; 
	
	Ответ = _УФКС.Ответ();
	Ответ.Вставить("Результат",Результат);
	Возврат(Ответ);
	
	// --- 
КонецФункции
Функция ДП_РазностьДат(Дата1,Дата2)
	// --- 
	
	Разность = НачалоДня(Дата1)-НачалоДня(Дата2);
	Возврат(Цел(Разность/(60*60*24)));
	
	// --- 
