Функция ПолучитьДатуЗакрытия(Аналитика) Экспорт 
	// --- 
	
	Объект = Аналитика;
	
	Если ТипЗнч(Аналитика) = Тип("СправочникСсылка.CW_Грузоперевозки") Тогда
		
		Если НЕ Аналитика.Заказ.Пустая() Тогда
			
			Объект = Аналитика.Заказ;
			
		КонецЕсли; 
		
	КонецЕсли; 
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	CW_ЗакрытиеФинансов.ДатаЗакрытия
	|ИЗ
	|	РегистрСведений.CW_ЗакрытиеФинансов КАК CW_ЗакрытиеФинансов
	|ГДЕ
	|	CW_ЗакрытиеФинансов.Аналитика = &Аналитика";
	Запрос.УстановитьПараметр("Аналитика", Объект);
	ТЗ = Запрос.Выполнить().Выгрузить();
	Если ТЗ.Количество() = 0 Тогда
		
		Возврат(Дата(1,1,1));
		
	Иначе
		
		Возврат(_сф.к_ПервыйЭлемент(ТЗ).ДатаЗакрытия);
		
	КонецЕсли; 
	
