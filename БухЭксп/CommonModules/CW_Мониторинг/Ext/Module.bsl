Функция НомерКонтейнераКорректный(НомерКонтейнера) Экспорт
	// Возвращаемое значение: Истина - если номер корректный, Ложь - в противном случае
	
	Если СтрДлина(СокрЛП(НомерКонтейнера)) <> 11 Тогда
        Возврат Ложь;
    КонецЕсли;
    Для Ном = 1 по 4 Цикл
        КодСимволаИзСтроки = КодСимвола(НомерКонтейнера,Ном);
        Если (КодСимволаИзСтроки < 65) или (КодСимволаИзСтроки > 90) Тогда
            Возврат Ложь;
        КонецЕсли; 
    КонецЦикла;
    Для Ном = 5 по 11 Цикл
        КодСимволаИзСтроки = КодСимвола(НомерКонтейнера,Ном);
        Если (КодСимволаИзСтроки < 48) или (КодСимволаИзСтроки > 57) Тогда
            Возврат Ложь;
        КонецЕсли; 
    КонецЦикла;
    
    // сформируем таблицу кодировки символов...
    //-----------------------------------------
    СтрСимволов = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
    ТЗ = Новый ТаблицаЗначений;
    ТЗ.Колонки.Добавить("Символ");
    ТЗ.Колонки.Добавить("Значение");
    Сдвиг = -1;
    Для к = 1 по СтрДлина(СтрСимволов) Цикл
        СтрТЗ = ТЗ.Добавить();
        СтрТЗ.Символ = Сред(СтрСимволов,к,1);
        СтрТЗ.Значение = 10 + к + Сдвиг; 
        Сдвиг = Сдвиг + ?((к = 1) или (к = 11) или (к = 21),1,0);
    КонецЦикла;
    
    // расчитываем сумму по алгоритму...
    //----------------------------------
    Сумма = 0;
    Для к = 1 по 4 Цикл
        СтрТЗ = ТЗ.Найти(Сред(НомерКонтейнера,к,1),"Символ");
        Сумма = Сумма + Число(СтрТЗ.Значение) * Pow(2,к - 1);
    КонецЦикла;
    Для к = 5 по 10 Цикл
        Сумма = Сумма + Число(Сред(НомерКонтейнера,к,1)) * Pow(2,к - 1);
    КонецЦикла;
    
    // получим остаток от деления и 
    // сравним его с контрольной цифрой...
    //------------------------------------
    ОстатокОтДеления = Сумма % 11;
	Если (ОстатокОтДеления = 10) Тогда
		ОстатокОтДеления = 0;
	КонецЕсли; 
    Если ОстатокОтДеления <> Число(Сред(НомерКонтейнера,11,1)) Тогда
        Возврат Ложь;
    Иначе
        Возврат Истина;
    КонецЕсли; 
    
КонецФункции // НомерКонтейнераКорректный()
Функция ГрузоперевозкиЗаказа(Заказ,ТолькоНепомеченные=Истина) Экспорт 
	// --- 
	
	Если (НЕ ЗначениеЗаполнено(Заказ)) Тогда
		Возврат(Новый Массив);		
	КонецЕсли; 
	// ---------------------------------------------------------------------------- 
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	CW_Грузоперевозки.Ссылка
	               |ИЗ
	               |	Справочник.CW_Грузоперевозки КАК CW_Грузоперевозки
	               |ГДЕ
	               |	CW_Грузоперевозки.Заказ = &Заказ
	               |	И ВЫБОР
	               |			КОГДА &Пометка = НЕОПРЕДЕЛЕНО
	               |				ТОГДА ИСТИНА
	               |			ИНАЧЕ CW_Грузоперевозки.ПометкаУдаления = ЛОЖЬ
	               |		КОНЕЦ";
	Запрос.УстановитьПараметр("Заказ", Заказ);
	Запрос.УстановитьПараметр("Пометка", ?(ТолькоНепомеченные,Ложь,Неопределено)); 
	// --- 
	Возврат(Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка"));
	
	// --- 
КонецФункции
// --- 
Процедура ОбновитьКоличествоГрузоперевозокПоЗаказу(Заказ) Экспорт 
	// --- 
	
	Грузоперевозки = ГрузоперевозкиЗаказа(Заказ,Истина);
	// ---------------------------------------------------------------------------- 
	Запись = РегистрыСведений.CW_КоличествоГрузоперевозокПоЗаказам.СоздатьМенеджерЗаписи();
	// --- 
	Запись.Заказ = Заказ;
	Запись.Количество = Грузоперевозки.Количество();
	// --- 
	Запись.Записать(Истина);
	
	// --- 
КонецПроцедуры

Функция ПродолжитьЗаполнениеПредставленийНаСервереВФоне(МассивПредставлений, ДополнительныеПараметры)  Экспорт

	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(Новый УникальныйИдентификатор);
	ПараметрыВыполнения.ОжидатьЗавершение 			= 0; // запускать сразу
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = "Заполнение представлений грузоперевозок заказа";
	ПараметрыВыполнения.ЗапуститьВФоне 				= Истина;
	ПараметрыВыполнения.ЗапуститьНеВФоне 			= ложь;
	
	ПараметрыПроцедуры = Новый Структура;
	ПараметрыПроцедуры.Вставить("МассивГрузоперевозок", ДополнительныеПараметры.Грузоперевозки);
	ПараметрыПроцедуры.Вставить("МассивПредставлений", 	МассивПредставлений);
	
	Возврат ДлительныеОперации.ВыполнитьВФоне("CW_Мониторинг.ОбновитьПредставлениеГрузоперевозок",ПараметрыПроцедуры, ПараметрыВыполнения);
		
КонецФункции 

Процедура ОбновитьПредставлениеГрузоперевозок(ПараметрыПроцедуры, АдресРезультата=Неопределено) Экспорт
	
	ГраницаМассива = ПараметрыПроцедуры.МассивПредставлений.Количество() -1;
	
	СоответствиеПредставлений = Новый Соответствие;
	
	Для Индекс = 0 По ГраницаМассива Цикл
		
		Представление 	= ПараметрыПроцедуры.МассивПредставлений[Индекс];
		Грузоперевозка 	= ПараметрыПроцедуры.МассивГрузоперевозок[Индекс];
		
		ГрузоперевозкаОбъект = Грузоперевозка.ПолучитьОбъект();
		ГрузоперевозкаОбъект.CW_Представление 	= Представление;
		ГрузоперевозкаОбъект.Наименование 		= Представление;
		ГрузоперевозкаОбъект.Записать();
		
		СоответствиеПредставлений.Вставить(Грузоперевозка, Представление);
		
	КонецЦикла;
	
	ПоместитьВоВременноеХранилище(СоответствиеПредставлений, АдресРезультата);
	
КонецПроцедуры     

Процедура ОбновитьПредставленияНаФорме(Форма, ВыделенныеСтроки, АдресРезультата) Экспорт
	
	Журнал_Данные = Форма.Журнал_Данные;
	
	СтрокаЖурнала = Журнал_Данные[0];
	Если Не ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(СтрокаЖурнала, "ссылкаcw_представление") Тогда
		Возврат;
	КонецЕсли;
	
	СоответствиеПредставлений = ПолучитьИзВременногоХранилища(АдресРезультата);
	Для Каждого ИдентифкаторСтроки из ВыделенныеСтроки Цикл
		СтрокаЖурнала = Журнал_Данные.НайтиПоИдентификатору(ИдентифкаторСтроки);
		СтрокаЖурнала["ссылкаcw_представление"] =  СоответствиеПредставлений.Получить(СтрокаЖурнала.Ссылка);
	КонецЦикла;
	
КонецПроцедуры



