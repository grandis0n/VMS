Функция ВыполнитьПроверкуДополнительногоКонтроля(НастройкиОтбора, Грузоперевозка) Экспорт
	
	Если НастройкиОтбора = неопределено тогда
		возврат ложь;
	КонецЕсли;
	
	////Копию создаетм только в случае, если у переданной грузоперевозки не заполнена ссылка,
	////т.е. она еще незаписана.
	////СоздатьКопию = НЕ ЗначениеЗаполнено(Грузоперевозка.Ссылка);
	//СоздатьКопию = Истина;
	//
	//// Если определяется статус для новой (еще не записанной грузоперевозки),
	//// то для корректного определения статуса (в случае если в элементе справочника 
	//// статуса установлена опция "контроль по дополнительным параметрам"), необходимо
	//// чтобы значения параметров были записаны в регистр "CW_ХарактеристикиГрузоперевозок",
	//// (т.к. контроль осуществляется с использованием компановщика). Для новой грузоперевозки
	//// это условие не реализуемо, поэтому временно создадим копию грузоперевозки, определим ее 
	//// статус, вернем его (статус) для вновь создаваемой грузоперевозки, а временную копию 
	//// грузоперевозки удалим.  
	//
	//// для блокировки очистки значений параметров грузоперевозки (в процедуре объекта "ПриКопировании()"),
	//// установим дополнительное свойство, которое будет потом проанализировано в процедуре объекта "ПриКопировании()" 
	////
	////Безуслованя копия грузоперевозки, так как на момент расчета статуса, ГП может быть еще не записана,
	////это исклчючить необходимость повторной записи
	//Если СоздатьКопию Тогда
	//	Если ТипЗнч(Грузоперевозка)=Тип("СправочникСсылка.CW_Грузоперевозки") Тогда
	//		ОбъектКопирования = Грузоперевозка.ПолучитьОбъект();
	//	Иначе
	//		ОбъектКопирования = Грузоперевозка;
	//	КонецЕсли;
	//	
	//	_сф.ст_УстановитьСвойство(ОбъектКопирования.ДополнительныеСвойства,"ИгнорироватьОбработкуКопирования",Истина);
	//	
	//	КопияГрузоперевозки = ОбъектКопирования.Скопировать();
	//	
	//	_сф.ст_УстановитьСвойство(КопияГрузоперевозки.ДополнительныеСвойства,"ВременныйОбъект",Истина);
	//	
	//	КопияГрузоперевозки.Записать();
	//	
	//Иначе
	//	КопияГрузоперевозки = Грузоперевозка;
	//КонецЕсли;

	
	СхемаКомпоновкиДанных 	= ПолучитьОбщийМакет("CW_СхемаОтбораГрузоперевозок");
	Настройки 				= СхемаКомпоновкиДанных.НастройкиПоУмолчанию;

	_УФС.СкопироватьОтбор(НастройкиОтбора.Отбор, Настройки.Отбор);
	
	ДобавитьСсылкуВОтбор = ПроверитьНаличиеСсылкиВОтборе(Настройки.Отбор.Элементы);
	//Для Каждого ЭлементОтбора Из Настройки.Отбор.Элементы Цикл
	//	Если ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Ссылка") Тогда
	//		ДобавитьСсылкуВОтбор = Ложь;
	//		Прервать;
	//	КонецЕсли;
	//КонецЦикла;
	
	Если ДобавитьСсылкуВОтбор Тогда
		ЭлементОтбора 					= Настройки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение 	= Новый ПолеКомпоновкиДанных("Ссылка");
		ЭлементОтбора.ВидСравнения 		= ВидСравненияКомпоновкиДанных.Равно;
		ЭлементОтбора.ПравоеЗначение 	= Грузоперевозка.Ссылка;
		ЭлементОтбора.Использование	 	= Истина;
	КонецЕсли;
	
	ДанныеРасшифровки = Новый ДанныеРасшифровкиКомпоновкиДанных;
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, Настройки, ДанныеРасшифровки,,Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	
	ПроцессорКомпоновкиДанных = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновки, , ДанныеРасшифровки);
	
	Результат = Новый ТаблицаЗначений;
	
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
