Функция ПолучитьСтруктуруПараметров(ПарамтерыПроцедуры) Экспорт
	
	НалоговаяБаза = 0;  
	АдресДерева = ПоместитьВоВременноеХранилище(Неопределено, Новый УникальныйИдентификатор);

	ЗначенияЗаполнения = Новый Структура;
	ЗначенияЗаполнения.Вставить("ДокументРеализации",	ПарамтерыПроцедуры.ВедомыйДокумент);
	ЗначенияЗаполнения.Вставить("ПриложениеРеестра",	ПарамтерыПроцедуры.ПриложениеРеестра);
	
	Если ЗначениеЗаполнено(ПарамтерыПроцедуры.ДокументРеализации) Тогда
		ЗначенияЗаполнения.Вставить("Организация",		ПарамтерыПроцедуры.ВедущийДокумент.Организация);
	КонецЕсли;
	
	СтруктураПарамтеров = Новый Структура;
	СтруктураПарамтеров.Вставить("АдресДерева",			АдресДерева);  
	СтруктураПарамтеров.Вставить("ЗначенияЗаполнения",	ЗначенияЗаполнения);  
	
	Возврат СтруктураПарамтеров;
	
КонецФункции

Функция ПолучитьВедомыйВедущийДокумент(ПараметрКоманды) Экспорт
	
	СтруктураДокументов = Новый Структура("ВедущийДокумент,ВедомыйДокумент", Неопределено, Неопределено);
	
	Если ТипЗнч(ПараметрКоманды) = Тип("ДокументСсылка.CW_ДоходыПоГрузоперевозке") Тогда   
		СтруктураДокументов.ВедущийДокумент = ПараметрКоманды;   
		СтруктураДокументов.ВедомыйДокумент = CW_РеестрыНДС0Сервер.ПолучитьДокументРеализации(ПараметрКоманды);
	КонецЕсли;   
	
	Возврат СтруктураДокументов;
	
КонецФункции

Функция ПолучитьСписокПриложений(ДокументРеализации) Экспорт
	
	Если ЗначениеЗаполнено(ДокументРеализации) Тогда 
		ВедущийДокумент = ПолучитьВедущийДокумент(ДокументРеализации);
		Если ЗначениеЗаполнено(ВедущийДокумент) Тогда
			СписокПриложений  = CW_РеестрыНДС0Дополнительный.ПолучитьСписокПриложенийПоДокументу(ВедущийДокумент);
		КонецЕсли;  
	Иначе
		СписокПриложений = Перечисления.CW_РеестрыНДС0Приложения.ПолучитьСписокПриложений();
	КонецЕсли;
	
	Возврат СписокПриложений;
	
КонецФункции

