
Функция ПолучитьНастройкиСхемыОтбора(СтруктураПараметров) Экспорт
	
	АдресСхемы 		= ПолучитьАдресСхемыНаСервере(СтруктураПараметров); 
	АдресНастроек 	= ПолучитьАдресНастроек(АдресСхемы, СтруктураПараметров);  
	
	Адреса = Новый Структура;
	Адреса.Вставить("АдресНастроек", 	АдресНастроек); 
	Адреса.Вставить("АдресСхемы", 		АдресСхемы); 
	
	Возврат Адреса;
	
КонецФункции

Функция ПолучитьАдресСхемыНаСервере(СтруктураПараметров)     
	
	МенеджерОбъекта = ОбщегоНазначения.МенеджерОбъектаПоСсылке(СтруктураПараметров.ПустаяСсылка);	
	
	Попытка
		Схема = МенеджерОбъекта.ПолучитьМакет(СтруктураПараметров.ИмяМакета);
	Исключение
		ВызватьИсключение "Некорректное имя макета для заполнения!";
	КонецПопытки;
	
	Возврат ПоместитьВоВременноеХранилище(Схема, Новый УникальныйИдентификатор);
	
КонецФункции    

Функция ПолучитьАдресНастроек(АдресСхемы, СтруктураПараметров)  
	
	Схема = ПолучитьИзВременногоХранилища(АдресСхемы); 
	
	КомпоновщикНастроек = Новый КомпоновщикНастроекКомпоновкиДанных;
	КомпоновщикНастроек.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(АдресСхемы));	
	КомпоновщикНастроек.ЗагрузитьНастройки(Схема.НастройкиПоУмолчанию);

	КомпоновщикНастроек.Настройки.Отбор.Элементы.Очистить();
	
	//Заполнение параметров Компоновщика настроек
	Если СтруктураПараметров.Свойство("ПараметрыДанных") 
		И ТипЗнч(СтруктураПараметров.ПараметрыДанных)= Тип("Структура") Тогда
		
		Для Каждого КлючЗначение из СтруктураПараметров.ПараметрыДанных Цикл
			КомпоновщикНастроек.Настройки.ПараметрыДанных.УстановитьЗначениеПараметра(КлючЗначение.Ключ, КлючЗначение.Значение);
		КонецЦикла;
	Конецесли;
	//Заполнение параметров Компоновщика настроек
	
	//Заполнение предопределенного обора Компоновщика настроек
	Если СтруктураПараметров.Свойство("Отбор") 
		И ТипЗнч(СтруктураПараметров.Отбор)= Тип("Соответствие") Тогда
		
		Для Каждого КлючЗначение из СтруктураПараметров.Отбор Цикл
			ЭлементОтбора = КомпоновщикНастроек.Настройки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
			ЭлементОтбора.Использование 	= Истина;  
			ЭлементОтбора.ЛевоеЗначение 	= Новый ПолеКомпоновкиДанных(КлючЗначение.Ключ);
			
			Если ТипЗнч(КлючЗначение.Значение) = Тип("СписокЗначений") Тогда  
				ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке;
			Иначе
				ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
			КонецЕсли; 
			
			ЭлементОтбора.ПравоеЗначение 	= КлючЗначение.Значение;
		КонецЦикла; 
		
	Конецесли;
	//Заполнение предопределенного обора Компоновщика настроек
	
	НастройкиКомпоновщика = КомпоновщикНастроек.ПолучитьНастройки(); 
	
	Возврат ПоместитьВоВременноеХранилище(НастройкиКомпоновщика, Новый УникальныйИдентификатор);
	
КонецФункции

Функция ПолучитьАдресТаблицыРезультата(Настройки, ВидКоллекции) Экспорт 
	
	Схема = ПолучитьИзВременногоХранилища(Настройки.АдресСхемы);
	НастройкиКомпоновки = ПолучитьИзВременногоХранилища(Настройки.АдресНастроек);  
	
	КомпоновщикМакета 	= Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки 	= КомпоновщикМакета.Выполнить(Схема, НастройкиКомпоновки,,, Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	
	ПроцессорКомпоновкиДанных 	= Новый ПроцессорКомпоновкиДанных;    
	ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновки);
	
	Коллекция = Новый ТаблицаЗначений;   
	
	ПроцессорВыводаРезультата 	= Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений; 
	ПроцессорВыводаРезультата.УстановитьОбъект(Коллекция);
    ПроцессорВыводаРезультата.Вывести(ПроцессорКомпоновкиДанных, Истина);
	
	Возврат ПоместитьВоВременноеХранилище(Коллекция, Новый УникальныйИдентификатор);

КонецФункции     