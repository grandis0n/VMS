Процедура ПриСозданииНаСервере(Форма, Отказ, СтандартнаяОбработка) Экспорт
	
	Объект = Форма.Объект;
	
	Если Форма["ТаблицаОформления"].Количество() = 0 Тогда  
		НастройкиОформления = ПолучитьПустуюТаблицуОформления(Объект.ЭтоГруппа);
		Форма["ТаблицаОформления"].Загрузить(НастройкиОформления);
	КонецЕсли;   
	
КонецПроцедуры

Процедура ЗаполнитьТаблицуОформления(Форма, ТекущийОбъект) Экспорт

	Объект = Форма.Объект; 
	ЭтоГруппа = Объект.ЭтоГруппа;
	
	НоваяТаблицаОформления = ПолучитьПустуюТаблицуОформления(ЭтоГруппа);
	
	НастройкиОформления= ТекущийОбъект.НастройкиОформления.Получить();
	Если ТипЗнч(НастройкиОформления) = Тип("Структура") Тогда  
		Для каждого КлючЗначение из НастройкиОформления Цикл
			НайденаняСтрока = НоваяТаблицаОформления.Найти(КлючЗначение.Ключ, "Параметр");
			Если НайденаняСтрока <> Неопределено Тогда
				НайденаняСтрока.Значение 	= КлючЗначение.Значение;	
				НайденаняСтрока.Выбор 		= Истина;
			Конецесли;
		КонецЦикла;
	КонецЕсли;  
	
	Форма["ТаблицаОформления"].Загрузить(НоваяТаблицаОформления);
	
КонецПроцедуры

Процедура ЗаписатьНастройкиОформления(ЭтаФорма, ТекущийОбъект) Экспорт

	НастройкиОформления = Новый Структура;
	
	НайденныеСтроки = ЭтаФорма["ТаблицаОформления"].НайтиСтроки(Новый Структура("Выбор", Истина));
	Для Каждого СтрокаСтиля из НайденныеСтроки Цикл
		НастройкиОформления.Вставить(СтрокаСтиля.Параметр, СтрокаСтиля.Значение);
	КонецЦикла;
	
	ТекущийОбъект.НастройкиОформления 	= Новый ХранилищеЗначения(НастройкиОформления);

КонецПроцедуры

Процедура ТаблицаОформленияПриИзмененииЗначения(ЭтаФорма, ТекущаяСтрока) Экспорт
	
	СоответствиеТипаПараметра = CW_КлючевыеПоказателиСервер.ПолучитьСоответствиеТипаПараметра();
	
	СтрокаТекущая = ЭтаФорма["ТаблицаОформления"].НайтиПоИдентификатору(ТекущаяСтрока);
	СтрокаТекущая.Выбор = (СтрокаТекущая.Значение <> СоответствиеТипаПараметра.Получить(СтрокаТекущая.Параметр));
	
	Если Не СтрокаТекущая.Выбор Тогда
		СтрокаТекущая.Значение = СоответствиеТипаПараметра.Получить(СтрокаТекущая.Параметр);	
	КонецЕсли;
	
КонецПроцедуры 

Процедура ТаблицаОформленияПриИзмененииФлага(ЭтаФорма, ТекущаяСтрока) Экспорт
	
	СоответствиеТипаПараметра = CW_КлючевыеПоказателиСервер.ПолучитьСоответствиеТипаПараметра();
	
	СтрокаТекущая = ЭтаФорма["ТаблицаОформления"].НайтиПоИдентификатору(ТекущаяСтрока);
	
	Если Не СтрокаТекущая.Выбор Тогда
		СтрокаТекущая.Значение = СоответствиеТипаПараметра.Получить(СтрокаТекущая.Параметр);	
	КонецЕсли;
	
КонецПроцедуры 


Функция ПолучитьНастройкиКлючевыхПоказателей() Экспорт
	
	Запрос = Новый Запрос; 
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.Текст = "ВЫБРАТЬ
	|	CW_НастройкиКлючевыхПоказателей.Ссылка КАК Ссылка,
	|	CW_НастройкиКлючевыхПоказателей.Родитель КАК Родитель,
	|	CW_НастройкиКлючевыхПоказателей.Код КАК Код,
	|	CW_НастройкиКлючевыхПоказателей.Наименование КАК Наименование,
	|	CW_НастройкиКлючевыхПоказателей.ИндексЭлемента КАК ИндексЭлемента,
	|	CW_НастройкиКлючевыхПоказателей.НастройкиОформления КАК НастройкиОформления,
	|	CW_НастройкиКлючевыхПоказателей.НастройкиУсловногоОформления КАК НастройкиУсловногоОформления,
	|	CW_НастройкиКлючевыхПоказателей.ЭтоГруппа КАК ЭтоГруппа
	|ПОМЕСТИТЬ ВТ_Показатели
	|ИЗ
	|	Справочник.CW_НастройкиКлючевыхПоказателей КАК CW_НастройкиКлючевыхПоказателей
	|ГДЕ
	|	CW_НастройкиКлючевыхПоказателей.Владелец = &Владелец
	|	И CW_НастройкиКлючевыхПоказателей.НеИспользуется = ЛОЖЬ
	|	И CW_НастройкиКлючевыхПоказателей.ПометкаУдаления = ЛОЖЬ";
	
	Запрос.УстановитьПараметр("Владелец", ПараметрыСеанса.ТекущийПользователь);
	Запрос.Выполнить();
	
	Запрос.Текст = "ВЫБРАТЬ
	|	ВТ_Показатели.Ссылка КАК Ссылка,
	|	ВТ_Показатели.Код КАК Код,
	|	ВТ_Показатели.Наименование КАК Наименование,
	|	ВТ_Показатели.ИндексЭлемента КАК ИндексЭлемента,
	|	ВТ_Показатели.НастройкиОформления КАК НастройкиОформления
	|ИЗ
	|	ВТ_Показатели КАК ВТ_Показатели
	|ГДЕ
	|	ВТ_Показатели.ЭтоГруппа = ИСТИНА
	|
	|УПОРЯДОЧИТЬ ПО
	|	ИндексЭлемента";
	
	РезультатГруппы = Запрос.Выполнить();   
	
	ГруппыПокзателей = Новый Соответствие; 
	мПорядокГрупп 	 = Новый Массив;
	
	Выборка = РезультатГруппы.Выбрать();
	Пока Выборка.Следующий() Цикл   
		
		СтруктураПоказателя = Новый Структура;
		СтруктураПоказателя.Вставить("Код",				Выборка.Код);
		СтруктураПоказателя.Вставить("Наименование",	Выборка.Наименование); 
		
		ДанныеСтиля = Выборка.НастройкиОформления.получить(); 
		Если ТипЗнч(ДанныеСтиля) = Тип("Структура") Тогда 
			СтруктураПоказателя.Вставить("ДанныеСтиля", ДанныеСтиля);
		КонецЕсли; 
		
		ГруппыПокзателей.Вставить(Выборка.Ссылка, СтруктураПоказателя);  
		
		мПорядокГрупп.Добавить(Выборка.Ссылка);
		
	КонецЦикла;
	
	Запрос.Текст = "ВЫБРАТЬ
	|	ВТ_Показатели.Ссылка КАК Ссылка,
	|	ВТ_Показатели.Родитель КАК Родитель,
	|	ВТ_Показатели.Код КАК Код,
	|	ВТ_Показатели.Наименование КАК Наименование,
	|	ВТ_Показатели.ИндексЭлемента КАК ИндексЭлемента,
	|	ВТ_Показатели.НастройкиОформления КАК НастройкиОформления,
	|	ВТ_Показатели.НастройкиУсловногоОформления КАК НастройкиУсловногоОформления
	|ИЗ
	|	ВТ_Показатели КАК ВТ_Показатели
	|ГДЕ
	|	ВТ_Показатели.ЭтоГруппа = ЛОЖЬ
	|
	|УПОРЯДОЧИТЬ ПО
	|	ИндексЭлемента";  
	
	РезультатЭлементы = Запрос.Выполнить();
	
	Показатели = Новый Соответствие;
	мПорядокПоказателей = Новый Массив;
	
	Выборка = РезультатЭлементы.Выбрать();
	Пока Выборка.Следующий() Цикл  
		
		Если ЗначениеЗаполнено(Выборка.Родитель)
			И мПорядокГрупп.Найти(Выборка.Родитель) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		СтруктураПоказателя = Новый Структура;
		СтруктураПоказателя.Вставить("Код", 				Выборка.Код);
		СтруктураПоказателя.Вставить("Наименование", 		Выборка.Наименование); 
		СтруктураПоказателя.Вставить("Родитель", 			Выборка.Родитель); 
		
		ДанныеСтиля = Выборка.НастройкиОформления.получить(); 
		Если ТипЗнч(ДанныеСтиля) = Тип("Структура") Тогда 
			СтруктураПоказателя.Вставить("ДанныеСтиля", ДанныеСтиля);
		КонецЕсли; 
		
		ДанныеУсловногоОформления = Выборка.НастройкиУсловногоОформления.получить(); 
		Если ТипЗнч(ДанныеСтиля) = Тип("Структура") Тогда 
			СтруктураПоказателя.Вставить("УсловноеОформление", ДанныеУсловногоОформления);
		КонецЕсли; 
		
		Показатели.Вставить(Выборка.Ссылка, СтруктураПоказателя);  
		
		мПорядокПоказателей.Добавить(Выборка.Ссылка);
		
	КонецЦикла; 
	
	КлючевыеПоказатели 	= Новый Соответствие;
	КлючевыеПоказатели.Вставить("ГруппыПокзателей", 	ГруппыПокзателей);
	КлючевыеПоказатели.Вставить("Показатели", 			Показатели);
	КлючевыеПоказатели.Вставить("ПорядокГрупп", 		Новый ФиксированныйМассив(мПорядокГрупп));
	КлючевыеПоказатели.Вставить("ПорядокПоказателей",	Новый ФиксированныйМассив(мПорядокПоказателей));
	
	Возврат КлючевыеПоказатели;
	
КонецФункции

Процедура ПолучитьЗначенияКлючевыхПоказателей(СтруктураПараметров, АдресРезультата) Экспорт

	КлючевыеПоказатели = Новый Соответствие;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	CW_НастройкиКлючевыхПоказателей.Ссылка КАК Ссылка,
	|	CW_НастройкиКлючевыхПоказателей.Код КАК Код,
	|	CW_НастройкиКлючевыхПоказателей.Наименование КАК Наименование
	|ИЗ
	|	Справочник.CW_НастройкиКлючевыхПоказателей КАК CW_НастройкиКлючевыхПоказателей
	|ГДЕ
	|	CW_НастройкиКлючевыхПоказателей.Владелец = &Владелец
	|	И CW_НастройкиКлючевыхПоказателей.Ссылка В(&МассивПоказателей)";  
	
	Запрос.УстановитьПараметр("Владелец", 			ПараметрыСеанса.ТекущийПользователь);
	Запрос.УстановитьПараметр("МассивПоказателей", 	СтруктураПараметров.КлючевыеПоказатели);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		ЗначениеПоказателя = Справочники.CW_НастройкиКлючевыхПоказателей.ПолучитьРезультат(Выборка.Ссылка);
		КлючевыеПоказатели.Вставить(Выборка.Ссылка, ЗначениеПоказателя);
	КонецЦикла;
	
	ПоместитьВоВременноеХранилище(КлючевыеПоказатели, АдресРезультата);
	
КонецПроцедуры


Функция ПолучитьПустуюТаблицуОформления(Знач ЭтоГруппа)
	
	СоответствиеТипаПараметра = ПолучитьСоответствиеТипаПараметра();
	
	НоваяТаблицаОформления = ПустаяТаблицаОформления();  
	
	ДобавитьОсновныеЭлементыСтиля(НоваяТаблицаОформления, СоответствиеТипаПараметра); 
	
	Если ЭтоГруппа Тогда
		ДобавитьЭлементыСтиляДляГруппы(НоваяТаблицаОформления, СоответствиеТипаПараметра); 
	Иначе
		ДобавитьЭлементыСтиляДляРеквизита(НоваяТаблицаОформления, СоответствиеТипаПараметра); 
	КонецЕсли; 
	
	ДобавитьОтображениеЗаголовка(НоваяТаблицаОформления, СоответствиеТипаПараметра);

	Возврат НоваяТаблицаОформления;

КонецФункции  

Функция ПолучитьПустуюТаблицуУсловногоОформления() Экспорт
	
	СоответствиеТипаПараметра = ПолучитьСоответствиеТипаПараметра();
	
	НоваяТаблицаОформления = ПустаяТаблицаОформления();  
	
	ДобавитьОсновныеЭлементыСтиля(НоваяТаблицаОформления, СоответствиеТипаПараметра); 
	ДобавитьОтображениеРамки(НоваяТаблицаОформления, СоответствиеТипаПараметра);
	
	Возврат НоваяТаблицаОформления;
	
КонецФункции

Функция ПустаяТаблицаОформления() 
	
	ТипыЗначения = Новый Массив;
	ТипыЗначения.Добавить(Тип("Цвет"));
	ТипыЗначения.Добавить(Тип("Шрифт"));
	ТипыЗначения.Добавить(Тип("Булево"));
	ТипыЗначения.Добавить(Тип("Строка"));
	ТипыЗначения.Добавить(Тип("Число"));
	ТипыЗначения.Добавить(Тип("ГоризонтальноеПоложение"));
	
	ПустаяТаблица = Новый ТаблицаЗначений;
	ПустаяТаблица.Колонки.Добавить("Выбор", 		Новый ОписаниеТипов("Булево"));
	ПустаяТаблица.Колонки.Добавить("Представление", Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(25)));
	ПустаяТаблица.Колонки.Добавить("Параметр", 		Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(25)));
	ПустаяТаблица.Колонки.Добавить("Значение", 		Новый ОписаниеТипов(ТипыЗначения));
	
	Возврат ПустаяТаблица;
	
КонецФункции

Процедура ДобавитьОсновныеЭлементыСтиля(ПустаяТаблица, СоответствиеТипаПараметра)  
	
	НоваяСтрока = ПустаяТаблица.Добавить();
	НоваяСтрока.Представление 	= "Цвет Фона";
	НоваяСтрока.Параметр		= "ЦветФона";
	НоваяСтрока.Значение		= СоответствиеТипаПараметра.получить("ЦветФона");
	
	НоваяСтрока = ПустаяТаблица.Добавить(); 
	НоваяСтрока.Представление 	= "Цвет текста";
	НоваяСтрока.Параметр		= "ЦветТекста";
	НоваяСтрока.Значение		= СоответствиеТипаПараметра.получить("ЦветТекста");
	
	НоваяСтрока = ПустаяТаблица.Добавить();
	НоваяСтрока.Представление 	= "Шрифт";
	НоваяСтрока.Параметр		= "Шрифт";
	НоваяСтрока.Значение		= СоответствиеТипаПараметра.получить("Шрифт");

КонецПроцедуры  

