Процедура УстановитьИнтервалОбновленияДанных(Знач ИнтревалОбновления) Экспорт
	
	ЗаписьРегистра = РегистрыСведений.CW_НастройкиПользователей.СоздатьМенеджерЗаписи();
	ЗаписьРегистра.Пользователь = ПараметрыСеанса.ТекущийПользователь;
	ЗаписьРегистра.Прочитать();  
	
	Если Не ЗаписьРегистра.Выбран() Тогда
		Возврат;
	КонецЕсли;    
	
	ЗаписьРегистра.ИнтревалОбновленияКлючевыхПоказателей = ИнтревалОбновления;
	ЗаписьРегистра.Записать();

КонецПроцедуры

Функция ПолучитьГруппыСправочника() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	CW_НастройкиКлючевыхПоказателей.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.CW_НастройкиКлючевыхПоказателей КАК CW_НастройкиКлючевыхПоказателей
	|ГДЕ
	|	CW_НастройкиКлючевыхПоказателей.Владелец = &Владелец
	|	И CW_НастройкиКлючевыхПоказателей.ЭтоГруппа = ИСТИНА
	|	И CW_НастройкиКлючевыхПоказателей.ПометкаУдаления = ЛОЖЬ
	|	И CW_НастройкиКлючевыхПоказателей.НеИспользуется = ЛОЖЬ";   
	
	Запрос.УстановитьПараметр("Владелец", ПараметрыСеанса.ТекущийПользователь);
	
	РезультатЗапроса = Запрос.Выполнить(); 
	
	Возврат РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("Ссылка");
	
КонецФункции

Процедура УстановитьПримерОформленияНаСервере(ОформляемыйЭлемент, ТаблицаОформления) Экспорт
	
	СоответствиеЭлементвСтиля = Новый Соответствие; 
	СоответствиеЭлементвСтиля.Вставить("ЦветТекста", "ЦветТекстаЗаголовка");
	СоответствиеЭлементвСтиля.Вставить("Шрифт",	     "ШрифтЗаголовка");
	
	СоответствиеЭлементовГоризонтальногоПоложения = CW_КлючевыеПоказателиСервер.СоответствиеЭлементовГоризонтальногоПоложения();	
	
	Для Каждого СтрокаОформления из ТаблицаОформления Цикл   
		
		ИмяЭлементаСтиля = СтрокаОформления.Параметр;
		
		НайденныйЭлемент = СоответствиеЭлементвСтиля.Получить(СтрокаОформления.Параметр); 
		Если НайденныйЭлемент <> Неопределено Тогда
			ИмяЭлементаСтиля = НайденныйЭлемент;
		КонецЕсли;
		
		Если ИмяЭлементаСтиля = "Рамка" Тогда   
			Если СтрокаОформления.Значение Тогда
				ОформляемыйЭлемент.Рамка = Новый Рамка(ТипРамкиЭлементаУправления.Одинарная);	
			Иначе 
				ОформляемыйЭлемент.Рамка = Новый Рамка(ТипРамкиЭлементаУправления.БезРамки);	
			КонецЕсли;
		ИначеЕсли ИмяЭлементаСтиля = "ОтображатьЗаголовок"    
			И ТипЗнч(ОформляемыйЭлемент) = Тип("ПолеФормы") Тогда
			Если СтрокаОформления.Значение Тогда
				ОформляемыйЭлемент.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Авто;
			Иначе
				ОформляемыйЭлемент.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
			Конецесли; 
		ИначеЕсли ИмяЭлементаСтиля = "ГоризонтальноеПоложение" Тогда   
			ОформляемыйЭлемент.ГоризонтальноеПоложение = СоответствиеЭлементовГоризонтальногоПоложения.Получить(СтрокаОформления.Значение);	
		Иначе
			ОформляемыйЭлемент[ИмяЭлементаСтиля] =  СтрокаОформления.Значение; 
			
			Если ТипЗнч(ОформляемыйЭлемент) = Тип("ПолеФормы")
				и НайденныйЭлемент <> Неопределено Тогда
				ОформляемыйЭлемент[СтрокаОформления.Параметр] =  СтрокаОформления.Значение; 
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры
