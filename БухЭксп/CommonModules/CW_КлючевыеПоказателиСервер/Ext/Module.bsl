Функция ПолучитьСоответствиеТипаПараметра() Экспорт
	
	СоответствиеТипаПараметра = Новый Соответствие;
	СоответствиеТипаПараметра.Вставить("ЦветФона", 		Новый Цвет);
	СоответствиеТипаПараметра.Вставить("ЦветТекста", 	Новый Цвет);
	СоответствиеТипаПараметра.Вставить("Шрифт", 		Новый Шрифт);
	СоответствиеТипаПараметра.Вставить("Рамка", 		Ложь);
	СоответствиеТипаПараметра.Вставить("Формат", 		"");    
	СоответствиеТипаПараметра.Вставить("Ширина", 		0);    
	СоответствиеТипаПараметра.Вставить("ОтображатьЗаголовок", 		Истина);    
	СоответствиеТипаПараметра.Вставить("ГоризонтальноеПоложение", 	ГоризонтальноеПоложение.Авто);    
	
	Возврат СоответствиеТипаПараметра;
	
КонецФункции

Функция СоответствиеЭлементовГоризонтальногоПоложения() Экспорт
	
	Соответствие = Новый Соответствие;
	Соответствие.Вставить(ГоризонтальноеПоложение.Авто, 	ГоризонтальноеПоложениеЭлемента.Авто);
	Соответствие.Вставить(ГоризонтальноеПоложение.Лево, 	ГоризонтальноеПоложениеЭлемента.Лево);
	Соответствие.Вставить(ГоризонтальноеПоложение.Право, 	ГоризонтальноеПоложениеЭлемента.Право);
	Соответствие.Вставить(ГоризонтальноеПоложение.Центр, 	ГоризонтальноеПоложениеЭлемента.Центр);
	Соответствие.Вставить(ГоризонтальноеПоложение.ПоШирине, ГоризонтальноеПоложениеЭлемента.Центр);
	
	Возврат Соответствие;
	
КонецФункции

Процедура ФормаКлючевыхПоказателейНаНачальнойСтранце(Режим) Экспорт
	
	//Режим = Добавить(1), Отключить(0)   
	
	Если Режим = 1 Тогда
		ДобавитьФормуКлючевыхПоказателейНаНачальнойСтранце(); 
	КонецЕсли;
	Если Режим = 0 Тогда
		УдалитьФормуКлючевыхПоказателейНаНачальнойСтранце();		
	КонецЕсли;
	
	
КонецПроцедуры 

Процедура ДобавитьФормуКлючевыхПоказателейНаНачальнойСтранце() 
	
	Пользователь 		= ПользователиИнформационнойБазы.ТекущийПользователь();
	НастройкиНачальнойСтраницы 	= ХранилищеСистемныхНастроек.Загрузить("Общее/НастройкиНачальнойСтраницы",,,Пользователь.Имя);

	Если НастройкиНачальнойСтраницы = Неопределено Тогда
		НастройкиНачальнойСтраницы = Новый НастройкиНачальнойСтраницы;
		СоставФорм = Новый СоставФормНачальнойСтраницы;
	Иначе
		СоставФорм = НастройкиНачальнойСтраницы.ПолучитьСоставФорм();
	КонецЕсли; 
	
	ИмяФормыКлючевыхПоказателей = ИмяФормыКлючевыхПоказателей();
	
	СоставФорм.ПраваяКолонка.Добавить(ИмяФормыКлючевыхПоказателей);

	НастройкиНачальнойСтраницы.УстановитьСоставФорм(СоставФорм);
	
	ХранилищеСистемныхНастроек.Сохранить("Общее/НастройкиНачальнойСтраницы",, НастройкиНачальнойСтраницы,, Пользователь.Имя);
	
КонецПроцедуры

Процедура УдалитьФормуКлючевыхПоказателейНаНачальнойСтранце()
	
	ИмяФормыКлючевыхПоказателей = ИмяФормыКлючевыхПоказателей();
	
	Пользователь 		= ПользователиИнформационнойБазы.ТекущийПользователь();
	НастройкиНачальнойСтраницы 	= ХранилищеСистемныхНастроек.Загрузить("Общее/НастройкиНачальнойСтраницы",,, Пользователь.Имя);
	Если НастройкиНачальнойСтраницы = Неопределено Тогда
		Возврат;
	КонецЕсли;

	СоставФорм = НастройкиНачальнойСтраницы.ПолучитьСоставФорм();
	
	ИндексФормы = СоставФорм.ЛеваяКолонка.Найти(ИмяФормыКлючевыхПоказателей);
	Если ИндексФормы <> Неопределено Тогда
		СоставФорм.ЛеваяКолонка.Удалить(ИндексФормы);
	КонецЕсли;
	ИндексФормы = СоставФорм.ПраваяКолонка.Найти(ИмяФормыКлючевыхПоказателей);
	Если ИндексФормы <> Неопределено Тогда
		СоставФорм.ПраваяКолонка.Удалить(ИндексФормы);
	КонецЕсли;
	
	НастройкиНачальнойСтраницы.УстановитьСоставФорм(СоставФорм);
	ХранилищеСистемныхНастроек.Сохранить("Общее/НастройкиНачальнойСтраницы",, НастройкиНачальнойСтраницы,, Пользователь.Имя);
	
КонецПроцедуры

Функция ТекущийРежимФормыКлючевыхПоказателейНаНачальнойСтранце() Экспорт

	//Режим = Добавить(1), Отключить(0)   
	
	ИмяФормыКлючевыхпоказателей = ИмяФормыКлючевыхпоказателей();
	Пользователь	= ПользователиИнформационнойБазы.ТекущийПользователь();
	
	НастройкиНачальнойСтраницы 	= ХранилищеСистемныхНастроек.Загрузить("Общее/НастройкиНачальнойСтраницы",,,Пользователь.Имя);
	Если НастройкиНачальнойСтраницы = Неопределено Тогда
		Возврат 0;
	КонецЕсли;
	
	СоставФорм = НастройкиНачальнойСтраницы.ПолучитьСоставФорм();
	
	ИндексФормыЛеваяКолонка = СоставФорм.ЛеваяКолонка.Найти(ИмяФормыКлючевыхпоказателей);
	ИндексФормыПраваяКолонка = СоставФорм.ПраваяКолонка.Найти(ИмяФормыКлючевыхпоказателей);
	Если ИндексФормыЛеваяКолонка <> Неопределено 
		или ИндексФормыПраваяКолонка <> Неопределено Тогда
		Возврат 1;
	КонецЕсли;
	
	Возврат 0;
	
КонецФункции

