#Область ПрограммныйИнтерфейс

// Отправляет данные во все приложения текущего пользователя, относящиеся к БП,
// через двухшаговый протокол БТС (POST + PUT). За результатом обработки не возвращаемся.
//
// Параметры:
//  ИдентификаторДанных - Строка - например, "news_read" - идентификатор данных для async-хранилища
//  Параметры           - Структура - любые параметры, специфичиные для конкретного вида оповещений (например, УИН новостей)
//  ОтборПриложений     - Структура, Неопределено - отбор приложений по полям:
//                        "Код, Наименование, АдресПриложения, ИмяВидаПриложения, СостояниеПриложения";
//                        значение поля отбора может быть как одиночным значением, так и Массивом/ФиксированнымМассивом
//  ИмяОповещения       - Строка  - имя оповещения для события ЖР (например, "Прочтение новостей")
//
Процедура ОповеститьПриложенияПользователя(ИдентификаторДанных, Параметры, ОтборПриложений = Неопределено, ИмяОповещения = "") Экспорт
	
	Приложения = ПрограммныйИнтерфейсСервисаБППовтИсп.ПриложенияПользователя();
	Если Приложения = Неопределено Или Приложения.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	КодЭтогоПриложения = РаботаВМоделиСервиса.ЗначениеРазделителяСеанса();
	
	ДанныеJSON = ОбщегоНазначения.ЗначениеВJSON(Параметры);
	
	Для Каждого Приложение Из Приложения Цикл
		Если Приложение.Код = КодЭтогоПриложения Тогда
			Продолжить;
		КонецЕсли;
		
		Если Не ПроверитьОтбор(Приложение, ОтборПриложений) Тогда
			Продолжить;
		КонецЕсли;
		
		ОтправитьДанныеВПриложение(Приложение.АдресПриложения, ИдентификаторДанных, ДанныеJSON, ИмяОповещения);
	КонецЦикла;
	
КонецПроцедуры

// Возвращает структуру отбора приложений с допустимыми ключами и пустыми значениями.
//
// Возвращаемое значение:
//  Структура - ключи:
//   * КодКонфигурации - Строка - код конфигурации
//   * ВерсияКонфигурации - Строка - версия конфигурации
//   * НаименованиеКонфигурации - Строка - наименование конфигурации
//   * КодВидаПриложения - Строка - код вида приложения
//   * ИмяВидаПриложения - Строка - имя вида приложения
//   * СостояниеПриложения - ПеречислениеСсылка.СостоянияПриложений - состояние приложения
//
Функция НовыйОтборПриложений() Экспорт
	
	СтруктураОтбора = Новый Структура;
	СтруктураОтбора.Вставить("КодКонфигурации",          "");
	СтруктураОтбора.Вставить("ВерсияКонфигурации",       "");
	СтруктураОтбора.Вставить("НаименованиеКонфигурации", "");
	СтруктураОтбора.Вставить("КодВидаПриложения",        "");
	СтруктураОтбора.Вставить("ИмяВидаПриложения",        "");
	СтруктураОтбора.Вставить("СостояниеПриложения",      Неопределено);

	Возврат СтруктураОтбора;
	
КонецФункции

// См. СтандартныеПодсистемыСервер.ПриОпределенииМетодовРазрешенныхДляВызоваКакПроизвольныйКод
Процедура ПриОпределенииМетодовРазрешенныхДляВызоваКакПроизвольныйКод(Методы) Экспорт
	
	Методы.Вставить("ОповеститьПриложенияПользователя", Истина);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПроверитьОтбор(Приложение, ОтборПриложений)
	
	Если ОтборПриложений = Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	
	Для Каждого ЭлементОтбора Из ОтборПриложений Цикл
		
		ЗначениеОтбора = ЭлементОтбора.Значение;
		Если Не ЗначениеЗаполнено(ЗначениеОтбора) Тогда
			Продолжить;
		КонецЕсли;
		
		ЗначениеПоля = Неопределено;
		Если Не Приложение.Свойство(ЭлементОтбора.Ключ, ЗначениеПоля) Тогда
			Продолжить;
		КонецЕсли;
		
		Если ТипЗнч(ЗначениеОтбора) = Тип("Массив") Или ТипЗнч(ЗначениеОтбора) = Тип("ФиксированныйМассив") Тогда
			Возврат ЗначениеОтбора.Найти(ЗначениеПоля) <> Неопределено;
		Иначе
			Возврат ЗначениеПоля = ЗначениеОтбора;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

// Отправляет данные в конкретное приложение через механизм асинхронного получения данных (БТС).
// Двухшаговый протокол на одном HTTPСоединении:
//  1) POST к /hs/dt/storage/async/{Идентификатор} с IBSession: start → Location и Set-Cookie (HTTP 200)
//  2) PUT к Location с Cookie, IBSession: finish и JSON-телом → general.response = 10200 (HTTP 201)
//
// Параметры:
//  АдресПриложения     - Строка - URL приложения
//  ИдентификаторДанных - Строка
//  ДанныеJSON          - Строка - JSON для тела PUT-запроса
//  ИмяОповещения       - Строка - имя оповещения для события ЖР
//
Процедура ОтправитьДанныеВПриложение(АдресПриложения, ИдентификаторДанных, ДанныеJSON, ИмяОповещения = "")
	
	ИмяОповещенияДляЖР = ?(ЗначениеЗаполнено(ИмяОповещения), ИмяОповещения, ИдентификаторДанных);
	ИмяСобытия = СтрШаблон(
		НСтр("ru = 'Оповещение приложений пользователя.%1'", ОбщегоНазначения.КодОсновногоЯзыка()),
		ИмяОповещенияДляЖР);
	
	СвойстваОтвета = Неопределено;
	Если Не ОбщегоНазначения.ПодсистемаСуществует("ТехнологияСервиса.ВнешнийПрограммныйИнтерфейс") Тогда
		ЗаписьЖурналаРегистрации(ИмяСобытия,
			УровеньЖурналаРегистрации.Ошибка,,,
			НСтр("ru = 'Недоступна подсистема ТехнологияСервиса.ВнешнийПрограммныйИнтерфейс'", ОбщегоНазначения.КодОсновногоЯзыка()));
		Возврат;
	КонецЕсли;
	
	МодульПрограммныйИнтерфейсСервиса = ОбщегоНазначения.ОбщийМодуль("ПрограммныйИнтерфейсСервиса");
	ТокенДоступа = МодульПрограммныйИнтерфейсСервиса.ДействующийТокенДоступа(, Ложь, СвойстваОтвета);
	
	Если СвойстваОтвета <> Неопределено И СвойстваОтвета.Ошибка Тогда
		ЗаписьЖурналаРегистрации(ИмяСобытия,
			УровеньЖурналаРегистрации.Ошибка,,, СвойстваОтвета.Сообщение);
		Возврат;
	КонецЕсли;
	
	ЭлементыАдреса = ОбщегоНазначенияКлиентСервер.СтруктураURI(АдресПриложения);
	
	ЗащищенноеСоединение = Неопределено;
	Если НРег(ЭлементыАдреса.Схема) = "https" Тогда
		ЗащищенноеСоединение = Новый ЗащищенноеСоединениеOpenSSL;
	КонецЕсли;
	
	Соединение = Новый HTTPСоединение(
		ЭлементыАдреса.Хост,
		ЭлементыАдреса.Порт,
		,,
		ПолучениеФайловИзИнтернета.ПолучитьПрокси(ЭлементыАдреса.Схема),
		20,
		ЗащищенноеСоединение);
	
	БазовыйПуть = ЭлементыАдреса.ПутьНаСервере;
	
	ЗаголовокАвторизации = СтрШаблон("Bearer %1", ТокенДоступа);
	
	// Шаг 1: POST с IBSession: start (без тела)
	ПутьPOST = СтрШаблон("%1/hs/dt/storage/async/%2/", БазовыйПуть, ИдентификаторДанных);
	ЗапросPOST = Новый HTTPЗапрос(ПутьPOST);
	ЗапросPOST.Заголовки.Вставить("Authorization", ЗаголовокАвторизации);
	ЗапросPOST.Заголовки.Вставить("IBSession", "start");
	
	ОтветPOST = Неопределено;
	Попытка
		ОтветPOST = Соединение.ВызватьHTTPМетод("POST", ЗапросPOST);
	Исключение
		ЗаписьЖурналаРегистрации(ИмяСобытия,
			УровеньЖурналаРегистрации.Ошибка,,,
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;
	
	Если ОтветPOST.КодСостояния <> 200 Тогда
		ТекстОшибки = СтрШаблон("POST %1: код %2. Ответ: %3",
			АдресПриложения, ОтветPOST.КодСостояния, ОтветPOST.ПолучитьТелоКакСтроку());
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка,,, ТекстОшибки);
		Возврат;
	КонецЕсли;
	
	Location = ОтветPOST.Заголовки.Получить("Location");
	Cookie = ОтветPOST.Заголовки.Получить("Set-Cookie");
	
	Если Не ЗначениеЗаполнено(Location) Тогда
		ЗаписьЖурналаРегистрации(ИмяСобытия,
			УровеньЖурналаРегистрации.Ошибка,,,
			СтрШаблон("POST %1: не получен заголовок Location", АдресПриложения));
		Возврат;
	КонецЕсли;
	
	// Шаг 2: PUT к Location с IBSession: finish и данными (то же соединение)
	Если СтрНачинаетсяС(НРег(Location), "http") Тогда
		ЭлементыLocation = ОбщегоНазначенияКлиентСервер.СтруктураURI(Location);
		LocationПуть = ЭлементыLocation.ПутьНаСервере;
	Иначе
		LocationПуть = Location;
	КонецЕсли;
	LocationПуть = LocationПуть + ?(Прав(LocationПуть, 1) = "/", "", "/");
	
	ЗапросPUT = Новый HTTPЗапрос(LocationПуть);
	ЗапросPUT.Заголовки.Вставить("Cookie", Cookie);
	ЗапросPUT.Заголовки.Вставить("IBSession", "finish");
	ЗапросPUT.Заголовки.Вставить("Content-Type", "application/json");
	ЗапросPUT.УстановитьТелоИзСтроки(ДанныеJSON);
	
	ОтветPUT = Неопределено;
	Попытка
		ОтветPUT = Соединение.ВызватьHTTPМетод("PUT", ЗапросPUT);
	Исключение
		ЗаписьЖурналаРегистрации(ИмяСобытия,
			УровеньЖурналаРегистрации.Ошибка,,,
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;
	
	Если ОтветPUT.КодСостояния = 201 Тогда
		ТелоОтвета = ОтветPUT.ПолучитьТелоКакСтроку();
		ПроверитьКодОтветаPUT(ТелоОтвета, ИмяСобытия, АдресПриложения);
	Иначе
		ТекстОшибки = СтрШаблон("PUT %1: код %2. Ответ: %3",
			АдресПриложения, ОтветPUT.КодСостояния, ОтветPUT.ПолучитьТелоКакСтроку());
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка,,, ТекстОшибки);
	КонецЕсли;
	
КонецПроцедуры

Процедура ПроверитьКодОтветаPUT(ТелоОтвета, ИмяСобытия, АдресПриложения)
	
	Если Не ЗначениеЗаполнено(ТелоОтвета) Тогда
		Возврат;
	КонецЕсли;
	
	СтруктураОтвета = ЗапросыREST.СтруктураИзСтрокиJSON(ТелоОтвета);
	Если Не СтруктураОтвета.Свойство("general")
		 Или Не СтруктураОтвета.general.Свойство("response") Тогда
		Возврат;
	КонецЕсли;
	
	КодОтвета = СтруктураОтвета.general.response;
	Если КодОтвета = 10200 Тогда
		Возврат;
	КонецЕсли;
	
	ТекстОшибки = СтрШаблон("PUT %1: ожидался 10200, получен %2", АдресПриложения, КодОтвета);
	ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка,,, ТекстОшибки);
	
КонецПроцедуры

#КонецОбласти