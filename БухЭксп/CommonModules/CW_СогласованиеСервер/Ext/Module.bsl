
Процедура ПриСозданииНаСервере(Форма, Отказ, СтандартнаяОбработка) Экспорт
	
	Элементы = Форма.Элементы;
	Объект 	 = Форма.Объект;   

	ИдетифкаторОбъекта = ОбщегоНазначения.ИдентификаторОбъектаМетаданных(ТипЗнч(Объект.Ссылка));  

	УстановитьПараметрыФункциональныхОпцийСогласования(Форма, ИдетифкаторОбъекта);
	
	Форма.Состояние = ПолучитьСостояниеОбъекта(Объект.Ссылка);

КонецПроцедуры  

Процедура ПриСозданииНаСервереФормыСписка(Форма, ИмяТипа,  Отказ, СтандартнаяОбработка) Экспорт
	
	ИдетифкаторОбъекта = ОбщегоНазначения.ИдентификаторОбъектаМетаданных(Тип(ИмяТипа));  

	УстановитьПараметрыФункциональныхОпцийСогласования(Форма, ИдетифкаторОбъекта);

КонецПроцедуры

Процедура УстановитьПараметрыФункциональныхОпцийСогласования(Форма, ИдетифкаторОбъекта)
	
	УстанавливаемыеПараметры = новый Структура;
	УстанавливаемыеПараметры.Вставить("CW_ОбъектСогласования", ИдетифкаторОбъекта);
	
	Форма.УстановитьПараметрыФункциональныхОпцийФормы(УстанавливаемыеПараметры);

КонецПроцедуры

Функция ПолучитьСостояниеОбъекта(Ссылка) Экспорт
	
	 Возврат РегистрыСведений.CW_СостояниеСогласованияОбъекта.ПолучитьСостояниеОбъекта(Ссылка);
	 
 КонецФункции
 
Процедура ЗавершитьСогласование(Объект) ЭКспорт
	
	ПараметрыОповещения = ПолучитьПараметрыОповещения();
	
	Если ПараметрыОповещения.ОповещатьЧерезСистемуВзаимодействия Тогда
		CW_СистемаВзаимодействия.УдалитьОбсуждение(Объект.Ссылка);
	КонецЕсли;
	
КонецПроцедуры

//Объект - эатп согласования
Процедура ОповеститьПользователейПоСогласованию(Объект, ОповеститьПользователей = Ложь, ОповеститьИнициатора = Ложь) Экспорт
	
	МассивСогласования  = ПолучитьОчередноеСогласование(Объект);
 	ЗаголовокОповещения = ПолучитьЗаголовокОповещения(Объект);
	ПараметрыОповещения = ПолучитьПараметрыОповещения();

	мИнициатор  = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Объект.Инициатор);
	мПолучатели = ПолучитьПолучателейОповещенияСогласования(Объект, МассивСогласования);
	
	УведомитьИнициатора = ПараметрыОповещения.УведомитьИнициатора и ОповеститьИнициатора;  
	
	Если ПараметрыОповещения.ОповещатьЧерезЦентрОповещений Тогда
		
		МассивОповещений = Новый Массив;
		
		Если ОповеститьПользователей Тогда
			Для Каждого Пользователь из мПолучатели Цикл
				ДанныеОпвещения = Новый Структура;
				ДанныеОпвещения.Вставить("Пользователь", 		Пользователь);
				ДанныеОпвещения.Вставить("Объект",  			Объект.ОбъектСогласования); 
				ДанныеОпвещения.Вставить("ЗаголовокОповещения", ЗаголовокОповещения);
				ДанныеОпвещения.Вставить("ТекстОповещения", 	"Вам направлен на согласование документ:"+Символы.ПС+Строка(Объект.ОбъектСогласования));;
				
				МассивОповещений.Добавить(ДанныеОпвещения);
			КонецЦикла;
		КонецЕсли;
		
		Если УведомитьИнициатора Тогда
			ДанныеОпвещения = Новый Структура;
			ДанныеОпвещения.Вставить("Пользователь",		Объект.Инициатор);
			ДанныеОпвещения.Вставить("Объект",  			Объект.ОбъектСогласования); 
			ДанныеОпвещения.Вставить("ЗаголовокОповещения",	ЗаголовокОповещения);
			ДанныеОпвещения.Вставить("ТекстОповещения",		"Документ:"+ Символы.ПС+Строка(Объект.ОбъектСогласования)+ Символы.ПС + Строка(Объект.СостояниеСогласования));
			
			МассивОповещений.Добавить(ДанныеОпвещения);
		КонецЕсли;
		
		РегистрыСведений.CW_ОповещенияКОтправке.ЗарегистрироватьОповещениеКОтправке(МассивОповещений);
		
	КонецЕсли;
	
	Если ПараметрыОповещения.ОповещатьЧерезСистемуВзаимодействия Тогда
		
		мУчастники	= ПолучитьПолучателейУчастниковОбсужедния(Объект);
		
		Если ОповеститьПользователей Тогда
			
			мСообщения 	= ПолучитьСообщенияСогласования(мИнициатор, мПолучатели, Объект.СостояниеСогласования);
	
			ДанныеОбсуждения = Новый Структура;
			ДанныеОбсуждения.Вставить("ЗаголовокОбсуждения", 	ЗаголовокОповещения);
			ДанныеОбсуждения.Вставить("Участники",				мУчастники);
			ДанныеОбсуждения.Вставить("ОбъектОбсуждения",  		Объект.ОбъектСогласования); 
			ДанныеОбсуждения.Вставить("Сообщения",				мСообщения);
			
			CW_СистемаВзаимодействия.СоздатьОбсуждение(ДанныеОбсуждения);
			
		КонецЕсли;
		
		Если УведомитьИнициатора Тогда
			Сообщение = Новый Структура;
			Сообщение.Вставить("Автор", 			ПараметрыСеанса.ТекущийПользователь);
			Сообщение.Вставить("Получатели", 		мИнициатор);
			Сообщение.Вставить("ДанныеДействие",	"ОткрытьСсылку");
			Сообщение.Вставить("Текст", 			Строка(Объект.СостояниеСогласования));
			
			мСообщения = Новый Массив;
			мСообщения.Добавить(Сообщение);
			
			ДанныеОбсуждения = Новый Структура;
			ДанныеОбсуждения.Вставить("ЗаголовокОбсуждения", 	ЗаголовокОповещения);
			ДанныеОбсуждения.Вставить("Участники",				мУчастники);
			ДанныеОбсуждения.Вставить("ОбъектОбсуждения",  		Объект.ОбъектСогласования);    
			ДанныеОбсуждения.Вставить("Сообщения", 				мСообщения);
			
			CW_СистемаВзаимодействия.СоздатьОбсуждение(ДанныеОбсуждения);
		КонецЕсли;
		
	КонецЕсли;
	
	//Подсистема.CW_РаботаСЭлектроннойПочтой
	Если ПараметрыОповещения.ОповещатьПоЭлектроннойПочте Тогда
		
		УчетнаяЗапись = CW_РаботаСЭлектроннойПочтой.ПолучитьУчетнуюЗаписьДляОтправкиПисемНаСогласование();
		Если Не ЗначениеЗаполнено(УчетнаяЗапись) Тогда
			ТекстСообщения = "Для отправки письма требуется настройка учетной записи электронной почты для отправки писем на согласование.
			|Обратитесь к администратору.";
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			Возврат;
		КонецЕсли;
		
		Ответ = Новый Структура;
		Ответ.Вставить("КоличствоПисем", Неопределено);
		АдресРезультата = ПоместитьВоВременноеХранилище(Ответ, Новый УникальныйИдентификатор);
		
		ПарамептрыФоновогоЗадания = Новый Массив;
		ПарамептрыФоновогоЗадания.Добавить(Объект.Ссылка);
		ПарамептрыФоновогоЗадания.Добавить(мПолучатели);
		ПарамептрыФоновогоЗадания.Добавить(Объект.Инициатор);
		ПарамептрыФоновогоЗадания.Добавить(ОповеститьПользователей);
		ПарамептрыФоновогоЗадания.Добавить(УведомитьИнициатора);
		ПарамептрыФоновогоЗадания.Добавить(УчетнаяЗапись);
		ПарамептрыФоновогоЗадания.Добавить(АдресРезультата);
		
		ФоновоеЗадание = ФоновыеЗадания.Выполнить("CW_Согласование.УведомитьОСобытииСогласования", ПарамептрыФоновогоЗадания,, "Соглавование.Уведомление по электронной почте.");
		
		Задание = ФоновоеЗадание.ОжидатьЗавершенияВыполнения(5);
		Пока Задание.Состояние = СостояниеФоновогоЗадания.Активно Цикл
			Задание = Задание.ОжидатьЗавершенияВыполнения(5);
		КонецЦикла;
		
		Если Задание.Состояние = СостояниеФоновогоЗадания.Завершено Тогда
			Ответ = ПолучитьИзВременногоХранилища(АдресРезультата);
			Если Ответ <> Неопределено Тогда
				Если Ответ.ЕстьОшибочныеПолучатели Тогда
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось отправить сообщения одному или нескольким получателям! Подробнее см. в журнале регистрации!");
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;

	КонецЕсли;
	//Подсистема.CW_РаботаСЭлектроннойПочтой
	

КонецПроцедуры       

Функция ПолучитьЗаголовокОповещения(ЭтапСогласования)
	
	ОжидаетСогласования  = Новый Структура("ОжидаетСогласования", Истина);
	мОжидаетСогласования = ЭтапСогласования.МаршрутСогласования.НайтиСтроки(ОжидаетСогласования);
	Если мОжидаетСогласования.Количество() > 0 Тогда
		//Еще не все согласованили
		Возврат "Согласование документа";
	КонецЕсли;
	
	Отклонено  = Новый Структура("Событие", ПредопределенноеЗначение("Перечисление.CW_СобытияСогласования.Отклонено"));
	мОтклонено = ЭтапСогласования.МаршрутСогласования.НайтиСтроки(Отклонено);
	Если мОтклонено.Количество() > 0 Тогда
		Возврат "Документ отклонен";
	КонецЕсли;
	
	Возврат "Документ согласован";
	
КонецФункции

Функция ПолучитьОчередноеСогласование(ЭтапСогласования)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ //ПЕРВЫЕ
				   |	МаршрутСогласования.НомерСтроки КАК НомерСтроки,
	               |	МаршрутСогласования.ГруппаСогласования КАК ГруппаСогласования
	               |ИЗ
	               |	Справочник.CW_ЭтапыСогласования.МаршрутСогласования КАК МаршрутСогласования
	               |ГДЕ
	               |	МаршрутСогласования.Ссылка = &ЭтапСогласования
	               |	И МаршрутСогласования.ОжидаетСогласования = ИСТИНА
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	НомерСтроки
	               |АВТОУПОРЯДОЧИВАНИЕ";
	
	Если ЭтапСогласования.ПорядокСогласования = ПредопределенноеЗначение("Перечисление.CW_ПорядокСогласованияОбъектов.Последовательное") Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "//ПЕРВЫЕ", "ПЕРВЫЕ 1");	
	КонецЕсли;
	
	Запрос.УстановитьПараметр("ЭтапСогласования", ЭтапСогласования);
	
	МассивСогласования = Новый Массив;
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		МассивСогласования.Добавить(Выборка.ГруппаСогласования);
	КонецЦикла;
	
	МассивСогласования.Добавить(ПредопределенноеЗначение("Справочник.CW_ГруппыСогласования.ПустаяСсылка"));
	
	Возврат МассивСогласования;

КонецФункции

Функция ПолучитьСообщенияСогласования(Знач мИнициатор, Знач мПолучатели, Знач ОбъектСостояние)
	
	мСообщения = Новый Массив;
	
	Если ОбъектСостояние = ПредопределенноеЗначение("Перечисление.CW_СостоянияСогласования.НаСогласовании") Тогда
		Сообщение = Новый Структура;
		Сообщение.Вставить("Автор", 			мИнициатор[0]);
		Сообщение.Вставить("Получатели", 		мПолучатели);
		Сообщение.Вставить("ДанныеДействие",	"ОткрытьСсылку");
		Сообщение.Вставить("Текст", 			"Документ направлен Вам на согласование");
		
		мСообщения.Добавить(Сообщение);
	КонецЕсли;
	
	Возврат мСообщения;

КонецФункции

Функция ПолучитьПолучателейОповещенияСогласования(Объект, мГруппыСогласовнаия)
	
	Результат 	= новый Массив;
	
	Для Каждого ГруппаСогласования из мГруппыСогласовнаия Цикл
		
		Если Не ЗначениеЗаполнено(ГруппаСогласования) Тогда
			Продолжить;
		КонецЕсли;
		
		мСтроки = Объект.МаршрутСогласования.НайтиСтроки(Новый Структура("ГруппаСогласования", ГруппаСогласования)); 
		Для Каждого СтрокаТаблицы из мСтроки Цикл
			Если Результат.Найти(СтрокаТаблицы.Пользователь) = Неопределено Тогда
				Результат.Добавить(СтрокаТаблицы.Пользователь);
			КонецЕсли;
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат Результат;
		
КонецФункции

Функция ПолучитьПолучателейУчастниковОбсужедния(Объект)
	
	Результат 	= Новый Массив;
	
	Для Каждого СтрокаТаблицы из Объект.МаршрутСогласования Цикл
		Если Результат.Найти(СтрокаТаблицы.Пользователь) = Неопределено Тогда
			Результат.Добавить(СтрокаТаблицы.Пользователь);
		КонецЕсли;
	КонецЦикла;
	
	Результат.Добавить(Объект.Инициатор);
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьМассивОповещенийКОтправке() Экспорт
	
	Возврат РегистрыСведений.CW_ОповещенияКОтправке.ПолучитьМассивОповещенийКОтправке();
	
КонецФункции

Функция ПолучитьПараметрыОповещения() Экспорт
	
	ОповещатьЧерезСистемуВзаимодействия =  Константы.CW_ОповещатьЧерезСистемуВзаимодействия.Получить() и СистемаВзаимодействия.ИспользованиеДоступно();
	
	ПараметрыОповещения = Новый Структура;
	ПараметрыОповещения.Вставить("ОповещатьПоЭлектроннойПочте", 		Константы.CW_ОповещатьПоЭлектроннойПочте.Получить());
	ПараметрыОповещения.Вставить("ОповещатьЧерезСистемуВзаимодействия", ОповещатьЧерезСистемуВзаимодействия);
	ПараметрыОповещения.Вставить("ОповещатьЧерезЦентрОповещений", 		Константы.CW_ОповещатьЧерезЦентрОповещений.Получить());
	ПараметрыОповещения.Вставить("УведомитьИнициатора", 				Константы.CW_УведомлятьИнициатораОСобытияхСогласования.Получить());
	
	Возврат ПараметрыОповещения;            
	
КонецФункции
