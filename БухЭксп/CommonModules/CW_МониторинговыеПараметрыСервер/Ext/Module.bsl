
//CW_МониторинговыеПараметрыСервер.ПолучитьИндексПиктограммыПараметра(Ссылка)
Функция ПолучитьИндексПиктограммыТипаПараметра(Знач Ссылка) Экспорт
	
	Если Ссылка.ЭтоГруппа Тогда
		Возврат 14;
	КонецЕсли;  
	
	Если Ссылка.ЭтоКонтрольнаяДата Тогда
		Возврат 3;
	КонецЕсли;  
	
	Если Ссылка.ДинамическийПараметр Тогда
		Возврат 12;
	КонецЕсли;
	
	Возврат ВариантыОтчетовСлужебныйКлиентСервер.ИндексКартинкиПоля(Ссылка.ТипЗначения);

КонецФункции

Функция ПолучитьИндексПиктограммыПараметраОбъекта(Знач Ссылка) Экспорт 
	
	Если ТипЗнч(Ссылка) = Тип("ПланВидовХарактеристикСсылка.CW_ПараметрыГрузоперевозок") Тогда
		Параметр = Ссылка;	
	Иначе
		Параметр = Ссылка.Параметр;	
	КонецЕсли;
	
	Если Ссылка.ЭтоГруппа Тогда
		Возврат 0;
	КонецЕсли;  
	
	Если Параметр.ЭтоКонтрольнаяДата Тогда
		Возврат 2;
	КонецЕсли;  
	
	Если Параметр.ДинамическийПараметр Тогда
		Возврат 3;
	КонецЕсли;  
	
	Если Параметр.ТипЗначения.СодержитТип(Тип("Дата")) Тогда
		Возврат 4;
	КонецЕсли;  
	
	Возврат 1;

КонецФункции

Процедура ПриСозданииНаСервере(Форма, Отказ, СтандартнаяОбработка) Экспорт 
	
	Объект = Форма.Объект;
	Ссылка = Форма.Объект.Ссылка;     
	
	Форма.ЗначениеКопирования = Форма.Параметры.ЗначениеКопирования;
	
	Если CW_МониторинговыеПараметрыСерверПовторноеИспользование.ЯвляетсяОбъектомПараметров(Ссылка) Тогда 
		СтруктураДоступныхПарамтеров = CW_МониторинговыеПараметрыСерверПовторноеИспользование.ПолучитьДоступныеПараметры();
		Если ТипЗнч(СтруктураДоступныхПарамтеров) = Тип("Структура") Тогда
			Форма.ДоступныеПараметры  = Новый ФиксированнаяСтруктура(СтруктураДоступныхПарамтеров);
		КонецЕсли;  
		
		УстановитьУсловноеФОрмилениеСпискаМониторинговыхПараметров(Форма);  
		
	КонецЕсли;
	
	УстановитьОтборСпискаМониторинговыхПараметров(Форма, Ссылка);
	
КонецПроцедуры

Процедура ПослеЗаписиНаСервере(Форма, ТекущийОбъект, ПараметрыЗаписи) Экспорт
	
	Ссылка = Форма.Объект.Ссылка;   
	
	Если ЗначениеЗаполнено(Форма.ЗначениеКопирования) Тогда
		СкопироватьМониторинговыеПараметрыОбъекта(Ссылка, Форма.ЗначениеКопирования);	
	КонецЕсли;
	
	УстановитьОтборСпискаМониторинговыхПараметров(Форма, Ссылка);
	
КонецПроцедуры  

Процедура СкопироватьМониторинговыеПараметрыОбъекта(Владелец, ЗначениеКопирования) 

	ИмяСправочника = CW_МониторинговыеПараметрыСерверПовторноеИспользование.ПолучитьИмяСправочникаМониторинговыхПараметров(Владелец);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	МониторинговыеПараметры.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник."+ИмяСправочника+" КАК МониторинговыеПараметры
	|ГДЕ
	|	МониторинговыеПараметры.Владелец = &Владелец
	|	И МониторинговыеПараметры.ЭтоГруппа = ЛОЖЬ"; 
	
	Запрос.УстановитьПараметр("Владелец", ЗначениеКопирования);
	
	РезультатЗапроса = Запрос.Выполнить(); 
	
	СоответствиеГрупп = Новый Соответствие;
	
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл  
		СкопироватьМониторинговыйПараметр(Выборка.Ссылка, Владелец, СоответствиеГрупп);
	КонецЦикла; 
	
КонецПроцедуры

Функция СкопироватьМониторинговыйПараметр(Знач ЗначениеКопироваяния, Знач Владелец, СоответствиеГрупп)
	
	ИмяСправочника 	= CW_МониторинговыеПараметрыСерверПовторноеИспользование.ПолучитьИмяСправочникаМониторинговыхПараметров(Владелец);
	СcылкаНового 	= Справочники[ИмяСправочника].ПолучитьСсылку(Новый УникальныйИдентификатор);
	
	НовыйЭлемент = ЗначениеКопироваяния.Скопировать();
	НовыйЭлемент.УстановитьНовыйКод();
	НовыйЭлемент.Владелец = Владелец;
	
	Если ЗначениеЗаполнено(ЗначениеКопироваяния.Родитель) Тогда   
		НовыйРодитель = СоответствиеГрупп.Получить(ЗначениеКопироваяния.Родитель);
		Если НовыйРодитель = Неопределено Тогда
			НовыйРодитель = СкопироватьМониторинговыйПараметр(НовыйЭлемент.Родитель, Владелец, СоответствиеГрупп); 
		КонецЕсли;

		СоответствиеГрупп.Вставить(ЗначениеКопироваяния.Родитель, НовыйРодитель);

		НовыйЭлемент.Родитель = НовыйРодитель;
	КонецЕсли;
	
	НовыйЭлемент.УстановитьСсылкуНового(СcылкаНового);
	НовыйЭлемент.ОбменДанными.Загрузка = Истина;
	НовыйЭлемент.Записать(); 
	
	Возврат СcылкаНового;

КонецФункции

Процедура УстановитьОтборСпискаМониторинговыхПараметров(Форма, Ссылка) 
	
	Форма.МониторинговыеПараметры.Отбор.Элементы.Очистить();
	
	ПравоеЗначение = ?(Ссылка.Пустая(), Неопределено, Ссылка);
	
	ЭлементОтбора = Форма.МониторинговыеПараметры.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение 	= Новый ПолеКомпоновкиДанных("Владелец");
	ЭлементОтбора.ВидСравнения  	= ВидСравненияКомпоновкиДанных.Равно;
	ЭлементОтбора.ПравоеЗначение  	= ПравоеЗначение;
	ЭлементОтбора.Использование 	= Истина;  
	
	Если CW_МониторинговыеПараметрыСерверПовторноеИспользование.ЯвляетсяОбъектомПараметров(Ссылка) Тогда 
		Если ТипЗнч(Форма.ДоступныеПараметры) = Тип("ФиксированнаяСтруктура") 
			И Форма.ДоступныеПараметры.Свойство("Просмотр") Тогда
			
			СписокПараметров = Новый СписокЗначений;
			СписокПараметров.ЗагрузитьЗначения(Форма.ДоступныеПараметры.Просмотр);
			
			ЭлементОтбора = Форма.МониторинговыеПараметры.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
			ЭлементОтбора.ЛевоеЗначение 	= Новый ПолеКомпоновкиДанных("Параметр");
			ЭлементОтбора.ВидСравнения  	= ВидСравненияКомпоновкиДанных.ВСписке;
			ЭлементОтбора.ПравоеЗначение  	= СписокПараметров;
			ЭлементОтбора.Использование 	= Истина;  
			
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура УстановитьУсловноеФОрмилениеСпискаМониторинговыхПараметров(Форма)
	
	//ГоризонтальноеПоложение
	ЭлементОформления = Форма.МониторинговыеПараметры.УсловноеОформление.Элементы.Добавить();
	КомпоновкаДанныхКлиентСервер.ДобавитьОформляемоеПоле(ЭлементОформления.Поля, "Значение");
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ГоризонтальноеПоложение", ГоризонтальноеПоложение.Лево);     
	//ГоризонтальноеПоложение
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	CW_ПараметрыГрузоперевозок.Ссылка КАК Параметр,
	|	ВЫРАЗИТЬ(CW_ПараметрыГрузоперевозок.ФорматВывода КАК СТРОКА(150)) КАК ФорматВывода,
	|	CW_ПараметрыГрузоперевозок.ЭтоКонтрольнаяДата КАК КонтрольнаяДата
	|ПОМЕСТИТЬ ВТ_ВсеПараметры
	|ИЗ
	|	ПланВидовХарактеристик.CW_ПараметрыГрузоперевозок КАК CW_ПараметрыГрузоперевозок
	|ГДЕ
	|	CW_ПараметрыГрузоперевозок.ЭтоСсылочныйТип = ЛОЖЬ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Параметры.Параметр КАК Параметр,
	|	ВТ_Параметры.ФорматВывода КАК ФорматВывода,
	|	ВТ_Параметры.КонтрольнаяДата КАК КонтрольнаяДата
	|ИЗ
	|	ВТ_ВсеПараметры КАК ВТ_Параметры
	|ГДЕ
	|	ВТ_Параметры.ФорматВывода <> """""; 
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл 
		
		ЭлементОформления = Форма.МониторинговыеПараметры.УсловноеОформление.Элементы.Добавить();
		КомпоновкаДанныхКлиентСервер.ДобавитьОформляемоеПоле(ЭлементОформления.Поля, "Значение");
		
		Если Выборка.КонтрольнаяДата Тогда
			КомпоновкаДанныхКлиентСервер.ДобавитьОформляемоеПоле(ЭлементОформления.Поля, "ЗначениеПлан"); 
			КомпоновкаДанныхКлиентСервер.ДобавитьОформляемоеПоле(ЭлементОформления.Поля, "ЗначениеФакт"); 
		КонецЕсли;
		
		ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементОформления.Отбор,
		"Параметр", ВидСравненияКомпоновкиДанных.Равно, Выборка.Параметр);
		
		ЭлементОформления.Оформление.УстановитьЗначениеПараметра("Формат", Выборка.ФорматВывода);
		
	КонецЦикла;  
	
	//Доступность
	ГруппаПользовтеля = CW_ПраваДоступа_ПИ.ГруппаПользователя(ПараметрыСеанса.ТекущийПользователь);

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	CW_ПраваДоступаДляПараметровМониторинга.Параметр КАК Параметр,
	|	CW_ПраваДоступаДляПараметровМониторинга.Редактирование КАК Редактирование
	|ИЗ
	|	РегистрСведений.CW_ПраваДоступаДляПараметровМониторинга КАК CW_ПраваДоступаДляПараметровМониторинга
	|ГДЕ
	|	CW_ПраваДоступаДляПараметровМониторинга.Группа = &ГруппаПользовтеля
	|	И CW_ПраваДоступаДляПараметровМониторинга.Редактирование = ЛОЖЬ";  
	
	Запрос.УстановитьПараметр("ГруппаПользовтеля", ГруппаПользовтеля);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл 
		
		ЭлементОформления = Форма.МониторинговыеПараметры.УсловноеОформление.Элементы.Добавить();
		
		ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементОформления.Отбор,
		"Параметр", ВидСравненияКомпоновкиДанных.Равно, Выборка.Параметр);
		
		ЭлементОформления.Оформление.УстановитьЗначениеПараметра("Доступность", ЛОЖЬ);
		
		ЭлементОформления = Форма.МониторинговыеПараметры.УсловноеОформление.Элементы.Добавить();
		КомпоновкаДанныхКлиентСервер.ДобавитьОформляемоеПоле(ЭлементОформления.Поля, "Ссылка");
	
		ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементОформления.Отбор,
		"Параметр", ВидСравненияКомпоновкиДанных.Равно, Выборка.Параметр);
		
		ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ЦветТекста", Новый Цвет(192,192,192));
		
	КонецЦикла;  
	
КонецПроцедуры  

// Функция - Получить пустую структуру редактирования параметров
// 
// Возвращаемое значение:
//   - Структура для заполнения строки параметров
//
Функция ПолучитьПустуюСтруктуруРедактированияПараметров() Экспорт
	
	Структура = Новый Структура;
	Структура.Вставить("Параметр",   		Неопределено);
	Структура.Вставить("Значение",			Неопределено);
	Структура.Вставить("ЗначениеПлан", 		Дата(1,1,1));
	Структура.Вставить("ЗначениеФакт", 		Дата(1,1,1));
	Структура.Вставить("ХранилищеДанных",	Неопределено);
	Структура.Вставить("ПолноеЗначение",	"");
	Структура.Вставить("ПараметрИзменен",	Ложь);
	Структура.Вставить("Примечание",   		"");
	
	Возврат Структура;
	
КонецФункции


Процедура ДобавитьМониторинговыйПараметрОбъекта(МониторинговыйПарамтер, ДополнительныеПараметры) Экспорт
	
	ИмяСправочника = CW_МониторинговыеПараметрыСерверПовторноеИспользование.ПолучитьИмяСправочникаМониторинговыхПараметров(ДополнительныеПараметры.Владелец);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	|	МониторинговыеПараметры.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник."+ИмяСправочника+" КАК МониторинговыеПараметры
	|ГДЕ
	|	МониторинговыеПараметры.Владелец = &Владелец
	|	И МониторинговыеПараметры.Параметр = &Параметр";   
	
	Запрос.УстановитьПараметр("Владелец",	ДополнительныеПараметры.Владелец);
	Запрос.УстановитьПараметр("Параметр",	МониторинговыйПарамтер);
	
	РезультатЗапроса = Запрос.Выполнить(); 
	Если Не РезультатЗапроса.Пустой() Тогда
		ВызватьИсключение "Параметр "+СокрЛП(МониторинговыйПарамтер)+" уже добавлен!";
	КонецЕсли;
	
	НовыйЭлемент = Справочники[ИмяСправочника].СоздатьЭлемент();
	НовыйЭлемент.Владелец 		 = ДополнительныеПараметры.Владелец;
	НовыйЭлемент.Родитель 		 = ДополнительныеПараметры.Родитель;
	НовыйЭлемент.Наименование 	 = СокрЛП(МониторинговыйПарамтер);
	НовыйЭлемент.Параметр 		 = МониторинговыйПарамтер;
	НовыйЭлемент.Записать();
	
КонецПроцедуры  

Процедура ВыполнитьПеремещениеЭлемента(СправочникСсылка, Направление) Экспорт
	
	ИмяСправочника = CW_МониторинговыеПараметрыСерверПовторноеИспользование.ПолучитьИмяСправочника(СправочникСсылка);
	
	СправочникОбъект = СправочникСсылка.ПолучитьОбъект();
	
	ИндексЭлемента = СправочникОбъект.ИндексЭлемента + Направление;
	Если ИндексЭлемента < 1 Тогда
		ИндексЭлемента = 1;
	КонецЕсли;
	
	СправочникОбъект.ИндексЭлемента = ИндексЭлемента;
	СправочникОбъект.Записать();
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	|	МониторинговыеПараметры.Ссылка КАК Ссылка,
	|	МониторинговыеПараметры.Владелец КАК Владелец,
	|	МониторинговыеПараметры.Родитель КАК Родитель,
	|	МониторинговыеПараметры.ИндексЭлемента КАК ИндексЭлемента
	|ИЗ
	|	Справочник."+ИмяСправочника+" КАК МониторинговыеПараметры
	|ГДЕ
	|	МониторинговыеПараметры.ИндексЭлемента = &ИндексЭлемента
	|	И МониторинговыеПараметры.Ссылка <> &Ссылка
	|	И МониторинговыеПараметры.Владелец = &Владелец
	|	И МониторинговыеПараметры.Родитель = &Родитель
	|	И МониторинговыеПараметры.ЭтоГруппа = &ЭтоГруппа";   
	
	Запрос.УстановитьПараметр("Владелец", 			СправочникСсылка.Владелец);
	Запрос.УстановитьПараметр("Родитель", 			СправочникСсылка.Родитель);
	Запрос.УстановитьПараметр("Ссылка", 			СправочникСсылка); 
	Запрос.УстановитьПараметр("ИндексЭлемента", 	ИндексЭлемента); 
	Запрос.УстановитьПараметр("ЭтоГруппа", 			СправочникСсылка.ЭтоГруппа); 
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Если Выборка.Следующий() Тогда
		
		
		СправочникОбъект = Выборка.Ссылка.ПолучитьОбъект();
		
		ИндексЭлемента = СправочникОбъект.ИндексЭлемента - Направление;
		Если ИндексЭлемента < 1 Тогда
			ИндексЭлемента = 1;
		КонецЕсли;
		
		СправочникОбъект.ИндексЭлемента = ИндексЭлемента;
		СправочникОбъект.Записать();
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьГруппыПараметровОбъекта(Владелец) Экспорт
	
	ИмяСправочника = CW_МониторинговыеПараметрыСерверПовторноеИспользование.ПолучитьИмяСправочникаМониторинговыхПараметров(Владелец);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
