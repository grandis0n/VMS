Процедура ВыполнитьЗаполнениеПараметровПоТипу(ПараметрыПроцедуры, АдресРезультата) Экспорт
	
	//ВариантЗаполнения
	// 0 - перенести новую структуру параметров, оставить несоответствующие параметры, 
	// 1 - перенести новую структуру параметров, удалить несоответствующие параметры,
	// 2 - сохранить текущую структуру, добавить новые параметры
	
	ВариантЗаполнения =  ПараметрыПроцедуры.ВариантЗаполнения; 
	
	//Параметры объекта  
	СоответствиеЗначенийПараметров = Новый Соответствие;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	МониторинговыеПараметры.Параметр КАК Параметр,
	|	МониторинговыеПараметры.Значение КАК Значение,
	|	МониторинговыеПараметры.ЗначениеПлан КАК ЗначениеПлан,
	|	МониторинговыеПараметры.ЗначениеФакт КАК ЗначениеФакт
	|ИЗ
	|	Справочник.CW_МониторинговыеПараметрыОбъектов КАК МониторинговыеПараметры
	|ГДЕ
	|	МониторинговыеПараметры.Владелец = &Владелец
	|	И МониторинговыеПараметры.ЭтоГруппа = ЛОЖЬ";  
	
	Запрос.УстановитьПараметр("Владелец", ПараметрыПроцедуры.Владелец);
	
	РезультатЗапросаПоОбъекту = Запрос.Выполнить();   
	
	Выборка = РезультатЗапросаПоОбъекту.Выбрать();
	Пока Выборка.Следующий() Цикл
		
		СтруктураЗначения = CW_МониторинговыеПараметрыСервер.ПолучитьПустуюСтруктуруРедактированияПараметров();
		СтруктураЗначения.Значение 		= Выборка.Значение;
		СтруктураЗначения.ЗначениеПлан 	= Выборка.ЗначениеПлан;
		СтруктураЗначения.ЗначениеФакт 	= Выборка.ЗначениеФакт;
		
		СоответствиеЗначенийПараметров.Вставить(Выборка.Параметр, СтруктураЗначения); 
	КонецЦикла; 
	
	Если ВариантЗаполнения = 0 Тогда
		ВыполнитьЗаполнениеПоПервомуВарианту( ПараметрыПроцедуры, СоответствиеЗначенийПараметров);
	КонецЕсли;
	Если ВариантЗаполнения = 1 Тогда
		ВыполнитьЗаполнениеПоВторомуВарианту( ПараметрыПроцедуры, СоответствиеЗначенийПараметров);
	КонецЕсли;
	Если ВариантЗаполнения = 2 Тогда
		ВыполнитьЗаполнениеПоТретьемуВарианту( ПараметрыПроцедуры, СоответствиеЗначенийПараметров);
	КонецЕсли;
	
КонецПроцедуры 

Процедура ВыполнитьЗаполнениеПоПервомуВарианту(Знач ПараметрыПроцедуры, Знач СоответствиеЗначенийПараметров)
	
	// 0 - перенести новую структуру параметров, оставить несоответствующие параметры, 
	УдалитьПараметрыОбъекта(ПараметрыПроцедуры.Владелец);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	МониторинговыеПараметры.ЭтоГруппа КАК ЭтоГруппа,
	|	МониторинговыеПараметры.Наименование КАК Наименование,
	|	МониторинговыеПараметры.Родитель КАК Родитель,
	|	МониторинговыеПараметры.Сворачивать КАК Сворачивать,
	|	МониторинговыеПараметры.Параметр КАК Параметр,
	|	МониторинговыеПараметры.Ссылка КАК Ссылка,
	|	МониторинговыеПараметры.ИндексЭлемента КАК ИндексЭлемента,
	|	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(МониторинговыеПараметры.Ссылка) КАК УникальныйИдентификатор
	|ИЗ
	|	Справочник.CW_МониторинговыеПараметрыТиповОбъектов КАК МониторинговыеПараметры
	|ГДЕ
	|	МониторинговыеПараметры.Владелец = &ТипОбъекта
	|
	|УПОРЯДОЧИТЬ ПО
	|	ЭтоГруппа УБЫВ,
	|	Родитель";
	
	Запрос.УстановитьПараметр("ТипОбъекта", ПараметрыПроцедуры.ТипОбъекта);
	РезультатЗапросаПоТипу = Запрос.Выполнить();   
	
	СоответствиеПараметров = Новый Соответствие;  
	
	мДобавленныеПараметры = Новый Массив;
	
	Выборка = РезультатЗапросаПоТипу.Выбрать(); 
	Пока Выборка.Следующий() Цикл 
		
		Если Выборка.ЭтоГруппа Тогда
			НайденныйЭлемент = Справочники.CW_МониторинговыеПараметрыОбъектов.НайтиПоРеквизиту(
			"ИдентификаторГруппы", 
			Выборка.УникальныйИдентификатор,, 
			ПараметрыПроцедуры.Владелец);	
		Иначе	
			НайденныйЭлемент = Справочники.CW_МониторинговыеПараметрыОбъектов.НайтиПоРеквизиту(
			"Параметр",
			Выборка.Параметр,,
			ПараметрыПроцедуры.Владелец);	
		КонецЕсли; 
		
		Если НайденныйЭлемент.Пустая() Тогда  
			Если Выборка.ЭтоГруппа Тогда
				НовыйЭлемент = Справочники.CW_МониторинговыеПараметрыОбъектов.СоздатьГруппу();
				НовыйЭлемент.Владелец = ПараметрыПроцедуры.Владелец;
			Иначе
				НовыйЭлемент = Справочники.CW_МониторинговыеПараметрыОбъектов.СоздатьЭлемент();
				НовыйЭлемент.Владелец = ПараметрыПроцедуры.Владелец;    
				
			КонецЕсли;
		Иначе
			НовыйЭлемент = НайденныйЭлемент.ПолучитьОбъект();
		КонецЕсли;
		
		НовыйЭлемент.ИндексЭлемента	= Выборка.ИндексЭлемента;
		НовыйЭлемент.Наименование 	= Выборка.Наименование;
		НовыйЭлемент.Родитель 		= СоответствиеПараметров.Получить(Выборка.Родитель); 
		
		Если Выборка.ЭтоГруппа Тогда
			НовыйЭлемент.Сворачивать 			= Выборка.Сворачивать;  
			НовыйЭлемент.ИдентификаторГруппы	= Выборка.УникальныйИдентификатор;
		Иначе     
			НовыйЭлемент.Параметр = Выборка.Параметр; 
			
			СтруктураЗначения = СоответствиеЗначенийПараметров.Получить(Выборка.Параметр);
			Если СтруктураЗначения <> Неопределено Тогда
				НовыйЭлемент.Значение 		= СтруктураЗначения.Значение;  
				НовыйЭлемент.ЗначениеПлан 	= СтруктураЗначения.ЗначениеПлан;  
				НовыйЭлемент.ЗначениеФакт 	= СтруктураЗначения.ЗначениеФакт;
			Иначе
				ТипЗначения = Выборка.Параметр.ТипЗначения;
				
				НовыйЭлемент.Значение = ТипЗначения.ПривестиЗначение(Неопределено);   
				Если Выборка.Параметр.ЭтоКонтрольнаяДата Тогда
					НовыйЭлемент.ЗначениеПлан = ТипЗначения.ПривестиЗначение(Неопределено);   
					НовыйЭлемент.ЗначениеФакт = ТипЗначения.ПривестиЗначение(Неопределено);   
				КонецЕсли;
			КонецЕсли;
			
			мДобавленныеПараметры.Добавить(Выборка.Параметр);
			
		КонецЕсли;
		
		
		НовыйЭлемент.ОбменДанными.Загрузка = Истина;
		НовыйЭлемент.Записать();
		
		СоответствиеПараметров.Вставить(Выборка.Ссылка, НовыйЭлемент.Ссылка);
		
	КонецЦикла;  
	
	//Добавляем парамтеры, которых нет в типе перевозки в корень
	Для Каждого КлючЗначение из СоответствиеЗначенийПараметров Цикл
		
		Если мДобавленныеПараметры.Найти(КлючЗначение.Ключ) = Неопределено Тогда
			МониторинговыйПарамтер 	= КлючЗначение.Ключ;
			СтруктураЗначения 		= КлючЗначение.Значение; 
			
			НовыйЭлемент = Справочники.CW_МониторинговыеПараметрыОбъектов.СоздатьЭлемент();
			НовыйЭлемент.Владелец 		 = ПараметрыПроцедуры.Владелец;
			НовыйЭлемент.Наименование 	 = СокрЛП(МониторинговыйПарамтер);
			НовыйЭлемент.Параметр 		 = МониторинговыйПарамтер; 
			
			НовыйЭлемент.Значение 		= СтруктураЗначения.Значение;  
			НовыйЭлемент.ЗначениеПлан 	= СтруктураЗначения.ЗначениеПлан;  
			НовыйЭлемент.ЗначениеФакт 	= СтруктураЗначения.ЗначениеФакт;  
			
			НовыйЭлемент.Записать();
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

