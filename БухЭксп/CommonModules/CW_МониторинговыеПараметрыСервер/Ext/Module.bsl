	|	Справочник.CW_МониторинговыеПараметрыТиповОбъектов КАК МониторинговыеПараметры
	|ГДЕ
	|	МониторинговыеПараметры.Владелец = &ТипОбъекта
	|	И МониторинговыеПараметры.ЭтоГруппа = ЛОЖЬ
	|	И НЕ МониторинговыеПараметры.Параметр В (&ПараметрыОбъекта)";
	
	Запрос.УстановитьПараметр("ТипОбъекта", 		ПараметрыПроцедуры.ТипОбъекта);
	Запрос.УстановитьПараметр("ПараметрыОбъекта", 	МассивПараметровОбъекта);
	
	РезультатЗапроса = Запрос.Выполнить();   
	
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		
		НовыйЭлемент = Справочники.CW_МониторинговыеПараметрыОбъектов.СоздатьЭлемент();
		НовыйЭлемент.Владелец 		 = ПараметрыПроцедуры.Владелец;
		НовыйЭлемент.Наименование 	 = СокрЛП(Выборка.Параметр);
		НовыйЭлемент.Параметр 		 = Выборка.Параметр; 
		НовыйЭлемент.Записать();
		
	КонецЦикла;
	
КонецПроцедуры


Процедура УдалитьПараметрыОбъекта(ОбъектПарамтеров)
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	CW_МониторинговыеПараметрыОбъектов.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.CW_МониторинговыеПараметрыОбъектов КАК CW_МониторинговыеПараметрыОбъектов
	|ГДЕ
	|	CW_МониторинговыеПараметрыОбъектов.Владелец = &Владелец";
	
	Запрос.УстановитьПараметр("Владелец", ОбъектПарамтеров);
	
	РезультатЗапросаПоОбъекту = Запрос.Выполнить();   
	
	Выборка = РезультатЗапросаПоОбъекту.Выбрать();
	Пока Выборка.Следующий() Цикл                          
		ПараметрОбъект = Выборка.Ссылка.ПолучитьОбъект();   
		Если ПараметрОбъект <> Неопределено Тогда
			ПараметрОбъект.Удалить();                
		КонецЕсли;
	КонецЦикла; 
	
КонецПроцедуры


Функция НачатьПереименованиеСвязанныхПараметровВФоне(МониторинговыйПараметр=Неопределено) Экспорт

	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(Новый УникальныйИдентификатор);
	ПараметрыВыполнения.ОжидатьЗавершение    = 0;  // запускать сразу  
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = "Переименование связанных параметров";  
	ПараметрыВыполнения.ЗапуститьВФоне      = Истина;  
	ПараметрыВыполнения.ЗапуститьНеВФоне    = ложь;  
	
	ПараметрыПроцедуры = Новый Структура;
	ПараметрыПроцедуры.Вставить("МониторинговыйПараметр", МониторинговыйПараметр);
	
	Возврат ДлительныеОперации.ВыполнитьВФоне("CW_МониторинговыеПараметрыСервер.ВыполнитьПереименованиеСвязанныхПараметров",ПараметрыПроцедуры, ПараметрыВыполнения);  
	
КонецФункции 

Процедура ВыполнитьПереименованиеСвязанныхПараметров(ПараметрыПроцедуры, АдресРезультата) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	CW_МониторинговыеПараметрыОбъектов.Ссылка КАК Ссылка,
	|	CW_МониторинговыеПараметрыОбъектов.Параметр КАК Параметр,
	|	CW_МониторинговыеПараметрыОбъектов.Параметр.Наименование КАК Наименование
	|ИЗ
	|	Справочник.CW_МониторинговыеПараметрыОбъектов КАК CW_МониторинговыеПараметрыОбъектов
	|ГДЕ
	|	CW_МониторинговыеПараметрыОбъектов.Наименование <> CW_МониторинговыеПараметрыОбъектов.Параметр.Наименование
	|	//%1
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	CW_МониторинговыеПараметрыТиповОбъектов.Ссылка,
	|	CW_МониторинговыеПараметрыТиповОбъектов.Параметр,
	|	CW_МониторинговыеПараметрыТиповОбъектов.Наименование
	|ИЗ
	|	Справочник.CW_МониторинговыеПараметрыТиповОбъектов КАК CW_МониторинговыеПараметрыТиповОбъектов
	|ГДЕ
	|	CW_МониторинговыеПараметрыТиповОбъектов.Наименование = CW_МониторинговыеПараметрыТиповОбъектов.Параметр.Наименование  
	|	//%2";
	
	Если ПараметрыПроцедуры.МониторинговыйПараметр <> Неопределено Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "//%1", "И CW_МониторинговыеПараметрыОбъектов.Параметр = &Параметр");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "//%2", "И CW_МониторинговыеПараметрыТиповОбъектов.Параметр = &Параметр");
		
		Запрос.УстановитьПараметр("Параметр", ПараметрыПроцедуры.МониторинговыйПараметр);
	КонецЕсли;
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл 
		ПараметрОбъект = Выборка.Ссылка.ПолучитьОбъект();
		ПараметрОбъект.Наименование = СокрЛП(ПараметрыПроцедуры.МониторинговыйПараметр);
		ПараметрОбъект.ОбменДанными.Загрузка = Истина;
		ПараметрОбъект.Записать();
	КонецЦикла;
	
КонецПроцедуры



