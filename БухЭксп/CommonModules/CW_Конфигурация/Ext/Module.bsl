Функция ПланСчетов() Экспорт 
	// --- 
	
	Если (КонфигурацияДляРФ()) Тогда
		Возврат(ПланыСчетов["Хозрасчетный"]);
	ИначеЕсли (КонфигурацияДляРК()) Тогда 
		Возврат(ПланыСчетов["Типовой"]);
	КонецЕсли; 
	
	// --- 
КонецФункции

