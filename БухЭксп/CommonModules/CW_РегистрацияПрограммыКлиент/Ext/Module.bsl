
Процедура ПолучитьРегистрационныйНомер(Форма) Экспорт
	
	Логин = CW_РегистрацияПрограммыСервер.ПолучитьЛогинПользовательяИнтернетПоддержки();
	Если Логин = Неопределено Тогда
		ОписаниеОпвещения = Новый ОписаниеОповещения("ЗавершитьРегистрациюНаПортале", ЭтотОбъект, Форма);
		ОткрытьФорму("ОбщаяФорма.CW_ФормаЛогинПароль", , Форма,,,,ОписаниеОпвещения,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);  
	Иначе
		Форма.РегистрационныйНомер = Сред(Логин, 2);	
	КонецЕсли;
	
КонецПроцедуры   

Процедура ЗавершитьРегистрациюНаПортале(Результат, Форма) Экспорт
	
	Логин = CW_РегистрацияПрограммыСервер.ПолучитьЛогинПользовательяИнтернетПоддержки();
	Если НЕ Логин = Неопределено Тогда
		Форма.РегистрационныйНомер = Сред(Логин, 2);
	КонецЕсли;
	
КонецПроцедуры

Процедура ПолучитьКлючЧерезИнтернетПоддержку(Форма)Экспорт
	
	ОтветСервера = CW_РегистрацияПрограммыСервер.ПолучитьПинкодДоступа(Форма.РегистрационныйНомер);	
	
	Если ОтветСервера.КодСостояния <> 200 тогда
		ПоказатьПредупреждение(,ОтветСервера.Сообщение);
		Возврат;
	КонецЕсли;       
	
	ОтветСервера.Вставить("РегистрационныйНомер", Форма.РегистрационныйНомер);           
	
	ОписаниеОповещения = новый  ОписаниеОповещения("ЗавершенитьВводПинкода", ЭтотОбъект, Форма);
	
	ОткрытьФорму("ОбщаяФорма.CW_ПолучениеЛицензионногоКлючаВводаПинКода", ОтветСервера, Форма,,,,ОписаниеОповещения);
	
КонецПроцедуры 

Процедура ЗавершенитьВводПинкода(Ответ, Форма) Экспорт
	
	Форма.РегистарцияВыполнена = истина;
	Оповестить("ПервыйЗапускПрограммыВыполнен");
	Оповестить("РегистрационныйКлючЗагружен", Ответ);
	
КонецПроцедуры   


Процедура ПодготовитьРегистрационныеДанные(ПараметрыРегистарции) Экспорт   
	
	АдресХранилища = ПоместитьВоВременноеХранилище(Неопределено, Новый УникальныйИдентификатор);
	CW_РегистрацияПрограммыСервер.ПодготовитьРегистрационныеДанныеНаСервере(ПараметрыРегистарции, АдресХранилища); 
	
	ПараметрыДиалогаПолученияФайлов = Новый ПараметрыДиалогаПолученияФайлов;
	ПараметрыДиалогаПолученияФайлов.ВыборКаталога 	= Истина;
	ПараметрыДиалогаПолученияФайлов.Заголовок 		= "Выберите каталог";     
	
	ИмяФайлаКомплекта = "ActivatingAFModule.zip";     
	НачатьПолучениеФайлаССервера(АдресХранилища, ИмяФайлаКомплекта, ПараметрыДиалогаПолученияФайлов);  
	
КонецПроцедуры   

Процедура ПрименитьРасширенныеНастройкиМодуля(Оповещение) Экспорт  
	
	Если Не CW_РегистрацияПрограммыСервер.ИспользуетсяНовыйМеханизмЛицензирования() Тогда
		ВыполнитьОбработкуОповещения(Оповещение, Истина);
		Возврат;
	КонецЕсли;
	
	Успешно = CW_РегистрацияПрограммыСервер.ПроверитьВозможностьРаботы();
	
	Если Успешно Тогда  
		
		Интервал = Неопределено;
		CW_РегистрацияПрограммыСервер.ПроверитьВозможностьРаботыПродолжение(Интервал);  
		Если Интервал <> Неопределено Тогда
			ПодключитьОбработчикОжидания("ПрименитьРасширенныеНастройкиМодуля", Интервал, Истина);  
		КонецЕсли;
			
		ВыполнитьОбработкуОповещения(Оповещение, Истина);
		
	Иначе  
		
		ОткрытьФорму("ОбщаяФорма.CW_АктивацияПрограммы",,,,,,Оповещение,РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);  
		
	КонецЕсли;
	
КонецПроцедуры   

