//УСТАРЕЛА. Рекомендуется использовать CW_ПереводыСервер.ПолучитьПереводы();
Функция ПоЯзыкам(ОбъектПеревода,МассивЯзыков,ОсновнойЯзык=Неопределено) Экспорт
	// --- 
	
	СтруктураПеревода=Новый Структура;
	Для каждого Язык Из МассивЯзыков Цикл
		
		СтруктураПеревода.Вставить(СокрЛП(Строка(Язык)), CW_Переводы_ПИ.Перевести(ОбъектПеревода, Язык, ОсновнойЯзык));
		
	КонецЦикла; 
	// --- 
	Возврат(СтруктураПеревода);
	
	// --- 
КонецФункции
  