Процедура ВывестиПредупреждение(Текст,ПроцедураОбратногоВызова=Неопределено) Экспорт 
	
	ТекстПредупреждения 	= "";
	ЗаголовокПредупреждения = "";
	
	Если (ТипЗнч(Текст) = Тип("Структура")) Тогда
		
		Текст.Свойство("Текст",		ТекстПредупреждения);
		Текст.Свойство("Заоловок",	ЗаголовокПредупреждения);
		
	Иначе
		ТекстПредупреждения = Текст;
	КонецЕсли; 
	
	ПоказатьПредупреждение(ПроцедураОбратногоВызова,ТекстПредупреждения,,ЗаголовокПредупреждения);
	
КонецПроцедуры

