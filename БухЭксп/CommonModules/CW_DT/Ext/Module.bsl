Функция ВернутьАрхив(Сообщение)
	Файл	= ПолучитьИмяВременногоФайла("zip");
	Опись	= КаталогВременныхФайлов()+"\register"+Сообщение.Идентификатор+".txt";
	Архив	= Новый ЗаписьZipФайла(Файл,Сообщение.ПрофильОбмена.ПарольДляВложений);
	Текст	= Новый ТекстовыйДокумент;
	Запрос	= Новый Запрос;Запрос.Текст = 
	"ВЫБРАТЬ
	|	CWEDO_ТранспортноеСообщениеИсходящееВложения.ОбъектАрхива.Ссылка КАК Ссылка,
	|	CWEDO_ТранспортноеСообщениеИсходящееВложения.ОбъектАрхива.ИмяФайла КАК name,
	|	CWEDO_ТранспортноеСообщениеИсходящееВложения.ОбъектАрхива.Расширение КАК ext,
	|	CWEDO_ТранспортноеСообщениеИсходящееВложения.Тип КАК type
	|ИЗ
	|	Документ.CW_DT_ТранспортноеСообщениеИсходящее.Вложения КАК CWEDO_ТранспортноеСообщениеИсходящееВложения
	|ГДЕ
	|	CWEDO_ТранспортноеСообщениеИсходящееВложения.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка",Сообщение.Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	СтруктураАрхива	= Новый Массив; 
	Пока Выборка.Следующий() Цикл
		ОписаниеФайла = Новый Структура("name,ext,type,id",,,,XMLСтрока(Выборка.Ссылка));
		ЗаполнитьЗначенияСвойств(ОписаниеФайла,Выборка);   
		
		ПолноеИмяФайла = CW_РаботаСФайламиСервер.ПолучитьПолноеИмяФайла(Выборка.Ссылка);
		
		Архив.Добавить(ПолноеИмяФайла);
		
		СтруктураАрхива.Добавить(ОписаниеФайла);
	КонецЦикла;     
	
	Текст.УстановитьТекст(jsonObjectToStr(СтруктураАрхива));
	Текст.Записать(Опись);
	Архив.Добавить(Опись);
	Архив.Записать();
	Возврат Файл
КонецФункции

