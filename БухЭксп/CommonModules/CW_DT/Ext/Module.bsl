Функция ПолучитьПароль(Организация) 
	//УстановитьПривилегированныйРежим(Истина);
	Запрос = Новый Запрос;Запрос.Текст = 
		"ВЫБРАТЬ
		|	CW_DT_Пароли.Пароль КАК Пароль
		|ИЗ
		|	РегистрСведений.CW_DT_Пароли КАК CW_DT_Пароли
		|ГДЕ
		|	CW_DT_Пароли.Организация = &Организация";
