	HTTPЗапрос.Заголовки.Вставить("sender_id",		ПолучитьИдентификаторУчастника(ПрофильОбмена.Контрагент));
	HTTPЗапрос.Заголовки.Вставить("receiver_id",	ПолучитьИдентификаторУчастника(ПрофильОбмена.Организация));
	HTTPЗапрос.Заголовки.Вставить("receiver_key",	ПолучитьПароль(ПрофильОбмена.Организация));
	HTTPЗапрос.Заголовки.Вставить("converter_type",	ПрофильОбмена.ТипКонвертера);
	
	HTTPЗапрос.УстановитьТелоИзСтроки(jsonObjectToStr(Тело));
	
	HTTPОтвет = HTTPСоединение.ОтправитьДляОбработки(HTTPЗапрос);
	Если HTTPОтвет.КодСостояния = 200 Тогда
		Если НЕ ВнешнийИдентификатор = Неопределено Тогда
			Идентификатор = HTTPОтвет.ПолучитьТелоКакСтроку();
			ЗаписатьИдентификаторСБИС(Идентификатор,ПрофильОбмена.Ссылка,ВнешнийИдентификатор);
		КонецЕсли; 
		Возврат Истина
	Иначе 
		Возврат "Ответ сервиса " + HTTPОтвет.КодСостояния + " - " + HTTPОтвет.ПолучитьТелоКакСтроку()
