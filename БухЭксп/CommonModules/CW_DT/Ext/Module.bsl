#Область functions

Функция СоздатьТранспортноеСообщениеИсходящее(Основание) Экспорт
	
	//проведен?	
	Запрос = Новый Запрос;Запрос.Текст = 
	"ВЫБРАТЬ
	|	CW_ДоходыПоГрузоперевозке.Проведен КАК Проведен,
	|	CW_ДоходыПоГрузоперевозке.Корректировка КАК Корректировка
	|ИЗ
	|	Документ.CW_ДоходыПоГрузоперевозке КАК CW_ДоходыПоГрузоперевозке
	|ГДЕ
	|	CW_ДоходыПоГрузоперевозке.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", Основание);
	Выборка = Запрос.Выполнить().Выбрать();Выборка.Следующий();
	Если НЕ Выборка.Проведен Тогда Сообщить("Документ должен быть проведен!");Возврат Неопределено;КонецЕсли; 	
	Если Выборка.Корректировка Тогда Сообщить("Корректировочные документы не обрабатываются!");Возврат Неопределено;КонецЕсли; 	
	
	//Определить продавцов
	//...	
	
	ПрофильОбмена	= ПолучитьПрофильОбмена(Основание);Если ПрофильОбмена = Неопределено Тогда Сообщить("Не обнаружен профиль обмена!");Возврат Неопределено КонецЕсли; 
	Файл			= СформироватьXML(Основание,ПрофильОбмена);Если Файл = Неопределено Тогда Возврат Неопределено;КонецЕсли; 
	НашлиТС 		= ПолучитьТранспортноеСообщениеИсходящее(Основание);
	
	Если НашлиТС = Неопределено Тогда
		ТС = Документы.CW_DT_ТранспортноеСообщениеИсходящее.СоздатьДокумент();
		ТС.Основания.Добавить().Основание = Основание;
	Иначе
		ТС = НашлиТС.ПолучитьОбъект();
	КонецЕсли; 
	
	Попытка
		ТС.Дата				= ТекущаяДата();
		ТС.СостояниеОбмена	= Перечисления.CW_DT_СостоянияОбмена.Создан;
		ТС.ПрофильОбмена	= ПрофильОбмена;
		ТС.Описание			= Основание.ПредставлениеДокумента;
		ТС.Ценность			= Формат(Основание.СуммаДокумента,"ЧДЦ=2") + " " + ?(Основание.Валюта.Код = "643","RUB", Основание.Валюта.Наименование);
		ЗаполнитьЗначенияСвойств(ТС,Основание,"Организация,Контрагент");
		ТС.Записать();
		
		Нашли = ТС.Вложения.Найти("Finance");		
		Если НЕ Нашли = Неопределено Тогда
			Нашли.ОбъектАрхива.ПолучитьОбъект().Удалить();ТС.Вложения.Удалить(Нашли);
		КонецЕсли;  
		
		ПозТочки 	= СтрНайти(Файл,".", НаправлениеПоиска.СКонца);
		Расширение 	= Сред(Файл, ПозТочки); 
		
		ДвоичныеДанные = Новый ДвоичныеДанные(Файл); 
		АдресФайла = ПоместитьВоВременноеХранилище(ДвоичныеДанные, Новый УникальныйИдентификатор);	

		ДанныеФайла = Новый Структура;
		ДанныеФайла.Вставить("Имя",			"Af_finance.xml");
		ДанныеФайла.Вставить("Расширение",	".xml");
		ДанныеФайла.Вставить("Хранение",	АдресФайла);
		
		ПомещенныйФайл = CW_РаботаСФайламиСервер.ПрикрепитьФайл(ДанныеФайла, ТС.Ссылка);
		
		ЗаполнитьЗначенияСвойств(ТС.Вложения.Добавить(),Новый Структура("Тип,ОбъектАрхива","Finance", ПомещенныйФайл));
		
		ТС.Записать();
		
		Возврат ТС.Ссылка
	Исключение
		Сообщить("Что-то пошло не так!");
		Сообщить(ОписаниеОшибки());
	КонецПопытки; 
	
КонецФункции

Функция ПолучитьТранспортноеСообщениеИсходящее(Основание) Экспорт
	Запрос = Новый Запрос;Запрос.Текст = 
		"ВЫБРАТЬ
		|	CW_DT_ТранспортноеСообщениеИсходящее.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.CW_DT_ТранспортноеСообщениеИсходящее.Основания КАК CW_DT_ТранспортноеСообщениеИсходящее
		|ГДЕ
		|	CW_DT_ТранспортноеСообщениеИсходящее.Основание = &Основание
		|	И CW_DT_ТранспортноеСообщениеИсходящее.Ссылка.СостояниеОбмена = ЗНАЧЕНИЕ(Перечисление.CW_DT_СостоянияОбмена.Создан)";
	Запрос.УстановитьПараметр("Основание", Основание);
	Результат = Запрос.Выполнить();Если Результат.Пустой() Тогда Возврат Неопределено; КонецЕсли; 
	Выборка	= Результат.Выбрать();Выборка.Следующий();
	Возврат Выборка.Ссылка
КонецФункции

