Процедура УстановитьПароль(Организация,Пароль) Экспорт
	//УстановитьПривилегированныйРежим(Истина);
	Если Пароль = "" Тогда
		МЗ = РегистрыСведений.CW_DT_Пароли.СоздатьМенеджерЗаписи();
		МЗ.Организация = Организация;
		МЗ.Удалить();
	Иначе 	
		МЗ = РегистрыСведений.CW_DT_Пароли.СоздатьМенеджерЗаписи();
		МЗ.Организация = Организация;
		МЗ.Пароль = Новый ХранилищеЗначения(Пароль,Новый СжатиеДанных(9));
		МЗ.Записать(Истина);
	КонецЕсли; 
КонецПроцедуры

