#Область http
//Процедура регламентного задания
Процедура ОтправкаТранспортныхСообщений() Экспорт
	Если НЕ РабочаяБаза() Тогда Сообщить("Отпарвка из копии запрещена!");Возврат;КонецЕсли; 
	НастройкаСоединения	= Константы.CW_DT_ОсновнаяНастройкаСоединения.Получить();
	Если НастройкаСоединения = Неопределено Тогда Возврат;КонецЕсли; 
	Запрос = Новый Запрос;Запрос.Текст = 
	"ВЫБРАТЬ
	|	CW_DT_ТранспортноеСообщениеИсходящее.Ссылка КАК Ссылка,
	|	CW_DT_ТранспортноеСообщениеИсходящее.Идентификатор КАК Идентификатор
	|ИЗ
	|	Документ.CW_DT_ТранспортноеСообщениеИсходящее КАК CW_DT_ТранспортноеСообщениеИсходящее
	|ГДЕ
	|	(CW_DT_ТранспортноеСообщениеИсходящее.СостояниеОбмена = ЗНАЧЕНИЕ(Перечисление.CW_DT_СостоянияОбмена.Создан)
	|			ИЛИ CW_DT_ТранспортноеСообщениеИсходящее.СостояниеОбмена = ЗНАЧЕНИЕ(Перечисление.CW_DT_СостоянияОбмена.Зарегистрирован))";
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда Возврат; КонецЕсли; 
	HTTPСоединение		= HTTPСоединение(НастройкаСоединения);
	Выборка				= РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		Сообщение = Выборка.Ссылка.ПолучитьОбъект();
		Если Сообщение.Идентификатор = "" Тогда
			ЗарегистрироватьТранспортноеСообщение(Сообщение,HTTPСоединение,НастройкаСоединения.АдресРесурса);
			Сообщение.Записать();
			//потом Заблокировать доходы
		КонецЕсли; 
		ОтправитьТранспортноеСообщение(Сообщение,HTTPСоединение,НастройкаСоединения.АдресРесурса);
		Сообщение.Записать();
	КонецЦикла;
КонецПроцедуры

Процедура ЗарегистрироватьТранспортноеСообщение(Сообщение,HTTPСоединение,АдресРесурса)
	Попытка
		HTTPЗапрос	= Новый HTTPЗапрос(АдресРесурса + "/message");
		HTTPЗапрос.Заголовки.Вставить("sender_id",	ПолучитьИдентификаторУчастника(Сообщение.Организация));
		HTTPЗапрос.Заголовки.Вставить("sender_key",	ПолучитьПароль(Сообщение.Организация));
		HTTPЗапрос.Заголовки.Вставить("receiver_id",ПолучитьИдентификаторУчастника(Сообщение.Контрагент));
		HTTPЗапрос.Заголовки.Вставить("descrition",	КодироватьСтроку(Сообщение.Описание,СпособКодированияСтроки.КодировкаURL)); 
		HTTPЗапрос.Заголовки.Вставить("value",		КодироватьСтроку(Сообщение.Ценность,СпособКодированияСтроки.КодировкаURL));
		HTTPОтвет	= HTTPСоединение.ОтправитьДляОбработки(HTTPЗапрос);
		Если HTTPОтвет.КодСостояния = 200 Тогда
			Сообщение.Идентификатор = HTTPОтвет.Заголовки.Получить("message_id");
			Сообщение.СостояниеОбмена = Перечисления.CW_DT_СостоянияОбмена.Зарегистрирован;
			//Сообщить("ЭД зарегистрирован " + Сообщение.Идентификатор);
		Иначе
			CW_Журнал.ЗаписатьСообщение("DataTransfer.ЗарегистрироватьТранспортноеСообщение",0,"Ответ сервиса ("+HTTPОтвет.КодСостояния+") "+HTTPОтвет.ПолучитьТелоКакСтроку());	
		КонецЕсли; 
	Исключение
		CW_Журнал.ЗаписатьСообщение("DataTransfer.ЗарегистрироватьТранспортноеСообщение",0,ОписаниеОшибки());	
	КонецПопытки;
КонецПроцедуры

Процедура ОтправитьТранспортноеСообщение(Сообщение,HTTPСоединение,АдресРесурса)
	Попытка
		HTTPЗапрос	= Новый HTTPЗапрос(АдресРесурса + "/message");
		HTTPЗапрос.Заголовки.Вставить("sender_id",	ПолучитьИдентификаторУчастника(Сообщение.Организация));
		HTTPЗапрос.Заголовки.Вставить("sender_key",	ПолучитьПароль(Сообщение.Организация));
		HTTPЗапрос.Заголовки.Вставить("message_id",	Сообщение.Идентификатор);
		HTTPЗапрос.УстановитьИмяФайлаТела(ВернутьАрхив(Сообщение)); 
		HTTPОтвет	= HTTPСоединение.Записать(HTTPЗапрос);
		Если HTTPОтвет.КодСостояния = 200 Тогда
			Сообщение.СостояниеОбмена = Перечисления.CW_DT_СостоянияОбмена.Отправлен;
		Иначе
			CW_Журнал.ЗаписатьСообщение("DataTransfer.ОтправитьТранспортноеСообщение",0,"Ответ сервиса ("+HTTPОтвет.КодСостояния+") "+HTTPОтвет.ПолучитьТелоКакСтроку());	
		КонецЕсли; 
	Исключение
		CW_Журнал.ЗаписатьСообщение("DataTransfer.ОтправитьТранспортноеСообщение",0,ОписаниеОшибки());	
	КонецПопытки;
КонецПроцедуры

Функция ПолучитьСообщения(Организация,ИдентификаторПолучателя,НастройкаСоединения) Экспорт
	Попытка
		HTTPСоединение	= HTTPСоединение(НастройкаСоединения);
		HTTPЗапрос		= Новый HTTPЗапрос(НастройкаСоединения.АдресРесурса + "/list");
		HTTPЗапрос.Заголовки.Вставить("receiver_id", ИдентификаторПолучателя);
		HTTPЗапрос.Заголовки.Вставить("receiver_key",ПолучитьПароль(Организация));
		HTTPОтвет		= HTTPСоединение.Получить(HTTPЗапрос);
		Если HTTPОтвет.КодСостояния = 200 Тогда
			АттрибутыДат = Новый Массив;
			АттрибутыДат.Добавить("message_date");
			Возврат jsonStrToObject(HTTPОтвет.ПолучитьТелоКакСтроку(),АттрибутыДат)
		Иначе 
			CW_Журнал.ЗаписатьСообщение("DataTransfer.ПолучитьСообщения",0,"Ответ сервиса ("+HTTPОтвет.КодСостояния+") "+HTTPОтвет.ПолучитьТелоКакСтроку());	
		КонецЕсли; 
	Исключение
		CW_Журнал.ЗаписатьСообщение("DataTransfer.ПолучитьСообщения",0,ОписаниеОшибки());	
	КонецПопытки;
	Возврат Новый Массив
КонецФункции

Функция ЗагрузитьСообщение(Заголовки,НастройкаСоединения) Экспорт
	НачатьТранзакцию();
	
	Сообщение     = Документы.CW_DT_ТранспортноеСообщениеВходящее.СоздатьДокумент();
	Сообщение.Дата     = ТекущаяДата();
	Сообщение.Идентификатор  = Заголовки.message_id;
	Сообщение.Организация  = ПолучитьУчастникаПоИдентификатору(Заголовки.receiver_id);
	Сообщение.Контрагент  = ПолучитьУчастникаПоИдентификатору(Заголовки.sender_id);
	Сообщение.ПрофильОбмена  = ПолучитьПрофильОбмена(Сообщение);
	Сообщение.Описание   = Заголовки.description;
	Сообщение.Ценность    = Заголовки.value;
	Если Сообщение.ПрофильОбмена.Пустая() Тогда
		Сообщить("Сообщение не загружено!");
		Возврат Ложь
	КонецЕсли; 
	Попытка
		HTTPСоединение = HTTPСоединение(НастройкаСоединения);
		HTTPЗапрос  = Новый HTTPЗапрос(НастройкаСоединения.АдресРесурса + "/message");
		HTTPЗапрос.Заголовки.Вставить("receiver_id", Заголовки.receiver_id);
		HTTPЗапрос.Заголовки.Вставить("receiver_key", ПолучитьПароль(Сообщение.Организация));
		HTTPЗапрос.Заголовки.Вставить("message_id",  Заголовки.message_id);
		HTTPОтвет  = HTTPСоединение.Получить(HTTPЗапрос);
		Если HTTPОтвет.КодСостояния = 200 Тогда
			
			Файл = ПолучитьИмяВременногоФайла("zip");HTTPОтвет.ПолучитьТелоКакДвоичныеДанные().Записать(Файл);
			Архив = Новый ЧтениеZipФайла(Файл,Сообщение.ПрофильОбмена.ПарольДляВложений);
			Каталог = КаталогВременныхФайлов()+Сообщение.Идентификатор;
			
			Для Каждого Стр Из Архив.Элементы Цикл Архив.Извлечь(Стр,Каталог);КонецЦикла; 
			
			ТипДокумента = Константы.CW_DT_ТипДокументаФайловогоАрхива.Получить();
			Текст = Новый ТекстовыйДокумент();
			Текст.Прочитать(Каталог + "\register"+Сообщение.Идентификатор+".txt");
			СтруктураАрхива = CW_DT.jsonStrToObject(Текст.ПолучитьТекст());
			
			Сообщение.Записать();
			
			Для Каждого Стр Из СтруктураАрхива Цикл   
				
				ДвоичныеДанные = Новый ДвоичныеДанные(Каталог + "\" + Стр.id);
				Хранение = ПоместитьВоВременноеХранилище(ДвоичныеДанные, Новый УникальныйИдентификатор);
				
				ДанныеФайла = Новый Структура;
				ДанныеФайла.Вставить("Имя",   Стр.name);
				ДанныеФайла.Вставить("Расширение", Стр.ext);
				ДанныеФайла.Вставить("Хранение", Хранение);
				
				ПомещенныйФайл = CW_РаботаСФайламиСервер.ПрикрепитьФайл(ДанныеФайла, Сообщение.Ссылка, ТипДокумента);
				
				нСтр = Сообщение.Вложения.Добавить();
				нСтр.ОбъектАрхива = ПомещенныйФайл;
				нСтр.Тип   = Стр.type;
			КонецЦикла; 
			
			Сообщение.СостояниеОбмена = Перечисления.CW_DT_СостоянияОбмена.Получен;
			Сообщение.Записать();
			УдалитьФайлы(Каталог);
			
			ЗафиксироватьТранзакцию();
			УстановитьСтатусСообщения(Заголовки.message_id,Сообщение.Организация,Заголовки.receiver_id,НастройкаСоединения);
			
			Возврат Истина
		Иначе
			Сообщить(Строка(HTTPОтвет.КодСостояния) + " - "  +HTTPОтвет.ПолучитьТелоКакСтроку());
			Возврат Ложь
		КонецЕсли; 
	Исключение
		ОписаниеОшибки = ОписаниеОшибки();
		События = Новый СписокЗначений;
		Событие = Новый Структура();
		Событие.Вставить("ИмяСобытия","DataTransfer.ЗагрузитьСообщение");
		Событие.Вставить("ПредставлениеУровня","Ошибка");
		Событие.Вставить("Комментарий",ОписаниеОшибки);
		Событие.Вставить("ДатаСобытия",ТекущаяДата());
		События.Добавить(Событие);
		ЖурналРегистрации.ЗаписатьСобытияВЖурналРегистрации(События);
		Сообщить(ОписаниеОшибки);
	КонецПопытки;
	Возврат Ложь;	
	
КонецФункции

Функция ПолучитьКлюч(Идентификатор)
	ХешА=Новый ХешированиеДанных(ХешФункция.SHA256);ХешА.Добавить(Идентификатор);
	ХешБ=Новый ХешированиеДанных(ХешФункция.SHA1);ХешБ.Добавить(ХешА.ХешСумма);ХешБ.Добавить(Идентификатор);ХешБ.Добавить(ХешА.ХешСумма);
	Возврат Base64Строка(ХешБ.ХешСумма);
КонецФункции
 
Функция ИдентификаторУчастникаПоИНН(ИНН) Экспорт
	Если НЕ ЗначениеЗаполнено(ИНН) Тогда Возврат "";КонецЕсли; 
	НастройкаСоединения = Константы.CW_DT_ОсновнаяНастройкаСоединения.Получить();
	HTTPСоединение = HTTPСоединение(НастройкаСоединения);
	Попытка
		HTTPЗапрос	= Новый HTTPЗапрос(НастройкаСоединения.АдресРесурса + "/member");HTTPЗапрос.Заголовки.Вставить("member_inn",ИНН);
		HTTPОтвет	= HTTPСоединение.Получить(HTTPЗапрос);
		Если HTTPОтвет.КодСостояния = 200 Тогда
			Возврат HTTPОтвет.ПолучитьТелоКакСтроку()
		ИначеЕсли HTTPОтвет.КодСостояния = 404 Тогда
			Возврат "Не найден"
		Иначе Возврат "Неизвестная ошибка"
		КонецЕсли; 
	Исключение Возврат "Ошибка запроса"	
	КонецПопытки;
КонецФункции

Функция СформироватьИдентификаторУчастникаПоИНН(Участник) Экспорт
	Если НЕ ЗначениеЗаполнено(Участник.ИНН) Тогда Сообщить("ИНН участника не заполнен!");Возврат Ложь;КонецЕсли; 
	НастройкаСоединения = Константы.CW_DT_ОсновнаяНастройкаСоединения.Получить();
	HTTPСоединение = HTTPСоединение(НастройкаСоединения);
	Попытка
		HTTPЗапрос	= Новый HTTPЗапрос(НастройкаСоединения.АдресРесурса + "/member");HTTPЗапрос.Заголовки.Вставить("member_inn",СокрЛП(Участник.ИНН));
		HTTPОтвет	= HTTPСоединение.Получить(HTTPЗапрос);
		Если HTTPОтвет.КодСостояния = 200 Тогда
			МЗ = РегистрыСведений.CW_DT_ИдентификаторыУчастников.СоздатьМенеджерЗаписи();
			МЗ.Участник = Участник;
			МЗ.Идентификатор = СокрЛП(HTTPОтвет.ПолучитьТелоКакСтроку());
			МЗ.Записать(Истина);Возврат Истина
		ИначеЕсли HTTPОтвет.КодСостояния = 404 Тогда
			Сообщить("Участник не найден в сервисе!");Возврат Ложь
		Иначе Сообщить("Неизвестная ошибка!");Возврат Ложь
		КонецЕсли; 
	Исключение Сообщить("Ошибка HTTP запроса!");Возврат Ложь
	КонецПопытки;
КонецФункции

Функция ПроверитьИдентификаторУчастника(Участник) Экспорт
	Ответ = ПолучитьИдентификаторУчастника(Участник);
	Если ЗначениеЗаполнено(Ответ) Тогда
		Возврат Истина
	Иначе
		Возврат СформироватьИдентификаторУчастникаПоИНН(Участник);	
	КонецЕсли; 
КонецФункции

Функция ПрофильОбменаПоИНН(КонтрагентИНН,ОрганизацияИНН) Экспорт
	Запрос = Новый Запрос;Запрос.Текст = 
		"ВЫБРАТЬ
		|	CW_DT_ПрофилиОбмена.Ссылка КАК Ссылка,
		|	CW_DT_ПрофилиОбмена.Организация КАК Организация,
		|	CW_DT_ПрофилиОбмена.Контрагент КАК Контрагент,
		|	CW_DT_ПрофилиОбмена.ТипКонвертера КАК ТипКонвертера,
		|	CW_DT_ПрофилиОбмена.ВложениеКонвертера КАК ВложениеКонвертера
		|ИЗ
		|	Справочник.CW_DT_ПрофилиОбмена КАК CW_DT_ПрофилиОбмена
		|ГДЕ
		|	CW_DT_ПрофилиОбмена.Организация.ИНН = &ОрганизацияИНН
		|	И CW_DT_ПрофилиОбмена.Контрагент.ИНН = &КонтрагентИНН";
	Запрос.УстановитьПараметр("КонтрагентИНН",	КонтрагентИНН);
	Запрос.УстановитьПараметр("ОрганизацияИНН", ОрганизацияИНН);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Количество() = 1 Тогда
		Выборка.Следующий();
		Стру = Новый Структура("Организация,Контрагент,ТипКонвертера,ВложениеКонвертера,Ссылка");
		ЗаполнитьЗначенияСвойств(Стру,Выборка);
		Возврат Стру
	КонецЕсли; 
КонецФункции

