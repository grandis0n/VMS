//Процедура ПроверитьУстановитьРолиПользователейДляДоступаКПодсистемаБухгалтерияЭкспедитора(ТекущийПользователь)
//
//	Проверяет у текущего пользователя наличие роли "БухгалтерияЭкспдитора" и "БухгалтерияЭкспедитораМенеджер",
//  при их отсутствии и наличии пользователя в группах пользователе БЭ устанавилвает их,
//	за исключением администратораСистемы
//
Функция ПроверитьУстановитьРолиПользователейДляДоступаКПодсистемаБухгалтерияЭкспедитора() Экспорт
	
	НаборРолейИзменен 	= Ложь;
 	мДобавляемыеРоли 	= Новый Массив;
	
	//наборы ролей
	РольАдминистраторСистемы 				= Метаданные.Роли.АдминистраторСистемы;
	РольБухгалтерияЭкспедитораАдминистратор = Метаданные.Роли.БухгалтерияЭкспедитораАдминистратор;
	РольБухгалтерияЭкспедитора 				= Метаданные.Роли.БухгалтерияЭкспедитора;
	РольБухгалтерияЭкспедитораМенеджер 		= Метаданные.Роли.БухгалтерияЭкспедитораМенеджер;
	
	Запрос = Новый запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	CW_ПараметрыПользователей.Пользователь КАК Пользователь,
	               |	CW_ПараметрыПользователей.Пользователь.ИдентификаторПользователяИБ КАК ИдентификаторПользователяИБ,
	               |	CW_ПараметрыПользователей.Группа КАК Группа
	               |ИЗ
	               |	РегистрСведений.CW_ПараметрыПользователей КАК CW_ПараметрыПользователей
	               |ГДЕ
	               |	НЕ CW_ПараметрыПользователей.Пользователь.ПометкаУдаления
	               |	И НЕ CW_ПараметрыПользователей.Пользователь.Недействителен";
	
	РезультатЗапроса = Запрос.Выполнить();

	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		// если по каким-то причинам в регистре есть записи с незаполненным пользователем,
		// пропускаем такие записи
		Если Не ЗначениеЗаполнено(Выборка.Пользователь) Тогда
			Продолжить;
		КонецЕсли;
		
		ПользовательИБ = ПользователиИнформационнойБазы.НайтиПоУникальномуИдентификатору(Выборка.ИдентификаторПользователяИБ);
		
		Если ПользовательИБ = Неопределено Тогда
			//По каким-то причинам пользовавтеля в базе не нашли
			Продолжить;
		КонецЕсли;
		
		Если ПользовательИБ.Роли.Содержит(РольАдминистраторСистемы) Тогда
			//Пропускаем админитраторов системы, у них полные права, 
			//даже если включены в группу администраторы
			Продолжить;			
		КонецЕсли;

		ГруппаПользователя = Выборка.Группа;

		Если Не ПользовательИБ.Роли.Содержит(РольБухгалтерияЭкспедитора) Тогда
			//Для контроля лицензий
			Если мДобавляемыеРоли.Найти(РольБухгалтерияЭкспедитора) = Неопределено Тогда
				мДобавляемыеРоли.Добавить(РольБухгалтерияЭкспедитора);
			КонецЕсли;
		КонецЕсли;
	
		Если ГруппаПользователя = Справочники.CW_ГруппыПользователей.Администраторы Тогда
			
			Если Не ПользовательИБ.Роли.Содержит(РольБухгалтерияЭкспедитораАдминистратор) Тогда
				мДобавляемыеРоли.Добавить(РольБухгалтерияЭкспедитораАдминистратор);
			КонецЕсли;
			
		ИначеЕсли Не ПользовательИБ.Роли.Содержит(РольБухгалтерияЭкспедитораМенеджер) Тогда
			
			Если мДобавляемыеРоли.Найти(РольБухгалтерияЭкспедитораМенеджер) = Неопределено Тогда
				мДобавляемыеРоли.Добавить(РольБухгалтерияЭкспедитораМенеджер);
			КонецЕсли;
			
		КонецЕсли;
		
		Для Каждого ТекущаяРоль из мДобавляемыеРоли Цикл
			ПользовательИБ.Роли.Добавить(ТекущаяРоль);
			НаборРолейИзменен = Истина;
		КонецЦикла;
		
		Если НаборРолейИзменен Тогда
			ПользовательИБ.Записать();
		КонецЕсли;
		
	КонецЦикла;

	Возврат НаборРолейИзменен;
	
КонецФункции

Функция ПолучитьПраваНаПараметрыДляГруппыПользовтея(МассивПараметров = Неопределено, Пользователь = Неопределено) Экспорт 
	
	Если Пользователь = Неопределено Тогда
		Пользователь = ПараметрыСеанса.ТекущийПользователь;
	КонецЕсли;
		
	ЭтоПолноправныйПользователь = CW_ПраваДоступа.ЭтоПолноправныйПользователь(ПараметрыСеанса.ТекущийПользователь,Истина);
	
	ГруппаПользователя = CW_ПраваДоступа_ПИ.ГруппаПользователя(Пользователь);
	Если (ГруппаПользователя = Неопределено) Тогда
		ГруппаПользователя = Справочники.CW_ГруппыПользователей.ПустаяСсылка();
	КонецЕсли; 
	Если (ГруппаПользователя.ПолныеПрава) Тогда
		ГруппаПользователя = Справочники.CW_ГруппыПользователей.Администраторы;
	КонецЕсли; 
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	CW_ПараметрыГрузоперевозок.Ссылка КАК Параметр,
	               |	ВЫБОР
	               |		КОГДА CW_ПараметрыГрузоперевозок.НеПоказыватьВФормеГрузоперевозок
	               |			ТОГДА &ЭтоПолноправныйПользователь
	               |		ИНАЧЕ ВЫБОР
	               |				КОГДА &ПолныеПрава
	               |					ТОГДА ИСТИНА
	               |				ИНАЧЕ ЕСТЬNULL(CW_ПраваДоступаДляПараметровМониторинга.Просмотр, ЛОЖЬ)
	               |			КОНЕЦ
	               |	КОНЕЦ КАК Просмотр,
	               |	ВЫБОР
	               |		КОГДА CW_ПараметрыГрузоперевозок.НеПоказыватьВФормеГрузоперевозок
	               |			ТОГДА &ЭтоПолноправныйПользователь
	               |		ИНАЧЕ ВЫБОР
	               |				КОГДА &ПолныеПрава
	               |					ТОГДА ИСТИНА
	               |				ИНАЧЕ ЕСТЬNULL(CW_ПраваДоступаДляПараметровМониторинга.Редактирование, ЛОЖЬ)
	               |			КОНЕЦ
	               |	КОНЕЦ КАК Редактирование
	               |ИЗ
	               |	ПланВидовХарактеристик.CW_ПараметрыГрузоперевозок КАК CW_ПараметрыГрузоперевозок
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.CW_ПраваДоступаДляПараметровМониторинга КАК CW_ПраваДоступаДляПараметровМониторинга
	               |		ПО (CW_ПраваДоступаДляПараметровМониторинга.Параметр = CW_ПараметрыГрузоперевозок.Ссылка)
	               |			И (CW_ПраваДоступаДляПараметровМониторинга.Группа = &Группа)
	               |ГДЕ
	               |	CW_ПараметрыГрузоперевозок.ЭтоГруппа = ЛОЖЬ
	               |	И CW_ПараметрыГрузоперевозок.Предопределенный = ЛОЖЬ
				   |	//УсловиеПоПараметрам";
	
	
	Если МассивПараметров <> Неопределено Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "//УсловиеПоПараметрам", "И CW_ПараметрыГрузоперевозок.Ссылка В(&МассивПараметров)");
	КонецЕсли;
	
	Запрос.УстановитьПараметр("МассивПараметров", 				МассивПараметров);
	Запрос.УстановитьПараметр("Группа", 						ГруппаПользователя);
	Запрос.УстановитьПараметр("ПолныеПрава", 					ГруппаПользователя.ПолныеПрава);
	Запрос.УстановитьПараметр("ЭтоПолноправныйПользователь", 	ЭтоПолноправныйПользователь);
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	Результат = Новый Соответствие;
	
	Пока Выборка.Следующий() Цикл
		
		СтруктураПравПараметра = Новый Структура("Просмотр,Редактирование",Ложь,Ложь); 
		ЗаполнитьЗначенияСвойств(СтруктураПравПараметра,Выборка);
		
		Результат.Вставить(Выборка.Параметр, СтруктураПравПараметра);
		
	КонецЦикла; 
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьДоступныеПараметрыДляГруппыПользователя(Пользователь = Неопределено) Экспорт 
	
	Если Пользователь = Неопределено Тогда
		Пользователь = ПараметрыСеанса.ТекущийПользователь;
	КонецЕсли;
		
	ЭтоПолноправныйПользователь = CW_ПраваДоступа.ЭтоПолноправныйПользователь(ПараметрыСеанса.ТекущийПользователь,Истина);
	
	Если ЭтоПолноправныйПользователь Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ГруппаПользователя = CW_ПраваДоступа_ПИ.ГруппаПользователя(Пользователь);
	Если (ГруппаПользователя = Неопределено) Тогда
		ГруппаПользователя = Справочники.CW_ГруппыПользователей.ПустаяСсылка();
	КонецЕсли; 
	Если (ГруппаПользователя.ПолныеПрава) Тогда
		ГруппаПользователя = Справочники.CW_ГруппыПользователей.Администраторы;
	КонецЕсли; 

	Если ГруппаПользователя.ПолныеПрава Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	CW_ПраваДоступаДляПараметровМониторинга.Параметр КАК Параметр
	               |ИЗ
	               |	РегистрСведений.CW_ПраваДоступаДляПараметровМониторинга КАК CW_ПраваДоступаДляПараметровМониторинга
	               |ГДЕ
	               |	CW_ПраваДоступаДляПараметровМониторинга.Группа = &Группа
	               |	И CW_ПраваДоступаДляПараметровМониторинга.Просмотр = ИСТИНА";
	
	Запрос.УстановитьПараметр("Группа", ГруппаПользователя);
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	Результат = Новый Массив;
	
	Пока Выборка.Следующий() Цикл
		Результат.Добавить(Выборка.Параметр);
	КонецЦикла; 
	
	Возврат Результат;
	
КонецФункции
