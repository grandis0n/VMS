Процедура УстановитьПраваДляФормы(УправляемаяФорма,Право=Неопределено) Экспорт 
	
	ТипОбъекта = _сф.стр_ПолучитьСтроку(УправляемаяФорма.ИмяФормы,".",1);
	ИмяОбъекта = _сф.стр_ПолучитьСтроку(УправляемаяФорма.ИмяФормы,".",2);
	
	РедактированиеЗапрещено = РегистрыСведений.CW_ДоступныеСправочникиПоГруппамПользователей.РедактированиеОбъектаЗапрещено(ТипОбъекта+"."+ИмяОбъекта);
	
	ФормаСписка = (Найти(УправляемаяФорма.ИмяФормы,"ФормаСписка") <> 0);
	
	Если РедактированиеЗапрещено Тогда
		
		УправляемаяФорма.ТолькоПросмотр = Истина;
		
		Если (ИмяОбъекта = "CW_Линии" И ФормаСписка) Тогда
			УправляемаяФорма.Элементы.ФормаДобавитьИзКлассификатора.Доступность = Ложь;
		КонецЕсли; 
		
	КонецЕсли; 
	
КонецПроцедуры


