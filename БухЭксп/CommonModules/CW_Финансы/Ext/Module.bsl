	// --- 
	
	СтрокаДЗ.Задолженность = 0;
	СтрокаДЗ.Оплата_Валюта = 0;
	СтрокаДЗ.Оплата_БВ = 0;
	СтрокаДЗ.СуммаДокумента = 0;
	СтрокаДЗ.Задолженность_БВ = 0;
	СтрокаДЗ.Аванс = 0;
	
	// --- 
КонецПроцедуры

Процедура ВыполнитьАвтораспределениеОплатыПоСчетам(ДеревоОплат, СуммаОплаты, ПустойАкт, УЕ, СтруктураКурса) Экспорт 
	
	ОстатокРаспределения = СуммаОплаты;
	Если (УЕ) Тогда
		ОстатокРаспределения_БВ = ОстатокРаспределения;
		ОстатокРаспределения 	= Окр(СуммаОплаты / СтруктураКурса.Курс * СтруктураКурса.Кратность, 2);
	КонецЕсли;  
	
	ЭтоДерево = (ТипЗнч(ДеревоОплат)=Тип("ДеревоЗначений"));
	МассивСтрокАвансовПоДоговору = Новый Массив;
	Если (ЭтоДерево) Тогда
		КоллекцияСтрокДерева = ДеревоОплат.Строки;
	Иначе
		КоллекцияСтрокДерева = ДеревоОплат.ПолучитьЭлементы();
	КонецЕсли; 
	Для каждого Стр Из КоллекцияСтрокДерева Цикл
		
		// очищаем оплаты
		Стр.Оплата_Валюта = 0;
		Стр.Оплата_БВ = 0;
		Если (ЭтоДерево) Тогда
			КоллекцияСтрокСчета = Стр.Строки;
		Иначе
			КоллекцияСтрокСчета = Стр.ПолучитьЭлементы();
		КонецЕсли; 
		Для каждого СтрокаСчета Из КоллекцияСтрокСчета Цикл
			
			СтрокаСчета.Оплата_Валюта = 0;
			СтрокаСчета.Оплата_БВ = 0;
			
		КонецЦикла; 

		Если (ОстатокРаспределения <> 0 И Стр.Задолженность > 0) Тогда
			
			Если (Стр.Документ <> ПустойАкт) Тогда
				Стр.Оплата_Валюта = Мин(ОстатокРаспределения,Стр.Задолженность);   
				
				// подставляем ставку и сумму НДС
				Стр.СтавкаНДС = Стр.СтавкаНДСИсходная;
				Если Стр.Оплата_Валюта = Стр.Задолженность Тогда
					Стр.СуммаНДС = Стр.СуммаНДСИсходная; 	
				Иначе
					Если Стр.Задолженность <> 0 Тогда 
						Стр.СуммаНДС = Окр(Стр.СуммаНДСИсходная * Стр.Оплата_Валюта/Стр.СуммаДокумента,2,1); 
					КонецЕсли;
				КонецЕсли;
				
				_сф.Декремент(ОстатокРаспределения, Стр.Оплата_Валюта);
				Если (УЕ) Тогда
					Стр.Курс =  СтруктураКурса.Курс;
					Стр.Оплата_БВ = Стр.Оплата_Валюта * СтруктураКурса.Курс / СтруктураКурса.Кратность;
					_сф.Декремент(ОстатокРаспределения_БВ, Стр.Оплата_БВ);
				КонецЕсли; 
			КонецЕсли; // если в строке указан документ задолженности
			
		ИначеЕсли (ОстатокРаспределения <> 0 И Стр.Задолженность = 0) Тогда 
			
			Если (Стр.Документ = ПустойАкт) Тогда
				
				МассивСтрокАвансовПоДоговору.Добавить(Стр);	
				
			КонецЕсли; 
			
		КонецЕсли;
		
	КонецЦикла; 
		
	Если (ОстатокРаспределения <> 0 И МассивСтрокАвансовПоДоговору.Количество() <> 0) Тогда
		
		// это аванс по договору, то относим его на возмещаемые (если есть разделение на "србственные" и "возмещаемые")
		Если (МассивСтрокАвансовПоДоговору.Количество() = 1) Тогда
			Стр = _сф.к_ПервыйЭлемент(МассивСтрокАвансовПоДоговору);
		Иначе
			Стр = _сф.к_ПоследнийЭлемент(МассивСтрокАвансовПоДоговору);
		КонецЕсли; 
		
		Стр.Оплата_Валюта = ОстатокРаспределения; 
		
		// получим ставку и рассчитаем сумму НДС 
		Стр.СтавкаНДС = Стр.СтавкаНДСИсходная;  
		ЗначениеСтавки = CW_Финансы.ПолучитьСтавкуНДС(Стр.СтавкаНДС)/100;
 		Стр.СуммаНДС = Окр(Стр.Оплата_Валюта  * ЗначениеСтавки/(1+ЗначениеСтавки),2,1);

		_сф.Декремент(ОстатокРаспределения, Стр.Оплата_Валюта);
		Если (УЕ) Тогда
			Стр.Оплата_БВ = ОстатокРаспределения_БВ;
			_сф.Декремент(ОстатокРаспределения_БВ,Стр.Оплата_БВ);
			Стр.Курс = _сф.БезопасноРазделить(Стр.Оплата_БВ,Стр.Оплата_Валюта) * СтруктураКурса.Кратность;
		КонецЕсли; 
		
	КонецЕсли; 

КонецПроцедуры

Процедура ЗаполнитьТаблицыПлатежныхДокументов(ДеревоОплат, ТаблицаОЗ, ТабличнаяЧасть, ПараметрыЗаполнения) Экспорт
	
	Договор 	= ПараметрыЗаполнения.Договор;
	СтатьяДДС 	= ПараметрыЗаполнения.СтатьяДДС;
	ПорядокОтраженияАванса = ПараметрыЗаполнения.ПорядокОтраженияАванса;
	УЕ 			= ПараметрыЗаполнения.УЕ;
	ПустойАкт	= ПараметрыЗаполнения.ПустойАкт; 

	Курс 		= ПараметрыЗаполнения.Курс;
	Кратность 	= ПараметрыЗаполнения.Кратность;

	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("Договор", 			ПараметрыЗаполнения.Договор);
	СтруктураПараметров.Вставить("ПриложениеКДоговору",	ПараметрыЗаполнения.ПриложениеКДоговору);

	УчетныйДоговор = CW_Финансы.ПолучитьУчетныйДоговор(СтруктураПараметров);

	ЭтоДерево = (ТипЗнч(ДеревоОплат)=Тип("ДеревоЗначений"));

	Если (ЭтоДерево) Тогда
		КоллекцияСтрокДерева = ДеревоОплат.Строки;
	Иначе
		КоллекцияСтрокДерева = ДеревоОплат.ПолучитьЭлементы();
	КонецЕсли; 

	Для каждого СтрокаСчета Из КоллекцияСтрокДерева Цикл

		СуммаОплатыПоСчету = СтрокаСчета.Оплата_Валюта;
		СуммаОплатыПоСчету_БВ = СтрокаСчета.Оплата_БВ;   
		СуммаОплатыПоСчетуНДС = СтрокаСчета.СуммаНДС; 

		ОплатаПоАктам = 0;
		ОплатаПоАктам_БВ = 0; 
		ОплатаПоАктамНДС = 0;

		Если (ЭтоДерево) Тогда
			КоллекцияСтрокСчета = СтрокаСчета.Строки;
		Иначе
			КоллекцияСтрокСчета = СтрокаСчета.ПолучитьЭлементы();
		КонецЕсли; 

		// перебираем все акты к строке со счетом
		Для каждого СтрокаАкта Из КоллекцияСтрокСчета Цикл
			Если СтрокаАкта.Оплата_Валюта <> 0 Тогда

				Нстр = ТаблицаОЗ.Добавить();

				Нстр.Счет = СтрокаСчета.Документ;
				Нстр.СчетЗадолженности = СтрокаСчета.СчетЗадолженности;
				Нстр.СчетАванса = _БЭ.СчетАванса(СтрокаСчета.СчетЗадолженности);
				Нстр.Акт = СтрокаАкта.Документ;
				Нстр.Оплата = СтрокаАкта.Оплата_Валюта; 

				Нстр.НДС 		=  СтрокаАкта.СуммаНДС;
				Нстр.СтавкаНДС 	=  СтрокаАкта.СтавкаНДС;

				Если УЕ Тогда
					Нстр.Курс = СтрокаАкта.Курс;
					Нстр.Оплата_БВ = СтрокаАкта.Оплата_БВ;
				Иначе
					Нстр.Курс = Курс;
					Нстр.Оплата_БВ = СтрокаАкта.Оплата_Валюта*Нстр.Курс / Кратность;
				КонецЕсли; 

				_сф.Инкремент(ОплатаПоАктам,Нстр.Оплата);
				_сф.Инкремент(ОплатаПоАктам_БВ,Нстр.Оплата_БВ);
				_сф.Инкремент(ОплатаПоАктамНДС,Нстр.НДС);


				НстрТЧ = ТабличнаяЧасть.Добавить();
				НстрТЧ.ДоговорКонтрагента = УчетныйДоговор;
				НстрТЧ.КурсВзаиморасчетов = Нстр.Курс;
				НстрТЧ.КратностьВзаиморасчетов = Кратность;
				НстрТЧ.СтатьяДвиженияДенежныхСредств = СтатьяДДС;

				Если (УЕ) Тогда
					НстрТЧ.СуммаПлатежа = СтрокаАкта.Оплата_БВ;
					НстрТЧ.СуммаВзаиморасчетов = СтрокаАкта.Оплата_Валюта;	
				Иначе
					НстрТЧ.СуммаПлатежа = СтрокаАкта.Оплата_Валюта;
					НстрТЧ.СуммаВзаиморасчетов = СтрокаАкта.Оплата_Валюта;	
				КонецЕсли; 

				НстрТЧ.СпособПогашенияЗадолженности = Перечисления.СпособыПогашенияЗадолженности.ПоДокументу;

				// порядок отражения авансов для УСН
				Если ПараметрыЗаполнения.ТипДокумента = Тип("ДокументСсылка.ПоступлениеНаРасчетныйСчет") Тогда
					НстрТЧ.ПорядокОтраженияАванса = ПорядокОтраженияАванса;
				КонецЕсли;

				// подставляем счет на оплату
				Если (ЗначениеЗаполнено(СтрокаСчета.Документ.ВедомыйСчет)) Тогда
					НстрТЧ.СчетНаОплату = СтрокаСчета.Документ.ВедомыйСчет;
				КонецЕсли;

				// документ взаиморасчетов и счета учета задолженности
				НстрТЧ.Сделка = СтрокаАкта.Документ.ВедомыйДокумент;
				НстрТЧ.СчетУчетаРасчетовСКонтрагентом = СтрокаСчета.СчетЗадолженности;
				НстрТЧ.СчетУчетаРасчетовПоАвансам = _БЭ.СчетАванса(СтрокаСчета.СчетЗадолженности);

				#Область РасчетСуммыИСтавкиНДСПоСтроке
				ТаблицаУслугАкта = _БЭ.ПолучитьУслугиДокумента(СтрокаАкта.Документ);

				Если (НЕ СтрокаАкта.Документ.СписокСчетов) Тогда
					ТаблицаУслугАкта.ЗаполнитьЗначения(СтрокаСчета.Документ,"Счет")
				КонецЕсли; 

				НстрТЧ.СуммаНДС		= СтрокаАкта.СуммаНДС;
				НстрТЧ.СтавкаНДС 	= СтрокаАкта.СтавкаНДС;  

				#КонецОбласти // РасчетСуммыИСтавкиНДСПоСтроке

			КонецЕсли; // если валютная сумма <> 0 
		КонецЦикла; // перебор актов к счету

		// остаток оплаты по счету, нераспределенный по актам 
		// отражаем в виде аванса
		ОстатокОплаты = СуммаОплатыПоСчету - ОплатаПоАктам;
		СуммаОплатыПоСчетуНДС = СтрокаСчета.СуммаНДС; 
		ОстатокОплаты_БВ = СуммаОплатыПоСчету_БВ - ОплатаПоАктам_БВ; 
		ОстатокОплатыНДС = СуммаОплатыПоСчетуНДС - ОплатаПоАктамНДС; 
		Если ОстатокОплаты > 0 Тогда

			Нстр = ТаблицаОЗ.Добавить();
			Нстр.Счет = СтрокаСчета.Документ;
			Нстр.СчетЗадолженности = СтрокаСчета.СчетЗадолженности;
			Нстр.СчетАванса = _БЭ.СчетАванса(СтрокаСчета.СчетЗадолженности);
			Нстр.Акт = ПустойАкт;
			Нстр.Оплата = ОстатокОплаты;
			Нстр.СтавкаНДС = СтрокаСчета.СтавкаНДС;

			Если (УЕ) Тогда
				Нстр.Оплата_БВ = ОстатокОплаты_БВ;
				Нстр.Курс = _сф.БезопасноРазделить(ОстатокОплаты_БВ,ОстатокОплаты) * Кратность;
			Иначе
				Нстр.Курс = Курс;
				Нстр.Оплата_БВ = ОстатокОплаты*Нстр.Курс / Кратность;
			КонецЕсли;

			Нстр.СтавкаНДС	= СтрокаСчета.СтавкаНДС;
			Нстр.НДС		= ОстатокОплатыНДС;

			// анализируем ставки НДС оплачиваемого счёта
			Счет = СтрокаСчета.Документ;

			// это аванс по договору - НДС всегда 18%
			Если (Счет.Пустая()) Тогда

				НстрТЧ = ТабличнаяЧасть.Добавить();
				НстрТЧ.ДоговорКонтрагента = УчетныйДоговор;
				НстрТЧ.КурсВзаиморасчетов = Нстр.Курс;
				НстрТЧ.КратностьВзаиморасчетов = Кратность;
				НстрТЧ.СтатьяДвиженияДенежныхСредств = СтатьяДДС;

				Если (УЕ) Тогда

					НстрТЧ.СуммаПлатежа = ОстатокОплаты_БВ;
					НстрТЧ.СуммаВзаиморасчетов = ОстатокОплаты;

				Иначе

					НстрТЧ.СуммаПлатежа = ОстатокОплаты;
					НстрТЧ.СуммаВзаиморасчетов = ОстатокОплаты;

				КонецЕсли; 

				НстрТЧ.СпособПогашенияЗадолженности = Перечисления.СпособыПогашенияЗадолженности.НеПогашать;

				// порядок отражения авансов для УСН
				Если ПараметрыЗаполнения.ТипДокумента = Тип("ДокументСсылка.ПоступлениеНаРасчетныйСчет") Тогда
					НстрТЧ.ПорядокОтраженияАванса = ПорядокОтраженияАванса;
				КонецЕсли;

				НстрТЧ.СчетУчетаРасчетовСКонтрагентом = СтрокаСчета.СчетЗадолженности;
				НстрТЧ.СчетУчетаРасчетовПоАвансам = _БЭ.СчетАванса(СтрокаСчета.СчетЗадолженности);

				НстрТЧ.СуммаНДС		= СтрокаСчета.СуммаНДС;
				НстрТЧ.СтавкаНДС	= СтрокаСчета.СтавкаНДС;

				// оплата по счету (без привязки к акту)
			Иначе

				// рассчитываем НДС для корректного заполнения платежного поручения
				Отбор = Новый Структура("СчетЗадолженности",СтрокаСчета.СчетЗадолженности);
				ТаблицаУслугСчета = _БЭ.ПолучитьУслугиДокумента(Счет).Скопировать(Отбор);

				НстрТЧ = ТабличнаяЧасть.Добавить();
				НстрТЧ.ДоговорКонтрагента = УчетныйДоговор;
				НстрТЧ.КурсВзаиморасчетов = Нстр.Курс;
				НстрТЧ.КратностьВзаиморасчетов = Кратность;
				НстрТЧ.СтатьяДвиженияДенежныхСредств = СтатьяДДС;

				Если (УЕ) Тогда
					НстрТЧ.СуммаПлатежа = ОстатокОплаты_БВ;
					НстрТЧ.СуммаВзаиморасчетов = ОстатокОплаты;
				Иначе
					НстрТЧ.СуммаПлатежа = ОстатокОплаты;
					НстрТЧ.СуммаВзаиморасчетов = ОстатокОплаты;
				КонецЕсли; 

				НстрТЧ.СпособПогашенияЗадолженности = Перечисления.СпособыПогашенияЗадолженности.НеПогашать;

				Если ПараметрыЗаполнения.ТипДокумента = Тип("ДокументСсылка.ПоступлениеНаРасчетныйСчет") Тогда
					НстрТЧ.ПорядокОтраженияАванса = ПорядокОтраженияАванса;
				КонецЕсли;

				НстрТЧ.СчетУчетаРасчетовСКонтрагентом = СтрокаСчета.СчетЗадолженности;
				НстрТЧ.СчетУчетаРасчетовПоАвансам = _БЭ.СчетАванса(СтрокаСчета.СчетЗадолженности);

				// при наличии ссылки на бухгалтерский документ "Счет" подставляем его в платежное поручение 
				Если (ЗначениеЗаполнено(СтрокаСчета.Документ.ВедомыйСчет)) Тогда
					НстрТЧ.СчетНаОплату = СтрокаСчета.Документ.ВедомыйСчет;
				КонецЕсли;	

				НстрТЧ.СуммаНДС		= ОстатокОплатыНДС;
				НстрТЧ.СтавкаНДС	= СтрокаСчета.СтавкаНДС;  

				// порядок отражения авансов для УСН
				Если ПараметрыЗаполнения.ТипДокумента = Тип("ДокументСсылка.ПоступлениеНаРасчетныйСчет") Тогда
					НстрТЧ.ПорядокОтраженияАванса = ПорядокОтраженияАванса;
				КонецЕсли;	

			КонецЕсли; // если счет не пустая ссылка 
		КонецЕсли; // остаток оплаты > 0 
	КонецЦикла; // обход строк дерева 
	
КонецПроцедуры

Функция ПредупреждениеПоСхемеУчетаПеревыставленияПоСтавкам(Объект) Экспорт 
	// --- 
	
	Если (Объект.Дата >= Дата(2014,10,1)) Тогда
		
		ТекстПредупреждения = "Схема перевыставления по ставкам с 01.10.2014 не может быть корректно отражена в части учёта НДС.";
		ПоказыватьПредупреждение = Ложь;
		
		Если (ТипЗнч(Объект)=Тип("ДокументОбъект.CW_ДоходыПоГрузоперевозке")) Тогда
			
			СтавкаБезНДС = Истина;
			Для каждого Стр Из Объект.Услуги Цикл
				
				Если (Стр.ПорядокОтражения = Перечисления.CW_ПорядокОтраженияДоходов.ПеревыставлениеПоСтавкам) Тогда
					
					Если (Стр.СтавкаНДС <> Перечисления.СтавкиНДС.БезНДС) Тогда
						СтавкаБезНДС = Ложь;
					КонецЕсли; 
					
				КонецЕсли; 
				
			КонецЦикла; 
			
			ПоказыватьПредупреждение = (НЕ СтавкаБезНДС И Объект.ФормируетсяСчетФактура);
			
		ИначеЕсли (ТипЗнч(Объект)=Тип("ДокументОбъект.CW_РасходыПоГрузоперевозке")) Тогда 
			
			СтавкаБезНДС = Истина;
			Для каждого Стр Из Объект.Услуги Цикл
				
				Если (Стр.ПорядокОтражения = Перечисления.CW_ПорядокОтраженияЗатрат.ПеревыставлениеПоСтавкам) Тогда
					
					Если (Стр.СтавкаНДС <> Перечисления.СтавкиНДС.БезНДС) Тогда
						СтавкаБезНДС = Ложь;
					КонецЕсли; 
					
				КонецЕсли; 
				
			КонецЦикла; 
			
			ПоказыватьПредупреждение = (НЕ СтавкаБезНДС И Объект.ПредъявленСФ);
			
		ИначеЕсли (ТипЗнч(Объект)=Тип("ДокументОбъект.CW_ЗакрытиеГрузоперевозки")) Тогда 
			
			СтавкаБезНДС_Доходы = Истина;
			Для каждого Стр Из Объект.Доходы Цикл
				
				Если (Стр.СтавкаНДС <> Перечисления.СтавкиНДС.БезНДС) Тогда
					СтавкаБезНДС_Доходы = Ложь;
				КонецЕсли; 
				
			КонецЦикла;
			СтавкаБезНДС_Расходы = Истина;
			Для каждого Стр Из Объект.Доходы Цикл
				
				Если (Стр.СтавкаНДС <> Перечисления.СтавкиНДС.БезНДС) Тогда
					СтавкаБезНДС_Расходы = Ложь;
				КонецЕсли; 
				
			КонецЦикла;
			
			ПоказыватьПредупреждение = (НЕ СтавкаБезНДС_Доходы ИЛИ НЕ СтавкаБезНДС_Расходы) И Объект.ФормируетсяСчетФактура;
			
		КонецЕсли; 
		
		Если (ПоказыватьПредупреждение) Тогда
			
			Сообщить(Объект,СтатусСообщения.Информация);
			Сообщить(ТекстПредупреждения,СтатусСообщения.Информация);
			
		КонецЕсли; 
		
	КонецЕсли; 
	
	// --- 
КонецФункции

Функция ПолучитьФинРез(ГП,ОтображениеФинРеза=Неопределено) Экспорт
	
	ИспользованиеБлокаСобственногоТранспорт = ПолучитьФункциональнуюОпцию("CW_ИспользованиеБлокаСобственногоТранспорта");
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЕСТЬNULL(CW_ДоходыПоГрузоперевозкам.Всего, 0) КАК ДоходыВсего,
		|	ЕСТЬNULL(CW_ДоходыПоГрузоперевозкам.Сумма, 0) КАК ДоходыСумма,
		|	0 КАК РасходыВсего,
		|	0 КАК РасходыСумма,
		|	ЕСТЬNULL(CW_ДоходыПоГрузоперевозкам.Всего_Валюта, 0) КАК ДоходыВсегоВалюта,
		|	0 КАК РасходыВсегоВалюта,
		|	0 КАК ТранспортВсего,
		|	0 КАК ТранспортСумма,
		|	0 КАК ТранспортВсегоВалюта,
		|	CW_ДоходыПоГрузоперевозкам.Контрагент КАК Контрагент
		|ПОМЕСТИТЬ Рез
		|ИЗ
		|	РегистрНакопления.CW_ДоходыПоГрузоперевозкам КАК CW_ДоходыПоГрузоперевозкам
		|ГДЕ
		|	CW_ДоходыПоГрузоперевозкам.Грузоперевозка В(&СпГП)
		|	И ВЫБОР
		|			КОГДА &ФормированиеОтчета = 0
		|				ТОГДА CW_ДоходыПоГрузоперевозкам.ДокументДоходов.ФормируетсяАкт
		|			ИНАЧЕ CW_ДоходыПоГрузоперевозкам.ДокументДоходов.ФормируетсяСчет
		|		КОНЕЦ
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	0,
		|	0,
		|	ЕСТЬNULL(CW_РасходыПоГрузоперевозкам.Всего, 0),
		|	ЕСТЬNULL(CW_РасходыПоГрузоперевозкам.Сумма, 0),
		|	0,
		|	ЕСТЬNULL(CW_РасходыПоГрузоперевозкам.Всего_Валюта, 0),
		|	0,
		|	0,
		|	0,
		|	CW_РасходыПоГрузоперевозкам.Контрагент
		|ИЗ
		|	РегистрНакопления.CW_РасходыПоГрузоперевозкам КАК CW_РасходыПоГрузоперевозкам
		|ГДЕ
		|	CW_РасходыПоГрузоперевозкам.Грузоперевозка В(&СпГП)
		|	И ВЫБОР
		|			КОГДА &ФормированиеОтчета = 0
		|				ТОГДА CW_РасходыПоГрузоперевозкам.ДокументРасходов.ПредъявленАкт
		|						ИЛИ CW_РасходыПоГрузоперевозкам.ДокументРасходов.ПредъявленСФ
		|			ИНАЧЕ CW_РасходыПоГрузоперевозкам.ДокументРасходов.ПредъявленСчет
		|		КОНЕЦ
		|";
	
	Если ИспользованиеБлокаСобственногоТранспорт Тогда
		
		Запрос.Текст = Запрос.Текст + "
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	0,
		|	0,
		|	0,
		|	0,
		|	0,
		|	0,
		|	CW_РасходыПоГрузоперевозкамтранспортныхСредствОбороты.ВсегоОборот,
		|	CW_РасходыПоГрузоперевозкамтранспортныхСредствОбороты.СуммаОборот,
		|	CW_РасходыПоГрузоперевозкамтранспортныхСредствОбороты.Всего_ВалютаОборот,
		|	НЕОПРЕДЕЛЕНО
		|ИЗ
		|	РегистрНакопления.CW_РасходыПоГрузоперевозкамТранспортныхСредств.Обороты(, , Период, Грузоперевозка В (&СпГП)) КАК CW_РасходыПоГрузоперевозкамтранспортныхСредствОбороты";
		
	КонецЕсли;	
	
	Запрос.Текст = Запрос.Текст + "
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СУММА(Рез.ДоходыВсего) КАК ДоходыВсего,
		|	СУММА(Рез.ДоходыСумма) КАК ДоходыСумма,
		|	СУММА(Рез.РасходыВсего) КАК РасходыВсего,
		|	СУММА(Рез.РасходыСумма) КАК РасходыСумма,
		|	СУММА(Рез.ДоходыВсего - Рез.РасходыВсего) КАК ПрибыльВсего,
		|	СУММА(Рез.ДоходыСумма - Рез.РасходыСумма) КАК ПрибыльСумма,
		|	СУММА(Рез.ДоходыВсегоВалюта - Рез.РасходыВсегоВалюта) КАК ПрибыльВсегоВалюта,
		|	СУММА(Рез.ДоходыВсегоВалюта) КАК ДоходыВсегоВалюта,
		|	СУММА(Рез.РасходыВсегоВалюта) КАК РасходыВсегоВалюта,";
	
	Если ИспользованиеБлокаСобственногоТранспорт Тогда
		Запрос.Текст = Запрос.Текст + "
		|	СУММА(Рез.ТранспортВсего) КАК ТранспортВсего,
		|	СУММА(Рез.ТранспортСумма) КАК ТранспортСумма,
		|	СУММА(Рез.ТранспортВсегоВалюта) КАК ТранспортВсегоВалюта,";
	КонецЕсли;
	
	Запрос.Текст = Запрос.Текст + "
		|	Рез.Контрагент КАК Контрагент
		|ИЗ
		|	Рез КАК Рез
		|
		|СГРУППИРОВАТЬ ПО
		|	Рез.Контрагент";
	
	Запрос.УстановитьПараметр("СпГП", ГП);
	Если (ОтображениеФинРеза <> Неопределено) Тогда
		Запрос.УстановитьПараметр("ФормированиеОтчета", ОтображениеФинРеза); 
	Иначе
		Запрос.УстановитьПараметр("ФормированиеОтчета", _БЭ.ПолучитьНастройкуПользователя( , "ОтображениеФинРез")); 	
	КонецЕсли; 
	
	ТЗ = Запрос.Выполнить().Выгрузить();
	
	ИсключатьВнутрихолдинговые = CW_Настройки.ПолучитьНастройкуПользователя(,"ИсключатьВнутрихолдинговыеВзаиморасчеты");
	Если (ИсключатьВнутрихолдинговые) Тогда
		
		МассивХолдинговыхКонтрагентов = ПолучитьКонтрагентовХолдинга();
		Если (МассивХолдинговыхКонтрагентов.Количество() <> 0) Тогда
			МассивУдаляемых = Новый Массив;
			Для каждого Стр Из ТЗ Цикл
				
				Если (МассивХолдинговыхКонтрагентов.Найти(Стр.Контрагент) <> Неопределено) Тогда
					МассивУдаляемых.Добавить(Стр);
				КонецЕсли; 
				
			КонецЦикла; 
			_сф.к_УдалитьЭлементыПоМассиву(ТЗ,МассивУдаляемых);
			
		КонецЕсли; 
		
	КонецЕсли; 
	
	Если ИспользованиеБлокаСобственногоТранспорт Тогда
