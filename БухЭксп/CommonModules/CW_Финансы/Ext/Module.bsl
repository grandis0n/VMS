Функция ПолучитьКонтрагентовХолдинга() Экспорт
	// --- 
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	CW_СоответствиеОрганизацийКонтрагентам.Контрагент
	|ИЗ
	|	РегистрСведений.CW_СоответствиеОрганизацийКонтрагентам КАК CW_СоответствиеОрганизацийКонтрагентам";
	ТаблицаХолдинговыхКонтрагентов = Запрос.Выполнить().Выгрузить();
	МассивХолдинговыхКонтрагентов = ТаблицаХолдинговыхКонтрагентов.ВыгрузитьКолонку("Контрагент");
	Возврат(МассивХолдинговыхКонтрагентов);
	
	// --- 
КонецФункции
Функция ГрузоперевозкиДокумента(Документ) Экспорт
	// --- 
	
	ТЗ = Документ.Услуги.Выгрузить(,"Грузоперевозка");
	ТЗ.Свернуть("Грузоперевозка");
	Возврат(ТЗ.ВыгрузитьКолонку("Грузоперевозка"));
	
	// --- 
КонецФункции
Функция НоменклатураДокумента(Документ) Экспорт
	ТЗ = Документ.Услуги.Выгрузить(,"Номенклатура");
	ТЗ.Свернуть("Номенклатура");
	
	Возврат(ТЗ.ВыгрузитьКолонку("Номенклатура"));
КонецФункции

//Функция ВернутьПлательщика(СтруктураПараметров) Экспорт
//   возрващает плательщика в сооветстви с настрйоками программы
//
//  Параметры:
//   - СтруктураПараметров - тип "Структура", со свойствами:
//		"Объект"		  	- ОбъектДанных;	
//		"ЭтоВариантБюджета 	- булево. Истина для справочника "CW_ВариантыБюджетовПоЗаявкам";	
//		"Контрагент"  	  	- Значение контрагента, которое будет возвращено, если не будет получено иное занчение
//
//	СтруктураПараметров = Новый Структура;
//	СтруктураПараметров.Вставить("Объект"				,);
//	СтруктураПараметров.Вставить("ЭтоВариантБюджета"	,);
//	СтруктураПараметров.Вставить("Контрагент"			,);
//
Функция ВернутьПлательщика(СтруктураПараметров) Экспорт
	
	Если СтруктураПараметров.ЭтоВариантБюджета Тогда
		Возврат СтруктураПараметров.Контрагент;
	КонецЕсли; 
	
	ПараметрПлательщика = Константы.CW_ПараметрПлательщика.Получить();
	Если ПараметрПлательщика.Пустая() Тогда
		Возврат СтруктураПараметров.Контрагент;
	КонецЕсли;
	
	
	СтрокаПараметра = CW_Мониторинг.СтрокаПараметра(СтруктураПараметров.Объект, ПараметрПлательщика);
	Если СтрокаПараметра <> Неопределено Тогда
		Если ЗначениеЗаполнено(СтрокаПараметра.Значение) Тогда
			Возврат СтрокаПараметра.Значение;
		КонецЕсли; 
	КонецЕсли; 
	
	// смотрим настройку пользователя
	КлиентВместоПустогоПлательщика = CW_Настройки.ПолучитьНастройкуПользователя(,"ПодставлятьКлиентаВместоПустогоПлательщика");
	КлиентВместоПустогоПлательщика = ?(КлиентВместоПустогоПлательщика = Неопределено, Ложь, КлиентВместоПустогоПлательщика);
	
	Возврат ?(КлиентВместоПустогоПлательщика, СтруктураПараметров.Контрагент, Справочники.Контрагенты.ПустаяСсылка());
	
КонецФункции	

Функция УСТАРЕЛА_ВернутьПлательщика(ГП) Экспорт
	
	Если ТипЗнч(ГП) = Тип("СправочникСсылка.CW_ВариантыБюджетовПоЗаявкам") Тогда
		Возврат ГП.Владелец.Контрагент;
	КонецЕсли; 
	
	ПараметрПлательщика = Константы.CW_ПараметрПлательщика.Получить();
	Если (ПараметрПлательщика.Пустая()) Тогда
		Возврат ГП.Клиент;
	Иначе
		
		СтрокаПараметра = CW_Мониторинг.СтрокаПараметра(ГП,ПараметрПлательщика);
		Если (СтрокаПараметра = Неопределено) Тогда
			
			Если (ТипЗнч(ГП) = Тип("СправочникСсылка.CW_Заявки")) Тогда 
				Возврат ГП.Контрагент;
			Иначе
				Возврат ГП.Клиент;
			КонецЕсли;
			
		Иначе
			
			Если (СтрокаПараметра.Значение.Пустая()) Тогда
				
				// смотрим настройку пользователя
				ПодставлятьКлиентаВместоПустогоПлательщика = CW_Настройки.ПолучитьНастройкуПользователя(,"ПодставлятьКлиентаВместоПустогоПлательщика");
				Если (ПодставлятьКлиентаВместоПустогоПлательщика=Неопределено) Тогда
					ПодставлятьКлиентаВместоПустогоПлательщика = Ложь;
				КонецЕсли; 
				Если (ПодставлятьКлиентаВместоПустогоПлательщика) Тогда
					Если (ТипЗнч(ГП) = Тип("СправочникСсылка.CW_Заявки")) Тогда 
						Возврат ГП.Контрагент;
					Иначе
						Возврат ГП.Клиент;
					КонецЕсли;
				Иначе
					Возврат(Справочники.Контрагенты.ПустаяСсылка());
				КонецЕсли; 
				
			Иначе
				
				Возврат(СтрокаПараметра.Значение);
				
			КонецЕсли; 
			
		КонецЕсли; 
		
	КонецЕсли; 
	
КонецФункции	

Функция ПолучитьУслугиДокумента(Документ) Экспорт 
	
	// только валютные суммы
	ТаблицаПоДокументу = Документ.Услуги.Выгрузить(); 
	
	Если Документ.ЦенаСНДС Тогда  
		//преобразовываем цену к цене без НДС;
		Для каждого СтрокаТаблицы Из ТаблицаПоДокументу Цикл 
			СтрокаТаблицы.Цена = (СтрокаТаблицы.Всего - СтрокаТаблицы.НДС) / ?(СтрокаТаблицы.Количество = 0,1,СтрокаТаблицы.Количество);
		КонецЦикла; 
	КонецЕсли;
	
	ДобавитьКолонкиБазовойВалюты(ТаблицаПоДокументу);
	ВРУ = Константы.ВалютаРегламентированногоУчета.Получить();

	Если Документ.Валюта = ВРУ  Тогда
		Для каждого Стр Из ТаблицаПоДокументу Цикл
			Стр.Цена_Рег = Стр.Цена;
			Стр.Сумма_Рег = Стр.Сумма;
			Стр.НДС_Рег = Стр.НДС;
			Стр.Всего_Рег = Стр.Всего;
		КонецЦикла; 
	Иначе
		
		ЭтоДоходы = Ложь;
		ЭтоРасходы = Ложь;
		
		Если ТипЗнч(Документ) = Тип("ДокументСсылка.CW_ДоходыПоГрузоперевозке") Тогда
			ЭтоДоходы = Истина;
			ЕстьАкт = (Документ.ФормируетсяАкт);
			ДатаАкта = ?(Документ.ФормируетсяАкт, Документ.ДатаАкта, Документ.Дата);
			ПринимаетсяКУчету = Истина;
		Иначе
			
			ЭтоРасходы = Истина;
			ЕстьАкт = (Документ.ПредъявленАкт ИЛИ Документ.ПредъявленСФ);
			ДатаАкта = ?(Документ.ПредъявленАкт,Документ.ДатаАкта,Документ.ДатаСФ);
			 СтатусДокументаПринимаетсяКУчету = Истина;
			
			//Подсистема.СтатусыДокументов
			Если ПолучитьФункциональнуюОпцию("CW_ИспользуютсяСтатусыДокументов") Тогда
				ДанныеСтатуса 						= РегистрыСведений.CW_СтатусыДокументов.ПолучитьДанныеСтатусаДокумента(Документ);
				СтатусДокументаПринимаетсяКУчету	= CW_СтатусыДокументовСервер.ПолучитьПризнакПроведенияПоБухгалтерскомуУчету(Документ, ДанныеСтатуса.СтатусДокумента);
			КонецЕсли;
			//Подсистема.СтатусыДокументов
			
			СтруктураПараметровБухУчета = Новый Структура;
			СтруктураПараметровБухУчета.Вставить("Договор", 				Документ.Договор);
			СтруктураПараметровБухУчета.Вставить("ПриложениеКДоговору",		Документ.ПриложениеКДоговору);
			
			ПараметрыБухгалтерскогоУчета  	= CW_Финансы.ПолучитьПарметрыВеденияБухгалтерскогоУчета(СтруктураПараметровБухУчета, Документ.Дата);
			ПринимаетсяКУчету 				= ПараметрыБухгалтерскогоУчета.БухгалтерскийУчет и СтатусДокументаПринимаетсяКУчету;
		КонецЕсли; 
		
		Если (Документ.Проведен И ПринимаетсяКУчету) Тогда
			
			// снимаем остатки с регистра
			Если ЭтоДоходы Тогда
				
				Запрос = Новый Запрос;
				Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
				               |	CW_ДоходыПоГрузоперевозкам.НомерСтроки КАК НомерСтроки,
				               |	CW_ДоходыПоГрузоперевозкам.Грузоперевозка КАК Грузоперевозка,
				               |	CW_ДоходыПоГрузоперевозкам.Номенклатура КАК Номенклатура,
				               |	CW_ДоходыПоГрузоперевозкам.СтавкаНДС КАК СтавкаНДС,
				               |	CW_ДоходыПоГрузоперевозкам.СтатьяЗатрат КАК СтатьяЗатрат,
				               |	СУММА(CW_ДоходыПоГрузоперевозкам.Всего_Валюта) КАК Всего_Валюта,
				               |	СУММА(ВЫБОР
				               |			КОГДА CW_ДоходыПоГрузоперевозкам.Регистратор.Корректировка
				               |					И CW_ДоходыПоГрузоперевозкам.Регистратор.ВидОперацииКорректировки = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийИсправленияПоступленияРеализации.ИсправлениеОшибки)
				               |				ТОГДА CW_ДоходыПоГрузоперевозкам.ПК_Всего
				               |			ИНАЧЕ CW_ДоходыПоГрузоперевозкам.Всего
				               |		КОНЕЦ) КАК Всего_Рег,
				               |	СУММА(ВЫБОР
				               |			КОГДА CW_ДоходыПоГрузоперевозкам.Регистратор.Корректировка
				               |					И CW_ДоходыПоГрузоперевозкам.Регистратор.ВидОперацииКорректировки = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийИсправленияПоступленияРеализации.ИсправлениеОшибки)
				               |				ТОГДА CW_ДоходыПоГрузоперевозкам.ПК_Сумма
				               |			ИНАЧЕ CW_ДоходыПоГрузоперевозкам.Сумма
				               |		КОНЕЦ) КАК Сумма_Рег,
				               |	СУММА(ВЫБОР
				               |			КОГДА CW_ДоходыПоГрузоперевозкам.Регистратор.Корректировка
				               |					И CW_ДоходыПоГрузоперевозкам.Регистратор.ВидОперацииКорректировки = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийИсправленияПоступленияРеализации.ИсправлениеОшибки)
				               |				ТОГДА CW_ДоходыПоГрузоперевозкам.ПК_НДС
				               |			ИНАЧЕ CW_ДоходыПоГрузоперевозкам.НДС
				               |		КОНЕЦ) КАК НДС_Рег
				               |ИЗ
				               |	РегистрНакопления.CW_ДоходыПоГрузоперевозкам КАК CW_ДоходыПоГрузоперевозкам
				               |ГДЕ
				               |	CW_ДоходыПоГрузоперевозкам.Регистратор = &Регистратор
				               |
				               |СГРУППИРОВАТЬ ПО
				               |	CW_ДоходыПоГрузоперевозкам.Грузоперевозка,
				               |	CW_ДоходыПоГрузоперевозкам.Номенклатура,
				               |	CW_ДоходыПоГрузоперевозкам.СтавкаНДС,
				               |	CW_ДоходыПоГрузоперевозкам.СтатьяЗатрат,
				               |	CW_ДоходыПоГрузоперевозкам.НомерСтроки";
				
				Запрос.УстановитьПараметр("Регистратор", Документ);
				
				ТаблицаРубли = Запрос.Выполнить().Выгрузить();
				
			Иначе
				
				Запрос = Новый Запрос;
				Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
				               |	CW_РасходыПоГрузоперевозкам.НомерСтроки КАК НомерСтроки,
				               |	CW_РасходыПоГрузоперевозкам.Грузоперевозка КАК Грузоперевозка,
				               |	CW_РасходыПоГрузоперевозкам.Номенклатура КАК Номенклатура,
				               |	CW_РасходыПоГрузоперевозкам.СтавкаНДС КАК СтавкаНДС,
				               |	CW_РасходыПоГрузоперевозкам.СтатьяЗатрат КАК СтатьяЗатрат,
				               |	СУММА(CW_РасходыПоГрузоперевозкам.Всего_Валюта) КАК Всего_Валюта,
				               |	СУММА(ВЫБОР
				               |			КОГДА CW_РасходыПоГрузоперевозкам.Регистратор.Корректировка
				               |					И CW_РасходыПоГрузоперевозкам.Регистратор.ВидОперацииКорректировки = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийИсправленияПоступленияРеализации.ИсправлениеОшибки)
				               |				ТОГДА CW_РасходыПоГрузоперевозкам.ПК_Всего
				               |			ИНАЧЕ CW_РасходыПоГрузоперевозкам.Всего
				               |		КОНЕЦ) КАК Всего_Рег,
				               |	СУММА(ВЫБОР
				               |			КОГДА CW_РасходыПоГрузоперевозкам.Регистратор.Корректировка
				               |					И CW_РасходыПоГрузоперевозкам.Регистратор.ВидОперацииКорректировки = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийИсправленияПоступленияРеализации.ИсправлениеОшибки)
				               |				ТОГДА CW_РасходыПоГрузоперевозкам.ПК_Сумма
				               |			ИНАЧЕ CW_РасходыПоГрузоперевозкам.Сумма
				               |		КОНЕЦ) КАК Сумма_Рег,
				               |	СУММА(ВЫБОР
				               |			КОГДА CW_РасходыПоГрузоперевозкам.Регистратор.Корректировка
				               |					И CW_РасходыПоГрузоперевозкам.Регистратор.ВидОперацииКорректировки = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийИсправленияПоступленияРеализации.ИсправлениеОшибки)
				               |				ТОГДА CW_РасходыПоГрузоперевозкам.ПК_НДС
				               |			ИНАЧЕ CW_РасходыПоГрузоперевозкам.НДС
				               |		КОНЕЦ) КАК НДС_Рег
				               |ИЗ
				               |	РегистрНакопления.CW_РасходыПоГрузоперевозкам КАК CW_РасходыПоГрузоперевозкам
				               |ГДЕ
				               |	CW_РасходыПоГрузоперевозкам.Регистратор = &Регистратор
				               |
				               |СГРУППИРОВАТЬ ПО
				               |	CW_РасходыПоГрузоперевозкам.Грузоперевозка,
				               |	CW_РасходыПоГрузоперевозкам.Номенклатура,
				               |	CW_РасходыПоГрузоперевозкам.СтавкаНДС,
				               |	CW_РасходыПоГрузоперевозкам.СтатьяЗатрат,
				               |	CW_РасходыПоГрузоперевозкам.НомерСтроки";
				
				Запрос.УстановитьПараметр("Регистратор", Документ);
				
				ТаблицаРубли = Запрос.Выполнить().Выгрузить();   
				
			КонецЕсли; 
			
			Для каждого Стр Из ТаблицаРубли Цикл
				СтрокаДокумента = ТаблицаПоДокументу[Стр.НомерСтроки-1];
				ЗаполнитьЗначенияСвойств(СтрокаДокумента,Стр,"Сумма_Рег,НДС_Рег,Всего_Рег");
				СтрокаДокумента.Цена_Рег = _сф.БезопасноРазделить(СтрокаДокумента.Сумма_Рег,СтрокаДокумента.Количество);
			КонецЦикла; 
		Иначе
			
			// считаем по курсу	
			Если ЕстьАкт Тогда
				СК = _БЭ.ПолучитьКурсВалюты(Документ.Валюта,ДатаАкта);
			Иначе
				СК = _БЭ.ПолучитьКурсВалюты(Документ.Валюта,Документ.Дата);
			КонецЕсли; 
			
			Валюта = Документ.Валюта;
			
			Для каждого Стр Из ТаблицаПоДокументу Цикл
				Стр.Всего_Рег = ПересчитатьИзВалютыВВалюту(Стр.Всего,Валюта,ВРУ,СК.Курс,1,СК.Кратность,1);
				Стр.Сумма_Рег = ПересчитатьИзВалютыВВалюту(Стр.Сумма,Валюта,ВРУ,СК.Курс,1,СК.Кратность,1);
				Стр.НДС_Рег = Стр.Всего_Рег - Стр.Сумма_Рег;
				Стр.Цена_Рег = _сф.БезопасноРазделить(Стр.Сумма_Рег,Стр.Количество);
			КонецЦикла; 
		КонецЕсли; 
	КонецЕсли; 	
	
	Возврат(ТаблицаПоДокументу);
	
КонецФункции

Процедура ЗаполнитьМассивРегистраторов(мРегистраторы, Документ)
	
	мРегистраторы.Добавить(Документ);
	
	Если Документ.Корректировка Тогда
		
		ЗаполнитьМассивРегистраторов(мРегистраторы, Документ.КорректируемыйДокумент);
	КонецЕсли;
	
КонецПроцедуры


Функция ПолучитьУслугиДокументаКорректировки(Документ) Экспорт 
	// --- 
	
	// только валютные суммы
	ТаблицаПоДокументу = Документ.Услуги.Выгрузить(); 

	Если Документ.ЦенаСНДС Тогда  
		//преобразовываем цену к цене без НДС;
		Для каждого СтрокаТаблицы Из ТаблицаПоДокументу Цикл 
			СтрокаТаблицы.Цена = (СтрокаТаблицы.Всего - СтрокаТаблицы.НДС) / ?(СтрокаТаблицы.Количество = 0,1,СтрокаТаблицы.Количество);
		КонецЦикла; 
	КонецЕсли;
	
	ДобавитьКолонкиБазовойВалюты(ТаблицаПоДокументу);
	// --- 
	
	ВРУ = Константы.ВалютаРегламентированногоУчета.Получить();
	// --- 
	Если (Документ.Валюта = ВРУ) Тогда
		
		Для каждого Стр Из ТаблицаПоДокументу Цикл
			
			Стр.Цена_Рег = Стр.Цена;
			Стр.Сумма_Рег = Стр.Сумма;
			Стр.НДС_Рег = Стр.НДС;
			Стр.Всего_Рег = Стр.Всего;
			
		КонецЦикла; 
		
	КонецЕсли;
	
	Если (Документ.Валюта <> ВРУ) Тогда
		
		ЭтоДоходы = Ложь;
		ЭтоРасходы = Ложь;
		
		Если ТипЗнч(Документ) = Тип("ДокументСсылка.CW_ДоходыПоГрузоперевозке") Тогда
			
			ЭтоДоходы = Истина;
			ЕстьАкт = (Документ.ФормируетсяАкт);
			ДатаАкта = ?(Документ.ФормируетсяАкт, Документ.ДатаАкта, Документ.Дата);
			ПринимаетсяКУчету = Истина;
			
		Иначе
			
			ЭтоРасходы = Истина;
			ЕстьАкт = (Документ.ПредъявленАкт ИЛИ Документ.ПредъявленСФ);
			ДатаАкта = ?(Документ.ПредъявленАкт,Документ.ДатаАкта,Документ.ДатаСФ);
			СтатусДокументаПринимаетсяКУчету = Истина;
			
			//Подсистема.СтатусыДокументов
			Если ПолучитьФункциональнуюОпцию("CW_ИспользуютсяСтатусыДокументов") Тогда
				ДанныеСтатуса 						= РегистрыСведений.CW_СтатусыДокументов.ПолучитьДанныеСтатусаДокумента(Документ);
				СтатусДокументаПринимаетсяКУчету 	= CW_СтатусыДокументовСервер.ПолучитьПризнакПроведенияПоБухгалтерскомуУчету(Документ, ДанныеСтатуса.СтатусДокумента);
			КонецЕсли; 
			//Подсистема.СтатусыДокументов
			
			СтруктураПараметровБухУчета = Новый Структура;
			СтруктураПараметровБухУчета.Вставить("Договор", 				Документ.Договор);
			СтруктураПараметровБухУчета.Вставить("ПриложениеКДоговору",		Документ.ПриложениеКДоговору);
			
			ПараметрыБухгалтерскогоУчета  	= CW_Финансы.ПолучитьПарметрыВеденияБухгалтерскогоУчета(СтруктураПараметровБухУчета, Документ.Дата);
			ПринимаетсяКУчету 				= ПараметрыБухгалтерскогоУчета.БухгалтерскийУчет и СтатусДокументаПринимаетсяКУчету;

		КонецЕсли; 
		
		// --- 
		
		Если (Документ.Проведен И ПринимаетсяКУчету) Тогда

			// снимаем остатки с регистра
			Если ЭтоДоходы Тогда
				
				Запрос = Новый Запрос;
				Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
				               |	CW_ДоходыПоГрузоперевозкам.НомерСтроки,
				               |	CW_ДоходыПоГрузоперевозкам.Грузоперевозка,
				               |	CW_ДоходыПоГрузоперевозкам.Номенклатура,
				               |	CW_ДоходыПоГрузоперевозкам.СтавкаНДС,
				               |	CW_ДоходыПоГрузоперевозкам.СтатьяЗатрат,
				               |	CW_ДоходыПоГрузоперевозкам.ПК_Всего КАК Всего_Рег,
				               |	CW_ДоходыПоГрузоперевозкам.ПК_Сумма КАК Сумма_Рег,
				               |	CW_ДоходыПоГрузоперевозкам.ПК_НДС КАК НДС_Рег
				               |ИЗ
				               |	РегистрНакопления.CW_ДоходыПоГрузоперевозкам КАК CW_ДоходыПоГрузоперевозкам
				               |ГДЕ
				               |	CW_ДоходыПоГрузоперевозкам.Регистратор = &Регистратор";
				Запрос.УстановитьПараметр("Регистратор", Документ);
				ТаблицаРубли = Запрос.Выполнить().Выгрузить();
				
			Иначе
				
				Запрос = Новый Запрос;
				Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
				               |	CW_РасходыПоГрузоперевозкам.НомерСтроки,
				               |	CW_РасходыПоГрузоперевозкам.Грузоперевозка,
				               |	CW_РасходыПоГрузоперевозкам.Номенклатура,
				               |	CW_РасходыПоГрузоперевозкам.СтавкаНДС,
				               |	CW_РасходыПоГрузоперевозкам.СтатьяЗатрат,
				               |	CW_РасходыПоГрузоперевозкам.Всего_Валюта КАК Всего_Валюта,
				               |	CW_РасходыПоГрузоперевозкам.Всего КАК Всего_Рег,
				               |	CW_РасходыПоГрузоперевозкам.Сумма КАК Сумма_Рег,
				               |	CW_РасходыПоГрузоперевозкам.НДС КАК НДС_Рег
				               |ИЗ
				               |	РегистрНакопления.CW_РасходыПоГрузоперевозкам КАК CW_РасходыПоГрузоперевозкам
				               |ГДЕ
				               |	CW_РасходыПоГрузоперевозкам.Регистратор = &Регистратор";
				Запрос.УстановитьПараметр("Регистратор", Документ);
				ТаблицаРубли = Запрос.Выполнить().Выгрузить();
				
			КонецЕсли; 
			// --- 
			
			Для каждого Стр Из ТаблицаРубли Цикл
				
				СтрокаДокумента = ТаблицаПоДокументу[Стр.НомерСтроки-1];
				// --- 
				ЗаполнитьЗначенияСвойств(СтрокаДокумента,Стр,"Сумма_Рег,НДС_Рег,Всего_Рег");
				СтрокаДокумента.Цена_Рег = _сф.БезопасноРазделить(СтрокаДокумента.Сумма_Рег,СтрокаДокумента.Количество);
				
			КонецЦикла; 
			
			
		КонецЕсли;
		
		
	КонецЕсли;
	
	Возврат(ТаблицаПоДокументу);
	
	// --- 
КонецФункции
  
Процедура ДобавитьКолонкиБазовойВалюты(Таблица) Экспорт 
	// --- 
	
	_сф.т_ДобавитьКолонку(Таблица,"Цена_Рег",,0);
	_сф.т_ДобавитьКолонку(Таблица,"Сумма_Рег",,0);
	_сф.т_ДобавитьКолонку(Таблица,"НДС_Рег",,0);
	_сф.т_ДобавитьКолонку(Таблица,"Всего_Рег",,0);
	
	// --- 
КонецПроцедуры

Функция ТаблицаАвансов(Параметры,ТаблицаДокумента,ТаблицаЗачета,ТаблицаЗачетаОЗ=Неопределено) Экспорт 
	// --- 
	
	Дата 		= Параметры.Дата;
	Договор 	= Параметры.Договор;
	Организация = Договор.Организация;
	Контрагент 	= Договор.Владелец;
	Валюта 		= Договор.ВалютаДоговора;
	Акт 		= Параметры.Акт;
	
	ВестиУчетПоПодразделениям 	= Ложь;
	ПодразделениеОрганизации 	= Неопределено;
	
	//Для версии КОРП
	Если Параметры.Свойство("ВестиУчетПоПодразделениям") Тогда
		ВестиУчетПоПодразделениям 	= Параметры.ВестиУчетПоПодразделениям;
		ПодразделениеОрганизации 	= Параметры.ПодразделениеОрганизации;
	КонецЕсли;
	//Для версии КОРП
	
	// --- 
	ЭтоПокупатель = ДоговорПокупателя(Договор); 
	ЭтоПоставщик = (НЕ ЭтоПокупатель);
	// --- 
	ОЗ = Параметры.ОЗ;
	
	РаздельныйУчетЗаполженности = Параметры.РаздельныйУчетЗаполженности;
	
	// ---------------------------------------------------------------------------- 
		
	ВРУ = Константы.ВалютаРегламентированногоУчета.Получить();
	ТС = _сф.т_СкопироватьСвернуть(ТаблицаДокумента,"СчетЗадолженности");
	ТС.Колонки.Добавить("СчетАванса");
	Для каждого Стр Из ТС Цикл
		
		Стр.СчетАванса = СчетАванса(Стр.СчетЗадолженности);
		
	КонецЦикла; 
	ССА = _сф.со_Создать("СчетАванса","СчетЗадолженности",ТС);
	// --- 
	ТС.Свернуть("СчетАванса");
	// --- 
	Запрос = Новый Запрос;
	// --- 
	Если (Валюта = ВРУ) Тогда
		
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ХозрасчетныйОстатки.Субконто3 КАК ДокументАванса,
		|	ХозрасчетныйОстатки.СуммаОстаток * &Множитель КАК Аванс,
		|	ХозрасчетныйОстатки.Счет КАК СчетАванса,
		|	ХозрасчетныйОстатки.Счет КАК СчетЗадолженности,
		|	0 КАК Зачтено,
		|	ЛОЖЬ КАК ПоСчету,
		|	0 КАК Задолженность
		|ИЗ
		|	РегистрБухгалтерии.Хозрасчетный.Остатки(
		|			&Дата,
		|			Счет В (&Счета),
		|			,
		|			ВЫБОР
		|				КОГДА &ВестиУчетПоПодразделениям
		|					ТОГДА Подразделение = &ПодразделениеОрганизации
		|				ИНАЧЕ ИСТИНА
		|			КОНЕЦ) КАК ХозрасчетныйОстатки
		|ГДЕ
		|	ХозрасчетныйОстатки.Организация = &Организация
		|	И ХозрасчетныйОстатки.Субконто2 = &ДоговорКонтрагента
		|	И ХозрасчетныйОстатки.Субконто1 = &Контрагент
		|
		|УПОРЯДОЧИТЬ ПО
		|	ДокументАванса";
		
	Иначе	
		
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ХозрасчетныйОстатки.Субконто3 КАК ДокументАванса,
		|	ХозрасчетныйОстатки.ВалютнаяСуммаОстаток * &Множитель КАК Аванс,
		|	ХозрасчетныйОстатки.Счет КАК СчетАванса,
		|	ХозрасчетныйОстатки.Счет КАК СчетЗадолженности,
		|	0 КАК Зачтено,
		|	ЛОЖЬ КАК ПоСчету,
		|	0 КАК Задолженность
		|ИЗ
		|	РегистрБухгалтерии.Хозрасчетный.Остатки(
		|			&Дата,
		|			Счет В (&Счета),
		|			,
		|			ВЫБОР
		|				КОГДА &ВестиУчетПоПодразделениям
		|					ТОГДА Подразделение = &ПодразделениеОрганизации
		|				ИНАЧЕ ИСТИНА
		|			КОНЕЦ) КАК ХозрасчетныйОстатки
		|ГДЕ
		|	ХозрасчетныйОстатки.Организация = &Организация
		|	И ХозрасчетныйОстатки.Субконто2 = &ДоговорКонтрагента
		|	И ХозрасчетныйОстатки.Субконто1 = &Контрагент
		|	И ХозрасчетныйОстатки.Валюта = &Валюта
		|
		|УПОРЯДОЧИТЬ ПО
		|	ДокументАванса";
		
	КонецЕсли;
	// --- 
	Если (ЭтоПоставщик) Тогда
		Множитель = 1;
	ИначеЕсли (ЭтоПокупатель) Тогда 
		Множитель = -1;
	КонецЕсли; 
	  
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("Договор", 			Параметры.Договор);
	СтруктураПараметров.Вставить("ПриложениеКДоговору",	Параметры.ПриложениеКДоговору);
	
	ДоговорКонтрагента = CW_Финансы.ПолучитьУчетныйДоговор(СтруктураПараметров);
	
	// --- 
	Запрос.УстановитьПараметр("Множитель"			, Множитель);
	Запрос.УстановитьПараметр("Счета"				, ТС.ВыгрузитьКолонку("СчетАванса"));
	Запрос.УстановитьПараметр("Дата"				, Дата); 
	Запрос.УстановитьПараметр("Организация"			, Организация); 
	Запрос.УстановитьПараметр("Контрагент"			, Контрагент);
	Запрос.УстановитьПараметр("ДоговорКонтрагента"	, ДоговорКонтрагента);
	Запрос.УстановитьПараметр("Валюта"				, Валюта); 
	
	Запрос.УстановитьПараметр("ВестиУчетПоПодразделениям"	, ВестиУчетПоПодразделениям); 
	Запрос.УстановитьПараметр("ПодразделениеОрганизации"	, ПодразделениеОрганизации);
	// --- 
	
	ТЗ = Запрос.Выполнить().Выгрузить();
	МассивУдаляемых = Новый Массив;
	Для каждого Стр Из ТЗ Цикл
		Если (Стр.Аванс < 0) Тогда
			МассивУдаляемых.Добавить(Стр);
			Продолжить;
		КонецЕсли; 
		Если (Стр.ДокументАванса = Неопределено) Тогда
			МассивУдаляемых.Добавить(Стр);
		КонецЕсли; 
	КонецЦикла; 
	_сф.к_УдалитьЭлементыПоМассиву(ТЗ,МассивУдаляемых);
	_сф.т_ДобавитьКолонку(ТЗ,"ДокументОплаты");
	_сф.т_ДобавитьКолонку(ТЗ,"Счет");
	_сф.т_ДобавитьКолонку(ТЗ,"ПризнакОплатыСчетовДокумента");
	_сф.т_ДобавитьКолонку(ТЗ,"ПредставлениеДокументаАванса");
	Для каждого Стр Из ТЗ Цикл
		Стр.СчетЗадолженности = ССА.Получить(Стр.СчетАванса);
		Стр.ПредставлениеДокументаАванса = "";
	КонецЦикла; 
	// --- 
	Если ОЗ и Не РаздельныйУчетЗаполженности Тогда
		
		// по всем актируемым счетам собираем остатки авансов
		ТаблицаЗадолженности = ТаблицаДокумента.Скопировать(,"Счет,СчетЗадолженности,Всего");
		ТаблицаЗадолженности.Свернуть("Счет,СчетЗадолженности","Всего");
		// формируем список актируемых счетов для запроса
		ТаблицаАктируемыхСчетов = ТаблицаЗадолженности.Скопировать(,"Счет");
		ТаблицаАктируемыхСчетов.Свернуть("Счет");
		МассивУдаления = Новый Массив;
		Для каждого Стр Из ТаблицаАктируемыхСчетов Цикл
			Если (Стр.Счет.Пустая()) Тогда
				МассивУдаления.Добавить(Стр);
			КонецЕсли; 
		КонецЦикла; 
		_сф.к_УдалитьЭлементыПоМассиву(ТаблицаАктируемыхСчетов,МассивУдаления);
		АктируемыеСчета = ТаблицаАктируемыхСчетов.ВыгрузитьКолонку("Счет");
		// --- 
		// собираем остатки авансов по актируемым счетам
		Если (ЭтоПоставщик) Тогда
			
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	CW_ОплатаВходящихДокументов.СчетЗадолженности КАК СчетЗадолженности,
			|	CW_ОплатаВходящихДокументов.ДокументОплаты КАК ДокументОплаты,
			|	CW_ОплатаВходящихДокументов.Документ КАК Счет,
			|	CW_ОплатаВходящихДокументов.ДокументБУ КАК Акт,
			|	CW_ОплатаВходящихДокументов.Всего КАК Всего
			|ИЗ
			|	РегистрСведений.CW_ОплатаВходящихДокументов КАК CW_ОплатаВходящихДокументов
			|ГДЕ
			|	CW_ОплатаВходящихДокументов.Документ В(&АктируемыеСчета)
			|	И CW_ОплатаВходящихДокументов.Регистратор <> &Регистратор
			|	И CW_ОплатаВходящихДокументов.Период <= &Период
			|	И ВЫБОР
			|			КОГДА &ВестиУчетПоПодразделениям
			|				ТОГДА CW_ОплатаВходящихДокументов.Документ.ПодразделениеОрганизации = &ПодразделениеОрганизации
			|			ИНАЧЕ ИСТИНА
			|		КОНЕЦ";
			Запрос.УстановитьПараметр("АктируемыеСчета", АктируемыеСчета);
			Запрос.УстановитьПараметр("Регистратор", Акт); 
			Если (ТипЗнч(Дата) = Тип("Граница")) Тогда
				Если (ТипЗнч(Дата.Значение) = Тип("МоментВремени")) Тогда
					Запрос.УстановитьПараметр("Период", Дата.Значение.Дата);
				Иначе
					Запрос.УстановитьПараметр("Период", Дата.Значение);
				КонецЕсли; 
			Иначе
				Запрос.УстановитьПараметр("Период",?(ТипЗнч(Дата)=Тип("Дата"),Дата, Дата.Дата)); 	
			КонецЕсли; 
			
			Запрос.УстановитьПараметр("ВестиУчетПоПодразделениям"	, ВестиУчетПоПодразделениям); 
			Запрос.УстановитьПараметр("ПодразделениеОрганизации"	, ПодразделениеОрганизации);
			
		ИначеЕсли (ЭтоПокупатель) Тогда
			
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	CW_ОплатаИсходящихДокументов.СчетЗадолженности КАК СчетЗадолженности,
			|	CW_ОплатаИсходящихДокументов.ДокументОплаты КАК ДокументОплаты,
			|	CW_ОплатаИсходящихДокументов.Документ КАК Счет,
			|	CW_ОплатаИсходящихДокументов.ДокументБУ КАК Акт,
			|	CW_ОплатаИсходящихДокументов.Всего КАК Всего
			|ИЗ
			|	РегистрСведений.CW_ОплатаИсходящихДокументов КАК CW_ОплатаИсходящихДокументов
			|ГДЕ
			|	CW_ОплатаИсходящихДокументов.Документ В(&АктируемыеСчета)
			|	И CW_ОплатаИсходящихДокументов.Регистратор <> &Регистратор
			|	И CW_ОплатаИсходящихДокументов.Период <= &Период
			|	И ВЫБОР
			|			КОГДА &ВестиУчетПоПодразделениям
			|				ТОГДА CW_ОплатаИсходящихДокументов.Документ.ПодразделениеОрганизации = &ПодразделениеОрганизации
			|			ИНАЧЕ ИСТИНА
			|		КОНЕЦ";
			Запрос.УстановитьПараметр("АктируемыеСчета", АктируемыеСчета);
			Запрос.УстановитьПараметр("Регистратор", Акт); 
			Если (ТипЗнч(Дата) = Тип("Граница")) Тогда
				Если (ТипЗнч(Дата.Значение) = Тип("МоментВремени")) Тогда
					Запрос.УстановитьПараметр("Период", Дата.Значение.Дата);
				Иначе
					Запрос.УстановитьПараметр("Период", Дата.Значение);
				КонецЕсли; 
			Иначе
				Запрос.УстановитьПараметр("Период",?(ТипЗнч(Дата)=Тип("Дата"),Дата, Дата.Дата)); 	
			КонецЕсли; 
			
		КонецЕсли; 
		
		Запрос.УстановитьПараметр("ВестиУчетПоПодразделениям"	, ВестиУчетПоПодразделениям); 
		Запрос.УстановитьПараметр("ПодразделениеОрганизации"	, ПодразделениеОрганизации);
		
		
		// --- 
		ТаблицаАвансовПоАктируемымСчетам = Запрос.Выполнить().Выгрузить();
		ТаблицаАвансовПоАктируемымСчетам.Колонки.Добавить("ДокументАванса");
		// учет зачета оперативного аванса
		Если (ТаблицаЗачетаОЗ <> Неопределено) Тогда
			
			Для каждого Стр Из ТаблицаЗачетаОЗ Цикл
				
				Нстр = ТаблицаАвансовПоАктируемымСчетам.Добавить();
				Нстр.СчетЗадолженности = Стр.СчетЗадолженности;
				Нстр.ДокументОплаты = Стр.ДокументОплаты;
				Нстр.Счет = Акт;
				Нстр.Акт = Неопределено;
				Нстр.Всего = Стр.СуммаЗачета;
				
			КонецЦикла; 
			
		КонецЕсли; 
		// --- 
		МассивУдаляемых = Новый Массив;
		Для каждого Стр Из ТаблицаАвансовПоАктируемымСчетам Цикл
			
			Если (ТипЗнч(Стр.ДокументОплаты) <> Тип("ДокументСсылка.CW_Оплата")) Тогда
				МассивУдаляемых.Добавить(Стр);
				Продолжить;
			Иначе
				Стр.ДокументАванса = Стр.ДокументОплаты.Основание;
			КонецЕсли; 
			// --- 
			Если (ЗначениеЗаполнено(Стр.Акт)) Тогда
				Стр.Всего = - Стр.Всего;
			КонецЕсли; 
			
		КонецЦикла; 
		_сф.к_УдалитьЭлементыПоМассиву(ТаблицаАвансовПоАктируемымСчетам,МассивУдаляемых);
		// --- 
		ТаблицаАвансовПоАктируемымСчетам.Свернуть("СчетЗадолженности,ДокументАванса,ДокументОплаты,Счет","Всего");
		МассивУдаляемых = Новый Массив;
		Для каждого Стр Из ТаблицаАвансовПоАктируемымСчетам Цикл
			Если (Стр.Всего <= 0) Тогда
				МассивУдаляемых.Добавить(Стр);
			КонецЕсли; 
		КонецЦикла;
		_сф.к_УдалитьЭлементыПоМассиву(ТаблицаАвансовПоАктируемымСчетам,МассивУдаляемых);
		
		// теперь бежим по найденным по БУ платежкам и ищем соответствия по авансам в таблице авансов по счетам и таблице задолженности
		ДопТЗ = ТЗ.СкопироватьКолонки();
		Для каждого Стр Из ТЗ Цикл
			
			Отбор = Новый Структура;
			Отбор.Вставить("СчетЗадолженности", Стр.СчетЗадолженности);
			Отбор.Вставить("ДокументАванса", Стр.ДокументАванса);
			// --- 
			СтрокиАвансовПоАктируемымСчетам = ТаблицаАвансовПоАктируемымСчетам.Скопировать(Отбор);
			СтрокиАвансовПоАктируемымСчетам.Колонки.Добавить("Задолженность");
			СтрокиАвансовПоАктируемымСчетам.ЗаполнитьЗначения(0,"Задолженность");
			Если (СтрокиАвансовПоАктируемымСчетам.Количество() <> 0) Тогда
				
				// пробуем подобрать задолженность по таблице задолженности
				Отбор = Новый Структура;
				Отбор.Вставить("СчетЗадолженности", Стр.СчетЗадолженности);
				Отбор.Вставить("Счет", Неопределено);
				// --- 
				Для каждого СтрокаАвансаПоСчету Из СтрокиАвансовПоАктируемымСчетам Цикл
					
					Отбор.Счет = СтрокаАвансаПоСчету.Счет;
					СтрокаЗадолженности = _сф.к_НайтиСтроку(ТаблицаЗадолженности,Отбор);
					Если (СтрокаЗадолженности <> Неопределено) Тогда
						СтрокаАвансаПоСчету.Задолженность = СтрокаЗадолженности.Всего;
					КонецЕсли; 
					
				КонецЦикла; 
				
				// добавляем в таблицу строк данные по авансам по счетам
				ДокументОплаты = Неопределено;
				Для каждого СтрокаАвансаПоСчету Из СтрокиАвансовПоАктируемымСчетам Цикл
					
					Нстр = ДопТЗ.Добавить();
					ЗаполнитьЗначенияСвойств(Нстр,Стр);
					Нстр.ДокументОплаты = СтрокаАвансаПоСчету.ДокументОплаты;
					ДокументОплаты = Нстр.ДокументОплаты;
					Нстр.ПризнакОплатыСчетовДокумента = Истина;
					Нстр.ПоСчету = Истина;
					Нстр.Счет = СтрокаАвансаПоСчету.Счет;
					Нстр.Задолженность = СтрокаАвансаПоСчету.Задолженность;
					Нстр.Аванс = СтрокаАвансаПоСчету.Всего;
					
				КонецЦикла; 
				
				// проанализируем, отличается ли сумма авансов по найденным  счетам от суммы аванса по платежке
				СуммаАвансовПоСчетам = СтрокиАвансовПоАктируемымСчетам.Итог("Всего");
				СуммаАвансаПоПлатежке = Стр.Аванс;
				
				Если (СуммаАвансовПоСчетам <> СуммаАвансаПоПлатежке) Тогда
					
					// добавим строчку остатка без привязки к счетам
					Нстр = ДопТЗ.Добавить();
					ЗаполнитьЗначенияСвойств(Нстр,Стр);
					Нстр.ДокументОплаты = ДокументОплаты;
					Нстр.ПризнакОплатыСчетовДокумента = Истина;
					Нстр.ПоСчету = Ложь;
					Нстр.Счет = Неопределено;
					Нстр.Задолженность = 0;
					Нстр.Аванс = СуммаАвансаПоПлатежке - СуммаАвансовПоСчетам;
					
				КонецЕсли; 
				
			Иначе
				
				Нстр = ДопТЗ.Добавить();
				ЗаполнитьЗначенияСвойств(Нстр,Стр);
				
			КонецЕсли; 
			
		КонецЦикла; 
		
	КонецЕсли; 
	// --- 
	// восстанавливаем данные по зачету
	Если ОЗ и НЕ РаздельныйУчетЗаполженности Тогда
		
		ИтоговаяТаблица = ДопТЗ;
		Для каждого Стр Из ИтоговаяТаблица Цикл
			
			Если (Стр.Счет = Неопределено) Тогда
				Если (ТипЗнч(Акт)=Тип("ДокументСсылка.CW_РасходыПоГрузоперевозке")) Тогда
					Стр.Счет = Документы.CW_РасходыПоГрузоперевозке.ПустаяСсылка();
				Иначе
					Стр.Счет = Документы.CW_ДоходыПоГрузоперевозке.ПустаяСсылка();
				КонецЕсли; 
			КонецЕсли; 
			Отбор = _сф.ст_Создать("ДокументАванса,СчетЗадолженности,Счет",Стр);
			СтрокиСтарогоЗачета = ТаблицаЗачета.Скопировать(Отбор);
			Если (_сф.Количество(СтрокиСтарогоЗачета)<>0) Тогда
				Стр.Зачтено = _сф.Итог(СтрокиСтарогоЗачета,"СуммаЗачета");
			КонецЕсли; 
			
		КонецЦикла; 
		
	Иначе
		
		ИтоговаяТаблица = ТЗ;
		Для каждого Стр Из ИтоговаяТаблица Цикл
			
			Отбор = _сф.ст_Создать("ДокументАванса,СчетЗадолженности",Стр);
			СтрокиСтарогоЗачета = ТаблицаЗачета.Скопировать(Отбор);
			Если (_сф.Количество(СтрокиСтарогоЗачета)<>0) Тогда
				Стр.Зачтено = _сф.Итог(СтрокиСтарогоЗачета,"СуммаЗачета");
			КонецЕсли; 
			
		КонецЦикла; 
		
	КонецЕсли; 
	
	Если РаздельныйУчетЗаполженности Тогда
		ИтоговаяТаблица.ЗаполнитьЗначения(Истина,"ПризнакОплатыСчетовДокумента"); 
	КонецЕсли;
	
	Возврат(ИтоговаяТаблица);
	
КонецФункции

Функция ТаблицаАвансовДляОЗ(Параметры,ТаблицаДокумента,ТаблицаЗачета) Экспорт 
	
	ВалютаРегламентированногоУчетаРубль = ПолучитьФункциональнуюОпцию("CW_ВалютаРегламентированногоУчетаРубль");
	
	Дата			= Параметры.Дата;
	Договор			= Параметры.Договор;
	
	//Подсистема.УчетПриложенийДоговоров
	ПриложениеКДоговору = Параметры.ПриложениеКДоговору;
	//Подсистема.УчетПриложенийДоговоров
	
	ПереплатаКакАванс   = Параметры.ПереплатаКакАванс;
	
	Организация		= Договор.Организация;
	Контрагент		= Договор.Владелец; 
	
	Если ЗначениеЗаполнено(ПриложениеКДоговору) Тогда
		Валюта = ПриложениеКДоговору.ВалютаДоговора;
	Иначе
		Валюта = Договор.ВалютаДоговора;
	КонецЕсли;	
	
	ВестиУчетПоПодразделениям 	= ложь;
	ПодразделениеОрганизации 	= Неопределено;
	
	//Для версии КОРП
	Если Параметры.Свойство("ВестиУчетПоПодразделениям") Тогда
		ВестиУчетПоПодразделениям 	= Параметры.ВестиУчетПоПодразделениям;
		ПодразделениеОрганизации 	= Параметры.ПодразделениеОрганизации;
	КонецЕсли;
	//Для версии КОРП
	
	// --- 
	ЭтоПокупатель = ДоговорПокупателя(Договор); 
	ЭтоПоставщик = (НЕ ЭтоПокупатель);
	// --- 
	ОЗ = Параметры.ОЗ;
	
	Если (НЕ ОЗ) Тогда
		
		Возврат(Неопределено);
		
	КонецЕсли; 
	
	// --- 
	
	СчетаУчета = ТаблицаДокумента.Скопировать(,"СчетЗадолженности");
	СчетаУчета.Свернуть("СчетЗадолженности");
	
	Если (ЭтоПоставщик) Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		               |	-CW_ОперативнаяКредиторскаяЗадолженностьОстатки.Всего_ВалютаОстаток КАК Аванс,
		               |	CW_ОперативнаяКредиторскаяЗадолженностьОстатки.СчетУчета КАК СчетЗадолженности,
		               |	CW_ОперативнаяКредиторскаяЗадолженностьОстатки.Валюта КАК Валюта,
		               |	CW_ОперативнаяКредиторскаяЗадолженностьОстатки.Счет КАК ДокументОплаты,
		               |	CW_ОперативнаяКредиторскаяЗадолженностьОстатки.Счет.Основание КАК ДокументАванса
		               |ПОМЕСТИТЬ тмп
		               |ИЗ
		               |	РегистрНакопления.CW_ОперативнаяКредиторскаяЗадолженность.Остатки(
		               |			&Период,
		               |			СчетУчета В (&Счета)
		               |				И Контрагент = &Контрагент
		               |				И Договор = &Договор
					   //Подсистема.УчетПриложенийДоговоров
		               |				И ПриложениеКДоговору = &ПриложениеКДоговору
					   //Подсистема.УчетПриложенийДоговоров
		               |				И Валюта = &Валюта
		               |				И Организация = &Организация
		               |				И ВЫБОР
		               |					КОГДА &ВестиУчетПоПодразделениям
		               |						ТОГДА ВЫБОР
		               |								КОГДА Счет ССЫЛКА Документ.CW_РасходыПоГрузоперевозке
		               |										ИЛИ Счет ССЫЛКА Документ.CW_Оплата
		               |										ИЛИ Счет ССЫЛКА Документ.CW_РасходыПоПриобретениям
		               |									ТОГДА Счет.ПодразделениеОрганизации = &ПодразделениеОрганизации
		               |								ИНАЧЕ ИСТИНА
		               |							КОНЕЦ
		               |					ИНАЧЕ ИСТИНА
		               |				КОНЕЦ
		               |				И ВЫБОР
		               |					КОГДА &ПереплатаКакАванс = ЛОЖЬ
		               |						ТОГДА Счет ССЫЛКА Документ.CW_Оплата
		               |								ИЛИ Счет ССЫЛКА Документ.CW_ДвижениеДенежныхСредств
		               |					ИНАЧЕ ИСТИНА
		               |				КОНЕЦ) КАК CW_ОперативнаяКредиторскаяЗадолженностьОстатки
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ
		               |	тмп.Аванс КАК Аванс,
		               |	тмп.СчетЗадолженности КАК СчетЗадолженности,
		               |	тмп.Валюта КАК Валюта,
		               |	тмп.ДокументОплаты КАК ДокументОплаты,
		               |	тмп.ДокументАванса КАК ДокументАванса,
		               |	тмп.ДокументОплаты.Дата КАК Дата
		               |ИЗ
		               |	тмп КАК тмп
		               |ГДЕ
		               |	тмп.Аванс > 0";
					   
		Запрос.УстановитьПараметр("Счета", 			СчетаУчета.ВыгрузитьКолонку("СчетЗадолженности"));
		Запрос.УстановитьПараметр("Период", 		Дата); 
		Запрос.УстановитьПараметр("Организация", 	Организация); 
		Запрос.УстановитьПараметр("Контрагент", 	Контрагент);
		Запрос.УстановитьПараметр("Договор", 		Договор);
		
		//Подсистема.УчетПриложенийДоговоров
		Запрос.УстановитьПараметр("ПриложениеКДоговору", ПриложениеКДоговору);
		//Подсистема.УчетПриложенийДоговоров
		
		Запрос.УстановитьПараметр("ПереплатаКакАванс", 	 ПереплатаКакАванс);
	
		Запрос.УстановитьПараметр("Валюта", Валюта); 
		
		Запрос.УстановитьПараметр("ВестиУчетПоПодразделениям"		, ВестиУчетПоПодразделениям);
		Запрос.УстановитьПараметр("ПодразделениеОрганизации"		, ПодразделениеОрганизации); 
		// --- 
		ТЗ=Запрос.Выполнить().Выгрузить();
		_сф.т_ДобавитьКолонку(ТЗ,"СчетАванса");
		_сф.т_ДобавитьКолонку(ТЗ,"Зачтено");
		_сф.т_ДобавитьКолонку(ТЗ,"ПризнакОплатыСчетовДокумента");
		_сф.т_ДобавитьКолонку(ТЗ,"ПредставлениеДокументаАванса");
		МассивУдаления = Новый Массив;
		Для каждого Стр Из ТЗ Цикл
				
			Стр.ПризнакОплатыСчетовДокумента = Ложь;
			Стр.ПредставлениеДокументаАванса = "";
			Стр.СчетАванса = СчетАванса(Стр.СчетЗадолженности);
			Стр.Зачтено = 0;
			
		КонецЦикла; 
		_сф.к_УдалитьЭлементыПоМассиву(ТЗ, МассивУдаления);
		ТЗ.Сортировать("Дата Возр");
		
	ИначеЕсли (ЭтоПокупатель) Тогда 
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		               |	-CW_ОперативнаяДебиторскаяЗадолженностьОстатки.Всего_ВалютаОстаток КАК Аванс,
		               |	CW_ОперативнаяДебиторскаяЗадолженностьОстатки.СчетУчета КАК СчетЗадолженности,
		               |	CW_ОперативнаяДебиторскаяЗадолженностьОстатки.Валюта КАК Валюта,
		               |	CW_ОперативнаяДебиторскаяЗадолженностьОстатки.Счет КАК ДокументОплаты,
		               |	CW_ОперативнаяДебиторскаяЗадолженностьОстатки.Счет.Основание КАК ДокументАванса
		               |ПОМЕСТИТЬ тмп
		               |ИЗ
		               |	РегистрНакопления.CW_ОперативнаяДебиторскаяЗадолженность.Остатки(
		               |			&Период,
		               |			СчетУчета В (&Счета)
		               |				И Контрагент = &Контрагент
					   |				И Договор = &Договор
					   //Подсистема.УчетПриложенийДоговоров
					   |				И ПриложениеКДоговору = &ПриложениеКДоговору
					   //Подсистема.УчетПриложенийДоговоров
					   |				И Валюта = &Валюта
					   |				И Организация = &Организация
					   |				И ВЫБОР
					   |					КОГДА &ВестиУчетПоПодразделениям
					   |						ТОГДА ВЫБОР
					   |								КОГДА Счет ССЫЛКА Документ.CW_ДоходыПоГрузоперевозке
					   |										ИЛИ Счет ССЫЛКА Документ.CW_Оплата
					   |									ТОГДА Счет.ПодразделениеОрганизации = &ПодразделениеОрганизации
		               |								ИНАЧЕ ИСТИНА
		               |							КОНЕЦ
		               |					ИНАЧЕ ИСТИНА
		               |				КОНЕЦ
		               |				И ВЫБОР
		               |					КОГДА &ПереплатаКакАванс = ЛОЖЬ
		               |						ТОГДА Счет ССЫЛКА Документ.CW_Оплата 
					   |								ИЛИ Счет ССЫЛКА Документ.CW_ДвижениеДенежныхСредств
		               |					ИНАЧЕ ИСТИНА
		               |				КОНЕЦ) КАК CW_ОперативнаяДебиторскаяЗадолженностьОстатки
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ
		               |	тмп.Аванс КАК Аванс,
		               |	тмп.СчетЗадолженности КАК СчетЗадолженности,
		               |	тмп.Валюта КАК Валюта,
		               |	тмп.ДокументОплаты КАК ДокументОплаты,
		               |	тмп.ДокументАванса КАК ДокументАванса,
		               |	тмп.ДокументОплаты.Дата КАК Дата
		               |ИЗ
		               |	тмп КАК тмп
		               |ГДЕ
		               |	тмп.Аванс > 0";
		
		Запрос.УстановитьПараметр("Счета", СчетаУчета.ВыгрузитьКолонку("СчетЗадолженности"));
		Запрос.УстановитьПараметр("Период", Дата); 
		Запрос.УстановитьПараметр("Организация", Организация); 
		Запрос.УстановитьПараметр("Контрагент", Контрагент);
		Запрос.УстановитьПараметр("Договор", Договор);
		
		//Подсистема.УчетПриложенийДоговоров
		Запрос.УстановитьПараметр("ПриложениеКДоговору", ПриложениеКДоговору);
		//Подсистема.УчетПриложенийДоговоров
		
		Запрос.УстановитьПараметр("ПереплатаКакАванс", 	ПереплатаКакАванс);
		
		Запрос.УстановитьПараметр("Валюта", Валюта); 
		
		Запрос.УстановитьПараметр("ВестиУчетПоПодразделениям"	, ВестиУчетПоПодразделениям);
		Запрос.УстановитьПараметр("ПодразделениеОрганизации"	, ПодразделениеОрганизации); 
		
		ТЗ=Запрос.Выполнить().Выгрузить();
		_сф.т_ДобавитьКолонку(ТЗ,"СчетАванса");
		_сф.т_ДобавитьКолонку(ТЗ,"Зачтено");
		_сф.т_ДобавитьКолонку(ТЗ,"ПризнакОплатыСчетовДокумента");
		_сф.т_ДобавитьКолонку(ТЗ,"ПредставлениеДокументаАванса");
		МассивУдаления = Новый Массив;
		Для каждого Стр Из ТЗ Цикл
					
			Стр.ПризнакОплатыСчетовДокумента = Ложь;
			Стр.ПредставлениеДокументаАванса = "";
			Стр.СчетАванса = СчетАванса(Стр.СчетЗадолженности);
			Стр.Зачтено = 0;
			
		КонецЦикла; 
		_сф.к_УдалитьЭлементыПоМассиву(ТЗ, МассивУдаления); 
		ТЗ.Сортировать("Дата Возр");
		
	КонецЕсли; 
	
	// --- 
	Для каждого Стр Из ТЗ Цикл
		
		Отбор = _сф.ст_Создать("ДокументОплаты,СчетЗадолженности",Стр);
		СтрокиСтарогоЗачета = ТаблицаЗачета.Скопировать(Отбор);
		Если (_сф.Количество(СтрокиСтарогоЗачета)<>0) Тогда
			Стр.Зачтено = _сф.Итог(СтрокиСтарогоЗачета,"СуммаЗачета");
		КонецЕсли; 
		
	КонецЦикла; 
	// --- 
	Возврат(ТЗ);
	
КонецФункции

Функция СтруктураСчетовРасчетов_Клиенты(Дата,Организация,ДС=Неопределено) Экспорт 
	// --- 
	
	Счета = ПланыСчетов.Хозрасчетный;
	// --- 
	х62_1 = Счета.РасчетыСПокупателями;
	х62_21 = Счета.РасчетыСПокупателямиВал;
	х62_31 = Счета.РасчетыСПокупателямиУЕ;
	// --- 
	Если (ДС=Неопределено) Тогда
		СчетРасчетовПоВозмещаемым_Рубли 	= CW_Настройки.ПараметрУчетнойПолитики(Дата,Организация,"СчетРасчетов_Клиенты_Рубли");
		СчетРасчетовПоВозмещаемым_Валюта 	= CW_Настройки.ПараметрУчетнойПолитики(Дата,Организация,"СчетРасчетов_Клиенты_Валюта");
		СчетРасчетовПоВозмещаемым_УЕ 		= CW_Настройки.ПараметрУчетнойПолитики(Дата,Организация,"СчетРасчетов_Клиенты_УЕ");
	Иначе
		СчетРасчетовПоВозмещаемым_Рубли = ДС.УП.СчетРасчетов_Клиенты_Рубли;
		СчетРасчетовПоВозмещаемым_Валюта = ДС.УП.СчетРасчетов_Клиенты_Валюта;
		СчетРасчетовПоВозмещаемым_УЕ = ДС.УП.СчетРасчетов_Клиенты_УЕ;
	КонецЕсли; 
	
	СС = Новый Структура;
	// --- 
	СС.Вставить("Собственные_Рубли",х62_1);
	СС.Вставить("Собственные_Валюта",х62_21);
	СС.Вставить("Собственные_УЕ",х62_31);
	// --- 
	СС.Вставить("Возмещаемые_Рубли",СчетРасчетовПоВозмещаемым_Рубли);
	СС.Вставить("Возмещаемые_Валюта",СчетРасчетовПоВозмещаемым_Валюта);
	СС.Вставить("Возмещаемые_УЕ",СчетРасчетовПоВозмещаемым_УЕ);
	// --- 
	Возврат(СС);
	
	// --- 
