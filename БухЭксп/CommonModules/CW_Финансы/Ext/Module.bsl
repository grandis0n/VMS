Функция СчетАванса(СчетЗадолженности) Экспорт 
	// --- 
	
	Счета = ПланыСчетов.Хозрасчетный;
	
	Если (СчетЗадолженности = Счета.РасчетыСПокупателями) Тогда
		
		Возврат(Счета.РасчетыПоАвансамПолученным);
		
	ИначеЕсли (СчетЗадолженности = Счета.РасчетыСПокупателямиВал) Тогда
		
		Возврат(Счета.РасчетыПоАвансамПолученнымВал);
		
	ИначеЕсли (СчетЗадолженности = Счета.РасчетыСПокупателямиУЕ) Тогда
		
		Возврат(Счета.РасчетыПоАвансамПолученнымУЕ);
		
	ИначеЕсли (СчетЗадолженности = Счета.РасчетыСПоставщиками) Тогда
		
		Возврат(Счета.РасчетыПоАвансамВыданным);
		
	ИначеЕсли (СчетЗадолженности = Счета.РасчетыСПоставщикамиВал) Тогда
		
		Возврат(Счета.РасчетыПоАвансамВыданнымВал);
		
	ИначеЕсли (СчетЗадолженности = Счета.РасчетыСПоставщикамиУЕ) Тогда
		
		Возврат(Счета.РасчетыПоАвансамВыданнымУЕ);
		
	Иначе
		
		Возврат(СчетЗадолженности);
		
	КонецЕсли; 
	
	// --- 
КонецФункции

Функция ПолучитьВедущийДоговор(Договор) Экспорт 
	
	ВедущийДоговор = Неопределено;
	
	Если Договор.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПокупателем 
		ИЛИ Договор.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
		|	CW_ПриложенияКДоговорам.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.CW_ПриложенияКДоговорам КАК CW_ПриложенияКДоговорам
		|ГДЕ
		|	CW_ПриложенияКДоговорам.УчетныйДоговор = &УчетныйДоговор";
		
		Запрос.УстановитьПараметр("УчетныйДоговор", Договор);
		
		Результат = Запрос.Выполнить();
		Выборка = Результат.Выбрать();
		
		Если Выборка.Следующий() Тогда
			ВедущийДоговор = Выборка.Ссылка;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ВедущийДоговор) Тогда
			
			Запрос = Новый Запрос;
			Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
			|	CW_ДоговорыПоГрузоперевозкам.Ссылка КАК Ссылка
			|ИЗ
			|	Справочник.CW_ДоговорыПоГрузоперевозкам КАК CW_ДоговорыПоГрузоперевозкам
			|ГДЕ
			|	CW_ДоговорыПоГрузоперевозкам.УчетныйДоговор = &УчетныйДоговор";
			
			Запрос.УстановитьПараметр("УчетныйДоговор", Договор);
			
			Результат = Запрос.Выполнить();
			Выборка = Результат.Выбрать();
			
			Если Выборка.Следующий() Тогда
				ВедущийДоговор = Выборка.Ссылка;
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;	
	
	Если Договор.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СКомитентом Тогда 
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
		|	CW_ПриложенияКДоговорам.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.CW_ПриложенияКДоговорам КАК CW_ПриложенияКДоговорам
		|ГДЕ
		|	CW_ПриложенияКДоговорам.АгентскийДоговорНаПродажу = &УчетныйДоговор";
		
		Запрос.УстановитьПараметр("УчетныйДоговор", Договор);
		
		Результат = Запрос.Выполнить();
		Выборка = Результат.Выбрать();
		
		Если Выборка.Следующий() Тогда
			ВедущийДоговор = Выборка.Ссылка;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ВедущийДоговор) Тогда
			
			// агентский на продажу
			Запрос = Новый Запрос;
			Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
			|	CW_ДоговорыПоГрузоперевозкам.Ссылка
			|ИЗ
			|	Справочник.CW_ДоговорыПоГрузоперевозкам КАК CW_ДоговорыПоГрузоперевозкам
			|ГДЕ
			|	CW_ДоговорыПоГрузоперевозкам.АгентскийДоговорНаПродажу = &УчетныйДоговор";
			
			Запрос.УстановитьПараметр("УчетныйДоговор", Договор);
			
			Результат = Запрос.Выполнить();
			Выборка = Результат.Выбрать();
			
			Если Выборка.Следующий() Тогда
				ВедущийДоговор = Выборка.Ссылка;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;	
	
	Если Договор.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СКомитентомНаЗакупку Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
		|	CW_ПриложенияКДоговорам.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.CW_ПриложенияКДоговорам КАК CW_ПриложенияКДоговорам
		|ГДЕ
		|	CW_ПриложенияКДоговорам.АгентскийДоговорНаЗакупку = &УчетныйДоговор";
		
		Запрос.УстановитьПараметр("УчетныйДоговор", Договор);
		
		Результат = Запрос.Выполнить();
		Выборка = Результат.Выбрать();
		
		Если Выборка.Следующий() Тогда
			ВедущийДоговор = Выборка.Ссылка;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ВедущийДоговор) Тогда
			
			// агентский на закупку
			Запрос = Новый Запрос;
			Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
			|	CW_ДоговорыПоГрузоперевозкам.Ссылка
			|ИЗ
			|	Справочник.CW_ДоговорыПоГрузоперевозкам КАК CW_ДоговорыПоГрузоперевозкам
			|ГДЕ
			|	CW_ДоговорыПоГрузоперевозкам.АгентскийДоговорНаЗакупку = &УчетныйДоговор";
			Запрос.УстановитьПараметр("УчетныйДоговор", Договор);
			
			Результат = Запрос.Выполнить();
			Выборка = Результат.Выбрать();
			
			Если Выборка.Следующий() Тогда
				ВедущийДоговор = Выборка.Ссылка;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли; 
	
	Возврат ВедущийДоговор;
	
КонецФункции

