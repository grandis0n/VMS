Функция ПолучитьСтавкуНДСпоСистемеНалогообложения(Организация, Дата)
	
	СистемаНалогообложения = CW_БухгалтерияЭкспедитораСервер.ПолучитьСистемуНалогообложения(Организация, Дата);  
	
	Если СистемаНалогообложения = ПредопределенноеЗначение("Перечисление.СистемыНалогообложения.Общая") Тогда
		Возврат ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС20");
	КонецЕсли;  
	Если СистемаНалогообложения = ПредопределенноеЗначение("Перечисление.СистемыНалогообложения.Упрощенная") Тогда
		Возврат CW_БухгалтерияЭкспедитораСервер.ПолучитьНДСДляУСН(Организация, Дата);
	КонецЕсли;  
	
	Возврат ПредопределенноеЗначение("Перечисление.СтавкиНДС.ПустаяСсылка");
	
