//Функция ПолучитьСпособУчетаНДС(СтруктураПараметров, СтандартнаяПроверка = Истина) Экспорт
//
// Возвращает способ учета НДС
//
//	Параметры:
//	- СтруктураПараметров - структура со следуюущими свойствами: Дата, Организация,Номенклатура,НоменклатурнаяГруппа;
//	- СтандартнаяПроверка - значение: Истина/Ложь  (Значение по умолчанию = Истиа 
//							при установленном значении "ложь" игнорируются способы учета НДС,
//							указанные  в регистре "СчетаУчетаНоменклатуры"
//
Функция ПолучитьСпособУчетаНДС(СтруктураПараметров, СтандартнаяПроверка = Истина) Экспорт
	
	СпособУчетаНДС 	= Неопределено;
	Дата 		 	= ?(ЗначениеЗаполнено(СтруктураПараметров.Дата), СтруктураПараметров.Дата, ТекущаяДатаСеанса());
	
	Если СтандартнаяПроверка Тогда
		СведенияОНоменклатуре 	= БухгалтерскийУчетПереопределяемый.ПолучитьСчетаУчетаНоменклатуры(СтруктураПараметров.Организация, СтруктураПараметров.Номенклатура,, Дата);
		Если СведенияОНоменклатуре.Свойство("СпособУчетаНДС") Тогда
			СпособУчетаНДС = СведенияОНоменклатуре.СпособУчетаНДС;
		КонецЕсли;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(СпособУчетаНДС) Тогда
		СпособУчетаНДС = ПолучитьСпособУчетаНДСНоменклатурнойГруппы(СтруктураПараметров);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(СпособУчетаНДС) Тогда
		СпособУчетаНДС = CW_Настройки.ПараметрУчетнойПолитики(СтруктураПараметров.Дата, СтруктураПараметров.Организация, "ОсновнойСпособУчетаНДС");
	КонецЕсли;
	
	Возврат СпособУчетаНДС;
	
КонецФункции

Функция ПолучитьСпособУчетаНДСНоменклатурнойГруппы(СтруктураПараметров) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	СоответствиеНоменклатурныхГруппСпособамУчетаНДС.Организация КАК Организация,
	               |	СоответствиеНоменклатурныхГруппСпособамУчетаНДС.НоменклатурнаяГруппа КАК НоменклатурнаяГруппа,
	               |	СоответствиеНоменклатурныхГруппСпособамУчетаНДС.СпособУчетаНДС КАК СпособУчетаНДС
	               |ИЗ
	               |	РегистрСведений.CW_СоответствиеНоменклатурныхГруппСпособамУчетаНДС.СрезПоследних(
	               |			&Дата,
	               |			Организация = &Организация
	               |				И НоменклатурнаяГруппа = &НоменклатурнаяГруппа) КАК СоответствиеНоменклатурныхГруппСпособамУчетаНДС";
	
	Запрос.УстановитьПараметр("Дата"				, СтруктураПараметров.Дата);
	Запрос.УстановитьПараметр("Организация"			, СтруктураПараметров.Организация);
	Запрос.УстановитьПараметр("НоменклатурнаяГруппа", СтруктураПараметров.НоменклатурнаяГруппа);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.СпособУчетаНДС;
	КонецЕсли;

	Возврат Неопределено;
	
КонецФункции

