Функция ОпределитьСчетУчетаДоходов(СтрокаТаблицыУслуг,СтруктураСчетов,ПризнакВалютногоДокумента,ПризнакРасчетовУЕ) Экспорт 
	
	СоответствиеИмениСвойства = ПолучитьСоответствиеПоПорядкуОтражения();  
	
	ИмяСвойства = СоответствиеИмениСвойства.Получить(СтрокаТаблицыУслуг.ПорядокОтражения);   
	Если ИмяСвойства = Неопределено Тогда
		Возврат ПредопределенноеЗначение("ПланСчетов.Хозрасчетный.ПустаяСсылка");	
	КонецЕсли;
	
	ПризнакВалюты = "Рубли";
	Если ПризнакВалютногоДокумента Тогда
		ПризнакВалюты = ?(ПризнакРасчетовУЕ,"УЕ","Валюта");	
	КонецЕсли;
	
	Возврат СтруктураСчетов[ИмяСвойства+ПризнакВалюты];	

КонецФункции 

