Функция ПолучитьКоэффициентСтавкиНДС(ВидСтавки, Период) Экспорт
	
	Если ВидСтавки = Перечисления.ВидыСтавокНДС.Общая Тогда
		СтавкаНДС = УчетНДСКлиентСервер.ОбщаяСтавкаНДС(Период);
	ИначеЕсли ВидСтавки = Перечисления.ВидыСтавокНДС.ОбщаяРасчетная Тогда
		СтавкаНДС = УчетНДСКлиентСервер.ОбщаяРасчетнаяСтавкаНДС(Период);
	ИначеЕсли ВидСтавки = Перечисления.ВидыСтавокНДС.Пониженная Тогда
		СтавкаНДС = Перечисления.СтавкиНДС.НДС10;
	ИначеЕсли ВидСтавки = Перечисления.ВидыСтавокНДС.ПониженнаяРасчетная Тогда
		СтавкаНДС = Перечисления.СтавкиНДС.НДС10_110;
	ИначеЕсли ВидСтавки = Перечисления.ВидыСтавокНДС.Нулевая Тогда
		СтавкаНДС = Перечисления.СтавкиНДС.НДС0;
	ИначеЕсли ВидСтавки = Перечисления.ВидыСтавокНДС.БезНДС Тогда
		СтавкаНДС = Перечисления.СтавкиНДС.БезНДС;
	Иначе
		СтавкаНДС = Перечисления.СтавкиНДС.ПустаяСсылка();
	КонецЕсли;
	
	Возврат ПолучитьКоэффициентСтавкиНДСПереопределяемый(СтавкаНДС);
	
КонецФункции

Функция ПолучитьКоэффициентСтавкиНДСПереопределяемый(СтавкаНДС) экспорт
	
	Если СтавкаНДС = Перечисления.СтавкиНДС.НДС10 Тогда
		Возврат 0.1;
	ИначеЕсли СтавкаНДС = Перечисления.СтавкиНДС.НДС10_110 Тогда 
		Возврат 10/110;
	ИначеЕсли СтавкаНДС = Перечисления.СтавкиНДС.НДС18 Тогда
		Возврат 0.18;
	ИначеЕсли СтавкаНДС = Перечисления.СтавкиНДС.НДС18_118 Тогда 
		Возврат 18/118;
	ИначеЕсли СтавкаНДС = Перечисления.СтавкиНДС.НДС20 Тогда
		Возврат 0.20;
	ИначеЕсли СтавкаНДС = Перечисления.СтавкиНДС.НДС20_120 Тогда 
		Возврат 20/120;
	ИначеЕсли СтавкаНДС = Перечисления.СтавкиНДС.НДС22 Тогда
		Возврат 0.22;
	ИначеЕсли СтавкаНДС = Перечисления.СтавкиНДС.НДС22_122 Тогда 
		Возврат 22/122;
	Иначе
		Возврат 0;
	КонецЕсли;
	
КонецФункции

// Функция - Получить договор приложение
//
// По учетному договру получает ссылку на приложение к договору или договор по грузоперевозке
//
// Параметры:
//  ДоговорКонтрагента	 - 	СправочникСсылка "ДоговорыКонтрагентов"
// 
// Возвращаемое значение:
//   - Ссылка "ДоговорыПоГрузоперевозкам" или "ПриложенияКДоговорам" 
//
Функция ПолучитьДоговорПриложение(ДоговорКонтрагента) Экспорт
	
	ВедущийДоговор = Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	|	CW_ПриложенияКДоговорам.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.CW_ПриложенияКДоговорам КАК CW_ПриложенияКДоговорам
	|ГДЕ
	|	CW_ПриложенияКДоговорам.УчетныйДоговор = &УчетныйДоговор";
	
	Запрос.УстановитьПараметр("УчетныйДоговор", ДоговорКонтрагента);
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Если Выборка.Следующий() Тогда
		ВедущийДоговор = Выборка.Ссылка;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ВедущийДоговор) Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
		|	CW_ДоговорыПоГрузоперевозкам.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.CW_ДоговорыПоГрузоперевозкам КАК CW_ДоговорыПоГрузоперевозкам
		|ГДЕ
		|	CW_ДоговорыПоГрузоперевозкам.УчетныйДоговор = &УчетныйДоговор";
		
		Запрос.УстановитьПараметр("УчетныйДоговор", ДоговорКонтрагента);
		
		Результат = Запрос.Выполнить();
		Выборка = Результат.Выбрать();
		
		Если Выборка.Следующий() Тогда
			ВедущийДоговор = Выборка.Ссылка;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ВедущийДоговор;
	
КонецФункции

//Функция ПолучитьУчетныйДоговор(Параметры) Экспорт
//
// Параметры:
//  Параметры	 - 	 Структура: Договор, ПриложениеКДоговору
// 
// Возвращаемое значение:
//   - Ссылка на учетный договор
//
Функция ПолучитьУчетныйДоговор(Параметры) Экспорт
	
	ВедетсяУчетПриложений = ПолучитьФункциональнуюОпцию("CW_ВедетсяУчетПриложенийПоДоговорам");

	ИмяОбъекта 	= "CW_ДоговорыПоГрузоперевозкам";
	Ссылка 		= Параметры.Договор;
	
	Если ЗначениеЗаполнено(Параметры.ПриложениеКДоговору) и ВедетсяУчетПриложений Тогда   
		ИмяОбъекта  = "CW_ПриложенияКДоговорам";
		Ссылка 		= Параметры.ПриложениеКДоговору;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	СправочникДоговорПриложение.УчетныйДоговор КАК УчетныйДоговор
	               |ИЗ
	               |	Справочник."+ИмяОбъекта+" КАК СправочникДоговорПриложение
	               |ГДЕ
	               |	СправочникДоговорПриложение.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Результат = запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.УчетныйДоговор;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

// Функция - Получить парметры ведения бухгалтерского учета
//
// Параметры:
//  СтруктураПараметров	 - 	 Структура: Договор, ПриложениеКДоговору,ВедетсяУчетПриложений 
//  НаДату				 - 	 Дата документа 
// 
// Возвращаемое значение:
//   - Структура.
//
Функция ПолучитьПарметрыВеденияБухгалтерскогоУчета(СтруктураПараметров, НаДату=Неопределено) Экспорт
	
	Если НаДату = Неопределено Тогда
		НаДату = ТекущаяДата();
	КонецЕсли;
	
	ВедетсяУчетПриложений = Неопределено; 
	СтруктураПараметров.Свойство("ВедетсяУчетПриложений",ВедетсяУчетПриложений);
	
	Если ВедетсяУчетПриложений = Неопределено Тогда
		ВедетсяУчетПриложений = ПолучитьФункциональнуюОпцию("CW_ВедетсяУчетПриложенийПоДоговорам");
	КонецЕсли;
	
	ОбъектУчета	= СтруктураПараметров.Договор;
	Если ЗначениеЗаполнено(СтруктураПараметров.ПриложениеКДоговору) и ВедетсяУчетПриложений Тогда   
		ОбъектУчета	= СтруктураПараметров.ПриложениеКДоговору;
	КонецЕсли;
	
	ВедетсяБухгалтерскийУчет = ОбъектУчета.БухгалтерскийУчет и НаДату >= ОбъектУчета.ДатаНачалаВеденияБухгалтерскогоУчета;

	Если ВедетсяБухгалтерскийУчет и Не ЗначениеЗаполнено(ОбъектУчета.ДоговорДляВыявленияФинансовогоРезультата) Тогда
		СоздатьДоговорДляВыявленияВознаграждения(ОбъектУчета);  
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("БухгалтерскийУчет",		 					ВедетсяБухгалтерскийУчет);
	Результат.Вставить("ВалютаДоговора", 							ОбъектУчета.ВалютаДоговора);
	Результат.Вставить("ВзаиморасчетыВУЕ", 							ОбъектУчета.ВзаиморасчетыВУЕ);
	Результат.Вставить("УчетныйДоговор", 							ОбъектУчета.УчетныйДоговор);
	Результат.Вставить("АгентскийДоговорНаЗакупку", 				ОбъектУчета.АгентскийДоговорНаЗакупку);
	Результат.Вставить("АгентскийДоговорНаПродажу", 				ОбъектУчета.АгентскийДоговорНаПродажу);
	Результат.Вставить("ДоговорДляВыявленияФинансовогоРезультата", 	ОбъектУчета.ДоговорДляВыявленияФинансовогоРезультата);
	
	Возврат Результат;
			
КонецФункции    

Процедура СоздатьДоговорДляВыявленияВознаграждения(ОбъектУчета) 
	
	ИспользованиеСхемыПеревыставленияПоСтавкам = ПолучитьФункциональнуюОпцию("CW_ИспользованиеСхемыПеревыставленияПоСтавкам");
	Если Не ИспользованиеСхемыПеревыставленияПоСтавкам Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ОбъектУчета) Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(истина);
	
	Если ТипЗнч(ОбъектУчета) = Тип("СправочникСсылка.CW_ДоговорыПоГрузоперевозкам") Тогда
		ТекущийОбъектУчета 		= ОбъектУчета;     
		ВладелецОбъектаУчета 	= ОбъектУчета.Владелец;
	ИначеЕсли ТипЗнч(ОбъектУчета) = Тип("СправочникСсылка.CW_ПриложенияКДоговорам") Тогда
		ТекущийОбъектУчета 		= ОбъектУчета.Договор;
		ВладелецОбъектаУчета 	= ОбъектУчета.Договор.Владелец;
	Иначе
		Возврат;	
	КонецЕсли;   
	
	ПараметрыПоиска = Новый Структура;
	ПараметрыПоиска.Вставить("Наименование", 			"СлужебныйДляВознаграждения");
	ПараметрыПоиска.Вставить("ВидДоговора", 			Перечисления.ВидыДоговоровКонтрагентов.СПокупателем);
	ПараметрыПоиска.Вставить("ВалютаВзаиморасчетов", 	Константы.ВалютаРегламентированногоУчета.Получить());
	ПараметрыПоиска.Вставить("Организация", 			ТекущийОбъектУчета.Организация);
	ПараметрыПоиска.Вставить("Владелец", 				ВладелецОбъектаУчета);
	ПараметрыПоиска.Вставить("СпособВыставленияДокументов",Перечисления.СпособыВыставленияДокументов.Автоматически);  
	
	Если ТекущийОбъектУчета.ВзаиморасчетыВУЕ Тогда
		ВзаиморасчетыВУЕ = Новый Структура;
		ВзаиморасчетыВУЕ.Вставить("ОплатаВВалюте", Ложь);  
		ВзаиморасчетыВУЕ.Вставить("РасчетыВУсловныхЕдиницах",Истина);  
		
		ПараметрыПоиска.Вставить("ВзаиморасчетыВУЕ", ВзаиморасчетыВУЕ);
	КонецЕсли;
	
	НайденныйДоговор = ПолучитьДоговорДляВознаграждения(ПараметрыПоиска);
	
	Если НайденныйДоговор = Неопределено Тогда
		
		НовЭлемент 								= Справочники.ДоговорыКонтрагентов.СоздатьЭлемент();
		НовЭлемент.Наименование 				= ПараметрыПоиска.Наименование;
		НовЭлемент.ВидДоговора 					= ПараметрыПоиска.ВидДоговора;
		НовЭлемент.ВалютаВзаиморасчетов 		= ПараметрыПоиска.ВалютаВзаиморасчетов;    
		
		Если ТекущийОбъектУчета.ВзаиморасчетыВУЕ Тогда
			НовЭлемент.ОплатаВВалюте			= ПараметрыПоиска.ВзаиморасчетыВУЕ.ОплатаВВалюте; 
			НовЭлемент.РасчетыВУсловныхЕдиницах = ПараметрыПоиска.ВзаиморасчетыВУЕ.РасчетыВУсловныхЕдиницах;
		КонецЕсли;
		
		НовЭлемент.Организация 					= ПараметрыПоиска.Организация;
		НовЭлемент.Владелец 					= ПараметрыПоиска.Владелец;  
		НовЭлемент.СпособВыставленияДокументов 	= ПараметрыПоиска.СпособВыставленияДокументов;
		
		НовЭлемент.ДополнительныеСвойства.Вставить("ПривелигированныйРежимЗаписи", Истина);
		НовЭлемент.Записать();                    
		
		НайденныйДоговор = НовЭлемент.Ссылка;
	КонецЕсли;
	
	ТОбъект = ОбъектУчета.ПолучитьОбъект();
	ТОбъект.ДоговорДляВыявленияФинансовогоРезультата = НайденныйДоговор;     
	ТОбъект.ОбменДанными.Загрузка = Истина;
	ТОбъект.Записать();
	
КонецПроцедуры      

Функция ПолучитьДоговорДляВознаграждения(ПараметрыПоиска) 
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	|	ДоговорыКонтрагентов.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
	|ГДЕ
	|	ДоговорыКонтрагентов.ПометкаУдаления = ЛОЖЬ
	|	И ДоговорыКонтрагентов.Наименование = &Наименование
	|	И ДоговорыКонтрагентов.ВидДоговора = &ВидДоговора
	|	И ДоговорыКонтрагентов.ВалютаВзаиморасчетов = &ВалютаВзаиморасчетов
	|	И ДоговорыКонтрагентов.Организация = &Организация
	|	И ДоговорыКонтрагентов.Владелец = &Владелец
	|	И ДоговорыКонтрагентов.СпособВыставленияДокументов = &СпособВыставленияДокументов   
	|	//Условие_ОплатаВВалюте    
	|	//Условие_РасчетыВУсловныхЕдиницах";   
	
	Запрос.УстановитьПараметр("Наименование", 			ПараметрыПоиска.Наименование);
	Запрос.УстановитьПараметр("ВидДоговора", 			ПараметрыПоиска.ВидДоговора);
	Запрос.УстановитьПараметр("ВалютаВзаиморасчетов", 	ПараметрыПоиска.ВалютаВзаиморасчетов);
	Запрос.УстановитьПараметр("Организация", 			ПараметрыПоиска.Организация);
	Запрос.УстановитьПараметр("Владелец", 				ПараметрыПоиска.Владелец);
	Запрос.УстановитьПараметр("СпособВыставленияДокументов", ПараметрыПоиска.СпособВыставленияДокументов);  
	
	Если ПараметрыПоиска.Свойство("ВзаиморасчетыВУЕ") Тогда
		
		Запрос.УстановитьПараметр("ОплатаВВалюте", ПараметрыПоиска.ВзаиморасчетыВУЕ.ОплатаВВалюте);  
		Запрос.УстановитьПараметр("РасчетыВУсловныхЕдиницах", ПараметрыПоиска.ВзаиморасчетыВУЕ.РасчетыВУсловныхЕдиницах);  
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст,"Условие_ОплатаВВалюте", "И ДоговорыКонтрагентов.ОплатаВВалюте = &ОплатаВВалюте");
		Запрос.Текст = СтрЗаменить(Запрос.Текст,"Условие_РасчетыВУсловныхЕдиницах", "И ДоговорыКонтрагентов.РасчетыВУсловныхЕдиницах = &РасчетыВУсловныхЕдиницах");
	КонецЕсли;
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;                   
	
	Возврат Неопределено
	
КонецФункции
	

