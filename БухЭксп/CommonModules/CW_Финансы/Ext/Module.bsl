Функция СоздатьАгентскийДоговор(ДоговорПриложение,ВидДоговора = Неопределено) Экспорт
	
	ВедетсяУчетПриложенийПоДоговорам = ПолучитьФункциональнуюОпцию("CW_ВедетсяУчетПриложенийПоДоговорам");
	
	ДоговорТЭО = ДоговорПриложение.Договор;
	ИмяРеквизитаНомер 	= "НомерДоговора";
	ИмяРеквизитаДата 	= "ДатаДоговора";
	Организация			= ДоговорТЭО.Организация; 
	Владелец			= ДоговорТЭО.Владелец; 
	
	Если ЗначениеЗаполнено(ДоговорПриложение.ПриложениеКДоговору) и ВедетсяУчетПриложенийПоДоговорам Тогда
		ДоговорТЭО = ДоговорПриложение.ПриложениеКДоговору;
		ИмяРеквизитаНомер	= "НомерДокумента";
		ИмяРеквизитаДата 	= "ДатаДокумента";
	КонецЕсли;
	
	// служебные договора формируем в привелегированном режиме, 
	// т.к. у пользователя могут отсутствовать права на создание учетных договоров
	УстановитьПривилегированныйРежим(Истина);
	
	Если НЕ ДоговорТЭО.БухгалтерскийУчет Тогда
		Возврат Неопределено;
	КонецЕсли; 
	
	Если (ВидДоговора = Неопределено) Тогда
		ВидДоговора = ДоговорПриложение.Договор.ВидДоговора;
	КонецЕсли;  
	
	Если ВидДоговора = ПредопределенноеЗначение("Перечисление.ВидыДоговоровКонтрагентов.СПокупателем") Тогда
		АгентскийДоговор 				= ДоговорТЭО.АгентскийДоговорНаПродажу; 
		ВидДоговораАгентскогоДоговора 	= ПредопределенноеЗначение("Перечисление.ВидыДоговоровКонтрагентов.СКомитентом");
		ИмяРеквизитаАгентскогоДоговора 	= "АгентскийДоговорНаПродажу";
	КонецЕсли;
	
	Если ВидДоговора = ПредопределенноеЗначение("Перечисление.ВидыДоговоровКонтрагентов.СПоставщиком") Тогда
		АгентскийДоговор 				= ДоговорТЭО.АгентскийДоговорНаЗакупку;	
		ВидДоговораАгентскогоДоговора 	= ПредопределенноеЗначение("Перечисление.ВидыДоговоровКонтрагентов.СКомитентомНаЗакупку"); 
		ИмяРеквизитаАгентскогоДоговора	= "АгентскийДоговорНаЗакупку";
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(АгентскийДоговор) Тогда 
		
		
		НовыйАгентскийДоговор = Справочники.ДоговорыКонтрагентов.СоздатьЭлемент();
		
		НовыйАгентскийДоговор.Наименование 	= ДоговорТЭО.Наименование+" (служебный БЭ)";
		НовыйАгентскийДоговор.Организация 	= Организация;
		НовыйАгентскийДоговор.Владелец 		= Владелец;
		НовыйАгентскийДоговор.Номер 		= ДоговорТЭО[ИмяРеквизитаНомер];
		НовыйАгентскийДоговор.Дата 			= ДоговорТЭО[ИмяРеквизитаДата];  
		
		//Для версии КОРП 
		ЭтоВерсияКОРП = ВариантыПриложений.ЭтоВерсияКОРП();
		Если ЭтоВерсияКОРП Тогда
			//Ищем по головной организации 
			НовыйАгентскийДоговор.Организация = Организация.ГоловнаяОрганизация;
		КонецЕсли;
		//Для версии КОРП
		
		НовыйАгентскийДоговор.ВалютаВзаиморасчетов 			= ДоговорТЭО.ВалютаДоговора;
		НовыйАгентскийДоговор.РасчетыВУсловныхЕдиницах 		= ДоговорТЭО.ВзаиморасчетыВУЕ;
		НовыйАгентскийДоговор.ВидДоговора  					= ВидДоговораАгентскогоДоговора; // на продажу  
		НовыйАгентскийДоговор.СпособВыставленияДокументов 	= Перечисления.СпособыВыставленияДокументов.Автоматически;

		
		НовыйАгентскийДоговор.ДополнительныеСвойства.Вставить("ПривелигированныйРежимЗаписи", Истина);
		НовыйАгентскийДоговор.Записать();   
		
		АгентскийДоговор = НовыйАгентскийДоговор.Ссылка;
	КонецЕсли;
	
	Если АгентскийДоговор <>  ДоговорТЭО[ИмяРеквизитаАгентскогоДоговора] Тогда
		ДоговорОбъект = ДоговорТЭО.ПолучитьОбъект(); 
		ДоговорОбъект[ИмяРеквизитаАгентскогоДоговора] = АгентскийДоговор;
		ДоговорОбъект.ДополнительныеСвойства.Вставить("ПривелигированныйРежимЗаписи", Истина);
		ДоговорОбъект.Записать();   
	КонецЕсли;
	
	Возврат АгентскийДоговор;
	
КонецФункции

// Формирует таблицу с остатками оперативной задолженности по переданным параметрам 
Функция ТаблицаОперативнойЗадолженностиПоСчетам(Параметры) Экспорт
	
	Если Не ЗначениеЗаполнено(Параметры.Договор) Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 0
		|	CW_ОперативнаяКредиторскаяЗадолженностьОстатки.Счет КАК Документ,
		|	CW_ОперативнаяКредиторскаяЗадолженностьОстатки.Счет.Дата КАК ДатаДокумента,
		|	CW_ОперативнаяКредиторскаяЗадолженностьОстатки.СчетУчета КАК СчетЗадолженности,
		|	CW_ОперативнаяКредиторскаяЗадолженностьОстатки.Всего_ВалютаОстаток КАК Задолженность,
		|	CW_ОперативнаяКредиторскаяЗадолженностьОстатки.Счет.ПредставлениеДокумента КАК Представление,
		|	CW_СрокиОплатыСчетов.ДатаОплаты КАК СрокОплаты
		|ИЗ
		|	РегистрНакопления.CW_ОперативнаяКредиторскаяЗадолженность.Остатки(, ) КАК CW_ОперативнаяКредиторскаяЗадолженностьОстатки
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.CW_СрокиОплатыСчетов КАК CW_СрокиОплатыСчетов
		|		ПО CW_ОперативнаяКредиторскаяЗадолженностьОстатки.Счет = CW_СрокиОплатыСчетов.Счет";	
		
		Возврат Запрос.Выполнить().Выгрузить();
		
	КонецЕсли;
	
	СтруктураТиповДанных = ПолучитьСтруктуруТиповДанных(Параметры);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ТаблицаЗадолженности.Счет КАК Документ,
	|	ТаблицаЗадолженности.Счет.Дата КАК ДатаДокумента,
	|	ТаблицаЗадолженности.СчетУчета КАК СчетЗадолженности,
	|	ТаблицаЗадолженности.Всего_ВалютаОстаток КАК Задолженность,
	|	ТаблицаЗадолженности.Счет.ПредставлениеДокумента КАК Представление,
	|	CW_СрокиОплатыСчетов.ДатаОплаты КАК СрокОплаты
	|ИЗ
	|	РегистрНакопления."+СтруктураТиповДанных.Имярегистра+".Остатки(
	|			&Период,
	|			Организация = &Организация
	|				И Контрагент = &Контрагент
	|				И Договор = &Договор
	|				И ВЫБОР КОГДА &ЕстьПриложение 
    |								ТОГДА ПриложениеКДоговору = &ПриложениеКДоговору 
	|						ИНАЧЕ Истина 
	|				  КОНЕЦ
	|				И Валюта = &Валюта
	|				И ВЫБОР
	|					КОГДА Счет ССЫЛКА Документ."+СтруктураТиповДанных.ТипДокументаСчет+"
	|							ИЛИ Счет ССЫЛКА Документ.CW_Оплата
	|						ТОГДА ВЫБОР
	|								КОГДА &ВестиУчетПоПодразделениям
	|									ТОГДА ВЫБОР
	|											КОГДА &ПодразделениеОрганизацииУказано
	|												ТОГДА Счет.ПодразделениеОрганизации = &ПодразделениеОрганизации
	|											ИНАЧЕ ИСТИНА
	|										КОНЕЦ
	|								ИНАЧЕ ИСТИНА
	|							КОНЕЦ
	|					ИНАЧЕ ИСТИНА
	|				КОНЕЦ) КАК ТаблицаЗадолженности
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.CW_СрокиОплатыСчетов КАК CW_СрокиОплатыСчетов
	|		ПО ТаблицаЗадолженности.Счет = CW_СрокиОплатыСчетов.Счет
	|АВТОУПОРЯДОЧИВАНИЕ";	
	
	Запрос.УстановитьПараметр("Период"				, Новый Граница(Параметры.Дата,ВидГраницы.Исключая)); 
	Запрос.УстановитьПараметр("Организация"			, Параметры.Организация);	
	Запрос.УстановитьПараметр("Контрагент"			, Параметры.Контрагент);	
	Запрос.УстановитьПараметр("Договор"				, Параметры.Договор);	
	Запрос.УстановитьПараметр("ПриложениеКДоговору"	, Параметры.ПриложениеКДоговору);	
	Запрос.УстановитьПараметр("ЕстьПриложение"		, ЗначениеЗаполнено(Параметры.ПриложениеКДоговору));	
	Запрос.УстановитьПараметр("Валюта"				, Параметры.Валюта);	
	
	//Для версии КОРП
	Если Параметры.Свойство("ВестиУчетПоПодразделениям") Тогда
		Запрос.УстановитьПараметр("ВестиУчетПоПодразделениям"		, Параметры.ВестиУчетПоПодразделениям);	
		Запрос.УстановитьПараметр("ПодразделениеОрганизации"		, Параметры.ПодразделениеОрганизации);	
		Запрос.УстановитьПараметр("ПодразделениеОрганизацииУказано"	, ЗначениеЗаполнено(Параметры.ПодразделениеОрганизации));	
	Иначе
		Запрос.УстановитьПараметр("ВестиУчетПоПодразделениям"		, Ложь);	
		Запрос.УстановитьПараметр("ПодразделениеОрганизации"		, Неопределено);	
		Запрос.УстановитьПараметр("ПодразделениеОрганизацииУказано"	, Ложь);	
	КонецЕсли;
	//Для версии КОРП
	
	ТОЗ = Запрос.Выполнить().Выгрузить();
	
	Возврат ТОЗ;
	
КонецФункции

Функция ПолучитьСтруктуруТиповДанных(Параметры)
	
	Если Не Параметры.Свойство("ВидОперации") тогда
		Параметры.Вставить("ВидОперации", ПредопределенноеЗначение("Перечисление.CW_ВидыОперацийДДС.ПустаяСсылка"));	
	КонецЕсли;
	
	СтруктураТиповДанных = Новый Структура; 

	СоответствиеВидаОперацииИмяРегистра 	= ПолучитьСоответствиеВидаОперацииИмяРегистра();
	СоответствиеВидаДоговораТипуДокумента 	= ПолучитьСоответствиеВидаДоговораТипуДокумента();
	
	ИмяРегистра = СоответствиеВидаОперацииИмяРегистра.Получить(Параметры.ВидОперации);
	Если ИмяРегистра = Неопределено Тогда
		//Определяем по виду договора
		СоответствиеВидаДоговораИмяРегистра 	= ПолучитьСоответствиеВидаДоговораИмяРегистра();
		ИмяРегистра = СоответствиеВидаДоговораИмяРегистра.Получить(Параметры.Договор.ВидДоговора);
	КонецЕсли;
	ТипДокументаСчет = СоответствиеВидаДоговораТипуДокумента.Получить(Параметры.Договор.ВидДоговора);
	
	Если ТипДокументаСчет = Неопределено Тогда //Прочее
		Если ИмяРегистра = "CW_ОперативнаяКредиторскаяЗадолженность" Тогда
			ТипДокументаСчет = "CW_РасходыПоПриобретениям";
		КонецЕсли;
		Если ИмяРегистра = "CW_ОперативнаяДебиторскаяЗадолженность" Тогда
			ТипДокументаСчет = "CW_РеализацияПрочихТоваровУслуг";
		КонецЕсли;
	КонецЕсли;

	СтруктураТиповДанных.Вставить("Имярегистра", 		Имярегистра);
	СтруктураТиповДанных.Вставить("ТипДокументаСчет", 	ТипДокументаСчет);
	
	Возврат СтруктураТиповДанных;

КонецФункции

Функция ПолучитьСоответствиеВидаОперацииИмяРегистра()
	
	Результат = Новый Соответствие;
	
	Результат.Вставить(ПредопределенноеЗначение("Перечисление.CW_ВидыОперацийДДС.ОплатаПоставщику"), 				"CW_ОперативнаяКредиторскаяЗадолженность");
	Результат.Вставить(ПредопределенноеЗначение("Перечисление.CW_ВидыОперацийДДС.ПрочиеСписания"), 					"CW_ОперативнаяКредиторскаяЗадолженность");
	Результат.Вставить(ПредопределенноеЗначение("Перечисление.CW_ВидыОперацийДДС.ОплатаПоставщикуПоПриобретениям"), "CW_ОперативнаяКредиторскаяЗадолженность");
	
	Результат.Вставить(ПредопределенноеЗначение("Перечисление.CW_ВидыОперацийДДС.ПоступлениеОтПокупателя"), 		"CW_ОперативнаяДебиторскаяЗадолженность");
	Результат.Вставить( ПредопределенноеЗначение("Перечисление.CW_ВидыОперацийДДС.ПрочиеПоступления"), 				"CW_ОперативнаяДебиторскаяЗадолженность");
	
	Результат.Вставить( ПредопределенноеЗначение("Перечисление.CW_ВидыОперацийДДС.ПеремещениеВДругуюКассу"), 			"CW_ОперативнаяДебиторскаяЗадолженность");
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьСоответствиеВидаДоговораТипуДокумента()
	
	Результат = Новый Соответствие;
	
	Результат.Вставить(ПредопределенноеЗначение("Перечисление.ВидыДоговоровКонтрагентов.СПокупателем"),		"CW_ДоходыПоГрузоперевозке");
	Результат.Вставить(ПредопределенноеЗначение("Перечисление.ВидыДоговоровКонтрагентов.СПоставщиком"),		"CW_РасходыПоГрузоперевозке");
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьСоответствиеВидаДоговораИмяРегистра()
	
	Результат = Новый Соответствие;
	
	Результат.Вставить(ПредопределенноеЗначение("Перечисление.ВидыДоговоровКонтрагентов.СПокупателем"),		"CW_ОперативнаяДебиторскаяЗадолженность");
	Результат.Вставить(ПредопределенноеЗначение("Перечисление.ВидыДоговоровКонтрагентов.СПоставщиком"),		"CW_ОперативнаяКредиторскаяЗадолженность");
	
	Возврат Результат;
	
КонецФункции




Функция СтруктураБухгалтерскойЗадолженностиПоАктам(Параметры) Экспорт
	// --- 
	
	ТаблицаСоответствияСчетовЗадолженности = _сф.т_Сгруппировать(Параметры.ТОЗ,"Документ","СчетЗадолженности");
	СоответствиеСчетовЗадолженности = _сф.со_Создать("Документ","Элементы",ТаблицаСоответствияСчетовЗадолженности);
	ТаблицаСчетов = _сф.т_СкопироватьСвернуть(ТаблицаСоответствияСчетовЗадолженности,"Документ");
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("Договор", 			Параметры.Договор);
	СтруктураПараметров.Вставить("ПриложениеКДоговору",	Параметры.ПриложениеКДоговору);
	
	УчетныйДоговор = CW_Финансы.ПолучитьУчетныйДоговор(СтруктураПараметров);

	
	МассивСчетов = ТаблицаСчетов.ВыгрузитьКолонку("Документ");
	
	Запрос = Новый Запрос;
	// --- 
	Если (Параметры.Договор.ВидДоговора=Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком) Тогда
		Запрос.Текст = "ВЫБРАТЬ
		|	CW_СоответствиеАктовВходящимСчетам.Счет КАК Счет,
		|	CW_СоответствиеАктовВходящимСчетам.Акт КАК Акт,
		|	CW_СоответствиеАктовВходящимСчетам.Акт.Дата КАК ДатаАкта,
		|	CW_СоответствиеАктовВходящимСчетам.Акт.ПредставлениеДокумента КАК Представление,
		|	CW_СоответствиеАктовВходящимСчетам.СчетУчетаЗадолженности КАК СчетЗадолженности,
		|	CW_СоответствиеАктовВходящимСчетам.Всего КАК СуммаДокумента,
		|	CW_СоответствиеАктовВходящимСчетам.НДС КАК СуммаНДС
		|ИЗ
		|	РегистрСведений.CW_СоответствиеАктовВходящимСчетам КАК CW_СоответствиеАктовВходящимСчетам
		|ГДЕ
		|	CW_СоответствиеАктовВходящимСчетам.Счет В(&Счета)";
	КонецЕсли;
	// --- 
	Если (Параметры.Договор.ВидДоговора=Перечисления.ВидыДоговоровКонтрагентов.СПокупателем) Тогда
		Запрос.Текст = "ВЫБРАТЬ
		|	CW_СоответствиеАктовИсходящимСчетам.Счет КАК Счет,
		|	CW_СоответствиеАктовИсходящимСчетам.Акт КАК Акт,
		|	CW_СоответствиеАктовИсходящимСчетам.Акт.Дата КАК ДатаАкта,
		|	CW_СоответствиеАктовИсходящимСчетам.Акт.ПредставлениеДокумента КАК Представление,
		|	CW_СоответствиеАктовИсходящимСчетам.СчетУчетаЗадолженности КАК СчетЗадолженности,
		|	CW_СоответствиеАктовИсходящимСчетам.Всего КАК СуммаДокумента,
		|	CW_СоответствиеАктовИсходящимСчетам.НДС КАК СуммаНДС
		|ИЗ
		|	РегистрСведений.CW_СоответствиеАктовИсходящимСчетам КАК CW_СоответствиеАктовИсходящимСчетам
		|ГДЕ
		|	CW_СоответствиеАктовИсходящимСчетам.Счет В(&Счета)";
	КонецЕсли;
	// --- 
	Запрос.УстановитьПараметр("Счета", МассивСчетов);
	ТА = Запрос.Выполнить().Выгрузить(); // таблица актор
	// фильтруем по счетам задолженности
	МассивУдаления = Новый Массив;
	Для каждого СтрокаАкта Из ТА Цикл
		
		Если СоответствиеСчетовЗадолженности.Получить(СтрокаАкта.Счет).Найти(СтрокаАкта.СчетЗадолженности) = Неопределено Тогда
			
			МассивУдаления.Добавить(СтрокаАкта);
			
		КонецЕсли; 
		
	КонецЦикла; 
	_сф.к_УдалитьЭлементыПоМассиву(ТА,МассивУдаления);
	// --- 
	ТСЗ = _сф.т_Сгруппировать(ТА,"СчетЗадолженности","Акт:Акт.ВедомыйДокумент");
	// --- 
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ХозрасчетныйОстатки.Счет КАК СчетЗадолженности,
	|	ХозрасчетныйОстатки.Субконто3 КАК Акт,
	|	&Множитель * ВЫБОР
	|		КОГДА &Валюта = НЕОПРЕДЕЛЕНО
	|			ТОГДА ХозрасчетныйОстатки.СуммаОстаток
	|		ИНАЧЕ ХозрасчетныйОстатки.ВалютнаяСуммаОстаток
	|	КОНЕЦ КАК Задолженность
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный.Остатки(
	|			&Период,
	|			Счет = &Счет,
	|			,
	|			Организация = &Организация
	|				И ВЫБОР
	|					КОГДА &Валюта = НЕОПРЕДЕЛЕНО
	|						ТОГДА ИСТИНА
	|					ИНАЧЕ Валюта = &Валюта
	|				КОНЕЦ
	|				И Субконто1 = &Контрагент
	|				И Субконто2 = &Договор
	|				И Субконто3 В (&Акты)) КАК ХозрасчетныйОстатки";
	// --- 
	Запрос.УстановитьПараметр("Период",Новый Граница(Параметры.Дата,ВидГраницы.Исключая));
	
	Запрос.УстановитьПараметр("Множитель", ?(Параметры.Договор.ВидДоговора=Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком,-1,1)); 
	
	Запрос.УстановитьПараметр("Организация", Параметры.Организация);
	Запрос.УстановитьПараметр("Контрагент",	 Параметры.Контрагент);
	Запрос.УстановитьПараметр("Договор",	 УчетныйДоговор);
	
	ВРУ = Константы.ВалютаРегламентированногоУчета.Получить();
	Запрос.УстановитьПараметр("Валюта", ?(Параметры.Валюта = ВРУ,Неопределено,Параметры.Валюта)); 
	
	ТЗА = Неопределено;
	// --- 
	Для каждого СтрокаСчетаЗадолженности Из ТСЗ Цикл
		
		Запрос.УстановитьПараметр("Счет",СтрокаСчетаЗадолженности.СчетЗадолженности);
		Запрос.УстановитьПараметр("Акты",СтрокаСчетаЗадолженности.Элементы);
		// --- 
		Если ТЗА = Неопределено Тогда
			
			ТЗА = Запрос.Выполнить().Выгрузить();
			
		Иначе
			
			ВТЗА = Запрос.Выполнить().Выгрузить();
			Для каждого Стр Из ВТЗА Цикл
				
				Нстр = ТЗА.Добавить();
				ЗаполнитьЗначенияСвойств(Нстр,Стр);
				
			КонецЦикла; 
			
		КонецЕсли; 		
		
	КонецЦикла; 
	
	
	Если (Параметры.Валюта <> ВРУ И ТЗА <> Неопределено) Тогда
		
		МассивУдаляемых = Новый Массив;
		Для каждого Стр Из ТЗА Цикл
			
			Если (Стр.Задолженность = 0) Тогда
				МассивУдаляемых.Добавить(Стр);
			КонецЕсли; 
			
		КонецЦикла; 
		_сф.к_УдалитьЭлементыПоМассиву(ТЗА, МассивУдаляемых);

		
	КонецЕсли; 
		
	// --- 
	
	Возврат(Новый Структура("ТА,ТЗА",ТА,ТЗА));
	
	// --- 
КонецФункции

//УСТАРЕЛА см. процедуру "СписаниеКурсовыеПоОперативнойЗадолженности"
Процедура СписатьКурсовыеПоОперативнойЗадолженности(Объект, Набор) Экспорт 
	
	Если Объект.Договор.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПокупателем Тогда
		РегистрОперативнойЗадолженности = "CW_ОперативнаяДебиторскаяЗадолженность";
	ИначеЕсли	Объект.Договор.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком Тогда
		РегистрОперативнойЗадолженности = "CW_ОперативнаяКредиторскаяЗадолженность";
	Иначе
		Возврат;
	КонецЕсли;  
	
	Набор.Записать();
	
	Если (ТипЗнч(Объект)=Тип("ДокументОбъект.CW_ДвижениеДенежныхСредств")) Тогда
		ВалютаОбъекта = Объект.Договор.ВалютаДоговора;
	Иначе
		ВалютаОбъекта = Объект.Валюта;
	КонецЕсли; 
	
	Если ТипЗнч(Объект)=Тип("ДокументСсылка.CW_РасходыПоГрузоперевозке") 
		или ТипЗнч(Объект)=Тип("ДокументСсылка.CW_ДоходыПоГрузоперевозке") Тогда
		ДатаСреза = Объект.ДатаСчета;
	Иначе
		ДатаСреза = Объект.МоментВремени();
	КонецЕсли;
		
	ТаблицаДвижений = Набор.Выгрузить();
	ТаблицаДвижений.Свернуть("Счет,СчетУчета");
	
	МассивТипов = Новый Массив;
	МассивТипов.Добавить(Тип("ДокументСсылка.CW_РасходыПоГрузоперевозке"));
	МассивТипов.Добавить(Тип("ДокументСсылка.CW_ДоходыПоГрузоперевозке"));
	
	ТаблицаАналитики = Новый ТаблицаЗначений;
	ТаблицаАналитики.Колонки.Добавить("Счет"		, Новый ОписаниеТипов(МассивТипов));
	ТаблицаАналитики.Колонки.Добавить("СчетУчета"	, Новый ОписаниеТипов("ПланСчетовСсылка.Хозрасчетный"));
	
	Для Каждого СтрокаДвижений из ТаблицаДвижений Цикл
		Если МассивТипов.Найти(ТипЗнч(СтрокаДвижений.Счет)) <> Неопределено Тогда
			НоваяСтрока = ТаблицаАналитики.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаДвижений);
		КонецЕсли;
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ТаблицаДвижений.Счет КАК Счет,
	               |	ТаблицаДвижений.СчетУчета КАК СчетЗадолженности
	               |ПОМЕСТИТЬ ВТ_ВнешниеДанные
	               |ИЗ
	               |	&ТаблицаДвижений КАК ТаблицаДвижений
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ_ВнешниеДанные.Счет КАК Счет,
	               |	ВТ_ВнешниеДанные.СчетЗадолженности КАК СчетЗадолженности
	               |ПОМЕСТИТЬ ВТ_Аналитика
	               |ИЗ
	               |	ВТ_ВнешниеДанные КАК ВТ_ВнешниеДанные
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	CW_ОперативнаяДебиторскаяЗадолженностьОстатки.Счет КАК Счет,
	               |	CW_ОперативнаяДебиторскаяЗадолженностьОстатки.СчетУчета КАК СчетЗадолженности,
	               |	CW_ОперативнаяДебиторскаяЗадолженностьОстатки.Всего_ВалютаОстаток КАК ВалютныйОстаток,
	               |	CW_ОперативнаяДебиторскаяЗадолженностьОстатки.ВсегоОстаток КАК Остаток
	               |ИЗ
	               |	РегистрНакопления."+РегистрОперативнойЗадолженности+".Остатки(
	               |			&Период,
	               |			(Счет, СчетУчета) В
	               |					(ВЫБРАТЬ
	               |						ВТ_Аналитика.Счет КАК Счет,
	               |						ВТ_Аналитика.СчетЗадолженности КАК СчетЗадолженности
	               |					ИЗ
	               |						ВТ_Аналитика КАК ВТ_Аналитика)
	               |				И Организация = &Организация
	               |				И Контрагент = &Контрагент
	               |				И Договор = &Договор
	               |				И Валюта = &Валюта) КАК CW_ОперативнаяДебиторскаяЗадолженностьОстатки
				   |ГДЕ
				   | 	CW_ОперативнаяДебиторскаяЗадолженностьОстатки.Всего_ВалютаОстаток = 0";
	
	
	Запрос.УстановитьПараметр("Период"		, Новый Граница(ДатаСреза,ВидГраницы.Включая));
	Запрос.УстановитьПараметр("Организация"	, Объект.Организация);
	Запрос.УстановитьПараметр("Контрагент"	, Объект.Контрагент);
	Запрос.УстановитьПараметр("Договор"		, Объект.Договор);
	
	Запрос.УстановитьПараметр("Валюта"			, ВалютаОбъекта);
	Запрос.УстановитьПараметр("ТаблицаДвижений"	, ТаблицаАналитики);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Движение 					= Набор.Добавить();
		Движение.Период 			= Объект.Дата;
		Движение.ВидДвижения 		= ВидДвиженияНакопления.Расход;
		
		ЗаполнитьЗначенияСвойств(Движение,Объект);
		
		Движение.ВидОперации		= Перечисления.CW_ВидыДвиженийПоОперативнойЗадолженности.КурсоваяРазница;
		
		Движение.Счет 				= Выборка.Счет;
		Движение.СчетУчета 			= Выборка.СчетЗадолженности;
		Движение.Валюта 			= ВалютаОбъекта;
		
		Движение.Всего_Валюта 		= 0;
		Движение.Всего 				= Выборка.Остаток;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура СписаниеКурсовыеПоОперативнойЗадолженности(ПараметрыПроцедуры) Экспорт 
	
	Если Не ПараметрыПроцедуры.Свойство("ИмяРегистраОперативнойЗадолженности") Тогда
		//если не указан регистра ничего не делаем
		Возврат;
	КонецЕсли;
	
	Набор = ПараметрыПроцедуры.Набор;
	Набор.Записать();
	
	ТаблицаДвижений = Набор.Выгрузить();
	
	Запрос = Новый Запрос;
	Запрос.Текст =  "ВЫБРАТЬ
					|	ТаблицаДвижений.Организация КАК Организация,
					|	ТаблицаДвижений.Контрагент КАК Контрагент,
					|	ТаблицаДвижений.Договор КАК Договор,
					|	ТаблицаДвижений.ПриложениеКДоговору КАК ПриложениеКДоговору,
					|	ТаблицаДвижений.Счет КАК Счет,
					|	ТаблицаДвижений.Валюта КАК Валюта,
					|	ТаблицаДвижений.СчетУчета КАК СчетУчета
					|ПОМЕСТИТЬ ВТ_ВнешниеДанные
					|ИЗ
					|	&ТаблицаДвижений КАК ТаблицаДвижений
					|;
					|
					|////////////////////////////////////////////////////////////////////////////////
					|ВЫБРАТЬ
					|	ОперативнаяЗадолженностьОстатки.Организация КАК Организация,
					|	ОперативнаяЗадолженностьОстатки.Контрагент КАК Контрагент,
					|	ОперативнаяЗадолженностьОстатки.Договор КАК Договор,
					|	ОперативнаяЗадолженностьОстатки.ПриложениеКДоговору КАК ПриложениеКДоговору,
					|	ОперативнаяЗадолженностьОстатки.Счет КАК Счет,
					|	ОперативнаяЗадолженностьОстатки.Валюта КАК Валюта,
					|	ОперативнаяЗадолженностьОстатки.СчетУчета КАК СчетУчета,
					|	0 КАК Всего_Валюта,
					|	ОперативнаяЗадолженностьОстатки.ВсегоОстаток КАК Всего
					|ИЗ
					|	РегистрНакопления."+ПараметрыПроцедуры.ИмяРегистраОперативнойЗадолженности+".Остатки(
					|			&ДатаСреза,
					|			(Организация, Контрагент, Договор, ПриложениеКДоговору, Валюта, Счет, СчетУчета) В
					|				(ВЫБРАТЬ
					|					ВТ_ВнешниеДанные.Организация КАК Организация,
					|					ВТ_ВнешниеДанные.Контрагент КАК Контрагент,
					|					ВТ_ВнешниеДанные.Договор КАК Договор,
					|					ВТ_ВнешниеДанные.ПриложениеКДоговору КАК ПриложениеКДоговору,
					|					ВТ_ВнешниеДанные.Валюта КАК Валюта,
					|					ВТ_ВнешниеДанные.Счет КАК Счет,
					|					ВТ_ВнешниеДанные.СчетУчета КАК СчетУчета
					|				ИЗ
					|					ВТ_ВнешниеДанные КАК ВТ_ВнешниеДанные
					|				СГРУППИРОВАТЬ ПО
					|					ВТ_ВнешниеДанные.ПриложениеКДоговору,
					|					ВТ_ВнешниеДанные.Контрагент,
					|					ВТ_ВнешниеДанные.Счет,
					|					ВТ_ВнешниеДанные.СчетУчета,
					|					ВТ_ВнешниеДанные.Организация,
					|					ВТ_ВнешниеДанные.Договор,
					|					ВТ_ВнешниеДанные.Валюта)) КАК ОперативнаяЗадолженностьОстатки
					|ГДЕ
					|	ОперативнаяЗадолженностьОстатки.Всего_ВалютаОстаток = 0";
	
	Запрос.УстановитьПараметр("ТаблицаДвижений"	, ТаблицаДвижений);
	Запрос.УстановитьПараметр("ДатаСреза"		, Новый Граница(ПараметрыПроцедуры.ДатаСреза,ВидГраницы.Включая));
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();      
	Пока Выборка.Следующий() Цикл
		
		Движение				= Набор.ДобавитьРасход();
		Движение.Период			= ПараметрыПроцедуры.Дата;
		Движение.ВидОперации	= ПредопределенноеЗначение("Перечисление.CW_ВидыДвиженийПоОперативнойЗадолженности.КурсоваяРазница");
		
		ЗаполнитьЗначенияСвойств(Движение, Выборка);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура СформироватьДеревоОплат(ДеревоОплат, Параметры) Экспорт
	
	ЭтоДеревоЗначений = (ТипЗнч(ДеревоОплат)=Тип("ДеревоЗначений"));
	
	// теперь формируем дерево
	Если (ЭтоДеревоЗначений) Тогда
		ДеревоОплат.Строки.Очистить();
	Иначе
		ДеревоОплат.ПолучитьЭлементы().Очистить();	
	КонецЕсли; 
	
	// сортируем таблицу ОЗ по дате счёта
	ТаблицаОЗ = Параметры.ТОЗ.Скопировать();
	ТаблицаОЗ.Колонки.Добавить("ДатаСчета");
	ТаблицаОЗ.Колонки.Добавить("ПризнакСчета");
	ТипДоходы = Тип("ДокументСсылка.CW_ДоходыПоГрузоперевозке");
	ТипРасходы = Тип("ДокументСсылка.CW_РасходыПоГрузоперевозке");
	Для каждого Стр Из ТаблицаОЗ Цикл
		
		ТипДокумента = ТипЗнч(Стр.Документ);
		Если (ТипДокумента = ТипДоходы ИЛИ ТипДокумента = ТипРасходы) Тогда
			Стр.ПризнакСчета = 1;
			Стр.ДатаСчета = Стр.Документ.ДатаСчета;
		Иначе
			Стр.ПризнакСчета = 0;
			Стр.ДатаСчета = Дата(1,1,1);
		КонецЕсли; 
	КонецЦикла; 
	ТаблицаОЗ.Сортировать("ПризнакСчета Убыв, СрокОплаты Возр, ДатаСчета Возр");

	Для каждого СтрокаТОЗ Из ТаблицаОЗ Цикл
		
		Если (ТипЗнч(СтрокаТОЗ.Документ)=Тип("ДокументСсылка.CW_Оплата")
			ИЛИ ТипЗнч(СтрокаТОЗ.Документ)=Тип("ДокументСсылка.CW_ДвижениеДенежныхСредств")
			ИЛИ ТипЗнч(СтрокаТОЗ.Документ)=Тип("ДокументСсылка.CW_КорректировкаОперативнойЗадолженности")) Тогда
			Продолжить;
		КонецЕсли; 
		
		Если (ЭтоДеревоЗначений) Тогда
			Нстр = ДеревоОплат.Строки.Добавить();
			_ЗаполнитьСтрокуДереваЗначений(Нстр);
		Иначе
			Нстр = ДеревоОплат.ПолучитьЭлементы().Добавить();	
		КонецЕсли; 
		
		// представление счёта  
		ПредставлениеСчета = "Счёт №"+Строка(СтрокаТОЗ.Документ.НомерСчета)+" от "+Формат(СтрокаТОЗ.Документ.ДатаСчета,"ДФ=dd.MM.yyyy"); 
		Нстр.Документ = СтрокаТОЗ.Документ;
		Нстр.Представление = ПредставлениеСчета;
		Нстр.ЭтоСчет = Истина;
		Нстр.ИндексКартинки = 0;
		Нстр.СчетЗадолженности = СтрокаТОЗ.СчетЗадолженности;
		Нстр.ДатаДокумента = СтрокаТОЗ.ДатаДокумента;
		Нстр.СрокОплаты = СтрокаТОЗ.СрокОплаты;   
		Нстр.Оплата_Валюта = 0;       
		Нстр.Оплата_БВ = 0;  
		Нстр.СуммаНДС = 0;  
		Нстр.СуммаНДСИсходная = 0;  
		
		Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(СтрокаТОЗ.Документ.Услуги[0],"СчетЗадолженности") Тогда
			Нстр.СуммаДокумента = _сф.Итог(СтрокаТОЗ.Документ.Услуги.Выгрузить(_сф.ст_Отбор("СчетЗадолженности",СтрокаТОЗ.СчетЗадолженности)),"Всего");
		Иначе
			Нстр.СуммаДокумента = _сф.Итог(СтрокаТОЗ.Документ.Услуги.Выгрузить(),"Всего");
		КонецЕсли;   
		
		ПараметрыОтбора = Новый Структура;
		ПараметрыОтбора.Вставить("СчетЗадолженности", СтрокаТОЗ.СчетЗадолженности); 
		
		Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(СтрокаТОЗ.Документ.Услуги[0],"НДС") Тогда  
			
			ТаблицаНДС = СтрокаТОЗ.Документ.Услуги.Выгрузить(ПараметрыОтбора, "СтавкаНДС,НДС");
			СуммаНДСИсходная	= ТаблицаНДС.Итог("НДС");
			
			ТаблицаНДС.Свернуть("СтавкаНДС"); 
			ТаблицаНДС.Колонки.Добавить("ЗначениеСтавки", Новый ОписаниеТипов("Число"));
			Для Каждого СтрокаТаблицы из ТаблицаНДС Цикл 
				СтрокаТаблицы.ЗначениеСтавки = CW_Финансы.ПолучитьСтавкуНДС(СтрокаТаблицы.СтавкаНДС);
			КонецЦикла; 
			
			ТаблицаНДС.Сортировать("ЗначениеСтавки УБЫВ");
			Если ТаблицаНДС.Количество() > 0 Тогда
				СтрокаТаблицыСтавок = ТаблицаНДС[0];
				Нстр.СтавкаНДСИсходная = СтрокаТаблицыСтавок.СтавкаНДС;
			КонецЕсли;    
			
			//Сумма НДС
			Если СтрокаТОЗ.Документ.Договор.ВзаиморасчетыВУЕ Тогда  
				
				НаборЗаписей = РегистрыНакопления.CW_ДоходыПоГрузоперевозкам.СоздатьНаборЗаписей();
				НаборЗаписей.Отбор.Регистратор.Установить(СтрокаТОЗ.Документ);
				НаборЗаписей.Прочитать();
				
				СуммаНДСИсходная = 0;
				
				Если НаборЗаписей.Количество() > 0 Тогда
					мСтрокиДокумента = СтрокаТОЗ.Документ.Услуги.НайтиСтроки(ПараметрыОтбора);
					Для Каждого СтрокаДокумента из мСтрокиДокумента Цикл
						ИндексСтроки =  СтрокаТОЗ.Документ.Услуги.Индекс(СтрокаДокумента);
						
						СтрокаНабора = НаборЗаписей.Получить(ИндексСтроки); 
						СуммаНДСИсходная = СуммаНДСИсходная + СтрокаНабора.НДС;
					КонецЦикла;
				КонецЕсли;
				
				Нстр.СуммаНДСИсходная = СуммаНДСИсходная;
				
			Иначе
				Нстр.СуммаНДСИсходная = СуммаНДСИсходная;
			КонецЕсли;
			//---Сумма НДС
			
			//AFR-250054 
			Нстр.СтавкаНДС	= Нстр.СтавкаНДСИсходная;
			//AFR-250054 
			
		ИначеЕсли ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(СтрокаТОЗ.Документ.Услуги[0],"СуммаНДС") Тогда
			
			ПараметрыОтбора = Новый Структура;
			Если ТипЗнч(СтрокаТОЗ.Документ) <> Тип("ДокументСсылка.CW_РеализацияПрочихТоваровУслуг") Тогда
				ПараметрыОтбора.Вставить("СчетЗадолженности", СтрокаТОЗ.СчетЗадолженности); 
			КонецЕсли;
			
