#Область ПрограммныйИнтерфейс

// Заполняет перечень доступных возвращаемых данных.
//
// Параметры:
//  ДоступныеВозвращаемыеДанные - Соответствие - данные, доступные для получения через API
//    * Ключ - Строка - Идентификатор данных
//    * Значение - Структура - см. АсинхронноеПолучениеДанных.НовыйОписаниеВозвращаемыхДанных().
//
Процедура УстановитьДоступныеВозвращаемыеДанные(ДоступныеВозвращаемыеДанные) Экспорт
	
	ОписаниеВозвращаемыхДанных = АсинхронноеПолучениеДанных.НовыйОписаниеВозвращаемыхДанных();
	ОписаниеВозвращаемыхДанных.Наименование = НСтр("ru = 'Прочтение новости'");
	ОписаниеВозвращаемыхДанных.Описание = НСтр("ru = 'Информация о прочтении новости в другом приложении пользователя'"); 
	ОписаниеВозвращаемыхДанных.МодульМенеджер = АсинхронноеПолучениеДанныхБПНовости;
	ОписаниеВозвращаемыхДанных.ТипыРезультата.Добавить(АсинхронноеПолучениеДанныхСловарь.ТипJSON());
	
	ДоступныеВозвращаемыеДанные.Вставить(ПубликуемыйИдентификатор(), ОписаниеВозвращаемыхДанных);
	
КонецПроцедуры

// Кодирует ключи дополнительных параметров новости для JSON.
// Позволяет убрать недопустимые символы в ключе соответствия.
//
// Параметры:
//  Ключ - Строка - исходный ключ.
//
// Возвращаемое значение:
//  Строка - преобразованный ключ.
//
Функция ПреобразоватьКлючДополнительныхПараметров(Ключ) Экспорт
	
	КлючКодированный = СтрЗаменить(Ключ, "-", "_");
	
	// Имена свойств JSON, которые потом десериализуются в объект Структура, должны быть допустимыми
	// идентификаторами: не начинаться с цифры. Поэтому, если первый символ цифра - добавляем '_'.
	Если СтрНайти("0123456789", Лев(КлючКодированный, 1)) > 0 Тогда
		КлючКодированный = "_" + КлючКодированный;
	КонецЕсли;
	
	Возврат КлючКодированный;
	
КонецФункции

// Обрабатывает запрос прочтения новости от другого приложения.
// Метод вызывается HTTP-сервисом ПередачаДанных.
//
// Параметры:
//   ИдентификаторДанных - Строка - Идентификатор данных.
//   Параметры           - ДвоичныеДанные - переданные параметры получения данных.
//   КодВозврата         - Число - Код ответа, который должен вернуть HTTP-сервис.
//   Ошибка              - Булево - Устанавливается в Истина, если произошла ошибка.
//   СообщениеОбОшибке   - Строка - Описание ошибки, если она произошла.
//
// Возвращаемое значение:
//   Неопределено - не возвращаем содержательного результата - только обрабатываем входящие данные.
//
Функция ВозвращаемыеДанные(ИдентификаторДанных, Параметры, КодВозврата, Ошибка, СообщениеОбОшибке) Экспорт
	
	Если ВРег(ИдентификаторДанных) <> ВРег(ПубликуемыйИдентификатор()) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ПараметрыСтрока = ПолучитьСтрокуИзДвоичныхДанных(Параметры);
	// Корневой объект читаем в Соответствие, т.к. в подчиненных объектах могут быть коллекции однотипных объектов,
	// с которыми удобнее работать как с соответствием, чем со структурой (например, ключ - УИН новости, а значение -
	// дополнительные параметры новости).
	ПараметрыПрочтения = ОбщегоНазначения.JSONВЗначение(ПараметрыСтрока,, Истина);

	УИННовостей = ПараметрыПрочтения.Получить("УИННовостей");
	Если УИННовостей = Неопределено
		Или ТипЗнч(УИННовостей) <> Тип("Массив")
		Или УИННовостей.Количество() = 0 Тогда
		КодВозврата = АсинхронноеПолучениеДанныхСловарь.КодВозвратаОшибкаДанных();
		Ошибка = Истина;
		СообщениеОбОшибке = НСтр("ru = 'Не передан массив УИН новостей.'");
		Возврат Неопределено;
	КонецЕсли;
	
	ДополнительныеПараметры = ПараметрыПрочтения.Получить("ДополнительныеПараметры");
	
	ИдентификаторПользователяСервиса = ПараметрыПрочтения.Получить("ИдентификаторПользователяСервиса");
	
	Если Не ЗначениеЗаполнено(ИдентификаторПользователяСервиса) Тогда
		КодВозврата = АсинхронноеПолучениеДанныхСловарь.КодВозвратаОшибкаДанных();
		Ошибка = Истина;
		СообщениеОбОшибке = НСтр("ru = 'Не передан идентификатор пользователя сервиса.'");
		Возврат Неопределено;
	КонецЕсли;
	
	ИдентификаторПользователяСервиса = Новый УникальныйИдентификатор(ИдентификаторПользователяСервиса);
	
	// Метод поиска пользователя сервиса есть только в расширении в сервисе. Поэтому выполняем через Вычислить,
	// чтобы избежать ошибки компиляции.	
	ПользовательОбласти = ОбщегоНазначения.ВычислитьВБезопасномРежиме(
		"ПользователиСервиса.НайтиПользователяОбластиПоИдентификаторуПользователяСервиса(Параметры)",
		ИдентификаторПользователяСервиса);

	Если Не ЗначениеЗаполнено(ПользовательОбласти) Тогда
		КодВозврата = АсинхронноеПолучениеДанныхСловарь.КодВозвратаОшибкаДанных();
		Ошибка = Истина;
		СообщениеОбОшибке = НСтр("ru = 'Пользователь не найден по идентификатору сервиса.'");
		Возврат Неопределено;
	КонецЕсли;
	
	СписокНовостейДляПрочтения = Новый СписокЗначений;
	
	Для Каждого УИННовости Из УИННовостей Цикл
		СписокНовостей = ОбработкаНовостейСлужебный.ПолучитьНовостиПоУИН(УИННовости);
		Если СписокНовостей.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Новость = СписокНовостей[0].Значение;
		ДополнительныеПараметрыНовости = Неопределено;
		Если ТипЗнч(ДополнительныеПараметры) = Тип("Соответствие") Тогда
			КлючДополнительныхПараметров = ПреобразоватьКлючДополнительныхПараметров(УИННовости);
			ДополнительныеПараметрыНовости = ДополнительныеПараметры.Получить(КлючДополнительныхПараметров);
		КонецЕсли;
		
		Отказ = Ложь;
		ОбработкаНовостейБП.ОбработатьЗапросПрочтенияНовостиОтВнешнегоПриложения(Новость, ДополнительныеПараметрыНовости, Отказ);
		Если Не Отказ Тогда
			СписокНовостейДляПрочтения.Добавить(Новость);
		КонецЕсли;
	КонецЦикла;
	
	Если СписокНовостейДляПрочтения.Количество() > 0 Тогда
		СтруктураОтборов = Новый Структура("СписокНовостей", СписокНовостейДляПрочтения);
		ЗначенияСостояний = Новый Структура("Прочтена, ОповещениеВключено", Истина, Ложь);
		
		ОбработкаНовостей.УстановитьСостояниеНовостейДляПользователей(
			ПользовательОбласти, СтруктураОтборов, ЗначенияСостояний);
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

// Возвращает идентификатор данных о прочтении новости для вызова через внешний программный интерфейс.
//
// Возвращаемое значение:
//   Строка - идентификатор данных о прочтении новости.
//
Функция ПубликуемыйИдентификатор() Экспорт
	
	Возврат "news_read";
	
КонецФункции

