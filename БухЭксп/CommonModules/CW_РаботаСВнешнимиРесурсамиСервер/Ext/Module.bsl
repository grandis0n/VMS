			Модуль_CW_ОбщийМодульЛичныйКабинетСервер.ПолучитьШаблоныТекстовHTTPЗапросов(Результат);	
		КонецЕсли;	
		//Подсистема.CW_ЛичныйКабинетКлиента      
		
	КонецЕсли;	
	//Подсистема.CW_БухгалтерияЭкспедитора

	//Подсистема.CW_БухгалтерияЭкспедитораДляРоссии 
	Если CW_ВерсииПодсистемСервер.СуществуетПодсистема("CW_БухгалтерияЭкспедитораДляРоссии") Тогда  	Модуль_CW_БухгалтерияЭкспедитораДляРоссииСервер = CW_ОбщегоНазначения.ОбщийМодуль("CW_БухгалтерияЭкспедитораДляРоссииСервер");
		Модуль_CW_БухгалтерияЭкспедитораДляРоссииСервер.ПолучитьШаблоныТекстовHTTPЗапросов(Результат);
		
		//Подсистема.CW_РеестрыНДС0 
