	Результат.Вставить("main_checkreg",			"/%1/hs/main/checkreg");
	Результат.Вставить("main_checkuser",		"/%1/hs/main/checkuser"); 
	Результат.Вставить("main_checkconnect",		"/%1/hs/main/checkconnect");
 	Результат.Вставить("main_testconnection", 	"/%1/hs/main/testconnection");
	
	Результат.Вставить("main_sendpin", 			"/%1/hs/main/sendpin");
	Результат.Вставить("main_checkpin", 		"/%1/hs/main/checkpin");  
	Результат.Вставить("main_blockpin",			"/%1/hs/main/blockpin"); 
	
 	Результат.Вставить("main_getinvoices",		"/%1/hs/main/getinvoices");
	Результат.Вставить("main_paymentinvoice",	"/%1/hs/main/paymentinvoice");
 	Результат.Вставить("main_cancelinvoices",	"/%1/hs/main/cancelinvoices"); 
	Результат.Вставить("main_printing",			"/%1/hs/main/printing");

    Результат.Вставить("main_getrates",			"/%1/hs/main/getrates"); 

КонецПроцедуры   


Функция ПрочитатьHTTPСервисВОбъект(HTTPЗапросОтвет) Экспорт
	
	СтрокаJSON = HTTPЗапросОтвет.ПолучитьТелоКакСтроку();
	ДанныеJSON = СтрокаJSONВОбъект(СтрокаJSON);
	
	Возврат ДанныеJSON;
	
КонецФункции

Функция ПодготовитьHTTPЗапрос(ИмяHTTPСервиса, ОбъектДляЗаписи)  Экспорт
	
	ПараметрыПодклчюения 		 = CW_РаботаСВнешнимиРесурсамиСервер.ПолучитьСтруктуруПараметровПодключенияПользователя();
	УказаныРегистрационныеДанные = ЗначениеЗаполнено(ПараметрыПодклчюения.Пользователь) И ЗначениеЗаполнено(ПараметрыПодклчюения.Пароль);

	HTTPСоединение				= CW_РаботаСВнешнимиРесурсамиСервер.СоздатьHTTPСоединение(ПараметрыПодклчюения);

	ШаблоныТекстаHTTPЗапроса 	= CW_РаботаСВнешнимиРесурсамиСервер.ПолучитьШаблоныТекстовHTTPЗапросов();
	ШаблонТекстаHTTPЗапроса 	= ШаблоныТекстаHTTPЗапроса.получить(ИмяHTTPСервиса);   
	ТекстHTTPЗапроса 			= СтрШаблон(ШаблонТекстаHTTPЗапроса, ПараметрыПодклчюения.ИмяБазыДанных);
	
	СтрокаJSON = ОбъектВСтрокуJSON(ОбъектДляЗаписи);

	HTTPЗапрос = Новый HTTPЗапрос(ТекстHTTPЗапроса);	
	HTTPЗапрос.УстановитьТелоИзСтроки(СтрокаJSON);

	
	ПараметрыЗапроса = Новый Структура;
	ПараметрыЗапроса.Вставить("HTTPСоединение", HTTPСоединение);
	ПараметрыЗапроса.Вставить("HTTPЗапрос", 	HTTPЗапрос);  
	ПараметрыЗапроса.Вставить("УказаныРегистрационныеДанные", 	УказаныРегистрационныеДанные);  
	
	Возврат ПараметрыЗапроса; 
	
КонецФункции

Функция Ответ(КодСостояния, Заголовки = Неопределено, Type="json") Экспорт
	
	Ответ = Новый HTTPСервисОтвет(КодСостояния);
	Ответ.Заголовки.Вставить("Accept-Charset", "utf-8");
	Ответ.Заголовки.Вставить("Content-Type", "application/"+Type+";charset=utf-8");
	Ответ.Заголовки["Cache-Control"] = "no-cache";
	
	Если ТипЗнч(Заголовки) = Тип("Структура") Тогда
		Для каждого КлючЗначение из Заголовки Цикл
			Ответ.Заголовки.Вставить(КлючЗначение.Ключ, XMLСтрока(КлючЗначение.Значение));	
		КонецЦикла;
	КонецЕсли;
	
	Возврат Ответ;
	
КонецФункции


//JSON
Функция СтрокаJSONВОбъект(СтрокаJSON, ПрочитатьВСоответствие=Ложь) Экспорт
	
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(СтрокаJSON);  
	
	ОбъектJSON = ПрочитатьJSON(ЧтениеJSON, ПрочитатьВСоответствие);
	ЧтениеJSON.Закрыть();  
	
	Возврат ОбъектJSON;
	
КонецФункции

Функция ОбъектВСтрокуJSON(Знач ОбъектДляЗаписи) Экспорт
	
	ПараметрыЗаписиJSON =  Новый ПараметрыЗаписиJSON(,Символы.Таб);	  
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.ПроверятьСтруктуру = Ложь;
	ЗаписьJSON.УстановитьСтроку(ПараметрыЗаписиJSON);
	
	ЗаписатьJSON(ЗаписьJSON, ОбъектДляЗаписи);
	
	СтрокаJSON = ЗаписьJSON.Закрыть();
	
	Возврат СтрокаJSON;
	
КонецФункции
//JSON


Функция СоздатьHTTPСоединение(ПараметрыПодключения) Экспорт
	
	ssl = Неопределено;
	Если ПараметрыПодключения.ssl Тогда
		ssl = Новый ЗащищенноеСоединениеOpenSSL();
	КонецЕсли;
	
	Таймаут = Неопределено;
	ПараметрыПодключения.Свойство("Таймаут", Таймаут);
	
	Если ТипЗнч(Таймаут) <> Тип("Число") Тогда
		Таймаут = 180;
	КонецЕсли;
	
	Соединение = Новый HTTPСоединение(	ПараметрыПодключения.Сервер,
	ПараметрыПодключения.Порт,
	ПараметрыПодключения.Пользователь,
	ПараметрыПодключения.Пароль,
	,
	Таймаут,
	ssl);
	Возврат Соединение;
	
КонецФункции 

Функция ПроверитьПодключениеНаСервере() Экспорт
	
	ПараметрыПодклчюения 		= CW_РаботаСВнешнимиРесурсамиСервер.ПолучитьСтруктуруПараметровПодключенияПользователя();
	HTTPСоединение				= CW_РаботаСВнешнимиРесурсамиСервер.СоздатьHTTPСоединение(ПараметрыПодклчюения);
	ШаблоныТекстаHTTPЗапроса 	= CW_РаботаСВнешнимиРесурсамиСервер.ПолучитьШаблоныТекстовHTTPЗапросов();
	
	ШаблонТекстаHTTPЗапроса 	= ШаблоныТекстаHTTPЗапроса.получить("main_testconnection"); 
	ТекстHTTPЗапроса 			= СтрШаблон(ШаблонТекстаHTTPЗапроса,ПараметрыПодклчюения.ИмяБазыДанных); 
	
	HTTPЗапрос = Новый HTTPЗапрос(ТекстHTTPЗапроса);	
	Ответ = CW_РаботаСВнешнимиРесурсамиСервер.ПолучитьДанныеССервера(HTTPСоединение, HTTPЗапрос, "GET"); 
	Если Ответ = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат Ответ.КодСостояния;
	
КонецФункции

Функция ПолучитьДанныеССервера(HTTPСоединение, HTTPЗапрос, Тип) Экспорт
	 
	Попытка  
		Если Тип = "GET" Тогда
			Ответ = HTTPСоединение.Получить(HTTPЗапрос);  
		КонецЕсли;
		Если Тип = "POST" Тогда
			Ответ = HTTPСоединение.ОтправитьДляОбработки(HTTPЗапрос);  
		КонецЕсли;
	Исключение 
		Возврат Неопределено;
	КонецПопытки;
	
	Возврат Ответ;
	
КонецФункции



Функция ПолучитьСтруктуруПараметровПодключенияПользователя() Экспорт
	
	СоздатьПараметрыПодключенияСервиса();
	
	ЛогинПароль = ПолучитьЛогинПарольПользователя();
	
	Сервер 			= Константы.CW_ЛичныйКабинетИмяСервера.Получить();
	Порт 			= Константы.CW_ЛичныйКабинетПортСервера.Получить();
	ИмяБазыДанных 	= Константы.CW_ЛичныйКабинетИмяБазыДанных.Получить();
	ssl             = Константы.CW_ЛичныйКабинетЗащищенноеСоединение.Получить();
	
	СтруктураПараметров = Новый Структура("Сервер,Порт,ssl,ИмяБазыДанных,Пользователь,Пароль",Сервер,Порт,ssl,ИмяБазыДанных,ЛогинПароль.Логин,ЛогинПароль.Пароль);
	
	Возврат СтруктураПараметров;
	
КонецФункции  

Процедура СоздатьПараметрыПодключенияСервиса() Экспорт
	
	//Установка констант
	Если Не ПараметрыАвторизацииСервисаЗаполнены() Тогда
		Константы.CW_ЛичныйКабинетИмяСервера.Установить("aflk.coralway.ru");
		Константы.CW_ЛичныйКабинетПортСервера.Установить(443);
		Константы.CW_ЛичныйКабинетИмяБазыДанных.Установить("cabinet");
		Константы.CW_ЛичныйКабинетЗащищенноеСоединение.Установить(Истина);
	КонецЕсли;
	
КонецПроцедуры 

Функция ПараметрыАвторизацииСервисаЗаполнены() Экспорт
	
	ЗначениеИмяСервера 		= Константы.CW_ЛичныйКабинетИмяСервера.Получить();
	ЗначениеПортСервера 	= Константы.CW_ЛичныйКабинетПортСервера.Получить();
	ЗначениеИмяБазыДанных 	= Константы.CW_ЛичныйКабинетИмяБазыДанных.Получить();

	Возврат ЗначениеЗаполнено(ЗначениеИмяСервера) и ЗначениеЗаполнено(ЗначениеПортСервера) и ЗначениеЗаполнено(ЗначениеИмяБазыДанных);
	
КонецФункции

Функция ПроверитьПараметрыАвторизацииНаСервереТехподдрежки() Экспорт
	
	Возврат CW_МониторПорталаПоддержкиСервер.ЗаполненыДанныеАутентификацииПользователяИнтернетПоддержки();

КонецФункции

Функция ПолучитьЛогинПарольПользователя() Экспорт
	
	Результат = CW_МониторПорталаПоддержкиСервер.ДанныеАутентификацииПользователяИнтернетПоддержки();
	Если Результат = Неопределено Тогда
		Результат = Новый Структура("Логин,Пароль",Неопределено,Неопределено);
	КонецЕсли;	

	Возврат Результат;
	
КонецФункции

