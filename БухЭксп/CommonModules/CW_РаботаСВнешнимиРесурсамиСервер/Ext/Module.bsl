			Модуль_CW_РеестрыНДС0Сервер = CW_ОбщегоНазначения.ОбщийМодуль("CW_РеестрыНДС0Сервер");
			Модуль_CW_РеестрыНДС0Сервер.ПолучитьШаблоныТекстовHTTPЗапросов(Результат);	
		КонецЕсли; 	 
