Функция ГруппаПользователя(Пользователь) Экспорт 
	// --- 
	//Попытка
	//	// проверяем, нет ли у него полных прав
	//	ИП = Пользователь.ИдентификаторПользователяИБ;
	//	ПользовательИБ = ПользователиИнформационнойБазы.НайтиПоУникальномуИдентификатору(ИП);
	//	Если ПользовательИБ.Роли.Содержит(Метаданные.Роли.ПолныеПрава) Тогда
	//		Возврат(Справочники.CW_ГруппыПользователей.Администраторы);
	//	КонецЕсли; 
	//Исключение
	//КонецПопытки;
	
	Если CW_ПраваДоступа.ЭтоПолноправныйПользователь(Пользователь,Истина) Тогда
		Возврат Справочники.CW_ГруппыПользователей.Администраторы;
	КонецЕсли;
	
	//полных прав нет, проеряем группу пользователя
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	CW_ПараметрыПользователей.Группа
	|ИЗ
	|	РегистрСведений.CW_ПараметрыПользователей КАК CW_ПараметрыПользователей
	|ГДЕ
	|	CW_ПараметрыПользователей.Пользователь = &Пользователь";
	Запрос.УстановитьПараметр("Пользователь", Пользователь);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если Не РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		Если Выборка.Следующий() Тогда
			 Возврат Выборка.Группа;
		КонецЕсли;
	КонецЕсли; 
	
	//Пользователь не включен ни в одну группу!!!
	Возврат(Справочники.CW_ГруппыПользователей.ПустаяСсылка());
	
	// --- 
КонецФункции

