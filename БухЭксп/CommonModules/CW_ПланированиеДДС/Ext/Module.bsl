
Процедура CW_ПланированиеРасходовДДСОбработкаПроведения(Источник, Отказ, РежимПроведения) Экспорт
	
	Если Не ПолучитьФункциональнуюОпцию("CW_ИспользуетсяБлокПланированиеДДС") 
		ИЛИ Не Источник.ПредъявленСчет Тогда
		Возврат;
	КонецЕсли;

	Если БлокировкаАвтогенерацииЗаявокНаОплату(Источник) Тогда  
		Возврат;
	КонецЕсли;
	
	//Параметры планирования
	ПараметрыПланирования = РегистрыСведений.CW_ПараметрыПланированияДДС.ПолучитьПараметрыПланирования(Источник.Организация,Источник.ДатаСчета);
	Если ПараметрыПланирования = Неопределено Тогда 
		Возврат;
	КонецЕсли; 
	
	Если НЕ ПараметрыПланирования.ИспользоватьАвтоматическоеПланирование Тогда
		Возврат;
	КонецЕсли;   
	
	//Исключим внутрихолдинг
	Если Не ПараметрыПланирования.ВключатьВнутрихолдинговыеРасходы Тогда
		КонтрагентВходитВХолдинг = РегистрыСведений.CW_СоответствиеОрганизацийКонтрагентам.КонтрагентВходитВХолдинг(Источник.Контрагент);
		Если КонтрагентВходитВХолдинг Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
		
	СуммаДокумента = Источник.СуммаДокумента - Источник.ЗачетАвансовОЗ.Итог("СуммаЗачета");
	
	Если Не СуммаДокумента > 0 Тогда 
		Возврат;
	КонецЕсли; 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 	"ВЫБРАТЬ
	               	|	CW_ПланированиеДДС.Ссылка КАК Ссылка
	               	|ИЗ
	               	|	Справочник.CW_ПланированиеДДС КАК CW_ПланированиеДДС
	               	|ГДЕ
	               	|	(ВЫРАЗИТЬ(CW_ПланированиеДДС.ДокументОснование КАК Документ.CW_РасходыПоГрузоперевозке)) = &ДокументОснование";
	
	Запрос.УстановитьПараметр("ДокументОснование", Источник.Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если НЕ РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли; 
	
	ОбъектСтатья					= Справочники.CW_ПланированиеДДС.СоздатьЭлемент();
	ОбъектСтатья.СтатьяДДС			= ПараметрыПланирования.РасходыСтатьяДДС;
	ОбъектСтатья.СрокОплаты			= CW_Документы.ПолучитьСрокОплаты(Источник.Ссылка).ДатаОплаты;
	ОбъектСтатья.Дата				= ТекущаяДата();
	ОбъектСтатья.Автор				= Источник.Ответственный;
	
	Если Источник.Услуги.количество() <> 0 Тогда
		Грузоперевозка = Источник.Услуги[0].Грузоперевозка;
		Если ЗначениеЗаполнено(Грузоперевозка) Тогда
			ИмяРеквизитаИнициатор 	= ОбщегоНазначения.ИмяЗначенияПеречисления(ПараметрыПланирования.РасходыИнициаторПоЗаявке);	
			Инициатор				= Грузоперевозка[ИмяРеквизитаИнициатор];
			ОбъектСтатья.Инициатор	= Инициатор;
			
			Если ПолучитьФункциональнуюОпцию("CW_ИспользованиеОфисовКомпании") Тогда
				ОбъектСтатья.Офис	= ПолучитьОфис(Инициатор);
			КонецЕсли;
			
			Если ПолучитьФункциональнуюОпцию("CW_ИспользованиеПодразделенийКомпании") Тогда
				ОбъектСтатья.Подразделение	= ПолучитьПодразделение(Источник.Ссылка, Инициатор);
			КонецЕсли;
			
		КонецЕсли;
	КонецЕсли;

	ОбъектСтатья.Сценарий			= ПараметрыПланирования.РасходыСценарий;
	ОбъектСтатья.ВидДвижения		= Перечисления.CW_ВидыДвиженияДДС.Расход;
	ОбъектСтатья.ДокументОснование	= Источник.Ссылка;
	ОбъектСтатья.ОснованиеОплаты	= Источник.ПредставлениеДокумента;
	ОбъектСтатья.Содержание 		= CW_Шаблоны.ОбработатьШаблонНоменклатуры(ПараметрыПланирования.ШаблонЗаполненияСодержания,  Источник.Ссылка, Неопределено, Источник.Ссылка.Услуги);
	
	ОбъектСтатья.ВидОперацииПлатежногоПоручения	= ПараметрыПланирования.ОсновнойВидОперацииПлатежногоПоручения;
	
	СуммаНДСДокумента = Источник.Услуги.Итог("НДС");
	
	Если Источник.Договор.ВзаиморасчетыВУЕ Тогда
		СтруктураКурса = CW_Финансы.ПолучитьКурсВалюты(Источник.Валюта,Источник.ДатаСчета);
		
		ОбъектСтатья.Валюта		= Константы.ВалютаРегламентированногоУчета.Получить();
		ОбъектСтатья.Сумма		= СуммаДокумента * СтруктураКурса.Курс / СтруктураКурса.Кратность;
		ОбъектСтатья.СуммаНДС 	= СуммаНДСДокумента * СтруктураКурса.Курс / СтруктураКурса.Кратность;
	Иначе
		ОбъектСтатья.Валюта	 = Источник.Валюта;
		ОбъектСтатья.Сумма	 = СуммаДокумента;
		ОбъектСтатья.СуммаНДС = СуммаНДСДокумента;
	КонецЕсли; 
	
	
	// заполнение ставки НДС
	ТаблицаУслуг = Источник.Услуги.Выгрузить();
	ТаблицаУслуг.Свернуть("СтавкаНДС", "НДС"); 
	
	мСтавкиНДС = ТаблицаУслуг.ВыгрузитьКолонку("СтавкаНДС");
	
	СуммаНДСПоДокументу = ТаблицаУслуг.Итог("НДС"); 
	Если СуммаНДСПоДокументу = 0 Тогда
		Если мСтавкиНДС.Найти(Перечисления.СтавкиНДС.НДС0)<> Неопределено Тогда
			ОбъектСтатья.СтавкаНДС = Перечисления.СтавкиНДС.НДС0;  
		Иначе
			ОбъектСтатья.СтавкаНДС = Перечисления.СтавкиНДС.БезНДС;
		КонецЕсли;
	Иначе 
		ИндексНДС0 = мСтавкиНДС.Найти(Перечисления.СтавкиНДС.НДС0);
		Если ИндексНДС0 <> Неопределено Тогда
			мСтавкиНДС.Удалить(ИндексНДС0);
		КонецЕсли;
		ИндексБезНДС = мСтавкиНДС.Найти(Перечисления.СтавкиНДС.БезНДС);
		Если ИндексБезНДС <> Неопределено Тогда
			мСтавкиНДС.Удалить(ИндексБезНДС);
		КонецЕсли;
		
		Если мСтавкиНДС.Количество() = 0 Тогда
			ОбъектСтатья.СтавкаНДС = CW_БухгалтерияЭкспедитораДляРоссииСервер.СтавкаНДСПоВидуСтавки(Перечисления.ВидыСтавокНДС.Общая, Источник.Дата);
		Иначе
			ОбъектСтатья.СтавкаНДС = мСтавкиНДС.Получить(0);
		КонецЕсли;
	КонецЕсли;
	
	

	ЗаполнитьЗначенияСвойств(ОбъектСтатья,Источник,"Организация,Контрагент,Договор");
	
	ОбъектСтатья.Записать();
	
	РегистрыСведений.CW_СтатусыПланированиеДДС.ЗаписатьСтатусВРегистр(ОбъектСтатья.Ссылка, ПредопределенноеЗначение("Перечисление.CW_СтатусыПланированияДДС.План"));

КонецПроцедуры   

Функция БлокировкаАвтогенерацииЗаявокНаОплату(Источник)
	
	ИсточникБлокировки =   Источник.Договор;
	Если ЗначениеЗаполнено(Источник.ПриложениеКДоговору) Тогда
		ИсточникБлокировки = Источник.ПриложениеКДоговору;
	КонецЕсли;
	
	Возврат ИсточникБлокировки.БлокироватьАвтогенерациюЗаявокНаОплату;
	
КонецФункции

Функция ПолучитьПодразделение(Ссылка, Пользователь = Неопределено) Экспорт
	
	Подразделение = Неопределено;
	
	Если Константы.CW_ИспользованиеПодразделенийКомпании.Получить() Тогда
		
		ПараметрПодразделениеКомпании = Константы.CW_ПараметрПодразделениеКомпании.Получить();
		
		Если Не ПараметрПодразделениеКомпании.Пустая() Тогда
			
			Запрос = Новый Запрос;
			Запрос.Текст =  "ВЫБРАТЬ ПЕРВЫЕ 1
			                |	МАКСИМУМ(CW_ХарактеристикиГрузоперевозок.Значение) КАК Подразделение
			                |ИЗ
			                |	Документ.CW_РасходыПоГрузоперевозке.Услуги КАК CW_РасходыПоГрузоперевозкеУслуги
			                |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.CW_ХарактеристикиГрузоперевозок КАК CW_ХарактеристикиГрузоперевозок
			                |		ПО CW_РасходыПоГрузоперевозкеУслуги.Грузоперевозка = CW_ХарактеристикиГрузоперевозок.Грузоперевозка
			                |ГДЕ
			                |	CW_РасходыПоГрузоперевозкеУслуги.Ссылка = &Ссылка
			                |	И CW_ХарактеристикиГрузоперевозок.Параметр = &Параметр";
			
			Запрос.УстановитьПараметр("Ссылка", 	Ссылка);
			Запрос.УстановитьПараметр("Параметр", 	ПараметрПодразделениеКомпании);
			
			Выборка = Запрос.Выполнить().Выбрать();
			
			Если Выборка.Следующий() Тогда
				Подразделение =  Выборка.Подразделение;
			КонецЕсли;
			
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(Подразделение) Тогда 
			Если Пользователь = Неопределено Тогда
				Пользователь = ПараметрыСеанса.ТекущийПользователь;
			КонецЕсли;
			
			Подразделение =  ПолучитьПодразделениеМенеджера(Пользователь);
		КонецЕсли; 
		
	КонецЕсли; 
	
	Возврат Подразделение;
	
КонецФункции

Функция ПолучитьПодразделениеМенеджера(Пользователь) Экспорт
	
	Если ТипЗнч(Пользователь) = Тип("СправочникСсылка.Пользователи") Тогда
		Менеджер = Пользователь.ФизическоеЛицо;
	Иначе
		Менеджер = Пользователь;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 	"ВЫБРАТЬ
	               	|	CW_ДействующиеМенеджеры.Менеджер КАК Менеджер,
	               	|	CW_ДействующиеМенеджеры.ПодразделениеКомпании КАК ПодразделениеКомпании
	               	|ИЗ
	               	|	РегистрСведений.CW_ДействующиеМенеджеры КАК CW_ДействующиеМенеджеры
	               	|ГДЕ
	               	|	CW_ДействующиеМенеджеры.Менеджер = &Менеджер";
	
	Запрос.УстановитьПараметр("Менеджер", Менеджер);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий(); 
	
	Возврат Выборка.ПодразделениеКомпании
	
КонецФункции

Функция ПолучитьОфис(Пользователь) Экспорт
	
	Если Константы.CW_ИспользованиеОфисовКомпании.Получить() Тогда
		
		Если ТипЗнч(Пользователь) = Тип("СправочникСсылка.Пользователи") Тогда
			Менеджер = Пользователь.ФизическоеЛицо;
		Иначе
			Менеджер = Пользователь;
		КонецЕсли;
		
		Запрос = Новый Запрос;
		Запрос.Текст = 	"ВЫБРАТЬ
		|	CW_ДействующиеМенеджеры.Менеджер КАК Менеджер,
		|	CW_ДействующиеМенеджеры.ОфисКомпании КАК ОфисКомпании
		|ИЗ
		|	РегистрСведений.CW_ДействующиеМенеджеры КАК CW_ДействующиеМенеджеры
		|ГДЕ
		|	CW_ДействующиеМенеджеры.Менеджер = &Менеджер";
		
		Запрос.УстановитьПараметр("Менеджер", Менеджер);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Выборка.Следующий(); 
		
		Возврат Выборка.ОфисКомпании
		
	КонецЕсли; 
	
	Возврат Неопределено;

КонецФункции

Функция ПросмотрСтатейДДС(ГруппаПользователя) Экспорт 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 	"ВЫБРАТЬ
	               	|	CW_ПраваДоступаДляСтатейДДС.СтатьяДДС КАК СтатьяДДС
	               	|ИЗ
	               	|	РегистрСведений.CW_ПраваДоступаДляСтатейДДС КАК CW_ПраваДоступаДляСтатейДДС
	               	|ГДЕ
	               	|	CW_ПраваДоступаДляСтатейДДС.ГруппаПользователя = &ГруппаПользователя";
	
	Запрос.УстановитьПараметр("ГруппаПользователя", ГруппаПользователя);
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("СтатьяДДС");
КонецФункции

Функция ИспользованиеСтатейДДС(ГруппаПользователя, ВидДвижения=Неопределено) Экспорт 
	
	Результат = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	CW_СтатьиДДС.Ссылка КАК Ссылка
	|ИЗ
	|	РегистрСведений.CW_ПраваДоступаДляСтатейДДС КАК CW_ПраваДоступаДляСтатейДДС
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.CW_СтатьиДДС КАК CW_СтатьиДДС
	|		ПО CW_ПраваДоступаДляСтатейДДС.СтатьяДДС = CW_СтатьиДДС.Ссылка
	|ГДЕ
	|	CW_ПраваДоступаДляСтатейДДС.ГруппаПользователя = &ГруппаПользователя
	|	И CW_ПраваДоступаДляСтатейДДС.Использование";
	
	Если ВидДвижения <> Неопределено Тогда
		Запрос.Текст = Запрос.Текст  + " 
		|	И CW_СтатьиДДС.ВидДвижения = &ВидДвижения";
	КонецЕсли;	
	
	Запрос.Текст = Запрос.Текст  +  "
	|	И CW_СтатьиДДС.ПометкаУдаления = ЛОЖЬ";
	
	Запрос.УстановитьПараметр("ГруппаПользователя", ГруппаПользователя);
	Запрос.УстановитьПараметр("ВидДвижения", ВидДвижения);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Результат.Добавить(Выборка.Ссылка);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьвсеСтатьиДДС(ВидДвижения=Неопределено) Экспорт 
	
	Результат = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	CW_СтатьиДДС.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.CW_СтатьиДДС КАК CW_СтатьиДДС
	               |ГДЕ
	               |	CW_СтатьиДДС.ПометкаУдаления = ЛОЖЬ";
	
	Если ВидДвижения <> Неопределено Тогда
		Запрос.Текст = Запрос.Текст  + " 
		|	И CW_СтатьиДДС.ВидДвижения = &ВидДвижения";
	КонецЕсли;	
	
	Запрос.УстановитьПараметр("ВидДвижения", ВидДвижения);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Результат.Добавить(Выборка.Ссылка);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции
	
	
Функция ИспользованиеСтатьиДДС(ГруппаПользователя,СтатьяДДС) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	CW_ПраваДоступаДляСтатейДДС.Использование КАК Использование
		|ИЗ
		|	РегистрСведений.CW_ПраваДоступаДляСтатейДДС КАК CW_ПраваДоступаДляСтатейДДС
		|ГДЕ
		|	CW_ПраваДоступаДляСтатейДДС.ГруппаПользователя = &ГруппаПользователя
		|	И CW_ПраваДоступаДляСтатейДДС.СтатьяДДС = &СтатьяДДС";
	Запрос.УстановитьПараметр("ГруппаПользователя", ГруппаПользователя);
	Запрос.УстановитьПараметр("СтатьяДДС", СтатьяДДС);
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Ложь
	Иначе
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		Возврат Выборка.Использование
	КонецЕсли; 
КонецФункции

Функция ПредставлениеПериодаДДС(Период,Детализация,Язык) Экспорт
	Если Детализация = "День" Тогда
		Возврат Формат(Период,"ДФ=dd.MM.yyyy")
	ИначеЕсли Детализация = "Неделя" Тогда
		Возврат "(" + НеделяГода(Период) + ")" + " " + Формат(Период,"ДФ=MM.yyyy");
	ИначеЕсли Детализация = "Квартал" Тогда
		Возврат Формат(Период,"ДФ=к") + ?(Язык = Справочники.CW_Языки.ru," кв. "," qr. ") + Формат(Период,"ДФ=yyyy");
	ИначеЕсли Детализация = "Месяц" Тогда
		Возврат Формат(Период,"ДФ=MM.yyyy")
	ИначеЕсли Детализация = "Год" Тогда
		Возврат Формат(Период,"ДФ=yyyy");
	КонецЕсли; 
КонецФункции
 
