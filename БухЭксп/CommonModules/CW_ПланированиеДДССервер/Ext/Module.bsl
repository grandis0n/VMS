Процедура ПриСозданииНаСервере(Форма, Отказ, СтандартнаяОбработка) Экспорт
	
	Элементы = Форма.Элементы;
	Объект 	 = Форма.Объект;
	
	УстановитьПараметрФункциональнойОпции(Форма);	
	УстановитьОтборДинамическогоСписка(Форма.Заявки.Отбор, Объект.Ссылка);
	ОбновитьЗаголовокСтраницыЗаявок(Элементы, Объект.Ссылка);
	
КонецПроцедуры

Процедура ПослеЗаписиНаСервере(Форма, ТекущийОбъект, ПараметрыЗаписи) Экспорт
	
	Элементы = Форма.Элементы;
	Объект 	 = Форма.Объект;

	УстановитьОтборДинамическогоСписка(Форма.Заявки.Отбор, Объект.Ссылка);
	ОбновитьЗаголовокСтраницыЗаявок(Элементы, Объект.Ссылка);
	
КонецПроцедуры

Процедура ОбновитьЗаголовокСтраницыЗаявок(Элементы, Ссылка) Экспорт
	
	//Определяем исходный заголовок
	НачальныйЗаголовок 	= Элементы.СтраницаЗаявки.Заголовок;
	ПозСкобки 			= СтрНайти(НачальныйЗаголовок,"(");
	Если ПозСкобки > 0 Тогда
		НачальныйЗаголовок 	= СокрЛП(Лев(НачальныйЗаголовок, ПозСкобки-1));
	КонецЕсли;
	
	КоличестоЗаявок = Справочники.CW_ПланированиеДДС.ПолучитьКоличествоЗаявокПоОбъекту(?(Ссылка.Пустая(), Неопределено, Ссылка));
	Элементы.СтраницаЗаявки.Заголовок = НачальныйЗаголовок +?(КоличестоЗаявок=0,""," ("+Формат(КоличестоЗаявок,"ЧГ=0")+")")
	
КонецПроцедуры

Процедура УстановитьОтборДинамическогоСписка(Отбор, Ссылка)  Экспорт
	
	Отбор.Элементы.Очистить();
	
	НовЭлементОтбора = Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	НовЭлементОтбора.ЛевоеЗначение 		= Новый ПолеКомпоновкиДанных("Основание"); 
	НовЭлементОтбора.ВидСравнения 		= ВидСравненияКомпоновкиДанных.Равно; 
	НовЭлементОтбора.Использование 		= Истина; 
	НовЭлементОтбора.ПравоеЗначение 	= ?(Ссылка.Пустая(), Неопределено, Ссылка);
	НовЭлементОтбора.РежимОтображения 	= РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;
	
КонецПроцедуры

Процедура УстановитьПараметрФункциональнойОпции(Форма) Экспорт
	
	Объект =  Форма.Объект;
	
	УстанавиливаемыеПараметры = Новый Структура("CW_ГруппаПользователя", CW_ПраваДоступа_ПИ.ГруппаПользователя(ПараметрыСеанса.ТекущийПользователь));
	Форма.УстановитьПараметрыФункциональныхОпцийФормы(УстанавиливаемыеПараметры);
	
КонецПроцедуры

Функция ПолучитьДанныеДоговора(Договор) Экспорт
	
	Результат = Новый Структура("Валюта,ВалютаДоговора, РасчетыВУсловныхЕдиницах", Неопределено, Неопределено, Ложь);
	
	Если Не ЗначениеЗаполнено(Договор) Тогда
		Возврат Результат;
	КонецЕсли;
	
	ВалютаРегламентированногоУчета = Константы.ВалютаРегламентированногоУчета.Получить();
	
	Запрос = Новый Запрос;
	
	Если ТипЗнч(Договор) = Тип("СправочникСсылка.CW_ДоговорыПоГрузоперевозкам") Тогда
		
		Запрос.Текст = 	"ВЫБРАТЬ
		|	CW_ДоговорыПоГрузоперевозкам.ВалютаДоговора КАК ВалютаДоговора,
		|	CW_ДоговорыПоГрузоперевозкам.ВзаиморасчетыВУЕ КАК РасчетыВУсловныхЕдиницах
		|ИЗ
		|	Справочник.CW_ДоговорыПоГрузоперевозкам КАК CW_ДоговорыПоГрузоперевозкам
		|ГДЕ
		|	CW_ДоговорыПоГрузоперевозкам.Ссылка = &Договор";
		
	ИначеЕсли  ТипЗнч(Договор) = Тип("СправочникСсылка.ДоговорыКонтрагентов") Тогда
		
		Запрос.Текст = 	"ВЫБРАТЬ
		|	ДоговорыКонтрагентов.ВалютаВзаиморасчетов КАК ВалютаДоговора,
		|	ДоговорыКонтрагентов.РасчетыВУсловныхЕдиницах КАК РасчетыВУсловныхЕдиницах
		|ИЗ
		|	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
		|ГДЕ
		|	ДоговорыКонтрагентов.Ссылка = &Договор";
		
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Договор", Договор);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(Результат, Выборка);
		Если Выборка.РасчетыВУсловныхЕдиницах Тогда
			Результат.Валюта = ВалютаРегламентированногоУчета;
		Иначе
			Результат.Валюта = Выборка.ВалютаДоговора;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции
