// Возвращает процент НДС по строковому представлению ставки НДС .
// 
// Параметры:
//  СтавкаНДС - строка - строковое представление ставки НДС
// 
// Возвращаемое значение:
//  Число - процент ставки НДС
Функция ЗначениеСтавкиНДС(СтавкаНДС) Экспорт
	
	Если СтавкаНДС = "10" Или СтавкаНДС = "10/110" Тогда
		Возврат 10;
	ИначеЕсли СтавкаНДС = "18" Или СтавкаНДС = "18/118" Тогда
		Возврат 18;
	ИначеЕсли СтавкаНДС = "20" Или СтавкаНДС = "20/120" Тогда
		Возврат 20;
	ИначеЕсли СтавкаНДС = "22" Или СтавкаНДС = "22/122" Тогда
		Возврат 22;
	ИначеЕсли СтавкаНДС = "5" Или СтавкаНДС = "5/105" Тогда
		Возврат 5;
	ИначеЕсли СтавкаНДС = "7" Или СтавкаНДС = "7/107" Тогда
		Возврат 7;
	Иначе
		Возврат 0;
	КонецЕсли;
	
КонецФункции

