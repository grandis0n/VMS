Функция НашиРеквизиты_НаОсновании(ОбъектПечати) Экспорт 
	
	Если ТипЗнч(ОбъектПечати) = Тип("СправочникСписок.CW_ДоговорыПоГрузоперевозкам") Тогда
		ДатаСведений =  ОбъектПечати.ДатаДоговора;
	КонецЕсли;
	Если ТипЗнч(ОбъектПечати) = Тип("СправочникСписок.CW_ПриложенияКДоговорам") Тогда
		ДатаСведений =  ОбъектПечати.ДатаДокумента;
	КонецЕсли;
	
	СтруктурПараметров = Новый Структура;
	СтруктурПараметров.Вставить("Дата", ДатаСведений);
	СтруктурПараметров.Вставить("Договор", ОбъектПечати);
	
	ПараметрыДоговора = CW_Настройки.ПолучитьПараметрыДоговора(СтруктурПараметров);
	
	Если ПараметрыДоговора.РежимПодписей = 0 Тогда
		ПараметрыСведений 		= ПолучитьПараметрыПолученияСведенийОбОрганизацииКонтрагенте(ОбъектПечати);
		СведенияОбОрганизации   = CW_БухгалтерияЭкспедитораСервер.СведенияОЮрФизЛице(ПараметрыСведений.Организация, ПараметрыСведений.ДатаСреза);   
		Возврат ПолучитьОснованиеПолномочийРуководителяОрганизации(ОбъектПечати, СведенияОбОрганизации);
	Иначе  
		Если ПустаяСтрока(ПараметрыДоговора.РуководительОснование) Тогда
			Возврат СтроковыеФункцииКлиентСервер.СформироватьСтрокуСимволов("_", 10);
		Иначе
			Возврат СокрЛП(ПараметрыДоговора.РуководительОснование);
		КонецЕсли;
	Конецесли;

КонецФункции 

