Функция РеквизитыКонтрагента_Представитель(ОбъектПечати) Экспорт  
	
	СведенияОРуководителе   = ПолучитьОтветственныхЛицИзПараметровДоговораМодуля(ОбъектПечати, Ложь, "Руководитель");

	Руководитель 			= РеквизитыКонтрагента_Руководитель(ОбъектПечати);
	РуководительРодительный = РеквизитыКонтрагента_РуководительРодительныйПадеж(ОбъектПечати); 
	
	Должность 	 			= РеквизитыКонтрагента_ДолжностьРуководителя(ОбъектПечати);   
	ДолжностьРодительный 	= РеквизитыКонтрагента_ДолжностьРуководителяРодительныйПадеж(ОбъектПечати);
		  
	СведенияОснование 		= ПолучитьОтветственныхЛицИзПараметровДоговораМодуля(ОбъектПечати, Ложь, "РуководительКонтрагентаОснование"); 
	Основание				= СведенияОснование.РуководительКонтрагентаОснование;
	ОснованиеРодительный 	= ПолучитьДолжностьРуководителяКонтрагента(Основание, "РОДИТЕЛЬНЫЙ"); 
	
	СведенияОКонтрагенте = Новый Структура;
	СведенияОКонтрагенте.Вставить("Руководитель", 	Руководитель);
 	СведенияОКонтрагенте.Вставить("Должность", 		Должность);
 	СведенияОКонтрагенте.Вставить("Основание", 		Основание); 
 	СведенияОКонтрагенте.Вставить("Пол", 			СведенияОРуководителе.ПолРуководителя); 
	
	СведенияОКонтрагенте.Вставить("РуководительРодительный", РуководительРодительный);
 	СведенияОКонтрагенте.Вставить("ДолжностьРодительный", 	 ДолжностьРодительный);
  	СведенияОКонтрагенте.Вставить("ОснованиеРодительный", 	 ОснованиеРодительный);

	Возврат ПолучитьПредставлителяКонтрагента(СведенияОКонтрагенте);
	
