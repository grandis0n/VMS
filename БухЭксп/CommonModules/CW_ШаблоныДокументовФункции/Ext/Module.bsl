// Возвращает слово "действующий" с правильным окончанием, учитывающим пол и падеж.
//
Функция СклонениеСловаДействующий(Пол, Падеж)
	
	Если Не ЗначениеЗаполнено(Пол) Тогда
		Если Падеж = 2 Тогда
			ТекстСУчетомПола = НСтр("ru = 'действующего (-ей)'");
		ИначеЕсли Падеж = 3 Тогда
			ТекстСУчетомПола = НСтр("ru = 'действующему (-ей)'");
		ИначеЕсли Падеж = 4 Тогда
			ТекстСУчетомПола = НСтр("ru = 'действующего (-ую)'");
		ИначеЕсли Падеж = 5 Тогда
			ТекстСУчетомПола = НСтр("ru = 'действующим (-ей)'");
		ИначеЕсли Падеж = 6 Тогда
			ТекстСУчетомПола = НСтр("ru = 'действующем (-ей)'");
		Иначе
			ТекстСУчетомПола = НСтр("ru = 'действующий (-ая)'");
		КонецЕсли;
	Иначе
		Если Падеж = 2 Тогда
			ТекстСУчетомПола = ?(Пол = 2, НСтр("ru = 'действующей'"), НСтр("ru = 'действующего'"));
		ИначеЕсли Падеж = 3 Тогда
			ТекстСУчетомПола = ?(Пол = 2, НСтр("ru = 'действующей'"), НСтр("ru = 'действующему'"));
		ИначеЕсли Падеж = 4 Тогда
			ТекстСУчетомПола = ?(Пол = 2, НСтр("ru = 'действующую'"), НСтр("ru = 'действующего'"));
		ИначеЕсли Падеж = 5 Тогда
			ТекстСУчетомПола = ?(Пол = 2, НСтр("ru = 'действующей'"), НСтр("ru = 'действующим'"));
		ИначеЕсли Падеж = 6 Тогда
			ТекстСУчетомПола = ?(Пол = 2, НСтр("ru = 'действующей'"), НСтр("ru = 'действующем'"));
		Иначе
			ТекстСУчетомПола = ?(Пол = 2, НСтр("ru = 'действующая'"), НСтр("ru = 'действующий'"));
		КонецЕсли;
	КонецЕсли;
	
	Возврат ТекстСУчетомПола;
	
КонецФункции


Функция ПолучитьПараметрыПолученияСведенийОбОрганизацииКонтрагенте(ОбъектПечати)
	
	Структура = Новый Структура("ДатаСреза, Организация");
	
	Если ТипЗнч(ОбъектПечати) = Тип("СправочникСсылка.CW_ДоговорыПоГрузоперевозкам") Тогда 
		Структура.Вставить("ДатаСреза",  	ОбъектПечати.ДатаДоговора);  
		Структура.Вставить("Организация",  	ОбъектПечати.Организация);  
		Структура.Вставить("Контрагент",  	ОбъектПечати.Владелец);  
	ИначеЕсли ТипЗнч(ОбъектПечати) = Тип("СправочникСсылка.CW_ПриложенияКДоговорам") Тогда 
		Структура.Вставить("ДатаСреза",  	ОбъектПечати.ДатаДокумента);  
		Структура.Вставить("Организация",  	ОбъектПечати.Договор.Организация);  
		Структура.Вставить("Контрагент",  	ОбъектПечати.Договор.Владелец);  
	Иначе    
		Возврат Неопределено;  
	КонецЕсли;              
	
	Возврат Структура;
	
КонецФункции  


Функция ПолучитьРеквизитыИзПараметровДоговораМодуля(ОбъектПечати, НашаОрганизация, ИмяРеквизита)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	CW_ПараметрыДоговоровСрезПоследних.Договор КАК Договор,
	               |	CW_ПараметрыДоговоровСрезПоследних."+ИмяРеквизита+" КАК "+ИмяРеквизита+",
	               |	CW_ПараметрыДоговоровСрезПоследних.ИзКарточкиОрганизации КАК ИзКарточкиОрганизации,
	               |	CW_ПараметрыДоговоровСрезПоследних.РеквизитыИзКарточкиКонтрагента КАК РеквизитыИзКарточкиКонтрагента
	               |ИЗ
	               |	РегистрСведений.CW_ПараметрыДоговоров.СрезПоследних(&ДатаСреза, Договор = &ОбъектПечати) КАК CW_ПараметрыДоговоровСрезПоследних"; 
	
	Запрос.УстановитьПараметр("ДатаСреза", 		ТекущаяДата());
	Запрос.УстановитьПараметр("ОбъектПечати", 	ОбъектПечати);
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Если Выборка.Следующий() Тогда 
		Если НашаОрганизация И Выборка.ИзКарточкиОрганизации Тогда
			Возврат Неопределено;
		КонецЕсли;
		Если НЕ НашаОрганизация И Выборка.РеквизитыИзКарточкиКонтрагента Тогда
			Возврат Неопределено;
		КонецЕсли;
		
		Возврат Выборка[ИмяРеквизита];   
		
	КонецЕсли;
	
	Возврат Неопределено;

КонецФункции

Функция ПолучитьОтветственныхЛицИзПараметровДоговораМодуля(ОбъектПечати, НашаОрганизация, ИмяРеквизита)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	CW_ПараметрыДоговоровСрезПоследних.Договор КАК Договор,
	               |	CW_ПараметрыДоговоровСрезПоследних."+ИмяРеквизита+" КАК "+ИмяРеквизита+",
	               |	CW_ПараметрыДоговоровСрезПоследних.РежимПодписей КАК РежимПодписей,
	               |	CW_ПараметрыДоговоровСрезПоследних.РуководительПол КАК РуководительПол,
	               |	CW_ПараметрыДоговоровСрезПоследних.ВариантПодписей КАК ВариантПодписей
	               |ИЗ
	               |	РегистрСведений.CW_ПараметрыДоговоров.СрезПоследних(&ДатаСреза, Договор = &ОбъектПечати) КАК CW_ПараметрыДоговоровСрезПоследних"; 

	
	Запрос.УстановитьПараметр("ДатаСреза",    ТекущаяДата());
	Запрос.УстановитьПараметр("ОбъектПечати", ОбъектПечати);
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();               
	Если Выборка.Следующий() Тогда 
		Если НЕ НашаОрганизация Тогда 
			СведенияОРуководителе = Новый Структура;
			СведенияОРуководителе.Вставить(ИмяРеквизита, 		Выборка[ИмяРеквизита]);
			СведенияОРуководителе.Вставить("ПолРуководителя", 	Выборка.РуководительПол);
			
			Возврат СведенияОРуководителе;   
		КонецЕсли;
		
		Если  НашаОрганизация Тогда
			Если Выборка.РежимПодписей = 0 Тогда 
				Возврат Неопределено;
			КонецЕсли;
			
			Если Выборка.РежимПодписей = 1 Тогда 
				Возврат Выборка[ИмяРеквизита];   
			КонецЕсли;
			
			Если Выборка.РежимПодписей = 2 Тогда  
				Если ТипЗнч(ОбъектПечати) = Тип("СправочникСсылка.CW_ДоговорыПоГрузоперевозкам") Тогда
					Организация = Выборка.Договор.Организация;
				КонецЕсли;
				Если ТипЗнч(ОбъектПечати) = Тип("СправочникСсылка.CW_ПриложенияКДоговорам") Тогда
					Организация = Выборка.Договор.Договор.Организация;
				КонецЕсли;
				Если Организация <> Неопределено Тогда
					Возврат ПолучитьЗначениеДинамическогоПараметра(Выборка.Договор.Организация, Выборка.ВариантПодписей, ИмяРеквизита);   
				КонецЕсли;
			КонецЕсли;  
		КонецЕсли;
	
	КонецЕсли;
	
	Возврат Неопределено;

КонецФункции  

Функция ПолучитьЗначениеДинамическогоПараметра(Организация, ВариантПодписей, ИмяРеквизита)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	CW_ЛицаПодписывающиеДокументыСрезПоследних.Руководитель КАК Руководитель,
	               |	CW_ЛицаПодписывающиеДокументыСрезПоследних.РуководительДолжность КАК РуководительДолжность,
	               |	CW_ЛицаПодписывающиеДокументыСрезПоследних.РуководительОснование КАК РуководительОснование
	               |ИЗ
	               |	РегистрСведений.CW_ЛицаПодписывающиеДокументы.СрезПоследних(
	               |			&ДатаСреза,
	               |			Организация = &Организация
	               |				И Вариант = &ВариантПодписей) КАК CW_ЛицаПодписывающиеДокументыСрезПоследних";  
	
	Запрос.УстановитьПараметр("ДатаСреза", 			ТекущаяДата());
	Запрос.УстановитьПараметр("Организация", 		Организация);
	Запрос.УстановитьПараметр("ВариантПодписей", 	ВариантПодписей);      
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	Если Выборка.Следующий() Тогда
		Если ИмяРеквизита = "РуководительОрганизации" Тогда
			Возврат Выборка.Руководитель;
		КонецЕсли;
		Если ИмяРеквизита = "ДолжностьРуководителяОрганизации" Тогда
			Возврат Выборка.РуководительДолжность;
		КонецЕсли;
		Если ИмяРеквизита = "РуководительОснование" Тогда
			Возврат Выборка.РуководительОснование;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Неопределено;	
	
КонецФункции

