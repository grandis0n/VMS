Функция РеквизитыКонтрагента_НаОсновании(ОбъектПечати) Экспорт  
	
	Если ТипЗнч(ОбъектПечати) = Тип("СправочникСписок.CW_ДоговорыПоГрузоперевозкам") Тогда
		 ДатаСведений =  ОбъектПечати.ДатаДоговора;
	КонецЕсли;
	Если ТипЗнч(ОбъектПечати) = Тип("СправочникСписок.CW_ПриложенияКДоговорам") Тогда
		 ДатаСведений =  ОбъектПечати.ДатаДокумента;
	КонецЕсли;
	
	СтруктурПараметров = Новый Структура;
	СтруктурПараметров.Вставить("Дата", ДатаСведений);
	СтруктурПараметров.Вставить("Договор", ОбъектПечати);
	
	ПараметрыДоговора = CW_Настройки.ПолучитьПараметрыДоговора(СтруктурПараметров);
	
	Возврат ПолучитьОснованиеПолномочийРуководителяКонтрагента(ОбъектПечати, ПараметрыДоговора);
	
