Функция ПолучитьРуководителяКонтрагента(Знач СведенияОКонтрагенте, Знач ИмяПадежа="")
	
	Если Не ЗначениеЗаполнено(СведенияОКонтрагенте) Тогда
		Возврат СтроковыеФункцииКлиентСервер.СформироватьСтрокуСимволов("_", 30);
	КонецЕсли;
	
	ИмяПола	= XMLСтрока(СведенияОКонтрагенте.ПолРуководителя);		
	Падеж 	= "";
	Если Не ПустаяСтрока(ИмяПадежа) Тогда
		Падеж = "ПД=" + ИмяПадежа;
	КонецЕсли;
	
	РезультатСклонения 	= ПолучитьСклоненияСтроки(СведенияОКонтрагенте.Руководитель, "ПЛ="+ИмяПола, Падеж);
	
	Если РезультатСклонения.Количество() > 0 Тогда
		Возврат РезультатСклонения[0]; 
	Иначе
		Возврат СтроковыеФункцииКлиентСервер.СформироватьСтрокуСимволов("_", 30);
	КонецЕсли;
																		
КонецФункции

Функция ПолучитьДолжностьРуководителяКонтрагента(Знач СклоняемаяСтрока, Знач ИмяПадежа="")
	
	Если ЗначениеЗаполнено(СклоняемаяСтрока) Тогда
		
		Падеж 	= "";
		Если Не ПустаяСтрока(ИмяПадежа) Тогда
			Падеж = "ПД=" + ИмяПадежа;
		КонецЕсли; 
		
		РезультатСклонения 	= ПолучитьСклоненияСтроки(СклоняемаяСтрока, , Падеж);
		
		Если РезультатСклонения.Количество() > 0 Тогда
			Результат = РезультатСклонения[0]; 
		Иначе
			Результат = СтроковыеФункцииКлиентСервер.СформироватьСтрокуСимволов("_", 30);
		КонецЕсли;
		
	Иначе
		Результат = СтроковыеФункцииКлиентСервер.СформироватьСтрокуСимволов("_", 30);
	КонецЕсли;
	
	Возврат Результат
	
КонецФункции 

