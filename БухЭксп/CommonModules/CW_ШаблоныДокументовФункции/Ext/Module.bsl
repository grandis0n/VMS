Функция НашиРеквизиты_Представитель(ОбъектПечати) Экспорт     
	
	СведенияОРуководителе = ПолучитьОтветственныхЛицИзПараметровДоговораМодуля(ОбъектПечати, Истина, "РуководительОрганизации");
	Если СведенияОРуководителе = Неопределено Тогда
		ПараметрыСведений 		= ПолучитьПараметрыПолученияСведенийОбОрганизацииКонтрагенте(ОбъектПечати);
		СведенияОРуководителе   = CW_БухгалтерияЭкспедитораСервер.СведенияОЮрФизЛице(ПараметрыСведений.Организация, ПараметрыСведений.ДатаСреза);  
		Пол 					= СведенияОРуководителе.Руководитель.Пол;   
	Иначе
		Пол 					= СведенияОРуководителе.Пол;   
	КонецЕсли; 

	
	Руководитель 			= НашиРеквизиты_Руководитель(ОбъектПечати);
	РуководительРодительный = НашиРеквизиты_РуководительРодительныйПадеж(ОбъектПечати);
		
	Должность 				= НашиРеквизиты_ДолжностьРуководителя(ОбъектПечати);
	ДолжностьРодительный 	= НашиРеквизиты_ДолжностьРуководителяРодительныйПадеж(ОбъектПечати);
	
	Основание 				= ПолучитьОтветственныхЛицИзПараметровДоговораМодуля(ОбъектПечати, Истина, "РуководительОснование");
	ОснованиеРодительный 	= ПолучитьДолжностьРуководителяКонтрагента(Основание, "РОДИТЕЛЬНЫЙ"); 
	
	СведенияОбОрганизации = Новый Структура;
	СведенияОбОрганизации.Вставить("Руководитель", 	Руководитель);
 	СведенияОбОрганизации.Вставить("Должность", 	Должность);
 	СведенияОбОрганизации.Вставить("Основание", 	Основание); 
	СведенияОбОрганизации.Вставить("Пол", 			Пол);
	
	СведенияОбОрганизации.Вставить("РуководительРодительный", 	РуководительРодительный);
 	СведенияОбОрганизации.Вставить("ДолжностьРодительный", 	 	ДолжностьРодительный);
  	СведенияОбОрганизации.Вставить("ОснованиеРодительный", 	 	ОснованиеРодительный);

	Возврат ПолучитьПредставлителяОрганизации(СведенияОбОрганизации);
	
КонецФункции  

