Функция НашиРеквизиты_РуководительФИО(ОбъектПечати) Экспорт  
	
	мСоставФИО 		= СтрРазделить(НашиРеквизиты_Руководитель(ОбъектПечати), " ");  
	РуководительФИО = мСоставФИО[0];   
	Если мСоставФИО.Количество() > 1 Тогда 
		Для Индекс = 1 по мСоставФИО.ВГраница() Цикл
			РуководительФИО = РуководительФИО + " "+ Лев(мСоставФИО[Индекс],1)+".";	
		КонецЦикла;
	КонецЕсли;   
	
	Возврат РуководительФИО;

КонецФункции  



