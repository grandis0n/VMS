// пустая структура или на основании письма из очереди на отправку
Функция СтруктураПисьма(Источник=Неопределено) Экспорт 
	// --- 
	
	// по умолчанию пустая структура
	Если Источник=Неопределено Тогда
		
		СП = Новый Структура;
		СП.Вставить("Кодировка","UTF-8");
		СП.Вставить("Важность",ВажностьИнтернетПочтовогоСообщения.Обычная);
		СП.Вставить("Категории", "");
		// --- 
		СП.Вставить("Отправитель",Справочники.УчетныеЗаписиЭлектроннойПочты.ПустаяСсылка()); // учетная запись ЭП (!!!)
		// адреса - массив из структур адреса (Адрес-ОтображаемоеИмя)
		СП.Вставить("ОбратныеАдреса",Новый Массив); // необязательный
		СП.Вставить("Получатели",Новый Массив);
		СП.Вставить("Получатели_Копии",Новый Массив);
		СП.Вставить("Получатели_СкрытыеКопии",Новый Массив);
		// --- 
		СП.Вставить("Тема","");
		СП.Вставить("Тексты",Новый Массив); // значение - структура Текст-ТипТекста-Кодировка
		СП.Вставить("Вложения",Новый Массив); // значение - структура ИмяФайла-ТипАдреса-Адрес
		
		Возврат(СП);
		
	КонецЕсли; 
	
	// заполнение по письму на отправку
	Если ТипЗнч(Источник)=Тип("СправочникСсылка.CW_ЭлектронныеПисьмаДляОтправки")
		ИЛИ ТипЗнч(Источник)=Тип("СправочникОбъект.CW_ЭлектронныеПисьмаДляОтправки") Тогда
		
		СП = Новый Структура;
		СП.Вставить("Кодировка","UTF-8");
		СП.Вставить("Важность",ВажностьИнтернетПочтовогоСообщения.Обычная);
		СП.Вставить("Категории", "");
		// --- 
		СП.Вставить("Отправитель",Источник.Отправитель);
		// --- 
		СП.Вставить("ОбратныеАдреса",Новый Массив); // в очереди обратных адресов пока нет TODO
		// --- 
		СП.Вставить("Получатели",Новый Массив);
		Для каждого СтрАдрес Из Источник.Получатели.Выгрузить(Новый Структура("Вид",Перечисления.CW_ВидыПолучателейЭлектронныхПисем.Получатель)) Цикл
			
			Если СокрЛП(СтрАдрес.Адрес) <> "" Тогда
				СП.Получатели.Добавить(СтруктураАдреса(СтрАдрес.Адрес,СтрАдрес.ОтображаемоеИмя));
			КонецЕсли;
			
		КонецЦикла;
		// --- 
		СП.Вставить("Получатели_Копии",Новый Массив);
		Для каждого СтрАдрес Из Источник.Получатели.Выгрузить(Новый Структура("Вид",Перечисления.CW_ВидыПолучателейЭлектронныхПисем.Копия)) Цикл
			
			Если СокрЛП(СтрАдрес.Адрес) <> "" Тогда
				СП.Получатели_Копии.Добавить(СтруктураАдреса(СтрАдрес.Адрес,СтрАдрес.ОтображаемоеИмя));
			КонецЕсли;
			
		КонецЦикла;
		// --- 
		СП.Вставить("Получатели_СкрытыеКопии",Новый Массив);
		Для каждого СтрАдрес Из Источник.Получатели.Выгрузить(Новый Структура("Вид",Перечисления.CW_ВидыПолучателейЭлектронныхПисем.СкрытаяКопия)) Цикл
			
			Если СокрЛП(СтрАдрес.Адрес) <> "" Тогда
				СП.Получатели_СкрытыеКопии.Добавить(СтруктураАдреса(СтрАдрес.Адрес,СтрАдрес.ОтображаемоеИмя));
			КонецЕсли; 
			
		КонецЦикла;
		// --- 
		СП.Вставить("Тема",Источник.Тема);
		// ----------------------------------------------------------------------------  
		СП.Вставить("Тексты",Новый Массив); // значение - структура Текст,ТипТекста,Кодировка или просто текст
		Для каждого СтрТекст Из Источник.Тексты Цикл
			
			СтруктураТекста = Новый Структура;
			СтруктураТекста.Вставить("Текст",СтрТекст.Текст);
			Если СокрЛП(СтрТекст.ТипТекста)<>"" Тогда
				СтруктураТекста.Вставить("ТипТекста",СтрТекст.ТипТекста);
			КонецЕсли; 
			Если СокрЛП(СтрТекст.Кодировка)<>"" Тогда
				СтруктураТекста.Вставить("Кодировка",СтрТекст.Кодировка);
			КонецЕсли; 
			СП.Тексты.Добавить(СтруктураТекста);
			
		КонецЦикла; 
		// ----------------------------------------------------------------------------  
		СП.Вставить("Вложения",Новый Массив);
		Для каждого Вложение Из Источник.Вложения Цикл
			// --- 
			
			НС = ПолучитьНавигационнуюСсылку(Источник,"Вложения.Вложение",Источник.Вложения.Индекс(Вложение));
			ДобавитьВложение(СП,Вложение.ИмяФайла,"ссылка",НС);
			
			// --- 
		КонецЦикла;
		// ---------------------------------------------------------------------------- 
		
		Возврат(СП);
		
	КонецЕсли; 
		
	// --- 
КонецФункции

// формирует элемент справочника "письма для отправки" по структуре письма
Функция ПисьмоОбъектПоСтруктуре(СП) Экспорт 
	// --- 
	
	ПисьмоОбъект = Справочники.CW_ЭлектронныеПисьмаДляОтправки.СоздатьЭлемент();
	// --- 
	ПисьмоОбъект.Дата 			= ТекущаяДата();
	ПисьмоОбъект.Отправитель 	= СП.Отправитель;
	ПисьмоОбъект.Тема 			= СП.Тема;
	
	Если СП.Свойство("СсылкаНаОбъект") Тогда
		ПисьмоОбъект.СсылкаНаОбъект = СП.СсылкаНаОбъект;
	КонецЕсли;

	// --- 
	Для каждого СА Из СП.Получатели Цикл
		
		Нстр = ПисьмоОбъект.Получатели.Добавить();
		ЗаполнитьЗначенияСвойств(Нстр,СА);
		Нстр.Вид = Перечисления.CW_ВидыПолучателейЭлектронныхПисем.Получатель;
		
	КонецЦикла; 
	// --- 
	Для каждого СА Из СП.Получатели_Копии Цикл
		
		Нстр = ПисьмоОбъект.Получатели.Добавить();
		ЗаполнитьЗначенияСвойств(Нстр,СА);
		Нстр.Вид = Перечисления.CW_ВидыПолучателейЭлектронныхПисем.Копия;
		
	КонецЦикла; 
	// --- 
	Для каждого СА Из СП.Получатели_СкрытыеКопии Цикл
		
		Нстр = ПисьмоОбъект.Получатели.Добавить();
		ЗаполнитьЗначенияСвойств(Нстр,СА);
		Нстр.Вид = Перечисления.CW_ВидыПолучателейЭлектронныхПисем.СкрытаяКопия;
		
	КонецЦикла; 
	// --- 
	Для каждого СТ Из СП.Тексты Цикл
		
		Если ТипЗнч(СТ)=Тип("Строка") Тогда
			
			Нстр = ПисьмоОбъект.Тексты.Добавить();
			Нстр.Текст = СТ;
			Нстр.ТипТекста = "";
			Нстр.Кодировка = "UTF-8";
									
		ИначеЕсли ТипЗнч(СТ)=Тип("Структура") Тогда
			
			Нстр = ПисьмоОбъект.Тексты.Добавить();
			Нстр.Текст = СТ.Текст;
			Нстр.ТипТекста = _сф.ст_ПолучитьСвойство(СТ,"ТипТекста");
			Нстр.Кодировка = _сф.ст_ПолучитьСвойство(СТ,"Кодировка");
			
		КонецЕсли; 
		
	КонецЦикла; 
	// --- 
	Для каждого Вложение Из СП.Вложения Цикл
		// --- 
		
		Если Вложение.ТипАдреса = "адрес" Тогда
			
			Нстр = ПисьмоОбъект.Вложения.Добавить();
			Нстр.Вложение = Новый ХранилищеЗначения(ПолучитьИзВременногоХранилища(Вложение.Адрес));
			Нстр.ИмяФайла = Вложение.ИмяФайла; 
			
		ИначеЕсли Вложение.ТипАдреса = "путь" Тогда 
			
			ДД = Новый ДвоичныеДанные(Вложение.Адрес);
			
			Нстр = ПисьмоОбъект.Вложения.Добавить();
			Нстр.Вложение = Новый ХранилищеЗначения(ДД);
			Нстр.ИмяФайла = Вложение.ИмяФайла; 
			
		ИначеЕсли Вложение.ТипАдреса = "ссылка" Тогда 
			
			// ничего не делаем, ссылка тут может быть только на сам объект
			
		ИначеЕсли Вложение.ТипАдреса = "Картинка" Тогда
			
			ДвоичныеДанные = Вложение.Адрес.ПолучитьДвоичныеДанные();
			
			Нстр = ПисьмоОбъект.Вложения.Добавить();
			Нстр.Вложение 			= Новый ХранилищеЗначения(ДвоичныеДанные);
			Нстр.ИмяФайла 			= Вложение.ИмяФайла; 
			Нстр.Идентификатор	 	= Вложение.Идентификатор; 
			Нстр.ЕстьИдентификатор 	= Истина; 
			
		КонецЕсли; 
				
		// --- 
	КонецЦикла;

	
	// --- 
	Возврат(ПисьмоОбъект);
	
	// --- 
КонецФункции

// формирует письмо по структуре письма или по справочнику "письма для отправки"
Функция СформироватьПисьмо(СП, ОтложеннаяОтправка = Ложь) Экспорт 
	// --- 
	
	Если ТипЗнч(СП) = Тип("Структура") Тогда
		
		Письмо = Новый ИнтернетПочтовоеСообщение;
		// --- 
		Письмо.Кодировка = СП.Кодировка;
		Письмо.Важность = ВажностьИнтернетПочтовогоСообщения[Строка(СП.Важность)];//СП.Важность;
		
		_сф.УстановитьПоУсловию(Письмо.Категории,СП.Категории);
		// --- 
		Письмо.Отправитель.Адрес = СП.Отправитель.ПочтовыйАдрес;
		Письмо.Отправитель.ОтображаемоеИмя = СП.Отправитель.ИмяОтправителя;
		// --- 
		Для каждого СА Из СП.ОбратныеАдреса Цикл
			Адрес = Письмо.ОбратныйАдрес.Добавить(СА.Адрес);
			Адрес.ОтображаемоеИмя = СА.ОтображаемоеИмя;
		КонецЦикла; 
		Для каждого СА Из СП.Получатели Цикл
			Адрес = Письмо.Получатели.Добавить(СА.Адрес);
			Адрес.ОтображаемоеИмя = СА.ОтображаемоеИмя;
		КонецЦикла; 
		Для каждого СА Из СП.Получатели_Копии Цикл
			Адрес = Письмо.Копии.Добавить(СА.Адрес);
			Адрес.ОтображаемоеИмя = СА.ОтображаемоеИмя;
		КонецЦикла; 
		Для каждого СА Из СП.Получатели_СкрытыеКопии Цикл
			Адрес = Письмо.СлепыеКопии.Добавить(СА.Адрес);
			Адрес.ОтображаемоеИмя = СА.ОтображаемоеИмя;
		КонецЦикла;
		// --- 
		Письмо.Тема = СП.Тема;
			
		// ---------------------------------------------------------------------------- 
		Для каждого Вложение Из СП.Вложения Цикл
			
			Если Вложение.ТипАдреса = "адрес" Тогда
				
				Письмо.Вложения.Добавить(ПолучитьИзВременногоХранилища(Вложение.Адрес), Вложение.ИмяФайла); 
				
			ИначеЕсли Вложение.ТипАдреса = "путь" Тогда 
				
				Письмо.Вложения.Добавить(Вложение.Адрес, Вложение.ИмяФайла); 
				
			ИначеЕсли Вложение.ТипАдреса = "ссылка" Тогда 
				
				Письмо.Вложения.Добавить(Вложение.Адрес, Вложение.ИмяФайла);
				
			КонецЕсли; 
			
		КонецЦикла;

		
		// ---------------------------------------------------------------------------- 
		Для каждого СтрТекст Из СП.Тексты Цикл
			
			Если ТипЗнч(СтрТекст)=Тип("Строка") Тогда
				
				Текст = Письмо.Тексты.Добавить(СтрТекст);
				Текст.ТипТекста = ТипТекстаПочтовогоСообщения.ПростойТекст;
				Текст.Кодировка = "UTF-8";
				
			ИначеЕсли ТипЗнч(СтрТекст)=Тип("Структура") Тогда
				
				Текст = Письмо.Тексты.Добавить(СтрТекст.Текст);
				Кодировка = _сф.ст_ПолучитьСвойство(СтрТекст,"Кодировка");
				Текст.Кодировка = ?(Кодировка=Неопределено ИЛИ Кодировка="","UTF-8",Кодировка);
				Текст.ТипТекста = ТипТекстаПисьма(_сф.ст_ПолучитьСвойство(СтрТекст, "ТипТекста", ТипТекстаПочтовогоСообщения.ПростойТекст));
				
			КонецЕсли; 
			
		КонецЦикла; 
		// ---------------------------------------------------------------------------- 
		Письмо.ОбработатьТексты();
		
		Возврат(Письмо);
		
	КонецЕсли; 
	
	Если ТипЗнч(СП) = Тип("СправочникСсылка.CW_ЭлектронныеПисьмаДляОтправки")
		ИЛИ ТипЗнч(СП) = Тип("СправочникОбъект.CW_ЭлектронныеПисьмаДляОтправки") Тогда
		
		Письмо = Новый ИнтернетПочтовоеСообщение;
		// --- 
		Письмо.Кодировка = "UTF-8";
		Письмо.Важность = ВажностьИнтернетПочтовогоСообщения.Обычная;
		// --- 
		Письмо.Отправитель.Адрес = СП.Отправитель.ПочтовыйАдрес;
		Письмо.Отправитель.ОтображаемоеИмя = СП.Отправитель.ИмяОтправителя;
		// --- 
		Для каждого СА Из СП.Получатели.Выгрузить(_сф.ст_Отбор("Вид",Перечисления.CW_ВидыПолучателейЭлектронныхПисем.Получатель)) Цикл
			
			Адрес = Письмо.Получатели.Добавить(СА.Адрес);
			Адрес.ОтображаемоеИмя = СА.ОтображаемоеИмя;
			
		КонецЦикла;
		Для каждого СА Из СП.Получатели.Выгрузить(_сф.ст_Отбор("Вид",Перечисления.CW_ВидыПолучателейЭлектронныхПисем.Копия)) Цикл
			
			Адрес = Письмо.Копии.Добавить(СА.Адрес);
			Адрес.ОтображаемоеИмя = СА.ОтображаемоеИмя;
			
		КонецЦикла;
		Для каждого СА Из СП.Получатели.Выгрузить(_сф.ст_Отбор("Вид",Перечисления.CW_ВидыПолучателейЭлектронныхПисем.СкрытаяКопия)) Цикл
			
			Адрес = Письмо.СлепыеКопии.Добавить(СА.Адрес);
			Адрес.ОтображаемоеИмя = СА.ОтображаемоеИмя;
			
		КонецЦикла;
		// --- 
		Письмо.Тема = СП.Тема;
		
		//Выполяем замену картинок на локальные ссылки
		ВремВложения = СП.Вложения.Выгрузить();
		СоответствиеЛокальныхФайлов = новый Соответствие;
		Отбор = Новый Структура("ЕстьИдентификатор", истина);
		мСтроки = ВремВложения.НайтиСтроки(Отбор);
		Для Каждого СтрокаВложений из мСтроки Цикл
			ДвоичныеДанные 		= СтрокаВложений.Вложение.Получить();
			ИмяВременогофайла 	= ПолучитьИмяВременногоФайла();
			ДвоичныеДанные.Записать(ИмяВременогофайла);
			
			СоответствиеЛокальныхФайлов.Вставить(СтрокаВложений.Идентификатор, ИмяВременогофайла);
			
			ВремВложения.Удалить(СтрокаВложений);
		КонецЦикла;
		
		
		// ----------------------------------------------------------------------------  
		Для каждого СтрТекст Из СП.Тексты Цикл
			
			Текст = СтрТекст.Текст;
			Если СтрТекст.ТипТекста = "HTML" Тогда
				Для Каждого ЭлементСоответствия из СоответствиеЛокальныхФайлов Цикл
					Текст = СтрЗаменить(Текст,ЭлементСоответствия.Ключ, ЭлементСоответствия.Значение);
				КонецЦикла;
			КонецЕсли;

			Текст = Письмо.Тексты.Добавить(Текст);
			ТипТекста = СтрТекст.ТипТекста;
			Текст.ТипТекста = ?(СокрЛП(ТипТекста)="",ТипТекстаПочтовогоСообщения.ПростойТекст,ТипТекстаПисьма(ТипТекста)); 
			Кодировка = СтрТекст.Кодировка;
			Текст.Кодировка = ?(СокрЛП(Кодировка)="","UTF-8",Кодировка);
			
		КонецЦикла; 
		// ---------------------------------------------------------------------------- 
		Для каждого Вложение Из ВремВложения Цикл
			Письмо.Вложения.Добавить(Вложение.Вложение.Получить(), Вложение.ИмяФайла); 
		КонецЦикла;
		// ---------------------------------------------------------------------------- 
		
		Письмо.ОбработатьТексты();

		Возврат(Письмо);
		
	КонецЕсли; 
		
	// --- 
КонецФункции

// ---------------------------------------------------------------------------- 

// заполняет получателей в структуре письма по таблице Вид-Адрес-ОтображаемоеИмя
Процедура ЗаполнитьПолучателейПоТаблице(СП,ТаблицаПолучателей) Экспорт 
	// --- 
	
	// получатели
	// ---------------------------------------------------------------------------- 
	Отбор = _сф.ст_Отбор("Вид",Перечисления.CW_ВидыПолучателейЭлектронныхПисем.Получатель);
	Строки = _сф.к_НайтиСтроки(ТаблицаПолучателей,Отбор);
	Если Строки <> Неопределено Тогда
		
		Для каждого Стр Из Строки Цикл
			
			Если СокрЛП(Стр.Адрес) <> "" Тогда
				
				СП.Получатели.Добавить(СтруктураАдреса(Стр.Адрес,Стр.ОтображаемоеИмя));
				
			КонецЕсли; 
			
		КонецЦикла; 
		
	КонецЕсли; 
	
	// копии
	// ---------------------------------------------------------------------------- 
	Отбор = _сф.ст_Отбор("Вид",Перечисления.CW_ВидыПолучателейЭлектронныхПисем.Копия);
	Строки = _сф.к_НайтиСтроки(ТаблицаПолучателей,Отбор);
	Если Строки <> Неопределено Тогда
		
		Для каждого Стр Из Строки Цикл
			
			Если СокрЛП(Стр.Адрес) <> "" Тогда
				
				СП.Получатели_Копии.Добавить(СтруктураАдреса(Стр.Адрес,Стр.ОтображаемоеИмя));
				
			КонецЕсли; 
			
		КонецЦикла; 
		
	КонецЕсли; 
	
	// скрытие копии
	// ---------------------------------------------------------------------------- 
	Отбор = _сф.ст_Отбор("Вид",Перечисления.CW_ВидыПолучателейЭлектронныхПисем.СкрытаяКопия);
	Строки = _сф.к_НайтиСтроки(ТаблицаПолучателей,Отбор);
	Если Строки <> Неопределено Тогда
		
		Для каждого Стр Из Строки Цикл
			
			Если СокрЛП(Стр.Адрес) <> "" Тогда
				
				СП.Получатели_СкрытыеКопии.Добавить(СтруктураАдреса(Стр.Адрес,Стр.ОтображаемоеИмя));
				
			КонецЕсли; 
			
		КонецЦикла; 
		
	КонецЕсли; 
	
	// --- 
КонецПроцедуры

// добавляет адреса из строки в массив получателей
Процедура ДобавитьПолучателейИзСтроки(МассивПолучателей,Знач СтрокаАдресов) Экспорт 
	// --- 
	
	СтрокаАдресов = СтрЗаменить(СтрокаАдресов,";",","); // для поддержки ";" в качестве разделителя
	
	МассивАдресов = _сф.м_СоздатьИзСтроки(СтрокаАдресов,",");
	Для каждого Адрес Из МассивАдресов Цикл
		
		СА = СтруктураАдресаПоСтроке(Адрес);
		Если СокрЛП(СА.Адрес) <> "" Тогда
			
			МассивПолучателей.Добавить(СА);
			
		КонецЕсли; 
		
	КонецЦикла; 
	
	// --- 
КонецПроцедуры

// удаляет запрещенные символы из имен файлов
Функция УдалитьЗапрещенныеСимволы(Знач ОригТекст) Экспорт 
	
	Текст = ОригТекст;
	текст = СтрЗаменить(Текст, "/", "_");
	текст = СтрЗаменить(Текст, "\", "_");
	текст = СтрЗаменить(Текст, ":", "_");
	текст = СтрЗаменить(Текст, "*", "_");
	текст = СтрЗаменить(Текст, "?", "_");
	текст = СтрЗаменить(Текст, """", "_");
	текст = СтрЗаменить(Текст, "<", "_");
	текст = СтрЗаменить(Текст, ">", "_");
	текст = СтрЗаменить(Текст, "|", "_");
	Возврат(Текст);
	
КонецФункции

// добавляет к структуре письма текст
Процедура ДобавитьТекст(СП,Текст,ТипТекста="HTML",Кодировка="UTF-8") Экспорт 

	СТ = _сф.ст_Создать("Текст,ТипТекста,Кодировка");
	СТ.Текст 		= Текст;
	СТ.ТипТекста 	= ?(ТипТекста = Неопределено, "HTML" ,ТипТекста);;
	СТ.Кодировка 	= ?(Кодировка = Неопределено, "UTF-8",Кодировка);;
	
	СП.Тексты.Добавить(СТ);
	
КонецПроцедуры

// добавляет к структуре письма вложение
Процедура ДобавитьВложение(СП, ИмяФайла, ТипАдреса, Адрес, Идентификатор=Неопределено) Экспорт 
	// --- 
	
	// тип адреса: адрес(вр.хр.), навигационная ссылка или путь(относительно сервера) : адрес/ссылка/путь
	// адрес - адрес во временном хранилище, навигационная ссылка или путь
	
	СтруктураФайла = _сф.ст_Создать("ИмяФайла,ТипАдреса,Адрес,Идентификатор");
	СтруктураФайла.ИмяФайла 		= УдалитьЗапрещенныеСимволы(ИмяФайла);
	СтруктураФайла.ТипАдреса 		= ТипАдреса;
	СтруктураФайла.Адрес 			= Адрес;
	СтруктураФайла.Идентификатор 	= Идентификатор;
	
	СП.Вложения.Добавить(СтруктураФайла);
	
	// --- 
КонецПроцедуры

// возвращает системный тип текста
Функция ТипТекстаПисьма(ТипСтрокой)
	// --- 
	
	Если НРег(ТипСтрокой)="plaintext" Тогда
		
		Возврат(ТипТекстаПочтовогоСообщения.ПростойТекст);
		
	ИначеЕсли НРег(ТипСтрокой)="richtext" Тогда		
		
		Возврат(ТипТекстаПочтовогоСообщения.РазмеченныйТекст);
		
	ИначеЕсли НРег(ТипСтрокой)="html" Тогда		
		
		Возврат(ТипТекстаПочтовогоСообщения.HTML);
		
	Иначе
		
		Возврат ТипТекстаПочтовогоСообщения.ПростойТекст;
		
	КонецЕсли; 
	
	// --- 
КонецФункции

// структура адреса по двум 
Функция СтруктураАдреса(Адрес,ОтображаемоеИмя="")
	// --- 
	
	Возврат(Новый Структура("Адрес,ОтображаемоеИмя",Адрес,ОтображаемоеИмя));
	
	// --- 
КонецФункции

// возвращает строку адреса по структуре адреса
Функция СтрокаАдресаПоСтруктуре(СА) Экспорт 
	// --- 
	
	// СА - структура адреса
	
	Имя = _сф.ст_ПолучитьСвойство(СА,"ОтображаемоеИмя");
	
	Если Имя = Неопределено Тогда
		
		Возврат(СА.Адрес);
		
	Иначе
		
		Если СокрЛП(Имя)="" Тогда
			
			Возврат(СА.Адрес);
			
		Иначе
			
			Возврат(СокрЛП(Имя)+" "+"<"+СокрЛП(СА.Адрес)+">");
			
		КонецЕсли; 
		
	КонецЕсли; 
	
	// --- 
КонецФункции

// Возвращает структуру адреса по строке вида "Отображаемое имя <адрес>"
Функция СтруктураАдресаПоСтроке(Знач Адрес) Экспорт 
	// --- 
	Адрес = СокрЛП(Адрес);
	строки = СтрЗаменить(Адрес,"<",Символы.ПС);
	Если _сф.стр_ЧислоСтрок(строки) > 1 Тогда
		
		Представление = СтрПолучитьСтроку(Строки,1);
		АдресПочты = СокрЛП(СтрЗаменить(СтрПолучитьСтроку(строки,2),">",""));
		
	Иначе
		
		Представление = "";
		АдресПочты = СокрЛП(Адрес);
		
	КонецЕсли; 
	
	Возврат(СтруктураАдреса(АдресПочты,Представление));
	
	// --- 
КонецФункции

Функция МассивАдресовПоСтроке(Строка,Разделитель=",") Экспорт 
	// --- 
	
	МассивАдресов = Новый Массив;
	МассивСтрок = _сф.м_СоздатьИзСтроки(Строка,Разделитель);
	Для каждого СтрокаАдреса Из МассивСтрок Цикл
		
		МассивАдресов.Добавить(СтруктураАдреса(СтрокаАдреса));
		
	КонецЦикла; 
	
	Возврат(МассивАдресов);
	
	// --- 
КонецФункции

// получает параметры пользователя
Функция ПолучитьУчетнуюЗаписьТекущегоПользователя() Экспорт
	
	ТекущийПользователь = CW_Настройки.Пользователь();
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	ПараметрыПользователей.УчетнаяЗаписьЭлектроннойПочты КАК УчетнаяЗаписьЭлектроннойПочты
	               |ИЗ
	               |	РегистрСведений.CW_НастройкиПользователей КАК ПараметрыПользователей
	               |ГДЕ
	               |	ПараметрыПользователей.Пользователь = &Пользователь
	               |	И ПараметрыПользователей.УчетнаяЗаписьЭлектроннойПочты <> Значение(Справочник.CW_УчетныеЗаписиЭлектроннойПочты.ПустаяСсылка)";
	
	Запрос.УстановитьПараметр("Пользователь", ТекущийПользователь);
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.УчетнаяЗаписьЭлектроннойПочты;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

// ----------------------------------------------------------------------------  

Функция ОтправитьПисьмо(Письмо) Экспорт 
	
	Если ЭтоАдресВременногоХранилища(Письмо) Тогда
		
		СП = ПолучитьИзВременногоХранилища(Письмо);
		
	Иначе
		
		СП = Письмо;
		
	КонецЕсли; 
	
	// --- 
	
	Если (Константы.CW_СкрытаяКопияДляВсехПисем.Получить()) Тогда
		
		АдресаСтрокой = Константы.CW_АдресаСкрытыхКопийДляВсехПисем.Получить();
		Если (ЗначениеЗаполнено(АдресаСтрокой)) Тогда
			
			АдресаСтрокой = СтрЗаменить(АдресаСтрокой,";",",");
			МассивАдресов = _сф.м_СоздатьИзСтроки(АдресаСтрокой,",");
			Для каждого Стр Из МассивАдресов Цикл
				
				Письмо.Получатели_СкрытыеКопии.Добавить(СтруктураАдресаПоСтроке(Стр));
				
			КонецЦикла; 
			
		КонецЕсли; 
		
	КонецЕсли; 
	
	// --- 
	
	ИспользуетсяОчередь = ПолучитьФункциональнуюОпцию("CW_ИспользованиеОчередиНаОтправку");
	
	// --- 
	
	Если ИспользуетсяОчередь Тогда
		
		// записываем письмо в очередь
		Возврат(ДобавитьПисьмоВОчередь(СП));
		
	Иначе
		
		// отправляем сразу
		Попытка
			
			Сообщение 		= СформироватьПисьмо(СП);
		
			Почта = Новый ИнтернетПочта;
			Почта.Подключиться(ПолучитьПрофильSMTP(СП.Отправитель));
			
			ОтветСервера 	= Почта.Послать(Сообщение);
			
			Если ОтветСервера.Количество() > 0 Тогда
				
				мОшибочныеАдреса = новый Массив;
				Для Каждого ЭлементСтруктуры из ОтветСервера Цикл
					СообщениеОбОшибке = Новый СообщениеПользователю;
				    СообщениеОбОшибке.Текст = ЭлементСтруктуры.Значение;
					СообщениеОбОшибке.Сообщить();
					мОшибочныеАдреса.Добавить(ЭлементСтруктуры.Ключ);
				КонецЦикла;
				
				Почта.Отключиться();
				
				СписокАдресов 	= СтрСоединить(мОшибочныеАдреса,",");
				ТекстОшибки 	= "Не удалось отправить письмо по одному или некоторым из указанных адресов: "+СписокАдресов;
				
				CW_Журнал.ЗаписатьСообщение("Общие.ОтправкаПочты","error",ТекстОшибки);

				Возврат(_УФКС.Ответ(1,ТекстОшибки));
			
			КонецЕсли;
			
			Почта.Отключиться();   
			
			Если СП.Отправитель.СохранятьОтправленныеПисьма 
				И ЗначениеЗаполнено(СП.Отправитель.АдресСервераIMAP) Тогда 
				
				Попытка                              
					
					ПрофильIMAP = ПолучитьПрофильIMAP(СП.Отправитель);
					
					ИнтернетПочта = Новый ИнтернетПочта;
					ИнтернетПочта.Подключиться(ПрофильIMAP, ПротоколИнтернетПочты.IMAP);
					ИнтернетПочта.ТекущийПочтовыйЯщик = "Отправленные";
					ИнтернетПочта.Послать(Сообщение,, ПротоколИнтернетПочты.IMAP);
					ИнтернетПочта.Отключиться();  
					
				Исключение 
					ЗаписьЖурналаРегистрации("Отппавка почты IMAP",УровеньЖурналаРегистрации.Информация,,,ОписаниеОшибки());
				КонецПопытки;  	
				
			КонецЕсли;

			Возврат(_УФКС.Ответ(0));
			
		Исключение
			
			ТекстОшибки = ОписаниеОшибки();
			CW_Журнал.ЗаписатьСообщение("Общие.ОтправкаПочты","error",ТекстОшибки);
			
			Возврат(_УФКС.Ответ(1,ТекстОшибки));
			
		КонецПопытки; 
		
	КонецЕсли; 
	
КонецФункции

Функция ДобавитьПисьмоВОчередь(Письмо) Экспорт 
	// --- 
	
	Попытка
		
		ПисьмоОбъект = ПисьмоОбъектПоСтруктуре(Письмо);
		ПисьмоОбъект.Записать();
		
		РегистрыСведений.CW_СтатусОбработкиЭлектронныхПисем.ЗаписатьСтатусОбработки(ПисьмоОбъект.Ссылка, ПредопределенноеЗначение("Перечисление.CW_СтатусыОбработкиПочтовыхСообщений.Ожидание"));
		
		Возврат(_УФКС.Ответ(2));
		
	Исключение
	    Возврат(_УФКС.Ответ(1,ОписаниеОшибки()));
	КонецПопытки; 
	
	// --- 
КонецФункции

