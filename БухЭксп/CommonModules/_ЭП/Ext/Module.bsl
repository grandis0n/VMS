// РЕГЛАМЕНТНЫЕ ЗАДАНИЯ

// ---------------------------------------------------------------------------- 
// РЗ: Получение почты

Функция ПолучитьПисьмаДляОбработки() Экспорт 
	// --- 
	
	// получаем активные выборки
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ФильтрыЭлектронныхПисем.УчетнаяЗапись,
	|	ФильтрыЭлектронныхПисем.Критерий
	|ИЗ
	|	Справочник.CW_ФильтрыЭлектронныхПисем КАК ФильтрыЭлектронныхПисем
	|ГДЕ
	|	ФильтрыЭлектронныхПисем.Активность = ИСТИНА";
	ТЗ = Запрос.Выполнить().Выгрузить();
	СписокУчетныхЗаписей = _сф.сп_СоздатьИзКолонкиТЗ(ТЗ,"УчетнаяЗапись");  
	
	Для каждого УчетнаяЗапись Из СписокУчетныхЗаписей.ВыгрузитьЗначения() Цикл
		
		Попытка
			
			// получаем критерии
			ТЗК = ТЗ.Скопировать(Новый Структура("УчетнаяЗапись",УчетнаяЗапись));
			МассивКритериев = _сф.м_СоздатьИзКолонкиТЗ(ТЗК,"Критерий");
			// --- 
			
			// подключаемся к серверу, читаем заголовки
			ИнтернетПочта = Новый ИнтернетПочта;
			Попытка
				ИПП = ПолучитьПрофильPOP3(УчетнаяЗапись);
				ИнтернетПочта.Подключиться(ИПП);
			Исключение
				//ОписаниеОшибки()
				// тут необходимо сделать запись в некий журнал сообщений
				ВызватьИсключение "Ошибка подключения:"+ОписаниеОшибки();
				
			КонецПопытки; 
			// --- 
			МассивЗаголовков = ИнтернетПочта.ПолучитьЗаголовки();
			ТаблицаЗагружаемыхПисем = _сф.т_Создать("Заголовок,Критерий,Идентификатор,СтатусЗагрузки");
			
			// проверяем
			Для каждого Заголовок Из МассивЗаголовков Цикл
				
				Для каждого Критерий Из МассивКритериев Цикл
					
					Если СоответствиеКритерию(Заголовок,Критерий) Тогда
						
						Нстр = ТаблицаЗагружаемыхПисем.Добавить();
						Нстр.Заголовок = Заголовок;
						Нстр.Критерий = Критерий;
						Нстр.Идентификатор = Заголовок.ИдентификаторСообщения;
						Нстр.СтатусЗагрузки = Ложь;
						Продолжить;
						
					КонецЕсли;
					
				КонецЦикла; // цикл критериев
				
			КонецЦикла; // цикл заголовков
			
			// --- 
			
			// получаем
			МассивСообщений = ИнтернетПочта.Выбрать(Ложь,_сф.м_СоздатьИзКолонкиТЗ(ТаблицаЗагружаемыхПисем,"Заголовок"));
			МассивКУдалению = Новый Массив;
			
			
			// записываем
			Для каждого Сообщение Из МассивСообщений Цикл
				// --- 
				
				Попытка
					
					//Сообщение = Новый ИнтернетПочтовоеСообщение; // тмп
					// ищем критерий отбора по идентификатору письма
					СтрокаПисьма = ТаблицаЗагружаемыхПисем.Найти(Сообщение.ИдентификаторСообщения,"Идентификатор");
					Если СтрокаПисьма=Неопределено Тогда
						
						// ахтунг
						Продолжить;
						
					КонецЕсли; 
					
					
					ПисьмоОбъект = Справочники.CW_ЭлектронныеПисьмаДляОбработки.СоздатьЭлемент();
					ПисьмоОбъект.Отправитель = Сообщение.Отправитель.Адрес;
					СписокАдресовПолучателей = Новый СписокЗначений;
					Для каждого Адрес Из Сообщение.Получатели Цикл
						
						СписокАдресовПолучателей.Добавить(СтрокаАдресаПоСтруктуре(СтруктураАдреса(Адрес.Адрес,Адрес.ОтображаемоеИмя)));
						
					КонецЦикла; 
					ПисьмоОбъект.Получатель = _сф.сп_Представление(СписокАдресовПолучателей,",",Ложь);
					ПисьмоОбъект.ДатаОтправления = Сообщение.ДатаОтправления;
					ПисьмоОбъект.ДатаПолучения = Сообщение.ДатаПолучения;
					ПисьмоОбъект.ИдентификаторСообщения = Сообщение.ИдентификаторСообщения;
					ПисьмоОбъект.Тема = Сообщение.Тема;
					// --- 
					Сообщение.ОбработатьТексты();
					КолвоХМЛ=0;
					Для каждого Текст Из Сообщение.Тексты Цикл
						
						Если Найти(НРег(Текст.Текст),"<?xml version") > 0 Тогда
							_сф.Инкремент(КолвоХМЛ); 
							ИмяФайла = СтрЗаменить(Сообщение.Тема,"/","_");
							ИмяФайла = СтрЗаменить(ИмяФайла,":","");
							ИмяФайла = СтрЗаменить(ИмяФайла,"\","_")+КолвоХМЛ+".xml";
							
							Нстр = ПисьмоОбъект.Вложения.Добавить();
							Нстр.ИмяФайла = ИмяФайла;
							Нстр.Расширение = _сф.ф_РасширениеФайла(Нстр.ИмяФайла); // получаем расширение по имени
							Нстр.MIME = " text/xml";
							Нстр.Вложение = Новый ХранилищеЗначения(Текст.Данные);
							
						КонецЕсли;
						
						Нстр = ПисьмоОбъект.Тексты.Добавить();
						Нстр.ТипТекста = Текст.ТипТекста;
						Нстр.Кодировка = Текст.Кодировка;
						Нстр.Текст = Текст.Текст;
						Нстр.ДД = Новый ХранилищеЗначения(Текст.Данные);
						
					КонецЦикла; 
					// --- 
					Для каждого Вложение Из Сообщение.Вложения Цикл
						
						Нстр = ПисьмоОбъект.Вложения.Добавить();
						Нстр.ИмяФайла = Вложение.Имя;
						Нстр.Расширение = _сф.ф_РасширениеФайла(Нстр.ИмяФайла); // получаем расширение по имени
						Нстр.MIME = Вложение.ТипСодержимого;
						Нстр.Вложение = Новый ХранилищеЗначения(Вложение.Данные);
						Нстр.Размер = Вложение.Данные.Размер();
						
					КонецЦикла;
					
					// --- 
					
					ПисьмоОбъект.КритерийОтбора = СтрокаПисьма.Критерий;
					ПисьмоОбъект.Записать();
					
					СтатусОбработки = ПредопределенноеЗначение("Перечисление.CW_СтатусыОбработкиПочтовыхСообщений.Ожидание");;
					РегистрыСведений.CW_СтатусОбработкиЭлектронныхПисем.ЗаписатьСтатусОбработки(ПисьмоОбъект.Ссылка, СтатусОбработки); 
					
					МассивКУдалению.Добавить(Сообщение);
					
					// --- 
					СтрокаПисьма.СтатусЗагрузки = Истина;
					
				Исключение
					// ничего не делаем, сообщение всё ешё помечено как незагруженное
				КонецПопытки; 
				// --- 
			КонецЦикла; // цикл записи сообщений
			
			// --- 
			
			Если МассивКУдалению.Количество() <> 0 Тогда
				
				Для каждого Стр Из МассивКУдалению Цикл
					
					ВМ = Новый Массив;
					ВМ.Добавить(Стр.Идентификатор[0]);
					ИнтернетПочта.Выбрать(Истина,ВМ);
					
				КонецЦикла; 
				
			КонецЕсли; 
			
			// --- 
			ИнтернетПочта.Отключиться();
			// --- 
			
		Исключение
			
			CW_Журнал.ЗаписатьСообщение("Общие.РегламентноеПолучениеПочты","error",Строка(УчетнаяЗапись)+":"+Символы.ПС+ОписаниеОшибки());
			
		КонецПопытки; 
		
	КонецЦикла; // цикл учетных записей 
	
	
	// --- 
КонецФункции

Функция СоответствиеКритерию(Заголовок,Критерий)
	// --- 
	
	// простой вариант
	// формируем список результатов выражений
	
	ТЗ = _сф.т_Создать("Результат,Объединение");
	
	Попытка
		
		Для каждого СтрУсловие Из Критерий.Условия Цикл
			
			Нстр = ТЗ.Добавить();
			
			Если СтрУсловие.Реквизит = "Отправитель" Тогда
				
				РеквизитЗаголовка = Заголовок.Отправитель.Адрес;
				
			ИначеЕсли СтрУсловие.Реквизит = "Тема" Тогда 
				
				РеквизитЗаголовка = Заголовок.Тема;
				
			КонецЕсли; 
			
			Если СтрУсловие.ТипСравнения=Перечисления.CW_ТипыСравнения.Равно Тогда
				
				Нстр.Результат = (РеквизитЗаголовка=СокрЛП(СтрУсловие.Значение));
				
			ИначеЕсли СтрУсловие.ТипСравнения=Перечисления.CW_ТипыСравнения.Содержит Тогда 
				
				Нстр.Результат =  ?(Найти(РеквизитЗаголовка,СокрЛП(СтрУсловие.Значение))=0,Ложь,Истина);
				
			КонецЕсли; 
			
			Нстр.Объединение = СтрУсловие.Объединение; 
			
		КонецЦикла; 
		
	Исключение
		Возврат(Ложь);
	КонецПопытки; 
	
		
	// теперь формируем строку для вычисления
	
	ЛогическаяСтрока = "";
	Для каждого Стр Из ТЗ Цикл
		
		ПредставлениеОбъединения = "";
		Если Стр.Объединение = Перечисления.CW_ТипыОбъединения.И Тогда
			
			ПредставлениеОбъединения="И";
			
		ИначеЕсли Стр.Объединение = Перечисления.CW_ТипыОбъединения.ИЛИ Тогда 
			
			 ПредставлениеОбъединения="ИЛИ";
			
		КонецЕсли; 
		
		ЛогическаяСтрока = ЛогическаяСтрока+?(Стр.Результат,"Истина","Ложь")+" "+ПредставлениеОбъединения+" ";
				
	КонецЦикла; 
	
	// вычисляем
	
	Результат = Ложь;
	Выполнить("Результат="+ЛогическаяСтрока+";");
	
	Возврат(Результат);
	
	
	// --- 
КонецФункции

// ----------------------------------------------------------------------------
// РЗ: обработка полученной почты

// обработка очереди писем
Процедура ОбработатьПисьма() Экспорт 
	// --- 
	
	УстановитьПривилегированныйРежим(Истина);
	
	// тут необходимо проверить, не запущено ли задание
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЭлектронныеПисьмаДляОбработки.Ссылка,
	               |	ЭлектронныеПисьмаДляОбработки.КритерийОтбора
	               |ИЗ
	               |	Справочник.CW_ЭлектронныеПисьмаДляОбработки КАК ЭлектронныеПисьмаДляОбработки
	               |ГДЕ
	               |	ЭлектронныеПисьмаДляОбработки.СтатусОбработки = &СтатусОбработки
	               |	И ЭлектронныеПисьмаДляОбработки.ПометкаУдаления = ЛОЖЬ
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ЭлектронныеПисьмаДляОбработки.ДатаПолучения";
	Запрос.УстановитьПараметр("СтатусОбработки", Перечисления.CW_СтатусыОбработкиПочтовыхСообщений.Ожидание);
	ТЗ = Запрос.Выполнить().Выгрузить();
	
	МассивКритериев = _сф.м_СоздатьИзКолонкиТЗ(ТЗ,"КритерийОтбора");
	СоответствиеОбработок = Новый Соответствие;
	Для каждого Критерий Из МассивКритериев Цикл
		
		СоответствиеОбработок.Вставить(Критерий,_ПО.ПолучитьОбработку(Критерий.Обработка));
		
	КонецЦикла; 
	
	// --- 
	
	Для каждого Стр Из ТЗ Цикл
		
		Попытка
			
			Если Стр.КритерийОтбора.Пустая() Тогда
				
				ВызватьИсключение "Не указан критерий!";
				
			КонецЕсли; 
			
			Обработка = СоответствиеОбработок.Получить(Стр.КритерийОтбора);
			Ответ = Обработка.ОбработатьСообщение(Стр.Ссылка);
			Если Ответ.Код <> 0 Тогда
				
				Попытка
					
					Справочники.CW_СистемныеСообщения.Добавить("Обработка писем","("+Строка(Стр.КритерийОтбора)+")("+_сф.нс_Обернуть(Стр.Ссылка)+") "+Ответ.ОписаниеОшибки);
					
					// устанавливаем статус письма
					Письмо = Стр.Ссылка.ПолучитьОбъект();
					Письмо.СтатусОбработки = _СФ.ст_ПолучитьСвойство(Ответ, "СтатусОбработки", Перечисления.CW_СтатусыОбработкиПочтовыхСообщений.Завершено);
					Письмо.Записать();
					
				Исключение
					Справочники.CW_СистемныеСообщения.Добавить("Обработка писем","("+Строка(Стр.КритерийОтбора)+")("+_сф.нс_Обернуть(Стр.Ссылка)+") "+ОписаниеОшибки());					
				КонецПопытки; 
				
			Иначе
				
				Попытка
					
					// устанавливаем статус письма
					Письмо = Стр.Ссылка.ПолучитьОбъект();
					Письмо.СтатусОбработки = Перечисления.CW_СтатусыОбработкиПочтовыхСообщений.Завершено;
					Письмо.Записать();
					
				Исключение
					Справочники.CW_СистемныеСообщения.Добавить("Обработка писем","("+Строка(Стр.КритерийОтбора)+")("+_сф.нс_Обернуть(Стр.Ссылка)+") "+ОписаниеОшибки());
				КонецПопытки; 
				
			КонецЕсли; 
			
		Исключение
			
			Справочники.CW_СистемныеСообщения.Добавить("Обработка писем","("+Строка(Стр.КритерийОтбора)+")("+_сф.нс_Обернуть(Стр.Ссылка)+") "+ОписаниеОшибки());
			// --- 
			Попытка
				
				// устанавливаем статус письма
				Письмо = Стр.Ссылка.ПолучитьОбъект();
				Письмо.СтатусОбработки = Перечисления.CW_СтатусыОбработкиПочтовыхСообщений.ОшибкаОбработки;
				Письмо.Записать();
				
			Исключение
			    Справочники.CW_СистемныеСообщения.Добавить("Обработка писем","("+Строка(Стр.КритерийОтбора)+")("+_сф.нс_Обернуть(Стр.Ссылка)+") "+ОписаниеОшибки());
			КонецПопытки; 
						
		КонецПопытки; 
		
	КонецЦикла; 
	
	// --- 
КонецПроцедуры

// ---------------------------------------------------------------------------- 
// РЗ: удаление успешно обработанной почты

// регламент пометки на удаление успешно загруженных старше 24 часов
Функция ПометитьНаУдалениеУспешноЗагруженные() Экспорт 
	// --- 
	
	Попытка
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		|	ЭлектронныеПисьмаДляОбработки.Ссылка,
		|	ЭлектронныеПисьмаДляОбработки.ДатаПолучения
		|ИЗ
		|	Справочник.CW_ЭлектронныеПисьмаДляОбработки КАК ЭлектронныеПисьмаДляОбработки
		|ГДЕ
		|	ЭлектронныеПисьмаДляОбработки.СтатусОбработки = &СтатусОбработки
		|	И ЭлектронныеПисьмаДляОбработки.ПометкаУдаления = ЛОЖЬ";
		Запрос.УстановитьПараметр("СтатусОбработки", Перечисления.CW_СтатусыОбработкиПочтовыхСообщений.Завершено);
		ТЗ = Запрос.Выполнить().Выгрузить();
		
		МассивСообщений = Новый Массив;
		
		ТД=ТекущаяДата();
		
		Для каждого Стр Из ТЗ Цикл
			
			// --- 
			
			Если (ТД-Стр.ДатаПолучения) > 60*60*24 Тогда
				
				Попытка
					
					ПисьмоОбъект = Стр.Ссылка.ПолучитьОбъект();
					ПисьмоОбъект.УстановитьПометкуУдаления(Истина);
					
				Исключение
					
					МассивСообщений.Добавить("Ошибка удаления письма "+ПолучитьНавигационнуюСсылку(Стр.Ссылка));
					
				КонецПопытки; 
								
			КонецЕсли; 			
			
			// --- 
			
		КонецЦикла; 
		
		Если МассивСообщений.Количество() <> 0 Тогда
			
			ТекстСообщения = "Ошибки обработки:";
			Для каждого СообщениеМассива Из МассивСообщений Цикл
				
				ТекстСообщения = ТекстСообщения + Символы.ПС + СообщениеМассива;
				
			КонецЦикла; 
			CW_Журнал.ЗаписатьСообщение("Общие.УдалениеЗагруженныхПисем","error",ТекстСообщения);
			
		КонецЕсли; 
		
	Исключение
		
		CW_Журнал.ЗаписатьСообщение("Общие.УдалениеЗагруженныхПисем","error","Ошибка обработки:"+Символы.ПС+ОписаниеОшибки());
		
	КонецПопытки; 
	
	// --- 
КонецФункции

// ---------------------------------------------------------------------------- 
// РЗ: отправка писем из очереди

Процедура ОтправитьПочту(ПараметрыПроцедуры=Неопределено, АдресРезультата=Неопределено) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	// проверяем очередь отправки
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	CW_СтатусОбработкиЭлектронныхПисем.ЭлектронноеПисьмо.Отправитель КАК Отправитель,
	               |	CW_СтатусОбработкиЭлектронныхПисем.ЭлектронноеПисьмо.Дата КАК Дата,
	               |	CW_СтатусОбработкиЭлектронныхПисем.ЭлектронноеПисьмо КАК Ссылка,
	               |	CW_СтатусОбработкиЭлектронныхПисем.ЭлектронноеПисьмо.СсылкаНаОбъект КАК СсылкаНаОбъект
	               |ИЗ
	               |	РегистрСведений.CW_СтатусОбработкиЭлектронныхПисем КАК CW_СтатусОбработкиЭлектронныхПисем
	               |ГДЕ
	               |	CW_СтатусОбработкиЭлектронныхПисем.СтатусОбработки в (&мСтатусОбработки)
	               |	И CW_СтатусОбработкиЭлектронныхПисем.ЭлектронноеПисьмо.ПометкаУдаления = ЛОЖЬ
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Дата
	               |ИТОГИ ПО
	               |	Отправитель
	               |АВТОУПОРЯДОЧИВАНИЕ";    
	
	мСтатусОбработки = Новый Массив;
	мСтатусОбработки.Добавить(ПредопределенноеЗначение("Перечисление.CW_СтатусыОбработкиПочтовыхСообщений.Ожидание"));
	мСтатусОбработки.Добавить(ПредопределенноеЗначение("Перечисление.CW_СтатусыОбработкиПочтовыхСообщений.ОшибкаОбработки"));
	
	Запрос.УстановитьПараметр("мСтатусОбработки", мСтатусОбработки);
	
	РезультатЗапроса  = Запрос.Выполнить();
	
	ВыборкаОтправитель = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	мОбъектыКУдалению = Новый Массив;
	Пока ВыборкаОтправитель.Следующий() Цикл
		
		Попытка
			// подключаемся
			Почта = Новый ИнтернетПочта;
			Почта.Подключиться(ПолучитьПрофильSMTP(ВыборкаОтправитель.Отправитель));
		Исключение
			CW_Журнал.ЗаписатьСообщение("Общие.ОтправкаПочты","error","Ошибка при отправке почты: "+ОписаниеОшибки());
			Продолжить;
		КонецПопытки; 
		
		МассивСообщений = Новый Массив;
		
		ВыборкаДетали = ВыборкаОтправитель.Выбрать();
		Пока ВыборкаДетали.Следующий() Цикл
			Попытка
				Письмо = СформироватьПисьмо(ВыборкаДетали.Ссылка);
			Исключение
				CW_Журнал.ЗаписатьСообщение("Общие.ОтправкаПочты","error","Формирование объекта по письму на отправку:"+Символы.ПС+ОписаниеОшибки());
				Продолжить;
			КонецПопытки; 
			
			Попытка
				Почта.Послать(Письмо);
				СтатусОбработки = ПредопределенноеЗначение("Перечисление.CW_СтатусыОбработкиПочтовыхСообщений.Завершено");
				ЗаписатьДанныеВРегистр(ВыборкаДетали.СсылкаНаОбъект);
				мОбъектыКУдалению.Добавить(ВыборкаДетали.Ссылка);
			Исключение
				СтатусОбработки = ПредопределенноеЗначение("Перечисление.CW_СтатусыОбработкиПочтовыхСообщений.ОшибкаОбработки");
				МассивСообщений.Добавить("Ошибка отправки письма ("+ПолучитьНавигационнуюСсылку(ВыборкаДетали.Ссылка)+"): "+ОписаниеОшибки());
			КонецПопытки; 
			
			РегистрыСведений.CW_СтатусОбработкиЭлектронныхПисем.ЗаписатьСтатусОбработки(ВыборкаДетали.Ссылка, СтатусОбработки) 
		
		КонецЦикла;
		
		Если МассивСообщений.Количество() <> 0 Тогда
			ТекстУведомления = "Ошибка отправки почты учетной записи <"+Строка(ВыборкаОтправитель.Отправитель)+">";
			ТекстУведомления = ТекстУведомления +Символы.ПС+ СтрСоединить(МассивСообщений,Символы.ПС); 
			
			Справочники.CW_СистемныеСообщения.Добавить("ОтправкаПочты", ТекстУведомления);
		КонецЕсли; 
		
		// отключаемся
		Почта.Отключиться();
		
	КонецЦикла;
	
	Для каждого УдаляемаяСсылка из мОбъектыКУдалению Цикл
		ТОбъект = УдаляемаяСсылка.ПолучитьОбъект();
		ТОбъект.Удалить();
	КонецЦикла;
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

Процедура ЗаписатьДанныеВРегистр(СсылкаНаОбъект)
	
	Если Не ЗначениеЗаполнено(СсылкаНаОбъект) Тогда
		Возврат;
	КонецЕсли;
	
	ЗаписьРегистра = РегистрыСведений.CW_ПризнакОтправкиПоЭлектроннойПочте.СоздатьМенеджерЗаписи();
	ЗаписьРегистра.Документ 		= СсылкаНаОбъект;
	
	ЗаписьРегистра.ДатаОтправки 	= ТекущаяДата();
	ЗаписьРегистра.СтатусОтправки 	= ПредопределенноеЗначение("Перечисление.CW_СтатусыОтправкиПоЭлектроннойПочте.Отправлено");
	
	
	ЗаписьРегистра.Записать(Истина);
	
	
КонецПроцедуры

