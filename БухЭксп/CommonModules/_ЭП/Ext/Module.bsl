// РЗ: отправка уведомлений о наличие системных сообщений

Процедура СформироватьУведомленияОСистемныхСообщениях() Экспорт 
	
	УстановитьПривилегированныйРежим(Истина);
	// получаем непрочитанные и неотправленные системные сообщения
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	СистемныеСообщения.Ссылка,
	               |	СистемныеСообщения.Дата,
	               |	СистемныеСообщения.Источник,
	               |	СистемныеСообщения.Сообщение
	               |ИЗ
	               |	Справочник.CW_СистемныеСообщения КАК СистемныеСообщения
	               |ГДЕ
	               |	СистемныеСообщения.ПометкаУдаления = ЛОЖЬ
	               |	И СистемныеСообщения.Отправлено = ЛОЖЬ
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	СистемныеСообщения.Дата УБЫВ";
	ТЗ = Запрос.Выполнить().Выгрузить();
	Если ТЗ.Количество() <> 0 Тогда
		
		// --- 
		
		// формируем письмо
		
		// проверяем, что указана системная учетная запись и адрес дежурного администратора
		СистемнаяУчетнаяЗапись = Неопределено;
		//СистемнаяУчетнаяЗапись = МенеджерНастроек.ПолучитьПараметрИС(ПланыВидовХарактеристик.НастройкиИнформационнойСистемы.СистемнаяУчетнаяЗапись);
		Если СистемнаяУчетнаяЗапись=Неопределено Тогда
			
			Справочники.CW_СистемныеСообщения.Добавить("ОтправкаПочты","Формирование уведомления о системных сообщениях: не задана системная учетная запись!");
			Возврат;
			
		КонецЕсли; 
		// --- 
		АдресАдминистратора = Неопределено;
		Если АдресАдминистратора = Неопределено Тогда
			
			Справочники.CW_СистемныеСообщения.Добавить("ОтправкаПочты","Формирование уведомления о системных сообщениях: не задана адрес дежурного администратора!");
			Возврат;
			
		КонецЕсли; 
		
		// --- 
		
		Письмо = Справочники.CW_ЭлектронныеПисьмаДляОтправки.СоздатьЭлемент();
		Письмо.Отправитель=СистемнаяУчетнаяЗапись;
		// --- 
		МассивАдресов = _ЭП.МассивАдресовПоСтроке(АдресАдминистратора);
		Для каждого Элемент Из МассивАдресов Цикл
			
			Нстр = Письмо.Получатели.Добавить();
			Нстр.Вид=Перечисления.CW_ВидыПолучателейЭлектронныхПисем.Получатель;
			Нстр.Адрес = Элемент.Адрес;
			Нстр.ОтображаемоеИмя = Элемент.ОтображаемоеИмя;
						
		КонецЦикла;
		// --- 
		
		ИдентификаторИБ = Неопределено;
		Письмо.Тема = "";
		_сф.стр_Добавить(Письмо.Тема,?(ИдентификаторИБ=Неопределено,"","["+ИдентификаторИБ+"]"));
		_сф.стр_Добавить(Письмо.Тема," Системные сообщения");
		_сф.стр_Добавить(Письмо.Тема," ("+Формат(ТЗ.Количество(),"ЧЦ=10; ЧДЦ=0")+")");
		// --- 
		
		// сформируем текст письма:
		
		ШаблонУведомления = Справочники.CW_СистемныеСообщения.ПолучитьМакет("ШаблонУведомления").ПолучитьТекст();
		ШаблонСообщения = Справочники.CW_СистемныеСообщения.ПолучитьМакет("ШаблонСообщения").ПолучитьТекст();
		
		СсылкаИБ = ПолучитьНавигационнуюСсылкуИнформационнойБазы();
		
		ТелоСообщения="";
		Для каждого Стр Из ТЗ Цикл
			
			СодержимоеБлока = "";
			// выводим дату и тип жирной строкой,
			_сф.стр_Добавить(СодержимоеБлока,"<a href="+СсылкаИБ+"#"+ПолучитьНавигационнуюСсылку(Стр.Ссылка)+">"+Формат(Стр.Дата,"ДФ='yyyy.MM.dd HH:mm:ss'")+" : "+СокрЛП(Стр.Источник)+"</a><br/>"+Символы.ПС);
			
			// необходимо найти в теле сообщения навигационные ссылки и заменить их представление
			// ищем по критерию {}
			
			ТекстСообщения = Стр.Сообщение;
			СписокСсылок = _сф.стр_СписокМакросов(Стр.Сообщение,"{}");
			Для каждого Ссылка Из СписокСсылок Цикл
				
				ТекстСообщения = _сф.стр_Заменить(ТекстСообщения,_сф.стр_Обернуть(Ссылка,"{}"),"<a href="+СсылкаИБ+"#"+Ссылка+">"+_сф.нс_ПредставлениеСсылки(Ссылка)+"</a>");
				
			КонецЦикла; 
			
			// оставляем возможность указывать ссылки в простых скобках
			СписокСсылок = _сф.стр_СписокМакросов(Стр.Сообщение,"()");
			Для каждого Ссылка Из СписокСсылок Цикл
				
				Если Найти(Ссылка,"e1cib")=1 Тогда
					
					ТекстСообщения = _сф.стр_Заменить(ТекстСообщения,_сф.стр_Обернуть(Ссылка,"()"),"<a href="+СсылкаИБ+"#"+Ссылка+">"+_сф.нс_ПредставлениеСсылки(Ссылка)+"</a>");
					
				КонецЕсли; 
				
			КонецЦикла;
			
			
			_сф.стр_Добавить(СодержимоеБлока,ТекстСообщения+Символы.ПС);
			// подставляем в шаблон сообщения
			СодержимоеБлока = _сф.стр_Заменить(ШаблонСообщения,"%text%",СодержимоеБлока);
			_сф.стр_Добавить(ТелоСообщения,СодержимоеБлока+Символы.ПС);
			
		КонецЦикла; 
		
		// подставляем текст письма в шаблон письма
		ТелоСообщения = _сф.стр_Заменить(ШаблонУведомления,"%text%",ТелоСообщения);
		
		// --- 
		ТекстПисьма = Письмо.Тексты.Добавить();
		ТекстПисьма.Текст = ТелоСообщения;
		ТекстПисьма.ТипТекста= "html"; // richtext,html

		Письмо.Записать();
		
		// --- 
		
	КонецЕсли; 
	
	// помечаем сообщения как отправленные
	Для каждого Стр Из ТЗ Цикл
		
		Сообщение = Стр.Ссылка.ПолучитьОбъект();
		Сообщение.Отправлено = Истина;
		Сообщение.Записать();
		
	КонецЦикла; 
	
	// --- 
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

