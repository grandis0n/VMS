Функция ПолучитьПрофильPOP3(УчетнаяЗапись) Экспорт
	// --- 
	
	// Инициализация параметров учетной записи...
	//-------------------------------------------
	ИПП = Новый ИнтернетПочтовыйПрофиль;
	
	ИПП.АдресСервераPOP3	= УчетнаяЗапись.АдресСервераPOP3;
	ИПП.Пользователь		= УчетнаяЗапись.Пользователь;
	ИПП.Пароль				= УчетнаяЗапись.Пароль;
	ИПП.ИспользоватьSSLPOP3 = УчетнаяЗапись.POPSSL;
	_сф.УстановитьПоУсловию(ИПП.ПортPOP3,УчетнаяЗапись.ПортPOP3);
		
	Возврат(ИПП);
	
	// --- 
КонецФункции

Функция ПолучитьПрофильSMTP(УчетнаяЗапись) Экспорт 
	// --- 
	
	// профиль...
	//-----------
	ИПП = Новый ИнтернетПочтовыйПрофиль;
	ИПП.АдресСервераSMTP = СокрЛП(УчетнаяЗапись.АдресСервераSMTP);
	_сф.УстановитьПоУсловию(ИПП.ПортSMTP,УчетнаяЗапись.ПортSMTP);
	ИПП.ИспользоватьSSLSMTP = УчетнаяЗапись.SMTPSSL;
	
	Если УчетнаяЗапись.АутентификацияSMTP Тогда
		
		ИПП.АутентификацияSMTP = СпособSMTPАутентификации.ПоУмолчанию;
		ИПП.ПользовательSMTP = СокрЛП(УчетнаяЗапись.ПользовательSMTP);
		ИПП.ПарольSMTP = СокрЛП(УчетнаяЗапись.ПарольSMTP);
		
	Иначе
		
		ИПП.АутентификацияSMTP = СпособSMTPАутентификации.БезАутентификации;
		
	КонецЕсли; 
	
	ИПП.ВремяОжидания = 20;
	
    Возврат(ИПП);
	
	// --- 
КонецФункции  

Функция ПолучитьПрофильIMAP(УчетнаяЗапись) Экспорт 
	
	// профиль...
	//-----------
	ПочтовыйПрофиль = Новый ИнтернетПочтовыйПрофиль;
	ПочтовыйПрофиль.АдресСервераIMAP 	= СокрЛП(УчетнаяЗапись.АдресСервераIMAP);
	ПочтовыйПрофиль.ПортIMAP 			= СокрЛП(УчетнаяЗапись.ПортIMAP);
	ПочтовыйПрофиль.ИспользоватьSSLIMAP = УчетнаяЗапись.ИспользоватьSSLIMAP;
	
	Если УчетнаяЗапись.АутентификацияSMTP Тогда  
		ПочтовыйПрофиль.ПарольIMAP 			= УчетнаяЗапись.ПарольSMTP;
		ПочтовыйПрофиль.ПользовательIMAP 	= СокрЛП(УчетнаяЗапись.ПользовательSMTP);
	Иначе
		ПочтовыйПрофиль.ПарольIMAP 			= УчетнаяЗапись.Пароль;
		ПочтовыйПрофиль.ПользовательIMAP 	= СокрЛП(УчетнаяЗапись.Пользователь);
	КонецЕсли;
	
	ПочтовыйПрофиль.ВремяОжидания = 20;
	
    Возврат ПочтовыйПрофиль;
	
КонецФункции


