	Возврат Показатели;
КонецФункции

Функция ПоказателиКосвенныеНалогиФорма2026Кв2(СтрокаДанных) Экспорт
	
	Показатели = Новый Структура;
	Показатели.Вставить("П000030001003", СтрокаДанных.КодПоОКТМО);
	Показатели.Вставить("П00003М102000", СтрокаДанных.КБК);
	Показатели.Вставить("П00003М103100", СтрокаДанных.СуммаОбеспечительногоПлатежа);
	Показатели.Вставить("П00003М204000", СтрокаДанных.СтранаРегистрации);
	Показатели.Вставить("П00003М300001", СтрокаДанных.КодВидаПодакцизногоТовара);
	Показатели.Вставить("П00003М300002", СтрокаДанных.ЕдиницаИзмеренияТНВЭД);
	
	Если НужноЗаполнитьГрафы345(СтрокаДанных.КодВидаПодакцизногоТовара) Тогда 
		Если СтрокаДанных.КБК = "18210402060011000110" Тогда
			Показатели.Вставить("П00003М300003", СтрокаДанных.КоэффициентПересчета);
		Иначе
			Показатели.Вставить("П00003М300003", СтрокаДанных.ПроцентСпиртаВПродукции);
		КонецЕсли;
		
		Если СтрокаДанных.КодВидаПодакцизногоТовара = "290" ИЛИ
			СтрокаДанных.КодВидаПодакцизногоТовара = "299" Тогда
			КоличествоПоТНВЭД = СтрокаДанных.КоличествоПоТНВЭД;
			
			Если СтрокаДанных.ЕдиницаИзмеренияТНВЭД = "831"
				И ЗначениеЗаполнено(СтрокаДанных.ПроцентСпиртаВПродукции)
				И СтрокаДанных.ПроцентСпиртаВПродукции <> 0 Тогда
				КоличествоПоТНВЭД = КоличествоПоТНВЭД / (СтрокаДанных.ПроцентСпиртаВПродукции / 100);
			КонецЕсли;
			
			Показатели.Вставить("П00003М300004", КоличествоПоТНВЭД);
		Иначе
			Показатели.Вставить("П00003М300004", СтрокаДанных.Количество);
		КонецЕсли;
	Иначе
		Показатели.Вставить("П00003М300003", "0");
		Показатели.Вставить("П00003М300004", "0");
	КонецЕсли;
	Показатели.Вставить("П00003М305000", СтрокаДанных.СуммаАкциза);
	
	Возврат Показатели; 
	
КонецФункции

Функция ДанныеРегОтчетов(ПараметрыОтчета, ВидДекларации)

	Организация = ПараметрыОтчета.Организация;
	ДатаНачала = НачалоМесяца(ПараметрыОтчета.мДатаНачалаПериодаОтчета);
	ДатаКонца = КонецМесяца(ПараметрыОтчета.мДатаКонцаПериодаОтчета);    
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Товары.Ссылка КАК Ссылка,
	|	Товары.Номенклатура КАК Номенклатура,
	|	СУММА(Товары.КоличествоПоТНВЭД) КАК КоличествоПоТНВЭД,
	|	МАКСИМУМ(Товары.КодТНВЭД.ЕдиницаИзмерения.Код) КАК ЕдиницаИзмеренияТНВЭД,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА Товары.Ссылка.Контрагент.СтранаРегистрации.УчастникЕАЭС
	|				ТОГДА Товары.Ссылка.Контрагент.СтранаРегистрации.Код
	|			ИНАЧЕ """"
	|		КОНЕЦ) КАК СтранаРегистрации
	|ПОМЕСТИТЬ ТоварыЗаявления
	|ИЗ
	|	Документ.ЗаявлениеОВвозеТоваров.Товары КАК Товары
	|ГДЕ
	|	Товары.Ссылка.Организация = &Организация
	|
	|СГРУППИРОВАТЬ ПО
	|	Товары.Ссылка,
	|	Товары.Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Акцизы.Номенклатура КАК Номенклатура,
	|	СУММА(Акцизы.Количество) КАК Количество,
	|	СУММА(Акцизы.СуммаАкциза) КАК СуммаАкциза,
	|	Акцизы.Номенклатура.КодВидаПодакцизногоТовара.Код КАК КодВидаПодакцизногоТовара,
	|	Акцизы.Номенклатура.ПроцентСпиртаВПродукции КАК ПроцентСпиртаВПродукции,
	|	Акцизы.Организация.РегистрацияВНалоговомОргане.КодПоОКТМО КАК КодПоОКТМО,
	|	ВЫБОР
	|		КОГДА Акцизы.Номенклатура.ЕдиницаИзмеренияДляРасчетаАкциза.Код = ""214""
	|			ТОГДА Акцизы.Номенклатура.КоэффициентПересчета / 0.75
	|		ИНАЧЕ Акцизы.Номенклатура.КоэффициентПересчета
	|	КОНЕЦ КАК КоэффициентПересчета,
	|	ТоварыЗаявления.ЕдиницаИзмеренияТНВЭД КАК ЕдиницаИзмеренияТНВЭД,
	|	ТоварыЗаявления.СтранаРегистрации КАК СтранаРегистрации,
	|	ТоварыЗаявления.КоличествоПоТНВЭД КАК КоличествоПоТНВЭД
	|ИЗ
	|	РегистрСведений.ОперацииСПодакцизнымиТоварами КАК Акцизы
	|		ЛЕВОЕ СОЕДИНЕНИЕ ТоварыЗаявления КАК ТоварыЗаявления
	|		ПО Акцизы.Регистратор = ТоварыЗаявления.Ссылка
	|			И Акцизы.Номенклатура = ТоварыЗаявления.Номенклатура
	|ГДЕ
	|	Акцизы.Период МЕЖДУ &ДатаНачала И &ДатаКонца
	|	И Акцизы.Организация = &Организация
	|	И Акцизы.ВидДекларации = &ВидДекларации
	|
	|СГРУППИРОВАТЬ ПО
	|	Акцизы.Номенклатура,
	|	Акцизы.Номенклатура.КодВидаПодакцизногоТовара.Код,
	|	Акцизы.Номенклатура.ПроцентСпиртаВПродукции,
	|	Акцизы.Организация.РегистрацияВНалоговомОргане.КодПоОКТМО,
	|	ТоварыЗаявления.ЕдиницаИзмеренияТНВЭД,
	|	ТоварыЗаявления.СтранаРегистрации,
	|	ТоварыЗаявления.КоличествоПоТНВЭД,
	|	ВЫБОР
	|		КОГДА Акцизы.Номенклатура.ЕдиницаИзмеренияДляРасчетаАкциза.Код = ""214""
	|			ТОГДА Акцизы.Номенклатура.КоэффициентПересчета / 0.75
	|		ИНАЧЕ Акцизы.Номенклатура.КоэффициентПересчета
	|	КОНЕЦ";
	Запрос.УстановитьПараметр("ДатаНачала", ДатаНачала);
	Запрос.УстановитьПараметр("ДатаКонца", КонецДня(ДатаКонца));
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ВидДекларации", ВидДекларации);
	Результат = Запрос.Выполнить().Выгрузить();
	
	ЗапросДОПП = Новый Запрос;
	ЗапросДОПП.Текст =
	"ВЫБРАТЬ
	|	КосвенныеНалогиСведенияИзДОПП.КБК КАК КБК,
	|	СУММА(КосвенныеНалогиСведенияИзДОПП.СуммаНалогаАкциза) КАК СуммаНалогаАкциза
	|ИЗ
	|	РегистрСведений.КосвенныеНалогиСведенияИзДОПП КАК КосвенныеНалогиСведенияИзДОПП
	|ГДЕ
	|	КосвенныеНалогиСведенияИзДОПП.Организация = &Организация
	|	И КосвенныеНалогиСведенияИзДОПП.Период МЕЖДУ &НачалоПериода И &КонецПериода
	|
	|СГРУППИРОВАТЬ ПО
	|	КосвенныеНалогиСведенияИзДОПП.КБК";
	
	ЗапросДОПП.УстановитьПараметр("Организация", Организация);
	ЗапросДОПП.УстановитьПараметр("НачалоПериода", ДатаНачала);
	ЗапросДОПП.УстановитьПараметр("КонецПериода", КонецДня(ДатаКонца));
	
	РезультатДОПП = ЗапросДОПП.Выполнить().Выгрузить();
	
	Результат.Колонки.Добавить("СуммаОбеспечительногоПлатежа");
	СоответствиеПоКБК = Новый Соответствие;
	
	Для Каждого СтрокаДОПП Из РезультатДОПП Цикл
		СоответствиеПоКБК.Вставить(
		СтрокаДОПП.КБК,
		СтрокаДОПП.СуммаНалогаАкциза);
	КонецЦикла;
	
	Результат.Колонки.Добавить("КБК");
	
	Для Каждого Строка Из Результат Цикл
		Строка.КБК = КБККосвенныеНалогиПоВидуТовара(
		Строка.КодВидаПодакцизногоТовара);
	КонецЦикла;
	Для Каждого Строка Из Результат Цикл
		Если СоответствиеПоКБК.Получить(Строка.КБК) <> Неопределено Тогда
			Строка.СуммаОбеспечительногоПлатежа =
			СоответствиеПоКБК.Получить(Строка.КБК);
		Иначе
			Строка.СуммаОбеспечительногоПлатежа = 0;
		КонецЕсли;
	КонецЦикла;
	
	ДанныеАкцизы = Новый Структура;
	ДанныеАкцизы.Вставить("ДанныеПоказателей", Результат);
	
	Возврат ДанныеАкцизы;
	
КонецФункции

