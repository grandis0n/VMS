Процедура ЗаполнитьРазделАкцизовРегламентированныйОтчетКосвенныеНалогиФорма2026Кв2(ПараметрыОтчета, Контейнер) Экспорт
	
	ПараметрыЗаполнения = ОбщегоНазначения.СкопироватьРекурсивно(ПараметрыОтчета);
	ПараметрыЗаполнения.Вставить("ЗнакиДробнойЧасти", 5);
	
	Раздел3 = Контейнер.Раздел3;
	СтрокиРаздел3 = Раздел3.Строки[0];
	ДанныеРаздела = СтрокиРаздел3.Данные;
	ОчиститьСтроку(ДанныеРаздела);
	СтруктураНовойТаблицы = Новый Структура();
	Для Каждого Показатель Из ДанныеРаздела Цикл
		СтруктураНовойТаблицы.Вставить(Показатель.Ключ,
		ОбщегоНазначенияБПКлиентСервер.ПустоеЗначениеТипа(ТипЗнч(Показатель.Значение)));
	КонецЦикла;
	Пока Раздел3.Строки.Количество() > 1 Цикл
		Раздел3.Строки.Удалить(1);
	КонецЦикла;
	ТекущийКБК = Неопределено;
	ТекущийВидТовара = Неопределено;
	ДанныеОтчета = ДанныеРегОтчетов(ПараметрыЗаполнения, Перечисления.ВидыДекларацийПоПодакцизнымТоварам.ДекларацияКосвенныеНалогиТС);
	ДанныеОтчета.ДанныеПоказателей.Сортировать("КБК, КодВидаПодакцизногоТовара");
	СтрокаРаздел3 = Раздел3.Строки[0];
	ГруппыПоКБК = СтрокаРаздел3.ДанныеМногострочныхЧастей.П00003М1.Строки;
	
	Если ДанныеОтчета.ДанныеПоказателей.Количество() = 0 Тогда
		Пока ГруппыПоКБК.Количество() > 1 Цикл
			ГруппыПоКБК.Удалить(1);
		КонецЦикла;
		ОчиститьСтроку(ГруппыПоКБК[0].Данные);
		Пока ГруппыПоКБК[0].ДанныеМногострочныхЧастей.П00003М2.Строки.Количество() > 1 Цикл
			ГруппыПоКБК[0].ДанныеМногострочныхЧастей.П00003М2.Строки.Удалить(1);
		КонецЦикла;
		ОчиститьСтроку(ГруппыПоКБК[0].ДанныеМногострочныхЧастей.П00003М2.Строки[0].Данные);
		СтрокиП00003М3 = ГруппыПоКБК[0].ДанныеМногострочныхЧастей.П00003М2.Строки[0].ДанныеМногострочныхЧастей.П00003М3.Строки;
		Пока СтрокиП00003М3.Количество() > 1 Цикл
			СтрокиП00003М3.Удалить(1);
		КонецЦикла;
		Если СтрокиП00003М3.Количество() = 1 Тогда
			ОчиститьСтроку(СтрокиП00003М3[0].Данные);
		КонецЕсли;
		ПоместитьВоВременноеХранилище(Контейнер, ПараметрыОтчета.АдресВоВременномХранилище);
		Возврат;
	КонецЕсли;
	
	Пока ГруппыПоКБК.Количество() > 1 Цикл
		ГруппыПоКБК.Удалить(1);
	КонецЦикла;
	
	ОчиститьСтроку(ГруппыПоКБК[0].Данные);
	
	Пока ГруппыПоКБК[0].ДанныеМногострочныхЧастей.П00003М2.Строки.Количество() > 0 Цикл
		ГруппыПоКБК[0].ДанныеМногострочныхЧастей.П00003М2.Строки.Удалить(0);
	КонецЦикла;
	
	Для Каждого СтрокаДанных Из ДанныеОтчета.ДанныеПоказателей Цикл
		Если ТекущийКБК <> СтрокаДанных.КБК
			Или (Не ЗначениеЗаполнено(СтрокаДанных.КБК)
			И ТекущийВидТовара <> СтрокаДанных.КодВидаПодакцизногоТовара) Тогда
			Если ТекущийКБК = Неопределено Тогда
				ГруппаПоКБК = ГруппыПоКБК[0];
			Иначе
				ГруппаПоКБК = ГруппыПоКБК.Добавить();
				ГруппаПоКБК.Данные = Новый Структура();
				ГруппаПоКБК.ДанныеМногострочныхЧастей =
				Новый Структура("П00003М2", ДеревоЗначенийРегОтчет());
			КонецЕсли;
			ГруппаПоКБК.Данные.Вставить("П00003М1", СтрокаДанных.КБК);
			ТекущийКБК = СтрокаДанных.КБК;
		Иначе
			ГруппаПоКБК = СтрокаРаздел3.ДанныеМногострочныхЧастей.П00003М1.Строки[
			СтрокаРаздел3.ДанныеМногострочныхЧастей.П00003М1.Строки.Количество()-1];
		КонецЕсли; 
		СтрокаПоСтране = ГруппаПоКБК.ДанныеМногострочныхЧастей.П00003М2.Строки.Добавить();
		СтрокаПоСтране.Данные = Новый Структура();
		СтрокаПоСтране.ДанныеМногострочныхЧастей = Новый Структура(
		"П00003М3", ДеревоЗначенийРегОтчет()); 
		СтрокаТовара = СтрокаПоСтране.ДанныеМногострочныхЧастей.П00003М3.Строки.Добавить();
		СтрокаТовара.Данные = Новый Структура();
		СтрокаТовара.ДанныеМногострочныхЧастей = Новый Структура();
		ЗаполнитьРаздел3РегОтчетаКосвенныеНалогиФорма2026Кв2(ДанныеРаздела, ГруппаПоКБК, СтрокаПоСтране, СтрокаТовара, СтрокаДанных);
	КонецЦикла;
	
	ПоместитьВоВременноеХранилище(Контейнер, ПараметрыОтчета.АдресВоВременномХранилище);
КонецПроцедуры

Процедура ЗаполнитьРаздел2РегОтчетаАкцизыАлко(Раздел2, СтраницаРаздел2, СтрокаНачисления, СтрокаУплаты, СтрокаДанныеПоказателей) 
	
	Показатели = ПоказателиАкцизыАлко(СтрокаДанныеПоказателей);
	СтраницаРаздел2.П000020001003 = СтрокаДанныеПоказателей.КодВидаПодакцизногоТовара;
	СтраницаРаздел2.П000020002003 = СтрокаДанныеПоказателей.КБК;
	СтрокаНачисления.Данные.Вставить("П00021М100001", Показатели.П00021М100001);
	Если Показатели.П00021М100001 = "10001" Тогда
		СтрокаНачисления.Данные.Вставить("П00021М100002", Показатели.П00021М100002);
	КонецЕсли;
	СтрокаНачисления.Данные.Вставить("П00021М100003", Показатели.П00021М100003);
	СтрокаНачисления.Данные.Вставить("П00021М100004", Показатели.П00021М100004);
	СтрокаУплаты.Данные.Вставить("П00024М100001", Показатели.П00024М100001);
	ЗначениеПоказателя = Неопределено;
	Если СтрокаУплаты.Данные.Свойство("П00024М100002", ЗначениеПоказателя)
		И ЗначениеЗаполнено(ЗначениеПоказателя) Тогда
		СтрокаУплаты.Данные.Вставить("П00024М100002", ЗначениеПоказателя);
	Иначе
		СтрокаУплаты.Данные.Вставить("П00024М100002", 0);
	КонецЕсли;
	
