Процедура СформироватьДвиженияНачисленияАкцизовПриВвозеИзЕАЭС(ТаблицаАкцизов, Реквизиты, Движения) Экспорт
	
	Если Не ЗначениеЗаполнено(ТаблицаАкцизов) Или Не ЗначениеЗаполнено(Реквизиты) Тогда
		Возврат;
	КонецЕсли;
	
	СтрокаРеквизитов              = Реквизиты[0];
	ПартионныйУчет                = УчетнаяПолитика.СпособОценкиМПЗ(СтрокаРеквизитов.Организация, СтрокаРеквизитов.Период) = Перечисления.СпособыОценки.ФИФО;
	ЕстьПодразделениеВТаблице     = ТаблицаАкцизов.Колонки.Найти("Подразделение") <> Неопределено;
	ЕстьПодразделениеВШапке       = Реквизиты.Колонки.Найти("ПодразделениеОрганизации") <> Неопределено;
	
	ОбщаяСуммаАкциза = Окр(ТаблицаАкцизов.Итог("СуммаАкциза"));
	Если СтрокаРеквизитов.Период > '20260701' Тогда
		// Округляем проводку по начислению акциза с 1 июля 2026 года.
		КоличествоСтрок = ТаблицаАкцизов.Количество();
		Если КоличествоСтрок > 0 
			И ОбщаяСуммаАкциза > 0
			И ОбщаяСуммаАкциза <> ТаблицаАкцизов.Итог("СуммаАкциза") Тогда
			МассивКоэффициентов = ТаблицаАкцизов.ВыгрузитьКолонку("СуммаАкциза");
			МассивСумм = ОбщегоНазначенияБПКлиентСервер.РаспределитьПропорционально(
				ОбщаяСуммаАкциза, МассивКоэффициентов);
			Для НомерСтроки = 0 По КоличествоСтрок - 1 Цикл
				ТаблицаАкцизов[НомерСтроки].СуммаАкциза = МассивСумм[НомерСтроки];
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
	ТаблицаАкцизовНачисление = ТаблицаАкцизов.Скопировать();
	ТаблицаАкцизовНачисление.Свернуть("СчетАкциза, СубконтоАкцизы, ДатаПринятияНаУчет, МаркируемаяПродукция, ПрименяетсяДОПП", "СуммаАкциза");
	
	ВедетсяУчетПоПодразделениям = БухгалтерскийУчетПереопределяемый.ВестиУчетПоПодразделениям();
	
	НачислениеНалоговНаЕНС = ЕдиныйНалоговыйСчет.НовыйНачислениеНалоговНаЕНС();
	
	Для Каждого СтрокаТаблицы Из ТаблицаАкцизовНачисление Цикл
		
		МесяцУплаты               = ДобавитьМесяц(СтрокаТаблицы.ДатаПринятияНаУчет, 1);
		СрокУплаты                = Дата(Год(МесяцУплаты), Месяц(МесяцУплаты), 20);
		ПроизводственныйКалендарь = КалендарныеГрафики.ОсновнойПроизводственныйКалендарь();
		ГрафикПереноса            = КалендарныеГрафики.БлижайшиеРабочиеДаты(ПроизводственныйКалендарь,
			ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(СрокУплаты));
		НачислениеКосвенныхНалоговНаЕНСРегламентнымДокументом = УчетНДС.НачислениеКосвенныхНалоговНаЕНСРегламентнымДокументом(
			ГрафикПереноса[СрокУплаты]);
		
		СчетУчетаАкцизаПриВвозеИзЕАЭС = ?(НачислениеКосвенныхНалоговНаЕНСРегламентнымДокументом,
			ПланыСчетов.Хозрасчетный.АкцизТаможенныйСоюзКУплате,
			ПланыСчетов.Хозрасчетный.Акцизы);
		
		// Дт 19.06 Кт 68.43
		Проводка = Движения.Хозрасчетный.Добавить();
		Проводка.Период      = СтрокаРеквизитов.Период;
		Проводка.Организация = СтрокаРеквизитов.Организация;
		Проводка.Содержание  = "Начислен акциз при ввозе товаров из ЕАЭС";
		Проводка.СчетДт      = СтрокаТаблицы.СчетАкциза;
		Проводка.СчетКт      = СчетУчетаАкцизаПриВвозеИзЕАЭС;
		БухгалтерскийУчет.УстановитьСубконто(
			Проводка.СчетКт, Проводка.СубконтоКт, "ВидыПлатежейВГосБюджет", Перечисления.ВидыПлатежейВГосБюджет.Налог);
		БухгалтерскийУчет.УстановитьСубконто(
			Проводка.СчетКт, Проводка.СубконтоКт, "Контрагенты", СтрокаРеквизитов.Контрагент);
		БухгалтерскийУчет.УстановитьСубконто(
			Проводка.СчетКт, Проводка.СубконтоКт, "Договоры", СтрокаРеквизитов.ДоговорКонтрагента);
		БухгалтерскийУчет.УстановитьСубконто(
			Проводка.СчетКт, Проводка.СубконтоКт, "СФПолученные", СтрокаРеквизитов.Регистратор);
		Если ВедетсяУчетПоПодразделениям Тогда
			БухгалтерскийУчет.УстановитьСубконто(
				Проводка.СчетКт, Проводка.СубконтоКт, "РегистрацияВНалоговомОргане", СтрокаТаблицы.СубконтоАкцизы);
		КонецЕсли;
		Проводка.Сумма = СтрокаТаблицы.СуммаАкциза;
		
		// Дт 68.43 Кт 68.90
		Если (НачислениеКосвенныхНалоговНаЕНСРегламентнымДокументом И СтрокаТаблицы.ПрименяетсяДОПП)
		 Или Не ЕдиныйНалоговыйСчет.ЭтоПростойУчет(ГрафикПереноса[СрокУплаты], СтрокаРеквизитов.Организация)
		 Или СтрокаТаблицы.МаркируемаяПродукция = Истина Тогда
			Продолжить;
		КонецЕсли;
		
		УчетНДСПереопределяемый.НачислитьАкцизНаЕНППриВвозеТоваровИзЕАЭС(СтрокаРеквизитов, СтрокаТаблицы, НачислениеНалоговНаЕНС);
		
	КонецЦикла;
	
	СформироватьДвиженияВключениеАкцизаВСтоимость(Движения, ЕстьПодразделениеВТаблице, ЕстьПодразделениеВШапке, ПартионныйУчет, СтрокаРеквизитов, ТаблицаАкцизов);
	
	ЕдиныйНалоговыйСчет.СформироватьДвиженияНачислениеНалоговНаЕНС(НачислениеНалоговНаЕНС, СтрокаРеквизитов, Движения);
	
	Движения.Хозрасчетный.Записывать = Истина;
	
КонецПроцедуры

Процедура СформироватьДвиженияВключениеАкцизаВСтоимость(Движения, ЕстьПодразделениеВТаблице, ЕстьПодразделениеВШапке, ПартионныйУчет, СтрокаРеквизитов, ТаблицаАкцизов)
	
	Для Каждого СтрокаТаблицы Из ТаблицаАкцизов Цикл
		
		Подразделение = Неопределено;
		Если ЕстьПодразделениеВТаблице Тогда
			Подразделение = СтрокаТаблицы.Подразделение;
		ИначеЕсли ЕстьПодразделениеВШапке Тогда
			Подразделение = СтрокаРеквизитов.Подразделение;
		КонецЕсли;
		
		// Проводка Дт Счет учета (41.х или 10.х) Кт 19.06
		Проводка             = Движения.Хозрасчетный.Добавить();
		Проводка.Период      = СтрокаРеквизитов.Период;
		Проводка.Организация = СтрокаРеквизитов.Организация;
		Проводка.Содержание  = "Включение суммы акциза в стоимость";
		Проводка.СчетДт      = СтрокаТаблицы.СчетУчета;
		СвойстваСчета        = БухгалтерскийУчетВызовСервераПовтИсп.ПолучитьСвойстваСчета(СтрокаТаблицы.СчетУчета);
		Для Ном = 1 По СвойстваСчета.КоличествоСубконто Цикл
			Если СвойстваСчета["ВидСубконто" + Ном] = ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.Номенклатура Тогда
				БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетДт, Проводка.СубконтоДт,
					Ном, СтрокаТаблицы.Номенклатура);
			ИначеЕсли СвойстваСчета["ВидСубконто" + Ном] = ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.Склады Тогда
				Если БухгалтерскийУчет.ВедетсяСуммовойУчетПоСкладам(СтрокаТаблицы.СчетУчета) Тогда
					БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетДт, Проводка.СубконтоДт,
						Ном, СтрокаТаблицы.Склад);
				КонецЕсли;
			ИначеЕсли СвойстваСчета["ВидСубконто" + Ном] = ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.Партии Тогда
				Если ПартионныйУчет Тогда
					БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетДт, Проводка.СубконтоДт,
						Ном, СтрокаТаблицы.Партия);
				КонецЕсли; 
			КонецЕсли;
		КонецЦикла;
		Если СвойстваСчета.УчетПоПодразделениям Тогда
			Проводка.ПодразделениеДт = Подразделение;
		КонецЕсли;
		Проводка.СчетКт = СтрокаТаблицы.СчетАкциза;
		Проводка.Сумма  = СтрокаТаблицы.СуммаАкциза;
		
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура НайтиСоздатьКодыПодакцизныхТоваров(ВидТовара, Обновление = Ложь, Перезаписать = Ложь)
	
	Макет = Справочники.КодыВидовПодакцизныхТоваров.ПолучитьМакет("КлассификаторКодов");
	ОбластьПоВидуТовара = Макет.Области.Найти(СтрЗаменить(ВидТовара, " ", ""));
	Если ОбластьПоВидуТовара <> Неопределено Тогда
		ОбластьПоВидуТовара = Макет.ПолучитьОбласть(СтрЗаменить(ВидТовара, " ", ""));
		Если Не Обновление Тогда
			Запрос = Новый Запрос();
			Запрос.Текст = 
			"ВЫБРАТЬ
			|	КодыВидовПодакцизныхТоваров.Ссылка КАК Ссылка
			|ИЗ
			|	Справочник.КодыВидовПодакцизныхТоваров КАК КодыВидовПодакцизныхТоваров
			|ГДЕ
			|	КодыВидовПодакцизныхТоваров.ВидТовара = &ВидТовара
			|	И КодыВидовПодакцизныхТоваров.ПометкаУдаления = ЛОЖЬ";
			Запрос.УстановитьПараметр("ВидТовара", ВидТовара);
			Результат = Запрос.Выполнить().Выбрать();
			Если Результат.Следующий() Тогда
				Возврат;
			КонецЕсли;
		КонецЕсли;
		
		КолвоСтрок = ОбластьПоВидуТовара.ВысотаТаблицы;
		Для Стр = 1 По КолВоСтрок Цикл
			КодВида = ОбластьПоВидуТовара.Область(Стр, 1);
			ВидПодакцизногоТовара = Справочники.КодыВидовПодакцизныхТоваров.НайтиПоКоду(КодВида.Текст);
			Если ВидПодакцизногоТовара = Неопределено Или ВидПодакцизногоТовара = Справочники.КодыВидовПодакцизныхТоваров.ПустаяСсылка() Тогда
				НовыйВид = Справочники.КодыВидовПодакцизныхТоваров.СоздатьЭлемент();
				НовыйВид.Код                = КодВида.Текст;
				НовыйВид.Наименование       = ОбластьПоВидуТовара.Область(Стр, 3).Текст;
				НовыйВид.НаименованиеПолное = ОбластьПоВидуТовара.Область(Стр, 2).Текст;
				НовыйВид.ВидТовара          = ВидТовара;
				Если ОбластьПоВидуТовара.Область(Стр, 4).Текст <> "" Тогда
					НовыйВид.ДействуетС         = СтроковыеФункцииКлиентСервер.СтрокаВДату(ОбластьПоВидуТовара.Область(Стр, 4).Текст, ЧастиДаты.Дата);
				КонецЕсли;
				Если ОбластьПоВидуТовара.Область(Стр, 5).Текст <> "" Тогда
					НовыйВид.ДействуетПо        = СтроковыеФункцииКлиентСервер.СтрокаВДату(ОбластьПоВидуТовара.Область(Стр, 5).Текст, ЧастиДаты.Дата);
				КонецЕсли;
				НовыйВид.Записать();
			ИначеЕсли Перезаписать Тогда
				ПодакцизныйТовар = ВидПодакцизногоТовара.ПолучитьОбъект();
				ПодакцизныйТовар.Код                = КодВида.Текст;
				ПодакцизныйТовар.Наименование       = ОбластьПоВидуТовара.Область(Стр, 3).Текст;
				ПодакцизныйТовар.НаименованиеПолное = ОбластьПоВидуТовара.Область(Стр, 2).Текст;
				ПодакцизныйТовар.ВидТовара          = ВидТовара;
				Если ОбластьПоВидуТовара.Область(Стр, 4).Текст <> "" Тогда
					ПодакцизныйТовар.ДействуетС         = СтроковыеФункцииКлиентСервер.СтрокаВДату(ОбластьПоВидуТовара.Область(Стр, 4).Текст, ЧастиДаты.Дата);
				КонецЕсли;
				Если ОбластьПоВидуТовара.Область(Стр, 5).Текст <> "" Тогда
					ПодакцизныйТовар.ДействуетПо        = СтроковыеФункцииКлиентСервер.СтрокаВДату(ОбластьПоВидуТовара.Область(Стр, 5).Текст, ЧастиДаты.Дата);
				КонецЕсли;

				ПодакцизныйТовар.Записать();

			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

Процедура НайтиСоздатьЕдиницыИзмерения(ВидТовара)
	
	Запрос = Новый Запрос();
	Запрос.Текст = "ВЫБРАТЬ
	|	КлассификаторЕдиницИзмерения.Код КАК Код
	|ИЗ
	|	Справочник.КлассификаторЕдиницИзмерения КАК КлассификаторЕдиницИзмерения
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КодыВидовПодакцизныхТоваров.Код КАК Код
	|ИЗ
	|	Справочник.КодыВидовПодакцизныхТоваров КАК КодыВидовПодакцизныхТоваров";
	Результат = Запрос.ВыполнитьПакет();
	ТаблицаЕдиницИзмерения = Результат[0].Выгрузить();
	ТаблицаКодовТоваров = Результат[1].Выгрузить();
	ДанныеКлассификатора = РегистрыСведений.СтавкиАкцизаПоставляемый.ПолучитьМакет("ПредопределенныеЗначения").ПолучитьТекст();
	Попытка
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(ДанныеКлассификатора);
		ДанныеКлассификатора = ПрочитатьJSON(ЧтениеJSON);
		ЧтениеJSON.Закрыть();
		Для Каждого Элемент Из ДанныеКлассификатора.classifierData Цикл
			КодТовара = Элемент.Код;
			КодЕдИзм  = Элемент.ЕдиницаИзмерения;
			Если Не ЗначениеЗаполнено(КодТовара) Тогда
				Продолжить;
			КонецЕсли;
			КодПодакцизногоТовара = ТаблицаКодовТоваров.Найти(КодТовара, "Код");
			Если КодПодакцизногоТовара = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Если ЗначениеЗаполнено(КодЕдИзм) Тогда
				ЕдиницаИзмерения = ТаблицаЕдиницИзмерения.Найти(КодЕдИзм, "Код");
				Если ЕдиницаИзмерения = Неопределено Тогда
					ЕдиницаИзмерения = Справочники.КлассификаторЕдиницИзмерения.ЕдиницаИзмеренияПоКоду(КодЕдИзм);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;	
	Исключение
		ВызватьИсключение;
		ЗаписьЖурналаРегистрации(
		"Ошибка при загрузке единиц измерения из макета классификатора ставок акциза",
		УровеньЖурналаРегистрации.Ошибка,
		Метаданные.РегистрыСведений.СтавкиАкцизаПоставляемый,
		,
		ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())
		);
		Возврат;	
	КонецПопытки;
	
КонецПроцедуры

Процедура ЗаполнитьРегламентированныйОтчетАкцизыАлкоголь(ИДРедакцииОтчета, ПараметрыОтчета, Контейнер) Экспорт
	
	Если ИДРедакцииОтчета = "ФормаОтчета2025Кв1" Тогда
		
		ЗаполнитьРазделАкцизовРегламентированныйОтчетАкцизыАлкоголь(ПараметрыОтчета, Контейнер);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьРазделАкцизовРегламентированныйОтчетАкцизыАлкоголь(ПараметрыОтчета, Контейнер) Экспорт
	
	ПараметрыЗаполнения = ОбщегоНазначения.СкопироватьРекурсивно(ПараметрыОтчета);
	ПараметрыЗаполнения.Вставить("ЗнакиДробнойЧасти", 5); 
	
	Раздел2 = Контейнер.Раздел2;
	СтрокиРаздел2 = Раздел2.Строки[0];
	СтраницаРаздел2 = СтрокиРаздел2.Данные;
	ОчиститьСтроку(СтраницаРаздел2);
	СтрокиНачислений = СтрокиРаздел2.ДанныеМногострочныхЧастей.П00021М1.Строки;
	СтрокиРеализации = СтрокиРаздел2.ДанныеМногострочныхЧастей.П00022М1.Строки;
	СтрокиВычетов = СтрокиРаздел2.ДанныеМногострочныхЧастей.П00023М1.Строки;
	СтрокиУплаты = СтрокиРаздел2.ДанныеМногострочныхЧастей.П00024М1.Строки;
	СтрокиУточнений = СтрокиРаздел2.ДанныеМногострочныхЧастей.П00241М1.Строки;
	СтрокиИтогов = СтрокиРаздел2.ДанныеМногострочныхЧастей.П00025М1.Строки;
	Пока СтрокиНачислений.Количество() > 1 Цикл
		СтрокиНачислений.Удалить(1);
	КонецЦикла;
	Пока СтрокиРеализации.Количество() > 1 Цикл
		СтрокиРеализации.Удалить(1);
	КонецЦикла;
	Пока СтрокиВычетов.Количество() > 1 Цикл
		СтрокиВычетов.Удалить(1);
	КонецЦикла;
	Пока СтрокиУплаты.Количество() > 1 Цикл
		СтрокиУплаты.Удалить(1);
	КонецЦикла;
	Пока СтрокиУточнений.Количество() > 1 Цикл
		СтрокиУточнений.Удалить(1);
	КонецЦикла;
	Пока СтрокиИтогов.Количество() > 1 Цикл
		СтрокиИтогов.Удалить(1);
	КонецЦикла;
	СтраницаРаздел2Операция21 = СтрокиНачислений[0].Данные;
	ОчиститьСтроку(СтраницаРаздел2Операция21);
	
	СтраницаРаздел2Операция24 = СтрокиУплаты[0].Данные;
	ОчиститьСтроку(СтраницаРаздел2Операция24);
	ПерваяСтраница = Истина;
	Пока Раздел2.Строки.Количество() > 1 Цикл
		Раздел2.Строки.Удалить(1);
	КонецЦикла;
	ОчиститьСтроку(Раздел2.Строки[0].Данные);
	ТекущийКБК = Неопределено;
	ТекущийВидТовара = Неопределено;
	ДанныеОтчета = ДанныеРегОтчетов(ПараметрыЗаполнения, Перечисления.ВидыДекларацийПоПодакцизнымТоварам.ДекларацияАкцизыАлко);
	
	Для Каждого СтрокаДанных Из ДанныеОтчета.ДанныеПоказателей Цикл
		Если ПерваяСтраница 
			Или ТекущийКБК <> СтрокаДанных.КБК 
			Или (Не ЗначениеЗаполнено(СтрокаДанных.КБК) И ТекущийВидТовара <> СтрокаДанных.КодВидаПодакцизногоТовара) Тогда
			СтруктураНовойТаблицы = Новый Структура();
