Процедура СформироватьДвиженияОперацииСПодакцизнымиТоварами(ТаблицаАкцизов, Реквизиты, Движения) Экспорт
	
	Если Не ЗначениеЗаполнено(ТаблицаАкцизов)
	 Или Не ЗначениеЗаполнено(Реквизиты) Тогда
		Возврат;
	КонецЕсли;
	
	СтрокаРеквизитов = Реквизиты[0];
	
	ТаблицаДляЗаписи = ТаблицаАкцизов.Скопировать();
	ТаблицаДляЗаписи.Свернуть("Номенклатура, ВидДекларации, ДатаПринятияНаУчет", "Количество, СуммаАкциза");
	
	Для Каждого Строка Из ТаблицаДляЗаписи Цикл
		Если Не ЗначениеЗаполнено(Строка.ВидДекларации) Тогда
			Продолжить;
		КонецЕсли;
		Проводка = Движения.ОперацииСПодакцизнымиТоварами.Добавить();
		Если ЗначениеЗаполнено(Строка.ДатаПринятияНаУчет) Тогда
			Проводка.Период = Строка.ДатаПринятияНаУчет;
		Иначе
			Проводка.Период = СтрокаРеквизитов.Период;
		КонецЕсли;
		Проводка.Организация   = СтрокаРеквизитов.Организация;
		Проводка.Номенклатура  = Строка.Номенклатура;
		Проводка.Количество    = Строка.Количество;
		Проводка.СуммаАкциза   = Строка.СуммаАкциза;
		Проводка.ВидДекларации = Строка.ВидДекларации;
	КонецЦикла;
	
	Движения.ОперацииСПодакцизнымиТоварами.Записывать = Истина;
	
КонецПроцедуры

