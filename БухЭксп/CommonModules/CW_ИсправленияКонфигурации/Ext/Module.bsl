Функция ОбработатьZIPФайлДополнений(ЛокальныйПуть) Экспорт
	
	ТаблицаЗначений = ВыполнитьЗагрузкуСпискаДополнений(ЛокальныйПуть);
	
	Если ТаблицаЗначений <> Неопределено Тогда
		ТаблицаДоступныхОбновлений = ПолучитьТаблицуДоступныхДополнений(ТаблицаЗначений);
	КонецЕсли;   
	
	Возврат ТаблицаДоступныхОбновлений;
	
КонецФункции

Функция ВыполнитьЗагрузкуСпискаДополнений(ПутьКФайлуАрхива)  
	
	ИмяФайлаЗагрузки = РаспаковатьАрхив(ПутьКФайлуАрхива, ИмяфайлаШаблонаДополнений());

	Файл = Новый Файл(ИмяФайлаЗагрузки);
	Файл.Существует();
	
	
	Попытка      
		
		ТаблицаЗначений = ПустаяТаблицаРасширений();
		
		ТаблицаЗначений.Колонки.Добавить("ВерсияРазряд1",	Новый ОписаниеТипов("Число"));  
		ТаблицаЗначений.Колонки.Добавить("ВерсияРазряд2",	Новый ОписаниеТипов("Число"));  
		
		ТаблицаЗначений.Колонки.Добавить("ВерсияМодуля",	Новый ОписаниеТипов("Строка"));  
		ТаблицаЗначений.Колонки.Добавить("ВерсияБП",		Новый ОписаниеТипов("Строка"));  
		
		ЧтениеXML = Новый ЧтениеXML;
		ЧтениеXML.ОткрытьФайл(ИмяФайлаЗагрузки);

		Свойства = ФабрикаXDTO.ПрочитатьXML(ЧтениеXML, ФабрикаXDTO.Тип("ftp://ftp.coralway.ru/Extension", "af8"));   
		Для Каждого Свойства_extension из  Свойства.extension Цикл   
			мДоступныеКонфигурации = Новый Массив;  
			
			ИмяРасширения		= Свойства_extension.name;
			Версия 				= Свойства_extension.version; 
			
			мВерсия = СтрРазделить(Версия, ".");    
			ВерсияРазряд1 = Число(мВерсия[0]);
			ВерсияРазряд2 = Число(мВерсия[1]);
			
			Описание			= Свойства_extension.description;
			АдресФайла 			= Свойства_extension.file;   
			Размер 				= Свойства_extension.size;  
			ВерсияБП 			= Свойства_extension.targetacc;  
			
			мВерсияБП = СтрРазделить(ВерсияБП, ".");    
			ВерсияБПРазряд1 = Число(мВерсияБП[0]);
			ВерсияБПРазряд2 = Число(мВерсияБП[1]);
			ВерсияБПРазряд3 = Число(мВерсияБП[2]);
			ВерсияБПРазряд4 = Число(мВерсияБП[3]);
			
			мВесрииМодуля = новый Массив;
			Если ТипЗнч(Свойства_extension.Target) = Тип("СписокXDTO") Тогда
				Для Каждого ВерсияМодуля Из Свойства_extension.Target Цикл 
					мВесрииМодуля.Добавить(ВерсияМодуля);
				КонецЦикла;
			КонецЕсли;
			Если ТипЗнч(Свойства_extension.Target) = Тип("Строка") Тогда
				мВесрииМодуля.Добавить(Свойства_extension.Target);
			КонецЕсли;
			
			Для Каждого ВерсияМодуля из мВесрииМодуля Цикл
				
				НоваяСтрока = ТаблицаЗначений.Добавить();  
				
				НоваяСтрока.Отметка 		= Истина;
				НоваяСтрока.Наименование 	= ИмяРасширения;
				НоваяСтрока.Версия 			= Версия; 
				НоваяСтрока.Описание 		= Описание;
				НоваяСтрока.АдресФайла 		= АдресФайла;
				НоваяСтрока.Размер 			= Размер;
				НоваяСтрока.ВерсияБП 		= ВерсияБП;  
				НоваяСтрока.ВерсияМодуля 	= ВерсияМодуля;  
				
				НоваяСтрока.ВерсияРазряд1	= ВерсияРазряд1;
				НоваяСтрока.ВерсияРазряд2	= ВерсияРазряд2;
				
			КонецЦикла;
			
		КонецЦикла; 
		
		ЧтениеXML.Закрыть();
		УдалитьФайлы(ИмяФайлаЗагрузки);
		
	Исключение
		
		ЧтениеXML.Закрыть();
		УдалитьФайлы(ИмяФайлаЗагрузки);
		
		Возврат Неопределено;
		
	КонецПопытки;
	
	Возврат ТаблицаЗначений;	
	
КонецФункции

Функция РаспаковатьАрхив(Знач ПутьКФайлуАрхива, Знач ИмяФайла) Экспорт
	
	ФайлАрхива = Новый Файл(ПутьКФайлуАрхива);
	Если ФайлАрхива.Существует()Тогда    
		ИмяФайлаЗагрузки  = ФайлАрхива.Путь + ИмяФайла;  
		Попытка 
			ЧтениеZip = Новый ЧтениеZipФайла(ПутьКФайлуАрхива);
			ЧтениеZip.ИзвлечьВсе(ФайлАрхива.Путь, РежимВосстановленияПутейФайловZIP.Восстанавливать);
		Исключение
		КонецПопытки;   
		УдалитьФайлы(ПутьКФайлуАрхива);
	КонецЕсли;  
	
	Возврат ИмяФайлаЗагрузки;

КонецФункции // ВыполнитьЗагрузкуСпискаОбновлений()

Функция ПолучитьТаблицуДоступныхДополнений(ТаблицаЗначений)   
	
	УстановитьПривилегированныйРежим(Истина);
	
	ЗагружаемыеРасширения = Справочники.CW_ОбязательныеРасширения.ПолучитьЗагружаемыеРасширения();
	
	ТаблицаДоступныхРасширений = ПустаяТаблицаРасширений();
	
	Отбор = Новый Структура;
	Отбор.Вставить("ВерсияМодуля", СокрЛП(CW_ОбновлениеКонфигурацииСервер.УстановленнаяВерсияПодсистемы()));
	
	ТаблицаДоступныеПоВерсии = ТаблицаЗначений.Скопировать(Отбор);   
	
	ТаблицаДоступныеПоВерсии.Колонки.Добавить("ДоступноБП",	 		Новый ОписаниеТипов("Булево"));
	ТаблицаДоступныеПоВерсии.Колонки.Добавить("ТребуетсяЗагрузка", 	Новый ОписаниеТипов("Булево"));
	
	ТаблицаДоступныеПоВерсии.Сортировать("Наименование ВОЗР, ВерсияРазряд1 УБЫВ, ВерсияРазряд2 УБЫВ");
	
	мДополнения = Новый Массив;
	Массив = ТаблицаДоступныеПоВерсии.ВыгрузитьКолонку("Наименование");
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(мДополнения, Массив, Истина);
	
	ТекущаяВерсияБП = CW_ВерсииПодсистемСервер.ТекущаяВерсияБухгалтерияПредприятия(); 
	
	Для Каждого ИмяДополнения из мДополнения Цикл  
		
		
		Отбор = новый Структура;
		Отбор.Вставить("Наименование", ИмяДополнения);
		
		мСтроки = ТаблицаДоступныеПоВерсии.НайтиСтроки(Отбор);
		Для Каждого СтрокаТаблицы из мСтроки Цикл 
			
			Если ЗагружаемыеРасширения.Найти(ИмяДополнения) = Неопределено Тогда
				СтрокаТаблицы.ТребуетсяЗагрузка = Ложь;
				Продолжить;
			КонецЕсли;
			
			РезультатСравнения			= СравнитьВерсии(ТекущаяВерсияБП, СтрокаТаблицы.ВерсияБП);  
			СтрокаТаблицы.ДоступноБП 	= РезультатСравнения >= 0;  
			СтрокаТаблицы.ТребуетсяЗагрузка = Истина;
			
			мРасширения = РасширенияКонфигурации.Получить(Новый Структура("Имя",ИмяДополнения)); 
			Если мРасширения.Количество() > 0 Тогда
				СтрокаТаблицы.ТребуетсяЗагрузка = СтрокаТаблицы.Версия <> мРасширения[0].Версия;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;   
	
	Для Каждого ИмяДополнения из мДополнения Цикл
		Отбор = Новый Структура;
		Отбор.Вставить("Наименование", 		ИмяДополнения);
		Отбор.Вставить("ДоступноБП",		Истина); 
		
		мСтроки = ТаблицаДоступныеПоВерсии.НайтиСтроки(Отбор);
		Если мСтроки.Количество() > 0 Тогда  
			СтрокаТаблицы = мСтроки[0];
			Если СтрокаТаблицы.ТребуетсяЗагрузка Тогда
				НоваяСтрока = ТаблицаДоступныхРасширений.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;  
	
	Возврат ТаблицаДоступныхРасширений;
	
КонецФункции   

Функция ПустаяТаблицаРасширений()
	
	ТаблицаЗначений = Новый ТаблицаЗначений;
	
	ТаблицаЗначений.Колонки.Добавить("Отметка",			Новый ОписаниеТипов("Булево"));
	ТаблицаЗначений.Колонки.Добавить("Наименование",	Новый ОписаниеТипов("Строка"));  
	ТаблицаЗначений.Колонки.Добавить("Версия",			Новый ОписаниеТипов("Строка"));  
	ТаблицаЗначений.Колонки.Добавить("Описание",		Новый ОписаниеТипов("Строка"));
	ТаблицаЗначений.Колонки.Добавить("АдресФайла",		Новый ОписаниеТипов("Строка"));
	ТаблицаЗначений.Колонки.Добавить("Размер",			Новый ОписаниеТипов("Число")); 
	
	Возврат ТаблицаЗначений; 
	
КонецФункции

Функция ПолучитьИмяФайлаИзПути(Знач ПутьФайла) Экспорт
	
	ИмяФайла = СтрЗаменить(ПутьФайла, "/","\");
	Пока Истина Цикл    
		
		ПозСлеш = СтрНайти(ИмяФайла, "\");
		Если ПозСлеш > 0 Тогда
			ИмяФайла = Сред(ИмяФайла, ПозСлеш+1); 
		Иначе
			Прервать;
		КонецЕсли;	
		
	КонецЦикла;
	
	Возврат ИмяФайла;

КонецФункции
