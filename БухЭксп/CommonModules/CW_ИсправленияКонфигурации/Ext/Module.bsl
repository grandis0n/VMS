Функция ПолучитьПустуюТаблицуИсправлений() Экспорт
	
	ТаблицаИсправлений = Новый ТаблицаЗначений;
	ТаблицаИсправлений.Колонки.Добавить("Отметка", 		Новый ОписаниеТипов("Булево"));
	ТаблицаИсправлений.Колонки.Добавить("Наименование", Новый ОписаниеТипов("Строка"));
	ТаблицаИсправлений.Колонки.Добавить("Описание", 	Новый ОписаниеТипов("Строка"));
	ТаблицаИсправлений.Колонки.Добавить("АдресФайла", 	Новый ОписаниеТипов("Строка"));
	ТаблицаИсправлений.Колонки.Добавить("Размер", 		Новый ОписаниеТипов("Число"));
	ТаблицаИсправлений.Колонки.Добавить("Удаляемые", 	Новый ОписаниеТипов("Строка"));
	ТаблицаИсправлений.Колонки.Добавить("Версия", 		Новый ОписаниеТипов("Строка"));
	
	Возврат ТаблицаИсправлений;
	
КонецФункции

Функция ПолучитьФайлыССервера(Логин, Пароль) Экспорт
	
	FTPСоединение = CW_ИсправленияКонфигурации.ПодключитьсяКРесурусуОбновлений(Логин, Пароль);
	Если FTPСоединение = Неопределено Тогда
		//Не удалось подключиться к серверу
		Возврат Неопределено;
	КонецЕсли;

	Исправления = ПолучитьПустуюТаблицуИсправлений();
	
	МассивФайлов = CW_ИсправленияКонфигурации.ПолучитьМассивФайловИсправлений(FTPСоединение);
	Если МассивФайлов.Количество() = 0 тогда
		Возврат Исправления;
	КонецЕсли;
	
	УстановленныеРасширения  = CW_ИсправленияКонфигурации.ПолучитьУстановлнныеИсправления();

	Для Каждого ФайлFTP из МассивФайлов Цикл
		
		ТекущаяВерсия = УстановленныеРасширения.Получить(ФайлFTP.ИмяБезРасширения);  
		
		ВременныйФайл = ПолучитьИмяВременногоФайла("");
		FTPСоединение.Получить(ФайлFTP.Имя,ВременныйФайл);
		ДвоичныеДанные 	= Новый ДвоичныеДанные(ВременныйФайл);
		АдресФайла 		= ПоместитьВоВременноеХранилище(ДвоичныеДанные);
		
		ИсправлениеИзАрхива = CW_ИсправленияКонфигурации.ИзвлечьИсправлениеИзАрхива(АдресФайла);
		Если ИсправлениеИзАрхива <> Неопределено Тогда
			ИмяИсправления 			= ИсправлениеИзАрхива.ИмяПатча;
			Данные 					= ИсправлениеИзАрхива.Данные;  
			
			УдаляемыеРасширения = ИсправлениеИзАрхива.УдаляемыеРасширения;
			Если ТипЗнч(УдаляемыеРасширения) <> тип("Массив") Тогда
				УдаляемыеРасширения = Новый Массив;
			КонецЕсли;   
			
			РезультатСравнения = УстанавливаетсяАктуальнаяВерсия(ТекущаяВерсия, ИсправлениеИзАрхива.Версия);
			Если РезультатСравнения < 0 Тогда   
				Если ТекущаяВерсия <> Неопределено Тогда
					УдаляемыеРасширения.Добавить(ФайлFTP.ИмяБезРасширения);	
				КонецЕсли;
				
				СтрокаИсправления = Исправления.Добавить();
				СтрокаИсправления.Отметка		= Истина;
				СтрокаИсправления.Наименование	= ФайлFTP.ИмяБезРасширения;
				СтрокаИсправления.Описание		= ИсправлениеИзАрхива.ОписаниеРасширения;
				СтрокаИсправления.Удаляемые 	= СтрСоединить(УдаляемыеРасширения,";");
				СтрокаИсправления.АдресФайла 	= ПоместитьВоВременноеХранилище(ИсправлениеИзАрхива.Данные, Новый УникальныйИдентификатор);
				СтрокаИсправления.Размер   		= ФайлFTP.Размер();
				СтрокаИсправления.Версия		= ИсправлениеИзАрхива.Версия;
			КонецЕсли;
			
		КонецЕсли;
		
		УдалитьФайлы(ВременныйФайл);
		
	КонецЦикла;
	
	Возврат Исправления;

КонецФункции     

Функция УстанавливаетсяАктуальнаяВерсия(СтрокаВерсии1, СтрокаВерсии2) Экспорт
	
	СтрокаВерсии1	= ?(ПустаяСтрока(СтрокаВерсии1), "0.0", СтрокаВерсии1);
	СтрокаВерсии2 	= ?(ПустаяСтрока(СтрокаВерсии2), "0.0", СтрокаВерсии2);
	
	Версия1 = СтрРазделить(СтрокаВерсии1, ".");
	Версия2 = СтрРазделить(СтрокаВерсии2, ".");
	
	Результат = 0;
	Для Разряд = 0 По 1 Цикл
		Результат = Число(Версия1[Разряд]) - Число(Версия2[Разряд]);
		Если Результат <> 0 Тогда
			Возврат Результат;
		КонецЕсли;
	КонецЦикла; 
	
	Возврат Результат;
	
КонецФункции

Процедура ПолучениеИУстановкаИсправленийКонфигурации() Экспорт
	
	ДанныеАутентификации = CW_МониторПорталаПоддержкиСервер.ДанныеАутентификацииПользователяИнтернетПоддержки();
	Если ДанныеАутентификации = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ТабИсправления = CW_ИсправленияКонфигурации.ПолучитьФайлыССервера(ДанныеАутентификации.Логин, ДанныеАутентификации.Пароль);	
	Если ТабИсправления = Неопределено Тогда
		Возврат;
	КонецЕсли;    
	
	ЗагрузитьПолученныеИсправления(ТабИсправления);
	
КонецПроцедуры

Процедура ПолучениеИУстановкаДополненийКонфигурации() Экспорт
	
	ДанныеАутентификации = CW_МониторПорталаПоддержкиСервер.ДанныеАутентификацииПользователяИнтернетПоддержки();
	Если ДанныеАутентификации = Неопределено Тогда
		Возврат;
	КонецЕсли; 
	
	ПараметрыПодключения = Новый Структура;
	ПараметрыПодключения.Вставить("АдресРесурса", 	CW_ИсправленияКонфигурации.СерверПроверкиНаличияДопонений());  

	Соединение = CW_ИсправленияКонфигурации.ПодключитьсяКСерверуПроверкиНаличияОбновлений(ПараметрыПодключения);
	Если Соединение = Неопределено Тогда
		//Не удалось подключиться к серверу
		ЗаписьЖурналаРегистрации("Получение дополнений",,,,"Не удалось подключиться к серверу");
		Возврат;
	КонецЕсли;                                             
	
	АдресРесурса = CW_ИсправленияКонфигурации.АдресРесурсаПроверкиНаличияДопонений() + 
			CW_ИсправленияКонфигурации.ИмяZIPфайлаШаблонаДополнений();
			
	ЛокальныйПуть = КаталогВременныхФайлов()+CW_ИсправленияКонфигурации.ИмяZIPфайлаШаблонаДополнений();  
	                    
	Ошибка = CW_ИсправленияКонфигурации.ПолучитьФайлССервера(АдресРесурса, ЛокальныйПуть, Соединение);  
	Если Ошибка <> "" Тогда  
		ЗаписьЖурналаРегистрации("Получение дополнений",,,,Ошибка);
		Возврат;
	КонецЕсли; 
	
	ТаблицаДоступныхДополнений = CW_ИсправленияКонфигурации.ОбработатьZIPФайлДополнений(ЛокальныйПуть);
	
	ЗагрузитьДополненияКонфигурации(ТаблицаДоступныхДополнений, ДанныеАутентификации.Логин, ДанныеАутентификации.Пароль);

КонецПроцедуры  

Процедура ЗагрузитьДополненияКонфигурации(ТаблицаДоступныхДополнений, Логин, Пароль)
	
	УстановитьПривилегированныйРежим(Истина);
	
	Отбор 	= Новый Структура("Отметка", Истина);
	мСтроки = ТаблицаДоступныхДополнений.НайтиСтроки(Отбор);
	
	Для Каждого СтрокаИсправления из мСтроки Цикл   
		
		АдресРесурса  = СтрокаИсправления.АдресФайла; 
		ИмяZIPФайла   = CW_ИсправленияКонфигурации.ПолучитьИмяФайлаИзПути(АдресРесурса);
		ЛокальныйПуть = КаталогВременныхФайлов()+ИмяZIPФайла;  
		
		FTPСоединение = CW_ИсправленияКонфигурации.ПодключитьсяКРесурусуОбновлений(Логин, Пароль);
		Если FTPСоединение = Неопределено Тогда
			//Не удалось подключиться к серверу
			ЗаписьЖурналаРегистрации("Получение дополнений",,,,"Не удалось подключиться к серверу");
			Продолжить;;
		КонецЕсли;                                             
		
		Ошибка = CW_ИсправленияКонфигурации.ПолучитьФайлССервера(АдресРесурса, ЛокальныйПуть, FTPСоединение);  
		Если Ошибка <> "" Тогда
			ЗаписьЖурналаРегистрации("Получение дополнений",,,,Ошибка);
		Продолжить;
		КонецЕсли;    
		
		ФайлАрхива = Новый Файл(ЛокальныйПуть);
		Если ФайлАрхива.Существует()Тогда    
			
			ИмяФайлаЗагрузки = CW_ИсправленияКонфигурации.РаспаковатьАрхив(ЛокальныйПуть, ФайлАрхива.ИмяБезРасширения+".cfe");
			
			//Удаляем одноименное раширение, если есть
			мУдаляемые = Новый Массив;
			мУдаляемые.Добавить(ФайлАрхива.ИмяБезРасширения);
			CW_ИсправленияКонфигурации.УдалитьРасширения(мУдаляемые);
			//Удаляем одноименное раширение, если есть
			
			Попытка
				ДвоичныеДанные = Новый ДвоичныеДанные(ИмяФайлаЗагрузки);
				
				Расширение = РасширенияКонфигурации.Создать();
				
				Справочники.ВерсииРасширений.ОтключитьПредупрежденияБезопасности(Расширение);
				Справочники.ВерсииРасширений.ОтключитьИспользованиеОсновныхРолейДляВсехПользователей(Расширение);
				
				Расширение.БезопасныйРежим = Ложь;
				Расширение.ИспользуетсяВРаспределеннойИнформационнойБазе = Истина;
				Расширение.Записать(ДвоичныеДанные); 
			Исключение
			КонецПопытки; 
			
			УдалитьФайлы(ИмяФайлаЗагрузки);
			
		КонецЕсли;
			
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗагрузитьПолученныеИсправления(Исправления)
	
	Отбор 	= Новый Структура("Отметка", Истина);
	мСтроки = Исправления.НайтиСтроки(Отбор);
	
	Для Каждого СтрокаИсправления из мСтроки Цикл
		
		Если ЗначениеЗаполнено(СтрокаИсправления.Удаляемые) Тогда
			мУдаляемые = СтрРазделить(СтрокаИсправления.Удаляемые,";", Ложь);
			CW_ИсправленияКонфигурации.УдалитьРасширения(мУдаляемые);
		КонецЕсли;
		
		Попытка
			ДвоичныеДанные = ПолучитьИзВременногоХранилища(СтрокаИсправления.АдресФайла);
			
			Расширение = РасширенияКонфигурации.Создать();
			Справочники.ВерсииРасширений.ОтключитьПредупрежденияБезопасности(Расширение);
			Справочники.ВерсииРасширений.ОтключитьИспользованиеОсновныхРолейДляВсехПользователей(Расширение);
			Расширение.БезопасныйРежим = Ложь;
			Расширение.ИспользуетсяВРаспределеннойИнформационнойБазе = Истина;
			Расширение.Записать(ДвоичныеДанные);
		Исключение
		КонецПопытки;
		
	КонецЦикла;
	
КонецПроцедуры
