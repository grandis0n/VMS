				Нстр = ТЗПропорцияРаспределенияСальдо.Добавить();
				Нстр.ПорядокОтражения = "СобственнаяУслуга";
				Нстр.СуммаРаспределенная = ВедущийДокумент.СальдоВзаиморасчетовБУ;
				
			ИначеЕсли (НЕ ЕстьСобственныеУслуги И ЕстьВозмещаемыеУслуги) Тогда  
				
