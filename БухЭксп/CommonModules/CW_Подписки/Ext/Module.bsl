Процедура CW_ПередЗаписьюСправочникаДоговорыПередЗаписью(Источник, Отказ) Экспорт
	
	ПривелигированныйРежимЗаписи = Ложь;
	Если Источник.ДополнительныеСвойства.Свойство("ПривелигированныйРежимЗаписи") Тогда
		ПривелигированныйРежимЗаписи =  Источник.ДополнительныеСвойства.ПривелигированныйРежимЗаписи;
	КонецЕсли;
	
	Если ПривелигированныйРежимЗаписи Тогда
		Возврат;
	КонецЕсли;

	
	Если РольДоступна("БухгалтерияЭкспедитора") или РольДоступна("БухгалтерияЭкспедитораМенеджер") тогда
		
		РедактированиеЗапрещено = РегистрыСведений.CW_ДоступныеСправочникиПоГруппамПользователей.РедактированиеОбъектаЗапрещено(ТипЗнч(Источник.Ссылка));
		
		Если РедактированиеЗапрещено Тогда
			
			Отказ = Истина;
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Недостаточно прав для данного действия.";
			Сообщение.Сообщить();
			
		КонецЕсли; 
		
	КонецЕсли;	
КонецПроцедуры

//Процедура CW_ПометкаНаУдалениеОбъектовАрхиваПриЗаписи
// -- Выполняет пометку на удаление всех связанных объектов в справочнике "CW_ОбъектыАрхива"
Процедура CW_ПометкаНаУдалениеОбъектовАрхиваПриЗаписи(Источник, Отказ) Экспорт
	
	Если Источник.ПометкаУдаления Тогда
		
		УстановитьПривилегированныйРежим(Истина);
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		               |	CW_ОбъектыАрхива.Ссылка КАК Ссылка
		               |ИЗ
		               |	Справочник.CW_ОбъектыАрхива КАК CW_ОбъектыАрхива
		               |ГДЕ
		               |	CW_ОбъектыАрхива.Объект = &Объект
		               |	И НЕ CW_ОбъектыАрхива.ПометкаУдаления";
		
		Запрос.УстановитьПараметр("Объект", Источник.Ссылка);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		Выборка = РезультатЗапроса.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			тОбъект = Выборка.Ссылка.ПолучитьОбъект();
			тОбъект.УстановитьПометкуУдаления(Истина); 
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры


#Область Добавление_дополнительной_Услуги_в_документы_по_ГП

//Процедура ДобавитьДополнительнуюУслугу(Источник) Экспорт
// Добавляет дополнительную услугу в документы ДПГ и РПГ при включенных соответсвующих функциональных опциях
//
// Параметры:
// 		- Источник - Объект 
//
Процедура ДобавитьДополнительнуюУслугу(Источник) Экспорт
	
	глИспользуютсяЗависимыеУслуги 								= ПолучитьФункциональнуюОпцию("CW_ИспользуютсяЗависимыеУслуги");
	РазрешитьПолучениеКоличестваУслугИзпараметраГрузоперевозки 	= ПолучитьФункциональнуюОпцию("CW_РазрешитьПолучениеКоличестваУслугИзпараметраГрузоперевозки");
	УстановитьЗначениеНольЗначениеПараметраНеУстановлено 		= Константы.CW_УстановитьЗначениеНольЗначениеПараметраНеУстановлено.Получить();
	
	Если НЕ глИспользуютсяЗависимыеУслуги Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(Источник.Ссылка) = Тип("ДокументСсылка.CW_РасходыПоГрузоперевозке") Тогда
		
		ИспользуютсяЗависимыеУслуги = ПолучитьФункциональнуюОпцию("CW_ИспользуютсяЗависимыеУслугиПоВходяимДоговорам");
		УчитыватьГруз				= ПолучитьФункциональнуюОпцию("CW_ЗависимыеУслугиУчитыватьГрузПоВходящим");
		УчитыватьКлиента 			= ПолучитьФункциональнуюОпцию("CW_ЗависимыеУслугиУчитыватьКлиентаПоВходящим");
		
	ИначеЕсли ТипЗнч(Источник.Ссылка) = Тип("ДокументСсылка.CW_ДоходыПоГрузоперевозке") Тогда
		
		ИспользуютсяЗависимыеУслуги	= ПолучитьФункциональнуюОпцию("CW_ИспользуютсяЗависимыеУслугиПоИсходящимДоговорам");
		УчитыватьГруз 				= ПолучитьФункциональнуюОпцию("CW_ЗависимыеУслугиУчитыватьГрузПоИсходящим");
		УчитыватьКлиента 			= Ложь;
		
	КонецЕсли;
	
	Если Не ИспользуютсяЗависимыеУслуги Тогда
		Возврат;
	Конецесли;
	
	//Подготовка списка услуг
	Запрос = новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	CW_НастройкаЗависмыхУслуг.Договор КАК Договор,
	|	CW_НастройкаЗависмыхУслуг.УслугаДокумента КАК УслугаДокумента,
	|	CW_НастройкаЗависмыхУслуг.Клиент КАК Клиент,
	|	CW_НастройкаЗависмыхУслуг.Груз КАК Груз,
	|	CW_НастройкаЗависмыхУслуг.Номенклатура КАК Номенклатура,
	|	CW_НастройкаЗависмыхУслуг.ПорядокОтражения КАК ПорядокОтражения,
	|	CW_НастройкаЗависмыхУслуг.Количество КАК Количество,
	|	CW_НастройкаЗависмыхУслуг.Сумма КАК Сумма,
	|	CW_НастройкаЗависмыхУслуг.Цена КАК Цена,
	|	CW_НастройкаЗависмыхУслуг.СтавкаНДС КАК СтавкаНДС,
	|	CW_НастройкаЗависмыхУслуг.НДС КАК НДС,
	|	CW_НастройкаЗависмыхУслуг.Всего КАК Всего
	|ПОМЕСТИТЬ ВТ_СписокУслуг
	|ИЗ
	|	РегистрСведений.CW_НастройкаЗависмыхУслуг КАК CW_НастройкаЗависмыхУслуг
	|ГДЕ
	|	CW_НастройкаЗависмыхУслуг.Договор = &Договор
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_СписокУслуг.Номенклатура КАК Номенклатура,
	|	ВТ_СписокУслуг.ПорядокОтражения КАК ПорядокОтражения,
	|	ВТ_СписокУслуг.Количество КАК Количество,
	|	ВТ_СписокУслуг.Сумма КАК Сумма,
	|	ВТ_СписокУслуг.Цена КАК Цена,
	|	ВТ_СписокУслуг.СтавкаНДС КАК СтавкаНДС,
	|	ВТ_СписокУслуг.НДС КАК НДС,
	|	ВТ_СписокУслуг.Всего КАК Всего
	|ИЗ
	|	ВТ_СписокУслуг КАК ВТ_СписокУслуг";
	
	Запрос.УстановитьПараметр("Договор", Источник.Договор);
	Результат_НастройкаУслуг = Запрос.Выполнить();
	
	//-------------------------------------------------------------------------------------------------------------
	//Подготовка таблицы для добавления услуг
	ВремТаблица = Результат_НастройкаУслуг.Выгрузить();
	ВремТаблица.Очистить();
	ВремТаблица.Колонки.Добавить("Грузоперевозка", Новый ОписаниеТипов("СправочникСсылка.CW_Грузоперевозки"));
	//-------------------------------------------------------------------------------------------------------------
	
	Запрос.Текст = "ВЫБРАТЬ
	|	CW_СтатьиЗатратНоменклатуры.Номенклатура КАК Номенклатура,
	|	CW_СтатьиЗатратНоменклатуры.СтатьяЗатрат КАК СтатьяЗатрат
	|ПОМЕСТИТЬ ВТ_СтатьиЗатрат
	|ИЗ
	|	РегистрСведений.CW_СтатьиЗатратНоменклатуры КАК CW_СтатьиЗатратНоменклатуры
	|ГДЕ
	|	CW_СтатьиЗатратНоменклатуры.Номенклатура В
	|			(ВЫБРАТЬ
	|				ВТ_СписокУслуг.Номенклатура КАК Номенклатура
	|			ИЗ
	|				ВТ_СписокУслуг КАК ВТ_СписокУслуг)";
	Запрос.Выполнить();
	
	//-------------------------------------------------------------------------------------------------------------
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	ТаблицаУслуг.Грузоперевозка КАК Грузоперевозка,
	               |	ТаблицаУслуг.Номенклатура КАК Номенклатура
	               |ПОМЕСТИТЬ Внешняя_ТаблицаУслуг
	               |ИЗ
	               |	&ТаблицаУслуг КАК ТаблицаУслуг
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	Внешняя_ТаблицаУслуг.Грузоперевозка КАК Грузоперевозка,
	               |	Внешняя_ТаблицаУслуг.Номенклатура КАК Номенклатура
	               |ИЗ
	               |	Внешняя_ТаблицаУслуг КАК Внешняя_ТаблицаУслуг
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	Внешняя_ТаблицаУслуг.Грузоперевозка,
	               |	Внешняя_ТаблицаУслуг.Номенклатура";
	
	Запрос.УстановитьПараметр("ТаблицаУслуг",  Источник.Услуги.Выгрузить());
	
	РезультатУслуги = Запрос.Выполнить();
	
	Выборка_Услуги = РезультатУслуги.Выбрать();
	
	Пока Выборка_Услуги.Следующий() Цикл
		
		//Получаем услуги из настроек
		МассивГрузы = Новый Массив;
		МассивГрузы.Добавить(Справочники.CW_Грузы.ПустаяСсылка());
		Если УчитыватьГруз Тогда
			МассивГрузы.Добавить(Выборка_Услуги.Грузоперевозка.Груз);
		КонецЕсли;
		
		МассивКлиенты = Новый Массив;
		МассивКлиенты.Добавить(Справочники.Контрагенты.ПустаяСсылка());
		Если УчитыватьКлиента Тогда
			
			СтруктураПараметров = Новый Структура;
			СтруктураПараметров.Вставить("Объект"				, Выборка_Услуги.Грузоперевозка);
			СтруктураПараметров.Вставить("ЭтоВариантБюджета"	, Ложь);
			СтруктураПараметров.Вставить("Контрагент"			, Выборка_Услуги.Грузоперевозка.Клиент);
			
			тПокупатель = CW_Финансы.ВернутьПлательщика(СтруктураПараметров);
			
			МассивКлиенты.Добавить(тПокупатель);
			
		КонецЕсли;
		
		Запрос.Текст = "ВЫБРАТЬ
		|	ВТ_СписокУслуг.Клиент КАК Клиент,
		|	ВТ_СписокУслуг.Груз КАК Груз,
		|	ВТ_СписокУслуг.Номенклатура КАК Номенклатура,
		|	ВТ_СписокУслуг.ПорядокОтражения КАК ПорядокОтражения,
		|	ВТ_СписокУслуг.Количество КАК Количество,
		|	ВТ_СписокУслуг.Сумма КАК Сумма,
		|	ВТ_СписокУслуг.Цена КАК Цена,
		|	ВТ_СписокУслуг.СтавкаНДС КАК СтавкаНДС,
		|	ВТ_СписокУслуг.НДС КАК НДС,
		|	ВТ_СписокУслуг.Всего КАК Всего
		|ИЗ
		|	ВТ_СписокУслуг КАК ВТ_СписокУслуг
		|ГДЕ
		|	ВТ_СписокУслуг.УслугаДокумента = &УслугаДокумента
		|	И ВТ_СписокУслуг.Клиент В(&МассивКлиенты)
		|	И ВТ_СписокУслуг.Груз В(&МассивГрузы)
		|
		|УПОРЯДОЧИТЬ ПО
		|	Клиент УБЫВ,
		|	Груз УБЫВ";
		
		Запрос.УстановитьПараметр("МассивКлиенты"	, МассивКлиенты);
		Запрос.УстановитьПараметр("МассивГрузы"		, МассивГрузы);
		Запрос.УстановитьПараметр("УслугаДокумента"	, Выборка_Услуги.Номенклатура); 
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Пока Выборка.Следующий() Цикл
			НоваяСтрока = ВремТаблица.Добавить();
			
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка_Услуги);
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
			
		КонецЦикла;
		
	КонецЦикла;
	
	//Сгруппируем добавленные улсуги
	Запрос.Текст = "ВЫБРАТЬ
	|	ВТ_ДобавляемыеУслуги.Грузоперевозка КАК Грузоперевозка,
	|	ВТ_ДобавляемыеУслуги.Номенклатура КАК Номенклатура,
	|	ВТ_ДобавляемыеУслуги.ПорядокОтражения КАК ПорядокОтражения,
	|	ВТ_ДобавляемыеУслуги.Количество КАК Количество,
	|	ВТ_ДобавляемыеУслуги.Сумма КАК Сумма,
	|	ВТ_ДобавляемыеУслуги.Цена КАК Цена,
	|	ВТ_ДобавляемыеУслуги.СтавкаНДС КАК СтавкаНДС,
	|	ВТ_ДобавляемыеУслуги.НДС КАК НДС,
	|	ВТ_ДобавляемыеУслуги.Всего КАК Всего
	|ПОМЕСТИТЬ ВТ_УслугиКДобавлению
	|ИЗ
	|	&ДобавляемыеУслуги КАК ВТ_ДобавляемыеУслуги
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_УслугиКДобавлению.Грузоперевозка КАК Грузоперевозка,
	|	ВТ_УслугиКДобавлению.Номенклатура КАК Номенклатура,
	|	ВТ_СтатьиЗатрат.СтатьяЗатрат КАК СтатьяЗатрат,
	|	ВТ_УслугиКДобавлению.ПорядокОтражения КАК ПорядокОтражения,
	|	ВТ_УслугиКДобавлению.Количество КАК Количество,
	|	ВТ_УслугиКДобавлению.Сумма КАК Сумма,
	|	ВТ_УслугиКДобавлению.Цена КАК Цена,
	|	ВТ_УслугиКДобавлению.СтавкаНДС КАК СтавкаНДС,
	|	ВТ_УслугиКДобавлению.НДС КАК НДС,
	|	ВТ_УслугиКДобавлению.Всего КАК Всего
	|ИЗ
	|	ВТ_УслугиКДобавлению КАК ВТ_УслугиКДобавлению
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_СтатьиЗатрат КАК ВТ_СтатьиЗатрат
	|		ПО ВТ_УслугиКДобавлению.Номенклатура = ВТ_СтатьиЗатрат.Номенклатура
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_УслугиКДобавлению.Номенклатура,
	|	ВТ_УслугиКДобавлению.Сумма,
	|	ВТ_УслугиКДобавлению.Количество,
	|	ВТ_УслугиКДобавлению.Цена,
	|	ВТ_УслугиКДобавлению.СтавкаНДС,
	|	ВТ_УслугиКДобавлению.НДС,
	|	ВТ_УслугиКДобавлению.Всего,
	|	ВТ_СтатьиЗатрат.СтатьяЗатрат,
	|	ВТ_УслугиКДобавлению.ПорядокОтражения,
	|	ВТ_УслугиКДобавлению.Грузоперевозка";
	
	Запрос.УстановитьПараметр("ДобавляемыеУслуги", ВремТаблица);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаУслуг = РезультатЗапроса.Выбрать();
	
	ГруппировкаЗатратПоПодразделениям 	= CW_Настройки.ПараметрУчетнойПолитики(Источник.Дата, Источник.Организация, "ГруппировкаЗатратПоПодразделениям");
	ОсновнаяСтатьяЗатрат 				= CW_Настройки.ПараметрУчетнойПолитики(Источник.Дата, Источник.Организация, "ОсновнаяСтатьяЗатрат");
	
	Пока ВыборкаУслуг.Следующий() Цикл
		
		Отбор = Новый Структура;
		Отбор.Вставить("Грузоперевозка"	,ВыборкаУслуг.Грузоперевозка);
		Отбор.Вставить("Номенклатура"	,ВыборкаУслуг.Номенклатура);
		
		мСтроки = Источник.Услуги.НайтиСтроки(Отбор);
		
		Если мСтроки.Количество() > 0 Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаУслуги = Источник.Услуги.Добавить();
		
		ЗаполнитьЗначенияСвойств(СтрокаУслуги, ВыборкаУслуг);
		
		Если Не ЗначениеЗаполнено(ВыборкаУслуг.СтатьяЗатрат) Тогда
			СтрокаУслуги.СтатьяЗатрат = ОсновнаяСтатьяЗатрат;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(СтрокаУслуги.СтавкаНДС) Тогда
			//Получаем из карточки номенклатуры
			СтрокаУслуги.СтавкаНДС =  CW_БухгалтерияЭкспедитораСерверПереопределяемый.СтавкаНДС(СтрокаУслуги.Номенклатура, Источник.Дата);
		КонецЕсли;
		
		Если ТипЗнч(Источник.Ссылка) = Тип("ДокументСсылка.CW_РасходыПоГрузоперевозке") Тогда
			ЗаполнитьДанныеПокупателя(Источник.Организация, ГруппировкаЗатратПоПодразделениям, СтрокаУслуги);
			
			Если СтрокаУслуги.ПорядокОтражения <> Перечисления.CW_ПорядокОтраженияЗатрат.Перевыставление 
				И СтрокаУслуги.ПорядокОтражения <> Перечисления.CW_ПорядокОтраженияЗатрат.ПеревыставлениеПоСтавкам Тогда
				
				СтруктураПараметров = Новый Структура;
				СтруктураПараметров.Вставить("Дата"					, Источник.Дата);
				СтруктураПараметров.Вставить("Организация"			, Источник.Организация);
				СтруктураПараметров.Вставить("Номенклатура"			, СтрокаУслуги.Номенклатура);
				СтруктураПараметров.Вставить("НоменклатурнаяГруппа"	, СтрокаУслуги.Номенклатура.НоменклатурнаяГруппа);
				
				СтрокаУслуги.СпособУчетаНДС = CW_Финансы.ПолучитьСпособУчетаНДС(СтруктураПараметров);
			КонецЕсли;
			
		КонецЕсли;
		
		//Получаем количество из Параметра
		Если РазрешитьПолучениеКоличестваУслугИзпараметраГрузоперевозки и СтрокаУслуги.Количество = 0 тогда
			
			ЗначениеПараметра 	=  0;
			СтруктураПараметров = новый Структура("ТипПеревозки,Номенклатура,ЕдиницаИзмерения", ВыборкаУслуг.Грузоперевозка.ТипПеревозки,СтрокаУслуги.Номенклатура,СтрокаУслуги.Номенклатура.ЕдиницаИзмерения);
			НайденныйПараметр 	= CW_Документы.ПолучитьПараметрДляПодстановкиЗначенияВКоличество(СтруктураПараметров);
			
			Если НайденныйПараметр <> Неопределено Тогда
				//Получаем только первое значение
				СтрокаПараметраГП = ВыборкаУслуг.Грузоперевозка.ПараметрыГрузоперевозки.Найти(НайденныйПараметр, "Параметр");
				
				Если СтрокаПараметраГП <> Неопределено Тогда
					ЗначениеПараметра =  СтрокаПараметраГП.Значение;
				КонецЕсли;
				
			КонецЕсли;	
			
			Если Не УстановитьЗначениеНольЗначениеПараметраНеУстановлено и Не ЗначениеЗаполнено(ЗначениеПараметра) Тогда
				ЗначениеПараметра = 1;
			КонецЕсли;
			
			СтрокаУслуги.Количество =  ЗначениеПараметра;
			
			//Нужно пересчитать значения строки
			Ставка 				= CW_Финансы.ПолучитьСтавкуНДС(СтрокаУслуги.СтавкаНДС);
			
			СтрокаУслуги.Сумма  = СтрокаУслуги.Цена * СтрокаУслуги.Количество;
			СтрокаУслуги.НДС 	= СтрокаУслуги.Сумма*(Ставка/100);
			СтрокаУслуги.Всего 	= СтрокаУслуги.Сумма+СтрокаУслуги.НДС;
			
		КонецЕсли;
		
		ПараметрыШаблона = CW_Шаблоны.ПолучитьПараметрШаблонаУслуг();
		
		ПараметрыШаблона.Номенклатура 	= СтрокаУслуги.Номенклатура;
		ПараметрыШаблона.Объект 		= Источник;
		ПараметрыШаблона.Дата 			= Источник.Дата;
		ПараметрыШаблона.Договор 		= Источник.Договор;
		ПараметрыШаблона.ВидДоговора 	= Источник.Договор.ВидДоговора;
		ПараметрыШаблона.ПриложениеКДоговору = Источник.ПриложениеКДоговору;
		
		CW_Шаблоны.УстановитьПредставлениеНоменклатурыВСтроке(СтрокаУслуги, ПараметрыШаблона); 
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьДанныеПокупателя(Органиазция, ГруппировкаЗатратПоПодразделениям, ДанныеСтроки)
	
	Если ДанныеСтроки.ПорядокОтражения <> Перечисления.CW_ПорядокОтраженияЗатрат.Затраты 
		ИЛИ ДанныеСтроки.ПорядокОтражения = Перечисления.CW_ПорядокОтраженияЗатрат.ПрочиеРасходы Тогда
		
		СтруктураПараметров = Новый Структура;
		СтруктураПараметров.Вставить("Объект"				, ДанныеСтроки.Грузоперевозка);
		СтруктураПараметров.Вставить("ЭтоВариантБюджета"	, Ложь);
		СтруктураПараметров.Вставить("Контрагент"			, ДанныеСтроки.Грузоперевозка.Клиент);
		
		КлиентПлат = CW_Финансы.ВернутьПлательщика(СтруктураПараметров);
		Если ЗначениеЗаполнено(ДанныеСтроки.Грузоперевозка.Клиент) И КлиентПлат <> ДанныеСтроки.Покупатель Тогда
			
			ДанныеСтроки.Покупатель =  КлиентПлат;
			
			Если (НЕ ДанныеСтроки.Покупатель.Пустая()) Тогда
				
				ДоговорПоГрузоперевозке = ДоговорГрузоперевозки(ДанныеСтроки.Грузоперевозка, ДанныеСтроки.Покупатель);
				
				Если (ДоговорПоГрузоперевозке = Неопределено) Тогда
					ДанныеСтроки.ДоговорПокупателя = CW_Документы.ПолучитьПоследнийДоговор(ДанныеСтроки.Покупатель ,Органиазция, Перечисления.ВидыДоговоровКонтрагентов.СПокупателем);
				Иначе
					ДанныеСтроки.ДоговорПокупателя = ДоговорПоГрузоперевозке;
				КонецЕсли; 
				
			КонецЕсли; 
			
		КонецЕсли; 
		
	Иначе
		
		_ПодставитьПодразделение(ГруппировкаЗатратПоПодразделениям, ДанныеСтроки);
		
	КонецЕсли; 
	
КонецПроцедуры

Процедура _ПодставитьПодразделение(ГруппировкаЗатратПоПодразделениям, ДанныеСтроки)
	
	Если НЕ ГруппировкаЗатратПоПодразделениям Тогда
		Возврат;
	КонецЕсли; 
	
	Если НЕ ДанныеСтроки.Подразделение.Пустая() Тогда
		Возврат;
	КонецЕсли; 
	
	Если НЕ ДанныеСтроки.Грузоперевозка.Пустая() Тогда
		
		ПараметрПодразделения = Константы.CW_ПараметрПодразделенияЗатрат.Получить();
		Если (НЕ ПараметрПодразделения.Пустая()) Тогда
			
			Отбор = Новый Структура("Параметр",ПараметрПодразделения);
			СтрокаПараметра = _сф.к_НайтиСтроку(ДанныеСтроки.Грузоперевозка.ПараметрыГрузоперевозки,Отбор);
			Если (СтрокаПараметра <> Неопределено) Тогда
				
				Если (ЗначениеЗаполнено(СтрокаПараметра.Значение)) Тогда
					ДанныеСтроки.Подразделение = СтрокаПараметра.Значение;
				КонецЕсли; 
				
			КонецЕсли; 
			
		КонецЕсли; 
		
	КонецЕсли; 
	
	// --- 
КонецПроцедуры

Функция ДоговорГрузоперевозки(Грузоперевозка, Плательщик)
	// --- 
	
	Если (НЕ ЗначениеЗаполнено(Грузоперевозка)) Тогда
		Возврат(Неопределено);
	КонецЕсли; 
	ПараметрДоговора = Константы.CW_ПараметрДоговораПлательщика.Получить();
	Если (ПараметрДоговора.Пустая()) Тогда
		Возврат(Неопределено);
	КонецЕсли; 
	
	Отбор = Новый Структура("Параметр",ПараметрДоговора);
	СтрокаПараметра = _сф.к_НайтиСтроку(Грузоперевозка.ПараметрыГрузоперевозки,Отбор);
	Если (СтрокаПараметра = Неопределено) Тогда
		Возврат(Справочники.CW_ДоговорыПоГрузоперевозкам.ПустаяСсылка());
	Иначе
		Если (СтрокаПараметра.Значение.Владелец = Плательщик) Тогда
			Возврат(СтрокаПараметра.Значение);
		Иначе
			Возврат(Справочники.CW_ДоговорыПоГрузоперевозкам.ПустаяСсылка());
		КонецЕсли; 
	КонецЕсли; 
	
	// --- 
КонецФункции

#КонецОбласти

Функция ПроверитьВозможностьРедактированияСправочника(ТипОбъектаМетаданных)
	
	Если РольДоступна("БухгалтерияЭкспедитора") или РольДоступна("БухгалтерияЭкспедитораМенеджер") тогда
		
		РедактированиеЗапрещено = РегистрыСведений.CW_ДоступныеСправочникиПоГруппамПользователей.РедактированиеОбъектаЗапрещено(ТипОбъектаМетаданных);
		
		Если РедактированиеЗапрещено Тогда
			Сообщение = новый СообщениеПользователю;
			Сообщение.Текст = "Недостаточно прав для записи объекта.";
			Сообщение.Сообщить();
		КонецЕсли; 
		
		Возврат РедактированиеЗапрещено;
		
	КонецЕсли;
	
	Возврат Ложь;   
	
КонецФункции

Процедура ДополнитьДвиженияПоНДСНалоговогоАгента(Источник, ДвиженияВедомого, ВедущийДокумент)
	
	ВалютаРегламентированногоУчета = Константы.ВалютаРегламентированногоУчета.Получить();
	
	// проводка по налоговому агенту формируется исключительно по рублевым договорам
  	Если ТипЗнч(ВедущийДокумент) = Тип("ДокументСсылка.CW_ДоходыПоГрузоперевозке") И Не ВедущийДокумент.Корректировка и (ВедущийДокумент.Валюта = ВалютаРегламентированногоУчета)  Тогда
		
		Если ЗначениеЗаполнено(ВедущийДокумент.ПриложениеКДоговору) Тогда
			ВедетсяБухгалтерскийУчет = ВедущийДокумент.ПриложениеКДоговору.БухгалтерскийУчет;	
		Иначе
			ВедетсяБухгалтерскийУчет = ВедущийДокумент.Договор.БухгалтерскийУчет;	
		КонецЕсли;
		
		Если ВедетсяБухгалтерскийУчет И ВедущийДокумент.ФормируетсяАкт и ВедущийДокумент.ФормируетсяСчетФактура Тогда  
			ДополнитьДвиженияПоНДСНалоговогоАгентаПродолжение(Источник, ДвиженияВедомого, ВедущийДокумент);
		КонецЕсли;
		
	КонецЕсли;   
	
КонецПроцедуры  

Процедура ДополнитьДвиженияПоНДСНалоговогоАгентаПродолжение(Источник, ДвиженияВедомого, ВедущийДокумент) 

	ВестиУчетПоПодразделениям = ПолучитьФункциональнуюОпцию("ВестиУчетПоПодразделениям");
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	CW_ДоходыПоГрузоперевозкеУслуги.ДокументРасходов.Контрагент КАК Поставщик,
	               |	ВЫБОР
	               |		КОГДА CW_ДоходыПоГрузоперевозкеУслуги.ДокументРасходов.ПриложениеКДоговору = ЗНАЧЕНИЕ(Справочник.CW_ПриложенияКДоговорам.ПустаяССЫлка)
	               |			ТОГДА CW_ДоходыПоГрузоперевозкеУслуги.ДокументРасходов.Договор.УчетныйДоговор
	               |		ИНАЧЕ CW_ДоходыПоГрузоперевозкеУслуги.ДокументРасходов.ПриложениеКДоговору.УчетныйДоговор
	               |	КОНЕЦ КАК УчетныйДоговор,
	               |	CW_ДоходыПоГрузоперевозкеУслуги.НДС КАК НДС
	               |ПОМЕСТИТЬ ВТ_Перевыставления
	               |ИЗ
	               |	Документ.CW_ДоходыПоГрузоперевозке.Услуги КАК CW_ДоходыПоГрузоперевозкеУслуги
	               |ГДЕ
	               |	CW_ДоходыПоГрузоперевозкеУслуги.Ссылка = &Регистратор
	               |	И CW_ДоходыПоГрузоперевозкеУслуги.ПорядокОтражения = ЗНАЧЕНИЕ(Перечисление.CW_ПорядокОтраженияДоходов.Перевыставление)
	               |	И CW_ДоходыПоГрузоперевозкеУслуги.СтавкаНДС <> Значение(Перечисление.СтавкиНДС.БезНДС)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ_Перевыставления.Поставщик КАК Поставщик,
	               |	ВТ_Перевыставления.УчетныйДоговор КАК УчетныйДоговор,
	               |	СУММА(ВТ_Перевыставления.НДС) КАК НДС
	               |ИЗ
	               |	ВТ_Перевыставления КАК ВТ_Перевыставления
	               |ГДЕ
	               |	ВТ_Перевыставления.УчетныйДоговор.УчетАгентскогоНДС = ИСТИНА
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ВТ_Перевыставления.Поставщик,
	               |	ВТ_Перевыставления.УчетныйДоговор"; 
	
	Запрос.УстановитьПараметр("Регистратор", ВедущийДокумент);  
	
	РезультатЗапроса = Запрос.Выполнить();

	Выборка = РезультатЗапроса.Выбрать();   
	Пока Выборка.Следующий() Цикл
		
		Движение = ДвиженияВедомого.Добавить();
		Движение.Период = Источник.Дата;
		Движение.СчетДт = ПредопределенноеЗначение("ПланСчетов.Хозрасчетный.РасчетыСПрочимиПоставщикамиИПодрядчиками"); 
		
		// Для версии КОРП
		Если ВестиУчетПоПодразделениям Тогда
			Если Движение.СчетДт.УчетПоПодразделениям Тогда
				Движение.ПодразделениеДт = Источник.ПодразделениеОрганизации;
			КонецЕсли;
		КонецЕсли;  
	
		Движение.СубконтоДт[Движение.СчетДт.ВидыСубконто[0].ВидСубконто] = ВедущийДокумент.Контрагент;
		Движение.СубконтоДт[Движение.СчетДт.ВидыСубконто[1].ВидСубконто] = ВедущийДокумент.Договор.УчетныйДоговор;	
		
		Движение.СчетКт = ПредопределенноеЗначение("ПланСчетов.Хозрасчетный.РасчетыНДСНалоговогоАгента"); 
		Движение.СубконтоКт[Движение.СчетКт.ВидыСубконто[0].ВидСубконто] = Выборка.Поставщик;
		Движение.СубконтоКт[Движение.СчетКт.ВидыСубконто[1].ВидСубконто] = Выборка.УчетныйДоговор;	
		Движение.Сумма		= Выборка.НДС;
		Движение.Содержание = "Начислен НДС в качестве налогового агента";
		
	КонецЦикла;
	
КонецПроцедуры

