				КонецЕсли; 
				
			КонецЦикла;
			
		КонецЕсли; 
		// --- 
		
		СФОбъект = СчетФактура.ПолучитьОбъект();
		// --- 			
		СФОбъект.ВидСчетаФактуры=Перечисления.ВидСчетаФактурыПолученного.НаПоступление;
		СФОбъект.Организация = Источник.Организация;
		// --- 
		Если (ВедущийДокумент.ПредъявленАкт) Тогда
			Если (ВедущийДокумент.ФормироватьВедомыеДатойДокумента) Тогда
				СФОбъект.Дата = ВедущийДокумент.Дата;
			Иначе
				Если (ВедущийДокумент.ДатаСФ > ВедущийДокумент.ДатаАкта) Тогда
					НоваяДатаСФ = ВедущийДокумент.ДатаСФ;
				Иначе
					НоваяДатаСФ = ВедущийДокумент.ДатаАкта;
				КонецЕсли; 
				
				Если ЗначениеЗаполнено(ВедущийДокумент.ДатаПолучения) Тогда
					НоваяДатаПолучения = ВедущийДокумент.ДатаПолучения;
				Иначе
					НоваяДатаПолучения = НоваяДатаСФ;
				КонецЕсли;
				
				СФОбъект.Дата = НоваяДатаПолучения;
				
			КонецЕсли; 
		Иначе
			СФОбъект.Дата = СФОбъект.Дата;
		КонецЕсли; 
		// --- 
		СФОбъект.НомерВходящегоДокумента = ВедущийДокумент.НомерСФ;
		СФОбъект.ДатаВходящегоДокумента = ВедущийДокумент.ДатаСФ;
		
		Если СФОбъект.ДокументыОснования.Найти(Источник.Ссылка, "ДокументОснование") = Неопределено Тогда
			СтрокаДокументыОснования = СФОбъект.ДокументыОснования.Добавить();
			СтрокаДокументыОснования.ДокументОснование = Источник.Ссылка;
		КонецЕсли;
		
		// --- 
		СФОбъект.ОпределениеПараметровСчетаФактуры();
		
		// --- 
		_сф.ст_УстановитьСвойство(СФОбъект.ДополнительныеСвойства,"ВедущийДокумент",ВедущийДокумент);
		Если (_сф.ст_ПолучитьСвойство(Источник.ДополнительныеСвойства,"Постановление735")=Неопределено) Тогда
			Постановление735 = CW_Настройки.ПараметрУчетнойПолитики(Источник.Дата, Источник.Организация, "ТребованияПостановления735");
		Иначе
			Постановление735 = _сф.ст_ПолучитьСвойство(Источник.ДополнительныеСвойства,"Постановление735");
		КонецЕсли; 
		_сф.ст_УстановитьСвойство(СФОбъект.ДополнительныеСвойства,"Постановление735",Постановление735);
		// --- 
		CW_Документы.ПеренестиПризнакВосстановленияПоследовательности(Источник,СФОбъект);
		// --- 				
		Попытка
			
			СФОбъект.Записать(РежимЗаписиДокумента.Проведение);
			
		Исключение
			Сообщить("Запись с/ф """+строка(СФОбъект)+"""");
			Сообщить(ОписаниеОшибки());
			Отказ = Истина;
		КонецПопытки; 
		
	КонецЕсли; 
	
КонецПроцедуры

Процедура ПроведениеКорректировкаПоступления(Источник, Отказ, РежимПроведения)
	
	//Для версии КОРП 
	ВестиУчетПоПодразделениям 	= ПолучитьФункциональнуюОпцию("ВестиУчетПоПодразделениям");
	//Для версии КОРП 
	
	ДатаНачалаВеденияУчета 			= CW_Настройки.ПолучитьДатуНачалаВеденияУчета(Источник.Организация);
	РежимВводНачальныхОстатков 		= ?(ДатаНачалаВеденияУчета = Неопределено, Ложь, (Источник.Дата < ДатаНачалаВеденияУчета));
	ВалютаРегламентированногоУчета 	= Константы.ВалютаРегламентированногоУчета.Получить();	
	
	
	// если не нашли ведущий документ, то выходим
	ВедущийДокумент = _сф.ст_ПолучитьСвойство(Источник.ДополнительныеСвойства,"ВедущийДокумент");
	Если (ВедущийДокумент = Неопределено) Тогда 
		Возврат; 
	КонецЕсли;
	Если (ВедущийДокумент.РучнаяКорректировка) Тогда
		Сообщить("Внимание! У ведущего документа "+Строка(ВедущийДокумент.Ссылка)+" установлен признак ручной корректировки движений!");
		Возврат;
	КонецЕсли;
	Если (Источник.РучнаяКорректировка) Тогда
		Сообщить("Внимание! У ведомого документа "+Строка(Источник.Ссылка)+" установлен признак ручной корректировки движений!");
		Возврат;
	КонецЕсли;
	
	// фикс
	Источник.Движения.Хозрасчетный.Записывать = Истина; 
	
	// ---------------------------------------------------------------------------- 
	
	Счета = CW_Конфигурация.ПланСчетов();
	Субконто = CW_Конфигурация.ВидыСубконто();
	// --- 
	//х76_5 	= CW_Настройки.ПараметрУчетнойПолитики(Источник.Дата, Источник.Организация, "СчетРасчетов_Клиенты_Рубли");
	//х76_25 	= CW_Настройки.ПараметрУчетнойПолитики(Источник.Дата, Источник.Организация, "СчетРасчетов_Клиенты_Валюта");
	//х76_35 	= CW_Настройки.ПараметрУчетнойПолитики(Источник.Дата, Источник.Организация, "СчетРасчетов_Клиенты_УЕ");
	
	х76_5  = Счета.РасчетыСПрочимиПоставщикамиИПодрядчиками;
	х76_25 = Счета.РасчетыСПрочимиПоставщикамиИПодрядчикамиВал;
	х76_35 = Счета.РасчетыСПрочимиПоставщикамиИПодрядчикамиУЕ;
	
	х76_6 	= Счета.РасчетыСПрочимиПокупателямиИЗаказчиками;
	х76_26 	= Счета.РасчетыСПрочимиПокупателямиИЗаказчикамиВал;
	х76_36 	= Счета.РасчетыСПрочимиПокупателямиИЗаказчикамиУЕ;
	х76НА 	= Счета.РасчетыНДСНалоговогоАгента;

	х76К 	= Счета.КорректировкаРасчетовПрошлогоПериода;
	// --- 
	х91_01 = Счета.ПрочиеДоходы;
	х91_02 = Счета.ПрочиеРасходы;
	// --- 
	ВРУ = CW_Настройки.ВалютаРегламентированногоУчета();
	
	// фикс договора на 76.5 или 76.6
	МассивУдаляемыхДвижений = Новый Массив;
	Для каждого Движение Из Источник.Движения.Хозрасчетный Цикл
		
		Если (Движение.СчетДт = х76_25 ИЛИ Движение.СчетДт = х76_35) Тогда
			
			Движение.СчетДт = х76_5;
			Движение.ВалютаДт = Неопределено;
			Движение.ВалютнаяСуммаДт = 0;
			
		КонецЕсли; 
		Если (Движение.СчетДт = х76_26 ИЛИ Движение.СчетДт = х76_36) Тогда
			
			Движение.СчетДт = х76_6;
			Движение.ВалютаДт = Неопределено;
			Движение.ВалютнаяСуммаДт = 0;
			
		КонецЕсли;

		// удаляем переоценку
		Если (Движение.СчетДт = х91_02 И (Движение.СчетКт = х76_5 ИЛИ Движение.СчетКт = х76_6 ИЛИ Движение.СчетКт = х76_25 ИЛИ Движение.СчетКт = х76_26 ИЛИ Движение.СчетКт = х76_35 ИЛИ Движение.СчетКт = х76_36)) Тогда
			МассивУдаляемыхДвижений.Добавить(Движение);
		КонецЕсли;
		Если (Движение.СчетКт = х91_01 И (Движение.СчетДт = х76_5 ИЛИ Движение.СчетДт = х76_6)) Тогда
			МассивУдаляемыхДвижений.Добавить(Движение);
		КонецЕсли;  
		
		// AF_00250014 
		//Если Движение.СчетДт = х76К ИЛИ Движение.СчетКт = х76К Тогда
		//	МассивУдаляемыхДвижений.Добавить(Движение);
		//КонецЕсли;
		
		Если (Движение.СчетДт = х76_5 ИЛИ Движение.СчетДт = х76_6) Тогда 	 
			
			// меняем договор на учётный 
			ВедущийДоговор = CW_Финансы.ПолучитьВедущийДоговор(Движение.СубконтоДт[Субконто.Договоры]);
			Движение.СубконтоДт[Субконто.Договоры] = ВедущийДоговор.УчетныйДоговор;
			Движение.СубконтоДт[Субконто.ДокументыРасчетовСКонтрагентами] = Неопределено;
		КонецЕсли; 	
		
	КонецЦикла;
	Если (МассивУдаляемыхДвижений.Количество() <> 0) Тогда
		_сф.к_УдалитьЭлементыПоМассиву(Источник.Движения.Хозрасчетный,МассивУдаляемыхДвижений);
	КонецЕсли;
	
	Если ВедущийДокумент.ПоказатьРубли Тогда
		СкорректироватьВалютныеСуммыВПроводках(Источник, ВедущийДокумент.Услуги);	
	КонецЕсли;
	// --- 
	СформироватьДвиженияДляКорректировкиРасходов(ВедущийДокумент,Отказ);
	
	// ---------------------------------------------------------------------------- 
	
	Если (ВедущийДокумент.ПредъявленСФ) Тогда
		
		СчетФактура = ВедущийДокумент.ВедомыйСчетФактураКорректировочный;
		СФОбъект = СчетФактура.ПолучитьОбъект();
		//СФОбъект = Документы.СчетФактураПолученный.СоздатьДокумент(); // тмп
		СФОбъект.ДокументОснование = Источник.Ссылка;
		// --- 
		
		Если СФОбъект.ДокументыОснования.Найти(Источник.Ссылка, "ДокументОснование") = Неопределено Тогда
			СтрокаДокументыОснования = СФОбъект.ДокументыОснования.Добавить();
			СтрокаДокументыОснования.ДокументОснование = Источник.Ссылка;
		КонецЕсли;
		
		// --- 
		СФОбъект.ОпределениеПараметровСчетаФактуры();
		СФОбъект.ОбменДанными.Загрузка=Ложь;
		СФОбъект.ПометкаУдаления = Ложь;
		// ---  
		
		Если ВедущийДокумент.Корректировка И ВедущийДокумент.ВидОперацииКорректировки = Перечисления.ВидыОперацийИсправленияПоступленияРеализации.ИсправлениеОшибки Тогда
			СФОбъект.НомерВходящегоДокумента = ВедущийДокумент.НомерСФ;
			СФОбъект.ДатаВходящегоДокумента = ВедущийДокумент.КорректируемыйДокумент.ДатаСФ;  
		Иначе
			СФОбъект.НомерВходящегоДокумента = ВедущийДокумент.НомерСФ;
			СФОбъект.ДатаВходящегоДокумента = ВедущийДокумент.ДатаСФ;  
		КонецЕсли;
		// --- 
		СФОбъект.КодСпособаПолучения = ВедущийДокумент.КодСпособаПолученияСФ;
		// --- 
		_сф.ст_УстановитьСвойство(СФОбъект.ДополнительныеСвойства,"ВедущийДокумент",ВедущийДокумент);
		// --- 
		CW_Документы.ПеренестиПризнакВосстановленияПоследовательности(Источник,СФОбъект);
		// --- 
		Попытка
			
			СФОбъект.Записать(РежимЗаписиДокумента.Проведение);
			
		Исключение
			Сообщить("Запись с/ф """+строка(СФОбъект)+"""");
			Сообщить(ОписаниеОшибки());
			Отказ = Истина;
		КонецПопытки;
		
		
	КонецЕсли; 
	
КонецПроцедуры

Процедура ПроведениеРеализацияТоваровУслуг(Источник, Отказ, РежимПроведения)
	
	//Для версии КОРП 
	ВестиУчетПоПодразделениям 	= ПолучитьФункциональнуюОпцию("ВестиУчетПоПодразделениям");
	//Для версии КОРП 
	
	ДатаНачалаВеденияУчета 			= CW_Настройки.ПолучитьДатуНачалаВеденияУчета(Источник.Организация);
	РежимВводНачальныхОстатков 		= ?(ДатаНачалаВеденияУчета = Неопределено, Ложь, (Источник.Дата < ДатаНачалаВеденияУчета));
	ВалютаРегламентированногоУчета 	= Константы.ВалютаРегламентированногоУчета.Получить();	
	
	// не нашли - выходим
	ВедущийДокумент = _сф.ст_ПолучитьСвойство(Источник.ДополнительныеСвойства,"ВедущийДокумент");
	Если (ВедущийДокумент = Неопределено) Тогда 
		Возврат; 
	КонецЕсли;
	
	Если (ВедущийДокумент.РучнаяКорректировка) Тогда
		Сообщить("Внимание! У ведущего документа "+Строка(ВедущийДокумент.Ссылка)+" установлен признак ручной корректировки движений!");
		Возврат;
	КонецЕсли;
	
	Если (Источник.РучнаяКорректировка) Тогда
		Сообщить("Внимание! У ведомого документа "+Строка(Источник.Ссылка)+" установлен признак ручной корректировки движений!");
		Возврат;
	КонецЕсли;
	
	ПараметрыУчетнойПолитики = CW_Настройки.ПараметрыУчетнойПолитики(Источник.Дата, Источник.Организация);
	СвояОрганизацияВКачествеПокупателя 	= ПараметрыУчетнойПолитики.СвояОрганизацияВКачествеПокупателя;
	
	СтруктураПараметров = CW_Настройки.ПустаяСтруктураПолученияПараметровДоговора();
	СтруктураПараметров.Дата 				= ВедущийДокумент.Дата;
	СтруктураПараметров.Договор 			= ВедущийДокумент.Договор;
	СтруктураПараметров.ПриложениеКДоговору = ВедущийДокумент.ПриложениеКДоговору;
	
	ПараметрыДоговора	= CW_Настройки.ПолучитьПараметрыДоговора(СтруктураПараметров, "РасчетРублевогоЭквивалентаПропорциональноПоСуммеИтога");
	
	РасчетРублевогоЭквивалентаПропорциональноПоСуммеИтога = ПараметрыДоговора.РасчетРублевогоЭквивалентаПропорциональноПоСуммеИтога;
	
	// устанавливаем признак записи в движениях документа
	Источник.Движения.Хозрасчетный.Записывать 					= Истина; 
	Источник.Движения.НДСЗаписиКнигиПродаж.Записывать 			= Истина;
	Источник.Движения.РеализованныеТоварыКомитентов.Записывать 	= Истина;
	Источник.Движения.РублевыеСуммыДокументовВВалюте.Записывать = Истина;
	Источник.Движения.НДСРеализация0.Записывать 				= Истина;
	Источник.Движения.КнигаУчетаДоходовИРасходов.Записывать 	= Истина;
	Источник.Движения.РеализацияУслуг.Записывать 				= Истина;
	
	// подготовим служебные переменные
	Счета = CW_Конфигурация.ПланСчетов(); 
	Субконто = CW_Конфигурация.ВидыСубконто(); 
	ВРУ = CW_Настройки.ВалютаРегламентированногоУчета();    
	ДействуетУСН = (CW_Настройки.ПараметрГлобальнойУчетнойПолитики(Источник.Дата,Источник.Организация,"СистемаНалогообложения")=Перечисления.СистемыНалогообложения.Упрощенная);
	ТребуетсяКорректировкаДвиженийУСН = Ложь;	
	
	// в зависимости от режима документа (ввод остатков или стандартный) 
	// удаляем либо все, либо часть движений...
	Если (РежимВводначальныхОстатков) Тогда
		
		// очищаем все движения...
		Для каждого Движение Из Источник.Движения Цикл
			Движение.Очистить();
		КонецЦикла;
		ДвиженияВедомого = Источник.Движения.Хозрасчетный;
		
		// формируем свои движения по вводу начальных остатков...
		Если (ВедущийДокумент.СальдоВзаиморасчетовБУ <> 0)  Тогда
			
			//проверяем, если есть наши услуги и возмещаемые, тогда делим сальдо между ними в пропорции...
			//--------------------------------------------------------------------------------------------
			УслугиСверткаПорОтраж = ВедущийДокумент.Услуги.Выгрузить();
			УслугиСверткаПорОтраж.Свернуть("ПорядокОтражения", "Всего");
			
			ЕстьСобственныеУслуги = Ложь;
			ЕстьВозмещаемыеУслуги = Ложь;
			СуммаСобственных = 0;
			СуммаВозмещаемых = 0;
			
			ТЗПропорцияРаспределенияСальдо = Новый ТаблицаЗначений;
			ТЗПропорцияРаспределенияСальдо.Колонки.Добавить("ПорядокОтражения");
			ТЗПропорцияРаспределенияСальдо.Колонки.Добавить("СуммаРаспределенная");
			
			// определили
			Для каждого Стр Из УслугиСверткаПорОтраж Цикл
				
				// собственные
				Если Стр.ПорядокОтражения = Перечисления.CW_ПорядокОтраженияДоходов.СобственнаяУслуга 
					или Стр.ПорядокОтражения = Перечисления.CW_ПорядокОтраженияДоходов.ПрочиеДоходы Тогда
					
					ЕстьСобственныеУслуги = Истина;
					_сф.Инкремент(СуммаСобственных,Стр.Всего); 
					
				Иначе
					
					ЕстьВозмещаемыеУслуги = Истина;
					_сф.Инкремент(СуммаВозмещаемых,Стр.Всего); 
					
				КонецЕсли;
				
			КонецЦикла;
			
			Если (ЕстьСобственныеУслуги И ЕстьВозмещаемыеУслуги) Тогда
				
				// делаем пропорцию
				СуммаРаспределеннаяПоСобственным = Окр(СуммаСобственных*ВедущийДокумент.СальдоВзаиморасчетовБУ/(СуммаСобственных+СуммаВозмещаемых),2);
				СуммаРаспределеннаяПоВозмещаемым = ВедущийДокумент.СальдоВзаиморасчетовБУ - СуммаРаспределеннаяПоСобственным;
				// --- 
				Нстр = ТЗПропорцияРаспределенияСальдо.Добавить();
				Нстр.ПорядокОтражения = "СобственнаяУслуга";
