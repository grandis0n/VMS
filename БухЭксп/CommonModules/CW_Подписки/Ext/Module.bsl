							Движение.ЧастьЖурнала					= Перечисления.ЧастиЖурналаУчетаСчетовФактур.ВыставленныеСчетаФактуры;
							Движение.ИндексСтроки 					= ИндексСтроки;
							Движение.ДатаВыставленияПолучения 		= Источник.ДатаВыставления;
							Движение.КодСпособаВыставленияПолучения = Источник.КодСпособаВыставления;
							// ---                                
							
							ИсходныйВедущий = ПолучитьИсходныйСчетФактуру(ВедущийДокумент);
							
							Движение.НомерСчетаФактуры 	= CW_Документы.ПолучитьНомерНаПечать(Новый Структура("Организация, Номер, Дата", ИсходныйВедущий.Организация, ИсходныйВедущий.НомерСчетаФактуры, ИсходныйВедущий.ДатаСчетаФактуры));
							Движение.ДатаСчетаФактуры 	= ИсходныйВедущий.ДатаСчетаФактуры;   
							
							ИсходныйВедущийПоследнееИсправление = ПолучитьПоследнееИсправлениеИсходногоСчетФактуры(ИсходныйВедущий, "CW_ДоходыПоГрузоперевозке"); 	
							
							Если ИсходныйВедущийПоследнееИсправление <> ИсходныйВедущий Тогда
								Движение.НомерИсправления	= ИсходныйВедущийПоследнееИсправление.НомерИсправления;
								Движение.ДатаИсправления 	= ИсходныйВедущийПоследнееИсправление.ДатаСчетаФактуры; 
							КонецЕсли;
								
							Если НЕ ВедущийДокумент.Договор.ВзаиморасчетыВУЕ Тогда
								Движение.Валюта = Источник.ВалютаДокумента;
							Иначе
								Движение.Валюта = ВРУ;
							КонецЕсли;
							// --- 
							Движение.КодВидаОперации = КодВидаОперации;
							Движение.КодВидаОперацииКомиссия = Источник.КодВидаОперацииНаУменьшение;
							
							Если Движение.Валюта = ВРУ Тогда
								Если Стр.Всего_Рег >= 0 Тогда
									Движение.СуммаПоСчетуФактуреРазницаУвеличениеКомиссия 	= Стр.Всего_Рег;
									Движение.СуммаНДСРазницаУвеличениеКомиссия 				= Стр.НДС_Рег;
									
									Движение.СуммаПоСчетуФактуреРазницаУвеличение 	= Стр.Всего_Рег;
									Движение.СуммаНДСРазницаУвеличение 				= Стр.НДС_Рег;
									
									Если Источник.ДокументОснование.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсправленияПоступленияРеализации.ИсправлениеОшибки") Тогда
										Движение.СуммаНДС  						= Стр.НДС_Рег;
										Движение.СуммаНДСКомиссия  				= Стр.НДС_Рег;
										Движение.СуммаПоСчетуФактуре   			= Стр.Всего_Рег;
										Движение.СуммаПоСчетуФактуреКомиссия  	= Стр.Всего_Рег;
									КонецЕсли;
									
								Иначе
									Движение.СуммаПоСчетуФактуреРазницаУменьшениеКомиссия 	= _сф.Модуль(Стр.Всего_Рег);
									Движение.СуммаНДСРазницаУменьшениеКомиссия 				= _сф.Модуль(Стр.НДС_Рег);
									
									Движение.СуммаПоСчетуФактуреРазницаУменьшение 	= _сф.Модуль(Стр.Всего_Рег);
									Движение.СуммаНДСРазницаУменьшение 				= _сф.Модуль(Стр.НДС_Рег);
									
									Если Источник.ДокументОснование.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсправленияПоступленияРеализации.ИсправлениеОшибки") Тогда
										Движение.СуммаНДС  						= -Стр.НДС_Рег;
										Движение.СуммаНДСКомиссия  				= -Стр.НДС_Рег;
										Движение.СуммаПоСчетуФактуре   			= -Стр.Всего_Рег;
										Движение.СуммаПоСчетуФактуреКомиссия  	= -Стр.Всего_Рег;
									КонецЕсли;
									
								КонецЕсли;
								
							Иначе
								Если Стр.Всего >= 0 Тогда
									Движение.СуммаПоСчетуФактуреРазницаУвеличениеКомиссия 	= Стр.Всего;
									Движение.СуммаНДСРазницаУвеличениеКомиссия 				= Стр.НДС;
									
									Движение.СуммаПоСчетуФактуреРазницаУвеличение 			= Стр.Всего;
									Движение.СуммаНДСРазницаУвеличение 						= Стр.НДС;
									
									Если Источник.ДокументОснование.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсправленияПоступленияРеализации.ИсправлениеОшибки") Тогда
										Движение.СуммаНДС  						= Стр.НДС;
										Движение.СуммаНДСКомиссия  				= Стр.НДС;
										Движение.СуммаПоСчетуФактуре   			= Стр.Всего;
										Движение.СуммаПоСчетуФактуреКомиссия  	= Стр.Всего;
									КонецЕсли;
									
								Иначе
									Движение.СуммаПоСчетуФактуреРазницаУменьшениеКомиссия 	= _сф.Модуль(Стр.Всего);
									Движение.СуммаНДСРазницаУменьшениеКомиссия 				= _сф.Модуль(Стр.НДС);
									
									Движение.СуммаПоСчетуФактуреРазницаУменьшение 	= _сф.Модуль(Стр.Всего);
									Движение.СуммаНДСРазницаУменьшение 				= _сф.Модуль(Стр.НДС);
									
									Если Источник.ДокументОснование.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсправленияПоступленияРеализации.ИсправлениеОшибки") Тогда
										Движение.СуммаНДС  						= -Стр.НДС;
										Движение.СуммаНДСКомиссия  				= -Стр.НДС;
										Движение.СуммаПоСчетуФактуре   			= -Стр.Всего;
										Движение.СуммаПоСчетуФактуреКомиссия  	= -Стр.Всего;
									КонецЕсли;
									
								КонецЕсли;
							КонецЕсли;
							// --- 
							Движение.ПоСтавкеБезНДС = _сф.к_НайтиСтроку(ТЗ_ДокументыРасходов,Новый Структура("ДокументРасходов",Стр.ДокументРасходов)).БезНДС;
							// --- 
							Движение.СчетФактураНеВыставляется = Ложь;
							// --- 
							Движение.ИННКонтрагента = Источник.Контрагент.ИНН;
							Движение.КППКонтрагента = Справочники.Контрагенты.КППНаДату(Источник.Контрагент, Источник.Дата);
							
							Движение.Субкомиссионер = Неопределено;
							Движение.КодВидаСделки = "";
							
							Если (Стр.ДокументРасходов.ПредъявленСФ) Тогда
								
								Движение.Продавец = Стр.Продавец;
								Движение.ИННПродавца = Движение.Продавец.ИНН;
								Движение.КПППродавца = Справочники.Контрагенты.КППНаДату(Движение.Продавец, Источник.Дата);
								Движение.НомерСчетаФактурыПродавца = Стр.ДокументРасходов.НомерСФ;
								Движение.ДатаСчетаФактурыПродавца = Стр.ДокументРасходов.ДатаСФ;	
								
							КонецЕсли; 
							
							_сф.Инкремент(ИндексСтроки);

							
						КонецЦикла;  
						
						//Сторно
						Если Источник.ДокументОснование.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсправленияПоступленияРеализации.ИсправлениеОшибки") Тогда			
							
							Если ВедущийДокумент.КорректируемыйДокумент.Корректировка Тогда
								ИсправляемыйДокументСчетФактура = ВедущийДокумент.КорректируемыйДокумент.ВедомыйСчетФактураКорректировочный;
							Иначе
								ИсправляемыйДокументСчетФактура = ВедущийДокумент.КорректируемыйДокумент.ВедомыйСчетФактура;							
							КонецЕсли;
							
							Набор = РегистрыСведений.ЖурналУчетаСчетовФактур.СоздатьНаборЗаписей();
							Набор.Отбор.Регистратор.Установить(ИсправляемыйДокументСчетФактура);
							Набор.Прочитать();  
							
							Для Каждого СтрокаНабора из Набор Цикл 
								Если СтрокаНабора.Сторно Тогда
									Продолжить;
								КонецЕсли;
								
								Движение = Источник.Движения.ЖурналУчетаСчетовФактур.Добавить(); 
								ЗаполнитьЗначенияСвойств(Движение, СтрокаНабора,,"Регистратор");
								
								Движение.Сторно = Истина; 
								
								Движение.СуммаПоСчетуФактуре 	= - Движение.СуммаПоСчетуФактуре; 
								Движение.СуммаНДС 				= - Движение.СуммаНДС; 
								Движение.СуммаПоСчетуФактуреРазницаУменьшение = - Движение.СуммаПоСчетуФактуреРазницаУменьшение; 
								Движение.СуммаПоСчетуФактуреРазницаУвеличение = - Движение.СуммаПоСчетуФактуреРазницаУвеличение; 
								Движение.СуммаНДСРазницаУменьшение = - Движение.СуммаНДСРазницаУменьшение; 
								Движение.СуммаНДСРазницаУвеличение = - Движение.СуммаНДСРазницаУвеличение; 
								
								Движение.СуммаПоСчетуФактуреКомиссия 	= - Движение.СуммаПоСчетуФактуреКомиссия; 
								Движение.СуммаНДСКомиссия 				= - Движение.СуммаНДСКомиссия; 
								Движение.СуммаПоСчетуФактуреРазницаУменьшениеКомиссия = - Движение.СуммаПоСчетуФактуреРазницаУменьшениеКомиссия; 
								Движение.СуммаПоСчетуФактуреРазницаУвеличениеКомиссия = - Движение.СуммаПоСчетуФактуреРазницаУвеличениеКомиссия; 
								Движение.СуммаНДСРазницаУменьшениеКомиссия = - Движение.СуммаНДСРазницаУменьшениеКомиссия; 
								Движение.СуммаНДСРазницаУвеличениеКомиссия = - Движение.СуммаНДСРазницаУвеличениеКомиссия; 
								
							КонецЦикла;
							
						КонецЕсли;
						//Сторно
						
						
					КонецЕсли;	
					
				КонецЕсли;
				
			КонецЕсли; 
			
		КонецЕсли; 
	
	#КонецОбласти 
	
КонецПроцедуры   

Процедура СкорректироватьВалютныеСуммыВПроводках(Источник, Услуги) 
	
	СтатьяПрочихДоходовИРасходов 	= Источник.СтатьяПрочихДоходовИРасходов;
	ДвиженияХозрасчетный 			= Источник.Движения.Хозрасчетный;
	
	Счет20_01 =	ПредопределенноеЗначение("ПланСчетов.Хозрасчетный.ОсновноеПроизводство");
	Счет76_05 =	ПредопределенноеЗначение("ПланСчетов.Хозрасчетный.РасчетыСПрочимиПоставщикамиИПодрядчиками");  
	Счет19_04 = ПредопределенноеЗначение("ПланСчетов.Хозрасчетный.НДСпоПриобретеннымУслугам");

	Счет91_01 = ПредопределенноеЗначение("ПланСчетов.Хозрасчетный.ПрочиеДоходы");  
	Счет91_02 = ПредопределенноеЗначение("ПланСчетов.Хозрасчетный.ПрочиеРасходы");  

	Запрос = Новый Запрос; 
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.Текст = "ВЫБРАТЬ
	|	УслугиДокумента.ПорядокОтражения КАК ПорядокОтражения,
	|	УслугиДокумента.ПрочиеРасходы КАК ПрочиеРасходы,
	|	УслугиДокумента.СпособУчетаНДС КАК СпособУчетаНДС,
	|	УслугиДокумента.Номенклатура КАК Номенклатура,
	|	УслугиДокумента.Подразделение КАК Подразделение,
	|	УслугиДокумента.СтатьяЗатрат КАК СтатьяЗатрат,
	|	УслугиДокумента.Покупатель КАК Покупатель,
	|	УслугиДокумента.ДоговорПокупателя КАК ДоговорПокупателя,
	|	УслугиДокумента.Сумма КАК Сумма,
	|	УслугиДокумента.Сумма_ДоКорректировки КАК Сумма_ДоКорректировки,
	|	УслугиДокумента.НДС КАК НДС,
	|	УслугиДокумента.НДС_ДоКорректировки КАК НДС_ДоКорректировки,
	|	УслугиДокумента.Всего КАК Всего,
	|	УслугиДокумента.Всего_ДоКорректировки КАК Всего_ДоКорректировки
	|ПОМЕСТИТЬ ВТ_УслугиДокумента
	|ИЗ
	|	&Услуги КАК УслугиДокумента
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_УслугиДокумента.ПорядокОтражения КАК ПорядокОтражения,
	|	ВТ_УслугиДокумента.ПрочиеРасходы КАК ПрочиеРасходы,
	|	ВТ_УслугиДокумента.СпособУчетаНДС КАК СпособУчетаНДС,
	|	ВТ_УслугиДокумента.Номенклатура.НоменклатурнаяГруппа КАК НоменклатурнаяГруппа,
	|	ВТ_УслугиДокумента.Подразделение КАК Подразделение,
	|	ВТ_УслугиДокумента.СтатьяЗатрат КАК СтатьяЗатрат,
	|	ВТ_УслугиДокумента.Покупатель КАК Покупатель,
	|	ВТ_УслугиДокумента.ДоговорПокупателя КАК ДоговорПокупателя,
	|	ВТ_УслугиДокумента.Сумма - ВТ_УслугиДокумента.Сумма_ДоКорректировки КАК Сумма,
	|	ВТ_УслугиДокумента.НДС - ВТ_УслугиДокумента.НДС_ДоКорректировки КАК НДС,
	|	ВТ_УслугиДокумента.Всего - ВТ_УслугиДокумента.Всего_ДоКорректировки КАК Всего
	|ПОМЕСТИТЬ ВТ_ДанныеУслуг
	|ИЗ
	|	ВТ_УслугиДокумента КАК ВТ_УслугиДокумента";
	
	
	Запрос.УстановитьПараметр("Услуги", Услуги.Выгрузить());
	
	Запрос.Выполнить();       
	
	//СуммуНДС можно сразу получить    
	Запрос.Текст = "ВЫБРАТЬ
	|	ВТ_ДанныеУслуг.СпособУчетаНДС КАК СпособУчетаНДС,
	|	ВТ_ДанныеУслуг.НДС КАК НДС
	|ИЗ
	|	ВТ_ДанныеУслуг КАК ВТ_ДанныеУслуг";   
	
	РезультатЗапроса = Запрос.Выполнить();   
	ВыборкаНДС = РезультатЗапроса.Выбрать();
	
	//Затраты
	Запрос.Текст = "ВЫБРАТЬ
	|	ВТ_ДанныеУслуг.Подразделение КАК Подразделение,
	|	ВТ_ДанныеУслуг.НоменклатурнаяГруппа КАК НоменклатурнаяГруппа,
	|	ВТ_ДанныеУслуг.СтатьяЗатрат КАК СтатьяЗатрат,
	|	СУММА(ВТ_ДанныеУслуг.Сумма) КАК Сумма
	|ИЗ
	|	ВТ_ДанныеУслуг КАК ВТ_ДанныеУслуг
	|ГДЕ
	|	ВТ_ДанныеУслуг.ПорядокОтражения = Значение(Перечисление.CW_ПорядокОтраженияЗатрат.Затраты)
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_ДанныеУслуг.Подразделение,
	|	ВТ_ДанныеУслуг.НоменклатурнаяГруппа,
	|	ВТ_ДанныеУслуг.СтатьяЗатрат";   
	
	РезультатЗапросаЗатраты = Запрос.Выполнить();  
	ВыборкаЗатраты = РезультатЗапросаЗатраты.Выбрать();
	
	//ЗатратыОбщие
	Запрос.Текст = "ВЫБРАТЬ
	|	СУММА(ВТ_ДанныеУслуг.Сумма) КАК Сумма
	|ИЗ
	|	ВТ_ДанныеУслуг КАК ВТ_ДанныеУслуг
	|ГДЕ
	|	ВТ_ДанныеУслуг.ПорядокОтражения = ЗНАЧЕНИЕ(Перечисление.CW_ПорядокОтраженияЗатрат.Затраты)";
	
	РезультатЗапросаЗатратыОбщие = Запрос.Выполнить();  
	ВыборкаЗатратыОбщие = РезультатЗапросаЗатратыОбщие.Выбрать();
	
	
	//Преревыствление
	Запрос.Текст = "ВЫБРАТЬ
	|	ВТ_ДанныеУслуг.Подразделение КАК Подразделение,
	|	ВТ_ДанныеУслуг.Покупатель КАК Покупатель,
	|	ВТ_ДанныеУслуг.ДоговорПокупателя КАК ДоговорПокупателя,
	|	СУММА(ВТ_ДанныеУслуг.Сумма) КАК Сумма
	|ИЗ
	|	ВТ_ДанныеУслуг КАК ВТ_ДанныеУслуг
	|ГДЕ
	|	ВТ_ДанныеУслуг.ПорядокОтражения = Значение(Перечисление.CW_ПорядокОтраженияЗатрат.Перевыставление)
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_ДанныеУслуг.Подразделение,
	|	ВТ_ДанныеУслуг.Покупатель,
	|	ВТ_ДанныеУслуг.ДоговорПокупателя";   
	
	РезультатЗапросаПеревыставление = Запрос.Выполнить();  
	ВыборкаПеревыставление = РезультатЗапросаПеревыставление.Выбрать();
	
	//ПрочиеРасходы
	Запрос.Текст = "ВЫБРАТЬ
	|	ВТ_ДанныеУслуг.Подразделение КАК Подразделение,
	|	ВТ_ДанныеУслуг.ПрочиеРасходы КАК ПрочиеРасходы,
	|	СУММА(ВТ_ДанныеУслуг.Сумма) КАК Сумма
	|ИЗ
	|	ВТ_ДанныеУслуг КАК ВТ_ДанныеУслуг
	|ГДЕ
	|	ВТ_ДанныеУслуг.ПорядокОтражения = Значение(Перечисление.CW_ПорядокОтраженияЗатрат.ПрочиеРасходы)
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_ДанныеУслуг.Подразделение,
	|	ВТ_ДанныеУслуг.ПрочиеРасходы";
	
	РезультатЗапросаПрочиеРасходы = Запрос.Выполнить();  
	ВыборкаПрочиеРасходы = РезультатЗапросаПрочиеРасходы.Выбрать();
	
	Для Каждого Движение из ДвиженияХозрасчетный Цикл   
		
		//НДС    
		Если Движение.СчетКт.Валютный и  Движение.СчетДт = Счет19_04 Тогда
			Отбор = новый Структура;
			Отбор.Вставить("СпособУчетаНДС", Движение.СубконтоДт[Движение.СчетДт.ВидыСубконто[2].ВидСубконто]);
			
			ВыборкаНДС.Сбросить();
			Если ВыборкаНДС.НайтиСледующий(Отбор) тогда
				Движение.ВалютнаяСуммаКт = ВыборкаНДС.НДС;
			КонецЕсли;
		КонецЕсли;  
		//НДС    
		
		//Затраты
		Если Движение.СчетКт.Валютный и  Движение.СчетДт = Счет20_01 Тогда
			Отбор = новый Структура;
			Отбор.Вставить("Подразделение", 		Движение.ПодразделениеДт);
			Отбор.Вставить("НоменклатурнаяГруппа", 	Движение.СубконтоДт[Движение.СчетДт.ВидыСубконто[0].ВидСубконто]);
			Отбор.Вставить("СтатьяЗатрат",			Движение.СубконтоДт[Движение.СчетДт.ВидыСубконто[1].ВидСубконто]); 
			
			ВыборкаЗатраты.Сбросить();
			Если ВыборкаЗатраты.НайтиСледующий(Отбор) тогда
				Движение.ВалютнаяСуммаКт = ВыборкаЗатраты.Сумма;
			КонецЕсли;
		КонецЕсли;  
		//Затраты
		
		//Перевыставление
		Если Движение.СчетКт.Валютный и  Движение.СчетДт = Счет76_05 Тогда
			Отбор = новый Структура;
			Отбор.Вставить("Подразделение",		Движение.ПодразделениеДт);
			Отбор.Вставить("Покупатель", 		Движение.СубконтоДт[Движение.СчетДт.ВидыСубконто[0].ВидСубконто]);
			Отбор.Вставить("ДоговорПокупателя",	Движение.СубконтоДт[Движение.СчетДт.ВидыСубконто[1].ВидСубконто]); 
			
			ВыборкаПеревыставление.Сбросить();
			Если ВыборкаПеревыставление.НайтиСледующий(Отбор) тогда
				Движение.ВалютнаяСуммаКт = ВыборкаПеревыставление.Сумма;
			КонецЕсли;
		КонецЕсли; 
		//Перевыставление
		
		//ПрочиеРасходы
		Если Движение.СчетКт.Валютный и Движение.СчетДт = Счет91_02 Тогда 
			
			Если Движение.СубконтоДт[Движение.СчетДт.ВидыСубконто[0].ВидСубконто] = СтатьяПрочихДоходовИРасходов Тогда
				//Корректировка прошлых периодов
				Если ВыборкаЗатратыОбщие.Следующий() Тогда
					Движение.ВалютнаяСуммаКт = Макс(ВыборкаЗатратыОбщие.Сумма, - ВыборкаЗатратыОбщие.Сумма);
				КонецЕсли;
			Иначе
				Отбор = новый Структура;
				Отбор.Вставить("Подразделение",	Движение.ПодразделениеДт);
				Отбор.Вставить("ПрочиеРасходы",	Движение.СубконтоДт[Движение.СчетДт.ВидыСубконто[0].ВидСубконто]);
				
				ВыборкаПрочиеРасходы.Сбросить();
				Если ВыборкаПрочиеРасходы.НайтиСледующий(Отбор) тогда
					Движение.ВалютнаяСуммаКт = ВыборкаПрочиеРасходы.Сумма;
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли; 
		//ПрочиеРасходы 
		
		//Корректировка прошлых периодов
		Если Движение.СчетДт.Валютный 
			И Движение.СчетКт = Счет91_01
			И Движение.СубконтоКт[Движение.СчетКт.ВидыСубконто[0].ВидСубконто] = СтатьяПрочихДоходовИРасходов Тогда 
			
			Если ВыборкаЗатратыОбщие.Следующий() Тогда
				Движение.ВалютнаяСуммаДт = Макс(ВыборкаЗатратыОбщие.Сумма, - ВыборкаЗатратыОбщие.Сумма);
			КонецЕсли;
		КонецЕсли; 
		//Корректировка прошлых периодов
		
	КонецЦикла;
	
	
КонецПроцедуры
//Проведение ведомых документов

Процедура ПометитьНаУдалениеСвязанныйДокументОплата(Знач Источник)
	
	Перем Ведомый, Выборка, Запрос, РезультатЗапроса;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	CW_Оплата.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.CW_Оплата КАК CW_Оплата
	|ГДЕ
	|	CW_Оплата.Основание = &Основание"; 
	
	Запрос.УстановитьПараметр("Основание", Источник.Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		Ведомый = Выборка.Ссылка.ПолучитьОбъект();
		Ведомый.УстановитьПометкуУдаления(Истина);
	КонецЦикла;

КонецПроцедуры 


Процедура ОбработатьДвиженияНДСНеоблагаемыеОперации(Источник, ВедущийДокумент)
	
	Если Источник.Движения.НДСНеоблагаемыеОперации.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;  
	
	КодРаздел7ДекларацииНДС = Источник.ДоговорКонтрагента.КодРаздел7ДекларацииНДС;
	КодРаздел7ДекларацииНДС = ?(Не ЗначениеЗаполнено(КодРаздел7ДекларацииНДС), Неопределено, КодРаздел7ДекларацииНДС);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	&Период КАК Период,
	               |	&ВидДвижения КАК ВидДвижения,
	               |	&Организация КАК Организация,
	               |	ВЫБОР
	               |		КОГДА &КодРаздел7ДекларацииНДС = НЕОПРЕДЕЛЕНО
	               |			ТОГДА CW_ДоходыПоГрузоперевозкам.Номенклатура.КодРаздел7ДекларацииНДС
	               |		ИНАЧЕ &КодРаздел7ДекларацииНДС
	               |	КОНЕЦ КАК КодОперации,
	               |	CW_ДоходыПоГрузоперевозкам.Контрагент КАК Контрагент,
	               |	&ДокументРеализации КАК ДокументРеализации,
	               |	СУММА(ВЫБОР
	               |			КОГДА CW_ДоходыПоГрузоперевозкам.Валюта <> &БазоваяВалюта
	               |					И CW_ДоходыПоГрузоперевозкам.Договор.ВзаиморасчетыВУЕ = ЛОЖЬ
	               |				ТОГДА CW_ДоходыПоГрузоперевозкам.Сумма_Валюта * ЕСТЬNULL(КурсыВалютСрезПоследних.Курс, 0) / ЕСТЬNULL(КурсыВалютСрезПоследних.Кратность, 1)
	               |			ИНАЧЕ CW_ДоходыПоГрузоперевозкам.Сумма
	               |		КОНЕЦ) КАК СуммаРеализацииБезНДС
	               |ИЗ
	               |	РегистрНакопления.CW_ДоходыПоГрузоперевозкам КАК CW_ДоходыПоГрузоперевозкам
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют.СрезПоследних(&Период, ) КАК КурсыВалютСрезПоследних
	               |		ПО CW_ДоходыПоГрузоперевозкам.Валюта = КурсыВалютСрезПоследних.Валюта
	               |ГДЕ
	               |	CW_ДоходыПоГрузоперевозкам.Регистратор = &Регистратор
	               |	И CW_ДоходыПоГрузоперевозкам.СтавкаНДС = ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.БезНДС)
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	CW_ДоходыПоГрузоперевозкам.Контрагент,
	               |	ВЫБОР
	               |		КОГДА &КодРаздел7ДекларацииНДС = НЕОПРЕДЕЛЕНО
	               |			ТОГДА CW_ДоходыПоГрузоперевозкам.Номенклатура.КодРаздел7ДекларацииНДС
	               |		ИНАЧЕ &КодРаздел7ДекларацииНДС
	               |	КОНЕЦ";   
	
	Запрос.УстановитьПараметр("Регистратор", 				ВедущийДокумент);

	Запрос.УстановитьПараметр("Период", 					Источник.Дата);
	Запрос.УстановитьПараметр("ВидДвижения", 				ВидДвиженияНакопления.Приход);
	Запрос.УстановитьПараметр("КодРаздел7ДекларацииНДС", 	КодРаздел7ДекларацииНДС);
	Запрос.УстановитьПараметр("Организация", 				Источник.Организация);
	Запрос.УстановитьПараметр("ДокументРеализации", 		Источник.Ссылка);
	
	Запрос.УстановитьПараметр("БазоваяВалюта", 				Константы.ВалютаРегламентированногоУчета.Получить());
	Запрос.УстановитьПараметр("ДокументРеализации", 		Источник.Ссылка);

	РезультатЗапроса = Запрос.Выполнить();
	
	Источник.Движения.НДСНеоблагаемыеОперации.Загрузить(РезультатЗапроса.Выгрузить());
	
	Источник.Движения.НДСНеоблагаемыеОперации.Записывать = Истина;
	
КонецПроцедуры

Функция  ПолучитьОстаткиПеревыставления(ВедущийДокумент)
	
	СтруктураТаблиц = Новый Структура("ТаблицаОстатка, ТаблицаПеревставления",Неопределено, Неопределено);
	
	// смотрим остаток по регистру "Перевыставление" и проверяем, не образуется ли копеек
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.Текст = "ВЫБРАТЬ
	               |	CW_ДоходыПоГрузоперевозкеУслуги.Номенклатура КАК Номенклатура,
	               |	CW_ДоходыПоГрузоперевозкеУслуги.Грузоперевозка КАК Грузоперевозка,
	               |	CW_ДоходыПоГрузоперевозкеУслуги.Ссылка.Контрагент КАК Контрагент,
	               |	CW_ДоходыПоГрузоперевозкеУслуги.Ссылка.Договор КАК Договор,
	               |	CW_ДоходыПоГрузоперевозкеУслуги.Ссылка.ПриложениеКДоговору КАК ПриложениеКДоговору,
	               |	CW_ДоходыПоГрузоперевозкеУслуги.ДокументРасходов КАК ДокументРасходов,
	               |	CW_ДоходыПоГрузоперевозкеУслуги.СтавкаНДС КАК СтавкаНДС,
	               |	CW_ДоходыПоГрузоперевозкеУслуги.ПорядокОтражения КАК ПорядокОтражения,
	               |	СУММА(CW_ДоходыПоГрузоперевозкеУслуги.Количество) КАК Количество,
	               |	СУММА(CW_ДоходыПоГрузоперевозкеУслуги.Сумма) КАК Сумма,
	               |	СУММА(CW_ДоходыПоГрузоперевозкеУслуги.НДС) КАК СуммаНДС,
	               |	СУММА(CW_ДоходыПоГрузоперевозкеУслуги.Всего) КАК Всего,
	               |	CW_ДоходыПоГрузоперевозкеУслуги.СчетЗадолженности КАК СчетРасчетов
	               |ПОМЕСТИТЬ ВТ_ДанныеДокумента
	               |ИЗ
	               |	Документ.CW_ДоходыПоГрузоперевозке.Услуги КАК CW_ДоходыПоГрузоперевозкеУслуги
	               |ГДЕ
	               |	CW_ДоходыПоГрузоперевозкеУслуги.Ссылка = &ВедущийДокумент
	               |	И НЕ CW_ДоходыПоГрузоперевозкеУслуги.ПорядокОтражения в (&ПорядокОтражения)
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	CW_ДоходыПоГрузоперевозкеУслуги.Грузоперевозка,
	               |	CW_ДоходыПоГрузоперевозкеУслуги.Ссылка.Контрагент,
	               |	CW_ДоходыПоГрузоперевозкеУслуги.Номенклатура,
	               |	CW_ДоходыПоГрузоперевозкеУслуги.Ссылка.Договор,
	               |	CW_ДоходыПоГрузоперевозкеУслуги.ДокументРасходов,
	               |	CW_ДоходыПоГрузоперевозкеУслуги.СтавкаНДС,
	               |	CW_ДоходыПоГрузоперевозкеУслуги.ПорядокОтражения,
	               |	CW_ДоходыПоГрузоперевозкеУслуги.СчетЗадолженности,
	               |	CW_ДоходыПоГрузоперевозкеУслуги.Ссылка.ПриложениеКДоговору";
	
	
	ПорядокОтражения = Новый Массив;
	ПорядокОтражения.Добавить(Перечисления.CW_ПорядокОтраженияДоходов.СобственнаяУслуга);
	ПорядокОтражения.Добавить(Перечисления.CW_ПорядокОтраженияДоходов.ПрочиеДоходы);
	
	Запрос.УстановитьПараметр("ВедущийДокумент"		, ВедущийДокумент);
	Запрос.УстановитьПараметр("ПорядокОтражения"	, ПорядокОтражения);
	Запрос.Выполнить();
	
	//Таблица перевыставления
	Запрос.Текст = "ВЫБРАТЬ
	               |	ВТ_ДанныеДокумента.Номенклатура КАК Номенклатура,
	               |	ВТ_ДанныеДокумента.Грузоперевозка КАК Грузоперевозка,
	               |	ВТ_ДанныеДокумента.Контрагент КАК Контрагент,
	               |	ВТ_ДанныеДокумента.Договор КАК Договор,
	               |	ВТ_ДанныеДокумента.ПриложениеКДоговору КАК ПриложениеКДоговору,
	               |	ВТ_ДанныеДокумента.ДокументРасходов КАК ДокументРасходов,
	               |	ВТ_ДанныеДокумента.СтавкаНДС КАК СтавкаНДС,
	               |	ВТ_ДанныеДокумента.СчетРасчетов КАК СчетРасчетов,
	               |	ВТ_ДанныеДокумента.ПорядокОтражения КАК ПорядокОтражения,
	               |	ВТ_ДанныеДокумента.Количество КАК Количество,
	               |	ВТ_ДанныеДокумента.Сумма КАК Сумма,
	               |	ВТ_ДанныеДокумента.СуммаНДС КАК СуммаНДС,
	               |	ВТ_ДанныеДокумента.Всего КАК Всего
	               |ИЗ
	               |	ВТ_ДанныеДокумента КАК ВТ_ДанныеДокумента";
	
	РезультатПеревставление = 	Запрос.Выполнить();
	
	СтруктураТаблиц.ТаблицаПеревставления = РезультатПеревставление.Выгрузить();
	
	
	//Измерения для получения остатка
	Запрос.Текст  = "ВЫБРАТЬ
	                |	ВТ_ДанныеДокумента.Номенклатура КАК Номенклатура,
	                |	ВТ_ДанныеДокумента.Грузоперевозка КАК Грузоперевозка,
	                |	ВТ_ДанныеДокумента.Контрагент КАК Контрагент,
	                |	ВТ_ДанныеДокумента.Договор КАК Договор,
	                |	ВТ_ДанныеДокумента.ПриложениеКДоговору КАК ПриложениеКДоговору,
	                |	ВТ_ДанныеДокумента.ДокументРасходов КАК ДокументРасходов,
	                |	ВТ_ДанныеДокумента.СтавкаНДС КАК СтавкаНДС
	                |ПОМЕСТИТЬ ВТ_ИзмеренияОстатка
	                |ИЗ
	                |	ВТ_ДанныеДокумента КАК ВТ_ДанныеДокумента
	                |
	                |СГРУППИРОВАТЬ ПО
	                |	ВТ_ДанныеДокумента.Номенклатура,
	                |	ВТ_ДанныеДокумента.Грузоперевозка,
	                |	ВТ_ДанныеДокумента.Контрагент,
	                |	ВТ_ДанныеДокумента.Договор,
	                |	ВТ_ДанныеДокумента.ПриложениеКДоговору,
	                |	ВТ_ДанныеДокумента.ДокументРасходов,
	                |	ВТ_ДанныеДокумента.СтавкаНДС";
	Запрос.Выполнить();	
	
	
	//Остатки по регистру
	Запрос.Текст  = "ВЫБРАТЬ
	                |	ВТ_ИзмеренияОстатка.Номенклатура КАК Номенклатура,
	                |	ВТ_ИзмеренияОстатка.Грузоперевозка КАК Грузоперевозка,
	                |	ВТ_ИзмеренияОстатка.Контрагент КАК Контрагент,
	                |	ВТ_ИзмеренияОстатка.Договор КАК Договор,
	                |	ВТ_ИзмеренияОстатка.ПриложениеКДоговору КАК ПриложениеКДоговору,
	                |	ВТ_ИзмеренияОстатка.ДокументРасходов КАК ДокументРасходов,
	                |	ВТ_ИзмеренияОстатка.СтавкаНДС КАК СтавкаНДС,
	                |	CW_ПеревыставлениеОстатки.КоличествоОстаток КАК Количество,
	                |	CW_ПеревыставлениеОстатки.ВсегоОстаток КАК Всего_Рег,
	                |	CW_ПеревыставлениеОстатки.СуммаОстаток КАК Сумма_Рег,
	                |	CW_ПеревыставлениеОстатки.НДСОстаток КАК НДС_Рег
	                |ИЗ
	                |	ВТ_ИзмеренияОстатка КАК ВТ_ИзмеренияОстатка
	                |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.CW_Перевыставление.Остатки(
	                |				&Период,
	                |				(Контрагент, Договор, ПриложениеКДоговору, Грузоперевозка, Номенклатура, ДокументРасходов, СтавкаНДС) В
	                |					(ВЫБРАТЬ
	                |						ВТ_ИзмеренияОстатка.Контрагент КАК Контрагент,
	                |						ВТ_ИзмеренияОстатка.Договор КАК Договор,
	                |						ВТ_ИзмеренияОстатка.ПриложениеКДоговору КАК ПриложениеКДоговору,
	                |						ВТ_ИзмеренияОстатка.Грузоперевозка КАК Грузоперевозка,
	                |						ВТ_ИзмеренияОстатка.Номенклатура КАК Номенклатура,
	                |						ВТ_ИзмеренияОстатка.ДокументРасходов КАК ДокументРасходов,
	                |						ВТ_ИзмеренияОстатка.СтавкаНДС КАК СтавкаНДС
	                |					ИЗ
	                |						ВТ_ИзмеренияОстатка КАК ВТ_ИзмеренияОстатка)) КАК CW_ПеревыставлениеОстатки
	                |		ПО ВТ_ИзмеренияОстатка.Номенклатура = CW_ПеревыставлениеОстатки.Номенклатура
	                |			И ВТ_ИзмеренияОстатка.Грузоперевозка = CW_ПеревыставлениеОстатки.Грузоперевозка
	                |			И ВТ_ИзмеренияОстатка.Контрагент = CW_ПеревыставлениеОстатки.Контрагент
	                |			И ВТ_ИзмеренияОстатка.Договор = CW_ПеревыставлениеОстатки.Договор
	                |			И ВТ_ИзмеренияОстатка.ПриложениеКДоговору = CW_ПеревыставлениеОстатки.ПриложениеКДоговору
	                |			И ВТ_ИзмеренияОстатка.ДокументРасходов = CW_ПеревыставлениеОстатки.ДокументРасходов
	                |			И ВТ_ИзмеренияОстатка.СтавкаНДС = CW_ПеревыставлениеОстатки.СтавкаНДС";
	
	Запрос.УстановитьПараметр("Период"			, ВедущийДокумент.МоментВремени());
	
	РезультатЗапроса = Запрос.Выполнить();
	
	СтруктураТаблиц.ТаблицаОстатка = РезультатЗапроса.Выгрузить();
	
	Возврат СтруктураТаблиц;
	
КонецФункции

//ЭДО
// чтобы счёт, реализация, с/ф нормально вставали на регистрацию в ЭДО, при том, что их по несколько раз записывают и в нужный момент документ не выглядит новым или модифицированным
Процедура ПодготовитьДокументОбъектДляЭДО(ДокументОбъект, Отказ, РежимЗаписи, РежимПроведения) Экспорт 
	
	Если CW_ДокументооборотНастроен(ДокументОбъект) Тогда
		CW_ОчиститьАктуальныйЭлектронныйДокумент(ДокументОбъект);	
		CW_УстановитьОснованиеНовогоЭлектронногоДокумента(ДокументОбъект);
	КонецЕсли;
	
КонецПроцедуры

// Функция - документооборот настроен
//
// Параметры:
//  ОбъектУчета	 - 	 - 
// 
// Возвращаемое значение:
//   - 
//
Функция CW_ДокументооборотНастроен(ОбъектУчета)
	
	ТаблицаОписаниеОбъектаУчета = ИнтеграцияЭДО.ОписаниеОбъектаУчета(ОбъектУчета);
	Если ТаблицаОписаниеОбъектаУчета.количество() > 0 Тогда
		ОписаниеОбъектаУчета = ТаблицаОписаниеОбъектаУчета[0];
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
	Если ОписаниеОбъектаУчета.Направление = Перечисления.НаправленияЭДО.Интеркампани Тогда 
		КлючНастроек = НастройкиЭДОКлиентСервер.НовыйКлючНастроекОтправки();
		КлючНастроек.Отправитель = ОписаниеОбъектаУчета.Организация;
		КлючНастроек.Получатель = ОписаниеОбъектаУчета.Контрагент;
		КлючНастроек.Договор = ОписаниеОбъектаУчета.Договор;
		КлючНастроек.ВидДокумента = ЭлектронныеДокументыЭДО.ВидДокументаПоТипу(ОписаниеОбъектаУчета.ТипДокумента);
		Настройки = НастройкиЭДО.НастройкиОтправки(КлючНастроек);		
	ИначеЕсли ОписаниеОбъектаУчета.Направление = Перечисления.НаправленияЭДО.Внутренний Тогда
		Запросы = Новый Массив;
		
		ИдентификаторОбъектаУчета = ОбщегоНазначения.ИдентификаторОбъектаМетаданных(ОбъектУчета.Метаданные().ПолноеИмя());
		
		ОтборНастроекВнутреннегоЭДО = НастройкиЭДО.НовыйОтборНастроекВнутреннегоЭДО();
		ОтборНастроекВнутреннегоЭДО.Организация = "&Организация";
		ОтборНастроекВнутреннегоЭДО.ПроизвольноеУсловие = "ВидВнутреннегоДокумента.ИдентификаторОбъектаУчета = &ИдентификаторОбъектаУчета";		
		
		ЗапросНастроек = НастройкиЭДО.ЗапросНастроекВнутреннегоЭДО("НастройкиВнутреннегоЭДО", ОтборНастроекВнутреннегоЭДО);
		
		Запросы.Добавить(ЗапросНастроек);
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		|	НастройкиВнутреннегоЭДО.Организация КАК Организация,
		|	НастройкиВнутреннегоЭДО.ВидВнутреннегоДокумента КАК ВидДокумента,
		|	НастройкиВнутреннегоЭДО.Формировать КАК Формировать,
		|	НастройкиВнутреннегоЭДО.ВидПодписи КАК ВидПодписи,
		|	НастройкиВнутреннегоЭДО.МаршрутПодписания КАК МаршрутПодписания,
		|	НастройкиВнутреннегоЭДО.ЭтоОсновнойВидДокумента КАК ЭтоОсновнойВидДокумента
		|ИЗ
		|	НастройкиВнутреннегоЭДО";
		
		ИтоговыйЗапрос = ОбщегоНазначенияБЭД.СоединитьЗапросы(Запрос, Запросы);
		ИтоговыйЗапрос.УстановитьПараметр("Организация", ОписаниеОбъектаУчета.Организация);
		ИтоговыйЗапрос.УстановитьПараметр("ИдентификаторОбъектаУчета", ИдентификаторОбъектаУчета);
		
		УстановитьПривилегированныйРежим(Истина);
		Настройки = ИтоговыйЗапрос.Выполнить().Выгрузить();
		Если Не ЗначениеЗаполнено(Настройки) Тогда
			Настройки = Неопределено;
		КонецЕсли;
		УстановитьПривилегированныйРежим(Ложь);

	Иначе
		КлючНастроек = ЭлектронныеДокументыЭДО.КлючНастроекОтправкиОбъектаУчета(ОписаниеОбъектаУчета);
		Настройки = НастройкиЭДО.НастройкиОтправки(КлючНастроек);
	КонецЕсли;

	
	Если Настройки = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если ОписаниеОбъектаУчета.Направление = Перечисления.НаправленияЭДО.Интеркампани
		Или ОписаниеОбъектаУчета.Направление = Перечисления.НаправленияЭДО.Внутренний Тогда 
	 	Возврат Истина;
	Иначе
		Возврат Настройки.ГотовностьКОбмену;
	КонецЕсли;

КонецФункции

// Удаляет информацию о состоянии актуального электронного документа.
//
// Параметры:
//  ОбъектУчета - ОпределяемыйТип.ОснованияЭлектронныхДокументовЭДО
//
Процедура CW_ОчиститьАктуальныйЭлектронныйДокумент(Знач ОбъектУчета, Знач ЭлектронныйДокумент = Неопределено)	
	
	НачатьТранзакцию();
	Попытка
		
		НаборЗаписей = РегистрыСведений.ОбъектыУчетаДокументовЭДО.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ОбъектУчета.Установить(ОбъектУчета);
		ОбщегоНазначенияБЭД.УстановитьУправляемуюБлокировкуПоНаборуЗаписей(НаборЗаписей);
		НаборЗаписей.Прочитать();
		
		Для каждого Запись Из НаборЗаписей Цикл
			
			Если Не Запись.Актуальный Тогда
				Продолжить;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ЭлектронныйДокумент)
				И Запись.ЭлектронныйДокумент <> ЭлектронныйДокумент Тогда
				Продолжить;
			КонецЕсли;
			
			Запись.Актуальный = Ложь;
			
		КонецЦикла;
		
		Если НаборЗаписей.Модифицированность() Тогда
			НаборЗаписей.Записать();
		КонецЕсли;
		
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		
		ИмяСобытия = НСтр("ru = 'Очистка информации о состоянии актуального электронного документа'",
		ОбщегоНазначения.КодОсновногоЯзыка());
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка,,,
		ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		
	КонецПопытки;

	
КонецПроцедуры

// Назначает объект учета основанием нового электронного документа.
//
// Параметры:
//  ОбъектУчета - ОпределяемыйТип.ОснованияЭлектронныхДокументовЭДО
//
Процедура CW_УстановитьОснованиеНовогоЭлектронногоДокумента(ОбъектУчета)
	
	Описание = ИнтеграцияЭДО.ОписаниеОснованияЭлектронногоДокумента(ОбъектУчета);
	
	CW_ЗаписатьОснованиеНовогоЭлектронногоДокумента(ОбъектУчета.Ссылка, Описание);
	
КонецПроцедуры

// Сохраняет описание основания нового электронного документа.
//
// Параметры:
//  ОбъектУчета - ОпределяемыйТип.ОснованияЭлектронныхДокументовЭДО
//  Описание - см. НовоеОписаниеОснованияЭлектронногоДокумента
//
Процедура CW_ЗаписатьОснованиеНовогоЭлектронногоДокумента(ОбъектУчета, Знач Описание)
	
	УстановитьПривилегированныйРежим(Истина);	
	
	НачатьТранзакцию();
	Попытка
		
		Набор = РегистрыСведений.СостоянияПоОбъектамУчетаЭДО.СоздатьНаборЗаписей();
		Набор.Отбор.СсылкаНаОбъект.Установить(ОбъектУчета);
		ОбщегоНазначенияБЭД.УстановитьУправляемуюБлокировкуПоНаборуЗаписей(Набор);
		Набор.Прочитать();
		
		ОбновитьСостояние = Ложь;
		Если Не ЗначениеЗаполнено(Набор) Тогда
			Запись = Набор.Добавить();
			Запись.СсылкаНаОбъект = ОбъектУчета;
			ОбновитьСостояние = Истина;
		КонецЕсли;
		
		Для каждого Запись Из Набор Цикл
			
			Запись.Вид = Описание.Вид;
			Запись.Дата = Описание.Дата;
			Запись.Номер = Описание.Номер;
			Запись.Организация = Описание.Организация;
			Запись.Контрагент = Описание.Контрагент;
			Запись.СуммаДокумента = Описание.СуммаДокумента;
			
		КонецЦикла;
		
		Набор.Записать();
		
		Если ОбновитьСостояние Тогда
			CW_ОбновитьСостояниеЭДООбъектаУчета(ОбъектУчета);
		КонецЕсли;
		
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		
		ИмяСобытия = НСтр("ru = 'Запись описания основания нового электронного документа'",
			ОбщегоНазначения.КодОсновногоЯзыка());
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка,,,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));

	КонецПопытки;

КонецПроцедуры

// Обновляет объекту учета актуальное состояние электронных документов.
// 
// Параметры:
//  ОбъектУчета - ОпределяемыйТип.ОснованияЭлектронныхДокументовЭДО - объект учета для обновления состояния.
//
Процедура CW_ОбновитьСостояниеЭДООбъектаУчета(Знач ОбъектУчета)
	
	СостояниеОбъектаУчета = ИнтеграцияЭДО.РассчитатьСостояниеОбъектаУчета(ОбъектУчета);
	
	Состояние = СостояниеОбъектаУчета.Состояние;
	ПредставлениеСостояния = СостояниеОбъектаУчета.ПредставлениеСостояния;
	
	CW_УстановитьСостояниеЭлектронныхДокументовОбъектаУчета(ОбъектУчета, Состояние, ПредставлениеСостояния);
	
КонецПроцедуры

// Сохраняет информацию о состоянии актуальных электронных документов объекта учета.
//
// Параметры:
//  ОбъектУчета - ОпределяемыйТип.ОснованияЭлектронныхДокументовЭДО
//  Состояние - ПеречислениеСсылка.СостоянияДокументовЭДО - состояние электронного документа.
//  ПредставлениеСостояния - Строка - представление состояния электронных документов.
//
Процедура CW_УстановитьСостояниеЭлектронныхДокументовОбъектаУчета(Знач ОбъектУчета, Знач Состояние, Знач ПредставлениеСостояния)
	
	УстановитьПривилегированныйРежим(Истина);
	
	НачатьТранзакцию();
	Попытка
		
		Набор = РегистрыСведений.СостоянияПоОбъектамУчетаЭДО.СоздатьНаборЗаписей();
		Набор.Отбор.СсылкаНаОбъект.Установить(ОбъектУчета);
		
		ОбщегоНазначенияБЭД.УстановитьУправляемуюБлокировкуПоНаборуЗаписей(Набор);
		
		Набор.Прочитать();
		
		Если Не ЗначениеЗаполнено(Набор) Тогда
			Запись = Набор.Добавить();
			Запись.СсылкаНаОбъект = ОбъектУчета;
		КонецЕсли;
		
		Для каждого Запись Из Набор Цикл
			Запись.СостояниеЭДО = Состояние;
			Запись.ПредставлениеСостояния = ПредставлениеСостояния;
		КонецЦикла;
		
		Набор.Записать();
		
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		
		ИмяСобытия = НСтр("ru = 'Запись информации о состоянии актуальных электронных документов объекта учета'",
			ОбщегоНазначения.КодОсновногоЯзыка());
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка,,,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		
		ВызватьИсключение;
		
	КонецПопытки;
	
КонецПроцедуры
//ЭДО

Функция ПолучитьИсходныйСчетФактуру(Ведомый) Экспорт 
	
	Если Ведомый.Корректировка Тогда
		Возврат	ПолучитьИсходныйСчетФактуру(Ведомый.КорректируемыйДокумент);
	КонецЕсли; 
	
	Возврат Ведомый;
	                             
КонецФункции  

Функция ПолучитьПоследнееИсправлениеИсходногоСчетФактуры(Ведомый, ТипДокумента) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ДокументРасходыДоходы.Ссылка КАК Ссылка
	               |ИЗ
	               |	Документ."+ТипДокумента+" КАК ДокументРасходыДоходы
	               |ГДЕ
	               |	ДокументРасходыДоходы.КорректируемыйДокумент = &КорректируемыйДокумент
	               |	И ДокументРасходыДоходы.ВидОперацииКорректировки = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийИсправленияПоступленияРеализации.ИсправлениеОшибки)"; 
	
	Запрос.УстановитьПараметр("КорректируемыйДокумент", Ведомый);   
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат	ПолучитьПоследнееИсправлениеИсходногоСчетФактуры(Выборка.Ссылка, ТипДокумента);	
	КонецЕсли; 
	
	Возврат Ведомый; 
	
КонецФункции

// Пересчитывает переданную рублевую сумму по новому курсу (исходя из старого курса) 
//
// Параметры
// ---------
//  <Сумма>  - рублевая сумма, которую нужно пересчитать
//  <СтарыйКурс>  - курс, по которому была расчитан параметр <Сумма>
//  <НовыйКурс>  - курс, по которому нужно пересчитать параметр <Сумма>
//
// Возвращаемое значение
// ---------------------
//   Новое значение параметра <Сумма>, расчитанное по курсу <НовыйКурс>
//
Функция ПересчитатьРублевуюСуммуПоНовомуКурсу(Сумма,СтарыйКурс,НовыйКурс)
	Возврат ?(СтарыйКурс = 0,Сумма,Окр(Сумма/СтарыйКурс*НовыйКурс,2,1))	
КонецФункции // ПересчитатьРублевуюСуммуПоНовомуКурсу()
 

// Производит проверку необходимости пересчета (корректировки) рублевых эквивалентов строк документа,
// производит корректировку рублевых эквивалентов в регистре "РублевыеСуммыДокументовВВалюте" и
// готовит таблицу с расчитанными (скорректированными) рублевыми показателями
// 
// Параметры:
// 		Источник - ведомый документ "Поступление товаров и услуг" 		
// 		ВедущийДокумент - ведущий документ "Расходы по грузоперевозкам" 		
// 		УслугиВедущего - табличная часть "Услуги" документа "Расходы по грузоперевозкам" с пересчитанными рублевыми эквивалентами  		
// 		ТребуетсяПересчитыватьСуммыНДС - признак (флаг) необходимости пересчета рублевых сумм с учетом зачтенного аванса
//
Процедура ЗаполнитьРублевыеЭквивалентыВДокументеРасходыПоГрузоперевозкамПоДвижениямПоступления(Источник, ВедущийДокумент, УслугиВедущего, ТребуетсяПересчитыватьСуммыНДС)
	
	МассивИндексовСобственных = Новый Массив;
	МассивИндексовВозмещаемых = Новый Массив;
	Для каждого СтрокаУслуг Из УслугиВедущего Цикл
		Если (СтрокаУслуг.ПорядокОтражения = Перечисления.CW_ПорядокОтраженияЗатрат.Затраты)
			ИЛИ (СтрокаУслуг.ПорядокОтражения = Перечисления.CW_ПорядокОтраженияЗатрат.ПрочиеРасходы) Тогда
			МассивИндексовСобственных.Добавить(УслугиВедущего.Индекс(СтрокаУслуг));
		Иначе
			МассивИндексовВозмещаемых.Добавить(УслугиВедущего.Индекс(СтрокаУслуг));
		КонецЕсли; 
	КонецЦикла; 

	// заполнение рублевых эквивалентов в документе "Расходы по грузоперевозкам" на основании 
	// движений документа "Поступление товаров и услуг"
	ИндексСтрокСобственных = 0;
	ИндексСтрокВозмещаемых = 0;
	УчетАгентскогоНДС = Источник.ДоговорКонтрагента.УчетАгентскогоНДС;
	
	ТребуетсяПересчитыватьСуммыНДС = 
		Источник.ДополнительныеСвойства.Свойство("УчитыватьКурсыВалютАвансовДляБазыНДС")
		И Источник.ДополнительныеСвойства.УчитыватьКурсыВалютАвансовДляБазыНДС 
		И ВедущийДокумент.ЗачетАвансов.Количество()>0
		И НЕ ВедущийДокумент.Корректировка
	;
	     
	Для каждого Движение Из Источник.Движения.РублевыеСуммыДокументовВВалюте Цикл
		
		Если (Движение.ТабличнаяЧастьДокумента = Перечисления.ТабличныеЧастиДокументов.Услуги) Тогда
			ИндексСтроки = МассивИндексовСобственных.Получить(ИндексСтрокСобственных);
			ИндексСтрокСобственных = ИндексСтрокСобственных + 1;
		Иначе
			ИндексСтроки = МассивИндексовВозмещаемых.Получить(ИндексСтрокВозмещаемых);
			ИндексСтрокВозмещаемых = ИндексСтрокВозмещаемых + 1;
		КонецЕсли;
		
		СтрокаУслуг = УслугиВедущего.Получить(ИндексСтроки);
		
		Если НЕ УчетАгентскогоНДС Тогда
			СтрокаУслуг.Всего_Рег = Движение.Всего;
			СтрокаУслуг.НДС_Рег = Движение.НДС;
			СтрокаУслуг.Сумма_Рег = СтрокаУслуг.Всего_Рег - СтрокаУслуг.НДС_Рег;
		Иначе
			Если (СтрокаУслуг.ПорядокОтражения = Перечисления.CW_ПорядокОтраженияЗатрат.Затраты) 
				ИЛИ (СтрокаУслуг.ПорядокОтражения = Перечисления.CW_ПорядокОтраженияЗатрат.ПрочиеРасходы) Тогда
				СтрокаУслуг.Всего_Рег 	= Движение.Всего - Движение.НДС;//Движение.НалоговаяБазаНДС;//СтрокаУслуг.Всего_Рег;//;
				СтрокаУслуг.НДС_Рег 	= 0;
				СтрокаУслуг.Сумма_Рег 	= Движение.Всего - Движение.НДС;//СтрокаУслуг.Всего_Рег;
			Иначе
				СтрокаУслуг.Всего_Рег = Движение.Всего;
				СтрокаУслуг.НДС_Рег = Движение.НДС;
				СтрокаУслуг.Сумма_Рег =Движение.Всего - Движение.НДС;// Движение.НалоговаяБазаНДС;
			КонецЕсли; 
		КонецЕсли; 
		
		Если ТребуетсяПересчитыватьСуммыНДС Тогда 
			
			// в УслугиВедущего	уже проставлены рублёвые суммы, 
			// но в них надо пересчитать суммы НДС и без НДС отталкиваясь от суммы Всего
			ЧислоСтавкаНДС = CW_Финансы.ПолучитьСтавкуНДС(СтрокаУслуг.СтавкаНДС);
			СтрокаУслуг.НДС_Рег = Окр(СтрокаУслуг.Всего_Рег * ЧислоСтавкаНДС / (100 + ЧислоСтавкаНДС), 2);
			СтрокаУслуг.Сумма_Рег = СтрокаУслуг.Всего_Рег - СтрокаУслуг.НДС_Рег;
			
			Движение.НДС = СтрокаУслуг.НДС_Рег;
			Движение.НалоговаяБазаНДС = СтрокаУслуг.Сумма_Рег;
			Движение.Всего = СтрокаУслуг.Всего_Рег;
		КонецЕсли;
		
	КонецЦикла; // обход движений регистра "РублевыеСуммыДокументовВВалюте" 

КонецПроцедуры

// Производит корректировку движений ведомого документа (НДС и Сумма) на основании
// переданной таблицы рублевых эквивалентов табличной части услуг ведущего документа
//
// Параметры:
// 		Источник - ДокументОбъект.ПоступлениеТоваровУслуг
// 		ВедущийДокумент - ДокументСсылка.CW_РасходыПоГрузоперевозке
// 		УслугиВедущего	- ТаблицаЗначений (по структуре т.ч. Услуги)
//
Процедура СкорректироватьНДСРубИСуммаРубСУчетомЗачтенногоАванса(Источник, ВедущийДокумент, УслугиВедущего)
	
	//Для версии КОРП 
	ВестиУчетПоПодразделениям 		= ПолучитьФункциональнуюОпцию("ВестиУчетПоПодразделениям");
	ВестиУчетЗатратПоПодразделениям = ПолучитьФункциональнуюОпцию("ВестиУчетЗатратПоПодразделениям");
	//Для версии КОРП 
	
	// подготовим служебные переменные
	#Область СлужебныеПеременные_1152
		РаздельныйУчетНДСНаСчете19 = CW_Настройки.ПараметрГлобальнойУчетнойПолитики(Источник.Дата,Источник.Организация,"РаздельныйУчетНДСНаСчете19");
		СложныйУчетНДС = CW_Настройки.ПараметрГлобальнойУчетнойПолитики(Источник.Дата,Источник.Организация,"СложныйУчетНДС");
		
		// флаг того, что организация на УСН 
		СистемаНалогообложенияУСН = (CW_Настройки.ПараметрГлобальнойУчетнойПолитики(Источник.Дата,Источник.Организация,"СистемаНалогообложения") = Перечисления.СистемыНалогообложения.Упрощенная);
		КорректироватьКУДиР = (CW_Настройки.ПараметрГлобальнойУчетнойПолитики(Источник.Дата,Источник.Организация,"ОбъектНалогообложенияУСН") = Перечисления.ОбъектыНалогообложенияПоУСН.ДоходыМинусРасходы) и СистемаНалогообложенияУСН;
		
		ПланСчетов = CW_Конфигурация.ПланСчетов();
		сч19х = ПланСчетов.НДСпоПриобретеннымЦенностям;
		сч20х = ПланСчетов.ОсновноеПроизводство_;
		сч60х = ПланСчетов.РасчетыСПоставщикамиИПодрядчиками;
		
		сч19 = ПланСчетов.НДСпоПриобретеннымУслугам;	//19.04
		сч20 = ПланСчетов.ОсновноеПроизводство;		//20.01
		
		// соответствие Способам учета НДС событиям книги покупок
		СпособСобытие = Новый Соответствие;
		СпособСобытие.Вставить(Перечисления.СпособыУчетаНДС.ПринимаетсяКВычету, Перечисления.СобытияПоНДСПокупки.ПредъявленНДСПоставщиком);
		СпособСобытие.Вставить(Перечисления.СпособыУчетаНДС.ДляОперацийПо0, Перечисления.СобытияПоНДСПокупки.ПредполагаетсяСтавка0);
		СпособСобытие.Вставить(Перечисления.СпособыУчетаНДС.Распределяется, Перечисления.СобытияПоНДСПокупки.НДСПодлежитРаспределению);
		СпособСобытие.Вставить(Перечисления.СпособыУчетаНДС.УчитываетсяВCтоимости, Перечисления.СобытияПоНДСПокупки.НДСВключенВСтоимость);
		
		// подготовим таблицу собственных услуг и добавим в нее служебные колонки
		ТаблицаСобственныхУслуг = УслугиВедущего.Скопировать(Новый Структура("ПорядокОтражения", Перечисления.CW_ПорядокОтраженияЗатрат.Затраты));
		
		ТаблицаПрочиеРасходы = УслугиВедущего.Скопировать(Новый Структура("ПорядокОтражения", Перечисления.CW_ПорядокОтраженияЗатрат.ПрочиеРасходы));
		Для каждого СтрТЗ из ТаблицаПрочиеРасходы Цикл
			СтрокаТЗ = ТаблицаСобственныхУслуг.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаТЗ,СтрТЗ);
		КонецЦикла;
		
		_СФ.т_ДобавитьКолонки(ТаблицаСобственныхУслуг,"СобытиеПоНДСПокупки");
		Для Каждого СтрТЗ Из ТаблицаСобственныхУслуг Цикл
			СтрТЗ.СобытиеПоНДСПокупки = СпособСобытие.Получить(СтрТЗ.СпособУчетаНДС);
		КонецЦикла; 
		
	#КонецОбласти // СлужебныеПеременные_1152
	
	// сформируем проводки по собственным услугам взамен удаленных
	#Область КорректировкаБухгалтерскихПроводок
	
		// удаляем все проводки, связанные с собственными услугами
		// ниже сформируем их самостоятельно
		МассивУдаляемыхПроводок = Новый Массив;
		Проводки = Источник.Движения.Хозрасчетный;
		Для Каждого зап Из Проводки Цикл
			Если 
				(зап.СчетДт.ПринадлежитЭлементу(сч19х) И зап.СчетКт.ПринадлежитЭлементу(сч60х)) или // выделение НДС
				(зап.СчетДт.ПринадлежитЭлементу(сч20х) И зап.СчетКт.ПринадлежитЭлементу(сч19х)) или // включение НДС в стоимость
				(зап.СчетДт.ПринадлежитЭлементу(сч20х) И зап.СчетКт.ПринадлежитЭлементу(сч60х))     // себестоимость услу
			Тогда
				МассивУдаляемыхПроводок.Добавить(зап);
			КонецЕсли;
		КонецЦикла;
		
		Для Каждого зап Из МассивУдаляемыхПроводок Цикл
			Проводки.Удалить(зап);
		КонецЦикла;
		
		// формируем необходимые проводки самостоятельно
		Для Каждого строкаУслуг Из ТаблицаСобственныхУслуг Цикл
		
		    // проводка по себестоимости затрат
			дв = Источник.Движения.Хозрасчетный.Добавить();
			дв.Период                          = Источник.Дата;
			дв.Организация                     = Источник.Организация;
			
			дв.СчетДт                          = сч20;
			
			БухгалтерскийУчет.УстановитьСубконто(дв.СчетДт, дв.СубконтоДт, "НоменклатурныеГруппы"	, строкаУслуг.Номенклатура.НоменклатурнаяГруппа);
			БухгалтерскийУчет.УстановитьСубконто(дв.СчетДт, дв.СубконтоДт, "СтатьиЗатрат"			, строкаУслуг.СтатьяЗатрат);
			БухгалтерскийУчет.УстановитьСубконто(дв.СчетДт, дв.СубконтоДт, "Продукция"				, строкаУслуг.Номенклатура);
			
			//Для версии КОРП
			Если ВестиУчетПоПодразделениям Тогда
				Если дв.СчетДт.УчетПоПодразделениям Тогда
					дв.ПодразделениеДт = ?(ВестиУчетЗатратПоПодразделениям,строкаУслуг.Подразделение,Источник.ПодразделениеОрганизации);
				КонецЕсли;
			Иначе
				Если ВестиУчетЗатратПоПодразделениям и дв.СчетДт.УчетПоПодразделениям Тогда
					дв.ПодразделениеДт = строкаУслуг.Подразделение;
				КонецЕсли;
			КонецЕсли;
			//Для версии КОРП

			
			дв.СчетКт                          = строкаУслуг.СчетЗадолженности;
			дв.ВалютаКт                        = Источник.ВалютаДокумента;
			
			БухгалтерскийУчет.УстановитьСубконто(дв.СчетКт, дв.СубконтоКт, "Контрагенты"						, Источник.Контрагент);
			БухгалтерскийУчет.УстановитьСубконто(дв.СчетКт, дв.СубконтоКт, "Договоры"							, Источник.ДоговорКонтрагента);
			БухгалтерскийУчет.УстановитьСубконто(дв.СчетКт, дв.СубконтоКт, "ДокументыРасчетовСКонтрагентами"	, Источник.Ссылка);

			//Для версии КОРП
			Если ВестиУчетПоПодразделениям И дв.СчетКт.УчетПоПодразделениям Тогда
				дв.ПодразделениеКт = Источник.ПодразделениеОрганизации;
			КонецЕсли;
			//Для версии КОРП

			
			// если организация на УСН, то в проводку на затраты включаем сумму НДС
			Если СистемаНалогообложенияУСН Тогда
				СебестоимостьЗатрат = СтрокаУслуг.Всего_Рег;
				СебестоимостьЗатратВал = СтрокаУслуг.Всего;
			Иначе
				СебестоимостьЗатрат = СтрокаУслуг.Сумма_Рег;
				СебестоимостьЗатратВал = СтрокаУслуг.Сумма;
			КонецЕсли; 
			
			дв.Сумма                           = СебестоимостьЗатрат;
			дв.СуммаНУДт                       = СебестоимостьЗатрат;
			дв.СуммаНУКт                       = СебестоимостьЗатрат;
			дв.ВалютнаяСуммаКт                 = СебестоимостьЗатратВал;
			дв.Содержание                      = СтрокаУслуг.Представление;
			
			// проводки по НДС делаем при условии того, что сумма НДС <> 0 и организация находится на ОСНО
			Если (СистемаНалогообложенияУСН = Ложь) И ((СтрокаУслуг.НДС_Рег <> 0) ИЛИ (СтрокаУслуг.НДС <> 0)) Тогда
				
				// проводка по НДС
				дв = Источник.Движения.Хозрасчетный.Добавить();
				дв.Период                          = Источник.Дата;
				дв.Организация                     = Источник.Организация;
							
				дв.СчетДт                          = сч19;
				
				БухгалтерскийУчет.УстановитьСубконто(дв.СчетДт, дв.СубконтоДт, "СФПолученные"		, Источник.Ссылка);
				БухгалтерскийУчет.УстановитьСубконто(дв.СчетДт, дв.СубконтоДт, "Контрагенты"		, Источник.Контрагент);
				БухгалтерскийУчет.УстановитьСубконто(дв.СчетДт, дв.СубконтоДт, "СпособыУчетаНДС"	,?(РаздельныйУчетНДСНаСчете19,строкаУслуг.СпособУчетаНДС,Неопределено));

				//Для версии КОРП
				Если ВестиУчетПоПодразделениям И дв.СчетДт.УчетПоПодразделениям Тогда
					дв.ПодразделениеДт = Источник.ПодразделениеОрганизации;
				КонецЕсли;
				//Для версии КОРП
			
				дв.СчетКт                          = строкаУслуг.СчетЗадолженности;
				дв.ВалютаКт                        = Источник.ВалютаДокумента;
				
				БухгалтерскийУчет.УстановитьСубконто(дв.СчетКт, дв.СубконтоКт, "Контрагенты"						, Источник.Контрагент);
				БухгалтерскийУчет.УстановитьСубконто(дв.СчетКт, дв.СубконтоКт, "Договоры"							, Источник.ДоговорКонтрагента);
				БухгалтерскийУчет.УстановитьСубконто(дв.СчетКт, дв.СубконтоКт, "ДокументыРасчетовСКонтрагентами"	, Источник.Ссылка);
				
				//Для версии КОРП
				Если ВестиУчетПоПодразделениям И дв.СчетКт.УчетПоПодразделениям Тогда
					дв.ПодразделениеКт = Источник.ПодразделениеОрганизации;
				КонецЕсли;
				//Для версии КОРП
				
				дв.Сумма                           = СтрокаУслуг.НДС_Рег;
				дв.ВалютнаяСуммаКт                 = СтрокаУслуг.НДС;
				дв.Содержание                      = "НДС " + НРег(строкаУслуг.СпособУчетаНДС);
				
				// при ведении раздельного учета на 19 счете по способам учета НДС
				// добавляем проводку на затраты (при указании соответствующего способа) 
				Если РаздельныйУчетНДСНаСчете19 и строкаУслуг.СпособУчетаНДС = Перечисления.СпособыУчетаНДС.УчитываетсяВCтоимости Тогда
					
					дв = Источник.Движения.Хозрасчетный.Добавить();
					дв.Период                          = Источник.Дата;
					дв.Организация                     = Источник.Организация;
					
					дв.СчетДт                          = сч20;
					
					БухгалтерскийУчет.УстановитьСубконто(дв.СчетДт, дв.СубконтоДт, "НоменклатурныеГруппы"	, строкаУслуг.Номенклатура.НоменклатурнаяГруппа);
					БухгалтерскийУчет.УстановитьСубконто(дв.СчетДт, дв.СубконтоДт, "СтатьиЗатрат"			, строкаУслуг.СтатьяЗатрат);
					БухгалтерскийУчет.УстановитьСубконто(дв.СчетДт, дв.СубконтоДт, "Продукция"				, строкаУслуг.Номенклатура);

					//Для версии КОРП
					Если ВестиУчетПоПодразделениям Тогда
						Если дв.СчетДт.УчетПоПодразделениям Тогда
