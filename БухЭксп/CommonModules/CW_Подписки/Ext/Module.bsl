				Движение.Период = НачалоДня(НачалоДня(ДатаНачалаВеденияУчета) - 1);
				Движение.Регистратор = Источник.Ссылка;
				Движение.Организация = Источник.Организация;
				
				//Для версии КОРП
				Если ВестиУчетПоПодразделениям Тогда
					Если Движение.СчетКт.УчетПоПодразделениям Тогда
						Движение.ПодразделениеКт = Источник.ПодразделениеОрганизации;
					КонецЕсли;
				КонецЕсли;
				//Для версии КОРП
				
				
				Движение.СубконтоКт[Субконто.Контрагенты] = Источник.Контрагент;
				Движение.СубконтоКт[Субконто.Договоры] = Источник.ДоговорКонтрагента;
				
				Движение.СчетДт = Счета.Вспомогательный;
				Движение.Содержание = "Ввод остатков";
				Движение.Сумма = Стр.Всего*КурсВводаОстатков;
				
			КонецЕсли; 	
			
		КонецЦикла; 
		
		//СформироватьДвиженияДляДоходов(ВедущийДокумент,Отказ,,УслугиВедущего);
		СформироватьДвиженияДляДоходов(ВедущийДокумент,Отказ);
		
	КонецЕсли; // ввод начальных остатков
	
	// проведение в стандартном режиме
	Если (НЕ РежимВводначальныхОстатков) Тогда
		
		// теперь дорабатываем движения ведомого документа...
		ДвиженияВедомого = Источник.Движения.Хозрасчетный;
		ДвиженияВедомого.Записывать = Истина;
		МассивУдаления = Новый Массив;
		
		СчетРасчетовПоВозмещаемым_Рубли = CW_Настройки.ПараметрУчетнойПолитики(Источник.Дата,Источник.Организация,"СчетРасчетов_Клиенты_Рубли");
		СчетРасчетовПоВозмещаемым_Валюта = CW_Настройки.ПараметрУчетнойПолитики(Источник.Дата,Источник.Организация,"СчетРасчетов_Клиенты_Валюта");
		СчетРасчетовПоВозмещаемым_УЕ = CW_Настройки.ПараметрУчетнойПолитики(Источник.Дата,Источник.Организация,"СчетРасчетов_Клиенты_УЕ");
		
		СуммаДляРасчетаРубИзУЕ = 0;
		СуммаВУЕ = 0;
		СуммаРуб = 0;
		СуммаНДС = 0;
		
		ЗакрытиеГрузоперевозки = (ТипЗнч(ВедущийДокумент) = Тип("ДокументСсылка.CW_ЗакрытиеГрузоперевозки"));

		// при определении признака расчетов в у.е. на случай ошибки в учетном договоре дополнительно контролируем валюту
		РасчетыУЕ = Источник.ДоговорКонтрагента.РасчетыВУсловныхЕдиницах и (Источник.ДоговорКонтрагента.ВалютаВзаиморасчетов <> ВРУ); 
		
		
		
		РасчетыВалюта = ((Источник.ДоговорКонтрагента.ВалютаВзаиморасчетов <> ВРУ) И НЕ РасчетыУЕ);
		
		// счета
		х76_5 = Счета.РасчетыСПрочимиПоставщикамиИПодрядчиками;
		х76_25 = Счета.РасчетыСПрочимиПоставщикамиИПодрядчикамиВал;
		х76_35 = Счета.РасчетыСПрочимиПоставщикамиИПодрядчикамиУЕ;
		х76_6 = Счета.РасчетыСПрочимиПокупателямиИЗаказчиками;
		х76_26 = Счета.РасчетыСПрочимиПокупателямиИЗаказчикамиВал;
		х76_36 = Счета.РасчетыСПрочимиПокупателямиИЗаказчикамиУЕ;
		х62_1 = Счета.РасчетыСПокупателями;
		х62_2 = Счета.РасчетыПоАвансамПолученным;
		х62_21 = Счета.РасчетыСПокупателямиВал;
		х62_22 = Счета.РасчетыПоАвансамПолученнымВал;
		х62_31 = Счета.РасчетыСПокупателямиУЕ;
		х62_32 = Счета.РасчетыПоАвансамПолученнымУЕ;
		х90_1_1 = Счета.ВыручкаНеЕНВД;
		х90_1_2 = Счета.ВыручкаЕНВД;
		х90_2_1 = Счета.СебестоимостьПродажНеЕНВД;
		х90_2_2 = Счета.СебестоимостьПродажЕНВД;
		х90_3 = Счета.Продажи_НДС;
		х68_2 = Счета.НДС;
		
		х91_1 = Счета.ПрочиеДоходы;
		
		// счета взаиморасчетов для УСН 
		хУСН_1 = Счета.УСНРасчетыСПокупателямиЕНВД;
		хУСН_21 = Счета.УСНРасчетыСПокупателямиВалЕНВД;
		хУСН_2 = Счета.УСНРасчетыСПокупателямиКомитент;
		хУСН_22 = Счета.УСНРасчетыСПокупателямиВалКомитент;
		
		кэшСуммНДС = Новый ТаблицаЗначений;;
		кэшСуммНДС.Колонки.Добавить("СубконтоДт1");
		кэшСуммНДС.Колонки.Добавить("СубконтоДт2");
		кэшСуммНДС.Колонки.Добавить("Сумма");
		
		
		// получаем настройки учета оперативной дебеторской задолженности    
		
		ВидЗадолженности = Перечисления.CW_ВидыОперативнойЗадолженности;
		
		СтруктураНастроек = CW_Настройки.ПолучитьНастройкиОперативногоУчета(Источник.Организация, ВидЗадолженности.Дебиторская, Источник.Дата);
  		ИспользуетсяОперативнаяЗадолженность = СтруктураНастроек["ВедетсяОперативныйУчет"];

		НастройкиОперативногоУчета = СтруктураНастроек["НастройкиОперативногоУчета"];
		РаздельныйУчет = НастройкиОперативногоУчета["РаздельныйУчет"];  
		
		// корректировку движений УСН выполняем только в случае совместного ведения учета задолженности в БУ и оперативном учете
		Если ДействуетУСН и ИспользуетсяОперативнаяЗадолженность и Не РаздельныйУчет Тогда 
			ТребуетсяКорректировкаДвиженийУСН = Истина; 
		КонецЕсли; 

		// подготовительный этап
		// доработка движений
		// для валюты и УЕ удаляем большую часть (будут формироваться самостоятельно)
		Для каждого Движение Из ДвиженияВедомого Цикл
			
			Если (Движение.СчетДт = х76_25 ИЛИ Движение.СчетДт = х76_35) Тогда
				Движение.СчетДт = х76_5;
				Движение.ВалютаДт = Неопределено;
				Движение.ВалютнаяСуммаДт = 0;
			КонецЕсли; 
			
			Если (Движение.СчетДт = х76_26 ИЛИ Движение.СчетДт = х76_36) Тогда
				Движение.СчетДт = х76_6;
				Движение.ВалютаДт = Неопределено;
				Движение.ВалютнаяСуммаДт = 0;
			КонецЕсли; 
			
			Если (Движение.СчетКт = х76_25 ИЛИ Движение.СчетКт = х76_35) Тогда
				Движение.СчетКт = х76_5;
				Движение.ВалютаКт = Неопределено;
				Движение.ВалютнаяСуммаКт = 0;
			КонецЕсли; 
			
			Если (Движение.СчетКт = х76_26 ИЛИ Движение.СчетКт = х76_36) Тогда
				
				Движение.СчетКт = х76_6;
				Движение.ВалютаКт = Неопределено;
				Движение.ВалютнаяСуммаКт = 0;
				
			КонецЕсли; 
			
			Если ТипЗнч(ВедущийДокумент) = Тип("ДокументСсылка.CW_ЗакрытиеГрузоперевозки") и Движение.СчетКт = х90_1_1 Тогда
				Движение.СчетДт = х76_6;
				Движение.ВалютаДт = Неопределено;
				Движение.ВалютнаяСуммаДт = 0;
			КонецЕсли;
			
			// удаляем движения где СчетДт = СчетКт
			Если Движение.СчетДт = Движение.СчетКт Тогда
				МассивУдаления.Добавить(Движение);
			КонецЕсли;
			
			// удаляем движения по УСН.*   
			Если ТребуетсяКорректировкаДвиженийУСН Тогда
				Если (Движение.СчетДт.Родитель = Счета.УСНВспомогательныеСчета ИЛИ Движение.СчетКт.Родитель = Счета.УСНВспомогательныеСчета) Тогда
					Если ИспользуетсяОперативнаяЗадолженность и НЕ РаздельныйУчет Тогда	
						МассивУдаления.Добавить(Движение);                                   
					КонецЕсли;     
				КонецЕсли;                                  
			КонецЕсли;
			
			// очищаем 3-ю аналитику на 76.5 и 76.6
			Если Движение.СчетКт = х76_5 ИЛИ Движение.СчетКт = х76_6 Тогда
				
				Движение.СубконтоКт[Субконто.Контрагенты] = ВедущийДокумент.Контрагент;
				// --- 
				
				СтруктураПараметров = Новый Структура;
				СтруктураПараметров.Вставить("Договор", 			ВедущийДокумент.Договор);
				СтруктураПараметров.Вставить("ПриложениеКДоговору",	ВедущийДокумент.ПриложениеКДоговору);
				
				Движение.СубконтоКт[Субконто.Договоры] = CW_Финансы.ПолучитьУчетныйДоговор(СтруктураПараметров);
				
				// --- 
				Движение.СубконтоКт[Субконто.ДокументыРасчетовСКонтрагентами]=Неопределено;
				
			КонецЕсли; 
			
			// очищаем 3-ю аналитику на 76.6 для закрытия...
			Если (ЗакрытиеГрузоперевозки) Тогда
				
				Если Движение.СчетДт = х76_6 Тогда
					Движение.СубконтоДт[Субконто.ДокументыРасчетовСКонтрагентами]=Неопределено;
					
					СтруктураПараметров = Новый Структура;
					СтруктураПараметров.Вставить("Договор", 			ВедущийДокумент.Договор);
					СтруктураПараметров.Вставить("ПриложениеКДоговору",	ВедущийДокумент.ПриложениеКДоговору);
					
					Движение.СубконтоДт[Субконто.Договоры] = CW_Финансы.ПолучитьУчетныйДоговор(СтруктураПараметров); 
					
					//AFR-260168
					Если СвояОрганизацияВКачествеПокупателя Тогда
						Движение.СубконтоДт[Субконто.Контрагенты] = ВедущийДокумент.Контрагент; 
					КонецЕсли; 
					//---AFR-260168
				КонецЕсли;
				
			КонецЕсли;	
			
			// меняем счет расчетов по возмещаемым статьям 
			// Если (СчетКт=76.5 ИЛИ СчетКт=76.6) И (СчетДт=62.01 ИЛИ СчетДт=62.21) тогда
			// по рублям и валюте соответственно
			Если (Движение.СчетДт = х62_1 И (Движение.СчетКт = х76_5 ИЛИ Движение.СчетКт = х76_6)) Тогда
				
				Движение.СчетДт = СчетРасчетовПоВозмещаемым_Рубли;
				
			КонецЕсли; 
			
			// удаление движений по валюте
			Если (РасчетыВалюта ИЛИ РасчетыУЕ) Тогда
				
				// реализация (Дт 62.31 или счёт по возмещаемым) И (Кт 90.01.1 или 90.01.2)
				// и отражение перевыставления
				Если ((Движение.СчетДт = х62_31 ИЛИ Движение.СчетДт = СчетРасчетовПоВозмещаемым_УЕ)
					ИЛИ (Движение.СчетДт = х62_21 ИЛИ Движение.СчетДт = СчетРасчетовПоВозмещаемым_Валюта))
					И (Движение.СчетКт = х90_1_1 ИЛИ Движение.СчетКт = х90_1_2 ИЛИ Движение.СчетКт = х91_1
					ИЛИ Движение.СчетКт=х76_5 ИЛИ Движение.СчетКт=х76_6) Тогда
					
					МассивУдаления.Добавить(Движение);
					
				КонецЕсли;
				
				// зачет аванса
				Если ((Движение.СчетДт = х62_32 И Движение.СчетКт = х62_31)
					ИЛИ (Движение.СчетДт = х62_22 И Движение.СчетКт = х62_21)) Тогда
					
					МассивУдаления.Добавить(Движение);
					
				КонецЕсли; 
				
				// проводка по НДС (???)
				Если Движение.СчетКт = х90_2_1 ИЛИ Движение.СчетКт = х90_2_2 Тогда
					
					МассивУдаления.Добавить(Движение);
					
				КонецЕсли; 
				
				// проводка по НДС
				Если Движение.СчетДт = х90_3 и НЕ ЗакрытиеГрузоперевозки Тогда
					
					МассивУдаления.Добавить(Движение);
					
					СтрокаСуммНДС = кэшСуммНДС.Добавить();
					СтрокаСуммНДС.СубконтоДт1 	= Движение.СубконтоДт[Субконто.НоменклатурныеГруппы];
					СтрокаСуммНДС.СубконтоДт2 	= Движение.СубконтоДт[Субконто.СтавкиНДС];
					СтрокаСуммНДС.Сумма 		= Движение.Сумма;
					
				КонецЕсли; 
				
			КонецЕсли; 
			
		КонецЦикла;
		Для каждого Стр Из МассивУдаления Цикл
			ДвиженияВедомого.Удалить(Стр);
		КонецЦикла;    
		
		// проводки по НДС налогового агента в случае перевыставления затрат
		ДополнитьДвиженияПоНДСНалоговогоАгента(Источник, ДвиженияВедомого, ВедущийДокумент);
		
		// устанавливаем код вида операции в движениях по НДС продажи для смешанных с\ф
		Если (ВедущийДокумент.ФормируетсяСчетФактура И НЕ ЗакрытиеГрузоперевозки) Тогда
			
			ЕстьСобственные = Ложь;
			ЕстьПеревыставление = Ложь;
			
			Для каждого Стр Из ВедущийДокумент.Услуги Цикл
				Если (Стр.ПорядокОтражения = Перечисления.CW_ПорядокОтраженияДоходов.СобственнаяУслуга) 
					ИЛИ (Стр.ПорядокОтражения = Перечисления.CW_ПорядокОтраженияДоходов.ПрочиеДоходы) Тогда
					ЕстьСобственные = Истина;
				Иначе
					ЕстьПеревыставление = Истина;
				КонецЕсли; 
			КонецЦикла; 
			
			Если (ЕстьСобственные И ЕстьПеревыставление) Тогда
				ДвиженияНДСПродажа = Источник.Движения.НДСЗаписиКнигиПродаж;
				Для каждого Движение Из ДвиженияНДСПродажа Цикл
					Движение.КодВидаОперации = "15";
				КонецЦикла; 
			КонецЕсли; 
			
		КонецЕсли; // смешанные с\ф
		
		// удаляем движения по регистру "реализованные услуги принципалов"...
		Источник.Движения.РеализованныеТоварыКомитентов.Очистить();
		
		// определяем вид расчетов и счета
		ОтдельныйСчетПоПеревыставляемым = Ложь;
		
		// счета расчетов для базовой валюты "Руб."
		Если Источник.ВалютаДокумента = ВРУ Тогда
			
			ВалютныйДокумент = Ложь;
			СчетПоСобственным = х62_1;
			СчетАвансовПоСобственным = х62_2;
			СчетПоПеревыставляемым = СчетРасчетовПоВозмещаемым_Рубли;
			ОтдельныйСчетПоПеревыставляемым = (СчетРасчетовПоВозмещаемым_Рубли <> СчетПоСобственным); 
			
			// счета расчетов для базовой валюты отличной от "Руб."
		Иначе
			
			ВалютныйДокумент = Истина;
			
			// валюта
			Если НЕ РасчетыУЕ Тогда
				СчетПоСобственным = х62_21;
				СчетАвансовПоСобственным = х62_22;
				СчетПоПеревыставляемым = СчетРасчетовПоВозмещаемым_Валюта;
				ОтдельныйСчетПоПеревыставляемым = (СчетРасчетовПоВозмещаемым_Валюта <> СчетПоСобственным); 
				
				// у.е.
			Иначе
				СчетПоСобственным = х62_31;
				СчетАвансовПоСобственным = х62_32;
				СчетПоПеревыставляемым = СчетРасчетовПоВозмещаемым_УЕ;
				ОтдельныйСчетПоПеревыставляемым = (СчетРасчетовПоВозмещаемым_УЕ <> СчетПоСобственным); 
			КонецЕсли; 
		КонецЕсли; 
		РублевыйДокумент = (НЕ ВалютныйДокумент);
		
		// определяем курс на дату документа
		Если ЗакрытиеГрузоперевозки Тогда
			СтруктураКурсаДокумента = CW_Финансы.ПолучитьКурсВалюты(Источник.ВалютаДокумента,Источник.Дата);
		Иначе
			Если ВедущийДокумент.УЕ_ПользовательскийКурс Тогда
				СтруктураКурсаДокумента = Новый Структура("Курс,Кратность",ВедущийДокумент.УЕ_Курс,ВедущийДокумент.УЕ_Кратность);
			Иначе
				СтруктураКурсаДокумента = CW_Финансы.ПолучитьКурсВалюты(Источник.ВалютаДокумента,Источник.Дата);
			КонецЕсли;	
		КонецЕсли;
		
		//Получаем остатки по перевыставлению услуг
		Если ТипЗнч(ВедущийДокумент) = Тип("ДокументСсылка.CW_ЗакрытиеГрузоперевозки") Тогда
			мНоменклатура = ВедущийДокумент.Вознаграждение.ВыгрузитьКолонку("Номенклатура");
		Иначе
			мНоменклатура = ВедущийДокумент.Услуги.ВыгрузитьКолонку("Номенклатура");
		КонецЕсли;	
		
		СтруктураПеревыставления = ПолучитьОстаткиПеревыставления(ВедущийДокумент);
		// ТаблицаОстатка, ТаблицаПеревставления
		
		// формируем таблицу услуг по собственным и возмещаемым
		ТаблицаУслуг = _сф.т_Создать("Документ,Номенклатура,НоменклатурнаяГруппа,Собственная,Сумма,Сумма_БВ,СтавкаНДС,СуммаНДС,СуммаНДС_БВ,Всего,Всего_БВ,СуммаЗачета,СуммаЗачета_БВ,КоррСчет,СчетРасчетов,СчетАвансов,СчетРасходов,Субконто,Количество");
		
		ПустыеЗначенияСтроки = Новый Структура("Всего_БВ,Сумма_БВ,СуммаНДС_БВ,СуммаЗачета,СуммаЗачета_БВ",0,0,0,0,0);
		
		Для каждого Стр Из Источник.Услуги Цикл
			
			Нстр = ТаблицаУслуг.Добавить();
			
			ЗаполнитьЗначенияСвойств(Нстр,ПустыеЗначенияСтроки);
			ЗаполнитьЗначенияСвойств(Нстр,Стр);
			
			Нстр.Всего = Нстр.Сумма+Нстр.СуммаНДС;
			Нстр.Собственная = Истина;
			Нстр.НоменклатурнаяГруппа = Стр.Номенклатура.НоменклатурнаяГруппа;
			Нстр.КоррСчет = Стр.СчетДоходов;
			Нстр.СчетРасчетов = Источник.СчетУчетаРасчетовСКонтрагентом;
			Нстр.СчетАвансов = Источник.СчетУчетаРасчетовПоАвансам;
			
		КонецЦикла; 
		
		Для каждого Стр Из СтруктураПеревыставления.ТаблицаПеревставления Цикл
			
			Нстр = ТаблицаУслуг.Добавить();
			
			ЗаполнитьЗначенияСвойств(Нстр,ПустыеЗначенияСтроки);
			ЗаполнитьЗначенияСвойств(Нстр,Стр);
			
			Нстр.Всего 					= Нстр.Сумма+Нстр.СуммаНДС;
			Нстр.НоменклатурнаяГруппа 	= Стр.Номенклатура.НоменклатурнаяГруппа;
			Нстр.КоррСчет 				= Стр.СчетРасчетов;
			
			Если Стр.ПорядокОтражения = Перечисления.CW_ПорядокОтраженияДоходов.Перевыставление Тогда
				Нстр.КоррСчет = х76_5;
			Иначе	
				Нстр.КоррСчет = х76_6;
			КонецЕсли; 
			
			Если НЕ ОтдельныйСчетПоПеревыставляемым Тогда
				Нстр.СчетРасчетов = СчетПоСобственным;
				Нстр.СчетАвансов = СчетАвансовПоСобственным;
			Иначе
				Нстр.СчетРасчетов = СчетПоПеревыставляемым;
				Нстр.СчетАвансов = СчетПоПеревыставляемым;
			КонецЕсли; 
			
			//заполняем рублевые суммы по остаткам
			РассчитатьСуммуПоКурсу = Истина;
			Если  Стр.ПорядокОтражения = Перечисления.CW_ПорядокОтраженияДоходов.Перевыставление Тогда
				
				ОтборОстатка = Новый Структура;
				ОтборОстатка.Вставить("Грузоперевозка"		, Стр.Грузоперевозка);
				ОтборОстатка.Вставить("Номенклатура"		, Стр.Номенклатура);
				ОтборОстатка.Вставить("Контрагент"			, Стр.Контрагент);
				ОтборОстатка.Вставить("Договор"				, Стр.Договор);
				ОтборОстатка.Вставить("ПриложениеКДоговору"	, Стр.ПриложениеКДоговору);
				ОтборОстатка.Вставить("ДокументРасходов"	, Стр.ДокументРасходов);
				ОтборОстатка.Вставить("СтавкаНДС"			, Стр.СтавкаНДС);
				
				мСтрокиОстатка =  СтруктураПеревыставления.ТаблицаОстатка.НайтиСтроки(ОтборОстатка);
				
				// если удалось получить остатки и количество услуг совпало с количеством из остатков, 
				// то рублевые эквиваленты берем из остатков (при этом строка с остатками должна быть только одна!)
				Если мСтрокиОстатка.Количество() > 0  Тогда
					Если Стр.Количество = мСтрокиОстатка[0].Количество Тогда
						
						Нстр.Всего_БВ 		= мСтрокиОстатка[0].Всего_Рег;
						Нстр.Сумма_БВ 		= мСтрокиОстатка[0].Сумма_Рег;
						Нстр.СуммаНДС_БВ 	= мСтрокиОстатка[0].НДС_Рег;
						
						// количество услуг в документе не совпало с количеством по остаткам 
						РассчитатьСуммуПоКурсу = Ложь; 
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			
			Если РассчитатьСуммуПоКурсу Тогда
				
				СтавкаНДС		= CW_Финансы.ПолучитьСтавкуНДС(Стр.СтавкаНДС);
				Нстр.Всего_БВ   =  Окр(Стр.Всего * СтруктураКурсаДокумента.Курс/СтруктураКурсаДокумента.Кратность,2,1); 
				
				// определяем расчетную сумму НДС
				Если РасчетыУЕ Тогда
					СуммаНДС = Окр(Нстр.Всего_БВ * СтавкаНДС/(100 + СтавкаНДС),2,1);	
				Иначе
					СуммаНДС = Окр(Окр(Нстр.Сумма * СтруктураКурсаДокумента.Курс/СтруктураКурсаДокумента.Кратность,2,1) * СтавкаНДС/100,2,1);
				КонецЕсли;
				
				// пишем в строку реализации и уменьшаем сумму учтенного НДС
				Нстр.СуммаНДС_БВ 	= СуммаНДС;
				Нстр.Сумма_БВ 		= Нстр.Всего_БВ - СуммаНДС;
				
			КонецЕсли;
			
			Нстр.Собственная = Ложь;
			
		КонецЦикла; 
		
		ТаблицаУслуг.ЗаполнитьЗначения(Источник.Ссылка,"Документ");
		
		// теперь обрабатываем таблицу авансов
		// формируем рублёвую составляющую на дату документа аванса
		Если (НЕ ЗакрытиеГрузоперевозки) Тогда
			
			ТаблицаАвансов = ВедущийДокумент.ЗачетАвансов.Выгрузить();
			ТаблицаАвансов.Колонки.Добавить("СуммаЗачета_БВ");
			ТаблицаАвансов.ЗаполнитьЗначения(0,"СуммаЗачета_БВ");
			
			Для каждого Стр Из ТаблицаАвансов Цикл
				Если (ВалютныйДокумент) Тогда
					
					// получаем курс остатка аванса, как в БП (!!!)
					ОстатокАванса = ОпределитьОстатокАванса(Стр.СчетАванса,Источник.Контрагент,Источник.ДоговорКонтрагента,Стр.ДокументАванса,Источник.ВалютаДокумента, Источник);
					Стр.СуммаЗачета_БВ = Окр(_сф.БезопасноРазделить(Стр.СуммаЗачета*ОстатокАванса.РублеваяСумма,ОстатокАванса.ВалютнаяСумма),2,1);
					
				Иначе
					Стр.СуммаЗачета_БВ = Стр.СуммаЗачета;
				КонецЕсли; 
			КонецЦикла; 
		КонецЕсли; 
		
		// теперь формируем движения
		// сначала зачеты авансов, далее с учётом рублевых сумм по зачету - движения реализации и перевыставления по ставкам
		ТаблицаРеализации= ТаблицаУслуг.Скопировать();
		//ТаблицаРеализации.Свернуть("Документ,КоррСчет,Номенклатура,НоменклатурнаяГруппа,СтавкаНДС,Собственная,СчетАвансов","Всего,Всего_БВ,Сумма,Сумма_БВ,СуммаНДС,СуммаНДС_БВ,СуммаЗачета,СуммаЗачета_БВ");
		
		// зачет аванса и формирование движений по УЕ и валюте
		Если (НЕ ЗакрытиеГрузоперевозки) Тогда
			
			Если (ВалютныйДокумент) Тогда
				
				// распределяем авансы по таблице реализации
				Для каждого Стр Из ТаблицаАвансов Цикл
					
					Отбор = _сф.ст_Отбор("СчетАвансов",Стр.СчетАванса);
					
					// распределяем аванс по найденным строкам
					СтрокиРеализации = ТаблицаРеализации.НайтиСтроки(Отбор);
					КоличествоСтрок = СтрокиРеализации.Количество();
					Если КоличествоСтрок <> 0 Тогда
						
						СуммаЗадолженности = ТаблицаРеализации.Скопировать(Отбор).Итог("Всего");
						ОстатокРаспределения = Стр.СуммаЗачета;
						ОстатокРаспределения_БВ = Стр.СуммаЗачета_БВ;
						
						Индекс = 0;
						Для каждого СтрР Из СтрокиРеализации Цикл
							
							_сф.Инкремент(Индекс);
							СуммаЗачетаПоСтроке = Окр(Стр.СуммаЗачета*СтрР.Всего/СуммаЗадолженности,2,1);
							СуммаЗачетаПоСтроке_БВ = Окр(Стр.СуммаЗачета_БВ*СтрР.Всего/СуммаЗадолженности,2,1);
							// ---
							
							_сф.Инкремент(СтрР.СуммаЗачета,СуммаЗачетаПоСтроке);
							_сф.Инкремент(СтрР.СуммаЗачета_БВ,СуммаЗачетаПоСтроке_БВ);
							// --- 
							_сф.Декремент(ОстатокРаспределения,СуммаЗачетаПоСтроке);
							_сф.Декремент(ОстатокРаспределения_БВ,СуммаЗачетаПоСтроке_БВ);
							
							Если Индекс = КоличествоСтрок Тогда
								
								_сф.Инкремент(СтрР.СуммаЗачета,ОстатокРаспределения);
								_сф.Инкремент(СтрР.СуммаЗачета_БВ,ОстатокРаспределения_БВ);
								
							КонецЕсли; 
							
						КонецЦикла; 
						
						// формируем проводку зачета
						Движение = Источник.Движения.Хозрасчетный.Добавить();
						Движение.Период = Источник.Дата;
						Движение.Организация = Источник.Организация;
						
						Движение.СчетДт = Стр.СчетАванса;
						Движение.СубконтоДт[Субконто.Контрагенты] = Источник.Контрагент;
						Движение.СубконтоДт[Субконто.Договоры] = Источник.ДоговорКонтрагента;
						Движение.СубконтоДт[Субконто.ДокументыРасчетовСКонтрагентами] = Стр.ДокументАванса;
						Движение.ВалютаДт = Источник.ВалютаДокумента;
						Движение.ВалютнаяСуммаДт = Стр.СуммаЗачета;
						
						//Для версии КОРП
						Если ВестиУчетПоПодразделениям Тогда
							Если Движение.СчетДт.УчетПоПодразделениям Тогда
								Движение.ПодразделениеДт = Источник.ПодразделениеОрганизации;
							КонецЕсли;
						КонецЕсли;
						//Для версии КОРП
						
						Если (РасчетыУЕ) Тогда
							Движение.СчетКт = ?(Стр.СчетАванса = х62_32,х62_31,СчетРасчетовПоВозмещаемым_УЕ);
						Иначе
							Движение.СчетКт = ?(Стр.СчетАванса = х62_22,х62_21,СчетРасчетовПоВозмещаемым_Валюта);
						КонецЕсли; 
						
						//Для версии КОРП
						Если ВестиУчетПоПодразделениям Тогда
							Если Движение.СчетКт.УчетПоПодразделениям Тогда
								Движение.ПодразделениеКт = Источник.ПодразделениеОрганизации;
							КонецЕсли;
						КонецЕсли;
						//Для версии КОРП
						
						Движение.СубконтоКт[Субконто.Контрагенты] = Источник.Контрагент;
						Движение.СубконтоКт[Субконто.Договоры] = Источник.ДоговорКонтрагента;
						Движение.СубконтоКт[Субконто.ДокументыРасчетовСКонтрагентами] = Источник.Ссылка;
						Движение.ВалютаКт = Источник.ВалютаДокумента;
						Движение.ВалютнаяСуммаКт = Стр.СуммаЗачета;
						// --- 
						Движение.Сумма = Стр.СуммаЗачета_БВ;
						Движение.Содержание = "Зачет аванса покупателя";
						
					КонецЕсли; 
				КонецЦикла; // обход документов предоплаты 
				
				
				#Область Расчет_смешанного_курса
				
				// Расчет смешанного курса на случай частичной предоплаты
				ВсегоВал 		= ТаблицаРеализации.Итог("Всего");
				СуммаЗачетаВал 	= ТаблицаРеализации.Итог("СуммаЗачета");
				СуммаЗачетаРуб 	= ТаблицаРеализации.Итог("СуммаЗачета_БВ");
				
				Если ВсегоВал > СуммаЗачетаВал Тогда
					СмешанныйКурс = _сф.БезопасноРазделить((ВсегоВал - СуммаЗачетаВал) * СтруктураКурсаДокумента.Курс/СтруктураКурсаДокумента.Кратность+ СуммаЗачетаРуб , ВсегоВал);
				ИначеЕсли ВсегоВал = СуммаЗачетаВал Тогда
					СмешанныйКурс = _сф.БезопасноРазделить(СуммаЗачетаРуб , СуммаЗачетаВал);
				Иначе
					СмешанныйКурс = СтруктураКурсаДокумента.Курс/СтруктураКурсаДокумента.Кратность;
				КонецЕсли;
				
				#КонецОбласти   
				
				#Область Расчет_рублевых_сумм
				Если РасчетРублевогоЭквивалентаПропорциональноПоСуммеИтога Тогда
					
					ВсегоПоТаблице 		=  ТаблицаРеализации.Итог("Всего");
					Если ВсегоВал > СуммаЗачетаВал Тогда
						ВсегоРаспределяемаяСумма = Окр(ВсегоПоТаблице * СмешанныйКурс, 2,1);	
					Иначе
						ВсегоРаспределяемаяСумма = Окр((ВсегоПоТаблице-СуммаЗачетаВал)*СтруктураКурсаДокумента.Курс/СтруктураКурсаДокумента.Кратность,2,1)+СуммаЗачетаРуб;
					КонецЕсли;
					
					ОбщегоНазначенияБПВызовСервера.РаспределитьСуммуПоКолонкеТаблицы(ВсегоРаспределяемаяСумма, ТаблицаРеализации, "Всего_БВ", "Всего");
					
				Иначе
					
					Для каждого Стр Из ТаблицаРеализации Цикл
						// сумма реализации в базовой валюте
						Если ВсегоВал > СуммаЗачетаВал Тогда
							Стр.Всего_БВ = Окр(Стр.Всего * СмешанныйКурс, 2,1);	
						Иначе
							Стр.Всего_БВ = Окр((Стр.Всего-Стр.СуммаЗачета)*СтруктураКурсаДокумента.Курс/СтруктураКурсаДокумента.Кратность,2,1)+Стр.СуммаЗачета_БВ;
						КонецЕсли;
					КонецЦикла;
					
				КонецЕсли;
				
				#КонецОбласти
				
				
				#Область Расчет_сумм_НДС_для_перевыставления_по_ставкам
				
				// считаем рублёвую сумму реализации (собственных услуг) по таблице расчетов
				// как остаток задолженности по курсу документа плюс рублёвая сумма зачтённых авансов
				мСтрокиРеализацииПеревыставляемыеПоСтавкам = ТаблицаРеализации.НайтиСтроки(новый Структура("КоррСчет",х76_6));
				
				Для каждого Стр Из мСтрокиРеализацииПеревыставляемыеПоСтавкам Цикл
					
					// определяем сумму НДС в рублях
					СтавкаНДС = CW_Финансы.ПолучитьСтавкуНДС(Стр.СтавкаНДС);
					
					// для у.е. НДС с учетом курса полученных предоплат
					Если РасчетыУЕ Тогда
						ТмпНДС = Окр(Стр.Всего_БВ * СтавкаНДС/(100 + СтавкаНДС),2,1);	
						
						// для валюты по курсу на дату документа
					Иначе
						ТмпНДС	= Окр(Окр(Стр.Сумма * СтруктураКурсаДокумента.Курс/СтруктураКурсаДокумента.Кратность,2,1) * СтавкаНДС/100,2,1);
					КонецЕсли;
					Стр.СуммаНДС_БВ = ТмпНДС;	
					
					// рублевая сумма без НДС
					Стр.Сумма_БВ = Стр.Всего_БВ - Стр.СуммаНДС_БВ;	
				КонецЦикла;
				
				#КонецОбласти   
				
				#Область Расчет_сумм_НДС_для_Собственным
				
				Для Каждого СтрТабРеал из ТаблицаРеализации Цикл
					Если СтрТабРеал.КоррСчет = х91_1 Тогда
						СтрТабРеал.НоменклатурнаяГруппа = Справочники.НоменклатурныеГруппы.ПустаяСсылка();
					КонецЕсли;
				КонецЦикла;
				
				// Расчитываем рублевую сумму НДС для таблицы реализации только по собственным услугам.
				// Сумму НДС в рублях берем из кэшевой таблицы проводок по НДС (сформированной алгоритмом типовой БП).
				// При расчете налогооблагаемой базы учитываем различие:
				// - если документ в валюте (не у.е.), то налогооблагаемая база считается как СуммаВалБезНДС * КурсНаДатуДокумента
				// - если документ в у.е., то налогооблагаемая база считается как ВсегоРуб * СтавкаНДС / (100 + СтавкаНДС)  
				// Математическую погрешность расчета (округления по строкам документа) относим на последнюю строку
				Для Каждого  СтрокаКэш из кэшСуммНДС Цикл
					
					Отбор = Новый Структура("НоменклатурнаяГруппа,СтавкаНДС,Собственная",СтрокаКэш.СубконтоДт1,СтрокаКэш.СубконтоДт2,Истина);
					мСтроки = ТаблицаРеализации.НайтиСтроки(Отбор);
					
					Для ИндексСтроки = 0 по  мСтроки.Количество()-1 Цикл
						
						СтрокаРеализации 	= мСтроки[ИндексСтроки];
						СтавкаНДС		 	= CW_Финансы.ПолучитьСтавкуНДС(СтрокаРеализации.СтавкаНДС);
						
						
						// определяем расчетную сумму НДС
						Если РасчетыУЕ Тогда
							ТмпНДС = Окр(СтрокаРеализации.Всего_БВ * СтавкаНДС/(100 + СтавкаНДС),2,1);	
						Иначе
							ТмпНДС	= Окр(Окр(СтрокаРеализации.Сумма * СтруктураКурсаДокумента.Курс/СтруктураКурсаДокумента.Кратность,2,1) * СтавкаНДС/100,2,1);
						КонецЕсли;
						
						// если строка последняя, то в качестве НДС пишем остаток НДС из строки кэшевой таблицы проводок НДС
						Если  ИндексСтроки = мСтроки.Количество()-1 Тогда
							СуммаНДС = СтрокаКэш.Сумма;
						Иначе
							СуммаНДС = ТмпНДС;
						КонецЕсли;
						
						// пишем в строку реализации и уменьшаем сумму учтенного НДС
						СтрокаРеализации.СуммаНДС_БВ 	= СуммаНДС;
						СтрокаРеализации.Сумма_БВ 		= СтрокаРеализации.Всего_БВ - СтрокаРеализации.СуммаНДС_БВ;
						СтрокаКэш.Сумма					= СтрокаКэш.Сумма - СуммаНДС;
					КонецЦикла;
				КонецЦикла;
				
				// проверим, что вся сумму НДС по кэшевой таблице проводок по НДС
				// была распределена на таблицу реализации
				Если кэшСуммНДС.Итог("Сумма") <> 0 Тогда
					СообщениеПользователю = Новый СообщениеПользователю;	
					СообщениеПользователю.Текст = "Ошибка распределения рублевой суммы НДС. Обратитесь к разработчику!";
					СообщениеПользователю.Сообщить();
					Отказ = Истина;
				КонецЕсли;    
				
				#КонецОбласти
				
				// формируем проводки по ТаблицеРеализации
				ТаблицаРеализацииДляПроводок = ТаблицаРеализации.Скопировать();
				ТаблицаРеализацииДляПроводок.Свернуть("Документ,КоррСчет,Номенклатура,НоменклатурнаяГруппа,СтавкаНДС,Собственная,СчетАвансов,Субконто","Всего,Всего_БВ,Сумма,Сумма_БВ,СуммаНДС,СуммаНДС_БВ,СуммаЗачета,СуммаЗачета_БВ,Количество");
				Для каждого Стр Из ТаблицаРеализацииДляПроводок Цикл
					
					ТребуетсяОтразитьНДС = Стр.СуммаНДС_БВ <> 0;
					
					// проводка реализации
					// ---------------------------------------------------------------------------- 
					Движение = Источник.Движения.Хозрасчетный.Добавить();
					Движение.Период = Источник.Дата;
					Движение.Организация = Источник.Организация;
					
					Если (РасчетыУЕ) Тогда
						Движение.СчетДт = ?(Стр.СчетАвансов = х62_32,х62_31,СчетРасчетовПоВозмещаемым_УЕ);
					Иначе
						Движение.СчетДт = ?(Стр.СчетАвансов = х62_22,х62_21,СчетРасчетовПоВозмещаемым_Валюта);
					КонецЕсли; 
					
					//Для версии КОРП
					Если ВестиУчетПоПодразделениям Тогда
						Если Движение.СчетДт.УчетПоПодразделениям Тогда
							Движение.ПодразделениеДт = Источник.ПодразделениеОрганизации;
						КонецЕсли;
					КонецЕсли;
					//Для версии КОРП
					
					
					Движение.СубконтоДт[Субконто.Контрагенты] = Источник.Контрагент;
					Движение.СубконтоДт[Субконто.Договоры] = Источник.ДоговорКонтрагента;
					Движение.СубконтоДт[Субконто.ДокументыРасчетовСКонтрагентами] = Источник.Ссылка;
					Движение.ВалютаДт = Источник.ВалютаДокумента;
					Движение.ВалютнаяСуммаДт = Стр.Всего;
					// --- 
					Движение.СчетКт = Стр.КоррСчет;
					Если Стр.КоррСчет = х90_1_1 Тогда
						
						Движение.СубконтоКт[Субконто.НоменклатурныеГруппы]=Стр.НоменклатурнаяГруппа;
						Движение.СубконтоКт[Субконто.СтавкиНДС]=Стр.СтавкаНДС;
						Движение.СубконтоКт[Субконто.Номенклатура]=Стр.Номенклатура;  
						
						Движение.КоличествоКт = Стр.Количество;
						
						Движение.СуммаНУДт = Стр.Всего_БВ;
						Движение.СуммаНУКт = Стр.Всего_БВ - Стр.СуммаНДС_БВ;
						
					ИначеЕсли Стр.КоррСчет = х91_1 Тогда 
						
						Движение.СубконтоКт[Субконто.ПрочиеДоходыИРасходы] = Стр.Субконто;
						Движение.СубконтоКт[Субконто.РеализуемыеАктивы] = Стр.Номенклатура;
						
						Движение.СуммаНУДт = Стр.Всего_БВ;
						Движение.СуммаНУКт = Стр.Всего_БВ - Стр.СуммаНДС_БВ;
						
					ИначеЕсли Стр.КоррСчет = х90_1_2 Тогда 
						
						Движение.СубконтоКт[Субконто.НоменклатурныеГруппы]=Стр.НоменклатурнаяГруппа;
						Движение.СубконтоКт[Субконто.Номенклатура]=Стр.Номенклатура;
						
						Движение.СуммаНУДт = Стр.Всего_БВ;
						Движение.СуммаНУКт = Стр.Всего_БВ - Стр.СуммаНДС_БВ;
						
					ИначеЕсли Стр.КоррСчет = х76_5 ИЛИ Стр.КоррСчет = х76_6 Тогда 
						
						Движение.СубконтоКт[Субконто.Контрагенты] = Источник.Контрагент;
						Движение.СубконтоКт[Субконто.Договоры] = Источник.ДоговорКонтрагента;
						
						Движение.СуммаНУДт = Стр.Всего_БВ;
						Движение.СуммаНУКт = Стр.Всего_БВ;
						
						ТребуетсяОтразитьНДС = Ложь;
						
					КонецЕсли; 
					
					//Для версии КОРП
					Если ВестиУчетПоПодразделениям Тогда
						Если Движение.СчетКт.УчетПоПодразделениям Тогда
							Движение.ПодразделениеКт = Источник.ПодразделениеОрганизации;
						КонецЕсли;
					КонецЕсли;
					//Для версии КОРП
					
					Движение.Сумма = Стр.Всего_БВ;
					
					Движение.Содержание = "Реализация услуг";
					
					// отражаем НДС по реализации
					// ---------------------------------------------------------------------------- 
					Если (ТребуетсяОтразитьНДС) Тогда
						
						Движение = Источник.Движения.Хозрасчетный.Добавить();
						Движение.Период = Источник.Дата;
						Движение.Организация = Источник.Организация;
						
						Движение.СчетДт = х90_3;
						Движение.СубконтоДт[Субконто.НоменклатурныеГруппы]=Стр.НоменклатурнаяГруппа;
						Движение.СубконтоДт[Субконто.СтавкиНДС]=Стр.СтавкаНДС;
						
						//Для версии КОРП
						Если ВестиУчетПоПодразделениям Тогда
							Если Движение.СчетДт.УчетПоПодразделениям Тогда
								Движение.ПодразделениеДт = Источник.ПодразделениеОрганизации;
							КонецЕсли;
						КонецЕсли;
						//Для версии КОРП
						
						// --- 
						Движение.СчетКт = х68_2;
						Движение.СубконтоКт[Субконто.ВидыПлатежейВГосБюджет]=Перечисления.ВидыПлатежейВГосБюджет.Налог;
						
						//Для версии КОРП
						Если ВестиУчетПоПодразделениям Тогда
							Если Движение.СчетКт.УчетПоПодразделениям Тогда
								Движение.ПодразделениеКт = Источник.ПодразделениеОрганизации;
							КонецЕсли;
						КонецЕсли;
						//Для версии КОРП
						
						// --- 
						Движение.Сумма 	= Стр.СуммаНДС_БВ;
						Движение.Содержание = "Реализация услуг";
						
					КонецЕсли; 
					
				КонецЦикла; // обход строк реализации ведомого документа и формирование проводок в БУ
				
				// К этому моменту сформированы все проводки по бухгалтерскому учету (все рублевые суммы по документу зафиксированы).	
				// Теперь необходимо сформировать рублевые суммы по таблице услуг ведущего документа (с привязкой к грузоперевозкам)
				// и сформировать движения ведущего документа
				
				// таблица услуг ведущего
				УслугиВедущего = ВедущийДокумент.Услуги.Выгрузить();
				CW_Финансы.ДобавитьКолонкиБазовойВалюты(УслугиВедущего);
				УслугиВедущего.Колонки.Добавить("Собственная");
				УслугиВедущего.Колонки.Добавить("КоррСчет");
				УслугиВедущего.Колонки.Добавить("СчетАвансов");
				УслугиВедущего.ЗаполнитьЗначения(0,"Цена_Рег,Сумма_Рег,НДС_Рег,Всего_Рег");
				
				// проставляем счета авансов
				Для каждого Стр Из УслугиВедущего Цикл
					
					Стр.Собственная = (Стр.ПорядокОтражения = Перечисления.CW_ПорядокОтраженияДоходов.СобственнаяУслуга)
					ИЛИ (Стр.ПорядокОтражения = Перечисления.CW_ПорядокОтраженияДоходов.ПрочиеДоходы);
					
					Если Стр.Собственная Тогда
						
						Если РасчетыУЕ Тогда
							
							Стр.СчетАвансов = х62_32;
							
						ИначеЕсли РасчетыВалюта Тогда
							
							Стр.СчетАвансов = х62_22;
							
						КонецЕсли; 
						
					Иначе
						
						Если ОтдельныйСчетПоПеревыставляемым Тогда
							
							Если РасчетыУЕ Тогда
								
								Стр.СчетАвансов = СчетРасчетовПоВозмещаемым_УЕ;
								
							ИначеЕсли РасчетыВалюта Тогда
								
								Стр.СчетАвансов = СчетРасчетовПоВозмещаемым_Валюта;
								
							КонецЕсли; 
							
						Иначе
							
							Если РасчетыУЕ Тогда
								
								Стр.СчетАвансов = х62_32;
								
							ИначеЕсли РасчетыВалюта Тогда 
								
								Стр.СчетАвансов = х62_22;
								
							КонецЕсли; 
							
						КонецЕсли; 
						
					КонецЕсли; 
					
				КонецЦикла; // заполнение счетов аванса
				
				// проставляем корр. счета
				ВД_ОсновнаяСистема = Перечисления.ВидыДеятельностиДляНалоговогоУчетаЗатрат["ОсновнаяСистемаНалогообложения"];
				ВД_ЕНВД = Перечисления.ВидыДеятельностиДляНалоговогоУчетаЗатрат["ОсобыйПорядокНалогообложения"];
				Для каждого Стр Из УслугиВедущего Цикл
					
					Если (Стр.ПорядокОтражения = Перечисления.CW_ПорядокОтраженияДоходов.СобственнаяУслуга) Тогда
						
						Если (Стр.СтатьяЗатрат.ВидДеятельностиДляНалоговогоУчетаЗатрат = ВД_ОсновнаяСистема) Тогда
							Стр.КоррСчет = х90_1_1;
						ИначеЕсли (Стр.СтатьяЗатрат.ВидДеятельностиДляНалоговогоУчетаЗатрат = ВД_ЕНВД) Тогда 
							Стр.КоррСчет = х90_1_2;
						КонецЕсли; 
						
					ИначеЕсли (Стр.ПорядокОтражения = Перечисления.CW_ПорядокОтраженияДоходов.ПрочиеДоходы) Тогда
						
						Стр.КоррСчет = х91_1;
						
					ИначеЕсли (Стр.ПорядокОтражения = Перечисления.CW_ПорядокОтраженияДоходов.Перевыставление) Тогда 
						
						Стр.КоррСчет = х76_5;
						
					ИначеЕсли (Стр.ПорядокОтражения = Перечисления.CW_ПорядокОтраженияДоходов.ПеревыставлениеПоСтавкам) Тогда 
						
						Стр.КоррСчет = х76_6;
						
					КонецЕсли; 
					
				КонецЦикла; // заполнение корр.счета
				
				#Область ОстаткиПеревыстаавления
				
				
				// смотрим остаток по регистру "Перевыставление" и проверяем, не образуется ли копеек
				Запрос = Новый Запрос;
				Запрос.Текст = "ВЫБРАТЬ
				|	CW_ПеревыставлениеОстатки.Грузоперевозка КАК Грузоперевозка,
				|	CW_ПеревыставлениеОстатки.Номенклатура КАК Номенклатура,
				|	CW_ПеревыставлениеОстатки.ДокументРасходов КАК ДокументРасходов,
				|	CW_ПеревыставлениеОстатки.СтавкаНДС КАК СтавкаНДС,
				|	CW_ПеревыставлениеОстатки.КоличествоОстаток КАК Количество,
				|	CW_ПеревыставлениеОстатки.ВсегоОстаток КАК Всего_Рег,
				|	CW_ПеревыставлениеОстатки.СуммаОстаток КАК Сумма_Рег,
				|	CW_ПеревыставлениеОстатки.НДСОстаток КАК НДС_Рег
				|ИЗ
				|	РегистрНакопления.CW_Перевыставление.Остатки(
				|			&Период,
				|			Контрагент = &Контрагент
				|				И Договор = &Договор
				|				И ПриложениеКДоговору = &ПриложениеКДоговору) КАК CW_ПеревыставлениеОстатки";
				
				Запрос.УстановитьПараметр("Период"		, ВедущийДокумент.МоментВремени());
				Запрос.УстановитьПараметр("Контрагент"	, ВедущийДокумент.Контрагент);
				Запрос.УстановитьПараметр("Договор"		, ВедущийДокумент.Договор); 
				
				Запрос.УстановитьПараметр("ПриложениеКДоговору"		, ВедущийДокумент.ПриложениеКДоговору); 
				
				ТаблицаОстатковПеревыставления = Запрос.Выполнить().Выгрузить();
				// --- 
				УслугиВедущего.Колонки.Добавить("Отклонение");
				УслугиВедущего.ЗаполнитьЗначения(0,"Отклонение");
				
				
				ТаблицаРеализации2 = ТаблицаРеализации.Скопировать();
				ТаблицаРеализации2.Свернуть("Номенклатура,КоррСчет,СчетАвансов","Всего,Всего_БВ,СуммаНДС,СуммаНДС_БВ,Сумма,Сумма_БВ");
				
				// Заполнение рублевых сум в таблице реализации ведущего документа. 
				// Для этого мы свернули таблицу реализации ведомого документа до корсчетов
				Для каждого Стр Из ТаблицаРеализации2 Цикл
					
					Отбор 			= Новый Структура("Номенклатура,КоррСчет,СчетАвансов",Стр.Номенклатура,Стр.КоррСчет,Стр.СчетАвансов);
					СтрокиДокумента = УслугиВедущего.НайтиСтроки(Отбор);
					
					ВременнаяТаблицаУслуг 		= УслугиВедущего.Скопировать(Отбор);
					
					//Распределяем сумму
					СуммаКоэффициентов 		= ВременнаяТаблицаУслуг.Итог("Всего"); //Коэффициенты распределения
					РаспределяемаяСумма 	= Стр.Всего_БВ;
					РаспределеннаяСумма 	= 0;
					МаксимальныйКоэффициент = 0;
					ИндексМаксимальногоКоэффициента = 0;
					
					Для Индекс = 0 По СтрокиДокумента.Количество() - 1 Цикл
						
						СтрокаДокумента 	= СтрокиДокумента[Индекс];
						ТекущийКоэффициент 	= СтрокаДокумента.Всего;
						
						АбсолютноеЗначениеКоэффициента = ?(СтрокаДокумента.Всего > 0, СтрокаДокумента.Всего, -СтрокаДокумента.Всего);
						Если МаксимальныйКоэффициент < АбсолютноеЗначениеКоэффициента Тогда
							МаксимальныйКоэффициент = АбсолютноеЗначениеКоэффициента;
							ИндексМаксимальногоКоэффициента = Индекс;
						КонецЕсли;
						
						СтрокаДокумента.Всего_Рег = Окр(РаспределяемаяСумма * (ТекущийКоэффициент / СуммаКоэффициентов),2);
						РаспределеннаяСумма = РаспределеннаяСумма + СтрокаДокумента.Всего_Рег;
						
					КонецЦикла;
					
					Дельта = РаспределяемаяСумма - РаспределеннаяСумма;
					
					Если Дельта <> 0 Тогда 
						
						// Погрешности округления отнесем на строку с максимальной суммой.
						Если Не РаспределеннаяСумма = РаспределяемаяСумма Тогда
							СтрокаДокументаСМаксимвльнойСуммой 				= СтрокиДокумента[ИндексМаксимальногоКоэффициента] ;
							СтрокаДокументаСМаксимвльнойСуммой.Всего_Рег 	= СтрокаДокументаСМаксимвльнойСуммой.Всего_Рег + Дельта;
						КонецЕсли;
						
					КонецЕсли;
					
					СуммаНДС_БВ = Стр.СуммаНДС_БВ;
					
					Для каждого СтрокаДокумента Из СтрокиДокумента Цикл
						
						ПересчитыватьНДС = Истина;
						Если (СтрокаДокумента.ПорядокОтражения = Перечисления.CW_ПорядокОтраженияДоходов.Перевыставление) Тогда
							
							Отбор = _сф.ст_Создать("Грузоперевозка,Номенклатура,СтавкаНДС,ДокументРасходов",СтрокаДокумента);
							// --- 
							СтрокаОстаткаПеревыставления = _сф.к_НайтиСтроку(ТаблицаОстатковПеревыставления,Отбор);
							Если (СтрокаОстаткаПеревыставления <> Неопределено) Тогда
								
								Если (СтрокаДокумента.Количество = СтрокаОстаткаПеревыставления.Количество) Тогда
									СтрокаДокумента.Отклонение =  СтрокаОстаткаПеревыставления.Всего_Рег - СтрокаДокумента.Всего_Рег;
									Если СтрокаДокумента.Отклонение <> 0 Тогда
										
										Сообщить(Источник);
										Сообщить("Отклонение при закрытии счёта учёта перевыставления:"+Строка(СтрокаДокумента.Отклонение));
										
									КонецЕсли; 
									
									СтрокаДокумента.Всего_Рег = СтрокаОстаткаПеревыставления.Всего_Рег;
									СтрокаДокумента.Сумма_Рег = СтрокаОстаткаПеревыставления.Сумма_Рег;
									СтрокаДокумента.НДС_Рег   = СтрокаОстаткаПеревыставления.НДС_Рег;
									
									ПересчитыватьНДС = Ложь;
								КонецЕсли; 
								
							КонецЕсли; 
							
						КонецЕсли; 
						
						// --- 
						
						Если (ПересчитыватьНДС) Тогда
							СтавкаНДС 				= CW_Финансы.ПолучитьСтавкуНДС(СтрокаДокумента.СтавкаНДС);
							
							// определяем расчетную сумму НДС
							Если РасчетыУЕ Тогда
								ТмпНДС = Окр(СтрокаДокумента.Всего_Рег * СтавкаНДС/(100 + СтавкаНДС),2,1);	
							Иначе
								ТмпНДС	= Окр(Окр(СтрокаДокумента.Сумма * СтруктураКурсаДокумента.Курс/СтруктураКурсаДокумента.Кратность,2,1) * СтавкаНДС/100,2,1);
							КонецЕсли;
							
							Если СтрокиДокумента.Найти(СтрокаДокумента) = СтрокиДокумента.Количество()-1 Тогда
								СтрокаДокумента.НДС_Рег = СуммаНДС_БВ;
							Иначе
								СтрокаДокумента.НДС_Рег = ТмпНДС;
							КонецЕсли;
							
							СтрокаДокумента.Сумма_Рег = СтрокаДокумента.Всего_Рег - СтрокаДокумента.НДС_Рег;
							
							СуммаНДС_БВ = СуммаНДС_БВ - СтрокаДокумента.НДС_Рег;
						КонецЕсли; 
						// --- 
						СтрокаДокумента.Цена_Рег = _сф.БезопасноРазделить(СтрокаДокумента.Сумма_Рег,СтрокаДокумента.Количество);
						
						// ---------------------------------------------------------------------------- 
						
					КонецЦикла; 
					
				КонецЦикла;
				
				#КонецОбласти
				
				// теперь смотрим объем корректировок
				ТаблицаКорректировок = УслугиВедущего.Скопировать(,"СчетЗадолженности,Отклонение");
				ТаблицаКорректировок.Свернуть("СчетЗадолженности","Отклонение");
				Для каждого СтрокаКорректировки Из ТаблицаКорректировок Цикл
					
					Если (СтрокаКорректировки.Отклонение <> 0) Тогда
						
						// находим проводку "Дт СтрокаКорректировки.СчетЗадолженности - Кт 76.5" и добавляем отклонение
						Для каждого Движение Из Источник.Движения.Хозрасчетный Цикл
							
							Если (Движение.СчетДт = СтрокаКорректировки.СчетЗадолженности И Движение.СчетКт = х76_5) Тогда
								
								_сф.Инкремент(Движение.Сумма, СтрокаКорректировки.Отклонение);
								Движение.СуммаНУДт = Движение.Сумма;
								Движение.СуммаНУКт = Движение.Сумма;
								Прервать;
								
							КонецЕсли; 
							
						КонецЦикла; 
						
					КонецЕсли; 
					
				КонецЦикла; 
				
				#Область РеализацияУслуг
				
				РеализацияУслуг = ТаблицаРеализации.Скопировать(Новый Структура("Собственная", истина));
				РеализацияУслуг.Колонки.Добавить("Период");
				РеализацияУслуг.Колонки.Добавить("Организация");
				РеализацияУслуг.Колонки.Добавить("Подразделение");
				
				РеализацияУслуг.ЗаполнитьЗначения(Источник.Дата						, "Период");
				РеализацияУслуг.ЗаполнитьЗначения(Источник.Организация				, "Организация");
				РеализацияУслуг.ЗаполнитьЗначения(Источник.ПодразделениеОрганизации , "Подразделение");
				
				МассивСуммБВ = РеализацияУслуг.ВыгрузитьКолонку("Сумма_БВ");
				РеализацияУслуг.ЗагрузитьКолонку(МассивСуммБВ,"Сумма");
				
				Источник.Движения.РеализацияУслуг.Очистить();
				Источник.Движения.РеализацияУслуг.Загрузить(РеализацияУслуг);
				
				#КонецОбласти
				
				
				#Область РублевыеСуммы
				
				//кэшДвижений = Источник.Движения.РублевыеСуммыДокументовВВалюте.Выгрузить();
				Источник.Движения.РублевыеСуммыДокументовВВалюте.Очистить();

				СчетчикСобственных = 0;
				СчетчикВозмещаемых = 0;
				
				Для каждого Стр Из УслугиВедущего Цикл
					
					Движение = Источник.Движения.РублевыеСуммыДокументовВВалюте.Добавить();
					Движение.Период = Источник.Дата;
					Движение.Организация = Источник.Организация;
					
					Отбор = Новый Структура("ТабличнаяЧастьДокумента,НомерСтрокиДокумента");
					
					Если (Стр.ПорядокОтражения = Перечисления.CW_ПорядокОтраженияДоходов.СобственнаяУслуга)
						ИЛИ (Стр.ПорядокОтражения = Перечисления.CW_ПорядокОтраженияДоходов.ПрочиеДоходы) Тогда
						
						Движение.ТабличнаяЧастьДокумента = Перечисления.ТабличныеЧастиДокументов.Услуги;	
						_сф.Инкремент(СчетчикСобственных);
						Движение.НомерСтрокиДокумента = СчетчикСобственных;
						
						Отбор.ТабличнаяЧастьДокумента 	= Перечисления.ТабличныеЧастиДокументов.Услуги;
						Отбор.НомерСтрокиДокумента 		= СчетчикСобственных;
						
					Иначе
						
						Движение.ТабличнаяЧастьДокумента = Перечисления.ТабличныеЧастиДокументов.АгентскиеУслуги;	
						_сф.Инкремент(СчетчикВозмещаемых);
						Движение.НомерСтрокиДокумента = СчетчикВозмещаемых;
						
						Отбор.ТабличнаяЧастьДокумента 	= Перечисления.ТабличныеЧастиДокументов.АгентскиеУслуги;
						Отбор.НомерСтрокиДокумента 		= СчетчикВозмещаемых;
						
					КонецЕсли; 
					
					Движение.Всего				= Стр.Всего_Рег;
					Движение.НДС				= Стр.НДС_Рег;
					
					// для у.е. налоговая база рассчитывается классически, для валюты по курсу на дату документа
					Если РасчетыУЕ Тогда 
						НалоговаяБазаНДС = Стр.Всего_Рег - Стр.НДС_Рег; 	
					Иначе  
						//Изменения по заявке AFR-260064 
						Если Источник.ЗачетАвансов.Количество() = 0 Тогда
							НалоговаяБазаНДС = Стр.Сумма_Рег;	
						Иначе
							НалоговаяБазаНДС = Окр(Стр.Сумма * Источник.КурсВзаиморасчетов / Источник.КратностьВзаиморасчетов, 2,1);
						КонецЕсли;
						//Изменения по заявке AFR-260064 
					КонецЕсли;
					
					Движение.НалоговаяБазаНДС 	= НалоговаяБазаНДС;
					
				КонецЦикла; 
				
				#КонецОбласти 
				
				#Область Реализация0
				
				Отбор = Новый Структура("ПорядокОтражения,СтавкаНДС",Перечисления.CW_ПорядокОтраженияДоходов.СобственнаяУслуга,Перечисления.СтавкиНДС.НДС0);
				ТаблицаДвиженийПод0 = УслугиВедущего.Скопировать(Отбор);
				
				Отбор = Новый Структура("ПорядокОтражения,СтавкаНДС",Перечисления.CW_ПорядокОтраженияДоходов.ПрочиеДоходы,Перечисления.СтавкиНДС.НДС0);
				ТаблицаДвиженийПрочиеДоходыПод0 = УслугиВедущего.Скопировать(Отбор);
				
				Для Каждого Новстр из ТаблицаДвиженийПрочиеДоходыПод0 Цикл
					НоваяСтрока = ТаблицаДвиженийПод0.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтрока,Новстр);
				Конеццикла;
				
				//СуммаПод0 = ТаблицаДвиженийПод0.Итог("Всего_Рег");
				СуммаПод0 = ТаблицаДвиженийПод0.Итог("Всего");

				Если (СуммаПод0 <> 0) Тогда
					
					Если Источник.ДоговорКонтрагента.РасчетыВУсловныхЕдиницах Тогда
						
						СуммаПод0 = ТаблицаДвиженийПод0.Итог("Всего_рег"); 
						
					Иначе
						
						СуммаПод0 = CW_Финансы.ПересчитатьИзВалютыВВалюту(СуммаПод0, 
													Источник.ВалютаДокумента,
													ВалютаРегламентированногоУчета,
													Источник.КурсВзаиморасчетов,
													1,
													Источник.КратностьВзаиморасчетов,
													1);
						
					КонецЕсли;
												
					// находим движение по реализация0
					Если (Источник.Движения.НДСРеализация0.Количество() <> 0) Тогда
						
						Движение0 = Источник.Движения.НДСРеализация0[0];
						Движение0.СуммаБезНДС = СуммаПод0;
						
					КонецЕсли; 
					
				КонецЕсли; 
				
				#КонецОбласти 
				
				// передаём услуги ведущего в процедуру формирования движений ведущего
				CW_Подписки.СформироватьДвиженияДляДоходов(ВедущийДокумент,Отказ,,УслугиВедущего);
				
			КонецЕсли;

			Если (НЕ ВалютныйДокумент) Тогда
				CW_Подписки.СформироватьДвиженияДляДоходов(ВедущийДокумент,Отказ);
			КонецЕсли; 
			
		КонецЕсли; 
		
		// доработка зачета аванса для рублей
		Если (НЕ ВалютныйДокумент И НЕ ЗакрытиеГрузоперевозки) Тогда
			
			КЧ = Новый КвалификаторыЧисла(12,2);
			Массив = Новый Массив;	
			Массив.Добавить(Тип("Число"));
			ОписаниеТиповЧ = Новый ОписаниеТипов(Массив, , ,КЧ);
			
			Индекс = ВедущийДокумент.Услуги.Выгрузить();
			CW_Финансы.ДобавитьКолонкиБазовойВалюты(Индекс);
			Индекс.Свернуть("ПорядокОтражения", "Всего");
			
			Счет = CW_Настройки.ПараметрУчетнойПолитики(Источник.Дата,Источник.Организация,"СчетРасчетов_Клиенты_Рубли");
			СчетВал = CW_Настройки.ПараметрУчетнойПолитики(Источник.Дата,Источник.Организация,"СчетРасчетов_Клиенты_Валюта");
			
			МассивУдаления = Новый Массив;
			
			Если ВедущийДокумент.ЗачетАвансов.Количество() <> 0 Тогда
				
				// рублевая ветка
				Если РублевыйДокумент Тогда
					
					// удаляем стандартные движения по зачету (62.01)
					Для каждого Движение Из ДвиженияВедомого Цикл
						Если Движение.СчетДт = Счета.РасчетыПоАвансамПолученным Тогда
							МассивУдаления.Добавить(Движение);
						КонецЕсли;
					КонецЦикла;
					_сф.к_УдалитьЭлементыПоМассиву(ДвиженияВедомого,МассивУдаления);
					
					// формируем проводки зачета
					Для Каждого Стр Из ВедущийДокумент.ЗачетАвансов Цикл
						
						Движение = ДвиженияВедомого.Добавить();
						// --- 
						Движение.СчетДт = Стр.СчетАванса;
						Движение.Период = Источник.Дата;
						Движение.Регистратор = Источник.Ссылка;
						Движение.Организация = Источник.Организация;
						
						//Для версии КОРП
						Если ВестиУчетПоПодразделениям Тогда
							Если Движение.СчетДт.УчетПоПодразделениям Тогда
								Движение.ПодразделениеДт = Источник.ПодразделениеОрганизации;
							КонецЕсли;
						КонецЕсли;
						//Для версии КОРП
						
						Движение.СубконтоДт[Субконто.Контрагенты] = Источник.Контрагент;
						Движение.СубконтоДт[Субконто.Договоры] = Источник.ДоговорКонтрагента;
						Движение.СубконтоДт[Субконто.ДокументыРасчетовСКонтрагентами] = Стр.ДокументАванса;
						
						// если не 62.02 - счет расчетов по возмещаемым, иначе 62.01
						Если Стр.СчетАванса <> Счета.РасчетыПоАвансамПолученным Тогда
							Движение.СчетКт = Счет;
						Иначе
							Движение.СчетКт = Счета.РасчетыСПокупателями;
						КонецЕсли;
						
						//Для версии КОРП
						Если ВестиУчетПоПодразделениям Тогда
							Если Движение.СчетКт.УчетПоПодразделениям Тогда
								Движение.ПодразделениеКт = Источник.ПодразделениеОрганизации;
							КонецЕсли;
						КонецЕсли;
						//Для версии КОРП
						
						Движение.СубконтоКт[Субконто.Контрагенты] = Источник.Контрагент;
						Движение.СубконтоКт[Субконто.Договоры] = Источник.ДоговорКонтрагента;
						Движение.СубконтоКт[Субконто.ДокументыРасчетовСКонтрагентами] = Источник.Ссылка;
						Движение.Содержание = "Зачет аванса";
						Движение.Сумма = Стр.СуммаЗачета;
						
					КонецЦикла;	
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли; 
		
		#Область УСН 
		
		// Корректировка проводок по бухгалтерскому учету и регистрам КУДиР
		// осуществляется только в случае ведения оперативного учета дебиторской задолженности
		// и только в том случае, если не включен раздельный учет авансов в оперативном и бухгалтерском учете.
		// Т.е. если включен раздельный учет авансов, то корректировка проводок 
		// и движений по регитрам КУДиР не осуществляется!
		
		// получаем настройки учета оперативной дебеторской задолженности   
		СтруктураНастроек = CW_Настройки.ПолучитьНастройкиОперативногоУчета(Источник.Организация, Перечисления.CW_ВидыОперативнойЗадолженности.Дебиторская, Источник.Дата);
		
		ИспользуетсяОперативнаяЗадолженность 	= СтруктураНастроек["ВедетсяОперативныйУчет"];
		РаздельныйУчет 							= СтруктураНастроек["НастройкиОперативногоУчета"]["РаздельныйУчет"];

		// корректировка движений в случае, если ведущий документ "Доходы по грузоперевозке"
		//Если НЕ ЗакрытиеГрузоперевозки и ИспользуетсяОперативнаяЗадолженность и НЕ РаздельныйУчет Тогда   
		Если ТребуетсяКорректировкаДвиженийУСН и НЕ ЗакрытиеГрузоперевозки Тогда
			
			НЗ_ОплатыУСН = _сф.НаборЗаписейПоРегистратору(РегистрыНакопления.CW_ОплатыПокупателейУСН,ВедущийДокумент);
			НЗ_РаспределениеОплатУСН = _сф.НаборЗаписейПоРегистратору(РегистрыСведений.CW_РаспределениеОплатПокупателейУСН,ВедущийДокумент); 
			
			Если (ДействуетУСН И ТаблицаАвансов.Количество() <> 0) Тогда
				
				#Область ОчисткаДвижений 
				
				// по КУДиР 
				Источник.Движения.КнигаУчетаДоходовИРасходов.Очистить();  
				
				// по УСН.01/21 УСН.02/22
				ОчередьУдаления = Новый Массив;
				Для каждого Движение Из Источник.Движения.Хозрасчетный Цикл
					
					Если Движение.СчетДт = Счета.УСНРасчетыСПокупателямиЕНВД
						ИЛИ Движение.СчетДт = Счета.УСНРасчетыСПокупателямиВалЕНВД
						ИЛИ Движение.СчетДт = Счета.УСНРасчетыСПокупателямиКомитент
						ИЛИ Движение.СчетДт = Счета.УСНРасчетыСПокупателямиВалКомитент Тогда
						
						ОчередьУдаления.Добавить(Движение);
					КонецЕсли; 
				КонецЦикла; 
				_сф.к_УдалитьЭлементыПоМассиву(Источник.Движения.Хозрасчетный,ОчередьУдаления); 
				
				#КонецОбласти 
				
				// алгоритм работы по отражению в КУДиР:
				// формируем таблицу документа, 
				// для каждой строки зачета аванса снимаем остатки по регистру "оплаты УСН" по платежке
				// нормируем таблицу документа и вычитаем ее из таблицы остатков
				// смотрим отклонения от нуля и пишем их в КУДиР
				
				// формируем распределение документа по счетам аванса
				ТД = _сф.т_Создать("СчетАванса,СчетЗадолженности,ВалютнаяСумма,Сумма,СуммаДУ,СуммаДК,СуммаДЕ");   
				
				УслугиДокумента = CW_Финансы.ПолучитьУслугиДокумента(ВедущийДокумент);
				УслугиПоСчетуАванса = УслугиДокумента.Скопировать();
				УслугиПоСчетуАванса.Свернуть("СчетЗадолженности","Всего,Всего_Рег");
				УслугиПоСчетуАванса.Колонки.Добавить("СчетАванса");
				Для каждого Стр Из УслугиПоСчетуАванса Цикл
					
					Стр.СчетАванса = CW_Финансы.СчетАванса(Стр.СчетЗадолженности);
					
					// отбираем платежки по счету аванса
					// для каждой строки зачета считаем распределение
					Отбор = Новый Структура("СчетАванса",Стр.СчетАванса);
					СтрокиПлатежек = ТаблицаАвансов.НайтиСтроки(Отбор); 
					
					Для каждого СтрокаПлатежки Из СтрокиПлатежек Цикл
						Нстр = ТД.Добавить();
						Нстр.СчетАванса = Стр.СчетАванса;
						Нстр.СчетЗадолженности = Стр.СчетЗадолженности;
						Нстр.ВалютнаяСумма = СтрокаПлатежки.СуммаЗачета;
						Нстр.Сумма = СтрокаПлатежки.СуммаЗачета_БВ;
						ОпределитьСоотношениеДляУСН(Нстр,УслугиДокумента,Истина);
					КонецЦикла;
				КонецЦикла;
				
				// формируем распределение строк зачета
				ТО = _сф.т_Создать("Договор,ДокументОплаты,Оплата,СчетАванса,ВалютнаяСумма,Сумма,СуммаДУ,СуммаДК,СуммаДЕ");
				ТаблицаАвансов.Свернуть("СчетАванса,ДокументАванса,ДокументОплаты","СуммаЗачета,СуммаЗачета_БВ");     
				
				Для каждого Стр Из ТаблицаАвансов Цикл
					
					Нстр = ТО.Добавить();
					Нстр.Договор = Источник.ДоговорКонтрагента;
					Нстр.СчетАванса = Стр.СчетАванса;
					Нстр.ДокументОплаты = Стр.ДокументАванса;
					Нстр.Оплата = Стр.ДокументОплаты;  
					
					Отбор = Новый Структура("СчетАванса", Нстр.СчетАванса);
					СД = _сф.к_НайтиСтроку(ТД,Отбор);
					Если (СД = Неопределено) Тогда
						// внимание!
					КонецЕсли;
					
					Нстр.ВалютнаяСумма = Стр.СуммаЗачета;
					Нстр.Сумма = Стр.СуммаЗачета_БВ;
					Нстр.СуммаДК = Окр(СД.СуммаДК * (Стр.СуммаЗачета / СД.Сумма) * (Стр.СуммаЗачета_БВ/Стр.СуммаЗачета),2);
					Нстр.СуммаДЕ = Окр(СД.СуммаДЕ * (Стр.СуммаЗачета / СД.Сумма) * (Стр.СуммаЗачета_БВ/Стр.СуммаЗачета),2);
					Нстр.СуммаДУ = Нстр.Сумма - (Нстр.СуммаДК + Нстр.СуммаДЕ);
					
				КонецЦикла; 
				
				// получаем остатки отражения авансов
				Запрос = Новый Запрос;
				Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	CW_ОплатыПокупателейУСНОстатки.Договор,
				|	CW_ОплатыПокупателейУСНОстатки.ДокументОплаты,
				|	CW_ОплатыПокупателейУСНОстатки.СчетАванса,
				|	CW_ОплатыПокупателейУСНОстатки.СуммаОстаток КАК Сумма,
				|	CW_ОплатыПокупателейУСНОстатки.СуммаДУОстаток КАК СуммаДУ,
				|	CW_ОплатыПокупателейУСНОстатки.СуммаДКОстаток КАК СуммаДК,
				|	CW_ОплатыПокупателейУСНОстатки.СуммаДЕОстаток КАК СуммаДЕ
				|ИЗ
				|	РегистрНакопления.CW_ОплатыПокупателейУСН.Остатки(
				|			&Период,
				|			Договор = &Договор
				|				И ДокументОплаты В (&Документы)) КАК CW_ОплатыПокупателейУСНОстатки";
				Запрос.УстановитьПараметр("Период", Новый Граница(ВедущийДокумент.МоментВремени(), ВидГраницы.Исключая));
				Запрос.УстановитьПараметр("Договор", Источник.ДоговорКонтрагента);
				ТаблицаСчетовАвансов = ТаблицаАвансов.Скопировать();
				ТаблицаСчетовАвансов.Свернуть("ДокументАванса");
				Запрос.УстановитьПараметр("Документы", ТаблицаСчетовАвансов.ВыгрузитьКолонку("ДокументАванса"));
				ОО = Запрос.Выполнить().Выгрузить();
				
				// высчитываем отклонения
				ВТО = ТО.СкопироватьКолонки();
				Для каждого Стр Из ТО Цикл
					
					// находим строку ОО для пары счет аванса - документ оплаты
					стрОО = _сф.к_НайтиСтроку(ОО,Новый Структура("СчетАванса,ДокументОплаты",Стр.СчетАванса, Стр.ДокументОплаты));
					Если (стрОО = Неопределено) Тогда
						Сообщить("Не обнаружен остаток распределения оплаты для """+Строка(Стр.ДокументОплаты)+"""");
					Иначе
						
						// проверяем
						ДельтаДУ = Мин(стрОО.СуммаДУ - стр.СуммаДУ,0);
						ДельтаДК = Мин(стрОО.СуммаДК - стр.СуммаДК,0);
						ДельтаДЕ = Мин(стрОО.СуммаДЕ - стр.СуммаДЕ,0);
						
						Если (ДельтаДУ = 0 И ДельтаДК = 0 И ДельтаДЕ = 0) Тогда
							// зачет в пределах порядка отражения, можно не нормировать
						Иначе
							
							// распределяем минусы по другим графам
							СР = Новый Структура; // структура распределения
							СР.Вставить("СуммаДУ",ДельтаДУ);
							СР.Вставить("СуммаДК",ДельтаДК);
							СР.Вставить("СуммаДЕ",ДельтаДЕ); 
							
							Для каждого КЗ Из СР Цикл
								Если (КЗ.Значение < 0) Тогда
									ОстатокСуммыРаспределения = _сф.Модуль(КЗ.Значение);
									Для каждого КЗР Из СР Цикл
										Если (КЗР.Значение >= 0 И ОстатокСуммыРаспределения > 0) Тогда
											СуммаПерераспределения = ОстатокСуммыРаспределения;
											_сф.Инкремент(СР[КЗР.Ключ],СуммаПерераспределения);
											_сф.Инкремент(СР[КЗ.Ключ],СуммаПерераспределения);
											_сф.Декремент(ОстатокСуммыРаспределения,СуммаПерераспределения);
										КонецЕсли; 
									КонецЦикла; 
									
									// проверяем, что все распределии
									Если (ОстатокСуммыРаспределения <> 0) Тогда
										Сообщить("Ошибка перераспределения сумм для УСН");
										Отказ = Истина;
										Возврат;
									КонецЕсли; 
								КонецЕсли; 
							КонецЦикла; 
							
							НДельтаДУ = СР.СуммаДУ;
							НДельтаДК = СР.СуммаДК;
							НДельтаДЕ = СР.СуммаДЕ;
							
							Нстр = ВТО.Добавить();
							Нстр.Договор = Стр.Договор;
							Нстр.СчетАванса = Стр.СчетАванса;
							Нстр.ДокументОплаты = Стр.ДокументОплаты;
							Нстр.Сумма = 0;
							Нстр.СуммаДУ = (НдельтаДУ+ДельтаДУ);
							Нстр.СуммаДК = (НдельтаДК+ДельтаДК);
							Нстр.СуммаДЕ = (НДельтаДЕ+ДельтаДЕ); 
						КонецЕсли; 
						
						Нстр = ОО.Добавить();
						Нстр.Договор = Стр.Договор;
						Нстр.СчетАванса = Стр.СчетАванса;
						Нстр.ДокументОплаты = Стр.ДокументОплаты;
						Нстр.Сумма = (-Стр.Сумма);
						Нстр.СуммаДУ = (-Стр.СуммаДУ);
						Нстр.СуммаДК = (-Стр.СуммаДК);
						Нстр.СуммаДЕ = (-Стр.СуммаДЕ); 
					КонецЕсли;
				КонецЦикла; 
				
				Для каждого Стр Из ВТО Цикл
					Нстр = ТО.Добавить();
					ЗаполнитьЗначенияСвойств(Нстр,Стр);
				КонецЦикла;  
				
				// аналог построчного вычитания по измерениям
				// по этой таблице будут формироваться записи КУДиР
				// параллельно каждая коррекировка добавляется в таблицу зачета (ТО), для списания по регистру "Оплаты УСН"
				ОО.Свернуть("Договор,СчетАванса,ДокументОплаты","Сумма,СуммаДУ,СуммаДК,СуммаДЕ");
				ОчередьУдаления = Новый Массив;
				Для каждого Стр Из ОО Цикл
					Если (Стр.СуммаДУ <> 0 ИЛИ Стр.СуммаДК <> 0 ИЛИ Стр.СуммаДЕ <> 0) Тогда
					Иначе
						ОчередьУдаления.Добавить(Стр);
					КонецЕсли; 
					
				КонецЦикла; 
				_сф.к_УдалитьЭлементыПоМассиву(ОО,ОчередьУдаления);
				
				// повторно сворачиваем и формируем запись КУДиР
				ОО.Свернуть("Договор,ДокументОплаты","Сумма,СуммаДУ,СуммаДК,СуммаДЕ");
				Для каждого Стр Из ОО Цикл
					
					КорректировкаДУ = (-Стр.СуммаДУ);
					КорректировкаДК = (-Стр.СуммаДК);
					КорректировкаДЕ = (-Стр.СуммаДЕ);
					
					Если (КорректировкаДУ > 0 ИЛИ КорректировкаДК > 0 ИЛИ КорректировкаДЕ > 0) Тогда
						
						КУДиР = Новый Структура("ДоходЕНВД, Графа4, Графа5, Графа6, Графа7, НДС, Содержание", 0,0,0,0,0,0,"");
						ДоговорДляУСН = ВедущийДокумент.Договор;
						СтрокаСодержание = "Реализация услуг покупателю " + ПН(ВедущийДокумент.Контрагент) + " по договору " +ДоговорДляУСН +". ";
						КУДиР.Содержание = СтрокаСодержание;
						ПредставлениеПП = "П/п №"+Стр.ДокументОплаты.НомерВходящегоДокумента + " от "+ Формат(Стр.ДокументОплаты.ДатаВходящегоДокумента,"ДФ=dd.MM.yyyy");
						
						Если (КорректировкаДУ > 0) Тогда
							_сф.Инкремент(КУДиР.Графа5,КорректировкаДУ);
							КУДиР.Содержание = КУДиР.Содержание + "Аванс по "+ПредставлениеПП+" на сумму " + Окр(КорректировкаДУ,2,1) + " руб. отнесен к деятельности УСН. ";
						КонецЕсли; 
						
						Если (КорректировкаДК > 0) Тогда
							_сф.Инкремент(КУДиР.Графа5,-КорректировкаДК);
							КУДиР.Содержание = КУДиР.Содержание + "Аванс по "+ПредставлениеПП+" на сумму " + Окр(КорректировкаДК,2,1) + " руб. отнесен к доходу комитента (принципала). ";
						КонецЕсли; 
						
						_сф.Инкремент(КУДиР.ДоходЕНВД, КорректировкаДЕ);
						Если (КорректировкаДЕ > 0) Тогда
							_сф.Инкремент(КУДиР.Графа5,-КорректировкаДЕ);
							КУДиР.Содержание = КУДиР.Содержание + "Аванс по "+ПредставлениеПП+" на сумму " + Окр(КорректировкаДЕ,2,1) + " руб. отнесен к доходу комитента (принципала). ";
						КонецЕсли; 
						
						Движение = Источник.Движения.КнигаУчетаДоходовИРасходов.Добавить();
						ЗаполнитьЗначенияСвойств(Движение,КУДиР);
						Движение.Организация = ВедущийДокумент.Организация;
						Движение.Период = Источник.Дата;
						Движение.РеквизитыПервичногоДокумента = НалоговыйУчетУСН.РеквизитыПервичногоДокумента(Источник.Ссылка);
					КонецЕсли; 
				КонецЦикла; 
				
				// формируем движения закрытия для регистра "CW_ОплатыПокупателейУСН"
				Для каждого Стр Из ТО Цикл
					Если (Стр.Сумма = 0 И Стр.СуммаДУ = 0 И Стр.СуммаДК = 0 И Стр.СуммаДЕ = 0) Тогда
						Продолжить;
					КонецЕсли; 
					
					Запись = НЗ_ОплатыУСН.Добавить();
					ЗаполнитьЗначенияСвойств(Запись, Стр);
					Запись.Период = Источник.Дата;
					Запись.ВидДвижения = ВидДвиженияНакопления.Расход;
				КонецЦикла; 
				
				// движения регистра "CW_РаспределениеОплатПокупателейУСН"
				ТО2 = ТО.Скопировать();
				ТО2.Свернуть("Оплата","ВалютнаяСумма,Сумма,СуммаДУ,СуммаДК,СуммаДЕ");
				Для каждого Стр Из ТО2 Цикл
					
					Если (Стр.Сумма = 0) Тогда
						Продолжить;
					КонецЕсли; 
					
					Запись = НЗ_РаспределениеОплатУСН.Добавить();  
					
					Запись.Организация = ВедущийДокумент.Организация;
					Запись.Контрагент = ВедущийДокумент.Контрагент;
					Запись.Договор = ВедущийДокумент.Договор;
					Запись.ДокументРеализации = ВедущийДокумент;
					Запись.ДокументОплаты = Стр.Оплата;
					Запись.ВалютнаяСумма = Стр.ВалютнаяСумма;
					Запись.Сумма = Стр.Сумма;
					Запись.СуммаДУ = Стр.СуммаДУ;
					Запись.СуммаДК = Стр.СуммаДК;
					Запись.СуммаДЕ = Стр.СуммаДЕ;
				КонецЦикла; 
			КонецЕсли; 
			
			НЗ_ОплатыУСН.Записать(Истина);
			НЗ_РаспределениеОплатУСН.Записать(Истина);
			
			// формирование движений для ведущего документа "Закрытие грузоперевозки"
		ИначеЕсли (ЗакрытиеГрузоперевозки) Тогда
			
			Если (ДействуетУСН) Тогда
				
				// формируем движение в КУДиР на сумму выявленного результата
				КУДиР = Новый Структура("ДоходЕНВД, Графа4, Графа5, Графа6, Графа7, НДС, Содержание", 0,0,0,0,0,0,"");
				СтрокаСодержание = "Реализация услуг покупателю """ + ПН(ВедущийДокумент.Контрагент) + """ по договору """ +ВедущийДокумент.Договор +""". ";
				КорректировкаДУ = ВедущийДокумент.Вознаграждение.Итог("Всего") - ВедущийДокумент.Вознаграждение.Итог("НДС");
				
				КУДиР.Графа5 = КорректировкаДУ;       
				КУДиР.Графа4 = ВедущийДокумент.Вознаграждение.Итог("Всего");       
				КУДиР.Содержание = КУДиР.Содержание + "Сумма реализации " + Окр(КорректировкаДУ,2,1) + " руб. отнесена к деятельности УСН. ";

				Движение = Источник.Движения.КнигаУчетаДоходовИРасходов.Добавить();
				ЗаполнитьЗначенияСвойств(Движение,КУДиР);
				Движение.Организация = ВедущийДокумент.Организация;
				Движение.Период = Источник.Дата;
				Движение.РеквизитыПервичногоДокумента = НалоговыйУчетУСН.РеквизитыПервичногоДокумента(Источник.Ссылка);
				Движение.Контрагент = ВедущийДокумент.Контрагент; 
				Движение.ДоговорКонтрагента = Источник.ДоговорКонтрагента; 
				
			КонецЕсли; 
		КонецЕсли; // корректировка движений в зависимости от ведущего документа 
		
		#КонецОбласти 
		
	Конецесли;	
	
	Если ВедущийДокумент.ФормируетсяСчетФактура Тогда
		
		СчетФактура = ВедущийДокумент.ВедомыйСчетФактура;
		
		ФормироватьТЗОплат = Истина;
		Если (ФормироватьТЗОплат) Тогда
			
			// ищем оплаты...
			ТЗПлатежныхДокументов = Новый ТаблицаЗначений;
			ТЗПлатежныхДокументов.Колонки.Добавить("НомерПлатежноРасчетногоДокумента");
			ТЗПлатежныхДокументов.Колонки.Добавить("ДатаПлатежноРасчетногоДокумента");
			
			Для каждого Движение Из Источник.Движения.Хозрасчетный Цикл
				
				Если ((Движение.СчетДт = Счета.РасчетыПоАвансамПолученнымУЕ И Движение.СчетКт = Счета.РасчетыСПокупателямиУЕ)
					ИЛИ (Движение.СчетДт = Счета.РасчетыПоАвансамПолученным И Движение.СчетКт = Счета.РасчетыСПокупателями)
					ИЛИ (Движение.СчетДт = Счета.РасчетыПоАвансамПолученнымВал И Движение.СчетКт = Счета.РасчетыСПокупателямиВал)) Тогда
					
					НовСтрока = ТЗПлатежныхДокументов.Добавить();
					
					// если документ является расчетно-платежным документом 
					// (в нем присутствуют реквизиты первичного документа)
					Попытка
						НовСтрока.НомерПлатежноРасчетногоДокумента = Движение.СубконтоДт[Субконто.ДокументыРасчетовСКонтрагентами].НомерВходящегоДокумента;
						НовСтрока.ДатаПлатежноРасчетногоДокумента = Движение.СубконтоДт[Субконто.ДокументыРасчетовСКонтрагентами].ДатаВходящегоДокумента;
					Исключение
						НовСтрока.НомерПлатежноРасчетногоДокумента = Движение.СубконтоДт[Субконто.ДокументыРасчетовСКонтрагентами].Номер;
						НовСтрока.ДатаПлатежноРасчетногоДокумента = Движение.СубконтоДт[Субконто.ДокументыРасчетовСКонтрагентами].Дата;
					КонецПопытки;
					
				КонецЕсли; 
				
			КонецЦикла;
			
			Для каждого Стр Из ТЗПлатежныхДокументов Цикл
				
				НайденныеПлатежныеДокументы = СчетФактура.ПлатежноРасчетныеДокументы.НайтиСтроки(Новый Структура("НомерДокумента, ДатаДокумента", Стр.НомерПлатежноРасчетногоДокумента, Стр.ДатаПлатежноРасчетногоДокумента));	
				Если НайденныеПлатежныеДокументы.Количество() = 0 Тогда
					ТребуетсяПерезаполнениеСчетаФактуры = Истина;
				КонецЕсли; 
				
			КонецЦикла; 
			
			Для каждого Стр Из СчетФактура.ПлатежноРасчетныеДокументы Цикл
				
				НайденныеПлатежныеДокументы = ТЗПлатежныхДокументов.НайтиСтроки(Новый Структура("НомерПлатежноРасчетногоДокумента, ДатаПлатежноРасчетногоДокумента", Стр.НомерДокумента, Стр.ДатаДокумента));	
				Если НайденныеПлатежныеДокументы.Количество() = 0 Тогда
					ТребуетсяПерезаполнениеСчетаФактуры = Истина;
				КонецЕсли; 
				
			КонецЦикла;
			
		КонецЕсли; 
		
		СФОбъект = СчетФактура.ПолучитьОбъект();
		
		СФОбъект.ВидСчетаФактуры = Перечисления.ВидСчетаФактурыВыставленного.НаРеализацию;
		СФОбъект.Дата = ВедущийДокумент.ДатаСчетаФактуры;
		СФОбъект.Номер = ВедущийДокумент.НомерСчетаФактуры;
		СФОбъект.Выставлен = Истина;
		СФОбъект.ДатаВыставления = ВедущийДокумент.ДатаАкта;
		
		СФОбъект.ДокументыОснования.Очистить();
		СФОбъект.ДокументыОснования.Добавить().ДокументОснование = Источник.Ссылка;
		СФОбъект.ДокументОснование = Источник.Ссылка;
		СФОбъект.ВидСчетаФактуры=Перечисления.ВидСчетаФактурыВыставленного.НаРеализацию;
		СФОбъект.Организация = Источник.Организация;
		СФОбъект.КодСпособаВыставления = ВедущийДокумент.КодСпособаВыставления;
		СФОбъект.ОпределениеПараметровСчетаФактурыНаРеализацию();
		
		СФОбъект.Комментарий = "Сформировано автоматически (CW) документом ""Доходы по грузоперевозке"" №"+Строка(ВедущийДокумент.Номер)+" от "+Формат(ВедущийДокумент.Дата,"ДФ=dd.MM.yyyy");
		СФОбъект.ПометкаУдаления = Ложь;
		
		СФОбъект.ПлатежноРасчетныеДокументы.Очистить();
		Для каждого Стр Из ТЗПлатежныхДокументов Цикл
			НовСтрока = СФОбъект.ПлатежноРасчетныеДокументы.Добавить();
			НовСтрока.ДатаДокумента = Стр.ДатаПлатежноРасчетногоДокумента;
			НовСтрока.НомерДокумента = Стр.НомерПлатежноРасчетногоДокумента;
		КонецЦикла;
		
		_сф.ст_УстановитьСвойство(СФОбъект.ДополнительныеСвойства,"ВедущийДокумент",ВедущийДокумент);
		Если (_сф.ст_ПолучитьСвойство(Источник.ДополнительныеСвойства,"Постановление735")=Неопределено) Тогда
			Постановление735 = CW_Настройки.ПараметрУчетнойПолитики(Источник.Дата, Источник.Организация, "ТребованияПостановления735");
		Иначе
			Постановление735 = _сф.ст_ПолучитьСвойство(Источник.ДополнительныеСвойства,"Постановление735");
		КонецЕсли; 
		_сф.ст_УстановитьСвойство(СФОбъект.ДополнительныеСвойства,"Постановление735",Постановление735);
		
		CW_Документы.ПеренестиПризнакВосстановленияПоследовательности(Источник,СФОбъект);
		
		ДокументЗакрытия = (ТипЗнч(ВедущийДокумент) = Тип("ДокументСсылка.CW_ЗакрытиеГрузоперевозки"));
		
		// скорректируем при необходимости код вида операции
		Если (Постановление735 И НЕ ДокументЗакрытия) Тогда
			
			СводнаяСФ = Ложь;
			ТаблицаУслуги = ВедущийДокумент.Услуги.Выгрузить();
			ТаблицаУслуги.Свернуть("ПорядокОтражения,ДокументРасходов");
			ТаблицаУслуги.Колонки.Добавить("Продавец");
			МассивУдаляемых = Новый Массив;
			ЕстьСобственные = Ложь;
			Для каждого Стр Из ТаблицаУслуги Цикл
				Если (Стр.ПорядокОтражения = Перечисления.CW_ПорядокОтраженияДоходов.Перевыставление) Тогда
					Стр.Продавец = ?(ЗначениеЗаполнено(Стр.ДокументРасходов.Продавец),Стр.ДокументРасходов.Продавец,Стр.ДокументРасходов.Контрагент);
				Иначе
					Если (Стр.ПорядокОтражения = Перечисления.CW_ПорядокОтраженияДоходов.СобственнаяУслуга)
						ИЛи (Стр.ПорядокОтражения = Перечисления.CW_ПорядокОтраженияДоходов.ПрочиеДоходы) Тогда
						ЕстьСобственные = Истина;
					КонецЕсли; 
					МассивУдаляемых.Добавить(Стр);
				КонецЕсли; 
			КонецЦикла; 
			
			_сф.к_УдалитьЭлементыПоМассиву(ТаблицаУслуги,МассивУдаляемых);
			ТаблицаУслуги.Свернуть("Продавец,ДокументРасходов");
			ТаблицаПродавцов = ТаблицаУслуги.Скопировать();
			ТаблицаПродавцов.Свернуть("Продавец");
			
			СводнаяСФ = (ТаблицаУслуги.Количество() > 1);
			Если (СводнаяСФ) Тогда
				Если (ЗначениеЗаполнено(ВедущийДокумент.КодВидаОперации)) Тогда
					СФОбъект.КодВидаОперации = ВедущийДокумент.КодВидаОперации;
				Иначе
					Если (ЕстьСобственные) Тогда
						Если (СФОбъект.Дата >= Дата(2016,7,1)) Тогда
							СФОбъект.КодВидаОперации = "15";
						Иначе
							СФОбъект.КодВидаОперации = "1;27";
						КонецЕсли; 
					Иначе
						СФОбъект.КодВидаОперации = "27";	
					КонецЕсли;
				КонецЕсли;
				
				// принудительное изменение признака
				СФОбъект.СводныйКомиссионный = Истина;
				_сф.ст_УстановитьСвойство(СФОбъект.ДополнительныеСвойства,"ОбновлятьРеквизитыПриЗаписи",Ложь);
				
				// это простая с\ф
			Иначе
				Если (ЗначениеЗаполнено(ВедущийДокумент.КодВидаОперации)) Тогда
					СФОбъект.КодВидаОперации = ВедущийДокумент.КодВидаОперации;
				КонецЕсли;
			КонецЕсли; // это сводная с\ф
		КонецЕсли; // применяется постановление №735 
		
		// чтобы с/ф нормально вставала на регистрацию в ЭДО, при том, что её несколько раз записывают и в нужный момент не выглядит новой (немодифицированной)
		ПодготовитьДокументОбъектДляЭДО(СФОбъект, Отказ, РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Неоперативный);
		
		// если ведущим документом является "ДоходыПоГрузоперевозке",
		// то заполняем платежно-расчетные документы..
		Если ТипЗнч(ВедущийДокумент) = Тип("ДокументСсылка.CW_ДоходыПоГрузоперевозке") Тогда
			Если ВедущийДокумент.ПорядокЗаполненияРасчётноПлатёжныхДокументовСФ = Перечисления.CW_ПорядокЗаполненияРасчётноПлатёжныхДокументовСФ.Автоматически
				ИЛИ ВедущийДокумент.ПорядокЗаполненияРасчётноПлатёжныхДокументовСФ = Перечисления.CW_ПорядокЗаполненияРасчётноПлатёжныхДокументовСФ.ПоДокументу
				Тогда 
				СФОбъект.ПлатежноРасчетныеДокументы.Загрузить(ВедущийДокумент.ПлатёжноРасчётныеДокументы.Выгрузить());
			КонецЕсли;
		КонецЕсли; 
		
		Попытка
			СФОбъект.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
			Сообщить("Запись с/ф """+строка(СФОбъект)+"""");
			Сообщить(ОписаниеОшибки());
			Отказ = Истина;
		КонецПопытки; 
	КонецЕсли; // установлен признак наличия с\ф 
	
	//Движения по регистру НДСНеоблагаемыеОперации
	ОбработатьДвиженияНДСНеоблагаемыеОперации(Источник, ВедущийДокумент); 
	//Движения по регистру НДСНеоблагаемыеОперации
	
	
КонецПроцедуры

Процедура ПроведениеКорректировкаРеализации(Источник, Отказ, РежимПроведения)
	
	//Для версии КОРП 
	ВестиУчетПоПодразделениям 	= ПолучитьФункциональнуюОпцию("ВестиУчетПоПодразделениям");
	//Для версии КОРП 
	
	ДатаНачалаВеденияУчета 			= CW_Настройки.ПолучитьДатуНачалаВеденияУчета(Источник.Организация);
	РежимВводНачальныхОстатков 		= ?(ДатаНачалаВеденияУчета = Неопределено, Ложь, (Источник.Дата < ДатаНачалаВеденияУчета));
	ВалютаРегламентированногоУчета 	= Константы.ВалютаРегламентированногоУчета.Получить();	
	
	// если не нашли ведущий документ, то выходим
	ВедущийДокумент = _сф.ст_ПолучитьСвойство(Источник.ДополнительныеСвойства,"ВедущийДокумент");
	Если (ВедущийДокумент = Неопределено) Тогда 
		Возврат; 
	КонецЕсли;
	Если (ВедущийДокумент.РучнаяКорректировка) Тогда
		Сообщить("Внимание! У ведущего документа "+Строка(ВедущийДокумент.Ссылка)+" установлен признак ручной корректировки движений!");
		Возврат;
	КонецЕсли;
	Если (Источник.РучнаяКорректировка) Тогда
		Сообщить("Внимание! У ведомого документа "+Строка(Источник.Ссылка)+" установлен признак ручной корректировки движений!");
		Возврат;
	КонецЕсли;
	
	// фикс
	Источник.Движения.Хозрасчетный.Записывать = Истина;
	
	// ---------------------------------------------------------------------------- 
	
	Счета = CW_Конфигурация.ПланСчетов();
	Субконто = CW_Конфигурация.ВидыСубконто();
	// --- 
	х62_1 	= Счета.РасчетыСПокупателями;
	х62_2 	= Счета.РасчетыПоАвансамПолученным;
	х62_21 	= Счета.РасчетыСПокупателямиВал;
	х62_22 	= Счета.РасчетыПоАвансамПолученнымВал;
	х62_31 	= Счета.РасчетыСПокупателямиУЕ;
	х62_32 	= Счета.РасчетыПоАвансамПолученнымУЕ;
	х76_5 	= Счета.РасчетыСПрочимиПоставщикамиИПодрядчиками;
	х76_25 	= Счета.РасчетыСПрочимиПоставщикамиИПодрядчикамиВал;
	х76_35 	= Счета.РасчетыСПрочимиПоставщикамиИПодрядчикамиУЕ;
	х76_6 	= Счета.РасчетыСПрочимиПокупателямиИЗаказчиками;
	х76_26 	= Счета.РасчетыСПрочимиПокупателямиИЗаказчикамиВал;
	х76_36 	= Счета.РасчетыСПрочимиПокупателямиИЗаказчикамиУЕ;
	х76НА 	= Счета.РасчетыНДСНалоговогоАгента;   
	х76К 	= Счета.КорректировкаРасчетовПрошлогоПериода;
	// --- 
	х91_01 = Счета.ПрочиеДоходы;
	х91_02 = Счета.ПрочиеРасходы;
	// --- 
	ВРУ = CW_Настройки.ВалютаРегламентированногоУчета();
	
	КорректируемыйДокумент = ВедущийДокумент.КорректируемыйДокумент;
	УП = CW_Настройки.ПараметрыУчетнойПолитики(КорректируемыйДокумент.Дата,Источник.Организация);
	СчетВозмещаемых_Рубли = УП.СчетРасчетов_Клиенты_Рубли;
	СчетВозмещаемых_Валюта = УП.СчетРасчетов_Клиенты_Валюта;
	СчетВозмещаемых_УЕ = УП.СчетРасчетов_Клиенты_УЕ;
	
	ЭтоВалюта = Ложь;
	ЭтоУЕ = Ложь;
	
	// фикс договора на 76.5 или 76.6
	МассивУдаляемыхДвижений = Новый Массив;
	Для каждого Движение Из Источник.Движения.Хозрасчетный Цикл
		
		Если (Движение.СчетКт = х76_25 ИЛИ Движение.СчетКт = х76_35) Тогда
			
			//Если (Движение.СчетКт = х76_25) Тогда
			//	ЭтоВалюта = Истина;
			//Иначе
			//	ЭтоУЕ = Истина;
			//КонецЕсли; 
			
			Движение.СчетКт = х76_5;
			Движение.ВалютаКт = Неопределено;
			Движение.ВалютнаяСуммаКт = 0;
			
		КонецЕсли; 
		Если (Движение.СчетКт = х76_26 ИЛИ Движение.СчетКт = х76_36) Тогда
			
			//Если (Движение.СчетКт = х76_26) Тогда
			//	ЭтоВалюта = Истина;
			//Иначе
			//	ЭтоУЕ = Истина;
			//КонецЕсли;
			
			Движение.СчетКт = х76_6;
			Движение.ВалютаКт = Неопределено;
			Движение.ВалютнаяСуммаКт = 0;
			
		КонецЕсли;
		// --- 
		// фикс счета взаиморасчетов для перевыставления
		Если (Движение.СчетКт = х76_5 ИЛИ Движение.СчетКт = х76_6) Тогда
			
			Если (Движение.СчетДт = х62_1) Тогда
				
				Движение.СчетДт = СчетВозмещаемых_Рубли;
				
			ИначеЕсли (Движение.СчетДт = х62_21) Тогда 
				
				Движение.СчетДт = СчетВозмещаемых_Валюта;
				
			ИначеЕсли (Движение.СчетДт = х62_31) Тогда 
				
				Движение.СчетДт = СчетВозмещаемых_УЕ; 
				
			КонецЕсли; 
			
		КонецЕсли; 
		// --- 
		// удаляем переоценку
		Если (Движение.СчетДт = х91_02 И (Движение.СчетКт = х76_5 ИЛИ Движение.СчетКт = х76_6)) Тогда
			МассивУдаляемыхДвижений.Добавить(Движение);
		КонецЕсли;
		Если (Движение.СчетКт = х91_01 И (Движение.СчетДт = х76_5 ИЛИ Движение.СчетДт = х76_6 ИЛИ Движение.СчетДт = х76_25 ИЛИ Движение.СчетДт = х76_26 ИЛИ Движение.СчетДт = х76_35 ИЛИ Движение.СчетДт = х76_36)) Тогда
			МассивУдаляемыхДвижений.Добавить(Движение);
		КонецЕсли;  
		
		//AFR-240203 - добавлено условие Движение.Сумма <> 0 
		Если Движение.СчетДт = х76К И Движение.СчетКт = х76К и Движение.Сумма <> 0 Тогда   
			//Удаляем проводки внутри корректировочного счета
			МассивУдаляемыхДвижений.Добавить(Движение);
		КонецЕсли;
		
		//AFR-240203 - добавлено условие Движение.Сумма <> 0 
		Если Движение.СчетДт = х76К И Движение.СчетКт <> х76К и Движение.Сумма <> 0 Тогда   
			//Удаляем проводки с корректировочного счета на счета учета взаиморасчетов
			МассивУдаляемыхДвижений.Добавить(Движение);
		КонецЕсли;
		
		//AFR-240203 - добавлено условие Движение.Сумма <> 0 
		Если Движение.СчетКт = х76К и Движение.Сумма <> 0 Тогда 
			//Подменяем проводку с корр.счета на транзитынй
			Движение.СчетКт  = ПланыСчетов.Хозрасчетный.НайтиПоКоду("76.05");	
		КонецЕсли;
		
		Если (Движение.СчетКт = х76_5 ИЛИ Движение.СчетКт = х76_6) Тогда
			Если (Движение.СчетДт = х62_1) Тогда
				Движение.СчетДт = СчетВозмещаемых_Рубли;
			ИначеЕсли (Движение.СчетДт = х62_21) Тогда 
				Движение.СчетДт = СчетВозмещаемых_Валюта;
			ИначеЕсли (Движение.СчетДт = х62_31) Тогда 
				Движение.СчетДт = СчетВозмещаемых_УЕ; 
			КонецЕсли; 
		КонецЕсли; 
		
		Если (Движение.СчетКт = х76_5 ИЛИ Движение.СчетКт = х76_6) Тогда 	 
			
			// меняем договор на учётный 
			Движение.СубконтоКт[Субконто.Контрагенты] = Источник.Контрагент;
			
			СтруктураПараметров = Новый Структура;
			СтруктураПараметров.Вставить("Договор", 			ВедущийДокумент.Договор);
			СтруктураПараметров.Вставить("ПриложениеКДоговору",	ВедущийДокумент.ПриложениеКДоговору);
			
			Движение.СубконтоКт[Субконто.Договоры] = CW_Финансы.ПолучитьУчетныйДоговор(СтруктураПараметров);
			
			// --- 
			Движение.СубконтоКт[Субконто.ДокументыРасчетовСКонтрагентами] = Неопределено;
			
		КонецЕсли; 	
		
		// удаляем движения по УСН.*
		Если (Движение.СчетДт.Родитель = Счета.УСНВспомогательныеСчета ИЛИ Движение.СчетКт.Родитель = Счета.УСНВспомогательныеСчета) Тогда
			МассивУдаляемыхДвижений.Добавить(Движение);
		КонецЕсли; 
		
	КонецЦикла;
	Если (МассивУдаляемыхДвижений.Количество() <> 0) Тогда
		_сф.к_УдалитьЭлементыПоМассиву(Источник.Движения.Хозрасчетный,МассивУдаляемыхДвижений);
	КонецЕсли;
	
	СформироватьДвиженияДляКорректировкиДоходов(ВедущийДокумент,Отказ);
	
	Если (ВедущийДокумент.ФормируетсяСчетФактура) Тогда
		
		СчетФактура = ВедущийДокумент.ВедомыйСчетФактураКорректировочный;
		
		СФОбъект 	= СчетФактура.ПолучитьОбъект();
		
		СФОбъект.ДокументОснование = Источник.Ссылка;
		СФОбъект.ДокументыОснования.Очистить();
		
		НСтр = СФОбъект.ДокументыОснования.Добавить();
		Нстр.ДокументОснование = Источник.Ссылка;
		
		СФОбъект.КодСпособаВыставления 	= ВедущийДокумент.КодСпособаВыставления;
		СФОбъект.Выставлен 				= Истина;
		СФОбъект.ДатаВыставления 		= Макс(ВедущийДокумент.ДатаАкта,ВедущийДокумент.ДатаСчетаФактуры);
		
		СФОбъект.ОпределениеПараметровСчетаФактурыНаРеализацию();
		
		СФОбъект.ОбменДанными.Загрузка	= Ложь;
		СФОбъект.ПометкаУдаления 		= Ложь;
		
		_сф.ст_УстановитьСвойство(СФОбъект.ДополнительныеСвойства,"ВедущийДокумент",ВедущийДокумент);
		
		CW_Документы.ПеренестиПризнакВосстановленияПоследовательности(Источник,СФОбъект);
		
		Попытка
			СФОбъект.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
			Сообщить("Запись с/ф """+строка(СФОбъект)+"""");
			Сообщить(ОписаниеОшибки());
			Отказ = Истина;
		КонецПопытки;
		
	КонецЕсли; 
	
КонецПроцедуры 

Процедура ПроведениеСписаниеСРасчетногоСчета(Источник, Отказ, РежимПроведения)
	
	//Для версии КОРП 
	ВестиУчетПоПодразделениям 	= ПолучитьФункциональнуюОпцию("ВестиУчетПоПодразделениям");
	//Для версии КОРП 
	
	ДатаНачалаВеденияУчета 			= CW_Настройки.ПолучитьДатуНачалаВеденияУчета(Источник.Организация);
	РежимВводНачальныхОстатков 		= ?(ДатаНачалаВеденияУчета = Неопределено, Ложь, (Источник.Дата < ДатаНачалаВеденияУчета));
	ВалютаРегламентированногоУчета 	= Константы.ВалютаРегламентированногоУчета.Получить();	
	
	Если Источник.ВидОперации =  Перечисления.ВидыОперацийСписаниеДенежныхСредств.ВозвратПокупателю Тогда
		Возврат;
	КонецЕсли;
	
	Если (Источник.ВидОперации <>  Перечисления.ВидыОперацийСписаниеДенежныхСредств.ОплатаПоставщику) Тогда
		//Проверим и удалим связанный документ
		ПометитьНаУдалениеСвязанныйДокументОплата(Источник);
		Возврат;
	КонецЕсли;
	
	Если Источник.РучнаяКорректировка Тогда
		Возврат;
	КонецЕсли; 
	
	// ---
	
	ЕстьДоговораБЭ = Ложь;
	ТаблицаДоговоров = Источник.РасшифровкаПлатежа.Выгрузить(,"ДоговорКонтрагента");
	ТаблицаДоговоров.Свернуть("ДоговорКонтрагента");
	Для каждого Стр Из ТаблицаДоговоров Цикл
		
		ВедущийДоговор = CW_Финансы.ПолучитьВедущийДоговор(Стр.ДоговорКонтрагента);
		Если (ВедущийДоговор <> Неопределено) Тогда
			ЕстьДоговораБЭ = Истина;      
		КонецЕсли; 
		
	КонецЦикла;
	Если (НЕ ЕстьДоговораБЭ) Тогда
		
		Возврат;
		
	КонецЕсли;
	
	// проверяем, что ведется ОУ по текущей организации
	СтруктураНастроек = CW_Настройки.ПолучитьНастройкиОперативногоУчета(Источник.Организация,Перечисления.CW_ВидыОперативнойЗадолженности.Кредиторская, Источник.Дата);
	
	ИспользуетсяОперативнаяЗадолженность 	= СтруктураНастроек["ВедетсяОперативныйУчет"];
	РаздельныйУчетЗадолженности 			= СтруктураНастроек["НастройкиОперативногоУчета"]["РаздельныйУчет"];
	
	Если Не РаздельныйУчетЗадолженности Тогда
		// пробуем найти ведомый
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		               |	CW_Оплата.Ссылка КАК Ссылка
		               |ИЗ
		               |	Документ.CW_Оплата КАК CW_Оплата
		               |ГДЕ
		               |	CW_Оплата.Основание = &Основание";
		Запрос.УстановитьПараметр("Основание", Источник.Ссылка);  
		РезультатЗапроса = Запрос.Выполнить();
		Выборка = РезультатЗапроса.Выбрать();
		Если Выборка.Следующий() Тогда
			
			CW_БухгалтерияЭкспедитораСервер.УстановитьОбщиеПараметрыПроведенияДокументов();
			
			Ведомый = Выборка.Ссылка.ПолучитьОбъект();
			// --- 
			CW_Документы.ПеренестиПризнакВосстановленияПоследовательности(Источник,Ведомый);
			// --- 
			Ведомый.ПометкаУдаления = Ложь;
			Ведомый.Дата = Источник.Дата;
			
			//Для версии КОРП
			Если ВестиУчетПоПодразделениям Тогда
				Ведомый.ПодразделениеОрганизации = Источник.ПодразделениеОрганизации;
			КонецЕсли;
			//Для версии КОРП
			
			// --- 
			
			СтруктураПараметров = Новый Структура;
			СтруктураПараметров.Вставить("Договор", 			Ведомый.Договор);
			СтруктураПараметров.Вставить("ПриложениеКДоговору",	Ведомый.ПриложениеКДоговору);
			
			ПроверяемыйДоговор = CW_Финансы.ПолучитьУчетныйДоговор(СтруктураПараметров);
			
			ПроверяемыйДоговорПрисутствует = (Источник.РасшифровкаПлатежа.Найти(ПроверяемыйДоговор,"ДоговорКонтрагента")<>Неопределено);
			Если ИспользуетсяОперативнаяЗадолженность И ПроверяемыйДоговорПрисутствует Тогда
				Если (Ведомый.Договор.ВзаиморасчетыВУЕ) Тогда
					Если (Источник.СуммаДокумента <> Ведомый.Оплата.Итог("Оплата_БВ")) Тогда
						Сообщить("Внимание! Отличаются суммы оплаты по бухгалтерскому и оперативному учёту.");
					КонецЕсли;
				Иначе
					Если (Источник.СуммаДокумента <> Ведомый.Оплата.Итог("Оплата")) Тогда
						Сообщить("Внимание! Отличаются суммы оплаты по бухгалтерскому и оперативному учёту.");
					КонецЕсли;
				КонецЕсли; 
			КонецЕсли; 
			Если НЕ ИспользуетсяОперативнаяЗадолженность Тогда
				Ведомый.Оплата.Очистить();
				Ведомый.ПометкаУдаления = Истина;
				Ведомый.Записать(РежимЗаписиДокумента.ОтменаПроведения);
			Иначе
				Если (Ведомый.Оплата.Количество()=0) Тогда
					Ведомый.ПометкаУдаления = Истина;
					Ведомый.Записать(РежимЗаписиДокумента.ОтменаПроведения);
				Иначе
					Ведомый.ДополнительныеСвойства.Вставить("ЗависимоеПроведение", Истина);
					Ведомый.Записать(РежимЗаписиДокумента.Проведение);		
				КонецЕсли; 
			КонецЕсли; 
			
		Иначе
			
			Если ИспользуетсяОперативнаяЗадолженность Тогда
				
				ЕстьДоговораБЭ = Ложь;
				ТаблицаДоговоров = Источник.РасшифровкаПлатежа.Выгрузить(,"ДоговорКонтрагента");
				ТаблицаДоговоров.Свернуть("ДоговорКонтрагента");
				Для каждого Стр Из ТаблицаДоговоров Цикл
					
					ВедущийДоговор = CW_Финансы.ПолучитьВедущийДоговор(Стр.ДоговорКонтрагента);
					Если (ВедущийДоговор <> Неопределено) Тогда
						ЕстьДоговораБЭ = Истина;						
					КонецЕсли; 
					
				КонецЦикла; 
				Если (ЕстьДоговораБЭ) Тогда
					Сообщить("По организации ведется учёт оперативной задолженности. Рекомендуется подобрать счета для оплаты.");	
				КонецЕсли; 
				
			КонецЕсли;
			
		КонецЕсли; 
	КонецЕсли; 
	
	// ---------------------------------------------------------------------------- 
	
	Счета = CW_Конфигурация.ПланСчетов();
	
	// налоговый агент
	Для каждого СтрокаДокумента Из Источник.РасшифровкаПлатежа Цикл
		
		Если (СтрокаДокумента.ДоговорКонтрагента.УчетАгентскогоНДС) Тогда
			
			// корректируем движение по 76.НА
			Если (ЗначениеЗаполнено(СтрокаДокумента.Сделка)) Тогда
				
				ДоговорБЭ = CW_Финансы.ПолучитьДоговорПриложение(СтрокаДокумента.ДоговорКонтрагента);
				Если ЗначениеЗаполнено(ДоговорБЭ) Тогда
					
					СтруктураПараметров = CW_Настройки.ПустаяСтруктураПолученияПараметровДоговора();
					СтруктураПараметров.Дата 				= Источник.Дата;
					СтруктураПараметров.Договор 			= ДоговорБЭ;
					
					ПараметрыДоговора	= CW_Настройки.ПолучитьПараметрыДоговора(СтруктураПараметров, "НалоговыйАгент_НДСЗаСчетСредствПоставщика");
					КомпенсацияНДС 		= ПараметрыДоговора.НалоговыйАгент_НДСЗаСчетСредствПоставщика;
					
					Если (КомпенсацияНДС) Тогда
						
						Запрос = Новый Запрос;
						Запрос.Текст = "ВЫБРАТЬ
						|	ХозрасчетныйОборотыДтКт.СуммаОборот КАК Сумма,
						|	ХозрасчетныйОборотыДтКт.ВалютнаяСуммаОборотДт КАК ВалютнаяСумма
						|ИЗ
						|	РегистрБухгалтерии.Хозрасчетный.ОборотыДтКт(
						|			,
						|			&КонецПериода,
						|			Регистратор,
						|			СчетДт = &СчетДт,
						|			&Субконто,
						|			СчетКт = &СчетКт,
						|			&ПустойМассив,
						|			СубконтоДт1 = &СубконтоДт3
						|				И Организация = &Организация) КАК ХозрасчетныйОборотыДтКт
						|ГДЕ
						|	ХозрасчетныйОборотыДтКт.Регистратор <> &Регистратор";
						Запрос.УстановитьПараметр("Субконто", ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.ДокументыРасчетовСКонтрагентами); 
						Запрос.УстановитьПараметр("ПустойМассив",Новый Массив);
						// --- 
						Запрос.УстановитьПараметр("КонецПериода", Источник.Дата); 
						// --- 
						Запрос.УстановитьПараметр("Организация", Источник.Организация);
						Запрос.УстановитьПараметр("Регистратор", Источник.Ссылка);
						Запрос.УстановитьПараметр("СубконтоДт3", СтрокаДокумента.Сделка); 
						Запрос.УстановитьПараметр("СчетДт", СтрокаДокумента.СчетУчетаРасчетовСКонтрагентом);  // 60.21
						Запрос.УстановитьПараметр("СчетКт", Счета.РасчетыНДСНалоговогоАгента); // 76.НА
						ТЗ = Запрос.Выполнить().Выгрузить();
						ВалютнаяСуммаНДС = ТЗ.Итог("ВалютнаяСумма");
						СуммаНДС = ТЗ.Итог("Сумма");
						// --- 
						ВРУ = CW_Настройки.ВалютаРегламентированногоУчета();
						ВалютаДокумента = СтрокаДокумента.ДоговорКонтрагента.ВалютаВзаиморасчетов;
						СК = CW_Финансы.ПолучитьКурсВалюты(СтрокаДокумента.ДоговорКонтрагента.ВалютаВзаиморасчетов,Источник.Дата);
						НоваяСумма = CW_Финансы.ПересчитатьИзВалютыВВалюту(ВалютнаяСуммаНДС,СтрокаДокумента.ДоговорКонтрагента.ВалютаВзаиморасчетов,ВРУ,СК.Курс,1,СК.Кратность,1);
						// --- 
						Счета = CW_Конфигурация.ПланСчетов();
						х1904 = Счета.НДСпоПриобретеннымУслугам;
						МассивУдаляемых = Новый Массив;
						Для каждого Движение Из Источник.Движения.Хозрасчетный Цикл
							Если (Движение.СчетДт = х1904) Тогда
								МассивУдаляемых.Добавить(Движение);
							КонецЕсли; 
						КонецЦикла; 
						_сф.к_УдалитьЭлементыПоМассиву(Источник.Движения.Хозрасчетный,МассивУдаляемых);
						// --- 
						Если (НоваяСумма - СуммаНДС <> 0) Тогда
							
							Источник.Движения.Хозрасчетный.Записывать = истина;
							Субконто = CW_Конфигурация.ВидыСубконто();
							Движение = Источник.Движения.Хозрасчетный.Добавить();
							Движение.Период = Источник.Дата;
							Движение.Организация = Источник.Организация;
							
							Движение.СчетДт = СтрокаДокумента.СчетУчетаРасчетовСКонтрагентом; // 60.21
							Движение.СубконтоДт[Субконто.Контрагенты] = Источник.Контрагент;
							Движение.СубконтоДт[Субконто.Договоры] = СтрокаДокумента.ДоговорКонтрагента;
							Движение.СубконтоДт[Субконто.ДокументыРасчетовСКонтрагентами] = СтрокаДокумента.Сделка;
							Движение.ВалютаДт = ВалютаДокумента;
							//Движение.ВалютнаяСуммаДт = НДС_Валюта;
							
							//Для версии КОРП
							Если ВестиУчетПоПодразделениям Тогда
								Если Движение.СчетДт.УчетПоПодразделениям Тогда
									Движение.ПодразделениеДт = Источник.ПодразделениеОрганизации;
								КонецЕсли;
							КонецЕсли;
							//Для версии КОРП
							
							// --- 
							Движение.СчетКт = Счета.РасчетыНДСНалоговогоАгента; // 76.НА
							Движение.СубконтоКт[Субконто.Контрагенты] = Источник.Контрагент;
							Движение.СубконтоКт[Субконто.Договоры] = СтрокаДокумента.ДоговорКонтрагента;
							
							//Для версии КОРП
							Если ВестиУчетПоПодразделениям Тогда
								Если Движение.СчетКт.УчетПоПодразделениям Тогда
									Движение.ПодразделениеКт = Источник.ПодразделениеОрганизации;
								КонецЕсли;
							КонецЕсли;
							//Для версии КОРП
							
							// --- 
							Движение.Сумма = (НоваяСумма - СуммаНДС);
							
						КонецЕсли; 
						
					КонецЕсли; 
					
					
				КонецЕсли; 
				
				
			КонецЕсли; 
			
		КонецЕсли; 	
		
	КонецЦикла; 
	
	
КонецПроцедуры

Процедура ПроведениеПоступлениеНаРасчетныйСчет(Источник, Отказ, РежимПроведения)     
	
	Если ТипЗнч(Источник) <> Тип("ДокументОбъект.ПоступлениеНаРасчетныйСчет") Тогда 
		Возврат; 
	КонецЕсли;
	
	ВидОперативнойЗадолженности = Перечисления.CW_ВидыОперативнойЗадолженности.Дебиторская;
	
	СтруктураНастроек = CW_Настройки.ПолучитьНастройкиОперативногоУчета(Источник.Организация, ВидОперативнойЗадолженности, Источник.Дата);

	Если НЕ СтруктураНастроек["ВедетсяОперативныйУчет"]
		ИЛИ СтруктураНастроек["НастройкиОперативногоУчета"]["РаздельныйУчет"] Тогда
		//Оперативная задолженность не ведется
		Возврат;
	КонецЕсли; 
	
	//Для версии КОРП 
	ВестиУчетПоПодразделениям 	= ПолучитьФункциональнуюОпцию("ВестиУчетПоПодразделениям");
	//Для версии КОРП 
	
	ДатаНачалаВеденияУчета 			= CW_Настройки.ПолучитьДатуНачалаВеденияУчета(Источник.Организация);
	РежимВводНачальныхОстатков 		= ?(ДатаНачалаВеденияУчета = Неопределено, Ложь, (Источник.Дата < ДатаНачалаВеденияУчета));
	ВалютаРегламентированногоУчета 	= Константы.ВалютаРегламентированногоУчета.Получить();	
	
	Если Источник.ВидОперации =  Перечисления.ВидыОперацийПоступлениеДенежныхСредств.ВозвратОтПоставщика Тогда
		Возврат;
	КонецЕсли;
	
	// обрабатываем только поступления от покупателей без ручной корректировки
	Если Источник.ВидОперации <>  Перечисления.ВидыОперацийПоступлениеДенежныхСредств.ОплатаПокупателя Тогда
		//Проверим и удалим связанный документ
		ПометитьНаУдалениеСвязанныйДокументОплата(Источник);
		Возврат;
	КонецЕсли;
	
	Если Источник.РучнаяКорректировка Тогда
		Возврат;
	КонецЕсли; 
	
	// прооверим, что учетный договор связан с договором по грузоперевозкам
	ЕстьДоговораБЭ = Ложь;
	ТаблицаДоговоров = Источник.РасшифровкаПлатежа.Выгрузить(,"ДоговорКонтрагента");
	ТаблицаДоговоров.Свернуть("ДоговорКонтрагента");
	Для каждого Стр Из ТаблицаДоговоров Цикл
		ВедущийДоговор = CW_Финансы.ПолучитьВедущийДоговор(Стр.ДоговорКонтрагента);
		Если (ВедущийДоговор <> Неопределено) Тогда
			ЕстьДоговораБЭ = Истина;      
		КонецЕсли; 
	КонецЦикла;
	Если (НЕ ЕстьДоговораБЭ) Тогда
		Возврат;
	КонецЕсли;
	
	// включаем возможность корректировки движений
	Источник.Движения.Хозрасчетный.Записывать 				= Истина;
	Источник.Движения.КнигаУчетаДоходовИРасходов.Записывать = Истина;
	
	// получим дополнительные свойства
	ДС = _сф.ДС(Источник);
	Ведомый = Неопределено;
	
	// для УСН корректируем движения по регистрам
	ДействуетУСН = (CW_Настройки.ПараметрГлобальнойУчетнойПолитики(Источник.Дата,Источник.Организация,"СистемаНалогообложения")=Перечисления.СистемыНалогообложения.Упрощенная);
	Если (ДействуетУСН) Тогда
		ДетализироватьЗаписиКУДиР = CW_Настройки.ПараметрУчетнойПолитики(Источник.Дата,Источник.Организация,"ДетализироватьЗаписиКУДиР");
	Иначе
		ДетализироватьЗаписиКУДиР = Ложь;
	КонецЕсли; 
	
	СтруктураНастроек = CW_Настройки.ПолучитьНастройкиОперативногоУчета(Источник.Организация, Перечисления.CW_ВидыОперативнойЗадолженности.Дебиторская, Источник.Дата);
	
	ИспользуетсяОперативнаяЗадолженность 	= СтруктураНастроек["ВедетсяОперативныйУчет"];
	РаздельныйУчетЗадолженности 			= СтруктураНастроек["НастройкиОперативногоУчета"]["РаздельныйУчет"];
	
	#Область Проверка_Оплат

	Если Не ИспользуетсяОперативнаяЗадолженность Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ РаздельныйУчетЗадолженности Тогда
		
		// проверяем, что ведомый заполнен
		// пробуем найти ведомый
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	CW_Оплата.Ссылка
		|ИЗ
		|	Документ.CW_Оплата КАК CW_Оплата
		|ГДЕ
		|	CW_Оплата.Основание = &Основание";
		
		Запрос.УстановитьПараметр("Основание", Источник.Ссылка);
		
		Выборка = запрос.Выполнить().Выбрать();
		
		Если Выборка.Количество() > 1 Тогда
			Отказ = истина;
			
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "ВНИМАНИЕ! ОШИБКА! Более одного документа Оплата связано с текущим документом!";
			Сообщение.Сообщить();
			Возврат;
			
		ИначеЕсли   Выборка.Количество() = 0 Тогда
			
			ЕстьДоговораБЭ = Ложь;
			ТаблицаДоговоров = Источник.РасшифровкаПлатежа.Выгрузить(,"ДоговорКонтрагента");
			ТаблицаДоговоров.Свернуть("ДоговорКонтрагента");
			Для каждого Стр Из ТаблицаДоговоров Цикл
				ВедущийДоговор = CW_Финансы.ПолучитьВедущийДоговор(Стр.ДоговорКонтрагента);
				Если (ВедущийДоговор <> Неопределено) Тогда
					ЕстьДоговораБЭ = Истина;						
				КонецЕсли; 
			КонецЦикла; 
			
			Если ИспользуетсяОперативнаяЗадолженность и Не РаздельныйУчетЗадолженности Тогда
				
				Если ЕстьДоговораБЭ Тогда
					Сообщить("По организации ведется учёт оперативной задолженности. Рекомендуется подобрать счета для оплаты.");	
				КонецЕсли; 
				
			ИначеЕсли ДействуетУСН  и ЕстьДоговораБЭ Тогда
				
				Ведомый = Документы.CW_Оплата.СоздатьДокумент();
				Ведомый.Дата 					= Источник.Дата;
				Ведомый.Организация 			= Источник.Организация;
				
				//Для версии КОРП
				Если ВестиУчетПоПодразделениям Тогда
					Ведомый.ПодразделениеОрганизации = Источник.ПодразделениеОрганизации;
				КонецЕсли;
				//Для версии КОРП
				
				Ведомый.Контрагент 				= Источник.Контрагент;
				Ведомый.Договор 				= ВедущийДоговор;  //????
				Ведомый.Валюта 					= Источник.ВалютаДокумента;
				Ведомый.Основание 				= Источник.Ссылка;
				Ведомый.ВидЗадолженности		= Перечисления.CW_ВидыОперативнойЗадолженности.Дебиторская;
				Ведомый.Комментарий 			= "Сформирован автоматически для целей отражения оплат по УСН";
				//Ведомый.ОбменДанными.Загрузка 	= Истина;
				Ведомый.ДополнительныеСвойства.Вставить("ЗависимоеПроведение", Истина);
				Ведомый.Записать(РежимЗаписиДокумента.Проведение);
				
			КонецЕсли;
			
		Иначе // Выборка.Количество() = 1 Тогда

			CW_БухгалтерияЭкспедитораСервер.УстановитьОбщиеПараметрыПроведенияДокументов();
			
			Выборка.Следующий();
			
			//Обрабатываем имеющийся документ
			Ведомый = Выборка.Ссылка.ПолучитьОбъект();
			
			CW_Документы.ПеренестиПризнакВосстановленияПоследовательности(Источник,Ведомый);
			
			//Для версии КОРП
			Если ВестиУчетПоПодразделениям Тогда
				Ведомый.ПодразделениеОрганизации = Источник.ПодразделениеОрганизации;
			КонецЕсли;
			//Для версии КОРП
			
			СтруктураПараметров = Новый Структура;
			СтруктураПараметров.Вставить("Договор", 			Ведомый.Договор);
			СтруктураПараметров.Вставить("ПриложениеКДоговору",	Ведомый.ПриложениеКДоговору);
			
			ПроверяемыйДоговор = CW_Финансы.ПолучитьУчетныйДоговор(СтруктураПараметров);
			
			ПроверяемыйДоговорПрисутствует 	= (Источник.РасшифровкаПлатежа.Найти(ПроверяемыйДоговор,"ДоговорКонтрагента") <> Неопределено);
			
			Если ИспользуетсяОперативнаяЗадолженность и ПроверяемыйДоговорПрисутствует Тогда
				
				Если (Ведомый.Договор.ВзаиморасчетыВУЕ) Тогда
					Если (Источник.СуммаДокумента <> Ведомый.Оплата.Итог("Оплата_БВ")) Тогда
						Сообщить("Внимание! Отличаются суммы оплаты по бухгалтерскому и оперативному учёту.");
					КонецЕсли;
				Иначе
					Если (Источник.СуммаДокумента <> Ведомый.Оплата.Итог("Оплата")) Тогда
						Сообщить("Внимание! Отличаются суммы оплаты по бухгалтерскому и оперативному учёту.");
					КонецЕсли;
				КонецЕсли; 
				
			ИначеЕсли ДействуетУСН  Тогда
				
				Если  Источник.РасшифровкаПлатежа.Количество() > 0 Тогда
					ВедущийДоговор_УСН = CW_Финансы.ПолучитьВедущийДоговор(Источник.РасшифровкаПлатежа[0].ДоговорКонтрагента);
				Иначе
					ВедущийДоговор_УСН = Справочники.CW_ДоговорыПоГрузоперевозкам.ПустаяСсылка();
				КонецЕсли;
				//Для УСН шапку документа перезаполняем.
				Ведомый.ПометкаУдаления 		= Ложь;
				Ведомый.Дата 					= Источник.Дата;
				Ведомый.Организация 			= Источник.Организация;
				Ведомый.Контрагент 				= Источник.Контрагент;
				Ведомый.Договор 				= ВедущийДоговор_УСН;
				Ведомый.Валюта 					= Источник.ВалютаДокумента;
				Ведомый.Основание 				= Источник.Ссылка;
				Ведомый.ВидЗадолженности		= Перечисления.CW_ВидыОперативнойЗадолженности.Дебиторская;
				Ведомый.Комментарий 			= "Сформирован автоматически для целей отражения оплат по УСН";
				
			КонецЕсли; 
			
			Ведомый.ДополнительныеСвойства.Вставить("ЗависимоеПроведение", Истина);
			
			Ведомый.Записать(РежимЗаписиДокумента.Проведение);		
			
		КонецЕсли;
		
	КонецЕсли;
	
	#КонецОбласти
	
	#Область УСН 
	
	Если НЕ РаздельныйУчетЗадолженности и Ведомый <> Неопределено Тогда
		
		НЗ_ОплатыУСН = _сф.НаборЗаписейПоРегистратору(РегистрыНакопления.CW_ОплатыПокупателейУСН,Ведомый.Ссылка); 
		НЗ_РаспределениеОплатУСН = _сф.НаборЗаписейПоРегистратору(РегистрыСведений.CW_РаспределениеОплатПокупателейУСН,Ведомый.Ссылка); 
		
		ТребуетсяОтражениеВУСН = Ложь;
		
		// проверяем, что по организации установлена дата начала ведения учета
		ДатаНачалаВеденияУчета = CW_Настройки.ПолучитьДатуНачалаВеденияУчета(Источник.Организация);
		Если (ДатаНачалаВеденияУчета <> Неопределено) Тогда
			Если (Источник.Дата > ДатаНачалаВеденияУчета) Тогда
				ТребуетсяОтражениеВУСН = Истина;
			КонецЕсли; 
		КонецЕсли; 
		
		Если (ДействуетУСН И ТребуетсяОтражениеВУСН И Источник.ВидОперации = Перечисления.ВидыОперацийПоступлениеДенежныхСредств.ОплатаПокупателя) Тогда
			
			Платежка = Источник.Ссылка;
			Счета = CW_Конфигурация.ПланСчетов(); 
			Субконто = CW_Конфигурация.ВидыСубконто(); 
			
			#Область СчетаНастройки
			
			х76_5 = Счета.РасчетыСПрочимиПоставщикамиИПодрядчиками;
			х76_6 = Счета.РасчетыСПрочимиПокупателямиИЗаказчиками;
			х62_1 = Счета.РасчетыСПокупателями;
			х62_2 = Счета.РасчетыПоАвансамПолученным;
			х62_21 = Счета.РасчетыСПокупателямиВал;
			х62_22 = Счета.РасчетыПоАвансамПолученнымВал;
			х62_31 = Счета.РасчетыСПокупателямиУЕ;
			х62_32 = Счета.РасчетыПоАвансамПолученнымУЕ;
			х90_1_1 = Счета.ВыручкаНеЕНВД;
			х90_1_2 = Счета.ВыручкаЕНВД;
			х90_2_1 = Счета.СебестоимостьПродажНеЕНВД;
			х90_2_2 = Счета.СебестоимостьПродажЕНВД;
			х90_3 = Счета.Продажи_НДС;
			х68_2 = Счета.НДС;
			
			хУСН_1 = Счета.УСНРасчетыСПокупателямиЕНВД;
			хУСН_21 = Счета.УСНРасчетыСПокупателямиВалЕНВД;
			хУСН_2 = Счета.УСНРасчетыСПокупателямиКомитент;
			хУСН_22 = Счета.УСНРасчетыСПокупателямиВалКомитент;
			
			// получаем настройки
			ВРУ = CW_Настройки.ВалютаРегламентированногоУчета();
			СчетРасчетовПоВозмещаемым_Рубли = CW_Настройки.ПараметрУчетнойПолитики(Источник.Дата,Источник.Организация,"СчетРасчетов_Клиенты_Рубли");
			СчетРасчетовПоВозмещаемым_Валюта = CW_Настройки.ПараметрУчетнойПолитики(Источник.Дата,Источник.Организация,"СчетРасчетов_Клиенты_Валюта");
			СчетРасчетовПоВозмещаемым_УЕ = CW_Настройки.ПараметрУчетнойПолитики(Источник.Дата,Источник.Организация,"СчетРасчетов_Клиенты_УЕ");
			
			#КонецОбласти 
			
			#Область ОчищаемДвижения 
			
			// очищаем движения по КУДР
			Источник.Движения.КнигаУчетаДоходовИРасходов.Очистить();
			
			ОчередьУдаления = Новый Массив;
			Для каждого Движение Из Источник.Движения.Хозрасчетный Цикл
				
				// удаляем движения по УСН.*
				Если (Движение.СчетДт.Родитель = Счета.УСНВспомогательныеСчета ИЛИ Движение.СчетКт.Родитель = Счета.УСНВспомогательныеСчета) Тогда
					ОчередьУдаления.Добавить(Движение);
				КонецЕсли; 
			КонецЦикла;
			_сф.к_УдалитьЭлементыПоМассиву(Источник.Движения.Хозрасчетный,ОчередьУдаления);
			
			#КонецОбласти 
			
			// определяем договоры
			ТаблицаРасшифровки = Источник.РасшифровкаПлатежа.Выгрузить();
			Договоры = _сф.м_СоздатьИзКолонкиТЗ(ТаблицаРасшифровки,"ДоговорКонтрагента");
			
			// движения по регистру оплат УСН
			Если (Договоры.Количество() > 1) Тогда
				Отказ = Истина;
				Сообщить("Оплата должна производиться по одному договору!");
				Возврат;
			КонецЕсли; 
			
			Для каждого Договор Из Договоры Цикл
				
				// определяем порядок зачета авансов для УСН
				Отбор = Новый Структура("ДоговорКонтрагента",Договор);
				ТПОА = Источник.РасшифровкаПлатежа.Выгрузить(Отбор,"ПорядокОтраженияАванса");
				ТПОА.Свернуть("ПорядокОтраженияАванса");
				Если (ТПОА.Количество() > 1) Тогда
					Отказ = Истина;
					Сообщить("Для договора должен быть указан один порядок отражения авансов для целей УСН");
					Возврат;
					
				ИначеЕсли (ТПОА.Количество() = 0) Тогда 
					
					Отказ = Истина;
					Сообщить("Для договора не указан один порядок отражения авансов для целей УСН");
					Возврат;
					
				ИначеЕсли (ТПОА.Количество() = 1) Тогда 
					
					ПорядокОтраженияАванса = ТПОА[0].ПорядокОтраженияАванса;
					Если (НЕ ЗначениеЗаполнено(ПорядокОтраженияАванса)) Тогда
						ПорядокОтраженияАванса=Перечисления.ПорядокОтраженияАвансов.ДоходУСН;
					КонецЕсли;
					
				КонецЕсли; 
				
				#Область ПараметрыДоговора 
				
				// определяем вид расчетов по договору
				ВалютныеРасчеты = (Договор.ВалютаВзаиморасчетов <> ВРУ);
				РасчетыУЕ = Договор.РасчетыВУсловныхЕдиницах;
				
				ОтдельныйСчетПоПеревыставляемым = Ложь;
				Если НЕ ВалютныеРасчеты Тогда
					ОтдельныйСчетПоПеревыставляемым = (СчетРасчетовПоВозмещаемым_Рубли <> х62_1); 
					СчетПоПеревыставляемым = СчетРасчетовПоВозмещаемым_Рубли;
					СчетАвансовПоСобственным = х62_2;
				Иначе
					Если НЕ РасчетыУЕ Тогда
						ОтдельныйСчетПоПеревыставляемым = (СчетРасчетовПоВозмещаемым_Валюта <> х62_21); 
						СчетПоПеревыставляемым = СчетРасчетовПоВозмещаемым_Валюта;
						СчетАвансовПоСобственным = х62_22;
					Иначе
						ОтдельныйСчетПоПеревыставляемым = (СчетРасчетовПоВозмещаемым_УЕ <> х62_31); 
						СчетПоПеревыставляемым = СчетРасчетовПоВозмещаемым_УЕ;
						СчетАвансовПоСобственным = х62_32;
					КонецЕсли; 
				КонецЕсли; 
				
				#КонецОбласти 
				
				ТО = _сф.т_Создать("Договор,ДокументОплаты,СчетЗадолженности,СчетАванса,ВалютнаяСумма,Сумма,СуммаДУ,СуммаДК,СуммаДЕ,НДС,ПризнакОплаты,Аналитика,ПредставлениеАналитики");
				
				// анализируем проводки (как раньше)
				// формируем таблицу оплат для целей УСН
				СоставОплат = _сф.т_Создать("Договор,СчетАванса,ПризнакОплаты,Аналитика,Оплата,Оплата_БВ,Аванс,Аванс_БВ,СуммаНеЕНВД,СуммаНеЕНВД_БВ,СуммаЕНВД,СуммаЕНВД_БВ,СуммаПеревыставляемых,СуммаПеревыставляемых_БВ,СуммаАвансовПоПеревыставляемым,СуммаАвансовПоПеревыставляемым_БВ,СуммаАвансовПоЕНВД,СуммаАвансовПоЕНВД_БВ");
				Для каждого Движение Из Источник.Движения.Хозрасчетный Цикл
					
					// оплата по счету собственных
					// требуется определить соотношение ЕНВД/неЕНВД/перевыставление
					Если (Движение.СчетКт = х62_1 ИЛИ Движение.СчетКт = х62_21 ИЛИ Движение.СчетКт = х62_31) И (Движение.СчетДт <> Счета.ПрочиеРасходы) Тогда
						
						Если Движение.СубконтоКт[Субконто.Договоры]=Договор Тогда 
							
							Нстр = СоставОплат.Добавить();
							Нстр.Договор = Договор;
							Нстр.СчетАванса = CW_Финансы.СчетАванса(Движение.СчетКт);
							Нстр.ПризнакОплаты = Истина;
							Нстр.Аналитика = Движение.СубконтоКт[Субконто.ДокументыРасчетовСКонтрагентами];
							
							// если рубли - передаём сумму движения, иначе - валютную сумму
							Если ВалютныеРасчеты Тогда
								Нстр.Оплата = Движение.ВалютнаяСуммаКт;
								Нстр.Оплата_БВ = Движение.Сумма;
							Иначе
								Нстр.Оплата = Движение.Сумма;
								Нстр.Оплата_БВ = Движение.Сумма;
							КонецЕсли;  
							
							Нстр.Аванс = 0;
							Нстр.Аванс_БВ = 0;
							
							Распределение = РаспределениеОплаты(Движение.СубконтоКт[Субконто.ДокументыРасчетовСКонтрагентами],Нстр.Оплата,ОтдельныйСчетПоПеревыставляемым);
							
							Нстр.СуммаНеЕНВД = Распределение.СуммаНеЕНВД;
							Нстр.СуммаНеЕНВД_БВ = 0;
							
							Нстр.СуммаЕНВД = Распределение.СуммаЕНВД;
							Нстр.СуммаЕНВД_БВ = Нстр.Оплата_БВ*Нстр.СуммаЕНВД/Нстр.Оплата;
							
							Нстр.СуммаПеревыставляемых = Распределение.СуммаПеревыставляемых;
							Нстр.СуммаПеревыставляемых_БВ = Нстр.Оплата_БВ*Нстр.СуммаПеревыставляемых/Нстр.Оплата;
							
							Нстр.СуммаАвансовПоПеревыставляемым = 0;
							Нстр.СуммаАвансовПоПеревыставляемым_БВ = 0;
							
							Нстр.СуммаАвансовПоЕНВД = 0;
							Нстр.СуммаАвансовПоЕНВД_БВ = 0;
							
						КонецЕсли;
						
					КонецЕсли; 
					
					// аванс по счету собственных
					Если (Движение.СчетКт = х62_2 ИЛИ Движение.СчетКт = х62_22 ИЛИ Движение.СчетКт = х62_32) Тогда
						
						Если Движение.СубконтоКт[Субконто.Договоры]=Договор Тогда 
							
							Нстр = СоставОплат.Добавить();
							Нстр.Договор = Договор;
							Нстр.СчетАванса = Движение.СчетКт;
							Нстр.ПризнакОплаты = Ложь;
							Нстр.Аналитика = Документы.РеализацияТоваровУслуг.ПустаяСсылка();
							
							Нстр.Оплата = 0;
							Нстр.Оплата_БВ = 0;
							
							Если НЕ ВалютныеРасчеты Тогда
								Нстр.Аванс = Движение.Сумма;
								Нстр.Аванс_БВ = Движение.Сумма;
							Иначе
								Нстр.Аванс = Движение.ВалютнаяСуммаКт;
								Нстр.Аванс_БВ = Движение.Сумма;
							КонецЕсли;
							
							Нстр.СуммаНеЕНВД = 0;
							Нстр.СуммаНеЕНВД_БВ = 0;
							
							Нстр.СуммаЕНВД = 0;
							Нстр.СуммаЕНВД_БВ = 0;
							
							Нстр.СуммаПеревыставляемых = 0;
							Нстр.СуммаПеревыставляемых_БВ = 0;
							
							// настройка шапки позволяет определить отражение по НУ как доход ЕНВД
							// или как доход комитента, но доход комитента имеет смысл только без разделения счетов расчетов
							
							Если ПорядокОтраженияАванса = Перечисления.ПорядокОтраженияАвансов.ДоходУСН Тогда
								
								Нстр.СуммаАвансовПоЕНВД = 0;
								Нстр.СуммаАвансовПоЕНВД_БВ = 0;
								
								Нстр.СуммаАвансовПоПеревыставляемым = 0;
								Нстр.СуммаАвансовПоПеревыставляемым_БВ = 0;
								
							ИначеЕсли ПорядокОтраженияАванса = Перечисления.ПорядокОтраженияАвансов.ДоходЕНВД Тогда 
								
								Нстр.СуммаАвансовПоЕНВД = Нстр.Аванс;
								Нстр.СуммаАвансовПоЕНВД_БВ = Нстр.Аванс_БВ;
								
								Нстр.СуммаАвансовПоПеревыставляемым = 0;
								Нстр.СуммаАвансовПоПеревыставляемым_БВ = 0; 
								
							ИначеЕсли ПорядокОтраженияАванса = Перечисления.ПорядокОтраженияАвансов.ДоходКомитента Тогда 
								
								Нстр.СуммаАвансовПоЕНВД = 0;
								Нстр.СуммаАвансовПоЕНВД_БВ = 0;
								
								Нстр.СуммаАвансовПоПеревыставляемым = Нстр.Аванс;
								Нстр.СуммаАвансовПоПеревыставляемым_БВ = Нстр.Аванс_БВ; 
								
							КонецЕсли; 
						КонецЕсли;
					КонецЕсли; 
					
					// по перевыставляемым
					Если ОтдельныйСчетПоПеревыставляемым Тогда
						
						Если Движение.СчетКт = СчетПоПеревыставляемым Тогда
							
							Если Движение.СубконтоКт[Субконто.Договоры]=Договор Тогда
								
								ЭтоАванс = (Движение.СубконтоКт[Субконто.ДокументыРасчетовСКонтрагентами]=Платежка);
								
								Если ЭтоАванс Тогда
									
									Нстр = СоставОплат.Добавить();
									Нстр.Договор = Договор;
									Нстр.СчетАванса = Движение.СчетКт;
									Нстр.ПризнакОплаты = Ложь;
									Нстр.Аналитика = Документы.РеализацияТоваровУслуг.ПустаяСсылка();
									
									Нстр.Оплата = 0;
									Нстр.Оплата_БВ = 0;
									Если НЕ ВалютныеРасчеты Тогда
										Нстр.Аванс = Движение.Сумма;
										Нстр.Аванс_БВ = Движение.Сумма;
									Иначе
										Нстр.Аванс = Движение.ВалютнаяСуммаКт;
										Нстр.Аванс_БВ = Движение.Сумма;
									КонецЕсли;
									
									Нстр.СуммаНеЕНВД = 0;
									Нстр.СуммаНеЕНВД_БВ = 0;
									
									Нстр.СуммаЕНВД = 0;
									Нстр.СуммаЕНВД_БВ = 0;
									
									Нстр.СуммаПеревыставляемых = 0;
									Нстр.СуммаПеревыставляемых_БВ = 0;
									
									Нстр.СуммаАвансовПоЕНВД = 0;
									Нстр.СуммаАвансовПоЕНВД_БВ = 0;
									
									Нстр.СуммаАвансовПоПеревыставляемым = Нстр.Аванс;
									Нстр.СуммаАвансовПоПеревыставляемым_БВ = Нстр.Аванс_БВ;
									
								КонецЕсли; 
								
								Если НЕ ЭтоАванс Тогда
									
									Нстр = СоставОплат.Добавить();
									Нстр.Договор = Договор;
									Нстр.СчетАванса = Движение.СчетКт;
									Нстр.ПризнакОплаты = Истина;
									Нстр.Аналитика = Движение.СубконтоКт[Субконто.ДокументыРасчетовСКонтрагентами];
									
									// если рубли - передаём сумму движения, иначе - валютную сумму
									Если ВалютныеРасчеты Тогда
										Нстр.Оплата = Движение.ВалютнаяСуммаКт;
										Нстр.Оплата_БВ = Движение.Сумма;
									Иначе
										Нстр.Оплата = Движение.Сумма;
										Нстр.Оплата_БВ = Движение.Сумма;
									КонецЕсли;
									Нстр.Аванс = 0;
									Нстр.Аванс_БВ = 0;
									
									Нстр.СуммаНеЕНВД = 0;
									Нстр.СуммаНеЕНВД_БВ = 0;
									
									Нстр.СуммаЕНВД = 0;
									Нстр.СуммаЕНВД_БВ = 0;
									
									Нстр.СуммаПеревыставляемых = Нстр.Оплата;
									Нстр.СуммаПеревыставляемых_БВ = Нстр.Оплата_БВ;
									
									Нстр.СуммаАвансовПоПеревыставляемым = 0;
									Нстр.СуммаАвансовПоПеревыставляемым_БВ = 0;
									
								КонецЕсли; 
							КонецЕсли;
						КонецЕсли;
					КонецЕсли; 
				КонецЦикла;     
				
				СоставОплат.Свернуть("Договор,СчетАванса,Аналитика,ПризнакОплаты","Оплата,Оплата_БВ,Аванс,Аванс_БВ,СуммаЕНВД,СуммаЕНВД_БВ,СуммаПереВыставляемых,СуммаПеревыставляемых_БВ,СуммаАвансовПоПеревыставляемым,СуммаАвансовПоПеревыставляемым_БВ,СуммаАвансовПоЕНВД,СуммаАвансовПоЕНВД_БВ");
				
				Если (ИспользуетсяОперативнаяЗадолженность) Тогда
					
					// заполняем таблицу по ведомому документу
					// все строки документа оплаты при проведении группируются на оплаты и аванс
					// соответственно, распределеять по счетам необходимо (общая сумма - сумма оплат)
					
					ТаблицаДокументаОплаты = Ведомый.Оплата.Выгрузить(); 
					
					//В случае валютных расчетов сумму НДС пересчитываем в рубли
					Если ВалютныеРасчеты и Не РасчетыУЕ Тогда 
						ДанныеКурса = CW_Финансы.ПолучитьКурсВалюты(Ведомый.Валюта, Ведомый.Дата);
						Для Каждого СтрокаТаблицы из ТаблицаДокументаОплаты Цикл
							СтрокаТаблицы.НДС = Окр(СтрокаТаблицы.НДС * ДанныеКурса.Курс / ДанныеКурса.Кратность, 2);	
						КонецЦикла;
					КонецЕсли;
					
					ТаблицаДокументаОплаты.Колонки.Добавить("ПризнакОплаты");
					Для каждого Стр Из ТаблицаДокументаОплаты Цикл
						Стр.ПризнакОплаты = ?(Стр.Акт <> Документы.CW_ДоходыПоГрузоперевозке.ПустаяСсылка(),Истина,Ложь);
					КонецЦикла; 
					
					// провераяем авансы
					ТаблицаАвансовПоПроводкам = СоставОплат.Скопировать(Новый Структура("ПризнакОплаты",Ложь));
					ТаблицаАвансовПоПроводкам.Свернуть("СчетАванса","Аванс,Аванс_БВ");
					Для каждого Стр Из ТаблицаАвансовПоПроводкам Цикл
						Отбор = Новый Структура("ПризнакОплаты,СчетАванса",Ложь,Стр.СчетАванса);
						ТаблицаАвансовПоСчету = ТаблицаДокументаОплаты.Скопировать(Отбор);
						
						ИтогПоТаблицеАвансов = _сф.Итог(ТаблицаАвансовПоСчету,"Оплата");
						ИтогПоТаблицеАвансов_БВ = _сф.Итог(ТаблицаАвансовПоСчету,"Оплата_БВ");
						Если (ИтогПоТаблицеАвансов <> Стр.Аванс) Тогда
							
							Отказ = Истина;
							Сообщить("Ошибка в механизме распределения: отличается сумма авансов по счету аванса по данным документа оплаты и по проводкам.");
							Возврат;
							
						Иначе
							Если (ИтогПоТаблицеАвансов_БВ <> Стр.Аванс) Тогда
								
								СтрокиАвансовПоСчету = _сф.к_НайтиСтроки(ТаблицаДокументаОплаты,Отбор);
								// ... (требуется корректировка сумм в базовой валюте)
								
							КонецЕсли; 
						КонецЕсли; 
					КонецЦикла; 
					
					// проверяем оплаты
					ТаблицаОплатПоПроводкам = СоставОплат.Скопировать(Новый Структура("ПризнакОплаты",Истина));
					ТаблицаОплатПоПроводкам.Свернуть("СчетАванса","Оплата,Оплата_БВ");
					Для каждого Стр Из ТаблицаОплатПоПроводкам Цикл
						Отбор = Новый Структура("ПризнакОплаты,СчетАванса",Истина,Стр.СчетАванса);
						ТаблицаОплатПоСчету = ТаблицаДокументаОплаты.Скопировать(Отбор);
						
						ИтогПоТаблицеОплат = _сф.Итог(ТаблицаОплатПоСчету,"Оплата");
						ИтогПоТаблицеОплат_БВ = _сф.Итог(ТаблицаОплатПоСчету,"Оплата_БВ");
						Если (ИтогПоТаблицеОплат <> Стр.Оплата) Тогда
							
							Отказ = Истина;
							Сообщить("Ошибка в механизме распределения: отличается сумма оплат по счету аванса по данным документа оплаты и по проводкам.");
							Возврат;
							
						Иначе
							Если (ИтогПоТаблицеОплат_БВ <> Стр.Оплата_БВ) Тогда
								
								СтрокиОплатПоСчету = _сф.к_НайтиСтроки(ТаблицаДокументаОплаты,Отбор);
								// ... (требуется корректировка сумм в базовой валюте)
								
							КонецЕсли; 
						КонецЕсли; 
					КонецЦикла;
					
					// формируем таблицу
					// необходимо разделить строки оплаты на строки оплаты по счетам и на строки авансов по договору
					// далее первые группируем по счетам и применяем алгоритм, аналогичный механизму зачета аванса
					ТаблицаСчетов = ТаблицаДокументаОплаты.Скопировать(,"Счет");
					ТаблицаСчетов.Свернуть("Счет");
					Счета = Новый Массив;
					Для каждого Стр Из ТаблицаСчетов Цикл
						Если (НЕ Стр.Счет.Пустая()) Тогда
							Счета.Добавить(Стр.Счет);
						КонецЕсли; 
					КонецЦикла; 
					
					МассивСчетовДляАлгоритмаРаспределения = Новый Массив;
					Для каждого Счет Из Счета Цикл
						
						Отбор = Новый Структура("Счет",Счет);
						ТаблицаПоСчету = ТаблицаДокументаОплаты.Скопировать(Отбор);
						
						// оплата по счету
						ОплатаПоСчету = ТаблицаПоСчету.Итог("Оплата_БВ");
						ВалютнаяОплатаПоСчету = ТаблицаПоСчету.Итог("Оплата");
						
						// оплата по актам
						ОплатаПоАктам = 0; 
						ВалютнаяОплатаПоАкту = 0; 
						Для каждого Стр Из ТаблицаПоСчету Цикл
							Если (НЕ Стр.Акт.Пустая()) Тогда
								_сф.Инкремент(ОплатаПоАктам,Стр.Оплата_БВ);
								_сф.Инкремент(ВалютнаяОплатаПоАкту,Стр.Оплата);
							КонецЕсли; 
						КонецЦикла; 
						
						// проверяем, что при актировании показатели распределения не уходят в минус
						ВТО = ТО.СкопироватьКолонки();
						
						// добавляем строки оплаты по счету в разрезе счетов аванса
						#Область ОплатаСчета 
						
						ТаблицаИзмеренийПоСчету = ТаблицаПоСчету.Скопировать(,"СчетЗадолженности,СчетАванса,Оплата,Оплата_БВ,НДС");   
						
						// !!! временный отбор
						//Отбор = Новый Структура("ПризнакОплаты",Ложь);
						//ТаблицаИзмеренийПоСчету = ТаблицаИзмеренийПоСчету.Скопировать(Отбор);
						
						ТаблицаИзмеренийПоСчету.Свернуть("СчетЗадолженности,СчетАванса","Оплата,Оплата_БВ,НДС");
						
						УслугиДокумента = _БЭ.ПолучитьУслугиДокумента(Счет);
						Для каждого НаборИзмерений Из ТаблицаИзмеренийПоСчету Цикл
							
							Нстр = ВТО.Добавить();
							
							// оплата счета
							Нстр.ДокументОплаты = Источник.Ссылка;
							Нстр.Договор = Договор;
							Нстр.СчетАванса = НаборИзмерений.СчетАванса;
							Нстр.СчетЗадолженности = НаборИзмерений.СчетЗадолженности;
							Нстр.ПризнакОплаты = Ложь;
							Нстр.Аналитика 	= Счет;
							Нстр.ПредставлениеАналитики = CW_Документы.ПолучитьНомерНаПечать(Новый Структура("Номер, Дата, Организация",Счет.НомерСчета, Счет.ДатаСчета, Источник.Организация))+" от "+Формат(Счет.ДатаСчета,"ДФ=dd.MM.yyyy");
							
							Нстр.ВалютнаяСумма 	= НаборИзмерений.Оплата;
							Нстр.Сумма 			= НаборИзмерений.Оплата_БВ;
							Нстр.СуммаДУ 		= 0;
							Нстр.СуммаДК 		= 0;
							Нстр.СуммаДЕ 		= 0;  
							
							Нстр.НДС 			= НаборИзмерений.НДС;
							
							Если (ОтдельныйСчетПоПеревыставляемым И Нстр.СчетАванса = СчетПоПеревыставляемым) Тогда
								Нстр.СуммаДК = Нстр.Сумма;   
								Нстр.НДС = 0;
							Иначе
								
								// формируем распределение
								ОпределитьСоотношениеДляУСН(Нстр,УслугиДокумента);
							КонецЕсли;
							
						КонецЦикла; 
						
						#КонецОбласти 
						
						// добавляем строки оплат акта
						Для каждого Стр Из ТаблицаПоСчету Цикл
							
							Если (Стр.Акт.Пустая()) Тогда
								Продолжить;
							КонецЕсли; 
							
							Нстр = ВТО.Добавить();
							
							Нстр.ДокументОплаты = Источник.Ссылка;
							Нстр.Договор = Договор;
							Нстр.СчетАванса = Стр.СчетАванса;
							Нстр.СчетЗадолженности = Стр.СчетЗадолженности;
							Нстр.ПризнакОплаты = Истина;
							Нстр.Аналитика 	= Стр.Акт;
							Нстр.ПредставлениеАналитики = CW_Документы.ПолучитьНомерНаПечать(Новый Структура("Номер, Дата, Организация", Стр.Акт.НомерАкта, Стр.Акт.ДатаАкта, Источник.Организация))+" от "+Формат(Стр.Акт.ДатаАкта,"ДФ=dd.MM.yyyy");
							
							Нстр.ВалютнаяСумма 	= Стр.Оплата;
							Нстр.Сумма 			= Стр.Оплата_БВ;
							Нстр.СуммаДУ 		= 0;
							Нстр.СуммаДК 		= 0;
							Нстр.СуммаДЕ 		= 0; 
							Нстр.НДС 			= Стр.НДС;
							
							Если (ОтдельныйСчетПоПеревыставляемым И Нстр.СчетАванса = СчетПоПеревыставляемым) Тогда
								Нстр.СуммаДК = Нстр.Сумма;
								Нстр.НДС = 0;
							Иначе
								
								// формируем распределение
								ОпределитьСоотношениеДляУСН(Нстр,_БЭ.ПолучитьУслугиДокумента(Стр.Акт));
								
							КонецЕсли;
							
						КонецЦикла; 
						
						// теперь схлопываем и проверяем
						ТПВТО = ВТО.Скопировать();
						Для каждого Стр Из ТПВТО Цикл
							
							Если (Стр.ПризнакОплаты) Тогда
								
								Стр.Сумма  = -Стр.Сумма;
								Стр.СуммаДУ = -Стр.СуммаДУ;
								Стр.СуммаДК = -Стр.СуммаДК;
								Стр.СуммаДЕ = -Стр.СуммаДЕ;  
								
								Стр.НДС 	= -Стр.НДС;
								
							КонецЕсли; 
							
						КонецЦикла; 
						
						// контроль и перераспределение
						ТПВТО.Свернуть("Договор,СчетАванса","Сумма,СуммаДУ,СуммаДК,СуммаДЕ,НДС");
						Для каждого СтрокаСвертки Из ТПВТО Цикл
							
							ИтогСумма = СтрокаСвертки.Сумма;
							
							ИтогСуммаДУ = СтрокаСвертки.СуммаДУ;
							ИтогСуммаДК = СтрокаСвертки.СуммаДК;
							ИтогСуммаДЕ = СтрокаСвертки.СуммаДЕ;
							
							ИтогНДС = СтрокаСвертки.НДС;
							
							Если НЕ (ИтогСуммаДУ >= 0 И ИтогСуммаДК >= 0 И ИтогСуммаДЕ >= 0) Тогда
								
								// распределяем минусы по другим графам
								СР = Новый Структура; // структура распределения
								СР.Вставить("СуммаДУ",ИтогСуммаДУ);
								СР.Вставить("СуммаДК",ИтогСуммаДК);
								СР.Вставить("СуммаДЕ",ИтогСуммаДЕ);
								
								Для каждого КЗ Из СР Цикл
									Если (КЗ.Значение < 0) Тогда
										ОстатокСуммыРаспределения = _сф.Модуль(КЗ.Значение);
										СР[КЗ.Ключ] = 0;
										Для каждого КЗР Из СР Цикл
											Если (КЗР.Значение > 0 И ОстатокСуммыРаспределения > 0) Тогда
												СуммаПерераспределения = Мин(КЗР.Значение,ОстатокСуммыРаспределения);
												_сф.Декремент(СР[КЗР.Ключ],СуммаПерераспределения);
												_сф.Декремент(ОстатокСуммыРаспределения,СуммаПерераспределения);
											КонецЕсли; 
										КонецЦикла; 
										
										// проверяем, что все распределии
										Если (ОстатокСуммыРаспределения <> 0) Тогда
											Сообщить("Ошибка перераспределения сумм для УСН");
											Отказ = Истина;
											Возврат;
										КонецЕсли; 
									КонецЕсли; 
								КонецЦикла; 
								
								ИтогСуммаДУ = СР.СуммаДУ;
								ИтогСуммаДК = СР.СуммаДК;
								ИтогСуммаДЕ = СР.СуммаДЕ;
							КонецЕсли;
							
							// переносим итоги по ДУ,ДК и ДЕ в первую строку таблицы ВТО
							ОтборСтрокиСчета = Новый Структура("СчетАванса,ПризнакОплаты",СтрокаСвертки.СчетАванса,Ложь);
							СтрокаСчета = _сф.к_НайтиСтроку(ВТО,ОтборСтрокиСчета);
							
							СтрокаСчета.Сумма 	= ИтогСумма;
							СтрокаСчета.СуммаДУ = ИтогСуммаДУ;
							СтрокаСчета.СуммаДК = ИтогСуммаДК;
							СтрокаСчета.СуммаДЕ = ИтогСуммаДЕ; 
							СтрокаСчета.НДС 	= ИтогНДС;    
							
						КонецЦикла; 
						
						
						// переносим записи таблицы ВТО в ТО
						Для каждого Стр Из ВТО Цикл
							
							// если акт, то пробуем найти
							Если (Стр.ПризнакОплаты) Тогда
								Отбор = Новый Структура("Аналитика",Стр.Аналитика);
								СтрокаАкта = _сф.к_НайтиСтроку(ТО,Отбор);
								Если (СтрокаАкта <> Неопределено) Тогда 
									_сф.Инкремент(СтрокаАкта.Сумма,Стр.Сумма);
									_сф.Инкремент(СтрокаАкта.СуммаДУ,Стр.СуммаДУ);
									_сф.Инкремент(СтрокаАкта.СуммаДК,Стр.СуммаДК);
									_сф.Инкремент(СтрокаАкта.СуммаДЕ,Стр.СуммаДЕ);
									_сф.Инкремент(СтрокаАкта.НДС,Стр.НДС);
									СтрокаАкта.ПризнакОплаты = Истина;
								Иначе
									Нстр = ТО.Добавить();
									ЗаполнитьЗначенияСвойств(Нстр,Стр);
								КонецЕсли;
							Иначе
								Нстр = ТО.Добавить();
								ЗаполнитьЗначенияСвойств(Нстр,Стр);
							КонецЕсли;
						КонецЦикла; 
					КонецЦикла; 
					
					Отбор = Новый Структура("Счет", Документы.CW_ДоходыПоГрузоперевозке.ПустаяСсылка());
					СтрокиАвансовПоДоговору = ТаблицаДокументаОплаты.Скопировать(Отбор);
					Для каждого Стр Из СтрокиАвансовПоДоговору Цикл
						
						Нстр = ТО.Добавить();
						
						// оплата счета
						Нстр.ДокументОплаты = Источник.Ссылка;
						Нстр.Договор = Договор;
						Нстр.СчетАванса = Стр.СчетАванса;
						Нстр.СчетЗадолженности = Стр.СчетЗадолженности;
						Нстр.ПризнакОплаты = Ложь;
						Нстр.Аналитика 	= Стр.Счет;
						Нстр.ПредставлениеАналитики = "";
						
						Нстр.ВалютнаяСумма 	= Стр.Оплата;
						Нстр.Сумма 			= Стр.Оплата_БВ;
						Нстр.СуммаДУ 		= 0;
						Нстр.СуммаДК 		= 0;
						Нстр.СуммаДЕ 		= 0;
						
						Нстр.НДС 			= Стр.НДС;
						
						Если (ОтдельныйСчетПоПеревыставляемым И Нстр.СчетАванса = СчетПоПеревыставляемым) Тогда
							Нстр.СуммаДК = Нстр.Сумма;
						Иначе
							
							// смотрим на порядок отражения
							Если (ПорядокОтраженияАванса = Перечисления.ПорядокОтраженияАвансов.ДоходУСН) Тогда
								
								Нстр.СуммаДУ = Нстр.Сумма;
								
							ИначеЕсли (ПорядокОтраженияАванса = Перечисления.ПорядокОтраженияАвансов.ДоходКомитента) Тогда 
								
								Нстр.СуммаДК = Нстр.Сумма; 
								
							ИначеЕсли (ПорядокОтраженияАванса = Перечисления.ПорядокОтраженияАвансов.ДоходЕНВД) Тогда 
								
								Нстр.СуммаДЕ = Нстр.Сумма; 
								
							КонецЕсли; 
						КонецЕсли; 
					КонецЦикла; 
				КонецЕсли;
				
				Если (НЕ ИспользуетсяОперативнаяЗадолженность) Тогда
					Для каждого Стр Из СоставОплат Цикл
						
						Нстр = ТО.Добавить();
						
						Нстр.ДокументОплаты = Источник.Ссылка;
						Нстр.Договор = Стр.Договор;
						Нстр.СчетАванса = Стр.СчетАванса;
						Нстр.ПризнакОплаты = Стр.ПризнакОплаты;
						
						Нстр.Аналитика = Стр.Аналитика;
						Нстр.ПредставлениеАналитики = CW_Документы.ПолучитьНомерНаПечать(Нстр.Аналитика)+" от "+Формат(Нстр.Аналитика.Дата,"ДФ=dd.MM.yyyy");
						
						Нстр.ВалютнаяСумма = Стр.Оплата + Стр.Аванс;
						Нстр.Сумма = Стр.Оплата_БВ + Стр.Аванс_БВ;
						Нстр.СуммаДК = Стр.СуммаПеревыставляемых_БВ+Стр.СуммаАвансовПоПеревыставляемым_БВ;
						Нстр.СуммаДЕ = Стр.СуммаЕНВД_БВ + Стр.СуммаАвансовПоЕНВД_БВ;
						Нстр.СуммаДУ = Нстр.Сумма - (Нстр.СуммаДК + Нстр.СуммаДЕ);
						
						Нстр.НДС	= Стр.НДС;
						
					КонецЦикла; 
				КонецЕсли; 
				
				
				// формирование детализированных записей КУДиР 
				Для каждого Стр Из ТО Цикл
					
					КУДиР = Новый Структура("ДоходЕНВД, Графа4, Графа5, Графа6, Графа7, Содержание", 0,0,0,0,0,0,"");
					СтрокаСодержание = "Поступление на р/с "+Строка(Источник.СчетОрганизации)+" от покупателя " + ПН(Источник.Контрагент) + " по договору " +Договор +". ";
					Поступление = Стр.Сумма;
					КУДиР.Графа4 = Поступление;
					КУДиР.Графа5 = Поступление; 
					
					Если (Стр.ПризнакОплаты) Тогда
						
						_сф.стр_Добавить(СтрокаСодержание,"Оплата акта "+Строка(Стр.ПредставлениеАналитики)+". ");
						
						ОплатаЕНВД = Стр.СуммаДЕ;
						Если (ОплатаЕНВД <> 0) Тогда
							_сф.Декремент(КУДиР.Графа5,ОплатаЕНВД);
							_сф.Инкремент(КУДиР.ДоходЕНВД,ОплатаЕНВД);
							_сф.стр_Добавить(СтрокаСодержание,"Сумма " + Окр(ОплатаЕНВД,2,1) + " руб. отнесена к ЕНВД. ");
						КонецЕсли; 
						
						ОплатаКомитент = Стр.СуммаДК;
						Если (ОплатаКомитент <> 0) Тогда
							_сф.Декремент(КУДиР.Графа5,ОплатаКомитент);
							_сф.стр_Добавить(СтрокаСодержание,"Сумма " + Окр(ОплатаКомитент,2,1) + " руб. определена как возмещаемая. ");    
						КонецЕсли;  
						
						// если отразили доход, то проанализируем нужно ли из него вычитать НДС
						Если Стр.СуммаДУ <> 0 Тогда
							ОплатаНДС = Стр.НДС; 
							Если ОплатаНДС <> 0 Тогда  
								
								// если первичный документ оформлен ранее 01.01.25, то из налогооблагаемой БД сумму НДС не убираем
								Если Стр.Аналитика.ДатаАкта >= Дата('2025.01.01') Тогда
									КУДиР.Графа5 = КУДиР.Графа5 - ОплатаНДС;  
									СтрокаСодержание = СтрокаСодержание + "Предъявленный НДС на сумму " + Окр(ОплатаНДС,2,1) + " руб. исключен из доходов. "
								КонецЕсли;
							КонецЕсли;  
						КонецЕсли;
						
					КонецЕсли; // если в структуре установлен признак оплаты бухгалтерского документа
					
					Если (НЕ Стр.ПризнакОплаты) Тогда
						
						Если ЗначениеЗаполнено(Стр.ПредставлениеАналитики) Тогда
							_сф.стр_Добавить(СтрокаСодержание,"Аванс по счету "+Строка(Стр.ПредставлениеАналитики)+". "); 
						Иначе
							_сф.стр_Добавить(СтрокаСодержание,"Аванс по договору. "); 
						КонецЕсли;
						
						АвансЕНВД = Стр.СуммаДЕ;
						Если (АвансЕНВД <> 0) Тогда
							_сф.Декремент(КУДиР.Графа5,АвансЕНВД);
							_сф.Инкремент(КУДиР.ДоходЕНВД,АвансЕНВД);
							_сф.стр_Добавить(СтрокаСодержание,"Сумма " + Окр(АвансЕНВД,2,1) + " руб. отнесена к ЕНВД. ");
						КонецЕсли;
						
						АвансКомитент = Стр.СуммаДК;
						Если (АвансКомитент <> 0) Тогда
							_сф.Декремент(КУДиР.Графа5,АвансКомитент);
							_сф.стр_Добавить(СтрокаСодержание,"Сумма " + Окр(АвансКомитент,2,1) + " руб. определена как посредническая. ");
						КонецЕсли; 
						
						Если Стр.СуммаДУ <> 0 Тогда
							ОплатаНДС = Стр.НДС;
							Если ОплатаНДС <> 0 Тогда   
								
								// если первичный документ оформлен ранее 01.01.25 или если это аванс по собственным услугам позднее 01.01.25, 
								// то сумму НДС убираем из налогооблагаемой базы 
								Если (Стр.Аналитика.ДатаСчета >= Дата('2025.01.01')) или 
									(Не ЗначениеЗаполнено(Стр.Аналитика) и Стр.ДокументОплаты.Дата >= Дата('2025.01.01')) 
									Тогда
									КУДиР.Графа5 = КУДиР.Графа5 - ОплатаНДС;
									СтрокаСодержание = СтрокаСодержание + "Предъявленный НДС на сумму " + Окр(ОплатаНДС,2,1) + " руб. исключен из доходов." 
								КонецЕсли;
							КонецЕсли;   
						КонецЕсли;
						
					КонецЕсли; 
					
					КУДиР.Содержание = СтрокаСодержание;
					
					Если (КУДиР.Графа4 <> 0 ИЛИ КУДиР.Графа5 <> 0 ИЛИ КУДиР.ДоходЕНВД <> 0) Тогда 
						
						Движение = Источник.Движения.КнигаУчетаДоходовИРасходов.Добавить();
						ЗаполнитьЗначенияСвойств(Движение,КУДиР);
						Движение.Организация 		= Источник.Организация;
						Движение.Период 			= Источник.Дата;  
						Движение.Контрагент 		= Источник.Контрагент;
						Движение.ДоговорКонтрагента = Источник.ДоговорКонтрагента;
						Движение.РеквизитыПервичногоДокумента = НалоговыйУчетУСН.РеквизитыПервичногоДокумента(Платежка);
						
					КонецЕсли;
					
				КонецЦикла; // обход записей таблицы оплат ("ТО") 
				
				
				// движения закрытия регистра "CW_ОплатыПокупателейУСН"
				Для каждого Стр Из ТО Цикл
					
					Если (Стр.Сумма = 0 И Стр.СуммаДУ = 0 И Стр.СуммаДК = 0 И Стр.СуммаДЕ = 0) Тогда
						Продолжить;
					КонецЕсли; 
					
					Запись = НЗ_ОплатыУСН.Добавить();
					ЗаполнитьЗначенияСвойств(Запись, Стр);
					Запись.Период = Ведомый.Дата;
					Запись.ВидДвижения = ВидДвиженияНакопления.Приход;
					Если (Стр.ПризнакОплаты) Тогда
						Запись = НЗ_ОплатыУСН.Добавить();
						ЗаполнитьЗначенияСвойств(Запись, Стр);
						Запись.Период = Ведомый.Дата;
						Запись.ВидДвижения = ВидДвиженияНакопления.Расход;
					КонецЕсли; 
					
				КонецЦикла; 
				
				// движения регистра "CW_РаспределениеОплатПокупателейУСН"
				ТаблицаОплатПоАктам = ТО.Скопировать(Новый Структура("ПризнакОплаты",Истина));
				
				ТаблицаОплатПоАктам.Колонки.Добавить("ДокументДоходыПоГрузоперевозке", Новый ОписаниеТипов("ДокументСсылка.CW_ДоходыПоГрузоперевозке"));
				ТаблицаОплатПоАктам.Колонки.Добавить("НайденДокументДоходы", Новый ОписаниеТипов("Булево"));
				массивРеализации = Новый Массив;
				Для Каждого строкаОплатПоАктам Из ТаблицаОплатПоАктам Цикл
					Если ТипЗнч(строкаОплатПоАктам.Аналитика) = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда 
						массивРеализации.Добавить(строкаОплатПоАктам.Аналитика);
					КонецЕсли;
				КонецЦикла;
				з = Новый Запрос(
				"ВЫБРАТЬ
				|	CW_ДоходыПоГрузоперевозке.ВедомыйДокумент КАК ДокументРеализацияТоваровУслуг,
				|	CW_ДоходыПоГрузоперевозке.Ссылка КАК ДокументДоходыПоГрузоперевозке
				|ИЗ
				|	Документ.CW_ДоходыПоГрузоперевозке КАК CW_ДоходыПоГрузоперевозке
				|ГДЕ
				|	CW_ДоходыПоГрузоперевозке.ВедомыйДокумент В(&массивРеализации)
				|	И НЕ CW_ДоходыПоГрузоперевозке.ПометкаУдаления"
				);
				з.УстановитьПараметр("массивРеализации", массивРеализации);
				тзСоответствияДоходовРеализациям = з.Выполнить().Выгрузить();
				Для Каждого строкаОплатПоАктам Из ТаблицаОплатПоАктам Цикл
					Если ТипЗнч(строкаОплатПоАктам.Аналитика) = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда 
						строкаСоотв = тзСоответствияДоходовРеализациям.Найти(строкаОплатПоАктам.Аналитика, "ДокументРеализацияТоваровУслуг");
						Если строкаСоотв<>Неопределено Тогда 
							строкаОплатПоАктам.ДокументДоходыПоГрузоперевозке = строкаСоотв.ДокументДоходыПоГрузоперевозке;
							строкаОплатПоАктам.НайденДокументДоходы = Истина;
						КонецЕсли;
					КонецЕсли;
				КонецЦикла;
				// только записи, где найдётся док-т Доходы
				ТаблицаОплатПоАктам = ТаблицаОплатПоАктам.Скопировать(Новый Структура("НайденДокументДоходы", Истина));
				// аналитику - РТУ меняем на Доходы
				ТаблицаОплатПоАктам.Колонки.Аналитика.Имя = "ДокументРеализацияТоваровУслуг";
				ТаблицаОплатПоАктам.Колонки.ДокументДоходыПоГрузоперевозке.Имя = "Аналитика";
				
				Для каждого Стр Из ТаблицаОплатПоАктам Цикл
					
					Запись = НЗ_РаспределениеОплатУСН.Добавить();
					// --- 
					Запись.Организация = Ведомый.Организация;
					Запись.Контрагент = Ведомый.Контрагент;
					Запись.Договор = Ведомый.Договор;
					Запись.ДокументРеализации = Стр.Аналитика;
					Запись.ДокументОплаты = Ведомый.Ссылка;
					// --- 
					Запись.ВалютнаяСумма = Стр.ВалютнаяСумма;
					Запись.Сумма = Стр.Сумма;
					Запись.СуммаДУ = Стр.СуммаДУ;
					Запись.СуммаДК = Стр.СуммаДК;
					Запись.СуммаДЕ = Стр.СуммаДЕ;
					
				КонецЦикла; 
				
			КонецЦикла; // обход по договорам (по факту он всегда один) 
			
		КонецЕсли; // если организация на УСН и вид операции "Поступление от покупателя"
		
		Если (НЗ_ОплатыУСН <> Неопределено) Тогда
			НЗ_ОплатыУСН.Записать(Истина);	
		КонецЕсли; 
		Если (НЗ_РаспределениеОплатУСН <> Неопределено) Тогда
			НЗ_РаспределениеОплатУСН.Записать(Истина);
		КонецЕсли; 
		
	КонецЕсли; // есть ведомый документ и ведется раздельный учет задолженности
	
	#КонецОбласти 
		
КонецПроцедуры 

Процедура CW_ПроведениеСчетаФактурыОбработкаПроведения(Источник, Отказ, РежимПроведения) Экспорт
	
	// для выданных с/ф коректируем записи регистра "Журнал учёта с/ф" в части НДС
	ВедущийДокумент = _сф.ст_ПолучитьСвойство(Источник.ДополнительныеСвойства,"ВедущийДокумент");
	ГрупповоеПерепроведение = _сф.ст_ПолучитьСвойство(Источник.ДополнительныеСвойства,"ГрупповоеПерепроведение",Ложь);
	
	#Область ВходящиеСчетаФактуры 
	
		Если (ТипЗнч(Источник) = Тип("ДокументОбъект.СчетФактураПолученный")) Тогда
			
			Если (ВедущийДокумент = Неопределено) Тогда
				
				// проверяем, является ли поступление ведомым
				Если (ТипЗнч(Источник.ДокументОснование) = Тип("ДокументСсылка.ПоступлениеТоваровУслуг")) Тогда
					
					ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
					               |	CW_РасходыПоГрузоперевозке.Ссылка КАК Ссылка
					               |ИЗ
					               |	Документ.CW_РасходыПоГрузоперевозке КАК CW_РасходыПоГрузоперевозке
					               |ГДЕ
					               |	CW_РасходыПоГрузоперевозке.ВедомыйСчетФактура = &ВедомыйДокумент";
					
					ВедущийДокумент = _сф.ВыполнитьЗапрос(ТекстЗапроса,Новый Структура("ВедомыйДокумент",Источник.Ссылка),Истина,"Ссылка");
					
				ИначеЕсли (ТипЗнч(Источник.ДокументОснование) = Тип("ДокументСсылка.КорректировкаПоступления")) Тогда 
					
					ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
					               |	CW_РасходыПоГрузоперевозке.Ссылка КАК Ссылка
					               |ИЗ
					               |	Документ.CW_РасходыПоГрузоперевозке КАК CW_РасходыПоГрузоперевозке
					               |ГДЕ
					               |	CW_РасходыПоГрузоперевозке.ВедомыйСчетФактураКорректировочный = &ВедомыйДокумент";
					
					ВедущийДокумент = _сф.ВыполнитьЗапрос(ТекстЗапроса,Новый Структура("ВедомыйДокумент",Источник.Ссылка),Истина,"Ссылка");
					
				КонецЕсли; // попытка получить ведущий документ в зависимости от типа документа
			КонецЕсли; // ведущий документ передан через дополнительные свойства
			
			ТребуетсяКорректировка = (ВедущийДокумент <> Неопределено);
			Если (ТребуетсяКорректировка) Тогда
				
				// если у документа установлен признак ручной корректировки движений,
				// то автоматическую корректировку движений не выполняем (предупредив об этом пользователя)
				Если (Источник.РучнаяКорректировка) Тогда
					Сообщить("Внимание! У ведомого документа "+Строка(Источник.Ссылка)+" установлен признак ручной корректировки движений!");
					Возврат;
				КонецЕсли;
				
				Если (НЕ ВедущийДокумент.Корректировка) Тогда
					
					ВРУ = CW_Настройки.ВалютаРегламентированногоУчета();
					
					Постановление735 = _сф.ст_ПолучитьСвойство(Источник.ДополнительныеСвойства,"Постановление735",Неопределено);
					Если (Постановление735 = Неопределено) Тогда
						Постановление735 = CW_Настройки.ПараметрУчетнойПолитики(Источник.Дата, Источник.Организация, "ТребованияПостановления735");
					КонецЕсли;
					
					Если (Постановление735) Тогда
						
						ПорядокЗаполненияЖурналаСчетовФактурПоПостановлению735 = CW_Настройки.ПараметрУчетнойПолитики(Источник.Дата, Источник.Организация, "ПорядокЗаполненияЖурналаСчетовФактурПоПостановлению735");
						КодВидаОперацииДляПеревыставления = CW_Настройки.ПараметрУчетнойПолитики(Источник.Дата, Источник.Организация, "КодВидаОперацииДляВходящихСчетовФактур");
						
						// группируем строки по порядку отражения и покупателю
						ТаблицаДокументаПоступления = CW_Финансы.ПолучитьУслугиДокумента(ВедущийДокумент);
						
						// фикс для перевыставления по ставкам
						Для каждого Стр Из ТаблицаДокументаПоступления Цикл
							
							Если (Стр.ПорядокОтражения = Перечисления.CW_ПорядокОтраженияЗатрат.ПеревыставлениеПоСтавкам) Тогда
								Стр.ПорядокОтражения = Перечисления.CW_ПорядокОтраженияЗатрат.Перевыставление;
							КонецЕсли; 
							
						КонецЦикла; 
						
						// очищаем движения
						Движения = Источник.Движения.ЖурналУчетаСчетовФактур;
						Движения.Очистить();
						
						// формируем
						Если (ВедущийДокумент.Валюта <> ВРУ И НЕ ВедущийДокумент.Договор.ВзаиморасчетыВУЕ) Тогда
							
							Для каждого Стр Из ТаблицаДокументаПоступления Цикл
								
								Стр.Всего_Рег = Стр.Всего;
								Стр.НДС_Рег = Стр.НДС;
								
							КонецЦикла; 
							
						КонецЕсли; 
						// --- 
						
						ТаблицаПоПорядкуОтражения = ТаблицаДокументаПоступления.Скопировать();
						ТаблицаПоПорядкуОтражения.Свернуть("ПорядокОтражения","Всего_Рег,НДС_Рег");
						// --- 
						ТаблицаПоСтавкам = ТаблицаДокументаПоступления.Скопировать();
						ТаблицаПоСтавкам.Свернуть("СтавкаНДС");
						ТолькоБезНДС = Ложь;
						Если (ТаблицаПоСтавкам.Количество()=1) Тогда
							Если (_сф.к_ПервыйЭлемент(ТаблицаПоСтавкам).СтавкаНДС = Перечисления.СтавкиНДС.БезНДС) Тогда
								ТолькоБезНДС = Истина;
							КонецЕсли; 
						КонецЕсли; 
						// --- 
						Всего = ТаблицаПоПорядкуОтражения.Итог("Всего_Рег");
						НДС = ТаблицаПоПорядкуОтражения.Итог("НДС_Рег");
						// --- 
						ОтборПоСобственным = Новый Структура("ПорядокОтражения",Перечисления.CW_ПорядокОтраженияЗатрат.Затраты);
						ТЗ_Собственные = ТаблицаПоПорядкуОтражения.Скопировать(ОтборПоСобственным);
						
						//как то так...
						ОтборПоПрочиеРасходы = Новый Структура("ПорядокОтражения",Перечисления.CW_ПорядокОтраженияЗатрат.ПрочиеРасходы);
						ТЗ_ПрочиеРасходы = ТаблицаПоПорядкуОтражения.Скопировать(ОтборПоПрочиеРасходы);
						Для Каждого СтрокаТЗ из ТЗ_ПрочиеРасходы Цикл
							стр = ТЗ_Собственные.Добавить();
							ЗаполнитьЗначенияСвойств(стр,СтрокаТЗ);
						КонецЦикла;
					
						// --- 
						Всего_Собственные = ТЗ_Собственные.Итог("Всего_Рег");
						НДС_Собственные = ТЗ_Собственные.Итог("НДС_Рег");
						// --- 
						Всего_Перевыставляемые = Всего - Всего_Собственные;
						НДС_Перевыставляемые = НДС - НДС_Собственные;
						
						ИндексСтроки=0;
						
						Движение = Движения.Добавить();
						//Движение = РегистрыСведений.ЖурналУчетаСчетовФактур.СоздатьМенеджерЗаписи(); // тмп
						// --- 
						Движение.Организация = Источник.Организация;
						Движение.Период = Источник.Дата;
						Движение.Активность = Истина;
						Движение.Контрагент = Источник.Контрагент;
						Движение.СчетФактура = Источник.Ссылка;
						Движение.ЧастьЖурнала=Перечисления.ЧастиЖурналаУчетаСчетовФактур.ПолученныеСчетаФактуры;
						Движение.ИндексСтроки = ИндексСтроки;
						Движение.ДатаВыставленияПолучения = Источник.Дата;
						Движение.КодСпособаВыставленияПолучения = Источник.КодСпособаПолучения;
						Движение.НомерСчетаФактуры = Источник.НомерВходящегоДокумента;
						Движение.ДатаСчетаФактуры = Источник.ДатаВходящегоДокумента;
						Если (НЕ ВедущийДокумент.Договор.ВзаиморасчетыВУЕ) Тогда
							Движение.Валюта = Источник.ВалютаДокумента;
						Иначе
							Движение.Валюта = ВРУ;
						КонецЕсли; 
						
						Если Источник.ДокументОснование.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсправленияПоступленияРеализации.ИсправлениеОшибки") Тогда
							Движение.НомерИсправления	= Источник.НомерИсправления;
							Движение.ДатаИсправления 	= Источник.Дата;
						КонецЕсли;
						
						// --- 
						Движение.СуммаПоСчетуФактуре = Всего;
						Движение.СуммаНДС = НДС;	
						Движение.КодВидаОперации = Источник.КодВидаОперации;
						// --- 
						Движение.СуммаПоСчетуФактуреКомиссия = Всего_Перевыставляемые;
						Движение.СуммаНДСКомиссия = НДС_Перевыставляемые;
						Если (ЗначениеЗаполнено(ВедущийДокумент.КодВидаОперации)) Тогда
							Движение.КодВидаОперацииКомиссия = ВедущийДокумент.КодВидаОперации;
						Иначе
							
							ЕстьСобственные = (Всего_Собственные <> 0);
							ЕстьПеревыставление = (Всего_Перевыставляемые <> 0);
							Если (Источник.Дата >= Дата(2016,7,1) И ЕстьСобственные И ЕстьПеревыставление) Тогда
								
								Движение.КодВидаОперацииКомиссия = "15";
								
							Иначе
								
								Движение.КодВидаОперацииКомиссия = КодВидаОперацииДляПеревыставления;	 
								
							КонецЕсли; 
							
						КонецЕсли; 
						// --- 
						Движение.ПоСтавкеБезНДС = ТолькоБезНДС;
						Движение.СчетФактураНеВыставляется = Ложь;
						Движение.Продавец = ВедущийДокумент.Продавец;
						Движение.КППКонтрагента = Источник.КППКонтрагента;
						Движение.Посредник = ?(ЗначениеЗаполнено(ВедущийДокумент.Продавец),Источник.Контрагент,Неопределено);
						Движение.КодВидаСделки = "1";
						Движение.НомерСчетаФактурыПродавца = "";
						// --- 
						// посредник
						Движение.Субкомиссионер = ?(ЗначениеЗаполнено(ВедущийДокумент.Продавец),Источник.Контрагент,Неопределено);
						// --- 
						
					КонецЕсли; 
					
					Если (НЕ Постановление735) Тогда
						
						Движения = Источник.Движения.ЖурналУчетаСчетовФактур;
						Движение = _сф.к_ПервыйЭлемент(Движения);
						Если (Движение <> Неопределено) Тогда
							
							Движение.СуммаНДС = ПолучитьСуммуНДСПоступления(ВедущийДокумент);
							Если ВедущийДокумент.Услуги.Итог("НДС") <> 0 Тогда
								
								Движение.ПоСтавкеБезНДС = Ложь;
								
							Иначе
								
								// проверяем, что все строки документа идут по ставке "без НДС"
								Для каждого Стр Из ВедущийДокумент.Услуги Цикл
									
									БезНДС = Истина;
									Если Стр.СтавкаНДС <> Перечисления.СтавкиНДС.БезНДС Тогда
										
										БезНДС = Ложь;
										
									КонецЕсли; 
									Движение.ПоСтавкеБезНДС = БезНДС;
									
								КонецЦикла; 
								
							КонецЕсли;
							
						КонецЕсли; 
						
					КонецЕсли; 
					
				КонецЕсли; // ведущий документ не является корректировочным
				
				Если (ВедущийДокумент.Корректировка) Тогда
					
					мДвиженияКУдалению = Новый Массив;
					Для каждого Движение Из Источник.Движения.ЖурналУчетаСчетовФактур Цикл  
						
						Если Движение.Сторно Тогда
							мДвиженияКУдалению.Добавить(Движение);	
						КонецЕсли;
						
						Движение.Продавец	= ВедущийДокумент.КорректируемыйДокумент.Продавец;
						Движение.Посредник 	= ?(ЗначениеЗаполнено(ВедущийДокумент.КорректируемыйДокумент.Продавец),Источник.Контрагент,Неопределено);
						Движение.Субкомиссионер 		 = ?(ЗначениеЗаполнено(ВедущийДокумент.КорректируемыйДокумент.Продавец),Источник.Контрагент,Неопределено);
						Движение.КодВидаОперацииКомиссия =	 Источник.КодВидаОперацииНаУменьшение;   
						
						ИсходныйВедущий = ПолучитьИсходныйСчетФактуру(ВедущийДокумент);
						
						Движение.НомерСчетаФактуры 	= CW_Документы.ПолучитьНомерНаПечать(Новый Структура("Организация, Номер, Дата", ИсходныйВедущий.Организация, ИсходныйВедущий.НомерСФ, ИсходныйВедущий.ДатаСФ));
						Движение.ДатаСчетаФактуры 	= ИсходныйВедущий.ДатаСФ;   
						
						
						ИсходныйВедущийПоследнееИсправление = ПолучитьПоследнееИсправлениеИсходногоСчетФактуры(ИсходныйВедущий, "CW_РасходыПоГрузоперевозке"); 	
						Если ИсходныйВедущийПоследнееИсправление <> ИсходныйВедущий Тогда
							Движение.НомерИсправления	= ИсходныйВедущийПоследнееИсправление.НомерИсправления;
							Движение.ДатаИсправления 	= ИсходныйВедущийПоследнееИсправление.ДатаСФ;                                                                                                                           
						КонецЕсли;
					КонецЦикла; 
					
					//Сторно   
					Для Каждого Запись из мДвиженияКУдалению Цикл
						Источник.Движения.ЖурналУчетаСчетовФактур.Удалить(Запись);
					КонецЦикла;
					
					Если Источник.ДокументОснование.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсправленияПоступленияРеализации.ИсправлениеОшибки") Тогда			
						
						Если ВедущийДокумент.КорректируемыйДокумент.Корректировка Тогда
							ИсправляемыйДокументСчетФактура = ВедущийДокумент.КорректируемыйДокумент.ВедомыйСчетФактураКорректировочный;
						Иначе
							ИсправляемыйДокументСчетФактура = ВедущийДокумент.КорректируемыйДокумент.ВедомыйСчетФактура;							
						КонецЕсли;
						
						Набор = РегистрыСведений.ЖурналУчетаСчетовФактур.СоздатьНаборЗаписей();
						Набор.Отбор.Регистратор.Установить(ИсправляемыйДокументСчетФактура);
						Набор.Прочитать();  
						
						Для Каждого СтрокаНабора из Набор Цикл 
							Если СтрокаНабора.Сторно Тогда
								Продолжить;
							КонецЕсли;
							
							Движение = Источник.Движения.ЖурналУчетаСчетовФактур.Добавить(); 
							ЗаполнитьЗначенияСвойств(Движение, СтрокаНабора,,"Регистратор");
							
							Движение.Сторно = Истина; 
							
							Движение.СуммаПоСчетуФактуре 					= - Движение.СуммаПоСчетуФактуре; 
							Движение.СуммаНДС 								= - Движение.СуммаНДС; 
							Движение.СуммаПоСчетуФактуреРазницаУменьшение 	= - Движение.СуммаПоСчетуФактуреРазницаУменьшение; 
							Движение.СуммаПоСчетуФактуреРазницаУвеличение 	= - Движение.СуммаПоСчетуФактуреРазницаУвеличение; 
							Движение.СуммаНДСРазницаУменьшение 				= - Движение.СуммаНДСРазницаУменьшение; 
							Движение.СуммаНДСРазницаУвеличение 				= - Движение.СуммаНДСРазницаУвеличение; 
							
							Движение.СуммаПоСчетуФактуреКомиссия 			= - Движение.СуммаПоСчетуФактуреКомиссия; 
							Движение.СуммаНДСКомиссия 						= - Движение.СуммаНДСКомиссия; 
							Движение.СуммаПоСчетуФактуреРазницаУменьшениеКомиссия = - Движение.СуммаПоСчетуФактуреРазницаУменьшениеКомиссия; 
							Движение.СуммаПоСчетуФактуреРазницаУвеличениеКомиссия = - Движение.СуммаПоСчетуФактуреРазницаУвеличениеКомиссия; 
							Движение.СуммаНДСРазницаУменьшениеКомиссия 		= - Движение.СуммаНДСРазницаУменьшениеКомиссия; 
							Движение.СуммаНДСРазницаУвеличениеКомиссия 		= - Движение.СуммаНДСРазницаУвеличениеКомиссия; 
							
						КонецЦикла;
						
					КонецЕсли;
					//Сторно
					
					
					Возврат;
					
				КонецЕсли; // ведущий документ является корректировкой
			КонецЕсли; // проверка на необходимость корректировки движений
		КонецЕсли; // если в качестве источника выступает документ "СчетФактураПолученный" 
	
	#КонецОбласти 
	
	#Область ИсходящиеСчетаФактуры 
	
		Если (ТипЗнч(Источник) = Тип("ДокументОбъект.СчетФактураВыданный")) Тогда
			
			// проверяем, является ли реализация ведомой
			Если (ВедущийДокумент = Неопределено) Тогда
				Если (ТипЗнч(Источник.ДокументОснование) = Тип("ДокументСсылка.РеализацияТоваровУслуг")) Тогда
					
					ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
					               |	CW_ДоходыПоГрузоперевозке.Ссылка КАК Ссылка
					               |ИЗ
					               |	Документ.CW_ДоходыПоГрузоперевозке КАК CW_ДоходыПоГрузоперевозке
					               |ГДЕ
					               |	CW_ДоходыПоГрузоперевозке.ВедомыйСчетФактура = &ВедомыйДокумент";
					ВедущийДокумент = _сф.ВыполнитьЗапрос(ТекстЗапроса,Новый Структура("ВедомыйДокумент",Источник.Ссылка),Истина,"Ссылка");
					
				ИначеЕсли (ТипЗнч(Источник.ДокументОснование) = Тип("ДокументСсылка.КорректировкаРеализации")) Тогда 
					
					ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
					               |	CW_ДоходыПоГрузоперевозке.Ссылка КАК Ссылка
					               |ИЗ
					               |	Документ.CW_ДоходыПоГрузоперевозке КАК CW_ДоходыПоГрузоперевозке
					               |ГДЕ
					               |	CW_ДоходыПоГрузоперевозке.ВедомыйСчетФактураКорректировочный = &ВедомыйДокумент";
					ВедущийДокумент = _сф.ВыполнитьЗапрос(ТекстЗапроса,Новый Структура("ВедомыйДокумент",Источник.Ссылка),Истина,"Ссылка");
					
				КонецЕсли; // получение ведущего документа в зависимости от типа источника 
			КонецЕсли; // ведущий документ передан через дополнительные свойства
			
			// если определить ведущий документ не удалось
			Если (ВедущийДокумент = Неопределено) Тогда
				Возврат;
			КонецЕсли; 
			
			// движения по с\ф, сформированные при проведении документа "Закрытие грузоперевозки"
			// не корректируем, т.к. движения полностью соответствуют требованию учета
			Если (ТипЗнч(ВедущийДокумент) = Тип("ДокументСсылка.CW_ЗакрытиеГрузоперевозки")) Тогда
				Возврат;
			КонецЕсли; 
			
			ТребуетсяКорректировка = (ВедущийДокумент <> Неопределено);
			Если (ТребуетсяКорректировка) Тогда
				
				// если у документа установлен признак ручной корректировки движений,
				// то автоматическую корректировку движений не выполняем (предупредив об этом пользователя)
				Если (Источник.РучнаяКорректировка) Тогда
					Сообщить("Внимание! У ведомого документа "+Строка(Источник.Ссылка)+" установлен признак ручной корректировки движений!");
					Возврат;
				КонецЕсли;
				
				Если (НЕ ВедущийДокумент.Корректировка) Тогда
					
					Постановление735 = _сф.ст_ПолучитьСвойство(Источник.ДополнительныеСвойства,"Постановление735",Неопределено);
					Если (Постановление735 = Неопределено) Тогда
						Постановление735 = CW_Настройки.ПараметрУчетнойПолитики(Источник.Дата, Источник.Организация, "ТребованияПостановления735");
					КонецЕсли;
					
					// в журнале с\ф требуется выводить посредника
					Если (Постановление735) Тогда
						
						ОбщаяСуммаСчетФактурыВСтрокахСводных = CW_Настройки.ПараметрУчетнойПолитики(Источник.Дата,Источник.Организация,"ОбщаяСуммаСчетФактурыВСтрокахСводных");
						
						// группируем строки по порядку отражения и покупателю
						ВРУ = CW_Настройки.ВалютаРегламентированногоУчета();
						ТаблицаДокументаРеализации = CW_Финансы.ПолучитьУслугиДокумента(ВедущийДокумент);
						ИсходнаяТаблицаРеализации = ТаблицаДокументаРеализации.Скопировать();
						
						// очищаем движения
						Движения = Источник.Движения.ЖурналУчетаСчетовФактур;
						Движения.Очистить();
						
						// заполняем колонки "Продавец" и "Посредник"
						ТаблицаДокументаРеализации.Колонки.Добавить("Продавец");
						ТаблицаДокументаРеализации.Колонки.Добавить("Посредник");
						Для каждого Стр Из ТаблицаДокументаРеализации Цикл
							Если (Стр.ПорядокОтражения = Перечисления.CW_ПорядокОтраженияДоходов.СобственнаяУслуга) 
								ИЛи (Стр.ПорядокОтражения = Перечисления.CW_ПорядокОтраженияДоходов.ПрочиеДоходы) Тогда
								Стр.Продавец = Справочники.Контрагенты.ПустаяСсылка();
								Стр.Посредник = Справочники.Контрагенты.ПустаяСсылка();
							Иначе
								Если (ЗначениеЗаполнено(Стр.ДокументРасходов.Продавец) И Стр.ДокументРасходов.ПредъявленСФ) Тогда
									Стр.Продавец = Стр.ДокументРасходов.Продавец;
									Стр.Посредник = Стр.ДокументРасходов.Контрагент;
								Иначе
									Стр.Продавец = Стр.ДокументРасходов.Контрагент;
									Стр.Посредник = Справочники.Контрагенты.ПустаяСсылка();
								КонецЕсли; 
							КонецЕсли; 
						КонецЦикла; 
						
						ТаблицаДокументаРеализации.Свернуть("ПорядокОтражения,ДокументРасходов,Продавец,Посредник,СтавкаНДС","Всего_Рег,НДС_Рег,Всего,НДС");
						ТаблицаСтавокПоДокументамРасходов = ТаблицаДокументаРеализации.Скопировать(,"ДокументРасходов,СтавкаНДС");
						ТаблицаСтавокПоДокументамРасходов.Свернуть("ДокументРасходов,СтавкаНДС");
						
						ТЗ_ДокументыРасходов = ТаблицаСтавокПоДокументамРасходов.Скопировать();
						ТЗ_ДокументыРасходов.Свернуть("ДокументРасходов");
						ТЗ_ДокументыРасходов.Колонки.Добавить("БезНДС");
						
						Для каждого Стр Из ТЗ_ДокументыРасходов Цикл
							
							Отбор = Новый Структура("ДокументРасходов",Стр.ДокументРасходов);
							СтрокиПоДокументу = _сф.к_НайтиСтроки(ТаблицаСтавокПоДокументамРасходов,Отбор);
							БезНДС = Истина;
							
							Для каждого СтрокаПоДокументу Из СтрокиПоДокументу Цикл
								Если (СтрокаПоДокументу.СтавкаНДС <> Перечисления.СтавкиНДС.БезНДС) Тогда
									БезНДС = Ложь;
									Прервать;
								КонецЕсли; 
							КонецЦикла; 
							Стр.БезНДС = БезНДС;
						КонецЦикла; 
						
						ТаблицаДокументаРеализации.Свернуть("ПорядокОтражения,ДокументРасходов,Продавец","Всего_Рег,НДС_Рег,Всего,НДС");
						
						//Сортируем по порядоку отражения, чтобы "Собственные" "встали" в начало.
						ТаблицаДокументаРеализации.Сортировать("ПорядокОтражения УБЫВ");
						
						Если (ТаблицаДокументаРеализации.Найти(Перечисления.CW_ПорядокОтраженияДоходов.ПеревыставлениеПоСтавкам,"ПорядокОтражения")<> Неопределено) Тогда
							Отказ = Истина;
							Сообщить(Источник);
							Сообщить("Схему перевыставления по ставкам невозможно отразить с утётом требований постановления №735");
							Возврат;
						КонецЕсли; 
						
						Если (ВедущийДокумент.Валюта <> ВРУ И НЕ ВедущийДокумент.Договор.ВзаиморасчетыВУЕ) Тогда
							Для каждого Стр Из ТаблицаДокументаРеализации Цикл
								Стр.Всего_Рег = Стр.Всего;
								Стр.НДС_Рег = Стр.НДС;
							КонецЦикла; 
						КонецЕсли; 
						
						СводнаяСФ = Источник.СводныйКомиссионный;
						
						Всего = ТаблицаДокументаРеализации.Итог("Всего_Рег");
						НДС = ТаблицаДокументаРеализации.Итог("НДС_Рег");
						
						ОтборПоСобственным = Новый Структура("ПорядокОтражения",Перечисления.CW_ПорядокОтраженияДоходов.СобственнаяУслуга);
						ТЗ_Собственные = ТаблицаДокументаРеализации.Скопировать(ОтборПоСобственным);
						
						ОтборПоПрочиеДоходы = Новый Структура("ПорядокОтражения",Перечисления.CW_ПорядокОтраженияДоходов.ПрочиеДоходы);
						ТЗ_ОтборПоПрочиеДоходы = ТаблицаДокументаРеализации.Скопировать(ОтборПоПрочиеДоходы);
						
						Для Каждого СтрТЗ из ТЗ_ОтборПоПрочиеДоходы Цикл
							НоваяСтр =  ТЗ_Собственные.Добавить();
							ЗаполнитьЗначенияСвойств(НоваяСтр, СтрТЗ);
						КонецЦикла;
						
						Всего_Собственные = ТЗ_Собственные.Итог("Всего_Рег");
						НДС_Собственные = ТЗ_Собственные.Итог("НДС_Рег");
						
						Всего_Перевыставляемые = Всего - Всего_Собственные;
						НДС_Перевыставляемые = НДС - НДС_Собственные;
						
						// простая счет-фактура (на перевыставление или только собственные услуги)
						Если (НЕ СводнаяСФ) Тогда
							
							Продавец = Справочники.Контрагенты.ПустаяСсылка();
							ДокументРасходов = Документы.CW_РасходыПоГрузоперевозке.ПустаяСсылка();
							
							Для каждого Стр Из ТаблицаДокументаРеализации Цикл
								Если (Стр.ПорядокОтражения <> Перечисления.CW_ПорядокОтраженияДоходов.СобственнаяУслуга) 
									ИЛи (Стр.ПорядокОтражения <> Перечисления.CW_ПорядокОтраженияДоходов.ПрочиеДоходы) Тогда
									Если (ЗначениеЗаполнено(Стр.ДокументРасходов)) Тогда
										ДокументРасходов = Стр.ДокументРасходов;
										Продавец = Стр.Продавец;	
									КонецЕсли; 
