Функция ПолучитьСуммуНДСРеализации(ДокументРеализации)
	// --- 
	
	Если НЕ ДокументРеализации.Договор.ВзаиморасчетыВУЕ Тогда
		
		Если ДокументРеализации.Валюта = CW_Настройки.ВалютаРегламентированногоУчета() Тогда
			
			Возврат(ДокументРеализации.Услуги.Итог("НДС"));
			
		Иначе 
			
			// валютные с/ф идёт в журнал в валюте!!!
			Возврат(ДокументРеализации.Услуги.Итог("НДС"));
			
		КонецЕсли; 
		
	Иначе
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	CW_ДоходыПоГрузоперевозкам.НомерСтроки КАК НомерСтроки,
		|	CW_ДоходыПоГрузоперевозкам.Всего КАК Всего_Рег,
		|	CW_ДоходыПоГрузоперевозкам.Сумма КАК Сумма_Рег,
		|	CW_ДоходыПоГрузоперевозкам.НДС КАК НДС_Рег
		|ИЗ
		|	РегистрНакопления.CW_ДоходыПоГрузоперевозкам КАК CW_ДоходыПоГрузоперевозкам
		|ГДЕ
		|	CW_ДоходыПоГрузоперевозкам.Регистратор = &Регистратор
		|
		|УПОРЯДОЧИТЬ ПО
		|	НомерСтроки";
		Запрос.УстановитьПараметр("Регистратор", ДокументРеализации);
		ТЗ = Запрос.Выполнить().Выгрузить();
		Возврат(ТЗ.Итог("НДС_Рег"));
		
	КонецЕсли; 
	
	// --- 
КонецФункции

