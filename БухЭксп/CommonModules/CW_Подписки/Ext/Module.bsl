		НЗ_СоответствиеАктов = _сф.НаборЗаписейПоРегистратору(РегистрыСведений.CW_СоответствиеАктовВходящимСчетам,Документ);
		НЗ_ОплатаДокументов = _сф.НаборЗаписейПоРегистратору(РегистрыСведений.CW_ОплатаВходящихДокументов,Документ);
	#КонецОбласти 
	
	#Область ОперативнаяЗадолженность 
		
		Если (ИспользуетсяОперативнаяЗадолженность или РежимВводначальныхОстатков_ОЗ) Тогда
			
			#Область Параметры 
			
				ВалютныйДокумент = (Документ.Валюта <> Свойства.КО.ВалютаРегламентированногоУчета);
				РасчетыУЕ = (Документ.Договор.ВзаиморасчетыВУЕ);
				РасчетыВалюта = ((НЕ РасчетыУЕ) И ВалютныйДокумент);
				
				// требуется определить счета учета
				Для каждого Стр Из ТаблицаУслуг Цикл
					Если (НЕ ВалютныйДокумент) Тогда
						Стр.Всего_Рег = Стр.Всего;
					КонецЕсли; 
				КонецЦикла;
				
				// параметры свёртки
				Если (ЕстьСчет ИЛИ ЕстьАкт) Тогда
					
					СтрокаГруппировки = "Грузоперевозка,Счет";
					Если КонтрольНоменклатуры Тогда
						_сф.стр_Добавить(СтрокаГруппировки,",Номенклатура");
					КонецЕсли; 
					Если КонтрольПорядкаОтражения Тогда
						_сф.стр_Добавить(СтрокаГруппировки,",ПорядокОтражения");
					КонецЕсли; 
					Если КонтрольНДС Тогда
						_сф.стр_Добавить(СтрокаГруппировки,",СтавкаНДС");
					КонецЕсли; 
					Если РежимВводначальныхОстатков_ОЗ Тогда
						СтрокаСвертки = "ОЗ_Всего";
						Если КонтрольНДС Тогда
							_сф.стр_Добавить(СтрокаСвертки,",ОЗ_Сумма,ОЗ_НДС");
						КонецЕсли; 
					Иначе
						СтрокаСвертки = "Всего";
						Если КонтрольНДС Тогда
							_сф.стр_Добавить(СтрокаСвертки,",Сумма,НДС");
						КонецЕсли; 	
					КонецЕсли; 
				КонецЕсли; 
			
			#КонецОбласти 
			
			#Область РабочийРежим 
				
				Если (НЕ РежимВводначальныхОстатков_ОЗ) Тогда
					
					// начисление задолженности
					Если (ЕстьСчет) Тогда
						
						ТребуетсяПересчет = Ложь;
						
						Если Документ.УЕ_ПользовательскийКурс Тогда
							КурсСчета = Новый Структура("Курс,Кратность",Документ.УЕ_Курс,Документ.УЕ_Кратность);
						Иначе 
							КурсСчета = CW_Финансы.ПолучитьКурсВалюты(Документ.Валюта,Документ.ДатаСчета);
						КонецЕсли;
						Если (ЕстьАкт И ДатаАкта <> Документ.ДатаСчета) Тогда
							ТребуетсяПересчет = Истина;
						КонецЕсли; 
						
						ТаблицаОЗ = ТаблицаУслуг.Скопировать();
						ТаблицаОЗ.Свернуть("СчетЗадолженности","Всего,Всего_Рег,ВсегоРег");
						
						ИтогоПоНачислению_Валюта = 0;
						ИтогоПоНачислению = 0;
						
						АналитикаКурсовыхРазниц = _сф.т_Создать("Аналитика,Счет,ВалютнаяСуммаЗачета,СуммаЗачета");
						
						Для каждого Стр Из ТаблицаОЗ Цикл
							
							Движение = НЗ_ОЗ.Добавить();
							// --- 
							Движение.ВидДвижения	= ВидДвиженияНакопления.Приход;
							Движение.Период 		= Документ.ДатаСчета;
							Движение.Организация 	= Документ.Организация;
							Движение.Контрагент 	= Документ.Контрагент;
							Движение.Договор 		= Документ.Договор;
							//Подсистема.УчетПриложенийДоговоров
							Движение.ПриложениеКДоговору= Документ.ПриложениеКДоговору;
							//Подсистема.УчетПриложенийДоговоров
							Движение.Валюта 		= Документ.Валюта;
							Движение.Счет 			= Документ.Ссылка;
							Движение.СчетУчета 		= Стр.СчетЗадолженности;
							// --- 
							Движение.Всего_Валюта	= Стр.Всего; 
							
							Если Документ.ПоказатьРубли	Тогда
								Движение.Всего	= Стр.ВсегоРег;
							Иначе
								Движение.Всего 	= Стр.Всего_Рег;
							КонецЕсли;
							
							_сф.Инкремент(ИтогоПоНачислению_Валюта,Движение.Всего_Валюта);
							_сф.Инкремент(ИтогоПоНачислению,Движение.Всего);
							// --- 
							Движение.ВидОперации=Перечисления.CW_ВидыДвиженийПоОперативнойЗадолженности.Начисление;
							
							// --- 
							
							//Нстр = АналитикаКурсовыхРазниц.Добавить();
							//Нстр.Аналитика = Документ.Ссылка;
							//Нстр.Счет = Стр.СчетЗадолженности;
							//Нстр.ВалютнаяСуммаЗачета = Движение.Всего_Валюта;
							//Нстр.СуммаЗачета = Движение.Всего;
							
						КонецЦикла; 
						
						ТребуетсяПересчетДляОЗ = (Документ.Валюта <> Свойства.КО.ВалютаРегламентированногоУчета);
						
						ИтогоПоСписанию_Валюта = 0;
						ИтогоПоСписанию = 0;
						
						СтруктураПараметров = CW_Настройки.ПустаяСтруктураПолученияПараметровДоговора();
						СтруктураПараметров.Дата 				= Документ.Дата;
						СтруктураПараметров.Договор 			= Документ.Договор;
						СтруктураПараметров.ПриложениеКДоговору = Документ.ПриложениеКДоговору;
						
						ПараметрыДоговора	= CW_Настройки.ПолучитьПараметрыДоговора(СтруктураПараметров, "НалоговыйАгент_НДСЗаСчетСредствПоставщика");
						КомпенсацияНДС 		= ПараметрыДоговора.НалоговыйАгент_НДСЗаСчетСредствПоставщика;
						
						УчетныйДоговор 		= CW_Финансы.ПолучитьУчетныйДоговор(СтруктураПараметров);
						НалоговыйАгент 		= УчетныйДоговор.УчетАгентскогоНДС;
	
						Если (НалоговыйАгент И КомпенсацияНДС) Тогда
							
							СтавкаНДСЧислом = CW_Финансы.ПолучитьКоэффициентСтавкиНДС(Перечисления.ВидыСтавокНДС.ОбщаяРасчетная, Документ.Дата);
							НДС_Валюта 		= Окр(Документ.СуммаДокумента*СтавкаНДСЧислом,2);
							//Если  Документ.Дата < '20190101' Тогда
							//	НДС_Валюта = Документ.СуммаДокумента*0.18/1.18;
							//Иначе
							//	НДС_Валюта = Документ.СуммаДокумента*0.20/1.20;
							//КонецЕсли;
							
							Курс = CW_Финансы.ПолучитьКурсВалюты(Документ.Валюта,Документ.ДатаСчета);
							НДС_БазоваяВалюта = CW_Финансы.ПересчитатьИзВалютыВВалюту(НДС_Валюта,Документ.Валюта,Свойства.КО.ВалютаРегламентированногоУчета,Курс.Курс, 1, Курс.Кратность, 1);
							
							// --- 
							
							Движение = НЗ_ОЗ.Добавить();
							// --- 
							Движение.ВидДвижения	= ВидДвиженияНакопления.Расход;
							Движение.Период 		= Документ.ДатаСчета;
							Движение.Организация 	= Документ.Организация;
							Движение.Контрагент 	= Документ.Контрагент;
							Движение.Договор 		= Документ.Договор;
							//Подсистема.УчетПриложенийДоговоров
							Движение.ПриложениеКДоговору= Документ.ПриложениеКДоговору;
							//Подсистема.УчетПриложенийДоговоров
							Движение.Валюта 		= Документ.Валюта;
							Движение.Счет 			= Документ.Ссылка;
							Движение.СчетУчета 		= Стр.СчетЗадолженности;
							// --- 
							Движение.Всего_Валюта	= НДС_Валюта;
							Движение.Всего	 		= НДС_БазоваяВалюта;
							// --- 
							Движение.ВидОперации=Перечисления.CW_ВидыДвиженийПоОперативнойЗадолженности.Оплата;
							
						КонецЕсли; 
						
						Если (_сф.Количество(Документ.ЗачетАвансовОЗ) <> 0) Тогда
							
							//есть данные для зачета аванса ОЗ
							ЗапросАвансы = Новый Запрос;
							ЗапросАвансы.Текст = "ВЫБРАТЬ
							                     |	ЗачетАвансовОЗ.СчетЗадолженности КАК СчетЗадолженности,
							                     |	ЗачетАвансовОЗ.ДокументОплаты КАК ДокументОплаты,
							                     |	ЗачетАвансовОЗ.СуммаЗачета КАК СуммаЗачета
							                     |ПОМЕСТИТЬ ВТ_ДанныеЗачетаАванса
							                     |ИЗ
							                     |	&ЗачетАвансовОЗ КАК ЗачетАвансовОЗ
							                     |;
							                     |
							                     |////////////////////////////////////////////////////////////////////////////////
							                     |ВЫБРАТЬ
							                     |	ВТ_ДанныеЗачетаАванса.ДокументОплаты КАК ДокументОплаты,
							                     |	ВТ_ДанныеЗачетаАванса.СчетЗадолженности КАК СчетЗадолженности,
							                     |	ВТ_ДанныеЗачетаАванса.СуммаЗачета КАК СуммаЗачета,
							                     |	ЕСТЬNULL(CW_ОперативнаяКредиторскаяЗадолженностьОстатки.ВсегоОстаток, 0) КАК ВсегоОстаток,
							                     |	ЕСТЬNULL(CW_ОперативнаяКредиторскаяЗадолженностьОстатки.Всего_ВалютаОстаток, 0) КАК Всего_ВалютаОстаток
							                     |ИЗ
							                     |	ВТ_ДанныеЗачетаАванса КАК ВТ_ДанныеЗачетаАванса
							                     |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.CW_ОперативнаяКредиторскаяЗадолженность.Остатки(
							                     |				&ДатаОстатка,
							                     |				(Счет, СчетУчета) В
							                     |					(ВЫБРАТЬ
							                     |						ВТ_ДанныеЗачетаАванса.ДокументОплаты КАК ДокументОплаты,
							                     |						ВТ_ДанныеЗачетаАванса.СчетЗадолженности КАК СчетЗадолженности
							                     |					ИЗ
							                     |						ВТ_ДанныеЗачетаАванса КАК ВТ_ДанныеЗачетаАванса)) КАК CW_ОперативнаяКредиторскаяЗадолженностьОстатки
							                     |		ПО ВТ_ДанныеЗачетаАванса.ДокументОплаты = CW_ОперативнаяКредиторскаяЗадолженностьОстатки.Счет
							                     |			И ВТ_ДанныеЗачетаАванса.СчетЗадолженности = CW_ОперативнаяКредиторскаяЗадолженностьОстатки.СчетУчета";
							
							ЗапросАвансы.УстановитьПараметр("ДатаОстатка"		, Новый Граница(Документ.ДатаСчета,ВидГраницы.Исключая));
							ЗапросАвансы.УстановитьПараметр("ЗачетАвансовОЗ"	, Документ.ЗачетАвансовОЗ.Выгрузить());
							
							ВыборкаАвансы = ЗапросАвансы.Выполнить().Выбрать();
							
							Пока ВыборкаАвансы.Следующий() Цикл
								
								Если ВыборкаАвансы.СуммаЗачета = ВыборкаАвансы.Всего_ВалютаОстаток Тогда
									Сумма_Всего = ВыборкаАвансы.ВсегоОстаток;
								Иначе
									Если ВыборкаАвансы.Всего_ВалютаОстаток <> 0 Тогда
										КурсОстатка =  ВыборкаАвансы.ВсегоОстаток / ВыборкаАвансы.Всего_ВалютаОстаток;
										Сумма_Всего = КурсОстатка * ВыборкаАвансы.СуммаЗачета; 
									Иначе
										Сумма_Всего = 0;
									КонецЕсли;
								КонецЕсли;
								
								Если Сумма_Всего = 0 тогда
									Продолжить;
								КонецЕсли;
								
								Движение = НЗ_ОЗ.Добавить();
								// --- 
								Движение.ВидДвижения	= ВидДвиженияНакопления.Расход;
								Движение.Период 		= Документ.ДатаСчета;
								Движение.Организация 	= Документ.Организация;
								Движение.Контрагент 	= Документ.Контрагент;
								Движение.Договор 		= Документ.Договор;
								//Подсистема.УчетПриложенийДоговоров
								Движение.ПриложениеКДоговору= Документ.ПриложениеКДоговору;
								//Подсистема.УчетПриложенийДоговоров
								Движение.Валюта 		= Документ.Валюта;
								Движение.Счет 			= Документ.Ссылка;
								Движение.СчетУчета 		= ВыборкаАвансы.СчетЗадолженности;
								
								Движение.Всего_Валюта	= ВыборкаАвансы.СуммаЗачета;
								
								Движение.Всего	 		= Сумма_Всего;
								
								_сф.Инкремент(ИтогоПоСписанию_Валюта,Движение.Всего_Валюта);
								_сф.Инкремент(ИтогоПоСписанию,Движение.Всего);
								
								Движение.ВидОперации	= Перечисления.CW_ВидыДвиженийПоОперативнойЗадолженности.ЗачетАванса;
								
								
								// сторно ОЗ по платежке
								// ---------------------------------------------------------------------------- 
								Движение = НЗ_ОЗ.Добавить();
								// --- 
								Движение.ВидДвижения	= ВидДвиженияНакопления.Расход;
								Движение.Период 		= Документ.ДатаСчета;
								Движение.Организация 	= Документ.Организация;
								Движение.Контрагент 	= Документ.Контрагент;
								Движение.Договор 		= Документ.Договор;
								//Подсистема.УчетПриложенийДоговоров
								Движение.ПриложениеКДоговору= Документ.ПриложениеКДоговору;
								//Подсистема.УчетПриложенийДоговоров
								Движение.Валюта 		= Документ.Валюта;
								Движение.Счет 			= ВыборкаАвансы.ДокументОплаты;
								Движение.СчетУчета 		= ВыборкаАвансы.СчетЗадолженности;
								// --- 
								Движение.Всего_Валюта	= - ВыборкаАвансы.СуммаЗачета;
								Движение.Всего	 		= - Сумма_Всего;
								
								Движение.ВидОперации=Перечисления.CW_ВидыДвиженийПоОперативнойЗадолженности.ЗачетАванса;
									

								// привязка счёт - платежка - сумма
								Движение = НЗ_ОплатаДокументов.Добавить();
								Движение.Период 			= Документ.Дата;
								Движение.Документ 			= Документ;
								Движение.СчетЗадолженности 	= ВыборкаАвансы.СчетЗадолженности;
								Движение.ДокументОплаты 	= ВыборкаАвансы.ДокументОплаты;
								Движение.Всего 				= ВыборкаАвансы.СуммаЗачета;	
								
								СтруктураПарамтеров = Новый Структура;
								СтруктураПарамтеров.Вставить("Дата", 			Документ.Дата);
								СтруктураПарамтеров.Вставить("ВалютаОбъекта", 	Документ.Валюта);
								СтруктураПарамтеров.Вставить("Организация",		Документ.Организация);
								СтруктураПарамтеров.Вставить("Контрагент",		Документ.Контрагент);
								СтруктураПарамтеров.Вставить("Договор",			Документ.Договор);
								//Подсистема.УчетПриложенийДоговоров
								СтруктураПарамтеров.Вставить("ПриложениеКДоговору", Документ.ПриложениеКДоговору);
								//Подсистема.УчетПриложенийДоговоров
								СтруктураПарамтеров.Вставить("ДатаСреза", 		Документ.ДатаСчета);
								СтруктураПарамтеров.Вставить("Набор",			НЗ_ОЗ);
								СтруктураПарамтеров.Вставить("ИмяРегистраОперативнойЗадолженности",	"CW_ОперативнаяКредиторскаяЗадолженность");
								
								CW_Финансы.СписаниеКурсовыеПоОперативнойЗадолженности(СтруктураПарамтеров);
								
							КонецЦикла;
							
						КонецЕсли; 
						
					КонецЕсли; 
					
					// отражение счетов и актов
					Если (ЕстьСчет ИЛИ ЕстьАкт) Тогда
						
						// формируем таблицу
						ТаблицаДвижений = ТаблицаУслуг.Скопировать();
						ТаблицаДвижений.Свернуть(СтрокаГруппировки,СтрокаСвертки);
						
						// выставление счета
						Если (ЕстьСчет) Тогда
							
							Для каждого Стр Из ТаблицаДвижений Цикл
								
								Движение = НЗ_КонтрольАктов.Добавить();
								ЗаполнитьЗначенияСвойств(Движение,Стр);
								Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
								Движение.Период = ?(Документ.ФормироватьВедомыеДатойДокумента,Документ.Дата,ДатаСчета);
								Движение.Счет = Документ.Ссылка;
								Движение.Организация = Документ.Организация;
								Движение.Контрагент = Документ.Контрагент;
								Движение.Договор = Документ.Договор;
								//Подсистема.УчетПриложенийДоговоров
								Движение.ПриложениеКДоговору= Документ.ПриложениеКДоговору;
								//Подсистема.УчетПриложенийДоговоров
								Движение.Валюта = Документ.Валюта;
								
							КонецЦикла; 
							
						КонецЕсли; 
						
						// закрытие актом
						Если (ЕстьАкт) Тогда
							
							Если (ЕстьСчет) Тогда
								
								// копируем движения счета и меняем знак и дату
								ТаблицаДвижений = НЗ_КонтрольАктов.Выгрузить();
								_сф.т_ЗаполнитьЗначения(ТаблицаДвижений,"Период", ?(Документ.ФормироватьВедомыеДатойДокумента, Документ.Дата, ?(ПровестиПоБухгалтерскомуУчету,Документ.ВедомыйДокумент.Дата,ДатаАкта)));
								_сф.т_ЗаполнитьЗначения(ТаблицаДвижений,"ВидДвижения",ВидДвиженияНакопления.Расход);
								
								Для каждого Стр Из ТаблицаДвижений Цикл
									Движение = НЗ_КонтрольАктов.Добавить();
									ЗаполнитьЗначенияСвойств(Движение,Стр);
								КонецЦикла; 
								
							Иначе
								
								Для каждого Стр Из ТаблицаДвижений Цикл
									Движение = НЗ_КонтрольАктов.Добавить();
									ЗаполнитьЗначенияСвойств(Движение,Стр);
									Движение.ВидДвижения=ВидДвиженияНакопления.Расход;
									Движение.Период = ?(Документ.ФормироватьВедомыеДатойДокумента, Документ.Дата, ?(ПровестиПоБухгалтерскомуУчету,Документ.ВедомыйДокумент.Дата,ДатаАкта));
									Движение.Счет = ?(Документ.СписокСчетов,Стр.Счет,Документ.Счет);
									Движение.Организация = Документ.Организация;
									Движение.Контрагент = Документ.Контрагент;
									Движение.Договор = Документ.Договор;
									//Подсистема.УчетПриложенийДоговоров
									Движение.ПриложениеКДоговору= Документ.ПриложениеКДоговору;
									//Подсистема.УчетПриложенийДоговоров
									Движение.Валюта = Документ.Валюта;
								КонецЦикла; 
								
							КонецЕсли; 
							
							Если (_сф.Количество(Документ.ЗачетАвансов) <> 0) Тогда
								
								Для каждого Стр Из Документ.ЗачетАвансов Цикл
									
									Если (ЗначениеЗаполнено(Стр.Счет)) Тогда
										
										ДвижениеОД = НЗ_ОплатаДокументов.Добавить();
										ДвижениеОД.Период = Документ.Дата;
										ДвижениеОД.Документ = Стр.Счет;
										ДвижениеОД.ДокументБУ = Документ;
										ДвижениеОД.СчетЗадолженности = Стр.СчетЗадолженности;
										ДвижениеОД.ДокументОплаты = Стр.ДокументОплаты;
										ДвижениеОД.Всего = Стр.СуммаЗачета;	
										ДвижениеОД.ПризнакАкта = Истина;
										
									КонецЕсли; 
									
								КонецЦикла; 
								
							КонецЕсли; 
							
						КонецЕсли; 
						
					КонецЕсли; 
					
				КонецЕсли; 
				
			#КонецОбласти 
			
			#Область ВводНачальныхОстатков 
			
			Если (РежимВводначальныхОстатков_ОЗ) Тогда
				
				Курс = CW_Финансы.ПолучитьКурсВалюты(Документ.Валюта, СтруктураНастроек["НачалоВеденияУчета"]);
				
				// начисление задолженности (только для счетов)
				Если (ЕстьСчет И Документ.СальдоВзаиморасчетовОЗ <> 0) Тогда
					
					Движение = НЗ_ОЗ.Добавить();
					// --- 
					Движение.ВидДвижения	= ВидДвиженияНакопления.Приход;
					Движение.Период 		= Документ.ДатаСчета;
					Движение.Организация 	= Документ.Организация;
					Движение.Контрагент 	= Документ.Контрагент;
					Движение.Договор 		= Документ.Договор;
					//Подсистема.УчетПриложенийДоговоров
					Движение.ПриложениеКДоговору= Документ.ПриложениеКДоговору;
					//Подсистема.УчетПриложенийДоговоров
					Движение.Валюта 		= Документ.Валюта;
					Движение.Счет 			= Документ.Ссылка;
					Движение.СчетУчета 		= CW_Финансы.ОпределитьСчетУчетаРасходов(,CW_Финансы.СтруктураСчетовРасчетов_Поставщики(Документ.Дата,Документ.Организация),ВалютныйДокумент,РасчетыУЕ);
					СуммаДвижения = Документ.СальдоВзаиморасчетовОЗ;
					Движение.Всего_Валюта	= СуммаДвижения;
					
					Если ВалютныйДокумент тогда    
						ДанныеКурса 	= CW_Финансы.ПолучитьКурсВалюты(Документ.Валюта,Документ.Дата); 
						ВсегоВВалютеРУ 	= Окр(CW_Финансы.ПересчитатьИзВалютыВВалюту(СуммаДвижения, Документ.Валюта, Свойства.КО.ВалютаРегламентированногоУчета, Документ.КурсВзаиморасчетовОЗ, 1, ДанныеКурса.Кратность, 1),2,1);
					Иначе
						ВсегоВВалютеРУ = СуммаДвижения;
					КонецЕсли;
					
					Движение.Всего    = ВсегоВВалютеРУ;	
					
					Движение.ВидОперации = Перечисления.CW_ВидыДвиженийПоОперативнойЗадолженности.Начисление;
					
					// Если оперативная задолженность по документу отлична от суммы документа (частичная оплата),
					// то добавим движения в регистр оплаты 
					ОплатаПоДокументу = Документ.СуммаДокумента - СуммаДвижения;
					Если ОплатаПоДокументу <> 0 Тогда
						Движение = НЗ_ОплатаДокументов.Добавить();
						Движение.Период 			= Документ.Дата;
						Движение.Документ 			= Документ;
						Движение.СчетЗадолженности 	= CW_Финансы.ОпределитьСчетУчетаРасходов(,CW_Финансы.СтруктураСчетовРасчетов_Поставщики(Документ.Дата,Документ.Организация),ВалютныйДокумент,РасчетыУЕ);
						Движение.ДокументОплаты 	= Документ;
						Движение.Всего 				= ОплатаПоДокументу;	
						Движение.ПризнакАкта 		= Ложь;
						
						Если ЕстьАкт Тогда
							Движение = НЗ_ОплатаДокументов.Добавить();
							Движение.Период 			= Документ.Дата;
							Движение.Документ 			= Документ;
							Движение.СчетЗадолженности 	= CW_Финансы.ОпределитьСчетУчетаРасходов(,CW_Финансы.СтруктураСчетовРасчетов_Поставщики(Документ.Дата,Документ.Организация),ВалютныйДокумент,РасчетыУЕ);
							Движение.ДокументОплаты 	= Документ;
							Движение.ДокументБУ 	    = Документ;
							Движение.Всего 				= ОплатаПоДокументу;	
							Движение.ПризнакАкта 		= Истина;
						КонецЕсли;
					КонецЕсли; //Оплата входящих документов
				КонецЕсли; // Наличе счета и оперативной задолженности
				
				// отражение актирования счетов
				Если (ЕстьСчет) и (НЕ ЕстьАкт) Тогда
					
					ТаблицаДвижений = ТаблицаУслуг.Скопировать();
					
					// удаляем строки без актированного сальдо
					МассивУдаления = Новый Массив;
					Для каждого Стр Из ТаблицаДвижений Цикл
						Если Стр.ОЗ_Всего = 0 И Стр.ОЗ_Сумма = 0 И Стр.ОЗ_НДС = 0 Тогда
							МассивУдаления.Добавить(Стр);
						КонецЕсли; 
					КонецЦикла; 
					
					// формируем движения по актированию счетов по начальным остаткам, введенным в табличную часть "Услуги"
					_сф.к_УдалитьЭлементыПоМассиву(ТаблицаДвижений,МассивУдаления);
					ТаблицаДвижений.Свернуть(СтрокаГруппировки,СтрокаСвертки);
					Для каждого Стр Из ТаблицаДвижений Цикл
						
						Движение = НЗ_КонтрольАктов.Добавить();
						// --- 
						ЗаполнитьЗначенияСвойств(Движение,Стр);
						Движение.ВидДвижения=ВидДвиженияНакопления.Приход;
						Движение.Период = ?(Документ.ФормироватьВедомыеДатойДокумента, Документ.Дата, ДатаСчета);
						Движение.Счет = Документ.Ссылка;
						Движение.Организация = Документ.Организация;
						Движение.Контрагент = Документ.Контрагент;
						Движение.Договор = Документ.Договор;
						//Подсистема.УчетПриложенийДоговоров
						Движение.ПриложениеКДоговору= Документ.ПриложениеКДоговору;
						//Подсистема.УчетПриложенийДоговоров
						Движение.Валюта = Документ.Валюта;
						
						// если включен контроль порядока отражения 
						Если КонтрольПорядкаОтражения Тогда
							Движение.ПорядокОтражения = Стр.ПорядокОтражения;
						КонецЕсли;
						
						// если включен контроль НДС для актирования счетов
						Если КонтрольНДС Тогда
							Движение.Сумма = Стр.ОЗ_Сумма;
							Движение.НДС = Стр.ОЗ_НДС;
						КонецЕсли;
						
						Движение.Всего = Стр.ОЗ_Всего;
						
					КонецЦикла; 
					
				КонецЕсли; // актирование счетов в режиме ввода остатков
				
			КонецЕсли; // режим ввода остатков  
			
			#КонецОбласти 
			
		КонецЕсли; // используется оперативная задолженность 
	
	#КонецОбласти 
	
	#Область СоответсвиеСчетовАктов 
	
	Если (ЕстьАкт) Тогда
		
		ТаблицаДвижений = ТаблицаУслуг.Скопировать();
		Если (ЕстьСчет) Тогда
			_сф.т_ЗаполнитьЗначения(ТаблицаДвижений, "Счет", Документ);			
		Иначе
			Если (НЕ Документ.СписокСчетов) Тогда
				_сф.т_ЗаполнитьЗначения(ТаблицаДвижений, "Счет", Документ.Счет);
			КонецЕсли; 
		КонецЕсли; 
		
		СУ = Новый Массив;
		ЕстьНепривязанные = Ложь;
		Для каждого Стр Из ТаблицаДвижений Цикл
			Если (Стр.Счет.Пустая()) Тогда
				СУ.Добавить(Стр);
				ЕстьНепривязанные = Истина;
			КонецЕсли; 
		КонецЦикла; 
		_сф.к_УдалитьЭлементыПоМассиву(ТаблицаДвижений,СУ);
		
		// получаем настройку пользователя
		КонтрольПривязкиСчета = CW_Настройки.ПолучитьНастройкуПользователя(,"ПредупреждатьОПроведенииАктаБезПривязкиСчетаНаОплату");
		Если (ЕстьНепривязанные И КонтрольПривязкиСчета) Тогда
			Сообщить(Строка(Документ)+": "+"не привязаны счета на оплату!");
		КонецЕсли; 
		
		ТаблицаДвижений.Свернуть("Счет,СчетЗадолженности","Всего,НДС,Сумма");
		Для Каждого Стр из ТаблицаДвижений Цикл
			Запись = НЗ_СоответствиеАктов.Добавить();
			Запись.Счет = Стр.Счет;
			Запись.Акт = Документ;
			Запись.СчетУчетаЗадолженности = Стр.СчетЗадолженности;
			Запись.Всего = Стр.Всего;
			Запись.НДС = Стр.НДС;
			Запись.Сумма = Стр.Сумма;
		КонецЦикла; 
	КонецЕсли;	
	
	#КонецОбласти 
	
	#Область ЗаписьДвижений
	НЗ_ОЗ.Записать(Истина);
	НЗ_КонтрольАктов.Записать(Истина);	
	НЗ_СоответствиеАктов.Записать(Истина);
	НЗ_ОплатаДокументов.Записать(Истина);
	НЗ_Расходы.Записать(Истина);
	НЗ_Перевыставление.Записать(Истина);
	НЗ_ПеревыставлениеПоСтавкам.Записать(Истина);
	
	//Подсистема.УчетНЗП
	Если НЗ_НЗП <> Неопределено Тогда
		НЗ_НЗП.Записать(Истина);
	КонецЕсли;
	//Подсистема.УчетНЗП
	
	
	#КонецОбласти 
	
КонецПроцедуры

// Формирует движения для документа "CW_РасходыПоПриобретениям" 
//
// Параметры:
// ----------
//  <ВнешняяТаблицаУслуг>  - используется только для документов в У.Е. или в валюте с актом, во всех остальных случаях идёт пересчёт по курсам
//
Процедура СформироватьДвиженияДляРасходовПоПриобретениям(Документ,Отказ=Ложь,Свойства=Неопределено,ВнешняяТаблицаУслуг=Неопределено) Экспорт 
	
	Если (Документ.ПометкаУдаления) Тогда
		
		Отказ = Истина;
		Сообщить("Документ """+Строка(Документ)+""" помечен на удаление. Нарушена синхронизация пометок удаления!");
		Возврат;
		
	КонецЕсли; 
	
	#Область Параметры 
	
		Если (Свойства = Неопределено) Тогда
			
			СтруктураПараметров = CW_Настройки.ПустаяСтруктураПолученияПараметровДоговора();
			СтруктураПараметров.Дата 				= Документ.Дата;
			СтруктураПараметров.Договор 			= Документ.Договор;
			СтруктураПараметров.ПриложениеКДоговору = Документ.ПриложениеКДоговору;
			
			ПараметрыДоговора	= CW_Настройки.ПолучитьПараметрыДоговора(СтруктураПараметров);
			
			СКонстанты = Новый Структура;
			СКонстанты.Вставить("ВалютаРегламентированногоУчета",CW_Настройки.ВалютаРегламентированногоУчета());
			
			Свойства = Новый Структура;
			Свойства.Вставить("КО",	СКонстанты);
			Свойства.Вставить("ПД",	ПараметрыДоговора);
		КонецЕсли; 
		
		ДатаНачалаВеденияУчета 					= CW_Настройки.ПолучитьДатуНачалаВеденияУчета(Документ.Организация);
		РежимВводНачальныхОстатков 				= ?(ДатаНачалаВеденияУчета <> Неопределено, Документ.Дата < ДатаНачалаВеденияУчета,Ложь);
		ВалютаРегламентированногоУчетаРубль 	= ПолучитьФункциональнуюОпцию("CW_ВалютаРегламентированногоУчетаРубль");
		
		ЕстьСчет 	= (Документ.ПредъявленСчет);	
		ЕстьАкт 	= (Документ.ПредъявленАкт ИЛИ Документ.ПредъявленСФ или НЕ ВалютаРегламентированногоУчетаРубль);
		ДатаСчета 	= ?(ЕстьСчет,Документ.ДатаСчета,Документ.Дата);
		ДатаАкта 	= ?(Не ВалютаРегламентированногоУчетаРубль, ДатаСчета,?(Документ.ДатаАкта = Дата(1,1,1),Документ.ДатаСФ,Документ.ДатаАкта));
		
		//Подситема.СтатусыДокументов
		СтатусДокумента = Неопределено;
		Если Свойства.Свойство("СтатусДокумента") Тогда
			СтатусДокумента = Свойства.СтатусДокумента;
		Иначе
			ДанныеСтатуса 	= РегистрыСведений.CW_СтатусыДокументов.ПолучитьДанныеСтатусаДокумента(Документ);
			СтатусДокумента	= ДанныеСтатуса.СтатусДокумента;
		КонецЕсли;
		
		СтатусДокументаПроводитьПоБухгалтерскомуУчету = CW_СтатусыДокументовСервер.ПолучитьПризнакПроведенияПоБухгалтерскомуУчету(Документ, СтатусДокумента);
		//Подситема.СтатусыДокументов
		
		СтруктураПараметровБухУчета = Новый Структура;
		СтруктураПараметровБухУчета.Вставить("Договор", 				Документ.Договор);
		СтруктураПараметровБухУчета.Вставить("ПриложениеКДоговору",		Документ.ПриложениеКДоговору);
		
		ПараметрыБухгалтерскогоУчета  = CW_Финансы.ПолучитьПарметрыВеденияБухгалтерскогоУчета(СтруктураПараметровБухУчета, Документ.Дата);
		ПровестиПоБухгалтерскомуУчету = ПараметрыБухгалтерскогоУчета.БухгалтерскийУчет и СтатусДокументаПроводитьПоБухгалтерскомуУчету;
		
		СтруктураНастроек = CW_Настройки.ПолучитьНастройкиОперативногоУчета(Документ.Организация,Перечисления.CW_ВидыОперативнойЗадолженности.Кредиторская, Документ.Дата);
		
		ИспользуетсяОперативнаяЗадолженность 	= СтруктураНастроек["ВедетсяОперативныйУчет"];  
		РежимВводначальныхОстатков_ОЗ 			= СтруктураНастроек["ВводОстатков"];  
		
		НастройкиОперативногоУчета = СтруктураНастроек["НастройкиОперативногоУчета"];
		КонтрольНоменклатуры 		= НастройкиОперативногоУчета["КонтрольНоменклатуры"];
		КонтрольПорядкаОтражения 	= НастройкиОперативногоУчета["КонтрольПорядкаОтражения"];
		КонтрольНДС 				= НастройкиОперативногоУчета["КонтрольНДС"];
		
		#КонецОбласти 
		
	#Область НаборыДвиженийПоОсновнымРегистрам
	
		НЗ_Расходы = _сф.НаборЗаписейПоРегистратору(РегистрыНакопления.CW_РасходыПоПриобретениям,Документ);
	
	#КонецОбласти 
	
	#Область ОсновныеРегистры 
		
		// получаем таблицу услуг
		Если (Документ.Валюта <> Свойства.КО.ВалютаРегламентированногоУчета И (Документ.ПредъявленАкт ИЛИ Документ.ПредъявленСФ) И ВнешняяТаблицаУслуг <> Неопределено) Тогда
			ТаблицаУслуг = ВнешняяТаблицаУслуг;
		Иначе
			ТаблицаУслуг = Документ.Услуги.Выгрузить();
			CW_Финансы.ДобавитьКолонкиБазовойВалюты(ТаблицаУслуг);
		КонецЕсли; 
		ТаблицаДвиженийПоОсновнымРегистрам = ТаблицаУслуг;
		
		// определяем курс для пересчёта базового эквивалента для отражения по регистру "Расходы по грузоперевозкам"
		// если они не рассчитаны в подписке
		ТребуетсяЗаполнениеСуммРегУчета = Ложь;
		Если (Документ.Валюта = Свойства.КО.ВалютаРегламентированногоУчета) Тогда
			
			Курс = Новый Структура("Курс,Кратность",1,1);
			ТребуетсяЗаполнениеСуммРегУчета = Истина;
			
		ИначеЕсли (ВнешняяТаблицаУслуг <> Неопределено) Тогда 
			
			ТребуетсяЗаполнениеСуммРегУчета = Ложь; 
			
		// документ в валюте, отличной от базовой валюты учета
		Иначе
			Если ((Документ.Договор.ВзаиморасчетыВУЕ И РежимВводНачальныхОстатков И ЕстьАкт) ИЛИ Документ.УЕ_ПользовательскийКурс) Тогда
				ТребуетсяЗаполнениеСуммРегУчета = Истина;
				Если  Документ.УЕ_ПользовательскийКурс Тогда
					Курс = Новый Структура("Курс,Кратность",Документ.УЕ_Курс,Документ.УЕ_Кратность);
				Иначе
					Курс = Новый Структура("Курс,Кратность",Документ.КурсВзаиморасчетовБУ,1);
				КонецЕсли; 
			Иначе
				Если (НЕ Документ.Договор.ВзаиморасчетыВУЕ 
					ИЛИ РежимВводНачальныхОстатков 
					ИЛИ НЕ ПровестиПоБухгалтерскомуУчету
					ИЛИ (Документ.Договор.ВзаиморасчетыВУЕ И НЕ ЕстьАкт И ЕстьСчет)) 
				Тогда
					
				ТребуетсяЗаполнениеСуммРегУчета = Истина; 
				Если Документ.ФормироватьВедомыеДатойДокумента Тогда
					ДатаКурса = ?(ЗначениеЗаполнено(Документ.Дата), Документ.Дата, ТекущаяДата());	
				Иначе
					Если (ЕстьАкт) Тогда
						ДатаКурса = ДатаАкта;
					Иначе
						Если (ЕстьСчет) Тогда 
							ДатаКурса = ДатаСчета;
						Иначе
							ДатаКурса = Документ.Дата;
						КонецЕсли;
					КонецЕсли; 
				КонецЕсли;
					Курс = CW_Финансы.ПолучитьКурсВалюты(Документ.Валюта,ДатаКурса);
				КонецЕсли; 
			КонецЕсли; 
		КонецЕсли; 
		
		Если (ТребуетсяЗаполнениеСуммРегУчета) Тогда
			Для каждого СтрокаУслуги Из ТаблицаДвиженийПоОсновнымРегистрам Цикл
				СтрокаУслуги.Всего_Рег = Окр(CW_Финансы.ПересчитатьИзВалютыВВалюту(СтрокаУслуги.Всего, Документ.Валюта, Свойства.КО.ВалютаРегламентированногоУчета, Курс.Курс, 1, Курс.Кратность, 1),2,1);
				СтрокаУслуги.Сумма_Рег = Окр(CW_Финансы.ПересчитатьИзВалютыВВалюту(СтрокаУслуги.Сумма, Документ.Валюта, Свойства.КО.ВалютаРегламентированногоУчета, Курс.Курс, 1, Курс.Кратность, 1),2,1);
				СтрокаУслуги.НДС_Рег = СтрокаУслуги.Всего_Рег-СтрокаУслуги.Сумма_Рег;
			КонецЦикла; 
		КонецЕсли;	

		
		// формируем движения 
		Для каждого СтрокаУслуги Из ТаблицаУслуг Цикл
			
			// регистр "CW_РасходыПоПриобретениям"
			Движение 					= НЗ_Расходы.Добавить();
			
			Движение.Период         	= Документ.Дата;
			Движение.ДокументЗатрат  	= Документ;
			Движение.Организация     	= Документ.Организация;
			Движение.Контрагент     	= Документ.Контрагент;
			Движение.Договор        	= Документ.Договор;
			
			//Подсистема.УчетПриложенийДоговоров
			Движение.ПриложениеКДоговору = Документ.ПриложениеКДоговору;
			//Подсистема.УчетПриложенийДоговоров
			
			Движение.Валюта         	= Документ.Валюта;
			
			Движение.Номенклатура   	= СтрокаУслуги.Номенклатура;
			Движение.СтатьяЗатрат   	= СтрокаУслуги.СтатьяЗатрат;
			Движение.СтавкаНДС			= СтрокаУслуги.СтавкаНДС;
			
			Движение.СчетЗатрат         = СтрокаУслуги.СчетЗатрат;
			Движение.Субконто1         	= СтрокаУслуги.Субконто1;
			Движение.Субконто2         	= СтрокаУслуги.Субконто2;
			Движение.Субконто3         	= СтрокаУслуги.Субконто3;
			
			Движение.УчетНДС         	= СтрокаУслуги.УчитыватьНДС;
			Движение.СчетНДС         	= СтрокаУслуги.СчетНДС;
			
			Движение.Количество      	= СтрокаУслуги.Количество;

			Движение.ВалютнаяСумма 		= СтрокаУслуги.Сумма;
			Движение.ВалютнаяСуммаНДС 	= СтрокаУслуги.НДС;
			Движение.ВалютнаяСуммаВсего = СтрокаУслуги.Всего;
			
			Движение.Сумма		       	= СтрокаУслуги.Сумма_Рег;
			Движение.СуммаНДС	        = СтрокаУслуги.НДС_Рег;
			Движение.СуммаВсего		    = СтрокаУслуги.Всего_Рег;
			
			Движение.Примечание		    = СтрокаУслуги.Представление;
			
		КонецЦикла; // перебор строк таблицы услуг 
		
	#КонецОбласти 
	
	#Область НаборыДвиженийОперативногоУчета
		НЗ_ОЗ 				= _сф.НаборЗаписейПоРегистратору(РегистрыНакопления.CW_ОперативнаяКредиторскаяЗадолженность,Документ);
		НЗ_ОплатаДокументов = _сф.НаборЗаписейПоРегистратору(РегистрыСведений.CW_ОплатаВходящихДокументов,Документ);
	#КонецОбласти 
	
	#Область ОперативнаяЗадолженность 
		
		Если (ИспользуетсяОперативнаяЗадолженность) Тогда
			
			#Область Параметры 
			
				ВалютныйДокумент = (Документ.Валюта <> Свойства.КО.ВалютаРегламентированногоУчета);
				РасчетыУЕ = (Документ.Договор.ВзаиморасчетыВУЕ);
				РасчетыВалюта = ((НЕ РасчетыУЕ) И ВалютныйДокумент);
				
				// требуется определить счета учета
				Для каждого Стр Из ТаблицаУслуг Цикл
					Если (НЕ ВалютныйДокумент) Тогда
						Стр.Всего_Рег = Стр.Всего;
					КонецЕсли; 
				КонецЦикла;
				
				// параметры свёртки
				Если (ЕстьСчет ИЛИ ЕстьАкт) Тогда
					
					СтрокаГруппировки = "Грузоперевозка,Счет";
					Если КонтрольНоменклатуры Тогда
						_сф.стр_Добавить(СтрокаГруппировки,",Номенклатура");
					КонецЕсли; 
					Если КонтрольПорядкаОтражения Тогда
						_сф.стр_Добавить(СтрокаГруппировки,",ПорядокОтражения");
					КонецЕсли; 
					Если КонтрольНДС Тогда
						_сф.стр_Добавить(СтрокаГруппировки,",СтавкаНДС");
					КонецЕсли; 
					Если РежимВводначальныхОстатков_ОЗ Тогда
						СтрокаСвертки = "ОЗ_Всего";
						Если КонтрольНДС Тогда
							_сф.стр_Добавить(СтрокаСвертки,",ОЗ_Сумма,ОЗ_НДС");
						КонецЕсли; 
					Иначе
						СтрокаСвертки = "Всего";
						Если КонтрольНДС Тогда
							_сф.стр_Добавить(СтрокаСвертки,",Сумма,НДС");
						КонецЕсли; 	
					КонецЕсли; 
				КонецЕсли; 
			
			#КонецОбласти 
			
			#Область РабочийРежим 
				
				Если (НЕ РежимВводначальныхОстатков_ОЗ) Тогда
					
					// начисление задолженности
					Если (ЕстьСчет) Тогда
						
						ТребуетсяПересчет = Ложь;
						
						Если Документ.УЕ_ПользовательскийКурс Тогда
							КурсСчета = Новый Структура("Курс,Кратность",Документ.УЕ_Курс,Документ.УЕ_Кратность);
						Иначе 
							КурсСчета = CW_Финансы.ПолучитьКурсВалюты(Документ.Валюта,Документ.ДатаСчета);
						КонецЕсли;
						Если (ЕстьАкт И ДатаАкта <> Документ.ДатаСчета) Тогда
							ТребуетсяПересчет = Истина;
						КонецЕсли; 
						
						ТаблицаОЗ = ТаблицаУслуг.Скопировать();
						ТаблицаОЗ.Свернуть("СчетЗадолженности","Всего,Всего_Рег");
						
						ИтогоПоНачислению_Валюта = 0;
						ИтогоПоНачислению = 0;
						
						АналитикаКурсовыхРазниц = _сф.т_Создать("Аналитика,Счет,ВалютнаяСуммаЗачета,СуммаЗачета");
						
						Для каждого Стр Из ТаблицаОЗ Цикл
							
							Движение = НЗ_ОЗ.Добавить();
							// --- 
							Движение.ВидДвижения	= ВидДвиженияНакопления.Приход;
							Движение.Период 		= Документ.ДатаСчета;
							Движение.Организация 	= Документ.Организация;
							Движение.Контрагент 	= Документ.Контрагент;
							Движение.Договор 		= Документ.Договор;
							
							//Подсистема.УчетПриложенийДоговоров
							Движение.ПриложениеКДоговору = Документ.ПриложениеКДоговору;
							//Подсистема.УчетПриложенийДоговоров
							
							Движение.Валюта 		= Документ.Валюта;
							Движение.Счет 			= Документ.Ссылка;
							Движение.СчетУчета 		= Стр.СчетЗадолженности;
							// --- 
							Движение.Всего_Валюта	= Стр.Всего;
							Движение.Всего	 		= Стр.Всего_Рег;
							
							_сф.Инкремент(ИтогоПоНачислению_Валюта,Движение.Всего_Валюта);
							_сф.Инкремент(ИтогоПоНачислению,Движение.Всего);
							// --- 
							Движение.ВидОперации=Перечисления.CW_ВидыДвиженийПоОперативнойЗадолженности.Начисление;
							
						КонецЦикла; 
						
						ТребуетсяПересчетДляОЗ = (Документ.Валюта <> Свойства.КО.ВалютаРегламентированногоУчета);
						
						ИтогоПоСписанию_Валюта = 0;
						ИтогоПоСписанию = 0;
						
						
						СтруктураПараметров = CW_Настройки.ПустаяСтруктураПолученияПараметровДоговора();
						СтруктураПараметров.Дата 				= Документ.Дата;
						СтруктураПараметров.Договор 			= Документ.Договор;
						СтруктураПараметров.ПриложениеКДоговору = Документ.ПриложениеКДоговору;
						
						ПараметрыДоговора	= CW_Настройки.ПолучитьПараметрыДоговора(СтруктураПараметров, "НалоговыйАгент_НДСЗаСчетСредствПоставщика");
						КомпенсацияНДС 		= ПараметрыДоговора.НалоговыйАгент_НДСЗаСчетСредствПоставщика;
						
						УчетныйДоговор		= CW_Финансы.ПолучитьУчетныйДоговор(СтруктураПараметров);
						НалоговыйАгент 		= УчетныйДоговор.УчетАгентскогоНДС;

						Если (НалоговыйАгент И КомпенсацияНДС) Тогда
							
							СтавкаНДСЧислом = CW_Финансы.ПолучитьКоэффициентСтавкиНДС(Перечисления.ВидыСтавокНДС.ОбщаяРасчетная, Документ.Дата);
							НДС_Валюта 		= Окр(Документ.СуммаДокумента*СтавкаНДСЧислом,2);
							
							Курс = CW_Финансы.ПолучитьКурсВалюты(Документ.Валюта,Документ.ДатаСчета);
							НДС_БазоваяВалюта = CW_Финансы.ПересчитатьИзВалютыВВалюту(НДС_Валюта,Документ.Валюта,Свойства.КО.ВалютаРегламентированногоУчета,Курс.Курс, 1, Курс.Кратность, 1);
							
							// --- 
							
							Движение = НЗ_ОЗ.Добавить();
							// --- 
							Движение.ВидДвижения	= ВидДвиженияНакопления.Расход;
							Движение.Период 		= Документ.ДатаСчета;
							Движение.Организация 	= Документ.Организация;
							Движение.Контрагент 	= Документ.Контрагент;
							Движение.Договор 		= Документ.Договор;
							
							//Подсистема.УчетПриложенийДоговоров
							Движение.ПриложениеКДоговору = Документ.ПриложениеКДоговору;
							//Подсистема.УчетПриложенийДоговоров
							
							Движение.Валюта 		= Документ.Валюта;
							Движение.Счет 			= Документ.Ссылка;
							Движение.СчетУчета 		= Стр.СчетЗадолженности;
							// --- 
							Движение.Всего_Валюта	= НДС_Валюта;
							Движение.Всего	 		= НДС_БазоваяВалюта;
							// --- 
							Движение.ВидОперации=Перечисления.CW_ВидыДвиженийПоОперативнойЗадолженности.Оплата;
							
						КонецЕсли; 
						
						Если (_сф.Количество(Документ.ЗачетАвансовОЗ) <> 0) Тогда
							
							//есть данные для зачета аванса ОЗ
							ЗапросАвансы = Новый Запрос;
							ЗапросАвансы.Текст = "ВЫБРАТЬ
							                     |	ЗачетАвансовОЗ.СчетЗадолженности КАК СчетЗадолженности,
							                     |	ЗачетАвансовОЗ.ДокументОплаты КАК ДокументОплаты,
							                     |	ЗачетАвансовОЗ.СуммаЗачета КАК СуммаЗачета
							                     |ПОМЕСТИТЬ ВТ_ДанныеЗачетаАванса
							                     |ИЗ
							                     |	&ЗачетАвансовОЗ КАК ЗачетАвансовОЗ
							                     |;
							                     |
							                     |////////////////////////////////////////////////////////////////////////////////
							                     |ВЫБРАТЬ
							                     |	ВТ_ДанныеЗачетаАванса.ДокументОплаты КАК ДокументОплаты,
							                     |	ВТ_ДанныеЗачетаАванса.СчетЗадолженности КАК СчетЗадолженности,
							                     |	ВТ_ДанныеЗачетаАванса.СуммаЗачета КАК СуммаЗачета,
							                     |	ЕСТЬNULL(CW_ОперативнаяКредиторскаяЗадолженностьОстатки.ВсегоОстаток, 0) КАК ВсегоОстаток,
							                     |	ЕСТЬNULL(CW_ОперативнаяКредиторскаяЗадолженностьОстатки.Всего_ВалютаОстаток, 0) КАК Всего_ВалютаОстаток
							                     |ИЗ
							                     |	ВТ_ДанныеЗачетаАванса КАК ВТ_ДанныеЗачетаАванса
							                     |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.CW_ОперативнаяКредиторскаяЗадолженность.Остатки(
							                     |				&ДатаОстатка,
							                     |				(Счет, СчетУчета) В
							                     |					(ВЫБРАТЬ
							                     |						ВТ_ДанныеЗачетаАванса.ДокументОплаты КАК ДокументОплаты,
							                     |						ВТ_ДанныеЗачетаАванса.СчетЗадолженности КАК СчетЗадолженности
							                     |					ИЗ
							                     |						ВТ_ДанныеЗачетаАванса КАК ВТ_ДанныеЗачетаАванса)) КАК CW_ОперативнаяКредиторскаяЗадолженностьОстатки
							                     |		ПО ВТ_ДанныеЗачетаАванса.ДокументОплаты = CW_ОперативнаяКредиторскаяЗадолженностьОстатки.Счет
							                     |			И ВТ_ДанныеЗачетаАванса.СчетЗадолженности = CW_ОперативнаяКредиторскаяЗадолженностьОстатки.СчетУчета";
							
							ЗапросАвансы.УстановитьПараметр("ДатаОстатка"		, Документ.ДатаСчета);
							ЗапросАвансы.УстановитьПараметр("ЗачетАвансовОЗ"	, Документ.ЗачетАвансовОЗ.Выгрузить());
							
							ВыборкаАвансы = ЗапросАвансы.Выполнить().Выбрать();
							
							Пока ВыборкаАвансы.Следующий() Цикл
								
								Если ВыборкаАвансы.СуммаЗачета = ВыборкаАвансы.Всего_ВалютаОстаток Тогда
									Сумма_Всего = ВыборкаАвансы.ВсегоОстаток;
								Иначе
									Если ВыборкаАвансы.Всего_ВалютаОстаток <> 0 Тогда
										КурсОстатка =  ВыборкаАвансы.ВсегоОстаток / ВыборкаАвансы.Всего_ВалютаОстаток;
										Сумма_Всего = КурсОстатка * ВыборкаАвансы.СуммаЗачета; 
									Иначе
										Сумма_Всего = 0;
									КонецЕсли;
								КонецЕсли;
								
								Если Сумма_Всего = 0 тогда
									Продолжить;
								КонецЕсли;
								
								Движение = НЗ_ОЗ.Добавить();
								// --- 
								Движение.ВидДвижения	= ВидДвиженияНакопления.Расход;
								Движение.Период 		= Документ.ДатаСчета;
								Движение.Организация 	= Документ.Организация;
								Движение.Контрагент 	= Документ.Контрагент;
								Движение.Договор 		= Документ.Договор;
								
								//Подсистема.УчетПриложенийДоговоров
								Движение.ПриложениеКДоговору = Документ.ПриложениеКДоговору;
								//Подсистема.УчетПриложенийДоговоров
								
								Движение.Валюта 		= Документ.Валюта;
								Движение.Счет 			= Документ.Ссылка;
								Движение.СчетУчета 		= ВыборкаАвансы.СчетЗадолженности;
								
								Движение.Всего_Валюта	= ВыборкаАвансы.СуммаЗачета;
								
								Движение.Всего	 		= Сумма_Всего;
								
								_сф.Инкремент(ИтогоПоСписанию_Валюта,Движение.Всего_Валюта);
								_сф.Инкремент(ИтогоПоСписанию,Движение.Всего);
								
								Движение.ВидОперации	= Перечисления.CW_ВидыДвиженийПоОперативнойЗадолженности.ЗачетАванса;
								
								
								// сторно ОЗ по платежке
								// ---------------------------------------------------------------------------- 
								Движение = НЗ_ОЗ.Добавить();
								// --- 
								Движение.ВидДвижения	= ВидДвиженияНакопления.Расход;
								Движение.Период 		= Документ.ДатаСчета;
								Движение.Организация 	= Документ.Организация;
								Движение.Контрагент 	= Документ.Контрагент;
								Движение.Договор 		= Документ.Договор;
								
								//Подсистема.УчетПриложенийДоговоров
								Движение.ПриложениеКДоговору = Документ.ПриложениеКДоговору;
								//Подсистема.УчетПриложенийДоговоров
								
								Движение.Валюта 		= Документ.Валюта;
								Движение.Счет 			= ВыборкаАвансы.ДокументОплаты;
								Движение.СчетУчета 		= ВыборкаАвансы.СчетЗадолженности;
								// --- 
								Движение.Всего_Валюта	= - ВыборкаАвансы.СуммаЗачета;
								Движение.Всего	 		= - Сумма_Всего;
								
								Движение.ВидОперации=Перечисления.CW_ВидыДвиженийПоОперативнойЗадолженности.ЗачетАванса;
									

								// привязка счёт - платежка - сумма
								Движение = НЗ_ОплатаДокументов.Добавить();
								Движение.Период 			= Документ.Дата;
								Движение.Документ 			= Документ;
								Движение.СчетЗадолженности 	= ВыборкаАвансы.СчетЗадолженности;
								Движение.ДокументОплаты 	= ВыборкаАвансы.ДокументОплаты;
								Движение.Всего 				= ВыборкаАвансы.СуммаЗачета;	
								
								
								СтруктураПарамтеров = Новый Структура;
								СтруктураПарамтеров.Вставить("Дата", 			Документ.Дата);
								СтруктураПарамтеров.Вставить("ВалютаОбъекта", 	Документ.Валюта);
								СтруктураПарамтеров.Вставить("Организация",		Документ.Организация);
								СтруктураПарамтеров.Вставить("Контрагент",		Документ.Контрагент);
								СтруктураПарамтеров.Вставить("Договор",			Документ.Договор);
								
								//Подсистема.УчетПриложенийДоговоров
								СтруктураПарамтеров.Вставить("ПриложениеКДоговору", Документ.ПриложениеКДоговору);
								//Подсистема.УчетПриложенийДоговоров
								
								СтруктураПарамтеров.Вставить("ДатаСреза", 		Документ.МоментВремени());
								СтруктураПарамтеров.Вставить("Набор",			НЗ_ОЗ);
								СтруктураПарамтеров.Вставить("ИмяРегистраОперативнойЗадолженности",	"CW_ОперативнаяКредиторскаяЗадолженность");
								
								CW_Финансы.СписаниеКурсовыеПоОперативнойЗадолженности(СтруктураПарамтеров);

							КонецЦикла;
							
						КонецЕсли; 
						
					КонецЕсли; 
					
					// отражение счетов и актов
					Если ЕстьСчет  Тогда
						
							Если (_сф.Количество(Документ.ЗачетАвансов) <> 0) Тогда
								
								Для каждого Стр Из Документ.ЗачетАвансов Цикл
									
									Если (ЗначениеЗаполнено(Стр.Счет)) Тогда
										
										ДвижениеОД = НЗ_ОплатаДокументов.Добавить();
										ДвижениеОД.Период = Документ.Дата;
										ДвижениеОД.Документ = Стр.Счет;
										ДвижениеОД.ДокументБУ = Документ;
										ДвижениеОД.СчетЗадолженности = Стр.СчетЗадолженности;
										ДвижениеОД.ДокументОплаты = Стр.ДокументОплаты;
										ДвижениеОД.Всего = Стр.СуммаЗачета;	
										ДвижениеОД.ПризнакАкта = Истина;
										
									КонецЕсли; 
									
								КонецЦикла; 
								
							КонецЕсли; 
							
						КонецЕсли; 
						
					
				КонецЕсли; 
				
			#КонецОбласти 
			
		КонецЕсли; // используется оперативная задолженность 
	
	#КонецОбласти 
	
	#Область ЗаписьДвижений
		НЗ_Расходы.Записать(Истина);
		НЗ_ОЗ.Записать(Истина);
		НЗ_ОплатаДокументов.Записать(Истина);
	#КонецОбласти 
	
КонецПроцедуры

Процедура СформироватьДвиженияДляКорректировкиРасходов(Документ,Отказ=Ложь,Свойства=Неопределено) Экспорт 
	
	Если (Документ.ПометкаУдаления) Тогда
		
		Отказ = Истина;
		Сообщить("Документ """+Строка(Документ)+""" помечен на удаление. Нарушена синхронизация пометок удаления!");
		Возврат;
		
	КонецЕсли; 
	
	// ---------------------------------------------------------------------------- 
	
	// параметры - таблица услуг для УЕ
	Если (Свойства = Неопределено) Тогда
		
		СтруктураПараметров = CW_Настройки.ПустаяСтруктураПолученияПараметровДоговора();
		СтруктураПараметров.Дата 				= Документ.Дата;
		СтруктураПараметров.Договор 			= Документ.Договор;
		СтруктураПараметров.ПриложениеКДоговору = Документ.ПриложениеКДоговору;
		
		ПараметрыДоговора	= CW_Настройки.ПолучитьПараметрыДоговора(СтруктураПараметров);
		
		СКонстанты = Новый Структура;
		СКонстанты.Вставить("ВалютаРегламентированногоУчета",CW_Настройки.ВалютаРегламентированногоУчета());
		
		Свойства = Новый Структура;
		Свойства.Вставить("КО", СКонстанты);
		Свойства.Вставить("ПД", ПараметрыДоговора);
	КонецЕсли;
	
	// ---------------------------------------------------------------------------- 
	ВалютаРегламентированногоУчетаРубль 	= ПолучитьФункциональнуюОпцию("CW_ВалютаРегламентированногоУчетаРубль");
	
	ЕстьСчет = (Документ.ПредъявленСчет);	
	ЕстьАкт = (Документ.ПредъявленАкт ИЛИ Документ.ПредъявленСФ или НЕ ВалютаРегламентированногоУчетаРубль);
	
	//Подситема.СтатусыДокументов
	СтатусДокумента = Неопределено;
	Если Свойства.Свойство("СтатусДокумента") Тогда
		СтатусДокумента = Свойства.СтатусДокумента;
	Иначе
		ДанныеСтатуса 	= РегистрыСведений.CW_СтатусыДокументов.ПолучитьДанныеСтатусаДокумента(Документ);
		СтатусДокумента	= ДанныеСтатуса.СтатусДокумента;
	КонецЕсли;
	
	СтатусДокументаПроводитьПоБухгалтерскомуУчету = CW_СтатусыДокументовСервер.ПолучитьПризнакПроведенияПоБухгалтерскомуУчету(Документ, СтатусДокумента);
	//Подситема.СтатусыДокументов
	
	СтруктураПараметровБухУчета = Новый Структура;
	СтруктураПараметровБухУчета.Вставить("Договор", 				Документ.Договор);
	СтруктураПараметровБухУчета.Вставить("ПриложениеКДоговору",		Документ.ПриложениеКДоговору);
	
	ПараметрыБухгалтерскогоУчета  = CW_Финансы.ПолучитьПарметрыВеденияБухгалтерскогоУчета(СтруктураПараметровБухУчета, Документ.Дата);
	ПровестиПоБухгалтерскомуУчету = ПараметрыБухгалтерскогоУчета.БухгалтерскийУчет и СтатусДокументаПроводитьПоБухгалтерскомуУчету;
	
	СтруктураНастроек = CW_Настройки.ПолучитьНастройкиОперативногоУчета(Документ.Организация, Перечисления.CW_ВидыОперативнойЗадолженности.Кредиторская, Документ.Дата);
	ИспользуетсяОперативнаяЗадолженность = СтруктураНастроек["ВедетсяОперативныйУчет"];

	НастройкиОперативногоУчета = СтруктураНастроек["НастройкиОперативногоУчета"];
	КонтрольНоменклатуры 		= НастройкиОперативногоУчета ["КонтрольНоменклатуры"];
	КонтрольПорядкаОтражения 	= НастройкиОперативногоУчета ["КонтрольПорядкаОтражения"];
	КонтрольНДС 				= НастройкиОперативногоУчета ["КонтрольНДС"];
	
	// ---------------------------------------------------------------------------- 
	
	#Область НаборыДвиженийПоОсновнымРегистрам
	
	НЗ_Расходы 					= _сф.НаборЗаписейПоРегистратору(РегистрыНакопления.CW_РасходыПоГрузоперевозкам,Документ);
	НЗ_Перевыставление 			= _сф.НаборЗаписейПоРегистратору(РегистрыНакопления.CW_Перевыставление,Документ);
	НЗ_ПеревыставлениеПоСтавкам = _сф.НаборЗаписейПоРегистратору(РегистрыНакопления.CW_ПеревыставлениеПоСтавкам,Документ);
	
	ПараметрыУчетнойПолитикиБП 	= CW_Настройки.ПараметрыГлобальнойУчетнойПолитики(Документ.Дата, Документ.Организация);
	
	//Подсистема.УчетНЗП  
	ПараметрыУчетнойПолитики = CW_Настройки.ПараметрыУчетнойПолитики(Документ.Дата, Документ.Организация);

	Если Документ.ПредъявленАкт 
		И ПолучитьФункциональнуюОпцию("CW_ВедетсяУчетНЗП") 
		и ПараметрыУчетнойПолитики.ВедетсяУчетНЗП Тогда  
		
		ПорядокОтраженияДляНЗП 	= CW_УчетНЗПСервер.ПолучитьПорядокОтраженияДляУчетаВСоставеНЗП();
		мСоставЗатрат 			= ПорядокОтраженияДляНЗП["Расходы"];
		
		НЗ_НЗП = _сф.НаборЗаписейПоРегистратору(РегистрыНакопления.CW_НезавершенноеПроизводство, Документ); 
		
	КонецЕсли;
	//Подсистема.УчетНЗП

	#КонецОбласти
	
	#Область ОсновныеРегистры 
	
	// получаем таблицу услуг
	ТаблицаУслуг = Документ.Услуги.Выгрузить();
	CW_Финансы.ДобавитьКолонкиБазовойВалюты(ТаблицаУслуг);
	// --- 
	МассивУдаляемых = Новый Массив;
	Для каждого Стр Из ТаблицаУслуг Цикл
		
		Стр.Количество = Стр.Количество - Стр.Количество_ДоКорректировки;
		Стр.Цена = Стр.Цена - Стр.Цена_ДоКорректировки;
		Стр.Сумма = Стр.Сумма - Стр.Сумма_ДоКорректировки;
		Стр.НДС = Стр.НДС - Стр.НДС_ДоКорректировки;
		Стр.Всего = Стр.Всего - Стр.Всего_ДоКорректировки;
		// --- 
		//Если (Стр.Сумма = 0 И Стр.НДС = 0 И Стр.Всего = 0) Тогда
		//	МассивУдаляемых.Добавить(Стр);
		//КонецЕсли; 
		
	КонецЦикла; 
	
	// определяем курс для пересчёта рублёвого эквивалента для отражения по регистру "Доходы"
	// если они не рассчитаны в подписке
	ТребуетсяЗаполнениеСуммРегУчета = Истина;
	Если (Документ.Валюта = Свойства.КО.ВалютаРегламентированногоУчета) Тогда
		
		Курс = Новый Структура("Курс,Кратность",1,1);
		
	Иначе
		
		ДатаКурса = Документ.КорректируемыйДокумент.Дата;
		// или дата счёта/акта
		Курс = CW_Финансы.ПолучитьКурсВалюты(Документ.Валюта,ДатаКурса);
		
	КонецЕсли; 
	
	// получаем данные по рублёвым суммам
	Если (Документ.Валюта <> Свойства.КО.ВалютаРегламентированногоУчета) Тогда
		
		Если (ПровестиПоБухгалтерскомуУчету И Документ.ПредъявленАкт 
			И ЗначениеЗаполнено(Документ.ВедомыйДокументКорректировки)) Тогда
			
			Если НЕ Документ.ПоказатьРубли Тогда
				
				// получаем данные по рублёвым суммам документа корректировки
				Запрос = Новый Запрос;
				Запрос.Текст = "ВЫБРАТЬ
				|	РублевыеСуммыДокументовВВалюте.ТабличнаяЧастьДокумента,
				|	РублевыеСуммыДокументовВВалюте.НомерСтрокиДокумента,
				|	РублевыеСуммыДокументовВВалюте.Всего,
				|	РублевыеСуммыДокументовВВалюте.НДС,
				|	ВЫБОР
				|		КОГДА РублевыеСуммыДокументовВВалюте.НДС = 0
				|			ТОГДА РублевыеСуммыДокументовВВалюте.Всего
				|		ИНАЧЕ РублевыеСуммыДокументовВВалюте.Всего - РублевыеСуммыДокументовВВалюте.НДС
				|	КОНЕЦ КАК Сумма
				|ИЗ
				|	РегистрСведений.РублевыеСуммыДокументовВВалюте КАК РублевыеСуммыДокументовВВалюте
				|ГДЕ
				|	РублевыеСуммыДокументовВВалюте.Регистратор = &Регистратор";
				Запрос.УстановитьПараметр("Регистратор", Документ.ВедомыйДокументКорректировки);
				ТЗ = Запрос.Выполнить().Выгрузить();
				// --- 
				ТЧ_Собственные_ДоИзменения = Перечисления.ТабличныеЧастиДокументов.УслугиДоИзменения;
				ТЧ_Собственные_ПослеИзменения = Перечисления.ТабличныеЧастиДокументов.Услуги;
				// --- 
				ТЧ_Возмещаемые_ДоИзменения = Перечисления.ТабличныеЧастиДокументов.АгентскиеУслугиДоИзменения;
				ТЧ_Возмещаемые_ПослеИзменения = Перечисления.ТабличныеЧастиДокументов.АгентскиеУслуги;
				// --- 
				НомерСтроки_Собственные = 0;
				НомерСтроки_Возмещаемые = 0;
				// --- 
				Для каждого Стр Из ТаблицаУслуг Цикл
					
					Если (Стр.ПорядокОтражения = Перечисления.CW_ПорядокОтраженияЗатрат.Затраты)
						ИЛИ (Стр.ПорядокОтражения = Перечисления.CW_ПорядокОтраженияЗатрат.ПрочиеРасходы) Тогда
						
						_сф.Инкремент(НомерСтроки_Собственные);
						// --- 
						СтрокаДоИзменения = _сф.к_НайтиСтроку(ТЗ,Новый Структура("ТабличнаяЧастьДокумента,НомерСтрокиДокумента", ТЧ_Собственные_ДоИзменения,НомерСтроки_Собственные));
						СтрокаПослеИзменения = _сф.к_НайтиСтроку(ТЗ,Новый Структура("ТабличнаяЧастьДокумента,НомерСтрокиДокумента", ТЧ_Собственные_ПослеИзменения,НомерСтроки_Собственные));
						// --- 
						Стр.Сумма_Рег = СтрокаДоИзменения.Сумма + СтрокаПослеИзменения.Сумма;
						Стр.НДС_Рег = СтрокаДоИзменения.НДС + СтрокаПослеИзменения.НДС;
						Стр.Всего_Рег = СтрокаДоИзменения.Всего + СтрокаПослеИзменения.Всего;
						
					Иначе
						
						_сф.Инкремент(НомерСтроки_Возмещаемые);
						// --- 
						СтрокаДоИзменения = _сф.к_НайтиСтроку(ТЗ,Новый Структура("ТабличнаяЧастьДокумента,НомерСтрокиДокумента", ТЧ_Возмещаемые_ДоИзменения,НомерСтроки_Возмещаемые));
						СтрокаПослеИзменения = _сф.к_НайтиСтроку(ТЗ,Новый Структура("ТабличнаяЧастьДокумента,НомерСтрокиДокумента", ТЧ_Возмещаемые_ПослеИзменения,НомерСтроки_Возмещаемые));
						
						Стр.Сумма_Рег = СтрокаДоИзменения.Сумма + СтрокаПослеИзменения.Сумма;
						Стр.НДС_Рег = СтрокаДоИзменения.НДС + СтрокаПослеИзменения.НДС;
						Стр.Всего_Рег = СтрокаДоИзменения.Всего + СтрокаПослеИзменения.Всего;   
						
					КонецЕсли; 
					
				КонецЦикла; 
				
			Иначе //В случае если в документы РПГ в у.е. установлден флаг "документ оказания услуг получен в руб. (покзатьрубли)"
					
				// получаем суммы из документа
				Для каждого Стр Из ТаблицаУслуг Цикл
					Стр.Сумма_Рег 	= -Стр.Сумма_ДоКорректировкиРег + Стр.СуммаРег;
					Стр.НДС_Рег 	= -Стр.НДС_ДоКорректировкиРег + Стр.НДСРег;
					Стр.Всего_Рег 	= -Стр.Всего_ДоКорректировкиРег + Стр.ВсегоРег;
				КонецЦикла;  
		
			КонецЕсли;
			
			
		Иначе 
			
			Для каждого СтрокаУслуги Из ТаблицаУслуг Цикл
				СтрокаУслуги.Всего_Рег = Окр(CW_Финансы.ПересчитатьИзВалютыВВалюту(СтрокаУслуги.Всего, Документ.Валюта, Свойства.КО.ВалютаРегламентированногоУчета, Курс.Курс, 1, Курс.Кратность, 1),2,1);
				СтрокаУслуги.Сумма_Рег = Окр(CW_Финансы.ПересчитатьИзВалютыВВалюту(СтрокаУслуги.Сумма, Документ.Валюта, Свойства.КО.ВалютаРегламентированногоУчета, Курс.Курс, 1, Курс.Кратность, 1),2,1);
				СтрокаУслуги.НДС_Рег = Окр(CW_Финансы.ПересчитатьИзВалютыВВалюту(СтрокаУслуги.НДС, Документ.Валюта, Свойства.КО.ВалютаРегламентированногоУчета, Курс.Курс, 1, Курс.Кратность, 1),2,1);
			КонецЦикла;
			
		КонецЕсли;
		
		
		// --- 
		
	Иначе
		
		// переносим суммы как есть
		Для каждого Стр Из ТаблицаУслуг Цикл
			
			Стр.Сумма_Рег = Стр.Сумма;
			Стр.НДС_Рег = Стр.НДС;
			Стр.Всего_Рег = Стр.Всего;
			
		КонецЦикла; 
		
	КонецЕсли; 
	// --- 
	//// удаляем пустые строки
	//_сф.к_УдалитьЭлементыПоМассиву(ТаблицаУслуг,МассивУдаляемых);
	
	ТаблицаУслугКорректируемогоДокумента = CW_Финансы.ПолучитьУслугиДокумента(Документ.КорректируемыйДокумент); 
	
	МаксИндексСтроки = ТаблицаУслугКорректируемогоДокумента.Количество()-1;
	
	
	//Подсистема.УчетНЗП
	ГрузоперевозкиДокумента = ТаблицаУслуг.ВыгрузитьКолонку("Грузоперевозка");
	ГрузоперевозкиНЗП = CW_УчетНЗПСервер.ПолучитьМассивГрузоперевозокПоНЗП(ГрузоперевозкиДокумента, ПараметрыУчетнойПолитики.НЗППараметрНеВключать);
	//---Подсистема.УчетНЗП
	
	// формируем движения 
	Индекс = 0;
	Для каждого СтрокаУслуги Из ТаблицаУслуг Цикл
		
		// регистр "CW_РасходыПоГрузоперевозкам"
		Движение = НЗ_Расходы.Добавить();
		Движение.Период         	= Документ.Дата;
		Движение.Грузоперевозка 	= СтрокаУслуги.Грузоперевозка;
		Движение.Контрагент     	= Документ.Контрагент;
		Движение.Договор        	= Документ.Договор;
		
		//Подсистема.УчетПриложенийДоговоров
		Движение.ПриложениеКДоговору = Документ.ПриложениеКДоговору;
		//Подсистема.УчетПриложенийДоговоровъ
		
		Движение.ДокументРасходов  	= Документ;
		Движение.СтатьяЗатрат   	= СтрокаУслуги.СтатьяЗатрат;
		Движение.Номенклатура   	= СтрокаУслуги.Номенклатура;
		Движение.СтавкаНДС			= СтрокаУслуги.СтавкаНДС;
		Движение.Валюта         	= Документ.Валюта;
		Движение.СтатьяБюджета      = СтрокаУслуги.СтатьяБюджета;  
		
		Движение.Сумма_Валюта   	= СтрокаУслуги.Сумма;
		Движение.НДС_Валюта   		= СтрокаУслуги.НДС;
		Движение.Всего_Валюта   	= СтрокаУслуги.Всего;
		Движение.Количество   		= СтрокаУслуги.Количество;
		
		Движение.Всего	= СтрокаУслуги.Всего_Рег;
		Движение.Сумма	= СтрокаУслуги.Сумма_Рег;
		Движение.НДС	= СтрокаУслуги.НДС_Рег;
		
		//Учет входящего НДС в себестоимости
		Если СтрокаУслуги.ПорядокОтражения = Перечисления.CW_ПорядокОтраженияЗатрат.Затраты Тогда 
			
			Если ПараметрыУчетнойПолитикиБП.СистемаНалогообложения = Перечисления.СистемыНалогообложения.АУСН
				или ПараметрыУчетнойПолитикиБП.СистемаНалогообложения = Перечисления.СистемыНалогообложения.Упрощенная Тогда
				
				Движение.Сумма_Валюта 	= СтрокаУслуги.Всего;
				Движение.Сумма			= СтрокаУслуги.ВсегоРег;
				
			ИначеЕсли ЗначениеЗаполнено(СтрокаУслуги.СпособУчетаНДС) 
				И СтрокаУслуги.СпособУчетаНДС = Перечисления.СпособыУчетаНДС.УчитываетсяВCтоимости Тогда
				
				Движение.Сумма_Валюта 	= СтрокаУслуги.Всего;
				Движение.Сумма			= СтрокаУслуги.ВсегоРег;
				
			КонецЕсли; 
			
		КонецЕсли; 
		//---Учет входящего НДС в себестоимости
		
		
		Движение.ПорядокОтражения  	= СтрокаУслуги.ПорядокОтражения;
		Движение.Покупатель	        = СтрокаУслуги.Покупатель;
		
		Движение.ПрочиеРасходы  	= СтрокаУслуги.ПрочиеРасходы;
		
		Если ВариантыПриложений.ЭтоВерсияКОРП() 
			И Не ПараметрыУчетнойПолитики.ГруппировкаЗатратПоПодразделениям Тогда
			Движение.Подразделение = Документ.ПодразделениеОрганизации;	
		ИначеЕсли ВариантыПриложений.ЭтоВерсияПРОФ()  
			И Не ПараметрыУчетнойПолитики.ГруппировкаЗатратПоПодразделениям Тогда
			Движение.Подразделение = ПараметрыУчетнойПолитики.ОсновноеПодразделение;  
		Иначе
			Движение.Подразделение = СтрокаУслуги.Подразделение;	
		КонецЕсли;
		
		Движение.ДоговорПокупателя	= СтрокаУслуги.ДоговорПокупателя;
		
		//Подсистема.УчетПриложенийДоговоров
		Движение.ПриложениеКДоговоруПокупателя = СтрокаУслуги.ПриложениеКДоговору;
		//Подсистема.УчетПриложенийДоговоровъ
		
		Движение.ЭтоСчет        	= Документ.ПредъявленСчет;
		Движение.ЭтоАкт        		= Документ.ПредъявленАкт ИЛИ Документ.ПредъявленСФ;
		Движение.Счет               = ?(Документ.СписокСчетов,СтрокаУслуги.Счет, Документ.Счет);
		// --- 
		
		Если Индекс <= МаксИндексСтроки Тогда
			СтрокаКорректируемого = ТаблицаУслугКорректируемогоДокумента.Получить(Индекс);
			Движение.ПК_Всего			= СтрокаКорректируемого.Всего_Рег + СтрокаУслуги.Всего_Рег;
			Движение.ПК_Сумма			= СтрокаКорректируемого.Сумма_Рег + СтрокаУслуги.Сумма_Рег;
			Движение.ПК_НДС				= СтрокаКорректируемого.НДС_Рег + СтрокаУслуги.НДС_Рег;
		Иначе
			Движение.ПК_Всего			= СтрокаУслуги.Всего_Рег;
			Движение.ПК_Сумма			= СтрокаУслуги.Сумма_Рег;
			Движение.ПК_НДС				= СтрокаУслуги.НДС_Рег;
		КонецЕсли;  
		
		_сф.Инкремент(Индекс);
		
		// ---------------------------------------------------------------------------- 
		
		Если (СтрокаУслуги.ПорядокОтражения = Перечисления.CW_ПорядокОтраженияЗатрат.Перевыставление) Тогда 
			
			Если (ЕстьАкт) Тогда
				
				Движение = НЗ_Перевыставление.Добавить();
				// --- 
				Движение.Период         = Документ.Дата;
				Движение.ВидДвижения    = ВидДвиженияНакопления.Приход;
				Движение.Грузоперевозка = СтрокаУслуги.Грузоперевозка;
				Движение.Номенклатура   = СтрокаУслуги.Номенклатура;
				Движение.Контрагент     = СтрокаУслуги.Покупатель;
				Движение.Договор        = СтрокаУслуги.ДоговорПокупателя;
				
				//Подсистема.УчетПриложенийДоговоров
				Движение.ПриложениеКДоговору = СтрокаУслуги.ПриложениеКДоговору;
				//Подсистема.УчетПриложенийДоговоров				
				
				Движение.ДокументРасходов = Документ;
				Движение.СтавкаНДС      = СтрокаУслуги.СтавкаНДС ;   
				
				Движение.Всего	= СтрокаУслуги.Всего_Рег;
				Движение.Сумма	= СтрокаУслуги.Сумма_Рег;
				Движение.НДС	= СтрокаУслуги.НДС_Рег;  
				
				
				Движение.Количество     = СтрокаУслуги.Количество;
				
			КонецЕсли; 
			
		ИначеЕсли СтрокаУслуги.ПорядокОтражения = Перечисления.CW_ПорядокОтраженияЗатрат.ПеревыставлениеПоСтавкам Тогда 	
			
			Если (ЕстьАкт) Тогда
				
				Движение = НЗ_ПеревыставлениеПоСтавкам.Добавить();
				// --- 
				Движение.Период         = Документ.Дата;
				Движение.ВидДвижения    = ВидДвиженияНакопления.Приход;
				Движение.Грузоперевозка = СтрокаУслуги.Грузоперевозка;
				Движение.Номенклатура   = СтрокаУслуги.Номенклатура;
				Движение.Контрагент     = СтрокаУслуги.Покупатель;
				Движение.Договор        = СтрокаУслуги.ДоговорПокупателя;
				
				//Подсистема.УчетПриложенийДоговоров
				Движение.ПриложениеКДоговору = СтрокаУслуги.ПриложениеКДоговору;
				//Подсистема.УчетПриложенийДоговоров				
				
				Движение.СтавкаНДС      = СтрокаУслуги.СтавкаНДС ;
				
				Движение.Всего	        = СтрокаУслуги.Всего_Рег;
				Движение.Сумма	 	    = СтрокаУслуги.Сумма_Рег;
				Движение.НДС	        = СтрокаУслуги.НДС_Рег;  
				
				Движение.Всего_Вал		= СтрокаУслуги.Всего;
				Движение.Сумма_вал		= СтрокаУслуги.Сумма;
				Движение.НДС_вал		= СтрокаУслуги.НДС;
				
			КонецЕсли; 
			
		КонецЕсли;
		
		//Подсистема.УчетНЗП
		Если НЗ_НЗП <> Неопределено  
			И мСоставЗатрат.Найти(СтрокаУслуги.ПорядокОтражения) <> Неопределено Тогда
			
			Если ГрузоперевозкиНЗП.Найти(СтрокаУслуги.Грузоперевозка) <> Неопределено Тогда 
				
				// регистр "CW_НезавершенноеПроизводство"
				Движение = НЗ_НЗП.ДобавитьПриход();
				Движение.Период         			= Документ.Дата;
				Движение.Организация 				= Документ.Организация;
				Движение.ПодразделениеОрганизации 	= Документ.ПодразделениеОрганизации;
				Движение.Грузоперевозка 			= СтрокаУслуги.Грузоперевозка;
				
				Движение.Контрагент     	= Документ.Контрагент;
				Движение.Договор        	= Документ.Договор;
				
				//Подсистема.УчетПриложенийДоговоров
				Движение.ПриложениеКДоговору= Документ.ПриложениеКДоговору;
				//Подсистема.УчетПриложенийДоговоров
				
				Движение.ДокументРасходов  	= Документ;
				Движение.ПорядокОтражения  	= СтрокаУслуги.ПорядокОтражения;
				Движение.СтавкаНДС			= СтрокаУслуги.СтавкаНДС;
				Движение.СпособУчетаНДС		= СтрокаУслуги.СпособУчетаНДС;
				Движение.Номенклатура   	= СтрокаУслуги.Номенклатура;
				Движение.СтатьяЗатрат   	= СтрокаУслуги.СтатьяЗатрат;
				Движение.Подразделение  	= СтрокаУслуги.Подразделение;
				Движение.Валюта         	= Документ.Валюта;
				
				Движение.Покупатель	        = СтрокаУслуги.Покупатель;
				Движение.ДоговорПокупателя	= СтрокаУслуги.ДоговорПокупателя;
				
				//Подсистема.УчетПриложенийДоговоров
				Движение.ПриложениеКДоговоруПокупателя = СтрокаУслуги.ПриложениеКДоговору;
				//Подсистема.УчетПриложенийДоговоровъ
				
				Движение.Количество   		= СтрокаУслуги.Количество;
				
				Движение.Сумма_Валюта   	= СтрокаУслуги.Сумма;
				Движение.НДС_Валюта   		= СтрокаУслуги.НДС;
				Движение.Всего_Валюта   	= СтрокаУслуги.Всего;
				
				Движение.Всего	= СтрокаУслуги.Всего_Рег;
				Движение.Сумма	= СтрокаУслуги.Сумма_Рег;
				Движение.НДС	= СтрокаУслуги.НДС_Рег;  
				
			КонецЕсли;
			
		КонецЕсли;
		//Подсистема.УчетНЗП
		
	КонецЦикла; 
	
	#КонецОбласти 

	#Область НаборыДвиженийОперативногоУчета
	НЗ_ОЗ = _сф.НаборЗаписейПоРегистратору(РегистрыНакопления.CW_ОперативнаяКредиторскаяЗадолженность,Документ);
	НЗ_КонтрольАктов = _сф.НаборЗаписейПоРегистратору(РегистрыНакопления.CW_АктированиеВходящихСчетов,Документ);
	НЗ_СоответствиеАктов = _сф.НаборЗаписейПоРегистратору(РегистрыСведений.CW_СоответствиеАктовВходящимСчетам,Документ);
	//НЗ_ОплатаДокументов = _сф.НаборЗаписейПоРегистратору(РегистрыСведений.CW_ОплатаВходящихДокументов,Документ);
	#КонецОбласти
	
	#Область ОперативнаяЗадолженность 

	Если (ИспользуетсяОперативнаяЗадолженность И (ЕстьСчет ИЛИ ЕстьАкт)) Тогда
		
		СтрокаГруппировки = "Грузоперевозка,Счет";
		Если КонтрольНоменклатуры Тогда
			_сф.стр_Добавить(СтрокаГруппировки,",Номенклатура");
		КонецЕсли; 
		Если КонтрольПорядкаОтражения Тогда
			_сф.стр_Добавить(СтрокаГруппировки,",ПорядокОтражения");
		КонецЕсли; 
		Если КонтрольНДС Тогда
			_сф.стр_Добавить(СтрокаГруппировки,",СтавкаНДС");
		КонецЕсли; 
		// --- 
		СтрокаСвертки = "Всего";
		Если КонтрольНДС Тогда
			_сф.стр_Добавить(СтрокаСвертки,",Сумма,НДС");
		КонецЕсли;  
		// --- 
		ТаблицаАктирования = ТаблицаУслуг.Скопировать();
		ТаблицаАктирования.Свернуть(СтрокаГруппировки,СтрокаСвертки);
		
		
		// ветка корректировки начисления
		Если (ЕстьСчет) Тогда
			
			ФормироватьДвиженияСторноНачисленияАктирования = Ложь;
			Если (Документ.КорректируемыйДокумент.ПредъявленСчет) Тогда
				
				// кредит-нота для пакетника
				ФормироватьДвиженияСторноНачисленияАктирования = Истина;
				ИсходныйКорректируемыйДокумент = ПолучитьКорректируемыйДокумент(Документ.КорректируемыйДокумент, Ложь);
				ТаблицаАктирования.ЗаполнитьЗначения(ИсходныйКорректируемыйДокумент,"Счет");
				
			Иначе 
				
				 Если (Документ.КорректируемыйДокумент.ПредъявленАкт) Тогда
					 
					Если (Документ.КорректируемыйДокумент.СписокСчетов) Тогда
						 
						// проверяем, что указаны актируемые счета
						
					Иначе
						
						// проверяем, что указан актируемый счёт
						Если ЗначениеЗаполнено(Документ.КорректируемыйДокумент.Счет) Тогда
							ФормироватьДвиженияСторноНачисленияАктирования=Истина;
							ТаблицаАктирования.ЗаполнитьЗначения(Документ.КорректируемыйДокумент.Счет,"Счет");
						Иначе
							ИсходынйАктируемыйСчет = ПолучитьКорректируемыйДокумент(Документ.КорректируемыйДокумент, Истина);
							Если ЗначениеЗаполнено(ИсходынйАктируемыйСчет) Тогда
								ФормироватьДвиженияСторноНачисленияАктирования = Истина;
								ТаблицаАктирования.ЗаполнитьЗначения(ИсходынйАктируемыйСчет,"Счет");
							Конецесли;
						КонецЕсли; 
						
					КонецЕсли; 
					 
				 КонецЕсли; 
				
			КонецЕсли; 
			// --- 
			Если (ФормироватьДвиженияСторноНачисленияАктирования) Тогда
				
				Для каждого Стр Из ТаблицаАктирования Цикл
					
					Движение = НЗ_КонтрольАктов.Добавить();
					// --- 
					ЗаполнитьЗначенияСвойств(Движение,Стр);
					Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
					Движение.Период = Документ.Дата;
					Движение.Счет = Стр.Счет;
					Движение.Организация = Документ.Организация;
					Движение.Контрагент = Документ.Контрагент;
					Движение.Договор = Документ.Договор;
					
					//Подсистема.УчетПриложенийДоговоров
					Движение.ПриложениеКДоговору = СтрокаУслуги.ПриложениеКДоговору;
					//Подсистема.УчетПриложенийДоговоров				
					
					Движение.Валюта = Документ.Валюта;
					
				КонецЦикла; 
				
			КонецЕсли; 
			
		КонецЕсли; 
		
		//ветка корректировки списания
		Если (ЕстьАкт) Тогда
			
			ФормироватьДвиженияСторноСписанияАктирования = Истина;
			Если (Документ.КорректируемыйДокумент.ПредъявленСчет) Тогда
				
				// кредит-нота для пакетника
				ИсходныйКорректируемыйДокумент = ПолучитьКорректируемыйДокумент(Документ.КорректируемыйДокумент, Ложь);
				ТаблицаАктирования.ЗаполнитьЗначения(ИсходныйКорректируемыйДокумент,"Счет");
				
			Иначе 
				
				 Если (Документ.КорректируемыйДокумент.ПредъявленАкт) Тогда
					 
					Если (Документ.КорректируемыйДокумент.СписокСчетов) Тогда
						 
						// проверяем, что указаны актируемые счета
						
					Иначе
												
						// проверяем, что указан актируемый счёт
						Если ЗначениеЗаполнено(Документ.КорректируемыйДокумент.Счет) Тогда
							ФормироватьДвиженияСторноНачисленияАктирования=Истина;
							ТаблицаАктирования.ЗаполнитьЗначения(Документ.КорректируемыйДокумент.Счет,"Счет");
						Иначе
							ИсходынйАктируемыйСчет = ПолучитьКорректируемыйДокумент(Документ.КорректируемыйДокумент, Истина);
							Если ЗначениеЗаполнено(ИсходынйАктируемыйСчет) Тогда
								ФормироватьДвиженияСторноНачисленияАктирования = Истина;
								ТаблицаАктирования.ЗаполнитьЗначения(ИсходынйАктируемыйСчет,"Счет");
							Конецесли;
						КонецЕсли; 

					КонецЕсли; 
					 
				 КонецЕсли; 
				
			КонецЕсли; 
			// --- 
			Если (ФормироватьДвиженияСторноСписанияАктирования) Тогда
				
				Для каждого Стр Из ТаблицаАктирования Цикл
					
					Движение = НЗ_КонтрольАктов.Добавить();
					// --- 
					ЗаполнитьЗначенияСвойств(Движение,Стр);
					Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
					Движение.Период = Документ.Дата;
					Движение.Счет = Стр.Счет;
					Движение.Организация = Документ.Организация;
					Движение.Контрагент = Документ.Контрагент;
					Движение.Договор = Документ.Договор;
					
					//Подсистема.УчетПриложенийДоговоров
					Движение.ПриложениеКДоговору = Документ.ПриложениеКДоговору;
					//Подсистема.УчетПриложенийДоговоров				
					
					Движение.Валюта = Документ.Валюта;
					
				КонецЦикла;
				
			КонецЕсли; 
			
			
		КонецЕсли; 
		
		// ---------------------------------------------------------------------------- 
		
		// оперативная задолженность
		Если (ЕстьСчет) Тогда
			
			ТаблицаОЗ = ТаблицаУслуг.Скопировать();
			ТаблицаОЗ.Свернуть("СчетЗадолженности","Всего,Всего_Рег,ВсегоРег");
			// --- 
			
			АналитикаКурсовыхРазниц = _сф.т_Создать("Аналитика,Счет,ВалютнаяСуммаЗачета,СуммаЗачета");
			КурсСчета = CW_Финансы.ПолучитьКурсВалюты(Документ.Валюта,Документ.КорректируемыйДокумент.ДатаСчета);
			
			АналитикаКорректировкиОперативнойЗадолженности = CW_Настройки.ПараметрУчетнойПолитики(Документ.Дата,Документ.Организация,"АналитикаКорректировкиОперативнойЗадолженности"); 
			
			Для каждого Стр Из ТаблицаОЗ Цикл
				
				Движение = НЗ_ОЗ.Добавить();
				// --- 
				Движение.ВидДвижения	= ВидДвиженияНакопления.Приход;
				Движение.ВидОперации	= ПредопределенноеЗначение("Перечисление.CW_ВидыДвиженийПоОперативнойЗадолженности.Начисление");
				// --- 
				Движение.Период 		= Документ.Дата;
				Движение.Организация 	= Документ.Организация;
				Движение.Контрагент 	= Документ.Контрагент;
				Движение.Договор 		= Документ.Договор;
				
				//Подсистема.УчетПриложенийДоговоров
				Движение.ПриложениеКДоговору = Документ.ПриложениеКДоговору;
				//Подсистема.УчетПриложенийДоговоров				
				
				Движение.Валюта 		= Документ.Валюта;
				// --- 
				Если (АналитикаКорректировкиОперативнойЗадолженности = 0) Тогда
					Движение.Счет 			= ПолучитьКорректируемыйДокумент(Документ.КорректируемыйДокумент, Ложь);
				Иначе
					Движение.Счет 			= Документ;
				КонецЕсли; 
				// --- 
				Движение.СчетУчета 		= Стр.СчетЗадолженности;
				// --- 
				Движение.Всего_Валюта	= Стр.Всего;   
				
				Движение.Всего = Стр.Всего_Рег; 
			КонецЦикла; 
			
			
		КонецЕсли; 
		
		
	КонецЕсли; 
	
	#КонецОбласти
	
	#Область СоответсвиеСчетовАктов 
	
	Если (ЕстьАкт) Тогда
		
		КорректируемыйДокумент = ПолучитьКорректируемыйДокумент(Документ, Ложь);
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	CW_СоответствиеАктовВходящимСчетам.Счет КАК Счет,
		               |	CW_СоответствиеАктовВходящимСчетам.Акт КАК Акт,
		               |	CW_СоответствиеАктовВходящимСчетам.Всего КАК Всего
		               |ИЗ
		               |	РегистрСведений.CW_СоответствиеАктовВходящимСчетам КАК CW_СоответствиеАктовВходящимСчетам
		               |ГДЕ
		               |	CW_СоответствиеАктовВходящимСчетам.Регистратор = &Регистратор";
		Запрос.УстановитьПараметр("Регистратор",КорректируемыйДокумент);
		
		РезультатЗапрсоа = Запрос.Выполнить();
		
		Если Не РезультатЗапрсоа.Пустой() Тогда
			//Пишем в регистр только в случае если в нем сть записи по корректируемому документу
			
			ТаблицаДвижений = ТаблицаУслуг.Скопировать();
			Если (ЕстьСчет) Тогда
				_сф.т_ЗаполнитьЗначения(ТаблицаДвижений, "Счет", КорректируемыйДокумент);			
			Иначе
				Если (НЕ Документ.СписокСчетов) Тогда
					_сф.т_ЗаполнитьЗначения(ТаблицаДвижений, "Счет", КорректируемыйДокумент.Счет);
				КонецЕсли; 
			КонецЕсли; 
			
			СУ = Новый Массив;
			ЕстьНепривязанные = Ложь;
			Для каждого Стр Из ТаблицаДвижений Цикл
				Если (Стр.Счет.Пустая()) Тогда
					СУ.Добавить(Стр);
					ЕстьНепривязанные = Истина;
				КонецЕсли; 
			КонецЦикла; 
			_сф.к_УдалитьЭлементыПоМассиву(ТаблицаДвижений,СУ);
			
			// получаем настройку пользователя
			КонтрольПривязкиСчета = CW_Настройки.ПолучитьНастройкуПользователя(,"ПредупреждатьОПроведенииАктаБезПривязкиСчетаНаОплату");
			Если (ЕстьНепривязанные И КонтрольПривязкиСчета) Тогда
				Сообщить(Строка(Документ)+": "+"не привязаны счета на оплату!");
			КонецЕсли; 
			
			ТаблицаДвижений.Свернуть("Счет,СчетЗадолженности","Всего,НДС,Сумма");
			Для Каждого Стр из ТаблицаДвижений Цикл
				Запись = НЗ_СоответствиеАктов.Добавить();
				Запись.Счет 	= Стр.Счет;
				Запись.Акт 		= Документ;
				Запись.СчетУчетаЗадолженности = Стр.СчетЗадолженности;
				Запись.Всего 	= Стр.Всего;
				Запись.НДС 		= Стр.НДС;
				Запись.Сумма 	= Стр.Сумма;
			КонецЦикла; 
		КонецЕсли;	
	КонецЕсли;	
	
	#КонецОбласти 
	
	#Область ЗаписьДвижений
	
	НЗ_ОЗ.Записать(Истина);
	НЗ_КонтрольАктов.Записать(Истина);	
	НЗ_СоответствиеАктов.Записать(Истина);
	//НЗ_ОплатаДокументов.Записать(Истина);
	НЗ_Расходы.Записать(Истина);
	НЗ_Перевыставление.Записать(Истина);
	НЗ_ПеревыставлениеПоСтавкам.Записать(Истина);
	
	//Подсистема.УчетНЗП
	Если НЗ_НЗП <> Неопределено Тогда
		НЗ_НЗП.Записать(Истина);
	КонецЕсли;
	//Подсистема.УчетНЗП
	
	#КонецОбласти 
	
	
КонецПроцедуры

Функция ПолучитьКорректируемыйДокумент(КорректируемыйДокумент, ПолучитьСчет)
	
	Если Не КорректируемыйДокумент.Корректировка тогда
		Если ПолучитьСчет Тогда
			Возврат КорректируемыйДокумент.Счет;
		Иначе
			Возврат КорректируемыйДокумент;
		КонецЕсли;
	Иначе
		Возврат ПолучитьКорректируемыйДокумент(КорректируемыйДокумент.КорректируемыйДокумент,ПолучитьСчет);
	КонецЕсли;
	
КонецФункции

Процедура СформироватьДвиженияДляДоходов(Документ, Отказ=Ложь, Свойства=Неопределено, ВнешняяТаблицаУслуг=Неопределено) Экспорт 
	
	// проверка на корректность логики функционировани связанных документов
	Если (Документ.ПометкаУдаления) Тогда
		Отказ = Истина;
		Сообщить("Документ """+Строка(Документ)+""" помечен на удаление. Нарушена синхронизация пометок удаления!");
		Возврат;
	КонецЕсли;
	
	#Область Параметры 
	
		ВалютаРегламентированногоУчетаРубль	= ПолучитьФункциональнуюОпцию("CW_ВалютаРегламентированногоУчетаРубль");

		
		// параметры - таблица услуг для УЕ
		Если (Свойства = Неопределено) Тогда
			СтруктураПараметров = CW_Настройки.ПустаяСтруктураПолученияПараметровДоговора();
			СтруктураПараметров.Дата 				= Документ.Дата;
			СтруктураПараметров.Договор 			= Документ.Договор;
			СтруктураПараметров.ПриложениеКДоговору = Документ.ПриложениеКДоговору;
			
			ПараметрыДоговора	= CW_Настройки.ПолучитьПараметрыДоговора(СтруктураПараметров);
			
			СКонстанты = Новый Структура;
			СКонстанты.Вставить("ВалютаРегламентированногоУчета",CW_Настройки.ВалютаРегламентированногоУчета());
			
			Свойства = Новый Структура;
			Свойства.Вставить("КО", СКонстанты);
			Свойства.Вставить("ПД", ПараметрыДоговора);
			
		КонецЕсли; 
		
		// определяем режим: начальные остатки или нормальное проведение
		ДатаНачалаВеденияУчета = CW_Настройки.ПолучитьДатуНачалаВеденияУчета(Документ.Организация);
		РежимВводНачальныхОстатков = ?(ДатаНачалаВеденияУчета <> Неопределено, Документ.Дата < ДатаНачалаВеденияУчета,Ложь);
		ЕстьСчет = (Документ.ФормируетсяСчет);	
		ЕстьАкт = (Документ.ФормируетсяАкт ИЛИ Документ.ФормируетсяСчетФактура или НЕ ВалютаРегламентированногоУчетаРубль);
		
		СтруктураНастроек = CW_Настройки.ПолучитьНастройкиОперативногоУчета(Документ.Организация, Перечисления.CW_ВидыОперативнойЗадолженности.Дебиторская, Документ.Дата);
		
		ИспользуетсяОперативнаяЗадолженность = СтруктураНастроек["ВедетсяОперативныйУчет"];
		РежимВводначальныхОстатков_ОЗ        = СтруктураНастроек["ВводОстатков"];
		
		НастройкиОперативногоУчета = СтруктураНастроек["НастройкиОперативногоУчета"];
		КонтрольНоменклатуры 		= НастройкиОперативногоУчета["КонтрольНоменклатуры"];
		КонтрольПорядкаОтражения 	= НастройкиОперативногоУчета["КонтрольПорядкаОтражения"];
		КонтрольНДС 				= НастройкиОперативногоУчета["КонтрольНДС"];
		
		//Подситема.СтатусыДокументов
		СтатусДокумента = Неопределено;
		Если Свойства.Свойство("СтатусДокумента") Тогда
			СтатусДокумента = Свойства.СтатусДокумента;
		Иначе
			ДанныеСтатуса 	= РегистрыСведений.CW_СтатусыДокументов.ПолучитьДанныеСтатусаДокумента(Документ);
			СтатусДокумента	= ДанныеСтатуса.СтатусДокумента;
		КонецЕсли;

		СтатусДокументаПроводитьПоБухгалтерскомуУчету = CW_СтатусыДокументовСервер.ПолучитьПризнакПроведенияПоБухгалтерскомуУчету(Документ, СтатусДокумента);
		//Подситема.СтатусыДокументов
		
		СтруктураПараметровБухУчета = Новый Структура;
		СтруктураПараметровБухУчета.Вставить("Договор", 				Документ.Договор);
		СтруктураПараметровБухУчета.Вставить("ПриложениеКДоговору",		Документ.ПриложениеКДоговору);
		
		ПараметрыБухгалтерскогоУчета  = CW_Финансы.ПолучитьПарметрыВеденияБухгалтерскогоУчета(СтруктураПараметровБухУчета, Документ.Дата);
		ПровестиПоБухгалтерскомуУчету = ПараметрыБухгалтерскогоУчета.БухгалтерскийУчет и СтатусДокументаПроводитьПоБухгалтерскомуУчету;
		
		ДатаАкта = ?(ВалютаРегламентированногоУчетаРубль,Документ.ДатаАкта,?(ЕстьСчет,Документ.ДатаСчета,Документ.Дата));
		ДатаСчета = ?(ЕстьСчет,Документ.ДатаСчета,Документ.Дата);
	
	#КонецОбласти 
	
	#Область НаборыДвиженийПоОсновнымРегистрам
		
		НЗ_Доходы = _сф.НаборЗаписейПоРегистратору(РегистрыНакопления.CW_ДоходыПоГрузоперевозкам,Документ);
		НЗ_Перевыставление = _сф.НаборЗаписейПоРегистратору(РегистрыНакопления.CW_Перевыставление,Документ);
	    НЗ_ПеревыставлениеПоСтавкам = _сф.НаборЗаписейПоРегистратору(РегистрыНакопления.CW_ПеревыставлениеПоСтавкам,Документ);
	    НЗ_Вознаграждение = _сф.НаборЗаписейПоРегистратору(РегистрыНакопления.CW_ВознаграждениеПоГрузоперевозкам,Документ);
	
	#КонецОбласти 
	
	#Область ОсновныеРегистры 
	
		ВалютаДокумента = Документ.Валюта; //Документ.Договор.ВалютаДоговора;
		
		// получаем таблицу услуг
		Если (ВалютаДокумента <> Свойства.КО.ВалютаРегламентированногоУчета И Документ.ФормируетсяАкт И ВнешняяТаблицаУслуг <> Неопределено) Тогда
			ТаблицаУслуг = ВнешняяТаблицаУслуг;
		Иначе
			ТаблицаУслуг = Документ.Услуги.Выгрузить();
			CW_Финансы.ДобавитьКолонкиБазовойВалюты(ТаблицаУслуг);
		КонецЕсли; 
		ТаблицаДвиженийПоОсновнымРегистрам = ТаблицаУслуг;
		
		// определяем курс для пересчёта рублёвого эквивалента для отражения по регистру "Доходы"
		// если они не рассчитаны в подписке
		ТребуетсяЗаполнениеСуммРегУчета = Ложь;
		Если (ВалютаДокумента = Свойства.КО.ВалютаРегламентированногоУчета) Тогда
			Курс = Новый Структура("Курс,Кратность",1,1);
			ТребуетсяЗаполнениеСуммРегУчета = Истина;
		ИначеЕсли (ВнешняяТаблицаУслуг <> Неопределено) Тогда 
			 ТребуетсяЗаполнениеСуммРегУчета = Ложь;
		Иначе
			Если (Документ.Договор.ВзаиморасчетыВУЕ И РежимВводНачальныхОстатков И (Документ.ФормируетсяАкт или НЕ ВалютаРегламентированногоУчетаРубль)) 
				ИЛИ  Документ.УЕ_ПользовательскийКурс 
			Тогда
				
				ТребуетсяЗаполнениеСуммРегУчета = Истина;
				Если Документ.УЕ_ПользовательскийКурс Тогда
					
					Курс = Новый Структура("Курс,Кратность",Документ.УЕ_Курс,Документ.УЕ_Кратность);
					
				Иначе
					
					Курс = Новый Структура("Курс,Кратность",Документ.КурсВзаиморасчетовБУ,1);
					
				КонецЕсли;
							
			Иначе
				
				Если НЕ Документ.ФормируетсяАкт ИЛИ РежимВводНачальныхОстатков ИЛИ НЕ ПровестиПоБухгалтерскомуУчету Тогда
					
					ТребуетсяЗаполнениеСуммРегУчета = Истина;
					Если (Документ.ФормируетсяАкт) Тогда
						ДатаКурса = Документ.ДатаАкта;
					Иначе
						Если (Документ.ФормируетсяСчет) Тогда 
							ДатаКурса = Документ.ДатаСчета;
						Иначе
							ДатаКурса = Документ.Дата;
						КонецЕсли;
					КонецЕсли; 
					Курс = CW_Финансы.ПолучитьКурсВалюты(Документ.Валюта,ДатаКурса);
				КонецЕсли; 
			КонецЕсли; 
		КонецЕсли; 
		
		Если (ТребуетсяЗаполнениеСуммРегУчета) Тогда
			
			Если Свойства.ПД.РасчетРублевогоЭквивалентаПропорциональноПоСуммеИтога Тогда
				
				ВсегоПоТаблице 		=  ТаблицаДвиженийПоОсновнымРегистрам.Итог("Всего");
				ВсегоРаспределяемаяСумма = Окр(CW_Финансы.ПересчитатьИзВалютыВВалюту(ВсегоПоТаблице, Документ.Валюта, Свойства.КО.ВалютаРегламентированногоУчета, Курс.Курс, 1, Курс.Кратность, 1),2,1);	
				ОбщегоНазначенияБПВызовСервера.РаспределитьСуммуПоКолонкеТаблицы(ВсегоРаспределяемаяСумма, ТаблицаДвиженийПоОсновнымРегистрам, "Всего_Рег", "Всего");
				
				СуммаПоТаблице 		=  ТаблицаДвиженийПоОсновнымРегистрам.Итог("Сумма");
				СуммаРаспределяемаяСумма = Окр(CW_Финансы.ПересчитатьИзВалютыВВалюту(СуммаПоТаблице, Документ.Валюта, Свойства.КО.ВалютаРегламентированногоУчета, Курс.Курс, 1, Курс.Кратность, 1),2,1);	
				ОбщегоНазначенияБПВызовСервера.РаспределитьСуммуПоКолонкеТаблицы(СуммаРаспределяемаяСумма, ТаблицаДвиженийПоОсновнымРегистрам, "Сумма_Рег", "Сумма");
				
				Для каждого СтрокаУслуги Из ТаблицаДвиженийПоОсновнымРегистрам Цикл
					СтрокаУслуги.НДС_Рег = СтрокаУслуги.Всего_Рег-СтрокаУслуги.Сумма_Рег;
				КонецЦикла; 
				
			Иначе
				
				Для каждого СтрокаУслуги Из ТаблицаДвиженийПоОсновнымРегистрам Цикл
					СтрокаУслуги.Всего_Рег = Окр(CW_Финансы.ПересчитатьИзВалютыВВалюту(СтрокаУслуги.Всего, Документ.Валюта, Свойства.КО.ВалютаРегламентированногоУчета, Курс.Курс, 1, Курс.Кратность, 1),2,1);
					СтрокаУслуги.Сумма_Рег = Окр(CW_Финансы.ПересчитатьИзВалютыВВалюту(СтрокаУслуги.Сумма, Документ.Валюта, Свойства.КО.ВалютаРегламентированногоУчета, Курс.Курс, 1, Курс.Кратность, 1),2,1);
					СтрокаУслуги.НДС_Рег = СтрокаУслуги.Всего_Рег-СтрокаУслуги.Сумма_Рег;
				КонецЦикла; 
				
			КонецЕсли;
			
		КонецЕсли; 
		
		ВалютныйДокумент = (ВалютаДокумента <> Свойства.КО.ВалютаРегламентированногоУчета);
		СоответствиеДокументовРасходов = Новый Соответствие;
		
		// ФОРМИРОВАНИЕ ДВИЖЕНИЙ
		Для каждого СтрокаУслуги Из ТаблицаДвиженийПоОсновнымРегистрам Цикл
			
			// регистр "Доходы по грузоперевозке"
			Движение = НЗ_Доходы.Добавить();
			Движение.Период         	= Документ.Дата;
			Движение.Грузоперевозка 	= СтрокаУслуги.Грузоперевозка;
			Движение.Контрагент     	= Документ.Контрагент;
			Движение.Договор        	= Документ.Договор;
			//Подсистема.УчетПриложенийДоговоров
			Движение.ПриложениеКДоговору= Документ.ПриложениеКДоговору;
			//Подсистема.УчетПриложенийДоговоров
			Движение.ДокументДоходов	= Документ;
			Движение.СтатьяЗатрат   	= СтрокаУслуги.СтатьяЗатрат;
			Движение.Номенклатура   	= СтрокаУслуги.Номенклатура;
			Движение.СтавкаНДС      	= СтрокаУслуги.СтавкаНДС;
			Движение.Валюта         	= Документ.Валюта;  
			Движение.СтатьяБюджета      = СтрокаУслуги.СтатьяБюджета;  
			
			Движение.Сумма_Валюта   	= СтрокаУслуги.Сумма;
			Движение.НДС_Валюта   		= СтрокаУслуги.НДС;
			Движение.Всего_Валюта   	= СтрокаУслуги.Всего;
			Движение.Количество   		= СтрокаУслуги.Количество;
			
			Движение.Всего	        	= СтрокаУслуги.Всего_Рег;
			Движение.Сумма	        	= СтрокаУслуги.Сумма_Рег;
			Движение.НДС	        	= СтрокаУслуги.НДС_Рег;
			
			Движение.ДокументРасходов 	= СтрокаУслуги.ДокументРасходов;
			Движение.ПорядокОтражения 	= СтрокаУслуги.ПорядокОтражения;
			Движение.ЭтоСчет        	= Документ.ФормируетсяСчет;
			Движение.ЭтоАкт        		= Документ.ФормируетсяАкт или Документ.ФормируетсяСчетФактура;
			Движение.Счет               = ?(Документ.СписокСчетов,СтрокаУслуги.Счет, Документ.Счет);  
			
			Движение.ПрочиеДоходы 			= СтрокаУслуги.ПрочиеДоходы;
			Движение.РеестрыНДС0Приложение	= СтрокаУслуги.РеестрыНДС0Приложение;
		
			// регистр "Перевыставляемые затраты"
			Если (ЕстьАкт) Тогда
				
				// отражение перевыставления
				Если СтрокаУслуги.ПорядокОтражения = Перечисления.CW_ПорядокОтраженияДоходов.Перевыставление Тогда
					
					Если (РежимВводначальныхОстатков И СтрокаУслуги.ВводОстатков) ИЛИ 
						(НЕ РежимВводначальныхОстатков) 
					Тогда
						
						Движение = НЗ_Перевыставление.Добавить();
						Движение.Период         = ?(ПровестиПоБухгалтерскомуУчету,Документ.ВедомыйДокумент.Дата,ДатаАкта);
						Движение.ВидДвижения    = ВидДвиженияНакопления.Расход;
						Движение.Грузоперевозка = СтрокаУслуги.Грузоперевозка;
						Движение.Номенклатура   = СтрокаУслуги.Номенклатура;
						Движение.Контрагент     = Документ.Контрагент;
						Движение.Договор        = Документ.Договор;
						//Подсистема.УчетПриложенийДоговоров
						Движение.ПриложениеКДоговору= Документ.ПриложениеКДоговору;
						//Подсистема.УчетПриложенийДоговоров
						Движение.ДокументРасходов = СтрокаУслуги.ДокументРасходов;
						Движение.СтавкаНДС      = СтрокаУслуги.СтавкаНДС ;
						Движение.Всего	        = СтрокаУслуги.Всего_Рег;
						Движение.Сумма          = СтрокаУслуги.Сумма_Рег;
						Движение.НДС            = СтрокаУслуги.НДС_Рег;
						Движение.Количество     = СтрокаУслуги.Количество;   
						
						Если ЗначениеЗаполнено(СтрокаУслуги.ДокументРасходов.ПриложениеКДоговору) Тогда
							УчетныйДоговорУчетАгентскогоНДС = СтрокаУслуги.ДокументРасходов.ПриложениеКДоговору.УчетныйДоговор.УчетАгентскогоНДС;
							УчетныйДоговор = СтрокаУслуги.ДокументРасходов.ПриложениеКДоговору.УчетныйДоговор;
						Иначе
							УчетныйДоговорУчетАгентскогоНДС = СтрокаУслуги.ДокументРасходов.Договор.УчетныйДоговор.УчетАгентскогоНДС;	
							УчетныйДоговор = СтрокаУслуги.ДокументРасходов.Договор.УчетныйДоговор;
						КонецЕсли; 
						
						УчетныйДоговорУчетАгентскогоНДС = УчетныйДоговорУчетАгентскогоНДС И (СтрокаУслуги.ДокументРасходов.Валюта = Свойства.КО.ВалютаРегламентированногоУчета);
						
						Если УчетныйДоговорУчетАгентскогоНДС Тогда
							Движение = НЗ_Перевыставление.Добавить();
							Движение.Период         = ?(ПровестиПоБухгалтерскомуУчету,Документ.ВедомыйДокумент.Дата,ДатаАкта);
							Движение.ВидДвижения    = ВидДвиженияНакопления.Приход;
							Движение.Грузоперевозка = СтрокаУслуги.Грузоперевозка;
							Движение.Номенклатура   = СтрокаУслуги.Номенклатура;
							Движение.Контрагент     = Документ.Контрагент;
							Движение.Договор        = Документ.Договор;
							//Подсистема.УчетПриложенийДоговоров
							Движение.ПриложениеКДоговору= Документ.ПриложениеКДоговору;
							//Подсистема.УчетПриложенийДоговоров
							Движение.ДокументРасходов = СтрокаУслуги.ДокументРасходов;
							Движение.СтавкаНДС      = ПредопределенноеЗначение("Перечисление.СтавкиНДС.БезНДС") ;
							Движение.Всего	        = -СтрокаУслуги.Сумма_Рег;
							Движение.Сумма          = -СтрокаУслуги.Сумма_Рег;
							Движение.НДС            = 0;
							Движение.Количество     = -СтрокаУслуги.Количество;  
							
							Движение = НЗ_Перевыставление.Добавить();
							Движение.Период         = ?(ПровестиПоБухгалтерскомуУчету,Документ.ВедомыйДокумент.Дата,ДатаАкта);
							Движение.ВидДвижения    = ВидДвиженияНакопления.Приход;
							Движение.Грузоперевозка = СтрокаУслуги.Грузоперевозка;
							Движение.Номенклатура   = СтрокаУслуги.Номенклатура;
							Движение.Контрагент     = Документ.Контрагент;
							Движение.Договор        = Документ.Договор;
							//Подсистема.УчетПриложенийДоговоров
							Движение.ПриложениеКДоговору= Документ.ПриложениеКДоговору;
							//Подсистема.УчетПриложенийДоговоров
							Движение.ДокументРасходов = СтрокаУслуги.ДокументРасходов;
							Движение.СтавкаНДС      = СтрокаУслуги.СтавкаНДС ;
							Движение.Всего	        = СтрокаУслуги.Всего_Рег;
							Движение.Сумма          = СтрокаУслуги.Сумма_Рег;
							Движение.НДС            = СтрокаУслуги.НДС_Рег;
							Движение.Количество     = СтрокаУслуги.Количество;   
						КонецЕсли;
						
					КонецЕсли; 
					
				КонецЕсли;
				
				// отражение перевыставления по ставкам
				Если СтрокаУслуги.ПорядокОтражения = Перечисления.CW_ПорядокОтраженияДоходов.ПеревыставлениеПоСтавкам Тогда 	
					
					Если (РежимВводначальныхОстатков И СтрокаУслуги.ВводОстатков) ИЛИ 
						(НЕ РежимВводначальныхОстатков) 
					Тогда
						
						Движение = НЗ_ПеревыставлениеПоСтавкам.Добавить();
						Движение.Период         = ?(ПровестиПоБухгалтерскомуУчету,Документ.ВедомыйДокумент.Дата,ДатаАкта);
						Движение.ВидДвижения    = ВидДвиженияНакопления.Расход;
						Движение.Грузоперевозка = СтрокаУслуги.Грузоперевозка;
						Движение.Номенклатура   = СтрокаУслуги.Номенклатура;
						Движение.Контрагент     = Документ.Контрагент;
						Движение.Договор        = Документ.Договор;
						//Подсистема.УчетПриложенийДоговоров
						Движение.ПриложениеКДоговору = Документ.ПриложениеКДоговору;
						//Подсистема.УчетПриложенийДоговоров
						Движение.СтавкаНДС      = СтрокаУслуги.СтавкаНДС ;
						Движение.Всего          = СтрокаУслуги.Всего_Рег;
						Движение.Сумма          = СтрокаУслуги.Сумма_рег;
						Движение.НДС            = СтрокаУслуги.НДС_Рег;
						
						Движение.Всего_Вал		= СтрокаУслуги.Всего;
						Движение.Сумма_вал		= СтрокаУслуги.Сумма;
						Движение.НДС_вал		= СтрокаУслуги.НДС;
						
					
					КонецЕсли; 
				КонецЕсли;	
			КонецЕсли; 
			
			// регистр "Вознаграждение по г/п"
			Если (Свойства.ПД.АвтоматическийРасчетВознаграждения 
				И СтрокаУслуги.Номенклатура = Свойства.ПД.Номенклатура
				И (Документ.ФормируетсяАкт или НЕ ВалютаРегламентированногоУчетаРубль)) 
			Тогда 
				
				Движение = НЗ_Вознаграждение.Добавить();
				Движение.Период         = ?(ПровестиПоБухгалтерскомуУчету,Документ.ВедомыйДокумент.Дата,ДатаАкта);
				Движение.Грузоперевозка = СтрокаУслуги.Грузоперевозка;
				Движение.Контрагент     = Документ.Контрагент;
				Движение.Договор        = Документ.Договор;
				//Подсистема.УчетПриложенийДоговоров
				Движение.ПриложениеКДоговору= Документ.ПриложениеКДоговору;
				//Подсистема.УчетПриложенийДоговоров
				Движение.ДокументРасходов = СтрокаУслуги.ДокументРасходов;
				Движение.Валюта         = Документ.Валюта;
				Движение.СтавкаНДС      = СтрокаУслуги.СтавкаНДС ;
				Движение.База           = СтрокаУслуги.База;
				Движение.Всего_Валюта   = СтрокаУслуги.Всего;
				Движение.Всего          = СтрокаУслуги.Всего_Рег;
				Движение.Сумма          = СтрокаУслуги.Сумма_Рег;
				Движение.НДС            = СтрокаУслуги.НДС_Рег;
				Движение.НДС_Валюта     = СтрокаУслуги.НДС;
				
			КонецЕсли;
		КонецЦикла; 
	
	#КонецОбласти 
	
	#Область НаборыДвиженийОперативногоУчета
	
		НЗ_ОЗ = _сф.НаборЗаписейПоРегистратору(РегистрыНакопления.CW_ОперативнаяДебиторскаяЗадолженность, Документ);
		НЗ_КонтрольАктов = _сф.НаборЗаписейПоРегистратору(РегистрыНакопления.CW_АктированиеИсходящихСчетов, Документ);
		НЗ_СоответствиеАктов = _сф.НаборЗаписейПоРегистратору(РегистрыСведений.CW_СоответствиеАктовИсходящимСчетам, Документ);
		НЗ_ОплатаДокументов = _сф.НаборЗаписейПоРегистратору(РегистрыСведений.CW_ОплатаИсходящихДокументов,Документ);
		
	#КонецОбласти 
	
	#Область ОперативнаяЗадолженность 
		
		Если (ИспользуетсяОперативнаяЗадолженность или РежимВводначальныхОстатков_ОЗ) Тогда
			
		#Область Параметры 
			
			СтруктураСчетов = CW_Финансы.СтруктураСчетовРасчетов_Клиенты(Документ.Дата,Документ.Организация);
			
			// определяем параметры документа
			ВалютныйДокумент = (Документ.Валюта <> Свойства.КО.ВалютаРегламентированногоУчета);
			РасчетыУЕ = (Документ.Договор.ВзаиморасчетыВУЕ);
			РасчетыВалюта = ((НЕ РасчетыУЕ) И ВалютныйДокумент); 
			
			СтрокаГруппировки = "Грузоперевозка";
			Если (КонтрольНоменклатуры) Тогда
				_сф.стр_Добавить(СтрокаГруппировки,",Номенклатура");
			КонецЕсли; 
			Если (КонтрольПорядкаОтражения) Тогда
				_сф.стр_Добавить(СтрокаГруппировки,",ПорядокОтражения");
			КонецЕсли; 
			Если (КонтрольНДС) Тогда
				_сф.стр_Добавить(СтрокаГруппировки,",СтавкаНДС");
			КонецЕсли; 
			
			Если (РежимВводначальныхОстатков_ОЗ) Тогда
				СтрокаСвертки = "ОЗ_Всего";
				Если КонтрольНДС Тогда
					_сф.стр_Добавить(СтрокаСвертки,",ОЗ_Сумма,ОЗ_НДС");
				КонецЕсли; 
			Иначе
				СтрокаСвертки = "Всего";
				Если КонтрольНДС Тогда
					_сф.стр_Добавить(СтрокаСвертки,",Сумма,НДС");
				КонецЕсли; 	
			КонецЕсли;
			
		#КонецОбласти 
			
			#Область РабочийРежим
				
				Если (НЕ РежимВводначальныхОстатков_ОЗ) Тогда
					
					// начисление задолженности
					Если (ЕстьСчет) Тогда
						
						ТребуетсяПересчет = Ложь;
						Если Документ.УЕ_ПользовательскийКурс Тогда
							КурсСчета = Новый Структура("Курс,Кратность",Документ.УЕ_Курс,Документ.УЕ_Кратность);
						Иначе 
							КурсСчета = CW_Финансы.ПолучитьКурсВалюты(Документ.Валюта,ДатаСчета);
						КонецЕсли;
						Если (Документ.ФормируетсяАкт И Документ.ДатаАкта <> Документ.ДатаСчета) Тогда
							ТребуетсяПересчет = Истина;
						КонецЕсли; 
						
						// требуется определить счета учета
						ТаблицаУслуг.Колонки.Добавить("СчетУчета");
						Для каждого Стр Из ТаблицаУслуг Цикл
							Стр.СчетУчета = CW_Финансы.ОпределитьСчетУчетаДоходов(Стр,СтруктураСчетов,ВалютныйДокумент,РасчетыУЕ);
							Если (НЕ ВалютныйДокумент) Тогда
								Стр.Всего_Рег = Стр.Всего;
							КонецЕсли; 
						КонецЦикла; 
						
						ТаблицаОЗ = ТаблицаУслуг.Скопировать();
						ТаблицаОЗ.Свернуть("СчетУчета","Всего,Всего_Рег");
						
						ИтогоПоНачислению_Валюта = 0;
