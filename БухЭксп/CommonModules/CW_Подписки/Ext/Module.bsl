				Движение.СуммаНУДт = СуммаДвиженияНУ;
				
				Если (СуммаДвиженияПР <> 0) Тогда
					Движение["СуммаПР"+?(СуммаДвиженияПР > 0,"Дт","Кт")] = СуммаДвиженияПР;	
				КонецЕсли; 
				
				Если (Источник.ДоговорКонтрагента.ВалютаВзаиморасчетов <> ВРУ) Тогда
					Движение.ВалютаДт = Источник.ДоговорКонтрагента.ВалютаВзаиморасчетов;
					Движение.ВалютнаяСуммаДт = Стр.СуммаРаспределенная;
				КонецЕсли;
				
			КонецЦикла; 
			
		КонецЕсли;
		
		// ввод остатков для 76.05 или 76.06...
		УслугиСвертка = ВедущийДокумент.Услуги.Выгрузить();
		УслугиСвертка.Свернуть("ВводОстатков, ПорядокОтражения", "Всего");
		
		Если (Источник.ДоговорКонтрагента.ВалютаВзаиморасчетов <> ВРУ) Тогда
			Если Источник.ДоговорКонтрагента.РасчетыВУсловныхЕдиницах Тогда
				КурсВводаОстатков = ВедущийДокумент.КурсВзаиморасчетовБУ;
			Иначе
				СтруктураКурса = CW_Финансы.ПолучитьКурсВалюты(Источник.ДоговорКонтрагента.ВалютаВзаиморасчетов, Источник.Дата);
				КурсВводаОстатков = _СФ.БезопасноРазделить(СтруктураКурса.Курс, СтруктураКурса.Кратность); 
			КонецЕсли;	
		Иначе	
			КурсВводаОстатков = 1;
		КонецЕсли;	
		
		Для каждого Стр Из УслугиСвертка Цикл
			
			Если Стр.ВводОстатков И НЕ Стр.ПорядокОтражения = Перечисления.CW_ПорядокОтраженияДоходов.СобственнаяУслуга 
				И НЕ Стр.ПорядокОтражения = Перечисления.CW_ПорядокОтраженияДоходов.ПрочиеДоходы Тогда
				
				Движение = ДвиженияВедомого.Добавить();
