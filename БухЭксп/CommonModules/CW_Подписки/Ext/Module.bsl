// СОБЫТИЯ ОБЪЕКТОВ

Процедура ЗапомнитьИспользованиеФункциональныхОпцийВДополнительныхСвойствах(Объект)
	
	Если НЕ Объект.ДополнительныеСвойства.Свойство("ФО") Тогда
		СтруктураЗначенияФО = Новый Структура;
		СтруктураЗначенияФО.Вставить("ИспользованиеВнешнихПодписок", ПолучитьФункциональнуюОпцию("CW_ИспользованиеВнешнихПодписок"));
		СтруктураЗначенияФО.Вставить("ИспользованиеОбменов",         ПолучитьФункциональнуюОпцию("CW_ИспользованиеОбменов"));
		СтруктураЗначенияФО.Вставить("ИспользованиеИсторииОбъектов", ПолучитьФункциональнуюОпцию("CW_ИспользованиеИсторииОбъектов"));
		
		Объект.ДополнительныеСвойства.Вставить("ФО", СтруктураЗначенияФО);
	КонецЕсли; 
КонецПроцедуры

Процедура ЗапомнитьСобытиеЗаписиОбъектаВДополнительныхСвойствах(Источник, РежимЗаписи=Неопределено) Экспорт 
	
	_СобытиеЗаписи = Перечисления.CW_СобытияОбъектов.ПустаяСсылка();

	Если РежимЗаписи = Неопределено Тогда
		// справочники, пвх и т. д.
		Если Источник.Ссылка.Пустая() Тогда
			_СобытиеЗаписи = Перечисления.CW_СобытияОбъектов.Создание;
		Иначе
			Если Источник.ПометкаУдаления <> Источник.Ссылка.ПометкаУдаления Тогда
				Если Источник.ПометкаУдаления Тогда
					_СобытиеЗаписи = Перечисления.CW_СобытияОбъектов.ПометкаУдаления;
				Иначе
					_СобытиеЗаписи = Перечисления.CW_СобытияОбъектов.СнятиеПометкиУдаления;
				КонецЕсли; 
			Иначе
				_СобытиеЗаписи = Перечисления.CW_СобытияОбъектов.Изменение;			
			КонецЕсли;
		КонецЕсли;
		
	Иначе
		
		Если РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
			_СобытиеЗаписи = Перечисления.CW_СобытияОбъектов.Проведение;
			
		ИначеЕсли РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения Тогда 
			 _СобытиеЗаписи  = Перечисления.CW_СобытияОбъектов.ОтменаПроведения;
			 
		ИначеЕсли РежимЗаписи = РежимЗаписиДокумента.Запись Тогда 
			 Если Источник.Ссылка.Пустая() Тогда
				 _СобытиеЗаписи = Перечисления.CW_СобытияОбъектов.Создание;
			 Иначе
				 Если Источник.ПометкаУдаления <> Источник.Ссылка.ПометкаУдаления Тогда
					 Если Источник.ПометкаУдаления Тогда
						 _СобытиеЗаписи = Перечисления.CW_СобытияОбъектов.ПометкаУдаления;
					 Иначе
						 _СобытиеЗаписи = Перечисления.CW_СобытияОбъектов.СнятиеПометкиУдаления;
					 КонецЕсли; 
				 Иначе
					 _СобытиеЗаписи = Перечисления.CW_СобытияОбъектов.Изменение;			
				 КонецЕсли;
			 КонецЕсли;
			 
		КонецЕсли; 

	КонецЕсли; 
		
	Источник.ДополнительныеСвойства.Вставить("CW_СобытиеЗаписи", _СобытиеЗаписи);
	
КонецПроцедуры


//Обработчики подписок
Процедура CW_ПередЗаписьюСправочников(Источник, Отказ) Экспорт
	
	Если ТипЗнч(Источник) = Тип("СправочникОбъект.ВерсииРасширений") Тогда 
		Возврат; 
	КонецЕсли;
	
	Если Источник.ОбменДанными.Загрузка Тогда 
		Возврат; 
	КонецЕсли; 
	
	УстановитьПривилегированныйРежим(Истина);
	ЗапомнитьИспользованиеФункциональныхОпцийВДополнительныхСвойствах(Источник);
	ЗапомнитьСобытиеЗаписиОбъектаВДополнительныхСвойствах(Источник);
	
	ПривелигированныйРежимЗаписи = Ложь;
	Если Источник.ДополнительныеСвойства.Свойство("ПривелигированныйРежимЗаписи") Тогда
		ПривелигированныйРежимЗаписи =  Источник.ДополнительныеСвойства.ПривелигированныйРежимЗаписи;
	КонецЕсли;
	
	Если НЕ ПривелигированныйРежимЗаписи Тогда
		// КОНТРОЛЬ РАЗРЕШЕНИЯ РЕДАКТИРОВАНИЯ СПРАВОЧНИКА НА УРОВНЕ ГРУППЫ ПОЛЬЗОВАТЕЛЕЙ
		Отказ = ПроверитьВозможностьРедактированияСправочника(ТипЗнч(Источник.Ссылка));
	КонецЕсли;

	Если Отказ Тогда
		//Дальше нет сммысла идти
		Возврат;
	КонецЕсли;
	
	// ПОДКЛЮЧАЕМЫЕ СОБЫТИЯ
	Если Источник.ДополнительныеСвойства.ФО.ИспользованиеВнешнихПодписок Тогда
		ВнешняяПодписка(Перечисления.CW_ВидыВнешнихПодписок.ОбработчикПередЗаписью, Источник, Отказ);
	КонецЕсли; 
	
	// ОБМЕНЫ
	Если Источник.ДополнительныеСвойства.ФО.ИспользованиеОбменов И НЕ Отказ Тогда
		
		// удаляем старые обмены, если есть
		_сф.ст_УдалитьСвойство(Источник.ДополнительныеСвойства, "Обмены");
		
		// проверяем, есть ли активные обмены    
		Ответ = CW_Обмены.ОбъектРегистрируется(Источник);
		// в массиве возвращаются обмены и их параметры 
		Если _УФКС.ВыполненоУспешно(Ответ) Тогда
			
			ДатаИзменения = ТекущаяДата();
			МассивОбменов = Ответ.МассивОбменов;
			
			Для каждого СтруктураОбмена Из МассивОбменов Цикл
				
				СО = _сф.ст_Создать("Обмен,Использование,Метаданное,ЭтоНовый,ДатаИзменения,РежимЗаписи,Обработка,МассивЗаписей,ПроверкаПередЗаписью,ПроверкаПриЗаписи");
				// --- 
				СО.Обмен 				= СтруктураОбмена.Обмен;
				СО.Использование 		= Ложь;
				СО.Метаданное			= CW_Обмены_ПИ.МетаданноеКонфигурации(Источник.Метаданные().ПолноеИмя());
				СО.ЭтоНовый				= Источник.Ссылка.Пустая();
				СО.ДатаИзменения		= ДатаИзменения;
				СО.РежимЗаписи			= CW_Обмены.РежимЗаписиОбъекта(Источник,СО); // для документов дополнительно передаём режим
				СО.ПроверкаПередЗаписью = СтруктураОбмена.ПередЗаписью;
				СО.ПроверкаПриЗаписи	= СтруктураОбмена.ПриЗаписи;
				СО.МассивЗаписей		= Новый Массив;
				// --- 
				
				Если СО.ПроверкаПередЗаписью Тогда
					
					// получаем обработку
					// вызываем метод проверки
					ОбработкаОбъект = _ПО.ПолучитьОбработку(СО.Обмен.Обработка);
					ОбработкаОбъект.РегистрацияПередЗаписью(Источник,СО); // уходим в обработку
					
				Иначе
					
					// пока так
					СО.Использование = Истина;
					// пишем запись
					СЗ = CW_Обмены.СтруктураЗаписиТаблицыРегистрации(Источник,СО);
					СО.МассивЗаписей.Добавить(СЗ);
					
				КонецЕсли; 	
				
				// --- 
				
				Если СО.Использование Тогда
					
					Если НЕ Источник.ДополнительныеСвойства.Свойство("Обмены") Тогда
						Источник.ДополнительныеСвойства.Вставить("Обмены", Новый Структура);
					КонецЕсли; 
					Источник.ДополнительныеСвойства.Обмены.Вставить(СтрЗаменить("Обмен_"+Строка(СО.Обмен.УникальныйИдентификатор()),"-","_"), СО);
					
				КонецЕсли; 
				
				// ---------------------------------------------------------------------------- 
				
			КонецЦикла; // по доступным обменам
			
		КонецЕсли; 
		
	КонецЕсли; 
	
	// ИСТОРИЯ
	Если Источник.ДополнительныеСвойства.ФО.ИспользованиеИсторииОбъектов И НЕ Отказ Тогда
		CW_Журнал.ОпределитьРежимЗаписиОбъекта(Источник);	
	КонецЕсли; 
		
КонецПроцедуры

Процедура CW_ПередЗаписьюДокументов(Источник, Отказ, РежимЗаписи, РежимПроведения) Экспорт
	
	Если Источник.ОбменДанными.Загрузка Тогда 
		Возврат; 
	КонецЕсли; 
	
	УстановитьПривилегированныйРежим(Истина);
	ЗапомнитьИспользованиеФункциональныхОпцийВДополнительныхСвойствах(Источник);
	ЗапомнитьСобытиеЗаписиОбъектаВДополнительныхСвойствах(Источник, РежимЗаписи);
	
	// ПОДКЛЮЧАЕМЫЕ СОБЫТИЯ
	Если (Источник.ДополнительныеСвойства.ФО.ИспользованиеВнешнихПодписок) Тогда
		ВнешняяПодписка(
			Перечисления.CW_ВидыВнешнихПодписок.ОбработчикПередЗаписью,
			Источник,
			Отказ,
			РежимЗаписи,
			РежимПроведения
		);
	КонецЕсли;

	// ОБМЕНЫ
	Если (Источник.ДополнительныеСвойства.ФО.ИспользованиеОбменов И НЕ Отказ) Тогда
		
		// удаляем старые обмены, если есть
		_сф.ст_УдалитьСвойство(Источник.ДополнительныеСвойства, "Обмены");
		// --- 
		// проверяем, есть ли активные обмены
		Ответ = CW_Обмены.ОбъектРегистрируется(Источник);
		// в массиве возвращаются обмены и их параметры 
		Если (_УФКС.ВыполненоУспешно(Ответ)) Тогда
			
			ДатаИзменения = ТекущаяДата();
			МассивОбменов = Ответ.МассивОбменов;
			
			Для каждого СтруктураОбмена Из МассивОбменов Цикл
				
				СО = _сф.ст_Создать("Обмен,Использование,Метаданное,ЭтоНовый,ДатаИзменения,РежимЗаписи,Обработка,МассивЗаписей,ПроверкаПередЗаписью,ПроверкаПриЗаписи");
				// --- 
				СО.Обмен 				= СтруктураОбмена.Обмен;
				СО.Использование 		= Ложь;
				СО.Метаданное			= CW_Обмены_ПИ.МетаданноеКонфигурации(Источник.Метаданные().ПолноеИмя());
				СО.ЭтоНовый				= Источник.Ссылка.Пустая();
				СО.ДатаИзменения		= ДатаИзменения;
				СО.РежимЗаписи			= CW_Обмены.РежимЗаписиОбъекта(Источник,СО,РежимЗаписи); // для документов дополнительно передаём режим
				СО.ПроверкаПередЗаписью = СтруктураОбмена.ПередЗаписью;
				СО.ПроверкаПриЗаписи	= СтруктураОбмена.ПриЗаписи;
				СО.МассивЗаписей		= Новый Массив;
				
				Если СО.ПроверкаПередЗаписью Тогда
					
					// получаем обработку
					// вызываем метод проверки
					ОбработкаОбъект = _ПО.ПолучитьОбработку(СО.Обмен.Обработка);
					ОбработкаОбъект.РегистрацияПередЗаписью(Источник,СО); // уходим в обработку
					
				Иначе
					
					// пока так
					СО.Использование = Истина;
					// пишем запись
					СЗ = CW_Обмены.СтруктураЗаписиТаблицыРегистрации(Источник,СО);
					СО.МассивЗаписей.Добавить(СЗ);
					
				КонецЕсли; 	
				
				Если СО.Использование Тогда
					
					Если _сф.ст_ПолучитьСвойство(Источник.ДополнительныеСвойства, "Обмены") = Неопределено Тогда
						_сф.ст_УстановитьСвойство(Источник.ДополнительныеСвойства, "Обмены",Новый Структура);
					КонецЕсли; 
					_сф.ст_УстановитьСвойство(Источник.ДополнительныеСвойства.Обмены, СтрЗаменить("Обмен_"+Строка(СО.Обмен.УникальныйИдентификатор()),"-","_"),СО);
					
				КонецЕсли; 
			КонецЦикла; // по доступным обменам
		КонецЕсли; 
	КонецЕсли; 

	// ИСТОРИЯ
	Если Источник.ДополнительныеСвойства.ФО.ИспользованиеИсторииОбъектов И НЕ Отказ Тогда
		CW_Журнал.ОпределитьРежимЗаписиОбъекта(Источник, РежимЗаписи);
	КонецЕсли; 
	
КонецПроцедуры

Процедура CW_ПриЗаписи(Источник, Отказ) Экспорт
	
	Если ТипЗнч(Источник) = Тип("СправочникОбъект.ВерсииРасширений") Тогда
		Возврат; 
	КонецЕсли;
	
	Если Источник.ОбменДанными.Загрузка Тогда 
		Возврат; 
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	ЗапомнитьИспользованиеФункциональныхОпцийВДополнительныхСвойствах(Источник);
	
	// ПОДКЛЮЧАЕМЫЕ СОБЫТИЯ
	Если (Источник.ДополнительныеСвойства.ФО.ИспользованиеВнешнихПодписок) Тогда
		ВнешняяПодписка(Перечисления.CW_ВидыВнешнихПодписок.ОбработчикПриЗаписи, Источник, Отказ);
	КонецЕсли;
	
	// ОБМЕНЫ
	Если Источник.ДополнительныеСвойства.ФО.ИспользованиеОбменов И НЕ Отказ Тогда
		
		Если (_сф.ст_ПолучитьСвойство(Источник.ДополнительныеСвойства,"Обмены") <> Неопределено) Тогда
			
			Для каждого СтруктураОбмена Из Источник.ДополнительныеСвойства.Обмены Цикл
				
				СО = СтруктураОбмена.Значение;
				// --- 
				Если СО.ПроверкаПриЗаписи Тогда
					
					// вызов проверки при записи
					ОбработкаОбъект = _ПО.ПолучитьОбработку(СО.Обмен.Обработка);
					ОбработкаОбъект.РегистрацияПриЗаписи(Источник,СО); // уходим в обработку
					
				КонецЕсли; 
				// --- 
				Если СО.Использование Тогда
					
					CW_Обмены.ЗаписатьПараметрыРегистрации(Источник,СО,Отказ);
					Если Отказ Тогда
						
						// TODO сообщаем об ошибке в журнал регистрации
						Возврат;
						
					КонецЕсли; 
					
				КонецЕсли; 
				
			КонецЦикла; 
			
		КонецЕсли; 
		
	КонецЕсли; 
	
	// ИСТОРИЯ
	Если Источник.ДополнительныеСвойства.ФО.ИспользованиеИсторииОбъектов И НЕ Отказ Тогда
		_СобытиеЗаписи = _сф.ст_ПолучитьСвойство(Источник.ДополнительныеСвойства,"_СобытиеЗаписи");
		Если (_СобытиеЗаписи <> Неопределено) Тогда
			CW_Журнал.ДобавитьЗаписьИстории(Источник, _СобытиеЗаписи);
		КонецЕсли; 
	КонецЕсли; 
	
	// прикрепляемые файлы
	Если Источник.ДополнительныеСвойства.Свойство("CW_СобытиеЗаписи") 
		И Источник.ДополнительныеСвойства.CW_СобытиеЗаписи = Перечисления.CW_СобытияОбъектов.ПометкаУдаления 
		И Метаданные.Справочники.CW_ОбъектыАрхива.Реквизиты.Объект.Тип.СодержитТип(ТипЗнч(Источник.Ссылка))
	Тогда 
		_ТипОбъекта = Источник.Метаданные().ПолноеИмя();// вида Справочник.CW_Грузоперевозки
		з = Новый Запрос(
			"ВЫБРАТЬ
			|	CW_ОбъектыАрхива.Ссылка
			|ИЗ
			|	Справочник.CW_ОбъектыАрхива КАК CW_ОбъектыАрхива
			|ГДЕ
			|	НЕ CW_ОбъектыАрхива.ПометкаУдаления
			|	И (ВЫРАЗИТЬ(CW_ОбъектыАрхива.Объект КАК "+_ТипОбъекта+")) = &Объект"
		);
		з.УстановитьПараметр("Объект", Источник.Ссылка);
		рз = з.Выполнить();
		выб = рз.Выбрать();
		Пока выб.Следующий() Цикл
			выб.Ссылка.ПолучитьОбъект().УстановитьПометкуУдаления(Истина);
		КонецЦикла;
	КонецЕсли;
		
КонецПроцедуры

Процедура CW_ПриПроведении(Источник, Отказ, РежимПроведения) Экспорт
	
	Если Источник.ОбменДанными.Загрузка Тогда 
		Возврат; 
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	ЗапомнитьИспользованиеФункциональныхОпцийВДополнительныхСвойствах(Источник);
	ДС = _сф.ДС(Источник);

	Если ТипЗнч(Источник) = Тип("ДокументОбъект.ПодтверждениеНулевойСтавкиНДС") Тогда    
		 ОбработатьДвиженияПодтверждениеНулевойСтавкиНДС(Источник);
	КонецЕсли;
	
	// ПОДКЛЮЧАЕМЫЕ СОБЫТИЯ
	Если (ДС.ФО.ИспользованиеВнешнихПодписок) Тогда
		ВнешняяПодписка(Перечисления.CW_ВидыВнешнихПодписок.ОбработчикПриПроведении,Источник,Отказ,,РежимПроведения);
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработатьДвиженияПодтверждениеНулевойСтавкиНДС(Источник)
	
	ДвиженияНДСЗаписиКнигиПродаж = Источник.Движения.НДСЗаписиКнигиПродаж;
	Для Каждого Движение из ДвиженияНДСЗаписиКнигиПродаж Цикл
		
		Если ТипЗнч(Движение.СчетФактура) = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
			Движение.КодВидаОперации = ПолучитьКодВидаОперации(Движение.СчетФактура, Движение.КодВидаОперации);
		КонецЕсли;
		
	КонецЦикла;
	
	ДвиженияНДСЗаписиКнигиПродаж.Записать();
	
КонецПроцедуры

Функция ПолучитьКодВидаОперации(Знач РеализацияТоваровУслуг, Знач КодВидаОперации) 
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	CW_ДоходыПоГрузоперевозке.Ссылка КАК Ссылка,
	               |	CW_ДоходыПоГрузоперевозке.КодВидаОперации КАК КодВидаОперации
	               |ИЗ
	               |	Документ.CW_ДоходыПоГрузоперевозке КАК CW_ДоходыПоГрузоперевозке
	               |ГДЕ
	               |	CW_ДоходыПоГрузоперевозке.ВедомыйДокумент = &РеализацияТоваровУслуг"; 
	
	Запрос.УстановитьПараметр("РеализацияТоваровУслуг",РеализацияТоваровУслуг);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат СокрЛП(Выборка.КодВидаОперации); 
	КонецЕсли;
	
	Возврат КодВидаОперации;
	
КонецФункции


Процедура CW_ПередУдалением(Источник, Отказ) Экспорт
	
	Если Источник.ОбменДанными.Загрузка Тогда 
		Возврат; 
	КонецЕсли; 
	
	УстановитьПривилегированныйРежим(Истина);
	ЗапомнитьИспользованиеФункциональныхОпцийВДополнительныхСвойствах(Источник);
	ДС = _сф.ДС(Источник);
	
	// ПОДКЛЮЧАЕМЫЕ СОБЫТИЯ
	Если (ДС.ФО.ИспользованиеВнешнихПодписок) Тогда
		ВнешняяПодписка(Перечисления.CW_ВидыВнешнихПодписок.ОбработчикПередУдалением,Источник,Отказ);
	КонецЕсли;   
	
	//ОБЪЕКТЫ АРХИВА
	Справочники.CW_ВладельцыАрхива.УдалитьВладельцаАрхива(Источник.Ссылка);
	
	// ОБМЕНЫ
	Если (ДС.ФО.ИспользованиеОбменов И НЕ Отказ) Тогда
		
		Ответ = CW_Обмены.ОбъектРегистрируется(Источник);
		// в массиве возвращаются обмены и их параметры 
		Если (_УФКС.ВыполненоУспешно(Ответ)) Тогда
			
			ДатаИзменения = ТекущаяДата();
			МассивОбменов = Ответ.МассивОбменов;
			
			Для каждого СтруктураОбмена Из МассивОбменов Цикл
				
				СО = _сф.ст_Создать("Обмен,Отказ,Использование,Метаданное,ДатаИзменения,РежимЗаписи,Обработка,МассивЗаписей,ПроверкаПередЗаписью,ПроверкаПриЗаписи,ПроверкаПередУдалением");
				// --- 
				СО.Обмен 				= СтруктураОбмена.Обмен;
				СО.Отказ				= Ложь;
				СО.Использование 		= Ложь;
				СО.Метаданное			= CW_Обмены_ПИ.МетаданноеКонфигурации(Источник.Метаданные().ПолноеИмя());
				СО.ДатаИзменения		= ДатаИзменения;
				СО.РежимЗаписи			= Перечисления.CW_РежимыЗаписи.ПометкаУдаления; 
				СО.ПроверкаПередЗаписью = СтруктураОбмена.ПередЗаписью;
				СО.ПроверкаПриЗаписи	= СтруктураОбмена.ПриЗаписи;
				СО.ПроверкаПередУдалением = СтруктураОбмена.ПередУдалением;
				СО.МассивЗаписей		= Новый Массив;
				// --- 
				
				Если СО.ПроверкаПередУдалением Тогда
					
					// получаем обработку
					// вызываем метод проверки
					ОбработкаОбъект = _ПО.ПолучитьОбработку(СО.Обмен.Обработка);
					ОбработкаОбъект.РегистрацияПередУдалением(Источник,СО); // уходим в обработку
					
					Отказ = СО.Отказ;
					Если Отказ Тогда
						
						Возврат;
						
					КонецЕсли; 
					
				КонецЕсли; 	
				
				// --- 
				Если СО.Использование Тогда
					
					CW_Обмены.ЗаписатьПараметрыРегистрации(Источник,СО,Отказ);
					Если Отказ Тогда
						
						// TODO сообщаем об ошибке в журнал регистрации
						Возврат;
						
					КонецЕсли; 
					
				КонецЕсли; 
				
				// ---------------------------------------------------------------------------- 
				
			КонецЦикла; // по доступным обменам
			
		КонецЕсли; 	
		
	КонецЕсли; 
		
КонецПроцедуры


Процедура ВнешняяПодписка(Событие, Источник, Отказ, РежимЗаписи=Неопределено, РежимПроведения=Неопределено)
	
	СсылкаНаМетаданное  = CW_Обмены_ПИ.МетаданноеКонфигурации(Источник.Метаданные().ПолноеИмя());
	
	РезультатЗапроса 	= CW_Обмены_ПИ.ПолучитьДанныеПоВнешнейПодписке(СсылкаНаМетаданное, Событие);
	
	Если не РезультатЗапроса.Пустой() Тогда
		//Есть подписки
		Выборка_Подписки = РезультатЗапроса.Выбрать();
		
		Пока Выборка_Подписки.Следующий() Цикл
			
			ВнешняяОбработка = _ПО.ПолучитьОбработку(Выборка_Подписки.Обработка);
			
			Попытка
				Используется = ВнешняяОбработка.Использование(Источник, Отказ);
			Исключение
				Используется = Истина;
			КонецПопытки;  
			
			Если Используется Тогда
				
				Если Событие = Перечисления.CW_ВидыВнешнихПодписок.ОбработчикПередЗаписью Тогда
					
					ВнешняяОбработка.ОбработчикПередЗаписью(Выборка_Подписки.Обработка, Источник, Отказ, РежимЗаписи, РежимПроведения);
					
				ИначеЕсли Событие = Перечисления.CW_ВидыВнешнихПодписок.ОбработчикПриЗаписи Тогда 
					
					ВнешняяОбработка.ОбработчикПриЗаписи(Выборка_Подписки.Обработка, Источник, Отказ);
					
				ИначеЕсли Событие = Перечисления.CW_ВидыВнешнихПодписок.ОбработчикПриПроведении Тогда 
					
					ВнешняяОбработка.ОбработчикПриПроведении(Выборка_Подписки.Обработка, Источник, Отказ, РежимПроведения);
					
				ИначеЕсли Событие = Перечисления.CW_ВидыВнешнихПодписок.ОбработчикПередУдалением Тогда 
					
					ВнешняяОбработка.ОбработчикПередУдалением(Выборка_Подписки.Обработка, Источник, Отказ);	
					
				КонецЕсли;
				
			КонецЕсли; 
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

