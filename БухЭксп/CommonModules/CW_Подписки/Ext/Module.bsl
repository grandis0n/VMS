							СчетУчетаДляСальдо = CW_Настройки.ПараметрУчетнойПолитики(Источник.Дата, Источник.Организация, "СчетРасчетов_Клиенты_Валюта");	
						КонецЕсли;
						// --- 
						СуммаДвиженияБУ = Стр.СуммаРаспределенная*КурсВводаОстатков;
						СуммаДвиженияНУ = СуммаДвиженияБУ;
