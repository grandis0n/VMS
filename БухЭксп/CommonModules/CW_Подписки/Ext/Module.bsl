						КонецЕсли; 
						
					КонецЕсли;
					
					// Ввод начальных остатков	
				КонецЕсли;
				
			#КонецОбласти 
				
			#Область ВводНачальныхОстатков 
			
			Если (РежимВводначальныхОстатков_ОЗ) Тогда
				
				Если ЕстьСчет  Тогда
					
					// определяем параметры документа
					ВалютныйДокумент = (Документ.Валюта <> Свойства.КО.ВалютаРегламентированногоУчета);
					
