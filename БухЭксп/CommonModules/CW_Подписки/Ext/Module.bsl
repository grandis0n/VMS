		#КонецОбласти // КорректировкаРегистра_НДСКосвенныеРасходы 
		
	КонецЕсли; // корректировка регистров подсистемы НДС
	
	#Область КорректировкаРегистровПодсистемыУСН
	
		// корректировка регистров подсистемы УСН
		Если КорректироватьКУДиР Тогда
			
			// подготовим данные для корректировки записей в регистре
			#Область Область_1929
			
				// от настроек порядка признания расходов зависит нужно включать НДС в суммы или нет
				ПорядокПризнанияРасходовПоНДС = CW_Настройки.ПараметрУчетнойПолитикиУСН(Источник.Дата,Источник.Организация,"ПорядокПризнанияРасходовПоНДС");
				
				// расчитаем рублевый эквивалент оплаченной суммы собственных услуг
				СуммаЗачетаСобственныхУслугВВалюте = Мин(ТаблицаСобственныхУслуг.Итог("Всего"),ВедущийДокумент.ЗачетАвансов.Итог("СуммаЗачета"));
				
				// сумма собственных услуг была оплачена в полном объеме
				Если СуммаЗачетаСобственныхУслугВВалюте = ТаблицаСобственныхУслуг.Итог("Всего") Тогда
					ВсегоКУДиР = ТаблицаСобственныхУслуг.Итог("Всего_Рег");
					СуммаКУДиР = ТаблицаСобственныхУслуг.Итог("Сумма_Рег");
					НДСКУДиР = ТаблицаСобственныхУслуг.Итог("НДС_Рег");
					
				// сумма собственных услуг была оплачена частично	
				Иначе
					ОплаченнаяДоляУслуг = _СФ.БезопасноРазделить(ВедущийДокумент.ЗачетАвансов.Итог("СуммаЗачета"),ТаблицаСобственныхУслуг.Итог("Всего")); 
					ВсегоКУДиР = Окр(ТаблицаСобственныхУслуг.Итог("Всего_Рег") * ОплаченнаяДоляУслуг,2,1);
					СуммаКУДиР = Окр(ТаблицаСобственныхУслуг.Итог("Сумма_Рег") * ОплаченнаяДоляУслуг,2,1);
					НДСКУДиР = Окр(ТаблицаСобственныхУслуг.Итог("НДС_Рег") * ОплаченнаяДоляУслуг,2,1);
				КонецЕсли; 
			#КонецОбласти 
		
			#Область КорректировкаРегистра_КнигаУчетаДоходовИРасходов
				
				ДвиженияРегистра = Источник.Движения.КнигаУчетаДоходовИРасходов;
				Для Каждого ЗаписьРегистра Из ДвиженияРегистра Цикл
					
					// запись по виду расхода "Услуги"
					Если ЗаписьРегистра.ВидРасхода = Перечисления.ВидыРасходовУСН.Услуги Тогда
						
						Если ПорядокПризнанияРасходовПоНДС = Перечисления.ПорядокПризнанияРасходовПоНДС.ВключатьВСтоимость Тогда
							ЗаписьРегистра.Графа7 = ВсегоКУДиР;
							ЗаписьРегистра.НДС = НДСКУДиР;
						Иначе
							ЗаписьРегистра.Графа7 = СуммаКУДиР;
							ЗаписьРегистра.НДС = НДСКУДиР;
						КонецЕсли; 
						
					// запись по виду расхода "НДС" (формируется только при условии порядка признания расходов по НДС = "По оплате поставщику")
					ИначеЕсли ЗаписьРегистра.ВидРасхода = Перечисления.ВидыРасходовУСН.Услуги Тогда
						ЗаписьРегистра.Графа7 = НДСКУДиР;
						ЗаписьРегистра.НДС = 0;
					КонецЕсли; 
				КонецЦикла; // перебор движений по регистру "КнигаУчетаДоходовИРасходов"
				
			#КонецОбласти 		
			
			#Область КорректировкаРегистра_РасшифровкаКУДиР
			
				ДвиженияРегистра = Источник.Движения.РасшифровкаКУДиР;
				Если ДвиженияРегистра.Количество() > 0 Тогда
				
					// подготовим таблицу значений с суммами для корректировки движений
					ТЗДляДвижений = ДвиженияРегистра.Выгрузить(,"РеквизитыДокументаОплаты");
					ТЗДляДвижений.Свернуть("РеквизитыДокументаОплаты");
					
					ОписаниеТипаЧисло = Новый ОписаниеТипов("Число",Новый КвалификаторыЧисла(15,2));
					ТЗДляДвижений.Колонки.Добавить("ЗачтеноВал",ОписаниеТипаЧисло);
					ТЗДляДвижений.Колонки.Добавить("ВсегоРуб",ОписаниеТипаЧисло);
					ТЗДляДвижений.Колонки.Добавить("СуммаРуб",ОписаниеТипаЧисло);
					ТЗДляДвижений.Колонки.Добавить("НДСРуб",ОписаниеТипаЧисло);
					
					// получим таблицу зачтенных авансов
					ТЗЗачтенныеАвансы = ВедущийДокумент.ЗачетАвансов.Выгрузить();
					
					// распределим сумму зачтенного аванса по собственным услугам между документами оплаты
					ОстатокЗачета = СуммаЗачетаСобственныхУслугВВалюте;
					ОстатокСобственныхУслуг = ТаблицаСобственныхУслуг.Итог("Всего");
					Для Каждого Стр Из ТЗДляДвижений Цикл
						СтрЗачтенногоАванса = ТЗЗачтенныеАвансы.Найти(Стр.РеквизитыДокументаОплаты,"ДокументАванса");
						Если СтрЗачтенногоАванса <> Неопределено Тогда
							Стр.ЗачтеноВал = Мин(ОстатокЗачета,СтрЗачтенногоАванса.СуммаЗачета);
							ОстатокЗачета = ОстатокЗачета - Стр.ЗачтеноВал;
						КонецЕсли; 
					КонецЦикла; 
					
					// если зачтенный аванс не удалось распределить между платежками, то сообщим пользователю...
					Если ОстатокЗачета <> 0 Тогда
						Сообщить("Ошибка распределения суммы зачтенного аванса: <ОбщийМодуль.CW_Подписки.СкорректироватьНДСРубИСуммаРубСУчетомЗачтенногоАванса()>",СтатусСообщения.ОченьВажное); 
						Сообщить("Обратитесь к разработчику!",СтатусСообщения.ОченьВажное); 
					КонецЕсли; 
					
					// расчитаем рублевые эквиваленты, подлежащие расшифровки
					ОстатокВсегоКУДиР = ВсегоКУДиР;
					ОстатокСуммаКУДиР = СуммаКУДиР;
					ОстатокНДСКУДиР = НДСКУДиР;
					
					Для Каждого Стр Из ТЗДляДвижений Цикл
						Стр.ВсегоРуб = Окр(ВсегоКУДиР * Стр.ЗачтеноВал / СуммаЗачетаСобственныхУслугВВалюте,2,1);	
						ОстатокВсегоКУДиР = ОстатокВсегоКУДиР - Стр.ВсегоРуб;
						Стр.СуммаРуб = Окр(СуммаКУДиР * Стр.ЗачтеноВал / СуммаЗачетаСобственныхУслугВВалюте,2,1);	
						ОстатокСуммаКУДиР = ОстатокСуммаКУДиР - Стр.СуммаРуб;
						Стр.НДСРуб = Окр(НДСКУДиР * Стр.ЗачтеноВал / СуммаЗачетаСобственныхУслугВВалюте,2,1);	
						ОстатокНДСКУДиР = ОстатокНДСКУДиР - Стр.НДСРуб;
					КонецЦикла; 
					
					// если остались нераспределенные суммы, то списываем их на первую строку
					Если (ОстатокВсегоКУДиР <> 0) ИЛИ (ОстатокСуммаКУДиР <> 0) ИЛИ (ОстатокНДСКУДиР <> 0) Тогда
						ТЗДляДвижений[0].ВсегоРуб = ТЗДляДвижений[0].ВсегоРуб + ОстатокВсегоКУДиР; 	
						ТЗДляДвижений[0].СуммаРуб = ТЗДляДвижений[0].СуммаРуб + ОстатокСуммаКУДиР; 	
						ТЗДляДвижений[0].НДСРуб = ТЗДляДвижений[0].НДСРуб + ОстатокНДСКУДиР; 	
					КонецЕсли; 
					
					// переберем движения и скорректируем суммы
					Для Каждого ЗаписьРегистра Из ДвиженияРегистра Цикл
						СтрЗачтенногоАванса = ТЗДляДвижений.Найти(ЗаписьРегистра.РеквизитыДокументаОплаты,"РеквизитыДокументаОплаты");
						Если СтрЗачтенногоАванса <> Неопределено Тогда
							Если ЗаписьРегистра.ВидРасхода = Перечисления.ВидыРасходовУСН.Услуги Тогда
								ЗаписьРегистра.Графа7 = СтрЗачтенногоАванса.СуммаРуб;
							ИначеЕсли ЗаписьРегистра.ВидРасхода = Перечисления.ВидыРасходовУСН.НДС Тогда
								ЗаписьРегистра.Графа7 = СтрЗачтенногоАванса.НДСРуб;
							КонецЕсли; 
						КонецЕсли; 
					КонецЦикла; // перебор движений регистра
				
				КонецЕсли; // если в регистре есть движения
				
			#КонецОбласти 	
			
		КонецЕсли; // корректировка регистров подсистемы УСН
	
	#КонецОбласти 
	
	
КонецПроцедуры // СкорректироватьНДСРубИСуммаРубСУчетомЗачтенногоАванса()

Процедура CW_ПриЗаписиДоходовРасходовПоГрузоперевозкеПриЗаписи(Источник, Отказ) Экспорт
	
	#Область УстановкаСрокаОплатыДляНовыхДокументов
		Если (НЕ _сф.ст_ПолучитьСвойство(Источник.ДополнительныеСвойства,"ПерваяЗаписьОбъекта",Ложь)) Тогда
			Возврат;
		КонецЕсли;
		
		НаборЗаписей = РегистрыСведений.CW_СрокиОплатыСчетов.СоздатьНаборЗаписей();
		_сф.УстановитьОтбор(НаборЗаписей.Отбор, "Счет", Источник.Ссылка);
		НаборЗаписей.Прочитать();
		
		Если НаборЗаписей.Количество() = 0 Тогда
			
			_СрокОплаты = _сф.ст_ПолучитьСвойство(Источник.ДополнительныеСвойства,"СрокОплаты",Дата(1,1,1));
			_СрокОплатыРучноеРедактирование = _сф.ст_ПолучитьСвойство(Источник.ДополнительныеСвойства,"СрокОплатыРучноеРедактирование",Ложь);
			
			Если (НЕ _СрокОплатыРучноеРедактирование) Тогда
				Если (ЗначениеЗаполнено(_СрокОплаты)) Тогда
					_СрокОплатыОписание = _сф.ст_ПолучитьСвойство(Источник.ДополнительныеСвойства,"СрокОплатыОписание","");
					CW_Документы.УстановитьСрокОплаты(Новый Структура("Счет,ДатаОплаты,Описание",Источник.Ссылка,_СрокОплаты,_СрокОплатыОписание));
				Иначе
					СтруктураДанных = CW_Документы.ПодготовитьДанныеДляРасчетаСрокаОплаты(Источник.Ссылка);
					ДатаОплаты 		= CW_Документы.РассчитатьСрокОплаты(СтруктураДанных);
					
					CW_Документы.УстановитьСрокОплаты(Новый Структура("Счет,ДатаОплаты,Описание",Источник.Ссылка,ДатаОплаты,""));
				КонецЕсли; 
			КонецЕсли; 
		КонецЕсли;	
	
	#КонецОбласти 
	
КонецПроцедуры

// Формирует движения для документа "Расходы по грузоперевозкам" 
//
// Параметры:
// ----------
//  <ВнешняяТаблицаУслуг>  - используется только для документов в У.Е. или в валюте с актом, во всех остальных случаях идёт пересчёт по курсам
//
Процедура СформироватьДвиженияДляРасходов(Документ,Отказ=Ложь,Свойства=Неопределено,ВнешняяТаблицаУслуг=Неопределено) Экспорт 
	
	Если (Документ.ПометкаУдаления) Тогда
		
		Отказ = Истина;
		Сообщить("Документ """+Строка(Документ)+""" помечен на удаление. Нарушена синхронизация пометок удаления!");
		Возврат;
		
	КонецЕсли; 
	
	#Область Параметры 
	
		Если (Свойства = Неопределено) Тогда
			
			СтруктураПараметров = CW_Настройки.ПустаяСтруктураПолученияПараметровДоговора();
			СтруктураПараметров.Дата 				= Документ.Дата;
			СтруктураПараметров.Договор 			= Документ.Договор;
			СтруктураПараметров.ПриложениеКДоговору = Документ.ПриложениеКДоговору;
			
			ПараметрыДоговора	= CW_Настройки.ПолучитьПараметрыДоговора(СтруктураПараметров);
			
			СКонстанты = Новый Структура;
			СКонстанты.Вставить("ВалютаРегламентированногоУчета",CW_Настройки.ВалютаРегламентированногоУчета());
		
			Свойства = Новый Структура;
			Свойства.Вставить("КО",	СКонстанты);
			Свойства.Вставить("ПД",	ПараметрыДоговора);
		КонецЕсли; 
		
		ДатаНачалаВеденияУчета 					= CW_Настройки.ПолучитьДатуНачалаВеденияУчета(Документ.Организация);
		РежимВводНачальныхОстатков 				= ?(ДатаНачалаВеденияУчета <> Неопределено, Документ.Дата < ДатаНачалаВеденияУчета,Ложь);
		ВалютаРегламентированногоУчетаРубль 	= ПолучитьФункциональнуюОпцию("CW_ВалютаРегламентированногоУчетаРубль"); 
		УчитыватьНДСВСебестоимости 				= CW_Настройки.ПараметрУчетнойПолитики(Документ.Дата, Документ.Организация, "УчитыватьНДСВСебестоимости");
		
		ЕстьСчет 	= (Документ.ПредъявленСчет);	
		ЕстьАкт 	= (Документ.ПредъявленАкт ИЛИ Документ.ПредъявленСФ или НЕ ВалютаРегламентированногоУчетаРубль);
		ДатаСчета 	= ?(ЕстьСчет,Документ.ДатаСчета,Документ.Дата);
		ДатаАкта 	= ?(Не ВалютаРегламентированногоУчетаРубль, ДатаСчета,?(Документ.ДатаАкта = Дата(1,1,1),Документ.ДатаСФ,Документ.ДатаАкта));
		
		//Подситема.СтатусыДокументов
		СтатусДокумента = Неопределено;
		Если Свойства.Свойство("СтатусДокумента") Тогда
			СтатусДокумента = Свойства.СтатусДокумента;
		Иначе
			ДанныеСтатуса 	= РегистрыСведений.CW_СтатусыДокументов.ПолучитьДанныеСтатусаДокумента(Документ);
			СтатусДокумента	= ДанныеСтатуса.СтатусДокумента;
		КонецЕсли;
		
		СтатусДокументаПроводитьПоБухгалтерскомуУчету = CW_СтатусыДокументовСервер.ПолучитьПризнакПроведенияПоБухгалтерскомуУчету(Документ, СтатусДокумента);
		//Подситема.СтатусыДокументов
		
		СтруктураПараметровБухУчета = Новый Структура;
		СтруктураПараметровБухУчета.Вставить("Договор", 				Документ.Договор);
		СтруктураПараметровБухУчета.Вставить("ПриложениеКДоговору",		Документ.ПриложениеКДоговору);
		
		ПараметрыБухгалтерскогоУчета  = CW_Финансы.ПолучитьПарметрыВеденияБухгалтерскогоУчета(СтруктураПараметровБухУчета, Документ.Дата);
		ПровестиПоБухгалтерскомуУчету = ПараметрыБухгалтерскогоУчета.БухгалтерскийУчет и СтатусДокументаПроводитьПоБухгалтерскомуУчету;
		
		СтруктураНастроек = CW_Настройки.ПолучитьНастройкиОперативногоУчета(Документ.Организация, Перечисления.CW_ВидыОперативнойЗадолженности.Кредиторская, Документ.Дата);
		
		РежимВводначальныхОстатков_ОЗ 			= СтруктураНастроек["ВводОстатков"];
		ИспользуетсяОперативнаяЗадолженность 	= СтруктураНастроек["ВедетсяОперативныйУчет"];
		
		НастройкиОперативногоУчета = СтруктураНастроек["НастройкиОперативногоУчета"];
		КонтрольНоменклатуры 		= НастройкиОперативногоУчета["КонтрольНоменклатуры"];
		КонтрольПорядкаОтражения 	= НастройкиОперативногоУчета["КонтрольПорядкаОтражения"];
		КонтрольНДС 				= НастройкиОперативногоУчета["КонтрольНДС"];  
		
		УчетАгентскогоНДС = Документ.Договор.БухгалтерскийУчет И Документ.Договор.УчетныйДоговор.УчетАгентскогоНДС;
		
	#КонецОбласти 
	
	#Область НаборыДвиженийПоОсновнымРегистрам
	
		НЗ_Расходы 					= _сф.НаборЗаписейПоРегистратору(РегистрыНакопления.CW_РасходыПоГрузоперевозкам,Документ);
		НЗ_Перевыставление 			= _сф.НаборЗаписейПоРегистратору(РегистрыНакопления.CW_Перевыставление,Документ);
		НЗ_ПеревыставлениеПоСтавкам = _сф.НаборЗаписейПоРегистратору(РегистрыНакопления.CW_ПеревыставлениеПоСтавкам,Документ);
		
		ПараметрыУчетнойПолитикиБП 	= CW_Настройки.ПараметрыГлобальнойУчетнойПолитики(Документ.Дата, Документ.Организация);
		
		//Подсистема.УчетНЗП  
		ПараметрыУчетнойПолитики 	= CW_Настройки.ПараметрыУчетнойПолитики(Документ.Дата, Документ.Организация);

		Если Документ.ПредъявленАкт 
			и ПолучитьФункциональнуюОпцию("CW_ВедетсяУчетНЗП") 
			и ПараметрыУчетнойПолитики.ВедетсяУчетНЗП Тогда 
			
			ПорядокОтраженияДляНЗП 	= CW_УчетНЗПСервер.ПолучитьПорядокОтраженияДляУчетаВСоставеНЗП();
			мСоставЗатрат 			= ПорядокОтраженияДляНЗП["Расходы"];
			
			НЗ_НЗП = _сф.НаборЗаписейПоРегистратору(РегистрыНакопления.CW_НезавершенноеПроизводство, Документ);
			
		КонецЕсли;
		//Подсистема.УчетНЗП
		
		#КонецОбласти 
	
	#Область ОсновныеРегистры 
		
		// получаем таблицу услуг
		Если (Документ.Валюта <> Свойства.КО.ВалютаРегламентированногоУчета И (Документ.ПредъявленАкт ИЛИ Документ.ПредъявленСФ) И ВнешняяТаблицаУслуг <> Неопределено) Тогда
			ТаблицаУслуг = ВнешняяТаблицаУслуг;
		Иначе
			ТаблицаУслуг = Документ.Услуги.Выгрузить();
			CW_Финансы.ДобавитьКолонкиБазовойВалюты(ТаблицаУслуг);
		КонецЕсли; 
		ТаблицаДвиженийПоОсновнымРегистрам = ТаблицаУслуг;
		
		// определяем курс для пересчёта базового эквивалента для отражения по регистру "Расходы по грузоперевозкам"
		// если они не рассчитаны в подписке
		ТребуетсяЗаполнениеСуммРегУчета = Ложь;
		Если (Документ.Валюта = Свойства.КО.ВалютаРегламентированногоУчета) Тогда
			
			Курс = Новый Структура("Курс,Кратность",1,1);
			ТребуетсяЗаполнениеСуммРегУчета = Истина;
			
		ИначеЕсли (ВнешняяТаблицаУслуг <> Неопределено) Тогда 
			
			ТребуетсяЗаполнениеСуммРегУчета = Ложь; 
			
		// документ в валюте, отличной от базовой валюты учета
		Иначе
			Если ((Документ.Договор.ВзаиморасчетыВУЕ И РежимВводНачальныхОстатков И ЕстьАкт) ИЛИ Документ.УЕ_ПользовательскийКурс) Тогда
				ТребуетсяЗаполнениеСуммРегУчета = Истина;
				Если  Документ.УЕ_ПользовательскийКурс Тогда
					Курс = Новый Структура("Курс,Кратность",Документ.УЕ_Курс,Документ.УЕ_Кратность);
				Иначе
					Курс = Новый Структура("Курс,Кратность",Документ.КурсВзаиморасчетовБУ,1);
				КонецЕсли; 
			Иначе
				Если (НЕ Документ.Договор.ВзаиморасчетыВУЕ 
					ИЛИ РежимВводНачальныхОстатков 
					ИЛИ НЕ ПровестиПоБухгалтерскомуУчету
					ИЛИ (Документ.Договор.ВзаиморасчетыВУЕ И НЕ ЕстьАкт И ЕстьСчет)) 
					Тогда
					
					ТребуетсяЗаполнениеСуммРегУчета = Истина;  
					Если Документ.ФормироватьВедомыеДатойДокумента Тогда
						ДатаКурса = ?(ЗначениеЗаполнено(Документ.Дата), Документ.Дата, ТекущаяДата());	
					Иначе
						Если (ЕстьАкт) Тогда
							ДатаКурса = ДатаАкта;
						Иначе
							Если (ЕстьСчет) Тогда 
								ДатаКурса = ДатаСчета;
							Иначе
								ДатаКурса = Документ.Дата;
							КонецЕсли;
						КонецЕсли; 
					КонецЕсли;
					Курс = CW_Финансы.ПолучитьКурсВалюты(Документ.Валюта,ДатаКурса);
				КонецЕсли; 
			КонецЕсли; 
		КонецЕсли; 
		
		Если (ТребуетсяЗаполнениеСуммРегУчета) Тогда   
			
			Если Свойства.ПД.РасчетРублевогоЭквивалентаПропорциональноПоСуммеИтога Тогда
				
				ВсегоПоТаблице 		=  ТаблицаДвиженийПоОсновнымРегистрам.Итог("Всего");
				ВсегоРаспределяемаяСумма = Окр(CW_Финансы.ПересчитатьИзВалютыВВалюту(ВсегоПоТаблице, Документ.Валюта, Свойства.КО.ВалютаРегламентированногоУчета, Курс.Курс, 1, Курс.Кратность, 1),2,1);	
				ОбщегоНазначенияБПВызовСервера.РаспределитьСуммуПоКолонкеТаблицы(ВсегоРаспределяемаяСумма, ТаблицаДвиженийПоОсновнымРегистрам, "Всего_Рег", "Всего");
				
				СуммаПоТаблице 		=  ТаблицаДвиженийПоОсновнымРегистрам.Итог("Сумма");
				СуммаРаспределяемаяСумма = Окр(CW_Финансы.ПересчитатьИзВалютыВВалюту(СуммаПоТаблице, Документ.Валюта, Свойства.КО.ВалютаРегламентированногоУчета, Курс.Курс, 1, Курс.Кратность, 1),2,1);	
				ОбщегоНазначенияБПВызовСервера.РаспределитьСуммуПоКолонкеТаблицы(СуммаРаспределяемаяСумма, ТаблицаДвиженийПоОсновнымРегистрам, "Сумма_Рег", "Сумма");
				
				Для каждого СтрокаУслуги Из ТаблицаДвиженийПоОсновнымРегистрам Цикл
