Процедура CW_КонтрольВедомыхПередЗаписью(Источник, Отказ, РежимЗаписи, РежимПроведения) Экспорт
	
	Если Источник.ОбменДанными.Загрузка Тогда 
		Возврат; 
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Источник.Ссылка) Тогда 
		Возврат; 
	КонецЕсли;  
	
	
	Если ТипЗнч(Источник)=Тип("ДокументОбъект.ПоступлениеТоваровУслуг") Тогда
		КонтрольВедомыхПоступлениеТоваровУслуг(Источник, Отказ, РежимЗаписи, РежимПроведения);
	КонецЕсли;  
	
	Если ТипЗнч(Источник)=Тип("ДокументОбъект.СписаниеСРасчетногоСчета") и 
		Источник.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийСписаниеДенежныхСредств.ВозвратПокупателю") Тогда
		
		КонтрольВедомыхВыпискаВозвратПокупателю(Источник, Отказ, РежимЗаписи, РежимПроведения); 
		
	ИначеЕсли ТипЗнч(Источник)=Тип("ДокументОбъект.ПоступлениеНаРасчетныйСчет") и 
		Источник.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПоступлениеДенежныхСредств.ВозвратОтПоставщика") Тогда

		КонтрольВедомыхВыпискаВозвратОтПоставщика(Источник, Отказ, РежимЗаписи, РежимПроведения); 
		
	ИначеЕсли ТипЗнч(Источник)=Тип("ДокументОбъект.СписаниеСРасчетногоСчета") 
		ИЛИ ТипЗнч(Источник)=Тип("ДокументОбъект.ПоступлениеНаРасчетныйСчет") Тогда  
		
		КонтрольВедомыхВыписка(Источник, Отказ, РежимЗаписи, РежимПроведения);   
		
	КонецЕсли;      
	
	Если ТипЗнч(Источник)=Тип("ДокументОбъект.КорректировкаПоступления") Тогда
		КонтрольВедомыхКорректировкаПоступления(Источник, Отказ, РежимЗаписи, РежимПроведения);
	КонецЕсли;
	
	Если ТипЗнч(Источник)=Тип("ДокументОбъект.РеализацияТоваровУслуг") Тогда
		КонтрольВедомыхРеализацияТоваровУслуг(Источник, Отказ, РежимЗаписи, РежимПроведения);
	КонецЕсли; 
	
	Если ТипЗнч(Источник)=Тип("ДокументОбъект.КорректировкаРеализации") Тогда
		КонтрольВедомыхКорректировкаРеализации(Источник, Отказ, РежимЗаписи, РежимПроведения);
	КонецЕсли;      

	
КонецПроцедуры

//Контроль ведомых
Процедура КонтрольВедомыхПоступлениеТоваровУслуг(Источник, Отказ, РежимЗаписи, РежимПроведения) 
	
	ВедущийДокумент = _сф.ст_ПолучитьСвойство(Источник.ДополнительныеСвойства,"ВедущийДокумент");
	
	Если (ВедущийДокумент = Неопределено) Тогда
		
		// пробуем найти
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		               |	CW_РасходыПоГрузоперевозке.Ссылка КАК Ссылка
		               |ИЗ
		               |	Документ.CW_РасходыПоГрузоперевозке КАК CW_РасходыПоГрузоперевозке
		               |ГДЕ
		               |	CW_РасходыПоГрузоперевозке.ВедомыйДокумент = &ВедомыйДокумент";
		Запрос.УстановитьПараметр("ВедомыйДокумент", Источник.Ссылка);
		
		РезультатЗапроса = Запрос.Выполнить();
		Выборка = РезультатЗапроса.Выбрать();
		Если Выборка.Следующий() Тогда
			ВедущийДокумент = Выборка.Ссылка;
			_сф.ст_УстановитьСвойство(Источник.ДополнительныеСвойства,"ВедущийДокумент",ВедущийДокумент);
		КонецЕсли; 
		
	КонецЕсли;
	
	Если (ВедущийДокумент <> Неопределено) Тогда
		
		Если ТипЗнч(ВедущийДокумент) = Тип("ДокументСсылка.CW_РасходыПоГрузоперевозке") Тогда
			
			Если (ВедущийДокумент.РучнаяКорректировка) Тогда
				Возврат;
			КонецЕсли;
			
			CW_БухгалтерияЭкспедитораСервер.УстановитьОбщиеПараметрыПроведенияДокументов();
			
			Если (РежимЗаписи = РежимЗаписиДокумента.Проведение) Тогда
				
				// переопределяем способо зачета авансов
				// в отличие от доходов - не выделяем зачёт по собственным
				// переносим как есть
				Если (ВедущийДокумент.СпособЗачетаАвансов <> Перечисления.СпособыЗачетаАвансов.НеЗачитывать) Тогда
					
					Источник.ЗачетАвансов.Очистить();
					
					// если независимое проведение ведомого, то требуется перезаполнить таблицу зачета ведущего (!!!)
					ЗависимоеПроведение = _сф.ст_ПолучитьСвойство(Источник.ДополнительныеСвойства,"ЗависимоеПроведение");
					Если (ЗависимоеПроведение = Неопределено) Тогда
						НезависимоеПроведение = Истина;
					Иначе
						НезависимоеПроведение = (НЕ ЗависимоеПроведение);
					КонецЕсли; 
					
					ТребуетсяПерезаполнение = Ложь;
					
					Если (НезависимоеПроведение) Тогда
						
						// если автоматически, то формируем новую ТЗ зачета и запсиываем в ведущий документ
						Если (ВедущийДокумент.СпособЗачетаАвансов = Перечисления.СпособыЗачетаАвансов.Автоматически) Тогда
							
							ВедущийОбъект = ВедущийДокумент.ПолучитьОбъект();
							ВедущийОбъект.СформироватьОбщиеПараметры();
							ТребуетсяПерезаполнение = ВедущийОбъект.ДополнительныеСвойства.УП.ОЗ или ВедущийОбъект.ДополнительныеСвойства.УП.РаздельныйУчетОперативнойИБухгалтерскойЗадолженности;
							Если (ТребуетсяПерезаполнение) Тогда
								ДатаПодбораАвансов = Новый Граница(Источник.МоментВремени(),ВидГраницы.Исключая);
								ВедущийОбъект.ЗаполнитьТаблицуАвансов(ДатаПодбораАвансов);
								ВедущийОбъект.ОбменДанными.Загрузка = Истина;
								CW_Документы.ПеренестиПризнакВосстановленияПоследовательности(Источник,ВедущийОбъект);
								ВедущийОбъект.Записать(РежимЗаписиДокумента.Запись);	
							КонецЕсли; 
						КонецЕсли; // автоматический зачет авансов
					КонецЕсли; // независимое проведение 
					
					Если (ТребуетсяПерезаполнение ИЛИ ВедущийДокумент.СпособЗачетаАвансов = Перечисления.СпособыЗачетаАвансов.ПоДокументу) Тогда
						
						ТЗавансов = ВедущийДокумент.ЗачетАвансов.Выгрузить();
						Если (ТЗавансов.Количество()=0) Тогда
							Источник.СпособЗачетаАвансов = Перечисления.СпособыЗачетаАвансов.НеЗачитывать;
						Иначе
							Источник.СпособЗачетаАвансов = Перечисления.СпособыЗачетаАвансов.ПоДокументу;
							ТЗавансов.Свернуть("ДокументАванса","СуммаЗачета");
							Для каждого Стр Из ТЗавансов Цикл
								Нстр = Источник.ЗачетАвансов.Добавить();
								Нстр.ДокументАванса = Стр.ДокументАванса;
								Нстр.СуммаЗачета = Стр.СуммаЗачета;
							КонецЦикла;
						КонецЕсли; 
						
					Иначе
						ТЗавансов = ВедущийДокумент.ЗачетАвансов.Выгрузить();
						Если (ТЗавансов.Количество() = 0) Тогда
							Источник.СпособЗачетаАвансов = Перечисления.СпособыЗачетаАвансов.НеЗачитывать;
						Иначе
							Источник.СпособЗачетаАвансов = Перечисления.СпособыЗачетаАвансов.ПоДокументу;
							ТЗавансов.Свернуть("ДокументАванса","СуммаЗачета");
							Для каждого Стр Из ТЗавансов Цикл
								Нстр = Источник.ЗачетАвансов.Добавить();
								Нстр.ДокументАванса = Стр.ДокументАванса;
								Нстр.СуммаЗачета = Стр.СуммаЗачета;
							КонецЦикла;
						КонецЕсли; 
					КонецЕсли; 
				КонецЕсли; // требуется зачет аванса 
			КонецЕсли; // режим записи "Проведение" 
		КонецЕсли; // если ведущий документ = "CW_РасходыПоГрузоперевозке"
	КонецЕсли; // ведущий документ выбран 
	
КонецПроцедуры

Процедура КонтрольВедомыхКорректировкаПоступления(Источник, Отказ, РежимЗаписи, РежимПроведения) 
	
	ВедущийДокумент = _сф.ст_ПолучитьСвойство(Источник.ДополнительныеСвойства,"ВедущийДокумент");
	
	Если ВедущийДокумент = Неопределено Тогда
		
		// пробуем найти
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		               |	CW_РасходыПоГрузоперевозке.Ссылка КАК Ссылка
		               |ИЗ
		               |	Документ.CW_РасходыПоГрузоперевозке КАК CW_РасходыПоГрузоперевозке
		               |ГДЕ
		               |	CW_РасходыПоГрузоперевозке.ВедомыйДокументКорректировки = &ВедомыйДокумент"; 
		
		Запрос.УстановитьПараметр("ВедомыйДокумент", Источник.Ссылка);

		РезультатЗапроса = Запрос.Выполнить();
		Выборка = РезультатЗапроса.Выбрать();
		Если Выборка.Следующий() Тогда
			
			ВедущийДокумент = Выборка.Ссылка;
			_сф.ст_УстановитьСвойство(Источник.ДополнительныеСвойства,"ВедущийДокумент",ВедущийДокумент);
			
		КонецЕсли; 
		
	КонецЕсли;
	
КонецПроцедуры

Процедура КонтрольВедомыхРеализацияТоваровУслуг(Источник, Отказ, РежимЗаписи, РежимПроведения)

	ВедущийДокумент = _сф.ст_ПолучитьСвойство(Источник.ДополнительныеСвойства,"ВедущийДокумент");
	
	Если ВедущийДокумент = Неопределено Тогда
		
		// пробуем получить
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		               |	CW_ДоходыПоГрузоперевозке.Ссылка КАК Ссылка
		               |ИЗ
		               |	Документ.CW_ДоходыПоГрузоперевозке КАК CW_ДоходыПоГрузоперевозке
		               |ГДЕ
		               |	CW_ДоходыПоГрузоперевозке.ВедомыйДокумент = &ВедомыйДокумент";
		
		Запрос.УстановитьПараметр("ВедомыйДокумент", Источник.Ссылка); 
		
		РезультатЗапроса = Запрос.Выполнить();
		
		Если РезультатЗапроса.Пустой() Тогда
			
			Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
			               |	CW_ЗакрытиеГрузоперевозки.Ссылка КАК Ссылка
			               |ИЗ
			               |	Документ.CW_ЗакрытиеГрузоперевозки КАК CW_ЗакрытиеГрузоперевозки
			               |ГДЕ
			               |	CW_ЗакрытиеГрузоперевозки.ВедомыйДокумент = &ВедомыйДокумент";
			
			РезультатЗапроса = Запрос.Выполнить();
			
		КонецЕсли;
		
		Выборка = РезультатЗапроса.Выбрать();
		
		Если Выборка.Следующий() Тогда
			ВедущийДокумент = Выборка.Ссылка;
			_сф.ст_УстановитьСвойство(Источник.ДополнительныеСвойства,"ВедущийДокумент",ВедущийДокумент);
		КонецЕсли; // выборка
		
	КонецЕсли; 
	
	Если (ВедущийДокумент <> Неопределено) Тогда
		
		Если ТипЗнч(ВедущийДокумент) = Тип("ДокументСсылка.CW_ДоходыПоГрузоперевозке") Тогда
			
			Если (ВедущийДокумент.РучнаяКорректировка) Тогда
				Возврат;
			КонецЕсли;   
			
			CW_БухгалтерияЭкспедитораСервер.УстановитьОбщиеПараметрыПроведенияДокументов();
			
			Если РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
				
				ВРУ = CW_Настройки.ВалютаРегламентированногоУчета();
				
				// перезаполняем ТЧ зачета аванса по собственным
				Если ВедущийДокумент.СпособЗачетаАвансов <> Перечисления.СпособыЗачетаАвансов.НеЗачитывать Тогда
					
					Источник.ЗачетАвансов.Очистить();
					
					// отбираем только строки по счету авансов по собственным...
					
					// определяем счет расчетов
					Счета = CW_Конфигурация.ПланСчетов();
					Если (ВедущийДокумент.Валюта = ВРУ) Тогда
						СчетАвансовПоСобственным = Счета.РасчетыПоАвансамПолученным;   
						СчетРасчетовПоСобственным = Счета.РасчетыСПокупателями;  
						СчетРасчетовПоВозмещаемым = CW_Настройки.ПараметрУчетнойПолитики(ВедущийДокумент.Дата,ВедущийДокумент.Организация,"СчетРасчетов_Клиенты_Рубли");
					Иначе  
						
						Контракт = ?(ЗначениеЗаполнено(ВедущийДокумент.ПриложениеКДоговору),ВедущийДокумент.ПриложениеКДоговору,ВедущийДокумент.Договор);
						
						Если НЕ Контракт.ВзаиморасчетыВУЕ Тогда
							СчетАвансовПоСобственным = Счета.РасчетыПоАвансамПолученнымВал;
							СчетРасчетовПоСобственным = Счета.РасчетыСПокупателямиВал;  
							СчетРасчетовПоВозмещаемым = CW_Настройки.ПараметрУчетнойПолитики(ВедущийДокумент.Дата,ВедущийДокумент.Организация,"СчетРасчетов_Клиенты_Валюта");
						Иначе
							СчетАвансовПоСобственным = Счета.РасчетыПоАвансамПолученнымУЕ;
							СчетРасчетовПоСобственным = Счета.РасчетыСПокупателямиУЕ;  
							СчетРасчетовПоВозмещаемым = CW_Настройки.ПараметрУчетнойПолитики(ВедущийДокумент.Дата,ВедущийДокумент.Организация,"СчетРасчетов_Клиенты_УЕ");
						КонецЕсли; 
					КонецЕсли;    
					
					Отбор = _сф.ст_Отбор("СчетАванса",СчетАвансовПоСобственным);
					
					// если независимое проведение ведомого, то требуется перезаполнить таблицу зачета ведущего (!!!)
					ЗависимоеПроведение = _сф.ст_ПолучитьСвойство(Источник.ДополнительныеСвойства,"ЗависимоеПроведение");
					Если ЗависимоеПроведение = Неопределено Тогда
						НезависимоеПроведение = Истина;
					Иначе
						НезависимоеПроведение = (НЕ ЗависимоеПроведение);
					КонецЕсли; 
					
					// самостоятельно проведение документа 
					Если НезависимоеПроведение Тогда
						
						// если автоматически, то формируем новую ТЗ зачета и запсиываем в ведущий документ
						Если ВедущийДокумент.СпособЗачетаАвансов = Перечисления.СпособыЗачетаАвансов.Автоматически Тогда
							
							ВедущийОбъект = ВедущийДокумент.ПолучитьОбъект();
							ВедущийОбъект.СформироватьОбщиеПараметры();
							ДатаПодбораАвансов = Новый Граница(Источник.МоментВремени(),ВидГраницы.Исключая);
							ВедущийОбъект.ЗаполнитьТаблицуАвансов(ДатаПодбораАвансов);
							ВедущийОбъект.ОбменДанными.Загрузка = Истина;
							// --- 
							CW_Документы.ПеренестиПризнакВосстановленияПоследовательности(Источник,ВедущийОбъект);
							// --- 
							ВедущийОбъект.Записать(РежимЗаписиДокумента.Запись);
							// --- 
							ТЗавансов = ВедущийДокумент.ЗачетАвансов.Выгрузить(Отбор);
							
							// если по документу, то берем ТЧ ведущего
						ИначеЕсли ВедущийДокумент.СпособЗачетаАвансов = Перечисления.СпособыЗачетаАвансов.ПоДокументу Тогда
							ТЗавансов = ВедущийДокумент.ЗачетАвансов.Выгрузить(Отбор);	
							
							// если зачет аванса не производится			
						Иначе
							ТЗавансов = ВедущийДокумент.ЗачетАвансов.Выгрузить(Отбор);	
							ТЗавансов.Очистить();
						КонецЕсли; 
						
						// проведение документа в составе пакета
					Иначе
						Если ВедущийДокумент.СпособЗачетаАвансов <> Перечисления.СпособыЗачетаАвансов.НеЗачитывать Тогда
							ТЗавансов = ВедущийДокумент.ЗачетАвансов.Выгрузить(Отбор);
						Иначе
							ТЗавансов = ВедущийДокумент.ЗачетАвансов.Выгрузить(Отбор);	
							ТЗавансов.Очистить();
						КонецЕсли; 
					КонецЕсли; 
					
					// получаем сумму по собственным
					Если СчетРасчетовПоСобственным <> СчетРасчетовПоВозмещаемым Тогда
						
						Отбор = _сф.ст_Отбор("ПорядокОтражения",Перечисления.CW_ПорядокОтраженияДоходов.СобственнаяУслуга);
						ВремСобственных = ВедущийДокумент.Услуги.Выгрузить(Отбор);
						
						Отбор = _сф.ст_Отбор("ПорядокОтражения",Перечисления.CW_ПорядокОтраженияДоходов.ПрочиеДоходы);
						ВремПрочиеДоходы = ВедущийДокумент.Услуги.Выгрузить(Отбор);
						
						Для Каждого Стр из ВремПрочиеДоходы Цикл
							Нстр = ВремСобственных.Добавить();
							ЗаполнитьЗначенияСвойств(Нстр,Стр);
						КонецЦикла;   
					Иначе
						ВремСобственных = ВедущийДокумент.Услуги.Выгрузить();	
					КонецЕсли;
					
					СуммаСобственных = ВремСобственных.Итог("Всего");
					
					Если ТЗавансов.Количество() = 0  Тогда
						Источник.СпособЗачетаАвансов = Перечисления.СпособыЗачетаАвансов.НеЗачитывать;
					Иначе
						Если СуммаСобственных <> 0 Тогда
							
							Источник.СпособЗачетаАвансов = Перечисления.СпособыЗачетаАвансов.ПоДокументу;
							
							// заполняем и контроллируем, чтобы сумма зачета не превысила сумму по собственным
							ОстатокРаспределения = СуммаСобственных;
							Для каждого Стр Из ТЗавансов Цикл
								Если ОстатокРаспределения > 0 Тогда
									Нстр = Источник.ЗачетАвансов.Добавить();
									Нстр.ДокументАванса = Стр.ДокументАванса;
									Если Стр.СуммаЗачета <= ОстатокРаспределения Тогда
										Нстр.СуммаЗачета = Стр.СуммаЗачета;
									Иначе
										Нстр.СуммаЗачета = ОстатокРаспределения;
									КонецЕсли; 
									_сф.Декремент(ОстатокРаспределения,Нстр.СуммаЗачета);
								Иначе
									Прервать;
								КонецЕсли;
							КонецЦикла;
						Иначе
							Источник.СпособЗачетаАвансов = Перечисления.СпособыЗачетаАвансов.НеЗачитывать;
						КонецЕсли; // СуммаСобственных <> 0
					КонецЕсли; 
					
				КонецЕсли; 
				
			КонецЕсли; 
			
		КонецЕсли; // если тип доходов
		
	КонецЕсли; 
	
КонецПроцедуры

Процедура КонтрольВедомыхКорректировкаРеализации(Источник, Отказ, РежимЗаписи, РежимПроведения)
	
	ВедущийДокумент = _сф.ст_ПолучитьСвойство(Источник.ДополнительныеСвойства,"ВедущийДокумент");
	
	Если ВедущийДокумент = Неопределено Тогда
		
		// пробуем найти
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		               |	CW_ДоходыПоГрузоперевозке.Ссылка КАК Ссылка
		               |ИЗ
		               |	Документ.CW_ДоходыПоГрузоперевозке КАК CW_ДоходыПоГрузоперевозке
		               |ГДЕ
		               |	CW_ДоходыПоГрузоперевозке.ВедомыйДокументКорректировки = &ВедомыйДокумент";
		
		Запрос.УстановитьПараметр("ВедомыйДокумент", Источник.Ссылка); 
		
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			ВедущийДокумент = Выборка.Ссылка;
			_сф.ст_УстановитьСвойство(Источник.ДополнительныеСвойства,"ВедущийДокумент",ВедущийДокумент);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура КонтрольВедомыхВыписка(Источник, Отказ, РежимЗаписи, РежимПроведения)
	
	// определяем режим записи и признак того, что это наш документ
	ВедомыйДокумент = _сф.ст_ПолучитьСвойство(Источник.ДополнительныеСвойства,"ВедомыйДокумент");
	
	// проверяем вид операции
	// сначала проверяем, что вид операции "оплата поставщику" или "оплата покупателю"
	НекорректныйВидОперации = Ложь;
	ЭтоСписание = Ложь;
	ЭтоПоступление = Ложь;
	
	Если ТипЗнч(Источник)=Тип("ДокументОбъект.СписаниеСРасчетногоСчета") Тогда
		
		ЭтоСписание = Истина;
		ВидОперативнойЗадолженности = Перечисления.CW_ВидыОперативнойЗадолженности.Кредиторская;
		
		Если Источник.ВидОперации <> Перечисления.ВидыОперацийСписаниеДенежныхСредств.ОплатаПоставщику Тогда
			НекорректныйВидОперации = Истина;
		КонецЕсли;  
	КонецЕсли; 
	
	Если ТипЗнч(Источник)=Тип("ДокументОбъект.ПоступлениеНаРасчетныйСчет") Тогда
		
		ЭтоПоступление = Истина;
		ВидОперативнойЗадолженности = Перечисления.CW_ВидыОперативнойЗадолженности.Дебиторская;
		
		Если Источник.ВидОперации <> Перечисления.ВидыОперацийПоступлениеДенежныхСредств.ОплатаПокупателя Тогда
			НекорректныйВидОперации = Истина;
		КонецЕсли; 
	КонецЕсли; 
	
	СтруктураНастроек = CW_Настройки.ПолучитьНастройкиОперативногоУчета(Источник.Организация, 
		Перечисления.CW_ВидыОперативнойЗадолженности.Дебиторская, 
		Источник.Дата); 
	
	Если Не СтруктураНастроек["ВедетсяОперативныйУчет"] 
		ИЛИ СтруктураНастроек["НастройкиОперативногоУчета"]["РаздельныйУчет"] Тогда
		//Оперативная задолженность не ведется
		Возврат;
	КонецЕсли; 
	
	Если (ВедомыйДокумент = Неопределено) Тогда
		
		Если (НекорректныйВидОперации) Тогда 
			Возврат; 
		КонецЕсли; 
		
		// ищем ведомый
		Если (НЕ Источник.Ссылка.Пустая()) Тогда
			
			ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	CW_Оплата.Ссылка
			|ИЗ
			|	Документ.CW_Оплата КАК CW_Оплата
			|ГДЕ
			|	CW_Оплата.Основание = &Основание";
			ПараметрыЗапроса = Новый Структура("Основание", Источник.Ссылка);
			ВедомыйДокумент = _сф.ВыполнитьЗапрос(ТекстЗапроса, ПараметрыЗапроса, Истина, "Ссылка", Неопределено);
			Если (ВедомыйДокумент = Неопределено) Тогда
				Возврат;
			КонецЕсли; 
			
		КонецЕсли; 
		
	Иначе
		
		Если (НекорректныйВидОперации) Тогда
			
			Попытка
				
				ВО = ВедомыйДокумент.ПолучитьОбъект();
				ВО.УстановитьПометкуУдаления(Истина);
				Возврат;
				
			Исключение
				//ОписаниеОшибки()
			КонецПопытки; 
			
		КонецЕсли; 
		
	КонецЕсли; 
	
	CW_БухгалтерияЭкспедитораСервер.УстановитьОбщиеПараметрыПроведенияДокументов();
	
	// теперь смотрим на режим записи:
	// не проведение и не нашли - возврат
	// не проведение и нашли - помечаем на удаление
	// проведение - если есть в допсвойствах таблица - создаём/переформировываем ведомый
	
	Если (РежимЗаписи <> РежимЗаписиДокумента.Проведение) Тогда
		
		Если (ВедомыйДокумент <> Неопределено) Тогда
			
			Если ((ВедомыйДокумент.ПометкаУдаления <> Источник.ПометкаУдаления)
				ИЛИ ВедомыйДокумент.Проведен) Тогда
				
				Ведомый = ВедомыйДокумент.ПолучитьОбъект();
				Ведомый.Дата = Источник.Дата;
				Ведомый.ПометкаУдаления = Источник.ПометкаУдаления;
				// --- 
				CW_Документы.ПеренестиПризнакВосстановленияПоследовательности(Источник,Ведомый);
				// --- 
				Ведомый.Записать(РежимЗаписи);
				
			КонецЕсли; 
			
		КонецЕсли; 
		
		// проведение документа
	Иначе
		
		Если (ВедомыйДокумент <> Неопределено) Тогда
			
			// проверяем, что учётный договор договора оплаты есть в ТЧ документа
			
			СтруктураПараметров = Новый Структура;
			СтруктураПараметров.Вставить("Договор", 			ВедомыйДокумент.Договор);
			СтруктураПараметров.Вставить("ПриложениеКДоговору",	ВедомыйДокумент.ПриложениеКДоговору);
			
			ПроверяемыйДоговор = CW_Финансы.ПолучитьУчетныйДоговор(СтруктураПараметров);
			
			Если (Источник.РасшифровкаПлатежа.Найти(ПроверяемыйДоговор,"ДоговорКонтрагента")=Неопределено) Тогда
				
				ОплатаОбъект = ВедомыйДокумент.ПолучитьОбъект();
				ОплатаОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения);

				ОплатаОбъект.Оплата.Очистить();
				ОплатаОбъект.АвтоматическийПодборСчетов=Ложь;
				ОплатаОбъект.АвтоматическийПодборАктов=Ложь;  
				
				// порядок отражения аванса для УСН получаем из учетной политики
				ПорядокОтраженияАванса = CW_Настройки.ПараметрУчетнойПолитики(Источник.Дата,Источник.Организация,"ПорядокОтраженияАванса");
				Если НЕ ЗначениеЗаполнено(ПорядокОтраженияАванса) Тогда
					ПорядокОтраженияАванса = Перечисления.ПорядокОтраженияАвансов.ДоходУСН;
				КонецЕсли; 
				ОплатаОбъект.ПорядокОтраженияАванса = ПорядокОтраженияАванса;  
				
				ОплатаОбъект.ПометкаУдаления=Истина;
				ОплатаОбъект.Записать(РежимЗаписиДокумента.Запись);
				
			КонецЕсли; 
			
		КонецЕсли; 	
		
		#Область АвтоматическийПодборСчетовАктов 
		
		// проверим, что ведется учет оперативной задолженности     
		
		СтруктураНастроек = CW_Настройки.ПолучитьНастройкиОперативногоУчета(Источник.Организация, ВидОперативнойЗадолженности, Источник.Дата); 	
		
		ИспользуетсяОперативнаяЗадолженность = СтруктураНастроек["ВедетсяОперативныйУчет"];
	
		// проверка условие на дополнительную обработку
		Если (ВедомыйДокумент <> Неопределено И ИспользуетсяОперативнаяЗадолженность) Тогда
			Если (ВедомыйДокумент.АвтоматическийПодборСчетов ИЛИ ВедомыйДокумент.АвтоматическийПодборАктов) Тогда
				
				Ведомый = ВедомыйДокумент.ПолучитьОбъект();
				Ведомый.Дата = Источник.Дата;
				Ведомый.Записать(РежимЗаписиДокумента.ОтменаПроведения);
				
				// перезаполняем ведомый и ведущий
				ТаблицаВедомого = Ведомый.Оплата.Выгрузить();
				Договор = Ведомый.Договор;
				
				//Подсистема.УчетПриложенийДоговоров
				ПриложениеКДоговору = Ведомый.ПриложениеКДоговору;
				//Подсистема.УчетПриложенийДоговоров
				
				Организация = Источник.Организация;
				Контрагент 	= Источник.Контрагент;
				Валюта 		= Источник.ВалютаДокумента;
				
				#Область СтатьяДДСПорядокАванса
				
				// определение статьи ДДС
				СтатьяДДС = Справочники.СтатьиДвиженияДенежныхСредств.ПустаяСсылка();
				Если (ЗначениеЗаполнено(ВедомыйДокумент.Основание)) Тогда
					ТаблицаСтатейДДС = ВедомыйДокумент.Основание.РасшифровкаПлатежа.Выгрузить(,"СтатьяДвиженияДенежныхСредств");
					ТаблицаСтатейДДС.Свернуть("СтатьяДвиженияДенежныхСредств");
					Если (ТаблицаСтатейДДС.Количество() <> 0) Тогда
						СтатьяДДС = _сф.к_ПервыйЭлемент(ТаблицаСтатейДДС).СтатьяДвиженияДенежныхСредств;	
					КонецЕсли; 
				КонецЕсли; 
				
				// определение порядка отражения аванса
				// для случая если полученная оплата превысит сумму 
				// оперативной задолженности (используется только для заполнения документа "ПоступлениеНаРасчетныйСчет")
				Если (Договор.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПокупателем И ЗначениеЗаполнено(ВедомыйДокумент.ПорядокОтраженияАванса)) Тогда
					
					//// нам нужно отобрать строки с отражением аванса по договору
					//// подготовим отбор для выборки нужной строки из табличной части
					//Отбор = Новый Структура("СчетНаОплату,"
					//"СпособПогашенияЗадолженности",
					//Документы.СчетНаОплатуПокупателю.ПустаяСсылка(),
					//Перечисления.СпособыПогашенияЗадолженности.НеПогашать);
					//
					//ТаблицаПОА = ВедомыйДокумент.Основание.РасшифровкаПлатежа.Выгрузить(Отбор,"ПорядокОтраженияАванса");
					//ТаблицаПОА.Свернуть("ПорядокОтраженияАванса");
					//
					//// получим порядок отражения из первой строки 
					//// (в принципе их не должно быть более одной)
					//Если (ТаблицаПОА.Количество() <> 0) Тогда
					//	ПорядокОтраженияАванса = _сф.к_ПервыйЭлемент(ТаблицаПОА).ПорядокОтраженияАванса;	
					//КонецЕсли; 
					//
					//// Если порядок отражения остался пустым, 
					//// значит пользователь его не указал в диалоге подбора счетов.
					//// Получим значения порядка отражения из настроек организации,
					//// а если он не задан, то принудительно установим значение "ДоходКомитента" 
					//Если ЗначениеЗаполнено(ПорядокОтраженияАванса) = Ложь Тогда
					//	
					//	ПорядокОтраженияАванса = CW_Настройки.ПараметрУчетнойПолитики(Источник.Дата,Источник.Организация,"ПорядокОтраженияАванса");
					//	Если ЗначениеЗаполнено(ПорядокОтраженияАванса) = Ложь Тогда
					//		ПорядокОтраженияАванса = Перечисления.ПорядокОтраженияАвансов.ДоходКомитента;
					//	КонецЕсли; 
					//КонецЕсли; // порядок отражения не удалось определить из табличной части документа   
					
					
					ПорядокОтраженияАванса = ВедомыйДокумент.ПорядокОтраженияАванса;	
				Иначе
					ПорядокОтраженияАванса = CW_Настройки.ПараметрУчетнойПолитики(Источник.Дата,Источник.Организация,"ПорядокОтраженияАванса");
					Если НЕ ЗначениеЗаполнено(ПорядокОтраженияАванса) Тогда
						ПорядокОтраженияАванса = Перечисления.ПорядокОтраженияАвансов.ДоходУСН;
					КонецЕсли; 
				КонецЕсли; // документ был заполнен через обработку "Подбор счетов на оплату" 
				
				#КонецОбласти 
				
				ВалютаОЗ = Валюта;
				Если Договор.ВзаиморасчетыВУЕ Тогда
					ВалютаОЗ = Договор.ВалютаДоговора;
				КонецЕсли;
				
				ПараметрыТОЗ = Новый Структура("Организация,Контрагент,Договор,ПриложениеКДоговору,Валюта",Организация,Контрагент,Договор,ПриложениеКДоговору,ВалютаОЗ);
				ПараметрыТОЗ.Вставить("Дата",Ведомый.МоментВремени());
				ТОЗ = CW_Финансы.ТаблицаОперативнойЗадолженностиПоСчетам(ПараметрыТОЗ);
				
				ПараметрыТОЗ.Вставить("ТОЗ",ТОЗ);
				ПараметрыТОЗ.Дата = Источник.МоментВремени();
				СтруктураБЗ = CW_Финансы.СтруктураБухгалтерскойЗадолженностиПоАктам(ПараметрыТОЗ);
				ТА = СтруктураБЗ.ТА;
				ТЗА = СтруктураБЗ.ТЗА;
				
				ДеревоОплат = Новый ДеревоЗначений;
				ДеревоОплат.Колонки.Добавить("Представление");
				ДеревоОплат.Колонки.Добавить("Документ");
				ДеревоОплат.Колонки.Добавить("СрокОплаты");
				ДеревоОплат.Колонки.Добавить("СчетЗадолженности");
				ДеревоОплат.Колонки.Добавить("ИндексКартинки");
				ДеревоОплат.Колонки.Добавить("Задолженность");
				ДеревоОплат.Колонки.Добавить("Оплата_Валюта");
				ДеревоОплат.Колонки.Добавить("Курс");
				ДеревоОплат.Колонки.Добавить("Оплата_БВ");
				ДеревоОплат.Колонки.Добавить("ЭтоСчет");
				ДеревоОплат.Колонки.Добавить("ДатаДокумента");
				ДеревоОплат.Колонки.Добавить("СуммаДокумента");
				ДеревоОплат.Колонки.Добавить("Задолженность_БВ");
				ДеревоОплат.Колонки.Добавить("Аванс");
				ДеревоОплат.Колонки.Добавить("СтавкаНДС");
				ДеревоОплат.Колонки.Добавить("СуммаНДС");   
				
				ДеревоОплат.Колонки.Добавить("СуммаНДСИсходная");   
				ДеревоОплат.Колонки.Добавить("СтавкаНДСИсходная");   
				
				СК = CW_Финансы.ПолучитьКурсВалюты(ВалютаОЗ,Источник.Дата);
				Курс = СК.Курс;
				
				ЭтоПоступление = Ложь;
				ЭтоСписание = Ложь;
				Если (ТипЗнч(Источник.Ссылка) = Тип("ДокументСсылка.ПоступлениеНаРасчетныйСчет")) Тогда
					ПустойАкт = Документы.CW_ДоходыПоГрузоперевозке.ПустаяСсылка();
					ЭтоПоступление=Истина;
				ИначеЕсли (ТипЗнч(Источник.Ссылка) = Тип("ДокументСсылка.СписаниеСРасчетногоСчета")) Тогда 
					ЭтоСписание=Истина;
					ПустойАкт = Документы.CW_РасходыПоГрузоперевозке.ПустаяСсылка();
				КонецЕсли; 
				УЕ = Договор.ВзаиморасчетыВУЕ;
				
				ПараметрыДО = Новый Структура;
				ПараметрыДО.Вставить("РежимДДС",Ложь);
				ПараметрыДО.Вставить("Курс",Курс);
				ПараметрыДО.Вставить("ЕстьВедомый",Истина);
				ПараметрыДО.Вставить("ТаблицаВедомого",ТаблицаВедомого);
				ПараметрыДО.Вставить("ПустойАкт",ПустойАкт);
				ПараметрыДО.Вставить("УЕ",УЕ);
				ПараметрыДО.Вставить("ТОЗ",ТОЗ);
				ПараметрыДО.Вставить("ТА",ТА);
				ПараметрыДО.Вставить("ТЗА",ТЗА);
				ПараметрыДО.Вставить("Организация",Организация);
				ПараметрыДО.Вставить("Договор",Договор);  
				
				//Подсистема.УчетПриложенийДоговоров
				ПараметрыДО.Вставить("ПриложениеКДоговору",ПриложениеКДоговору);  
				//Подсистема.УчетПриложенийДоговоров
				
				ПараметрыДО.Вставить("Кратность",СК.Кратность);
				
				ПараметрыДО.Вставить("Валюта", ВалютаОЗ);
				ПараметрыДО.Вставить("БазоваяВалюта",CW_Настройки.ВалютаРегламентированногоУчета());
				ПараметрыДО.Вставить("Дата",Источник.Дата);
				
				CW_Финансы.СформироватьДеревоОплат(ДеревоОплат,ПараметрыДО);
				
				// автозаполнение счетов
				Если (ВедомыйДокумент.АвтоматическийПодборСчетов) Тогда
					
					ОстатокРаспределения = Источник.СуммаДокумента;
					CW_Финансы.ВыполнитьАвтораспределениеОплатыПоСчетам(ДеревоОплат, ОстатокРаспределения, ПустойАкт, УЕ, СК);
					
				КонецЕсли; 
				
				// автозаполнение актов
				Если (ВедомыйДокумент.АвтоматическийПодборАктов) Тогда
					
					ЗадолженностьПоАктам = Новый Соответствие;
					
					// теперь бежим по дереву и для каждой строки с актами пробуем распределить сумму оплаты по счету на акты по фифо
					Для каждого СтрокаСчета Из ДеревоОплат.Строки Цикл
						
						Если (СтрокаСчета.ЭтоСчет И СтрокаСчета.Оплата_Валюта <> 0) Тогда
							
							СуммаРаспределения = СтрокаСчета.Оплата_Валюта;
							Для каждого СтрокаАкта Из СтрокаСчета.Строки Цикл
								
								// посчитаем задолженность с учетом предыдущих списаний
								
								// сумму акта берем 
								ОтборПоСчетуЗадолженности = Новый Структура("СчетЗадолженности",СтрокаАкта.СчетЗадолженности);
								СуммаАкта = СтрокаАкта.Документ.Услуги.Выгрузить(ОтборПоСчетуЗадолженности).Итог("Всего");
								
								СуммаАктаПоСчету = СтрокаАкта.СуммаДокумента;
								СальдоАкта = СтрокаАкта.Задолженность;
								
								Если (СальдоАкта <> СуммаАкта) Тогда
									
									// проверяем, что списания отражены по регистру оплат исходящих документов
									СуммаОплатПоБУ = СуммаАкта - СальдоАкта;
									
									Запрос = Новый Запрос;
									Если (ЭтоПоступление) Тогда
										Запрос.Текст = "ВЫБРАТЬ
										|	CW_ОплатаИсходящихДокументов.Документ КАК Счет,
										|	CW_ОплатаИсходящихДокументов.СчетЗадолженности,
										|	CW_ОплатаИсходящихДокументов.ДокументБУ КАК Акт,
										|	CW_ОплатаИсходящихДокументов.Всего
										|ИЗ
										|	РегистрСведений.CW_ОплатаИсходящихДокументов КАК CW_ОплатаИсходящихДокументов
										|ГДЕ
										|	CW_ОплатаИсходящихДокументов.ДокументБУ = &ДокументБУ
										|	И CW_ОплатаИсходящихДокументов.СчетЗадолженности = &СчетЗадолженности
										|	И CW_ОплатаИсходящихДокументов.Регистратор.МоментВремени <= &Период
										|	И CW_ОплатаИсходящихДокументов.Регистратор <> &Ссылка";
										
									ИначеЕсли (ЭтоСписание) Тогда 
										
										Запрос.Текст = "ВЫБРАТЬ
										|	CW_ОплатаВходящихДокументов.Документ КАК Счет,
										|	CW_ОплатаВходящихДокументов.СчетЗадолженности,
										|	CW_ОплатаВходящихДокументов.ДокументБУ КАК Акт,
										|	CW_ОплатаВходящихДокументов.Всего
										|ИЗ
										|	РегистрСведений.CW_ОплатаВходящихДокументов КАК CW_ОплатаВходящихДокументов
										|ГДЕ
										|	CW_ОплатаВходящихДокументов.ДокументБУ = &ДокументБУ
										|	И CW_ОплатаВходящихДокументов.СчетЗадолженности = &СчетЗадолженности
										|	И CW_ОплатаВходящихДокументов.Регистратор.МоментВремени <= &Период
										|	И CW_ОплатаВходящихДокументов.Регистратор <> &Ссылка";
									КонецЕсли; 
									
									Запрос.УстановитьПараметр("Период", ВедомыйДокумент.МоментВремени());
									Запрос.УстановитьПараметр("Ссылка", ВедомыйДокумент); 
									Запрос.УстановитьПараметр("ДокументБУ", СтрокаАкта.Документ);
									Запрос.УстановитьПараметр("СчетЗадолженности",СтрокаАкта.СчетЗадолженности);
									ТЗОплат = Запрос.Выполнить().Выгрузить();
									СуммаОплатПоРегиструОплат = ТЗОплат.Итог("Всего");
									
									Если (СуммаОплатПоБУ <> СуммаОплатПоРегиструОплат) Тогда
										Сообщить("Документ: "+Строка(Источник.Ссылка));
										Сообщить("Для пары """+Строка(СтрокаСчета.Представление)+" - "+Строка(СтрокаАкта.Представление)+""" сумма оплат по БУ не совпадает с суммой оплат по ОУ");
										Сообщить("Работа механизма автоматического распределения оплат по актам невозможна!");
										Отказ = Истина;
										Возврат;
									КонецЕсли; 
									
									// если оплаты совпадают, то находим сумму оплат по текущему счету и акту
									Отбор = Новый Структура("Счет",СтрокаСчета.Документ);
									ТЗОплатПоСчету = ТЗОплат.Скопировать(Отбор);
									СуммаОплатАктаПоСчету = ТЗОплатПоСчету.Итог("Всего");
									
									СтрокаАкта.СуммаДокумента = СуммаАктаПоСчету - СуммаОплатАктаПоСчету;
									
								КонецЕсли; 
								
								ОстатокЗадолженностиПоАкту = СтрокаАкта.СуммаДокумента;
								Если (ОстатокЗадолженностиПоАкту < 0) Тогда
									ОстатокЗадолженностиПоАкту = 0;
								КонецЕсли; 
								
								Если (ОстатокЗадолженностиПоАкту > СальдоАкта) Тогда
									Сообщить("Документ: "+Строка(Источник.Ссылка));
									Сообщить("Для пары """+Строка(СтрокаСчета.Представление)+" - "+Строка(СтрокаАкта.Представление)+""" сумма задолженности ПО ОУ превышает задолженность по БУ");
									Сообщить("Работа механизма автоматического распределения оплат по актам невозможна!");
									Отказ = Истина;
									Возврат;
								КонецЕсли; 
								
								СуммаЗачета = Мин(СуммаРаспределения,ОстатокЗадолженностиПоАкту);
								
								_сф.Декремент(СуммаРаспределения,СуммаЗачета);
								СтрокаАкта.Оплата_Валюта 	= СуммаЗачета;
								СтрокаАкта.Оплата_БВ 		= СуммаЗачета*СтрокаСчета.Курс / СК.Кратность ; 
								
								СтрокаАкта.СтавкаНДС 	= СтрокаАкта.СтавкаНДСИсходная;
								ЗначениеСтавки 			= CW_Финансы.ПолучитьСтавкуНДС(СтрокаАкта.СтавкаНДСИсходная) / 100; 
								
								Если УЕ  Тогда
									СтрокаАкта.СуммаНДС = СтрокаАкта.Оплата_БВ * ЗначениеСтавки / (1+ЗначениеСтавки);
								Иначе
									СтрокаАкта.СуммаНДС = СтрокаАкта.Оплата_Валюта * ЗначениеСтавки / (1+ЗначениеСтавки);
								КонецЕсли;
								
								СтрокаАкта.Курс = СтрокаСчета.Курс;
								ЗадолженностьПоАктам.Вставить(СтрокаАкта.Документ,ОстатокЗадолженностиПоАкту - СтрокаАкта.Оплата_Валюта);
								
							КонецЦикла; 
							
						КонецЕсли; 
						
					КонецЦикла; 
					
				КонецЕсли; 
				
				// переносим дерево оплат в таблицы платежки и документа оплаты
				#Область ФормированиеТабличныхЧастей
				
				СК = CW_Финансы.ПолучитьКурсВалюты(ВалютаОЗ,Источник.Дата);
				Курс = СК.Курс;
				
				// формируем таблицу оплат по оперативной задолженности
				ТаблицаОЗ = Документы.CW_Оплата.ПустаяСсылка().Оплата.Выгрузить();
				
				Если (ТипЗнч(Источник.Ссылка) = Тип("ДокументСсылка.ПоступлениеНаРасчетныйСчет")) Тогда
					ТабличнаяЧасть = Документы.ПоступлениеНаРасчетныйСчет.ПустаяСсылка().РасшифровкаПлатежа.Выгрузить();
				Иначе 
					ТабличнаяЧасть = Документы.СписаниеСРасчетногоСчета.ПустаяСсылка().РасшифровкаПлатежа.Выгрузить();
				КонецЕсли; 
				
				ПараметрыЗаполнения = Новый Структура;
				ПараметрыЗаполнения.Вставить("Договор",Договор);
				
				//Подсистема.УчетПриложенийДоговоров
				ПараметрыЗаполнения.Вставить("ПриложениеКДоговору",ПриложениеКДоговору);  
				//Подсистема.УчетПриложенийДоговоров
				
				ПараметрыЗаполнения.Вставить("СтатьяДДС",СтатьяДДС);
				ПараметрыЗаполнения.Вставить("ПорядокОтраженияАванса",ПорядокОтраженияАванса);
				ПараметрыЗаполнения.Вставить("УЕ",УЕ);
				ПараметрыЗаполнения.Вставить("ПустойАкт",ПустойАкт);
				ПараметрыЗаполнения.Вставить("Курс",Курс);
				ПараметрыЗаполнения.Вставить("Кратность",СК.Кратность);
				ПараметрыЗаполнения.Вставить("ТипДокумента",ТипЗнч(Источник.Ссылка));
				
				CW_Финансы.ЗаполнитьТаблицыПлатежныхДокументов(ДеревоОплат,ТаблицаОЗ,ТабличнаяЧасть, ПараметрыЗаполнения); 
				
				СтруктураПараметров = Новый Структура("ВедомыйДокумент,Реквизиты,ТаблицаДокумента,ТаблицаПоОперативнойЗадолженности");
				
				//АвтоматическийПодборАктов = ВедомыйДокумент.АвтоматическийПодборАктов;
				Реквизиты = _сф.ст_Создать("Организация,Контрагент,Договор,Валюта,АвтоматическийПодборАктов",Ведомый);
				СтруктураПараметров.ВедомыйДокумент = ВедомыйДокумент;
				СтруктураПараметров.Реквизиты = Реквизиты;
				СтруктураПараметров.ТаблицаПоОперативнойЗадолженности = ТаблицаОЗ;
				СтруктураПараметров.ТаблицаДокумента = ТабличнаяЧасть;
				
				Если (СтруктураПараметров.ТаблицаДокумента.Количество() = 0) Тогда
					
					Отказ = Истина;
					Сообщить(Строка(Источник));
					Сообщить("При автоматическом заполнении документа не обнаружено данных для заполнения!");
					Возврат;
					
				КонецЕсли; 
				
				ИмяТабличнойЧасти = "РасшифровкаПлатежа";
				ТЧ = Источник[ИмяТабличнойЧасти];
				ТЧ.Очистить();
				Для каждого Стр Из СтруктураПараметров.ТаблицаДокумента Цикл
					
					Нстр = ТЧ.Добавить();
					ЗаполнитьЗначенияСвойств(Нстр,Стр);	
					
				КонецЦикла; 
				
				Источник.СуммаДокумента = _сф.Итог(Источник[ИмяТабличнойЧасти],"СуммаПлатежа");
				
				СтруктураПараметровДоговора = Новый Структура;
				СтруктураПараметровДоговора.Вставить("Договор", 			Ведомый.Договор);
				СтруктураПараметровДоговора.Вставить("ПриложениеКДоговору",	Ведомый.ПриложениеКДоговору);
				
				Источник.ДоговорКонтрагента = CW_Финансы.ПолучитьУчетныйДоговор(СтруктураПараметровДоговора);	
				
				ЗаполнитьЗначенияСвойств(Ведомый,СтруктураПараметров.Реквизиты);
				Ведомый.Оплата.Загрузить(СтруктураПараметров.ТаблицаПоОперативнойЗадолженности);
				
				//Ведомый.ОбменДанными.Загрузка = Истина;
				Ведомый.ДополнительныеСвойства.Вставить("ЗависимоеПроведение", Истина);
				Ведомый.Записать(РежимЗаписиДокумента.Проведение);
				
				#КонецОбласти 
				
			КонецЕсли; // автоматический подбор счетов или актов
		КонецЕсли; // обработка при наличии ведомого документа и ведения учета оперативной задолженности 			
		#КонецОбласти 
		
		_сф.ст_УстановитьСвойство(_сф.ДС(Источник),"ВедомыйДокумент",ВедомыйДокумент);
	КонецЕсли; // проведение документа 
	
КонецПроцедуры

Процедура КонтрольВедомыхВыпискаВозвратПокупателю(Источник, Отказ, РежимЗаписи, РежимПроведения)

	ВидОперативнойЗадолженности = ПредопределенноеЗначение("Перечисление.CW_ВидыОперативнойЗадолженности.Дебиторская");	

	СтруктураНастроек 	= CW_Настройки.ПолучитьНастройкиОперативногоУчета(Источник.Организация, ВидОперативнойЗадолженности, Источник.Дата);
	Если Не СтруктураНастроек["ВедетсяОперативныйУчет"] 
		ИЛИ СтруктураНастроек["НастройкиОперативногоУчета"]["РаздельныйУчет"] Тогда
		//Оперативная задолженность не ведется
		Возврат;
	КонецЕсли; 
	
	// определяем режим записи и признак того, что это наш документ
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	CW_СвязанныеОплаты.Ссылка КАК Ссылка
	               |ИЗ
	               |	КритерийОтбора.CW_СвязанныеОплаты(&Источник) КАК CW_СвязанныеОплаты"; 
	
	Запрос.УстановитьПараметр("Источник", Источник.Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	Если Выборка.Следующий() Тогда 
		ВедомыйДокумент = Выборка.Ссылка;  
	КонецЕсли;  
	
	Если ВедомыйДокумент = Неопределено Тогда
		Возврат;
	КонецЕсли;  
	
	CW_БухгалтерияЭкспедитораСервер.УстановитьОбщиеПараметрыПроведенияДокументов();
	
	// теперь смотрим на режим записи:
	// не проведение и не нашли - возврат
	// не проведение и нашли - помечаем на удаление
	// проведение - если есть в допсвойствах таблица - создаём/переформировываем ведомый
	
	Если РежимЗаписи <> РежимЗаписиДокумента.Проведение Тогда
		
		Если (ВедомыйДокумент.ПометкаУдаления <> Источник.ПометкаУдаления)
			ИЛИ ВедомыйДокумент.Проведен Тогда
			
			ОплатаОбъект = ВедомыйДокумент.ПолучитьОбъект();
			ОплатаОбъект.Дата 			 = Источник.Дата;
			ОплатаОбъект.ПометкаУдаления = Источник.ПометкаУдаления;
			// --- 
			CW_Документы.ПеренестиПризнакВосстановленияПоследовательности(Источник, ОплатаОбъект);
			// ---     
			
			ОплатаОбъект.Записать(РежимЗаписи);
			
		КонецЕсли; 
		
		// проведение документа
	Иначе
		
		// проверяем, что учётный договор договора оплаты есть в ТЧ документа
		ОплатаОбъект = ВедомыйДокумент.ПолучитьОбъект();
		ОплатаОбъект.Дата	= Источник.Дата; 
		
		ОплатаОбъект.ДополнительныеСвойства.Вставить("ЗависимоеПроведение", Истина);
		ОплатаОбъект.Записать(РежимЗаписи);

	КонецЕсли; // проведение документа 
	
КонецПроцедуры

Процедура КонтрольВедомыхВыпискаВозвратОтПоставщика(Источник, Отказ, РежимЗаписи, РежимПроведения)
	
	ВидОперативнойЗадолженности = ПредопределенноеЗначение("Перечисление.CW_ВидыОперативнойЗадолженности.Кредиторская");	

	СтруктураНастроек = CW_Настройки.ПолучитьНастройкиОперативногоУчета(Источник.Организация, ВидОперативнойЗадолженности, Источник.Дата);
	Если Не СтруктураНастроек["ВедетсяОперативныйУчет"] 
		ИЛИ СтруктураНастроек["НастройкиОперативногоУчета"]["РаздельныйУчет"] Тогда
		//Оперативная задолженность не ведется
		Возврат;
	КонецЕсли; 

	// определяем режим записи и признак того, что это наш документ
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	CW_СвязанныеОплаты.Ссылка КАК Ссылка
	               |ИЗ
	               |	КритерийОтбора.CW_СвязанныеОплаты(&Источник) КАК CW_СвязанныеОплаты"; 
	
	Запрос.УстановитьПараметр("Источник", Источник.Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	Если Выборка.Следующий() Тогда 
		ВедомыйДокумент = Выборка.Ссылка;  
	КонецЕсли;  
	
	Если ВедомыйДокумент = Неопределено Тогда
		Возврат;
	КонецЕсли;  
	
	CW_БухгалтерияЭкспедитораСервер.УстановитьОбщиеПараметрыПроведенияДокументов();

	// теперь смотрим на режим записи:
	// не проведение и не нашли - возврат
	// не проведение и нашли - помечаем на удаление
	// проведение - если есть в допсвойствах таблица - создаём/переформировываем ведомый
	
	Если РежимЗаписи <> РежимЗаписиДокумента.Проведение Тогда
		
		Если (ВедомыйДокумент.ПометкаУдаления <> Источник.ПометкаУдаления)
			ИЛИ ВедомыйДокумент.Проведен Тогда
			
			ОплатаОбъект = ВедомыйДокумент.ПолучитьОбъект();
			ОплатаОбъект.Дата 			 = Источник.Дата;
			ОплатаОбъект.ПометкаУдаления = Источник.ПометкаУдаления;
			// --- 
			CW_Документы.ПеренестиПризнакВосстановленияПоследовательности(Источник, ОплатаОбъект);
			// ---     
			
			ОплатаОбъект.Записать(РежимЗаписи);
			
		КонецЕсли; 
		
		// проведение документа
	Иначе
		
		// проверяем, что учётный договор договора оплаты есть в ТЧ документа
		ОплатаОбъект = ВедомыйДокумент.ПолучитьОбъект();
		ОплатаОбъект.Дата	= Источник.Дата; 
		
		ОплатаОбъект.ДополнительныеСвойства.Вставить("ЗависимоеПроведение", Истина);
		ОплатаОбъект.Записать(РежимЗаписи);

	КонецЕсли; // проведение документа 
	
КонецПроцедуры
//Контроль ведомых


Процедура CW_ВедомыеОбработкаПроведенияОбработкаПроведения(Источник, Отказ, РежимПроведения) Экспорт
	
	Если (Источник.ОбменДанными.Загрузка) Тогда 
		Возврат; 
	КонецЕсли; 
	
	Если ТипЗнч(Источник)=Тип("ДокументОбъект.ПоступлениеТоваровУслуг") Тогда    
		ПроведениеПоступлениеТоваровУслуг(Источник, Отказ, РежимПроведения);
	КонецЕсли;
	
	Если ТипЗнч(Источник) = Тип("ДокументОбъект.КорректировкаПоступления") Тогда
		ПроведениеКорректировкаПоступления(Источник, Отказ, РежимПроведения);
	КонецЕсли;
	
	Если ТипЗнч(Источник)=Тип("ДокументОбъект.РеализацияТоваровУслуг") Тогда
		ПроведениеРеализацияТоваровУслуг(Источник, Отказ, РежимПроведения);
	КонецЕсли;  
	
	Если ТипЗнч(Источник) = Тип("ДокументОбъект.КорректировкаРеализации") Тогда
		ПроведениеКорректировкаРеализации(Источник, Отказ, РежимПроведения);
	КонецЕсли;
	
	Если ТипЗнч(Источник)=Тип("ДокументОбъект.СписаниеСРасчетногоСчета") Тогда
		ПроведениеСписаниеСРасчетногоСчета(Источник, Отказ, РежимПроведения);
	КонецЕсли; 
	
	Если ТипЗнч(Источник)=Тип("ДокументОбъект.ПоступлениеНаРасчетныйСчет") Тогда
		ПроведениеПоступлениеНаРасчетныйСчет(Источник, Отказ, РежимПроведения);
	КонецЕсли;

КонецПроцедуры 

//Проведение ведомых документов
Процедура ПроведениеПоступлениеТоваровУслуг(Источник, Отказ, РежимПроведения)
	
	//Для версии КОРП 
	ВестиУчетПоПодразделениям 	= ПолучитьФункциональнуюОпцию("ВестиУчетПоПодразделениям");
	//Для версии КОРП 
	
	ДатаНачалаВеденияУчета 			= CW_Настройки.ПолучитьДатуНачалаВеденияУчета(Источник.Организация);
	РежимВводНачальныхОстатков 		= ?(ДатаНачалаВеденияУчета = Неопределено, Ложь, (Источник.Дата < ДатаНачалаВеденияУчета));
	ВалютаРегламентированногоУчета 	= Константы.ВалютаРегламентированногоУчета.Получить();	
	
	// если не нашли ведущий документ, то выходим
	ВедущийДокумент = _сф.ст_ПолучитьСвойство(Источник.ДополнительныеСвойства,"ВедущийДокумент");
	Если (ВедущийДокумент = Неопределено) Тогда 
		Возврат; 
	КонецЕсли;
	Если (ВедущийДокумент.РучнаяКорректировка) Тогда
		Сообщить("Внимание! У ведущего документа "+Строка(ВедущийДокумент.Ссылка)+" установлен признак ручной корректировки движений!");
		Возврат;
	КонецЕсли;
	Если (Источник.РучнаяКорректировка) Тогда
		Сообщить("Внимание! У ведомого документа "+Строка(Источник.Ссылка)+" установлен признак ручной корректировки движений!");
		Возврат;
	КонецЕсли;
	
	// устанавливаем признак записи движений документа  
	Источник.Движения.Хозрасчетный.Записывать 					= Истина;
	Источник.Движения.НДСПредъявленный.Записывать 				= Истина;
	Источник.Движения.НДСПредъявленныйРеализация0.Записывать 	= Истина;
	
	// подготовим служебные переменные
	Счета = CW_Конфигурация.ПланСчетов();
	Субконто = CW_Конфигурация.ВидыСубконто();
	
	х20_01 	= Счета.ОсновноеПроизводство;
	
	// счета взаиморасчетов с поставщиками
	//х76_5 	= CW_Настройки.ПараметрУчетнойПолитики(Источник.Дата, Источник.Организация, "СчетРасчетов_Поставщики_Рубли");
	//х76_25 	= CW_Настройки.ПараметрУчетнойПолитики(Источник.Дата, Источник.Организация, "СчетРасчетов_Поставщики_Валюта");
	//х76_35 	= CW_Настройки.ПараметрУчетнойПолитики(Источник.Дата, Источник.Организация, "СчетРасчетов_Поставщики_УЕ");
	
	// предопределенные "транзитные счета" счета для
	х76_5 = Счета.РасчетыСПрочимиПоставщикамиИПодрядчиками;
	х76_6 = Счета.РасчетыСПрочимиПокупателямиИЗаказчиками;
	
	// стандрартные счета типовой конфигурации взаиморасчетов с принципалами 
	х76_25 = Счета.РасчетыСПрочимиПоставщикамиИПодрядчикамиВал;
	х76_35 = Счета.РасчетыСПрочимиПоставщикамиИПодрядчикамиУЕ;
	х76_26 = Счета.РасчетыСПрочимиПокупателямиИЗаказчикамиВал;
	х76_36 = Счета.РасчетыСПрочимиПокупателямиИЗаказчикамиУЕ;
	х76НА 	= Счета.РасчетыНДСНалоговогоАгента;
	х91_1 	= Счета.ПрочиеДоходы;
	х91_2 	= Счета.ПрочиеРасходы;
	
	ВРУ = CW_Настройки.ВалютаРегламентированногоУчета();
	
	// в зависимости от режима документа (ввод остатков или стандартный) 
	// убиваем либо все, либо часть движений
	Если (РежимВводначальныхОстатков) Тогда
		
		// очищаем все движения
		Для каждого Движение Из Источник.Движения Цикл
			Движение.Очистить();
		КонецЦикла;
		
		ДвиженияВедомого = Источник.Движения.Хозрасчетный;
		
		// формируем свои движения по вводу начальных остатков...
		Если (ВедущийДокумент.СальдоВзаиморасчетовБУ <> 0)  Тогда
			
			Если (Источник.ДоговорКонтрагента.ВалютаВзаиморасчетов <> ВРУ) Тогда
				
				СтруктураКурса = CW_Финансы.ПолучитьКурсВалюты(Источник.ДоговорКонтрагента.ВалютаВзаиморасчетов, НачалоДня(НачалоДня(ДатаНачалаВеденияУчета) - 1)); 
				КурсВводаОстатков = _СФ.БезопасноРазделить(СтруктураКурса.Курс, СтруктураКурса.Кратность);
				
				Если Источник.ДоговорКонтрагента.РасчетыВУсловныхЕдиницах Тогда
					
					СчетУчетаДляСальдо = CW_Настройки.ПараметрУчетнойПолитики(Источник.Дата, Источник.Организация, "СчетРасчетов_Поставщики_УЕ");
					Курс = ВедущийДокумент.КурсВзаиморасчетовБУ;
					// --- 
					СуммаДвиженияБУ = ВедущийДокумент.СальдоВзаиморасчетовБУ*КурсВводаОстатков;
					СуммаДвиженияНУ = ВедущийДокумент.СальдоВзаиморасчетовБУ*Курс;
					СуммаДвиженияПР = СуммаДвиженияБУ - СуммаДвиженияНУ;
					
				Иначе	
					
					СчетУчетаДляСальдо = CW_Настройки.ПараметрУчетнойПолитики(Источник.Дата, Источник.Организация, "СчетРасчетов_Поставщики_Валюта");	
					СуммаДвиженияБУ = ВедущийДокумент.СальдоВзаиморасчетовБУ*КурсВводаОстатков;
					СуммаДвиженияНУ = СуммаДвиженияБУ;
					СуммаДвиженияПР = 0;
					
				КонецЕсли; 
				
			Иначе
				
				СчетУчетаДляСальдо = CW_Настройки.ПараметрУчетнойПолитики(Источник.Дата, Источник.Организация, "СчетРасчетов_Поставщики_Рубли");
				СуммаДвиженияБУ = ВедущийДокумент.СальдоВзаиморасчетовБУ;
				СуммаДвиженияНУ = СуммаДвиженияБУ;
				СуммаДвиженияПР = 0;
				
			КонецЕсли;
			
			Движение = ДвиженияВедомого.Добавить();
			Движение.СчетКт = СчетУчетаДляСальдо;
			Движение.Период = НачалоДня(НачалоДня(ДатаНачалаВеденияУчета) - 1);
			Движение.Регистратор = Источник.Ссылка;
			Движение.Организация = Источник.Организация;
			
			//Для версии КОРП
			Если ВестиУчетПоПодразделениям Тогда
				Если Движение.СчетКт.УчетПоПодразделениям Тогда
					Движение.ПодразделениеКт = Источник.ПодразделениеОрганизации;
				КонецЕсли;
			КонецЕсли;
			//Для версии КОРП 
			
			Движение.СубконтоКт[Субконто.Контрагенты] = Источник.Контрагент;
			Движение.СубконтоКт[Субконто.Договоры] = Источник.ДоговорКонтрагента;
			Движение.СубконтоКт[Субконто.ДокументыРасчетовСКонтрагентами] = Источник.Ссылка;
			
			Движение.СчетДт = Счета.Вспомогательный;
			Движение.Содержание = "Ввод остатков";
			Движение.Сумма = СуммаДвиженияБУ;
			Движение.СуммаНУКт = СуммаДвиженияНУ;
			Если (СуммаДвиженияПР <> 0) Тогда
				Движение["СуммаПР"+?(СуммаДвиженияПР > 0,"Кт","Дт")] = СуммаДвиженияПР;	
			КонецЕсли; 
			
			Если (Источник.ДоговорКонтрагента.ВалютаВзаиморасчетов <> ВРУ) Тогда
				Движение.ВалютаКт = Источник.ДоговорКонтрагента.ВалютаВзаиморасчетов;
				Движение.ВалютнаяСуммаКт = ВедущийДокумент.СальдоВзаиморасчетовБУ;
			КонецЕсли; 
			
		КонецЕсли; // ввод сальдо по бухгалтерскому учету
		
		УслугиСвертка = ВедущийДокумент.Услуги.Выгрузить(_сф.ст_Отбор("ВводОстатков",Истина));
		УслугиСвертка.Свернуть("Покупатель, ДоговорПокупателя, ПорядокОтражения", "Всего");
		
		Для каждого Стр Из УслугиСвертка Цикл
			
			Если Стр.ПорядокОтражения <> Перечисления.CW_ПорядокОтраженияЗатрат.Затраты 
				И Стр.ПорядокОтражения <> Перечисления.CW_ПорядокОтраженияЗатрат.ПрочиеРасходы Тогда
				
				Если (Источник.ДоговорКонтрагента.ВалютаВзаиморасчетов <> ВРУ) Тогда
					
					Если Источник.ДоговорКонтрагента.РасчетыВУсловныхЕдиницах Тогда
						КурсВводаОстатков = ВедущийДокумент.КурсВзаиморасчетовБУ;
					Иначе
						СтруктураКурса = CW_Финансы.ПолучитьКурсВалюты(Источник.ДоговорКонтрагента.ВалютаВзаиморасчетов, Источник.Дата);
						КурсВводаОстатков = _СФ.БезопасноРазделить(СтруктураКурса.Курс, СтруктураКурса.Кратность); 
					КонецЕсли;	
					
				Иначе	
					
					КурсВводаОстатков = 1;
					
				КонецЕсли;	
				
				Движение = ДвиженияВедомого.Добавить();
				Если Стр.ПорядокОтражения = Перечисления.CW_ПорядокОтраженияЗатрат.Перевыставление Тогда
					Движение.СчетДт = Счета.РасчетыСПрочимиПоставщикамиИПодрядчиками;
				ИначеЕсли Стр.ПорядокОтражения = Перечисления.CW_ПорядокОтраженияЗатрат.ПеревыставлениеПоСтавкам Тогда 	
					Движение.СчетДт = Счета.РасчетыСПрочимиПокупателямиИЗаказчиками;
				КонецЕсли;
				
				Движение.Период = НачалоДня(НачалоДня(ДатаНачалаВеденияУчета) - 1);
				Движение.Регистратор = Источник.Ссылка;
				Движение.Организация = Источник.Организация;
				
				//Для версии КОРП
				Если ВестиУчетПоПодразделениям Тогда
					Если Движение.СчетДт.УчетПоПодразделениям Тогда
						Движение.ПодразделениеДт = Источник.ПодразделениеОрганизации;
					КонецЕсли;
				КонецЕсли;
				//Для версии КОРП
				
				Движение.СубконтоДт[Субконто.Контрагенты] = Стр.Покупатель;
				
				СтруктураПараметров = Новый Структура;
				СтруктураПараметров.Вставить("Договор",				Стр.ДоговорПокупателя);
				СтруктураПараметров.Вставить("ПриложениеКДоговору",	Стр.ПриложениеКДоговору);
				
				Движение.СубконтоДт[Субконто.Договоры] = CW_Финансы.ПолучитьУчетныйДоговор(СтруктураПараметров);
				
				Движение.СчетКт = Счета.Вспомогательный;
				Движение.Содержание = "Ввод остатков";
				Движение.Сумма = Стр.Всего*КурсВводаОстатков;
				
			КонецЕсли;
			
		КонецЦикла; 
		
		СформироватьДвиженияДляРасходов(ВедущийДокумент,Отказ);
		
	КонецЕсли; // режим ввода начальных остатков
	
	// проведение в стандартном режиме
	Если (НЕ РежимВводначальныхОстатков) Тогда
		
		// замена корреспондирующих счетов и договора для перевыставления (76.5 или 76.6)
		ДвиженияВедомого = Источник.Движения.Хозрасчетный;
		МассивУдаления = Новый Массив;
		Для каждого Движение Из Источник.Движения.Хозрасчетный Цикл
			
			Если (Движение.СчетДт = х76_25 ИЛИ Движение.СчетДт = х76_35) Тогда
				Движение.СчетДт = х76_5;
				Движение.ВалютаДт = Неопределено;
				Движение.ВалютнаяСуммаДт = 0;
			КонецЕсли; 
			
			Если (Движение.СчетДт = х76_26 ИЛИ Движение.СчетДт = х76_36) Тогда
				Движение.СчетДт = х76_6;
				Движение.ВалютаДт = Неопределено;
				Движение.ВалютнаяСуммаДт = 0;
			КонецЕсли;
			
			Если (Движение.СчетДт = х76_5 ИЛИ Движение.СчетДт = х76_6) Тогда 	 
				
				// меняем договор на учётный 
				ВедущийДоговор = CW_Финансы.ПолучитьВедущийДоговор(Движение.СубконтоДт[Субконто.Договоры]);
				Движение.СубконтоДт[Субконто.Договоры] = ВедущийДоговор.УчетныйДоговор;
				Движение.СубконтоДт[Субконто.ДокументыРасчетовСКонтрагентами] = Неопределено;
			КонецЕсли;
			
			// зачет аванса по служебному договору которых по логике быть не должно (сальдо по служебному договору быть не должно)
			Если (Движение.СчетДт = х76_5 и Движение.СчетКт = х76_5) ИЛИ (Движение.СчетДт = х76_6 и Движение.СчетКт = х76_6) Тогда 	 
				МассивУдаления.Добавить(Движение);
			КонецЕсли; 
			
			// удаляем проводки по переоценке валюты на транзитных счетах
			Если (Движение.СчетДт = х76_5 и Движение.СчетКт = х91_1) ИЛИ 
				 (Движение.СчетДт = х76_6 и Движение.СчетКт = х91_1) ИЛИ
 				 (Движение.СчетДт = х91_2 и Движение.СчетКт = х76_5) ИЛИ
 				 (Движение.СчетДт = х91_2 и Движение.СчетКт = х76_6) 				 
			Тогда 	 
				МассивУдаления.Добавить(Движение);
			КонецЕсли; 
			
		КонецЦикла;
		_сф.к_УдалитьЭлементыПоМассиву(ДвиженияВедомого,МассивУдаления);
		
		// очищаем НДС предъявленный для перевыставляемых услуг - неактуально для редакции 4
		ДвиженияВедомого = Источник.Движения.НДСПредъявленный;
		МассивУдаления = Новый Массив;
		Для каждого Движение Из ДвиженияВедомого Цикл
			Если Движение.СчетУчетаНДС = Счета.ПустаяСсылка() Тогда
				МассивУдаления.Добавить(Движение);
			КонецЕсли; 
		КонецЦикла;
		_сф.к_УдалитьЭлементыПоМассиву(ДвиженияВедомого,МассивУдаления);
		
		// доработка для Валюты и УЕ	
		РасчетыУЕ = Источник.ДоговорКонтрагента.РасчетыВУсловныхЕдиницах;
		РасчетыВалюта = (Источник.ДоговорКонтрагента.ВалютаВзаиморасчетов <> ВРУ) И (НЕ РасчетыУЕ);
		Если (РасчетыВалюта ИЛИ РасчетыУЕ) Тогда
			
			// заполнение рублевых эквивалентов в таблице Услуги для у.е...
