			ТаблицаОЗ.Свернуть("СчетЗадолженности","Всего,Всего_Рег");
			// --- 
			
			АналитикаКурсовыхРазниц = _сф.т_Создать("Аналитика,Счет,ВалютнаяСуммаЗачета,СуммаЗачета");
			КурсСчета = CW_Финансы.ПолучитьКурсВалюты(Документ.Валюта,Документ.КорректируемыйДокумент.ДатаСчета);
			
			АналитикаКорректировкиОперативнойЗадолженности = CW_Настройки.ПараметрУчетнойПолитики(Документ.Дата,Документ.Организация,"АналитикаКорректировкиОперативнойЗадолженности");
			
			Для каждого Стр Из ТаблицаОЗ Цикл
				
				Движение = НЗ_ОЗ.Добавить();
				// --- 
				Движение.ВидДвижения	= ВидДвиженияНакопления.Приход;
				Движение.ВидОперации	= ПредопределенноеЗначение("Перечисление.CW_ВидыДвиженийПоОперативнойЗадолженности.Начисление");
				// --- 
				Движение.Период 		= Документ.Дата;
				Движение.Организация 	= Документ.Организация;
				Движение.Контрагент 	= Документ.Контрагент;
				Движение.Договор 		= Документ.Договор;
				
				//Подсистема.УчетПриложенийДоговоров
				Движение.ПриложениеКДоговору = Документ.ПриложениеКДоговору;
				//Подсистема.УчетПриложенийДоговоров
				
				Движение.Валюта 		= Документ.Валюта;
				// --- 
				Если (АналитикаКорректировкиОперативнойЗадолженности = 0) Тогда
					Движение.Счет 			= ПолучитьКорректируемыйДокумент(Документ.КорректируемыйДокумент, Ложь);
				Иначе
					Движение.Счет 			= Документ;
				КонецЕсли; 
				// --- 
				Движение.СчетУчета 		= Стр.СчетЗадолженности;
				// --- 
				Движение.Всего_Валюта	= Стр.Всего;
				Движение.Всего	 		= Стр.Всего_Рег;
				//_сф.Инкремент(ИтогоПоНачислению_Валюта,Движение.Всего_Валюта);
				//_сф.Инкремент(ИтогоПоНачислению,Движение.Всего);
				// --- 
				
				
				// --- 
				
				//Нстр = АналитикаКурсовыхРазниц.Добавить();
				//Нстр.Аналитика = Документ.Ссылка;
				//Нстр.Счет = Стр.СчетЗадолженности;
				//Нстр.ВалютнаяСуммаЗачета = Движение.Всего_Валюта;
				//Нстр.СуммаЗачета = Движение.Всего;
				
			КонецЦикла; 
			
			
		КонецЕсли; 
		
		
	КонецЕсли; 
	
	#КонецОбласти
	
	#Область СоответсвиеСчетовАктов 
	
	Если (ЕстьАкт) Тогда
		
		КорректируемыйДокумент = ПолучитьКорректируемыйДокумент(Документ, Ложь);
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	CW_СоответствиеАктовИсходящимСчетам.Счет КАК Счет,
		               |	CW_СоответствиеАктовИсходящимСчетам.Акт КАК Акт,
		               |	CW_СоответствиеАктовИсходящимСчетам.Всего КАК Всего
		               |ИЗ
		               |	РегистрСведений.CW_СоответствиеАктовИсходящимСчетам КАК CW_СоответствиеАктовИсходящимСчетам
		               |ГДЕ
		               |	CW_СоответствиеАктовИсходящимСчетам.Регистратор = &Регистратор";
		Запрос.УстановитьПараметр("Регистратор",КорректируемыйДокумент);
		
		РезультатЗапрсоа = Запрос.Выполнить();
		
		Если Не РезультатЗапрсоа.Пустой() Тогда
			//Пишем в регистр только в случае если в нем сть записи по корректируемому документу
			
			ТаблицаДвижений = ТаблицаУслуг.Скопировать();
			Если (ЕстьСчет) Тогда
				_сф.т_ЗаполнитьЗначения(ТаблицаДвижений, "Счет", КорректируемыйДокумент);			
			Иначе
				Если (НЕ КорректируемыйДокумент.СписокСчетов) Тогда
					_сф.т_ЗаполнитьЗначения(ТаблицаДвижений, "Счет", КорректируемыйДокумент.Счет);
				КонецЕсли; 
			КонецЕсли; 
			
			СУ = Новый Массив;
			ЕстьНепривязанные = Ложь;
			Для каждого Стр Из ТаблицаДвижений Цикл
				Если (Стр.Счет.Пустая()) Тогда
					СУ.Добавить(Стр);
					ЕстьНепривязанные = Истина;
				КонецЕсли; 
			КонецЦикла; 
			_сф.к_УдалитьЭлементыПоМассиву(ТаблицаДвижений,СУ);
			
			// получаем настройку пользователя
			КонтрольПривязкиСчета = CW_Настройки.ПолучитьНастройкуПользователя(,"ПредупреждатьОПроведенииАктаБезПривязкиСчетаНаОплату");
			Если (ЕстьНепривязанные И КонтрольПривязкиСчета) Тогда
				Сообщить(Строка(Документ)+": "+"не привязаны счета на оплату!");
			КонецЕсли; 
			
			ТаблицаДвижений.Свернуть("Счет,СчетЗадолженности","Всего,НДС,Сумма");
			Для Каждого Стр из ТаблицаДвижений Цикл
				Запись = НЗ_СоответствиеАктов.Добавить();
				Запись.Счет 	= Стр.Счет;
				Запись.Акт 		= Документ;
				Запись.СчетУчетаЗадолженности = Стр.СчетЗадолженности;
				Запись.Всего 	= Стр.Всего;
				Запись.НДС 		= Стр.НДС;
				Запись.Сумма 	= Стр.Сумма;
			КонецЦикла; 
		КонецЕсли;	
	КонецЕсли;	
	
	#КонецОбласти 

	
	#Область ЗаписьДвижений
	
	НЗ_ОЗ.Записать(Истина);
	НЗ_КонтрольАктов.Записать(Истина);	
	НЗ_СоответствиеАктов.Записать(Истина);
	//НЗ_ОплатаДокументов.Записать(Истина);
	НЗ_Доходы.Записать(Истина);
	НЗ_Перевыставление.Записать(Истина);
	НЗ_ПеревыставлениеПоСтавкам.Записать(Истина);
	
	#КонецОбласти
	
	// --- 
КонецПроцедуры
  
Функция ОпределитьСоотношениеДляУСН(СтрокаОплаты,УслугиДокумента,ПоВалютнымСуммам=Ложь)
	
	СчетАванса = СтрокаОплаты.СчетАванса;
	УслугиПоСчетуАванса = УслугиДокумента.Скопировать(Новый Структура("СчетЗадолженности",СтрокаОплаты.СчетЗадолженности));

	Если (СтрокаОплаты.ВалютнаяСумма <> СтрокаОплаты.Сумма) Тогда
		ПоВалютнымСуммам = Истина;
	КонецЕсли; 

	Если (ПоВалютнымСуммам) Тогда
		Сумма = СтрокаОплаты.ВалютнаяСумма;
	Иначе	
		Сумма = СтрокаОплаты.Сумма;
	КонецЕсли; 

	СуммаДУ = 0;
	СуммаДК = 0;
	СуммаДЕ = 0; 
	СуммаНДС = 0;    
	
	Для каждого Стр Из УслугиПоСчетуАванса Цикл
		
		Если (Стр.ПорядокОтражения = Перечисления.CW_ПорядокОтраженияДоходов.СобственнаяУслуга) 
			ИЛИ (Стр.ПорядокОтражения = Перечисления.CW_ПорядокОтраженияДоходов.ПрочиеДоходы) Тогда
			
			// проверяем на ЕНВД 
			Если (Стр.СтатьяЗатрат.ВидДеятельностиДляНалоговогоУчетаЗатрат = Перечисления.ВидыДеятельностиДляНалоговогоУчетаЗатрат.ОсобыйПорядокНалогообложения) Тогда
				_сф.Инкремент(СуммаДЕ, ?(ПоВалютнымСуммам,Стр.Всего,Стр.Всего_Рег));
			Иначе
				_сф.Инкремент(СуммаДУ, ?(ПоВалютнымСуммам,Стр.Всего,Стр.Всего_Рег));
				_сф.Инкремент(СуммаНДС, ?(ПоВалютнымСуммам,Стр.НДС,Стр.НДС_Рег));
			КонецЕсли; 
		Иначе
			_сф.Инкремент(СуммаДК, ?(ПоВалютнымСуммам,Стр.Всего,Стр.Всего_Рег));
		КонецЕсли; 
		
	КонецЦикла; 
	
	Если (ПоВалютнымСуммам) Тогда
		Итого = УслугиПоСчетуАванса.Итог("Всего");
	Иначе
		Итого = УслугиПоСчетуАванса.Итог("Всего_Рег");
	КонецЕсли; 
	
	СтрокаОплаты.СуммаДУ = Окр(СуммаДУ*Сумма/Итого,2);
	СтрокаОплаты.СуммаДК = Окр(СуммаДК*Сумма/Итого,2);
	СтрокаОплаты.СуммаДЕ = Окр(СуммаДЕ*Сумма/Итого,2);  
	Если СтрокаОплаты.Владелец().Колонки.Найти("НДС") <> Неопределено Тогда 
		СтрокаОплаты.НДС = Окр(СуммаНДС*Сумма/Итого,2);  
	КонецЕсли;
	
	//Если (ПоВалютнымСуммам) Тогда
	//	СтрокаОплаты.СуммаДУ = Окр(СтрокаОплаты.СуммаДУ * СтрокаОплаты.Сумма/СтрокаОплаты.ВалютнаяСумма,2);
	//	СтрокаОплаты.СуммаДК = Окр(СтрокаОплаты.СуммаДК * СтрокаОплаты.Сумма/СтрокаОплаты.ВалютнаяСумма,2);
	//	СтрокаОплаты.СуммаДЕ = Окр(СтрокаОплаты.СуммаДЕ * СтрокаОплаты.Сумма/СтрокаОплаты.ВалютнаяСумма,2);
	//КонецЕсли; 
	
	Отклонение = (СтрокаОплаты.Сумма - (СтрокаОплаты.СуммаДУ + СтрокаОплаты.СуммаДК + СтрокаОплаты.СуммаДЕ));
	Если (Отклонение <> 0) Тогда
		Если (СтрокаОплаты.СуммаДУ <> 0) Тогда
			_сф.Инкремент(СтрокаОплаты.СуммаДУ,Отклонение);
			Отклонение = 0;
		ИначеЕсли (СтрокаОплаты.СуммаДК <> 0) Тогда
			_сф.Инкремент(СтрокаОплаты.СуммаДК,Отклонение);
			Отклонение = 0;
		ИначеЕсли (СтрокаОплаты.СуммаДЕ <> 0) Тогда
			_сф.Инкремент(СтрокаОплаты.СуммаДЕ,Отклонение);
			Отклонение = 0;
		КонецЕсли;
	КонецЕсли;
	
КонецФункции

Функция РаспределениеОплаты(ДокументРеализации,Сумма,ОтдельныйСчетПоПеревыставляемым)
	
	Если ТипЗнч(ДокументРеализации) = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
		
		СуммаУслуг = 0;
		СуммаНеЕНВД = 0;
		СуммаЕНВД = 0;
		СуммаПеревыставляемых = 0; 
		
		ВремТаблица =  ДокументРеализации.Услуги.Выгрузить(); 
		ВремТаблица.Свернуть("СчетДоходов","Сумма,СуммаНДС");
		
		СуммаУслуг = ВремТаблица.Итог("Сумма") + ВремТаблица.Итог("СуммаНДС");
		
		Для каждого СтрокаТаблицы Из ВремТаблица Цикл
			ЭтоЕНВД = БухгалтерскийУчетПовтИсп.СчетОтноситсяКДеятельностиЕНВД(СтрокаТаблицы.СчетДоходов); 
			Если ЭтоЕНВД Тогда   
				СуммаЕНВД = СтрокаТаблицы.Сумма+СтрокаТаблицы.СуммаНДС;
			Иначе
				СуммаНеЕНВД = СтрокаТаблицы.Сумма+СтрокаТаблицы.СуммаНДС;
			КонецЕсли; 
		КонецЦикла;  
		
		Если НЕ ОтдельныйСчетПоПеревыставляемым Тогда
			СуммаПеревыставляемых = ДокументРеализации.АгентскиеУслуги.Итог("Сумма")+ДокументРеализации.АгентскиеУслуги.Итог("СуммаНДС");
			СуммаУслуг = СуммаУслуг + СуммаПеревыставляемых;
		КонецЕсли; 
		
		Ответ = Новый Структура("СуммаНеЕНВД,СуммаЕНВД,СуммаПеревыставляемых", 0,0,0); 

		Если СуммаУслуг <> 0 Тогда
			Ответ.СуммаНеЕНВД=Окр(СуммаНеЕНВД*Сумма/СуммаУслуг,2);
		КонецЕсли;
		
		Если НЕ ОтдельныйСчетПоПеревыставляемым Тогда
			
			Ответ.СуммаПеревыставляемых = Окр(СуммаПеревыставляемых*Сумма/СуммаУслуг,2,1);
			Ответ.СуммаЕНВД = Сумма - Ответ.СуммаНеЕНВД - Ответ.СуммаПеревыставляемых;
			
		Иначе
			
			Ответ.СуммаПеревыставляемых = 0;
			Ответ.СуммаЕНВД = Сумма - Ответ.СуммаНеЕНВД;
			
		КонецЕсли; 
		
		Возврат Ответ;
		
	Иначе
		
		Ответ = Новый Структура("СуммаНеЕНВД,СуммаЕНВД,СуммаПеревыставляемых", 0,0,0); 

		Ответ.СуммаНеЕНВД 	= Сумма;
		Ответ.СуммаЕНВД 	= 0;
		Ответ.СуммаПеревыставляемых = 0;
		
		Возврат Ответ;
		
	КонецЕсли; 
		
КонецФункции

Функция ПН(Контрагент) //Полное наименование контрагента
	
	Возврат ?(ЗначениеЗаполнено(Контрагент.НаименованиеПолное), Контрагент.НаименованиеПолное, Контрагент.Наименование); 
	
КонецФункции

Функция ОпределитьКурсПоДокументу(Договор, Сделка, РасчетныйДокумент)
	
	Курс = 1;
	
	Если НЕ ЗначениеЗаполнено(РасчетныйДокумент) Тогда
		Возврат Курс;
	Конецесли;
	
	ВРУ = CW_Настройки.ВалютаРегламентированногоУчета();
	
	Если (ТипЗнч(Договор) = Тип("СправочникСсылка.ДоговорыКонтрагентов")) И (ЗначениеЗаполнено(Договор)) Тогда
		
		Если Договор.РасчетыВУсловныхЕдиницах Тогда
			
			МетаданныеДокумента = РасчетныйДокумент.Метаданные();
			
			Если ОбщегоНазначения.ЕстьРеквизитТабЧастиДокумента("СуммаПлатежа", МетаданныеДокумента, "РасшифровкаПлатежа") И
				ОбщегоНазначения.ЕстьРеквизитТабЧастиДокумента("СуммаВзаиморасчетов", МетаданныеДокумента, "РасшифровкаПлатежа") И
				ОбщегоНазначения.ЕстьРеквизитТабЧастиДокумента("ДоговорКонтрагента", МетаданныеДокумента, "РасшифровкаПлатежа") И
				ОбщегоНазначения.ЕстьРеквизитТабЧастиДокумента("Сделка", МетаданныеДокумента, "РасшифровкаПлатежа") Тогда
				
				Сумма = 0;
				СуммаВзаиморасчетов = 0;
				
				Для Каждого Строка ИЗ РасчетныйДокумент.РасшифровкаПлатежа Цикл
					
					Если Договор = Строка.ДоговорКонтрагента И ((Сделка = Строка.Сделка) ИЛИ (Не ЗначениеЗаполнено(Строка.Сделка))) Тогда
						
						Сумма = Сумма + Строка.СуммаПлатежа;
						СуммаВзаиморасчетов = СуммаВзаиморасчетов + Строка.СуммаВзаиморасчетов;
						
					КонецЕсли;
					
				КонецЦикла;
				
				Курс = ?(СуммаВзаиморасчетов = 0, 1, Сумма/СуммаВзаиморасчетов);
				
			ИначеЕсли ОбщегоНазначения.ЕстьРеквизитТабЧастиДокумента("Сумма", МетаданныеДокумента, "ОплатаПоставщику") И
				ОбщегоНазначения.ЕстьРеквизитТабЧастиДокумента("СуммаВзаиморасчетов", МетаданныеДокумента, "ОплатаПоставщику") И
				ОбщегоНазначения.ЕстьРеквизитТабЧастиДокумента("ДоговорКонтрагента", МетаданныеДокумента, "ОплатаПоставщику") И
				ОбщегоНазначения.ЕстьРеквизитТабЧастиДокумента("Сделка", МетаданныеДокумента, "ОплатаПоставщику") Тогда
				
				Сумма = 0;
				СуммаВзаиморасчетов = 0;
				
				Для Каждого Строка ИЗ РасчетныйДокумент.ОплатаПоставщику Цикл
					
					Если Договор = Строка.ДоговорКонтрагента И ((Сделка = Строка.Сделка) ИЛИ (Не ЗначениеЗаполнено(Строка.Сделка))) Тогда
						
						Сумма = Сумма + Строка.Сумма;
						СуммаВзаиморасчетов = СуммаВзаиморасчетов + Строка.СуммаВзаиморасчетов;
						
					КонецЕсли;
					
				КонецЦикла;
				
				Курс = ?(СуммаВзаиморасчетов = 0, 1, Сумма/СуммаВзаиморасчетов);
				
			КонецЕсли;
			
		Иначе
			Курс =  ЗаполнениеДокументов.КурсДокумента(РасчетныйДокумент, ВРУ)/ЗаполнениеДокументов.КратностьДокумента(РасчетныйДокумент, ВРУ);
		КонецЕсли;
		
	Иначе
			
		Курс =  ЗаполнениеДокументов.КурсДокумента(РасчетныйДокумент, ВРУ)/ЗаполнениеДокументов.КратностьДокумента(РасчетныйДокумент, ВРУ);
	
	КонецЕсли;
	
	Возврат Курс;
	
КонецФункции

Функция ОпределитьОстатокАванса(Счет,Контрагент,Договор,Документ,Валюта, Источник)
	// --- 
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ХозрасчетныйОстатки.СуммаОстаток,
	|	ХозрасчетныйОстатки.ВалютнаяСуммаОстаток
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный.Остатки(
	|			&Период,
	|			Счет = &Счет,
	|			,
	|			Субконто1 = &Контрагент
	|				И Субконто2 = &Договор
	|				И Субконто3 = &Документ
	|				И Валюта = &Валюта
	|				И Организация = &Организация) КАК ХозрасчетныйОстатки";
	Запрос.УстановитьПараметр("Период", Источник.МоментВремени());
	Запрос.УстановитьПараметр("Счет", Счет);
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.УстановитьПараметр("Договор", Договор);
	Запрос.УстановитьПараметр("Документ", Документ);
	Запрос.УстановитьПараметр("Валюта", Валюта);
	Запрос.УстановитьПараметр("Организация", Документ.Организация);
	ТЗ = Запрос.Выполнить().Выгрузить();
	ВалютнаяСумма = ТЗ.Итог("ВалютнаяСуммаОстаток");
	РублеваяСумма = ТЗ.Итог("СуммаОстаток");
	
	СтруктураОтвет = _сф.ст_Создать("ВалютнаяСумма,РублеваяСумма");
	СтруктураОтвет.ВалютнаяСумма = ВалютнаяСумма;
	СтруктураОтвет.РублеваяСумма = РублеваяСумма;
	Возврат(СтруктураОтвет);
	
	// --- 
КонецФункции
  
