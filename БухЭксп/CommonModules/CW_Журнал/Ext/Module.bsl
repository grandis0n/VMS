Процедура ОтладочноеСообщение(Источник,Сообщение,Ссылки=Неопределено,Данные=Неопределено) Экспорт 
	// --- 
	
	ЗаписатьСообщение(Источник,Перечисления.CW_ПриоритетыСистемныхСообщений.p7,Сообщение,Ссылки,Данные);
	
	// --- 
КонецПроцедуры

Процедура CW_РегламентнаяОтправкаСистемныхСообщений(Фильтр) Экспорт
	
	// получаем неотправленные 
	МассивСообщений = ПолучитьСообщения(Фильтр);
	
	Если МассивСообщений.Количество() = 0 Тогда
		
		Возврат;
		
	КонецЕсли; 
	
	// формируем структу письма
	СП = _ЭП.СтруктураПисьма();
	СП.Отправитель = Фильтр.УчетнаяЗапись;
	// --- 
	_ЭП.ЗаполнитьПолучателейПоТаблице(СП,Фильтр.Получатели);
	// --- 
	СП.Тема = Фильтр.ТемаСообщения;
	// --- 
	_ЭП.ДобавитьТекст(СП,СформироватьТекстПисьма(МассивСообщений));

	// оправляем или помещаем в очередь на отправку
	Ответ = _ЭП.ОтправитьПисьмо(СП);
	// если успешно - меняем дату актуальности фильтра
	Если Ответ.Код = 0 Тогда
		
		УстановитьДатуАктуальностиФильтра(Фильтр,_сф.к_ПоследнийЭлемент(МассивСообщений).Дата);
		
	КонецЕсли; 
	
КонецПроцедуры
  
Функция ПолучитьСообщения(Фильтр)
	// --- 
	
	// определяем дату последней отправки сообщений
	ДатаПоследнейОтправки = ПолучитьДатуАктуальностиФильтра(Фильтр);
	// получаем сообщения старше даты актуальности
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	CW_СистемныеСообщения.Ссылка
	               |ИЗ
	               |	Справочник.CW_СистемныеСообщения КАК CW_СистемныеСообщения
	               |ГДЕ
	               |	CW_СистемныеСообщения.Дата > &ДатаПоследнейОтправки
	               |	И CW_СистемныеСообщения.ПометкаУдаления = ЛОЖЬ
	               |	И ВЫБОР
	               |			КОГДА &ОтборПоПриоритету = ЛОЖЬ
	               |				ТОГДА ИСТИНА
	               |			ИНАЧЕ CW_СистемныеСообщения.Приоритет В (&СписокПриоритетов)
	               |		КОНЕЦ
	               |	И ВЫБОР
	               |			КОГДА &ТолькоЗаданныеИсточники = ЛОЖЬ
	               |				ТОГДА ИСТИНА
	               |			ИНАЧЕ CW_СистемныеСообщения.Источник В (&СписокИсточников)
	               |		КОНЕЦ
	               |	И ВЫБОР
	               |			КОГДА &КромеИсточников = ЛОЖЬ
	               |				ТОГДА ИСТИНА
	               |			ИНАЧЕ НЕ CW_СистемныеСообщения.Источник В (&СписокИсточников)
	               |		КОНЕЦ";
	Запрос.УстановитьПараметр("ДатаПоследнейОтправки", ДатаПоследнейОтправки);
	// --- 
	ОтборПоПриоритету = Фильтр.ОтборПоПриоритету;
	Запрос.УстановитьПараметр("ОтборПоПриоритету",ОтборПоПриоритету);
	Если ОтборПоПриоритету Тогда
		
		// сформируем массив приоритетов
		МассивПриоритетов = _сф.м_СоздатьИзКолонкиТЗ(Фильтр.Приоритеты.Выгрузить(),"Приоритет");
		Запрос.УстановитьПараметр("СписокПриоритетов", МассивПриоритетов); 
		
	Иначе
		
		Запрос.УстановитьПараметр("СписокПриоритетов", Неопределено);
		
	КонецЕсли; 
	// --- 
	Если Фильтр.ВариантФильтрацииПоИсточнику <> 0 Тогда
		
		// формируем массив источников
		МассивИсточников = _сф.м_СоздатьИзКолонкиТЗ(Фильтр.Источники.Выгрузить(),"Источник");
		Запрос.УстановитьПараметр("СписокИсточников", МассивИсточников);
		
		Если Фильтр.ВариантФильтрацииПоИсточнику = 1 Тогда
			
			Запрос.УстановитьПараметр("ТолькоЗаданныеИсточники", Истина); 
			Запрос.УстановитьПараметр("КромеИсточников", Ложь); 
			
		Иначе
			
			Запрос.УстановитьПараметр("ТолькоЗаданныеИсточники", Ложь); 
			Запрос.УстановитьПараметр("КромеИсточников", Истина); 
			
		КонецЕсли;
		
	Иначе
		
		Запрос.УстановитьПараметр("ТолькоЗаданныеИсточники", Ложь); 
		Запрос.УстановитьПараметр("КромеИсточников", Ложь);
		Запрос.УстановитьПараметр("СписокИсточников", Неопределено);
		
	КонецЕсли; 
	// ---------------------------------------------------------------------------- 
	
	МассивСообщений = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
	// --- 
	
	Возврат(МассивСообщений);
	
	// --- 
КонецФункции

Функция СформироватьТекстПисьма(МассивСообщений) Экспорт 
	// --- 
	
	Текст = "";
	Для каждого Сообщение Из МассивСообщений Цикл
		
		_сф.стр_Добавить(Текст,"Дата     : "+Формат(Сообщение.Дата,"ДФ='yyyy.MM.dd HH:mm:ss'")+Символы.ПС);
		_сф.стр_Добавить(Текст,"Источник : "+Строка(Сообщение.Источник)+Символы.ПС);
		_сф.стр_Добавить(Текст,"Приоритет: "+Строка(Сообщение.Приоритет)+Символы.ПС);
		_сф.стр_Добавить(Текст,Сообщение.Сообщение+Символы.ПС);
		_сф.стр_Добавить(Текст,"---"+Символы.ПС);
		
	КонецЦикла; 
	
	Возврат(Текст);
	
	// --- 
КонецФункции

Функция ПолучитьДатуАктуальностиФильтра(Фильтр)
	// --- 
	
	ТекстЗапроса = "ВЫБРАТЬ
	|	CW_ДатыАктуальностиФильтровСистемныхСообщений.Дата
	|ИЗ
	|	РегистрСведений.CW_ДатыАктуальностиФильтровСистемныхСообщений КАК CW_ДатыАктуальностиФильтровСистемныхСообщений
	|ГДЕ
	|	CW_ДатыАктуальностиФильтровСистемныхСообщений.Фильтр = &Фильтр";
	ДатаАктуальности = _сф.ВыполнитьЗапрос(ТекстЗапроса, Новый Структура("Фильтр", Фильтр),Истина,"Дата",Дата(1,1,1));
	Возврат(ДатаАктуальности);
	
	// --- 
КонецФункции

Функция УстановитьДатуАктуальностиФильтра(Фильтр,Дата)
	// --- 
	
	НЗ = РегистрыСведений.CW_ДатыАктуальностиФильтровСистемныхСообщений.СоздатьНаборЗаписей();
	_сф.УстановитьОтбор(НЗ.Отбор,"Фильтр",Фильтр);
	Запись = НЗ.Добавить();
	Запись.Фильтр = Фильтр;
	Запись.Дата = Дата;
	НЗ.Записать(Истина);
	
	// --- 
КонецФункции


// ИСТОРИЯ ОБЪЕКТОВ

Процедура ОпределитьРежимЗаписиОбъекта(Источник, РежимЗаписи=Неопределено) Экспорт 
	
	Метаданное = CW_Обмены_ПИ.МетаданноеКонфигурации(Источник.Метаданные().ПолноеИмя());
	Если Не CW_Журнал_ПИ.ТребуетсяИсторияДляОбъектаМетаданных(Метаданное) Тогда
		Возврат;
	КонецЕсли; 
	
	Если Источник.ДополнительныеСвойства.Свойство("CW_СобытиеЗаписи") Тогда 
		Источник.ДополнительныеСвойства.Вставить("_СобытиеЗаписи", Источник.ДополнительныеСвойства.CW_СобытиеЗаписи);
		Возврат;
	КонецЕсли;
	
	// ---------------------------------------------------------------------------- 
	// проверить, что эта часть уже не понадобится
	
	Если РежимЗаписи = Неопределено Тогда
		
		Вид = "Справочник";
		
	Иначе
		
		Вид = "Документ";
		
	КонецЕсли; 
	
	Если Вид = "Справочник" Тогда
		
		Событие = Перечисления.CW_СобытияОбъектов.ПустаяСсылка();
		// --- 
		Если Источник.Ссылка.Пустая() Тогда
			Событие = Перечисления.CW_СобытияОбъектов.Создание;
		Иначе
			Если Источник.ПометкаУдаления <> Источник.Ссылка.ПометкаУдаления Тогда
				Если Источник.ПометкаУдаления Тогда
					Событие = Перечисления.CW_СобытияОбъектов.ПометкаУдаления;
				Иначе
					Событие = Перечисления.CW_СобытияОбъектов.СнятиеПометкиУдаления;
				КонецЕсли; 
			Иначе
				Событие = Перечисления.CW_СобытияОбъектов.Изменение;			
			КонецЕсли;
		КонецЕсли;
		// --- 
		_сф.ст_УстановитьСвойство(Источник.ДополнительныеСвойства,"_СобытиеЗаписи",Событие);
		
	ИначеЕсли Вид = "Документ" Тогда 
		
		Событие = Перечисления.CW_СобытияОбъектов.ПустаяСсылка();
		// --- 
		Если РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
			
			Событие = Перечисления.CW_СобытияОбъектов.Проведение;
			
		ИначеЕсли РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения Тогда 
			
			 Событие = Перечисления.CW_СобытияОбъектов.ОтменаПроведения;
			 
		 ИначеЕсли РежимЗаписи = РежимЗаписиДокумента.Запись Тогда 
			 
			 Если Источник.Ссылка.Пустая() Тогда
				 Событие = Перечисления.CW_СобытияОбъектов.Создание;
			 Иначе
				 Если Источник.ПометкаУдаления <> Источник.Ссылка.ПометкаУдаления Тогда
					 Если Источник.ПометкаУдаления Тогда
						 Событие = Перечисления.CW_СобытияОбъектов.ПометкаУдаления;
					 Иначе
						 Событие = Перечисления.CW_СобытияОбъектов.СнятиеПометкиУдаления;
					 КонецЕсли; 
				 Иначе
					 Событие = Перечисления.CW_СобытияОбъектов.Изменение;			
				 КонецЕсли;
			 КонецЕсли;
			 
		КонецЕсли; 
		// --- 
		_сф.ст_УстановитьСвойство(Источник.ДополнительныеСвойства,"_СобытиеЗаписи",Событие);
		
	КонецЕсли; 
		
	// --- 
КонецПроцедуры

Процедура ДобавитьЗаписьИстории(Источник,Событие,Пользователь = Неопределено,Дата=Неопределено) Экспорт 
	
	Если Пользователь = Неопределено Тогда
		
		Пользователь = CW_Настройки.Пользователь();
		
	КонецЕсли; 
	
	Если Дата = Неопределено Тогда
		
		Дата = ТекущаяДата();
		
	КонецЕсли; 
	
	ЭлементИстории = Справочники.CW_ИсторияОбъектов.СоздатьЭлемент();
	ЭлементИстории.Дата = Дата;
	ЭлементИстории.Объект = Источник.Ссылка.УникальныйИдентификатор();
	ЭлементИстории.CW_Представление = Строка(Источник.Ссылка);
	ЭлементИстории.НавигационнаяСсылка = ПолучитьНавигационнуюСсылку(Источник.Ссылка);
	ЭлементИстории.Пользователь = Пользователь;
	ЭлементИстории.Событие = Событие;
	ЭлементИстории.ИмяКомпьютера = ИмяКомпьютера();
	ЭлементИстории.ОбменДанными.Загрузка=Истина;
	ЭлементИстории.Записать();
	
КонецПроцедуры
  