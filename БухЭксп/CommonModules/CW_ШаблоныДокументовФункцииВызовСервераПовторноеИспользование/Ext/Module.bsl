
Функция ПолучитьИдентификаторыПараметровШаблона(НазначениеШаблона) Экспорт
	
	Массив = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	МаросыШаблоновДокументов.Идентификатор КАК Идентификатор
	               |ИЗ
	               |	Справочник.CW_МакросыШаблоновДокументов КАК МаросыШаблоновДокументов
	               |ГДЕ
	               |	МаросыШаблоновДокументов.НазначениеШаблона = &НазначениеШаблона
	               |	И МаросыШаблоновДокументов.ЭтоГруппа = ЛОЖЬ
	               |	И МаросыШаблоновДокументов.НеИспользуется = ЛОЖЬ"; 
	
    Запрос.УстановитьПараметр("НазначениеШаблона", НазначениеШаблона);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
       Массив.Добавить(Выборка.Идентификатор);
	КонецЦикла;
	
	Возврат Массив; 
	
КонецФункции 