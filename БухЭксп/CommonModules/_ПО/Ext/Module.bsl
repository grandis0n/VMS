// получаем 
Функция ПолучитьПолноеИмяФормы(ПодключаемыйОбъект, Имяформы, ТипФормы="" ) Экспорт
	
	ВидОбъекта = "";
	Если ПодключаемыйОбъект.Встроенная Тогда
		
		Если  ПодключаемыйОбъект.ТипВнешнегоОбъекта = ПредопределенноеЗначение("Перечисление.CW_ТипыПодключаемыхОбъектов.ВнешнийОтчет") Тогда
			ВидОбъекта = "Отчет.";
		Иначе
			ВидОбъекта = "Обработка.";
		Конецесли;
		
		ИмяОбъекта = СокрЛП(ПодключаемыйОбъект.ИмяВстроеннойОбработки);
	
	Иначе
		
		Если ПодключаемыйОбъект.Отладка Тогда
			ИмяОбъекта = ПодключаемыйОбъект.ИмяВнешнегоОбъекта;
		Иначе
			ИмяОбъекта = ИдентификаторОбработки(ПодключаемыйОбъект);
		КонецЕсли;
			
		Если  ПодключаемыйОбъект.ТипВнешнегоОбъекта = ПредопределенноеЗначение("Перечисление.CW_ТипыПодключаемыхОбъектов.ВнешнийОтчет") Тогда
			ВидОбъекта = "ВнешнийОтчет."; 
		Иначе
			ВидОбъекта = "ВнешняяОбработка."; 
		Конецесли;
		
	КонецЕсли; 
	
	Если ЗначениеЗаполнено(Имяформы) Тогда
		ИмяОтрываемойФрмы = ".Форма." + Имяформы;
	Иначе
			ИмяОтрываемойФрмы = "."+ТипФормы;
	КонецЕсли;
	
	Возврат ВидОбъекта + ИмяОбъекта + ИмяОтрываемойФрмы;
	
КонецФункции


Функция ПолучитьПолноеИмяФормыПоТипу(ПодключаемыйОбъект,ТипФормы) Экспорт 
	
	Имяформы = ПолучитьИмяФормыПоТипу(ПодключаемыйОбъект, ТипФормы);
		
	Возврат ПолучитьПолноеИмяФормы(ПодключаемыйОбъект, Имяформы, ТипФормы);
	
КонецФункции

// получение имени формы обработки по типу
Функция ПолучитьИмяФормыПоТипу(ПодключаемыйОбъект,ТипФормы) Экспорт 
	// --- 
	
	СтрокаФормы = ПодключаемыйОбъект.ФормыОбъекта.Найти(ТипФормы,"ТипФормы");
	Если СтрокаФормы = Неопределено Тогда
		
		Возврат(Неопределено);
		
	Иначе
		
		Если СокрЛП(СтрокаФормы.ИмяФормы) = "" Тогда
			
			Возврат(Неопределено);
			
		Иначе
			
			Возврат(СтрокаФормы.ИмяФормы);
			
		КонецЕсли; 
		
	КонецЕсли; 
	
	// --- 
КонецФункции

