Функция УдалитьСвязанныеРегламентныеЗадания(Объект) Экспорт 
	// --- 
	
	Попытка
		
		УстановитьПривилегированныйРежим(Истина);
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		|	CW_РегламентныеЗадания.ИдентификаторЗадания
		|ИЗ
		|	РегистрСведений.CW_РегламентныеЗадания КАК CW_РегламентныеЗадания
		|ГДЕ
		|	CW_РегламентныеЗадания.Объект = &Объект";
		Запрос.УстановитьПараметр("Объект", Объект);
		МассивЗаданий = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ИдентификаторЗадания");
		Для каждого Идентификатор Из МассивЗаданий Цикл
			
			Задание = РегламентныеЗадания.НайтиПоУникальномуИдентификатору(Идентификатор);
			Если Задание <> Неопределено Тогда
				
				Задание.Удалить();
				
			КонецЕсли; 
			
		КонецЦикла; 
		
		// удаляем из регистра
		НЗ = РегистрыСведений.CW_РегламентныеЗадания.СоздатьНаборЗаписей();
		_сф.УстановитьОтбор(НЗ.Отбор,"Объект",Объект);
		НЗ.Записать(Истина);
		
		УстановитьПривилегированныйРежим(Ложь);
		Возврат(_УФКС.Ответ());
		
	Исключение
		
		// пишем в лог
		ТекстОшибки = ОписаниеОшибки();
		CW_Журнал.ЗаписатьСообщение("Общее.РегистрацияСвязанногоЗадания","error",Строка(Объект)+Символы.ПС+ТекстОшибки);
		Возврат(_УФКС.Ответ(1,ТекстОшибки));
		
	КонецПопытки; 
		
	// --- 
КонецФункции

Функция ДобавитьСвязанноеРегламентноеЗадание(Объект,ИдентификаторЗадания) Экспорт 
	// --- 
	
	Попытка
		
		Запись = РегистрыСведений.CW_РегламентныеЗадания.СоздатьМенеджерЗаписи();
		Запись.Объект = Объект;
		Запись.ИдентификаторЗадания = ИдентификаторЗадания;
		Запись.Записать();
		
		Возврат(_УФКС.Ответ());
		
	Исключение
		
		ТекстОшибки = ОписаниеОшибки();
		CW_Журнал.ЗаписатьСообщение("Общее.РегистрацияСвязанногоЗадания","error",Строка(Объект)+Символы.ПС+ТекстОшибки);
		Возврат(_УФКС.Ответ(1,ТекстОшибки));
		
	КонецПопытки; 
	
		
	
	// --- 
КонецФункции

