Функция ПодключитьОбработку(ПодключаемыйОбъект) Экспорт 
	
	Если НЕ ПодключаемыйОбъект.Встроенная Тогда
		
		АдресОбработки = ПолучитьНавигационнуюСсылку(ПодключаемыйОбъект,"ХранилищеОбработки");
		
		Если ПодключаемыйОбъект.ТипВнешнегоОбъекта = ПредопределенноеЗначение("Перечисление.CW_ТипыПодключаемыхОбъектов.ВнешнийОтчет") Тогда
			Менеджер = ВнешниеОтчеты;
		Иначе
			Менеджер = ВнешниеОбработки;
		КонецЕсли;
		
		Попытка
			Если ПодключаемыйОбъект.Отладка Тогда
				
				Файл = Новый Файл(ПодключаемыйОбъект.ОтладкаИмяОбработки);
				Если Не Файл.Существует() Тогда
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Файл обработки для отладки не доступен по указанному расположению.");
					Возврат Ложь;
				КонецЕсли;
				
				ИмяВнешнейОбработки = Менеджер.Создать(ПодключаемыйОбъект.ОтладкаИмяОбработки);
			Иначе			
				Если ОбщегоНазначения.ЕстьЗащитаОтОпасныхДействий() Тогда
					ИмяВнешнейОбработки = Менеджер.Подключить(АдресОбработки,ИдентификаторОбработки(ПодключаемыйОбъект) , Ложь,
					ОбщегоНазначения.ОписаниеЗащитыБезПредупреждений());
				Иначе
					ИмяВнешнейОбработки = Менеджер.Подключить(АдресОбработки,ИдентификаторОбработки(ПодключаемыйОбъект) , Ложь);
				КонецЕсли;
			КонецЕсли;
		Исключение
			Возврат Ложь;
		КонецПопытки;
		
	КонецЕсли; 
	
	Возврат Истина;
	
КонецФункции

Функция ПолучитьОбработку(ПодключаемыйОбъект,Заново=Ложь) Экспорт 
	// --- 
	
	// внимание: при загрузке новой обработки она должна быть подключена заново !
	
	// имя обработки - всегда УИД Подключаемого объекта
	
	
	Если (НЕ ПодключаемыйОбъект.Встроенная) Тогда
		
		Если (ПодключитьОбработку(ПодключаемыйОбъект)) Тогда
			
			Если ПодключаемыйОбъект.ТипВнешнегоОбъекта = ПредопределенноеЗначение("Перечисление.CW_ТипыПодключаемыхОбъектов.ВнешнийОтчет") Тогда
				Менеджер = ВнешниеОтчеты;
			Иначе
				Менеджер = ВнешниеОбработки;
			КонецЕсли;
			
			Если ПодключаемыйОбъект.Отладка Тогда
				Файл = Новый Файл(ПодключаемыйОбъект.ОтладкаИмяОбработки);
				Если Не Файл.Существует() Тогда
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Файл обработки для отладки не доступен по указанному расположению.");
					Возврат Ложь;
				КонецЕсли;
				
				ВнешняяОбработка = Менеджер.Создать(ПодключаемыйОбъект.ОтладкаИмяОбработки);
			Иначе
				ВнешняяОбработка = Менеджер.Создать(ИдентификаторОбработки(ПодключаемыйОбъект));
			КонецЕсли;
			
		Иначе
			Возврат(Неопределено);
		КонецЕсли;

	Иначе     
		
		УстановитьПривилегированныйРежим(Истина);
		
		// встроенная
		Если ПодключаемыйОбъект.ТипВнешнегоОбъекта = ПредопределенноеЗначение("Перечисление.CW_ТипыПодключаемыхОбъектов.ВнешнийОтчет") Тогда
			ВнешняяОбработка = Отчеты[ПодключаемыйОбъект.ИмяВстроеннойОбработки].Создать();
		Иначе
			ВнешняяОбработка = Обработки[ПодключаемыйОбъект.ИмяВстроеннойОбработки].Создать();
		КонецЕсли;
		
	КонецЕсли; 
			
	Возврат(ВнешняяОбработка);
	
КонецФункции

Функция ПолучитьСоответствиеВидаОбработкиРасширению()
	
	Соответствие = новый Соответствие;
	Соответствие.Вставить(ПредопределенноеЗначение("Перечисление.CW_ТипыПодключаемыхОбъектов.ВнешняяОбработка"),	".epf");
	Соответствие.Вставить(ПредопределенноеЗначение("Перечисление.CW_ТипыПодключаемыхОбъектов.ВнешнийОтчет"),		".erf");
	
	Возврат Соответствие;
	
КонецФункции

