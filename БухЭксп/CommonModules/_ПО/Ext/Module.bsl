КонецФункции

Функция ПолучитьСтруктуруОтветавнешнейФормы(ВыбранноеЗначение, Параметр) Экспорт
	
	СтруктураОтвета = CW_МониторинговыеПараметрыСервер.ПолучитьПустуюСтруктуруРедактированияПараметров();
	СтруктураОтвета.Параметр 		= Параметр;
	СтруктураОтвета.ПараметрИзменен = Истина;
	СтруктураОтвета.Значение 		= ВыбранноеЗначение;
	
	Возврат СтруктураОтвета;
	
КонецФункции

Функция ПолучитьИмяВыбраннойФормы(ПараметрыПолученияФормы) Экспорт
	
	// при отсутствии прав на использование модуля или полных прав 
	Если НЕ Пользователи.РолиДоступны("БухгалтерияЭкспедитора,ПолныеПрава") Тогда
		Возврат Неопределено;	
	КонецЕсли;
	
	ИмяМетаданных	= СокрЛП(ПараметрыПолученияФормы.Источник);
	
	ИмяМетаданных	= СтрЗаменить(ИмяМетаданных,"СправочникМенеджер"				,"Справочник");
	ИмяМетаданных	= СтрЗаменить(ИмяМетаданных,"ДокументМенеджер"					,"Документ");
	ИмяМетаданных	= СтрЗаменить(ИмяМетаданных,"ОтчетМенеджер"						,"Отчет");
	ИмяМетаданных	= СтрЗаменить(ИмяМетаданных,"ОбработкаМенеджер"					,"Обработка");
	ИмяМетаданных	= СтрЗаменить(ИмяМетаданных,"ПланВидовХарактеристикМенеджер"	,"ПланВидовХарактеристик");
	
	СсылкаОбъектаМетаданных = ОбщегоНазначения.ИдентификаторОбъектаМетаданных(ИмяМетаданных);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	CW_ПодключаемыеФормы.ПодключаемыйОбъект КАК ПодключаемыйОбъект
	               |ИЗ
	               |	Справочник.CW_ПодключаемыеФормы КАК CW_ПодключаемыеФормы
	               |ГДЕ
	               |	CW_ПодключаемыеФормы.НеИспользуется = ЛОЖЬ
	               |	И CW_ПодключаемыеФормы.ПометкаУдаления = ЛОЖЬ
	               |	И CW_ПодключаемыеФормы.ИдентификаторОбъектаМетаданных = &ИдентификаторОбъектаМетаданных";
	
	Запрос.УстановитьПараметр("ИдентификаторОбъектаМетаданных", СсылкаОбъектаМетаданных);
	
	РезультатЗапроса 	= Запрос.Выполнить();
	Выборка 		 	= РезультатЗапроса.Выбрать();
	
	ПодключаемаяФорма 	= Неопределено;
	Если Выборка.Следующий() Тогда	
		
		ВнешняяОбработка 	= ПолучитьОбработку(Выборка.ПодключаемыйОбъект);
		ИмяФормы 			= ВнешняяОбработка.ПолучитьИмяПодключаемойФормы(ПараметрыПолученияФормы.ВидФормы);
		
		Если ИмяФормы <> Неопределено Тогда
			ПодключаемаяФорма 	= ВнешняяОбработка.Метаданные().Формы[ИмяФормы];
		Конецесли;
		
	КонецЕсли;
	
	Возврат ПодключаемаяФорма;
	
КонецФункции


Процедура ЗаполнитьИнформациюПоОбработке(Объект,СтруктураОписания) Экспорт 
	
	// пишем прочие параметры обработки
	ТипВнешнегоОбъекта = Неопределено;
	СтруктураОписания.Свойство("Тип",	ТипВнешнегоОбъекта);
	Если ТипЗнч(ТипВнешнегоОбъекта) = Тип("Строка") Тогда
		//Поддержка версий ниже 8.3.10.10
		СоответствиеТипов 			= Справочники.CW_ПодключаемыеОбъекты.ПолучитьСоответствиеТипов();
		Объект.ТипВнешнегоОбъекта	= СоответствиеТипов.Получить(ТипВнешнегоОбъекта);
		//Поддержка версий ниже 8.3.10.10
	Иначе
		Объект.ТипВнешнегоОбъекта	= ТипВнешнегоОбъекта;
	КонецЕсли;
	
	СтруктураОписания.Свойство("Вид",			Объект.Вид);
	Объект.ПредставлениеВида = CW_ПодключаемыеКомандыСервер.ПолучитьПредсталениеВида(Объект.Вид);
	
	СтруктураОписания.Свойство("Версия",			Объект.Версия);
	СтруктураОписания.Свойство("ВерсияПодсистемы",	Объект.ВерсияПодсистемы);
	СтруктураОписания.Свойство("ИсторияИзменений",	Объект.ИсторияИзменений);
	
	Если Не ЗначениеЗаполнено(Объект.Наименование) Тогда
		СтруктураОписания.Свойство("Наименование",		Объект.Наименование);
	КонецЕсли;

	СтруктураОписания.Свойство("Поставщик",			Объект.Поставщик);
	СтруктураОписания.Свойство("Описание",			Объект.Описание);
	
	СтруктураОписания.Свойство("МинимальнаяВерсияМодуля",	Объект.МинимальнаяВерсияМодуля);  
	
	Если Объект.Ссылка.Пустая()
		И СтруктураОписания.Свойство("Индекс") Тогда  
		Объект.Индекс = СтруктураОписания.Индекс;
	КонецЕсли;
	
	РасполагатьНаРабочемСтоле 			= _сф.ст_ПолучитьСвойство(СтруктураОписания,"РасполагатьНаРабочемСтоле");
	Объект.РасполагатьНаРабочемСтоле 	= ?(РасполагатьНаРабочемСтоле=Неопределено,Ложь,РасполагатьНаРабочемСтоле);
	
	ФлагНастройки 		= _сф.ст_ПолучитьСвойство(СтруктураОписания,"Настройка");
	Объект.Настройка	= ?(ФлагНастройки=Неопределено,Ложь,ФлагНастройки);
	
	ФлагНастройкиСубъекта 		= _сф.ст_ПолучитьСвойство(СтруктураОписания,"НастройкаСубъекта");
	Объект.НастройкаСубъекта	= ?(ФлагНастройкиСубъекта=Неопределено,Ложь,ФлагНастройкиСубъекта);
	
	
	// Назначение
	Объект.НазначениеОбъекта.Очистить();
	Если ТипЗнч(_сф.ст_ПолучитьСвойство(СтруктураОписания,"НазначениеОбъекта"))=Тип("Массив") Тогда
		СоответствиеИдентифкаторов = ОбщегоНазначения.ИдентификаторыОбъектовМетаданных(СтруктураОписания.НазначениеОбъекта);
		Для каждого НазначениеОбъекта Из СтруктураОписания.НазначениеОбъекта Цикл
			Нстр = Объект.НазначениеОбъекта.Добавить();
			Нстр.Назначение = СоответствиеИдентифкаторов.Получить(НазначениеОбъекта);
		КонецЦикла; 
	КонецЕсли;	
	
	// методы
	Объект.МетодыОбъекта.Очистить();
	Если ТипЗнч(_сф.ст_ПолучитьСвойство(СтруктураОписания,"Методы"))=Тип("Массив") Тогда
		Для каждого Метод Из СтруктураОписания.Методы Цикл
			Нстр = Объект.МетодыОбъекта.Добавить();
			Нстр.Метод = Метод;
		КонецЦикла; 
	КонецЕсли; 
	
	// формы
	Объект.ФормыОбъекта.Очистить();
	Если ТипЗнч(_сф.ст_ПолучитьСвойство(СтруктураОписания,"Формы"))=Тип("Массив") Тогда
		Для каждого СтруктураФормы Из СтруктураОписания.Формы Цикл
			Нстр = Объект.ФормыОбъекта.Добавить();
			Нстр.ТипФормы = СтруктураФормы.Тип;
			Нстр.ИмяФормы = СтруктураФормы.Имя;
		КонецЦикла; 
	КонецЕсли; 
	
	//Команды   
	Если СтруктураОписания.Свойство("РасполагатьНаРабочемСтоле") Тогда
		Если СтруктураОписания.РасполагатьНаРабочемСтоле Тогда
			//Если команда отображается на рабочем столе, то список очищаем
			Объект.КомандыОбъекта.Очистить();
		КонецЕсли;                                                        
	КонецЕсли;
	
	Если ТипЗнч(_сф.ст_ПолучитьСвойство(СтруктураОписания,"КомандыОбъекта"))=Тип("Массив") Тогда
		
		Для каждого СтруктураКоманд Из СтруктураОписания.КомандыОбъекта Цикл
			
			ИмяКоманды = _сф.ст_ПолучитьСвойство(СтруктураКоманд,"ИмяКоманды");
			
			Отбор = Новый Структура;
			Отбор.Вставить("ИмяКоманды", 	ИмяКоманды);
			
			мСтроки = Объект.КомандыОбъекта.НайтиСтроки(Отбор);
			Если мСтроки.Количество() > 0 Тогда
				//Эта команда есть, не добавляем
				Продолжить;
			КонецЕсли;
			
			Нстр 						= Объект.КомандыОбъекта.Добавить();
			
			ИмяКартинки 				= _сф.ст_ПолучитьСвойство(СтруктураКоманд,"ИмяКартинки");
			Нстр.ИмяКартинки 			= ?(ИмяКартинки=Неопределено,"",ИмяКартинки);
			
			Нстр.ИмяКоманды 			= ИмяКоманды;
			
			ПредставлениеКоманды 		= _сф.ст_ПолучитьСвойство(СтруктураКоманд,"ПредставлениеКоманды");
			Нстр.ПредставлениеКоманды	= ?(ПредставлениеКоманды=Неопределено,"",ПредставлениеКоманды);
			
			ОсновнаяКоманда 			= _сф.ст_ПолучитьСвойство(СтруктураКоманд,"ОсновнаяКоманда");
			Нстр.ОсновнаяКоманда		= ?(ОсновнаяКоманда=Неопределено,Ложь,ОсновнаяКоманда);
			
		КонецЦикла; 
		
	КонецЕсли; 
	
	//Внешешние команды
	Если ТипЗнч(_сф.ст_ПолучитьСвойство(СтруктураОписания,"ПараметрыВнешнейКоманды"))=Тип("Массив") Тогда
		
		Для каждого СтруктураКоманд Из СтруктураОписания.ПараметрыВнешнейКоманды Цикл
			
			ИмяМетаданногоКонфигурации		= _сф.ст_ПолучитьСвойство(СтруктураКоманд,	"МетаданныеКонфигурации");
			СсылкаМетаданногоКонфигурации	= CW_Обмены_ПИ.МетаданноеКонфигурации(ИмяМетаданногоКонфигурации);
			МетаданныеКонфигурации			= ?(СсылкаМетаданногоКонфигурации=Неопределено,	Справочники.CW_МетаданныеКонфигурации.ПустаяСсылка(),	СсылкаМетаданногоКонфигурации);
			
			ИмяФормыОбъкта	= _сф.ст_ПолучитьСвойство(СтруктураКоманд,"ИмяФормыОбъкта");
			ИмяФормыОбъкта 	= ?(ИмяФормыОбъкта=Неопределено,			"", ИмяФормыОбъкта);
			
			ИмяТабличнойЧасти 					= _сф.ст_ПолучитьСвойство(СтруктураКоманд,"ИмяТабличнойЧасти");
			ИмяТабличнойЧасти		= ?(ИмяТабличнойЧасти=Неопределено,			"", ИмяТабличнойЧасти);

			Отбор = Новый Структура;
			Отбор.Вставить("МетаданныеКонфигурации", 	МетаданныеКонфигурации);
			Отбор.Вставить("ИмяФормыОбъкта", 			ИмяФормыОбъкта);
			Отбор.Вставить("ИмяТабличнойЧасти", 		ИмяТабличнойЧасти);
			
			мСтроки = Объект.ПараметрыВнешнейКоманды.НайтиСтроки(Отбор);
			Если мСтроки.Количество() > 0 Тогда
				//Команда для этого объекта уже есть, не добавляем
				Продолжить;
			КонецЕсли;
			
			НоваяСтрока 						= Объект.ПараметрыВнешнейКоманды.Добавить();
			
			ПредставлениеКоманды 				= _сф.ст_ПолучитьСвойство(СтруктураКоманд,	"ПредставлениеКоманды");
			НоваяСтрока.ПредставлениеКоманды 	= ?(ПредставлениеКоманды =Неопределено,		"",	ПредставлениеКоманды);
			
			НоваяСтрока.МетаданныеКонфигурации 	= МетаданныеКонфигурации;
			НоваяСтрока.ИмяФормыОбъкта			= ИмяФормыОбъкта;
			НоваяСтрока.ИмяТабличнойЧасти		= ИмяТабличнойЧасти;
			
			РасположениеГруппы 					= _сф.ст_ПолучитьСвойство(СтруктураКоманд,"РасположениеГруппы");
			НоваяСтрока.РасположениеГруппы		= ?(РасположениеГруппы=Неопределено, "", РасположениеГруппы);
			
			ПередЭлементом 						= _сф.ст_ПолучитьСвойство(СтруктураКоманд,"ПередЭлементом");
			НоваяСтрока.ПередЭлементом			= ?(ПередЭлементом=Неопределено, "", ПередЭлементом);

			ИмяКартинки 						= _сф.ст_ПолучитьСвойство(СтруктураКоманд,"ИмяКартинки");
			НоваяСтрока.ИмяКартинки				= ?(ИмяКартинки=Неопределено, "", ИмяКартинки);
			
			Индекс 								= _сф.ст_ПолучитьСвойство(СтруктураКоманд,"Индекс");
			НоваяСтрока.Индекс					= ?(Индекс=Неопределено, 0, Индекс);
			
		КонецЦикла; 
		
	КонецЕсли; 
	
	//Макросы
	Объект.Макросы.Очистить();
	Если ТипЗнч(_сф.ст_ПолучитьСвойство(СтруктураОписания,"ТаблицаМакросов"))=Тип("ТаблицаЗначений") Тогда
		Для Каждого СтрокаТаблицы из СтруктураОписания.ТаблицаМакросов Цикл
			СтрокаМакроса = Объект.Макросы.Добавить();
			СтрокаМакроса.ИмяМакроса 			= СтрокаТаблицы.ИмяМакроса;
			СтрокаМакроса.ПредставлениеМакроса 	= СтрокаТаблицы.ПредставлениеМакроса;
			СтрокаМакроса.МетодМакроса 			= СтрокаТаблицы.МетодМакроса;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры


