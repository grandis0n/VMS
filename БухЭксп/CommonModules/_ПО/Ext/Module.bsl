//УСТАРЕЛА. Следует использовать CW_ПодключаемыеКомандыСервер.ОбновитьРегистрациюПечатнойФормы
Функция ОбновитьРегистрациюПечатнойФормы(Обработка, Знач ПредставлениеОбработки = "", МассивМетаданных) Экспорт 
	
	ПредставлениеОбработки = ?(НЕ ЗначениеЗаполнено(ПредставлениеОбработки), СокрЛП(Обработка), ПредставлениеОбработки);
	
	Попытка
		
		Набор = РегистрыСведений.CW_ВнешниеПечатныеФормы.СоздатьНаборЗаписей();
		Набор.Отбор.Обработка.Установить(Обработка);
		Набор.Записать(Истина);
		
		Если Обработка.ПометкаУдаления Тогда
			Возврат _УФКС.Ответ();
		КонецЕсли; 
		
		Для Каждого Метаданное Из МассивМетаданных Цикл
			
			Запись = Набор.Добавить();
			Запись.Обработка 	= Обработка;
			Запись.Метаданное 	= CW_Обмены_ПИ.МетаданноеКонфигурации(Метаданное);
			
			Запись.Наименование = ПредставлениеОбработки;
			Запись.Индекс 		= Обработка.Индекс;
			
		КонецЦикла; 
		
		Набор.Записать(Истина);
		
		Возврат _УФКС.Ответ();
		
	Исключение
		
		Возврат _УФКС.Ответ(1,ОписаниеОшибки());
		
	КонецПопытки; 
	
КонецФункции

