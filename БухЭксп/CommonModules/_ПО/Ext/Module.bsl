	// --- 
	
	УстановитьПривилегированныйРежим(Истина);
	
	Попытка
		
		Настройки = ХранилищеСистемныхНастроек.Загрузить("_ПО."+Строка(_сф.УИД(Объект)),?(Субъект=Неопределено,"Настройки",Строка(_сф.УИД(Субъект))),,"БухгалтерияЭкспедитора");
				
	Исключение
	    
		Настройки = Неопределено;
		
	КонецПопытки; 
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат(Настройки);
	
	// --- 
КонецФункции

