&НаСервере
Функция ЭтоФормаЖурналаЗаказов(УФ) Экспорт 
	// --- 
	
	Возврат(УФ.ИмяФормы = "Обработка.CW_ЖурналЗаказов.Форма.Форма");
	
	// --- 
КонецФункции
// ---------------------------------------------------------------------------- 

&НаСервере
Процедура ПроверитьКолонки(УФ)
	// --- 
	
	Если (ЭтоФормаЖурналаГрузоперевозок(УФ) ИЛИ ЭтоФормаЗаказа(УФ) ИЛИ ЭтоФормаЗаявки(УФ)) Тогда
		КоллекцияРеквизитов = Метаданные.Справочники.CW_Грузоперевозки.Реквизиты;
		ТипСсылки = Новый ОписаниеТипов("СправочникСсылка.CW_Грузоперевозки");
	ИначеЕсли (ЭтоФормаЖурналаЗаявок(УФ)) Тогда 
		КоллекцияРеквизитов = Метаданные.Справочники.CW_Заявки.Реквизиты;
		ТипСсылки = Новый ОписаниеТипов("СправочникСсылка.CW_Заявки");
	ИначеЕсли (ЭтоФормаЖурналаЗаказов(УФ)) Тогда 
		КоллекцияРеквизитов = Метаданные.Справочники.CW_Заказы.Реквизиты;
		ТипСсылки = Новый ОписаниеТипов("СправочникСсылка.CW_Заказы");
	КонецЕсли; 
	// --- 
	РеквизитыДляПрямогоРедактирования = МассивРеквизитовГрупповогоРедактирования(УФ);
	МассивУдаления = Новый Массив;
	// ---------------------------------------------------------------------------- 
	
	НаборПрав = CW_ПраваДоступа.НаборПравДляПараметров();
	СоответствиеПараметров = CW_Мониторинг.ПолучитьСоответствиеСвойствПараметров(); 
	
	// проверим настройки колонок и права доступа
	// ---------------------------------------------------------------------------- 
	Для каждого строкаОписанияКолонки Из УФ.Журнал_ОписаниеКолонок Цикл
		
		// типизация ссылки
		Если (строкаОписанияКолонки.СтрокаПоляКомпоновки = "Ссылка") Тогда
			строкаОписанияКолонки.ТипЗначения = ТипСсылки;
		КонецЕсли;
		
		// невидимые колонки не обрабатываем во имя луны
		Если (НЕ строкаОписанияКолонки.Видимость) Тогда
			Продолжить;
		КонецЕсли; 
		
		// если не указана сортировка
		Если строкаОписанияКолонки.Сортировка.Пустая() Тогда
			строкаОписанияКолонки.Сортировка = Перечисления.CW_ПорядокСортировки.Нет;
		КонецЕсли; 
		
		// если не указана фиксация
		Если строкаОписанияКолонки.Фиксация.Пустая() Тогда
			строкаОписанияКолонки.Фиксация = Перечисления.CW_ВариантыФиксацииКолонок.Нет;
		КонецЕсли; 
		
		// ---------------------------------------------------------------------------- 
		
		// если колонка - параметр г/п - обновим тип и режим редактирования
		// проверим, не является ли ссылка на параметр битой =)
		Если (строкаОписанияКолонки.ПараметрГрузоперевозки ИЛИ строкаОписанияКолонки.КонтрольнаяДатаГрузоперевозки) Тогда
			
			// проверка на битую ссылку
			Если Найти(Строка(строкаОписанияКолонки.ОбъектХарактеристики),"не найден") <> 0 Тогда
				
				// параметр был удалён, колонку необходимо удалить из настроек
				МассивУдаления.Добавить(строкаОписанияКолонки);
				Сообщить("Колонка """+строкаОписанияКолонки.Имя+""" удалена.");
				Продолжить;
				
			КонецЕсли; 
			
			Если строкаОписанияКолонки.ОбъектХарактеристики.Пустая() Тогда
				
				// ахутнг - удаляем
				МассивУдаления.Добавить(строкаОписанияКолонки);
				Продолжить;
				
			КонецЕсли; 
			
			// ---------------------------------------------------------------------------- 
			
			СвойстваПараметра = СоответствиеПараметров.Получить(строкаОписанияКолонки.ОбъектХарактеристики);
			
			// проверяем права доступа и режим редактирования
			ПраваПараметра = НаборПрав["п_"+_сф.КлючПоСсылке(строкаОписанияКолонки.ОбъектХарактеристики)];
			Если НЕ ПраваПараметра.Просмотр Тогда
				
				МассивУдаления.Добавить(строкаОписанияКолонки);
				Продолжить;
				
			Иначе
				
				// проверяем редактирование
				Если (НЕ ПраваПараметра.Редактирование) Тогда
					
					строкаОписанияКолонки.РежимПрямогоРедактирования = Ложь;
					
				Иначе
					
					ПрямоеРедактирование = СвойстваПараметра.ПрямоеРедактирование;
					МножественноеПрямоеРедактирование = СвойстваПараметра.МножественноеПрямоеРедактирование;
					Если ЭтоФормаЖурналаГрузоперевозок(УФ) 
						И СтрНайти(строкаОписанияКолонки.СтрокаПоляКомпоновки, "Заказ.") > 0 Тогда
						ПрямоеРедактирование = ложь;
						МножественноеПрямоеРедактирование = Ложь;
					КонецЕсли;
					
					// обновляем режим прямого редактирования по данным параметра
					строкаОписанияКолонки.РежимПрямогоРедактирования = ПрямоеРедактирование;
					//	строкаОписанияКолонки.РежимМножественногоРедактирования = (СвойстваПараметра.ПрямоеРедактирование И НЕ СвойстваПараметра.ИспользованиеОтбора);
					строкаОписанияКолонки.РежимМножественногоРедактирования = МножественноеПрямоеРедактирование;
					строкаОписанияКолонки.ИспользованиеОтбора = СвойстваПараметра.ИспользованиеОтбора;
					
				КонецЕсли; 
				
			КонецЕсли; 
			
			// обновляем тип 
			строкаОписанияКолонки.ТипЗначения = СвойстваПараметра.ТипЗначения;
			
			// обновляем тип параметра
			Если (СвойстваПараметра.ЭтоКонтрольнаяДата) Тогда
				строкаОписанияКолонки.ПараметрГрузоперевозки = Ложь;
				строкаОписанияКолонки.КонтрольнаяДатаГрузоперевозки = Истина;
			Иначе
				строкаОписанияКолонки.ПараметрГрузоперевозки = Истина;
				строкаОписанияКолонки.КонтрольнаяДатаГрузоперевозки = Ложь;
			КонецЕсли; 
			
			// проверяем, что идентификтор параметра не изменился
			
			//Для параметров всегда есть квадрантые скобки    
			мСтрокаПоляКомпоновки   = СтрРазделить(строкаОписанияКолонки.СтрокаПоляКомпоновки, ".");   
			стрОбъектПараметра  	= мСтрокаПоляКомпоновки[0];
			
			Если строкаОписанияКолонки.КонтрольнаяДатаПлан Тогда
				КонтрольныйИдентификатор 	= СвойстваПараметра.ИдентификаторПлан;
				ДополнениеЗаголовка 		= " (план)";
			ИначеЕсли строкаОписанияКолонки.КонтрольнаяДатаФакт Тогда 
				КонтрольныйИдентификатор = СвойстваПараметра.ИдентификаторФакт;
				ДополнениеЗаголовка 		= " (факт)";
			Иначе
				КонтрольныйИдентификатор = СвойстваПараметра.Идентификатор; 
				ДополнениеЗаголовка = "";
			КонецЕсли; 
			
			Если СтрНайти(строкаОписанияКолонки.СтрокаПоляКомпоновки,"["+КонтрольныйИдентификатор+"]") = 0 Тогда
				//Изменился идентифкатор параметра
				строкаОписанияКолонки.Заголовок 			= СвойстваПараметра.Наименование + ДополнениеЗаголовка;
				строкаОписанияКолонки.СтрокаПоляКомпоновки 	= стрОбъектПараметра+".["+КонтрольныйИдентификатор+"]";
				
				Если ЭтоФормаЖурналаЗаявок(УФ) Тогда
					строкаОписанияКолонки.Наименование = "Заявка."+КонтрольныйИдентификатор;
				Иначеесли ЭтоФормаЖурналаЗаказов(УФ) Тогда
					строкаОписанияКолонки.Наименование = "Заказ."+КонтрольныйИдентификатор;
				Иначе
					Если СтрНайти(строкаОписанияКолонки.СтрокаПоляКомпоновки, "Заказ") Тогда
						строкаОписанияКолонки.Наименование = "Заказ."+КонтрольныйИдентификатор;
					Иначе
						строкаОписанияКолонки.Наименование = "Грузоперевозка."+КонтрольныйИдентификатор;
					КонецЕсли;
				КонецЕсли; 
			КонецЕсли;

		Иначе
			
			// проверяем режим екселя
			Если РеквизитыДляПрямогоРедактирования.Найти(строкаОписанияКолонки.СтрокаПоляКомпоновки) <> Неопределено Тогда
				строкаОписанияКолонки.РежимПрямогоРедактирования = Истина;
				строкаОписанияКолонки.РежимМножественногоРедактирования = Истина;
			Иначе
				строкаОписанияКолонки.РежимПрямогоРедактирования = Ложь;
			КонецЕсли;
			
		КонецЕсли; 
		
	КонецЦикла; 
	// ---------------------------------------------------------------------------- 
	Если (МассивУдаления.Количество() <> 0) Тогда
		УФ.Журнал_КомпоновщикНастроек.Настройки.Отбор.Элементы.Очистить();
		_сф.к_УдалитьЭлементыПоМассиву(УФ.Журнал_ОписаниеКолонок,МассивУдаления);
	КонецЕсли; 
	
	// --- 
КонецПроцедуры
 

&НаСервере
Процедура ФиксыНастроек(УФ)
	// --- 
	
	// временный фикс
	УФ.Журнал_СтруктураНастроек.РежимВыделенияТП = "";
	
	Если (НЕ УФ.Журнал_СтруктураНастроек.Свойство("ОтборПоФинансовымСтатусам")) Тогда
		
		СписокФинансовыхСтатусов = Новый СписокЗначений;
		СписокФинансовыхСтатусов.ТипЗначения = Новый ОписаниеТипов("СправочникСсылка.CW_ФинансовыеСтатусы");
		УФ.Журнал_СтруктураНастроек.Вставить("ОтборПоФинансовымСтатусам", СписокФинансовыхСтатусов);
		
	КонецЕсли; 
	
	// --- 
КонецПроцедуры

&НаСервере
Функция МассивРеквизитовГрупповогоРедактирования(УФ) Экспорт 
	
	// тут проверяем права пользователя на редактирование основных реквизитов г/п
	ЕстьПравоРедактированияОсновныхРеквизитов = CW_ПраваДоступа.ПравоДоступно("РедактированиеОсновныхСвойствГрузоперевозок");
	
	РеквизитыДляПрямогоРедактирования = Новый Массив;
	Если (ЕстьПравоРедактированияОсновныхРеквизитов) Тогда
		
		Если (ЭтоФормаЖурналаГрузоперевозок(УФ) ИЛИ ЭтоФормаЗаказа(УФ) ИЛИ ЭтоФормаЗаявки(УФ)) Тогда
			
			СтруктураРедактируемыхРеквизитов = Новый Структура;
			Если ЭтоФормаЖурналаГрузоперевозок(УФ) Тогда
				СтруктураРедактируемыхРеквизитов = CW_Грузоперевозки_Сервер.ПолучитьСтруктуруРедактируемыхРеквизитовШапки(Истина);
			КонецЕсли;
			Если ЭтоФормаЗаказа(УФ) Тогда
				СтруктураРедактируемыхРеквизитов = CW_Грузоперевозки_Сервер.ПолучитьСтруктуруРедактируемыхРеквизитовШапки(Ложь);
			КонецЕсли;
			
			ЕстьФлаг = Неопределено;
			СтруктураРедактируемыхРеквизитов.Свойство("Заказ", ЕстьФлаг);
			ЕстьФлаг = ?(ЕстьФлаг = Неопределено, Истина, ЕстьФлаг);
			Если ЕстьФлаг Тогда
				РеквизитыДляПрямогоРедактирования.Добавить("Ссылка.Заказ"); // заказ
			КонецЕсли;
			
			ЕстьФлаг = Неопределено;
			СтруктураРедактируемыхРеквизитов.Свойство("Типоразмер", ЕстьФлаг);
			ЕстьФлаг = ?(ЕстьФлаг = Неопределено, Истина, ЕстьФлаг);
			Если ЕстьФлаг Тогда
				РеквизитыДляПрямогоРедактирования.Добавить("Ссылка.Типоразмер"); // типоразмер
			КонецЕсли;
			
			ЕстьФлаг = Неопределено;
			СтруктураРедактируемыхРеквизитов.Свойство("Клиент", ЕстьФлаг);
			ЕстьФлаг = ?(ЕстьФлаг = Неопределено, Истина, ЕстьФлаг);
			Если ЕстьФлаг Тогда
				РеквизитыДляПрямогоРедактирования.Добавить("Ссылка.Клиент"); // Клиент
			КонецЕсли;
			
			ЕстьФлаг = Неопределено;
			СтруктураРедактируемыхРеквизитов.Свойство("МенеджерПродаж", ЕстьФлаг);
			ЕстьФлаг = ?(ЕстьФлаг = Неопределено, Истина, ЕстьФлаг);
			Если ЕстьФлаг Тогда
				РеквизитыДляПрямогоРедактирования.Добавить("Ссылка.МенеджерПродаж"); // МенеджерПродаж
			КонецЕсли;
			
			ЕстьФлаг = Неопределено;
			СтруктураРедактируемыхРеквизитов.Свойство("ОперативныйМенеджер", ЕстьФлаг);
			ЕстьФлаг = ?(ЕстьФлаг = Неопределено, Истина, ЕстьФлаг);
			Если ЕстьФлаг Тогда
				РеквизитыДляПрямогоРедактирования.Добавить("Ссылка.ОперативныйМенеджер"); // ОперативныйМенеджер
			КонецЕсли;
			
			ЕстьФлаг = Неопределено;
			СтруктураРедактируемыхРеквизитов.Свойство("Груз", ЕстьФлаг);
			ЕстьФлаг = ?(ЕстьФлаг = Неопределено, Истина, ЕстьФлаг);
			Если ЕстьФлаг Тогда
				РеквизитыДляПрямогоРедактирования.Добавить("Ссылка.Груз"); // Груз
			КонецЕсли;
			
			ЕстьФлаг = Неопределено;
			СтруктураРедактируемыхРеквизитов.Свойство("Маршрут", ЕстьФлаг);
			ЕстьФлаг = ?(ЕстьФлаг = Неопределено, Истина, ЕстьФлаг);
			Если ЕстьФлаг Тогда
				РеквизитыДляПрямогоРедактирования.Добавить("Ссылка.Маршрут"); // Маршрут
			КонецЕсли;
			
			ЕстьФлаг = Неопределено;
			СтруктураРедактируемыхРеквизитов.Свойство("Представление", ЕстьФлаг);
			ЕстьФлаг = ?(ЕстьФлаг = Неопределено, Истина, ЕстьФлаг);
			Если ЕстьФлаг Тогда
				РеквизитыДляПрямогоРедактирования.Добавить("Ссылка.CW_Представление"); // Представление
			КонецЕсли;
			
			ЕстьФлаг = Неопределено;
			СтруктураРедактируемыхРеквизитов.Свойство("ДатаСделкиФ", ЕстьФлаг);
			ЕстьФлаг = ?(ЕстьФлаг = Неопределено, Истина, ЕстьФлаг);
			Если ЕстьФлаг Тогда
				РеквизитыДляПрямогоРедактирования.Добавить("Ссылка.ДатаСделкиФ"); // ДатаСделкиФ
			КонецЕсли;
			
			ЕстьФлаг = Неопределено;
			СтруктураРедактируемыхРеквизитов.Свойство("ТипПеревозки", ЕстьФлаг);
			ЕстьФлаг = ?(ЕстьФлаг = Неопределено, Истина, ЕстьФлаг);
			Если ЕстьФлаг Тогда
				РеквизитыДляПрямогоРедактирования.Добавить("Ссылка.ТипПеревозки"); // ТипПеревозки
			КонецЕсли;

			РеквизитыДляПрямогоРедактирования.Добавить("Ссылка.Примечание");
			РеквизитыДляПрямогоРедактирования.Добавить("Ссылка.ДатаЗакрытия");
			РеквизитыДляПрямогоРедактирования.Добавить("Ссылка.Комментарий");
			
			Если ПолучитьФункциональнуюОпцию("CW_ИспользованиеЗаявок") Тогда    
				ЕстьФлаг = Неопределено;
				СтруктураРедактируемыхРеквизитов.Свойство("Заявка", ЕстьФлаг);
				ЕстьФлаг = ?(ЕстьФлаг = Неопределено, Истина, ЕстьФлаг);
				Если ЕстьФлаг Тогда
					РеквизитыДляПрямогоРедактирования.Добавить("Ссылка.Заявка"); 
				КонецЕсли;
			КонецЕсли; 

		КонецЕсли; 
		
		Если (ЭтоФормаЖурналаЗаявок(УФ)) Тогда
			
			РеквизитыДляПрямогоРедактирования.Добавить("Ссылка.Типоразмер"); // типоразмер
			РеквизитыДляПрямогоРедактирования.Добавить("Ссылка.Конрагент"); // контрагент
			РеквизитыДляПрямогоРедактирования.Добавить("Ссылка.МенеджерПродаж"); // физ.лица
			РеквизитыДляПрямогоРедактирования.Добавить("Ссылка.ОперативныйМенеджер"); // физ.лица
			РеквизитыДляПрямогоРедактирования.Добавить("Ссылка.ТипПеревозки");
			РеквизитыДляПрямогоРедактирования.Добавить("Ссылка.Комментарий");
			
		КонецЕсли; 
		
		Если (ЭтоФормаЖурналаЗаказов(УФ)) Тогда
			
			РеквизитыДляПрямогоРедактирования.Добавить("Ссылка.ДатаСделкиФ"); // Дата заказа
			РеквизитыДляПрямогоРедактирования.Добавить("Ссылка.Клиент"); // контрагент
			РеквизитыДляПрямогоРедактирования.Добавить("Ссылка.Комментарий");
			РеквизитыДляПрямогоРедактирования.Добавить("Ссылка.МенеджерПродаж"); // физ.лица
			РеквизитыДляПрямогоРедактирования.Добавить("Ссылка.ОперативныйМенеджер"); // физ.лица
			РеквизитыДляПрямогоРедактирования.Добавить("Ссылка.Груз"); // контрагент
			РеквизитыДляПрямогоРедактирования.Добавить("Ссылка.Маршрут");
			РеквизитыДляПрямогоРедактирования.Добавить("Ссылка.ТипПеревозки");  
			
			Если ПолучитьФункциональнуюОпцию("CW_ИспользованиеЗаявок") Тогда    
				ЕстьФлаг = Неопределено;        
				СтруктураРедактируемыхРеквизитов = CW_Грузоперевозки_Сервер.ПолучитьСтруктуруРедактируемыхРеквизитовШапки(Ложь);
				СтруктураРедактируемыхРеквизитов.Свойство("Заявка", ЕстьФлаг);
				ЕстьФлаг = ?(ЕстьФлаг = Неопределено, Истина, ЕстьФлаг);
				Если ЕстьФлаг Тогда
					РеквизитыДляПрямогоРедактирования.Добавить("Ссылка.Заявка"); 
				КонецЕсли;
			КонецЕсли; 
				
		КонецЕсли;		
	КонецЕсли; 
	
	Возврат(РеквизитыДляПрямогоРедактирования);
	
КонецФункции

&НаСервере
Процедура СброситьНастройкиЖурнала(УФ)
	
	Если (ЭтоФормаЖурналаГрузоперевозок(УФ) ИЛИ ЭтоФормаЖурналаЗаявок(УФ) ИЛИ ЭтоФормаЖурналаЗаказов(УФ) ) Тогда
		УФ.Журнал_НастройкаИзменена = Истина;
		УстановитьЗаголовокЖурнала(УФ);
	КонецЕсли; 
	// --- 
    УФ.Журнал_СтруктураНастроек = Новый Структура();
	УФ.Журнал_СтруктураНастроек.Вставить("РежимВыделенияТП","");
	УФ.Журнал_СтруктураНастроек.Вставить("РежимЕкселя", Ложь);
	// --- 
	СписокСтатусов = Новый СписокЗначений;
	СписокСтатусов.ТипЗначения = Новый ОписаниеТипов("СправочникСсылка.CW_ЛогистическиеСтатусы");	
	
	УФ.Журнал_СтруктураНастроек.Вставить("ОтборПоСтатусам", СписокСтатусов);
	// --- 
	СписокФинансовыхСтатусов = Новый СписокЗначений;
	СписокФинансовыхСтатусов.ТипЗначения = Новый ОписаниеТипов("СправочникСсылка.CW_ФинансовыеСтатусы");
    УФ.Журнал_СтруктураНастроек.Вставить("ОтборПоФинансовымСтатусам", СписокФинансовыхСтатусов);
	// --- 
    УФ.Журнал_СтруктураНастроек.Вставить("ОсновнаяНастройка", Неопределено);
	УФ.Журнал_СтруктураНастроек.Вставить("НастройкиКомпоновщика", ПолучитьИзВременногоХранилища(УФ.Журнал_СхемаКомпоновки).НастройкиПоУмолчанию);
	УФ.Журнал_СтруктураНастроек.Вставить("ВысотаШапки",3);
	// --- 
	УФ.Журнал_РежимНастройки = Истина;
	
КонецПроцедуры

&НаСервере
Процедура СформироватьНачальнуюТаблицуКолонок(УФ)
	
	Журнал_ОписаниеКолонок = УФ.Журнал_ОписаниеКолонок;
	
	МассивРеквизитовГрупповогоРедактирования = МассивРеквизитовГрупповогоРедактирования(УФ);
	
	Если (ЭтоФормаЖурналаГрузоперевозок(УФ) ИЛИ ЭтоФормаЗаказа(УФ) ИЛИ ЭтоФормаЗаявки(УФ)) Тогда
		ИмяОбъекта = "Грузоперевозка";
		ТипОбъекта = Новый ОписаниеТипов("СправочникСсылка.CW_Грузоперевозки");
		КоллекцияРеквизитов = Метаданные.Справочники.CW_Грузоперевозки.Реквизиты;
	ИначеЕсли (ЭтоФормаЖурналаЗаявок(УФ)) Тогда 
		ИмяОбъекта = "Заявка";
		ТипОбъекта = Новый ОписаниеТипов("СправочникСсылка.CW_Заявки");
		КоллекцияРеквизитов = Метаданные.Справочники.CW_Заявки.Реквизиты;
	ИначеЕсли (ЭтоФормаЖурналаЗаказов(УФ)) Тогда 
		ИмяОбъекта = "Заказ";
		ТипОбъекта = Новый ОписаниеТипов("СправочникСсылка.CW_Заказы");
		КоллекцияРеквизитов = Метаданные.Справочники.CW_Заказы.Реквизиты;
	КонецЕсли; 
	
	// колонки по умолчанию - видимые реквизиты шапки
	Нстр = Журнал_ОписаниеКолонок.Добавить();
	Нстр.Имя                           = нрег("Ссылка");
	Нстр.Заголовок                     = ИмяОбъекта;
	Нстр.СтрокаПоляКомпоновки          = "Ссылка";
	Нстр.ТипЗначения                   = ТипОбъекта;
	Нстр.Видимость                     = Истина;
    Нстр.РежимПрямогоРедактирования    = Ложь;
	Нстр.КонтрольнаяДатаГрузоперевозки = Ложь;
	Нстр.ПараметрГрузоперевозки        = Ложь;
	Нстр.Ширина                        = 10; 
	Нстр.Фиксация                      = Перечисления.CW_ВариантыФиксацииКолонок.Нет;
	Нстр.Сортировка                    = Перечисления.CW_ПорядокСортировки.Нет;
	
	Для Каждого рекв Из КоллекцияРеквизитов Цикл
		
		Если Найти(рекв.Имя, "удалить") <> 0 Тогда 
			Продолжить;
		КонецЕсли;
		
		Нстр = Журнал_ОписаниеКолонок.Добавить();
		Нстр.Имя                           = нрег("Ссылка" + рекв.Имя);
		Нстр.Заголовок                     = рекв.Синоним;
		Нстр.СтрокаПоляКомпоновки          = "Ссылка." + рекв.Имя;
		Нстр.ТипЗначения                   = рекв.Тип;
		Нстр.Видимость                     = Истина;
        Нстр.РежимПрямогоРедактирования    = (МассивРеквизитовГрупповогоРедактирования.Найти("Ссылка." + рекв.Имя) <> Неопределено);
		Нстр.КонтрольнаяДатаГрузоперевозки = Ложь;
		Нстр.ПараметрГрузоперевозки        = Ложь;
		Нстр.Ширина                        = 10; 
		Нстр.Фиксация                      = Перечисления.CW_ВариантыФиксацииКолонок.Нет;
		Нстр.Сортировка                    = Перечисления.CW_ПорядокСортировки.Нет;
		
	КонецЦикла;
	
	// --- 
	
	// записываем 
	УФ.Журнал_СтруктураНастроек["ОсновнаяНастройка"]=ЗначениеВСтрокуВнутр(УФ.Журнал_ОписаниеКолонок.Выгрузить());
	
КонецПроцедуры

&НаСервере
Функция ПолучитьДоступныеПараметры()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	CW_ПараметрыГрузоперевозок.Ссылка КАК Параметр,
		|	CW_ПараметрыГрузоперевозок.Идентификатор,
		|	ВЫБОР
		|		КОГДА &Группа = ЗНАЧЕНИЕ(Справочник.CW_ГруппыПользователей.Администраторы)
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЕСТЬNULL(CW_ПраваДоступаДляПараметровМониторинга.Просмотр, ЛОЖЬ)
		|	КОНЕЦ КАК Просмотр
		|ПОМЕСТИТЬ ВТ
		|ИЗ
		|	ПланВидовХарактеристик.CW_ПараметрыГрузоперевозок КАК CW_ПараметрыГрузоперевозок
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.CW_ПраваДоступаДляПараметровМониторинга КАК CW_ПраваДоступаДляПараметровМониторинга
		|		ПО (CW_ПраваДоступаДляПараметровМониторинга.Параметр = CW_ПараметрыГрузоперевозок.Ссылка)
		|			И (CW_ПраваДоступаДляПараметровМониторинга.Группа = &Группа)
		|ГДЕ
		|	CW_ПараметрыГрузоперевозок.ЭтоГруппа = ЛОЖЬ
		|	И CW_ПараметрыГрузоперевозок.Предопределенный = ЛОЖЬ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ.Параметр,
		|	ВТ.Идентификатор
		|ИЗ
		|	ВТ КАК ВТ
		|ГДЕ
		|	ВТ.Просмотр = ИСТИНА";
		
	ГруппаПользователя = CW_ПраваДоступа_ПИ.ГруппаПользователя(CW_Настройки.Пользователь());	
	Если (ГруппаПользователя = Неопределено) Тогда
		ГруппаПользователя = Справочники.CW_ГруппыПользователей.ПустаяСсылка();
	КонецЕсли; 
	Если ГруппаПользователя.ПолныеПрава Тогда
		ГруппаПользователя = Справочники.CW_ГруппыПользователей.Администраторы;
	КонецЕсли; 
	Запрос.УстановитьПараметр("Группа", ГруппаПользователя);
	ТЗ = Запрос.Выполнить().Выгрузить();

	Возврат(ТЗ);

КонецФункции	

&НаСервере
Функция ИмяПоляКомпоновкиДанных(Знач ПолеКД) Экспорт 
	// --- 
	
	ИмяПоля=ПолеКД;
	ИмяПоля=_сф.стр_Заменить(ИмяПоля," ","");
	ИмяПоля=_сф.стр_Заменить(ИмяПоля,"(","_");
	ИмяПоля=_сф.стр_Заменить(ИмяПоля,")","_");
	ИмяПоля=_сф.стр_Заменить(ИмяПоля,"[","_");
	ИмяПоля=_сф.стр_Заменить(ИмяПоля,"]","_");
	ИмяПоля=_сф.стр_Заменить(ИмяПоля,".","");
	ИмяПоля=_сф.стр_Заменить(ИмяПоля,",","_");
	ИмяПоля=_сф.стр_Заменить(ИмяПоля,"/","_");
	ИмяПоля=_сф.стр_Заменить(ИмяПоля,"\","_");
	ИмяПоля=_сф.стр_Заменить(ИмяПоля,"!","_");
	ИмяПоля=_сф.стр_Заменить(ИмяПоля,"@","_");
	ИмяПоля=_сф.стр_Заменить(ИмяПоля,"#","_");
	ИмяПоля=_сф.стр_Заменить(ИмяПоля,"№","_");
	ИмяПоля=_сф.стр_Заменить(ИмяПоля,"$","_");
	ИмяПоля=_сф.стр_Заменить(ИмяПоля,";","_");
	ИмяПоля=_сф.стр_Заменить(ИмяПоля,"%","_");
	ИмяПоля=_сф.стр_Заменить(ИмяПоля,"^","_");
	ИмяПоля=_сф.стр_Заменить(ИмяПоля,":","_");
	ИмяПоля=_сф.стр_Заменить(ИмяПоля,"&","_");
	ИмяПоля=_сф.стр_Заменить(ИмяПоля,"?","_");
	ИмяПоля=_сф.стр_Заменить(ИмяПоля,"*","_");
	ИмяПоля=_сф.стр_Заменить(ИмяПоля,"-","_");
	ИмяПоля=_сф.стр_Заменить(ИмяПоля,"+","_");
	ИмяПоля=_сф.стр_Заменить(ИмяПоля,"=","_");
	ИмяПоля=_сф.стр_Заменить(ИмяПоля,"~","_");
	ИмяПоля=_сф.стр_Заменить(ИмяПоля,"|","_");
	
	Возврат(НРег(ИмяПоля));
	
	// --- 
КонецФункции

&НаСервере
Процедура ОбновитьСистемныйОтбор(УФ,ПараметрыСистемногоОтбора=Неопределено) Экспорт 
	
	ОбновлятьОтборПоСтатусам = Истина;
	Если (ПараметрыСистемногоОтбора <> Неопределено) Тогда
		ПараметрыСистемногоОтбора.Свойство("ОбновлятьОтборПоСтатусам",ОбновлятьОтборПоСтатусам);
	КонецЕсли; 
	// --- 
	ОбновлятьОтборПоФинансовымСтатусам = Истина;
	Если (ПараметрыСистемногоОтбора <> Неопределено) Тогда
		ПараметрыСистемногоОтбора.Свойство("ОбновлятьОтборПоФинансовымСтатусам",ОбновлятьОтборПоФинансовымСтатусам);
	КонецЕсли; 
	
	// находим отбор группировки
	ОтборДетальных = УФ.Журнал_КомпоновщикНастроек.Настройки.Структура[0].Отбор;
	ОтборДетальных.Элементы.Очистить();
	
	// отбор по правам доступа и типам перевозок
	// ---------------------------------------------------------------------------- 
	ГруппаПользователя = CW_ПраваДоступа_ПИ.ГруппаПользователя(CW_Настройки.Пользователь());
	Если (ГруппаПользователя = Неопределено) Тогда
		ГруппаПользователя = Справочники.CW_ГруппыПользователей.ПустаяСсылка();
	КонецЕсли; 
	Если (НЕ ГруппаПользователя.Пустая()) Тогда
		
		Если (ЭтоФормаЖурналаГрузоперевозок(УФ) ИЛИ ЭтоФормаЗаказа(УФ) ИЛИ ЭтоФормаЗаявки(УФ)) Тогда
			
			Если (ГруппаПользователя.ФильтрГрузоперевозок) Тогда
				
				Фильтр = ГруппаПользователя.ХранилищеФильтраГрузоперевозок.Получить();
				Если (Фильтр <> Неопределено) Тогда
					
					_УФС.СкопироватьОтбор(Фильтр.Отбор,ОтборДетальных);
					
				КонецЕсли; 
				
			КонецЕсли;
			
		КонецЕсли; 
		Если (ЭтоФормаЖурналаЗаявок(УФ)) Тогда
			
			Если (ГруппаПользователя.ФильтрЗаявок) Тогда
				
				Фильтр = ГруппаПользователя.ХранилищеФильтраЗаявок.Получить();
				Если (Фильтр <> Неопределено) Тогда
					
					_УФС.СкопироватьОтбор(Фильтр.Отбор,ОтборДетальных);
					
				КонецЕсли; 
				
			КонецЕсли;
			
		КонецЕсли; 
		
		Если ЭтоФормаЖурналаЗаказов(УФ) Тогда
			Если ГруппаПользователя.ФильтрЗаказов Тогда
				
				Фильтр = ГруппаПользователя.ХранилищеФильтраЗаказов.Получить();
				Если Фильтр <> Неопределено Тогда
					_УФС.СкопироватьОтбор(Фильтр.Отбор,ОтборДетальных);
				КонецЕсли; 
				
			КонецЕсли;
		КонецЕсли; 
	 
		
		Если (ГруппаПользователя.ОграничениеПоТипамГрузоперевозок) Тогда
			
			Если (ГруппаПользователя.ДоступныеТипыГрузоперевозок.Количество() <> 0) Тогда
				
				// создаем группу
				ГруппаИЛИ = ОтборДетальных.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
				ГруппаИЛИ.ТипГруппы=ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИли;
				ГруппаИЛИ.Использование = Истина;
				
				Для каждого Стр Из ГруппаПользователя.ДоступныеТипыГрузоперевозок Цикл
					НовыйЭлементОтбора = ГруппаИЛИ.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
					НовыйЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Ссылка.ТипПеревозки");
					НовыйЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
					НовыйЭлементОтбора.ПравоеЗначение = Стр.ТипГрузоперевозки;
					НовыйЭлементОтбора.Использование = Истина;
				КонецЦикла; 
				
			КонецЕсли; 
			
		КонецЕсли; 
		
	КонецЕсли; 

	// отбор по переданным грузоперевозкам 
	// ---------------------------------------------------------------------------- 
	Если (УФ.Журнал_РежимВыбора) Тогда
		
		Если (НЕ ЗначениеЗаполнено(УФ.РежимОткрытия)) Тогда
			
			Если (УФ.Журнал_ДоступныеГрузоперевозки.Количество() <> 0) Тогда
				
				НовыйЭлементОтбора = ОтборДетальных.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
				НовыйЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Ссылка");
				НовыйЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке;
				НовыйЭлементОтбора.ПравоеЗначение = УФ.Журнал_ДоступныеГрузоперевозки;
				НовыйЭлементОтбора.Использование = Истина;
				
			КонецЕсли; 	
			
		Иначе
			
			Если (УФ.РежимОткрытия = "ДляБюджета") Тогда
				
				НовыйЭлементОтбора = ОтборДетальных.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
				НовыйЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Ссылка.Заказ");
				НовыйЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
				НовыйЭлементОтбора.ПравоеЗначение = УФ.Журнал_Заказ;
				НовыйЭлементОтбора.Использование = Истина;
				
			КонецЕсли; 
			
		КонецЕсли; 
		
	КонецЕсли; 
	
	Если ЭтоФормаЖурналаГрузоперевозок(УФ) или ЭтоФормаЖурналаЗаказов(УФ) Тогда
		Если УФ.РежимОткрытия = "ОтборПоСписку" Тогда
			Если УФ.Журнал_ДоступныеГрузоперевозки.Количество() <> 0 Тогда
				НовыйЭлементОтбора = ОтборДетальных.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
				НовыйЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Ссылка");
				НовыйЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке;
				НовыйЭлементОтбора.ПравоеЗначение = УФ.Журнал_ДоступныеГрузоперевозки;
				НовыйЭлементОтбора.Использование = Истина;
			КонецЕсли;
			Возврат;
		КонецЕсли;
	КонецЕсли;

	// отбор по статусам
	// ---------------------------------------------------------------------------- 
	Если ОбновлятьОтборПоСтатусам Тогда
		
		// для списка в заказе отбор по статусам не используем
		Если (ЭтоФормаЗаказа(УФ) ИЛИ ЭтоФормаЗаявки(УФ) ИЛИ (УФ.Журнал_РежимВыбора И НЕ ЗначениеЗаполнено(УФ.Журнал_ТекущаяНастройка))) и НЕ ЭтоФормаЖурналаГрузоперевозок(УФ) Тогда
			
			УФ.Журнал_СтруктураНастроек["ОтборПоСтатусам"].Очистить();
			
		КонецЕсли;
		СписокСтатусов =УФ.Журнал_СтруктураНастроек["ОтборПоСтатусам"];
		Если (СписокСтатусов.Количество() <> 0) Тогда
			
			// создаем группу
			ГруппаИЛИ = ОтборДетальных.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
			ГруппаИЛИ.ТипГруппы=ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИли;
			ГруппаИЛИ.Использование = Истина;
			
			Для каждого Стр Из СписокСтатусов Цикл
				НовыйЭлементОтбора = ГруппаИЛИ.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
				НовыйЭлементОтбора.ЛевоеЗначение 	= Новый ПолеКомпоновкиДанных("ЛогистическийСтатус");
				НовыйЭлементОтбора.ВидСравнения 	= ВидСравненияКомпоновкиДанных.Равно;
				НовыйЭлементОтбора.ПравоеЗначение 	= Стр.Значение;
				НовыйЭлементОтбора.Использование 	= Истина;
			КонецЦикла; 
			
		КонецЕсли; 
		
	КонецЕсли; 
	
	// отбор по финансовым статусам
	// ---------------------------------------------------------------------------- 
	Если ОбновлятьОтборПоФинансовымСтатусам Тогда
		
		// для списка в заказе отбор по статусам не используем
		Если (ЭтоФормаЗаказа(УФ) ИЛИ ЭтоФормаЗаявки(УФ) ИЛИ (УФ.Журнал_РежимВыбора И НЕ ЗначениеЗаполнено(УФ.Журнал_ТекущаяНастройка))) и НЕ ЭтоФормаЖурналаГрузоперевозок(УФ)  Тогда
			
			УФ.Журнал_СтруктураНастроек["ОтборПоФинансовымСтатусам"].Очистить();
			
		КонецЕсли;
			
		СписокСтатусов =УФ.Журнал_СтруктураНастроек["ОтборПоФинансовымСтатусам"];
		Если (СписокСтатусов.Количество() <> 0) Тогда
			
			// создаем группу
			ГруппаИЛИ = ОтборДетальных.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
			ГруппаИЛИ.ТипГруппы=ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИли;
			ГруппаИЛИ.Использование = Истина;
			
			Для каждого Стр Из СписокСтатусов Цикл
				НовыйЭлементОтбора = ГруппаИЛИ.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
				НовыйЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ФинансовыйСтатус");
				НовыйЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
				НовыйЭлементОтбора.ПравоеЗначение = Стр.Значение;
				НовыйЭлементОтбора.Использование = Истина;
			КонецЦикла; 
			
		КонецЕсли; 
		
	КонецЕсли; 
		
КонецПроцедуры



