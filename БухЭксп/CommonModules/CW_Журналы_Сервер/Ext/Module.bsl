// СЕАНСОВЫЕ НАСТРОЙКИ

&НаСервере
Функция СохранитьСеансовыеНастройки(УФ, ИмяНастройки) Экспорт 
	
	Настройка = УФ.Журнал_СтруктураНастроек;
	Если (Настройка <> Неопределено) Тогда  
		
		Если Настройка.Свойство("НастройкаСсылка") Тогда
			Настройка.НастройкаСсылка= Неопределено;
		КонецЕсли;
		
		_СохранитьНастройкиЖурнала(УФ);
		// --- 
		Если ЭтоФормаЖурналаГрузоперевозок(УФ) Тогда
			ХранилищеСистемныхНастроек.Сохранить("ОбработкаОбъект.CW_ЖурналГрузоперевозок", ИмяНастройки, Настройка);
		ИначеЕсли (ЭтоФормаЖурналаЗаявок(УФ)) Тогда 
			ХранилищеСистемныхНастроек.Сохранить("ОбработкаОбъект.CW_ЖурналЗаявок", ИмяНастройки, Настройка);
		ИначеЕсли (ЭтоФормаЖурналаЗаказов(УФ)) Тогда 
			ХранилищеСистемныхНастроек.Сохранить("ОбработкаОбъект.CW_ЖурналЗаказов", ИмяНастройки, Настройка);
		ИначеЕсли ЭтоФормаЗаказа(УФ) ИЛИ ЭтоФормаЗаявки(УФ) Тогда
			
			Если ЗначениеЗаполнено(УФ.Объект.ТипПеревозки) Тогда 
				ПараметрыЗаписи = Новый Структура;
				ПараметрыЗаписи.Вставить("Метаданные",	 УФ.Объект.Ссылка.Метаданные());
				ПараметрыЗаписи.Вставить("ТипОбъекта",	 ТипЗнч(УФ.Объект.Ссылка));
				ПараметрыЗаписи.Вставить("ТипПеревозки", УФ.Объект.ТипПеревозки);
				
				РегистрыСведений.CW_НастройкиКолонокЖурналов.ЗаписатьНастройку(ПараметрыЗаписи, Настройка);	
			КонецЕсли; 
		КонецЕсли; 
		
	КонецЕсли; 
	
КонецФункции

&НаСервере
Функция ЗагрузитьСеансовыеНастройки(УФ, Знач ИмяНастройки="ПоследняяНастройка") Экспорт 
	
	Попытка
		Если (ЗначениеЗаполнено(УФ.ИмяСеансовойНастройки)) Тогда
			ИмяНастройки = УФ.ИмяСеансовойНастройки;
		КонецЕсли; 
		// --- 
		Если ЭтоФормаЖурналаГрузоперевозок(УФ) Тогда
			ПоследняяНастройка = ХранилищеСистемныхНастроек.Загрузить("ОбработкаОбъект.CW_ЖурналГрузоперевозок", ИмяНастройки);
		ИначеЕсли (ЭтоФормаЖурналаЗаявок(УФ)) Тогда 
			ПоследняяНастройка = ХранилищеСистемныхНастроек.Загрузить("ОбработкаОбъект.CW_ЖурналЗаявок", ИмяНастройки);
		ИначеЕсли (ЭтоФормаЖурналаЗаказов(УФ)) Тогда 
			ПоследняяНастройка = ХранилищеСистемныхНастроек.Загрузить("ОбработкаОбъект.CW_ЖурналЗаказов", ИмяНастройки);
		ИначеЕсли ЭтоФормаЗаказа(УФ) ИЛИ ЭтоФормаЗаявки(УФ) Тогда
			
			Если ЗначениеЗаполнено(УФ.Объект.ТипПеревозки) Тогда
				ПараметрыЗаписи = Новый Структура;
				ПараметрыЗаписи.Вставить("Метаданные",	 УФ.Объект.Ссылка.Метаданные());
				ПараметрыЗаписи.Вставить("ТипОбъекта",	 ТипЗнч(УФ.Объект.Ссылка));
				ПараметрыЗаписи.Вставить("ТипПеревозки", УФ.Объект.ТипПеревозки);
				
				ПоследняяНастройка = РегистрыСведений.CW_НастройкиКолонокЖурналов.ПолучитьНастройку(ПараметрыЗаписи);
			КонецЕсли;  

			Если ПоследняяНастройка = Неопределено Тогда
				ПоследняяНастройка = ХранилищеСистемныхНастроек.Загрузить("ОбработкаОбъект.CW_ЖурналГрузоперевозок",ИмяНастройки);	
			КонецЕсли;
		КонецЕсли; 

		Возврат(ПоследняяНастройка);
	Исключение
		Сообщить("Ошибка восстановления настроек сеанса!");
		Возврат(Неопределено);
	КонецПопытки; 

КонецФункции

// ---------------------------------------------------------------------------- 
// ИМЕННЫЕ НАСТРОЙКИ

&НаСервере
Процедура СохранитьНастройку_Сервер(УФ, НастройкаСсылка)
	
	УФ.Журнал_ТекущаяНастройка = НастройкаСсылка;
	_СохранитьНастройкиЖурнала(УФ);
	// --- 
	Справочники.CW_НастройкиПользователей.СохранитьНастройку(НастройкаСсылка, УФ.Журнал_СтруктураНастроек);
	// --- 
	Если (ЭтоФормаЖурналаГрузоперевозок(УФ) ИЛИ ЭтоФормаЖурналаЗаявок(УФ) ИЛИ ЭтоФормаЖурналаЗаказов(УФ)) Тогда
		УФ.Журнал_НастройкаИзменена = Ложь;
		УстановитьЗаголовокЖурнала(УФ);
	КонецЕсли; 
	
КонецПроцедуры

&НаСервере
Функция ЗагрузитьНастройку_Сервер(УФ, СтруктураНастройки)
	
	Если (ЭтоФормаЖурналаГрузоперевозок(УФ) ИЛИ ЭтоФормаЖурналаЗаявок(УФ) ИЛИ ЭтоФормаЖурналаЗаказов(УФ)) Тогда
		УФ.Журнал_НастройкаИзменена = Ложь;
		УФ.Журнал_РежимНастройки = Ложь;
	КонецЕсли;
	// --- 
	ЗагрузкаНастроек(УФ,СтруктураНастройки);
	// --- 
	ИнициализацияНастроек(УФ);
	// --- 
	ЭтоФормаЖурнала = (ЭтоФормаЖурналаГрузоперевозок(УФ) ИЛИ ЭтоФормаЖурналаЗаявок(УФ) ИЛИ ЭтоФормаЖурналаЗаказов(УФ));
	Если ЭтоФормаЖурнала Тогда
		ИмяСеансовойНастройки = УФ.ИмяСеансовойНастройки;
	Иначе
		Если (ЭтоФормаЗаказа(УФ)) Тогда
			ИмяСеансовойНастройки = "ПоследняяНастройкаЗаказы";
		ИначеЕсли (ЭтоФормаЗаявки(УФ)) Тогда 
			ИмяСеансовойНастройки = "ПоследняяНастройкаЗаявки";
		Иначе
			ИмяСеансовойНастройки = "ПоследняяНастройкаРезервная";
		КонецЕсли; 
	КонецЕсли; 
	// --- 
	СохранитьСеансовыеНастройки(УФ,ИмяСеансовойНастройки);
	// --- 
	ОбновитьДанные(УФ);
		
КонецФункции

&НаСервере
Процедура _СохранитьНастройкиЖурнала(УФ)
	// --- 
	
	Настройка = УФ.Журнал_СтруктураНастроек;
	// --- 
	ТЗ_ОписаниеКолонок = УФ.Журнал_ОписаниеКолонок.Выгрузить();
	Настройка["ОсновнаяНастройка"] = ЗначениеВСтрокуВнутр(ТЗ_ОписаниеКолонок);
	Настройка["НастройкиКомпоновщика"] = УФ.Журнал_КомпоновщикНастроек.Настройки;
//	_сф.ст_УстановитьСвойство(Настройка,"НастройкаСсылка", УФ.Журнал_ТекущаяНастройка);
	_сф.ст_УстановитьСвойство(Настройка,"КоличествоКолонок", ТЗ_ОписаниеКолонок.Скопировать(Новый Структура("Видимость",Истина)).Количество());
	_сф.ст_УстановитьСвойство(Настройка,"КоличествоСтрок", УФ.Журнал_Данные.Количество());
	Если (ЭтоФормаЖурналаГрузоперевозок(УФ) ИЛИ ЭтоФормаЖурналаЗаявок(УФ) ИЛИ ЭтоФормаЖурналаЗаказов(УФ)) Тогда
		_сф.ст_УстановитьСвойство(Настройка,"ВремяОбновления", УФ.Журнал_ДлительностьОбновленияДанных);	
	КонецЕсли; 
	
	// --- 
КонецПроцедуры
 

