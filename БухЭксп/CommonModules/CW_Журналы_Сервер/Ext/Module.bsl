// НАСТРОЙКА СПИСКА

&НаСервере
Функция ПараметрыФормыНастройкиСписка(УФ)
	
	// открываем форму настройки списка
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("АдресСНЖ", ПолучитьАдресНастроекСписка(УФ));
	ПараметрыФормы.Вставить("СхемаКомпоновки",УФ.Журнал_СхемаКомпоновки);
	Возврат(_УФКС.СД("Журналы","клиент","/НастройкаСписка",ПараметрыФормы));
	
КонецФункции

&НаСервере
Функция ПолучитьАдресНастроекСписка(УФ)
	
	УФ.Журнал_СтруктураНастроек["ОсновнаяНастройка"] = ЗначениеВСтрокуВнутр(УФ.Журнал_ОписаниеКолонок.Выгрузить());
	// --- 
	СтруктураНастройки = Новый Структура;
	СтруктураНастройки.Вставить("СтруктураНастроек", УФ.Журнал_СтруктураНастроек);
	// --- 
	Возврат(ПоместитьВоВременноеХранилище(СтруктураНастройки, УФ.УникальныйИдентификатор));
	
КонецФункции

&НаСервере
Функция ВосстановитьНастройкуСписка(УФ, Адрес)
	
		
	Настройка = ПолучитьИзВременногоХранилища(Адрес);
	
	УФ.Журнал_ОписаниеКолонок.Загрузить(ЗначениеИзСтрокиВнутр(Настройка["ОсновнаяНастройка"]));
	УФ.Журнал_СтруктураНастроек["ОсновнаяНастройка"] = ЗначениеВСтрокуВнутр(УФ.Журнал_ОписаниеКолонок.Выгрузить());
	// --- 
	УФ.Журнал_СтруктураНастроек["ВысотаШапки"]= Настройка["ВысотаШапки"];
	УФ.Журнал_ТекущаяНастройка = Неопределено;
	// --- 	
	ОбновитьКолонки(УФ);
	ОбновитьСистемныйОтбор(УФ);
	ОбновитьРежимЕкселя(УФ);
	// --- 
	УстановитьЗаголовокЖурнала(УФ);
	
	Если (НЕ УФ.Журнал_РежимНастройки) Тогда
		ОбновитьДанные(УФ);
	КонецЕсли; 
	
	Возврат(Неопределено);
	
КонецФункции

