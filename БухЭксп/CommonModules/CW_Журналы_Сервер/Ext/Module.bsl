&НаСервере
Функция ДобавитьДинамическийПараметр(УФ,Параметры)
	
	Параметр = Параметры.Параметр;
	Грузоперевозки = Параметры.Грузоперевозки;
	
	Если ЭтоФормаЖурналаЗаявок(УФ) Тогда
		ИмяТаблицы = "ПараметрыЗаявки";
	ИначеЕсли ЭтоФормаЖурналаЗаказов(УФ) Тогда
		ИмяТаблицы = "ПараметрыЗаказа";
	ИначеЕсли ЭтоФормаЖурналаГрузоперевозок(УФ) Тогда
		ИмяТаблицы = "ПараметрыГрузоперевозки";
	КонецЕсли;
	
	Попытка
		
		Для каждого ГП Из Грузоперевозки Цикл
			
			Отбор = Новый Структура("Параметр",Параметр);
			СтрокаПараметра = _сф.к_НайтиСтроку(ГП[ИмяТаблицы],Отбор);
			Если (СтрокаПараметра = Неопределено) Тогда
				
				ГПО = ГП.ПолучитьОбъект();
				// ---    
				Нстр = ГПО[ИмяТаблицы].Добавить(); // 05.12.22 Колмаков
                //Нстр = ГПО.ПараметрыГрузоперевозки.Добавить();
				Нстр.Параметр = Параметр;
				// --- 
				ГПО.Записать();
				
			КонецЕсли; 
			
		КонецЦикла; 	
		
	Исключение
		Возврат(_УФКС.СД("Журналы","клиент","/Предупреждение","Ошибка добавления динамического параметра: "+ОписаниеОшибки()));
	КонецПопытки; 
	
	Возврат(_УФКС.СД("Журналы","сервер","/ОбновитьДанные",Грузоперевозки));
	
	// --- 
КонецФункции

&НаСервере
Функция УдалитьДинамическийПараметр(УФ,Параметры)
	
	Параметр = Параметры.Параметр;
	Грузоперевозки = Параметры.Грузоперевозки;
	
	Если ЭтоФормаЖурналаЗаявок(УФ) Тогда
		ИмяТаблицы = "ПараметрыЗаявки";
	ИначеЕсли ЭтоФормаЖурналаЗаказов(УФ) Тогда
		ИмяТаблицы = "ПараметрыЗаказа";
	ИначеЕсли ЭтоФормаЖурналаГрузоперевозок(УФ) Тогда
		ИмяТаблицы = "ПараметрыГрузоперевозки";
	КонецЕсли;
	
	Попытка
		
		Для каждого ГП Из Грузоперевозки Цикл
			
			Отбор = Новый Структура("Параметр",Параметр);
			СтрокаПараметра = _сф.к_НайтиСтроку(ГП[ИмяТаблицы],Отбор);
			Если (СтрокаПараметра <> Неопределено) Тогда
				
				ГПО = ГП.ПолучитьОбъект();
				// --- 
				Нстр = _сф.к_НайтиСтроку(ГПО[ИмяТаблицы],Отбор);
				ГПО[ИмяТаблицы].Удалить(Нстр);
				// --- 
				ГПО.Записать();
				
			КонецЕсли; 
			
		КонецЦикла; 	
		
	Исключение
		Возврат(_УФКС.СД("Журналы","клиент","/Предупреждение","Ошибка удаления динамического параметра: "+ОписаниеОшибки()));
	КонецПопытки; 
	
	Возврат(_УФКС.СД("Журналы","сервер","/ОбновитьДанные",Грузоперевозки));
	
	// --- 
КонецФункции
 
&НаСервере
Функция ПересчитатьДинамическиеПараметры(УФ,Параметры)
	// --- 
	
	Попытка
		
		// перезаписываем текущие грузоперевозки
		Для каждого Стр Из УФ.Журнал_Данные Цикл
			
			ГП = Стр.Ссылка.ПолучитьОбъект();
			ГП.Записать();
			
		КонецЦикла; 
		
	Исключение
		
		ОписаниеОшибкиПересчета = "Ошибка пересчета для грузоперевозки "+Строка(Стр.Ссылка)+": "+ОписаниеОшибки();
		Возврат(_УФКС.СД("Журналы","клиент","/Предупреждение",ОписаниеОшибкиПересчета));
		
	КонецПопытки; 
	
	Возврат(_УФКС.СД("Журналы","сервер","/Обновить"));
	
	// --- 
КонецФункции
 
&НаСервере
Функция ТолькоПросмотрПараметра(Параметр) Экспорт
	ТолькоПросмотр = Истина;
	
	НаборПрав = CW_ПраваДоступа.НаборПравДляПараметров();
	
	
	Попытка
		ТолькоПросмотр = (НЕ НаборПрав["п_"+_сф.КлючПоСсылке(Параметр)].Редактирование);
	Исключение
		ТолькоПросмотр = Истина;
	КонецПопытки; 
	
	Возврат ТолькоПросмотр;
	
КонецФункции


&НаСервере
Функция АдресОбъекта(ТекущийОбъект, УникальныйИдентификатор) Экспорт
	
	ИмяТЧ = CW_Мониторинг.ТабличнаяЧастьПараметровОбъекта(ТекущийОбъект);
	
	ТаблицаПараметров = ТекущийОбъект[ИмяТЧ].Выгрузить();

	СтруктураОбъекта = Новый Структура;
	СтруктураОбъекта.Вставить("Ссылка", 			ТекущийОбъект);
	СтруктураОбъекта.Вставить("ТаблицаПараметров", 	ТаблицаПараметров); 
	
	Возврат(ПоместитьВоВременноеХранилище(СтруктураОбъекта,УникальныйИдентификатор));
	
КонецФункции

&НаСервере
Функция ПолучитьСсылкиВыделенныхСтрок(ФормаОбъета, Знач ВыделенныеСтроки) Экспорт
	
	МассивСсылок = Новый Массив;
	Для Каждого Идентификатор из ВыделенныеСтроки Цикл
		СтрокаЖурнала = ФормаОбъета.Журнал_Данные.НайтиПоИдентификатору(Идентификатор);		
		МассивСсылок.Добавить(СтрокаЖурнала.Ссылка);
	КонецЦикла;
	
	Возврат МассивСсылок;
	
КонецФункции

Функция ИмяТаблицыПоОписаниюТипов(ОписаниеТипов) Экспорт
	
	ТипРеквизита 	= ОписаниеТипов.Типы()[0];
	Метаданное 		= Метаданные.НайтиПоТипу(ТипРеквизита);
	
	ИмяТаблицы 	= "";
	Если Метаданное <> Неопределено тогда  
		ИмяТаблицы 	= Метаданное.ПолноеИмя();
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("ИмяТаблицы", 	ИмяТаблицы);
	Результат.Вставить("ТипРеквизита", 	ТипРеквизита);
	
	Возврат Результат;
	
КонецФункции

