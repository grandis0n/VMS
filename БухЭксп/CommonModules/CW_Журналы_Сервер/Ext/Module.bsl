&НаСервере
Функция ПодключитьГрузоперевозки(УФ,МассивСсылок)

	НачатьТранзакцию();
	
	// сразу заблокируем все требуемые Грузоперевозки
	з = Новый Запрос(
		"ВЫБРАТЬ
		|	CW_Грузоперевозки.Ссылка
		|ИЗ
		|	Справочник.CW_Грузоперевозки КАК CW_Грузоперевозки
		|ГДЕ
		|	CW_Грузоперевозки.Ссылка В(&МассивСсылок)
		|
		|ДЛЯ ИЗМЕНЕНИЯ
		|	Справочник.CW_Грузоперевозки"
	);
	з.УстановитьПараметр("МассивСсылок", МассивСсылок);
	рз = з.Выполнить();
	выб = рз.Выбрать();
	Пока выб.Следующий() Цикл
		об = выб.Ссылка.ПолучитьОбъект();
		об.Заказ = УФ.Объект.Ссылка;
		об.Записать();
	КонецЦикла;
	
	ЗафиксироватьТранзакцию();

	// ---------------------------------------------------------------------------- 
	
	МД = Новый Массив();
	МД.Добавить(_УФКС.СД("Грузоперевозки","сервер","/БюджетОбновить"));
	МД.Добавить(_УФКС.СД("Журналы","сервер","/ОбновитьДанные",МассивСсылок));
	Возврат(МД);

КонецФункции

