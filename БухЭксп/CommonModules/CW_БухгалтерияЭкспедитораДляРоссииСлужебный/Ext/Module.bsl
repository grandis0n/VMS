Процедура УстановитьПрофилиДоступаДляПолныхПрав(АдресРезультата=Неопределено) Экспорт
	
	Справочники.CW_ГруппыПользователей.УстановитьЗначениеИстинаДляПолныхПрав();
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	CW_ГруппыПользователей.Ссылка КАК Ссылка,
	|	CW_ГруппыПользователей.РеестрыНДС0 КАК РеестрыНДС0,
	|	CW_ГруппыПользователей.ДоходыНерезидентов КАК ДоходыНерезидентов,
	|	CW_ГруппыПользователей.ОбменС1СЭПД КАК ОбменС1СЭПД
	|ИЗ
	|	Справочник.CW_ГруппыПользователей КАК CW_ГруппыПользователей
	|ГДЕ
	|	CW_ГруппыПользователей.ПолныеПрава = ИСТИНА";  
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл    
		
		ПараметрыПроцедуры = Новый Структура;
		ПараметрыПроцедуры.Вставить("ГруппаПользователей", 	Выборка.Ссылка);
		ПараметрыПроцедуры.Вставить("РеестрыНДС0",			Выборка.РеестрыНДС0);
		ПараметрыПроцедуры.Вставить("ДоходыНерезидентов",	Выборка.ДоходыНерезидентов);
		ПараметрыПроцедуры.Вставить("ОбменС1СЭПД", 			Выборка.ОбменС1СЭПД);
		
		Справочники.CW_ГруппыПользователей.ОбновитьПрофилиПользователей(ПараметрыПроцедуры);
		
	КонецЦикла;
	
КонецПроцедуры