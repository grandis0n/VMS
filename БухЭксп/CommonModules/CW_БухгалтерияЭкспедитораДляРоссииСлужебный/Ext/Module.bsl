Процедура ПриДобавленииОбработчиковОбновления(Обработчики) Экспорт  
	
	ДобавитьПроцедурыОбновления(Обработчики);
	
	//"CW_РеестрыНДС0"
	Модуль_CW_РеестрыНДС0Служебный = CW_ОбщегоНазначения.ОбщийМодуль("CW_РеестрыНДС0Служебный");
	Если Модуль_CW_РеестрыНДС0Служебный <> Неопределено Тогда
		Модуль_CW_РеестрыНДС0Служебный.ПриДобавленииОбработчиковОбновления(Обработчики);
	КонецЕсли; 
	//"CW_РеестрыНДС0"    
	
	//CW_ДоходыНерезидентов
	Модуль_CW_ДоходыНерезидентовСлужебный = CW_ОбщегоНазначения.ОбщийМодуль("CW_ДоходыНерезидентовСлужебный");
	Если Модуль_CW_ДоходыНерезидентовСлужебный <> Неопределено Тогда
		Модуль_CW_ДоходыНерезидентовСлужебный.ПриДобавленииОбработчиковОбновления(Обработчики);
	КонецЕсли; 
	//CW_ДоходыНерезидентов 
	
	//CW_ОбменГИСЭПД
	Модуль_CW_ОбменГИСЭПДСлужебный = CW_ОбщегоНазначения.ОбщийМодуль("CW_ОбменГИСЭПДСлужебный");
	Если Модуль_CW_ОбменГИСЭПДСлужебный <> Неопределено Тогда
		Модуль_CW_ОбменГИСЭПДСлужебный.ПриДобавленииОбработчиковОбновления(Обработчики);
	КонецЕсли; 
	//CW_ОбменГИСЭПД 	
	
КонецПроцедуры


