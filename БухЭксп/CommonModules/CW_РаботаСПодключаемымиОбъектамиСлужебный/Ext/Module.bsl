Процедура ОбновитьСведенияОПодключаемыхОбъектах(АдресРезультата=Неопределено) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	CW_ПодключаемыеОбъекты.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.CW_ПодключаемыеОбъекты КАК CW_ПодключаемыеОбъекты
	               |ГДЕ
	               |	CW_ПодключаемыеОбъекты.ПометкаУдаления = ЛОЖЬ
	               |	И CW_ПодключаемыеОбъекты.ТипВнешнегоОбъекта = Значение(Перечисление.CW_ТипыПодключаемыхОбъектов.ВнешняяОбработка)
	               |	И CW_ПодключаемыеОбъекты.Вид = &Вид
	               |	И CW_ПодключаемыеОбъекты.Встроенная = ИСТИНА";
	
	ВидОбъекта = CW_ПодключаемыеКомандыСервер.ВидОбработкиПечатнаяФорма();
	Запрос.УстановитьПараметр("Вид", ВидОбъекта);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Попытка
			Обработка 		  = _ПО.ПолучитьОбработку(Выборка.Ссылка);
			СтруктураОписания = Обработка.Информация();
		Исключение
			Продолжить;
		КонецПопытки;
		
		ТОбъект	= Выборка.Ссылка.ПолучитьОбъект();
		_ПО.ЗаполнитьИнформациюПоОбработке(ТОбъект,СтруктураОписания);
		
		ТОбъект.ОбменДанными.Загрузка = Истина;
		ТОбъект.Записать();

	КонецЦикла;
	
КонецПроцедуры

Процедура ОбновитьПредставлениеВидаОбработки(АдресРезультата=Неопределено) Экспорт

	Справочники.CW_ПодключаемыеОбъекты.ОбновитьПредставлениеВидаОбработки();
	
