//Обязательные процедуры при переходе на каждый релиз
Процедура ВыполнитьПовторноеПодклчюениеВстроенныхОбработокИОтчетов(АдресРезультата=Неопределено) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	CW_ПодключаемыеОбъекты.Ссылка КАК Ссылка,
	               |	CW_ПодключаемыеОбъекты.Встроенная КАК Встроенная
	               |ИЗ
	               |	Справочник.CW_ПодключаемыеОбъекты КАК CW_ПодключаемыеОбъекты
	               |ГДЕ
	               |	CW_ПодключаемыеОбъекты.ПометкаУдаления = ЛОЖЬ
	               |	И CW_ПодключаемыеОбъекты.НеИспользуется = ЛОЖЬ";
	
	РезультатЗапроса = запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	СобытияДляЖурналаРегистрации = Новый СписокЗначений;
	
	Пока Выборка.Следующий() Цикл
		
		ОбработкаОбъект = Выборка.Ссылка.ПолучитьОбъект();
	
		Попытка
			
			Если Выборка.Встроенная Тогда
				
				//нужно просто перезаписать с ключем "ВыполнитьРегистрацию" 
				ОбработкаОбъект.ДополнительныеСвойства.Вставить("ВыполнитьРегистрацию" , Истина);
				ОбработкаОбъект.ДополнительныеСвойства.Вставить("НеПоказыватьСообщения", Истина);
				ОбработкаОбъект.Записать();
				
			Иначе
				
				ОбработкаОбъект.ДополнительныеСвойства.Вставить("НеПоказыватьСообщения", Истина);
				ОбработкаОбъект.Записать();
				
			КонецЕсли;
			
			Если ОбработкаОбъект.Вид = "ВнешняяКоманда" Тогда
				//Обновим регистрацию
				Справочники.CW_ПодключаемыеОбъекты.ЗарегистрироватьВнешниеКоманды(ОбработкаОбъект.Ссылка);
			КонецЕсли;
			
		Исключение
			
			ОбработкаОбъект.ДополнительныеСвойства.Вставить("ВыполнитьРегистрацию"	, Ложь);
			ОбработкаОбъект.ДополнительныеСвойства.Вставить("НеПоказыватьСообщения"	, Истина);
			ОбработкаОбъект.НеИспользуется = Истина;
			ОбработкаОбъект.Записать();
			
		КонецПопытки;
		
	КонецЦикла;
	
КонецПроцедуры

