Процедура ВыполнитьПодклчениеВстроенныхПечатныхФорм(АдресРезультата=Неопределено) Экспорт
	
	МассивПФДляПроверки = Новый Массив;
	МассивПФДляПроверки.Добавить("CW_ПФ_СчетДоходы");
	МассивПФДляПроверки.Добавить("CW_ПФ_АктДоходы");
	МассивПФДляПроверки.Добавить("CW_ПФ_СФДоходы");
	МассивПФДляПроверки.Добавить("CW_ПФ_ОтчетЭкспедитора");
	МассивПФДляПроверки.Добавить("CW_ПФ_Док_ОтчетЭкспедитора");
	МассивПФДляПроверки.Добавить("CW_ПФ_АктРасходы");
	МассивПФДляПроверки.Добавить("CW_ПФ_СчетРасходы");
	МассивПФДляПроверки.Добавить("CW_ПФ_ПутевойЛист4П");
	МассивПФДляПроверки.Добавить("CW_ПФ_ПутевойЛист4С");
	
	ПодключитьВстроенныеПечатныеФормыИОбъекты(МассивПФДляПроверки);   
	
КонецПроцедуры

Процедура ПодключитьВстроенныеПечатныеФормыИОбъекты(МассивПодключаемыхОбъектов)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	CW_ПодключаемыеОбъекты.Ссылка КАК Ссылка,
	|	CW_ПодключаемыеОбъекты.ИмяВстроеннойОбработки КАК ИмяВстроеннойОбработки
	|ИЗ
	|	Справочник.CW_ПодключаемыеОбъекты КАК CW_ПодключаемыеОбъекты
	|ГДЕ
	|	CW_ПодключаемыеОбъекты.Встроенная
	|	И НЕ CW_ПодключаемыеОбъекты.ПометкаУдаления
	|	И CW_ПодключаемыеОбъекты.НеИспользуется = ЛОЖЬ";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Индекс = МассивПодключаемыхОбъектов.Найти(Выборка.ИмяВстроеннойОбработки);
		Если Индекс <> Неопределено Тогда
			МассивПодключаемыхОбъектов.Удалить(Индекс);
		КонецЕсли; 
	КонецЦикла; 
	
	Для каждого ИмяОбработки Из МассивПодключаемыхОбъектов Цикл
		
		ПФОбъект = Справочники.CW_ПодключаемыеОбъекты.СоздатьЭлемент();
		ПФОбъект.Встроенная 			= Истина;
		ПФОбъект.ИмяВстроеннойОбработки = ИмяОбработки;
		ПФОбъект.ДополнительныеСвойства.Вставить("ВыполнитьРегистрацию", истина);
		ПФОбъект.Записать();
		
	КонецЦикла; 
	
КонецПроцедуры
