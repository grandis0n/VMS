	|УНИЧТОЖИТЬ ВТ_АналитикаМаксимальныйСчет
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ВТ_ОстаткиПоСчетамУчетаЗаПериод
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ВТ_РасчетныеОбороты";

	Если ПараметрыАвансовПоВидамАктивов <> Неопределено И ПараметрыАвансовПоВидамАктивов.РазделятьАвансыПоВидамАктивов Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса,
			"&РазделятьАвансыПоВидамАктивов",
			"ВЫБОР КОГДА ОстаткиЗаПериод.СчетРасчетов В (&СчетаУчетаАвансов) ТОГДА НЕ ОстаткиЗаПериод.ВидАктива В(&ИсключаемыеВидыАктивовАвансов) ИНАЧЕ ИСТИНА КОНЕЦ");
		Запрос.УстановитьПараметр("ИсключаемыеВидыАктивовАвансов", ПараметрыАвансовПоВидамАктивов.ИсключаемыеВидыАктивовАвансов);
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса,
			"&РазделятьАвансыПоВидамАктивов",
			"ИСТИНА");
	КонецЕсли;

	Запрос.Текст = ТекстЗапроса;
	
	Запрос.Выполнить();
	
КонецПроцедуры

Процедура СоздатьВременныеТаблицыОстаткиОборотыПроцентовПоРассрочке(МенеджерВременныхТаблиц, КонтекстЗаполненияОтчета)

	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("Организации", КонтекстЗаполненияОтчета.Организации);
	Запрос.УстановитьПараметр("НачалоПериода", КонтекстЗаполненияОтчета.Период.Начало);
	Запрос.УстановитьПараметр("КонецПериода", КонтекстЗаполненияОтчета.Период.Конец);
	Запрос.УстановитьПараметр("СчетаПроцентовПоРассрочке", ПланыСчетов.Хозрасчетный.СчетаПроцентовПоРассрочке());
	
	СубконтоКонтрагентыДоговоры = Новый Массив;
	СубконтоКонтрагентыДоговоры.Добавить(ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.Контрагенты);
	СубконтоКонтрагентыДоговоры.Добавить(ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.Договоры);
	Запрос.УстановитьПараметр("СубконтоКонтрагентыДоговоры", СубконтоКонтрагентыДоговоры);
	
	Запрос.УстановитьПараметр("ПустойУникальныйИдентификатор", ОбщегоНазначенияКлиентСервер.ПустойУникальныйИдентификатор());

	Запрос.Текст =
	"ВЫБРАТЬ
	|	ХозрасчетныйОбороты.Организация КАК Организация,
	|	ХозрасчетныйОбороты.Субконто1 КАК Контрагент,
	|	ХозрасчетныйОбороты.Субконто2 КАК Договор,
	|	СУММА(ХозрасчетныйОбороты.СуммаОборотДт) КАК ПоступилоПроценты,
	|	СУММА(ХозрасчетныйОбороты.СуммаОборотКт) КАК ПогашеноПроценты,
	|	СУММА(ВЫБОР
	|			КОГДА ХозрасчетныйОбороты.СуммаОборотДт > 0
	|					И ХозрасчетныйОбороты.СуммаОборотКт > 0
	|				ТОГДА ВЫБОР
	|						КОГДА ХозрасчетныйОбороты.СуммаОборотКт < ХозрасчетныйОбороты.СуммаОборотДт
	|							ТОГДА ХозрасчетныйОбороты.СуммаОборотКт
	|						ИНАЧЕ ХозрасчетныйОбороты.СуммаОборотДт
	|					КОНЕЦ
	|			ИНАЧЕ ВЫБОР
	|					КОГДА ХозрасчетныйОбороты.СуммаОборотДт < 0
	|							И ХозрасчетныйОбороты.СуммаОборотКт < 0
	|						ТОГДА ВЫБОР
	|								КОГДА ХозрасчетныйОбороты.СуммаОборотКт > ХозрасчетныйОбороты.СуммаОборотДт
	|									ТОГДА ХозрасчетныйОбороты.СуммаОборотКт
	|								ИНАЧЕ ХозрасчетныйОбороты.СуммаОборотДт
	|							КОНЕЦ
	|					ИНАЧЕ 0
	|				КОНЕЦ
	|		КОНЕЦ) КАК Вычет
	|ПОМЕСТИТЬ ВТ_Обороты
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный.Обороты(&НачалоПериода, &КонецПериода, , Счет В (&СчетаПроцентовПоРассрочке), &СубконтоКонтрагентыДоговоры, , , ) КАК ХозрасчетныйОбороты
	|
	|СГРУППИРОВАТЬ ПО
	|	ХозрасчетныйОбороты.Организация,
	|	ХозрасчетныйОбороты.Субконто1,
	|	ХозрасчетныйОбороты.Субконто2
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПроцентыПоРассрочкеЗаПериод.Организация КАК Организация,
	|	ВЫБОР
	|		КОГДА ПроцентыПоРассрочкеЗаПериод.СчетРасчетов В (&СчетаПроцентовПоРассрочке)
	|			ТОГДА ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ПроцентыПоРассрочке)
	|		ИНАЧЕ ПроцентыПоРассрочкеЗаПериод.СчетРасчетов
	|	КОНЕЦ КАК СчетРасчетов,
	|	ПроцентыПоРассрочкеЗаПериод.СчетРасчетов В (&СчетаПроцентовПоРассрочке) КАК ЭтоСчетПроцентов,
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(ПроцентыПоРассрочкеЗаПериод.Субконто1) = ТИП(Справочник.Контрагенты)
	|			ТОГДА ПроцентыПоРассрочкеЗаПериод.Субконто1
	|		КОГДА ТИПЗНАЧЕНИЯ(ПроцентыПоРассрочкеЗаПериод.Субконто2) = ТИП(Справочник.Контрагенты)
	|			ТОГДА ПроцентыПоРассрочкеЗаПериод.Субконто2
	|		КОГДА ТИПЗНАЧЕНИЯ(ПроцентыПоРассрочкеЗаПериод.Субконто3) = ТИП(Справочник.Контрагенты)
	|			ТОГДА ПроцентыПоРассрочкеЗаПериод.Субконто3
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	|	КОНЕЦ КАК Контрагент,
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(ПроцентыПоРассрочкеЗаПериод.Субконто1) = ТИП(Справочник.ДоговорыКонтрагентов)
	|			ТОГДА ПроцентыПоРассрочкеЗаПериод.Субконто1
	|		КОГДА ТИПЗНАЧЕНИЯ(ПроцентыПоРассрочкеЗаПериод.Субконто2) = ТИП(Справочник.ДоговорыКонтрагентов)
	|			ТОГДА ПроцентыПоРассрочкеЗаПериод.Субконто2
	|		КОГДА ТИПЗНАЧЕНИЯ(ПроцентыПоРассрочкеЗаПериод.Субконто3) = ТИП(Справочник.ДоговорыКонтрагентов)
	|			ТОГДА ПроцентыПоРассрочкеЗаПериод.Субконто3
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ДоговорыКонтрагентов.ПустаяСсылка)
	|	КОНЕЦ КАК Договор,
	|	ПроцентыПоРассрочкеЗаПериод.БолееГода КАК БолееГода,
	|	СУММА(ПроцентыПоРассрочкеЗаПериод.НачалоПроценты) КАК НачалоПроценты,
	|	СУММА(ПроцентыПоРассрочкеЗаПериод.КонецПроценты) КАК КонецПроценты
	|ПОМЕСТИТЬ ВТ_Остатки
	|ИЗ
	|	(ВЫБРАТЬ
	|		Проценты.Организация КАК Организация,
	|		Проценты.СчетРасчетов КАК СчетРасчетов,
	|		Проценты.Субконто1 КАК Субконто1,
	|		Проценты.Субконто2 КАК Субконто2,
	|		Проценты.Субконто3 КАК Субконто3,
	|		Проценты.БолееГода КАК БолееГода,
	|		Проценты.Сальдо КАК НачалоПроценты,
	|		0 КАК КонецПроценты
	|	ИЗ
	|		ПроцентыНачало КАК Проценты
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		Проценты.Организация,
	|		Проценты.СчетРасчетов,
	|		Проценты.Субконто1,
	|		Проценты.Субконто2,
	|		Проценты.Субконто3,
	|		Проценты.БолееГода,
	|		0,
	|		Проценты.Сальдо
	|	ИЗ
	|		ПроцентыКонец КАК Проценты) КАК ПроцентыПоРассрочкеЗаПериод
	|
	|СГРУППИРОВАТЬ ПО
	|	ПроцентыПоРассрочкеЗаПериод.Организация,
	|	ВЫБОР
	|		КОГДА ПроцентыПоРассрочкеЗаПериод.СчетРасчетов В (&СчетаПроцентовПоРассрочке)
	|			ТОГДА ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ПроцентыПоРассрочке)
	|		ИНАЧЕ ПроцентыПоРассрочкеЗаПериод.СчетРасчетов
	|	КОНЕЦ,
	|	ПроцентыПоРассрочкеЗаПериод.СчетРасчетов В (&СчетаПроцентовПоРассрочке),
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(ПроцентыПоРассрочкеЗаПериод.Субконто1) = ТИП(Справочник.Контрагенты)
	|			ТОГДА ПроцентыПоРассрочкеЗаПериод.Субконто1
	|		КОГДА ТИПЗНАЧЕНИЯ(ПроцентыПоРассрочкеЗаПериод.Субконто2) = ТИП(Справочник.Контрагенты)
	|			ТОГДА ПроцентыПоРассрочкеЗаПериод.Субконто2
	|		КОГДА ТИПЗНАЧЕНИЯ(ПроцентыПоРассрочкеЗаПериод.Субконто3) = ТИП(Справочник.Контрагенты)
	|			ТОГДА ПроцентыПоРассрочкеЗаПериод.Субконто3
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(ПроцентыПоРассрочкеЗаПериод.Субконто1) = ТИП(Справочник.ДоговорыКонтрагентов)
	|			ТОГДА ПроцентыПоРассрочкеЗаПериод.Субконто1
	|		КОГДА ТИПЗНАЧЕНИЯ(ПроцентыПоРассрочкеЗаПериод.Субконто2) = ТИП(Справочник.ДоговорыКонтрагентов)
	|			ТОГДА ПроцентыПоРассрочкеЗаПериод.Субконто2
