		Описание = СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(ШаблонОписания, ПараметрыТекстов);
		ЗаполнениеБухгалтерскойОтчетностиТабличное.ДобавитьСлагаемое(ВыводТаблицы, ИмяКолонки, Описание, Значение, , ОтчетОСВ);
	КонецЕсли;
	
	Значение = - СтрокаПроценты.ВычетПогашеноПроценты;
	Если Значение <> 0 Тогда
		ШаблонОписания = НСтр("ru = 'Исключен кредитовый оборот по [СчетуПроцентовПоРассрочке] в пределах дебетового оборота по объектам, учитываемым на счете [Счет]'");
		Если БезОбъектовУчета Тогда
			ШаблонОписания = НСтр("ru = 'Исключен кредитовый оборот по [СчетуПроцентовПоРассрочке], уменьшенный на величины, выделенные по объектам учета, в пределах кредитового оборота'");
		КонецЕсли;
		Описание = СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(ШаблонОписания, ПараметрыТекстов);
		ЗаполнениеБухгалтерскойОтчетностиТабличное.ДобавитьСлагаемое(ВыводТаблицы, ИмяКолонки, Описание, Значение, , ОтчетОСВ);
	КонецЕсли;
	
	ИмяКолонки = "Переклассифицировано";
	Значение = - СтрокаПроценты.ПереклассифицированоПроценты;
	Если Значение <> 0 Тогда
		ИмяКолонки = "Переклассифицировано";
		ШаблонОписания = НСтр("ru = 'Проценты по рассрочке: сальдо по [СчетуПроцентовПоРассрочке] по объектам, учитываемым на счете [Счет]'");
		Если БезОбъектовУчета Тогда
			ШаблонОписания = НСтр("ru = 'Проценты по рассрочке: сальдо по [СчетуПроцентовПоРассрочке], уменьшенное на величины, выделенные по объектам учета'");
		КонецЕсли;
		Описание = СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(ШаблонОписания, ПараметрыТекстов);
		ЗаполнениеБухгалтерскойОтчетностиТабличное.ДобавитьСлагаемое(ВыводТаблицы, ИмяКолонки, Описание, Значение);
	КонецЕсли;
	
	ИмяКолонки = "КонецНоминал";
	Значение = - СтрокаПроценты.КонецПроценты;
	Если Значение <> 0 Тогда
		ИмяКолонки = "КонецНоминал";
		ШаблонОписания = НСтр("ru = 'Проценты по рассрочке: сальдо по [СчетуПроцентовПоРассрочке] по объектам, учитываемым на счете [Счет]'");
		Если БезОбъектовУчета Тогда
			ШаблонОписания = НСтр("ru = 'Проценты по рассрочке: сальдо по [СчетуПроцентовПоРассрочке], уменьшенное на величины, выделенные по объектам учета'");
		КонецЕсли;
		
		ОтчетСчета = ОтчетОСВ;
		Если КлассифицироватьАктивыОбязательстваПериоды.Конец Тогда
			ОтчетСчета = НастройкиРасшифровкиСправкиРасчетаКлассификацииЗадолженности(СтрокаПроценты.Организация, КонецПериода, СтрокаПроценты);
		КонецЕсли;
		Описание = СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(ШаблонОписания, ПараметрыТекстов);
		ЗаполнениеБухгалтерскойОтчетностиТабличное.ДобавитьСлагаемое(ВыводТаблицы, ИмяКолонки, Описание, Значение, , ОтчетСчета);
	КонецЕсли;

КонецПроцедуры

Процедура ДобавитьСлагаемоеБалансовойСтоимости(ВыводТаблицы, ИмяКолонки, Описание, Значение)
	
	// Добавляем слагаемое так, чтобы сумма не стала отрицательной
	
	СтрокаТаблицы = ЗаполнениеБухгалтерскойОтчетностиТабличное.КрайняяСтрокаТаблицы(ВыводТаблицы);
	ЛимитированноеЗначение = Макс(Мин(0, -СтрокаТаблицы[ИмяКолонки]), Значение);
	ЗаполнениеБухгалтерскойОтчетностиТабличное.ДобавитьСлагаемое(ВыводТаблицы, ИмяКолонки, Описание, ЛимитированноеЗначение);
	
КонецПроцедуры

