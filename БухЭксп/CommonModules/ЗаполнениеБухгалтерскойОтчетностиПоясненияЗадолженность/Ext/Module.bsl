	|ГДЕ
	|	ПрочиеДоходыИРасходы.ВидПрочихДоходовИРасходов = &ВидПДРСписание
	|	И НЕ(ПрочиеРасходы.ЭтоСчетАвансов
	|				ИЛИ ПрочиеРасходы.ЭтоСчетРБП)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ПрочиеРасходы.Организация,
	|	ПрочиеРасходы.СчетДт,
	|	ПрочиеРасходы.СчетКт,
	|	ПрочиеРасходы.Субконто1,
	|	ПрочиеРасходы.Субконто2,
	|	ПрочиеРасходы.Субконто3,
	|	ПрочиеРасходы.ПрочиеДоходыРасходы,
	|	ПрочиеРасходы.СуммаОборот
	|ИЗ
	|	ПрочиеРасходы КАК ПрочиеРасходы
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ПрочиеДоходыИРасходы КАК ПрочиеДоходыИРасходы
	|		ПО ПрочиеРасходы.ПрочиеДоходыРасходы = ПрочиеДоходыИРасходы.Ссылка
	|ГДЕ
	|	ПрочиеДоходыИРасходы.ВидПрочихДоходовИРасходов = &ВидПДРСписание
	|	И ПрочиеРасходы.ЭтоСчетАвансов
	|	И &РазделятьАвансыПоВидамАктива
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ПрочиеРасходы.Организация,
	|	ПрочиеРасходы.СчетДт,
	|	ПрочиеРасходы.СчетКт,
	|	ПрочиеРасходы.Субконто1,
	|	ПрочиеРасходы.Субконто2,
	|	ПрочиеРасходы.Субконто3,
	|	ПрочиеРасходы.ПрочиеДоходыРасходы,
	|	ПрочиеРасходы.СуммаОборот
	|ИЗ
	|	ПрочиеРасходы КАК ПрочиеРасходы
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ПрочиеДоходыИРасходы КАК ПрочиеДоходыИРасходы
	|		ПО ПрочиеРасходы.ПрочиеДоходыРасходы = ПрочиеДоходыИРасходы.Ссылка
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.РасходыБудущихПериодов КАК СправочникРасходыБудущихПериодов
	|		ПО ПрочиеРасходы.СтатьяРБП = СправочникРасходыБудущихПериодов.Ссылка
	|ГДЕ
	|	ПрочиеДоходыИРасходы.ВидПрочихДоходовИРасходов = &ВидПДРСписание
	|	И ПрочиеРасходы.ЭтоСчетРБП
	|	И СправочникРасходыБудущихПериодов.ВидАктива = &ВидАктиваДебиторскаяЗадолженность";
	
	Если ПараметрыЗаполнения.АвансыВыданные.РазделятьАвансыПоВидамАктивов Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&РазделятьАвансыПоВидамАктива", "НЕ ПрочиеРасходы.Договор.ВидАктива В (&ИсключаемыеВидыАктивовАвансов)");
		Запрос.УстановитьПараметр("СчетаУчетаАвансов", ПараметрыЗаполнения.АвансыВыданные.СчетаУчета);
		Запрос.УстановитьПараметр("ИсключаемыеВидыАктивовАвансов", ПараметрыЗаполнения.АвансыВыданные.ИсключаемыеВидыАктивовАвансов);
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&РазделятьАвансыПоВидамАктива", "ИСТИНА");
	КонецЕсли;
	
	Запрос.Текст = ТекстЗапроса;
	Запрос.Выполнить();

КонецПроцедуры

Процедура СоздатьВременныеТаблицыСписаниеНаДоходы(МенеджерВременныхТаблиц, КонтекстЗаполненияОтчета, СчетаРасчетов, ПараметрыЗаполнения)

	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("Организации", КонтекстЗаполненияОтчета.Организации);
	Запрос.УстановитьПараметр("НачалоПериода", КонтекстЗаполненияОтчета.Период.Начало);
	Запрос.УстановитьПараметр("КонецПериода", КонтекстЗаполненияОтчета.Период.Конец);
	Запрос.УстановитьПараметр("СчетаРасчетов", СчетаРасчетов);
	Запрос.УстановитьПараметр("СчетаДоходов", БухгалтерскийУчетПовтИсп.СчетаВИерархии(ПараметрыЗаполнения.СписаниеЗадолженности.Счет));
	Запрос.УстановитьПараметр("ВидПДРСписание", ПараметрыЗаполнения.СписаниеЗадолженности.ВидПрочихДоходовИРасходов);
	
	СубконтоПрочиеДоходыРасходы = Новый Массив;
	СубконтоПрочиеДоходыРасходы.Добавить(ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.ПрочиеДоходыИРасходы);
	Запрос.УстановитьПараметр("СубконтоПрочиеДоходыРасходы", СубконтоПрочиеДоходыРасходы);
	
	Запрос.УстановитьПараметр("ПустойУникальныйИдентификатор", ОбщегоНазначенияКлиентСервер.ПустойУникальныйИдентификатор());

	Запрос.Текст =
	"ВЫБРАТЬ
	|	ХозрасчетныйОборотыДтКт.Организация КАК Организация,
	|	ХозрасчетныйОборотыДтКт.СчетДт КАК СчетДт,
	|	ХозрасчетныйОборотыДтКт.СчетКт КАК СчетКт,
	|	ВЫБОР
	|		КОГДА УНИКАЛЬНЫЙИДЕНТИФИКАТОР(ХозрасчетныйОборотыДтКт.СубконтоДт1) <> &ПустойУникальныйИдентификатор
	|			ТОГДА ХозрасчетныйОборотыДтКт.СубконтоДт1
	|		ИНАЧЕ НЕОПРЕДЕЛЕНО
	|	КОНЕЦ КАК Субконто1,
	|	ВЫБОР
	|		КОГДА УНИКАЛЬНЫЙИДЕНТИФИКАТОР(ХозрасчетныйОборотыДтКт.СубконтоДт2) <> &ПустойУникальныйИдентификатор
	|			ТОГДА ХозрасчетныйОборотыДтКт.СубконтоДт2
	|		ИНАЧЕ НЕОПРЕДЕЛЕНО
	|	КОНЕЦ КАК Субконто2,
	|	ВЫБОР
	|		КОГДА УНИКАЛЬНЫЙИДЕНТИФИКАТОР(ХозрасчетныйОборотыДтКт.СубконтоДт3) <> &ПустойУникальныйИдентификатор
	|			ТОГДА ХозрасчетныйОборотыДтКт.СубконтоДт3
	|		ИНАЧЕ НЕОПРЕДЕЛЕНО
	|	КОНЕЦ КАК Субконто3,
	|	ХозрасчетныйОборотыДтКт.СубконтоКт1 КАК ПрочиеДоходыРасходы,
	|	ХозрасчетныйОборотыДтКт.СуммаОборот КАК СуммаОборот
	|ПОМЕСТИТЬ ПрочиеДоходы
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный.ОборотыДтКт(&НачалоПериода, &КонецПериода, , СчетДт В (&СчетаРасчетов), , СчетКт В (&СчетаДоходов), &СубконтоПрочиеДоходыРасходы, Организация В (&Организации)) КАК ХозрасчетныйОборотыДтКт
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ПрочиеДоходыРасходы
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПрочиеДоходы.Организация КАК Организация,
	|	ПрочиеДоходы.СчетДт КАК СчетРасчетов,
	|	ПрочиеДоходы.СчетКт КАК СчетДоходов,
	|	ПрочиеДоходы.Субконто1 КАК Субконто1,
	|	ПрочиеДоходы.Субконто2 КАК Субконто2,
	|	ПрочиеДоходы.Субконто3 КАК Субконто3,
	|	ПрочиеДоходы.ПрочиеДоходыРасходы КАК ПрочиеДоходыРасходы,
	|	ПрочиеДоходы.СуммаОборот КАК СуммаОборот
	|ПОМЕСТИТЬ СписаниеЗадолженности
	|ИЗ
	|	ПрочиеДоходы КАК ПрочиеДоходы
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ПрочиеДоходыИРасходы КАК ПрочиеДоходыИРасходы
	|		ПО ПрочиеДоходы.ПрочиеДоходыРасходы = ПрочиеДоходыИРасходы.Ссылка
	|ГДЕ
	|	ПрочиеДоходыИРасходы.ВидПрочихДоходовИРасходов = &ВидПДРСписание";
	
	Запрос.Выполнить();

