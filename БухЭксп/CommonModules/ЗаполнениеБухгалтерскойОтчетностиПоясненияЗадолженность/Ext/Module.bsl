	Группа.Наименование = НСтр("ru = 'Расчеты по возмещению материального ущерба'");
	СчетаСписком = "98.03, 98.04";
	Группа.СчетаРасчетов = КлассификацияЗадолженности.СчетаИзСписка(СчетаСписком, ВидыСчетов);

	Если НЕ ЭтоБалансНекоммерческойОрганизации Тогда
		Группа = ДобавитьГруппу(Группы, КодГруппы);
		Группа.Наименование = НСтр("ru = 'Целевое финансирование'");
		СчетаСписком = "86";
		Группа.СчетаРасчетов = КлассификацияЗадолженности.СчетаИзСписка(СчетаСписком, ВидыСчетов);
	КонецЕсли;

	Возврат Группы;
	
КонецФункции

Процедура ЗаполнитьПояснениеКредиторскаяЗадолженность(ЗаполняемыеДанные, Классификаторы, КонтекстЗаполненияОтчета)
	
	Если ЗаполнениеБухгалтерскойОтчетностиТабличное.ТаблицаОтчета(ЗаполняемыеДанные, "КредиторскаяЗадолженностьНаличиеДвижение") = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Организация = КонтекстЗаполненияОтчета.Организации[0];
	
	НастройкиОтчета = ЗаполняемыеДанные.НастройкиОтчета;
	
	КлассифицироватьАктивыОбязательстваПериоды = НовыйКлассифицироватьАктивыОбязательстваПериоды();
	
	КлассифицироватьАктивыОбязательстваПериоды.Начало = 
			КлассификацияЗадолженности.КлассифицироватьАктивыОбязательстваПоСрокамВБалансе(
				КонтекстЗаполненияОтчета.Период.Начало - 1,
				Организация,
				НастройкиОтчета.КлассифицироватьАктивыОбязательства);
	
	КлассифицироватьАктивыОбязательстваПериоды.Конец = 
		КлассификацияЗадолженности.КлассифицироватьАктивыОбязательстваПоСрокамВБалансе(
			КонтекстЗаполненияОтчета.Период.КонецДата,
			Организация,
			НастройкиОтчета.КлассифицироватьАктивыОбязательства);
	
	ПараметрыЗаполнения = ПараметрыЗаполненияПоясненияКредиторскойЗадолженности(НастройкиОтчета);

	ДанныеЗаполнения = ДанныеЗаполненияКредиторскойЗадолженности(
		КонтекстЗаполненияОтчета,
		ПараметрыЗаполнения,
		КлассифицироватьАктивыОбязательстваПериоды,
		НастройкиОтчета.ЭтоБалансНекоммерческойОрганизации);

	ЗаполнитьПояснениеКредиторскаяЗадолженностьНаличиеДвижение(
		ЗаполняемыеДанные,
		ДанныеЗаполнения,
		Классификаторы,
		КонтекстЗаполненияОтчета,
		ПараметрыЗаполнения,
		КлассифицироватьАктивыОбязательстваПериоды);

	ЗаполнитьПояснениеКредиторскаяЗадолженностьПросроченная(
		ЗаполняемыеДанные,
		ДанныеЗаполнения,
		Классификаторы,
		КонтекстЗаполненияОтчета,
		ПараметрыЗаполнения);
		
КонецПроцедуры

Процедура ЗаполнитьПояснениеКредиторскаяЗадолженностьНаличиеДвижение(ЗаполняемыеДанные, ДанныеЗаполнения, Классификаторы, КонтекстЗаполненияОтчета, ПараметрыЗаполнения, КлассифицироватьАктивыОбязательстваПериоды)
	
	ВидЗадолженности = Перечисления.ВидыЗадолженности.Кредиторская;
	
	КонецПериода = КонтекстЗаполненияОтчета.Период.Конец;
	КонецПредыдущегоПериода = Новый МоментВремениСУточнениемПериода(КонтекстЗаполненияОтчета.Период.Начало - 1, БухгалтерскийУчет.ВерхняяГраницаУточненияПериода());
	
	СчетНачисления = ПараметрыЗаполнения.НачислениеШтрафов.Счет;
	СчетСписания = ПараметрыЗаполнения.СписаниеЗадолженности.Счет;
	
	ШаблоныРасшифровкиОбщие = ШаблоныРасшифровкиОбщие();
	ПараметрыТекстов = ПараметрыТекстовРасшифровки(КонтекстЗаполненияОтчета, ПараметрыЗаполнения, ВидЗадолженности);
	Составляющие = ШаблоныРасшифровкиОбщие.Составляющие;
	
	НаличиеДвижение = ЗаполнениеБухгалтерскойОтчетностиТабличное.НачатьВыводТаблицы(
		ЗаполняемыеДанные,
		"КредиторскаяЗадолженностьНаличиеДвижение");
	
	ВыборкаСрочность = ДанныеЗаполнения.РезультатЗадолженности.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаСрочность.Следующий() Цикл
		
		ДолгосрочнаяЗадолженность = Ложь;
		ВариантУчета = Классификаторы.КредиторскаяЗадолженностьНаличиеДвижение.ВариантУчета.КраткосрочнаяКредиторскаяЗадолженность;
		Если ВыборкаСрочность.БолееГода Тогда
			ВариантУчета = Классификаторы.КредиторскаяЗадолженностьНаличиеДвижение.ВариантУчета.ДолгосрочнаяКредиторскаяЗадолженность;
			ДолгосрочнаяЗадолженность = Истина;
			ТаблицаСчетов = ДанныеЗаполнения.ТаблицаСчетовДолгосрочная;
		Иначе
			ТаблицаСчетов = ДанныеЗаполнения.ТаблицаСчетов;
		КонецЕсли;
		
		ВыборкаГруппы = ВыборкаСрочность.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		// Группы
		Пока ВыборкаГруппы.Следующий() Цикл
			
			Отбор = Новый Структура;
			Отбор.Вставить("Код", ВыборкаГруппы.КодГруппы);
			ГруппыОтбор = ДанныеЗаполнения.Группы.НайтиСтроки(Отбор);
			Если Не ЗначениеЗаполнено(ГруппыОтбор) Тогда
				Продолжить;
			КонецЕсли;
			СтрокаГруппы = ГруппыОтбор[0];
		
			Отбор = Новый Структура;
			Отбор.Вставить("КодГруппы", ВыборкаГруппы.КодГруппы);
			Отбор.Вставить("ЭтоКорректирующийСчет", Ложь);
			СписокСчетов = ТаблицаСчетов.НайтиСтроки(Отбор);
			
			СчетаГруппыРаздела = ОпределитьСчетаГруппыРаздела(СписокСчетов, ВидЗадолженности, ПараметрыЗаполнения);
			
			УстановитьПараметрыТекстовРасшифровкиПоГруппе(ПараметрыТекстов, СтрокаГруппы, СчетаГруппыРаздела);
			
			// В зависимости от вида задолженности и набора счета заполняются шаблоны заголовков
			ШаблоныЗаголовков = Новый Соответствие;
			УстановитьШаблоныЗаголовковГруппы(
				ШаблоныЗаголовков,
				ШаблоныРасшифровкиОбщие,
				ВыборкаГруппы,
				СчетаГруппыРаздела,
				ЗаполняемыеДанные.НастройкиОтчета.КлассифицироватьАктивыОбязательства,
				ДолгосрочнаяЗадолженность);
			
			Если СтрокаГруппы.ЭтоАренда Тогда
				ПереопределитьШаблоныЗаголовковГруппыРасчетыПоАренде(ШаблоныЗаголовков, ДолгосрочнаяЗадолженность);
			КонецЕсли;
			
			НачатьДобавлениеСтрокиНаличиеДвижение(
				НаличиеДвижение,
				СтрокаГруппы,
				ШаблоныЗаголовков,
				ПараметрыТекстов,
				ВариантУчета);
			
			ВыборкаОрганизации = ВыборкаГруппы.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			
			Пока ВыборкаОрганизации.Следующий() Цикл
				Если Не ВыборкаОрганизации.ЕстьРасшифровки Тогда
					Продолжить;
				КонецЕсли;
				ВывестиРасшифровкуОрганизация(НаличиеДвижение, ШаблоныЗаголовков, ВыборкаОрганизации);
				
				// основные настройки для открытия отчета-расшифровки
				ОсновныеНастройкиОтчета = ОсновныеНастройкиОтчета(ВыборкаОрганизации.Организация, КонтекстЗаполненияОтчета);
				
				ОбщаяСуммаНачисленийПроценты = 0;
				ОбщаяСуммаСписанийНаДоходы = 0;
				
				ВыборкаСчет = ВыборкаОрганизации.Выбрать();
				Пока ВыборкаСчет.Следующий() Цикл
					
					Если СтрокаГруппы.ЭтоАренда Тогда
						ОписаниеАренды = НСтр("ru = 'Краткосрочное обязательство по аренде'");
						Если ДолгосрочнаяЗадолженность Тогда
							ОписаниеАренды = НСтр("ru = 'Долгосрочное обязательство по аренде'");
						КонецЕсли;
						ДобавитьСлагаемыеРасчетыАренды(НаличиеДвижение, ВыборкаСчет, КонтекстЗаполненияОтчета, ОписаниеАренды);
						Продолжить;
					КонецЕсли;
					
					ОтчетОСВ = НастройкиОСВПоСчетуРасчета(ОсновныеНастройкиОтчета, ВыборкаСчет, ВидЗадолженности);
					
					УстановитьПараметрыТекстовРасшифровкиПоСчету(ПараметрыТекстов, ВыборкаСчет);
					
					// НачалоНоминал
					ИмяКолонки = "НачалоНоминал";
					Значение = ВыборкаСчет.НачалоОстаток;
					Если Значение <> 0 Тогда
						Описание = СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(Составляющие.СлагаемоеСальдо, ПараметрыТекстов);
						ОтчетСчетаРасчетов = ОтчетОСВ;
						Если КлассифицироватьАктивыОбязательстваПериоды.Начало Тогда
							ОтчетСчетаРасчетов = НастройкиОтчетаКлассификацииЗадолженности(ВыборкаОрганизации.Организация, КонецПредыдущегоПериода, ВыборкаСчет);
						КонецЕсли;
						ЗаполнениеБухгалтерскойОтчетностиТабличное.ДобавитьСлагаемое(НаличиеДвижение, ИмяКолонки, Описание, Значение, , ОтчетСчетаРасчетов);
					КонецЕсли;
					
					// ПоступилоНоминал
					ИмяКолонки = "ПоступилоНоминал";
					Значение = ВыборкаСчет.Поступило;
					Если Значение <> 0 Тогда
						Описание = СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(Составляющие.Слагаемое, ПараметрыТекстов);
						ЗаполнениеБухгалтерскойОтчетностиТабличное.ДобавитьСлагаемое(НаличиеДвижение, ИмяКолонки, Описание, Значение, , ОтчетОСВ);
					КонецЕсли;
					
					Значение = - ВыборкаСчет.ВычетПоступило;
					Если Значение <> 0 Тогда
						Описание = СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(Составляющие.ВычетКО, ПараметрыТекстов);
						ЗаполнениеБухгалтерскойОтчетностиТабличное.ДобавитьСлагаемое(НаличиеДвижение, ИмяКолонки, Описание, Значение, , ОтчетОСВ);
					КонецЕсли;
					
					Значение = - ВыборкаСчет.ИсключеноПоступило;
					Если Значение <> 0 Тогда
						Описание = СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(Составляющие.ИсключенКО_КЗ, ПараметрыТекстов);
						ЗаполнениеБухгалтерскойОтчетностиТабличное.ДобавитьСлагаемое(НаличиеДвижение, ИмяКолонки, Описание, Значение, , ОтчетОСВ);
					КонецЕсли;
					
					// СписаноНоминал
					ИмяКолонки = "СписаноНоминал";
					Значение = - ВыборкаСчет.Погашено;
					Если Значение <> 0 Тогда
						Описание = СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(Составляющие.Слагаемое, ПараметрыТекстов);
						ЗаполнениеБухгалтерскойОтчетностиТабличное.ДобавитьСлагаемое(НаличиеДвижение, ИмяКолонки, Описание, Значение, , ОтчетОСВ);
					КонецЕсли;
					
					Значение = ВыборкаСчет.ВычетПогашено;
					Если Значение <> 0 Тогда
						Описание = СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(Составляющие.ВычетДО, ПараметрыТекстов);
						ЗаполнениеБухгалтерскойОтчетностиТабличное.ДобавитьСлагаемое(НаличиеДвижение, ИмяКолонки, Описание, Значение, , ОтчетОСВ);
					КонецЕсли;
					
					Значение = ВыборкаСчет.ИсключеноПогашено;
					Если Значение <> 0 Тогда
						Описание = СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(Составляющие.ИсключенДО_КЗ, ПараметрыТекстов);
						ЗаполнениеБухгалтерскойОтчетностиТабличное.ДобавитьСлагаемое(НаличиеДвижение, ИмяКолонки, Описание, Значение, , ОтчетОСВ);
					КонецЕсли;
					
					// Переклассифицировано
					ИмяКолонки = "Переклассифицировано";
					Значение = ВыборкаСчет.Переклассифицировано;
					Если Значение <> 0 Тогда
						Описание = СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(Составляющие.Слагаемое, ПараметрыТекстов);
						ЗаполнениеБухгалтерскойОтчетностиТабличное.ДобавитьСлагаемое(НаличиеДвижение, ИмяКолонки, Описание, Значение);
					КонецЕсли;
					
					// КонецНоминал
					ИмяКолонки = "КонецНоминал";
					Значение = ВыборкаСчет.КонецОстаток;
					Если Значение <> 0 Тогда
						Описание = СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(Составляющие.СлагаемоеСальдо, ПараметрыТекстов);
						ОтчетСчетаРасчетов = ОтчетОСВ;
						Если КлассифицироватьАктивыОбязательстваПериоды.Конец Тогда
							ОтчетСчетаРасчетов = НастройкиОтчетаКлассификацииЗадолженности(ВыборкаОрганизации.Организация, КонецПериода, ВыборкаСчет);
						КонецЕсли;
						ЗаполнениеБухгалтерскойОтчетностиТабличное.ДобавитьСлагаемое(НаличиеДвижение, ИмяКолонки, Описание, Значение, , ОтчетСчетаРасчетов);
					КонецЕсли;
					
					// ПоступилоПроценты
					ИмяКолонки = "ПоступилоПроценты";
					Если ВыборкаСчет.НачисленоШтрафы <> 0 Тогда
						ОтчетСчета = НастройкиАнализСчетаПоВидуПДР(ОсновныеНастройкиОтчета, СчетНачисления, ВыборкаСчет.Счет, ПараметрыЗаполнения.НачислениеШтрафов.ВидПрочихДоходовИРасходов);
						Описание = СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(Составляющие.Слагаемое, ПараметрыТекстов);
						Значение = ВыборкаСчет.НачисленоШтрафы;
						ОбщаяСуммаНачисленийПроценты = ОбщаяСуммаНачисленийПроценты + Значение;
						ЗаполнениеБухгалтерскойОтчетностиТабличное.ДобавитьСлагаемое(НаличиеДвижение, ИмяКолонки, Описание, Значение, , ОтчетСчета);
					КонецЕсли;
					
					// СписаноНаДоходы
					ИмяКолонки = "СписаноНаДоходы";
					Если ВыборкаСчет.СписаноЗадолженности <> 0 Тогда
						ОтчетСчета = НастройкиАнализСчетаПоВидуПДР(ОсновныеНастройкиОтчета, СчетСписания, ВыборкаСчет.Счет, ПараметрыЗаполнения.СписаниеЗадолженности.ВидПрочихДоходовИРасходов);
						Описание = СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(Составляющие.Слагаемое, ПараметрыТекстов);
						Значение = - ВыборкаСчет.СписаноЗадолженности;
						ОбщаяСуммаСписанийНаДоходы = ОбщаяСуммаСписанийНаДоходы + Значение;
						ЗаполнениеБухгалтерскойОтчетностиТабличное.ДобавитьСлагаемое(НаличиеДвижение, ИмяКолонки, Описание, Значение, , ОтчетСчета);
					КонецЕсли;
					
					// НДС авансов
					Если ЗначениеЗаполнено(ВыборкаСчет.СчетНДС) Тогда
						ДобавитьСлагаемыеНДСАвансов(НаличиеДвижение, ВыборкаСчет, КонтекстЗаполненияОтчета, ПараметрыТекстов, КлассифицироватьАктивыОбязательстваПериоды);
					КонецЕсли;
					
					// Проценты по рассрочке
					Если ЗначениеЗаполнено(ВыборкаСчет.СчетПроцентыПоРассрочке) Тогда
						ДобавитьСлагаемыеПроцентыПоРассрочке(НаличиеДвижение, ВыборкаСчет, КонтекстЗаполненияОтчета, ПараметрыТекстов, КлассифицироватьАктивыОбязательстваПериоды);
					КонецЕсли;
				КонецЦикла;
	
				// Вычет ПоступилоНоминал
				ИмяКолонки = "ПоступилоНоминал";
				Значение = - ОбщаяСуммаНачисленийПроценты;
				Если Значение <> 0 Тогда
					ОтчетСчета = НастройкиАнализСчетаПоВидуПДР(ОсновныеНастройкиОтчета, СчетНачисления, СчетаГруппыРаздела.СчетаРасчетов, ПараметрыЗаполнения.НачислениеШтрафов.ВидПрочихДоходовИРасходов);
					Описание = НСтр("ru = 'За вычетом: Сумма из графы ""Проценты, штрафы и иные начисления""'");
					ЗаполнениеБухгалтерскойОтчетностиТабличное.ДобавитьСлагаемое(НаличиеДвижение, ИмяКолонки, Описание, Значение, , ОтчетСчета);
				КонецЕсли;
				
				// Вычет СписаноНоминал
				ИмяКолонки = "СписаноНоминал";
				Значение = - ОбщаяСуммаСписанийНаДоходы;
				Если Значение <> 0 Тогда
					ОтчетСчета = НастройкиАнализСчетаПоВидуПДР(ОсновныеНастройкиОтчета, СчетСписания, СчетаГруппыРаздела.СчетаРасчетов, ПараметрыЗаполнения.СписаниеЗадолженности.ВидПрочихДоходовИРасходов);
					Описание = НСтр("ru = 'За вычетом: Сумма из графы ""Списано на доходы""'");
					ЗаполнениеБухгалтерскойОтчетностиТабличное.ДобавитьСлагаемое(НаличиеДвижение, ИмяКолонки, Описание, Значение, , ОтчетСчета);
				КонецЕсли;
					
			КонецЦикла;
			ЗаполнениеБухгалтерскойОтчетностиТабличное.ЗакончитьДобавлениеСтрокиТаблицыОтчета(НаличиеДвижение, ШаблоныЗаголовков);
			
		КонецЦикла;
		
	КонецЦикла;

КонецПроцедуры

Процедура ЗаполнитьПояснениеКредиторскаяЗадолженностьПросроченная(ЗаполняемыеДанные, ДанныеЗаполнения, Классификаторы, КонтекстЗаполненияОтчета, ПараметрыЗаполнения)

	ВидЗадолженности = Перечисления.ВидыЗадолженности.Кредиторская;

	Если ЗаполнениеБухгалтерскойОтчетностиТабличное.ТаблицаОтчета(ЗаполняемыеДанные, "КредиторскаяЗадолженностьПросроченная") = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ШаблоныРасшифровкиОбщие = ШаблоныРасшифровкиОбщие();
	ШаблоныЗаголовков = ШаблоныРасшифровкиПросроченная();
	ПараметрыТекстов = ПараметрыТекстовРасшифровки(КонтекстЗаполненияОтчета, ПараметрыЗаполнения, ВидЗадолженности);

	Составляющие = ШаблоныРасшифровкиОбщие.Составляющие;
	
	ШаблонОписаниеНДС = НСтр("ru = 'НДС: сальдо по счету [СчетНДС] по объектам, учитываемым на счете [Счет]'");
	ШаблонОписаниеПроценты = НСтр("ru = 'Проценты по рассрочке: сальдо по [СчетуПроцентовПоРассрочке] по объектам, учитываемым на счете [Счет]'");
	
	КредиторскаяЗадолженностьПросроченная = ЗаполнениеБухгалтерскойОтчетностиТабличное.НачатьВыводТаблицы(
		ЗаполняемыеДанные,
		"КредиторскаяЗадолженностьПросроченная");
		
	Если ДанныеЗаполнения.РезультатПросроченная = Неопределено
		Или ДанныеЗаполнения.РезультатПросроченная.Пустой() Тогда
		Возврат;
	КонецЕсли;
		
	ВыборкаГруппы = ДанныеЗаполнения.РезультатПросроченная.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаГруппы.Следующий() Цикл
		
		Отбор = Новый Структура;
		Отбор.Вставить("Код", ВыборкаГруппы.КодГруппы);
		ГруппыОтбор = ДанныеЗаполнения.Группы.НайтиСтроки(Отбор);
		Если Не ЗначениеЗаполнено(ГруппыОтбор) Тогда
			Продолжить;
		КонецЕсли;
		СтрокаГруппы = ГруппыОтбор[0];
		
		Отбор = Новый Структура;
		Отбор.Вставить("КодГруппы", ВыборкаГруппы.КодГруппы);
		Отбор.Вставить("ЭтоКорректирующийСчет", Ложь);
		СписокСчетов = ДанныеЗаполнения.ТаблицаСчетовПросроченная.НайтиСтроки(Отбор);
		
		СчетаГруппыРаздела = ОпределитьСчетаГруппыРаздела(СписокСчетов, ВидЗадолженности, ПараметрыЗаполнения);
		
		УстановитьПараметрыТекстовРасшифровкиПоГруппе(ПараметрыТекстов, СтрокаГруппы, СчетаГруппыРаздела);
		
		УстановитьШаблоныЗаголовковПросроченнаяПоГруппе(ШаблоныЗаголовков, ШаблоныРасшифровкиОбщие, СчетаГруппыРаздела);
		
		НачатьДобавлениеСтрокиПросроченная(
			КредиторскаяЗадолженностьПросроченная,
			СтрокаГруппы,
			ШаблоныЗаголовков,
			ПараметрыТекстов);
			
		ВыборкаОрганизации = ВыборкаГруппы.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Пока ВыборкаОрганизации.Следующий() Цикл
			ВывестиРасшифровкуОрганизация(КредиторскаяЗадолженностьПросроченная, ШаблоныЗаголовков, ВыборкаОрганизации);
			
			ВыборкаСчет = ВыборкаОрганизации.Выбрать();
			
			Пока ВыборкаСчет.Следующий() Цикл
				
				УстановитьПараметрыТекстовРасшифровкиПоСчету(ПараметрыТекстов, ВыборкаСчет);
				ПараметрыТекстов.СчетНДС = Строка(ВыборкаСчет.СчетНДС);
				
				Описание = СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(Составляющие.СлагаемоеСальдо, ПараметрыТекстов);
				
				ЗаполнениеБухгалтерскойОтчетностиТабличное.ДобавитьСлагаемое(
					КредиторскаяЗадолженностьПросроченная,
					"НачалоНоминальнаяВеличина",
					Описание,
					ВыборкаСчет.НачалоОстаток);
				
				ЗаполнениеБухгалтерскойОтчетностиТабличное.ДобавитьСлагаемое(
					КредиторскаяЗадолженностьПросроченная,
					"КонецНоминальнаяВеличина",
					Описание,
					ВыборкаСчет.КонецОстаток);
					
				Значение = - ВыборкаСчет.НачалоНДС;
				Если Значение <> 0 Тогда
					ЗаполнениеБухгалтерскойОтчетностиТабличное.ДобавитьСлагаемое(
						КредиторскаяЗадолженностьПросроченная,
						"НачалоНоминальнаяВеличина",
						СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(ШаблонОписаниеНДС, ПараметрыТекстов),
						Значение);
				КонецЕсли;
				
				Значение = - ВыборкаСчет.КонецНДС;
				Если Значение <> 0 Тогда
					ЗаполнениеБухгалтерскойОтчетностиТабличное.ДобавитьСлагаемое(
						КредиторскаяЗадолженностьПросроченная,
						"КонецНоминальнаяВеличина",
						СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(ШаблонОписаниеНДС, ПараметрыТекстов),
						Значение);
					КонецЕсли;
					
				Значение = - ВыборкаСчет.НачалоПроцентыПоРассрочке;
				Если Значение <> 0 Тогда
					ЗаполнениеБухгалтерскойОтчетностиТабличное.ДобавитьСлагаемое(
						КредиторскаяЗадолженностьПросроченная,
						"НачалоНоминальнаяВеличина",
						СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(ШаблонОписаниеПроценты, ПараметрыТекстов),
						Значение);
				КонецЕсли;
				
				Значение = - ВыборкаСчет.КонецПроцентыПоРассрочке;
				Если Значение <> 0 Тогда
					ЗаполнениеБухгалтерскойОтчетностиТабличное.ДобавитьСлагаемое(
						КредиторскаяЗадолженностьПросроченная,
						"КонецНоминальнаяВеличина",
						СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(ШаблонОписаниеПроценты, ПараметрыТекстов),
						Значение);
				КонецЕсли;
						
			КонецЦикла;
		КонецЦикла;
		
		ЗаполнениеБухгалтерскойОтчетностиТабличное.ЗакончитьДобавлениеСтрокиТаблицыОтчета(
			КредиторскаяЗадолженностьПросроченная,
			ШаблоныЗаголовков);
	
	КонецЦикла;
	
КонецПроцедуры

Функция ДанныеЗаполненияКредиторскойЗадолженности(КонтекстЗаполненияОтчета, ПараметрыЗаполнения, КлассифицироватьАктивыОбязательстваПериоды, ЭтоБалансНекоммерческойОрганизации)
	
	ДанныеЗаполнения = НовыйДанныеЗаполнения();
	
	Организации = КонтекстЗаполненияОтчета.Организации;
	КонецПредыдущегоПериода = КонтекстЗаполненияОтчета.Период.Начало - 1;
	ВидЗадолженности = Перечисления.ВидыЗадолженности.Кредиторская;
	
	Группы = ГруппыКредиторскойЗадолженности(ЭтоБалансНекоммерческойОрганизации);
	ДанныеЗаполнения.Вставить("Группы", Группы);
	
	СчетаРасчетов = Новый Массив;
	Для Каждого Группа Из Группы Цикл
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(СчетаРасчетов, Группа.СчетаРасчетов);
	КонецЦикла;
	
	ВидыСчетов = Новый Массив;
	ВидыСчетов.Добавить(ВидСчета.Пассивный);
	ВидыСчетов.Добавить(ВидСчета.АктивноПассивный);

	СчетаРасчетов = СчетаСОтборомПоВиду(СчетаРасчетов, ВидыСчетов);
	
	СписокВидовСубконто = КлассификацияЗадолженности.СписокВидовСубконто();
	НаборыСчетов = КлассификацияЗадолженности.НаборыСчетовБаланса(ВидЗадолженности, СписокВидовСубконто, Ложь);
	ТаблицаСчетов = КлассификацияЗадолженности.НовыйТаблицаСчетов();
	КлассификацияЗадолженности.ЗаполнитьНаборыСчетами(НаборыСчетов, СчетаРасчетов, ТаблицаСчетов);
	
	// в таблицу счетов необходимо добавить корректирующие счета для отражения сумм, по которым не определена задолженность
	КорректирующиеСчета = Новый Массив;
	КорректирующиеСчета.Добавить(ПланыСчетов.Хозрасчетный.НДСпоАвансамИПредоплатам);
	КорректирующиеСчета.Добавить(ПланыСчетов.Хозрасчетный.ПроцентыПоРассрочке);
	
	СчетаСРеквизитами = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(КорректирующиеСчета, "Код, Порядок, Вид");
	
	Для Каждого Счет Из КорректирующиеСчета Цикл
		СтрокаТаблицы = ТаблицаСчетов.Добавить();
		СтрокаТаблицы.Счет = Счет;
		СтрокаТаблицы.Код = СчетаСРеквизитами[Счет].Код;
		СтрокаТаблицы.Порядок = СчетаСРеквизитами[Счет].Порядок;
		СтрокаТаблицы.ВидСчета = СчетаСРеквизитами[Счет].Вид;
		СтрокаТаблицы.ЭтоКорректирующийСчет = Истина;
	КонецЦикла;
	
	ДанныеЗаполнения.Вставить("ТаблицаСчетов", ТаблицаСчетов);

	ЗаполнениеБухгалтерскойОтчетности2025Основная.ОпределитьГруппуСчетов(ТаблицаСчетов, ДанныеЗаполнения.Группы);
	
	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	КлассификацияЗадолженности.СоздатьВременныеТаблицыСчетов(МенеджерВременныхТаблиц, ТаблицаСчетов);
	
	// Начало периода
	КонтекстРасчета = НовыйКонтекстРасчетаЗадолженности();
	КонтекстРасчета.Организации = Организации;
	КонтекстРасчета.Период = Новый МоментВремениСУточнениемПериода(КонецПредыдущегоПериода, БухгалтерскийУчет.ВерхняяГраницаУточненияПериода());
	КонтекстРасчета.Дата = КонецПредыдущегоПериода;
	
	ИменаТаблиц = НовыйИменаВременныхТаблиц();
	ИменаТаблиц.Задолженность = "ЗадолженностьНачало";
	ИменаТаблиц.НДСАвансов = "НДСНачало";
	ИменаТаблиц.Проценты = "ПроцентыНачало";
	ИменаТаблиц.РасчетыПоАренде = "РасчетыПоАрендеНачало";
	
	СоздатьВременныеТаблицыКредиторскойЗадолженностиНаДату(
		МенеджерВременныхТаблиц,
		КонтекстРасчета,
		СчетаРасчетов,
		ПараметрыЗаполнения,
		КлассифицироватьАктивыОбязательстваПериоды.Начало,
		ИменаТаблиц);
		
	// Конец периода
	КонтекстРасчета = НовыйКонтекстРасчетаЗадолженности();
	КонтекстРасчета.Организации = Организации;
	КонтекстРасчета.Период = КонтекстЗаполненияОтчета.Период.Конец;
	КонтекстРасчета.Дата = КонтекстЗаполненияОтчета.Период.КонецДата;
	
	ИменаТаблиц = НовыйИменаВременныхТаблиц();
	ИменаТаблиц.Задолженность = "ЗадолженностьКонец";
	ИменаТаблиц.НДСАвансов = "НДСКонец";
	ИменаТаблиц.Проценты = "ПроцентыКонец";
	ИменаТаблиц.РасчетыПоАренде = "РасчетыПоАрендеКонец";
	
	СоздатьВременныеТаблицыКредиторскойЗадолженностиНаДату(
		МенеджерВременныхТаблиц,
		КонтекстРасчета,
		СчетаРасчетов,
		ПараметрыЗаполнения,
		КлассифицироватьАктивыОбязательстваПериоды.Конец,
		ИменаТаблиц);
		
	СоздатьВременныеТаблицыНачислениеШтрафовКредиторскаяЗадолженность(
		МенеджерВременныхТаблиц,
		КонтекстЗаполненияОтчета,
		СчетаРасчетов,
		ПараметрыЗаполнения);

	СоздатьВременныеТаблицыСписаниеНаДоходы(
		МенеджерВременныхТаблиц,
		КонтекстЗаполненияОтчета,
		СчетаРасчетов,
		ПараметрыЗаполнения);
		
	СоздатьВременныеТаблицыОборотыЗадолженности(
		МенеджерВременныхТаблиц,
		КонтекстЗаполненияОтчета,
		СчетаРасчетов,
		Ложь);
	
	СоздатьВременныеТаблицыОстаткиОборотыЗадолженности(
		МенеджерВременныхТаблиц,
		Ложь);
		
	СоздатьВременныеТаблицыАрендныеОбязательства(МенеджерВременныхТаблиц);

	ВидСубконтоСчетФактура = ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.СФВыданные;
	СчетаНДСАвансов = БухгалтерскийУчетПовтИсп.СчетаВИерархии(ПланыСчетов.Хозрасчетный.НДСпоАвансамИПредоплатам);
	СоздатьВременныеТаблицыОстаткиОборотыНДСАвансов(
		МенеджерВременныхТаблиц,
		ВидСубконтоСчетФактура,
		КонтекстЗаполненияОтчета,
		СчетаНДСАвансов,
		КлассификацияЗадолженности.СчетаУчетаАвансовПолученных());
		
	СоздатьВременныеТаблицыОстаткиОборотыПроцентовПоРассрочке(
		МенеджерВременныхТаблиц,
		КонтекстЗаполненияОтчета);
		
	РассчитатьКредиторскуюЗадолженность(
		МенеджерВременныхТаблиц,
		ДанныеЗаполнения);
		
	Возврат ДанныеЗаполнения;
	
КонецФункции

Процедура РассчитатьКредиторскуюЗадолженность(МенеджерВременныхТаблиц, ДанныеЗаполнения)

	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;

#Область ДанныеТаблицы_7_1

	Запрос.Текст =
	"ВЫБРАТЬ
	|	Расчеты.Организация КАК Организация,
	|	Организации.Представление КАК НаименованиеОрганизации,
	|	Организации.ГоловнаяОрганизация = Организации.Ссылка КАК ЭтоГоловнаяОрганизация,
	|	Расчеты.Счет КАК Счет,
	|	МАКСИМУМ(Расчеты.СчетНДС) КАК СчетНДС,
	|	МАКСИМУМ(Расчеты.СчетПроцентыПоРассрочке) КАК СчетПроцентыПоРассрочке,
	|	Расчеты.БолееГода КАК БолееГода,
	|	СУММА(Расчеты.НачалоОстаток) КАК НачалоОстаток,
	|	СУММА(Расчеты.КонецОстаток) КАК КонецОстаток,
	|	СУММА(Расчеты.Поступило) КАК Поступило,
	|	СУММА(Расчеты.Погашено) КАК Погашено,
	|	СУММА(Расчеты.ВычетПоступило) КАК ВычетПоступило,
	|	СУММА(Расчеты.ВычетПогашено) КАК ВычетПогашено,
	|	СУММА(Расчеты.ИсключеноПоступило) КАК ИсключеноПоступило,
	|	СУММА(Расчеты.ИсключеноПогашено) КАК ИсключеноПогашено,
	|	СУММА(Расчеты.Переклассифицировано) КАК Переклассифицировано,
