КонецПроцедуры

Процедура СоздатьВременныеТаблицыНачислениеШтрафовДебиторскаяЗадолженность(МенеджерВременныхТаблиц, КонтекстЗаполненияОтчета, СчетаРасчетов, ПараметрыЗаполнения)
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("Организации", КонтекстЗаполненияОтчета.Организации);
	Запрос.УстановитьПараметр("НачалоПериода", КонтекстЗаполненияОтчета.Период.Начало);
	Запрос.УстановитьПараметр("КонецПериода", КонтекстЗаполненияОтчета.Период.Конец);
	Запрос.УстановитьПараметр("СчетаРасчетов", СчетаРасчетов);
	Запрос.УстановитьПараметр("СчетаДоходов", БухгалтерскийУчетПовтИсп.СчетаВИерархии(ПараметрыЗаполнения.НачислениеШтрафов.Счет));
	Запрос.УстановитьПараметр("ВидПДРНачисление", ПараметрыЗаполнения.НачислениеШтрафов.ВидПрочихДоходовИРасходов);
	
	СубконтоПрочиеДоходыРасходы = Новый Массив;
	СубконтоПрочиеДоходыРасходы.Добавить(ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.ПрочиеДоходыИРасходы);
	Запрос.УстановитьПараметр("СубконтоПрочиеДоходыРасходы", СубконтоПрочиеДоходыРасходы);
	
	Запрос.УстановитьПараметр("СчетаУчетаАвансов", ПараметрыЗаполнения.АвансыВыданные.СчетаУчета);
	
	Запрос.УстановитьПараметр("СчетаУчетаРБП", ПараметрыЗаполнения.РасходыБудущихПериодов.СчетаУчета);
	Запрос.УстановитьПараметр("ВидАктиваДебиторскаяЗадолженность", ПараметрыЗаполнения.РасходыБудущихПериодов.ВидАктива);
	
	Запрос.УстановитьПараметр("ПустойУникальныйИдентификатор", ОбщегоНазначенияКлиентСервер.ПустойУникальныйИдентификатор());

	ТекстЗапроса  =
	"ВЫБРАТЬ
	|	ХозрасчетныйОборотыДтКт.Организация КАК Организация,
	|	ХозрасчетныйОборотыДтКт.СчетДт КАК СчетДт,
	|	ХозрасчетныйОборотыДтКт.СчетКт КАК СчетКт,
	|	ВЫБОР
	|		КОГДА УНИКАЛЬНЫЙИДЕНТИФИКАТОР(ХозрасчетныйОборотыДтКт.СубконтоДт1) <> &ПустойУникальныйИдентификатор
	|			ТОГДА ХозрасчетныйОборотыДтКт.СубконтоДт1
	|		ИНАЧЕ НЕОПРЕДЕЛЕНО
	|	КОНЕЦ КАК Субконто1,
	|	ВЫБОР
	|		КОГДА УНИКАЛЬНЫЙИДЕНТИФИКАТОР(ХозрасчетныйОборотыДтКт.СубконтоДт2) <> &ПустойУникальныйИдентификатор
	|			ТОГДА ХозрасчетныйОборотыДтКт.СубконтоДт2
	|		ИНАЧЕ НЕОПРЕДЕЛЕНО
	|	КОНЕЦ КАК Субконто2,
	|	ВЫБОР
	|		КОГДА УНИКАЛЬНЫЙИДЕНТИФИКАТОР(ХозрасчетныйОборотыДтКт.СубконтоДт3) <> &ПустойУникальныйИдентификатор
	|			ТОГДА ХозрасчетныйОборотыДтКт.СубконтоДт3
	|		ИНАЧЕ НЕОПРЕДЕЛЕНО
	|	КОНЕЦ КАК Субконто3,
	|	ХозрасчетныйОборотыДтКт.СубконтоКт1 КАК ПрочиеДоходыРасходы,
	|	ХозрасчетныйОборотыДтКт.СуммаОборот КАК СуммаОборот,
	|	ХозрасчетныйОборотыДтКт.СчетДт В (&СчетаУчетаАвансов) КАК ЭтоСчетАвансов,
	|	ВЫБОР
	|		КОГДА ХозрасчетныйОборотыДтКт.СубконтоДт1 ССЫЛКА Справочник.ДоговорыКонтрагентов
	|			ТОГДА ХозрасчетныйОборотыДтКт.СубконтоДт1
	|		КОГДА ХозрасчетныйОборотыДтКт.СубконтоДт2 ССЫЛКА Справочник.ДоговорыКонтрагентов
	|			ТОГДА ХозрасчетныйОборотыДтКт.СубконтоДт2
	|		КОГДА ХозрасчетныйОборотыДтКт.СубконтоДт3 ССЫЛКА Справочник.ДоговорыКонтрагентов
	|			ТОГДА ХозрасчетныйОборотыДтКт.СубконтоДт3
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ДоговорыКонтрагентов.ПустаяСсылка)
	|	КОНЕЦ КАК Договор,
	|	ХозрасчетныйОборотыДтКт.СчетДт В (&СчетаУчетаРБП) КАК ЭтоСчетРБП,
	|	ВЫБОР
	|		КОГДА ХозрасчетныйОборотыДтКт.СубконтоДт1 ССЫЛКА Справочник.РасходыБудущихПериодов
	|			ТОГДА ХозрасчетныйОборотыДтКт.СубконтоДт1
	|		КОГДА ХозрасчетныйОборотыДтКт.СубконтоДт2 ССЫЛКА Справочник.РасходыБудущихПериодов
	|			ТОГДА ХозрасчетныйОборотыДтКт.СубконтоДт2
