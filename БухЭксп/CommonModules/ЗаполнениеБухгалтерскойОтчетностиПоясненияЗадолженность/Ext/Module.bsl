Функция ШаблонПорядкаРасчетаСчетов(ЧастиПорядкаРасчета, СчетаГруппыРаздела)
	
	ТекстыСчетов = Новый Массив;
	Если ЗначениеЗаполнено(СчетаГруппыРаздела.СчетаРасчетовСвернуто) Тогда
		Текст = ЧастиПорядкаРасчета.Сальдо;
		Текст = СтрЗаменить(Текст, "[СчетаРасчетов]", "[СчетаРасчетовСвернуто]");
		ТекстыСчетов.Добавить(Текст);
	КонецЕсли;
	Если ЗначениеЗаполнено(СчетаГруппыРаздела.СчетаРасчетовРазвернуто) Тогда
		Текст = ЧастиПорядкаРасчета.СальдоРазвернуто;
		Текст = СтрЗаменить(Текст, "[СчетаРасчетов]", "[СчетаРасчетовРазвернуто]");
		ТекстыСчетов.Добавить(Текст);
	КонецЕсли;
	Если ЗначениеЗаполнено(СчетаГруппыРаздела.СчетаАвансов) Тогда
		ТекстыАвансы = Новый Массив;
		ТекстыАвансы.Добавить(ЧастиПорядкаРасчета.Сальдо);
		ТекстыАвансы.Добавить(ЧастиПорядкаРасчета.ИсключаемыеВидыАктивовАвансы);
		Текст = СтрЗаменить(СтрСоединить(ТекстыАвансы, " "), "[СчетаРасчетов]", "[СчетаАвансов]");
		ТекстыСчетов.Добавить(Текст);
	КонецЕсли;
	Если ЗначениеЗаполнено(СчетаГруппыРаздела.СчетаУчетаРБП) Тогда
		ТекстыРБП = Новый Массив;
		ТекстыРБП.Добавить(ЧастиПорядкаРасчета.Сальдо);
		ТекстыРБП.Добавить(ЧастиПорядкаРасчета.ВидАктиваДЗ);
		Текст = СтрЗаменить(СтрСоединить(ТекстыРБП, " "), "[СчетаРасчетов]", "[СчетаУчетаРБП]");
		ТекстыСчетов.Добавить(Текст);
	КонецЕсли;
	
	ТекстСчетовСтрока = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку("%1", СтрСоединить(ТекстыСчетов, ", "));
	
