Функция ПараметрыТекстовРасшифровки(КонтекстЗаполненияОтчета, ПараметрыЗаполнения, ВидЗадолженности)
	
	ПараметрыТекстов = Новый Структура;
	
	КодЯзыка = ОбщегоНазначения.КодОсновногоЯзыка();
	
	ЗаполнениеБухгалтерскойОтчетностиТабличное.УстановитьПараметрыТекстовРасшифровки(ПараметрыТекстов, КонтекстЗаполненияОтчета);
	
	ФорматДаты = "ДЛФ=DD";
	ПараметрыТекстов.Вставить("КонецСледующегоПериода",  Формат(ДобавитьМесяц(КонтекстЗаполненияОтчета.Период.КонецДата, 12), ФорматДаты));
	ПараметрыТекстов.Вставить("СрокПогашенияНачало", Формат(ДобавитьМесяц(КонтекстЗаполненияОтчета.Период.Начало, 12), ФорматДаты));
	ПараметрыТекстов.Вставить("СрокПогашенияКонец",  Формат(КонецМесяца(ДобавитьМесяц(КонтекстЗаполненияОтчета.Период.КонецДата, 12)) + 1, ФорматДаты));

	СуммарноПоФилиалам = "";
	Если КонтекстЗаполненияОтчета.Организации.Количество() > 1 Тогда
		СуммарноПоФилиалам = НСтр("ru = ', но суммарно по всем филиалам'", КодЯзыка);
	КонецЕсли;
	ПараметрыТекстов.Вставить("СуммарноПоФилиалам", СуммарноПоФилиалам);
		
	СчетаНДСАвансовВыданных = Новый Массив;
	СчетаНДСАвансовВыданных.Добавить(ПланыСчетов.Хозрасчетный.НДСпоАвансамИПредоплатамВыданным);
		
	ПредставленияСчетов = ЗаполнениеБухгалтерскойОтчетностиТабличное.ПредставлениеСписка(СчетаНДСАвансовВыданных);
	ПараметрыТекстов.Вставить("СчетаНДСАвансовВыданных", ЗаполнениеБухгалтерскойОтчетностиТабличное.ПредставлениеСпискаСчетовРодительныйПадеж(
		ПредставленияСчетов));
		
	ПредставленияСчетов = ЗаполнениеБухгалтерскойОтчетностиТабличное.ПредставлениеСписка(СчетаНДСАвансовВыданных);
	ПараметрыТекстов.Вставить("СчетуНДСАвансовВыданных", ЗаполнениеБухгалтерскойОтчетностиТабличное.ПредставлениеСпискаСчетовДательныйПадеж(
		ПредставленияСчетов));
		
	СчетаРасчетовПоАренде = ПланыСчетов.Хозрасчетный.СчетаРасчетовПоАренде();
	
	ПредставленияСчетов = ЗаполнениеБухгалтерскойОтчетностиТабличное.ПредставлениеСписка(СчетаРасчетовПоАренде);
		ПараметрыТекстов.Вставить("СчетуАренды", ЗаполнениеБухгалтерскойОтчетностиТабличное.ПредставлениеСпискаСчетовДательныйПадеж(
			ПредставленияСчетов));
			
	СчетаНачисления = БухгалтерскийУчетПовтИсп.СчетаВИерархии(ПараметрыЗаполнения.НачислениеШтрафов.Счет);
	
	ПредставленияСчетов = ЗаполнениеБухгалтерскойОтчетностиТабличное.ПредставлениеСписка(СчетаНачисления);
		ПараметрыТекстов.Вставить("СчетаНачисления", ЗаполнениеБухгалтерскойОтчетностиТабличное.ПредставлениеСпискаСчетовТворительныйПадеж(
			ПредставленияСчетов));
			
	СчетаСписания = БухгалтерскийУчетПовтИсп.СчетаВИерархии(ПараметрыЗаполнения.СписаниеЗадолженности.Счет);
	
	ПредставленияСчетов = ЗаполнениеБухгалтерскойОтчетностиТабличное.ПредставлениеСписка(СчетаСписания);
		ПараметрыТекстов.Вставить("СчетаСписания", ЗаполнениеБухгалтерскойОтчетностиТабличное.ПредставлениеСпискаСчетовТворительныйПадеж(
			ПредставленияСчетов));

	ПараметрыТекстов.Вставить("ВидПДРСписание", Строка(ПараметрыЗаполнения.СписаниеЗадолженности.ВидПрочихДоходовИРасходов));
	ПараметрыТекстов.Вставить("ВидПДРНачисление", Строка(ПараметрыЗаполнения.НачислениеШтрафов.ВидПрочихДоходовИРасходов));
	
	СчетаРезервов = БухгалтерскийУчетПовтИсп.СчетаВИерархии(ПланыСчетов.Хозрасчетный.РезервыПоСомнительнымДолгам);
	
	ПредставленияСчетов = ЗаполнениеБухгалтерскойОтчетностиТабличное.ПредставлениеСписка(СчетаРезервов);
	ПараметрыТекстов.Вставить("СчетаРезервов", ЗаполнениеБухгалтерскойОтчетностиТабличное.ПредставлениеСпискаСчетовРодительныйПадеж(
		ПредставленияСчетов));
		
	ПредставленияСчетов = ЗаполнениеБухгалтерскойОтчетностиТабличное.ПредставлениеСписка(СчетаРезервов);
	ПараметрыТекстов.Вставить("СчетуРезервов", ЗаполнениеБухгалтерскойОтчетностиТабличное.ПредставлениеСпискаСчетовДательныйПадеж(
		ПредставленияСчетов));
		
	СчетаПроцентовПоРассрочке = ПланыСчетов.Хозрасчетный.СчетаПроцентовПоРассрочке();
	
	ПредставленияСчетов = ЗаполнениеБухгалтерскойОтчетностиТабличное.ПредставлениеСписка(СчетаПроцентовПоРассрочке);
	ПараметрыТекстов.Вставить("СчетуПроцентовПоРассрочке", ЗаполнениеБухгалтерскойОтчетностиТабличное.ПредставлениеСпискаСчетовДательныйПадеж(
		ПредставленияСчетов));
	
	Если ВидЗадолженности = Перечисления.ВидыЗадолженности.Дебиторская Тогда
		ПараметрыТекстов.Вставить("ДолгосрочныйВидЗадолженности", "Долгосрочная дебиторская задолженность");
		ПараметрыТекстов.Вставить("КраткосрочныйВидЗадолженности", "Краткосрочная дебиторская задолженность");
		ПараметрыТекстов.Вставить("ДебетуКредиту", "дебету");
		ПараметрыТекстов.Вставить("ПоступилоПоДебетуКредиту", "Оборот по дебету");
		ПараметрыТекстов.Вставить("СписаноПоДебетуКредиту", "Оборот по кредиту");
		ПараметрыТекстов.Вставить("ПоступилоНДСПоДебетуКредиту", "кредитовый оборот");
		ПараметрыТекстов.Вставить("ПоступилоНДСВПределахДебетовогоКредитового", "в пределах дебетового оборота");
		ПараметрыТекстов.Вставить("СписаноНДСПоДебетуКредиту", "дебетовый оборот");
		ПараметрыТекстов.Вставить("СписаноНДСВПределахДебетовогоКредитового", "в пределах кредитового оборота");
		ПараметрыТекстов.Вставить("ИсключаетсяДебетовоеКредитовоеСальдо", "исключается кредитовое сальдо");
		ПараметрыТекстов.Вставить("СвязанныйСДебетовымКредитовымСальдо", "связанный с кредитовым сальдо");
		
		ПараметрыТекстов.Вставить("ВидАктиваДебиторскаяЗадолженность", Строка(ПараметрыЗаполнения.РасходыБудущихПериодов.ВидАктива));
	Иначе
		ПараметрыТекстов.Вставить("ДолгосрочныйВидЗадолженности", "Долгосрочные обязательства");
		ПараметрыТекстов.Вставить("КраткосрочныйВидЗадолженности", "Краткосрочные обязательства");
		ПараметрыТекстов.Вставить("ДебетуКредиту", "кредиту");
		ПараметрыТекстов.Вставить("ПоступилоПоДебетуКредиту", "Оборот по кредиту");
		ПараметрыТекстов.Вставить("СписаноПоДебетуКредиту", "Оборот по дебету");
		ПараметрыТекстов.Вставить("ПоступилоНДСПоДебетуКредиту", "дебетовый оборот");
		ПараметрыТекстов.Вставить("ПоступилоНДСВПределахДебетовогоКредитового", "в пределах кредитового оборота");
		ПараметрыТекстов.Вставить("СписаноНДСПоДебетуКредиту", "кредитовый оборот");
		ПараметрыТекстов.Вставить("СписаноНДСВПределахДебетовогоКредитового", "в пределах дебетового оборота");
		ПараметрыТекстов.Вставить("ИсключаетсяДебетовоеКредитовоеСальдо", "исключается дебетовое сальдо");
		ПараметрыТекстов.Вставить("СвязанныйСДебетовымКредитовымСальдо", "связанный с дебетовым сальдо");
	КонецЕсли;
	
	ПараметрыТекстов.Вставить("НаименованиеГруппы", "");
	ПараметрыТекстов.Вставить("СчетаРасчетов", "");
	ПараметрыТекстов.Вставить("СчетуРасчетов", "");
	ПараметрыТекстов.Вставить("СчетеРасчетов", "");
	ПараметрыТекстов.Вставить("СчетаРасчетовСвернуто", "");
	ПараметрыТекстов.Вставить("СчетуРасчетовСвернуто", "");
	ПараметрыТекстов.Вставить("СчетеРасчетовСвернуто", "");
	ПараметрыТекстов.Вставить("СчетаРасчетовРазвернуто", "");
	ПараметрыТекстов.Вставить("СчетуРасчетовРазвернуто", "");
	ПараметрыТекстов.Вставить("СчетеРасчетовРазвернуто", "");
	ПараметрыТекстов.Вставить("СчетаАвансов", "");
	ПараметрыТекстов.Вставить("СчетуАвансов", "");
	ПараметрыТекстов.Вставить("СчетаУчетаРБП", "");
	ПараметрыТекстов.Вставить("СчетуУчетаРБП", "");
	ПараметрыТекстов.Вставить("СчетеОбъектовРезервов", "");
	
	ПараметрыТекстов.Вставить("Счет", "");
	ПараметрыТекстов.Вставить("РазвернутоПоВидамСубконто", "");
	ПараметрыТекстов.Вставить("ПоВидамСубконто", "");
	
	ПараметрыТекстов.Вставить("СчетНДС", "");
	ПараметрыТекстов.Вставить("СчетРезервов", "");
	ПараметрыТекстов.Вставить("СчетПроцентовПоРассрочке", "");
	
	Возврат ПараметрыТекстов;
	
КонецФункции

Процедура УстановитьПараметрыТекстовРасшифровкиПоГруппе(ПараметрыТекстовРасшифровки, Группа, СчетаГруппы)
	
	ПараметрыТекстовРасшифровки.НаименованиеГруппы = Группа.Наименование;
	
	Если ЗначениеЗаполнено(СчетаГруппы.СчетаРасчетов) Тогда
		ПредставленияСчетов = ЗаполнениеБухгалтерскойОтчетностиТабличное.ПредставлениеСписка(СчетаГруппы.СчетаРасчетов);
		ПараметрыТекстовРасшифровки.СчетаРасчетов = ЗаполнениеБухгалтерскойОтчетностиТабличное.ПредставлениеСпискаСчетовРодительныйПадеж(
			ПредставленияСчетов);
		ПараметрыТекстовРасшифровки.СчетуРасчетов = ЗаполнениеБухгалтерскойОтчетностиТабличное.ПредставлениеСпискаСчетовДательныйПадеж(
			ПредставленияСчетов);
		ПараметрыТекстовРасшифровки.СчетеРасчетов = ЗаполнениеБухгалтерскойОтчетностиТабличное.ПредставлениеСпискаСчетовПредложныйПадеж(
			ПредставленияСчетов);
	КонецЕсли;

	Если ЗначениеЗаполнено(СчетаГруппы.СчетаРасчетовСвернуто) Тогда
		ПредставленияСчетов = ЗаполнениеБухгалтерскойОтчетностиТабличное.ПредставлениеСписка(СчетаГруппы.СчетаРасчетовСвернуто);
		ПараметрыТекстовРасшифровки.СчетаРасчетовСвернуто = ЗаполнениеБухгалтерскойОтчетностиТабличное.ПредставлениеСпискаСчетовРодительныйПадеж(
			ПредставленияСчетов);
		ПараметрыТекстовРасшифровки.СчетуРасчетовСвернуто = ЗаполнениеБухгалтерскойОтчетностиТабличное.ПредставлениеСпискаСчетовДательныйПадеж(
			ПредставленияСчетов);
		ПараметрыТекстовРасшифровки.СчетеРасчетовСвернуто = ЗаполнениеБухгалтерскойОтчетностиТабличное.ПредставлениеСпискаСчетовПредложныйПадеж(
			ПредставленияСчетов);
	КонецЕсли;

	Если ЗначениеЗаполнено(СчетаГруппы.СчетаРасчетовРазвернуто) Тогда
		ПредставленияСчетов = ЗаполнениеБухгалтерскойОтчетностиТабличное.ПредставлениеСписка(СчетаГруппы.СчетаРасчетовРазвернуто);
		ПараметрыТекстовРасшифровки.СчетаРасчетовРазвернуто = ЗаполнениеБухгалтерскойОтчетностиТабличное.ПредставлениеСпискаСчетовРодительныйПадеж(
			ПредставленияСчетов);
		ПараметрыТекстовРасшифровки.СчетуРасчетовРазвернуто = ЗаполнениеБухгалтерскойОтчетностиТабличное.ПредставлениеСпискаСчетовДательныйПадеж(
			ПредставленияСчетов);
		ПараметрыТекстовРасшифровки.СчетеРасчетовРазвернуто = ЗаполнениеБухгалтерскойОтчетностиТабличное.ПредставлениеСпискаСчетовПредложныйПадеж(
			ПредставленияСчетов);
	КонецЕсли;

	Если ЗначениеЗаполнено(СчетаГруппы.СчетаАвансов) Тогда
		ПредставленияСчетов = ЗаполнениеБухгалтерскойОтчетностиТабличное.ПредставлениеСписка(СчетаГруппы.СчетаАвансов);
		ПараметрыТекстовРасшифровки.СчетаАвансов = ЗаполнениеБухгалтерскойОтчетностиТабличное.ПредставлениеСпискаСчетовРодительныйПадеж(
			ПредставленияСчетов);
		ПараметрыТекстовРасшифровки.СчетуАвансов = ЗаполнениеБухгалтерскойОтчетностиТабличное.ПредставлениеСпискаСчетовДательныйПадеж(
			ПредставленияСчетов);
	КонецЕсли;

	Если ЗначениеЗаполнено(СчетаГруппы.СчетаУчетаРБП) Тогда
		ПредставленияСчетов = ЗаполнениеБухгалтерскойОтчетностиТабличное.ПредставлениеСписка(СчетаГруппы.СчетаУчетаРБП);
		ПараметрыТекстовРасшифровки.СчетаУчетаРБП = ЗаполнениеБухгалтерскойОтчетностиТабличное.ПредставлениеСпискаСчетовРодительныйПадеж(
			ПредставленияСчетов);
		ПараметрыТекстовРасшифровки.СчетуУчетаРБП = ЗаполнениеБухгалтерскойОтчетностиТабличное.ПредставлениеСпискаСчетовДательныйПадеж(
			ПредставленияСчетов);
		КонецЕсли;
		
	Если ЗначениеЗаполнено(СчетаГруппы.СчетаОбъектовРезервов) Тогда
		ПредставленияСчетов = ЗаполнениеБухгалтерскойОтчетностиТабличное.ПредставлениеСписка(СчетаГруппы.СчетаОбъектовРезервов);
		ПараметрыТекстовРасшифровки.СчетеОбъектовРезервов = ЗаполнениеБухгалтерскойОтчетностиТабличное.ПредставлениеСпискаСчетовПредложныйПадеж(
			ПредставленияСчетов);
	КонецЕсли;

КонецПроцедуры

Процедура УстановитьПараметрыТекстовРасшифровкиПоСчету(ПараметрыТекстовРасшифровки, СтрокаСчет)
	
	ПараметрыТекстовРасшифровки.Счет = СтрокаСчет.Код;
	ПараметрыТекстовРасшифровки.РазвернутоПоВидамСубконто = "";
	ПараметрыТекстовРасшифровки.ПоВидамСубконто = "";
	
	ВидыСубконтоСтрокой = ВидыСубконтоСтрокой(СтрокаСчет);
	Если Не ПустаяСтрока(ВидыСубконтоСтрокой) Тогда
		Если СтрокаСчет.ВидСчета = ВидСчета.АктивноПассивный Тогда
			ПараметрыТекстовРасшифровки.Вставить("РазвернутоПоВидамСубконто", СтрШаблон(" - развернуто по субконто %1", ВидыСубконтоСтрокой));
		КонецЕсли;
		ПараметрыТекстовРасшифровки.Вставить("ПоВидамСубконто", СтрШаблон(" - по субконто %1", ВидыСубконтоСтрокой));
	КонецЕсли;

КонецПроцедуры

Процедура ДобавитьСлагаемыеРасчетыАренды(ВыводТаблицы, СтрокаСчет, КонтекстЗаполненияОтчета, Описание)
	
	ИмяОтчета = "Отчет.СправкаРасчетКлассификацияПоСрокамАрендныхОбязательств.ФормаОбъекта";
	
	КонецПериода = КонтекстЗаполненияОтчета.Период.Конец;
	КонецПредыдущегоПериода = Новый МоментВремениСУточнениемПериода(КонтекстЗаполненияОтчета.Период.Начало - 1, БухгалтерскийУчет.ВерхняяГраницаУточненияПериода());

	ИмяКолонки = "НачалоНоминал";
	Значение = СтрокаСчет.НачалоОстаток;
	Если Значение <> 0 Тогда
		НастройкиОтчета = ЗначенияНастроекРасшифровкиПоказателейБалансаПоАренде(КонтекстЗаполненияОтчета.Организации, КонецПредыдущегоПериода);
		Отчет = ЗаполнениеБухгалтерскойОтчетности.НастройкиРасшифровкиСправкиРасчетаКлассификацииЗадолженности(НастройкиОтчета, ИмяОтчета);
		ЗаполнениеБухгалтерскойОтчетностиТабличное.ДобавитьСлагаемое(ВыводТаблицы, ИмяКолонки, Описание, Значение, , Отчет);
	КонецЕсли;
	
	ИмяКолонки = "ПоступилоНоминал";
	Значение = СтрокаСчет.Поступило;
	Если Значение <> 0 Тогда
		ЗаполнениеБухгалтерскойОтчетностиТабличное.ДобавитьСлагаемое(ВыводТаблицы, ИмяКолонки, Описание, Значение);
	КонецЕсли;
	
	ИмяКолонки = "СписаноНоминал";
	Значение = - СтрокаСчет.Погашено;
	Если Значение <> 0 Тогда
		ЗаполнениеБухгалтерскойОтчетностиТабличное.ДобавитьСлагаемое(ВыводТаблицы, ИмяКолонки, Описание, Значение);
	КонецЕсли;
	
	ИмяКолонки = "Переклассифицировано";
	Значение = СтрокаСчет.Переклассифицировано;
	Если Значение <> 0 Тогда
