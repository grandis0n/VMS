		ИмяКолонки = "КонецРезерв";
		ШаблоныЗаголовки = ЗаполнениеБухгалтерскойОтчетностиТабличное.НовыйШаблонЗаголовковРасшифровки();
		ШаблоныЗаголовки.ЗаголовокГруппы = СтрЗаменить(ЗаголовкиГрупп.Резерв, "[Период]", "[КонецПериода]");
		ШаблоныЗаголовки.ПорядокРасчета = СтрШаблон(НСтр("ru = 'Сальдо по кредиту [СчетаРезервов] по объектам, отраженным в графе ""Конец периода - по условиям договора""%1'"), ОписаниеУчитываетсяНаСчетах);
		Шаблоны.Вставить(ИмяКолонки, ШаблоныЗаголовки);
	#КонецОбласти

	#Область ВосстановленоРезерв
		ИмяКолонки = "ВосстановленоРезерв";
		ШаблоныЗаголовки = ЗаполнениеБухгалтерскойОтчетностиТабличное.НовыйШаблонЗаголовковРасшифровки();
		ШаблоныЗаголовки.ЗаголовокГруппы = ЗаголовкиГрупп.РезервВосстановлено;
		
		ОписаниеУчитываетсяНаСчетах = "";
		Если Группа.ЭтоСчетОбъектовРезервов Тогда
			ОписаниеУчитываетсяНаСчетах = НСтр("ru = ' (учитываемой на [СчетеОбъектовРезервов])'");
		КонецЕсли;
		ШаблоныЗаголовки.ПорядокРасчета = СтрШаблон(
			НСтр("ru = 'Уменьшение сумм резервов по сомнительным долгам за период, определенное отдельно по каждому объекту задолженности%1, исходя из разницы показателей на начало и конец периода'"),
			ОписаниеУчитываетсяНаСчетах);
		Шаблоны.Вставить(ИмяКолонки, ШаблоныЗаголовки);
	#КонецОбласти
	
	КонецЕсли;

КонецПроцедуры

Процедура УстановитьШаблоныЗаголовковПросроченнаяПоГруппе(Шаблоны, ШаблоныРасшифровкиОбщие, СчетаГруппыРаздела)

	ТекстСчетовСтрокаСальдо = ШаблонПорядкаРасчетаСчетов(ШаблоныРасшифровкиОбщие.ЧастиПорядкаРасчета, СчетаГруппыРаздела);
	
	ШаблонПорядкаРасчета = Новый Массив;
	ШаблонПорядкаРасчета.Добавить(ТекстСчетовСтрокаСальдо);
	Если ЗначениеЗаполнено(СчетаГруппыРаздела.СчетаРасчетовРазвернуто) Тогда
		ШаблонПорядкаРасчета.Добавить(ШаблоныРасшифровкиОбщие.ЧастиПорядкаРасчета.ОписаниеСальдоРазвернуто);
	КонецЕсли;
	ШаблонПорядкаРасчета.Добавить(ШаблоныРасшифровкиОбщие.ЧастиПорядкаРасчета.СрокиПогашения);
	
	ПорядокРасчета = СтрСоединить(ШаблонПорядкаРасчета, " ");
	
	Шаблоны["НачалоНоминальнаяВеличина"].ПорядокРасчета = СтрЗаменить(ПорядокРасчета, "[СрокПогашения]", "ранее [КонецПредшествующегоПериода]");
	
	Шаблоны["КонецНоминальнаяВеличина"].ПорядокРасчета = СтрЗаменить(ПорядокРасчета, "[СрокПогашения]", "ранее [КонецПериода]");

КонецПроцедуры

Процедура ПереопределитьШаблоныЗаголовковГруппыАвансыПоАренде(ШаблоныЗаголовков)
	
	ШаблонНоминал = НСтр("ru = 'Положительное сальдо по [СчетуАренды] за вычетом относящегося к нему НДС (сальдо по кредиту [СчетаНДСАвансовВыданных]). Расчет выполняется отдельно по каждому договору аренды (лизинга)[СуммарноПоФилиалам]'");
	
