Процедура ПереопределитьШаблоныЗаголовковГруппыРасчетыПоАренде(ШаблоныЗаголовков, ДолгосрочнаяЗадолженность)
	
	Если ДолгосрочнаяЗадолженность Тогда
		ШаблонНоминал = 
			НСтр("ru = 'Отрицательное сальдо по [СчетуАренды] за вычетом относящегося к нему НДС (сальдо по кредиту [СчетаНДСАвансовВыданных]). Включаются суммы со сроком действия договора не ранее [СрокПогашенияНачало]
		        |Расчет выполняется отдельно по каждому договору аренды (лизинга)[СуммарноПоФилиалам].'");
		Если УчетнаяПолитика.ПоддерживаетсяДисконтированиеОбязательств() Тогда
			РасчетПоказателейБалансаПоОбязательствамГрафики.ЗаполнитьШаблонРасшифровкиПоАрендеПояснениеБалансаОбязательстваНачалоПериода(ШаблонНоминал);
		КонецЕсли;
		
		ШаблонПоступилоНоминал =
			НСтр("ru = 'Увеличение долгосрочного обязательства за период, определенное отдельно по каждому договору аренды (лизинга), исходя из разницы показателей на начало и конец периода.'");

		ШаблонСписаноНоминал = 
			НСтр("ru = 'Уменьшение долгосрочного обязательства за период, определенное отдельно по каждому договору аренды (лизинга), исходя из разницы показателей на начало и конец периода.'");
	Иначе 
		ШаблонНоминал = НСтр("ru = 'Отрицательное сальдо по [СчетуАренды] за вычетом относящегося к нему НДС (сальдо по кредиту [СчетаНДСАвансовВыданных]), уменьшенное на долгосрочное обязательство по аренде.
		                |Расчет выполняется отдельно по каждому договору аренды (лизинга)[СуммарноПоФилиалам].'");
		
		ШаблонПоступилоНоминал = 
			НСтр("ru = 'Увеличение краткосрочного обязательства за период, определенное отдельно по каждому договору аренды (лизинга), исходя из разницы показателей на начало и конец периода.'");;

		ШаблонСписаноНоминал = 
			НСтр("ru = 'Уменьшение краткосрочного обязательства за период, определенное отдельно по каждому договору аренды (лизинга), исходя из разницы показателей на начало и конец периода.'");
	КонецЕсли;
	
	ШаблоныЗаголовков["НачалоНоминал"].ПорядокРасчета = ШаблонНоминал;
	
	ШаблоныЗаголовков["КонецНоминал"].ПорядокРасчета = ШаблонНоминал;
	
	ШаблоныЗаголовков["ПоступилоНоминал"].ПорядокРасчета = ШаблонПоступилоНоминал;
		
	ШаблоныЗаголовков["СписаноНоминал"].ПорядокРасчета = ШаблонСписаноНоминал;
		
КонецПроцедуры

Функция НовыйСчетаРасчетовГруппыРаздела()
	
	СчетаГруппы = Новый Структура;
	СчетаГруппы.Вставить("СчетаРасчетов",           Новый Массив); // из ПланСчетовСсылка.Хозрасчетный
	СчетаГруппы.Вставить("СчетаРасчетовСвернуто",   Новый Массив); // из Строка - код счета
	СчетаГруппы.Вставить("СчетаРасчетовРазвернуто", Новый Массив); // из Строка - код счета
	СчетаГруппы.Вставить("СчетаАвансов",            Новый Массив); // из Строка - код счета
	СчетаГруппы.Вставить("СчетаУчетаРБП",           Новый Массив); // из Строка - код счета
	СчетаГруппы.Вставить("СчетаОбъектовРезервов",   Новый Массив); // из Строка - код счета
	
	Возврат СчетаГруппы;
КонецФункции

Функция ОпределитьСчетаГруппыРаздела(СтрокиСчетов, ВидЗадолженности, ПараметрыЗаполнения)
	
	СчетаГруппы = НовыйСчетаРасчетовГруппыРаздела();
	
	Для Каждого СтрокаСчета Из СтрокиСчетов Цикл
		СчетаГруппы.СчетаРасчетов.Добавить(СтрокаСчета.Счет);
		Если ВидЗадолженности = Перечисления.ВидыЗадолженности.Дебиторская Тогда
			Если ПараметрыЗаполнения.СчетаОбъектовРезервов.Найти(СтрокаСчета.Счет) <> Неопределено Тогда
				СчетаГруппы.СчетаОбъектовРезервов.Добавить(СтрокаСчета.Код);
			КонецЕсли;
			Если ПараметрыЗаполнения.АвансыВыданные.РазделятьАвансыПоВидамАктивов И ПараметрыЗаполнения.АвансыВыданные.СчетаУчета.Найти(СтрокаСчета.Счет) <> Неопределено Тогда
				СчетаГруппы.СчетаАвансов.Добавить(СтрокаСчета.Код);
				Продолжить;
			ИначеЕсли ПараметрыЗаполнения.РасходыБудущихПериодов.СчетаУчета.Найти(СтрокаСчета.Счет) <> Неопределено Тогда
				СчетаГруппы.СчетаУчетаРБП.Добавить(СтрокаСчета.Код);
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		
		РазвернутоПоСубконто =
			СтрокаСчета.ВидСчета = ВидСчета.АктивноПассивный
			И (ЗначениеЗаполнено(СтрокаСчета.ВидСубконто1)
			Или ЗначениеЗаполнено(СтрокаСчета.ВидСубконто2)
			Или ЗначениеЗаполнено(СтрокаСчета.ВидСубконто3));
		
		Если РазвернутоПоСубконто Тогда
			СчетаГруппы.СчетаРасчетовРазвернуто.Добавить(СтрокаСчета.Код);
		Иначе
			СчетаГруппы.СчетаРасчетовСвернуто.Добавить(СтрокаСчета.Код);
		КонецЕсли;
	КонецЦикла;
	
	Возврат СчетаГруппы;
	
КонецФункции

Функция ВидыСубконтоСтрокой(СтрокаСчет)

	ВидыСубконтоСтрокой = "";
	ВидыСубконто = Новый Массив;
	Если ЗначениеЗаполнено(СтрокаСчет.ВидСубконто1) Тогда
		ВидыСубконто.Добавить(СтрШаблон("""%1""", СтрокаСчет.ВидСубконто1));
	КонецЕсли;
	Если ЗначениеЗаполнено(СтрокаСчет.ВидСубконто2) Тогда
		ВидыСубконто.Добавить(СтрШаблон("""%1""", СтрокаСчет.ВидСубконто2));
	КонецЕсли;
	Если ЗначениеЗаполнено(СтрокаСчет.ВидСубконто3) Тогда
		ВидыСубконто.Добавить(СтрШаблон("""%1""", СтрокаСчет.ВидСубконто3));
	КонецЕсли;
	ВидыСубконтоСтрокой = СтрСоединить(ВидыСубконто, ",");
	
	Возврат ВидыСубконтоСтрокой;
	
КонецФункции

#КонецОбласти

#Область ВременныеТаблицы

Процедура СоздатьВременныеТаблицыДебиторскойЗадолженностиНаДату(МенеджерВременныхТаблиц, КонтекстРасчета, СчетаРасчетов, ПараметрыЗаполнения, КлассифицироватьАктивыОбязательства, ИменаТаблиц)
	
	// Все созданные в процедуре временные таблицы будут удалены, кроме имеющихся в менеджере временных таблиц
	ВременныеТаблицы = Новый Массив;
	Для Каждого ИмяТаблицы Из МенеджерВременныхТаблиц.Таблицы Цикл
		ВременныеТаблицы.Добавить(ИмяТаблицы.ПолноеИмя);
	КонецЦикла;
	
	Организации = КонтекстРасчета.Организации;
	Период = КонтекстРасчета.Период;
	Дата = КонтекстРасчета.Дата;
	ВидЗадолженности = Перечисления.ВидыЗадолженности.Дебиторская;
	
	СчетаУчетаАвансов = ПараметрыЗаполнения.АвансыВыданные.СчетаУчета;
	СчетаУчетаРБП = ПараметрыЗаполнения.РасходыБудущихПериодов.СчетаУчета;
	
	КлассификацияЗадолженности.СоздатьВременныеТаблицыЗадолженностиОстаткиБУ(
		МенеджерВременныхТаблиц,
		Период,
		Организации,
		СчетаРасчетов);
	
	Если КлассифицироватьАктивыОбязательства Тогда
		КлассификацияЗадолженности.СоздатьВременныеТаблицыЗадолженностьПоСрочности(
			МенеджерВременныхТаблиц,
			Дата,
			Организации,
			ВидЗадолженности);
		
		КлассификацияЗадолженности.СоздатьВременныеТаблицыРасходыБудущихПериодовПоСрочности(
			МенеджерВременныхТаблиц,
			Дата,
			Организации);
		
		СчетаРасчетовПоАренде = ПланыСчетов.Хозрасчетный.СчетаРасчетовПоАренде();
		КлассификацияЗадолженности.СоздатьВременныеТаблицыКлассифицированныеРасчетыпоАренде(
			МенеджерВременныхТаблиц,
			Дата,
			Организации,
			СчетаРасчетовПоАренде,
			ИменаТаблиц.РасчетыПоАренде,
			Ложь);
		
	Иначе
		СчетаРасчетовСПокупателями = КлассификацияЗадолженности.СчетаРасчетовСПокупателями();
		СоздатьВременныеТаблицыРасчетыПоСрокам(
			МенеджерВременныхТаблиц,
			СчетаРасчетовСПокупателями);
		
		СоздатьВременныеТаблицыРасчетыПоАрендеОстаткиБУ(
			МенеджерВременныхТаблиц,
			КонтекстРасчета,
			ИменаТаблиц.РасчетыПоАренде);
		
		СоздатьВременныеТаблицыОбъектыАвансовАренды(
			МенеджерВременныхТаблиц,
			ИменаТаблиц.РасчетыПоАренде);
			
		СоздатьВременныеТаблицыОбъектыРезервовПоСомнительнымДолгам(
			МенеджерВременныхТаблиц);
	КонецЕсли;
	
	КлассификацияЗадолженности.СоздатьВременныеТаблицыНДСАвансов(
		МенеджерВременныхТаблиц,
		КлассифицироватьАктивыОбязательства,
		Период,
		Организации,
		ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.СФПолученные,
		ИменаТаблиц.НДСАвансов);

	КлассификацияЗадолженности.СоздатьВременныеТаблицыРезервыПоСомнительнымДолгам(
		МенеджерВременныхТаблиц,
		КлассифицироватьАктивыОбязательства,
		Период,
		Организации,
		ИменаТаблиц.Резервы);
		
	КлассификацияЗадолженности.СоздатьВременныеТаблицыКлассифицированныеАвансыВыданные(
		МенеджерВременныхТаблиц,
		Период,
		Организации,
		СчетаУчетаАвансов,
		"АвансыВыданные",
		Ложь);
	
	КлассификацияЗадолженности.СоздатьВременныеТаблицыКлассифицированныеРасходыБудущихПериодов(
		МенеджерВременныхТаблиц,
		Период,
		Организации,
		СчетаУчетаРБП,
		"РасходыБудущихПериодов",
		Ложь);

	СоздатьВременныеТаблицыОстаткиЗадолженности(
		МенеджерВременныхТаблиц,
		ПараметрыЗаполнения,
		СчетаРасчетов,
		Дата,
		КлассифицироватьАктивыОбязательства,
		ИменаТаблиц.Задолженность);
		
	Для Каждого Элемент Из ИменаТаблиц Цикл
		ВременныеТаблицы.Добавить(Элемент.Значение);
	КонецЦикла;

	ОбщегоНазначенияБП.УничтожитьВременныеТаблицы(МенеджерВременныхТаблиц, , ВременныеТаблицы);
	
КонецПроцедуры

Процедура СоздатьВременныеТаблицыКредиторскойЗадолженностиНаДату(МенеджерВременныхТаблиц, КонтекстРасчета, СчетаРасчетов, ПараметрыЗаполнения, КлассифицироватьАктивыОбязательства, ИменаТаблиц)
	
	// Все созданные в процедуре временные таблицы будут удалены, кроме имеющихся в менеджере временных таблиц
	ВременныеТаблицы = Новый Массив;
	Для Каждого ИмяТаблицы Из МенеджерВременныхТаблиц.Таблицы Цикл
		ВременныеТаблицы.Добавить(ИмяТаблицы.ПолноеИмя);
	КонецЦикла;
	
	Организации = КонтекстРасчета.Организации;
	Период = КонтекстРасчета.Период;
	Дата = КонтекстРасчета.Дата;
	ВидЗадолженности = Перечисления.ВидыЗадолженности.Кредиторская;
	
	КлассификацияЗадолженности.СоздатьВременныеТаблицыЗадолженностиОстаткиБУ(
		МенеджерВременныхТаблиц,
		Период,
		Организации,
		СчетаРасчетов);
	
	Если КлассифицироватьАктивыОбязательства Тогда
		КлассификацияЗадолженности.СоздатьВременныеТаблицыЗадолженностьПоСрочности(
			МенеджерВременныхТаблиц,
			Дата,
			Организации,
			ВидЗадолженности);
			
		СчетаРасчетовПоАренде = ПланыСчетов.Хозрасчетный.СчетаРасчетовПоАренде();
		КлассификацияЗадолженности.СоздатьВременныеТаблицыКлассифицированныеРасчетыпоАренде(
			МенеджерВременныхТаблиц,
			Дата,
			Организации,
			СчетаРасчетовПоАренде,
			ИменаТаблиц.РасчетыПоАренде,
			Ложь);
	Иначе
		СчетаРасчетовСПоставщиками = КлассификацияЗадолженности.СчетаРасчетовСПоставщиками();
		СоздатьВременныеТаблицыРасчетыПоСрокам(
			МенеджерВременныхТаблиц,
			СчетаРасчетовСПоставщиками);
		
		СоздатьВременныеТаблицыРасчетыПоАрендеОстаткиБУ(
			МенеджерВременныхТаблиц,
			КонтекстРасчета,
			ИменаТаблиц.РасчетыПоАренде);
			
		СоздатьВременныеТаблицыОбъектыРассрочки(
			МенеджерВременныхТаблиц,
			Дата);
		
	КонецЕсли;
		
	КлассификацияЗадолженности.СоздатьВременныеТаблицыНДСАвансов(
		МенеджерВременныхТаблиц,
		КлассифицироватьАктивыОбязательства,
		Период,
		Организации,
		ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.СФВыданные,
		ИменаТаблиц.НДСАвансов);
		
	КлассификацияЗадолженности.СоздатьВременныеТаблицыПроцентыПоРассрочке(
		МенеджерВременныхТаблиц,
		КлассифицироватьАктивыОбязательства,
		Период,
		Организации,
		ИменаТаблиц.Проценты);
		
	СоздатьВременныеТаблицыОстаткиЗадолженности(
		МенеджерВременныхТаблиц,
		ПараметрыЗаполнения,
		СчетаРасчетов,
		Дата,
		КлассифицироватьАктивыОбязательства,
		ИменаТаблиц.Задолженность);
		
	Для Каждого Элемент Из ИменаТаблиц Цикл
		ВременныеТаблицы.Добавить(Элемент.Значение);
	КонецЦикла;

	ОбщегоНазначенияБП.УничтожитьВременныеТаблицы(МенеджерВременныхТаблиц, , ВременныеТаблицы);
	
КонецПроцедуры

Процедура СоздатьВременныеТаблицыАвансыПоАренде(МенеджерВременныхТаблиц)

	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Организации.ГоловнаяОрганизация КАК Организация,
	|	ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.РасчетыПоАренде) КАК Счет,
	|	РасчетыЗаПериод.Субконто1 КАК Субконто1,
	|	РасчетыЗаПериод.Субконто2 КАК Субконто2,
	|	НЕОПРЕДЕЛЕНО КАК Субконто3,
	|	СУММА(РасчетыЗаПериод.Начало) КАК Начало,
	|	СУММА(РасчетыЗаПериод.Конец) КАК Конец,
	|	ВЫБОР
	|		КОГДА СУММА(РасчетыЗаПериод.Конец) - СУММА(РасчетыЗаПериод.Начало) > 0
	|			ТОГДА СУММА(РасчетыЗаПериод.Конец) - СУММА(РасчетыЗаПериод.Начало)
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК Поступило,
	|	ВЫБОР
	|		КОГДА СУММА(РасчетыЗаПериод.Конец) - СУММА(РасчетыЗаПериод.Начало) < 0
	|			ТОГДА СУММА(РасчетыЗаПериод.Начало) - СУММА(РасчетыЗаПериод.Конец)
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК Погашено
	|ПОМЕСТИТЬ АвансыПоАренде
	|ИЗ
	|	(ВЫБРАТЬ
	|		РасчетыПоАренде.Организация КАК Организация,
	|		РасчетыПоАренде.Субконто1 КАК Субконто1,
	|		РасчетыПоАренде.Субконто2 КАК Субконто2,
	|		РасчетыПоАренде.АвансыПоАренде КАК Начало,
	|		0 КАК Конец
	|	ИЗ
	|		РасчетыПоАрендеНачало КАК РасчетыПоАренде
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		РасчетыПоАренде.Организация,
	|		РасчетыПоАренде.Субконто1,
	|		РасчетыПоАренде.Субконто2,
	|		0,
	|		РасчетыПоАренде.АвансыПоАренде
	|	ИЗ
	|		РасчетыПоАрендеКонец КАК РасчетыПоАренде) КАК РасчетыЗаПериод
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Организации КАК Организации
	|		ПО РасчетыЗаПериод.Организация = Организации.Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	Организации.ГоловнаяОрганизация,
	|	РасчетыЗаПериод.Субконто1,
	|	РасчетыЗаПериод.Субконто2
	|
	|ИМЕЮЩИЕ
	|	(СУММА(РасчетыЗаПериод.Начало) <> 0
	|		ИЛИ СУММА(РасчетыЗаПериод.Конец) <> 0)";
	
	Запрос.Выполнить();
	
КонецПроцедуры

Процедура СоздатьВременныеТаблицыАрендныеОбязательства(МенеджерВременныхТаблиц)

	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Организации.ГоловнаяОрганизация КАК Организация,
	|	ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.РасчетыПоАренде) КАК Счет,
	|	РасчетыЗаПериод.Субконто1 КАК Субконто1,
	|	РасчетыЗаПериод.Субконто2 КАК Субконто2,
	|	НЕОПРЕДЕЛЕНО КАК Субконто3,
	|	МАКСИМУМ(РасчетыЗаПериод.ЕстьДолгосрочнаяЧасть) КАК ЕстьДолгосрочнаяЧасть,
	|	МАКСИМУМ(РасчетыЗаПериод.ЕстьКраткосрочнаяЧасть) КАК ЕстьКраткосрочнаяЧасть,
	|	СУММА(РасчетыЗаПериод.НачалоОбязательство) КАК НачалоОбязательство,
	|	СУММА(РасчетыЗаПериод.НачалоКраткосрочноеОбязательство) КАК НачалоКраткосрочноеОбязательство,
	|	СУММА(РасчетыЗаПериод.НачалоДолгосрочноеОбязательство) КАК НачалоДолгосрочноеОбязательство,
	|	СУММА(РасчетыЗаПериод.КонецОбязательство) КАК КонецОбязательство,
	|	СУММА(РасчетыЗаПериод.КонецКраткосрочноеОбязательство) КАК КонецКраткосрочноеОбязательство,
	|	СУММА(РасчетыЗаПериод.КонецДолгосрочноеОбязательство) КАК КонецДолгосрочноеОбязательство,
	|	ВЫБОР
	|		КОГДА СУММА(РасчетыЗаПериод.КонецОбязательство) - СУММА(РасчетыЗаПериод.НачалоОбязательство) > 0
	|			ТОГДА СУММА(РасчетыЗаПериод.КонецОбязательство) - СУММА(РасчетыЗаПериод.НачалоОбязательство)
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК Поступило,
	|	ВЫБОР
	|		КОГДА СУММА(РасчетыЗаПериод.КонецОбязательство) - СУММА(РасчетыЗаПериод.НачалоОбязательство) < 0
	|			ТОГДА СУММА(РасчетыЗаПериод.НачалоОбязательство) - СУММА(РасчетыЗаПериод.КонецОбязательство)
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК Погашено
	|ПОМЕСТИТЬ АрендныеОбязательства
	|ИЗ
	|	(ВЫБРАТЬ
	|		РасчетыПоАренде.Организация КАК Организация,
	|		РасчетыПоАренде.Субконто1 КАК Субконто1,
	|		РасчетыПоАренде.Субконто2 КАК Субконто2,
	|		РасчетыПоАренде.КраткосрочноеОбязательство <> 0 КАК ЕстьКраткосрочнаяЧасть,
	|		РасчетыПоАренде.ДолгосрочноеОбязательство <> 0 КАК ЕстьДолгосрочнаяЧасть,
	|		РасчетыПоАренде.Обязательство КАК НачалоОбязательство,
	|		РасчетыПоАренде.КраткосрочноеОбязательство КАК НачалоКраткосрочноеОбязательство,
	|		РасчетыПоАренде.ДолгосрочноеОбязательство КАК НачалоДолгосрочноеОбязательство,
	|		0 КАК КонецОбязательство,
	|		0 КАК КонецКраткосрочноеОбязательство,
	|		0 КАК КонецДолгосрочноеОбязательство
	|	ИЗ
	|		РасчетыПоАрендеНачало КАК РасчетыПоАренде
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		РасчетыПоАренде.Организация,
	|		РасчетыПоАренде.Субконто1,
	|		РасчетыПоАренде.Субконто2,
	|		РасчетыПоАренде.КраткосрочноеОбязательство <> 0,
	|		РасчетыПоАренде.ДолгосрочноеОбязательство <> 0,
	|		0,
	|		0,
	|		0,
	|		РасчетыПоАренде.Обязательство,
	|		РасчетыПоАренде.КраткосрочноеОбязательство,
	|		РасчетыПоАренде.ДолгосрочноеОбязательство
	|	ИЗ
	|		РасчетыПоАрендеКонец КАК РасчетыПоАренде) КАК РасчетыЗаПериод
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Организации КАК Организации
	|		ПО РасчетыЗаПериод.Организация = Организации.Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	РасчетыЗаПериод.Субконто1,
	|	РасчетыЗаПериод.Субконто2,
	|	Организации.ГоловнаяОрганизация
	|
	|ИМЕЮЩИЕ
	|	(СУММА(РасчетыЗаПериод.НачалоОбязательство) <> 0
	|		ИЛИ СУММА(РасчетыЗаПериод.КонецОбязательство) <> 0)";
	
	Запрос.Выполнить();
	
КонецПроцедуры

Процедура СоздатьВременныеТаблицыРасчетыПоСрокам(МенеджерВременныхТаблиц, СчетаРасчетов)
	
	// Предполагается, что в качестве договора используется Субконто2, а в качестве документа расчетов - Субконто3
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("СчетаРасчетов", СчетаРасчетов);
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	ОстаткиБУ.Организация КАК Организация,
	|	ОстаткиБУ.Счет КАК Счет,
	|	ОстаткиБУ.Субконто1 КАК Субконто1,
	|	ОстаткиБУ.Субконто2 КАК Субконто2,
	|	ОстаткиБУ.Субконто3 КАК Субконто3,
	|	ОстаткиБУ.ОстатокДт КАК ОстатокДт,
	|	ОстаткиБУ.ОстатокКт КАК ОстатокКт,
	|	Хозрасчетный.Вид КАК Вид,
	|	Хозрасчетный.Вид = ЗНАЧЕНИЕ(ВидСчета.Активный)
	|		ИЛИ Хозрасчетный.Вид = ЗНАЧЕНИЕ(ВидСчета.АктивноПассивный)
	|			И ОстаткиБУ.Остаток > 0 КАК Актив
	|ПОМЕСТИТЬ РасчетыПоСрокам
	|ИЗ
	|	ОстаткиБУ КАК ОстаткиБУ
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.Хозрасчетный КАК Хозрасчетный
	|		ПО ОстаткиБУ.Счет = Хозрасчетный.Ссылка
	|ГДЕ
	|	ОстаткиБУ.Счет В(&СчетаРасчетов)";
	
	ПараметрыСвязи = КлассификацияЗадолженности.НовыйПараметрыСвязиВременнойТаблицыРасчеты();
	ПараметрыСвязи.ИмяТаблицы =         "ОстаткиБУ";
	ПараметрыСвязи.ИмяПоляСчет =        "Счет";
	ПараметрыСвязи.ИмяПоляОрганизация = "Организация";
	ПараметрыСвязи.ИмяПоляДоговор =     "Субконто2";
	ПараметрыСвязи.ИмяПоляДокумент =    "Субконто3";
	
	КонтекстЗапроса = КлассификацияЗадолженности.НовыйКонтекстЗапросаОстаткиЗадолженности();
	КлассификацияЗадолженности.ДополнитьЗапросДаннымиПоСрокамОплаты(ТекстЗапроса, ПараметрыСвязи, КонтекстЗапроса.ПараметрыЗапроса);
	
	Для Каждого Параметр Из КонтекстЗапроса.ПараметрыЗапроса Цикл
		Запрос.УстановитьПараметр(Параметр.Ключ, Параметр.Значение);
	КонецЦикла;
	
	Запрос.Текст = ТекстЗапроса;
	Запрос.Выполнить();
	
КонецПроцедуры

// Рассчитывает задолженность с выделением долгосрочной и просроченной частей
//
Процедура СоздатьВременныеТаблицыОстаткиЗадолженности(МенеджерВременныхТаблиц, ПараметрыЗаполнения, СчетаРасчетов, Дата, КлассифицироватьАктивыОбязательства, ИмяВременнойТаблицы)

	// Необходимо определить счета расчетов, по которым уже классифицирована задолженность. Например, авансы, расходы будущих периодов, расчеты по аренде.
	// Они будут исключены из общего списка счетов при получении бухгалтерских остатков и классифицированных расчетных сумм задолженности
	СчетаСДопПризнаками = Новый Массив;
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(СчетаСДопПризнаками, ПланыСчетов.Хозрасчетный.СчетаРасчетовПоАренде());
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;

	ТекстыЗапроса = Новый Массив;
	ТекстыЗапроса.Добавить(
	"ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка) КАК Организация,
	|	ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ПустаяСсылка) КАК Счет,
	|	НЕОПРЕДЕЛЕНО КАК Субконто1,
	|	НЕОПРЕДЕЛЕНО КАК Субконто2,
	|	НЕОПРЕДЕЛЕНО КАК Субконто3,
	|	0 КАК ОстатокДт,
	|	0 КАК ОстатокКт,
	|	0 КАК РасчетнаяКраткосрочнаяЧасть,
	|	0 КАК РасчетнаяДолгосрочнаяЧасть,
	|	0 КАК РасчетнаяПросроченнаяЧасть
	|ПОМЕСТИТЬ ВсеРасчеты
	|ИЗ
	|	ОстаткиБУ КАК ОстаткиБУ
	|ГДЕ
	|	ЛОЖЬ");

	Если МенеджерВременныхТаблиц.Таблицы.Найти("АвансыВыданные") <> Неопределено Тогда
		ТекстЗапроса =
		"ВЫБРАТЬ
		|	Авансы.Организация КАК Организация,
		|	Авансы.Счет КАК Счет,
		|	Авансы.Субконто1 КАК Субконто1,
		|	Авансы.Субконто2 КАК Субконто2,
		|	Авансы.Субконто3 КАК Субконто3,
		|	Авансы.ОстатокДт КАК ОстатокДт,
		|	Авансы.ОстатокКт КАК ОстатокКт,
		|	0 КАК РасчетнаяКраткосрочнаяЧасть,
		|	Авансы.ОстатокДолгосрочнойЧасти КАК РасчетнаяДолгосрочнаяЧасть,
		|	Авансы.ОстатокПросроченнойЧасти КАК РасчетнаяПросроченнаяЧасть
		|ИЗ
		|	АвансыВыданные КАК Авансы
		|ГДЕ
		|	&РазделятьАвансыПоВидамАктивов";
		
		Если ПараметрыЗаполнения.АвансыВыданные.РазделятьАвансыПоВидамАктивов Тогда
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&РазделятьАвансыПоВидамАктивов", "НЕ Авансы.ВидАктива В (&ИсключаемыеВидыАктивовАвансов)");
		Иначе
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&РазделятьАвансыПоВидамАктивов", "ИСТИНА");
		КонецЕсли;
		Запрос.УстановитьПараметр("ИсключаемыеВидыАктивовАвансов", КлассификацияЗадолженности.ВидыАктивовАвансовНеОтносящиесяКДебиторскойЗадолженности());

		ТекстыЗапроса.Добавить(ТекстЗапроса);
		
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(СчетаСДопПризнаками, ПараметрыЗаполнения.АвансыВыданные.СчетаУчета);
	КонецЕсли;
	
	Если МенеджерВременныхТаблиц.Таблицы.Найти("РасходыБудущихПериодов") <> Неопределено Тогда
		ТекстыЗапроса.Добавить(
		"ВЫБРАТЬ
		|	РасходыБудущихПериодов.Организация КАК Организация,
		|	РасходыБудущихПериодов.Счет КАК Счет,
		|	РасходыБудущихПериодов.Субконто1 КАК Субконто1,
		|	РасходыБудущихПериодов.Субконто2 КАК Субконто2,
		|	РасходыБудущихПериодов.Субконто3 КАК Субконто3,
		|	РасходыБудущихПериодов.Остаток КАК ОстатокДт,
		|	0 КАК ОстатокКт,
		|	0 КАК РасчетнаяКраткосрочнаяЧасть,
		|	РасходыБудущихПериодов.ОстатокДолгосрочнойЧасти КАК РасчетнаяДолгосрочнаяЧасть,
		|	РасходыБудущихПериодов.ОстатокПросроченнойЧасти КАК РасчетнаяПросроченнаяЧасть
		|ИЗ
		|	РасходыБудущихПериодов КАК РасходыБудущихПериодов
		|ГДЕ
		|	РасходыБудущихПериодов.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивовДляРБП.ДебиторскаяЗадолженность)");
		
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(СчетаСДопПризнаками, ПараметрыЗаполнения.РасходыБудущихПериодов.СчетаУчета);
	КонецЕсли;

	СчетаРасчетовПрочие = ОбщегоНазначения.СкопироватьРекурсивно(СчетаРасчетов);
	Для Каждого Счет Из СчетаСДопПризнаками Цикл
		ОбщегоНазначенияКлиентСервер.УдалитьВсеВхожденияЗначенияИзМассива(СчетаРасчетовПрочие, Счет);
	КонецЦикла;

	Запрос.УстановитьПараметр("СчетаРасчетов", СчетаРасчетовПрочие);
	
	ТекстыЗапроса.Добавить(
	"ВЫБРАТЬ
	|	ОстаткиБУ.Организация КАК Организация,
	|	ОстаткиБУ.Счет КАК Счет,
	|	ОстаткиБУ.Субконто1 КАК Субконто1,
	|	ОстаткиБУ.Субконто2 КАК Субконто2,
	|	ОстаткиБУ.Субконто3 КАК Субконто3,
	|	ОстаткиБУ.ОстатокДт КАК ОстатокДт,
	|	ОстаткиБУ.ОстатокКт КАК ОстатокКт,
	|	0 КАК РасчетнаяКраткосрочнаяЧасть,
	|	0 КАК РасчетнаяДолгосрочнаяЧасть,
	|	0 КАК РасчетнаяПросроченнаяЧасть
	|ИЗ
	|	ОстаткиБУ КАК ОстаткиБУ
	|ГДЕ
	|	ОстаткиБУ.Счет В(&СчетаРасчетов)");

	// Предполагается, что суммы долгосрочной и просроченной задолженности всегда положительные
	Если КлассифицироватьАктивыОбязательства Тогда
		
		ТекстыЗапроса.Добавить(
		"ВЫБРАТЬ
		|	КлассификацияПоСрокамЗадолженности.Организация КАК Организация,
		|	КлассификацияПоСрокамЗадолженности.Счет КАК Счет,
		|	КлассификацияПоСрокамЗадолженности.Субконто1 КАК Субконто1,
		|	КлассификацияПоСрокамЗадолженности.Субконто2 КАК Субконто2,
		|	КлассификацияПоСрокамЗадолженности.Субконто3 КАК Субконто3,
		|	0 КАК ОстатокДт,
		|	0 КАК ОстатокКт,
		|	ВЫБОР
		|		КОГДА КлассификацияПоСрокамЗадолженности.МенееГода
		|			ТОГДА КлассификацияПоСрокамЗадолженности.ОстатокДолга
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК РасчетнаяКраткосрочнаяЧасть,
		|	ВЫБОР
		|		КОГДА КлассификацияПоСрокамЗадолженности.БолееГода
		|			ТОГДА КлассификацияПоСрокамЗадолженности.ОстатокДолга
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК РасчетнаяДолгосрочнаяЧасть,
		|	ВЫБОР
		|		КОГДА КлассификацияПоСрокамЗадолженности.Просроченная
		|			ТОГДА КлассификацияПоСрокамЗадолженности.ОстатокДолга
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК РасчетнаяПросроченнаяЧасть
		|ИЗ
		|	КлассификацияПоСрокамЗадолженности КАК КлассификацияПоСрокамЗадолженности
		|ГДЕ
		|	КлассификацияПоСрокамЗадолженности.Счет В(&СчетаРасчетов)
		|	И КлассификацияПоСрокамЗадолженности.ОстатокДолга > 0");
		
	Иначе
		
		ТекстыЗапроса.Добавить(
		"ВЫБРАТЬ
		|	РасчетыПоСрокам.Организация КАК Организация,
		|	РасчетыПоСрокам.Счет КАК Счет,
		|	РасчетыПоСрокам.Субконто1 КАК Субконто1,
		|	РасчетыПоСрокам.Субконто2 КАК Субконто2,
		|	РасчетыПоСрокам.Субконто3 КАК Субконто3,
		|	0 КАК ОстатокДт,
		|	0 КАК ОстатокКт,
		|	0 КАК РасчетнаяКраткосрочнаяЧасть,
		|	ВЫБОР
		|		КОГДА РасчетыПоСрокам.СрокОплаты >= &ДатаНачалаДолгосрочногоПериода
		|			ТОГДА ВЫБОР
		|					КОГДА РасчетыПоСрокам.Актив
		|						ТОГДА РасчетыПоСрокам.ОстатокДт
		|					ИНАЧЕ РасчетыПоСрокам.ОстатокКт
		|				КОНЕЦ
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК РасчетнаяДолгосрочнаяЧасть,
		|	ВЫБОР
		|		КОГДА РасчетыПоСрокам.СрокОплаты <> ДАТАВРЕМЯ(1, 1, 1)
		|				И РасчетыПоСрокам.СрокОплаты <= &ДатаОтчетногоПериода
		|			ТОГДА ВЫБОР
		|					КОГДА РасчетыПоСрокам.Актив
		|						ТОГДА РасчетыПоСрокам.ОстатокДт
		|					ИНАЧЕ РасчетыПоСрокам.ОстатокКт
		|				КОНЕЦ
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК РасчетнаяПросроченнаяЧасть
		|ИЗ
		|	РасчетыПоСрокам КАК РасчетыПоСрокам
		|ГДЕ
		|	ВЫБОР
		|			КОГДА РасчетыПоСрокам.Актив
		|				ТОГДА РасчетыПоСрокам.ОстатокДт
		|			ИНАЧЕ РасчетыПоСрокам.ОстатокКт
		|		КОНЕЦ > 0");
		
		Запрос.УстановитьПараметр("ДатаНачалаДолгосрочногоПериода", КонецМесяца(ДобавитьМесяц(Дата, 12)) + 1);
		Запрос.УстановитьПараметр("ДатаОтчетногоПериода", Дата);
		
	КонецЕсли;
	
	ТекстЗапросаРасчеты = СтрСоединить(ТекстыЗапроса, ОбщегоНазначения.ТекстОбъединитьВсе());

	ТекстыЗапроса = Новый Массив;
	ТекстыЗапроса.Добавить(ТекстЗапросаРасчеты);
	
	ТекстыЗапроса.Добавить(
	"ВЫБРАТЬ
	|	ВсеРасчеты.Организация КАК Организация,
	|	ВсеРасчеты.Счет КАК Счет,
	|	ВЫБОР
	|		КОГДА Счета.ВидСубконто1 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконтоХозрасчетные.ПустаяСсылка)
	|			ТОГДА НЕОПРЕДЕЛЕНО
	|		ИНАЧЕ ВсеРасчеты.Субконто1
	|	КОНЕЦ КАК Субконто1,
	|	ВЫБОР
	|		КОГДА Счета.ВидСубконто2 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконтоХозрасчетные.ПустаяСсылка)
	|			ТОГДА НЕОПРЕДЕЛЕНО
	|		ИНАЧЕ ВсеРасчеты.Субконто2
	|	КОНЕЦ КАК Субконто2,
	|	ВЫБОР
	|		КОГДА Счета.ВидСубконто3 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконтоХозрасчетные.ПустаяСсылка)
	|			ТОГДА НЕОПРЕДЕЛЕНО
	|		ИНАЧЕ ВсеРасчеты.Субконто3
	|	КОНЕЦ КАК Субконто3,
	|	Счета.ВидСчета = ЗНАЧЕНИЕ(ВидСчета.Активный)
	|		ИЛИ Счета.ВидСчета = ЗНАЧЕНИЕ(ВидСчета.АктивноПассивный)
	|			И Счета.УчитыватьСостояниеРасчетов
	|			И СУММА(ВсеРасчеты.ОстатокДт) > СУММА(ВсеРасчеты.ОстатокКт) КАК Актив,
	|	ВЫБОР
	|		КОГДА Счета.ВидСчета = ЗНАЧЕНИЕ(ВидСчета.Активный)
	|				ИЛИ Счета.ВидСчета = ЗНАЧЕНИЕ(ВидСчета.АктивноПассивный)
	|					И Счета.УчитыватьСостояниеРасчетов
	|					И СУММА(ВсеРасчеты.ОстатокДт) > СУММА(ВсеРасчеты.ОстатокКт)
	|			ТОГДА СУММА(ВсеРасчеты.ОстатокДт) - СУММА(ВсеРасчеты.ОстатокКт)
	|		ИНАЧЕ СУММА(ВсеРасчеты.ОстатокКт) - СУММА(ВсеРасчеты.ОстатокДт)
	|	КОНЕЦ КАК Остаток,
	|	Счета.Долгосрочный КАК Долгосрочный,
	|	ВЫБОР
	|		КОГДА Счета.ВидСчета = ЗНАЧЕНИЕ(ВидСчета.АктивноПассивный)
	|			ТОГДА ВЫБОР
	|					КОГДА СУММА(ВсеРасчеты.ОстатокДт) > СУММА(ВсеРасчеты.ОстатокКт)
	|						ТОГДА СУММА(ВсеРасчеты.ОстатокДт) - СУММА(ВсеРасчеты.ОстатокКт)
	|					ИНАЧЕ 0
	|				КОНЕЦ
	|		ИНАЧЕ СУММА(ВсеРасчеты.ОстатокДт)
	|	КОНЕЦ КАК ОстатокДт,
	|	ВЫБОР
	|		КОГДА Счета.ВидСчета = ЗНАЧЕНИЕ(ВидСчета.АктивноПассивный)
	|			ТОГДА ВЫБОР
	|					КОГДА СУММА(ВсеРасчеты.ОстатокДт) < СУММА(ВсеРасчеты.ОстатокКт)
	|						ТОГДА СУММА(ВсеРасчеты.ОстатокКт) - СУММА(ВсеРасчеты.ОстатокДт)
	|					ИНАЧЕ 0
	|				КОНЕЦ
	|		ИНАЧЕ СУММА(ВсеРасчеты.ОстатокКт)
	|	КОНЕЦ КАК ОстатокКт,
	|	СУММА(ВсеРасчеты.РасчетнаяКраткосрочнаяЧасть) КАК РасчетнаяКраткосрочнаяЧасть,
	|	СУММА(ВсеРасчеты.РасчетнаяДолгосрочнаяЧасть) КАК РасчетнаяДолгосрочнаяЧасть,
	|	СУММА(ВсеРасчеты.РасчетнаяПросроченнаяЧасть) КАК РасчетнаяПросроченнаяЧасть
	|ПОМЕСТИТЬ Расчеты
	|ИЗ
	|	ВсеРасчеты КАК ВсеРасчеты
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Счета КАК Счета
	|		ПО ВсеРасчеты.Счет = Счета.Счет
	|
	|СГРУППИРОВАТЬ ПО
	|	ВсеРасчеты.Организация,
	|	ВсеРасчеты.Счет,
	|	Счета.ВидСчета,
	|	Счета.Долгосрочный,
	|	Счета.УчитыватьСостояниеРасчетов,
	|	ВЫБОР
	|		КОГДА Счета.ВидСубконто1 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконтоХозрасчетные.ПустаяСсылка)
	|			ТОГДА НЕОПРЕДЕЛЕНО
	|		ИНАЧЕ ВсеРасчеты.Субконто1
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА Счета.ВидСубконто2 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконтоХозрасчетные.ПустаяСсылка)
	|			ТОГДА НЕОПРЕДЕЛЕНО
	|		ИНАЧЕ ВсеРасчеты.Субконто2
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА Счета.ВидСубконто3 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконтоХозрасчетные.ПустаяСсылка)
	|			ТОГДА НЕОПРЕДЕЛЕНО
	|		ИНАЧЕ ВсеРасчеты.Субконто3
	|	КОНЕЦ");
	
	ТекстЗапроса = СтрСоединить(ТекстыЗапроса, ОбщегоНазначения.РазделительПакетаЗапросов());
	
	Если Не ПустаяСтрока(ИмяВременнойТаблицы) Тогда
		ТочкаЗапроса = СхемыЗапросов.НайтиЗапросСозданияТаблицы(ТекстЗапроса, "Расчеты");
		ТочкаЗапроса.Запрос.ТаблицаДляПомещения = ИмяВременнойТаблицы;
		ТекстЗапроса = ТочкаЗапроса.Схема.ПолучитьТекстЗапроса();
	КонецЕсли;
	
	Запрос.Текст = ТекстЗапроса;

	Запрос.Выполнить();
	
КонецПроцедуры

Процедура СоздатьВременныеТаблицыОборотыЗадолженности(МенеджерВременныхТаблиц, КонтекстЗаполненияОтчета, СчетаРасчетов, Актив = Истина)

	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("Актив", Актив);
	Запрос.УстановитьПараметр("Организации", КонтекстЗаполненияОтчета.Организации);
	Запрос.УстановитьПараметр("НачалоПериода", КонтекстЗаполненияОтчета.Период.Начало);
	Запрос.УстановитьПараметр("КонецПериода", КонтекстЗаполненияОтчета.Период.Конец);
	Запрос.УстановитьПараметр("СчетаРасчетов", СчетаРасчетов);
	Запрос.УстановитьПараметр("ПустойУникальныйИдентификатор", ОбщегоНазначенияКлиентСервер.ПустойУникальныйИдентификатор());
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Движения.Организация КАК Организация,
	|	Движения.Счет КАК Счет,
	|	Счета.ВидСчета = ЗНАЧЕНИЕ(ВидСчета.АктивноПассивный)
	|		И Счета.УчитыватьСостояниеРасчетов КАК СкорректироватьОбороты,
	|	ВЫБОР
	|		КОГДА Счета.ВидСубконто1 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконтоХозрасчетные.ПустаяСсылка)
	|			ТОГДА НЕОПРЕДЕЛЕНО
	|		ИНАЧЕ Движения.Субконто1
	|	КОНЕЦ КАК Субконто1,
	|	ВЫБОР
	|		КОГДА Счета.ВидСубконто2 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконтоХозрасчетные.ПустаяСсылка)
	|			ТОГДА НЕОПРЕДЕЛЕНО
	|		ИНАЧЕ Движения.Субконто2
	|	КОНЕЦ КАК Субконто2,
	|	ВЫБОР
	|		КОГДА Счета.ВидСубконто3 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконтоХозрасчетные.ПустаяСсылка)
	|			ТОГДА НЕОПРЕДЕЛЕНО
	|		ИНАЧЕ Движения.Субконто3
	|	КОНЕЦ КАК Субконто3,
	|	СУММА(Движения.ОборотДт) КАК ОборотДт,
	|	СУММА(Движения.ОборотКт) КАК ОборотКт,
	|	СУММА(ВЫБОР
	|			КОГДА &Актив
	|				ТОГДА Движения.ОборотДт
	|			ИНАЧЕ Движения.ОборотКт
	|		КОНЕЦ) КАК Поступило,
	|	СУММА(ВЫБОР
	|			КОГДА &Актив
	|				ТОГДА Движения.ОборотКт
	|			ИНАЧЕ Движения.ОборотДт
	|		КОНЕЦ) КАК Погашено,
	|	СУММА(Движения.НачисленоШтрафы) КАК НачисленоШтрафы,
	|	СУММА(Движения.СписаноЗадолженности) КАК СписаноЗадолженности
	|ПОМЕСТИТЬ ОборотыЗадолженности
	|ИЗ
	|	(ВЫБРАТЬ
	|		ХозрасчетныйОбороты.Организация КАК Организация,
	|		ХозрасчетныйОбороты.Счет КАК Счет,
	|		ВЫБОР
	|			КОГДА УНИКАЛЬНЫЙИДЕНТИФИКАТОР(ХозрасчетныйОбороты.Субконто1) <> &ПустойУникальныйИдентификатор
	|				ТОГДА ХозрасчетныйОбороты.Субконто1
	|			ИНАЧЕ НЕОПРЕДЕЛЕНО
	|		КОНЕЦ КАК Субконто1,
	|		ВЫБОР
	|			КОГДА УНИКАЛЬНЫЙИДЕНТИФИКАТОР(ХозрасчетныйОбороты.Субконто2) <> &ПустойУникальныйИдентификатор
	|				ТОГДА ХозрасчетныйОбороты.Субконто2
	|			ИНАЧЕ НЕОПРЕДЕЛЕНО
	|		КОНЕЦ КАК Субконто2,
	|		ВЫБОР
	|			КОГДА УНИКАЛЬНЫЙИДЕНТИФИКАТОР(ХозрасчетныйОбороты.Субконто3) <> &ПустойУникальныйИдентификатор
	|				ТОГДА ХозрасчетныйОбороты.Субконто3
	|			ИНАЧЕ НЕОПРЕДЕЛЕНО
	|		КОНЕЦ КАК Субконто3,
	|		ХозрасчетныйОбороты.СуммаОборотДт КАК ОборотДт,
	|		ХозрасчетныйОбороты.СуммаОборотКт КАК ОборотКт,
	|		0 КАК НачисленоШтрафы,
	|		0 КАК СписаноЗадолженности
	|	ИЗ
