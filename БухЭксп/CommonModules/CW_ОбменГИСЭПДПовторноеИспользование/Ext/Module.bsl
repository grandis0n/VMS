Функция ПолучитьВложенныеФункцииФормулы() Экспорт
	
	Массив = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	CW_ОбменГИСЭПДФункцииЗначенийРеквизитовЭПД.Идентификатор КАК Идентификатор
	               |ИЗ
	               |	Справочник.CW_ОбменГИСЭПДФункцииЗначенийРеквизитовЭПД КАК CW_ОбменГИСЭПДФункцииЗначенийРеквизитовЭПД";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		Массив.Добавить(Выборка.Идентификатор);	
	КонецЦикла; 
	
	Возврат Массив;
	
КонецФункции   

Функция ПолучитьСоответствиеФункций() Экспорт
	
	Соответствие = Новый Соответствие;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	CW_ОбменГИСЭПДФункцииЗначенийРеквизитовЭПД.Идентификатор КАК Идентификатор,
	               |	CW_ОбменГИСЭПДФункцииЗначенийРеквизитовЭПД.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.CW_ОбменГИСЭПДФункцииЗначенийРеквизитовЭПД КАК CW_ОбменГИСЭПДФункцииЗначенийРеквизитовЭПД";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл  
		Соответствие.Вставить(Выборка.Идентификатор, Выборка.Ссылка);
	КонецЦикла; 
	
	Возврат Соответствие;
	
КонецФункции 
