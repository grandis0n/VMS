 #Область СлужебныеПроцедурыИФункции
 
#Если Не ВебКлиент Тогда

// Возвращает массив сертификатов
//
// Возвращаемое значение:
//   Массив из Структура:
//    * ИмяФайла - Строка -
//    * Содержимое - Строка - 
//
Функция ПолучитьСертификатыИзМакета(ИдентификаторОбъекта, ТипПлатформыКлиента) Экспорт
	
	СписокСертификатов = Новый Массив();
	
	АрхивСертификатов = ПолучитьОбщийМакет("Сертификаты1СТСПИоТ_ru");
	ВременныйКаталог  = ПолучитьИмяВременногоФайла() + ПолучитьРазделительПути();
	Буфер             = ПолучитьБуферДвоичныхДанныхИзДвоичныхДанных(АрхивСертификатов);
	Поток             = Новый ПотокВПамяти(Буфер);
	ЧтениеАрхива      = Новый ЧтениеФайлаАрхива(Поток);
	
	ПлатформыКлиента = СтрЗаменить(ТипПлатформыКлиента, " ", "_");
	ИмяСертификата = СтрШаблон("inst_@%1@%2.s", ИдентификаторОбъекта, ПлатформыКлиента);
	
	Для Каждого Элемент Из ЧтениеАрхива.Элементы Цикл
		Если Элемент.Имя = "main.pem" Или Элемент.Имя = ИмяСертификата Тогда  
			ЧтениеАрхива.Извлечь(Элемент, ВременныйКаталог);
			
			
			Чтение = Новый ЧтениеТекста(ВременныйКаталог + Элемент.Имя, КодировкаТекста.ANSI);
			Содержимое = Чтение.Прочитать();   
			Чтение.Закрыть();
			
			Сертификат = Новый Структура(); 
			Сертификат.Вставить("ИмяФайла", Элемент.Имя);
			Сертификат.Вставить("Содержимое", Содержимое);
			СписокСертификатов.Добавить(Сертификат);          
		КонецЕсли
	КонецЦикла;
	
	Попытка 
		УдалитьФайлы(ВременныйКаталог + Элемент.Имя);
	Исключение
		ОбщегоНазначенияБПО.ЗаписатьОшибкуВЖурналРегистрации(
			НСтр("ru = 'Сертификаты 1С:ТС ПИоТ'"),
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
	Возврат СписокСертификатов;
	
КонецФункции  

#КонецЕсли

#КонецОбласти
