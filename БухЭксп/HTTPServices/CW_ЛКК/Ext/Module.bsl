Процедура УведомитьОСозданииНовойЗаявки(НоваяЗаявка, АдресУведомлений, ШаблонПисьма = Неопределено)  
	
	УчетнаяЗаписьЭлектроннойПочты = Константы.CW_ЛичныйКабинетУчетнаяЗаписьДляОтправкиУведомлений.Получить();
	Если Не ЗначениеЗаполнено(УчетнаяЗаписьЭлектроннойПочты) Тогда
		Возврат;
	КонецЕсли;   
	
	НастройкиПользователя 		= CW_Настройки.ПолучитьНастройкиПользователя();
	
	СтруктураПисьма 			= _ЭП.СтруктураПисьма();
	СтруктураПисьма.Отправитель = УчетнаяЗаписьЭлектроннойПочты;

	_ЭП.ДобавитьПолучателейИзСтроки(СтруктураПисьма.Получатели, АдресУведомлений);
	
	Если ШаблонПисьма <> Неопределено Тогда
		СтруктураПисьма.Тема = ЗаменитьМакросыПисьма(НоваяЗаявка, ШаблонПисьма, "Тема", НастройкиПользователя);
		
		Тело = ЗаменитьМакросыПисьма(НоваяЗаявка, ШаблонПисьма, "ТелоHTML", НастройкиПользователя);  
		_ЭП.ДобавитьТекст(СтруктураПисьма, Тело);
		
		Для каждого СтрВложения Из ШаблонПисьма.Вложения Цикл
			Картинка = СтрВложения.ДанныеФайла.Получить();
			_ЭП.ДобавитьВложение(СтруктураПисьма,СтрВложения.Имя,"Адрес", Картинка, СтрВложения.Имя);
		КонецЦикла;  
		
		_ЭП.ДобавитьПолучателейИзСтроки(СтруктураПисьма.Получатели,				ШаблонПисьма.Кому);
		_ЭП.ДобавитьПолучателейИзСтроки(СтруктураПисьма.Получатели_Копии,		ШаблонПисьма.Копия);
		_ЭП.ДобавитьПолучателейИзСтроки(СтруктураПисьма.Получатели_СкрытыеКопии,ШаблонПисьма.СкрытаяКопия);

	Иначе
		
		СтруктураПисьма.Тема = "Создана заявка "+ СокрЛП(НоваяЗаявка); 
		
		Тело = 	"Новая заявка "	+ СокрЛП(НоваяЗаявка) +	" от " + Формат(НоваяЗаявка.ДатаОбращения,"ДФ=dd.MM.yyyy")+ "
				|Клиент: "		+ СокрЛП(НоваяЗаявка.Контрагент) +	"            
				|Груз: "		+ СокрЛП(НоваяЗаявка.Груз) +	"   
				|Количество перевозок: "+ СокрЛП(НоваяЗаявка.КоличествоПеревозок);  
		
		_ЭП.ДобавитьТекст(СтруктураПисьма, Тело);
		
	КонецЕсли; 
	
	Если НастройкиПользователя.СкрытаяКопияСебе Тогда
		_ЭП.ДобавитьПолучателейИзСтроки(СтруктураПисьма.Получатели_СкрытыеКопии, УчетнаяЗаписьЭлектроннойПочты.ПочтовыйАдрес);
	КонецЕсли;
	
	Ответ = _ЭП.ОтправитьПисьмо(СтруктураПисьма);
	Если Ответ.Код = 0  Тогда  
		
		ФорматированныйДокумент = Новый ФорматированныйДокумент;
		ФорматированныйДокумент.УстановитьHTML(Тело, Новый Структура);
		
		СтруктураСобытия = Справочники.CW_События.ПоучитьСтруктуруСобытия();
		СтруктураСобытия.ДатаСобытия 	= НоваяЗаявка.ДатаОбращения;
		СтруктураСобытия.Владелец 		= НоваяЗаявка.Контрагент;    
		СтруктураСобытия.ТипСобытия 	= НоваяЗаявка.ТипОбращения;
  		СтруктураСобытия.ОбъектСобытия 	= НоваяЗаявка.Ссылка;
 		СтруктураСобытия.Сообщение 		= ФорматированныйДокумент;
		
		Справочники.CW_События.СоздатьСобытие(СтруктураСобытия,Истина,Истина);
		
	Иначе
		ЗаписьЖурналаРегистрации("Уведомление о новых завках", УровеньЖурналаРегистрации.Предупреждение, НоваяЗаявка,, Ответ.ОписаниеОшибки);   
		
	КонецЕсли;
	
КонецПроцедуры   

Функция ЗаменитьМакросыПисьма(Знач Источник, Знач Шаблон, Знач РеквизитТекста, НастройкиПользователя) Экспорт
	
	СтруктураПараметров = Новый Структура;
	
	Если ЗначениеЗаполнено(НастройкиПользователя.Пользователь.ФизическоеЛицо) Тогда
		//подучим данные физического лица
		ДанныеФизическогоЛица = ФизическиеЛицаЗарплатаКадры.ДанныеФизическогоЛицаДляРегламентированнойОтчетности(НастройкиПользователя.Пользователь.ФизическоеЛицо,,ТекущаяДата()); // ВызовБП
	Иначе
		//Физ. лицо в пользователе не заполнено, разберем стоку ФИО, 
		мДанныеФизическогоЛица = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(НастройкиПользователя.ФИО," ");
		
		ДанныеФизическогоЛица = Новый Структура("Фамилия,Имя,Отчество",Неопределено,Неопределено,Неопределено);
		
		Если мДанныеФизическогоЛица.Количество()>0 Тогда
			ДанныеФизическогоЛица.Фамилия = мДанныеФизическогоЛица[0];	
		КонецЕсли;
		Если мДанныеФизическогоЛица.Количество()>1 Тогда
			ДанныеФизическогоЛица.Имя = мДанныеФизическогоЛица[1];	
		КонецЕсли;
		Если мДанныеФизическогоЛица.Количество()>2 Тогда
			ДанныеФизическогоЛица.Отчество = мДанныеФизическогоЛица[2];	
		КонецЕсли;
	КонецЕсли;

	ИдентификаторОбъектаМетаданных = ОбщегоНазначения.ИдентификаторОбъектаМетаданных(тип("СправочникСсылка.CW_ВебШаблоныЗаявок"));
	ОписаниеМакросов	= Справочники.CW_ШаблоныСтандартныхПисем.ПолучитьОписаниеМакросов(ИдентификаторОбъектаМетаданных, СтруктураПараметров); 
	мМакросы 			= ПолучитьМакросыПисьма(Шаблон, Шаблон[РеквизитТекста]);
	Текст				= Шаблон[РеквизитТекста]; 
	
	Для Каждого Макрос из мМакросы Цикл
		Формула = ОписаниеМакросов.Получить(Макрос);
		
		Попытка
			ЗначениеФункции = Вычислить(Формула);
		Исключение
			ЗначениеФункции = "";
		КонецПопытки;
				 
		Если Строка(ТипЗнч(ЗначениеФункции)) = Строка(Тип("Дата")) Тогда
			ЗначениеФункции = Формат(ЗначениеФункции, "ДФ=dd.MM.yyyy");
		КонецЕсли;
		
		Текст = СтрЗаменить(Текст, Макрос, ЗначениеФункции); 
	КонецЦикла;
	
	Возврат Текст;
	
КонецФункции

Функция ПолучитьМакросыПисьма(Шаблон, ТекстШаблона)
	
	Результат = Новый Массив;
	
	ДеревоМакросов = Справочники.CW_ШаблоныСтандартныхПисем.ПолучитьСписокДоступныхМакросов(Шаблон.ОбъектШаблона);
	
	ОтборСтрок = Новый Структура("ЭтоГруппа", Ложь);
	НайденныеСтроки = ДеревоМакросов.Строки.НайтиСтроки(ОтборСтрок, Истина);
	
	Для Каждого СтрокаДерева из НайденныеСтроки Цикл
		Если СтрНайти(ТекстШаблона, СтрокаДерева.Значение) > 0 Тогда
			Результат.Добавить(СтрокаДерева.Значение);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ПривестиЗначениеJSON(Знач Знчаение, Знач ОписаниеТипаВсеСсылки, Знач Тип)
	
	Типы = Новый Массив;
	ОписаниеТипов = Новый ОписаниеТипов(Типы);
	ПриведенноеЗначение = ОписаниеТипов.ПривестиЗначение(Неопределено);
	
	Если ЗначениеЗаполнено(Знчаение) Тогда
		Если ОписаниеТипаВсеСсылки.СодержитТип(Тип) Тогда
			Если Не ПустаяСтрока(Знчаение) Тогда
				ПолноеИмя = Метаданные.НайтиПоТипу(Тип).ПолноеИмя();
				Менеджер  = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени(ПолноеИмя);   
				ПриведенноеЗначение = Менеджер.ПолучитьСсылку(Новый УникальныйИдентификатор(Знчаение));   
			КонецЕсли;
		Иначе 
			ПриведенноеЗначение = XMLЗначение(Тип, Знчаение);  
		КонецЕсли;  
	КонецЕсли;  
	
	Возврат ПриведенноеЗначение;
	
КонецФункции

Функция ПолучитьСсылкуИзНавигационной(НавигационнаяСсылка)
    
    ПерваяТочка = Найти(НавигационнаяСсылка, "e1cib/data/");
    ВтораяТочка = Найти(НавигационнаяСсылка, "?ref=");
    
    ПредставлениеТипа   = Сред(НавигационнаяСсылка, ПерваяТочка + 11, ВтораяТочка - ПерваяТочка - 11);
    ШаблонЗначения = ЗначениеВСтрокуВнутр(ПредопределенноеЗначение(ПредставлениеТипа + ".ПустаяСсылка"));
    ЗначениеСсылки = СтрЗаменить(ШаблонЗначения, "00000000000000000000000000000000", Сред(НавигационнаяСсылка, ВтораяТочка + 5));
	
	Возврат ЗначениеИзСтрокиВнутр(ЗначениеСсылки);
	
КонецФункции 

Функция ПолучитьТаблицуДоступныхПрофилей(Знач ДанныеПользователя, Знач master, Знач Раздел, profile, Знач ПустаяСсылка)
	
	ТаблицаДоступныхПрофилей	= CW_ЛичныйКабинетКлиентаСервер.ПолучитьПрофилиПользователя(ДанныеПользователя, master, Раздел);
	Если ЗначениеЗаполнено(profile) Тогда
		СтрокаДоступныхПрофилей = ТаблицаДоступныхПрофилей.Найти(profile, "ВебПрофиль"); 
		Если СтрокаДоступныхПрофилей = Неопределено Тогда       
			//профиль отсутствует в списке доступных
			profile = ПустаяСсылка;
		КонецЕсли;
	КонецЕсли;
	
	Если ТаблицаДоступныхПрофилей.Количество() > 0 Тогда
		Если profile.Пустая()  Тогда  
			НайденнаяСтрока = ТаблицаДоступныхПрофилей.Найти(Истина, "Основной");
			Если НайденнаяСтрока = Неопределено Тогда
				НайденнаяСтрока = ТаблицаДоступныхПрофилей[0]; 
			Конецесли;
			profile = НайденнаяСтрока.ВебПрофиль; 
		КонецЕсли;                                              
	КонецЕсли;
	
	Возврат ТаблицаДоступныхПрофилей;

КонецФункции

Процедура ЗаполнитьМассивФайлов(Знач ДанныеПользователя, Знач Профиль,  Знач ОбъектАрхива,  МассивФайлов)

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	CW_ОбъектыАрхива.Ссылка КАК Ссылка,
	               |	CW_ОбъектыАрхива.ИмяФайла КАК ИмяФайла,
	               |	CW_ОбъектыАрхива.ТипДокумента КАК ТипДокумента
	               |ИЗ
	               |	Справочник.CW_ОбъектыАрхива КАК CW_ОбъектыАрхива
	               |ГДЕ
	               |	CW_ОбъектыАрхива.Объект = &ОбъектАрхива
	               |	И CW_ОбъектыАрхива.ТипДокумента В(&ДоступныеТипыФайлов)";   
	
	ДоступныеТипыФайлов = Профиль.ТипыФайлов.Выгрузить().ВыгрузитьКолонку("Тип");	
	
	Запрос.УстановитьПараметр("ОбъектАрхива", 			ОбъектАрхива);
	Запрос.УстановитьПараметр("ДоступныеТипыФайлов",	ДоступныеТипыФайлов); 
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл    
		
		НаименованиеТипа = "";
		Если Профиль.ВыводитьТипФайла Тогда
			НаименованиеRU = СокрЛП(Выборка.ТипДокумента);
			Если ДанныеПользователя.Язык <> ПредопределенноеЗначение("Справочник.CW_Языки.ru") тогда
				НаименованиеEN = CW_ПереводыСервер.ПолучитьПеревод(Выборка.ТипДокумента,, ДанныеПользователя.Язык); 
			КонецЕсли;  
			НаименованиеТипа =  Нстр("ru='"+НаименованиеRU+"'; en='"+НаименованиеEN+"'");
		КонецЕсли;
		
		ДанныеФайла = Новый Структура;
		ДанныеФайла.Вставить("id", 		XMLСтрока(Выборка.Ссылка));
		ДанныеФайла.Вставить("name", 	XMLСтрока(Выборка.ИмяФайла));
		ДанныеФайла.Вставить("type", 	XMLСтрока(НаименованиеТипа));  
		МассивФайлов.Добавить(ДанныеФайла); 
		
	КонецЦикла;  
	
КонецПроцедуры  

Процедура ЗаполнитьМассивДокументов(ОсновнойПрофиль, Профиль, Грузоперевозка, МассивДокументов) 

	СоставКомплекта = ОсновнойПрофиль.КомплектПечатныхФорм.СоставКомплекта;

	Запрос = Новый Запрос;    
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос.УстановитьПараметр("Грузоперевозки", Грузоперевозка); 
	
	Запрос.Текст = "ВЫБРАТЬ 
	|	CW_ДоходыПоГрузоперевозкам.ДокументДоходов КАК ДокументДоходов,
	|	CW_ДоходыПоГрузоперевозкам.Период КАК Период
	|ПОМЕСТИТЬ ВТ_ДанныеРегистра
	|ИЗ
	|	РегистрНакопления.CW_ДоходыПоГрузоперевозкам КАК CW_ДоходыПоГрузоперевозкам
	|ГДЕ
	|	CW_ДоходыПоГрузоперевозкам.Грузоперевозка = &Грузоперевозки
	|	И CW_ДоходыПоГрузоперевозкам.ДокументДоходов <> ЗНАЧЕНИЕ(Документ.CW_ДоходыПоГрузоперевозке.ПустаяСсылка)";
	
	Запрос.Выполнить();
	
	Запрос.Текст = "ВЫБРАТЬ 
	|	МИНИМУМ(ВТ_ДанныеРегистра.Период) КАК НачалоПериода,
	|	МАКСИМУМ(ВТ_ДанныеРегистра.Период) КАК КонецПериода
	|ИЗ
	|	ВТ_ДанныеРегистра КАК ВТ_ДанныеРегистра";
	
	РезультатПериды = Запрос.Выполнить(); 
	
	мДоступныеДокументы = Новый Массив;
	
	ВыборкаПериоды = РезультатПериды.Выбрать();
	Если ВыборкаПериоды.Следующий() Тогда      
		ПараметрыКомплекта 	= CW_ЛичныйКабинетКлиентаСервер.ПолучитьПараметрыКомплекта(ОсновнойПрофиль.КомплектПечатныхФорм);
		ВсеДокументы 		= CW_ЛичныйКабинетКлиентаСервер.ПолучитьТаблицуДокументов(ОсновнойПрофиль, ВыборкаПериоды.НачалоПериода, ВыборкаПериоды.КонецПериода, ПараметрыКомплекта); 
		
		мДоступныеДокументы = ВсеДокументы.ВыгрузитьКолонку("Документ"); 	
	КонецЕсли;
	
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВТ_ДанныеРегистра.ДокументДоходов КАК ДокументДоходов
	|ИЗ
	|	ВТ_ДанныеРегистра КАК ВТ_ДанныеРегистра";
	
	РезультатДокументы = Запрос.Выполнить();
	
	Выборка = РезультатДокументы.Выбрать();
	Пока Выборка.Следующий() Цикл 
		
		Если мДоступныеДокументы.Найти(Выборка.ДокументДоходов)= Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		мОбъектыПечати = Новый Массив;
		мОбъектыПечати.Добавить(Выборка.ДокументДоходов);
		
		СтруктураВозврата = CW_Печать.ПолучитьПараметрыФормыПечати(мОбъектыПечати,  Новый УникальныйИдентификатор, Истина);
		Если _УФКС.ВыполненоУспешно(СтруктураВозврата) Тогда
			
			ПакетДокументов = ПолучитьИзВременногоХранилища(СтруктураВозврата.ПФ.АдресПакета);
			
			Для Каждого Документ Из ПакетДокументов.Элементы Цикл 
				Для Каждого ПечатнаяФорма Из Документ.Элементы Цикл   
					Если Не CW_ЛичныйКабинетКлиентаСервер.НужноПечатьФорму(Выборка.ДокументДоходов, ПечатнаяФорма, СоставКомплекта) тогда
						Продолжить;
					КонецЕсли;  
					
					ПотокВпамяти = Новый ПотокВПамяти; 
					ПечатнаяФорма.ПФ.Записать(ПотокВпамяти, ТипФайлаТабличногоДокумента.PDF);
					
					ДвоичныеДанные 		= ПотокВпамяти.ЗакрытьИПолучитьДвоичныеДанные();
					ДвоичныеДанныеJSON 	= CW_ОбщийМодульЛичныйКабинетСервер.СериализацияXDTO_JSON(ДвоичныеДанные);
					
					ДанныеФайла = новый Структура;
					ДанныеФайла.Вставить("id", 		XMLСтрока(Документ.Ссылка));
					ДанныеФайла.Вставить("name",	XMLСтрока(ПечатнаяФорма.Имя));
					ДанныеФайла.Вставить("binary",  ДвоичныеДанныеJSON);
					
					МассивДокументов.Добавить(ДанныеФайла);	
				КонецЦикла;
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЦикла;   
	
КонецПроцедуры

Процедура ЗаполнитьМассивТиповФайлов(Знач ДоступныеТипыФайлов, МассивТиповФайлов, Язык) Экспорт
	
	Для Каждого ТипФайла из ДоступныеТипыФайлов Цикл   
		
		Если Язык = ПредопределенноеЗначение("Справочник.CW_Языки.ПустаяСсылка") Тогда
			Язык = ПредопределенноеЗначение("Справочник.CW_Языки.ru");
		КонецЕсли;  
		
		НаименованиеRU = СокрЛП(ТипФайла);
		Если Язык <> ПредопределенноеЗначение("Справочник.CW_Языки.ru") тогда
			НаименованиеEN = CW_ПереводыСервер.ПолучитьПеревод(ТипФайла,, Язык); 
		КонецЕсли;   
		
		НаименованиеТипа =  Нстр("ru='"+НаименованиеRU+"'; en='"+НаименованиеEN+"'");
		
		ДанныеТипаФайла = Новый Структура;
		ДанныеТипаФайла.Вставить("id", 		XMLСтрока(ТипФайла));
		ДанныеТипаФайла.Вставить("name", 	XMLСтрока(НаименованиеТипа));  
		
		МассивТиповФайлов.Добавить(ДанныеТипаФайла);    
		
	КонецЦикла;

КонецПроцедуры 
//Служебные
