//Раздел "Новости"
Функция newstextget(Запрос)
	
	УстановитьПривилегированныйРежим(Истина);                 
	
	СтруктураJSON = CW_РаботаСВнешнимиРесурсамиСервер.ПрочитатьHTTPСервисВОбъект(Запрос);  
	
	Если ПустаяСтрока(СтруктураJSON.username) Тогда  
		ТекстТела = НСтр("ru='Ошибка авторизации пользователя'; en='User authorization error'", СтруктураJSON.language);
		Ответ = CW_РаботаСВнешнимиРесурсамиСервер.Ответ(408);	 
		Ответ.УстановитьТелоИзСтроки(ТекстТела);
		Возврат Ответ;
	КонецЕсли;	
	
	ДанныеПользователя = CW_ЛичныйКабинетКлиентаСервер.ПолучитьДанныеПользователя(СтруктураJSON.username);
	Если ДанныеПользователя = Неопределено Тогда
		ТекстТела = НСтр("ru='Пользователь %1 не найден'; en='User %1 not found'", СтруктураJSON.language);
		Ответ = CW_РаботаСВнешнимиРесурсамиСервер.Ответ(408);	       
		Ответ.УстановитьТелоИзСтроки(ТекстТела);
		Возврат Ответ;
	КонецЕсли;        
	
	НовостиСсылка = XMLЗначение(Тип("СправочникСсылка.CW_НовостиКомпании"), СтруктураJSON.id);
	Если ЗначениеЗаполнено(НовостиСсылка) Тогда 
		ЯзыкНовости				= НСтр("ru='ru'; en='en'", ДанныеПользователя.Язык);
		СтруктураСодержания		= НовостиСсылка.ХранилищеСодержания.Получить();
		ФорматированныйДокумент = СтруктураСодержания[ЯзыкНовости]; 
	Иначе  
		ТекстНовости = НСтр("ru='Запрашиваемая новость не найдена!'; en='The requested news was not found!'", ДанныеПользователя.Язык);
		ФорматированнаяСтрока = Новый ФорматированнаяСтрока(ТекстНовости);
		
		ФорматированныйДокумент = новый ФорматированныйДокумент;
		ФорматированныйДокумент.УстановитьФорматированнуюСтроку(ФорматированнаяСтрока);
	КонецЕсли;       
	              
	Ответ 		= CW_РаботаСВнешнимиРесурсамиСервер.Ответ(200);
	newstext  = CW_ОбщийМодульЛичныйКабинетСервер.СериализацияXDTO_JSON(ФорматированныйДокумент); 

	СтруктураJSON = Новый Структура;
	СтруктураJSON.Вставить("newstext", newstext);

	СтрокаJSON 	= CW_РаботаСВнешнимиРесурсамиСервер.ОбъектВСтрокуJSON(СтруктураJSON);
	
	Ответ.УстановитьТелоИзСтроки(СтрокаJSON);

	Возврат Ответ;
	
КонецФункции

