//Устарела с версии 8.3.14.7
Функция detailedget(Запрос)
	
	УстановитьПривилегированныйРежим(Истина);

	СтруктураJSON = CW_РаботаСВнешнимиРесурсамиСервер.ПрочитатьHTTPСервисВОбъект(Запрос);
	
	ИмяПользователя			= XMLЗначение(Тип("Строка"), 								СтруктураJSON.UserName); 
	Профиль					= XMLЗначение(Тип("СправочникСсылка.CW_ВебПрофили"), 		СтруктураJSON.uidprofile); 
	Грузоперевозка			= XMLЗначение(Тип("СправочникСсылка.CW_Грузоперевозки"), 	СтруктураJSON.uid); 
	ДоступныПечатныеФормы 	= XMLЗначение(Тип("Булево"), 								СтруктураJSON.PrinfForm); 
	
	Если Не ЗначениеЗаполнено(Профиль) Тогда 
		Ответ = CW_РаботаСВнешнимиРесурсамиСервер.Ответ(200);
		Возврат Ответ;
	Конецесли;
	
	СоставКомплекта 		= Профиль.ОсновнойПрофиль.КомплектПечатныхФорм.СоставКомплекта;
	ДанныеПользователя 		= CW_ЛичныйКабинетКлиентаСервер.ПолучитьДанныеПользователя(ИмяПользователя);  
	
	ВыгружатьФайлы 			= ДанныеПользователя.ВыгружатьФайлы И Профиль.ВыгружатьФайлы;
	ВыгружатьДокументы 		= ДоступныПечатныеФормы И ДанныеПользователя.ВыгружатьПечатныеФормы И Профиль.ОсновнойПрофиль.ВыводитьФинансовыеДокументы; 
	
	МассивПеревозок = Новый Массив;
	Если ЗначениеЗаполнено(Грузоперевозка) Тогда
		МассивПеревозок.Добавить(Грузоперевозка);
	КонецЕсли;
	Если ЗначениеЗаполнено(Грузоперевозка.Заказ) Тогда
		МассивПеревозок.Добавить(Грузоперевозка.Заказ);
	КонецЕсли; 
	
	МассивФайлов = новый Массив;
	МассивПечатныхФорм = новый Массив;

	Если МассивПеревозок.Количество()>0 Тогда
		
		Если ВыгружатьФайлы Тогда
			
			Запрос = Новый Запрос;
			Запрос.Текст = 	"ВЫБРАТЬ
			|	CW_ОбъектыАрхива.Объект КАК Объект,
			|	CW_ОбъектыАрхива.Ссылка КАК Ссылка,
			|	CW_ОбъектыАрхива.Наименование КАК Наименование,
			|	CW_ОбъектыАрхива.Расширение КАК Расширение,
			|	CW_ОбъектыАрхива.ВОблаке КАК ВОблаке,
			|	CW_ОбъектыАрхива.ИмяФайла КАК ИмяФайла,
			|	CW_ОбъектыАрхива.ТипДокумента КАК ТипДокумента
			|ИЗ
			|	Справочник.CW_ОбъектыАрхива КАК CW_ОбъектыАрхива
			|ГДЕ
			|	CW_ОбъектыАрхива.Объект В(&Объекты)
			|	//УсловиеПоТипамДокументов";
			
			Если Профиль.ТипыФайлов.Количество()>0 Тогда
				Запрос.Текст = СтрЗаменить(Запрос.Текст,"//УсловиеПоТипамДокументов","И CW_ОбъектыАрхива.ТипДокумента В (&ТипыДокументов)");
				Запрос.УстановитьПараметр("ТипыДокументов", Профиль.ТипыФайлов.ВыгрузитьКолонку("Тип"));
			КонецЕсли;
			Запрос.УстановитьПараметр("Объекты", МассивПеревозок);
			
			Выборка = Запрос.Выполнить().Выбрать();
			
			Пока Выборка.Следующий() Цикл
				
				ПредставлениеТипаДокумента = "";
				Если Профиль.ВыводитьТипФайла Тогда
					ПредставлениеТипаДокумента = CW_ПереводыСервер.ПолучитьПеревод(Выборка.ТипДокумента,, ДанныеПользователя.Язык);
				КонецЕсли;
				
				СтруктураФайла = новый Структура;
				СтруктураФайла.Вставить("name",			XMLСтрока(Выборка.Наименование));
				СтруктураФайла.Вставить("extension",	XMLСтрока(Выборка.Расширение));
				СтруктураФайла.Вставить("uid",			XMLСтрока(Выборка.Ссылка));  
				СтруктураФайла.Вставить("documenttype",	XMLСтрока(ПредставлениеТипаДокумента));
				СтруктураФайла.Вставить("cloud", 		?(Выборка.ВОблаке,XMLСтрока(Выборка.ИмяФайла),"")); 
				
				МассивФайлов.Добавить(СтруктураФайла);
			КонецЦикла;
			
		КонецЕсли;  
		
		Если ВыгружатьДокументы Тогда  
			
			Запрос = Новый Запрос;
			Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	CW_ДоходыПоГрузоперевозкам.ДокументДоходов КАК ДокументДоходов
			|ИЗ
			|	РегистрНакопления.CW_ДоходыПоГрузоперевозкам КАК CW_ДоходыПоГрузоперевозкам
			|ГДЕ
			|	CW_ДоходыПоГрузоперевозкам.Грузоперевозка В(&Грузоперевозки)";
			
			Запрос.УстановитьПараметр("Грузоперевозки", МассивПеревозок);
			
			Выборка = Запрос.Выполнить().Выбрать();
			Пока Выборка.Следующий() Цикл 
				Если Не ЗначениеЗаполнено(Выборка.ДокументДоходов) Тогда
					Продолжить;
				КонецЕсли;
				
				мОбъектыПечати = Новый Массив;
				мОбъектыПечати.Добавить(Выборка.ДокументДоходов);
				
				СтруктураВозврата = CW_Печать.ПолучитьПараметрыФормыПечати(мОбъектыПечати,  Новый УникальныйИдентификатор, Истина);
				Если _УФКС.ВыполненоУспешно(СтруктураВозврата) Тогда
					
					ПакетДокументов = ПолучитьИзВременногоХранилища(СтруктураВозврата.ПФ.АдресПакета);
					
					Для Каждого Документ Из ПакетДокументов.Элементы Цикл 
						Для Каждого ПечатнаяФорма Из Документ.Элементы Цикл   
							
							Если Не CW_ЛичныйКабинетКлиентаСервер.НужноПечатьФорму(Выборка.ДокументДоходов, ПечатнаяФорма, СоставКомплекта) тогда
								Продолжить;
							КонецЕсли;
							
							ПотокВпамяти = новый ПотокВПамяти;
							
							Запись = Новый ЗаписьXML;
							Запись.ОткрытьПоток(ПотокВпамяти);
							
							Сериализатор 	= Новый СериализаторXDTO(ФабрикаXDTO);
							Сериализатор.ЗаписатьXML(Запись, ПечатнаяФорма.ПФ);   
							
							Запись.Закрыть(); 
							
							ДвоичныеДанные  = ПотокВпамяти.ЗакрытьИПолучитьДвоичныеДанные();
							СодержимоеФайла = Base64Строка(ДвоичныеДанные);
							
							СтруктураПФ = новый Структура;
							СтруктураПФ.Вставить("uid", 	XMLСтрока(Документ.Ссылка));
							СтруктураПФ.Вставить("name",	XMLСтрока(ПечатнаяФорма.Имя));
							СтруктураПФ.Вставить("data",  	XMLСтрока(СодержимоеФайла));
							
							МассивПечатныхФорм.Добавить(СтруктураПФ);	
						КонецЦикла;
					КонецЦикла;
					
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли; 
		
	КонецЕсли;

	СтруктураJSON = Новый Структура;
	СтруктураJSON.Вставить("archive", 	МассивФайлов);
	СтруктураJSON.Вставить("print", 	МассивПечатныхФорм); 

	Ответ 		= CW_РаботаСВнешнимиРесурсамиСервер.Ответ(200);   
	СтрокаJSON  = CW_РаботаСВнешнимиРесурсамиСервер.ОбъектВСтрокуJSON(СтруктураJSON);
	
	Ответ.УстановитьТелоИзСтроки(СтрокаJSON);
	
	Возврат Ответ
	
КонецФункции
//--Устарела с версии 8.3.14.7

Функция testconnectionget(Запрос) 
	
	Ответ = CW_РаботаСВнешнимиРесурсамиСервер.Ответ(200);
	Возврат Ответ; 
	
КонецФункции

//Начальная инициализация профиля
Функция initialdataget(Запрос)  
	
	УстановитьПривилегированныйРежим(Истина);
	
	СтруктураJSON = CW_РаботаСВнешнимиРесурсамиСервер.ПрочитатьHTTPСервисВОбъект(Запрос); 
	
	//Пользователь
	Если ПустаяСтрока(СтруктураJSON.username) Тогда  
		Ответ 	  = CW_РаботаСВнешнимиРесурсамиСервер.Ответ(408);
		ТекстТела = НСтр("ru='Ошибка авторизации пользователя'; en='User authorization error'", СтруктураJSON.language);
		Ответ.УстановитьТелоИзСтроки(ТекстТела);
		Возврат Ответ;
	КонецЕсли;	   
	
	ДанныеПользователя = CW_ЛичныйКабинетКлиентаСервер.ПолучитьДанныеПользователя(СтруктураJSON.username);
	Если ДанныеПользователя = Неопределено Тогда
		Ответ 	  = CW_РаботаСВнешнимиРесурсамиСервер.Ответ(408);
		ТекстТела = НСтр("ru='Пользователь %1 не найден'; en='User %1 not found'", СтруктураJSON.language);
		Ответ.УстановитьТелоИзСтроки(ТекстТела);
		Возврат Ответ;
	КонецЕсли;        
	//Пользователь
       
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Пользователь", ДанныеПользователя.Пользователь);

	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	CW_ПользователиВебПрофилей.ОсновнойПрофиль КАК ОсновнойПрофиль,
	|	CW_ПользователиВебПрофилей.ОсновнойПрофиль.ДоступенРазделПеревозки КАК ДоступенРазделПеревозки,
	|	CW_ПользователиВебПрофилей.ОсновнойПрофиль.ДоступенРазделЗаявки КАК ДоступенРазделЗаявки,
	|	CW_ПользователиВебПрофилей.ОсновнойПрофиль.ВыводитьФинансовыеДокументы КАК ДоступенРазделДокументы,
	|	CW_ПользователиВебПрофилей.ОсновнойПрофиль.ДоступенРазделОтчеты КАК ДоступенРазделОтчеты,
	|	CW_ПользователиВебПрофилей.ОсновнойПрофиль.ВыводитьЗадолженность КАК ВыводитьЗадолженность,
	|	CW_ПользователиВебПрофилей.ОсновнойПрофиль.УведомлятьОЗадолженности КАК УведомлятьОЗадолженности,
	|	CW_ПользователиВебПрофилей.ОсновнойПрофиль.ИспользуемыйВариантОтчета КАК ВидВариантовОтчета,
	|	CW_ПользователиВебПрофилей.Раздел КАК Раздел
	|ПОМЕСТИТЬ ВТПрофилиПоРазделам
	|ИЗ
	|	РегистрСведений.CW_ПользователиВебПрофилей КАК CW_ПользователиВебПрофилей
	|ГДЕ
	|	CW_ПользователиВебПрофилей.Пользователь = &Пользователь
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТПрофилиПоРазделам.ОсновнойПрофиль КАК ОсновнойПрофиль,
	|	ВТПрофилиПоРазделам.ДоступенРазделПеревозки КАК ДоступенРазделПеревозки,
	|	ВТПрофилиПоРазделам.ДоступенРазделЗаявки КАК ДоступенРазделЗаявки,
	|	ВТПрофилиПоРазделам.ДоступенРазделДокументы КАК ДоступенРазделДокументы,
	|	ВТПрофилиПоРазделам.ДоступенРазделОтчеты КАК ДоступенРазделОтчеты,
	|	ВТПрофилиПоРазделам.ВыводитьЗадолженность КАК ВыводитьЗадолженность,
	|	ВТПрофилиПоРазделам.УведомлятьОЗадолженности КАК УведомлятьОЗадолженности,
	|	ВТПрофилиПоРазделам.ВидВариантовОтчета КАК ВидВариантовОтчета
	|ПОМЕСТИТЬ ВТ_ОсновныеПрофили
	|ИЗ
	|	ВТПрофилиПоРазделам КАК ВТПрофилиПоРазделам
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТПрофилиПоРазделам.ОсновнойПрофиль,
	|	ВТПрофилиПоРазделам.УведомлятьОЗадолженности,
	|	ВТПрофилиПоРазделам.ДоступенРазделОтчеты,
	|	ВТПрофилиПоРазделам.ДоступенРазделЗаявки,
	|	ВТПрофилиПоРазделам.ВыводитьЗадолженность,
	|	ВТПрофилиПоРазделам.ДоступенРазделДокументы,
	|	ВТПрофилиПоРазделам.ДоступенРазделПеревозки,
	|	ВТПрофилиПоРазделам.ВидВариантовОтчета
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ОсновныеПрофили.ОсновнойПрофиль КАК ОсновнойПрофиль,
	|	ВТ_ОсновныеПрофили.ДоступенРазделПеревозки КАК ДоступенРазделПеревозки,
	|	ВТ_ОсновныеПрофили.ДоступенРазделЗаявки КАК ДоступенРазделЗаявки,
	|	ВТ_ОсновныеПрофили.ДоступенРазделДокументы КАК ДоступенРазделДокументы,
	|	ВТ_ОсновныеПрофили.ДоступенРазделОтчеты КАК ДоступенРазделОтчеты,
	|	ВТ_ОсновныеПрофили.УведомлятьОЗадолженности КАК УведомлятьОЗадолженности,
	|	ВТ_ОсновныеПрофили.ВыводитьЗадолженность КАК ВыводитьЗадолженность,
	|	ВТ_ОсновныеПрофили.ВидВариантовОтчета КАК ВидВариантовОтчета,
	|	ВТ_ОсновныеПрофили.ОсновнойПрофиль.ДоступныеВариантыОтчета.(
	|		НомерСтроки КАК НомерСтроки,
	|		ВариантОтчета.КлючВарианта КАК КлючВарианта,
	|		ВариантОтчета.Наименование КАК Наименование
	|	) КАК ДоступныеВариантыОтчета
	|ИЗ
	|	ВТ_ОсновныеПрофили КАК ВТ_ОсновныеПрофили
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТПрофилиПоРазделам.Раздел КАК Раздел,
	|	ВТПрофилиПоРазделам.ОсновнойПрофиль КАК ОсновнойПрофиль
	|ИЗ
	|	ВТПрофилиПоРазделам КАК ВТПрофилиПоРазделам
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТПрофилиПоРазделам.ОсновнойПрофиль,
	|	ВТПрофилиПоРазделам.Раздел";  
	
	ПакетРезультатовЗапроса = Запрос.ВыполнитьПакет();
	
	РезультатЗапросаПрофили	= ПакетРезультатовЗапроса[2];
	ВыборкаОсновнойПрофиль 	= РезультатЗапросаПрофили.Выбрать();

	РезультатЗапросаРазделы	= ПакетРезультатовЗапроса[3];
	ТаблицаРазделы 	= РезультатЗапросаРазделы.Выгрузить();
	
	МассивПрофилей = Новый Массив;
	Пока ВыборкаОсновнойПрофиль.Следующий() Цикл 
		
		Отбор = Новый Структура;
		Отбор.Вставить("ОсновнойПрофиль", 	ВыборкаОсновнойПрофиль.ОсновнойПрофиль); 
		
		Отбор.Вставить("Раздел",	"ЗАЯВКИ"); 
		мЗаявки = ТаблицаРазделы.НайтиСтроки(Отбор);
		ДоступенРазделЗаявки 	= ВыборкаОсновнойПрофиль.ДоступенРазделЗаявки и мЗаявки.Количество() > 0;
		
		Отбор.Вставить("Раздел", 	"ГРУЗОПЕРЕВОЗКИ"); 
		мПеревозки = ТаблицаРазделы.НайтиСтроки(Отбор);
		ДоступенРазделПеревозки = ВыборкаОсновнойПрофиль.ДоступенРазделПеревозки и мПеревозки.Количество() > 0;
		
		ДоступенРазделДокументы = ВыборкаОсновнойПрофиль.ДоступенРазделДокументы И ДанныеПользователя.ВыгружатьПечатныеФормы;
		ДоступенРазделОтчеты 	= ВыборкаОсновнойПрофиль.ДоступенРазделОтчеты И ДанныеПользователя.ВыгружатьПечатныеФормы;

		НаименованиеПрофиля = Нстр("ru='"+ВыборкаОсновнойПрофиль.ОсновнойПрофиль.ПредставлениеRU+"'; en='"+ВыборкаОсновнойПрофиль.ОсновнойПрофиль.ПредставлениеEN+"'", СокрЛП(ДанныеПользователя.Язык));
		
		ДанныеОсновногоПрофиля = Новый Структура;  
		ДанныеОсновногоПрофиля.Вставить("id", 				XMLСтрока(ВыборкаОсновнойПрофиль.ОсновнойПрофиль));
		ДанныеОсновногоПрофиля.Вставить("name", 			XMLСтрока(НаименованиеПрофиля));
		ДанныеОсновногоПрофиля.Вставить("trucking", 		XMLСтрока(ДоступенРазделПеревозки));
		ДанныеОсновногоПрофиля.Вставить("request", 			XMLСтрока(ДоступенРазделЗаявки));
		ДанныеОсновногоПрофиля.Вставить("finance",  		XMLСтрока(ДоступенРазделДокументы));
		ДанныеОсновногоПрофиля.Вставить("reports",  		XMLСтрока(ДоступенРазделОтчеты));
		ДанныеОсновногоПрофиля.Вставить("reportarrears",  	XMLСтрока(ВыборкаОсновнойПрофиль.УведомлятьОЗадолженности));
		
		МассивВариантовОтчетов = Новый Массив;
		Если ДоступенРазделОтчеты и ВыборкаОсновнойПрофиль.ВыводитьЗадолженность Тогда
			
			Если ВыборкаОсновнойПрофиль.ВидВариантовОтчета = 1 Тогда
				
				ДоступныеВариантыОтчета = ВыборкаОсновнойПрофиль.ДоступныеВариантыОтчета.Выбрать();
				Пока ДоступныеВариантыОтчета.Следующий() Цикл
					
					СтруктураВарианта = Новый Структура;
					СтруктураВарианта.Вставить("key",  XMLСтрока(ДоступныеВариантыОтчета.КлючВарианта)); 
					СтруктураВарианта.Вставить("name", XMLСтрока(ДоступныеВариантыОтчета.Наименование)); 
					
					МассивВариантовОтчетов.Добавить(СтруктураВарианта);
					
				КонецЦикла; 
				
			ИначеЕсли ВыборкаОсновнойПрофиль.ВидВариантовОтчета = 0 Тогда   
				
				СтруктураВарианта = Новый Структура;
				СтруктураВарианта.Вставить("key",  XMLСтрока("")); 
				СтруктураВарианта.Вставить("name", XMLСтрока("Оперативная задолженность покупателей")); 
				
				МассивВариантовОтчетов.Добавить(СтруктураВарианта);
				
			КонецЕсли;
			
		КонецЕсли;
		
		ДанныеОсновногоПрофиля.Вставить("reportoptions", МассивВариантовОтчетов);
	
		МассивПрофилей.Добавить(ДанныеОсновногоПрофиля);
	КонецЦикла;
	
	ТаблицаНовостей 	= Справочники.CW_НовостиКомпании.ПолучитьАктуальныеНовости(ДанныеПользователя.Пользователь, ДанныеПользователя.Язык);     
	newstab 			= CW_ОбщийМодульЛичныйКабинетСервер.СериализацияXDTO_JSON(ТаблицаНовостей);   
	
	СтруктураJSON = Новый Структура;
	СтруктураJSON.Вставить("news",			newstab);	
	СтруктураJSON.Вставить("profiles",		МассивПрофилей);	
	
	Ответ 		= CW_РаботаСВнешнимиРесурсамиСервер.Ответ(200);
	СтрокаJSON 	= CW_РаботаСВнешнимиРесурсамиСервер.ОбъектВСтрокуJSON(СтруктураJSON);
	Ответ.УстановитьТелоИзСтроки(СтрокаJSON);
	
	Возврат Ответ;

КонецФункции

Функция moduleversionget(Запрос) 
	
	ВерсияМодуля = CW_ВерсииПодсистемСерверПовтИсп.ПолучитьВерсиюОсновнойПодсистемы();
	
	СтруктураJSON = Новый Структура;
	СтруктураJSON.Вставить("moduleversion",	ВерсияМодуля);	

	СтрокаJSON 	= CW_РаботаСВнешнимиРесурсамиСервер.ОбъектВСтрокуJSON(СтруктураJSON);
	
	Ответ = CW_РаботаСВнешнимиРесурсамиСервер.Ответ(200);
	Ответ.УстановитьТелоИзСтроки(СтрокаJSON);
	
	Возврат Ответ;
	
КонецФункции
