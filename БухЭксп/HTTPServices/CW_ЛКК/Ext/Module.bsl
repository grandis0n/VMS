Функция filelistget(Запрос)
	
	УстановитьПривилегированныйРежим(Истина);

	СтруктураJSON = CW_РаботаСВнешнимиРесурсамиСервер.ПрочитатьHTTPСервисВОбъект(Запрос); 
	
	//Пользователь
	Если ПустаяСтрока(СтруктураJSON.username) Тогда  
		Ответ 	  = CW_РаботаСВнешнимиРесурсамиСервер.Ответ(408);
		ТекстТела = НСтр("ru='Ошибка авторизации пользователя'; en='User authorization error'", СтруктураJSON.language);
		Ответ.УстановитьТелоИзСтроки(ТекстТела);
		Возврат Ответ;
	КонецЕсли;	   
	
	ДанныеПользователя = CW_ЛичныйКабинетКлиентаСервер.ПолучитьДанныеПользователя(СтруктураJSON.username);
	Если ДанныеПользователя = Неопределено Тогда
		Ответ 	  = CW_РаботаСВнешнимиРесурсамиСервер.Ответ(408);
		ТекстТела = НСтр("ru='Пользователь %1 не найден'; en='User %1 not found'", СтруктураJSON.language);
		Ответ.УстановитьТелоИзСтроки(ТекстТела);
		Возврат Ответ;
	КонецЕсли;        
	//Пользователь  
	
	//Профиль
	profileid	= XMLЗначение(Тип("УникальныйИдентификатор"),	СтруктураJSON.profile);  
	Если СтруктураJSON.section = "ЗАЯВКИ" Тогда
		profile 	  = Справочники.CW_ВебПрофилиЗаявок.ПолучитьСсылку(profileid);  
		ПустойПрофиль = ПредопределенноеЗначение("Справочник.CW_ВебПрофилиЗаявок.ПустаяСсылка");   
		ОбъектАрхива  = XMLЗначение(Тип("СправочникСсылка.CW_Заявки"), СтруктураJSON.id); 
	ИначеЕсли СтруктураJSON.section = "ГРУЗОПЕРЕВОЗКИ" Тогда
		profile 	  = Справочники.CW_ВебПрофилиПеревозок.ПолучитьСсылку(profileid);  
		ПустойПрофиль = ПредопределенноеЗначение("Справочник.CW_ВебПрофилиПеревозок.ПустаяСсылка");   
		ОбъектАрхива  = XMLЗначение(Тип("СправочникСсылка.CW_Грузоперевозки"), СтруктураJSON.id); 
	Иначе
		ТекстТела = НСтр("ru='Не удалось определить раздел данных'; en='The data section could not be identified'", СтруктураJSON.language);
		Ответ = CW_РаботаСВнешнимиРесурсамиСервер.Ответ(408);
		Ответ.УстановитьТелоИзСтроки(ТекстТела);
		Возврат Ответ;
	КонецЕсли; 
	
	Если ЗначениеЗаполнено(profile) Тогда
		Попытка
			ПрофильОбъект = profile.ПолучитьОбъект();
		Исключение
		КонецПопытки;
		Если ПрофильОбъект = Неопределено Тогда
			profile = ПустойПрофиль;   
		КонецЕсли;  
	КонецЕсли;
	//--Профиль
	
	МассивФайлов 		= Новый Массив; 
	Если ДанныеПользователя.ВыгружатьФайлы И profile.ВыгружатьФайлы Тогда
		ЗаполнитьМассивФайлов(ДанныеПользователя, profile, ОбъектАрхива, МассивФайлов);
		Если ТипЗнч(ОбъектАрхива) = Тип("СправочникСсылка.CW_Грузоперевозки") 
			И ЗначениеЗаполнено(ОбъектАрхива.Заказ) Тогда
			ЗаполнитьМассивФайлов(ДанныеПользователя, profile, ОбъектАрхива.Заказ, МассивФайлов); 
		КонецЕсли;
	КонецЕсли; 
	
	ДоступныеТипыФайлов = profile.ТипыФайлов.Выгрузить().ВыгрузитьКолонку("Тип");	
	МассивТиповФайлов 		= Новый Массив;  
	ЗапрашиватьТипФайла = ПолучитьФункциональнуюОпцию("CW_ЗапрашиватьТипФайлаПриДобавленииВАрхив");
	Если ЗапрашиватьТипФайла Тогда     
		ЗаполнитьМассивТиповФайлов(ДоступныеТипыФайлов, МассивТиповФайлов, ДанныеПользователя.Язык); 
	КонецЕсли;
	
	МаксимальныйРазмер = Константы.CW_ЛичныйКабинетОграничениеРазмераФайла.Получить();

	СтруктураJSON = Новый Структура;
	СтруктураJSON.Вставить("files", 		МассивФайлов);
	СтруктураJSON.Вставить("filestype", 	МассивТиповФайлов);   
	СтруктураJSON.Вставить("maximumsize", 	XMLСтрока(МаксимальныйРазмер));   
	
	СтрокаJSON = CW_РаботаСВнешнимиРесурсамиСервер.ОбъектВСтрокуJSON(СтруктураJSON);
	
	Ответ = CW_РаботаСВнешнимиРесурсамиСервер.Ответ(200);
	
	Ответ.УстановитьТелоИзСтроки(СтрокаJSON);	
	
	Возврат Ответ;  
	
КонецФункции

Функция fileget(Запрос)   
	
	УстановитьПривилегированныйРежим(Истина);  
	
	СтруктураJSON = CW_РаботаСВнешнимиРесурсамиСервер.ПрочитатьHTTPСервисВОбъект(Запрос);
	
	//Пользователь
	Если ПустаяСтрока(СтруктураJSON.username) Тогда  
		Ответ 	  = CW_РаботаСВнешнимиРесурсамиСервер.Ответ(408);
		ТекстТела = НСтр("ru='Ошибка авторизации пользователя'; en='User authorization error'", СтруктураJSON.language);
		Ответ.УстановитьТелоИзСтроки(ТекстТела);
		Возврат Ответ;
	КонецЕсли;	   
	
	ДанныеПользователя = CW_ЛичныйКабинетКлиентаСервер.ПолучитьДанныеПользователя(СтруктураJSON.username);
	Если ДанныеПользователя = Неопределено Тогда
		Ответ 	  = CW_РаботаСВнешнимиРесурсамиСервер.Ответ(408);
		ТекстТела = НСтр("ru='Пользователь %1 не найден'; en='User %1 not found'", СтруктураJSON.language);
		Ответ.УстановитьТелоИзСтроки(ТекстТела);
		Возврат Ответ;
	КонецЕсли;        
	//Пользователь  
	
	//Объект архива
	fileid 	= XMLЗначение(Тип("УникальныйИдентификатор"), СтруктураJSON.file); 
	file	= Справочники.CW_ОбъектыАрхива.ПолучитьСсылку(fileid);  
	Если ЗначениеЗаполнено(file) Тогда
		Попытка
			fileОбъект = file.ПолучитьОбъект();
		Исключение
		КонецПопытки;
		Если fileОбъект = Неопределено Тогда
			Ответ = CW_РаботаСВнешнимиРесурсамиСервер.Ответ(404); 
			Ответ.УстановитьТелоИзСтроки("Файл не найден");	
			Возврат Ответ;
		КонецЕсли;  
	КонецЕсли;	
	//--Объект архива
	
	ДвоичныеДанные = CW_РаботаСФайламиСервер.ДвоичныеДанныеФайла(file);
	Если ДвоичныеДанные = Неопределено Тогда
		Ответ = CW_РаботаСВнешнимиРесурсамиСервер.Ответ(404); 
		Ответ.УстановитьТелоИзСтроки("Файл не доступен");	
		Возврат Ответ;
	КонецЕсли;
	
	ДвоичныеДанныеJSON	= CW_ОбщийМодульЛичныйКабинетСервер.СериализацияXDTO_JSON(ДвоичныеДанные);
	
	СтруктураJSON = Новый Структура;
	СтруктураJSON.Вставить("uid",   		XMLСтрока(file.Объект));
	СтруктураJSON.Вставить("extension",   	XMLСтрока(file.Расширение));
	СтруктураJSON.Вставить("name",  		XMLСтрока(file.Наименование)); 
	СтруктураJSON.Вставить("binary", 		ДвоичныеДанныеJSON); 

	Ответ 		= CW_РаботаСВнешнимиРесурсамиСервер.Ответ(200);   
	СтрокаJSON  = CW_РаботаСВнешнимиРесурсамиСервер.ОбъектВСтрокуJSON(СтруктураJSON);
	
	Ответ.УстановитьТелоИзСтроки(СтрокаJSON);
	
	Возврат Ответ;
	
КонецФункции

Функция attachfilepost(Запрос)    
	
	СтруктураJSON = CW_РаботаСВнешнимиРесурсамиСервер.ПрочитатьHTTPСервисВОбъект(Запрос);  
	
	//Пользователь
	Если ПустаяСтрока(СтруктураJSON.username) Тогда  
		Ответ 	  = CW_РаботаСВнешнимиРесурсамиСервер.Ответ(408);
		ТекстТела = НСтр("ru='Ошибка авторизации пользователя'; en='User authorization error'", СтруктураJSON.language);
		Ответ.УстановитьТелоИзСтроки(ТекстТела);
		Возврат Ответ;
	КонецЕсли;	   
	
	ДанныеПользователя = CW_ЛичныйКабинетКлиентаСервер.ПолучитьДанныеПользователя(СтруктураJSON.username);
	Если ДанныеПользователя = Неопределено Тогда
		Ответ 	  = CW_РаботаСВнешнимиРесурсамиСервер.Ответ(408);
		ТекстТела = НСтр("ru='Пользователь %1 не найден'; en='User %1 not found'", СтруктураJSON.language);
		Ответ.УстановитьТелоИзСтроки(ТекстТела);
		Возврат Ответ;
	КонецЕсли;        
	//Пользователь

	МассивВладельцев = Новый Массив;
	Для Каждого ИдентификаторОбъекта из СтруктураJSON.shipments Цикл   
		Если СтруктураJSON.section = "ЗАЯВКИ" Тогда
			ОбъектАрхива = XMLЗначение(Тип("СправочникСсылка.CW_Заявки"), ИдентификаторОбъекта);  
		Иначе
			ОбъектАрхива = XMLЗначение(Тип("СправочникСсылка.CW_Грузоперевозки"), ИдентификаторОбъекта);  
		КонецЕсли;
		МассивВладельцев.Добавить(ОбъектАрхива);
	КонецЦикла; 

	КомментарийФайлов = "Загружено из ЛКК пользователем "+СокрЛП(СтруктураJSON.username);
	
	Для Каждого ДанныеФайла из СтруктураJSON.files Цикл
		Расширение 		= XMLЗначение(Тип("Строка"), ДанныеФайла.extension);
		ИмяФайла 		= XMLЗначение(Тип("Строка"), ДанныеФайла.name);
		
		Если НЕ ПустаяСтрока(ДанныеФайла.typefile) Тогда
			ТипДокумента 	= XMLЗначение(Тип("СправочникСсылка.CW_ТипыДокументовФайловогоАрхива"), ДанныеФайла.typefile);
		КонецЕсли;
		
		МассивДвоичныхДанных = Новый Массив;
		Для Каждого ЧастьФайла Из ДанныеФайла.parts Цикл
			ДвоичныеДанные = Base64Значение(ЧастьФайла);
			МассивДвоичныхДанных.Добавить(ДвоичныеДанные);
		КонецЦикла;
		
		ПолныеДвоичныеДанные = СоединитьДвоичныеДанные(МассивДвоичныхДанных);   
		
		ДанныеФайла = Новый Структура;
		ДанныеФайла.Вставить("Хранение", 		ПоместитьВоВременноеХранилище(ПолныеДвоичныеДанные, Новый УникальныйИдентификатор));
		ДанныеФайла.Вставить("Имя",				ИмяФайла);
		ДанныеФайла.Вставить("Расширение",		Расширение);
		ДанныеФайла.Вставить("Комментарий",		КомментарийФайлов);
		
		ПомещенныеФайлы = Новый Массив;
		ПомещенныеФайлы.Добавить(ДанныеФайла);
		
		CW_РаботаСФайламиСервер.ПрикрепитьФайлы(ПомещенныеФайлы, МассивВладельцев, ТипДокумента);
		
	КонецЦикла;  
	
	Ответ = CW_РаботаСВнешнимиРесурсамиСервер.Ответ(200);
	Возврат Ответ;   
	
КонецФункции

