	КонецЕсли;
	//--Мастер-профиль
	
	docid	= XMLЗначение(Тип("УникальныйИдентификатор"),	СтруктураJSON.docid); 
	type 	= XMLЗначение(Тип("ПеречислениеСсылка.CW_ВидыДокументовКомплекта"),	СтруктураJSON.type);  
	
	Если type = ПредопределенноеЗначение("Перечисление.CW_ВидыДокументовКомплекта.ОтчетЭкспедитора") Тогда
		Документ = Документы.CW_ОтчетЭкспедитора.ПолучитьСсылку(docid);  
	Иначе
		Документ = Документы.CW_ДоходыПоГрузоперевозке.ПолучитьСсылку(docid);  
	КонецЕсли;   
	
	Попытка
		ДокументОбъект = Документ.ПолучитьОбъект();
	Исключение
	КонецПопытки;
	Если ДокументОбъект = Неопределено Тогда
		Ответ = CW_РаботаСВнешнимиРесурсамиСервер.Ответ(404);
		Возврат Ответ;	
	КонецЕсли;   
	
	//Инициализация печатных форм
	мПодключаемыеобъекты = Новый Массив;
	
	Отбор = Новый Структура;
	Отбор.Вставить("ВидДокументаКомплекта", type);  
	
	КомплектПечатныхФорм = master.КомплектПечатныхФорм; 
	мСтроки = КомплектПечатныхФорм.СоставКомплекта.НайтиСтроки(Отбор); 
	
	Для Каждого СтрокаПечатныхФорм из мСтроки Цикл 
		Если Не СтрокаПечатныхФорм.ПодключаемыйОбъект.НеИспользуется Тогда
			мПодключаемыеобъекты.Добавить(СтрокаПечатныхФорм.ПодключаемыйОбъект);
		КонецЕсли;
	КонецЦикла;
	
	Если мПодключаемыеобъекты.Количество() = 0 Тогда
		Ответ 	  = CW_РаботаСВнешнимиРесурсамиСервер.Ответ(404);
		ТекстТела = НСтр("ru='Для профиля не указаны доступные печатные формы'; en='The available printing forms are not specified for the profile'", СокрЛП(ДанныеПользователя.Язык));
		Ответ.УстановитьТелоИзСтроки(ТекстТела);
		Возврат Ответ;                              
	Конецесли;
	//--Инициализация печатных форм
	
	
	мОбъектыПечати = Новый Массив;
	мОбъектыПечати.Добавить(Документ);  
	
	МассивПечатныхФорм = Новый Массив;
	
	СтруктураВозврата = CW_Печать.ПолучитьПараметрыФормыПечати(мОбъектыПечати,  Новый УникальныйИдентификатор, Истина);
	Если _УФКС.ВыполненоУспешно(СтруктураВозврата) Тогда
		
		ПакетДокументов = ПолучитьИзВременногоХранилища(СтруктураВозврата.ПФ.АдресПакета);
		Для Каждого Документ Из ПакетДокументов.Элементы Цикл 
			Для Каждого ПечатнаяФорма Из Документ.Элементы Цикл  
				НавигационнаяСсылка = ПечатнаяФорма.НавигационнаяСсылка;
				ПодключаемыйОбъект = ПолучитьСсылкуИзНавигационной(НавигационнаяСсылка); 
				Если мПодключаемыеобъекты.Найти(ПодключаемыйОбъект) <> Неопределено Тогда
					МассивПечатныхФорм.Добавить(ПечатнаяФорма);	
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
		
	КонецЕсли;  
	
	СоответствиеИмениФайла = Новый Соответствие;
	СоответствиеИмениФайла.Вставить(ПредопределенноеЗначение("Перечисление.CW_ВидыДокументовКомплекта.Счет"), 				Нстр("ru='Счет';en='Invoice'", СокрЛП(ДанныеПользователя.Язык)));
	СоответствиеИмениФайла.Вставить(ПредопределенноеЗначение("Перечисление.CW_ВидыДокументовКомплекта.Реализация"), 		Нстр("ru='Акт';en='Act'", СокрЛП(ДанныеПользователя.Язык)));
	СоответствиеИмениФайла.Вставить(ПредопределенноеЗначение("Перечисление.CW_ВидыДокументовКомплекта.ОтчетЭкспедитора"), 	Нстр("ru='Отчет экспедитора';en='Report'", СокрЛП(ДанныеПользователя.Язык)));
	
	ИмяФайлаДокументов = СоответствиеИмениФайла.Получить(type);
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла("PDF");
	
	Пакет = Новый ПакетОтображаемыхДокументов;
	Для каждого ПечатнаяФорма Из МассивПечатныхФорм Цикл
		ЭлементПакета = Пакет.Состав.Добавить();
		ЭлементПакета.Данные 		= ПоместитьВоВременноеХранилище(ПечатнаяФорма.ПФ, Новый УникальныйИдентификатор);
		ЭлементПакета.Наименование 	= ПечатнаяФорма.Имя;
	КонецЦикла;
	
	Пакет.Записать(ИмяВременногоФайла, ТипФайлаПакетаОтображаемыхДокументов.PDF);
	
	ДвоичныеДанные 	= Новый ДвоичныеДанные(ИмяВременногоФайла); 
	УдалитьФайлы(ИмяВременногоФайла);
	
	ДвоичныеДанныеJSON	= CW_ОбщийМодульЛичныйКабинетСервер.СериализацияXDTO_JSON(ДвоичныеДанные);
	
	СтруктураJSON = новый Структура;
	СтруктураJSON.Вставить("name",		XMLСтрока(ИмяФайлаДокументов));
	СтруктураJSON.Вставить("extension",	XMLСтрока(".pdf"));   
	СтруктураJSON.Вставить("binary", 	ДвоичныеДанныеJSON); 
	
	Ответ 		= CW_РаботаСВнешнимиРесурсамиСервер.Ответ(200);   
	
	СтрокаJSON  = CW_РаботаСВнешнимиРесурсамиСервер.ОбъектВСтрокуJSON(СтруктураJSON);
	Ответ.УстановитьТелоИзСтроки(СтрокаJSON);
	
	Возврат Ответ;
	
КонецФункции
 //Работа с файлами

//Получение данных для формы объекта
Функция printtemplateget(Запрос)  
	
	УстановитьПривилегированныйРежим(Истина);  
	
	СтрокаJSON 		= Запрос.ПолучитьТелоКакСтроку();
	СтруктураJSON 	= CW_РаботаСВнешнимиРесурсамиСервер.СтрокаJSONВОбъект(СтрокаJSON);  
	
	//Пользователь
	Если ПустаяСтрока(СтруктураJSON.username) Тогда  
		ТекстТела = НСтр("ru='Ошибка авторизации пользователя'; en='User authorization error'", СтруктураJSON.language);
		Ответ = CW_РаботаСВнешнимиРесурсамиСервер.Ответ(408);
		Ответ.УстановитьТелоИзСтроки(ТекстТела);
		Возврат Ответ;
	КонецЕсли;	
	
	ДанныеПользователя = CW_ЛичныйКабинетКлиентаСервер.ПолучитьДанныеПользователя(СтруктураJSON.username);
	Если ДанныеПользователя = Неопределено Тогда
		ТекстТела = НСтр("ru='Пользователь %1 не найден'; en='User %1 not found'", СтруктураJSON.language);
		Ответ = CW_РаботаСВнешнимиРесурсамиСервер.Ответ(408);
		Ответ.УстановитьТелоИзСтроки(ТекстТела);
		Возврат Ответ;
	КонецЕсли;   
	//---Пользователь
	
	//Мастер-профиль
	masterprofileid	= XMLЗначение(Тип("УникальныйИдентификатор"),	СтруктураJSON.masterprofile); 
	master 			= Справочники.CW_ВебПрофили.ПолучитьСсылку(masterprofileid);  
	Если ЗначениеЗаполнено(master) Тогда
		Попытка
			masterПрофильОбъект = master.ПолучитьОбъект();
		Исключение
		КонецПопытки;
		Если masterПрофильОбъект = Неопределено Тогда
			master = ПредопределенноеЗначение("Справочник.CW_ВебПрофили.ПустаяСсылка");   
		КонецЕсли;  
	КонецЕсли;	
	
	Если Не ЗначениеЗаполнено(master) Тогда
		Ответ = CW_РаботаСВнешнимиРесурсамиСервер.Ответ(408);
		ТекстТела = НСтр("ru='Не удалось идентифицировать основной профиль'; en='The main profile could not be identified'", СокрЛП(ДанныеПользователя.Язык));
		Ответ.УстановитьТелоИзСтроки(ТекстТела);
		Возврат Ответ;
	КонецЕсли;
	//--Мастер-профиль     

    //Профиль
	profileid	= XMLЗначение(Тип("УникальныйИдентификатор"),	СтруктураJSON.profile);  
	Если СтруктураJSON.section = "ЗАЯВКИ" Тогда
		profile 	  = Справочники.CW_ВебПрофилиЗаявок.ПолучитьСсылку(profileid);  
		ПустойПрофиль = ПредопределенноеЗначение("Справочник.CW_ВебПрофилиЗаявок.ПустаяСсылка");   
		ОбъектАрхива  = XMLЗначение(Тип("СправочникСсылка.CW_Заявки"), СтруктураJSON.id); 
	ИначеЕсли СтруктураJSON.section = "ГРУЗОПЕРЕВОЗКИ" Тогда
		profile 	  = Справочники.CW_ВебПрофилиПеревозок.ПолучитьСсылку(profileid);  
		ПустойПрофиль = ПредопределенноеЗначение("Справочник.CW_ВебПрофилиПеревозок.ПустаяСсылка");   
		ОбъектАрхива  = XMLЗначение(Тип("СправочникСсылка.CW_Грузоперевозки"), СтруктураJSON.id); 
	Иначе
		ТекстТела = НСтр("ru='Не удалось определить раздел данных'; en='The data section could not be identified'", СтруктураJSON.language);
		Ответ = CW_РаботаСВнешнимиРесурсамиСервер.Ответ(408);
		Ответ.УстановитьТелоИзСтроки(ТекстТела);
		Возврат Ответ;
	КонецЕсли; 
	
	Если ЗначениеЗаполнено(profile) Тогда
		Попытка
			ПрофильОбъект = profile.ПолучитьОбъект();
		Исключение
		КонецПопытки;
		Если ПрофильОбъект = Неопределено Тогда
			profile = ПустойПрофиль;   
		КонецЕсли;  
	КонецЕсли;
    //--Профиль
	
	//Доступные пользователю профили
	ТаблицаДоступныхПрофилей = ПолучитьТаблицуДоступныхПрофилей(ДанныеПользователя, master, СтруктураJSON.section, profile, ПустойПрофиль);
	Если ТаблицаДоступныхПрофилей.Количество() = 0 Тогда
		Ответ = CW_РаботаСВнешнимиРесурсамиСервер.Ответ(408);	
		Ответ.УстановитьТелоИзСтроки("Нет доступных профилей");
		Возврат Ответ;
	КонецЕсли;
	//--Доступные пользователю профили   
	
	МассивФайлов 		= Новый Массив; 
	viewfiles			= XMLЗначение(Тип("Булево"), СтруктураJSON.viewfiles);  
	Если viewfiles И ЗначениеЗаполнено(ОбъектАрхива) Тогда  
		ЗаполнитьМассивФайлов(ДанныеПользователя, profile, ОбъектАрхива, МассивФайлов); 
		Если ТипЗнч(ОбъектАрхива) = Тип("СправочникСсылка.CW_Грузоперевозки") 
			И ЗначениеЗаполнено(ОбъектАрхива.Заказ) Тогда
			ЗаполнитьМассивФайлов(ДанныеПользователя, profile, ОбъектАрхива.Заказ, МассивФайлов); 
		КонецЕсли;
	КонецЕсли;
	
	ДоступныеТипыФайлов = profile.ТипыФайлов.Выгрузить().ВыгрузитьКолонку("Тип");	
	МассивТиповФайлов 		= Новый Массив;  
	ЗапрашиватьТипФайла = ПолучитьФункциональнуюОпцию("CW_ЗапрашиватьТипФайлаПриДобавленииВАрхив");
	Если ЗапрашиватьТипФайла Тогда     
		ЗаполнитьМассивТиповФайлов(ДоступныеТипыФайлов, МассивТиповФайлов, ДанныеПользователя.Язык); 
	КонецЕсли;
	
	МассивДокументов 	= Новый Массив; 
	viewdocs			= XMLЗначение(Тип("Булево"), СтруктураJSON.viewdocs);  
	Если viewdocs И ЗначениеЗаполнено(ОбъектАрхива) Тогда  
		ЗаполнитьМассивДокументов(master, profile, ОбъектАрхива, МассивДокументов);  
	КонецЕсли;      

	printtemplate 		= Справочники.CW_ВебШаблоныПрофилей.ПолучитьСтруктуруПечатнойФормы(profile.ШаблонПрофиля, СокрЛП(ДанныеПользователя.Язык));
	МаксимальныйРазмер  = Константы.CW_ЛичныйКабинетОграничениеРазмераФайла.Получить();
	
	Ответ = CW_РаботаСВнешнимиРесурсамиСервер.Ответ(200);

	СтруктураJSON = Новый Структура;
	СтруктураJSON.Вставить("printtemplate",	printtemplate);    
	СтруктураJSON.Вставить("files", 		МассивФайлов);
	СтруктураJSON.Вставить("docs", 			МассивДокументов);
	СтруктураJSON.Вставить("filestype", 	МассивТиповФайлов);   
	СтруктураJSON.Вставить("maximumsize", 	XMLСтрока(МаксимальныйРазмер));   
	
	СтрокаJSON = CW_РаботаСВнешнимиРесурсамиСервер.ОбъектВСтрокуJSON(СтруктураJSON);

	Ответ.УстановитьТелоИзСтроки(СтрокаJSON);	
	
	Возврат Ответ;

КонецФункции  
//Получение данных для формы объекта 

//API
Функция apiprofilesget(Запрос) 
	
	УстановитьПривилегированныйРежим(Истина);
	
	СтрокаJSON 	  = Запрос.ПолучитьТелоКакСтроку();
	СтруктураJSON =	CW_ОбщийМодульЛичныйКабинетСервер.СериализацияJSON_XDTO(СтрокаJSON);
	
	//Пользователь
	Если ПустаяСтрока(СтруктураJSON.username) Тогда  
		ТекстТела 	= "Authorization error";
		Ответ = CW_РаботаСВнешнимиРесурсамиСервер.Ответ(408);
		Ответ.УстановитьТелоИзСтроки(ТекстТела);
		Возврат Ответ;
	КонецЕсли;	
	
	ДанныеПользователя = CW_ЛичныйКабинетКлиентаСервер.ПолучитьДанныеПользователя(СтруктураJSON.username);
	Если ДанныеПользователя = Неопределено Тогда
		Ответ 	  = CW_РаботаСВнешнимиРесурсамиСервер.Ответ(408);
		ТекстТела = "User "+СтруктураJSON.username+" not found";
		Ответ.УстановитьТелоИзСтроки(ТекстТела);
		Возврат Ответ;
	КонецЕсли;        
	//--Пользователь
	
	
	//Доступные пользователю профили    
	КодЯзыка = СокрЛП(ДанныеПользователя.Язык);

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	CW_ПользователиВебПрофилей.ОсновнойПрофиль КАК ОсновнойПрофиль,
	               |	CW_ПользователиВебПрофилей.ВебПрофиль КАК ВебПрофиль
	               |ИЗ
	               |	РегистрСведений.CW_ПользователиВебПрофилей КАК CW_ПользователиВебПрофилей
	               |ГДЕ
	               |	CW_ПользователиВебПрофилей.Раздел = &Раздел
	               |	И CW_ПользователиВебПрофилей.Пользователь = &Пользователь
	               |	И CW_ПользователиВебПрофилей.ВебПрофиль.Активный = ИСТИНА
	               |ИТОГИ ПО
	               |	ОсновнойПрофиль"; 
	
	Запрос.УстановитьПараметр("Раздел", 			"ГРУЗОПЕРЕВОЗКИ");
	Запрос.УстановитьПараметр("Пользователь", 		ДанныеПользователя.Пользователь); 
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ДеревоПрофилей = Новый ДеревоЗначений;
	ДеревоПрофилей.Колонки.Добавить("id", 	Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(36)), 	"id");
	ДеревоПрофилей.Колонки.Добавить("name", Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(255)), 	"name");
	
	ВыборкаОсновнойПрофиль = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаОсновнойПрофиль.Следующий() Цикл 
		
		ОсновнойПрофильПредставление = НСтр("ru='"+СокрЛП(ВыборкаОсновнойПрофиль.ОсновнойПрофиль.ПредставлениеRU)+"';
											|en='"+СокрЛП(ВыборкаОсновнойПрофиль.ОсновнойПрофиль.ПредставлениеEN)+"'", КодЯзыка);
		
		СтрокаОсновнойПрофиль = ДеревоПрофилей.Строки.Добавить();
		СтрокаОсновнойПрофиль.id 	= XMLСтрока(ВыборкаОсновнойПрофиль.ОсновнойПрофиль); 
		СтрокаОсновнойПрофиль.name 	= XMLСтрока(ОсновнойПрофильПредставление); 
		
		ВыборкаПрофиль = ВыборкаОсновнойПрофиль.Выбрать();
		Пока ВыборкаПрофиль.Следующий() Цикл    
			
			ВебПрофильПредставление = НСтр("ru='"+СокрЛП(ВыборкаПрофиль.ВебПрофиль.ПредставлениеRU)+"';
										   |en='"+СокрЛП(ВыборкаПрофиль.ВебПрофиль.ПредставлениеEN)+"'", КодЯзыка);
			
			СтрокаПрофиль = СтрокаОсновнойПрофиль.Строки.Добавить();
			СтрокаПрофиль.id	= XMLСтрока(ВыборкаПрофиль.ВебПрофиль); 
			СтрокаПрофиль.name 	= XMLСтрока(ВебПрофильПредставление); 
		КонецЦикла;
		
	КонецЦикла;
	
	ДеревоJSON = CW_ОбщийМодульЛичныйКабинетСервер.СериализацияXDTO_JSON(ДеревоПрофилей);
	
	Ответ = CW_РаботаСВнешнимиРесурсамиСервер.Ответ(200);	
	Ответ.УстановитьТелоИзСтроки(ДеревоJSON);	
	
	Возврат Ответ;

КонецФункции

Функция apitruckingget(Запрос)
	
	УстановитьПривилегированныйРежим(Истина);  
	
	ЗапрашиватьТипФайла 	= ПолучитьФункциональнуюОпцию("CW_ЗапрашиватьТипФайлаПриДобавленииВАрхив");
	
	СтрокаJSON 		= Запрос.ПолучитьТелоКакСтроку();
	СтруктураJSON 	= CW_ОбщийМодульЛичныйКабинетСервер.СериализацияJSON_XDTO(СтрокаJSON);

	//Пользователь
	Если ПустаяСтрока(СтруктураJSON.username) Тогда  
		Ответ 		= CW_РаботаСВнешнимиРесурсамиСервер.Ответ(408);
		ТекстТела 	= "Authorization error";
		Ответ.УстановитьТелоИзСтроки(ТекстТела);
		Возврат Ответ;
	КонецЕсли;	
	
	ДанныеПользователя = CW_ЛичныйКабинетКлиентаСервер.ПолучитьДанныеПользователя(СтруктураJSON.username);
	Если ДанныеПользователя = Неопределено Тогда
		Ответ 		= CW_РаботаСВнешнимиРесурсамиСервер.Ответ(408);
		ТекстТела 	= "User "+СтруктураJSON.username+" not found";
		Ответ.УстановитьТелоИзСтроки(ТекстТела);
		Возврат Ответ;
	КонецЕсли;        
	//--Пользователь
	
	//Мастер-профиль
	masterprofileid	= XMLЗначение(Тип("УникальныйИдентификатор"),	СтруктураJSON.masterprofile); 
	master 			= Справочники.CW_ВебПрофили.ПолучитьСсылку(masterprofileid);  
 	Если ЗначениеЗаполнено(master) Тогда
		Попытка
			masterПрофильОбъект = master.ПолучитьОбъект();
		Исключение
		КонецПопытки;
		Если masterПрофильОбъект = Неопределено Тогда
			master = ПредопределенноеЗначение("Справочник.CW_ВебПрофили.ПустаяСсылка");   
		КонецЕсли;  
	КонецЕсли;	
	
	Если Не ЗначениеЗаполнено(master) Тогда
		Ответ 		= CW_РаботаСВнешнимиРесурсамиСервер.Ответ(408);
		ТекстТела 	= "The main profile could not be identified";
		Ответ.УстановитьТелоИзСтроки(ТекстТела);
		Возврат Ответ;
	КонецЕсли;
	//--Мастер-профиль     
	
	//Профиль
	idprofile	= XMLЗначение(Тип("УникальныйИдентификатор"),	СтруктураJSON.profile); 
	profile		= Справочники.CW_ВебПрофилиПеревозок.ПолучитьСсылку(idprofile);  
	Если ЗначениеЗаполнено(idprofile) Тогда
		Попытка
			ПрофильОбъект = profile.ПолучитьОбъект();
		Исключение
		КонецПопытки;
		Если ПрофильОбъект = Неопределено Тогда
			profile = ПредопределенноеЗначение("Справочник.CW_ВебПрофилиЗаявок.ПустаяСсылка");   
		КонецЕсли;  
	КонецЕсли;	
	//--Профиль
	
	//Доступные пользователю профили 
	ТаблицаДоступныхПрофилей = ПолучитьТаблицуДоступныхПрофилей(ДанныеПользователя, master, "ГРУЗОПЕРЕВОЗКИ", profile, ПредопределенноеЗначение("Справочник.CW_ВебПрофилиПеревозок.ПустаяСсылка"));
	Если ТаблицаДоступныхПрофилей.Количество() = 0 Тогда
		Ответ 		= CW_РаботаСВнешнимиРесурсамиСервер.Ответ(408);
		ТекстТела 	= "The profile could not be identified";
		Ответ.УстановитьТелоИзСтроки(ТекстТела);
		Возврат Ответ;
	КонецЕсли;
	//Доступные пользователю профили     
	
	СкрытьПолеСсылка = Ложь;
	status	= XMLЗначение(Тип("Число"),		СтруктураJSON.status);     
	ТаблицаПеревозок = CW_ЛичныйКабинетКлиентаСервер.ПолучитьТаблицуПеревозок(master, profile, profile.ШаблонПрофиля, status, СокрЛП(ДанныеПользователя.Язык), СкрытьПолеСсылка);
	
	ВремТаблица = Новый ТаблицаЗначений;
	Для Каждого Колонка из ТаблицаПеревозок.Колонки Цикл 
		
		Если Колонка.ТипЗначения.СодержитТип(Тип("Дата")) Тогда
			ТипКолонки = Новый ОписаниеТипов("Дата");  
		ИначеЕсли Колонка.ТипЗначения.СодержитТип(Тип("Число")) Тогда
			ТипКолонки = Новый ОписаниеТипов("Число");  
		ИначеЕсли Колонка.ТипЗначения.СодержитТип(Тип("Булево")) Тогда
			ТипКолонки = Новый ОписаниеТипов("Булево");  
		Иначе
			ТипКолонки = Новый ОписаниеТипов("Строка");  
		КонецЕсли;
		
		ВремТаблица.Колонки.Добавить(Колонка.Имя, ТипКолонки, Колонка.Заголовок);
	КонецЦикла; 
	
	Для Каждого СтрокаТаблицы из ТаблицаПеревозок Цикл
		НоваяСтрока = ВремТаблица.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
	КонецЦикла;
	
	tableJSON = CW_ОбщийМодульЛичныйКабинетСервер.СериализацияXDTO_JSON(ВремТаблица);   
	
  	Ответ = CW_РаботаСВнешнимиРесурсамиСервер.Ответ(200);	
	Ответ.УстановитьТелоИзСтроки(tableJSON);	
	
	Возврат Ответ;

КонецФункции
