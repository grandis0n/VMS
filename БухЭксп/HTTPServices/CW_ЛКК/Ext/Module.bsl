//Раздел "Перевозки"
Функция truckingget(Запрос) 
	
	УстановитьПривилегированныйРежим(Истина);  
	
	ЗапрашиватьТипФайла 	= ПолучитьФункциональнуюОпцию("CW_ЗапрашиватьТипФайлаПриДобавленииВАрхив");
	
	СтрокаJSON 		= Запрос.ПолучитьТелоКакСтроку();
	СтруктураJSON 	= CW_РаботаСВнешнимиРесурсамиСервер.СтрокаJSONВОбъект(СтрокаJSON);   

	//Пользователь
	Если ПустаяСтрока(СтруктураJSON.username) Тогда  
		Ответ = CW_РаботаСВнешнимиРесурсамиСервер.Ответ(408);
		ТекстТела = НСтр("ru='Ошибка авторизации пользователя'; en='User authorization error'", СтруктураJSON.language);
		Ответ.УстановитьТелоИзСтроки(ТекстТела);
		Возврат Ответ;
	КонецЕсли;	
	
	ДанныеПользователя = CW_ЛичныйКабинетКлиентаСервер.ПолучитьДанныеПользователя(СтруктураJSON.username);
	Если ДанныеПользователя = Неопределено Тогда
		Ответ = CW_РаботаСВнешнимиРесурсамиСервер.Ответ(408);
		ТекстТела = НСтр("ru='Пользователь %1 не найден'; en='User %1 not found'", СтруктураJSON.language);
		Ответ.УстановитьТелоИзСтроки(ТекстТела);
		Возврат Ответ;
	КонецЕсли;        
	//--Пользователь
	
	//Мастер-профиль
	masterprofileid	= XMLЗначение(Тип("УникальныйИдентификатор"),	СтруктураJSON.masterprofile); 
	master 			= Справочники.CW_ВебПрофили.ПолучитьСсылку(masterprofileid);  
 	Если ЗначениеЗаполнено(master) Тогда
		Попытка
			masterПрофильОбъект = master.ПолучитьОбъект();
		Исключение
		КонецПопытки;
		Если masterПрофильОбъект = Неопределено Тогда
			master = ПредопределенноеЗначение("Справочник.CW_ВебПрофили.ПустаяСсылка");   
		КонецЕсли;  
	КонецЕсли;	
	
	Если Не ЗначениеЗаполнено(master) Тогда
		Ответ = CW_РаботаСВнешнимиРесурсамиСервер.Ответ(408);
		ТекстТела = НСтр("ru='Не удалось идентифицировать основной профиль'; en='The main profile could not be identified'", СокрЛП(ДанныеПользователя.Язык));
		Ответ.УстановитьТелоИзСтроки(ТекстТела);
		Возврат Ответ;
	КонецЕсли;
	//--Мастер-профиль     
	
	//Профиль
	idprofile	= XMLЗначение(Тип("УникальныйИдентификатор"),	СтруктураJSON.profile); 
	profile		= Справочники.CW_ВебПрофилиПеревозок.ПолучитьСсылку(idprofile);  
	Если ЗначениеЗаполнено(idprofile) Тогда
		Попытка
			ПрофильОбъект = profile.ПолучитьОбъект();
		Исключение
		КонецПопытки;
		Если ПрофильОбъект = Неопределено Тогда
			profile = ПредопределенноеЗначение("Справочник.CW_ВебПрофилиЗаявок.ПустаяСсылка");   
		КонецЕсли;  
	КонецЕсли;	
	//--Профиль
	
	//Доступные пользователю профили 
	ТаблицаДоступныхПрофилей = ПолучитьТаблицуДоступныхПрофилей(ДанныеПользователя, master, "ГРУЗОПЕРЕВОЗКИ", profile, ПредопределенноеЗначение("Справочник.CW_ВебПрофилиПеревозок.ПустаяСсылка"));
	Если ТаблицаДоступныхПрофилей.Количество() = 0 Тогда
		Ответ = CW_РаботаСВнешнимиРесурсамиСервер.Ответ(408);
		Ответ.УстановитьТелоИзСтроки("Нет доступных профилей");
		Возврат Ответ;
	КонецЕсли;
	//Доступные пользователю профили  
	
	СтруктураПрофиля 		= profile.ШаблонПрофиля.СтруктураПрофиля.Выгрузить();
	ОписаниеТиповВсеСсылки 	= ОбщегоНазначения.ОписаниеТипаВсеСсылки();
	
	//Описание колонок 
	ВременнаяТаблица = Новый ТаблицаЗначений; 
	ВременнаяТаблица.Колонки.Добавить("id", Новый ОписаниеТипов("Строка")); 
	
	Если profile.ВыгружатьФайлы Тогда
		ВременнаяТаблица.Колонки.Добавить("ЕстьФайлы", Новый ОписаниеТипов("Булево")); 
	КонецЕсли;
	Если master.ВыводитьФинансовыеДокументы Тогда
		ВременнаяТаблица.Колонки.Добавить("ЕстьДокументы", Новый ОписаниеТипов("Булево")); 
	КонецЕсли;
	
	columnparameters = Новый Соответствие;
	Для Каждого СтрокаСтруктуры из СтруктураПрофиля Цикл
		
		ИндексСтроки    = СтруктураПрофиля.Индекс(СтрокаСтруктуры); 
	
		ЗаголовокПоля   = Нстр("ru='"+СтрокаСтруктуры.ЗаголовокRU+"'; en='"+СтрокаСтруктуры.ЗаголовокEN+"'", СокрЛП(ДанныеПользователя.Язык));
		
		Формат = "";
		Если СтрокаСтруктуры.ДоступенФормат Тогда
			Формат = Строка(СтрокаСтруктуры.Формат);
		КонецЕсли;  
		
		ОписаниеТипа 	= СтрокаСтруктуры.ХранилищеТипаЗначения.Получить();
		ПустоеЗначение 	= ОписаниеТипа.ПривестиЗначение(Неопределено);
		ЭтоСсылка 		= ОписаниеТиповВсеСсылки.СодержитТип(ТипЗнч(ПустоеЗначение)); 
		Если ЭтоСсылка Тогда
			ОписаниеТипа = Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(255)); 
		КонецЕсли; 
		
		Если ТипЗнч(ПустоеЗначение) = Тип("Дата")
			И СтрНайти(Формат, "ДП=") = 0 Тогда   
			мФормат = СтрРазделить(Формат, "; ");  
			мФормат.Добавить("ДП=' '");
			
			Формат = СтрСоединить(мФормат, "; ");
		КонецЕсли;         
		
		ОписаниеКолонки = Новый Структура;
		ОписаниеКолонки.Вставить("name", 			XMLСтрока(ЗаголовокПоля));
		ОписаниеКолонки.Вставить("type", 			CW_ОбщийМодульЛичныйКабинетСервер.СериализацияXDTO_JSON(ОписаниеТипа));
		ОписаниеКолонки.Вставить("format", 			XMLСтрока(Формат));
		ОписаниеКолонки.Вставить("userselection", 	XMLСтрока(СтрокаСтруктуры.БыстрыйОтбор));
		ОписаниеКолонки.Вставить("fixed", 			XMLСтрока(СтрокаСтруктуры.Фиксация));
		ОписаниеКолонки.Вставить("fieldorder", 		XMLСтрока(ИндексСтроки));  
		
		columnparameters.Вставить(XMLСтрока(СтрокаСтруктуры.ИмяПоля), ОписаниеКолонки); 
		
		ВременнаяТаблица.Колонки.Добавить(СтрокаСтруктуры.ИмяПоля, ОписаниеТипа, ЗаголовокПоля);
	КонецЦикла;
	//Описание колонок  "ДП="
	
	//Таблица грузоперевозок 
	СкрытьПолеСсылка = Ложь;  
  	status 			 = XMLЗначение(Тип("Число"),		СтруктураJSON.status);     
	ТаблицаПеревозок = CW_ЛичныйКабинетКлиентаСервер.ПолучитьТаблицуПеревозок(master, profile, profile.ШаблонПрофиля, status, СокрЛП(ДанныеПользователя.Язык), СкрытьПолеСсылка);
	Для Каждого СтрокаТаблицы из ТаблицаПеревозок Цикл
		 НоваяСтрока = ВременнаяТаблица.Добавить(); 
		 ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
		 НоваяСтрока.id = XMLСтрока(СтрокаТаблицы.Ссылка);
	КонецЦикла;
	
	table = CW_ОбщийМодульЛичныйКабинетСервер.СериализацияXDTO_JSON(ВременнаяТаблица);   
	//Таблица грузоперевозок 
	
	//Доступные профили                        
	ДоступныеПрофили = Новый Соответствие;
	Для Каждого СтрокаДоступныхПрофилей из ТаблицаДоступныхПрофилей Цикл   
		
		НаименованиеПрофиля = Нстр("ru='"+СтрокаДоступныхПрофилей.ПредставлениеRU+"'; en='"+СтрокаДоступныхПрофилей.ПредставлениеEN+"'", СокрЛП(ДанныеПользователя.Язык));
		ВыгружатьФайлы 		= СтрокаДоступныхПрофилей.ВыгружатьФайлы и ДанныеПользователя.ВыгружатьФайлы;
		
		ПараметрыПрофиля = новый Структура;
		ПараметрыПрофиля.Вставить("name", 			XMLСтрока(НаименованиеПрофиля));
		ПараметрыПрофиля.Вставить("main", 			XMLСтрока(СтрокаДоступныхПрофилей.Основной));
		ПараметрыПрофиля.Вставить("viewfiles",		XMLСтрока(ВыгружатьФайлы));
		ПараметрыПрофиля.Вставить("viewdocs",		XMLСтрока(ДанныеПользователя.ВыгружатьПечатныеФормы));
		ПараметрыПрофиля.Вставить("attachfiles",	XMLСтрока(СтрокаДоступныхПрофилей.РазрешеноПрикреплятьФайлы));
		
		ПараметрыПрофиля.Вставить("create",			XMLСтрока(СтрокаДоступныхПрофилей.ДоступноСозданиеЗавок));  
		ПараметрыПрофиля.Вставить("hidelink", 		XMLСтрока(СкрытьПолеСсылка));
		
		//Шаблоны заявок        
		МассивШаблонов = Новый Массив;      
		
		
		ШаблоныПрофиля = СтрокаДоступныхПрофилей.ОсновнойПрофиль.ШаблоныЗаявок.ВыгрузитьКолонку("Шаблон");
		
		Для Каждого Шаблон из ШаблоныПрофиля Цикл
			
			НаименованиеШаблона = Нстр("ru='"+Шаблон.ПредставлениеRU+"'; en='"+Шаблон.ПредставлениеEN+"'", СокрЛП(ДанныеПользователя.Язык));
			
			ДанныеШаблона = Новый Структура;
			ДанныеШаблона.Вставить("id", XMLСтрока(Шаблон.Ссылка));
			ДанныеШаблона.Вставить("name", XMLСтрока(НаименованиеШаблона));
			
			МассивШаблонов.Добавить(ДанныеШаблона);	
			
		КонецЦикла;   

		ПараметрыПрофиля.Вставить("creationtemplates",	МассивШаблонов);   
		//Шаблроны заявок
	
		//Типы файлов
		ДоступныеТипыФайлов = СтрокаДоступныхПрофилей.ВебПрофиль.ТипыФайлов.Выгрузить().ВыгрузитьКолонку("Тип");	
		МассивТиповФайлов = новый Массив;   
		Если ЗапрашиватьТипФайла Тогда
			ЗаполнитьМассивТиповФайлов(ДоступныеТипыФайлов, МассивТиповФайлов, ДанныеПользователя.Язык);
		КонецЕсли;
		ПараметрыПрофиля.Вставить("filestype",		МассивТиповФайлов);   
		//Типы файлов     
		
		ДоступныеПрофили.Вставить(XMLСтрока(СтрокаДоступныхПрофилей.ВебПрофиль), ПараметрыПрофиля);
	КонецЦикла;  
	//Доступные профили      
	
	МаксимальныйРазмер = Константы.CW_ЛичныйКабинетОграничениеРазмераФайла.Получить();
	
	СтруктураJSON = Новый Соответствие;    
	СтруктураJSON.Вставить("table", 			table);  
	СтруктураJSON.Вставить("profiles", 			ДоступныеПрофили);
	СтруктураJSON.Вставить("currentprofile", 	XMLСтрока(profile));
	СтруктураJSON.Вставить("columnparameters", 	columnparameters);	
	СтруктураJSON.Вставить("maximumsize", 		XMLСтрока(МаксимальныйРазмер));   

	СтрокаJSON = CW_РаботаСВнешнимиРесурсамиСервер.ОбъектВСтрокуJSON(СтруктураJSON);
	
	Ответ = CW_РаботаСВнешнимиРесурсамиСервер.Ответ(200);
	
	Ответ.УстановитьТелоИзСтроки(СтрокаJSON);	
	
	Возврат Ответ;
	
КонецФункции
//--Раздел "Перевозки"


//Раздел "Заявки"
Функция requestsget(Запрос)

	УстановитьПривилегированныйРежим(Истина);  
	
	ЗапрашиватьТипФайла 	= ПолучитьФункциональнуюОпцию("CW_ЗапрашиватьТипФайлаПриДобавленииВАрхив");
	
	СтрокаJSON 		= Запрос.ПолучитьТелоКакСтроку();
	СтруктураJSON 	= CW_РаботаСВнешнимиРесурсамиСервер.СтрокаJSONВОбъект(СтрокаJSON);  
	
	//Пользователь
	Если ПустаяСтрока(СтруктураJSON.username) Тогда  
		Ответ 	  = CW_РаботаСВнешнимиРесурсамиСервер.Ответ(408);
		ТекстТела = НСтр("ru='Ошибка авторизации пользователя'; en='User authorization error'", СтруктураJSON.language);
		Ответ.УстановитьТелоИзСтроки(ТекстТела);
		Возврат Ответ;
	КонецЕсли;	   
	
	ДанныеПользователя = CW_ЛичныйКабинетКлиентаСервер.ПолучитьДанныеПользователя(СтруктураJSON.username);
	Если ДанныеПользователя = Неопределено Тогда
		Ответ 	  = CW_РаботаСВнешнимиРесурсамиСервер.Ответ(408);
		ТекстТела = НСтр("ru='Пользователь %1 не найден'; en='User %1 not found'", СтруктураJSON.language);
		Ответ.УстановитьТелоИзСтроки(ТекстТела);
		Возврат Ответ;
	КонецЕсли;        
	//Пользователь

	//Мастер-профиль
	masterprofileid	= XMLЗначение(Тип("УникальныйИдентификатор"),	СтруктураJSON.masterprofile); 
	master			= Справочники.CW_ВебПрофили.ПолучитьСсылку(masterprofileid);  
 	Если ЗначениеЗаполнено(master) Тогда
		Попытка
			masterПрофильОбъект = master.ПолучитьОбъект();
		Исключение
		КонецПопытки;
		Если masterПрофильОбъект = Неопределено Тогда
			master = ПредопределенноеЗначение("Справочник.CW_ВебПрофили.ПустаяСсылка");   
		КонецЕсли;  
	КонецЕсли;	
	
	Если Не ЗначениеЗаполнено(master) Тогда
		Ответ 	  = CW_РаботаСВнешнимиРесурсамиСервер.Ответ(408);
		ТекстТела = НСтр("ru='Не удалось идентифицировать основной профиль'; en='The main profile could not be identified'", СокрЛП(ДанныеПользователя.Язык));
		Ответ.УстановитьТелоИзСтроки(ТекстТела);
		Возврат Ответ;
	КонецЕсли;
	//Мастер-профиль
	
	//веб-профиль
	profileid	= XMLЗначение(Тип("УникальныйИдентификатор"),	СтруктураJSON.profile);  
	profile 	= Справочники.CW_ВебПрофили.ПолучитьСсылку(profileid);  
	Если ЗначениеЗаполнено(profileid) Тогда
		Попытка
			ПрофильОбъект = profile.ПолучитьОбъект();
		Исключение
		КонецПопытки;
		Если ПрофильОбъект = Неопределено Тогда
			profile = ПредопределенноеЗначение("Справочник.CW_ВебПрофилиЗаявок.ПустаяСсылка");   
		КонецЕсли;  
	КонецЕсли;	
  	//веб-профиль

	//Доступные пользователю профили
	ТаблицаДоступныхПрофилей = ПолучитьТаблицуДоступныхПрофилей(ДанныеПользователя, master, "ЗАЯВКИ", profile, ПредопределенноеЗначение("Справочник.CW_ВебПрофилиЗаявок.ПустаяСсылка"));
	Если profile.Пустая()  Тогда  
		Ответ = CW_РаботаСВнешнимиРесурсамиСервер.Ответ(408);
		Ответ.УстановитьТелоИзСтроки("Не удалось определить профиль");
		Возврат Ответ;
	КонецЕсли;  
	//Доступные пользователю профили
	
	status = XMLЗначение(Тип("Число"), СтруктураJSON.status);     
	
	СтруктураПрофиля 		= profile.ШаблонПрофиля.СтруктураПрофиля.Выгрузить();
	ОписаниеТиповВсеСсылки 	= ОбщегоНазначения.ОписаниеТипаВсеСсылки();
	
	//Описание колонок 
	ВременнаяТаблица = Новый ТаблицаЗначений; 
	ВременнаяТаблица.Колонки.Добавить("id", Новый ОписаниеТипов("Строка")); 
	
	Если profile.ВыгружатьФайлы Тогда
		ВременнаяТаблица.Колонки.Добавить("ЕстьФайлы", Новый ОписаниеТипов("Булево")); 
	КонецЕсли;
	
	columnparameters = Новый Соответствие;
	Для Каждого СтрокаСтруктуры из СтруктураПрофиля Цикл
		
		ИндексСтроки    = СтруктураПрофиля.Индекс(СтрокаСтруктуры); 
	
		ЗаголовокПоля   = Нстр("ru='"+СтрокаСтруктуры.ЗаголовокRU+"'; en='"+СтрокаСтруктуры.ЗаголовокEN+"'", СокрЛП(ДанныеПользователя.Язык));
		
		Формат = "";
		Если СтрокаСтруктуры.ДоступенФормат Тогда
			Формат = Строка(СтрокаСтруктуры.Формат);
		КонецЕсли;  
		
		ОписаниеТипа 	= СтрокаСтруктуры.ХранилищеТипаЗначения.Получить();
		ПустоеЗначение 	= ОписаниеТипа.ПривестиЗначение(Неопределено);
		ЭтоСсылка 		= ОписаниеТиповВсеСсылки.СодержитТип(ТипЗнч(ПустоеЗначение)); 
		Если ЭтоСсылка Тогда
			ОписаниеТипа = Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(255)); 
		КонецЕсли;     

		Если ТипЗнч(ПустоеЗначение) = Тип("Дата")
			И СтрНайти(Формат, "ДП=") = 0 Тогда   
			мФормат = СтрРазделить(Формат, "; ");  
			мФормат.Добавить("ДП=' '");
			
			Формат = СтрСоединить(мФормат, "; ");
		КонецЕсли;         
		
		ОписаниеКолонки = Новый Структура;
		ОписаниеКолонки.Вставить("name", 			XMLСтрока(ЗаголовокПоля));
		ОписаниеКолонки.Вставить("type", 			CW_ОбщийМодульЛичныйКабинетСервер.СериализацияXDTO_JSON(ОписаниеТипа));
		ОписаниеКолонки.Вставить("format", 			XMLСтрока(Формат));
		ОписаниеКолонки.Вставить("userselection", 	XMLСтрока(СтрокаСтруктуры.БыстрыйОтбор));
		ОписаниеКолонки.Вставить("fixed", 			XMLСтрока(СтрокаСтруктуры.Фиксация));
		ОписаниеКолонки.Вставить("fieldorder", 		XMLСтрока(ИндексСтроки));  
		
		columnparameters.Вставить(XMLСтрока(СтрокаСтруктуры.ИмяПоля), ОписаниеКолонки); 
		
		ВременнаяТаблица.Колонки.Добавить(СтрокаСтруктуры.ИмяПоля, ОписаниеТипа, ЗаголовокПоля);
	КонецЦикла;
	//Описание колонок  
	
	//Таблица заявок 
	СкрытьПолеСсылка = Ложь;
	ТаблицаЗаявок	 = CW_ЛичныйКабинетКлиентаСервер.ПолучитьТаблицуЗаявок(profile, profile.ШаблонПрофиля, status, СокрЛП(ДанныеПользователя.Язык), СкрытьПолеСсылка);
	Для Каждого СтрокаТаблицы из ТаблицаЗаявок Цикл
		 НоваяСтрока = ВременнаяТаблица.Добавить(); 
		 ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
		 НоваяСтрока.id = XMLСтрока(СтрокаТаблицы.Ссылка);
	КонецЦикла;
	
	table = CW_ОбщийМодульЛичныйКабинетСервер.СериализацияXDTO_JSON(ВременнаяТаблица);   
  	//Таблица заявок 
	
	//Доступные профили                        
	ДоступныеПрофили = Новый Соответствие;
	Для Каждого СтрокаДоступныхПрофилей из ТаблицаДоступныхПрофилей Цикл   
		
		НаименованиеПрофиля = Нстр("ru='"+СтрокаДоступныхПрофилей.ПредставлениеRU+"'; en='"+СтрокаДоступныхПрофилей.ПредставлениеEN+"'", СокрЛП(ДанныеПользователя.Язык));
		ВыгружатьФайлы 		= СтрокаДоступныхПрофилей.ВыгружатьФайлы и ДанныеПользователя.ВыгружатьФайлы;
		
		ПараметрыПрофиля = новый Структура;
		ПараметрыПрофиля.Вставить("name", 			XMLСтрока(НаименованиеПрофиля));
		ПараметрыПрофиля.Вставить("main", 			XMLСтрока(СтрокаДоступныхПрофилей.Основной));
		ПараметрыПрофиля.Вставить("viewfiles",		XMLСтрока(ВыгружатьФайлы));
		ПараметрыПрофиля.Вставить("viewdocs",		XMLСтрока(Ложь));
		ПараметрыПрофиля.Вставить("attachfiles",	XMLСтрока(СтрокаДоступныхПрофилей.РазрешеноПрикреплятьФайлы));
		
		ПараметрыПрофиля.Вставить("create",			XMLСтрока(СтрокаДоступныхПрофилей.ДоступноСозданиеЗавок));  
		ПараметрыПрофиля.Вставить("hidelink", 		XMLСтрока(СкрытьПолеСсылка));
		
		//Шаблоны заявок        
		МассивШаблонов = Новый Массив;      
		
		ШаблоныПрофиля = master.ШаблоныЗаявок.ВыгрузитьКолонку("Шаблон");
		
		Для Каждого Шаблон из ШаблоныПрофиля Цикл
			
			НаименованиеШаблона = Нстр("ru='"+Шаблон.ПредставлениеRU+"'; en='"+Шаблон.ПредставлениеEN+"'", СокрЛП(ДанныеПользователя.Язык));
			
			ДанныеШаблона = Новый Структура;
			ДанныеШаблона.Вставить("id", XMLСтрока(Шаблон.Ссылка));
			ДанныеШаблона.Вставить("name", XMLСтрока(НаименованиеШаблона));
			
			МассивШаблонов.Добавить(ДанныеШаблона);	
			
		КонецЦикла;   

		ПараметрыПрофиля.Вставить("creationtemplates",	МассивШаблонов);   
		//Шаблроны заявок
	
		//Типы файлов
		ДоступныеТипыФайлов = СтрокаДоступныхПрофилей.ВебПрофиль.ТипыФайлов.Выгрузить().ВыгрузитьКолонку("Тип");	
		МассивТиповФайлов = новый Массив;   
		Если ЗапрашиватьТипФайла Тогда
			ЗаполнитьМассивТиповФайлов(ДоступныеТипыФайлов, МассивТиповФайлов, ДанныеПользователя.Язык);
		КонецЕсли;
		ПараметрыПрофиля.Вставить("filestype", МассивТиповФайлов);   
		//Типы файлов     
		
		ДоступныеПрофили.Вставить(XMLСтрока(СтрокаДоступныхПрофилей.ВебПрофиль), ПараметрыПрофиля);
	КонецЦикла;  
	//Доступные профили      
	
	МаксимальныйРазмер 	= Константы.CW_ЛичныйКабинетОграничениеРазмераФайла.Получить();
	
	СтруктураJSON = Новый Соответствие;    
	СтруктураJSON.Вставить("table", 			table);  
	СтруктураJSON.Вставить("profiles", 			ДоступныеПрофили);
	СтруктураJSON.Вставить("currentprofile", 	XMLСтрока(profile));
	СтруктураJSON.Вставить("columnparameters", 	columnparameters);	
	СтруктураJSON.Вставить("maximumsize", 		XMLСтрока(МаксимальныйРазмер));   
	
	СтрокаJSON = CW_РаботаСВнешнимиРесурсамиСервер.ОбъектВСтрокуJSON(СтруктураJSON);
	
	Ответ = CW_РаботаСВнешнимиРесурсамиСервер.Ответ(200);
	
	Ответ.УстановитьТелоИзСтроки(СтрокаJSON);	
	
	Возврат Ответ;
	
КонецФункции

Функция newrequestget(Запрос)
	
	УстановитьПривилегированныйРежим(Истина);  
	
	СтрокаJSON 		= Запрос.ПолучитьТелоКакСтроку();
	СтруктураJSON 	= CW_РаботаСВнешнимиРесурсамиСервер.СтрокаJSONВОбъект(СтрокаJSON); 
	
	//Пользователь
	Если ПустаяСтрока(СтруктураJSON.username) Тогда  
		Ответ 	  = CW_РаботаСВнешнимиРесурсамиСервер.Ответ(408);
		ТекстТела = НСтр("ru='Ошибка авторизации пользователя'; en='User authorization error'", СтруктураJSON.language);
		Ответ.УстановитьТелоИзСтроки(ТекстТела);
		Возврат Ответ;
	КонецЕсли;	   
	
	ДанныеПользователя = CW_ЛичныйКабинетКлиентаСервер.ПолучитьДанныеПользователя(СтруктураJSON.username);
	Если ДанныеПользователя = Неопределено Тогда
		Ответ 	  = CW_РаботаСВнешнимиРесурсамиСервер.Ответ(408);
		ТекстТела = НСтр("ru='Пользователь %1 не найден'; en='User %1 not found'", СтруктураJSON.language);
		Ответ.УстановитьТелоИзСтроки(ТекстТела);
		Возврат Ответ;
	КонецЕсли;        
	//Пользователь

	//Мастер-профиль
	masterprofileid	= XMLЗначение(Тип("УникальныйИдентификатор"),	СтруктураJSON.masterprofile); 
	master			= Справочники.CW_ВебПрофили.ПолучитьСсылку(masterprofileid);  
 	Если ЗначениеЗаполнено(master) Тогда
		Попытка
			masterПрофильОбъект = master.ПолучитьОбъект();
		Исключение
		КонецПопытки;
		Если masterПрофильОбъект = Неопределено Тогда
			master = ПредопределенноеЗначение("Справочник.CW_ВебПрофили.ПустаяСсылка");   
		КонецЕсли;  
	КонецЕсли;	
	
	Если Не ЗначениеЗаполнено(master) Тогда
		Ответ 	  = CW_РаботаСВнешнимиРесурсамиСервер.Ответ(408);
		ТекстТела = НСтр("ru='Не удалось идентифицировать основной профиль'; en='The main profile could not be identified'", СокрЛП(ДанныеПользователя.Язык));
		Ответ.УстановитьТелоИзСтроки(ТекстТела);
		Возврат Ответ;
	КонецЕсли;
	//Мастер-профиль
	
	//веб-профиль
	profileid	= XMLЗначение(Тип("УникальныйИдентификатор"),	СтруктураJSON.profile);  
	profile 	= Справочники.CW_ВебПрофили.ПолучитьСсылку(profileid);  
	Если ЗначениеЗаполнено(profileid) Тогда
		Попытка
			ПрофильОбъект = profile.ПолучитьОбъект();
		Исключение
		КонецПопытки;
		Если ПрофильОбъект = Неопределено Тогда
			profile = ПредопределенноеЗначение("Справочник.CW_ВебПрофилиЗаявок.ПустаяСсылка");   
		КонецЕсли;  
	КонецЕсли;	
  	//веб-профиль

	//Доступные пользователю профили
	ТаблицаДоступныхПрофилей = ПолучитьТаблицуДоступныхПрофилей(ДанныеПользователя, master, "ЗАЯВКИ", profile, ПредопределенноеЗначение("Справочник.CW_ВебПрофилиЗаявок.ПустаяСсылка"));
	Если profile.Пустая()  Тогда  
		Ответ = CW_РаботаСВнешнимиРесурсамиСервер.Ответ(408);
		Ответ.УстановитьТелоИзСтроки("Не удалось определить профиль");
		Возврат Ответ;
	КонецЕсли;  
	//Доступные пользователю профили
	
	//веб-шаблон
	templateid	= XMLЗначение(Тип("УникальныйИдентификатор"), 	СтруктураJSON.template);  
	template 	= Справочники.CW_ВебШаблоныЗаявок.ПолучитьСсылку(templateid);  
	Если ЗначениеЗаполнено(template) Тогда
		Попытка
			ПрофильОбъект = template.ПолучитьОбъект();
		Исключение
		КонецПопытки;
		Если ПрофильОбъект = Неопределено Тогда
			template = ПредопределенноеЗначение("Справочник.CW_ВебШаблоныЗаявок.ПустаяСсылка");   
		КонецЕсли;  
	КонецЕсли;	

	Если Не ЗначениеЗаполнено(template) Тогда
		Ответ = CW_РаботаСВнешнимиРесурсамиСервер.Ответ(408);
		Ответ.УстановитьТелоИзСтроки("Шаблон заявки не найден!");
		Возврат Ответ;
	Конецесли; 
	
	Если master.ШаблоныЗаявок.Найти(template, "Шаблон") = Неопределено Тогда
		Ответ = CW_РаботаСВнешнимиРесурсамиСервер.Ответ(408);
		Ответ.УстановитьТелоИзСтроки("Выбранный шаблон не соответствует профилю");
		Возврат Ответ;
	КонецЕсли;
	//веб-шаблон 
	
	Если Не ПустаяСтрока(СтруктураJSON.copyreference) Тогда 
		КопируемаяЗаявка = Справочники.CW_Заявки.ПолучитьСсылку(Новый УникальныйИдентификатор(СтруктураJSON.copyreference));
		Попытка
			КопируемаяЗаявкаОбъект = КопируемаяЗаявка.ПолучитьОбъект();
		Исключение
		КонецПопытки;
		Если КопируемаяЗаявкаОбъект = Неопределено Тогда
			КопируемаяЗаявка = Неопределено;   
		КонецЕсли;  
	КонецЕсли;
	
	СтруктураШаблона = Справочники.CW_ВебШаблоныЗаявок.ПолучитьСтруктуруШаблонаЗаявки(template, ДанныеПользователя.Язык, КопируемаяЗаявка);  
	
	МакетJSON = "";
	Если template.ТипМакетаНовойЗаявки = 1 Тогда 
		XMLМакет 	= template.ХранилищеМакета.Получить();
		МакетJSON 	= CW_ОбщийМодульЛичныйКабинетСервер.СериализацияXDTO_JSON(XMLМакет);
	КонецЕсли;       

	СтруктураШаблона.Вставить("mxl", МакетJSON);   

	СтрокаJSON 	= CW_РаботаСВнешнимиРесурсамиСервер.ОбъектВСтрокуJSON(СтруктураШаблона);

	Ответ 		= CW_РаботаСВнешнимиРесурсамиСервер.Ответ(200);
	Ответ.УстановитьТелоИзСтроки(СтрокаJSON);	
	
	Возврат Ответ;  
	
КонецФункции

Функция сreaterequestpost(Запрос)   
	
	УстановитьПривилегированныйРежим(Истина);  
	
	СтрокаJSON 		= Запрос.ПолучитьТелоКакСтроку();
	СтруктураJSON 	= CW_РаботаСВнешнимиРесурсамиСервер.СтрокаJSONВОбъект(СтрокаJSON);   
	
	//Пользователь
	Если ПустаяСтрока(СтруктураJSON.username) Тогда  
		ТекстТела = НСтр("ru='Ошибка авторизации пользователя'; en='User authorization error'", СтруктураJSON.language);
		Ответ = CW_РаботаСВнешнимиРесурсамиСервер.Ответ(408);	 
		Ответ.УстановитьТелоИзСтроки(ТекстТела);
		Возврат Ответ;
	КонецЕсли;	
	
	ДанныеПользователя = CW_ЛичныйКабинетКлиентаСервер.ПолучитьДанныеПользователя(СтруктураJSON.username);
	Если ДанныеПользователя = Неопределено Тогда
		ТекстТела = НСтр("ru='Пользователь %1 не найден'; en='User %1 not found'", СтруктураJSON.language);
		Ответ = CW_РаботаСВнешнимиРесурсамиСервер.Ответ(408);	       
		Ответ.УстановитьТелоИзСтроки(ТекстТела);
		Возврат Ответ;
	КонецЕсли;        
	//--Пользователь 
	
	//Мастер-профиль 
	masterprofileid	= XMLЗначение(Тип("УникальныйИдентификатор"),	СтруктураJSON.masterprofile); 
	master 			= Справочники.CW_ВебПрофили.ПолучитьСсылку(masterprofileid);  
	Если ЗначениеЗаполнено(master) Тогда
		Попытка
			masterПрофильОбъект = master.ПолучитьОбъект();
		Исключение
		КонецПопытки;
		Если masterПрофильОбъект = Неопределено Тогда
			master = ПредопределенноеЗначение("Справочник.CW_ВебПрофили.ПустаяСсылка");   
		КонецЕсли;  
	КонецЕсли;	
	
	Если Не ЗначениеЗаполнено(master) Тогда
		Ответ = CW_РаботаСВнешнимиРесурсамиСервер.Ответ(408);
		ТекстТела = НСтр("ru='Не удалось идентифицировать основной профиль'; en='The main profile could not be identified'", СокрЛП(ДанныеПользователя.Язык));
		Ответ.УстановитьТелоИзСтроки(ТекстТела);
		Возврат Ответ;
	КонецЕсли;
	//--Мастер-профиль 
	
 	//Профиль
	profileid	= XMLЗначение(Тип("УникальныйИдентификатор"),	СтруктураJSON.profile); 
	profile		= Справочники.CW_ВебПрофили.ПолучитьСсылку(profileid);  
	Если ЗначениеЗаполнено(profileid) Тогда
		Попытка
			ПрофильОбъект = profile.ПолучитьОбъект();
		Исключение
		КонецПопытки;
		Если ПрофильОбъект = Неопределено Тогда
			profile = ПредопределенноеЗначение("Справочник.CW_ВебПрофилиЗаявок.ПустаяСсылка");   
		КонецЕсли;  
	КонецЕсли;	
	//--Профиль  
	
	//Доступные пользователю профили 
	ТаблицаДоступныхПрофилей = ПолучитьТаблицуДоступныхПрофилей(ДанныеПользователя, master, "ЗАЯВКИ", profile, ПредопределенноеЗначение("Справочник.CW_ВебПрофилиЗаявок.ПустаяСсылка"));
	Если ТаблицаДоступныхПрофилей.Количество() = 0 Тогда
		Ответ = CW_РаботаСВнешнимиРесурсамиСервер.Ответ(408);
		Ответ.УстановитьТелоИзСтроки("Нет доступных профилей");
		Возврат Ответ;
	КонецЕсли;
	//--Доступные пользователю профили
	
	//веб-шаблон
	templateid	= XMLЗначение(Тип("УникальныйИдентификатор"), 	СтруктураJSON.template);  
	template 	= Справочники.CW_ВебШаблоныЗаявок.ПолучитьСсылку(templateid);  
	Если ЗначениеЗаполнено(template) Тогда
		Попытка
			ПрофильОбъект = template.ПолучитьОбъект();
		Исключение
		КонецПопытки;
		Если ПрофильОбъект = Неопределено Тогда
			template = ПредопределенноеЗначение("Справочник.CW_ВебШаблоныЗаявок.ПустаяСсылка");   
		КонецЕсли;  
	КонецЕсли;	

	Если Не ЗначениеЗаполнено(template) Тогда
		Ответ = CW_РаботаСВнешнимиРесурсамиСервер.Ответ(408);
		Ответ.УстановитьТелоИзСтроки("Шаблон заявки не найден!");
		Возврат Ответ;
	Конецесли; 
	
	Если master.ШаблоныЗаявок.Найти(template, "Шаблон") = Неопределено Тогда
		Ответ = CW_РаботаСВнешнимиРесурсамиСервер.Ответ(408);
		Ответ.УстановитьТелоИзСтроки("Выбранный шаблон не соответствует профилю");
		Возврат Ответ;
	КонецЕсли;
	//веб-шаблон  
	
	СтрокаШаблона	= master.ШаблоныЗаявок.Найти(template,"Шаблон");
	СоставЗаявки 	= template.СоставЗаявки.Выгрузить();

	Соответствие = Новый Соответствие;  
	Соответствие.Вставить("Реквизиты", Новый Соответствие);
	Соответствие.Вставить("Параметры", Новый Соответствие);
	
	ОписаниеТипаВсеСсылки = ОбщегоНазначения.ОписаниеТипаВсеСсылки();
	
	Для Каждого КлючЗначение из СтруктураJSON.requisites Цикл
		НайденнаяСтрока =  СоставЗаявки.Найти(КлючЗначение.Ключ, "ИмяОбластиМакета");
		Если НайденнаяСтрока = Неопределено Тогда
			Продолжить;
		КонецЕсли;    
		
		ОписаниеТипов 		= НайденнаяСтрока.ХранилищеТипаЗначения.Получить();
		ПустоеЗначение 		= ОписаниеТипов.ПривестиЗначение(Неопределено);
		ПриведенноеЗначение = ПривестиЗначениеJSON(КлючЗначение.Значение, ОписаниеТипаВсеСсылки, ТипЗнч(ПустоеЗначение)); 
		
		Если ТипЗнч(НайденнаяСтрока.ПараметрЗаявки) = Тип("Строка") Тогда
			//Реквизит Заявки                                                                    
			Соответствие["Реквизиты"].Вставить(НайденнаяСтрока.ПараметрЗаявки, ПриведенноеЗначение);
		Иначе  
			Соответствие["Параметры"].Вставить(НайденнаяСтрока.ПараметрЗаявки, ПриведенноеЗначение);
		КонецЕсли;
		
	КонецЦикла;  
	
	//Создание заявки
	НоваяЗаявка = Справочники.CW_Заявки.СоздатьЭлемент();  
	НоваяЗаявка.ТипОбращения = template.ТипОбращения;
	НоваяЗаявка.ТипПеревозки = template.ТипПеревозки;
	НоваяЗаявка.МенеджерПродаж = template.МенеджерПродаж;

	Для Каждого КлючЗначение из Соответствие["Реквизиты"] Цикл
		НоваяЗаявка[КлючЗначение.Ключ]= КлючЗначение.Значение;                                           
	КонецЦикла;  
	
	Если Не ЗначениеЗаполнено(НоваяЗаявка.ДатаОбращения) Тогда
		НоваяЗаявка.ДатаОбращения = ТекущаяДата();
	КонецЕсли;        
	
	Если ЗначениеЗаполнено(СтрокаШаблона.Контрагент) Тогда
		НоваяЗаявка.Контрагент = СтрокаШаблона.Контрагент;	
	КонецЕсли;
	
	НоваяЗаявка.ГруппыПараметровЗаявки.Загрузить(НоваяЗаявка.ТипПеревозки.ГруппыПараметровЗаявки.Выгрузить());
	
	// переносим параметры из типа   
	МассивПараметровПоТипу = Новый Массив;
	ТаблицаПараметров = НоваяЗаявка.ТипПеревозки.ПараметрыЗаявки.Выгрузить();
	Для Каждого СтрокаПараметров Из ТаблицаПараметров Цикл
		
		НайденнаяСтрока = НоваяЗаявка.ПараметрыЗаявки.Найти(СтрокаПараметров.Параметр, "Параметр");	
		Если НайденнаяСтрока = Неопределено Тогда
			НоваяСтрока = НоваяЗаявка.ПараметрыЗаявки.Добавить();
			НоваяСтрока.Параметр 				= СтрокаПараметров.Параметр;
			НоваяСтрока.ИдентификаторВладельца 	= СтрокаПараметров.ИдентификаторВладельца;
			
			ЗначениеПараметра =	Соответствие["Параметры"].Получить(СтрокаПараметров.Параметр);
			НоваяСтрока.Значение = ЗначениеПараметра;
			Если СтрокаПараметров.Параметр.ЭтоКонтрольнаяДата Тогда
				НоваяСтрока.ЗначениеПлан = ЗначениеПараметра;	
			КонецЕсли;
           МассивПараметровПоТипу.Добавить(СтрокаПараметров.Параметр);
		КонецЕсли;
	КонецЦикла;   
	
	Для Каждого КлючЗначение из  Соответствие["Параметры"] Цикл
		Если МассивПараметровПоТипу.Найти(КлючЗначение.Ключ) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;   
		
		НоваяСтрока = НоваяЗаявка.ПараметрыЗаявки.Добавить();
		НоваяСтрока.Параметр	= КлючЗначение.Ключ;
		НоваяСтрока.Значение 	= КлючЗначение.Значение;   
		
		Если КлючЗначение.Ключ.ЭтоКонтрольнаяДата Тогда
			НоваяСтрока.ЗначениеПлан = КлючЗначение.Значение;	
		КонецЕсли;
	КонецЦикла;   
	
	НоваяЗаявка.УстановитьНовыйКод();
	НоваяЗаявка.Наименование = "Заявка №"+НоваяЗаявка.Код+" от "+Формат(НоваяЗаявка.ДатаОбращения,"ДФ=dd.MM.yyyy");   
	НоваяЗаявка.Комментарий  = СокрЛП(?(ПустаяСтрока(НоваяЗаявка.Комментарий), "", НоваяЗаявка.Комментарий + Символы.ПС) + "Создано из ЛКК, пользователь "+СтруктураJSON.username+", Дата: "+СокрЛП(ТекущаяДата()));	

	НоваяЗаявка.ОбменДанными.Загрузка = истина;
	НоваяЗаявка.Записать();  
	
	КомментарийФайлов = "Загружено из ЛКК пользователем "+СокрЛП(СтруктураJSON.username);
	
	//Прикрепляем файлы
	Для Каждого ДанныеФайла из СтруктураJSON.files Цикл
		Расширение 		= XMLЗначение(Тип("Строка"), ДанныеФайла.extension);
		ИмяФайла 		= XMLЗначение(Тип("Строка"), ДанныеФайла.name);
		
		Если НЕ ПустаяСтрока(ДанныеФайла.typefile) Тогда
			ТипДокумента 	= XMLЗначение(Тип("СправочникСсылка.CW_ТипыДокументовФайловогоАрхива"), ДанныеФайла.typefile);
		КонецЕсли;
		
		МассивДвоичныхДанных = Новый Массив;
		Для Каждого ЧастьФайла Из ДанныеФайла.parts Цикл
			ДвоичныеДанные = Base64Значение(ЧастьФайла);
			МассивДвоичныхДанных.Добавить(ДвоичныеДанные);
		КонецЦикла;
		
		ПолныеДвоичныеДанные = СоединитьДвоичныеДанные(МассивДвоичныхДанных);   
		
		ПомещенныйФайл = Новый ОписаниеПередаваемогоФайла;
		ПомещенныйФайл.Имя 		= ИмяФайла;
		ПомещенныйФайл.Хранение = ПоместитьВоВременноеХранилище(ПолныеДвоичныеДанные, Новый УникальныйИдентификатор);
		
		ПомещенныеФайлы = Новый Массив;
		ПомещенныеФайлы.Добавить(ПомещенныйФайл);
		
		_УФС.ПрикрепитьФайлы(НоваяЗаявка.Ссылка, ПомещенныеФайлы, ТипДокумента, КомментарийФайлов);
		
	КонецЦикла; 
	//---Прикрепляем файлы

	
	//Запись данных в регистр
	НаборЗаписей = РегистрыСведений.CW_ХарактеристикиЗаявок.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Заявка.Установить(НоваяЗаявка.Ссылка);
	
	//Дополняем данные хранилища значений
	Для Каждого СтрокаПараметров из НоваяЗаявка.ПараметрыЗаявки Цикл
		
		СтрокаНабора = НаборЗаписей.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаНабора, СтрокаПараметров,,"ХранилищеДанных");
		
		СтрокаНабора.Порядок = СтрокаПараметров.НомерСтроки;
		СтрокаНабора.Заявка  = НоваяЗаявка.Ссылка;
	КонецЦикла;
	НаборЗаписей.Записать(Истина);
	//Запись данных в регитр
	
	//Расчет логистического статуса
	МассивСсылок = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(НоваяЗаявка.Ссылка);
	CW_ЛогистическиеСтатусыСервер.РассчитатьЛогистическийСтатус(МассивСсылок);
	//Расчет логистического статуса
	
	Если ЗначениеЗаполнено(СтрокаШаблона.АдресУведомлений) Тогда
		УведомитьОСозданииНовойЗаявки(НоваяЗаявка.Ссылка, СтрокаШаблона.АдресУведомлений, СтрокаШаблона.ШаблонПисьма);
	КонецЕсли;
	
	Возврат CW_РаботаСВнешнимиРесурсамиСервер.Ответ(200);  
	
КонецФункции 
//--Раздел "Заявки"  


//Раздел "Документы"
Функция documentsget(Запрос) 
	
	УстановитьПривилегированныйРежим(Истина);  
	
	СтруктураJSON = CW_РаботаСВнешнимиРесурсамиСервер.ПрочитатьHTTPСервисВОбъект(Запрос);
	
	//Пользователь
	Если ПустаяСтрока(СтруктураJSON.username) Тогда  
		Ответ 	  = CW_РаботаСВнешнимиРесурсамиСервер.Ответ(408);
		ТекстТела = НСтр("ru='Ошибка авторизации пользователя'; en='User authorization error'", СтруктураJSON.language);
		Ответ.УстановитьТелоИзСтроки(ТекстТела);
		Возврат Ответ;
	КонецЕсли;	   
	
	ДанныеПользователя = CW_ЛичныйКабинетКлиентаСервер.ПолучитьДанныеПользователя(СтруктураJSON.username);
	Если ДанныеПользователя = Неопределено Тогда
		Ответ 	  = CW_РаботаСВнешнимиРесурсамиСервер.Ответ(408);
		ТекстТела = НСтр("ru='Пользователь %1 не найден'; en='User %1 not found'", СтруктураJSON.language);
		Ответ.УстановитьТелоИзСтроки(ТекстТела);
		Возврат Ответ;
	КонецЕсли;        
	//--Пользователь

	//Мастер-профиль
	masterprofileid	= XMLЗначение(Тип("УникальныйИдентификатор"),	СтруктураJSON.masterprofile); 
	master			= Справочники.CW_ВебПрофили.ПолучитьСсылку(masterprofileid);  
 	Если ЗначениеЗаполнено(master) Тогда
		Попытка
			masterПрофильОбъект = master.ПолучитьОбъект();
		Исключение
		КонецПопытки;
		Если masterПрофильОбъект = Неопределено Тогда
			master = ПредопределенноеЗначение("Справочник.CW_ВебПрофили.ПустаяСсылка");   
		КонецЕсли;  
	КонецЕсли;	
	
	Если Не ЗначениеЗаполнено(master) Тогда
		Ответ 	  = CW_РаботаСВнешнимиРесурсамиСервер.Ответ(408);
		ТекстТела = НСтр("ru='Не удалось идентифицировать основной профиль'; en='The main profile could not be identified'", СокрЛП(ДанныеПользователя.Язык));
		Ответ.УстановитьТелоИзСтроки(ТекстТела);
		Возврат Ответ;
	КонецЕсли;
	//--Мастер-профиль
	
	startdate 	= XMLЗначение(Тип("Дата"), СтруктураJSON.startdate); 
	enddate		= XMLЗначение(Тип("Дата"), СтруктураJSON.enddate);  
	
	ПараметрыКомплекта 	= CW_ЛичныйКабинетКлиентаСервер.ПолучитьПараметрыКомплекта(master.КомплектПечатныхФорм);
	ВсеДокументы  		= CW_ЛичныйКабинетКлиентаСервер.ПолучитьТаблицуДокументов(master, startdate, enddate, ПараметрыКомплекта); 
	
	СтруктураДокументы = Новый Структура;
	
	Если ПараметрыКомплекта.УказанаПечатнаяФормаСчета Тогда
		ТаблицаСчетов = ПолучитьТаблицуСчетов(ВсеДокументы, ДанныеПользователя.Язык);
		СтруктураДокументы.Вставить("invoce", 	CW_ОбщийМодульЛичныйКабинетСервер.СериализацияXDTO_JSON(ТаблицаСчетов));
	Конецесли;
	Если ПараметрыКомплекта.УказанаПечатнаяФормаРеализации Тогда
		ТаблицаРеализаций = ПолучитьТаблицуРеализаций(ВсеДокументы, ДанныеПользователя.Язык);
		СтруктураДокументы.Вставить("act", 		CW_ОбщийМодульЛичныйКабинетСервер.СериализацияXDTO_JSON(ТаблицаРеализаций));
	Конецесли;
	Если ПараметрыКомплекта.УказанаПечатнаяФормаОтчетаЭкспедитора Тогда
		ТаблицаОтчетЭкспедитора	= ПолучитьТаблицуОтчетЭкспедитора(ВсеДокументы, ДанныеПользователя.Язык);
		СтруктураДокументы.Вставить("report",	CW_ОбщийМодульЛичныйКабинетСервер.СериализацияXDTO_JSON(ТаблицаОтчетЭкспедитора));
	Конецесли;
	
	СтруктураJSON = Новый Структура;
	СтруктураJSON.Вставить("ShowInvoices", 	XMLСтрока(ПараметрыКомплекта.УказанаПечатнаяФормаСчета));
	СтруктураJSON.Вставить("ShowActs", 	 	XMLСтрока(ПараметрыКомплекта.УказанаПечатнаяФормаРеализации));
	СтруктураJSON.Вставить("ShowReports",	XMLСтрока(ПараметрыКомплекта.УказанаПечатнаяФормаОтчетаЭкспедитора)); 
	СтруктураJSON.Вставить("documents",		СтруктураДокументы);

	Ответ 		= CW_РаботаСВнешнимиРесурсамиСервер.Ответ(200);   
	СтрокаJSON  = CW_РаботаСВнешнимиРесурсамиСервер.ОбъектВСтрокуJSON(СтруктураJSON);
	
	Ответ.УстановитьТелоИзСтроки(СтрокаJSON);
	
	Возврат Ответ;
	
КонецФункции 
//--Раздел "Документы"


//Раздел "Отчеты"
Функция checkdebtget(Запрос)  
	
	СтруктураJSON = CW_РаботаСВнешнимиРесурсамиСервер.ПрочитатьHTTPСервисВОбъект(Запрос);
	
	//Пользователь
	Если ПустаяСтрока(СтруктураJSON.username) Тогда  
		Ответ 	  = CW_РаботаСВнешнимиРесурсамиСервер.Ответ(408);
		ТекстТела = НСтр("ru='Ошибка авторизации пользователя'; en='User authorization error'", СтруктураJSON.language);
		Ответ.УстановитьТелоИзСтроки(ТекстТела);
		Возврат Ответ;
	КонецЕсли;	   
	
	ДанныеПользователя = CW_ЛичныйКабинетКлиентаСервер.ПолучитьДанныеПользователя(СтруктураJSON.username);
	Если ДанныеПользователя = Неопределено Тогда
		Ответ 	  = CW_РаботаСВнешнимиРесурсамиСервер.Ответ(408);
		ТекстТела = НСтр("ru='Пользователь %1 не найден'; en='User %1 not found'", СтруктураJSON.language);
		Ответ.УстановитьТелоИзСтроки(ТекстТела);
		Возврат Ответ;
	КонецЕсли;        
	//Пользователь

	//Мастер-профиль
