//Служебные
Функция ПолучитьТаблицуСчетов(Знач ВсеДокументы, Знач Язык)
	
	ТаблицаСчетов = Новый ТаблицаЗначений;
	ТаблицаСчетов.Колонки.Добавить("ИдентификаторДокумента",		новый ОписаниеТипов("УникальныйИдентификатор"));  
	ТаблицаСчетов.Колонки.Добавить("ИдентификаторВидаДокумента",	новый ОписаниеТипов("Строка"));  
	ТаблицаСчетов.Колонки.Добавить("ДанныеКартинки",				новый ОписаниеТипов("Булево"));  
	ТаблицаСчетов.Колонки.Добавить("Гиперссылка",					новый ОписаниеТипов("Строка"));  

	ТаблицаСчетов.Колонки.Добавить("Дата",			новый ОписаниеТипов("Дата"));
	ТаблицаСчетов.Колонки.Добавить("Номер",			новый ОписаниеТипов("Строка"));  
 	ТаблицаСчетов.Колонки.Добавить("Корректировка",	новый ОписаниеТипов("Булево"));  
	ТаблицаСчетов.Колонки.Добавить("Организация",	новый ОписаниеТипов("Строка"));  
	ТаблицаСчетов.Колонки.Добавить("Контрагент",	новый ОписаниеТипов("Строка"));  
	ТаблицаСчетов.Колонки.Добавить("Сумма",			новый ОписаниеТипов("Число"));  
	ТаблицаСчетов.Колонки.Добавить("Валюта",		новый ОписаниеТипов("Строка"));  

	Отбор = Новый Структура;
	Отбор.Вставить("ВидДокумента", ПредопределенноеЗначение("Перечисление.CW_ВидыДокументовКомплекта.Счет")); 
	
	мСтроки = ВсеДокументы.НайтиСтроки(Отбор); 
	Для Каждого СтрокаТаблицы из мСтроки Цикл   
		ПараметрыНомера = Новый Структура;
		ПараметрыНомера.Вставить("Организация", СтрокаТаблицы.Организация);
		ПараметрыНомера.Вставить("Номер", 		СтрокаТаблицы.Документ.НомерСчета);
		ПараметрыНомера.Вставить("Дата", 		СтрокаТаблицы.Документ.ДатаСчета);
		
		НомерДокумента = CW_Документы.ПолучитьНомерНаПечать(ПараметрыНомера);	   
		
		НоваяСтрока = ТаблицаСчетов.Добавить();
		НоваяСтрока.ИдентификаторДокумента 		= СтрокаТаблицы.Документ.УникальныйИдентификатор();
		НоваяСтрока.ИдентификаторВидаДокумента 	= XMLСтрока(СтрокаТаблицы.ВидДокумента); 
		НоваяСтрока.ДанныеКартинки 				= Истина; 
		НоваяСтрока.Гиперссылка 				= Нстр("ru='Скачать'; en='Download'", СокрЛП(Язык)); 
		
		НоваяСтрока.Дата			= СтрокаТаблицы.Документ.ДатаСчета;
		НоваяСтрока.Номер			= НомерДокумента;   
		НоваяСтрока.Корректировка	= СтрокаТаблицы.Документ.Корректировка;
		НоваяСтрока.Организация 	= CW_ПереводыСервер.ПолучитьПеревод(СтрокаТаблицы.Организация,, Язык);
		НоваяСтрока.Контрагент 		= CW_ПереводыСервер.ПолучитьПеревод(СтрокаТаблицы.Контрагент,, Язык);
		НоваяСтрока.Сумма			= СтрокаТаблицы.Сумма; 
		НоваяСтрока.Валюта			= СокрЛП(СтрокаТаблицы.Валюта.Наименование);
	КонецЦикла; 
	
	Возврат ТаблицаСчетов; 
	
КонецФункции

