&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	CW_Документы.УстановитьПараметрыФункциональныхОпцийФормы(Этаформа);
	
	ВалютаРег = Константы.ВалютаРегламентированногоУчета.Получить();
	
	Если Не ЗначениеЗаполнено(Объект.Организация) тогда
		Объект.Организация = CW_Настройки.ОсновнаяОрганизация();
	Конецесли;
	
	Если Не ЗначениеЗаполнено(Объект.Дата) Тогда
		Объект.Дата = ТекущаяДата();
	КонецЕсли;
	
	ПоказатьПодразделение = ложь;
	Если ЗначениеЗаполнено(Объект.Организация) тогда
		ПоказатьПодразделение = CW_Настройки.ПараметрУчетнойПолитики(Объект.Дата, Объект.Организация, "ГруппировкаЗатратПоПодразделениям");
	КонецЕсли;
	
	Элементы.ЗатратыПодразделение.Видимость = ПоказатьПодразделение;
	
	ТекущийДокументОснование = Объект.ДокументОснование;
	
	УстанавиливаемыеПараметры = Новый Структура("CW_ДоговорПоГрузоперевозкам", ТекущийДокументОснование.Договор);
	Элементы.ПриложениеКДоговору.Видимость = ПолучитьФункциональнуюОпцию("CW_УчитыватьПриложенияВДокументах",УстанавиливаемыеПараметры); 
	
	УстановитьВидимостьСпособУчетаНДСНаСервере();
	
	//Наличие прикрепленных файлов
	_УФКС.УстановитьНаличиеПрикрепленныхФайловПриСозданииФормыНаСервере(ЭтаФорма);
	//Наличие прикрепленных файлов

	//Для версии КОРП
	ВестиУчетПоПодразделениям					= ПолучитьФункциональнуюОпцию("ВестиУчетПоПодразделениям");
	Элементы.ПодразделениеОрганизации.Видимость	= ВестиУчетПоПодразделениям;
	//Для версии КОРП
	
	ЗаполнитьДополнительныеКолонки();
	
	Валюта = Константы.ВалютаРегламентированногоУчета.Получить();
	
	//Внешние подклчюаемые команды
	CW_ПодключаемыеКомандыСервер.ПриСозданииНаСервере(ЭтотОбъект);
	//Внешние подклчюаемые команды
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	УстановитьНадписьИтоговойСтроки();
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	СостояниеДокумента = ОбщегоНазначенияБП.СостояниеДокумента(Объект); // ВызовБП
	
	ЗаполнитьДополнительныеКолонки();
	
	//Подсистема.УчетПриложенийДоговоров
	CW_УчетПриложенийДоговоровСервер.УстановитьПризнакУчетаПоПриложениямВТабличнойЧасти(ЭтаФорма, "Затраты", "ДоговорПокупателя");
	//Подсистема.УчетПриложенийДоговоров
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	СостояниеДокумента = ОбщегоНазначенияБП.СостояниеДокумента(Объект); // ВызовБП
	
	ЗаполнитьДополнительныеКолонки();
	
	//Подсистема.УчетПриложенийДоговоров
	CW_УчетПриложенийДоговоровСервер.УстановитьПризнакУчетаПоПриложениямВТабличнойЧасти(ЭтаФорма, "Затраты", "ДоговорПокупателя");
	//Подсистема.УчетПриложенийДоговоров

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДополнительныеКолонки() 

	Для каждого СтрокаДокумента Из Объект.Затраты Цикл
		СтрокаДокумента.Валюта 		= ТекущийДокументОснование.Валюта;
		СтрокаДокумента.ВалютаРег 	= ВалютаРег;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьСпособУчетаНДСНаСервере()
	
	УстанавливаемыеПараметры = Новый Структура;
	УстанавливаемыеПараметры.Вставить("Организация", Объект.Организация);
	
	Элементы.ЗатратыСпособУчетаНДС.Видимость = ПолучитьФункциональнуюОпцию("РаздельныйУчетНДСНаСчете19",УстанавливаемыеПараметры);

КонецПроцедуры

&НаКлиенте
Процедура УстановитьНадписьИтоговойСтроки()
	
	Сумма 	= Объект.Затраты.Итог("Сумма");
	НДС 	= Объект.Затраты.Итог("НДС");
	Всего 	= Объект.Затраты.Итог("Всего");

	Элементы.ИтоговаяСтрока.Заголовок = 	
		"Сумма: "+Формат(Сумма, "ЧДЦ=2; ЧН=0.00")	+ " " + Строка(Валюта)+ "; " +
		"НДС: "+Формат(НДС, 	"ЧДЦ=2; ЧН=0.00")	+ " " + Строка(Валюта)+ "; " +
		"Всего: "+Формат(Всего, "ЧДЦ=2; ЧН=0.00")	+ " " + Строка(Валюта)+ "; ";
	
КонецПроцедуры

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
	УстановитьВидимостьСпособУчетаНДСНаСервере();
КонецПроцедуры

//Команды табличной части
&НаКлиенте
Процедура ЗатратыПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	УстановитьНадписьИтоговойСтроки();
КонецПроцедуры

&НаКлиенте
Процедура ЗатратыПослеУдаления(Элемент)
	УстановитьНадписьИтоговойСтроки();
КонецПроцедуры

&НаКлиенте
Процедура Очистить(Команда)
	
	Если Объект.Затраты.Количество() > 0 Тогда
		Режим = РежимДиалогаВопрос.ДаНет;
		Оповещение = Новый ОписаниеОповещения("ПродолжитьОчисткуТабличнойЧасти", ЭтотОбъект);
		ПоказатьВопрос(Оповещение, "Табличная часть документа будет очищена. Продолжить?", Режим, 0);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПродолжитьОчисткуТабличнойЧасти(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;
	
	Объект.Затраты.Очистить();
	
КонецПроцедуры

&НаКлиенте
Процедура Заполнить(Команда)
	
	Отказ = Ложь;
	Если Не ЗначениеЗаполнено(Объект.ДокументОснование) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заполнен документ реализации!",,"ДокументОснование","Объект", Отказ);
	КонецЕсли;
	
	Если Не Отказ тогда
		
		ДополнительныеПараметры = Новый Структура;
		Оповещение = Новый ОписаниеОповещения("ПродолжитьЗаполнить", ЭтотОбъект, ДополнительныеПараметры);
		
		Если Объект.Затраты.Количество() > 0 Тогда
			СтандартнаяОбработка = Ложь;
			Режим = РежимДиалогаВопрос.ДаНет;
			ПоказатьВопрос(Оповещение, "Табличная часть документа будет очищена. Продолжить?", Режим, 0);
		Иначе
			ВыполнитьОбработкуОповещения(Оповещение, КодВозвратаДиалога.Да);
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПродолжитьЗаполнить(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьТабличнуюЧастьНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТабличнуюЧастьНаСервере()
	
	ТОбъект = РеквизитФормыВЗначение("Объект");
	РезультатЗапроса = ТОбъект.ПолучитьДанныеДляЗаполненияТабличнойЧасти(Объект.ДокументОснование);
	
	Объект.Затраты.Загрузить(РезультатЗапроса.Выгрузить());
	
КонецПроцедуры

&НаСервере
Процедура ДокументОснованиеПриИзмененииНаСервере()
	
	Объект.Затраты.Очистить();
	ТекущийДокументОснование 	= Объект.ДокументОснование;
	
КонецПроцедуры

&НаКлиенте
Процедура ДокументОснованиеПриИзменении(Элемент)
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Элемент", Элемент);
	Оповещение = Новый ОписаниеОповещения("ПродолжитьДокументОснованиеПриИзменении", ЭтотОбъект, ДополнительныеПараметры);
	
	Если Объект.Затраты.Количество() > 0 и ЗначениеЗаполнено(ТекущийДокументОснование) и ТекущийДокументОснование <> Объект.ДокументОснование Тогда
		СтандартнаяОбработка = Ложь;
		Режим = РежимДиалогаВопрос.ДаНет;
		ПоказатьВопрос(Оповещение, "Табличная часть документа будет очищена. Продолжить?", Режим, 0);
	Иначе
		ВыполнитьОбработкуОповещения(Оповещение, КодВозвратаДиалога.Да);
	КонецЕсли;
	
	
КонецПроцедуры

&НаКлиенте
Процедура ПродолжитьДокументОснованиеПриИзменении(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Нет Тогда
		Объект.ДокументОснование =  ТекущийДокументОснование;
		Возврат;
	КонецЕсли;
	
	ДокументОснованиеПриИзмененииНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ДокументОснованиеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Элемент", Элемент);
	Оповещение = Новый ОписаниеОповещения("ПродолжитьИзменениеДокументаоснования", ЭтотОбъект, ДополнительныеПараметры);
	
	Если Объект.Затраты.Количество() > 0 Тогда
		СтандартнаяОбработка = Ложь;
		Режим = РежимДиалогаВопрос.ДаНет;
		ПоказатьВопрос(Оповещение, "Табличная часть документа будет очищена. Продолжить?", Режим, 0);
	Иначе
		ВыполнитьОбработкуОповещения(Оповещение, КодВозвратаДиалога.Да);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПродолжитьИзменениеДокументаоснования(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;
	
	СтруктураОтбора = Новый Структура;
	СтруктураОтбора.Вставить("Организация", 				Объект.Организация);
	СтруктураОтбора.Вставить("ПодразделениеОрганизации", 	Объект.ПодразделениеОрганизации);
	СтруктураОтбора.Вставить("ПредъявленАкт", 				Истина);
	
	ПараметрыФормыВыбора = Новый Структура;
	ПараметрыФормыВыбора.Вставить("РежимВыбора", 		Истина);
	ПараметрыФормыВыбора.Вставить("МножественныйВыбор", Ложь);
	ПараметрыФормыВыбора.Вставить("ЗакрыватьПриВыборе", Истина);
	ПараметрыФормыВыбора.Вставить("Отбор", 				СтруктураОтбора);
	
	ОткрытьФорму("Документ.CW_РасходыПоГрузоперевозке.ФормаВыбора", ПараметрыФормыВыбора, ДополнительныеПараметры.Элемент);

КонецПроцедуры

&НаКлиенте
Процедура ЗатратыНоменклатураПриИзменении(Элемент)
	
	ТекущаяСтрока = Элементы.Затраты.ТекущаяСтрока;   
	ПриИзмененииНоменклатурыНаСервере(ТекущаяСтрока);
	
КонецПроцедуры

&НаСервере
Процедура ПриИзмененииНоменклатурыНаСервере(ТекущаяСтрока)
	
	ТекущиеДанные = Объект.Затраты.НайтиПоИдентификатору(ТекущаяСтрока);
		
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("Дата"					, Объект.Дата);
	СтруктураПараметров.Вставить("Организация"			, Объект.Организация);
	СтруктураПараметров.Вставить("Номенклатура"			, ТекущиеДанные.Номенклатура);
	СтруктураПараметров.Вставить("НоменклатурнаяГруппа"	, ТекущиеДанные.Номенклатура.НоменклатурнаяГруппа);
	
	ТекущиеДанные.СпособУчетаНДС = CW_Финансы.ПолучитьСпособУчетаНДС(СтруктураПараметров);

КонецПроцедуры
