							<AutoMaxWidth>false</AutoMaxWidth>
							<HorizontalStretch>true</HorizontalStretch>
							<Title formatted="true">
								<v8:item>
									<v8:lang>ru</v8:lang>
									<v8:content>&lt;font Arial&gt;&lt;fontsize 9&gt;&lt;b&gt;Состояние поставки&lt;/&gt;&lt;/&gt;&lt;/&gt;&lt;font Arial&gt;&lt;fontsize 9&gt;&lt;b&gt; &lt;/&gt;&lt;/&gt;&lt;/&gt;&lt;font Arial&gt;&lt;fontsize 9&gt;влияет на отражение документа о предстоящей поставке товаров (ДОПП) и суммы обеспечительного платежа (ОП) по нему в разделе 4 декларации по косвенным налогам.&lt;/&gt;&lt;/&gt;</v8:content>
								</v8:item>
							</Title>
							<ContextMenu name="ДекорацияПодсказкаПоСтатусамСостояниеПоставкиКонтекстноеМеню" id="204"/>
