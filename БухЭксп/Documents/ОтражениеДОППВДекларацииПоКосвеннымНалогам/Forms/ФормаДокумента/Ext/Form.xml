						</LabelDecoration>
						<LabelDecoration name="ДекорацияПодсказкаПоСтатусамЗавершена" id="200">
							<AutoMaxWidth>false</AutoMaxWidth>
							<HorizontalStretch>true</HorizontalStretch>
							<Title formatted="true">
								<v8:item>
									<v8:lang>ru</v8:lang>
									<v8:content>&lt;font Arial&gt;&lt;fontsize 9&gt;&lt;b&gt;Завершена&lt;/&gt;&lt;/&gt;&lt;/&gt;&lt;font Arial&gt;&lt;fontsize 9&gt; &lt;/&gt;&lt;/&gt;&lt;font Arial&gt;&lt;fontsize 9&gt;- товар ввезен на территорию РФ и принят к учету (полностью или частично). В декларации ДОПП регистрируется на всю сумму ОП. Если этот статус указывается после статуса "Продолжается", то ДОПП регистрируется на сумму ОП в части оставшихся товаров, принимаемых к учету в этом периоде&lt;/&gt;&lt;/&gt;</v8:content>
								</v8:item>
							</Title>
