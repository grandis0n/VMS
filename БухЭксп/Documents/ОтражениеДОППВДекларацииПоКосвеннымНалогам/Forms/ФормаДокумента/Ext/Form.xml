							<ExtendedTooltip name="ДекорацияПодсказкаПоСтатусамЗавершенаРасширеннаяПодсказка" id="202"/>
						</LabelDecoration>
						<LabelDecoration name="ДекорацияПодсказкаПоСтатусамОжидается" id="197">
							<AutoMaxWidth>false</AutoMaxWidth>
							<HorizontalStretch>true</HorizontalStretch>
							<Title formatted="true">
								<v8:item>
									<v8:lang>ru</v8:lang>
									<v8:content>&lt;font Arial&gt;&lt;fontsize 9&gt;&lt;b&gt;Ожидается&lt;/&gt;&lt;/&gt;&lt;/&gt;&lt;font Arial&gt;&lt;fontsize 9&gt; &lt;/&gt;&lt;/&gt;&lt;font Arial&gt;&lt;fontsize 9&gt;- товар не ввезен на территорию РФ (ожидается ввоз в следующем отчетном периоде). В декларации ДОПП не регистрируется.&lt;/&gt;&lt;/&gt;</v8:content>
								</v8:item>
							</Title>
							<ContextMenu name="ДекорацияПодсказкаПоСтатусамОжидаетсяКонтекстноеМеню" id="198"/>
							<ExtendedTooltip name="ДекорацияПодсказкаПоСтатусамОжидаетсяРасширеннаяПодсказка" id="199"/>
						</LabelDecoration>
						<LabelDecoration name="ДекорацияПодсказкаПоСтатусамОтменена" id="206">
							<AutoMaxWidth>false</AutoMaxWidth>
							<HorizontalStretch>true</HorizontalStretch>
							<Title formatted="true">
								<v8:item>
									<v8:lang>ru</v8:lang>
									<v8:content>&lt;font Arial&gt;&lt;fontsize 9&gt;&lt;b&gt;Отменена&lt;/&gt;&lt;/&gt;&lt;/&gt;&lt;font Arial&gt;&lt;fontsize 9&gt; &lt;/&gt;&lt;/&gt;&lt;font Arial&gt;&lt;fontsize 9&gt;- товар не будет ввозиться на территорию РФ. В декларации ДОПП регистрируется на всю сумму ОП для возможности его возврата.&lt;/&gt;&lt;/&gt;</v8:content>
								</v8:item>
							</Title>
							<ContextMenu name="ДекорацияПодсказкаПоСтатусамОтмененаКонтекстноеМеню" id="207"/>
							<ExtendedTooltip name="ДекорацияПодсказкаПоСтатусамОтмененаРасширеннаяПодсказка" id="208"/>
						</LabelDecoration>
						<LabelDecoration name="ДекорацияПодсказкаПоСтатусамПродолжается" id="194">
							<AutoMaxWidth>false</AutoMaxWidth>
							<HorizontalStretch>true</HorizontalStretch>
							<Title formatted="true">
								<v8:item>
									<v8:lang>ru</v8:lang>
									<v8:content>&lt;font Arial&gt;&lt;fontsize 9&gt;&lt;b&gt;Продолжается&lt;/&gt;&lt;/&gt;&lt;/&gt;&lt;font Arial&gt;&lt;fontsize 9&gt; &lt;/&gt;&lt;/&gt;&lt;font Arial&gt;&lt;fontsize 9&gt;- товар ввезен на территорию РФ, но принят к учету частично (планируется допринятие к учету в следующем отчетном периоде). В декларации ДОПП регистрируется на сумму ОП в части принятых к учету в этом периоде товаров.&lt;/&gt;&lt;/&gt;</v8:content>
								</v8:item>
							</Title>
							<ContextMenu name="ДекорацияПодсказкаПоСтатусамПродолжаетсяКонтекстноеМеню" id="195"/>
