&НаКлиенте
Процедура ОбработатьФлагиПервичныхДокументов(Флаг)
	
	Объект.ФормируетсяАкт 			= Флаг;
	Объект.ФормируетсяСчет 			= Флаг;
	Объект.ФормируетсяСчетФактура 	= Флаг;
	
	ФормируетсяСчетПриИзмененииНаСервере();
	ФормируетсяАктПриИзмененииНаСервере();
	ФормируетсяСчетФактураПриИзмененииНаСервере();
	
	УстановитьДоступностьРеквизитовПакетаДокументов();
	ОбновитьТекстПакетаДокументов();

КонецПроцедуры

&НаСервере
Процедура УстановитьДоступностьРеквизитовПакетаДокументов()
	
	Элементы.НомерСчета.Доступность = Объект.ФормируетсяСчет;
	Элементы.ДатаСчета.Доступность  = Объект.ФормируетсяСчет;
	
	Элементы.СпособЗачетаАванса.Доступность  	= Объект.ФормируетсяСчет;
	Элементы.СрокОплаты.Доступность  			= Объект.ФормируетсяСчет;
	Элементы.ПланОплаты.Доступность  			= Объект.ФормируетсяСчет;
	
	Элементы.НомерАкта.Доступность = Объект.ФормируетсяАкт;
	Элементы.ДатаАкта.Доступность  = Объект.ФормируетсяАкт;
	Элементы.ЭтоУниверсальныйДокумент.Доступность  = Объект.ФормируетсяАкт;
	
	Элементы.НомерСчетаФактуры.Доступность = Объект.ФормируетсяСчетФактура;
	Элементы.ДатаСчетаФактуры.Доступность  = Объект.ФормируетсяСчетФактура;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьТекстПакетаДокументов()
	
	ЭтоУПД = Объект.ФормируетсяАкт и Объект.ЭтоУниверсальныйДокумент;
	
	Элементы.НадписьУПД.Видимость 			= ЭтоУПД;
	Элементы.НадписьСчетФактура.Видимость 	= НЕ ЭтоУПД;
	Элементы.НадписьАкт.Видимость 			= НЕ ЭтоУПД;
	
	
	Если Объект.ФормируетсяСчет Тогда
		
		Если ЗначениеЗаполнено(Объект.НомерСчета) Тогда
			ПредставлениеНомераСчета = CW_Документы.ПолучитьНомерНаПечать(Новый Структура("Организация, Номер, Дата", Объект.Организация, Объект.НомерСчета, Объект.ДатаСчета));	 
		Иначе
			ПредставлениеНомераСчета = "<...>";	
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Объект.ДатаСчета) Тогда
			ПредставлениеДатыСчета	= Формат(Объект.ДатаСчета, "ДФ=dd.MM.yyyy");
		Иначе
			ПредставлениеДатыСчета 	= "<...>";	
		КонецЕсли;
		
		//План оплаты
		ПредставлениеСрокаОплаты = "";
		ДанныеПланаОплаты = CW_Документы.ПолучитьПланОплаты(Объект.Ссылка);
		Если Не ЗначениеЗаполнено(ДанныеПланаОплаты.Дата) и НЕ ПустаяСтрока(ДанныеПланаОплаты.Примечание) Тогда
			ПредставлениеСрокаОплаты = ", План оплаты: <...>";
		ИначеЕсли ЗначениеЗаполнено(ДанныеПланаОплаты.Дата) Тогда
			ПредставлениеСрокаОплаты = ", План оплаты: "+Формат(ДанныеПланаОплаты.Дата,"ДФ=dd.MM.yyyy");
		КонецЕсли;
		
		Если Не ПустаяСтрока(ДанныеПланаОплаты.Примечание) Тогда
			ПредставлениеСрокаОплаты = ПредставлениеСрокаОплаты + " ("+СокрЛП(ДанныеПланаОплаты.Примечание)+")";
		КонецЕсли; 
		//План оплаты
		
		Элементы.НадписьСчет.Заголовок = "Счёт №"+ ПредставлениеНомераСчета+ " от " + ПредставлениеДатыСчета + ПредставлениеСрокаОплаты;
		
	Иначе
		Элементы.НадписьСчет.Заголовок = "<Счёт не предоставлен>"; 
	КонецЕсли;
	
	
	Если Не ЭтоУПД Тогда
		Если Объект.ФормируетсяАкт Тогда 
			Если ЗначениеЗаполнено(Объект.НомерАкта) Тогда
				ПредставлениеНомераАкта = CW_Документы.ПолучитьНомерНаПечать(Новый Структура("Организация, Номер, Дата", Объект.Организация, Объект.НомерАкта, Объект.ДатаАкта));	 
			Иначе
				ПредставлениеНомераАкта = "<...>";	
			КонецЕсли;
			
			Если ЗначениеЗаполнено(Объект.ДатаАкта) Тогда
				ПредставлениеДатыАкта  = Формат(Объект.ДатаАкта, "ДФ=dd.MM.yyyy");
			Иначе
				ПредставлениеДатыАкта = "<...>";	
			КонецЕсли;
			
			Элементы.НадписьАкт.Заголовок = "Акт №" + ПредставлениеНомераАкта + " от " + ПредставлениеДатыАкта;

		Иначе
			Элементы.НадписьАкт.Заголовок = "<Акт не предоставлен>"; 
		КонецЕсли;
		
		Если Объект.ФормируетсяСчетФактура Тогда 
			Если ЗначениеЗаполнено(Объект.НомерСчетаФактуры) Тогда
				ПредставлениеНомераСчетФактура = CW_Документы.ПолучитьНомерНаПечать(Новый Структура("Организация, Номер, Дата", Объект.Организация, Объект.НомерСчетаФактуры, Объект.ДатаСчетаФактуры));	 
			Иначе
				ПредставлениеНомераСчетФактура = "<...>";	
			КонецЕсли;
			
			Если ЗначениеЗаполнено(Объект.ДатаСчетаФактуры) Тогда
				ПредставлениеДатыСчетФактура 	 = Формат(Объект.ДатаСчетаФактуры, "ДФ=dd.MM.yyyy");
			Иначе
				ПредставлениеДатыСчетФактура = "<...>";	
			КонецЕсли;    
			
			Элементы.НадписьСчетФактура.Заголовок  = "С/ф №" + ПредставлениеНомераСчетФактура + " от " + ПредставлениеДатыСчетФактура;
		Иначе
			Элементы.НадписьСчетФактура.Заголовок = "<С/Ф не предоставлен>"; 
		КонецЕсли;
	КонецЕсли; 
	
	Если ЭтоУПД Тогда   
		
		ВидУПД = "УПД";
		
		Если Объект.ФормируетсяСчетФактура Тогда  
			СтатусУПД 				= "(1)";
			ПредставлениеНомераУПД	= CW_Документы.ПолучитьНомерНаПечать(Новый Структура("Организация, Номер, Дата", Объект.Организация, Объект.НомерСчетаФактуры, Объект.ДатаСчетаФактуры));
			ПредставлениеНомераУПД	= " №"+ ?(ПустаяСтрока(ПредставлениеНомераУПД), "<...>", 	ПредставлениеНомераУПД);
			ПредставлениеДатыУПД 	= ?(Объект.ДатаСчетаФактуры = Дата(1,1,1),				  "<...>",	Формат(Объект.ДатаСчетаФактуры,"ДФ=dd.MM.yyyy"));
		Иначе
			СтатусУПД 				= "(2)";
			ПредставлениеНомераУПД	= CW_Документы.ПолучитьНомерНаПечать(Новый Структура("Организация, Номер, Дата", Объект.Организация, Объект.НомерАкта, Объект.ДатаАкта));
			ПредставлениеНомераУПД	= " №"+ ?(ПустаяСтрока(ПредставлениеНомераУПД), "<...>", 	ПредставлениеНомераУПД);
			ПредставлениеДатыУПД 	= ?(Объект.ДатаАкта = Дата(1,1,1),				"<...>",Формат(Объект.ДатаАкта,"ДФ=dd.MM.yyyy"));
		КонецЕсли;  
		
		ПредставлениеУПД = ВидУПД + СтатусУПД + ПредставлениеНомераУПД + " от "+ ПредставлениеДатыУПД;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаУстановитьСрокОплаты(Команда)   
	Если Объект.Ссылка.Пустая() Тогда
		ПоказатьПредупреждение(,"Документ не записан!");
		Возврат;
	КонецЕсли;
	
	КомандаУстановитьСрокОплатыНаСервере();
КонецПроцедуры

&НаСервере
Процедура КомандаУстановитьСрокОплатыНаСервере()
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("Ссылка"		, Объект.Ссылка);
	СтруктураПараметров.Вставить("Договор"		, Объект.Договор);
	
	//Подсистема.УчетПриложенийДоговоров
	Если ЗначениеЗаполнено( Объект.ПриложениеКДоговору) Тогда
		СтруктураПараметров.Вставить("Договор"		, Объект.ПриложениеКДоговору);
	КонецЕсли;
	//Подсистема.УчетПриложенийДоговоров
	
	СтруктураПараметров.Вставить("Дата"			, Объект.Дата);
	СтруктураПараметров.Вставить("ДатаСчета"	, Объект.ДатаСчета);
	СтруктураПараметров.Вставить("ЕстьСчет"		, Объект.ФормируетсяСчет);
	СтруктураПараметров.Вставить("ЕстьАкт"		, Объект.ФормируетсяАкт);
	
	СрокОплаты = CW_Документы.РассчитатьСрокОплаты(СтруктураПараметров);
	
	УстановитьОписаниеСрокаОплаты();
	
	
КонецПроцедуры

&НаКлиенте
Процедура НомерСчетаПриИзменении(Элемент)
	
	// если очистили номер документа, то очистим дату счета
	Если Не ЗначениеЗаполнено(Объект.НомерСчета) Тогда
		Объект.ДатаСчета = Дата(1,1,1);
	Иначе // значение номера не пустое
		// дата счета по умолчанию ставим дате документа
		Если Объект.ДатаСчета = Дата(1,1,1) Тогда
			Объект.ДатаСчета = Объект.Дата;
		КонецЕсли;
	КонецЕсли;
	
	ОбновитьТекстПакетаДокументов();

КонецПроцедуры

&НаКлиенте
Процедура НомерАктаПриИзменении(Элемент)
	
// значение номера пустое	
	Если Не ЗначениеЗаполнено(Объект.НомерАкта) Тогда
		Объект.ДатаАкта = Дата(1,1,1);
	Иначе  // значение номера не пустое
		
		// Если заполнили номер документа, а дата пустая, 
		// то установим ее равной дате документа
		// значение номера не пустое
		Если Объект.ДатаАкта = Дата(1,1,1) Тогда
			Объект.ДатаАкта = Объект.Дата;			
		КонецЕсли;
	КонецЕсли;
	
	ОбновитьТекстПакетаДокументов();
	
КонецПроцедуры

&НаКлиенте
Процедура НомерСчетФактурыПриИзменении(Элемент)
	
	// если очистили номер документа, то очистим дату с/ф, 
	// т.к. в этом случае дата с/ф будет принудительно сформирована на основании даты акта
	Если Не ЗначениеЗаполнено(Объект.НомерСчетаФактуры) Тогда
		Объект.ДатаСчетаФактуры = Дата(1,1,1);
	Иначе 	// номер заполнили 
		
		// дата с/ф должна совпадать с датой акта или датой документа (в случае отсутствия акта)
		Если Объект.ДатаСчетаФактуры = Дата(1,1,1) Тогда
			Если Объект.ДатаАкта = Дата(1,1,1) Тогда
				Объект.ДатаСчетаФактуры = Объект.Дата;
			Иначе
				Объект.ДатаСчетаФактуры = Объект.ДатаАкта;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	ОбновитьТекстПакетаДокументов();

КонецПроцедуры

&НаКлиенте
Процедура ДатаСчетаПриИзменении(Элемент)
	
	// если очистили дату с/ф, то принудительно очистим номер документа
	Если Объект.ДатаСчета = Дата(1,1,1) Тогда
		Объект.НомерСчета = "";
	КонецЕсли;
	
	ОбновитьТекстПакетаДокументов();

КонецПроцедуры

&НаКлиенте
Процедура ДатаАктаПриИзменении(Элемент)
	
	// если очистили дату акта, то принудительно очистим номер документа,
	Если Объект.ДатаАкта = Дата(1,1,1) Тогда
		Объект.НомерАкта = "";
	КонецЕсли;
	
	ОбновитьТекстПакетаДокументов();

КонецПроцедуры

&НаКлиенте
Процедура ДатаСчетаФактурыПриИзменении(Элемент)

	// если очистили дату с/ф, то принудительно очистим номер документа
	Если Объект.ДатаСчетаФактуры = Дата(1,1,1) Тогда
		Объект.НомерСчетаФактуры = "";
		Возврат;
	КонецЕсли;
	
	ОбновитьТекстПакетаДокументов();

КонецПроцедуры

&НаСервереБезКонтекста
Функция ИспользуетсяПакетнаяНумерацияНаСервере(Дата, Организация)
	
	ПорядокПрисвоенияНомеров = CW_Настройки.ПараметрУчетнойПолитики(Дата, Организация,"ПорядокПрисвоенияНомеров");
	
	Возврат ПорядокПрисвоенияНомеров = ПредопределенноеЗначение("Перечисление.CW_ПорядокПрисвоенияИсходящихНомеров.ВПределахДаты") ИЛИ
			ПорядокПрисвоенияНомеров = ПредопределенноеЗначение("Перечисление.CW_ПорядокПрисвоенияИсходящихНомеров.СплошнаяНумерация"); 
	
КонецФункции

&НаКлиенте
Процедура ПервичныеДокументыВремяСчета(Команда)
	
	Если не ЗначениеЗаполнено(Объект.ДатаСчета) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не указана дата счета!",,"ДатаСчета", "Объект");
		Возврат;
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("НачальнаяДата",	Объект.ДатаСчета);
	ДополнительныеПараметры.Вставить("ИмяРеквизита", 	"ДатаСчета");
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ОбработкаИзмененияВремени",ЭтотОбъект, ДополнительныеПараметры); 
	
	ПоказатьВводДаты(ОписаниеОповещения,Объект.ДатаСчета,"Время счёта",ЧастиДаты.Время);
	
КонецПроцедуры

&НаКлиенте
Процедура ПервичныеДокументыВремяАкта(Команда)
	
	Если не ЗначениеЗаполнено(Объект.ДатаАкта) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не указана дата акта!",,"ДатаАкта", "Объект");
		Возврат;
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("НачальнаяДата",	Объект.ДатаАкта);
	ДополнительныеПараметры.Вставить("ИмяРеквизита", 	"ДатаАкта");
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ОбработкаИзмененияВремени",ЭтотОбъект, ДополнительныеПараметры); 
	
	ПоказатьВводДаты(ОписаниеОповещения,Объект.ДатаАкта,"Время акта",ЧастиДаты.Время);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаИзмененияВремени(ВведенноеЗначение, ДополнительныеПараметры) Экспорт 
	
	Если ВведенноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ДатаСтрокой	 = Формат(Объект[ДополнительныеПараметры.ИмяРеквизита],"ДФ=yyyyMMdd");
	ВремяСтрокой = Формат(ВведенноеЗначение,"ДФ=HHmmss");

	Объект[ДополнительныеПараметры.ИмяРеквизита] = Дата(ДатаСтрокой+ВремяСтрокой);
	
КонецПроцедуры
//Форма пакета документов

//Табличная часть Услуги
&НаКлиенте
Процедура УслугиОчистить(Команда)
	
	Если Объект.Услуги.Количество() > 0 Тогда
		Режим = РежимДиалогаВопрос.ДаНет;
		Оповещение = Новый ОписаниеОповещения("ПродолжитьОчисткуТабличнойЧасти", ЭтотОбъект, Параметры);
		ПоказатьВопрос(Оповещение, "Табличная часть будет очищена. Продолжить?", Режим, 0);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПродолжитьОчисткуТабличнойЧасти(Результат, Параметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Нет Тогда
        Возврат;
    КонецЕсли;

    Объект.Услуги.Очистить();

КонецПроцедуры

&НаКлиенте
Процедура ПодборНоменклатуры(Команда)
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("РежимВыбора", 			Истина);
	ПараметрыФормы.Вставить("МножественныйВыбор", 	Истина);
	ПараметрыФормы.Вставить("закрыватьПриВыборе", 	Истина);

	ОткрытьФорму("Справочник.Номенклатура.ФормаВыбора", ПараметрыФормы, ЭтаФорма,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	Если ИсточникВыбора.ИмяФормы = "Справочник.Номенклатура.Форма.ФормаВыбора" Тогда
		
		Для Каждого ВыбраннаяНоменклатура из ВыбранноеЗначение Цикл
			
			Отбор = Новый Структура;
			Отбор.Вставить("Номенклатура", ВыбраннаяНоменклатура);
			мСтроки = Объект.Услуги.НайтиСтроки(Отбор);
			
			Если мСтроки.Количество() > 0 Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Номенклатура "+Строка(ВыбраннаяНоменклатура) + " уже есть в списке");
				Продолжить;
			КонецЕсли;
			
			НоваяСтрока = Объект.Услуги.Добавить();
			НоваяСтрока.Номенклатура = ВыбраннаяНоменклатура;
			
			ЗаполнитьДанныеСтрокиНаСервере(НоваяСтрока.ПолучитьИдентификатор());
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УслугиНоменклатураПриИзменении(Элемент)
	
	ТекущаяСтрока = Элементы.Услуги.ТекущаяСтрока;
	ЗаполнитьДанныеСтрокиНаСервере(ТекущаяСтрока);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДанныеСтрокиНаСервере(ИдентифкаторСтроки)
	
	СтрокаТекущая = Объект.Услуги.НайтиПоИдентификатору(ИдентифкаторСтроки);
	
	Если ЗначениеЗаполнено(СтрокаТекущая.Номенклатура) Тогда 
		
		СтрокаТекущая.ПредставлениеНоменклатуры = СтрокаТекущая.Номенклатура.НаименованиеПолное;
		
		// пересчет суммовых показателей осуществляем, только при изменении ставки НДС
		СтавкаНДСНоменклаутры =  CW_БухгалтерияЭкспедитораСерверПереопределяемый.СтавкаНДС(СтрокаТекущая.Номенклатура, Объект.Дата);
		Если СтрокаТекущая.СтавкаНДС <> СтавкаНДСНоменклаутры Тогда
			СтрокаТекущая.СтавкаНДС = СтавкаНДСНоменклаутры;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

#Область МСФО

&НаКлиенте
Процедура УслугиСчетРеализацииПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.Услуги.ТекущиеДанные;
	
	Для Сч = 1 По 3 Цикл
		ТекущиеДанные["Субконто"+ Сч] = Неопределено;
	КонецЦикла;
	
	CW_БухгалтерскийУчетКлиентСерверМСФО.УстановитьСвойстваСубконтоСтрокиПриИзмененииСчета(
		ЭтотОбъект, ТекущиеДанные, ПараметрыУстановкиСвойствСубконто(ЭтотОбъект));
	
	ПараметрыОбъекта = Неопределено;
	ЗаполнитьПараметрыОбъектаДляЗаполненияДобавленныхКолонок(ЭтаФорма, ПараметрыОбъекта);
	
	ЗаполнитьДобавленныеКолонкиСтрокиТаблицыУслуги(ТекущиеДанные, ПараметрыОбъекта);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьПараметрыОбъектаДляЗаполненияДобавленныхКолонок(Знач Форма, ПараметрыОбъекта)

	Объект = Форма.Объект;
	
	Если ТипЗнч(ПараметрыОбъекта) <> Тип("Структура") Тогда
		ПараметрыОбъекта = Новый Структура;
	КонецЕсли;
	
	ПараметрыОбъекта.Вставить("СуммаВключаетНДС", Ложь);
	
КонецПроцедуры


&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьДобавленныеКолонкиСтрокиТаблицыУслуги(СтрокаТаблицы, Знач ПараметрыОбъекта)
	
	УчетПоПодразделениям = Неопределено;
	Если СтрокаТаблицы.Свойство("СчетЗатрат") Тогда
		
		СвойстваСчетаБУ = CW_БухгалтерскийУчетВызовСервераПовтИспМСФО.ПолучитьСвойстваСчета(СтрокаТаблицы.СчетЗатрат);
		
		УчетПоПодразделениям = СвойстваСчетаБУ.УчетПоПодразделениям;
		
	КонецЕсли;
	
	Если УчетПоПодразделениям <> Неопределено Тогда
		СтрокаТаблицы.ПодразделениеДоступность = УчетПоПодразделениям;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДобавленныеКолонкиТаблиц(ИмяТабличнойЧасти)
	
	
	ПараметрыОбъекта = Неопределено;
	ЗаполнитьПараметрыОбъектаДляЗаполненияДобавленныхКолонок(ЭтаФорма, ПараметрыОбъекта);
	
	Если ПустаяСтрока(ИмяТабличнойЧасти) ИЛИ ИмяТабличнойЧасти = "Услуги" Тогда
		
		Для Каждого СтрокаТаблицы Из Объект.Услуги Цикл
			ЗаполнитьДобавленныеКолонкиСтрокиТаблицыУслуги(СтрокаТаблицы, ПараметрыОбъекта);
		КонецЦикла;
		
		CW_БухгалтерскийУчетКлиентСерверМСФО.УстановитьНачальныеСвойстваСубконтоТаблицы(
		Объект.Услуги, ПараметрыУстановкиСвойствСубконто(ЭтотОбъект));
		
	КонецЕсли;
	
	
КонецПроцедуры


&НаКлиентеНаСервереБезКонтекста
Функция ПараметрыУстановкиСвойствСубконто(Форма)

	Результат = CW_БухгалтерскийУчетКлиентСерверМСФО.ПараметрыУстановкиСвойствСубконтоПоШаблону(
		"УслугиСубконто", "УслугиПодразделение", "Субконто", "ПодразделениеОрганизации", "СчетРеализации");
		
	Результат.ПоляОбъекта.Вставить("ПодразделениеДоступность", "ПодразделениеДоступность");
	
	Результат.ЗначенияПоУмолчанию.Вставить(
		ПредопределенноеЗначение("ПланВидовХарактеристик.CW_ВидыСубконтоМСФО.СтатьиЗатрат"),
		ОбщегоНазначенияКлиентСервер.ПредопределенныйЭлемент("Справочник.СтатьиЗатрат.ПрочиеЗатраты"));
	Результат.ЗначенияПоУмолчанию.Вставить(
		ПредопределенноеЗначение("ПланВидовХарактеристик.CW_ВидыСубконтоМСФО.ПрочиеДоходыИРасходы"),
		ОбщегоНазначенияКлиентСервер.ПредопределенныйЭлемент("Справочник.ПрочиеДоходыИРасходы.ПрочиеВнереализационныеДоходыРасходы"));
	
	Результат.ДопРеквизиты.Вставить("Организация", Форма.Объект.Организация);
	Результат.СкрыватьСубконто = Ложь;
	
	Возврат Результат;

КонецФункции

&НаСервере
Процедура УстановитьУсловноеОформление()

	// Субконто БУ и НУ
	// Первое субконто не скрываем, чтобы не мигала колонка в разных строках.
	
	Для Сч = 1 По 3 Цикл
		
		ЭлементУО = УсловноеОформление.Элементы.Добавить();
		КомпоновкаДанныхКлиентСервер.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "УслугиСубконто" + Сч);
		
		ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.Услуги.Субконто" + Сч + "Доступность", ВидСравненияКомпоновкиДанных.Равно, Ложь);
		
		ЭлементУО.Оформление.УстановитьЗначениеПараметра("Видимость", Ложь);
		
	КонецЦикла;
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	КомпоновкаДанныхКлиентСервер.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "УслугиПодразделениеОрганизации");
	
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
	"Объект.Услуги.ПодразделениеДоступность", ВидСравненияКомпоновкиДанных.Равно, Ложь);
	
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Видимость", Ложь);
	
	// Субконто БУ
	// Первое субконто не скрываем, чтобы не мигала колонка в разных строках.
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	КомпоновкаДанныхКлиентСервер.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "УслугиСубконто1");
	
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
	"Объект.Услуги.Субконто1Доступность", ВидСравненияКомпоновкиДанных.Равно, Ложь);
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
	"Объект.Услуги.Субконто2Доступность", ВидСравненияКомпоновкиДанных.Равно, Ложь);
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
	"Объект.Услуги.Субконто3Доступность", ВидСравненияКомпоновкиДанных.Равно, Ложь);
	
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Видимость", Истина);
	
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ТекстЗапрещеннойЯчейкиЦвет);
	
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ОтметкаНезаполненного", Ложь);
	
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru = '<не требуется>'"));
	
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
		
КонецПроцедуры


