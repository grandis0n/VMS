&НаСервере
Процедура ПриИзмененииКоличествоЦена(ИдентификаторСтроки, ЗначениеПустогоКоличества = 0)
	
	СтрокаТабличнойЧасти = Объект.Услуги.НайтиПоИдентификатору(ИдентификаторСтроки);
	
	СтрокаТабличнойЧасти.Сумма = СтрокаТабличнойЧасти.Цена * ?(СтрокаТабличнойЧасти.Количество = 0, ЗначениеПустогоКоличества, СтрокаТабличнойЧасти.Количество);
	
	СтавкаНДС= CW_Финансы.ПолучитьСтавкуНДС(СтрокаТабличнойЧасти.СтавкаНДС);
	
	СтрокаТабличнойЧасти.СуммаНДС 	= CW_Финансы.РассчитатьСуммуНДС(СтрокаТабличнойЧасти.Сумма, Истина, Ложь, СтавкаНДС);
	
	СтрокаТабличнойЧасти.Всего 		= СтрокаТабличнойЧасти.Сумма + СтрокаТабличнойЧасти.СуммаНДС;
	
КонецПроцедуры

&НаСервере
Процедура ПриИзмененииСумма(ИдентификаторСтроки)
	
	СтрокаТабличнойЧасти = Объект.Услуги.НайтиПоИдентификатору(ИдентификаторСтроки);
	
	СтрокаТабличнойЧасти.Цена = ?(СтрокаТабличнойЧасти.Количество = 0, 0, СтрокаТабличнойЧасти.Сумма / СтрокаТабличнойЧасти.Количество);
	
	СтавкаНДС	= CW_Финансы.ПолучитьСтавкуНДС(СтрокаТабличнойЧасти.СтавкаНДС);
	
	СтрокаТабличнойЧасти.СуммаНДС 	= CW_Финансы.РассчитатьСуммуНДС(СтрокаТабличнойЧасти.Сумма, Истина, Ложь, СтавкаНДС);
	
	СтрокаТабличнойЧасти.Всего 		= СтрокаТабличнойЧасти.Сумма + СтрокаТабличнойЧасти.СуммаНДС;

КонецПроцедуры

&НаСервере
Процедура ПриИзмененииСуммаНДС(ИдентификаторСтроки)
	
	СтрокаТабличнойЧасти = Объект.Услуги.НайтиПоИдентификатору(ИдентификаторСтроки);
	
	ОбратныйПересчетВДокументах  = CW_Настройки.ПолучитьНастройкуПользователя(,"ОбратныйПересчетВДокументах");
	
	Если ОбратныйПересчетВДокументах Тогда
		СтрокаТабличнойЧасти.Сумма = СтрокаТабличнойЧасти.Всего - СтрокаТабличнойЧасти.СуммаНДС;
		СтрокаТабличнойЧасти.Цена = ?(СтрокаТабличнойЧасти.Количество = 0, 0, СтрокаТабличнойЧасти.Сумма / СтрокаТабличнойЧасти.Количество);
	Иначе
		СтрокаТабличнойЧасти.Всего = СтрокаТабличнойЧасти.Сумма + СтрокаТабличнойЧасти.СуммаНДС;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ПриИзмененииСтавкаНДС(ИдентификаторСтроки)
	
	СтрокаТабличнойЧасти = Объект.Услуги.НайтиПоИдентификатору(ИдентификаторСтроки);
	
	СтавкаНДС	= CW_Финансы.ПолучитьСтавкуНДС(СтрокаТабличнойЧасти.СтавкаНДС);
	
	СтрокаТабличнойЧасти.СуммаНДС 	= CW_Финансы.РассчитатьСуммуНДС(СтрокаТабличнойЧасти.Сумма, Истина, Ложь, СтавкаНДС);
	
	СтрокаТабличнойЧасти.Всего 		= СтрокаТабличнойЧасти.Сумма + СтрокаТабличнойЧасти.СуммаНДС;

КонецПроцедуры

&НаСервере
Процедура ПриИзмененииВсего(ИдентификаторСтроки)
	
	СтрокаТабличнойЧасти = Объект.Услуги.НайтиПоИдентификатору(ИдентификаторСтроки);
	
	СтавкаНДС = CW_Финансы.ПолучитьСтавкуНДС(СтрокаТабличнойЧасти.СтавкаНДС)/100;
	
	СтрокаТабличнойЧасти.СуммаНДС 	= СтрокаТабличнойЧасти.Всего * СтавкаНДС / (1 + СтавкаНДС);
	СтрокаТабличнойЧасти.Сумма 		= СтрокаТабличнойЧасти.Всего - СтрокаТабличнойЧасти.СуммаНДС;
	СтрокаТабличнойЧасти.Цена 		= ?(СтрокаТабличнойЧасти.Количество = 0, 0, СтрокаТабличнойЧасти.Сумма / СтрокаТабличнойЧасти.Количество);

КонецПроцедуры
