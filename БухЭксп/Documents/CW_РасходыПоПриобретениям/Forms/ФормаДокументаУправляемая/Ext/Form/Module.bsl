Процедура НомерСчетаОчистка(Элемент, СтандартнаяОбработка)
	
	НомерСчетаПриИзмененииНаКлиенте();

КонецПроцедуры

&НаКлиенте
Процедура НомерСчетаПриИзмененииНаКлиенте()
	
	Если ЗначениеЗаполнено(Объект.НомерСчета) Тогда
		Если Не ЗначениеЗаполнено(Объект.ДатаСчета) Тогда
			Объект.ДатаСчета = Объект.ДатаСчета;
			УстановитьСрокОплатыНаСервере();
		КонецЕсли;
	Иначе
		Объект.ДатаСчета = Дата(1,1,1);
	КонецЕсли;
	
	_ОбновитьНомераДокументов();
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаСчетаПриИзменении(Элемент)
	
