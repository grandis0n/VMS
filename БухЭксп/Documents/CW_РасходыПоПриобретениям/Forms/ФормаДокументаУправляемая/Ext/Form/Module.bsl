&НаКлиенте
Процедура ПредъявленСчетПриИзменении(Элемент)
	
	ПредъявленСчетПриИзмененииНаКлиенте();
	
	ПервичныеДокументыУправлениеЭлементамиФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура ПредъявленСчетПриИзмененииНаКлиенте()
	
	Если Объект.ПредъявленСчет Тогда
		Если Объект.ДатаСчета = Дата(1,1,1) Тогда
			Объект.ДатаСчета = Объект.Дата;
			УстановитьСрокОплатыНаСервере();
		КонецЕсли;
	Иначе
		Объект.ДатаСчета  = Дата(1,1,1);
		Объект.НомерСчета = "";
		
		Объект.СпособЗачетаАвансовОЗ = ПредопределенноеЗначение("Перечисление.СпособыЗачетаАвансов.НеЗачитывать");
	КонецЕсли; 
	
	_ОбновитьНомераДокументов();
	
КонецПроцедуры

