Процедура ОбновитьИтогиПоОплатам()
	
	СуммаДокумента = Объект.Услуги.Итог("Всего");
	СуммаОплатыСчета = 0;
	СуммаОплатыАкта = 0;
	Для каждого Стр Из ТаблицаОплат Цикл
		Если (Стр.ПризнакОплатыАкта) Тогда
			СуммаОплатыАкта = СуммаОплатыАкта + Стр.Всего;
		Иначе
			СуммаОплатыСчета = СуммаОплатыСчета + Стр.Всего;
		КонецЕсли; 
	КонецЦикла; 
	// --- 
	ИтогоПоОплатамСчета = "Оплачено по счёту: ";
	ИтогоПоОплатамCчета = ИтогоПоОплатамСчета+Формат(СуммаОплатыСчета,"ЧЦ=15; ЧДЦ=2; ЧН=")+" "+Строка(Объект.Валюта);
	// --- 
	ИтогоПоОплатамАкта = "Оплачено по акту: ";
	ИтогоПоОплатамАкта = ИтогоПоОплатамАкта+Формат(СуммаОплатыАкта,"ЧЦ=15; ЧДЦ=2; ЧН=")+" "+Строка(Объект.Валюта);
	
	АхтунгДляСчета = Ложь;
	Если (СуммаОплатыСчета < СуммаДокумента) Тогда
		АхтунгДляСчета = Истина;
		ИтогоПоОплатамСчета = ИтогоПоОплатамСчета + "; Долг "+Формат(СуммаДокумента - СуммаОплатыСчета,"ЧЦ=15; ЧДЦ=2; ЧН=")+" "+Строка(Объект.Валюта);
	ИначеЕсли (СуммаОплатыСчета > СуммаДокумента) Тогда 
		АхтунгДляСчета = Истина;
		ИтогоПоОплатамСчета = ИтогоПоОплатамСчета + "; Переплата "+Формат(СуммаОплатыСчета - СуммаДокумента,"ЧЦ=15; ЧДЦ=2; ЧН=")+" "+Строка(Объект.Валюта);
	КонецЕсли; 
	Если (АхтунгДляСчета) Тогда
		Элементы.ИтогоПоОплатамСчета.ЦветТекста = ЦветаСтиля.CW_ЦветПлан;
	Иначе 
		Элементы.ИтогоПоОплатамСчета.ЦветТекста = ЦветаСтиля.ЦветТекстаПоля;
	КонецЕсли; 
	// --- 
	АхтунгДляАкта = Ложь;
	Если (СуммаОплатыАкта < СуммаДокумента) Тогда
		АхтунгДляАкта = Истина;
		ИтогоПоОплатамАкта = ИтогоПоОплатамАкта + "; Долг "+Формат(СуммаДокумента - СуммаОплатыАкта,"ЧЦ=15; ЧДЦ=2; ЧН=")+" "+Строка(Объект.Валюта);
	ИначеЕсли (СуммаОплатыАкта > СуммаДокумента) Тогда 
		АхтунгДляАкта = Истина;
		ИтогоПоОплатамАкта = ИтогоПоОплатамАкта + "; Переплата "+Формат(СуммаОплатыАкта - СуммаДокумента,"ЧЦ=15; ЧДЦ=2; ЧН=")+" "+Строка(Объект.Валюта);
	КонецЕсли; 
	Если (АхтунгДляАкта) Тогда
		Элементы.ИтогоПоОплатамАкта.ЦветТекста = ЦветаСтиля.CW_ЦветПлан;
	Иначе 
		Элементы.ИтогоПоОплатамАкта.ЦветТекста = ЦветаСтиля.ЦветТекстаПоля;
	КонецЕсли; 
	
КонецПроцедуры


