Процедура ОбновитьИтогиПоАвансам()
	// --- 
	
	СВ = Строка(Объект.Валюта);
	ФЧ = "ЧЦ=15; ЧДЦ=2; ЧН=";
	Если Объект.ЗачетАвансов.Количество() = 0 Тогда
		ИтогоПоАвансам = "Нет зачтённых авансов";
	Иначе
		ИтогоПоАвансам=	"Зачтено:  "+Формат(Объект.ЗачетАвансов.Итог("СуммаЗачета"),ФЧ)+" "+СВ;
	КонецЕсли;
	Если Объект.ЗачетАвансов.Итог("СуммаЗачета") > Объект.Услуги.Итог("Всего") Тогда
		
		Элементы.ИтогоПоАвансам.ЦветТекста = ЦветаСтиля.ЦветОсобогоТекста;
		
	Иначе
		
		Элементы.ИтогоПоАвансам.ЦветТекста = ЦветаСтиля.ЦветТекстаФормы;
		
	КонецЕсли; 
	// --- 
	Если Объект.ЗачетАвансовОЗ.Количество() = 0 Тогда
		ИтогоПоАвансамОЗ = "Нет зачтённых авансов";
	Иначе
		ИтогоПоАвансамОЗ =	"Зачтено:  "+Формат(Объект.ЗачетАвансовОЗ.Итог("СуммаЗачета"),ФЧ)+" "+СВ;
	КонецЕсли;
	Если Объект.ЗачетАвансовОЗ.Итог("СуммаЗачета") > Объект.Услуги.Итог("Всего") Тогда
		
		Элементы.ИтогоПоАвансамОЗ.ЦветТекста = ЦветаСтиля.ЦветОсобогоТекста;
		
	Иначе
		
		Элементы.ИтогоПоАвансамОЗ.ЦветТекста = ЦветаСтиля.ЦветТекстаФормы;
		
	КонецЕсли; 
	
	// --- 
КонецПроцедуры

#КонецОбласти 

#Область ЗаполнениеАвансов

&НаКлиенте
Процедура ЗаполнитьАвансы(Команда)
	
	Если (Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаЗачетАвансов) Тогда
		
		ПроверяемыйДокумент = Объект.ВедомыйДокумент;
		ТЧ = Объект.ЗачетАвансов;
		
	ИначеЕсли (Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаЗачетАвансовОЗ) Тогда 
		
		ПроверяемыйДокумент = Объект.Ссылка; 
		ТЧ = Объект.ЗачетАвансовОЗ;
		
	КонецЕсли; 
	
	Если ПроверяемыйДокумент.Пустая() Тогда
		
		ПОВ = Новый ОписаниеОповещения("ОбработкаОтветаЗаписиПриЗаполненииАвансов",ЭтотОбъект); 
		ПоказатьВопрос(ПОВ,"Документ не записан! Записать?", РежимДиалогаВопрос.ДаНет);
		
	Иначе
		
		ВыполнитьЗачетАвансов();
		
	КонецЕсли; 
	
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОтветаЗаписиПриЗаполненииАвансов(Ответ, ДополнительныеПараметры) Экспорт 
	// --- 
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		Записать();
		ВыполнитьЗачетАвансов();
	Иначе
		Возврат;
	КонецЕсли; 
	
	// --- 
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьЗачетАвансов()
	// --- 
	
	Если (Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаЗачетАвансов) Тогда
		
		ПроверяемыйДокумент = Объект.ВедомыйДокумент;
		ТЧ = Объект.ЗачетАвансов;
		
	ИначеЕсли (Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаЗачетАвансовОЗ) Тогда 
		
		ПроверяемыйДокумент = Объект.Ссылка; 
		ТЧ = Объект.ЗачетАвансовОЗ;
		
	КонецЕсли; 
	
	// ---------------------------------------------------------------------------- 
	
	БУ = (Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаЗачетАвансов);
	ОЗ = (Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаЗачетАвансовОЗ);
	
	ПФ = _ПараметрыФормыПодбораАвансов(БУ, ОЗ);
	Если ПФ.Количество = 0 Тогда
		
		_УФК.ВывестиПредупреждение("Доступных авансов не найдено.");
		ТЧ.Очистить();
		Возврат;
		
	КонецЕсли; 
	
	ПОВ = Новый ОписаниеОповещения("ОбработкаЗаполненияАвансов",ЭтотОбъект, Новый Структура("БУ,ОЗ",БУ,ОЗ)); 
	ОткрытьФорму("ОбщаяФорма.CW_ФормаЗачетаАвансов",ПФ,,,,,ПОВ, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
	
	// --- 
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаЗаполненияАвансов(Ответ, ДополнительныеПараметры) Экспорт
	// --- 
	
	Если Ответ <> Неопределено Тогда
		
		_ЗагрузитьРезультатПодбораАванса(Ответ,ДополнительныеПараметры.БУ,ДополнительныеПараметры.ОЗ);
		
	КонецЕсли; 
	
	// --- 
КонецПроцедуры

&НаСервере
Функция _ПараметрыФормыПодбораАвансов(БУ,ОЗ)
	// --- 
	
	ПФ = Новый Структура("Документ,ЗачетБУ,ЗачетОЗ,Валюта,СуммаСобственных,СуммаПеревыставляемых,ТаблицаАвансов,СчетАвансовПоСобственным,СчетАвансовПоПеревыставляемым,Количество,ОЗ,РаздельныйУчетЗаполженности");
	// ---------------------------------------------------------------------------- 
	ПФ.Документ = Документы.CW_РасходыПоПриобретениям.ПустаяСсылка();
	ПФ.ЗачетБУ = БУ;
	ПФ.ЗачетОЗ = ОЗ;
	ПФ.Валюта = Объект.Валюта;
	ПФ.РаздельныйУчетЗаполженности = РаздельныйУчетЗаполженности;
	// ---------------------------------------------------------------------------- 
	
	//Для версии КОРП
	Если ВестиУчетПоПодразделениям Тогда
		ПФ.Вставить("ВестиУчетПоПодразделениям"	, ВестиУчетПоПодразделениям);	
		ПФ.Вставить("ПодразделениеОрганизации"	, Объект.ПодразделениеОрганизации);	
	КонецЕсли;
	//Для версии КОРП
	
	ПараметрыТА 		= Новый Структура("Дата,Договор,ПриложениеКДоговору,ОЗ,РаздельныйУчетЗаполженности,Акт,ПереплатаКакАванс");
	ПараметрыТА.Договор = Объект.Договор;
	ПараметрыТА.ОЗ 		= ОперативныйУчет;
	ПараметрыТА.Акт 	= Объект.Ссылка;
	ПараметрыТА.РаздельныйУчетЗаполженности = РаздельныйУчетЗаполженности;
	ПараметрыТА.ПереплатаКакАванс 			= ПереплатаКакАванс;
	
	//Для версии КОРП
	Если ВестиУчетПоПодразделениям Тогда
		ПараметрыТА.Вставить("ВестиУчетПоПодразделениям"	, ВестиУчетПоПодразделениям);	
		ПараметрыТА.Вставить("ПодразделениеОрганизации"		, Объект.ПодразделениеОрганизации);	
	КонецЕсли;
	//Для версии КОРП

	
	Услуги = Объект.Услуги.Выгрузить();
	Если (ОперативныйУчет) Тогда
		Если (НЕ Объект.СписокСчетов) Тогда
			Если (ЗначениеЗаполнено(Объект.Счет)) Тогда
				Услуги.ЗаполнитьЗначения(Объект.Счет,"Счет");
			Иначе
				Услуги.ЗаполнитьЗначения(Объект.Ссылка,"Счет");
			КонецЕсли; 
		КонецЕсли; 
	КонецЕсли; 
	
	// --- 
	
	Если (БУ) Тогда
		
		ПараметрыТА.Дата = Новый Граница(Объект.ВедомыйДокумент.Дата,ВидГраницы.Исключая);
		ТаблицаАвансов = CW_Финансы.ТаблицаАвансов(ПараметрыТА,Услуги,Объект.ЗачетАвансов.Выгрузить(), Объект.ЗачетАвансовОЗ.Выгрузить());
		
	ИначеЕсли (ОЗ) Тогда 
		
		ПараметрыТА.Дата = Новый Граница(Объект.ДатаСчета,ВидГраницы.Исключая);
		ТаблицаАвансов = CW_Финансы.ТаблицаАвансовДляОЗ(ПараметрыТА,Услуги,Объект.ЗачетАвансовОЗ.Выгрузить());
		
	КонецЕсли; 
	
	// --- 
	Услуги.Свернуть("ПорядокОтражения", "Всего");
	ПФ.СуммаСобственных = _сф.Итог(Услуги,"Всего");
	ПФ.СуммаПеревыставляемых = 0;
	
	// счета расчета по возмещаемым
	// --- 
	Счет_Рубли = _ДС().УП.СчетРасчетов_Поставщики_Рубли;
	Счет_Валюта = _ДС().УП.СчетРасчетов_Поставщики_Валюта;
	Счет_УЕ = _ДС().УП.СчетРасчетов_Поставщики_УЕ;
	// --- 
	ВРУ = _ДС().КО.ВалютаРегламентированногоУчета;
	// --- 
	Счета = CW_Конфигурация.ПланСчетов();
	
	// определяем счета
	Если Объект.Валюта=ВРУ Тогда
		// --- 
		ПФ.СчетАвансовПоСобственным = Счета.РасчетыПоАвансамВыданным;
		Если Счет_Рубли=Счета.РасчетыСПоставщиками Тогда
			ПФ.СчетАвансовПоПеревыставляемым = Счета.РасчетыПоАвансамВыданным;
		Иначе
			ПФ.СчетАвансовПоПеревыставляемым = Счет_Рубли;
		КонецЕсли;
		// --- 
	Иначе
		Если Объект.Договор.ВзаиморасчетыВУЕ Тогда
			// --- 
			ПФ.СчетАвансовПоСобственным = Счета.РасчетыПоАвансамВыданнымУЕ;
			Если Счет_УЕ = Счета.РасчетыСПоставщикамиУЕ Тогда
				ПФ.СчетАвансовПоПеревыставляемым = Счета.РасчетыПоАвансамВыданнымУЕ;
			Иначе
				ПФ.СчетАвансовПоПеревыставляемым = Счет_УЕ;
			КонецЕсли; 
			// --- 
		Иначе 
			// --- 
			ПФ.СчетАвансовПоСобственным = Счета.РасчетыПоАвансамВыданнымВал;
			Если Счет_Валюта = Счета.РасчетыСПоставщикамиВал Тогда
				ПФ.СчетАвансовПоПеревыставляемым = Счета.РасчетыПоАвансамВыданнымВал;
			Иначе
				ПФ.СчетАвансовПоПеревыставляемым = Счет_Валюта;
			КонецЕсли; 
			// --- 
		КонецЕсли;	
	КонецЕсли; 
	
	
	ПФ.ТаблицаАвансов = ПоместитьВоВременноеХранилище(ТаблицаАвансов,ЭтаФорма.УникальныйИдентификатор);
	ПФ.Количество = ТаблицаАвансов.Количество();
	// --- 
	ПФ.ОЗ = _ДС().УП.ОЗ;
	
	Возврат(ПФ);
	
	// --- 
КонецФункции

&НаСервере
Процедура _ЗагрузитьРезультатПодбораАванса(Адрес,БУ,ОЗ)
	// --- 
	
	Попытка
		
		Если (БУ) Тогда
			Объект.ЗачетАвансов.Загрузить(ПолучитьИзВременногоХранилища(Адрес));
		ИначеЕсли (ОЗ) Тогда 
			Объект.ЗачетАвансовОЗ.Загрузить(ПолучитьИзВременногоХранилища(Адрес));
		КонецЕсли; 
		
	Исключение
	    //ОписаниеОшибки()
	КонецПопытки; 
	
	// --- 
КонецПроцедуры

#КонецОбласти 


#Область ПорядокЗаполненияРасчётноПлатёжныхДокументовСФ

&НаКлиенте
Процедура ЗаполнитьПлатёжноРасчётныеДокументы(Команда)
	
	Если НЕ Объект.Проведен Тогда 
		ПоказатьПредупреждение(Неопределено, "Чтобы автоматически заполнить список платёжно-расчётных документов"
		                                     "по счёта-фактуре документ должен быть проведён!");
		Возврат;
	КонецЕсли;
	
	Если НЕ Объект.ПорядокЗаполненияРасчётноПлатёжныхДокументовСФ = ПредопределенноеЗначение("Перечисление.CW_ПорядокЗаполненияРасчётноПлатёжныхДокументовСФ.ПоДокументу") Тогда 
		ПоказатьПредупреждение(Неопределено, "Ручное заполнение платёжно-расчётных длкументов для счёта-фактуры доступно, если выбрать порядок заполнения ""По документу""");
		Возврат;
	КонецЕсли;
	
	Если ЭтаФорма.Модифицированность Тогда
		оо = Новый ОписаниеОповещения("ОбработкаВопросаЗаписи_ЗаполнитьПлатёжноРасчётныеДокументы", ЭтотОбъект); 
		ПоказатьВопрос(оо,"Документ был изменён. Записать?", РежимДиалогаВопрос.ДаНет);
		Возврат;
	КонецЕсли; 
	
	ЗаполнитьПлатёжноРасчётныеДокументыПродолжение();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВопросаЗаписи_ЗаполнитьПлатёжноРасчётныеДокументы(Ответ, ДополнительныеПараметры) Экспорт 

	Если Ответ=КодВозвратаДиалога.Да Тогда
		Записать();
		ЗаполнитьПлатёжноРасчётныеДокументыПродолжение();
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПлатёжноРасчётныеДокументыПродолжение()
	
	_ЗаполнитьПлатёжноРасчётныеДокументыНаСервере();
	
	Если Объект.ПлатёжноРасчётныеДокументы.Количество() = 0 Тогда 
		ПоказатьПредупреждение(Неопределено, "Зачтенных авансов по документам ""Списание с расчетного счета"" не обнаружено!");
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура _ЗаполнитьПлатёжноРасчётныеДокументыНаСервере()

	Ответ = Документы.CW_РасходыПоГрузоперевозке.ПолучитьТаблицу_ПлатёжноРасчётныеДокументы_дляСФ(Объект.Ссылка);
	Если Ответ.Код = 0 Тогда
		Объект.ПлатёжноРасчётныеДокументы.Загрузить(Ответ.ПлатёжноРасчётныеДокументы);
		_УправлениеЭлементамиФормы();
	Иначе 
		Сообщить(Ответ.ОписаниеОшибки);
	КонецЕсли;
	
КонецПроцедуры

