
#Область ОсновныеСобытияФормы 

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	CW_Документы.УстановитьПараметрыФункциональныхОпцийФормы(Этаформа);
	
	ИмяНастроек 		= "Настойки_CW_ОперацииМСФО";
	СтруктураНастройки 	= Обработки.CW_ОперацииМСФО.ПолучитьНастройки(ИмяНастроек);
	
	Если СтруктураНастройки <> Неопределено Тогда
		НастройкиМСФО.Добавить(СтруктураНастройки);
	КонецЕсли;
	
	_УстановитьПараметрыФункциональныхОпцийФормы();
	
	ВалютаРегламентированногоУчетаРубль 						= ПолучитьФункциональнуюОпцию("CW_ВалютаРегламентированногоУчетаРубль");
	КонтролироватьПолучениеОригиналовОтПоставщиков 				= ПолучитьФункциональнуюОпцию("CW_КонтролироватьПолучениеОригиналовОтПоставщиков");	
	
	ПравоРедактированияНомераДокумента 	= CW_ПраваДоступа.ПравоДоступно("РедактированиеНомераДокументаРасходыПоГрузоперевозкам");
	Элементы.Номер.ТолькоПросмотр 		=  НЕ ПравоРедактированияНомераДокумента;
	
	ОграничиватьУслугиПоДоговорам		= ПолучитьФункциональнуюОпцию("CW_ОграничиватьУслугиПоДоговорам");
	НачальнаяДатаДокумента 				= Объект.Дата;
	
	//Для версии КОРП
	ВестиУчетПоПодразделениям					= ПолучитьФункциональнуюОпцию("ВестиУчетПоПодразделениям");
	Элементы.ПодразделениеОрганизации.Видимость	= ВестиУчетПоПодразделениям;
	//Для версии КОРП
	
	
	Если ОграничиватьУслугиПоДоговорам Тогда
		УстанавливатьЦенуВЗависимостиОтГруза 	= ПолучитьФункциональнуюОпцию("CW_УстанавливатьЦенуВЗависимостиОтГруза");
		УстанавливатьЦенуВЗависимостиОтКлиента 	= ПолучитьФункциональнуюОпцию("CW_УстановкаЦенНоменклатурыВЗависимостиОтКлиента");
	КонецЕсли;
	
	
	// проверим на копирование
	Если ЗначениеЗаполнено(Параметры.ЗначениеКопирования) Тогда
		Копия = Параметры.ЗначениеКопирования;
	КонецЕсли;	
	
	ЕстьОграниченияПоСпискуУслуг 	= Ложь; //по договору
	АдресУслугПоДоговору 			= "";
	
	// проверка лицензии
	Элементы.ГруппаИнфо.Видимость = Ложь;
	
	ОтображатьКомментарийДоговора = CW_Настройки.ПолучитьНастройкуПользователя(CW_Настройки.Пользователь(),"ОтображатьКомментарийДоговораВФормеВводаДокументовПоБюджету");
	
	УстановитьЗаголовокНадписиКомментарияДоговора();
	
	//Услуги по договру
	ОбновитьУслугиПоПротоколуНаСервере();
	
	Основание = _сф.ст_ПолучитьСвойство(Параметры,"Основание");
	Если Основание <> Неопределено Тогда
		
		Если (ТипЗнч(Основание) = Тип("ДокументСсылка.CW_РасходыПоГрузоперевозке")) Тогда
			
			// проверяем, что онованием является счет
			Если НЕ (Основание.ПредъявленСчет И НЕ (Основание.ПредъявленАкт ИЛИ Основание.ПредъявленСФ)) Тогда
				
				ФлагОтменыОткрытия = Истина;
				ТекстОтменыОткрытия = "Ввод на основании доступен только для неактированного счёта!";
				Возврат;
				
			КонецЕсли; 
			
		КонецЕсли; 
		
		Если (ТипЗнч(Основание) = Тип("ДокументСсылка.CW_ДоходыПоГрузоперевозке")) Тогда
			
			// режим ввода на основании
			РежимВводаНаОсновании = Истина;
			ДокументОснование = Основание;
			Возврат;
			
		КонецЕсли; 
		
		Если (ТипЗнч(Основание)=Тип("СправочникСсылка.CW_Грузоперевозки")) Тогда
			
			// добавляем строку
			Нстр = Объект.Услуги.Добавить();
			Нстр.Грузоперевозка = Основание;
			// --- 
			_ОбновитьСтатусПометокУдаления();
			
		КонецЕсли; 
		
		Если (ТипЗнч(Основание)=Тип("СправочникСсылка.CW_Заказы")) Тогда
			
			// добавляем строку
			МассивГП = CW_Мониторинг.ГрузоперевозкиЗаказа(Основание);
			Для каждого ГП Из МассивГП Цикл
				
				Нстр = Объект.Услуги.Добавить();
				Нстр.Грузоперевозка = ГП;
				
			КонецЦикла; 
			
			_ОбновитьСтатусПометокУдаления();
			
		КонецЕсли; 
		
	КонецЕсли; 
	
	// заполнение по бюджету
	АдресПараметровЗаполнения = _сф.ст_ПолучитьСвойство(Параметры,"АдресПараметровЗаполнения");
	Если (АдресПараметровЗаполнения <> Неопределено) Тогда
		
		СЗ = ПолучитьИзВременногоХранилища(АдресПараметровЗаполнения);
		ЗаполнитьЗначенияСвойств(Объект,СЗ,,"Услуги");
		// --- 
		Для каждого Стр Из СЗ.Услуги Цикл
			
			Нстр = Объект.Услуги.Добавить();
			ЗаполнитьЗначенияСвойств(Нстр,Стр);
			
		КонецЦикла;
		
		_ОбновитьСтатусПометокУдаления();
		// 
		КомментарийЗаполнения = Неопределено;
		СЗ.Свойство("КомментарийЗаполнения",КомментарийЗаполнения);
		
	КонецЕсли; 
	
	_ИнициализацияФормы();
	ОбработатьИзменениеСоставаЦены();

	УстановитьУсловноеОформление();
	
	//Срок оплаты
	Если Не Параметры.Ключ.Пустая() Тогда
		ДанныеСрокаОплаты = CW_Документы.ПолучитьСрокОплаты(Параметры.Ключ);
		
		ДанныеСрокаОплаты.Свойство("ДатаОплаты",			_СрокОплаты);
		ДанныеСрокаОплаты.Свойство("Описание",				_СрокОплатыОписание);
		ДанныеСрокаОплаты.Свойство("РучноеРедактирование",	_СрокОплатыРучноеРедактирование);
		
		УстановитьОписаниеСрокаОплаты();	
	КонецЕсли; 
	//Срок оплаты
	
	
	Если Параметры.Ключ.Пустая() Тогда
		Объект.ЦенаСНДС 		= CW_Настройки.ПолучитьНастройкуПользователя(CW_Настройки.Пользователь(),"ВДокументахЦенаСНДС");
		Объект.Валюта 			= Константы.ВалютаРегламентированногоУчета.Получить();
		Объект.Организация		= CW_Настройки.ОсновнаяОрганизация();
		Объект.Ответственный	= Пользователи.ТекущийПользователь();
		
		Если ВестиУчетПоПодразделениям и Не ЗначениеЗаполнено(Объект.ПодразделениеОрганизации) Тогда
			Объект.ПодразделениеОрганизации = CW_Настройки.ПолучитьНастройкуПользователя(CW_Настройки.Пользователь(),"ПодразделениеПользователя");
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Объект.Организация) Тогда
			_СформироватьОбщиеПараметры("УчетнаяПолитика");
		КонецЕсли;
		
	КонецЕсли;
	
	//Подсистема.СтатусыДокументов
	CW_СтатусыДокументовСервер.ПриСозданииНаСервере(ЭтаФорма,Отказ, СтандартнаяОбработка);
	//Подсистема.СтатусыДокументов
	
	//Подсистема.ОригиналыДокументов
	CW_ОригиналыДокументовСервер.ПриСозданииНаСервере(ЭтаФорма, Отказ, СтандартнаяОбработка);
	//Подсистема.ОригиналыДокументов
	
	//Подсистема.УчетПриложенийДоговоров
	CW_УчетПриложенийДоговоровСервер.ПриСозданииНаСервере(ЭтаФорма,Отказ, СтандартнаяОбработка );
	//Подсистема.УчетПриложенийДоговоров
	
	//Внешние подклчюаемые команды
	CW_ПодключаемыеКомандыСервер.ПриСозданииНаСервере(ЭтотОбъект);
	//Внешние подклчюаемые команды

	ПервичныеДокументыПриСозданииНаСервере();

	#Область Динамический_вывод_дополнительных_колонок
	
	_УФС.ОбновитьСписокДополнительныхКолонокФормы(ЭтаФорма, "CW_РасходыПоГрузоперевозке");
	УстановитьВидимостьКнопкиОбновленияЗначений();
	
	
	//Обновляем динамические колонки параметров ГП
	Если Объект.Услуги.Количество() > 0 Тогда
		_УФС.ОбновитьЗначенияПараметровГрузоперевозок(ПолучитьСтруктуруПараметровДляПередачи());
	КонецЕсли;
	
	#КонецОбласти
	

	
КонецПроцедуры

&НаСервере
Процедура _УстановитьПараметрыФункциональныхОпцийФормы()
	
	ПараметрыФункциональныхОпций = Новый Структура("CW_Пользователь", CW_Настройки.Пользователь());
	УстановитьПараметрыФункциональныхОпцийФормы(ПараметрыФункциональныхОпций);
	
КонецПроцедуры


&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	// проверим на копирование
	Если ЗначениеЗаполнено(Копия) Тогда
		// проверим грузоперевозки
		Блок = _ПроверитьБлок();
		Если (Блок) Тогда
			Объект.Услуги.Очистить();
			_УФК.ВывестиПредупреждение("Документ содержит блокированые грузоперевозки." + Символы.ПС + "Табличная часть очищена.");
		КонецЕсли;		
		
		ОбновитьИтогиПоУслугам();
		ОбновитьИтогиПоАвансам();	
		ОбновитьИтогиПоАктированию();
	КонецЕсли;	
	
	
	Если (ЗначениеЗаполнено(КомментарийЗаполнения)) Тогда
		
		Сообщить(КомментарийЗаполнения);		
		
	КонецЕсли;
	
	Если ФлагОтменыОткрытия Тогда
		
		_УФК.ВывестиПредупреждение(ТекстОтменыОткрытия);
		Отказ = Истина;
		Возврат;
		
	КонецЕсли; 
	
	Если (РежимВводаНаОсновании) Тогда
		
		ПодключитьОбработчикОжидания("ДиалогВводаНаОсновании",0.1,Истина);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	//Подсистема.СтатусыДокументов
	CW_СтатусыДокументовСервер.ПередЗаписьюНаСервере(ЭтаФорма, Отказ, ТекущийОбъект, ПараметрыЗаписи);
	//Подсистема.СтатусыДокументов

	// для новых сохраняем срок оплаты
	Если (Объект.Ссылка.Пустая()) Тогда
		
		_сф.ст_УстановитьСвойство(ТекущийОбъект.ДополнительныеСвойства,"СрокОплаты"						,_СрокОплаты);
		_сф.ст_УстановитьСвойство(ТекущийОбъект.ДополнительныеСвойства,"СрокОплатыОписание"				,_СрокОплатыОписание);
		_сф.ст_УстановитьСвойство(ТекущийОбъект.ДополнительныеСвойства,"СрокОплатыРучноеРедактирование"	,_СрокОплатыРучноеРедактирование);
		
	КонецЕсли;
	
	// признак интерактивного режима
	_сф.ст_УстановитьСвойство(ТекущийОбъект.ДополнительныеСвойства,"ИнтерактивныйРежим",Истина);
	
	// тут перенесём доп. свойства в дополнительные свойства объекта
	_сф.ст_ДобавитьСвойства(ТекущийОбъект.ДополнительныеСвойства,"*",_ДС());
	ТекущийОбъект.ДС = ТекущийОбъект.ДополнительныеСвойства;
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	_ОбновитьНомераДокументов();
	// --- 
	_УправлениеЭлементамиФормы();
	// --- 
	_ОбновитьСтатусПометокУдаления();
	_ОбновитьНадписиКорректировок();
	// --- 
	НачальнаяДатаДокумента = Объект.Дата;

	//Срок оплаты
	Если _СрокОплатыРучноеРедактирование и ЗначениеЗаполнено(_СрокОплаты) Тогда
		ЗаписатьСрокОплатыДокумента();  
	КонецЕсли;
	
	РасчитатьСрокОплатыДокумента();
	//Срок оплаты
	
	//Подсистема.СтатусыДокументов
	CW_СтатусыДокументовСервер.ПослеЗаписиНаСервере(ЭтаФорма, ТекущийОбъект, ПараметрыЗаписи);
	//Подсистема.СтатусыДокументов
	
	//Подсистема.ОригиналыДокументов
	CW_ОригиналыДокументовСервер.ПослеЗаписиНаСервере(ЭтаФорма, ТекущийОбъект, ПараметрыЗаписи);
	//Подсистема.ОригиналыДокументов

	_УФС.ОбновитьЗначенияПараметровГрузоперевозок(ПолучитьСтруктуруПараметровДляПередачи());
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)

	//Подсистема.РаботаСПодключаемымиОбъектами
	CW_ПодключаемыеКомандыКлиент.ПослеЗаписи(ЭтотОбъект, ПараметрыЗаписи);
	//Подсистема.РаботаСПодключаемымиОбъектами
	
	//Срок оплаты
	ДанныеСрокаОплаты = CW_Документы.ПолучитьСрокОплаты(Объект.Ссылка);
	ДанныеСрокаОплаты.Свойство("ДатаОплаты",			_СрокОплаты);
	ДанныеСрокаОплаты.Свойство("Описание",				_СрокОплатыОписание);
	ДанныеСрокаОплаты.Свойство("РучноеРедактирование",	_СрокОплатыРучноеРедактирование);
	
	УстановитьОписаниеСрокаОплаты();
	//Срок оплаты
	
	ОповеститьОбИзменении(Объект.Ссылка);
	_УправлениеЭлементамиФормы();
	
	Если (НЕ Объект.Корректировка) Тогда
		
		Если (ЗначениеЗаполнено(Объект.ВедомыйСчет)) Тогда
			ОповеститьОбИзменении(Объект.ВедомыйСчет);
		КонецЕсли;
		Если (ЗначениеЗаполнено(Объект.ВедомыйДокумент)) Тогда
			ОповеститьОбИзменении(Объект.ВедомыйДокумент);
		КонецЕсли; 
		Если (ЗначениеЗаполнено(Объект.ВедомыйСчетФактура)) Тогда
			ОповеститьОбИзменении(Объект.ВедомыйСчетФактура);
		КонецЕсли; 
		
	Иначе
		
		Если (ЗначениеЗаполнено(Объект.ВедомыйДокументКорректировки)) Тогда
			ОповеститьОбИзменении(Объект.ВедомыйДокументКорректировки);
		КонецЕсли; 
		Если (ЗначениеЗаполнено(Объект.ВедомыйСчетФактураКорректировочный)) Тогда
			ОповеститьОбИзменении(Объект.ВедомыйСчетФактураКорректировочный);
		КонецЕсли;

	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если (ИмяСобытия = "ВыполненаЗаписьДокумента") Тогда
		
		Прочитать();
		_УправлениеЭлементамиФормы();
		
	ИначеЕсли ИмяСобытия = "ОбновитьСписокУслугПоПротоколу" Тогда
		
		ОбновитьУслугиПоПротоколуНаСервере();
		
	ИначеЕсли ИмяСобытия = "ВыполнитьМетодВладельца" Тогда
		
		Если ТипЗнч(Параметр) = тип("Структура") Тогда
			УникальныйИдентификаторВладельца 	= Неопределено;
			МетодыФормыВладельца 				= Неопределено;
			
			Параметр.Свойство("УникальныйИдентификатор"	, УникальныйИдентификаторВладельца);
			Параметр.Свойство("МетодыФормыВладельца"	, МетодыФормыВладельца);
			
			Если ЭтаФорма.УникальныйИдентификатор = УникальныйИдентификаторВладельца Тогда
				Если Не МетодыФормыВладельца = Неопределено и ТипЗнч(МетодыФормыВладельца) = Тип("Массив") Тогда
					
					Для Каждого СтрокаМассива из МетодыФормыВладельца Цикл
						Попытка
							Выполнить(СтрокаМассива);
						Исключение
						КонецПопытки;
					КонецЦикла;
					
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;	
		
	ИначеЕсли ИмяСобытия = "ОбновитьКоментарийДоговораНаФрме" Тогда
		
		УстановитьЗаголовокНадписиКомментарияДоговора();
		
	ИначеЕсли ИмяСобытия = "ОбновитьАдресУслугДоговора" Тогда
		
		ОбработатьОповещениеИзмененияСпискаУслуг() ;
		
	ИначеЕсли ИмяСобытия = "Запись_CW_Грузоперевозки" Тогда
		
		#Область Динамический_вывод_дополнительных_колонок
		
		ОбновитьЗначенияПараметровГрузоперевозокнаСервере();
		
		#КонецОбласти
		
	//Подсистема.СтатусыДокументов
	ИначеЕсли ИмяСобытия = "Изменение_СтатусДокумента" Тогда
		
		ОбработатьОповещениеИзменениеСтатусДокументаНаСервере();
	//Подсистема.СтатусыДокументов
	
	КонецЕсли;
	
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьЗначенияПараметровГрузоперевозокнаСервере()
	
	Если Объект.Услуги.Количество() > 0 Тогда
		_УФС.ОбновитьЗначенияПараметровГрузоперевозок(ПолучитьСтруктуруПараметровДляПередачи());
	КонецЕсли;
	
КонецПроцедуры	


&НаСервере
Процедура ОбработатьОповещениеИзмененияСпискаУслуг()
	
	АдресУслугПоДоговору = "";
	Если ОграничиватьУслугиПоДоговорам Тогда
		ЕстьОграниченияПоСпискуУслуг =?(ЗначениеЗаполнено(Объект.Договор), Объект.Договор.ОграничиватьНоменклатуру, Ложь);
		Если ЕстьОграниченияПоСпискуУслуг тогда  
			
			ДатаДокумента = Объект.Дата;
			Если Объект.ПредъявленСчет 
				И ЗначениеЗаполнено(Объект.ДатаСчета) Тогда
				ДатаДокумента = Объект.ДатаСчета;  
			КонецЕсли;      
			
			АдресУслугПоДоговору = _УФС.ОбновитьСписокУслугПоДоговору(ДатаДокумента, Объект.Договор, ЭтаФорма);
		КонецЕсли;	
	КонецЕсли;
	
КонецПроцедуры


&НаСервере
Процедура ПриЗакрытииНаСервере()
	
	мВыбранныеКолонки = Новый Массив;
	
	Для Каждого ЭлементСписка из СписокДополнительныхКолонок Цикл
		Если ЭлементСписка.Пометка Тогда
			мВыбранныеКолонки.Добавить(ЭлементСписка.Значение);
		КонецЕсли;
	КонецЦикла;
	
	Настройка = Новый Структура;
	Настройка.Вставить("ВыбранныеКолонки"	, мВыбранныеКолонки);
	
	ХранилищеСистемныхНастроек.Сохранить(ЭтаФорма.ИмяФормы, "CW_РасходыПоГрузоперевозке",Настройка);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	
	Если Не ЗавершениеРаботы Тогда
		ПриЗакрытииНаСервере();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	СостояниеДокумента = ОбщегоНазначенияБП.СостояниеДокумента(Объект); // ВызовБП
	
	ЗаполнитьДобавленныеКолонкиТаблиц("Услуги");
	
	//ДатыЗапретаИзменения
	//Проверяем дату запрета по документам БУ
	мОбъектыПроверки = ПолучитьМассивОбъектовДляПроверки();
	Для Каждого ЭлементМассива из мОбъектыПроверки Цикл
		//Есть ведомые документы, проверяем дату запрета редактирования БП
		ОбъектМассива = ЭлементМассива.ПолучитьОбъект();
		Разрешено = ДатыЗапретаИзменения.ОбъектПриЧтенииНаСервере(ЭтотОбъект, ОбъектМассива);
		Если не Разрешено Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	//ДатыЗапретаИзменения

КонецПроцедуры

&НаСервере
Функция ПолучитьМассивОбъектовДляПроверки()
	
	Результат = Новый Массив;
	
	Если ЗначениеЗаполнено(Объект.ВедомыйДокумент) Тогда
		Результат.Добавить(Объект.ВедомыйДокумент);
	КонецЕсли;
	Если ЗначениеЗаполнено(Объект.ВедомыйСчетФактура) Тогда
		Результат.Добавить(Объект.ВедомыйСчетФактура);
	КонецЕсли;
	Если ЗначениеЗаполнено(Объект.ВедомыйСчет) Тогда
		Результат.Добавить(Объект.ВедомыйСчет);
	КонецЕсли;
	Если ЗначениеЗаполнено(Объект.ВедомыйДокументКорректировки) Тогда
		Результат.Добавить(Объект.ВедомыйДокументКорректировки);
	КонецЕсли;
	Если ЗначениеЗаполнено(Объект.ВедомыйСчетФактураКорректировочный) Тогда
		Результат.Добавить(Объект.ВедомыйСчетФактураКорректировочный);
	КонецЕсли;
	
	Возврат Результат; 
	
КонецФункции

&НаСервере
Процедура ОбновитьУслугиПоПротоколуНаСервере()
	
	Если ОграничиватьУслугиПоДоговорам и ЗначениеЗаполнено(Объект.Договор) Тогда
		ЕстьОграниченияПоСпискуУслуг =?(ЗначениеЗаполнено(Объект.Договор), Объект.Договор.ОграничиватьНоменклатуру, Ложь);
		
		Если ЕстьОграниченияПоСпискуУслуг Тогда
			ДатаДокумента = Объект.Дата;
			Если Объект.ПредъявленСчет 
				И ЗначениеЗаполнено(Объект.ДатаСчета) Тогда
				ДатаДокумента = Объект.ДатаСчета;  
			КонецЕсли;      
			АдресУслугПоДоговору = _УФС.ОбновитьСписокУслугПоДоговору(ДатаДокумента, Объект.Договор, ЭтаФорма);
		КонецЕсли;
		
	КонецЕсли;
	СтруктураДанных = новый Структура;
	СтруктураДанных.Вставить("АдресУслугПоДоговору"			, АдресУслугПоДоговору);
	СтруктураДанных.Вставить("ЭлементФормы"					, Элементы.УслугиНоменклатура);
	СтруктураДанных.Вставить("ЕстьОграниченияПоСпискуУслуг"	, ЕстьОграниченияПоСпискуУслуг);
	
	_УФС.УстановитьСписокУслуг(СтруктураДанных);

КонецПроцедуры

&наСервере
Процедура УстановитьЗаголовокНадписиКомментарияДоговора()
	
	КомментарийДоговора = ?(Объект.Договор.Пустая(),"", СокрЛП(Объект.Договор.Комментарий));
	
	Элементы.НадписьКомментарийДоговора.Видимость = ОтображатьКомментарийДоговора и ЗначениеЗаполнено(КомментарийДоговора);
	Элементы.НадписьКомментарийДоговора.Заголовок = КомментарийДоговора;
	
КонецПроцедуры


