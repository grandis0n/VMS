&НаКлиенте
Процедура УслугиПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа)
	
	Если НЕ Копирование Тогда
		// --- 
		
		Отказ = Истина;
		Модифицированность = истина;
		// --- 
		строкаУслуги = Объект.Услуги.Добавить();
		строкаУслуги.Количество = 1;
		
		ПорядокОтражения = _ДС().ПД.ОсновнойПорядокОтраженияРасходов;
		Если (ПорядокОтражения.Пустая()) Тогда
			ПорядокОтражения = ПредопределенноеЗначение("Перечисление.CW_ПорядокОтраженияЗатрат.Затраты");
		КонецЕсли; 
		строкаУслуги.ПорядокОтражения = ПорядокОтражения;
		
		строкаУслуги.Подразделение = ПодразделениеПользователя;
		
		Элементы.Услуги.ТекущаяСтрока = строкаУслуги.ПолучитьИдентификатор();
		Элементы.Услуги.ТекущийЭлемент = Элементы.УслугиГрузоперевозка;
		
		
		// --- 
	КонецЕсли; 
	
