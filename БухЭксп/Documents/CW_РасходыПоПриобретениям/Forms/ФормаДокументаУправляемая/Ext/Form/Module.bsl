Процедура ДоговорНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	// --- 
	Отбор = Новый Структура("Владелец,Организация,ВидДоговора",Объект.Контрагент,Объект.Организация,ПредопределенноеЗначение("Перечисление.ВидыДоговоровКонтрагентов.Прочее"));
	ПараметрыФормы = Новый Структура("Отбор,РежимВыбора",Отбор,Истина);
	// --- 
	ОткрытьФорму("Справочник.CW_ДоговорыПоГрузоперевозкам.ФормаВыбора",ПараметрыФормы,Элемент);
	
