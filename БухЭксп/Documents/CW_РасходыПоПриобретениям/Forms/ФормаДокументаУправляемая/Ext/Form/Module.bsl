&НаКлиенте
Процедура УслугиСчетНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	// ---------------------------------------------------------------------------- 
	
	Вариант = Неопределено;
	
	Список = Новый СписокЗначений;
	Список.Добавить("список","Выбор из списка");
	
	// если ведется оперативный учет задолженности
	
	Если (ОперативныйУчет И НЕ ВводОстатковОЗ) Тогда
		
		Список.Добавить("подбор","Подбор неактированных");
		
	КонецЕсли; 
	
	ПОВ = Новый ОписаниеОповещения("ВыполнитьПодборСчета",ЭтотОбъект, Новый Структура("Элемент", Элемент)); 
	Если (Список.Количество()=1) Тогда
		
		Вариант = Список[0];
		ВыполнитьОбработкуОповещения(ПОВ, Вариант);
		
	Иначе
		
		ПоказатьВыборИзМеню(ПОВ,Список,Элемент);
		
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьПодборСчета(Вариант, ДополнительныеПараметры) Экспорт
	// --- 
	
	Если (Вариант <> Неопределено) Тогда
		
		Вариант = Вариант.Значение;
		
	КонецЕсли; 
	
	Если (Вариант = "подбор") Тогда
		
		ТД=Элементы.Услуги.ТекущиеДанные;
		ПФ = Новый Структура("Дата,Документ,Отбор",Объект.Дата,Объект.Ссылка,Новый Структура("Организация,Контрагент,Договор,Валюта,Грузоперевозка,ПорядокОтражения,Номенклатура,СтавкаНДС",Объект.Организация,Объект.Контрагент,Объект.Договор,Объект.Валюта,ТД.Грузоперевозка,ТД.ПорядокОтражения,ТД.Номенклатура,ТД.СтавкаНДС));
		ОткрытьФорму("ОбщаяФорма.CW_ПодборНеактированныхСчетов",ПФ,ДополнительныеПараметры.Элемент);
		
	ИначеЕсли (Вариант = "список") Тогда 
		
		ПФ = Новый Структура("Отбор,РежимВыбора",Новый Структура("Контрагент,Договор,ПредъявленСчет,ПредъявленАкт,ПредъявленСФ",Объект.Контрагент,Объект.Договор,Истина,Ложь,Ложь),Истина);
		ОткрытьФорму("Документ.CW_РасходыПоГрузоперевозке.ФормаВыбора",ПФ,ДополнительныеПараметры.Элемент);
				
	КонецЕсли; 
	
	// --- 
КонецПроцедуры
  

