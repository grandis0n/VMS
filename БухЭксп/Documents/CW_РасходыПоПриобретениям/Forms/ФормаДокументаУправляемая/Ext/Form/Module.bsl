Процедура ОбновитьИтогиПоУслугам()
	//! ИтогоВсего
	
	// итоговая строка по табличной части "Услуги" 
	СВ = Строка(Объект.Валюта);
	ФЧ = "ЧЦ=15; ЧДЦ=2; ЧН=";
	Если (НЕ Объект.Корректировка) Тогда
		
		Элементы.СтраницаУслуги.Заголовок = " Услуги (" +Объект.Услуги.Количество() + ")";
		Если Объект.Услуги.Количество() = 0 Тогда
			ИтогоПоУслугам = "Сведения об услугах отсутствуют";
		Иначе
			ИтогоПоУслугам=	"Строк: "+Объект.Услуги.Количество()+
			";  Сумма: "+Формат(Объект.Услуги.Итог("Сумма"),ФЧ)+" "+СВ+ 
			";  НДС: "+Формат(Объект.Услуги.Итог("НДС"),ФЧ)+" "+СВ+
			";  Всего: "+Формат(Объект.Услуги.Итог("Всего"),ФЧ)+" " +СВ;
		КонецЕсли;
		
		Если (КонтрольДокументовПоСумме) Тогда
			Отклонение = 0;
			Если (Объект.СуммаПоПервичномуДокументу <> 0) Тогда
				Если (Объект.Услуги.Итог("Всего") <> Объект.СуммаПоПервичномуДокументу) Тогда
					Отклонение = Объект.СуммаПоПервичномуДокументу - Объект.Услуги.Итог("Всего");
					Если (Отклонение <> 0) Тогда
						ИтогоПоУслугам = ИтогоПоУслугам + "; Отклонение от контрольной суммы: "+Формат(Отклонение,ФЧ)+" " +СВ;	
					КонецЕсли; 
				КонецЕсли; 
			КонецЕсли; 
			
			// управление цветом итоговой надписи при наличии отклонения от контрольной суммы
			Если Отклонение <> 0 Тогда
				Элементы.ИтогоПоУслугам.ЦветТекста = ЦветаСтиля.ЦветОсобогоТекста;
			Иначе
				Элементы.ИтогоПоУслугам.ЦветТекста = ЦветаСтиля.ЦветТекстаФормы;
			КонецЕсли; 
		КонецЕсли; // выполняется котроль суммы документа
		
	Иначе
		
		//Элементы.СтраницаУслугиКорректировка.Заголовок = " Услуги (" +Объект.Услуги.Количество() + ")";
		Если Объект.Услуги.Количество() = 0 Тогда
			ИтогоПоУслугам_Корректировка = "Сведения об услугах отсутствуют";
		Иначе
			ИтогоПоУслугам_Корректировка =	"Строк: "+Объект.Услуги.Количество()+
			";  Сумма: "+Формат(Объект.Услуги.Итог("Сумма")-Объект.Услуги.Итог("Сумма_ДоКорректировки"),ФЧ)+" "+СВ+ 
			";  НДС: "+Формат(Объект.Услуги.Итог("НДС")-Объект.Услуги.Итог("НДС_ДоКорректировки"),ФЧ)+" "+СВ+
			";  Всего: "+Формат(Объект.Услуги.Итог("Всего")-Объект.Услуги.Итог("Всего_ДоКорректировки"),ФЧ)+" " +СВ;
		КонецЕсли;
		
	КонецЕсли;
						
КонецПроцедуры

&НаСервере
Процедура _ОбновитьСтатусПометокУдаления()
	
	ЗаполнитьДобавленныеКолонкиТаблиц("Услуги");

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДобавленныеКолонкиТаблиц(ИмяТабличнойЧасти)
	
	
	МассивГрузоперевозок 	= Объект[ИмяТабличнойЧасти].Выгрузить().ВыгрузитьКолонку("Грузоперевозка");
	СвойстваГрузоперевозок 	= CW_Грузоперевозки_Сервер.ПолучитьСведенияПоГрузоперевозкам(МассивГрузоперевозок);
	
	Для каждого СтрокаДокумента Из Объект[ИмяТабличнойЧасти] Цикл
		
		СтруктураСвойств = СвойстваГрузоперевозок.Получить(СтрокаДокумента.Грузоперевозка);
		
		Если СтруктураСвойств <> Неопределено Тогда
			СтруктураСвойств.Свойство("ПометкаУдаления",СтрокаДокумента.ГрузоперевозкаУдалена);
		Конецесли;
		
		
	КонецЦикла;
	
	ПараметрыОбъекта = Неопределено;
	ЗаполнитьПараметрыОбъектаДляЗаполненияДобавленныхКолонок(ЭтаФорма, ПараметрыОбъекта);
	
	Если ПустаяСтрока(ИмяТабличнойЧасти) ИЛИ ИмяТабличнойЧасти = "Услуги" Тогда
		
		Для Каждого СтрокаТаблицы Из Объект.Услуги Цикл
			ЗаполнитьДобавленныеКолонкиСтрокиТаблицыУслуги(СтрокаТаблицы, ПараметрыОбъекта);
		КонецЦикла;
		
		CW_БухгалтерскийУчетКлиентСерверМСФО.УстановитьНачальныеСвойстваСубконтоТаблицы(
		Объект.Услуги, ПараметрыУстановкиСвойствСубконто(ЭтотОбъект));
		
	КонецЕсли;
	
	
КонецПроцедуры



#КонецОбласти 

#Область УслугиРеквизиты

&НаКлиенте
Процедура УслугиГрузоперевозкаПриИзменении(Элемент)
	
	_УслугиГрузоперевозкаПриИзменении(Элементы.Услуги.ТекущаяСтрока);
	
КонецПроцедуры

&НаСервере
Процедура _УслугиГрузоперевозкаПриИзменении(Строка)
	// --- 
	
	СтрокаТЧ = Объект.Услуги.НайтиПоИдентификатору(Строка);
	
	ПараметрыШаблона = CW_Шаблоны.ПолучитьПараметрШаблонаУслуг();
	
	ПараметрыШаблона.Номенклатура 	= СтрокаТЧ.Номенклатура;
	ПараметрыШаблона.Объект 		= Объект;
	ПараметрыШаблона.Дата 			= Объект.Дата;
	ПараметрыШаблона.Договор 		= Объект.Договор;
	ПараметрыШаблона.ВидДоговора 	= Объект.Договор.ВидДоговора;
	ПараметрыШаблона.ПриложениеКДоговору = Объект.ПриложениеКДоговору;
	
	CW_Шаблоны.УстановитьПредставлениеНоменклатурыВСтроке(СтрокаТЧ, ПараметрыШаблона); 
	
	// --- 
	Если СтрокаТЧ.ПорядокОтражения <> Перечисления.CW_ПорядокОтраженияЗатрат.Затраты Тогда
		
		СтруктураПараметровКлиента = Новый Структура;
		СтруктураПараметровКлиента.Вставить("Объект"			, СтрокаТЧ.Грузоперевозка);
		СтруктураПараметровКлиента.Вставить("ЭтоВариантБюджета"	, Ложь);
		СтруктураПараметровКлиента.Вставить("Контрагент"		, СтрокаТЧ.Грузоперевозка.Клиент);
		
		КлиентПлат = CW_Финансы.ВернутьПлательщика(СтруктураПараметровКлиента);
		Если ЗначениеЗаполнено(СтрокаТЧ.Грузоперевозка.Клиент) И КлиентПлат <> СтрокаТЧ.Покупатель Тогда
			
			СтрокаТЧ.Покупатель =  КлиентПлат;//СтрокаТЧ.Грузоперевозка.Клиент;
			Если (НЕ СтрокаТЧ.Покупатель.Пустая()) Тогда
				
				ДоговорГП = ДоговорГрузоперевозки(СтрокаТЧ.Грузоперевозка, СтрокаТЧ.Покупатель);
				Если (ДоговорГП = Неопределено) Тогда
					СтрокаТЧ.ДоговорПокупателя = ПоследнийДоговорКонтрагента(СтрокаТЧ.Покупатель, Объект.Организация, ПредопределенноеЗначение("Перечисление.ВидыДоговоровКонтрагентов.СПокупателем"));
				Иначе
					СтрокаТЧ.ДоговорПокупателя = ДоговорГП;
				КонецЕсли; 
				
			КонецЕсли; 
			
		КонецЕсли; 
		
	Иначе
		
		_ПодставитьПодразделение(СтрокаТЧ);
		
	КонецЕсли; 
	
	_ОбновитьСтатусПометокУдаления();
	
	#Область Динамический_вывод_дополнительных_колонок
	
	_УФС.ОбновитьЗначенияПараметровГрузоперевозкиПоСтроке(СтрокаТЧ, ПолучитьСтруктуруПараметровДляПередачи());	
	
	#КонецОбласти
	
	// --- 
КонецПроцедуры

&НаСервере
Процедура _ПодставитьПодразделение(СтрокаТЧ)
	// --- 
	
	Если (НЕ _ДС().УП.ГруппировкаЗатратПоПодразделениям) Тогда
		
		Возврат;
		
	КонецЕсли; 
	
	Если (НЕ СтрокаТЧ.Подразделение.Пустая()) Тогда
			
		Возврат;
			
	КонецЕсли; 
	
	Если (НЕ СтрокаТЧ.Грузоперевозка.Пустая()) Тогда
		
		ПараметрПодразделения = Константы.CW_ПараметрПодразделенияЗатрат.Получить();
		Если (НЕ ПараметрПодразделения.Пустая()) Тогда
			
			Отбор = Новый Структура("Параметр",ПараметрПодразделения);
			СтрокаПараметра = _сф.к_НайтиСтроку(СтрокаТЧ.Грузоперевозка.ПараметрыГрузоперевозки,Отбор);
			Если (СтрокаПараметра <> Неопределено) Тогда
				
				Если (ЗначениеЗаполнено(СтрокаПараметра.Значение)) Тогда
					
					СтрокаТЧ.Подразделение = СтрокаПараметра.Значение;
					
				КонецЕсли; 
				
			КонецЕсли; 
			
		КонецЕсли; 
		
	КонецЕсли; 
	
	// --- 
КонецПроцедуры
 

&НаКлиенте
Процедура УслугиНоменклатураПриИзменении(Элемент)
	
	_УслугиНоменклатураПриИзменении(Элементы.Услуги.ТекущаяСтрока);
	
КонецПроцедуры

&НаСервере
Процедура _УслугиНоменклатураПриИзменении(Строка)
	
	СтрокаТЧ = Объект.Услуги.НайтиПоИдентификатору(Строка);
	
	//Заполняем счета МСФО
	Если НастройкиМСФО.Количество() > 0 Тогда
		ЭлементСписка 		= НастройкиМСФО.Получить(0);
		СтруктураНастроек 	= ЭлементСписка.Значение;
		
		Если ТипЗнч(СтруктураНастроек) = Тип("Структура") Тогда
			Если Не ЗначениеЗаполнено(СтрокаТЧ.СчетЗатрат) и СтруктураНастроек.Свойство("СчетУчетаЗатрат") Тогда
				
				СтрокаТЧ.СчетЗатрат = СтруктураНастроек.СчетУчетаЗатрат;
				
				CW_БухгалтерскийУчетКлиентСерверМСФО.УстановитьСвойстваСубконтоСтрокиПриИзмененииСчета(
				ЭтотОбъект, СтрокаТЧ, ПараметрыУстановкиСвойствСубконто(ЭтотОбъект));
				
				ПараметрыОбъекта = Неопределено;
				ЗаполнитьПараметрыОбъектаДляЗаполненияДобавленныхКолонок(ЭтаФорма, ПараметрыОбъекта);
				
				ЗаполнитьДобавленныеКолонкиСтрокиТаблицыУслуги(СтрокаТЧ, ПараметрыОбъекта);
				
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтрокаТЧ.Номенклатура) Тогда 
		
		Если _ДС().НП.ПодставлятьСтавкуНДС Тогда
			
			// пересчет суммовых показателей осуществляем, только при изменении ставки НДС
			СтавкаНДСНоменклаутры =  CW_БухгалтерияЭкспедитораСерверПереопределяемый.СтавкаНДС(СтрокаТЧ.Номенклатура, Объект.Дата);
			Если СтрокаТЧ.СтавкаНДС <> СтавкаНДСНоменклаутры Тогда
				СтрокаТЧ.СтавкаНДС = СтавкаНДСНоменклаутры;
				
				ТД = СтрокаТЧ;
				ТД.Сумма = ТД.Цена * ТД.Количество;
				ТД.НДС = ТД.Сумма * CW_Финансы.ПолучитьСтавкуНДС(ТД.СтавкаНДС)/100;
				ТД.Всего = ТД.Сумма + ТД.НДС;
				
			КонецЕсли; 
		КонецЕсли;
		
	КонецЕсли;
	
	// пробуем переформировать представление номенклатуры
	ПараметрыШаблона = CW_Шаблоны.ПолучитьПараметрШаблонаУслуг();
	
	ПараметрыШаблона.Номенклатура 	= СтрокаТЧ.Номенклатура;
	ПараметрыШаблона.Объект 		= Объект;
	ПараметрыШаблона.Дата 			= Объект.Дата;
	ПараметрыШаблона.Договор 		= Объект.Договор;
	ПараметрыШаблона.ВидДоговора 	= Объект.Договор.ВидДоговора;
	ПараметрыШаблона.ПриложениеКДоговору = Объект.ПриложениеКДоговору;
	
	CW_Шаблоны.УстановитьПредставлениеНоменклатурыВСтроке(СтрокаТЧ, ПараметрыШаблона); 
	
	// установка цены номенклатуры
	ТД = СтрокаТЧ;
	Если ТД.Цена = 0  Тогда
		
		ТипЦен = _ДС().ПД.ТипЦен;
		Если НЕ ТипЦен.Пустая() Тогда
			
			СК = CW_Финансы.ПолучитьКурсВалюты(Объект.Валюта,_ДатаВозникновенияЗадолженности());
			Цена = Ценообразование.ПолучитьЦенуНоменклатуры(СтрокаТЧ.Номенклатура, ТипЦен, _ДатаВозникновенияЗадолженности(), Объект.Валюта, СК.Курс,СК.Кратность);
			Если Цена <> 0 Тогда
				
				Если ТипЦен.ЦенаВключаетНДС Тогда
					Если ЗначениеЗаполнено(ТД.СтавкаНДС) И ЗначениеЗаполнено(ТД.Количество) Тогда
						ТД.Всего = Цена*ТД.Количество;
						Ставка = CW_Финансы.ПолучитьСтавкуНДС(ТД.СтавкаНДС)/100;
						ТД.НДС = ТД.Всего*Ставка/(1+Ставка);
						ТД.Сумма = ТД.Всего - ТД.НДС;
						ТД.Цена = _сф.БезопасноРазделить(ТД.Сумма,ТД.Количество);
					Иначе
						Если ЗначениеЗаполнено(ТД.СтавкаНДС) Тогда
							Ставка = CW_Финансы.ПолучитьСтавкуНДС(ТД.СтавкаНДС)/100;
							ТД.Цена = Цена/(1+Ставка);
						КонецЕсли; 
					КонецЕсли; 
				Иначе
					Если ЗначениеЗаполнено(ТД.СтавкаНДС) И ЗначениеЗаполнено(ТД.Количество) Тогда
						ТД.Цена = Цена;
						ТД.Сумма = ТД.Цена * ТД.Количество;
						ТД.НДС = ТД.Сумма * CW_Финансы.ПолучитьСтавкуНДС(ТД.СтавкаНДС)/100;
						ТД.Всего = ТД.Сумма + ТД.НДС;
					Иначе
						
						ТД.Цена = Цена;
					КонецЕсли; 
				КонецЕсли;
				
			КонецЕсли; 
		КонецЕсли; 
	КонецЕсли; 
	
	ПересчитатьСтрокуНаСерере(СтрокаТЧ.ПолучитьИдентификатор(),Объект.ЦенаСНДС);
	
КонецПроцедуры

&НаКлиенте
Процедура УслугиНоменклатураНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	Если Не ЕстьОграниченияПоСпискуУслуг Тогда
		
		ВыбранноеЗначение = Элементы.Услуги.ТекущиеДанные.Номенклатура;	
		_УФК.ВыбратьНоменклатуру(ВыбранноеЗначение,Элемент,ДанныеВыбора,СтандартнаяОбработка);
		
	ИначеЕсли Элемент.СписокВыбора.Количество() = 0 Тогда
		
		Сообщение = новый СообщениеПользователю;
		Сообщение.Текст   		= "Не определен список услуг по договору!";
		Сообщение.ПутьКДанным  	= "Объект";
		Сообщение.Поле    		= "Договор";
		Сообщение.Сообщить();
		
	Конецесли;
	
	
КонецПроцедуры

&НаКлиенте
Процедура УслугиПредставлениеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка=Ложь;
	_УслугиПредставлениеНачалоВыбора(Элементы.Услуги.ТекущаяСтрока);
	Элементы.Услуги.ТекущийЭлемент = Элементы.УслугиПорядокОтражения;
	Элементы.Услуги.ТекущийЭлемент = Элементы.УслугиПредставление;
	
КонецПроцедуры

