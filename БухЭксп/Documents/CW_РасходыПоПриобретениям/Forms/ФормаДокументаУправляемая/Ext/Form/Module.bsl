&НаСервере
Процедура _ОбновитьАкты()
	
	Если НЕ Объект.ПредъявленСчет Тогда
		
		Возврат;
		
	КонецЕсли; 
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	CW_СоответствиеАктовВходящимСчетам.Акт,
	               |	CW_СоответствиеАктовВходящимСчетам.СчетУчетаЗадолженности,
	               |	CW_СоответствиеАктовВходящимСчетам.Сумма,
	               |	CW_СоответствиеАктовВходящимСчетам.НДС,
	               |	CW_СоответствиеАктовВходящимСчетам.Всего,
	               |	""                              "" КАК Номер,
	               |	ДАТАВРЕМЯ(1, 1, 1) КАК Дата,
	               |	CW_СоответствиеАктовВходящимСчетам.Акт.ПредставлениеДокумента КАК Представление
	               |ИЗ
	               |	РегистрСведений.CW_СоответствиеАктовВходящимСчетам КАК CW_СоответствиеАктовВходящимСчетам
	               |ГДЕ
	               |	CW_СоответствиеАктовВходящимСчетам.Счет = &Счет";
	Запрос.УстановитьПараметр("Счет", Объект.Ссылка);
	ТЗ = Запрос.Выполнить().Выгрузить(); 
	Для каждого Стр Из ТЗ Цикл
		Стр.Номер = СокрЛП(?(Стр.Акт.ПредъявленАкт,Стр.Акт.НомерАкта,Стр.Акт.НомерСФ));
		Стр.Дата = ?(Стр.Акт.ПредъявленАкт,Стр.Акт.ДатаАкта,Стр.Акт.ДатаСФ);
		Стр.Представление = ?(Стр.Акт.ПредъявленАкт,"Акт №","С/ф №")+Строка(Стр.Номер)+" от "+Формат(Стр.Дата,"ДФ=dd.MM.yyyy");
	КонецЦикла; 
	ТЗ.Сортировать("Дата Возр");
	
	ТаблицаАктов.Загрузить(ТЗ);
	Для Каждого СтрТА из ТаблицаАктов Цикл
		СтрТА.Картинка = БиблиотекаКартинок.CW_ПроведенныйДокумент;
	КонецЦикла;	
	
	ТА = ТЗ.Скопировать(,"Акт");
	ТА.Свернуть("Акт");
	КоличествоАктов = ТА.Количество();
	Элементы.СтраницаАкты.Заголовок = "Акты"+?(КоличествоАктов=0,""," ("+Строка(КоличествоАктов)+")");
	
КонецПроцедуры


