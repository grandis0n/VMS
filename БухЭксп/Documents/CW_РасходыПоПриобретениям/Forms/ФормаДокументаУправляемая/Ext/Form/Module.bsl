&НаКлиенте
Процедура ОбработкаВыбораКурса(Ответ, ДополнительныеПараметры) Экспорт 
	// --- 
	
	Если (Ответ <> Неопределено) Тогда
		
		Объект.УЕ_ПользовательскийКурс = Ответ.ПользовательскийКурс;
		Если (Объект.УЕ_ПользовательскийКурс) Тогда
			Объект.УЕ_Курс = Ответ.Курс;
			Объект.УЕ_Кратность = Ответ.Кратность;
		Иначе
			Объект.УЕ_Курс = 1;
			Объект.УЕ_Кратность = 1;
		КонецЕсли;
		// --- 
		_СформироватьКурс();
				
	КонецЕсли; 
	
	// --- 
КонецПроцедуры

