КонецПроцедуры

&НаКлиенте
Процедура ДатаСчетаОчистка(Элемент, СтандартнаяОбработка)
	
	ДатаСчетаПриИзмененииНаКлиенте();

КонецПроцедуры

&НаКлиенте
Процедура ДатаСчетаПриИзмененииНаКлиенте()
	
	Если ЗначениеЗаполнено(Объект.ДатаСчета) Тогда
		УстановитьСрокОплатыНаСервере();		
	КонецЕсли;
	_ОбновитьНомераДокументов();
	
	ПервичныеДокументыУправлениеЭлементамиФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура ПервичныеДокументыВремяСчета(Команда)
	
	ДополнительныеПараметры = Новый Структура("НачальнаяДата", Объект.ДатаСчета);
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ОбработкаИзмененияДатыСчета",ЭтотОбъект, ДополнительныеПараметры); 
	ПоказатьВводДаты(ОписаниеОповещения,Объект.ДатаСчета,"Время счёта",ЧастиДаты.Время);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаИзмененияДатыСчета(РезультатВыбора, ДополнительныеПараметры) Экспорт 
	
	Если РезультатВыбора = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// переносим введённое время в дату акта
	ДатаСчетаСтрокой 	= Формат(ДополнительныеПараметры.НачальнаяДата,"ДФ=yyyyMMdd");
	ВремяСчетаСтрокой 	= Формат(РезультатВыбора,"ДФ=HHmmss");
	
	Объект.ДатаСчета = Дата(ДатаСчетаСтрокой+ВремяСчетаСтрокой);
	
КонецПроцедуры

&НаКлиенте
Процедура ПервичныеДокументыДатаСчета(Команда)

	Если Объект.Ссылка.Пустая() Тогда
		ПоказатьПредупреждение(,"Документ не записан!");
		Возврат;
	КонецЕсли;
	
	Объект.ДатаСчета = Объект.Дата;
	
	УстановитьСрокОплатыНаСервере();
	
	_ОбновитьНомераДокументов();

КонецПроцедуры

&НаСервере
Процедура УстановитьСрокОплатыНаСервере()

	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("Ссылка"		, Объект.Ссылка);
	СтруктураПараметров.Вставить("Договор"		, Объект.Договор);
	СтруктураПараметров.Вставить("Дата"			, Объект.Дата);
	СтруктураПараметров.Вставить("ДатаСчета"	, Объект.ДатаСчета);
	СтруктураПараметров.Вставить("ЕстьСчет"		, Объект.ПредъявленСчет);
	СтруктураПараметров.Вставить("ЕстьАкт"		, Ложь);
	
	//Подсистема.УчетПриложенийДоговоров
	Если ЗначениеЗаполнено(Объект.ПриложениеКДоговору) Тогда
		СтруктураПараметров.Вставить("Договор"		, Объект.ПриложениеКДоговору);
	КонецЕсли;
	//Подсистема.УчетПриложенийДоговоров
	
	ДатаОплаты = CW_Документы.РассчитатьСрокОплаты(СтруктураПараметров);
	
	ПараметрыСрокаОплаты = Новый Структура;
	ПараметрыСрокаОплаты.Вставить("Счет", 		Объект.Ссылка);
	ПараметрыСрокаОплаты.Вставить("ДатаОплаты", ДатаОплаты);
	ПараметрыСрокаОплаты.Вставить("Описание", 	"");
	
	CW_Документы.УстановитьСрокОплаты(ПараметрыСрокаОплаты);
	
	УстановитьОписаниеСрокаОплаты();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьОписаниеСрокаОплаты()
	
	Текст = "<не установлен>";
	
	Если ЗначениеЗаполнено(_СрокОплаты) Тогда
		Текст = Формат(_СрокОплаты,"ДФ=dd.MM.yyyy");
		Если СокрЛП(_СрокОплатыОписание) <> "" Тогда
			Текст = Текст + " ("+СокрЛП(_СрокОплатыОписание)+")";
		КонецЕсли; 
	Иначе
		Если Не _СрокОплатыРучноеРедактирование Тогда
			Текст = "<авто>";
		КонецЕсли; 
	КонецЕсли;	
	
	СрокОплаты = Текст;
			
КонецПроцедуры

&НаКлиенте
Процедура СпособЗачетаАвансовОЗПриИзменении(Элемент)
	
	СпособЗачетаАвансовОЗПриИзмененииНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура СпособЗачетаАвансовОЗПриИзмененииНаСервере()
	
	// очистили значение
	Если Не ЗначениеЗаполнено(Объект.СпособЗачетаАвансовОЗ) Тогда
		Объект.СпособЗачетаАвансовОЗ = ПредопределенноеЗначение("Перечисление.СпособыЗачетаАвансов.НеЗачитывать"); 
	КонецЕсли; 
	
	// если не по документу, то очищаем таблицу зачета авансов
	Если Объект.СпособЗачетаАвансовОЗ <> ПредопределенноеЗначение("Перечисление.СпособыЗачетаАвансов.ПоДокументу") Тогда
		Объект.ЗачетАвансовОЗ.Очистить();
	КонецЕсли; 
	
	// регенерация формы
	_УправлениеЭлементамиФормы();	
	
	// регенерируем форму
	ПервичныеДокументыУправлениеЭлементамиФормы();

КонецПроцедуры


&НаКлиенте
Процедура СрокОплатыНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ПараметрыФормыСрокаОплаты = Новый Структура;
	ПараметрыФормыСрокаОплаты.Вставить("Документ", 				Объект.Ссылка); 
	
	ПараметрыФормыСрокаОплаты.Вставить("ДатаОплаты",			_СрокОплаты);
	ПараметрыФормыСрокаОплаты.Вставить("Описание",				_СрокОплатыОписание);
	ПараметрыФормыСрокаОплаты.Вставить("РучноеРедактирование",	_СрокОплатыРучноеРедактирование);
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ОбработатьИзменениеСрокаОплаты",ЭтотОбъект); 

	ОткрытьФорму("ОбщаяФорма.CW_СрокОплаты", ПараметрыФормыСрокаОплаты,ЭтаФорма,,,,ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьИзменениеСрокаОплаты(РезультатВыбора, ДополнительныеПараметры) Экспорт
	
	Если РезультатВыбора = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	РезультатВыбора.Свойство("ДатаОплаты",   		 _СрокОплаты);
	РезультатВыбора.Свойство("Описание",  			 _СрокОплатыОписание);
	РезультатВыбора.Свойство("РучноеРедактирование", _СрокОплатыРучноеРедактирование);

	УстановитьОписаниеСрокаОплаты();
	
КонецПроцедуры

&НаКлиенте
Процедура ПервичныеДокументыСрокОплаты(Команда)
	Если Объект.Ссылка.Пустая() Тогда
		ПоказатьПредупреждение(,"Документ не записан!");
		Возврат;
	КонецЕсли;
	
	УстановитьСрокОплатыНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ПланОплатыНажатие(Элемент, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	
	Если Объект.Ссылка.Пустая() Тогда
		ПоказатьПредупреждение(, "План оплаты можно установить только для записанного документа.");
	Иначе
		
		Представление = "Счёт №"+СокрЛП(Объект.НомерСчета)+" от "+Формат(Объект.ДатаСчета,"ДФ=dd.MM.yyyy")+" ("+Строка(Объект.Контрагент)+")";
		
		ОписаниеОповещения = Новый ОписаниеОповещения("ОбработкаИзмененияПланаОплаты",ЭтотОбъект); 
		
		ПараметрыФормыПланаОплаты = Новый Структура;
		ПараметрыФормыПланаОплаты.Вставить("Документ", Объект.Ссылка);
		ПараметрыФормыПланаОплаты.Вставить("ПредставлениеДокумента", Представление);
	
		ОткрытьФорму("ОбщаяФорма.CW_ПлановыйСрокОплаты",ПараметрыФормыПланаОплаты,ЭтаФорма,,,,ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаИзмененияПланаОплаты(Ответ, ДополнительныеПараметры) Экспорт
	
	УстановитьОписаниеПланОплаты();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьОписаниеПланОплаты()
	
	Текст = "<не установлен>";

	ДанныеПланаОплаты = CW_Документы.ПолучитьПланОплаты(Объект.Ссылка);
	Если Не ЗначениеЗаполнено(ДанныеПланаОплаты.Дата) и НЕ ПустаяСтрока(ДанныеПланаОплаты.Примечание) Тогда
		Текст = "<...>";
	ИначеЕсли ЗначениеЗаполнено(ДанныеПланаОплаты.Дата) Тогда
		Текст = Формат(ДанныеПланаОплаты.Дата,"ДФ=dd.MM.yyyy");
	КонецЕсли;
	
	Если Не ПустаяСтрока(ДанныеПланаОплаты.Примечание) Тогда
		Текст = Текст + " ("+СокрЛП(ДанныеПланаОплаты.Примечание)+")";
	КонецЕсли; 
	
	ПланОплаты = Текст;

	_ОбновитьНомераДокументов();
	
КонецПроцедуры

&НаСервере
Процедура ПервичныеДокументыПриСозданииНаСервере()
	
	РедактированиеФинансов_Расходы_Счета 	= CW_ПраваДоступа.ПравоДоступно("РедактированиеФинансов_Расходы_Счета");
	
	// план оплаты определяем всегда, но визуализируем только при предъявлении счета 
	// и ведения оперативной задолженности
	УстановитьОписаниеПланОплаты();;
	
	// добавлено CW (КС)..
	//--------------------
	УстановитьОписаниеСрокаОплаты();
	
		
	УстановитьПривилегированныйРежим(Истина);
	ГруппаПользователя = CW_ПраваДоступа_ПИ.ГруппаПользователя(ПараметрыСеанса.ТекущийПользователь);
	УстановитьПривилегированныйРежим(Ложь);
	
	СрокОплатыДоступен = 	ГруппаПользователя = Справочники.CW_ГруппыПользователей.Администраторы 
							Или ГруппаПользователя.РедактированиеСроковОплатыИсходящихСчетов
							Или ГруппаПользователя.ПолныеПрава;
	ПланОплатыДоступен = 	ГруппаПользователя = Справочники.CW_ГруппыПользователей.Администраторы 
							Или ГруппаПользователя.РедактированиеФинансов_Доходы_Счета
							Или ГруппаПользователя.ПолныеПрава;
							
	// если формирование ведомых документов установлено датой ведущего документа,
	// то время акта не требуется и кнопку для определения времени можно скрыть
	Элементы.ПервичныеДокументыВремяСчета.Видимость = Объект.ФормироватьВедомыеДатойДокумента;
	
	Элементы.ГруппаСчет.Доступность 	= РедактированиеФинансов_Расходы_Счета;
	
	КонтрольДокументовПоСумме = CW_Настройки.ПолучитьНастройкуПользователя(CW_Настройки.Пользователь(),"КонтрольВходящихДокументовПоСумме");
	Если КонтрольДокументовПоСумме = Неопределено Тогда
		КонтрольДокументовПоСумме = Ложь;
	КонецЕсли; 
	Элементы.ГруппаКонтрольнаяСумма.Видимость = КонтрольДокументовПоСумме;
	
	Элементы.ГруппаКонтрольнаяСумма.Доступность =Объект.ПредъявленСчет и РедактированиеФинансов_Расходы_Счета;
	
	ПервичныеДокументыУправлениеЭлементамиФормы();

	
	
КонецПроцедуры

&НаСервере
Процедура ПервичныеДокументыУправлениеЭлементамиФормы()
	
	// счет
	Элементы.ПредъявленСчет.Доступность = РедактированиеФинансов_Расходы_Счета;
	Элементы.НомерСчета.ТолькоПросмотр 	= НЕ Объект.ПредъявленСчет ИЛИ НЕ РедактированиеФинансов_Расходы_Счета;
	Элементы.ДатаСчета.ТолькоПросмотр 	= НЕ Объект.ПредъявленСчет ИЛИ НЕ РедактированиеФинансов_Расходы_Счета;
	Элементы.ПервичныеДокументыДатаСчета.Доступность = Объект.ПредъявленСчет И РедактированиеФинансов_Расходы_Счета;
	Элементы.СрокОплаты.Доступность = Объект.ПредъявленСчет И СрокОплатыДоступен; 	
	Элементы.ПервичныеДокументыСрокОплаты.Доступность 	= Объект.ПредъявленСчет И СрокОплатыДоступен; 
	Элементы.СпособЗачетаАвансовОЗ.Видимость = Объект.ПредъявленСчет И ОперативныйУчет И НЕ Объект.Корректировка;
	
	// план оплаты
	Элементы.ПланОплаты.Видимость = Объект.ПредъявленСчет И ОперативныйУчет И ПланОплатыДоступен И НЕ Объект.Корректировка;
	
	// срок оплаты
	Элементы.СрокОплаты.Видимость = Объект.ПредъявленСчет И СрокОплатыДоступен И НЕ Объект.Корректировка; 
	Элементы.ПервичныеДокументыСрокОплаты.Видимость = Объект.ПредъявленСчет И СрокОплатыДоступен И НЕ Объект.Корректировка;
	
КонецПроцедуры

&НаКлиенте
Процедура ФормироватьВедомыеДатойДокументаПриИзменении(Элемент)
	
	// необходимо обновить параметры учётной политики и параметры договора
	_СформироватьОбщиеПараметры("ПараметрыДоговора,УчетнаяПолитика");

КонецПроцедуры

//Первичные документы