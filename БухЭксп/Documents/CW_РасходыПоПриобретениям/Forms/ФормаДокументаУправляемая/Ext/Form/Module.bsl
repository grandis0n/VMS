&НаСервере
Процедура _КонтрагентПриИзменении()
	
	// если очистили контрагента, то очищаем и договор
	Если Не ЗначениеЗаполнено(Объект.Контрагент) Тогда
		Объект.Договор = Неопределено;
		Возврат;	
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.Контрагент) И (Объект.Договор.Владелец = Объект.Контрагент) Тогда 
		// нечего менять
	Иначе 
		Объект.Договор = CW_Документы.ПолучитьПоследнийДоговор(Объект.Контрагент, Объект.Организация, Перечисления.ВидыДоговоровКонтрагентов.Прочее);
		_ОбработатьИзменениеДоговора();
	КонецЕсли;
	
	//Подсистема.УчетПриложенийДоговоров
	CW_УчетПриложенийДоговоровСервер.ПриИзмененииКонтрагентаНаСервере(ЭтаФорма);
	//Подсистема.УчетПриложенийДоговоров
	
КонецПроцедуры

