&НаСервере
Функция _УдалитьВедомыйСчет()
	// --- 
	
	Если (НЕ Объект.ВедомыйСчет.ПометкаУдаления) Тогда
		УстановитьПривилегированныйРежим(Истина);
		Ведомый = Объект.ВедомыйСчет.ПолучитьОбъект();
		Ведомый.УстановитьПометкуУдаления(Истина);	
	КонецЕсли; 
	// --- 
	Объект.ВедомыйСчет = Неопределено;
	
	// --- 
КонецФункции

&НаСервере
Функция _УдалитьВедомый()
	// --- 
	
	Если (НЕ Объект.ВедомыйДокумент.ПометкаУдаления) Тогда
		УстановитьПривилегированныйРежим(Истина);
		Ведомый = Объект.ВедомыйДокумент.ПолучитьОбъект();
		Ведомый.УстановитьПометкуУдаления(Истина);	
	КонецЕсли;
	// --- 
	Объект.ВедомыйДокумент = Неопределено;
	Объект.ВедомыйСчетФактура = Неопределено;
	
	// --- 
КонецФункции

&НаСервере
Функция _УдалитьВедомыйСчетФактуру()
	// --- 
	
	Если (НЕ Объект.ВедомыйСчетФактура.ПометкаУдаления) Тогда
		УстановитьПривилегированныйРежим(Истина);
