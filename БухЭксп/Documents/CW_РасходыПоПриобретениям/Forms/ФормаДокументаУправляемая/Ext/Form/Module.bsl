&НаСервере
Процедура _ОбработатьИзменениеДоговора()
	
	_СформироватьОбщиеПараметры();

	Если Не ЗначениеЗаполнено(Объект.Договор) Тогда
		Возврат;		
	КонецЕсли;
	
	//Подсистема.УчетПриложенийДоговоров
	Объект.Валюта = CW_УчетПриложенийДоговоровСервер.ПолучитьВалютуПриложенияДОговора(Объект.ПриложениеКДоговору, Объект.Договор);
	//Подсистема.УчетПриложенийДоговоров
	
	Объект.ЗачетАвансов.Очистить();
	Объект.ПлатёжноРасчётныеДокументы.Очистить();
	_ПараметрыДоговора = _ДС().ПД;
	
	Если НЕ Объект.Договор.Пустая() Тогда
		СтруктураПараметровБухУчета = Новый Структура;
		СтруктураПараметровБухУчета.Вставить("Договор", 				Объект.Договор);
		СтруктураПараметровБухУчета.Вставить("ПриложениеКДоговору",		Объект.ПриложениеКДоговору);
		
		ПараметрыБухгалтерскогоУчета = CW_Финансы.ПолучитьПарметрыВеденияБухгалтерскогоУчета(СтруктураПараметровБухУчета, Объект.Дата);
	
		ВзаиморасчетыВУЕ		= ПараметрыБухгалтерскогоУчета.ВзаиморасчетыВУЕ;	
		
		Если ЗначениеЗаполнено(_ПараметрыДоговора.ПорядокЗачетаАвансов) Тогда
			Объект.СпособЗачетаАвансов = _ПараметрыДоговора.ПорядокЗачетаАвансов;
		КонецЕсли;

		Если ЗначениеЗаполнено(_ПараметрыДоговора.ПорядокЗачетаАвансовОЗ) Тогда
			Объект.СпособЗачетаАвансовОЗ = _ПараметрыДоговора.ПорядокЗачетаАвансовОЗ;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(_ПараметрыДоговора.ПорядокЗаполненияРасчётноПлатёжныхДокументовСФ) Тогда
			Объект.ПорядокЗаполненияРасчётноПлатёжныхДокументовСФ = _ПараметрыДоговора.ПорядокЗаполненияРасчётноПлатёжныхДокументовСФ;
		Иначе
			Объект.ПорядокЗаполненияРасчётноПлатёжныхДокументовСФ = Перечисления.CW_ПорядокЗаполненияРасчётноПлатёжныхДокументовСФ.НеУчитывать;
		КонецЕсли;
		
		Если (НЕ ПараметрыБухгалтерскогоУчета.БухгалтерскийУчет) Тогда
			Объект.СпособЗачетаАвансов = Перечисления.СпособыЗачетаАвансов.НеЗачитывать;
		КонецЕсли; 
		
		Объект.ЭтоУниверсальныйДокумент = _ПараметрыДоговора.ИспользуетсяУниверсальныйДокумент;
	
		РасчитатьСрокОплатыДокумента();
		_СформироватьКурс();
		
	КонецЕсли; 
	
	АдресУслугПоДоговору = "";
	Если ОграничиватьУслугиПоДоговорам Тогда
		ЕстьОграниченияПоСпискуУслуг =?(ЗначениеЗаполнено(Объект.Договор), Объект.Договор.ОграничиватьНоменклатуру, Ложь);
		
		Если ЕстьОграниченияПоСпискуУслуг тогда
			ДатаДокумента = Объект.Дата;
			Если Объект.ПредъявленСчет 
				И ЗначениеЗаполнено(Объект.ДатаСчета) Тогда
				ДатаДокумента = Объект.ДатаСчета;  
			КонецЕсли;      
			АдресУслугПоДоговору = _УФС.ОбновитьСписокУслугПоДоговору(ДатаДокумента, Объект.Договор, ЭтаФорма);
		КонецЕсли;
	КонецЕсли;
	
	СтруктураДанных = новый Структура;
	СтруктураДанных.Вставить("АдресУслугПоДоговору"			, АдресУслугПоДоговору);
	СтруктураДанных.Вставить("ЭлементФормы"					, Элементы.УслугиНоменклатура);
	СтруктураДанных.Вставить("ЕстьОграниченияПоСпискуУслуг"	, ЕстьОграниченияПоСпискуУслуг);
	
	_УФС.УстановитьСписокУслуг(СтруктураДанных);
	
	//Подсистема.УчетПриложенийДоговоров
	CW_УчетПриложенийДоговоровСервер.ПриИзмененииДоговораНаСервере(ЭтаФорма);
	//Подсистема.УчетПриложенийДоговоров
	
	УстановитьЗаголовокНадписиКомментарияДоговора();
	_УправлениеЭлементамиФормы();
	
	// --- 
КонецПроцедуры

