&НаКлиенте
Процедура Услуги_ГрупповоеРедактирование(Команда)
	
	// если нет выделенных строк
	Если Элементы.Услуги.ВыделенныеСтроки.Количество() = 0 Тогда
		Предупреждение("Для групповой обработки необходимо выделить строки!",10,"Предупреждение");
		Возврат;
	КонецЕсли; 
	
	// параметры для открываемой формы
	ПФ = Новый Структура();
	ПФ.Вставить("Организация", Объект.Организация);
	ПФ.Вставить("ДатаДокумента", ?(ЗначениеЗаполнено(Объект.Дата), Объект.Дата, ТекущаяДата()));
	ПФ.Вставить("Строк", Элементы.Услуги.ВыделенныеСтроки.Количество());
	ПФ.Вставить("Док", "Расходы");
	
	// передадим имя реквизита (колонки) на котором установлен курсор и его значение
	#Область ОбластьТекущаяКолонка
	
		// вырезаем из имени реквизита название таблицы (первые 6 символов это слово "Услуги")
		ИмяРеквизитаТабличнойЧасти = Сред(Элементы.Услуги.ТекущийЭлемент.Имя,7);
		
		// если реквизит "Покупатель" или "ДоговорПокупателя",
		// то в процедуру передаем как "Покупатель"
		Если ИмяРеквизитаТабличнойЧасти = "Покупатель" или ИмяРеквизитаТабличнойЧасти = "ДоговорПокупателя" Тогда
			ПФ.Вставить("ТекущийРеквизит","Покупатель");
			ПФ.Вставить("ТекущееЗначение",Элементы.Услуги.ТекущиеДанные["Покупатель"]);
			ПФ.Вставить("ТекущееЗначениеДополнительное",Элементы.Услуги.ТекущиеДанные["ДоговорПокупателя"]);
		Иначе
			ПФ.Вставить("ТекущийРеквизит",ИмяРеквизитаТабличнойЧасти);
			ПФ.Вставить("ТекущееЗначение",Элементы.Услуги.ТекущиеДанные[ИмяРеквизитаТабличнойЧасти]);
			ПФ.Вставить("ТекущееЗначениеДополнительное",Неопределено);
		КонецЕсли; 
	#КонецОбласти 
	
	ПФ.Вставить("ЦенаСНДС"						, Объект.ЦенаСНДС);

	// открываем диалог для выбора действия	
	ПОВ = Новый ОписаниеОповещения("ОбработатьГрупповоеРедактирование", ЭтотОбъект);
	ОткрытьФорму("ОбщаяФорма.CW_ФормаГрупповогоРедактированияТЧ", ПФ, Этаформа,,,, ПОВ, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьГрупповоеРедактирование(Ответ, ДопПар) Экспорт
	
	Если Ответ = Неопределено Тогда
		Возврат;
	ИначеЕсли НЕ ЗначениеЗаполнено(Ответ.Реквизит) Тогда
		Возврат;		
	Иначе	
		Реквизит = Ответ.Реквизит;
	КонецЕсли;
	
	мВС = Элементы.Услуги.ВыделенныеСтроки;
	КолСтр = мВС.Количество();
	Распределять = Ложь;
	Разница = 0;
	Если Ответ.Свойство("Распределить") Тогда
		Если Ответ.Распределить Тогда
			Распределять = Истина;
			Сумма = Окр(_сф.БезопасноРазделить(Ответ.Значение,КолСтр), 2,1);
			Разница = Ответ.Значение - Сумма * КолСтр;
		Иначе
			Сумма = Ответ.Значение;
		КонецЕсли;
	КонецЕсли;	
	
	Для Каждого ВСтр из мВС Цикл 
		Стр = Объект.Услуги.НайтиПоИдентификатору(ВСтр);
		
		Если Реквизит = "Номенклатура" Тогда
			Стр.Номенклатура = Ответ.Значение;
			_УслугиНоменклатураПриИзменении(ВСтр);
			
		ИначеЕсли Реквизит = "СтатьяЗатрат" Тогда
			
			Стр.СтатьяЗатрат = Ответ.Значение;
			
		ИначеЕсли Реквизит = "Клиент / Договор" Тогда
			Если Стр.ПорядокОтражения = ПредопределенноеЗначение("Перечисление.CW_ПорядокОтраженияЗатрат.Перевыставление") Тогда
				Стр.Покупатель = Ответ.Значение;
				Стр.ДоговорПокупателя = Ответ.Договор;
			Иначе
				Стр.Покупатель = Неопределено;
				Стр.ДоговорПокупателя = Неопределено;
			КонецЕсли; 
		ИначеЕсли Реквизит = "Количество" Тогда
			Стр.Количество = Ответ.Значение;
			ПересчитатьСтрокуНаСерере(ВСтр,Объект.ЦенаСНДС);
		ИначеЕсли Реквизит = "Цена" Тогда
			Стр.Цена = Сумма;
			ПересчитатьСтрокуНаСерере(ВСтр,Объект.ЦенаСНДС);
		ИначеЕсли Реквизит = "Сумма" Тогда
			Стр.Сумма = Сумма;
			Стр.Цена = _сф.БезопасноРазделить(Стр.Сумма, Стр.Количество);
			Ставка = CW_Финансы.ПолучитьСтавкуНДС(Стр.СтавкаНДС);
			Стр.НДС = CW_Финансы.РассчитатьСуммуНДС(Стр.Сумма, Истина, Ложь, Ставка);
			Стр.Всего = Стр.Сумма + Стр.НДС;
			ПересчитатьСтрокуНаСерере(ВСтр,Объект.ЦенаСНДС, Истина);
		ИначеЕсли Реквизит = "Ставка НДС" Тогда
			Стр.СтавкаНДС = Ответ.Значение;
			ПересчитатьСтрокуНаСерере(ВСтр,Объект.ЦенаСНДС);
		ИначеЕсли Реквизит = "Сумма НДС" Тогда
			Стр.НДС = Сумма;
			Если НЕ _ДС().НП.ОбратныйПересчетВДокументах Тогда
				Стр.Всего = Стр.Сумма + Стр.НДС;
			Иначе
				Стр.Сумма = Стр.Всего - Стр.НДС;
				Стр.Цена  = _сф.БезопасноРазделить(Стр.Сумма, Стр.Количество);
			КонецЕсли;
			ПересчитатьСтрокуНаСерере(ВСтр,Объект.ЦенаСНДС, Истина);
		ИначеЕсли Реквизит = "Всего" Тогда
			Стр.Всего = Сумма;
			Ставка = CW_Финансы.ПолучитьСтавкуНДС(Стр.СтавкаНДС)/100;
			Стр.НДС   = Стр.Всего * Ставка / (1 + Ставка);
			Стр.Сумма = Стр.Всего - Стр.НДС;
			Стр.Цена  = _сф.БезопасноРазделить(Стр.Сумма, Стр.Количество);
			ПересчитатьСтрокуНаСерере(ВСтр,Объект.ЦенаСНДС, Истина);
		ИначеЕсли Реквизит = "Представление" Тогда
			ДополнитьПредставление 	= Ложь;
			Если Ответ.Свойство("Дополнять") Тогда
				ДополнитьПредставление = Ответ.Дополнять;
			КонецЕсли;
			
			Если ДополнитьПредставление Тогда
				Стр.Представление = Стр.Представление + СокрП(Ответ.Значение);
			Иначе
				Стр.Представление = СокрЛП(Ответ.Значение);
			КонецЕсли;
		КонецЕсли;	
	КонецЦикла;	
	
	Если Распределять И Разница <> 0 Тогда
		Если Реквизит = "Цена" Тогда
			Стр.Цена = Сумма + Разница;
			ПересчитатьСтрокуНаСерере(ВСтр,Объект.ЦенаСНДС);
		ИначеЕсли Реквизит = "Сумма" Тогда
			Стр.Сумма = Сумма + Разница;
			Стр.Цена = _сф.БезопасноРазделить(Стр.Сумма, Стр.Количество);
			Ставка = CW_Финансы.ПолучитьСтавкуНДС(Стр.СтавкаНДС);
			Стр.НДС = CW_Финансы.РассчитатьСуммуНДС(Стр.Сумма, Истина, Ложь, Ставка);
			Стр.Всего = Стр.Сумма + Стр.НДС;
			ПересчитатьСтрокуНаСерере(ВСтр,Объект.ЦенаСНДС, Истина);
		ИначеЕсли Реквизит = "Сумма НДС" Тогда
			Стр.НДС = Сумма + Разница;
			Если НЕ _ДС().НП.ОбратныйПересчетВДокументах Тогда
				Стр.Всего = Стр.Сумма + Стр.НДС;
			Иначе
				Стр.Сумма = Стр.Всего - Стр.НДС;
				Стр.Цена  = _сф.БезопасноРазделить(Стр.Сумма, Стр.Количество);
			КонецЕсли;
			ПересчитатьСтрокуНаСерере(ВСтр,Объект.ЦенаСНДС, Истина);
		ИначеЕсли Реквизит = "Всего" Тогда
			Стр.Всего = Сумма + Разница;
			Ставка = CW_Финансы.ПолучитьСтавкуНДС(Стр.СтавкаНДС)/100;
			Стр.НДС   = Стр.Всего * Ставка / (1 + Ставка);
			Стр.Сумма = Стр.Всего - Стр.НДС;
			Стр.Цена  = _сф.БезопасноРазделить(Стр.Сумма, Стр.Количество);
			ПересчитатьСтрокуНаСерере(ВСтр,Объект.ЦенаСНДС, Истина);
		КонецЕсли;	
	КонецЕсли;	
	
	ОбновитьИтогиПоУслугам();
	
КонецПроцедуры	
	
