#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
	
Перем ДС Экспорт;
Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	
	CW_Документы.ЗаполнениеДокументов(ЭтотОбъект);

КонецПроцедуры

Процедура ПриУстановкеНовогоНомера(СтандартнаяОбработка, Префикс)
	
	Префикс = CW_Документы.ПрефиксОрганизации(Организация);	
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	// сбрасываем параметры, подлежащие определению для нового документа
	Ответственный = CW_Настройки.Пользователь();
	ЗачетАвансов.Очистить();
	ЗачетАвансовОЗ.Очистить();
	
	// учитываем опции, установленные у пользователя
	НП = CW_Настройки.ПолучитьНастройкиПользователя();
	УстанавливатьТекущееВремя = НП.ПриКопированниУстанавливатьТекущееВремя;
	Если (УстанавливатьТекущееВремя = Неопределено) Тогда
		УстанавливатьТекущееВремя = Ложь;
	КонецЕсли; 
	Если (УстанавливатьТекущееВремя) Тогда
		Дата = CW_Документы.РабочееВремя();
	КонецЕсли; 
	ОчищатьСведенияПервичныхДокументов = НП.ОчищатьСведенияОПервичныхДокументахПриКопированииРасходов;
	Если (ОчищатьСведенияПервичныхДокументов = Неопределено) Тогда
		ОчищатьСведенияПервичныхДокументов = Ложь;
	КонецЕсли;
	//СрокОплаты = Дата(1,1,1);
	//СрокОплатыОписание = "";
	Если (ОчищатьСведенияПервичныхДокументов) Тогда
		
		ПредъявленСчет = Ложь;
		НомерСчета = "";
		ДатаСчета = Дата(1,1,1);
		// --- 
		ПредъявленАкт = Ложь;
		НомерАкта = "";
		ДатаАкта = Дата(1,1,1);
		// --- 
		ПредъявленСФ = Ложь;
		НомерСФ = "";
		ДатаСФ = Дата(1,1,1);		
		
	КонецЕсли; 
	
	ПлатёжноРасчётныеДокументы.Очистить();
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	Если (ОбменДанными.Загрузка) Тогда Возврат; КонецЕсли;
	// --- 
	ПроверяемыеРеквизиты.Очистить();
	
	флОшибка = Ложь;
	МассивСообщений = Новый Массив;
	
	Для Каждого Стр Из Услуги Цикл
		
		Если CW_Настройки.ПолучитьНастройкуПользователя(, "ПроверятьНоменклатурнуюГруппу") Тогда
			Если НЕ ЗначениеЗаполнено(Стр.Номенклатура.НоменклатурнаяГруппа) Тогда
				флОшибка = Истина;
				МассивСообщений.Добавить("У номенклатуры в строке " + Стр.НомерСтроки + " отсутствует номенклатурная группа!");
			КонецЕсли;
		КонецЕсли;	
		
	КонецЦикла;	
	
	Если флОшибка Тогда
		Для Каждого Стр Из МассивСообщений Цикл
			Сообщить(Стр, СтатусСообщения.Внимание);
		КонецЦикла; 
		
		Отказ = Истина;
		Возврат;
	КонецЕсли; 
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	_сф.ст_УстановитьСвойство(ДополнительныеСвойства,"СтатусПроведенияДоПроведения", Проведен);
	
	//Для версии КОРП 
	ВестиУчетПоПодразделениям = ПолучитьФункциональнуюОпцию("ВестиУчетПоПодразделениям");
	//Для версии КОРП 
	
	// обмен данными
	Если (ОбменДанными.Загрузка) Тогда
		Возврат; 
	КонецЕсли;
	
	// не перепроводим при восстановлении последовательности
	ВосстановлениеПоследовательности = _сф.ст_ПолучитьСвойство(ДополнительныеСвойства,"ПроведенВХронологическойПоследовательности");
	Если (ВосстановлениеПоследовательности <> Неопределено) Тогда
		Если (ВосстановлениеПоследовательности) Тогда
			Возврат;
		КонецЕсли; 
	КонецЕсли; 
	
	// контроль наличия общих параметров
	Если (НЕ ЗаполненыОбщиеПараметры()) Тогда 
		СформироватьОбщиеПараметры(,Ложь); 
	КонецЕсли; 
	
	// если изменились даты начала ведения учета, то обновим соответствующие флаги
	// (при условии того, что в документе указана организация и договор)
	ВводОстатковБУ = Ложь;
	ВводОстатковОЗ = Ложь;
	
	// фиксируем режим записи
	_сф.ст_УстановитьСвойство(ДополнительныеСвойства,"РежимЗаписи",РежимЗаписи);
	
	
	// сформируем представление
	СформироватьПредставлениеДокумента();
	
	// фиксируем сумму Всего и сумму НДС
	Если (НЕ Корректировка) Тогда
		СуммаДокумента 	= _сф.Итог(Услуги,"Всего");
		СуммаНДС		= _сф.Итог(Услуги,"НДС");	
	Иначе
		пСуммаДокумента = 0;
		пСуммаНДС = 0;
		
		Для каждого Стр Из Услуги Цикл
			_сф.Инкремент(пСуммаДокумента,Стр.Всего - Стр.Всего_ДоКорректировки);
			_сф.Инкремент(пСуммаНДС,Стр.НДС - Стр.НДС_ДоКорректировки);
		КонецЦикла; 
		
		СуммаДокумента = пСуммаДокумента;
		СуммаНДС = пСуммаНДС;
	КонецЕсли; 
	
	// ответственный
	_сф.УстановитьЕслиНезаполнено(Ответственный,CW_Настройки.Пользователь()); 
	
	// Контроль срока договора / приложения   
	СтруктураПараметров = CW_Документы.ПустаяСтруктураКонтроляСрокаДействияДоговора(); 
	СтруктураПараметров.КонтролироватьСрокДоговоров 	= ДС.НП.КонтролироватьСрокДоговоров;
	СтруктураПараметров.КонтролироватьСрокПриложения 	= ДС.НП.КонтролироватьСрокДействияПриложения; 
	
	CW_Документы.ПроверитьСрокДействияДоговора(ЭтотОбъект, СтруктураПараметров, Отказ);
	
	// для подстановки последнего договора записываем его в регистр
	CW_Документы.ЗаписатьПоследнийДоговор(Договор);
	
	// аналогично по строкам таб.части
	ТаблицаДоговоровКлиентов = _сф.т_СкопироватьСвернуть(Услуги.Выгрузить(),"ДоговорПокупателя");
	Для Каждого СтрокаДоговора Из ТаблицаДоговоровКлиентов Цикл
		CW_Документы.ЗаписатьПоследнийДоговор(СтрокаДоговора.ДоговорПокупателя);
	КонецЦикла;
 
	// синхронизация времени счета
	Если (ПредъявленСчет) Тогда
		Если (НачалоДня(ДатаСчета)=НачалоДня(Дата)) Тогда
			ДатаСчета = Дата;
		КонецЕсли; 	
	КонецЕсли; 
	
	//Подсистема.СтатусыДокументов
	СтатусДокумента = Неопределено;
	ЭтотОбъект.ДополнительныеСвойства.Свойство("СтатусДокумента", СтатусДокумента);
	
	СтатусДокументаПроводитьПоБухгалтерскомуУчету = CW_СтатусыДокументовСервер.ПолучитьПризнакПроведенияПоБухгалтерскомуУчету(Ссылка, СтатусДокумента);
	//Подсистема.СтатусыДокументов
	
	СтруктураПараметровБухУчета = Новый Структура;
	СтруктураПараметровБухУчета.Вставить("Договор",					Договор);
	СтруктураПараметровБухУчета.Вставить("ПриложениеКДоговору",		ПриложениеКДоговору);
	
	ПараметрыБухгалтерскогоУчета = CW_Финансы.ПолучитьПарметрыВеденияБухгалтерскогоУчета(СтруктураПараметровБухУчета, Дата);
	
	ПровестиПоБухгалтерскомуУчету = ПараметрыБухгалтерскогоУчета.БухгалтерскийУчет и СтатусДокументаПроводитьПоБухгалтерскомуУчету;
	
	// если статус документа "Не принимать к учету"
	Если Не ПровестиПоБухгалтерскомуУчету Тогда 
		Возврат; 
	КонецЕсли; 
	
	// перезаполняем счета задолженности
	СтруктураСчетов = CW_Финансы.СтруктураСчетовРасчетов_Поставщики(Дата,Организация);
	ЕстьПеревыставление = Ложь;
	ЕстьСобственные = Ложь;
	Для каждого Стр Из Услуги Цикл
		
		Если (НЕ СписокСчетов) Тогда
			Стр.Счет = Неопределено;
		КонецЕсли; 
		
		Стр.СчетЗадолженности = CW_Финансы.ОпределитьСчетУчетаРасходов(Стр,СтруктураСчетов,Валюта <> ДС.КО.ВалютарегламентированногоУчета,Договор.ВзаиморасчетыВУЕ);
		
		Если Стр.СтатьяЗатрат.Пустая() Тогда
			Стр.СтатьяЗатрат = Стр.Номенклатура.СтатьяЗатрат;
		КонецЕсли; 
		
		Если (Стр.ПорядокОтражения <> Перечисления.CW_ПорядокОтраженияЗатрат.Затраты) Тогда
			ЕстьПеревыставление = Истина;
		Иначе
			ЕстьСобственные = Истина;
		КонецЕсли;
		
	КонецЦикла; 
	
	#Область ПроверкаЗаполненияРеквизитов
		Если (НЕ ПометкаУдаления) Тогда
			
			КонтролироватьСтрокиСНулевойСуммой = CW_Настройки.ПолучитьНастройкуПользователя(,"КонтролироватьСтрокиСНулевойСуммой");
			
			// проверка реквизитов
			флОшибка = Ложь;
			МассивСообщений = Новый Массив;
			
			Если Организация.Пустая() Тогда
				
				флОшибка = Истина;
				МассивСообщений.Добавить("Не указана организация!");
				
			КонецЕсли; 
			Если Контрагент.Пустая() Тогда
				
				флОшибка = Истина;
				МассивСообщений.Добавить("Не указан контрагент!");
				
			КонецЕсли; 
			Если Договор.Пустая() Тогда
				
				флОшибка = Истина;
				МассивСообщений.Добавить("Не указан договор контрагента!");
				
			КонецЕсли; 
			
			Если РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
				
				Если ПредъявленСчет Тогда
					
					Если СокрЛП(НомерСчета)="" Тогда
						
						флОшибка = Истина;
						МассивСообщений.Добавить("Не указан номер счета!");
						
					КонецЕсли;
					Если ДатаСчета = Дата(1,1,1) Тогда
						
						флОшибка = Истина;
						МассивСообщений.Добавить("Не указана дата счета!");
						
					КонецЕсли;
					
				КонецЕсли;
								
				СчетчикСтрок = 1;
				Для каждого Стр Из Услуги Цикл
					 Если Стр.Номенклатура.Пустая() Тогда
						флОшибка = Истина;
						МассивСообщений.Добавить("В строке №"+Строка(СчетчикСтрок)+" таблицы услуг не указана номенклатура услуги!");
					КонецЕсли;
					
					Если (Стр.Количество = 0) и КонтролироватьСтрокиСНулевойСуммой Тогда
						флОшибка = Истина;
						МассивСообщений.Добавить("В строке №"+Строка(СчетчикСтрок)+" таблицы услуг не указано количество!");
					КонецЕсли;
					Если (Стр.Цена = 0) и КонтролироватьСтрокиСНулевойСуммой Тогда
						флОшибка = Истина;
						МассивСообщений.Добавить("В строке №"+Строка(СчетчикСтрок)+" таблицы услуг не указана цена!");
					КонецЕсли;
					Если (Стр.Сумма = 0) и КонтролироватьСтрокиСНулевойСуммой Тогда
						флОшибка = Истина;
						МассивСообщений.Добавить("В строке №"+Строка(СчетчикСтрок)+" таблицы услуг не указана сумма!");
					КонецЕсли;
					Если Стр.СтавкаНДС.Пустая() Тогда
						флОшибка = Истина;
						МассивСообщений.Добавить("В строке №"+Строка(СчетчикСтрок)+" таблицы услуг не указана ставка НДС!");
					КонецЕсли;
					Если (Стр.НДС = 0) И 
						(Стр.СтавкаНДС <> Перечисления.СтавкиНДС.БезНДС) И
						(Стр.СтавкаНДС <> Перечисления.СтавкиНДС.НДС0) И 
						КонтролироватьСтрокиСНулевойСуммой 
						Тогда
						флОшибка = Истина;
						МассивСообщений.Добавить("В строке №"+Строка(СчетчикСтрок)+" таблицы услуг не указана сумма НДС!");
					КонецЕсли;
					Если (Стр.Всего = 0) И КонтролироватьСтрокиСНулевойСуммой Тогда
						флОшибка = Истина;
						МассивСообщений.Добавить("В строке №"+Строка(СчетчикСтрок)+" таблицы услуг не указана сумма всего!");
					КонецЕсли;
					
					_сф.Инкремент(СчетчикСтрок);
					
				КонецЦикла; 
				
			КонецЕсли; // для режима записи "Проведение" 
			
			// проверка корректности ввода остатков
			Если (ВводОстатковБУ) Тогда
				
				// проверяем, курс по взаиморасчетам
				Если Валюта <> CW_Настройки.ВалютаРегламентированногоУчета() И Договор.ВзаиморасчетыВУЕ И (КурсВзаиморасчетовБУ = 0) И
					(ПредъявленАкт Или ПредъявленСФ) 	
				Тогда
					флОшибка = Истина;
					МассивСообщений.Добавить("Не указан курс взаиморасчётов по бухгалтерскому учету!");				
				КонецЕсли;	
				
			КонецЕсли; 
			
			Если (ВводОстатковОЗ) Тогда
				
				// проверяем, курс по взаиморасчетам
				Если (СальдоВзаиморасчетовОЗ <> 0) И 
					(Валюта <> CW_Настройки.ВалютаРегламентированногоУчета()) И 
					(КурсВзаиморасчетовОЗ = 0) И
					(ПредъявленСчет)  	
				Тогда
					флОшибка = Истина;
					МассивСообщений.Добавить("Не указан курс ввода остатков для оперативного учета задолженности!");				
				КонецЕсли;	
				
			КонецЕсли; 
			
			// при наличии ошибок
			Если (флОшибка) Тогда
				Сообщить("Проверка перед записью " + ЭтотОбъект + " : ");
				
				Для каждого Стр Из МассивСообщений Цикл
					Сообщить(Стр,СтатусСообщения.Внимание);
				КонецЦикла; 
				
				Отказ = Истина;
				Возврат;
			КонецЕсли; 
			
		КонецЕсли; // проверка реквизитов для не помеченных на удаление документов
	#КонецОбласти 
	
	#Область ЗачетАвансов 
	
	// без бухгалтерского учета отключаем зачет авансов по бухгалтерии
	Если НЕ ПровестиПоБухгалтерскомуУчету Тогда
		
		СпособЗачетаАвансов=Перечисления.СпособыЗачетаАвансов.НеЗачитывать;
		ЗачетАвансов.Очистить();
		
	КонецЕсли; 
	
	Если (НЕ ДС.УП.ОЗ) Тогда
		
		СпособЗачетаАвансовОЗ=Перечисления.СпособыЗачетаАвансов.НеЗачитывать;
		ЗачетАвансовОЗ.Очистить();
		
	КонецЕсли; 
	
	Если (НЕ Корректировка) Тогда
		
		// заполнение ТЧ "ЗачетАвансаОЗ"
		Если (СпособЗачетаАвансовОЗ = Перечисления.СпособыЗачетаАвансов.Автоматически 
			И ДС.УП.ОЗ
			И РежимЗаписи=РежимЗаписиДокумента.Проведение
			И ПредъявленСчет) Тогда
			
			Если (НачалоДня(ДатаСчета) <> НачалоДня(Дата)) Тогда
				
				Сообщить("При ведении учета оперативной задолженности и автоматическом зачете авансов (ОУ) дата документа должна совпадать с датой счета");
				
			КонецЕсли; 
			
			ДатаПодбораАвансов = Новый Граница(МоментВремени(),ВидГраницы.Исключая);
			ЗаполнитьТаблицуАвансовОЗ(ДатаПодбораАвансов);
			
		ИначеЕсли (СпособЗачетаАвансовОЗ = Перечисления.СпособыЗачетаАвансов.НеЗачитывать) Тогда 
			ЗачетАвансовОЗ.Очистить();		 
		КонецЕсли; 
		
		// заполнение ТЧ "ЗачетАванса"
		Если СпособЗачетаАвансов = Перечисления.СпособыЗачетаАвансов.Автоматически
			И РежимЗаписи=РежимЗаписиДокумента.Проведение 
			И ПредъявленАкт 
		Тогда
			
			Если (НачалоДня(ДатаАкта) <> НачалоДня(Дата)) Тогда
				Сообщить("При автоматическом зачете авансов (БУ) дата документа должна совпадать с датой акта");
			КонецЕсли; 
			
			ДатаПодбораАвансов = Новый Граница(ВедомыйДокумент.Дата,ВидГраницы.Исключая);
			ЗаполнитьТаблицуАвансов(ДатаПодбораАвансов);
			
		ИначеЕсли (СпособЗачетаАвансов = Перечисления.СпособыЗачетаАвансов.НеЗачитывать) Тогда 
			ЗачетАвансов.Очистить();		 
			
		КонецЕсли;	
		
		// заполнение таб.части "Платёжно-расчётные документы с/ф"
		Если ПорядокЗаполненияРасчётноПлатёжныхДокументовСФ = Перечисления.CW_ПорядокЗаполненияРасчётноПлатёжныхДокументовСФ.Автоматически 
			И РежимЗаписи=РежимЗаписиДокумента.Проведение 
			И ПредъявленСФ
		Тогда 
			Ответ = Документы.CW_РасходыПоГрузоперевозке.ПолучитьТаблицу_ПлатёжноРасчётныеДокументы_дляСФ(ЭтотОбъект.Ссылка, ЗачетАвансов);
			Если Ответ.Код = 0 Тогда
				ЭтотОбъект.ПлатёжноРасчётныеДокументы.Загрузить(Ответ.ПлатёжноРасчётныеДокументы);
			Иначе 
				Сообщить(Ответ.ОписаниеОшибки);
			КонецЕсли;
			
		ИначеЕсли ПорядокЗаполненияРасчётноПлатёжныхДокументовСФ = Перечисления.CW_ПорядокЗаполненияРасчётноПлатёжныхДокументовСФ.НеУчитывать Тогда  
			ЭтотОбъект.ПлатёжноРасчётныеДокументы.Очистить();
			
		КонецЕсли;
	КонецЕсли; 
	
	#КонецОбласти 
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ) Экспорт
	
	// обмен данными
	Если (ОбменДанными.Загрузка) Тогда Возврат; КонецЕсли;
	Если (РучнаяКорректировка) Тогда Возврат; КонецЕсли; 
	
	// не перепроводим при восстановлении последовательности
	ВосстановлениеПоследовательности = _сф.ст_ПолучитьСвойство(ДополнительныеСвойства,"ПроведенВХронологическойПоследовательности");
	
	Если (ВосстановлениеПоследовательности <> Неопределено) Тогда
		Если (ВосстановлениеПоследовательности) Тогда
			
			Возврат;
			
		КонецЕсли; 
	КонецЕсли; 
	
	// контроль наличия общих параметров
	Если (НЕ ЗаполненыОбщиеПараметры()) Тогда СформироватьОбщиеПараметры(,Ложь); КонецЕсли; 
	
	// определяем, что делать с подчинённым документом
	РежимЗаписи = _сф.ст_ПолучитьСвойство(ДополнительныеСвойства,"РежимЗаписи");
	
	//Подсистема.СтатусыДокументов
	ИспользуютсяСтатусыДокументов = ПолучитьФункциональнуюОпцию("CW_ИспользуютсяСтатусыДокументов");
	Если ИспользуютсяСтатусыДокументов И
		Не ЭтотОбъект.ДополнительныеСвойства.Свойство("СтатусДокумента") Тогда
		//В случае если используются статусы документа и проведение не из формы, тов ДС статуса нет
		ДанныеСтатуса = РегистрыСведений.CW_СтатусыДокументов.ПолучитьДанныеСтатусаДокумента(Ссылка);
		ЭтотОбъект.ДополнительныеСвойства.Вставить("СтатусДокумента", ДанныеСтатуса.СтатусДокумента);
	КонецЕсли;
	
	СтатусДокумента = Неопределено;
	ЭтотОбъект.ДополнительныеСвойства.Свойство("СтатусДокумента", СтатусДокумента);
	
	СтатусДокументаПроводитьПоБухгалтерскомуУчету = CW_СтатусыДокументовСервер.ПолучитьПризнакПроведенияПоБухгалтерскомуУчету(Ссылка, СтатусДокумента);
	//Подсистема.СтатусыДокументов	
	
	СтруктураПараметровБухУчета = Новый Структура;
	СтруктураПараметровБухУчета.Вставить("Договор",					Договор);
	СтруктураПараметровБухУчета.Вставить("ПриложениеКДоговору",		ПриложениеКДоговору);
	
	ПараметрыБухгалтерскогоУчета = CW_Финансы.ПолучитьПарметрыВеденияБухгалтерскогоУчета(СтруктураПараметровБухУчета, Дата);
	
	ПровестиПоБухгалтерскомуУчету = ПараметрыБухгалтерскогоУчета.БухгалтерскийУчет и СтатусДокументаПроводитьПоБухгалтерскомуУчету;
	
	// ЗАПИСЬ
	Если (РежимЗаписи = РежимЗаписиДокумента.Запись) Тогда
		ПроверитьСтатусВедомых();
	КонецЕсли;
	
	// ОТМЕНА ПРОВЕДЕНИЯ
	Если (РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения) Тогда
		
		Если (НЕ Корректировка) Тогда
			
			// проверяем возможность отмены проведения
			Если (НЕ ПроверитьЗакрытиеГрузоперевозок()) Тогда
				Сообщить("В документе присутствуют закрытие грузоперевозки. Операция отменена.",СтатусСообщения.Важное);
				Отказ = Истина;
				Возврат;
			КонецЕсли; 
		КонецЕсли; 
				
		ПроверитьСтатусВедомых();
		
		// удаляем движения
		Для каждого Набор Из Движения Цикл
			
			Набор.Прочитать();
			Набор.Очистить();
			
		КонецЦикла;
		Движения.Записать();
		
	КонецЕсли;
	
	// ПРОВЕДЕНИЕ
	Если (РежимЗаписи = РежимЗаписиДокумента.Проведение) Тогда
		
		Счета = CW_Конфигурация.ПланСчетов(); 
		
		// опционально блокируем проведение по закрытым договорам
		Если (НЕ Корректировка И Договор.Закрыт И КонецДня(Договор.ДатаЗакрытия) < Дата) Тогда
			
			Отказ = Истина;
			Сообщить(Ссылка);
			Сообщить("Проведение документа позднее даты закрытия договора с контрагентом невозможно!");
			Возврат;
			
		КонецЕсли; 
		
		ОчищатьДвижения = Истина;
		// удаляем собственные движения	
		Если (ПредъявленАкт ИЛИ ПредъявленСФ) И ПровестиПоБухгалтерскомуУчету Тогда
			
			Если (НЕ Корректировка) Тогда
				ПроверяемыйДокумент = ВедомыйДокумент;
			Иначе
				ПроверяемыйДокумент = ВедомыйДокументКорректировки;
			КонецЕсли; 
			
			Если (НЕ ПроверяемыйДокумент.РучнаяКорректировка) Тогда
				
				ОчищатьДвижения = Истина;
				
			Иначе 
				
				СтатусПроведенияДоПроведения = _сф.ст_ПолучитьСвойство(ДополнительныеСвойства,"СтатусПроведенияДоПроведения",Ложь);
				Если (НЕ СтатусПроведенияДоПроведения) Тогда
					Сообщить(Ссылка);
					Сообщить("Ведомый документ содержит признак ручной корректировки. Проведение заблокировано.");
					Отказ = Истина;
					Возврат;
				Иначе	
					
					Сообщить("Внимание! У ведомого документа "+Строка(ПроверяемыйДокумент)+" установлен признак ручной корректировки движений!");
					ОчищатьДвижения = Ложь;
					// ничего не делаем
				КонецЕсли; 
				
			КонецЕсли; 
			
		КонецЕсли; 
		
		Если (ОчищатьДвижения) Тогда
			
			Для каждого Набор Из Движения Цикл
				
				Набор.Прочитать();
				Набор.Очистить();
				
			КонецЦикла;
			Движения.Записать();
			
		Иначе
			
			Возврат;
			
		КонецЕсли; 
		
		Если (НЕ Корректировка) Тогда
			
			//проверяем на ввод начальных остатков...
			ДатаНачалаВеденияУчета = CW_Настройки.ПолучитьДатуНачалаВеденияУчета(Организация);
			Если НЕ ДатаНачалаВеденияУчета = Неопределено Тогда
				РежимВводначальныхОстатков = Ложь;		
				Если Дата < ДатаНачалаВеденияУчета Тогда		
					РежимВводначальныхОстатков = Истина;
				Иначе
					РежимВводначальныхОстатков = Ложь;
				КонецЕсли;	
			Иначе
				РежимВводначальныхОстатков = Ложь;	
			КонецЕсли;
			Если РежимВводначальныхОстатков Тогда
				Если Договор.ВзаиморасчетыВУЕ Тогда
					
					ПроверятьКурс = Ложь;
					Для каждого Стр Из Услуги Цикл
						Если (Стр.ПорядокОтражения = Перечисления.CW_ПорядокОтраженияЗатрат.Перевыставление ИЛИ Стр.ПорядокОтражения = Перечисления.CW_ПорядокОтраженияЗатрат.ПеревыставлениеПоСтавкам) И Стр.ВводОстатков Тогда
							ПроверятьКурс = Истина;	
							Прервать;
						КонецЕсли; 
					КонецЦикла;
					
					Если ПроверятьКурс Тогда
						Если КурсВзаиморасчетовБУ = 0 Тогда
							Сообщить("Курс у.е. не заполнен! см.вкладу ""Дополнительно"".");
							Отказ = Истина;
							Возврат;
						КонецЕсли;	
					КонецЕсли; 
					
				КонецЕсли;	
			КонецЕсли; 
			
		КонецЕсли; 
		
		// заполняем ведомые
		Если (НЕ Корректировка) Тогда
			
			Если  ПровестиПоБухгалтерскомуУчету Тогда
				
				// ведомый счёт
				Если (ПредъявленСчет И ДС.УП.ФормироватьСчетаПоставщикаНаОплату) Тогда
					
					ВедомыйОбъект = ВедомыйСчет.ПолучитьОбъект();
					ВедомыйОбъект.УстановитьПометкуУдаления(ПометкаУдаления);
					// --- 
					ВедомыйОбъект.Организация = Организация;
					ВедомыйОбъект.Дата =?(ФормироватьВедомыеДатойДокумента,Дата,ДатаСчета);
					ВедомыйОбъект.Контрагент = Контрагент;
					ВедомыйОбъект.ДоговорКонтрагента = ПараметрыБухгалтерскогоУчета.УчетныйДоговор;
					ВедомыйОбъект.ВалютаДокумента = ПараметрыБухгалтерскогоУчета.УчетныйДоговор.ВалютаВзаиморасчетов;
					// --- 
					РасчетныйСчет = ДС.ПД.РасчетныйСчет;
					Если (НЕ ЗначениеЗаполнено(РасчетныйСчет)) Тогда
						ВедомыйОбъект.БанковскийСчетКонтрагента = Неопределено;
					Иначе
						ВедомыйОбъект.БанковскийСчетКонтрагента = РасчетныйСчет;
					КонецЕсли;
					// --- 
					ВедомыйОбъект.НомерВходящегоДокумента = НомерСчета;
					ВедомыйОбъект.ДатаВходящегоДокумента = ДатаСчета;
					// --- 
					ВедомыйОбъект.СуммаВключаетНДС = Ложь;
					ВедомыйОбъект.СуммаДокумента = Услуги.Итог("Всего");
					// --- 
					ЕстьТовары = (Документы.СчетНаОплатуПоставщика.ПустаяСсылка().Метаданные().ТабличныеЧасти.Найти("Товары") <> Неопределено);
					Если (ЕстьТовары) Тогда
						
						ВедомыйОбъект.Товары.Очистить();
						Для каждого СтрокаУслуги Из Услуги Цикл
							
							Нстр = ВедомыйОбъект.Товары.Добавить();
							Нстр.Номенклатура = СтрокаУслуги.Номенклатура;
							Нстр.Содержание = СокрЛП(СтрокаУслуги.Представление);
							Нстр.СтавкаНДС = СтрокаУслуги.СтавкаНДС;
							Нстр.Количество = СтрокаУслуги.Количество;
							Нстр.Цена = СтрокаУслуги.Цена;
							Нстр.Сумма = СтрокаУслуги.Сумма;
							Нстр.СуммаНДС = СтрокаУслуги.НДС;
							
						КонецЦикла; 
						
					Иначе
						ВедомыйОбъект.Услуги.Очистить();
						Для каждого СтрокаУслуги Из Услуги Цикл
							Нстр = ВедомыйОбъект.Услуги.Добавить();
							Нстр.Номенклатура = СтрокаУслуги.Номенклатура;
							Нстр.Содержание = СокрЛП(СтрокаУслуги.Представление);
							Нстр.СтавкаНДС = СтрокаУслуги.СтавкаНДС;
							Нстр.Количество = СтрокаУслуги.Количество;
							Нстр.Цена = СтрокаУслуги.Цена;
							Нстр.Сумма = СтрокаУслуги.Сумма;
							Нстр.СуммаНДС = СтрокаУслуги.НДС;
						КонецЦикла; 
					КонецЕсли; 
					
					CW_Документы.ПеренестиПризнакВосстановленияПоследовательности(ЭтотОбъект,ВедомыйОбъект);
					ВедомыйОбъект.ОбменДанными.Загрузка = Ложь;
					ВедомыйОбъект.Записать(РежимЗаписи);
					
					// Если для целей оперативного учета задолженности документ проводится в режиме ввода остатков,
					// то принудительно пропишем статус ведомого счета (при проведении в обычном режиме статус не прописываем,
					// т.к. он будет определен типовой конфигурацией на момент записи документа)
					СтруктураНастроек = CW_Настройки.ПолучитьНастройкиОперативногоУчета(Организация,Перечисления.CW_ВидыОперативнойЗадолженности.Кредиторская, Дата);
					
					Если СтруктураНастроек["ВедетсяОперативныйУчет"] Тогда
						РежимВводНачальныхОстатков = СтруктураНастроек["ВводОстатков"];
						Если РежимВводНачальныхОстатков Тогда
							
							// статус оплаты
							СтатусОплаты = Перечисления.СтатусОплатыСчета.НеОплачен;
							Если СальдоВзаиморасчетовОЗ <= 0 Тогда
								СтатусОплаты = Перечисления.СтатусОплатыСчета.Оплачен;
							Иначе
								Если СальдоВзаиморасчетовОЗ < Услуги.Итог("Всего") Тогда
									СтатусОплаты = Перечисления.СтатусОплатыСчета.ОплаченЧастично;
								КонецЕсли; 
							КонецЕсли; 
							
							// статус отгрузки
							СтатусОтгрузки = ?(ПредъявленАкт,Перечисления.СтатусыОтгрузки.Отгружен,Перечисления.СтатусыОтгрузки.НеОтгружен);
							
							МассивДокументов = Новый Массив;
							МассивДокументов.Добавить(ВедомыйОбъект.Ссылка);
							
							// пишем в регистр
							СтатусыДокумента = РегистрыСведений.СтатусыДокументов.НовыеСтатусыДокумента();
							СтатусыДокумента.Статус            		= СтатусОплаты;
							СтатусыДокумента.ДополнительныйСтатус	= СтатусОтгрузки;
							РегистрыСведений.СтатусыДокументов.УстановитьСтатусыДокументов(МассивДокументов, СтатусыДокумента);
						КонецЕсли; // это режим ввода остатков 
					КонецЕсли; // по организации ведется учет оперативной задолженности
					
				// формировать счет не требуется	
				Иначе
					Если (НЕ ВедомыйСчет.Пустая()) Тогда
						
						ПометитьНаУдаление(ВедомыйСчет);
						
					КонецЕсли; 
				КонецЕсли; // требуется формировать счет 
				
				//ведомые акт и счёт-фактура
				Если (ПредъявленАкт ИЛИ ПредъявленСФ) Тогда
					
					ВедомыйОбъект = ВедомыйДокумент.ПолучитьОбъект();
					_сф.ст_УстановитьСвойство(ВедомыйОбъект.ДополнительныеСвойства,"ВедущийДокумент",Ссылка);
					_сф.ст_УстановитьСвойство(ВедомыйОбъект.ДополнительныеСвойства,"ЗависимоеПроведение",Истина);
					
					НоваяДата = ?(ФормироватьВедомыеДатойДокумента,Дата,?(ПредъявленАкт,ДатаАкта,ДатаСФ));
					
					//ВедомыйОбъект = Документы.ПоступлениеТоваровУслуг.СоздатьДокумент(); // тмп
					ВедомыйОбъект.УстановитьПометкуУдаления(ПометкаУдаления);
					ВедомыйОбъект.Организация = Организация;
					ВедомыйОбъект.Дата = НоваяДата;
					
					ВедомыйОбъект.ЭтоУниверсальныйДокумент = ЭтоУниверсальныйДокумент;
					
					Если (ПредъявленАкт) Тогда
						НомерВходящего = НомерАкта;
						ДатаВходящего = ДатаАкта;
					Иначе
						НомерВходящего = НомерСФ;
						ДатаВходящего = ДатаСФ;
					КонецЕсли; 
					
					ВедомыйОбъект.НомерВходящегоДокумента = НомерВходящего;
					ВедомыйОбъект.ДатаВходящегоДокумента = ДатаВходящего;
					ВедомыйОбъект.ВидОперации = Перечисления.ВидыОперацийПоступлениеТоваровУслуг.ПокупкаКомиссия;
					ВедомыйОбъект.Контрагент = Контрагент;
					ВедомыйОбъект.ДоговорКонтрагента = ПараметрыБухгалтерскогоУчета.УчетныйДоговор;
					ВедомыйОбъект.СуммаВключаетНДС = Ложь;
					ВедомыйОбъект.СчетНаОплатуПоставщика = Документы.CW_РасходыПоГрузоперевозке.ПолучитьСчетНаОплатуПоставщика(Ссылка);
					//ВедомыйОбъект.НДСВключенВСтоимость = НДСВключатьВСтоимость;
					//ВедомыйОбъект.НДСНеВыделять = НДСВключатьВСтоимость;
					ВедомыйОбъект.ВалютаДокумента = Валюта;
					ВедомыйОбъект.Ответственный = Ответственный;
					ВедомыйОбъект.Комментарий = "Сформировано автоматически (CW) документом ""Расходы по грузоперевозке"" №"+Строка(Номер)+" от "+Формат(Дата,"ДФ=dd.MM.yyyy");
					
					Если (Валюта = ДС.КО.ВалютаРегламентированногоУчета) Тогда
						ВедомыйОбъект.КурсВзаиморасчетов = 1;
						ВедомыйОбъект.КратностьВзаиморасчетов = 1;
					Иначе
						
						Если УЕ_ПользовательскийКурс Тогда
							СК = Новый Структура("Курс,Кратность",УЕ_Курс,УЕ_Кратность);
						Иначе
							СК = РегистрыСведений.КурсыВалют.ПолучитьПоследнее(НоваяДата, Новый Структура("Валюта", Валюта));
						КонецЕсли; 
						//Если ДополнительныеСвойства.УП.УчитыватьКурсыВалютАвансовДляБазыНДС
						//	И ЗачетАвансов.Количество()>0
						//Тогда 
						//	СК = ПриведённыйКурсСУчётомВалютныхАвансов(СК);
						//КонецЕсли;
						// --- 
						ВедомыйОбъект.КурсВзаиморасчетов = СК.Курс;
						ВедомыйОбъект.КратностьВзаиморасчетов = СК.Кратность;
					КонецЕсли;	
					
					СчетУчетаСПоставщиком = ДС.УП.СчетРасчетов_Поставщики_Рубли;
