					ВедомыйОбъект.АгентскиеУслуги.Очистить();
					// --- 
					ИндексСтрокиСобственных = 0;
					ИндексСтрокиАгентских = 0;
					
					Если КорректируемыйДокумент.Корректировка Тогда
						ТаблицаУслугСобственных = КорректируемыйДокумент.ВедомыйДокументКорректировки.Услуги.Выгрузить();
						ТаблицаУслугАгентских 	= КорректируемыйДокумент.ВедомыйДокументКорректировки.АгентскиеУслуги.Выгрузить();
					Иначе
						ТаблицаУслугСобственных = КорректируемыйДокумент.ВедомыйДокумент.Услуги.Выгрузить();
						ТаблицаУслугАгентских 	= КорректируемыйДокумент.ВедомыйДокумент.АгентскиеУслуги.Выгрузить();
					КонецЕсли;
					// --- 
					Для каждого Стр Из Услуги Цикл
						
						Если (Стр.ПорядокОтражения = Перечисления.CW_ПорядокОтраженияЗатрат.Затраты) Тогда
							
							Нстр = ВедомыйОбъект.Услуги.Добавить();
							// --- 
							Нстр.ЕстьВДокументеПоступления = Истина;
							Нстр.Номенклатура = Стр.Номенклатура;
							// --- 
							Нстр.СодержаниеДоИзменения = СокрЛП(Стр.Представление_ДоКорректировки);
							Нстр.Содержание = СокрЛП(Стр.Представление);
							// --- 
							Нстр.КоличествоДоИзменения = Стр.Количество_ДоКорректировки;
							Нстр.Количество = Стр.Количество;
							// --- 
							Нстр.ЦенаДоИзменения = Стр.Цена_ДоКорректировки;
							Нстр.Цена = Стр.Цена;
							// --- 
							Нстр.СуммаДоИзменения = Стр.Сумма_ДоКорректировки;
							Нстр.Сумма = Стр.Сумма;
							// --- 
							Нстр.СтавкаНДСДоИзменения = Стр.СтавкаНДС;
							Нстр.СтавкаНДС = Стр.СтавкаНДС;
							// --- 
							Нстр.СуммаНДСДоИзменения = Стр.НДС_ДоКорректировки;
							Нстр.СуммаНДС = Стр.НДС;
							
							// остальные реквизиты берём из соответствующей строки ведомого корректируемого документа
							СтрокаДокументаПоступления = ТаблицаУслугСобственных[ИндексСтрокиСобственных];
							_сф.Инкремент(ИндексСтрокиСобственных);
							// --- 
							ЗаполнитьЗначенияСвойств(Нстр,СтрокаДокументаПоступления,"СчетЗатрат,ПодразделениеЗатрат,Субконто1,Субконто2,Субконто3,СчетЗатратНУ,СубконтоНУ1,СубконтоНУ2,СубконтоНУ3,СчетУчетаНДС,ОтражениеВУСН,СпособУчетаНДС");
							
						Иначе
							
							Нстр = ВедомыйОбъект.АгентскиеУслуги.Добавить();
							// --- 
							Нстр.ЕстьВДокументеПоступления = Истина;
							Нстр.Номенклатура = Стр.Номенклатура;
							// --- 
							Нстр.СодержаниеДоИзменения = СокрЛП(Стр.Представление_ДоКорректировки);
							Нстр.Содержание = СокрЛП(Стр.Представление);
							// --- 
							Нстр.КоличествоДоИзменения = Стр.Количество_ДоКорректировки;
							Нстр.Количество = Стр.Количество;
							// --- 
							Нстр.ЦенаДоИзменения = Стр.Цена_ДоКорректировки;
							Нстр.Цена = Стр.Цена;
							// --- 
							Нстр.СуммаДоИзменения = Стр.Сумма_ДоКорректировки;
							Нстр.Сумма = Стр.Сумма;
							// --- 
							Нстр.СтавкаНДСДоИзменения = Стр.СтавкаНДС_ДоКорректировки;
							Нстр.СтавкаНДС = Стр.СтавкаНДС;
							// --- 
							Нстр.СуммаНДСДоИзменения = Стр.НДС_ДоКорректировки;
							Нстр.СуммаНДС = Стр.НДС;
							
							СтрокаДокументаПоступления = ТаблицаУслугАгентских[ИндексСтрокиАгентских];
							_сф.Инкремент(ИндексСтрокиАгентских);
							// --- 
							ЗаполнитьЗначенияСвойств(Нстр,СтрокаДокументаПоступления,"СчетРасчетов,Контрагент,ДоговорКонтрагента");
							
							
							
						КонецЕсли; 
						
					КонецЦикла; 
					
					// --- 
					ВедомыйОбъект.ОбменДанными.Загрузка = Ложь;
					// --- 
					CW_Документы.ПеренестиПризнакВосстановленияПоследовательности(ЭтотОбъект,ВедомыйОбъект);
					// --- 
					ВедомыйОбъект.Записать(РежимЗаписи);
					
					
				КонецЕсли; 
								
			Иначе
				
				Если (НЕ ВедомыйДокументКорректировки.Пустая()) Тогда
					
					ПометитьНаУдаление(ВедомыйДокументКорректировки);
					
				КонецЕсли;
				
			КонецЕсли; 
			
		КонецЕсли; 
		
		
	КонецЕсли;
	
КонецПроцедуры // ПриЗаписи()

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	// контроль загрузки
	Если (ОбменДанными.Загрузка) Тогда 
		Возврат; 
	КонецЕсли;
	Если (РучнаяКорректировка) Тогда 
		Возврат; 
	КонецЕсли; 
	
	// не перепроводим при восстановлении последовательности
	ВосстановлениеПоследовательности = _сф.ст_ПолучитьСвойство(ДополнительныеСвойства,"ПроведенВХронологическойПоследовательности");
	Если (ВосстановлениеПоследовательности <> Неопределено) Тогда
		Если (ВосстановлениеПоследовательности) Тогда
			Возврат;
		КонецЕсли; 
	КонецЕсли; 
	
	// контроль наличия общих параметров
	CW_БухгалтерияЭкспедитораСервер.УстановитьОбщиеПараметрыПроведенияДокументов();

	Если НЕ ЗаполненыОбщиеПараметры() Тогда 
		СформироватьОбщиеПараметры(,Ложь); 
	КонецЕсли; 
	
	//Подсистема.СтатусыДокументов
	ИспользуютсяСтатусыДокументов = ПолучитьФункциональнуюОпцию("CW_ИспользуютсяСтатусыДокументов");
	Если ИспользуютсяСтатусыДокументов И
		Не ЭтотОбъект.ДополнительныеСвойства.Свойство("СтатусДокумента") Тогда
		//В случае если используются статусы документа и проведение не из формы, тов ДС статуса нет
		ДанныеСтатуса = РегистрыСведений.CW_СтатусыДокументов.ПолучитьДанныеСтатусаДокумента(Ссылка);
		ЭтотОбъект.ДополнительныеСвойства.Вставить("СтатусДокумента", ДанныеСтатуса.СтатусДокумента);
	КонецЕсли;
	
	СтатусДокумента = Неопределено;
	ЭтотОбъект.ДополнительныеСвойства.Свойство("СтатусДокумента", СтатусДокумента);
	
	СтатусДокументаПроводитьПоБухгалтерскомуУчету = CW_СтатусыДокументовСервер.ПолучитьПризнакПроведенияПоБухгалтерскомуУчету(Ссылка, СтатусДокумента);
	//Подсистема.СтатусыДокументов	
	
	СтруктураПараметровБухУчета = Новый Структура;
	СтруктураПараметровБухУчета.Вставить("Договор",					Договор);
	СтруктураПараметровБухУчета.Вставить("ПриложениеКДоговору",		ПриложениеКДоговору);
	
	ПараметрыБухгалтерскогоУчета = CW_Финансы.ПолучитьПарметрыВеденияБухгалтерскогоУчета(СтруктураПараметровБухУчета, Дата);
	
	ПровестиПоБухгалтерскомуУчету = ПараметрыБухгалтерскогоУчета.БухгалтерскийУчет и СтатусДокументаПроводитьПоБухгалтерскомуУчету;
	
	// контроль статуса
	Если Не ПровестиПоБухгалтерскомуУчету Тогда
		
		// очищаем движения
		Для каждого НаборДвижений Из Движения Цикл
			НаборДвижений.Очистить();
		КонецЦикла; 
		Возврат;
	КонецЕсли; 
	
	// для счетов и ОУ
	Если НЕ (ПредъявленАкт ИЛИ ПредъявленСФ) ИЛИ НЕ ПровестиПоБухгалтерскомуУчету Тогда
		Если (НЕ Корректировка) Тогда
			CW_Подписки.СформироватьДвиженияДляРасходовПоПриобретениям(Ссылка,Отказ,ДополнительныеСвойства);
		Иначе
		//	CW_Подписки.СформироватьДвиженияДляКорректировкиРасходов(Ссылка,Отказ,ДополнительныеСвойства);
		КонецЕсли; 
	КонецЕсли; 
	
КонецПроцедуры

Процедура ПроверитьСтатусВедомых()
	
	Если (НЕ Корректировка) Тогда
		Если (НЕ ВедомыйДокумент.Пустая()) Тогда
			Если (ПредъявленАкт) Тогда
				СинхронизироватьПометкуУдаления(ВедомыйДокумент);
			Иначе
				ПометитьНаУдаление(ВедомыйДокумент);
			КонецЕсли; 
		КонецЕсли; 
		
		Если (НЕ ВедомыйСчет.Пустая()) Тогда
			Если (ПредъявленСчет) Тогда
				СинхронизироватьПометкуУдаления(ВедомыйСчет);
			Иначе
				ПометитьНаУдаление(ВедомыйСчет);
			КонецЕсли; 
		КонецЕсли; 
	КонецЕсли; 
	
	Если (Корректировка) Тогда
		Если (НЕ ВедомыйДокументКорректировки.Пустая()) Тогда
			Если (ПредъявленАкт) Тогда
				СинхронизироватьПометкуУдаления(ВедомыйДокументКорректировки);
			Иначе
				ПометитьНаУдаление(ВедомыйДокументКорректировки);
			КонецЕсли; 
		КонецЕсли; 
	КонецЕсли; 
	
КонецПроцедуры

Процедура СинхронизироватьПометкуУдаления(Документ)
	
	Если (Документ.ПометкаУдаления <> ПометкаУдаления) Тогда
		
		ВедомыйОбъект = Документ.ПолучитьОбъект();
		_сф.ст_УстановитьСвойство(ВедомыйОбъект.ДополнительныеСвойства,"ВедущийДокумент",Ссылка);
		ВедомыйОбъект.УстановитьПометкуУдаления(ПометкаУдаления);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПометитьНаУдаление(Документ)
	// --- 
	
	Если (Документ.ПометкаУдаления <> Истина) Тогда
		
		ВедомыйОбъект = Документ.ПолучитьОбъект();
		_сф.ст_УстановитьСвойство(ВедомыйОбъект.ДополнительныеСвойства,"ВедущийДокумент",Ссылка);
		ВедомыйОбъект.УстановитьПометкуУдаления(Истина);
		
	КонецЕсли; 
	
	// --- 
КонецПроцедуры

Процедура СформироватьОбщиеПараметры(Знач СписокПараметров = Неопределено,ИнтерактивныйРежим = Истина) Экспорт 
	// получаем параметры договора и константы, помещаем в доп. свойства
	
	CW_ОбщиеПараметры.СформироватьОбщиеПараметры(ЭтотОбъект,СписокПараметров,ИнтерактивныйРежим);
	ДС = ДополнительныеСвойства;
	
КонецПроцедуры

// проверка общих параметров
Функция ЗаполненыОбщиеПараметры() Экспорт 
	// --- 
	
	Возврат(CW_ОбщиеПараметры.ОбщиеПараметрыЗаполнены(ЭтотОбъект));
	
	// --- 
КонецФункции

Процедура ЗаполнитьТаблицуАвансов(ДатаПодбораАвансов) Экспорт 
	// --- 
	
	ЗаполнитьАвансы(ДатаПодбораАвансов,Истина, Ложь);

	// --- 
КонецПроцедуры

Процедура ЗаполнитьТаблицуАвансовОЗ(ДатаПодбораАвансов) Экспорт 
	// --- 
	
	ЗаполнитьАвансы(ДатаПодбораАвансов,Ложь,Истина);
	
	// --- 
КонецПроцедуры

Процедура ЗаполнитьАвансы(ДатаПодбораАвансов,БУ,ОЗ)
	// --- 
	
	Если (БУ) Тогда
		
		ТЧ = ЗачетАвансов;
		
	Иначе
		
		ТЧ = ЗачетАвансовОЗ;
		
	КонецЕсли; 
	
	ДС = ДополнительныеСвойства;
	Счета = CW_Конфигурация.ПланСчетов();
	// --- 
	ТЧ.Очистить();
	// --- 	
	УслугиПоПорядкуОтражения = Услуги.Выгрузить();
	УслугиПоПорядкуОтражения.Свернуть("ПорядокОтражения", "Всего");
	// --- 
	// определяем счета авансов
	Если (Валюта = ДС.КО.ВалютаРегламентированногоУчета) Тогда
		
		СчетРасчетов = ДС.УП.СчетРасчетов_Поставщики_Рубли;
		Если СчетРасчетов = Счета.РасчетыСПоставщиками Тогда
			
			СчетАвансовПоСобственным = Счета.РасчетыПоАвансамВыданным;						
			СчетАвансовПоВозмещаемым = Счета.РасчетыПоАвансамВыданным;
			
		КонецЕсли; 
		
	Иначе
		
		// Валюта
		Если (НЕ Договор.ВзаиморасчетыВУЕ) Тогда
			СчетРасчетов = ДС.УП.СчетРасчетов_Поставщики_Валюта;
			Если СчетРасчетов = Счета.РасчетыСПоставщикамиВал Тогда
				СчетАвансовПоСобственным = Счета.РасчетыПоАвансамВыданнымВал;						
				СчетАвансовПоВозмещаемым = Счета.РасчетыПоАвансамВыданнымВал;
			КонецЕсли;
		КонецЕсли;
		
		// УЕ
		Если (Договор.ВзаиморасчетыВУЕ) Тогда
			СчетРасчетов = ДС.УП.СчетРасчетов_Поставщики_УЕ;
			Если СчетРасчетов = Счета.РасчетыСПоставщикамиУЕ Тогда
				СчетАвансовПоСобственным = Счета.РасчетыПоАвансамВыданнымУЕ;						
				СчетАвансовПоВозмещаемым = Счета.РасчетыПоАвансамВыданнымУЕ;
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли; 
	
	Если (Истина) Тогда
		
		ПараметрыТА = Новый Структура("Дата,Договор,ПриложениеКДоговору,ОЗ,РаздельныйУчетЗаполженност,Акт,ПереплатаКакАванс");
		// --- 
		ПараметрыТА.Дата = ДатаПодбораАвансов;
		ПараметрыТА.Договор = Договор;
		ПараметрыТА.ОЗ = ДС.УП.ОЗ;
		ПараметрыТА.Акт = Ссылка;
		
		ПараметрыТА.РаздельныйУчетЗаполженности = ДС.УП.РаздельныйУчетОперативнойИБухгалтерскойЗадолженности;
		ПараметрыТА.ПереплатаКакАванс 			= ДС.УП.УчитыватьПереплатыПоДокументамКакАванс;		
		// --- 
		ТЗ_Услуги = Услуги.Выгрузить();
		Если (ПараметрыТА.ОЗ) Тогда
			Если (НЕ СписокСчетов) Тогда
				Если (ЗначениеЗаполнено(Счет)) Тогда
					ТЗ_Услуги.ЗаполнитьЗначения(Счет,"Счет");
				Иначе
					ТЗ_Услуги.ЗаполнитьЗначения(Ссылка,"Счет");
				КонецЕсли; 
			КонецЕсли; 
		КонецЕсли; 
		Если (БУ) Тогда
			ТаблицаАвансов = CW_Финансы.ТаблицаАвансов(ПараметрыТА,ТЗ_Услуги,ТЧ.Выгрузить(),ЗачетАвансовОЗ.Выгрузить());	
		ИначеЕсли (ОЗ) Тогда 
			ТаблицаАвансов = CW_Финансы.ТаблицаАвансовДляОЗ(ПараметрыТА,ТЗ_Услуги,ТЧ.Выгрузить());	
		КонецЕсли; 
		
		ТолькоПоПлатежкамСчетов = ПараметрыТА.ОЗ и НЕ ПараметрыТА.РаздельныйУчетЗаполженности;
		//ДС.ПД.АвтоматическиЗачитыватьТолькоПлатежкиПоСчету;
		
		// --- 
		СуммаАванса = _сф.Итог(ТаблицаАвансов,"Аванс");
		СуммаРаспределения = _сф.Итог(УслугиПоПорядкуОтражения,"Всего");
		ОстатокРаспределения = Мин(СуммаРаспределения,СуммаАванса);
		ОстаткиЗачетаПоАктированию = Новый СписокЗначений;
		Для каждого Стр Из ТаблицаАвансов Цикл
			
			Если ОстатокРаспределения <= 0 Тогда
				Прервать; 
			КонецЕсли;
			
			Если (БУ И ТолькоПоПлатежкамСчетов И Стр.ПризнакОплатыСчетовДокумента <> Истина) Тогда
				Продолжить;
			КонецЕсли; 
			
			Нстр = ТЧ.Добавить();
			// --- 
			Нстр.ДокументАванса = Стр.ДокументАванса;
			Нстр.ДокументОплаты = Стр.ДокументОплаты;
			Нстр.СчетАванса = Стр.СчетАванса;
			Нстр.СчетЗадолженности = Стр.СчетЗадолженности;
			// --- 
			Если (БУ) Тогда
				Нстр.Счет = Стр.Счет;
				Если (ТолькоПоПлатежкамСчетов) Тогда
					ОстатокЗадолженности = ОстаткиЗачетаПоАктированию.НайтиПоЗначению(Стр.Счет);
					Если (ОстатокЗадолженности = Неопределено) Тогда
						ОстатокЗадолженности = ОстаткиЗачетаПоАктированию.Добавить(Стр.Счет, Формат(Стр.Задолженность,"ЧН=; ЧГ="));
					КонецЕсли;
					НезачтенноеАктированноеСальдо = Число(ОстатокЗадолженности.Представление);
					Нстр.СуммаЗачета = Мин(ОстатокРаспределения,Стр.Аванс,НезачтенноеАктированноеСальдо);
					ОстатокЗадолженности.Представление = Формат(НезачтенноеАктированноеСальдо-Нстр.СуммаЗачета,"ЧН=; ЧГ=");
				Иначе
					Нстр.СуммаЗачета = Мин(ОстатокРаспределения,Стр.Аванс);
				КонецЕсли; 
			Иначе
				Нстр.СуммаЗачета = Мин(ОстатокРаспределения,Стр.Аванс);
			КонецЕсли; 
			// --- 
			_сф.Декремент(ОстатокРаспределения,Нстр.СуммаЗачета);
			Если (Нстр.СуммаЗачета = 0) Тогда
				ТЧ.Удалить(Нстр);
			КонецЕсли; 
			
		КонецЦикла; 
		
	КонецЕсли; 
	
	// --- 
	
	// сформируем текстовое представление платежки в ТЧ зачета авансов
	// ---------------------------------------------------------------------------- 
	Для Каждого Стр Из ТЧ Цикл
		
		Попытка
			
			Если (БУ) Тогда
				
				Если НЕ Стр.ДокументАванса.НомерВходящегоДокумента = "" Тогда
					ВхНомер = Строка(Стр.ДокументАванса.НомерВходящегоДокумента);
				Иначе
					ВхНомер = "";
				КонецЕсли;	
				
				Если НЕ Стр.ДокументАванса.ДатаВходящегоДокумента = Дата("00010101") Тогда
					ВхДата = Строка(Формат(Стр.ДокументАванса.ДатаВходящегоДокумента,"ДФ=dd.MM.yyyy"));
				Иначе
					ВхДата = "";
				КонецЕсли;
				
				Если ВхНомер = "" ИЛИ ВхДата = "" Тогда
					Стр.ПредставлениеДокументаАванса = "Не задан!" ;
				Иначе
					Стр.ПредставлениеДокументаАванса = "№" + ВхНомер + " от " + ВхДата;
				КонецЕсли;	 
				
			ИначеЕсли (ОЗ) Тогда 
				
				Стр.ПредставлениеДокументаАванса = Стр.ДокументОплаты.ПредставлениеДокумента;
				
			КонецЕсли; 
			
		Исключение
			
			Стр.ПредставлениеДокументаАванса = "№" + Строка(Стр.ДокументАванса.Номер) + " от " + Строка(Стр.ДокументАванса.Дата);
			
		КонецПопытки	
		
	КонецЦикла;	
	
	
	// --- 
КонецПроцедуры

Процедура СформироватьПредставлениеДокумента()
	// --- 
	
	стр = "";
	Если (Корректировка) Тогда
		
		Если ПредъявленСчет Тогда 
			стр = "Кор.счет №"+СокрЛП(НомерСчета)+" от "+Формат(ДатаСчета, "ДФ=dd.MM.yy"); 
		КонецЕсли;
		Если ПредъявленАкт Тогда 
			Если (ЗначениеЗаполнено(стр)) Тогда
				стр = стр + ";кор.а";
			Иначе
				стр = "Кор.а";
			КонецЕсли; 
			стр = стр+"кт №"+СокрЛП(НомерАкта)+" от "+Формат(ДатаАкта, "ДФ=dd.MM.yy");
		КонецЕсли;
		Если ПредъявленСФ Тогда 
			Если (ЗначениеЗаполнено(стр)) Тогда
				стр = стр + "; кор.с";
			Иначе
				стр = "Кор.с";
			КонецЕсли; 
			стр = стр + "/ф №"+СокрЛП(НомерСФ)+" от "+Формат(ДатаСФ, "ДФ=dd.MM.yy");
		КонецЕсли; 
		
	Иначе
		
		Если ПредъявленСчет Тогда 
			стр = "Счет №"+СокрЛП(НомерСчета)+" от "+Формат(ДатаСчета, "ДФ=dd.MM.yy"); 
		КонецЕсли;
		Если ПредъявленАкт Тогда 
			Если (ЗначениеЗаполнено(стр)) Тогда
				стр = стр + "; а";
			Иначе
				стр = "А";
			КонецЕсли; 
			стр = стр+"кт №"+СокрЛП(НомерАкта)+" от "+Формат(ДатаАкта, "ДФ=dd.MM.yy");
		КонецЕсли;
		Если ПредъявленСФ Тогда 
			Если (ЗначениеЗаполнено(стр)) Тогда
				стр = стр + "; с";
			Иначе
				стр = "С";
			КонецЕсли; 
			стр = стр + "/ф №"+СокрЛП(НомерСФ)+" от "+Формат(ДатаСФ, "ДФ=dd.MM.yy");
		КонецЕсли;

	КонецЕсли; 
		
	Если НЕ ЗначениеЗаполнено(стр) Тогда 
		стр = "<"+ЭтотОбъект+">";
	КонецЕсли;
	Если стр<>ПредставлениеДокумента Тогда 
		ПредставлениеДокумента = стр;
	КонецЕсли;	
	
	// --- 
КонецПроцедуры

Функция ПроверитьЗакрытиеГрузоперевозок() Экспорт 
	// --- 
	
	Возврат(CW_Мониторинг.ПроверитьЗакрытиеГрузоперевозок(ЭтотОбъект));
	
	// --- 
КонецФункции

Функция ПроверкаНомера(Документ, РежимЗаписи, Отказ) Экспорт
	
	Попытка
		Документ.Записать(РежимЗаписи);
	Исключение
		Сообщить(ОписаниеОшибки() + "Ведомый документ " + Документ + " записать не удалось!");
		
		Отказ = Истина;
	КонецПопытки;
	
	Возврат Отказ;
	
КонецФункции

Функция ВыполнитьАвтоматическийПодборСчетов(ВариантПодбора) Экспорт
	// --- 
	
	Объект = ЭтотОбъект;
	
	// настройки учетной политики 
	СтруктураНастроек = CW_Настройки.ПолучитьНастройкиОперативногоУчета(Объект.Организация,Перечисления.CW_ВидыОперативнойЗадолженности.Дебиторская);
	
	ИспользуетсяОперативнаяЗадолженность 	= СтруктураНастроек["ВедетсяОперативныйУчет"];
	РежимВводначальныхОстатков_ОЗ 			= СтруктураНастроек["ВводОстатков"];
	
	НастройкиОперативногоУчета = СтруктураНастроек["НастройкиОперативногоУчета"];
	КонтрольНоменклатуры 		= НастройкиОперативногоУчета["КонтрольНоменклатуры"];
	КонтрольПорядкаОтражения	= НастройкиОперативногоУчета["КонтрольПорядкаОтражения"];
	КонтрольНДС 				= НастройкиОперативногоУчета["КонтрольНДС"];
	
	Если (НЕ ИспользуетсяОперативнаяЗадолженность) Тогда
		
		Возврат(_УФКС.Ответ(1,"Не используется оперативная задолжненность"));
		
	КонецЕсли; 
	
	// ---------------------------------------------------------------------------- 
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	CW_АктированиеВходящихСчетовОстатки.Счет,
	               |	CW_АктированиеВходящихСчетовОстатки.ВсегоОстаток КАК Всего,
	               |	ЛОЖЬ КАК ЕстьСтроки,
	               |	CW_АктированиеВходящихСчетовОстатки.Грузоперевозка,
	               |	CW_АктированиеВходящихСчетовОстатки.Номенклатура,
	               |	CW_АктированиеВходящихСчетовОстатки.ПорядокОтражения,
	               |	CW_АктированиеВходящихСчетовОстатки.СтавкаНДС
	               |ИЗ
	               |	РегистрНакопления.CW_АктированиеВходящихСчетов.Остатки(
	               |			&Период,
	               |			Организация = &Организация
	               |				И Контрагент = &Контрагент
	               |				И Договор = &Договор
	               |				И Грузоперевозка = &Грузоперевозка
	               |				И ВЫБОР
	               |					КОГДА &Номенклатура = НЕОПРЕДЕЛЕНО
	               |						ТОГДА ИСТИНА
	               |					ИНАЧЕ Номенклатура = &Номенклатура
	               |				КОНЕЦ
	               |				И ВЫБОР
	               |					КОГДА &ПорядокОтражения = НЕОПРЕДЕЛЕНО
	               |						ТОГДА ИСТИНА
	               |					ИНАЧЕ ПорядокОтражения = &ПорядокОтражения
	               |				КОНЕЦ
	               |				И ВЫБОР
	               |					КОГДА &СтавкаНДС = НЕОПРЕДЕЛЕНО
	               |						ТОГДА ИСТИНА
	               |					ИНАЧЕ СтавкаНДС = &СтавкаНДС
	               |				КОНЕЦ) КАК CW_АктированиеВходящихСчетовОстатки
	               |ГДЕ
	               |	CW_АктированиеВходящихСчетовОстатки.ВсегоОстаток > 0";
	Если (ВариантПодбора = 0) Тогда
		Запрос.УстановитьПараметр("Период", ТекущаяДата());
	Иначе
		Запрос.УстановитьПараметр("Период", Объект.ДатаАкта);
	КонецЕсли; 
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	Запрос.УстановитьПараметр("Контрагент", Объект.Контрагент);
	Запрос.УстановитьПараметр("Договор", Объект.Договор); 
	// --- 
	ТЗУслуги = Объект.Услуги.Выгрузить();
	ТЗУслуги.Колонки.Добавить("СчетПодобран");
	ТЗУслуги.ЗаполнитьЗначения(Ложь,"СчетПодобран");
	
	// --- 
	
	ТаблицаОстатковАктирования = Неопределено;
	// --- 
	
	Для каждого СтрокаДокумента Из ТЗУслуги Цикл
		
		Запрос.УстановитьПараметр("Грузоперевозка", СтрокаДокумента.Грузоперевозка); 
		Запрос.УстановитьПараметр("Номенклатура", ?(КонтрольНоменклатуры,СтрокаДокумента.Номенклатура,Неопределено)); 	
		Запрос.УстановитьПараметр("ПорядокОтражения", ?(КонтрольПорядкаОтражения,СтрокаДокумента.ПорядокОтражения,Неопределено)); 	
		Запрос.УстановитьПараметр("СтавкаНДС", ?(КонтрольНДС,СтрокаДокумента.СтавкаНДС,Неопределено)); 	
		// --- 
		
		Отбор = Новый Структура;
		Отбор.Вставить("Грузоперевозка",СтрокаДокумента.Грузоперевозка);
		Если (КонтрольНоменклатуры) Тогда
			Отбор.Вставить("Номенклатура",СтрокаДокумента.Номенклатура);
		КонецЕсли; 
		Если (КонтрольПорядкаОтражения) Тогда
			Отбор.Вставить("ПорядокОтражения",СтрокаДокумента.ПорядокОтражения);
		КонецЕсли; 
		Если (КонтрольНДС) Тогда
			Отбор.Вставить("СтавкаНДС",СтрокаДокумента.СтавкаНДС);
		КонецЕсли; 
		
		// --- 
		
		ПоДаннымЗапроса = Ложь;
		
		Если (ТаблицаОстатковАктирования = Неопределено) Тогда
			ТЗ = Запрос.Выполнить().Выгрузить();
			ПоДаннымЗапроса = Истина;
			ТаблицаОстатковАктирования = ТЗ.СкопироватьКолонки();	
		Иначе
			// пробуем найти
			ТЗ = ТаблицаОстатковАктирования.НайтиСтроки(Отбор);
			Если (ТЗ.Количество() = 0) Тогда
				ТЗ = Запрос.Выполнить().Выгрузить();
				ПоДаннымЗапроса = Истина;
			КонецЕсли; 
		КонецЕсли; 
		
		Если (ПоДаннымЗапроса) Тогда
			
			МассивУдаления = Новый Массив;
			Для каждого Стр Из ТЗ Цикл
				Если (Стр.Счет.Пустая()) Тогда
					МассивУдаления.Добавить(Стр);
				КонецЕсли; 
			КонецЦикла; 
			_сф.к_УдалитьЭлементыПоМассиву(ТЗ,МассивУдаления);
			
			// --- 
			
			// переносим в таблицу остатков
			Для каждого Стр Из ТЗ Цикл
				Нстр = ТаблицаОстатковАктирования.Добавить();
				ЗаполнитьЗначенияСвойств(Нстр,Стр);
			КонецЦикла; 
			
		КонецЕсли; 
		
		// --- 
		
		КоличествоСтрок = ТЗ.Количество();
		Если (КоличествоСтрок = 1) Тогда
			
			// подставляем счет
			Если (СтрокаДокумента.Всего <= ТЗ[0].Всего) Тогда
				
				СтрокаДокумента.Счет = ТЗ[0].Счет;
				СтрокаДокумента.СчетПодобран = Истина;
				// --- 
				_сф.Декремент(ТЗ[0].Всего,СтрокаДокумента.Всего);
				
			КонецЕсли; 
			
		ИначеЕсли (КоличествоСтрок > 1) Тогда 
			
			// анализируем, ищем строку
			СчетПодобран = Ложь;
			Для каждого СтрокаТЗ Из ТЗ Цикл
				
				Если (СчетПодобран) Тогда
					Прервать;
				КонецЕсли; 
				Отбор = Новый Структура("Грузоперевозка,Номенклатура",СтрокаДокумента.Грузоперевозка,СтрокаДокумента.Номенклатура);
				УдовлетворяющиеСтроки = _сф.к_НайтиСтроки(СтрокаТЗ.Счет.Услуги,Отбор);
				Если (УдовлетворяющиеСтроки.Количество()<>0) Тогда
					
					Для каждого Стр Из УдовлетворяющиеСтроки Цикл
						
						Если (Стр.Всего >= СтрокаДокумента.Всего) Тогда
							СтрокаТЗ.ЕстьСтроки = Истина;
						КонецЕсли; 
						
						Если (Стр.Всего = СтрокаДокумента.Всего) Тогда
							
							СтрокаДокумента.Счет = СтрокаТЗ.Счет;
							СтрокаДокумента.СчетПодобран = Истина;
							_сф.Декремент(СтрокаТЗ.Всего,СтрокаДокумента.Всего);
							СчетПодобран = Истина;
							Продолжить;
							
						КонецЕсли; 
						
					КонецЦикла; 
					
				КонецЕсли; 
				
			КонецЦикла; 
			
			Если (НЕ СчетПодобран) Тогда
				
				// берем первую строку из таблицы с соответствующими строками
				ЕстьСтроки = Ложь;
				Для каждого Стр Из ТЗ Цикл
					
					Если (Стр.ЕстьСтроки) Тогда
						ЕстьСтроки = Истина;
						Прервать;
					КонецЕсли; 
					
				КонецЦикла; 
				
				Если (ЕстьСтроки) Тогда
					
					// подставляем счет
					Для каждого Стр Из ТЗ Цикл
						
						Если (Стр.ЕстьСтроки) Тогда
							
							Если (Стр.Всего >= СтрокаДокумента.Всего) Тогда
								
								СтрокаДокумента.Счет = Стр.Счет;
								СтрокаДокумента.СчетПодобран = Истина;	
								// --- 
								_сф.Декремент(Стр.Всего, СтрокаДокумента.Всего);
								
							КонецЕсли; 
							
						КонецЕсли; 
						
					КонецЦикла; 
					
				Иначе
					
					Если (ТЗ[0].Всего >= СтрокаДокумента.Всего) Тогда
						
						СтрокаДокумента.Счет = ТЗ[0].Счет;
						СтрокаДокумента.СчетПодобран = Истина;
						// --- 
						_сф.Декремент(ТЗ[0].Всего,СтрокаДокумента.Всего);
						
					КонецЕсли; 
					
				КонецЕсли; 
				
			КонецЕсли; 
			
		КонецЕсли; 
		
	КонецЦикла; 
	
	// анализируем и переносим найденные счета в 
	КоличествоНеподобранных = ТЗУслуги.Скопировать(Новый Структура("СчетПодобран",Ложь)).Количество();
	
	КолонкаСчетов = ТЗУслуги.Скопировать(,"Счет");
	КолонкаСчетов.Свернуть("Счет");
	Счета = КолонкаСчетов.ВыгрузитьКолонку("Счет");
	
	Если (Счета.Количество()=1 И КоличествоНеподобранных = 0) Тогда
		
		Объект.СписокСчетов = Ложь;
		Объект.Счет = Счета[0];
		
	Иначе
		
		Объект.СписокСчетов = Истина;
		Объект.Счет = Документы.CW_ДоходыПоГрузоперевозке.ПустаяСсылка();
		// --- 
		// переносим в ТЧ
		ВТЧ = Объект.Услуги.Выгрузить();
		ВТЧ.ЗагрузитьКолонку(ТЗУслуги.ВыгрузитьКолонку("Счет"),"Счет");
		Объект.Услуги.Загрузить(ВТЧ);
		
	КонецЕсли; 
	// --- 
	ТекстСообщения = "";
	Если (КоличествоНеподобранных=0) Тогда
		ТекстСообщения = "Счета подобраны.";
	Иначе
		ТекстСообщения = "Для "+Строка(КоличествоНеподобранных)+" строк(и) подобрать счета не удалось.";
	КонецЕсли; 
	Ответ = _УФКС.Ответ(,ТекстСообщения);
	
	Возврат(Ответ);
	
	// --- 
КонецФункции

#КонецЕсли