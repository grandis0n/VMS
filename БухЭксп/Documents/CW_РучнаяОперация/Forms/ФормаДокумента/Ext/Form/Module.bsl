&НаКлиенте
Перем ИдентификаторСтрокиПроводки;

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Ключ.Пустая() Тогда
		Объект.Организация 		= CW_Настройки.ОсновнаяОрганизация();
		Объект.Ответственный	= Пользователи.ТекущийПользователь();

		УстановитьСостояниеДокумента("НезаписанныйДокумент");
	Конецесли;
	
	//Внешние подклчюаемые команды
	CW_ПодключаемыеКомандыСервер.ПриСозданииНаСервере(ЭтотОбъект);
	
	
КонецПроцедуры     

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ИзменитьПараметрыВыбораПолейСубконто(ЭтотОбъект, "Дт");
	ИзменитьПараметрыВыбораПолейСубконто(ЭтотОбъект, "Кт");

КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	ПодготовитьФормуНаСервере(ТекущийОбъект.Ссылка);
	УстановитьСостояниеДокумента();

КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	ПодготовитьФормуНаСервере(ТекущийОбъект.Ссылка);
	УстановитьСостояниеДокумента();

КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	Объект.АктивностьДвижений = АктивностьДвижений;
	
	ДополнитьДанныеПроводок(Отказ);
	
	СуммаНабора = Объект.Движения.CW_МСФО.Итог("Сумма");
	
	Если СуммаНабора <> Объект.СуммаОперации Тогда
		
		Отказ = Истина;
		
		Сообщение = новый СообщениеПользователю;
		Сообщение.Текст 		= "Сумма операции не равна сумме по проводкам!";
		Сообщение.Поле 			= "Объект.СуммаОперации";
		Сообщение.Сообщить();
		
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура УстановитьСостояниеДокумента(СтрокаУказаниеСтатуса = Неопределено)
	
	Если СтрокаУказаниеСтатуса = "НезаписанныйДокумент" Тогда
		СостояниеДокумента = 0;	
	ИначеЕсли Объект.ПометкаУдаления Тогда
		СостояниеДокумента = 2;
	ИначеЕсли НЕ АктивностьДвижений Тогда
		СостояниеДокумента = 11;
	Иначе
		СостояниеДокумента = 1;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ДополнитьДанныеПроводок(Отказ)
	
	ОбъектДанных = ДанныеФормыВЗначение(Объект, Тип("ДокументОбъект.CW_РучнаяОперация"));    // Преобразования данных формы в объект
    УстановитьСоответствиеОбъектаИРеквизитаФормы(ОбъектДанных, "Объект");    					// Установка соответствия
	
	Для каждого СтроокаНабора Из Объект.Движения.CW_МСФО Цикл

		ИндексСтроки = СтроокаНабора.ПолучитьИдентификатор();
		
		СтроокаНабора.Период 		= Объект.Дата;
		СтроокаНабора.Организация 	= Объект.Организация;
		
		Если СтроокаНабора.СчетДт.ЗапретитьИспользоватьВПроводках Тогда
			
			Сообщение = новый СообщениеПользователю;
			Сообщение.Текст 		= "Счет "+СокрЛП(СтроокаНабора.СчетДт)+" является группой, его запрещено использовать в проводках!";
			Сообщение.Поле  		= "Движения.CW_МСФО["+ИндексСтроки+"].СчетДт";
			Сообщение.УстановитьДанные(ОбъектДанных);
			Сообщение.Сообщить();
			
			Отказ = истина;
		КонецЕсли;
		
		Если СтроокаНабора.СчетКт.ЗапретитьИспользоватьВПроводках Тогда
			Сообщение = новый СообщениеПользователю;
			Сообщение.Текст 		= "Счет "+СокрЛП(СтроокаНабора.СчетКт)+" является группой, его запрещено использовать в проводках!";
			Сообщение.Поле  		= "Движения.CW_МСФО["+ИндексСтроки+"].СчетКт";
			Сообщение.ПутьКДанным   = "ЭтаФорма";
			Сообщение.УстановитьДанные(ОбъектДанных);
			Сообщение.Сообщить();
			
			Отказ = истина;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ПодготовитьФормуНаСервере(ДокументДвижений)

	ПрочитатьДвиженияДокумента(ДокументДвижений);
	ЗаполнитьДобавленныеКолонкиТаблиц();
	
КонецПроцедуры

&НаСервере
Процедура ПрочитатьДвиженияДокумента(ДокументДвижений)
	
	АктивностьДвижений = Истина;
	
	НаборЗаписей = РегистрыБухгалтерии.CW_МСФО.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Регистратор.Установить(ДокументДвижений);
	НаборЗаписей.Прочитать();
	
	Если ДокументДвижений = Объект.Ссылка Тогда
		Если НаборЗаписей.Количество() > 0 Тогда
			АктивностьДвижений = АктивностьДвижений И НаборЗаписей[0].Активность;
		КонецЕсли;
	КонецЕсли;
	
	УстановитьКартинкуГруппы();
		
КонецПроцедуры 

&НаСервере
Процедура ПереключитьАктивностьДвиженийНаСервере()
	
	НоваяАктивность = НЕ АктивностьДвижений;
	
	Набор = ДанныеФормыВЗначение(Объект.Движения.CW_МСФО, Тип("РегистрБухгалтерииНаборЗаписей.CW_МСФО"));	
	Набор.УстановитьАктивность(НоваяАктивность);
	Набор.Записать();
	
	ЗначениеВДанныеФормы(Набор, Объект.Движения.CW_МСФО);
	
	АктивностьДвижений = НоваяАктивность;
	
	ПодготовитьФормуНаСервере(Объект.Ссылка);
	УстановитьСостояниеДокумента();
	УстановитьКартинкуГруппы();
	
	
КонецПроцедуры

&НаСервере
Процедура УстановитьКартинкуГруппы()
	
	Элементы.СтраницаПроводки.Картинка = ?(АктивностьДвижений,БиблиотекаКартинок.ЖурналПроводок, БиблиотекаКартинок.ЖурналПроводокНеактивный);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДобавленныеКолонкиТаблиц()

	ПоляОбъектаДт = Новый Структура(
		"Субконто1, Субконто2, Субконто3, Подразделение, Валютный, Количественный",
		"СубконтоДт1", "СубконтоДт2", "СубконтоДт3", "ПодразделениеДт", "ВалютныйДт", "КоличественныйДт");
	ПоляОбъектаКт = Новый Структура(
		"Субконто1, Субконто2, Субконто3, Подразделение, Валютный, Количественный",
		"СубконтоКт1", "СубконтоКт2", "СубконтоКт3", "ПодразделениеКт", "ВалютныйКт", "КоличественныйКт");

	Для каждого Проводка Из Объект.Движения.CW_МСФО Цикл
		CW_БухгалтерскийУчетКлиентСерверМСФО.УстановитьДоступностьСубконто(Проводка.СчетДт, Проводка, ПоляОбъектаДт, Ложь);
		CW_БухгалтерскийУчетКлиентСерверМСФО.УстановитьДоступностьСубконто(Проводка.СчетКт, Проводка, ПоляОбъектаКт, Ложь);
		ЗаполнитьНадписиВПроводке(Проводка, "Дт");
		ЗаполнитьНадписиВПроводке(Проводка, "Кт");
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДобавленныеКолонкиТаблицПоСтроке(ИдентификаторСтроки, ДтКт)
	
	ПоляОбъекта = Новый Структура(
		"Субконто1, Субконто2, Субконто3, Подразделение, Валютный, Количественный",
		"Субконто"+ДтКт+"1", "Субконто"+ДтКт+"2", "Субконто"+ДтКт+"3", "Подразделение"+ДтКт, "Валютный"+ДтКт, "Количественный"+ДтКт);

	Проводка = Объект.Движения.CW_МСФО.НайтиПоИдентификатору(ИдентификаторСтроки);
	
	CW_БухгалтерскийУчетКлиентСерверМСФО.УстановитьДоступностьСубконто(Проводка["Счет"+ДтКт], Проводка, ПоляОбъекта, Ложь);
	ЗаполнитьНадписиВПроводке(Проводка, ДтКт);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьНадписиВПроводке(Проводка, ДтКт)
	
	Проводка["НадписьКоличество"+ДтКт] 	= ?(Проводка["Количественный"+ДтКт+"Доступность"]	, НСтр("ru = 'Quan.:'"), "");
	Проводка["НадписьВалюта"+ДтКт] 		= ?(Проводка["Валютный"+ДтКт+"Доступность"]			, НСтр("ru = 'Curr.:'"), "");
	
КонецПроцедуры

&НаКлиенте
Процедура ПереключитьАктивностьДвижений(Команда)

	Если Объект.ПометкаУдаления Тогда
		ПоказатьПредупреждение( , 
			НСтр("ru = 'Операция помечена на удаление, поэтому переключить активность нельзя.
        	|Снимите пометку удаления.'"));
		Возврат;
	КонецЕсли;
	
	ПереключитьАктивностьДвиженийНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ДвиженияCW_МСФОСчетДтПриИзменении(Элемент)

	ИдентификаторСтроки = Элементы.ДвиженияCW_МСФО.ТекущиеДанные.ПолучитьИдентификатор();
	
	ЗаполнитьДобавленныеКолонкиТаблицПоСтроке(ИдентификаторСтроки, "Дт");
	
КонецПроцедуры

&НаКлиенте
Процедура ДвиженияCW_МСФОСчетКтПриИзменении(Элемент)
	
	ИдентификаторСтроки = Элементы.ДвиженияCW_МСФО.ТекущиеДанные.ПолучитьИдентификатор();
	ЗаполнитьДобавленныеКолонкиТаблицПоСтроке(ИдентификаторСтроки, "Кт");
	
КонецПроцедуры

&НаКлиенте
Процедура ДвиженияCW_МСФОВалютнаяСуммаДтПриИзменении(Элемент)
	
	ПересчитатьСуммуСтрокиИзВалюты("Дт");
		
КонецПроцедуры

&НаКлиенте
Процедура ДвиженияCW_МСФОВалютнаяСуммаКтПриИзменении(Элемент)
	
	ПересчитатьСуммуСтрокиИзВалюты("Кт");
	
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьСуммуСтрокиИзВалюты(ДтКт)
	
	ТекущиеДанные = Элементы.ДвиженияCW_МСФО.ТекущиеДанные;
	
	СтруктураДанных = Новый Структура;
	СтруктураДанных.Вставить("Валюта"	, ТекущиеДанные["Валюта"+ДтКт]); 
	СтруктураДанных.Вставить("СуммаВал"	, ТекущиеДанные["ВалютнаяСумма"+ДтКт]); 
	
	Если ЗначениеЗаполнено(ТекущиеДанные["Валюта"+ДтКт]) Тогда
		ТекущиеДанные.Сумма	= ПолучитьСуммыПоКурсу(СтруктураДанных);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДвиженияCW_МСФОВалютаДтПриИзменении(Элемент)
	ПересчитатьСуммуСтрокиИзВалюты("Дт");
КонецПроцедуры

&НаКлиенте
Процедура ДвиженияCW_МСФОВалютаКтПриИзменении(Элемент)
	ПересчитатьСуммуСтрокиИзВалюты("Кт");
КонецПроцедуры



&НаСервере
Функция ПолучитьСуммыПоКурсу(СтруктураДанных)
	
	ВалютаУчетаМСФО 		= Константы.CW_МСФО_ВалютаУчета.Получить();
	ОтносительноВалютыМСФО 	= Константы.CW_МСФО_КурсыВалютыОтносительноВалютыМСФО.Получить();
	
	Если ОтносительноВалютыМСФО = 1 Тогда
		
		СтруктураКурсаМСФО 	= РегистрыСведений.CW_МСФО_КурсыВалют.ПолучитькурсВалютыПоМСФО(Объект.Дата, СтруктураДанных.Валюта);
		СуммаРег 			= CW_Финансы.ПересчитатьИзВалютыВВалюту(СтруктураДанных.СуммаВал,СтруктураДанных.Валюта,ВалютаУчетаМСФО,СтруктураКурсаМСФО.Курс,1,СтруктураКурсаМСФО.Кратность,1);
		
	Иначе
		
		СуммаРег = РаботаСКурсамиВалют.ПересчитатьВВалюту(СтруктураДанных.СуммаВал, СтруктураДанных.Валюта, ВалютаУчетаМСФО, Объект.Дата); 
		
	КонецЕсли;

	
	Возврат СуммаРег;
	
КонецФункции

&НаКлиенте
Процедура ДвиженияCW_МСФОСубконтоДт1ПриИзменении(Элемент)
	ИзменитьПараметрыВыбораПолейСубконто(ЭтотОбъект, "Дт");
