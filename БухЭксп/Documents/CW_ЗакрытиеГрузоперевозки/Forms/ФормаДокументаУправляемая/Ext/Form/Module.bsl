&НаКлиенте
Процедура НомерАктаПриИзменении(Элемент)
	НомерАктаПриИзмененииНаКлиенте();
КонецПроцедуры

&НаКлиенте
Процедура НомерАктаОчистка(Элемент, СтандартнаяОбработка)
	НомерАктаПриИзмененииНаКлиенте();
КонецПроцедуры

&НаКлиенте
Процедура НомерАктаПриИзмененииНаКлиенте()
	
	// значение номера не пустое	
	Если ЗначениеЗаполнено(Объект.НомерАкта) Тогда
		
		// Если заполнили номер документа, а дата пустая, 
		// то установим ее равной дате документа
		Если Не ЗначениеЗаполнено(Объект.ДатаАкта) Тогда
			
			Объект.ДатаАкта = Объект.Дата;			
			
			// если изменили дату акта, то нужно убедиться в том,
			// что дата акта совпадает с датой с/ф...
			Если ЗначениеЗаполнено(Объект.ДатаСчетаФактуры) Тогда
				Объект.ДатаСчетаФактуры = Объект.ДатаАкта;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	_ОбновитьНомераДокументов();

	// регенерируем форму
	ПервичныеДокументыУправлениеЭлементамиФормы();

КонецПроцедуры

&НаКлиенте
Процедура ДатаАктаПриИзменении(Элемент)
	
	ДатаАктаПриИзмененииНаКлиенте();
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаАктаОчистка(Элемент, СтандартнаяОбработка)
	
	ДатаАктаПриИзмененииНаКлиенте();
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаАктаПриИзмененииНаКлиенте()
	
	// если очистили дату акта, то принудительно очистим номер документа,
	// т.к. порядок установки даты акта в этом случае будет не определен.
	// В таком случае система при проведении заново присвоит новый номер 
	// акта и установит ему дату, равной дате документа 
	Если Не ЗначениеЗаполнено(Объект.ДатаАкта) Тогда
		Объект.НомерАкта = "";
		
		// аналогично поступаем со с/ф
		Объект.НомерСчетаФактуры = "";
		Объект.ДатаСчетаФактуры = Дата(1,1,1);
		Возврат;
	КонецЕсли;
	
	// если не формируется счет, то дата акта не может быть меньше даты документа
	Если Объект.ДатаАкта < Объект.Дата Тогда
		Объект.ДатаАкта = Объект.Дата;			
	КонецЕсли;
	
	// дата акта всегда должна совпадать с датой с/ф
	Если Объект.ДатаАкта <> Объект.ДатаСчетаФактуры Тогда
		Объект.ДатаСчетаФактуры = Объект.ДатаАкта;
	КонецЕсли;
	
	_ОбновитьНомераДокументов();
	//// регенерируем форму
	ПервичныеДокументыУправлениеЭлементамиФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура ПервичныеДокументыВремяАкта(Команда)
	
	ДополнительныеПараметры = Новый Структура("НачальнаяДата",Объект.ДатаАкта);
	ОписаниеОповещения = Новый ОписаниеОповещения("ОбработкаИзмененияДатыАкта",ЭтотОбъект,ДополнительныеПараметры); 
	ПоказатьВводДаты(ОписаниеОповещения,Объект.ДатаАкта,"Время акта",ЧастиДаты.Время);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаИзмененияДатыАкта(РезультатВыбора, ДополнительныеПараметры) Экспорт 
	
	Если РезультатВыбора = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// переносим введённое время в дату акта
	ДатаАктаСтрокой 	= Формат(ДополнительныеПараметры.НачальнаяДата,"ДФ=yyyyMMdd");
	ВремяАктаСтрокой 	= Формат(РезультатВыбора,"ДФ=HHmmss");
	
	Объект.ДатаАкта 	= Дата(ДатаАктаСтрокой+ВремяАктаСтрокой);
	
	// синхронизируем время счета-фактуры
	Если ЗначениеЗаполнено(Объект.ДатаСчетаФактуры) Тогда
		Объект.ДатаСчетаФактуры = Объект.ДатаАкта;	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ФормируетсяСчетФактураПриИзменении(Элемент)
	
	Если Объект.ФормируетсяСчетФактура Тогда
		// выполним проверку на соответствие даты акта (и соответственно с/ф) дате документа
		ДатаАктаПриИзмененииНаКлиенте();
	Иначе
		Объект.НомерСчетаФактуры = "";
		Объект.ДатаСчетаФактуры = Неопределено;
	КонецЕсли; 
	
	_ОбновитьНомераДокументов();

	ПервичныеДокументыУправлениеЭлементамиФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура НомерСчетаФактурыПриИзменении(Элемент)
	
	НомерСчетаФактурыПриИзмененииНаКлиенте();
	
КонецПроцедуры

&НаКлиенте
Процедура НомерСчетаФактурыОчистка(Элемент, СтандартнаяОбработка)
	
	НомерСчетаФактурыПриИзмененииНаКлиенте();
	
КонецПроцедуры

&НаКлиенте
Процедура НомерСчетаФактурыПриИзмененииНаКлиенте()
	
	// если очистили номер документа, то очистим дату с/ф, 
	// т.к. в этом случае дата с/ф будет принудительно сформирована на основании даты акта
	Если Не ЗначениеЗаполнено(Объект.НомерСчетаФактуры) Тогда
		Объект.ДатаСчетаФактуры = Дата(1,1,1);
		
	// номер заполнили 
	Иначе
		
		// дата с/ф должна совпадать с датой акта или датой документа (в случае отсутствия акта)
		Если Не ЗначениеЗаполнено(Объект.ДатаСчетаФактуры) Тогда
			Объект.ДатаСчетаФактуры = ?(ЗначениеЗаполнено(Объект.ДатаАкта), Объект.ДатаАкта, Объект.Дата);
		КонецЕсли;
	КонецЕсли;
	
	_ОбновитьНомераДокументов();
	// регенерируем форму
	ПервичныеДокументыУправлениеЭлементамиФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура ПервичныеДокументыНомерСчетФактуры(Команда)
	
	// для пакетной нумерации нужен номер документа
	Если (Не ЗначениеЗаполнено(Объект.Дата)) и _ИспользуетсяПакетнаяНумерация() Тогда
		ПоказатьПредупреждение(,"Для автоматического присвоения номера счет-фактуры 
						|необходимо установить номер документа.");
		Возврат;
	КонецЕсли;
	
	// установить номер с/ф можно только при наличии даты акта
	Если Объект.ДатаАкта = Дата(1,1,1) Тогда
			ПоказатьПредупреждение(,"Для автоматического присвоения номера счет-фактуры 
						|необходимо установить дату акта.");
		Возврат;
	КонецЕсли;
	
	УстановитьНомерСчетаФактурыНаКлиенте();
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьНомерСчетаФактурыНаКлиенте()
	
	ПорядокПрисвоенияНомеров = _ДС().УП.ПорядокПрисвоенияНомеров;

	// если дата не задана, то устанавливаем ее равной акту
	СтарыйНомерСчетаФактуры = Объект.НомерСчетаФактуры;
	Если Объект.ДатаСчетаФактуры = Дата(1,1,1) Тогда
		Объект.ДатаСчетаФактуры = Объект.ДатаАкта;
	КонецЕсли;
	
	Если ПорядокПрисвоенияНомеров = ПредопределенноеЗначение("Перечисление.CW_ПорядокПрисвоенияИсходящихНомеров.ВПределахДаты") ИЛИ
		ПорядокПрисвоенияНомеров =  ПредопределенноеЗначение("Перечисление.CW_ПорядокПрисвоенияИсходящихНомеров.СплошнаяНумерация") 
		Тогда
		
		Объект.НомерСчетаФактуры = Объект.Номер;
		
	ИначеЕсли ПорядокПрисвоенияНомеров =  ПредопределенноеЗначение("Перечисление.CW_ПорядокПрисвоенияИсходящихНомеров.НезависимаяНумерация") Тогда 
		
		Объект.НомерСчетаФактуры = ПолучитьНомерСчетаФактурыНаСервере();
	
	ИначеЕсли ПорядокПрисвоенияНомеров =  ПредопределенноеЗначение("Перечисление.CW_ПорядокПрисвоенияИсходящихНомеров.ВнешнийНумератор") Тогда 
		
		ВнешщнийНумераторУстановитьНомерСчетаФактурыНаСервере();
		
	КонецЕсли; 
	
	// если не удалось установить номер с/ф, то восстановим дату с/ф
	Если Не ЗначениеЗаполнено(Объект.НомерСчетаФактуры) Тогда
		Объект.НомерСчетаФактуры = СтарыйНомерСчетаФактуры;
	КонецЕсли;
	
	_ОбновитьНомераДокументов();
	
КонецПроцедуры


&НаСервере
Процедура ПервичныеДокументыПриСозданииНаСервере()
	
	ПравоРедактированияНомеровПервичныхДокументов = CW_ПраваДоступа.ПравоДоступно("РедактированиеНомеровПервичныхДокументов");
	
	Элементы.НомерАкта.Доступность 					= ПравоРедактированияНомеровПервичныхДокументов;
	Элементы.ПервичныеДокументыНомерАкта.Видимость 	= ПравоРедактированияНомеровПервичныхДокументов;
	Элементы.НомерСчетаФактуры.Доступность 					= ПравоРедактированияНомеровПервичныхДокументов;
	Элементы.ПервичныеДокументыНомерСчетФактуры.Видимость 	= ПравоРедактированияНомеровПервичныхДокументов;
	
	ПервичныеДокументыУправлениеЭлементамиФормы();
	

КонецПроцедуры

&НаСервере
Процедура ПервичныеДокументыУправлениеЭлементамиФормы()
	
	// акт
	Элементы.ГруппаПараметрыСчетаФактуры.Доступность  = Объект.ФормируетсяСчетФактура;
	
КонецПроцедуры

&НаКлиенте
Процедура ПервичныеДокументыНомерАкта(Команда)

	// для пакетной нумерации нужен номер документа
	Если (Не ЗначениеЗаполнено(Объект.Номер)) и _ИспользуетсяПакетнаяНумерация() Тогда
		ПоказатьПредупреждение(,"Для автоматического присвоения номера акта 
						|необходимо установить номер документа.",10);
		Возврат;
	КонецЕсли;
	
	// присваиваем номер
	ПервичныеДокументыНомерАктаНаКлиенте();
	
КонецПроцедуры

&НаКлиенте
Процедура ПервичныеДокументыНомерАктаНаКлиенте()
	
	ПорядокПрисвоенияНомеров = _ДС().УП.ПорядокПрисвоенияНомеров;

	// если дата акта не задана
	СтараяДатаАкта = Объект.ДатаАкта;
	Если Объект.ДатаАкта = Дата(1,1,1) Тогда
		Объект.ДатаАкта = Объект.Дата;
	КонецЕсли; 
	
	Если ПорядокПрисвоенияНомеров = ПредопределенноеЗначение("Перечисление.CW_ПорядокПрисвоенияИсходящихНомеров.ВПределахДаты") ИЛИ
		 ПорядокПрисвоенияНомеров = ПредопределенноеЗначение("Перечисление.CW_ПорядокПрисвоенияИсходящихНомеров.СплошнаяНумерация") 
	Тогда
		
		Объект.НомерАкта = Объект.Номер;
		
	ИначеЕсли ПорядокПрисвоенияНомеров = ПредопределенноеЗначение("Перечисление.CW_ПорядокПрисвоенияИсходящихНомеров.НезависимаяНумерация") Тогда 
		
		ПолучитьНомерАктаНаСервере();
		
	ИначеЕсли ПорядокПрисвоенияНомеров = ПредопределенноеЗначение("Перечисление.CW_ПорядокПрисвоенияИсходящихНомеров.ВнешнийНумератор") Тогда 
		
		ВнешнийНумераторУстановитьНомерАктаНаСервере();
		
	КонецЕсли; 
	
	// если не удалось установить номер акта, то восстановим дату акта
	Если Не ЗначениеЗаполнено(Объект.НомерАкта) Тогда
		Объект.ДатаАкта = СтараяДатаАкта;
	КонецЕсли;
	
	_ОбновитьНомераДокументов();
	
КонецПроцедуры

&НаСервере
Процедура ВнешнийНумераторУстановитьНомерАктаНаСервере()
	
	ВнешнийНумератор = _ДС().УП.ВнешнийНумератор;
	ОбработкаНумерации = _ПО.ПолучитьОбработку(ВнешнийНумератор);
	ОбработкаНумерации.УстановитьНомерАкта(Объект);

КонецПроцедуры

&НаСервере
Процедура ВнешщнийНумераторУстановитьНомерСчетаФактурыНаСервере()
	
	
	ВнешнийНумератор = _ДС().УП.ВнешнийНумератор;
	ОбработкаНумерации = _ПО.ПолучитьОбработку(ВнешнийНумератор);
	ОбработкаНумерации.УстановитьНомерСчетаФактуры(Объект);

КонецПроцедуры


&наСервере
Функция ПолучитьНомерСчетаФактурыНаСервере()
	
	НовыйСФ = Документы.СчетФактураВыданный.СоздатьДокумент();
	НовыйСФ.ВидСчетаФактуры=Перечисления.ВидСчетаФактурыВыставленного.НаРеализацию;
	НовыйСФ.Организация = Объект.Организация;
	НовыйСФ.Дата = Объект.ДатаСчетаФактуры;
	НовыйСФ.УстановитьНовыйНомер();
	
	НомерСФ = НовыйСФ.Номер;
	
	НовыйСФ = Неопределено;
	
	Возврат НомерСФ;
	
КонецФункции

&наСервере
Функция ПолучитьНомерАктаНаСервере()
	
	НовыйАкт = Документы.РеализацияТоваровУслуг.СоздатьДокумент();
	НовыйАкт.Организация = Объект.Организация;
	НовыйАкт.Дата = Объект.ДатаАкта;
	НовыйАкт.УстановитьНовыйНомер();
	// --- 
	НомерАкта = НовыйАкт.Номер;
	НовыйАкт = Неопределено;
	
	
	Возврат НомерАкта;
	
КонецФункции

