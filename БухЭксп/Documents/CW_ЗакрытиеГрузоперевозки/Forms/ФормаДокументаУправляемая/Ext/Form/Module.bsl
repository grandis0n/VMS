#Область ИнициализацияФормы 

&НаСервере
Процедура _СформироватьЗаголовок()
	
	ЗаголовокДокумента = 
		"Выявление финансового результата " + 
		?(ЗначениеЗаполнено(Объект.Ссылка), " "+Объект.Номер+" от "+Объект.Дата, " (создание)")
	;
	ЭтаФорма.Заголовок = ЗаголовокДокумента;
	
КонецПроцедуры

&НаСервере
Процедура _УстановитьДоговор()
	// --- 
	
	// пробуем получить договор с покупателем
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	CW_ДоговорыПоГрузоперевозкам.Ссылка,
	               |	CW_ДоговорыПоГрузоперевозкам.ДатаДоговора
	               |ИЗ
	               |	Справочник.CW_ДоговорыПоГрузоперевозкам КАК CW_ДоговорыПоГрузоперевозкам
	               |ГДЕ
	               |	CW_ДоговорыПоГрузоперевозкам.ВидДоговора = &ВидДоговора
	               |	И CW_ДоговорыПоГрузоперевозкам.Владелец = &Владелец
	               |	И CW_ДоговорыПоГрузоперевозкам.ПометкаУдаления = ЛОЖЬ
	               |	И ВЫБОР
	               |			КОГДА CW_ДоговорыПоГрузоперевозкам.СрокДействияДоговора = ДАТАВРЕМЯ(1, 1, 1)
	               |				ТОГДА ИСТИНА
	               |			ИНАЧЕ CW_ДоговорыПоГрузоперевозкам.СрокДействияДоговора > &ТекущаяДата
	               |		КОНЕЦ
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	CW_ДоговорыПоГрузоперевозкам.ДатаДоговора УБЫВ";
	Запрос.УстановитьПараметр("ВидДоговора", Перечисления.ВидыДоговоровКонтрагентов.СПокупателем);
	Запрос.УстановитьПараметр("Владелец", Объект.Контрагент); 
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДата()); 
	ТЗ = Запрос.Выполнить().Выгрузить();
	КоличествоДоговоров = _сф.Количество(ТЗ);
	Если (КоличествоДоговоров=0) Тогда
		// ничего не делаем
	Иначе
		Объект.Договор = ТЗ[0].Ссылка;
		Объект.Организация = Объект.Договор.Организация;
		_СформироватьОбщиеПараметры();   
		
		//Подсистема.УчетПриложенийДоговоров
		CW_УчетПриложенийДоговоровСервер.ПриИзмененииДоговораНаСервере(ЭтаФорма);
		//Подсистема.УчетПриложенийДоговоров
		
	КонецЕсли; 
	
	// --- 
КонецПроцедуры

#КонецОбласти 

#Область ОбщиеПараметры 

Функция _ДС()
	// --- 
	
	Возврат(ДС[0].Значение);
	
	// --- 
КонецФункции

&НаСервере
Процедура _СформироватьОбщиеПараметры(СписокПараметров=Неопределено)
	// --- 
	
	ДокументОбъект = РеквизитФормыВЗначение("Объект");
	ДокументОбъект.СформироватьОбщиеПараметры(СписокПараметров);
	
	Если СписокПараметров = Неопределено Тогда
		ДС.Очистить();
		ДС.Добавить(ДокументОбъект.ДополнительныеСвойства);
	Иначе
		
		СоответствиеПарамеров = Новый Соответствие;
		СоответствиеПарамеров.Вставить("ПараметрыДоговора","ПД");
		СоответствиеПарамеров.Вставить("Константы","КО");
		СоответствиеПарамеров.Вставить("УчетнаяПолитика","УП");
		СоответствиеПарамеров.Вставить("НастройкиПользователя","НП");
		
		МассивПараметров = _сф.м_СоздатьИзСтроки(СписокПараметров,",");
		
		ДСС = _ДС();
		
		Для каждого Параметр Из МассивПараметров Цикл
			
			Ключ = СоответствиеПарамеров.Получить(Параметр);
			_сф.ст_УстановитьСвойство(ДСС,Ключ,ДокументОбъект.ДополнительныеСвойства[Ключ]);
			
		КонецЦикла; 
		
		ДС.Очистить();
		ДС.Добавить(ДСС);
		
	КонецЕсли; 
	
	// --- 
КонецПроцедуры

#КонецОбласти 

#Область УправлениеЭлементамиФормы

&НаСервере
Процедура _УправлениеЭлементамиФормы()
	
	Элементы.СтраницаКомментарий.Заголовок = " Комментарий" +?(ЗначениеЗаполнено(Объект.Комментарий)," (*)","");
	Элементы.Аналитика.Заголовок = ?(ВариантЗакрытия = 0, "Заказ","Грузоперевозка");
	
КонецПроцедуры

#КонецОбласти 

