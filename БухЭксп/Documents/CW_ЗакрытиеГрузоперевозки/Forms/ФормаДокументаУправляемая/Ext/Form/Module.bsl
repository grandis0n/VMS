&НаКлиенте
Процедура ПересчитатьСуммыСтроки(ТД)

	Если ТД.Свойство("Цена") Тогда
		ТД.Сумма  = ТД.Цена * ТД.Количество;
	КонецЕсли;
	
	ТД.НДС    = ТД.Сумма * СтавкаНДС(ТД.СтавкаНДС)/100;
	ТД.Всего  = ТД.Сумма + ТД.НДС;
	
КонецПроцедуры

