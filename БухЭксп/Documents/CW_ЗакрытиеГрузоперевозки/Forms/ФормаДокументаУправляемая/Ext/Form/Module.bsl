// РЕКВИЗИТЫ
// ----------------------------------------------------------------------------  

#Область ПакетДокументов 

&НаСервере
Процедура _ОбновитьНомераДокументов()
	
	// если номер акта не задан, то дата акта принудительно будет установлена равной дате документа
	Если (ЗначениеЗаполнено(Объект.НомерАкта)) Тогда
		ПредставлениеНомераАкта = СокрЛП(Объект.НомерАкта);
	Иначе
		ПредставлениеНомераАкта = "<...>";			
	КонецЕсли; 
	ПредставлениеДатыАкта = ?(Объект.ДатаАкта = Дата(1,1,1),"<...>",Формат(Объект.ДатаАкта,"ДФ=dd.MM.yyyy"));
	ПредставлениеАкта = "Отчёт экспедитора №" + ПредставлениеНомераАкта + " от " + ПредставлениеДатыАкта;
	
	// с/ф не формируется  
	Если Объект.ФормируетсяСчетФактура Тогда
		
		Если (ЗначениеЗаполнено(Объект.НомерСчетаФактуры)) Тогда
			ПредставлениеНомераСФ = СокрЛП(Объект.НомерСчетаФактуры);
		Иначе
			ПредставлениеНомераСФ = "<...>";			
		КонецЕсли; 
		ПредставлениеДатыСФ = ?(Объект.ДатаСчетаФактуры = Дата(1,1,1),"<...>",Формат(Объект.ДатаСчетаФактуры,"ДФ=dd.MM.yyyy"));
		
		ПредставлениеСчетаФактуры = "С/ф №" + ПредставлениеНомераСФ+" от " + ПредставлениеДатыСФ;
		
	// c/ф не формируется
	Иначе
		ПредставлениеСчетаФактуры = "<С/ф не формируется>";
	КонецЕсли; 
	
	ВедомыйДокументРеализация = Строка(Объект.ВедомыйДокумент);
	ВедомыйДокументСчетФактура = Строка(Объект.ВедомыйСчетФактура);
	
КонецПроцедуры

#КонецОбласти 

#Область ИзменениеОрганизации 

