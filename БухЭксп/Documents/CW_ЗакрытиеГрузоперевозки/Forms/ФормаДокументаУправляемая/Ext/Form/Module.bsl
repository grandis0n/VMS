#Область ЗаполнениеВознаграждения 

&НаКлиенте
Процедура ЗаполнитьВознаграждение(Команда)
	
	Если НЕ ЗначениеЗаполнено(Объект.Аналитика) Тогда 
		_УФК.ВывестиПредупреждение("Не выбрана аналитика!");
		Возврат;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Объект.Контрагент) Тогда 
		_УФК.ВывестиПредупреждение("Не выбран контрагент!");
		Возврат;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Объект.Договор) Тогда 
		_УФК.ВывестиПредупреждение("Не выбран договор!");
		Возврат;
	КонецЕсли;
	
	// ---------------------------------------------------------------------------- 
	
	Если ВалютаРегламентированногоУчетаРубль Тогда
		Если (Объект.Вознаграждение.Количество() <> 0 ИЛИ Объект.Расходы.Количество() <> 0 ИЛИ Объект.Доходы.Количество() <> 0) Тогда
			
			ПОВ = Новый ОписаниеОповещения("ОбработкаВопросаОчисткиТабличныхЧастей",ЭтотОбъект); 
			ПоказатьВопрос(ПОВ,"Табличные части ""Вознаграждение"", ""Расходы"" и ""Доходы"" будут очищены! Продолжить?", РежимДиалогаВопрос.ДаНет);
			
		Иначе
			
			ЗаполнитьВознаграждениеЭтап2();
			
		КонецЕсли; 
		
	Иначе
		
		Если  Объект.Расходы.Количество() <> 0 ИЛИ Объект.Доходы.Количество() <> 0 Тогда
			
			ПОВ = Новый ОписаниеОповещения("ОбработкаВопросаОчисткиТабличныхЧастей",ЭтотОбъект); 
			ПоказатьВопрос(ПОВ,"Табличные части ""Расходы"" и ""Доходы"" будут очищены! Продолжить?", РежимДиалогаВопрос.ДаНет);
			
		Иначе
			
			ЗаполнитьВознаграждениеЭтап2();
			
		КонецЕсли; 
	
		
	КонецЕсли;
	
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВопросаОчисткиТабличныхЧастей(Ответ, ДополнительныеПараметры) Экспорт 
	// --- 
	
	Если (Ответ = КодВозвратаДиалога.Да) Тогда
		ЗаполнитьВознаграждениеЭтап2();
	КонецЕсли;	
	
	// --- 
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьВознаграждениеЭтап2()
	// --- 
	
	ПОВ = Новый ОписаниеОповещения("ОбработкаВыбораСтавкиНДСДляЗаполнения",ЭтотОбъект); 
	СписокСтавокНДС = ПолучитьСписокСтавокНДС(Объект.Дата);
	СписокСтавокНДС.ПоказатьВыборЭлемента(ПОВ,"Выберите ставку НДС");
	
	// --- 
КонецПроцедуры


&НаКлиенте
Процедура ОбработкаВыбораСтавкиНДСДляЗаполнения(Ставка, ДополнительныеПараметры) Экспорт 
	// --- 
	
	Если (Ставка = Неопределено) Тогда
		
		_УФК.ВывестиПредупреждение("Не выбрана ставка НДС!");
		
	Иначе	
		
		Ответ = _ЗаполнитьВознаграждение(Ставка.Значение);
		Если (НЕ _УФКС.ВыполненоУспешно(Ответ)) Тогда
			_УФК.ВывестиПредупреждение(_УФКС.ПредставлениеОшибки(Ответ));
		КонецЕсли; 
		
		ОбновитьИтогиПоРасходам();
		ОбновитьИтогиПоДоходам();
		
		Если ВалютаРегламентированногоУчетаРубль Тогда
			ОбновитьИтогиПоВознаграждению();
		КонецЕсли;
		
	КонецЕсли;
	
	// --- 
КонецПроцедуры
  
  

&НаСервереБезКонтекста
Функция ПолучитьСписокСтавокНДС(ДатаДокумента) 
	
	СписокСтавокНДС = Новый СписокЗначений; 
	
	Для Каждого ЗначениеПеречисления Из Перечисления.СтавкиНДС Цикл
		СписокСтавокНДС.Добавить(ЗначениеПеречисления);
	КонецЦикла;
	
	Возврат СписокСтавокНДС;
	
КонецФункции

&НаСервере
Функция _ЗаполнитьВознаграждение(Ставка);
	// --- 
	
	// обновляем параметры
	_СформироватьОбщиеПараметры();
	
	Объект.Вознаграждение.Очистить();
	Объект.Расходы.Очистить();
	Объект.Доходы.Очистить();
	
	// ---------------------------------------------------------------------------- 
	
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ
	                      |	CW_ПеревыставлениеПоСтавкамОбороты.Регистратор КАК Регистратор,
	                      |	CW_ПеревыставлениеПоСтавкамОбороты.Грузоперевозка КАК Грузоперевозка,
	                      |	CW_ПеревыставлениеПоСтавкамОбороты.Номенклатура КАК Номенклатура,
	                      |	CW_ПеревыставлениеПоСтавкамОбороты.СтавкаНДС КАК СтавкаНДС,
	                      |	CW_ПеревыставлениеПоСтавкамОбороты.ВсегоПриход КАК ВсегоРубПриход,
	                      |	CW_ПеревыставлениеПоСтавкамОбороты.ВсегоРасход КАК ВсегоРубРасход,
	                      |	CW_ПеревыставлениеПоСтавкамОбороты.СуммаПриход КАК СуммаРубПриход,
	                      |	CW_ПеревыставлениеПоСтавкамОбороты.СуммаРасход КАК СуммаРубРасход,
	                      |	CW_ПеревыставлениеПоСтавкамОбороты.НДСПриход КАК НДСРубПриход,
	                      |	CW_ПеревыставлениеПоСтавкамОбороты.НДСРасход КАК НДСРубРасход,
	                      |	CW_ПеревыставлениеПоСтавкамОбороты.Регистратор.ПредставлениеДокумента КАК РегистраторПредставлениеДокумента
	                      |ИЗ
	                      |	РегистрНакопления.CW_ПеревыставлениеПоСтавкам.Обороты(
	                      |			,
	                      |			&КонПериода,
	                      |			Регистратор,
	                      |			Контрагент = &Контрагент
	                      |				И Договор = &ДоговорКонтрагента
						//Подсистема.УчетПриложенийДоговоров	
	                      |				И ПриложениеКДоговору = &ПриложениеКДоговору
						//Подсистема.УчетПриложенийДоговоров	
	                      |				И ВЫБОР
	                      |					КОГДА &ПоЗаказу = ИСТИНА
	                      |						ТОГДА Грузоперевозка.Заказ = &Заказ
	                      |					ИНАЧЕ Грузоперевозка = &Грузоперевозка
	                      |				КОНЕЦ) КАК CW_ПеревыставлениеПоСтавкамОбороты
	                      |ГДЕ
	                      |	CW_ПеревыставлениеПоСтавкамОбороты.Регистратор.Организация = &Организация
	                      |	И ВЫБОР
	                      |			КОГДА &ВестиУчетПоПодразделениям
	                      |				ТОГДА CW_ПеревыставлениеПоСтавкамОбороты.Регистратор.ПодразделениеОрганизации = &ПодразделениеОрганизации
	                      |			ИНАЧЕ ИСТИНА
	                      |		КОНЕЦ");
						  
	Запрос.УстановитьПараметр("Контрагент"			, Объект.Контрагент);					  
	Запрос.УстановитьПараметр("ДоговорКонтрагента"	, Объект.Договор);					  
	
	//Подсистема.УчетПриложенийДоговоров	
	Запрос.УстановитьПараметр("ПриложениеКДоговору"	, Объект.ПриложениеКДоговору);					  
	//Подсистема.УчетПриложенийДоговоров
	
	Запрос.УстановитьПараметр("КонПериода"			, КонецДня(ТекущаяДата()));
	Запрос.УстановитьПараметр("ПоЗаказу"			, Объект.ЗакрытиеПоЗаказу); 
	
	Запрос.УстановитьПараметр("Организация"					, Объект.Организация);					  
	Запрос.УстановитьПараметр("ПодразделениеОрганизации"	, Объект.ПодразделениеОрганизации);					  
	Запрос.УстановитьПараметр("ВестиУчетПоПодразделениям"	, ВестиУчетПоПодразделениям);					  
	
	Если Объект.ЗакрытиеПоЗаказу Тогда
		
		Запрос.УстановитьПараметр("Заказ", Объект.Аналитика);
		Запрос.УстановитьПараметр("Грузоперевозка", Справочники.CW_Грузоперевозки.ПустаяСсылка());
		
	Иначе
		
		Запрос.УстановитьПараметр("Заказ", Справочники.CW_Заказы.ПустаяСсылка());
		Запрос.УстановитьПараметр("Грузоперевозка", Объект.Аналитика);
		
	КонецЕсли; 
		
	ТЗ = Запрос.Выполнить().Выгрузить();
	
	Для каждого Стр Из ТЗ Цикл
		
		Если ТипЗнч(Стр.Регистратор) = Тип("ДокументСсылка.CW_РасходыПоГрузоперевозке") Тогда
			
			НовСтрока = Объект.Расходы.Добавить();
			// --- 
			НовСтрока.Грузоперевозка = Стр.Грузоперевозка;
			НовСтрока.Номенклатура = Стр.Номенклатура;
			НовСтрока.Сумма = Стр.СуммаРубПриход;
			НовСтрока.СтавкаНДС = Стр.СтавкаНДС;
			НовСтрока.НДС = Стр.НДСРубПриход;
			НовСтрока.Всего = Стр.ВсегоРубПриход;
			НовСтрока.РасходыПоГрузоперевозке = Стр.Регистратор;
			НовСтрока.Представление = Стр.РегистраторПредставлениеДокумента;
			
		ИначеЕсли ТипЗнч(Стр.Регистратор) = Тип("ДокументСсылка.CW_ДоходыПоГрузоперевозке") Тогда 	
			
			НовСтрока = Объект.Доходы.Добавить();
			// --- 
			НовСтрока.Грузоперевозка = Стр.Грузоперевозка;
			НовСтрока.Номенклатура = Стр.Номенклатура;
			НовСтрока.Сумма = Стр.СуммаРубРасход;
			НовСтрока.СтавкаНДС = Стр.СтавкаНДС;
			НовСтрока.НДС = Стр.НДСРубРасход;
			НовСтрока.Всего = Стр.ВсегоРубРасход;
			НовСтрока.ДоходыПоГрузоперевозке = Стр.Регистратор;
			НовСтрока.Представление = Стр.РегистраторПредставлениеДокумента;
			
		КонецЕсли; 
		
	КонецЦикла;
	
	ПараметрыДоговора = _ДС().ПД;

	// агентское вознаграждение...
	//----------------------------
	
	ТЗРасходы = Объект.Расходы.Выгрузить();
	ТЗДоходы = Объект.Доходы.Выгрузить();
	
	// группируем по грузоперевозкам
	Если ВалютаРегламентированногоУчетаРубль Тогда
		Если Объект.ЗакрытиеПоЗаказу Тогда
			
			НовСтрока = Объект.Вознаграждение.Добавить();
			// --- 			
			НовСтрока.Номенклатура = ПараметрыДоговора.Номенклатура;
			НовСтрока.Представление = Строка(НовСтрока.Номенклатура.НаименованиеПолное);
			НовСтрока.НоменклатурнаяГруппа = НовСтрока.Номенклатура.НоменклатурнаяГруппа;
			НовСтрока.Количество = 1;
			НовСтрока.Всего = ТЗДоходы.Итог("Всего") - ТЗРасходы.Итог("Всего");
			
			НовСтрока.СтавкаНДС = Ставка;	
			
			СтавкаНДСПроцент = CW_Финансы.ПолучитьСтавкуНДС(НовСтрока.СтавкаНДС)/100;
			НовСтрока.НДС = НовСтрока.Всего*СтавкаНДСПроцент/(1+СтавкаНДСПроцент);
			НовСтрока.Сумма = НовСтрока.Всего - НовСтрока.НДС;
			НовСтрока.Цена = _сф.БезопасноРазделить(НовСтрока.Сумма,НовСтрока.Количество);
			
		Иначе	
			
			МассивГП = _сф.м_СоздатьИзКолонкиТЗ(ТЗ,"Грузоперевозка");
			Для каждого ГП Из МассивГП Цикл
				
				НовСтрока = Объект.Вознаграждение.Добавить();
				
				Отбор = _сф.ст_Отбор("Грузоперевозка",ГП);
				ТЗР = ТЗРасходы.Скопировать(Отбор);
				ТЗД = ТЗДоходы.Скопировать(Отбор);
				
				НовСтрока.Номенклатура = ПараметрыДоговора.Номенклатура;
				НовСтрока.Представление = Строка(НовСтрока.Номенклатура.НаименованиеПолное);
				НовСтрока.НоменклатурнаяГруппа = НовСтрока.Номенклатура.НоменклатурнаяГруппа;
				НовСтрока.Количество = 1;
				НовСтрока.Всего = ТЗД.Итог("Всего") - ТЗР.Итог("Всего");
				
				НовСтрока.СтавкаНДС = Ставка;	
				
				СтавкаНДСПроцент = CW_Финансы.ПолучитьСтавкуНДС(НовСтрока.СтавкаНДС)/100;
				НовСтрока.НДС = НовСтрока.Всего*СтавкаНДСПроцент/(1+СтавкаНДСПроцент);
				НовСтрока.Сумма = НовСтрока.Всего - НовСтрока.НДС;
				НовСтрока.Цена = _сф.БезопасноРазделить(НовСтрока.Сумма,НовСтрока.Количество);		
				
			КонецЦикла;	
			
		КонецЕсли; 
	КонецЕсли;
	
	Возврат(_УФКС.Ответ());
	
	// --- 
КонецФункции

#КонецОбласти 

#Область ПолучениеНомера 

&НаКлиенте
Процедура ПолучитьНомер(Команда)
	
	// автоматическая установка номера возможно 
	// только если задана организация
	Если Не ЗначениеЗаполнено(Объект.Организация) Тогда
		_УФК.ВывестиПредупреждение("Для автоматической установки нового номера
					   |необходимо выбрать организацию.",10);
		Возврат;
	КонецЕсли;
	
	// получаем новый номер
	СтарыйНомер = Объект.Номер;
	_ПолучитьНомер();
	
	// если изменился номер, то попытаемся его переприсвоить первичным документам
	Если СтарыйНомер <> Объект.Номер Тогда
		НомерПриИзменении(ЭтаФорма.ТекущийЭлемент);	
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура _ПолучитьНомер()
	
	ДокументОбъект = РеквизитФормыВЗначение("Объект");
	ДокументОбъект.УстановитьНовыйНомер();
	ЗначениеВРеквизитФормы(ДокументОбъект,"Объект");
	
КонецПроцедуры

&НаКлиенте
Процедура НомерПриИзменении(Элемент)
	
		// если ввели не пустой номер, то проверим на 
	// возможность изменения номера первичных документов
	Если Не ЗначениеЗаполнено(Объект.Номер) Тогда
		Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Объект.Организация) Тогда
		Возврат;
	КонецЕсли;
	Если Не _ИспользуетсяПакетнаяНумерация() Тогда
		 Возврат;
	КонецЕсли;
	
	// спросим у пользователя
	ПОВ = Новый ОписаниеОповещения("ОбработкаВопросаУстановкиНовогоНомераПервичнымДокументам",ЭтотОбъект); 
	ПоказатьВопрос(ПОВ,"Установить новый номер первичным документам?", РежимДиалогаВопрос.ДаНет);  
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВопросаУстановкиНовогоНомераПервичнымДокументам(Ответ, ДополнительныеПараметры) Экспорт 
	// --- 
	
	Если (Ответ = КодВозвратаДиалога.Да) Тогда
		
		// устанавливаем
		Объект.НомерАкта = Объект.Номер;
		Если Объект.ДатаАкта = Дата(1,1,1) Тогда
			Объект.ДатаАкта = Объект.Дата;						
		КонецЕсли;
		Если Объект.ФормируетсяСчетФактура Тогда
			Объект.НомерСчетаФактуры = Объект.Номер;
			Если Объект.ДатаСчетаФактуры = Дата(1,1,1) Тогда
				Если Объект.ДатаАкта = Дата(1,1,1) Тогда
					Объект.ДатаСчетаФактуры = Объект.Дата;
				Иначе
					Объект.ДатаСчетаФактуры = Объект.ДатаАкта;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		// регенерируем форму	
		_ОбновитьНомераДокументов();
		
	КонецЕсли;
	
	// --- 
КонецПроцедуры
  

&НаСервере
Функция _ИспользуетсяПакетнаяНумерация()
	
	ПорядокПрисвоенияНомеров = CW_Настройки.ПараметрУчетнойПолитики(Объект.Дата,Объект.Организация,"ПорядокПрисвоенияНомеров");
	Если (ПорядокПрисвоенияНомеров = Перечисления.CW_ПорядокПрисвоенияИсходящихНомеров.ВПределахДаты) Или
		 (ПорядокПрисвоенияНомеров = Перечисления.CW_ПорядокПрисвоенияИсходящихНомеров.СплошнаяНумерация)	
	Тогда 
		Возврат Истина;
	Иначе
		Возврат Ложь;	
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Процедура ВедомыйДокументОткрытие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	// проверяем существование счета
	Если НЕ Объект.ВедомыйДокумент.Пустая() Тогда
		
		ПоказатьЗначение(,Объект.ВедомыйДокумент);
		
	Иначе
		
		_УФК.ВывестиПредупреждение("Ведомый документ реализации ещё не сформирован.");
		
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаОчистка(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	СтруктураПараметровБухУчета = Новый Структура;
	СтруктураПараметровБухУчета.Вставить("Договор", 				ТекущийОбъект.Договор);
	СтруктураПараметровБухУчета.Вставить("ПриложениеКДоговору",		ТекущийОбъект.ПриложениеКДоговору);
	
	ПараметрыБухгалтерскогоУчета = CW_Финансы.ПолучитьПарметрыВеденияБухгалтерскогоУчета(СтруктураПараметровБухУчета, ТекущийОбъект.Дата);
	

	Если Не ПараметрыБухгалтерскогоУчета.БухгалтерскийУчет тогда
		
		ТекущийОбъект.ФормируетсяСчетФактура = Ложь;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "ВыполнитьМетодВладельца" Тогда
			
		Если ТипЗнч(Параметр) = тип("Структура") Тогда
			УникальныйИдентификаторВладельца 	= Неопределено;
			МетодыФормыВладельца 				= Неопределено;
			
			Параметр.Свойство("УникальныйИдентификатор"	, УникальныйИдентификаторВладельца);
			Параметр.Свойство("МетодыФормыВладельца"	, МетодыФормыВладельца);
			
			Если ЭтаФорма.УникальныйИдентификатор = УникальныйИдентификаторВладельца Тогда
				Если Не МетодыФормыВладельца = Неопределено и ТипЗнч(МетодыФормыВладельца) = Тип("Массив") Тогда
					
					Для Каждого СтрокаМассива из МетодыФормыВладельца Цикл
						Попытка
							Выполнить(СтрокаМассива);
						Исключение
						КонецПопытки;
					КонецЦикла;
					
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;	

	КонецЕсли;

КонецПроцедуры

#КонецОбласти 

