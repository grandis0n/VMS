Процедура ОрганизацияПриИзменении(Элемент)
	
	_ОрганизацияПриИзменении();
	
КонецПроцедуры

&НаСервере
Процедура _ОрганизацияПриИзменении()
	// --- 
	
	_СформироватьОбщиеПараметры("УчетнаяПолитика");
	
	// --- 
КонецПроцедуры

#КонецОбласти 

#Область ИзменениеДаты 

&НаКлиенте
Процедура ДатаПриИзменении(Элемент)
	
	_ДатаПриИзменении();
	
	// ---------------------------------------------------------------------------- 
	
	Если (НЕ Объект.Ссылка.Пустая()) Тогда
		
		Если (_ГодИзменился()) Тогда
			
			ПОВ = Новый ОписаниеОповещения("ОбработкаВопросаИзмененияГода",ЭтотОбъект, Новый Структура()); 
			ПоказатьВопрос(ПОВ,"Дата документа перенесена в другой год."+Символы.ПС+ 
			"Документу будет присвоен новый номер."+Символы.ПС+ 
			"Продолжить?",РежимДиалогаВопрос.ДаНет);
			
		Иначе
			
			ДиалогСменыДатыВедомых();
			
		КонецЕсли; 
		
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВопросаИзмененияГода(Ответ, ДополнительныеПараметры) Экспорт 
	// --- 
	
	Если (Ответ <> Неопределено) Тогда
		
		Если (Ответ = КодВозвратаДиалога.Да) Тогда
			
			// присваевам новый номер
			_ОбработатьИзменениеГода();
			ДиалогСменыДатыВедомых(); 
			
		Иначе
			
			// восстанавливаем дату по ссылке
			_ВосстановитьДатуДокумента();
			
		КонецЕсли; 
		
	КонецЕсли; 
	
	// --- 
КонецПроцедуры

&НаСервере
Процедура _ОбработатьИзменениеГода()
	// --- 
	
	НачальнаяДатаДокумента = Объект.Дата;
	// --- 
	_ПолучитьНомер();
	
	// --- 
КонецПроцедуры
 

