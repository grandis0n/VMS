Процедура ОбновитьИтогиПоРасходам()
	
	// итоговая строка по табличной части "Услуги" 
	СВ = Строка(Валюта);
	ФЧ = "ЧЦ=15; ЧДЦ=2; ЧН=";
	Элементы.СтраницаРасходы.Заголовок = "Расходы ("+Строка(Объект.Расходы.Количество())+")";
	Если Объект.Расходы.Количество() = 0 Тогда
		ИтогоПоРасходам = "Нет данных.";
	Иначе
		СуммаРасходов = Объект.Расходы.Итог("Всего");
		РасчетноеВознаграждение = СуммаДоходов-СуммаРасходов;
		ИтогоПоРасходам =	"Строк: "+Объект.Расходы.Количество()+
						";  Сумма: "+Формат(Объект.Расходы.Итог("Сумма"),ФЧ)+" "+СВ+ 
						";  НДС: "+Формат(Объект.Расходы.Итог("НДС"),ФЧ)+" "+СВ+
						";  Всего: "+Формат(Объект.Расходы.Итог("Всего"),ФЧ)+" " +СВ;
	КонецЕсли;
	
						
КонецПроцедуры

