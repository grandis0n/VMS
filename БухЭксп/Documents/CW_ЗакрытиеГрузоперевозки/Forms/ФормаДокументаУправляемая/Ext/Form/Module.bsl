
#Область ОсновныеСобытияФормы 

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	CW_Документы.УстановитьПараметрыФункциональныхОпцийФормы(Этаформа);
	
	
	ВалютаРегламентированногоУчетаРубль = ПолучитьФункциональнуюОпцию("CW_ВалютаРегламентированногоУчетаРубль");
	
	//Для версии КОРП
	ВестиУчетПоПодразделениям					= ПолучитьФункциональнуюОпцию("ВестиУчетПоПодразделениям");
	Элементы.ПодразделениеОрганизации.Видимость	= ВестиУчетПоПодразделениям;
	//Для версии КОРП
	
	_СформироватьЗаголовок();
	_СформироватьОбщиеПараметры();
	Валюта = _ДС().КО.ВалютаРегламентированногоУчета;
	
	Если (Объект.Ссылка.Пустая()) Тогда
		
		Если (ЗначениеЗаполнено(Объект.Аналитика) И НЕ ЗначениеЗаполнено(Параметры.ЗначениеКопирования)) Тогда
			
			// определяем платильщика и договор
			МассивПлательщиков = Новый Массив;
			Если (Объект.ЗакрытиеПоЗаказу) Тогда
				
				// пробегаемся по грузопервозкам заказа и определяем плательщика
				МассивГП = CW_Мониторинг.ГрузоперевозкиЗаказа(Объект.Аналитика);
				
				Для каждого ГП Из МассивГП Цикл
					
					Если ТипЗнч(ГП) = Тип("СправочникСсылка.CW_Грузоперевозки") Тогда
						тКлиент = ГП.Клиент;
					Иначе
						тКлиент = ГП.Контрагент;
					КонецЕсли;
					
					СтруктураПараметров = Новый Структура;
					СтруктураПараметров.Вставить("Объект"				, ГП);
					СтруктураПараметров.Вставить("ЭтоВариантБюджета"	, Ложь);
					СтруктураПараметров.Вставить("Контрагент"			, тКлиент);
					
					Плательщик = CW_Финансы.ВернутьПлательщика(СтруктураПараметров);
					Если (ЗначениеЗаполнено(Плательщик)) Тогда
						_сф.м_ДобавитьУникально(МассивПлательщиков,Плательщик);
					КонецЕсли; 
					
				КонецЦикла; 
				
			Иначе
				тАналитика = Объект.Аналитика;
				
				Если ТипЗнч(тАналитика) = Тип("СправочникСсылка.CW_Грузоперевозки") Тогда
					тКлиент = тАналитика.Клиент;
				Иначе
					тКлиент = тАналитика.Контрагент;
				КонецЕсли;
				
				СтруктураПараметров = Новый Структура;
				СтруктураПараметров.Вставить("Объект"				, тАналитика);
				СтруктураПараметров.Вставить("ЭтоВариантБюджета"	, Ложь);
				СтруктураПараметров.Вставить("Контрагент"			, тКлиент);
				
				Плательщик = CW_Финансы.ВернутьПлательщика(СтруктураПараметров);
				
				Если (ЗначениеЗаполнено(Плательщик)) Тогда
					_сф.м_ДобавитьУникально(МассивПлательщиков,Плательщик);
				КонецЕсли; 
					
			КонецЕсли; 
			КоличествоПлательщиков = _сф.Количество(МассивПлательщиков);
			Если (КоличествоПлательщиков <> 0) Тогда
				
				
				Если (КоличествоПлательщиков = 1) Тогда
					
					Объект.Контрагент = МассивПлательщиков[0];
					_УстановитьДоговор();					
					
				Иначе
					
					Плательщики.Очистить();
					Для каждого Стр Из МассивПлательщиков Цикл
						Плательщики.Добавить(Стр);
					КонецЦикла; 
					РежимВыбораПлательщика = Истина;
					Возврат;
					
				КонецЕсли; 				
				
			КонецЕсли; 
			
			
		КонецЕсли; 
		
		Если ВестиУчетПоПодразделениям и Не ЗначениеЗаполнено(Объект.ПодразделениеОрганизации) Тогда
			Объект.ПодразделениеОрганизации 	= CW_Настройки.ПолучитьНастройкуПользователя(CW_Настройки.Пользователь(),"ПодразделениеПользователя");
		КонецЕсли;
	
	КонецЕсли; 
	
	Если ЗначениеЗаполнено(Объект.Договор) тогда
		
		СтруктураПараметровБухУчета = Новый Структура;
		СтруктураПараметровБухУчета.Вставить("Договор", 				Объект.Договор);
		СтруктураПараметровБухУчета.Вставить("ПриложениеКДоговору",		Объект.ПриложениеКДоговору);
		
		ПараметрыБухгалтерскогоУчета = CW_Финансы.ПолучитьПарметрыВеденияБухгалтерскогоУчета(СтруктураПараметровБухУчета, Объект.Дата);
		
		ВедетсяБУпоДоговору = ПараметрыБухгалтерскогоУчета.БухгалтерскийУчет;
	Конецесли;
	
	Если (НЕ РежимВыбораПлательщика) Тогда
		_ИнициализацияФормы();	
	КонецЕсли; 
	
	// --- 
	СостояниеДокумента = ОбщегоНазначенияБП.СостояниеДокумента(Объект); // ВызовБП
	
	// --- 
	НачальнаяДатаДокумента = Объект.Дата;
	
	//Подсистема.УчетПриложенийДоговоров
	CW_УчетПриложенийДоговоровСервер.ПриСозданииНаСервере(ЭтаФорма, Отказ, СтандартнаяОбработка);
	//Подсистема.УчетПриложенийДоговоров
	
	Если Параметры.Ключ.Пустая() Тогда
		Объект.ФормируетсяАкт = Истина;
	КонецЕсли;
	
	ПервичныеДокументыПриСозданииНаСервере();
	
	//Внешние подклчюаемые команды
	CW_ПодключаемыеКомандыСервер.ПриСозданииНаСервере(ЭтотОбъект);

КонецПроцедуры

&НаСервере
Процедура _ИнициализацияФормы()
	// --- 
	
	Если (Объект.Организация.Пустая()) Тогда
		
		ОсновнаяОрганизация = CW_Настройки.ОсновнаяОрганизация();
		Если ЗначениеЗаполнено(ОсновнаяОрганизация) Тогда
			Объект.Организация = ОсновнаяОрганизация;
			_СформироватьОбщиеПараметры("УчетнаяПолитика");
		КонецЕсли;
		
	КонецЕсли; 
	
	Элементы.ГруппаИнфо.Видимость = Ложь;
	// проверяем на закрытие
	Если НЕ РеквизитФормыВЗначение("Объект").ПроверитьЗакрытиеГрузоперевозок() Тогда
		ЭтаФорма.ТолькоПросмотр = Истина;
		Элементы.ГруппаИнфо.Видимость = Истина;
		Элементы.ГруппаКлиент.ТолькоПросмотр=Истина;
		Элементы.ПолучитьНомер.Доступность = Ложь;
		Элементы.ДекорацияИнфо.Заголовок = "Документ доступен только для просмотра, т.к. содержит блокированные грузоперевозки!";
	КонецЕсли; 
	
	ВариантЗакрытия = ?(Объект.ЗакрытиеПоЗаказу,0,1);
	Если (Объект.Ссылка.Пустая()) Тогда
		_ВариантЗакрытияПриИзменении();
	КонецЕсли; 
	
	ПравоПросмотраБухгалтерскихОбъектов = CW_ПраваДоступа.ДоступныОбъектыБухгалтерии();
	Элементы.ГруппаВедомыйДокумент.Видимость = ПравоПросмотраБухгалтерскихОбъектов и ПолучитьФункциональнуюОпцию("CW_ИспользуетсяБухгалтерскийУчетПоДоговору");
	
	_ОбновитьНомераДокументов();
	_УправлениеЭлементамиФормы();
	
	ОбновитьИтогиПоРасходам();
	ОбновитьИтогиПоДоходам();
	ОбновитьИтогиПоВознаграждению();
	
	_УФС.ОтключитьИсториюВыбораЭлементовФормы(ЭтаФорма);
	
	// --- 
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	
	// ---------------------------------------------------------------------------- 
	
	Если (РежимВыбораПлательщика) Тогда
		
		ПОВ = Новый ОписаниеОповещения("ОбработкаВыбораПлательщика",ЭтотОбъект); 
		Плательщики.ПоказатьВыборЭлемента(ПОВ,"Выберите плательщика");
		
		_СформироватьОбщиеПараметры();
		_ИнициализацияФормы();
		
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбораПлательщика(Ответ, ДополнительныеПараметры) Экспорт 
	// --- 
	
	Если (Ответ <> Неопределено) Тогда
		Объект.Контрагент = Ответ.Значение;
		_УстановитьДоговор();
		_СформироватьОбщиеПараметры();
	КонецЕсли; 
	
	// --- 
КонецПроцедуры
  

&НаСервере
Процедура ПриЗаписиНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	// --- 
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	_СформироватьЗаголовок();
	_ОбновитьНомераДокументов();
	_УправлениеЭлементамиФормы();
	
	ПодготовитьДанныеФормы();

// --- 
	СостояниеДокумента = ОбщегоНазначенияБП.СостояниеДокумента(Объект); // ВызовБП
	
КонецПроцедуры


&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	ПодготовитьДанныеФормы();	
	
	//ДатыЗапретаИзменения
	//Проверяем дату запрета по документам БУ
	мОбъектыПроверки = ПолучитьМассивОбъектовДляПроверки();
	Для Каждого ЭлементМассива из мОбъектыПроверки Цикл
		//Есть ведомые документы, проверяем дату запрета редактирования БП
		ОбъектМассива = ЭлементМассива.ПолучитьОбъект();
		Разрешено = ДатыЗапретаИзменения.ОбъектПриЧтенииНаСервере(ЭтотОбъект, ОбъектМассива);
		Если не Разрешено Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	//ДатыЗапретаИзменения

	
КонецПроцедуры

&НаСервере
Функция ПолучитьМассивОбъектовДляПроверки()
	
	Результат = Новый Массив;
	
	Если ЗначениеЗаполнено(Объект.ВедомыйДокумент) Тогда
		Результат.Добавить(Объект.ВедомыйДокумент);
	КонецЕсли;
	Если ЗначениеЗаполнено(Объект.ВедомыйСчетФактура) Тогда
		Результат.Добавить(Объект.ВедомыйСчетФактура);
	КонецЕсли;
	
	Возврат Результат; 
	
КонецФункции


#КонецОбласти 

