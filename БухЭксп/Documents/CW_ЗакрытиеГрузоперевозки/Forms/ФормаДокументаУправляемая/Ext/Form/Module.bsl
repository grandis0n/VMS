&НаСервере
Процедура _ВариантЗакрытияПриИзменении()
	// --- 
	
	Объект.ЗакрытиеПоЗаказу = ?(ВариантЗакрытия=0,Истина,Ложь);
	
	// очищаем все ТЧ
	Объект.Вознаграждение.Очистить();
	Объект.Расходы.Очистить();
	Объект.Доходы.Очистить();
	
	Если Объект.ЗакрытиеПоЗаказу Тогда
		
		Если ТипЗнч(Объект.Аналитика)=Тип("СправочникСсылка.CW_Грузоперевозки") Тогда
			
			Если НЕ Объект.Аналитика.Пустая() Тогда
				
				Объект.Аналитика = Объект.Аналитика.Заказ;
				
			Иначе
				
				Объект.Аналитика = Справочники.CW_Заказы.ПустаяСсылка();
				
			КонецЕсли; 
			
		Иначе
			
			Если ТипЗнч(Объект.Аналитика) <> Тип("СправочникСсылка.CW_Заказы") Тогда
				
				Объект.Аналитика = Справочники.CW_Заказы.ПустаяСсылка();
				
			КонецЕсли; 
			
		КонецЕсли; 
		
	Иначе
		
		Если ТипЗнч(Объект.Аналитика) <> Тип("СправочникСсылка.CW_Грузоперевозки") Тогда
			
			Объект.Аналитика = Справочники.CW_Грузоперевозки.ПустаяСсылка();
			
		КонецЕсли; 
		
	КонецЕсли; 
	
	// --- 
	
	// изменяем тип
	_УправлениеЭлементамиФормы();
	
	// --- 
КонецПроцедуры

&НаКлиенте
Процедура АналитикаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ПараметрыФормыВыбора = Новый Структура;
	ПараметрыФормыВыбора.Вставить("РежимВыбора", 			Истина);
	ПараметрыФормыВыбора.Вставить("МножественныйВыбор", 	Ложь);
	ПараметрыФормыВыбора.Вставить("ЗакрыватьПриВыборе", 	Истина);
	ПараметрыФормыВыбора.Вставить("Клиент", 			 	Объект.Контрагент);
	
	//по заказу(0), по грузоперевозке(1)
	Если ВариантЗакрытия = 0 Тогда
		ОткрытьФорму("Справочник.CW_Заказы.ФормаВыбора", ПараметрыФормыВыбора,Элемент,,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	Иначе
		ОткрытьФорму("Справочник.CW_Грузоперевозки.ФормаВыбора", ПараметрыФормыВыбора,Элемент,,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	КонецЕсли;
	
КонецПроцедуры

