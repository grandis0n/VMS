#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
Функция ПолучитьСвязанныеДоходыПоГрузопереовзкам(ОтчетЭкспедитора) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	CW_ДокументыОтчетаЭкспедитора.СвязанныйДокумент КАК СвязанныйДокумент,
	               |	CW_ДокументыОтчетаЭкспедитора.СвязанныйДокумент.Проведен КАК Проведен
	               |ПОМЕСТИТЬ ВТ_Документы
	               |ИЗ
	               |	РегистрСведений.CW_ДокументыОтчетаЭкспедитора КАК CW_ДокументыОтчетаЭкспедитора
	               |ГДЕ
	               |	CW_ДокументыОтчетаЭкспедитора.ОтчетЭкспедитора = &ОтчетЭкспедитора
	               |	И CW_ДокументыОтчетаЭкспедитора.СвязанныйДокумент <> &СвязанныйДокумент
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ_Документы.СвязанныйДокумент КАК СвязанныйДокумент
	               |ИЗ
	               |	ВТ_Документы КАК ВТ_Документы
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ_Документы.СвязанныйДокумент КАК СвязанныйДокумент
	               |ИЗ
	               |	ВТ_Документы КАК ВТ_Документы
	               |ГДЕ
	               |	ВТ_Документы.Проведен
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ_Документы.СвязанныйДокумент КАК СвязанныйДокумент
	               |ИЗ
	               |	ВТ_Документы КАК ВТ_Документы
	               |ГДЕ
	               |	НЕ ВТ_Документы.Проведен";
	
	Запрос.УстановитьПараметр("ОтчетЭкспедитора",  ОтчетЭкспедитора);
	Запрос.УстановитьПараметр("СвязанныйДокумент", ОтчетЭкспедитора.СчетНаПредоплату_Значение);
	
	ПакетРезультатовЗапроса = Запрос.ВыполнитьПакет();
	
	СтруктураДанных = Новый Структура;
	СтруктураДанных.Вставить("ВсеДокументы"	, ПакетРезультатовЗапроса[1].Выгрузить().ВыгрузитьКолонку("СвязанныйДокумент"));
	СтруктураДанных.Вставить("Проведенные"	, ПакетРезультатовЗапроса[2].Выгрузить().ВыгрузитьКолонку("СвязанныйДокумент"));
	СтруктураДанных.Вставить("НеПроведенные", ПакетРезультатовЗапроса[3].Выгрузить().ВыгрузитьКолонку("СвязанныйДокумент"));
	
	Возврат СтруктураДанных;
	
КонецФункции

Функция ПолучитьДанныеДокумента(ОтчетЭкспедитора) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	CW_ДокументыОтчетаЭкспедитора.СвязанныйДокумент КАК СвязанныйДокумент,
	               |	CW_ДокументыОтчетаЭкспедитора.СвязанныйДокумент.Дата КАК ДатаДокумента,
	               |	ВЫБОР
	               |		КОГДА CW_ДокументыОтчетаЭкспедитора.СвязанныйДокумент.ФормируетсяАкт
	               |			ТОГДА CW_ДокументыОтчетаЭкспедитора.СвязанныйДокумент.ДатаАкта
	               |		ИНАЧЕ CW_ДокументыОтчетаЭкспедитора.СвязанныйДокумент.ДатаСчета
	               |	КОНЕЦ КАК МаксДатаПервичногоДокумента,
	               |	ВЫБОР
	               |		КОГДА CW_ДокументыОтчетаЭкспедитора.СвязанныйДокумент.ФормируетсяАкт
	               |			ТОГДА CW_ДокументыОтчетаЭкспедитора.СвязанныйДокумент.ДатаАкта
	               |		ИНАЧЕ CW_ДокументыОтчетаЭкспедитора.СвязанныйДокумент.ДатаСчета
	               |	КОНЕЦ КАК МинДатаПервичногоДокумента
	               |ПОМЕСТИТЬ ВТ_ДанныеРегистра
	               |ИЗ
	               |	РегистрСведений.CW_ДокументыОтчетаЭкспедитора КАК CW_ДокументыОтчетаЭкспедитора
	               |ГДЕ
	               |	CW_ДокументыОтчетаЭкспедитора.ОтчетЭкспедитора = &ОтчетЭкспедитора
	               |	И CW_ДокументыОтчетаЭкспедитора.СвязанныйДокумент.Проведен
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ_ДанныеРегистра.СвязанныйДокумент КАК СвязанныйДокумент
	               |ИЗ
	               |	ВТ_ДанныеРегистра КАК ВТ_ДанныеРегистра
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ВТ_ДанныеРегистра.СвязанныйДокумент
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ_ДанныеРегистра.ДатаДокумента КАК ДатаДокумента,
	               |	МАКСИМУМ(ВТ_ДанныеРегистра.МаксДатаПервичногоДокумента) КАК МаксДатаПервичногоДокумента,
	               |	МИНИМУМ(ВТ_ДанныеРегистра.МинДатаПервичногоДокумента) КАК МинДатаПервичногоДокумента
	               |ИЗ
	               |	ВТ_ДанныеРегистра КАК ВТ_ДанныеРегистра
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ВТ_ДанныеРегистра.ДатаДокумента";
	
	Запрос.УстановитьПараметр("ОтчетЭкспедитора", ОтчетЭкспедитора);
	
	ПакетРезультатов = Запрос.ВыполнитьПакет();
	
	СтруктураДанных = Новый Структура("ДоходыПоГрузоперевозке,ДатаДок,МаксДатаПервичногоДокумента,МинДатаПервичногоДокумента", Новый массив,ОтчетЭкспедитора.Дата,КонецДня(ОтчетЭкспедитора.Дата),НачалоДня(ОтчетЭкспедитора.Дата));
	
	//массив документов для отбора
	СтруктураДанных.ДоходыПоГрузоперевозке = ПакетРезультатов[1].Выгрузить().ВыгрузитьКолонку("СвязанныйДокумент");
	
	//Даты
	Выборка =  ПакетРезультатов[2].Выбрать();
	
	Если Выборка.Следующий() тогда
		СтруктураДанных.ДатаДок 					= ?(Выборка.ДатаДокумента 				= Неопределено, ОтчетЭкспедитора.Дата			, Выборка.ДатаДокумента);
		СтруктураДанных.МаксДатаПервичногоДокумента = ?(Выборка.МаксДатаПервичногоДокумента	= Неопределено, КонецДня(ОтчетЭкспедитора.Дата) , Выборка.МаксДатаПервичногоДокумента);
		СтруктураДанных.МинДатаПервичногоДокумента 	= ?(Выборка.МинДатаПервичногоДокумента 	= Неопределено, НачалоДня(ОтчетЭкспедитора.Дата), Выборка.МинДатаПервичногоДокумента);
	Конецесли;
	
	Возврат СтруктураДанных;
	
КонецФункции

#Область процедуры_фоновых_заданий

Процедура РазоватьСвязьДокументаНаСервере(ПараметрыПроцедуры, АдресРезультата=Неопределено) Экспорт
	
	Для Каждого СвязанныйДокумент из ПараметрыПроцедуры.ВсеДокументы Цикл
		
		ДокументОбъект = СвязанныйДокумент.ПолучитьОбъект();
		ДокументОбъект.УстановитьпометкуУдаления(Истина);
		
		КлючЗаписи = новый Структура("ОтчетЭкспедитора, СвязанныйДокумент", ПараметрыПроцедуры.Ссылка,СвязанныйДокумент);
		УдалитьЗаписьРегистра(КлючЗаписи);
	
	КонецЦикла;
	
	ПоместитьВоВременноеХранилище(ПараметрыПроцедуры.ВсеДокументы ,АдресРезультата); 

КонецПроцедуры

Процедура ЗаполнитьТабличнуюЧастьУслуги(ПараметрыПроцедуры, АдресРезультата) Экспорт
	
	ПереформироватьПеревыставленииЗатрат = CW_Настройки.ПараметрУчетнойПолитики(ПараметрыПроцедуры.Дата, ПараметрыПроцедуры.Организация, "ЗановоФормироватьПредставлениеПриПеревыставленииЗатрат");

	Запрос = Новый Запрос;
	запрос.Текст = "ВЫБРАТЬ
	               |	CW_ПеревыставлениеОстатки.Грузоперевозка КАК Грузоперевозка,
	               |	CW_ПеревыставлениеОстатки.Грузоперевозка.Заказ КАК Заказ,
	               |	CW_ПеревыставлениеОстатки.Номенклатура КАК Номенклатура,
	               |	CW_ПеревыставлениеОстатки.КоличествоОстаток КАК Количество_1,
	               |	CW_ПеревыставлениеОстатки.КоличествоОстаток КАК Количество,
	               |	ВЫБОР
	               |		КОГДА CW_ПеревыставлениеОстатки.КоличествоОстаток <> 0
	               |			ТОГДА CW_ПеревыставлениеОстатки.СуммаОстаток / CW_ПеревыставлениеОстатки.КоличествоОстаток
	               |		ИНАЧЕ CW_ПеревыставлениеОстатки.СуммаОстаток
	               |	КОНЕЦ КАК Цена_1,
	               |	ВЫБОР
	               |		КОГДА CW_ПеревыставлениеОстатки.КоличествоОстаток <> 0
	               |			ТОГДА CW_ПеревыставлениеОстатки.СуммаОстаток / CW_ПеревыставлениеОстатки.КоличествоОстаток
	               |		ИНАЧЕ CW_ПеревыставлениеОстатки.СуммаОстаток
	               |	КОНЕЦ КАК Цена,
	               |	CW_ПеревыставлениеОстатки.СуммаОстаток КАК Сумма_1,
	               |	CW_ПеревыставлениеОстатки.СуммаОстаток КАК Сумма,
	               |	CW_ПеревыставлениеОстатки.НДСОстаток КАК СуммаНДС_1,
	               |	CW_ПеревыставлениеОстатки.НДСОстаток КАК СуммаНДС,
	               |	CW_ПеревыставлениеОстатки.ВсегоОстаток КАК Всего_1,
	               |	CW_ПеревыставлениеОстатки.ВсегоОстаток КАК Всего,
	               |	CW_ПеревыставлениеОстатки.СтавкаНДС КАК СтавкаНДС,
	               |	CW_ПеревыставлениеОстатки.ДокументРасходов КАК ДокументРасходов,
	               |	CW_ПеревыставлениеОстатки.ДокументРасходов.Контрагент КАК Контрагент,
	               |	CW_ПеревыставлениеОстатки.ДокументРасходов.ПредъявленСФ КАК ЕстьСчетФактура,
	               |	CW_ПеревыставлениеОстатки.ДокументРасходов.ДатаАкта КАК ДатаЗатрат,
	               |	CW_ПеревыставлениеОстатки.Контрагент КАК Покупатель,
	               |	CW_ПеревыставлениеОстатки.Договор КАК ДоговорПокупателя,
	               |	ЗНАЧЕНИЕ(Перечисление.CW_ПорядокОтраженияЗатрат.Перевыставление) КАК ПорядокОтражения
	               |ИЗ
	               |	РегистрНакопления.CW_Перевыставление.Остатки(
	               |			&ДатаОстатка,
	               |			Контрагент = &Контрагент
				   //Подсистема.УчетПриложенийДоговоров
				   |				И ПриложениеКДоговору = &ПриложениеКДоговору
				   //Подсистема.УчетПриложенийДоговоров
				   |				И Договор = &Договор
				   |				//УсловиеПоОбъектам
				   |				//УсловиеВеденияУчетаПоПодразделениям
				   |				И ДокументРасходов.Корректировка = ЛОЖЬ) КАК CW_ПеревыставлениеОстатки";
				   
	Запрос.УстановитьПараметр("МассивОбъектов"			, ПараметрыПроцедуры.МассивОбъектов);
	Запрос.УстановитьПараметр("ОбъектОстатков"			, ПараметрыПроцедуры.МассивОбъектов[0]);
	Запрос.УстановитьПараметр("ДатаОстатка"				, ПараметрыПроцедуры.Дата);
	Запрос.УстановитьПараметр("Контрагент"				, ПараметрыПроцедуры.Контрагент);
	Запрос.УстановитьПараметр("Договор"					, ПараметрыПроцедуры.Договор);
	
	//Подсистема.УчетПриложенийДоговоров
	Запрос.УстановитьПараметр("ПриложениеКДоговору"		, ПараметрыПроцедуры.ПриложениеКДоговору);
	//Подсистема.УчетПриложенийДоговоров
	
	Запрос.УстановитьПараметр("ВестиУчетПоПодразделениям"	, ПараметрыПроцедуры.ВестиУчетПоПодразделениям);
	Запрос.УстановитьПараметр("ПодразделениеОрганизации"	, ПараметрыПроцедуры.ПодразделениеОрганизации);
	
	Если ПараметрыПроцедуры.ВестиУчетПоПодразделениям Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст,"//УсловиеВеденияУчетаПоПодразделениям", "И ДокументРасходов.ПодразделениеОрганизации = &ПодразделениеОрганизации");
	КонецЕсли;
	
	Если ПараметрыПроцедуры.ОтборПоГрузоперевозкам Тогда
		Если ПараметрыПроцедуры.МассивОбъектов.Количество() > 1 Тогда
			Запрос.Текст = СтрЗаменить(Запрос.Текст,"//УсловиеПоОбъектам", "И Грузоперевозка В (&МассивОбъектов)");
		Иначе
			Запрос.Текст = СтрЗаменить(Запрос.Текст,"//УсловиеПоОбъектам", "И Грузоперевозка  = &ОбъектОстатков");
		КонецЕсли;
	Иначе
		Если ПараметрыПроцедуры.МассивОбъектов.Количество() > 1 Тогда
			Запрос.Текст = СтрЗаменить(Запрос.Текст,"//УсловиеПоОбъектам", "И ДокументРасходов В (&МассивОбъектов)");
		Иначе
			Запрос.Текст = СтрЗаменить(Запрос.Текст,"//УсловиеПоОбъектам", "И ДокументРасходов  = &ОбъектОстатков");
		КонецЕсли;
	КонецЕсли;
	
	ТаблицаЗапроса = Запрос.Выполнить().Выгрузить();     
	
	ТаблицаЗапроса.Колонки.Добавить("Представление", Новый ОписаниеТипов("Строка"));
	
	Документы.CW_ДоходыПоГрузоперевозке.Услуги_СформироватьПредставлениеНоменклатуры(ТаблицаЗапроса, ПараметрыПроцедуры.Договор,ПараметрыПроцедуры.Объект,ПереформироватьПеревыставленииЗатрат);

	ПоместитьВоВременноеХранилище(ТаблицаЗапроса, АдресРезультата);
	
КонецПроцедуры

Процедура СформироватьДокументыОтчетаЭкспедитора(ПараметрыПроцедуры, АдресРезультата) Экспорт
	
	УстанавливатьПризнакНаличияДляНовыхСчетов = Ложь;
	КонтролироватьПолучениеОригиналовОтКлиентов = ПолучитьФункциональнуюОпцию("CW_КонтролироватьПолучениеОригиналовОтКлиентов");
	Если  КонтролироватьПолучениеОригиналовОтКлиентов тогда
		УстанавливатьПризнакНаличияДляНовыхСчетов 	= Константы.CW_УстанавливатьПризнакНаличияОригиналовДляСчетов.Получить();
	КонецЕсли;
	
	ТребуетсяПересчетВалюты 		= ПараметрыПроцедуры.ВалютаДокумента <> ПараметрыПроцедуры.ВалютаРегламентированногоУчета;
	
	ОбъектПараметров = ПараметрыПроцедуры.Договор;
	
	//Подсистема.УчетПриложенийДоговоров
	Если ЗначениеЗаполнено(ПараметрыПроцедуры.ПриложениеКДоговору) Тогда
		ОбъектПараметров = ПараметрыПроцедуры.ПриложениеКДоговору;
	КонецЕсли;
	//Подсистема.УчетПриложенийДоговоров
	СтруктураПараметров = CW_Настройки.ПустаяСтруктураПолученияПараметровДоговора();
	СтруктураПараметров.Дата 				= ПараметрыПроцедуры.Дата;
	СтруктураПараметров.Договор 			= ПараметрыПроцедуры.Договор;
	СтруктураПараметров.ПриложениеКДоговору = ПараметрыПроцедуры.ПриложениеКДоговору;
	
	ПараметрыДоговора	= CW_Настройки.ПолучитьПараметрыДоговора(СтруктураПараметров);
	
	ПереформироватьПредставление 	= CW_Настройки.ПараметрУчетнойПолитики(ПараметрыПроцедуры.Дата, ПараметрыПроцедуры.Организация, "ЗановоФормироватьПредставлениеПриПеревыставленииЗатрат");
	ОсновнаяСтатьяЗатрат 			= CW_Настройки.ПараметрУчетнойПолитики(ПараметрыПроцедуры.Дата, ПараметрыПроцедуры.Организация, "ОсновнаяСтатьяЗатрат");
	
	Если ПараметрыПроцедуры.УстановитьСтатусДокумента Тогда
		СтатусДокумента = ПараметрыПроцедуры.СтатусДокумента;
		Если Не ЗначениеЗаполнено(СтатусДокумента) Тогда
			СтатусДокумента = Справочники.CW_СтатусыДокументов.ПолучитьСтатусНовогоОбъекта(Тип("ДокументСсылка.CW_ДоходыПоГрузоперевозке"));
		КонецЕсли;
	КонецЕсли;
	
	Если ПараметрыПроцедуры.ПорядокПеревыставления = 0  Тогда //Сводно 
		ПолеГруппировки		= "ЛОЖЬ";
	ИначеЕсли ПараметрыПроцедуры.ПорядокПеревыставления = 1 Тогда  //Сводно в пределах даты
		ПолеГруппировки 	= "ВнешняяТаблица.ДатаЗатрат";
	ИначеЕсли ПараметрыПроцедуры.ПорядокПеревыставления = 2 Тогда  //По документу поставщика  
		ПолеГруппировки 	= "ВнешняяТаблица.ДокументРасходов";
	ИначеЕсли ПараметрыПроцедуры.ПорядокПеревыставления = 3 Тогда    // Интевалом по несколько дней
		ПолеГруппировки		= "ДАТАВРЕМЯ(1,1,1,0,0,0)";
	КонецЕсли;
	
	СтруктураСвязанныеДокументы = Документы.CW_ОтчетЭкспедитора.ПолучитьСвязанныеДоходыПоГрузопереовзкам(ПараметрыПроцедуры.Ссылка);
	ОтменитьПроведениеВсехСвязанныхДокументов(СтруктураСвязанныеДокументы);
	
	Запрос 		 = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.Текст = "ВЫБРАТЬ
					|	//ДополнительнаяГруппировка КАК ДополнительнаяГруппировка,
					|	ВнешняяТаблица.Грузоперевозка КАК Грузоперевозка,
					|	ВнешняяТаблица.Номенклатура КАК Номенклатура,
					|	ВнешняяТаблица.Количество КАК Количество,
					|	ВнешняяТаблица.Цена КАК Цена,
					|	ВнешняяТаблица.Сумма КАК Сумма,
					|	ВнешняяТаблица.СтавкаНДС КАК СтавкаНДС,
					|	ВнешняяТаблица.СуммаНДС КАК СуммаНДС,
					|	ВнешняяТаблица.Всего КАК Всего,
					|	ВнешняяТаблица.ЕстьСчетФактура КАК ЕстьСчетФактура,
					|	ВнешняяТаблица.ДокументРасходов КАК ДокументРасходов,
					|	ВнешняяТаблица.Представление КАК Представление,
					|	ВнешняяТаблица.ДатаЗатрат КАК ДатаРасхода,
					|	НАЧАЛОПЕРИОДА(ВнешняяТаблица.ДатаЗатрат, ДЕНЬ) КАК ДатаЗатрат,
					|	ЛОЖЬ КАК Заполнено
					|ПОМЕСТИТЬ ВТ_ДанныеДокумента
					|ИЗ
					|	&ТаблицаУслуг КАК ВнешняяТаблица
					|;
					|
					|////////////////////////////////////////////////////////////////////////////////
					|ВЫБРАТЬ *
					|ИЗ
					|	ВТ_ДанныеДокумента КАК ВТ_ДанныеДокумента";
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "//ДополнительнаяГруппировка", ПолеГруппировки);
	
	Запрос.УстановитьПараметр("ТаблицаУслуг", ПараметрыПроцедуры.ТаблицаУслуг);
	
	ПромежуточныйРезульат = Запрос.Выполнить();
	
	УничтожитьВременнуюТаблицу(Запрос, "ВТ_ДанныеДокумента");
	
	Если  ПараметрыПроцедуры.ПорядокПеревыставления = 3 Тогда
		
		ВремТаблица = ПромежуточныйРезульат.Выгрузить();
		ВремТаблица.Сортировать("ДатаЗатрат ВОЗР");
		
		ОбработатьТаблицуРезультата(ВремТаблица,ПараметрыПроцедуры.КоличествоДней);
		
		ВнешниеДанные = ВремТаблица;
		
	Иначе
		ВнешниеДанные = ПромежуточныйРезульат.Выгрузить();
	КонецЕсли;
	
	Запрос 		 = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос.Текст = 	"ВЫБРАТЬ *
					|ПОМЕСТИТЬ ВТ_ВнешниеДанные
					|ИЗ
					|	&ВнешниеДанные КАК ВнешниеДанные";
	
	Запрос.УстановитьПараметр("ВнешниеДанные", ВнешниеДанные);
	Запрос.Выполнить();

	Запрос.Текст = "ВЫБРАТЬ
	               |	ВТ_ВнешниеДанные.Грузоперевозка КАК Грузоперевозка,
	               |	ВТ_ВнешниеДанные.Номенклатура КАК Номенклатура,
	               |	ВТ_ВнешниеДанные.Количество КАК Количество,
	               |	ВТ_ВнешниеДанные.Цена КАК Цена_Рег,
	               |	ВТ_ВнешниеДанные.Сумма КАК Сумма_Рег,
	               |	ВТ_ВнешниеДанные.СтавкаНДС КАК СтавкаНДС,
	               |	ВТ_ВнешниеДанные.СуммаНДС КАК НДС_Рег,
	               |	ВТ_ВнешниеДанные.Всего КАК Всего_Рег,
	               |	ВТ_ВнешниеДанные.ДополнительнаяГруппировка КАК ДополнительнаяГруппировка,
	               |	ВТ_ВнешниеДанные.ЕстьСчетФактура КАК ЕстьСчетФактура,
	               |	ЕСТЬNULL(CW_СтатьиЗатратНоменклатуры.СтатьяЗатрат, НЕОПРЕДЕЛЕНО) КАК СтатьяЗатрат,
	               |	ВТ_ВнешниеДанные.ДокументРасходов КАК ДокументРасходов,
	               |	ВТ_ВнешниеДанные.Представление КАК Представление
	               |ИЗ
	               |	ВТ_ВнешниеДанные КАК ВТ_ВнешниеДанные
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.CW_СтатьиЗатратНоменклатуры КАК CW_СтатьиЗатратНоменклатуры
	               |		ПО ВТ_ВнешниеДанные.Номенклатура = CW_СтатьиЗатратНоменклатуры.Номенклатура
	               |ИТОГИ ПО
	               |	ЕстьСчетФактура,
	               |	ДополнительнаяГруппировка";
	
	
	РезультатЗапроса = Запрос.Выполнить();
	
	УничтожитьВременнуюТаблицу(Запрос, "ВТ_ВнешниеДанные");

	Выборка_ЕстьСчетФактура = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	МассивДокументов = Новый Массив;
	Пока Выборка_ЕстьСчетФактура.Следующий() Цикл
		
		Выборка_Дополнительно = Выборка_ЕстьСчетФактура.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Пока Выборка_Дополнительно.Следующий() Цикл
			
			Если СтруктураСвязанныеДокументы.ВсеДокументы.Количество() = 0 Тогда
				НовыйДокумент = Документы.CW_ДоходыПоГрузоперевозке.СоздатьДокумент();
			Иначе
				НовыйДокумент = СтруктураСвязанныеДокументы.ВсеДокументы[0].ПолучитьОбъект();
				
				Если НовыйДокумент.ПометкаУдаления Тогда
					НовыйДокумент.ПометкаУдаления = Ложь;
				КонецЕсли;
				
				НовыйДокумент.Услуги.Очистить();
				
				СтруктураСвязанныеДокументы.ВсеДокументы.Удалить(0);
			КонецЕсли;
			
			ЗаполнитьШапкуДокумента(НовыйДокумент, ПараметрыПроцедуры);
			
			НовыйДокумент.ДатаСчета 		= "";
			НовыйДокумент.ДатаАкта  		= "";
			НовыйДокумент.ДатаСчетаФактуры 	= "";
			
			НовыйДокумент.ФормируетсяАкт 	= Истина;
			
			Если ЗначениеЗаполнено(ПараметрыДоговора.ПорядокЗаполненияРасчётноПлатёжныхДокументовСФ) Тогда
				НовыйДокумент.ПорядокЗаполненияРасчётноПлатёжныхДокументовСФ = ПараметрыДоговора.ПорядокЗаполненияРасчётноПлатёжныхДокументовСФ;
			КонецЕсли;
			
			
			НовыйДокумент.КодСпособаВыставления  = ПараметрыДоговора.ОсновнойКодСпособаВыставленияСчетовФактур;
			
			//ПорядокПеревыставления: 	Сводно(0), Сводно в пределах даты(1), По документу поставщика(2), Группировать документы по..(3)
			//ДатаПеревставления: 		Дата отчета(0), Дата поставщика(1)
			Если ПараметрыПроцедуры.ПорядокПеревыставления = 0 Тогда
				ДатаДокумента 		= ПараметрыПроцедуры.Дата;
			ИначеЕсли ПараметрыПроцедуры.ПорядокПеревыставления = 1 Тогда
				Если ПараметрыПроцедуры.ДатаПеревставления = 1 Тогда
					ДатаДокумента = Выборка_Дополнительно.ДополнительнаяГруппировка;
				Иначе
					ДатаДокумента = ПараметрыПроцедуры.Дата;
				КонецЕсли;
			ИначеЕсли ПараметрыПроцедуры.ПорядокПеревыставления = 2 Тогда
				Если ПараметрыПроцедуры.ДатаПеревставления = 1 Тогда
					ДатаДокумента = Выборка_Дополнительно.ДополнительнаяГруппировка.Дата;
				Иначе
					ДатаДокумента = ПараметрыПроцедуры.Дата;
				КонецЕсли;
			ИначеЕсли  ПараметрыПроцедуры.ПорядокПеревыставления = 3 Тогда
				ДатаДокумента = Выборка_Дополнительно.ДополнительнаяГруппировка;
			КонецЕсли;
			
			НоваяДата = ДатаДокумента + 1;
			Если День(НоваяДата) <> День(ДатаДокумента) Тогда
				//вышли за пределы дня
				НоваяДата =	ДатаДокумента;
			Конецесли;
			
			НовыйДокумент.Дата = НоваяДата;
							
			Если ЗначениеЗаполнено(ПараметрыДоговора.ПорядокЗачетаАвансовОЗ) Тогда
				НовыйДокумент.СпособЗачетаАвансовОЗ = ПараметрыДоговора.ПорядокЗачетаАвансовОЗ;
			КонецЕсли;
			Если ЗначениеЗаполнено(ПараметрыДоговора.ПорядокЗачетаАвансов) Тогда
				НовыйДокумент.СпособЗачетаАвансов = ПараметрыДоговора.ПорядокЗачетаАвансов;
			КонецЕсли;
			
			Если НЕ ПараметрыПроцедуры.БухгалтерскийУчет Тогда
				НовыйДокумент.СпособЗачетаАвансов = ПредопределенноеЗначение("Перечисление.СпособыЗачетаАвансов.НеЗачитывать");
			КонецЕсли;
			
			//К ранее выставленному(0), Новый счет(1), Без счета(2)
			НовыйДокумент.ФормируетсяСчет = ПараметрыПроцедуры.СчетНаПредоплату = 1;
			Если ПараметрыПроцедуры.СчетНаПредоплату = 0 тогда
				НовыйДокумент.Счет = ПараметрыПроцедуры.СчетНаПредоплату_Значение;
			КонецЕсли;
			
			НовыйДокумент.ФормируетсяСчетФактура = Выборка_Дополнительно.ЕстьСчетФактура;
			
			Если Выборка_Дополнительно.ЕстьСчетФактура Тогда
				НовыйДокумент.ДатаСчетаФактуры 	= НовыйДокумент.Дата;
			КонецЕсли; 
			
			НовыйДокумент.ЭтоУниверсальныйДокумент = ПараметрыДоговора.ИспользуетсяУниверсальныйДокумент;
			
			НовыйДокумент.Комментарий = ПараметрыПроцедуры.Комментарий;
			
			СтруктураКурса = CW_Финансы.ПолучитьКурсВалюты(НовыйДокумент.Валюта,?(НовыйДокумент.ДатаАкта=Дата(1,1,1),НовыйДокумент.Дата,НовыйДокумент.ДатаАкта));
			
			Выборка_Детали = Выборка_Дополнительно.Выбрать();
			
			//вынужденное формирование таблицы значений, 
			//так как в последующих процедурах используется
			//именно такая таблица значений
			ТаблицаУслуг = НовыйДокумент.Услуги.Выгрузить();
			ТаблицаУслуг.Колонки.Добавить("Всего_Рег");
			ТаблицаУслуг.Колонки.Добавить("НДС_Рег");
			ТаблицаУслуг.Колонки.Добавить("Сумма_Рег");
			ТаблицаУслуг.Колонки.Добавить("Цена_Рег");
			
			Пока Выборка_Детали.Следующий() Цикл
				//Заполнение табличной части документа
				НоваяСтрока = ТаблицаУслуг.Добавить();
				
				ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка_Детали);
				
				Если не ЗначениеЗаполнено(НоваяСтрока.СтатьяЗатрат) Тогда
					НоваяСтрока.СтатьяЗатрат = ОсновнаяСтатьяЗатрат;
				Конецесли;
				
				Если не ЗначениеЗаполнено(НоваяСтрока.СтавкаНДС) Тогда
					НоваяСтрока.СтатьяЗатрат =  CW_БухгалтерияЭкспедитораСерверПереопределяемый.СтавкаНДС(НоваяСтрока.Номенклатура, ПараметрыПроцедуры.Дата);
				Конецесли;
				
				НоваяСтрока.ПорядокОтражения = ПредопределенноеЗначение("Перечисление.CW_ПорядокОтраженияДоходов.Перевыставление");
				
				Если ТребуетсяПересчетВалюты Тогда
					ПересчитатьПоКурсу(НоваяСтрока, Выборка_Детали, СтруктураКурса);
				Иначе
					НоваяСтрока.Всего 	= Выборка_Детали.Всего_Рег;
					НоваяСтрока.НДС 	= Выборка_Детали.НДС_Рег;
					НоваяСтрока.Сумма 	= Выборка_Детали.Сумма_Рег;
					НоваяСтрока.Цена 	= Выборка_Детали.Цена_Рег;
				КонецЕсли
				
			КонецЦикла;
			
			НовыйДокумент.Услуги.Загрузить(ТаблицаУслуг);
			НовыйДокумент.Записать(РежимЗаписиДокумента.Запись);
			
			Если ПараметрыПроцедуры.ПорядокПроведенияДокументов = 1 Тогда
				НовыйДокумент.Записать(РежимЗаписиДокумента.Проведение);
			КонецЕсли;
			
			//Подсистема.СтатусыДокументов
			Если ПараметрыПроцедуры.УстановитьСтатусДокумента Тогда
				
				ДанныеДляЗаписи = Новый Структура;
				ДанныеДляЗаписи.Вставить("Документ", 		НовыйДокумент.Ссылка);
				ДанныеДляЗаписи.Вставить("СтатусДокумента", СтатусДокумента);
				ДанныеДляЗаписи.Вставить("Комментарий", 	"");
				ДанныеДляЗаписи.Вставить("Автор", 			ПараметрыСеанса.ТекущийПользователь);
				
				РегистрыСведений.CW_СтатусыДокументов.ДобавитьЗаписьВРегистр(ДанныеДляЗаписи);
			КонецЕсли;
			
			//Подсистема.СтатусыДокументов
			
			МассивДокументов.Добавить(НовыйДокумент.Ссылка);
			
			УстановитьПризнакНаличияИдатуВозвратаОригиналов(НовыйДокумент, УстанавливатьПризнакНаличияДляНовыхСчетов);
			
			//Фиксируем документ в регистре
			КлючЗаписи = Новый Структура("ОтчетЭкспедитора,СвязанныйДокумент",ПараметрыПроцедуры.Ссылка,НовыйДокумент.Ссылка);
			ЗаписатьДокументВРегистр(КлючЗаписи);
			
		КонецЦикла;
		
	КонецЦикла;
	
	Если СтруктураСвязанныеДокументы.ВсеДокументы.Количество() > 0 Тогда
		//нужно открепить существующие документы
		ПометитьНаУдалениеВсеСвязанныеДокументы(СтруктураСвязанныеДокументы);
		Для Каждого СвязанныйДокумент из СтруктураСвязанныеДокументы.ВсеДокументы Цикл
			КлючЗаписи = новый Структура("ОтчетЭкспедитора, СвязанныйДокумент", ПараметрыПроцедуры.Ссылка,СвязанныйДокумент);
			УдалитьЗаписьРегистра(КлючЗаписи);
		КонецЦикла;
	КонецЕсли;
	
	ПоместитьВоВременноеХранилище(МассивДокументов,АдресРезультата);
	
КонецПроцедуры

Процедура УстановитьПризнакНаличияИдатуВозвратаОригиналов(Знач НовыйДокумент, Знач УстанавливатьПризнакНаличияДляНовыхСчетов)
	
	Перем ДанныеДлязаписи, ДатаВозврата, ОригиналыПредоставлены, СтруктураПараметров;
	
	ДатаВозврата 			= Дата(1,1,1);  
	ОригиналыПредоставлены 	= Ложь;
	Если УстанавливатьПризнакНаличияДляНовыхСчетов и  НовыйДокумент.ФормируетсяСчет и НЕ НовыйДокумент.ФормируетсяАкт Тогда
		ОригиналыПредоставлены 	= истина;
		ДатаВозврата 			= ?(ЗначениеЗаполнено(НовыйДокумент.ДатаСчета), НовыйДокумент.ДатаСчета, ТекущаяДата());
		Если Не ЗначениеЗаполнено(ДатаВозврата) Тогда
			ДатаВозврата =  ТекущаяДата();  
		Конецесли
	КонецЕсли;
	
	ДанныеДлязаписи = Новый Структура;
	ДанныеДлязаписи.Вставить("ЗаписьНового"			, Ложь);
	ДанныеДлязаписи.Вставить("Ссылка"				, НовыйДокумент.Ссылка);
	ДанныеДлязаписи.Вставить("Признак"				, ОригиналыПредоставлены);
	ДанныеДлязаписи.Вставить("ДатаВозврата" 		, ДатаВозврата);
	
	СтруктураПараметров = CW_Документы.ПодготовитьСтруктуруДляЗаписиналичияОригиналовДокументов(ДанныеДлязаписи);
	
	CW_Документы.УстановитьПризнакНаличияИдатуВозвратаОригиналов(СтруктураПараметров);

КонецПроцедуры

Процедура УничтожитьВременнуюТаблицу(Знач Запрос, ЗНАЧ ИмяТаблицы)
	
	Запрос.Текст = "УНИЧТОЖИТЬ "+ИмяТаблицы;
	Запрос.Выполнить();

КонецПроцедуры  

Процедура ОтменитьПроведениеВсехСвязанныхДокументов(ПараметрыПроцедуры) Экспорт
	
	Для Каждого СвязанныйДокумент из ПараметрыПроцедуры.ВсеДокументы Цикл
		//Обрабатываем документ
		ДокументОбъект = СвязанныйДокумент.ПолучитьОбъект();
		Если ДокументОбъект.ПометкаУдаления Тогда
			Продолжить;
		КонецЕсли;
		ДокументОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
	КонецЦикла;
	
КонецПроцедуры

Процедура ПометитьНаУдалениеВсеСвязанныеДокументы(ПараметрыПроцедуры) Экспорт
	
	Для Каждого СвязанныйДокумент из ПараметрыПроцедуры.ВсеДокументы Цикл
		//Обрабатываем документ
		ДокументОбъект = СвязанныйДокумент.ПолучитьОбъект();
		ДокументОбъект.УстановитьпометкуУдаления(Истина);
	КонецЦикла;
	
КонецПроцедуры

//Подсистема.СтатусыДокументов
Процедура УстановитьСтатусСвязанныхДокументов(ПараметрыПроцедуры, АдресРезультата=Неопределено) Экспорт
	
	ДанныеДляЗаписи = Новый Структура;
	ДанныеДляЗаписи.Вставить("Документ", 		Неопределено);
	ДанныеДляЗаписи.Вставить("СтатусДокумента", ПараметрыПроцедуры.УстанавливаемыйСтатус);
	ДанныеДляЗаписи.Вставить("Комментарий", 	"");
	ДанныеДляЗаписи.Вставить("Автор", 			ПараметрыСеанса.ТекущийПользователь);
	
	Для Каждого СвязанныйДокумент из ПараметрыПроцедуры.ВсеДокументы Цикл
		
		ДанныеДляЗаписи.Вставить("Документ", СвязанныйДокумент);
		РегистрыСведений.CW_СтатусыДокументов.ДобавитьЗаписьВРегистр(ДанныеДляЗаписи);
		
	КонецЦикла;
	
	ПоместитьВоВременноеХранилище(ПараметрыПроцедуры.ВсеДокументы ,АдресРезультата); 
	
КонецПроцедуры
//Подсистема.СтатусыДокументов

