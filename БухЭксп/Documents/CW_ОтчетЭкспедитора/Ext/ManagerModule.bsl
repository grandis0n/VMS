Процедура ЗаписатьДокументВРегистр(КлючЗаписи) Экспорт 
	
	НоваяЗапись = РегистрыСведений.CW_ДокументыОтчетаЭкспедитора.СоздатьМенеджерЗаписи();
	ЗаполнитьЗначенияСвойств(НоваяЗапись, КлючЗаписи);
	НоваяЗапись.Записать(истина);
	
КонецПроцедуры

Процедура УдалитьЗаписьРегистра(КлючЗаписи) Экспорт
	
	//Удаляем запись регистра
	ЗаписьРегистра  = РегистрыСведений.CW_ДокументыОтчетаЭкспедитора.СоздатьМенеджерЗаписи();
	ЗаполнитьЗначенияСвойств(ЗаписьРегистра, КлючЗаписи);
	ЗаписьРегистра.Прочитать();
	
	Если ЗаписьРегистра.Выбран() Тогда
		ЗаписьРегистра.Удалить();
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьШапкуДокумента(НовыйДокумент, ДанныеШапки)
	
	НовыйДокумент.Организация 					= ДанныеШапки.Организация;
	НовыйДокумент.Ответственный					= ДанныеШапки.Ответственный;
	НовыйДокумент.Руководитель					= ДанныеШапки.Руководитель;
	НовыйДокумент.ЗаРуководителяПоПриказу		= ДанныеШапки.Руководитель_основание;
	НовыйДокумент.ГлавныйБухгалтер				= ДанныеШапки.ГлавныйБухгалтер;
	НовыйДокумент.ЗаГлавногоБухгалтераПоПриказу	= ДанныеШапки.ГлавныйБухгалтер_основание;
	
	НовыйДокумент.ВидОперации 	= ПредопределенноеЗначение("Перечисление.CW_ВидыОперацийДоходыПоГрузоперевозке.ОказаниеУслуг");
	НовыйДокумент.Контрагент 	= ДанныеШапки.Контрагент;
	НовыйДокумент.Договор 		= ДанныеШапки.Договор;
	
	//Подсистема.УчетПриложенийДоговоров
	НовыйДокумент.ПриложениеКДоговору = ДанныеШапки.ПриложениеКДоговору;
	//Подсистема.УчетПриложенийДоговоров
	
	НовыйДокумент.Валюта 		= ДанныеШапки.ВалютаДокумента;  
	
	//Для версии КОРП
	Если ДанныеШапки.ВестиУчетПоПодразделениям Тогда
		НовыйДокумент.ПодразделениеОрганизации = ДанныеШапки.ПодразделениеОрганизации;	
	КонецЕсли;
	//Для версии КОРП

	ЗаполнитьПодписантов(НовыйДокумент, ДанныеШапки);
	
КонецПроцедуры  

Процедура ЗаполнитьПодписантов(НовыйДокумент, Параметры)
	
	Если Не Параметры.ЗаполнятьПодписантов 
		или Не ЗначениеЗаполнено(Параметры.Организация) Тогда
		Возврат;
	КонецЕсли;
	
	//Очистить реквизиты
	НовыйДокумент.Руководитель 					= Неопределено;
	НовыйДокумент.ЗаРуководителяПоПриказу 		= "";
	НовыйДокумент.ГлавныйБухгалтер 				= Неопределено;
	НовыйДокумент.ЗаГлавногоБухгалтераПоПриказу = "";
	
	ДанныеПодписантовОрагнизации = _УФС.ПолучитьОтветственныхЛиц(Параметры.Организация, Параметры.ПодразделениеОрганизации);
	
	ДанныеРуководитель = ДанныеПодписантовОрагнизации.Получить(Перечисления.ОтветственныеЛицаОрганизаций.Руководитель);
	Если ДанныеРуководитель <> Неопределено Тогда
		ДанныеРуководитель.Свойство("УполномоченноеЛицо", НовыйДокумент.Руководитель);
		ДанныеРуководитель.Свойство("НомерДатаПриказа"	, НовыйДокумент.ЗаРуководителяПоПриказу);
	КонецЕсли;
	
	ДанныеГлавныйБухгалтер = ДанныеПодписантовОрагнизации.Получить(Перечисления.ОтветственныеЛицаОрганизаций.ГлавныйБухгалтер);
	Если ДанныеГлавныйБухгалтер <> Неопределено Тогда
		ДанныеГлавныйБухгалтер.Свойство("УполномоченноеЛицо", НовыйДокумент.ГлавныйБухгалтер);
		ДанныеГлавныйБухгалтер.Свойство("НомерДатаПриказа"	, НовыйДокумент.ЗаГлавногоБухгалтераПоПриказу);
	КонецЕсли;
	
	ДанныеОтветственныйЗаОформление = ДанныеПодписантовОрагнизации.Получить(Перечисления.ОтветственныеЛицаОрганизаций.ОтветственныйЗаОформление);
	Если ДанныеОтветственныйЗаОформление <> Неопределено
		И ДанныеГлавныйБухгалтер <> Неопределено Тогда
		ДанныеГлавныйБухгалтер.Свойство("УполномоченноеЛицо", НовыйДокумент.ОтветственныйЗаОформление);
		ДанныеГлавныйБухгалтер.Свойство("НомерДатаПриказа"	, НовыйДокумент.ОтветственныйЗаОформлениеПоПриказу);
	КонецЕсли;
	
КонецПроцедуры
 

Функция ПолучитьГраницупериода(ИсходнаяДата, КоличествоДней)
	
	Запрос = Новый ЗАпрос;
	Запрос.Текст = 	"ВЫБРАТЬ
					|	ДОБАВИТЬКДАТЕ(&ИсходнаяДата, ДЕНЬ, &Количество) КАК ГраницаИнетвала";
	
	Запрос.УстановитьПараметр("ИсходнаяДата", ИсходнаяДата);
	Запрос.УстановитьПараметр("Количество"  , КоличествоДней);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	
	Возврат Выборка.ГраницаИнетвала-1;
	
КонецФункции

Процедура ОбработатьТаблицуРезультата(ВремТаблица, КоличествоДней)
	
	ОтборСтрок = Новый Структура("Заполнено", Ложь);
	ИсходныйМассивСтрок = ВремТаблица.НайтиСтроки(ОтборСтрок);
	
	Если ИсходныйМассивСтрок.Количество() > 0 Тогда
		
		ИсходнаяДата 		= ИсходныйМассивСтрок[0].ДатаЗатрат;
		ГраницаИнтервала    = ПолучитьГраницупериода(ИсходнаяДата, КоличествоДней);
		
		МассивСтрокГруппы 	= Новый Массив;
		ПоследняяДата 		= Дата(1,1,1,0,0,0);
		
		Для Каждого СтрокаМассива из ИсходныйМассивСтрок Цикл
			Если СтрокаМассива.ДатаРасхода <= ГраницаИнтервала Тогда
				МассивСтрокГруппы.Добавить(СтрокаМассива);
				ПоследняяДата =  Макс(ПоследняяДата,СтрокаМассива.ДатаРасхода);
			Иначе
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если ПоследняяДата <> Дата(1,1,1,0,0,0) Тогда
			Для Каждого СтрокаМассива из МассивСтрокГруппы Цикл
				СтрокаМассива.ДополнительнаяГруппировка 	= ПоследняяДата;
				СтрокаМассива.Заполнено 					= Истина;	
			КонецЦикла;	
		КонецЕсли;
		
		ОбработатьТаблицуРезультата(ВремТаблица, КоличествоДней);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПересчитатьПоКурсу(СтрокаДокумента, Детали, СтруктураКурса)
	
	СтрокаДокумента.Всего 	= Окр(_сф.БезопасноРазделить(Окр(Детали.Всего_Рег,2) 	* СтруктураКурса.Кратность,СтруктураКурса.Курс),2);
	СтрокаДокумента.НДС 	= Окр(_сф.БезопасноРазделить(Окр(Детали.НДС_Рег,2) 		* СтруктураКурса.Кратность,СтруктураКурса.Курс),2);
	СтрокаДокумента.Сумма 	= Окр(СтрокаДокумента.Всего - СтрокаДокумента.НДС,2);
	СтрокаДокумента.Цена 	= Окр(_сф.БезопасноРазделить(СтрокаДокумента.Сумма,СтрокаДокумента.Количество),2);
	
КонецПроцедуры

//Шаблоны стандартных писем
Процедура ДополнитьМакросыОбъекта(ДеревоМакросов) Экспорт
	
	ГруппаМакросов = ДеревоМакросов.Строки.Добавить();  
	ГруппаМакросов.ИндексКартинки 	= 0;
	ГруппаМакросов.Значение 		= "";
	ГруппаМакросов.Представление 	= "Отчет экспедитора";
	ГруппаМакросов.ЭтоГруппа 		= Истина;

	ДобавитьСтрокуМакросов(ГруппаМакросов, "[НомерОтчетаЭкспедитора]",	"Номер",	4);
	ДобавитьСтрокуМакросов(ГруппаМакросов, "[ДатаОтчетаЭкспедитора]",	"Дата",		2);
	
	ГруппаМакросовОрганизация = ГруппаМакросов.Строки.Добавить();  
	ГруппаМакросовОрганизация.ИндексКартинки 	= 0;
	ГруппаМакросовОрганизация.Значение 		= "";
	ГруппаМакросовОрганизация.Представление 	= "Организация";
	ГруппаМакросовОрганизация.ЭтоГруппа 		= Истина;

	ДобавитьСтрокуМакросов(ГруппаМакросовОрганизация, "[ОрганизацияСокр]",	"Организация (сокращенное)", 	4);
	ДобавитьСтрокуМакросов(ГруппаМакросовОрганизация, "[ОрганизацияПолн]",	"Организация (полное)",	 		4);

	ДобавитьСтрокуМакросов(ГруппаМакросов, "[Клиент]", "Клиент", 4); 
	
	ГруппаМакросовДоговор = ГруппаМакросов.Строки.Добавить();  
	ГруппаМакросовДоговор.ИндексКартинки 	= 0;
	ГруппаМакросовДоговор.Значение 			= "";
	ГруппаМакросовДоговор.Представление 	= "Договор";
	ГруппаМакросовДоговор.ЭтоГруппа 		= Истина;

	ДобавитьСтрокуМакросов(ГруппаМакросовДоговор, "[НомерДоговора]",	"Номер",	4);
	ДобавитьСтрокуМакросов(ГруппаМакросовДоговор, "[ДатаДоговора]",		"Дата",		2);  

	ДобавитьСтрокуМакросов(ГруппаМакросов, "[СписокГрузоперевозок]",	"Список грузоперевозок",	9);
	ДобавитьСтрокуМакросов(ГруппаМакросов, "[СписокЗаказов]",			"Список заказов",			9);
	
	ГруппаПараметров = ГруппаМакросов.Строки.Добавить();  
	ГруппаПараметров.ИндексКартинки = 0;
	ГруппаПараметров.Значение 		= "";
	ГруппаПараметров.Представление 	= "Параметры грузоперевозок";
	ГруппаПараметров.ЭтоГруппа 		= Истина;
	
	ПланыВидовХарактеристик.CW_ПараметрыГрузоперевозок.ДополнитьМакросыПараметровГрузоперевозок(ГруппаПараметров);

КонецПроцедуры  

Процедура ДобавитьСтрокуМакросов(ГруппаМакросов, Значение, Представление, ИндексКартинки)
	
	СтрокаМакроса = ГруппаМакросов.Строки.Добавить();
	СтрокаМакроса.ИндексКартинки 	= ИндексКартинки;
	СтрокаМакроса.Значение 			= Значение;
	СтрокаМакроса.Представление 	= Представление;
	СтрокаМакроса.ЭтоГруппа 		= Ложь;
	
КонецПроцедуры


Процедура ПолучитьОписаниеМакросов(Результат, СтруктураПараметров=Неопределено) Экспорт
	
	Результат.Вставить("[ОрганизацияСокр]",	"");
	Результат.Вставить("[ОрганизацияПолн]",	"");
	
	Результат.Вставить("[ОрганизацияСокр]",	"Справочники.Организации.НаименованияНаДату(Источник.Организация,Источник.Дата).СокращенноеНаименование");
	Результат.Вставить("[ОрганизацияПолн]",	"Справочники.Организации.НаименованияНаДату(Источник.Организация,Источник.Дата).ПолноеНаименование");
	
	Результат.Вставить("[Клиент]", 					"Источник.Контрагент.НаименованиеПолное");
	Результат.Вставить("[СписокГрузоперевозок]", 	"МенеджерОбъектаШаблона.ПолучитьСписокГрузоперевозок(Источник)");  
	Результат.Вставить("[СписокЗаказов]", 			"МенеджерОбъектаШаблона.ПолучитьСписокЗаказов(Источник)");
	
	Результат.Вставить("[НомерДоговора]",			"Источник.Договор.НомерДоговора");
	Результат.Вставить("[ДатаДоговора]",			"Источник.Договор.ДатаДоговора");
	Результат.Вставить("[НомерОтчетаЭкспедитора]",	"CW_Документы.ПолучитьНомерНаПечать(Источник)");
	Результат.Вставить("[ДатаОтчетаЭкспедитора]",	"Источник.Дата");
	
	Результат.Вставить("[ФИООтправителя]", "CW_Печать.ФамилияИОИзСтрокиФамилияИмяОтчество(НастройкиПользователя.ФИО, Источник.Дата)");
	
	ПланыВидовХарактеристик.CW_ПараметрыГрузоперевозок.ОписаниеМакросовПараметровГрузоперевозок(Результат);
	
КонецПроцедуры  

Функция ПолучитьСписокГрузоперевозок(Источник) Экспорт
	
	Массив = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ТабличнаяЧастьУслуги.Грузоперевозка КАК Грузоперевозка
	|ИЗ
	|	Документ.CW_ОтчетЭкспедитора.Услуги КАК ТабличнаяЧастьУслуги
	|ГДЕ
	|	ТабличнаяЧастьУслуги.Ссылка = &Источник";
	
	Запрос.УстановитьПараметр("Источник", Источник); 
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		Массив.Добавить(Выборка.Грузоперевозка);
	КонецЦикла;
	
	Возврат СтрСоединить(Массив, ", ");
	
КонецФункции  

Функция ПолучитьСписокЗаказов(Источник) Экспорт
	
	Массив = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ТабличнаяЧастьУслуги.Грузоперевозка.Заказ КАК Заказ
	|ИЗ
	|	Документ.CW_ОтчетЭкспедитора.Услуги КАК ТабличнаяЧастьУслуги
	|ГДЕ
	|	ТабличнаяЧастьУслуги.Ссылка = &Источник";
	
	Запрос.УстановитьПараметр("Источник", Источник); 
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		Массив.Добавить(Выборка.Заказ);
	КонецЦикла;
	
	Возврат СтрСоединить(Массив, ", ");
	
КонецФункции

Функция ПолучитьЗначениеПараметра(Источник, ИдентификаторПараметра,  ПолучаемоеЗначение = "Значение", СоответствиеПараметров) Экспорт

	ПараметрСсылка = СоответствиеПараметров.Получить(ИдентификаторПараметра);
	Если ПараметрСсылка = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	МассивГрузоперевозок = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ТабличнаяЧастьУслуги.Грузоперевозка КАК Грузоперевозка
	               |ИЗ
	               |	Документ.CW_ОтчетЭкспедитора.Услуги КАК ТабличнаяЧастьУслуги
	               |ГДЕ
	               |	ТабличнаяЧастьУслуги.Ссылка = &Источник
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ТабличнаяЧастьУслуги.Грузоперевозка";
	
	Запрос.УстановитьПараметр("Источник", Источник); 
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		МассивГрузоперевозок.Добавить(Выборка.Грузоперевозка);
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	CW_Грузоперевозки.Ссылка КАК Ссылка,
	               |	ЕСТЬNULL(ПараметрыГрузоперевозок.Значение, ЕСТЬNULL(ПараметрыЗаказов.Значение, НЕОПРЕДЕЛЕНО)) КАК Значение,
	               |	ЕСТЬNULL(ПараметрыГрузоперевозок.ЗначениеПлан, ЕСТЬNULL(ПараметрыЗаказов.ЗначениеПлан, НЕОПРЕДЕЛЕНО)) КАК ЗначениеПлан,
	               |	ЕСТЬNULL(ПараметрыГрузоперевозок.ЗначениеФакт, ЕСТЬNULL(ПараметрыЗаказов.ЗначениеФакт, НЕОПРЕДЕЛЕНО)) КАК ЗначениеФакт
	               |ИЗ
	               |	Справочник.CW_Грузоперевозки КАК CW_Грузоперевозки
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.CW_ХарактеристикиГрузоперевозок КАК ПараметрыГрузоперевозок
	               |		ПО CW_Грузоперевозки.Ссылка = ПараметрыГрузоперевозок.Грузоперевозка
	               |			И (ПараметрыГрузоперевозок.Параметр = &Параметр)
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.CW_ХарактеристикиЗаказов КАК ПараметрыЗаказов
	               |		ПО CW_Грузоперевозки.Заказ = ПараметрыЗаказов.Заказ
	               |			И (ПараметрыЗаказов.Параметр = &Параметр)
	               |ГДЕ
	               |	CW_Грузоперевозки.Ссылка В(&МассивГрузоперевозок)";
	
	Запрос.УстановитьПараметр("МассивГрузоперевозок", 	МассивГрузоперевозок);
