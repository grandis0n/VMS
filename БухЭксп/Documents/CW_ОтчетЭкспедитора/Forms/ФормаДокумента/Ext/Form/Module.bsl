Процедура ПослеВводаКоличества(Число, Параметры) Экспорт
	
	Если НЕ Число = Неопределено Тогда
		// обработка введенного количества
		
		Если Число = 0 Тогда
			Режим = РежимДиалогаВопрос.ДаНет;
			Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаВводаЧисла", ЭтотОбъект, Параметры);
			ПоказатьВопрос(Оповещение, "Недопустимое количество дней 0. Будет устанвлено значение 5. Продолжить?", Режим, 0);
		Иначе
			ПродолжитьОбработкуВведенногоЗначения(Число);
		Конецесли;
		
	КонецЕсли;
	
КонецПроцедуры

