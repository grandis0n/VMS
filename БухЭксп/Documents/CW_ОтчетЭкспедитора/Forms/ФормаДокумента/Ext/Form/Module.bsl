	ОповещениеОЗавершении = Новый ОписаниеОповещения("ОбработатьРезультатОтсоедениенияДокумента", ЭтотОбъект);
	
	ДлительныеОперацииКлиент.ОжидатьЗавершение(РезультатВыполнения, ОповещениеОЗавершении, ПараметрыОжидания);
	
КонецПроцедуры

&НаСервере
Функция РазоватьСвязьДокументаНаСервереВФоне()
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(Новый УникальныйИдентификатор);
	ПараметрыВыполнения.ОжидатьЗавершение 			= 0; // запускать сразу
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = "Открпеление связанных документов (Отчет экспедитора)";
	ПараметрыВыполнения.ЗапуститьВФоне 				= Истина;
	ПараметрыВыполнения.ЗапуститьНеВФоне 			= ложь;
	
	ПараметрыПроцедуры = Новый Структура;
	ПараметрыПроцедуры.Вставить("ВсеДокументы", Элементы.СвязанныеДокументы.ВыделенныеСтроки);
	ПараметрыПроцедуры.Вставить("Ссылка", Объект.Ссылка);
	
	Возврат ДлительныеОперации.ВыполнитьВФоне("Документы.CW_ОтчетЭкспедитора.РазоватьСвязьДокументаНаСервере",ПараметрыПроцедуры, ПараметрыВыполнения);

КонецФункции


&НаКлиенте
Процедура ОбработатьРезультатОтсоедениенияДокумента(РезультатВыполнения, ДополнительныеПараметры) Экспорт
	
	Если РезультатВыполнения.Статус = "Выполнено" Тогда
		
		ЗаполнитьИтогиПоОтчетуНаСервере(Истина);
	ОбновитьЗаголовкиСтраниц(Истина);	
		УстановитьДоступностьЭлементовФормы();
		
		МассивДокументов = ПолучитьИзВременногоХранилища(РезультатВыполнения.АдресРезультата); 
		
		Если  МассивДокументов.Количество() > 0 Тогда
			ОповеститьОбИзменении(МассивДокументов[0]);
		КонецЕсли;

		ТексСообщения = СтрСоединить(МассивДокументов,Символы.ПС);
		
		ПоказатьОповещениеПользователя("Документы отсоединены ("+Формат(МассивДокументов.Количество(),"ЧГ=0")+"):",,ТексСообщения,,СтатусОповещенияПользователя.Информация);
		
	ИначеЕсли РезультатВыполнения.Статус = "Ошибка" Тогда
		
		ТекстПредупреждения = "Не удалось отсоединить документы!
		| По причине: "+ РезультатВыполнения.КраткоеПредставлениеОшибки + "
		| Информаиция об ошибке см. в журнале регистрации!";
		
		ПоказатьПредупреждение(,ТекстПредупреждения);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьДокументы(Команда)
	
	Если Модифицированность или ЭтоНовый Тогда
		Режим = РежимДиалогаВопрос.ДаНет;
		Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаЗаписиДокумента", ЭтаФорма, Параметры);
		ПоказатьВопрос(Оповещение, "Перед формированием документов необходимо записать документ! Продолжить?", Режим, 0); 
	Иначе
		ПродолжитьФормированиеДокументов();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияВопросаЗаписиДокумента(Результат, Параметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;
	
	Записать();
	
	Если ЭтоНовый Тогда
		УстановитьОтборДинамическогоСписка();
		ЭтоНовый = Ложь;
	КонецЕсли;
	
	ПродолжитьФормированиеДокументов();
	
КонецПроцедуры

&НаКлиенте
Процедура ПродолжитьФормированиеДокументов()
	
	Отказ = ПроверитьВозможностьФормированияДрокументов();
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	РезультатВыполнения =  ПродолжитьФормированиеДокументовНаСервереВФоне();
	
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ВыводитьОкноОжидания = Истина;
	ОповещениеОЗавершении = Новый ОписаниеОповещения("ОбработатьРезультатФормированияДокументов", ЭтотОбъект);
	
	ДлительныеОперацииКлиент.ОжидатьЗавершение(РезультатВыполнения, ОповещениеОЗавершении, ПараметрыОжидания);

КонецПроцедуры

&НаСервере
Функция ПродолжитьФормированиеДокументовНаСервереВФоне()
	
	СтруктураПараметровБухУчета = Новый Структура;
	СтруктураПараметровБухУчета.Вставить("Договор", 				Объект.Договор);
	СтруктураПараметровБухУчета.Вставить("ПриложениеКДоговору",		Объект.ПриложениеКДоговору);
	
	ПараметрыБухгалтерскогоУчета = CW_Финансы.ПолучитьПарметрыВеденияБухгалтерскогоУчета(СтруктураПараметровБухУчета, Объект.Дата);
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(Новый УникальныйИдентификатор);
	ПараметрыВыполнения.ОжидатьЗавершение 			= 0; // запускать сразу
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = "Запонение табличной части услуги (Отчет экспедитора)";
	ПараметрыВыполнения.ЗапуститьВФоне 				= Истина;
	ПараметрыВыполнения.ЗапуститьНеВФоне 			= ложь;
	
	ПараметрыПроцедуры = Новый Структура;
	ПараметрыПроцедуры.Вставить("Ссылка", Объект.Ссылка);
	ПараметрыПроцедуры.Вставить("Дата", Объект.Дата);
	ПараметрыПроцедуры.Вставить("Организация", Объект.Организация);
	ПараметрыПроцедуры.Вставить("Контрагент", Объект.Контрагент);
	ПараметрыПроцедуры.Вставить("Договор", Объект.Договор);
	
	//Подсистема.УчетПриложенийДоговоров
	ПараметрыПроцедуры.Вставить("ПриложениеКДоговору", Объект.ПриложениеКДоговору);
	//Подсистема.УчетПриложенийДоговоров
	
	ПараметрыПроцедуры.Вставить("ПодразделениеОрганизации", Объект.ПодразделениеОрганизации);
	ПараметрыПроцедуры.Вставить("ВестиУчетПоПодразделениям", ВестиУчетПоПодразделениям);
	ПараметрыПроцедуры.Вставить("ВалютаДокумента", Объект.ВалютаДокумента);
	ПараметрыПроцедуры.Вставить("ВалютаРегламентированногоУчета", ВалютаРегламентированногоУчета);
	ПараметрыПроцедуры.Вставить("ПорядокПеревыставления", Объект.ПорядокПеревыставления);
	ПараметрыПроцедуры.Вставить("ДатаПеревставления", Объект.ДатаПеревставления);
	ПараметрыПроцедуры.Вставить("ТаблицаУслуг", Объект.Услуги.Выгрузить());
	ПараметрыПроцедуры.Вставить("КоличествоДней", Объект.КоличествоДней);
	
	ПараметрыПроцедуры.Вставить("Руководитель", Объект.Руководитель);
	ПараметрыПроцедуры.Вставить("Руководитель_основание", Объект.Руководитель_основание);
	ПараметрыПроцедуры.Вставить("ГлавныйБухгалтер", Объект.ГлавныйБухгалтер);
	ПараметрыПроцедуры.Вставить("ГлавныйБухгалтер_основание", Объект.ГлавныйБухгалтер_основание);
	ПараметрыПроцедуры.Вставить("Ответственный", Объект.Ответственный);
	
	ПараметрыПроцедуры.Вставить("СчетНаПредоплату", Объект.СчетНаПредоплату);
	ПараметрыПроцедуры.Вставить("СчетНаПредоплату_Значение", Объект.СчетНаПредоплату_Значение);
	
	ПараметрыПроцедуры.Вставить("БухгалтерскийУчет", ПараметрыБухгалтерскогоУчета.БухгалтерскийУчет);

	ПараметрыПроцедуры.Вставить("ПорядокПроведенияДокументов", Объект.ПорядокПроведенияДокументов);
	ПараметрыПроцедуры.Вставить("Комментарий", Объект.Комментарий);
	
	
	ЗаполнятьПодписантов = CW_Настройки.ПолучитьНастройкуПользователя(,"ПодставлятьУполномоченныхЛицПриСозданииДокументов");
	ПараметрыПроцедуры.Вставить("ЗаполнятьПодписантов", ЗаполнятьПодписантов);
	
	
	//Подсистема.СтатусыДокументов
	ПараметрыПроцедуры.Вставить("УстановитьСтатусДокумента", ПолучитьФункциональнуюОпцию("CW_ИспользуютсяСтатусыДокументов"));
	ПараметрыПроцедуры.Вставить("СтатусДокумента", СтатусДокумента);
	//Подсистема.СтатусыДокументов
	
	Возврат ДлительныеОперации.ВыполнитьВФоне("Документы.CW_ОтчетЭкспедитора.СформироватьДокументыОтчетаЭкспедитора",ПараметрыПроцедуры, ПараметрыВыполнения);
	
КонецФункции

&НаКлиенте
Процедура ОбработатьРезультатФормированияДокументов(РезультатВыполнения, Дополнительныепараметры) Экспорт
	
	Если РезультатВыполнения.Статус = "Выполнено" Тогда
		
		ЗаполнитьИтогиПоОтчетуНаСервере(Истина);
		ОбновитьЗаголовкиСтраниц(Истина);	
		УстановитьДоступностьЭлементовФормы();
		
		МассивДокументов = ПолучитьИзВременногоХранилища(РезультатВыполнения.АдресРезультата);      
		ТексСообщения = СтрСоединить(МассивДокументов,Символы.ПС);
		
		Если МассивДокументов.Количество()> 0 Тогда
			ОповеститьОбИзменении(МассивДокументов[0]);
		КонецЕсли;
		
		ПоказатьОповещениеПользователя("Сформированы документы ("+Формат(МассивДокументов.Количество(),"ЧГ=0")+"):",,ТексСообщения,,СтатусОповещенияПользователя.Информация);
		
		Элементы.Группа_Страницы.ТекущаяСтраница = Элементы.Страница_Документы;
		
	ИначеЕсли РезультатВыполнения.Статус = "Ошибка" Тогда
		
		ТекстПредупреждения = "Документы не сформированы!
		| По причине: "+ РезультатВыполнения.КраткоеПредставлениеОшибки + "
		| Информаиция об ошибке см. в журнале регистрации!";
		
		Если ТипЗнч(РезультатВыполнения.Сообщения) = Тип("Массив") Тогда
			Для Каждого СообщениеВМассиве из РезультатВыполнения.Сообщения Цикл
				СообщениеВМассиве.Сообщить();
			КонецЦикла;
		КонецЕсли;
		
		ПоказатьПредупреждение(,ТекстПредупреждения,,"Ошибка формирования документов");
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти


#Область Обработка_данных_НаКлиенте

&НаКлиенте
Процедура УслугиОчистить(Команда)
	
	Если Объект.Услуги.Количество() > 0 Тогда
		
		Режим = РежимДиалогаВопрос.ДаНет;
		Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаОбОчистке", ЭтаФорма, Параметры);
		ПоказатьВопрос(Оповещение, "Табличная часть документа будет очищена. Продолжить?", Режим, 0); 
		
	Иначе
		Объект.Услуги.Очистить();
		УстановитьДоступностьЭлементовФормы();	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияВопросаОбОчистке(Результат, Параметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;
	
	Объект.Услуги.Очистить();
	УстановитьДоступностьЭлементовФормы();	
	
КонецПроцедуры

&НаКлиенте
Процедура УслугиКоличествоПриИзменении(Элемент)
	
	ПересчитатьСуммыСтроки(Элементы.Услуги.ТекущиеДанные) ;
	
КонецПроцедуры

&НаКлиенте
Процедура УслугиЦенаПриИзменении(Элемент)
	
	ПересчитатьСуммыСтроки(Элементы.Услуги.ТекущиеДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьСуммыСтроки(СтрокаТаблицы)
	
	Ставка = CW_Финансы.ПолучитьСтавкуНДС(СтрокаТаблицы.СтавкаНДС);
	
	СтрокаТаблицы.Сумма		= СтрокаТаблицы.Цена 		* СтрокаТаблицы.Количество;
	СтрокаТаблицы.СуммаНДС	= Окр(СтрокаТаблицы.Сумма 	* Ставка/100,2,1);
	СтрокаТаблицы.Всего		= СтрокаТаблицы.Сумма 		+ СтрокаТаблицы.СуммаНДС;
	
КонецПроцедуры

&НаКлиенте
Процедура УслугиСуммаПриИзменении(Элемент)
	УслугиСуммаПриИзмененииНаСервере(Элементы.Услуги.ТекущаяСтрока);
КонецПроцедуры

&НаКлиенте
Процедура УслугиСуммаНДСПриИзменении(Элемент)
	
	СтрокаТаблицы = Элементы.Услуги.ТекущиеДанные;
	
	Если НЕ ОбратныйПересчетВДокументах Тогда
		СтрокаТаблицы.Всего = СтрокаТаблицы.Сумма + СтрокаТаблицы.СуммаНДС;
	Иначе
		СтрокаТаблицы.Сумма = СтрокаТаблицы.Всего - СтрокаТаблицы.СуммаНДС;
		СтрокаТаблицы.Цена = _сф.БезопасноРазделить(СтрокаТаблицы.Сумма,СтрокаТаблицы.Количество);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УслугиВсегоПриИзменении(Элемент)
	
	СтрокаТаблицы = Элементы.Услуги.ТекущиеДанные;
	
	Ставка = CW_Финансы.ПолучитьСтавкуНДС(СтрокаТаблицы.СтавкаНДС);
	
	СтрокаТаблицы.СуммаНДС 	= СтрокаТаблицы.Всего	*	Ставка/(100+Ставка);
	СтрокаТаблицы.Сумма 	= СтрокаТаблицы.Всего 	- 	СтрокаТаблицы.СуммаНДС;
	СтрокаТаблицы.Цена 		= _сф.БезопасноРазделить(СтрокаТаблицы.Сумма,СтрокаТаблицы.Количество);
	
	
КонецПроцедуры

&НаКлиенте
Процедура ГрузоперевозкиКлиента(Команда)
	
	Отказ = Ложь;
	ПроверитьЗаполнениеРеквизитов(Отказ);

	Если Не Отказ Тогда
		
		ЕстьМножественныйВыбор 	= Ложь;
		
		ВыборПоГрузоперевозкам 	= Ложь;
		ВыборПоДокументам		= Ложь;
		ВыборПоЗаказам	        = Ложь;
		
		Если Объект.ПорядокЗаполнения = 1 или Объект.ПорядокЗаполнения = 3 или Объект.ПорядокЗаполнения = 5 Тогда
			ЕстьМножественныйВыбор = истина;
		КонецЕсли;
		
		ВыборПоГрузоперевозкам 	= Объект.ПорядокЗаполнения = 0 или Объект.ПорядокЗаполнения = 1;
		ВыборПоЗаказам 			= Объект.ПорядокЗаполнения = 2 или Объект.ПорядокЗаполнения = 3;
		ВыборПоДокументам 		= Объект.ПорядокЗаполнения = 4 или Объект.ПорядокЗаполнения = 5;
	
		ОповещениеПриЗакрытии = Новый ОписаниеОповещения("ПослеЗакрытияФормыВыбораГрузоперевозок",ЭтаФорма,ЕстьМножественныйВыбор);
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("ВыборИзДокументаОтчетЭкспедитора"	, Истина);
		ПараметрыФормы.Вставить("ДатаОстатка"						, ?(ЗначениеЗаполнено(Объект.Дата),Объект.Дата, ТекущаяДата()));
		ПараметрыФормы.Вставить("Контрагент"						, Объект.Контрагент);
		ПараметрыФормы.Вставить("Договор"							, Объект.Договор);
		
		//Подсистема.УчетПриложенийДоговоров
		ПараметрыФормы.Вставить("ПриложениеКДоговору"				, Объект.ПриложениеКДоговору);
		//Подсистема.УчетПриложенийДоговоров
		
		ПараметрыФормы.Вставить("ВыборПоЗаказам"					, ВыборПоЗаказам);
		ПараметрыФормы.Вставить("ВыборПоДокументам"					, ВыборПоДокументам);
		ПараметрыФормы.Вставить("ВыборПоГрузоперевозкам"			, ВыборПоГрузоперевозкам);
		
		ПараметрыФормы.Вставить("ЕстьМножественныйВыбор"			, ЕстьМножественныйВыбор);
		ПараметрыФормы.Вставить("ЗакрыватьПриВыборе"				, Истина);
		ПараметрыФормы.Вставить("РежимВыбора"						, Истина);
		ПараметрыФормы.Вставить("Организация"						, Объект.Организация);
		ПараметрыФормы.Вставить("ПодразделениеОрганизации"			, Объект.ПодразделениеОрганизации);
		
		ОткрытьФорму("Документ.CW_ОтчетЭкспедитора.Форма.ФормаВыбораГрузоперевозокПоОстаткам" , ПараметрыФормы, ЭтаФорма,,,,ОповещениеПриЗакрытии, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьЗаполнениеРеквизитов(Отказ)
	
	Если не ЗначениеЗаполнено(Объект.Контрагент) Тогда
		
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст 		= "Не выбран контрагент!";
		Сообщение.Поле  		= "Контрагент";
		Сообщение.ПутьКДанным	= "Объект";
		Сообщение.Сообщить();
		
		Отказ = истина;
	КонецЕсли;	
	
	Если НЕ ЗначениеЗаполнено(Объект.Договор) Тогда
		
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст 		= "Не выбран договор!";
		Сообщение.Поле  		= "Договор";
		Сообщение.ПутьКДанным	= "Объект";
		Сообщение.Сообщить();
		
		Отказ = истина;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияФормыВыбораГрузоперевозок(Результат,ДополнительныеПараметры) Экспорт
	
	Если Результат <> Неопределено Тогда
		
		ОбработатьРезульатаНаСервере(Результат, ДополнительныеПараметры);
		
		//После выбора грузоперевозок перезаполняем табличную часть
		РезультатВыполнения =  ЗаполнитьНаСервереВФоне();
		
		ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
		ПараметрыОжидания.ВыводитьОкноОжидания = Истина;
		ОповещениеОЗавершении = Новый ОписаниеОповещения("ОбработатьРезультатЗаполнения", ЭтотОбъект);
		
		ДлительныеОперацииКлиент.ОжидатьЗавершение(РезультатВыполнения, ОповещениеОЗавершении, ПараметрыОжидания);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДоговорНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	Если не ЗначениеЗаполнено(Объект.Контрагент) Тогда
		
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст 		= "Не выбран контрагент!";
		Сообщение.Поле  		= "Контрагент";
		Сообщение.ПутьКДанным	= "Объект";
		Сообщение.Сообщить();

		
		СтандартнаяОбработка = ложь;
		
	КонецЕсли;
	
КонецПроцедуры


#КонецОбласти

#Область Обработка_данных_НаСервере

&НаСервере
Функция ПолучитьСостояниеДокумента()
	
	Если Объект.ПометкаУдаления Тогда
		Возврат 4;
	Иначе
		Возврат 1;
	КонецЕсли;
	
КонецФункции

&НаСервере
Функция ПолучитьПараметрыДокумента(Ссылка)
	
	МетаданныеДокумента	= Ссылка.Метаданные();
	
	ЕстьРучнаяКорректировка	= ОбщегоНазначения.ЕстьРеквизитОбъекта("РучнаяКорректировка", МетаданныеДокумента);
	
	ИменаРеквизитов	= "Проведен, ПометкаУдаления";
	Если ЕстьРучнаяКорректировка Тогда
		ИменаРеквизитов	= ИменаРеквизитов + ", РучнаяКорректировка";
	КонецЕсли;
	
	Результат	= ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Ссылка, ИменаРеквизитов);
	Если НЕ ЕстьРучнаяКорректировка Тогда
		Результат.Вставить("РучнаяКорректировка", Ложь);
	КонецЕсли;
	
	Результат.Вставить("РегОперация",	БухгалтерскийУчетКлиентСерверПереопределяемый.ЭтоРегламентнаяОперация(Ссылка));
	Результат.Вставить("ОперацияБух",	ТипЗнч(Ссылка) = Тип("ДокументСсылка.ОперацияБух"));
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура ОбработатьРезульатаНаСервере(Результат,ЕстьМножественныйВыбор)
	
	Если ЭтоАдресВременногоХранилища(Результат) Тогда
		
		МассивОбъектов = ПолучитьИзВременногоХранилища(Результат);
		Если ЕстьМножественныйВыбор тогда
			ЗначениеЗаполненияСписок.ЗагрузитьЗначения(МассивОбъектов);
		Иначе
			ЗначениеЗаполненияСсылка = МассивОбъектов[0];
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьГрузоперевозкиКлиентаНаСервере(ОтобрГрузоперевозок)
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.Текст = "ВЫБРАТЬ
	|	CW_ПеревыставлениеОстатки.Грузоперевозка КАК Грузоперевозка,
	|	CW_ПеревыставлениеОстатки.КоличествоОстаток КАК КоличествоОстаток,
	|	CW_ПеревыставлениеОстатки.ВсегоОстаток КАК ВсегоОстаток,
	|	CW_ПеревыставлениеОстатки.СуммаОстаток КАК СуммаОстаток,
	|	CW_ПеревыставлениеОстатки.НДСОстаток КАК НДСОстаток
	|ПОМЕСТИТЬ ВТ_Грузоперевозки
	|ИЗ
	|	РегистрНакопления.CW_Перевыставление.Остатки(
	|			&ДатаОтчета,
	|			Контрагент = &Контрагент
	//Подсистема.УчетПриложенийДоговоров
	|			И ПриложениеКДоговору = &ПриложениеКДоговору
	//Подсистема.УчетПриложенийДоговоров
	|				И Договор = &Договор) КАК CW_ПеревыставлениеОстатки";
	
	Запрос.УстановитьПараметр("ДатаОтчета"	, Объект.Дата);	
	Запрос.УстановитьПараметр("Контрагент"	, Объект.Контрагент);	
	Запрос.УстановитьПараметр("Договор"		, Объект.Договор);	
	
	//Подсистема.УчетПриложенийДоговоров
	Запрос.УстановитьПараметр("ПриложениеКДоговору"		, Объект.ПриложениеКДоговору);	
	//Подсистема.УчетПриложенийДоговоров
	
	Запрос.Выполнить();
	
	Если  ОтобрГрузоперевозок тогда
		
		Запрос.Текст = "ВЫБРАТЬ
		|	ВТ_Грузоперевозки.Грузоперевозка КАК ОбъектОтбора
		|ИЗ
		|	ВТ_Грузоперевозки КАК ВТ_Грузоперевозки
		|
		|СГРУППИРОВАТЬ ПО
		|	ВТ_Грузоперевозки.Грузоперевозка"
		
	Иначе
		
		Запрос.Текст = "ВЫБРАТЬ
		|	ВТ_Грузоперевозки.Грузоперевозка.Заказ КАК ОбъектОтбора
		|ИЗ
		|	ВТ_Грузоперевозки КАК ВТ_Грузоперевозки
		|
		|СГРУППИРОВАТЬ ПО
		|	ВТ_Грузоперевозки.Грузоперевозка.Заказ";
		
	КонецЕсли;
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если не РезультатЗапроса.Пустой() Тогда
		
		Возврат РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("ОбъектОтбора");
		
	КонецЕсли;
	
	Возврат Новый Массив;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьИтогиПоОтчетуНаСервере(ПолучитьИтогиПоПеревыставленным = Ложь)
	
	//Таблица услуги
	Итог_Получено_Сумма   = Объект.Услуги.Итог("Сумма_1");
	Итог_Получено_НДС     = Объект.Услуги.Итог("СуммаНДС_1");
	Итог_Получено_Всего   = Объект.Услуги.Итог("Всего_1");
	
	Итог_Перевыставить_Сумма   	= Объект.Услуги.Итог("Сумма");
	Итог_Перевыставить_НДС     	= Объект.Услуги.Итог("СуммаНДС");
	Итог_Перевыставить_Всего   	= Объект.Услуги.Итог("Всего");
	СтрВалюта 					= Строка(ВалютаРегламентированногоУчета);
	СтрВалютаДоговора 			= Строка(Объект.ВалютаДокумента);
	
	Элементы.Строка_ИтогоПолученоРасходов.ЦветТекста 		=  ?(Итог_Получено_Сумма <> Итог_Перевыставить_Сумма, 	Новый Цвет(255,0,0),	Новый Цвет);
	Элементы.Строка_ИтогоПеревыставитьРасходов.ЦветТекста 	=  ?(Итог_Получено_НДС 	 <> Итог_Перевыставить_НДС, 	Новый Цвет(255,0,0),	Новый Цвет);
	Элементы.Строка_ИтогоПеревытавленоРасходов.ЦветТекста 	=  ?(Итог_Получено_Всего <> Итог_Перевыставить_Всего, 	Новый Цвет(255,0,0),	Новый Цвет);
	
	Строка_ИтогоПолученоРасходов 		= "Получено расходов: "+Формат(Итог_Получено_Сумма,"ЧДЦ=2")+" "+ СтрВалюта+ 
										?(Итог_Получено_НДС = 0,"", ", НДС: "+Формат(Итог_Получено_НДС,"ЧДЦ=2")+" "+СтрВалюта)+ 
										", Всего: "+ Формат(Итог_Получено_Всего,"ЧДЦ=2")+" "+СтрВалюта;
									
	Строка_ИтогоПеревыставитьРасходов 	= "К перевыставлению: "+Формат(Итог_Перевыставить_Сумма,"ЧДЦ=2")+" "+СтрВалюта+ 
										?(Итог_Перевыставить_НДС = 0,"", ", НДС: "+Формат(Итог_Перевыставить_НДС,"ЧДЦ=2")+" "+СтрВалюта)+ 
										", Всего: "+ Формат(Итог_Перевыставить_Всего,"ЧДЦ=2")+" "+СтрВалюта;
										
	Строка_ИтогоПеревытавленоРасходов 				 = "Перевыставлено: ";
	Строка_ИтогоПеревытавленоРасходовВВалютеДоговора = "Перевыставлено: ";
										
	Итог_Перевыставлено_Сумма   = 0;
	Итог_Перевыставлено_НДС   	= 0;
	Итог_Перевыставлено_Всего  	= 0;
	
	Итог_Перевыставлено_СуммаВал  = 0;	
	Итог_Перевыставлено_НДСВал    = 0;
	Итог_Перевыставлено_ВсегоВал  = 0;
	
	Если ПолучитьИтогиПоПеревыставленным тогда
		
		Запрос = новый Запрос;
		запрос.Текст = "ВЫБРАТЬ
		               |	CW_ДокументыОтчетаЭкспедитора.СвязанныйДокумент КАК СвязанныйДокумент
		               |ПОМЕСТИТЬ ВТ_Документы
		               |ИЗ
		               |	РегистрСведений.CW_ДокументыОтчетаЭкспедитора КАК CW_ДокументыОтчетаЭкспедитора
		               |ГДЕ
		               |	CW_ДокументыОтчетаЭкспедитора.ОтчетЭкспедитора = &ОтчетЭкспедитора
		               |	И CW_ДокументыОтчетаЭкспедитора.СвязанныйДокумент.Проведен
		               |	И CW_ДокументыОтчетаЭкспедитора.СвязанныйДокумент.ФормируетсяАкт = ИСТИНА
		               |
		               |ИНДЕКСИРОВАТЬ ПО
		               |	СвязанныйДокумент
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ
		               |	CW_ДоходыПоГрузоперевозкамОбороты.ДокументДоходов КАК ДокументДоходов,
		               |	CW_ДоходыПоГрузоперевозкамОбороты.ВсегоОборот КАК ВсегоОборот,
		               |	CW_ДоходыПоГрузоперевозкамОбороты.СуммаОборот КАК СуммаОборот,
		               |	CW_ДоходыПоГрузоперевозкамОбороты.НДСОборот КАК НДСОборот
		               |ПОМЕСТИТЬ ВТ_Обороты
		               |ИЗ
		               |	РегистрНакопления.CW_ДоходыПоГрузоперевозкам.Обороты(
		               |			,
		               |			,
		               |			Период,
		               |			ДокументДоходов В
		               |				(ВЫБРАТЬ
		               |					ВТ_Документы.СвязанныйДокумент КАК СвязанныйДокумент
		               |				ИЗ
		               |					ВТ_Документы КАК ВТ_Документы)) КАК CW_ДоходыПоГрузоперевозкамОбороты
		               |
		               |ИНДЕКСИРОВАТЬ ПО
		               |	ДокументДоходов
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ
		               |	ВТ_Документы.СвязанныйДокумент КАК СвязанныйДокумент,
		               |	СУММА(ВТ_Документы.СвязанныйДокумент.СуммаДокумента) КАК ВсегоВал,
		               |	СУММА(ВТ_Документы.СвязанныйДокумент.СуммаНДС) КАК НДСВал,
		               |	СУММА(ВТ_Документы.СвязанныйДокумент.СуммаДокумента - ВТ_Документы.СвязанныйДокумент.СуммаНДС) КАК СуммаВал,
		               |	СУММА(ЕСТЬNULL(ВТ_Обороты.ВсегоОборот, 0)) КАК Всего,
		               |	СУММА(ЕСТЬNULL(ВТ_Обороты.СуммаОборот, 0)) КАК Сумма,
		               |	СУММА(ЕСТЬNULL(ВТ_Обороты.НДСОборот, 0)) КАК НДС
		               |ИЗ
		               |	ВТ_Документы КАК ВТ_Документы
		               |		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Обороты КАК ВТ_Обороты
		               |		ПО ВТ_Документы.СвязанныйДокумент = ВТ_Обороты.ДокументДоходов
		               |
		               |СГРУППИРОВАТЬ ПО
		               |	ВТ_Документы.СвязанныйДокумент
		               |ИТОГИ
		               |	СУММА(ВсегоВал),
		               |	СУММА(НДСВал),
		               |	СУММА(СуммаВал),
		               |	СУММА(Всего),
		               |	СУММА(Сумма),
		               |	СУММА(НДС)
		               |ПО
		               |	ОБЩИЕ";
		
		Запрос.УстановитьПараметр("ОтчетЭкспедитора",  Объект.Ссылка);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаИтог = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Если ВыборкаИтог.Следующий() Тогда
			
			Итог_Перевыставлено_Сумма   = ?(Объект.ВалютаДокумента = ВалютаРегламентированногоУчета,ВыборкаИтог.СуммаВал	, ВыборкаИтог.Сумма) 	;
			Итог_Перевыставлено_НДС   	= ?(Объект.ВалютаДокумента = ВалютаРегламентированногоУчета,ВыборкаИтог.НДСВал		, ВыборкаИтог.НДС) 		;
			Итог_Перевыставлено_Всего  	= ?(Объект.ВалютаДокумента = ВалютаРегламентированногоУчета,ВыборкаИтог.ВсегоВал	, ВыборкаИтог.Всего) 	;
			
			Итог_Перевыставлено_СуммаВал  = ВыборкаИтог.СуммаВал;	
			Итог_Перевыставлено_НДСВал    = ВыборкаИтог.НДСВал;
			Итог_Перевыставлено_ВсегоВал  = ВыборкаИтог.ВсегоВал;
			
			
			Строка_ИтогоПеревытавленоРасходов = Строка_ИтогоПеревытавленоРасходов+Формат(Итог_Перевыставлено_Сумма,"ЧДЦ=2")+" "+СтрВалюта+ 
												?(Итог_Перевыставлено_НДС = 0,"", ", НДС: "+Формат(Итог_Перевыставлено_НДС,"ЧДЦ=2")+" "+СтрВалюта)+ 
												", Всего: "+ Формат(Итог_Перевыставлено_Всего,"ЧДЦ=2")+" "+СтрВалюта;

			Строка_ИтогоПеревытавленоРасходовВВалютеДоговора = 	Строка_ИтогоПеревытавленоРасходовВВалютеДоговора+Формат(Итог_Перевыставлено_СуммаВал,"ЧДЦ=2")+" "+СтрВалютаДоговора+ 
																?(Итог_Перевыставлено_НДСВал = 0,"", ", НДС: "+Формат(Итог_Перевыставлено_НДСВал,"ЧДЦ=2")+" "+СтрВалютаДоговора)+ 
																", Всего: "+ Формат(Итог_Перевыставлено_ВсегоВал,"ЧДЦ=2")+" "+СтрВалютаДоговора;
			
		Конецесли;
		
	КонецЕсли;
	
	если Итог_Получено_Всего <> Итог_Перевыставлено_Всего Тогда
		Элементы.ГруппаПеревыставлено.ЦветФона = ЦветаСтиля.СобытиеОтказ; 
	Иначе
		Элементы.ГруппаПеревыставлено.ЦветФона = Новый Цвет; 
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УслугиСуммаПриИзмененииНаСервере(ИдентификаторСтроки)
	
	СтрокаТаблицы = Объект.Услуги.НайтиПоИдентификатору(ИдентификаторСтроки);
	
	Ставка = CW_Финансы.ПолучитьСтавкуНДС(СтрокаТаблицы.СтавкаНДС);
	
	СтрокаТаблицы.Цена 		= _сф.БезопасноРазделить(СтрокаТаблицы.Сумма,СтрокаТаблицы.Количество);
	СтрокаТаблицы.СуммаНДС 	= CW_Финансы.РассчитатьСуммуНДС(СтрокаТаблицы.Сумма, Истина, Ложь, Ставка);
	СтрокаТаблицы.Всего		= СтрокаТаблицы.Сумма + СтрокаТаблицы.СуммаНДС;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьДанныеДляЗаполнения()
	
	МассивОбъектов 		= Новый Массив;
	
	//ГРУЗОПЕРЕВОЗКИ
	Если Объект.ПорядокЗаполнения = 0 Тогда
		//Выбрана однга грузоперевозка
		МассивОбъектов.Добавить(ЗначениеЗаполненияСсылка);
	ИначеЕсли Объект.ПорядокЗаполнения = 1 Тогда
		//Передан список грузоперевозок
		МассивОбъектов = ЗначениеЗаполненияСписок.ВыгрузитьЗначения();
	ИначеЕсли Объект.ПорядокЗаполнения = 2 ИЛИ Объект.ПорядокЗаполнения = 3 Тогда
		//ЗАКАЗЫ	
		МассивОбъектов = ПолучитьГрузоперевозкиИзЗаказов();
	ИначеЕсли Объект.ПорядокЗаполнения = 4 Тогда
		//Документы
		МассивОбъектов.Добавить(ЗначениеЗаполненияСсылка);
	ИначеЕсли Объект.ПорядокЗаполнения = 5 Тогда
		//Список документов
		МассивОбъектов = ЗначениеЗаполненияСписок.ВыгрузитьЗначения();
	КонецЕсли;
	
	Возврат МассивОбъектов;
	
КонецФункции

&НаСервере
Функция ПолучитьГрузоперевозкиИзЗаказов()
	
	Если Объект.ПорядокЗаполнения = 2 Тогда
		//Выбран один заказа
		МассивЗаказов = Новый Массив;
		МассивЗаказов.Добавить(ЗначениеЗаполненияСсылка);
		
	ИначеЕсли Объект.ПорядокЗаполнения = 3 Тогда
		//Передан список заказов
		МассивЗаказов =  ЗначениеЗаполненияСписок.ВыгрузитьЗначения();
		
	КонецЕсли;
	
	
	Запрос = новый запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	CW_Грузоперевозки.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.CW_Грузоперевозки КАК CW_Грузоперевозки
	|ГДЕ
	|	CW_Грузоперевозки.Заказ В(&МассивЗаказов)
	|	И НЕ CW_Грузоперевозки.ПометкаУдаления
	|
	|СГРУППИРОВАТЬ ПО
	|	CW_Грузоперевозки.Ссылка";
	
	запрос.УстановитьПараметр("МассивЗаказов", МассивЗаказов);	
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если Не РезультатЗапроса.Пустой() Тогда
		времТаблица = РезультатЗапроса.Выгрузить();
		Возврат времТаблица.ВыгрузитьКолонку("Ссылка");
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

&НаСервере
Процедура _ПодставитьПодписантов()
	
	Если (Объект.Организация.Пустая()) Тогда
		Возврат;
	КонецЕсли; 
	
	Объект.Руководитель 			= Неопределено;
	Объект.Руководитель_основание 	= "";
	
	Объект.ГлавныйБухгалтер 			= Неопределено;
	Объект.ГлавныйБухгалтер_основание 	= "";
	
	ДанныеПодписантовОрагнизации = _УФС.ПолучитьОтветственныхЛиц(Объект.Организация,Объект.ПодразделениеОрганизации);
	
	ДанныеРуководитель = ДанныеПодписантовОрагнизации.Получить(Перечисления.ОтветственныеЛицаОрганизаций.Руководитель);
	
	Если ДанныеРуководитель <> Неопределено Тогда
		
		ДанныеРуководитель.Свойство("УполномоченноеЛицо", Объект.Руководитель);
		ДанныеРуководитель.Свойство("НомерДатаПриказа"	, Объект.Руководитель_основание);
		
	КонецЕсли;
	
	ДанныеГлавныйБухгалтер = ДанныеПодписантовОрагнизации.Получить(Перечисления.ОтветственныеЛицаОрганизаций.ГлавныйБухгалтер);
	
	Если ДанныеГлавныйБухгалтер <> Неопределено Тогда
		
		ДанныеГлавныйБухгалтер.Свойство("УполномоченноеЛицо", Объект.ГлавныйБухгалтер);
		ДанныеГлавныйБухгалтер.Свойство("НомерДатаПриказа"	, Объект.ГлавныйБухгалтер_основание);
		
	КонецЕсли;


КонецПроцедуры

#КонецОбласти

#Область Подключаемые_внешние_команды

&НаКлиенте
Процедура ВнешняяКоманда_ВыполнитьКоманду(Команда)
	
	CW_ПодключаемыеКомандыКлиент.ВыполнитьВнешнююКоманду(ЭтотОбъект, Команда.Имя);
	
КонецПроцедуры

#КонецОбласти

#Область Документы_вознаграждения

&НаКлиенте
Процедура ДокументыВознагражденияПодбор(Команда)
	
	ОткрытьФОрмуПодбораДОкументовВознаграждения();
	
КонецПроцедуры

&НаКлиенте
Процедура ДокументыВознагражденияДокументНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ОткрытьФормуПодбораДОкументовВознаграждения(Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФОрмуПодбораДОкументовВознаграждения(Элемент = Неопределено)
	
	ВладелецФормы 		= Элемент;
	Если Элемент = Неопределено Тогда
		ВладелецФормы 		= Элементы.ДокументыВознаграждения;	
		ОписаниеОповещения 	= Новый ОписаниеОповещения("ПродолжитьВыборДокументов", ЭтотОбъект);
	КонецЕсли;
	
	СтруктураОтбора = Новый Структура;
	СтруктураОтбора.Вставить("Ссылка", ПолучитьДанныеВыбораНаСервере());
	
	ПараметрыФормыВыбора = Новый Структура;
	ПараметрыФормыВыбора.Вставить("Отбор", 					СтруктураОтбора);
	ПараметрыФормыВыбора.Вставить("МножественныйВыбор", 	Элемент = Неопределено);
	ПараметрыФормыВыбора.Вставить("РежимВыбора", 			Истина);
	ПараметрыФормыВыбора.Вставить("ПодборВознаграждения", 	Истина);
	
	ОткрытьФорму("Документ.CW_ДоходыПоГрузоперевозке.ФормаВыбора",ПараметрыФормыВыбора,ВладелецФормы,,,,ОписаниеОповещения,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ПродолжитьВыборДокументов(РезультатВыбора, Параметры) Экспорт

	Если РезультатВыбора <> Неопределено Тогда
		ЗаполнитьВыбранныеДокументыНаСервере(РезультатВыбора);
		ОбновитьЗаголовкиСтраниц();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьВыбранныеДокументыНаСервере(РезультатВыбора)
	
	ТабЧасть = Объект.ДокументыВознаграждения;
	
	Для Каждого ЭлементМасссива из РезультатВыбора Цикл
		
		Отбор = Новый Структура("Документ",ЭлементМасссива);
		мСтроки = ТабЧасть.НайтиСтроки(Отбор);
		
		Если мСтроки.Количество() = 0 Тогда
			НоваяСтрока = ТабЧасть.Добавить();
			НоваяСтрока.Документ = ЭлементМасссива;
			НоваяСтрока.СуммаДокумента = ЭлементМасссива.СуммаДокумента;
		КонецЕсли;
		
	КонецЦикла;
	
	
КонецПроцедуры

&НаСервере
Функция ПолучитьДанныеВыбораНаСервере()
	
	МассивГрузоперевозок = Объект.Услуги.Выгрузить().ВыгрузитьКолонку("Грузоперевозка");
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	CW_ДоходыПоГрузоперевозкеУслуги.Ссылка КАК Ссылка
	               |ИЗ
	               |	Документ.CW_ДоходыПоГрузоперевозке.Услуги КАК CW_ДоходыПоГрузоперевозкеУслуги
	               |ГДЕ
	               |	CW_ДоходыПоГрузоперевозкеУслуги.Ссылка.Контрагент = &Контрагент
	               |	И CW_ДоходыПоГрузоперевозкеУслуги.Ссылка.Договор = &Договор
				   //Подсистема.УчетПриложенийДоговоров
	               |	И CW_ДоходыПоГрузоперевозкеУслуги.Ссылка.ПриложениеКДоговору = &ПриложениеКДоговору
				   //Подсистема.УчетПриложенийДоговоров
	               |	И CW_ДоходыПоГрузоперевозкеУслуги.Ссылка.Организация = &Организация
	               |	И CW_ДоходыПоГрузоперевозкеУслуги.Ссылка.ФормируетсяАкт
	               |	И CW_ДоходыПоГрузоперевозкеУслуги.ПорядокОтражения = &ПорядокОтражения
	               |	И CW_ДоходыПоГрузоперевозкеУслуги.Грузоперевозка В(&МассивГрузоперевозок)";
	
	
	Запрос.УстановитьПараметр("Организация"				, Объект.Организация);
	Запрос.УстановитьПараметр("Контрагент"				, Объект.Контрагент);
	Запрос.УстановитьПараметр("Договор"					, Объект.Договор);
	
	//Подсистема.УчетПриложенийДоговоров
	Запрос.УстановитьПараметр("ПриложениеКДоговору"		, Объект.ПриложениеКДоговору);
	//Подсистема.УчетПриложенийДоговоров
	
	Запрос.УстановитьПараметр("МассивГрузоперевозок"	, МассивГрузоперевозок);
	Запрос.УстановитьПараметр("ПорядокОтражения"		, ПредопределенноеЗначение("Перечисление.CW_ПорядокОтраженияДоходов.СобственнаяУслуга"));
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("Ссылка");
	
КонецФункции

&НаКлиенте
Процедура ДокументыВознагражденияОчистить(Команда)
	
	Если Объект.ДокументыВознаграждения.Количество() > 0 Тогда
		
		Режим = РежимДиалогаВопрос.ДаНет;
		Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаОбОчисткеДокументовВознаграждения", ЭтаФорма, Параметры);
		ПоказатьВопрос(Оповещение, "Табличная часть документа будет очищена. Продолжить?", Режим, 0); 
		
	Иначе
		ОчиститьДокументыВознаграждения();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияВопросаОбОчисткеДокументовВознаграждения(Результат, Параметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;
	
	ОчиститьДокументыВознаграждения();
	
