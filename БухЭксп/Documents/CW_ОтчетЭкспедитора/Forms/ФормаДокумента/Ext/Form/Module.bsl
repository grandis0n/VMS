&НаКлиенте
Процедура ЗадатьВопросОбИзмененииСтатусовСвязанныхДокументов()
	
	ВсегоСвязанныхДокументов = ПолучитьКоличествоСвязанныхДокументов(Объект.Ссылка);
	
	Если ЗадатьВопросПриИзмененииСтатуса и 
		(ВсегоСвязанныхДокументов > 0 или Объект.ДокументыВознаграждения.Количество() > 0) Тогда
		
		Режим = РежимДиалогаВопрос.ДаНет;
		Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаОбИзмененииСтатуса", ЭтотОбъект, Параметры);
		ПоказатьВопрос(Оповещение, "Изменить статус подчиненных документов?", Режим, 0);	
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияВопросаОбИзмененииСтатуса(Результат, Параметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Нет Тогда
        Возврат;
    КонецЕсли;

    ПродолжитьУстановкуСтатусовСвязанныхДокументов();
	

КонецПроцедуры

&НаКлиенте
Процедура ПродолжитьУстановкуСтатусовСвязанныхДокументов()

	РезультатВыполнения =  ПродолжитьУстановкуСтатусовСвязанныхДокументовНаСервереВФоне();
	
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ВыводитьОкноОжидания = Истина;
	ОповещениеОЗавершении = Новый ОписаниеОповещения("ОбработатьРезультатУстановкуСтатусовСвязанныхДокументов", ЭтотОбъект);
	
	ДлительныеОперацииКлиент.ОжидатьЗавершение(РезультатВыполнения, ОповещениеОЗавершении, ПараметрыОжидания);

КонецПроцедуры

Функция ПродолжитьУстановкуСтатусовСвязанныхДокументовНаСервереВФоне()
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(Новый УникальныйИдентификатор);
	ПараметрыВыполнения.ОжидатьЗавершение 			= 0; // запускать сразу
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = "Установка статуса связанных документов (Отчет экспедитора)";
	ПараметрыВыполнения.ЗапуститьВФоне 				= Истина;
	ПараметрыВыполнения.ЗапуститьНеВФоне 			= ложь;
	
	СтруктураСвязанныеДокументы = Документы.CW_ОтчетЭкспедитора.ПолучитьСвязанныеДоходыПоГрузопереовзкам(Объект.Ссылка);
	мДокументыВознаграждения 	= Объект.ДокументыВознаграждения.Выгрузить().ВыгрузитьКолонку("Документ");
	
	мВсеДокументы = СтруктураСвязанныеДокументы.ВсеДокументы;
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(мВсеДокументы, мДокументыВознаграждения, Истина);
	
	ПараметрыПроцедуры = Новый Структура;
	ПараметрыПроцедуры.Вставить("ВсеДокументы", мВсеДокументы);
	ПараметрыПроцедуры.Вставить("УстанавливаемыйСтатус", СтатусДокумента);
	
	Возврат ДлительныеОперации.ВыполнитьВФоне("Документы.CW_ОтчетЭкспедитора.УстановитьСтатусСвязанныхДокументов",ПараметрыПроцедуры, ПараметрыВыполнения);

КонецФункции

&НаКлиенте
Процедура ОбработатьРезультатУстановкуСтатусовСвязанныхДокументов(РезультатВыполнения, ДополнительныеПараметры) Экспорт
	
	Если РезультатВыполнения.Статус = "Выполнено" Тогда
		
		ЗаполнитьИтогиПоОтчетуНаСервере(Истина);
		ОбновитьЗаголовкиСтраниц(Истина);	
		УстановитьДоступностьЭлементовФормы();
		
		МассивДокументов = ПолучитьИзВременногоХранилища(РезультатВыполнения.АдресРезультата); 
		
		Если  МассивДокументов.Количество() > 0 Тогда
			ОповеститьОбИзменении(МассивДокументов[0]);
		КонецЕсли;
		
		ТексСообщения = СтрСоединить(МассивДокументов,Символы.ПС);
		
		ПоказатьОповещениеПользователя("Изменен статус ("+Формат(МассивДокументов.Количество(),"ЧГ=0")+"):",,ТексСообщения,,СтатусОповещенияПользователя.Информация);
		
	ИначеЕсли РезультатВыполнения.Статус = "Ошибка" Тогда
		
		ТекстПредупреждения = "Не удалось отсоединить документы!
		| По причине: "+ РезультатВыполнения.КраткоеПредставлениеОшибки + "
		| Информаиция об ошибке см. в журнале регистрации!";
		
		ПоказатьПредупреждение(,ТекстПредупреждения);
	КонецЕсли;
	
КонецПроцедуры

