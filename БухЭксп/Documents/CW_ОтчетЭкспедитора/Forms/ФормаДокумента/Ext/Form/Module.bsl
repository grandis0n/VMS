&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	Если ИспользоватьДопРеквизиты Тогда
		// СтандартныеПодсистемы.Свойства
		УправлениеСвойствами.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
		// Конец СтандартныеПодсистемы.Свойства
	КонецЕсли;
	
	//ДатыЗапретаИзменения
	//Проверяем дату запрета по документам БУ
	мОбъектыПроверки = ПолучитьМассивОбъектовДляПроверки();
	Для Каждого ЭлементМассива из мОбъектыПроверки Цикл
		//Есть ведомые документы, проверяем дату запрета редактирования БП
		ОбъектМассива = ЭлементМассива.ПолучитьОбъект();
		Разрешено = ДатыЗапретаИзменения.ОбъектПриЧтенииНаСервере(ЭтотОбъект, ОбъектМассива);
		Если не Разрешено Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	//ДатыЗапретаИзменения

КонецПроцедуры

&НаСервере
Функция ПолучитьМассивОбъектовДляПроверки()
	
	Результат = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	CW_ДокументыОтчетаЭкспедитора.СвязанныйДокумент КАК СвязанныйДокумент
	               |ИЗ
	               |	РегистрСведений.CW_ДокументыОтчетаЭкспедитора КАК CW_ДокументыОтчетаЭкспедитора
	               |ГДЕ
	               |	CW_ДокументыОтчетаЭкспедитора.ОтчетЭкспедитора = &ОтчетЭкспедитора
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	CW_ОтчетЭкспедитораДокументыВознаграждения.Документ
	               |ИЗ
	               |	Документ.CW_ОтчетЭкспедитора.ДокументыВознаграждения КАК CW_ОтчетЭкспедитораДокументыВознаграждения
	               |ГДЕ
	               |	CW_ОтчетЭкспедитораДокументыВознаграждения.Ссылка = &ОтчетЭкспедитора";
	
	Запрос.УстановитьПараметр("ОтчетЭкспедитора", Объект.Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		Если ЗначениеЗаполнено(Выборка.СвязанныйДокумент.ВедомыйДокумент) 
			и Результат.Найти(Выборка.СвязанныйДокумент.ВедомыйДокумент) = Неопределено   Тогда
			Результат.Добавить(Выборка.СвязанныйДокумент.ВедомыйДокумент);
		КонецЕсли;
		Если ЗначениеЗаполнено(Выборка.СвязанныйДокумент.ВедомыйСчетФактура) 
			и Результат.Найти(Выборка.СвязанныйДокумент.ВедомыйСчетФактура) = Неопределено   Тогда
			Результат.Добавить(Выборка.СвязанныйДокумент.ВедомыйСчетФактура);
		КонецЕсли;
		Если ЗначениеЗаполнено(Выборка.СвязанныйДокумент.ВедомыйСчет) 
			и Результат.Найти(Выборка.СвязанныйДокумент.ВедомыйСчет) = Неопределено   Тогда
			Результат.Добавить(Выборка.СвязанныйДокумент.ВедомыйСчет);
		КонецЕсли;
		Если ЗначениеЗаполнено(Выборка.СвязанныйДокумент.ВедомыйДокументКорректировки) 
			и Результат.Найти(Выборка.СвязанныйДокумент.ВедомыйДокументКорректировки) = Неопределено   Тогда
			Результат.Добавить(Выборка.СвязанныйДокумент.ВедомыйДокументКорректировки);
		КонецЕсли;
		Если ЗначениеЗаполнено(Выборка.СвязанныйДокумент.ВедомыйСчетФактураКорректировочный) 
			и Результат.Найти(Выборка.СвязанныйДокумент.ВедомыйСчетФактураКорректировочный) = Неопределено   Тогда
			Результат.Добавить(Выборка.СвязанныйДокумент.ВедомыйСчетФактураКорректировочный);
		КонецЕсли;
		Если ЗначениеЗаполнено(Выборка.СвязанныйДокумент.ВедомыйСчетКорректировочный) 
			и Результат.Найти(Выборка.СвязанныйДокумент.ВедомыйСчетКорректировочный) = Неопределено   Тогда
			Результат.Добавить(Выборка.СвязанныйДокумент.ВедомыйСчетКорректировочный);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат; 
	
КонецФункции

