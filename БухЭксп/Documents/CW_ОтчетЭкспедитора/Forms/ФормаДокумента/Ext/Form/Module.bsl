&НаСервере
Процедура ПорядокПеревыставленияПриИзмененииНаСервере()
	
	Если Объект.ПорядокПеревыставления = 0 Тогда
		Если Объект.ДатаПеревставления <> 0 Тогда
			Объект.ДатаПеревставления = 0;
		КонецЕсли;
	КонецЕсли;
	
	Если Объект.КоличествоДней = 0 И  Объект.ПорядокПеревыставления =  3 Тогда
		Объект.КоличествоДней = 5;
		ОбновитьЗаголовокНадписиКоличествоДней();
	КонецЕсли;
	
	УстановитьВидимостьЭлементовФормы();	
	
