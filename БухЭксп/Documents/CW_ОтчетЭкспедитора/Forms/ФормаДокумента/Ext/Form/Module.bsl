#КонецОбласти

#Область Обработчики_команд_формы_НаКлиенте

&НаКлиенте
Процедура Заполнить(Команда)
	
	Отказ = Ложь;
	
	ПроверитьЗаполнениеОбъектовОстатков(Отказ);
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	Если Объект.Услуги.Количество() > 0 Тогда
		
		Режим = РежимДиалогаВопрос.ДаНет;
		Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопроса", ЭтаФорма, Параметры);
		ПоказатьВопрос(Оповещение, НСтр("ru = 'Табличная часть документа будет очищена. Продолжить?';"
		+ " en = 'The document is cleared. Do you want to continue?'"), Режим, 0); 
		
	Иначе     
		
		РезультатВыполнения =  ЗаполнитьНаСервереВФоне();
		
		Если РезультатВыполнения <> Неопределено Тогда
			
			ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
			ПараметрыОжидания.ВыводитьОкноОжидания = Истина;
			ОповещениеОЗавершении = Новый ОписаниеОповещения("ОбработатьРезультатЗаполнения", ЭтотОбъект);
			
			ДлительныеОперацииКлиент.ОжидатьЗавершение(РезультатВыполнения, ОповещениеОЗавершении, ПараметрыОжидания);
			
		Иначе
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось получить данные для заполнения документа!");
			
		конецЕсли;
		
	КонецЕсли;
	
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьЗаполнениеОбъектовОстатков(Отказ)
	
	Если Объект.ПорядокЗаполнения = 0 или Объект.ПорядокЗаполнения = 2 или Объект.ПорядокЗаполнения = 4 Тогда
		Если Не ЗначениеЗаполнено(ЗначениеЗаполненияСсылка) Тогда
			
			Если Объект.ПорядокЗаполнения = 0 Тогда
				ТекстПредупрежедения = "Не выбрана грузоперевозка";
			ИначеЕсли Объект.ПорядокЗаполнения = 2 Тогда 
				ТекстПредупрежедения = "Не выбран заказ";
			ИначеЕсли Объект.ПорядокЗаполнения = 3 Тогда 
				ТекстПредупрежедения = "Не выбран документ затрат";
			КонецЕсли;
			
			ПоказатьПредупреждение(,ТекстПредупрежедения);
			Отказ = истина;
			
		КонецЕсли;
	КонецЕсли;
	
	Если Объект.ПорядокЗаполнения = 1 или Объект.ПорядокЗаполнения = 3 или Объект.ПорядокЗаполнения = 5 тогда
		
		Если ЗначениеЗаполненияСписок.Количество() = 0 Тогда
			
			Если Объект.ПорядокЗаполнения = 0 Тогда
				ТекстПредупрежедения = "Не выбрана ни одна грузоперевозка";
			ИначеЕсли Объект.ПорядокЗаполнения = 2 Тогда 
				ТекстПредупрежедения = "Не выбран ни один заказ";
			ИначеЕсли Объект.ПорядокЗаполнения = 3 Тогда 
				ТекстПредупрежедения = "Не выбран ни оди документ затрат";
			КонецЕсли;
			
			ПоказатьПредупреждение(,ТекстПредупрежедения);
			
			Отказ = истина;
			
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияВопроса(Результат, Параметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;
	
	РезультатВыполнения =  ЗаполнитьНаСервереВФоне();
	
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ВыводитьОкноОжидания = Истина;
	ОповещениеОЗавершении = Новый ОписаниеОповещения("ОбработатьРезультатЗаполнения", ЭтотОбъект);
	
	ДлительныеОперацииКлиент.ОжидатьЗавершение(РезультатВыполнения, ОповещениеОЗавершении, ПараметрыОжидания);
	
КонецПроцедуры

&НаСервере
Функция ЗаполнитьНаСервереВФоне()
	
	МассивОбъектов = ПолучитьДанныеДляЗаполнения();
	Если МассивОбъектов.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(Новый УникальныйИдентификатор);
	ПараметрыВыполнения.ОжидатьЗавершение 			= 0; // запускать сразу
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = "Запонение табличной части услуги (Отчет экспедитора)";
	ПараметрыВыполнения.ЗапуститьВФоне 				= Истина;
	ПараметрыВыполнения.ЗапуститьНеВФоне 			= ложь;
	
	ОтборПоГрузоперевозкам = ТипЗнч(МассивОбъектов[0]) = Тип("СправочникСсылка.CW_Грузоперевозки");
		
	ПараметрыПроцедуры = Новый Структура;
	ПараметрыПроцедуры.Вставить("Объект", Объект.Ссылка);
	ПараметрыПроцедуры.Вставить("Дата", Объект.Дата);
	ПараметрыПроцедуры.Вставить("Организация", Объект.Организация);
	ПараметрыПроцедуры.Вставить("Контрагент", Объект.Контрагент);
	ПараметрыПроцедуры.Вставить("Договор", Объект.Договор);
	
	//Подсистема.УчетПриложенийДоговоров
	ПараметрыПроцедуры.Вставить("ПриложениеКДоговору", Объект.ПриложениеКДоговору);
	//Подсистема.УчетПриложенийДоговоров
	
	ПараметрыПроцедуры.Вставить("ВестиУчетПоПодразделениям", 	ВестиУчетПоПодразделениям);
	ПараметрыПроцедуры.Вставить("ПодразделениеОрганизации", 	Объект.ПодразделениеОрганизации);
	ПараметрыПроцедуры.Вставить("МассивОбъектов", 				МассивОбъектов);
	ПараметрыПроцедуры.Вставить("ОтборПоГрузоперевозкам", 		ОтборПоГрузоперевозкам);
	
	Возврат ДлительныеОперации.ВыполнитьВФоне("Документы.CW_ОтчетЭкспедитора.ЗаполнитьТабличнуюЧастьУслуги",ПараметрыПроцедуры, ПараметрыВыполнения);
	
КонецФункции

&НаКлиенте
Процедура ОбработатьРезультатЗаполнения(РезультатВыполнения, Дополнительныепараметры) Экспорт
	
	Если РезультатВыполнения.Статус = "Выполнено" Тогда
		
		ОбработатьРезультатВыполненияНаСервере(РезультатВыполнения.АдресРезультата);
		УстановитьДоступностьЭлементовФормы();	
		
		ПоказатьОповещениеПользователя("Заполнение таблицы услуг",,Объект.Ссылка,,СтатусОповещенияПользователя.Информация);
		
	ИначеЕсли РезультатВыполнения.Статус = "Ошибка" Тогда
		
		ТекстПредупреждения = "Табличная часть не заполнена!
		| По причине: "+ РезультатВыполнения.КраткоеПредставлениеОшибки + "
		| Информаиция об ошибке см. в журнале регистрации!";
		
		ПоказатьПредупреждение(,ТекстПредупреждения,,"Ошибка заполнения табличной части");
	КонецЕсли;
	
КонецПроцедуры

