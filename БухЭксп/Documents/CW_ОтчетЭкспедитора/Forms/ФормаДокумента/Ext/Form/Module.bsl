&НаСервере
Процедура СформироватьКурсВалюты()
	
	
	Если  Не ЗначениеЗаполнено(Объект.Договор.ВалютаДоговора) Тогда
		Возврат;
	КонецЕсли;                               
	
	//Подсистема.УчетПриложенийДоговоров
	Объект.ВалютаДокумента = CW_УчетПриложенийДоговоровСервер.ПолучитьВалютуПриложенияДоговора(Объект.ПриложениеКДоговору, Объект.Договор);
	//Подсистема.УчетПриложенийДоговоров
	
	СтруктураКурса 			= CW_Финансы.ПолучитьКурсВалюты(Объект.ВалютаДокумента, ?(ЗначениеЗаполнено(Объект.Дата), Объект.Дата, ТекущаяДата()));
	
	Элементы.Надпись_ВалютаКурс.Заголовок = Строка(Объект.ВалютаДокумента)+" = "+Формат(СтруктураКурса.Курс,"ЧЦ=15; ЧДЦ=4; ЧГ=");
	
	Элементы.ГруппаДокументыперевыставленоВВалюте.Видимость = Не Объект.ВалютаДокумента = ВалютаРегламентированногоУчета;
	
	
КонецПроцедуры

