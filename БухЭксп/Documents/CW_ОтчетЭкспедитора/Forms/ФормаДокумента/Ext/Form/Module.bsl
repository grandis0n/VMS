
#Область События_формы_НаСервере

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ИспользуютсяЗаказы 			   						= ПолучитьФункциональнуюОпцию("CW_ИспользованиеЗаказов");
	ОбратныйПересчетВДокументах    						= CW_Настройки.ПолучитьНастройкуПользователя(,"ОбратныйПересчетВДокументах");
	ПодставлятьУполномоченныхЛицПриСозданииДокументов  	= CW_Настройки.ПолучитьНастройкуПользователя(,"ПодставлятьУполномоченныхЛицПриСозданииДокументов");
	
	ВалютаРегламентированногоУчета 						= Константы.ВалютаРегламентированногоУчета.Получить();
	
	//Для версии КОРП
	ВестиУчетПоПодразделениям					= ПолучитьФункциональнуюОпцию("ВестиУчетПоПодразделениям");
	Элементы.ПодразделениеОрганизации.Видимость	= ВестиУчетПоПодразделениям;
	//Для версии КОРП
	
	//Подсистема.СтатусыДокументов
	CW_СтатусыДокументовСервер.ПриСозданииНаСервере(ЭтаФорма, Отказ, СтандартнаяОбработка);
	
	Элементы.СвязанныеДокументыСтатусДокумента.Видимость = Справочники.CW_НазначенияСтатусов.ОбъектИспользуетсяВСистемеСтатусов(Тип("ДокументСсылка.CW_ДоходыПоГрузоперевозке"));
	
	НазначениеСтатусов 				= Справочники.CW_НазначенияСтатусов.ПолучитьНазначениеСтатусовПоТипуОбъекрта(Тип("ДокументСсылка.CW_ОтчетЭкспедитора"));
	ЗадатьВопросПриИзмененииСтатуса = Справочники.CW_НазначенияСтатусов.СодержитТипОбъекта(НазначениеСтатусов, Тип("ДокументСсылка.CW_ДоходыПоГрузоперевозке"));
	//Подсистема.СтатусыДокументов
	
	//Заполнение списка порядка заполнения
	Элементы.ПорядокЗаполнения.СписокВыбора.Добавить(0,"Грузоперевозка",,БиблиотекаКартинок.CW_Грузоперевозки);
	Элементы.ПорядокЗаполнения.СписокВыбора.Добавить(1,"Список грузоперевозок",,БиблиотекаКартинок.CW_ГрузоперевозкиСписок);
	
	Если ИспользуютсяЗаказы Тогда
		Элементы.ПорядокЗаполнения.СписокВыбора.Добавить(2,"Заказ",,БиблиотекаКартинок.CW_Коробка);
		Элементы.ПорядокЗаполнения.СписокВыбора.Добавить(3,"Список заказов",,БиблиотекаКартинок.CW_Меню2);
	КонецЕсли;
	
	Элементы.ПорядокЗаполнения.СписокВыбора.Добавить(4,"Документ затрат",,БиблиотекаКартинок.CW_РасходыПоГрузоперевозке);
	Элементы.ПорядокЗаполнения.СписокВыбора.Добавить(5,"Список документов затрат",,БиблиотекаКартинок.CW_ВидыДокументов);
	//Заполнение списка порядка заполнения
	
	ЭтоНовый = Параметры.Ключ.Пустая(); 
	
	Если ЭтоНовый Тогда
		Объект.ПорядокПроведенияДокументов 	= 1;
		
		Если Не ЗначениеЗаполнено(Объект.Дата) Тогда
			Объект.Дата 						= ТекущаяДата();
		КонецЕсли;
		Объект.КоличествоДней 				= 5;
		
		Если ВестиУчетПоПодразделениям и Не ЗначениеЗаполнено(Объект.ПодразделениеОрганизации) Тогда
			Объект.ПодразделениеОрганизации 	= CW_Настройки.ПолучитьНастройкуПользователя(CW_Настройки.Пользователь(),"ПодразделениеПользователя");
		КонецЕсли;
		
	КонецЕсли;
	
	Если ЭтоАдресВременногоХранилища(Объект.АдресЗначенияОтбораПриКопировании) Тогда
		//Сюда попадаем только в случае копирвоани!
		ЗначениеОтбора 							 	= ПолучитьИзВременногоХранилища(Объект.АдресЗначенияОтбораПриКопировании);
		Объект.АдресЗначенияОтбораПриКопировании 	= "";
	Иначе
		тОбъект 		= РеквизитФормыВЗначение("Объект");
		ЗначениеОтбора 	= тОбъект.ЗначениеОтбора.Получить();
	КонецЕсли;
	
	Если Параметры.ЗначенияЗаполнения.Свойство("ВводНаОсновании") Тогда
		ЗначениеОтбора 			= Параметры.ЗначенияЗаполнения.ДокументОснование;
	КонецЕсли;  
	
	Если Параметры.ЗначенияЗаполнения.Свойство("ЗначениеОтбора") Тогда
		ЗначениеОтбора 			= Параметры.ЗначенияЗаполнения.ЗначениеОтбора;
	КонецЕсли;  
	
	Если ЗначениеЗаполнено(ЗначениеОтбора) Тогда
		АдресЗначенияОтбора = ПоместитьВоВременноеХранилище(ЗначениеОтбора, ЭтаФорма.УникальныйИдентификатор);
	КонецЕсли;
	
	УстановитьВидимостьЭлементовФормы();	
	СчетНаПредоплатуПриИзмененииНаСервере();
	УстановитьВидимостьИТипЗначенияЗаполнения();
	
	УстановитьОтборДинамическогоСписка();
	
	СформироватьКурсВалюты();
	
	ЗаполнитьИтогиПоОтчетуНаСервере(Истина);
	
	СостояниеДокумента = ПолучитьСостояниеДокумента(); 
	
	Если ЗначениеЗаполнено(Объект.Договор) Тогда
		СтруктураПараметровДоговора = ПолучитьСтруктуруПараметровДоговораКлиента();
		ВводНаОснованииДоступен = СтруктураПараметровДоговора.АвтоматическийРасчетВознаграждения и СтруктураПараметровДоговора.МоментАвтоматическогоВыставленияВознаграждения = Перечисления.CW_МоментАвтоматическогоВыставленияВознаграждения.ОтдельнымДокументом; 
	    УстановитьВидимостьВводаНаОсновании(ВводНаОснованииДоступен);
	КонецЕсли;

	ОбновитьЗаголовокНадписиКоличествоДней();
	
	//Подсистема.УчетПриложенийДоговоров
	CW_УчетПриложенийДоговоровСервер.ПриСозданииНаСервере(ЭтаФорма, Отказ, СтандартнаяОбработка);
	//Подсистема.УчетПриложенийДоговоров
	
	//Подсистема.ДополнительныеРеквизиты
	ИспользоватьДопРеквизиты = CW_ДополнительныеРеквизитыСлужебный.ИспользуютсяДополниительныеРеквизиты();
	//Подсистема.ДополнительныеРеквизиты
	
	// СтандартныеПодсистемы.Свойства
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ИмяЭлементаДляРазмещения", "ГруппаДополнительныеРеквизиты");
	ДополнительныеПараметры.Вставить("ПроизвольныйОбъект", НЕ ИспользоватьДопРеквизиты); 
	УправлениеСвойствами.ПриСозданииНаСервере(ЭтотОбъект, ДополнительныеПараметры);
	// Конец СтандартныеПодсистемы.Свойства

	//Внешние подклчюаемые команды
	CW_ПодключаемыеКомандыСервер.ПриСозданииНаСервере(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ОбновитьЗаголовкиСтраниц(Истина);	
	УстановитьДоступностьЭлементовФормы();
	
	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствамиКлиент.ПослеЗагрузкиДополнительныхРеквизитов(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.Свойства

КонецПроцедуры

&НаСервере
Процедура ОбновитьЗаголовокНадписиКоличествоДней()
	
	ФормСтрока = "Л = ru_RU; ДП = Ложь; НП = Истина; НД = Истина";
	ПарПредмета="день,дня,дней,м";
	
	УбираемыеСимволы = ЧислоПрописью(Объект.КоличествоДней, "Л = ru_RU; ДП = Ложь; НП = Ложь; НД = Ложь", "день,дня,дней,м"); //Два 00
	УбираемыеСимволы = СокрЛП(СтрЗаменить(УбираемыеСимволы, "00","")); //Два
	
	Предмет = ЧислоПрописью(Объект.КоличествоДней, "Л = ru_RU; ДП = Ложь; НП = Истина; НД = Ложь", "день,дня,дней,м"); //Два дня 00
	Предмет = СокрЛП(СтрЗаменить(Предмет, "00","")); //Два дня
	Предмет = СокрЛП(СтрЗаменить(Предмет, УбираемыеСимволы,"")); //дня
	
	Элементы.КоличествоДнейИнтервала.Заголовок = Формат(Объект.КоличествоДней, "ЧДЦ=0; ЧГ=0")+ " "+ Предмет;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьВводаНаОсновании(Флаг)
	
	Элементы.ФормаДокументCW_ДоходыПоГрузоперевозкеСоздатьНаОсновании.Видимость = Флаг;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьОтборДинамическогоСписка()
	
	СвязанныеДокументы.Отбор.Элементы.Очистить();
	
	ЭлементОтбора = СвязанныеДокументы.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.Использование = Истина;
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ОтчетЭкспедитрора");
	ЭлементОтбора.ВидСравнения  = ВидСравненияКомпоновкиДанных.Равно;
	ЭлементОтбора.ПравоеЗначение = ?(Объект.Ссылка.Пустая(), Неопределено, Объект.Ссылка);
	
	Если ЗначениеЗаполнено(Объект.СчетНаПредоплату_Значение) Тогда
		ЭлементОтбора = СвязанныеДокументы.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.Использование  = Истина;
		ЭлементОтбора.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("СвязанныйДокумент");
		ЭлементОтбора.ВидСравнения   = ВидСравненияКомпоновкиДанных.НеРавно;
		ЭлементОтбора.ПравоеЗначение = ?(Объект.Ссылка.Пустая(), Неопределено, Объект.СчетНаПредоплату_Значение);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	СостояниеДокумента = ПолучитьСостояниеДокумента(); 
	
	Если Объект.СчетНаПредоплату = 0 
		и ЗначениеЗаполнено(Объект.СчетНаПредоплату_Значение) Тогда
		КлючЗаписи = Новый Структура("ОтчетЭкспедитора,СвязанныйДокумент", Объект.Ссылка, Объект.СчетНаПредоплату_Значение);
		Документы.CW_ОтчетЭкспедитора.ЗаписатьДокументВРегистр(КлючЗаписи);                          
	КонецЕсли;   
	
	УстановитьОтборДинамическогоСписка();
	
	//Подсистема.СтатусыДокументов
	CW_СтатусыДокументовСервер.ПослеЗаписиНаСервере(ЭтаФорма, ТекущийОбъект, ПараметрыЗаписи);
	//Подсистема.СтатусыДокументов
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)

	CW_Документы.ПередЗаписьюНаСервере(ЭтотОбъект, Отказ);
	
	//Подсистема.СтатусыДокументов
	CW_СтатусыДокументовСервер.ПередЗаписьюНаСервере(ЭтаФорма, Отказ, ТекущийОбъект, ПараметрыЗаписи);
	//Подсистема.СтатусыДокументов
	
	Если Объект.ПорядокЗаполнения = 0 или Объект.ПорядокЗаполнения = 2 или Объект.ПорядокЗаполнения = 4 Тогда
		
		ТекущийОбъект.ЗначениеОтбора 		= Новый ХранилищеЗначения(ЗначениеЗаполненияСсылка);	
		ТекущийОбъект.СписокЗначениеОтбора 	= СокрЛП(ЗначениеЗаполненияСсылка);
		
	ИначеЕсли Объект.ПорядокЗаполнения = 1 или Объект.ПорядокЗаполнения = 3   или Объект.ПорядокЗаполнения = 5 тогда
		
		МассивЗначенийОтбора 				= ЗначениеЗаполненияСписок.ВыгрузитьЗначения();
		ТекущийОбъект.ЗначениеОтбора 		= Новый ХранилищеЗначения(МассивЗначенийОтбора);	
		ТекущийОбъект.СписокЗначениеОтбора 	= СтрСоединить(МассивЗначенийОтбора,";");
		
	КонецЕсли;	 
	
	Отбор 	= новый Структура("ЕстьСчетФактура",Истина);
	мСтроки = ТекущийОбъект.Услуги.НайтиСтроки(Отбор);
	
	ТекущийОбъект.ФормируютсясчетаФактуры = мСтроки.Количество() > 0;
	
	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствами.ПередЗаписьюНаСервере(ЭтотОбъект, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.Свойства
	
КонецПроцедуры

&НаСервере
Процедура ОрагнизацияПриИзмененииНаСервере()
	
	Если ПодставлятьУполномоченныхЛицПриСозданииДокументов И Объект.Ссылка.Пустая() Тогда
		_ПодставитьПодписантов();
	КонецЕсли;
	
	Если Объект.Организация <> Объект.Ссылка.Организация Тогда
		Объект.Номер = "";
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОрагнизацияПриИзменении(Элемент)
	ОрагнизацияПриИзмененииНаСервере();
КонецПроцедуры



#КонецОбласти

#Область События_формы_НаКлиенте

&НаКлиенте
Процедура УслугиПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	
	ОбновитьЗаголовкиСтраниц();
	ЗаполнитьИтогиПоОтчетуНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура УслугиПослеУдаления(Элемент)
	
	ОбновитьЗаголовкиСтраниц();
	ЗаполнитьИтогиПоОтчетуНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ПорядокЗаполненияПриИзменении(Элемент)
	ПорядокЗаполненияПриИзмененииНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ДоговорПриИзменении(Элемент)
	
	ОбработатьИзменениеДоговораНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура УслугиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.Услуги.ТекущиеДанные;
	
	Если Поле.Имя = "УслугиГрузопереовзка" Тогда
		 ПоказатьЗначение(,ТекущиеДанные.Грузоперевозка);
	ИначЕесли Поле.Имя = "УслугиЗаказ" Тогда
		 ПоказатьЗначение(,ТекущиеДанные.Заказ);
	ИначЕесли Поле.Имя = "УслугиКонтрагент" Тогда
		 ПоказатьЗначение(,ТекущиеДанные.Контрагент);
	ИначЕесли Поле.Имя = "УслугиДокументЗатрат" Тогда
		 ПоказатьЗначение(,ТекущиеДанные.ДокументРасходов);
	ИначЕесли Поле.Имя = "УслугиЕстьСчетФактура" Тогда
		Если ТекущиеДанные.ЕстьСчетФактура Тогда
			ПоказатьЗначение(,ПолучитьСчетФактуру(ТекущиеДанные.ДокументРасходов));
		Иначе
			ПоказатьЗначение(,ТекущиеДанные.ДокументРасходов);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Подписанты_Обновить(Команда)
	
	Если ПодставлятьУполномоченныхЛицПриСозданииДокументов Тогда
		_ПодставитьПодписантов();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область Обработка_событий_формы_На_Сервере

&НаСервере
Процедура ОбработатьИзменениеДоговораНаСервере()
	
	СтруктураПараметровДоговора		= ПолучитьСтруктуруПараметровДоговораКлиента();
	ВводНаОснованииДоступен 		= СтруктураПараметровДоговора.АвтоматическийРасчетВознаграждения и СтруктураПараметровДоговора.МоментАвтоматическогоВыставленияВознаграждения = Перечисления.CW_МоментАвтоматическогоВыставленияВознаграждения.ОтдельнымДокументом; 
	
	Если ЭтоНовый Тогда
		
		ЗаполнитьЗначенияСвойств(Объект, СтруктураПараметровДоговора, "ПорядокЗаполнения,ПорядокПеревыставления,СчетНаПредоплату,ДатаПеревставления");
		
		ПорядокПеревыставленияПриИзмененииНаСервере();
		СчетНаПредоплатуПриИзмененииНаСервере();
		УстановитьВидимостьИТипЗначенияЗаполнения();
		
	КонецЕсли;
	
	УстановитьВидимостьВводаНаОсновании(ВводНаОснованииДоступен);
	
	//Подсистема.УчетПриложенийДоговоров
	CW_УчетПриложенийДоговоровСервер.ПриИзмененииДоговораНаСервере(ЭтаФорма);
	//Подсистема.УчетПриложенийДоговоров
	
	СформироватьКурсВалюты();
	
КонецПроцедуры


&НаКлиенте
Процедура УстановитьДоступностьЭлементовФормы()
	
	ТолькоПросмотрШапки = Объект.Услуги.Количество() <> 0;
	
КонецПроцедуры

&НаСервере
Функция ПроверитьВозможностьФормированияДрокументов()
	
	Отказ = Ложь;
	
	Если Объект.ПорядокПеревыставления = 3 и Объект.КоличествоДней = 0 Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст 		= "Не указано количество дней для группировки документов!";
		Сообщение.Поле  		= "ПорядокПеревыставления";
		Сообщение.ПутьКДанным	= "Объект";
		Сообщение.Сообщить();
		
		Отказ = истина;
	КонецЕсли;
	
	Если Объект.СчетНаПредоплату = 0 и Не ЗначениеЗаполнено(Объект.СчетНаПредоплату_Значение) Тогда
		
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст 		= "Не выбрн счет предоплаты клиента!";
		Сообщение.Поле  		= "СчетНаПредоплату_Значение";
		Сообщение.ПутьКДанным	= "Объект";
		Сообщение.Сообщить();
		
		Отказ = истина;
		
	КонецЕсли;  
	
	Если Объект.СчетНаПредоплату = 0 
		и НЕ (Объект.СчетНаПредоплату_Значение.ФормируетсяСчет и НЕ Объект.СчетНаПредоплату_Значение.ФормируетсяАкт) Тогда
		
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст 		= "Документ, указанный в качестве счета на предоплату, не может быть актом. Формирование документов не возможно!";
		Сообщение.Поле  		= "СчетНаПредоплату_Значение";
		Сообщение.ПутьКДанным	= "Объект";
		Сообщение.Сообщить();
		
		Отказ = истина;
		
	КонецЕсли;  
	
	
	//Проверка нулевых сумм "Всего"
	Отбор = Новый Структура("Всего", 0);
	мСтроки = Объект.Услуги.НайтиСтроки(Отбор);
	
	Если мСтроки.Количество() > 0 Тогда
		
		Отказ = истина;
		Для Каждого СтрокаМассива из мСтроки Цикл
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст 		= "Сумма по строке равна 0!";
			Сообщение.Поле  		= "Услуги["+Формат(СтрокаМассива.НомерСтроки-1,"ЧГ=0")+"].Всего";
			Сообщение.ПутьКДанным	= "Объект";
			Сообщение.Сообщить();
		КонецЦикла;
		
	КонецЕсли;

	Возврат Отказ;
	
КонецФункции

&НаКлиенте
Процедура ОбновитьЗаголовкиСтраниц(СтраницаДополнительно=Ложь)
	
	ВсегоУслуг 							= Объект.Услуги.Количество();
	Элементы.Страница_Услуги.Заголовок 	= "Услуги"+?(ВсегоУслуг <> 0," ("+Формат(ВсегоУслуг,"ЧДЦ=; ЧГ=")+")","");
	
	Если СтраницаДополнительно Тогда
		ВсегоСвязанныхДокументов 				= ПолучитьКоличествоСвязанныхДокументов(Объект.Ссылка);
		Элементы.Страница_Документы.Заголовок 	= "Документы"+?(ВсегоСвязанныхДокументов <> 0," ("+Формат(ВсегоСвязанныхДокументов,"ЧДЦ=; ЧГ=")+")","");
	КонецЕсли;
	
	ВсегоДокументовВознаграждения 						= Объект.ДокументыВознаграждения.Количество();
	Элементы.Страница_ДокументыВознаграждения.Заголовок = "Документы вознаграждения"+?(ВсегоДокументовВознаграждения <> 0," ("+Формат(ВсегоДокументовВознаграждения,"ЧДЦ=; ЧГ=")+")","");
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьКоличествоСвязанныхДокументов(ОбъектСсылка)
	
	СтруктураСвязанныеДокументы 			= Документы.CW_ОтчетЭкспедитора.ПолучитьСвязанныеДоходыПоГрузопереовзкам(ОбъектСсылка);
	ЕстьПроведенныеСвязанныеДокументы 		= СтруктураСвязанныеДокументы.Проведенные.Количество();
	ЕстьСвязанныеДокументы					= СтруктураСвязанныеДокументы.ВсеДокументы.Количество();
	
	Возврат СтруктураСвязанныеДокументы.ВсеДокументы.Количество();
	
КонецФункции

&НаСервере
Процедура УстановитьВидимостьИТипЗначенияЗаполнения()
	
	Если ЭтоАдресВременногоХранилища(АдресЗначенияОтбора) Тогда
		ЗначениеЗаполнения = ПолучитьИзВременногоХранилища(АдресЗначенияОтбора);
	КонецЕсли;
	
	СвязьПараметровВыбора =  Новый СвязьПараметраВыбора("Отбор.Клиент",	"Объект.Контрагент");
	Массив = новый Массив;
	Массив.Добавить(СвязьПараметровВыбора);
	СвязиПараметровВыбора = Новый ФиксированныйМассив(Массив);
	
	Если Объект.ПорядокЗаполнения = 0 Тогда
		
		Элементы.ЗначениеЗаполненияСсылка.Видимость = истина;
		Элементы.ЗначениеЗаполненияСписок.Видимость = Ложь;
		
		Элементы.ЗначениеЗаполненияСсылка.СвязиПараметровВыбора = СвязиПараметровВыбора;
	
		Если ЗначениеЗаполнено(ЗначениеЗаполнения) и ТипЗнч(ЗначениеЗаполнения) = тип("СправочникСсылка.CW_Грузоперевозки") Тогда
			ЗначениеЗаполненияСсылка = ЗначениеЗаполнения;
		Иначе
			ЗначениеЗаполненияСсылка = ПредопределенноеЗначение("Справочник.CW_Грузоперевозки.ПустаяСсылка");
		КонецЕсли;
		
	ИначеЕсли Объект.ПорядокЗаполнения = 1 тогда
		
		Элементы.ЗначениеЗаполненияСсылка.Видимость = Ложь;
		Элементы.ЗначениеЗаполненияСписок.Видимость = истина;    
		
		Элементы.ЗначениеЗаполненияСписок.СвязиПараметровВыбора = СвязиПараметровВыбора;
		
		Если ЗначениеЗаполнено(ЗначениеЗаполнения) и ТипЗнч(ЗначениеЗаполнения) = Тип("Массив") Тогда
			ЗначениеЗаполненияСписок.ЗагрузитьЗначения(ЗначениеЗаполнения);
		Иначе
			ОписаниеТипов  							= Новый ОписаниеТипов("СправочникСсылка.CW_Грузоперевозки");
			ЗначениеЗаполненияСписок.ТипЗначения 	= ОписаниеТипов;
		КонецЕсли;
		
	ИначеЕсли Объект.ПорядокЗаполнения = 2 тогда
		
		Элементы.ЗначениеЗаполненияСсылка.Видимость = истина;
		Элементы.ЗначениеЗаполненияСписок.Видимость = Ложь;
		
		Элементы.ЗначениеЗаполненияСсылка.СвязиПараметровВыбора = СвязиПараметровВыбора;
		
		Если ЗначениеЗаполнено(ЗначениеЗаполнения) и ТипЗнч(ЗначениеЗаполнения) = тип("СправочникСсылка.CW_Заказы") Тогда
			ЗначениеЗаполненияСсылка = ЗначениеЗаполнения;
		Иначе
			ЗначениеЗаполненияСсылка = ПредопределенноеЗначение("Справочник.CW_Заказы.ПустаяСсылка");
		КонецЕсли;
		
	ИначеЕсли Объект.ПорядокЗаполнения = 3 тогда
		
		Элементы.ЗначениеЗаполненияСсылка.Видимость = Ложь;
		Элементы.ЗначениеЗаполненияСписок.Видимость = истина;
		
		Элементы.ЗначениеЗаполненияСписок.СвязиПараметровВыбора = СвязиПараметровВыбора;
		
		Если ЗначениеЗаполнено(ЗначениеЗаполнения) и ТипЗнч(ЗначениеЗаполнения) = Тип("Массив") Тогда
			ЗначениеЗаполненияСписок.ЗагрузитьЗначения(ЗначениеЗаполнения);
		Иначе
			ОписаниеТипов  							= Новый ОписаниеТипов("СправочникСсылка.CW_Заказы");
			ЗначениеЗаполненияСписок.ТипЗначения 	= ОписаниеТипов;;
		КонецЕсли;
		
	ИначеЕсли Объект.ПорядокЗаполнения = 4 тогда
		
		Элементы.ЗначениеЗаполненияСсылка.Видимость = истина;
		Элементы.ЗначениеЗаполненияСписок.Видимость = Ложь;
		
		СвязиПараметровВыбора = Новый ФиксированныйМассив(Новый Массив);
		Элементы.ЗначениеЗаполненияСсылка.СвязиПараметровВыбора = СвязиПараметровВыбора;
	
		Если ЗначениеЗаполнено(ЗначениеЗаполнения) и ТипЗнч(ЗначениеЗаполнения) = тип("ДокументСсылка.CW_РасходыПоГрузоперевозке") Тогда
			ЗначениеЗаполненияСсылка = ЗначениеЗаполнения;
		Иначе
			ЗначениеЗаполненияСсылка = ПредопределенноеЗначение("Документ.CW_РасходыПоГрузоперевозке.ПустаяСсылка");
		КонецЕсли;
		
	ИначеЕсли Объект.ПорядокЗаполнения = 5 тогда
		
		Элементы.ЗначениеЗаполненияСсылка.Видимость = Ложь;
		Элементы.ЗначениеЗаполненияСписок.Видимость = истина;
		
		СвязиПараметровВыбора = Новый ФиксированныйМассив(Новый Массив);
		Элементы.ЗначениеЗаполненияСписок.СвязиПараметровВыбора = СвязиПараметровВыбора;
		
		Если ЗначениеЗаполнено(ЗначениеЗаполнения) и ТипЗнч(ЗначениеЗаполнения) = Тип("Массив") Тогда
			ЗначениеЗаполненияСписок.ЗагрузитьЗначения(ЗначениеЗаполнения);
		Иначе
			ОписаниеТипов  							= Новый ОписаниеТипов("ДокументСсылка.CW_РасходыПоГрузоперевозке");
			ЗначениеЗаполненияСписок.ТипЗначения 	= ОписаниеТипов;;
		КонецЕсли;
		
	КонецЕсли;	 
	
КонецПроцедуры

&НаСервере
Процедура ПорядокЗаполненияПриИзмененииНаСервере()
	
	УстановитьВидимостьИТипЗначенияЗаполнения();
	
