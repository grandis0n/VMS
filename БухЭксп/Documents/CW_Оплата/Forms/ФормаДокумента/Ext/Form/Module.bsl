// ---------------------------------------------------------------------------- 

Функция _ПраваДоступа()
	// --- 
	
	ПравоРедактирования = CW_ПраваДоступа.ПравоДоступно("РедактированиеФинансов_ОперативныйУчет");
	Если (НЕ ПравоРедактирования ИЛИ ЭтаФорма.ТолькоПросмотр) Тогда
		
		ЭтаФорма.ТолькоПросмотр = Истина;
		
	КонецЕсли;
	
	// --- 
КонецФункции
  

&НаСервере
Процедура _УправлениеЭлементамиФормы()
	// --- 
	
	ПредставлениеДокументаОплаты = "П/п №"+Объект.Основание.НомерВходящегоДокумента+" от "+Формат(Объект.Основание.ДатаВходящегоДокумента,"ДФ=dd.MM.yyyy");
	
	// --- 
	Элементы.ОплатаОплата_БВ.Видимость = УЕ;
	Элементы.ОплатаКурс.Видимость = УЕ;
	// --- 
	Элементы.Оплата.ТолькоПросмотр = (НЕ ВводОстатков);
	Элементы.ОплатаАкт.Видимость = (НЕ ВводОстатков);
	// --- 
	Элементы.Оплата.ПоложениеКоманднойПанели = ?(ВводОстатков,ПоложениеКоманднойПанелиЭлементаФормы.Верх,ПоложениеКоманднойПанелиЭлементаФормы.Нет);
	
	// --- 
КонецПроцедуры

// --- 

&НаСервере
Процедура _ОпределитьРежимВводаОстатков()

	СтруктураНастроек  = CW_Настройки.ПолучитьНастройкиОперативногоУчета(Объект.Организация, Объект.ВидЗадолженности, Объект.Дата); 

	ОперативныйУчет = СтруктураНастроек["ВедетсяОперативныйУчет"]; 
	ВводОстатков 	= СтруктураНастроек["ВводОстатков"];

КонецПроцедуры
 

