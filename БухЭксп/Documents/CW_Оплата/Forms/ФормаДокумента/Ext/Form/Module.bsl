&НаКлиенте
Процедура ОплатаПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа)
	
	Отказ = Истина;
	// --- 
	Если (Копирование) Тогда
		
		Возврат;
		
	КонецЕсли; 
	// --- 
	ПОВ = Новый ОписаниеОповещения("ОбработкаДобавленияОплаты",ЭтотОбъект); 
	// --- 
	Если (Объект.ВидЗадолженности=ПредопределенноеЗначение("Перечисление.CW_ВидыОперативнойЗадолженности.Кредиторская")) Тогда
		
		СтруктураОтбора = Новый Структура("Контрагент,Договор,ПредъявленСчет",Объект.Контрагент,Объект.Договор,Истина);
		
		//Подсистема.УчетПриложенийДоговоров
		СтруктураОтбора.Вставить("ПриложениеКДоговору", Объект.ПриложениеКДоговору);
		//Подсистема.УчетПриложенийДоговоров
		
		ПФ = Новый Структура("Отбор,РежимВыбора",СтруктураОтбора,Истина);
		ОткрытьФорму("Документ.CW_РасходыПоГрузоперевозке.ФормаВыбора",ПФ,Элемент,,,,ПОВ,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);	
	Иначе
		
		СтруктураОтбора = Новый Структура("Контрагент,Договор,ФормироватьСчет",Объект.Контрагент,Объект.Договор,Истина);
		
		//Подсистема.УчетПриложенийДоговоров
		СтруктураОтбора.Вставить("ПриложениеКДоговору", Объект.ПриложениеКДоговору);
		//Подсистема.УчетПриложенийДоговоров
		
		ПФ = Новый Структура("Отбор,РежимВыбора",СтруктураОтбора,Истина);
		ОткрытьФорму("Документ.CW_ДоходыПоГрузоперевозке.ФормаВыбора",ПФ,Элемент,,,,ПОВ,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаДобавленияОплаты(Ответ, ДополнительныеПараметры) Экспорт
	// --- 
	
	Если (Ответ <> Неопределено) Тогда
		
		ТекСтрока = _ОбработатьВыборСчета(Ответ);
		Если (ТекСтрока <> Неопределено) Тогда
			Элементы.Оплата.ТекущаяСтрока = ТекСтрока;
		КонецЕсли; 
		
	КонецЕсли; 
	
	// --- 
КонецПроцедуры
  

&НаСервере
Функция _ОбработатьВыборСчета(Счет)
	// --- 
	
	ТЗСчета = Счет.Услуги.Выгрузить(,"СчетЗадолженности,Всего");
	ТЗСчета.Свернуть("СчетЗадолженности","Всего");
	// --- 
	ТекущийИдентификатор = Неопределено;
	// --- 
	Для каждого Стр Из ТЗСчета Цикл
		
		Нстр = Объект.Оплата.Добавить();
		// ---------------------------------------------------------------------------- 
		Нстр.Счет = Счет;
		Нстр.СчетЗадолженности = Стр.СчетЗадолженности;
		Нстр.СчетАванса = CW_Финансы.СчетАванса(Нстр.СчетЗадолженности);
		Нстр.Оплата = Стр.Всего;
		// --- 
		ТекущийИдентификатор = Нстр.ПолучитьИдентификатор();
		
	КонецЦикла; 
	
	Возврат(ТекущийИдентификатор);
	
	// --- 
КонецФункции

&НаКлиенте
Процедура ОплатаВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если (Поле = Элементы.ОплатаСчет) Тогда
		
		СтандартнаяОбработка = Ложь;
		Попытка
			ПоказатьЗначение(,Элементы.Оплата.ТекущиеДанные.Счет);
		Исключение
		    //ОписаниеОшибки()
		КонецПопытки; 
		
	ИначеЕсли (Поле = Элементы.ОплатаАкт) Тогда
		
		СтандартнаяОбработка = Ложь;
		Попытка
			ПоказатьЗначение(,Элементы.Оплата.ТекущиеДанные.Акт);
		Исключение
		    //ОписаниеОшибки()
		КонецПопытки; 
		
	КонецЕсли; 
	
КонецПроцедуры

