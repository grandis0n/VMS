	ОбработатьНастройкуСписка(Настройка);
	
КонецФункции

&НаСервере
Функция ПраваДоступаНаСервере()
	// --- 
	
	ПравоРедактирования = CW_ПраваДоступа.ПравоДоступно("РедактированиеФинансов");
	Если (НЕ ПравоРедактирования ИЛИ ЭтаФорма.ТолькоПросмотр) Тогда
		
		ЭтаФорма.ТолькоПросмотр = Истина;
		
	КонецЕсли;
	
	// --- 
КонецФункции

&НаСервере
Процедура УправлениеЭлементамиФормы()
	
	Элементы.Аналитика.Заголовок = ?(ВариантПривязки = 0, "Заказ","Грузоперевозка");
	Элементы.РасчетыВсегоВал.Заголовок = "Всего платежей ("	+ Объект.Валюта.Наименование + ")";
	Элементы.РасчетыСумма.Заголовок = "Фактурная стоимость (" + Объект.Валюта.Наименование + ")";
	Элементы.РасчетыТаможеннаяСтоимость.Заголовок = "Таможенная стоимость (" + Объект.Валюта.Наименование + ")";
	Элементы.СтраницаГрузоперевозки.Заголовок = ?(Не ТаблицаРаспределенияТоваров.Количество(), "Распределение (*)", "Распределение");
	Элементы.Аналитика.Видимость = Не ВариантПривязки = 2;
	Элементы.СтраницаГрузоперевозки.Видимость = Не ВариантПривязки = 2;
	
КонецПроцедуры

&НаСервере
Функция СформироватьЗаголовокФормы()
	
	ЗаголовокДокумента = 
		"Проект декларации на товары:" 
		+ ?(ЗначениеЗаполнено(Объект.НомерГТД), " " + СокрЛП(Объект.НомерГТД.Код), 
		?(ЗначениеЗаполнено(Объект.Ссылка), " " + СокрЛП(Объект.Номер), " (создание)"))
		+ ?(ЗначениеЗаполнено(Объект.Статус), " (" + Объект.Статус + ")", "");
	ЭтаФорма.Заголовок = ЗаголовокДокумента;
	
КонецФункции

#КонецОбласти

#Область РеквизитыШапки

&НаКлиенте
Процедура ДатаПриИзменении(Элемент)
	
	Если Не ЗначениеЗаполнено(Объект.Дата) Тогда
		Объект.Дата = ТекущаяДата();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВариантПривязкиПриИзменении(Элемент)
	
	Если ТаблицаРаспределенияТоваров.Количество() Тогда
		ПОВ = Новый ОписаниеОповещения("ОбработкаВопросаУстановкиВарианта", ЭтаФорма, Новый Структура("Отказ", Ложь));
		ПоказатьВопрос(ПОВ,"Таблица распределения по грузоперевозкам будет очищена. Продолжить?", РежимДиалогаВопрос.ДаНет);
	Иначе
		ВариантПривязкиПриИзмененииНаСервере();
		ЭтаФорма.Модифицированность = Истина;
	КонецЕсли; 
	

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВопросаУстановкиВарианта(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		
		Объект.Грузоперевозки.Очистить();
		ТаблицаГрузоперевозок.Очистить();
		ТаблицаРаспределенияТоваров.Очистить();
		ТаблицаРаспределено.Очистить();
		
		ВариантПривязкиПриИзмененииНаСервере();
		ЭтаФорма.Модифицированность = Истина;
		
		УправлениеЭлементамиФормы();
	Иначе
		Если ЗначениеЗаполнено(Объект.Аналитика) Тогда
			ВариантПривязки = ?(Объект.ПроектПоЗаказу,0,1);
		Иначе
			ВариантПривязки = 2;
		КонецЕсли; 
	КонецЕсли; 
	
КонецПроцедуры
  
&НаСервере
Процедура ВариантПривязкиПриИзмененииНаСервере()
	
	
	Если ВариантПривязки = 2 Тогда
		Объект.Аналитика = Неопределено;
		Объект.Грузоперевозки.Очистить();
		ТаблицаГрузоперевозок.Очистить();
		ТаблицаРаспределенияТоваров.Очистить();
		ТаблицаРаспределено.Очистить();
		
	Иначе	
		Объект.ПроектПоЗаказу = ?(ВариантПривязки=0,Истина,Ложь);
		
		// очищаем все ТЧ
		Объект.Грузоперевозки.Очистить();
		
		Если Объект.ПроектПоЗаказу Тогда
			
			Если ТипЗнч(Объект.Аналитика)=Тип("СправочникСсылка.CW_Грузоперевозки") Тогда
				
				Если НЕ Объект.Аналитика.Пустая() Тогда
					
					Объект.Аналитика = Объект.Аналитика.Заказ;
					
				Иначе
					
					Объект.Аналитика = Справочники.CW_Заказы.ПустаяСсылка();
					
				КонецЕсли; 
				
			Иначе
				
				Если ТипЗнч(Объект.Аналитика) <> Тип("СправочникСсылка.CW_Заказы") Тогда
					
					Объект.Аналитика = Справочники.CW_Заказы.ПустаяСсылка();
					
				КонецЕсли; 
				
			КонецЕсли; 
			
		Иначе
			
			Если ТипЗнч(Объект.Аналитика) <> Тип("СправочникСсылка.CW_Грузоперевозки") Тогда
				
				Объект.Аналитика = Справочники.CW_Грузоперевозки.ПустаяСсылка();
				
			КонецЕсли; 
			
		КонецЕсли;
	КонецЕсли;
		
	// изменяем тип
	УправлениеЭлементамиФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура ВалютаПриИзменении(Элемент)
	УправлениеЭлементамиФормы();
КонецПроцедуры

&НаКлиенте
Процедура НомерГТДПриИзменении(Элемент)
	СформироватьЗаголовокФормы();
КонецПроцедуры

&НаКлиенте
Процедура АналитикаПриИзменении(Элемент)
	
	Если ТаблицаРаспределенияТоваров.Количество() Тогда
		Если Объект.ПроектПоЗаказу Тогда
			ПОВ = Новый ОписаниеОповещения("ОбработкаВопросаИзмененияАналитики", ЭтаФорма, Новый Структура("Отказ", Ложь));
			ПоказатьВопрос(ПОВ,"Документ будет записан. Таблица распределения по грузоперевозкам будет очищена, продолжить", РежимДиалогаВопрос.ДаНет);
		Иначе
			ПОВ = Новый ОписаниеОповещения("ОбработкаВопросаИзмененияАналитики", ЭтаФорма, Новый Структура("Отказ", Ложь));
			ПоказатьВопрос(ПОВ,"Документ будет записан. Таблица распределения по грузоперевозкам будет перезаполнена, продолжить", РежимДиалогаВопрос.ДаНет);
		КонецЕсли; 
	Иначе
		//Если Не Объект.ПроектПоЗаказу Тогда
			ЗаполнитьГрузоперевозкиНаСервере(Истина);
			УправлениеЭлементамиФормы();
			ЭтаФорма.Модифицированность = Истина;
		//КонецЕсли;
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВопросаИзмененияАналитики(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		
		ЭтаФорма.Записать();
		СформироватьЗаголовокФормы();
		
		Объект.Грузоперевозки.Очистить();
		
		//Если Не Объект.ПроектПоЗаказу Тогда
		ЗаполнитьГрузоперевозкиНаСервере(Истина);
		//Иначе
		//	ТаблицаГрузоперевозок.Очистить();
		//	ТаблицаРаспределенияТоваров.Очистить();
		//	ТаблицаРаспределено.Очистить();
		//КонецЕсли; 
		
		ЭтаФорма.Модифицированность = Истина;
		УправлениеЭлементамиФормы();
		
	КонецЕсли; 
	
КонецПроцедуры
 
#КонецОбласти

#Область Расчеты

&НаКлиенте
Процедура РасчетыПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	Отказ = Истина;
	
	ТекСтрока = Элементы.Расчеты.ТекущиеДанные;
	
	Если ТекСтрока = Неопределено Тогда
		ЗначениеКопирования = Неопределено;
	Иначе
		ЗначениеКопирования = ТекСтрока.Ссылка;
	КонецЕсли; 
	
	
	Если Объект.Ссылка.Пустая() ИЛИ ЭтаФорма.Модифицированность Тогда
		ПОВ = Новый ОписаниеОповещения("ОбработкаОтветаЗаписиПриДобавленииРасчета",Этаформа, Новый Структура("Копирование, ЗначениеКопирования", Копирование, ЗначениеКопирования)); 
		ПоказатьВопрос(ПОВ,"Перед добавлением нового расчета, текущий проект необходимо записать. Записать?", РежимДиалогаВопрос.ДаНет);
	Иначе
		Если Копирование Тогда
			СтруктураПараметров = Новый Структура("Основание, ЗначениеКопирования", Объект.Ссылка, ЗначениеКопирования);
		Иначе
			СтруктураПараметров = Новый Структура("Основание", Объект.Ссылка);
		КонецЕсли; 
		ОткрытьФорму("Справочник.CW_РасчетыДТ.Форма.ФормаЭлемента", СтруктураПараметров,ЭтаФорма,,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	КонецЕсли; 
			
КонецПроцедуры

&НаКлиенте
Процедура РасчетыПередУдалением(Элемент, Отказ)
	
	Отказ = Истина;
	
	ТекСтрока = Элементы.Расчеты.ТекущиеДанные;
	
	Если ТекСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли; 
	
	ПОВ_ВопросСохранения = Новый ОписаниеОповещения("ОбработкаВопросаУдалениеРасчета",ЭтаФорма, Новый Структура("РасчетСсылка", ТекСтрока.Ссылка));
	ПоказатьВопрос(ПОВ_ВопросСохранения,"Данный расчет ДТ будет помечен на удаление, продолжить?", РежимДиалогаВопрос.ДаНет);  
	
КонецПроцедуры

&НаКлиенте
Процедура РасчетыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если ЭтаФорма.Модифицированность Тогда
		ПОВ = Новый ОписаниеОповещения("ОбработкаОтветаЗаписиПриОткрытииРасчета",Этаформа); 
		ПоказатьВопрос(ПОВ,"Перед изменением расчета, текущий проект необходимо записать. Записать?", РежимДиалогаВопрос.ДаНет);
	Иначе
		ИзменитьРасчетОбработка();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ИзменитьРасчет(Команда)
	
	Если ЭтаФорма.Модифицированность Тогда
		ПОВ = Новый ОписаниеОповещения("ОбработкаОтветаЗаписиПриОткрытииРасчета",Этаформа); 
		ПоказатьВопрос(ПОВ,"Перед изменением расчета, текущий проект необходимо записать. Записать?", РежимДиалогаВопрос.ДаНет);
	Иначе
		ИзменитьРасчетОбработка();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ИзменитьРасчетОбработка()
	
	ТекСтрока = Элементы.Расчеты.ТекущиеДанные;
	
	Если ТекСтрока = Неопределено  Тогда
		Возврат;
	КонецЕсли; 
	
	СтруктураПараметров = Новый Структура("Основание, Ключ", Объект.Ссылка, ТекСтрока.Ссылка);
	ОткрытьФорму("Справочник.CW_РасчетыДТ.Форма.ФормаЭлемента", СтруктураПараметров,ЭтаФорма,,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры
 
&НаКлиенте
Процедура ОбработкаВопросаУдалениеРасчета(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		ПометитьРасчетНаУдаление(ДополнительныеПараметры.РасчетСсылка);
		ЗаполнитьРасчетыПоПроекту();
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОтветаЗаписиПриДобавленииРасчета(Ответ, ДополнительныеПараметры) Экспорт 
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		
		ЭтаФорма.Записать();
		СформироватьЗаголовокФормы();
		
		Если НЕ ДополнительныеПараметры.Копирование Тогда
			СтруктураПараметров = Новый Структура("Основание", Объект.Ссылка);
		Иначе
			СтруктураПараметров = Новый Структура("Основание, ЗначениеКопирования", Объект.Ссылка, ДополнительныеПараметры.ЗначениеКопирования);
		КонецЕсли; 
		ОткрытьФорму("Справочник.CW_РасчетыДТ.Форма.ФормаЭлемента", СтруктураПараметров,ЭтаФорма,,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	Иначе
		Возврат;
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОтветаЗаписиПриОткрытииРасчета(Ответ, ДополнительныеПараметры) Экспорт 
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		ЭтаФорма.Записать();
		ИзменитьРасчетОбработка();
	Иначе
		Возврат;
	КонецЕсли; 
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьРасчетыПоПроекту()
	
	Расчеты.Очистить();
	ТаблицаРасчетов = Документы.CW_ПроектыДТ.ПолучитьТаблицуРасчетовПоПроектуДТ(Объект.Ссылка);
	
	НомерСтроки = 1;
	
	Для каждого Стр Из ТаблицаРасчетов Цикл
		
		НоваяСтрока = Расчеты.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Стр);
		НоваяСтрока.НомерСтроки = НомерСтроки;
		
		НомерСтроки = НомерСтроки + 1;
		
	КонецЦикла; 
	
	Если Расчеты.Количество() = 1 Тогда
		Если НЕ Расчеты[0].Ссылка = Объект.ОсновнойРасчетДТ Тогда
			Объект.ОсновнойРасчетДТ = Расчеты[0].Ссылка;
			ЭтаФорма.Модифицированность = Истина;
			СформироватьЗаголовокФормы();
		КонецЕсли; 
	КонецЕсли; 
	
	Если ЗначениеЗаполнено(Объект.ОсновнойРасчетДТ) Тогда
		Если Не Объект.Статус = Объект.ОсновнойРасчетДТ.Статус Тогда
			Объект.Статус = Объект.ОсновнойРасчетДТ.Статус;
			ЭтаФорма.Модифицированность = Истина;
			СформироватьЗаголовокФормы();
		КонецЕсли; 
	КонецЕсли; 
	
	УправлениеЭлементамиФормы();
	ИтогоСтрокРасчеты = Расчеты.Количество();
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ПометитьРасчетНаУдаление(РасчетСсылка)
	
	РасчетОбъект = РасчетСсылка.ПолучитьОбъект();
	РасчетОбъект.ПометкаУдаления = Истина;
	
	РасчетОбъект.Записать();
	
КонецПроцедуры

#КонецОбласти

#Область Грузоперевозки

&НаСервере
Процедура ЗаполнитьГрузоперевозкиНаСервере(РаспределитьКоличество = Ложь)
	
	ТаблицаГрузоперевозок.Очистить();
	ТаблицаРаспределенияТоваров.Очистить();
	ТаблицаРаспределено.Очистить();
	
	Если Не ВариантПривязки = 2 Тогда
		ЗаполнитьТаблицуГрузоперевозок();
		СформироватьКолонкиТаблицыГрузоперевозок();
		ЗаполнитьТаблицуРаспределенияТоваров(РаспределитьКоличество);
	КонецЕсли; 
	
	ИтогоСтрокГрузоперевозки = ТаблицаРаспределенияТоваров.Количество();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицуГрузоперевозок()
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ПроектПоЗаказу", Объект.ПроектПоЗаказу);
	Запрос.УстановитьПараметр("Аналитика", Объект.Аналитика);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	CW_Грузоперевозки.Ссылка
	|ИЗ
	|	Справочник.CW_Грузоперевозки КАК CW_Грузоперевозки
	|ГДЕ
	|	CW_Грузоперевозки.ПометкаУдаления = ЛОЖЬ
	|	И ВЫБОР
	|			КОГДА &ПроектПоЗаказу
	|				ТОГДА CW_Грузоперевозки.Заказ = &Аналитика
	|			ИНАЧЕ CW_Грузоперевозки.Ссылка = &Аналитика
	|		КОНЕЦ";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Сч = 1;
	Пока Выборка.Следующий() Цикл
		
		НоваяСтрока = ТаблицаГрузоперевозок.Добавить();
		НоваяСтрока.Грузоперевозка = Выборка.Ссылка;
		НоваяСтрока.ИмяРеквизита   = "Грузоперевозка_" + Сч;
		НоваяСтрока.Заголовок      = СокрЛП(Выборка.Ссылка.CW_Представление);
		
		Сч = Сч + 1;
		
	КонецЦикла; 
	
КонецПроцедуры

&НаСервере
Процедура СформироватьКолонкиТаблицыГрузоперевозок()
	
	МассивДобавляемыхРеквизитов = Новый Массив;
	МассивУдаляемыхРеквизитов   = Новый Массив;
	МассивУдаляемыхЭлементов    = Новый Массив;
	
	ЭлементыФормыКДобавлению = Новый ТаблицаЗначений;
	ЭлементыФормыКДобавлению.Колонки.Добавить("ИмяРеквизита");
	ЭлементыФормыКДобавлению.Колонки.Добавить("Заголовок");
	
	Массив = Новый Массив;
	Массив.Добавить(Тип("Число"));
	ТипЗначения = Новый ОписаниеТипов(Массив,,,Новый КвалификаторыЧисла(10,3));

	Для каждого Стр Из СформированныеРеквизитыФормы Цикл
		Путь        = Элементы.ТаблицаРаспределенияТоваров.ПутьКДанным + "." + Стр.Значение;
		ИмяЭлемента = Элементы.ТаблицаРаспределенияТоваров.ПутьКДанным + Стр.Значение;
		МассивУдаляемыхРеквизитов.Добавить(Путь);
		МассивУдаляемыхЭлементов.Добавить(ИмяЭлемента); 
	КонецЦикла;  
	
	СформированныеРеквизитыФормы.Очистить();
			
	// Добавляем необходимые реквизиты формы
	Для каждого Стр Из ТаблицаГрузоперевозок Цикл
		
		НовыйРеквизитФормы = Новый РеквизитФормы(Стр.ИмяРеквизита, ТипЗначения, Элементы.ТаблицаРаспределенияТоваров.ПутьКДанным);
		МассивДобавляемыхРеквизитов.Добавить(НовыйРеквизитФормы);
			
		СформированныеРеквизитыФормы.Добавить(Стр.ИмяРеквизита);

		НоваяСтрока = ЭлементыФормыКДобавлению.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока,Стр);

	КонецЦикла; 
	  		
	ЭтаФорма.ИзменитьРеквизиты(МассивДобавляемыхРеквизитов, МассивУдаляемыхРеквизитов);
	
	// Удаляем не используемые элементы формы
	Для каждого Элемент Из МассивУдаляемыхЭлементов Цикл
		Элементы.Удалить(Элементы.Найти(Элемент));
	КонецЦикла; 
	
	// Добавляем необходимые элементы формы
	Для Каждого Стр Из ЭлементыФормыКДобавлению Цикл
		
		ПолноеИмяРеквизита = "" + Элементы.ТаблицаРаспределенияТоваров.ПутьКДанным + Стр.ИмяРеквизита;
		
		ПолеКолонки = Элементы.Добавить(ПолноеИмяРеквизита, Тип("ПолеФормы"), Элементы.ТаблицаРаспределенияТоваров); 
		ПолеКолонки.ПутьКДанным = Элементы.ТаблицаРаспределенияТоваров.ПутьКДанным+"."+Стр.ИмяРеквизита;	
		ПолеКолонки.РастягиватьПоГоризонтали = Ложь;
		ПолеКолонки.ЦветФонаЗаголовка = ЦветаСтиля.РамкаСеткиТаблицы;
		ПолеКолонки.Видимость         = Истина;
		ПолеКолонки.АвтоВысотаЯчейки  = Истина;
		ПолеКолонки.Ширина            = 10;
		ПолеКолонки.Заголовок         = Стр.Заголовок;
		ПолеКолонки.Вид               = ВидПоляФормы.ПолеВвода;
		
	КонецЦикла; 
	
	//Элементы.ТаблицаРаспределенияТоваровНомерСтроки.ФиксацияВТаблице      = ФиксацияВТаблице.Лево;
	//Элементы.ТаблицаРаспределенияТоваровКодТНВЭД.ФиксацияВТаблице         = ФиксацияВТаблице.Лево;
	//Элементы.ТаблицаРаспределенияТоваровНоменклатура.ФиксацияВТаблице     = ФиксацияВТаблице.Лево;
	//Элементы.ТаблицаРаспределенияТоваровЕдиницаИзмерения.ФиксацияВТаблице = ФиксацияВТаблице.Лево;
	//Элементы.ТаблицаРаспределенияТоваровКоличество.ФиксацияВТаблице       = ФиксацияВТаблице.Лево;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицуРаспределенияТоваров(РаспределитьКоличество = Ложь)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("РасчетДТ", Объект.ОсновнойРасчетДТ);
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	CW_РасчетыДТТовары.Ссылка КАК РасчетДТ,
	|	CW_РасчетыДТТовары.КодТНВЭД,
	|	CW_РасчетыДТТовары.Номенклатура,
	|	CW_РасчетыДТТовары.ЕдиницаИзмерения,
	|	СУММА(CW_РасчетыДТТовары.Количество) КАК КоличествоВсего
	|ИЗ
	|	Справочник.CW_РасчетыДТ.Товары КАК CW_РасчетыДТТовары
	|ГДЕ
	|	CW_РасчетыДТТовары.Ссылка = &РасчетДТ
	|
	|СГРУППИРОВАТЬ ПО
	|	CW_РасчетыДТТовары.КодТНВЭД,
	|	CW_РасчетыДТТовары.ЕдиницаИзмерения,
	|	CW_РасчетыДТТовары.Номенклатура,
	|	CW_РасчетыДТТовары.Ссылка";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	НомерСтроки = 1;
	КоличествоГрузоперевозок = ТаблицаГрузоперевозок.Количество();
	Пока Выборка.Следующий() Цикл
		
		НоваяСтрока = ТаблицаРаспределенияТоваров.Добавить();
		НоваяСтрока.НомерСтроки = НомерСтроки;
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		
		Отбор = Новый Структура("КодТНВЭД, Номенклатура, ЕдиницаИзмерения");
		ЗаполнитьЗначенияСвойств(Отбор, Выборка);
		
		НайденныеСтрокиОбъект = Объект.Грузоперевозки.НайтиСтроки(Отбор);
		Идентификатор = НоваяСтрока.ПолучитьИдентификатор();
		
		// Получеам уже распределенное количество по грузоперевозкам
		Для каждого Строка Из НайденныеСтрокиОбъект Цикл
			
			ИменаКолонок = ТаблицаГрузоперевозок.НайтиСтроки(Новый Структура("Грузоперевозка", Строка.Грузоперевозка));
			
			Если ИменаКолонок.Количество() Тогда
				
				ИмяРеквизита = ИменаКолонок[0].ИмяРеквизита;
				
				НоваяСтрока[ИмяРеквизита] = Строка.Количество;
				
				НоваяСтрокаРаспределено = ТаблицаРаспределено.Добавить();
				НоваяСтрокаРаспределено.ИдентификаторСтроки = Идентификатор;
				НоваяСтрокаРаспределено.ИмяРеквизита        = ИменаКолонок[0].ИмяРеквизита;
				НоваяСтрокаРаспределено.Количество          = Строка.Количество;
				
			КонецЕсли; 
						
		КонецЦикла; 
		
		Если Не НайденныеСтрокиОбъект.Количество() И РаспределитьКоличество Тогда
			
			КоличествоРаспределить     = Выборка.КоличествоВсего;
			КоличествоПоГрузоперевозке = Окр(КоличествоРаспределить / КоличествоГрузоперевозок,3);
			
			Для каждого Строка Из ТаблицаГрузоперевозок Цикл
				
				НоваяСтрока[Строка.ИмяРеквизита] = КоличествоПоГрузоперевозке;
				КоличествоРаспределить = КоличествоРаспределить - КоличествоПоГрузоперевозке;
				
				НоваяСтрокаРаспределено = ТаблицаРаспределено.Добавить();
				НоваяСтрокаРаспределено.ИдентификаторСтроки = НоваяСтрока.ПолучитьИдентификатор();
				НоваяСтрокаРаспределено.ИмяРеквизита        = Строка.ИмяРеквизита;
				НоваяСтрокаРаспределено.Количество          = КоличествоПоГрузоперевозке;
				
			КонецЦикла; 
			
			Если Не КоличествоРаспределить = 0 Тогда // Добавим не распределенный остаток в первую строку
				НоваяСтрока[ТаблицаГрузоперевозок[0].ИмяРеквизита] = НоваяСтрока[ТаблицаГрузоперевозок[0].ИмяРеквизита] + КоличествоРаспределить;
				ТаблицаРаспределено[0].Количество = ТаблицаРаспределено[0].Количество + КоличествоРаспределить;
			КонецЕсли;
			
		КонецЕсли; 
		
		
		// Если грузоперевозка всего одна, то распределим все количество на нее
		//Если ТаблицаГрузоперевозок.Количество() = 1 И НайденныеСтрокиОбъект.Количество() = 0 Тогда
		//	
		//	ИмяРеквизита = ТаблицаГрузоперевозок[0].ИмяРеквизита;
		//	
		//	НоваяСтрока[ИмяРеквизита] = Выборка.КоличествоВсего;
		//	
		//	НоваяСтрокаРаспределено = ТаблицаРаспределено.Добавить();
		//	НоваяСтрокаРаспределено.ИдентификаторСтроки = Идентификатор;
		//	НоваяСтрокаРаспределено.ИмяРеквизита        = ИмяРеквизита;
		//	НоваяСтрокаРаспределено.Количество          = Выборка.КоличествоВсего;
		//КонецЕсли; 
								
		НомерСтроки = НомерСтроки  + 1;
		
	КонецЦикла; 
 		
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаРаспределенияТоваровПриИзменении(Элемент)
	
	Идентификатор = Элементы.ТаблицаРаспределенияТоваров.ТекущаяСтрока;
	ТекСтрока     = Элементы.ТаблицаРаспределенияТоваров.ТекущиеДанные;
	
	Если ТекСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли; 
	
	ВсегоДоступно = ТекСтрока.КоличествоВсего;
	ИмяКолонки = СтрЗаменить(Элемент.ТекущийЭлемент.Имя, Элементы.ТаблицаРаспределенияТоваров.Имя, "");
	
	// Запоминаем, вводимые пользователем, значения
	Отбор = Новый Структура("ИдентификаторСтроки,ИмяРеквизита");
	Отбор.ИдентификаторСтроки = Идентификатор;
	Отбор.ИмяРеквизита        = ИмяКолонки;
	
	НайденныеСтроки = ТаблицаРаспределено.НайтиСтроки(Отбор);
	КоличествоДоИзм = 0;
	Если НайденныеСтроки.Количество() = 0 Тогда
		СтрокаОтбора = ТаблицаРаспределено.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаОтбора, Отбор);
		СтрокаОтбора.Количество = ТекСтрока[ИмяКолонки];
	Иначе
		СтрокаОтбора = НайденныеСтроки[0]; 
		ЗаполнитьЗначенияСвойств(СтрокаОтбора, Отбор);
		КоличествоДоИзм = СтрокаОтбора.Количество; 
		СтрокаОтбора.Количество = ТекСтрока[ИмяКолонки];
	КонецЕсли; 
	
	Отбор = Новый Структура("ИдентификаторСтроки",Идентификатор);
	МассивВсего = ТаблицаРаспределено.НайтиСтроки(Отбор);
	
	// Проверяем не превышает ли введенное количество доступное количество
	ВсегоПодобрано = 0;
	Для каждого Стр Из МассивВсего Цикл
		ВсегоПодобрано = ВсегоПодобрано + Стр.Количество
	КонецЦикла; 
	
	Если ВсегоПодобрано > ВсегоДоступно Тогда
		
		ПоказатьПредупреждение(,"Количество превышает доступное!", 2);
		
		// Возвращаем значения до изменения
		ВсегоПодобрано = ВсегоПодобрано - ТекСтрока[ИмяКолонки] + КоличествоДоИзм;
		
		ТекСтрока[ИмяКолонки]   = КоличествоДоИзм;
		СтрокаОтбора.Количество = КоличествоДоИзм;
		
	КонецЕсли; 
	
	ОсталосьРаспределить = ВсегоДоступно - ВсегоПодобрано;
	
	Если ОсталосьРаспределить = 0 Тогда
		ИнфоОсталосьРаспределить = "Все количество распределено";
	Иначе
		ИнфоОсталосьРаспределить = "Осталось распределить: " + ОсталосьРаспределить + " " + ТекСтрока.ЕдиницаИзмерения;
	КонецЕсли; 
	
	ЭтаФорма.Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаРаспределенияТоваровПриАктивизацииСтроки(Элемент)
	
	Идентификатор = Элементы.ТаблицаРаспределенияТоваров.ТекущаяСтрока;
	ТекСтрока     = Элементы.ТаблицаРаспределенияТоваров.ТекущиеДанные;
	
	Если ТекСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли; 
	
	ВсегоДоступно = ТекСтрока.КоличествоВсего;
	
	Отбор = Новый Структура("ИдентификаторСтроки",Идентификатор);
	НайденныеСтрокиВсего = ТаблицаРаспределено.НайтиСтроки(Отбор);
	
	// Проверяем не превышает ли значение доступное количество
	ВсегоПодобрано = 0;
	Для каждого Стр Из НайденныеСтрокиВсего Цикл
		ВсегоПодобрано = ВсегоПодобрано + Стр.Количество
	КонецЦикла; 
	
	ОсталосьРаспределить = ВсегоДоступно - ВсегоПодобрано;
	Если ОсталосьРаспределить = 0 Тогда
		ИнфоОсталосьРаспределить = "Все количество распределено";
	Иначе
		ИнфоОсталосьРаспределить = "Осталось распределить: " + ОсталосьРаспределить + " " + ТекСтрока.ЕдиницаИзмерения;
	КонецЕсли; 
	
КонецПроцедуры

