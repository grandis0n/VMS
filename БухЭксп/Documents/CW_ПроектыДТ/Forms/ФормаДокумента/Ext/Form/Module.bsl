#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	
	ПраваДоступаНаСервере();
	
	Если ЗначениеЗаполнено(Параметры.ЗначениеКопирования) Тогда
		Объект.Грузоперевозки.Очистить();
		ТаблицаГрузоперевозок.Очистить();
		ТаблицаРаспределенияТоваров.Очистить();
		ТаблицаРаспределено.Очистить();
		Объект.Аналитика        = Неопределено;
		Объект.ОсновнойРасчетДТ = Неопределено;
	КонецЕсли; 
	
	Если ЗначениеЗаполнено(Объект.Аналитика) Тогда
		ВариантПривязки = ?(Объект.ПроектПоЗаказу,0,1);
	Иначе
		ВариантПривязки = 2;
	КонецЕсли; 
	
	Если (Объект.Ссылка.Пустая()) Тогда
		ВариантПривязкиПриИзмененииНаСервере();
		Объект.Автор = ПараметрыСеанса.ТекущийПользователь;
	КонецЕсли; 

	СформироватьЗаголовокФормы();
	ЗагрузитьСеансовуюНастройку();
	
	ЗаполнитьРасчетыПоПроекту();
	ЗаполнитьГрузоперевозкиНаСервере();
	
	УправлениеЭлементамиФормы();
	
	// --- 
	СостояниеДокумента = ОбщегоНазначенияБП.СостояниеДокумента(Объект); // ВызовБП
	
	//Внешние подклчюаемые команды
	CW_ПодключаемыеКомандыСервер.ПриСозданииНаСервере(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "Документ.ПроектыДТ.Изменение" Тогда
		
		ЗаполнитьРасчетыПоПроекту();
		
		Если Параметр.ЕстьИзмененияДляРаспределения И ТаблицаГрузоперевозок.Количество() И Объект.ОсновнойРасчетДТ = Параметр.РасчетСсылка Тогда
			ПОВ = Новый ОписаниеОповещения("ОбработкаВопросаОбработкиОповещения", ЭтаФорма, Новый Структура("Отказ", Ложь));
			ПоказатьВопрос(ПОВ,"В расчет были внесены изменения," + Символы.ПС + "перезаполнить таблицу распределения по грузуперевозкам?", РежимДиалогаВопрос.ДаНет);
		КонецЕсли; 
		
		Если Параметр.ЕстьИзмененияВСумме Тогда
			ЭтаФорма.Модифицированность = Истина;
		КонецЕсли; 
		
	ИначеЕсли ИмяСобытия = "ВыполнитьМетодВладельца" Тогда
				
		Если ТипЗнч(Параметр) = тип("Структура") Тогда
			УникальныйИдентификаторВладельца 	= Неопределено;
			МетодыФормыВладельца 				= Неопределено;
			
			Параметр.Свойство("УникальныйИдентификатор"	, УникальныйИдентификаторВладельца);
			Параметр.Свойство("МетодыФормыВладельца"	, МетодыФормыВладельца);
			
			Если ЭтаФорма.УникальныйИдентификатор = УникальныйИдентификаторВладельца Тогда
				Если Не МетодыФормыВладельца = Неопределено и ТипЗнч(МетодыФормыВладельца) = Тип("Массив") Тогда
					
					Для Каждого СтрокаМассива из МетодыФормыВладельца Цикл
						Попытка
							Выполнить(СтрокаМассива);
						Исключение
						КонецПопытки;
					КонецЦикла;
					
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;	

	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВопросаОбработкиОповещения(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		
		Объект.Грузоперевозки.Очистить();
		ТаблицаГрузоперевозок.Очистить();
		ТаблицаРаспределенияТоваров.Очистить();
		ТаблицаРаспределено.Очистить();
		
		ЗаполнитьГрузоперевозкиНаСервере(Истина);
		ЭтаФорма.Модифицированность = Истина;
		
		УправлениеЭлементамиФормы();
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	Объект.Грузоперевозки.Очистить();
	
	// Перенесем распределенное Количество в объект
	Для каждого СтрокаРаспределения Из ТаблицаРаспределенияТоваров Цикл
		Для каждого СтрокаГрузоперевозка Из ТаблицаГрузоперевозок Цикл
			НоваяСтрока = Объект.Грузоперевозки.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаРаспределения);
			НоваяСтрока.Грузоперевозка = СтрокаГрузоперевозка.Грузоперевозка;
			НоваяСтрока.Количество     = СтрокаРаспределения[СтрокаГрузоперевозка.ИмяРеквизита];
		КонецЦикла; 
	КонецЦикла; 
		
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	СостояниеДокумента = ОбщегоНазначенияБП.СостояниеДокумента(Объект); // ВызовБП
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, СтандартнаяОбработка)
	
	СохранитьСеансовуюНастройку();

КонецПроцедуры

#КонецОбласти

#Область ИнициализацияФормы

