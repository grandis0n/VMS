&НаКлиенте
Процедура СделатьОсновным(Команда)
	
	ТекСтрока = Элементы.Расчеты.ТекущиеДанные;
	
	Если ТекСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли; 
	
	Если Не ТекСтрока.Ссылка = Объект.ОсновнойРасчетДТ Тогда
		ПОВ = Новый ОписаниеОповещения("ОбработкаВопросаУстановкиОсновногоРасчета",ЭтаФорма, Новый Структура("РасчетСсылка", ТекСтрока.Ссылка));
		Если ТаблицаГрузоперевозок.Количество() Тогда
			ТекстВопроса = "Таблица грузоперевозок будет очищена. Сделать данный расчет основным?"
		Иначе
			ТекстВопроса = "Сделать данный расчет основным?";
		КонецЕсли; 
		ПоказатьВопрос(ПОВ,ТекстВопроса,РежимДиалогаВопрос.ДаНет);
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВопросаУстановкиОсновногоРасчета(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		
		Объект.Грузоперевозки.Очистить();
		Объект.ОсновнойРасчетДТ = ДополнительныеПараметры.РасчетСсылка;
		Объект.Статус           = ПолучитьСтатусРасчетаСервер(ДополнительныеПараметры.РасчетСсылка); 
		ТаблицаГрузоперевозок.Очистить();
		ТаблицаРаспределенияТоваров.Очистить();
		ТаблицаРаспределено.Очистить();
				
		ЭтаФорма.Модифицированность = Истина;
		
		УправлениеЭлементамиФормы();
		СформироватьЗаголовокФормы();
		
	КонецЕсли; 
	
КонецПроцедуры

