КонецПроцедуры

&НаСервере
Процедура ПриИзмененииГрузоперевозкиНаСервере(ИдентификаторСтроки)
	
	СтрокаЭтапа = Объект.ЭтапыМаршрута.НайтиПоИдентификатору(ИдентификаторСтроки);
	
	МассивГрузоперевозок = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(СтрокаЭтапа.Грузоперевозка);
	
	РезультатЗапроса = ПолучитьЗаполняемыеПараметрыПоГрузопереовзке(МассивГрузоперевозок);	
	
	Выборка_Грузопереовозки = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Для каждого ГрузоперевозкаИзМассива Из МассивГрузоперевозок Цикл
		
		СтрокаЭтапа.КоличествоЕздок	= 1;
		СтрокаЭтапа.Груз 			= ГрузоперевозкаИзМассива.Груз;
		
		//Заполнение парамтеров
		Выборка_Грузопереовозки.Сбросить();
		Если Выборка_Грузопереовозки.НайтиСледующий(новый Структура("Грузопереовзка",ГрузоперевозкаИзМассива)) Тогда
		
			ВыборкаПараметры = Выборка_Грузопереовозки.Выбрать();
			
			Пока ВыборкаПараметры.Следующий() Цикл
				РеквизитПутевогоЛиста 	= ВыборкаПараметры.РеквизитПутевогоЛиста.Метаданные().ЗначенияПеречисления[Перечисления.CW_РеквизитыПутевыхЛистов.Индекс(ВыборкаПараметры.РеквизитПутевогоЛиста)].Имя;
				Параметр 				= ВыборкаПараметры.ПараметрГрузоперевозки;
				
				ИмяРеквизита = СтрЗаменить(РеквизитПутевогоЛиста,"ЭтапыМаршрута_","");
				
				СтрокаПараметра = CW_Мониторинг.СтрокаПараметра(ГрузоперевозкаИзМассива, ВыборкаПараметры.ПараметрГрузоперевозки);
				Если (СтрокаПараметра <> Неопределено) Тогда
					Попытка
						СтрокаЭтапа[ИмяРеквизита] = СтрокаПараметра.Значение;
					Исключение
					КонецПопытки;
				КонецЕсли;
				
			КонецЦикла;
		
		КонецЕсли;
		
	КонецЦикла; 
	
	ЗаполнитьДобавленныеКолонкиТаблиц("ЭтапыМаршрута");

КонецПроцедуры

&НаКлиенте
Процедура ДобавитьДокументЗаправки(Команда)
	
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("СкладПолучатель"	, СкладБУ);
	
	ДанныеОтбора = Новый Структура("Отбор",ПараметрыОтбора); 
	
	Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияФормыВыбораПеремещнийТовара", ЭтаФорма, Параметры);	
	
	ОткрытьФорму("Документ.ПеремещениеТоваров.ФормаВыбора", ДанныеОтбора,ЭтаФорма,,,,Оповещение,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияФормыВыбораПеремещнийТовара(ЗначениеВыбора, ДополнительныеПараметры) Экспорт
	
	Если ЗначениеВыбора <> Неопределено Тогда
		
		ОбработатьВыборНаСервере(ЗначениеВыбора);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбработатьВыборНаСервере(МассивЗначений)
	
	Если НЕ ТипЗнч(МассивЗначений) = Тип("Массив") Тогда
		
		МассивЗначений = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(МассивЗначений);
		
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПеремещениеТоваровТовары.Ссылка КАК Документ,
		|	СУММА(ПеремещениеТоваровТовары.Количество) КАК Объем
		|ИЗ
		|	Документ.ПеремещениеТоваров.Товары КАК ПеремещениеТоваровТовары
		|ГДЕ
		|	ПеремещениеТоваровТовары.Ссылка В(&мСсылки)
		|	И ПеремещениеТоваровТовары.Номенклатура = &Номенклатура
		|	И ПеремещениеТоваровТовары.Ссылка.СкладПолучатель = &СкладПолучатель
		|
		|СГРУППИРОВАТЬ ПО
		|	ПеремещениеТоваровТовары.Ссылка";
	
	Запрос.УстановитьПараметр("мСсылки"				, МассивЗначений);
	Запрос.УстановитьПараметр("Номенклатура"		, Объект.Топливо);
	Запрос.УстановитьПараметр("СкладПолучатель"		, СкладБУ);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		мСтроки = Объект.ТопливоВыдано.НайтиСтроки(Новый Структура("Документ",Выборка.Документ));
		
		если мСтроки.Количество() > 0 тогда
			
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Документ "+СокрЛП(Выборка.Документ) +" уже есть в списке";
			Сообщение.Сообщить();
			
		Иначе
			
			НоваяСтрока = Объект.ТопливоВыдано.Добавить();
			
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
			
		КонецЕсли;
		
	КонецЦикла;
	
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаправкиПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НоваяСтрока Тогда
		
		ДанныеСтроки = Элементы.Заправки.ТекущиеДанные;
		
		ЗаполнитьЗначенияСвойств(ДанныеСтроки, ПолучитьданныеСтрокиЗаправкиДляЗаполнения());

	КонецЕсли;
	
КонецПроцедуры


&НаСервере
Функция ПолучитьданныеСтрокиЗаправкиДляЗаполнения()
	
	СтрктураДанных = Новый Структура;
	СтрктураДанных.Вставить("ВариантЗаправки"	, ПредопределенноеЗначение("Перечисление.CW_ВариантыЗаправокТС.НаличныйРасчет"));
	СтрктураДанных.Вставить("СтавкаНДС"			,  CW_БухгалтерияЭкспедитораСерверПереопределяемый.СтавкаНДС(Объект.Топливо));
	СтрктураДанных.Вставить("Водитель"			, Объект.Водитель);
	СтрктураДанных.Вставить("Топливо"			, Объект.Топливо);
	
	
	Возврат СтрктураДанных;
	
КонецФункции

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	ЗаписьСоответствия 						= РегистрыСведений.CW_СоответствияПутевыхЛистовИНоменклатурныхГрупп.СоздатьМенеджерЗаписи();
	ЗаписьСоответствия.ПутевойЛист 			= ТекущийОбъект.Ссылка;
	ЗаписьСоответствия.НоменклатурнаяГруппа = ТекущийОбъект.АналитикаЗатрат;
	ЗаписьСоответствия.Записать(истина);
	
	ПроверитьИЗаписатьАналитикуЗатрат();
	
	ПодготовитьДанныеФормы();

КонецПроцедуры

&НаСервере
Процедура ПроверитьИЗаписатьАналитикуЗатрат()
	
	Если ЗначениеЗаполнено(Объект.АналитикаЗатрат) тогда
		
		ДатаСреза = ПолучитьДатуСреза();
		
		СтруктураДанных = Новый Структура;
		СтруктураДанных.Вставить("ДатаСреза"					, ДатаСреза);
		СтруктураДанных.Вставить("ТранспортноеСредство"			, Объект.ТранспортноеСредство);
		СтруктураДанных.Вставить("ПараметрТранпортногоСредства"	, ПланыВидовХарактеристик.CW_ПараметрыТранспортныхСредств.ГруппаПутевыхЛистов);
		ГруппаПутевыхЛистов = CW_УчетСобственногоТранспортаСервер.ПолучитьПараметрТранспортногоСредства(СтруктураДанных);
		
		Если  ГруппаПутевыхЛистов <> Неопределено Тогда
			
			Если Объект.АналитикаЗатрат.Родитель <> ГруппаПутевыхЛистов Тогда
				
				ОбъектАналитикаЗатрат = Объект.АналитикаЗатрат.ПолучитьОбъект();
				ОбъектАналитикаЗатрат.Родитель =  ГруппаПутевыхЛистов;
				ОбъектАналитикаЗатрат.Записать();
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПростоиНачалоПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.Простои.ТекущиеДанные;
	ПересчитатьВремяПростоя(ТекущиеДанные);	
	
КонецПроцедуры

&НаКлиенте
Процедура ПростоиОкончаниеПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.Простои.ТекущиеДанные;
	ПересчитатьВремяПростоя(ТекущиеДанные);	
	
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьВремяПростоя(ТекущиеДанные)
	
	Если  ТекущиеДанные.Окончание <  ТекущиеДанные.Начало Тогда
		Возврат;
	КонецЕсли;
	
	СтруктураСтроки = Новый Структура("Начало,Окончание,ВремяПростоя,ВремяПростояЧас");
	
	ЗаполнитьЗначенияСвойств(СтруктураСтроки, ТекущиеДанные);
	
	ПересчитатьДанныеСтроки(СтруктураСтроки);
	
	ЗаполнитьЗначенияСвойств(ТекущиеДанные, СтруктураСтроки);
	
	
КонецПроцедуры

&НаСервере
Функция ПересчитатьДанныеСтроки(СтркутураСтроки)
	
	ВремяПрсотояСек = СтркутураСтроки.Окончание - СтркутураСтроки.Начало;
	
	ВремяПростояЧас 					= ОКР((ВремяПрсотояСек)/3600, 2);
	СтркутураСтроки.ВремяПростояЧас 	= ВремяПростояЧас;

	ЧасПростоя = Формат(Цел(ВремяПрсотояСек/3600),"ЧН=00; ЧГ=0");
	МинПростоя = Формат(Цел((ВремяПрсотояСек - (ЧасПростоя * 3600))/60),"ЧН=00; ЧГ=0");
	
	СтркутураСтроки.ВремяПростоя 		=?(СтрДлина(ЧасПростоя)=1, "0","")+ЧасПростоя +":" +?(СтрДлина(МинПростоя)=1, "0","")+ МинПростоя;	
	СтркутураСтроки.ВремяПростояЧас 	= ВремяПростояЧас;	
	
КонецФункции

