&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	_УФС.ОтключитьИсториюВыбораЭлементовФормы(ЭтаФорма);
	// ---------------------------------------------------------------------------- 
	УстановитьФункциональныеОпцииДокумента();
	
	ПорядокОтраженияЗатратВПеделахПогрешности = Константы.CW_ВариантОтраженияЗатратПоБУВПределахПогрешности.Получить(); 
	
	РеквизитВыезд 				= "Выезд";
	РеквизитВозвращение 		= "Возвращение";
	// --- 
	РеквизитРасходВсего 		= "Расход, л";
	РеквизитРасходНормированный = "Расход, л/100км";
	
	Если Параметры.Ключ.Пустая() Тогда
		Статус = ПредопределенноеЗначение("Перечисление.CW_СтатусыПутевыхЛистов.Выписан");
		Объект.Организация 							= CW_Настройки.ОсновнаяОрганизация();
		Объект.РассчитыватьНормативныйРасходТоплива = ПрименяютсяНормативыРасходаТоплива;
		Объект.Ответственный 						= Пользователи.ТекущийПользователь();
	Иначе	
		Статус = Объект.Статус;
		
		ОбновитьДанныеДляРасчетаПогрешности();
				
	КонецЕсли;
	
	ТекущаяОрганизация = Объект.Организация;
	
	_ВосстановитьСеансовуюНастройку();
	
	// ---------------------------------------------------------------------------- 
	
	ЗаполнитьДанныеФормыДокумента();
	
	УстановитьВидимостьЭлементовФормы();
	
	_ОбновитьПредставлениеВодителей();
	
	ПоказатьСкрытьПростоиЭтапа();
	
	РассчиатьПробегПоОдометру();
	
	ВыделитьЦветомОтклонениеПробега();

	УстановитьЗаголовкиСвертываемыхГрупп();
	
	УстановитьВидимостьСсылкиВодители() ;
	
	ОбновитьДанныеРегистрационныхЗнаков();
	
	ЗаполнитьСписокСведенийОПеревозках();
	
	ТолькоПросмотр = Не ДоступноЗакрытиеПутевыхЛистов и ЗначениеЗаполнено(Объект.ДатаЗакрытия);
	
	УстановитьДоступностьКнопок();

	//Внешние подклчюаемые команды
	CW_ПодключаемыеКомандыСервер.ПриСозданииНаСервере(ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьДоступностьКнопок()
	
	Элементы.ПолучитьОстатокТоплива.Доступность 	= Не ТолькоПросмотр;
	Элементы.ПолучитьДанныеОдометра.Доступность 	= Не ТолькоПросмотр;
	Элементы.КомандаВозвращениеПланФакт.Доступность = Не ТолькоПросмотр;
	Элементы.КомандаВыездПланФакт.Доступность 		= Не ТолькоПросмотр;
	
	Элементы.КомандаРаспределитьТоплитвоПоГрузоперевозкам.Доступность 	= Не ТолькоПросмотр;
	Элементы.КомандаПересчитатьНормативныйРасход.Доступность 			= Не ТолькоПросмотр;
	Элементы.ЭтапыМаршрутаКомандаПодборИзЖурнала.Доступность 			= Не ТолькоПросмотр;
	Элементы.ЭтапыМаршрутаКомандаЗаполнитьЭтапы.Доступность 			= Не ТолькоПросмотр;
	Элементы.УдалитьСоответствие.Доступность 							= Не ТолькоПросмотр;
	Элементы.СгенерироватьАналиткуЗатрат.Доступность 					= Не ТолькоПросмотр;
	Элементы.ДобавитьДокументЗаправки.Доступность 						= Не ТолькоПросмотр;
	Элементы.ОтражениеРасходовСверхНормативаКомандаЗаполнитьОтражениеВПределахПогрешности.Доступность	= Не ТолькоПросмотр;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокСведенийОПеревозках()
	
	МассивЗначений = Документы.CW_ПутевойЛист.ПолучитьСписокСведенийОперевозках();
	
	Если МассивЗначений.Количество() Тогда
		Элементы.СведенияОПеревозке.СписокВыбора.ЗагрузитьЗначения(МассивЗначений);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ОбновитьДанныеРегистрационныхЗнаков()
	
	Если ЗначениеЗаполнено(Объект.ТранспортноеСредство) Тогда
		ТранспортноеСредствоРегистрационныйЗнак = РегистрыСведений.CW_РегистрацонныеЗнакиАвтомобилей.ПолучитьПредставлениеГосНомераТранспортногоСредства(Объект.Дата, Объект.ТранспортноеСредство);
	Иначе
		ТранспортноеСредствоРегистрационныйЗнак = "";
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.Прицеп) Тогда
		ПрицепРегистрационныйЗнак = РегистрыСведений.CW_РегистрацонныеЗнакиАвтомобилей.ПолучитьПредставлениеГосНомераТранспортногоСредства(Объект.Дата, Объект.Прицеп);
	Иначе
		ПрицепРегистрационныйЗнак 	= "";
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	ПодготовитьДанныеФормы();

КонецПроцедуры

&НаСервере
Процедура ПодготовитьДанныеФормы()
	
	ЗаполнитьДобавленныеКолонкиТаблиц("ЭтапыМаршрута");
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДобавленныеКолонкиТаблиц(ИмяТабличнойЧасти)
	
	МассивГрузоперевозок 	= Объект[ИмяТабличнойЧасти].Выгрузить().ВыгрузитьКолонку("Грузоперевозка");
	СвойстваГрузоперевозок 	= CW_Грузоперевозки_Сервер.ПолучитьСведенияПоГрузоперевозкам(МассивГрузоперевозок);

	Для каждого СтрокаДокумента Из Объект[ИмяТабличнойЧасти] Цикл

		СтруктураСвойств = СвойстваГрузоперевозок.Получить(СтрокаДокумента.Грузоперевозка);
		
		Если СтруктураСвойств <> Неопределено Тогда
			 СтруктураСвойств.Свойство("ПометкаУдаления",СтрокаДокумента.ГрузоперевозкаУдалена);
		Конецесли;
		
	КонецЦикла;
	
КонецПроцедуры


&НаСервере
Процедура ОбновитьДанныеДляРасчетаПогрешности()
	
	Если ЗначениеЗаполнено(Объект.ТранспортноеСредство) Тогда
		
		// при определении даты среза плановую дату не используем, так как она может быть меньше фактической
		ДатаСреза 					= Макс(Объект.Дата, Объект.ВозвращениеФакт);
		СсылкаТранспортноеСредство 	=  Объект.ТранспортноеСредство;
		СсылкаМодель 				=  Объект.ТранспортноеСредство.Модель;

		мПоказатели = Новый массив;
		мПоказатели.Добавить(Справочники.CW_ПоказателиРасчетаРасходаТоплива.ПогрешностьИзмеренияОстаткаТоплива);
		
		ЗначенияПоказателей	= новый Соответствие;
		
		тОбъект = РеквизитФормыВЗначение("Объект");
		
		тОбъект.ПолучитьЗначенияПоказателей(ДатаСреза, ЗначенияПоказателей , СсылкаТранспортноеСредство, мПоказатели);
		
		времПогрешностьРасчета = ЗначенияПоказателей.Получить(Справочники.CW_ПоказателиРасчетаРасходаТоплива.ПогрешностьИзмеренияОстаткаТоплива);
		
		Если времПогрешностьРасчета = Неопределено Тогда
			тОбъект.ПолучитьЗначенияПоказателей(ДатаСреза, ЗначенияПоказателей , СсылкаМодель, мПоказатели);
			времПогрешностьРасчета = ЗначенияПоказателей.Получить(Справочники.CW_ПоказателиРасчетаРасходаТоплива.ПогрешностьИзмеренияОстаткаТоплива);
		КонецЕсли;
		
		ИспользуетсяПогрешностьРасчета 	= НЕ времПогрешностьРасчета = Неопределено;
		ПогрешностьРасчета 				= ?(ЗначениеЗаполнено(времПогрешностьРасчета), времПогрешностьРасчета, 0);
		
	КонецЕсли;
	
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьЭлементовФормы()	
	
	Элементы.СтраницаДополнительноеОборудование.Видимость 			= ИспользуетсяДополнительноеОборудование;
	
	Элементы.ГруппаПрименениеНормативов.Видимость 					= ПрименяютсяНормативыРасходаТоплива;
	
	Элементы.ПриравнятьФактическийРасходКНормативному.Видимость 	= Объект.РассчитыватьНормативныйРасходТоплива; 
	
	Элементы.ГруппаПорядокОтраженияРасходаСверхНорматива.Видимость 	= ПрименяютсяНормативыРасходаТоплива и Объект.РассчитыватьНормативныйРасходТоплива и  Не Объект.ПриравнятьФактическийРасходКНормативному;
	Элементы.Группа4.Видимость 										= ПрименяютсяНормативыРасходаТоплива и Объект.РассчитыватьНормативныйРасходТоплива;
	Элементы.ЭтапыМаршрутаИтогРасходНорма.Видимость					= ПрименяютсяНормативыРасходаТоплива и Объект.РассчитыватьНормативныйРасходТоплива;

	Элементы.КомандаПересчитатьНормативныйРасход.Видимость 				= ПрименяютсяНормативыРасходаТоплива и Объект.РассчитыватьНормативныйРасходТоплива;
	Элементы.КомандаРаспределитьТоплитвоПоГрузоперевозкам.Видимость 	= Не (ПрименяютсяНормативыРасходаТоплива  и Объект.РассчитыватьНормативныйРасходТоплива);
	
	Элементы.ПробегПриВозвращении.Доступность 			= ЗначениеЗаполнено(Объект.ВозвращениеФакт);
	Элементы.ОстатокТопливаПриВозвращении.Доступность 	= ЗначениеЗаполнено(Объект.ВозвращениеФакт);
	
	
	Элементы.ГруппаИтогиПробегаСгрузом.Видимость 		= УчитыватьПробегТранспортногоСредстваСГрузом;
	Элементы.ЭтапыМаршрутаПробегПорожний.Доступность 	= ВводитьДанныеОПорожнемПробегеВДокументах;
	Элементы.ЭтапыМаршрутаПробег.Доступность 			= Не ВводитьДанныеОПорожнемПробегеВДокументах;
	
	ПоказатьНадписьНеобходимстиПересчетаРасходаТоплива() ;
	
	Элементы.ОтражениеРасходовСверхНормативаКомандаЗаполнитьОтражениеВПределахПогрешности.Доступность = ИспользуетсяПогрешностьРасчета и УчитыватьПогрешностьИзмеренияОстаткаТоплива;
	
	Элементы.ГруппаПробегТС.Видимость = ЗначениеЗаполнено(Объект.ВозвращениеФакт);
	Элементы.ГруппаРасходТС.Видимость = ЗначениеЗаполнено(Объект.ВозвращениеФакт);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьЗаголовкиСвертываемыхГрупп()
	
	СтрокОтражения = Объект.ОтражениеРасходовСверхНорматива.Количество();
	
	ЗаголовокПорядокОтраженияРасходаСверхНорматива = "Отражение расхода сверх норматива ("+Формат(СтрокОтражения,"ЧН=0; ЧГ=0")+ " строк)";
	
	Элементы.ГруппаПорядокОтраженияРасходаСверхНорматива.ЗаголовокСвернутогоОтображения = ЗаголовокПорядокОтраженияРасходаСверхНорматива;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьФункциональныеОпцииДокумента()
	
	ПараметрыОпции = Новый Структура;
	ПараметрыОпции.Вставить("CW_ГруппаПользователя", CW_ПраваДоступа_ПИ.ГруппаПользователя(ПараметрыСеанса.ТекущийПользователь));
	
	УстановитьПараметрыФункциональныхОпцийФормы(ПараметрыОпции);
	
	УчитыватьПробегТранспортногоСредстваСГрузом = ПолучитьФункциональнуюОпцию("CW_УчитыватьПробегТранспортногоСредстваСГрузом");
	ВводитьДанныеОПорожнемПробегеВДокументах 	= ПолучитьФункциональнуюОпцию("CW_ВводитьДанныеОПорожнемПробегеВДокументах");	
	ПрименяютсяНормативыРасходаТоплива 			= ПолучитьФункциональнуюОпцию("CW_ПрименяютсяНормативыРасходаТоплива");	
	ИспользуетсяДополнительноеОборудование 	 	= ПолучитьФункциональнуюОпцию("CW_ИспользуетсяДополнительноеОборудованиеТранспортныхСредств");
	ИспользованиеЗаказов  						= ПолучитьФункциональнуюОпцию("CW_ИспользованиеЗаказов");
	ИспользуютсяПоказателиТранспортногоСредства = ПолучитьФункциональнуюОпцию("CW_ИспользуютсяПоказателиТранспортногоСредстваОтдельноОтМодели");
	УчитыватьПогрешностьИзмеренияОстаткаТоплива = ПолучитьФункциональнуюОпцию("CW_УчитыватьПогрешностьИзмеренияОстаткаТоплива");
	
	ДоступноЗакрытиеПутевыхЛистов = ПолучитьФункциональнуюОпцию("CW_ЗакрытиеПутевыхЛистов", ПараметрыОпции);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ВыделитьЦветомОтклонениеПробега();
	
	
КонецПроцедуры

&НаСервере
Процедура _ВосстановитьСеансовуюНастройку()
	
	// пытаемся восстановить настройки
	Идентификатор = РеквизитФормыВЗначение("Объект").Метаданные().Имя;
	СеансоваяНастройка = ХранилищеСистемныхНастроек.Загрузить(Идентификатор, "Сеансовая");
	Если СеансоваяНастройка <> Неопределено Тогда
		Попытка
			СеансоваяНастройка.Свойство("ПоказатьПростоиЭтапа", ПоказатьПростоиЭтапа);
		Исключение
		КонецПопытки; 
	КонецЕсли; 
	
КонецПроцедуры

&НаСервере
Процедура _СохранитьСеансовуюНастройку()
	
	СтруктураНастройки = Новый Структура();
	СтруктураНастройки.Вставить("ПоказатьПростоиЭтапа", ПоказатьПростоиЭтапа);
	
	Идентификатор = РеквизитФормыВЗначение("Объект").Метаданные().Имя;
	ХранилищеСистемныхНастроек.Сохранить(Идентификатор, "Сеансовая", СтруктураНастройки);
	
КонецПроцедуры

// ---------------------------------------------------------------------------- 

&НаКлиенте
Процедура ПолучитьДанныеСпидометра(Команда)
	
	_ОбновитьДанныеОдометра();
	РассчиатьПробегПоОдометру();
	
КонецПроцедуры
 
&НаСервере
Процедура _ОбновитьДанныеОдометра()
	// --- 
	
	ДатаПоказаний = Объект.Дата;
	Если (ЗначениеЗаполнено(Объект.ВыездПлан)) Тогда
		
		Если (Объект.ВыездПлан > ДатаПоказаний) Тогда
			
			ДатаПоказаний = Объект.ВыездПлан;
			
		КонецЕсли; 
		
	КонецЕсли; 
	// --- 
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	CW_ПоказанияОдометровТранспортныхСредствСрезПоследних.Пробег КАК Пробег,
	               |	CW_ПоказанияОдометровТранспортныхСредствСрезПоследних.ТранспортноеСредство КАК ТранспортноеСредство
	               |ИЗ
	               |	РегистрСведений.CW_ПоказанияОдометровТранспортныхСредств.СрезПоследних(&Период, ТранспортноеСредство = &ТранспортноеСредство) КАК CW_ПоказанияОдометровТранспортныхСредствСрезПоследних";
	
	Запрос.УстановитьПараметр("Период", ДатаПоказаний);
	Запрос.УстановитьПараметр("ТранспортноеСредство", Объект.ТранспортноеСредство);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если Не РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		
		Объект.ПробегПриВыезде = Выборка.Пробег;
	Иначе
		
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Даные пробега на дату выезда не обнаружены!";
		Сообщение.Сообщить();
		
	КонецЕсли;
	
КонецПроцедуры

// ---------------------------------------------------------------------------- 

&НаКлиенте
Процедура ПолучитьОстатокТоплива(Команда)
	
	ПолучитьОстатокТопливаНаСервере();
	_ПересчитатьРасходТоплива();
	
КонецПроцедуры

&НаСервере
Процедура ПолучитьОстатокТопливаНаСервере()
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	СУММА(CW_ТопливоТСОстатки.КоличествоОстаток) КАК Количество
	               |ИЗ
	               |	РегистрНакопления.CW_ТопливоТС.Остатки(
	               |			,
	               |			ТранспортноеСредство = &ТранспортноеСредство
	               |				И Топливо = &Топливо) КАК CW_ТопливоТСОстатки";
	
	Запрос.УстановитьПараметр("ТранспортноеСредство", Объект.ТранспортноеСредство);
	Запрос.УстановитьПараметр("Топливо"				, Объект.Топливо);
	// --- 
	РезультатЗапроса = Запрос.Выполнить();
	
	Если не РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		
		Объект.ОстатокТопливаПриВыезде = Выборка.Количество;
	КонецЕсли;
	
КонецПроцедуры

// ---------------------------------------------------------------------------- 

&НаСервере
Процедура _ПересчитатьРасходТоплива()
	
	ВсегоЗаправлено 			= Объект.Заправки.Итог("Количество");
	ВсегоПробег 				= Объект.ПробегПриВозвращении -Объект.ПробегПриВыезде ;
	
	Объект.РасходТоплива 		= (Объект.ОстатокТопливаПриВыезде - Объект.ОстатокТопливаПриВозвращении) + ВсегоЗаправлено;
	Объект.СреднийРасходТоплива = _сф.БезопасноРазделить(Объект.РасходТоплива, ВсегоПробег) * 100;
	
	РассчитатьОтклонение();
	РассчитатьОстатокРаспределения();
	
	ПоказатьНадписьНеобходимстиПересчетаРасходаТоплива();
	
	УстановитьЦветФонаРасходаТоплива();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьЦветФонаРасходаТоплива()
	
	Элементы.РасходТоплива.ЦветФона 		= ?(Объект.РасходТоплива < 0		, ЦветаСтиля.КритичноеСобытиеНадежностьБанковЦветФона , ЦветаСтиля.ЦветФонаПодсказки);
	Элементы.СреднийРасходТоплива.ЦветФона 	= ?(Объект.СреднийРасходТоплива < 0	, ЦветаСтиля.КритичноеСобытиеНадежностьБанковЦветФона, ЦветаСтиля.ЦветФонаПодсказки);
	
КонецПроцедуры

&НаСервере
Процедура ПоказатьНадписьНеобходимстиПересчетаРасходаТоплива()
	
	Элементы.НадписьПересчетаРаспределения.Видимость 		= НеобходимоПересчитатьНормативныйРасход и Не (ПрименяютсяНормативыРасходаТоплива	и Объект.РассчитыватьНормативныйРасходТоплива);
	Элементы.НадписьНеобходимостьРасчетаТоплива.Видимость 	= НеобходимоПересчитатьНормативныйРасход и ПрименяютсяНормативыРасходаТоплива 		и Объект.РассчитыватьНормативныйРасходТоплива;
	
	Элементы.КартинкаПредупреждение.Видимость				= НеобходимоПересчитатьНормативныйРасход;	
	
КонецПроцедуры


