	ОткрытьФорму("Документ.CW_ПутевойЛист.Форма.ФормаВариантПодстановкиДаты", ПараметрыФормыПодстановки, ЭтаФорма,,,,ОписаниеОповещения);
	
	////Объект.ДатаЗакрытия = Объект.ВозвращениеФакт; //Удалено заявка AF8/3235
	//Объект.ДатаЗакрытия = ТекущаяДата(); //Заявка AF8/3235

	
