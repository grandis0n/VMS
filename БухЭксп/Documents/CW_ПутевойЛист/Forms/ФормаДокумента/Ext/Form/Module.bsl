&НаКлиенте
Процедура КомандаЗаполнитьЭтапы(Команда)
	
	Если Объект.ЭтапыМаршрута.Количество() > 0 Тогда
		
		Режим = РежимДиалогаВопрос.ДаНет;
		Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаОбОчисткеМаршуртов", ЭтаФорма, Параметры);
		
		ПоказатьВопрос(Оповещение, "Табличная часть будет очищена. Продолжить?", Режим, 0);
		
	Иначе
		
		ПараметрыОтбора = Новый Структура;
		ПараметрыОтбора.Вставить("Тягач"	, Объект.ТранспортноеСредство);
		ПараметрыОтбора.Вставить("Прицеп"	, Объект.Прицеп);
		ПараметрыОтбора.Вставить("Водитель"	, Объект.Водитель);
		
		ПараметрыФормы 	= Новый Структура("ПараметрыОтбора",ПараметрыОтбора);	
		Оповещение 		= Новый ОписаниеОповещения("ОбработкаЗаполненияЭтапов",ЭтотОбъект, Новый Структура()); 
		
		ОткрытьФорму("Документ.CW_ПутевойЛист.Форма.ФормаПодбораГрузоперевозок",ПараметрыФормы,ЭтаФорма,,,,Оповещение,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияВопросаОбОчисткеМаршуртов(Результат, Параметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("Тягач"	, Объект.ТранспортноеСредство);
	ПараметрыОтбора.Вставить("Прицеп"	, Объект.Прицеп);
	ПараметрыОтбора.Вставить("Водитель"	, Объект.Водитель);
	
	ПараметрыФормы 	= Новый Структура("ПараметрыОтбора",ПараметрыОтбора);	
	Оповещение 		= Новый ОписаниеОповещения("ОбработкаЗаполненияЭтапов",ЭтотОбъект, Новый Структура()); 
	
	ОткрытьФорму("Документ.CW_ПутевойЛист.Форма.ФормаПодбораГрузоперевозок",ПараметрыФормы,ЭтаФорма,,,,Оповещение,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаЗаполненияЭтапов(Ответ, ДополнительныеПараметры) Экспорт 
	// --- 
	
	Если (Ответ <> Неопределено) Тогда
		
		Если (_УФКС.ВыполненоУспешно(Ответ)) Тогда
			
			_ЗаполнитьЭтапыПоГрузоперевозкамНовая(Ответ.Грузоперевозки);
			
		Иначе
			
			Сообщить(_УФКС.ПредставлениеОшибки(Ответ));
			
		КонецЕсли; 
		
	КонецЕсли; 
	
	// --- 
КонецПроцедуры

&НаСервере
Процедура _ЗаполнитьЭтапыПоГрузоперевозкамНовая(МассивГрузоперевозок, ОчиститьМаршруты = истина)
	
	Если ОчиститьМаршруты Тогда
		
		Объект.ЭтапыМаршрута.Очистить();
		
	КонецЕсли;

	РезультатЗапроса = ПолучитьЗаполняемыеПараметрыПоГрузопереовзке(МассивГрузоперевозок);	
	
	Выборка_Грузопереовозки = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Для каждого ГрузоперевозкаИзМассива Из МассивГрузоперевозок Цикл
		
		НоваяСтрока = Объект.ЭтапыМаршрута.Добавить();
		
		НоваяСтрока.ИдентификаторСтроки 	= НоваяСтрока.ПолучитьИдентификатор();
		НоваяСтрока.Грузоперевозка 			= ГрузоперевозкаИзМассива;
		НоваяСтрока.КоличествоЕздок			= 1;
		НоваяСтрока.Груз 					= ГрузоперевозкаИзМассива.Груз;
		
		НоваяСтрока.ТранспортноеСредство	= Объект.ТранспортноеСредство;
		НоваяСтрока.Водитель 				= Объект.Водитель;
		
		//Заполнение параметров
		Выборка_Грузопереовозки.Сбросить();
		Если Выборка_Грузопереовозки.НайтиСледующий(новый Структура("Грузопереовзка",ГрузоперевозкаИзМассива)) Тогда
		
			ВыборкаПараметры = Выборка_Грузопереовозки.Выбрать();
			
			Пока ВыборкаПараметры.Следующий() Цикл
				РеквизитПутевогоЛиста 	= ВыборкаПараметры.РеквизитПутевогоЛиста.Метаданные().ЗначенияПеречисления[Перечисления.CW_РеквизитыПутевыхЛистов.Индекс(ВыборкаПараметры.РеквизитПутевогоЛиста)].Имя;
				Параметр 				= ВыборкаПараметры.ПараметрГрузоперевозки;
				
				ИмяРеквизита = СтрЗаменить(РеквизитПутевогоЛиста,"ЭтапыМаршрута_","");
				
				СтрокаПараметра = CW_Мониторинг.СтрокаПараметра(ГрузоперевозкаИзМассива, ВыборкаПараметры.ПараметрГрузоперевозки);
				Если (СтрокаПараметра <> Неопределено) Тогда
					Попытка
						НоваяСтрока[ИмяРеквизита] = СтрокаПараметра.Значение;
					Исключение
					КонецПопытки;
				КонецЕсли;
				
			КонецЦикла;
		
		КонецЕсли;
		
	КонецЦикла; 
	
КонецПроцедуры

Функция ПолучитьЗаполняемыеПараметрыПоГрузопереовзке(МассивГрузоперевозок)
	
	Запрос = новый Запрос;
	запрос.Текст = "ВЫБРАТЬ
	               |	CW_Грузоперевозки.Ссылка КАК Ссылка,
	               |	CW_Грузоперевозки.ТипПеревозки КАК ТипПеревозки
	               |ПОМЕСТИТЬ ВТ_ТипыГрузоперевозок
	               |ИЗ
	               |	Справочник.CW_Грузоперевозки КАК CW_Грузоперевозки
	               |ГДЕ
	               |	CW_Грузоперевозки.Ссылка В(&МассивГрузоперевозок)
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	CW_Грузоперевозки.ТипПеревозки,
	               |	CW_Грузоперевозки.Ссылка
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ_ТипыГрузоперевозок.Ссылка КАК Грузопереовзка,
	               |	CW_ТипыПеревозокПараметрыПутевыхЛистов.РеквизитПутевогоЛиста КАК РеквизитПутевогоЛиста,
	               |	CW_ТипыПеревозокПараметрыПутевыхЛистов.Параметр КАК ПараметрГрузоперевозки
	               |ИЗ
	               |	ВТ_ТипыГрузоперевозок КАК ВТ_ТипыГрузоперевозок
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.CW_ТипыПеревозок.ПараметрыПутевыхЛистов КАК CW_ТипыПеревозокПараметрыПутевыхЛистов
	               |		ПО ВТ_ТипыГрузоперевозок.ТипПеревозки = CW_ТипыПеревозокПараметрыПутевыхЛистов.Ссылка
	               |ГДЕ
	               |	CW_ТипыПеревозокПараметрыПутевыхЛистов.Ссылка В
	               |			(ВЫБРАТЬ
	               |				ВТ_ТипыГрузоперевозок.ТипПеревозки КАК ТипПеревозки
	               |			ИЗ
	               |				ВТ_ТипыГрузоперевозок КАК ВТ_ТипыГрузоперевозок)
	               |	И CW_ТипыПеревозокПараметрыПутевыхЛистов.ЧитатьИзГрузоперевозки
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	CW_ТипыПеревозокПараметрыПутевыхЛистов.РеквизитПутевогоЛиста,
	               |	CW_ТипыПеревозокПараметрыПутевыхЛистов.Параметр,
	               |	ВТ_ТипыГрузоперевозок.Ссылка
	               |ИТОГИ ПО
	               |	Грузопереовзка";
	
	Запрос.УстановитьПараметр("МассивГрузоперевозок", МассивГрузоперевозок); 
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат РезультатЗапроса;
	
КонецФункции

