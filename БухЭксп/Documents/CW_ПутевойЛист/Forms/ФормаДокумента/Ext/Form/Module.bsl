&НаКлиенте
Процедура ВыбратьОтветственноеЛицо(Реквизит)
	// --- 
	
	Роль = Неопределено;
	// --- 
	Если (Реквизит = "Сопровождающий" ИЛИ Реквизит = "СопровождающийДополнительный") Тогда
		
		РольСотрудника = ПредопределенноеЗначение("Справочник.CW_РолиСотрудников.СопровождающееЛицо");
		
	ИначеЕсли (Реквизит = "Медработник" ИЛИ Реквизит = "МедработникВозвращение") Тогда 
		
		РольСотрудника = ПредопределенноеЗначение("Справочник.CW_РолиСотрудников.Врач");
		
	ИначеЕсли (Реквизит = "Диспетчер_Выезд" ИЛИ Реквизит = "Диспетчер_Возвращение") Тогда 
		
		РольСотрудника = ПредопределенноеЗначение("Справочник.CW_РолиСотрудников.Диспетчер");
		
	ИначеЕсли (Реквизит = "Механик_Выезд" ИЛИ Реквизит = "Механик_Возвращение") Тогда 
		
		РольСотрудника = ПредопределенноеЗначение("Справочник.CW_РолиСотрудников.Механик");
		
	КонецЕсли; 
	// --- 
	СтруктураПараметровФормы = новый Структура;
	СтруктураПараметровФормы.Вставить("РольСотрудника"				, РольСотрудника);
	СтруктураПараметровФормы.Вставить("Организация"					, Объект.Организация);
	СтруктураПараметровФормы.Вставить("ОтборПоОрганизации"			,  ЗначениеЗаполнено(Объект.Организация));
	СтруктураПараметровФормы.Вставить("ВозможностьСоздаватьЗаписи"	, Ложь);
	СтруктураПараметровФормы.Вставить("РежимВыбора"					, истина);

	ДополнительныеПараметры = Новый Структура("Реквизит", Реквизит);
	// --- 
	ОписаниеОповещения = Новый ОписаниеОповещения("ОбработкаВыбораОтветственногоЛица",ЭтотОбъект, ДополнительныеПараметры);
	ОткрытьФорму("ОбщаяФорма.CW_ФормаВыбораСотрудникаДляРоли",СтруктураПараметровФормы,,,,,ОписаниеОповещения,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

	// --- 
КонецПроцедуры



