&НаСервере
Процедура РаспределитьФактическийРасходТоплива()
	
	//Распределение выполянем пропоционально пробегу!
	БазаРаспределения = Объект.ЭтапыМаршрута.Итог("Пробег");
	
	Если БазаРаспределения = 0 Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Не удалось распределить топливо по грузопереовзкам. Отсутствуют данные пробега по грузоперевозкам!";
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;
	
	РасходТоплива  		= Объект.РасходТоплива;
	НужноРаспределить 	= РасходТоплива;
	
	//Для Каждого СтрокаЭтапа из Объект.ЭтапыМаршрута Цикл
	//	
	//	Если НужноРаспределить > 0 Тогда
	//		
	//		Коэффициент =  СтрокаЭтапа.Пробег / БазаРаспределения;
	//		
	//		КоличествоПоСтроке 		=  Окр(РасходТоплива * Коэффициент, 3);
	//		СтрокаЭтапа.РасходНорма	= КоличествоПоСтроке;
	//		СтрокаЭтапа.РасходФакт 	= КоличествоПоСтроке;
	//		
	//		НужноРаспределить = НужноРаспределить - КоличествоПоСтроке;
	//		
	//	КонецЕсли;
	//	
	//КонецЦикла;
	//
	//Если НужноРаспределить <> 0 Тогда
	//	//Погрешностьот округаления на последнюю строку
	//	СтрокаЭтапа.РасходНорма = СтрокаЭтапа.РасходНорма + НужноРаспределить;
	//	СтрокаЭтапа.РасходФакт 	= СтрокаЭтапа.РасходФакт + НужноРаспределить;
	//КонецЕсли;
	
	//
	Для Каждого СтрокаЭтапа из Объект.ЭтапыМаршрута Цикл
		
		Если НужноРаспределить > 0 Тогда
			
			Коэффициент =  СтрокаЭтапа.Пробег / БазаРаспределения;
			
			Если СтрокаЭтапа.НомерСтроки = Объект.ЭтапыМаршрута.Количество() Тогда
				СтрокаЭтапа.РасходНорма = НужноРаспределить;
				СтрокаЭтапа.РасходФакт  = НужноРаспределить;
				НужноРаспределить = 0;
			Иначе
				КоличествоПоСтроке   	=  Окр(РасходТоплива * Коэффициент, 3);
				СтрокаЭтапа.РасходНорма = КоличествоПоСтроке;
				СтрокаЭтапа.РасходФакт  = КоличествоПоСтроке;
				НужноРаспределить 		= НужноРаспределить - КоличествоПоСтроке;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	//
	
	
	ПоказатьНадписьНеобходимстиПересчетаРасходаТоплива();
	
КонецПроцедуры

