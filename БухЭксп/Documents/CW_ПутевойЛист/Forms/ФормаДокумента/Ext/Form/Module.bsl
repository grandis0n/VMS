&НаСервере
Процедура РасчитатьПробегПоСтроке(ИдентификаторСтроки)
	
	ТекущаяСтрока = Объект.ЭтапыМаршрута.НайтиПоИдентификатору(ИдентификаторСтроки);
	
	Если ВводитьДанныеОПорожнемПробегеВДокументах Тогда
		ТекущаяСтрока.Пробег 			=  ТекущаяСтрока.ПробегСГрузом + ТекущаяСтрока.ПробегПорожний;
	Иначе
		ТекущаяСтрока.ПробегПорожний 	=  ТекущаяСтрока.Пробег - ТекущаяСтрока.ПробегСГрузом;
	КонецЕсли;
	РассчиатьПробегПоОдометру();	
	
КонецПроцедуры

&НаКлиенте
Процедура ЭтапыМаршрутаПробегПорожнийПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ЭтапыМаршрута.ТекущиеДанные;
	РасчитатьПробегПоСтроке(ТекущиеДанные.ПолучитьИдентификатор());
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаЗаполнитьОтражениеВПределахПогрешности(Команда)
	
	Если Объект.ОтражениеРасходовСверхНорматива.Количество() > 0 Тогда
		Режим = РежимДиалогаВопрос.ДаНет;
		Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаОбОчисткеОтраженияРасходов", ЭтаФорма, Параметры);
		ПоказатьВопрос(Оповещение, "Табличная часть будет очищена. Продолжить?", Режим, 0); 
	Иначе
		ЗаполнитьданныеПерерасхродаНаСервере();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияВопросаОбОчисткеОтраженияРасходов(Результат, Параметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Нет Тогда
        Возврат;
    КонецЕсли;

	Объект.ОтражениеРасходовСверхНорматива.Очистить();
	ЗаполнитьданныеПерерасхродаНаСервере();

КонецПроцедуры

&НаСервере
Процедура  ЗаполнитьДанныеПерерасхродаНаСервере()
	
	//Подготовка данных к расчету
	ОстатокТоплива 		= Объект.ОстатокТопливаПриВозвращении;
	Перерасход 			= РасходОтклонение;
	ПогрешностьЛитры 	= ОстатокТоплива * ПогрешностьРасчета/100;
	
	ПерерасходВпределахПогрешности = Мин(ПогрешностьЛитры,Перерасход);
	
	Если ПерерасходВпределахПогрешности > 0 тогда
		
		НоваяСтрока = Объект.ОтражениеРасходовСверхНорматива.Добавить();
		НоваяСтрока.ВариантОтраженияЗатратПоБУ = ПорядокОтраженияЗатратВПеделахПогрешности;
		НоваяСтрока.Количество = ПерерасходВпределахПогрешности;
			
	КонецЕсли;
	
	РассчитатьОстатокРаспределения();
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	Если ЗначениеЗаполнено(Объект.ДатаЗакрытия) Тогда
		
		Если Объект.ДатаЗакрытия < Объект.Дата Тогда
			Сообщение = новый СообщениеПользователю;
			Сообщение.Текст 		= "Дата закрытия не может быть меньше даты документа!";
			Сообщение.Поле			= "ДатаЗакрытия";
			Сообщение.ПутьКДанным	= "Объект";
			Сообщение.Сообщить();
			Отказ = истина;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(Объект.Топливо) Тогда
			Сообщение = новый СообщениеПользователю;
			Сообщение.Текст 		= "Не указано топливо";
			Сообщение.Поле			= "Топливо";
			Сообщение.ПутьКДанным	= "Объект";
			Сообщение.Сообщить();
			Отказ = истина;
		Конецесли;
		
		Если Не ЗначениеЗаполнено(Объект.АналитикаЗатрат) Тогда
			Сообщение = новый СообщениеПользователю;
			Сообщение.Текст 		= "Не указана Аналитика затрат";
			Сообщение.Поле 			= "АналитикаЗатрат";
			Сообщение.ПутьКДанным	= "Объект";
			Сообщение.Сообщить();
			Отказ = истина;
		Конецесли;
		
		Если ОсталосьРаспределить <> 0 Тогда
			Сообщение = новый СообщениеПользователю;
			Сообщение.Текст 		= "Есть нераспределенный остаток перерасхода топлива!";
			Сообщение.Поле 			= "ОсталосьРаспределить";
			Сообщение.ПутьКДанным	= "ЭтаФорма";
			Сообщение.Сообщить();
			Отказ = истина;
			
		Конецесли;

	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.ВозвращениеФакт) тогда
		
		Если Объект.ВозвращениеФакт <= Объект.ВыездФакт тогда
			Сообщение = новый СообщениеПользователю;
			Сообщение.Текст 		= "Не правильно указана дата фактического возвращения!";
			Сообщение.Поле 			= "ВозвращениеФакт";
			Сообщение.ПутьКДанным	= "Объект";
			Сообщение.Сообщить();
			Отказ = истина;
		Конецесли;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.ВозвращениеПлан) тогда
		
		Если Объект.ВозвращениеПлан <= Объект.ВыездПлан тогда
			Сообщение = новый СообщениеПользователю;
			Сообщение.Текст 		= "Не правильно указана дата планового возвращения!";
			Сообщение.Поле			= "ВозвращениеПлан";
			Сообщение.ПутьКДанным	= "Объект";
			Сообщение.Сообщить();
			Отказ = истина;
		Конецесли;
		
	КонецЕсли;
	
	Если Объект.РасходТоплива < 0 Тогда
		Сообщение = новый СообщениеПользователю;
		Сообщение.Текст = "Некорректно указанны данные расхода топлива!";
		Сообщение.Поле 			= "РасходТоплива";
		Сообщение.ПутьКДанным	= "Объект";
		Сообщение.Сообщить();             
		Отказ = истина;
	КонецЕсли;
	
	//провека табличной части "Этапы маршрутов"
	Для ИндексСтроки = 0 По Объект.ЭтапыМаршрута.Количество()-1 Цикл
		СтрокаЭтапа = Объект.ЭтапыМаршрута[ИндексСтроки];
		Если ЗначениеЗаполнено(СтрокаЭтапа.ДатаВозвращения) Тогда
			Если СтрокаЭтапа.ДатаВозвращения <=  СтрокаЭтапа.ДатаВыезда Тогда
				Сообщение = новый СообщениеПользователю;
				Сообщение.Текст 		= "Не правильно указана дата возвращения в строке "+Формат(ИндексСтроки+1,"ЧГ=0");
				Сообщение.Поле 			= "ЭтапыМаршрута["+Формат(ИндексСтроки,"ЧГ=0")+"].ДатаВозвращения";
				Сообщение.ПутьКДанным	= "Объект";
				Сообщение.Сообщить();
				Отказ = истина;
			КонецЕсли;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрокаЭтапа.ДатаРазгрузки) Тогда
			Если СтрокаЭтапа.ДатаРазгрузки <=  СтрокаЭтапа.ДатаПогрузки Тогда
				Сообщение = новый СообщениеПользователю;
				Сообщение.Текст 		= "Не правильно указана дата разгрузки в строке "+Формат(ИндексСтроки+1,"ЧГ=0");
				Сообщение.Поле 			= "ЭтапыМаршрута["+Формат(ИндексСтроки,"ЧГ=0")+"].ДатаРазгрузки";
				Сообщение.ПутьКДанным	= "Объект";
				Сообщение.Сообщить();
				Отказ = истина;
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПрицепПриИзменении(Элемент)
	
	ОчиститьДанныеПробегаБезПицепа();
	ОбновитьДанныеРегистрационныхЗнаков();

КонецПроцедуры

&наСервере
Процедура ОчиститьДанныеПробегаБезПицепа()
	
	Если Не ЗначениеЗаполнено(Объект.Прицеп) Тогда
		
		
		ЕстьИзменения = Ложь;
		
		Для каждого СтрокаМаршрута из Объект.ЭтапыМаршрута Цикл
			
			Если СтрокаМаршрута.ПробегБезПрицепа <> 0 тогда
				
				СтрокаМаршрута.ПробегБезПрицепа = 0;
				ЕстьИзменения 					= Истина;
				
			КонецЕсли;
			
		КонецЦикла;   
		
		Если ЕстьИзменения Тогда
			НеобходимоПересчитатьНормативныйРасход = Истина;
			ПоказатьНадписьНеобходимстиПересчетаРасходаТоплива();
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры


&НаКлиенте
Процедура ЭтапыМаршрутаПробегБезПрицепаПриИзменении(Элемент)
	
	НеобходимоПересчитатьНормативныйРасход = Истина;
	ПоказатьНадписьНеобходимстиПересчетаРасходаТоплива();
			
КонецПроцедуры

&НаСервере
Функция ПолучитьДатуСреза()
	
	ДатаВыездаВозвращения = Макс(Объект.ВозвращениеФакт, Объект.ВыездФакт);
	
	Возврат ?(ЗначениеЗаполнено(ДатаВыездаВозвращения), ДатаВыездаВозвращения, Объект.Дата);
	
КонецФункции

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "ВыполнитьМетодВладельца" Тогда
		
		Если ТипЗнч(Параметр) = тип("Структура") Тогда
			УникальныйИдентификаторВладельца 	= Неопределено;
			МетодыФормыВладельца 				= Неопределено;
			
			Параметр.Свойство("УникальныйИдентификатор"	, УникальныйИдентификаторВладельца);
			Параметр.Свойство("МетодыФормыВладельца"	, МетодыФормыВладельца);
			
			Если ЭтаФорма.УникальныйИдентификатор = УникальныйИдентификаторВладельца Тогда
				Если Не МетодыФормыВладельца = Неопределено и ТипЗнч(МетодыФормыВладельца) = Тип("Массив") Тогда
					
					Для Каждого СтрокаМассива из МетодыФормыВладельца Цикл
						Попытка
							Выполнить(СтрокаМассива);
						Исключение
						КонецПопытки;
					КонецЦикла;
					
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;	
		
	ИначеЕсли ИмяСобытия = "ОбновитьРегистрационныеНомера" Тогда
		ОбновитьДанныеРегистрационныхЗнаков();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОрганизацияПриИзмененииНаСервере()
	
	Если Не ТекущаяОрганизация = Объект.Организация Тогда
		Объект.Номер = "";
	КонецЕсли;
	
	ТекущаяОрганизация = Объект.Организация;
	
КонецПроцедуры

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
	ОрганизацияПриИзмененииНаСервере();
КонецПроцедуры

