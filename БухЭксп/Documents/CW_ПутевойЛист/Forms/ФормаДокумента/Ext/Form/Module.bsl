		ТекущиеДанные = Элементы.ОтражениеРасходовСверхНорматива.ТекущиеДанные;
		
		Если ТекущиеДанные.Количество = 0 Тогда
			КоличествоПоСтроке =  РасходОтклонение - Объект.ОтражениеРасходовСверхНорматива.Итог("Количество");
			ТекущиеДанные.Количество = ?(КоличествоПоСтроке < 0, 0, КоличествоПоСтроке);
		КонецЕсли;
			
	КонецЕсли;

