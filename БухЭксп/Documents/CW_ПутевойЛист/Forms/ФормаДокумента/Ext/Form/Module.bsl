&НаКлиенте
Процедура РасчитатьВсегоПриИзмененииСуммыНДС(ТекущиеДанные)
	
	СтруктураНДС = ПолучитьПроцентНДС(ТекущиеДанные.СтавкаНДС);
	
	Если Не СтруктураНДС.НДС_В_Сумме Тогда
		ТекущиеДанные.Всего = ТекущиеДанные.Сумма + ТекущиеДанные.НДС;
	КонецЕсли;
	
КонецПроцедуры


&НаКлиенте
Процедура РасчитатьСуммуПриИзмененииВсего(ТекущиеДанные)
	
	СтруктураНДС = ПолучитьПроцентНДС(ТекущиеДанные.СтавкаНДС);
	
	Если СтруктураНДС.НДС_В_Сумме Тогда
		ТекущиеДанные.Сумма = ТекущиеДанные.Всего;
		ТекущиеДанные.НДС 	= ТекущиеДанные.Всего * СтруктураНДС.Ставка;
	Иначе
		ТекущиеДанные.НДС 	= ТекущиеДанные.Всего * СтруктураНДС.СтавкаОбратная;
		ТекущиеДанные.Сумма = ТекущиеДанные.Всего - ТекущиеДанные.НДС;
	КонецЕсли;
	
КонецПроцедуры


&НаКлиенте
Процедура РасчитатьСуммуВсего(ТекущиеДанные)
	
	СтруктураНДС 		= ПолучитьПроцентНДС(ТекущиеДанные.СтавкаНДС);
	
	ТекущиеДанные.НДС 	= ТекущиеДанные.Сумма * СтруктураНДС.Ставка;
	ТекущиеДанные.Всего = ТекущиеДанные.Сумма + ?(СтруктураНДС.НДС_В_Сумме, 0, ТекущиеДанные.НДС);
	
КонецПроцедуры

&НаСервере
Функция  ПолучитьПроцентНДС(СтавкаНДС)
	
	Ответ = Новый Структура("Ставка,СтавкаОбратная,НДС_В_Сумме", 0, 0, Ложь);
	
	Если СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС10") Тогда
		
		Ответ.Ставка 			= 0.1;
		Ответ.СтавкаОбратная 	= 10/110;
		Ответ.НДС_В_Сумме 		= Ложь;
		
		
	ИначеЕсли СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС10_110") Тогда
		
		Ответ.Ставка 			= 10/110;
		Ответ.СтавкаОбратная 	= 0.1;
		Ответ.НДС_В_Сумме 		= Истина;
		
		
	ИначеЕсли СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС18") Тогда
		
		Ответ.Ставка 			= 0.18;
		Ответ.СтавкаОбратная 	= 18/118;
		Ответ.НДС_В_Сумме 		= Ложь;
		
		
	ИначеЕсли СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС18_118") Тогда
		
		Ответ.Ставка 			= 18/118;
		Ответ.СтавкаОбратная 	= 0.18;
		Ответ.НДС_В_Сумме 		= Истина;
		
		
	ИначеЕсли СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС20") Тогда
		
		Ответ.Ставка 			= 0.20;
		Ответ.СтавкаОбратная 	= 20/120;
		Ответ.НДС_В_Сумме 		= Ложь;
		
		
	ИначеЕсли СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС20_120") Тогда
		
		Ответ.СтавкаОбратная 	= 0.20;
		Ответ.Ставка 			= 20/120;
		Ответ.НДС_В_Сумме 		= Истина;
		
		
	КонецЕсли;
	
Возврат Ответ;

	
КонецФункции

