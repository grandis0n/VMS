&наКлиенте
Процедура ЗавершитьВыборВариантаПодстановки(РезультатВыбора, ДополнительныеПараметры) Экспорт
	
	Если РезультатВыбора = Неопределено Тогда
		Возврат;
	КонецЕсли;   
	
	Если РезультатВыбора = 0 Тогда
		Объект.ДатаЗакрытия = ТекущаяДата(); 	 
	Иначе
		Объект.ДатаЗакрытия = Объект.ВозвращениеФакт; 
	КонецЕсли;

	ИзменитьСтатусДокумента();
	
