Процедура КомандаПересчитатьНормативныйРасход(Команда)
	
	НеобходимоПересчитатьНормативныйРасход = Ложь;
	_ПересчитатьНормативныйРасход();
	
КонецПроцедуры

&НаСервере
Процедура _ПересчитатьНормативныйРасход()
	
	тОбъект = РеквизитФормыВЗначение("Объект");
	
	ПорядокПолученияНормативов = Константы.CW_ПорядокРасчетаНормативаТоплива.Получить();
	
	ИтогоРасходПоНорме = 0;
	Для ИндексСтроки = 0 по Объект.ЭтапыМаршрута.Количество() - 1 Цикл
		
		ТекущаяСтрокаГрузоперевозки = Объект.ЭтапыМаршрута[ИндексСтроки];
		
		Если ПорядокПолученияНормативов = Перечисления.CW_ПорядокРасчетаНормативаТоплива.НаДатуНачалаПеревозки Тогда
			ДатаСреза 	= Макс(ТекущаяСтрокаГрузоперевозки.ДатаПогрузки, ТекущаяСтрокаГрузоперевозки.ДатаВыезда);
		Иначе
			ДатаСреза 	= Макс(ТекущаяСтрокаГрузоперевозки.ДатаРазгрузки, ТекущаяСтрокаГрузоперевозки.ДатаВозвращения);
		КонецЕсли;
		
		СсылкаТранспортноеСредство 	= ТекущаяСтрокаГрузоперевозки.ТранспортноеСредство;
		СсылкаПрицеп				= Объект.Прицеп;
		СсылкаМодель				= СсылкаТранспортноеСредство.Модель;
		ФормулаМодели				= СсылкаТранспортноеСредство.Модель.ФормулаРасчетаНормыРасходаТоплива;
		
		мДопОборудование = Неопределено;
		Если ИспользуетсяДополнительноеОборудование Тогда
			ЕстьДопОборудование = Объект.ДополнительноеОборудование.Количество() > 0;
			Если мДопОборудование = Неопределено тогда
				мДопОборудование 	= Объект.ДополнительноеОборудование.Выгрузить().ВыгрузитьКолонку("ДополнительноеОборудование");
			КонецЕсли;
		КонецЕсли;
		
		ПараметрыФормулы = CW_УчетСобственногоТранспортаСервер.ПолучитьДействующуюФормулуНормрасходатранспортныхСредств(ДатаСреза, СсылкаТранспортноеСредство);
		
		Если НЕ ПараметрыФормулы = Неопределено Тогда
			СсылкаНаФормулу			= ПараметрыФормулы.ФормулаРасчетаНормыРасходаТоплива; 
		Иначе
			СсылкаНаФормулу 		= ФормулаМодели;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(СсылкаНаФормулу) Тогда
			Возврат;
		КонецЕсли;
		
		Формула	= СсылкаНаФормулу.ФормулаРасчета;
		Формула	= CW_УчетСобственногоТранспортаСервер.ПривестиФормулуКСтроке(Формула);
		
		НаименованиеФормулы = СсылкаНаФормулу.Наименование;
		// --- 
		ПараметрыВыполненияФормулы = CW_УчетСобственногоТранспортаСервер.ПараметрыВыполненияФормулы(Формула,,НаименованиеФормулы);
		
		Если ПараметрыВыполненияФормулы = Неопределено Тогда
			Возврат;
		КонецЕсли;
		
		//Получим показатели   
		мПоказатели 					=  Справочники.CW_ПоказателиРасчетаРасходаТоплива.ПолучитьМассивПоказателей();
		
		ЗначенияПоказателейМодели	= новый Соответствие;
		тОбъект.ПолучитьЗначенияПоказателей(ДатаСреза, ЗначенияПоказателейМодели				, СсылкаМодель					, мПоказатели);
		
		Если ИспользуютсяПоказателиТранспортногоСредства Тогда
			ЗначенияПоказателейтранспортногоСредства 		= новый Соответствие;
			тОбъект.ПолучитьЗначенияПоказателей(ДатаСреза, ЗначенияПоказателейтранспортногоСредства	, СсылкаТранспортноеСредство	, мПоказатели);
		КонецЕсли;
		
		Если ИспользуетсяДополнительноеОборудование Тогда
			Если ЕстьДопОборудование тогда
				ЗначенияПоказателейДополнительногоОборудования 	= новый Соответствие;
				мПоказателиДопОборудования 		=  Справочники.CW_ПоказателиРасчетаРасходаТоплива.ПолучитьМассивДоступныхПоказателейПоВидутранспортногоСредства(ПредопределенноеЗначение("Перечисление.CW_ВидыТС.ДополнительноеОборудование"));
				тОбъект.ПолучитьЗначенияПоказателей(ДатаСреза, ЗначенияПоказателейДополнительногоОборудования, мДопОборудование	, мПоказателиДопОборудования);
			КонецЕсли;
		КонецЕсли;
		
		СоответствиеПоказателейШапки			=  Справочники.CW_ПоказателиРасчетаРасходаТоплива.ПолучитьСоответствиеПоказателейШапки();
		СоответствиеПоказателейТабличнойЧасти	=  Справочники.CW_ПоказателиРасчетаРасходаТоплива.ПолучитьСоответствиеПоказателейТабличнойЧасти();
		МассивПоказателейСОсобымПорядком		=  Справочники.CW_ПоказателиРасчетаРасходаТоплива.ПоулчитьМассивПоказателейСОсобымПорядком();
		
		ИсходныеДанные 					= Новый Структура;
		мПоказателиТабличнойЧасти 		= Новый Массив;
		мПоказателиОсобыйПорядок 		= Новый Массив;
		
		// заполняем исходные данные по настраиваемым показателям
		Для каждого Показатель из ПараметрыВыполненияФормулы.ПоказателиФормулы Цикл
			Если Показатель.УказываетсяВНастройках тогда
				
				ЗначениеПоказателя =  ЗначенияПоказателейМодели.Получить(Показатель);
				
				Если ИспользуютсяПоказателиТранспортногоСредства Тогда
					ЗначениеПоказателяТС =  ЗначенияПоказателейтранспортногоСредства.Получить(Показатель);
					Если ЗначениеЗаполнено(ЗначениеПоказателяТС) Тогда
						ЗначениеПоказателя = ЗначениеПоказателяТС;
					КонецЕсли;
				КонецЕсли;
				
				ИсходныеДанные.Вставить(Показатель.Идентификатор, ?(ЗначениеПоказателя = Неопределено,0, ЗначениеПоказателя));
				
			Иначе
				
				ПоказательПолучен = Ложь;
				ПутьКДаннымПоказателяШапки = СоответствиеПоказателейШапки.Получить(Показатель);
				Если ПутьКДаннымПоказателяШапки <> Неопределено Тогда
					ИсходныеДанные.Вставить(Показатель.Идентификатор, Вычислить(СокрЛП(ПутьКДаннымПоказателяШапки)));
					ПоказательПолучен = истина;
				КонецЕсли;
				
				ПутьКДаннымПоказателяТабличнойЧасти = СоответствиеПоказателейТабличнойЧасти.Получить(Показатель);
				Если ПутьКДаннымПоказателяТабличнойЧасти <> Неопределено Тогда
					мПоказателиТабличнойЧасти.Добавить(Показатель);
					ПоказательПолучен = истина;
				КонецЕсли;
				
				НомерВМассиве = МассивПоказателейСОсобымПорядком.Найти(Показатель);
				Если НомерВМассиве <> Неопределено Тогда
					мПоказателиОсобыйПорядок.Добавить(Показатель);
					ПоказательПолучен = истина;
				КонецЕсли;

				Если Не ПоказательПолучен Тогда
					Сообщение = Новый СообщениеПользователю;
					Сообщение.Текст = "Неизвестный покзаатель расчета расхода топлива: "+СокрЛП(Показатель);
					Сообщение.Сообщить();
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
		Для Каждого Показатель из мПоказателиТабличнойЧасти Цикл
			
			ПутьКДаннымПоказателяТабличнойЧасти = СоответствиеПоказателейТабличнойЧасти.Получить(Показатель);
			ИсходныеДанные.Вставить(Показатель.Идентификатор, Вычислить(СокрЛП(ПутьКДаннымПоказателяТабличнойЧасти)));
			
		КонецЦикла;
		
		Для Каждого Показатель из мПоказателиОсобыйПорядок Цикл
			
			Если Показатель =  ПредопределенноеЗначение("Справочник.CW_ПоказателиРасчетаРасходаТоплива.ВремяПростоя") Тогда
				//Дополним исходные данные временим простоя
				ИдентификаторСтроки 	= Вычислить("Объект.ЭтапыМаршрута[ИндексСтроки].ИдентификаторСтроки");
				
				Отбор = Новый Структура("ИдентификаторСтроки,ДвигательВключен", ИдентификаторСтроки, Истина);
				ТабПростои = Объект.Простои.Выгрузить().Скопировать(Отбор);
				
				ИсходныеДанные.Вставить(Показатель.Идентификатор, ТабПростои.Итог("ВремяПростояЧас"));
				
			Иначе
				
				//другие возможные показатели
				
			КонецЕсли;
			
		КонецЦикла;
		

		
		РасходПоНормеЭтапа = CW_УчетСобственногоТранспортаСервер.ВыполнитьРасчетНормыРасходаТопливаПоФормуле(ИсходныеДанные, ПараметрыВыполненияФормулы);
		
		// -----
		//Данные распредения нормы по строкам
		ТекущаяСтрокаГрузоперевозки.РасходНорма = РасходПоНормеЭтапа;
		// -----
		
		ИтогоРасходПоНорме = ИтогоРасходПоНорме + РасходПоНормеЭтапа;
		
	КонецЦикла;
	
	// ---
	
	Объект.РасходПоНорме 			= ИтогоРасходПоНорме;
	
	ПрересчитатьФактическийРасходПоНорме();
	
	Если Объект.ПриравнятьФактическийРасходКНормативному Тогда
		Объект.РасходПоНорме  			= Объект.РасходТоплива;
	КонецЕсли;
	
	ВсегоПробег 					= Объект.ЭтапыМаршрута.Итог("Пробег");
	Объект.РасходПоНормеСредний 	= Объект.РасходПоНорме / ВсегоПробег * 100; 
	
	_ПересчитатьРасходТоплива();

	ПоказатьНадписьНеобходимстиПересчетаРасходаТоплива();

КонецПроцедуры  


&НаСервере
Процедура ПрересчитатьФактическийРасходПоНорме()
	
	//Пересчитаем распредление фактического расхода
	ТопливоКРаспределению = Объект.РасходТоплива;
	Для каждого СтрокаРаспределения из Объект.ЭтапыМаршрута Цикл
		
		КоэфРаспределения =  СтрокаРаспределения.РасходНорма  / Объект.РасходПоНорме;
		
		РасходПоСтроке = Окр(Объект.РасходТоплива * КоэфРаспределения, 3);
		
		СтрокаРаспределения.РасходФакт  = РасходПоСтроке;
		
		Если Объект.ПриравнятьФактическийРасходКНормативному Тогда
			СтрокаРаспределения.РасходНорма  = РасходПоСтроке;
		КонецЕсли;
		
		ТопливоКРаспределению =  ТопливоКРаспределению - РасходПоСтроке; 
		
	КонецЦикла;
	
	Если ТопливоКРаспределению <> 0 Тогда
		СтрокаРаспределения.РасходФакт = СтрокаРаспределения.РасходФакт + ТопливоКРаспределению;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура МашинаПриИзменении(Элемент)
	
	ПриИзменениитранспортногоСредстваНаСервере();
	ОбновитьДанныеДляРасчетаПогрешности();
	УстановитьВидимостьЭлементовФормы();
	ОбновитьДанныеРегистрационныхЗнаков();
	
КонецПроцедуры

&НаКлиенте
Процедура МашинаОкончаниеВводаТекста(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, СтандартнаяОбработка)
	
	ПриИзменениитранспортногоСредстваНаСервере();
	ОбновитьДанныеДляРасчетаПогрешности();
	УстановитьВидимостьЭлементовФормы();
	ОбновитьДанныеРегистрационныхЗнаков();

КонецПроцедуры


&НаСервере
Процедура ПриИзменениитранспортногоСредстваНаСервере()
	
	Если СтароеТранспортноеСредство <> Объект.ТранспортноеСредство Тогда
		
		Объект.Водитель =  Объект.ТранспортноеСредство.ОсновнойВодитель;
		Объект.Прицеп 	=  Объект.ТранспортноеСредство.ОсновнойПрицеп;
		
		ВодительПриИзмененииНаСервере() ;

		ЗаполнитьТопливоНаСервере();
		
		ЗаполнитьСкладБУ_ИзПараметров();
		
		Если ИспользуетсяДополнительноеОборудование Тогда
			ЗаполнитьДополнительноеОборудование();
		КонецЕсли;
		
		СтароеТранспортноеСредство = Объект.ТранспортноеСредство;
	
	КонецЕсли;
	
	ОбработатьТаблицуЭтапыМаршрута(Ложь, Истина);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСкладБУ_ИзПараметров()
	
	СкладБУ = Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	CW_ПараметрыТССрезПоследних.ТранспортноеСредство КАК ТранспортноеСредство,
		|	CW_ПараметрыТССрезПоследних.ПараметрТранпортногоСредства КАК ПараметрТранпортногоСредства,
		|	CW_ПараметрыТССрезПоследних.Значение КАК Значение
		|ИЗ
		|	РегистрСведений.CW_ПараметрыТС.СрезПоследних(
		|			&ДатаСреза,
		|			ТранспортноеСредство = &ТранспортноеСредство
		|				И ПараметрТранпортногоСредства = &ПараметрТранпортногоСредства) КАК CW_ПараметрыТССрезПоследних";
	
	Запрос.УстановитьПараметр("ДатаСреза"					, Объект.Дата);
	Запрос.УстановитьПараметр("ТранспортноеСредство"		, Объект.ТранспортноеСредство);
	Запрос.УстановитьПараметр("ПараметрТранпортногоСредства", ПланыВидовХарактеристик.CW_ПараметрыТранспортныхСредств.Склад);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		СкладБУ = ВыборкаДетальныеЗаписи.Значение;
	КонецЕсли;	

	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДополнительноеОборудование()
	
	Объект.ДополнительноеОборудование.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	CW_ДополнительноеОборудованиеТС.ДополнительноеОборудование КАК ДополнительноеОборудование,
	|	CW_ДополнительноеОборудованиеТС.ТранспортноеСредство КАК ТранспортноеСредство,
	|	CW_ДополнительноеОборудованиеТС.ДополнительноеОборудование.ОсновноеТопливо КАК Топливо
	|ИЗ
	|	РегистрСведений.CW_ДополнительноеОборудованиеТС КАК CW_ДополнительноеОборудованиеТС
	|ГДЕ
	|	CW_ДополнительноеОборудованиеТС.ТранспортноеСредство = &ТранспортноеСредство
	|
	|СГРУППИРОВАТЬ ПО
	|	CW_ДополнительноеОборудованиеТС.ТранспортноеСредство,
	|	CW_ДополнительноеОборудованиеТС.ДополнительноеОборудование,
	|	CW_ДополнительноеОборудованиеТС.ДополнительноеОборудование.ОсновноеТопливо";
	
	Запрос.УстановитьПараметр("ТранспортноеСредство", Объект.ТранспортноеСредство);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если Не РезультатЗапроса.Пустой() Тогда
		
		Объект.ДополнительноеОборудование.Загрузить(РезультатЗапроса.Выгрузить());
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТопливоНаСервере()
	
	Если ЗначениеЗаполнено(Объект.ТранспортноеСредство) Тогда
		
		Объект.Топливо = Объект.ТранспортноеСредство.ОсновноеТопливо;
		
	Иначе
		
		Объект.Топливо = "";
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	ТекущийОбъект.Водители.Загрузить(Водители.Выгрузить());
	
	Если Не	Объект.Статус = Статус  Тогда
		ТекущийОбъект.Статус = Статус;
	КонецЕсли;
	
	//-------------------
	
	Если ЗначениеЗаполнено(Объект.АналитикаЗатрат) Тогда
		ПроверитьУникальностьАналитикиЗатрат(Отказ);
	КонецЕсли;
	
	_СохранитьСеансовуюНастройку();

КонецПроцедуры

&НаСервере
Процедура ПроверитьУникальностьАналитикиЗатрат(Отказ)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	CW_СоответствияПутевыхЛистовИНоменклатурныхГрупп.ПутевойЛист КАК ПутевойЛист,
		|	CW_СоответствияПутевыхЛистовИНоменклатурныхГрупп.НоменклатурнаяГруппа КАК НоменклатурнаяГруппа,
		|	ПРЕДСТАВЛЕНИЕ(CW_СоответствияПутевыхЛистовИНоменклатурныхГрупп.НоменклатурнаяГруппа) КАК НоменклатурнаяГруппаПредставление,
		|	ПРЕДСТАВЛЕНИЕ(CW_СоответствияПутевыхЛистовИНоменклатурныхГрупп.ПутевойЛист) КАК ПутевойЛистПредставление
		|ИЗ
		|	РегистрСведений.CW_СоответствияПутевыхЛистовИНоменклатурныхГрупп КАК CW_СоответствияПутевыхЛистовИНоменклатурныхГрупп
		|ГДЕ
		|	НЕ CW_СоответствияПутевыхЛистовИНоменклатурныхГрупп.ПутевойЛист = &ПутевойЛист
		|	И CW_СоответствияПутевыхЛистовИНоменклатурныхГрупп.НоменклатурнаяГруппа = &НоменклатурнаяГруппа";
	
	Запрос.УстановитьПараметр("НоменклатурнаяГруппа"	, Объект.АналитикаЗатрат);
	Запрос.УстановитьПараметр("ПутевойЛист"				, Объект.Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если Не РезультатЗапроса.Пустой() Тогда
		
		Отказ = Истина;
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Аналитика затрат "+ВыборкаДетальныеЗаписи.НоменклатурнаяГруппаПредставление+" уже используется для путевого листа "+ВыборкаДетальныеЗаписи.ПутевойЛистПредставление;
			Сообщение.ПутьКДанным = "Объект";
			Сообщение.Поле 	= "АналитикаЗатрат";
			Сообщение.УстановитьДанные(Объект);
			Сообщение.Сообщить();
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОстатокТопливаПриВозвращенииПриИзменении(Элемент)
	
	_ПересчитатьРасходТоплива();

КонецПроцедуры

&НаКлиенте
Процедура ПростоиВремяПростояПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.Простои.ТекущиеДанные;
	
	ВремяПростоя = ОКР((ТекущиеДанные.ВремяПростоя - Дата(1,1,1))/3600, 2);
	
	ТекущиеДанные.ВремяПростояЧас = ВремяПростоя;
	
КонецПроцедуры

&НаКлиенте
Процедура ЭтапыМаршрутаПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НоваяСтрока или Копирование тогда
		ТекущиеДанные = Элементы.ЭтапыМаршрута.ТекущиеДанные;
		ТекущиеДанные.ИдентификаторСтроки = Новый УникальныйИдентификатор;
		
		Если ТекущиеДанные.Пробег = 0 или Копирование Тогда
			ПробегПоСтроке =  ПробегПоОдометру - Объект.ЭтапыМаршрута.Итог("Пробег");
			ТекущиеДанные.Пробег = ?(ПробегПоСтроке < 0, 0, ПробегПоСтроке);
		КонецЕсли;
		
		ТекущиеДанные.Водитель 				= Объект.Водитель;
		ТекущиеДанные.ТранспортноеСредство 	= Объект.ТранспортноеСредство;
			
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЭтапыМаршрутаПередУдалением(Элемент, Отказ)
	
	ТекущиеДанные = Элементы.ЭтапыМаршрута.ТекущиеДанные;
	
	//Удалим строки
	тОтбор = Новый Структура("ИдентификаторСтроки", ТекущиеДанные.ИдентификаторСтроки);
	
	мСтрокиПростои = Объект.Простои.НайтиСтроки(тОтбор);
	
	Если мСтрокиПростои.Количество() > 0 Тогда
		
		Для Каждого СтрокаМассива из мСтрокиПростои Цикл
			
			Объект.Простои.Удалить(СтрокаМассива);
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЭтапыМаршрутаПриАктивизацииСтроки(Элемент)
	
	ТекущиеДанные = Элементы.ЭтапыМаршрута.ТекущиеДанные;
	
	Если не ТекущиеДанные = Неопределено Тогда
		Элементы.Простои.ОтборСтрок = Новый ФиксированнаяСтруктура("ИдентификаторСтроки", ТекущиеДанные.ИдентификаторСтроки);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьПростои(Команда)
	ПоказатьПростоиЭтапа = Не ПоказатьПростоиЭтапа;
	ПоказатьСкрытьПростоиЭтапа();
КонецПроцедуры

&НаСервере
Процедура ПоказатьСкрытьПростоиЭтапа()
	
	Элементы.ЭтапыМаршрутаПоказатьПростои.Пометка 	= ПоказатьПростоиЭтапа;
	Элементы.ГруппаПростои.Видимость 				= ПоказатьПростоиЭтапа;
	
КонецПроцедуры

&НаКлиенте
Процедура ПростоиПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НоваяСтрока или Копирование тогда
		ТекущиеДанные = Элементы.ЭтапыМаршрута.ТекущиеДанные;
		
		СтрокаПростой = Элементы.Простои.ТекущиеДанные;
		СтрокаПростой.ИдентификаторСтроки =  ТекущиеДанные.ИдентификаторСтроки;

	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьРасчет(Команда)
	
	Если ПрименяютсяНормативыРасходаТоплива и Объект.РассчитыватьНормативныйРасходТоплива тогда
		ТабДокумент = ВывестиРасшифровкуРасчетаНормативов();
		ТабДокумент.Показать("");
	Иначе
		ТабДокумент = ВывестиРасшифровкуРасчетаРаспредления();
		ТабДокумент.Показать("");
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ВывестиРасшифровкуРасчетаНормативов()
	
	тОбъект = РеквизитФормыВЗначение("Объект");
	
	Возврат тОбъект.ПолучитьДанныеДляПечати();
	
КонецФункции

&НаСервере
Функция ВывестиРасшифровкуРасчетаРаспредления()
	
	тОбъект = РеквизитФормыВЗначение("Объект");
	
	Возврат тОбъект.ПолучитьДанныеДляПечатиПоФактическомуРасходу();
	
	
КонецФункции

&НаКлиенте
Процедура ВыездФактПриИзменении(Элемент)
	ИзменитьСтатусДокумента();
КонецПроцедуры

&НаКлиенте
Процедура ВозвращениеФактПриИзменении(Элемент)

	ИзменитьСтатусДокумента();
	УстановитьВидимостьЭлементовФормы();
	ОбновитьДанныеДляРасчетаПогрешности();
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаЗакрытияПриИзменении(Элемент)
	ИзменитьСтатусДокумента();
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьСтатусДокумента()
	
	Если ЗначениеЗаполнено(Объект.ДатаЗакрытия) Тогда
		Статус = ПредопределенноеЗначение("Перечисление.CW_СтатусыПутевыхЛистов.Закрыт");
	ИначеЕсли Объект.ЭтапыМаршрута.Итог("РасходФакт") <> 0 Тогда
		Статус = ПредопределенноеЗначение("Перечисление.CW_СтатусыПутевыхЛистов.Расчитан");
	ИначеЕсли ЗначениеЗаполнено(Объект.ВозвращениеФакт) Тогда
		Статус = ПредопределенноеЗначение("Перечисление.CW_СтатусыПутевыхЛистов.ВОбработке");
	ИначеЕсли ЗначениеЗаполнено(Объект.ВыездФакт) Тогда
		Статус = ПредопределенноеЗначение("Перечисление.CW_СтатусыПутевыхЛистов.ВРейсе");
	Иначе
		Статус = ПредопределенноеЗначение("Перечисление.CW_СтатусыПутевыхЛистов.Выписан");
	КонецЕсли;
	
КонецПроцедуры


//Водители документа
&НаКлиенте
Процедура ВодителиДокументаНажатие(Элемент)
	
	ПараметрыОткрытияФормы = Новый Структура;
	ПараметрыОткрытияФормы.Вставить("ВодителиАдрес"		, ПолучитьАдресВодителей());	
	ПараметрыОткрытияФормы.Вставить("Организация"		, Объект.Организация );	
	ПараметрыОткрытияФормы.Вставить("ОсновнойОодитель"	, Объект.Водитель );	
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ОбработкаЗакрытияФормыСпискаВодителей",ЭтотОбъект, Новый Структура()); 
	
	ОткрытьФорму("Документ.CW_ПутевойЛист.Форма.ФормаВодителейДокумента",ПараметрыОткрытияФормы, ЭтаФорма,,,,ОписаниеОповещения,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры  

&НаСервере
Функция ПолучитьАдресВодителей()
	
	Возврат ПоместитьВоВременноеХранилище(Водители.Выгрузить());
	
КонецФункции

&НаКлиенте
Процедура ОбработкаЗакрытияФормыСпискаВодителей(Ответ, ДополнительныеПараметры) Экспорт 
	
	Если Ответ <> Неопределено Тогда
		ОбработкаЗакрытияФормыСпискаВодителейНаСервере(Ответ);
	конецЕсли;
	
КонецПроцедуры

&наСервере
Процедура ОбработкаЗакрытияФормыСпискаВодителейНаСервере(Адерс)
	
	ТаблицаВодителей = ПолучитьИзВременногоХранилища(Адерс);
	Водители.Загрузить(ТаблицаВодителей);
	
	Отбор = Новый Структура("Основной", Истина);
	
	мСтроки = ТаблицаВодителей.НайтиСтроки(Отбор);
	
	Если мСтроки.Количество() > 0 Тогда
		
		ПерваяСтрока = мСтроки[0];
		Объект.Водитель = ПерваяСтрока.Водитель;
		
	Иначе
		
		Объект.Водитель = Неопределено;
		
	КонецЕсли;
	
	ВодительПриИзмененииНаСервере();
	
КонецПроцедуры


&НаСервере
Процедура ВодительПриИзмененииНаСервере()
	
	Если СтарыйВодитель <> Объект.Водитель Тогда
		УдалитьВодителяИзСписка(СтарыйВодитель);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.Водитель) Тогда
		ДобавитьВодителяВСписок(Объект.Водитель);
	КонецЕсли;

	_ОбновитьПредставлениеВодителей();
	
	ОбработатьТаблицуЭтапыМаршрута(Истина, Ложь);
	ОбработатьТаблицуЗаправки();

	СтарыйВодитель = Объект.Водитель;
	
КонецПроцедуры

&НаСервере
Процедура ОбработатьТаблицуЭтапыМаршрута(ЗаменятьВодителя, ЗаменятьТранспортноеСредство)
	
	Для Каждого СтрокаЭтапа из Объект.ЭтапыМаршрута Цикл
		
		Если ЗаменятьВодителя  Тогда
			Если Объект.НесколькоВодителей Тогда
				Если Не ЗначениеЗаполнено(СтрокаЭтапа.Водитель) 
					или СтарыйВодитель = СтрокаЭтапа.Водитель Тогда
					СтрокаЭтапа.Водитель = Объект.Водитель;
				КонецЕсли;
			Иначе
				СтрокаЭтапа.Водитель = Объект.Водитель;
			КонецЕсли;
		КонецЕсли;
		
		Если ЗаменятьТранспортноеСредство Тогда
			СтрокаЭтапа.ТранспортноеСредство = Объект.ТранспортноеСредство;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ОбработатьТаблицуЗаправки()
	
	Для Каждого СтрокаЗаправки из Объект.Заправки Цикл
		
		Если Объект.НесколькоВодителей Тогда
			
			Если Не ЗначениеЗаполнено(СтрокаЗаправки.Водитель) 
				или СтарыйВодитель = СтрокаЗаправки.Водитель Тогда
				СтрокаЗаправки.Водитель = Объект.Водитель;
			КонецЕсли;
			
		Иначе
			СтрокаЗаправки.Водитель = Объект.Водитель;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры


&НаСервере
Процедура ДобавитьВодителяВСписок(ВодительКДобавлению)
	
	Если ЗначениеЗаполнено(ВодительКДобавлению) Тогда 
		
		Отбор 	= Новый Структура("Водитель", ВодительКДобавлению);
		мСтроки = Водители.НайтиСтроки(Отбор);
		
		Если мСтроки.Количество() = 0 Тогда
			
			СтрокаВодители = Водители.Добавить();
			СтрокаВодители.Водитель = ВодительКДобавлению;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УдалитьВодителяИзСписка(ВодительКУдалению = Неопределено)
	
	Если ВодительКУдалению = Неопределено Тогда
		Водители.Очистить();
	Иначе
		
		//Удалим старого водителя	
		Отбор = Новый Структура("Водитель", ВодительКУдалению);
		
		мСтроки = Водители.НайтиСтроки(Отбор);
		
		Если мСтроки.Количество() <> 0 Тогда
			НайденнаяСтрока = мСтроки[0];
			Водители.Удалить(НайденнаяСтрока);
		КонецЕсли;
		
	КонецЕсли;
	
	
КонецПроцедуры

&НаКлиенте
Процедура ВодительПриИзменении(Элемент)
	
	ВодительПриИзмененииНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура НесколькоВодителейПриИзменении(Элемент)
	
	ОбработатьИзменениеФлага();
	
	_ОбновитьПредставлениеВодителей();
	
	ОбработатьТаблицуЭтапыМаршрута(Истина, Ложь);
	ОбработатьТаблицуЗаправки();

КонецПроцедуры

&насервере
Процедура ОбработатьИзменениеФлага()
	
	Если НЕ Объект.НесколькоВодителей Тогда
		//Флаг снят
		Водители.Очистить();
		ДобавитьВодителяВСписок(Объект.Водитель);

	КонецЕсли;
	
	УстановитьВидимостьСсылкиВодители();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьСсылкиВодители()
	
	Элементы.ВодителиДокумента.Видимость	 = Объект.НесколькоВодителей;
	
КонецПроцедуры

&НаСервере
Процедура _ОбновитьПредставлениеВодителей()
	
	Элементы.ВодителиДокумента.Заголовок 	= "Список (" + Формат(Водители.Количество(),"ЧДЦ=0; ЧГ=0")+")";
	Элементы.Водитель.Доступность 			= Не Объект.НесколькоВодителей;
	
КонецПроцедуры

&НаКлиенте
Процедура СгенерироватьАналиткуЗатрат(Команда)
	
	Если Модифицированность тогда
		
		ПоказатьПредупреждение(, НСтр("ru = 'Необходимо записать документ!';"
		+ " en = 'You should write the document!'")); 
		
	Иначе
		
		СгенерироватьАналиткуЗатратНаСервере();
		
		ТекстОповещения	= "Записана номенклатурная группа";
		ТекстПояснения	= Строка(Объект.АналитикаЗатрат) + " сопоставлена с путевым листом";
		ПоказатьОповещениеПользователя(ТекстОповещения, ПолучитьНавигационнуюСсылку(Объект.АналитикаЗатрат), ТекстПояснения);
	
		ОбновитьОтображениеДанных();
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура СгенерироватьАналиткуЗатратНаСервере()
	
	АдресВХранилище = ПолучитьАналитикуЗатрат();
	
	Объект.АналитикаЗатрат = ПолучитьИзВременногоХранилища(АдресВХранилище);
	
КонецПроцедуры

&НаСервере
Функция ПолучитьАналитикуЗатрат()
	
	Отказ = Ложь;
	Если Не ЗначениеЗаполнено(Объект.Водитель)  Тогда
		
		Сообщение  = Новый СообщениеПользователю;
		Сообщение.Текст = "Не выбран водитель!";
		Сообщение.ПутьКДанным = "Объект";
		Сообщение.Поле = "Водитель";
		Сообщение.УстановитьДанные(ЭтотОбъект);
		Сообщение.Сообщить();
		
		Отказ = Истина;
		
	КонеЦЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.ТранспортноеСредство)  Тогда
		
		Сообщение  = Новый СообщениеПользователю;
		Сообщение.Текст = "Не выбран Транспортное средство!";
		Сообщение.ПутьКДанным = "Объект";
		Сообщение.Поле = "ТранспортноеСредство";
		Сообщение.УстановитьДанные(ЭтотОбъект);
		Сообщение.Сообщить();
		
		Отказ = Истина;
		
	КонеЦЕсли;
	
	Если Отказ Тогда
		Возврат ПоместитьВоВременноеХранилище(Неопределено);
	КонецЕсли;

	ОсновнойСпособУчетаНДС = CW_Настройки.ПараметрУчетнойПолитики(Объект.ДатаЗакрытия, Объект.Организация, "ОсновнойСпособУчетаНДС");
	
	ДатаСреза = ПолучитьДатуСреза();
	
	СтруктураДанных = Новый Структура;
	СтруктураДанных.Вставить("ДатаСреза"					, ДатаСреза);
	СтруктураДанных.Вставить("ТранспортноеСредство"			, Объект.ТранспортноеСредство);
	СтруктураДанных.Вставить("ПараметрТранпортногоСредства"	, ПланыВидовХарактеристик.CW_ПараметрыТранспортныхСредств.ГруппаПутевыхЛистов);
	
	ГруппаПутевыхЛистов = CW_УчетСобственногоТранспортаСервер.ПолучитьПараметрТранспортногоСредства(СтруктураДанных);
	
	спрНовыйОбъект = ПолучитьСоответствиеПутевогоЛистаИАналитикиЗатрат();
	
	спрНовыйОбъект.Родитель 		= ?(ЗначениеЗаполнено(ГруппаПутевыхЛистов), ГруппаПутевыхЛистов, Справочники.НоменклатурныеГруппы.ПустаяСсылка());
	спрНовыйОбъект.Наименование 	= СформироватьПредставлениеПутевогоЛиста();
	спрНовыйОбъект.СпособУчетаНДС 	= ОсновнойСпособУчетаНДС;
	
	спрНовыйОбъект.Записать();
	
	Возврат ПоместитьВоВременноеХранилище(спрНовыйОбъект.Ссылка);

КонецФункции

&НаСервере

&НаСервере
Функция СформироватьПредставлениеПутевогоЛиста()
	
	ИмяДокумента 	= РеквизитФормыВЗначение("Объект").Метаданные().Синоним;
	НомерДокумента 	= CW_Документы.ПолучитьНомерНаПечать(Объект.Ссылка);
	ДатаДокумента 	= Формат(Объект.Дата, "ДФ=dd.MM.yyyy");
	ФИОВодитель 	= ФизическиеЛицаКлиентСервер.ФамилияИнициалы(СокрЛП(Объект.Водитель));
	стрМашина		= СокрЛП(Объект.ТранспортноеСредство.Наименование);
	
	Возврат ИмяДокумента + " № " + НомерДокумента+" от "+ДатаДокумента+ " ("+стрМашина+", "+ФИОВодитель+")";
	
КонецФункции

&НаСервере
Функция ПолучитьСоответствиеПутевогоЛистаИАналитикиЗатрат()
	
	спрНовыйОбъект = Неопределено;
	Если ЗначениеЗаполнено(Объект.АналитикаЗатрат) Тогда
		спрНовыйОбъект = Объект.АналитикаЗатрат.ПолучитьОбъект();
	КонецЕсли;
	
	Если спрНовыйОбъект = Неопределено тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	CW_СоответствияПутевыхЛистовИНоменклатурныхГрупп.ПутевойЛист КАК ПутевойЛист,
		|	CW_СоответствияПутевыхЛистовИНоменклатурныхГрупп.НоменклатурнаяГруппа КАК НоменклатурнаяГруппа
		|ИЗ
		|	РегистрСведений.CW_СоответствияПутевыхЛистовИНоменклатурныхГрупп КАК CW_СоответствияПутевыхЛистовИНоменклатурныхГрупп
		|ГДЕ
		|	CW_СоответствияПутевыхЛистовИНоменклатурныхГрупп.ПутевойЛист = &ПутевойЛист";
		
		Запрос.УстановитьПараметр("ПутевойЛист", Объект.Ссылка);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Если ВыборкаДетальныеЗаписи.Следующий() Тогда
			
			Если НЕ ВыборкаДетальныеЗаписи.НоменклатурнаяГруппа.Пустая() Тогда
				
				спрНовыйОбъект = ВыборкаДетальныеЗаписи.НоменклатурнаяГруппа.ПолучитьОбъект();
				
			КонецЕсли;
			
		конецЕсли;
		
	КонецЕсли;
	
	
	Если спрНовыйОбъект = Неопределено тогда
		спрНовыйОбъект = Справочники.НоменклатурныеГруппы.СоздатьЭлемент();
	КонецЕсли;
	
	Возврат  спрНовыйОбъект;
	
КонецФункции

&НаСервере
Процедура УдалитьСоответствиеНаСервере()
	
	ЗаписьСоответствия = РегистрыСведений.CW_СоответствияПутевыхЛистовИНоменклатурныхГрупп.СоздатьМенеджерЗаписи();
	ЗаписьСоответствия.ПутевойЛист = Объект.Ссылка;
	ЗаписьСоответствия.Прочитать();
	ЗаписьСоответствия.Удалить();
	
	Объект.АналитикаЗатрат = Неопределено;
	Модифицированность = истина;
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьСоответствие(Команда)
	
	Режим = РежимДиалогаВопрос.ДаНет;
	Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаУдаления", ЭтаФорма, Параметры);
	ПоказатьВопрос(Оповещение, НСтр("ru = 'Соответствие аналитики затрат путевому листу будет удалено. Продолжить?';"
	+ " en = 'You should write the document. Continue?'"), Режим, 0); 
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияВопросаУдаления(Результат, Параметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;
	
	УдалитьСоответствиеНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ВодительНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	СтруктураПараметровФормы = новый Структура;
	СтруктураПараметровФормы.Вставить("РольСотрудника"				, ПредопределенноеЗначение("Справочник.CW_РолиСотрудников.Водитель"));
	СтруктураПараметровФормы.Вставить("Организация"					, Объект.Организация);
	СтруктураПараметровФормы.Вставить("ОтборПоОрганизации"			,  ЗначениеЗаполнено(Объект.Организация));
	СтруктураПараметровФормы.Вставить("ВозможностьСоздаватьЗаписи"	, Ложь);
	СтруктураПараметровФормы.Вставить("РежимВыбора"					, истина);

	ДополнительныйПараметр 		= Новый Структура("Реквизит","Водитель");
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ОбработкаВыбораВодителя",ЭтотОбъект, ДополнительныйПараметр);
	
	ОткрытьФорму("ОбщаяФорма.CW_ФормаВыбораСотрудникаДляРоли",СтруктураПараметровФормы,,,,,ОписаниеОповещения,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбораВодителя(Ответ, ДополнительныеПараметры) Экспорт 
	// --- 
	
	Если (Ответ <> Неопределено) Тогда
		
		Объект.Водитель = Ответ;
		ВодительПриИзмененииНаСервере();
		
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ПробегПриВозвращенииПриИзменении(Элемент)
	
	РассчиатьПробегПоОдометру();

КонецПроцедуры

&НаКлиенте
Процедура ПробегПриВыездеПриИзменении(Элемент)
	
	РассчиатьПробегПоОдометру();
	
КонецПроцедуры

&НаСервере
Процедура РассчиатьПробегПоОдометру()
	
	Если Не ЗначениеЗаполнено(Объект.ВозвращениеФакт) Тогда
		ПробегПоОдометру = 0;
	Иначе
		ПробегПоОдометру = Объект.ПробегПриВозвращении - Объект.ПробегПриВыезде;
	КонецЕсли;
	
	ПолучитьОтклонениеПробега();
	ВыделитьЦветомОтклонениеПробега();

КонецПроцедуры

&НаСервере
Процедура ПолучитьОтклонениеПробега()
	
	ОтклонениеПробега = ПробегПоОдометру - Объект.ЭтапыМаршрута.Итог("Пробег");
	ВыделитьЦветомОтклонениеПробега();
	
КонецПроцедуры

&НаСервере
Процедура ВыделитьЦветомОтклонениеПробега()
	
	Элементы.ГруппаГрузоперевозки_ОтклонениеПробега.Видимость = ОтклонениеПробега <> 0;
	
	Если ОтклонениеПробега <> 0 Тогда
		Элементы.ГруппаПробегТС.ЦветФона 							= ЦветаСтиля.КритичноеСобытиеНадежностьБанковЦветФона;
		Элементы.ГруппаГрузоперевозки_ОтклонениеПробега.ЦветФона 	= ЦветаСтиля.КритичноеСобытиеНадежностьБанковЦветФона;
	Иначе
		Элементы.ГруппаПробегТС.ЦветФона 							= Новый Цвет;
		Элементы.ГруппаГрузоперевозки_ОтклонениеПробега.ЦветФона 	= Новый Цвет;
	КонецЕсли;
	
КонецПроцедуры

