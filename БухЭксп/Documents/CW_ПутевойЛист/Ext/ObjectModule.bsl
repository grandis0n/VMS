#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	
	CW_Документы.ЗаполнениеДокументов(ЭтотОбъект);

КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	// формируем пробег документа
	//ПробегДокумента = ЭтапыМаршрута.Итог("Пробег");
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	
	Если ОбновлятьПриЗаписиПараметрыГрузоперевозок Тогда
		ЗаписатьПараметрыГрузоперевозок();
	КонецЕсли;
	
	CW_УчетСобственногоТранспортаСервер.ПодготовитьДвженияКПроведению(ЭтотОбъект);
	
	МассивИменРегистров = CW_УчетСобственногоТранспортаСервер.ПолучитьИспользуемыеРегистры(ЭтотОбъект);
	
	ДанныеДляПроведения = ПодготовитьДанныеДляПроведения(МассивИменРегистров);
	
	CW_УчетСобственногоТранспортаСервер.ЗарегистрироватьДвиженияДокумента(Движения,ДанныеДляПроведения,МассивИменРегистров);	
	
	
КонецПроцедуры

Функция ПодготовитьДанныеДляПроведения(МассивИменРегистров)
	
	ВедетсяУчетШинТранспортногоСредства 		= ПолучитьФункциональнуюОпцию("CW_ВедетсяУчетШинТранспортногоСредства");
	УчитыватьПробегТранспортногоСредстваСГрузом = ПолучитьФункциональнуюОпцию("CW_УчитыватьПробегТранспортногоСредстваСГрузом");
	НоменклатураЗарплата						= Константы.CW_НоменклатураУчетаЗарплатыВодителей.Получить();
	
	ДанныеДляПроведения = CW_УчетСобственногоТранспортаСервер.ПодготовитьТаблицыДанныхДляПроведения(МассивИменРегистров);
	
	// ------
	//Заполнение таблиц проведения
	// CW_СостоянияТС
	Если ЗначениеЗаполнено(ВыездФакт) Тогда
		СтрокаСостоянияТС = ДанныеДляПроведения.CW_СостоянияТС.Добавить();
		СтрокаСостоянияТС.Период 				= ВыездФакт;
		СтрокаСостоянияТС.ТранспортноеСредство 	= ТранспортноеСредство;
		СтрокаСостоянияТС.Состояние 			= Справочники.CW_СостоянияТС.ВРейсе;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ВозвращениеФакт) Тогда
		
		СтрокаСостоянияТС = ДанныеДляПроведения.CW_СостоянияТС.Добавить();
		СтрокаСостоянияТС.Период 				= ВозвращениеФакт;
		СтрокаСостоянияТС.ТранспортноеСредство 	= ТранспортноеСредство;
		СтрокаСостоянияТС.Состояние 			= Справочники.CW_СостоянияТС.Исправно;
		
		// CW_ПоказанияОдометровТранспортныхСредств
		Если  (ПробегПриВозвращении <> 0) Тогда 
			СтрокаПробегТС = ДанныеДляПроведения.CW_ПоказанияОдометровТранспортныхСредств.Добавить();
			СтрокаПробегТС.Период 					= ВозвращениеФакт;
			СтрокаПробегТС.ТранспортноеСредство 	= ТранспортноеСредство;
			СтрокаПробегТС.Пробег 					= ПробегПриВозвращении;
		КонецЕсли;
		
		//CW_ТопливоТС
		Если РасходТоплива <> 0 Тогда
			СтрокаСостоянияТС = ДанныеДляПроведения.CW_ТопливоТС.Добавить();
			СтрокаСостоянияТС.Период 				= ВозвращениеФакт;
			СтрокаСостоянияТС.ВидДвижения           = ВидДвиженияНакопления.Расход;
			СтрокаСостоянияТС.Организация 			= Организация;
			СтрокаСостоянияТС.ТранспортноеСредство 	= ТранспортноеСредство;
			СтрокаСостоянияТС.Топливо 				= Топливо;
			СтрокаСостоянияТС.Количество 			= РасходТоплива;
		КонецЕсли;
		
		Если ВедетсяУчетШинТранспортногоСредства Тогда
			
			// CW_ПробегШин
			мТранспортноеСредство = новый Массив;
			мТранспортноеСредство.Добавить(ТранспортноеСредство);
			мТранспортноеСредство.Добавить(Прицеп);
			
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ
			|	CW_ШиныТССрезПоследних.ТранспортноеСредство КАК ТранспортноеСредство,
			|	CW_ШиныТССрезПоследних.Шина КАК Шина
			|ИЗ
			|	РегистрСведений.CW_ШиныТС.СрезПоследних(&ДатаСреза, ТранспортноеСредство В (&мТранспортноеСредство)) КАК CW_ШиныТССрезПоследних";
			
			Запрос.УстановитьПараметр("ДатаСреза"			 , ВозвращениеФакт);
			Запрос.УстановитьПараметр("мТранспортноеСредство", мТранспортноеСредство);
			
			РезультатЗапросаШины = Запрос.Выполнить();
			
		КонецЕсли;

		//  ЭТАПЫ ПУТЕВОГО ЛИСТА
		//	CW_ЗарплатаВодителейТС
		Запрос = Новый Запрос;
		Запрос.Текст =  "ВЫБРАТЬ
		                |	CW_ПутевойЛистЭтапыМаршрута.Ссылка.Организация КАК Организация,
		                |	CW_ПутевойЛистЭтапыМаршрута.Ссылка КАК ПутевойЛист,
		                |	CW_ПутевойЛистЭтапыМаршрута.Ссылка.ТранспортноеСредство КАК ТранспортноеСредство,
		                |	CW_ПутевойЛистЭтапыМаршрута.Грузоперевозка КАК Грузоперевозка,
		                |	ВЫБОР
		                |		КОГДА CW_ПутевойЛистЭтапыМаршрута.Водитель = ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.пустаяСсылка)
		                |			ТОГДА CW_ПутевойЛистЭтапыМаршрута.Водитель
		                |		ИНАЧЕ CW_ПутевойЛистЭтапыМаршрута.Водитель
		                |	КОНЕЦ КАК Водитель,
		                |	СУММА(CW_ПутевойЛистЭтапыМаршрута.Зарплата) КАК Сумма,
		                |	СУММА(CW_ПутевойЛистЭтапыМаршрута.Пробег) КАК Пробег,
		                |	СУММА(CW_ПутевойЛистЭтапыМаршрута.ПробегСГрузом) КАК ПробегСГрузом,
		                |	CW_ПутевойЛистЭтапыМаршрута.Грузоперевозка.Маршрут КАК Маршрут,
		                |	CW_ПутевойЛистЭтапыМаршрута.ИдентификаторСтроки КАК ИдентификаторСтроки,
		                |	СУММА(CW_ПутевойЛистЭтапыМаршрута.ПробегПорожний) КАК ПробегПорожний,
		                |	СУММА(CW_ПутевойЛистЭтапыМаршрута.ПробегБезПрицепа) КАК ПробегБезПрицепа
		                |ИЗ
		                |	Документ.CW_ПутевойЛист.ЭтапыМаршрута КАК CW_ПутевойЛистЭтапыМаршрута
		                |ГДЕ
		                |	CW_ПутевойЛистЭтапыМаршрута.Ссылка = &Ссылка
		                |
		                |СГРУППИРОВАТЬ ПО
		                |	CW_ПутевойЛистЭтапыМаршрута.Грузоперевозка,
		                |	CW_ПутевойЛистЭтапыМаршрута.Ссылка,
		                |	CW_ПутевойЛистЭтапыМаршрута.Ссылка.ТранспортноеСредство,
		                |	CW_ПутевойЛистЭтапыМаршрута.Грузоперевозка.Маршрут,
		                |	CW_ПутевойЛистЭтапыМаршрута.ИдентификаторСтроки,
		                |	ВЫБОР
		                |		КОГДА CW_ПутевойЛистЭтапыМаршрута.Водитель = ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.пустаяСсылка)
		                |			ТОГДА CW_ПутевойЛистЭтапыМаршрута.Водитель
		                |		ИНАЧЕ CW_ПутевойЛистЭтапыМаршрута.Водитель
		                |	КОНЕЦ,
		                |	CW_ПутевойЛистЭтапыМаршрута.Ссылка.Организация";
		
		Запрос.УстановитьПараметр("Ссылка", Ссылка);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			
			// CW_ЗарплатаВодителейТС
			СтрокаЗарплатаВодителейТС				= ДанныеДляПроведения.CW_ЗарплатаВодителейТС.Добавить();
			СтрокаЗарплатаВодителейТС.Период 		= ВозвращениеФакт;
			СтрокаЗарплатаВодителейТС.Номенклатура 	= НоменклатураЗарплата;
			
			ЗаполнитьЗначенияСвойств(СтрокаЗарплатаВодителейТС, ВыборкаДетальныеЗаписи);
			
			//  CW_ПробегТС
			СтрокаПробегТС = ДанныеДляПроведения.CW_ПробегТС.Добавить();
			СтрокаПробегТС.Период 				= ВозвращениеФакт;
			СтрокаПробегТС.ПутевойЛист			= Ссылка;
			СтрокаПробегТС.ТранспортноеСредство	= ВыборкаДетальныеЗаписи.ТранспортноеСредство;
			СтрокаПробегТС.Грузоперевозка		= ВыборкаДетальныеЗаписи.Грузоперевозка;
			СтрокаПробегТС.Водитель				= ВыборкаДетальныеЗаписи.Водитель;
			СтрокаПробегТС.Пробег				= ВыборкаДетальныеЗаписи.Пробег;
			
			Если УчитыватьПробегТранспортногоСредстваСГрузом Тогда
				СтрокаПробегТС.ПробегСГрузом		=  ВыборкаДетальныеЗаписи.ПробегСГрузом;
				СтрокаПробегТС.ПробегПорожний		=  ВыборкаДетальныеЗаписи.ПробегПорожний;
			КонецЕсли;
			
			Если ВедетсяУчетШинТранспортногоСредства Тогда
				
				ВыборкаДетальныеЗаписиШины = РезультатЗапросаШины.Выбрать();
				
				Пока ВыборкаДетальныеЗаписиШины.Следующий() Цикл
					
					СтрокаПробегШин = ДанныеДляПроведения.CW_ПробегШин.Добавить();
					СтрокаПробегШин.Период 					= ВозвращениеФакт;
					СтрокаПробегШин.ТранспортноеСредство	= ВыборкаДетальныеЗаписи.ТранспортноеСредство;
					СтрокаПробегШин.Грузоперевозка			= ВыборкаДетальныеЗаписи.Грузоперевозка;
					СтрокаПробегШин.Шина					= ВыборкаДетальныеЗаписиШины.Шина;
					
					Если ВыборкаДетальныеЗаписи.ТранспортноеСредство = ТранспортноеСредство тогда
						СтрокаПробегШин.Пробег = ВыборкаДетальныеЗаписи.Пробег;
					ИначеЕсли ВыборкаДетальныеЗаписи.ТранспортноеСредство = Прицеп Тогда
						СтрокаПробегШин.Пробег = ВыборкаДетальныеЗаписи.Пробег - ВыборкаДетальныеЗаписи.ПробегБезПрицепа;
					Конецесли;
					
				КонецЦикла;
				
			КонецЕсли;
			
			// CW_РаботаВодителей
			СтрокаРаботаВодителей = ДанныеДляПроведения.CW_РаботаВодителей.Добавить();
			СтрокаРаботаВодителей.Период 				= ВозвращениеФакт;
			СтрокаРаботаВодителей.ПутевойЛист			= Ссылка;
			СтрокаРаботаВодителей.Водитель				= ВыборкаДетальныеЗаписи.Водитель;
			СтрокаРаботаВодителей.Грузоперевозка		= ВыборкаДетальныеЗаписи.Грузоперевозка;
			СтрокаРаботаВодителей.Маршрут				= ВыборкаДетальныеЗаписи.Маршрут;
			СтрокаРаботаВодителей.КоличествоЕздок		= 1;
			СтрокаРаботаВодителей.Зарплата				= ВыборкаДетальныеЗаписи.Сумма;
			
		КонецЦикла;
		
		
	КонецЕсли;
	
	//CW_ТопливоТС
	Запрос = новый запрос;
	запрос.Текст = "ВЫБРАТЬ
	|	CW_ПутевойЛистТопливоВыдано.Ссылка КАК ПутевойЛист,
	|	CW_ПутевойЛистТопливоВыдано.Документ.Дата КАК Период,
	|	CW_ПутевойЛистТопливоВыдано.Объем КАК Объем
	|ПОМЕСТИТЬ ВТ_Приходы
	|ИЗ
	|	Документ.CW_ПутевойЛист.ТопливоВыдано КАК CW_ПутевойЛистТопливоВыдано
	|ГДЕ
	|	CW_ПутевойЛистТопливоВыдано.Ссылка = &Ссылка
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	CW_ПутевойЛистЗаправки.Ссылка,
	|	CW_ПутевойЛистЗаправки.ДатаЗаправки,
	|	CW_ПутевойЛистЗаправки.Количество
	|ИЗ
	|	Документ.CW_ПутевойЛист.Заправки КАК CW_ПутевойЛистЗаправки
	|ГДЕ
	|	CW_ПутевойЛистЗаправки.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Приходы.ПутевойЛист КАК ПутевойЛист,
	|	ВТ_Приходы.Период КАК Период,
	|	СУММА(ВТ_Приходы.Объем) КАК Объем
	|ИЗ
	|	ВТ_Приходы КАК ВТ_Приходы
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_Приходы.Период,
	|	ВТ_Приходы.ПутевойЛист";
	
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	
	РезультатЗапроса = запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		СтрокаСостоянияТС = ДанныеДляПроведения.CW_ТопливоТС.Добавить();
		СтрокаСостоянияТС.Период 				= Выборка.Период;
		СтрокаСостоянияТС.ВидДвижения           = ВидДвиженияНакопления.Приход;
		СтрокаСостоянияТС.Организация 			= Организация;
		СтрокаСостоянияТС.ТранспортноеСредство 	= ТранспортноеСредство;
		СтрокаСостоянияТС.Топливо 				= Топливо;
		СтрокаСостоянияТС.Количество 			= Выборка.Объем;
	КонецЦикла;
	
	//	CW_ЗаправкиПодотчетныхЛиц
	//  CW_ЗаправкиТопливнымиКартами
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	CW_ПутевойЛистЗаправки.ДатаЗаправки КАК Период,
	|	CW_ПутевойЛистЗаправки.Ссылка.ТранспортноеСредство КАК ТранспортноеСредство,
	|	ВЫБОР
	|		КОГДА CW_ПутевойЛистЗаправки.Водитель = ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.пустаяСсылка)
	|			ТОГДА CW_ПутевойЛистЗаправки.Ссылка.Водитель
	|		ИНАЧЕ CW_ПутевойЛистЗаправки.Водитель
	|	КОНЕЦ КАК Водитель,
	|	CW_ПутевойЛистЗаправки.Топливо КАК Топливо,
	|	CW_ПутевойЛистЗаправки.ТопливнаяКарта КАК ТопливнаяКарта,
	|	CW_ПутевойЛистЗаправки.Документ КАК ПервичныйДокумент,
	|	CW_ПутевойЛистЗаправки.Количество КАК Количество,
	|	CW_ПутевойЛистЗаправки.Сумма КАК Сумма,
	|	CW_ПутевойЛистЗаправки.НДС КАК НДС,
	|	CW_ПутевойЛистЗаправки.Всего КАК Всего,
	|	CW_ПутевойЛистЗаправки.Валюта КАК Валюта,
	|	CW_ПутевойЛистЗаправки.СтавкаНДС КАК СтавкаНДС,
	|	CW_ПутевойЛистЗаправки.ВариантЗаправки КАК ВариантЗаправки,
	|	CW_ПутевойЛистЗаправки.Контрагент КАК Контрагент,
	|	CW_ПутевойЛистЗаправки.ДокументНомер КАК ДокументНомер,
	|	CW_ПутевойЛистЗаправки.ДокументДата КАК ДокументДата,
	|	CW_ПутевойЛистЗаправки.Ссылка.Организация КАК Организация
	|ПОМЕСТИТЬ ВТ_ДанныеЗаправок
	|ИЗ
	|	Документ.CW_ПутевойЛист.Заправки КАК CW_ПутевойЛистЗаправки
	|ГДЕ
	|	CW_ПутевойЛистЗаправки.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ДанныеЗаправок.Период КАК Период,
	|	ВТ_ДанныеЗаправок.ТранспортноеСредство КАК ТранспортноеСредство,
	|	ВТ_ДанныеЗаправок.Водитель КАК Водитель,
	|	ВТ_ДанныеЗаправок.Топливо КАК Топливо,
	|	ВТ_ДанныеЗаправок.ТопливнаяКарта КАК ТопливнаяКарта,
	|	ВТ_ДанныеЗаправок.ПервичныйДокумент КАК ПервичныйДокумент,
	|	СУММА(ВТ_ДанныеЗаправок.Количество) КАК Количество,
	|	ВТ_ДанныеЗаправок.ДокументНомер КАК ДокументНомер,
	|	ВТ_ДанныеЗаправок.ДокументДата КАК ДокументДата,
	|	ВТ_ДанныеЗаправок.Организация КАК Организация
	|ИЗ
	|	ВТ_ДанныеЗаправок КАК ВТ_ДанныеЗаправок
	|ГДЕ
	|	ВТ_ДанныеЗаправок.ВариантЗаправки = ЗНАЧЕНИЕ(Перечисление.CW_ВариантыЗаправокТС.ТопливнаяКарта)
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_ДанныеЗаправок.ТранспортноеСредство,
	|	ВТ_ДанныеЗаправок.Топливо,
	|	ВТ_ДанныеЗаправок.Период,
	|	ВТ_ДанныеЗаправок.Водитель,
	|	ВТ_ДанныеЗаправок.ПервичныйДокумент,
	|	ВТ_ДанныеЗаправок.ТопливнаяКарта,
	|	ВТ_ДанныеЗаправок.ДокументНомер,
	|	ВТ_ДанныеЗаправок.ДокументДата,
	|	ВТ_ДанныеЗаправок.Организация
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ДанныеЗаправок.Период КАК Период,
	|	ВТ_ДанныеЗаправок.ТранспортноеСредство КАК ТранспортноеСредство,
	|	ВТ_ДанныеЗаправок.Водитель КАК Водитель,
	|	ВТ_ДанныеЗаправок.Топливо КАК Топливо,
	|	ВТ_ДанныеЗаправок.ПервичныйДокумент КАК ПервичныйДокумент,
	|	ВТ_ДанныеЗаправок.Валюта КАК Валюта,
	|	ВТ_ДанныеЗаправок.СтавкаНДС КАК СтавкаНДС,
	|	СУММА(ВТ_ДанныеЗаправок.Количество) КАК Количество,
	|	СУММА(ВТ_ДанныеЗаправок.Сумма) КАК Сумма,
	|	СУММА(ВТ_ДанныеЗаправок.НДС) КАК НДС,
	|	СУММА(ВТ_ДанныеЗаправок.Всего) КАК Всего,
	|	ВТ_ДанныеЗаправок.Контрагент КАК Контрагент,
	|	ВТ_ДанныеЗаправок.ДокументНомер КАК ДокументНомер,
	|	ВТ_ДанныеЗаправок.ДокументДата КАК ДокументДата,
	|	ВТ_ДанныеЗаправок.Организация КАК Организация
	|ИЗ
	|	ВТ_ДанныеЗаправок КАК ВТ_ДанныеЗаправок
	|ГДЕ
	|	ВТ_ДанныеЗаправок.ВариантЗаправки = ЗНАЧЕНИЕ(Перечисление.CW_ВариантыЗаправокТС.НаличныйРасчет)
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_ДанныеЗаправок.Период,
	|	ВТ_ДанныеЗаправок.ТранспортноеСредство,
	|	ВТ_ДанныеЗаправок.Топливо,
	|	ВТ_ДанныеЗаправок.ПервичныйДокумент,
	|	ВТ_ДанныеЗаправок.Валюта,
	|	ВТ_ДанныеЗаправок.СтавкаНДС,
	|	ВТ_ДанныеЗаправок.Водитель,
	|	ВТ_ДанныеЗаправок.Контрагент,
	|	ВТ_ДанныеЗаправок.ДокументНомер,
	|	ВТ_ДанныеЗаправок.ДокументДата,
	|	ВТ_ДанныеЗаправок.Организация";
	
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	
	ПакетРезультатЗапроса = Запрос.ВыполнитьПакет();
	
	ВыборкаДетальныеЗаписиТоплвныеКарты = ПакетРезультатЗапроса[1].Выбрать();
	
	Пока ВыборкаДетальныеЗаписиТоплвныеКарты.Следующий() Цикл
		
		СтрокаЗаправкиТопливнымиКартами = ДанныеДляПроведения.CW_ЗаправкиТопливнымиКартами.Добавить();
		
		ЗаполнитьЗначенияСвойств(СтрокаЗаправкиТопливнымиКартами, ВыборкаДетальныеЗаписиТоплвныеКарты);
		
	КонецЦикла;
	
	
	ВыборкаДетальныеЗаписиПодотчетныеЛица = ПакетРезультатЗапроса[2].Выбрать();
	
	Пока ВыборкаДетальныеЗаписиПодотчетныеЛица.Следующий() Цикл
		
		СтрокаЗаправкиПодотчетныхЛиц = ДанныеДляПроведения.CW_ЗаправкиПодотчетныхЛиц.Добавить();
		
		ЗаполнитьЗначенияСвойств(СтрокаЗаправкиПодотчетныхЛиц, ВыборкаДетальныеЗаписиПодотчетныеЛица);
		
	КонецЦикла;
	
	
	Если ЗначениеЗаполнено(ДатаЗакрытия) Тогда
		//Данные списания ГСМ
		//	CW_РасходГСМТС
		Запрос_ВидОтражения = Новый Запрос;
		Запрос_ВидОтражения.Текст = 
		"ВЫБРАТЬ
		|	CW_ПутевойЛистОтражениеРасходовСверхНорматива.ВариантОтраженияЗатратПоБУ КАК ВариантОтраженияЗатратПоБУ,
		|	СУММА(CW_ПутевойЛистОтражениеРасходовСверхНорматива.Количество) КАК Количество
		|ПОМЕСТИТЬ ВТ_Документ
		|ИЗ
		|	Документ.CW_ПутевойЛист.ОтражениеРасходовСверхНорматива КАК CW_ПутевойЛистОтражениеРасходовСверхНорматива
		|ГДЕ
		|	CW_ПутевойЛистОтражениеРасходовСверхНорматива.Ссылка = &Ссылка
		|
		|СГРУППИРОВАТЬ ПО
		|	CW_ПутевойЛистОтражениеРасходовСверхНорматива.ВариантОтраженияЗатратПоБУ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СУММА(ВТ_Документ.Количество) КАК Количество
		|ПОМЕСТИТЬ ВТ_Итог
		|ИЗ
		|	ВТ_Документ КАК ВТ_Документ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_Документ.ВариантОтраженияЗатратПоБУ КАК ВариантОтраженияЗатратПоБУ,
		|	ВТ_Документ.Количество КАК Количество,
		|	ВТ_Итог.Количество КАК КоличествоВсего,
		|	ВТ_Документ.Количество / ВТ_Итог.Количество КАК Коэффициент
		|ИЗ
		|	ВТ_Документ КАК ВТ_Документ,
		|	ВТ_Итог КАК ВТ_Итог";
		
		Запрос_ВидОтражения.УстановитьПараметр("Ссылка", Ссылка);
		
		Результат_ВидОтражения =  Запрос_ВидОтражения.Выполнить();
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	CW_ПутевойЛистЭтапыМаршрута.Ссылка.Организация КАК Организация,
		|	CW_ПутевойЛистЭтапыМаршрута.Ссылка КАК ПутевойЛист,
		|	CW_ПутевойЛистЭтапыМаршрута.Ссылка.ТранспортноеСредство КАК ТранспортноеСредство,
		|	CW_ПутевойЛистЭтапыМаршрута.Грузоперевозка КАК Грузоперевозка,
		|	CW_ПутевойЛистЭтапыМаршрута.Ссылка.Топливо КАК Номенклатура,
		|	СУММА(CW_ПутевойЛистЭтапыМаршрута.РасходФакт) КАК РасходФакт,
		|	СУММА(CW_ПутевойЛистЭтапыМаршрута.РасходНорма) КАК РасходНорма
		|ИЗ
		|	Документ.CW_ПутевойЛист.ЭтапыМаршрута КАК CW_ПутевойЛистЭтапыМаршрута
		|ГДЕ
		|	CW_ПутевойЛистЭтапыМаршрута.Ссылка = &Ссылка
		|
		|СГРУППИРОВАТЬ ПО
		|	CW_ПутевойЛистЭтапыМаршрута.Грузоперевозка,
		|	CW_ПутевойЛистЭтапыМаршрута.Ссылка,
		|	CW_ПутевойЛистЭтапыМаршрута.Ссылка.ТранспортноеСредство,
		|	CW_ПутевойЛистЭтапыМаршрута.Ссылка.Топливо,
		|	CW_ПутевойЛистЭтапыМаршрута.Ссылка.Организация";
		
		Запрос.УстановитьПараметр("Ссылка", Ссылка);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			
			РасходНорма 					= ?(ПриравнятьФактическийРасходКНормативному, ВыборкаДетальныеЗаписи.РасходФакт, ВыборкаДетальныеЗаписи.РасходНорма);
			РасходСверхНормыПоСтроке 		= Макс(0,ВыборкаДетальныеЗаписи.РасходФакт - РасходНорма);
			РасходВПределахНорммыПоСтроке 	= Мин(РасходНорма,ВыборкаДетальныеЗаписи.РасходФакт);
			
			//CW_РасходГСМТС
			
			//РасходПоНорме
			СтрокаРасходПоНорме = ДанныеДляПроведения.CW_РасходГСМТС.Добавить();
			
			ЗаполнитьЗначенияСвойств(СтрокаРасходПоНорме,ВыборкаДетальныеЗаписи);
			
			СтрокаРасходПоНорме.Период 						= ДатаЗакрытия;
			СтрокаРасходПоНорме.ВидРасходаТоплива    		= ПредопределенноеЗначение("Перечисление.CW_ВидыРасходаТоплива.РасходПоНорме");
			СтрокаРасходПоНорме.Количество 					= РасходНорма;
			//	СтрокаРасходПоНорме.ВариантОтраженияЗатратПоБУ 	= ПредопределенноеЗначение("Справочник.CW_ВариантыОтраженияЗатратПоБУ.СписаниеНаСобсвенныеЗатраты");
			
			//РасходФактический
			СтрокаРасходФактическийС = ДанныеДляПроведения.CW_РасходГСМТС.Добавить();
			
			ЗаполнитьЗначенияСвойств(СтрокаРасходФактическийС,ВыборкаДетальныеЗаписи);
			
			СтрокаРасходФактическийС.Период 						= ДатаЗакрытия;
			СтрокаРасходФактическийС.ВидРасходаТоплива     			= ПредопределенноеЗначение("Перечисление.CW_ВидыРасходаТоплива.РасходФактический");
			СтрокаРасходФактическийС.Количество 					= ВыборкаДетальныеЗаписи.РасходФакт;
			//	СтрокаРасходФактическийС.ВариантОтраженияЗатратПоБУ 	= ПредопределенноеЗначение("Справочник.CW_ВариантыОтраженияЗатратПоБУ.СписаниеНаСобсвенныеЗатраты");
			
			
			//РасходВПределахНорммы
			СтрокаРасходВПределахНорммы = ДанныеДляПроведения.CW_РасходГСМТС.Добавить();
			
			ЗаполнитьЗначенияСвойств(СтрокаРасходВПределахНорммы,ВыборкаДетальныеЗаписи);
			
			СтрокаРасходВПределахНорммы.Период 						= ДатаЗакрытия;
			СтрокаРасходВПределахНорммы.ВидРасходаТоплива     		= ПредопределенноеЗначение("Перечисление.CW_ВидыРасходаТоплива.РасходВПределахНормы");
			СтрокаРасходВПределахНорммы.Количество 					= РасходВПределахНорммыПоСтроке;
			//		СтрокаРасходВПределахНорммы.ВариантОтраженияЗатратПоБУ 	= ПредопределенноеЗначение("Справочник.CW_ВариантыОтраженияЗатратПоБУ.СписаниеНаСобсвенныеЗатраты");
			
			//РасходСверхНормы
			Если РасходСверхНормыПоСтроке > 0 Тогда
				Выборка_ВидОтражения = Результат_ВидОтражения.Выбрать();
				
				ИтогоРаспределено = 0;
				Пока Выборка_ВидОтражения.Следующий() и РасходСверхНормыПоСтроке > 0  Цикл
					
					Распределено = Окр(РасходСверхНормыПоСтроке * Выборка_ВидОтражения.Коэффициент, 3);
					
					СтрокаРасходСверхНормы = ДанныеДляПроведения.CW_РасходГСМТС.Добавить();
					
					ЗаполнитьЗначенияСвойств(СтрокаРасходСверхНормы,ВыборкаДетальныеЗаписи);
					
					СтрокаРасходСверхНормы.Период 						= ДатаЗакрытия;
					СтрокаРасходСверхНормы.ВидРасходаТоплива     		= ПредопределенноеЗначение("Перечисление.CW_ВидыРасходаТоплива.РасходСверхНормы");
					СтрокаРасходСверхНормы.Количество 					= Распределено;
					СтрокаРасходСверхНормы.ВариантОтраженияЗатратПоБУ 	= Выборка_ВидОтражения.ВариантОтраженияЗатратПоБУ;
					
					ИтогоРаспределено = ИтогоРаспределено + Распределено;
				КонецЦикла;
				
				Если РасходСверхНормыПоСтроке <> ИтогоРаспределено и СтрокаРасходСверхНормы <> Неопределено Тогда
					Погрешность = РасходВПределахНорммыПоСтроке - ИтогоРаспределено;
					СтрокаРасходСверхНормы.Количество =  СтрокаРасходСверхНормы.Количество + Погрешность;
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	//  CW_РаботаВодителей
	
	
	Возврат ДанныеДляПроведения;
	
	
КонецФункции

