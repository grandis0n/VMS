&НаСервере
Процедура _ОбработатьИзменениеСчета(ИдентификаторСтроки)
	// --- 
	
	СтрокаТЧ = Объект.КорректировкаАктирования.НайтиПоИдентификатору(ИдентификаторСтроки);
	
	Если (Объект.Договор.ВалютаДоговора <> БазоваяВалюта) Тогда
		
		// подставляем текущий курс
		Если (НЕ Объект.Договор.ВалютаДоговора.Пустая()) Тогда
			
			СК = CW_Финансы.ПолучитьКурсВалюты(Объект.Договор.ВалютаДоговора,Объект.Дата);
			СтрокаТЧ.Курс = СК.Курс;
			
		КонецЕсли; 
		
	КонецЕсли; 
	
	// снимаем остатки по счету в разрезе счетов учета
	Если (Объект.Договор.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком) Тогда
		
		Счет = СтрокаТЧ.ВходящийСчет;
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	CW_ОперативнаяКредиторскаяЗадолженностьОстатки.Счет КАК Счет,
		               |	CW_ОперативнаяКредиторскаяЗадолженностьОстатки.СчетУчета КАК СчетЗадолженности,
		               |	CW_ОперативнаяКредиторскаяЗадолженностьОстатки.Всего_ВалютаОстаток КАК Сумма,
		               |	CW_ОперативнаяКредиторскаяЗадолженностьОстатки.ВсегоОстаток КАК Сумма_БВ
		               |ИЗ
		               |	РегистрНакопления.CW_ОперативнаяКредиторскаяЗадолженность.Остатки(
		               |			&Период,
		               |			Организация = &Организация
		               |				И Контрагент = &Контрагент
		               |				И Договор = &Договор
					   //Подсистема.УчетПриложенийДоговоров
		               |				И ПриложениеКДоговору = &ПриложениеКДоговору
					   //Подсистема.УчетПриложенийДоговоров
		               |				И Валюта = &Валюта
		               |				И Счет = &Счет) КАК CW_ОперативнаяКредиторскаяЗадолженностьОстатки";
		
	ИначеЕсли Объект.Договор.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПокупателем Тогда
		
		Счет = СтрокаТЧ.ИсходящийСчет;
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	CW_ОперативнаяДебиторскаяЗадолженностьОстатки.Счет КАК Счет,
		               |	CW_ОперативнаяДебиторскаяЗадолженностьОстатки.СчетУчета КАК СчетЗадолженности,
		               |	CW_ОперативнаяДебиторскаяЗадолженностьОстатки.Всего_ВалютаОстаток КАК Сумма,
		               |	CW_ОперативнаяДебиторскаяЗадолженностьОстатки.ВсегоОстаток КАК Сумма_БВ
		               |ИЗ
		               |	РегистрНакопления.CW_ОперативнаяДебиторскаяЗадолженность.Остатки(
		               |			&Период,
		               |			Организация = &Организация
		               |				И Контрагент = &Контрагент
		               |				И Договор = &Договор
					   //Подсистема.УчетПриложенийДоговоров
		               |				И ПриложениеКДоговору = &ПриложениеКДоговору
					   //Подсистема.УчетПриложенийДоговоров
		               |				И Валюта = &Валюта
					   |				И Счет = &Счет) КАК CW_ОперативнаяДебиторскаяЗадолженностьОстатки";
		
	КонецЕсли; 
	
	_сф.ст_ДобавитьСвойства(Запрос.Параметры,"Организация,Контрагент,Договор,Валюта",Объект);
	Запрос.УстановитьПараметр("Счет", Счет); 
	Запрос.УстановитьПараметр("Период", Новый Граница(Объект.Дата,ВидГраницы.Исключая));
	
	//Подсистема.УчетПриложенийДоговоров
	Запрос.УстановитьПараметр("ПриложениеКДоговору", Объект.ПриложениеКДоговору); 
	//Подсистема.УчетПриложенийДоговоров
	
	ТЗ = Запрос.Выполнить().Выгрузить();
	
	Если (ТЗ.Количество() <> 0) Тогда
		
		Если (ТЗ.Количество() =1) Тогда
			
			СтрокаЗапроса = ТЗ[0];
			СтрокаТЧ.СчетУчета = СтрокаЗапроса.СчетУчета;
			СтрокаТЧ.Сумма = СтрокаЗапроса.Сумма;
			
		Иначе
			
			СтрокаТЧ.СчетУчета = ТЗ[0].СчетУчета;
			
		КонецЕсли; 
		
	КонецЕсли; 
	
	// --- 
КонецПроцедуры

