Процедура ОбновитьИтоги()
	
	// итоговая строка по табличной части "Услуги" 
	СВ = Строка(Объект.Договор.ВалютаДоговора);
	ФЧ = "ЧЦ=15; ЧДЦ=2; ЧН=";
	Элементы.СтраницаСписание.Заголовок = "Актирование ("+Строка(Объект.КорректировкаАктирования.Количество())+")";
	Если Объект.КорректировкаАктирования.Количество() = 0 Тогда
		ИтогоПоКорректировке = "Нет данных";
	Иначе
		ИтогоПоКорректировке =	"Сумма: "+Формат(Объект.КорректировкаАктирования.Итог("Сумма"),ФЧ)+" " +СВ
		+"; НДС: "+Формат(Объект.КорректировкаАктирования.Итог("НДС"),ФЧ)+" " +СВ
		+"; Всего: "+Формат(Объект.КорректировкаАктирования.Итог("Всего"),ФЧ)+" " +СВ;
	КонецЕсли;
						
КонецПроцедуры

