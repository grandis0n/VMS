
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	CW_Документы.УстановитьПараметрыФункциональныхОпцийФормы(Этаформа);
	// ---------------------------------------------------------------------------- 
	ИспользованиеСхемыПеревыставленияПоСтавкам = ПолучитьФункциональнуюОпцию("CW_ИспользованиеСхемыПеревыставленияПоСтавкам");
	
	ВедетсяУчетПриложенийПоДоговорам = ПолучитьФункциональнуюОпцию("CW_ВедетсяУчетПриложенийПоДоговорам");
	
	
	_ПраваДоступа();
	
	БазоваяВалюта = CW_Настройки.ВалютаРегламентированногоУчета();
	// --- 
	Если (Объект.Ссылка.Пустая()) Тогда
		Если (Объект.Организация.Пустая()) Тогда
			
			ОсновнаяОрганизация = CW_Настройки.ОсновнаяОрганизация();
			Если ЗначениеЗаполнено(ОсновнаяОрганизация) Тогда
				Объект.Организация = ОсновнаяОрганизация;	
			КонецЕсли;
			
		КонецЕсли;
	КонецЕсли; 
	// --- 
	
	Если ЗначениеЗаполнено(Объект.Договор) Тогда
		ПараметрыОпции = Новый Структура;
		ПараметрыОпции.Вставить("CW_ДоговорПоГрузоперевозкам", Объект.Договор);
		
		ВедетсяУчетПриложенийПоДоговору = ПолучитьФункциональнуюОпцию("CW_УчитыватьПриложенияВДокументах", ПараметрыОпции);
		
		Валюта = Объект.Договор.ВалютаДоговора;
		Если ВедетсяУчетПриложенийПоДоговорам и ВедетсяУчетПриложенийПоДоговору и ЗначениеЗаполнено(Объект.ПриложениеКДоговору) Тогда
			Валюта	= Объект.ПриложениеКДоговору.ВалютаДоговора;
		КонецЕсли;
	КонецЕсли;
	
	_ОбновитьПредставление_Списание();
	
	ОбновитьИтоги();
	
	_УФС.ОтключитьИсториюВыбораЭлементовФормы(ЭтаФорма);
	
	_УправлениеЭлементамиФормы();
	
	_СформироватьЗаголовок();
	// --- 
	СостояниеДокумента = ОбщегоНазначенияБП.СостояниеДокумента(Объект); // ВызовБП
	
	Если ИспользованиеСхемыПеревыставленияПоСтавкам Тогда
		Элементы.КорректировкаПорядокОтражения.СписокВыбора.Добавить(Перечисления.CW_ПорядокОтраженияДоходов.ПеревыставлениеПоСтавкам);
	КонецЕсли;
	
	//Подсистема.УчетПриложенийДоговоров
	CW_УчетПриложенийДоговоровСервер.ПриСозданииНаСервере(ЭтаФорма, Отказ, СтандартнаяОбработка);
	//Подсистема.УчетПриложенийДоговоров	
	
	//Внешние подклчюаемые команды
	CW_ПодключаемыеКомандыСервер.ПриСозданииНаСервере(ЭтотОбъект);

КонецПроцедуры

