Функция _ГрузоперевозкиСчета(ИдентификторСтроки)
	// --- 
	
	СтрокаТЧ = Объект.КорректировкаАктирования.НайтиПоИдентификатору(ИдентификторСтроки);
	Если (Объект.Договор.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПокупателем) Тогда
		Счет = СтрокаТЧ.ИсходящийСчет;
	Иначе
		Счет = СтрокаТЧ.ВходящийСчет;
	КонецЕсли; 
	
	ГП = Счет.Услуги.Выгрузить(,"Грузоперевозка");
	ГП.Свернуть("Грузоперевозка");
	
	Возврат(ГП.ВыгрузитьКолонку("Грузоперевозка"));
	
	// --- 
