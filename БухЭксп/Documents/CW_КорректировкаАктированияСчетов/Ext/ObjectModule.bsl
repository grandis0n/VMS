Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	Если РучнаяКорректировка Тогда
		Возврат;
	КонецЕсли; 	
	
	Если Договор.ВидДоговора = ПредопределенноеЗначение("Перечисление.ВидыДоговоровКонтрагентов.СПоставщиком") Тогда
		Регистр 		= Движения.CW_АктированиеВходящихСчетов;
		РеквизитСчета 	= "ВходящийСчет";
	ИначеЕсли Договор.ВидДоговора = ПредопределенноеЗначение("Перечисление.ВидыДоговоровКонтрагентов.СПокупателем") Тогда 
		Регистр 		= Движения.CW_АктированиеИсходящихСчетов;
		РеквизитСчета 	= "ИсходящийСчет";
	Иначе
		Возврат;
	КонецЕсли; 
	
	ВедетсяУчетПриложенийПоДоговорам = ПолучитьФункциональнуюОпцию("CW_ВедетсяУчетПриложенийПоДоговорам");
	
	ПараметрыОпции = Новый Структура;
	ПараметрыОпции.Вставить("CW_ДоговорПоГрузоперевозкам", Договор);
	ВедетсяУчетПриложенийПоДоговору = ПолучитьФункциональнуюОпцию("CW_УчитыватьПриложенияВДокументах", ПараметрыОпции);
	
	Для каждого СтрокаДокумента Из КорректировкаАктирования Цикл
		
		Движение = Регистр.Добавить();
		
		ЗаполнитьЗначенияСвойств(Движение,СтрокаДокумента);
		
		Если СтрокаДокумента.ВидДвижения = 0 Тогда
			Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
		Иначе
			Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
		КонецЕсли;
		
		Движение.Период 				= Дата;
		
		Движение.Счет 					= СтрокаДокумента[РеквизитСчета];
		Движение.Организация 			= Организация;
		Движение.Контрагент 			= Контрагент;
		Движение.Договор 				= Договор;
		Движение.Валюта 				= Договор.ВалютаДоговора;
		
		//Подсистема.УчетПриложенийДоговоров
		Движение.ПриложениеКДоговору 	= ПриложениеКДоговору;
		
		Если ВедетсяУчетПриложенийПоДоговорам и ВедетсяУчетПриложенийПоДоговору и ЗначениеЗаполнено(ПриложениеКДоговору) Тогда
			Движение.Валюта	= ПриложениеКДоговору.ВалютаДоговора;
		КонецЕсли;
		//Подсистема.УчетПриложенийДоговоров
		
	КонецЦикла; 
		
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	
	Если (РучнаяКорректировка) Тогда
		Возврат;
	КонецЕсли; 
	
	//Если (РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения
	//	ИЛИ РежимЗаписи) Тогда
	//	
	//КонецЕсли; 
	
	Для каждого Набор Из Движения Цикл
		
		Набор.Прочитать();
		Набор.Очистить();
		
	КонецЦикла;
	Движения.Записать();
	
КонецПроцедуры


