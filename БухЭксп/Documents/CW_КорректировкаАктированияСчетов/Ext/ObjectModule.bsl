Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	CW_Документы.ЗаполнениеДокументов(ЭтотОбъект);
	
	Если (ТипЗнч(ДанныеЗаполнения)=Тип("ДокументСсылка.CW_ДоходыПоГрузоперевозке")) Тогда
		
		// заполняем шапку
		Организация = ДанныеЗаполнения.Организация;
		Контрагент = ДанныеЗаполнения.Контрагент;
		Договор = ДанныеЗаполнения.Договор;
		
		// заполняем ТЧ - снимаем остатки по регистру актирования исходящих счетов
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		|	CW_АктированиеИсходящихСчетовОстатки.Счет КАК ИсходящийСчет,
		|	CW_АктированиеИсходящихСчетовОстатки.Организация,
		|	CW_АктированиеИсходящихСчетовОстатки.Контрагент,
		|	CW_АктированиеИсходящихСчетовОстатки.Договор,
		|	CW_АктированиеИсходящихСчетовОстатки.Валюта,
		|	CW_АктированиеИсходящихСчетовОстатки.Грузоперевозка,
		|	CW_АктированиеИсходящихСчетовОстатки.ПорядокОтражения,
		|	CW_АктированиеИсходящихСчетовОстатки.Номенклатура,
		|	CW_АктированиеИсходящихСчетовОстатки.СтавкаНДС,
		|	CW_АктированиеИсходящихСчетовОстатки.ВсегоОстаток КАК Всего,
		|	CW_АктированиеИсходящихСчетовОстатки.НДСОстаток КАК НДС,
		|	CW_АктированиеИсходящихСчетовОстатки.СуммаОстаток КАК Сумма
		|ИЗ
		|	РегистрНакопления.CW_АктированиеИсходящихСчетов.Остатки(&Период, Счет = &Счет) КАК CW_АктированиеИсходящихСчетовОстатки";
		
		Запрос.УстановитьПараметр("Период", Дата);
		Запрос.УстановитьПараметр("Счет", 	ДанныеЗаполнения);
		// --- 
		ТЗ = Запрос.Выполнить().Выгрузить();
		// --- 
		КорректировкаАктирования.Загрузить(ТЗ);
		
	КонецЕсли; 
	
	
КонецПроцедуры

