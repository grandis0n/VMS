Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	Для каждого Стр Из ТаблицаКорректировки Цикл
		
		Если ВидОперации = 0 Тогда
			Движение = Движения.CW_Перевыставление.Добавить();
		Иначе
			Движение = Движения.CW_ПеревыставлениеПоСтавкам.Добавить();
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(Движение, Стр);
		Движение.Период = Дата;
		Движение.ВидДвижения = ?(Стр.ВидДвижения=0,ВидДвиженияНакопления.Приход,ВидДвиженияНакопления.Расход);
		
	КонецЦикла; 
	
КонецПроцедуры

