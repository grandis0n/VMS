//Заполнение табличной части документа
&НаКлиенте
Процедура ЗаполнитьДокумент(Команда)

	ПараметрыЗаполнения = ПолучитьПараметрыЗаполненияТабличнойЧасти("ТаблицаКорректировки"); 
	CW_ЗаполнениеДокументовКлиент.ПередНачаломЗаполненияДокумента(ПараметрыЗаполнения);

КонецПроцедуры   

&НаКлиенте
Функция ПолучитьПараметрыЗаполненияТабличнойЧасти(Знач ИмяТабличнойЧасти, Знач ПоказатьФормуОтбора=Истина)
	
	ДатаСреза 	= ?(Объект.Дата =Дата(1,1,1), ТекущаяДата(), Объект.Дата); 

	Если Объект.ВидОперации = 0 Тогда
		ИмяМакета = "ЗаполнитьПоПеревыставлению"
	Иначе
		ИмяМакета = "ЗаполнитьПоПеревыставлениюПоСтавкам"
	КонецЕсли;
	
	ДополлнительныеПараметры = Новый Структура;
	ДополлнительныеПараметры.Вставить("ИмяТабличнойЧасти", ИмяТабличнойЧасти);
	
  	Оповещение 	= Новый ОписаниеОповещения("ЗаполнитьТабличнюЧасть", ЭтотОбъект, ДополлнительныеПараметры);
	
	ПараметрыЗаполнения = CW_ЗаполнениеДокументовКлиент.НоваяСтруктураПараметровЗаполнения(); 
	
	ПараметрыЗаполнения.Отбор.Вставить("Договор.Организация", Объект.Организация);

	ПараметрыЗаполнения.ПараметрыДанных.Вставить("Период", ДатаСреза); 
	
	ПараметрыЗаполнения.ПустаяСсылка 		= ПредопределенноеЗначение("Документ.CW_КорректировкаПеревыставления.ПустаяСсылка");
	ПараметрыЗаполнения.Форма 				= ЭтаФорма;
	ПараметрыЗаполнения.ИмяТабличнойЧасти 	= ИмяТабличнойЧасти;
	ПараметрыЗаполнения.ИмяМакета 			= ИмяМакета;
	ПараметрыЗаполнения.ПоказатьФормуОтбора = ПоказатьФормуОтбора;
	ПараметрыЗаполнения.Оповещение 			= Оповещение;
	ПараметрыЗаполнения.КонтрольЗаполненияРеквизитовФормы = Истина;
	
	Возврат ПараметрыЗаполнения;  
	
КонецФункции

&НаКлиенте
Процедура ЗаполнитьТабличнюЧасть(Результат, ДополлнительныеПараметры) Экспорт
	
	Если Результат = Неопределено 
		или Не ЭтоАдресВременногоХранилища(Результат) Тогда
		Возврат;
	КонецЕсли;
	
	РезультатЗаполнения = ЗаполнитьТабличннуюЧастьНаСервере(Результат, ДополлнительныеПараметры);
	
	Если Не ПустаяСтрока(РезультатЗаполнения) Тогда
		ПоказатьПредупреждение(, РезультатЗаполнения);
	КонецЕсли;
	
КонецПроцедуры 

&НаСервере
Функция ЗаполнитьТабличннуюЧастьНаСервере(АдресТаблицы, ДополлнительныеПараметры)  
	
	ТаблицаЗначений = ПолучитьИзВременногоХранилища(АдресТаблицы);
	Если ТипЗнч(ТаблицаЗначений) = Тип("ТаблицаЗначений") Тогда 
		Если ТаблицаЗначений.Количество() = 0 Тогда
			Возврат "Не удалось получить данные для заполнения!";
		КонецЕсли;
		
		Объект[ДополлнительныеПараметры.ИмяТабличнойЧасти].Загрузить(ТаблицаЗначений);  
		ОбновитьИтогиТабличнойЧасти();
	Иначе
		Возврат "Не удалось заполнить таблицу документа!";
	КонецЕсли; 
	
	Возврат "";
	
КонецФункции 
//Заполнение табличной части документа


//Групповое Изменение Реквизитов Строки
&НаКлиенте
Процедура ГрупповоеИзменениеРеквизитовСтроки(Команда)  
	
	ВыделенныеСтроки = Элементы.ТаблицаКорректировки.ВыделенныеСтроки;
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ВыделенныеСтроки", ВыделенныеСтроки);
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ПродолжитьРедактированиеРеквизитовСтроки", ЭтотОбъект, ДополнительныеПараметры);
	
	ПараметрыРедактирования = Новый Структура; 
	ПараметрыРедактирования.Вставить("Ссылка", ПредопределенноеЗначение("Документ.CW_КорректировкаПеревыставления.ПустаяСсылка"));
	
	ОткрытьФорму("ОбщаяФорма.CW_ГрупповоеИзменениеРеквизитовСтрокДокументов", ПараметрыРедактирования, ЭтотОбъект,,,,ОписаниеОповещения);
	
КонецПроцедуры  

&НаКлиенте
Процедура ПродолжитьРедактированиеРеквизитовСтроки(Результат, ДополнительныеПараметры) Экспорт 
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ПродолжитьРедактированиеРеквизитовСтрокиНаСервере(Результат, ДополнительныеПараметры);
	
КонецПроцедуры  

&НаСервере
Процедура ПродолжитьРедактированиеРеквизитовСтрокиНаСервере(Результат, ДополнительныеПараметры)
	
	Для Каждого ИдентификаторСтроки из ДополнительныеПараметры.ВыделенныеСтроки Цикл
		
		СтрокаТаблицы  = Объект.ТаблицаКорректировки.НайтиПоИдентификатору(ИдентификаторСтроки); 
		
		Для Каждого КлючЗначение из Результат Цикл
			СтрокаТаблицы[КлючЗначение.Ключ] = КлючЗначение.Значение;
		КонецЦикла;
		
	КонецЦикла;  
	
	ОбновитьИтогиТабличнойЧасти();
	
КонецПроцедуры
//Групповое Изменение Реквизитов Строки

