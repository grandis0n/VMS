
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	CW_Документы.УстановитьПараметрыФункциональныхОпцийФормы(Этаформа);

	Если Параметры.Ключ.Пустая() Тогда
		Объект.Организация = CW_Настройки.ОсновнаяОрганизация();
	КонецЕсли;
	
	Если ЭтотОбъект.ТолькоПросмотр = Ложь Тогда
		УстановитьПраваДоступа();
	КонецЕсли;

	СформироватьЗаголовокФормыНаСервере();
	
	СтарыйВидОперации = Объект.ВидОперации;
	
	ОбновитьИтогиТабличнойЧасти();
	
	//Внешние подклчюаемые команды
	CW_ПодключаемыеКомандыСервер.ПриСозданииНаСервере(ЭтотОбъект);	
	
КонецПроцедуры  

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	ПодготовитьДанныеФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	//Подсистема.РаботаСПодключаемымиОбъектами
	CW_ПодключаемыеКомандыКлиент.ПослеЗаписи(ЭтотОбъект, ПараметрыЗаписи);
	//Подсистема.РаботаСПодключаемымиОбъектами

КонецПроцедуры 

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	СформироватьЗаголовокФормыНаСервере();
	ПодготовитьДанныеФормы();

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "ВыполнитьМетодВладельца" Тогда
		
		Если ТипЗнч(Параметр) = тип("Структура") Тогда
			УникальныйИдентификаторВладельца 	= Неопределено;
			МетодыФормыВладельца 				= Неопределено;
			
			Параметр.Свойство("УникальныйИдентификатор"	, УникальныйИдентификаторВладельца);
			Параметр.Свойство("МетодыФормыВладельца"	, МетодыФормыВладельца);
			
			Если ЭтаФорма.УникальныйИдентификатор = УникальныйИдентификаторВладельца Тогда
				Если Не МетодыФормыВладельца = Неопределено и ТипЗнч(МетодыФормыВладельца) = Тип("Массив") Тогда
					
					Для Каждого СтрокаМассива из МетодыФормыВладельца Цикл
						Попытка
							Выполнить(СтрокаМассива);
						Исключение
						КонецПопытки;
					КонецЦикла;
					
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;	

	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция СформироватьЗаголовокФормыНаСервере()
	
	Заголовок = ?(Объект.ВидОперации=0,"Перевыставление", "Перевыставление по ставкам");  
	
КонецФункции

&НаСервере
Процедура ОбновитьИтогиТабличнойЧасти()
	
	Элементы.СтрокаИтого.Заголовок = 	"ИТОГО по документу: Количество: "+ Формат(Объект.ТаблицаКорректировки.Итог("Количество")	, "ЧДЦ=3; ЧН=0,000")+
												"; Сумма: "	+ Формат(Объект.ТаблицаКорректировки.Итог("Сумма")		, "ЧДЦ=2; ЧН=0,00")+
												"; НДС: "	+ Формат(Объект.ТаблицаКорректировки.Итог("НДС")		, "ЧДЦ=2; ЧН=0,00")+
												"; Всего: "	+ Формат(Объект.ТаблицаКорректировки.Итог("Всего")		, "ЧДЦ=2; ЧН=0,00");
	
КонецПроцедуры

&НаСервере
Процедура ПодготовитьДанныеФормы()
	
	ЗаполнитьДобавленныеКолонкиТаблиц("ТаблицаКорректировки");
	
	//Подсистема.УчетПриложенийДоговоров
	CW_УчетПриложенийДоговоровСервер.УстановитьПризнакУчетаПоПриложениямВТабличнойЧасти(ЭтаФорма, "ТаблицаКорректировки");
	//Подсистема.УчетПриложенийДоговоров

КонецПроцедуры

Функция УстановитьПраваДоступа()
	
	ПравоРедактирования = CW_ПраваДоступа.ПравоДоступно("РедактированиеФинансов");
	Если НЕ ПравоРедактирования ИЛИ ЭтаФорма.ТолькоПросмотр Тогда
		ЭтаФорма.ТолькоПросмотр = Истина;
	КонецЕсли;
	
КонецФункции

