//ТаблицаКорректировки

&НаКлиенте
Процедура ВидОперацииПриИзменении(Элемент)
	
	Если Объект.ТаблицаКорректировки.Количество() > 0 тогда
		
		Режим = РежимДиалогаВопрос.ДаНет;
		Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопроса", ЭтаФорма, Параметры);
		ПоказатьВопрос(Оповещение,"Табличная часть документа будет очищена. Продолжить?", Режим, 0); 
		
	Иначе
		СтарыйВидОперации = Объект.ВидОперации;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияВопроса(Результат, Параметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Нет Тогда
		Объект.ВидОперации = СтарыйВидОперации;
		Возврат;
	КонецЕсли;
	
	Объект.ТаблицаКорректировки.Очистить();
	
	СтарыйВидОперации = Объект.ВидОперации;

КонецПроцедуры

