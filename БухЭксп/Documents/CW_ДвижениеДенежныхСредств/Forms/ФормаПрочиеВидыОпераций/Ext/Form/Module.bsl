	// --- 
	
	Объект.Расшифровка.Загрузить(ПолучитьИзВременногоХранилища(Ответ.АдресТаблицыДокумента));
	Объект.СуммаВД = Объект.Расшифровка.Итог("СуммаВД");
	Объект.СуммаВК = Объект.Расшифровка.Итог("СуммаВК");
	// --- 
	_ОбновитьИтоги();
	
	// --- 
