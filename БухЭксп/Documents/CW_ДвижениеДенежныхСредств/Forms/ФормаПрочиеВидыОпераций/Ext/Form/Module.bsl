&НаСервере
Процедура РассчитатьНДСНаСервере()
	
	ТекСтавкаНДС  	= CW_Финансы.ПолучитьСтавкуНДС(Объект.СтавкаНДС);
	ЦенаСНДС 		= Объект.СуммаВК;
	Объект.СуммаНДС	= Окр(ЦенаСНДС /(100+ТекСтавкаНДС)*ТекСтавкаНДС, 2, 1);
	
КонецПроцедуры

&НаСервере
Процедура УчитыватьНДСПриИзмененииНаСервере()
	
	Элементы.ГруппаУчетНДС.Видимость = Объект.УчитыватьНДС;
	
	Если Объект.УчитыватьНДС Тогда
		//Заполняем счета МСФО
		Если НастройкиМСФО.Количество() > 0 Тогда
			ЭлементСписка 		= НастройкиМСФО.Получить(0);
			СтруктураНастроек 	= ЭлементСписка.Значение;
			
			Если Не ЗначениеЗаполнено(Объект.СчетНДС) и СтруктураНастроек.Свойство("СчетУчетаНДС") Тогда
				Объект.СчетНДС = СтруктураНастроек.СчетУчетаНДС;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

