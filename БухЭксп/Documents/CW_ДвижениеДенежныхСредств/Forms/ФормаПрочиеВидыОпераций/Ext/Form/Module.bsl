#КонецОбласти

//Взаиморасчеты по документу
&НаКлиенте
Процедура Команда_ВзаиморасчетыПоДокументу(Команда)
	
	Если Объект.Ссылка.Пустая() Тогда   
		Возврат;
	КонецЕсли;   
	
	Если Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.CW_ВидыОперацийДДС.ПоступлениеОтПокупателя") Тогда
		ВидЗадолженности ="ДЕБИТОРСКАЯ";
	ИначеЕсли Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.CW_ВидыОперацийДДС.ОплатаПоставщику") Тогда
		ВидЗадолженности ="КРЕДИТОРСКАЯ";
	ИначеЕсли Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.CW_ВидыОперацийДДС.ОплатаПоставщикуПоПриобретениям") Тогда
		ВидЗадолженности ="КРЕДИТОРСКАЯ";
	КонеЦЕсли;	
	
	CW_ВзаиморасчетыПоДокументуКлиент.ОткрытьФормуОтчетаВзаиморасчетыПоДокументу(ЭтаФорма, Объект.Ссылка, ВидЗадолженности);
	
КонецПроцедуры
//Взаиморасчеты по документу
