&НаСервере
Функция _УстановитьОтборДоговора()
	
	мПараметрыВыбора = Новый Массив;
	
	Если Объект.ВидОперации = Перечисления.CW_ВидыОперацийДДС.ОплатаПоставщику Тогда
		
		МассивЗначений = Новый Массив;
		МассивЗначений.Добавить(ПредопределенноеЗначение("Перечисление.ВидыДоговоровКонтрагентов.СПоставщиком"));
		МассивЗначений.Добавить(ПредопределенноеЗначение("Перечисление.ВидыДоговоровКонтрагентов.Прочее"));
		
		ФиксированныйМассив = Новый ФиксированныйМассив(МассивЗначений);
		
		мПараметрыВыбора.Добавить(Новый ПараметрВыбора("Отбор.ВидДоговора", ФиксированныйМассив));
		
	ИначеЕсли Объект.ВидОперации = Перечисления.CW_ВидыОперацийДДС.ПоступлениеОтПокупателя Тогда
		
		МассивЗначений = Новый Массив;
		МассивЗначений.Добавить(ПредопределенноеЗначение("Перечисление.ВидыДоговоровКонтрагентов.СПокупателем"));
		МассивЗначений.Добавить(ПредопределенноеЗначение("Перечисление.ВидыДоговоровКонтрагентов.Прочее"));
		
		ФиксированныйМассив = Новый ФиксированныйМассив(МассивЗначений);
		
		мПараметрыВыбора.Добавить(Новый ПараметрВыбора("Отбор.ВидДоговора", ФиксированныйМассив));
		
	ИначеЕсли Объект.ВидОперации = Перечисления.CW_ВидыОперацийДДС.ОплатаПоставщикуПоПриобретениям Тогда
		
		мПараметрыВыбора.Добавить(Новый ПараметрВыбора("Отбор.ВидДоговора", ПредопределенноеЗначение("Перечисление.ВидыДоговоровКонтрагентов.Прочее")));
		
	КонецЕсли; 
	
	Элементы.Договор.ПараметрыВыбора =  Новый ФиксированныйМассив(мПараметрыВыбора);

КонецФункции
 

&НаСервере
Функция _СписокВидовОпераций()
	
	МассивИсключамыхИмен = Новый Массив; 
	
	//Для операций "Возврат покупателю" и "Возврат поставщику" используются отдельная форма документа
	МассивИсключамыхИмен.Добавить("ВозвратПокупателю");
	МассивИсключамыхИмен.Добавить("ВозвратОтПоставщика");   
	
	Если Не ВедениеБухгалтескогоУчетаМСФО Тогда
		МассивИсключамыхИмен.Добавить("ОплатаПоставщикуПоПриобретениям");
	КонецЕсли;
	
	СписокОпераций = Новый СписокЗначений;
	Для каждого СтрЗначение Из Метаданные.Перечисления.CW_ВидыОперацийДДС.ЗначенияПеречисления Цикл
		Если МассивИсключамыхИмен.Найти(СтрЗначение.Имя) = Неопределено  Тогда
			СписокОпераций.Добавить(Перечисления.CW_ВидыОперацийДДС[СтрЗначение.Имя],СтрЗначение.Синоним);
		КонецЕсли;
	КонецЦикла; 
	
	Возврат СписокОпераций;
	
КонецФункции
 

&НаКлиенте
Процедура КассаПриИзменении(Элемент)
	
	_УправлениеЭлементамиФормы();
	
