
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	CW_Документы.УстановитьПараметрыФункциональныхОпцийФормы(Этаформа);

	ВедениеБухгалтескогоУчетаМСФО = ПолучитьФункциональнуюОпцию("CW_ВедениеБухгалтескогоУчетаМСФО");
	
	Если ВедениеБухгалтескогоУчетаМСФО Тогда
		ИмяНастроек 		= "Настойки_CW_ОперацииМСФО";
		СтруктураНастройки 	= Обработки.CW_ОперацииМСФО.ПолучитьНастройки(ИмяНастроек);
		НастройкиМСФО.Добавить(СтруктураНастройки);
	КонецЕсли;
		
	_ОбновитьИтоги();
	_УправлениеЭлементамиФормы();
	_СформироватьЗаголовок();
	
	//Взаиморасчеты по документу
	CW_ВзаиморасчетыПоДокументуСервер.УстановитьНазваниеСсылкиОтчета(ЭтаФорма);
	//Взаиморасчеты по документу
	
	_УстановитьОтборДоговора();
	_УФС.ОтключитьИсториюВыбораЭлементовФормы(ЭтаФорма);
	
	// --- 
	СостояниеДокумента = ОбщегоНазначенияБП.СостояниеДокумента(Объект); // ВызовБП
	
	Если Не ЭтаФорма.ТолькоПросмотр тогда
		ЭтаФорма.ТолькоПросмотр = Не CW_ПраваДоступа.ПравоДоступно("РедактированиеФинансов_ОперативныйУчет");
	КонецЕсли;
	
	Если Параметры.Ключ.Пустая() Тогда
		Объект.Организация 		= CW_Настройки.ОсновнаяОрганизация();
	Конецесли;
	
	#Область МСФО_Модуль
	СчетПриИзмененииНаСервере();
	УстановитьВидимостьНДС();
	УчитыватьНДСПриИзмененииНаСервере();
	#КонецОбласти
	
	//Подсистема.ДополнительныеРеквизиты
	ИспользоватьДопРеквизиты = CW_ДополнительныеРеквизитыСлужебный.ИспользуютсяДополниительныеРеквизиты();
	//Подсистема.ДополнительныеРеквизиты
	
	// СтандартныеПодсистемы.Свойства
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ИмяЭлементаДляРазмещения", "ГруппаДополнительныеРеквизиты");
	ДополнительныеПараметры.Вставить("ПроизвольныйОбъект", НЕ ИспользоватьДопРеквизиты); 
	УправлениеСвойствами.ПриСозданииНаСервере(ЭтотОбъект, ДополнительныеПараметры);
	// Конец СтандартныеПодсистемы.Свойства
	
	//Подсистема.УчетПриложенийДоговоров
	CW_УчетПриложенийДоговоровСервер.ПриСозданииНаСервере(ЭтаФорма, Отказ, СтандартнаяОбработка);
	//Подсистема.УчетПриложенийДоговоров

	//Внешние подклчюаемые команды
	CW_ПодключаемыеКомандыСервер.ПриСозданииНаСервере(ЭтотОбъект);	
	
КонецПроцедуры


