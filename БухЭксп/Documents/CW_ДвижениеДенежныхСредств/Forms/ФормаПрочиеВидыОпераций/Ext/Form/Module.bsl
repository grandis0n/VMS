&НаСервере
Функция _ПроверитьДоговор()
	// --- 
	
	Если (ЗначениеЗаполнено(Объект.Контрагент) И ЗначениеЗаполнено(Объект.Организация) И НЕ ЗначениеЗаполнено(Объект.Договор)) Тогда
		
		Если (Объект.ВидОперации = Перечисления.CW_ВидыОперацийДДС.ОплатаПоставщику) Тогда
			
			Объект.Договор = CW_Документы.ПолучитьПоследнийДоговор(Объект.Контрагент, Объект.Организация, Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком);
			
		ИначеЕсли (Объект.ВидОперации = Перечисления.CW_ВидыОперацийДДС.ПоступлениеОтПокупателя) Тогда 
			
			Объект.Договор = CW_Документы.ПолучитьПоследнийДоговор(Объект.Контрагент, Объект.Организация, Перечисления.ВидыДоговоровКонтрагентов.СПокупателем); 
			
		ИначеЕсли (Объект.ВидОперации = Перечисления.CW_ВидыОперацийДДС.ОплатаПоставщикуПоПриобретениям) Тогда 
			
			Объект.Договор = CW_Документы.ПолучитьПоследнийДоговор(Объект.Контрагент, Объект.Организация, Перечисления.ВидыДоговоровКонтрагентов.Прочее); 
			
		КонецЕсли; 
		
		ДоговорПриИзмененииНаСервере();
		
	КонецЕсли; 
	
	// --- 
КонецФункции

