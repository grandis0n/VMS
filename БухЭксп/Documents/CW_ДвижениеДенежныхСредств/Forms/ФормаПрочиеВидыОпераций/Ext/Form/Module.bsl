&НаСервере
Функция _ПараметрыФормыПодбора()
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("Дата",				?(Объект.Дата = Дата(1,1,1), ТекущаяДата(), Объект.Дата));
	СтруктураПараметров.Вставить("ВидОперации", 		Объект.ВидОперации);
	СтруктураПараметров.Вставить("Организация", 		Объект.Организация);
	СтруктураПараметров.Вставить("Контрагент", 			Объект.Контрагент);
	СтруктураПараметров.Вставить("Договор", 			Объект.Договор);
	СтруктураПараметров.Вставить("ПриложениеКДоговору", Объект.ПриложениеКДоговору);
	СтруктураПараметров.Вставить("СтатьяДДС", 			Объект.СтатьяДДС);
	
	СтруктураПараметров.Вставить("РежимДДС",			Истина);
	СтруктураПараметров.Вставить("ВедомыйДокумент",		Неопределено);
	СтруктураПараметров.Вставить("ВалютаДокумента",		Объект.Валюта);
	СтруктураПараметров.Вставить("Валюта",				Объект.Валюта);
	СтруктураПараметров.Вставить("ВалютаКассы",			Объект.Касса.Валюта);
	СтруктураПараметров.Вставить("Представление",		Объект.ПредставлениеДокумента);
	СтруктураПараметров.Вставить("АдресТаблицыОЗ",		ПоместитьВоВременноеХранилище(Объект.Расшифровка.Выгрузить(),ЭтаФорма.УникальныйИдентификатор));
	
	Возврат СтруктураПараметров;

КонецФункции
 
