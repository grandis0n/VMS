&НаСервере
Процедура РассчитатьСуммуПоступленияНаСервере()
	
	ВалютаКассыСписания 	= Объект.Касса.Валюта;
	ВалютаКассыПоступления 	= Объект.КассаПоступления.Валюта;
	
	ДатаКурса	 					= ?(ЗначениеЗаполнено(Объект.Дата), Объект.Дата, ТекущаяДата());
	СтруктураКурсаКассы 			= CW_Финансы.ПолучитьКурсВалюты(ВалютаКассыСписания,ДатаКурса);
	СтруктураКурсаКассыПоступления 	= CW_Финансы.ПолучитьКурсВалюты(ВалютаКассыПоступления,ДатаКурса);
	
	Объект.СуммаВД = CW_Финансы.ПересчитатьИзВалютыВВалюту(Объект.СуммаВК, ВалютаКассыСписания, ВалютаКассыПоступления,СтруктураКурсаКассы.Курс, СтруктураКурсаКассыПоступления.Курс,СтруктураКурсаКассы.Кратность, СтруктураКурсаКассыПоступления.Кратность);
	
КонецПроцедуры

