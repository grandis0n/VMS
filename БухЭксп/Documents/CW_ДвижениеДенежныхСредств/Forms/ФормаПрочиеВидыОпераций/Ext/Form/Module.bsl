&НаСервере
Функция _УправлениеЭлементамиФормы()
	// --- 
	
	Если (Объект.ВидОперации.Пустая()) Тогда
		
		Возврат(Неопределено);
		
	КонецЕсли; 
	
	// ---------------------------------------------------------------------------- 
	
	Элементы.СтраницаКомментарий.Заголовок = " Комментарий" +?(ЗначениеЗаполнено(Объект.Комментарий)," (*)","");
	
	// ---------------------------------------------------------------------------- 
	
	ВалютаКассы = Объект.Касса.Валюта;
	ЗаполненаВалютаКассы = ЗначениеЗаполнено(ВалютаКассы);
	Элементы.СуммаВК.Доступность = (ЗаполненаВалютаКассы);
	Элементы.СуммаВК.Заголовок = "Сумма";
	Если (ЗаполненаВалютаКассы) Тогда
		_сф.стр_Добавить(Элементы.СуммаВК.Заголовок,", "+Строка(ВалютаКассы));
	КонецЕсли; 
	Элементы.РасшифровкаСуммаВК.Заголовок = Элементы.СуммаВК.Заголовок;
	// --- 
	ВалютаДоговора = Объект.Договор.ВалютаДоговора;
	ЗаполненаВалютаДоговора = ЗначениеЗаполнено(ВалютаДоговора);
	Элементы.СуммаВД.Доступность = (ЗаполненаВалютаДоговора);
	Элементы.СуммаВД.Заголовок = "Сумма";
	Если (ЗаполненаВалютаДоговора) Тогда
		_сф.стр_Добавить(Элементы.СуммаВД.Заголовок,", "+Строка(ВалютаДоговора));
	КонецЕсли;
	Элементы.РасшифровкаСуммаВД.Заголовок = Элементы.СуммаВД.Заголовок;
	
	// --- 
	
	ВалютаКассыПоступления = Объект.КассаПоступления.Валюта;
	ЗаполненаВалютаКассыПоступления = ЗначениеЗаполнено(ВалютаКассыПоступления);
	Элементы.СуммаПоступления.Доступность = (ЗаполненаВалютаКассыПоступления);
	Элементы.СуммаПоступления.Заголовок = "Сумма";
	Если (ЗаполненаВалютаКассыПоступления) Тогда
		_сф.стр_Добавить(Элементы.СуммаПоступления.Заголовок,", "+Строка(ВалютаКассыПоступления));
	КонецЕсли;
	
	
	
	Если Объект.ВидОперации = Перечисления.CW_ВидыОперацийДДС.ПоступлениеОтПокупателя
		ИЛИ Объект.ВидОперации = Перечисления.CW_ВидыОперацийДДС.ОплатаПоставщику
		ИЛИ Объект.ВидОперации = Перечисления.CW_ВидыОперацийДДС.ОплатаПоставщикуПоПриобретениям Тогда
		
		Элементы.ГруппаДенежныеСредства.Высота=0;
		Элементы.ГруппаКонтрагент.Видимость = Истина;
		Элементы.ГруппаКассаПоступления.Видимость = Ложь;
		Элементы.СуммаВК.ТолькоПросмотр=Истина;
		Элементы.СуммаВД.ТолькоПросмотр=Истина;
		//Элементы.ГруппаНазначениеПлатежа.Видимость = Истина;
		Элементы.СтраницаРасшифровка.Видимость = Истина;
		
		Если (Объект.ВидОперации = Перечисления.CW_ВидыОперацийДДС.ПоступлениеОтПокупателя) Тогда
			
			Элементы.ГруппаКонтрагент.Заголовок = "Покупатель";
			
		КонецЕсли; 
		
		Если Объект.ВидОперации = Перечисления.CW_ВидыОперацийДДС.ОплатаПоставщику 
			ИЛИ Объект.ВидОперации = Перечисления.CW_ВидыОперацийДДС.ОплатаПоставщикуПоПриобретениям Тогда
			
			Элементы.ГруппаКонтрагент.Заголовок = "Поставщик"; 
			
		КонецЕсли; 
		
		Элементы.СуммаВД.Видимость = Ложь;
		Элементы.РасшифровкаСуммаВД.Видимость = Ложь;
		Если (ЗаполненаВалютаКассы И ЗаполненаВалютаДоговора И ВалютаКассы <>  ВалютаДоговора ) Тогда
			
			Элементы.СуммаВД.Видимость = Истина;
			Элементы.РасшифровкаСуммаВД.Видимость = Истина;
			
		КонецЕсли; 
		
		//Модуль_МСФО
		Элементы.СтраницаМСФО.Видимость = Ложь;
		//Модуль_МСФО
		
	ИначеЕсли (Объект.ВидОперации = Перечисления.CW_ВидыОперацийДДС.ПрочиеПоступления
		ИЛИ Объект.ВидОперации = Перечисления.CW_ВидыОперацийДДС.ПрочиеСписания) Тогда 
		
		Элементы.ГруппаДенежныеСредства.Высота=8;
		Элементы.ГруппаКонтрагент.Видимость = Ложь;
		Элементы.ГруппаКассаПоступления.Видимость = Ложь;
		Элементы.СуммаВК.ТолькоПросмотр=Ложь;
		Элементы.СуммаВД.ТолькоПросмотр=Ложь;
		//Элементы.ГруппаНазначениеПлатежа.Видимость = Истина;
		Элементы.СтраницаРасшифровка.Видимость = Ложь;
		
		//Модуль_МСФО
		Элементы.СтраницаМСФО.Видимость = ВедениеБухгалтескогоУчетаМСФО;
		//Модуль_МСФО
		
	ИначеЕсли (Объект.ВидОперации = Перечисления.CW_ВидыОперацийДДС.ПеремещениеВДругуюКассу) Тогда 
		
		Элементы.ГруппаДенежныеСредства.Высота=0;		
		Элементы.ГруппаКонтрагент.Видимость = Ложь;
		Элементы.ГруппаКассаПоступления.Видимость = Истина;
		Элементы.СуммаВК.ТолькоПросмотр=Ложь;
		Элементы.СуммаВД.ТолькоПросмотр=Ложь;
		//Элементы.ГруппаНазначениеПлатежа.Видимость = Истина;
		Элементы.СтраницаРасшифровка.Видимость = Ложь;
		// --- 
		Элементы.ГруппаДенежныеСредства.Заголовок = "Списание";
		Элементы.ГруппаКассаПоступления.Заголовок = "Поступление";
		
		// --- 
		Элементы.СуммаПоступления.Видимость 			= (ЗначениеЗаполнено(Объект.Касса.Валюта) И ЗначениеЗаполнено(Объект.КассаПоступления.Валюта) И Объект.Касса.Валюта <> Объект.КассаПоступления.Валюта);
		Элементы.РассчитатьСуммуПоступления.Видимость 	= (ЗначениеЗаполнено(Объект.Касса.Валюта) И ЗначениеЗаполнено(Объект.КассаПоступления.Валюта) И Объект.Касса.Валюта <> Объект.КассаПоступления.Валюта);
		
		//Модуль_МСФО
		Элементы.СтраницаМСФО.Видимость = Ложь;
		//Модуль_МСФО
		
	КонецЕсли; 
	
	Элементы.РасшифровкаПодборДокументов.Доступность = (ЗначениеЗаполнено(Объект.Касса.Валюта) И ЗначениеЗаполнено(Объект.Договор));
	
	//_СформироватьЗаголовок();
	
	// --- 
КонецФункции

&НаСервере
Функция _ОбновитьИтоги()
	// --- 
	
	ИтогоСуммаВК = Объект.Расшифровка.Итог("СуммаВК");
	ИтогоСуммаВД = Объект.Расшифровка.Итог("СуммаВД");
	
	ТекстЗаголовка = "Документы";
	КоличествоСтрок = Объект.Расшифровка.Количество();
	Элементы.СтраницаРасшифровка.Заголовок = ТекстЗаголовка+" ("+Формат(КоличествоСтрок,"ЧЦ=5; ЧДЦ=0; ЧН=; ЧГ=")+")";
	
	Итого = "Оплачено: ";
	Если (КоличествоСтрок = 0) Тогда
		Итого = Итого+"Нет данных";
	Иначе
		
		Если (Элементы.СуммаВД.Видимость) Тогда
			
			_сф.стр_Добавить(Итого,Формат(ИтогоСуммаВД,"ЧЦ=15; ЧДЦ=2; ЧН=")+" "+Строка(Объект.Договор.ВалютаДоговора)+", ");
			
		КонецЕсли; 
		_сф.стр_Добавить(Итого,Формат(ИтогоСуммаВК,"ЧЦ=15; ЧДЦ=2; ЧН=")+" "+Строка(Объект.Касса.Валюта));
		
	КонецЕсли; 
		
	// --- 
КонецФункции
 

&НаСервере
Функция _СформироватьЗаголовок()
	
	ЗаголовокДокумента = 
			"Движение денежных средств" + " " 
			+ ?(ЗначениеЗаполнено(Объект.ВидОперации), "("+нрег(Объект.ВидОперации)+")", "")
			+ ?(ЗначениеЗаполнено(Объект.Ссылка), " "+Объект.Номер+" от "+Объект.Дата, " (создание)")
	;
	ЭтаФорма.Заголовок = ЗаголовокДокумента;
	
КонецФункции

