&НаСервере
Функция УстановитьОтборДоговораНаСервере()
	
	мПараметрыВыбора = Новый Массив;
	
	Если Объект.ВидОперации = Перечисления.CW_ВидыОперацийДДС.ВозвратОтПоставщика Тогда
		
		МассивЗначений = Новый Массив;
		МассивЗначений.Добавить(ПредопределенноеЗначение("Перечисление.ВидыДоговоровКонтрагентов.СПоставщиком"));
		
		ФиксированныйМассив = Новый ФиксированныйМассив(МассивЗначений);
		
		мПараметрыВыбора.Добавить(Новый ПараметрВыбора("Отбор.ВидДоговора", ФиксированныйМассив));
		
	ИначеЕсли Объект.ВидОперации = Перечисления.CW_ВидыОперацийДДС.ВозвратПокупателю Тогда
		
		МассивЗначений = Новый Массив;
		МассивЗначений.Добавить(ПредопределенноеЗначение("Перечисление.ВидыДоговоровКонтрагентов.СПокупателем"));
		
		ФиксированныйМассив = Новый ФиксированныйМассив(МассивЗначений);
		
		мПараметрыВыбора.Добавить(Новый ПараметрВыбора("Отбор.ВидДоговора", ФиксированныйМассив));
		
	КонецЕсли; 
	
	Элементы.Договор.ПараметрыВыбора =  Новый ФиксированныйМассив(мПараметрыВыбора);
	
КонецФункции

