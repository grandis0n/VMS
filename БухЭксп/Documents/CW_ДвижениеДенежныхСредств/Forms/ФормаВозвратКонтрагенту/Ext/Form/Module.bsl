&НаКлиенте
Процедура РасшифровкаДокументПриИзменении(Элемент) 
	
	ТекущаяСтрока = Элементы.Расшифровка.ТекущаяСтрока;
	РасшифровкаДокументПриИзмененииНаСервере(ТекущаяСтрока); 
	
КонецПроцедуры   

&НаСервере
Процедура РасшифровкаДокументПриИзмененииНаСервере(ТекущаяСтрока)
	
	СоответствиеИмениРеквизита = ПолучитьСоответствиеРеквизитПредставлениеТипуДокумента();

	СтрокаТекущая = Объект.Расшифровка.НайтиПоИдентификатору(ТекущаяСтрока);
	
	Если СтрокаТекущая.Документ = Объект.Ссылка Тогда
		СтрокаТекущая.Документ = Неопределено;
		Возврат;
	КонецЕсли;
	
	ИмяРеквизита = СоответствиеИмениРеквизита.Получить(ТипЗнч(СтрокаТекущая.Документ));
	Если ИмяРеквизита = Неопределено Тогда
		Возврат;
	КонецЕсли;
										  
	СтрокаТекущая.Представление = СтрокаТекущая.Документ[ИмяРеквизита];  
	
	ПоместитьТаблицуДокументаВоВременноеХранилище(СтрокаТекущая.Документ);

КонецПроцедуры

&НаСервере
Процедура ПоместитьТаблицуДокументаВоВременноеХранилище(Знач Документ)
	
	//Подготовим таблицу для заполнения документа
	РезультатВыбора = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Документ);
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ТипОбъекта", ТипЗнч(Документ));
	
	ТаблицаДокумента = ПодготовитьТаблицуДляЗаполнения(РезультатВыбора, ДополнительныеПараметры);
	ПоместитьВоВременноеХранилище(ТаблицаДокумента, АдресТаблицыДокумента);
	//---Подготовим таблицу для заполнения документа

КонецПроцедуры

&НаСервере
Функция ПолучитьСоответствиеРеквизитПредставлениеТипуДокумента()
	
	Соответствие = новый Соответствие;
	Соответствие.Вставить(Тип("ДокументСсылка.CW_ДоходыПоГрузоперевозке"),  "ПредставлениеДокумента");
 	Соответствие.Вставить(Тип("ДокументСсылка.CW_РасходыПоГрузоперевозке"), "ПредставлениеДокумента");
	Соответствие.Вставить(Тип("ДокументСсылка.CW_Оплата"), 					"ПредставлениеДокумента");
	Соответствие.Вставить(Тип("ДокументСсылка.CW_ДвижениеДенежныхСредств"), "ПредставлениеДокумента");

	Возврат Соответствие;
	
КонецФункции

&НаКлиенте
Процедура РасшифровкаСчетНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекущаяСтрока 	= Элементы.Расшифровка.ТекущаяСтрока;
	СписокВыбора 	= ПолучитьСписокСчетовДокумента(ТекущаяСтрока); 
	Если СписокВыбора = Неопределено Тогда
		ПоказатьПредупреждение(, "Не удалось получить список счетов задолженности по документу");
		Возврат;
	КонецЕсли;

	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ТекущаяСтрока", ТекущаяСтрока);

	ОписаниеОповещения = Новый ОписаниеОповещения("ЗавершитьВыборСчета", ЭтотОбъект, ДополнительныеПараметры);
	
	СписокВыбора.ПоказатьВыборЭлемента(ОписаниеОповещения, "Выберите счет задолженности");
	
КонецПроцедуры  

&НаКлиенте
Процедура ЗавершитьВыборСчета(РезультатВыбора, ДополнительныеПараметры) Экспорт 
	
	Если РезультатВыбора = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЗавершитьВыборСчетаНаСервере(РезультатВыбора.Значение, ДополнительныеПараметры);
	
КонецПроцедуры   

&НаСервере
Процедура ЗавершитьВыборСчетаНаСервере(Знач Значение, ДополнительныеПараметры)
	
	ТаблицаДокумента = ПолучитьИзВременногоХранилища(АдресТаблицыДокумента); 
	Если ТаблицаДокумента = Неопределено Тогда
		Возврат;
	КонецЕсли; 
	
	НайденнаяСтрока = ТаблицаДокумента.Найти(Значение, "УникальныйИдентификатор");
	Если НайденнаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли; 
	
	СтрокаТекущая = Объект.Расшифровка.НайтиПоИдентификатору(ДополнительныеПараметры.ТекущаяСтрока);
	СтрокаТекущая.Счет 	  = НайденнаяСтрока.Счет;
	СтрокаТекущая.СуммаВК = НайденнаяСтрока.СуммаВК;
	СтрокаТекущая.СуммаВД = НайденнаяСтрока.СуммаВД;  
	
	ОбновитьИтогиНаСервере();
	
КонецПроцедуры

&НаСервере
Функция ПолучитьСписокСчетовДокумента(ТекущаяСтрока)
	
	СтрокаТекущая = Объект.Расшифровка.НайтиПоИдентификатору(ТекущаяСтрока);
	
	СписокВыбора = ПолучитьМассивСчетов(СтрокаТекущая.Документ);   
	Возврат СписокВыбора;
	
КонецФункции 

&НаСервере
Функция ПолучитьМассивСчетов(Документ)  
	
	ТаблицаДокумента = ПолучитьИзВременногоХранилища(АдресТаблицыДокумента); 
	Если ТаблицаДокумента = Неопределено Тогда  
		ПоместитьТаблицуДокументаВоВременноеХранилище(Документ);
		ТаблицаДокумента = ПолучитьИзВременногоХранилища(АдресТаблицыДокумента); 
		Если ТаблицаДокумента = Неопределено Тогда  
			Возврат Неопределено;
		КонецЕсли; 
	КонецЕсли; 

	СписокВыбора = Новый СписокЗначений;
	Для Каждого СтрокаТаблциы из ТаблицаДокумента Цикл   
		ПредставлениеЭлемента = СокрЛП(СтрокаТаблциы.Счет) + " ("+Формат(СтрокаТаблциы.СуммаВД, "ЧДЦ=2")+")";
		СписокВыбора.Добавить(СтрокаТаблциы.УникальныйИдентификатор, ПредставлениеЭлемента);
	КонецЦикла;
	
	Возврат СписокВыбора

КонецФункции


&НаКлиенте
Процедура РасшифровкаПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	
	ПодключитьОбработчикОжидания("РасшифровкаПриОкончанииРедактированияОбработчикОжидания", 0.1, Истина);
	
КонецПроцедуры  

&НаКлиенте
Процедура РасшифровкаПриОкончанииРедактированияОбработчикОжидания()

	РассчитатьСуммуВВалютеДоговора();
	
КонецПроцедуры

&НаКлиенте
Процедура РасшифровкаСуммаВДПриИзменении(Элемент)
	
	ТекущаяСтрока = Элементы.Расшифровка.ТекущаяСтрока;
	РасшифровкаСуммаВДПриИзмененииНаСервере(ТекущаяСтрока);  
	
КонецПроцедуры  

&НаСервере
Процедура РасшифровкаСуммаВДПриИзмененииНаСервере(ТекущаяСтрока)
	
	Если Элементы.СуммаВД.Видимость Тогда
		
		СтрокаТекущая = Объект.Расшифровка.НайтиПоИдентификатору(ТекущаяСтрока);
		
		ДатаСреза 			= ?(ЗначениеЗаполнено(Объект.Дата), Объект.Дата, ТекущаяДата());  
		ВалютаКассы			= Объект.Касса.Валюта;
		СтруктураКурсаКассы	= CW_Финансы.ПолучитьКурсВалюты(ВалютаКассы, ДатаСреза);
		
		ВалютаДоговора			= Объект.Договор.ВалютаДоговора; 
		СтруктураКурсаДоговора	= CW_Финансы.ПолучитьКурсВалюты(ВалютаДоговора, ДатаСреза);
		
		СтрокаТекущая.СуммаВК = CW_Финансы.ПересчитатьИзВалютыВВалюту(
									СтрокаТекущая.СуммаВД, 
									ВалютаКассы, 
									ВалютаДоговора, 
									СтруктураКурсаКассы.Курс, 
									СтруктураКурсаДоговора.Курс, 
									СтруктураКурсаКассы.Кратность, 
									СтруктураКурсаДоговора.Кратность); 
		
	КонецЕсли;
	
	РассчитатьСуммуВВалютеДоговора();
	
КонецПроцедуры
 
&НаСервере
Процедура РассчитатьСуммуВВалютеДоговора()
	
	Объект.СуммаВД = Объект.Расшифровка.Итог("СуммаВД"); 
	
КонецПроцедуры
