&НаСервере
Процедура УстановитьДоступныеТипыДокументаРасшифровки()
	
	ОграничениеТипа = ПолучитьОграниченияТипа();
	Элементы.РасшифровкаДокумент.ОграничениеТипа  = Новый ОписаниеТипов(ОграничениеТипа);
	
КонецПроцедуры

&НаСервере
Функция ПолучитьОграниченияТипа()
	
	ОграничениеТипа = Новый Массив;    
	Если Объект.Договор.ВидДоговора = ПредопределенноеЗначение("Перечисление.ВидыДоговоровКонтрагентов.СПокупателем") Тогда
		ОграничениеТипа.Добавить(Тип("ДокументСсылка.CW_ДоходыПоГрузоперевозке"));  
	ИначеЕсли Объект.Договор.ВидДоговора = ПредопределенноеЗначение("Перечисление.ВидыДоговоровКонтрагентов.СПоставщиком") Тогда
		ОграничениеТипа.Добавить(Тип("ДокументСсылка.CW_РасходыПоГрузоперевозке"));  
	Иначе
		ОграничениеТипа.Добавить(Тип("ДокументСсылка.CW_ДоходыПоГрузоперевозке"));  
		ОграничениеТипа.Добавить(Тип("ДокументСсылка.CW_РасходыПоГрузоперевозке"));  
	КонеЦЕсли; 
	
	ОграничениеТипа.Добавить(Тип("ДокументСсылка.CW_Оплата"));
	ОграничениеТипа.Добавить(Тип("ДокументСсылка.CW_ДвижениеДенежныхСредств"));
	
	Возврат ОграничениеТипа;
	
КонецФункции

