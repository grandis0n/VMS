&НаКлиенте
Процедура Команда_ВзаиморасчетыПоДокументу(Команда)
	
	Если Объект.Ссылка.Пустая() Тогда   
		Возврат;
	КонецЕсли;   
	
	Если Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.CW_ВидыОперацийДДС.ВозвратПокупателю") Тогда
		ВидЗадолженности ="ДЕБИТОРСКАЯ";
	ИначеЕсли Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.CW_ВидыОперацийДДС.ВозвратПоставщику") Тогда
		ВидЗадолженности ="КРЕДИТОРСКАЯ";
	КонеЦЕсли;	
	
	CW_ВзаиморасчетыПоДокументуКлиент.ОткрытьФормуОтчетаВзаиморасчетыПоДокументу(ЭтаФорма, Объект.Ссылка, ВидЗадолженности);
	
КонецПроцедуры
//Взаиморасчеты по документу 


&НаКлиенте
Процедура Подбор(Команда) 
	
	МассивОграничениеТипа = ПолучитьОграниченияТипа(); 
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ЗавершитьВыборТипаДокумента", ЭтотОбъект);
	
	СписокТиповДокумента = Новый СписокЗначений;
	СписокТиповДокумента.ЗагрузитьЗначения(МассивОграничениеТипа);
	СписокТиповДокумента.ПоказатьВыборЭлемента(ОписаниеОповещения, "Выберите тип документа");
	
КонецПроцедуры    

&НаКлиенте
Процедура ЗавершитьВыборТипаДокумента(РезультатВыбора, ДополнительныеПараметры) Экспорт
	
	Если РезультатВыбора = Неопределено Тогда
		Возврат;
	КонецЕсли;          
	
	ТипОбъекта = РезультатВыбора.Значение;
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ТипОбъекта", ТипОбъекта);
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ОбработатьВыборДокументов", ЭтотОбъект, ДополнительныеПараметры);
	
	Отбор = Новый Структура;
	Отбор.Вставить("Проведен",		Истина);
	Отбор.Вставить("Организация",	Объект.Организация);
	Отбор.Вставить("Контрагент", 	Объект.Контрагент);
	Отбор.Вставить("Договор",		Объект.Договор);
	
	Если ЗначениеЗаполнено(Объект.ПриложениеКДоговору) Тогда
		Отбор.Вставить("ПриложениеКДоговору", 	Объект.ПриложениеКДоговору);
	КонецЕсли; 
	
	Если ТипОбъекта = тип("ДокументСсылка.CW_ДоходыПоГрузоперевозке") Тогда
		Отбор.Вставить("ФормируетсяСчет", Истина);
	КонецЕсли;
	Если ТипОбъекта = тип("ДокументСсылка.CW_РасходыПоГрузоперевозке") Тогда
		Отбор.Вставить("ПредъявленСчет", Истина);
	КонецЕсли;
	
	СтруктураПараметров = Новый Структура;    
	СтруктураПараметров.Вставить("РежимВыбора", 		Истина);
	СтруктураПараметров.Вставить("МножественныйВыбор", 	Истина);
	СтруктураПараметров.Вставить("Отбор", 				Отбор);
	
	ИмяОбъекта = ПолучитьИмяОбъектаПоТипуНаСервере(ТипОбъекта);  
	ОткрытьФорму("Документ."+ИмяОбъекта+".ФормаВыбора",СтруктураПараметров, ЭтаФорма,,,,ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры         

&НаСервере
Функция ПолучитьИмяОбъектаПоТипуНаСервере(Знач Тип)
	
	ПолноеИмя  = Метаданные.НайтиПоТипу(Тип).ПолноеИмя();
	ИмяОбъекта = СтрРазделить(ПолноеИмя, ".")[1];
	
	Возврат ИмяОбъекта;
	
КонецФункции  

&НаКлиенте
Процедура ОбработатьВыборДокументов(РезультатВыбора, ДополнительныеПараметры) Экспорт
	Если РезультатВыбора = Неопределено Тогда
		Возврат;
	КонецЕсли;  
	
	ОбработатьВыборДокументовНаСервере(РезультатВыбора, ДополнительныеПараметры);
	
КонецПроцедуры  

&НаСервере
Процедура ОбработатьВыборДокументовНаСервере(РезультатВыбора, ДополнительныеПараметры) 
	
	Если РезультатВыбора.Найти(Объект.Ссылка) <> Неопределено Тогда
		РезультатВыбора.Удалить(РезультатВыбора.Найти(Объект.Ссылка));
	КонецЕсли; 
	
	Если РезультатВыбора.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ТаблицаДокумента = ПодготовитьТаблицуДляЗаполнения(РезультатВыбора, ДополнительныеПараметры); 
	Для Каждого СтрокаТаблицы из ТаблицаДокумента Цикл 
		
		Отбор = Новый Структура("Документ, Счет");
		ЗаполнитьЗначенияСвойств(Отбор, СтрокаТаблицы);
		
		НайденныеСтроки = Объект.Расшифровка.НайтиСтроки(Отбор);  
		Если НайденныеСтроки.Количество() = 0 Тогда
			НоваяСтрока = Объект.Расшифровка.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы); 
		КонецЕсли;
		
	КонецЦикла;
	
	РассчитатьСуммуВВалютеДоговора();
	
КонецПроцедуры  

&НаСервере
Функция ПодготовитьТаблицуДляЗаполнения(РезультатВыбора, ДополнительныеПараметры) 
	
	ДатаСреза 			= ?(ЗначениеЗаполнено(Объект.Дата), Объект.Дата, ТекущаяДата());  
	ТаблицаДокумента 	= ПолучитьПустуюТаблицуДокумента();

	Если ДополнительныеПараметры.ТипОбъекта = Тип("ДокументСсылка.CW_ДоходыПоГрузоперевозке") Тогда 
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	CW_ДоходыПоГрузоперевозкеУслуги.Ссылка КАК Документ,
		               |	CW_ДоходыПоГрузоперевозкеУслуги.Ссылка.ПредставлениеДокумента КАК Представление,
		               |	CW_ДоходыПоГрузоперевозкеУслуги.СчетЗадолженности КАК СчетЗадолженности,
		               |	СУММА(CW_ДоходыПоГрузоперевозкеУслуги.Всего) КАК СуммаВД
		               |ПОМЕСТИТЬ ВТ_ДанныеДокумента
		               |ИЗ
		               |	Документ.CW_ДоходыПоГрузоперевозке.Услуги КАК CW_ДоходыПоГрузоперевозкеУслуги
		               |ГДЕ
		               |	CW_ДоходыПоГрузоперевозкеУслуги.Ссылка В(&РезультатВыбора)
		               |
		               |СГРУППИРОВАТЬ ПО
		               |	CW_ДоходыПоГрузоперевозкеУслуги.Ссылка,
		               |	CW_ДоходыПоГрузоперевозкеУслуги.СчетЗадолженности
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ
		               |	CW_ОперативнаяДебиторскаяЗадолженностьОстатки.Счет КАК Счет,
		               |	CW_ОперативнаяДебиторскаяЗадолженностьОстатки.СчетУчета КАК СчетУчета,
		               |	CW_ОперативнаяДебиторскаяЗадолженностьОстатки.Всего_ВалютаОстаток КАК ВсегоОстаток
		               |ПОМЕСТИТЬ ВТ_Остатки
		               |ИЗ
		               |	РегистрНакопления.CW_ОперативнаяДебиторскаяЗадолженность.Остатки(
		               |			&ДатаСреза,
		               |			(Счет, СчетУчета) В
		               |				(ВЫБРАТЬ
		               |					ВТ_ДанныеДокумента.Документ КАК Счет,
		               |					ВТ_ДанныеДокумента.СчетЗадолженности КАК СчетУчета
		               |				ИЗ
		               |					ВТ_ДанныеДокумента КАК ВТ_ДанныеДокумента)) КАК CW_ОперативнаяДебиторскаяЗадолженностьОстатки
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ
		               |	ВТ_ДанныеДокумента.Документ КАК Документ,
		               |	ВТ_ДанныеДокумента.Представление КАК Представление,
		               |	ВТ_ДанныеДокумента.СчетЗадолженности КАК Счет,
		               |	ВТ_ДанныеДокумента.СуммаВД - ЕСТЬNULL(ВТ_Остатки.ВсегоОстаток, 0) КАК СуммаВД
		               |ИЗ
		               |	ВТ_ДанныеДокумента КАК ВТ_ДанныеДокумента
		               |		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Остатки КАК ВТ_Остатки
		               |		ПО ВТ_ДанныеДокумента.Документ = ВТ_Остатки.Счет
		               |			И ВТ_ДанныеДокумента.СчетЗадолженности = ВТ_Остатки.СчетУчета
		               |ГДЕ
		               |	ВТ_ДанныеДокумента.СуммаВД - ЕСТЬNULL(ВТ_Остатки.ВсегоОстаток, 0) <> 0";
		
		
		Запрос.УстановитьПараметр("РезультатВыбора", РезультатВыбора);
		Запрос.УстановитьПараметр("ДатаСреза", ДатаСреза);
		
		ВалютаКассы			= Объект.Касса.Валюта;
		СтруктураКурсаКассы	= CW_Финансы.ПолучитьКурсВалюты(ВалютаКассы, ДатаСреза);
		
		ВалютаДоговора			= Объект.Договор.ВалютаДоговора;
		СтруктураКурсаДоговора	= CW_Финансы.ПолучитьКурсВалюты(ВалютаДоговора, ДатаСреза);
		
		РезультатЗапроса = Запрос.Выполнить();
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
			
			Отбор = Новый Структура("Документ, Счет");
			ЗаполнитьЗначенияСвойств(Отбор, Выборка);
			
			НайденныеСтроки = ТаблицаДокумента.НайтиСтроки(Отбор);  
			Если НайденныеСтроки.Количество() = 0 Тогда
				НоваяСтрока = ТаблицаДокумента.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
				
