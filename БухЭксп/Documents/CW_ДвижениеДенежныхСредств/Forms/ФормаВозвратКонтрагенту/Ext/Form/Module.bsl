&НаСервере
Процедура УправлениеЭлементамиФормы()
	
	//Реквизиты валюта кассы
	ВалютаКассы 					= Объект.Касса.Валюта;
	Элементы.СуммаВК.Доступность 	= Объект.Касса.Валюта <> Объект.Валюта;
	Элементы.СуммаВК.Заголовок 		= "Сумма";
	
	Если ЗначениеЗаполнено(ВалютаКассы) Тогда
		Элементы.СуммаВК.Заголовок = Элементы.СуммаВК.Заголовок + ", " + Строка(ВалютаКассы);	
	КонецЕсли;    
	
	Элементы.РасшифровкаСуммаВК.Заголовок = Элементы.СуммаВК.Заголовок;
	//---Реквизиты валюта кассы
	
	
	//Реквизиты валюта договора
	ВалютаДоговора = Объект.Договор.ВалютаДоговора;
	Элементы.СуммаВД.Доступность = ЗначениеЗаполнено(ВалютаДоговора);
	Элементы.СуммаВД.Заголовок = "Сумма";
	
	Если ЗначениеЗаполнено(ВалютаДоговора) Тогда
		Элементы.СуммаВД.Заголовок = Элементы.СуммаВД.Заголовок + ", " + Строка(ВалютаДоговора);	
	КонецЕсли;
	Элементы.РасшифровкаСуммаВД.Заголовок = Элементы.СуммаВД.Заголовок;
	//---Реквизиты валюта договора  
	
	
	ВидимостьВалютыДоговора = ЗначениеЗаполнено(ВалютаКассы) 
	И ЗначениеЗаполнено(ВалютаДоговора)
	И ВалютаКассы <>  ВалютаДоговора;
	
	Элементы.СуммаВД.Видимость 				= ВидимостьВалютыДоговора;
	Элементы.РасшифровкаСуммаВД.Видимость 	= ВидимостьВалютыДоговора;
	
	Элементы.СтраницаКомментарий.Заголовок	= " Комментарий" +?(ЗначениеЗаполнено(Объект.Комментарий)," (*)","");
	
КонецПроцедуры

&НаСервере
Функция ОбновитьИтогиНаСервере()
	
	ИтогоСуммаВК = Объект.Расшифровка.Итог("СуммаВК");
	
	мСтроки = Новый Массив;
	мСтроки.Добавить("Возвращено:");   
	мСтроки.Добавить(Формат(Объект.Расшифровка.Итог("СуммаВК"),"ЧЦ=15; ЧДЦ=2; ЧН=")); 
	мСтроки.Добавить(Строка(Объект.Касса.Валюта));   
	
	Итого = СтрСоединить(мСтроки, " "); 
	
	Если Объект.Касса.Валюта = Объект.Валюта Тогда
		Объект.СуммаВК = ИтогоСуммаВК;	
	КонецЕсли;
	
КонецФункции

&НаСервере
Функция СформироватьЗаголовокНаСервере()
	
	ЭтаФорма.Заголовок = 
	"Движение денежных средств" + " " 
	+ ?(ЗначениеЗаполнено(Объект.ВидОперации), "("+нрег(Объект.ВидОперации)+")", "")
	+ ?(ЗначениеЗаполнено(Объект.Ссылка), " "+Объект.Номер+" от "+Объект.Дата, " (создание)")
	
КонецФункции



