&НаСервере
Функция ПолучитьПустуюТаблицуДокумента()
	                               
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 0
	               |	НЕОПРЕДЕЛЕНО КАК УникальныйИдентификатор,
	               |	CW_ДвижениеДенежныхСредствРасшифровка.Документ КАК Документ,
	               |	CW_ДвижениеДенежныхСредствРасшифровка.Представление КАК Представление,
	               |	CW_ДвижениеДенежныхСредствРасшифровка.Счет КАК Счет,
	               |	CW_ДвижениеДенежныхСредствРасшифровка.СуммаВК КАК СуммаВК,
	               |	CW_ДвижениеДенежныхСредствРасшифровка.СуммаВД КАК СуммаВД
	               |ИЗ
	               |	Документ.CW_ДвижениеДенежныхСредств.Расшифровка КАК CW_ДвижениеДенежныхСредствРасшифровка"; 
	
	РезультатЗапроса = Запрос.Выполнить();
	Возврат РезультатЗапроса.Выгрузить();

