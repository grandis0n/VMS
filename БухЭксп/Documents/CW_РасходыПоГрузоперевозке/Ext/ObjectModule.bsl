#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
  
Перем ДС Экспорт;

Процедура ПриУстановкеНовогоНомера(СтандартнаяОбработка, Префикс)
	
	Префикс = CW_Документы.ПрефиксОрганизации(Организация);	
	
КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	Ответственный = Неопределено;
	
	СпособЗачетаАвансов = Перечисления.СпособыЗачетаАвансов.НеЗачитывать;
	СпособЗачетаАвансовОЗ = Перечисления.СпособыЗачетаАвансов.НеЗачитывать;
	КодСпособаПолученияСФ = 1;
	
	CW_Документы.ЗаполнениеДокументов(ЭтотОбъект);
	
	// состав пакета
	НастройкиПользователя = CW_Настройки.ПолучитьНастройкиПользователя();
	Если CW_ПраваДоступа.ПравоДоступно("РедактированиеФинансов_Расходы_Счета") Тогда
		ПредъявленСчет = НастройкиПользователя.Расходы_ПредъявленСчет;
	КонецЕсли; 
	Если CW_ПраваДоступа.ПравоДоступно("РедактированиеФинансов_Расходы_Акты") Тогда
		ПредъявленАкт = НастройкиПользователя.Расходы_ПредъявленАкт;
		ПредъявленСФ  = НастройкиПользователя.Расходы_ПредъявленСчетФактура;
	КонецЕсли; 
	// состав пакета
	
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("Структура") Тогда 
		// только шапка
		// происходит при добавлении из формы элемента спр.CW_ДоговорыПоГрузоперевозкам
		Если ДанныеЗаполнения.Свойство("Договор") Тогда 
			Организация = ДанныеЗаполнения.Договор.Организация;
			Контрагент  = ДанныеЗаполнения.Договор.Владелец;
			Договор     = ДанныеЗаполнения.Договор; 
			
			Если ДанныеЗаполнения.Свойство("Валюта") Тогда
				Валюта      = ДанныеЗаполнения.Валюта;        
			КонецЕсли;
		КонецЕсли;
		
		Если ДанныеЗаполнения.Свойство("КорректируемыйДокумент") Тогда
			
			Корректировка = Истина;
			КорректируемыйДокумент = ДанныеЗаполнения.КорректируемыйДокумент;
				
			//Исправления
			ВидОперацииКорректировки = КорректируемыйДокумент.ВидОперацииКорректировки;
			Если НЕ ЗначениеЗаполнено(ВидОперацииКорректировки) Тогда
				ВидОперацииКорректировки = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсправленияПоступленияРеализации.СогласованноеИзменение");
			Конецесли;
			
			Если ВидОперацииКорректировки = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсправленияПоступленияРеализации.ИсправлениеОшибки") Тогда
				НомерСФ 			= КорректируемыйДокумент.НомерСФ;
				ДатаСФ 				= КорректируемыйДокумент.ДатаСФ;
				НомерИсправления 	= КорректируемыйДокумент.НомерИсправления + 1;
			конецЕсли;
			//Исправления   
			
			ЗаполнитьЗначенияСвойств(ЭтотОбъект,КорректируемыйДокумент,"Организация,Контрагент,Договор,ПриложениеКДоговору,Валюта,Продавец,ПредъявленСчет,ПредъявленАкт,ПредъявленСФ,ЭтоУниверсальныйДокумент,ЦенаСНДС");
			
			//AFR23-3305  от 01.02.2023
			ИсключаяСвойства = "";
			Если ДанныеЗаполнения.КорректируемыйДокумент.ПредъявленАкт Тогда
				СписокСчетов = Ложь; 
				ИсключаяСвойства = "Счет";
			КонецЕсли;
			//AFR23-3305  от 01.02.2023   
			
			ПоказатьРубли =  КорректируемыйДокумент.ПоказатьРубли;
			
			Для Каждого КорректируемаяСтрока Из КорректируемыйДокумент.Услуги Цикл
				
				НоваяСтрока = Услуги.Добавить();
				
				ЗаполнитьЗначенияСвойств(НоваяСтрока, КорректируемаяСтрока,,ИсключаяСвойства); //Свойство счет исключено из заполнения по заявке: AFR23-3305  от 01.02.2023 
	
				НоваяСтрока.Представление_ДоКорректировки 	= КорректируемаяСтрока.Представление;
				НоваяСтрока.Количество_ДоКорректировки 		= КорректируемаяСтрока.Количество;
				НоваяСтрока.Цена_ДоКорректировки 			= КорректируемаяСтрока.Цена;
				НоваяСтрока.Сумма_ДоКорректировки 			= КорректируемаяСтрока.Сумма;
				НоваяСтрока.СтавкаНДС_ДоКорректировки 		= КорректируемаяСтрока.СтавкаНДС;
				НоваяСтрока.НДС_ДоКорректировки 			= КорректируемаяСтрока.НДС;
				НоваяСтрока.Всего_ДоКорректировки 			= КорректируемаяСтрока.Всего;
				
				НоваяСтрока.Покупатель_ДоКорректировки 			= КорректируемаяСтрока.Покупатель;
				НоваяСтрока.ДоговорПокупателя_ДоКорректировки 	= КорректируемаяСтрока.ДоговорПокупателя;
				НоваяСтрока.ПриложениеКДоговору_ДоКорректировки = КорректируемаяСтрока.ПриложениеКДоговору;
				
				НоваяСтрока.Представление_ПередКорректировкой 	= КорректируемаяСтрока.Представление_ДоКорректировки;
				НоваяСтрока.Количество_ПередКорректировкой 		= КорректируемаяСтрока.Количество_ДоКорректировки;
				НоваяСтрока.Цена_ПередКорректировкой 			= КорректируемаяСтрока.Цена_ДоКорректировки;
				НоваяСтрока.Сумма_ПередКорректировкой 			= КорректируемаяСтрока.Сумма_ДоКорректировки;
				НоваяСтрока.СтавкаНДС_ПередКорректировкой 		= КорректируемаяСтрока.СтавкаНДС_ДоКорректировки;
				НоваяСтрока.НДС_ПередКорректировкой 			= КорректируемаяСтрока.НДС_ДоКорректировки;
				НоваяСтрока.Всего_ПередКорректировкой 			= КорректируемаяСтрока.Всего_ДоКорректировки;  
				
				Если ПоказатьРубли Тогда
					НоваяСтрока.Цена_ДоКорректировкиРег		= КорректируемаяСтрока.ЦенаРег;
					НоваяСтрока.Сумма_ДоКорректировкиРег	= КорректируемаяСтрока.СуммаРег;
					НоваяСтрока.НДС_ДоКорректировкиРег		= КорректируемаяСтрока.НДСРег;
					НоваяСтрока.Всего_ДоКорректировкиРег	= КорректируемаяСтрока.ВсегоРег;
					
					НоваяСтрока.Цена_ПередКорректировкойРег		= КорректируемаяСтрока.Цена_ДоКорректировкиРег;
					НоваяСтрока.Сумма_ПередКорректировкойРег	= КорректируемаяСтрока.Сумма_ДоКорректировкиРег;
					НоваяСтрока.НДС_ПередКорректировкойРег		= КорректируемаяСтрока.НДС_ДоКорректировкиРег;
					НоваяСтрока.Всего_ПередКорректировкойРег	= КорректируемаяСтрока.Всего_ДоКорректировкиРег;  
				КонецЕсли;
				
				НоваяСтрока.Покупатель_ПередКорректировкой 			= КорректируемаяСтрока.Покупатель_ДоКорректировки;
				НоваяСтрока.ДоговорПокупателя_ПередКорректировкой 	= КорректируемаяСтрока.ДоговорПокупателя_ДоКорректировки;
				НоваяСтрока.ПриложениеКДоговору_ПередКорректировкой = КорректируемаяСтрока.ПриложениеКДоговору_ДоКорректировки;
				
			КонецЦикла; 
			
		КонецЕсли; 
		
		Возврат;
		
	КонецЕсли; 
	
	// ---------------------------------------------------------------------------- 
	
	// ввод акта к ранее зарегистрированному счету
	Если ТипЗнч(ДанныеЗаполнения)=Тип("ДокументОбъект.CW_РасходыПоГрузоперевозке") ИЛИ 
		 ТипЗнч(ДанныеЗаполнения)=Тип("ДокументСсылка.CW_РасходыПоГрузоперевозке") 
	Тогда
		
		// проверяем, что, в документе должен стоять только флажок счета
		Документ = ДанныеЗаполнения;
		Если (Документ.ПредъявленАкт ИЛИ Документ.ПредъявленСФ) И НЕ Документ.ПредъявленСчет Тогда
			
			//Сообщить(("Ввод на основании предусмотрен для затратных документов
			//			   |в которых среди перечня предоставленных первичных документов
			//			   |указан только счет!", 10);
			СтандартнаяОбработка = Ложь;
			Возврат;
		Иначе
			
			// заполняем
			ЗаполнитьЗначенияСвойств(ЭтотОбъект,Документ,,"ВедомыйСчет,ВедомыйДокумент,ВедомыйСчетФактура,Дата");
			Для каждого КорректируемаяСтрока Из Документ.Услуги Цикл
				
				Нстр = Услуги.Добавить();
				ЗаполнитьЗначенияСвойств(Нстр,КорректируемаяСтрока);
				
			КонецЦикла; 
			
			СохранитьДату = CW_Настройки.ПолучитьНастройкуПользователя(,"УстанавливатьДатуАктаРавнойДатеСчетаПриВводеНаОснованииРасходы");

			
			// номер документа очистим 
			Номер = "";
			
			// укажем, что получили только акт
			ПредъявленСчет = Ложь;
			НомерСчета = "";
			ДатаСчета = Дата(1,1,1);
			
			ПредъявленАкт = Истина;
			ПредъявленСФ = НастройкиПользователя.Расходы_ПредъявленСчетФактура;
			
			// ссылаемся на счет
			Счет = Документ;
			
			// установим дату и время документа
			Если СохранитьДату тогда
				Дата = ДанныеЗаполнения.Дата;
			КонецЕсли;
			
			СтруктураПараметров = CW_Настройки.ПустаяСтруктураПолученияПараметровДоговора();
			СтруктураПараметров.Дата 				= ЭтотОбъект.Дата;
			СтруктураПараметров.Договор 			= ЭтотОбъект.Договор;
			СтруктураПараметров.ПриложениеКДоговору = ЭтотОбъект.ПриложениеКДоговору;
			
			СтруктураПараметровДоговора	= CW_Настройки.ПолучитьПараметрыДоговора(СтруктураПараметров, "ПорядокЗачетаАвансов");
			
			ЭтотОбъект.СпособЗачетаАвансов = СтруктураПараметровДоговора.ПорядокЗачетаАвансов;
			
			// установим дату и время акта
			Если Не ЗначениеЗаполнено(ДатаАкта) Тогда
				ДатаАкта = Дата;
				Если (ПредъявленСФ) Тогда
					ДатаСФ = ДатаАкта;
				КонецЕсли; 
			Иначе
				ДатаСтрокой = Формат(ДатаАкта,"ДФ=yyyyMMdd");
				ВремяСтрокой = Формат(Дата,"ДФ=HHmmss");
				ДатаАкта = Дата(ДатаСтрокой+ВремяСтрокой);
			КонецЕсли;
			
			// попробуем "угадать" номер акта
			Если Не ЗначениеЗаполнено(НомерАкта) Тогда
				НомерАкта = Документ.НомерСчета;
				Если (ПредъявленСФ) Тогда
					НомерСФ = НомерАкта;
				КонецЕсли; 
			КонецЕсли;
			
		КонецЕсли;
		
		Возврат;
		
	КонецЕсли; 
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	// сбрасываем параметры, подлежащие определению для нового документа
	ВедомыйСчет = Документы.СчетНаОплатуПоставщика.ПустаяСсылка();
	ВедомыйДокумент = Документы.ПоступлениеТоваровУслуг.ПустаяСсылка();
	ВедомыйСчетФактура = Документы.СчетФактураПолученный.ПустаяСсылка();
	Ответственный = CW_Настройки.Пользователь();
	ЗачетАвансов.Очистить();
	ЗачетАвансовОЗ.Очистить();
	
	// учитываем опции, установленные у пользователя
	НП = CW_Настройки.ПолучитьНастройкиПользователя();
	УстанавливатьТекущееВремя = НП.ПриКопированниУстанавливатьТекущееВремя;
	Если (УстанавливатьТекущееВремя = Неопределено) Тогда
		УстанавливатьТекущееВремя = Ложь;
	КонецЕсли; 
	Если (УстанавливатьТекущееВремя) Тогда
		Дата = CW_Документы.РабочееВремя();
	КонецЕсли; 
	ОчищатьСведенияПервичныхДокументов = НП.ОчищатьСведенияОПервичныхДокументахПриКопированииРасходов;
	Если (ОчищатьСведенияПервичныхДокументов = Неопределено) Тогда
		ОчищатьСведенияПервичныхДокументов = Ложь;
	КонецЕсли; 
	
	Если (ОчищатьСведенияПервичныхДокументов) Тогда
		
		ПредъявленСчет = Ложь;
		НомерСчета = "";
		ДатаСчета = Дата(1,1,1);
		// --- 
		ПредъявленАкт = Ложь;
		НомерАкта = "";
		ДатаАкта = Дата(1,1,1);
		// --- 
		ПредъявленСФ = Ложь;
		НомерСФ = "";
		ДатаСФ = Дата(1,1,1);	
		
		ДатаПолучения = Дата(1,1,1);
		
	КонецЕсли; 
	
	Если (НЕ CW_ПраваДоступа.ПравоДоступно("РедактированиеФинансов_Расходы_Счета")) Тогда
		
		ПредъявленСчет = Ложь;
		НомерСчета = "";
		ДатаСчета = Дата(1,1,1);
		
	КонецЕсли; 
	
	Если (НЕ CW_ПраваДоступа.ПравоДоступно("РедактированиеФинансов_Расходы_Акты")) Тогда
		
		ПредъявленАкт = Ложь;
		НомерАкта = "";
		ДатаАкта = Дата(1,1,1);
		// --- 
		ПредъявленСФ = Ложь;
		НомерСФ = "";
		ДатаСФ = Дата(1,1,1);
		
		ДатаПолучения = Дата(1,1,1);
		
	КонецЕсли; 
	
	ПлатёжноРасчётныеДокументы.Очистить();
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	Если (ОбменДанными.Загрузка) Тогда Возврат; КонецЕсли;
	// --- 
	ПроверяемыеРеквизиты.Очистить();
	
	флОшибка = Ложь;
	МассивСообщений = Новый Массив;
	
	Для Каждого Стр Из Услуги Цикл
		
		Если CW_Настройки.ПолучитьНастройкуПользователя(, "ПроверятьНоменклатурнуюГруппу") Тогда
			Если НЕ ЗначениеЗаполнено(Стр.Номенклатура.НоменклатурнаяГруппа) Тогда
				флОшибка = Истина;
				МассивСообщений.Добавить("У номенклатуры в строке " + Стр.НомерСтроки + " отсутствует номенклатурная группа!");
			КонецЕсли;
		КонецЕсли;	
		
		ГП = Стр.Грузоперевозка;
		ТП = Стр.Грузоперевозка.ТипПеревозки;
		Если ЗначениеЗаполнено(ТП) Тогда
			Если (ТП.КонтрольЗаполненияКлиентаРасходы И НЕ ЗначениеЗаполнено(ГП.Клиент)) Тогда
				МассивСообщений.Добавить("У грузоперевозки в строке " + Стр.НомерСтроки + " не заполнен обязательный реквизит ""Клиент""");
				флОшибка = Истина;
			КонецЕсли; 
			
			Если (ТП.КонтрольЗаполненияТипоразмераРасходы И НЕ ЗначениеЗаполнено(ГП.Типоразмер)) Тогда
				МассивСообщений.Добавить("У грузоперевозки в строке " + Стр.НомерСтроки + " не заполнен обязательный реквизит ""Типоразмер контейнера""");
				флОшибка = Истина;
			КонецЕсли; 
			
			Если (ТП.КонтрольЗаполненияГрузаРасходы И Константы.CW_Мониторинг_Груз.Получить() И НЕ ЗначениеЗаполнено(ГП.Груз)) Тогда
				МассивСообщений.Добавить("У грузоперевозки в строке " + Стр.НомерСтроки + " не заполнен обязательный реквизит ""Груз""");
				флОшибка = Истина;
			КонецЕсли; 
			
			Если (ТП.КонтрольЗаполненияМаршрутаРасходы И Константы.CW_Мониторинг_Маршрут.Получить() И НЕ ЗначениеЗаполнено(ГП.Маршрут)) Тогда
				МассивСообщений.Добавить("У грузоперевозки в строке " + Стр.НомерСтроки + " не заполнен обязательный реквизит ""Маршрут""");
				флОшибка = Истина;
			КонецЕсли; 
						
			Если (ТП.КонтрольЗаполненияМенеджераПродажРасходы И Константы.CW_Мониторинг_МенеджерПродаж.Получить() И НЕ ЗначениеЗаполнено(ГП.МенеджерПродаж)) Тогда
				МассивСообщений.Добавить("У грузоперевозки в строке " + Стр.НомерСтроки + " не заполнен обязательный реквизит ""Менеджер продаж""");
				флОшибка = Истина;
			КонецЕсли; 
						
			Если (ТП.КонтрольЗаполненияОперативногоМенеджераРасходы И Константы.CW_Мониторинг_ОперативныйМенеджер.Получить() И НЕ ЗначениеЗаполнено(ГП.ОперативныйМенеджер)) Тогда
				МассивСообщений.Добавить("У грузоперевозки в строке " + Стр.НомерСтроки + " не заполнен обязательный реквизит ""Оперативный менеджер""");
				флОшибка = Истина;
			КонецЕсли; 
			
			Отбор = Новый Структура("КонтрольЗаполненияРасходы", Истина);
			КонтроллируемыеПараметры = ТП.ПараметрыГрузоперевозки.Выгрузить(Отбор);
			СоответствиеСвойствПараметров = CW_Мониторинг.ПолучитьСоответствиеСвойствПараметров();
			Для Каждого СтрП Из КонтроллируемыеПараметры Цикл
				флПараметрНезаполнен = Ложь;
				ОтборПоПараметру = Новый Структура("Параметр", СтрП.Параметр);
				СтрокаПараметра = _сф.к_НайтиСтроку(ГП.ПараметрыГрузоперевозки, ОтборПоПараметру);
				СП = СоответствиеСвойствПараметров.Получить(СтрП.Параметр);
				Если (СтрокаПараметра = Неопределено) Тогда
					флПараметрНезаполнен = Истина;
				Иначе
					Если (СП.ЭтоКонтрольнаяДата) Тогда
						Если (НЕ ЗначениеЗаполнено(СтрокаПараметра.ЗначениеФакт)) Тогда
							флПараметрНезаполнен = Истина;
						КонецЕсли; 
					Иначе
						Если (НЕ ЗначениеЗаполнено(СтрокаПараметра.Значение)) Тогда
							флПараметрНезаполнен = Истина;
						КонецЕсли; 
					КонецЕсли; 
				КонецЕсли; 
				
				Если (флПараметрНезаполнен) Тогда
					МассивСообщений.Добавить("У грузоперевозки в строке " + Стр.НомерСтроки + " не заполнен обязательный параметр """ + СП.Наименование + """");
					флОшибка = Истина;
				КонецЕсли; 
			КонецЦикла; 
		КонецЕсли; 

	КонецЦикла;	
	
	Если флОшибка Тогда
		Для Каждого Стр Из МассивСообщений Цикл
			Сообщить(Стр, СтатусСообщения.Внимание);
		КонецЦикла; 
		
		Отказ = Истина;
		Возврат;
	КонецЕсли; 
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если РучнаяКорректировка Тогда
		Возврат; 
	КонецЕсли; 
	
	_сф.ст_УстановитьСвойство(ДополнительныеСвойства,"СтатусПроведенияДоПроведения", Проведен);
	
	//Для версии КОРП 
	ВестиУчетПоПодразделениям = ПолучитьФункциональнуюОпцию("ВестиУчетПоПодразделениям");
	//Для версии КОРП 
	
	// проверка прав
	ПроведениеРазрешено = CW_ПраваДоступа.ПравоДоступно("РедактированиеФинансов");
	Если (Корректировка) Тогда
		ПроведениеРазрешено = ПроведениеРазрешено И CW_ПраваДоступа.ПравоДоступно("РедактированиеФинансов_Корректировки");
	КонецЕсли; 
	Если (НЕ ПроведениеРазрешено) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Недостаточно прав на проведение документа!",,,,Отказ);
	КонецЕсли;
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	ПроверитьСоответствиеБухгалтескогоУчетаДогововров(Отказ);
	
	Если Отказ тогда
		Возврат;
	Конецесли;
	
	// обмен данными
	Если (ОбменДанными.Загрузка) Тогда
		Возврат; 
	КонецЕсли;
	
	ВедетсяУчетПриложений = ПолучитьФункциональнуюОпцию("CW_ВедетсяУчетПриложенийПоДоговорам");
	Если ЗначениеЗаполнено(ПриложениеКДоговору) и ВедетсяУчетПриложений Тогда
		ОбъектПараметров = ПриложениеКДоговору;
	Иначе
		ОбъектПараметров = Договор;
	КонецЕсли;
	
	ТребуетсяЗаполнениеПокупателя = CW_Настройки.ПолучитьЗначениеПараметраДоговора(Дата, ОбъектПараметров, 
									"ТребоватьЗаполненияПокупателяДляПорядокаОтраженияЗатратыВРасходах");
	
	//Подситема.СтатусыДокументов
	СтатусДокумента = Неопределено;
	ЭтотОбъект.ДополнительныеСвойства.Свойство("СтатусДокумента", СтатусДокумента);
	
	СтатусДокументаПроводитьПоБухгалтерскомуУчету = CW_СтатусыДокументовСервер.ПолучитьПризнакПроведенияПоБухгалтерскомуУчету(Ссылка, СтатусДокумента);
	//Подситема.СтатусыДокументов

	СтруктураПараметровБухУчета = Новый Структура;
	СтруктураПараметровБухУчета.Вставить("Договор",					Договор);
	СтруктураПараметровБухУчета.Вставить("ПриложениеКДоговору",		ПриложениеКДоговору);
	СтруктураПараметровБухУчета.Вставить("ВедетсяУчетПриложений",	ВедетсяУчетПриложений);
	
	ПараметрыБухгалтерскогоУчета = CW_Финансы.ПолучитьПарметрыВеденияБухгалтерскогоУчета(СтруктураПараметровБухУчета, Дата);
	
	ПровестиПоБухгалтерскомуУчету = СтатусДокументаПроводитьПоБухгалтерскомуУчету и ПараметрыБухгалтерскогоУчета.БухгалтерскийУчет;
	
	// контроль услуг по договору     
	Если ПолучитьФункциональнуюОпцию("CW_ОграничиватьУслугиПоДоговорам") и Договор.ОграничиватьНоменклатуру Тогда	
		
		ДатаДокумента = Дата;
		Если ПредъявленАкт 
			и ЗначениеЗаполнено(ДатаАкта) Тогда
			ДатаДокумента = ДатаАкта;  
		ИначеЕсли ПредъявленСчет  
			и ЗначениеЗаполнено(ДатаСчета)Тогда
			ДатаДокумента = ДатаСчета;  
		КонецЕсли;      
		
		АдресУслуг = _УФС.ОбновитьСписокУслугПоДоговору(ДатаДокумента, Договор);  
		
		Если ЭтоАдресВременногоХранилища(АдресУслуг) Тогда
			ТаблицаУслугДоговора 	= ПолучитьИзВременногоХранилища(АдресУслуг);
			МассивУслугДоговора 	= ТаблицаУслугДоговора.ВыгрузитьКолонку("Номенклатура"); 
			
			ИсключитьПеревыставление = Константы.CW_НеОграничиватьСписокУслугПриПеревыставленииЗатрат.Получить();
			МассивУслугДокумента 	 = ПолучитьМассивУслугДокумента(ИсключитьПеревыставление);
			
			CW_Документы.ПроверитьСоответствиеУслугПоДоговору(МассивУслугДоговора, МассивУслугДокумента, Отказ);
			
		КонецЕсли;
		
		Если Отказ тогда
			Возврат;
		Конецесли;
		
	КонецЕсли;		
	
	// не перепроводим при восстановлении последовательности
	ВосстановлениеПоследовательности = _сф.ст_ПолучитьСвойство(ДополнительныеСвойства,"ПроведенВХронологическойПоследовательности");
	Если (ВосстановлениеПоследовательности <> Неопределено) Тогда
		Если (ВосстановлениеПоследовательности) Тогда
			Возврат;
		КонецЕсли; 
	КонецЕсли; 
	
	// контроль порядка отражения
	Если ПараметрыБухгалтерскогоУчета.БухгалтерскийУчет Тогда
		CW_Финансы.ПредупреждениеПоСхемеУчетаПеревыставленияПоСтавкам(ЭтотОбъект);	
	КонецЕсли; 
	
	// контроль наличия общих параметров
	Если (НЕ ЗаполненыОбщиеПараметры()) Тогда 
		СформироватьОбщиеПараметры(,Ложь); 
	КонецЕсли; 
	
	// если изменились даты начала ведения учета, то обновим соответствующие флаги
	// (при условии того, что в документе указана организация и договор)
	Если ЗначениеЗаполнено(Организация) и ЗначениеЗаполнено(Организация) Тогда
		Если ВводОстатковБУ <> ДополнительныеСвойства.УП.ВводОстатковБУ Тогда
			ВводОстатковБУ = ДополнительныеСвойства.УП.ВводОстатковБУ;	
		КонецЕсли; 
		Если ВводОстатковОЗ <> ДополнительныеСвойства.УП.ВводОстатковОЗ Тогда
			ВводОстатковОЗ = ДополнительныеСвойства.УП.ВводОстатковОЗ;	
		КонецЕсли; 	
	Иначе
		ВводОстатковБУ = Ложь;
		ВводОстатковОЗ = Ложь;
	КонецЕсли; 
	
	// фиксируем режим записи
	_сф.ст_УстановитьСвойство(ДополнительныеСвойства,"РежимЗаписи",РежимЗаписи);
	
	// проверка распроведения счетов с актами и оплатами
	Если РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения ИЛИ РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
		
		ЭтоСчет 	= ПредъявленСчет;
		ЭтоАкт 		= Не ПредъявленСчет и (ПредъявленАкт или ПредъявленСФ);
		ЭтоПакет 	= ПредъявленСчет и (ПредъявленАкт или ПредъявленСФ);
		
		// получим значение базовой валюты
		БазоваяВалютаРубль = Константы.CW_ВалютаРегламентированногоУчетаРубль.Получить();
		
		ПравоРедактирования = CW_ПраваДоступа.ПравоДоступно("РедактированиеФинансов");
		
		РедактированиеСчета 				= CW_ПраваДоступа.ПравоДоступно("РедактированиеФинансов_Расходы_Счета");
		РедактированиеАктированныхСчетов 	= CW_ПраваДоступа.ПравоДоступно("РазрешитьРедактированиеВходящихАктированныхСчетов") 	И РедактированиеСчета;
		РедактированиеОплаченныхСчетов 		= CW_ПраваДоступа.ПравоДоступно("РазрешитьРедактированиеВходящихОплаченныхСчетов") 		И РедактированиеСчета;
		
		// проверяем, ведётся ли оперативная задолженность
		//Если ДС.УП.ОЗ и НЕ ЭтоПакет Тогда
		Если ДС.УП.ОЗ Тогда
			
			Если Корректировка и ПравоРедактирования Тогда
				ПравоРедактирования = CW_ПраваДоступа.ПравоДоступно("РедактированиеФинансов_Корректировки");
			КонецЕсли;
			
			Если ЭтоАкт И ПравоРедактирования Тогда
				ПравоРедактирования = CW_ПраваДоступа.ПравоДоступно("РедактированиеФинансов_Расходы_Акты");
			Конецесли;
			
			Если ПравоРедактирования И ЭтоСчет и РедактированиеСчета и БазоваяВалютаРубль Тогда
				
				Если Не РедактированиеАктированныхСчетов и ПравоРедактирования Тогда
					// проверяем, что нет сформированных актов
					Запрос = Новый Запрос;
					Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
					|	CW_СоответствиеАктовВходящимСчетам.Акт КАК Акт
					|ИЗ
					|	РегистрСведений.CW_СоответствиеАктовВходящимСчетам КАК CW_СоответствиеАктовВходящимСчетам
					|ГДЕ
					|	CW_СоответствиеАктовВходящимСчетам.Счет = &Счет";
					
					Запрос.УстановитьПараметр("Счет", Ссылка);
					РезультатЗапроса = Запрос.Выполнить();
					
					ПравоРедактирования = РезультатЗапроса.Пустой();
				КонецЕсли;
				
				Если Не РедактированиеОплаченныхСчетов и ПравоРедактирования Тогда
					// проверяем, нет ли оплат
					Запрос = Новый Запрос;
					Запрос.Текст = "ВЫБРАТЬ
					|	CW_ОплатаВходящихДокументов.ДокументОплаты КАК ДокументОплаты
					|ИЗ
					|	РегистрСведений.CW_ОплатаВходящихДокументов КАК CW_ОплатаВходящихДокументов
					|ГДЕ
					|	CW_ОплатаВходящихДокументов.Документ = &Документ";
					Запрос.УстановитьПараметр("Документ", Ссылка);
					
					РезультатЗапроса = Запрос.Выполнить();
					
					ПравоРедактирования = РезультатЗапроса.Пустой();
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
		Если Не ПравоРедактирования Тогда
			Если РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения Тогда
				ТекстСообщения = "Недостаточно прав для отмены проведения документа!";
			КонецЕсли;
			Если РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
				ТекстСообщения = "Недостаточно прав для проведения документа!";
			КонецЕсли;
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,,,Отказ);
		КонецЕсли;
		
	КонецЕсли;
	
	// сформируем представление
	СформироватьПредставлениеДокумента();
	
	// для документов в у.е., в случае если установлена опция ввода документа в рублевом эквиваленте,
	// рассчитаем пользовательский курс как соотношение рублевого и валютного эквивалента документа  
	Если ПоказатьРубли Тогда                                                                       
		
		// получим кратность валюты на дату акта
		СК = CW_Финансы.ПолучитьКурсВалюты(Валюта,ДатаАкта);
		УЕ_Кратность = СК.Кратность;
  		
		УЕ_ПользовательскийКурс = Истина;
		УЕ_Курс = ?(Услуги.Итог("Всего")= 0,1,Окр(Услуги.Итог("ВсегоРег")/(Услуги.Итог("Всего")*УЕ_Кратность),4,РежимОкругления.Окр15как20));  
	КонецЕсли;
	
	// фиксируем сумму Всего и сумму НДС
	Если (НЕ Корректировка) Тогда
		СуммаДокумента 	= _сф.Итог(Услуги,"Всего");
		СуммаНДС		= _сф.Итог(Услуги,"НДС");	
	Иначе
		пСуммаДокумента = 0;
		пСуммаНДС = 0;
		
		Для каждого Стр Из Услуги Цикл
			_сф.Инкремент(пСуммаДокумента,Стр.Всего - Стр.Всего_ДоКорректировки);
			_сф.Инкремент(пСуммаНДС,Стр.НДС - Стр.НДС_ДоКорректировки);
		КонецЦикла; 
		
		СуммаДокумента = пСуммаДокумента;
		СуммаНДС = пСуммаНДС;
	КонецЕсли; 
	
	// ответственный
	_сф.УстановитьЕслиНезаполнено(Ответственный,CW_Настройки.Пользователь()); 
	
	// список контейнеров
	мГП = _сф.м_СоздатьИзКолонкиТЗ(Услуги.Выгрузить(,"Грузоперевозка"),"Грузоперевозка");
	нСписокГП  = _сф.м_Представление(мГП,",");
	Если нСписокГП <> СписокКонтейнеров Тогда
		СписокКонтейнеров = СтрЗаменить(нСписокГП,",",", ");
	КонецЕсли; 
	
	// Контроль срока договора / приложения   
	СтруктураПараметров = CW_Документы.ПустаяСтруктураКонтроляСрокаДействияДоговора(); 
	СтруктураПараметров.КонтролироватьСрокДоговоров 	= ДС.НП.КонтролироватьСрокДоговоров;
	СтруктураПараметров.КонтролироватьСрокПриложения 	= ДС.НП.КонтролироватьСрокДействияПриложения; 
	
	CW_Документы.ПроверитьСрокДействияДоговора(ЭтотОбъект, СтруктураПараметров, Отказ);
	
	// для подстановки последнего договора записываем его в регистр
	CW_Документы.ЗаписатьПоследнийДоговор(Договор);
	
	// аналогично по строкам таб.части
	ТаблицаДоговоровКлиентов = _сф.т_СкопироватьСвернуть(Услуги.Выгрузить(),"ДоговорПокупателя");
	Для Каждого СтрокаДоговора Из ТаблицаДоговоровКлиентов Цикл
		CW_Документы.ЗаписатьПоследнийДоговор(СтрокаДоговора.ДоговорПокупателя);
	КонецЦикла;
	
	Если (ПредъявленСчет) Тогда
		Счет = Неопределено;
		СписокСчетов = Ложь;
	КонецЕсли; 
	
	// перезаполняем счета задолженности
	СтруктураСчетов = CW_Финансы.СтруктураСчетовРасчетов_Поставщики(Дата,Организация); 
	
	мЗатраты = Новый Массив;
	мЗатраты.Добавить(Перечисления.CW_ПорядокОтраженияЗатрат.Затраты);
	мЗатраты.Добавить(Перечисления.CW_ПорядокОтраженияЗатрат.ПрочиеРасходы);   

	ВремУслуги = Услуги.Выгрузить();
	ВремУслуги.Свернуть("ПорядокОтражения");

	ЕстьПеревыставление = Ложь;
	ЕстьСобственные = Ложь;
	
	Если ВремУслуги.Количество() = 1 Тогда
		//Во всех строках что-то одно
		СтрокаТаблицы = ВремУслуги[0];
		Если мЗатраты.Найти(СтрокаТаблицы.ПорядокОтражения) <> Неопределено	Тогда
			ЕстьСобственные = истина;       
		Иначе
			ЕстьПеревыставление = Истина;
		КонецЕсли;   
	ИначеЕсли ВремУслуги.Количество() = 2 Тогда  
		мПорядокОтражения = ВремУслуги.ВыгрузитьКолонку("ПорядокОтражения");   
		
		Если мПорядокОтражения.Найти(Перечисления.CW_ПорядокОтраженияЗатрат.Затраты) <> Неопределено Тогда 
			ЕстьСобственные = истина;       
		КонецЕсли;  
		Если мПорядокОтражения.Найти(Перечисления.CW_ПорядокОтраженияЗатрат.ПрочиеРасходы) <> Неопределено Тогда 
			ЕстьСобственные = истина;       
		КонецЕсли;  
		
		Если мПорядокОтражения.Найти(Перечисления.CW_ПорядокОтраженияЗатрат.Перевыставление) <> Неопределено Тогда 
			ЕстьПеревыставление = истина;       
		КонецЕсли;  
		Если мПорядокОтражения.Найти(Перечисления.CW_ПорядокОтраженияЗатрат.ПеревыставлениеПоСтавкам) <> Неопределено Тогда 
			ЕстьПеревыставление = истина;       
		КонецЕсли;  
	Иначе
		ЕстьСобственные = истина;       
		ЕстьПеревыставление = Истина;
	КонецЕсли;
	
	
	Для каждого Стр Из Услуги Цикл
		Если (НЕ СписокСчетов) Тогда
			Стр.Счет = Неопределено;
		КонецЕсли; 
		
