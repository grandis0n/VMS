									Нстр.СуммаНДС 	= СтрокаУслуги.НДСРег   - СтрокаУслуги.НДС_ДоКорректировкиРег;  
								Иначе
									Нстр.Цена 		= СтрокаУслуги.Цена 	- СтрокаУслуги.Цена_ДоКорректировки;
									Нстр.Сумма 		= СтрокаУслуги.Сумма 	- СтрокаУслуги.Сумма_ДоКорректировки;
									Нстр.СуммаНДС 	= СтрокаУслуги.НДС 		- СтрокаУслуги.НДС_ДоКорректировки; 
								КонецЕсли;
								
								Если ЦенаСНДС Тогда
									Нстр.Сумма = Нстр.Сумма + Нстр.СуммаНДС;
								КонецЕсли;
								
							КонецЕсли;
						КонецЦикла; 
					КонецЕсли; 
					
					CW_Документы.ПеренестиПризнакВосстановленияПоследовательности(ЭтотОбъект,ВедомыйОбъект);
					ВедомыйОбъект.ОбменДанными.Загрузка = Ложь;
					ВедомыйОбъект.Записать(РежимЗаписи);      
					
					// пропишем срок оплаты, если это предусмотрено настройками типовой БП
					ИспользоватьПланирование = ПолучитьФункциональнуюОпцию("ИспользоватьПланированиеПлатежейПоставщикам");
					Если ИспользоватьПланирование Тогда
						ЗаписьРегистра = РегистрыСведений.CW_СрокиОплатыСчетов.СоздатьМенеджерЗаписи();
						ЗаписьРегистра.Счет = Ссылка;
						ЗаписьРегистра.Прочитать();   
						Если ЗаписьРегистра.Выбран() Тогда 
							СрокиОплатыДокументов.ЗаписатьСрокОплатыДокумента(ВедомыйСчетКорректировочный, ЗаписьРегистра.ДатаОплаты);
						КонецЕсли;
					КонецЕсли;
					
					// Если для целей оперативного учета задолженности документ проводится в режиме ввода остатков,
					// то принудительно пропишем статус ведомого счета (при проведении в обычном режиме статус не прописываем,
					// т.к. он будет определен типовой конфигурацией на момент записи документа) 
					
					СтруктураНастроек  = CW_Настройки.ПолучитьНастройкиОперативногоУчета(Организация, Перечисления.CW_ВидыОперативнойЗадолженности.Кредиторская, Дата); 

					Если СтруктураНастроек["ВедетсяОперативныйУчет"] Тогда
						РежимВводНачальныхОстатков = СтруктураНастроек["ВводОстатков"];
						Если РежимВводНачальныхОстатков Тогда
							
							// статус оплаты
							СтатусОплаты = Перечисления.СтатусОплатыСчета.НеОплачен;
							Если СальдоВзаиморасчетовОЗ <= 0 Тогда
								СтатусОплаты = Перечисления.СтатусОплатыСчета.Оплачен;
							Иначе
								Если СальдоВзаиморасчетовОЗ < Услуги.Итог("Всего") Тогда
									СтатусОплаты = Перечисления.СтатусОплатыСчета.ОплаченЧастично;
								КонецЕсли; 
							КонецЕсли; 
							
							// статус отгрузки
							СтатусОтгрузки = ?(ПредъявленАкт,Перечисления.СтатусыОтгрузки.Отгружен,Перечисления.СтатусыОтгрузки.НеОтгружен);
							
							МассивДокументов = Новый Массив;
							МассивДокументов.Добавить(ВедомыйОбъект.Ссылка);
							
							// пишем в регистр
							СтатусыДокумента = РегистрыСведений.СтатусыДокументов.НовыеСтатусыДокумента();
							СтатусыДокумента.Статус            		= СтатусОплаты;
							СтатусыДокумента.ДополнительныйСтатус	= СтатусОтгрузки;
							РегистрыСведений.СтатусыДокументов.УстановитьСтатусыДокументов(МассивДокументов, СтатусыДокумента);
						КонецЕсли; // это режим ввода остатков 
					КонецЕсли; // по организации ведется учет оперативной задолженности
					
				// формировать счет не требуется	
				Иначе
					Если (НЕ ВедомыйСчетКорректировочный.Пустая()) Тогда
						
						ПометитьНаУдаление(ВедомыйСчетКорректировочный);
						
					КонецЕсли; 
				КонецЕсли; // требуется формировать счет 
	
				Если (ПредъявленАкт) Тогда
					
					ВедомыйОбъект = ВедомыйДокументКорректировки.ПолучитьОбъект();
					
					Если Год(ВедомыйОбъект.Дата) <> Год(Дата) Тогда
						ВедомыйОбъект.Номер = "";	
					КонецЕсли;
		
					_сф.ст_УстановитьСвойство(ВедомыйОбъект.ДополнительныеСвойства,"ВедущийДокумент",Ссылка);
					_сф.ст_УстановитьСвойство(ВедомыйОбъект.ДополнительныеСвойства,"ЗависимоеПроведение",Истина);
					
					ВедомыйОбъект.Организация 	= Организация;
					//Для версии КОРП
					Если ВестиУчетПоПодразделениям Тогда
						ВедомыйОбъект.ПодразделениеОрганизации = ПодразделениеОрганизации;
					КонецЕсли;
					//Для версии КОРП
					
					ВедомыйОбъект.Дата 					= ?(ФормироватьВедомыеДатойДокумента, Дата, ДатаАкта);
					ВедомыйОбъект.ВидОперации 			= ВидОперацииКорректировки;
					ВедомыйОбъект.КорректироватьБУиНУ 	= Истина;
					ВедомыйОбъект.КорректироватьНДС 	= Истина;
					ВедомыйОбъект.ДокументПоступления 	= ?(КорректируемыйДокумент.Корректировка, КорректируемыйДокумент.ВедомыйДокументКорректировки, КорректируемыйДокумент.ВедомыйДокумент); 
					
					ВедомыйОбъект.НомерВходящегоДокумента = НомерАкта;
					ВедомыйОбъект.ДатаВходящегоДокумента  = ДатаАкта;
					
					ВедомыйОбъект.НомерИсходногоДокумента 	= КорректируемыйДокумент.НомерАкта;
					ВедомыйОбъект.ДатаИсходногоДокумента 	= КорректируемыйДокумент.ДатаАкта;
					
					Если ВидОперацииКорректировки = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсправленияПоступленияРеализации.ИсправлениеОшибки") Тогда
						ВедомыйОбъект.НомерИсправления 	= НомерИсправления; 
						ВедомыйОбъект.ДатаИсправления 	= Дата;
					КонецЕсли;
					
					ВедомыйОбъект.СтатьяПрочихДоходовИРасходов 	= ДС.УП.СтатьяПрочихДоходовИРасходовДляКорректировок;
					ВедомыйОбъект.Контрагент 					= Контрагент;
					ВедомыйОбъект.ДоговорКонтрагента 			= ПараметрыБухгалтерскогоУчета.УчетныйДоговор;
					ВедомыйОбъект.ВалютаДокумента 				= Валюта;
					
					ВедомыйОбъект.Услуги.Очистить();
					ВедомыйОбъект.АгентскиеУслуги.Очистить();
					ИндексСтрокиСобственных = 0;
					ИндексСтрокиАгентских = 0;
					
					Если КорректируемыйДокумент.Корректировка Тогда
						ТаблицаУслугСобственных = КорректируемыйДокумент.ВедомыйДокументКорректировки.Услуги.Выгрузить();
						ТаблицаУслугАгентских 	= КорректируемыйДокумент.ВедомыйДокументКорректировки.АгентскиеУслуги.Выгрузить();
					Иначе
						ТаблицаУслугСобственных = КорректируемыйДокумент.ВедомыйДокумент.Услуги.Выгрузить();
						ТаблицаУслугАгентских 	= КорректируемыйДокумент.ВедомыйДокумент.АгентскиеУслуги.Выгрузить();
					КонецЕсли;
					
					МаксИндексСтрокиСобственных = ТаблицаУслугСобственных.Количество()-1;
					МаксИндексСтрокиАгентских 	= ТаблицаУслугАгентских.Количество()-1;
					
					ОсновнаяСистемаНалогообложения 	= Перечисления.ВидыДеятельностиДляНалоговогоУчетаЗатрат["ОсновнаяСистемаНалогообложения"];
					ОсобыйПорядокНалогообложения	= Перечисления.ВидыДеятельностиДляНалоговогоУчетаЗатрат["ОсобыйПорядокНалогообложения"];
					
					ТребуетсяЗаполнениеОтраженияВУСН = (ДС.УП.СистемаНалогообложения = Перечисления.СистемыНалогообложения.Упрощенная И 
														ДС.УП.ОбъектНалогообложенияУСН = Перечисления.ОбъектыНалогообложенияПоУСН.ДоходыМинусРасходы);
					
					ЗаполнитьПередКорректировкой = CW_Документы.НужноПоказатьПередКорректировкой(ЭтотОбъект);
					
					Для каждого Стр Из Услуги Цикл
						
						Если (Стр.ПорядокОтражения = Перечисления.CW_ПорядокОтраженияЗатрат.Затраты) Тогда
							
							Нстр = ВедомыйОбъект.Услуги.Добавить();
							// --- 
							Нстр.ЕстьВДокументеПоступления = Не Стр.ЭтоДобавленнаяСтрока;
							Нстр.Номенклатура = Стр.Номенклатура;
							// --- 
							Нстр.СодержаниеДоИзменения = СокрЛП(Стр.Представление_ДоКорректировки);
							Нстр.Содержание = СокрЛП(Стр.Представление);
							// --- 
							Нстр.КоличествоДоИзменения = Стр.Количество_ДоКорректировки;
							Нстр.Количество = Стр.Количество;
							// --- 
							Нстр.ЦенаДоИзменения 	= ?(ПоказатьРубли, Стр.Цена_ДоКорректировкиРег, Стр.Цена_ДоКорректировки);
							Нстр.Цена 				= ?(ПоказатьРубли, Стр.ЦенаРег, Стр.Цена);
							// --- 
							Нстр.СуммаДоИзменения 	= ?(ПоказатьРубли, Стр.Сумма_ДоКорректировкиРег, Стр.Сумма_ДоКорректировки);
							Нстр.Сумма 				= ?(ПоказатьРубли, Стр.СуммаРег, Стр.Сумма);
							// --- 
							Нстр.СтавкаНДСДоИзменения 	= Стр.СтавкаНДС_ДоКорректировки;
							Нстр.СтавкаНДС 				= Стр.СтавкаНДС;
							// --- 
							Нстр.СуммаНДСДоИзменения 	= ?(ПоказатьРубли, Стр.НДС_ДоКорректировкиРег,Стр.НДС_ДоКорректировки);
							Нстр.СуммаНДС 				= ?(ПоказатьРубли, Стр.НДСРег, Стр.НДС);     
							
							Если ЗаполнитьПередКорректировкой Тогда
								Нстр.КоличествоДоКорректировки 	= Стр.Количество_ПередКорректировкой;    
								
								Нстр.ЦенаДоКорректировки 		= ?(ПоказатьРубли, Стр.Цена_ПередКорректировкойРег, 	Стр.Цена_ПередКорректировкой);
								Нстр.СуммаДоКорректировки 		= ?(ПоказатьРубли, Стр.Сумма_ПередКорректировкойРег, 	Стр.Сумма_ПередКорректировкой);
								Нстр.СуммаНДСДоКорректировки 	= ?(ПоказатьРубли, Стр.НДС_ПередКорректировкойРег, 		Стр.НДС_ПередКорректировкой);
							КонецЕсли;
							
							Если ИндексСтрокиСобственных <= МаксИндексСтрокиСобственных Тогда
								
								// остальные реквизиты берём из соответствующей строки ведомого корректируемого документа
								СтрокаДокументаПоступления = ТаблицаУслугСобственных[ИндексСтрокиСобственных];
								_сф.Инкремент(ИндексСтрокиСобственных);
								// --- 
								ЗаполнитьЗначенияСвойств(Нстр,СтрокаДокументаПоступления,"СчетЗатрат,ПодразделениеЗатрат,Субконто1,Субконто2,Субконто3,СчетЗатратНУ,СубконтоНУ1,СубконтоНУ2,СубконтоНУ3,СчетУчетаНДС,ОтражениеВУСН,СпособУчетаНДС");
							Иначе
								
								Нстр.СчетЗатрат 	= Счета.ОсновноеПроизводство; // 20.01
								Нстр.Субконто1 		= Стр.Номенклатура.НоменклатурнаяГруппа;
								Нстр.Субконто2 		= Стр.СтатьяЗатрат;
								
								Нстр.СчетЗатратНУ 	= Счета.ОсновноеПроизводство; // 20.01
								Нстр.СубконтоНУ1 	= Стр.Номенклатура.НоменклатурнаяГруппа;
								Нстр.СубконтоНУ2 	= Стр.СтатьяЗатрат;
								
								Нстр.СчетУчетаНДС 	= Счета.НДСпоПриобретеннымУслугам; // 19.04
								
								
								//AFR-250327 от 25.07.2025 16:37:23
								Если ВариантыПриложений.ЭтоВерсияКОРП() 
									И Не ДС.УП.ГруппировкаЗатратПоПодразделениям Тогда
									Нстр.ПодразделениеЗатрат = ?(ЗначениеЗаполнено(ПодразделениеОрганизации),ПодразделениеОрганизации,ДС.УП.ОсновноеПодразделение);	
								ИначеЕсли ВариантыПриложений.ЭтоВерсияПРОФ()  
									И Не ДС.УП.ГруппировкаЗатратПоПодразделениям Тогда
									Нстр.ПодразделениеЗатрат = ДС.УП.ОсновноеПодразделение;  
								Иначе
									Нстр.ПодразделениеЗатрат = Стр.Подразделение;	
								КонецЕсли;
								//---AFR-250327 от 25.07.2025 16:37:23
								
								Если (ДС.УП.РаздельныйУчетНДСНаСчете19) Тогда
									Если (НЕ Стр.СпособУчетаНДС.Пустая()) Тогда
										Нстр.СпособУчетаНДС = Стр.СпособУчетаНДС;
									Иначе
										СтруктураПараметров = Новый Структура;
										СтруктураПараметров.Вставить("Дата"					, Дата);
										СтруктураПараметров.Вставить("Организация"			, Организация);
										СтруктураПараметров.Вставить("Номенклатура"			, Нстр.Номенклатура);
										СтруктураПараметров.Вставить("НоменклатурнаяГруппа"	, Нстр.Номенклатура.НоменклатурнаяГруппа);
										
										Нстр.СпособУчетаНДС = CW_Финансы.ПолучитьСпособУчетаНДС(СтруктураПараметров, Ложь);
									КонецЕсли;	
								КонецЕсли; 
								
								Если ТребуетсяЗаполнениеОтраженияВУСН Тогда
									Если ВидДеятельностиНУ=Перечисления.ВидыДеятельностиДляНалоговогоУчетаЗатрат.ОсновнаяСистемаНалогообложения Тогда
										Нстр.ОтражениеВУСН=Перечисления.ОтражениеВУСН.Принимаются;
									ИначеЕсли ВидДеятельностиНУ=Перечисления.ВидыДеятельностиДляНалоговогоУчетаЗатрат.ОсобыйПорядокНалогообложения Тогда 
										Нстр.ОтражениеВУСН=Перечисления.ОтражениеВУСН.НеПринимаются;
									ИначеЕсли ВидДеятельностиНУ=Перечисления.ВидыДеятельностиДляНалоговогоУчетаЗатрат.РаспределяемыеЗатраты Тогда 
										Нстр.ОтражениеВУСН=Перечисления.ОтражениеВУСН.Распределяются;
									КонецЕсли; 
								КонецЕсли; 
								
							КонецЕсли;
							
						ИначеЕсли (Стр.ПорядокОтражения = Перечисления.CW_ПорядокОтраженияЗатрат.ПрочиеРасходы) Тогда
							
							Нстр = ВедомыйОбъект.Услуги.Добавить();
							// --- 
							Нстр.ЕстьВДокументеПоступления = Не Стр.ЭтоДобавленнаяСтрока;
							Нстр.Номенклатура = Стр.Номенклатура;
							// --- 
							Нстр.СодержаниеДоИзменения = СокрЛП(Стр.Представление_ДоКорректировки);
							Нстр.Содержание = СокрЛП(Стр.Представление);
							// --- 
							Нстр.КоличествоДоИзменения = Стр.Количество_ДоКорректировки;
							Нстр.Количество = Стр.Количество;
							// --- 
							Нстр.ЦенаДоИзменения 	= ?(ПоказатьРубли, Стр.Цена_ДоКорректировкиРег, Стр.Цена_ДоКорректировки);
							Нстр.Цена 				= ?(ПоказатьРубли, Стр.ЦенаРег, Стр.Цена);
							// --- 
							Нстр.СуммаДоИзменения 	= ?(ПоказатьРубли, Стр.Сумма_ДоКорректировкиРег, Стр.Сумма_ДоКорректировки);
							Нстр.Сумма 				= ?(ПоказатьРубли, Стр.СуммаРег, Стр.Сумма);
							// --- 
							Нстр.СтавкаНДСДоИзменения 	= Стр.СтавкаНДС_ДоКорректировки;
							Нстр.СтавкаНДС 				= Стр.СтавкаНДС;
							// --- 
							Нстр.СуммаНДСДоИзменения 	= ?(ПоказатьРубли, Стр.НДС_ДоКорректировкиРег, Стр.НДС_ДоКорректировки);
							Нстр.СуммаНДС 				= ?(ПоказатьРубли, Стр.НДСРег, Стр.НДС);
							
							Если ЗаполнитьПередКорректировкой Тогда
								Нстр.КоличествоДоКорректировки 	= Стр.Количество_ПередКорректировкой;
								Нстр.ЦенаДоКорректировки 		= ?(ПоказатьРубли, Стр.Цена_ПередКорректировкойРег,  Стр.Цена_ПередКорректировкой);
								Нстр.СуммаДоКорректировки 		= ?(ПоказатьРубли, Стр.Сумма_ПередКорректировкойРег, Стр.Сумма_ПередКорректировкой);
								Нстр.СуммаНДСДоКорректировки 	= ?(ПоказатьРубли, Стр.НДС_ПередКорректировкойРег,   Стр.НДС_ПередКорректировкой);
							КонецЕсли;
	
							Если ИндексСтрокиСобственных <= МаксИндексСтрокиСобственных Тогда
								
								// остальные реквизиты берём из соответствующей строки ведомого корректируемого документа
								СтрокаДокументаПоступления = ТаблицаУслугСобственных[ИндексСтрокиСобственных];
								_сф.Инкремент(ИндексСтрокиСобственных);
								// --- 
								ЗаполнитьЗначенияСвойств(Нстр,СтрокаДокументаПоступления,"СчетЗатрат,ПодразделениеЗатрат,Субконто1,Субконто2,Субконто3,СчетЗатратНУ,СубконтоНУ1,СубконтоНУ2,СубконтоНУ3,СчетУчетаНДС,ОтражениеВУСН,СпособУчетаНДС");
							Иначе
								
								Нстр.СчетЗатрат 	= Счета.ПрочиеРасходы; // 91.02
								Нстр.Субконто1 		= Стр.ПрочиеРасходы;
								Нстр.Субконто2 		= Стр.Номенклатура;
								
								Нстр.СчетЗатратНУ 	= Счета.ПрочиеРасходы; // 91.02
								Нстр.СубконтоНУ1 	= Стр.ПрочиеРасходы;
								Нстр.СубконтоНУ2 	= Стр.Номенклатура;
								
								Нстр.СчетУчетаНДС 	= Счета.НДСпоПриобретеннымУслугам; // 19.04
								
								//AFR-250327 от 25.07.2025 16:37:23
								Если ВариантыПриложений.ЭтоВерсияКОРП() 
									И Не ДС.УП.ГруппировкаЗатратПоПодразделениям Тогда
									Нстр.ПодразделениеЗатрат = ?(ЗначениеЗаполнено(ПодразделениеОрганизации),ПодразделениеОрганизации,ДС.УП.ОсновноеПодразделение);	
								ИначеЕсли ВариантыПриложений.ЭтоВерсияПРОФ()  
									И Не ДС.УП.ГруппировкаЗатратПоПодразделениям Тогда
									Нстр.ПодразделениеЗатрат = ДС.УП.ОсновноеПодразделение;  
								Иначе
									Нстр.ПодразделениеЗатрат = СтрТЧ.Подразделение;	
								КонецЕсли;
								//---AFR-250327 от 25.07.2025 16:37:23
								
								Если (ДС.УП.РаздельныйУчетНДСНаСчете19) Тогда
									Если (НЕ Стр.СпособУчетаНДС.Пустая()) Тогда
										Нстр.СпособУчетаНДС = Стр.СпособУчетаНДС;
									Иначе
										СтруктураПараметров = Новый Структура;
										СтруктураПараметров.Вставить("Дата"					, Дата);
										СтруктураПараметров.Вставить("Организация"			, Организация);
										СтруктураПараметров.Вставить("Номенклатура"			, Нстр.Номенклатура);
										СтруктураПараметров.Вставить("НоменклатурнаяГруппа"	, Нстр.Номенклатура.НоменклатурнаяГруппа);
										
										Нстр.СпособУчетаНДС = CW_Финансы.ПолучитьСпособУчетаНДС(СтруктураПараметров, Ложь);
									КонецЕсли;	
								КонецЕсли; 
								
								Если ТребуетсяЗаполнениеОтраженияВУСН Тогда
									Если ВидДеятельностиНУ=Перечисления.ВидыДеятельностиДляНалоговогоУчетаЗатрат.ОсновнаяСистемаНалогообложения Тогда
										Нстр.ОтражениеВУСН=Перечисления.ОтражениеВУСН.Принимаются;
									ИначеЕсли ВидДеятельностиНУ=Перечисления.ВидыДеятельностиДляНалоговогоУчетаЗатрат.ОсобыйПорядокНалогообложения Тогда 
										Нстр.ОтражениеВУСН=Перечисления.ОтражениеВУСН.НеПринимаются;
									ИначеЕсли ВидДеятельностиНУ=Перечисления.ВидыДеятельностиДляНалоговогоУчетаЗатрат.РаспределяемыеЗатраты Тогда 
										Нстр.ОтражениеВУСН=Перечисления.ОтражениеВУСН.Распределяются;
									КонецЕсли; 
								КонецЕсли; 
								
							КонецЕсли;
							
						Иначе
							
							Нстр = ВедомыйОбъект.АгентскиеУслуги.Добавить();
							// --- 
							Нстр.ЕстьВДокументеПоступления = Не Стр.ЭтоДобавленнаяСтрока;
							Нстр.Номенклатура = Стр.Номенклатура;
							// --- 
							Нстр.СодержаниеДоИзменения = СокрЛП(Стр.Представление_ДоКорректировки);
							Нстр.Содержание = СокрЛП(Стр.Представление);
							// --- 
							Нстр.КоличествоДоИзменения = Стр.Количество_ДоКорректировки;
							Нстр.Количество = Стр.Количество;
							// --- 
							Нстр.ЦенаДоИзменения 	= ?(ПоказатьРубли, Стр.Цена_ДоКорректировкиРег, Стр.Цена_ДоКорректировки);
							Нстр.Цена 				= ?(ПоказатьРубли, Стр.ЦенаРег, Стр.Цена);
							// --- 
							Нстр.СуммаДоИзменения 	= ?(ПоказатьРубли, Стр.Сумма_ДоКорректировкиРег, Стр.Сумма_ДоКорректировки);
							Нстр.Сумма 				= ?(ПоказатьРубли, Стр.СуммаРег, Стр.Сумма);
							// --- 
							Нстр.СтавкаНДСДоИзменения = Стр.СтавкаНДС_ДоКорректировки;
							Нстр.СтавкаНДС = Стр.СтавкаНДС;
							// --- 
							Нстр.СуммаНДСДоИзменения 	= ?(ПоказатьРубли, Стр.НДС_ДоКорректировкиРег, Стр.НДС_ДоКорректировки);
							Нстр.СуммаНДС 				= ?(ПоказатьРубли, Стр.НДСРег, Стр.НДС);
							
							Если ЗаполнитьПередКорректировкой Тогда
								Нстр.КоличествоДоКорректировки 	= Стр.Количество_ПередКорректировкой;
								Нстр.ЦенаДоКорректировки 		= ?(ПоказатьРубли, Стр.Цена_ПередКорректировкойРег, Стр.Цена_ПередКорректировкой);
								Нстр.СуммаДоКорректировки 		= ?(ПоказатьРубли, Стр.Сумма_ПередКорректировкойРег, Стр.Сумма_ПередКорректировкой);
								Нстр.СуммаНДСДоКорректировки 	= ?(ПоказатьРубли, Стр.НДС_ПередКорректировкойРег, Стр.НДС_ПередКорректировкой);
							КонецЕсли;
	
							Если ИндексСтрокиАгентских <= МаксИндексСтрокиАгентских Тогда
								
								СтрокаДокументаПоступления = ТаблицаУслугАгентских[ИндексСтрокиАгентских];
								_сф.Инкремент(ИндексСтрокиАгентских);
								// --- 
								ЗаполнитьЗначенияСвойств(Нстр,СтрокаДокументаПоступления,"СчетРасчетов,Контрагент,ДоговорКонтрагента");
								
							Иначе
								// это перевыставление по ставкам
								Нстр.Контрагент 			= Стр.Покупатель;
								Нстр.СтавкаНДСДоИзменения 	= Стр.СтавкаНДС_ДоКорректировки;
								Нстр.СодержаниеДоИзменения  = СокрЛП(Стр.Представление);
								
								АгентскийДоговорКонтрагента = Стр.ДоговорПокупателя.АгентскийДоговорНаПродажу;
								Если ВедетсяУчетПриложенийПоДоговорам и ЗначениеЗаполнено(Стр.ПриложениеКДоговору) Тогда
									АгентскийДоговорКонтрагента = Стр.ПриложениеКДоговору.АгентскийДоговорНаПродажу;
								КонецЕсли;
								
								Если НЕ ЗначениеЗаполнено(АгентскийДоговорКонтрагента) Тогда
									
									СтруктураДоговора = Новый Структура;
									СтруктураДоговора.Вставить("Договор", 				Стр.ДоговорПокупателя); 
									СтруктураДоговора.Вставить("ПриложениеКДоговору", 	Стр.ПриложениеКДоговору); 
									
									АгентскийДоговорКонтрагента = CW_Финансы.СоздатьАгентскийДоговор(СтруктураДоговора,Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком); 
								КонецЕсли;
								Нстр.ДоговорКонтрагента = АгентскийДоговорКонтрагента;
								
								Если (АгентскийДоговорКонтрагента <> Неопределено) Тогда
									
									// определяем счёт расчётов
									ВалютныйДоговор = АгентскийДоговорКонтрагента.Валютный;
									ОплатаВВалюте = АгентскийДоговорКонтрагента.ОплатаВВалюте;
									// --- 
									Нстр.СчетРасчетов = ПолучитьСчетРасчетовДляАгентскогоДоговора(ВалютныйДоговор, Стр.ПорядокОтражения, ОплатаВВалюте, Счета);
									
								КонецЕсли; 
								
								
							КонецЕсли;
							
							
						КонецЕсли; 
						
					КонецЦикла; 
					
					// --- 
					ВедомыйОбъект.ОбменДанными.Загрузка = Ложь;
					// --- 
					CW_Документы.ПеренестиПризнакВосстановленияПоследовательности(ЭтотОбъект,ВедомыйОбъект);
					// --- 
					ВедомыйОбъект.Записать(РежимЗаписи);
					
					
				КонецЕсли; 
								
			Иначе
				
				Если (НЕ ВедомыйДокументКорректировки.Пустая()) Тогда
					
					ПометитьНаУдаление(ВедомыйДокументКорректировки);
					
				КонецЕсли;
				
			КонецЕсли; 
			
		КонецЕсли; 
		
		
	КонецЕсли;
	
КонецПроцедуры // ПриЗаписи()

Функция ПолучитьСчетРасчетовДляАгентскогоДоговора(ВалютныйДоговор, ПорядокОтражения, ОплатаВВалюте, Счета)
	
	Если (ПорядокОтражения = Перечисления.CW_ПорядокОтраженияЗатрат.Перевыставление) Тогда
		
		Если НЕ ВалютныйДоговор Тогда
			СчетРасчетов = Счета.РасчетыСПрочимиПоставщикамиИПодрядчиками; // 76.05
		Иначе
			Если (ОплатаВВалюте) Тогда
				СчетРасчетов = Счета.РасчетыСПрочимиПоставщикамиИПодрядчикамиВал; // 76.25
			Иначе
				СчетРасчетов = Счета.РасчетыСПрочимиПоставщикамиИПодрядчикамиУЕ; // 76.35
			КонецЕсли; 
		КонецЕсли; 
		
	Иначе 
		
		Если НЕ ВалютныйДоговор Тогда
			СчетРасчетов = Счета.РасчетыСПрочимиПокупателямиИЗаказчиками; // 76.06
		Иначе
			Если (ОплатаВВалюте) Тогда
				СчетРасчетов = Счета.РасчетыСПрочимиПокупателямиИЗаказчикамиВал; // 76.26
			Иначе
				СчетРасчетов = Счета.РасчетыСПрочимиПокупателямиИЗаказчикамиУЕ; // 76.36
			КонецЕсли; 
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат СчетРасчетов;
	
КонецФункции

Функция ПроверитьСоответствиеБухгалтескогоУчетаДогововров(Отказ)
	
		СтруктураПараметровБухУчета = Новый Структура;
	СтруктураПараметровБухУчета.Вставить("Договор",					Договор);
	СтруктураПараметровБухУчета.Вставить("ПриложениеКДоговору",		ПриложениеКДоговору);
	
	ПараметрыБухгалтерскогоУчетаПоставщика = CW_Финансы.ПолучитьПарметрыВеденияБухгалтерскогоУчета(СтруктураПараметровБухУчета, Дата);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	УслугиОбъекта.НомерСтроки КАК НомерСтроки,
	               |	УслугиОбъекта.ПорядокОтражения КАК ПорядокОтражения,
	               |	УслугиОбъекта.ДоговорПокупателя КАК ДоговорПокупателя,
	               |	УслугиОбъекта.ПриложениеКДоговору КАК ПриложениеКДоговору
	               |ПОМЕСТИТЬ ВТ_ТаблицаОбъекта
	               |ИЗ
	               |	&УслугиОбъекта КАК УслугиОбъекта
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ_ТаблицаОбъекта.НомерСтроки КАК НомерСтроки,
	               |	ВТ_ТаблицаОбъекта.ПорядокОтражения КАК ПорядокОтражения,
	               |	ВТ_ТаблицаОбъекта.ДоговорПокупателя КАК ДоговорПокупателя,
	               |	ВТ_ТаблицаОбъекта.ПриложениеКДоговору КАК ПриложениеКДоговору
	               |ИЗ
	               |	ВТ_ТаблицаОбъекта КАК ВТ_ТаблицаОбъекта
	               |ГДЕ
	               |	ВТ_ТаблицаОбъекта.ПорядокОтражения В(&мПорядокОтражения)";
	
	мПорядокОтражения = Новый Массив;
	мПорядокОтражения.Добавить(ПредопределенноеЗначение("Перечисление.CW_ПорядокОтраженияЗатрат.Перевыставление"));
	мПорядокОтражения.Добавить(ПредопределенноеЗначение("Перечисление.CW_ПорядокОтраженияЗатрат.ПеревыставлениеПоСтавкам"));
	
	Запрос.УстановитьПараметр("УслугиОбъекта", 		ЭтотОбъект.Услуги.Выгрузить());	
	Запрос.УстановитьПараметр("мПорядокОтражения", 	мПорядокОтражения);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	РезкльтатыПроверки = Новый Соответствие;
	
	Если НЕ РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
			
			СтруктураПараметровБухУчета = Новый Структура;
			СтруктураПараметровБухУчета.Вставить("Договор",					Выборка.ДоговорПокупателя);
			СтруктураПараметровБухУчета.Вставить("ПриложениеКДоговору",		Выборка.ПриложениеКДоговору);
			
			РезультатПроверки = РезкльтатыПроверки.Получить(Выборка.ДоговорПокупателя); 
			Если РезультатПроверки = Неопределено Тогда
				ПараметрыБухгалтерскогоУчетаПокупателя = CW_Финансы.ПолучитьПарметрыВеденияБухгалтерскогоУчета(СтруктураПараметровБухУчета, Дата);
				
				РезультатПроверки = ПараметрыБухгалтерскогоУчетаПоставщика.БухгалтерскийУчет = ПараметрыБухгалтерскогоУчетаПокупателя.БухгалтерскийУчет;
				РезкльтатыПроверки.Вставить(Выборка.ДоговорПокупателя, РезультатПроверки);
			КонецЕсли;
			
			Если НЕ РезультатПроверки Тогда
				
				ИмяПоляТаблицы = "ДоговорПокупателя";
				Если ЗначениеЗаполнено(Выборка.ПриложениеКДоговору) Тогда
					ИмяПоляТаблицы = "ПриложениеКДоговору";
				КонецЕсли;
				
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Признак ведения БУ не соответствует договору поставщика!",,"Услуги["+(Выборка.НомерСтроки-1)+"]."+ИмяПоляТаблицы, "Объект", Отказ);
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецФункции


Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	// контроль загрузки
	Если (ОбменДанными.Загрузка) Тогда 
		Возврат; 
	КонецЕсли;
	Если (РучнаяКорректировка) Тогда 
		Возврат; 
	КонецЕсли; 
	
	// не перепроводим при восстановлении последовательности
	ВосстановлениеПоследовательности = _сф.ст_ПолучитьСвойство(ДополнительныеСвойства,"ПроведенВХронологическойПоследовательности");
	Если (ВосстановлениеПоследовательности <> Неопределено) Тогда
		Если (ВосстановлениеПоследовательности) Тогда
			Возврат;
		КонецЕсли; 
	КонецЕсли; 
	
	// контроль наличия общих параметров   
	CW_БухгалтерияЭкспедитораСервер.УстановитьОбщиеПараметрыПроведенияДокументов();
	
	Если НЕ ЗаполненыОбщиеПараметры() Тогда 
		СформироватьОбщиеПараметры(,Ложь); 
	КонецЕсли; 
	
	//Подситема.СтатусыДокументов
	ИспользуютсяСтатусыДокументов = ПолучитьФункциональнуюОпцию("CW_ИспользуютсяСтатусыДокументов");
	Если ИспользуютсяСтатусыДокументов И
		Не ЭтотОбъект.ДополнительныеСвойства.Свойство("СтатусДокумента") Тогда
		//В случае если используются статусы документа и проведение не из формы, тов ДС статуса нет
		ДанныеСтатуса = РегистрыСведений.CW_СтатусыДокументов.ПолучитьДанныеСтатусаДокумента(Ссылка);
		ЭтотОбъект.ДополнительныеСвойства.Вставить("СтатусДокумента", ДанныеСтатуса.СтатусДокумента);
	КонецЕсли;
	
	СтатусДокумента = Неопределено;
	ЭтотОбъект.ДополнительныеСвойства.Свойство("СтатусДокумента", СтатусДокумента);
	
	СтатусДокументаПроводитьПоБухгалтерскомуУчету = CW_СтатусыДокументовСервер.ПолучитьПризнакПроведенияПоБухгалтерскомуУчету(Ссылка, СтатусДокумента);
	//Подситема.СтатусыДокументов
	
	СтруктураПараметровБухУчета = Новый Структура;
	СтруктураПараметровБухУчета.Вставить("Договор",					Договор);
	СтруктураПараметровБухУчета.Вставить("ПриложениеКДоговору",		ПриложениеКДоговору);
	
	ПараметрыБухгалтерскогоУчета = CW_Финансы.ПолучитьПарметрыВеденияБухгалтерскогоУчета(СтруктураПараметровБухУчета, Дата);
	
	ПровестиПоБухгалтерскомуУчету = ПараметрыБухгалтерскогоУчета.БухгалтерскийУчет и СтатусДокументаПроводитьПоБухгалтерскомуУчету;

	// для счетов и ОУ
	Если (НЕ (ПредъявленАкт ИЛИ ПредъявленСФ) ИЛИ НЕ ПровестиПоБухгалтерскомуУчету) Тогда
		Если (НЕ Корректировка) Тогда
			CW_Подписки.СформироватьДвиженияДляРасходов(Ссылка,Отказ,ДополнительныеСвойства);
		Иначе
			CW_Подписки.СформироватьДвиженияДляКорректировкиРасходов(Ссылка,Отказ,ДополнительныеСвойства);
		КонецЕсли; 
	КонецЕсли; 
	
КонецПроцедуры

Процедура ПроверитьСтатусВедомых(РежимЗаписи)
	
	Если (НЕ Корректировка) Тогда
		Если (НЕ ВедомыйДокумент.Пустая()) Тогда
			Если (ПредъявленАкт) Тогда
				СинхронизироватьПометкуУдаления(ВедомыйДокумент, РежимЗаписи);
			Иначе
				ПометитьНаУдаление(ВедомыйДокумент);
			КонецЕсли; 
		КонецЕсли; 
		
		Если (НЕ ВедомыйСчет.Пустая()) Тогда
			Если (ПредъявленСчет) Тогда
				СинхронизироватьПометкуУдаления(ВедомыйСчет, РежимЗаписи);
			Иначе
				ПометитьНаУдаление(ВедомыйСчет);
			КонецЕсли; 
		КонецЕсли; 
	КонецЕсли; 
	
	Если (Корректировка) Тогда
		Если (НЕ ВедомыйДокументКорректировки.Пустая()) Тогда
			Если (ПредъявленАкт) Тогда
				СинхронизироватьПометкуУдаления(ВедомыйДокументКорректировки, РежимЗаписи);
			Иначе
				ПометитьНаУдаление(ВедомыйДокументКорректировки);
			КонецЕсли; 
		КонецЕсли; 
	КонецЕсли; 
	
КонецПроцедуры

Процедура СинхронизироватьПометкуУдаления(Документ, РежимЗаписи)
	
	Если Документ.ПометкаУдаления <> ПометкаУдаления Тогда
		ВедомыйОбъект = Документ.ПолучитьОбъект();
		_сф.ст_УстановитьСвойство(ВедомыйОбъект.ДополнительныеСвойства,"ВедущийДокумент",Ссылка);
		ВедомыйОбъект.УстановитьПометкуУдаления(ПометкаУдаления);
	Иначе
		ВедомыйОбъект = Документ.ПолучитьОбъект();
		_сф.ст_УстановитьСвойство(ВедомыйОбъект.ДополнительныеСвойства,"ВедущийДокумент",Ссылка);
		ВедомыйОбъект.Записать(РежимЗаписи); 
	КонецЕсли;   
	
	
КонецПроцедуры

Процедура ПометитьНаУдаление(Документ)
	
	Если Документ.ПометкаУдаления <> Истина Тогда
		
		ВедомыйОбъект = Документ.ПолучитьОбъект();
		_сф.ст_УстановитьСвойство(ВедомыйОбъект.ДополнительныеСвойства,"ВедущийДокумент",Ссылка);
		ВедомыйОбъект.УстановитьПометкуУдаления(Истина);
		
	КонецЕсли; 
	
КонецПроцедуры

Процедура СформироватьОбщиеПараметры(Знач СписокПараметров = Неопределено,ИнтерактивныйРежим = Истина) Экспорт 
