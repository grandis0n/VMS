						// создаем
						Если (ТребуетсяСозданиеВедомого) Тогда
							Ведомый = Документы.КорректировкаПоступления.СоздатьДокумент();	
						Иначе
							Ведомый = ВедомыйДокументКорректировки.ПолучитьОбъект();
							Если Год(Ведомый.Дата) <> Год(НоваяДата) Тогда
								Ведомый.Номер = "";	
							КонецЕсли;
							
						КонецЕсли; 
						// --- 
						Ведомый.Дата 					= НоваяДата;
						Ведомый.ОбменДанными.Загрузка	= Истина;
						Ведомый.ПометкаУдаления 		= Ложь;
						Ведомый.Организация 			= Организация;
						
						Ведомый.ЭтоУниверсальныйДокумент = ЭтоУниверсальныйДокумент;
	
						//Для версии КОРП
						Если ВестиУчетПоПодразделениям Тогда
							Ведомый.ПодразделениеОрганизации = ПодразделениеОрганизации;
						КонецЕсли;
						//Для версии КОРП  
						
						НомерДатаВходящего = ПолучитьНомерИДатуВходящегоПоступления();
						Ведомый.ДатаВходящегоДокумента 	= НомерДатаВходящего.ДатаАкта;
						Ведомый.НомерВходящегоДокумента = НомерДатаВходящего.НомерАкта;  
						
						// формирование представления номера для документа "Корректировка поступления"
						Если ВидОперацииКорректировки = Перечисления.ВидыОперацийИсправленияПоступленияРеализации.ИсправлениеОшибки Тогда  
							Если КорректируемыйДокумент.Корректировка Тогда
								ИсправляемыйБухгалтерскийДокумент = КорректируемыйДокумент.ВедомыйДокументКорректировки;	
							Иначе
								ИсправляемыйБухгалтерскийДокумент = КорректируемыйДокумент.ВедомыйДокумент;	
							КонецЕсли;
							
							НомерПредставления 	= ПрефиксацияОбъектовКлиентСервер.НомерНаПечать(
							ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ИсправляемыйБухгалтерскийДокумент, "Номер"), Истина, Ложь); 
							Ведомый.ПредставлениеНомера = Строка(НомерПредставления) + " (испр. " + НомерИсправления + ")";
						Иначе
							Если НЕ ЗначениеЗаполнено(Ведомый.Номер) Тогда
								Ведомый.УстановитьНовыйНомер();	
							КонецЕсли;
							
							Ведомый.ПредставлениеНомера = ПрефиксацияОбъектовКлиентСервер.НомерНаПечать(Ведомый.Номер, Истина, Ложь);
						КонецЕсли;
						
						
						// в случае, если корректировочному документу оформляется с/ф, то запишем реквизиты корректируемой с/ф
						Если ПредъявленСФ Тогда 
							НомерДатаВходящего = ПолучитьНомерИДатуВходящегоСчетФактуры();
							Ведомый.НомерИсходногоДокумента  = НомерДатаВходящего.НомерСФ; 
							Ведомый.ДатаИсходногоДокумента   = НомерДатаВходящего.ДатаСФ; 
						КонецЕсли;
						
						
						CW_Документы.ПеренестиПризнакВосстановленияПоследовательности(ЭтотОбъект,Ведомый);
						
						Ведомый.Комментарий = "Сформировано автоматически (CW) документом ""Расходы по грузоперевозке"" №"+Строка(Номер)+" от "+Формат(Дата,"ДФ=dd.MM.yyyy");
						
						Ведомый.Записать();
						ВедомыйДокументКорректировки = Ведомый.Ссылка;
						
					КонецЕсли; 
					
					// --- 
					
					Если (ПредъявленСФ) Тогда
						
						ТребуетсяСозданиеСФ = Ложь;
						Если (НЕ ЗначениеЗаполнено(ВедомыйСчетФактураКорректировочный)) Тогда
							ТребуетсяСозданиеСФ=Истина;
						КонецЕсли; 
						Если (НЕ ТребуетсяСозданиеВедомого) Тогда
							Если (НЕ _СФ.ОбъектБДСуществует(ВедомыйСчетФактураКорректировочный)) Тогда
								ТребуетсяСозданиеВедомого = Истина;
							КонецЕсли; 
						КонецЕсли;
						Если (ТребуетсяСозданиеСФ ИЛИ ДатаСФ <> ВедомыйСчетФактураКорректировочный.Дата ИЛИ ВедомыйСчетФактураКорректировочный.ПометкаУдаления) Тогда
							
							Если (ТребуетсяСозданиеСФ) Тогда
								Ведомый = Документы.СчетФактураПолученный.СоздатьДокумент();
							Иначе
								Ведомый = ВедомыйСчетФактураКорректировочный.ПолучитьОбъект();  
								Если Год(Ведомый.Дата) <> Год(?(ЗначениеЗаполнено(ДатаПолучения), ДатаПолучения, Дата)) Тогда
									Ведомый.Номер = "";	
								КонецЕсли;
								
							КонецЕсли; 
							
							Ведомый.ВидСчетаФактуры			= Перечисления.ВидСчетаФактурыПолученного.Корректировочный;
							
							Если ВидОперацииКорректировки = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсправленияПоступленияРеализации.ИсправлениеОшибки") Тогда
								Ведомый.Дата 				= ?(ЗначениеЗаполнено(ДатаПолучения), ДатаПолучения, Дата); 
								Ведомый.ДатаИсправления		= ДатаСФ;
								Ведомый.НомерИсправления	= НомерИсправления;
								Ведомый.ВидСчетаФактуры		= Перечисления.ВидСчетаФактурыПолученного.Корректировочный;
							Иначе
								Ведомый.Дата				= ?(ЗначениеЗаполнено(ДатаПолучения), ДатаПолучения, КонецДня(ДатаСФ));
								//Ведомый.Номер 				= НомерСФ;
							КонецЕсли;
							
							НомерДатаВходящего = ПолучитьНомерИДатуВходящегоСчетФактуры();
							Ведомый.ДатаВходящегоДокумента 	= НомерДатаВходящего.ДатаСФ;
							Ведомый.НомерВходящегоДокумента = НомерДатаВходящего.НомерСФ;   
							
							Ведомый.ДокументыОснования.Очистить();
					
							Ведомый.Организация	 			= Организация;
							Ведомый.Контрагент	 			= Контрагент;
							
							//КодВидаОперации
							Если ЗначениеЗаполнено(КодВидаОперации) Тогда
								Ведомый.КодВидаОперации = КодВидаОперации;  
								Ведомый.КодВидаОперацииНаУменьшение = КодВидаОперации;  
							Иначе
								Если Ведомый.Дата >= Дата(2016,07,1) И ЕстьСобственные И ЕстьПеревыставление Тогда
									Ведомый.КодВидаОперации = "15";
									Ведомый.КодВидаОперацииНаУменьшение = "18";  
								Иначе
									
									Ведомый.КодВидаОперации = "01";
									Ведомый.КодВидаОперацииНаУменьшение = "18";  
									
									мКоды = Новый Массив;
									Если ЕстьСобственные Тогда  
										мКоды.Добавить("01");
									КонецЕсли; 
									
									Если ЕстьПеревыставление Тогда 
										мКоды.Добавить(ДС.УП.КодВидаОперацииДляВходящихСчетовФактур);
									КонецЕсли; 
									
									Ведомый.КодВидаОперации = СтрСоединить(мКоды,";");
									
								КонецЕсли; 
							КонецЕсли; 
							//КодВидаОперации
	
							CW_Документы.ПеренестиПризнакВосстановленияПоследовательности(ЭтотОбъект,Ведомый);
							
							Ведомый.Комментарий = "Сформировано автоматически (CW) документом ""Расходы по грузоперевозке"" №"+Строка(Номер)+" от "+Формат(Дата,"ДФ=dd.MM.yyyy");
							
							Ведомый.ПометкаУдаления 		= Ложь;
							Ведомый.ОбменДанными.Загрузка	= Истина;
							Ведомый.Записать();
							
							ВедомыйСчетФактураКорректировочный = Ведомый.Ссылка;
							
						КонецЕсли; 
						
						
					КонецЕсли; 
					
					
				КонецЕсли; 
				
			КонецЕсли; 
			
		КонецЕсли; 
		
	КонецЕсли; 
	
	// пометка удаления для неиспользуемых ведомых
	Если (НЕ Корректировка) Тогда
		Если (НЕ ФормироватьСчет И ЗначениеЗаполнено(ВедомыйСчет) И НЕ ВедомыйСчет.ПометкаУдаления) Тогда
			
			Ведомый = ВедомыйСчет.ПолучитьОбъект();
			Ведомый.УстановитьПометкуУдаления(Истина);
			
		КонецЕсли; 
		Если (НЕ ФормироватьАкт И ЗначениеЗаполнено(ВедомыйДокумент) И НЕ ВедомыйДокумент.ПометкаУдаления) Тогда
			
			Ведомый = ВедомыйДокумент.ПолучитьОбъект();
			Ведомый.УстановитьПометкуУдаления(Истина);
			
		КонецЕсли; 
		Если (НЕ ФормироватьСчётФактура И ЗначениеЗаполнено(ВедомыйСчетФактура) И НЕ ВедомыйСчетФактура.ПометкаУдаления) Тогда
			
			Ведомый = ВедомыйСчетФактура.ПолучитьОбъект();
			Ведомый.УстановитьПометкуУдаления(Истина);
			
		КонецЕсли; 
	Иначе
		Если (НЕ ФормироватьСчет И ЗначениеЗаполнено(ВедомыйСчет) И НЕ ВедомыйСчет.ПометкаУдаления) Тогда
			
			Ведомый = ВедомыйСчетКорректировочный.ПолучитьОбъект();
			Ведомый.УстановитьПометкуУдаления(Истина);
			
		КонецЕсли; 
		Если (НЕ ПредъявленАкт И ЗначениеЗаполнено(ВедомыйДокументКорректировки) И НЕ ВедомыйДокументКорректировки.ПометкаУдаления) Тогда
			
			Ведомый = ВедомыйДокументКорректировки.ПолучитьОбъект();
			Ведомый.УстановитьПометкуУдаления(Истина);
			
		КонецЕсли; 
		Если (НЕ ПредъявленСФ И ЗначениеЗаполнено(ВедомыйСчетФактураКорректировочный) И НЕ ВедомыйСчетФактураКорректировочный.ПометкаУдаления) Тогда
			
			Ведомый = ВедомыйСчетФактураКорректировочный.ПолучитьОбъект();
			Ведомый.УстановитьПометкуУдаления(Истина);
			
		КонецЕсли; 
	КонецЕсли; 
	
	#Область ПроверкаЗаполненияРеквизитов
	Если РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
		
		НалоговыйАгент = ПараметрыБухгалтерскогоУчета.УчетныйДоговор.УчетАгентскогоНДС;
		РазрешитьПроведениеДокументовБезГрузоперевозок 	= CW_ПраваДоступа.ПравоДоступно("РазрешитьПроведениеДокументовБезГрузоперевозок");
		КонтролироватьСтрокиСНулевойСуммой 				= CW_Настройки.ПолучитьНастройкуПользователя(,"КонтролироватьСтрокиСНулевойСуммой");
		
		// проверка реквизитов
		Если Организация.Пустая() Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не указана организация!",,"Организация", "Объект", Отказ);
		КонецЕсли; 
		Если Контрагент.Пустая() Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не указан контрагент!",,"Контрагент", "Объект", Отказ);
		КонецЕсли; 
		Если Договор.Пустая() Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не указан договор контрагента!",,"Договор", "Объект", Отказ);
		КонецЕсли; 
		
		Если РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
			
			Если ПредъявленСчет Тогда
				Если СокрЛП(НомерСчета)="" Тогда
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не указан номер счета!",,"НомерСчета", "Объект", Отказ);
				КонецЕсли;
				Если ДатаСчета = Дата(1,1,1) Тогда
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не указана дата счета!",,"ДатаСчета", "Объект", Отказ);
				КонецЕсли;
			КонецЕсли;
			Если ПредъявленАкт Тогда
				Если СокрЛП(НомерАкта)="" Тогда
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не указан номер акта!",,"НомерАкта", "Объект", Отказ);
				КонецЕсли;
				Если ДатаАкта = Дата(1,1,1) Тогда
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не указана дата акта!",,"ДатаАкта", "Объект", Отказ);
				КонецЕсли;
			КонецЕсли;
			Если ПредъявленСФ Тогда
				Если СокрЛП(НомерСФ)="" Тогда
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не указан номер  счета-фактуры!",,"НомерСФ", "Объект", Отказ);
				КонецЕсли;
				Если ДатаСФ = Дата(1,1,1) Тогда
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не указана дата счета-фактуры!",,"ДатаСФ", "Объект", Отказ);
				КонецЕсли;
			КонецЕсли;
			
			Для каждого СтрокаУслуг Из Услуги Цикл
				
				ИндексСтроки = Услуги.Индекс(СтрокаУслуг);
				
				Если ДС.УП.ОЗ Тогда
					Если СписокСчетов Тогда
						Если (Дата >= ДС.УП.ДатаНачалаВеденияУчетаОЗ) Тогда
							Если СтрокаУслуг.Счет.Пустая() Тогда
								ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не указан актируемый счет!",,"Услуги["+ИндексСтроки+"].Счет", "Объект", Отказ);
							КонецЕсли; 
						КонецЕсли;
					КонецЕсли; 
				КонецЕсли; 
				
				Если Не РазрешитьПроведениеДокументовБезГрузоперевозок Тогда
					Если (СтрокаУслуг.Грузоперевозка.Пустая()) Тогда
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не указана грузоперевозка!",,"Услуги["+ИндексСтроки+"].Грузоперевозка", "Объект", Отказ);
					КонецЕсли; 
				КонецЕсли; 
				
				Если СтрокаУслуг.Номенклатура.Пустая() Тогда
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не указана номенклатура услуги!",,"Услуги["+ИндексСтроки+"].Номенклатура", "Объект", Отказ);
				КонецЕсли;
				
				Если ПолучитьФункциональнуюОпцию("CW_ОтображатьСтатьюЗатратВДокументахПоРасходамДоходам") Тогда
					Если СтрокаУслуг.СтатьяЗатрат.Пустая() и СтрокаУслуг.ПорядокОтражения = ПредопределенноеЗначение("Перечисление.CW_ПорядокОтраженияЗатрат.Затраты") Тогда
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не указана статья затрат!",,"Услуги["+ИндексСтроки+"].СтатьяЗатрат", "Объект", Отказ);
					КонецЕсли;                                                                                     
				КонецЕсли;
				
				Если (НЕ Корректировка) Тогда
					Если (СтрокаУслуг.Количество = 0) и КонтролироватьСтрокиСНулевойСуммой Тогда
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не указана количество!",,"Услуги["+ИндексСтроки+"].Количество", "Объект", Отказ);
					КонецЕсли;
					
					Если (СтрокаУслуг.Цена = 0) и КонтролироватьСтрокиСНулевойСуммой Тогда
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не указана цена!",,"Услуги["+ИндексСтроки+"].Цена", "Объект", Отказ);
					КонецЕсли;
					
					Если (СтрокаУслуг.Сумма = 0) и КонтролироватьСтрокиСНулевойСуммой Тогда
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не указана сумма!",,"Услуги["+ИндексСтроки+"].Сумма", "Объект", Отказ);
					КонецЕсли;
					
					Если СтрокаУслуг.СтавкаНДС.Пустая() Тогда
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не указана ставка НДС!",,"Услуги["+ИндексСтроки+"].СтавкаНДС", "Объект", Отказ);
					КонецЕсли;
					
					Если (НалоговыйАгент И СтрокаУслуг.СтавкаНДС <> Перечисления.СтавкиНДС.БезНДС) Тогда
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Должна быть указана ставка ""Без НДС""",,"Услуги["+ИндексСтроки+"].СтавкаНДС", "Объект", Отказ);
					КонецЕсли; 
					
					Если (СтрокаУслуг.НДС = 0) И 
						(СтрокаУслуг.СтавкаНДС <> Перечисления.СтавкиНДС.БезНДС) И
						(СтрокаУслуг.СтавкаНДС <> Перечисления.СтавкиНДС.НДС0) И 
						КонтролироватьСтрокиСНулевойСуммой Тогда
						
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не указана сумма НДС",,"Услуги["+ИндексСтроки+"].СтавкаНДС", "Объект", Отказ);
					КонецЕсли;
					
					Если (СтрокаУслуг.Всего = 0) И КонтролироватьСтрокиСНулевойСуммой Тогда
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не указана сумма всего",,"Услуги["+ИндексСтроки+"].Всего", "Объект", Отказ);
					КонецЕсли;
					
				КонецЕсли; 
				Если СтрокаУслуг.ПорядокОтражения.Пустая() Тогда
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не указан порядок отражения",,"Услуги["+ИндексСтроки+"].ПорядокОтражения", "Объект", Отказ);
				Иначе
					
					Если (СтрокаУслуг.ПорядокОтражения = Перечисления.CW_ПорядокОтраженияЗатрат.Затраты и ТребуетсяЗаполнениеПокупателя)
						ИЛИ СтрокаУслуг.ПорядокОтражения = Перечисления.CW_ПорядокОтраженияЗатрат.Перевыставление 
						ИЛИ СтрокаУслуг.ПорядокОтражения = Перечисления.CW_ПорядокОтраженияЗатрат.ПеревыставлениеПоСтавкам Тогда
						
						Если СтрокаУслуг.Покупатель.Пустая() Тогда
							ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не указан покупатель!",,"Услуги["+ИндексСтроки+"].Покупатель", "Объект", Отказ);
						КонецЕсли;
						Если СтрокаУслуг.ДоговорПокупателя.Пустая() Тогда
							ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не указан договор покупателя!",,"Услуги["+ИндексСтроки+"].ДоговорПокупателя", "Объект", Отказ);
						КонецЕсли;
					КонецЕсли; 
					
				КонецЕсли;
				
			КонецЦикла; 
			
		КонецЕсли; // для режима записи "Проведение" 
		
		// проверка корректности ввода остатков
		Если (ВводОстатковБУ) Тогда
			
			// проверяем, курс по взаиморасчетам
			Если Валюта <> CW_Настройки.ВалютаРегламентированногоУчета() 
				И Договор.ВзаиморасчетыВУЕ И (КурсВзаиморасчетовБУ = 0)
				И (ПредъявленАкт Или ПредъявленСФ) Тогда
				
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не указан курс взаиморасчётов по бухгалтерскому учету!",,"КурсВалюты", "ЭтаФорма", Отказ);
			КонецЕсли;	
			
		КонецЕсли; 
		
		Если (ВводОстатковОЗ) Тогда
			
			// проверяем, курс по взаиморасчетам
			Если  (СальдоВзаиморасчетовОЗ <> 0)
				И (Валюта <> CW_Настройки.ВалютаРегламентированногоУчета()) 
				И (КурсВзаиморасчетовОЗ = 0) 
				И (ПредъявленСчет)	Тогда
				
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не указан курс ввода остатков для оперативного учета задолженности!",,"КурсВалюты", "ЭтаФорма", Отказ);
							
			КонецЕсли;	
			
		КонецЕсли; 
		
	КонецЕсли; // проверка реквизитов для не помеченных на удаление документов
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	#КонецОбласти 
	
	#Область ЗачетАвансов 
	
	Если (НЕ ДС.УП.ОЗ) Тогда
		
		СпособЗачетаАвансовОЗ=Перечисления.СпособыЗачетаАвансов.НеЗачитывать;
		ЗачетАвансовОЗ.Очистить();
		
	КонецЕсли; 
	
	Если (НЕ Корректировка) Тогда
		
		// заполнение ТЧ "ЗачетАвансаОЗ"
		Если (СпособЗачетаАвансовОЗ = Перечисления.СпособыЗачетаАвансов.Автоматически 
			И ДС.УП.ОЗ
			И РежимЗаписи=РежимЗаписиДокумента.Проведение
			И ПредъявленСчет) Тогда
			
			Если ДатаСчета <> Дата Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("При ведении учета оперативной задолженности и автоматическом зачете авансов (ОУ) дата документа должна совпадать с датой счета",,"Дата", "Объект");
			КонецЕсли; 
			
			ДатаПодбораАвансов = Новый Граница(МоментВремени(),ВидГраницы.Исключая);
			ЗаполнитьТаблицуАвансовОЗ(ДатаПодбораАвансов);
			
		ИначеЕсли (СпособЗачетаАвансовОЗ = Перечисления.СпособыЗачетаАвансов.НеЗачитывать) Тогда 
			ЗачетАвансовОЗ.Очистить();		 
		КонецЕсли; 
		
		// заполнение ТЧ "ЗачетАванса"
		Если СпособЗачетаАвансов = Перечисления.СпособыЗачетаАвансов.Автоматически
			И РежимЗаписи=РежимЗаписиДокумента.Проведение 
			И ПредъявленАкт 
			Тогда
			
			Если (НачалоДня(ДатаАкта) <> НачалоДня(Дата)) Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("При автоматическом зачете авансов (БУ) дата документа должна совпадать с датой акта",,"Дата", "Объект");
			КонецЕсли; 
			
			Если ЗначениеЗаполнено(ВедомыйДокумент) Тогда
				ЗаполнитьТаблицуАвансов(Новый Граница(ВедомыйДокумент.МоментВремени(),ВидГраницы.Исключая));
			Иначе
				ЗаполнитьТаблицуАвансов(Новый Граница(ДатаАкта,ВидГраницы.Исключая));
			КонецЕсли;
			
		ИначеЕсли (СпособЗачетаАвансов = Перечисления.СпособыЗачетаАвансов.НеЗачитывать) Тогда 
			ЗачетАвансов.Очистить();		 
			
		КонецЕсли;	
		
		// заполнение таб.части "Платёжно-расчётные документы с/ф"
		Если ПорядокЗаполненияРасчётноПлатёжныхДокументовСФ = Перечисления.CW_ПорядокЗаполненияРасчётноПлатёжныхДокументовСФ.Автоматически 
			И РежимЗаписи=РежимЗаписиДокумента.Проведение 
			И ПредъявленСФ
		Тогда 
			Ответ = Документы.CW_РасходыПоГрузоперевозке.ПолучитьТаблицу_ПлатёжноРасчётныеДокументы_дляСФ(ЭтотОбъект.Ссылка, ЗачетАвансов);
			Если Ответ.Код = 0 Тогда
				ЭтотОбъект.ПлатёжноРасчётныеДокументы.Загрузить(Ответ.ПлатёжноРасчётныеДокументы);
			Иначе 
				Сообщить(Ответ.ОписаниеОшибки);
			КонецЕсли;
			
		ИначеЕсли ПорядокЗаполненияРасчётноПлатёжныхДокументовСФ = Перечисления.CW_ПорядокЗаполненияРасчётноПлатёжныхДокументовСФ.НеУчитывать Тогда  
			ЭтотОбъект.ПлатёжноРасчётныеДокументы.Очистить();
			
		КонецЕсли;
	КонецЕсли; 
	
	#КонецОбласти 
	
КонецПроцедуры

Функция ПолучитьМассивУслугДокумента(ИсключитьПеревыставление) 
	
	МассивУслуг = Новый Массив;                               
	
	Для Каждого СтрокаУслуг из Услуги Цикл                    
		Если ИсключитьПеревыставление и СтрокаУслуг.ПорядокОтражения = ПредопределенноеЗначение("Перечисление.CW_ПорядокОтраженияЗатрат.Перевыставление") Тогда
			Продолжить;
		КонецЕсли;
		
		Если МассивУслуг.Найти(СтрокаУслуг.Номенклатура) = Неопределено Тогда
			МассивУслуг.Добавить(СтрокаУслуг.Номенклатура);	
		КонецЕсли;
		
	КонецЦикла;      
	
	Возврат МассивУслуг;
	
КонецФункции


Процедура ПриЗаписи(Отказ) Экспорт
	
	// обмен данными
	Если (ОбменДанными.Загрузка) Тогда Возврат; КонецЕсли;
	Если (РучнаяКорректировка) Тогда Возврат; КонецЕсли; 
	
	// не перепроводим при восстановлении последовательности
	ВосстановлениеПоследовательности = _сф.ст_ПолучитьСвойство(ДополнительныеСвойства,"ПроведенВХронологическойПоследовательности");
	
	Если (ВосстановлениеПоследовательности <> Неопределено) Тогда
		Если (ВосстановлениеПоследовательности) Тогда
			
			Возврат;
			
		КонецЕсли; 
	КонецЕсли; 
	
	//Для версии КОРП 
	ВестиУчетПоПодразделениям = ПолучитьФункциональнуюОпцию("ВестиУчетПоПодразделениям");
	//Для версии КОРП 

	// контроль наличия общих параметров
	Если (НЕ ЗаполненыОбщиеПараметры()) Тогда СформироватьОбщиеПараметры(,Ложь); КонецЕсли; 
	
	// определяем, что делать с подчинённым документом
	РежимЗаписи = _сф.ст_ПолучитьСвойство(ДополнительныеСвойства,"РежимЗаписи");
	
	//Подситема.СтатусыДокументов
	ИспользуютсяСтатусыДокументов = ПолучитьФункциональнуюОпцию("CW_ИспользуютсяСтатусыДокументов");
	Если ИспользуютсяСтатусыДокументов И
		Не ЭтотОбъект.ДополнительныеСвойства.Свойство("СтатусДокумента") Тогда
		//В случае если используются статусы документа и проведение не из формы, тов ДС статуса нет
		ДанныеСтатуса = РегистрыСведений.CW_СтатусыДокументов.ПолучитьДанныеСтатусаДокумента(Ссылка);
		ЭтотОбъект.ДополнительныеСвойства.Вставить("СтатусДокумента", ДанныеСтатуса.СтатусДокумента);
	КонецЕсли;

	СтатусДокумента = Неопределено;
	ЭтотОбъект.ДополнительныеСвойства.Свойство("СтатусДокумента", СтатусДокумента);
	
	СтатусДокументаПроводитьПоБухгалтерскомуУчету = CW_СтатусыДокументовСервер.ПолучитьПризнакПроведенияПоБухгалтерскомуУчету(Ссылка, СтатусДокумента);
	//Подситема.СтатусыДокументов

	ВедетсяУчетПриложенийПоДоговорам = ПолучитьФункциональнуюОпцию("CW_ВедетсяУчетПриложенийПоДоговорам");

	СтруктураПараметровБухУчета = Новый Структура;
	СтруктураПараметровБухУчета.Вставить("Договор",					Договор);
	СтруктураПараметровБухУчета.Вставить("ПриложениеКДоговору",		ПриложениеКДоговору);
	СтруктураПараметровБухУчета.Вставить("ВедетсяУчетПриложений",	ВедетсяУчетПриложенийПоДоговорам);
	
	ПараметрыБухгалтерскогоУчета = CW_Финансы.ПолучитьПарметрыВеденияБухгалтерскогоУчета(СтруктураПараметровБухУчета, Дата);
	
	
	ПровестиПоБухгалтерскомуУчету = СтатусДокументаПроводитьПоБухгалтерскомуУчету и ПараметрыБухгалтерскогоУчета.БухгалтерскийУчет;
	
	// ЗАПИСЬ
	Если (РежимЗаписи = РежимЗаписиДокумента.Запись) Тогда
		ПроверитьСтатусВедомых(РежимЗаписи);
	КонецЕсли;
	
	// ОТМЕНА ПРОВЕДЕНИЯ
	Если (РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения) Тогда
		
		Если (НЕ Корректировка) Тогда
			
			// проверяем возможность отмены проведения
			Если (НЕ ПроверитьЗакрытиеГрузоперевозок()) Тогда
				Сообщить("В документе присутствуют закрытие грузоперевозки. Операция отменена.",СтатусСообщения.Важное);
				Отказ = Истина;
				Возврат;
			КонецЕсли; 
		КонецЕсли; 
				
		ПроверитьСтатусВедомых(РежимЗаписи);
		
		// удаляем движения
		Для каждого Набор Из Движения Цикл
			
			Набор.Прочитать();
			Набор.Очистить();
			
		КонецЦикла;
		Движения.Записать();
		
	КонецЕсли;
	
	// ПРОВЕДЕНИЕ
	Если (РежимЗаписи = РежимЗаписиДокумента.Проведение) Тогда
		
		Счета = CW_Конфигурация.ПланСчетов(); 
		
		Если ЗначениеЗаполнено(ПриложениеКДоговору) Тогда
			Если ЗначениеЗаполнено(ПриложениеКДоговору.ДатаЗакрытия) И (КонецДня(ПриложениеКДоговору.ДатаЗакрытия) <= Дата) Тогда
				Отказ = Истина;
				Сообщить(Ссылка);
				Сообщить("Проведение документа позднее даты закрытия приложения к договору с контрагентом невозможно!");
				Возврат;
			КонецЕсли; 
		КонецЕсли; 

		Если ЗначениеЗаполнено(Договор.ДатаЗакрытия) И (КонецДня(Договор.ДатаЗакрытия) <= Дата) Тогда
			Отказ = Истина;
			Сообщить(Ссылка);
			Сообщить("Проведение документа позднее даты закрытия договора с контрагентом невозможно!");
			Возврат;
		КонецЕсли; 
		
		ОчищатьДвижения = Истина;
		// удаляем собственные движения	
		Если (ПредъявленАкт ИЛИ ПредъявленСФ) И ПровестиПоБухгалтерскомуУчету Тогда
			
			Если (НЕ Корректировка) Тогда
				ПроверяемыйДокумент = ВедомыйДокумент;
			Иначе
				ПроверяемыйДокумент = ВедомыйДокументКорректировки;
			КонецЕсли; 
			
			Если (НЕ ПроверяемыйДокумент.РучнаяКорректировка) Тогда
				
				ОчищатьДвижения = Истина;
				
			Иначе 
				
				СтатусПроведенияДоПроведения = _сф.ст_ПолучитьСвойство(ДополнительныеСвойства,"СтатусПроведенияДоПроведения",Ложь);
				Если (НЕ СтатусПроведенияДоПроведения) Тогда
					Сообщить(Ссылка);
					Сообщить("Ведомый документ содержит признак ручной корректировки. Проведение заблокировано.");
					Отказ = Истина;
					Возврат;
				Иначе	
					
					Сообщить("Внимание! У ведомого документа "+Строка(ПроверяемыйДокумент)+" установлен признак ручной корректировки движений!");
					ОчищатьДвижения = Ложь;
					// ничего не делаем
				КонецЕсли; 
				
			КонецЕсли; 
			
		КонецЕсли; 
		
		Если (ОчищатьДвижения) Тогда
			
			Для каждого Набор Из Движения Цикл
				
				Набор.Прочитать();
				Набор.Очистить();
				
			КонецЦикла;
			Движения.Записать();
			
		Иначе
			
			Возврат;
			
		КонецЕсли; 
		
		Если (НЕ Корректировка) Тогда
			
			//проверяем на ввод начальных остатков...
			ДатаНачалаВеденияУчета = CW_Настройки.ПолучитьДатуНачалаВеденияУчета(Организация);
			Если НЕ ДатаНачалаВеденияУчета = Неопределено Тогда
				РежимВводначальныхОстатков = Ложь;		
				Если Дата < ДатаНачалаВеденияУчета Тогда		
					РежимВводначальныхОстатков = Истина;
				Иначе
					РежимВводначальныхОстатков = Ложь;
				КонецЕсли;	
			Иначе
				РежимВводначальныхОстатков = Ложь;	
			КонецЕсли;
			Если РежимВводначальныхОстатков Тогда
				Если Договор.ВзаиморасчетыВУЕ Тогда
					
					ПроверятьКурс = Ложь;
					Для каждого Стр Из Услуги Цикл
						Если (Стр.ПорядокОтражения = Перечисления.CW_ПорядокОтраженияЗатрат.Перевыставление ИЛИ Стр.ПорядокОтражения = Перечисления.CW_ПорядокОтраженияЗатрат.ПеревыставлениеПоСтавкам) И Стр.ВводОстатков Тогда
							ПроверятьКурс = Истина;	
							Прервать;
						КонецЕсли; 
					КонецЦикла;
					
					Если ПроверятьКурс Тогда
						Если КурсВзаиморасчетовБУ = 0 Тогда
							Сообщить("Курс у.е. не заполнен! см.вкладу ""Дополнительно"".");
							Отказ = Истина;
							Возврат;
						КонецЕсли;	
					КонецЕсли; 
					
				КонецЕсли;	
			КонецЕсли; 
			
		КонецЕсли; 
		
		// заполняем ведомые
		Если (НЕ Корректировка) Тогда
			
			Если ПровестиПоБухгалтерскомуУчету Тогда
				
				// ведомый счёт
				Если (ПредъявленСчет И ДС.УП.ФормироватьСчетаПоставщикаНаОплату) Тогда
					
					ВедомыйОбъект = ВедомыйСчет.ПолучитьОбъект();
					ВедомыйОбъект.УстановитьПометкуУдаления(ПометкаУдаления); 
					
					Если Год(ВедомыйОбъект.Дата) <> Год(?(ФормироватьВедомыеДатойДокумента,Дата,ДатаСчета)) Тогда
						ВедомыйОбъект.Номер = "";	
					КонецЕсли;
					
					
					// --- 
					ВедомыйОбъект.Организация 			= Организация;
					ВедомыйОбъект.Дата 					=?(ФормироватьВедомыеДатойДокумента,Дата,ДатаСчета);
					ВедомыйОбъект.Контрагент 			= Контрагент;
					ВедомыйОбъект.ДоговорКонтрагента 	= ПараметрыБухгалтерскогоУчета.УчетныйДоговор;
					ВедомыйОбъект.ВалютаДокумента 		= ПараметрыБухгалтерскогоУчета.УчетныйДоговор.ВалютаВзаиморасчетов; 
					
					ВедомыйОбъект.СуммаВключаетНДС 		= ЦенаСНДС;
					
					СтруктураКурса = CW_Финансы.ПолучитьКурсВалюты(ВедомыйОбъект.ВалютаДокумента, ВедомыйОбъект.Дата);
					ВедомыйОбъект.КурсВзаиморасчетов 		= СтруктураКурса.Курс;
					ВедомыйОбъект.КратностьВзаиморасчетов 	= СтруктураКурса.Кратность;
					
					//Для версии КОРП
					Если ВестиУчетПоПодразделениям Тогда
						ВедомыйОбъект.ПодразделениеОрганизации = ПодразделениеОрганизации;
					КонецЕсли;
					//Для версии КОРП
					
					// --- 
					РасчетныйСчет = ДС.ПД.РасчетныйСчет;
					Если (НЕ ЗначениеЗаполнено(РасчетныйСчет)) Тогда
						ВедомыйОбъект.БанковскийСчетКонтрагента = Неопределено;
					Иначе
						ВедомыйОбъект.БанковскийСчетКонтрагента = РасчетныйСчет;
					КонецЕсли;
					// --- 
					ВедомыйОбъект.НомерВходящегоДокумента = НомерСчета;
					ВедомыйОбъект.ДатаВходящегоДокумента = ДатаСчета;
					// --- 
					ВедомыйОбъект.СуммаДокумента = Услуги.Итог("Всего");
					// --- 
					ЕстьТовары = (Документы.СчетНаОплатуПоставщика.ПустаяСсылка().Метаданные().ТабличныеЧасти.Найти("Товары") <> Неопределено);
					Если (ЕстьТовары) Тогда
						
						ВедомыйОбъект.Товары.Очистить();
						Для каждого СтрокаУслуги Из Услуги Цикл
							
							Нстр = ВедомыйОбъект.Товары.Добавить();
							Нстр.Номенклатура = СтрокаУслуги.Номенклатура;
							Нстр.Содержание = СокрЛП(СтрокаУслуги.Представление);
							Нстр.СтавкаНДС = СтрокаУслуги.СтавкаНДС;
							Нстр.Количество = СтрокаУслуги.Количество;
							
							Если ЦенаСНДС Тогда
								Нстр.Цена = СтрокаУслуги.Цена - СтрокаУслуги.НДС/?(СтрокаУслуги.Количество=0,1,СтрокаУслуги.Количество); 
							Иначе
								Нстр.Цена = СтрокаУслуги.Цена; 
							КонецЕсли; 
							
							Нстр.Сумма = СтрокаУслуги.Сумма;
							Нстр.СуммаНДС = СтрокаУслуги.НДС; 
							
							Если ЦенаСНДС Тогда
								Нстр.Сумма 		= Нстр.Сумма + Нстр.СуммаНДС;
							КонецЕсли;
							
						КонецЦикла; 
						
					Иначе
						ВедомыйОбъект.Услуги.Очистить();
						Для каждого СтрокаУслуги Из Услуги Цикл
							Нстр = ВедомыйОбъект.Услуги.Добавить();
							Нстр.Номенклатура = СтрокаУслуги.Номенклатура;
							Нстр.Содержание = СокрЛП(СтрокаУслуги.Представление);
							Нстр.СтавкаНДС = СтрокаУслуги.СтавкаНДС;
							Нстр.Количество = СтрокаУслуги.Количество;  
							
							Если ЦенаСНДС Тогда
								Нстр.Цена = СтрокаУслуги.Цена - СтрокаУслуги.НДС/?(СтрокаУслуги.Количество=0,1,СтрокаУслуги.Количество); 
							Иначе
								Нстр.Цена = СтрокаУслуги.Цена;  
							КонецЕсли;
						
							Нстр.Сумма = СтрокаУслуги.Сумма;
							Нстр.СуммаНДС = СтрокаУслуги.НДС;  
							
							Если ЦенаСНДС Тогда
								Нстр.Сумма 		= Нстр.Сумма + Нстр.СуммаНДС;
							КонецЕсли;
							
						КонецЦикла; 
					КонецЕсли; 
					
					CW_Документы.ПеренестиПризнакВосстановленияПоследовательности(ЭтотОбъект,ВедомыйОбъект);
					ВедомыйОбъект.ОбменДанными.Загрузка = Ложь;
					ВедомыйОбъект.Записать(РежимЗаписи);
					
					// пропишем срок оплаты, если это предусмотрено настройками типовой БП
					ИспользоватьПланирование = ПолучитьФункциональнуюОпцию("ИспользоватьПланированиеПлатежейПоставщикам");
					Если ИспользоватьПланирование Тогда
						ЗаписьРегистра = РегистрыСведений.CW_СрокиОплатыСчетов.СоздатьМенеджерЗаписи();
						ЗаписьРегистра.Счет = Ссылка;
						ЗаписьРегистра.Прочитать();   
						Если ЗаписьРегистра.Выбран() Тогда 
							СрокиОплатыДокументов.ЗаписатьСрокОплатыДокумента(ВедомыйСчет, ЗаписьРегистра.ДатаОплаты);
						КонецЕсли;
					КонецЕсли;
					
					// Если для целей оперативного учета задолженности документ проводится в режиме ввода остатков,
					// то принудительно пропишем статус ведомого счета (при проведении в обычном режиме статус не прописываем,
					// т.к. он будет определен типовой конфигурацией на момент записи документа)  
					
					
					СтруктураНастроек  = CW_Настройки.ПолучитьНастройкиОперативногоУчета(Организация, Перечисления.CW_ВидыОперативнойЗадолженности.Кредиторская, Дата); 
					
					Если СтруктураНастроек["ВедетсяОперативныйУчет"] Тогда
						РежимВводНачальныхОстатков = СтруктураНастроек["ВводОстатков"];
						Если РежимВводНачальныхОстатков Тогда
							
							// статус оплаты
							СтатусОплаты = Перечисления.СтатусОплатыСчета.НеОплачен;
							Если СальдоВзаиморасчетовОЗ <= 0 Тогда
								СтатусОплаты = Перечисления.СтатусОплатыСчета.Оплачен;
							Иначе
								Если СальдоВзаиморасчетовОЗ < Услуги.Итог("Всего") Тогда
									СтатусОплаты = Перечисления.СтатусОплатыСчета.ОплаченЧастично;
								КонецЕсли; 
							КонецЕсли; 
							
							// статус отгрузки
							СтатусОтгрузки = ?(ПредъявленАкт,Перечисления.СтатусыОтгрузки.Отгружен,Перечисления.СтатусыОтгрузки.НеОтгружен);
							
							МассивДокументов = Новый Массив;
							МассивДокументов.Добавить(ВедомыйОбъект.Ссылка);
							
							// пишем в регистр
							СтатусыДокумента = РегистрыСведений.СтатусыДокументов.НовыеСтатусыДокумента();
							СтатусыДокумента.Статус            		= СтатусОплаты;
							СтатусыДокумента.ДополнительныйСтатус	= СтатусОтгрузки;
							РегистрыСведений.СтатусыДокументов.УстановитьСтатусыДокументов(МассивДокументов, СтатусыДокумента);
						КонецЕсли; // это режим ввода остатков 
					КонецЕсли; // по организации ведется учет оперативной задолженности
					
				// формировать счет не требуется	
				Иначе
					Если (НЕ ВедомыйСчет.Пустая()) Тогда
						
						ПометитьНаУдаление(ВедомыйСчет);
						
					КонецЕсли; 
				КонецЕсли; // требуется формировать счет 
				
				//ведомые акт и счёт-фактура
				Если (ПредъявленАкт ИЛИ ПредъявленСФ) Тогда
					
					ВедомыйОбъект = ВедомыйДокумент.ПолучитьОбъект();  
					
					_сф.ст_УстановитьСвойство(ВедомыйОбъект.ДополнительныеСвойства,"ВедущийДокумент",Ссылка);
					_сф.ст_УстановитьСвойство(ВедомыйОбъект.ДополнительныеСвойства,"ЗависимоеПроведение",Истина);
					
					НоваяДата = ?(ФормироватьВедомыеДатойДокумента,Дата,?(ПредъявленАкт,ДатаАкта,ДатаСФ));
					
					Если Год(ВедомыйОбъект.Дата) <> Год(НоваяДата) Тогда
						ВедомыйОбъект.Номер = "";	
					КонецЕсли;
					
					//ВедомыйОбъект = Документы.ПоступлениеТоваровУслуг.СоздатьДокумент(); // тмп
					ВедомыйОбъект.УстановитьПометкуУдаления(ПометкаУдаления);
					ВедомыйОбъект.Организация = Организация;
					ВедомыйОбъект.Дата = НоваяДата;
					
					ВедомыйОбъект.ЭтоУниверсальныйДокумент = ЭтоУниверсальныйДокумент;  
					
					//Для версии КОРП
					Если ВестиУчетПоПодразделениям Тогда
						ВедомыйОбъект.ПодразделениеОрганизации = ПодразделениеОрганизации;
					КонецЕсли;
					//Для версии КОРП
					
					Если (ПредъявленАкт) Тогда
						НомерВходящего = НомерАкта;
						ДатаВходящего = ДатаАкта;
					Иначе
						НомерВходящего = НомерСФ;
						ДатаВходящего = ДатаСФ;
					КонецЕсли;  
					
					НДСВключатьВСтоимость = Ложь;
					Если ДС.УП.СистемаНалогообложения = Перечисления.СистемыНалогообложения.Упрощенная Тогда
						СтавкаНалогообложенияПриУСН = ПолучитьСтавкуНалогообложенияПриУСН();	
						ИндексСтавкиНДС = НастройкиСистемыНалогообложенияФормы.ИндексСтавкиНДСПоЗначению(СтавкаНалогообложенияПриУСН);	
						НДСВключатьВСтоимость = (ИндексСтавкиНДС < 2);
					КонецЕсли;
					
					ВедомыйОбъект.НомерВходящегоДокумента = НомерВходящего;
					ВедомыйОбъект.ДатаВходящегоДокумента = ДатаВходящего;
					ВедомыйОбъект.ВидОперации = Перечисления.ВидыОперацийПоступлениеТоваровУслуг.ПокупкаКомиссия;
					ВедомыйОбъект.Контрагент = Контрагент;
					ВедомыйОбъект.ДоговорКонтрагента = ПараметрыБухгалтерскогоУчета.УчетныйДоговор;
					ВедомыйОбъект.СуммаВключаетНДС = Ложь;
					ВедомыйОбъект.СчетНаОплатуПоставщика = Документы.CW_РасходыПоГрузоперевозке.ПолучитьСчетНаОплатуПоставщика(Ссылка);
					ВедомыйОбъект.НДСВключенВСтоимость = НДСВключатьВСтоимость;
					//ВедомыйОбъект.НДСНеВыделять = НДСВключатьВСтоимость;  
					ВедомыйОбъект.ВалютаДокумента = ?(ПоказатьРубли, ДС.КО.ВалютаРегламентированногоУчета, Валюта);
					ВедомыйОбъект.Ответственный = Ответственный;
					ВедомыйОбъект.Комментарий = "Сформировано автоматически (CW) документом ""Расходы по грузоперевозке"" №"+Строка(Номер)+" от "+Формат(Дата,"ДФ=dd.MM.yyyy");
					
					Если (Валюта = ДС.КО.ВалютаРегламентированногоУчета) Тогда
						ВедомыйОбъект.КурсВзаиморасчетов = 1;
						ВедомыйОбъект.КратностьВзаиморасчетов = 1;
					Иначе
						
						Если УЕ_ПользовательскийКурс Тогда
							СК = Новый Структура("Курс,Кратность",УЕ_Курс,УЕ_Кратность);
						Иначе
							СК = РегистрыСведений.КурсыВалют.ПолучитьПоследнее(НоваяДата, Новый Структура("Валюта", Валюта));
						КонецЕсли; 
						//Если ДополнительныеСвойства.УП.УчитыватьКурсыВалютАвансовДляБазыНДС
						//	И ЗачетАвансов.Количество()>0
						//Тогда 
						//	СК = ПриведённыйКурсСУчётомВалютныхАвансов(СК);
						//КонецЕсли;
						// --- 
						ВедомыйОбъект.КурсВзаиморасчетов = СК.Курс;
						ВедомыйОбъект.КратностьВзаиморасчетов = СК.Кратность;
					КонецЕсли;	
					
					СчетУчетаСПоставщиком = ДС.УП.СчетРасчетов_Поставщики_Рубли;
					СчетУчетСПоставщикомВВалюте = ДС.УП.СчетРасчетов_Поставщики_Валюта;
					СчетУчетСПоставщикомВУЕ = ДС.УП.СчетРасчетов_Поставщики_УЕ;
					
					Если (Валюта = ДС.КО.ВалютаРегламентированногоУчета) Тогда
						Если СчетУчетаСПоставщиком.Родитель = Счета.РасчетыСПоставщикамиИПодрядчиками Тогда			
							ВедомыйОбъект.СчетУчетаРасчетовСКонтрагентом = СчетУчетаСПоставщиком; // 60.01
							ВедомыйОбъект.СчетУчетаРасчетовПоАвансам = Счета.РасчетыПоАвансамВыданным; // 60.02
						Иначе
							ВедомыйОбъект.СчетУчетаРасчетовСКонтрагентом = СчетУчетаСПоставщиком; 
							ВедомыйОбъект.СчетУчетаРасчетовПоАвансам = СчетУчетаСПоставщиком;
						КонецЕсли;
					Иначе
						Если Договор.ВзаиморасчетыВУЕ Тогда
							Если СчетУчетаСПоставщиком.Родитель = Счета.РасчетыСПоставщикамиИПодрядчиками Тогда			
								ВедомыйОбъект.СчетУчетаРасчетовСКонтрагентом = Счета.РасчетыСПоставщикамиУЕ; // 62.31
								ВедомыйОбъект.СчетУчетаРасчетовПоАвансам = Счета.РасчетыПоАвансамВыданнымУЕ; // 62.32
							Иначе
								ВедомыйОбъект.СчетУчетаРасчетовСКонтрагентом = СчетУчетСПоставщикомВУЕ; 
								ВедомыйОбъект.СчетУчетаРасчетовПоАвансам = СчетУчетСПоставщикомВУЕ;
							КонецЕсли;
						ИначеЕсли СчетУчетСПоставщикомВВалюте.Родитель = Счета.РасчетыСПоставщикамиИПодрядчиками Тогда			
							ВедомыйОбъект.СчетУчетаРасчетовСКонтрагентом = СчетУчетСПоставщикомВВалюте; // 
							ВедомыйОбъект.СчетУчетаРасчетовПоАвансам = Счета.РасчетыПоАвансамВыданнымВал; // 60.02
						Иначе
							ВедомыйОбъект.СчетУчетаРасчетовСКонтрагентом = СчетУчетСПоставщикомВВалюте; 
							ВедомыйОбъект.СчетУчетаРасчетовПоАвансам = СчетУчетСПоставщикомВВалюте;
						КонецЕсли;
					КонецЕсли;	
					
					// способ зачета авансов переопределяется в подписке
					ВедомыйОбъект.СпособЗачетаАвансов = Перечисления.СпособыЗачетаАвансов.НеЗачитывать;
					ОсновноеПодразделение = ДС.УП.ОсновноеПодразделение;
					
					// определим, требуется ли заполнение колонки для УСН
					ТребуетсяЗаполнениеОтраженияВУСН = (ДС.УП.СистемаНалогообложения = Перечисления.СистемыНалогообложения.Упрощенная 
														или ДС.УП.СистемаНалогообложения = Перечисления.СистемыНалогообложения.АУСН)
														И ДС.УП.ОбъектНалогообложенияУСН = Перечисления.ОбъектыНалогообложенияПоУСН.ДоходыМинусРасходы;
														
					ЕстьЗатраты = Ложь;
					ЕстьПеревыставление = Ложь;
					ГруппировкаЗатратПоПодразделениям = ДС.УП.ГруппировкаЗатратПоПодразделениям;
					
					Если (ПараметрыБухгалтерскогоУчета.УчетныйДоговор.УчетАгентскогоНДС) Тогда
						ВедомыйОбъект.СуммаВключаетНДС = Ложь;
					КонецЕсли; 
					
					ВедомыйОбъект.Услуги.Очистить();
					ВедомыйОбъект.АгентскиеУслуги.Очистить();
					
					Для каждого СтрТЧ Из Услуги Цикл
						
						// получаем вид деятельности статьи затрат:
						ВидДеятельностиНУ = СтрТЧ.СтатьяЗатрат.ВидДеятельностиДляНалоговогоУчетаЗатрат;
						
						// затраты
						Если СтрТЧ.ПорядокОтражения = Перечисления.CW_ПорядокОтраженияЗатрат.Затраты Тогда 
							
							ЕстьЗатраты = Истина;
							
							Нстр = ВедомыйОбъект.Услуги.Добавить();
							Нстр.Номенклатура 	= СтрТЧ.Номенклатура;
							Нстр.Содержание 	= СокрЛП(СтрТЧ.Представление);
							Нстр.Количество 	= СтрТЧ.Количество;  
							
							Если ЦенаСНДС Тогда 
								Если ПоказатьРубли Тогда
									Нстр.Цена = СтрТЧ.ЦенаРег - СтрТЧ.НДСРег/?(СтрТЧ.Количество=0,1,СтрТЧ.Количество); 
								Иначе
									Нстр.Цена = СтрТЧ.Цена - СтрТЧ.НДС/?(СтрТЧ.Количество=0,1,СтрТЧ.Количество); 
								Конецесли;
							Иначе
								Нстр.Цена = ?(ПоказатьРубли, СтрТЧ.ЦенаРег, СтрТЧ.Цена);
							КонецЕсли;
							
							Нстр.СуммаНДС = ?(ПоказатьРубли, СтрТЧ.НДСРег, СтрТЧ.НДС);
							
							Если (НЕ ПараметрыБухгалтерскогоУчета.УчетныйДоговор.УчетАгентскогоНДС) Тогда
								Нстр.СтавкаНДС 	= СтрТЧ.СтавкаНДС;
								Нстр.Сумма 		=  ?(ПоказатьРубли, СтрТЧ.СуммаРег, СтрТЧ.Сумма);
							Иначе
								
								// для собственных накручиваем 18% (20%) сверху
								Нстр.Сумма 		= ?(ПоказатьРубли, СтрТЧ.ВсегоРег, СтрТЧ.Всего);
								
								Нстр.СтавкаНДС 	= CW_БухгалтерияЭкспедитораДляРоссииСервер.СтавкаНДСПоВидуСтавки(Перечисления.ВидыСтавокНДС.Общая, ВедомыйОбъект.дата);
								СтавкуНДСЧислом = CW_Финансы.ПолучитьКоэффициентСтавкиНДС(Перечисления.ВидыСтавокНДС.Общая, ВедомыйОбъект.дата);
								Нстр.СуммаНДС 	= Нстр.Сумма * СтавкуНДСЧислом;
								
								Нстр.Цена 		= Нстр.Сумма/Нстр.Количество;
							КонецЕсли;
							
							Нстр.СчетЗатрат 	= Счета.ОсновноеПроизводство; // 20.01
							Нстр.СчетЗатратНУ 	= Счета.ОсновноеПроизводство; // 20.01
							Нстр.Субконто1 		= СтрТЧ.Номенклатура.НоменклатурнаяГруппа;
							Нстр.Субконто2 		= СтрТЧ.СтатьяЗатрат;
							Нстр.СубконтоНУ1 	= СтрТЧ.Номенклатура.НоменклатурнаяГруппа;
							Нстр.СубконтоНУ2 	= СтрТЧ.СтатьяЗатрат;
							Нстр.СчетУчетаНДС 	= Счета.НДСпоПриобретеннымУслугам; // 19.04
							
							
							//AFR-250327 от 25.07.2025 16:37:23
							Если ВариантыПриложений.ЭтоВерсияКОРП() 
								И Не ДС.УП.ГруппировкаЗатратПоПодразделениям Тогда
								Нстр.ПодразделениеЗатрат = ?(ЗначениеЗаполнено(ПодразделениеОрганизации),ПодразделениеОрганизации,ДС.УП.ОсновноеПодразделение);	
							ИначеЕсли ВариантыПриложений.ЭтоВерсияПРОФ()  
								И Не ДС.УП.ГруппировкаЗатратПоПодразделениям Тогда
								Нстр.ПодразделениеЗатрат = ДС.УП.ОсновноеПодразделение;  
							Иначе
								Нстр.ПодразделениеЗатрат = СтрТЧ.Подразделение;	
							КонецЕсли;
