Процедура ЗаполнитьАвансы(ДатаПодбораАвансов,БУ,ОЗ)
	// --- 
	
	Если (БУ) Тогда
		
		ТЧ = ЗачетАвансов;
		
	Иначе
		
		ТЧ = ЗачетАвансовОЗ;
		
	КонецЕсли; 
	
	ДС = ДополнительныеСвойства;
	Счета = CW_Конфигурация.ПланСчетов();
	// --- 
	ТЧ.Очистить();
	// --- 	
	УслугиПоПорядкуОтражения = Услуги.Выгрузить();
	УслугиПоПорядкуОтражения.Свернуть("ПорядокОтражения", "Всего");
	// --- 
	// определяем счета авансов
	Если (Валюта = ДС.КО.ВалютаРегламентированногоУчета) Тогда
		
		СчетРасчетов = ДС.УП.СчетРасчетов_Поставщики_Рубли;
		Если СчетРасчетов = Счета.РасчетыСПоставщиками Тогда
			
			СчетАвансовПоСобственным = Счета.РасчетыПоАвансамВыданным;						
			СчетАвансовПоВозмещаемым = Счета.РасчетыПоАвансамВыданным;
			
		КонецЕсли; 
		
	Иначе
		
		// Валюта
		Если (НЕ Договор.ВзаиморасчетыВУЕ) Тогда
			СчетРасчетов = ДС.УП.СчетРасчетов_Поставщики_Валюта;
			Если СчетРасчетов = Счета.РасчетыСПоставщикамиВал Тогда
				СчетАвансовПоСобственным = Счета.РасчетыПоАвансамВыданнымВал;						
				СчетАвансовПоВозмещаемым = Счета.РасчетыПоАвансамВыданнымВал;
			КонецЕсли;
		КонецЕсли;
		
		// УЕ
		Если (Договор.ВзаиморасчетыВУЕ) Тогда
			СчетРасчетов = ДС.УП.СчетРасчетов_Поставщики_УЕ;
			Если СчетРасчетов = Счета.РасчетыСПоставщикамиУЕ Тогда
				СчетАвансовПоСобственным = Счета.РасчетыПоАвансамВыданнымУЕ;						
				СчетАвансовПоВозмещаемым = Счета.РасчетыПоАвансамВыданнымУЕ;
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли; 
	
	Если (Истина) Тогда
		
		ПараметрыТА = Новый Структура("Дата,Договор,ПриложениеКДоговору,ОЗ,РаздельныйУчетЗаполженности,Акт,ПереплатаКакАванс");
		// --- 
		ПараметрыТА.Дата = ДатаПодбораАвансов;
		ПараметрыТА.Договор = Договор;
		ПараметрыТА.ОЗ = ДС.УП.ОЗ;
		ПараметрыТА.Акт = Ссылка;
		
		ПараметрыТА.РаздельныйУчетЗаполженности = ДС.УП.РаздельныйУчетОперативнойИБухгалтерскойЗадолженности;
		ПараметрыТА.ПереплатаКакАванс 			= ДС.УП.УчитыватьПереплатыПоДокументамКакАванс;
		
		//Подсистема  УчетПриложенийДоговоров
		ПараметрыТА.ПриложениеКДоговору = ПриложениеКДоговору;
		//Подсистема  УчетПриложенийДоговоров
		
		// --- 
		ТЗ_Услуги = Услуги.Выгрузить();
		Если (ПараметрыТА.ОЗ) Тогда
			Если (НЕ СписокСчетов) Тогда
				Если (ЗначениеЗаполнено(Счет)) Тогда
					ТЗ_Услуги.ЗаполнитьЗначения(Счет,"Счет");
				Иначе
					ТЗ_Услуги.ЗаполнитьЗначения(Ссылка,"Счет");
				КонецЕсли; 
			КонецЕсли; 
		КонецЕсли; 
		Если (БУ) Тогда
			ТаблицаАвансов = CW_Финансы.ТаблицаАвансов(ПараметрыТА,ТЗ_Услуги,ТЧ.Выгрузить(),ЗачетАвансовОЗ.Выгрузить());	
		ИначеЕсли (ОЗ) Тогда 
			ТаблицаАвансов = CW_Финансы.ТаблицаАвансовДляОЗ(ПараметрыТА,ТЗ_Услуги,ТЧ.Выгрузить());	
		КонецЕсли; 
		
		ТолькоПоПлатежкамСчетов = ПараметрыТА.ОЗ и НЕ ПараметрыТА.РаздельныйУчетЗаполженности;
		//ДС.ПД.АвтоматическиЗачитыватьТолькоПлатежкиПоСчету;
		
		// --- 
		СуммаАванса = _сф.Итог(ТаблицаАвансов,"Аванс");
		СуммаРаспределения = _сф.Итог(УслугиПоПорядкуОтражения,"Всего");
		ОстатокРаспределения = Мин(СуммаРаспределения,СуммаАванса);
		ОстаткиЗачетаПоАктированию = Новый СписокЗначений;
		Для каждого Стр Из ТаблицаАвансов Цикл
			
			Если ОстатокРаспределения <= 0 Тогда
				Прервать; 
			КонецЕсли;
			
			Если (БУ И ТолькоПоПлатежкамСчетов И Стр.ПризнакОплатыСчетовДокумента <> Истина) Тогда
				Продолжить;
			КонецЕсли; 
			
			Нстр = ТЧ.Добавить();
			// --- 
			Нстр.ДокументАванса = Стр.ДокументАванса;
			Нстр.ДокументОплаты = Стр.ДокументОплаты;
			Нстр.СчетАванса = Стр.СчетАванса;
			Нстр.СчетЗадолженности = Стр.СчетЗадолженности;
			// --- 
			Если (БУ) Тогда
				Нстр.Счет = Стр.Счет;
				Если (ТолькоПоПлатежкамСчетов) Тогда
					ОстатокЗадолженности = ОстаткиЗачетаПоАктированию.НайтиПоЗначению(Стр.Счет);
					Если (ОстатокЗадолженности = Неопределено) Тогда
						ОстатокЗадолженности = ОстаткиЗачетаПоАктированию.Добавить(Стр.Счет, Формат(Стр.Задолженность,"ЧН=; ЧГ="));
					КонецЕсли;
					НезачтенноеАктированноеСальдо = Число(ОстатокЗадолженности.Представление);
					Нстр.СуммаЗачета = Мин(ОстатокРаспределения,Стр.Аванс,НезачтенноеАктированноеСальдо);
					ОстатокЗадолженности.Представление = Формат(НезачтенноеАктированноеСальдо-Нстр.СуммаЗачета,"ЧН=; ЧГ=");
				Иначе
					Нстр.СуммаЗачета = Мин(ОстатокРаспределения,Стр.Аванс);
				КонецЕсли; 
			Иначе
				Нстр.СуммаЗачета = Мин(ОстатокРаспределения,Стр.Аванс);
			КонецЕсли; 
			// --- 
			_сф.Декремент(ОстатокРаспределения,Нстр.СуммаЗачета);
			Если (Нстр.СуммаЗачета = 0) Тогда
				ТЧ.Удалить(Нстр);
			КонецЕсли; 
			
		КонецЦикла; 
		
	КонецЕсли; 
	
	// --- 
	
	// сформируем текстовое представление платежки в ТЧ зачета авансов
	// ---------------------------------------------------------------------------- 
	Для Каждого Стр Из ТЧ Цикл
		
		Попытка
			
			Если (БУ) Тогда
				
				Если НЕ Стр.ДокументАванса.НомерВходящегоДокумента = "" Тогда
					ВхНомер = Строка(Стр.ДокументАванса.НомерВходящегоДокумента);
				Иначе
					ВхНомер = "";
				КонецЕсли;	
				
				Если НЕ Стр.ДокументАванса.ДатаВходящегоДокумента = Дата("00010101") Тогда
					ВхДата = Строка(Формат(Стр.ДокументАванса.ДатаВходящегоДокумента,"ДФ=dd.MM.yyyy"));
				Иначе
					ВхДата = "";
				КонецЕсли;
				
				Если ВхНомер = "" ИЛИ ВхДата = "" Тогда
					Стр.ПредставлениеДокументаАванса = "Не задан!" ;
				Иначе
					Стр.ПредставлениеДокументаАванса = "№" + ВхНомер + " от " + ВхДата;
				КонецЕсли;	 
				
			ИначеЕсли (ОЗ) Тогда 
				
				Стр.ПредставлениеДокументаАванса = Стр.ДокументОплаты.ПредставлениеДокумента;
				
			КонецЕсли; 
			
		Исключение
			
			Стр.ПредставлениеДокументаАванса = "№" + Строка(Стр.ДокументАванса.Номер) + " от " + Строка(Стр.ДокументАванса.Дата);
			
		КонецПопытки	
		
	КонецЦикла;	
	
	
	// --- 
КонецПроцедуры

Процедура СформироватьПредставлениеДокумента()
	
	мПредставления = Новый Массив;
	Если ПредъявленСчет Тогда 
		ПредставлениеСчета 	= "Счет №";
		Если Корректировка Тогда
			ПредставлениеСчета 	= "Кор.счет №";
		КонецЕсли;
		
		ПредставлениеНомераСчета = НомерСчета;	   
		ПредставлениеДатыСчета 	 = Формат(ДатаСчета, "ДФ=dd.MM.yyyy");
		
		мПредставления.Добавить(ПредставлениеСчета + ПредставлениеНомераСчета+" от "+ПредставлениеДатыСчета);
	КонецЕсли;    
	
	ЭтоУПД = ПредъявленАкт и ЭтоУниверсальныйДокумент;
	
	Если НЕ ЭтоУПД Тогда
		Если ПредъявленАкт Тогда 
			ПредставлениеАкта 	= "Акт №";
			Если Корректировка Тогда
				ПредставлениеАкта 	= "Кор.акт №";
			КонецЕсли; 
			
			ПредставлениеНомераАкта = НомерАкта;	   
			ПредставлениеДатыАкта 	= Формат(ДатаАкта, "ДФ=dd.MM.yyyy");			
			
			мПредставления.Добавить(ПредставлениеАкта + ПредставлениеНомераАкта+" от "+ПредставлениеДатыАкта); 
		КонецЕсли;    
		
		Если ПредъявленСФ Тогда 
			
			ПредставлениеСчетаФактуры 	= "С/ф №";
			Если Корректировка Тогда
				ПредставлениеСчетаФактуры 	= "Кор.с/ф №";
			КонецЕсли; 
			
			ПредставлениеНомераСчетаФактуры 		= НомерСФ;	   
			ПредставлениеДатыСчетаФактуры 			= Формат(ДатаСФ, "ДФ=dd.MM.yyyy");			
			
			ПредставлениеИсправленияСчетаФактуры 	= "";
			Если ЗначениеЗаполнено(НомерИсправления) 
				И ВидОперацииКорректировки = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсправленияПоступленияРеализации.ИсправлениеОшибки") Тогда
				ПредставлениеИсправленияСчетаФактуры  =  " (испр. "+Формат(НомерИсправления, "ЧГ=0")+")";
			КонецЕсли;    
	
			мПредставления.Добавить(ПредставлениеСчетаФактуры + ПредставлениеНомераСчетаФактуры + ПредставлениеИсправленияСчетаФактуры + " от "+ПредставлениеДатыСчетаФактуры); 

		КонецЕсли;          
	КонецЕсли;   
	
	Если ЭтоУПД Тогда 
		
		ВидУПД = "УПД";
		Если Корректировка и ВидОперацииКорректировки = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсправленияПоступленияРеализации.СогласованноеИзменение") Тогда
			ВидУПД = "УКД";	
		КонецЕсли;
		
		ПредставлениеИсправленияУПД = "";
		Если ПредъявленСФ Тогда  
			СтатусУПД 				= "(1)";
			ПредставлениеНомераУПД	= " №"+ НомерСФ;
			ПредставлениеДатыУПД 	= ?(ДатаСФ = Дата(1,1,1), "<...>",	Формат(ДатаСФ,"ДФ=dd.MM.yyyy"));
			
			Если ЗначениеЗаполнено(НомерИсправления) 
				И ВидОперацииКорректировки = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсправленияПоступленияРеализации.ИсправлениеОшибки") Тогда
				ПредставлениеИсправленияУПД  =  " (испр. "+Формат(НомерИсправления, "ЧГ=0")+")";
			КонецЕсли;  
			
		Иначе
			СтатусУПД 				= "(2)";
			ПредставлениеНомераУПД	= " №"+ НомерАкта;
			ПредставлениеДатыУПД 	= ?(ДатаАкта = Дата(1,1,1), "<...>", Формат(ДатаАкта,"ДФ=dd.MM.yyyy"));
		КонецЕсли;  
		
		ПредставлениеУПД = ВидУПД + СтатусУПД + ПредставлениеНомераУПД + ПредставлениеИсправленияУПД + " от "+ ПредставлениеДатыУПД;
		
		мПредставления.Добавить(ПредставлениеУПД);
		
	КонецЕсли;
	
	Если мПредставления.Количество() = 0 Тогда 
		мПредставления.Добавить("<"+ЭтотОбъект+">");
	КонецЕсли; 
	
	ПредставлениеДокумента = СтрСоединить(мПредставления,"; ");
	
КонецПроцедуры

