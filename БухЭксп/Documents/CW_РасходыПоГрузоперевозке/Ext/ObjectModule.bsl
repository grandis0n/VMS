							КонецЕсли; 
							
						КонецЕсли; 
						
						НовыйСФ.КодСпособаПолучения = КодСпособаПолученияСФ;
						НовыйСФ.ОбменДанными.Загрузка = Истина;
						
						CW_Документы.ПеренестиПризнакВосстановленияПоследовательности(ЭтотОбъект,НовыйСФ);
						Отказ = CW_Документы.ПроверкаНомера(НовыйСФ, РежимЗаписиДокумента.Запись, ЭтотОбъект,Ложь);
						
						Если Отказ Тогда 
							Возврат; 
						КонецЕсли;
						
						// прописываем ссылку на счет-фактуру в ведущий документ
						ВедомыйСчетФактура = НовыйСФ.Ссылка;
						
					Иначе
						Если (НЕ ВедомыйСчетФактура.Пустая()) Тогда
							ВедомыйСФ = ВедомыйСчетФактура.ПолучитьОбъект();
