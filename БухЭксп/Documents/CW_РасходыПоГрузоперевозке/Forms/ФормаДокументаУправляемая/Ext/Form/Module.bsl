&НаСервере
Процедура ПересчитатьСтрокуРубНаСерере(ИдентификаторСтроки, ИмяПоля) 
	
	ТекущаяСтрока 	= Объект.Услуги.НайтиПоИдентификатору(ИдентификаторСтроки); 
	СтавкаНДС 		= CW_Финансы.ПолучитьСтавкуНДС(ТекущаяСтрока.СтавкаНДС);
	
	Если ИмяПоля = "ЦенаРег" Тогда        
		
		Если Объект.ЦенаСНДС Тогда
			НДСВЦене 				= CW_Финансы.РассчитатьСуммуНДС(ТекущаяСтрока.ЦенаРег, Истина, Объект.ЦенаСНДС, СтавкаНДС); 
			ТекущаяСтрока.СуммаРег 	= ТекущаяСтрока.Количество * (ТекущаяСтрока.ЦенаРег - НДСВЦене); 
		Иначе
			ТекущаяСтрока.СуммаРег 	= ТекущаяСтрока.Количество * ТекущаяСтрока.ЦенаРег; 
		КонецЕсли;
		
		ТекущаяСтрока.НДСРег 	= CW_Финансы.РассчитатьСуммуНДС(ТекущаяСтрока.СуммаРег, Истина, Ложь, СтавкаНДС);
		ТекущаяСтрока.ВсегоРег 	= ТекущаяСтрока.СуммаРег + ТекущаяСтрока.НДСРег;
		
	КонецЕсли;
	
	Если ИмяПоля = "СуммаРег" Тогда      
		ТекущаяСтрока.НДСРег 	= CW_Финансы.РассчитатьСуммуНДС(ТекущаяСтрока.СуммаРег, Истина, ложь, СтавкаНДС);
		
		Если Объект.ЦенаСНДС Тогда  
			ТекущаяСтрока.ВсегоРег 	= ТекущаяСтрока.СуммаРег + ТекущаяСтрока.НДСРег;
			ТекущаяСтрока.ЦенаРег 	= ?(ТекущаяСтрока.Количество = 0, 0, ТекущаяСтрока.ВсегоРег / ТекущаяСтрока.Количество);
		Иначе
			ТекущаяСтрока.ЦенаРег 	= ?(ТекущаяСтрока.Количество = 0, 0, ТекущаяСтрока.СуммаРег / ТекущаяСтрока.Количество);
			ТекущаяСтрока.ВсегоРег 	= ТекущаяСтрока.СуммаРег + ТекущаяСтрока.НДСРег;
		КонецЕсли;
		
	КонецЕсли;  
	
	Если ИмяПоля = "НДСРег" Тогда   
		ТекущаяСтрока.СуммаРег 	= ТекущаяСтрока.ВсегоРег - ТекущаяСтрока.НДСРег;
		Если Объект.ЦенаСНДС Тогда  
			ТекущаяСтрока.ЦенаРег 	= ?(ТекущаяСтрока.Количество = 0, 0, ТекущаяСтрока.ВсегоРег / ТекущаяСтрока.Количество);
		Иначе
			ТекущаяСтрока.ЦенаРег 	= ?(ТекущаяСтрока.Количество = 0, 0, ТекущаяСтрока.СуммаРег / ТекущаяСтрока.Количество);
		КонецЕсли;
	КонецЕсли;
	
	Если ИмяПоля = "ВсегоРег" Тогда 
		ТекущаяСтрока.НДСРег 	= CW_Финансы.РассчитатьСуммуНДС(ТекущаяСтрока.ВсегоРег, Истина, Истина, СтавкаНДС);
		ТекущаяСтрока.СуммаРег 	= ТекущаяСтрока.ВсегоРег - ТекущаяСтрока.НДСРег; 
		
		Если Объект.ЦенаСНДС Тогда  
			ТекущаяСтрока.ЦенаРег 	= ?(ТекущаяСтрока.Количество = 0, 0, ТекущаяСтрока.ВсегоРег / ТекущаяСтрока.Количество);
		Иначе
			ТекущаяСтрока.ЦенаРег 	= ?(ТекущаяСтрока.Количество = 0, 0, ТекущаяСтрока.СуммаРег / ТекущаяСтрока.Количество);
		КонецЕсли;
	КонецЕсли;
	
	
КонецПроцедуры 

//Взаиморасчеты по документу
&НаКлиенте
Процедура Команда_ВзаиморасчетыПоДокументу(Команда)
	
	Если Объект.Ссылка.Пустая() Тогда   
		Возврат;
	КонецЕсли;   
	
	ВариантАналитикиКорректировки = ПолучитьЗначениеУчетнойПолитики();
	
	ДокументОтчета = ПолучитьДокументОтчета(Объект.Ссылка, ВариантАналитикиКорректировки);
	Если ДокументОтчета = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	CW_ВзаиморасчетыПоДокументуКлиент.ОткрытьФормуОтчетаВзаиморасчетыПоДокументу(ЭтаФорма, ДокументОтчета, "КРЕДИТОРСКАЯ");
	
КонецПроцедуры  

&НаСервере
Функция ПолучитьДокументОтчета(ОбъектСсылка, ВариантАналитикиКорректировки) 
	
	Если Не ОбъектСсылка.Корректировка Тогда
		Возврат ОбъектСсылка;
	КонецЕсли;     
	
	Если ВариантАналитикиКорректировки = 1 Тогда
		Возврат ОбъектСсылка;
	КонецЕсли;
	                                       
	Если Объект.КорректируемыйДокумент.Корректировка Тогда
		Возврат ПолучитьДокументОтчета(Объект.КорректируемыйДокумент, ВариантАналитикиКорректировки); 
	КонецЕсли;
	
	Возврат  Объект.КорректируемыйДокумент;
	
КонецФункции  

&НаСервере
Функция ПолучитьЗначениеУчетнойПолитики() 
	
	//корректируемый документ(0), документ корректировки(1)
	
	Запрос = новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	CW_УчетнаяПолитикаСрезПоследних.АналитикаКорректировкиОперативнойЗадолженности КАК АналитикаКорректировки
	               |ИЗ
	               |	РегистрСведений.CW_УчетнаяПолитика.СрезПоследних(&ДатаСреза, Организация = &Организация) КАК CW_УчетнаяПолитикаСрезПоследних"; 
	
	Запрос.УстановитьПараметр("ДатаСреза", Объект.Дата);
	Запрос.УстановитьПараметр("Организация", Объект.Организация); 
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.АналитикаКорректировки;	
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции
