// --- 

&НаКлиенте
Процедура Услуги_ГрупповоеРедактирование(Команда)
	
	Если Объект.Корректировка Тогда
		ТаблицаФормы = Элементы.УслугиКорректировка;
	Иначе
		ТаблицаФормы = Элементы.Услуги;
	КонецЕсли;
	
	// если нет выделенных строк
	Если ТаблицаФормы.ВыделенныеСтроки.Количество() = 0 Тогда
		ПоказатьПредупреждение(,"Для групповой обработки необходимо выделить строки!",10,"Предупреждение");
		Возврат;
	КонецЕсли; 
	
	// передадим имя реквизита (колонки) на котором установлен курсор и его значение
	#Область ОбластьТекущаяКолонка
	
	// Получаем имя реквизта по его пути к данным
	ИмяРеквизитаТабличнойЧасти = ПолучитьИмяРеквизитаТабличнойЧасти(ТаблицаФормы.ТекущийЭлемент.Имя);
	
	Если ИмяРеквизитаТабличнойЧасти = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ИспользуетсяОгранчиениеУслуг = ПолучитьОграничениеУслугНоменклатурыПоТабличнойЧасти();	
	
	// параметры для открываемой формы
	ПФ = Новый Структура();
	ПФ.Вставить("Организация", 				Объект.Организация);
	ПФ.Вставить("Строк", 					ТаблицаФормы.ВыделенныеСтроки.Количество());
	ПФ.Вставить("Док", 						"Расходы");
	ПФ.Вставить("ПоказатьСпособУчетаНДС", 	ПоказатьСпособУчетаНДС);
	ПФ.Вставить("ПоказатьПодразделение", 	ПоказатьПодразделение); 
	
	ПФ.Вставить("ИспользуетсяОгранчиениеУслуг", ИспользуетсяОгранчиениеУслуг);
	ПФ.Вставить("АдресУслугПоДоговору", 		АдресУслугПоДоговору);

	// если реквизит "Покупатель" или "ДоговорПокупателя",
	// то в процедуру передаем как "Покупатель"
	Если ИмяРеквизитаТабличнойЧасти = "Покупатель" или ИмяРеквизитаТабличнойЧасти = "ДоговорПокупателя" 
		
		//Подсистема.УчетПриложенийДоговоров
		или ИмяРеквизитаТабличнойЧасти = "ПриложениеКДоговору"
		//Подсистема.УчетПриложенийДоговоров
		
		Тогда
		
		ПФ.Вставить("ТекущийРеквизит", "Покупатель");
		ПФ.Вставить("ТекущееЗначение", ТаблицаФормы.ТекущиеДанные["Покупатель"]);
		ПФ.Вставить("ТекущееЗначениеДополнительное",ТаблицаФормы.ТекущиеДанные["ДоговорПокупателя"]);
		
		//Подсистема.УчетПриложенийДоговоров
		ПФ.Вставить("ТекущееЗначениеПриложение",ТаблицаФормы.ТекущиеДанные["ПриложениеКДоговору"]);
		//Подсистема.УчетПриложенийДоговоров
		
	Иначе
		ПФ.Вставить("ТекущийРеквизит",ИмяРеквизитаТабличнойЧасти);
		ПФ.Вставить("ТекущееЗначение",ТаблицаФормы.ТекущиеДанные[ИмяРеквизитаТабличнойЧасти]);
		ПФ.Вставить("ТекущееЗначениеДополнительное",Неопределено);
	КонецЕсли; 
	#КонецОбласти 
	
	ПФ.Вставить("ЦенаСНДС", Объект.ЦенаСНДС);

	// открываем диалог для выбора действия	
	ПОВ = Новый ОписаниеОповещения("ОбработатьГрупповоеРедактирование", ЭтотОбъект);
	ОткрытьФорму("ОбщаяФорма.CW_ФормаГрупповогоРедактированияТЧ", ПФ, Этаформа,,,, ПОВ, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаСервере
Функция ПолучитьОграничениеУслугНоменклатурыПоТабличнойЧасти()
	
	ОтборСтрок = Новый Структура;
	ОтборСтрок.Вставить("ПорядокОтражения",ПредопределенноеЗначение("Перечисление.CW_ПорядокОтраженияЗатрат.Затраты")) ;
	мСтроки = Объект.Услуги.НайтиСтроки(ОтборСтрок);
	
	ИспользуетсяОгранчиениеУслуг = ОграничиватьУслугиПоДоговорам;
	Если НеОграничиватьУслугиПоПеревыставлению и мСтроки.Количество() = 0 Тогда
		ИспользуетсяОгранчиениеУслуг = Ложь;	
	КонецЕсли;
	
	Возврат ИспользуетсяОгранчиениеУслуг;
	
КонецФункции


&НаСервере
Функция ПолучитьИмяРеквизитаТабличнойЧасти(ИмяРеквизитаФормы)
	
	ЭлементФрмы = Элементы.Найти(ИмяРеквизитаФормы);
	мПутьРеквизита = СтрРазделить(ЭлементФрмы.ПутьКДанным,".", Ложь);
	
	//Всегда реквизит табличной части, имя реквизита всегда по индексу 2
	Если мПутьРеквизита.Количество() <> 3 Тогда
		//Это не реквизит табичной части
		Возврат Неопределено;
	КонецЕсли;
	
	ИмяРеквизита = мПутьРеквизита[2];
	
	МассивЗапрещенныхРеквизитов = ПолучитьМассивЗапрещенныхРеквизитов();
	Если МассивЗапрещенныхРеквизитов.Найти(ИмяРеквизита) <> Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ЕстьРеквизитОбъекта	= ОбщегоНазначения.ЕстьРеквизитОбъекта(ИмяРеквизита, Метаданные.Документы.CW_РасходыПоГрузоперевозке.ТабличныеЧасти.Услуги);
	Если ЕстьРеквизитОбъекта Тогда
		Возврат ИмяРеквизита;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

&НаСервере
Функция ПолучитьМассивЗапрещенныхРеквизитов()
	
	Массив = Новый Массив;
	
	Массив.Добавить("Представление_ДоКорректировки");
	Массив.Добавить("Количество_ДоКорректировки");
	Массив.Добавить("Цена_ДоКорректировки");
	Массив.Добавить("Сумма_ДоКорректировки");
	Массив.Добавить("СтавкаНДС_ДоКорректировки");
	Массив.Добавить("НДС_ДоКорректировки");
	Массив.Добавить("Всего_ДоКорректировки");
	
	Возврат Массив;
	
КонецФункции


&НаКлиенте
Процедура ОбработатьГрупповоеРедактирование(Ответ, ДопПар) Экспорт
	
	Если Ответ = Неопределено Тогда
		Возврат;
	ИначеЕсли НЕ ЗначениеЗаполнено(Ответ.Реквизит) Тогда
		Возврат;		
	Иначе	
		Реквизит = Ответ.Реквизит;
	КонецЕсли;
	
	Если Объект.Корректировка Тогда
		ТаблицаФормы = Элементы.УслугиКорректировка;
	Иначе
		ТаблицаФормы = Элементы.Услуги;
	КонецЕсли;

	
	мВС = ТаблицаФормы.ВыделенныеСтроки;
	КолСтр = мВС.Количество();
	Распределять = Ложь;
	Разница = 0;
	Если Ответ.Свойство("Распределить") Тогда
		Если Ответ.Распределить Тогда
			Распределять = Истина;
			Сумма = Окр(_сф.БезопасноРазделить(Ответ.Значение,КолСтр), 2,1);
			Разница = Ответ.Значение - Сумма * КолСтр;
		Иначе
			Сумма = Ответ.Значение;
		КонецЕсли;
	КонецЕсли;	
	
	Для Каждого ВСтр из мВС Цикл 
		Стр = Объект.Услуги.НайтиПоИдентификатору(ВСтр);
		
		Если Реквизит = "Номенклатура" Тогда
			Стр.Номенклатура = Ответ.Значение;
			_УслугиНоменклатураПриИзменении(ВСтр);
			
		ИначеЕсли Реквизит = "СтатьяЗатрат" Тогда
			
			Стр.СтатьяЗатрат = Ответ.Значение;
			
		ИначеЕсли Реквизит = "Подразделение" Тогда
			
			Стр.Подразделение = Ответ.Значение;
			
		ИначеЕсли Реквизит = "Грузоперевозка" Тогда
			
			Стр.Грузоперевозка = Ответ.Значение;
			_УслугиГрузоперевозкаПриИзменении(Стр.ПолучитьИдентификатор());
	
		ИначеЕсли Реквизит = "Способ учета НДС" Тогда
			
			Если Стр.ПорядокОтражения = ПредопределенноеЗначение("Перечисление.CW_ПорядокОтраженияЗатрат.Затраты") 
				или Стр.ПорядокОтражения = ПредопределенноеЗначение("Перечисление.CW_ПорядокОтраженияЗатрат.ПрочиеРасходы") Тогда
				Стр.СпособУчетаНДС = Ответ.Значение;
			КонецЕсли;
			
		ИначеЕсли Реквизит = "Порядок отражения" Тогда
			Стр.ПорядокОтражения = Ответ.Значение;
			ПриИзмененииУслугиПорядокОтражения(ВСтр)
		ИначеЕсли Реквизит = "Клиент / Договор" Тогда
			
			Если Стр.ПорядокОтражения = ПредопределенноеЗначение("Перечисление.CW_ПорядокОтраженияЗатрат.Перевыставление")  
				ИЛИ Стр.ПорядокОтражения = ПредопределенноеЗначение("Перечисление.CW_ПорядокОтраженияЗатрат.ПеревыставлениеПоСтавкам") 
				ИЛИ Стр.ПорядокОтражения = ПредопределенноеЗначение("Перечисление.CW_ПорядокОтраженияЗатрат.Затраты") Тогда
				
				Стр.Покупатель 			= Ответ.Значение;
				Стр.ДоговорПокупателя 	= Ответ.Договор;
				
				//Подсистема.УчетПриложенийДоговоров
				Стр.УчетПриложенийПоДоговору	= Ответ.УчетПриложенийПоДоговору;
				Стр.ПриложениеКДоговору 		= Ответ.ПриложениеКДоговору;
				//Подсистема.УчетПриложенийДоговоров
			Иначе
				Стр.Покупатель 			= Неопределено;
				Стр.ДоговорПокупателя 	= Неопределено;
				
				//Подсистема.УчетПриложенийДоговоров
				Стр.УчетПриложенийПоДоговору = Ложь;
				Стр.ПриложениеКДоговору = Неопределено;
				//Подсистема.УчетПриложенийДоговоров
		КонецЕсли; 
		ИначеЕсли Реквизит = "Количество" Тогда
			Стр.Количество = Ответ.Значение;
			ПересчитатьСтрокуНаСерере(ВСтр,Объект.ЦенаСНДС);
		ИначеЕсли Реквизит = "Цена" Тогда
			Стр.Цена = Сумма;
			ПересчитатьСтрокуНаСерере(ВСтр,Объект.ЦенаСНДС);
		ИначеЕсли Реквизит = "Сумма" Тогда
			Стр.Сумма = Сумма;
			Стр.Цена = _сф.БезопасноРазделить(Стр.Сумма, Стр.Количество);
			Ставка = CW_Финансы.ПолучитьСтавкуНДС(Стр.СтавкаНДС);
			Стр.НДС = CW_Финансы.РассчитатьСуммуНДС(Стр.Сумма, Истина, Ложь, Ставка);
			Стр.Всего = Стр.Сумма + Стр.НДС;
			ПересчитатьСтрокуНаСерере(ВСтр,Объект.ЦенаСНДС, Истина);
		ИначеЕсли Реквизит = "Ставка НДС" Тогда
			Стр.СтавкаНДС = Ответ.Значение;
			ПересчитатьСтрокуНаСерере(ВСтр,Объект.ЦенаСНДС);
		ИначеЕсли Реквизит = "Сумма НДС" Тогда
			Стр.НДС = Сумма;
			Если НЕ _ДС().НП.ОбратныйПересчетВДокументах Тогда
				Стр.Всего = Стр.Сумма + Стр.НДС;
			Иначе
				Стр.Сумма = Стр.Всего - Стр.НДС;
				Стр.Цена  = _сф.БезопасноРазделить(Стр.Сумма, Стр.Количество);
			КонецЕсли;
			ПересчитатьСтрокуНаСерере(ВСтр,Объект.ЦенаСНДС, Истина);
		ИначеЕсли Реквизит = "Всего" Тогда
			Стр.Всего = Сумма;
			Ставка = CW_Финансы.ПолучитьСтавкуНДС(Стр.СтавкаНДС)/100;
			Стр.НДС   = Стр.Всего * Ставка / (1 + Ставка);
			Стр.Сумма = Стр.Всего - Стр.НДС;
			Стр.Цена  = _сф.БезопасноРазделить(Стр.Сумма, Стр.Количество);
			ПересчитатьСтрокуНаСерере(ВСтр,Объект.ЦенаСНДС, Истина);
		ИначеЕсли Реквизит = "Представление" Тогда
			ДополнитьПредставление 	= Ложь;
			Если Ответ.Свойство("Дополнять") Тогда
				ДополнитьПредставление = Ответ.Дополнять;
			КонецЕсли;
			
			Если ДополнитьПредставление Тогда
				Стр.Представление = Стр.Представление + СокрП(Ответ.Значение);
			Иначе
				Стр.Представление = СокрЛП(Ответ.Значение);
			КонецЕсли;
		ИначеЕсли Реквизит = "ПрочиеРасходы" Тогда
			Стр.ПрочиеРасходы = Ответ.Значение;
		КонецЕсли;	
	КонецЦикла;	
	
	Если Распределять И Разница <> 0 Тогда
		Если Реквизит = "Цена" Тогда
			Стр.Цена = Сумма + Разница;
			ПересчитатьСтрокуНаСерере(ВСтр,Объект.ЦенаСНДС);
		ИначеЕсли Реквизит = "Сумма" Тогда
			Стр.Сумма = Сумма + Разница;
			Стр.Цена = _сф.БезопасноРазделить(Стр.Сумма, Стр.Количество);
			Ставка = CW_Финансы.ПолучитьСтавкуНДС(Стр.СтавкаНДС);
			Стр.НДС = CW_Финансы.РассчитатьСуммуНДС(Стр.Сумма, Истина, Ложь, Ставка);
			Стр.Всего = Стр.Сумма + Стр.НДС;
			ПересчитатьСтрокуНаСерере(ВСтр,Объект.ЦенаСНДС, Истина);
		ИначеЕсли Реквизит = "Сумма НДС" Тогда
			Стр.НДС = Сумма + Разница;
			Если НЕ _ДС().НП.ОбратныйПересчетВДокументах Тогда
				Стр.Всего = Стр.Сумма + Стр.НДС;
			Иначе
				Стр.Сумма = Стр.Всего - Стр.НДС;
				Стр.Цена  = _сф.БезопасноРазделить(Стр.Сумма, Стр.Количество);
			КонецЕсли;
			ПересчитатьСтрокуНаСерере(ВСтр,Объект.ЦенаСНДС, Истина);
		ИначеЕсли Реквизит = "Всего" Тогда
			Стр.Всего = Сумма + Разница;
			Ставка = CW_Финансы.ПолучитьСтавкуНДС(Стр.СтавкаНДС)/100;
			Стр.НДС   = Стр.Всего * Ставка / (1 + Ставка);
			Стр.Сумма = Стр.Всего - Стр.НДС;
			Стр.Цена  = _сф.БезопасноРазделить(Стр.Сумма, Стр.Количество);
			ПересчитатьСтрокуНаСерере(ВСтр,Объект.ЦенаСНДС, Истина);
		КонецЕсли;	
	КонецЕсли;	
	
	ОбновитьИтогиПоУслугам();
	
КонецПроцедуры	
	
