Процедура УстановитьФлагиПервичныхДокументовНаКлиенте(Флаг)
	
	Если РедактированиеФинансов_Расходы_Счета Тогда
		Объект.ПредъявленСчет 	= Флаг;
		ПредъявленСчетПриИзмененииНаКлиенте();
	КонецЕсли;
	
	Если РедактированиеФинансов_Расходы_Акты Тогда
		Объект.ПредъявленАкт 	= Флаг;
		Объект.ПредъявленСФ 	= Флаг;
		ПредъявленАктПриИзмененииНаКлиенте();
	КонецЕсли;
	
	ПервичныеДокументыУправлениеЭлементамиФормы();

