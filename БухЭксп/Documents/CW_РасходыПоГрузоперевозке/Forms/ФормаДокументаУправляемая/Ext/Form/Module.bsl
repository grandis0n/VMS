	ПриИзмененииУслугиПорядокОтражения();
КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииУслугиПорядокОтражения(Строка = Неопределено)
	
	Если Строка = Неопределено Тогда
		Стр = Элементы.Услуги.ТекущиеДанные;
	Иначе
		Стр = Объект.Услуги.НайтиПоИдентификатору(Строка);
	КонецЕсли;	

	// очистили значение
	Если Стр.ПорядокОтражения.Пустая() Тогда
		Стр.ПорядокОтражения = ПредопределенноеЗначение("Перечисление.CW_ПорядокОтраженияЗатрат.Затраты");
	КонецЕсли;    
	
	Стр.Подразделение = ПодразделениеПользователя;  //AFR-250522
	
	ТребоватьЗаполненияПокупателя = _ДС().ПД.ТребоватьЗаполненияПокупателяДляПорядокаОтраженияЗатратыВРасходах;
	
	_ПриИзмененииУслугиПорядокОтражения(?(Строка = Неопределено, Элементы.Услуги.ТекущаяСтрока, Строка));
	
	Если (Стр.ПорядокОтражения <> ПредопределенноеЗначение("Перечисление.CW_ПорядокОтраженияЗатрат.Затраты")) Тогда
		Если (Элементы.УслугиСпособУчетаНДС.Видимость) Тогда
			Стр.СпособУчетаНДС = Неопределено;	
		КонецЕсли; 
		
		// значение заполнено
		СтруктураПараметров 	= ПодготовитьДанныеДляПолученияДанныхпокупателя(Стр.ПолучитьИдентификатор());
		СтруктураДанныхСтроки 	= ПолучитьДанныеПокупателя(СтруктураПараметров);
		
		Если СтруктураДанныхСтроки.Свойство("Покупатель") Тогда
			Стр.Покупатель 		 	= СтруктураДанныхСтроки.Покупатель;
		КонецЕсли;
		Если СтруктураДанныхСтроки.Свойство("ДоговорПокупателя") Тогда
			Стр.ДоговорПокупателя 	= СтруктураДанныхСтроки.ДоговорПокупателя;
		КонецЕсли;
		Если  СтруктураДанныхСтроки.Свойство("ПриложениеКДоговору") Тогда
			Стр.ПриложениеКДоговору = СтруктураДанныхСтроки.ПриложениеКДоговору;
		КонецЕсли;
		Если  СтруктураДанныхСтроки.Свойство("УчетПриложений") Тогда
			Стр.УчетПриложенийПоДоговору = СтруктураДанныхСтроки.УчетПриложений;
		КонецЕсли;
		
	Иначе
		
		Если ТребоватьЗаполненияПокупателя Тогда
			// значение заполнено
			СтруктураПараметров 	= ПодготовитьДанныеДляПолученияДанныхпокупателя(Стр.ПолучитьИдентификатор());
			СтруктураДанныхСтроки 	= ПолучитьДанныеПокупателя(СтруктураПараметров);
			
			Если СтруктураДанныхСтроки.Свойство("Покупатель") Тогда
				Стр.Покупатель 		 	= СтруктураДанныхСтроки.Покупатель;
			КонецЕсли;
			Если СтруктураДанныхСтроки.Свойство("ДоговорПокупателя") Тогда
				Стр.ДоговорПокупателя 	= СтруктураДанныхСтроки.ДоговорПокупателя;
			КонецЕсли;
			Если  СтруктураДанныхСтроки.Свойство("ПриложениеКДоговору") Тогда
				Стр.ПриложениеКДоговору = СтруктураДанныхСтроки.ПриложениеКДоговору;
			КонецЕсли;
			Если  СтруктураДанныхСтроки.Свойство("УчетПриложений") Тогда
				Стр.УчетПриложенийПоДоговору = СтруктураДанныхСтроки.УчетПриложений;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли; 
	
КонецПроцедуры

&НаСервере
Процедура _ПриИзмененииУслугиПорядокОтражения(Строка)
	// --- 
	
	СтрокаТЧ = Объект.Услуги.НайтиПоИдентификатору(Строка);
	Если (СтрокаТЧ.ПорядокОтражения = Перечисления.CW_ПорядокОтраженияЗатрат.Затраты) Тогда
		_ПодставитьПодразделение(СтрокаТЧ);	
		Если ЗначениеЗаполнено(СтрокаТЧ.Номенклатура) Тогда
			
			СтруктураПараметров = Новый Структура;
			СтруктураПараметров.Вставить("Дата"					, Объект.Дата);
			СтруктураПараметров.Вставить("Организация"			, Объект.Организация);
			СтруктураПараметров.Вставить("Номенклатура"			, СтрокаТЧ.Номенклатура);
			СтруктураПараметров.Вставить("НоменклатурнаяГруппа"	, СтрокаТЧ.Номенклатура.НоменклатурнаяГруппа);
			
			СтрокаТЧ.СпособУчетаНДС = CW_Финансы.ПолучитьСпособУчетаНДС(СтруктураПараметров);
			
		КонецЕсли;	
	Иначе
		СтрокаТЧ.Подразделение = Неопределено;
	КонецЕсли; 
	
	// --- 
КонецПроцедуры

#КонецОбласти 

