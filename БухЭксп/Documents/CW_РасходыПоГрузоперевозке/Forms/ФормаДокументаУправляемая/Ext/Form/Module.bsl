&НаСервере
Функция ПолучитьПараметрыФормыВыбора(ТекущаяСтрока)
	
	НастройкиОтбора = CW_Бюджетирование.ПолучитьЗначенияПараметровОтбора("CW_ПараметрыОтбораРасходов");   
	
	СтрокаТекущая 	= Объект.Услуги.НайтиПоИдентификатору(ТекущаяСтрока);   

	ФиксированныеНастройкиОтбора = новый Структура;		
	ФиксированныеНастройкиОтбора.Вставить("Владелец", 				СтрокаТекущая.Грузоперевозка);	
	ФиксированныеНастройкиОтбора.Вставить("ВидСтатьиПланирования", 	ПредопределенноеЗначение("Перечисление.CW_ВидыСтатейПланирования.Расходы"));

	ПользовательскиеНастройкиОтбора = Новый Структура; 
	
	ВерсияБюджета = Константы.CW_ВерсияСтатьиБюджетаДляОтбора.Получить();
	ПользовательскиеНастройкиОтбора.Вставить("ВерсияБюджета", ВерсияБюджета);
	
	МетаданныеОбъекта = Объект.Ссылка.Метаданные();
	
	Для Каждого КлючЗначение из НастройкиОтбора Цикл  
		Если Не КлючЗначение.Значение Тогда
			Продолжить;
		КонецЕсли;   
		
		РеквизитОбъекта = ?(КлючЗначение.Ключ = "СуммаВсего","Всего",КлючЗначение.Ключ);
		
		Если ОбщегоНазначения.ЕстьРеквизитОбъекта(РеквизитОбъекта, МетаданныеОбъекта) Тогда
			ПользовательскиеНастройкиОтбора.Вставить(КлючЗначение.Ключ, Объект[РеквизитОбъекта]);
		КонецЕсли; 
		
		Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(СтрокаТекущая, РеквизитОбъекта) Тогда
			ПользовательскиеНастройкиОтбора.Вставить(КлючЗначение.Ключ, СтрокаТекущая[РеквизитОбъекта]);
		КонецЕсли;   
	КонецЦикла; 
	
	Если НастройкиОтбора["СтатьяИспользуетсяОднократно"] Тогда
		ПользовательскиеНастройкиОтбора.Вставить("ИспользуетсяВДокументах", Ложь);
	КонецЕсли;
	
	ПараметрыФормыВыбора = Новый Структура;
	ПараметрыФормыВыбора.Вставить("ДокументДоходов",		Объект.Ссылка);
	ПараметрыФормыВыбора.Вставить("Владелец",				СтрокаТекущая.Грузоперевозка);
	ПараметрыФормыВыбора.Вставить("ВидСтатьиПланироваия",	ПредопределенноеЗначение("Перечисление.CW_ВидыСтатейПланирования.Расходы"));
	ПараметрыФормыВыбора.Вставить("ФиксированныеНастройкиОтбора", 		ФиксированныеНастройкиОтбора);
	ПараметрыФормыВыбора.Вставить("ПользовательскиеНастройкиОтбора", 	ПользовательскиеНастройкиОтбора); 
	
	Возврат ПараметрыФормыВыбора;	
	
КонецФункции


