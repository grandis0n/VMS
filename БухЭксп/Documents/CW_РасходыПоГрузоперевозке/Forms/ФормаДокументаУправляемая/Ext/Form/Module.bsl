&НаКлиенте
Функция ПоказатьДиалогВводаНаОсновании()
	// --- 
	
	ПОВ_ОтказОткрытия = Новый ОписаниеОповещения("ЗакрытьФорму",ЭтотОбъект);
	ПОВ = Новый ОписаниеОповещения("ОбработкаРезультатаВводаНаОсновании",ЭтотОбъект, Новый Структура("ПОВ_ОтказОткрытия",ПОВ_ОтказОткрытия)); 
	ПФ = Новый Структура("Основание",ДокументОснование);
	ОткрытьФорму("Документ.CW_РасходыПоГрузоперевозке.Форма.ФормаВводаНаОснованииУправляемая",ПФ,,,,,ПОВ,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
	// --- 
КонецФункции

&НаКлиенте
Процедура ОбработкаРезультатаВводаНаОсновании(Ответ, ДополнительныеПараметры) Экспорт 
	// --- 
	
	Отказ = Ложь;
	Если (Ответ = Неопределено) Тогда
		
		Отказ = Истина;
		
	Иначе
		
		Результат = _ОбработатьВводНаОсновании(Ответ); 
		
		// по заявке AFR-250448
		Для Каждого СтрокаУслуг из Объект.Услуги Цикл  
			ИдентификаторСтроки = СтрокаУслуг.ПолучитьИдентификатор();
			ПриИзмененииУслугиПорядокОтражения(ИдентификаторСтроки);
		КонецЦикла;
		//---- по заявке AFR-250448		
		
		Если (НЕ _УФКС.ВыполненоУспешно(Результат)) Тогда
			
			Отказ = Истина;
			
		Иначе
			
			_ИнициализацияФормы();
			
			#Область Динамический_вывод_дополнительных_колонок
			
			//Обновляем динамические колонки параметров ГП
			Если Объект.Услуги.Количество() > 0 Тогда
				_УФС.ОбновитьЗначенияПараметровГрузоперевозок(ПолучитьСтруктуруПараметровДляПередачи());
			КонецЕсли;
			
			#КонецОбласти
		
		КонецЕсли; 
		
	КонецЕсли; 
	
	Если (Отказ) Тогда
		
		ВыполнитьОбработкуОповещения(ДополнительныеПараметры.ПОВ_ОтказОткрытия);
		
	КонецЕсли; 
	
	// --- 
КонецПроцедуры

&НаСервере
Функция _ОбработатьВводНаОсновании(Знач Ответ)
	// --- 
	
	ЭтаФорма.Модифицированность=Истина;
	Объект.Дата = Ответ.Дата;
	Объект.Контрагент = Ответ.Контрагент;
	Объект.Договор = Ответ.Договор;
	Объект.Организация = Объект.Договор.Организация;
	Объект.Валюта = Объект.Договор.ВалютаДоговора;
	
	//Подсистема.УчетПриложенийДоговоров
	Объект.ПриложениеКДоговору = Ответ.ПриложениеКДоговору;
	//Подсистема.УчетПриложенийДоговоров
	
	//Для версии КОРП
	Если ВестиУчетПоПодразделениям Тогда
		Объект.ПодразделениеОрганизации = Ответ.Основание.ПодразделениеОрганизации;
	КонецЕсли;
	//Для версии КОРП
	
	ОтображатьКомментарийДоговора = CW_Настройки.ПолучитьНастройкуПользователя(CW_Настройки.Пользователь(),"ОтображатьКомментарийДоговораВФормеВводаДокументовПоБюджету");
	УстановитьЗаголовокНадписиКомментарияДоговора();
	
	// --- 
	_СформироватьОбщиеПараметры();
	// --- 
	
	РасчитатьСрокОплатыДокумента();
	
	Объект.СпособЗачетаАвансовОЗ = _ДС().ПД.ПорядокЗачетаАвансовОЗ;
	Объект.СпособЗачетаАвансов = _ДС().ПД.ПорядокЗачетаАвансов;
	
	// --- 
	
	Объект.ПредъявленСчет = Ответ.Основание.ФормируетсяСчет;
	//Объект.НомерСчета = CW_Документы.ПолучитьНомерНаПечать(Новый Структура("Организация,Номер", Ответ.Основание.Организация,Ответ.Основание.НомерСчета));
	Объект.НомерСчета = CW_Документы.ПолучитьНомерНаПечать(Ответ.Основание, "НомерСчета", "ДатаСчета");
	ОБъект.ДатаСчета = Ответ.Основание.ДатаСчета;
	// --- 
	Объект.ПредъявленАкт = Ответ.Основание.ФормируетсяАкт;
	//Объект.НомерАкта = CW_Документы.ПолучитьНомерНаПечать(Новый Структура("Организация,Номер", Ответ.Основание.Организация,Ответ.Основание.НомерАкта));
	Объект.НомерАкта = CW_Документы.ПолучитьНомерНаПечать(Ответ.Основание, "НомерАкта", "ДатаАкта");
	ОБъект.ДатаАкта = Ответ.Основание.ДатаАкта;
	// --- 
	Объект.ПредъявленСФ = Ответ.Основание.ФормируетсяСчетФактура;
	//Объект.НомерСФ = CW_Документы.ПолучитьНомерНаПечать(Новый Структура("Организация,Номер", Ответ.Основание.Организация,Ответ.Основание.НомерСчетаФактуры));
	Объект.НомерСФ = CW_Документы.ПолучитьНомерНаПечать(Ответ.Основание, "НомерСчетаФактуры", "ДатаСчетаФактуры");
	ОБъект.ДатаСФ = Ответ.Основание.ДатаСчетаФактуры;
	
	// --- 
	
	ПорядокОтражения = Ответ.ПорядокОтражения;
	Если (НЕ ЗначениеЗаполнено(ПорядокОтражения)) Тогда
		ПорядокОтражения = Перечисления.CW_ПорядокОтраженияЗатрат.Перевыставление;
	КонецЕсли; 
	ДатаИсточника = ДокументОснование.Дата;
	ВалютаИсточника = ДокументОснование.Валюта;
	
	НачальнаяДатаДокумента  = Объект.Дата;
	ВзаиморасчетыВУЕ		= Объект.Договор.ВзаиморасчетыВУЕ;	
	
	СостояниеДокумента 		= ОбщегоНазначенияБП.СостояниеДокумента(Объект); // ВызовБП
	
	// --- 
	
	//
	Ответ = Документы.CW_РасходыПоГрузоперевозке.Услуги_СформироватьПоДокументуДоходов(ДокументОснование,Объект.Договор);
	Если Ответ.Код <> 0 Тогда
		
		Возврат(_УФКС.Ответ(1));
		
	Иначе
		
		Объект.Продавец = Ответ.Продавец;
		ТаблицаУслуг = Ответ.ТаблицаУслуг; // в валюте и рублях
		
		// анализируем
		ПересчетЧерезРубли = Ложь;
		// если валюта документов одинаковая
		Если (ВалютаИсточника = Объект.Валюта) Тогда
			
			// если рубли
			Если (Объект.Валюта = _ДС().КО.ВалютаРегламентированногоУчета) Тогда
				
				ПересчетЧерезРубли = Ложь;
				
			Иначе
				
				// проверяем даты документов и порядок отражения
				Если (ПорядокОтражения=Перечисления.CW_ПорядокОтраженияЗатрат.ПеревыставлениеПоСтавкам) Тогда
					
					ПересчетЧерезРубли = Ложь;
					
				ИначеЕсли (ПорядокОтражения=Перечисления.CW_ПорядокОтраженияЗатрат.Перевыставление) Тогда 
					
					// проверяем даты
					Если (НачалоДня(Объект.Дата)=НачалоДня(ДатаИсточника)) Тогда
						
						ПересчетЧерезРубли = Ложь;
						
					Иначе
						
						ПересчетЧерезРубли = Истина;
						
					КонецЕсли; 
					
				КонецЕсли; 
				
			КонецЕсли; 
			
		Иначе
			
			ПересчетЧерезРубли = Истина;
			
		КонецЕсли; 
		
		Если (ПересчетЧерезРубли) Тогда
			
			СК = CW_Финансы.ПолучитьКурсВалюты(Объект.Валюта,Объект.Дата);
			Документы.CW_РасходыПоГрузоперевозке.Услуги_ПересчитатьИзВалютыРегламентированногоУчета(ТаблицаУслуг,СК);
			
		КонецЕсли; 
		
		ТаблицаУслуг.Колонки.Удалить(ТаблицаУслуг.Колонки.Найти("ПорядокОтражения"));
		ТаблицаУслуг.Колонки.Добавить("ПорядокОтражения");
		ТаблицаУслуг.ЗаполнитьЗначения(ПорядокОтражения,"ПорядокОтражения");
		Если ПорядокОтражения = Перечисления.CW_ПорядокОтраженияЗатрат.Затраты
			ИЛИ ПорядокОтражения = Перечисления.CW_ПорядокОтраженияЗатрат.Перевыставление
			ИЛИ ПорядокОтражения = Перечисления.CW_ПорядокОтраженияЗатрат.ПеревыставлениеПоСтавкам Тогда
			
			Если ДокументОснование.Организация = Объект.Организация Тогда
				ТаблицаУслуг.Колонки.Добавить("Покупатель");
				ТаблицаУслуг.Колонки.Добавить("ДоговорПокупателя");
				
				ТаблицаУслуг.ЗаполнитьЗначения(ДокументОснование.Контрагент,"Покупатель");
				ТаблицаУслуг.ЗаполнитьЗначения(ДокументОснование.Договор,"ДоговорПокупателя");
				
				//Подсистема.УчетПриложенийДоговоров
				ТаблицаУслуг.Колонки.Добавить("ПриложениеКДоговору");
				ТаблицаУслуг.ЗаполнитьЗначения(ДокументОснование.ПриложениеКДоговору,"ПриложениеКДоговору");
				//Подсистема.УчетПриложенийДоговоров
			Иначе
				ТаблицаУслуг.Колонки.Добавить("Покупатель");
				ТаблицаУслуг.Колонки.Добавить("ДоговорПокупателя");
				ТаблицаУслуг.Колонки.Добавить("ПриложениеКДоговору");
				ТаблицаУслуг.Колонки.Добавить("УчетПриложенийПоДоговору");
				
				Для Каждого СтрокаТекущая из ТаблицаУслуг Цикл
					
					СтруктураПараметров = Новый Структура;
					СтруктураПараметров.Вставить("Организация", 		Объект.Организация);
					СтруктураПараметров.Вставить("Контрагент", 			СтрокаТекущая.Грузоперевозка.Клиент);
					СтруктураПараметров.Вставить("Объект", 				СтрокаТекущая.Грузоперевозка);
					СтруктураПараметров.Вставить("ЭтоВариантБюджета", 	ЛОЖЬ);
					СтруктураПараметров.Вставить("УчетПриложений", 		ЛОЖЬ);
					
					СтруктураДанныхСтроки 	= ПолучитьДанныеПокупателя(СтруктураПараметров);
					
					Если СтруктураДанныхСтроки.Свойство("Покупатель") Тогда
						СтрокаТекущая.Покупатель 		 = СтруктураДанныхСтроки.Покупатель;
					КонецЕсли;
					Если СтруктураДанныхСтроки.Свойство("ДоговорПокупателя") Тогда
						СтрокаТекущая.ДоговорПокупателя  = СтруктураДанныхСтроки.ДоговорПокупателя;
					КонецЕсли;
					Если СтруктураДанныхСтроки.Свойство("ПриложениеКДоговору") Тогда
						СтрокаТекущая.ПриложениеКДоговору = СтруктураДанныхСтроки.ПриложениеКДоговору;
					КонецЕсли;
					Если СтруктураДанныхСтроки.Свойство("УчетПриложений") Тогда
						СтрокаТекущая.УчетПриложенийПоДоговору = СтруктураДанныхСтроки.УчетПриложений
					КонецЕсли;
				КонецЦикла;
				
			КонецЕсли;
			
		КонецЕсли; 
		
		//	// --- 
		Объект.Услуги.Загрузить(ТаблицаУслуг);
		
		_УФС.ОбновитьЗначенияПараметровГрузоперевозок(ПолучитьСтруктуруПараметровДляПередачи());

		Возврат(_УФКС.Ответ());
		
	КонецЕсли; 
	//
	
	// --- 
КонецФункции

&НаКлиенте
Процедура ЗакрытьФорму(Ответ,ДополнительныеПараметры) Экспорт
	// --- 
	
	Закрыть();
	
	// --- 
КонецПроцедуры

#КонецОбласти 

#Область ПодборГрузоперевозок 

&НаКлиенте
Процедура Подбор(Команда)
	
	Если Объект.Валюта.Пустая() Тогда
		
		_УФК.ВывестиПредупреждение("Не указана валюта документа");
		Возврат;
		
	КонецЕсли; 
	
	// формируем параметры
	ПОВ = Новый ОписаниеОповещения("ОбработкаПодбора",ЭтотОбъект);
	ПФ = _ПараметрыФормыПодбора();
	ОткрытьФорму("ОбщаяФорма.CW_ФормаПодбора",ПФ,,,,,ПОВ,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаПодбора(Результат, ДополнительныеПараметры) Экспорт 
	
	Если Результат <> Неопределено Тогда
		
		_ОбработатьПодбор(Результат);
		
		//подсистема.Бюджетирование
		Если CW_Бюджетирование.ВедетсяУчетСтатейБюджетаВДокументах() Тогда
			ОповещениеОЗавершении = Новый ОписаниеОповещения("ПослеПолученияСтатейБюджета", ЭтотОбъект); 
			CW_БюджетированиеКлиент.ЗаполнитьСтатьиБюджетаПослеподбора(ЭтаФорма, ОповещениеОЗавершении);	
		КонецЕсли;
		//подсистема.Бюджетирование
		
		ДобавитьЗависимуюУслугу();
		
		// обновим итоги табличных частей на форме
		ОбновитьИтогиПоУслугам();
		ЗаполнитьДополнительныеКолонкиТабличнойЧасти();
		
	КонецЕсли; 
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьЗависимуюУслугу()
	
	//Проверим и при необходимости добавим дополнительную услугу
	CW_Подписки.ДобавитьДополнительнуюУслугу(Объект);
	
КонецПроцедуры


&НаСервере
Функция _ПараметрыФормыПодбора()
	// --- 
	
	ДатаДокумента = Объект.Дата;
	Если Объект.ПредъявленАкт 
		И ЗначениеЗаполнено(Объект.ДатаАкта) Тогда
		ДатаДокумента = Объект.ДатаАкта;  
	ИначеЕсли Объект.ПредъявленСчет  
		И ЗначениеЗаполнено(Объект.ДатаСчета) Тогда
		ДатаДокумента = Объект.ДатаСчета;  
	КонецЕсли;

	ДатаДокумента = ?(ДатаДокумента = Дата(1,1,1), ТекущаяДата(), ДатаДокумента);
	
	ПФ = Новый Структура("Договор,Валюта,ТипДокумента,Грузоперевозки,РаздельныйУчетВходящегоНДС,ГруппировкаЗатратПоПодразделениям,ДатаДокумента");
	// --- 
	ПФ.Договор 			= Объект.Договор;
	ПФ.ДатаДокумента 	= ДатаДокумента;
	ПФ.Валюта 			= Объект.Валюта;
	ПФ.ТипДокумента 	= РеквизитФормыВЗначение("Объект").Метаданные().Имя;
	
	//Подсистема.УчетПриложенийДоговоров
	ПФ.Вставить("ПриложениеКДоговору", Объект.ПриложениеКДоговору);
	//Подсистема.УчетПриложенийДоговоров
	
	// --- 
	Попытка
		РаздельныйУчетВходящегоНДС = _ДС().УП.РаздельныйУчетНДСНаСчете19;	
	Исключение
	    РаздельныйУчетВходящегоНДС = Ложь;
	КонецПопытки; 
	ПФ.РаздельныйУчетВходящегоНДС = (РаздельныйУчетВходящегоНДС И CW_ПраваДоступа.ПравоДоступно("РедактированиеСпособаУчетаНДС"));
	// --- 
	Попытка
		ГруппировкаЗатратПоПодразделениям = _ДС().УП.ГруппировкаЗатратПоПодразделениям;
	Исключение
	    ГруппировкаЗатратПоПодразделениям = Ложь;
	КонецПопытки; 
	ПФ.ГруппировкаЗатратПоПодразделениям = ГруппировкаЗатратПоПодразделениям;
	// --- 
	ПФ.Грузоперевозки = _сф.м_СоздатьИзКолонкиТЗ(Объект.Услуги.Выгрузить(),"Грузоперевозка");
	// --- 
	Возврат(ПФ);
	
	// --- 
КонецФункции

&НаСервере
Процедура _ОбработатьПодбор(Результат)
		// --- 
	ТребоватьЗаполненияПокупателя = _ДС().ПД.ТребоватьЗаполненияПокупателяДляПорядокаОтраженияЗатратыВРасходах;
	
	Если Результат.Вариант = "Грузоперевозка" Тогда
		
		Нстр = Объект.Услуги.Добавить();
		Нстр.Грузоперевозка = Результат.Грузоперевозка;
		Нстр.ПорядокОтражения = Перечисления.CW_ПорядокОтраженияЗатрат.Затраты;
		Нстр.Количество = 1;
		
		Если Объект.Корректировка Тогда
			Нстр.ЭтоДобавленнаяСтрока = Истина;
		КонецЕсли;
		
		Если ТребоватьЗаполненияПокупателя Тогда
			СтруктураПараметров 	= ПодготовитьДанныеДляПолученияДанныхпокупателя(Нстр.ПолучитьИдентификатор());
			СтруктураДанныхСтроки 	= ПолучитьДанныеПокупателя(СтруктураПараметров);
			
			Если СтруктураДанныхСтроки.Свойство("Покупатель") Тогда
				Нстр.Покупатель 		 = СтруктураДанныхСтроки.Покупатель;
			КонецЕсли;
			Если СтруктураДанныхСтроки.Свойство("ДоговорПокупателя") Тогда
				Нстр.ДоговорПокупателя 	 = СтруктураДанныхСтроки.ДоговорПокупателя;
			КонецЕсли;
			Если СтруктураДанныхСтроки.Свойство("ПриложениеКДоговору") Тогда
				Нстр.ПриложениеКДоговору = СтруктураДанныхСтроки.ПриложениеКДоговору;
			КонецЕсли;
			Если СтруктураДанныхСтроки.Свойство("УчетПриложений") Тогда
				Нстр.УчетПриложенийПоДоговору = СтруктураДанныхСтроки.УчетПриложений;
			КонецЕсли;
		КонецЕсли;
		
		// --- 
		_ПодставитьПодразделение(Нстр);
		// --- 
		ОбновитьИтогиПоУслугам();
		ЗаполнитьДополнительныеКолонкиТабличнойЧасти();
		
	ИначеЕсли Результат.Вариант = "Бюджет" Тогда
		
		Если (Результат.Свойство("КомментарийЗаполнения")) Тогда
			Сообщить(Результат.КомментарийЗаполнения); 
		КонецЕсли; 
		ТЗУслуг = ПолучитьИзВременногоХранилища(Результат.Строки);
		Если (Результат.ПерезаполнитьДокумент) Тогда
			Объект.Услуги.Очистить();
		КонецЕсли; 
		
		Для каждого Стр Из ТЗУслуг Цикл
			
			Нстр = Объект.Услуги.Добавить();
			ЗаполнитьЗначенияСвойств(Нстр,Стр);
			
			Если Объект.ЦенаСНДС Тогда 
				Если Нстр.Количество = 0 Тогда
					Нстр.Цена = 0;	
				Иначе
					Нстр.Цена = Нстр.Всего / Нстр.Количество;
				КонецЕсли;
			КонецЕсли;

			// заполнение покупателя и договора
			СтрокаТЧ = Нстр;
			
			Если СтрокаТЧ.ПорядокОтражения = Перечисления.CW_ПорядокОтраженияЗатрат.Затраты Тогда
				Если ТребоватьЗаполненияПокупателя Тогда
					СтруктураПараметров 	= ПодготовитьДанныеДляПолученияДанныхпокупателя(СтрокаТЧ.ПолучитьИдентификатор());
					СтруктураДанныхСтроки 	= ПолучитьДанныеПокупателя(СтруктураПараметров);
					
					Если СтруктураДанныхСтроки.Свойство("Покупатель") Тогда
						СтрокаТЧ.Покупатель 		 = СтруктураДанныхСтроки.Покупатель;
					КонецЕсли;
					Если СтруктураДанныхСтроки.Свойство("ДоговорПокупателя") Тогда
						СтрокаТЧ.ДоговорПокупателя 	 = СтруктураДанныхСтроки.ДоговорПокупателя;
					КонецЕсли;
					Если СтруктураДанныхСтроки.Свойство("ПриложениеКДоговору") Тогда
						СтрокаТЧ.ПриложениеКДоговору = СтруктураДанныхСтроки.ПриложениеКДоговору;
					КонецЕсли;
					Если СтруктураДанныхСтроки.Свойство("УчетПриложений") Тогда
						СтрокаТЧ.УчетПриложенийПоДоговору = СтруктураДанныхСтроки.УчетПриложений;
					КонецЕсли;
				КонецЕсли;
			Иначе
				СтруктураПараметров 	= ПодготовитьДанныеДляПолученияДанныхпокупателя(СтрокаТЧ.ПолучитьИдентификатор());
				СтруктураДанныхСтроки 	= ПолучитьДанныеПокупателя(СтруктураПараметров);
				
				Если СтруктураДанныхСтроки.Свойство("Покупатель") Тогда
					СтрокаТЧ.Покупатель 		 = СтруктураДанныхСтроки.Покупатель;
				КонецЕсли;
				Если СтруктураДанныхСтроки.Свойство("ДоговорПокупателя") Тогда
					СтрокаТЧ.ДоговорПокупателя 	 = СтруктураДанныхСтроки.ДоговорПокупателя;
				КонецЕсли;
				Если СтруктураДанныхСтроки.Свойство("ПриложениеКДоговору") Тогда
					СтрокаТЧ.ПриложениеКДоговору = СтруктураДанныхСтроки.ПриложениеКДоговору;
				КонецЕсли;
				Если СтруктураДанныхСтроки.Свойство("УчетПриложений") Тогда
					СтрокаТЧ.УчетПриложенийПоДоговору = СтруктураДанныхСтроки.УчетПриложений;
				КонецЕсли;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(СтрокаТЧ.Номенклатура) И (СтрокаТЧ.ПорядокОтражения = Перечисления.CW_ПорядокОтраженияЗатрат.Затраты ИЛИ СтрокаТЧ.ПорядокОтражения = Перечисления.CW_ПорядокОтраженияЗатрат.ПустаяСсылка()) Тогда	
				
				СтруктураПараметров = Новый Структура;
				СтруктураПараметров.Вставить("Дата"					, Объект.Дата);
				СтруктураПараметров.Вставить("Организация"			, Объект.Организация);
				СтруктураПараметров.Вставить("Номенклатура"			, СтрокаТЧ.Номенклатура);
				СтруктураПараметров.Вставить("НоменклатурнаяГруппа"	, СтрокаТЧ.Номенклатура.НоменклатурнаяГруппа);
				
				СтрокаТЧ.СпособУчетаНДС = CW_Финансы.ПолучитьСпособУчетаНДС(СтруктураПараметров);
				
			КонецЕсли; 
			// --- 
			_ПодставитьПодразделение(СтрокаТЧ);
			// --- 
			
		КонецЦикла;
		// --- 
		ОбновитьИтогиПоУслугам();
		ЗаполнитьДополнительныеКолонкиТабличнойЧасти();
		
	ИначеЕсли Результат.Вариант = "ГрузоперевозкиИНоменклатура" Тогда
		
		ИспользуетсяОгранчиениеУслуг = ПолучитьОграничениеУслугПоНоменклатуре();
		СН = Результат.СтруктураНоменклатуры;
		
		// определяем вариант представления
		// 0 - получаем шаблон
		// 1 - используем полученный шаблон
		
		// определяем вариант суммы
		// 0 - по цене номенклатуры
		// 1 - фиксированное значение
		// 2 - фиксированное значение цены
		// для фиксированных значений необходимо прочитать саму сумму и признак того, что сумма с НДС
		
		// режим распределения суммы
		// 0 - на все г/п
		// 1 - на каждую г/п
		// 2 - пропорционально параметру
		// 3 - пропорционально выручке
		
		// порядок получения количества
		// 0 - из параметра грузоперевозки
		// 1 - фиксированная сумма
		
		СуммаУслуги = 0;
		РазделитьКоличествоУслугНаКоличествоГрузоперевозок 	= _сф.ст_ПолучитьСвойство(СН,"РазделитьКоличествоУслугНаКоличествоГрузоперевозок");
		РаспределитьКоличествоПророрциональноПараметру 		= _сф.ст_ПолучитьСвойство(СН,"РаспределитьКоличествоПророрциональноПараметру");
		ПорядокПолученияКоличества 							= _сф.ст_ПолучитьСвойство(СН,"ПорядокПолученияКоличества");
		
		Если ПорядокПолученияКоличества = 1 Тогда
			Количество = _сф.ст_ПолучитьСвойство(СН,"Количество");
			Если (Количество = Неопределено) Тогда
				Количество = 1;
			КонецЕсли;
		Иначе
			
			Если РазрешитьПолучениеКоличестваУслугИзпараметраГрузоперевозки тогда
				
				//получаем количество из параметров ГП
				КоличествоПоГрузоперевозкам = Новый Соответствие;
				Для каждого Грузоперевозка Из Результат.Грузоперевозки Цикл
					
					//Получаем количество из Параметра
					ЗначениеПараметра   = 0;
					СтруктураПараметров = Новый Структура("ТипПеревозки,Номенклатура,ЕдиницаИзмерения", Грузоперевозка.ТипПеревозки,СН.Номенклатура,СН.Номенклатура.ЕдиницаИзмерения);		
					НайденныйПараметр 	= CW_Документы.ПолучитьПараметрДляПодстановкиЗначенияВКоличество(СтруктураПараметров);
					
					Если НайденныйПараметр <> Неопределено Тогда
						//Получаем только первое значение
						СтрокаПараметраГП = Грузоперевозка.ПараметрыГрузоперевозки.Найти(НайденныйПараметр, "Параметр");
						
						Если СтрокаПараметраГП <> Неопределено Тогда
							ЗначениеПараметра = СтрокаПараметраГП.Значение;
						КонецЕсли;
						
					КонецЕсли;	
					
					Если Не УстановитьЗначениеНольЗначениеПараметраНеУстановлено и Не ЗначениеЗаполнено(ЗначениеПараметра) Тогда
						ЗначениеПараметра = 1;
					КонецЕсли;
					
					КоличествоПоГрузоперевозкам.Вставить(Грузоперевозка,ЗначениеПараметра);
					
				КонецЦикла;
				
			КонецЕсли;
			
		КонецЕсли;
		
		ОбратныйПересчет = Ложь;
		Если НЕ ЗначениеЗаполнено(СН.СтавкаНДС) Тогда
			
			СуммаУслуги = 0;
			
		Иначе
			
			Если СН.ВариантОпределенияСуммы =1 Тогда
				
				СуммаУслуги 		= СН.Всего;
				ОбратныйПересчет 	= СН.СуммаВключаетНДС;
				
			ИначеЕсли СН.ВариантОпределенияСуммы = 2 Тогда
				
				ЦенаУслуги 			= СН.Цена;
				ОбратныйПересчет 	= СН.ЦенаВключаетНДС; 
				
			ИначеЕсли Не ИспользуетсяОгранчиениеУслуг Тогда
				
				// получаем сумму из типа цены
				ТипЦен = _ДС().ПД.ТипЦен;
				Если НЕ ТипЦен.Пустая() Тогда
					
					СК = CW_Финансы.ПолучитьКурсВалюты(Объект.Валюта,_ДатаВозникновенияЗадолженности());
					Цена = Ценообразование.ПолучитьЦенуНоменклатуры(СН.Номенклатура, ТипЦен, _ДатаВозникновенияЗадолженности(), Объект.Валюта, СК.Курс,СК.Кратность);
					ОбратныйПересчет = ТипЦен.ЦенаВключаетНДС;
					СуммаУслуги = Цена*Количество;
					
				Иначе
					
					ОбратныйПересчет = Ложь;
					СуммаУслуги = 0;
					
				КонецЕсли; 
				
			КонецЕсли;
			
		КонецЕсли; 
		
		// пропорционально выручке
		Если (СуммаУслуги <> 0 И СН.ВариантРаспределения = 3) Тогда
			
			Грузоперевозки = Результат.Грузоперевозки;
			ОпределениеВыручки = _сф.ст_ПолучитьСвойство(СН,"ОпределениеВыручки");
			УчитыватьСуммыНеактированныхСчетов = _сф.ст_ПолучитьСвойство(СН,"УчитыватьСуммыНеактированныхСчетов");
			// --- 
			
			// по счетам
			Если (ОпределениеВыручки = 0) Тогда
				
				Запрос = Новый Запрос;
				Запрос.Текст = "ВЫБРАТЬ
				|	CW_ДоходыПоГрузоперевозкам.Грузоперевозка,
				|	CW_ДоходыПоГрузоперевозкам.Всего
				|ИЗ
				|	РегистрНакопления.CW_ДоходыПоГрузоперевозкам КАК CW_ДоходыПоГрузоперевозкам
				|ГДЕ
				|	CW_ДоходыПоГрузоперевозкам.ДокументДоходов.ФормируетсяСчет = ИСТИНА
				|	И CW_ДоходыПоГрузоперевозкам.Грузоперевозка В(&Грузоперевозки)";
				Запрос.УстановитьПараметр("Грузоперевозки", Грузоперевозки);
				ТЗ = Запрос.Выполнить().Выгрузить();
				ТЗ.Свернуть("Грузоперевозка","Всего");
				
			КонецЕсли; 
			
			// по актам
			Если (ОпределениеВыручки = 1) Тогда
				
				Запрос = Новый Запрос;
				Запрос.Текст = "ВЫБРАТЬ
				|	CW_ДоходыПоГрузоперевозкам.Грузоперевозка,
				|	CW_ДоходыПоГрузоперевозкам.Всего
				|ИЗ
				|	РегистрНакопления.CW_ДоходыПоГрузоперевозкам КАК CW_ДоходыПоГрузоперевозкам
				|ГДЕ
				|	CW_ДоходыПоГрузоперевозкам.ДокументДоходов.ФормируетсяАкт = ИСТИНА
				|	И CW_ДоходыПоГрузоперевозкам.Грузоперевозка В(&Грузоперевозки)";
				Запрос.УстановитьПараметр("Грузоперевозки", Грузоперевозки);
				ТЗ = Запрос.Выполнить().Выгрузить();
				ТЗ.Свернуть("Грузоперевозка","Всего");
				
				Если (УчитыватьСуммыНеактированныхСчетов) Тогда
					
					Запрос = Новый Запрос;
					Запрос.Текст = "ВЫБРАТЬ
					|	CW_АктированиеИсходящихСчетов.Грузоперевозка,
					|	CW_АктированиеИсходящихСчетов.Валюта,
					|	CW_АктированиеИсходящихСчетов.Счет.ДатаСчета КАК ДатаСчета,
					|	ВЫБОР
					|		КОГДА CW_АктированиеИсходящихСчетов.ВидДвижения = &Приход
					|			ТОГДА CW_АктированиеИсходящихСчетов.Всего
					|		ИНАЧЕ -CW_АктированиеИсходящихСчетов.Всего
					|	КОНЕЦ КАК Всего_Валюта,
					|	0 КАК Всего
					|ИЗ
					|	РегистрНакопления.CW_АктированиеИсходящихСчетов КАК CW_АктированиеИсходящихСчетов
					|ГДЕ
					|	CW_АктированиеИсходящихСчетов.Грузоперевозка В(&Грузоперевозки)";
					Запрос.УстановитьПараметр("Грузоперевозки", Грузоперевозки);
					ТЗ2 = Запрос.Выполнить().Выгрузить();
					ТЗ2.Свернуть("Грузоперевозка,Валюта","Всего_Валюта,Всего");
					Для каждого Стр Из ТЗ2 Цикл
						
						Если (ТЗ2.Всего_Валюта > 0) Тогда
							
							КВ = CW_Финансы.ПолучитьКурсВалюты(Стр.Валюта,Стр.ДатаСчета);
							Стр.Всего = CW_Финансы.ПересчитатьИзВалютыВВалюту(Стр.Всего_Валюта,Стр.Валюта,CW_Настройки.ВалютаРегламентированногоУчета(),КВ.Курс,1,КВ.Кратность,1); 
							// --- 
							Отбор = Новый Структура("Грузоперевозка",Стр.Грузоперевозка);
							СтрокаГП = _сф.к_НайтиСтроку(ТЗ,Отбор);
							Если (СтрокаГП <> Неопределено) Тогда
								
								_сф.Инкремент(СтрокаГП.Всего,Стр.Всего);
								
							КонецЕсли; 
							
						КонецЕсли; 
						
					КонецЦикла; 
					// --- 
					
					
				КонецЕсли; 
				
			КонецЕсли; 
			
			БазаРаспределенияПоВыручке = ТЗ.Итог("Всего");
			СоответствиеВыручки = _сф.со_Создать("Грузоперевозка","Всего",ТЗ);
			// --- 
			ОстатокРаспределения = СуммаУслуги;
			
		КонецЕсли;	
		
		// распределение по параметру
		Если (СуммаУслуги <> 0 И СН.ВариантРаспределения = 2) Тогда 
			
			// считаем общую сумму 
			ТР = _сф.т_Создать("Грузоперевозка,Значение");
			Для каждого Грузоперевозка Из Результат.Грузоперевозки Цикл
				
				СтруктураЗначения = РегистрыСведений.CW_ХарактеристикиГрузоперевозок.ПолучитьЗначениеПараметра(Грузоперевозка, СН.ПараметрРаспределения);
				
				Значение = 0;
				Если ТипЗнч(СтруктураЗначения.Значение) = Тип("Число") Тогда
					Значение = СтруктураЗначения.Значение;
				КонецЕсли;
				
				Нстр 				= ТР.Добавить();
				Нстр.Грузоперевозка = Грузоперевозка;
				Нстр.Значение 		= Значение;
				
			КонецЦикла; 
			
			БазаРаспределенияПоПараметру = _сф.Итог(ТР,"Значение");
			СоответствиеЗначенийПараметра = _сф.со_Создать("Грузоперевозка","Значение",ТР);
			
			Если БазаРаспределенияПоПараметру = 0 Тогда
				
				СуммаУслуги = 0;
				
			КонецЕсли; 
			
		КонецЕсли;
		
		// проверяем вариант распределения
		Если СН.ВариантРаспределения = 0 ИЛИ СН.ВариантРаспределения = 2 Тогда
			
			ОстатокРаспределения = СуммаУслуги;
			
		КонецЕсли; 
		
		Ставка = CW_Финансы.ПолучитьСтавкуНДС(СН.СтавкаНДС);
		
		// ЗАПОЛНЯЕМ
		// ---------------------------------------------------------------------------- 
		Индекс=0;
		Для каждого Грузоперевозка Из Результат.Грузоперевозки Цикл
			
			_сф.Инкремент(Индекс);
			
			Нстр = Объект.Услуги.Добавить();
			Нстр.Грузоперевозка 	= Грузоперевозка;
			Нстр.Номенклатура 		= СН.Номенклатура;
			Нстр.СтатьяЗатрат 		= СН.СтатьяЗатрат;
			Нстр.ПорядокОтражения 	= СН.ПорядокОтраженияРасходов;
			Нстр.СтавкаНДС 			= СН.СтавкаНДС;
			
			Нстр.СпособУчетаНДС		= СН.СпособУчетаНДС;
			
			Если Объект.Корректировка Тогда
				Нстр.ЭтоДобавленнаяСтрока = Истина;
			КонецЕсли;
			
			// --- 
			Если ПорядокПолученияКоличества = 0 Тогда
				Количество = КоличествоПоГрузоперевозкам.Получить(Грузоперевозка);
				//ВРЕМЕННО УДАЛЕНО
				//Если Количество = 0 Тогда
				//	Сообщение = новый СообщениеПользователю;
				//	Сообщение.Текст = "По грузоперевозке "+Строка(Грузоперевозка)+" не удалось получить количество услуги!";
				//	Сообщение.ПутьКДанным  = "Объект";
				//	Сообщение.Поле    = "Услуги["+Нстр.ПолучитьИдентификатор()+"].Количество";
				//	Сообщение.Сообщить();
				//конецЕсли;
			КонецЕсли;
			
			Нстр.Количество = Количество;
			Если СН.ВариантОпределенияСуммы = 2 Тогда  
				
				Если ОбратныйПересчет Тогда
					Нстр.Всего 	= ЦенаУслуги * Количество;
					Нстр.НДС 	= Нстр.Всего*(Ставка/(100+Ставка));
					Нстр.Сумма 	= Нстр.Всего - Нстр.НДС;
					Нстр.Цена 	= _сф.БезопасноРазделить(Нстр.Сумма, Нстр.Количество);
				Иначе
					Нстр.Цена 	= ЦенаУслуги; 
					Нстр.Сумма 	= ЦенаУслуги * Количество;
					Нстр.НДС 	= Нстр.Сумма * (Ставка/100);
					Нстр.Всего 	= Нстр.Сумма + Нстр.НДС;
				КонецЕсли; 			
				
				ПересчитатьСтрокуНаСерере(Нстр.ПолучитьИдентификатор(),Объект.ЦенаСНДС, Истина);
				
			ИначеЕсли ИспользуетсяОгранчиениеУслуг и СН.ВариантОпределенияСуммы = 0  Тогда
				
				Если ЭтоАдресВременногоХранилища(АдресУслугПоДоговору) Тогда 
					
					СтруктураПараметров = Новый Структура;
					СтруктураПараметров.Вставить("АдресУслугПоДоговору"						, АдресУслугПоДоговору);
					СтруктураПараметров.Вставить("УстанавливатьЦенуВЗависимостиОтГруза"		, УстанавливатьЦенуВЗависимостиОтГруза);
					СтруктураПараметров.Вставить("УстанавливатьЦенуВЗависимостиОтКлиента"	, УстанавливатьЦенуВЗависимостиОтКлиента);
					
					СтруктураПараметров.Вставить("Номенклатура"							, СН.Номенклатура);
					Если УстанавливатьЦенуВЗависимостиОтГруза Тогда
						СтруктураПараметров.Вставить("Груз" , Грузоперевозка.Груз);
					КонецЕсли;
					Если УстанавливатьЦенуВЗависимостиОтКлиента тогда
						
						СтруктураПараметровКлиента = Новый Структура;
						СтруктураПараметровКлиента.Вставить("Объект"				, Грузоперевозка);
						СтруктураПараметровКлиента.Вставить("ЭтоВариантБюджета"		, Ложь);
						СтруктураПараметровКлиента.Вставить("Контрагент"			, Грузоперевозка.Клиент);
						
						тПокупатель = CW_Финансы.ВернутьПлательщика(СтруктураПараметровКлиента);
						
						СтруктураПараметров.Вставить("Клиент", тПокупатель);
					КонецЕсли;
					
					УслугаДоговора = _УФС.ПолучитьУслугуДоговораПоПараметрам(СтруктураПараметров);	
					
					Если УслугаДоговора <> Неопределено Тогда 				   
						
						Если ЗначениеЗаполнено(УслугаДоговора.ПорядокОтражения) Тогда
							Нстр.ПорядокОтражения = УслугаДоговора.ПорядокОтражения;
						КонецЕсли;
						
						Сумма		= УслугаДоговора.ЦенаБезНДС * Количество;
						Если ЗначениеЗаполнено(УслугаДоговора.СтавкаНДС)  Тогда
							НДС = Сумма * CW_Финансы.ПолучитьСтавкуНДС(УслугаДоговора.СтавкаНДС)/100;
						Иначе
							НДС = 0;
						КонецЕсли; 
						
						Нстр.СтавкаНДС 	= УслугаДоговора.СтавкаНДС;
						Нстр.Цена 		= УслугаДоговора.ЦенаБезНДС;
						
						Если УслугаДоговора.ВариантРасчетаНДС = Перечисления.ВариантыРасчетаНДС.НДССверху тогда
							Нстр.Сумма 			= УслугаДоговора.ЦенаБезНДС * Количество;
							ОбратныйПересчет 	= Ложь;
						Иначе //в сумме
							Нстр.Всего 			= УслугаДоговора.Цена * Количество;
							ОбратныйПересчет 	= Истина;
						КонецЕсли;
						
						Ставка = CW_Финансы.ПолучитьСтавкуНДС(УслугаДоговора.СтавкаНДС);
						
						Если ОбратныйПересчет Тогда
							
							Нстр.НДС 	= Нстр.Всего*(Ставка/(100+Ставка));
							Нстр.Сумма 	= Нстр.Всего - Нстр.НДС;
							Нстр.Цена 	= _сф.БезопасноРазделить(Нстр.Сумма,Нстр.Количество);
							
						Иначе
							
							Нстр.Цена 	= _сф.БезопасноРазделить(Нстр.Сумма,Нстр.Количество);
							Нстр.НДС 	= Нстр.Сумма*(Ставка/100);
							Нстр.Всего 	= Нстр.Сумма+Нстр.НДС;
							
						КонецЕсли; 
						
					КонецЕсли; 
					
				КонецЕсли; 
				
				
			Иначе
				// --- 
				
				Если (СуммаУслуги <> 0) Тогда
					// --- 
					
					// на каждую г/п
					Если СН.ВариантРаспределения = 1 Тогда
						
						Если ОбратныйПересчет Тогда
							
							Нстр.Всего = СуммаУслуги;
							
						Иначе
							
							Нстр.Сумма = СуммаУслуги;
							
						КонецЕсли; 
						
						Если (РазделитьКоличествоУслугНаКоличествоГрузоперевозок) Тогда
							
							Нстр.Количество = Количество/Результат.Грузоперевозки.Количество();
							
						КонецЕсли; 
						
						// на все г/п
					ИначеЕсли СН.ВариантРаспределения = 0 Тогда 
						
						Если ОбратныйПересчет Тогда
							
							Нстр.Всего = СуммаУслуги/Результат.Грузоперевозки.Количество();
							_сф.Декремент(ОстатокРаспределения,Нстр.Всего);
							
						Иначе
							
							Нстр.Сумма = СуммаУслуги/Результат.Грузоперевозки.Количество();
							_сф.Декремент(ОстатокРаспределения,Нстр.Сумма);
							
						КонецЕсли; 
						
						Если (РазделитьКоличествоУслугНаКоличествоГрузоперевозок) Тогда
							
							Нстр.Количество = Количество/Результат.Грузоперевозки.Количество();
							
						КонецЕсли;
						
						Если Результат.Грузоперевозки.Количество()=Индекс Тогда
							
							_сф.Инкремент(?(ОбратныйПересчет,Нстр.Всего,Нстр.Сумма),ОстатокРаспределения);
							
						КонецЕсли; 
						
						// по параметру
					ИначеЕсли СН.ВариантРаспределения = 2 Тогда 
						
						Если ОбратныйПересчет Тогда
							
							Нстр.Всего = СуммаУслуги*СоответствиеЗначенийПараметра.Получить(Грузоперевозка)/БазаРаспределенияПоПараметру;
							_сф.Декремент(ОстатокРаспределения,Нстр.Всего);
							
						Иначе
							
							Нстр.Сумма = СуммаУслуги*СоответствиеЗначенийПараметра.Получить(Грузоперевозка)/БазаРаспределенияПоПараметру;
							_сф.Декремент(ОстатокРаспределения,Нстр.Сумма);
							
						КонецЕсли; 
						
						Если (РаспределитьКоличествоПророрциональноПараметру) Тогда
							
							Нстр.Количество = Количество*СоответствиеЗначенийПараметра.Получить(Грузоперевозка)/БазаРаспределенияПоПараметру;
							
						КонецЕсли; 
						
						Если Результат.Грузоперевозки.Количество()=Индекс Тогда
							
							_сф.Инкремент(?(ОбратныйПересчет,Нстр.Всего,Нстр.Сумма),ОстатокРаспределения);
							
						КонецЕсли; 
						
						// по выручке
					ИначеЕсли (СН.ВариантРаспределения = 3) Тогда 
						
						ВыручкаПоГрузоперевозке = СоответствиеВыручки.Получить(Грузоперевозка);
						Если (ВыручкаПоГрузоперевозке = Неопределено) Тогда
							Продолжить;
						КонецЕсли; 
						Если (ВыручкаПоГрузоперевозке = 0) Тогда
							Продолжить;
						КонецЕсли; 
						
						Если ОбратныйПересчет Тогда
							
							Нстр.Всего = СуммаУслуги*СоответствиеВыручки.Получить(Грузоперевозка)/БазаРаспределенияПоВыручке;
							_сф.Декремент(ОстатокРаспределения,Нстр.Всего);
							
						Иначе
							
							Нстр.Сумма = СуммаУслуги*СоответствиеВыручки.Получить(Грузоперевозка)/БазаРаспределенияПоВыручке;
							_сф.Декремент(ОстатокРаспределения,Нстр.Сумма);
							
						КонецЕсли; 
						
						Если Результат.Грузоперевозки.Количество()=Индекс Тогда
							
							_сф.Инкремент(?(ОбратныйПересчет,Нстр.Всего,Нстр.Сумма),ОстатокРаспределения);
							
						КонецЕсли; 
						
					КонецЕсли; 
					
					Если ОбратныйПересчет Тогда
						
						Нстр.НДС 	= Нстр.Всего*(Ставка/(100+Ставка));
						Нстр.Сумма 	= Нстр.Всего - Нстр.НДС;
						Нстр.Цена 	= _сф.БезопасноРазделить(Нстр.Сумма,Нстр.Количество);
						
					Иначе
						
						Нстр.Цена 	= _сф.БезопасноРазделить(Нстр.Сумма,Нстр.Количество);
						Нстр.НДС 	= Нстр.Сумма*(Ставка/100);
						Нстр.Всего 	= Нстр.Сумма+Нстр.НДС;
						
					КонецЕсли; 
					
					ПересчитатьСтрокуНаСерере(Нстр.ПолучитьИдентификатор(),Объект.ЦенаСНДС, Истина);
					
				КонецЕсли; 
			КонецЕсли;
			
			// ---------------------------------------------------------------------------- 
			
			// устанавливаем представление
			Если СН.ВариантПредставления = 0 Тогда
				
				ПараметрыШаблона = CW_Шаблоны.ПолучитьПараметрШаблонаУслуг();
				
				ПараметрыШаблона.Номенклатура 	= Нстр.Номенклатура;
				ПараметрыШаблона.Объект 		= Объект;
				ПараметрыШаблона.Дата 			= Объект.Дата;
				ПараметрыШаблона.Договор 		= Объект.Договор;
				ПараметрыШаблона.ВидДоговора 	= Объект.Договор.ВидДоговора;
				ПараметрыШаблона.ПриложениеКДоговору = Объект.ПриложениеКДоговору;
				
				CW_Шаблоны.УстановитьПредставлениеНоменклатурыВСтроке(Нстр, ПараметрыШаблона); 
				
			Иначе
				
				Представление = СН.Представление;
				Если Найти(Представление,"%")  <> 0 Тогда
					
					// это шаблон
					Нстр.Представление = CW_Шаблоны.ОбработатьШаблонНоменклатуры(Представление,Объект,Нстр);
					
				Иначе
					
					Нстр.Представление = Представление;
					
				КонецЕсли; 
				
			КонецЕсли; 
			
			// заполнение покупателя и договора
			СтрокаТЧ = Нстр;
			
			Если СтрокаТЧ.ПорядокОтражения = Перечисления.CW_ПорядокОтраженияЗатрат.Затраты Тогда
				// --- 
				_ПодставитьПодразделение(СтрокаТЧ);	
				
				Если ТребоватьЗаполненияПокупателя Тогда
					СтруктураПараметров 	= ПодготовитьДанныеДляПолученияДанныхпокупателя(СтрокаТЧ.ПолучитьИдентификатор());
					СтруктураДанныхСтроки 	= ПолучитьДанныеПокупателя(СтруктураПараметров);
					
					Если СтруктураДанныхСтроки.Свойство("Покупатель") Тогда
						СтрокаТЧ.Покупатель 		 = СтруктураДанныхСтроки.Покупатель;
					КонецЕсли;
					Если СтруктураДанныхСтроки.Свойство("ДоговорПокупателя") Тогда
						СтрокаТЧ.ДоговорПокупателя 	 = СтруктураДанныхСтроки.ДоговорПокупателя;
					КонецЕсли;
					Если СтруктураДанныхСтроки.Свойство("ПриложениеКДоговору") Тогда
						СтрокаТЧ.ПриложениеКДоговору = СтруктураДанныхСтроки.ПриложениеКДоговору;
					КонецЕсли;
					Если СтруктураДанныхСтроки.Свойство("УчетПриложений") Тогда
						СтрокаТЧ.УчетПриложенийПоДоговору = СтруктураДанныхСтроки.УчетПриложений;
					КонецЕсли;
					
				КонецЕсли;
				
			Иначе
				СтруктураПараметров 	= ПодготовитьДанныеДляПолученияДанныхпокупателя(СтрокаТЧ.ПолучитьИдентификатор());
				СтруктураДанныхСтроки 	= ПолучитьДанныеПокупателя(СтруктураПараметров);
				
				Если СтруктураДанныхСтроки.Свойство("Покупатель") Тогда
					СтрокаТЧ.Покупатель 		 = СтруктураДанныхСтроки.Покупатель;
				КонецЕсли;
				Если СтруктураДанныхСтроки.Свойство("ДоговорПокупателя") Тогда
					СтрокаТЧ.ДоговорПокупателя 	 = СтруктураДанныхСтроки.ДоговорПокупателя;
				КонецЕсли;
				Если СтруктураДанныхСтроки.Свойство("ПриложениеКДоговору") Тогда
					СтрокаТЧ.ПриложениеКДоговору = СтруктураДанныхСтроки.ПриложениеКДоговору;
				КонецЕсли;
				Если СтруктураДанныхСтроки.Свойство("УчетПриложений") Тогда
					СтрокаТЧ.УчетПриложенийПоДоговору = СтруктураДанныхСтроки.УчетПриложений;
				КонецЕсли;
				
			КонецЕсли; 
			
			Если (ЗначениеЗаполнено(СН.Подразделение)) Тогда
				
				СтрокаТЧ.Подразделение = СН.Подразделение;
				
			Иначе
				
				_ПодставитьПодразделение(СтрокаТЧ);
				
			КонецЕсли; 
			
			// --- 
			
		КонецЦикла; 
		// --- 
		ОбновитьИтогиПоУслугам();
		ЗаполнитьДополнительныеКолонкиТабличнойЧасти();
		
		
		#Область Динамический_вывод_дополнительных_колонок
		
		_УФС.ОбновитьЗначенияПараметровГрузоперевозок(ПолучитьСтруктуруПараметровДляПередачи());
		
		#КонецОбласти			
		
	КонецЕсли; 
	
	// --- 
КонецПроцедуры 

#КонецОбласти 

