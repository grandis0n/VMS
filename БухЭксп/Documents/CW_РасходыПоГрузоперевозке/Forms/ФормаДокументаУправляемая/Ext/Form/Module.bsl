&НаКлиенте
Процедура ПредъявленСФПриИзмененииНаКлиенте()
	
	Если Объект.ПредъявленСФ Тогда
		Если Не ЗначениеЗаполнено(Объект.ДатаСФ) Тогда
			Если ЗначениеЗаполнено(Объект.ДатаАкта) Тогда
				Объект.ДатаСФ = Объект.ДатаАкта;
			Иначе
				Объект.ДатаСФ = Объект.Дата;
			КонецЕсли;
		КонецЕсли;
		Если Объект.КодСпособаПолученияСФ = 0 Тогда
			Объект.КодСпособаПолученияСФ = 1;
		КонецЕсли;
	Иначе
		Если Не СохранятьРеквизитыПервичныхДокументов Тогда
			ДатаСФ  = Неопределено;
			НомерСФ = Неопределено
		КонецЕсли;
	КонецЕсли;
	
	ПервичныеДокументыУправлениеЭлементамиФормы();
	
	ОбновитьНомераДокументовНаСервере();
	
КонецПроцедуры

