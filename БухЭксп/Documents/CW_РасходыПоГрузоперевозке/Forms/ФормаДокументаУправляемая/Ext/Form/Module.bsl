&НаСервере
Процедура ЗаполнитьСписокКодовОпераций()
	
	ИспользоватьКоды2015 = Ложь;
	Если Объект.Дата >= '20150101' Тогда 
		ИспользоватьКоды2015 = Истина;
	КонецЕсли;

	ДатаЗаполнения = Объект.Дата;
	Если  Объект.ПредъявленСФ И ЗначениеЗаполнено(Объект.ДатаСФ) Тогда
		ДатаЗаполнения = Объект.ДатаСФ;
	КонецЕсли; 
	
	CW_БухгалтерияЭкспедитораСерверПереопределяемый.ЗаполнитьСписокКодовВидовОпераций(
		ПредопределенноеЗначение("Перечисление.ЧастиЖурналаУчетаСчетовФактур.ПолученныеСчетаФактуры"), 
		Элементы.КодВидаОперации.СписокВыбора,
		ДатаЗаполнения);
		
КонецПроцедуры
	
&НаСервере
Процедура ПервичныеДокументыПриСозданииНаСервере()
	
	РедактированиеФинансов_Расходы_Счета 	= CW_ПраваДоступа.ПравоДоступно("РедактированиеФинансов_Расходы_Счета");
	РедактированиеФинансов_Расходы_Акты	 	= CW_ПраваДоступа.ПравоДоступно("РедактированиеФинансов_Расходы_Акты");
	
	РаздельныйУчетНДСНаСчете19 			= CW_БухгалтерияЭкспедитораСерверПереопределяемый.РаздельныйУчетНДСНаСчете19(Объект.Организация, Объект.Дата);
	ПлательщикНДС 						= УчетнаяПолитика.ПлательщикНДС(Объект.Организация, Объект.Дата);
	ПоставщикРезидентТаможенногоСоюза	= CW_БухгалтерияЭкспедитораСерверПереопределяемый.КонтрагентРезидентТаможенногоСоюза(Объект.Контрагент);
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("Договор", 			Объект.Договор);
	СтруктураПараметров.Вставить("ПриложениеКДоговору",	Объект.ПриложениеКДоговору);
	
	УчетныйДоговор = CW_Финансы.ПолучитьУчетныйДоговор(СтруктураПараметров);

	Если ЗначениеЗаполнено(УчетныйДоговор) Тогда
		СвойстваДоговора = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(УчетныйДоговор, "ВидДоговора,НДСПоСтавкам4и2,ВидАгентскогоДоговора");
		НДСИсчисляетсяНалоговымАгентом = СвойстваДоговора.ВидАгентскогоДоговора = Перечисления.ВидыАгентскихДоговоров.РеализацияТоваров;
	Иначе
		НДСИсчисляетсяНалоговымАгентом = Ложь;
	КонецЕсли;

	УстановитьОписаниеСрокаОплаты();
	УстановитьОписаниеПланОплаты();
	
	УстановитьПривилегированныйРежим(Истина);
	ГруппаПользователя = CW_ПраваДоступа_ПИ.ГруппаПользователя(ПараметрыСеанса.ТекущийПользователь);
	УстановитьПривилегированныйРежим(Ложь);
	
	СрокОплатыДоступен = 	ГруппаПользователя = Справочники.CW_ГруппыПользователей.Администраторы 
							Или ГруппаПользователя.РедактированиеСроковОплатыИсходящихСчетов
							Или ГруппаПользователя.ПолныеПрава;
	ПланОплатыДоступен = 	ГруппаПользователя = Справочники.CW_ГруппыПользователей.Администраторы 
							Или ГруппаПользователя.РедактированиеФинансов_Доходы_Счета
							Или ГруппаПользователя.ПолныеПрава;
							
	// если формирование ведомых документов установлено датой ведущего документа,
	// то время акта не требуется и кнопку для определения времени можно скрыть
	Если Объект.ФормироватьВедомыеДатойДокумента Тогда
		Элементы.ПервичныеДокументыВремяАкта.Видимость = Ложь;
	КонецЕсли;
	
	Элементы.ГруппаСчет.Доступность 			= РедактированиеФинансов_Расходы_Счета;
	Элементы.ГруппаАктСчетФактура.Доступность 	= РедактированиеФинансов_Расходы_Акты;
	
	КонтрольДокументовПоСумме = CW_Настройки.ПолучитьНастройкуПользователя(CW_Настройки.Пользователь(),"КонтрольВходящихДокументовПоСумме");
	Если КонтрольДокументовПоСумме = Неопределено Тогда
		КонтрольДокументовПоСумме = Ложь;
	КонецЕсли; 
	Элементы.ГруппаКонтрольнаяСумма.Видимость = КонтрольДокументовПоСумме;
	
	ПервичныеДокументыУправлениеЭлементамиФормы();
	
КонецПроцедуры

&НаСервере
Процедура ПервичныеДокументыУправлениеЭлементамиФормы()
	
	Элементы.ПервичныеДокументыКоманднаяПанель.Видимость	= ВалютаРегламентированногоУчетаРубль и НЕ Объект.Корректировка;
	Элементы.ПервичныеДокументыКоманднаяПанель.Видимость	= ВалютаРегламентированногоУчетаРубль и НЕ Объект.Корректировка;
	
	
	Элементы.ГруппаАктСчетФактура.Видимость	= ВалютаРегламентированногоУчетаРубль;
	Элементы.ГруппаКнопки.Видимость 		= ВалютаРегламентированногоУчетаРубль;
	
	// счет
	Элементы.ПредъявленСчет.Доступность 	= РедактированиеФинансов_Расходы_Счета;
	Элементы.НомерСчета.ТолькоПросмотр 		= НЕ Объект.ПредъявленСчет и НЕ РедактированиеФинансов_Расходы_Счета;
	Элементы.ДатаСчета.ТолькоПросмотр		= НЕ Объект.ПредъявленСчет и НЕ РедактированиеФинансов_Расходы_Счета;
	Элементы.ПервичныеДокументыДатаСчета.Доступность = Объект.ПредъявленСчет и РедактированиеФинансов_Расходы_Счета;
	
	Элементы.ПервичныеДокументыВремяСчета.Доступность = РедактированиеФинансов_Расходы_Счета 
														и НЕ (Объект.ПредъявленСчет 
																И Объект.СпособЗачетаАвансовОЗ = ПредопределенноеЗначение("Перечисление.СпособыЗачетаАвансов.Автоматически") 
																И НачалоДня(Объект.ДатаСчета)=НачалоДня(Объект.Дата));

	Элементы.СрокОплаты.Доступность =  РедактированиеФинансов_Расходы_Счета И Объект.ПредъявленСчет И СрокОплатыДоступен; 	
	Элементы.ПервичныеДокументыУстановитьСрокОплаты.Доступность = РедактированиеФинансов_Расходы_Счета И Объект.ПредъявленСчет И СрокОплатыДоступен; 
	
	Элементы.ПервичныеДокументыУстановитьСрокОплаты.Видимость = РедактированиеФинансов_Расходы_Счета И НЕ Объект.Ссылка.Пустая(); 
	Элементы.СпособЗачетаАвансовОЗ.Видимость = РедактированиеФинансов_Расходы_Счета И Объект.ПредъявленСчет И ОперативныйУчет;
	
	Если ВалютаРегламентированногоУчетаРубль тогда
		СтруктураПараметровБухУчета = Новый Структура;
		СтруктураПараметровБухУчета.Вставить("Договор", 				Объект.Договор);
		СтруктураПараметровБухУчета.Вставить("ПриложениеКДоговору",		Объект.ПриложениеКДоговору);
		
		ПараметрыБухгалтерскогоУчета = CW_Финансы.ПолучитьПарметрыВеденияБухгалтерскогоУчета(СтруктураПараметровБухУчета, Объект.Дата);
		
		Элементы.ПредъявленАкт.Доступность	= ВалютаРегламентированногоУчетаРубль и НЕ Объект.Корректировка;
	
		// акт
		Элементы.НомерАкта.ТолькоПросмотр	= НЕ РедактированиеФинансов_Расходы_Акты И НЕ Объект.ПредъявленАкт;
		Элементы.ДатаАкта.ТолькоПросмотр 	= НЕ РедактированиеФинансов_Расходы_Акты И НЕ Объект.ПредъявленАкт;
		Элементы.ПервичныеДокументыВремяАкта.Доступность = РедактированиеФинансов_Расходы_Акты И Объект.ПредъявленАкт;
		Элементы.ПервичныеДокументыДатаАкта.Доступность  = РедактированиеФинансов_Расходы_Акты И Объект.ПредъявленАкт;
		Элементы.СпособЗачетаАвансов.Видимость = РедактированиеФинансов_Расходы_Акты И Объект.ПредъявленАкт И ПараметрыБухгалтерскогоУчета.БухгалтерскийУчет И НЕ Объект.Корректировка;
		Элементы.Счет.ТолькоПросмотр = НЕ РедактированиеФинансов_Расходы_Акты И НЕ Объект.ПредъявленАкт;
		Элементы.СписокСчетов.Доступность = РедактированиеФинансов_Расходы_Акты И Объект.ПредъявленАкт;
		Элементы.ГруппаАктирование.Видимость = РедактированиеФинансов_Расходы_Акты И НЕ Объект.ПредъявленСчет;
		Элементы.Счет.Видимость = РедактированиеФинансов_Расходы_Акты И НЕ Объект.СписокСчетов; 
		
		//AFR23-3305
		Элементы.ПервичныеДокументыПодборСчетов.Видимость = Не Объект.Корректировка;
		//AFR23-3305
		
		Элементы.ЭтоУниверсальныйДокумент.Доступность = РедактированиеФинансов_Расходы_Акты И Объект.ПредъявленАкт;
		
		// с/ф 
		Если Объект.КорректируемыйДокумент.ПредъявленСФ Тогда
			Элементы.ПредъявленСФ.Доступность = Ложь;
		Иначе
			Элементы.ПредъявленСФ.Доступность = Объект.ПредъявленАкт и РедактированиеФинансов_Расходы_Акты и Не Объект.Корректировка;
		КонецЕсли;
		
		Элементы.НомерСФ.ТолькоПросмотр = Не РедактированиеФинансов_Расходы_Акты И НЕ Объект.ПредъявленСФ;
		Элементы.ДатаСФ.ТолькоПросмотр 	= Не РедактированиеФинансов_Расходы_Акты И НЕ Объект.ПредъявленСФ;
		Элементы.ПервичныеДокументыДатаСчетФактуры.Доступность 	= РедактированиеФинансов_Расходы_Акты И Объект.ПредъявленСФ;
		Элементы.Продавец.ТолькоПросмотр 		= Не РедактированиеФинансов_Расходы_Акты;
		Элементы.Продавец.Видимость 			= РедактированиеФинансов_Расходы_Акты И Объект.ПредъявленСФ И НЕ Объект.Корректировка;
		Элементы.КодСпособаПолученияСФ.Видимость 	= РедактированиеФинансов_Расходы_Акты И Объект.ПредъявленСФ;
		
		Элементы.ГруппаДопРеквизитыСчф.Видимость = РедактированиеФинансов_Расходы_Акты И Объект.ПредъявленСФ И НЕ Объект.Корректировка;
		// --- 
		Элементы.КодВидаОперации.Видимость = РедактированиеФинансов_Расходы_Акты и Объект.ПредъявленСФ; // И НЕ Объект.Корректировка;
		Элементы.КодВидаОперации.Доступность = РедактированиеФинансов_Расходы_Акты;
		
		Элементы.ПервичныеДокументыВремяАкта.Доступность = РедактированиеФинансов_Расходы_Акты и
															НЕ ( Объект.ПредъявленАкт 
																 И Объект.СпособЗачетаАвансов = ПредопределенноеЗначение("Перечисление.СпособыЗачетаАвансов.Автоматически")
																 И НачалоДня(Объект.ДатаАкта)=НачалоДня(Объект.Дата));
		
		Элементы.ГруппаПолучение.Видимость = Объект.ПредъявленСФ;
		
		Элементы.НДСПредъявленКВычету.Видимость  = УчетНДСКлиентСервер.Версия(Объект.Дата) > 1 
													И НЕ Объект.Корректировка
													И Не РаздельныйУчетНДСНаСчете19
													И Не ПоставщикРезидентТаможенногоСоюза
													И ПлательщикНДС
													И НЕ НДСИсчисляетсяНалоговымАгентом;

		
	КонецЕсли;
	
	// план оплаты
	Элементы.ПланОплаты.Видимость = РедактированиеФинансов_Расходы_Счета И Объект.ПредъявленСчет И ОперативныйУчет И ПланОплатыДоступен;
	
	// срок оплаты
	Элементы.СрокОплаты.Видимость = РедактированиеФинансов_Расходы_Счета И  Объект.ПредъявленСчет И СрокОплатыДоступен; 
	Элементы.ПервичныеДокументыУстановитьСрокОплаты.Видимость = РедактированиеФинансов_Расходы_Счета И  Объект.ПредъявленСчет И СрокОплатыДоступен И НЕ  Объект.Корректировка;
	
	Элементы.УслугиГруппаСчет.Видимость = Объект.СписокСчетов; 
	
	//AFR23-3305
	Элементы.УслугиКорректировкаГруппаСчет.Видимость = Объект.СписокСчетов и Объект.Корректировка; 
	//AFR23-3305
	
	Если Объект.ПредъявленСчет И НЕ Объект.ПредъявленАкт Тогда
		Элементы.ГруппаКонтрольнаяСумма.Доступность = РедактированиеФинансов_Расходы_Счета;
	Иначе
		Элементы.ГруппаКонтрольнаяСумма.Доступность = РедактированиеФинансов_Расходы_Акты;
	КонецЕсли; 

	//Исправления
	Элементы.НомерИсправления.Доступность 			= РедактированиеФинансов_Расходы_Акты И Объект.ПредъявленСФ;
	//Исправления
	
КонецПроцедуры

&НаКлиенте
Процедура СчетПриИзменении(Элемент)
	
	ОбновитьНомераДокументовНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ПродавецПриИзменении(Элемент)
	
	ОбновитьНомераДокументовНаСервере();

КонецПроцедуры

#КонецОбласти

//Исправления
&НаКлиенте
Процедура ВидОперацииКорректировкиПриИзменении(Элемент)
	
	ВидОперацииКорректировкиПриИзмененииНаСервере();
	
КонецПроцедуры   

&НаСервере
Процедура ВидОперацииКорректировкиПриИзмененииНаСервере()
	
	Если Объект.ВидОперацииКорректировки = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсправленияПоступленияРеализации.СогласованноеИзменение") Тогда
		Объект.НомерИсправления = 0;
	Иначе
		ИсправлениеПолучитьНомерНаСервере();
	КонецЕсли;   
	
	ОбновитьНомераДокументовНаСервере();
	
	УстановитьВидимостьЭлементовИсправления();
	
КонецПроцедуры

&НаСервере
Процедура ИсправлениеПолучитьНомерНаСервере()
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ CW_РасходыПоГрузоперевозке.Ссылка) КАК Ссылка
	               |ИЗ
	               |	Документ.CW_РасходыПоГрузоперевозке КАК CW_РасходыПоГрузоперевозке
	               |ГДЕ
	               |	CW_РасходыПоГрузоперевозке.КорректируемыйДокумент = &КорректируемыйДокумент
	               |	И CW_РасходыПоГрузоперевозке.Ссылка <> &Ссылка";
	
	Запрос.УстановитьПараметр("КорректируемыйДокумент", Объект.КорректируемыйДокумент);
	Запрос.УстановитьПараметр("Ссылка",	Объект.Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	ВсегоИсправлений = 0;
	Если Выборка.Следующий() Тогда
		ВсегоИсправлений = Выборка.Ссылка;
	КонецЕсли;
	
	ВсегоИсправлений = ВсегоИсправлений + 1;
	
	Объект.НомерСФ = Объект.КорректируемыйДокумент.НомерСФ; 
	Объект.ДатаСФ  = ТекущаяДата(); 
	
	Объект.НомерИсправления  = ВсегоИсправлений; 
	
	ОбновитьНомераДокументовНаСервере();

КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьЭлементовИсправления()

	Элементы.ГруппаОперацияИсправления.Видимость  	= Объект.Корректировка;
	Элементы.НомерИсправления.Видимость 			= Объект.Корректировка и Объект.ВидОперацииКорректировки = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсправленияПоступленияРеализации.ИсправлениеОшибки"); 
	
	ПоказатьПередКорректировкой = НужноПоказатьПередКорректировкой();
	
	Элементы.УслугиКорректировкаНадписьПередКорректировкой.Видимость		= ПоказатьПередКорректировкой;
	Элементы.УслугиКорректировкаПредставление_ПередКорректировкой.Видимость	= ПоказатьПередКорректировкой;
	Элементы.УслугиКорректировкаКоличество_ПередКорректировкой.Видимость	= ПоказатьПередКорректировкой;
	Элементы.УслугиКорректировкаЦена_ПередКорректировкой.Видимость 			= ПоказатьПередКорректировкой;
	Элементы.УслугиКорректировкаСумма_ПередКорректировкой.Видимость 		= ПоказатьПередКорректировкой;
	Элементы.УслугиКорректировкаСтавкаНДС_ПередКорректировкой.Видимость 	= ПоказатьПередКорректировкой;
	Элементы.УслугиКорректировкаНДС_ПередКорректировкой.Видимость 			= ПоказатьПередКорректировкой;
	Элементы.УслугиКорректировкаВсего_ПередКорректировкой.Видимость 		= ПоказатьПередКорректировкой;  
	
	Элементы.УслугиКорректировкаВсего_ПередКорректировкойРег.Видимость 		= ПоказатьПередКорректировкой и Объект.ПоказатьРубли;  
	Элементы.УслугиКорректировкаНДС_ПередКорректировкойРег.Видимость 		= ПоказатьПередКорректировкой и Объект.ПоказатьРубли;  
	Элементы.УслугиКорректировкаСумма_ПередКорректировкойРег.Видимость 		= ПоказатьПередКорректировкой и Объект.ПоказатьРубли;  
	Элементы.УслугиКорректировкаЦена_ПередКорректировкойРег.Видимость 		= ПоказатьПередКорректировкой и Объект.ПоказатьРубли;  
	
	Элементы.УслугиКорректировкаПокупатель_ПередКорректировкой.Видимость 			= ПоказатьПередКорректировкой;
	Элементы.УслугиКорректировкаДоговорПокупателя_ПередКорректировкой.Видимость		= ПоказатьПередКорректировкой;
	Элементы.УслугиКорректировкаПриложениеКДоговору_ПередКорректировкой.Видимость 	= ПоказатьПередКорректировкой;
	
