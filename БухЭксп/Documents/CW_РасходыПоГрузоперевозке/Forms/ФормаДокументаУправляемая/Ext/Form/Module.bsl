	Элементы.ГруппаИнфо.Видимость = Ложь;
	// --- 
	Элементы.УслугиИзменить.Доступность = Истина;
	Элементы.УслугиУслуги_ПереформироватьПредставление.Доступность = Истина;
	Элементы.УслугиГруппаЗаполнить.Видимость = Истина;
	// --- 
	Элементы.ЗачетАвансов.ТолькоПросмотр = Ложь;
	Элементы.ЗачетАвансовОЗ.ТолькоПросмотр = Ложь;
	// --- 
	Элементы.ЗачетАвансовЗаполнитьАвансы.Доступность = Истина;
	Элементы.ЗачетАвансовОЗ_Заполнить.Доступность = Истина;
	// --- 
	Элементы.ЗачетАвансовАвансы_Открыть.Доступность = Истина;
	Элементы.ЗачетАвансовОЗ_Открыть.Доступность = Истина;
	// --- 
	Элементы.ЗачетАвансовУдалить.Доступность = Истина;
	Элементы.ЗачетАвансовОЗ_Удалить.Доступность = Истина;
	// --- 
	Элементы.ЗачетАвансовАвансы_Очистить.Доступность = Истина;
	Элементы.ЗачетАвансовОЗ_Очистить.Доступность = Истина;
	
	Элементы.Заявки.ТолькоПросмотр = ложь;
	Элементы.СоздатьЗаявку.Доступность = Истина;
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	Если ЗначениеЗаполнено(ИдентификаторДокументаПоставщика) Тогда
		ТекущийОбъект.ИдентификаторДокументаПоставщика = Новый УникальныйИдентификатор(ИдентификаторДокументаПоставщика);
	КонецЕсли;	
		
	CW_Документы.ПередЗаписьюНаСервере(ЭтотОбъект, Отказ);
	
	//Подсистема.ГруппыУслугПриложенийИДоговоров
	CW_ГруппыУслугСервер.ПередЗаписьюНаСервере(ЭтаФорма, Отказ, ТекущийОбъект, ПараметрыЗаписи);
	//Подсистема.ГруппыУслугПриложенийИДоговоров
	
	//Подсистема.СтатусыДокументов
	CW_СтатусыДокументовСервер.ПередЗаписьюНаСервере(ЭтаФорма, Отказ, ТекущийОбъект, ПараметрыЗаписи);
	//Подсистема.СтатусыДокументов
	
	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствами.ПередЗаписьюНаСервере(ЭтотОбъект, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.Свойства
	
	// признак интерактивного режима
	_сф.ст_УстановитьСвойство(ТекущийОбъект.ДополнительныеСвойства,"ИнтерактивныйРежим",Истина);
	
	// тут перенесём доп. свойства в дополнительные свойства объекта
	_сф.ст_ДобавитьСвойства(ТекущийОбъект.ДополнительныеСвойства,"*",_ДС());
	ТекущийОбъект.ДС = ТекущийОбъект.ДополнительныеСвойства;
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	ОбновитьНомераДокументовНаСервере();
	_СформироватьЗаголовок();
	// --- 
	_УправлениеЭлементамиФормы();
	// --- 
	ЗаполнитьДополнительныеКолонкиТабличнойЧасти();
	// --- 
	НачальнаяДатаДокумента = Объект.Дата;
	
	//Подистема.CW_ПланированиеДДС
	CW_ПланированиеДДССервер.ПослеЗаписиНаСервере(ЭтаФорма, ТекущийОбъект, ПараметрыЗаписи); 
	//Подистема.CW_ПланированиеДДС
	
	//Подсистема.СтатусыДокументов
	CW_СтатусыДокументовСервер.ПослеЗаписиНаСервере(ЭтаФорма, ТекущийОбъект, ПараметрыЗаписи);
	//Подсистема.СтатусыДокументов
	
	//Подсистема.ОригиналыДокументов
	CW_ОригиналыДокументовСервер.ПослеЗаписиНаСервере(ЭтаФорма, ТекущийОбъект, ПараметрыЗаписи);
	//Подсистема.ОригиналыДокументов
	
	//Подсистема.УчетПриложенийДоговоров
	CW_УчетПриложенийДоговоровСервер.УстановитьПризнакУчетаПоПриложениямВТабличнойЧасти(ЭтаФорма, "Услуги", "ДоговорПокупателя");
	//Подсистема.УчетПриложенийДоговоров
	
	//план оплаты
	Если _ДС().ПД.АвтоматическиРасчитыватьПланОплатыПриЗаписиДокумента тогда
		РассчитатьПлановуюДатуОплатыНаСервере(Истина, Ложь);
	КонецЕсли;
	//план оплаты   

	//Взаиморасчеты по документу
	CW_ВзаиморасчетыПоДокументуСервер.УстановитьНазваниеСсылкиОтчета(ЭтаФорма, Объект.ПредъявленСчет);
	//Взаиморасчеты по документу
	
	//СрокОплаты
	Если ЭтоНовыйОбъект Тогда
		Если Не _СрокОплатыРучноеРедактирование Тогда
			УстановитьСрокОплатыНаСервере();
		Иначе
			ЗаписатьСрокОплатыДокумента();
			УстановитьОписаниеСрокаОплаты();             
		КонецЕсли;
	КонецЕсли;
	//СрокОплаты
	

	_УФС.ОбновитьЗначенияПараметровГрузоперевозок(ПолучитьСтруктуруПараметровДляПередачи());
	
КонецПроцедуры


&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	//Подсистема.РаботаСПодключаемымиОбъектами
	CW_ПодключаемыеКомандыКлиент.ПослеЗаписи(ЭтотОбъект, ПараметрыЗаписи);
	//Подсистема.РаботаСПодключаемымиОбъектами
	
	//Срок оплаты
	ДанныеСрокаОплаты = CW_Документы.ПолучитьСрокОплаты(Объект.Ссылка);
	ДанныеСрокаОплаты.Свойство("ДатаОплаты",			_СрокОплаты);
	ДанныеСрокаОплаты.Свойство("Описание",				_СрокОплатыОписание);
	ДанныеСрокаОплаты.Свойство("РучноеРедактирование",	_СрокОплатыРучноеРедактирование);
	
	УстановитьОписаниеСрокаОплаты();
	//Срок оплаты
	
	ОповеститьОбИзменении(Объект.Ссылка);
	_УправлениеЭлементамиФормы();
	
	Если (НЕ Объект.Корректировка) Тогда
		
		Если (ЗначениеЗаполнено(Объект.ВедомыйСчет)) Тогда
			ОповеститьОбИзменении(Объект.ВедомыйСчет);
		КонецЕсли;
		Если (ЗначениеЗаполнено(Объект.ВедомыйДокумент)) Тогда
			ОповеститьОбИзменении(Объект.ВедомыйДокумент);
		КонецЕсли; 
		Если (ЗначениеЗаполнено(Объект.ВедомыйСчетФактура)) Тогда
			ОповеститьОбИзменении(Объект.ВедомыйСчетФактура);
		КонецЕсли; 
		
	Иначе
		
		Если (ЗначениеЗаполнено(Объект.ВедомыйДокументКорректировки)) Тогда
			ОповеститьОбИзменении(Объект.ВедомыйДокументКорректировки);
		КонецЕсли; 
		Если (ЗначениеЗаполнено(Объект.ВедомыйСчетФактураКорректировочный)) Тогда
			ОповеститьОбИзменении(Объект.ВедомыйСчетФактураКорректировочный);
		КонецЕсли;

	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если (ИмяСобытия = "ВыполненаЗаписьДокумента") Тогда
		
		Прочитать();
		_УправлениеЭлементамиФормы();
		
	ИначеЕсли ИмяСобытия = "ОбновитьСписокУслугПоПротоколу" Тогда
		
		УстановитьАдресСпискаУслугПоДоговору();
		
	ИначеЕсли ИмяСобытия = "ВыполнитьМетодВладельца" Тогда
		
		Если ТипЗнч(Параметр) = тип("Структура") Тогда
			УникальныйИдентификаторВладельца 	= Неопределено;
			МетодыФормыВладельца 				= Неопределено;
			
			Параметр.Свойство("УникальныйИдентификатор"	, УникальныйИдентификаторВладельца);
			Параметр.Свойство("МетодыФормыВладельца"	, МетодыФормыВладельца);
			
			Если ЭтаФорма.УникальныйИдентификатор = УникальныйИдентификаторВладельца Тогда
				Если Не МетодыФормыВладельца = Неопределено и ТипЗнч(МетодыФормыВладельца) = Тип("Массив") Тогда
					
					Для Каждого СтрокаМассива из МетодыФормыВладельца Цикл
						Попытка
							Выполнить(СтрокаМассива);
						Исключение
						КонецПопытки;
					КонецЦикла;
					
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;	
		
	ИначеЕсли ИмяСобытия = "ОбновитьКоментарийДоговораНаФрме" Тогда
		
		УстановитьЗаголовокНадписиКомментарияДоговора();
		
	ИначеЕсли ИмяСобытия = "ОбновитьАдресУслугДоговора" Тогда
		
		ОбработатьОповещениеИзмененияСпискаУслуг() ;
		
	ИначеЕсли ИмяСобытия = "Запись_CW_Грузоперевозки" Тогда
		
		#Область Динамический_вывод_дополнительных_колонок
		
		ОбновитьЗначенияПараметровГрузоперевозокнаСервере();
		
		#КонецОбласти
		
	//Подистема.CW_ПланированиеДДС
	ИначеЕсли ИмяСобытия = "Запись_CW_ПланированиеДДС" Тогда
		
		ОбновитьЗаголовокСтраницы()
	//Подистема.CW_ПланированиеДДС
	
	//Наличие прикрепленных файлов
	ИначеЕсли ИмяСобытия = "ОбновитьНаличиеПрикрепленныхФайлов" Тогда
	
		ОбработатьОповещениеОбновитьНаличиеПрикрепленныхФайлов();
	//Наличие прикрепленных файлов
		
		//Подсистема.СтатусыДокументов
	ИначеЕсли ИмяСобытия = "Изменение_СтатусДокумента" Тогда
		
		ОбработатьОповещениеИзменениеСтатусДокументаНаСервере();
		//Подсистема.СтатусыДокументов

		//Подсистема.СогласованиеОбъктов 
	ИначеЕсли ИмяСобытия = "Изменение_СогласованиеОбъектов" Тогда
		
		  CW_СогласованиеКлиент.ОбновитьСтатусОбъекта(Истина, ЭтаФорма);
		//Подсистема.СогласованиеОбъктов
		
	КонецЕсли;
	
	// СтандартныеПодсистемы.Свойства
	Если УправлениеСвойствамиКлиент.ОбрабатыватьОповещения(ЭтотОбъект, ИмяСобытия, Параметр) Тогда
		ОбновитьЭлементыДополнительныхРеквизитов();
		УправлениеСвойствамиКлиент.ПослеЗагрузкиДополнительныхРеквизитов(ЭтотОбъект);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.Свойства
	
	
КонецПроцедуры

