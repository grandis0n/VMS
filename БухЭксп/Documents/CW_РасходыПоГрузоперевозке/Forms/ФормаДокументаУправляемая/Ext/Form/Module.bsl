КонецПроцедуры

#КонецОбласти 

#Область АвтоматическийПодборСчетов 

&НаКлиенте
Процедура АвтоматическийПодборСчетов()
	// --- 
	
	Если (Объект.Проведен) Тогда
		
		ПОВ = Новый ОписаниеОповещения("ОбработкаВопросаОтменыПроведения",ЭтотОбъект); 
		ПоказатьВопрос(ПОВ,"Автоматический подбор счетов возможен только для непроведённого документа. Отменить проведение?",РежимДиалогаВопрос.ДаНет);
		
	Иначе
		
		ВыполнитьАвтоматическийПодборСчетов();
		
	КонецЕсли; 
	
	// --- 
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВопросаОтменыПроведения(ОтветПользователя, ДополнительныеПараметры) Экспорт 
	// --- 
	
	Если (ОтветПользователя = КодВозвратаДиалога.Да) Тогда
		
		Записать(Новый Структура("РежимЗаписи",РежимЗаписиДокумента.ОтменаПроведения));
		ВыполнитьАвтоматическийПодборСчетов();
		
	КонецЕсли; 
	
	// --- 
КонецПроцедуры
  
&НаКлиенте
Процедура ВыполнитьАвтоматическийПодборСчетов()
	// --- 
	
	// показываем форму выбора даты подбора
	ПОВ = Новый ОписаниеОповещения("ОбработкаВыбораВариантаПодбора",ЭтотОбъект); 
	ОткрытьФорму("ОбщаяФорма.CW_ФормаВыбораДатыПодбораСчетов",,,,,,ПОВ,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
	// --- 
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбораВариантаПодбора(ВариантВыбораДатыПодбора, ДополнительныеПараметры) Экспорт 
	// --- 
	
	Если (ВариантВыбораДатыПодбора <> Неопределено) Тогда
		
		Результат = _ВыполнитьПодборСчетов(ВариантВыбораДатыПодбора);
		Если (_УФКС.ВыполненоУспешно(Результат)) Тогда
			
			ОбновитьНомераДокументовНаСервере();
			_УправлениеЭлементамиФормы();
			_УФК.ВывестиПредупреждение(_УФКС.ПредставлениеОшибки(Результат));
			
		КонецЕсли; 
		
	КонецЕсли; 
	
	// --- 
КонецПроцедуры

&НаСервере
Функция _ВыполнитьПодборСчетов(ВариантПодбора)
	
	ДокументОбъект = РеквизитФормыВЗначение("Объект");

	Ответ = ДокументОбъект.АвтоматическийПодборСчетов(ВариантПодбора); 
	
	ЗначениеВРеквизитФормы(ДокументОбъект,"Объект");    
	
	Возврат(Ответ);
	
КонецФункции
 
#КонецОбласти 

#Область ЗаполнениеПоДокументу

&НаКлиенте
Процедура ЗаполнитьПоДокументуПоставщика(Команда)
	
	СтруктураОтбора = Новый Структура("Договор",Объект.Договор);
							
	СтруктураПараметровВыбора = Новый Структура;
	СтруктураПараметровВыбора.Вставить("РежимВыбора", 			Истина);
	СтруктураПараметровВыбора.Вставить("МножественныйВыбор", 	Истина);
	СтруктураПараметровВыбора.Вставить("Отбор", 				СтруктураОтбора);
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ОбработкаВыбораДокументаДляЗаполнения",ЭтотОбъект); 
	
	ОткрытьФорму("Документ.CW_РасходыПоГрузоперевозке.ФормаВыбора",СтруктураПараметровВыбора,ЭтаФорма,,,,ОписаниеОповещения,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбораДокументаДляЗаполнения(РезультатВыбора, ДополнительныеПараметры) Экспорт 

	Если РезультатВыбора = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОбработкаВыбораДокументаДляЗаполненияНаСервере(РезультатВыбора);
	
КонецПроцедуры  

&НаСервере
Процедура ОбработкаВыбораДокументаДляЗаполненияНаСервере(РезультатВыбора)
	
	Для Каждого ДокументСсылка из РезультатВыбора Цикл
		ДобавитьСтрокиДокумента(ДокументСсылка);
	КонецЦикла; 
	
	ЗаполнитьДополнительныеКолонкиТабличнойЧасти();
	ОбновитьНомераДокументовНаСервере();
	_УправлениеЭлементамиФормы();
	
	#Область Динамический_вывод_дополнительных_колонок
	
	_УФС.ОбновитьЗначенияПараметровГрузоперевозок(ПолучитьСтруктуруПараметровДляПередачи());
	
	#КонецОбласти
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьСтрокиДокумента(Документ)
	
	ЗаполнятьАктируемыйСчет = (Документ.ПредъявленСчет И НЕ Документ.ПредъявленАкт) 
		И (Объект.ПредъявленАкт И НЕ Объект.ПредъявленСчет);
	
	Если ЗаполнятьАктируемыйСчет 
		и НЕ Объект.СписокСчетов Тогда
		Объект.СписокСчетов = Истина;
		Если ЗначениеЗаполнено(Объект.Счет) Тогда
			Для каждого СтрокаУслуг Из Объект.Услуги Цикл
				СтрокаУслуг.Счет = Объект.Счет;		
			КонецЦикла; 	
		КонецЕсли; 
	КонецЕсли; 

	Для каждого СтрокаДокумента Из Документ.Услуги Цикл
		
		НоваяСтрока = Объект.Услуги.Добавить();
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаДокумента);
		
		Если ЗаполнятьАктируемыйСчет Тогда
			НоваяСтрока.Счет = Документ;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(НоваяСтрока.Подразделение) Тогда 
			НоваяСтрока.Подразделение = ПодразделениеПользователя;
		КонецЕсли;
		
	КонецЦикла; 

	
КонецПроцедуры
 
#КонецОбласти 

#Область МножественноеРедактирование

&НаКлиенте
Процедура УслугиПередНачаломИзменения(Элемент, Отказ)
	
	Если (НЕ ЭтаФорма.ТолькоПросмотр) Тогда
		
		Если (Элементы.Услуги.ВыделенныеСтроки.Количество() > 1) Тогда
			
			Если (Элементы.Услуги.ТекущийЭлемент = Элементы.УслугиСпособУчетаНДС ИЛИ
				Элементы.Услуги.ТекущийЭлемент = Элементы.УслугиПодразделение) Тогда
				
				Отказ = Истина;
				// --- 
				МножественноеРедактирование();
				
			КонецЕсли; 
			
		КонецЕсли; 
		
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура МножественноеРедактирование()
	// --- 
	
	Если (Элементы.Услуги.ТекущийЭлемент = Элементы.УслугиСпособУчетаНДС) Тогда
		
		ПОВ = Новый ОписаниеОповещения("ОбработкаВыбораМножественногоЗначения",ЭтотОбъект, Новый Структура("Реквизит","СпособУчетаНДС")); 
		ОткрытьФорму("Перечисление.СпособыУчетаНДС.ФормаВыбора",,,,,,ПОВ,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
	ИначеЕсли (Элементы.Услуги.ТекущийЭлемент = Элементы.УслугиПодразделение) Тогда 
		
		ПОВ = Новый ОписаниеОповещения("ОбработкаВыбораМножественногоЗначения",ЭтотОбъект, Новый Структура("Реквизит","Подразделение")); 
		ОткрытьФорму("Справочник.ПодразделенияОрганизаций.ФормаВыбора",,,,,,ПОВ,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца); 
		
	КонецЕсли; 
	
	// --- 
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбораМножественногоЗначения(Ответ, ДополнительныеПараметры) Экспорт 
	// --- 
	
	Если (Ответ <> Неопределено) Тогда
		
		_ПроизвестиМножественноеРедактирование(Ответ, ДополнительныеПараметры.Реквизит);
		
	КонецЕсли; 
	
	// --- 
КонецПроцедуры

&НаСервере
Функция _ПроизвестиМножественноеРедактирование(Значение, Реквизит)
	// --- 
	
	Для каждого Стр Из Элементы.Услуги.ВыделенныеСтроки Цикл
		
		СтрокаТЧ = Объект.Услуги.НайтиПоИдентификатору(Стр);
		// --- 
		Если (Реквизит = "Подразделение") Тогда
			
			Если (СтрокаТЧ.ПорядокОтражения = Перечисления.CW_ПорядокОтраженияЗатрат.Затраты) Тогда
				СтрокаТЧ[Реквизит] = Значение;		
			КонецЕсли; 
			
		ИначеЕсли (Реквизит = "СпособУчетаНДС") Тогда 
			
			Если (СтрокаТЧ.ПорядокОтражения = Перечисления.CW_ПорядокОтраженияЗатрат.Затраты) Тогда
				СтрокаТЧ[Реквизит] = Значение;		
			КонецЕсли;  
			
		КонецЕсли; 
		
	КонецЦикла; 
	
	// --- 
КонецФункции

#КонецОбласти 



Процедура ЗаполнитьДополнительныеКолонкиТабличнойЧасти()
	
	ИспользютсяФинансовыеСтатусы 		= ПолучитьФункциональнуюОпцию("CW_ИспользоватьФинансовыеСтатусыГрузоперевозок");
	
	СвойстваГрузоперевозок = ПолучитьДанныеПоГрузоперевозокам();
	
	Для каждого СтрокаТаблицы Из Объект.Услуги Цикл
		
		Если Объект.Корректировка Тогда
			СтрокаТаблицы.НадписьПередКорректировкой 	= "до корректировки";
			СтрокаТаблицы.НадписьДоКорректировки 		= "до изменения";
			СтрокаТаблицы.НадписьПослеКорректировки 	= "после изменения";
		КонецЕсли;
		
		СтруктураСвойств = СвойстваГрузоперевозок.Получить(СтрокаТаблицы.Грузоперевозка);
		Если СтруктураСвойств <> Неопределено Тогда
			
			СтруктураСвойств.Свойство("ПометкаУдаления", 	СтрокаТаблицы.ГрузоперевозкаУдалена);
			
			Если ИспользютсяФинансовыеСтатусы Тогда
				СтруктураСвойств.Свойство("КартинкаФинансовыйСтатус",	СтрокаТаблицы.КартинкаФинансовыйСтатус);
			КонецЕсли;
		
			Если СтруктураСвойств.Свойство("Заблокирована") Тогда
				Если СтруктураСвойств.Заблокирована Тогда
					СтрокаТаблицы.БлокГП = АдресЗамок;
				Иначе
					СтрокаТаблицы.БлокГП = Неопределено;
				КонецЕсли;
			КонецЕсли;
			
		Конецесли;
		 
		СтрокаТаблицы.УчетПриложенийПоДоговору = CW_УчетПриложенийДоговоровСервер.ПолучитьПризнакУчетаПриложенийПоДоговору(СтрокаТаблицы.ДоговорПокупателя);
		
	КонецЦикла; 
	
КонецПроцедуры
// ---------------------------------------------------------------------------- 

&НаКлиенте
Процедура КурсВалютыНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ПОВ = Новый ОписаниеОповещения("ОбработкаВыбораКурса",ЭтотОбъект, Новый Структура()); 
	ПФ = Новый Структура("ПользовательскийКурс,Курс,Кратность,ДатаКурса,Валюта,РасчетыВУЕ",Объект.УЕ_ПользовательскийКурс,Объект.УЕ_Курс,Объект.УЕ_Кратность,_ДатаКурса(),Объект.Валюта,ВзаиморасчетыВУЕ);
	ОткрытьФорму("ОбщаяФорма.CW_ФормаКурсаДляУсловныхЕдиниц",ПФ,,,,,ПОВ,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбораКурса(Ответ, ДополнительныеПараметры) Экспорт 
	// --- 
	
	Если (Ответ <> Неопределено) Тогда
		
		Объект.УЕ_ПользовательскийКурс = Ответ.ПользовательскийКурс;
		Если (Объект.УЕ_ПользовательскийКурс) Тогда
			Объект.УЕ_Курс = Ответ.Курс;
			Объект.УЕ_Кратность = Ответ.Кратность;
		Иначе
			Объект.УЕ_Курс = 1;
			Объект.УЕ_Кратность = 1;
		КонецЕсли;
		// --- 
		_СформироватьКурс();
				
	КонецЕсли; 
	
	// --- 
КонецПроцедуры

#Область Корректировки

&НаКлиенте
Процедура УслугиКорректировкаКоличествоПриИзменении(Элемент)
	
	ПересчитатьСтрокуНаСерере(Элементы.УслугиКорректировка.ТекущиеДанные.ПолучитьИдентификатор(),Объект.ЦенаСНДС, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура УслугиКорректировкаЦенаПриИзменении(Элемент)
	
	ПересчитатьСтрокуНаСерере(Элементы.УслугиКорректировка.ТекущиеДанные.ПолучитьИдентификатор(),Объект.ЦенаСНДС, Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура УслугиКорректировкаСуммаПриИзменении(Элемент)
	
	_УслугиСуммаПриИзменении(Элементы.УслугиКорректировка.ТекущаяСтрока);
	
КонецПроцедуры

&НаКлиенте
Процедура УслугиКорректировкаСтавкаНДСПриИзменении(Элемент)
	
	ПересчитатьСтрокуНаСерере(Элементы.УслугиКорректировка.ТекущиеДанные.ПолучитьИдентификатор(),Объект.ЦенаСНДС, Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура УслугиКорректировкаНДСПриИзменении(Элемент)
	
	ТД = Элементы.УслугиКорректировка.ТекущиеДанные;
	
	Если НЕ _ДС().НП.ОбратныйПересчетВДокументах Тогда
		ТД.Всего = ТД.Сумма + ТД.НДС;
	Иначе
		ТД.Сумма = ТД.Всего - ТД.НДС;
		ТД.Цена = _сф.БезопасноРазделить(ТД.Сумма,ТД.Количество);
	КонецЕсли;
	
	ПересчитатьСтрокуНаСерере(ТД.ПолучитьИдентификатор(),Объект.ЦенаСНДС, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура УслугиКорректировкаВсегоПриИзменении(Элемент)
	
	ТД = Элементы.УслугиКорректировка.ТекущиеДанные;
	
	Ставка = CW_Финансы.ПолучитьСтавкуНДС(ТД.СтавкаНДС)/100;
	ТД.НДС = ТД.Всего*Ставка/(1+Ставка);
	ТД.Сумма = ТД.Всего - ТД.НДС;
	ТД.Цена = _сф.БезопасноРазделить(ТД.Сумма,ТД.Количество);
	
	ПересчитатьСтрокуНаСерере(ТД.ПолучитьИдентификатор(),Объект.ЦенаСНДС, Истина);
	
КонецПроцедуры

// ---------------------------------------------------------------------------- 

&НаКлиенте
Процедура ПерезаполнитьПоКорректируемомуДокументу(Команда)
	
	_ПерезаполнитьПоКорректируемомуДокументу();
	ОбновитьИтогиПоУслугам();
	
КонецПроцедуры

&НаСервере
Процедура _ПерезаполнитьПоКорректируемомуДокументу()
	// --- 
	
	ЗаполнитьЗначенияСвойств(Объект,Объект.КорректируемыйДокумент,"Организация,Контрагент,Договор,Валюта,Продавец,ПредъявленСФ");
	// ---
	Объект.Услуги.Загрузить(Объект.КорректируемыйДокумент.Услуги.Выгрузить());
	Для каждого Стр Из Объект.Услуги Цикл
		
		Стр.Представление_ДоКорректировки 	= Стр.Представление;
		Стр.Количество_ДоКорректировки 		= Стр.Количество;
		Стр.Цена_ДоКорректировки 			= Стр.Цена;
		Стр.Сумма_ДоКорректировки 			= Стр.Сумма;
		Стр.СтавкаНДС_ДоКорректировки 		= Стр.СтавкаНДС;
		Стр.НДС_ДоКорректировки 			= Стр.НДС;
		Стр.Всего_ДоКорректировки 			= Стр.Всего;     
		
		Если Объект.ПоказатьРубли Тогда
			Стр.Цена_ДоКорректировкиРег		= Стр.ЦенаРег;
			Стр.Сумма_ДоКорректировкиРег	= Стр.Суммарег;
			Стр.Цена_ДоКорректировкиРег		= Стр.НДСРег;
			Стр.Всего_ДоКорректировкиРег	= Стр.ВсегоРег;     
		КонецЕсли;
		
		Стр.Покупатель_ДоКорректировки 			= Стр.Покупатель;
		Стр.ДоговорПокупателя_ДоКорректировки 	= Стр.ДоговорПокупателя;
		Стр.ПриложениеКДоговору_ДоКорректировки = Стр.ПриложениеКДоговору;
		
	КонецЦикла; 
	
	Если Объект.ВидОперацииКорректировки = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсправленияПоступленияРеализации.ИсправлениеОшибки") Тогда
		ИсправлениеПолучитьНомерНаСервере();
	КонецЕсли;
	
	ОбновитьНомераДокументовНаСервере();
	
	Модифицированность=Истина;
	
	// --- 
КонецПроцедуры

&НаКлиенте
Процедура УслугиКорректировкаПредставлениеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка=Ложь;
	_УслугиПредставлениеНачалоВыбора(Элементы.УслугиКорректировка.ТекущаяСтрока);
	Элементы.УслугиКорректировка.ТекущийЭлемент = Элементы.УслугиКорректировкаПорядокОтражения;
	Элементы.УслугиКорректировка.ТекущийЭлемент = Элементы.УслугиКорректировкаПредставление;
	
КонецПроцедуры

&НаКлиенте
Процедура УслугиКорректировкаВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Элементы.УслугиКорректировка.ТекущиеДанные.ЭтоДобавленнаяСтрока = ЛОЖЬ Тогда
		Если Поле = Элементы.УслугиКорректировкаГрузоперевозкаЗаказ Тогда 
			
			СтандартнаяОбработка = Ложь;
			
			Попытка
				ПоказатьЗначение(,_Заказ(Элементы.УслугиКорректировка.ТекущиеДанные.Грузоперевозка));
			Исключение
				//ОписаниеОшибки()
			КонецПопытки; 
			
		ИначеЕсли (Поле = Элементы.УслугиКорректировкаГрузоперевозка) Тогда 
			
			СтандартнаяОбработка = Ложь;
			// --- 
			Попытка
				ПоказатьЗначение(,Элементы.УслугиКорректировка.ТекущиеДанные.Грузоперевозка);
			Исключение
				//ОписаниеОшибки()
			КонецПопытки; 
			
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

