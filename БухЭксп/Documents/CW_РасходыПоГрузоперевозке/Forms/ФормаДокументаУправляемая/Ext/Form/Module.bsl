Процедура УслугиПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	ТекущиеДанные = Элементы.Услуги.ТекущиеДанные;

	Если НоваяСтрока и НЕ Копирование Тогда
		
		ТекущиеДанные.Количество = 1;
		
		ПорядокОтражения = _ДС().ПД.ОсновнойПорядокОтраженияРасходов;
		Если ПорядокОтражения.Пустая() Тогда
			ПорядокОтражения = ПредопределенноеЗначение("Перечисление.CW_ПорядокОтраженияЗатрат.Затраты");
		КонецЕсли; 
		ТекущиеДанные.ПорядокОтражения = ПорядокОтражения;
		//ТекущиеДанные.Подразделение = ПодразделениеПользователя; //AFR-250522
		
		ПриИзмененииУслугиПорядокОтражения();   
	Иначе
		Если ТекущиеДанные.Количество = 0 Тогда
			ТекущиеДанные.Количество = 1;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(ТекущиеДанные.ПорядокОтражения) Тогда 
			ПорядокОтражения = _ДС().ПД.ОсновнойПорядокОтраженияДоходов;
			Если ПорядокОтражения.Пустая() Тогда
				ПорядокОтражения = ПредопределенноеЗначение("Перечисление.CW_ПорядокОтраженияЗатрат.Затраты"); 
			Иначе
				ТекущиеДанные.ПорядокОтражения = ПорядокОтражения;   
			КонецЕсли; 
		КонецЕсли;   
		//УДАЛЕНО по заявке AFR-250522
		//Если Не ЗначениеЗаполнено(ТекущиеДанные.Подразделение) Тогда 
		//	ТекущиеДанные.Подразделение = ПодразделениеПользователя;
		//КонецЕсли;
	КонецЕсли;
	
	//AFR-233578
	ИспользуетсяОгранчиениеУслуг = ПолучитьОграничениеУслугПоНоменклатуре(ТекущиеДанные.ПорядокОтражения);
	ОтключитьИсториюВыбораНоменклатуры(ИспользуетсяОгранчиениеУслуг);
	//AFR-233578
	
КонецПроцедуры


