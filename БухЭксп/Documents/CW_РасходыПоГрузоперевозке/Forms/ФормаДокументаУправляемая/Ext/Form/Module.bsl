&НаКлиенте
Процедура ПервичныеДокументыВремяАкта(Команда)
	
	Если не ЗначениеЗаполнено(Объект.ДатаСчета) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не указана дата счета!",,"ДатаСчета", "Объект");
		Возврат;
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("НачальнаяДата",	Объект.ДатаАкта);
	ДополнительныеПараметры.Вставить("ИмяРеквизита", 	"ДатаАкта");
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ОбработкаИзмененияВремени",ЭтотОбъект, ДополнительныеПараметры); 
	
	ПоказатьВводДаты(ОписаниеОповещения,Объект.ДатаАкта,"Время акта",ЧастиДаты.Время);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаИзмененияВремени(ВведенноеЗначение, ДополнительныеПараметры) Экспорт 
	
	Если ВведенноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ДатаСтрокой	 = Формат(Объект[ДополнительныеПараметры.ИмяРеквизита],"ДФ=yyyyMMdd");
	ВремяСтрокой = Формат(ВведенноеЗначение,"ДФ=HHmmss");

	Объект[ДополнительныеПараметры.ИмяРеквизита] = Дата(ДатаСтрокой+ВремяСтрокой);
	
КонецПроцедуры

&НаКлиенте
Процедура ПервичныеДокументыДатаСчета(Команда)
	
	
	Объект.ДатаСчета = Объект.Дата;
	
	//УстановитьСрокОплатыНаСервере();
	
	ОбновитьНомераДокументовНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ПервичныеДокументыДатаАкта(Команда)
	
	Объект.НомерАкта 	= Объект.НомерСчета;
	Объект.ДатаАкта 	= ?(ЗначениеЗаполнено(Объект.ДатаСчета),  Объект.ДатаСчета,  Объект.Дата);
	
	ОбновитьНомераДокументовНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ПервичныеДокументыДатаСчетФактуры(Команда)
	
	Если Объект.ВидОперацииКорректировки = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсправленияПоступленияРеализации.ИсправлениеОшибки") Тогда
		ИсправлениеПолучитьНомерНаСервере();
	Иначе
		Объект.НомерСФ 	= ?(Объект.ПредъявленАкт,	Объект.НомерАкта,	Объект.НомерСчета);
	КонецЕсли;

	Объект.ДатаСФ 	= ?(Объект.ПредъявленАкт,	Объект.ДатаАкта,	Объект.Дата);
	
	ОбновитьНомераДокументовНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура СпособЗачетаАвансовОЗПриИзменении(Элемент)
	
	СпособЗачетаАвансовОЗПриИзмененииНаСервере();

