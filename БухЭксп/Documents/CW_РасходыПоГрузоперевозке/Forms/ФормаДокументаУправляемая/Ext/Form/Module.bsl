&НаСервере
Процедура _УслугиСуммаПриИзменении(Строка)
	// --- 
	
	ТД = Объект.Услуги.НайтиПоИдентификатору(Строка);
	ТД.Цена = _сф.БезопасноРазделить(ТД.Сумма,ТД.Количество);
	Ставка = CW_Финансы.ПолучитьСтавкуНДС(ТД.СтавкаНДС);
	ТД.НДС = CW_Финансы.РассчитатьСуммуНДС(ТД.Сумма, Истина, Ложь, Ставка);
	ТД.Всего = ТД.Сумма + ТД.НДС;
	
	ПересчитатьСтрокуНаСерере(ТД.ПолучитьИдентификатор(),Объект.ЦенаСНДС, Истина);
	
	// --- 
