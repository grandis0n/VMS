	_СформироватьОбщиеПараметры("ПараметрыДоговора,УчетнаяПолитика");

КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)

	Если Объект.Ссылка.Пустая() Тогда
		РедактированиеАктированныхСчетов = CW_ПраваДоступа.ПравоДоступно("РазрешитьРедактированиеВходящихАктированныхСчетов");
		Если Объект.ПредъявленАкт и Объект.ПредъявленСчет и Не РедактированиеАктированныхСчетов Тогда
			ПоказатьПредупреждение(, "Недостаточно прав для записи пакетного документа!");
			Отказ = истина;
			Возврат ;
		КонецЕсли;
	КонецЕсли;
	
	Если Объект.ПредъявленСчет Тогда
		Если НЕ ЗначениеЗаполнено(Объект.НомерСчета) или Не ЗначениеЗаполнено(Объект.ДатаСчета) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Проверьте правильность заполнения реквизитов счета.",,,,Отказ);
		КонецЕсли;
	КонецЕсли;
	Если Объект.ПредъявленАкт Тогда
		Если Не ЗначениеЗаполнено(Объект.НомерАкта) или Не ЗначениеЗаполнено(Объект.ДатаАкта) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Проверьте правильность заполнения реквизитов акта.",,,,Отказ);
		КонецЕсли;
	КонецЕсли;
	Если Объект.ПредъявленСФ Тогда
		
		мПроверяемыеРеквизиты = новый Массив;
		мПроверяемыеРеквизиты.Добавить("ДатаСФ");
		Если Объект.Корректировка и Объект.ВидОперацииКорректировки <> ПредопределенноеЗначение("Перечисление.ВидыОперацийИсправленияПоступленияРеализации.ИсправлениеОшибки") Тогда
			мПроверяемыеРеквизиты.Добавить("НомерСФ");
		КонецЕсли;
		
		ЕстьПустые = ложь;
		Для Каждого ИмяРеквизита из мПроверяемыеРеквизиты Цикл
			Если Не ЗначениеЗаполнено(Объект[ИмяРеквизита]) Тогда
				ЕстьПустые = Истина;
			КонецЕсли;
		КонецЦикла;
		
		Если ЕстьПустые Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Проверьте правильность заполнения реквизитов с/ф.",,,,Отказ);
		КонецЕсли;
	КонецЕсли;
	
	Если Отказ Тогда
		ПоказатьПредупреждение(,"Проверьте правильность заполнения реквизитов первичных документов");
	КонецЕсли;

КонецПроцедуры  

&НаСервере                                     
// Проверяет факт того, что по договору с поставщиком наша организация выполняет обязательства налогового агента по НДС
Процедура ПроверитьУчетныйДоговорПоставщикаНаНА(Отказ)
	
	Если Не Объект.Договор.БухгалтерскийУчет 
		И НЕ Объект.Договор.УчетныйДоговор.УчетАгентскогоНДС Тогда
		Возврат;
	КонецЕсли;  
	
	Отбор = Новый Структура;
	Отбор.Вставить("ПорядокОтражения", ПредопределенноеЗначение("Перечисление.CW_ПорядокОтраженияЗатрат.Перевыставление"));
	
	мСтроки = Объект.Услуги.НайтиСтроки(Отбор);
	Если мСтроки.Количество() > 0 
		и Объект.Договор.ВалютаДоговора <> ВалютаРегламентированногоУчета Тогда   
		Отказ = Истина;	
	КонецЕсли;
	
КонецПроцедуры

