#Область ОсновныеСобытияФормы 

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЭтоНовыйОбъект = Параметры.Ключ.Пустая();
	
	_УстановитьПараметрыФункциональныхОпцийФормы();
	
	ВалютаРегламентированногоУчетаРубль 						= ПолучитьФункциональнуюОпцию("CW_ВалютаРегламентированногоУчетаРубль");
	КонтролироватьПолучениеОригиналовОтПоставщиков 				= ПолучитьФункциональнуюОпцию("CW_КонтролироватьПолучениеОригиналовОтПоставщиков");	
	РазрешитьПолучениеКоличестваУслугИзпараметраГрузоперевозки 	= ПолучитьФункциональнуюОпцию("CW_РазрешитьПолучениеКоличестваУслугИзпараметраГрузоперевозки");
	УстановитьЗначениеНольЗначениеПараметраНеУстановлено 		= Константы.CW_УстановитьЗначениеНольЗначениеПараметраНеУстановлено.Получить();
	СохранятьРеквизитыПервичныхДокументов 						= Константы.CW_СохранятьРеквизитыПервичныхДокументов.Получить();   
	
	ВалютаРегламентированногоУчета = Константы.ВалютаРегламентированногоУчета.Получить();
	
	ПравоРедактированияНомераДокумента 	= CW_ПраваДоступа.ПравоДоступно("РедактированиеНомераДокументаРасходыПоГрузоперевозкам");
	Элементы.Номер.ТолькоПросмотр 		=  НЕ ПравоРедактированияНомераДокумента;
	

	НачальнаяДатаДокумента 				= Объект.Дата;
	
	ПросмотрБюджетиа = CW_ПраваДоступа.ПравоДоступно("ПросмотрБюджетов");
	Элементы.УслугиПроверкаДокументаПоБюджету.Видимость = ПросмотрБюджетиа;

	//Для версии КОРП
	ВестиУчетПоПодразделениям					= ПолучитьФункциональнуюОпцию("ВестиУчетПоПодразделениям");
	Элементы.ПодразделениеОрганизации.Видимость	= ВестиУчетПоПодразделениям;
	//Для версии КОРП
	
	ОграничиватьУслугиПоДоговорам		= ПолучитьФункциональнуюОпцию("CW_ОграничиватьУслугиПоДоговорам");
	Если ОграничиватьУслугиПоДоговорам Тогда
		УстанавливатьЦенуВЗависимостиОтГруза 	= ПолучитьФункциональнуюОпцию("CW_УстанавливатьЦенуВЗависимостиОтГруза");
		УстанавливатьЦенуВЗависимостиОтКлиента 	= ПолучитьФункциональнуюОпцию("CW_УстановкаЦенНоменклатурыВЗависимостиОтКлиента");
		НеОграничиватьУслугиПоПеревыставлению 	= Константы.CW_НеОграничиватьСписокУслугПриПеревыставленииЗатрат.Получить();
	КонецЕсли;  
	
	//Услуги по договру
	АдресУслугПоДоговору 			= "";
	УстановитьАдресСпискаУслугПоДоговору();
	
	//AFR-233578
	//ИспользуетсяОгранчиениеУслуг = ПолучитьОграничениеУслугПоНоменклатуре();
	//ОтключитьИсториюВыбораНоменклатуры(ИспользуетсяОгранчиениеУслуг);
	//AFR-233578
	
	
	//Подсистема.СогласованиеОбъктов
	CW_СогласованиеСервер.ПриСозданииНаСервере(ЭтаФорма,Отказ, СтандартнаяОбработка);
	//Подсистема.СогласованиеОбъктов

	//Взаиморасчеты по документу
	CW_ВзаиморасчетыПоДокументуСервер.УстановитьНазваниеСсылкиОтчета(ЭтаФорма, Объект.ПредъявленСчет);
	//Взаиморасчеты по документу  
	
	// проверим на копирование
	Если ЗначениеЗаполнено(Параметры.ЗначениеКопирования) Тогда
		Копия = Параметры.ЗначениеКопирования;
	КонецЕсли;	
	
	// проверка лицензии
	Элементы.ГруппаИнфо.Видимость = Ложь;
	Если Параметры.Ключ.Пустая() И НЕ Модифицированность Тогда
		
		Если Не ЗначениеЗаполнено(НачальнаяДатаДокумента) Тогда
			НачальнаяДатаДокумента = ТекущаяДата();
		КонецЕсли;
		
		Модифицированность  = Истина;
		
		Если Не Объект.Корректировка 
			И Не Параметры.ЗначенияЗаполнения.Свойство("ВводНаОсновании") Тогда
			Объект.ЦенаСНДС = CW_Настройки.ПолучитьНастройкуПользователя(CW_Настройки.Пользователь(),"ВДокументахЦенаСНДС");
			ОбработатьИзменениеСоставаЦены();
		КонецЕсли;
		
		Если ВестиУчетПоПодразделениям и Не ЗначениеЗаполнено(Объект.ПодразделениеОрганизации) Тогда
			Объект.ПодразделениеОрганизации 	= CW_Настройки.ПолучитьНастройкуПользователя(CW_Настройки.Пользователь(),"ПодразделениеПользователя");
		КонецЕсли;
	КонецЕсли;

	Если Объект.Ссылка.Пустая() И ЗначениеЗаполнено(Объект.Договор) Тогда
		_ОбработатьИзменениеДоговора(ЗначениеЗаполнено(Параметры.ЗначениеКопирования));
	КонецЕсли;
	
	ЗапрашиватьПодтверждениеПриУдаленииСтрок = CW_Настройки.ПолучитьНастройкуПользователя(CW_Настройки.Пользователь(),"РасходыЗапрашиватьПодтверждениеПриУдаленииСтрок");
	
	ОтображатьКомментарийДоговора = CW_Настройки.ПолучитьНастройкуПользователя(CW_Настройки.Пользователь(),"ОтображатьКомментарийДоговораВФормеВводаДокументовПоБюджету");
	УстановитьЗаголовокНадписиКомментарияДоговора();
	
	НеЗаменятьПредставлениеНоменклатуры = CW_Настройки.ПолучитьНастройкуПользователя(CW_Настройки.Пользователь(),"НеЗаменятьПредставлениеПриИзмененииНоменклатурыРасходы");
	
	_ИнициализацияФормы();  
	
	//Срок оплаты
	Если Не Параметры.Ключ.Пустая() Тогда
		ДанныеСрокаОплаты = CW_Документы.ПолучитьСрокОплаты(Параметры.Ключ);
		
		ДанныеСрокаОплаты.Свойство("ДатаОплаты",			_СрокОплаты);
		ДанныеСрокаОплаты.Свойство("Описание",				_СрокОплатыОписание);
		ДанныеСрокаОплаты.Свойство("РучноеРедактирование",	_СрокОплатыРучноеРедактирование);
		
		УстановитьОписаниеСрокаОплаты();	
	КонецЕсли; 
	//Срок оплаты

	
	#Область Динамический_вывод_дополнительных_колонок
	
	_УФС.ОбновитьСписокДополнительныхКолонокФормы(ЭтаФорма, "CW_РасходыПоГрузоперевозке");
	УстановитьВидимостьКнопкиОбновленияЗначений();
	
	#КонецОбласти

	УстановитьВидимостьГруппыСуммыДокмента();
	
	ЗаполнитьСписокКодовОпераций();

	//Подсистема.ДополнительныеРеквизиты
	ИспользоватьДопРеквизиты = CW_ДополнительныеРеквизитыСлужебный.ИспользуютсяДополниительныеРеквизиты();
	//Подсистема.ДополнительныеРеквизиты
	
	// СтандартныеПодсистемы.Свойства
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ИмяЭлементаДляРазмещения", "ГруппаДополнительныеРеквизиты");
	ДополнительныеПараметры.Вставить("ПроизвольныйОбъект", НЕ ИспользоватьДопРеквизиты); 
	УправлениеСвойствами.ПриСозданииНаСервере(ЭтотОбъект, ДополнительныеПараметры);
	// Конец СтандартныеПодсистемы.Свойства
	
	//Подистема.CW_ПланированиеДДС
	CW_ПланированиеДДССервер.ПриСозданииНаСервере(ЭтаФорма, Отказ, СтандартнаяОбработка);
	//Подистема.CW_ПланированиеДДС
	
	//Подсистема.ОригиналыДокументов
	CW_ОригиналыДокументовСервер.ПриСозданииНаСервере(ЭтаФорма, Отказ, СтандартнаяОбработка);
	//Подсистема.ОригиналыДокументов
	
	//Подсистема.УчетПриложенийДоговоров
	CW_УчетПриложенийДоговоровСервер.ПриСозданииНаСервере(ЭтаФорма, Отказ, СтандартнаяОбработка);
	//Подсистема.УчетПриложенийДоговоров
	
	//Подсистема.СтатусыДокументов
	CW_СтатусыДокументовСервер.ПриСозданииНаСервере(ЭтаФорма,Отказ, СтандартнаяОбработка);
	//Подсистема.СтатусыДокументов
	
	//Наличие прикрепленных файлов
	_УФКС.УстановитьНаличиеПрикрепленныхФайловПриСозданииФормыНаСервере(ЭтаФорма);
	//Наличие прикрепленных файлов

	ПервичныеДокументыПриСозданииНаСервере();
	
	//Внешние подклчюаемые команды
	CW_ПодключаемыеКомандыСервер.ПриСозданииНаСервере(ЭтотОбъект);

	Основание = _сф.ст_ПолучитьСвойство(Параметры,"Основание");
	Если Основание <> Неопределено Тогда
		
		Если (ТипЗнч(Основание) = Тип("ДокументСсылка.CW_РасходыПоГрузоперевозке")) Тогда
			
			// проверяем, что онованием является счет
			Если НЕ (Основание.ПредъявленСчет И НЕ (Основание.ПредъявленАкт ИЛИ Основание.ПредъявленСФ)) Тогда
				
				ФлагОтменыОткрытия = Истина;
				ТекстОтменыОткрытия = "Ввод на основании доступен только для неактированного счёта!";
				Возврат;
				
			КонецЕсли; 
			
		КонецЕсли; 
		
		Если (ТипЗнч(Основание) = Тип("ДокументСсылка.CW_ДоходыПоГрузоперевозке")) Тогда
			
			// режим ввода на основании
			РежимВводаНаОсновании = Истина;
			ДокументОснование = Основание;
			Возврат;
			
		КонецЕсли; 
		
		Если (ТипЗнч(Основание)=Тип("СправочникСсылка.CW_Грузоперевозки")) Тогда
			
			// добавляем строку
			Нстр = Объект.Услуги.Добавить();
			Нстр.Грузоперевозка = Основание;
			// --- 
			ЗаполнитьДополнительныеКолонкиТабличнойЧасти();
			
		КонецЕсли; 
		
		Если (ТипЗнч(Основание)=Тип("СправочникСсылка.CW_Заказы")) Тогда
			
			// добавляем строку
			МассивГП = CW_Мониторинг.ГрузоперевозкиЗаказа(Основание);
			Для каждого ГП Из МассивГП Цикл
				
				Нстр = Объект.Услуги.Добавить();
				Нстр.Грузоперевозка = ГП;
				
			КонецЦикла; 
			
			ЗаполнитьДополнительныеКолонкиТабличнойЧасти();
			
		КонецЕсли; 
		
	КонецЕсли; 
	
	// заполнение по бюджету
	АдресПараметровЗаполнения = _сф.ст_ПолучитьСвойство(Параметры,"АдресПараметровЗаполнения");
	Если (АдресПараметровЗаполнения <> Неопределено) Тогда
		
		СЗ = ПолучитьИзВременногоХранилища(АдресПараметровЗаполнения);
		ЗаполнитьЗначенияСвойств(Объект,СЗ,,"Услуги");
		// --- 
		Для каждого Стр Из СЗ.Услуги Цикл
			
			Нстр = Объект.Услуги.Добавить();
			ЗаполнитьЗначенияСвойств(Нстр,Стр);
			
			ТребоватьЗаполненияПокупателя = _ДС().ПД.ТребоватьЗаполненияПокупателяДляПорядокаОтраженияЗатратыВРасходах;
			
			Если (Нстр.ПорядокОтражения <> ПредопределенноеЗначение("Перечисление.CW_ПорядокОтраженияЗатрат.Затраты")) Тогда
				
				// значение заполнено
				СтруктураПараметров 	= ПодготовитьДанныеДляПолученияДанныхпокупателя(Нстр.ПолучитьИдентификатор());
				СтруктураДанныхСтроки 	= ПолучитьДанныеПокупателя(СтруктураПараметров);
				
				Если СтруктураДанныхСтроки.Свойство("Покупатель") Тогда
					Нстр.Покупатель 		 	= СтруктураДанныхСтроки.Покупатель;
				КонецЕсли;
				Если СтруктураДанныхСтроки.Свойство("ДоговорПокупателя") Тогда
					Нстр.ДоговорПокупателя 	= СтруктураДанныхСтроки.ДоговорПокупателя;
				КонецЕсли;
				Если  СтруктураДанныхСтроки.Свойство("ПриложениеКДоговору") Тогда
					Нстр.ПриложениеКДоговору = СтруктураДанныхСтроки.ПриложениеКДоговору;
				КонецЕсли;
				Если  СтруктураДанныхСтроки.Свойство("УчетПриложений") Тогда
					Нстр.УчетПриложенийПоДоговору = СтруктураДанныхСтроки.УчетПриложений;
				КонецЕсли;
				
			Иначе
				
				Если ТребоватьЗаполненияПокупателя Тогда
					// значение заполнено
					СтруктураПараметров 	= ПодготовитьДанныеДляПолученияДанныхпокупателя(Нстр.ПолучитьИдентификатор());
					СтруктураДанныхСтроки 	= ПолучитьДанныеПокупателя(СтруктураПараметров);
					
					Если СтруктураДанныхСтроки.Свойство("Покупатель") Тогда
						Нстр.Покупатель 		 	= СтруктураДанныхСтроки.Покупатель;
					КонецЕсли;
					Если СтруктураДанныхСтроки.Свойство("ДоговорПокупателя") Тогда
						Нстр.ДоговорПокупателя 	= СтруктураДанныхСтроки.ДоговорПокупателя;
					КонецЕсли;
					Если  СтруктураДанныхСтроки.Свойство("ПриложениеКДоговору") Тогда
						Нстр.ПриложениеКДоговору = СтруктураДанныхСтроки.ПриложениеКДоговору;
					КонецЕсли;
					Если  СтруктураДанныхСтроки.Свойство("УчетПриложений") Тогда
						Нстр.УчетПриложенийПоДоговору = СтруктураДанныхСтроки.УчетПриложений;
					КонецЕсли;
				КонецЕсли;
				
			КонецЕсли; 
			
			
		КонецЦикла;
		
		ЗаполнитьДополнительныеКолонкиТабличнойЧасти();
		// 
		КомментарийЗаполнения = Неопределено;
		СЗ.Свойство("КомментарийЗаполнения",КомментарийЗаполнения);
		
		ОбработатьИзменениеФлагаЦенаСНДС();
		
		//Бред конечно, но при заполнении по бюджету нужно это процедуру вызвать повторно, чтоббы обновить параметры "ДС".
		_ИнициализацияФормы();

	КонецЕсли; 
	
	#Область Динамический_вывод_дополнительных_колонок
	
	//Обновляем динамические колонки параметров ГП
	Если Объект.Услуги.Количество() > 0 Тогда
		_УФС.ОбновитьЗначенияПараметровГрузоперевозок(ПолучитьСтруктуруПараметровДляПередачи());
	КонецЕсли;
	
	#КонецОбласти

	УстановитьВидимостьЭлементовРег();
	
	ОбработатьИзменениеСоставаЦены();
	
КонецПроцедуры

&НаСервере
Процедура ОтключитьИсториюВыбораНоменклатуры(ЕстьОграниченияПоСпискуУслуг)
	
	Если ЕстьОграниченияПоСпискуУслуг Тогда 
		Элементы.УслугиНоменклатура.ИсторияВыбораПриВводе = ИсторияВыбораПриВводе.НеИспользовать;
	Иначе
		Элементы.УслугиНоменклатура.ИсторияВыбораПриВводе = ИсторияВыбораПриВводе.Авто;
	КонецЕсли;

КонецПроцедуры 

&НаСервере
Процедура _УстановитьПараметрыФункциональныхОпцийФормы()
	ТекущийПользователь = CW_Настройки.Пользователь();
	ГруппаПользователя 	= CW_ПраваДоступа_ПИ.ГруппаПользователя(ПараметрыСеанса.ТекущийПользователь);
	
	ПараметрыФункциональныхОпций = Новый Структура("CW_Пользователь, CW_ГруппаПользователя",ТекущийПользователь, ГруппаПользователя);
	
	УстановитьПараметрыФункциональныхОпцийФормы(ПараметрыФункциональныхОпций);
	
КонецПроцедуры


&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	
	// проверим на копирование
	Если ЗначениеЗаполнено(Копия) Тогда
		// проверим грузоперевозки
		Блок = _ПроверитьБлок();
		Если (Блок) Тогда
			Объект.Услуги.Очистить();
			_УФК.ВывестиПредупреждение("Документ содержит блокированые грузоперевозки." + Символы.ПС + "Табличная часть очищена.");
			УстановитьДоступность(); 	
		КонецЕсли;		
		
		ОбновитьИтогиПоУслугам();
		ОбновитьИтогиПоАвансам();	
		ОбновитьИтогиПоАктированию();
	КонецЕсли;	
	
	
	Если (ЗначениеЗаполнено(КомментарийЗаполнения)) Тогда
		
		Сообщить(КомментарийЗаполнения);		
		
	КонецЕсли;
	
	Если ФлагОтменыОткрытия Тогда
		
		_УФК.ВывестиПредупреждение(ТекстОтменыОткрытия);
		Отказ = Истина;
		Возврат;
		
	КонецЕсли; 
	
	Если (РежимВводаНаОсновании) Тогда
		
		ПодключитьОбработчикОжидания("ДиалогВводаНаОсновании",0.1,Истина);
		
	КонецЕсли;    
	
	//Подсистема.CW_ЭлектронныйОбменДанными
	Если ЗначениеЗаполнено(Объект.Контрагент) 
		и Не Объект.Корректировка Тогда
		ПроверитьКонтрагентаПоБазеЛКК();
	КонецЕсли;
	//Подсистема.CW_ЭлектронныйОбменДанными
	
	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствамиКлиент.ПослеЗагрузкиДополнительныхРеквизитов(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.Свойства
	
КонецПроцедуры 

&НаКлиенте
