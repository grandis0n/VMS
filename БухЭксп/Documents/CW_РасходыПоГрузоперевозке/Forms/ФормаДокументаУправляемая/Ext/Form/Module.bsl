	Если (Ответ = КодВозвратаДиалога.Да) Тогда
		
		ВыполнитьНепосредственноеУдалениеВедомых(ДополнительныеПараметры.ВидВедомого);
		
	КонецЕсли; 
	
	// --- 
КонецПроцедуры
  
&НаКлиенте
Процедура ВыполнитьНепосредственноеУдалениеВедомых(ВидВедомого)
	// --- 
	
	Если (ВидВедомого = "Счет") Тогда
		
		Ответ = _УдалитьВедомыйСчет();
		
	ИначеЕсли (ВидВедомого = "СчетКорректировочны") Тогда 
		
		Ответ = _УдалитьВедомыйСчетКорректировочный();
		
	ИначеЕсли (ВидВедомого = "Документ") Тогда 
		
		Ответ = _УдалитьВедомый();
		
	ИначеЕсли (ВидВедомого = "СчетФактура") Тогда 
		
		Ответ = _УдалитьВедомыйСчетФактуру();
		
	КонецЕсли; 
	
	_УправлениеЭлементамиФормы();
	
	// --- 
КонецПроцедуры

