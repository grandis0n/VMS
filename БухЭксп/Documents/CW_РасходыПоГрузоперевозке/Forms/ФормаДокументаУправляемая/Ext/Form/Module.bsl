&НаСервере
Процедура _ОбновитьАкты()
	
	Если НЕ Объект.ПредъявленСчет Тогда
		Возврат;
	КонецЕсли; 
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	CW_АктированиеВходящихСчетовОбороты.Регистратор КАК Акт,
	               |	CW_АктированиеВходящихСчетовОбороты.ВсегоРасход КАК Всего,
	               |	ВЫБОР
	               |		КОГДА CW_АктированиеВходящихСчетовОбороты.Регистратор ССЫЛКА Документ.CW_РасходыПоГрузоперевозке
	               |			ТОГДА ВЫБОР
	               |					КОГДА CW_АктированиеВходящихСчетовОбороты.Регистратор.ПредъявленАкт
	               |						ТОГДА CW_АктированиеВходящихСчетовОбороты.Регистратор.НомерАкта
	               |					ИНАЧЕ CW_АктированиеВходящихСчетовОбороты.Регистратор.НомерСФ
	               |				КОНЕЦ
	               |		ИНАЧЕ CW_АктированиеВходящихСчетовОбороты.Регистратор.Номер
	               |	КОНЕЦ КАК Номер,
	               |	ВЫБОР
	               |		КОГДА CW_АктированиеВходящихСчетовОбороты.Регистратор ССЫЛКА Документ.CW_РасходыПоГрузоперевозке
	               |			ТОГДА ВЫБОР
	               |					КОГДА CW_АктированиеВходящихСчетовОбороты.Регистратор.ПредъявленАкт
	               |						ТОГДА CW_АктированиеВходящихСчетовОбороты.Регистратор.ДатаАкта
	               |					ИНАЧЕ CW_АктированиеВходящихСчетовОбороты.Регистратор.ДатаСФ
	               |				КОНЕЦ
	               |		ИНАЧЕ CW_АктированиеВходящихСчетовОбороты.Регистратор.Дата
	               |	КОНЕЦ КАК Дата,
	               |	ЕСТЬNULL(CW_АктированиеВходящихСчетовОбороты.Регистратор.Корректировка, ИСТИНА) КАК ЭтоАктКорректировка,
	               |	ЕСТЬNULL(CW_АктированиеВходящихСчетовОбороты.Регистратор.ПредъявленАкт, ЛОЖЬ) КАК ПредъявленАкт
	               |ИЗ
	               |	РегистрНакопления.CW_АктированиеВходящихСчетов.Обороты(, , Регистратор, Счет = &Счет) КАК CW_АктированиеВходящихСчетовОбороты
	               |ГДЕ
	               |	CW_АктированиеВходящихСчетовОбороты.Регистратор <> &Счет
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	CW_АктированиеВходящихСчетовОбороты.Период
	               |АВТОУПОРЯДОЧИВАНИЕ";
	
	Запрос.УстановитьПараметр("Счет", Объект.Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	
	ТаблицаАктов.Очистить();
	МассиивАктов = Новый Массив;
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = ТаблицаАктов.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока,Выборка);
		
		Если ТипЗнч(Выборка.Акт) = Тип("ДокументСсылка.CW_РасходыПоГрузоперевозке") Тогда 
			Префикс	 = ?(Выборка.ЭтоАктКорректировка, "(К)","");
			Название = ?(Выборка.ПредъявленАкт, "Акт", "С/ф");	
		Иначе
			Префикс = "";
			Название = Выборка.Акт.Метаданные().Синоним;
		КонецЕсли;
		
		ШаблонПредставления = "%1 №%2 %3 от %4";
		НоваяСтрока.Представление = СтрШаблон(ШаблонПредставления,Название, Строка(Выборка.Номер),Префикс,Формат(Выборка.Дата,"ДФ=dd.MM.yyyy"));

		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(МассиивАктов, ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Выборка.Акт), Истина);
		
	КонецЦикла;
	
	КоличествоАктов = МассиивАктов.Количество();
	Элементы.СтраницаАкты.Заголовок = "Акты"+?(КоличествоАктов=0,""," ("+Строка(КоличествоАктов)+")");
	
КонецПроцедуры


