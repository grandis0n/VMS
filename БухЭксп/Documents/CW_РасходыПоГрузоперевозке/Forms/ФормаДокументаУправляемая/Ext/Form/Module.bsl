&НаКлиенте
Процедура НастройкаКолонок(Команда)
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("АдресСпискаЗначений"	, ПолучитьДанныеДляПередачи());
	ПараметрыФормы.Вставить("СписокСПометками"		, Истина);
	ПараметрыФормы.Вставить("ЗаголовокФормы"		, "Дополнительные колонки");
	
	ОписаниеОповещения = новый ОписаниеОповещения("ПослеЗакрытияФормыВыбораСпискаПараметров", ЭтаФорма);
	
	ОткрытьФорму("ОбщаяФорма.CW_ФормаВыбораИзСписка",ПараметрыФормы, ЭтаФорма,,,,ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&наСервере
Функция ПолучитьДанныеДляПередачи()
	
	Возврат ПоместитьВоВременноеХранилище(СписокДополнительныхКолонок);
	
КонецФункции

&НаКлиенте
Процедура ПослеЗакрытияФормыВыбораСпискаПараметров(Результат, ДопПараметры) Экспорт
 
	Если ЗначениеЗаполнено(Результат) Тогда
		
		ОбработатьРезультатВыбораКолонок(Результат);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбработатьРезультатВыбораКолонок(Результат)
	
	Если ЭтоАдресВременногоХранилища(Результат) Тогда
		
		СписокКолонок = ПолучитьИзВременногоХранилища(Результат);
		
		СписокДополнительныхКолонок.Очистить();
		СписокВыбранныеКолонки.Очистить();
		
		Для Каждого ЭлементСписка из СписокКолонок Цикл
			СписокДополнительныхКолонок.Добавить(ЭлементСписка.Значение, ЭлементСписка.Представление, ЭлементСписка.Пометка);
			Если ЭлементСписка.Пометка Тогда
				СписокВыбранныеКолонки.Добавить(ЭлементСписка.Значение);	
			КонецЕсли;
		КонецЦикла;
		
		_УФС.ДополнитьДинамическиеКолонки(ЭтаФорма);
		_УФС.ОбновитьЗначенияПараметровГрузоперевозок(ПолучитьСтруктуруПараметровДляПередачи());
		
	КонецЕсли;
	
	УстановитьВидимостьКнопкиОбновленияЗначений();
                                 
КонецПроцедуры

&наСервере
Функция ПолучитьСтруктуруПараметровДляПередачи()
	
	СоответствиеПараметров = Неопределено;
	Если СписокДоступныхПараметров.Количество() > 0 Тогда
		СоответствиеПараметров = СписокДоступныхПараметров[0].Значение ;
	КонецЕсли;

	СтуктураПараметров = Новый Структура;
	СтуктураПараметров.Вставить("Объект"				, Объект);
	СтуктураПараметров.Вставить("ТаблицаДокумента"		, Объект.Услуги);
	СтуктураПараметров.Вставить("ВыбранныеКолонки"		, СписокВыбранныеКолонки.ВыгрузитьЗначения());
	СтуктураПараметров.Вставить("СоответствиеПараметров", СоответствиеПараметров);
	СтуктураПараметров.Вставить("мГрузоперевозки"		, Объект.Услуги.Выгрузить().ВыгрузитьКолонку("Грузоперевозка"));
	
	Возврат СтуктураПараметров;
	
КонецФункции

