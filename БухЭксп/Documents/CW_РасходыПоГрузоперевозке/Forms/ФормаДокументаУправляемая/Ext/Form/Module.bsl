&НаКлиенте
Процедура ЦенаСНДС(Команда)
	
	Если Объект.Услуги.Количество() > 0 Тогда
		
		Режим = РежимДиалогаВопрос.ДаНет;
		Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаОбИзмененииСоставаЦены", ЭтаФорма, Параметры);
		ПоказатьВопрос(Оповещение, "Данные табличной части будут пересчитаны. Продолжить?" , Режим, 0);
		
	Иначе
		
		Объект.ЦенаСНДС = не Объект.ЦенаСНДС;
		ОбработатьИзменениеФлагаЦенаСНДС();
	
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбработатьИзменениеФлагаЦенаСНДС()
	
	ОбработатьИзменениеСоставаЦены();
	ПересчитатьДанныеСтрокНаСервере(Истина);

КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияВопросаОбИзмененииСоставаЦены(Результат, Параметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Нет Тогда
        Возврат;
    КонецЕсли;
	
	Объект.ЦенаСНДС = не Объект.ЦенаСНДС;
	ОбработатьИзменениеСоставаЦены();

	ПересчитатьДанныеСтрокНаСервере(Истина);

КонецПроцедуры

&НаСервере
Процедура ОбработатьИзменениеСоставаЦены()
	
	ТекстЗаголовкаЦены 	= "Цена";
	ШрифтЗаголовка 		= Новый Шрифт();
	ЦенаСНДС 			= Объект.ЦенаСНДС;
	
	Если ЦенаСНДС Тогда
		ТекстЗаголовкаЦены 	= ТекстЗаголовкаЦены + " (с НДС)";
		ШрифтЗаголовка 		= Новый Шрифт(, , Истина);
	КонецЕсли;
	
	Элементы.УслугиЦена.Заголовок 		=  ТекстЗаголовкаЦены;
	Элементы.УслугиЦена.ШрифтЗаголовка 	=  ШрифтЗаголовка;
	
	Элементы.УслугиКорректировкаГруппаЦена.Заголовок 	  =  ТекстЗаголовкаЦены;
	Элементы.УслугиКорректировкаГруппаЦена.ШрифтЗаголовка =  ШрифтЗаголовка;
	
	Элементы.УслугиЦенаСНДС.Пометка 				= ЦенаСНДС;
	Элементы.УслугиКорректировкаЦенаСНДС.Пометка 	= ЦенаСНДС;
	
КонецПроцедуры

&НаСервере
Процедура ПересчитатьДанныеСтрокНаСервере(ТолькоЦена)
	
	ЦенаСНДС = Объект.ЦенаСНДС;
	
	Для Каждого СтрокаУслуги из Объект.Услуги Цикл
		ПересчитатьСтрокуНаСерере(СтрокаУслуги.ПолучитьИдентификатор(), ЦенаСНДС, ТолькоЦена);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ПересчитатьСтрокуНаСерере(ИдентификаторСтроки, ЦенаСНДС, ТолькоЦена=Ложь, ПризнакКорр="", Повторить = Истина)
	
	ТекущаяСтрока = Объект.Услуги.НайтиПоИдентификатору(ИдентификаторСтроки);
	ТекСтавкаНДС  = CW_Финансы.ПолучитьСтавкуНДС(ТекущаяСтрока["СтавкаНДС"+ПризнакКорр]);
	
	Если ТолькоЦена Тогда
		Если ЦенаСНДС Тогда   
			ТекущаяСтрока["Цена"+ПризнакКорр] = _сф.БезопасноРазделить(ТекущаяСтрока["Всего"+ПризнакКорр],ТекущаяСтрока["Количество"+ПризнакКорр]);	
		Иначе
			ТекущаяСтрока["Цена"+ПризнакКорр] = _сф.БезопасноРазделить(ТекущаяСтрока["Сумма"+ПризнакКорр],ТекущаяСтрока["Количество"+ПризнакКорр]);	
		КонецЕсли; 
		
	Иначе
		
		Если ЦенаСНДС Тогда
			ТекущаяСтрока["Всего"+ПризнакКорр] 	= ТекущаяСтрока["Цена"+ПризнакКорр] * ТекущаяСтрока["Количество"+ПризнакКорр];
			ТекущаяСтрока["НДС"+ПризнакКорр] 	= ТекущаяСтрока["Всего"+ПризнакКорр] * ТекСтавкаНДС/(100 + ТекСтавкаНДС); 
			ТекущаяСтрока["Сумма"+ПризнакКорр] 	= ТекущаяСтрока["Всего"+ПризнакКорр] - ТекущаяСтрока["НДС"+ПризнакКорр];
		Иначе
			ТекущаяСтрока["Сумма"+ПризнакКорр] 	= ТекущаяСтрока["Цена"+ПризнакКорр] * ТекущаяСтрока["Количество"+ПризнакКорр];
			ТекущаяСтрока["НДС"+ПризнакКорр] 	= ТекущаяСтрока["Сумма"+ПризнакКорр] * ТекСтавкаНДС/100;
			ТекущаяСтрока["Всего"+ПризнакКорр] 	= ТекущаяСтрока["Сумма"+ПризнакКорр] + ТекущаяСтрока["НДС"+ПризнакКорр];	
		КонецЕсли;
		
	КонецЕсли;       
	
	Если Объект.ПоказатьРубли Тогда
		ПересчитатьВРегламентированнуюВалютуСтрокуНаСерере(ИдентификаторСтроки); 
	Конецесли;
	
КонецПроцедуры   

Процедура ПересчитатьВРегламентированнуюВалютуСтрокуНаСерере(ИдентификаторСтроки, ОчиститьСуммы = Ложь)    
	
	ТекущаяСтрока = Объект.Услуги.НайтиПоИдентификатору(ИдентификаторСтроки);     
	
	Если Объект.Корректировка Тогда
		КоррПолеДо 		= "_ДоКорректировки";	
		КоррПолеПеред	= "_ПередКорректировкой";	
	КонецЕсли;
	
	Если ОчиститьСуммы Тогда
		ТекущаяСтрока.ЦенаРег 	= 0;
		ТекущаяСтрока.СуммаРег	= 0;
		ТекущаяСтрока.НДСРег 	= 0;
		ТекущаяСтрока.ВсегоРег 	= 0; 
		
	Иначе
		Если Объект.УЕ_ПользовательскийКурс Тогда
			ДанныеКурса = Новый Структура;
			ДанныеКурса.Вставить("Курс", Объект.УЕ_Курс);
			ДанныеКурса.Вставить("Кратность", Объект.УЕ_Кратность);
		Иначе
			ДанныеКурса = CW_Финансы.ПолучитьКурсВалюты(Объект.Валюта, Объект.Дата);
		КонецЕсли;
		
		ТекущаяСтрока.ЦенаРег 	= CW_Финансы.ПересчитатьИзВалютыВВалюту(ТекущаяСтрока.Цена, 	Объект.Валюта, ВалютаРегламентированногоУчета, ДанныеКурса.Курс,1, ДанныеКурса.Кратность, 1);	
		ТекущаяСтрока.СуммаРег 	= CW_Финансы.ПересчитатьИзВалютыВВалюту(ТекущаяСтрока.Сумма, 	Объект.Валюта, ВалютаРегламентированногоУчета, ДанныеКурса.Курс,1, ДанныеКурса.Кратность, 1);	
		ТекущаяСтрока.НДСРег 	= CW_Финансы.ПересчитатьИзВалютыВВалюту(ТекущаяСтрока.НДС, 		Объект.Валюта, ВалютаРегламентированногоУчета, ДанныеКурса.Курс,1, ДанныеКурса.Кратность, 1);	
		ТекущаяСтрока.ВсегоРег  = ТекущаяСтрока.СуммаРег + ТекущаяСтрока.НДСРег;
		
	КонецЕсли;
	
КонецПроцедуры   



