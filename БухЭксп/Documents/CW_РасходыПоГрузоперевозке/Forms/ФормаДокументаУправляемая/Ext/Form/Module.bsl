&НаКлиенте
Процедура СчетНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Список = Новый СписокЗначений;
	Список.Добавить("список","Выбор из списка");
	
	// если ведется оперативный учет задолженности
	Если ОперативныйУчет И НЕ ВводОстатковОЗ Тогда
		Список.Добавить("подбор","Подбор неактированных");
	КонецЕсли; 

	ДополнительныеПараметры = Новый Структура("Элемент", Элемент);

	ОписаниеОповещения = Новый ОписаниеОповещения("ПакетДокументовОбработатьВыборВариантаПодбораСчета",ЭтотОбъект, ДополнительныеПараметры); 
	Если Список.Количество() = 1 Тогда
		ВыполнитьОбработкуОповещения(ОписаниеОповещения, Список[0]);
	Иначе
		ПоказатьВыборИзМеню(ОписаниеОповещения, Список, Элемент);
	КонецЕсли; 
		
КонецПроцедуры


&НаКлиенте
Процедура ПакетДокументовОбработатьВыборВариантаПодбораСчета(РезультатВыбора, ДополнительныеПараметры) Экспорт 
	
	Если РезультатВыбора = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если РезультатВыбора.Значение = "подбор" Тогда
		
		СтруктураОтбора = Новый Структура;
		СтруктураОтбора.Вставить("Организация", 		Объект.Организация);
		СтруктураОтбора.Вставить("Контрагент", 			Объект.Контрагент);
		СтруктураОтбора.Вставить("Договор", 			Объект.Договор);
		СтруктураОтбора.Вставить("Валюта", 				Объект.Валюта);
		СтруктураОтбора.Вставить("ПриложениеКДоговору", Объект.ПриложениеКДоговору);
		
		ПараметрыФормыПодбора = Новый Структура;
		ПараметрыФормыПодбора.Вставить("Дата",		Объект.Дата);
		ПараметрыФормыПодбора.Вставить("Документ",	Объект.Ссылка);
		ПараметрыФормыПодбора.Вставить("Отбор",		СтруктураОтбора);
		
		ОткрытьФорму("ОбщаяФорма.CW_ПодборНеактированныхСчетов",ПараметрыФормыПодбора,ДополнительныеПараметры.Элемент,,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
	ИначеЕсли РезультатВыбора.Значение = "список" Тогда 
		
		СтруктураОтбора = Новый Структура;
		СтруктураОтбора.Вставить("Контрагент", 				Объект.Контрагент);
		СтруктураОтбора.Вставить("Договор", 				Объект.Договор);
		СтруктураОтбора.Вставить("ПриложениеКДоговору", 	Объект.ПриложениеКДоговору);;
		СтруктураОтбора.Вставить("ПредъявленСчет", 			Истина);
		СтруктураОтбора.Вставить("ПредъявленАкт", 			Ложь);
		СтруктураОтбора.Вставить("ПредъявленСФ", 			Ложь);
		
		// во всех остальных случаях
		ПараметрыФормыПодбора = Новый Структура;
		ПараметрыФормыПодбора.Вставить("РежимВыбора",	Истина);
		ПараметрыФормыПодбора.Вставить("Отбор",		СтруктураОтбора);
		
		ОткрытьФорму("Документ.CW_РасходыПоГрузоперевозке.ФормаВыбора",ПараметрыФормыПодбора,ДополнительныеПараметры.Элемент,,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
	КонецЕсли; 
	
КонецПроцедуры

