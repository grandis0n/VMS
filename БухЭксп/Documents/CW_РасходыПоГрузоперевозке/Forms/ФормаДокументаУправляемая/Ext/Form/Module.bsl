&НаКлиенте
Процедура УслугиКорректировкаПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НоваяСтрока Тогда
		ТекущиеДанные = Элементы.УслугиКорректировка.ТекущиеДанные;
		ТекущиеДанные.ЭтоДобавленнаяСтрока = Истина;
		ТекущиеДанные.Количество = 1;
		
		Если Копирование Тогда
			ТекущиеДанные.Представление_ДоКорректировки = "";
			ТекущиеДанные.Количество_ДоКорректировки	= 0;
			ТекущиеДанные.Цена_ДоКорректировки			= 0;
			ТекущиеДанные.Сумма_ДоКорректировки			= 0;
			ТекущиеДанные.НДС_ДоКорректировки  			= 0;
			ТекущиеДанные.Всего_ДоКорректировки			= 0;
		КонецЕсли;
		
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура УслугиКорректировкаНоменклатураПриИзменении(Элемент)
	_УслугиНоменклатураПриИзменении(Элементы.УслугиКорректировка.ТекущаяСтрока);
КонецПроцедуры

&НаКлиенте
Процедура УслугиКорректировкаНоменклатураНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ИспользуетсяОгранчиениеУслуг = ПолучитьОграничениеУслугПоНоменклатуре(Элементы.Услуги.ТекущиеДанные.ПорядокОтражения);	
	Если Не ИспользуетсяОгранчиениеУслуг Тогда
		
		ВыбранноеЗначение = Элементы.Услуги.ТекущиеДанные.Номенклатура;	
		_УФК.ВыбратьНоменклатуру(ВыбранноеЗначение,Элемент,ДанныеВыбора,СтандартнаяОбработка);
		
	Иначе

		СписокЗначений = Новый СписокЗначений;
		Если ЭтоАдресВременногоХранилища(АдресУслугПоДоговору) Тогда
			МассивУслуг =  _УФС.ПолучитьУслугиДоговора(АдресУслугПоДоговору);
			СписокЗначений.ЗагрузитьЗначения(МассивУслуг);
		КонецЕсли; 
		
		Если СписокЗначений.Количество() = 0 Тогда
			Сообщение = новый СообщениеПользователю;
			Сообщение.Текст   		= "Не определен список услуг по договору!";
			Сообщение.ПутьКДанным  	= "Объект";
			Сообщение.Поле    		= "Договор";
			Сообщение.Сообщить();
			
		Конецесли;
		
		ДанныеВыбора = СписокЗначений;
		СтандартнаяОбработка = Ложь;
		
	Конецесли;
	
КонецПроцедуры

&НаКлиенте
Процедура УслугиКорректировкаНоменклатураАвтоПодбор(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, Ожидание, СтандартнаяОбработка)
	
	Если Не ПустаяСтрока(Текст) и ЭтоАдресВременногоХранилища(АдресУслугПоДоговору) Тогда
		ИспользуетсяОгранчиениеУслуг = ПолучитьОграничениеУслугПоНоменклатуре( Элементы.Услуги.ТекущиеДанные.ПорядокОтражения);
		Элемент.РежимВыбораИзСписка  = ИспользуетсяОгранчиениеУслуг;	
		Если ИспользуетсяОгранчиениеУслуг Тогда 
			Если Элемент.СписокВыбора.Количество()> 0 Тогда
				Элемент.СписокВыбора.Очистить();
			КонецЕсли;
			
			Элемент.СписокВыбора.ЗагрузитьЗначения(_УФС.ПолучитьУслугиДоговора(АдресУслугПоДоговору));   
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УслугиКорректировкаПередУдалением(Элемент, Отказ)
	
	ТекущиеДанные 	= Элементы.УслугиКорректировка.ТекущиеДанные;
	Отказ 			= ТекущиеДанные.ЭтоДобавленнаяСтрока = ЛОЖЬ;
	
	Если Отказ Тогда
		ПоказатьПредупреждение(,"Удаляемая строка есть в корректируемом документе. Удаление запрещено!",30, "Ошибка удаления строки");
	КонецЕсли;

КонецПроцедуры

