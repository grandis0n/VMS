&НаКлиенте
Процедура ВыполнитьУдалениеВедомого(ВидВедомого)
	// --- 
	
	Если (ВидВедомого = "Документ") Тогда 
		
		ТекстВопроса = "Ведомый документ поступления будет отвязан и помечен на удаление. 
				   |Продолжить?";
				   
	ИначеЕсли (ВидВедомого = "СчетФактура") Тогда 
		
		ТекстВопроса = "Ведомый счёт-фактура поступления будет отвязан и помечен на удаление.
				   |Продолжить?";
				   
	ИначеЕсли (ВидВедомого = "Счет") или ВидВедомого = "СчетКорректировочный" Тогда 
		
		ТекстВопроса = "Ведомый счёт поступления будет отвязан и помечен на удаление.
				   |Продолжить?";
		
	КонецЕсли; 
	
	ПОВ = Новый ОписаниеОповещения("ОбработкаВопросаУдаленияВедомых",ЭтотОбъект, Новый Структура("ВидВедомого",ВидВедомого)); 
	ПоказатьВопрос(ПОВ,ТекстВопроса, РежимДиалогаВопрос.ДаНет); 
	
	// --- 
