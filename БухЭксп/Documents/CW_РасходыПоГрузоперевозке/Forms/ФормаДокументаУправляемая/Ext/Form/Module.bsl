&НаСервере
Процедура ОбновитьИтогиПоУслугам()
	//! ИтогоВсего
	
	// итоговая строка по табличной части "Услуги" 
	ПредставлениеВалюты 	= Строка(Объект.Валюта); 
	ПредставлениеВалютыРег	= Строка(ВалютаРегламентированногоУчета); 
	
	ФорматнаяСтрока = "ЧЦ=15; ЧДЦ=2; ЧН=";
	Если (НЕ Объект.Корректировка) Тогда
		
		Если Объект.Услуги.Количество() = 0 Тогда
			ИтогоПоУслугам = "Сведения об услугах отсутствуют";
		Иначе
			ИтогоПоУслугам=	"Строк: "+Объект.Услуги.Количество()+
			";  Сумма: "+Формат(Объект.Услуги.Итог("Сумма"),ФорматнаяСтрока)+" "+ПредставлениеВалюты+ 
			";  НДС: "+Формат(Объект.Услуги.Итог("НДС"),ФорматнаяСтрока)+" "+ПредставлениеВалюты+
			";  Всего: "+Формат(Объект.Услуги.Итог("Всего"),ФорматнаяСтрока)+" " +ПредставлениеВалюты; 
			
			Если Объект.ПоказатьРубли Тогда
				ИтогоПоУслугам=	ИтогоПоУслугам+
				";  Сумма: "+Формат(Объект.Услуги.Итог("СуммаРег"),ФорматнаяСтрока)+" "+ПредставлениеВалютыРег+ 
				";  НДС: "+Формат(Объект.Услуги.Итог("НДСРег"),ФорматнаяСтрока)+" "+ПредставлениеВалютыРег+
				";  Всего: "+Формат(Объект.Услуги.Итог("ВсегоРег"),ФорматнаяСтрока)+" " +ПредставлениеВалютыРег; 
			КонецЕсли;
			
		КонецЕсли;
		
		Если (КонтрольДокументовПоСумме) Тогда
			Отклонение = 0;
			Если (Объект.СуммаПоПервичномуДокументу <> 0) Тогда
				Если (Объект.Услуги.Итог("Всего") <> Объект.СуммаПоПервичномуДокументу) Тогда
					Отклонение = Объект.СуммаПоПервичномуДокументу - Объект.Услуги.Итог("Всего");
					Если (Отклонение <> 0) Тогда
						ИтогоПоУслугам = ИтогоПоУслугам + "; Отклонение от контрольной суммы: "+Формат(Отклонение,ФорматнаяСтрока)+" " +ПредставлениеВалюты;	
					КонецЕсли; 
				КонецЕсли; 
			КонецЕсли; 
			
			// управление цветом итоговой надписи при наличии отклонения от контрольной суммы
			Если Отклонение <> 0 Тогда
				Элементы.ИтогоПоУслугам.ЦветТекста = ЦветаСтиля.ЦветОсобогоТекста;
			Иначе
				Элементы.ИтогоПоУслугам.ЦветТекста = ЦветаСтиля.ЦветТекстаФормы;
			КонецЕсли; 
		КонецЕсли; // выполняется котроль суммы документа
		
	Иначе
		
		Если Объект.Услуги.Количество() = 0 Тогда
			ИтогоПоУслугам_Корректировка = "Сведения об услугах отсутствуют";
		Иначе
			ИтогоПоУслугам_Корректировка =	"Строк: "+Объект.Услуги.Количество()+
			";  Сумма: "+Формат(Объект.Услуги.Итог("Сумма")-Объект.Услуги.Итог("Сумма_ДоКорректировки"),ФорматнаяСтрока)+" "+ПредставлениеВалюты+ 
			";  НДС: "+Формат(Объект.Услуги.Итог("НДС")-Объект.Услуги.Итог("НДС_ДоКорректировки"),ФорматнаяСтрока)+" "+ПредставлениеВалюты+
			";  Всего: "+Формат(Объект.Услуги.Итог("Всего")-Объект.Услуги.Итог("Всего_ДоКорректировки"),ФорматнаяСтрока)+" " +ПредставлениеВалюты;  
			
			Если Объект.ПоказатьРубли Тогда
				ИтогоПоУслугам_Корректировка =	ИтогоПоУслугам_Корректировка +
				";  Сумма: "+Формат(Объект.Услуги.Итог("СуммаРег")-Объект.Услуги.Итог("Сумма_ДоКорректировкиРег"),ФорматнаяСтрока)+" "+ПредставлениеВалютыРег + 
				";  НДС: "+Формат(Объект.Услуги.Итог("НДСРег")-Объект.Услуги.Итог("НДС_ДоКорректировкиРег"),ФорматнаяСтрока)+" "+ПредставлениеВалютыРег +
				";  Всего: "+Формат(Объект.Услуги.Итог("ВсегоРег")-Объект.Услуги.Итог("Всего_ДоКорректировкиРег"),ФорматнаяСтрока)+" " +ПредставлениеВалютыРег ;  
			КонецЕсли;
		КонецЕсли;
		
		Если (КонтрольДокументовПоСумме) Тогда
			Отклонение = 0; 
			Если (Объект.СуммаПоПервичномуДокументу <> 0) Тогда
				Если (Объект.Услуги.Итог("Всего") <> Объект.СуммаПоПервичномуДокументу) Тогда
					Отклонение = Объект.СуммаПоПервичномуДокументу - (Объект.Услуги.Итог("Всего")-Объект.Услуги.Итог("Всего_ДоКорректировки"));
					Если Отклонение <> 0 Тогда
						ИтогоПоУслугам_Корректировка = ИтогоПоУслугам_Корректировка + "; Отклонение от контрольной суммы: "+Формат(Отклонение,ФорматнаяСтрока)+" " +ПредставлениеВалюты;	
					КонецЕсли; 
				КонецЕсли; 
			КонецЕсли; 
			
			// управление цветом итоговой надписи при наличии отклонения от контрольной суммы
			Если Отклонение <> 0 Тогда
				Элементы.ИтогоПоУслугам_Корректировка.ЦветТекста = ЦветаСтиля.ЦветОсобогоТекста;
			Иначе
				Элементы.ИтогоПоУслугам_Корректировка.ЦветТекста = ЦветаСтиля.ЦветТекстаФормы;
			КонецЕсли; 
		КонецЕсли; // выполняется котроль суммы документа
		

		
		
	КонецЕсли;
						
КонецПроцедуры

#КонецОбласти 

#Область УслугиРеквизиты

&НаКлиенте
Процедура УслугиГрузоперевозкаПриИзменении(Элемент)
	
	_УслугиГрузоперевозкаПриИзменении(Элементы.Услуги.ТекущаяСтрока);
	
КонецПроцедуры

&НаСервере
Процедура _УслугиГрузоперевозкаПриИзменении(Строка)
	
	ТребоватьЗаполненияПокупателя = _ДС().ПД.ТребоватьЗаполненияПокупателяДляПорядокаОтраженияЗатратыВРасходах;
	
	СтрокаТЧ = Объект.Услуги.НайтиПоИдентификатору(Строка);
	
	Если НЕ НеЗаменятьПредставлениеНоменклатуры Тогда
		ПараметрыШаблона = CW_Шаблоны.ПолучитьПараметрШаблонаУслуг();
		
		ПараметрыШаблона.Номенклатура 	= СтрокаТЧ.Номенклатура;
		ПараметрыШаблона.Объект 		= Объект;
		ПараметрыШаблона.Дата 			= Объект.Дата;
		ПараметрыШаблона.Договор 		= Объект.Договор;
		ПараметрыШаблона.ВидДоговора 	= Объект.Договор.ВидДоговора;
		ПараметрыШаблона.ПриложениеКДоговору = Объект.ПриложениеКДоговору;
		
		CW_Шаблоны.УстановитьПредставлениеНоменклатурыВСтроке(СтрокаТЧ, ПараметрыШаблона); 
	КонецЕсли;
	// --- 
	Если СтрокаТЧ.ПорядокОтражения = Перечисления.CW_ПорядокОтраженияЗатрат.Затраты Тогда 
		
		Если ТребоватьЗаполненияПокупателя Тогда
			СтруктураПараметров 	= ПодготовитьДанныеДляПолученияДанныхпокупателя(Строка);
			СтруктураДанныхСтроки 	= ПолучитьДанныеПокупателя(СтруктураПараметров);
			
			Если СтруктураДанныхСтроки.Свойство("Покупатель") Тогда
				СтрокаТЧ.Покупатель 		 = СтруктураДанныхСтроки.Покупатель;
			КонецЕсли;
			Если СтруктураДанныхСтроки.Свойство("ДоговорПокупателя") Тогда
				СтрокаТЧ.ДоговорПокупателя 	 = СтруктураДанныхСтроки.ДоговорПокупателя;
			КонецЕсли;
			Если СтруктураДанныхСтроки.Свойство("ПриложениеКДоговору") Тогда
				СтрокаТЧ.ПриложениеКДоговору = СтруктураДанныхСтроки.ПриложениеКДоговору;
			КонецЕсли;
			Если СтруктураДанныхСтроки.Свойство("УчетПриложений") Тогда
				СтрокаТЧ.УчетПриложенийПоДоговору = СтруктураДанныхСтроки.УчетПриложений;
			КонецЕсли;
		КонецЕсли;
		
		_ПодставитьПодразделение(СтрокаТЧ);
		
	Иначе
		СтруктураПараметров 	= ПодготовитьДанныеДляПолученияДанныхпокупателя(Строка);
		СтруктураДанныхСтроки 	= ПолучитьДанныеПокупателя(СтруктураПараметров);
		
		Если СтруктураДанныхСтроки.Свойство("Покупатель") Тогда
			СтрокаТЧ.Покупатель 		 = СтруктураДанныхСтроки.Покупатель;
		КонецЕсли;
		Если СтруктураДанныхСтроки.Свойство("ДоговорПокупателя") Тогда
			СтрокаТЧ.ДоговорПокупателя 	 = СтруктураДанныхСтроки.ДоговорПокупателя;
		КонецЕсли;
		Если СтруктураДанныхСтроки.Свойство("ПриложениеКДоговору") Тогда
			СтрокаТЧ.ПриложениеКДоговору = СтруктураДанныхСтроки.ПриложениеКДоговору;
		КонецЕсли;
		Если СтруктураДанныхСтроки.Свойство("УчетПриложений") Тогда
			СтрокаТЧ.УчетПриложенийПоДоговору = СтруктураДанныхСтроки.УчетПриложений;
		КонецЕсли;
	КонецЕсли; 
	
	ЗаполнитьДополнительныеКолонкиТабличнойЧасти();
	
	#Область Динамический_вывод_дополнительных_колонок
	
	_УФС.ОбновитьЗначенияПараметровГрузоперевозкиПоСтроке(СтрокаТЧ, ПолучитьСтруктуруПараметровДляПередачи());	
	
	#КонецОбласти
	
	// --- 
КонецПроцедуры

&НаСервере
Процедура _ПодставитьПодразделение(СтрокаТЧ)
	
	Если НЕ _ДС().УП.ГруппировкаЗатратПоПодразделениям 
		или НЕ СтрокаТЧ.Подразделение.Пустая() 
		или СтрокаТЧ.Грузоперевозка.Пустая() Тогда
		Возврат;
	КонецЕсли;     

	ПодразделениеЗатрат		= ПредопределенноеЗначение("Справочник.ПодразделенияОрганизаций.ПустаяСсылка");

	ПараметрПодразделения 	= Константы.CW_ПараметрПодразделенияЗатрат.Получить(); 
	Если Не ПараметрПодразделения.Пустая() Тогда   
		
		СтруктураЗначения 	= РегистрыСведений.CW_ХарактеристикиГрузоперевозок.ПолучитьЗначениеПараметра(СтрокаТЧ.Грузоперевозка, ПараметрПодразделения); 
		ПодразделениеЗатрат = СтруктураЗначения.Значение;
		
		Если НЕ ЗначениеЗаполнено(ПодразделениеЗатрат) и ЗначениеЗаполнено(СтрокаТЧ.Грузоперевозка.Заказ) Тогда
			СтруктураЗначения 	= РегистрыСведений.CW_ХарактеристикиЗаказов.ПолучитьЗначениеПараметра(СтрокаТЧ.Грузоперевозка.Заказ, ПараметрПодразделения); 
			ПодразделениеЗатрат = СтруктураЗначения.Значение;
		КонецЕсли;
		
	КонецЕсли; 
	
	Если НЕ ЗначениеЗаполнено(ПодразделениеЗатрат) Тогда
		ПодразделениеЗатрат = CW_Настройки.ПараметрУчетнойПолитики(Объект.Дата, Объект.Организация, "ОсновноеПодразделение");
	КонецЕсли;
	
	СтрокаТЧ.Подразделение = ПодразделениеЗатрат;
	
КонецПроцедуры

&НаКлиенте
Процедура УслугиНоменклатураПриИзменении(Элемент)
	
	_УслугиНоменклатураПриИзменении(Элементы.Услуги.ТекущаяСтрока);
	
КонецПроцедуры

&НаСервере
Процедура _УслугиНоменклатураПриИзменении(Строка)
	
	ТребоватьЗаполненияПокупателя = _ДС().ПД.ТребоватьЗаполненияПокупателяДляПорядокаОтраженияЗатратыВРасходах;

	СтрокаТЧ = Объект.Услуги.НайтиПоИдентификатору(Строка);
	Если ЗначениеЗаполнено(СтрокаТЧ.Номенклатура) Тогда 
		
		Если РазрешитьПолучениеКоличестваУслугИзпараметраГрузоперевозки тогда
			
			//Получаем количество из Параметра
			ЗначениеПараметра   = 0;
			СтруктураПараметров = Новый Структура("ТипПеревозки,Номенклатура,ЕдиницаИзмерения", СтрокаТЧ.Грузоперевозка.ТипПеревозки,СтрокаТЧ.Номенклатура,СтрокаТЧ.Номенклатура.ЕдиницаИзмерения);		
			НайденныйПараметр 	= CW_Документы.ПолучитьПараметрДляПодстановкиЗначенияВКоличество(СтруктураПараметров);
			
			Если НайденныйПараметр <> Неопределено Тогда
				//Получаем только первое значение
				СтрокаПараметраГП = СтрокаТЧ.Грузоперевозка.ПараметрыГрузоперевозки.Найти(НайденныйПараметр, "Параметр");
				
				Если СтрокаПараметраГП <> Неопределено Тогда
					ЗначениеПараметра =  СтрокаПараметраГП.Значение;
				КонецЕсли;
				
				Если Не УстановитьЗначениеНольЗначениеПараметраНеУстановлено и Не ЗначениеЗаполнено(ЗначениеПараметра) Тогда
					ЗначениеПараметра = 1;
				КонецЕсли;
				
				СтрокаТЧ.Количество =  ЗначениеПараметра;
				
			КонецЕсли;	
			
		КонецЕсли;
		
		Если _ДС().НП.ПодставлятьСтавкуНДС или Не ЗначениеЗаполнено(СтрокаТЧ.СтавкаНДС) Тогда
			
			ПараметрыСтавкиНДС = Новый Структура;
			ПараметрыСтавкиНДС.Вставить("Дата", 		Объект.Дата);
			ПараметрыСтавкиНДС.Вставить("Организация", 	Объект.Организация);
			ПараметрыСтавкиНДС.Вставить("Номенклатура", СтрокаТЧ.Номенклатура);
			ПараметрыСтавкиНДС.Вставить("Договор", 		Объект.Договор); 
			ПараметрыСтавкиНДС.Вставить("ПодставлятьСтавкуНДС", _ДС().НП.ПодставлятьСтавкуНДС);
			ПараметрыСтавкиНДС.Вставить("ТипДвижения", "РАСХОДЫ");
			
			ПолученнаяСтавкаНДС = CW_Документы.ПолучитьСтавкуНДС(ПараметрыСтавкиНДС);
			
			// пересчет суммовых показателей осуществляем, только при изменении ставки НДС
			Если СтрокаТЧ.СтавкаНДС <> ПолученнаяСтавкаНДС Тогда
				СтрокаТЧ.СтавкаНДС = ПолученнаяСтавкаНДС;
				
				ТД = СтрокаТЧ;
				ТД.Сумма = ТД.Цена * ТД.Количество;
				ТД.НДС = ТД.Сумма * CW_Финансы.ПолучитьСтавкуНДС(ТД.СтавкаНДС)/100;
				ТД.Всего = ТД.Сумма + ТД.НДС;
			КонецЕсли; 
			
		КонецЕсли;
		
		// пробуем найти в регистре
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		|	CW_СтатьиЗатратНоменклатуры.СтатьяЗатрат
		|ИЗ
		|	РегистрСведений.CW_СтатьиЗатратНоменклатуры КАК CW_СтатьиЗатратНоменклатуры
		|ГДЕ
		|	CW_СтатьиЗатратНоменклатуры.Номенклатура = &Номенклатура";
		Запрос.УстановитьПараметр("Номенклатура", СтрокаТЧ.Номенклатура);
		ТЗ = Запрос.Выполнить().Выгрузить();
		СтрокаСтатьяЗатрат = _сф.к_ПервыйЭлемент(ТЗ);
		Если (СтрокаСтатьяЗатрат <> Неопределено) Тогда
			СтрокаТЧ.СтатьяЗатрат = СтрокаСтатьяЗатрат.СтатьяЗатрат;
		Иначе
			СтрокаТЧ.СтатьяЗатрат = _ДС().УП.ОсновнаяСтатьяЗатрат;
		КонецЕсли; 
		
		Если СтрокаТЧ.ПорядокОтражения <> Перечисления.CW_ПорядокОтраженияЗатрат.Перевыставление И СтрокаТЧ.ПорядокОтражения <> Перечисления.CW_ПорядокОтраженияЗатрат.ПеревыставлениеПоСтавкам Тогда
			
			СтруктураПараметров = Новый Структура;
			СтруктураПараметров.Вставить("Дата"					, Объект.Дата);
			СтруктураПараметров.Вставить("Организация"			, Объект.Организация);
			СтруктураПараметров.Вставить("Номенклатура"			, СтрокаТЧ.Номенклатура);
			СтруктураПараметров.Вставить("НоменклатурнаяГруппа"	, СтрокаТЧ.Номенклатура.НоменклатурнаяГруппа);
			
			СтрокаТЧ.СпособУчетаНДС = CW_Финансы.ПолучитьСпособУчетаНДС(СтруктураПараметров);
			
		КонецЕсли;	
		
		
		
	КонецЕсли;
	
	Если (СтрокаТЧ.Количество = 0) Тогда
		СтрокаТЧ.Количество = 1;
	КонецЕсли;
	
	Если НЕ НеЗаменятьПредставлениеНоменклатуры Тогда
		// пробуем переформировать представление номенклатуры
		ПараметрыШаблона = CW_Шаблоны.ПолучитьПараметрШаблонаУслуг();
		
		ПараметрыШаблона.Номенклатура 	= СтрокаТЧ.Номенклатура;
		ПараметрыШаблона.Объект 		= Объект;
		ПараметрыШаблона.Дата 			= Объект.Дата;
		ПараметрыШаблона.Договор 		= Объект.Договор;
		ПараметрыШаблона.ВидДоговора 	= Объект.Договор.ВидДоговора;
		ПараметрыШаблона.ПриложениеКДоговору = Объект.ПриложениеКДоговору;
		
		CW_Шаблоны.УстановитьПредставлениеНоменклатурыВСтроке(СтрокаТЧ, ПараметрыШаблона); 
		
	КонецЕсли;

	//Если есть ограничение услуг по договору то берем цену оттуда 
	ИспользуетсяОгранчиениеУслуг = ПолучитьОграничениеУслугПоНоменклатуре(СтрокаТЧ.ПорядокОтражения);
	Если ИспользуетсяОгранчиениеУслуг Тогда
		
		Если ЭтоАдресВременногоХранилища(АдресУслугПоДоговору) Тогда
			
			СтруктураПараметров = Новый Структура;
			СтруктураПараметров.Вставить("АдресУслугПоДоговору"						, АдресУслугПоДоговору);
			СтруктураПараметров.Вставить("УстанавливатьЦенуВЗависимостиОтГруза"		, УстанавливатьЦенуВЗависимостиОтГруза);
			СтруктураПараметров.Вставить("УстанавливатьЦенуВЗависимостиОтКлиента"	, УстанавливатьЦенуВЗависимостиОтКлиента);
			
			СтруктураПараметров.Вставить("Номенклатура"							, СтрокаТЧ.Номенклатура);
			Если УстанавливатьЦенуВЗависимостиОтГруза Тогда
				СтруктураПараметров.Вставить("Груз" , СтрокаТЧ.Грузоперевозка.Груз);
			КонецЕсли;
			Если УстанавливатьЦенуВЗависимостиОтКлиента тогда
				
				СтруктураПараметровКлиента = Новый Структура;
				СтруктураПараметровКлиента.Вставить("Объект"				, СтрокаТЧ.Грузоперевозка);
				СтруктураПараметровКлиента.Вставить("ЭтоВариантБюджета"		, Ложь);
				СтруктураПараметровКлиента.Вставить("Контрагент"			, СтрокаТЧ.Грузоперевозка.Клиент);
				
				тПокупатель = CW_Финансы.ВернутьПлательщика(СтруктураПараметровКлиента);
				СтруктураПараметров.Вставить("Клиент", тПокупатель);
			КонецЕсли;
			
			УслугаДоговора = _УФС.ПолучитьУслугуДоговораПоПараметрам(СтруктураПараметров);		

			Если УслугаДоговора <> Неопределено Тогда
				
				Если СтрокаТЧ.СтавкаНДС <> УслугаДоговора.СтавкаНДС и ЗначениеЗаполнено(УслугаДоговора.СтавкаНДС) Тогда
					СтрокаТЧ.СтавкаНДС = УслугаДоговора.СтавкаНДС;
				КонецЕсли;
				
				Если ЗначениеЗаполнено(УслугаДоговора.ПорядокОтражения) Тогда
					СтрокаТЧ.ПорядокОтражения = УслугаДоговора.ПорядокОтражения;
					
					// значение заполнено
					
					_ПриИзмененииУслугиПорядокОтражения(СтрокаТЧ.ПолучитьИдентификатор());
					
					Если (СтрокаТЧ.ПорядокОтражения <> ПредопределенноеЗначение("Перечисление.CW_ПорядокОтраженияЗатрат.Затраты")) Тогда
						Если (Элементы.УслугиСпособУчетаНДС.Видимость) Тогда
							СтрокаТЧ.СпособУчетаНДС = Неопределено;	
						КонецЕсли; 
						
						СтруктураПараметров 	= ПодготовитьДанныеДляПолученияДанныхпокупателя(СтрокаТЧ.ПолучитьИдентификатор());
						СтруктураДанныхСтроки 	= ПолучитьДанныеПокупателя(СтруктураПараметров);
						
						Если СтруктураДанныхСтроки.Свойство("Покупатель") Тогда
							СтрокаТЧ.Покупатель 		 	= СтруктураДанныхСтроки.Покупатель;
						КонецЕсли;
						Если СтруктураДанныхСтроки.Свойство("ДоговорПокупателя") Тогда
							СтрокаТЧ.ДоговорПокупателя 		= СтруктураДанныхСтроки.ДоговорПокупателя;
						КонецЕсли;
						Если СтруктураДанныхСтроки.Свойство("ПриложениеКДоговору") Тогда
							СтрокаТЧ.ПриложениеКДоговору = СтруктураДанныхСтроки.ПриложениеКДоговору;
						КонецЕсли;
						Если СтруктураДанныхСтроки.Свойство("УчетПриложений") Тогда
							СтрокаТЧ.УчетПриложенийПоДоговору = СтруктураДанныхСтроки.УчетПриложений;
						КонецЕсли;
					Иначе
						Если ТребоватьЗаполненияПокупателя Тогда
							СтруктураПараметров 	= ПодготовитьДанныеДляПолученияДанныхпокупателя(СтрокаТЧ.ПолучитьИдентификатор());
							СтруктураДанныхСтроки 	= ПолучитьДанныеПокупателя(СтруктураПараметров);
							
							Если СтруктураДанныхСтроки.Свойство("Покупатель") Тогда
								СтрокаТЧ.Покупатель 		 	= СтруктураДанныхСтроки.Покупатель;
							КонецЕсли;
							Если СтруктураДанныхСтроки.Свойство("ДоговорПокупателя") Тогда
								СтрокаТЧ.ДоговорПокупателя 		= СтруктураДанныхСтроки.ДоговорПокупателя;
							КонецЕсли;
							Если СтруктураДанныхСтроки.Свойство("ПриложениеКДоговору") Тогда
								СтрокаТЧ.ПриложениеКДоговору = СтруктураДанныхСтроки.ПриложениеКДоговору;
							КонецЕсли;
							Если СтруктураДанныхСтроки.Свойство("УчетПриложений") Тогда
								СтрокаТЧ.УчетПриложенийПоДоговору = СтруктураДанныхСтроки.УчетПриложений;
							КонецЕсли;
						КонецЕсли;
					КонецЕсли; 
					
				КонецЕсли;
				
				Если УслугаДоговора.ВариантРасчетаНДС = Перечисления.ВариантыРасчетаНДС.НДССверху тогда
					СтрокаТЧ.Сумма 		= УслугаДоговора.ЦенаБезНДС * СтрокаТЧ.Количество;
					ОбратныйПересчет = Ложь;
				Иначе //в сумме
					СтрокаТЧ.Всего = УслугаДоговора.Цена * СтрокаТЧ.Количество;
					ОбратныйПересчет = Истина;
				КонецЕсли;
				
				Ставка = CW_Финансы.ПолучитьСтавкуНДС(УслугаДоговора.СтавкаНДС);
				
				Если ОбратныйПересчет Тогда
					СтрокаТЧ.НДС 	= СтрокаТЧ.Всего*(Ставка/(100+Ставка));
					СтрокаТЧ.Сумма 	= СтрокаТЧ.Всего - СтрокаТЧ.НДС;
					СтрокаТЧ.Цена 	= _сф.БезопасноРазделить(СтрокаТЧ.Сумма,СтрокаТЧ.Количество);
				Иначе
					СтрокаТЧ.Цена 	= _сф.БезопасноРазделить(СтрокаТЧ.Сумма,СтрокаТЧ.Количество);
					СтрокаТЧ.НДС 	= СтрокаТЧ.Сумма*(Ставка/100);
					СтрокаТЧ.Всего 	= СтрокаТЧ.Сумма+СтрокаТЧ.НДС;
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли; 
	Иначе
		
		// установка цены номенклатуры
		ТД = СтрокаТЧ;
		Если ТД.Цена = 0  Тогда
			
			ТипЦен = _ДС().ПД.ТипЦен;
			Если НЕ ТипЦен.Пустая() Тогда
				
				СК = CW_Финансы.ПолучитьКурсВалюты(Объект.Валюта,_ДатаВозникновенияЗадолженности());
				Цена = Ценообразование.ПолучитьЦенуНоменклатуры(СтрокаТЧ.Номенклатура, ТипЦен, _ДатаВозникновенияЗадолженности(), Объект.Валюта, СК.Курс,СК.Кратность);
				Если Цена <> 0 Тогда
					
					Если ТипЦен.ЦенаВключаетНДС Тогда
						Если ЗначениеЗаполнено(ТД.СтавкаНДС) И ЗначениеЗаполнено(ТД.Количество) Тогда
							ТД.Всего = Цена*ТД.Количество;
							Ставка = CW_Финансы.ПолучитьСтавкуНДС(ТД.СтавкаНДС)/100;
							ТД.НДС = ТД.Всего*Ставка/(1+Ставка);
							ТД.Сумма = ТД.Всего - ТД.НДС;
							ТД.Цена = _сф.БезопасноРазделить(ТД.Сумма,ТД.Количество);
						Иначе
							Если ЗначениеЗаполнено(ТД.СтавкаНДС) Тогда
								Ставка = CW_Финансы.ПолучитьСтавкуНДС(ТД.СтавкаНДС)/100;
								ТД.Цена = Цена/(1+Ставка);
							КонецЕсли; 
						КонецЕсли; 
					Иначе
						Если ЗначениеЗаполнено(ТД.СтавкаНДС) И ЗначениеЗаполнено(ТД.Количество) Тогда
							ТД.Цена = Цена;
							ТД.Сумма = ТД.Цена * ТД.Количество;
							ТД.НДС = ТД.Сумма * CW_Финансы.ПолучитьСтавкуНДС(ТД.СтавкаНДС)/100;
							ТД.Всего = ТД.Сумма + ТД.НДС;
						Иначе
							
							ТД.Цена = Цена;
						КонецЕсли; 
					КонецЕсли;
					
				КонецЕсли; 
			КонецЕсли; 
		КонецЕсли; 
	КонецЕсли; 
	
	ПересчитатьСтрокуНаСерере(СтрокаТЧ.ПолучитьИдентификатор(),Объект.ЦенаСНДС);
	
	
КонецПроцедуры

&НаКлиенте
Процедура УслугиНоменклатураНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)

	ИспользуетсяОгранчиениеУслуг = ПолучитьОграничениеУслугПоНоменклатуре(Элементы.Услуги.ТекущиеДанные.ПорядокОтражения);	
	Если Не ИспользуетсяОгранчиениеУслуг Тогда      
		
		ВыбранноеЗначение = Элементы.Услуги.ТекущиеДанные.Номенклатура;	
		_УФК.ВыбратьНоменклатуру(ВыбранноеЗначение,Элемент,ДанныеВыбора,СтандартнаяОбработка);
		
	Иначе

		СписокЗначений = Новый СписокЗначений;
		Если ЭтоАдресВременногоХранилища(АдресУслугПоДоговору) Тогда
			МассивУслуг =  _УФС.ПолучитьУслугиДоговора(АдресУслугПоДоговору);
			СписокЗначений.ЗагрузитьЗначения(МассивУслуг);
		КонецЕсли; 
		
		Если СписокЗначений.Количество() = 0 Тогда
			Сообщение = новый СообщениеПользователю;
			Сообщение.Текст   		= "Не определен список услуг по договору!";
			Сообщение.ПутьКДанным  	= "Объект";
			Сообщение.Поле    		= "Договор";
			Сообщение.Сообщить();
			
		Конецесли;
		
		ДанныеВыбора = СписокЗначений;
		СтандартнаяОбработка = Ложь;
		
	Конецесли;
	
КонецПроцедуры

&НаКлиенте
Процедура УслугиПредставлениеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка=Ложь;
	_УслугиПредставлениеНачалоВыбора(Элементы.Услуги.ТекущаяСтрока);
	Элементы.Услуги.ТекущийЭлемент = Элементы.УслугиПорядокОтражения;
	Элементы.Услуги.ТекущийЭлемент = Элементы.УслугиПредставление;
	
КонецПроцедуры

