&НаСервере
Процедура ПриЗакрытииНаСервере()
	
	мВыбранныеКолонки = Новый Массив;
	
	Для Каждого ЭлементСписка из СписокДополнительныхКолонок Цикл
		Если ЭлементСписка.Пометка Тогда
			мВыбранныеКолонки.Добавить(ЭлементСписка.Значение);
		КонецЕсли;
	КонецЦикла;
	
	Настройка = Новый Структура;
	Настройка.Вставить("ВыбранныеКолонки"	, мВыбранныеКолонки);
	
	ХранилищеСистемныхНастроек.Сохранить(ЭтаФорма.ИмяФормы, "CW_РасходыПоГрузоперевозке",Настройка);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	
	Если Не ЗавершениеРаботы Тогда
		ПриЗакрытииНаСервере();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект) 
	
	СостояниеДокумента = ОбщегоНазначенияБП.СостояниеДокумента(Объект); // ВызовБП
	
	Если ЗначениеЗаполнено(ТекущийОбъект.ИдентификаторДокументаПоставщика) Тогда
		ИдентификаторДокументаПоставщика = СокрЛП(ТекущийОбъект.ИдентификаторДокументаПоставщика);
	КонецЕсли; 
	
	ЗаполнитьДополнительныеКолонкиТабличнойЧасти();

	//Подсистема.УчетПриложенийДоговоров
	CW_УчетПриложенийДоговоровСервер.УстановитьПризнакУчетаПоПриложениямВТабличнойЧасти(ЭтаФорма, "Услуги", "ДоговорПокупателя");
	//Подсистема.УчетПриложенийДоговоров 
	
	Если ИспользоватьДопРеквизиты Тогда
		// СтандартныеПодсистемы.Свойства
		УправлениеСвойствами.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
		// Конец СтандартныеПодсистемы.Свойства
	КонецЕсли;
	
	//ДатыЗапретаИзменения
	//Проверяем дату запрета по документам БУ
	мОбъектыПроверки = ПолучитьМассивОбъектовДляПроверки();
	Для Каждого ЭлементМассива из мОбъектыПроверки Цикл
		//Есть ведомые документы, проверяем дату запрета редактирования БП
		ОбъектМассива = ЭлементМассива.ПолучитьОбъект();
		Разрешено = ДатыЗапретаИзменения.ОбъектПриЧтенииНаСервере(ЭтотОбъект, ОбъектМассива);
		Если не Разрешено Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	//ДатыЗапретаИзменения

КонецПроцедуры

&НаСервере
Функция ПолучитьМассивОбъектовДляПроверки()
	
	Результат = Новый Массив;
	
	Если ЗначениеЗаполнено(Объект.ВедомыйДокумент) Тогда
		Результат.Добавить(Объект.ВедомыйДокумент);
	КонецЕсли;
	Если ЗначениеЗаполнено(Объект.ВедомыйСчетФактура) Тогда
		Результат.Добавить(Объект.ВедомыйСчетФактура);
	КонецЕсли;
	Если ЗначениеЗаполнено(Объект.ВедомыйСчет) Тогда
		Результат.Добавить(Объект.ВедомыйСчет);
	КонецЕсли;
	Если ЗначениеЗаполнено(Объект.ВедомыйДокументКорректировки) Тогда
		Результат.Добавить(Объект.ВедомыйДокументКорректировки);
	КонецЕсли;
	Если ЗначениеЗаполнено(Объект.ВедомыйСчетФактураКорректировочный) Тогда
		Результат.Добавить(Объект.ВедомыйСчетФактураКорректировочный);
	КонецЕсли;
	Если ЗначениеЗаполнено(Объект.ВедомыйСчетКорректировочный) Тогда
		Результат.Добавить(Объект.ВедомыйСчетКорректировочный);
	КонецЕсли;
	
	Возврат Результат; 
	
КонецФункции


&НаСервере
Процедура УстановитьАдресСпискаУслугПоДоговору()
	
	Если ОграничиватьУслугиПоДоговорам и ЗначениеЗаполнено(Объект.Договор) Тогда
		ЕстьОграниченияПоСпискуУслуг =?(ЗначениеЗаполнено(Объект.Договор), Объект.Договор.ОграничиватьНоменклатуру, Ложь);
		Если ЕстьОграниченияПоСпискуУслуг Тогда       
			
			ДатаДокумента = Объект.Дата;
			Если Объект.ПредъявленАкт
				и ЗначениеЗаполнено(Объект.ДатаАкта) Тогда
				ДатаДокумента = Объект.ДатаАкта;  
			ИначеЕсли Объект.ПредъявленСчет 
				и ЗначениеЗаполнено(Объект.ДатаСчета) Тогда
				ДатаДокумента = Объект.ДатаСчета;  
			КонецЕсли;      

			АдресУслугПоДоговору = _УФС.ОбновитьСписокУслугПоДоговору(ДатаДокумента,Объект.Договор, ЭтаФорма);
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&наСервере
Процедура УстановитьЗаголовокНадписиКомментарияДоговора()
	
	КомментарийДоговора = ?(Объект.Договор.Пустая(),"", СокрЛП(Объект.Договор.Комментарий));
	
	Элементы.НадписьКомментарийДоговора.Видимость = ОтображатьКомментарийДоговора и ЗначениеЗаполнено(КомментарийДоговора);
	Элементы.НадписьКомментарийДоговора.Заголовок = КомментарийДоговора;
	
КонецПроцедуры


#КонецОбласти 

#Область ИнициализацияФормы 

&НаСервере
Процедура _ИнициализацияФормы()
	
	// заполнение данных
	_СформироватьОбщиеПараметры();
	_ПроверитьРежимВводаОстатков();
	_СформироватьКурс();
	ОбновитьНомераДокументовНаСервере();
	
	// --- 
	Если (Объект.Ссылка.Пустая()) Тогда
		
		Объект.Ответственный = Неопределено;
		
	КонецЕсли; 
	// --- 
	
	// для документов "счет" обновим таблицу связанных актов и оплат
	ВыводитьСвязанныеАктыОплаты = (НЕ Объект.Ссылка.Пустая()); 
	ВыводитьСвязанныеАктыОплаты = (ВыводитьСвязанныеАктыОплаты И НЕ (Объект.ПредъявленАкт ИЛИ Объект.ПредъявленСФ));
	ВыводитьСвязанныеАктыОплаты = (ВыводитьСвязанныеАктыОплаты И НЕ Объект.Корректировка);
	Если (ВыводитьСвязанныеАктыОплаты) Тогда
		_ОбновитьАкты();
	КонецЕсли; 
	
	// проверяем на закрытие (кроме корректировки)
	Если (НЕ РеквизитФормыВЗначение("Объект").ПроверитьЗакрытиеГрузоперевозок() И НЕ Объект.Корректировка) Тогда
		
		ЭтаФорма.ТолькоПросмотр = Истина;
		Элементы.ГруппаИнфо.Видимость = Истина;
		Элементы.ДекорацияИнфо.Заголовок = "Документ доступен только для просмотра, т.к. содержит блокированные грузоперевозки!";
		// --- 
		Элементы.УслугиИзменить.Доступность = Ложь;
		Элементы.УслугиУслуги_ПереформироватьПредставление.Доступность = Ложь;
		Элементы.УслугиГруппаЗаполнить.Видимость = Ложь;
		// --- 
		Элементы.ЗачетАвансов.ТолькоПросмотр = Истина;
		Элементы.ЗачетАвансовОЗ.ТолькоПросмотр = Истина;
		// --- 
		Элементы.ЗачетАвансовЗаполнитьАвансы.Доступность = Ложь;
		Элементы.ЗачетАвансовОЗ_Заполнить.Доступность = Ложь;
		// --- 
		Элементы.ЗачетАвансовАвансы_Открыть.Доступность = Ложь;
		Элементы.ЗачетАвансовОЗ_Открыть.Доступность = Ложь;
		// --- 
		Элементы.ЗачетАвансовУдалить.Доступность = Ложь;
		Элементы.ЗачетАвансовОЗ_Удалить.Доступность = Ложь;
		// --- 
		Элементы.ЗачетАвансовАвансы_Очистить.Доступность = Ложь;
		Элементы.ЗачетАвансовОЗ_Очистить.Доступность = Ложь;
		
		Элементы.Заявки.ТолькоПросмотр = Истина;
		Элементы.СоздатьЗаявку.Доступность = ложь;
	Иначе
		//// права
		//Если ЭтотОбъект.ТолькоПросмотр = Ложь Тогда   //AFR-233633
			_ПраваДоступа();
		//КонецЕсли;  //AFR-233633
	КонецЕсли; 
	
	//// видимость доп.действий
	//СписокДействий = _СписокДействий();
	//Если (СписокДействий.Количество() = 0) Тогда
	//	Элементы.ФормаВнешниеДействия.Видимость = Ложь;
	//КонецЕсли; 
	
	// обновляем итоговые строки табличных частей 
	ОбновлятьИтоги = (НЕ Объект.Корректировка);
	Если (ОбновлятьИтоги) Тогда
		ОбновитьИтогиПоУслугам();
		ОбновитьИтогиПоАвансам();
	КонецЕсли; 
	
	
	// маркеры блокированных грузоперевозок
	АдресДефис = ПоместитьВоВременноеХранилище(БиблиотекаКартинок.CW_ЭлементСписка, ЭтаФорма.УникальныйИдентификатор);
	АдресЗамок = ПоместитьВоВременноеХранилище(БиблиотекаКартинок.CW_Замок, ЭтаФорма.УникальныйИдентификатор);
	
	// --- 
	Элементы.УслугиПорядокОтражения.РежимВыбораИзСписка=Истина;
	Элементы.УслугиПорядокОтражения.ОтображениеКнопкиВыбора = ОтображениеКнопкиВыбора.ОтображатьВПолеВвода;
	Элементы.УслугиПорядокОтражения.ИсторияВыбораПриВводе=ИсторияВыбораПриВводе.НеИспользовать;
	// --- 
	Элементы.УслугиПорядокОтражения.СписокВыбора.Очистить();
	Элементы.УслугиПорядокОтражения.СписокВыбора.Добавить(Перечисления.CW_ПорядокОтраженияЗатрат.Затраты);
	Элементы.УслугиПорядокОтражения.СписокВыбора.Добавить(Перечисления.CW_ПорядокОтраженияЗатрат.Перевыставление);
	ПеревыставлениеПоСтавкам = ПолучитьФункциональнуюОпцию("CW_ИспользованиеСхемыПеревыставленияПоСтавкам");
	Если (ПеревыставлениеПоСтавкам) Тогда
		Элементы.УслугиПорядокОтражения.СписокВыбора.Добавить(Перечисления.CW_ПорядокОтраженияЗатрат.ПеревыставлениеПоСтавкам);
	КонецЕсли; 
	Элементы.УслугиПорядокОтражения.СписокВыбора.Добавить(Перечисления.CW_ПорядокОтраженияЗатрат.ПрочиеРасходы);
	// --- 
	
	// --- 
	Элементы.УслугиНоменклатурнаяГруппа.Видимость = _ДС().НП.ОтображатьНоменклатурнуюГруппу;
	Элементы.УслугиЕИ.Видимость = _ДС().НП.ОтображатьЕИ;
	Элементы.УслугиКорректировкаЕИ.Видимость = _ДС().НП.ОтображатьЕИ;
	
	//КонтрольДокументовПоСумме = CW_Настройки.ПолучитьНастройкуПользователя(CW_Настройки.Пользователь(),"КонтрольВходящихДокументовПоСумме");
	структураНастройкиПользователя = CW_Настройки.ПолучитьНастройкиПользователя();    
	ПодразделениеПользователя = структураНастройкиПользователя.ПодразделениеПользователя;
	КонтрольДокументовПоСумме = структураНастройкиПользователя.КонтрольВходящихДокументовПоСумме;
	
	//// регенерация формы
	//МассивИсключаемых = Новый Массив;
	//МассивИсключаемых.Добавить("Объект.Услуги.Грузоперевозка");
	//МассивИсключаемых.Добавить("Объект.Услуги.Номенклатура");
	//МассивИсключаемых.Добавить("Объект.Услуги.СтатьяЗатрат");
	//МассивИсключаемых.Добавить("Объект.Услуги.Подразделение");
	//_УФС.ОтключитьИсториюВыбораЭлементовФормы(ЭтаФорма, МассивИсключаемых);
	// --- 
	_УправлениеЭлементамиФормы();
	_СформироватьЗаголовок();
	ЗаполнитьДополнительныеКолонкиТабличнойЧасти();
	
	Элементы.УслугиКартинкаФинансовыйСтатус.Видимость = _ДС().НП.ВыводитьФинансовыйСтатусВДокументах;
	
	// --- 
	
	Элементы.ПредставлениеАкта.Видимость 			= ВалютаРегламентированногоУчетаРубль;
	Элементы.ПредставлениеСчетаФактуры.Видимость 	= ВалютаРегламентированногоУчетаРубль;
	
	//Исправления
	УстановитьВидимостьЭлементовИсправления();
	//Исправления
	
	УстановитьПараметрыВыбораСтавкиНДС();
	
КонецПроцедуры
 

&НаСервере
Процедура _ПраваДоступа()
	
	БазоваяВалютаРубль = Константы.CW_ВалютаРегламентированногоУчетаРубль.Получить();
	
	ЭтоСчет 	= Объект.ПредъявленСчет;
	ЭтоАкт 		= Не Объект.ПредъявленСчет и (Объект.ПредъявленАкт или Объект.ПредъявленСФ);
	ЭтоПакет 	= Объект.ПредъявленСчет и (Объект.ПредъявленАкт или Объект.ПредъявленСФ);
	
	ПравоРедактирования = CW_ПраваДоступа.ПравоДоступно("РедактированиеФинансов");
	
	Если ПравоРедактирования и ЭтоСчет Тогда
		ПравоРедактирования = CW_ПраваДоступа.ПравоДоступно("РедактированиеФинансов_Расходы_Счета");
	Конецесли;
	
	Если ПравоРедактирования и Объект.Корректировка Тогда
		ПравоРедактирования = CW_ПраваДоступа.ПравоДоступно("РедактированиеФинансов_Корректировки");
	КонецЕсли;
	
	Если БазоваяВалютаРубль Тогда
		
		Если ПравоРедактирования и ЭтоАкт Тогда
			ПравоРедактирования = CW_ПраваДоступа.ПравоДоступно("РедактированиеФинансов_Расходы_Акты");
		Конецесли;
		
		Если ПравоРедактирования Тогда
			
			РедактированиеАктированныхСчетов = CW_ПраваДоступа.ПравоДоступно("РазрешитьРедактированиеВходящихАктированныхСчетов");
			Если НЕ РедактированиеАктированныхСчетов Тогда
				
				Если ЭтоПакет Тогда
					ПравоРедактирования = Ложь;
				КонецЕсли;
				
				Если ПравоРедактирования Тогда
					
					// проверяем, что нет сформированных актов
					Запрос = Новый Запрос;
					Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
					               |	CW_СоответствиеАктовВходящимСчетам.Акт КАК Акт
					               |ИЗ
					               |	РегистрСведений.CW_СоответствиеАктовВходящимСчетам КАК CW_СоответствиеАктовВходящимСчетам
					               |ГДЕ
					               |	CW_СоответствиеАктовВходящимСчетам.Счет = &Счет";
					
					Запрос.УстановитьПараметр("Счет", Объект.Ссылка);
					РезультатЗапроса = Запрос.Выполнить();
					
					ПравоРедактирования = РезультатЗапроса.Пустой();
					
				КонецЕсли;
				
			Конецесли;
			
		Конецесли;
		
	Конецесли;
	
	Если ПравоРедактирования Тогда
		
		РедактированиеОплаченныхСчетов 	= CW_ПраваДоступа.ПравоДоступно("РазрешитьРедактированиеВходящихОплаченныхСчетов");
		Если Не РедактированиеОплаченныхСчетов Тогда	
			// проверяем, нет ли оплат
			Запрос = Новый Запрос;
			Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	CW_ОплатаВходящихДокументов.ДокументОплаты КАК ДокументОплаты
			|ИЗ
			|	РегистрСведений.CW_ОплатаВходящихДокументов КАК CW_ОплатаВходящихДокументов
			|ГДЕ
			|	CW_ОплатаВходящихДокументов.Документ = &Документ";
			Запрос.УстановитьПараметр("Документ", Объект.Ссылка);
			
			РезультатЗапроса = Запрос.Выполнить();
			
			ПравоРедактирования = РезультатЗапроса.Пустой();
			
		КонецЕсли;
		
	КонецЕсли;

	ПравоПросмотраБухгалтерскихОбъектов = CW_ПраваДоступа.ДоступныОбъектыБухгалтерии();
	
	//Управление элементаи формы
	ЭтаФорма.ТолькоПросмотр = НЕ ПравоРедактирования;
	
	
	Элементы.УслугиОчиститьТабличнуюЧастьУслуг.Видимость 	= ПравоРедактирования;
	Элементы.УслугиУслуги_ГрупповоеРедактирование.Видимость = ПравоРедактирования;
	
	Элементы.УслугиПодбор.Видимость 	= ПравоРедактирования;
	Элементы.УслугиИзменить.Доступность = ПравоРедактирования;
	
	Элементы.УслугиУслуги_ПереформироватьПредставление.Доступность = ПравоРедактирования;
	
	Элементы.УслугиГруппаЗаполнить.Видимость = ПравоРедактирования;
	
	
	Элементы.ГруппаВедомыеДокументы.Доступность		= ПравоРедактирования;
	Элементы.ГруппаВедомыеДокументы.Видимость		= ПравоПросмотраБухгалтерскихОбъектов И НЕ Объект.Корректировка;

	Элементы.ГруппаВедомыеДокументыКорректировки.Доступность 	= ПравоРедактирования;
	Элементы.ГруппаВедомыеДокументыКорректировки.Видимость 		= ПравоПросмотраБухгалтерскихОбъектов И Объект.Корректировка;
	
	Элементы.ГруппаКорректируемыйДокумент.Видимость 	= Объект.Корректировка;

	РедактированиеСтавкиНДС = CW_ПраваДоступа.ПравоДоступно("РедактированиеСтавкиНДС");
	Элементы.УслугиСтавкаНДС.Доступность = РедактированиеСтавкиНДС и ПравоРедактирования; 
	
КонецПроцедуры

&НаСервере
Процедура _ПроверитьРежимВводаОстатков()
	
	//---------------------------------------------------------------------
	// начало ведения бухгалтерского учета с применением дополнительного модуля
	//---------------------------------------------------------------------
	
	// контроль параметров учетной политики можно осуществить только при условии того, 
	// что в документе были заполнены организация и договор
	Если _ДС().Свойство("УП") Тогда
		ВводОстатковБУ = _ДС().УП.ВводОстатковБУ;
		ДатаНачалаВеденияУчетаБУ = _ДС().УП.ДатаНачалаВеденияУчетаБУ;
		
		РаздельныйУчетЗаполженности = _ДС().УП.РаздельныйУчетОперативнойИБухгалтерскойЗадолженности;
		ПереплатаКакАванс 			= _ДС().УП.УчитыватьПереплатыПоДокументамКакАванс;
		
		ОперативныйУчет = _ДС().УП.ОЗ;
		ВводОстатковОЗ = _ДС().УП.ВводОстатковОЗ;
		ДатаНачалаВеденияУчетаОЗ = _ДС().УП.ДатаНачалаВеденияУчетаОЗ;
	Иначе
		ВводОстатковБУ = Дата(1,1,1);
		ДатаНачалаВеденияУчетаБУ = Дата(1,1,1);

		РаздельныйУчетЗаполженности = Истина;
		ПереплатаКакАванс 			= Ложь;
		
		ОперативныйУчет = Ложь;
		ВводОстатковОЗ = Ложь;
		ДатаНачалаВеденияУчетаОЗ = Дата(1,1,1);
	КонецЕсли;

    // если режим ввода остатков, то формируем заголовки 
	Если ВводОстатковБУ Тогда
		Элементы.УслугиВводОстатков.Заголовок = "Не перевыставлены на "+Формат(ДатаНачалаВеденияУчетаБУ,"ДФ=dd.MM.yyyy");
		Элементы.ГруппаНачальныеОстаткиБУ.Заголовок = "Сальдо по бухгалтерскому учёту на "+Формат(ДатаНачалаВеденияУчетаБУ,"ДФ=dd.MM.yyyy");
	КонецЕсли; 
	
	// если по каким-то причинам режим ввода остатков БУ по документу отличается от текущей ситуации
	Если Объект.ВводОстатковБУ <> ВводОстатковБУ Тогда
		Объект.ВводОстатковБУ = ВводОстатковБУ;
	КонецЕсли; 
	
	//---------------------------------------------------------------------
	// начало ведения учета оперативной кредиторской задолженности в модуле 
	//---------------------------------------------------------------------
	
	//ОперативныйУчет = _ДС().УП.ОЗ;
	//ВводОстатковОЗ = _ДС().УП.ВводОстатковОЗ;
	//ДатаНачалаВеденияУчетаОЗ = _ДС().УП.ДатаНачалаВеденияУчетаОЗ;
	
	// если режим ввода остатков, то формируем заголовки 
	Если ВводОстатковОЗ Тогда
		Элементы.ГруппаНачальныеОстаткиОЗ.Заголовок = "Сальдо по оперативному учёту на "+Формат(ДатаНачалаВеденияУчетаОЗ,"ДФ=dd.MM.yyyy");
		Элементы.УслугиНеактированноеСальдо.Заголовок = "Неактированное сальдо на "+Формат(ДатаНачалаВеденияУчетаОЗ,"ДФ=dd.MM.yyyy");
	КонецЕсли; 
	
	// если по каким-то причинам режим ввода остатков ОЗ по документу отличается от текущей ситуации
	Если Объект.ВводОстатковОЗ <> ВводОстатковОЗ Тогда
		Объект.ВводОстатковОЗ = ВводОстатковОЗ;
	КонецЕсли; 
	
КонецПроцедуры

&НаСервере
Функция _ПроверитьБлок()
	// --- 
	
	Блок = Ложь;
	Для Каждого Стр из Копия.Услуги Цикл
		Если НЕ ПроверитьГрузоперевозку(?(ЗначениеЗаполнено(Стр.Грузоперевозка.Заказ), Стр.Грузоперевозка.Заказ, Стр.Грузоперевозка)) Тогда 
			Блок = Истина;	
		КонецЕсли;	
	КонецЦикла;	
	
	Возврат(Блок);
	
	// --- 
КонецФункции


&НаСервере
Функция ПроверитьГрузоперевозку(Аналитика)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	               |	CW_ЗакрытиеФинансов.Аналитика КАК Аналитика
	               |ИЗ
	               |	РегистрСведений.CW_ЗакрытиеФинансов КАК CW_ЗакрытиеФинансов
	               |ГДЕ
	               |	CW_ЗакрытиеФинансов.Аналитика = &Аналитика";
	
	Запрос.УстановитьПараметр("Аналитика", Аналитика);
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат ?(РезультатЗапроса.Пустой(), Истина, Ложь);
	
КонецФункции	

&НаСервере
Функция ПолучитьДанныеПоГрузоперевозокам()
	
	МассивГрузоперевозок = Новый Массив;
	Для Каждого СтрокаТаблицы из Объект.Услуги Цикл
		МассивГрузоперевозок.Добавить(СтрокаТаблицы.Грузоперевозка);
	КонецЦикла;
	
	Возврат CW_Грузоперевозки_Сервер.ПолучитьСведенияПоГрузоперевозкам(МассивГрузоперевозок);

КонецФункции

&НаСервере
Процедура _СформироватьЗаголовок()
	
	ЗаголовокДокумента = 
		"Расходы по грузоперевозке" + 
		?(Объект.Корректировка," (корректировка) "," ") +
		?(ЗначениеЗаполнено(Объект.Ссылка), " "+Объект.Номер+" от "+Объект.Дата, " (создание)")	;
	ЭтаФорма.Заголовок = ЗаголовокДокумента;
	
КонецПроцедуры

&НаСервере
Функция _ПризнакБлокировки(ПроверяемыйОбъект)
	// --- 
	
	Блок = Ложь;
	Для Каждого Стр из ПроверяемыйОбъект.Услуги Цикл
		Если НЕ ПроверитьГрузоперевозку(?(ЗначениеЗаполнено(Стр.Грузоперевозка.Заказ), Стр.Грузоперевозка.Заказ, Стр.Грузоперевозка)) Тогда 
			Блок = Истина;	
			Прервать;
		КонецЕсли;	
	КонецЦикла;	
	
	Возврат(Блок);
	
	// --- 
КонецФункции


&НаСервере
Процедура УстановитьПараметрыВыбораСтавкиНДС() Экспорт
	
	Если Объект.Корректировка Тогда
		ИмяРеквизитаСтавкаНДС = "УслугиКорректировкаСтавкаНДС";
	Иначе
		ИмяРеквизитаСтавкаНДС = "УслугиСтавкаНДС";
	КонецЕсли;
	
	CW_БухгалтерияЭкспедитораСерверПереопределяемый.УстановитьПараметрыВыбораСтавкиНДС(ЭтотОбъект, ИмяРеквизитаСтавкаНДС);
	
КонецПроцедуры

#КонецОбласти 

#Область ОбщиеПараметры 

Функция _ДС()
	Возврат(ДС[0].Значение);
КонецФункции

&НаСервере
Процедура _СформироватьОбщиеПараметры(СписокПараметров=Неопределено) Экспорт
	
	ДокументОбъект = РеквизитФормыВЗначение("Объект");
	ДокументОбъект.СформироватьОбщиеПараметры(СписокПараметров);
	
	Если СписокПараметров = Неопределено Тогда
		ДС.Очистить();
		ДС.Добавить(ДокументОбъект.ДополнительныеСвойства);
	Иначе
		
		СоответствиеПарамеров = Новый Соответствие;
		СоответствиеПарамеров.Вставить("ПараметрыДоговора","ПД");
		СоответствиеПарамеров.Вставить("Константы","КО");
		СоответствиеПарамеров.Вставить("УчетнаяПолитика","УП");
		СоответствиеПарамеров.Вставить("НастройкиПользователя","НП");
		
		МассивПараметров = _сф.м_СоздатьИзСтроки(СписокПараметров,",");
		
		ДСС = _ДС();
		
		Для каждого Параметр Из МассивПараметров Цикл
			
			Ключ = СоответствиеПарамеров.Получить(Параметр);
			_сф.ст_УстановитьСвойство(ДСС,Ключ,ДокументОбъект.ДополнительныеСвойства[Ключ]);
			
		КонецЦикла; 
		
		ДС.Очистить();
		ДС.Добавить(ДСС);
		
	КонецЕсли; 
	
	_ПроверитьРежимВводаОстатков();
	
КонецПроцедуры

#КонецОбласти 

#Область УправлениеЭлементамиФормы

&НаСервере
Процедура _УправлениеЭлементамиФормы()
	
	Если (Объект.Корректировка) Тогда
		
		Элементы.Организация.ТолькоПросмотр = Истина;
		Элементы.Контрагент.ТолькоПросмотр = Истина;
		Элементы.Договор.ТолькоПросмотр = Истина;
		
		// для корректировочных документов блокируем ввод документов "Доходы по грузоперевозкам" и "Отчет экспедитора" 
		Элементы.ФормаДокументCW_ДоходыПоГрузоперевозкеВводНаОснованииРасходовПоГрузоперевозке.Видимость = Ложь;
		Элементы.ФормаДокументCW_ОтчетЭкспедитораКомандаВводНаОсновании.Видимость = Ложь;
		Элементы.ФормаСоздатьНаОсновании.Видимость = Истина;
		
	КонецЕсли; 
	
	СтруктураПараметровБухУчета = Новый Структура;
	СтруктураПараметровБухУчета.Вставить("Договор", 				Объект.Договор);
	СтруктураПараметровБухУчета.Вставить("ПриложениеКДоговору",		Объект.ПриложениеКДоговору);
	
	ПараметрыБухгалтерскогоУчета = CW_Финансы.ПолучитьПарметрыВеденияБухгалтерскогоУчета(СтруктураПараметровБухУчета, Объект.Дата);
	
	ЗачетАвансовБУ = ((Объект.ПредъявленАкт ИЛИ Объект.ПредъявленСФ) И ПараметрыБухгалтерскогоУчета.БухгалтерскийУчет);
	ЗачетАвансовОЗ = (Объект.ПредъявленСчет И _ДС().УП.ОЗ);
	
	// шапка
	Элементы.КурсВалюты.Видимость = (НЕ Объект.Валюта.Пустая() И Объект.Валюта <> _ДС().КО.ВалютаРегламентированногоУчета);
	
	// видимость закладок
	Элементы.СтраницаУслуги.Видимость = (НЕ Объект.Корректировка);
	Элементы.СтраницаАкты.Видимость = (Объект.ПредъявленСчет) И (НЕ Объект.Ссылка.Пустая()) И НЕ (Объект.ПредъявленАкт ИЛИ Объект.ПредъявленСФ) И (НЕ Объект.Ссылка.Пустая()) И НЕ Объект.Корректировка и ВалютаРегламентированногоУчетаРубль;
	Элементы.СтраницаУслугиКорректировка.Видимость = (Объект.Корректировка);
	Элементы.СтраницаЗачетАвансов.Видимость = (Объект.СпособЗачетаАвансов=Перечисления.СпособыЗачетаАвансов.ПоДокументу И ЗачетАвансовБУ);
	Элементы.СтраницаЗачетАвансовОЗ.Видимость = (Объект.СпособЗачетаАвансовОЗ=Перечисления.СпособыЗачетаАвансов.ПоДокументу И ЗачетАвансовОЗ);
	Элементы.СтраницаПлатёжноРасчётныеДокументы.Видимость = 
		Объект.ПредъявленСФ И
		(Объект.ПорядокЗаполненияРасчётноПлатёжныхДокументовСФ = Перечисления.CW_ПорядокЗаполненияРасчётноПлатёжныхДокументовСФ.ПоДокументу)
	;
	Элементы.ПлатёжноРасчётныеДокументы.ТолькоПросмотр = НЕ (Объект.ПредъявленСФ И (Объект.ПорядокЗаполненияРасчётноПлатёжныхДокументовСФ=Перечисления.CW_ПорядокЗаполненияРасчётноПлатёжныхДокументовСФ.ПоДокументу));
	
	// заголовки закладок
	Элементы.СтраницаКомментарий.Заголовок = " Комментарий" +?(ЗначениеЗаполнено(Объект.Комментарий)," (*)","");
	Элементы.СтраницаУслуги.Заголовок = " Услуги (" +Объект.Услуги.Количество() + ")";
	Элементы.СтраницаАкты.Заголовок = " Акты (" +ТаблицаАктов.Количество() + ")";
	Элементы.СтраницаЗачетАвансов.Заголовок = " Зачет бух. авансов (" +Объект.ЗачетАвансов.Количество() + ")";
	Элементы.СтраницаЗачетАвансовОЗ.Заголовок = " Зачет упр. авансов (" +Объект.ЗачетАвансовОЗ.Количество() + ")";
	Элементы.СтраницаПлатёжноРасчётныеДокументы.Заголовок = " Платёжно-расчётные документы с/ф (" + Объект.ПлатёжноРасчётныеДокументы.Количество() + ")";
	
	// ведомый счет
	Элементы.ВедомыйСчет_Удалить.Видимость = НЕ Объект.ВедомыйСчет.Пустая() И НЕ (Объект.ПредъявленСчет);
	Элементы.ГруппаДействияСВедомымСчетом.Видимость = НЕ Объект.ВедомыйСчет.Пустая() И (Элементы.ВедомыйСчет_Удалить.Видимость);
	
	// ведомый документ
	Элементы.ВедомыйДокумент_Движения.Видимость = (НЕ Объект.ВедомыйДокумент.Пустая()) И (Объект.ВедомыйДокумент.Проведен);
	Элементы.ВедомыйДокумент_Удалить.Видимость = НЕ Объект.ВедомыйДокумент.Пустая() И НЕ (Объект.ПредъявленАкт ИЛИ Объект.ПредъявленСФ);
	Элементы.ГруппаДействияСВедомым.Видимость = НЕ Объект.ВедомыйДокумент.Пустая() И (Элементы.ВедомыйДокумент_Движения.Видимость ИЛИ Элементы.ВедомыйДокумент_Удалить.Видимость);
	// ведомый с/ф
	Элементы.ВедомыйСчетФактура_Движения.Видимость = (НЕ Объект.ВедомыйСчетФактура.Пустая()) И (Объект.ВедомыйСчетФактура.Проведен);
	Элементы.ВедомыйСчетФактура_Удалить.Видимость = НЕ Объект.ВедомыйСчетФактура.Пустая() И НЕ Объект.ПредъявленСФ;
	Элементы.ГруппаДействияСВедомойСчетФактурой.Видимость = НЕ Объект.ВедомыйСчетФактура.Пустая() И (Элементы.ВедомыйСчетФактура_Движения.Видимость ИЛИ Элементы.ВедомыйСчетФактура_Удалить.Видимость);
	
	// таблица услуг
	//Элементы.УслугиЗаказ.Видимость = _ДС().КО.CW_ИспользованиеЗаказов;
	Элементы.УслугиВсего.ТолькоПросмотр = (НЕ _ДС().НП.ОбратныйПересчетВДокументах);
	Элементы.УслугиГруппаСчет.Видимость = Объект.СписокСчетов;
	//Элементы.УслугиПроверитьДокументПоБюджету.Видимость = _ДС().КО.CW_ИспользованиеБюджетирования;
	
	// ввод остатков
	Элементы.УслугиВводОстатков.Видимость = ВводОстатковБУ И (Объект.ПредъявленАкт ИЛИ Объект.ПредъявленСФ);
	Элементы.УслугиНеактированноеСальдо.Видимость = ВводОстатковОЗ И Объект.ПредъявленСчет И НЕ (Объект.ПредъявленАкт ИЛИ Объект.ПредъявленСФ);
	Элементы.ГруппаНачальныеОстаткиБУ.Видимость = ВводОстатковБУ  И (Объект.ПредъявленАкт ИЛИ Объект.ПредъявленСФ);
	Элементы.ГруппаНачальныеОстаткиОЗ.Видимость = ВводОстатковОЗ И Объект.ПредъявленСчет;
	Элементы.КурсВзаиморасчетовБУ.Видимость = Объект.Договор.ВзаиморасчетыВУЕ;
	Элементы.КурсВзаиморасчетовОУ.Видимость = (Объект.Договор.ВалютаДоговора <> _ДС().КО.ВалютаРегламентированногоУчета);
	
	// кнопки нижней панели и меню "Действия"
 	Элементы.ФормаДокументCW_РасходыПоГрузоперевозкеСоздатьНаОсновании.Видимость = Объект.ПредъявленСчет И НЕ (Объект.ПредъявленАкт ИЛИ Объект.ПредъявленСФ);
	Элементы.ФормаОбщаяКомандаCW_ФайлыАрхива.Видимость = Константы.CW_ИспользованиеФайловогоАрхива.Получить();
	
	// итоговые строки табличных частей
	ОбновитьИтогиПоУслугам();
	ОбновитьИтогиПоАвансам();
	ОбновитьИтогиПоАктированию();
	
	Элементы.ФормаОбщаяКомандаCW_ИнформацияПоЗакрытиюГрузоперевозок.Видимость = НЕ РеквизитФормыВЗначение("Объект").ПроверитьЗакрытиеГрузоперевозок(); 

	// отчеты
	Если Элементы.Найти("ФормаОтчетCW_ВедомостьНезавершенногоПроизводстваВедомостьНезавершенногоПроизводства") <> Неопределено Тогда
		Элементы.ФормаОтчетCW_ВедомостьНезавершенногоПроизводстваВедомостьНезавершенногоПроизводства.Видимость = Объект.ПредъявленАкт;
	КонецЕсли;
	Если Элементы.Найти("ФормаОбщаяКомандаCW_ОтчетВедомостьНеперевыставленныхЗатрат") <> Неопределено Тогда
		Элементы.ФормаОбщаяКомандаCW_ОтчетВедомостьНеперевыставленныхЗатрат.Видимость = Объект.ПредъявленСчет;
	КонецЕсли;
	Если Элементы.Найти("ФормаОбщаяКомандаCW_ОтчетНеперевыставленныеЗатраты") <> Неопределено Тогда
		Элементы.ФормаОбщаяКомандаCW_ОтчетНеперевыставленныеЗатраты.Видимость = Объект.ПредъявленАкт;
	КонецЕсли;
	Если Элементы.Найти("ФормаОтчетCW_ОперативнаяЗадолженностьПередПоставщикамиОперативнаяЗадолженностьПередПоставщиками") <> Неопределено Тогда
		Элементы.ФормаОтчетCW_ОперативнаяЗадолженностьПередПоставщикамиОперативнаяЗадолженностьПередПоставщиками.Видимость = Объект.ПредъявленАкт;
	КонецЕсли;
	
	Попытка
		РаздельныйУчетВходящегоНДС = _ДС().УП.РаздельныйУчетНДСНаСчете19;	
	Исключение
	    РаздельныйУчетВходящегоНДС = Ложь;
	КонецПопытки; 
	ПоказатьСпособУчетаНДС = (РаздельныйУчетВходящегоНДС = Истина) И CW_ПраваДоступа.ПравоДоступно("РедактированиеСпособаУчетаНДС");
	Элементы.УслугиСпособУчетаНДС.Видимость = ПоказатьСпособУчетаНДС;
	
	ПоказатьПодразделение = ?(_ДС().Свойство("УП"),_ДС().УП.ГруппировкаЗатратПоПодразделениям,Ложь);
	Элементы.УслугиПодразделение.Видимость = ПоказатьПодразделение;
	СостояниеДокумента = ОбщегоНазначенияБП.СостояниеДокумента(Объект); // ВызовБП
	
	Если Элементы.Найти("ФормаДокументCW_ВводОстатковНезавершенногоПроизводстваСоздатьНаОсновании") <> Неопределено Тогда
		Элементы.ФормаДокументCW_ВводОстатковНезавершенногоПроизводстваСоздатьНаОсновании.Видимость = Объект.ПредъявленАкт;
	КонецЕсли; 
	
КонецПроцедуры

#КонецОбласти 

