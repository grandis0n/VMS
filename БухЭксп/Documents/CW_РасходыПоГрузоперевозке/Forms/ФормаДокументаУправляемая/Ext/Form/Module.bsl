&НаКлиенте
Процедура ОбновитьНомераДокументовНаКлиенте() Экспорт  
	
	 ОбновитьНомераДокументовНаСервере();
	  
КонецПроцедуры

&НаСервере
Процедура ОбновитьНомераДокументовНаСервере()
	
	ЭтоУПД = Объект.ПредъявленАкт и Объект.ЭтоУниверсальныйДокумент;
	
	Элементы.ПредставлениеАкта.Видимость = Не ЭтоУПД;
	Элементы.ПредставлениеСчетаФактуры.Видимость = Не ЭтоУПД;
	Элементы.ПредставлениеУПД.Видимость = ЭтоУПД;
	
	// Представление счета
	Если Объект.ПредъявленСчет Тогда
		
		Если ЗначениеЗаполнено(Объект.НомерСчета) Тогда
			ПредставлениеНомераСчета = Объект.НомерСчета;	 
		Иначе
			ПредставлениеНомераСчета = "<...>";	
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Объект.ДатаСчета) Тогда
			ПредставлениеДатыСчета	= Формат(Объект.ДатаСчета, "ДФ=dd.MM.yyyy");
		Иначе
			ПредставлениеДатыСчета 	= "<...>";	
		КонецЕсли;
		
		//План оплаты
		ПредставлениеСрокаОплаты = "";
		ДанныеПланаОплаты = CW_Документы.ПолучитьПланОплаты(Объект.Ссылка);
		Если Не ЗначениеЗаполнено(ДанныеПланаОплаты.Дата) и НЕ ПустаяСтрока(ДанныеПланаОплаты.Примечание) Тогда
			ПредставлениеСрокаОплаты = ", План оплаты: <...>";
		ИначеЕсли ЗначениеЗаполнено(ДанныеПланаОплаты.Дата) Тогда
			ПредставлениеСрокаОплаты = ", План оплаты: "+Формат(ДанныеПланаОплаты.Дата,"ДФ=dd.MM.yyyy");
		КонецЕсли;
		
		Если Не ПустаяСтрока(ДанныеПланаОплаты.Примечание) Тогда
			ПредставлениеСрокаОплаты = ПредставлениеСрокаОплаты + " ("+СокрЛП(ДанныеПланаОплаты.Примечание)+")";
		КонецЕсли; 
		//План оплаты
		
		ПредставлениеСчета = "Счёт №"+ ПредставлениеНомераСчета+ " от " + ПредставлениеДатыСчета + ПредставлениеСрокаОплаты;
		
	// счет не предоставлен
	Иначе
		ПредставлениеСчета = "<Счёт не предоставлен>";
	КонецЕсли;   
	// Представление счета
	
	Если Не ЭтоУПД Тогда 
		
		// предоставление акт 
		Если Объект.ПредъявленАкт Тогда
			
			Если ЗначениеЗаполнено(Объект.НомерАкта) Тогда
				ПредставлениеНомераАкта = Объект.НомерАкта;	 
			Иначе
				ПредставлениеНомераАкта = "<...>";	
			КонецЕсли;
			
			Если ЗначениеЗаполнено(Объект.ДатаАкта) Тогда
				ПредставлениеДатыАкта  = Формат(Объект.ДатаАкта, "ДФ=dd.MM.yyyy");
			Иначе
				ПредставлениеДатыАкта = "<...>";	
			КонецЕсли;
			
			ПредставлениеОбъектаВнешнегоСчета = "";
			Если Объект.СписокСчетов и НЕ ВводОстатковОЗ Тогда
				ПредставлениеОбъектаВнешнегоСчета = " к списку счетов";
			Конецесли;  
			
			Если НЕ Объект.ПредъявленСчет и НЕ Объект.СписокСчетов Тогда 
				Если Объект.Счет.Пустая() Тогда  
					ПредставлениеВнешнегоСчета = " <не указан>";
				Иначе   
					ПредставлениеНомераВнешнегоСчета = Объект.Счет.НомерСчета;	 
					ПредставлениеДатыВнешнегоСчета 	 = Формат(Объект.Счет.ДатаСчета, "ДФ=dd.MM.yyyy"); 
					
					ПредставлениеВнешнегоСчета 		= ПредставлениеНомераВнешнегоСчета + " от "+ПредставлениеДатыВнешнегоСчета;
				КонецЕсли;
				
				ПредставлениеОбъектаВнешнегоСчета = "  к счёту №" + ПредставлениеВнешнегоСчета;
			КонецЕсли;
			
			ПредставлениеАкта = "Акт №" + ПредставлениеНомераАкта + " от " + ПредставлениеДатыАкта + ПредставлениеОбъектаВнешнегоСчета;
			
		Иначе
			ПредставлениеАкта = "<Акт не предоставлен>";
		КонецЕсли; 
		// предоставление акт 
		
		
		// с/ф предоставлена 
		Если Объект.ПредъявленСФ Тогда 
			
			Если ЗначениеЗаполнено(Объект.НомерСФ) Тогда
				ПредставлениеНомераСчетФактура = Объект.НомерСФ;	 
			Иначе
				ПредставлениеНомераСчетФактура = "<...>";	
			КонецЕсли;
			
			Если ЗначениеЗаполнено(Объект.ДатаСФ) Тогда
				ПредставлениеДатыСчетФактура 	 = Формат(Объект.ДатаСФ, "ДФ=dd.MM.yyyy");
			Иначе
				ПредставлениеДатыСчетФактура = "<...>";	
			КонецЕсли;    
			
			ПредставлениеИсправленияСчетФактура = "";
			Если ЗначениеЗаполнено(Объект.НомерИсправления) 
				И Объект.ВидОперацииКорректировки = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсправленияПоступленияРеализации.ИсправлениеОшибки") Тогда
				ПредставлениеИсправленияСчетФактура  =  " (испр. "+Формат(Объект.НомерИсправления, "ЧГ=0")+")";
			КонецЕсли;
			
			ПредставлениеПродавца = "";
			Если Не Объект.Продавец.Пустая() Тогда
				ПредставлениеПродавца = "  продавец " + СокрЛП(Объект.Продавец);
			КонецЕсли;
	
			ПредставлениеСчетаФактуры = "С/ф №" + ПредставлениеНомераСчетФактура + ПредставлениеИсправленияСчетФактура + " от " + ПредставлениеДатыСчетФактура + ПредставлениеПродавца;
			
		Иначе
			ПредставлениеСчетаФактуры = "<С/ф не предоставлен>";
		КонецЕсли;  
		
	КонецЕсли;  
	
	Если ЭтоУПД Тогда
		
		ВидУПД = "УПД";	
		Если Объект.Корректировка и Объект.ВидОперацииКорректировки = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсправленияПоступленияРеализации.СогласованноеИзменение") Тогда
			ВидУПД = "УКД";	
		КонецЕсли;
		
		ПредставлениеОбъектаВнешнегоСчета = "";
		Если Объект.СписокСчетов и НЕ ВводОстатковОЗ Тогда
			ПредставлениеОбъектаВнешнегоСчета = " к списку счетов";
		Конецесли;  
		
		Если НЕ Объект.ПредъявленСчет и НЕ Объект.СписокСчетов Тогда 
			Если Объект.Счет.Пустая() Тогда  
				ПредставлениеВнешнегоСчета = " <не указан>";
			Иначе   
				ПредставлениеНомераВнешнегоСчета = Объект.Счет.НомерСчета;	 
				ПредставлениеДатыВнешнегоСчета 	 = Формат(Объект.Счет.ДатаСчета, "ДФ=dd.MM.yyyy"); 
				
				ПредставлениеВнешнегоСчета 		= ПредставлениеНомераВнешнегоСчета + " от "+ПредставлениеДатыВнешнегоСчета;
			КонецЕсли;
			
			ПредставлениеОбъектаВнешнегоСчета = "  к счёту №" + ПредставлениеВнешнегоСчета;
		КонецЕсли;

		
		
		Если Объект.ПредъявленСФ Тогда  
			СтатусУПД 				= "(1)";
			ПредставлениеНомераУПД	= Объект.НомерСФ;
			ПредставлениеНомераУПД	= " №"+ ?(ПустаяСтрока(ПредставлениеНомераУПД), "<...>", 	ПредставлениеНомераУПД);
			ПредставлениеДатыУПД 	= ?(Объект.ДатаСФ = Дата(1,1,1),				  "<...>",	Формат(Объект.ДатаСФ,"ДФ=dd.MM.yyyy"));
			
			ПредставлениеИсправленияУПД = "";
			Если ЗначениеЗаполнено(Объект.НомерИсправления) 
				И Объект.ВидОперацииКорректировки = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсправленияПоступленияРеализации.ИсправлениеОшибки") Тогда
				ПредставлениеИсправленияУПД  =  " (испр. "+Формат(Объект.НомерИсправления, "ЧГ=0")+")";
			КонецЕсли;

		Иначе
			СтатусУПД 				= "(2)";
			ПредставлениеНомераУПД	= Объект.НомерАкта;
			ПредставлениеНомераУПД	= " №"+ ?(ПустаяСтрока(ПредставлениеНомераУПД), "<...>", 	ПредставлениеНомераУПД);
			ПредставлениеДатыУПД 	= ?(Объект.ДатаАкта = Дата(1,1,1),				"<...>",	Формат(Объект.ДатаАкта,"ДФ=dd.MM.yyyy"));
		КонецЕсли;  
		
		ПредставлениеУПД = ВидУПД + СтатусУПД + ПредставлениеНомераУПД + ПредставлениеИсправленияУПД + " от "+ ПредставлениеДатыУПД + ПредставлениеОбъектаВнешнегоСчета;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура _СформироватьКурс()
	// --- 
	
	Если НЕ Объект.Валюта.Пустая() И (Объект.Валюта <> _ДС().КО.ВалютаРегламентированногоУчета) Тогда
		
		Если (НЕ Объект.УЕ_ПользовательскийКурс) Тогда
			СК = CW_Финансы.ПолучитьКурсВалюты(Объект.Валюта,_ДатаВозникновенияЗадолженности());
			ТекущийКурс = СК.Курс;	
		Иначе
			СК = Новый Структура("Курс,Кратность",Объект.УЕ_Курс,Объект.УЕ_Кратность);
		КонецЕсли; 
		// --- 
		КурсВалюты = Строка(Объект.Валюта)+" = "+Формат(СК.Курс,"ЧЦ=15; ЧДЦ=4; ЧГ=");
		Если СК.Кратность <> 1 Тогда
			
			_сф.стр_Добавить(КурсВалюты,"/"+Формат(СК.Кратность,"ЧЦ=10; ЧГ="));
			
		КонецЕсли; 
		
	КонецЕсли; 
	
	// --- 
КонецПроцедуры

&НаСервере
Функция _ДатаКурса()
	// --- 
	
	Если (Объект.ПредъявленАкт) Тогда
		
		Возврат(Объект.ДатаАкта);
		
	ИначеЕсли (Объект.ПредъявленСчет) Тогда 
		
		Возврат(Объект.ДатаСчета);
		
	Иначе
		
		Возврат(Объект.Дата);
		
	КонецЕсли; 
	
	// --- 
КонецФункции
 

&НаСервере
Функция _ДатаВозникновенияЗадолженности()
	
	Если Объект.ФормироватьВедомыеДатойДокумента Тогда
		Возврат ?(ЗначениеЗаполнено(Объект.Дата), Объект.Дата, ТекущаяДата());
	КонецЕсли;
	
	Если Объект.ПредъявленАкт Тогда
		Возврат Объект.ДатаАкта;
	КонецЕсли;
	
	Если Объект.ПредъявленСчет Тогда
		Возврат Объект.ДатаСчета;
	КонецЕсли;
	
	Возврат ?(ЗначениеЗаполнено(Объект.Дата), Объект.Дата, ТекущаяДата());
	
КонецФункции

&НаСервере
Процедура ЗаписатьСрокОплатыДокумента() 
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("Счет", 					Объект.Ссылка);
	СтруктураПараметров.Вставить("ДатаОплаты", 				_СрокОплаты);
	СтруктураПараметров.Вставить("Описание", 				_СрокОплатыОписание);
	СтруктураПараметров.Вставить("РучноеРедактирование", 	_СрокОплатыРучноеРедактирование);

	РегистрыСведений.CW_СрокиОплатыСчетов.ЗаписатьСрокОплатыДокумента(СтруктураПараметров); 

КонецПроцедуры

&НаСервере
Процедура РасчитатьСрокОплатыДокумента()
	
	Если Объект.Ссылка.Пустая() или _СрокОплатыРучноеРедактирование Тогда
	//	или ЗначениеЗаполнено(_СрокОплаты)
		Возврат;
	КонецЕсли;
	
	ПорядокРасчетаСрокаОплаты = _ДС().ПД.УсловияОплаты.ПорядокРасчета; 
	Если Объект.ПредъявленСчет и Не Объект.ПредъявленАкт 
		и ПорядокРасчетаСрокаОплаты = ПредопределенноеЗначение("Перечисление.CW_ПорядокРасчетаДляУсловияОплаты.ОтсрочкаОтДатыВозвратаАкта") Тогда
		Возврат;
	Конецесли;	
	
	СтруктураДанных = CW_Документы.ПодготовитьДанныеДляРасчетаСрокаОплаты(Объект);
	_СрокОплаты 	= CW_Документы.РассчитатьСрокОплаты(СтруктураДанных);
	
	ЗаписатьСрокОплатыДокумента();
	
	Если Не Объект.ПредъявленСчет и Объект.ПредъявленАкт 
		и ПорядокРасчетаСрокаОплаты = ПредопределенноеЗначение("Перечисление.CW_ПорядокРасчетаДляУсловияОплаты.ОтсрочкаОтДатыВозвратаАкта") Тогда
		
		мСвязанныеСчета = Документы.CW_РасходыПоГрузоперевозке.ПолучитьСвязанныеСчета(Объект.Ссылка);
		Для каждого СвязанныйСчет из мСвязанныеСчета Цикл    
			
			ДанныеСрокаОплаты = CW_Документы.ПолучитьСрокОплаты(СвязанныйСчет);
			Если НЕ ДанныеСрокаОплаты.РучноеРедактирование Тогда
				
				СтруктураПараметров = Новый Структура;
				СтруктураПараметров.Вставить("Счет",		СвязанныйСчет);
				СтруктураПараметров.Вставить("ДатаОплаты",	_СрокОплаты);
				
				РегистрыСведений.CW_СрокиОплатыСчетов.ЗаписатьСрокОплатыДокумента(СтруктураПараметров); 
			КонецЕсли;
		
		КонецЦикла;
	КонецЕсли;
	 	
КонецПроцедуры

#КонецОбласти 

#Область ИзменениеДаты 

&НаКлиенте
Процедура ДатаПриИзменении(Элемент)
	
	Если НЕ Объект.Ссылка.Пустая() Тогда
		Если (_ГодИзменился()) Тогда
			
			ПОВ = Новый ОписаниеОповещения("ОбработкаВопросаИзмененияГода",ЭтотОбъект, Новый Структура()); 
			ПоказатьВопрос(ПОВ,"Дата документа перенесена в другой год."+Символы.ПС+ 
			"Документу будет присвоен новый номер."+Символы.ПС+ 
			"Продолжить?",РежимДиалогаВопрос.ДаНет);
			
		КонецЕсли;
	КонецЕсли;
	
	_ДатаПриИзменении();
	
КонецПроцедуры


&НаКлиенте
Процедура ОбработкаВопросаИзмененияГода(Ответ, ДополнительныеПараметры) Экспорт 
	// --- 
	
	Если (Ответ <> Неопределено) Тогда
		
		Если (Ответ = КодВозвратаДиалога.Да) Тогда
			
			// присваевам новый номер
			_ОбработатьИзменениеГода();
			
		Иначе
			
			// восстанавливаем дату по ссылке
			_ВосстановитьДатуДокумента();
			
		КонецЕсли; 
		
	КонецЕсли; 
	
	// --- 
КонецПроцедуры

&НаСервере
Процедура _ОбработатьИзменениеГода()
	// --- 
	
	НачальнаяДатаДокумента = Объект.Дата;
	// --- 
	ДокументОбъект = РеквизитФормыВЗначение("Объект");
	ДокументОбъект.УстановитьНовыйНомер();
	ЗначениеВРеквизитФормы(ДокументОбъект,"Объект");
	// --- 
	_ДатаПриИзменении();
	
	// --- 
КонецПроцедуры
 

&НаСервере
Процедура _ВосстановитьДатуДокумента()
	// --- 
	
	Объект.Дата = НачальнаяДатаДокумента;
	
	// --- 
КонецПроцедуры
 

&НаСервере
Функция _ГодИзменился()
	// --- 
	
	Возврат(Год(Объект.Дата) <> Год(НачальнаяДатаДокумента));
	
	// --- 
КонецФункции
 

&НаКлиенте
Процедура ДатаОчистка(Элемент, СтандартнаяОбработка)
	_ДатаПриИзменении();
КонецПроцедуры

&НаСервере
Процедура _ДатаПриИзменении()
	
	// если очистили дату, то принудительно 
	// устанавливаем текущую дату
	Если Объект.Дата = Дата(1,1,1) Тогда
		ДатаСтрокой = Формат(ТекущаяДата(),"ДФ=yyyyMMdd");
		ВремяСтрокой = Формат(ТекущаяДата(),"ДФ=HHmmss");
		Объект.Дата = Дата(ДатаСтрокой+ВремяСтрокой);
	КонецЕсли;
	
	// необходимо обновить параметры учётной политики и параметры договора
	_СформироватьОбщиеПараметры("ПараметрыДоговора,УчетнаяПолитика");
	
	// и курс валюты
	_СформироватьКурс();
	_ПроверитьРежимВводаОстатков();
	
	// пересчитаем принудительно срок оплаты
	РасчитатьСрокОплатыДокумента();   
	
	// актуализируем список услуг по договору (если по договору предусмотрено ограничение)
	Если ЗначениеЗаполнено(Объект.Договор) Тогда
		УстановитьАдресСпискаУслугПоДоговору();     
	КонецЕсли;
	
	// регенерация формы 
	ОбновитьНомераДокументовНаСервере();
	_УправлениеЭлементамиФормы(); 
	
	УстановитьПараметрыВыбораСтавкиНДС();
	
КонецПроцедуры  


#КонецОбласти 

#Область ИзменениеОрганизации 

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
	
	_ОрганизацияПриИзменении();
	// --- 
	Если СокрЛП(Объект.Номер) <> "" И НЕ Объект.Организация.Пустая() Тогда
		
		// проверяем, нужно ли менять
		Если _НужноУстановитьНовыйНомер() Тогда
			
			ПОВ = Новый ОписаниеОповещения("ОбработкаВопросаУстановкиНовогоНомера",ЭтотОбъект); 
			ПоказатьВопрос(ПОВ,"Установить новый номер?", РежимДиалогаВопрос.ДаНет);
			
		КонецЕсли; 
		
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВопросаУстановкиНовогоНомера(Ответ, ДополнительныеПараметры) Экспорт 
	// --- 
	
	Если Ответ=КодВозвратаДиалога.Да Тогда
		
		_УстановитьНовыйНомер();
		
	КонецЕсли; 
	
	// --- 
КонецПроцедуры
  

&НаСервере
Функция _НужноУстановитьНовыйНомер()
	// --- 
	
	Если Объект.Организация.Префикс = "" Тогда
		
		Возврат(Ложь);
		
	КонецЕсли; 

	ДлинаПрефикса = СтрДлина(Объект.Организация.Префикс);
	Если Лев(СокрЛП(Объект.Номер),ДлинаПрефикса) <> Объект.Организация.Префикс Тогда
		
		Возврат(Истина);
		
	КонецЕсли; 
	
	Возврат(Ложь);
	
	// --- 
КонецФункции

&НаСервере
Процедура _ОрганизацияПриИзменении()
	// --- 
	
	_СформироватьОбщиеПараметры("УчетнаяПолитика");
	УстановитьПараметрыВыбораСтавкиНДС();
	
	// --- 
КонецПроцедуры

&НаСервере
Процедура _УстановитьНовыйНомер()
	// --- 
	
	Документ = РеквизитФормыВЗначение("Объект");
	Документ.УстановитьНовыйНомер();
	ЗначениеВРеквизитФормы(Документ,"Объект");
	
	// --- 
КонецПроцедуры

#КонецОбласти 

#Область ИзменениеКонтрагента 

&НаКлиенте
Процедура КонтрагентНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	_УФК.ВыбратьПоставщика(Объект.Контрагент,Элемент, ДанныеВыбора, СтандартнаяОбработка);
	
КонецПроцедуры

&НаКлиенте
Процедура КонтрагентПриИзменении(Элемент)
	
	ПроверитьКонтрагентаПоБазеЛКК = КонтрагентПриИзмененииНаСервере(); 
	
	//Подсистема.CW_ЭлектронныйОбменДанными
	Если ПроверитьКонтрагентаПоБазеЛКК Тогда
		ПроверитьКонтрагентаПоБазеЛКК();
	КонецЕсли;
	//Подсистема.CW_ЭлектронныйОбменДанными
	
КонецПроцедуры 

&НаСервереБезКонтекста
Функция ПолучитьИННКонтрагента(Контрагент)
	
	Возврат Контрагент.Инн;
	
КонецФункции

&НаСервере
Функция КонтрагентПриИзмененииНаСервере()
	
	// если очистили контрагента, то очищаем и договор
	Если Не ЗначениеЗаполнено(Объект.Контрагент) Тогда
		Объект.Договор = Неопределено;
		Возврат Ложь;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.Контрагент) И (Объект.Договор.Владелец = Объект.Контрагент) Тогда 
		Возврат Ложь;
		// нечего менять
	Иначе 
		Объект.Договор = CW_Документы.ПолучитьПоследнийДоговор(Объект.Контрагент, Объект.Организация, Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком);
		_ОбработатьИзменениеДоговора();
	КонецЕсли;
	
	//Подсистема.УчетПриложенийДоговоров
	CW_УчетПриложенийДоговоровСервер.ПриИзмененииКонтрагентаНаСервере(ЭтаФорма);
	//Подсистема.УчетПриложенийДоговоров
	
	Если Объект.Корректировка Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

