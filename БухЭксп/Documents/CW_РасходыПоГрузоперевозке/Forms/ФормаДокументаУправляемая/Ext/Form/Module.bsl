&НаКлиенте
Процедура ОткрытьФормуЗагрузкиДокумента(ВнешниеДанные = Неопределено, ОчиститьТаблицу = Ложь) Экспорт
	
	ДанныеДокумента = Новый Структура;
	ДанныеДокумента.Вставить("Дата", 		Объект.Дата);
	ДанныеДокумента.Вставить("Организация", Объект.Организация); 
	ДанныеДокумента.Вставить("ЦенаСНДС", 	Объект.ЦенаСНДС); 
	
	АдресТаблицыДокумента = ПолучитьАдресТаблицыДокумента();
	
	ПараметрыОбработки = Новый Структура;
	ПараметрыОбработки.Вставить("ДанныеДокумента", 			ДанныеДокумента);
	ПараметрыОбработки.Вставить("АдресТаблицыДокумента", 	АдресТаблицыДокумента);  
	ПараметрыОбработки.Вставить("ВнешниеДанные", 			ВнешниеДанные);  
	ПараметрыОбработки.Вставить("Контрагент", 				Объект.Контрагент);  
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("АдресТаблицыДокумента", 	АдресТаблицыДокумента);
	ДополнительныеПараметры.Вставить("ОчиститьТаблицу", 		ОчиститьТаблицу);
	
	Оповещение = Новый ОписаниеОповещения("ЗавершитьЗаполнениеТаблицы", ЭтотОбъект, ДополнительныеПараметры);
	
	ОткрытьФорму("Обработка.CW_ЗагрузкаТабличнойЧастиДокументаРасходыПоГрузоперевозкеИзФайла.Форма", ПараметрыОбработки, ЭтаФорма,,,,Оповещение);

КонецПроцедуры      

