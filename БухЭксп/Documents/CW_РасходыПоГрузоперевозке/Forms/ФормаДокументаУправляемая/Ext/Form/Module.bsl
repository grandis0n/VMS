&НаКлиенте
Процедура РассчитатьПлановуюДатуОплаты(Команда)

	Если Объект.Ссылка.Пустая() Тогда
		ПоказатьПредупреждение(,"Документ не записан!");
		Возврат;
	КонецЕсли;
	
	Успешно = РассчитатьПлановуюДатуОплатыНаСервере();
	Если не Успешно Тогда
		ПоказатьПредупреждение(,"Не удалось получить срок оплаты документа");
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция РассчитатьПлановуюДатуОплатыНаСервере(ПроверитьНаличиеПлановойдаты = ложь, ПоказыватьОповещения = истина)
	
	ПлатежныйКалендарь 	= CW_Настройки.ПараметрУчетнойПолитики(Объект.Дата, Объект.Организация, "ПлатежныйКалендарь");
	Если Не ЗначениеЗаполнено(ПлатежныйКалендарь)  Тогда  
		Если ПоказыватьОповещения Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В учетной политике организации не выбран платежный календарь!");
		КонецЕсли;
		Возврат Ложь;
	КонецЕсли;   
	
	Если ПроверитьНаличиеПлановойдаты Тогда
		ДанныеПланаОплаты = CW_Документы.ПолучитьПланОплаты(Объект.Ссылка);
		Если ЗначениеЗаполнено(ДанныеПланаОплаты.Дата) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЕсли;
	
	ПлановаяДата = CW_Документы.ПолучитьПлановыйСрокОплаты(Объект.Ссылка, ПлатежныйКалендарь);
	Если ПлановаяДата = Неопределено Тогда
		Если ПоказыватьОповещения Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заполнен платежный календарь!");
		КонецЕсли;
		Возврат Ложь;
	КонецЕсли;
	
	Если ПлановаяДата = Дата(1,1,1) Тогда
		//Ничего делать не нужно
		Возврат Истина;
	КонецЕсли;
	
	СтруктураПараметров = новый Структура;
	СтруктураПараметров.Вставить("Счет", 			Объект.Ссылка);
	СтруктураПараметров.Вставить("ПлановаяДата", 	ПлановаяДата);
	СтруктураПараметров.Вставить("Описание", 		"");
	
	РегистрыСведений.CW_ПланОплатыВходящихСчетов.ЗаписатьПланОплатыДокумента(СтруктураПараметров);

	УстановитьОписаниеПланОплаты();

	Возврат Истина;
	
КонецФункции

&НаСервереБезКонтекста
Функция ЕстьОстатокЗадолженностиПоДокументу(Счет)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ОперативнаяКредиторскаяЗадолженность.Счет КАК Счет,
	               |	ОперативнаяКредиторскаяЗадолженность.Всего_ВалютаОстаток КАК Всего_ВалютаОстаток
	               |ИЗ
	               |	РегистрНакопления.CW_ОперативнаяКредиторскаяЗадолженность.Остатки(&ДатаСреза, Счет = &Счет) КАК ОперативнаяКредиторскаяЗадолженность
	               |ГДЕ
	               |	ОперативнаяКредиторскаяЗадолженность.Всего_ВалютаОстаток <> 0";
	
	Запрос.УстановитьПараметр("ДатаСреза", 	ТекущаяДата());
	Запрос.УстановитьПараметр("Счет", 		Счет);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат НЕ РезультатЗапроса.Пустой();
	
КонецФункции

&НаСервере
Функция ПолучитьОграничениеУслугПоНоменклатуре(ПорядокОтражения=Неопределено)

	ИспользуетсяОгранчиениеУслуг = Ложь; 
	
	Если ОграничиватьУслугиПоДоговорам Тогда
		
		ИспользуетсяОгранчиениеУслуг = ?(ЗначениеЗаполнено(Объект.Договор), Объект.Договор.ОграничиватьНоменклатуру, Ложь);
		Если НеОграничиватьУслугиПоПеревыставлению и  ПорядокОтражения = ПредопределенноеЗначение("Перечисление.CW_ПорядокОтраженияЗатрат.Перевыставление") Тогда
			ИспользуетсяОгранчиениеУслуг = Ложь;	
		КонецЕсли;    
		
	КонецЕсли;
	
	Возврат ИспользуетсяОгранчиениеУслуг;
	
