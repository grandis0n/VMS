//Обработчики событий   
&НаСервере
Функция КонтрагентКредиторПриИзмененииНаСервере()

	Если НЕ ЗначениеЗаполнено(Объект.Контрагент) Тогда
		Объект.Контрагент = Объект.КонтрагентКредитор;
	КонецЕсли; 
	
	ОчиститьТабличныеЧастиДокумента();
	УправлениеЭлементамиФормы();
	
КонецФункции

&НаСервере
Функция КонтрагентПриИзмененииНаСервере()
	
	Если Не ЗначениеЗаполнено(Объект.КонтрагентКредитор) Тогда
		Объект.КонтрагентКредитор = Объект.Контрагент;
	КонецЕсли; 

	ОчиститьТабличныеЧастиДокумента();
	УправлениеЭлементамиФормы();
	
	//Подсистема.УчетПриложенийДоговоров
	CW_УчетПриложенийДоговоровСервер.ПриИзмененииКонтрагентаНаСервере(ЭтаФорма);
	//Подсистема.УчетПриложенийДоговоров

КонецФункции

&НаСервере
Процедура ДоговорКредиторПриИзмененииНаСервере()
	
	Если Не Объект.ДоговорКредитор.ИспользуютсяПриложения Тогда
		Объект.ПриложениеКДоговоруКредитор = Неопределено;
	КонецЕсли;  
	
	УстановитьДоступныеТипыДокументаОснования("КредиторскаяЗадолженностьДокументСчет", "ДоговорКредитор");
	ВидимостьВалютныхПоказателей();
	     	
	УстановитьВидимостьПриложенийДоговоров();
	ОчиститьТабличныеЧастиДокумента();
	
КонецПроцедуры

