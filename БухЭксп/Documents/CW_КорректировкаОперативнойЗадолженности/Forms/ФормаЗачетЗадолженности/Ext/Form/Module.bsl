	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("МножественныйВыбор", Ложь);
	СтруктураПараметров.Вставить("ЗакрыватьПриВыборе", Истина);
	СтруктураПараметров.Вставить("Отбор", СтруктураОтбора);
	
	ОткрытьФорму("Справочник.CW_ДоговорыПоГрузоперевозкам.ФормаВыбора", СтруктураПараметров, Элемент);

КонецПроцедуры


&НаСервере
Функция ПолучитьСтруктуруПараметровВыбораДоговора(ВладелецДоговора, ДоговорИсточник) 
	
	СтруктураОтбора = Новый Структура;
	СтруктураОтбора.Вставить("Организация", Объект.Организация);
	СтруктураОтбора.Вставить("Владелец", 	ВладелецДоговора);
	
	Если ЗначениеЗаполнено(ДоговорИсточник) Тогда  
		
		Если ДоговорИсточник.ВалютаДоговора = ВалютаРегламентированногоУчета Тогда  
			
			МассивДоговоров = ПолучитьМассивДоговоровДляОтбора(СтруктураОтбора, ВалютаРегламентированногоУчета);
			СтруктураОтбора.Вставить("Ссылка", 	МассивДоговоров);  
			
		ИначеЕсли ДоговорИсточник.ВалютаДоговора <> ВалютаРегламентированногоУчета 
			И ДоговорИсточник.ВзаиморасчетыВУЕ Тогда    
			
			МассивДоговоров = ПолучитьМассивДоговоровДляОтбораУЕ(СтруктураОтбора, ВалютаРегламентированногоУчета, ДоговорИсточник.ВалютаДоговора);
			СтруктураОтбора.Вставить("Ссылка", 	МассивДоговоров);  
			
		ИначеЕсли ДоговорИсточник.ВалютаДоговора <> ВалютаРегламентированногоУчета 
			И Не ДоговорИсточник.ВзаиморасчетыВУЕ Тогда
			
			СтруктураОтбора.Вставить("ВалютаДоговора", ДоговорИсточник.ВалютаДоговора); 
			
		КонецЕсли; 

	КонецЕсли;   
	
	Возврат СтруктураОтбора;
	
КонецФункции  

&НаСервереБезКонтекста
Функция ПолучитьМассивДоговоровДляОтбора(ПараметрыОтбора, ВалютаРегламентированногоУчета)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	CW_ДоговорыПоГрузоперевозкам.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.CW_ДоговорыПоГрузоперевозкам КАК CW_ДоговорыПоГрузоперевозкам
	               |ГДЕ
	               |	CW_ДоговорыПоГрузоперевозкам.Организация = &Организация
	               |	И CW_ДоговорыПоГрузоперевозкам.Владелец = &Владелец
	               |	И CW_ДоговорыПоГрузоперевозкам.ПометкаУдаления = ЛОЖЬ
	               |	И (CW_ДоговорыПоГрузоперевозкам.ВзаиморасчетыВУЕ = ИСТИНА
	               |			ИЛИ CW_ДоговорыПоГрузоперевозкам.ВалютаДоговора = &ВалютаДоговора)";
	
	Запрос.УстановитьПараметр("Организация", 	ПараметрыОтбора.Организация);
	Запрос.УстановитьПараметр("Владелец",  		ПараметрыОтбора.Владелец);
 	Запрос.УстановитьПараметр("ВалютаДоговора", ВалютаРегламентированногоУчета);

	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("Ссылка");
	
КонецФункции  

&НаСервереБезКонтекста
Функция ПолучитьМассивДоговоровДляОтбораУЕ(ПараметрыОтбора, ВалютаРегламентированногоУчета, ВалютаДоговора)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	CW_ДоговорыПоГрузоперевозкам.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.CW_ДоговорыПоГрузоперевозкам КАК CW_ДоговорыПоГрузоперевозкам
	               |ГДЕ
	               |	CW_ДоговорыПоГрузоперевозкам.ПометкаУдаления = ЛОЖЬ
	               |	И CW_ДоговорыПоГрузоперевозкам.Организация = &Организация
	               |	И CW_ДоговорыПоГрузоперевозкам.Владелец = &Владелец
	               |	И (CW_ДоговорыПоГрузоперевозкам.ВалютаДоговора = &ВалютаРегламентированногоУчета
	               |			ИЛИ CW_ДоговорыПоГрузоперевозкам.ВалютаДоговора = &ВалютаДоговора
	               |				И CW_ДоговорыПоГрузоперевозкам.ВзаиморасчетыВУЕ = ИСТИНА)";
	
	Запрос.УстановитьПараметр("Организация", 	ПараметрыОтбора.Организация);
	Запрос.УстановитьПараметр("Владелец",  		ПараметрыОтбора.Владелец);
 	Запрос.УстановитьПараметр("ВалютаДоговора", ВалютаДоговора);
 	Запрос.УстановитьПараметр("ВалютаРегламентированногоУчета", ВалютаРегламентированногоУчета);

	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("Ссылка");
	
КонецФункции

&НаСервере
Процедура ВидимостьВалютныхПоказателей()
	
	УстановитьВидимостьВалютныхПоказателей("ДебиторскаяЗадолженностьГруппаВалюта", "ДебиторскаяЗадолженностьСуммаВал", "ДебиторскаяЗадолженностьСумма", "Договор");
	УстановитьВидимостьВалютныхПоказателей("КредиторскаяЗадолженностьГруппаВалюта", "КредиторскаяЗадолженностьСуммаВал", "КредиторскаяЗадолженностьСумма", "ДоговорКредитор");

КонецПроцедуры 

&НаСервере
Процедура УстановитьВидимостьВалютныхПоказателей(ИмяЭлемента, ИмяЭлементаСуммаВал, ИмяЭлементаСуммаРуб, ИмяРеквизита)
	
	// если валюты договоров кредитора и дебитора совпадают и отличны от рублей, 
	// то показатели "Курс", "Кратность" и "Сумма (Руб.)" скрываем
	Если Объект.Договор.ВалютаДоговора = Объект.ДоговорКредитор.ВалютаДоговора
		и Объект.Договор.ВалютаДоговора <> ВалютаРегламентированногоУчета Тогда
		
		Элементы[ИмяЭлемента].Видимость = Ложь;
		Элементы[ИмяЭлементаСуммаРуб].Видимость = Ложь;
		Элементы[ИмяЭлементаСуммаВал].Видимость = Истина;
		
	// если валюты договоров кредитора и дебитора "Руб.", 
	// то показатели "Курс", "Кратность" и "Сумма (Вал.)" скрываем и оставляем только "Сумма (Руб.)"
	ИначеЕсли Объект.Договор.ВалютаДоговора = Объект.ДоговорКредитор.ВалютаДоговора
		и Объект.Договор.ВалютаДоговора = ВалютаРегламентированногоУчета Тогда
		
		Элементы[ИмяЭлемента].Видимость = Ложь;
		Элементы[ИмяЭлементаСуммаРуб].Видимость = Истина;
		Элементы[ИмяЭлементаСуммаВал].Видимость = Ложь;
		
	// если валюты различаются (этот вариант возможен когда у одного из договоров валюта "Руб")
	Иначе
		
		// показатели "Курс", "Кратность" устанавливаем в зависимости от валюты договора
		Элементы[ИмяЭлемента].Видимость = (Не Объект[ИмяРеквизита].ВалютаДоговора.Пустая() И Объект[ИмяРеквизита].ВалютаДоговора <> ВалютаРегламентированногоУчета);   
		
		// показатели "Сумма (Вал.)" и "Сумма (Руб.)" устанавливаем в зависимости от комбинации валют договоров
		
		// дебиторский договор
		Если ИмяРеквизита = "Договор" Тогда
			Если Объект.Договор.ВалютаДоговора =  ВалютаРегламентированногоУчета Тогда
				Элементы[ИмяЭлементаСуммаРуб].Видимость = Истина;
				Элементы[ИмяЭлементаСуммаВал].Видимость = Ложь;
			Иначе
				Элементы[ИмяЭлементаСуммаРуб].Видимость = Истина;
				Элементы[ИмяЭлементаСуммаВал].Видимость = Истина;
			КонецЕсли;
			
		// кредиторский договор
		ИначеЕсли ИмяРеквизита = "ДоговорКредитор" Тогда 
			Если Объект.ДоговорКредитор.ВалютаДоговора =  ВалютаРегламентированногоУчета Тогда
				Элементы[ИмяЭлементаСуммаРуб].Видимость = Истина;
				Элементы[ИмяЭлементаСуммаВал].Видимость = Ложь;
			Иначе
				Элементы[ИмяЭлементаСуммаРуб].Видимость = Истина;
				Элементы[ИмяЭлементаСуммаВал].Видимость = Истина;
			КонецЕсли;
		Иначе 
			// при корректном вызове процедуры сюда попадать не должны
		КонецЕсли;     
		
	КонецЕсли;
	
КонецПроцедуры   

&НаСервере
Процедура ОбработатьИзменениеВалюты(ИмяТабличнойЧасти, ТекущаяСтрока)
	
	СтрокаТекущая = Объект[ИмяТабличнойЧасти].НайтиПоИдентификатору(ТекущаяСтрока);  
	
	ДатаКурса  = ?(ЗначениеЗаполнено(Объект.Дата), Объект.Дата, ТекущаяДата());
	КурсВалюты = CW_Финансы.ПолучитьКурсВалюты(СтрокаТекущая.Валюта, ДатаКурса);
	
	СтрокаТекущая.Курс 		= КурсВалюты.Курс;
	СтрокаТекущая.Кратность = КурсВалюты.Кратность; 
	
	ПересчитатьСуммуПоКурсуНаСервере(ТекущаяСтрока, ИмяТабличнойЧасти); 
	
КонецПроцедуры

//---Обработчики событий 



&НаСервере
Процедура УстановитьДоступныеТипыДокументаОснования(ИмяЭлемента, ИмяРеквизита)
	
	ОграничениеТипа = ПолучитьДоступныеТипыДокументаОснования(ИмяРеквизита);
	Элементы[ИмяЭлемента].ОграничениеТипа  = Новый ОписаниеТипов(ОграничениеТипа);
	
КонецПроцедуры

&НаСервере
Функция ПолучитьДоступныеТипыДокументаОснования(ИмяРеквизита)
	
	мТипы = Новый Массив;   

	Если Не ЗначениеЗаполнено(Объект[ИмяРеквизита]) Тогда
		Возврат мТипы;
	КонецЕсли;
	
	мТипы.Добавить(Тип("ДокументСсылка.CW_КорректировкаОперативнойЗадолженности"));
	мТипы.Добавить(Тип("ДокументСсылка.CW_ДвижениеДенежныхСредств"));
	мТипы.Добавить(Тип("ДокументСсылка.CW_Оплата"));
	
	Если Объект[ИмяРеквизита].ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПокупателем Тогда 
		мТипы.Добавить(Тип("ДокументСсылка.CW_ДоходыПоГрузоперевозке"));                           
	Иначе
		мТипы.Добавить(Тип("ДокументСсылка.CW_РасходыПоГрузоперевозке"));                          
	КонецЕсли;
	
	Возврат мТипы; 
	
КонецФункции 



&НаСервере
Процедура ЗаполнитьДобавленныеКолонкиТабличныхЧастей(ТекущийОбъект, ИмяТаблицы)
	
	Для Каждого СтрокаТаблицы из ТекущийОбъект[ИмяТаблицы] Цикл   
		ИндексСтроки  = ТекущийОбъект[ИмяТаблицы].Индекс(СтрокаТаблицы);  

		СтрокаОбъекта = Объект[ИмяТаблицы][ИндексСтроки];
		Если ТипЗнч(СтрокаОбъекта.ДокументСчет)=Тип("ДокументСсылка.CW_КорректировкаОперативнойЗадолженности") Тогда 
			СтрокаОбъекта.Представление =  СокрЛП(СтрокаОбъекта.ДокументСчет);
		Иначе
			СтрокаОбъекта.Представление = СтрокаОбъекта.ДокументСчет.ПредставлениеДокумента;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура УправлениеЭлементамиФормы()
	
	Элементы.СтраницаКомментарий.Заголовок = " Комментарий" +?(ЗначениеЗаполнено(Объект.Комментарий)," (*)","");
	
КонецПроцедуры

&НаСервере
Функция ОпределитьПараваДоступа()
	
	ПравоРедактирования = CW_ПраваДоступа.ПравоДоступно("РедактированиеФинансов_ОперативныйУчет");
	Если НЕ ПравоРедактирования ИЛИ ЭтаФорма.ТолькоПросмотр Тогда
		ЭтаФорма.ТолькоПросмотр = Истина;
	КонецЕсли;
	
КонецФункции

&НаСервере
Функция СформироватьЗаголовокДокумента()
	
	ЭтаФорма.Заголовок = "Корректировка оперативной задолженности" + " " 
					+ ?(ЗначениеЗаполнено(Объект.ВидОперации), "("+Объект.ВидОперации+")", "")
					+ ?(ЗначениеЗаполнено(Объект.Ссылка), " "+Объект.Номер+" от "+Объект.Дата, " (создание)");
					
КонецФункции 
 
&НаСервере
Функция ОчиститьТабличныеЧастиДокумента()
	
	Объект.ДебиторскаяЗадолженность.Очистить();
	Объект.КредиторскаяЗадолженность.Очистить();

	ОбновитьИтогиНаФорме();
	
КонецФункции

&НаСервере
Функция ЗаполнитьДебиторскуюЗадолженностьНаСервере()
	
	Объект.ДебиторскаяЗадолженность.Очистить();
	
	ПараметрыПроцедуры = Новый Структура;
	ПараметрыПроцедуры.Вставить("Организация", 	Объект.Организация);
	ПараметрыПроцедуры.Вставить("Контрагент", 	Объект.Контрагент);
	ПараметрыПроцедуры.Вставить("Договор", 		Объект.Договор);
	//Подсистема.УчетПриложенийДоговоров
	ПараметрыПроцедуры.Вставить("ПриложениеКДоговору", Объект.ПриложениеКДоговору);
	//Подсистема.УчетПриложенийДоговоров 
	ПараметрыПроцедуры.Вставить("ВидЗадолженности", 	"ДЕБИТОРСКАЯ");
	
	Если Объект.Договор.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПокупателем Тогда
		РезультатЗапроса = ДебиторскуюЗадолженностьОстатки(ПараметрыПроцедуры);
	Иначе
		РезультатЗапроса = КредиторскаяЗадолженностьОстатки(ПараметрыПроцедуры);
	КонецЕсли; 
	
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока =  Объект.ДебиторскаяЗадолженность.Добавить();
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		
		КурсПоСтроке = 1; КратностьПоСтроке = 1;
		Если Выборка.Валюта <> ВалютаРегламентированногоУчета Тогда
			
			КурсПоСтроке = ?(Выборка.СуммаВал = 0, 1, Окр(Выборка.Сумма / Выборка.СуммаВал, 4));
			
			ДатаКурса = Объект.Дата;
			Если ЗначениеЗаполнено(Выборка.ДокументСчет) тогда
				ДатаКурса = Выборка.ДокументДата;
			КонецЕсли;
			
			ДанныеКурса 		= CW_Финансы.ПолучитьКурсВалюты(Выборка.Валюта, ДатаКурса);  
			КратностьПоСтроке 	= ДанныеКурса.Кратность;  
			КурсПоСтроке		= Окр(КурсПоСтроке * КратностьПоСтроке, 4);
		КонецЕсли;
		
		НоваяСтрока.Курс 		= КурсПоСтроке;
		НоваяСтрока.Кратность 	= КратностьПоСтроке;
		
	КонецЦикла; 

	ОбновитьИтогиНаФорме();
	
КонецФункции

&НаСервере
Функция ЗаполнитьКредиторскуюЗадолженностьНаСервере()
	
	Объект.КредиторскаяЗадолженность.Очистить();
	
	ПараметрыПроцедуры = Новый Структура;
	ПараметрыПроцедуры.Вставить("Организация", 	Объект.Организация);
	ПараметрыПроцедуры.Вставить("Контрагент", 	Объект.КонтрагентКредитор);
	ПараметрыПроцедуры.Вставить("Договор", 		Объект.ДоговорКредитор);
	//Подсистема.УчетПриложенийДоговоров
	ПараметрыПроцедуры.Вставить("ПриложениеКДоговору", Объект.ПриложениеКДоговоруКредитор);
	//Подсистема.УчетПриложенийДоговоров
	ПараметрыПроцедуры.Вставить("ВидЗадолженности", 	"КРЕДИТОРСКАЯ");
	
	Если Объект.ДоговорКредитор.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПокупателем Тогда
		РезультатЗапроса = ДебиторскуюЗадолженностьОстатки(ПараметрыПроцедуры);
	Иначе
		РезультатЗапроса = КредиторскаяЗадолженностьОстатки(ПараметрыПроцедуры);
	КонецЕсли; 

	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока =  Объект.КредиторскаяЗадолженность.Добавить();
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		
		КурсПоСтроке = 1; КратностьПоСтроке = 1;
		Если Выборка.Валюта <> ВалютаРегламентированногоУчета Тогда
			
			КурсПоСтроке = ?(Выборка.СуммаВал = 0, 1, Окр(Выборка.Сумма / Выборка.СуммаВал, 4));
			
			ДатаКурса = Объект.Дата;
			Если ЗначениеЗаполнено(Выборка.ДокументСчет) тогда
				ДатаКурса = Выборка.ДокументДата;
			КонецЕсли;
			
			ДанныеКурса 		= CW_Финансы.ПолучитьКурсВалюты(Выборка.Валюта, ДатаКурса);  
			КратностьПоСтроке 	= ДанныеКурса.Кратность;  
			КурсПоСтроке		= Окр(КурсПоСтроке * КратностьПоСтроке, 4);
		КонецЕсли;
		
		НоваяСтрока.Курс 		= КурсПоСтроке;
		НоваяСтрока.Кратность 	= КратностьПоСтроке;
		
	КонецЦикла; 
	
	ОбновитьИтогиНаФорме();
	
КонецФункции

&НаСервере
Функция ДебиторскуюЗадолженностьОстатки(ПараметрыПроцедуры)
	
	Запрос = Новый Запрос; 
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.Текст = "ВЫБРАТЬ
	|	CW_ОперативнаяДебиторскаяЗадолженностьОстатки.Счет КАК ДокументСчет,
	|	CW_ОперативнаяДебиторскаяЗадолженностьОстатки.Счет.Дата КАК ДокументДата,
	|	CW_ОперативнаяДебиторскаяЗадолженностьОстатки.Валюта КАК Валюта,
	|	CW_ОперативнаяДебиторскаяЗадолженностьОстатки.СчетУчета КАК СчетЗадолженности,
	|	CW_ОперативнаяДебиторскаяЗадолженностьОстатки.Всего_ВалютаОстаток КАК СуммаВал,
	|	CW_ОперативнаяДебиторскаяЗадолженностьОстатки.ВсегоОстаток КАК Сумма
	|ПОМЕСТИТЬ ДляОтбора
	|ИЗ
	|	РегистрНакопления.CW_ОперативнаяДебиторскаяЗадолженность.Остатки(
	|			&Период,
	|			Организация = &Организация
	|				И Контрагент = &Контрагент
	|				И Договор = &Договор
	|				И ПриложениеКДоговору = &ПриложениеКДоговору) КАК CW_ОперативнаяДебиторскаяЗадолженностьОстатки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(Перечисление.CW_ВидыОперативнойЗадолженности.Дебиторская) КАК ВидЗадолженности,
	|	ДляОтбора.ДокументСчет КАК ДокументСчет,
	|	ДляОтбора.ДокументДата КАК ДокументДата,
	|	ВЫБОР
	|		КОГДА ДляОтбора.ДокументСчет ССЫЛКА Документ.CW_КорректировкаОперативнойЗадолженности
	|			ТОГДА ПРЕДСТАВЛЕНИЕССЫЛКИ(ДляОтбора.ДокументСчет)
	|		ИНАЧЕ ДляОтбора.ДокументСчет.ПредставлениеДокумента
	|	КОНЕЦ КАК Представление,
	|	ДляОтбора.Валюта КАК Валюта,
	|	ДляОтбора.СчетЗадолженности КАК СчетЗадолженности,
	|	&Знак * ДляОтбора.СуммаВал КАК СуммаВал,
	|	&Знак * ДляОтбора.Сумма КАК Сумма
	|ИЗ
	|	ДляОтбора КАК ДляОтбора
	|ГДЕ
	|	//УслоивеОтбора 
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДляОтбора.ДокументДата";
	
	Если  ПараметрыПроцедуры.ВидЗадолженности = "КРЕДИТОРСКАЯ" Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "//УслоивеОтбора", "ДляОтбора.СуммаВал < 0");
		Запрос.УстановитьПараметр("Знак", -1); 
	ИначеЕсли  ПараметрыПроцедуры.ВидЗадолженности = "ДЕБИТОРСКАЯ" Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "//УслоивеОтбора", "ДляОтбора.СуммаВал > 0");
		Запрос.УстановитьПараметр("Знак", 1); 
	Иначе
		ВызватьИсключение "Ошибка заполнения табличной части!";
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Период", Новый Граница(Объект.Дата,ВидГраницы.Исключая)); 
	
	Для Каждого КлючЗначение из ПараметрыПроцедуры Цикл
		Запрос.УстановитьПараметр(КлючЗначение.Ключ, КлючЗначение.Значение);
	КонецЦикла;
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат РезультатЗапроса;
	
КонецФункции

&НаСервере
Функция КредиторскаяЗадолженностьОстатки(ПараметрыПроцедуры)
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.Текст = "ВЫБРАТЬ
	|	CW_ОперативнаяКредиторскаяЗадолженностьОстатки.Счет КАК ДокументСчет,
	|	CW_ОперативнаяКредиторскаяЗадолженностьОстатки.Счет.Дата КАК ДокументДата,
	|	CW_ОперативнаяКредиторскаяЗадолженностьОстатки.Валюта КАК Валюта,
	|	CW_ОперативнаяКредиторскаяЗадолженностьОстатки.СчетУчета КАК СчетЗадолженности,
	|	CW_ОперативнаяКредиторскаяЗадолженностьОстатки.Всего_ВалютаОстаток КАК СуммаВал,
	|	CW_ОперативнаяКредиторскаяЗадолженностьОстатки.ВсегоОстаток КАК Сумма
	|ПОМЕСТИТЬ ДляОтбора
	|ИЗ
	|	РегистрНакопления.CW_ОперативнаяКредиторскаяЗадолженность.Остатки(
	|			&Период,
	|			Организация = &Организация 
	|				И Контрагент = &Контрагент
	|				И Договор = &Договор
	|				И ПриложениеКДоговору = &ПриложениеКДоговору) КАК CW_ОперативнаяКредиторскаяЗадолженностьОстатки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДляОтбора.ДокументСчет КАК ДокументСчет,
	|	ДляОтбора.ДокументДата КАК ДокументДата,
	|	ДляОтбора.Валюта КАК Валюта,
	|	ДляОтбора.СчетЗадолженности КАК СчетЗадолженности,
	|	&Знак * ДляОтбора.СуммаВал КАК СуммаВал,
	|	&Знак * ДляОтбора.Сумма КАК Сумма,
	|	ЗНАЧЕНИЕ(Перечисление.CW_ВидыОперативнойЗадолженности.Кредиторская) КАК ВидЗадолженности,
	|	ВЫБОР
	|		КОГДА ДляОтбора.ДокументСчет ССЫЛКА Документ.CW_КорректировкаОперативнойЗадолженности
	|			ТОГДА ПРЕДСТАВЛЕНИЕССЫЛКИ(ДляОтбора.ДокументСчет)
	|		ИНАЧЕ ДляОтбора.ДокументСчет.ПредставлениеДокумента
	|	КОНЕЦ КАК Представление
	|ИЗ
	|	ДляОтбора КАК ДляОтбора
	|ГДЕ
	|	//УслоивеОтбора
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДляОтбора.ДокументДата";   
	
	Если  ПараметрыПроцедуры.ВидЗадолженности = "КРЕДИТОРСКАЯ" Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "//УслоивеОтбора", "ДляОтбора.СуммаВал > 0");
		Запрос.УстановитьПараметр("Знак", 1); 
	ИначеЕсли  ПараметрыПроцедуры.ВидЗадолженности = "ДЕБИТОРСКАЯ" Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "//УслоивеОтбора", "ДляОтбора.СуммаВал < 0");
		Запрос.УстановитьПараметр("Знак", -1); 
	Иначе
		ВызватьИсключение "Ошибка заполнения табличной части!";
	КонецЕсли;

	
	Запрос.УстановитьПараметр("Период", Новый Граница(Объект.Дата,ВидГраницы.Исключая)); 
	
	Для Каждого КлючЗначение из ПараметрыПроцедуры Цикл
		Запрос.УстановитьПараметр(КлючЗначение.Ключ, КлючЗначение.Значение);
	КонецЦикла;
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат РезультатЗапроса;
	
КонецФункции
 
&НаСервере
Процедура ОбновитьИтогиНаФорме()
	
	//Дебиторска и кредиторская задолженность     
	Если (Объект.ДоговорКредитор.ВалютаДоговора = ВалютаРегламентированногоУчета и Объект.Договор.ВзаиморасчетыВУЕ) 
		или  (Объект.Договор.ВалютаДоговора = ВалютаРегламентированногоУчета и Объект.ДоговорКредитор.ВзаиморасчетыВУЕ) Тогда
		ЗачтеноКЗ 	 	= Объект.КредиторскаяЗадолженность.Итог("Сумма");  
		ВалютаЗачетаКЗ 	= ВалютаРегламентированногоУчета;

		ЗачтеноДЗ 		= Объект.ДебиторскаяЗадолженность.Итог("Сумма");   
		ВалютаЗачетаДЗ	= ВалютаРегламентированногоУчета

	Иначе
		ЗачтеноКЗ 		= Объект.КредиторскаяЗадолженность.Итог("СуммаВал");   
		ВалютаЗачетаКЗ 	= Объект.ДоговорКредитор.ВалютаДоговора;

		ЗачтеноДЗ 		= Объект.ДебиторскаяЗадолженность.Итог("СуммаВал");   
		ВалютаЗачетаДЗ 	= Объект.Договор.ВалютаДоговора;
	КонецЕсли;  
	
	Разница 	= ЗачтеноДЗ - ЗачтеноКЗ;  
	
	ИтогоКЗ 	= "Зачтено задолженности: "+Формат(ЗачтеноКЗ, "ЧЦ=15; ЧДЦ=2; ЧН=")+" "+Строка(ВалютаЗачетаКЗ);
	ИтогоДЗ 	= "Зачтено задолженности: "+Формат(ЗачтеноДЗ, "ЧЦ=15; ЧДЦ=2; ЧН=")+" "+Строка(ВалютаЗачетаДЗ);
	
	Если Разница <> 0 Тогда   
		ИтогоКЗ = ИтогоКЗ + "; Разница: "+Формат(Разница,"ЧЦ=15; ЧДЦ=2; ЧН=")+" "+Строка(ВалютаЗачетаКЗ);
		ИтогоДЗ = ИтогоДЗ + "; Разница: "+Формат(Разница,"ЧЦ=15; ЧДЦ=2; ЧН=")+" "+Строка(ВалютаЗачетаДЗ);
	КонецЕсли; 
	//--Дебиторска и кредиторская задолженность
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВопросаУстановкиНовогоНомера(Ответ, ДополнительныеПараметры) Экспорт 
	
	Если Ответ=КодВозвратаДиалога.Да Тогда
		УстановитьНовыйНомерНаСервере();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция УстановитьНовыйНомерНаСервере()
	
	ТОбъект = РеквизитФормыВЗначение("Объект");
	ТОбъект.УстановитьНовыйНомер();
	ЗначениеВРеквизитФормы(ТОбъект,"Объект");
	
КонецФункции


