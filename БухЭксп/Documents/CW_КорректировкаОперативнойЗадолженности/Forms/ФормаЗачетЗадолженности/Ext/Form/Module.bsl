//События формы
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	

	CW_Документы.УстановитьПараметрыФункциональныхОпцийФормы(Этаформа);
	
	_УФС.ОтключитьИсториюВыбораЭлементовФормы(ЭтаФорма);
	
	ОпределитьПараваДоступа();
	
	ВалютаРегламентированногоУчета = CW_Настройки.ВалютаРегламентированногоУчета();
	
	Если Параметры.Ключ.Пустая() Тогда
		ОсновнаяОрганизация = CW_Настройки.ОсновнаяОрганизация();
		Объект.Организация  = ОсновнаяОрганизация;	
	КонецЕсли;
	
	СформироватьЗаголовокДокумента();

	СостояниеДокумента = ОбщегоНазначенияБП.СостояниеДокумента(Объект); // ВызовБП
	
	УстановитьДоступныеТипыДокументаОснования("КредиторскаяЗадолженностьДокументСчет", "ДоговорКредитор");
 	УстановитьДоступныеТипыДокументаОснования("ДебиторскаяЗадолженностьДокументСчет", "Договор");

	ВидимостьВалютныхПоказателей();
	
	УправлениеЭлементамиФормы();
	ОбновитьИтогиНаФорме();

	//Подсистема.УчетПриложенийДоговоров
	УстановитьВидимостьПриложенийДоговоров();
	//Подсистема.УчетПриложенийДоговоров
	
	//Внешние подклчюаемые команды
	CW_ПодключаемыеКомандыСервер.ПриСозданииНаСервере(ЭтотОбъект);
	
КонецПроцедуры   

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	ЗаполнитьДобавленныеКолонкиТабличныхЧастей(ТекущийОбъект, "ДебиторскаяЗадолженность");
	ЗаполнитьДобавленныеКолонкиТабличныхЧастей(ТекущийОбъект, "КредиторскаяЗадолженность");
	
	
КонецПроцедуры  

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	ВалютаЗачетаДЗ 	= Объект.Договор.ВалютаДоговора;
	ВалютаЗачетаКЗ 	= Объект.ДоговорКредитор.ВалютаДоговора;   
	
	ИмяПоляКЗ 		= "СуммаВал";
	Если Объект.ДоговорКредитор.ВалютаДоговора = ВалютаРегламентированногоУчета 
		или Объект.ДоговорКредитор.ВзаиморасчетыВУЕ Тогда
		ИмяПоляКЗ 		= "Сумма";
		ВалютаЗачетаКЗ 	= ВалютаРегламентированногоУчета;
	КонецЕсли;  
	
	ИмяПоляДЗ = "СуммаВал";
	Если Объект.Договор.ВалютаДоговора = ВалютаРегламентированногоУчета 
		или Объект.Договор.ВзаиморасчетыВУЕ Тогда
		ИмяПоляДЗ 		= "Сумма";
		ВалютаЗачетаДЗ	= ВалютаРегламентированногоУчета
	КонецЕсли;  
	
	ЗачтеноКЗ = Объект.КредиторскаяЗадолженность.Итог(ИмяПоляКЗ);  
	ЗачтеноДЗ = Объект.ДебиторскаяЗадолженность.Итог(ИмяПоляДЗ);   
	
КонецПроцедуры


&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	СформироватьЗаголовокДокумента();  
	
	ЗаполнитьДобавленныеКолонкиТабличныхЧастей(ТекущийОбъект, "ДебиторскаяЗадолженность");
	ЗаполнитьДобавленныеКолонкиТабличныхЧастей(ТекущийОбъект, "КредиторскаяЗадолженность");

	СостояниеДокумента = ОбщегоНазначенияБП.СостояниеДокумента(Объект); // ВызовБП
	
КонецПроцедуры  

