	СтруктураОтбора = ПолучитьСтруктуруПараметровВыбораДоговора(Объект.Контрагент, Объект.ДоговорКредитор); 
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("МножественныйВыбор", Ложь);
	СтруктураПараметров.Вставить("ЗакрыватьПриВыборе", Истина);
	СтруктураПараметров.Вставить("Отбор", СтруктураОтбора);
	
	ОткрытьФорму("Справочник.CW_ДоговорыПоГрузоперевозкам.ФормаВыбора", СтруктураПараметров, Элемент);

КонецПроцедуры

&НаСервере
Функция ПолучитьСтруктуруПараметровВыбораДоговора(ВладелецДоговора, ДоговорИсточник) 
	
	СтруктураОтбора = Новый Структура;
	СтруктураОтбора.Вставить("Организация", 	Объект.Организация);
	СтруктураОтбора.Вставить("Владелец", 		ВладелецДоговора); 
	
	Если ЗначениеЗаполнено(ДоговорИсточник) Тогда
		СтруктураОтбора.Вставить("ВалютаДоговора", 	ДоговорИсточник.ВалютаДоговора);
		СтруктураОтбора.Вставить("ВидДоговора", 	ДоговорИсточник.ВидДоговора);
	КонецЕсли;
	
	Возврат СтруктураОтбора;
	
КонецФункции      


