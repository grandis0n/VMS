	//Списание задолженности
	ИтогоПоКорректировке =	"Всего: "+Формат(Объект.СписаниеОперативнойЗадолженности.Итог("СуммаВал"),"ЧЦ=15; ЧДЦ=2; ЧН=")+" " +Строка(ВалютаДоговора);
	//--Списание задолженности
	
КонецПроцедуры


