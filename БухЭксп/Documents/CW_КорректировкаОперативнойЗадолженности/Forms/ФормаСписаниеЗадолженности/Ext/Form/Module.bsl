&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	

	CW_Документы.УстановитьПараметрыФункциональныхОпцийФормы(Этаформа);
	
	_УФС.ОтключитьИсториюВыбораЭлементовФормы(ЭтаФорма);
	
	ОпределитьПараваДоступа();
	
	ВалютаРегламентированногоУчета = CW_Настройки.ВалютаРегламентированногоУчета();
	
	Если Параметры.Ключ.Пустая() Тогда
		ОсновнаяОрганизация = CW_Настройки.ОсновнаяОрганизация();
		Объект.Организация  = ОсновнаяОрганизация;	
	КонецЕсли;
	
	СформироватьЗаголовокДокумента();

	СостояниеДокумента = ОбщегоНазначенияБП.СостояниеДокумента(Объект); // ВызовБП

	УстановитьВидимостьВалютныхПоказателей();
	УстановитьДоступныеТипыДокументаОснования();
	УправлениеЭлементамиФормы();
	ОбновитьИтогиНаФорме();
	
	
	#Область МСФО_Модуль
	СчетСписанияПриИзмененииНаСервере();
	#КонецОбласти
	
	//Подсистема.УчетПриложенийДоговоров
	УстановитьВидимостьПриложенийДоговоров();
	//Подсистема.УчетПриложенийДоговоров
	
	//Внешние подклчюаемые команды
	CW_ПодключаемыеКомандыСервер.ПриСозданииНаСервере(ЭтотОбъект);
	
КонецПроцедуры   

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	ЗаполнитьДобавленныеКолонкиТабличныхЧастей(ТекущийОбъект, "СписаниеОперативнойЗадолженности");
	
КонецПроцедуры 

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	СформироватьЗаголовокДокумента();  
	
	ЗаполнитьДобавленныеКолонкиТабличныхЧастей(ТекущийОбъект, "СписаниеОперативнойЗадолженности");

	СостояниеДокумента = ОбщегоНазначенияБП.СостояниеДокумента(Объект); // ВызовБП
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "ВыполнитьМетодВладельца" Тогда
			
		Если ТипЗнч(Параметр) = тип("Структура") Тогда
			УникальныйИдентификаторВладельца 	= Неопределено;
			МетодыФормыВладельца 				= Неопределено;
			
			Параметр.Свойство("УникальныйИдентификатор"	, УникальныйИдентификаторВладельца);
			Параметр.Свойство("МетодыФормыВладельца"	, МетодыФормыВладельца);
			
			Если ЭтаФорма.УникальныйИдентификатор = УникальныйИдентификаторВладельца Тогда
				Если Не МетодыФормыВладельца = Неопределено и ТипЗнч(МетодыФормыВладельца) = Тип("Массив") Тогда
					
					Для Каждого СтрокаМассива из МетодыФормыВладельца Цикл
						Попытка
							Выполнить(СтрокаМассива);
						Исключение
						КонецПопытки;
					КонецЦикла;
					
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;	

	КонецЕсли;
	
КонецПроцедуры

