	Если (ЗначениеЗаполнено(Объект.Номер) И ЗначениеЗаполнено(Объект.Организация)) Тогда
		
		ПОВ = Новый ОписаниеОповещения("ОбработкаВопросаУстановкиНовогоНомера",ЭтотОбъект); 
		ПоказатьВопрос(ПОВ,"Установить новый номер документа", РежимДиалогаВопрос.ДаНет); 
		
