&НаСервере
Процедура ЗаполнитьДобавленныеКолонкиТабличныхЧастей(ТекущийОбъект, ИмяТаблицы)
	
	Для Каждого СтрокаТаблицы из ТекущийОбъект[ИмяТаблицы] Цикл   
		ИндексСтроки  = ТекущийОбъект[ИмяТаблицы].Индекс(СтрокаТаблицы);  

		СтрокаОбъекта = Объект[ИмяТаблицы][ИндексСтроки];
		Если ТипЗнч(СтрокаОбъекта.ДокументСчет)=Тип("ДокументСсылка.CW_КорректировкаОперативнойЗадолженности") Тогда 
			СтрокаОбъекта.Представление =  СокрЛП(СтрокаОбъекта.ДокументСчет);
		ИначеЕсли ТипЗнч(СтрокаОбъекта.ДокументСчет)=Тип("ДокументСсылка.CW_РасходыПоГрузоперевозке") или
                  ТипЗнч(СтрокаОбъекта.ДокументСчет)=Тип("ДокументСсылка.CW_ДоходыПоГрузоперевозке") 
		Тогда
			СтрокаОбъекта.Представление = СтрокаОбъекта.ДокументСчет.ПредставлениеДокумента; 
		Иначе
			СтрокаОбъекта.Представление = СтрокаОбъекта.ДокументСчет;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура УправлениеЭлементамиФормы()
	
	Элементы.СтраницаКомментарий.Заголовок = " Комментарий" +?(ЗначениеЗаполнено(Объект.Комментарий)," (*)","");
	Элементы.СтраницаСчетУчетаЗатрат.Видимость = ПолучитьФункциональнуюОпцию("CW_ВедениеБухгалтескогоУчетаМСФО");
	
КонецПроцедуры

Функция ОпределитьПараваДоступа()
	
	ПравоРедактирования = CW_ПраваДоступа.ПравоДоступно("РедактированиеФинансов_ОперативныйУчет");
	Если НЕ ПравоРедактирования ИЛИ ЭтаФорма.ТолькоПросмотр Тогда
		ЭтаФорма.ТолькоПросмотр = Истина;
	КонецЕсли;
	
КонецФункции

&НаСервере
Функция СформироватьЗаголовокДокумента()
	
	ЗаголовокДокумента = 
		"Корректировка оперативной задолженности" + " " 
		+ ?(ЗначениеЗаполнено(Объект.ВидОперации), "("+нрег(Объект.ВидОперации)+")", "")
		+ ?(ЗначениеЗаполнено(Объект.Ссылка), " "+Объект.Номер+" от "+Объект.Дата, " (создание)");
	ЭтаФорма.Заголовок = ЗаголовокДокумента;
	
КонецФункции

&НаКлиенте
Процедура ЗаполнитьКорректировку(Команда)
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ОбработкаВопросаОчисткиКорректировки",ЭтотОбъект); 
	
	Если Объект.СписаниеОперативнойЗадолженности.Количество() > 0 Тогда
		ПоказатьВопрос(ОписаниеОповещения, "Табличная часть будет очищена. Продолжить?",РежимДиалогаВопрос.ДаНет);
	Иначе
		ВыполнитьОбработкуОповещения(ОписаниеОповещения, КодВозвратаДиалога.Да);
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВопросаОчисткиКорректировки(Ответ, ДополнительныеПараметры) Экспорт 
	
	Если Ответ = КодВозвратаДиалога.Да Тогда  
		Отказ = ложь;
		ПроверитьЗаполнениеРеквизитов(Отказ);
		Если Отказ Тогда
			Возврат;    
		Конецесли; 
		
		ЗаполнитьКорректировкуНаСервере();
		ОбновитьИтогиНаФорме();
	КонецЕсли; 
	
КонецПроцедуры  

&НаСервере 
Процедура ПроверитьЗаполнениеРеквизитов(Отказ)
	
	Если Не ЗначениеЗаполнено(Объект.Договор) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не выбран договор.",,"Договор", "Объект", Отказ);
	Иначе
		Если Не ЗначениеЗаполнено(Объект.Договор.ВидДоговора) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не указан вид договора.",,"Договор", "Объект", Отказ);
		Иначе
			ДоступныеВидыДоговоров = новый Массив;
			ДоступныеВидыДоговоров.добавить(ПредопределенноеЗначение("Перечисление.ВидыДоговоровКонтрагентов.СПоставщиком"));
			ДоступныеВидыДоговоров.добавить(ПредопределенноеЗначение("Перечисление.ВидыДоговоровКонтрагентов.СПокупателем"));
			Если ДоступныеВидыДоговоров.Найти(Объект.Договор.ВидДоговора)= Неопределено Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Некорректный вид договора.",,"Договор", "Объект", Отказ);
			КонецЕсли;
		КонецЕсли; 
	КонецЕсли; 
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьКорректировкуНаСервере() 
	
	Объект.СписаниеОперативнойЗадолженности.Очистить();
	
	Если Объект.Договор.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		|	CW_ОперативнаяКредиторскаяЗадолженностьОстатки.Счет КАК ДокументСчет,
		|	CW_ОперативнаяКредиторскаяЗадолженностьОстатки.Счет.Дата КАК ДокументДата,
		|	ВЫБОР
		|		КОГДА CW_ОперативнаяКредиторскаяЗадолженностьОстатки.Счет ССЫЛКА Документ.CW_КорректировкаОперативнойЗадолженности
		|			ТОГДА ПРЕДСТАВЛЕНИЕССЫЛКИ(CW_ОперативнаяКредиторскаяЗадолженностьОстатки.Счет)
		|		ИНАЧЕ CW_ОперативнаяКредиторскаяЗадолженностьОстатки.Счет.ПредставлениеДокумента
		|	КОНЕЦ КАК Представление,
		|	CW_ОперативнаяКредиторскаяЗадолженностьОстатки.СчетУчета КАК СчетЗадолженности,
		|	CW_ОперативнаяКредиторскаяЗадолженностьОстатки.Валюта КАК Валюта,
		|	CW_ОперативнаяКредиторскаяЗадолженностьОстатки.Всего_ВалютаОстаток КАК СуммаВал,
		|	CW_ОперативнаяКредиторскаяЗадолженностьОстатки.ВсегоОстаток КАК Сумма
		|ИЗ
		|	РегистрНакопления.CW_ОперативнаяКредиторскаяЗадолженность.Остатки(
		|			&Период,
		|			Организация = &Организация
		|				И Контрагент = &Контрагент
		|				И Договор = &Договор
		//Подсистема.УчетПриложенийДоговоров
		|				И ПриложениеКДоговору = &ПриложениеКДоговору) КАК CW_ОперативнаяКредиторскаяЗадолженностьОстатки";
		//Подсистема.УчетПриложенийДоговоров
		
	КонецЕсли;
	
	Если Объект.Договор.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПокупателем Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		|	CW_ОперативнаяДебиторскаяЗадолженностьОстатки.Счет КАК ДокументСчет,
		|	CW_ОперативнаяДебиторскаяЗадолженностьОстатки.Счет.Дата КАК ДокументДата,
		|	ВЫБОР
		|		КОГДА CW_ОперативнаяДебиторскаяЗадолженностьОстатки.Счет ССЫЛКА Документ.CW_КорректировкаОперативнойЗадолженности
		|			ТОГДА ПРЕДСТАВЛЕНИЕССЫЛКИ(CW_ОперативнаяДебиторскаяЗадолженностьОстатки.Счет)
		|		ИНАЧЕ CW_ОперативнаяДебиторскаяЗадолженностьОстатки.Счет.ПредставлениеДокумента
		|	КОНЕЦ КАК Представление,
		|	CW_ОперативнаяДебиторскаяЗадолженностьОстатки.СчетУчета КАК СчетЗадолженности,
		|	CW_ОперативнаяДебиторскаяЗадолженностьОстатки.Валюта КАК Валюта,
		|	CW_ОперативнаяДебиторскаяЗадолженностьОстатки.Всего_ВалютаОстаток КАК СуммаВал,
		|	CW_ОперативнаяДебиторскаяЗадолженностьОстатки.ВсегоОстаток КАК Сумма
		|ИЗ
		|	РегистрНакопления.CW_ОперативнаяДебиторскаяЗадолженность.Остатки(
		|			&Период,
		|			Организация = &Организация
		|				И Контрагент = &Контрагент
		|				И Договор = &Договор
		//Подсистема.УчетПриложенийДоговоров
		|				И ПриложениеКДоговору = &ПриложениеКДоговору) КАК CW_ОперативнаяДебиторскаяЗадолженностьОстатки";
		//Подсистема.УчетПриложенийДоговоров
		
	КонецЕсли;   
	
	Запрос.УстановитьПараметр("Период", 		Новый Граница(Объект.Дата,ВидГраницы.Исключая));
	Запрос.УстановитьПараметр("Организация", 	Объект.Организация);
	Запрос.УстановитьПараметр("Контрагент", 	Объект.Контрагент);
	Запрос.УстановитьПараметр("Договор", 		Объект.Договор);
		
  	//Подсистема.УчетПриложенийДоговоров
	Запрос.УстановитьПараметр("ПриложениеКДоговору", Объект.ПриложениеКДоговору);
	//Подсистема.УчетПриложенийДоговоров
	
	РезультатЗапроса = Запрос.Выполнить();  
	
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока =  Объект.СписаниеОперативнойЗадолженности.Добавить();
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		
		КурсПоСтроке = 1; КратностьПоСтроке = 1;
		Если Выборка.Валюта <> ВалютаРегламентированногоУчета Тогда
			КурсПоСтроке = ?(Выборка.СуммаВал = 0, 1, Окр(Выборка.Сумма / Выборка.СуммаВал, 4));
			
			ДатаКурса = Объект.Дата;
			Если ЗначениеЗаполнено(Выборка.ДокументСчет) тогда
				ДатаКурса = Выборка.ДокументДата;
			КонецЕсли;
			
			ДанныеКурса 		= CW_Финансы.ПолучитьКурсВалюты(Выборка.Валюта, ДатаКурса);  
			КратностьПоСтроке 	= ДанныеКурса.Кратность;
			КурсПоСтроке 		= Окр(КурсПоСтроке * КратностьПоСтроке, 4);
		КонецЕсли;
		
		НоваяСтрока.Курс 		= КурсПоСтроке;
		НоваяСтрока.Кратность 	= КратностьПоСтроке;
	
	КонецЦикла; 
	
КонецПроцедуры

&НаСервере
Функция ОчиститьТабличныеЧастиДокумента()
	
	Объект.СписаниеОперативнойЗадолженности.Очистить();
	ОбновитьИтогиНаФорме();
	
КонецФункции
 
