#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
	
Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	CW_Документы.ЗаполнениеДокументов(ЭтотОбъект);
	
	ВалютаРегламентированногоУчета = CW_Настройки.ВалютаРегламентированногоУчета();
	
	Если ТипЗнч(ДанныеЗаполнения)=Тип("ДокументСсылка.CW_КорректировкаАктированияСчетов") Тогда
		
		// заполняем шапку
		Организация 			= ДанныеЗаполнения.Организация;
		Контрагент 				= ДанныеЗаполнения.Контрагент;
		Договор 				= ДанныеЗаполнения.Договор; 
		ПриложениеКДоговору 	= ДанныеЗаполнения.ПриложениеКДоговору; 
		
		ВидЗадолженности	= ПредопределенноеЗначение("Перечисление.CW_ВидыОперативнойЗадолженности.Дебиторская");
		ВидОперации			= ПредопределенноеЗначение("Перечисление.CW_ВидыОперацийКорректировкиОперативнойЗадолженности.СписаниеЗадолженности");

		// заполняем на основании корректировки актирования
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
		               |	CW_КорректировкаАктированияСчетовКорректировкаАктирования.ИсходящийСчет КАК ИсходящийСчет,
		               |	СУММА(CW_КорректировкаАктированияСчетовКорректировкаАктирования.Всего) КАК Всего
		               |ПОМЕСТИТЬ ВТ_ДанныеКорректировки
		               |ИЗ
		               |	Документ.CW_КорректировкаАктированияСчетов.КорректировкаАктирования КАК CW_КорректировкаАктированияСчетовКорректировкаАктирования
		               |ГДЕ
		               |	CW_КорректировкаАктированияСчетовКорректировкаАктирования.Ссылка = &Ссылка
		               |
		               |СГРУППИРОВАТЬ ПО
		               |	CW_КорректировкаАктированияСчетовКорректировкаАктирования.ИсходящийСчет
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ РАЗЛИЧНЫЕ
		               |	CW_ДоходыПоГрузоперевозкеУслуги.Ссылка КАК Счет,
		               |	CW_ДоходыПоГрузоперевозкеУслуги.Ссылка.ДатаСчета КАК ДатаСчета,
		               |	CW_ДоходыПоГрузоперевозкеУслуги.СчетЗадолженности КАК СчетЗадолженности,
		               |	CW_ДоходыПоГрузоперевозкеУслуги.Ссылка.Валюта КАК Валюта,
		               |	ВТ_ДанныеКорректировки.Всего КАК Всего
		               |ИЗ
		               |	ВТ_ДанныеКорректировки КАК ВТ_ДанныеКорректировки
		               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.CW_ДоходыПоГрузоперевозке.Услуги КАК CW_ДоходыПоГрузоперевозкеУслуги
		               |		ПО ВТ_ДанныеКорректировки.ИсходящийСчет = CW_ДоходыПоГрузоперевозкеУслуги.Ссылка
		               |ГДЕ
		               |	CW_ДоходыПоГрузоперевозкеУслуги.Ссылка В
		               |			(ВЫБРАТЬ
		               |				ВТ_ДанныеКорректировки.ИсходящийСчет КАК ИсходящийСчет
		               |			ИЗ
		               |				ВТ_ДанныеКорректировки КАК ВТ_ДанныеКорректировки)";
		
		Запрос.УстановитьПараметр("Ссылка", ДанныеЗаполнения);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		Выборка = РезультатЗапроса.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			СтруктураКурса  = CW_Финансы.ПолучитьКурсВалюты(Выборка.Валюта, Выборка.ДатаСчета);
			
			СтрокаДокумента = СписаниеОперативнойЗадолженности.Добавить();
			СтрокаДокумента.СчетЗадолженности 	= Выборка.СчетЗадолженности;
			СтрокаДокумента.ДокументСчет 		= Выборка.Счет;
			СтрокаДокумента.Валюта 				= Выборка.Валюта;
			СтрокаДокумента.Курс 				= СтруктураКурса.Курс;
			СтрокаДокумента.Кратность 			= СтруктураКурса.Кратность;
			СтрокаДокумента.СуммаВал 			= Выборка.Всего;  
			
			СтрокаДокумента.Сумма =  CW_Финансы.ПересчитатьИзВалютыВВалюту(Выборка.Всего,
										Выборка.Валюта, ВалютаРегламентированногоУчета,
										СтруктураКурса.Курс, 1,
										СтруктураКурса.Кратность,1);
			
		КонецЦикла;
		
	КонецЕсли; 
	
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)       
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	СоответствиеВидаЗадолженности  = ПолучитьСоответствиеВидаЗадолженностиВидуДоговора();
	
	ВидЗадолженности = СоответствиеВидаЗадолженности.Получить(Договор.ВидДоговора);
	ВидЗадолженности = ?(ВидЗадолженности=Неопределено, ПредопределенноеЗначение("Перечисление.CW_ВидыОперативнойЗадолженности.Кредиторская"), ВидЗадолженности);  
	
	Для каждого СтрокаТаблицы Из ДебиторскаяЗадолженность Цикл
		Если НЕ ЗначениеЗаполнено(СтрокаТаблицы.ВидЗадолженности) Тогда
			СтрокаТаблицы.ВидЗадолженности = ПредопределенноеЗначение("Перечисление.CW_ВидыОперативнойЗадолженности.Дебиторская");
		КонецЕсли; 
	КонецЦикла;  
	
	Для каждого СтрокаТаблицы Из КредиторскаяЗадолженность Цикл
		Если НЕ ЗначениеЗаполнено(СтрокаТаблицы.ВидЗадолженности) Тогда
			СтрокаТаблицы.ВидЗадолженности = ПредопределенноеЗначение("Перечисление.CW_ВидыОперативнойЗадолженности.Кредиторская");
		КонецЕсли; 
	КонецЦикла; 
	
	Если ВидОперации = ПредопределенноеЗначение("Перечисление.CW_ВидыОперацийКорректировкиОперативнойЗадолженности.СписаниеЗадолженности") Тогда
		СуммаДокумента = СписаниеОперативнойЗадолженности.Итог("СуммаВал");
	Иначе
		СуммаДокумента = ДебиторскаяЗадолженность.Итог("СуммаВал");
	конецЕсли;   
	
КонецПроцедуры     

Процедура ПриЗаписи(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если РучнаяКорректировка Тогда
		Возврат;
	КонецЕсли; 
	
	Для каждого Набор Из Движения Цикл
		Набор.Прочитать();
		Набор.Очистить();
	КонецЦикла;  
	
	Движения.Записать();
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	Если ДополнительныеСвойства.Свойство("ОтключитьЛогикуПроведения")
		И ДополнительныеСвойства.ОтключитьЛогикуПроведения = Истина Тогда
		Возврат;
	КонецЕсли;
	
	Если РучнаяКорректировка Тогда
		Возврат;
	КонецЕсли; 
	
	ВалютаРегламентированногоУчета 	= CW_Настройки.ВалютаРегламентированногоУчета();  
	
	Если ВидОперации = ПредопределенноеЗначение("Перечисление.CW_ВидыОперацийКорректировкиОперативнойЗадолженности.СписаниеЗадолженности") Тогда
		
		Если Договор.ВидДоговора <> ПредопределенноеЗначение("Перечисление.ВидыДоговоровКонтрагентов.СПоставщиком") и
			Договор.ВидДоговора <> ПредопределенноеЗначение("Перечисление.ВидыДоговоровКонтрагентов.СПокупателем") Тогда
			Возврат;	
		КонецЕсли;
		
		СформироватьДвиженияПоСписаниюЗадолженности(ВалютаРегламентированногоУчета); 
		
		Если Договор.ВалютаДоговора <> ВалютаРегламентированногоУчета Тогда  
			
			СтруктураПарамтеров = Новый Структура;
			СтруктураПарамтеров.Вставить("Контрагент",		Контрагент);
			СтруктураПарамтеров.Вставить("Договор",			Договор);   
			СтруктураПарамтеров.Вставить("ВалютаОбъекта", 	Договор.ВалютаДоговора);
			
			//Подсистема.УчетПриложенийДоговоров
			СтруктураПарамтеров.Вставить("ПриложениеКДоговору", ПриложениеКДоговору);
			//Подсистема.УчетПриложенийДоговоров
	
			СформироватьСписаниеКурсовыхРазниц(СтруктураПарамтеров); 
			
		КонецЕсли;
		
	КонецЕсли; 
	
	Если ВидОперации = ПредопределенноеЗначение("Перечисление.CW_ВидыОперацийКорректировкиОперативнойЗадолженности.ЗачетЗадолженности") Тогда
		
		ПроверитьСуммыЗачетаЗадолженности(ВалютаРегламентированногоУчета, Отказ);
		
		СформироватьДвиженияПоЗачетуЗадолженности(ВалютаРегламентированногоУчета); 
		
		Если Договор.ВалютаДоговора <> ВалютаРегламентированногоУчета Тогда  
			
			СтруктураПарамтеров = Новый Структура;
			СтруктураПарамтеров.Вставить("Контрагент",		Контрагент);
			СтруктураПарамтеров.Вставить("Договор",			Договор);   
			СтруктураПарамтеров.Вставить("ВалютаОбъекта", 	Договор.ВалютаДоговора);
			
			//Подсистема.УчетПриложенийДоговоров
			СтруктураПарамтеров.Вставить("ПриложениеКДоговору", ПриложениеКДоговору);
			//Подсистема.УчетПриложенийДоговоров
			
			СформироватьСписаниеКурсовыхРазниц(СтруктураПарамтеров); 

		КонецЕсли; 
		
		Если ДоговорКредитор.ВалютаДоговора <> ВалютаРегламентированногоУчета Тогда 
			СтруктураПарамтеров = Новый Структура;
			СтруктураПарамтеров.Вставить("Контрагент",		КонтрагентКредитор);
			СтруктураПарамтеров.Вставить("Договор",			ДоговорКредитор);   
			СтруктураПарамтеров.Вставить("ВалютаОбъекта", 	ДоговорКредитор.ВалютаДоговора);
			
			//Подсистема.УчетПриложенийДоговоров
			СтруктураПарамтеров.Вставить("ПриложениеКДоговору", ПриложениеКДоговоруКредитор);
			//Подсистема.УчетПриложенийДоговоров

			СформироватьСписаниеКурсовыхРазниц(СтруктураПарамтеров);
		КонецЕсли;
		
									
	КонецЕсли; 
	
	Если ВидОперации = ПредопределенноеЗначение("Перечисление.CW_ВидыОперацийКорректировкиОперативнойЗадолженности.ПереносЗадолженности") Тогда
		
		Если ДоговорКредитор.ВидДоговора <> ПредопределенноеЗначение("Перечисление.ВидыДоговоровКонтрагентов.СПоставщиком") и
			ДоговорКредитор.ВидДоговора <> ПредопределенноеЗначение("Перечисление.ВидыДоговоровКонтрагентов.СПокупателем") Тогда
			Возврат;	
		КонецЕсли;

		ФормироватьКурсовуюРазницу = ложь;
		
		СформироватьДвиженияПоПереносуЗадолженности(ВалютаРегламентированногоУчета); 
		
	КонецЕсли; 
	
		
КонецПроцедуры

Процедура ПроверитьСуммыЗачетаЗадолженности(Знач ВалютаРегламентированногоУчета, Отказ)
	
	ИмяПоляКЗ = "СуммаВал";
	Если ДоговорКредитор.ВалютаДоговора = ВалютаРегламентированногоУчета 
		или ДоговорКредитор.ВзаиморасчетыВУЕ Тогда
		ИмяПоляКЗ = "Сумма";
	КонецЕсли;  
	
	ИмяПоляДЗ = "СуммаВал";
	Если Договор.ВалютаДоговора = ВалютаРегламентированногоУчета 
		или Договор.ВзаиморасчетыВУЕ Тогда
		ИмяПоляДЗ = "Сумма";
	КонецЕсли;

	Если ДоговорКредитор.ВзаиморасчетыВУЕ и Договор.ВзаиморасчетыВУЕ Тогда
		ИмяПоляДЗ = "СуммаВал"; 
		ИмяПоляКЗ = "СуммаВал";
	КонецЕсли;
	
	Если КредиторскаяЗадолженность.Итог(ИмяПоляКЗ) <> ДебиторскаяЗадолженность.Итог(ИмяПоляДЗ) Тогда  
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Отличаются суммы дебиторской и кредиторской задолженности!",,,,Отказ);
	КонецЕсли;

КонецПроцедуры

Процедура СформироватьДвиженияПоЗачетуЗадолженности(ВалютаРегламентированногоУчета)
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ДебиторскаяЗадолженность.Ссылка.Контрагент КАК Контрагент,
	               |	ДебиторскаяЗадолженность.Ссылка.Договор КАК Договор,
	               |	ДебиторскаяЗадолженность.Ссылка.ПриложениеКДоговору КАК ПриложениеКДоговору,
	               |	ДебиторскаяЗадолженность.ВидЗадолженности КАК ВидЗадолженности,
	               |	ДебиторскаяЗадолженность.ДокументСчет КАК ДокументСчет,
	               |	ДебиторскаяЗадолженность.Валюта КАК Валюта,
	               |	ДебиторскаяЗадолженность.СчетЗадолженности КАК СчетЗадолженности,
	               |	ДебиторскаяЗадолженность.СуммаВал КАК СуммаВал,
	               |	ДебиторскаяЗадолженность.Сумма КАК Сумма,
	               |	ВЫБОР
	               |		КОГДА ДебиторскаяЗадолженность.ВидЗадолженности = ЗНАЧЕНИЕ(Перечисление.CW_ВидыОперативнойЗадолженности.Дебиторская)
	               |			ТОГДА ЛОЖЬ
	               |		ИНАЧЕ ИСТИНА
	               |	КОНЕЦ КАК ПриходРасход
	               |ПОМЕСТИТЬ ВТ_ДанныеДокумента
	               |ИЗ
	               |	Документ.CW_КорректировкаОперативнойЗадолженности.ДебиторскаяЗадолженность КАК ДебиторскаяЗадолженность
	               |ГДЕ
	               |	ДебиторскаяЗадолженность.Ссылка = &Ссылка
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	КредиторскаяЗадолженность.Ссылка.КонтрагентКредитор,
	               |	КредиторскаяЗадолженность.Ссылка.ДоговорКредитор,
	               |	КредиторскаяЗадолженность.Ссылка.ПриложениеКДоговоруКредитор,
	               |	КредиторскаяЗадолженность.ВидЗадолженности,
	               |	КредиторскаяЗадолженность.ДокументСчет,
	               |	КредиторскаяЗадолженность.Валюта,
	               |	КредиторскаяЗадолженность.СчетЗадолженности,
	               |	КредиторскаяЗадолженность.СуммаВал,
	               |	КредиторскаяЗадолженность.Сумма,
	               |	ВЫБОР
	               |		КОГДА КредиторскаяЗадолженность.ВидЗадолженности = ЗНАЧЕНИЕ(Перечисление.CW_ВидыОперативнойЗадолженности.Кредиторская)
	               |			ТОГДА ЛОЖЬ
	               |		ИНАЧЕ ИСТИНА
	               |	КОНЕЦ
	               |ИЗ
	               |	Документ.CW_КорректировкаОперативнойЗадолженности.КредиторскаяЗадолженность КАК КредиторскаяЗадолженность
	               |ГДЕ
	               |	КредиторскаяЗадолженность.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.Выполнить();
	
	//Дебиторская задолженность
	Запрос.Текст = "ВЫБРАТЬ
	               |	ВТ_ДанныеДокумента.Контрагент КАК Контрагент,
	               |	ВТ_ДанныеДокумента.Договор КАК Договор,
	               |	ВТ_ДанныеДокумента.ПриложениеКДоговору КАК ПриложениеКДоговору,
	               |	ВТ_ДанныеДокумента.ВидЗадолженности КАК ВидЗадолженности,
	               |	ВТ_ДанныеДокумента.ДокументСчет КАК ДокументСчет,
	               |	ВТ_ДанныеДокумента.Валюта КАК Валюта,
	               |	ВТ_ДанныеДокумента.СчетЗадолженности КАК СчетЗадолженности,
	               |	СУММА(ВТ_ДанныеДокумента.СуммаВал) КАК СуммаВал,
	               |	СУММА(ВТ_ДанныеДокумента.Сумма) КАК Сумма,
	               |	ВТ_ДанныеДокумента.ПриходРасход КАК ПриходРасход,
	               |	ВЫБОР
	               |		КОГДА ВТ_ДанныеДокумента.ДокументСчет ССЫЛКА Документ.CW_ДоходыПоГрузоперевозке
	               |			ТОГДА ИСТИНА
	               |		КОГДА ВТ_ДанныеДокумента.ДокументСчет ССЫЛКА Документ.CW_РасходыПоГрузоперевозке
	               |			ТОГДА ИСТИНА
	               |		ИНАЧЕ ЛОЖЬ
	               |	КОНЕЦ КАК ФормироватьОплатуИсходящих
	               |ИЗ
	               |	ВТ_ДанныеДокумента КАК ВТ_ДанныеДокумента
	               |ГДЕ
	               |	ВТ_ДанныеДокумента.ВидЗадолженности = ЗНАЧЕНИЕ(Перечисление.CW_ВидыОперативнойЗадолженности.Дебиторская)
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ВТ_ДанныеДокумента.Контрагент,
	               |	ВТ_ДанныеДокумента.Договор,
	               |	ВТ_ДанныеДокумента.ПриложениеКДоговору,
	               |	ВТ_ДанныеДокумента.Валюта,
	               |	ВТ_ДанныеДокумента.ВидЗадолженности,
	               |	ВТ_ДанныеДокумента.ДокументСчет,
	               |	ВТ_ДанныеДокумента.СчетЗадолженности,
	               |	ВТ_ДанныеДокумента.ПриходРасход";
	
