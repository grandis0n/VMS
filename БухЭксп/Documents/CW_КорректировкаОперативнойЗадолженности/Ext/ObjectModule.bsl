			Если Договор.ВидДоговора = ПредопределенноеЗначение("Перечисление.ВидыДоговоровКонтрагентов.СПоставщиком") Тогда
				ДвижениеОплата = Движения.CW_ОплатаВходящихДокументов.Добавить();
			КонецЕсли;
			Если Договор.ВидДоговора = ПредопределенноеЗначение("Перечисление.ВидыДоговоровКонтрагентов.СПокупателем") Тогда
				ДвижениеОплата = Движения.CW_ОплатаИсходящихДокументов.Добавить();
			КонецЕсли;   
			
			ДвижениеОплата.Период 				= Дата;
			ДвижениеОплата.Документ 			= СтрокаТаблицы.ДокументСчет;
			ДвижениеОплата.ДокументБУ 			= СтрокаТаблицы.ДокументАкт;
			ДвижениеОплата.ДокументОплаты 		= Ссылка;
			ДвижениеОплата.СчетЗадолженности 	= СтрокаТаблицы.СчетЗадолженности;
			ДвижениеОплата.Всего 				= СтрокаТаблицы.СуммаВал;
			ДвижениеОплата.ПризнакАкта 			= ЗначениеЗаполнено(СтрокаТаблицы.ДокументАкт);
			
		КонецЕсли;  
		//Регистры: CW_ОплатаВходящихДокументов и  CW_ОплатаИсходящихДокументов
		
	КонецЦикла; 
	
