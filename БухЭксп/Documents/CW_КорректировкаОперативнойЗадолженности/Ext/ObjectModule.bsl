Процедура СформироватьСписаниеКурсовыхРазниц(СтруктураПарамтеров)
	
	СтруктураПарамтеров.Вставить("Дата", 			Дата);
	СтруктураПарамтеров.Вставить("ДатаСреза", 		МоментВремени());    
	СтруктураПарамтеров.Вставить("Организация",		Организация);  
	
	СтруктураПарамтеров.Вставить("Набор",			Движения.CW_ОперативнаяДебиторскаяЗадолженность);
	СтруктураПарамтеров.Вставить("ИмяРегистраОперативнойЗадолженности",	"CW_ОперативнаяДебиторскаяЗадолженность" );
	CW_Финансы.СписаниеКурсовыеПоОперативнойЗадолженности(СтруктураПарамтеров);
	
	СтруктураПарамтеров.Вставить("ИмяРегистраОперативнойЗадолженности",	"CW_ОперативнаяКредиторскаяЗадолженность" );
	СтруктураПарамтеров.Вставить("Набор",			Движения.CW_ОперативнаяКредиторскаяЗадолженность);  
	
	Если ВидОперации = ПредопределенноеЗначение("Перечисление.CW_ВидыОперацийКорректировкиОперативнойЗадолженности.ЗачетЗадолженности") Тогда
		//Подсистема.УчетПриложенийДоговоров
		СтруктураПарамтеров.Вставить("ПриложениеКДоговору", ПриложениеКДоговоруКредитор);
		//Подсистема.УчетПриложенийДоговоров                                                                                                     
	КонецЕсли;
	
	CW_Финансы.СписаниеКурсовыеПоОперативнойЗадолженности(СтруктураПарамтеров);

КонецПроцедуры

Функция ПолучитьСоответствиеВидаЗадолженностиВидуДоговора()
	
	ВидыДоговоровКонтрагентов 		= Перечисления.ВидыДоговоровКонтрагентов;
	ВидыОперативнойЗадолженности 	= Перечисления.CW_ВидыОперативнойЗадолженности;
	
	Соответствие = Новый Соответствие;
	Соответствие.Вставить(ВидыДоговоровКонтрагентов.СПокупателем, ВидыОперативнойЗадолженности.Дебиторская);
	Соответствие.Вставить(ВидыДоговоровКонтрагентов.СПоставщиком, ВидыОперативнойЗадолженности.Кредиторская);
	
	Возврат Соответствие;
	
