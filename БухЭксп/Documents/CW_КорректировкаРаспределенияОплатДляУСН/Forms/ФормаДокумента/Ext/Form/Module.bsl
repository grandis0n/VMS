&НаСервере
Процедура _ЗаполнитьПоДаннымБУ()
	
	Счета = CW_Конфигурация.ПланСчетов();
	
	МассивСчетов = Новый Массив;
	МассивСчетов.Добавить(Счета.РасчетыПоАвансамПолученным);
	МассивСчетов.Добавить(Счета.РасчетыПоАвансамПолученнымВал);
	МассивСчетов.Добавить(Счета.РасчетыПоАвансамПолученнымУЕ);
	
	_сф.м_ДобавитьУникально(МассивСчетов,CW_Настройки.ПараметрУчетнойПолитики(Объект.Дата, Объект.Организация, "СчетРасчетов_Клиенты_Рубли"));
	_сф.м_ДобавитьУникально(МассивСчетов,CW_Настройки.ПараметрУчетнойПолитики(Объект.Дата, Объект.Организация, "СчетРасчетов_Клиенты_Валюта"));
	_сф.м_ДобавитьУникально(МассивСчетов,CW_Настройки.ПараметрУчетнойПолитики(Объект.Дата, Объект.Организация, "СчетРасчетов_Клиенты_УЕ"));

	Субконто = Новый Массив;
	Субконто.Добавить(ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.Контрагенты);
	Субконто.Добавить(ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.Договоры);
	Субконто.Добавить(ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.ДокументыРасчетовСКонтрагентами);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	CW_ДоговорыПоГрузоперевозкам.Ссылка КАК Ссылка,
	               |	CW_ДоговорыПоГрузоперевозкам.УчетныйДоговор КАК УчетныйДоговор
	               |ПОМЕСТИТЬ ВТ_ДоговорыПоГрузоперевозкам
	               |ИЗ
	               |	Справочник.CW_ДоговорыПоГрузоперевозкам КАК CW_ДоговорыПоГрузоперевозкам
	               |ГДЕ
	               |	CW_ДоговорыПоГрузоперевозкам.ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровКонтрагентов.СПокупателем)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	CW_ПриложенияКДоговорам.УчетныйДоговор КАК УчетныйДоговор
	               |ПОМЕСТИТЬ ВТ_УчетныеДоговораПриложений
	               |ИЗ
	               |	Справочник.CW_ПриложенияКДоговорам КАК CW_ПриложенияКДоговорам
	               |ГДЕ
	               |	CW_ПриложенияКДоговорам.Договор В
	               |			(ВЫБРАТЬ
	               |				ВТ_ДоговорыПоГрузоперевозкам.Ссылка КАК Ссылка
	               |			ИЗ
	               |				ВТ_ДоговорыПоГрузоперевозкам КАК ВТ_ДоговорыПоГрузоперевозкам)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ_ДоговорыПоГрузоперевозкам.УчетныйДоговор КАК УчетныйДоговор
	               |ПОМЕСТИТЬ ВТ_УчетныеДоговора
	               |ИЗ
	               |	ВТ_ДоговорыПоГрузоперевозкам КАК ВТ_ДоговорыПоГрузоперевозкам
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ВТ_УчетныеДоговораПриложений.УчетныйДоговор
	               |ИЗ
	               |	ВТ_УчетныеДоговораПриложений КАК ВТ_УчетныеДоговораПриложений
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ХозрасчетныйОстатки.Субконто1 КАК Контрагент,
	               |	ХозрасчетныйОстатки.Субконто2 КАК Договор,
	               |	ХозрасчетныйОстатки.Субконто3 КАК ДокументОплаты,
	               |	ХозрасчетныйОстатки.Субконто3.Дата КАК ДатаДокументаОплаты,
	               |	ХозрасчетныйОстатки.Счет КАК СчетАванса,
	               |	-ХозрасчетныйОстатки.СуммаОстаток КАК Сумма
	               |ИЗ
	               |	РегистрБухгалтерии.Хозрасчетный.Остатки(
	               |			&Период,
	               |			Счет В (&Счета),
	               |			&Субконто,
	               |			Организация = &Организация
	               |				И Субконто2 В
	               |					(ВЫБРАТЬ
	               |						ВТ_УчетныеДоговора.УчетныйДоговор КАК УчетныйДоговор
	               |					ИЗ
	               |						ВТ_УчетныеДоговора КАК ВТ_УчетныеДоговора)) КАК ХозрасчетныйОстатки
	               |ГДЕ
	               |	-ХозрасчетныйОстатки.СуммаОстаток > 0
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ДатаДокументаОплаты
	               |АВТОУПОРЯДОЧИВАНИЕ";
	
	Запрос.УстановитьПараметр("Период", 		Объект.Дата);
	Запрос.УстановитьПараметр("Организация", 	Объект.Организация);
	Запрос.УстановитьПараметр("Счета", 			МассивСчетов);
	Запрос.УстановитьПараметр("Субконто", 		Субконто);
	
	РезультатЗпроса = Запрос.Выполнить();
	Выборка = РезультатЗпроса.Выбрать();
	
	Объект.ТаблицаКорректировки.Очистить();

	
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = Объект.ТаблицаКорректировки.Добавить();
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		
		НоваяСтрока.СуммаДК 			= Выборка.Сумма;
		НоваяСтрока.СуммаРаспределения 	= Выборка.Сумма; 
		
	КонецЦикла;

	
КонецПроцедуры
 
