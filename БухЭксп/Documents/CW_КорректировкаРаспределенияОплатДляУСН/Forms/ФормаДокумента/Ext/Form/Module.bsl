&НаКлиенте
Процедура СуммаРаспределения(Элемент)
	// --- 
	
	ТД = Элементы.ТаблицаКорректировки.ТекущиеДанные;
	Если (ТД <> Неопределено) Тогда
		
		ТД.СуммаРаспределения = ТД.СуммаДУ + ТД.СуммаДК + ТД.СуммаДЕ;
		
	КонецЕсли; 
	
	// --- 
