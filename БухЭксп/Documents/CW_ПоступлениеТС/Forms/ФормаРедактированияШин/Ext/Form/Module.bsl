
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ТранспортноеСредство 	=  Параметры.ТранспортноеСредство;
	ТаблицаШин 				= ПолучитьИзВременногоХранилища(Параметры.Адрес);
	
	Если ТипЗнч(ТаблицаШин) = Тип("ТаблицаЗначений") тогда
		
		ШиныТранспортногоСредства.Загрузить(ТаблицаШин);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВДокумент(Команда)
	
	ПараметрыЗакрытия = ПолучитьПараметрыФормы();
	
	ЭтаФорма.Закрыть(ПараметрыЗакрытия);
	
КонецПроцедуры         


Функция ПолучитьПараметрыФормы()
	
	АдресШин = ПоместитьВоВременноеХранилище(ШиныТранспортногоСредства.Выгрузить());
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("Адрес"				, АдресШин);
	СтруктураПараметров.Вставить("ТранспортноеСредство"	, ТранспортноеСредство);
	
	Возврат СтруктураПараметров;
	
КонецФункции
