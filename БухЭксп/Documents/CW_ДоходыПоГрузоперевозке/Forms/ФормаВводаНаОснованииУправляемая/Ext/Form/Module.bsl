
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Не ЭтоАдресВременногоХранилища(Параметры.АдресТаблицыПеревыставления) Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	ДанныеТаблицыПеревыставления = ПолучитьИзВременногоХранилища(Параметры.АдресТаблицыПеревыставления);
	
	Если ДанныеТаблицыПеревыставления = Неопределено Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
		
	ТаблицаПеревыставления.Загрузить(ДанныеТаблицыПеревыставления);
	ДокументОснование 	= Параметры.ДокументОснование;
	ПорядокОтражения 	= Параметры.ПорядокОтражения;
	
	ОчереднаяДата = ДокументОснование.Дата;
	Если ОчереднаяДата <> КонецДня(ОчереднаяДата) Тогда 
		// по умолчанию ставим на следующую секунду после основания, но обязательно в те же сутки
		ОчереднаяДата = ОчереднаяДата + 1; 
	КонецЕсли;
	ДатаДокумента = ОчереднаяДата;
	
	УстановитьТекущуюДату 	= CW_Настройки.ПараметрУчетнойПолитики(ТекущаяДата(), ДокументОснование.Организация, "УстанавливатьТекущуюДатуИсходящегоДокумента");
	Если  УстановитьТекущуюДату Тогда
		ДатаДокумента = ТекущаяДата();
	Конецесли;
	
	СписокВыбора = Элементы.ДатаДокумента.СписокВыбора;
	СписокВыбора.Добавить(ТекущаяДата(),	"Текущая дата ("+Формат(ТекущаяДата(),"ДЛФ=DT")+")");
	СписокВыбора.Добавить(ОчереднаяДата,	"Вслед за Расходами ("+Формат(ОчереднаяДата,"ДЛФ=DT")+")");
	
	//Внешние подклчюаемые команды
	CW_ПодключаемыеКомандыСервер.ПриСозданииНаСервере(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаПеревыставленияВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Отказ = Ложь;
	Если НЕ ЗначениеЗаполнено(ДатаДокумента) Тогда 
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не задана дата документа!",,"ДатаДокумента",,Отказ);
	КонецЕсли;
	
	Если Не Отказ Тогда
		ОбработатьВыборСтроки(ВыбраннаяСтрока);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаПеревыставить(Команда)
	
	Отказ = Ложь;
	ТекущаяСтрока = Элементы.ТаблицаПеревыставления.ТекущаяСтрока;
	
	Если ТекущаяСтрока = Неопределено Тогда 
		ПоказатьПредупреждение(,"Не выбрана строка таблицы!");
		Возврат;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ДатаДокумента) Тогда 
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не задана дата документа!",,"ДатаДокумента",,Отказ);
	КонецЕсли;
	
	Если Не Отказ Тогда
		ОбработатьВыборСтроки(ТекущаяСтрока);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьВыборСтроки(ВыбраннаяСтрока)

	АдресДанных = ОбработатьВыборДанныхДокумента(ВыбраннаяСтрока);
	ЭтаФорма.Закрыть(АдресДанных);
	
КонецПроцедуры

&НаСервере
Функция ОбработатьВыборДанныхДокумента(ВыбраннаяСтрока)
	
	СтрокаДанных = ТаблицаПеревыставления.НайтиПоИдентификатору(ВыбраннаяСтрока);
	
	СоответствиеПорядкаОтражения = ПолучитьСоответствиеПорядкаОтражения();
	
	СтруктураДанных = Новый Структура;
	СтруктураДанных.Вставить("ДатаДокумента", 		ДатаДокумента);
	СтруктураДанных.Вставить("Организация", 		ДокументОснование.Организация);
	СтруктураДанных.Вставить("Контрагент", 			СтрокаДанных.Контрагент);
	СтруктураДанных.Вставить("Договор", 			СтрокаДанных.Договор);
	СтруктураДанных.Вставить("ПриложениеКДоговору", 	СтрокаДанных.ПриложениеКДоговору);
	СтруктураДанных.Вставить("ПорядокОтраженияДоходов",	СоответствиеПорядкаОтражения.Получить(ПорядокОтражения));
	СтруктураДанных.Вставить("ПорядокОтраженияЗатрат", 	ПорядокОтражения);
	СтруктураДанных.Вставить("ДокументОснование", 	ДокументОснование);
	СтруктураДанных.Вставить("ПервичныеДокументы", 	ПервичныеДокументы);
	
	Возврат ПоместитьВоВременноеХранилище(СтруктураДанных, Новый УникальныйИдентификатор);
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьСоответствиеПорядкаОтражения()
	
	Результат = Новый Соответствие;
	Результат.Вставить(ПредопределенноеЗначение("Перечисление.CW_ПорядокОтраженияЗатрат.Затраты"),					ПредопределенноеЗначение("Перечисление.CW_ПорядокОтраженияДоходов.СобственнаяУслуга"));
	Результат.Вставить(ПредопределенноеЗначение("Перечисление.CW_ПорядокОтраженияЗатрат.Перевыставление"),			ПредопределенноеЗначение("Перечисление.CW_ПорядокОтраженияДоходов.Перевыставление"));
	Результат.Вставить(ПредопределенноеЗначение("Перечисление.CW_ПорядокОтраженияЗатрат.ПеревыставлениеПоСтавкам"),	ПредопределенноеЗначение("Перечисление.CW_ПорядокОтраженияДоходов.ПеревыставлениеПоСтавкам"));
	Результат.Вставить(ПредопределенноеЗначение("Перечисление.CW_ПорядокОтраженияЗатрат.ПустаяСсылка"),				ПредопределенноеЗначение("Перечисление.CW_ПорядокОтраженияДоходов.ПустаяСсылка"));
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ДатаДокументаОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	ДатаДокумента = ВыбранноеЗначение;
	
КонецПроцедуры
 
#Область Подключаемые_внешние_команды

&НаКлиенте
Процедура ВнешняяКоманда_ВыполнитьКоманду(Команда)
	
	CW_ПодключаемыеКомандыКлиент.ВыполнитьВнешнююКоманду(ЭтотОбъект, Команда.Имя, Элементы.ТаблицаПеревыставления.ВыделенныеСтроки);
	
КонецПроцедуры

#КонецОбласти