
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЕстьОграниченияПоСпискуУслуг 		 	= Параметры.ЕстьОграниченияПоСпискуУслуг;
	УстанавливатьЦенуВЗависимостиОтГруза 	= Параметры.УстанавливатьЦенуВЗависимостиОтГруза;
	Договор 								= Параметры.Договор;
	
	//Подсистема.УчетПриложенийДоговоров	
	ПриложениеКДоговору 					= Параметры.ПриложениеКДоговору;
	//Подсистема.УчетПриложенийДоговоров	
	
	АдресУслугПоДоговору 					= Параметры.АдресУслугПоДоговору;
	ДатаДокумента							= Параметры.ДатаДокумента;
	Валюта									= Параметры.Валюта;
	
	Если Параметры.ДополнительныеСвойства = Неопределено Тогда
		ДополнительныеСвойства = Новый Структура;
	Иначе
		ДополнительныеСвойства = Параметры.ДополнительныеСвойства;
	КонецЕсли;
	
	ОсновнойПорядокОтраженияДоходов = CW_Настройки.ПолучитьНастройкуПользователя(ПараметрыСеанса.ТекущийПользователь,"ОсновнойПорядокОтраженияДоходов");
	
	Если Не ЗначениеЗаполнено(ОсновнойПорядокОтраженияДоходов) Тогда
		
		СтруктураПараметров = CW_Настройки.ПустаяСтруктураПолученияПараметровДоговора();
		СтруктураПараметров.Дата 				= ТекущаяДата();
		СтруктураПараметров.Договор 			= Договор;
		СтруктураПараметров.ПриложениеКДоговору = ПриложениеКДоговору;
		
		ПараметрыДоговора	= CW_Настройки.ПолучитьПараметрыДоговора(СтруктураПараметров, "ОсновнойПорядокОтраженияДоходов");
	
		ОсновнойПорядокОтраженияДоходов = ПараметрыДоговора.ОсновнойПорядокОтраженияДоходов;
	КонецЕсли;
	
	ОсновнаяСтатьяЗатрат = CW_Настройки.ПараметрУчетнойПолитики(ТекущаяДата(),Параметры.Организация,"ОсновнаяСтатьяЗатрат");
	
	СтруктураДанных = новый Структура;
	СтруктураДанных.Вставить("АдресУслугПоДоговору"			, АдресУслугПоДоговору);
	СтруктураДанных.Вставить("ЭлементФормы"					, Элементы.СтрокаДокументаНоменклатура);
	СтруктураДанных.Вставить("ЕстьОграниченияПоСпискуУслуг"	, ЕстьОграниченияПоСпискуУслуг);
	
	_УФС.УстановитьСписокУслуг(СтруктураДанных);
	
	НоваяСтрока 					= СтрокаДокумента.Добавить();
	НоваяСтрока.ПорядокОтражения 	= ОсновнойПорядокОтраженияДоходов;
	НоваяСтрока.Количество 			= 1;
	
	//Внешние подклчюаемые команды
	CW_ПодключаемыеКомандыСервер.ПриСозданииНаСервере(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура СтрокаДокументаНоменклатураПриИзменении(Элемент)
	
	НоменклатураПриИзмененииНаСервере(Элементы.СтрокаДокумента.ТекущаяСтрока);
	
КонецПроцедуры

&НаСервере
Процедура НоменклатураПриИзмененииНаСервере(ТекущаяСтрока)
	
	СтрокаТекущая = СтрокаДокумента.НайтиПоИдентификатору(ТекущаяСтрока);
	
	Если ЗначениеЗаполнено(СтрокаТекущая.Номенклатура) Тогда 
		
		СтрокаТекущая.Единица 		= СтрокаТекущая.Номенклатура.ЕдиницаИзмерения;
		СтрокаТекущая.Представление = СтрокаТекущая.Номенклатура.НаименованиеПолное;
			
		// пробуем найти в регистре
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	CW_СтатьиЗатратНоменклатуры.СтатьяЗатрат КАК СтатьяЗатрат
		               |ИЗ
		               |	РегистрСведений.CW_СтатьиЗатратНоменклатуры КАК CW_СтатьиЗатратНоменклатуры
		               |ГДЕ
		               |	CW_СтатьиЗатратНоменклатуры.Номенклатура = &Номенклатура";
		
		Запрос.УстановитьПараметр("Номенклатура", СтрокаТекущая.Номенклатура);
		
		РезультатЗапроса  = Запрос.Выполнить();
		
		Если РезультатЗапроса.Пустой() Тогда
			СтрокаТекущая.СтатьяЗатрат = ОсновнаяСтатьяЗатрат;
		Иначе
			Выборка = РезультатЗапроса.Выбрать();
			Если Выборка.Следующий() Тогда
				СтрокаТекущая.СтатьяЗатрат = Выборка.СтатьяЗатрат;
			КонецЕсли;
		КонецЕсли;
			
	КонецЕсли;
	
	// пробуем переформировать представление номенклатуры
		
	Если СтрокаТекущая.Количество = 0 Тогда
		СтрокаТекущая.Количество = 1;
	КонецЕсли; 
	
		// установка цены номенклатуры
	Если ЕстьОграниченияПоСпискуУслуг  Тогда
		
		Если ЭтоАдресВременногоХранилища(АдресУслугПоДоговору) Тогда
			
			СтруктураПараметров = Новый Структура;
			СтруктураПараметров.Вставить("АдресУслугПоДоговору"						, АдресУслугПоДоговору);
			СтруктураПараметров.Вставить("УстанавливатьЦенуВЗависимостиОтГруза"		, УстанавливатьЦенуВЗависимостиОтГруза);
			СтруктураПараметров.Вставить("УстанавливатьЦенуВЗависимостиОтКлиента"	, Ложь);
			
			СтруктураПараметров.Вставить("Номенклатура"							, СтрокаТекущая.Номенклатура);
			Если УстанавливатьЦенуВЗависимостиОтГруза Тогда
				СтруктураПараметров.Вставить("Груз" , СтрокаТекущая.Груз);
			КонецЕсли;
			
			УслугаДоговора = _УФС.ПолучитьУслугуДоговораПоПараметрам(СтруктураПараметров);	
			
			Если УслугаДоговора <> Неопределено Тогда 	
				
				Если ЗначениеЗаполнено(УслугаДоговора.ПорядокОтражения) Тогда
					СтрокаТекущая.ПорядокОтражения = УслугаДоговора.ПорядокОтражения;
				КонецЕсли;
				
				СтрокаТекущая.Цена			= УслугаДоговора.ЦенаБезНДС;
				СтрокаТекущая.СтавкаНДС		= УслугаДоговора.СтавкаНДС;
				
				Если УслугаДоговора.ВариантРасчетаНДС = Перечисления.ВариантыРасчетаНДС.НДССверху тогда
					СтрокаТекущая.Сумма 		= УслугаДоговора.ЦенаБезНДС * СтрокаТекущая.Количество;
					ОбратныйПересчет = Ложь;
				Иначе //в сумме
					СтрокаТекущая.Всего = УслугаДоговора.Цена * СтрокаТекущая.Количество;
					ОбратныйПересчет = Истина;
				КонецЕсли;
				
				Ставка = CW_Финансы.ПолучитьСтавкуНДС(УслугаДоговора.СтавкаНДС);
				
				Если ОбратныйПересчет Тогда
					
					СтрокаТекущая.НДС 		= СтрокаТекущая.Всего*(Ставка/(100+Ставка));
					СтрокаТекущая.Сумма 	= СтрокаТекущая.Всего - СтрокаТекущая.НДС;
					СтрокаТекущая.Цена 		= _сф.БезопасноРазделить(СтрокаТекущая.Сумма,СтрокаТекущая.Количество);
					
				Иначе
					
					СтрокаТекущая.Цена 		= _сф.БезопасноРазделить(СтрокаТекущая.Сумма,СтрокаТекущая.Количество);
					СтрокаТекущая.НДС 		= СтрокаТекущая.Сумма*(Ставка/100);
					СтрокаТекущая.Всего 	= СтрокаТекущая.Сумма+СтрокаТекущая.НДС;
					
				КонецЕсли; 
				
			КонецЕсли; 
			
		КонецЕсли;
	Иначе
		Если СтрокаТекущая.Цена = 0  Тогда
			
			Если ДополнительныеСвойства.Свойство("ПД") Тогда
				ТипЦен = ДополнительныеСвойства.ПД.ТипЦен;
			Иначе
				ТипЦен = Справочники.ТипыЦенНоменклатуры.ПустаяСсылка();
			КонецЕсли;
			
			Если НЕ ТипЦен.Пустая() Тогда
				
				СтруктураКурса = CW_Финансы.ПолучитьКурсВалюты(Валюта,ДатаДокумента);
				Цена = Ценообразование.ПолучитьЦенуНоменклатуры(СтрокаТекущая.Номенклатура, ТипЦен, ДатаДокумента, Валюта, СтруктураКурса.Курс,СтруктураКурса.Кратность);
				Если Цена <> 0 Тогда
					
					Если ТипЦен.ЦенаВключаетНДС Тогда
						
						Если ЗначениеЗаполнено(СтрокаТекущая.СтавкаНДС) И ЗначениеЗаполнено(СтрокаТекущая.Количество) Тогда
							
							СтрокаТекущая.Всего = Цена*СтрокаТекущая.Количество;
							Ставка = CW_Финансы.ПолучитьСтавкуНДС(СтрокаТекущая.СтавкаНДС)/100;
							СтрокаТекущая.НДС = СтрокаТекущая.Всего*Ставка/(1+Ставка);
							СтрокаТекущая.Сумма = СтрокаТекущая.Всего - СтрокаТекущая.НДС;
							СтрокаТекущая.Цена = _сф.БезопасноРазделить(СтрокаТекущая.Сумма,СтрокаТекущая.Количество);
							
						Иначе
							
							Если ЗначениеЗаполнено(СтрокаТекущая.СтавкаНДС) Тогда
								
								СтавкаНДСПроцент = CW_Финансы.ПолучитьСтавкуНДС(СтрокаТекущая.СтавкаНДС)/100;
								СтрокаТекущая.Цена = Цена/(1+СтавкаНДСПроцент);
								
							КонецЕсли; 
							
						КонецЕсли; 
						
					Иначе
						
						Если ЗначениеЗаполнено(СтрокаТекущая.СтавкаНДС) И ЗначениеЗаполнено(СтрокаТекущая.Количество) Тогда
							
							СтрокаТекущая.Цена 	= Цена;
							СтрокаТекущая.Сумма = СтрокаТекущая.Цена * СтрокаТекущая.Количество;
							СтрокаТекущая.НДС 	= СтрокаТекущая.Сумма * CW_Финансы.ПолучитьСтавкуНДС(СтрокаТекущая.СтавкаНДС)/100;
							СтрокаТекущая.Всего = СтрокаТекущая.Сумма + СтрокаТекущая.НДС;
							
						Иначе
							
							СтрокаТекущая.Цена = Цена;
							
						КонецЕсли; 
						
					КонецЕсли; 
					
				КонецЕсли; 
				
			КонецЕсли; 
			
		КонецЕсли; 
		
	КонецЕсли; 
	
	Если Не ЗначениеЗаполнено(СтрокаТекущая.СтавкаНДС) Тогда
		Если ДополнительныеСвойства.Свойство("НП") Тогда
			Если ДополнительныеСвойства.НП.ПодставлятьСтавкуНДС Тогда
				СтрокаТекущая.СтавкаНДС =  CW_БухгалтерияЭкспедитораСерверПереопределяемый.СтавкаНДС(СтрокаТекущая.Номенклатура);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	// --- 
КонецПроцедуры

&НаКлиенте
Процедура СтрокаДокументаНоменклатураНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	Если ЕстьОграниченияПоСпискуУслуг и Элемент.СписокВыбора.Количество() = 0 Тогда
		
		Сообщение = новый СообщениеПользователю;
		Сообщение.Текст   		= "Не определен список услуг по договору!";
		Сообщение.Сообщить();
		
	Конецесли;
	
КонецПроцедуры

&НаКлиенте
Процедура СтрокаДокументаПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	Если СтрокаДокумента.Количество()= 1 тогда
		Отказ = истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СтрокаДокументаНоменклатураАвтоПодбор(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, Ожидание, СтандартнаяОбработка)
	
	Если ЕстьОграниченияПоСпискуУслуг  Тогда
		//СтандартнаяОбработка	= Ложь;
		ДанныеВыбора			= Новый СписокЗначений;
		
		Если ЭтоАдресВременногоХранилища(АдресУслугПоДоговору) Тогда
			ДанныеВыбора.ЗагрузитьЗначения(_УФС.ПолучитьУслугиДоговора(АдресУслугПоДоговору));
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьСуммыСтроки(СтрокаТекущая)
	
	СтрокаТекущая.Сумма = СтрокаТекущая.Цена * СтрокаТекущая.Количество;
	СтрокаТекущая.НДС = СтрокаТекущая.Сумма * СтавкаНДС(СтрокаТекущая.СтавкаНДС)/100;
	СтрокаТекущая.Всего = СтрокаТекущая.Сумма + СтрокаТекущая.НДС;
	
КонецПроцедуры

&НаКлиенте
Функция СтавкаНДС(Ставка)
	
	Возврат CW_Финансы.ПолучитьСтавкуНДС(Ставка);
	
КонецФункции

&НаКлиенте
Процедура СтрокаДокументаКоличествоПриИзменении(Элемент)
	ПересчитатьСуммыСтроки(Элементы.СтрокаДокумента.ТекущиеДанные);
КонецПроцедуры

&НаКлиенте
Процедура СтрокаДокументаЦенаПриИзменении(Элемент)
	ПересчитатьСуммыСтроки(Элементы.СтрокаДокумента.ТекущиеДанные);
КонецПроцедуры

&НаКлиенте
Процедура СтрокаДокументаСтавкаНДСПриИзменении(Элемент)
	ПересчитатьСуммыСтроки(Элементы.СтрокаДокумента.ТекущиеДанные);
КонецПроцедуры

&НаКлиенте
Процедура СтрокаДокументаСуммаПриИзменении(Элемент)
	
	СуммаПриИзменении(Элементы.СтрокаДокумента.ТекущаяСтрока);
	
КонецПроцедуры

&НаСервере
Процедура СуммаПриИзменении(ТекущаяСтрока)
	// --- 
	
	СтрокаТекущая 		= СтрокаДокумента.НайтиПоИдентификатору(ТекущаяСтрока);
	
	СтрокаТекущая.Цена 	= _сф.БезопасноРазделить(СтрокаТекущая.Сумма,СтрокаТекущая.Количество);
	Ставка 				= CW_Финансы.ПолучитьСтавкуНДС(СтрокаТекущая.СтавкаНДС);
	СтрокаТекущая.НДС 	= CW_Финансы.РассчитатьСуммуНДС(СтрокаТекущая.Сумма, Истина, Ложь, Ставка);
	СтрокаТекущая.Всего = СтрокаТекущая.Сумма + СтрокаТекущая.НДС;
	
	// --- 
КонецПроцедуры

&НаКлиенте
Процедура СтрокаДокументаНДСПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.СтрокаДокумента.ТекущиеДанные;
	
	Если ДополнительныеСвойства.Свойство("НП") Тогда
		Если НЕ ДополнительныеСвойства.НП.ОбратныйПересчетВДокументах Тогда
			ТекущиеДанные.Всего = ТекущиеДанные.Сумма + ТекущиеДанные.НДС;
		Иначе
			ТекущиеДанные.Сумма = ТекущиеДанные.Всего - ТекущиеДанные.НДС;
			ТекущиеДанные.Цена 	= _сф.БезопасноРазделить(ТекущиеДанные.Сумма,ТекущиеДанные.Количество);
		КонецЕсли;
	Иначе
		ТекущиеДанные.Всего = ТекущиеДанные.Сумма + ТекущиеДанные.НДС;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура СтрокаДокументаВсегоПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.СтрокаДокумента.ТекущиеДанные;
		
	Ставка 				= СтавкаНДС(ТекущиеДанные.СтавкаНДС)/100;
	ТекущиеДанные.НДС 	= ТекущиеДанные.Всего*Ставка/(1+Ставка);
	ТекущиеДанные.Сумма = ТекущиеДанные.Всего - ТекущиеДанные.НДС;
	ТекущиеДанные.Цена 	= _сф.БезопасноРазделить(ТекущиеДанные.Сумма,ТекущиеДанные.Количество);

КонецПроцедуры

&НаКлиенте
Процедура СтрокаДокументаПередУдалением(Элемент, Отказ)
	Отказ = истина;
КонецПроцедуры

&НаСервере
Функция ДобавитьДанныеОтвета()
	
	Возврат ПоместитьВоВременноеХранилище(СтрокаДокумента.Выгрузить());
	
КонецФункции

&НаКлиенте
Процедура КомандаДобавитьСтроку(Команда)
	
	Адрес = ДобавитьДанныеОтвета();
	ЭтаФорма.Закрыть(Новый Структура("Адрес",Адрес));
	
КонецПроцедуры


 #Область Подключаемые_внешние_команды

&НаКлиенте
Процедура ВнешняяКоманда_ВыполнитьКоманду(Команда)
	
	CW_ПодключаемыеКомандыКлиент.ВыполнитьВнешнююКоманду(ЭтотОбъект, Команда.Имя);
	
КонецПроцедуры

#КонецОбласти
