&НаКлиенте 
Процедура ПослеПолученияСтатейБюджета(РезультатВыполнения, Дополнительныепараметры) Экспорт
	
	Если РезультатВыполнения.Статус = "Выполнено" Тогда    
		
		ПослеПолученияСтатейБюджетаНаСервере(РезультатВыполнения.АдресРезультата);
		
	ИначеЕсли РезультатВыполнения.Статус = "Ошибка" Тогда
		
		ТекстПредупреждения = "Информация об ошибке см. в журнале регистрации!";
		
		Если ТипЗнч(РезультатВыполнения.Сообщения) = Тип("Массив") Тогда
			Для Каждого СообщениеВМассиве из РезультатВыполнения.Сообщения Цикл
				СообщениеВМассиве.Сообщить();
			КонецЦикла;
		КонецЕсли;
		
		ПоказатьПредупреждение(,ТекстПредупреждения,,"Ошибка при подборе статей бюджета");  
		
	КонецЕсли;  
	
КонецПроцедуры  

&НаСервере
Процедура ПослеПолученияСтатейБюджетаНаСервере(АдресРезультата) 
	
	ТаблцицаСтатейБюджета = ПолучитьИзВременногоХранилища(АдресРезультата);
	Если ТипЗнч(ТаблцицаСтатейБюджета) <> Тип("ТаблицаЗначений") Тогда
		Возврат;
	КонецЕсли;
	
	тИдентификаторы = ТаблцицаСтатейБюджета.Скопировать(); 
	тИдентификаторы.Свернуть("ИдентификаторСтроки",);
	мИдентификаторы = тИдентификаторы.ВыгрузитьКолонку("ИдентификаторСтроки");
	
	//переносим в документ
	Для Каждого ИдентификаторСтроки из мИдентификаторы Цикл
		Отбор = Новый Структура;
		Отбор.Вставить("ИдентификаторСтроки", ИдентификаторСтроки);
		
		НайденныеСтроки = ТаблцицаСтатейБюджета.НайтиСтроки(Отбор);
		Если НайденныеСтроки.Количество() = 1 Тогда
			СтрокаУслуги = Объект.Услуги.НайтиПоИдентификатору(ИдентификаторСтроки);
			СтрокаУслуги.СтатьяБюджета = НайденныеСтроки[0].СтатьяБюджета;
		Конецесли;
	КонецЦикла;
	
КонецПроцедуры


&НаКлиенте
Процедура БюджетЗаполнитьСтатьиСОтбором(Команда)
	
	ПараметрыПодбора = ПолучитьПараметрыПодбораСтатейБюджета(Элементы.Услуги.ВыделенныеСтроки); 
	Если ПараметрыПодбора = Неопределено Тогда
		ПоказатьПредупреждение(,"Для выделенных строк уже указаны статьи бюджета!"); 
		Возврат;
	КонецЕсли; 
	
	CW_ЗаполнениеДокументовКлиент.ПередНачаломЗаполненияДокумента(ПараметрыПодбора);
	
КонецПроцедуры   

&НаКлиенте
Функция ПолучитьПараметрыПодбораСтатейБюджета(Знач ВыделенныеСтроки)
	
	СписокГрузоперевозок = Новый СписокЗначений;
	
	Для Каждого ИдентификаторСтроки из ВыделенныеСтроки Цикл
		СтрокаТаблицы = Объект.Услуги.НайтиПоИдентификатору(ИдентификаторСтроки);   
		Если Не ЗначениеЗаполнено(СтрокаТаблицы.Грузоперевозка) Тогда
			Продолжить;
		КонецЕсли;
		
		Если СписокГрузоперевозок.НайтиПоЗначению(СтрокаТаблицы.Грузоперевозка) = Неопределено Тогда
			СписокГрузоперевозок.Добавить(СтрокаТаблицы.Грузоперевозка);
		КонецЕсли;
	КонецЦикла;  
	
	Если СписокГрузоперевозок.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ИмяТабличнойЧасти = "Услуги";
	
	ДополлнительныеПараметры = Новый Структура;
	ДополлнительныеПараметры.Вставить("ИмяТабличнойЧасти", 	ИмяТабличнойЧасти);
	ДополлнительныеПараметры.Вставить("ВыделенныеСтроки",	ВыделенныеСтроки);
	
  	Оповещение 	= Новый ОписаниеОповещения("ЗаполнитьПодобранныеСтатьиБюджета", ЭтотОбъект, ДополлнительныеПараметры);
	
	ПараметрыЗаполнения = CW_ЗаполнениеДокументовКлиент.НоваяСтруктураПараметровЗаполнения(); 
	
	ПараметрыЗаполнения.Отбор.Вставить("Организация", 	Объект.Организация);
	ПараметрыЗаполнения.Отбор.Вставить("ВидСтатьи", 	ПредопределенноеЗначение("Перечисление.CW_ВидыСтатейПланирования.Доходы"));
	ПараметрыЗаполнения.Отбор.Вставить("Владелец", 		СписокГрузоперевозок);

	ПараметрыЗаполнения.ПустаяСсылка 			= ПредопределенноеЗначение("Справочник.CW_ПлановыеСтатьиЗатратИДоходов.ПустаяСсылка");
	ПараметрыЗаполнения.Форма 					= ЭтаФорма;
	ПараметрыЗаполнения.ИмяТабличнойЧасти 		= ИмяТабличнойЧасти;
	ПараметрыЗаполнения.ИмяМакета 				= "СхемаПодбораСтатейБюджета";
	ПараметрыЗаполнения.Оповещение 				= Оповещение; 
	ПараметрыЗаполнения.ОчищатьТабличнуюЧасть	= ложь; 
	
	Возврат ПараметрыЗаполнения;  
	
КонецФункции     

&НаКлиенте
Процедура ЗаполнитьПодобранныеСтатьиБюджета(Результат, ДополлнительныеПараметры) Экспорт
	
	Если Результат = Неопределено 
		или Не ЭтоАдресВременногоХранилища(Результат) Тогда
		Модифицированность = Ложь;
		Возврат;
	КонецЕсли;
	
	РезультатЗаполнения = ЗаполнитьПодобранныеСтатьиБюджетаНаСервере(Результат, ДополлнительныеПараметры);
	
	Если Не ПустаяСтрока(РезультатЗаполнения) Тогда
		ПоказатьПредупреждение(, РезультатЗаполнения);
	КонецЕсли;
	
КонецПроцедуры 

&НаСервере
Функция ЗаполнитьПодобранныеСтатьиБюджетаНаСервере(АдресТаблицы, ДополлнительныеПараметры)  
	
	ТаблицаСтатейБюджета = ПолучитьИзВременногоХранилища(АдресТаблицы);
	Если ТипЗнч(ТаблицаСтатейБюджета) = Тип("ТаблицаЗначений") Тогда 
		Если ТаблицаСтатейБюджета.Количество() = 0 Тогда
			Возврат "Не удалось получить статьи бюджета!";
		КонецЕсли;  
		
		Для Каждого ИдентификаторСтроки из ДополлнительныеПараметры.ВыделенныеСтроки Цикл
			СтрокаТаблицы = Объект.Услуги.НайтиПоИдентификатору(ИдентификаторСтроки); 
			
			Отбор = Новый Структура;
			Отбор.Вставить("Владелец", СтрокаТаблицы.Грузоперевозка);
			
			НайденныеСтроки = ТаблицаСтатейБюджета.НайтиСтроки(Отбор);   
			Если НайденныеСтроки.Количество() = 1 Тогда
				СтрокаТаблицы.СтатьяБюджета = НайденныеСтроки[0].СтатьяБюджета;	
			КонецЕсли;
			
		КонецЦикла;
		
		Модифицированность = Истина;
		
	Иначе
		Возврат "Не удалось получить данные для заполнения статей бюджета!";
	КонецЕсли; 
	
	Возврат "";
	
КонецФункции 



&НаКлиенте
Процедура БюджетСоздатьСтатьи(Команда)  
	
	ПараметрыСтатейБюджета = ПолучитьПараметрыСозданияСтатейБюджета(Элементы.Услуги.ВыделенныеСтроки); 
	Если ПараметрыСтатейБюджета = Неопределено Тогда
		ПоказатьПредупреждение(,"Для выделенных строк уже указаны статьи бюджета!");
		Возврат;
	КонецЕсли;

	Режим = РежимДиалогаВопрос.ДаНет;
	Оповещение = Новый ОписаниеОповещения("ПродолжитьСозданиеСтатейБюджета", ЭтотОбъект, ПараметрыСтатейБюджета);
	ПоказатьВопрос(Оповещение, "Для выделенных строк с незаполненной статьей бюджета будут созданы новые статьи. Продолжить?", Режим, 0);
	
КонецПроцедуры  

&НаСервере
Функция ПолучитьПараметрыСозданияСтатейБюджета(Знач ВыделенныеСтроки)
	
	ДанныеОбъекта = Новый Структура("Дата,ДатаКурса,Организация,Контрагент,Договор,ПриложениеКДоговору,Валюта,УЕ_ПользовательскийКурс,УЕ_Кратность,УЕ_Курс");
	
	ЗаполнитьЗначенияСвойств(ДанныеОбъекта, Объект); 
	
	Если Объект.ФормируетсяАкт Тогда
		ДанныеОбъекта.ДатаКурса = Объект.ДатаАкта;  
	ИначеЕсли Объект.ФормируетсяСчет Тогда
		ДанныеОбъекта.ДатаКурса = Объект.ДатаСчета;
	Иначе
		ДанныеОбъекта.ДатаКурса = Объект.Дата;
	КонецЕсли;   
	
	ДанныеСтрок = Новый Массив;
	
	Для Каждого ИдентификаторСтроки из ВыделенныеСтроки Цикл
		СтрокаТаблицы = Объект.Услуги.НайтиПоИдентификатору(ИдентификаторСтроки); 
		Если ЗначениеЗаполнено(СтрокаТаблицы.СтатьяБюджета) Тогда
			Продолжить;
		КонецЕсли;
		
		ДанныеСтроки = Новый Структура("ИдентификаторСтроки,Грузоперевозка,Номенклатура,ПорядокОтражения,Количество,Цена,Сумма,СтавкаНДС,НДС,Всего", ИдентификаторСтроки);
		
		ЗаполнитьЗначенияСвойств(ДанныеСтроки, СтрокаТаблицы); 
		
		ДанныеСтрок.Добавить(ДанныеСтроки);
	КонецЦикла; 

	Если ДанныеСтрок.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ПараметрыСтатейБюджета = Новый Структура;
	ПараметрыСтатейБюджета.Вставить("ДанныеОбъекта",		 ДанныеОбъекта);
	ПараметрыСтатейБюджета.Вставить("ДанныеСтрок", 			 ДанныеСтрок);
	ПараметрыСтатейБюджета.Вставить("ВидСтатьиПланирования", ПредопределенноеЗначение("Перечисление.CW_ВидыСтатейПланирования.Доходы"));
	
	Возврат ПараметрыСтатейБюджета;
	
КонецФункции

&НаКлиенте
Процедура ПродолжитьСозданиеСтатейБюджета(Результат, ПараметрыСтатейБюджета) Экспорт
	Если Результат = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли; 
	
	ПослеВыбораВерсииБюджета = Новый ОписаниеОповещения("ПослеВыбораВерсииБюджета", ЭтотОбъект, ПараметрыСтатейБюджета);
	
	ОткрытьФорму("Справочник.CW_ВерсииБюджетов.ФормаВыбора",,ЭтаФорма,,,,ПослеВыбораВерсииБюджета, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры   

&НаКлиенте
Процедура ПослеВыбораВерсииБюджета(ВерсияБюджета, ПараметрыСтатейБюджета) Экспорт
	
	Если ВерсияБюджета = Неопределено Тогда
		Возврат;
	КонецЕсли;    

	ВыделенныеСтроки = Элементы.Услуги.ВыделенныеСтроки; 
	
	ВладельцыБюжета = ПолучитьМассвВладельцевБюджета(ВыделенныеСтроки);
	Если CW_Бюджетирование.БюджетУтвержден(ВерсияБюджета, ВладельцыБюжета) Тогда
		ПоказатьПредупреждение(,"По заказу (грузоперевозке) заблокирован бюджет! Формирование статей невозможно!");
		Возврат;
	КонецЕсли;
	
	ПараметрыСтатейБюджета.Вставить("ВерсияБюджета", ВерсияБюджета);
	
	ДопоплнительныеПараметры = Новый Структура;
	ДопоплнительныеПараметры.Вставить("ВыделенныеСтроки", ВыделенныеСтроки);
	
	Оповещение = Новый ОписаниеОповещения("ПослеСозданияСтатейБюджета", ЭтотОбъект, ДопоплнительныеПараметры);
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("Форма", 					ЭтотОбъект); 
	СтруктураПараметров.Вставить("Оповещение", 				Оповещение); 
	СтруктураПараметров.Вставить("ПараметрыСтатейБюджета", 	ПараметрыСтатейБюджета); 

	CW_БюджетированиеКлиент.СоздатьСтатьиБюжета(СтруктураПараметров);
	
КонецПроцедуры  

&НаСервере
Функция ПолучитьМассвВладельцевБюджета(ВыделенныеСтроки) 
	
	ВладельцыБюжета = Новый Массив;
	Для Каждого ИдентификаторСтроки из ВыделенныеСтроки Цикл  
		СтрокаТаблицы = Объект.Услуги.НайтиПоИдентификатору(ИдентификаторСтроки);
		Если ВладельцыБюжета.Найти(СтрокаТаблицы.Грузоперевозка) = Неопределено Тогда
			ВладельцыБюжета.Добавить(СтрокаТаблицы.Грузоперевозка);
		КонецЕсли; 
		Если ЗначениеЗаполнено(СтрокаТаблицы.Грузоперевозка.Заказ) 
			и ВладельцыБюжета.Найти(СтрокаТаблицы.Грузоперевозка.Заказ) = Неопределено Тогда  
			ВладельцыБюжета.Добавить(СтрокаТаблицы.Грузоперевозка.Заказ);
		Конецесли;
	КонецЦикла;   
	
	Возврат ВладельцыБюжета;
	
КонецФункции
	
	
&НаКлиенте
Процедура ПослеСозданияСтатейБюджета(РезультатВыполнения, ДопоплнительныеПараметры) Экспорт
	
	Если РезультатВыполнения.Статус = "Выполнено" Тогда    
		
		ЗаполнитьСтатьиБюджетаВСтроках(РезультатВыполнения.АдресРезультата);
		
	ИначеЕсли РезультатВыполнения.Статус = "Ошибка" Тогда
		
		ТекстПредупреждения = "Информация об ошибке см. в журнале регистрации!";
		
		Если ТипЗнч(РезультатВыполнения.Сообщения) = Тип("Массив") Тогда
			
			Для Каждого СообщениеВМассиве из РезультатВыполнения.Сообщения Цикл
				СообщениеВМассиве.Сообщить();
			КонецЦикла;
			
		КонецЕсли;
		
		ПоказатьПредупреждение(,ТекстПредупреждения);  
		
	КонецЕсли; 
	
КонецПроцедуры   

&НаСервере
Процедура ЗаполнитьСтатьиБюджетаВСтроках(АдресРезультата) 
	
	СоответствиеСтатейБюджета = ПолучитьИзВременногоХранилища(АдресРезультата);
	
	Для Каждого КлючЗначение из СоответствиеСтатейБюджета Цикл
		СтрокаТаблицы = Объект.Услуги.НайтиПоИдентификатору(КлючЗначение.Ключ);
		СтрокаТаблицы.СтатьяБюджета = КлючЗначение.Значение;
	КонецЦикла;
	
	Модифицированность = Истина;
	
КонецПроцедуры


&НаКлиенте
Процедура БюджетОбновитьСтатьи(Команда)  
	
	ДанныеСтатейБюджета = ПолучитьПараметрыДляОбновленияСтатейБюджета(Элементы.Услуги.ВыделенныеСтроки);	
	Если ДанныеСтатейБюджета = Неопределено Тогда
		ПоказатьПредупреждение(,"Для выделенных строк не указаны статьи бюджета!");
		Возврат;
	КонецЕсли;        
	
	ДопоплнительныеПараметры = Новый Структура;
	ДопоплнительныеПараметры.Вставить("ДанныеСтатейБюджета", ДанныеСтатейБюджета);
	
	Режим = РежимДиалогаВопрос.ДаНет;
	Оповещение = Новый ОписаниеОповещения("ПродолжитьОбновлениеСтатейБюджета", ЭтотОбъект, ДопоплнительныеПараметры);
	ПоказатьВопрос(Оповещение, "Для статей бюджета выделенных строк будут обновлены реквизиты. Продолжить?", Режим, 0);

КонецПроцедуры

&НаКлиенте
Процедура ПродолжитьОбновлениеСтатейБюджета(Результат, ДопоплнительныеПараметры) Экспорт
    Если Результат = КодВозвратаДиалога.Нет Тогда
        Возврат;
	КонецЕсли;  

	Оповещение = Новый ОписаниеОповещения("ПослеОбновленияСтатейБюджета", ЭтотОбъект);
	
	ПараметрыПроцедуры = Новый Структура;
	ПараметрыПроцедуры.Вставить("Форма",				ЭтотОбъект); 
	ПараметрыПроцедуры.Вставить("Оповещение",			Оповещение); 
	ПараметрыПроцедуры.Вставить("ДанныеСтатейБюджета", 	ДопоплнительныеПараметры.ДанныеСтатейБюджета);
	
	CW_БюджетированиеКлиент.ОбновитьСтатьиБюджета(ПараметрыПроцедуры);
	
КонецПроцедуры    

&НаКлиенте
Процедура ПослеОбновленияСтатейБюджета(РезультатВыполнения, ДопоплнительныеПараметры) Экспорт
	
	Если РезультатВыполнения.Статус = "Выполнено" Тогда    
		
		ОповеститьОбИзменении(тип("СправочникСсылка.CW_ПлановыеСтатьиЗатратИДоходов"));
		
		Элементы.Услуги.Обновить();
	
		ПоказатьОповещениеПользователя("Статьи бюджета",,"Обновлены данные статей бюджета");
		
	ИначеЕсли РезультатВыполнения.Статус = "Ошибка" Тогда
		
		ТекстПредупреждения = "Информация об ошибке см. в журнале регистрации!";
		
		Если ТипЗнч(РезультатВыполнения.Сообщения) = Тип("Массив") Тогда
			
			Для Каждого СообщениеВМассиве из РезультатВыполнения.Сообщения Цикл
				СообщениеВМассиве.Сообщить();
			КонецЦикла;
			
		КонецЕсли;
		
		ПоказатьПредупреждение(,ТекстПредупреждения);  
		
	КонецЕсли; 
	
КонецПроцедуры

&НаСервере
Функция ПолучитьПараметрыДляОбновленияСтатейБюджета(Знач ВыделенныеСтроки)
	
	ДанныеСтатейБюджета = Новый Соответствие;
	
	Для Каждого ИдентификаторСтроки из ВыделенныеСтроки Цикл
		СтрокаТаблицы = Объект.Услуги.НайтиПоИдентификатору(ИдентификаторСтроки); 
		Если Не ЗначениеЗаполнено(СтрокаТаблицы.СтатьяБюджета) Тогда
			Продолжить;
		КонецЕсли;   
		
		ДанныеСтатьи = ДанныеСтатейБюджета.Получить(СтрокаТаблицы.СтатьяБюджета);
		Если ДанныеСтатьи = Неопределено Тогда
			ДанныеСтатьи = Новый Структура("Контрагент,Договор,ПриложениеКДоговору,Валюта,Курс,Кратность,Номенклатура,ПорядокОтражения,СтавкаНДС,Количество,Цена,Сумма,СуммаНДС,СуммаВсего");
		КонецЕсли;
	
		ЗаполнитьЗначенияСвойств(ДанныеСтатьи, СтрокаТаблицы);                     
		
		ДанныеСтатьи.Вставить("Контрагент",Объект.Контрагент);
		ДанныеСтатьи.Вставить("Договор",Объект.Договор);  
		ДанныеСтатьи.Вставить("Валюта",Объект.Валюта);  
		ДанныеСтатьи.Вставить("ПриложениеКДоговору",Объект.ПриложениеКДоговору); 
		ДанныеСтатьи.Вставить("СуммаНДС",СтрокаТаблицы.НДС);
		ДанныеСтатьи.Вставить("СуммаВсего",СтрокаТаблицы.Всего);  
		
		// определим курс и кратность 
		Курс = 1;
		Кратность = 1;   
		ВалютаРегламентированногоУчета = Константы.ВалютаРегламентированногоУчета.Получить();  
		Если Объект.Валюта <> ВалютаРегламентированногоУчета Тогда 
			Контракт = ?(ЗначениеЗаполнено(Объект.ПриложениеКДоговору),Объект.ПриложениеКДоговору, Объект.Договор);
			Если Объект.УЕ_ПользовательскийКурс Тогда
				Курс = Объект.УЕ_Курс;
				Кратность = Объект.УЕ_Кратность;
			Иначе
				Если (Объект.ФормируетсяАкт) Тогда
					ДатаКурса = Объект.ДатаАкта;
				Иначе
					Если (Объект.ФормируетсяСчет) Тогда 
						ДатаКурса = Объект.ДатаСчета;
					Иначе
						ДатаКурса = Объект.Дата;
					КонецЕсли;
				КонецЕсли; 
				СтруктураКурсаВалюты = CW_Финансы.ПолучитьКурсВалюты(Объект.Валюта,ДатаКурса);
				Курс = СтруктураКурсаВалюты.Курс;
				Кратность = СтруктураКурсаВалюты.Кратность;
			КонецЕсли;
		КонецЕсли;
 		ДанныеСтатьи.Вставить("Курс",Курс);
 		ДанныеСтатьи.Вставить("Кратность",Кратность);
		
		ДанныеСтатейБюджета.Вставить(СтрокаТаблицы.СтатьяБюджета, ДанныеСтатьи);
	КонецЦикла; 

	Если ДанныеСтатейБюджета.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат ДанныеСтатейБюджета;
	
КонецФункции

&НаКлиенте
Процедура БюджетОчиститьСтатьи(Команда)  
	ВыделенныеСтроки = Элементы.Услуги.ВыделенныеСтроки;
	Если ВыделенныеСтроки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ВыделенныеСтроки", ВыделенныеСтроки);
	
	Режим = РежимДиалогаВопрос.ДаНет;                                                            
	Оповещение = Новый ОписаниеОповещения("ПродолжитьОчисткуСтатейБюджетаПоСтрокам", ЭтотОбъект, ДополнительныеПараметры);
	ПоказатьВопрос(Оповещение, "Статьи бюджета в выделенных строках будут очищены. Продолжить?", Режим, 0);
	
КонецПроцедуры 

&НаКлиенте
Процедура ПродолжитьОчисткуСтатейБюджетаПоСтрокам(Результат, ДополнительныеПараметры) Экспорт
    Если Результат = КодВозвратаДиалога.Нет Тогда
        Возврат;
    КонецЕсли;

	БюджетОчиститьСтатьиНаСервере(ДополнительныеПараметры.ВыделенныеСтроки);

КонецПроцедуры  

&НаСервере
Процедура БюджетОчиститьСтатьиНаСервере(ВыделенныеСтроки)   
	
	Для Каждого ИдентификаторСтроки из ВыделенныеСтроки Цикл
		СтрокаТаблицы = Объект.Услуги.НайтиПоИдентификатору(ИдентификаторСтроки);
		СтрокаТаблицы.СтатьяБюджета = ПредопределенноеЗначение("Справочник.CW_ПлановыеСтатьиЗатратИДоходов.ПустаяСсылка");
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура СтатусДокументаОчистка(Элемент, СтандартнаяОбработка)

	СтандартнаяОбработка = ложь;

КонецПроцедуры

