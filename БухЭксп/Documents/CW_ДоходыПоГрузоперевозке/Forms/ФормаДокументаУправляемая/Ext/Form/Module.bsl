//Взаиморасчеты по документу
&НаКлиенте
Процедура Команда_ВзаиморасчетыПоДокументу(Команда)
	
	Если Объект.Ссылка.Пустая() Тогда   
		Возврат;
	КонецЕсли;   
	
	ВариантАналитикиКорректировки = ПолучитьЗначениеУчетнойПолитики();
	
	ДокументОтчета = ПолучитьДокументОтчета(Объект.Ссылка, ВариантАналитикиКорректировки);
	Если ДокументОтчета = Неопределено Тогда
		Возврат;
	КонецЕсли;

	CW_ВзаиморасчетыПоДокументуКлиент.ОткрытьФормуОтчетаВзаиморасчетыПоДокументу(ЭтаФорма, ДокументОтчета, "ДЕБИТОРСКАЯ");
	
КонецПроцедуры


&НаСервере
Функция ПолучитьДокументОтчета(ОбъектСсылка, ВариантАналитикиКорректировки) 
	
	Если Не ОбъектСсылка.Корректировка Тогда
		Возврат ОбъектСсылка;
	КонецЕсли;     
	
	Если ВариантАналитикиКорректировки = 1 Тогда
		Возврат ОбъектСсылка;
	КонецЕсли;                           
	                                       
	Если Объект.КорректируемыйДокумент.Корректировка Тогда
		Возврат ПолучитьДокументОтчета(Объект.КорректируемыйДокумент, ВариантАналитикиКорректировки); 
	КонецЕсли;
	
	Возврат  Объект.КорректируемыйДокумент;
	
КонецФункции  

&НаСервере
Функция ПолучитьЗначениеУчетнойПолитики() 
	
	//корректируемый документ(0), документ корректировки(1)
	
	Запрос = новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	CW_УчетнаяПолитикаСрезПоследних.АналитикаКорректировкиОперативнойЗадолженности КАК АналитикаКорректировки
	               |ИЗ
	               |	РегистрСведений.CW_УчетнаяПолитика.СрезПоследних(&ДатаСреза, Организация = &Организация) КАК CW_УчетнаяПолитикаСрезПоследних"; 
	
	Запрос.УстановитьПараметр("ДатаСреза", Объект.Дата);
	Запрос.УстановитьПараметр("Организация", Объект.Организация); 
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.АналитикаКорректировки;	
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции
