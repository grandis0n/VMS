&НаКлиенте
Процедура УслугиСчетНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	// ---------------------------------------------------------------------------- 
	
	Вариант = Неопределено;
	
	Список = Новый СписокЗначений;
	Список.Добавить("список","Выбор из списка");
	
	// если ведется оперативный учет задолженности
	
	Если (ОперативныйУчет И НЕ ВводОстатковОЗ) Тогда
		
		Список.Добавить("подбор","Подбор неактированных");
		
	КонецЕсли; 
	
	
	ПОВ = Новый ОписаниеОповещения("ОбработатьВыборВариантаПодбораСчета",ЭтотОбъект, Новый Структура("Элемент",Элемент)); 
	Если (Список.Количество()=1) Тогда
		
		ВыполнитьОбработкуОповещения(ПОВ,Список[0]);
		
	Иначе
		
		ПоказатьВыборИзМеню(ПОВ,Список,Элемент);
		
	КонецЕсли; 
		
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьВыборВариантаПодбораСчета(Ответ, ДополнительныеПараметры) Экспорт 

	Если Ответ  = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Ответ.Значение = "подбор" Тогда
		
		ТекущиеДанные = Элементы.Услуги.ТекущиеДанные;    
		
		СтруктураОтбора = Новый Структура;
		СтруктураОтбора.Вставить("Организация", Объект.Организация);
		
		СтруктураОтбора.Вставить("Контрагент", 			Объект.Контрагент);
		СтруктураОтбора.Вставить("Договор", 			Объект.Договор);  
		СтруктураОтбора.Вставить("ПриложениеКДоговору", Объект.ПриложениеКДоговору);
		
		СтруктураОтбора.Вставить("Валюта", 				Объект.Валюта);
		
		СтруктураОтбора.Вставить("Грузоперевозка", 		ТекущиеДанные.Грузоперевозка);
		СтруктураОтбора.Вставить("ПорядокОтражения", 	ТекущиеДанные.ПорядокОтражения);
		СтруктураОтбора.Вставить("Номенклатура", 		ТекущиеДанные.Номенклатура);
		СтруктураОтбора.Вставить("СтавкаНДС", 			ТекущиеДанные.СтавкаНДС);      
		
		ПараметрыФормыПодбора = Новый Структура;
		ПараметрыФормыПодбора.Вставить("Дата",			Объект.Дата);
		ПараметрыФормыПодбора.Вставить("Документ",		Объект.Ссылка);
		ПараметрыФормыПодбора.Вставить("Отбор",			СтруктураОтбора);
		ПараметрыФормыПодбора.Вставить("РежимВыбора",	Истина);
		
		ОткрытьФорму("ОбщаяФорма.CW_ПодборНеактированныхСчетов", ПараметрыФормыПодбора, ДополнительныеПараметры.Элемент,,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
	КонецЕсли;   
	
	Если Ответ.Значение = "список" Тогда   
		
		СтруктураОтбора = Новый Структура;
		СтруктураОтбора.Вставить("Контрагент", 			Объект.Контрагент);
		СтруктураОтбора.Вставить("Договор", 			Объект.Договор);
		
		Если ЗначениеЗаполнено(Объект.ПриложениеКДоговору) Тогда
			СтруктураОтбора.Вставить("ПриложениеКДоговору", Объект.ПриложениеКДоговору);
		КонецЕсли;
		
		СтруктураОтбора.Вставить("ФормируетсяСчет", 		Истина);
		СтруктураОтбора.Вставить("ФормируетсяАкт", 			Ложь);
		СтруктураОтбора.Вставить("ФормируетсяСчетФактура", 	Ложь);
		
		ПараметрыФормаВыбора = Новый Структура;
		ПараметрыФормаВыбора.Вставить("Отбор",			СтруктураОтбора);
		ПараметрыФормаВыбора.Вставить("РежимВыбора",	Истина);
		
		// во всех остальных случаях
		ОткрытьФорму("Документ.CW_ДоходыПоГрузоперевозке.ФормаВыбора",ПараметрыФормаВыбора, ДополнительныеПараметры.Элемент,,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
	КонецЕсли;   
	
КонецПроцедуры

