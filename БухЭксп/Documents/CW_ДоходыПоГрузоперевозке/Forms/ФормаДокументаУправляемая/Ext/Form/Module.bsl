#Область ПодстановкаПодписантов

&НаКлиенте
Процедура Подписанты_Обновить(Команда)
	
	Если _ДС().НП.ПодставлятьУполномоченныхЛицПриСозданииДокументов Тогда
		_ПодставитьПодписантов();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура _ПодставитьПодписантов()
	
	Если Объект.Организация.Пустая() Тогда
		Возврат;
	КонецЕсли; 
	
	Объект.Руководитель 			= Неопределено;
	Объект.ЗаРуководителяПоПриказу 	= "";
	
	Объект.ГлавныйБухгалтер 				= Неопределено;
	Объект.ЗаГлавногоБухгалтераПоПриказу 	= "";
	
	ДанныеПодписантовОрагнизации = _УФС.ПолучитьОтветственныхЛиц(Объект.Организация, Объект.ПодразделениеОрганизации);
	
	ДанныеРуководитель = ДанныеПодписантовОрагнизации.Получить(Перечисления.ОтветственныеЛицаОрганизаций.Руководитель);
	
	Если ДанныеРуководитель <> Неопределено Тогда
		
		ДанныеРуководитель.Свойство("УполномоченноеЛицо", Объект.Руководитель);
		ДанныеРуководитель.Свойство("НомерДатаПриказа"	, Объект.ЗаРуководителяПоПриказу);
		
	КонецЕсли;
	
	ДанныеГлавныйБухгалтер = ДанныеПодписантовОрагнизации.Получить(Перечисления.ОтветственныеЛицаОрганизаций.ГлавныйБухгалтер);
	
	Если ДанныеГлавныйБухгалтер <> Неопределено Тогда
		
		ДанныеГлавныйБухгалтер.Свойство("УполномоченноеЛицо", Объект.ГлавныйБухгалтер);
		ДанныеГлавныйБухгалтер.Свойство("НомерДатаПриказа"	, Объект.ЗаГлавногоБухгалтераПоПриказу);
		
	КонецЕсли;
	
	ДанныеОтветственныйЗаОформление = ДанныеПодписантовОрагнизации.Получить(Перечисления.ОтветственныеЛицаОрганизаций.ОтветственныйЗаОформление);
	
	Если ДанныеОтветственныйЗаОформление <> Неопределено
		И ДанныеГлавныйБухгалтер <> Неопределено Тогда
		
		ДанныеГлавныйБухгалтер.Свойство("УполномоченноеЛицо", Объект.ОтветственныйЗаОформление);
		ДанныеГлавныйБухгалтер.Свойство("НомерДатаПриказа"	, Объект.ОтветственныйЗаОформлениеПоПриказу);
		
	КонецЕсли;
	
КонецПроцедуры
 

