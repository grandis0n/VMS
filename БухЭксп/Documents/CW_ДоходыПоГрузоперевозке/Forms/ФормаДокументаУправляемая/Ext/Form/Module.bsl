&НаКлиенте
Процедура УслугиКорректировкаВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	// Отработка действий при попытке выбора (изменений) реквизитов, 
	// для которых установлен признак "Только просмотр":
	Если Элементы.УслугиКорректировка.ТекущиеДанные.ЭтоДобавленнаяСтрока = Ложь Тогда
		
		// колонка "Заказ"
		Если Поле = Элементы.УслугиКорректировкаГрузоперевозкаЗаказ Тогда 
			СтандартнаяОбработка = Ложь;
			Попытка
				ПоказатьЗначение(,_Заказ(Элементы.УслугиКорректировка.ТекущиеДанные.Грузоперевозка));
			Исключение
				//ОписаниеОшибки()
			КонецПопытки; 
			
			// колонка "Грузоперевозка"
		ИначеЕсли (Поле = Элементы.УслугиКорректировкаГрузоперевозка) Тогда 
			СтандартнаяОбработка = Ложь;
			Попытка
				ПоказатьЗначение(,Элементы.УслугиКорректировка.ТекущиеДанные.Грузоперевозка);
			Исключение
				//ОписаниеОшибки()
			КонецПопытки; 
			
			// колонка "Представление документа расходов"
		ИначеЕсли (Поле = Элементы.УслугиКорректировкаДокументРасходовПредставлениеДокумента) Тогда 
			СтандартнаяОбработка = Ложь;
			Попытка
				ПоказатьЗначение(,Элементы.УслугиКорректировка.ТекущиеДанные.ДокументРасходов);
			Исключение
				//ОписаниеОшибки()
			КонецПопытки; 
			
		КонецЕсли; 
		
	КонецЕсли;  
	
КонецПроцедуры

