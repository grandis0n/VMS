		ДополнительныеПараметры.Вставить("мИдентифкаторы", Элементы.Услуги.ВыделенныеСтроки);
		
		Режим = РежимДиалогаВопрос.ДаНет;
		Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаОбУдаленииСтроки", ЭтотОбъект, ДополнительныеПараметры);
		ПоказатьВопрос(Оповещение, "Удалить выделенные строки?", Режим, 0);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияВопросаОбУдаленииСтроки(Результат, ДополнительныеПараметры) Экспорт
