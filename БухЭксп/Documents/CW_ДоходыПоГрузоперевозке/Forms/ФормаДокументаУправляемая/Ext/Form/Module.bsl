#КонецОбласти 

#Область ИзменениеОрганизации 

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
	
	_ОрганизацияПриИзменении();
	
КонецПроцедуры

&НаСервере
Процедура _ОрганизацияПриИзменении()
	// --- 
	
	_СформироватьОбщиеПараметры("УчетнаяПолитика");
	Если (_ДС().НП.ПодставлятьУполномоченныхЛицПриСозданииДокументов И Объект.Ссылка.Пустая()) Тогда
		
		_ПодставитьПодписантов();
		
	КонецЕсли; 
	
	Если СтараяОрганизация <> Объект.Организация Тогда
		Объект.Номер = "";
		
		Объект.НомерСчета 			= "";
		Объект.НомерАкта 			= "";
		Объект.НомерСчетаФактуры 	= "";
		Объект.ДатаСчета 		= Дата(1,1,1);
		Объект.ДатаАкта 		= Дата(1,1,1);
		Объект.ДатаСчетаФактуры = Дата(1,1,1);
		
		СтараяОрганизация = Объект.Организация;
		
		_ОбновитьНомераДокументов() ;
		
	КонецЕсли;
	
	_УстановитьПараметрыФункциональныхОпцийФормы();
	
	УстановитьПараметрыВыбораСтавкиНДС();
	// --- 
КонецПроцедуры

