#Область ОчисткаТабличнойЧасти

&НаКлиенте
Процедура ОчиститьТабличнуюЧастьУслуг(Команда)
	
	Если Объект.Услуги.Количество() <> 0 Тогда 
		
		массВидимыхСтрок = Новый Массив;
		массСкрытыхСтрок = Новый Массив;
		Для Каждого строкаУслуги Из Объект.Услуги Цикл
			Если Элементы.Услуги.ПроверитьСтроку(строкаУслуги.ПолучитьИдентификатор()) Тогда 
				массВидимыхСтрок.Добавить(строкаУслуги);
			Иначе 
				массСкрытыхСтрок.Добавить(строкаУслуги);
			КонецЕсли;
		КонецЦикла;
		
		Если массВидимыхСтрок.Количество() = Объект.Услуги.Количество() Тогда 
			
			// нет отбора
			ПОВ = Новый ОписаниеОповещения("ОбработкаВопросаОчисткиУслугДляОчистки",ЭтотОбъект); 
			ПоказатьВопрос(ПОВ,"Очистить табличную часть Услуги?", РежимДиалогаВопрос.ОКОтмена);
			
		Иначе 
			
			// установлен какой-то отбор
			сз = Новый СписокЗначений;
			сз.Добавить("Все", "Очистить - все строки ("+Объект.Услуги.Количество()+")");
			сз.Добавить("Видимые", "С учетом отбора - видимые ("+массВидимыхСтрок.Количество()+")");
			сз.Добавить("Скрытые", "С учетом отбора - скрытые ("+массСкрытыхСтрок.Количество()+")");
			ПОВ = Новый ОписаниеОповещения("ОбработкаВыбораВариантаОчистки",ЭтотОбъект, Новый Структура("массВидимыхСтрок,массСкрытыхСтрок",массВидимыхСтрок,массСкрытыхСтрок)); 
			СЗ.ПоказатьВыборЭлемента(ПОВ,"РежимОчистки");
			
		КонецЕсли;
		
	Иначе 
		
		_УФК.ВывестиПредупреждение("Табличная часть ""Услуги"" уже пустая.");
		
	КонецЕсли;
	
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВопросаОчисткиУслугДляОчистки(Ответ, ДополнительныеПараметры) Экспорт 
	// --- 
	
	Если (Ответ = КодВозвратаДиалога.ОК) Тогда
		
		Объект.Услуги.Очистить();
		ОбновитьИтогиПоУслугам();
		
	КонецЕсли; 
	
	// --- 
КонецПроцедуры
  
&НаКлиенте
Процедура ОбработкаВыбораВариантаОчистки(Ответ, ДополнительныеПараметры) Экспорт 
	// --- 
	
	Если (Ответ <> Неопределено) Тогда 
		
		Если Ответ.Значение = "Все" Тогда 
			
			Объект.Услуги.Очистить();
			ОбновитьИтогиПоУслугам();
			
		ИначеЕсли Ответ.Значение = "Видимые" Тогда 
			
			Для Каждого строкаУслуги Из ДополнительныеПараметры.массВидимыхСтрок Цикл
				Объект.Услуги.Удалить(строкаУслуги);
			КонецЦикла;
			ОбновитьИтогиПоУслугам();
			_УФК.ВывестиПредупреждение("Отключите отбор, чтобы увидеть, что осталось.");
			
		ИначеЕсли Ответ.Значение = "Скрытые" Тогда 
			
			Для Каждого строкаУслуги Из ДополнительныеПараметры.массСкрытыхСтрок Цикл
				Объект.Услуги.Удалить(строкаУслуги);
			КонецЦикла;
			ОбновитьИтогиПоУслугам();
			_УФК.ВывестиПредупреждение("Невидимые строки удалены.");
			
		КонецЕсли;
		
	КонецЕсли;
			
	// --- 
КонецПроцедуры
  

