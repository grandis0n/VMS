&НаСервере
Процедура _ОбновитьАкты()
	
	Если НЕ Объект.ФормируетсяСчет Тогда
		Возврат;
	КонецЕсли; 
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	CW_АктированиеИсходящихСчетовОбороты.Регистратор КАК Акт,
	               |	CW_АктированиеИсходящихСчетовОбороты.ВсегоРасход КАК Всего,
	               |	ЕСТЬNULL(CW_АктированиеИсходящихСчетовОбороты.Регистратор.НомерАкта, CW_АктированиеИсходящихСчетовОбороты.Регистратор.Номер) КАК Номер,
	               |	ЕСТЬNULL(CW_АктированиеИсходящихСчетовОбороты.Регистратор.ДатаАкта, CW_АктированиеИсходящихСчетовОбороты.Регистратор.Дата) КАК Дата,
	               |	ЕСТЬNULL(CW_АктированиеИсходящихСчетовОбороты.Регистратор.Корректировка, ИСТИНА) КАК ЭтоАктКорректировка
	               |ИЗ
	               |	РегистрНакопления.CW_АктированиеИсходящихСчетов.Обороты(, , Регистратор, Счет = &Счет) КАК CW_АктированиеИсходящихСчетовОбороты
	               |ГДЕ
	               |	CW_АктированиеИсходящихСчетовОбороты.Регистратор <> &Счет
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Дата
	               |АВТОУПОРЯДОЧИВАНИЕ";
				   
	Запрос.УстановитьПараметр("Счет", Объект.Ссылка);
	Выборка = Запрос.Выполнить().Выбрать(); 
	
	ТаблицаАктов.Очистить();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = ТаблицаАктов.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		
		Если ТипЗнч(Выборка.Акт) = Тип("ДокументСсылка.CW_ДоходыПоГрузоперевозке") Тогда 
			Префикс 			= ?(Выборка.ЭтоАктКорректировка, "(К)","");
			ШаблонПредставления = "Акт №%1 %2 от %3";
		Иначе
			Префикс 	= "";
			Название 	= Выборка.Акт.Метаданные().Синоним;
			ШаблонПредставления = Название+ "№%1 %2 от %3";
		КонецЕсли;
	
		НоваяСтрока.Представление = СтрШаблон(ШаблонПредставления,Строка(Выборка.Номер),Префикс,Формат(Выборка.Дата,"ДФ=dd.MM.yyyy"));
		
	КонецЦикла;
	
	// обновим форму
	_УправлениеЭлементамиФормы();
	
КонецПроцедуры

Процедура ОбновитьИтогиПоАктированию()
	
	// обновим итоговую строку
	СВ = Строка(Объект.Валюта);
	ФЧ = "ЧЦ=15; ЧДЦ=2; ЧН=";
	
	ИтогоПоАктам = 	"Всего: "+Формат(ТаблицаАктов.Итог("Всего"),ФЧ)+" "+СВ;
	НеАктировано = Объект.Услуги.Итог("Всего")-ТаблицаАктов.Итог("Всего");
	Если НеАктировано <> 0 Тогда
		ИтогоПоАктам = ИтогоПоАктам + ";  Не актировано: "+Формат(НеАктировано,ФЧ)+" "+СВ;
		//Элементы.ИтогоПоАктам.ЦветТекста = ЦветаСтиля.ЦветОтрицательногоЧисла;
	Иначе
		//Элементы.ИтогоПоАктам.ЦветТекста = ЦветаСтиля.ЦветТекстаКнопки;
	КонецЕсли; 
	
КонецПроцедуры

#КонецОбласти 

// ---------------------------------------------------------------------------- 
// ПРОЦЕДУРЫ ЗАПОЛНЕНИЯ
// ---------------------------------------------------------------------------- 

#Область ЗаполнениеАгентскогоВознаграждения 

&НаКлиенте
Процедура ЗаполнитьРасчетАгентскогоВознаграждения(Команда)
	
	Если НЕ ЗначениеЗаполнено(Объект.Договор) Тогда 
		_УФК.ВывестиПредупреждение("Не выбран договор!");
		Возврат;
	КонецЕсли;
	Если Объект.ВидОперации<>ПредопределенноеЗначение("Перечисление.CW_ВидыОперацийДоходыПоГрузоперевозке.ОтчетАгента") Тогда 
		
		_УФК.ВывестиПредупреждение("Расчёт вознаграждения выполняется только для вида операции ""Отчёт агента""!");
		Возврат;
		
	КонецЕсли;
	Если НЕ _ДС().ПД.АвтоматическийРасчетВознаграждения Тогда 
		
		_УФК.ВывестиПредупреждение("Заполнение по перевыставленнм затратам производится только если в параметрах договора указано автоматически рассчитывать вознаграждение!");
		Возврат;
		
	КонецЕсли;
	Если _ДС().ПД.МоментАвтоматическогоВыставленияВознаграждения <> ПредопределенноеЗначение("Перечисление.CW_МоментАвтоматическогоВыставленияВознаграждения.ОтдельнымДокументом") Тогда 
		
		_УФК.ВывестиПредупреждение("Заполнение по перевыставленнм затратам производится только если момент автоматического выставления вознаграждения - отдельным документом!");
		Возврат;
		
	КонецЕсли;
	
	Ответ = _ЗагрузитьАгентскоеВознаграждение();
	Если (_УФКС.ВыполненоУспешно(Ответ)) Тогда
		
		ОбновитьИтогиПоУслугам();
		Если (Объект.Услуги.Количество()=0) Тогда
			
			_УФК.ВывестиПредупреждение("Оснований для начисления вознаграждения не найдено.");
			
		КонецЕсли; 
		
	КонецЕсли; 	
	
	
КонецПроцедуры

&НаСервере
Функция _ЗагрузитьАгентскоеВознаграждение()
	// --- 
	
	Попытка
		
		Объект.Услуги.Очистить();
		// --- 
		ТЗ = Документы.CW_ДоходыПоГрузоперевозке.Услуги_СформироватьВознаграждение(Объект.Дата,Объект.Договор,Объект.ПриложениеКДоговору,_ДС().ПД);
		// --- 
		Объект.Услуги.Загрузить(ТЗ);
		_ОбновитьСтатусПометокУдаления();
		
		ОбновитьПредставлениеНоменклатуры();

		// --- 
		Возврат(_УФКС.Ответ());
		
	Исключение
		Сообщить(ОписаниеОшибки());
	КонецПопытки; 
	
	// --- 
КонецФункции

&НаСервере
Процедура ОбновитьПредставлениеНоменклатуры()
	
	Для Каждого СтрокаТЗ из Объект.Услуги Цикл
		ИдентификаторСтроки = СтрокаТЗ.ПолучитьИдентификатор();
		_УслугиПредставлениеНачалоВыбора(ИдентификаторСтроки)
	КонецЦикла;

КонецПроцедуры

#КонецОбласти 

#Область ЗаполнениеНеперевыставленными

&НаКлиенте
Процедура ЗаполнитьПоНеперевыставленнымЗатратам(Команда)
	
	Если НЕ ЗначениеЗаполнено(Объект.Договор) Тогда 
		_УФК.ВывестиПредупреждение("Не выбран договор!");
		Возврат;
	КонецЕсли;
	Если Объект.ВидОперации <> ПредопределенноеЗначение("Перечисление.CW_ВидыОперацийДоходыПоГрузоперевозке.ОказаниеУслуг") Тогда 
		_УФК.ВывестиПредупреждение("Заполнение по остаткам неперевыставленных затрат производится только если вид операции - оказание услуг!");
		Возврат;
	КонецЕсли;
	// --- 
	Если Объект.Услуги.Количество()<>0 Тогда
		
		ПОВ = Новый ОписаниеОповещения("ОбработкаВопросаОчисткиУслугДляЗаполненияПоНеперевыставленным",ЭтотОбъект); 
		ПоказатьВопрос(ПОВ,"Очищать табличную часть при заполнении?", РежимДиалогаВопрос.ДаНет);
		
	Иначе
		
		ВыполнитьЗаполнениеПоНеперевыставленнымЗатратам();
		
	КонецЕсли;
	// --- 
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВопросаОчисткиУслугДляЗаполненияПоНеперевыставленным(Ответ, ДополнительныеПараметры) Экспорт 
	// --- 
	
	Если (Ответ = КодВозвратаДиалога.Да) Тогда
		Объект.Услуги.Очистить();
	КонецЕсли;  
	ВыполнитьЗаполнениеПоНеперевыставленнымЗатратам();
	
	// --- 
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьЗаполнениеПоНеперевыставленнымЗатратам()
	// --- 
	
	// открываем форму, даём выбрать
	ПараметрыФормы = Новый Структура;
	АдресаТаблиц = _ПолучитьАдресТаблицПоПеревыставляемым();
	ПараметрыФормы.Вставить("АдресТЗ",АдресаТаблиц.ТаблицаСвертки);
	ПараметрыФормы.Вставить("ВыводитьЗаказы",_ДС().КО.CW_ИспользованиеЗаказов);
	ПараметрыФормы.Вставить("ПоПоставщику",_ДС().НП.ГруппироватьПоПоставщикамПриПеревыставлении);
	Если (НЕ Объект.ФормируетсяСчет И Объект.ФормируетсяАкт И НЕ Объект.СписокСчетов) Тогда
		ПараметрыФормы.Вставить("СчетДляОтбора",Объект.Счет);	
	КонецЕсли; 
	
	// --- 
	ПОВ = Новый ОписаниеОповещения("ОбработкаЗаполненияПоНеперевыставленнымЗатратам",ЭтотОбъект, Новый Структура("АдресаТаблиц",АдресаТаблиц)); 
	ОткрытьФорму("Документ.CW_ДоходыПоГрузоперевозке.Форма.ФормаВыбораПеревыставляемыхЗатрат",ПараметрыФормы,ЭтаФорма,,,,ПОВ, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
	// --- 
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаЗаполненияПоНеперевыставленнымЗатратам(Ответ, ДополнительныеПараметры) Экспорт
	// --- 
	
	Если Ответ <> Неопределено Тогда
		_ЗагрузитьПеревыставляемые(Ответ,ДополнительныеПараметры.АдресаТаблиц.НовыеУслуги);
		
		#Область Динамический_вывод_дополнительных_колонок
		
		_УФС.ОбновитьЗначенияПараметровГрузоперевозок(ПолучитьСтруктуруПараметровДляПередачи());
		
		#КонецОбласти
		
		ОбновитьИтогиПоУслугам();
		
	КонецЕсли; 
	
	// --- 
КонецПроцедуры

&НаСервере
Функция _ПолучитьАдресТаблицПоПеревыставляемым()
	// --- 
	
	// получим неперевыставленные затраты
	НовыеУслуги = Документы.CW_ДоходыПоГрузоперевозке.Услуги_СформироватьПоНеперевыставленным(Объект.Дата,Объект.Договор);
	
	// получим настройки
	ПоПоставщику = _ДС().НП.ГруппироватьПоПоставщикамПриПеревыставлении;
	Используется1137 = _ДС().УП.СчетаФактурыПоПостановлению1137;
	ИспользуютсяЗаказы = _ДС().КО.CW_ИспользованиеЗаказов;
	
	// для 1137 меняем поставщика на продавца, если указан
	Если Используется1137 Тогда
		
		Для каждого Стр Из НовыеУслуги Цикл
			
			Если НЕ Стр.Продавец.Пустая() Тогда
				
				Стр.Поставщик = Стр.Продавец;
				
			КонецЕсли; 
			
		КонецЦикла; 
		
	КонецЕсли; 
		
	// ---------------------------------------------------------------------------- 
	// подготавливаем таблицу для отбора
	ТЗСвертки = НовыеУслуги.Скопировать(,"Грузоперевозка,Поставщик,ДокументРасходов,Номенклатура,Всего_Рег");
	// группируем
	Если ПоПоставщику Тогда
		
		ТЗСвертки.Свернуть("Грузоперевозка,Поставщик,ДокументРасходов,Номенклатура","Всего_Рег");
		
	Иначе
		
		ТЗСвертки.Свернуть("Грузоперевозка,Номенклатура","Всего_Рег");
		
	КонецЕсли; 
	_сф.т_ПереименоватьКолонки(ТЗСвертки,"Всего_Рег:СуммаВсего");
	ТЗСвертки.Колонки.Добавить("Заказ");
	ТЗСвертки.Колонки.Добавить("Пометка");
	Для каждого Стр Из ТЗСвертки Цикл
		
		Стр.Заказ = Стр.Грузоперевозка.Заказ;
		Стр.Пометка = Ложь;
		
	КонецЦикла; 
	
	СА = Новый Структура("ТаблицаСвертки,НовыеУслуги");
	СА.ТаблицаСвертки = ПоместитьВоВременноеХранилище(ТЗСвертки,ЭтаФорма.УникальныйИдентификатор);
	СА.НовыеУслуги = ПоместитьВоВременноеХранилище(НовыеУслуги,ЭтаФорма.УникальныйИдентификатор);
	
	Возврат(СА);
	
	// --- 
КонецФункции

&НаСервере
Процедура _ЗагрузитьПеревыставляемые(АдресСвертки,АдресНовыхУслуг)
	// --- 
	
	// формируем тз по отбору
	ТЗСвертки = ПолучитьИзВременногоХранилища(АдресСвертки);
	НовыеУслуги = ПолучитьИзВременногоХранилища(АдресНовыхУслуг);
	ТаблицаУслуг = НовыеУслуги.СкопироватьКолонки();
	тзУслугиДляСохранения = Объект.Услуги.Выгрузить();
	ПоПоставщику = _ДС().НП.ГруппироватьПоПоставщикамПриПеревыставлении;
	флЗановоФормироватьПредставлениеПриПеревыставленииЗатрат = CW_Настройки.ПараметрУчетнойПолитики(Объект.Дата, Объект.Организация, "ЗановоФормироватьПредставлениеПриПеревыставленииЗатрат");
	_сф.т_ПереименоватьКолонки(ТЗСвертки,"СуммаВсего:Всего");
	Для каждого Стр Из ТЗСвертки Цикл
		
		Если ПоПоставщику Тогда
			
			Отбор = _сф.ст_Создать("Грузоперевозка,Поставщик,ДокументРасходов,Номенклатура",Стр);
			
		Иначе
			
			Отбор = _сф.ст_Создать("Грузоперевозка,Номенклатура",Стр);
			
		КонецЕсли; 
		
		СтрокиПоГП = НовыеУслуги.НайтиСтроки(Отбор);
		Для каждого Стр Из СтрокиПоГП Цикл
			
			Нстр = ТаблицаУслуг.Добавить();
			ЗаполнитьЗначенияСвойств(Нстр,Стр);
			
		КонецЦикла; 
		
		// --- 
		
	КонецЦикла; 
	// --- 
	
	ТребуетсяПересчетВалюты = (Объект.Валюта <> _ДС().КО.ВалютаРегламентированногоУчета);
	ТребуетсяВознаграждение = (_ДС().ПД.АвтоматическийРасчетВознаграждения И _ДС().ПД.МоментАвтоматическогоВыставленияВознаграждения=Перечисления.CW_МоментАвтоматическогоВыставленияВознаграждения.ПриПеревыставлении);
	
	// просто пересчитываем из рублей
	Если ТребуетсяПересчетВалюты Тогда
		
		ДатаКурса = ?(Объект.ДатаАкта=Дата(1,1,1),Объект.Дата,Объект.ДатаАкта);
		Если Объект.УЕ_ПользовательскийКурс Тогда  
			СК = Новый Структура;
			СК.Вставить("Курс", 		Объект.УЕ_Курс);
			СК.Вставить("Кратность", 	Объект.УЕ_Кратность);
			СК.Вставить("Валюта", 		Объект.Валюта);
			СК.Вставить("ДатаКурса", 	ДатаКурса);
		Иначе
			СК = CW_Финансы.ПолучитьКурсВалюты(Объект.Валюта, ДатаКурса);
		КонецЕсли;    
		
		Документы.CW_ДоходыПоГрузоперевозке.Услуги_ПересчитатьИзВалютыРегламентированногоУчета(ТаблицаУслуг, СК);
		
	Иначе
		
		Документы.CW_ДоходыПоГрузоперевозке.Услуги_ПеренестиИзВалютыРегламентированногоУчета(ТаблицаУслуг);
		
	КонецЕсли;
	
	Если ТребуетсяВознаграждение Тогда
		
		ТаблицаУслуг.Колонки.Добавить("База");
		Документы.CW_ДоходыПоГрузоперевозке.Услуги_ДобавитьВознаграждение(ТаблицаУслуг,Объект.Договор,Объект.ПриложениеКДоговору,_ДС().ПД,Объект.Дата);
		
		ОбновитьПредставлениеНоменклатуры();

	КонецЕсли; 
	
	// загружаем только если был выбор
	// ---------------------------------------------------------------------------- 
	Для каждого Стр Из ТаблицаУслуг Цикл
		
		Нстр = тзУслугиДляСохранения.Добавить();
		ЗаполнитьЗначенияСвойств(Нстр,Стр);
		
	КонецЦикла; 
	
	тзУслугиДляСохранения.Колонки.Добавить("Покупатель");
	тзУслугиДляСохранения.Колонки.Добавить("ДоговорПокупателя");
	
	тзУслугиДляСохранения.ЗаполнитьЗначения(Объект.Контрагент	, "Покупатель");
	тзУслугиДляСохранения.ЗаполнитьЗначения(Объект.Договор		, "ДоговорПокупателя");
	
	// формируем представление номенклатуры
	Документы.CW_ДоходыПоГрузоперевозке.Услуги_СформироватьПредставлениеНоменклатуры(тзУслугиДляСохранения,Объект.Договор,Объект,флЗановоФормироватьПредставлениеПриПеревыставленииЗатрат);
	
	Объект.Услуги.Загрузить(тзУслугиДляСохранения);
	_ОбновитьСтатусПометокУдаления();
	
	// --- 
КонецПроцедуры

#КонецОбласти 

#Область ЗаполнениеНеперевыставленнымиПоСтавкам

&НаКлиенте
Процедура ЗаполнитьПоНеперевыставленнымПоСтавкам(Команда)
	
	Если НЕ ЗначениеЗаполнено(Объект.Договор) Тогда 
		_УФК.ВывестиПредупреждение("Не выбран договор!");
		Возврат;
	КонецЕсли;
	Если Объект.ВидОперации <> ПредопределенноеЗначение("Перечисление.CW_ВидыОперацийДоходыПоГрузоперевозке.ОказаниеУслуг") Тогда 
		_УФК.ВывестиПредупреждение("Заполнение по остаткам неперевыставленных затрат 
		               |производится только для вид операции ""Оказание услуг""!");
		Возврат;
	КонецЕсли;
	
	Если (Объект.Услуги.Количество()<>0) Тогда
		
		ПОВ = Новый ОписаниеОповещения("ОбработкаВопросаОчисткиУслугПриЗаполненииПоНеперевыставленнымПоСтавкам",ЭтотОбъект); 
		ПоказатьВопрос(ПОВ,"Табличная часть будет очищена. 
			        |Продолжить?", РежимДиалогаВопрос.ДаНет);
		
	Иначе
		
		ВыполнитьЗаполнениеПоНеперевыставленнымПоСтавкам();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВопросаОчисткиУслугПриЗаполненииПоНеперевыставленнымПоСтавкам(Ответ, ДополнительныеПараметры) Экспорт
	// --- 
	
	Если (Ответ = КодВозвратаДиалога.Да) Тогда
		Объект.Услуги.Очистить();
	КонецЕсли; 
	ВыполнитьЗаполнениеПоНеперевыставленнымПоСтавкам();
	
	// --- 
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьЗаполнениеПоНеперевыставленнымПоСтавкам()
	// --- 
	
	Ответ = _ЗаполнитьПоНеперевыставленнымПоСтавкам();
	Если (НЕ _УФКС.ВыполненоУспешно(Ответ)) Тогда
		_УФК.ВывестиПредупреждение(_УФКС.ПредставлениеОшибки(Ответ));
	КонецЕсли; 
	
	#Область Динамический_вывод_дополнительных_колонок
	
	_УФС.ОбновитьЗначенияПараметровГрузоперевозок(ПолучитьСтруктуруПараметровДляПередачи());
	
	#КонецОбласти
	
	ОбновитьИтогиПоУслугам();
	_УправлениеЭлементамиФормы();
	// --- 
КонецПроцедуры

&НаСервере
Функция _ЗаполнитьПоНеперевыставленнымПоСтавкам()
	
	ТаблицаУслуг = Документы.CW_ДоходыПоГрузоперевозке.Услуги_СформироватьПоНеперевыставленнымПоСтавкам(Объект.Дата,Объект.Договор);
	
	флЗановоФормироватьПредставлениеПриПеревыставленииЗатрат = CW_Настройки.ПараметрУчетнойПолитики(Объект.Дата, Объект.Организация, "ЗановоФормироватьПредставлениеПриПеревыставленииЗатрат");
	
	ТребуетсяПересчетВалюты = (Объект.Валюта <> _ДС().КО.ВалютаРегламентированногоУчета);
	
	Если ТребуетсяПересчетВалюты Тогда
		СК = CW_Финансы.ПолучитьКурсВалюты(Объект.Валюта,?(Объект.ДатаАкта=Дата(1,1,1),Объект.Дата,Объект.ДатаАкта));
		Документы.CW_ДоходыПоГрузоперевозке.Услуги_ПересчитатьИзВалютыРегламентированногоУчета(ТаблицаУслуг,СК);
	Иначе
		Документы.CW_ДоходыПоГрузоперевозке.Услуги_ПеренестиИзВалютыРегламентированногоУчета(ТаблицаУслуг);
	КонецЕсли;
	
	// формируем представление номенклатуры
	Документы.CW_ДоходыПоГрузоперевозке.Услуги_СформироватьПредставлениеНоменклатуры(ТаблицаУслуг,Объект.Договор,Объект, флЗановоФормироватьПредставлениеПриПеревыставленииЗатрат);
	Если (ТаблицаУслуг.Количество() <> 0) Тогда
		
		Для каждого Стр Из ТаблицаУслуг Цикл
			Нстр = Объект.Услуги.Добавить();
			
			ЗаполнитьЗначенияСвойств(Нстр,Стр);
			
			ЗначениеПараметра	= Стр.Количество;
			Если РазрешитьПолучениеКоличестваУслугИзпараметраГрузоперевозки Тогда
				//Получаем количество из Параметра
				ЗначениеПараметра	= 0;
				СтруктураПараметров = новый Структура("ТипПеревозки,Номенклатура,ЕдиницаИзмерения", Стр.Грузоперевозка.ТипПеревозки, Стр.Номенклатура, Стр.Номенклатура.ЕдиницаИзмерения);
				НайденныйПараметр 	= CW_Документы.ПолучитьПараметрДляПодстановкиЗначенияВКоличество(СтруктураПараметров);
				Если НайденныйПараметр <> Неопределено Тогда
					//Получаем только первое значение
					СтрокаПараметраГП = Стр.Грузоперевозка.ПараметрыГрузоперевозки.Найти(НайденныйПараметр, "Параметр");
					Если СтрокаПараметраГП <> Неопределено Тогда
						ЗначениеПараметра = СтрокаПараметраГП.Значение;
					КонецЕсли;
				КонецЕсли;	
				Если Не ЗначениеЗаполнено(ЗначениеПараметра) и Не УстановитьЗначениеНольЗначениеПараметраНеУстановлено тогда
					ЗначениеПараметра = 1;
				КонецЕсли;
			КонецЕсли;
			
			Нстр.Количество = ЗначениеПараметра;
			
		КонецЦикла; 
		
		//Поставим цены из протокола согласования
		Документы.CW_ДоходыПоГрузоперевозке.Услуги_УстновитьЦенуУслугПоПротоколуСогласованияЦен(Объект.Услуги, Объект);	
		
		
		_ОбновитьСтатусПометокУдаления();
		Модифицированность = истина;
		
		Возврат(_УФКС.Ответ());
	Иначе
		Возврат(_УФКС.Ответ(1,"Данных для заполнения нет."));
	КонецЕсли; 
	
	_УправлениеЭлементамиФормы();

КонецФункции

#КонецОбласти 

