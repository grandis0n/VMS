	// принудительная установка порядка отражения
	Если строкаУслуги.ПорядокОтражения.Пустая() Тогда
		строкаУслуги.ПорядокОтражения = ПредопределенноеЗначение("Перечисление.CW_ПорядокОтраженияДоходов.СобственнаяУслуга");
