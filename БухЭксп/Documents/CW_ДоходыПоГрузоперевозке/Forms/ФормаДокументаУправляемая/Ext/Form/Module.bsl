КонецПроцедуры

&НаСервере
Процедура _ПерезаполнитьПоКорректируемомуДокументу()  
	
	Объект.Услуги.Очистить();
	
	ЗаполнитьПередКорректировкой = CW_Документы.НужноПоказатьПередКорректировкой(Объект);
	ЗаполнитьЗначенияСвойств(Объект, Объект.КорректируемыйДокумент,"Организация,Контрагент,Договор,Валюта,ФормируетсяСчетФактура");  
	
	тДокументыРасходов = Объект.КорректируемыйДокумент.Услуги.Выгрузить().Скопировать(,"ПорядокОтражения,ДокументРасходов");   
	тДокументыРасходов.Свернуть("ПорядокОтражения,ДокументРасходов",); 
	
	Отбор = Новый Структура;
	Отбор.Вставить("ПорядокОтражения", ПредопределенноеЗначение("Перечисление.CW_ПорядокОтраженияДоходов.Перевыставление"));
	
	мСтроки = тДокументыРасходов.НайтиСтроки(Отбор);
	
	мДокументыРасходов = Новый Массив;
	Для Каждого НайденнаяСтрока из мСтроки Цикл
		мДокументыРасходов.Добавить(НайденнаяСтрока.ДокументРасходов);	
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	CW_РасходыПоГрузоперевозке.КорректируемыйДокумент КАК КорректируемыйДокумент,
	|	CW_РасходыПоГрузоперевозке.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.CW_РасходыПоГрузоперевозке КАК CW_РасходыПоГрузоперевозке
	|ГДЕ
	|	CW_РасходыПоГрузоперевозке.КорректируемыйДокумент В(&КорректируемыйДокумент)";
	
	Запрос.УстановитьПараметр("КорректируемыйДокумент", мДокументыРасходов); 
	
	РезультатЗапроса = Запрос.Выполнить();
	
	СоответствиеДокументов = новый Соответствие;
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		СоответствиеДокументов.Вставить(Выборка.КорректируемыйДокумент, Выборка.Ссылка);
	КонецЦикла;
	
	Для каждого КорректируемаяСтрока Из  Объект.КорректируемыйДокумент.Услуги Цикл 
		
		НоваяСтрока = Объект.Услуги.Добавить();
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, КорректируемаяСтрока); 
		
		НоваяСтрока.Представление_ДоКорректировки 	= КорректируемаяСтрока.Представление;
		НоваяСтрока.Количество_ДоКорректировки 		= КорректируемаяСтрока.Количество;
		НоваяСтрока.Цена_ДоКорректировки 			= КорректируемаяСтрока.Цена;
		НоваяСтрока.Сумма_ДоКорректировки 			= КорректируемаяСтрока.Сумма;
		НоваяСтрока.СтавкаНДС_ДоКорректировки 		= КорректируемаяСтрока.СтавкаНДС;
		НоваяСтрока.НДС_ДоКорректировки 			= КорректируемаяСтрока.НДС;
		НоваяСтрока.Всего_ДоКорректировки 			= КорректируемаяСтрока.Всего;
		
		Если КорректируемаяСтрока.ПорядокОтражения = Перечисления.CW_ПорядокОтраженияДоходов.Перевыставление Тогда
			ДокументКорректировкиРасходов = СоответствиеДокументов.Получить(КорректируемаяСтрока.ДокументРасходов);
			Если ДокументКорректировкиРасходов <> Неопределено Тогда
				НоваяСтрока.ДокументРасходов = ДокументКорректировкиРасходов;
			КонецЕсли; 
		КонецЕсли;     
		
		Если ЗаполнитьПередКорректировкой Тогда 
			НоваяСтрока.Представление_ПередКорректировкой 	= КорректируемаяСтрока.Представление_ДоКорректировки;
			НоваяСтрока.Количество_ПередКорректировкой 		= КорректируемаяСтрока.Количество_ДоКорректировки;
			НоваяСтрока.Цена_ПередКорректировкой 			= КорректируемаяСтрока.Цена_ДоКорректировки;
			НоваяСтрока.Сумма_ПередКорректировкой 			= КорректируемаяСтрока.Сумма_ДоКорректировки;
			НоваяСтрока.СтавкаНДС_ПередКорректировкой 		= КорректируемаяСтрока.СтавкаНДС_ДоКорректировки;
			НоваяСтрока.НДС_ПередКорректировкой 			= КорректируемаяСтрока.НДС_ДоКорректировки;
			НоваяСтрока.Всего_ПередКорректировкой 			= КорректируемаяСтрока.Всего_ДоКорректировки;
		КонецЕсли;  
		
	КонецЦикла; 
	
	Если Объект.ВидОперацииКорректировки = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсправленияПоступленияРеализации.ИсправлениеОшибки") тогда
		ИсправлениеПолучитьНомерНаСервере();
	КонецЕсли;
	
	_ОбновитьНомераДокументов();

	Модифицированность = Истина;
	
КонецПроцедуры

