&НаСервере
Процедура ИсправлениеПолучитьНомерНаСервере()
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ CW_ДоходыПоГрузоперевозке.Ссылка) КАК Ссылка
	               |ИЗ
	               |	Документ.CW_ДоходыПоГрузоперевозке КАК CW_ДоходыПоГрузоперевозке
	               |ГДЕ
	               |	CW_ДоходыПоГрузоперевозке.КорректируемыйДокумент = &КорректируемыйДокумент
	               |	И CW_ДоходыПоГрузоперевозке.Ссылка <> &Ссылка";
	
	Запрос.УстановитьПараметр("КорректируемыйДокумент", Объект.КорректируемыйДокумент);
	Запрос.УстановитьПараметр("Ссылка",	Объект.Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	ВсегоИсправлений = 0;
	Если Выборка.Следующий() Тогда
		ВсегоИсправлений = Выборка.Ссылка;
	КонецЕсли;
	
	ВсегоИсправлений = ВсегоИсправлений + 1;
	
	Объект.НомерСчетаФактуры = Объект.КорректируемыйДокумент.НомерСчетаФактуры; 
	Объект.ДатаСчетаФактуры  = ТекущаяДата(); 
	
	Объект.НомерИсправления  = ВсегоИсправлений; 
	
	_ОбновитьНомераДокументов();

КонецПроцедуры

