#Область ОсновныеСобытияФормы 

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	CW_Документы.УстановитьПараметрыФункциональныхОпцийФормы(Этаформа);
	_УстановитьПараметрыФункциональныхОпцийФормы(); 

	ВалютаРегламентированногоУчетаРубль	= ПолучитьФункциональнуюОпцию("CW_ВалютаРегламентированногоУчетаРубль");   
	ВалютаРегламентированногоУчета 		= Константы.ВалютаРегламентированногоУчета.Получить();
	
	Элементы.УслугиГруппаДобвитЬСтрокуСчета.Видимость 	= Не ВалютаРегламентированногоУчетаРубль;
	
	//Для версии КОРП
	ВестиУчетПоПодразделениям					= ПолучитьФункциональнуюОпцию("ВестиУчетПоПодразделениям");
	Элементы.ПодразделениеОрганизации.Видимость	= ВестиУчетПоПодразделениям;
	//Для версии КОРП
	
	ПравоРедактированияНомераДокумента 	= CW_ПраваДоступа.ПравоДоступно("РедактированиеНомераДокументаДоходыПоГрузоперевозкам");
	
	Элементы.Номер.ТолькоПросмотр 		=  НЕ ПравоРедактированияНомераДокумента;
	Элементы.ПолучитьНомер.Видимость 	=  ПравоРедактированияНомераДокумента;
	
	РазрешитьПолучениеКоличестваУслугИзпараметраГрузоперевозки 	= ПолучитьФункциональнуюОпцию("CW_РазрешитьПолучениеКоличестваУслугИзпараметраГрузоперевозки");
	УстановитьЗначениеНольЗначениеПараметраНеУстановлено 		= Константы.CW_УстановитьЗначениеНольЗначениеПараметраНеУстановлено.Получить();
	СохранятьРеквизитыПервичныхДокументов 						= Константы.CW_СохранятьРеквизитыПервичныхДокументов.Получить();
	
	// проверим на копирование
	Если ЗначениеЗаполнено(Параметры.ЗначениеКопирования) Тогда
		Копия = Параметры.ЗначениеКопирования;
	КонецЕсли;	
	
	Элементы.ГруппаИнфо.Видимость = Ложь;
	// ---      
	
	//Взаиморасчеты по документу
	CW_ВзаиморасчетыПоДокументуСервер.УстановитьНазваниеСсылкиОтчета(ЭтаФорма, Объект.ФормируетсяСчет);
	//Взаиморасчеты по документу
	
	ПросмотрБюджетиа = CW_ПраваДоступа.ПравоДоступно("ПросмотрБюджетов");
	Элементы.УслугиПроверкаДокументаПоБюджету.Видимость = ПросмотрБюджетиа;
	
	НачальнаяДатаДокумента = Объект.Дата;
	
	ЭтоНовыйОбъект = Объект.Ссылка.Пустая();
	
	Если Параметры.Ключ.Пустая() Тогда
		
		Модифицированность = Истина;
		Если Не ЗначениеЗаполнено(НачальнаяДатаДокумента) Тогда
			НачальнаяДатаДокумента = ТекущаяДата();
		КонецЕсли;
		
		Если Объект.ВидОперации.Пустая() Тогда
			Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.CW_ВидыОперацийДоходыПоГрузоперевозке.ОказаниеУслуг");
		КонецЕсли;
		
		Если Не Объект.Корректировка 
			И Не Параметры.ЗначенияЗаполнения.Свойство("ВводНаОсновании") Тогда
			Объект.ЦенаСНДС = CW_Настройки.ПолучитьНастройкуПользователя(CW_Настройки.Пользователь(),"ВДокументахЦенаСНДС");
		КонецЕсли;
		
		Если ВестиУчетПоПодразделениям и Не ЗначениеЗаполнено(Объект.ПодразделениеОрганизации) Тогда
			Объект.ПодразделениеОрганизации 	= CW_Настройки.ПолучитьНастройкуПользователя(CW_Настройки.Пользователь(),"ПодразделениеПользователя");
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Объект.Договор) Тогда
			_ОбработатьИзменениеДоговора();
		КонецЕсли;
	КонецЕсли;
	
	НеЗаменятьПредставлениеНоменклатуры = CW_Настройки.ПолучитьНастройкуПользователя(CW_Настройки.Пользователь(),"НеЗаменятьПредставлениеПриИзмененииНоменклатурыДоходы");

	#Область Динамический_вывод_дополнительных_колонок
	
	_УФС.ОбновитьСписокДополнительныхКолонокФормы(ЭтаФорма, "CW_ДоходыПоГрузоперевозке");
	УстановитьВидимостьКнопкиОбновленияЗначений();
	
	#КонецОбласти
	
	ЗаполнитьСписокКодовОпераций();
	
	//Услуги по договру 
	ОграничиватьУслугиПоДоговорам = ПолучитьФункциональнуюОпцию("CW_ОграничиватьУслугиПоДоговорам");
	Если ОграничиватьУслугиПоДоговорам Тогда
		УстанавливатьЦенуВЗависимостиОтГруза 	= ПолучитьФункциональнуюОпцию("CW_УстанавливатьЦенуВЗависимостиОтГруза");
		НеОграничиватьУслугиПоПеревыставлению 	= Константы.CW_НеОграничиватьСписокУслугПриПеревыставленииЗатрат.Получить();
	КонецЕсли;   

	АдресУслугПоДоговору = "";
	УстановитьАдресСпискаУслугПоДоговору();
	
	//AFR-233578
	//ИспользуетсяОгранчиениеУслуг = ПолучитьОграничениеУслугПоНоменклатуре();
	//ОтключитьИсториюВыбораНоменклатуры(ИспользуетсяОгранчиениеУслуг);
	//AFR-233578
	
	//Подсистема.ДополнительныеРеквизиты
	ИспользоватьДопРеквизиты = CW_ДополнительныеРеквизитыСлужебный.ИспользуютсяДополниительныеРеквизиты();
	
	// СтандартныеПодсистемы.Свойства
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ИмяЭлементаДляРазмещения", "ГруппаДополнительныеРеквизиты");
	ДополнительныеПараметры.Вставить("ПроизвольныйОбъект", НЕ ИспользоватьДопРеквизиты); 
	УправлениеСвойствами.ПриСозданииНаСервере(ЭтотОбъект, ДополнительныеПараметры);
	// Конец СтандартныеПодсистемы.Свойства   
	
	// Конец Подсистема.ДополнительныеРеквизиты  
	
	Основание = _сф.ст_ПолучитьСвойство(Параметры,"Основание");
	Если Основание <> Неопределено Тогда
		
		СтрукутраДоговорПриложение = ПолучитьДоговорПриложениеОснования(Основание);
		СтрукутраДоговорПриложение.Свойство("Договор", 				Объект.Договор);
		СтрукутраДоговорПриложение.Свойство("ПриложениеКДоговору", 	Объект.ПриложениеКДоговору);
		
		Если (ТипЗнч(Основание)=Тип("СправочникСсылка.CW_Грузоперевозки")) Тогда
				
			Если ЗначениеЗаполнено(Объект.Контрагент) И ЗначениеЗаполнено(Объект.Организация) и НЕ ЗначениеЗаполнено(Объект.Договор) Тогда
					Объект.Договор = CW_Документы.ПолучитьПоследнийДоговор(Объект.Контрагент, Объект.Организация, Перечисления.ВидыДоговоровКонтрагентов.СПокупателем);
			КонецЕсли;
			Если (ЗначениеЗаполнено(Объект.Договор)) Тогда
				_ОбработатьИзменениеДоговора();
			КонецЕсли;	
				
			// добавляем строку
			Нстр = Объект.Услуги.Добавить();
			Нстр.Грузоперевозка = Основание;
		КонецЕсли; 
			
		Если (ТипЗнч(Основание)=Тип("СправочникСсылка.CW_Заказы")) Тогда
				
			Объект.Контрагент = Основание.Клиент;
			Если ЗначениеЗаполнено(Объект.Контрагент) И ЗначениеЗаполнено(Объект.Организация) и НЕ ЗначениеЗаполнено(Объект.Договор) Тогда
				Объект.Договор = CW_Документы.ПолучитьПоследнийДоговор(Объект.Контрагент, Объект.Организация, Перечисления.ВидыДоговоровКонтрагентов.СПокупателем);
			КонецЕсли; 
			Если (ЗначениеЗаполнено(Объект.Договор)) Тогда
				_СформироватьОбщиеПараметры();
				_ОбработатьИзменениеДоговора();
			КонецЕсли; 
				
			// добавляем строку
			МассивГП = CW_Мониторинг.ГрузоперевозкиЗаказа(Основание);
			Для каждого ГП Из МассивГП Цикл
				Нстр = Объект.Услуги.Добавить();
				Нстр.Грузоперевозка = ГП;
			КонецЦикла; 
			
		КонецЕсли; 	
		
	КонецЕсли; 
	
	// заполнение по бюджету
	АдресПараметровЗаполнения = _сф.ст_ПолучитьСвойство(Параметры,"АдресПараметровЗаполнения");
	Если (АдресПараметровЗаполнения <> Неопределено) Тогда
		
		СтруктураПараметровЗаполнения = ПолучитьИзВременногоХранилища(АдресПараметровЗаполнения);
		ЗаполнитьЗначенияСвойств(Объект,СтруктураПараметровЗаполнения,,"Услуги");
		
		СтруктураПараметров = CW_Настройки.ПустаяСтруктураПолученияПараметровДоговора();
		СтруктураПараметров.Дата 				= СтруктураПараметровЗаполнения.Дата;
		СтруктураПараметров.Договор 			= СтруктураПараметровЗаполнения.Договор;
		СтруктураПараметров.ПриложениеКДоговору = СтруктураПараметровЗаполнения.ПриложениеКДоговору;
		
		ПараметрыДоговора = CW_Настройки.ПолучитьПараметрыДоговора(СтруктураПараметров, "ОсновнойКодСпособаВыставленияСчетовФактур");
		Объект.КодСпособаВыставления = ПараметрыДоговора.ОсновнойКодСпособаВыставленияСчетовФактур;
		
		// --- 
		Для каждого Стр Из СтруктураПараметровЗаполнения.Услуги Цикл
			
			Нстр = Объект.Услуги.Добавить();
			ЗаполнитьЗначенияСвойств(Нстр,Стр);
			
		КонецЦикла; 
		
		//
		КомментарийЗаполнения = Неопределено;
		СтруктураПараметровЗаполнения.Свойство("КомментарийЗаполнения",КомментарийЗаполнения);
		
		ОбработатьИзменениеФлагаЦенаСНДС();    
		
		Если ЗначениеЗаполнено(Объект.Договор) Тогда
			_ОбработатьИзменениеДоговора();
		КонецЕсли;
		
	КонецЕсли; 
	
	
	ЗапрашиватьПодтверждениеПриУдаленииСтрок = CW_Настройки.ПолучитьНастройкуПользователя(CW_Настройки.Пользователь(),"ДоходыЗапрашиватьПодтверждениеПриУдаленииСтрок");
	
	ОтображатьКомментарийДоговора = CW_Настройки.ПолучитьНастройкуПользователя(CW_Настройки.Пользователь(),"ОтображатьКомментарийДоговораВФормеВводаДокументовПоБюджету");
	УстановитьЗаголовокНадписиКомментарияДоговора();
	
	_ИнициализацияФормы();
	_ОбновитьСтатусПометокУдаления();
	ОбработатьИзменениеСоставаЦены();
	
	УстановитьВерсиюПоставленияНДС1137();
	
	//Срок оплаты
	Если Не Параметры.Ключ.Пустая() Тогда
		ДанныеСрокаОплаты = CW_Документы.ПолучитьСрокОплаты(Параметры.Ключ);
		
		ДанныеСрокаОплаты.Свойство("ДатаОплаты",			_СрокОплаты);
		ДанныеСрокаОплаты.Свойство("Описание",				_СрокОплатыОписание);
		ДанныеСрокаОплаты.Свойство("РучноеРедактирование",	_СрокОплатыРучноеРедактирование);

		УстановитьОписаниеСрокаОплаты();	
	КонецЕсли;
	//Срок оплаты
	
	//Первичные документы
	ПервичныеДокументыПриСозданииНаСервере();
	ПервичныеДокументыУправлениеЭлементамиФормы();
	//Первичные документы
	
	//Подистема.CW_ПланированиеДДС
	CW_ПланированиеДДССервер.ПриСозданииНаСервере(ЭтаФорма, Отказ, СтандартнаяОбработка);
	//Подистема.CW_ПланированиеДДС
	
	//Подсистема.СтатусыДокументов
	CW_СтатусыДокументовСервер.ПриСозданииНаСервере(ЭтаФорма,Отказ, СтандартнаяОбработка);
	//Подсистема.СтатусыДокументов
	
	//Подсистема.ОригиналыДокументов
	CW_ОригиналыДокументовСервер.ПриСозданииНаСервере(ЭтаФорма, Отказ, СтандартнаяОбработка);
	//Подсистема.ОригиналыДокументов
	
	//Подсистема.УчетПриложенийДоговоров
	CW_УчетПриложенийДоговоровСервер.ПриСозданииНаСервере(ЭтаФорма, Отказ, СтандартнаяОбработка);
	//Подсистема.УчетПриложенийДоговоров
	
	//Наличие прикрепленных файлов
	_УФКС.УстановитьНаличиеПрикрепленныхФайловПриСозданииФормыНаСервере(ЭтаФорма);
	//Наличие прикрепленных файлов
	
	//Подсистема.УчетНЗП
	УстановитьОтборДинамическогоСпискаРасходы();
	//Подсистема.УчетНЗП   
	
	//Подсистема.ЭДО
	УстановитьВидимостьКомандЭДО();
	//Подсистема.ЭДО     
	
	//Внешние подклчюаемые команды
	CW_ПодключаемыеКомандыСервер.ПриСозданииНаСервере(ЭтотОбъект);
	
	#Область Динамический_вывод_дополнительных_колонок
	
	//Обновляем динамические колонки параметров ГП
	Если Объект.Услуги.Количество() > 0 Тогда
		_УФС.ОбновитьЗначенияПараметровГрузоперевозок(ПолучитьСтруктуруПараметровДляПередачи());
	КонецЕсли;
	
	#КонецОбласти
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВерсиюПоставленияНДС1137()
	
	ДатаДляПостановления = ?(Объект.ФормируетсяСчетФактура, Объект.ДатаСчетаФактуры, Объект.Дата);  
	ДатаДляПостановления = ?(ДатаДляПостановления = Дата(1,1,1), Объект.Дата, 	ДатаДляПостановления);  
	ДатаДляПостановления = ?(ДатаДляПостановления = Дата(1,1,1), ТекущаяДата(), ДатаДляПостановления);  
	
	ВерсияПостановленияНДС1137 = CW_БухгалтерияЭкспедитораСерверПереопределяемый.ВерсияПостановленияНДС1137(ДатаДляПостановления);

КонецПроцедуры

&НаСервере
Процедура ОтключитьИсториюВыбораНоменклатуры(ЕстьОграниченияПоСпискуУслуг)
	
	Если ЕстьОграниченияПоСпискуУслуг Тогда 
		Элементы.УслугиНоменклатура.ИсторияВыбораПриВводе = ИсторияВыбораПриВводе.НеИспользовать;
	Иначе
		Элементы.УслугиНоменклатура.ИсторияВыбораПриВводе = ИсторияВыбораПриВводе.Авто;
	КонецЕсли;

КонецПроцедуры 

&НаСервере
Процедура УстановитьВидимостьКомандЭДО()       
	
	СтруктураВидимости = ПроверитьПодключениеКЭДО();
	
	Если Не РольДоступна("ПолныеПрава") Тогда 
		Возврат;
	КонецЕсли;
	
	Элементы.ОбщаяКомандаAF_ЭДО_ПросмотретьЭлектронныйДокументСФКорректировочный.Видимость 	= СтруктураВидимости.СчетФактураКорр;
	Элементы.ОбщаяКомандаAF_ЭДО_ПросмотретьЭлектронныйДокументАктКорректировочный.Видимость = СтруктураВидимости.АктКорр; 
	
	Элементы.ОбщаяКомандаAF_ЭДО_ПросмотретьЭлектронныйДокументСФ.Видимость		= СтруктураВидимости.СчетФактура;
	Элементы.ОбщаяКомандаAF_ЭДО_ПросмотретьЭлектронныйДокументАкт.Видимость 	= СтруктураВидимости.Акт;
	Элементы.ОбщаяКомандаAF_ЭДО_ПросмотретьЭлектронныйДокументСчет.Видимость 	= СтруктураВидимости.Счет;

	Элементы.ОбщаяКомандаCW_ДобавитьФайлВПакетСчет.Видимость				= СтруктураВидимости.ДобавитьФайлСчет;
	Элементы.ОбщаяКомандаCW_ДобавитьФайлВПакетАкт.Видимость 				= СтруктураВидимости.ДобавитьФайлАкт;
	Элементы.ОбщаяКомандаCW_ДобавитьФайлВПакетСФ.Видимость 					= СтруктураВидимости.ДобавитьФайлСчетФактура;
	Элементы.ОбщаяКомандаCW_ДобавитьФайлВПакетСФКорректировка.Видимость		= СтруктураВидимости.ДобавитьФайлСчетФактураКорр;
	Элементы.ОбщаяКомандаCW_ДобавитьФайлВПакетАктКорректировка.Видимость	= СтруктураВидимости.ДобавитьФайлАктКорр;

	
КонецПроцедуры

&НаСервере
Функция ПроверитьПодключениеКЭДО() 
	
	СтруктураВидимости 	= Новый Структура("СчетФактураКорр,АктКорр,СчетФактура,Акт,Счет,ДобавитьФайлСчет,ДобавитьФайлАкт,ДобавитьФайлСчетФактура,ДобавитьФайлСчетФактураКорр,ДобавитьФайлАктКорр",
			Ложь, Ложь, Ложь, Ложь, Ложь, Ложь, Ложь, Ложь, Ложь, Ложь);	
	
	ИспользуетсяЭДО 	= НастройкиЭДО.ИспользуетсяОбменЭлектроннымиДокументами(); 
	Если Не ИспользуетсяЭДО Тогда
		Возврат СтруктураВидимости;
	КонецЕсли;   
	
	ЕстьПравоЧтенияДокументов = ИнтерфейсДокументовЭДОВызовСервера.ЕстьПравоЧтенияДокументов();
	Если Не ЕстьПравоЧтенияДокументов Тогда
		Возврат СтруктураВидимости;
	КонецЕсли;   

	CW_ЭДОВызовСервера.ЗаполнитьВидимостьДобавленияФайловЭДО(Объект.Ссылка, СтруктураВидимости);
	
	Если Объект.Корректировка Тогда
		Если Объект.ФормируетсяАкт Тогда
			ДанныеСостоянияЭДО 	= ИнтеграцияЭДОВызовСервера.ДанныеСостоянияЭДОДляФормыОбъектаУчета(Объект.ВедомыйДокументКорректировки);   
			СтруктураВидимости.Вставить("АктКорр", ДанныеСостоянияЭДО.ИспользуетсяОбменЭлектроннымиДокументами и НЕ ДанныеСостоянияЭДО.НеобходимаНастройка);
		КонецЕсли;
		Если Объект.ФормируетсяСчетФактура Тогда
			ДанныеСостоянияЭДО 	= ИнтеграцияЭДОВызовСервера.ДанныеСостоянияЭДОДляФормыОбъектаУчета(Объект.ВедомыйСчетФактураКорректировочный); 
			СтруктураВидимости.Вставить("СчетФактураКорр", ДанныеСостоянияЭДО.ИспользуетсяОбменЭлектроннымиДокументами и НЕ ДанныеСостоянияЭДО.НеобходимаНастройка);
		КонецЕсли;
	Иначе
		Если Объект.ФормируетсяСчет Тогда
			ДанныеСостоянияЭДО 	= ИнтеграцияЭДОВызовСервера.ДанныеСостоянияЭДОДляФормыОбъектаУчета(Объект.ВедомыйСчет); 
			СтруктураВидимости.Вставить("Счет", ДанныеСостоянияЭДО.ИспользуетсяОбменЭлектроннымиДокументами и НЕ ДанныеСостоянияЭДО.НеобходимаНастройка);
		КонецЕсли;
		Если Объект.ФормируетсяАкт Тогда
			ДанныеСостоянияЭДО 	= ИнтеграцияЭДОВызовСервера.ДанныеСостоянияЭДОДляФормыОбъектаУчета(Объект.ВедомыйДокумент);   
			СтруктураВидимости.Вставить("Акт", ДанныеСостоянияЭДО.ИспользуетсяОбменЭлектроннымиДокументами и НЕ ДанныеСостоянияЭДО.НеобходимаНастройка);
		КонецЕсли;
		Если Объект.ФормируетсяСчетФактура Тогда
			ДанныеСостоянияЭДО 	= ИнтеграцияЭДОВызовСервера.ДанныеСостоянияЭДОДляФормыОбъектаУчета(Объект.ВедомыйСчетФактура); 
			СтруктураВидимости.Вставить("СчетФактура", ДанныеСостоянияЭДО.ИспользуетсяОбменЭлектроннымиДокументами и НЕ ДанныеСостоянияЭДО.НеобходимаНастройка);
		КонецЕсли;
	КонецЕсли;     
	
	Возврат СтруктураВидимости;
	
КонецФункции 


&НаСервере
Функция  ПолучитьДоговорПриложениеОснования(ИсточникДоговора)
	
	ПараметрДоговор 	= Константы.CW_ПараметрДоговораПлательщика.Получить();
	ПараметрПриложение 	= Константы.CW_ПараметрПриложенияДоговора.Получить();
	
	Если Не ЗначениеЗаполнено(ПараметрДоговор) Тогда
		///Приложение не проверяем, так как без договора он не имеет смысла
		Возврат Новый Структура;
	Конецесли;
	
	Если ТипЗнч(ИсточникДоговора) = Тип("СправочникСсылка.CW_Грузоперевозки") Тогда
		НайденныйДоговор = ПолучитьПараметрГрузоперевозки(ИсточникДоговора, ПараметрДоговор);
		Если ТипЗнч(НайденныйДоговор) <> тип("СправочникСсылка.CW_ДоговорыПоГрузоперевозкам") Тогда
			НайденныйДоговор = Неопределено;
		КонецЕсли;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(НайденныйДоговор) Тогда
		НайденныйДоговор = ПолучитьПараметрЗаказа(ИсточникДоговора, ПараметрДоговор);
		Если ТипЗнч(НайденныйДоговор) <> тип("СправочникСсылка.CW_ДоговорыПоГрузоперевозкам") Тогда
			НайденныйДоговор = Неопределено;
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(НайденныйДоговор) Тогда
		Если НайденныйДоговор.ИспользуютсяПриложения Тогда
			НайденноеПриложение = ПолучитьПараметрГрузоперевозки(ИсточникДоговора, ПараметрПриложение);
			Если ТипЗнч(НайденноеПриложение) <> тип("СправочникСсылка.CW_ПриложенияКДоговорам") Тогда
				НайденноеПриложение = Неопределено;
			КонецЕсли;
			
			Если Не ЗначениеЗаполнено(НайденноеПриложение) тогда
				НайденноеПриложение = ПолучитьПараметрЗаказа(ИсточникДоговора, ПараметрПриложение);
			КонецЕсли;
			
			Если ТипЗнч(НайденноеПриложение) = тип("СправочникСсылка.CW_ПриложенияКДоговорам") Тогда
				Если НайденноеПриложение.Договор <> НайденныйДоговор Тогда
					НайденноеПриложение = Неопределено;
				КонецЕсли;
			Иначе 
				НайденноеПриложение = Неопределено;
			КонецЕсли;
		Конецесли;
	КонецЕсли;
	
	Струкутра = Новый Структура;
	Струкутра.Вставить("Договор", 				НайденныйДоговор);
	Струкутра.Вставить("ПриложениеКДоговору", 	НайденноеПриложение);
	
	Возврат Струкутра;
	
КонецФункции

&НаСервере
Функция ПолучитьПараметрГрузоперевозки(ИсточникДоговора, Параметр)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ПараметрыГрузоперевозок.Значение КАК Значение
	|ИЗ
	|	РегистрСведений.CW_ХарактеристикиГрузоперевозок КАК ПараметрыГрузоперевозок
	|ГДЕ
	|	ПараметрыГрузоперевозок.Грузоперевозка = &ИсточникДоговора
	|	И ПараметрыГрузоперевозок.Параметр = &Параметр";
	
	Запрос.УстановитьПараметр("ИсточникДоговора", 	ИсточникДоговора);
	Запрос.УстановитьПараметр("Параметр",  			Параметр);
	
	РезультатЗапроса = запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Значение;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

&НаСервере
Функция ПолучитьПараметрЗаказа(ИсточникДоговора, Параметр)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ПараметрыЗаказов.Значение КАК Значение
	|ИЗ
	|	РегистрСведений.CW_ХарактеристикиЗаказов КАК ПараметрыЗаказов
	|ГДЕ
	|	ПараметрыЗаказов.Заказ = &ИсточникДоговора
	|	И ПараметрыЗаказов.Параметр = &ПараметрДоговор";
	
	Запрос.УстановитьПараметр("ИсточникДоговора", 	ИсточникДоговора);
	Запрос.УстановитьПараметр("ПараметрДоговор", 	Параметр);
	
	РезультатЗапроса = запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Значение;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции


&НаСервере
Процедура _УстановитьПараметрыФункциональныхОпцийФормы()
	
	ПараметрыФункциональныхОпций = Новый Структура;
	ПараметрыФункциональныхОпций.Вставить("CW_Пользователь", CW_Настройки.Пользователь());
	ПараметрыФункциональныхОпций.Вставить("CW_Организация",	 Объект.Организация);
	
	УстановитьПараметрыФункциональныхОпцийФормы(ПараметрыФункциональныхОпций);
	
КонецПроцедуры


&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	
	Если (ЗначениеЗаполнено(КомментарийЗаполнения)) Тогда
		
		Сообщить(КомментарийЗаполнения);		
		
	КонецЕсли;
	
	// проверим на копирование
	Если ЗначениеЗаполнено(Копия) Тогда
		// проверим грузоперевозки
		
		Блок = _ПроверитьБлок();
		Если (Блок) Тогда    
			Объект.Услуги.Очистить();
			_УФК.ВывестиПредупреждение("Документ содержит блокированые грузоперевозки." + Символы.ПС + "Табличная часть очищена.");
			УстановитьДоступность(); 
		КонецЕсли;	
		
		ОбновитьИтогиПоУслугам();
		ОбновитьИтогиПоАвансам();
		
	КонецЕсли;	
	
	// вид операции
	Если (Объект.Ссылка.Пустая() И Объект.ВидОперации.Пустая()) Тогда
		Если (НЕ Объект.Корректировка) Тогда
			УстановитьВидОперации(Неопределено);	
		КонецЕсли; 
	КонецЕсли; 
	
	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствамиКлиент.ПослеЗагрузкиДополнительныхРеквизитов(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.Свойства    
	
	//Подсистема.CW_ЭлектронныйОбменДанными
	Если ЗначениеЗаполнено(Объект.Контрагент) 
		и Не Объект.Корректировка Тогда
		ПроверитьКонтрагентаПоБазеЛКК();
	КонецЕсли;
	//Подсистема.CW_ЭлектронныйОбменДанными
	
	
	//Подсчистема.CW_РеестрыНДС0   
	Если CW_ВерсииПодсистемСервер.СуществуетПодсистема("CW_БухгалтерияЭкспедитораДляРоссии.CW_РеестрыНДС0") Тогда 
		ПодключитьОбработчикОжидания("ПоказатьРекламныйБаннерВДокументе", 0.1, Истина); 
	КонецЕсли;
	//Подсчистема.CW_РеестрыНДС0
	
	
КонецПроцедуры  

&НаКлиенте
Процедура УстановитьДоступность()  
	
	ЭтаФорма.ТолькоПросмотр = Ложь;
	Элементы.ГруппаИнфо.Видимость = Ложь;
	Элементы.ПолучитьНомер.Доступность = Истина;
	Элементы.ФормаУстановитьВидОперации.Доступность = Истина;
	Элементы.ФормаОбщаяКомандаCW_ИнформацияПоЗакрытиюГрузоперевозок.Видимость = Истина;
	Элементы.УслугиИзменить.Доступность = Истина;
	Элементы.УслугиУслуги_ПереформироватьПредставление.Доступность = Истина;
	Элементы.УслугиГруппаЗаполнить.Видимость = Истина;
	// --- 
	Элементы.ЗачетАвансовЗаполнитьАвансы.Доступность=Истина;
	Элементы.ЗачетАвансовЗаполнитьАвансы1.Доступность=Истина;
	Элементы.ЗачетАвансов.ТолькоПросмотр = Ложь;
	Элементы.ЗачетАвансовОЗ.ТолькоПросмотр = Ложь;
	Элементы.ЗачетАвансовЗачетАвансов_Очистить.Доступность=Истина;
	Элементы.ЗачетАвансовОЗЗачетАвансовОЗ_Очистить.Доступность=Истина;
	Элементы.ЗачетАвансовОЗЗачетАвансовОЗ_Открыть.Доступность = Истина;
	Элементы.ЗачетАвансовЗачетАвансов_Открыть.Доступность = Истина;
	
	Элементы.НадписьДокументыОбОтгрузке.Доступность = Истина;
	
	Элементы.Заявки.ТолькоПросмотр = Истина;
	Элементы.СоздатьЗаявку.Доступность = Истина;
	
КонецПроцедуры  

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)  
	
	Если Объект.Ссылка.Пустая() Тогда
		РедактированиеАктированныхСчетов = CW_ПраваДоступа.ПравоДоступно("РазрешитьРедактированиеИсходящихАктированныхСчетов");
		Если Объект.ФормируетсяАкт и Объект.ФормируетсяСчет и Не РедактированиеАктированныхСчетов Тогда
			ПоказатьПредупреждение(, "Недостаточно прав для записи пакетного документа!");
			Отказ = истина;
			Возврат ;
		КонецЕсли;
	КонецЕсли;
	
	ЭтоСмешанный 	= ПолучитьЭтоСмешанный(Объект.ВедомыйСчетФактура);
	СистемаНалогообложения 	= ПолучитьСистемуНалогообложения(Объект.Организация, Объект.Дата);
	Если ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Проведение 
		И СистемаНалогообложения = ПредопределенноеЗначение("Перечисление.СистемыНалогообложения.Общая")
		И ЭтоСмешанный 
		И Объект.ФормируетсяСчетФактура Тогда
		 ПоказатьПредупреждение(, "По документу оформлена смешанная с\ф. Проверьте корректность отражения записей по документу в книге покупок и журнале учета счет-фактур!");
	КонецЕсли;

КонецПроцедуры  

&НаСервере
Функция ПолучитьЭтоСмешанный(ВедомыйСчетФактура)
	
	УслугиПорядокОтражения = Объект.Услуги.Выгрузить(,"ПорядокОтражения"); 
	УслугиПорядокОтражения.Свернуть("ПорядокОтражения",);
	
	Возврат УслугиПорядокОтражения.Количество() > 1;
	
КонецФункции


&НаСервереБезКонтекста
Функция ПолучитьСистемуНалогообложения(Организация, Знач НаДату= Неопределено)
	
	НаДату = ?(НаДату=Неопределено, ТекущаяДата(), НаДату);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	НастройкиСистемыНалогообложенияСрезПоследних.Организация КАК Организация,
	               |	НастройкиСистемыНалогообложенияСрезПоследних.СистемаНалогообложения КАК СистемаНалогообложения
	               |ИЗ
	               |	РегистрСведений.НастройкиСистемыНалогообложения.СрезПоследних(&НаДату, Организация = &Организация) КАК НастройкиСистемыНалогообложенияСрезПоследних"; 
	
	Запрос.УстановитьПараметр("НаДату", НаДату);
	Запрос.УстановитьПараметр("Организация", Организация);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.СистемаНалогообложения;	
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции


&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)

	CW_Документы.ПередЗаписьюНаСервере(ЭтотОбъект, Отказ);

	//Подсистема.ГруппыУслугПриложенийИДоговоров
	CW_ГруппыУслугСервер.ПередЗаписьюНаСервере(ЭтаФорма, Отказ, ТекущийОбъект, ПараметрыЗаписи);
	//Подсистема.ГруппыУслугПриложенийИДоговоров
	
	//Подсистема.СтатусыДокументов
	CW_СтатусыДокументовСервер.ПередЗаписьюНаСервере(ЭтаФорма, Отказ, ТекущийОбъект, ПараметрыЗаписи);
	//Подсистема.СтатусыДокументов

	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствами.ПередЗаписьюНаСервере(ЭтотОбъект, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.Свойства

	//Подсистема.ОригиналыДокументов
	CW_ОригиналыДокументовСервер.ПередЗаписьюНаСервере(ЭтаФорма, ТекущийОбъект, ПараметрыЗаписи);
	//Подсистема.ОригиналыДокументов
	
	// для новых сохраняем срок оплаты
	ЭтоНовый = Объект.Ссылка.Пустая();
	
	// признак интерактивного режима
	_сф.ст_УстановитьСвойство(ТекущийОбъект.ДополнительныеСвойства,"ИнтерактивныйРежим",Истина);
	
	// тут перенесём доп. свойства в дополнительные свойства объекта
	_сф.ст_ДобавитьСвойства(ТекущийОбъект.ДополнительныеСвойства,"*",_ДС());
	ТекущийОбъект.ДС = ТекущийОбъект.ДополнительныеСвойства;
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	_ОбновитьНомераДокументов();
	_СформироватьЗаголовок();
	СостояниеДокумента 		= ОбщегоНазначенияБП.СостояниеДокумента(Объект); // ВызовБП
	
	//Подистема.CW_ПланированиеДДС
	CW_ПланированиеДДССервер.ПослеЗаписиНаСервере(ЭтаФорма,ТекущийОбъект, ПараметрыЗаписи); 
	//Подистема.CW_ПланированиеДДС
	
	//Подсистема.СтатусыДокументов
	CW_СтатусыДокументовСервер.ПослеЗаписиНаСервере(ЭтаФорма, ТекущийОбъект, ПараметрыЗаписи);
	//Подсистема.СтатусыДокументов
	
	//Подсистема.ОригиналыДокументов
	CW_ОригиналыДокументовСервер.ПослеЗаписиНаСервере(ЭтаФорма, ТекущийОбъект, ПараметрыЗаписи);
	//Подсистема.ОригиналыДокументов
	
	//Подсистема.УчетНЗП
	УстановитьОтборДинамическогоСпискаРасходы();
	//Подсистема.УчетНЗП   
	
	//Взаиморасчеты по документу
	CW_ВзаиморасчетыПоДокументуСервер.УстановитьНазваниеСсылкиОтчета(ЭтаФорма, Объект.ФормируетсяСчет);
	//Взаиморасчеты по документу   

	//Данные первичных документов
	CW_Документы.ЗаписатьДанныеПервичногоДокумента(Объект);
	//Данные первичных документов
	
	//СрокОплаты
	Если ЭтоНовыйОбъект Тогда
		Если Не _СрокОплатыРучноеРедактирование Тогда
			УстановитьСрокОплатыНаСервере();
		Иначе
			ЗаписатьСрокОплатыДокумента();
			УстановитьОписаниеСрокаОплаты();             
		КонецЕсли;
	КонецЕсли;
	//СрокОплаты    
	
	
	Если Объект.Проведен 
		и Не Объект.Корректировка 
		И Объект.Валюта = ВалютаРегламентированногоУчета Тогда
		
		Если ЗначениеЗаполнено(Объект.ПриложениеКДоговору) Тогда
			ВедетсяБухгалтерскийУчет = Объект.ПриложениеКДоговору.БухгалтерскийУчет;	
		Иначе
			ВедетсяБухгалтерскийУчет = Объект.Договор.БухгалтерскийУчет;	
		КонецЕсли;
		
		Если ВедетсяБухгалтерскийУчет И Объект.ФормируетсяАкт и Объект.ФормируетсяСчетФактура Тогда  
			CW_БухгалтерияЭкспедитораСервер.СоздатьДокументыСчетФактураВыданныйСВидомНалоговыйАгент(Объект);
		КонецЕсли;
		
	КонецЕсли;
	
	НачальнаяДатаДокумента 	= Объект.Дата;
	_ОбновитьНадписиКорректировок();
	
	_УФС.ОбновитьЗначенияПараметровГрузоперевозок(ПолучитьСтруктуруПараметровДляПередачи());
	
	ЭтоНовыйОбъект = Ложь;	
	
КонецПроцедуры  

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	//Подсистема.РаботаСПодключаемымиОбъектами
	CW_ПодключаемыеКомандыКлиент.ПослеЗаписи(ЭтотОбъект, ПараметрыЗаписи);
	//Подсистема.РаботаСПодключаемымиОбъектами

	//Подсчистема.CW_РеестрыНДС0   
	Если CW_ВерсииПодсистемСервер.СуществуетПодсистема("CW_БухгалтерияЭкспедитораДляРоссии.CW_РеестрыНДС0") Тогда 
		ПодключитьОбработчикОжидания("ПоказатьРекламныйБаннерВДокументе", 0.1, Истина);
	КонецЕсли;
	//Подсчистема.CW_РеестрыНДС0
	
	//Срок оплаты
	ДанныеСрокаОплаты = CW_Документы.ПолучитьСрокОплаты(Объект.Ссылка);
	ДанныеСрокаОплаты.Свойство("ДатаОплаты",			_СрокОплаты);
	ДанныеСрокаОплаты.Свойство("Описание",				_СрокОплатыОписание);
	ДанныеСрокаОплаты.Свойство("РучноеРедактирование",	_СрокОплатыРучноеРедактирование);
	
	УстановитьОписаниеСрокаОплаты();
	//Срок оплаты
	
	// регенерируем форму
	_УправлениеЭлементамиФормы();
	
	// --- 
	Если (НЕ Объект.Корректировка) Тогда
		
		Если (ЗначениеЗаполнено(Объект.ВедомыйСчет)) Тогда
			ОповеститьОбИзменении(Объект.ВедомыйСчет);
		КонецЕсли;
		Если (ЗначениеЗаполнено(Объект.ВедомыйДокумент)) Тогда
			ОповеститьОбИзменении(Объект.ВедомыйДокумент);
		КонецЕсли; 
		Если (ЗначениеЗаполнено(Объект.ВедомыйСчетФактура)) Тогда
			ОповеститьОбИзменении(Объект.ВедомыйСчетФактура);
		КонецЕсли; 
		
	Иначе
		
		Если (ЗначениеЗаполнено(Объект.ВедомыйСчетКорректировочный)) Тогда
			ОповеститьОбИзменении(Объект.ВедомыйСчетКорректировочный);
		КонецЕсли; 
		Если (ЗначениеЗаполнено(Объект.ВедомыйДокументКорректировки)) Тогда
			ОповеститьОбИзменении(Объект.ВедомыйДокументКорректировки);
		КонецЕсли; 
		Если (ЗначениеЗаполнено(Объект.ВедомыйСчетФактураКорректировочный)) Тогда
			ОповеститьОбИзменении(Объект.ВедомыйСчетФактураКорректировочный);
		КонецЕсли;
		
	КонецЕсли; 	
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	// СтандартныеПодсистемы.Свойства
	Если УправлениеСвойствамиКлиент.ОбрабатыватьОповещения(ЭтотОбъект, ИмяСобытия, Параметр) Тогда
		ОбновитьЭлементыДополнительныхРеквизитов();
		УправлениеСвойствамиКлиент.ПослеЗагрузкиДополнительныхРеквизитов(ЭтотОбъект);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.Свойства
	
	Если (ИмяСобытия = "ВыполненаЗаписьДокумента") Тогда
		
		Прочитать();
		_УправлениеЭлементамиФормы();
		
	ИначеЕсли ИмяСобытия = "ОбновитьСписокУслугПоПротоколу" Тогда
		
		УстановитьАдресСпискаУслугПоДоговору();
		
	ИначеЕсли ИмяСобытия = "ВыполнитьМетодВладельца" Тогда
		
		Если ТипЗнч(Параметр) = тип("Структура") Тогда
			УникальныйИдентификаторВладельца 	= Неопределено;
			МетодыФормыВладельца 				= Неопределено;
			
			Параметр.Свойство("УникальныйИдентификатор"	, УникальныйИдентификаторВладельца);
			Параметр.Свойство("МетодыФормыВладельца"	, МетодыФормыВладельца);
			
			Если ЭтаФорма.УникальныйИдентификатор = УникальныйИдентификаторВладельца Тогда
				Если Не МетодыФормыВладельца = Неопределено и ТипЗнч(МетодыФормыВладельца) = Тип("Массив") Тогда
					
					Для Каждого СтрокаМассива из МетодыФормыВладельца Цикл
						Попытка
							Выполнить(СтрокаМассива);
						Исключение
						КонецПопытки;
					КонецЦикла;
					
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;	
		
	ИначеЕсли ИмяСобытия = "ОбновитьКоментарийДоговораНаФрме" Тогда
		
		УстановитьЗаголовокНадписиКомментарияДоговора();
		
	ИначеЕсли ИмяСобытия = "ОбновитьАдресУслугДоговора" Тогда
		
		ОбработатьОповещениеИзмененияСпискаУслуг();
		
	ИначеЕсли ИмяСобытия = "Запись_CW_Грузоперевозки" Тогда
		
		#Область Динамический_вывод_дополнительных_колонок
		
		ОбновитьЗначенияПараметровГрузоперевозокнаСервере();
		
		#КонецОбласти
		
		//Подистема.CW_ПланированиеДДС
	ИначеЕсли ИмяСобытия = "Запись_CW_ПланированиеДДС" Тогда
		
		ОбновитьЗаголовокСтраницы()
		//Подистема.CW_ПланированиеДДС
		
		//Наличие прикрепленных файлов
	ИначеЕсли ИмяСобытия = "ОбновитьНаличиеПрикрепленныхФайлов" Тогда
		
		ОбработатьОповещениеОбновитьНаличиеПрикрепленныхФайлов();
		//Наличие прикрепленных файлов
		
		УстановитьВидимостьКомандЭДО();
	
		//Подсистема.СтатусыДокументов
	ИначеЕсли ИмяСобытия = "Изменение_СтатусДокумента" Тогда
		
		ОбработатьОповещениеИзменениеСтатусДокументаНаСервере();
		//Подсистема.СтатусыДокументов     
		
	ИначеЕсли ИмяСобытия = "ПодключенСервисРеестрНДС0" Тогда
		
		ПодключитьОбработчикОжидания("ПоказатьРекламныйБаннерВДокументе", 0.1, Истина);
		
	ИначеЕсли ИмяСобытия = "ОбновитьСостояниеЭД" Тогда
		
		УстановитьВидимостьКомандЭДО();
		
	КонецЕсли;
	
КонецПроцедуры

//Наличие прикрепленных файлов
&НаСервере
