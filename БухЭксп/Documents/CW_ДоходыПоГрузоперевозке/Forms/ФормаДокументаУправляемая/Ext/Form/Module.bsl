&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	_ОбновитьСтатусПометокУдаления();
	СостояниеДокумента = ОбщегоНазначенияБП.СостояниеДокумента(Объект); // ВызовБП
	
	Если ИспользоватьДопРеквизиты Тогда
		// СтандартныеПодсистемы.Свойства
		УправлениеСвойствами.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
		// Конец СтандартныеПодсистемы.Свойства
	КонецЕсли;

	//ДатыЗапретаИзменения
	//Проверяем дату запрета по документам БУ
	мОбъектыПроверки = ПолучитьМассивОбъектовДляПроверки();
	Для Каждого ЭлементМассива из мОбъектыПроверки Цикл
		//Есть ведомые документы, проверяем дату запрета редактирования БП
		ОбъектМассива = ЭлементМассива.ПолучитьОбъект();
		Разрешено = ДатыЗапретаИзменения.ОбъектПриЧтенииНаСервере(ЭтотОбъект, ОбъектМассива);
		Если не Разрешено Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	//ДатыЗапретаИзменения
	
КонецПроцедуры

&НаСервере
Функция ПолучитьМассивОбъектовДляПроверки()
	
	Результат = Новый Массив;
	
	Если ЗначениеЗаполнено(Объект.ВедомыйДокумент) Тогда
		Результат.Добавить(Объект.ВедомыйДокумент);
	КонецЕсли;
	Если ЗначениеЗаполнено(Объект.ВедомыйСчетФактура) Тогда
		Результат.Добавить(Объект.ВедомыйСчетФактура);
	КонецЕсли;
	Если ЗначениеЗаполнено(Объект.ВедомыйСчет) Тогда
		Результат.Добавить(Объект.ВедомыйСчет);
	КонецЕсли;
	Если ЗначениеЗаполнено(Объект.ВедомыйДокументКорректировки) Тогда
		Результат.Добавить(Объект.ВедомыйДокументКорректировки);
	КонецЕсли;
	Если ЗначениеЗаполнено(Объект.ВедомыйСчетФактураКорректировочный) Тогда
		Результат.Добавить(Объект.ВедомыйСчетФактураКорректировочный);
	КонецЕсли;
	Если ЗначениеЗаполнено(Объект.ВедомыйСчетКорректировочный) Тогда
		Результат.Добавить(Объект.ВедомыйСчетКорректировочный);
	КонецЕсли;

	
	Возврат Результат; 
	
КонецФункции


&НаСервере
Процедура УстановитьАдресСпискаУслугПоДоговору()
	
	АдресУслугПоДоговору = "";
	Если ОграничиватьУслугиПоДоговорам и ЗначениеЗаполнено(Объект.Договор) Тогда
		//Услуги по договру
		ЕстьОграниченияПоСпискуУслуг =?(ЗначениеЗаполнено(Объект.Договор), Объект.Договор.ОграничиватьНоменклатуру, Ложь);
		Если ЕстьОграниченияПоСпискуУслуг Тогда    
			
			ДатаДокумента = Объект.Дата;
			Если Объект.ФормируетсяАкт 
				и ЗначениеЗаполнено(Объект.ДатаАкта) Тогда
				ДатаДокумента = Объект.ДатаАкта;  
			ИначеЕсли Объект.ФормируетсяСчет 
				и ЗначениеЗаполнено(Объект.ДатаСчета) Тогда
				ДатаДокумента = Объект.ДатаСчета;  
			КонецЕсли; 
			
			АдресУслугПоДоговору = _УФС.ОбновитьСписокУслугПоДоговору(ДатаДокумента, Объект.Договор, ЭтаФорма);   
			
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&наСервере
Процедура УстановитьЗаголовокНадписиКомментарияДоговора()
	
	КомментарийДоговора = ?(Объект.Договор.Пустая(),"", СокрЛП(Объект.Договор.Комментарий));
	
	Элементы.НадписьКомментарийДоговора.Видимость = ОтображатьКомментарийДоговора и ЗначениеЗаполнено(КомментарийДоговора);
	Элементы.НадписьКомментарийДоговора.Заголовок = КомментарийДоговора;
	
КонецПроцедуры

#КонецОбласти 

// ---------------------------------------------------------------------------- 

#Область ИнициализацияФормы 

&НаСервере
Процедура _ИнициализацияФормы()
	// --- 
	
	//_СформироватьЗаголовок();
	// --- 
	_СформироватьОбщиеПараметры();
	// --- 
	_ПроверитьРежимВводаОстатков();
	// --- 
	//_УправлениеЭлементамиФормы();
	// --- 
	_СформироватьКурс();
	// --- 
	_ОбновитьНомераДокументов();
	
	// --- 
	
	Если (Объект.Ссылка.Пустая()) Тогда
		
		Объект.Ответственный = Неопределено;
		
	КонецЕсли; 
	
	Если (Объект.ВидОперации.Пустая()) Тогда
		Если (Объект.Корректировка) Тогда
			Объект.ВидОперации = Объект.КорректируемыйДокумент.ВидОперации;			
		КонецЕсли; 
	КонецЕсли; 
	
	// --- 
	
	// обновление таблицы актов
	Если НЕ Объект.Ссылка.Пустая() И (НЕ Объект.ФормируетсяАкт И НЕ Объект.ФормируетсяСчетФактура) И НЕ ВводОстатковОЗ И НЕ Объект.Корректировка Тогда
		_ОбновитьАкты();
	КонецЕсли; 
	
	// проверяем на закрытие
	Если (НЕ РеквизитФормыВЗначение("Объект").ПроверитьЗакрытиеГрузоперевозок() И НЕ Объект.Корректировка) Тогда
		
		ЭтаФорма.ТолькоПросмотр = Истина;
		Элементы.ГруппаИнфо.Видимость = Истина;
		Элементы.ДекорацияИнфо.Заголовок = "Документ доступен только для просмотра, т.к. содержит блокированные грузоперевозки!";
		Элементы.ПолучитьНомер.Доступность = Ложь;
		Элементы.ФормаУстановитьВидОперации.Доступность = Ложь;
		Элементы.ФормаОбщаяКомандаCW_ИнформацияПоЗакрытиюГрузоперевозок.Видимость = Ложь;
		Элементы.УслугиИзменить.Доступность = Ложь;
		Элементы.УслугиУслуги_ПереформироватьПредставление.Доступность = Ложь;
		Элементы.УслугиГруппаЗаполнить.Видимость = Ложь;
		// --- 
		Элементы.ЗачетАвансовЗаполнитьАвансы.Доступность=Ложь;
		Элементы.ЗачетАвансовЗаполнитьАвансы1.Доступность=Ложь;
		Элементы.ЗачетАвансов.ТолькоПросмотр = Истина;
		Элементы.ЗачетАвансовОЗ.ТолькоПросмотр = Истина;
		Элементы.ЗачетАвансовЗачетАвансов_Очистить.Доступность=Ложь;
		Элементы.ЗачетАвансовОЗЗачетАвансовОЗ_Очистить.Доступность=Ложь;
		Элементы.ЗачетАвансовОЗЗачетАвансовОЗ_Открыть.Доступность = Ложь;
		Элементы.ЗачетАвансовЗачетАвансов_Открыть.Доступность = Ложь;
		
		Элементы.НадписьДокументыОбОтгрузке.Доступность = Ложь;
		
		Элементы.Заявки.ТолькоПросмотр = Истина;
		Элементы.СоздатьЗаявку.Доступность = Ложь;
	Иначе
		//Если ЭтотОбъект.ТолькоПросмотр = Ложь Тогда  //AFR-233633
			_ПраваДоступа();
		//КонецЕсли; //AFR-233633
		Элементы.ФормаОбщаяКомандаCW_ИнформацияПоЗакрытиюГрузоперевозок.Видимость = Ложь;
	КонецЕсли; 
	
	// --- 
	
	
	//// видимость доп.действий
	//СписокДействий = _СписокДействий();
	//Если (СписокДействий.Количество() = 0) Тогда
	//	Элементы.ФормаВнешниеДействия.Видимость = Ложь;
	//КонецЕсли; 
	
	Если (НЕ Объект.Организация.Пустая()) Тогда
		
		Если (_ДС().НП.ПодставлятьУполномоченныхЛицПриСозданииДокументов И Объект.Ссылка.Пустая()) Тогда
			
			_ПодставитьПодписантов();
			
		КонецЕсли; 
		
	КонецЕсли; 
	
	ОбновитьИтогиПоУслугам();
	_ОбновитьСтатусПометокУдаления();
	// --- 
	ОбновитьИтогиПоАвансам();
	
	ЭтаФорма.АвтоЗаголовок = Ложь;
	_СформироватьЗаголовок();
	
	// пометка блокированных грузоперевозок
	АдресДефис = ПоместитьВоВременноеХранилище(БиблиотекаКартинок.CW_ЭлементСписка, ЭтаФорма.УникальныйИдентификатор);
	АдресЗамок = ПоместитьВоВременноеХранилище(БиблиотекаКартинок.CW_Замок, ЭтаФорма.УникальныйИдентификатор);
	ПометитьГрузоперевозки();

	//МассивИсключаемых = Новый Массив;
	//МассивИсключаемых.Добавить("Объект.Услуги.Грузоперевозка");
	//МассивИсключаемых.Добавить("Объект.Услуги.Номенклатура");
	//МассивИсключаемых.Добавить("Объект.Услуги.СтатьяЗатрат");
	//_УФС.ОтключитьИсториюВыбораЭлементовФормы(ЭтаФорма, МассивИсключаемых);
	
	Элементы.УслугиПорядокОтражения.РежимВыбораИзСписка=Истина;
	Элементы.УслугиПорядокОтражения.ОтображениеКнопкиВыбора = ОтображениеКнопкиВыбора.ОтображатьВПолеВвода;
	Элементы.УслугиПорядокОтражения.ИсторияВыбораПриВводе=ИсторияВыбораПриВводе.НеИспользовать;
	// --- 
	Элементы.УслугиПорядокОтражения.СписокВыбора.Очистить();
	Элементы.УслугиПорядокОтражения.СписокВыбора.Добавить(Перечисления.CW_ПорядокОтраженияДоходов.СобственнаяУслуга);
	Элементы.УслугиПорядокОтражения.СписокВыбора.Добавить(Перечисления.CW_ПорядокОтраженияДоходов.Перевыставление);
	ПеревыставлениеПоСтавкам = ПолучитьФункциональнуюОпцию("CW_ИспользованиеСхемыПеревыставленияПоСтавкам");
	Если (ПеревыставлениеПоСтавкам) Тогда
		Элементы.УслугиПорядокОтражения.СписокВыбора.Добавить(Перечисления.CW_ПорядокОтраженияДоходов.ПеревыставлениеПоСтавкам);
	КонецЕсли; 
	Элементы.УслугиПорядокОтражения.СписокВыбора.Добавить(Перечисления.CW_ПорядокОтраженияДоходов.ПрочиеДоходы);
	
	// --- 
	Элементы.УслугиНоменклатурнаяГруппа.Видимость = _ДС().НП.ОтображатьНоменклатурнуюГруппу;
	Элементы.УслугиЕИ.Видимость = _ДС().НП.ОтображатьЕИ;
	Элементы.УслугиКорректировкаЕИ.Видимость = _ДС().НП.ОтображатьЕИ;
	
	// ---------------------------------------------------------------------------- 
	
	_УправлениеЭлементамиФормы();
	// --- 
	_ОбновитьНадписиКорректировок();
	
	Элементы.УслугиКартинкаФинансовогоСтатуса.Видимость = _ДС().НП.ВыводитьФинансовыйСтатусВДокументах;
	
	#Область ЗаполнитьПоНеактированнымСчетам
	
		УстановитьВидимостьКомандыЗаполнитьПоНеактированнымСчетам();
	
	#КонецОбласти
	
	УстановитьПараметрыВыбораСтавкиНДС();
	
	// ---------------------------------------------------------------------------- 
	ФормаИнициализирована = Истина;
	
КонецПроцедуры


&НаСервере
Процедура _СформироватьЗаголовок()
	// управляемое прилолжение
	
	Если (НЕ Объект.Корректировка) Тогда
		ВидОперацииСтрокой = ?(ЗначениеЗаполнено(Объект.ВидОперации), "("+нрег(Объект.ВидОперации)+")", "");
	Иначе
		ВидОперацииСтрокой = "(корректировка)";
	КонецЕсли; 
	
	ЗаголовокДокумента = 
		"Доходы по грузоперевозке" + " " 
		+ ВидОперацииСтрокой
		+ ?(ЗначениеЗаполнено(Объект.Ссылка), " "+Объект.Номер+" от "+Объект.Дата, " (создание)")
	;
	ЭтаФорма.Заголовок = ЗаголовокДокумента;
КонецПроцедуры

&НаСервере
Процедура _ПраваДоступа()
	
	БазоваяВалютаРубль 	= Константы.CW_ВалютаРегламентированногоУчетаРубль.Получить();
						
	ЭтоСчет 	= Объект.ФормируетсяСчет;
	ЭтоАкт 		= Не Объект.ФормируетсяСчет и (Объект.ФормируетсяАкт или Объект.ФормируетсяСчетФактура);
	ЭтоПакет 	= Объект.ФормируетсяСчет и (Объект.ФормируетсяАкт или Объект.ФормируетсяСчетФактура);

	ПравоРедактирования = CW_ПраваДоступа.ПравоДоступно("РедактированиеФинансов");
	
	Если ПравоРедактирования и Объект.Корректировка Тогда
		ПравоРедактирования = CW_ПраваДоступа.ПравоДоступно("РедактированиеФинансов_Корректировки");
	КонецЕсли;
	
	Если ПравоРедактирования и ЭтоСчет Тогда
		ПравоРедактирования = CW_ПраваДоступа.ПравоДоступно("РедактированиеФинансов_Доходы_Счета");
	Конецесли;
	
	Если БазоваяВалютаРубль Тогда
		
		Если ПравоРедактирования и ЭтоАкт Тогда
			ПравоРедактирования = CW_ПраваДоступа.ПравоДоступно("РедактированиеФинансов_Доходы_Акты");
		Конецесли;
		
		Если ПравоРедактирования Тогда
			
			РедактированиеАктированныхСчетов = CW_ПраваДоступа.ПравоДоступно("РазрешитьРедактированиеИсходящихАктированныхСчетов");
			Если НЕ РедактированиеАктированныхСчетов Тогда
				
				Если ЭтоПакет Тогда
					ПравоРедактирования = Ложь;
				КонецЕсли;
				
				Если ПравоРедактирования Тогда
					
					// проверяем, что нет сформированных актов
					Запрос = Новый Запрос;
					Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
					|	CW_СоответствиеАктовИсходящимСчетам.Акт КАК Акт
					|ИЗ
					|	РегистрСведений.CW_СоответствиеАктовИсходящимСчетам КАК CW_СоответствиеАктовИсходящимСчетам
					|ГДЕ
					|	CW_СоответствиеАктовИсходящимСчетам.Счет = &Счет";
					
					Запрос.УстановитьПараметр("Счет", Объект.Ссылка);
					РезультатЗапроса = Запрос.Выполнить();
					
					ПравоРедактирования = РезультатЗапроса.Пустой();
					
				КонецЕсли;
				
			Конецесли;
			
		Конецесли;
		
	Конецесли;
	
	Если ПравоРедактирования Тогда
		
		РедактированиеОплаченныхСчетов 	= CW_ПраваДоступа.ПравоДоступно("РазрешитьРедактированиеИсходящихОплаченныхСчетов");
		Если Не РедактированиеОплаченныхСчетов Тогда	
			
			// проверяем, нет ли оплат
			Запрос = Новый Запрос;
			Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	CW_ОплатаИсходящихДокументов.ДокументОплаты КАК ДокументОплаты
			|ИЗ
			|	РегистрСведений.CW_ОплатаИсходящихДокументов КАК CW_ОплатаИсходящихДокументов
			|ГДЕ
			|	CW_ОплатаИсходящихДокументов.Документ = &Документ";
			Запрос.УстановитьПараметр("Документ", Объект.Ссылка);
			
			РезультатЗапроса = Запрос.Выполнить();
			
			ПравоРедактирования = РезультатЗапроса.Пустой();
			
		КонецЕсли;
		
	КонецЕсли;
	
	//Управление элементами формы
	ЭтаФорма.ТолькоПросмотр = НЕ ПравоРедактирования;
	
	Элементы.УслугиГруппаЗаполнить.Видимость 				= ПравоРедактирования;
	Элементы.УслугиОчиститьТабличнуюЧастьУслуг.Видимость 	= ПравоРедактирования;
	Элементы.УслугиУслуги_ГрупповоеРедактирование.Видимость = ПравоРедактирования;
	
	Элементы.УслугиПодбор.Видимость 	= ПравоРедактирования;
	Элементы.УслугиИзменить.Доступность = ПравоРедактирования;
	
	Элементы.УслугиУслуги_ПереформироватьПредставление.Доступность = ПравоРедактирования;
	
	Элементы.УслугиГруппаЗаполнить.Видимость = ПравоРедактирования;
	
	Элементы.ГруппаКорректируемыйДокумент.Доступность 			= ПравоРедактирования;
	Элементы.ГруппаВедомыйДокумент.Доступность 					= ПравоРедактирования;
	Элементы.ГруппаВедомыеДокументыКорректировки.Доступность 	= ПравоРедактирования;

	
	ПравоПросмотраБухгалтерскихОбъектов 					= CW_ПраваДоступа.ДоступныОбъектыБухгалтерии();
	Элементы.ГруппаКорректируемыйДокумент.Видимость 		= Объект.Корректировка;
	Элементы.ГруппаВедомыйДокумент.Видимость 				= ПравоПросмотраБухгалтерскихОбъектов И НЕ Объект.Корректировка;
	Элементы.ГруппаВедомыеДокументыКорректировки.Видимость 	= ПравоПросмотраБухгалтерскихОбъектов И Объект.Корректировка;
	
	РедактированиеСтавкиНДС = CW_ПраваДоступа.ПравоДоступно("РедактированиеСтавкиНДС");
	Элементы.УслугиСтавкаНДС.Доступность = РедактированиеСтавкиНДС и ПравоРедактирования;
	//Управление элементами формы
	
КонецПроцедуры

&НаСервере
Процедура _ПроверитьРежимВводаОстатков()
	
	// контроль параметров учетной политики можно осуществить только при условии того, 
	// что в документе были заполнены организация и договор
	Если _ДС().Свойство("УП") Тогда
		ВводОстатковБУ = _ДС().УП.ВводОстатковБУ;
		ДатаНачалаВеденияУчетаБУ = _ДС().УП.ДатаНачалаВеденияУчетаБУ;
		
		ОперативныйУчет = _ДС().УП.ОЗ;
		
		РаздельныйУчетЗаполженности = _ДС().УП.РаздельныйУчетОперативнойИБухгалтерскойЗадолженности;
		ПереплатаКакАванс 			= _ДС().УП.УчитыватьПереплатыПоДокументамКакАванс;
		
		ВводОстатковОЗ = _ДС().УП.ВводОстатковОЗ;
		ДатаНачалаВеденияУчетаОЗ = _ДС().УП.ДатаНачалаВеденияУчетаОЗ;
	Иначе
		ВводОстатковБУ = Дата(1,1,1);
		ДатаНачалаВеденияУчетаБУ = Дата(1,1,1);

		РаздельныйУчетЗаполженности = Истина;
		ПереплатаКакАванс 			= Ложь;
		
		ОперативныйУчет = Ложь;
		ВводОстатковОЗ = Ложь;
		ДатаНачалаВеденияУчетаОЗ = Дата(1,1,1);
	КонецЕсли;
	

	Если ВводОстатковБУ Тогда
		Элементы.УслугиВводОстатков.Заголовок = "Не перевыставлены на "+Формат(ДатаНачалаВеденияУчетаБУ,"ДФ=dd.MM.yyyy");
		Элементы.ГруппаНачальныеОстаткиБУ.Заголовок = "Сальдо по бухгалтерскому учёту на "+Формат(ДатаНачалаВеденияУчетаБУ,"ДФ=dd.MM.yyyy");
	КонецЕсли; 
	
	Если Объект.ВводОстатковБУ <> ВводОстатковБУ Тогда
		Объект.ВводОстатковБУ = ВводОстатковБУ;
	КонецЕсли; 
	
	Если ВводОстатковОЗ Тогда
		Элементы.ГруппаНачальныеОстаткиОЗ.Заголовок = "Сальдо по оперативному учёту на "+Формат(ДатаНачалаВеденияУчетаОЗ,"ДФ=dd.MM.yyyy");
		Элементы.УслугиНеактированноеСальдо.Заголовок = "Неактированное сальдо на "+Формат(ДатаНачалаВеденияУчетаОЗ,"ДФ=dd.MM.yyyy");
	КонецЕсли; 
	
	Если Объект.ВводОстатковОЗ <> ВводОстатковОЗ Тогда
		Объект.ВводОстатковОЗ = ВводОстатковОЗ;
	КонецЕсли; 
	
КонецПроцедуры

&НаСервере
Функция _ПроверитьБлок()
	// --- 
	
	Блок = Ложь;
	Для Каждого Стр из Копия.Услуги Цикл
		Если НЕ ПроверитьГрузоперевозку(?(ЗначениеЗаполнено(Стр.Грузоперевозка.Заказ), Стр.Грузоперевозка.Заказ, Стр.Грузоперевозка)) Тогда 
			Блок = Истина;	
		КонецЕсли;	
	КонецЦикла;	
	
	Возврат(Блок);
	
	// --- 
КонецФункции


&НаСервере
Процедура ПометитьГрузоперевозки()
	
	Для Каждого Стр из Объект.Услуги Цикл
		Попытка
			Если ПроверитьГрузоперевозку(?(ЗначениеЗаполнено(Стр.Грузоперевозка.Заказ), Стр.Грузоперевозка.Заказ, Стр.Грузоперевозка)) Тогда
				//			Стр.БлокГП = АдресДефис;
				Стр.БлокГП = Неопределено;
			Иначе
				Стр.БлокГП = АдресЗамок;
			КонецЕсли;	
		исключение
			Стр.БлокГП = Неопределено;
		КонецПопытки;
	КонецЦикла;	
	
КонецПроцедуры	

&НаСервере
Функция ПроверитьГрузоперевозку(ГП)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	CW_ЗакрытиеФинансов.Аналитика
		|ИЗ
		|	РегистрСведений.CW_ЗакрытиеФинансов КАК CW_ЗакрытиеФинансов
		|ГДЕ
		|	CW_ЗакрытиеФинансов.Аналитика = &Аналитика";
	Запрос.УстановитьПараметр("Аналитика", ГП);
	ТЗ = Запрос.Выполнить().Выгрузить();
	
	Возврат ?(ТЗ.Количество() = 0, Истина, Ложь);
	
КонецФункции	


&НаСервере
Процедура УстановитьПараметрыВыбораСтавкиНДС() Экспорт
	
	Если Объект.Корректировка Тогда
		ИмяРеквизитаСтавкаНДС = "УслугиКорректировкаСтавкаНДС";
	Иначе
		ИмяРеквизитаСтавкаНДС = "УслугиСтавкаНДС";
	КонецЕсли;
	
	CW_БухгалтерияЭкспедитораСерверПереопределяемый.УстановитьПараметрыВыбораСтавкиНДС(ЭтотОбъект, ИмяРеквизитаСтавкаНДС);
	
КонецПроцедуры

#КонецОбласти 

#Область ОбщиеПараметры 

Функция _ДС()
	Возврат(ДС[0].Значение);
КонецФункции

&НаСервере
Процедура _СформироватьОбщиеПараметры(СписокПараметров=Неопределено) Экспорт
	
	ДокументОбъект = РеквизитФормыВЗначение("Объект");
	ДокументОбъект.СформироватьОбщиеПараметры(СписокПараметров);
	
	Если СписокПараметров = Неопределено Тогда
		ДС.Очистить();
		ДС.Добавить(ДокументОбъект.ДополнительныеСвойства);
	Иначе
		
		СоответствиеПарамеров = Новый Соответствие;
		СоответствиеПарамеров.Вставить("ПараметрыДоговора","ПД");
		СоответствиеПарамеров.Вставить("Константы","КО");
		СоответствиеПарамеров.Вставить("УчетнаяПолитика","УП");
		СоответствиеПарамеров.Вставить("НастройкиПользователя","НП");
		
		МассивПараметров = _сф.м_СоздатьИзСтроки(СписокПараметров,",");
		
		Если (ДС.Количество()=0) Тогда
			ДС.Добавить(Новый Структура());
		КонецЕсли; 
		ДСС = _ДС();
		
		Для каждого Параметр Из МассивПараметров Цикл
			
			Ключ = СоответствиеПарамеров.Получить(Параметр);
			_сф.ст_УстановитьСвойство(ДСС,Ключ,ДокументОбъект.ДополнительныеСвойства[Ключ]);
			
		КонецЦикла; 
		
		ДС.Очистить();
		ДС.Добавить(ДСС);
		
	КонецЕсли; 
	
	_ПроверитьРежимВводаОстатков();
	
КонецПроцедуры

#КонецОбласти 

#Область УправлениеЭлементамиФормы

&НаСервере
Процедура _УправлениеЭлементамиФормы()
	
	// обновим итоги
	ОбновитьИтогиПоУслугам();
	ОбновитьИтогиПоАктированию();
	ОбновитьИтогиПоАвансам();
	
	// шапка документа
	Элементы.КурсВалюты.Видимость = (НЕ Объект.Валюта.Пустая() И Объект.Валюта <> _ДС().КО.ВалютаРегламентированногоУчета);
	//Элементы.КурсВалюты.КнопкаВыбора = (Объект.Договор.ВзаиморасчетыВУЕ);
	//Элементы.КурсВалюты.ТолькоПросмотр = НЕ Объект.Договор.ВзаиморасчетыВУЕ;
	
	СтруктураПараметровБухУчета = Новый Структура;
	СтруктураПараметровБухУчета.Вставить("Договор", 				Объект.Договор);
	СтруктураПараметровБухУчета.Вставить("ПриложениеКДоговору",		Объект.ПриложениеКДоговору);
	
	ПараметрыБухгалтерскогоУчета = CW_Финансы.ПолучитьПарметрыВеденияБухгалтерскогоУчета(СтруктураПараметровБухУчета, Объект.Дата);

	ЗачетАвансовБУ = (Объект.ФормируетсяАкт И ПараметрыБухгалтерскогоУчета.БухгалтерскийУчет);
	ЗачетАвансовОЗ = (Объект.ФормируетсяСчет И ?(_ДС().Свойство("УП"),_ДС().УП.ОЗ,Ложь));
	
	// закладки
	мЭтоСчет = (Объект.ФормируетсяСчет) И (НЕ Объект.ФормируетсяАкт) И (НЕ Объект.ФормируетсяСчетФактура); 	
	
	// видимость закладок
	Элементы.СтраницаУслуги.Видимость = (НЕ Объект.Корректировка);
	Элементы.СтраницаУслугиКорректировка.Видимость = (Объект.Корректировка);
	Элементы.СтраницаАкты.Видимость = мЭтоСчет И (НЕ Объект.Ссылка.Пустая()) И (НЕ ВводОстатковОЗ) И НЕ Объект.Корректировка и ВалютаРегламентированногоУчетаРубль;
	Элементы.СтраницаЗачетАвансов.Видимость = (Объект.СпособЗачетаАвансов=Перечисления.СпособыЗачетаАвансов.ПоДокументу И ЗачетАвансовБУ);
	Элементы.СтраницаЗачетАвансовОЗ.Видимость = (Объект.СпособЗачетаАвансовОЗ=Перечисления.СпособыЗачетаАвансов.ПоДокументу И ЗачетАвансовОЗ);
	Элементы.СтраницаПлатёжноРасчётныеДокументы.Видимость = 
		Объект.ФормируетсяСчетФактура 
		И (Объект.ПорядокЗаполненияРасчётноПлатёжныхДокументовСФ=Перечисления.CW_ПорядокЗаполненияРасчётноПлатёжныхДокументовСФ.ПоДокументу);
	Элементы.ПлатёжноРасчётныеДокументы.ТолькоПросмотр = НЕ (Объект.ФормируетсяСчетФактура И (Объект.ПорядокЗаполненияРасчётноПлатёжныхДокументовСФ=Перечисления.CW_ПорядокЗаполненияРасчётноПлатёжныхДокументовСФ.ПоДокументу));
	
	// заголовки закладок
	Элементы.СтраницаКомментарий.Заголовок = " Комментарий" +?(ЗначениеЗаполнено(Объект.Комментарий)," (*)","");
	Элементы.СтраницаУслуги.Заголовок = " Услуги (" +Объект.Услуги.Количество() + ")";
	Элементы.СтраницаАкты.Заголовок = " Акты (" +ТаблицаАктов.Количество() + ")";
	Элементы.СтраницаЗачетАвансовОЗ.Заголовок = " Зачет опер.авансов (" +Объект.ЗачетАвансовОЗ.Количество() + ")";
	Элементы.СтраницаЗачетАвансов.Заголовок = " Зачет бух.авансов (" +Объект.ЗачетАвансов.Количество() + ")";
	Элементы.СтраницаПлатёжноРасчётныеДокументы.Заголовок = " Платёжно-расчётные документы с/ф (" + Объект.ПлатёжноРасчётныеДокументы.Количество() + ")";
	
	// таблица услуг
	//Элементы.УслугиЗаказ.Видимость = _ДС().КО.CW_ИспользованиеЗаказов;
	Элементы.УслугиВсего.ТолькоПросмотр = (НЕ _ДС().НП.ОбратныйПересчетВДокументах);
	Элементы.УслугиГруппаСчет.Видимость = Объект.СписокСчетов;
	//Элементы.УслугиПроверитьДокументПоБюджету.Видимость = _ДС().КО.CW_ИспользованиеБюджетирования;
	Элементы.УслугиГруппаПоНеперевыставленным.Видимость = (Объект.ВидОперации=Перечисления.CW_ВидыОперацийДоходыПоГрузоперевозке.ОказаниеУслуг);
	Элементы.УслугиЗаполнитьРасчетАгентскогоВознаграждения.Видимость = (Истина);
	Элементы.УслугиЗаполнитьРасчетАгентскогоВознаграждения.Видимость = ?(Объект.ВидОперации = Перечисления.CW_ВидыОперацийДоходыПоГрузоперевозке.ОтчетАгента, Истина, Ложь);
	
	// ведомый счет 
	Элементы.ВедомыйСчетКорректировочный_Удалить.Видимость = НЕ Объект.ВедомыйСчетКорректировочный.Пустая() И (Объект.ФормируетсяСчет И Объект.ВедомыйСчетКорректировочный.ПометкаУдаления);
	
	
	// ведомый документ "Реализация т/у"
	Элементы.ВедомыйДокумент_Движения.Видимость 			= (НЕ Объект.ВедомыйДокумент.Пустая()  И Объект.ВедомыйДокумент.Проведен 	И ВалютаРегламентированногоУчетаРубль);
	Элементы.ВедомыйДокумент_Удалить.Видимость 				= (НЕ Объект.ВедомыйДокумент.Пустая()  И НЕ Объект.ФормируетсяАкт 			И ВалютаРегламентированногоУчетаРубль);
	Элементы.ГруппаДействияСВедомойРеализацией.Видимость 	= НЕ Объект.ВедомыйДокумент.Пустая()   И (Элементы.ВедомыйДокумент_Движения.Видимость ИЛИ Элементы.ВедомыйДокумент_Удалить.Видимость и ВалютаРегламентированногоУчетаРубль);
	
	// ведомый документ "Корректировка реализации т/у"
	Элементы.ВедомыйДокументКорректировочный_Движения.Видимость 			= (НЕ Объект.ВедомыйДокументКорректировки.Пустая()  И Объект.ВедомыйДокументКорректировки.Проведен 	И ВалютаРегламентированногоУчетаРубль);
	Элементы.ВедомыйАктКорректировочный_Удалить.Видимость  = (НЕ Объект.ВедомыйДокументКорректировки.Пустая()  И НЕ Объект.ФормируетсяАкт И ВалютаРегламентированногоУчетаРубль);
	
	
	// ведомая счёт-фактура
	Элементы.ОбщаяКомандаCW_ДвиженияВедомого.Видимость 		= (НЕ Объект.ВедомыйСчетФактура.Пустая() И Объект.ВедомыйСчетФактура.Проведен 	И ВалютаРегламентированногоУчетаРубль);
	Элементы.ВедомыйСчетФактура_Удалить.Видимость 			= (НЕ Объект.ВедомыйСчетФактура.Пустая() И НЕ Объект.ФормируетсяСчетФактура 	И ВалютаРегламентированногоУчетаРубль);
	
	// ведомая корректировочная счёт-фактура
	Элементы.ВедомыйСФКорректировочный_Движения.Видимость 		= (НЕ Объект.ВедомыйСчетФактураКорректировочный.Пустая() И Объект.ВедомыйСчетФактураКорректировочный.Проведен 	И ВалютаРегламентированногоУчетаРубль);
	Элементы.ВедомыйСФКорректировочный_Удалить.Видимость  = (НЕ Объект.ВедомыйСчетФактураКорректировочный.Пустая()  И НЕ Объект.ФормируетсяСчетФактура И ВалютаРегламентированногоУчетаРубль);
	
	
	Элементы.ГруппаДействияСВедомойСчетФактурой.Видимость 	= НЕ Объект.ВедомыйСчетФактура.Пустая()  И (Элементы.ОбщаяКомандаCW_ДвиженияВедомого.Видимость ИЛИ Элементы.ВедомыйСчетФактура_Удалить.Видимость и ВалютаРегламентированногоУчетаРубль);
	
	// ведомый документ "Счет покупателю"
	Элементы.ГруппаДействияСВедомымСчетом.Видимость = (НЕ Объект.ВедомыйСчет.Пустая() И НЕ Объект.ФормируетсяСчет);
	
	// ввод остатков
	Элементы.УслугиВводОстатков.Видимость = ВводОстатковБУ И (Объект.ФормируетсяАкт);
	Элементы.УслугиНеактированноеСальдо.Видимость = ВводОстатковОЗ И (Объект.ФормируетсяСчет) И (НЕ Объект.ФормируетсяАкт И НЕ Объект.ФормируетсяСчетФактура);
	Элементы.ГруппаНачальныеОстаткиБУ.Видимость = ВводОстатковБУ И (Объект.ФормируетсяАкт);
	Элементы.ГруппаНачальныеОстаткиОЗ.Видимость = ВводОстатковОЗ И (Объект.ФормируетсяСчет);
	Элементы.КурсВзаиморасчетовБУ.Видимость = Объект.Договор.ВзаиморасчетыВУЕ;
	Элементы.КурсВзаиморасчетовОЗ.Видимость = (Объект.Договор.ВалютаДоговора <> _ДС().КО.ВалютаРегламентированногоУчета);
	
	// кнопки нижней панели и меню "Действия"
	Элементы.ФормаОбщаяКомандаCW_ФайлыАрхива.Видимость = Константы.CW_ИспользованиеФайловогоАрхива.Получить();
	Элементы.ФормаДокументCW_КорректировкаАктированияСчетовСоздатьНаОсновании.Видимость = (Объект.ФормируетсяСчет) И (НЕ Объект.ФормируетсяАкт И НЕ Объект.ФормируетсяСчетФактура) И (НЕ Объект.Ссылка.Пустая());
	
	// отчеты
	Элементы.ФормаОбщаяКомандаCW_ОтчетНеперевыставленныеЗатраты.Видимость = (Объект.ФормируетсяАкт);
	Элементы.ФормаОбщаяКомандаCW_ОтчетВедомостьНеперевыставленныхЗатрат.Видимость = (Объект.ФормируетсяАкт);
	Элементы.ФормаОбщаяКомандаCW_ОтчетВедомостьПеревыставленияПоСтавкам.Видимость = ((Не ВалютаРегламентированногоУчетаРубль) или (Объект.ФормируетсяАкт));
	Элементы.ФормаОбщаяКомандаCW_ОтчетВедомостьАктированияСчетов.Видимость = (Объект.ФормируетсяСчет);

	СостояниеДокумента = ОбщегоНазначенияБП.СостояниеДокумента(Объект); // ВызовБП
	
	//Исправления
	УстановитьВидимостьЭлементовИсправления();
	//Исправления

КонецПроцедуры

#КонецОбласти 

// ---------------------------------------------------------------------------- 
// РЕКВИЗИТЫ
// ---------------------------------------------------------------------------- 

#Область ПакетДокументов 

&НаСервере
Процедура _ОбновитьНомераДокументов()
	
	ЭтоУПД =  Объект.ФормируетсяАкт И Объект.ЭтоУниверсальныйДокумент; 
	
	Элементы.ПредставлениеАкта.Видимость 		 = НЕ ЭтоУПД;
	Элементы.ПредставлениеСчетаФактуры.Видимость = НЕ ЭтоУПД;  
	Элементы.ПредставлениеУПД.Видимость 		 = ЭтоУПД; 

	// Представление счета
	Если Объект.ФормируетсяСчет Тогда  
		
		Если ЗначениеЗаполнено(Объект.НомерСчета) Тогда
			ПредставлениеНомераСчета = CW_Документы.ПолучитьНомерНаПечать(Новый Структура("Организация, Номер, Дата", Объект.Организация, Объект.НомерСчета, Объект.ДатаСчета));	 
		Иначе
			ПредставлениеНомераСчета = "<...>";	
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Объект.ДатаСчета) Тогда
			ПредставлениеДатыСчета	= Формат(Объект.ДатаСчета, "ДФ=dd.MM.yyyy");
		Иначе
			ПредставлениеДатыСчета 	= "<...>";	
		КонецЕсли;
	
		//План оплаты
		ПредставлениеСрокаОплаты = "";
		ДанныеПланаОплаты = CW_Документы.ПолучитьПланОплаты(Объект.Ссылка);
		Если Не ЗначениеЗаполнено(ДанныеПланаОплаты.Дата) и НЕ ПустаяСтрока(ДанныеПланаОплаты.Примечание) Тогда
			ПредставлениеСрокаОплаты = ", План оплаты: <...>";
		ИначеЕсли ЗначениеЗаполнено(ДанныеПланаОплаты.Дата) Тогда
			ПредставлениеСрокаОплаты = ", План оплаты: "+Формат(ДанныеПланаОплаты.Дата,"ДФ=dd.MM.yyyy");
		КонецЕсли;
		
		Если Не ПустаяСтрока(ДанныеПланаОплаты.Примечание) Тогда
			ПредставлениеСрокаОплаты = ПредставлениеСрокаОплаты + " ("+СокрЛП(ДанныеПланаОплаты.Примечание)+")";
		КонецЕсли; 
		//План оплаты
		
		ПредставлениеСчета = "Счет №" +ПредставлениеНомераСчета +  " от "+ ПредставлениеДатыСчета + ПредставлениеСрокаОплаты;
	
	// счет не формируется
	Иначе
		ПредставлениеСчета = "<Счёт не формируется>";
	КонецЕсли; 
	// Представление счета
	
	// акт формируется  
	Если Не ЭтоУПД Тогда 
		
		//Представление акта
		Если Объект.ФормируетсяАкт Тогда
			
			Если ЗначениеЗаполнено(Объект.НомерАкта) Тогда
				ПредставлениеНомераАкта = CW_Документы.ПолучитьНомерНаПечать(Новый Структура("Организация, Номер, Дата", Объект.Организация, Объект.НомерАкта, Объект.ДатаАкта));	 
			Иначе
				ПредставлениеНомераАкта = "<...>";	
			КонецЕсли;
			
			Если ЗначениеЗаполнено(Объект.ДатаАкта) Тогда
				ПредставлениеДатыАкта  = Формат(Объект.ДатаАкта, "ДФ=dd.MM.yyyy");
			Иначе
				ПредставлениеДатыАкта = "<...>";	
			КонецЕсли;
			
			ПредставлениеОбъектаВнешнегоСчета = "";
			Если Объект.СписокСчетов и НЕ ВводОстатковОЗ Тогда
				ПредставлениеОбъектаВнешнегоСчета = " к списку счетов";
			Конецесли;  
			
			Если НЕ Объект.ФормируетсяСчет и НЕ Объект.СписокСчетов Тогда 
				Если Объект.Счет.Пустая() Тогда  
					ПредставлениеВнешнегоСчета = " <не указан>";
				Иначе   
					ПредставлениеНомераВнешнегоСчета = CW_Документы.ПолучитьНомерНаПечать(Новый Структура("Организация, Номер, Дата", Объект.Организация, Объект.Счет.НомерСчета, Объект.Счет.ДатаСчета));	 
					ПредставлениеДатыВнешнегоСчета 	 = Формат(Объект.Счет.ДатаСчета, "ДФ=dd.MM.yyyy"); 
					
					ПредставлениеВнешнегоСчета 		= ПредставлениеНомераВнешнегоСчета + " от "+ПредставлениеДатыВнешнегоСчета;
				КонецЕсли;
				
				ПредставлениеОбъектаВнешнегоСчета = "  к счёту №" + ПредставлениеВнешнегоСчета;
			КонецЕсли;
			
			ПредставлениеАкта = "Акт №" + ПредставлениеНомераАкта + " от " + ПредставлениеДатыАкта + ПредставлениеОбъектаВнешнегоСчета;
			
			// акт не формируется
		Иначе
			ПредставлениеАкта = "<Акт не формируется>";
		КонецЕсли; 
		//Представление акта  
		

		// Представление с/ф 
		Если Объект.ФормируетсяСчетФактура Тогда   
			
			Если ЗначениеЗаполнено(Объект.НомерСчетаФактуры) Тогда
				ПредставлениеНомераСчетФактура = CW_Документы.ПолучитьНомерНаПечать(Новый Структура("Организация, Номер, Дата", Объект.Организация, Объект.НомерСчетаФактуры, Объект.ДатаСчетаФактуры));	 
			Иначе
				ПредставлениеНомераСчетФактура = "<...>";	
			КонецЕсли;
			
			Если ЗначениеЗаполнено(Объект.ДатаСчетаФактуры) Тогда
				ПредставлениеДатыСчетФактура 	 = Формат(Объект.ДатаСчетаФактуры, "ДФ=dd.MM.yyyy");
			Иначе
				ПредставлениеДатыСчетФактура = "<...>";	
			КонецЕсли;    
			
			ПредставлениеИсправленияСчетФактура = "";
			Если ЗначениеЗаполнено(Объект.НомерИсправления) 
				И Объект.ВидОперацииКорректировки = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсправленияПоступленияРеализации.ИсправлениеОшибки") Тогда
				ПредставлениеИсправленияСчетФактура  =  " (испр. "+Формат(Объект.НомерИсправления, "ЧГ=0")+")";
			КонецЕсли;    
			
			ПредставлениеСчетаФактуры = "С/ф №" + ПредставлениеНомераСчетФактура + ПредставлениеИсправленияСчетФактура+" от " + ПредставлениеДатыСчетФактура;
			
		Иначе
			ПредставлениеСчетаФактуры = "<С/ф не формируется>";
		КонецЕсли; 
		// Представление с/ф 
		
		
	КонецЕсли;
	
	Если ЭтоУПД Тогда 
		
		ВидУПД = "УПД";	
		Если Объект.Корректировка и Объект.ВидОперацииКорректировки = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсправленияПоступленияРеализации.СогласованноеИзменение") Тогда
			ВидУПД = "УКД";	
		КонецЕсли;  
		
		ПредставлениеОбъектаВнешнегоСчета = "";  
		Если Объект.СписокСчетов и НЕ ВводОстатковОЗ Тогда
			ПредставлениеОбъектаВнешнегоСчета = " к списку счетов";
		КонецЕсли;  
		
		Если НЕ Объект.ФормируетсяСчет и НЕ Объект.СписокСчетов Тогда 
			Если Объект.Счет.Пустая() Тогда  
				ПредставлениеВнешнегоСчета = " <не указан>";
			Иначе   
				ПредставлениеНомераВнешнегоСчета = CW_Документы.ПолучитьНомерНаПечать(Новый Структура("Организация, Номер, Дата", Объект.Организация, Объект.Счет.НомерСчета, Объект.Счет.ДатаСчета));	 
				ПредставлениеДатыВнешнегоСчета 	 = Формат(Объект.Счет.ДатаСчета, "ДФ=dd.MM.yyyy"); 
				
				ПредставлениеВнешнегоСчета 		= ПредставлениеНомераВнешнегоСчета + " от "+ПредставлениеДатыВнешнегоСчета;
			КонецЕсли;
			
			ПредставлениеОбъектаВнешнегоСчета = "  к счёту №" + ПредставлениеВнешнегоСчета;
		КонецЕсли;
		
	
		ПредставлениеИсправленияУПД = "";
		Если Объект.ФормируетсяСчетФактура Тогда  
			СтатусУПД 				= "(1)";
			ПредставлениеНомераУПД	= CW_Документы.ПолучитьНомерНаПечать(Новый Структура("Организация, Номер, Дата", Объект.Организация, Объект.НомерСчетаФактуры, Объект.ДатаСчетаФактуры));
			ПредставлениеНомераУПД	= " №"+ ?(ПустаяСтрока(ПредставлениеНомераУПД), "<...>", 	ПредставлениеНомераУПД);
			ПредставлениеДатыУПД 	= ?(Объект.ДатаСчетаФактуры = Дата(1,1,1),		"<...>",	Формат(Объект.ДатаСчетаФактуры,"ДФ=dd.MM.yyyy"));
			
			Если ЗначениеЗаполнено(Объект.НомерИсправления) 
				И Объект.ВидОперацииКорректировки = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсправленияПоступленияРеализации.ИсправлениеОшибки") Тогда
				ПредставлениеИсправленияУПД  =  " (испр. "+Формат(Объект.НомерИсправления, "ЧГ=0")+")";
			КонецЕсли;    
			
		Иначе
			СтатусУПД 				= "(2)";
			ПредставлениеНомераУПД	= CW_Документы.ПолучитьНомерНаПечать(Новый Структура("Организация, Номер, Дата", Объект.Организация, Объект.НомерАкта, Объект.ДатаАкта));
			ПредставлениеНомераУПД	= " №"+ ?(ПустаяСтрока(ПредставлениеНомераУПД), "<...>", 	ПредставлениеНомераУПД);
			ПредставлениеДатыУПД 	= ?(Объект.ДатаАкта = Дата(1,1,1),				"<...>",	Формат(Объект.ДатаАкта,"ДФ=dd.MM.yyyy"));
		КонецЕсли;  
		
		ПредставлениеУПД = ВидУПД + СтатусУПД + ПредставлениеНомераУПД + ПредставлениеИсправленияУПД+" от "+ ПредставлениеДатыУПД + ПредставлениеОбъектаВнешнегоСчета;
		
	КонецЕсли;
	
	ВедомыйДокументСчет = Строка(Объект.ВедомыйСчет);
	ВедомыйДокументРеализация = Строка(Объект.ВедомыйДокумент);
	ВедомыйДокументСчетФактура = Строка(Объект.ВедомыйСчетФактура);
	
КонецПроцедуры

#КонецОбласти 

#Область ИзменениеНомера 

&НаКлиенте
Процедура НомерПриИзменении(Элемент)
	
	// 2016.03.31
	// ничего не делаем, номера ведомых полностью контроллируются пользователем
	
КонецПроцедуры


&НаСервере
Функция _ИспользуетсяПакетнаяНумерация()
	
	ПорядокПрисвоенияНомеров = CW_Настройки.ПараметрУчетнойПолитики(Объект.Дата,Объект.Организация,"ПорядокПрисвоенияНомеров");
	Если (ПорядокПрисвоенияНомеров = Перечисления.CW_ПорядокПрисвоенияИсходящихНомеров.ВПределахДаты) Или
		 (ПорядокПрисвоенияНомеров = Перечисления.CW_ПорядокПрисвоенияИсходящихНомеров.СплошнаяНумерация)	
	Тогда 
		Возврат Истина;
	Иначе
		Возврат Ложь;	
	КонецЕсли;
	
КонецФункции

#КонецОбласти 

#Область ИзменениеДаты 

&НаКлиенте
Процедура ДатаПриИзменении(Элемент)
	
	Если НЕ Объект.Ссылка.Пустая() Тогда
		Если (_ГодИзменился()) Тогда
			
			ПОВ = Новый ОписаниеОповещения("ОбработкаВопросаИзмененияГода",ЭтотОбъект, Новый Структура()); 
			ПоказатьВопрос(ПОВ,"Дата документа перенесена в другой год."+Символы.ПС+ 
			"Документу будет присвоен новый номер."+Символы.ПС+ 
			"Продолжить?",РежимДиалогаВопрос.ДаНет);
			
		Иначе
			
			ДиалогСменыДатыВедомых();
			
		КонецЕсли; 
	КонецЕсли;
	
	_ДатаПриИзменении(); 
	
КонецПроцедуры

&НаСервере
Процедура _ДатаПриИзменении()
	
	// если очистили дату, то принудительно 
	// устанавливаем текущую дату
	Если (Объект.Дата = Дата(1,1,1)) Тогда
		Объект.Дата = CW_Документы.РабочееВремя();
	КонецЕсли;
	
	// необходимо обновить параметры учётной политики и параметры договора
	_СформироватьОбщиеПараметры("ПараметрыДоговора,УчетнаяПолитика");
	
	// и курс валюты
	_СформироватьКурс();
	
	// проверка на режим ввода остатков
	_ПроверитьРежимВводаОстатков();
	
	// пересчитаем принудительно срок оплаты
	РасчитатьСрокОплатыДокумента();
	
	// актуализируем список услуг по договору (если по договору предусмотрено ограничение)
	Если ЗначениеЗаполнено(Объект.Договор) Тогда
		УстановитьАдресСпискаУслугПоДоговору();     
	КонецЕсли;
	
	// регенерация формы 
	_ОбновитьНомераДокументов();
	_УправлениеЭлементамиФормы();
	_СформироватьЗаголовок();
	УстановитьПараметрыВыбораСтавкиНДС();
	
КонецПроцедуры


&НаКлиенте
Процедура ОбработкаВопросаИзмененияГода(Ответ, ДополнительныеПараметры) Экспорт 
	// --- 
	
	Если (Ответ <> Неопределено) Тогда
		
		Если (Ответ = КодВозвратаДиалога.Да) Тогда
			
			// присваевам новый номер
			_ОбработатьИзменениеГода();
			ДиалогСменыДатыВедомых(); 
			
		Иначе
			
			// восстанавливаем дату по ссылке
			_ВосстановитьДатуДокумента();
			
		КонецЕсли; 
		
	КонецЕсли; 
	
	// --- 
КонецПроцедуры

&НаСервере
Процедура _ОбработатьИзменениеГода()
	НачальнаяДатаДокумента = Объект.Дата;
	_ПолучитьНомер();
КонецПроцедуры
 

&НаСервере
Процедура _ВосстановитьДатуДокумента()
	Объект.Дата = НачальнаяДатаДокумента;
	_ДатаПриИзменении();
КонецПроцедуры

&НаСервере
Функция _ГодИзменился()
	// --- 
	
	Возврат(Год(Объект.Дата) <> Год(НачальнаяДатаДокумента));
	
	// --- 
КонецФункции

&НаКлиенте
Процедура ДиалогСменыДатыВедомых()
	// --- 
	
	Если (Объект.ФормируетсяСчет ИЛИ Объект.ФормируетсяАкт ИЛИ Объект.ФормируетсяСчетФактура) Тогда
		
		ПОВ = Новый ОписаниеОповещения("ОбработкаПодтвержденияСменыДатыВедомых",ЭтотОбъект, Новый Структура()); 
		ПоказатьВопрос(ПОВ,"Изменить даты первичных документов?",РежимДиалогаВопрос.ДаНет);
		
	КонецЕсли; 
	
	// --- 
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаПодтвержденияСменыДатыВедомых(Ответ, ДополнительныеПараметры) Экспорт 
	// --- 
	
	Если (Ответ <> Неопределено) Тогда
		
		Если (Ответ = КодВозвратаДиалога.Да) Тогда
			
			_ИзменитьДатыВедомых();
			
			// спросим об изменении номеров ведомых
			ПОВ = Новый ОписаниеОповещения("ОбработкаПодтвержденияСменыНомеровВедомых",ЭтотОбъект, Новый Структура()); 
			ПоказатьВопрос(ПОВ,"Изменить номера ведомых документов?",РежимДиалогаВопрос.ДаНет,,КодВозвратаДиалога.Да);
			
		КонецЕсли; 
		
	КонецЕсли; 
	
	// --- 
КонецПроцедуры

&НаСервере
Процедура _ИзменитьДатыВедомых()
	// --- 
	
	Если (Объект.ФормируетсяСчет) Тогда
		
		Объект.ДатаСчета = Объект.Дата;
		
	КонецЕсли; 
	Если (Объект.ФормируетсяАкт) Тогда
		
		Объект.ДатаАкта = Объект.Дата;
		
	КонецЕсли; 
	Если (Объект.ФормируетсяСчетФактура) Тогда
		
		Объект.ДатаСчетаФактуры = Объект.Дата;
		
	КонецЕсли; 
	
	// --- 
	
	_ОбновитьНомераДокументов();
	
	// --- 
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаПодтвержденияСменыНомеровВедомых(Ответ, ДополнительныеПараметры) Экспорт 
	// --- 
	
	Если (Ответ <> Неопределено) Тогда
		
		Если (Ответ = КодВозвратаДиалога.Да) Тогда
			
			_ПолучитьНомер();

			ВыполнитьСменуНомеровВедомыхДокументов();
			
		КонецЕсли; 
		
	КонецЕсли; 	
	
	// --- 
КонецПроцедуры
  
&НаКлиенте
Процедура ВыполнитьСменуНомеровВедомыхДокументов()
	// --- 
	
	Если (Объект.ФормируетсяСчет) Тогда
		
		_УстановитьНомерСчета();
		
	КонецЕсли;
	// --- 
	Если (Объект.ФормируетсяАкт) Тогда
		
		_УстановитьНомерАкта();
		
	КонецЕсли;
	// --- 
	Если (Объект.ФормируетсяСчетФактура) Тогда
		
		_УстановитьНомерСчетаФактуры();
		
	КонецЕсли;
	
	_ОбновитьНомераДокументов();
	
	// --- 
КонецПроцедуры

&НаСервере
Процедура _УстановитьНомерСчета()
	
	ПорядокПрисвоенияНомеров = _ДС().УП.ПорядокПрисвоенияНомеров;
	ВнешнийНумератор = _ДС().УП.ВнешнийНумератор;
	
	Если (ПорядокПрисвоенияНомеров = Перечисления.CW_ПорядокПрисвоенияИсходящихНомеров.ВПределахДаты) Или
		 (ПорядокПрисвоенияНомеров = Перечисления.CW_ПорядокПрисвоенияИсходящихНомеров.СплошнаяНумерация) 
	Тогда
		
		Объект.НомерСчета = Объект.Номер;
		
	ИначеЕсли (ПорядокПрисвоенияНомеров = Перечисления.CW_ПорядокПрисвоенияИсходящихНомеров.НезависимаяНумерация) Тогда 
		
		НовыйСчет = Документы.СчетНаОплатуПокупателю.СоздатьДокумент();
		НовыйСчет.Организация = Объект.Организация;
		НовыйСчет.Дата = Объект.ДатаСчета;
		НовыйСчет.УстановитьНовыйНомер();
		// --- 
		Объект.НомерСчета = НовыйСчет.Номер;
		НовыйСчет = Неопределено;
		
	ИначеЕсли (ПорядокПрисвоенияНомеров = Перечисления.CW_ПорядокПрисвоенияИсходящихНомеров.ВнешнийНумератор) Тогда 
		
		ОбработкаНумерации = _ПО.ПолучитьОбработку(ВнешнийНумератор);
		ОбработкаНумерации.УстановитьНомерСчета(Объект);
		
	КонецЕсли; 
	
КонецПроцедуры

&НаСервере
Процедура _УстановитьНомерАкта()
	
	ПорядокПрисвоенияНомеров = _ДС().УП.ПорядокПрисвоенияНомеров;
	ВнешнийНумератор = _ДС().УП.ВнешнийНумератор;
	
	Если (ПорядокПрисвоенияНомеров = Перечисления.CW_ПорядокПрисвоенияИсходящихНомеров.ВПределахДаты) ИЛИ
		 (ПорядокПрисвоенияНомеров = Перечисления.CW_ПорядокПрисвоенияИсходящихНомеров.СплошнаяНумерация) 
	Тогда
		
		Объект.НомерАкта = Объект.Номер;
		
	ИначеЕсли (ПорядокПрисвоенияНомеров = Перечисления.CW_ПорядокПрисвоенияИсходящихНомеров.НезависимаяНумерация) Тогда 
		
		НовыйАкт = Документы.РеализацияТоваровУслуг.СоздатьДокумент();
		НовыйАкт.Организация = Объект.Организация;
		НовыйАкт.Дата = Объект.ДатаАкта;
		НовыйАкт.УстановитьНовыйНомер();
		// --- 
		Объект.НомерАкта = НовыйАкт.Номер;
		НовыйАкт = Неопределено;
		
	ИначеЕсли (ПорядокПрисвоенияНомеров = Перечисления.CW_ПорядокПрисвоенияИсходящихНомеров.ВнешнийНумератор) Тогда 
		
		ОбработкаНумерации = _ПО.ПолучитьОбработку(ВнешнийНумератор);
		ОбработкаНумерации.УстановитьНомерАкта(Объект);
	
	КонецЕсли; 
	
КонецПроцедуры

&НаСервере
Процедура _УстановитьНомерСчетаФактуры()
	
	ПорядокПрисвоенияНомеров = _ДС().УП.ПорядокПрисвоенияНомеров;
	ВнешнийНумератор = _ДС().УП.ВнешнийНумератор;
	
	Если (ПорядокПрисвоенияНомеров = Перечисления.CW_ПорядокПрисвоенияИсходящихНомеров.ВПределахДаты) ИЛИ
		 (ПорядокПрисвоенияНомеров = Перечисления.CW_ПорядокПрисвоенияИсходящихНомеров.СплошнаяНумерация) 
	Тогда
		
		Объект.НомерСчетаФактуры = Объект.Номер;
		
	ИначеЕсли (ПорядокПрисвоенияНомеров = Перечисления.CW_ПорядокПрисвоенияИсходящихНомеров.НезависимаяНумерация) Тогда 
		
		НовыйСФ = Документы.СчетФактураВыданный.СоздатьДокумент();
		НовыйСФ.ВидСчетаФактуры=Перечисления.ВидСчетаФактурыВыставленного.НаРеализацию;
		НовыйСФ.Организация = Объект.Организация;
		НовыйСФ.Дата = Объект.ДатаСчетаФактуры;
		НовыйСФ.УстановитьНовыйНомер();
		// --- 
		Объект.НомерСчетаФактуры = НовыйСФ.Номер;
		НовыйСФ = Неопределено;
		
	ИначеЕсли (ПорядокПрисвоенияНомеров = Перечисления.CW_ПорядокПрисвоенияИсходящихНомеров.ВнешнийНумератор) Тогда 
		
		ОбработкаНумерации = _ПО.ПолучитьОбработку(ВнешнийНумератор);
		ОбработкаНумерации.УстановитьНомерСчетаФактуры(Объект);
		
	КонецЕсли; 
	
	Если Объект.ВидОперацииКорректировки = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсправленияПоступленияРеализации.ИсправлениеОшибки") тогда
		ИсправлениеПолучитьНомерНаСервере();
	КонецЕсли;
	
КонецПроцедуры

