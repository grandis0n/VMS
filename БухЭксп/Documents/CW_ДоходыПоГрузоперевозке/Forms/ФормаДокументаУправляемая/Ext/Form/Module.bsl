Процедура УслугиКорректировкаНоменклатураПриИзмененииНаСервере()
	_Номенклатура = Объект.Услуги.НайтиПоИдентификатору(Элементы.УслугиКорректировка.ТекущаяСтрока).Номенклатура;
	Для Каждого ид Из Элементы.УслугиКорректировка.ВыделенныеСтроки Цикл
		строкаУслуги = Объект.Услуги.НайтиПоИдентификатору(ид);
		строкаУслуги.Номенклатура = _Номенклатура;
		_УслугиНоменклатураПриИзменении(ид);
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура _УслугиНоменклатураПриИзменении(Строка)
	
	СтрокаТЧ = Объект.Услуги.НайтиПоИдентификатору(Строка);
	
	Если ЗначениеЗаполнено(СтрокаТЧ.Номенклатура) Тогда 
		
		Если _ДС().НП.ПодставлятьСтавкуНДС или Не ЗначениеЗаполнено(СтрокаТЧ.СтавкаНДС) Тогда   
			
			ПараметрыСтавкиНДС = Новый Структура;
			ПараметрыСтавкиНДС.Вставить("Дата", 		Объект.Дата);
			ПараметрыСтавкиНДС.Вставить("Организация", 	Объект.Организация);
			ПараметрыСтавкиНДС.Вставить("Номенклатура", СтрокаТЧ.Номенклатура);
			ПараметрыСтавкиНДС.Вставить("Договор", 		Объект.Договор); 
			ПараметрыСтавкиНДС.Вставить("ПодставлятьСтавкуНДС",_ДС().НП.ПодставлятьСтавкуНДС); 
			ПараметрыСтавкиНДС.Вставить("ТипДвижения", "ДОХОДЫ");
			
			СтрокаТЧ.СтавкаНДС = CW_Документы.ПолучитьСтавкуНДС(ПараметрыСтавкиНДС);
		КонецЕсли;
		
		// пробуем найти в регистре
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		|	CW_СтатьиЗатратНоменклатуры.СтатьяЗатрат
		|ИЗ
		|	РегистрСведений.CW_СтатьиЗатратНоменклатуры КАК CW_СтатьиЗатратНоменклатуры
		|ГДЕ
		|	CW_СтатьиЗатратНоменклатуры.Номенклатура = &Номенклатура";
		Запрос.УстановитьПараметр("Номенклатура", СтрокаТЧ.Номенклатура);
		ТЗ = Запрос.Выполнить().Выгрузить();
		СтрокаСтатьяЗатрат = _сф.к_ПервыйЭлемент(ТЗ);
		Если (СтрокаСтатьяЗатрат <> Неопределено) Тогда
			СтрокаТЧ.СтатьяЗатрат = СтрокаСтатьяЗатрат.СтатьяЗатрат;
		Иначе
			СтрокаТЧ.СтатьяЗатрат = _ДС().УП.ОсновнаяСтатьяЗатрат;
		КонецЕсли; 
		
		Грузоперевозка = СтрокаТЧ.Грузоперевозка;
		//Получаем количество из Параметра
		Если РазрешитьПолучениеКоличестваУслугИзпараметраГрузоперевозки тогда
			
			ЗначениеПараметра 	=  0;
			СтруктураПараметров = новый Структура("ТипПеревозки,Номенклатура,ЕдиницаИзмерения", Грузоперевозка.ТипПеревозки,СтрокаТЧ.Номенклатура,СтрокаТЧ.Номенклатура.ЕдиницаИзмерения);
			НайденныйПараметр 	= CW_Документы.ПолучитьПараметрДляПодстановкиЗначенияВКоличество(СтруктураПараметров);
			
			Если НайденныйПараметр <> Неопределено Тогда
				//Получаем только первое значение
				СтрокаПараметраГП = Грузоперевозка.ПараметрыГрузоперевозки.Найти(НайденныйПараметр, "Параметр");
				
				Если СтрокаПараметраГП <> Неопределено Тогда
					ЗначениеПараметра =  СтрокаПараметраГП.Значение;
				КонецЕсли;
				
			КонецЕсли;	
			
			Если Не УстановитьЗначениеНольЗначениеПараметраНеУстановлено и Не ЗначениеЗаполнено(ЗначениеПараметра) Тогда
				ЗначениеПараметра = 1;
			КонецЕсли;
			
			СтрокаТЧ.Количество =  ЗначениеПараметра;
			
		КонецЕсли;
		
	КонецЕсли;
	
	// пробуем переформировать представление номенклатуры
	Если НЕ НеЗаменятьПредставлениеНоменклатуры Тогда
		ПараметрыШаблона = CW_Шаблоны.ПолучитьПараметрШаблонаУслуг();
		
		ПараметрыШаблона.Номенклатура 	= СтрокаТЧ.Номенклатура;
		ПараметрыШаблона.Объект 		= Объект;
		ПараметрыШаблона.Дата 			= Объект.Дата;
		ПараметрыШаблона.Договор 		= Объект.Договор;
		ПараметрыШаблона.ВидДоговора 	= Объект.Договор.ВидДоговора;
		ПараметрыШаблона.ПриложениеКДоговору = Объект.ПриложениеКДоговору;
		
		CW_Шаблоны.УстановитьПредставлениеНоменклатурыВСтроке(СтрокаТЧ, ПараметрыШаблона); 
	КонецЕсли;

	Если Не РазрешитьПолучениеКоличестваУслугИзпараметраГрузоперевозки тогда
		Если (СтрокаТЧ.Количество = 0) Тогда
			СтрокаТЧ.Количество = 1;
		КонецЕсли; 
	КонецЕсли;
	
	// установка цены номенклатуры 
	ИспользуетсяОграничениеУслуг = ПолучитьОграничениеУслугПоНоменклатуре(СтрокаТЧ.ПорядокОтражения);
	Если ИспользуетсяОграничениеУслуг  Тогда
		
		Если ЭтоАдресВременногоХранилища(АдресУслугПоДоговору) Тогда
			
			СтруктураПараметров = Новый Структура;
			СтруктураПараметров.Вставить("АдресУслугПоДоговору"						, АдресУслугПоДоговору);
			СтруктураПараметров.Вставить("УстанавливатьЦенуВЗависимостиОтГруза"		, УстанавливатьЦенуВЗависимостиОтГруза);
			СтруктураПараметров.Вставить("УстанавливатьЦенуВЗависимостиОтКлиента"	, Ложь);
			
			СтруктураПараметров.Вставить("Номенклатура"							, СтрокаТЧ.Номенклатура);
			Если УстанавливатьЦенуВЗависимостиОтГруза Тогда
				СтруктураПараметров.Вставить("Груз" , СтрокаТЧ.Грузоперевозка.Груз);
			КонецЕсли;
					
			УслугаДоговора = _УФС.ПолучитьУслугуДоговораПоПараметрам(СтруктураПараметров);			
			
			Если УслугаДоговора <> Неопределено Тогда 	
				
				Если ЗначениеЗаполнено(УслугаДоговора.ПорядокОтражения) Тогда
					СтрокаТЧ.ПорядокОтражения = УслугаДоговора.ПорядокОтражения;
					
					// очищаем документ расходов и базу если собственная
					Если (СтрокаТЧ.ПорядокОтражения = ПредопределенноеЗначение("Перечисление.CW_ПорядокОтраженияДоходов.СобственнаяУслуга")) 
						ИЛИ (СтрокаТЧ.ПорядокОтражения = ПредопределенноеЗначение("Перечисление.CW_ПорядокОтраженияДоходов.ПеревыставлениеПоСтавкам"))
						Тогда
						СтрокаТЧ.ДокументРасходов = Неопределено;
						СтрокаТЧ.База = 0;
					КонецЕсли; 
					
				КонецЕсли;
				
				СтрокаТЧ.Цена			= УслугаДоговора.ЦенаБезНДС;
				
				Если СтрокаТЧ.СтавкаНДС <> УслугаДоговора.СтавкаНДС и ЗначениеЗаполнено(УслугаДоговора.СтавкаНДС) Тогда
					СтрокаТЧ.СтавкаНДС	= УслугаДоговора.СтавкаНДС;
				КонецЕсли;
				
				Если УслугаДоговора.ВариантРасчетаНДС = Перечисления.ВариантыРасчетаНДС.НДССверху тогда
					СтрокаТЧ.Сумма 		= УслугаДоговора.ЦенаБезНДС * СтрокаТЧ.Количество;
					ОбратныйПересчет = Ложь;
				Иначе //в сумме
					СтрокаТЧ.Всего = УслугаДоговора.Цена * СтрокаТЧ.Количество;
					ОбратныйПересчет = Истина;
				КонецЕсли;
				
				Ставка = CW_Финансы.ПолучитьСтавкуНДС(УслугаДоговора.СтавкаНДС);
				
				Если ОбратныйПересчет Тогда
					
					СтрокаТЧ.НДС 	= СтрокаТЧ.Всего*(Ставка/(100+Ставка));
					СтрокаТЧ.Сумма 	= СтрокаТЧ.Всего - СтрокаТЧ.НДС;
					СтрокаТЧ.Цена 	= _сф.БезопасноРазделить(СтрокаТЧ.Сумма,СтрокаТЧ.Количество);
					
				Иначе
					
					СтрокаТЧ.НДС 	= СтрокаТЧ.Сумма*(Ставка/100);
					СтрокаТЧ.Всего 	= СтрокаТЧ.Сумма+СтрокаТЧ.НДС;
					
				КонецЕсли; 
				
			КонецЕсли; 
			
		КонецЕсли;
	Иначе
		ТД = СтрокаТЧ;
		Если ТД.Цена = 0  Тогда
			
			ТипЦен = _ДС().ПД.ТипЦен;
			Если НЕ ТипЦен.Пустая() Тогда
				
				СК = CW_Финансы.ПолучитьКурсВалюты(Объект.Валюта,_ДатаВозникновенияЗадолженности());
				Цена = Ценообразование.ПолучитьЦенуНоменклатуры(СтрокаТЧ.Номенклатура, ТипЦен, _ДатаВозникновенияЗадолженности(), Объект.Валюта, СК.Курс,СК.Кратность);
				Если Цена <> 0 Тогда
					
					Если ТипЦен.ЦенаВключаетНДС Тогда
						
						Если ЗначениеЗаполнено(ТД.СтавкаНДС) И ЗначениеЗаполнено(ТД.Количество) Тогда
							
							ТД.Цена 	= Цена;
							ТД.Всего 	= Цена*ТД.Количество;
							Ставка 		= CW_Финансы.ПолучитьСтавкуНДС(ТД.СтавкаНДС)/100;
							ТД.НДС 		= ТД.Всего*Ставка/(1+Ставка);
							ТД.Сумма 	= ТД.Всего - ТД.НДС;
							
						Иначе
							
							Если ЗначениеЗаполнено(ТД.СтавкаНДС) Тогда
								
								СтавкаНДСПроцент = CW_Финансы.ПолучитьСтавкуНДС(ТД.СтавкаНДС)/100;
								ТД.Цена = Цена/(1+СтавкаНДСПроцент);
								
							КонецЕсли; 
							
						КонецЕсли; 
						
					Иначе
						
						Если ЗначениеЗаполнено(ТД.СтавкаНДС) И ЗначениеЗаполнено(ТД.Количество) Тогда
							
							ТД.Цена = Цена;
							ТД.Сумма = ТД.Цена * ТД.Количество;
							ТД.НДС = ТД.Сумма * CW_Финансы.ПолучитьСтавкуНДС(ТД.СтавкаНДС)/100;
							ТД.Всего = ТД.Сумма + ТД.НДС;
							
						Иначе
							
							ТД.Цена = Цена;
							
						КонецЕсли; 
						
					КонецЕсли; 
					
				КонецЕсли; 
				
			КонецЕсли; 
			
		КонецЕсли; 
		
	КонецЕсли; 
	
	ПересчитатьСтрокуНаСерере(СтрокаТЧ.ПолучитьИдентификатор(),Объект.ЦенаСНДС);
	
	// --- 
КонецПроцедуры

&НаКлиенте
Процедура УслугиПредставлениеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка=Ложь;
	_УслугиПредставлениеНачалоВыбора(Элементы.Услуги.ТекущаяСтрока);
	Элементы.Услуги.ТекущийЭлемент = Элементы.УслугиПорядокОтражения;
	
КонецПроцедуры

&НаСервере
Процедура _УслугиПредставлениеНачалоВыбора(Строка)
	
	СтрокаТЧ = Объект.Услуги.НайтиПоИдентификатору(Строка);
	ПараметрыШаблона = CW_Шаблоны.ПолучитьПараметрШаблонаУслуг();
	
	ПараметрыШаблона.Номенклатура 	= СтрокаТЧ.Номенклатура;
	ПараметрыШаблона.Объект 		= Объект;
	ПараметрыШаблона.Дата 			= Объект.Дата;
	ПараметрыШаблона.Договор 		= Объект.Договор;
	ПараметрыШаблона.ВидДоговора 	= Объект.Договор.ВидДоговора;
	ПараметрыШаблона.ПриложениеКДоговору = Объект.ПриложениеКДоговору;
	
	CW_Шаблоны.УстановитьПредставлениеНоменклатурыВСтроке(СтрокаТЧ, ПараметрыШаблона); 
	
КонецПроцедуры

&НаСервере
Процедура _ПереформироватьПредставлениеУслуг(Знач Строки)
	
	Если CW_ДополнительныеРеквизитыСлужебный.ИспользуютсяДополниительныеРеквизиты() Тогда 
		// надо перенести значения в таб.часть ДополнительныеРеквизиты
		// СтандартныеПодсистемы.Свойства
		УправлениеСвойствамиСлужебный.ПеренестиЗначенияИзРеквизитовФормыВОбъект(ЭтотОбъект, Неопределено, Ложь);
		// Конец СтандартныеПодсистемы.Свойства
	КонецЕсли;	

	Для каждого Идентификатор Из Строки Цикл
		_УслугиПредставлениеНачалоВыбора(Идентификатор);
	КонецЦикла; 
	
КонецПроцедуры
 

&НаКлиенте
Процедура Услуги_ПереформироватьПредставление(Команда)
	
	_ПереформироватьПредставлениеУслуг(Элементы.Услуги.ВыделенныеСтроки);
	
КонецПроцедуры

&НаКлиенте
Процедура УслугиКорректировка_ПереформироватьПредставление(Команда)
	
	_ПереформироватьПредставлениеУслуг(Элементы.УслугиКорректировка.ВыделенныеСтроки);
	
КонецПроцедуры

#КонецОбласти 

#Область УслугиСуммы 

&НаКлиенте
Процедура УслугиКоличествоПриИзменении(Элемент)
	
	ПересчитатьСтрокуНаСерере(Элементы.Услуги.ТекущиеДанные.ПолучитьИдентификатор(),Объект.ЦенаСНДС);
	
КонецПроцедуры

&НаКлиенте
Процедура УслугиЦенаПриИзменении(Элемент)
	
	ПересчитатьСтрокуНаСерере(Элементы.Услуги.ТекущиеДанные.ПолучитьИдентификатор(),Объект.ЦенаСНДС);
	
КонецПроцедуры

&НаКлиенте
Процедура УслугиСтавкаНДСПриИзменении(Элемент)
	
	ПересчитатьСтрокуНаСерере(Элементы.Услуги.ТекущиеДанные.ПолучитьИдентификатор(),Объект.ЦенаСНДС);
	
КонецПроцедуры

&НаКлиенте
Процедура УслугиСуммаВсегоПриИзменении(Элемент)
	
	ТД = Элементы.Услуги.ТекущиеДанные;
	
	Ставка = CW_Финансы.ПолучитьСтавкуНДС(ТД.СтавкаНДС)/100;
	ТД.НДС = ТД.Всего*Ставка/(1+Ставка);
	ТД.Сумма = ТД.Всего - ТД.НДС;
	
	ПересчитатьСтрокуНаСерере(ТД.ПолучитьИдентификатор(),Объект.ЦенаСНДС, Истина);

КонецПроцедуры

&НаКлиенте
Процедура УслугиСуммаНДСПриИзменении(Элемент)
	
	ТД = Элементы.Услуги.ТекущиеДанные;
	
	Если НЕ _ДС().НП.ОбратныйПересчетВДокументах Тогда
		ТД.Всего = ТД.Сумма + ТД.НДС;
	Иначе
		ТД.Сумма = ТД.Всего - ТД.НДС;
		ПересчитатьСтрокуНаСерере(ТД.ПолучитьИдентификатор(),Объект.ЦенаСНДС, Истина);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УслугиСуммаПриИзменении(Элемент)
	
	_УслугиСуммаПриИзменении(Элементы.Услуги.ТекущаяСтрока);
	
КонецПроцедуры

&НаСервере
Процедура _УслугиСуммаПриИзменении(Строка)
	// --- 
	
	ТД = Объект.Услуги.НайтиПоИдентификатору(Строка);
	
	Ставка 		= CW_Финансы.ПолучитьСтавкуНДС(ТД.СтавкаНДС);
	
	ТД.НДС 		= CW_Финансы.РассчитатьСуммуНДС(ТД.Сумма, Истина, Ложь, Ставка);
	ТД.Всего 	= ТД.Сумма + ТД.НДС;
	
	ПересчитатьСтрокуНаСерере(ТД.ПолучитьИдентификатор(),Объект.ЦенаСНДС,Истина);
	
	// --- 
КонецПроцедуры

// --- 

&НаСервере
Процедура ОбновитьИтогиПоУслугам()
	
	// итоговая строка по табличной части "Услуги" 
	СВ = Строка(Объект.Валюта);
	ФЧ = "ЧЦ=15; ЧДЦ=2; ЧН=";
	
	Если (НЕ Объект.Корректировка) Тогда
		
		Элементы.СтраницаУслуги.Заголовок = " Услуги (" +Объект.Услуги.Количество() + ")";
		Если Объект.Услуги.Количество() = 0 Тогда
			ИтогоПоУслугам = "Сведения об услугах отсутствуют";
		Иначе
			ИтогоПоУслугам=	"Строк: "+Объект.Услуги.Количество()+
			";  Сумма: "+Формат(Объект.Услуги.Итог("Сумма"),ФЧ)+" "+СВ+ 
			";  НДС: "+Формат(Объект.Услуги.Итог("НДС"),ФЧ)+" "+СВ+
			";  Всего: "+Формат(Объект.Услуги.Итог("Всего"),ФЧ)+" " +СВ;
		КонецЕсли;
		
	Иначе
		
		Если Объект.Услуги.Количество() = 0 Тогда
			ИтогоПоУслугам_Корректировка = "Сведения об услугах отсутствуют";
		Иначе
			ИтогоПоУслугам_Корректировка =	"Строк: "+Объект.Услуги.Количество()+
			";  Сумма: "+Формат(Объект.Услуги.Итог("Сумма")-Объект.Услуги.Итог("Сумма_ДоКорректировки"),ФЧ)+" "+СВ+ 
			";  НДС: "+Формат(Объект.Услуги.Итог("НДС")-Объект.Услуги.Итог("НДС_ДоКорректировки"),ФЧ)+" "+СВ+
			";  Всего: "+Формат(Объект.Услуги.Итог("Всего")-Объект.Услуги.Итог("Всего_ДоКорректировки"),ФЧ)+" " +СВ;
		КонецЕсли;
		
	КонецЕсли; 
	
	
						
КонецПроцедуры

// --- 

&НаКлиенте
Процедура Услуги_ГрупповоеРедактирование(Команда)
	
	Если Объект.Корректировка Тогда
		ТаблицаФормы = Элементы.УслугиКорректировка;
	Иначе
		ТаблицаФормы = Элементы.Услуги;
	КонецЕсли;

	// если нет выделенных строк
	Если ТаблицаФормы.ВыделенныеСтроки.Количество() = 0 Тогда
		ПоказатьПредупреждение(,"Для групповой обработки необходимо выделить строки!",10,"Предупреждение");
		Возврат;
	КонецЕсли; 
	
	// Получаем имя реквизта по его пути к данным
	ИмяРеквизитаТабличнойЧасти = ПолучитьИмяРеквизитаТабличнойЧасти(ТаблицаФормы.ТекущийЭлемент.Имя);
	Если ИмяРеквизитаТабличнойЧасти = Неопределено Тогда
		Возврат;
	КонецЕсли;      
	
	ИспользуетсяОгранчиениеУслуг = ПолучитьОграничениеУслугНоменклатурыПоТабличнойЧасти();	

	// параметры для открываемой формы
	ПФ = Новый Структура();
	ПФ.Вставить("Организация", 		Объект.Организация);
	ПФ.Вставить("ДатаДокумента", 	?(ЗначениеЗаполнено(Объект.Дата), Объект.Дата, ТекущаяДата()));
	ПФ.Вставить("Строк", 			ТаблицаФормы.ВыделенныеСтроки.Количество());
	ПФ.Вставить("Док", 				"Доходы");
	
	ПФ.Вставить("ТекущийРеквизит"				, ИмяРеквизитаТабличнойЧасти);
	ПФ.Вставить("ТекущееЗначение"				, ТаблицаФормы.ТекущиеДанные[ИмяРеквизитаТабличнойЧасти]);
	ПФ.Вставить("ТекущееЗначениеДополнительное"	, Неопределено);
	ПФ.Вставить("ЦенаСНДС"						, Объект.ЦенаСНДС);
	
	ПФ.Вставить("ИспользуетсяОгранчиениеУслуг"	, ИспользуетсяОгранчиениеУслуг);
	ПФ.Вставить("АдресУслугПоДоговору"			, АдресУслугПоДоговору);
	
	ПОВ = Новый ОписаниеОповещения("ОбработатьГрупповоеРедактирование", ЭтотОбъект);
	ОткрытьФорму("ОбщаяФорма.CW_ФормаГрупповогоРедактированияТЧ", ПФ, Этаформа,,,, ПОВ, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры  

&НаСервере
Функция ПолучитьОграничениеУслугНоменклатурыПоТабличнойЧасти()
	
	ОтборСтрок = Новый Структура;
	ОтборСтрок.Вставить("ПорядокОтражения",ПредопределенноеЗначение("Перечисление.CW_ПорядокОтраженияДоходов.СобственнаяУслуга")) ;
	мСтроки = Объект.Услуги.НайтиСтроки(ОтборСтрок);
	
	ИспользуетсяОгранчиениеУслуг = ОграничиватьУслугиПоДоговорам;
	Если НеОграничиватьУслугиПоПеревыставлению и мСтроки.Количество() = 0 Тогда
		ИспользуетсяОгранчиениеУслуг = Ложь;	
	КонецЕсли;
	
	Возврат ИспользуетсяОгранчиениеУслуг;
	
КонецФункции


&НаКлиенте
Процедура ОбработатьГрупповоеРедактирование(Ответ, ДопПар) Экспорт
	
	Если Ответ = Неопределено Тогда
		Возврат;
	ИначеЕсли НЕ ЗначениеЗаполнено(Ответ.Реквизит) Тогда
		Возврат;		
	Иначе	
		Реквизит = Ответ.Реквизит;
	КонецЕсли;
	
	Если Объект.Корректировка Тогда
		ТаблицаФормы = Элементы.УслугиКорректировка;
	Иначе
		ТаблицаФормы = Элементы.Услуги;
	КонецЕсли;
	
	ЦенаСНДС = Объект.ЦенаСНДС;
	
	мВС = ТаблицаФормы.ВыделенныеСтроки;
	КолСтр = мВС.Количество();
	Распределять = Ложь;
	Разница = 0;
	Если Ответ.Свойство("Распределить") Тогда
		Если Ответ.Распределить Тогда
			Распределять = Истина;
			Сумма = Окр(Ответ.Значение / КолСтр, 2);
			Разница = Ответ.Значение - Сумма * КолСтр;
		Иначе
			Сумма = Ответ.Значение;
		КонецЕсли;
	КонецЕсли;	
	
	мПорядокОтражения = Новый Массив;
	мПорядокОтражения.Добавить(ПредопределенноеЗначение("Перечисление.CW_ПорядокОтраженияДоходов.СобственнаяУслуга"));
	мПорядокОтражения.Добавить(ПредопределенноеЗначение("Перечисление.CW_ПорядокОтраженияДоходов.ПрочиеДоходы"));
	
	Для Каждого ВСтр из мВС Цикл 
		Стр = Объект.Услуги.НайтиПоИдентификатору(ВСтр);
		
		Если Реквизит = "Номенклатура" Тогда
			Стр.Номенклатура = Ответ.Значение;
			_УслугиНоменклатураПриИзменении(ВСтр);
			
		ИначеЕсли Реквизит = "СтатьяЗатрат" Тогда
			
			Стр.СтатьяЗатрат = Ответ.Значение;
			
		ИначеЕсли Реквизит = "Грузоперевозка" Тогда
			
			Стр.Грузоперевозка = Ответ.Значение;
			_УслугиГрузоперевозкаПриИзменении(Стр.ПолучитьИдентификатор());
			
		ИначеЕсли Реквизит = "Порядок отражения" Тогда
			Стр.ПорядокОтражения = Ответ.Значение;
			ПриИзмененииУслугиПорядокОтражения(Стр)
		ИначеЕсли Реквизит = "Документ затрат" Тогда
			Если Стр.ПорядокОтражения = ПредопределенноеЗначение("Перечисление.CW_ПорядокОтраженияДоходов.Перевыставление") Тогда
				Стр.ДокументРасходов = Ответ.Значение;
			Иначе
				Стр.ДокументРасходов = Неопределено;
			КонецЕсли; 
		ИначеЕсли Реквизит = "Количество" Тогда
			Стр.Количество = Ответ.Значение;
			ПересчитатьСтрокуНаСерере(ВСтр,ЦенаСНДС);
		ИначеЕсли Реквизит = "Цена" Тогда
			Стр.Цена = Сумма;
			ПересчитатьСтрокуНаСерере(ВСтр,ЦенаСНДС);
		ИначеЕсли Реквизит = "Сумма" Тогда
			Стр.Сумма = Сумма;
			Стр.Цена = _сф.БезопасноРазделить(Стр.Сумма, Стр.Количество);
			Ставка = CW_Финансы.ПолучитьСтавкуНДС(Стр.СтавкаНДС);
			Стр.НДС = CW_Финансы.РассчитатьСуммуНДС(Стр.Сумма, Истина, Ложь, Ставка);
			Стр.Всего = Стр.Сумма + Стр.НДС;
			ПересчитатьСтрокуНаСерере(ВСтр,ЦенаСНДС,Истина);
		ИначеЕсли Реквизит = "Ставка НДС" Тогда
			Стр.СтавкаНДС = Ответ.Значение;
			ПересчитатьСтрокуНаСерере(ВСтр,ЦенаСНДС);
		ИначеЕсли Реквизит = "Сумма НДС" Тогда
			Стр.НДС = Сумма;
			Если НЕ _ДС().НП.ОбратныйПересчетВДокументах Тогда
				Стр.Всего = Стр.Сумма + Стр.НДС;
			Иначе
				Стр.Сумма = Стр.Всего - Стр.НДС;
				Стр.Цена  = _сф.БезопасноРазделить(Стр.Сумма, Стр.Количество);
			КонецЕсли;
			ПересчитатьСтрокуНаСерере(ВСтр,ЦенаСНДС, Истина);
		ИначеЕсли Реквизит = "Всего" Тогда
			Стр.Всего 	= Сумма;
			Ставка 		= CW_Финансы.ПолучитьСтавкуНДС(Стр.СтавкаНДС)/100;
			Стр.НДС   	= Стр.Всего * Ставка / (1 + Ставка);
			Стр.Сумма 	= Стр.Всего - Стр.НДС;
			Стр.Цена  	= _сф.БезопасноРазделить(Стр.Сумма, Стр.Количество);
			ПересчитатьСтрокуНаСерере(ВСтр,ЦенаСНДС, Истина);
			
		ИначеЕсли Реквизит = "Представление" Тогда
			
			ДополнитьПредставление 	= Ложь;
			Если Ответ.Свойство("Дополнять") Тогда
				ДополнитьПредставление = Ответ.Дополнять;
			КонецЕсли;
			
			Если ДополнитьПредставление Тогда
				Стр.Представление = Стр.Представление + СокрП(Ответ.Значение);
			Иначе
				Стр.Представление = СокрЛП(Ответ.Значение);
			КонецЕсли;
			
		ИначеЕсли Реквизит = "ПрочиеДоходы" Тогда
			
			Стр.ПрочиеДоходы = Ответ.Значение;
			
		ИначеЕсли Реквизит = "РеестрыНДС0Приложение" Тогда
			
			Если Стр.СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС0") 
				И мПорядокОтражения.Найти(Стр.ПорядокОтражения) <> Неопределено  Тогда
				Стр.РеестрыНДС0Приложение = Ответ.Значение;
			КонецЕсли;
				
		КонецЕсли;	
	КонецЦикла;	
	
	Если Распределять И Разница <> 0 Тогда
		Если Реквизит = "Цена" Тогда
			Стр.Цена = Сумма + Разница;
			ПересчитатьСтрокуНаСерере(ВСтр,ЦенаСНДС);
		ИначеЕсли Реквизит = "Сумма" Тогда
			Стр.Сумма = Сумма + Разница;
			Стр.Цена = _сф.БезопасноРазделить(Стр.Сумма, Стр.Количество);
			Ставка = CW_Финансы.ПолучитьСтавкуНДС(Стр.СтавкаНДС);
			Стр.НДС = CW_Финансы.РассчитатьСуммуНДС(Стр.Сумма, Истина, Ложь, Ставка);
			Стр.Всего = Стр.Сумма + Стр.НДС;
			ПересчитатьСтрокуНаСерере(ВСтр,ЦенаСНДС, Истина);
		ИначеЕсли Реквизит = "Сумма НДС" Тогда
			Стр.НДС = Сумма + Разница;
			Если НЕ _ДС().НП.ОбратныйПересчетВДокументах Тогда
				Стр.Всего = Стр.Сумма + Стр.НДС;
			Иначе
				Стр.Сумма = Стр.Всего - Стр.НДС;
				Стр.Цена  = _сф.БезопасноРазделить(Стр.Сумма, Стр.Количество);
			КонецЕсли;
			ПересчитатьСтрокуНаСерере(ВСтр,ЦенаСНДС, Истина);
		ИначеЕсли Реквизит = "Всего" Тогда
			Стр.Всего = Сумма + Разница;
			Ставка = CW_Финансы.ПолучитьСтавкуНДС(Стр.СтавкаНДС)/100;
			Стр.НДС   = Стр.Всего * Ставка / (1 + Ставка);
			Стр.Сумма = Стр.Всего - Стр.НДС;
			Стр.Цена  = _сф.БезопасноРазделить(Стр.Сумма, Стр.Количество);
			ПересчитатьСтрокуНаСерере(ВСтр,ЦенаСНДС, Истина);
		КонецЕсли;	
	КонецЕсли;	
	
	ОбновитьИтогиПоУслугам();
	
КонецПроцедуры	

&НаСервере
Функция ПолучитьИмяРеквизитаТабличнойЧасти(ИмяРеквизитаФормы)
	
	ЭлементФрмы = Элементы.Найти(ИмяРеквизитаФормы);
	мПутьРеквизита = СтрРазделить(ЭлементФрмы.ПутьКДанным,".", Ложь);
	
	//Всегда реквизит табличной части, имя реквизита всегда по индексу 2
	Если мПутьРеквизита.Количество() <> 3 Тогда
		//Это не реквизит табичной части
		Возврат Неопределено;
	КонецЕсли;
	
	ИмяРеквизита = мПутьРеквизита[2];
	
	МассивЗапрещенныхРеквизитов = ПолучитьМассивЗапрещенныхРеквизитов();
	Если МассивЗапрещенныхРеквизитов.Найти(ИмяРеквизита) <> Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ЕстьРеквизитОбъекта	= ОбщегоНазначения.ЕстьРеквизитОбъекта(ИмяРеквизита, Метаданные.Документы.CW_ДоходыПоГрузоперевозке.ТабличныеЧасти.Услуги);
	Если ЕстьРеквизитОбъекта Тогда
		Возврат ИмяРеквизита;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

&НаСервере
Функция ПолучитьМассивЗапрещенныхРеквизитов()
	
	Массив = Новый Массив;
	
	Массив.Добавить("Представление_ДоКорректировки");
	Массив.Добавить("Количество_ДоКорректировки");
	Массив.Добавить("Цена_ДоКорректировки");
	Массив.Добавить("Сумма_ДоКорректировки");
	Массив.Добавить("СтавкаНДС_ДоКорректировки");
	Массив.Добавить("НДС_ДоКорректировки");
	Массив.Добавить("Всего_ДоКорректировки");
	
	Возврат Массив;
	
КонецФункции

