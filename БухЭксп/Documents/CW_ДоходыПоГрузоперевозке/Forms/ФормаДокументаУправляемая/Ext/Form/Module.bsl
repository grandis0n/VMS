&НаКлиенте
Процедура ЗаполнитьАвансы(Команда)
	
	Если (Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаЗачетАвансов) Тогда
		
		ПроверяемыйДокумент = Объект.ВедомыйДокумент;
		ТЧ = Объект.ЗачетАвансов;
		
	ИначеЕсли (Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаЗачетАвансовОЗ) Тогда 
		
		ПроверяемыйДокумент = Объект.Ссылка; 
		ТЧ = Объект.ЗачетАвансовОЗ;
		
	КонецЕсли; 
	
	Если ПроверяемыйДокумент.Пустая() Тогда
		
		ПОВ = Новый ОписаниеОповещения("ОбработкаОтветаЗаписиПриЗаполненииАвансов",ЭтотОбъект); 
		ПоказатьВопрос(ПОВ,"Документ не записан! Записать?", РежимДиалогаВопрос.ДаНет);
		
	Иначе
		
		ВыполнитьЗачетАвансов();
		
	КонецЕсли; 
	
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОтветаЗаписиПриЗаполненииАвансов(Ответ, ДополнительныеПараметры) Экспорт 
	// --- 
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		Записать();
		ВыполнитьЗачетАвансов();
	Иначе
		Возврат;
	КонецЕсли; 
	
	// --- 
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьЗачетАвансов()
	// --- 
	
	Если (Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаЗачетАвансов) Тогда
		
		ПроверяемыйДокумент = Объект.ВедомыйДокумент;
		ТЧ = Объект.ЗачетАвансов;
		
	ИначеЕсли (Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаЗачетАвансовОЗ) Тогда 
		
		ПроверяемыйДокумент = Объект.Ссылка; 
		ТЧ = Объект.ЗачетАвансовОЗ;
		
	КонецЕсли; 
	
	// ---------------------------------------------------------------------------- 
	
	БУ = (Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаЗачетАвансов);
	ОЗ = (Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаЗачетАвансовОЗ);
	
	ПФ = _ПараметрыФормыПодбораАвансов(БУ, ОЗ);
	Если ПФ.Количество = 0 Тогда
		
		_УФК.ВывестиПредупреждение("Доступных авансов не найдено.");
		ТЧ.Очистить();
		Возврат;
		
	КонецЕсли; 
	
	ПОВ = Новый ОписаниеОповещения("ОбработкаЗаполненияАвансов",ЭтотОбъект, Новый Структура("БУ,ОЗ",БУ,ОЗ)); 
	ОткрытьФорму("ОбщаяФорма.CW_ФормаЗачетаАвансов",ПФ,,,,,ПОВ, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
	
	// --- 
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаЗаполненияАвансов(Ответ, ДополнительныеПараметры) Экспорт
	// --- 
	
	Если Ответ <> Неопределено Тогда
		
		_ЗагрузитьРезультатПодбораАванса(Ответ,ДополнительныеПараметры.БУ,ДополнительныеПараметры.ОЗ);
		
	КонецЕсли; 
	
	// --- 
КонецПроцедуры

&НаСервере
Функция _ПараметрыФормыПодбораАвансов(БУ,ОЗ)
	// --- 
	
	ПФ = Новый Структура("Документ,ЗачетБУ,ЗачетОЗ,Валюта,СуммаСобственных,СуммаПеревыставляемых,ТаблицаАвансов,СчетАвансовПоСобственным,СчетАвансовПоПеревыставляемым,Количество,ОЗ,РаздельныйУчетЗаполженности");
	// ---------------------------------------------------------------------------- 
	ПФ.Документ = Документы.CW_ДоходыПоГрузоперевозке.ПустаяСсылка();
	ПФ.ЗачетБУ = БУ;
	ПФ.ЗачетОЗ = ОЗ;
	ПФ.Валюта = Объект.Валюта;
	ПФ.РаздельныйУчетЗаполженности = РаздельныйУчетЗаполженности;;
	// ---------------------------------------------------------------------------- 
	
	ПараметрыТА = Новый Структура("Дата,Договор,ПриложениеКДоговору,ОЗ,Акт,РаздельныйУчетЗаполженности,ПереплатаКакАванс");
	// --- 
	ПараметрыТА.Договор = Объект.Договор;
	
	//Подсистема УчетПриложенийДоговоров
	ПараметрыТА.ПриложениеКДоговору = Объект.ПриложениеКДоговору;
	//Подсистема УчетПриложенийДоговоров
	
	ПараметрыТА.ОЗ = ОперативныйУчет;
	ПараметрыТА.Акт = Объект.Ссылка;
	ПараметрыТА.РаздельныйУчетЗаполженности = РаздельныйУчетЗаполженности;
	ПараметрыТА.ПереплатаКакАванс 			= ПереплатаКакАванс;
	// --- 
	Услуги = Объект.Услуги.Выгрузить();
	Если (ОперативныйУчет) Тогда
		Если (НЕ Объект.СписокСчетов) Тогда
			Если (ЗначениеЗаполнено(Объект.Счет)) Тогда
				Услуги.ЗаполнитьЗначения(Объект.Счет,"Счет");
			Иначе
				Услуги.ЗаполнитьЗначения(Объект.Ссылка,"Счет");
			КонецЕсли; 
		КонецЕсли; 
	КонецЕсли;  
	
	Если (БУ) Тогда
		
		ПараметрыТА.Дата = Объект.ВедомыйДокумент.МоментВремени();
		ТаблицаАвансов = CW_Финансы.ТаблицаАвансов(ПараметрыТА,Услуги,Объект.ЗачетАвансов.Выгрузить(), Объект.ЗачетАвансовОЗ.Выгрузить());
		
	ИначеЕсли (ОЗ) Тогда 
		
		ПараметрыТА.Дата = Новый Граница(Объект.ДатаСчета,ВидГраницы.Исключая);
		ТаблицаАвансов = CW_Финансы.ТаблицаАвансовДляОЗ(ПараметрыТА,Услуги,Объект.ЗачетАвансовОЗ.Выгрузить());
		
	КонецЕсли; 
	
	// --- 
	Услуги.Свернуть("ПорядокОтражения", "Всего");
	СуммаСобственных 	= _сф.Итог(Услуги.Скопировать(Новый Структура("ПорядокОтражения",Перечисления.CW_ПорядокОтраженияДоходов.СобственнаяУслуга)),"Всего");
	СуммаПрочих 		= _сф.Итог(Услуги.Скопировать(Новый Структура("ПорядокОтражения",Перечисления.CW_ПорядокОтраженияДоходов.ПрочиеДоходы)),"Всего");
    ПФ.СуммаСобственных = СуммаСобственных + СуммаПрочих;
	
	ПФ.СуммаПеревыставляемых = _сф.Итог(Услуги,"Всего")-ПФ.СуммаСобственных;
	
	// ---------------------------------------------------------------------------- 
	
	// счета расчета по возмещаемым
	// --- 
	Счет_Рубли = _ДС().УП.СчетРасчетов_Клиенты_Рубли;
	Счет_Валюта = _ДС().УП.СчетРасчетов_Клиенты_Валюта;
	Счет_УЕ = _ДС().УП.СчетРасчетов_Клиенты_УЕ;
	// --- 
	ВРУ = _ДС().КО.ВалютаРегламентированногоУчета;
	// --- 
	Счета = CW_Конфигурация.ПланСчетов();
	
	// определяем счета
	Если Объект.Валюта=ВРУ Тогда
		// --- 
		ПФ.СчетАвансовПоСобственным = Счета.РасчетыПоАвансамПолученным;
		Если Счет_Рубли=Счета.РасчетыСПокупателями Тогда
			ПФ.СчетАвансовПоПеревыставляемым = Счета.РасчетыПоАвансамПолученным;
		Иначе
			ПФ.СчетАвансовПоПеревыставляемым = Счет_Рубли;
		КонецЕсли;
		// --- 
	Иначе
		Если Объект.Договор.ВзаиморасчетыВУЕ Тогда
			// --- 
			ПФ.СчетАвансовПоСобственным = Счета.РасчетыПоАвансамПолученнымУЕ;
			Если Счет_УЕ = Счета.РасчетыСПокупателямиУЕ Тогда
				ПФ.СчетАвансовПоПеревыставляемым = Счета.РасчетыПоАвансамПолученнымУЕ;
			Иначе
				ПФ.СчетАвансовПоПеревыставляемым = Счет_УЕ;
			КонецЕсли; 
			// --- 
		Иначе 
			// --- 
			ПФ.СчетАвансовПоСобственным = Счета.РасчетыПоАвансамПолученнымВал;
			Если Счет_Валюта = Счета.РасчетыСПокупателямиВал Тогда
				ПФ.СчетАвансовПоПеревыставляемым = Счета.РасчетыПоАвансамПолученнымВал;
			Иначе
				ПФ.СчетАвансовПоПеревыставляемым = Счет_Валюта;
			КонецЕсли; 
			// --- 
		КонецЕсли;	
	КонецЕсли; 
	
	// ---------------------------------------------------------------------------- 
	
	ПФ.ТаблицаАвансов = ПоместитьВоВременноеХранилище(ТаблицаАвансов,ЭтаФорма.УникальныйИдентификатор);
	ПФ.Количество = ТаблицаАвансов.Количество();
	// --- 
	ПФ.ОЗ = _ДС().УП.ОЗ;
	
	// ---------------------------------------------------------------------------- 
	
	Возврат(ПФ);
	
	// --- 
КонецФункции

&НаСервере
Процедура _ЗагрузитьРезультатПодбораАванса(Адрес,БУ,ОЗ)
	// --- 
	
	Попытка
		
		Если (БУ) Тогда
			Объект.ЗачетАвансов.Загрузить(ПолучитьИзВременногоХранилища(Адрес));
		ИначеЕсли (ОЗ) Тогда 
			Объект.ЗачетАвансовОЗ.Загрузить(ПолучитьИзВременногоХранилища(Адрес));
		КонецЕсли; 
		
		ОбновитьИтогиПоАвансам();
		
	Исключение
	    //ОписаниеОшибки()
	КонецПопытки; 
	
	
	// --- 
КонецПроцедуры

// --- 

Процедура ОбновитьИтогиПоАвансам()
	// --- 
	
	СВ = Строка(Объект.Валюта);
	ФЧ = "ЧЦ=15; ЧДЦ=2; ЧН=";
	Если Объект.ЗачетАвансов.Количество() = 0 Тогда
		ИтогоПоАвансам = "Нет зачтённых авансов";
	Иначе
		ИтогоПоАвансам=	"Зачтено:  "+Формат(Объект.ЗачетАвансов.Итог("СуммаЗачета"),ФЧ)+" "+СВ;
	КонецЕсли;
	Если Объект.ЗачетАвансов.Итог("СуммаЗачета") > Объект.Услуги.Итог("Всего") Тогда
		
		Элементы.ИтогоПоАвансам.ЦветТекста = ЦветаСтиля.ЦветОсобогоТекста;
		
	Иначе
		
		Элементы.ИтогоПоАвансам.ЦветТекста = ЦветаСтиля.ЦветТекстаФормы;
		
	КонецЕсли; 
	// --- 
	Если Объект.ЗачетАвансовОЗ.Количество() = 0 Тогда
		ИтогоПоАвансамОЗ = "Нет зачтённых авансов";
	Иначе
		ИтогоПоАвансамОЗ =	"Зачтено:  "+Формат(Объект.ЗачетАвансовОЗ.Итог("СуммаЗачета"),ФЧ)+" "+СВ;
	КонецЕсли;
	Если Объект.ЗачетАвансовОЗ.Итог("СуммаЗачета") > Объект.Услуги.Итог("Всего") Тогда
		
		Элементы.ИтогоПоАвансамОЗ.ЦветТекста = ЦветаСтиля.ЦветОсобогоТекста;
		
	Иначе
		
		Элементы.ИтогоПоАвансамОЗ.ЦветТекста = ЦветаСтиля.ЦветТекстаФормы;
		
	КонецЕсли; 	
	// --- 
КонецПроцедуры

