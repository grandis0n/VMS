#Область ЗаполнитьПоНеактированнымСчетам

&НаСервере
Процедура ОбработкаВыбораСчетоДляЗаполненеия(Ответ, ДополнительныеПараметры) Экспорт 
	
	Если Ответ <> Неопределено Тогда
		ОбработатьРезультатаВыбора(Ответ, ДополнительныеПараметры);
	КонецЕсли; 
	
КонецПроцедуры

&НаСервере
Процедура ОбработатьРезультатаВыбора(РезультатВыбора,ДополнительныеПараметры)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	CW_ДоходыПоГрузоперевозкеУслуги.Номенклатура КАК Номенклатура,
	               |	CW_ДоходыПоГрузоперевозкеУслуги.Представление КАК Представление,
	               |	CW_ДоходыПоГрузоперевозкеУслуги.Количество КАК Количество,
	               |	CW_ДоходыПоГрузоперевозкеУслуги.Цена КАК Цена,
	               |	CW_ДоходыПоГрузоперевозкеУслуги.Сумма КАК Сумма,
	               |	CW_ДоходыПоГрузоперевозкеУслуги.СтавкаНДС КАК СтавкаНДС,
	               |	CW_ДоходыПоГрузоперевозкеУслуги.НДС КАК НДС,
	               |	CW_ДоходыПоГрузоперевозкеУслуги.Всего КАК Всего,
	               |	CW_ДоходыПоГрузоперевозкеУслуги.ПорядокОтражения КАК ПорядокОтражения,
	               |	CW_ДоходыПоГрузоперевозкеУслуги.Затраты КАК Затраты,
	               |	CW_ДоходыПоГрузоперевозкеУслуги.Грузоперевозка КАК Грузоперевозка,
	               |	CW_ДоходыПоГрузоперевозкеУслуги.СтатьяЗатрат КАК СтатьяЗатрат,
	               |	CW_ДоходыПоГрузоперевозкеУслуги.ДокументРасходов КАК ДокументРасходов,
	               |	CW_ДоходыПоГрузоперевозкеУслуги.База КАК База,
	               |	CW_ДоходыПоГрузоперевозкеУслуги.ВводОстатков КАК ВводОстатков,
	               |	CW_ДоходыПоГрузоперевозкеУслуги.Ссылка КАК Счет,
	               |	CW_ДоходыПоГрузоперевозкеУслуги.ОЗ_Всего КАК ОЗ_Всего,
	               |	CW_ДоходыПоГрузоперевозкеУслуги.ОЗ_НДС КАК ОЗ_НДС,
	               |	CW_ДоходыПоГрузоперевозкеУслуги.ОЗ_Сумма КАК ОЗ_Сумма,
	               |	CW_ДоходыПоГрузоперевозкеУслуги.СчетЗадолженности КАК СчетЗадолженности,
	               |	CW_ДоходыПоГрузоперевозкеУслуги.Представление_ДоКорректировки КАК Представление_ДоКорректировки,
	               |	CW_ДоходыПоГрузоперевозкеУслуги.Количество_ДоКорректировки КАК Количество_ДоКорректировки,
	               |	CW_ДоходыПоГрузоперевозкеУслуги.Цена_ДоКорректировки КАК Цена_ДоКорректировки,
	               |	CW_ДоходыПоГрузоперевозкеУслуги.Сумма_ДоКорректировки КАК Сумма_ДоКорректировки,
	               |	CW_ДоходыПоГрузоперевозкеУслуги.СтавкаНДС_ДоКорректировки КАК СтавкаНДС_ДоКорректировки,
	               |	CW_ДоходыПоГрузоперевозкеУслуги.НДС_ДоКорректировки КАК НДС_ДоКорректировки,
	               |	CW_ДоходыПоГрузоперевозкеУслуги.Всего_ДоКорректировки КАК Всего_ДоКорректировки
	               |ИЗ
	               |	Документ.CW_ДоходыПоГрузоперевозке.Услуги КАК CW_ДоходыПоГрузоперевозкеУслуги
	               |ГДЕ
	               |	CW_ДоходыПоГрузоперевозкеУслуги.Ссылка В(&МассивСсылок)";
	
	Запрос.УстановитьПараметр("МассивСсылок", РезультатВыбора);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Объект.Услуги.Загрузить(РезультатЗапроса.Выгрузить());
	
	СписокСчетов = РезультатВыбора.Количество() > 1;
	
	Объект.СписокСчетов = СписокСчетов;
	
	Если Не СписокСчетов Тогда 
		Если РезультатВыбора.Количество() = 1 Тогда
			Объект.Счет = РезультатВыбора[0];
		КонецЕсли;
	КонецЕсли;
	
	_ОбновитьНомераДокументов();

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПоНеактированнымСчетам(Команда)
	
	Если Объект.Услуги.Количество() > 0 Тогда
		Режим = РежимДиалогаВопрос.ДаНет;
		Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопроса", ЭтаФорма, Параметры);
		ПоказатьВопрос(Оповещение,"Табличная часть будет очищена. Продолжить?", Режим, 0);
	Иначе
		ПродолжитьВыборДокументов();	
	Конецесли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияВопроса(Результат, Параметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;
	
	ПродолжитьВыборДокументов();
	
	
	
КонецПроцедуры

&НаКлиенте
Процедура ПродолжитьВыборДокументов()
	
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("Ссылка"	, ПолучитьМассивДокументовДляОтбора());
	
	ПараметрыФормыВыбора = Новый Структура;
	ПараметрыФормыВыбора.Вставить("Отбор"				, ПараметрыОтбора);
	ПараметрыФормыВыбора.Вставить("РежимВыбора"			, Истина);
	ПараметрыФормыВыбора.Вставить("МножественныйВыбор"	, Истина);
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ОбработкаВыбораСчетоДляЗаполненеия",ЭтотОбъект); 
	ОткрытьФорму("Документ.CW_ДоходыПоГрузоперевозке.ФормаВыбора",ПараметрыФормыВыбора,ЭтаФорма,,,,ОписаниеОповещения,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
	
КонецПроцедуры

&НаСервере
Функция ПолучитьМассивДокументовДляОтбора()
	
	Запрос = новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	CW_ДоходыПоГрузоперевозке.Ссылка КАК Ссылка
	               |ИЗ
	               |	РегистрНакопления.CW_АктированиеИсходящихСчетов.Остатки(&ДатаСреза, ) КАК CW_АктированиеИсходящихСчетовОстатки
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.CW_ДоходыПоГрузоперевозке КАК CW_ДоходыПоГрузоперевозке
	               |		ПО CW_АктированиеИсходящихСчетовОстатки.Счет = CW_ДоходыПоГрузоперевозке.Ссылка
	               |ГДЕ
	               |	CW_ДоходыПоГрузоперевозке.Проведен
	               |	И НЕ CW_ДоходыПоГрузоперевозке.ФормируетсяАкт
	               |	И CW_ДоходыПоГрузоперевозке.ФормируетсяСчет
	               |	И CW_ДоходыПоГрузоперевозке.Договор = &Договор";
	
	Запрос.УстановитьПараметр("Договор"		, Объект.Договор);
	Запрос.УстановитьПараметр("ДатаСреза"	, ?(ЗначениеЗаполнено(Объект.Дата), Объект.Дата, ТекущаяДата()));
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	МассивДокументов = новый Массив;
	Пока Выборка.Следующий() Цикл
		МассивДокументов.Добавить(Выборка.Ссылка);
	КонецЦикла;
	
	Возврат Новый ФиксированныйМассив(МассивДокументов); 
														
КонецФункции

&НаСервере
Процедура УстановитьВидимостьКомандыЗаполнитьПоНеактированнымСчетам()
	
	Элементы.УслугиЗаполнитьПоНеактированнымСчетам.Видимость = Объект.ФормируетсяАкт и Не Объект.ФормируетсяСчет;

КонецПроцедуры

#КонецОбласти


#Область ВводНаОсновании 

&НаСервере
Функция ПолучитьДанныеДляВводаНаОсновании()
	
	СтруктураОснования = Новый Структура;
	СтруктураОснования.Вставить("Ссылка"				, Объект.Ссылка);
	СтруктураОснования.Вставить("ФормируетсяСчет"		, Объект.ФормируетсяСчет);
	СтруктураОснования.Вставить("ФормируетсяАкт"		, Объект.ФормируетсяАкт);
	СтруктураОснования.Вставить("ФормируетсяСчетФактура", Объект.ФормируетсяСчетФактура);
	
	Возврат СтруктураОснования;
	
КонецФункции

#КонецОбласти 

#Область ВыборВидаОперации 

&НаКлиенте
Процедура УстановитьВидОперации(Команда)
	
	ВыбратьЗначениеВидаОперации();
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьЗначениеВидаОперации()
	
	СписокВидовОпераций = Новый СписокЗначений;
	СписокВидовОпераций.Добавить(ПредопределенноеЗначение("Перечисление.CW_ВидыОперацийДоходыПоГрузоперевозке.ОказаниеУслуг"),"Оказание услуг");
	СписокВидовОпераций.Добавить(ПредопределенноеЗначение("Перечисление.CW_ВидыОперацийДоходыПоГрузоперевозке.ОтчетАгента"),"Отчёт агента");
	
	Выбор = СписокВидовОпераций.НайтиПоЗначению(Объект.ВидОперации);
	ПОВ = Новый ОписаниеОповещения("ОбработкаВыбораВидаОперации",ЭтотОбъект); 
	СписокВидовОпераций.ПоказатьВыборЭлемента(ПОВ,"Выберите вид операции", Выбор);
	
КонецПроцедуры	

&НаКлиенте
Процедура ОбработкаВыбораВидаОперации(Выбор, ДополнительныеПараметры) Экспорт 
	// --- 
	
	Если (Выбор <> Неопределено) Тогда
		Объект.ВидОперации = Выбор.Значение;
		_УправлениеЭлементамиФормы();
		_СформироватьЗаголовок();
	КонецЕсли; 
	
	// --- 
КонецПроцедуры
  

#КонецОбласти 

#Область ПолучениеНомера 

&НаКлиенте
Процедура ПолучитьНомер(Команда)
	
	// автоматическая установка номера возможно 
	// только если задана организация
	Если Не ЗначениеЗаполнено(Объект.Организация) Тогда
		_УФК.ВывестиПредупреждение("Для автоматической установки нового номера
					   |необходимо выбрать организацию.",10);
		Возврат;
	КонецЕсли;
	
	// получаем новый номер
	СтарыйНомер = Объект.Номер;
	_ПолучитьНомер();
	
	// если изменился номер, то попытаемся его переприсвоить первичным документам
	Если СтарыйНомер <> Объект.Номер Тогда
		НомерПриИзменении(ЭтаФорма.ТекущийЭлемент);	
		
		// регенерация номеров
		_ОбновитьНомераДокументов();
	КонецЕсли;
	
	
КонецПроцедуры

&НаСервере
Процедура _ПолучитьНомер()
	
	ДокументОбъект = РеквизитФормыВЗначение("Объект");
	_сф.ст_ДобавитьСвойства(ДокументОбъект.ДополнительныеСвойства,"*",_ДС());
	ДокументОбъект.УстановитьНовыйНомер();
	ЗначениеВРеквизитФормы(ДокументОбъект,"Объект");
	
КонецПроцедуры

#КонецОбласти 

#Область ПодборГрузоперевозок 

&НаКлиенте
Процедура Подбор(Команда)
	
	Если Объект.Валюта.Пустая() Тогда
		
		_УФК.ВывестиПредупреждение("Не указана валюта документа");
		Возврат;
		
	КонецЕсли; 
	
	// формируем параметры
	ПОВ = Новый ОписаниеОповещения("ОбработкаПодбора",ЭтотОбъект);
	ПФ = ПолучитьПараметрыФормыПодбора();
	ОткрытьФорму("ОбщаяФорма.CW_ФормаПодбора",ПФ,,,,,ПОВ,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаПодбора(Результат, ДополнительныеПараметры) Экспорт 
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОбработатьПодборНаСервере(Результат);

	//подсистема.Бюджетирование
	Если CW_Бюджетирование.ВедетсяУчетСтатейБюджетаВДокументах() Тогда
		ОповещениеОЗавершении = Новый ОписаниеОповещения("ПослеПолученияСтатейБюджета", ЭтотОбъект); 
		CW_БюджетированиеКлиент.ЗаполнитьСтатьиБюджетаПослеподбора(ЭтаФорма, ОповещениеОЗавершении);	
	КонецЕсли;
	//подсистема.Бюджетирование

	ДобавитьЗависимуюУслугу();
	
	// обновим итоги в табличных частях
	ОбновитьИтогиПоУслугам();
	_ОбновитьСтатусПометокУдаления();
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьЗависимуюУслугу()
	
	//Проверим и при необходимости добавим дополнительную услугу
	CW_Подписки.ДобавитьДополнительнуюУслугу(Объект);

КонецПроцедуры

&НаСервере
Функция ПолучитьПараметрыФормыПодбора()
	
	СтруктураПараметров = Новый Структура("Договор,Валюта,ТипДокумента,Грузоперевозки,ДатаДокумента");
	СтруктураПараметров.Договор 		= Объект.Договор;
	СтруктураПараметров.Валюта 			= Объект.Валюта;
	СтруктураПараметров.ТипДокумента 	= РеквизитФормыВЗначение("Объект").Метаданные().Имя;
	СтруктураПараметров.Грузоперевозки 	= _сф.м_СоздатьИзКолонкиТЗ(Объект.Услуги.Выгрузить(),"Грузоперевозка");
	
	ДатаДокумента = Объект.Дата;
	Если Объект.ФормируетсяАкт 
		и ЗначениеЗаполнено(Объект.ДатаАкта) Тогда
		ДатаДокумента = Объект.ДатаАкта;  
	ИначеЕсли Объект.ФормируетсяСчет  
		и ЗначениеЗаполнено(Объект.ДатаСчета)Тогда
		ДатаДокумента = Объект.ДатаСчета;  
	КонецЕсли;

	ДатаДокумента = ?(ДатаДокумента = Дата(1,1,1), ТекущаяДата(), ДатаДокумента);
	
	СтруктураПараметров.ДатаДокумента = ДатаДокумента;

	Возврат СтруктураПараметров;
	
КонецФункции

&НаСервере
Процедура ОбработатьПодборНаСервере(Результат)
	// --- 
	
	Если Результат.Вариант = "Грузоперевозка" Тогда
		
			Нстр = Объект.Услуги.Добавить();
			Нстр.Грузоперевозка = Результат.Грузоперевозка;
			Нстр.ПорядокОтражения = Перечисления.CW_ПорядокОтраженияДоходов.СобственнаяУслуга;
			Нстр.Количество = 1;
			
			Если Объект.Корректировка Тогда
				Нстр.ЭтоДобавленнаяСтрока = Истина;
			КонецЕсли;
			
			// --- 
			ОбновитьИтогиПоУслугам();
			_ОбновитьСтатусПометокУдаления();
			
		ИначеЕсли Результат.Вариант = "Бюджет" Тогда
			
			Если (Результат.Свойство("КомментарийЗаполнения")) Тогда
				Сообщить(Результат.КомментарийЗаполнения); 
			КонецЕсли;
			ТЗУслуг = ПолучитьИзВременногоХранилища(Результат.Строки);
			Если (Результат.ПерезаполнитьДокумент) Тогда
				Объект.Услуги.Очистить();
			КонецЕсли; 
			Для каждого Стр Из ТЗУслуг Цикл
				
				Нстр = Объект.Услуги.Добавить();
				ЗаполнитьЗначенияСвойств(Нстр,Стр);
				
				ПересчитатьСтрокуНаСерере(Нстр.ПолучитьИдентификатор(), Объект.ЦенаСНДС, Истина);
				
			КонецЦикла;
			// --- 
			ОбновитьИтогиПоУслугам();
			_ОбновитьСтатусПометокУдаления();
			
		ИначеЕсли Результат.Вариант = "ГрузоперевозкиИНоменклатура" Тогда
			
			ИспользуетсяОграничениеУслуг = ПолучитьОграничениеУслугПоНоменклатуре();
	
			СтруктураНоменклатуры = Результат.СтруктураНоменклатуры;
			
			// определяем вариант представления
			// 0 - получаем шаблон
			// 1 - используем полученный шаблон
			
			// определяем вариант суммы
			// 0 - по цене номенклатуры
			// 1 - фиксированное значение 
			// 2 - фиксированное значение цены
			// для фиксированных значений необходимо прочитать саму сумму и признак того, что сумма с НДС
			
			// режим распределения суммы
			// 0 - на все г/п
			// 1 - на каждую г/п
			// 2 - пропорционально параметру
			
			// порядок получения количества
			// 0 - из параметра грузоперевозки
			// 1 - фиксированная сумма
	
			// учитываем РазделитьКоличествоУслугНаКоличествоГрузоперевозок
			
			СуммаУслуги = 0;
			РазделитьКоличествоУслугНаКоличествоГрузоперевозок 	= _сф.ст_ПолучитьСвойство(СтруктураНоменклатуры,"РазделитьКоличествоУслугНаКоличествоГрузоперевозок");
			РаспределитьКоличествоПророрциональноПараметру 		= _сф.ст_ПолучитьСвойство(СтруктураНоменклатуры,"РаспределитьКоличествоПророрциональноПараметру");
			ПорядокПолученияКоличества 							= _сф.ст_ПолучитьСвойство(СтруктураНоменклатуры,"ПорядокПолученияКоличества");
			
			Если ПорядокПолученияКоличества = 1 Тогда
				Количество = _сф.ст_ПолучитьСвойство(СтруктураНоменклатуры,"Количество");
				Если (Количество = Неопределено) Тогда
					Количество = 1;
				КонецЕсли;
			Иначе
			
				Если РазрешитьПолучениеКоличестваУслугИзпараметраГрузоперевозки Тогда
					
					//получаем количество из параметров ГП
					КоличествоПоГрузоперевозкам = Новый Соответствие;
					Для каждого Грузоперевозка Из Результат.Грузоперевозки Цикл
						
						//Получаем количество из Параметра
						ЗначениеПараметра	= 0;
						СтруктураПараметров = новый Структура("ТипПеревозки,Номенклатура,ЕдиницаИзмерения", Грузоперевозка.ТипПеревозки,СтруктураНоменклатуры.Номенклатура,СтруктураНоменклатуры.Номенклатура.ЕдиницаИзмерения);
						НайденныйПараметр 	= CW_Документы.ПолучитьПараметрДляПодстановкиЗначенияВКоличество(СтруктураПараметров);
						
						Если НайденныйПараметр <> Неопределено Тогда
							//Получаем только первое значение
							СтрокаПараметраГП = Грузоперевозка.ПараметрыГрузоперевозки.Найти(НайденныйПараметр, "Параметр");
							
							Если СтрокаПараметраГП <> Неопределено Тогда
								ЗначениеПараметра = СтрокаПараметраГП.Значение;
							КонецЕсли;
							
						КонецЕсли;	
						
						Если Не ЗначениеЗаполнено(ЗначениеПараметра) и Не УстановитьЗначениеНольЗначениеПараметраНеУстановлено тогда
							ЗначениеПараметра = 1;
						КонецЕсли;
						
						КоличествоПоГрузоперевозкам.Вставить(Грузоперевозка,ЗначениеПараметра);
						
					КонецЦикла;
					
				КонецЕсли;
				
			КонецЕсли;
			
			ОбратныйПересчет = Ложь;
			Если НЕ ЗначениеЗаполнено(СтруктураНоменклатуры.СтавкаНДС) Тогда
				
				СуммаУслуги = 0;
				
			Иначе
				Если СтруктураНоменклатуры.ВариантОпределенияСуммы =1 Тогда
					
					СуммаУслуги 		= СтруктураНоменклатуры.Всего;
					ОбратныйПересчет 	= СтруктураНоменклатуры.СуммаВключаетНДС; 
					
				ИначеЕсли СтруктураНоменклатуры.ВариантОпределенияСуммы = 2 Тогда
					
					ЦенаУслуги 			= СтруктураНоменклатуры.Цена;
					ОбратныйПересчет 	= СтруктураНоменклатуры.ЦенаВключаетНДС; 

				ИначеЕсли Не ИспользуетсяОграничениеУслуг Тогда  
					
					// получаем сумму из тепа цены
					ТипЦен = _ДС().ПД.ТипЦен;
					Если НЕ ТипЦен.Пустая() Тогда
						
						СК = CW_Финансы.ПолучитьКурсВалюты(Объект.Валюта,_ДатаВозникновенияЗадолженности());
						Цена = Ценообразование.ПолучитьЦенуНоменклатуры(СтруктураНоменклатуры.Номенклатура, ТипЦен, _ДатаВозникновенияЗадолженности(), Объект.Валюта, СК.Курс,СК.Кратность);
						ОбратныйПересчет = ТипЦен.ЦенаВключаетНДС;
						СуммаУслуги = Цена*Количество;
						
					Иначе
						
						ОбратныйПересчет = Ложь;
						СуммаУслуги = 0;
						
					КонецЕсли; 
					
				КонецЕсли;
				
			КонецЕсли; 
			
			// распределение по параметру
			Если СуммаУслуги <> 0 И СтруктураНоменклатуры.ВариантРаспределения = 2 Тогда 
				
				// считаем общую сумму 
				ТР = _сф.т_Создать("Грузоперевозка,Значение");
				Для каждого Грузоперевозка Из Результат.Грузоперевозки Цикл
					
					СтрокаПараметра = _сф.к_НайтиСтроку(Грузоперевозка.ПараметрыГрузоперевозки,_сф.ст_Отбор("Параметр",СтруктураНоменклатуры.ПараметрРаспределения));
					Если СтрокаПараметра = Неопределено Тогда
						
						Значение = 0;
						
					Иначе
						
						Значение = Число(СтрокаПараметра.Значение);
						
					КонецЕсли; 
					
					Нстр = ТР.Добавить();
					Нстр.Грузоперевозка = Грузоперевозка;
					Нстр.Значение = Значение;
					
				КонецЦикла; 
				
				БазаРаспределенияПоПараметру = _сф.Итог(ТР,"Значение");
				СоответствиеЗначенийПараметра = _сф.со_Создать("Грузоперевозка","Значение",ТР);
				
				Если БазаРаспределенияПоПараметру = 0 Тогда
					
					СуммаУслуги = 0;
					
				КонецЕсли; 
				
			КонецЕсли;
			
			// проверяем вариант распределения
			Если СтруктураНоменклатуры.ВариантРаспределения = 0 ИЛИ СтруктураНоменклатуры.ВариантРаспределения = 2 Тогда
				
				ОстатокРаспределения = СуммаУслуги;
				
			КонецЕсли; 
			
			Ставка = CW_Финансы.ПолучитьСтавкуНДС(СтруктураНоменклатуры.СтавкаНДС);
			
			// ЗАПОЛНЯЕМ
			// ---------------------------------------------------------------------------- 
			Индекс=0;
			Для каждого Грузоперевозка Из Результат.Грузоперевозки Цикл
				
				_сф.Инкремент(Индекс);
				
				Нстр = Объект.Услуги.Добавить();
				Нстр.Грузоперевозка 	= Грузоперевозка;
				Нстр.Номенклатура 		= СтруктураНоменклатуры.Номенклатура;
				Нстр.СтатьяЗатрат 		= СтруктураНоменклатуры.СтатьяЗатрат;
				Нстр.ПорядокОтражения 	= СтруктураНоменклатуры.ПорядокОтраженияДоходов;
				Нстр.СтавкаНДС 			= СтруктураНоменклатуры.СтавкаНДС;
				
				Если Объект.Корректировка Тогда
					Нстр.ЭтоДобавленнаяСтрока = Истина;
				КонецЕсли;

				// --- 
				Если ПорядокПолученияКоличества = 0 Тогда
					Количество = КоличествоПоГрузоперевозкам.Получить(Грузоперевозка);	
					
					//ВРЕМЕННО УДАЛЕНО
					//Если Количество = 0 Тогда
					//	Сообщение = новый СообщениеПользователю;
					//	Сообщение.Текст = "По грузоперевозке "+Строка(Грузоперевозка)+" не удалось получить количество услуги!";
					//	Сообщение.ПутьКДанным  = "Объект";
					//	Сообщение.Поле    = "Услуги["+Нстр.ПолучитьИдентификатор()+"].Количество";
					//	Сообщение.Сообщить();
					//конецЕсли;
					
				КонецЕсли;
				
				Нстр.Количество = Количество;
				Если СтруктураНоменклатуры.ВариантОпределенияСуммы = 2 Тогда  
					
					Если ОбратныйПересчет Тогда
						Нстр.Всего 	= ЦенаУслуги * Количество;
						Нстр.НДС 	= Нстр.Всего*(Ставка/(100+Ставка));
						Нстр.Сумма 	= Нстр.Всего - Нстр.НДС;
						Нстр.Цена 	= _сф.БезопасноРазделить(Нстр.Сумма, Нстр.Количество);
					Иначе
						Нстр.Цена 	= ЦенаУслуги; 
						Нстр.Сумма 	= ЦенаУслуги * Количество;
						Нстр.НДС 	= Нстр.Сумма * (Ставка/100);
						Нстр.Всего 	= Нстр.Сумма + Нстр.НДС;
					КонецЕсли;   
					
					ПересчитатьСтрокуНаСерере(Нстр.ПолучитьИдентификатор(),Объект.ЦенаСНДС, Истина);
					
				ИначеЕсли ИспользуетсяОграничениеУслуг и СтруктураНоменклатуры.ВариантОпределенияСуммы = 0 Тогда
					
					Если ЭтоАдресВременногоХранилища(АдресУслугПоДоговору) Тогда
						
						СтруктураПараметров = Новый Структура;
						СтруктураПараметров.Вставить("АдресУслугПоДоговору"						, АдресУслугПоДоговору);
						СтруктураПараметров.Вставить("УстанавливатьЦенуВЗависимостиОтГруза"		, УстанавливатьЦенуВЗависимостиОтГруза);
						СтруктураПараметров.Вставить("УстанавливатьЦенуВЗависимостиОтКлиента"	, Ложь);
						
						СтруктураПараметров.Вставить("Номенклатура"							, СтруктураНоменклатуры.Номенклатура);
						Если УстанавливатьЦенуВЗависимостиОтГруза Тогда
							СтруктураПараметров.Вставить("Груз" , Грузоперевозка.Груз);
						КонецЕсли;
						
						УслугаДоговора = _УФС.ПолучитьУслугуДоговораПоПараметрам(СтруктураПараметров);	
						
						Если УслугаДоговора <> Неопределено Тогда 	
							
							Сумма		= УслугаДоговора.ЦенаБезНДС * Количество;
							Если ЗначениеЗаполнено(УслугаДоговора.СтавкаНДС)  Тогда
								НДС = Сумма * CW_Финансы.ПолучитьСтавкуНДС(УслугаДоговора.СтавкаНДС)/100;
							Иначе
								НДС = 0;
							КонецЕсли; 
							
							Если ЗначениеЗаполнено(УслугаДоговора.ПорядокОтражения) Тогда
								Нстр.ПорядокОтражения = УслугаДоговора.ПорядокОтражения;
							КонецЕсли;
							
							Нстр.СтавкаНДС 	= УслугаДоговора.СтавкаНДС;
							Нстр.Цена 		= УслугаДоговора.ЦенаБезНДС;
							Нстр.НДС 		= НДС;
							Если УслугаДоговора.ВариантРасчетаНДС = Перечисления.ВариантыРасчетаНДС.НДССверху тогда
								Нстр.Сумма 		= УслугаДоговора.ЦенаБезНДС * Количество;
								ОбратныйПересчет = Ложь;
							Иначе //в сумме
								Нстр.Всего = УслугаДоговора.Цена * Количество;
								ОбратныйПересчет = Истина;
							КонецЕсли;
							
							Ставка = CW_Финансы.ПолучитьСтавкуНДС(УслугаДоговора.СтавкаНДС);
							
							Если ОбратныйПересчет Тогда
								
								Нстр.НДС 	= Нстр.Всего*(Ставка/(100+Ставка));
								Нстр.Сумма 	= Нстр.Всего - Нстр.НДС;
								Нстр.Цена 	= _сф.БезопасноРазделить(Нстр.Сумма,Нстр.Количество);
								
							Иначе
								
								Нстр.Цена 	= _сф.БезопасноРазделить(Нстр.Сумма,Нстр.Количество);
								Нстр.НДС 	= Нстр.Сумма*(Ставка/100);
								Нстр.Всего 	= Нстр.Сумма+Нстр.НДС;
								
							КонецЕсли;   
							
							ПересчитатьСтрокуНаСерере(Нстр.ПолучитьИдентификатор(),Объект.ЦенаСНДС, Истина);
							
						КонецЕсли; 
						
					КонецЕсли;
					
				Иначе				
					// --- 
					
					Если (СуммаУслуги <> 0) Тогда
						// --- 
						
						// на каждую г/п
						Если СтруктураНоменклатуры.ВариантРаспределения = 1 Тогда
							
							Если ОбратныйПересчет Тогда
								
								Нстр.Всего = СуммаУслуги;
								
							Иначе
								
								Нстр.Сумма = СуммаУслуги;
								
							КонецЕсли; 
							
							Если (РазделитьКоличествоУслугНаКоличествоГрузоперевозок) Тогда
								
								Нстр.Количество = Количество/Результат.Грузоперевозки.Количество();
								
							КонецЕсли; 
							
							// на все г/п
						ИначеЕсли СтруктураНоменклатуры.ВариантРаспределения = 0 Тогда 
							
							Если ОбратныйПересчет Тогда
								
								Нстр.Всего = СуммаУслуги/Результат.Грузоперевозки.Количество();
								_сф.Декремент(ОстатокРаспределения,Нстр.Всего);
								
							Иначе
								
								Нстр.Сумма = СуммаУслуги/Результат.Грузоперевозки.Количество();
								_сф.Декремент(ОстатокРаспределения,Нстр.Сумма);
								
							КонецЕсли; 
							
							Если (РазделитьКоличествоУслугНаКоличествоГрузоперевозок) Тогда
								
								Нстр.Количество = Количество/Результат.Грузоперевозки.Количество();
								
							КонецЕсли; 
							
							Если Результат.Грузоперевозки.Количество()=Индекс Тогда
								
								_сф.Инкремент(?(ОбратныйПересчет,Нстр.Всего,Нстр.Сумма),ОстатокРаспределения);
								
							КонецЕсли; 
							
							// по параметру
						ИначеЕсли СтруктураНоменклатуры.ВариантРаспределения = 2 Тогда 
							
							Если ОбратныйПересчет Тогда
								
								Нстр.Всего = СуммаУслуги*СоответствиеЗначенийПараметра.Получить(Грузоперевозка)/БазаРаспределенияПоПараметру;
								_сф.Декремент(ОстатокРаспределения,Нстр.Всего);
								
							Иначе
								
								Нстр.Сумма = СуммаУслуги*СоответствиеЗначенийПараметра.Получить(Грузоперевозка)/БазаРаспределенияПоПараметру;
								_сф.Декремент(ОстатокРаспределения,Нстр.Сумма);
								
							КонецЕсли; 
							
							Если (РаспределитьКоличествоПророрциональноПараметру) Тогда
								
								Нстр.Количество = Количество*СоответствиеЗначенийПараметра.Получить(Грузоперевозка)/БазаРаспределенияПоПараметру;
								
							КонецЕсли; 
							
							Если Результат.Грузоперевозки.Количество()=Индекс Тогда
								
								_сф.Инкремент(?(ОбратныйПересчет,Нстр.Всего,Нстр.Сумма),ОстатокРаспределения);
								
							КонецЕсли; 
							
						КонецЕсли; 
						
						Если ОбратныйПересчет Тогда
							
							Нстр.НДС = Нстр.Всего*(Ставка/(100+Ставка));
							Нстр.Сумма = Нстр.Всего - Нстр.НДС;
							Нстр.Цена = _сф.БезопасноРазделить(Нстр.Сумма,Нстр.Количество);
							
						Иначе
							
							Нстр.Цена = _сф.БезопасноРазделить(Нстр.Сумма,Нстр.Количество);
							Нстр.НДС = Нстр.Сумма*(Ставка/100);
							Нстр.Всего = Нстр.Сумма+Нстр.НДС;
							
						КонецЕсли; 
						
						ПересчитатьСтрокуНаСерере(Нстр.ПолучитьИдентификатор(),Объект.ЦенаСНДС, Истина);
		
						// --- 
					КонецЕсли; 
				КонецЕсли; 
				// ---------------------------------------------------------------------------- 
				
				// устанавливаем представление
				Если СтруктураНоменклатуры.ВариантПредставления = 0 Тогда
					
					ПараметрыШаблона = CW_Шаблоны.ПолучитьПараметрШаблонаУслуг();
					
					ПараметрыШаблона.Номенклатура 	= Нстр.Номенклатура;
					ПараметрыШаблона.Объект 		= Объект;
					ПараметрыШаблона.Дата 			= Объект.Дата;
					ПараметрыШаблона.Договор 		= Объект.Договор;
					ПараметрыШаблона.ВидДоговора 	= Объект.Договор.ВидДоговора;
					ПараметрыШаблона.ПриложениеКДоговору = Объект.ПриложениеКДоговору;
					
					CW_Шаблоны.УстановитьПредставлениеНоменклатурыВСтроке(Нстр, ПараметрыШаблона); 
					
				Иначе
					
					Представление = СтруктураНоменклатуры.Представление;
					Если Найти(Представление,"%")  <> 0 Тогда
						
						// это шаблон
						Нстр.Представление = CW_Шаблоны.ОбработатьШаблонНоменклатуры(Представление,Объект,Нстр);
						
					Иначе
						
						Нстр.Представление = Представление;
						
					КонецЕсли; 
					
				КонецЕсли; 
								
				// --- 
				
			КонецЦикла; 
			// --- 
			ОбновитьИтогиПоУслугам();
			_ОбновитьСтатусПометокУдаления();
			
			
			#Область Динамический_вывод_дополнительных_колонок
			
			_УФС.ОбновитьЗначенияПараметровГрузоперевозок(ПолучитьСтруктуруПараметровДляПередачи());
			
			#КонецОбласти
			
		КонецЕсли; 
		
		
		// --- 
КонецПроцедуры

#КонецОбласти 

