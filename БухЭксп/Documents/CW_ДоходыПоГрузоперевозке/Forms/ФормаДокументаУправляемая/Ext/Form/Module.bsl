&НаКлиенте
Процедура УслугиПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)

	ТекущиеДанные = Элементы.Услуги.ТекущиеДанные;

	Если НоваяСтрока и НЕ Копирование Тогда
		ТекущиеДанные.Количество = 1;
		
		ПорядокОтражения = _ДС().ПД.ОсновнойПорядокОтраженияДоходов;
		Если ПорядокОтражения.Пустая() Тогда
			ПорядокОтражения = ПредопределенноеЗначение("Перечисление.CW_ПорядокОтраженияДоходов.СобственнаяУслуга");
		КонецЕсли; 
		ТекущиеДанные.ПорядокОтражения = ПорядокОтражения;   
	Иначе
		Если ТекущиеДанные.Количество = 0 Тогда
			ТекущиеДанные.Количество = 1;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(ТекущиеДанные.ПорядокОтражения) Тогда 
			ПорядокОтражения = _ДС().ПД.ОсновнойПорядокОтраженияДоходов;
			Если ПорядокОтражения.Пустая() Тогда
				ПорядокОтражения = ПредопределенноеЗначение("Перечисление.CW_ПорядокОтраженияДоходов.СобственнаяУслуга"); 
			Иначе
				ТекущиеДанные.ПорядокОтражения = ПорядокОтражения;   
			КонецЕсли; 
		КонецЕсли;
	КонецЕсли;   
	
	//AFR-233578
	ИспользуетсяОгранчиениеУслуг = ПолучитьОграничениеУслугПоНоменклатуре(ТекущиеДанные.ПорядокОтражения);
	ОтключитьИсториюВыбораНоменклатуры(ИспользуетсяОгранчиениеУслуг);
	//AFR-233578
	
КонецПроцедуры

&НаКлиенте
Процедура УслугиКорректировкаПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НоваяСтрока Тогда
		ТекущиеДанные = Элементы.УслугиКорректировка.ТекущиеДанные;
		ТекущиеДанные.ЭтоДобавленнаяСтрока = Истина;
		ТекущиеДанные.Количество = 1;
		
		Если Копирование Тогда
			ТекущиеДанные.Представление_ДоКорректировки = "";
			ТекущиеДанные.Количество_ДоКорректировки	= 0;
			ТекущиеДанные.Цена_ДоКорректировки			= 0;
			ТекущиеДанные.Сумма_ДоКорректировки			= 0;
			ТекущиеДанные.НДС_ДоКорректировки  			= 0;
			ТекущиеДанные.Всего_ДоКорректировки			= 0;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УслугиКорректировкаПередУдалением(Элемент, Отказ)
	
	ТекущиеДанные 	= Элементы.УслугиКорректировка.ТекущиеДанные;
	Отказ 			= ТекущиеДанные.ЭтоДобавленнаяСтрока = Ложь;
	
	Если Отказ Тогда
		ПоказатьПредупреждение(,"Удаляемая строка есть в корректируемом документе. Удаление запрещено!",30, "Ошибка удаления строки");
	КонецЕсли;
	
КонецПроцедуры


&НаКлиенте
Процедура УслугиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Поле = Элементы.УслугиЗаказ Тогда 
		
		СтандартнаяОбработка = Ложь;
		
		Попытка
			ПоказатьЗначение(,_Заказ(Элементы.Услуги.ТекущиеДанные.Грузоперевозка));
		Исключение
			//ОписаниеОшибки()
		КонецПопытки; 
		
	ИначеЕсли (Поле = Элементы.УслугиНоменклатурнаяГруппа) Тогда 
		
		 Попытка
			ПоказатьЗначение(,_НоменклатурнаяГруппа(Элементы.Услуги.ТекущиеДанные.Номенклатура));
		Исключение
			//ОписаниеОшибки()
		КонецПопытки;
		
	ИначеЕсли (Поле = Элементы.УслугиДокументРасходовПредставлениеДокумента) Тогда 
		
		 Попытка
			ПоказатьЗначение(,Элементы.Услуги.ТекущиеДанные.ДокументРасходов);
		Исключение
			//ОписаниеОшибки()
		КонецПопытки;
		
	Иначе
		
		Если ЭтаФорма.ТолькоПросмотр Тогда
			
			СтандартнаяОбработка = Ложь;
			// --- 
			Если Поле = Элементы.УслугиГрузоперевозка Тогда
				
				Попытка
					ПоказатьЗначение(,Элементы.Услуги.ТекущиеДанные.Грузоперевозка);
				Исключение
					//ОписаниеОшибки()
				КонецПопытки; 
				
			ИначеЕсли Поле = Элементы.УслугиДокументРасходов Тогда 
				
				Попытка
					ПоказатьЗначение(,Элементы.Услуги.ТекущиеДанные.ДокументРасходов);
				Исключение
					//ОписаниеОшибки()
				КонецПопытки; 
				
			КонецЕсли; 
			
		КонецЕсли; 
		
	КонецЕсли;
	
КонецПроцедуры

