#Область Добалвение_Строки_Счета

&НаКлиенте
Процедура Услуги_ДобавитьСтрокуСчета(Команда)
	
	ДополнительныеСвойства = Неопределено;
	Если ДС.Количество() > 0 Тогда
		ДополнительныеСвойства = ДС[0].Значение;
	КонецЕсли;	

	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ЕстьОграниченияПоСпискуУслуг"			, ЛОЖЬ);
	ПараметрыФормы.Вставить("УстанавливатьЦенуВЗависимостиОтГруза"	, УстанавливатьЦенуВЗависимостиОтГруза);
	ПараметрыФормы.Вставить("АдресУслугПоДоговору"					, АдресУслугПоДоговору);
	ПараметрыФормы.Вставить("Договор"								, Объект.Договор);
	
	//Подсистема.УчетПриложенийДоговоров	
	ПараметрыФормы.Вставить("ПриложениеКДоговору"					, Объект.ПриложениеКДоговору);
	//Подсистема.УчетПриложенийДоговоров	
	
	ПараметрыФормы.Вставить("ДатаДокумента"							, Объект.Дата);
	ПараметрыФормы.Вставить("Валюта"								, Объект.Валюта);
	ПараметрыФормы.Вставить("Организация"							, Объект.Организация);
	ПараметрыФормы.Вставить("ДополнительныеСвойства"				, ДополнительныеСвойства);
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ОбработатьДобавлениеСтроки",ЭтотОбъект, Новый Структура()); 
	
	ОткрытьФорму("Документ.CW_ДоходыПоГрузоперевозке.Форма.ФормаДобавленияСтрокиВДокумент",ПараметрыФормы,ЭтаФорма,,,,ОписаниеОповещения,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры


&НаКлиенте
Процедура ОбработатьДобавлениеСтроки(Ответ, ДопПараметры) Экспорт
	
	Если Ответ <> Неопределено Тогда
		
		ДобавиьСтрокуНаСервере(Ответ.Адрес);
		
	Конецесли;
	
КонецПроцедуры

&НаСервере
Процедура ДобавиьСтрокуНаСервере(Адрес)
	
	Если ЭтоАдресВременногоХранилища(Адрес) тогда
		ДанныеСтроки = ПолучитьИзВременногоХранилища(Адрес);
		
		НоваяСтрока = Объект.Услуги.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ДанныеСтроки[0]);
		
		//Дополним комментарий тегами
		ТегОткрывающий = "<%Текст шапки%/";
		ТегЗакрывающий = "/%Текст шапки%>";

		//Проверим может уже ессть тогда ничего не делаем
		
		ПозПервогоСимвола    = СтрНайти(Объект.Комментарий,ТегОткрывающий);
		
		Если ПозПервогоСимвола = 0 тогда
			//вставляем всегда в начало с строки;
			Объект.Комментарий = ТегОткрывающий + " {Введите текст дополнения шапки счета} "+ТегЗакрывающий + " "+Объект.Комментарий;
		КонецЕсли;
		
		#Область Динамический_вывод_дополнительных_колонок
	
		_УФС.ОбновитьЗначенияПараметровГрузоперевозкиПоСтроке(НоваяСтрока, ПолучитьСтруктуруПараметровДляПередачи());	
	
		#КонецОбласти
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Команда_ОбновитьКоличество(Команда)
	
	ОбновитьКоличествоНаСервере();

КонецПроцедуры

