КонецПроцедуры

&НаКлиенте
Процедура ОбработатьСнятиеУстанокуФлажков(Флаг)
	
	Если РедактированиеФинансов_Доходы_Счета Тогда
		Объект.ФормируетсяСчет 			= Флаг;
		ПриИзмененииФормируетсяСчет();
	КонецЕсли;
	
	Если РедактированиеФинансов_Доходы_Акты Тогда
		Объект.ФормируетсяАкт 			= Флаг;
		Объект.ФормируетсяСчетФактура 	= Флаг;
		
		ПриИзмененииФормируетсяАкт();
		ПриИзмененииФормируетсяСчетФактура();
	КонецЕсли;
	
	ПервичныеДокументыУправлениеЭлементамиФормы();

КонецПроцедуры

&НаКлиенте
Процедура ФормируетсяСчетПриИзменении(Элемент)
	
	ПриИзмененииФормируетсяСчет();

КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииФормируетсяСчет()
	
	//Взаиморасчеты по документу
	Элементы.Команда_ВзаиморасчетыПоДокументу.Видимость  =  Объект.ФормируетсяСчет;
	Элементы.Команда_ВзаиморасчетыПоДокументу1.Видимость =  Объект.ФормируетсяСчет;
	//Взаиморасчеты по документу
	
	// не формируем счет
	Если НЕ Объект.ФормируетсяСчет Тогда
		Объект.СпособЗачетаАвансовОЗ = ПредопределенноеЗначение("Перечисление.СпособыЗачетаАвансов.НеЗачитывать");
		
		Если Не СохранятьРеквизитыПервичныхДокументов Тогда
			Объект.ДатаСчета	= Неопределено;
			Объект.НомерСчета 	= Неопределено;
		КонецЕсли;
		// формируем акт
	Иначе
		// всегда предполагаем, что это будет по одному акту
		Объект.СписокСчетов = Ложь;
	КонецЕсли; 
	
	Если Не _СрокОплатыРучноеРедактирование Тогда
		УстановитьСрокОплатыНаСервере();             
	КонецЕсли;

	ПервичныеДокументыУправлениеЭлементамиФормы();
	
	УстановитьВидимостьКомандыЗаполнитьПоНеактированнымСчетам();
	_ОбновитьНомераДокументов();
	
КонецПроцедуры    

&НаКлиенте
Процедура ФормируетсяАктПриИзменении(Элемент)
	
	ПриИзмененииФормируетсяАкт();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииФормируетсяАкт()
	
	Если Объект.ФормируетсяАкт Тогда
		СтруктураПараметров = CW_Настройки.ПустаяСтруктураПолученияПараметровДоговора();
		СтруктураПараметров.Дата 				= Объект.Дата;
		СтруктураПараметров.Договор 			= Объект.Договор;
		СтруктураПараметров.ПриложениеКДоговору = Объект.ПриложениеКДоговору;
		
		ПараметрыДоговора	= CW_Настройки.ПолучитьПараметрыДоговора(СтруктураПараметров, "ПорядокЗачетаАвансов");
		Объект.СпособЗачетаАвансов = ПараметрыДоговора.ПорядокЗачетаАвансов;
		
	Иначе
		// если не формируем акт, то с/ф так же формироваться не будет
		Объект.СпособЗачетаАвансов = ПредопределенноеЗначение("Перечисление.СпособыЗачетаАвансов.НеЗачитывать");
		
		Объект.ФормируетсяСчетФактура 	= Ложь;
		
		Если Не СохранятьРеквизитыПервичныхДокументов Тогда
			Объект.ДатаАкта		= Неопределено;
			Объект.НомерАкта	= Неопределено;
		КонецЕсли;
	КонецЕсли; 
	
	Если Не _СрокОплатыРучноеРедактирование Тогда
		УстановитьСрокОплатыНаСервере();             
	КонецЕсли;

	ПервичныеДокументыУправлениеЭлементамиФормы();
	
	УстановитьВидимостьКомандыЗаполнитьПоНеактированнымСчетам();
	_ОбновитьНомераДокументов();

КонецПроцедуры

&НаКлиенте
Процедура ЭтоУниверсальныйДокументПриИзменении(Элемент)
	
	_ОбновитьНомераДокументов();

КонецПроцедуры     

&НаКлиенте
Процедура ФормируетсяСчетФактураПриИзменении(Элемент)
	
	ПриИзмененииФормируетсяСчетФактура();

КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииФормируетсяСчетФактура()
	
	Если Объект.ФормируетсяСчетФактура Тогда
		Если Объект.КодСпособаВыставления = 0 Тогда
			Объект.КодСпособаВыставления = 1;
		КонецЕсли;
	Иначе
		Если Не СохранятьРеквизитыПервичныхДокументов Тогда
			Объект.ДатаСчетаФактуры  = Неопределено;
			Объект.НомерСчетаФактуры = Неопределено
		КонецЕсли;
	КонецЕсли;

	УстановитьВерсиюПоставленияНДС1137();
	
	ПервичныеДокументыУправлениеЭлементамиФормы();
	
	_ОбновитьНомераДокументов();

КонецПроцедуры

&НаСервере
Процедура УстановитьСрокОплатыНаСервере()
	
	Если Объект.Ссылка.Пустая() Тогда
		Возврат;
	КонецЕсли;   
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("Ссылка"		, Объект.Ссылка);
	СтруктураПараметров.Вставить("Договор"		, Объект.Договор);
	
	//Подсистема.УчетПриложенийДоговоров
	Если ЗначениеЗаполнено(Объект.ПриложениеКДоговору) Тогда
		СтруктураПараметров.Вставить("Договор", Объект.ПриложениеКДоговору);
	КонецЕсли;
	//Подсистема.УчетПриложенийДоговоров
	
	СтруктураПараметров.Вставить("Дата"			, Объект.Дата);
	СтруктураПараметров.Вставить("ДатаСчета"	, Объект.ДатаСчета);
	СтруктураПараметров.Вставить("ЕстьСчет"		, Объект.ФормируетсяСчет);
	СтруктураПараметров.Вставить("ЕстьАкт"		, Объект.ФормируетсяАкт);
	
	ДатаОплаты = CW_Документы.РассчитатьСрокОплаты(СтруктураПараметров);
	
	СтруктураПараметровСрокаОплаты = Новый Структура;
	СтруктураПараметровСрокаОплаты.Вставить("Счет",			Объект.Ссылка);
	СтруктураПараметровСрокаОплаты.Вставить("ДатаОплаты",	ДатаОплаты);
	СтруктураПараметровСрокаОплаты.Вставить("Описание", 	"");
	
	РегистрыСведений.CW_СрокиОплатыСчетов.ЗаписатьСрокОплатыДокумента(СтруктураПараметровСрокаОплаты); 
	
	ПорядокРасчета = _ДС().ПД.УсловияОплаты.ПорядокРасчета;
	Если Не Объект.ФормируетсяСчет и Объект.ФормируетсяАкт и ПорядокРасчета = ПредопределенноеЗначение("Перечисление.CW_ПорядокРасчетаДляУсловияОплаты.ОтсрочкаОтДатыВозвратаАкта") Тогда
		мСвязанныеСчета = Документы.CW_ДоходыПоГрузоперевозке.ПолучитьСвязанныеСчета(Объект.Ссылка);
		Для каждого СвязанныйСчет из мСвязанныеСчета Цикл
			
			ДанныеСрокаОплаты = CW_Документы.ПолучитьСрокОплаты(СвязанныйСчет);
			Если НЕ ДанныеСрокаОплаты.РучноеРедактирование Тогда
				СтруктураПараметровСрокаОплаты = Новый Структура;
				СтруктураПараметровСрокаОплаты.Вставить("Счет",			СвязанныйСчет);
				СтруктураПараметровСрокаОплаты.Вставить("ДатаОплаты",	ДатаОплаты);
				СтруктураПараметровСрокаОплаты.Вставить("Описание", 	"");
				
				РегистрыСведений.CW_СрокиОплатыСчетов.ЗаписатьСрокОплатыДокумента(СтруктураПараметровСрокаОплаты); 
			КонецЕсли; 
			
		КонецЦикла;
		
	КонецЕсли;  
	
	ДанныеСрокаОплаты = CW_Документы.ПолучитьСрокОплаты(Объект.Ссылка);
	
	ДанныеСрокаОплаты.Свойство("ДатаОплаты",			_СрокОплаты);
	ДанныеСрокаОплаты.Свойство("Описание",				_СрокОплатыОписание);
	ДанныеСрокаОплаты.Свойство("РучноеРедактирование",	_СрокОплатыРучноеРедактирование);
	
	УстановитьОписаниеСрокаОплаты();

КонецПроцедуры

&НаСервере
Процедура УстановитьОписаниеСрокаОплаты()
	
	Текст = "<не установлен>";
	
	Если ЗначениеЗаполнено(_СрокОплаты) Тогда
		Текст = Формат(_СрокОплаты,"ДФ=dd.MM.yyyy");
		Если СокрЛП(_СрокОплатыОписание) <> "" Тогда
			Текст = Текст + " ("+СокрЛП(_СрокОплатыОписание)+")";
		КонецЕсли; 
	Иначе
		Если Не _СрокОплатыРучноеРедактирование Тогда
			Текст = "<авто>";
		КонецЕсли; 
	КонецЕсли;	
	
	СрокОплаты = Текст;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьОписаниеПланОплаты()
	
	Текст = "<не задан>";

	ДанныеПланаОплаты = CW_Документы.ПолучитьПланОплаты(Объект.Ссылка);
	Если Не ЗначениеЗаполнено(ДанныеПланаОплаты.Дата) и НЕ ПустаяСтрока(ДанныеПланаОплаты.Примечание) Тогда
		Текст = "<...>";
	ИначеЕсли ЗначениеЗаполнено(ДанныеПланаОплаты.Дата) Тогда
		Текст = Формат(ДанныеПланаОплаты.Дата,"ДФ=dd.MM.yyyy");
	КонецЕсли;
	
	Если Не ПустаяСтрока(ДанныеПланаОплаты.Примечание) Тогда
		Текст = Текст + " ("+СокрЛП(ДанныеПланаОплаты.Примечание)+")";
	КонецЕсли; 
	
	ПланОплаты = Текст;
	
	_ОбновитьНомераДокументов();
	
КонецПроцедуры

&НаКлиенте
Процедура ПервичныеДокументыУстановитьСрокОплаты(Команда)
	
	УстановитьСрокОплатыНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура СрокОплатыНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ПараметрыФормыСрокаОплаты = Новый Структура;
	ПараметрыФормыСрокаОплаты.Вставить("Документ", 				Объект.Ссылка); 
	
	ПараметрыФормыСрокаОплаты.Вставить("ДатаОплаты",			_СрокОплаты);
	ПараметрыФормыСрокаОплаты.Вставить("Описание",				_СрокОплатыОписание);
	ПараметрыФормыСрокаОплаты.Вставить("РучноеРедактирование",	_СрокОплатыРучноеРедактирование);
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ОбработатьИзменениеСрокаОплаты",ЭтотОбъект); 

	ОткрытьФорму("ОбщаяФорма.CW_СрокОплаты", ПараметрыФормыСрокаОплаты,ЭтаФорма,,,,ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьИзменениеСрокаОплаты(РезультатВыбора, ДополнительныеПараметры) Экспорт
	
	Если РезультатВыбора = Неопределено Тогда
		Возврат;
	КонецЕсли;   
	
	РезультатВыбора.Свойство("ДатаОплаты",   		 _СрокОплаты);
	РезультатВыбора.Свойство("Описание",  			 _СрокОплатыОписание);
	РезультатВыбора.Свойство("РучноеРедактирование", _СрокОплатыРучноеРедактирование); 
	
	Если Не РезультатВыбора.РучноеРедактирование Тогда
		УстановитьСрокОплатыНаСервере();
	Иначе
		ЗаписатьСрокОплатыДокумента();  
		УстановитьОписаниеСрокаОплаты();             
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПланОплатыНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если Объект.Ссылка.Пустая() Тогда
		ПоказатьПредупреждение(, "План оплаты можно установить только для записанного документа.");
	Иначе
		
		Представление = "Счёт №"+СокрЛП(Объект.НомерСчета)+" от "+Формат(Объект.ДатаСчета,"ДФ=dd.MM.yyyy")+" ("+Строка(Объект.Контрагент)+")";
		
		ОписаниеОповещения = Новый ОписаниеОповещения("ОбработкаИзмененияПланаОплаты",ЭтотОбъект); 
		
		ПараметрыФормыПланаОплаты = Новый Структура;
		ПараметрыФормыПланаОплаты.Вставить("Документ", Объект.Ссылка);
		ПараметрыФормыПланаОплаты.Вставить("ПредставлениеДокумента", Представление);
	
		ОткрытьФорму("ОбщаяФорма.CW_ПлановыйСрокОплаты",ПараметрыФормыПланаОплаты,ЭтаФорма,,,,ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаИзмененияПланаОплаты(Ответ, ДополнительныеПараметры) Экспорт
	
	УстановитьОписаниеПланОплаты();
	
КонецПроцедуры

&НаКлиенте
Процедура СписокСчетовПриИзменении(Элемент)
	
	Элементы.Счет.Видимость = НЕ Объект.СписокСчетов;
	ПервичныеДокументыУправлениеЭлементамиФормы();
 	_ОбновитьНомераДокументов();

КонецПроцедуры

&НаКлиенте
Процедура ПервичныеДокументыПодборСчетов(Команда)
	
	АвтоматическийПодборСчетов();

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокКодовОпераций()
	
	ИспользоватьКоды2015 = Ложь;
	Если Объект.Дата >= '20150101' Тогда 
		ИспользоватьКоды2015 = Истина;
	КонецЕсли;

	ДатаЗаполнения = Объект.Дата;
	Если  Объект.ФормируетсяСчетФактура И ЗначениеЗаполнено(Объект.ДатаСчетаФактуры) Тогда
		ДатаЗаполнения = Объект.ДатаСчетаФактуры;
	КонецЕсли; 
	
	CW_БухгалтерияЭкспедитораСерверПереопределяемый.ЗаполнитьСписокКодовВидовОпераций(
		ПредопределенноеЗначение("Перечисление.ЧастиЖурналаУчетаСчетовФактур.ВыставленныеСчетаФактуры"), 
		Элементы.КодВидаОперации.СписокВыбора,
		ДатаЗаполнения);
		
КонецПроцедуры

&НаКлиенте
Процедура ПервичныеДокументыВремяСчета(Команда)
	
	Если не ЗначениеЗаполнено(Объект.ДатаСчета) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не указана дата счета!",,"ДатаСчета", "Объект");
		Возврат;
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("НачальнаяДата",	Объект.ДатаСчета);
	ДополнительныеПараметры.Вставить("ИмяРеквизита", 	"ДатаСчета");
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ОбработкаИзмененияВремени",ЭтотОбъект, ДополнительныеПараметры); 
	
	ПоказатьВводДаты(ОписаниеОповещения,Объект.ДатаСчета,"Время счёта",ЧастиДаты.Время);
	
КонецПроцедуры

&НаКлиенте
Процедура ПервичныеДокументыВремяАкта(Команда)
	
	Если не ЗначениеЗаполнено(Объект.ДатаАкта) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не указана дата акта!",,"ДатаАкта", "Объект");
		Возврат;
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("НачальнаяДата",	Объект.ДатаАкта);
	ДополнительныеПараметры.Вставить("ИмяРеквизита", 	"ДатаАкта");
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ОбработкаИзмененияВремени",ЭтотОбъект, ДополнительныеПараметры); 
	
	ПоказатьВводДаты(ОписаниеОповещения,Объект.ДатаАкта,"Время акта",ЧастиДаты.Время);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаИзмененияВремени(ВведенноеЗначение, ДополнительныеПараметры) Экспорт 
	
	Если ВведенноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ДатаСтрокой	 = Формат(Объект[ДополнительныеПараметры.ИмяРеквизита],"ДФ=yyyyMMdd");
	ВремяСтрокой = Формат(ВведенноеЗначение,"ДФ=HHmmss");

	Объект[ДополнительныеПараметры.ИмяРеквизита] = Дата(ДатаСтрокой+ВремяСтрокой);
	
КонецПроцедуры

&НаКлиенте
Процедура ПервичныеДокументыУстановитьНомерСчета(Команда)
	
	// для пакетной нумерации нужен номер документа
	Если (Не ЗначениеЗаполнено(Объект.Номер)) и _ИспользуетсяПакетнаяНумерация() Тогда
		ПоказатьПредупреждение(,"Для автоматического присвоения номера счета 
								|необходимо установить номер документа.");
	КонецЕсли;
	
	// присваиваем номер
	_УстановитьНомерСчета();
	_ОбновитьНомераДокументов();
	
КонецПроцедуры

&НаКлиенте
Процедура ПервичныеДокументыУстановитьНомерАкта(Команда)
	
	Если _ИспользуетсяПакетнаяНумерация() Тогда
		Если Объект.ФормируетсяСчет и ЗначениеЗаполнено(Объект.НомерСчета) Тогда
			
			Объект.НомерАкта = Объект.НомерСчета;	
			
			Если Объект.ДатаАкта = Дата(1,1,1) Тогда
				Объект.ДатаАкта = Объект.ДатаСчета;
			КонецЕсли;
			Если Объект.ДатаАкта = Дата(1,1,1) Тогда
				Объект.ДатаАкта = Объект.Дата;
			КонецЕсли;
		
		Иначе
			Если Не ЗначениеЗаполнено(Объект.Дата) Тогда
				ПоказатьПредупреждение(,"Для автоматического присвоения номера акта 
							   |необходимо установить номер документа!");
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	// присваиваем номер
	_УстановитьНомерАкта();
	_ОбновитьНомераДокументов();
	
КонецПроцедуры

&НаКлиенте
Процедура ПервичныеДокументыУстановитьНомерСчетФактуры(Команда)
	
	// если для организации прописана пакетная нумерация,
	// то предполагается, что номера всех документов в 
	// пакете должны совпадать, т.е. при попытке присвоить 
	// номер с/ф предполагаем, что он должен совпадать с
	// номером акта (если он задан). Если номер акта не 
	// определен, то номеру с/ф будет присвоен номер счета.
	// Если номер счета не определен, то номер акта будет 
	// присвоен в соответствии с алгоритмом пакетной нумерации, 
	// указанным в учетной gолитике организации
	
	Если _ИспользуетсяПакетнаяНумерация() Тогда
		
		// пытаемся присвоить номер акта
		Если Объект.ФормируетсяАкт и ЗначениеЗаполнено(Объект.НомерАкта) Тогда
			Объект.НомерСчетаФактуры = Объект.НомерАкта;	
			
			Если Объект.ДатаСчетаФактуры = Дата(1,1,1) Тогда
				Объект.ДатаСчетаФактуры = Объект.ДатаАкта;
			КонецЕсли;
			Если Объект.ДатаСчетаФактуры = Дата(1,1,1) Тогда
				Объект.ДатаСчетаФактуры = Объект.Дата;
			КонецЕсли;

			Возврат;
			
		// пытаемся присвоить номер счета
		ИначеЕсли  Объект.ФормируетсяСчет и ЗначениеЗаполнено(Объект.НомерСчета) Тогда
			Объект.НомерСчетаФактуры =  Объект.НомерСчета;	
			
			Если Объект.ДатаСчетаФактуры = Дата(1,1,1) Тогда
				Объект.ДатаСчетаФактуры = Объект.ДатаСчета;
			КонецЕсли;
			
			Если Объект.ДатаСчетаФактуры = Дата(1,1,1) Тогда
				Объект.ДатаСчетаФактуры = Объект.Дата;
			КонецЕсли;
			
		// проверка на возможность присвоения пакетного номера по алгоритму
		Иначе
			Если Не ЗначениеЗаполнено(Объект.Дата) Тогда
				ПоказатьПредупреждение(,"Для автоматического присвоения номера счет-фактуры 
							   |необходимо установить номер документа!");
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	// присваиваем номер	
	_УстановитьНомерСчетаФактуры();
	_ОбновитьНомераДокументов();

КонецПроцедуры

&НаСервере
Процедура ПервичныеДокументыПриСозданииНаСервере()
	
	РедактированиеФинансов_Доходы_Счета 			= CW_ПраваДоступа.ПравоДоступно("РедактированиеФинансов_Доходы_Счета");
	РедактированиеФинансов_Доходы_Акты 				= CW_ПраваДоступа.ПравоДоступно("РедактированиеФинансов_Доходы_Акты");
	ПравоРедактированияНомеровПервичныхДокументов 	= CW_ПраваДоступа.ПравоДоступно("РедактированиеНомеровПервичныхДокументов");
	
	Элементы.ГруппаСчет.Доступность				= РедактированиеФинансов_Доходы_Счета;
	Элементы.ГруппаАктСчетФактура.Доступность 	= РедактированиеФинансов_Доходы_Акты;
	
	Элементы.НомерСчета.Доступность 							= РедактированиеФинансов_Доходы_Счета И ПравоРедактированияНомеровПервичныхДокументов;
	Элементы.ПервичныеДокументыУстановитьНомерСчета.Видимость	= РедактированиеФинансов_Доходы_Счета И ПравоРедактированияНомеровПервичныхДокументов;
	
	Элементы.НомерАкта.Доступность 								= РедактированиеФинансов_Доходы_Акты И ПравоРедактированияНомеровПервичныхДокументов;
	Элементы.ПервичныеДокументыУстановитьНомерАкта.Видимость	= РедактированиеФинансов_Доходы_Акты И ПравоРедактированияНомеровПервичныхДокументов; 
	
	Элементы.НомерСчетаФактуры.Доступность 						= РедактированиеФинансов_Доходы_Акты И ПравоРедактированияНомеровПервичныхДокументов; 
	Элементы.ПервичныеДокументыУстановитьНомерСчетФактуры.Видимость	= РедактированиеФинансов_Доходы_Акты И ПравоРедактированияНомеровПервичныхДокументов; 
	
	УстановитьПривилегированныйРежим(Истина);
	ГруппаПользователя = CW_ПраваДоступа_ПИ.ГруппаПользователя(ПараметрыСеанса.ТекущийПользователь);
	УстановитьПривилегированныйРежим(Ложь);
	
	СрокОплатыДоступен = 	ГруппаПользователя = Справочники.CW_ГруппыПользователей.Администраторы 
							Или ГруппаПользователя.РедактированиеСроковОплатыИсходящихСчетов
							Или ГруппаПользователя.ПолныеПрава;
							
	ПланОплатыДоступен = 	ГруппаПользователя = Справочники.CW_ГруппыПользователей.Администраторы 
							Или ГруппаПользователя.РедактированиеФинансов_Доходы_Счета
							Или ГруппаПользователя.ПолныеПрава;
							
	УстановитьОписаниеСрокаОплаты();
	УстановитьОписаниеПланОплаты();
	
	ПервичныеДокументыУправлениеЭлементамиФормы();
	
КонецПроцедуры // ПриСозданииНаСервере()

&НаСервере
Процедура ПервичныеДокументыУправлениеЭлементамиФормы()
	
	// счет
	Элементы.ГруппаСчет.Доступность 			= РедактированиеФинансов_Доходы_Счета;
	
	Элементы.ФормируетсяСчет.Доступность 		= РедактированиеФинансов_Доходы_Счета;
	Элементы.ГруппаРеквизитыСчета.Доступность 	= РедактированиеФинансов_Доходы_Счета и Объект.ФормируетсяСчет;
	Элементы.СпособЗачетаАвансовОЗ.Видимость 	= РедактированиеФинансов_Доходы_Счета и Объект.ФормируетсяСчет И ОперативныйУчет;
	
	Элементы.ПервичныеДокументыВремяСчета.Доступность 	= РедактированиеФинансов_Доходы_Счета и НЕ (Объект.ФормируетсяСчет 
														  И Объект.СпособЗачетаАвансовОЗ = ПредопределенноеЗначение("Перечисление.СпособыЗачетаАвансов.Автоматически")
														  И НачалоДня(Объект.ДатаСчета) = НачалоДня(Объект.Дата));
	
	Элементы.ГруппаАктСчетФактура.Доступность	= РедактированиеФинансов_Доходы_Акты;
	
	Элементы.ГруппаАктСчетФактура.Видимость					= ВалютаРегламентированногоУчетаРубль;
	Элементы.ПервичныеДокументыКоманднаяПанель.Видимость	= ВалютаРегламентированногоУчетаРубль и НЕ Объект.Корректировка;
	
	Если ВалютаРегламентированногоУчетаРубль Тогда
		СтруктураПараметровБухУчета = Новый Структура;
		СтруктураПараметровБухУчета.Вставить("Договор", 				Объект.Договор);
		СтруктураПараметровБухУчета.Вставить("ПриложениеКДоговору",		Объект.ПриложениеКДоговору);
		
		ПараметрыБухгалтерскогоУчета = CW_Финансы.ПолучитьПарметрыВеденияБухгалтерскогоУчета(СтруктураПараметровБухУчета, Объект.Дата);
		
		// акт
		Элементы.ФормируетсяАкт.Доступность 			= РедактированиеФинансов_Доходы_Акты и Не Объект.Корректировка;
		Элементы.ГруппаРеквизитыАкта.Доступность 		= РедактированиеФинансов_Доходы_Акты и Объект.ФормируетсяАкт;
		Элементы.ДатаАкта.Доступность 					= РедактированиеФинансов_Доходы_Акты и Объект.ФормируетсяАкт;
		Элементы.СпособЗачетаАвансов.Видимость 			= РедактированиеФинансов_Доходы_Акты и Объект.ФормируетсяАкт И ПараметрыБухгалтерскогоУчета.БухгалтерскийУчет И НЕ Объект.Корректировка;
		
		Элементы.ЭтоУниверсальныйДокумент.Доступность 	= РедактированиеФинансов_Доходы_Акты и Объект.ФормируетсяАкт;
		
		// счет-фактура
		Если Объект.КорректируемыйДокумент.ФормируетсяСчетФактура Тогда
			Элементы.ФормируетсяСчетФактура.Доступность = Ложь;
		Иначе
			Элементы.ФормируетсяСчетФактура.Доступность 		= РедактированиеФинансов_Доходы_Акты и Объект.ФормируетсяАкт и Не Объект.Корректировка;
		КонецЕсли;
		
		Элементы.КодВидаОперации.Видимость 					= РедактированиеФинансов_Доходы_Акты и Объект.ФормируетсяСчетФактура;
		Элементы.КодВидаОперации.Доступность 				= РедактированиеФинансов_Доходы_Акты ;
		
		Элементы.ГруппаРеквизитыСчетФактуры.Доступность	= РедактированиеФинансов_Доходы_Акты и Объект.ФормируетсяСчетФактура И Объект.ФормируетсяАкт;
		
		Элементы.ИдентификаторГосКонтракта.Видимость	= РедактированиеФинансов_Доходы_Акты и CW_БухгалтерияЭкспедитораСерверПереопределяемый.ВедетсяУчетНДСПоФЗ56(Объект.Дата);
		Элементы.ГруппаДопРеквизитыСчф.Видимость 		= РедактированиеФинансов_Доходы_Акты и Объект.ФормируетсяСчетФактура;
		
		Элементы.ПервичныеДокументыВремяАкта.Доступность	= РедактированиеФинансов_Доходы_Акты и НЕ (Объект.ФормируетсяАкт 
															  И Объект.СпособЗачетаАвансов = ПредопределенноеЗначение("Перечисление.СпособыЗачетаАвансов.Автоматически") 
															  И НачалоДня(Объект.ДатаАкта)=НачалоДня(Объект.Дата));
				
		Элементы.ГруппаАктирование.Видимость 	=  НЕ Объект.ФормируетсяСчет;
		Элементы.ГруппаАктирование.Доступность 	=  РедактированиеФинансов_Доходы_Акты;   
		
		//AFR23-3305
		Элементы.ПервичныеДокументыПодборСчетов.Видимость = Не Объект.Корректировка;
		//AFR23-3305
		
	КонецЕсли;
	
	Элементы.Счет.Видимость = НЕ Объект.СписокСчетов;
	Элементы.Счет.Доступность 	=  РедактированиеФинансов_Доходы_Акты;  
	
	// срок оплаты 
	Элементы.СрокОплаты.Доступность	= РедактированиеФинансов_Доходы_Счета и Объект.ФормируетсяСчет И СрокОплатыДоступен; 	
	Элементы.СрокОплаты.Видимость	= РедактированиеФинансов_Доходы_Счета и Объект.ФормируетсяСчет И СрокОплатыДоступен; 
	
	Элементы.ПервичныеДокументыУстановитьСрокОплаты.Доступность	= РедактированиеФинансов_Доходы_Счета и Объект.ФормируетсяСчет И СрокОплатыДоступен; 
	Элементы.ПервичныеДокументыУстановитьСрокОплаты.Видимость 	= РедактированиеФинансов_Доходы_Счета и НЕ Объект.Ссылка.Пустая(); 
	
	// план оплаты
	Элементы.ПланОплаты.Видимость = РедактированиеФинансов_Доходы_Счета и Объект.ФормируетсяСчет И НЕ Объект.Ссылка.Пустая() И ОперативныйУчет И ПланОплатыДоступен;
	
	Элементы.УслугиГруппаСчет.Видимость = Объект.СписокСчетов; 
	
	//AFR23-3305
	Элементы.УслугиКорректировкаГруппаСчет.Видимость = Объект.СписокСчетов и Объект.Корректировка; 
	//AFR23-3305
	
	//Исправления
	Элементы.НомерИсправления.Доступность = РедактированиеФинансов_Доходы_Акты И Объект.ФормируетсяСчетФактура;
	//Исправления
	
	Если ВерсияПостановленияНДС1137 >=5 Тогда
		Элементы.НадписьДокументыОбОтгрузке.Видимость  = Объект.ФормируетсяСчетФактура и Не Объект.Корректировка;
		
		Если Объект.ОтредактированыДокументыОтгрузки Тогда
			Если Объект.ДатаСчетаФактуры >= Дата(2024,10,1) Тогда
				ШаблонСтрокиДокументовОбОтгрузке = НСтр("ru = '№ %1 от %2 г.'");
				НадписьДокументыОбОтгрузке = "";
				Для Каждого СтрокаДокументаОбОтгрузке Из Объект.ДокументыОбОтгрузке Цикл
					Если ЗначениеЗаполнено(НадписьДокументыОбОтгрузке) Тогда
						НадписьДокументыОбОтгрузке = НадписьДокументыОбОтгрузке + "; ";
					КонецЕсли;
					ТекущийДокументОбОтгрузке =  СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонСтрокиДокументовОбОтгрузке,
					СтрокаДокументаОбОтгрузке.НомерДокумента,
					Формат(СтрокаДокументаОбОтгрузке.ДатаДокумента,"ДЛФ=Д"));
					НадписьДокументыОбОтгрузке = НадписьДокументыОбОтгрузке + ТекущийДокументОбОтгрузке;
				КонецЦикла;
				Если Не ЗначениеЗаполнено(НадписьДокументыОбОтгрузке) Тогда
					НадписьДокументыОбОтгрузке = НСтр("ru = '№  от  '");
				Иначе
					НадписьДокументыОбОтгрузке = НадписьДокументыОбОтгрузке;
				КонецЕсли;
			Иначе
				ШаблонСтрокиДокументовОбОтгрузке = НСтр("ru = '№ п/п %1 № %2 от %3 г.'");
				НадписьДокументыОбОтгрузке = "";
				Для Каждого СтрокаДокументаОбОтгрузке Из Объект.ДокументыОбОтгрузке Цикл
					Если ЗначениеЗаполнено(НадписьДокументыОбОтгрузке) Тогда
						НадписьДокументыОбОтгрузке = НадписьДокументыОбОтгрузке + "; ";
					КонецЕсли;
					ТекущийДокументОбОтгрузке =  СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонСтрокиДокументовОбОтгрузке,
					СтрокаДокументаОбОтгрузке.НомераСтрок,
					СтрокаДокументаОбОтгрузке.НомерДокумента,
					Формат(СтрокаДокументаОбОтгрузке.ДатаДокумента,"ДЛФ=Д"));
					НадписьДокументыОбОтгрузке = НадписьДокументыОбОтгрузке + ТекущийДокументОбОтгрузке;
				КонецЦикла;
				Если Не ЗначениеЗаполнено(НадписьДокументыОбОтгрузке) Тогда
					НадписьДокументыОбОтгрузке = НСтр("ru = '№ п/п  №  от  '");
				Иначе
					НадписьДокументыОбОтгрузке = НадписьДокументыОбОтгрузке;
				КонецЕсли;
			КонецЕсли;  
		Иначе
