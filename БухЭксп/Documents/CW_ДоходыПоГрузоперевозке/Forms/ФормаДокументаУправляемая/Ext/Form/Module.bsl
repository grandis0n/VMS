	Если (строкаУслуги.ПорядокОтражения = ПредопределенноеЗначение("Перечисление.CW_ПорядокОтраженияДоходов.СобственнаяУслуга")) 
		ИЛИ (строкаУслуги.ПорядокОтражения = ПредопределенноеЗначение("Перечисление.CW_ПорядокОтраженияДоходов.ПеревыставлениеПоСтавкам"))  
		ИЛИ (строкаУслуги.ПорядокОтражения = ПредопределенноеЗначение("Перечисление.CW_ПорядокОтраженияДоходов.ПрочиеДоходы"))
	Тогда
		строкаУслуги.ДокументРасходов = Неопределено;
		строкаУслуги.База = 0;
	КонецЕсли;
	
	//AFR-233578
