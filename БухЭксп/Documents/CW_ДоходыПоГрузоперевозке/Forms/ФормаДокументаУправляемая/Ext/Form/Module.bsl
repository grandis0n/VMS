&НаСервере
Функция ПоместитьТаблицыДокументаВХранилище()
	
	ТаблицыДокумента = Новый Структура;
	ТаблицыДокумента.Вставить("ТаблицаДокументовОбОтгрузке", Объект.ДокументыОбОтгрузке.Выгрузить());
	
	мОснования = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Объект.Ссылка);		                                                            
	ТаблицыДокумента.Вставить("ТаблицаДокументовОснований",  мОснования);
	
	АдресТаблицДокумента = ПоместитьВоВременноеХранилище(ТаблицыДокумента, УникальныйИдентификатор);
	
	Возврат АдресТаблицДокумента;
	
КонецФункции

&НаКлиенте
