	КонецЦикла;
	
	Возврат СтрСоединить(Массив, ", ");
	
КонецФункции

Функция ПолучитьЗначениеПараметра(Источник, ИдентификаторПараметра,  ПолучаемоеЗначение = "Значение", СоответствиеПараметров) Экспорт

	ПараметрСсылка = СоответствиеПараметров.Получить(ИдентификаторПараметра);
	Если ПараметрСсылка = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	МассивГрузоперевозок = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ТабличнаяЧастьУслуги.Грузоперевозка КАК Грузоперевозка
	               |ИЗ
	               |	Документ.CW_ДоходыПоГрузоперевозке.Услуги КАК ТабличнаяЧастьУслуги
	               |ГДЕ
	               |	ТабличнаяЧастьУслуги.Ссылка = &Источник
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ТабличнаяЧастьУслуги.Грузоперевозка";
	
	Запрос.УстановитьПараметр("Источник", Источник); 
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		МассивГрузоперевозок.Добавить(Выборка.Грузоперевозка);
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	CW_Грузоперевозки.Ссылка КАК Ссылка,
	               |	ЕСТЬNULL(ПараметрыГрузоперевозок.Значение, ЕСТЬNULL(ПараметрыЗаказов.Значение, НЕОПРЕДЕЛЕНО)) КАК Значение,
	               |	ЕСТЬNULL(ПараметрыГрузоперевозок.ЗначениеПлан, ЕСТЬNULL(ПараметрыЗаказов.ЗначениеПлан, НЕОПРЕДЕЛЕНО)) КАК ЗначениеПлан,
	               |	ЕСТЬNULL(ПараметрыГрузоперевозок.ЗначениеФакт, ЕСТЬNULL(ПараметрыЗаказов.ЗначениеФакт, НЕОПРЕДЕЛЕНО)) КАК ЗначениеФакт
	               |ИЗ
	               |	Справочник.CW_Грузоперевозки КАК CW_Грузоперевозки
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.CW_ХарактеристикиГрузоперевозок КАК ПараметрыГрузоперевозок
	               |		ПО CW_Грузоперевозки.Ссылка = ПараметрыГрузоперевозок.Грузоперевозка
	               |			И (ПараметрыГрузоперевозок.Параметр = &Параметр)
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.CW_ХарактеристикиЗаказов КАК ПараметрыЗаказов
	               |		ПО CW_Грузоперевозки.Заказ = ПараметрыЗаказов.Заказ
	               |			И (ПараметрыЗаказов.Параметр = &Параметр)
	               |ГДЕ
	               |	CW_Грузоперевозки.Ссылка В(&МассивГрузоперевозок)";
	
	Запрос.УстановитьПараметр("МассивГрузоперевозок", 	МассивГрузоперевозок);
	Запрос.УстановитьПараметр("Параметр", 				ПараметрСсылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Массив = новый Массив;
	
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		
		ЗначениеПараметра = Выборка[ПолучаемоеЗначение];
		Если Не ЗначениеЗаполнено(ЗначениеПараметра) Тогда
			Продолжить;
		КонецЕсли;
		
		Если Массив.Найти(ЗначениеПараметра) = Неопределено Тогда
			Массив.Добавить(ЗначениеПараметра);
		конецЕсли;
		
	КонецЦикла;
	
	Возврат СтрСоединить(Массив, ", ");

КонецФункции
//---Шаблоны стандартных писем

#КонецЕсли
