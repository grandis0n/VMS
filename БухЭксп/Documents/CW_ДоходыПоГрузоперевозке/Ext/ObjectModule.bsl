						НовыйСФ.Руководитель 		= Подписанты.Руководитель;
						НовыйСФ.ГлавныйБухгалтер 	= Подписанты.ГлБух; 
						//Заявка AFR-233619 
						
						// --- 
						Если (ЗначениеЗаполнено(КодВидаОперации)) Тогда
							
							НовыйСФ.КодВидаОперации = КодВидаОперации;
							
