							Если (НовыйСФ.Дата >= Дата(2016,07,1) И ЕстьСобственные И ЕстьПеревыставление) Тогда
								
								НовыйСФ.КодВидаОперации = "15";
								
							Иначе
								
								
								НовыйСФ.КодВидаОперации = "01";
								
								мКоды = Новый Массив;
