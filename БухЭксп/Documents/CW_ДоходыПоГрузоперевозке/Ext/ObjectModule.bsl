						НовыйСФ.ДатаВыставления = ДатаСчетаФактуры;
						НовыйСФ.КодСпособаВыставления = КодСпособаВыставления;
						НовыйСФ.ОпределениеПараметровСчетаФактурыНаРеализацию();
						
						НовыйСФ.ОтредактированыДокументыОтгрузки = ОтредактированыДокументыОтгрузки;
						НовыйСФ.ДокументыОбОтгрузке.Очистить();
						НовыйСФ.ДокументыОбОтгрузке.Загрузить(ДокументыОбОтгрузке.Выгрузить());
						
						НовыйСФ.ИдентификаторГосКонтракта = ИдентификаторГосКонтракта; 
						
						//Подписанты "которые используется для вывода в печатную форму "Счет-фактура" Заявка AFR-233619     
						СтруктураПараметровДоговора = CW_Настройки.ПустаяСтруктураПолученияПараметровДоговора();
						СтруктураПараметровДоговора.Дата 				= ДатаСчетаФактуры;
