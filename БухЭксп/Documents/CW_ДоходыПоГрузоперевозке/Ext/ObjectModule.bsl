					//Для версии КОРП 
					
					Если (ЗначениеЗаполнено(НомерАкта)) Тогда
						Ведомый.Номер = НомерАкта;
					Иначе
						
						// для "сплошной" и "в пределах даты" ставим номер документа
						Если ПолитикаНумерации = Перечисления.CW_ПорядокПрисвоенияИсходящихНомеров.СплошнаяНумерация
							ИЛИ ПолитикаНумерации = Перечисления.CW_ПорядокПрисвоенияИсходящихНомеров.ВПределахДаты 
							Тогда
							
							Ведомый.Номер = СокрЛП(Номер);
							НомерАкта = Номер;
							
						КонецЕсли; 
						
						// для независимой просто получаем номер
						Если ПолитикаНумерации = Перечисления.CW_ПорядокПрисвоенияИсходящихНомеров.НезависимаяНумерация Тогда
							
							Ведомый.УстановитьНовыйНомер();
							НомерАкта = Ведомый.Номер;
							
						КонецЕсли;
						
						// внешний нумератор
						Если (ПолитикаНумерации = Перечисления.CW_ПорядокПрисвоенияИсходящихНомеров.ВнешнийНумератор) Тогда
							
							ОбработкаНумерации.УстановитьНомерАкта(ЭтотОбъект, Ведомый);
							
						КонецЕсли; 
						
					КонецЕсли;
					
					CW_Документы.ПеренестиПризнакВосстановленияПоследовательности(ЭтотОбъект,Ведомый);
					Ведомый.Записать();
					ВедомыйДокументКорректировки = Ведомый.Ссылка;
					
				КонецЕсли; 
				
				// ---------------------------------------------------------------------------- 
				
				Если (ФормируетсяСчетФактура) Тогда
					
					_сф.УстановитьЕслиНезаполнено(ДатаСчетаФактуры,Дата);
					
					ТребуетсяСозданиеСФ = Ложь;
					Если (НЕ ЗначениеЗаполнено(ВедомыйСчетФактураКорректировочный)) Тогда
						ТребуетсяСозданиеСФ=Истина;
					КонецЕсли; 
					Если (НЕ ТребуетсяСозданиеВедомого) Тогда
						Если (НЕ _СФ.ОбъектБДСуществует(ВедомыйСчетФактураКорректировочный)) Тогда
							ТребуетсяСозданиеВедомого = Истина;
						КонецЕсли; 
					КонецЕсли;
					
					//Если ТребуетсяСозданиеСФ ИЛИ ДатаСчетаФактуры <> ВедомыйСчетФактураКорректировочный.Дата ИЛИ ВедомыйСчетФактураКорректировочный.ПометкаУдаления Тогда
						
						Если ТребуетсяСозданиеСФ Тогда
							Ведомый = Документы.СчетФактураВыданный.СоздатьДокумент();
						Иначе
							Ведомый = ВедомыйСчетФактураКорректировочный.ПолучитьОбъект();
						КонецЕсли; 
						
						Ведомый.Ответственный 				= Ответственный;
						Ведомый.Организация 				= Организация;
						Ведомый.Контрагент 					= Контрагент;
						Ведомый.ИдентификаторГосКонтракта 	= ИдентификаторГосКонтракта;
						Ведомый.ВидСчетаФактуры 			= Перечисления.ВидСчетаФактурыВыставленного.Корректировочный;
						
						Если ЗначениеЗаполнено(КодВидаОперации) Тогда
							Ведомый.КодВидаОперации = КодВидаОперации;  
							Ведомый.КодВидаОперацииНаУменьшение = КодВидаОперации;  
						Иначе
							Если Ведомый.Дата >= Дата(2016,07,1) И ЕстьСобственные И ЕстьПеревыставление Тогда
								Ведомый.КодВидаОперации = "15";
								Ведомый.КодВидаОперацииНаУменьшение = "18";  
							Иначе
								
								Ведомый.КодВидаОперации = "01";
								Ведомый.КодВидаОперацииНаУменьшение = "18";  
								
								мКоды = Новый Массив;
								Если ЕстьСобственные Тогда  
									мКоды.Добавить("01");
								КонецЕсли; 
								
								Если ЕстьПеревыставление Тогда 
									мКоды.Добавить(ДС.УП.КодВидаОперацииДляИсходящихСчетовФактур);
								КонецЕсли; 
								
								Ведомый.КодВидаОперации = СтрСоединить(мКоды,";");
								
							КонецЕсли; 
						КонецЕсли; 	
						
						Если ВидОперацииКорректировки = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсправленияПоступленияРеализации.ИсправлениеОшибки") Тогда   
							
							ДанныеИсходногоДокумента = ПолучитьНомерДатаИсходногоДокумента(КорректируемыйДокумент);  
							
							Ведомый.Дата 					= Дата; 
							Ведомый.НомерИсправления 		= НомерИсправления; 
							Ведомый.НомерИсходногоДокумента	= ДанныеИсходногоДокумента.НомерСчетаФактуры; 
							Ведомый.ДатаИсходногоДокумента	= ДанныеИсходногоДокумента.ДатаСчетаФактуры; 
							Ведомый.Исправление             = Истина; 
							
							Если КорректируемыйДокумент.Корректировка Тогда
								Ведомый.ИсправляемыйСчетФактура = КорректируемыйДокумент.ВедомыйСчетФактураКорректировочный;//
								Ведомый.НомерИсправляемогоКорректировочногоДокумента 	= КорректируемыйДокумент.ВедомыйСчетФактураКорректировочный.Номер;//
								Ведомый.ДатаИсправляемогоКорректировочногоДокумента 	= КорректируемыйДокумент.ВедомыйСчетФактураКорректировочный.Дата;//
							Иначе       
								Ведомый.ИсправляемыйСчетФактура = ДанныеИсходногоДокумента.ИсправляемыйДокумент.ВедомыйСчетФактура;//
								Ведомый.ВидСчетаФактуры 		= Перечисления.ВидСчетаФактурыВыставленного.НаРеализацию; 
							КонецЕсли;   
							
						Иначе
							Ведомый.Дата				= ДатаСчетаФактуры;
							// установка номера счета-фактуры
							Если (ЗначениеЗаполнено(НомерСчетаФактуры)) Тогда
								Ведомый.Номер = НомерСчетаФактуры;
								// пытаемся опаределить номер счета фактруры в автоматическом режиме
							Иначе
								
								// для "сплошной" и "в пределах даты" ставим номер документа
								Если ПолитикаНумерации = Перечисления.CW_ПорядокПрисвоенияИсходящихНомеров.СплошнаяНумерация
									ИЛИ ПолитикаНумерации = Перечисления.CW_ПорядокПрисвоенияИсходящихНомеров.ВПределахДаты 
									Тогда
									
									Ведомый.Номер 		= Номер;
									НомерСчетаФактуры 	= Номер;
									
								ИначеЕсли ПолитикаНумерации = Перечисления.CW_ПорядокПрисвоенияИсходящихНомеров.НезависимаяНумерация Тогда 
									
									Ведомый.УстановитьНовыйНомер();
									НомерСчетаФактуры = Ведомый.Номер;
									
									// внешний нумератор
								ИначеЕсли (ПолитикаНумерации = Перечисления.CW_ПорядокПрисвоенияИсходящихНомеров.ВнешнийНумератор) Тогда
									
									//Для внешнего нумератора, весь порялдок определения номера определяется в обработке нумератора, в том числе и для исправителных
									ОбработкаНумерации.УстановитьНомерСчетаФактуры(ЭтотОбъект, Ведомый);
									
								КонецЕсли;
								
							КонецЕсли;
							
						КонецЕсли;	
						
						CW_Документы.ПеренестиПризнакВосстановленияПоследовательности(ЭтотОбъект,Ведомый);
						
						//Подписанты "которые используется для вывода в печатную форму "Счет-фактура" Заявка AFR-233619     
						СтруктураПараметровДоговора = CW_Настройки.ПустаяСтруктураПолученияПараметровДоговора();
						СтруктураПараметровДоговора.Дата 				= ДатаСчетаФактуры;
						СтруктураПараметровДоговора.Договор 			= Договор;
						СтруктураПараметровДоговора.ПриложениеКДоговору = ПриложениеКДоговору;
						
						ПараметрыДоговора	= CW_Настройки.ПолучитьПараметрыДоговора(СтруктураПараметровДоговора);
						Подписанты 			= CW_Печать.ВернутьПодписантов(Ссылка, ПараметрыДоговора);
						
						Ведомый.Руководитель 		= Подписанты.Руководитель;
						Ведомый.ГлавныйБухгалтер 	= Подписанты.ГлБух; 
						//Заявка AFR-233619 
			
						Ведомый.ОбменДанными.Загрузка=Истина;
						Ведомый.ПометкаУдаления = Ложь;
						Ведомый.Записать();
						
						ВедомыйСчетФактураКорректировочный = Ведомый.Ссылка;
						
					//КонецЕсли; 
					
				КонецЕсли; 

			КонецЕсли; 
			
		КонецЕсли;
		
		// представление документа
		Если НЕ Отказ Тогда  
			
			мПредставления = Новый Массив;
			Если ФормируетсяСчет Тогда   
				ПредставлениеСчета 	= "Счет №";
				Если Корректировка Тогда
					ПредставлениеСчета 	= "Кор.счет №";
				КонецЕсли;
				
				ПредставлениеНомераСчета = CW_Документы.ПолучитьНомерНаПечать(Новый Структура("Организация, Номер, Дата", Организация, НомерСчета, ДатаСчета));	   
				ПредставлениеДатыСчета 	 = Формат(ДатаСчета, "ДФ=dd.MM.yyyy");
				
				мПредставления.Добавить(ПредставлениеСчета + ПредставлениеНомераСчета+" от "+ПредставлениеДатыСчета);
			КонецЕсли;
			
			ЭтоУПД = ФормируетсяАкт и ЭтоУниверсальныйДокумент;
			
			Если Не ЭтоУПД Тогда
				Если ФормируетсяАкт Тогда 
					ПредставлениеАкта 	= "Акт №";
					Если Корректировка Тогда
						ПредставлениеАкта 	= "Кор.акт №";
					КонецЕсли; 
					
					ПредставлениеНомераАкта = CW_Документы.ПолучитьНомерНаПечать(Новый Структура("Организация, Номер, Дата", Организация, НомерАкта, ДатаАкта));	   
					ПредставлениеДатыАкта 	= Формат(ДатаАкта, "ДФ=dd.MM.yyyy");			
					
					мПредставления.Добавить(ПредставлениеАкта + ПредставлениеНомераАкта+" от "+ПредставлениеДатыАкта); 
					
					Если ФормируетсяСчетФактура Тогда  
						ПредставлениеСчетаФактуры 	= "С/ф №";
						Если Корректировка Тогда
							ПредставлениеСчетаФактуры 	= "Кор.с/ф №";
						КонецЕсли; 
						
						ПредставлениеНомераСчетаФактуры = CW_Документы.ПолучитьНомерНаПечать(Новый Структура("Организация, Номер, Дата", Организация, НомерСчетаФактуры, ДатаСчетаФактуры));	   
						ПредставлениеДатыСчетаФактуры 	= Формат(ДатаСчетаФактуры, "ДФ=dd.MM.yyyy");
						
						ПредставлениеИсправленияСчетаФактуры = "";
						Если ЗначениеЗаполнено(НомерИсправления) 
							И ВидОперацииКорректировки = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсправленияПоступленияРеализации.ИсправлениеОшибки") Тогда
							ПредставлениеИсправленияСчетаФактуры  =  " (испр. "+Формат(НомерИсправления, "ЧГ=0")+")";
						КонецЕсли;    
					
						мПредставления.Добавить(ПредставлениеСчетаФактуры + ПредставлениеНомераСчетаФактуры + ПредставлениеИсправленияСчетаФактуры + " от "+ПредставлениеДатыСчетаФактуры); 
					КонецЕсли; 
				КонецЕсли;  
			КонецЕсли; 
			
			Если ЭтоУПД Тогда   
				
				ВидУПД = "УПД";
				Если Корректировка и ВидОперацииКорректировки = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсправленияПоступленияРеализации.СогласованноеИзменение") Тогда
					ВидУПД = "УКД";	
				КонецЕсли;
				
				ПредставлениеИсправленияУПД = "";
				Если ФормируетсяСчетФактура Тогда  
					СтатусУПД 				= "(1)";
					ПредставлениеНомераУПД	= " №"+ CW_Документы.ПолучитьНомерНаПечать(Новый Структура("Организация, Номер, Дата", Организация, НомерСчетаФактуры, ДатаСчетаФактуры));
					ПредставлениеДатыУПД 	= ?(ДатаСчетаФактуры = Дата(1,1,1),				  	"<...>",	Формат(ДатаСчетаФактуры,"ДФ=dd.MM.yyyy"));
					
					Если ЗначениеЗаполнено(НомерИсправления) 
						И ВидОперацииКорректировки = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсправленияПоступленияРеализации.ИсправлениеОшибки") Тогда
						ПредставлениеИсправленияУПД  =  " (испр. "+Формат(НомерИсправления, "ЧГ=0")+")";
					КонецЕсли;    
					
				Иначе
					СтатусУПД 				= "(2)";
					ПредставлениеНомераУПД	= " №"+ CW_Документы.ПолучитьНомерНаПечать(Новый Структура("Организация, Номер, Дата", Организация, НомерАкта, ДатаАкта));
					ПредставлениеДатыУПД 	= ?(ДатаАкта = Дата(1,1,1), "<...>",	Формат(ДатаАкта,"ДФ=dd.MM.yyyy"));
				КонецЕсли;  
				
				ПредставлениеУПД = ВидУПД + СтатусУПД + ПредставлениеНомераУПД + ПредставлениеИсправленияУПД+ " от "+ ПредставлениеДатыУПД;
				
				мПредставления.Добавить(ПредставлениеУПД);
				
			КонецЕсли;
		
			Если мПредставления.Количество() = 0 Тогда
				мПредставления.Добавить("<"+ЭтотОбъект+">");
			КонецЕсли;
			
			ПредставлениеДокумента = СтрСоединить(мПредставления, "; ");
		КонецЕсли; // формирование представления документа
		
	КонецЕсли; // запись, проведение и отмена проведения документа 
	
	Если (НЕ ФормироватьСчет И ЗначениеЗаполнено(ВедомыйСчет) И НЕ ВедомыйСчет.ПометкаУдаления) Тогда
		Ведомый = ВедомыйСчет.ПолучитьОбъект();
		Ведомый.УстановитьПометкуУдаления(Истина);
	КонецЕсли; 
	Если (НЕ ФормироватьАкт И ЗначениеЗаполнено(ВедомыйДокумент) И НЕ ВедомыйДокумент.ПометкаУдаления) Тогда
		Ведомый = ВедомыйДокумент.ПолучитьОбъект();
		Ведомый.УстановитьПометкуУдаления(Истина);
	КонецЕсли; 
	Если (НЕ ФормироватьСчетФактуру И ЗначениеЗаполнено(ВедомыйСчетФактура) И НЕ ВедомыйСчетФактура.ПометкаУдаления) Тогда
		Ведомый = ВедомыйСчетФактура.ПолучитьОбъект();
		Ведомый.УстановитьПометкуУдаления(Истина);
	КонецЕсли; 
	
	Если (КонтроллироватьДатыПеревыставления) Тогда
		
		Если (СтаршаяДатаРасходов > ДатаАкта) Тогда
			
			Отказ = Истина;
			Сообщить(ЭтотОбъект);
			Сообщить("В документы обнаружены перевыставляемые расходы, документы поступления по которым отражены позднее даты акта, указанной в документе.");
			Сообщить("Для корректного перевыставления расходов рекумендуем установить дату акта позднее "+Формат(СтаршаяДатаРасходов,"ДЛФ=")+"."); 
			
		КонецЕсли; 
		
	КонецЕсли; 
	
	#Область ЗачетАвансов 
	
	Если (НЕ Корректировка) Тогда
		
		// заполнение ТЧ "ЗачетАвансаОЗ"
		Если (СпособЗачетаАвансовОЗ = Перечисления.СпособыЗачетаАвансов.Автоматически 
			И ДС.УП.ОЗ
			И РежимЗаписи=РежимЗаписиДокумента.Проведение
			И ФормируетсяСчет) 
		Тогда
			
			Если (НачалоДня(ДатаСчета) <> НачалоДня(Дата)) Тогда
				Сообщить(Строка(ЭтотОбъект));
				Сообщить("При ведении учета оперативной задолженности и автоматическом зачете авансов (ОУ) дата документа должна совпадать с датой счета");
			КонецЕсли; 
			
			ДатаПодбораАвансов = Новый Граница(МоментВремени(),ВидГраницы.Исключая);
			ЗаполнитьТаблицуАвансовОЗ(ДатаПодбораАвансов);
			
		ИначеЕсли (СпособЗачетаАвансовОЗ = Перечисления.СпособыЗачетаАвансов.НеЗачитывать) Тогда 
			ЗачетАвансовОЗ.Очистить();		 
			
		КонецЕсли; 
		
		// заполнение ТЧ "ЗачетАванса"
		Если (СпособЗачетаАвансов = Перечисления.СпособыЗачетаАвансов.Автоматически
			И РежимЗаписи=РежимЗаписиДокумента.Проведение 
			И (ФормируетсяАкт)) 
		Тогда
			
			Если (НачалоДня(ДатаАкта) <> НачалоДня(Дата)) Тогда
				Сообщить(Строка(ЭтотОбъект));
				Сообщить("При автоматическом зачете авансов (БУ) дата документа должна совпадать с датой акта");
			КонецЕсли; 
			
			Если ЗначениеЗаполнено(ВедомыйДокумент) Тогда
				ЗаполнитьТаблицуАвансов(Новый Граница(ВедомыйДокумент.МоментВремени(),ВидГраницы.Исключая));
			Иначе
				ЗаполнитьТаблицуАвансов(Новый Граница(ДатаАкта,ВидГраницы.Исключая));
			КонецЕсли;
			
		ИначеЕсли (СпособЗачетаАвансов = Перечисления.СпособыЗачетаАвансов.НеЗачитывать) Тогда 
			ЗачетАвансов.Очистить();		 
			
		КонецЕсли;
		
		// заполнение таб.части "Платёжно-расчётные документы с/ф"
		Если ПорядокЗаполненияРасчётноПлатёжныхДокументовСФ = Перечисления.CW_ПорядокЗаполненияРасчётноПлатёжныхДокументовСФ.Автоматически 
			И РежимЗаписи=РежимЗаписиДокумента.Проведение 
			И ФормироватьСчетФактуру
		Тогда 
			Ответ = Документы.CW_ДоходыПоГрузоперевозке.ПолучитьТаблицу_ПлатёжноРасчётныеДокументы_дляСФ(ЭтотОбъект.Ссылка, ЗачетАвансов, Услуги);
			Если Ответ.Код = 0 Тогда
				ЭтотОбъект.ПлатёжноРасчётныеДокументы.Загрузить(Ответ.ПлатёжноРасчётныеДокументы);
			Иначе 
				Сообщить(Ответ.ОписаниеОшибки);
			КонецЕсли;
			
		ИначеЕсли ПорядокЗаполненияРасчётноПлатёжныхДокументовСФ = Перечисления.CW_ПорядокЗаполненияРасчётноПлатёжныхДокументовСФ.НеУчитывать Тогда  
			ЭтотОбъект.ПлатёжноРасчётныеДокументы.Очистить();
			
		КонецЕсли;
		
	КонецЕсли; 
	
	#КонецОбласти 
	
КонецПроцедуры   

Функция ПолучитьНомерДатаИсходногоДокумента(ИсправляемыйДокумент)
	
	Если ИсправляемыйДокумент.Корректировка Тогда
		Возврат ПолучитьНомерДатаИсходногоДокумента(ИсправляемыйДокумент.КорректируемыйДокумент);
	Конецесли;            
	
	ДанныеИсходногоДокумента = Новый Структура;
	ДанныеИсходногоДокумента.Вставить("ИсправляемыйДокумент", 	ИсправляемыйДокумент);
	ДанныеИсходногоДокумента.Вставить("НомерСчетаФактуры", 		ИсправляемыйДокумент.НомерСчетаФактуры);
	ДанныеИсходногоДокумента.Вставить("ДатаСчетаФактуры", 		ИсправляемыйДокумент.ДатаСчетаФактуры);
	
	Возврат ДанныеИсходногоДокумента; 
		
КонецФункции

	
Функция ПолучитьМассивУслугДокумента(ИсключитьПеревыставление) 
	
	МассивУслуг = Новый Массив;                               
	
	Для Каждого СтрокаУслуг из Услуги Цикл                    
		Если ИсключитьПеревыставление и СтрокаУслуг.ПорядокОтражения = ПредопределенноеЗначение("Перечисление.CW_ПорядокОтраженияДоходов.Перевыставление") Тогда
			Продолжить;
		КонецЕсли;
		
		Если МассивУслуг.Найти(СтрокаУслуг.Номенклатура) = Неопределено Тогда
			МассивУслуг.Добавить(СтрокаУслуг.Номенклатура);	
		КонецЕсли;
		
	КонецЦикла;

	Возврат МассивУслуг;
	
КонецФункции

Процедура ПриЗаписи(Отказ)
	
	// контроль загрузки
	Если ОбменДанными.Загрузка Тогда 
		Возврат; 
	КонецЕсли;
	
	Если (РучнаяКорректировка) Тогда 
		Возврат; 
	КонецЕсли; 
	
	// не перепроводим при восстановлении последовательности
	ВосстановлениеПоследовательности = _сф.ст_ПолучитьСвойство(ДополнительныеСвойства,"ПроведенВХронологическойПоследовательности");
	Если (ВосстановлениеПоследовательности <> Неопределено) Тогда
		Если (ВосстановлениеПоследовательности) Тогда
			Возврат;
		КонецЕсли; 
	КонецЕсли; 
	
	//Для версии КОРП 
	ВестиУчетПоПодразделениям = ПолучитьФункциональнуюОпцию("ВестиУчетПоПодразделениям");
	//Для версии КОРП 
	
	//Подситема.СтатусыДокументов
	ИспользуютсяСтатусыДокументов = ПолучитьФункциональнуюОпцию("CW_ИспользуютсяСтатусыДокументов");
	Если ИспользуютсяСтатусыДокументов И
		Не ЭтотОбъект.ДополнительныеСвойства.Свойство("СтатусДокумента") Тогда
		//В случае если используются статусы документа и проведение не из формы, тов ДС статуса нет
		ДанныеСтатуса = РегистрыСведений.CW_СтатусыДокументов.ПолучитьДанныеСтатусаДокумента(Ссылка);
		ЭтотОбъект.ДополнительныеСвойства.Вставить("СтатусДокумента", ДанныеСтатуса.СтатусДокумента);
	КонецЕсли;
	
	СтатусДокумента = Неопределено;
	ЭтотОбъект.ДополнительныеСвойства.Свойство("СтатусДокумента", СтатусДокумента);
	
	СтатусДокументаПроводитьПоБухгалтерскомуУчету = CW_СтатусыДокументовСервер.ПолучитьПризнакПроведенияПоБухгалтерскомуУчету(Ссылка, СтатусДокумента);
	//Подситема.СтатусыДокументов
	
	// контроль наличия общих параметров
	Если НЕ ЗаполненыОбщиеПараметры() Тогда	
		СформироватьОбщиеПараметры(,Ложь); 
	КонецЕсли; 
	
	// определяем, что делать с подчинённым документом
	РежимЗаписи = _сф.ст_ПолучитьСвойство(ДополнительныеСвойства,"РежимЗаписи");
	
	Если (РежимЗаписи = РежимЗаписиДокумента.Запись) Тогда
		ПроверитьСтатусВедомых();
		Возврат;
	КонецЕсли;  
	
	ВедетсяУчетПриложенийПоДоговорам = ПолучитьФункциональнуюОпцию("CW_ВедетсяУчетПриложенийПоДоговорам");
	
	СтруктураПараметровБухУчета = Новый Структура;
	СтруктураПараметровБухУчета.Вставить("Договор", 				Договор);
	СтруктураПараметровБухУчета.Вставить("ПриложениеКДоговору",		ПриложениеКДоговору);
	СтруктураПараметровБухУчета.Вставить("ВедетсяУчетПриложений",	ВедетсяУчетПриложенийПоДоговорам);
	
	ПараметрыБухгалтерскогоУчета  = CW_Финансы.ПолучитьПарметрыВеденияБухгалтерскогоУчета(СтруктураПараметровБухУчета, Дата);
	ПровестиПоБухгалтерскомуУчету = ПараметрыБухгалтерскогоУчета.БухгалтерскийУчет и СтатусДокументаПроводитьПоБухгалтерскомуУчету;
	
	Если (РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения) Тогда
		
		Если (НЕ Корректировка) Тогда
			
			// проверяем возможность отмены проведения
			Если НЕ ПроверитьЗакрытиеГрузоперевозок() Тогда
				
				Сообщить("В документе присутствуют закрытие грузоперевозки. Операция отменена.",СтатусСообщения.Важное);
				Отказ = Истина;
				Возврат;
				
			КонецЕсли;
			
		КонецЕсли; 
		
		ПроверитьСтатусВедомых();
		
		// делаем отмену проведения ведомых документов
		Если (НЕ Корректировка) Тогда
			Если (НЕ ВедомыйДокумент.Пустая()) Тогда
				Если (НЕ ВедомыйДокумент.ПометкаУдаления) Тогда
					ВедомыйОбъект = ВедомыйДокумент.ПолучитьОбъект();
					_сф.ст_УстановитьСвойство(ВедомыйОбъект.ДополнительныеСвойства,"ВедущийДокумент",Ссылка);
					ВедомыйОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения);	
				КонецЕсли; 
			КонецЕсли;
		Иначе
			Если (НЕ ВедомыйДокументКорректировки.Пустая() и ВедомыйДокументКорректировки.ПометкаУдаления) Тогда
				ВедомыйОбъект = ВедомыйДокументКорректировки.ПолучитьОбъект();
				_сф.ст_УстановитьСвойство(ВедомыйОбъект.ДополнительныеСвойства,"ВедущийДокумент",Ссылка);
				ВедомыйОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения);	
			КонецЕсли; 
		КонецЕсли; 
		
		Для каждого Набор Из Движения Цикл
			Набор.Прочитать();
			Набор.Очистить();
		КонецЦикла;
		
		Движения.Записать();
		Возврат;
	КонецЕсли;
	
	Если (РежимЗаписи = РежимЗаписиДокумента.Проведение) Тогда
		
		Если ЗначениеЗаполнено(ПриложениеКДоговору) Тогда
			Если ЗначениеЗаполнено(ПриложениеКДоговору.ДатаЗакрытия) И (КонецДня(ПриложениеКДоговору.ДатаЗакрытия) <= Дата) Тогда
				Отказ = Истина;
				Сообщить(Ссылка);
				Сообщить("Проведение документа позднее даты закрытия приложения к договору с контрагентом невозможно!");
				Возврат;
			КонецЕсли; 
		КонецЕсли; 

		Если ЗначениеЗаполнено(Договор.ДатаЗакрытия) И (КонецДня(Договор.ДатаЗакрытия) <= Дата) Тогда
			Отказ = Истина;
			Сообщить(Ссылка);
			Сообщить("Проведение документа позднее даты закрытия договора с контрагентом невозможно!");
			Возврат;
		КонецЕсли; 
		
		ОчищатьДвижения = Истина;
		
		// удаляем собственные движения	
		Если (ПровестиПоБухгалтерскомуУчету И ФормируетсяАкт) Тогда
			
			Если (НЕ Корректировка) Тогда
				ПроверяемыйДокумент = ВедомыйДокумент;
			Иначе
				ПроверяемыйДокумент = ВедомыйДокументКорректировки;
			КонецЕсли;
			
			Если (НЕ ПроверяемыйДокумент.РучнаяКорректировка) Тогда
				
				ОчищатьДвижения = Истина;
				
			Иначе 
				
				СтатусПроведенияДоПроведения = _сф.ст_ПолучитьСвойство(ДополнительныеСвойства,"СтатусПроведенияДоПроведения",Ложь);
				Если (НЕ СтатусПроведенияДоПроведения) Тогда
					Сообщить(Ссылка);
					Сообщить("Ведомый документ содержит признак ручной корректировки. Проведение заблокировано.");
					Отказ = Истина;
					Возврат;
				Иначе	
					
					Сообщить("Внимание! У ведомого документа "+Строка(ПроверяемыйДокумент)+" установлен признак ручной корректировки движений!");
					ОчищатьДвижения = Ложь;
					// ничего не делаем
				КонецЕсли; 
				
			КонецЕсли; 
			
		КонецЕсли; 
		
		Если (ОчищатьДвижения) Тогда
			Для каждого Набор Из Движения Цикл
				Набор.Прочитать();
				Набор.Очистить();
			КонецЦикла;
			Движения.Записать();
		Иначе
			Возврат;
		КонецЕсли; 
		
		Счета = CW_Конфигурация.ПланСчетов(); 
		
		Если (НЕ Корректировка) Тогда
			
			Если (ПровестиПоБухгалтерскомуУчету) Тогда
				
				//  формируем ведомый счет
				Если (ФормируетсяСчет И ДС.УП.ФормироватьСчетаПокупателюНаОплату) Тогда
					
					ВедомыйОбъектСчет = ВедомыйСчет.ПолучитьОбъект();
					ВедомыйОбъектСчет.УстановитьПометкуУдаления(ПометкаУдаления);
					// --- 
					ВедомыйОбъектСчет.Организация = Организация;
					ВедомыйОбъектСчет.Контрагент = Контрагент;
					ВедомыйОбъектСчет.ДоговорКонтрагента = ПараметрыБухгалтерскогоУчета.УчетныйДоговор;
					ВедомыйОбъектСчет.ОрганизацияПолучатель = Организация; 
					
					ВедомыйОбъектСчет.СуммаВключаетНДС = ЦенаСНДС;
					
					//Для версии КОРП
					Если ВестиУчетПоПодразделениям Тогда
						ВедомыйОбъектСчет.ПодразделениеОрганизации = ПодразделениеОрганизации;
					КонецЕсли;
					//Для версии КОРП
					
					// --- 
					РасчетныйСчет = ДС.ПД.РасчетныйСчетОрганизации;
					Если (НЕ ЗначениеЗаполнено(РасчетныйСчет)) Тогда
						ВедомыйОбъектСчет.СтруктурнаяЕдиница = Организация.ОсновнойБанковскийСчет;
					Иначе
						ВедомыйОбъектСчет.СтруктурнаяЕдиница = РасчетныйСчет;
					КонецЕсли;	
					// --- 
					ВедомыйОбъектСчет.ВалютаДокумента = Валюта;
					// --- 
					ВедомыйОбъектСчет.Ответственный = Ответственный;
					ВедомыйОбъектСчет.Комментарий = "Сформировано автоматически (CW) документом ""Доходы по грузоперевозке"" №"+Строка(Номер)+" от "+Формат(Дата,"ДФ=dd.MM.yyyy");
					// --- 
					ВедомыйОбъектСчет.Руководитель = Руководитель;
					Если (ВедомыйОбъектСчет.Метаданные().Реквизиты.Найти("ЗаРуководителяНаОсновании") <> Неопределено) Тогда
						ВедомыйОбъектСчет.ЗаРуководителяНаОсновании = ЗаРуководителяПоПриказу;
					Иначе
						ВедомыйОбъектСчет.ЗаРуководителяПоПриказу = ЗаРуководителяПоПриказу;
					КонецЕсли; 
					// --- 
					ВедомыйОбъектСчет.ГлавныйБухгалтер = ГлавныйБухгалтер;
					Если (ВедомыйОбъектСчет.Метаданные().Реквизиты.Найти("ЗаГлавногоБухгалтераНаОсновании") <> Неопределено) Тогда
						ВедомыйОбъектСчет.ЗаГлавногоБухгалтераНаОсновании = ЗаГлавногоБухгалтераПоПриказу;
					Иначе
						ВедомыйОбъектСчет.ЗаГлавногоБухгалтераПоПриказу = ЗаГлавногоБухгалтераПоПриказу;
					КонецЕсли;
					// --- 
					Если Валюта = ДС.КО.ВалютаРегламентированногоУчета Тогда
						ВедомыйОбъектСчет.КурсВзаиморасчетов = 1;
						ВедомыйОбъектСчет.КратностьВзаиморасчетов = 1;
					Иначе
						СК = РегистрыСведений.КурсыВалют.ПолучитьПоследнее(Дата, Новый Структура("Валюта", Валюта));
						ВедомыйОбъектСчет.КурсВзаиморасчетов = СК.Курс;
						ВедомыйОбъектСчет.КратностьВзаиморасчетов = СК.Кратность;
					КонецЕсли;
					// --- 
					ОсновноеПодразделение = Неопределено;
					// --- 
					ЕстьТовары = (Документы.СчетНаОплатуПокупателю.ПустаяСсылка().Метаданные().ТабличныеЧасти.Найти("Товары") <> Неопределено);
					Если (ЕстьТовары) Тогда
						
						ВедомыйОбъектСчет.Товары.Очистить();
						Для каждого СтрТЧ Из Услуги Цикл
							
							Нстр = ВедомыйОбъектСчет.Товары.Добавить();
							// ---------------------------------------------------------------------------- 
							Нстр.Номенклатура = СтрТЧ.Номенклатура;
							Нстр.Содержание = СокрЛП(СтрТЧ.Представление);
							Нстр.Количество = СтрТЧ.Количество;
							Нстр.Цена 		= СтрТЧ.Цена;
							Нстр.Сумма 		= СтрТЧ.Сумма;
							Нстр.СтавкаНДС 	= СтрТЧ.СтавкаНДС;
							Нстр.СуммаНДС 	= СтрТЧ.НДС;    
							
							Если ЦенаСНДС Тогда
								Нстр.Сумма = Нстр.Сумма + Нстр.СуммаНДС; 
							КонецЕсли;

						КонецЦикла; 
						
					Иначе
						
						ВедомыйОбъектСчет.Услуги.Очистить();
						Для каждого СтрТЧ Из Услуги Цикл
							
							Нстр = ВедомыйОбъектСчет.Услуги.Добавить();
							// ---------------------------------------------------------------------------- 
							Нстр.Номенклатура 	= СтрТЧ.Номенклатура;
							Нстр.Содержание 	= СокрЛП(СтрТЧ.Представление);
							Нстр.Количество 	= СтрТЧ.Количество;
							Нстр.Цена 			= СтрТЧ.Цена;
							Нстр.Сумма 			= СтрТЧ.Сумма;  
							Нстр.СтавкаНДС 		= СтрТЧ.СтавкаНДС;
							Нстр.СуммаНДС 		= СтрТЧ.НДС; 
							
							Если ЦенаСНДС Тогда
								Нстр.Сумма = Нстр.Сумма + Нстр.СуммаНДС;  
							КонецЕсли;
							
						КонецЦикла; 
						
					КонецЕсли; 
					
					// --- 
					CW_Документы.ПеренестиПризнакВосстановленияПоследовательности(ЭтотОбъект,ВедомыйОбъектСчет);
					
					// s.anton@coralway.ru 2018-05-29 19:02:34 НАЧАЛО...
					// чтобы документ нормально вставал на регистрацию в ЭДО, при том, что его несколько раз записывают и в нужный момент не выглядит новым (немодифицированным)
					CW_Подписки.ПодготовитьДокументОбъектДляЭДО(ВедомыйОбъектСчет, Отказ, РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Неоперативный);
					// ... /s.anton@coralway.ru 2018-05-29 19:02:34 КОНЕЦ
					
					// пытаемся записать документ
					Отказ = CW_Документы.ПроверкаНомера(ВедомыйОбъектСчет, РежимЗаписиДокумента.Проведение, ЭтотОбъект.Ссылка,Ложь);
					Если Отказ Тогда 
						Возврат; 
					КонецЕсли;
					
					// пропишем срок оплаты, если это предусмотрено настройками типовой БП
					ИспользоватьПланирование = ПолучитьФункциональнуюОпцию("ИспользоватьПланированиеПлатежейОтПокупателей");
					Если ИспользоватьПланирование Тогда
						ЗаписьРегистра = РегистрыСведений.CW_СрокиОплатыСчетов.СоздатьМенеджерЗаписи();
						ЗаписьРегистра.Счет = Ссылка;
						ЗаписьРегистра.Прочитать();   
						Если ЗаписьРегистра.Выбран() Тогда 
							СрокиОплатыДокументов.ЗаписатьСрокОплатыДокумента(ВедомыйСчет, ЗаписьРегистра.ДатаОплаты);
						КонецЕсли;
					КонецЕсли;
					
					// Если для целей оперативного учета задолженности документ проводится в режиме ввода остатков,
					// то принудительно пропишем статус ведомого счета (при проведении в обычном режиме статус не прописываем,
					// т.к. он будет определен типовой конфигурацией на момент записи документа)
					СтруктураНастроек  = CW_Настройки.ПолучитьНастройкиОперативногоУчета(Организация,Перечисления.CW_ВидыОперативнойЗадолженности.Дебиторская, Дата); 

					Если СтруктураНастроек["ВедетсяОперативныйУчет"] Тогда
						РежимВводНачальныхОстатков = СтруктураНастроек["ВводОстатков"];
						Если РежимВводНачальныхОстатков Тогда
							
							// статус оплаты
							СтатусОплаты = Перечисления.СтатусОплатыСчета.НеОплачен;
							Если СальдоВзаиморасчетовОЗ <= 0 Тогда
								СтатусОплаты = Перечисления.СтатусОплатыСчета.Оплачен;
							Иначе
								Если СальдоВзаиморасчетовОЗ < Услуги.Итог("Всего") Тогда
									СтатусОплаты = Перечисления.СтатусОплатыСчета.ОплаченЧастично;
								КонецЕсли; 
							КонецЕсли; 
							
							// статус отгрузки
							СтатусОтгрузки = ?(ФормируетсяАкт,Перечисления.СтатусыОтгрузки.Отгружен,Перечисления.СтатусыОтгрузки.НеОтгружен);
							
							МассивДокументов = Новый Массив;
							МассивДокументов.Добавить(ВедомыйОбъектСчет.Ссылка);
							
							// пишем в регистр
							СтатусыДокумента = РегистрыСведений.СтатусыДокументов.НовыеСтатусыДокумента();
							СтатусыДокумента.Статус            		= СтатусОплаты;
							СтатусыДокумента.ДополнительныйСтатус	= СтатусОтгрузки;
							РегистрыСведений.СтатусыДокументов.УстановитьСтатусыДокументов(МассивДокументов,СтатусыДокумента);
						КонецЕсли; // это режим ввода остатков 
					КонецЕсли; // по организации ведется учет оперативной задолженности
					
				// если счет формировать не нужно, а ссылка на документ есть, 
				// то помечаем его на удаление
				Иначе
					Если (НЕ ВедомыйСчет.Пустая()) Тогда
						ПометитьНаУдаление(ВедомыйСчет);
					КонецЕсли; 
				КонецЕсли; // проверка на необходимость формирования счета покупателю		
				
				// формируем ведомый акт
				Если (ФормируетсяАкт) Тогда
					
					ВедомыйОбъект = ВедомыйДокумент.ПолучитьОбъект();
					ВедомыйОбъект.УстановитьПометкуУдаления(ПометкаУдаления);
					
					_сф.ст_УстановитьСвойство(ВедомыйОбъект.ДополнительныеСвойства,"ВедущийДокумент",Ссылка);
					_сф.ст_УстановитьСвойство(ВедомыйОбъект.ДополнительныеСвойства,"ЗависимоеПроведение",Истина);
					
					// --- 
					ВедомыйОбъект.ВидОперации=Перечисления.ВидыОперацийРеализацияТоваров.ПродажаКомиссия;
					ВедомыйОбъект.Организация = Организация;
					
					//Для версии КОРП
					Если ВестиУчетПоПодразделениям Тогда
						ВедомыйОбъект.ПодразделениеОрганизации = ПодразделениеОрганизации;
					КонецЕсли;
					//Для версии КОРП
					
					ВедомыйОбъект.СопроводительныеДокументы = СопроводительныеДокументы;
					ВедомыйОбъект.СведенияОТранспортировкеИГрузе = СведенияОТранспортировкеИГрузе;
					
					ВедомыйОбъект.ВидЭлектронногоДокумента=Перечисления.ТипыДокументовЭДО.АктВыполненныхРабот;
					
					ВедомыйОбъект.Контрагент = Контрагент;
					ВедомыйОбъект.ДоговорКонтрагента = ПараметрыБухгалтерскогоУчета.УчетныйДоговор;
					// --- 
					ВедомыйОбъект.СуммаВключаетНДС = Ложь;
					ВедомыйОбъект.ВалютаДокумента = Валюта;
					// --- 
					ВедомыйОбъект.СчетНаОплатуПокупателю = Документы.CW_ДоходыПоГрузоперевозке.ПолучитьСчетНаОплатуПокупателю(Ссылка);
					
					ВедомыйОбъект.БанковскийСчетОрганизации = Организация.ОсновнойБанковскийСчет;
					Если ЗначениеЗаполнено(ДС.ПД.РасчетныйСчетОрганизации) Тогда
						ВедомыйОбъект.БанковскийСчетОрганизации = ДС.ПД.РасчетныйСчетОрганизации; 
					КонецЕсли; 
					
					// --- 
					ВедомыйОбъект.Ответственный = Ответственный;
					// --- 
					ВедомыйОбъект.Руководитель = Руководитель;
					Если (ВедомыйОбъект.Метаданные().Реквизиты.Найти("ЗаРуководителяНаОсновании") <> Неопределено) Тогда
						ВедомыйОбъект.ЗаРуководителяНаОсновании = ЗаРуководителяПоПриказу;
					Иначе
						ВедомыйОбъект.ЗаРуководителяПоПриказу = ЗаРуководителяПоПриказу;
					КонецЕсли; 
					// --- 
					ВедомыйОбъект.ГлавныйБухгалтер = ГлавныйБухгалтер;
					Если (ВедомыйОбъект.Метаданные().Реквизиты.Найти("ЗаГлавногоБухгалтераНаОсновании") <> Неопределено) Тогда
						ВедомыйОбъект.ЗаГлавногоБухгалтераНаОсновании = ЗаГлавногоБухгалтераПоПриказу;
					Иначе
						ВедомыйОбъект.ЗаГлавногоБухгалтераПоПриказу = ЗаГлавногоБухгалтераПоПриказу;
					КонецЕсли;
					// --- 
					ВедомыйОбъект.Комментарий = "Сформировано автоматически (CW) документом ""Доходы по грузоперевозке"" №"+Строка(Номер)+" от "+Формат(Дата,"ДФ=dd.MM.yyyy");
					
					// устанавливаем счета расчетов по-умолчанию и определяем курс взаиморасчетов
					ПЗ = Новый Структура("СчетУчетаРасчетовСКонтрагентом,СчетУчетаРасчетовПоАвансам,КурсВзаиморасчетов,КратностьВзаиморасчетов");
					Если (Валюта = ДС.КО.ВалютаРегламентированногоУчета) Тогда
						
						ПЗ.СчетУчетаРасчетовСКонтрагентом = Счета.РасчетыСПокупателями; // 62.01
						ПЗ.СчетУчетаРасчетовПоАвансам = Счета.РасчетыПоАвансамПолученным; // 62.02
						// --- 
						ПЗ.КурсВзаиморасчетов = 1;
						ПЗ.КратностьВзаиморасчетов = 1;
						
					Иначе
						
						Если УЕ_ПользовательскийКурс Тогда
							СК = Новый Структура("Курс,Кратность",УЕ_Курс,УЕ_Кратность);
						Иначе
							СК = РегистрыСведений.КурсыВалют.ПолучитьПоследнее(ВедомыйОбъект.Дата, Новый Структура("Валюта", Валюта));
						КонецЕсли;
						//Если ДополнительныеСвойства.УП.УчитыватьКурсыВалютАвансовДляБазыНДС
						//	И ЗачетАвансов.Количество()>0
						//Тогда 
						//	СК = ПриведённыйКурсСУчётомВалютныхАвансов(СК);
						//КонецЕсли;
						
						ПЗ.КурсВзаиморасчетов = СК.Курс;
						ПЗ.КратностьВзаиморасчетов = СК.Кратность;

						
						Контракт = ?(ЗначениеЗаполнено(ПриложениеКДоговору),ПриложениеКДоговору,Договор);
						Если (НЕ Контракт.ВзаиморасчетыВУЕ) Тогда
							ПЗ.СчетУчетаРасчетовСКонтрагентом = Счета.РасчетыСПокупателямиВал; // 62.01
							ПЗ.СчетУчетаРасчетовПоАвансам = Счета.РасчетыПоАвансамПолученнымВал; // 62.02
						Иначе
							ПЗ.СчетУчетаРасчетовСКонтрагентом = Счета.РасчетыСПокупателямиУЕ; // 62.31
							ПЗ.СчетУчетаРасчетовПоАвансам = Счета.РасчетыПоАвансамПолученнымУЕ; // 62.32
						КонецЕсли;
						
					КонецЕсли;
					ЗаполнитьЗначенияСвойств(ВедомыйОбъект,ПЗ);
					
					// устанавливаем способ зачета авансов - не зачитывать
					// способ зачета будет переопределяться в подписке самого ведомого документа (!!!)
					ВедомыйОбъект.СпособЗачетаАвансов = Перечисления.СпособыЗачетаАвансов.НеЗачитывать;
					
					// --- 
					ОсновноеПодразделение = Неопределено;
					// --- 
					ВедомыйОбъект.Услуги.Очистить();
					ВедомыйОбъект.АгентскиеУслуги.Очистить();
					// --- 
					ВД_ОсновнаяСистема = Перечисления.ВидыДеятельностиДляНалоговогоУчетаЗатрат["ОсновнаяСистемаНалогообложения"];
					ВД_ЕНВД = Перечисления.ВидыДеятельностиДляНалоговогоУчетаЗатрат["ОсобыйПорядокНалогообложения"];
					// --- 
					Для каждого СтрТЧ Из Услуги Цикл
						
						// собственная услуга
						Если (стрТЧ.ПорядокОтражения = Перечисления.CW_ПорядокОтраженияДоходов.СобственнаяУслуга) Тогда
							
							Нстр = ВедомыйОбъект.Услуги.Добавить();
							// ---------------------------------------------------------------------------- 
							Нстр.Номенклатура = СтрТЧ.Номенклатура;
							Нстр.Содержание = СокрЛП(СтрТЧ.Представление);
							Нстр.Количество = СтрТЧ.Количество;
							// --- 
							Если ЦенаСНДС Тогда
								Нстр.Цена = СтрТЧ.Цена - СтрТЧ.НДС/?(СтрТЧ.Количество=0,1,СтрТЧ.Количество);
							Иначе
								Нстр.Цена = СтрТЧ.Цена;
							КонецЕсли;    
							
							Нстр.Сумма 		= СтрТЧ.Сумма;
							Нстр.СтавкаНДС 	= СтрТЧ.СтавкаНДС;
							Нстр.СуммаНДС 	= СтрТЧ.НДС;
							Нстр.СчетУчетаНДСПоРеализации = Счета.Продажи_НДС; // 90.03
							
							// определяем счета реализации по ЕНВД/неЕНВД
							Если (СтрТЧ.СтатьяЗатрат.ВидДеятельностиДляНалоговогоУчетаЗатрат = ВД_ОсновнаяСистема) Тогда
								
								// не ЕНВД
								Нстр.СчетДоходов = Счета.ВыручкаНеЕНВД; // 90.01.1
								Нстр.Субконто = СтрТЧ.Номенклатура.НоменклатурнаяГруппа; // номенклатураня группа
								Нстр.СчетРасходов = Счета.СебестоимостьПродажНеЕНВД; // 90.02.1
								
							ИначеЕсли (СтрТЧ.СтатьяЗатрат.ВидДеятельностиДляНалоговогоУчетаЗатрат = ВД_ЕНВД) Тогда
								
								// ЕНВД
								Нстр.СчетДоходов = Счета.ВыручкаЕНВД; // 90.01.2
								Нстр.Субконто = СтрТЧ.Номенклатура.НоменклатурнаяГруппа; // номенклатураня группа
								Нстр.СчетРасходов = Счета.СебестоимостьПродажЕНВД; // 90.02.2
								
							Иначе
								
								// распределение - подумать
								
							КонецЕсли; 
							
							// --- 
						КонецЕсли;
						
						// Прочие доходы
						Если (стрТЧ.ПорядокОтражения = Перечисления.CW_ПорядокОтраженияДоходов.ПрочиеДоходы) Тогда
							
							Нстр = ВедомыйОбъект.Услуги.Добавить();
							// ---------------------------------------------------------------------------- 
							Нстр.Номенклатура = СтрТЧ.Номенклатура;
							Нстр.Содержание = СокрЛП(СтрТЧ.Представление);
							Нстр.Количество = СтрТЧ.Количество;
							// --- 
							
							Если ЦенаСНДС Тогда
								Нстр.Цена = СтрТЧ.Цена - СтрТЧ.НДС/?(СтрТЧ.Количество=0,1,СтрТЧ.Количество);
							Иначе
								Нстр.Цена = СтрТЧ.Цена;
							КонецЕсли;    

							Нстр.Сумма 		= СтрТЧ.Сумма;
							Нстр.СтавкаНДС 	= СтрТЧ.СтавкаНДС;
							Нстр.СуммаНДС 	= СтрТЧ.НДС;
							Нстр.СчетУчетаНДСПоРеализации = Счета.ПрочиеРасходы; // 91.02							
							// не ЕНВД
							Нстр.СчетДоходов 	= Счета.ПрочиеДоходы; // 91.01.1
							Нстр.Субконто		= СтрТЧ.ПрочиеДоходы; // ПрочиеДоходыИРасходы
							Нстр.СчетРасходов 	= Счета.ПрочиеРасходы; // 91.02.1
							
							// --- 
						КонецЕсли;
					
						// перевыставление
						Если (стрТЧ.ПорядокОтражения = Перечисления.CW_ПорядокОтраженияДоходов.Перевыставление 
							ИЛИ стрТЧ.ПорядокОтражения = Перечисления.CW_ПорядокОтраженияДоходов.ПеревыставлениеПоСтавкам) Тогда
							
							Нстр = ВедомыйОбъект.АгентскиеУслуги.Добавить();
							// ---------------------------------------------------------------------------- 
							Нстр.Номенклатура = СтрТЧ.Номенклатура;
							Нстр.Содержание = СокрЛП(СтрТЧ.Представление);
							Нстр.Количество = СтрТЧ.Количество;
							// --- 
							Если ДС.УП.СистемаНалогообложения=Перечисления.СистемыНалогообложения.Общая Тогда
								
								Нстр.Цена = СтрТЧ.Цена;
								Нстр.Сумма = СтрТЧ.Сумма;
								Нстр.СтавкаНДС = СтрТЧ.СтавкаНДС;
								Нстр.СуммаНДС = СтрТЧ.НДС;
								
							Иначе
								
								// УСН
								Нстр.Цена = СтрТЧ.Цена;
								Нстр.Сумма = СтрТЧ.Сумма;
								Нстр.СтавкаНДС = СтрТЧ.СтавкаНДС;
								Нстр.СуммаНДС = СтрТЧ.НДС;
								
							КонецЕсли; 
							// --- 
							
							Если (ЗначениеЗаполнено(СтрТЧ.ДокументРасходов)) Тогда
								
								Нстр.Контрагент = СтрТЧ.ДокументРасходов.Контрагент;
								
								АгентскийДоговорКонтрагента = СтрТЧ.ДокументРасходов.Договор.АгентскийДоговорНаПродажу;
								Если ВедетсяУчетПриложенийПоДоговорам 
									И ЗначениеЗаполнено(СтрТЧ.ДокументРасходов.ПриложениеКДоговору) Тогда
									АгентскийДоговорКонтрагента = СтрТЧ.ДокументРасходов.ПриложениеКДоговору.АгентскийДоговорНаПродажу;
								КонецЕсли;
								
								Если (НЕ ЗначениеЗаполнено(АгентскийДоговорКонтрагента)) Тогда
									
									СтруктураДоговора = Новый Структура;
									СтруктураДоговора.Вставить("Договор", 				СтрТЧ.ДокументРасходов.Договор); 
									СтруктураДоговора.Вставить("ПриложениеКДоговору", 	СтрТЧ.ДокументРасходов.ПриложениеКДоговору); 
									
									АгентскийДоговорКонтрагента = CW_Финансы.СоздатьАгентскийДоговор(СтруктураДоговора); 
								КонецЕсли; 
								Нстр.ДоговорКонтрагента = АгентскийДоговорКонтрагента;
								
							Иначе
								// это перевыставление по ставкам
								Нстр.Контрагент = Контрагент;
								
								АгентскийДоговорКонтрагента = ПараметрыБухгалтерскогоУчета.АгентскийДоговорНаПродажу;
								Если (НЕ ЗначениеЗаполнено(АгентскийДоговорКонтрагента)) Тогда
									
									СтруктураДоговора = Новый Структура;
									СтруктураДоговора.Вставить("Договор", 				Договор); 
									СтруктураДоговора.Вставить("ПриложениеКДоговору", 	ПриложениеКДоговору); 

									АгентскийДоговорКонтрагента = CW_Финансы.СоздатьАгентскийДоговор(СтруктураДоговора,Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком);
									ПараметрыБухгалтерскогоУчета.АгентскийДоговорНаПродажу = АгентскийДоговорКонтрагента;
								КонецЕсли;
								Нстр.ДоговорКонтрагента = АгентскийДоговорКонтрагента;
								
							КонецЕсли; 
							
							
							// --- 
							
							Если (АгентскийДоговорКонтрагента <> Неопределено) Тогда
								
								// определяем счёт расчётов
								ВалютныйДоговор = АгентскийДоговорКонтрагента.Валютный;
								ОплатаВВалюте = АгентскийДоговорКонтрагента.ОплатаВВалюте;
								// --- 
								Нстр.СчетРасчетов = ПолучитьСчетРасчетовДляАгентскогоДоговора(ВалютныйДоговор, стрТЧ.ПорядокОтражения, ОплатаВВалюте, Счета);
								
							КонецЕсли; 
							
						КонецЕсли; 
						
					КонецЦикла;
					// --- 
					_сф.ст_УстановитьСвойство(ВедомыйОбъект.ДополнительныеСвойства,"Постановление735",ДС.УП.ТребованияПостановления735);
					// --- 
					CW_Документы.ПеренестиПризнакВосстановленияПоследовательности(ЭтотОбъект,ВедомыйОбъект);
					
					// s.anton@coralway.ru 2018-05-29 19:02:34 НАЧАЛО...
					// чтобы документ нормально вставал на регистрацию в ЭДО, при том, что его несколько раз записывают и в нужный момент не выглядит новым (немодифицированным)
					ВедомыйОбъект.СуммаДокумента = 	  УчетНДСПереопределяемый.ПолучитьСуммуДокументаСНДС(ВедомыйОбъект, "Товары")
													+ УчетНДСПереопределяемый.ПолучитьСуммуДокументаСНДС(ВедомыйОбъект, "Услуги")
													+ УчетНДСПереопределяемый.ПолучитьСуммуДокументаСНДС(ВедомыйОбъект, "АгентскиеУслуги");
					
					CW_Подписки.ПодготовитьДокументОбъектДляЭДО(ВедомыйОбъект, Отказ, РежимЗаписи, РежимПроведенияДокумента.Неоперативный);
					// ... /s.anton@coralway.ru 2018-05-29 19:02:34 КОНЕЦ
					
					Отказ = CW_Документы.ПроверкаНомера(ВедомыйОбъект, РежимЗаписи, ЭтотОбъект.Ссылка,Ложь);
					Если Отказ Тогда 
						Возврат; 
					КонецЕсли;
					
				Иначе
					
					Если (НЕ ВедомыйДокумент.Пустая()) Тогда
						ПометитьНаУдаление(ВедомыйДокумент);	
					КонецЕсли; 
					
				КонецЕсли;
				
			Иначе
				
				Если (НЕ ВедомыйДокумент.Пустая()) Тогда
					
					ПометитьНаУдаление(ВедомыйДокумент);
					
				КонецЕсли; 
				
				Если (НЕ ВедомыйСчет.Пустая()) Тогда
					
					ПометитьНаУдаление(ВедомыйСчет);
					
				КонецЕсли; 
				
			КонецЕсли; 
			
		КонецЕсли; 
		
		Если (Корректировка) Тогда
			
			Если (ПровестиПоБухгалтерскомуУчету) Тогда
				
				//----
					Если (ФормируетсяСчет И ДС.УП.ФормироватьСчетаПокупателюНаОплату) Тогда
					
					ВедомыйОбъектСчет = ВедомыйСчетКорректировочный.ПолучитьОбъект();
					ВедомыйОбъектСчет.УстановитьПометкуУдаления(ПометкаУдаления);
					// --- 
					ВедомыйОбъектСчет.Организация = Организация;
					ВедомыйОбъектСчет.Контрагент = Контрагент;
					ВедомыйОбъектСчет.ДоговорКонтрагента = ПараметрыБухгалтерскогоУчета.УчетныйДоговор;
					ВедомыйОбъектСчет.ОрганизацияПолучатель = Организация;
					
					//Для версии КОРП
					Если ВестиУчетПоПодразделениям Тогда
						ВедомыйОбъектСчет.ПодразделениеОрганизации = ПодразделениеОрганизации;
					КонецЕсли;
					//Для версии КОРП
					
					// --- 
					РасчетныйСчет = ДС.ПД.РасчетныйСчетОрганизации;
					Если (НЕ ЗначениеЗаполнено(РасчетныйСчет)) Тогда
						ВедомыйОбъектСчет.СтруктурнаяЕдиница = Организация.ОсновнойБанковскийСчет;
					Иначе
						ВедомыйОбъектСчет.СтруктурнаяЕдиница = РасчетныйСчет;
					КонецЕсли;	
					// --- 
					ВедомыйОбъектСчет.СуммаВключаетНДС = ЦенаСНДС;
					ВедомыйОбъектСчет.ВалютаДокумента = Валюта;
					// --- 
					ВедомыйОбъектСчет.Ответственный = Ответственный;
					ВедомыйОбъектСчет.Комментарий = "Сформировано автоматически (CW) документом ""Доходы по грузоперевозке"" №"+Строка(Номер)+" от "+Формат(Дата,"ДФ=dd.MM.yyyy");
					// --- 
					ВедомыйОбъектСчет.Руководитель = Руководитель;
					Если (ВедомыйОбъектСчет.Метаданные().Реквизиты.Найти("ЗаРуководителяНаОсновании") <> Неопределено) Тогда
						ВедомыйОбъектСчет.ЗаРуководителяНаОсновании = ЗаРуководителяПоПриказу;
					Иначе
						ВедомыйОбъектСчет.ЗаРуководителяПоПриказу = ЗаРуководителяПоПриказу;
					КонецЕсли; 
					// --- 
					ВедомыйОбъектСчет.ГлавныйБухгалтер = ГлавныйБухгалтер;
					Если (ВедомыйОбъектСчет.Метаданные().Реквизиты.Найти("ЗаГлавногоБухгалтераНаОсновании") <> Неопределено) Тогда
						ВедомыйОбъектСчет.ЗаГлавногоБухгалтераНаОсновании = ЗаГлавногоБухгалтераПоПриказу;
					Иначе
						ВедомыйОбъектСчет.ЗаГлавногоБухгалтераПоПриказу = ЗаГлавногоБухгалтераПоПриказу;
					КонецЕсли;
					// --- 
					Если Валюта = ДС.КО.ВалютаРегламентированногоУчета Тогда
						ВедомыйОбъектСчет.КурсВзаиморасчетов = 1;
						ВедомыйОбъектСчет.КратностьВзаиморасчетов = 1;
					Иначе
						СК = РегистрыСведений.КурсыВалют.ПолучитьПоследнее(Дата, Новый Структура("Валюта", Валюта));
						ВедомыйОбъектСчет.КурсВзаиморасчетов = СК.Курс;
						ВедомыйОбъектСчет.КратностьВзаиморасчетов = СК.Кратность;
					КонецЕсли;
					// --- 
					ОсновноеПодразделение = Неопределено;
					// --- 
					ЕстьТовары = (Документы.СчетНаОплатуПокупателю.ПустаяСсылка().Метаданные().ТабличныеЧасти.Найти("Товары") <> Неопределено);
					Если (ЕстьТовары) Тогда
						
						ВедомыйОбъектСчет.Товары.Очистить();
						Для каждого СтрТЧ Из Услуги Цикл
							
							Если СтрТЧ.Количество <> СтрТЧ.Количество_ДоКорректировки или
								СтрТЧ.Цена <> СтрТЧ.Цена_ДоКорректировки или
								СтрТЧ.Сумма <> СтрТЧ.Сумма_ДоКорректировки или
								СтрТЧ.НДС <> СтрТЧ.НДС_ДоКорректировки Тогда
								
								Нстр = ВедомыйОбъектСчет.Товары.Добавить();
								// ---------------------------------------------------------------------------- 
								Нстр.Номенклатура 	= СтрТЧ.Номенклатура;
								Нстр.Содержание 	= СокрЛП(СтрТЧ.Представление);
								Нстр.Количество 	= СтрТЧ.Количество - СтрТЧ.Количество_ДоКорректировки;
								Нстр.Цена 			= СтрТЧ.Цена - СтрТЧ.Цена_ДоКорректировки;
								Нстр.Сумма 			= СтрТЧ.Сумма - СтрТЧ.Сумма_ДоКорректировки;
								Нстр.СуммаНДС 		= СтрТЧ.НДС - СтрТЧ.НДС_ДоКорректировки;   
								Нстр.СтавкаНДС 		= СтрТЧ.СтавкаНДС;     
								
								Если ЦенаСНДС Тогда
									Нстр.Сумма 		= Нстр.Сумма + Нстр.СуммаНДС;
								КонецЕсли;
								
							КонецЕсли;
							
						КонецЦикла; 
						
					Иначе
						
						ВедомыйОбъектСчет.Услуги.Очистить();
						Для каждого СтрТЧ Из Услуги Цикл
							Если СтрТЧ.Количество <> СтрТЧ.Количество_ДоКорректировки или
								СтрТЧ.Цена <> СтрТЧ.Цена_ДоКорректировки или
								СтрТЧ.Сумма <> СтрТЧ.Сумма_ДоКорректировки или
								СтрТЧ.НДС <> СтрТЧ.НДС_ДоКорректировки Тогда
								
								Нстр = ВедомыйОбъектСчет.Услуги.Добавить();
								// ---------------------------------------------------------------------------- 
								Нстр.Номенклатура = СтрТЧ.Номенклатура;
								Нстр.Содержание = СокрЛП(СтрТЧ.Представление);
								Нстр.Количество 	= СтрТЧ.Количество - СтрТЧ.Количество_ДоКорректировки;
								Нстр.Цена 			= СтрТЧ.Цена - СтрТЧ.Цена_ДоКорректировки;
								Нстр.Сумма 			= СтрТЧ.Сумма - СтрТЧ.Сумма_ДоКорректировки;
								Нстр.СуммаНДС 		= СтрТЧ.НДС - СтрТЧ.НДС_ДоКорректировки;
								Нстр.СтавкаНДС 		= СтрТЧ.СтавкаНДС;  
								
								Если ЦенаСНДС Тогда
									Нстр.Сумма 		= Нстр.Сумма + Нстр.СуммаНДС; 
								КонецЕсли;
								
								
							КонецЕсли;
							
						КонецЦикла; 
						
					КонецЕсли; 
						
					// --- 
					CW_Документы.ПеренестиПризнакВосстановленияПоследовательности(ЭтотОбъект,ВедомыйОбъектСчет);
					
					// пытаемся записать документ
					Отказ = CW_Документы.ПроверкаНомера(ВедомыйОбъектСчет, РежимЗаписиДокумента.Проведение, ЭтотОбъект.Ссылка,Ложь);
					Если Отказ Тогда 
						Возврат; 
					КонецЕсли;          
					
					ИспользоватьПланирование = ПолучитьФункциональнуюОпцию("ИспользоватьПланированиеПлатежейОтПокупателей");
					Если ИспользоватьПланирование Тогда
						ЗаписьРегистра = РегистрыСведений.CW_СрокиОплатыСчетов.СоздатьМенеджерЗаписи();
						ЗаписьРегистра.Счет = Ссылка;
						ЗаписьРегистра.Прочитать();   
						Если ЗаписьРегистра.Выбран() Тогда 
							СрокиОплатыДокументов.ЗаписатьСрокОплатыДокумента(ВедомыйСчетКорректировочный, ЗаписьРегистра.ДатаОплаты);
						КонецЕсли;
					КонецЕсли;
					
					// Если для целей оперативного учета задолженности документ проводится в режиме ввода остатков,
					// то принудительно пропишем статус ведомого счета (при проведении в обычном режиме статус не прописываем,
					// т.к. он будет определен типовой конфигурацией на момент записи документа)  
					
					СтруктураНастроек  = CW_Настройки.ПолучитьНастройкиОперативногоУчета(Организация,Перечисления.CW_ВидыОперативнойЗадолженности.Дебиторская, Дата); 
					
					Если СтруктураНастроек["ВедетсяОперативныйУчет"] Тогда
						РежимВводНачальныхОстатков = СтруктураНастроек["ВводОстатков"];
						Если РежимВводНачальныхОстатков Тогда
							
							// статус оплаты
							СтатусОплаты = Перечисления.СтатусОплатыСчета.НеОплачен;
							Если СальдоВзаиморасчетовОЗ <= 0 Тогда
								СтатусОплаты = Перечисления.СтатусОплатыСчета.Оплачен;
							Иначе
								Если СальдоВзаиморасчетовОЗ < Услуги.Итог("Всего") Тогда
									СтатусОплаты = Перечисления.СтатусОплатыСчета.ОплаченЧастично;
								КонецЕсли; 
							КонецЕсли; 
							
							// статус отгрузки
							СтатусОтгрузки = ?(ФормируетсяАкт,Перечисления.СтатусыОтгрузки.Отгружен,Перечисления.СтатусыОтгрузки.НеОтгружен);
							
							МассивДокументов = Новый Массив;
							МассивДокументов.Добавить(ВедомыйОбъектСчет.Ссылка);
							
							// пишем в регистр
							СтатусыДокумента = РегистрыСведений.СтатусыДокументов.НовыеСтатусыДокумента();
							СтатусыДокумента.Статус            		= СтатусОплаты;
							СтатусыДокумента.ДополнительныйСтатус	= СтатусОтгрузки;
							РегистрыСведений.СтатусыДокументов.УстановитьСтатусыДокументов(МассивДокументов,СтатусыДокумента);
						КонецЕсли; // это режим ввода остатков 
					КонецЕсли; // по организации ведется учет оперативной задолженности
					
				// если счет формировать не нужно, а ссылка на документ есть, 
				// то помечаем его на удаление
				Иначе
					Если (НЕ ВедомыйСчет.Пустая()) Тогда
						ПометитьНаУдаление(ВедомыйСчет);
					КонецЕсли; 
				КонецЕсли; // проверка на необходимость формирования счета покупателю				
				
				//----
				
				Если (ФормируетсяАкт) Тогда
					
					ВедомыйОбъект = ВедомыйДокументКорректировки.ПолучитьОбъект();
					
					_сф.ст_УстановитьСвойство(ВедомыйОбъект.ДополнительныеСвойства,"ВедущийДокумент",Ссылка);
					_сф.ст_УстановитьСвойство(ВедомыйОбъект.ДополнительныеСвойства,"ЗависимоеПроведение",Истина);
					
					//ВедомыйОбъект = Документы.ПоступлениеТоваровУслуг.СоздатьДокумент(); // тмп
					ВедомыйОбъект.УстановитьПометкуУдаления(ПометкаУдаления);
					ВедомыйОбъект.Организация = Организация;
					
					//Для версии КОРП
					Если ВестиУчетПоПодразделениям Тогда
						ВедомыйОбъект.ПодразделениеОрганизации = ПодразделениеОрганизации;
					КонецЕсли;
					//Для версии КОРП
					
					ВедомыйОбъект.Контрагент 			= Контрагент;
					ВедомыйОбъект.ДоговорКонтрагента 	= ПараметрыБухгалтерскогоУчета.УчетныйДоговор;
					ВедомыйОбъект.ВалютаДокумента 		= Валюта;
		
					ВедомыйОбъект.Дата =  ?(ДатаАкта= Дата(1,1,1), Дата, ДатаАкта);
;
					ВедомыйОбъект.ВидОперации = ВидОперацииКорректировки;
					
					ВедомыйОбъект.ОтчетностьПодписана 	= Год(ЭтотОбъект.ДатаАкта) > Год(КорректируемыйДокумент.ДатаАкта);
					
					ВедомыйОбъект.КорректироватьБУиНУ 	= Истина;
					ВедомыйОбъект.КорректироватьНДС 	= Истина;
					
					ВедомыйОбъект.ДокументРеализации 			= ?(КорректируемыйДокумент.Корректировка,КорректируемыйДокумент.ВедомыйДокументКорректировки,КорректируемыйДокумент.ВедомыйДокумент); // или исправляемый ?
					ВедомыйОбъект.СтатьяПрочихДоходовИРасходов 	= ДС.УП.СтатьяПрочихДоходовИРасходовДляКорректировок;
					ВедомыйОбъект.НомерИсходногоДокумента 		= КорректируемыйДокумент.НомерАкта;
					ВедомыйОбъект.ДатаИсходногоДокумента 		= КорректируемыйДокумент.ДатаАкта;
					
					Если ВидОперацииКорректировки = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсправленияПоступленияРеализации.ИсправлениеОшибки") Тогда
						ВедомыйОбъект.НомерИсправления 	= НомерИсправления; 
					КонецЕсли;
					
					ВедомыйОбъект.Услуги.Очистить();
					ВедомыйОбъект.АгентскиеУслуги.Очистить();
					
					ИндексСтрокиСобственных = 0;
					ИндексСтрокиАгентских 	= 0;
					
					Если КорректируемыйДокумент.Корректировка Тогда
						ТаблицаУслугСобственных = КорректируемыйДокумент.ВедомыйДокументКорректировки.Услуги.Выгрузить();
						ТаблицаУслугАгентских 	= КорректируемыйДокумент.ВедомыйДокументКорректировки.АгентскиеУслуги.Выгрузить();
					Иначе
						ТаблицаУслугСобственных = КорректируемыйДокумент.ВедомыйДокумент.Услуги.Выгрузить();
						ТаблицаУслугАгентских 	= КорректируемыйДокумент.ВедомыйДокумент.АгентскиеУслуги.Выгрузить();
					КонецЕсли;
					
					МаксИндексСтрокиСобственных = ТаблицаУслугСобственных.Количество()-1;
					МаксИндексСтрокиАгентских 	= ТаблицаУслугАгентских.Количество()-1;
					
					ОсновнаяСистемаНалогообложения 	= Перечисления.ВидыДеятельностиДляНалоговогоУчетаЗатрат["ОсновнаяСистемаНалогообложения"];
					ОсобыйПорядокНалогообложения	= Перечисления.ВидыДеятельностиДляНалоговогоУчетаЗатрат["ОсобыйПорядокНалогообложения"];  
					
					ЗаполнитьПередКорректировкой = CW_Документы.НужноПоказатьПередКорректировкой(ЭтотОбъект);
					
					// --- 
					Для каждого Стр Из Услуги Цикл
						
						Если (Стр.ПорядокОтражения = Перечисления.CW_ПорядокОтраженияДоходов.СобственнаяУслуга) Тогда
							
							Нстр = ВедомыйОбъект.Услуги.Добавить();
							// --- 
							Нстр.ЕстьВДокументеРеализации = Не Стр.ЭтоДобавленнаяСтрока;
							Нстр.Номенклатура = Стр.Номенклатура;
							// --- 
							Нстр.СодержаниеДоИзменения = СокрЛП(Стр.Представление_ДоКорректировки);
							Нстр.Содержание = СокрЛП(Стр.Представление);
							// --- 
							Нстр.КоличествоДоИзменения = Стр.Количество_ДоКорректировки;
							Нстр.Количество = Стр.Количество;
							// --- 
							Нстр.ЦенаДоИзменения = Стр.Цена_ДоКорректировки;
							Нстр.Цена = Стр.Цена;
							// --- 
							Нстр.СуммаДоИзменения = Стр.Сумма_ДоКорректировки;
							Нстр.Сумма = Стр.Сумма;
							// --- 
							Нстр.СтавкаНДСДоИзменения = Стр.СтавкаНДС_ДоКорректировки;
							Нстр.СтавкаНДС = Стр.СтавкаНДС;
							// --- 
							Нстр.СуммаНДСДоИзменения = Стр.НДС_ДоКорректировки;
							Нстр.СуммаНДС = Стр.НДС;  
							
							Если ЗаполнитьПередКорректировкой Тогда
								Нстр.КоличествоДоКорректировки 	= Стр.Количество_ПередКорректировкой;
								Нстр.ЦенаДоКорректировки 		= Стр.Цена_ПередКорректировкой;
								Нстр.СуммаДоКорректировки 		= Стр.Сумма_ПередКорректировкой;
								Нстр.СуммаНДСДоКорректировки 	= Стр.НДС_ПередКорректировкой;
							КонецЕсли;
							
							Если ИндексСтрокиСобственных <= МаксИндексСтрокиСобственных Тогда
								
								// остальные реквизиты берём из соответствующей строки ведомого корректируемого документа
								СтрокаДокументаПоступления = ТаблицаУслугСобственных[ИндексСтрокиСобственных];
								_сф.Инкремент(ИндексСтрокиСобственных);
								// --- 
								ЗаполнитьЗначенияСвойств(Нстр,СтрокаДокументаПоступления,"Субконто,СчетДоходов,СчетРасходов,СчетУчетаНДСПоРеализации");
								
							Иначе
								Нстр.СчетУчетаНДСПоРеализации = Счета.Продажи_НДС; // 90.03
								// определяем счета реализации по ЕНВД/неЕНВД
								Если (Стр.СтатьяЗатрат.ВидДеятельностиДляНалоговогоУчетаЗатрат = ОсновнаяСистемаНалогообложения) Тогда
									
									// не ЕНВД
									Нстр.СчетДоходов 	= Счета.ВыручкаНеЕНВД; // 90.01.1
									Нстр.Субконто 		= Стр.Номенклатура.НоменклатурнаяГруппа; // номенклатураня группа
									Нстр.СчетРасходов 	= Счета.СебестоимостьПродажНеЕНВД; // 90.02.1
									
								ИначеЕсли (СтрТЧ.СтатьяЗатрат.ВидДеятельностиДляНалоговогоУчетаЗатрат = ОсобыйПорядокНалогообложения) Тогда
									
									// ЕНВД
									Нстр.СчетДоходов 	= Счета.ВыручкаЕНВД; // 90.01.2
									Нстр.Субконто 		= Стр.Номенклатура.НоменклатурнаяГруппа; // номенклатураня группа
									Нстр.СчетРасходов 	= Счета.СебестоимостьПродажЕНВД; // 90.02.2
									
								КонецЕсли;
								
							КонецЕсли;
							
						ИначеЕсли (Стр.ПорядокОтражения = Перечисления.CW_ПорядокОтраженияДоходов.ПрочиеДоходы) Тогда
							
							Нстр = ВедомыйОбъект.Услуги.Добавить();
							// --- 
							Нстр.ЕстьВДокументеРеализации = Не Стр.ЭтоДобавленнаяСтрока;
							Нстр.Номенклатура = Стр.Номенклатура;
							// --- 
							Нстр.СодержаниеДоИзменения = СокрЛП(Стр.Представление_ДоКорректировки);
							Нстр.Содержание = СокрЛП(Стр.Представление);
							// --- 
							Нстр.КоличествоДоИзменения = Стр.Количество_ДоКорректировки;
							Нстр.Количество = Стр.Количество;
							// --- 
							Нстр.ЦенаДоИзменения = Стр.Цена_ДоКорректировки;
							Нстр.Цена = Стр.Цена;
							// --- 
							Нстр.СуммаДоИзменения = Стр.Сумма_ДоКорректировки;
							Нстр.Сумма = Стр.Сумма;
							// --- 
							Нстр.СтавкаНДСДоИзменения = Стр.СтавкаНДС_ДоКорректировки;
							Нстр.СтавкаНДС = Стр.СтавкаНДС;
							// --- 
							Нстр.СуммаНДСДоИзменения = Стр.НДС_ДоКорректировки;
							Нстр.СуммаНДС = Стр.НДС;
							
							Если ЗаполнитьПередКорректировкой Тогда
								Нстр.КоличествоДоКорректировки 	= Стр.Количество_ПередКорректировкой;
								Нстр.ЦенаДоКорректировки 		= Стр.Цена_ПередКорректировкой;
								Нстр.СуммаДоКорректировки 		= Стр.Сумма_ПередКорректировкой;
								Нстр.СуммаНДСДоКорректировки 	= Стр.НДС_ПередКорректировкой;
							КонецЕсли;
							
							Если ИндексСтрокиСобственных <= МаксИндексСтрокиСобственных Тогда
								
								// остальные реквизиты берём из соответствующей строки ведомого корректируемого документа
								СтрокаДокументаПоступления = ТаблицаУслугСобственных[ИндексСтрокиСобственных];
								_сф.Инкремент(ИндексСтрокиСобственных);
								// --- 
								ЗаполнитьЗначенияСвойств(Нстр,СтрокаДокументаПоступления,"Субконто,СчетДоходов,СчетРасходов,СчетУчетаНДСПоРеализации");
								
							Иначе
								Нстр.СчетУчетаНДСПоРеализации = Счета.ПрочиеРасходы; // 91.02
								
								Нстр.СчетДоходов 	= Счета.ПрочиеДоходы; // 90.01.1
								Нстр.Субконто 		= Стр.ПрочиеДоходы; // номенклатураня группа
								Нстр.СчетРасходов 	= Счета.ПрочиеРасходы; // 90.02.1
								
							КонецЕсли;
							
						Иначе
							
							Нстр = ВедомыйОбъект.АгентскиеУслуги.Добавить();
							// --- 
							Нстр.ЕстьВДокументеРеализации = Не Стр.ЭтоДобавленнаяСтрока;
							Нстр.Номенклатура = Стр.Номенклатура;
							// --- 
							Нстр.СодержаниеДоИзменения = СокрЛП(Стр.Представление_ДоКорректировки);
							Нстр.Содержание = СокрЛП(Стр.Представление);
							// --- 
							Нстр.КоличествоДоИзменения = Стр.Количество_ДоКорректировки;
							Нстр.Количество = Стр.Количество;
							// --- 
							Нстр.ЦенаДоИзменения = Стр.Цена_ДоКорректировки;
							Нстр.Цена = Стр.Цена;
							// --- 
							Нстр.СуммаДоИзменения = Стр.Сумма_ДоКорректировки;
							Нстр.Сумма = Стр.Сумма;
							// --- 
							Нстр.СтавкаНДСДоИзменения = Стр.СтавкаНДС_ДоКорректировки;
							Нстр.СтавкаНДС = Стр.СтавкаНДС;
							// --- 
							Нстр.СуммаНДСДоИзменения = Стр.НДС_ДоКорректировки;
							Нстр.СуммаНДС = Стр.НДС;  
							
							Если ЗаполнитьПередКорректировкой Тогда
								Нстр.КоличествоДоКорректировки 	= Стр.Количество_ПередКорректировкой;
								Нстр.ЦенаДоКорректировки 		= Стр.Цена_ПередКорректировкой;
								Нстр.СуммаДоКорректировки 		= Стр.Сумма_ПередКорректировкой;
								Нстр.СуммаНДСДоКорректировки 	= Стр.НДС_ПередКорректировкой;
							КонецЕсли;
							
							Если ИндексСтрокиАгентских <= МаксИндексСтрокиАгентских Тогда
								
								СтрокаДокументаПоступления = ТаблицаУслугАгентских[ИндексСтрокиАгентских];
								_сф.Инкремент(ИндексСтрокиАгентских);
								// --- 
								ЗаполнитьЗначенияСвойств(Нстр,СтрокаДокументаПоступления,"СчетРасчетов,Контрагент,ДоговорКонтрагента");
								
							Иначе
								Если (ЗначениеЗаполнено(Стр.ДокументРасходов)) Тогда
									
									Нстр.Контрагент = Стр.ДокументРасходов.Контрагент;
									
									АгентскийДоговорКонтрагента = Стр.ДокументРасходов.Договор.АгентскийДоговорНаПродажу;
									Если ВедетсяУчетПриложенийПоДоговорам 
										И ЗначениеЗаполнено(Стр.ДокументРасходов.ПриложениеКДоговору) Тогда
										АгентскийДоговорКонтрагента = Стр.ДокументРасходов.ПриложениеКДоговору.АгентскийДоговорНаПродажу;
									КонецЕсли;
									
									Если НЕ ЗначениеЗаполнено(АгентскийДоговорКонтрагента) Тогда
										
										СтруктураДоговора = Новый Структура;
										СтруктураДоговора.Вставить("Договор", 				Стр.ДокументРасходов.Договор); 
										СтруктураДоговора.Вставить("ПриложениеКДоговору", 	Стр.ДокументРасходов.ПриложениеКДоговору); 
										
										АгентскийДоговорКонтрагента = CW_Финансы.СоздатьАгентскийДоговор(СтруктураДоговора); 
									КонецЕсли; 
									Нстр.ДоговорКонтрагента = АгентскийДоговорКонтрагента;
									
								Иначе
									// это перевыставление по ставкам
									Нстр.Контрагент = Контрагент;
									
									АгентскийДоговорКонтрагента = ПараметрыБухгалтерскогоУчета.АгентскийДоговорНаПродажу;
									Если НЕ ЗначениеЗаполнено(АгентскийДоговорКонтрагента) Тогда
										
										СтруктураДоговора = Новый Структура;
										СтруктураДоговора.Вставить("Договор", 				Договор); 
										СтруктураДоговора.Вставить("ПриложениеКДоговору", 	ПриложениеКДоговору); 
										
										АгентскийДоговорКонтрагента = CW_Финансы.СоздатьАгентскийДоговор(СтруктураДоговора,Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком); 
										ПараметрыБухгалтерскогоУчета.АгентскийДоговорНаПродажу = АгентскийДоговорКонтрагента;
									КонецЕсли;
									Нстр.ДоговорКонтрагента = АгентскийДоговорКонтрагента;
									
								КонецЕсли; 
								
								Если (АгентскийДоговорКонтрагента <> Неопределено) Тогда
									
									// определяем счёт расчётов
									ВалютныйДоговор = АгентскийДоговорКонтрагента.Валютный;
									ОплатаВВалюте = АгентскийДоговорКонтрагента.ОплатаВВалюте;
									// --- 
									Нстр.СчетРасчетов = ПолучитьСчетРасчетовДляАгентскогоДоговора(ВалютныйДоговор, Стр.ПорядокОтражения, ОплатаВВалюте, Счета);
									
								КонецЕсли; 
								
							КонецЕсли;
							
						КонецЕсли; 
						
					КонецЦикла; 
					
					// --- 
					ВедомыйОбъект.ОбменДанными.Загрузка = Ложь;
					// --- 
					CW_Документы.ПеренестиПризнакВосстановленияПоследовательности(ЭтотОбъект,ВедомыйОбъект);
					// --- 
					ВедомыйОбъект.Комментарий = "Сформировано автоматически (CW) документом ""Доходы по грузоперевозке"" №"+Строка(Номер)+" от "+Формат(Дата,"ДФ=dd.MM.yyyy");

					ВедомыйОбъект.Записать(РежимЗаписи);
					
					
				КонецЕсли; 
								
			Иначе
				
				Если (НЕ ВедомыйДокументКорректировки.Пустая()) Тогда
					
					ПометитьНаУдаление(ВедомыйДокументКорректировки);
					
				КонецЕсли;
				
			КонецЕсли; 
			
		КонецЕсли; 
		
	КонецЕсли; 
		
КонецПроцедуры

Функция ПолучитьСчетРасчетовДляАгентскогоДоговора(ВалютныйДоговор, ПорядокОтражения, ОплатаВВалюте, Счета)
	
	Если (ПорядокОтражения = Перечисления.CW_ПорядокОтраженияДоходов.Перевыставление) Тогда
		
		Если НЕ ВалютныйДоговор Тогда
			СчетРасчетов = Счета.РасчетыСПрочимиПоставщикамиИПодрядчиками; // 76.05
		Иначе
			Если (ОплатаВВалюте) Тогда
				СчетРасчетов = Счета.РасчетыСПрочимиПоставщикамиИПодрядчикамиВал; // 76.25
			Иначе
				СчетРасчетов = Счета.РасчетыСПрочимиПоставщикамиИПодрядчикамиУЕ; // 76.35
			КонецЕсли; 
		КонецЕсли; 
		
	Иначе 
		
		Если НЕ ВалютныйДоговор Тогда
			СчетРасчетов = Счета.РасчетыСПрочимиПокупателямиИЗаказчиками; // 76.06
		Иначе
			Если (ОплатаВВалюте) Тогда
				СчетРасчетов = Счета.РасчетыСПрочимиПокупателямиИЗаказчикамиВал; // 76.26
			Иначе
				СчетРасчетов = Счета.РасчетыСПрочимиПокупателямиИЗаказчикамиУЕ; // 76.36
			КонецЕсли; 
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат СчетРасчетов;
	
КонецФункции

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	
	// контроль загрузки
	Если ОбменДанными.Загрузка Тогда 
		Возврат; 
	КонецЕсли;
	Если РучнаяКорректировка Тогда 
		Возврат; 
	КонецЕсли; 
	
	// не перепроводим при восстановлении последовательности
	ВосстановлениеПоследовательности = _сф.ст_ПолучитьСвойство(ДополнительныеСвойства,"ПроведенВХронологическойПоследовательности");
	Если (ВосстановлениеПоследовательности <> Неопределено) Тогда
		Если (ВосстановлениеПоследовательности) Тогда
			Возврат;
		КонецЕсли; 
	КонецЕсли; 
	
	// контроль наличия общих параметров
	CW_БухгалтерияЭкспедитораСервер.УстановитьОбщиеПараметрыПроведенияДокументов();

	Если НЕ ЗаполненыОбщиеПараметры() Тогда 
		СформироватьОбщиеПараметры(,Ложь); 
	КонецЕсли;   
	
	//Подситема.СтатусыДокументов
	ИспользуютсяСтатусыДокументов = ПолучитьФункциональнуюОпцию("CW_ИспользуютсяСтатусыДокументов");
	Если ИспользуютсяСтатусыДокументов И
		Не ЭтотОбъект.ДополнительныеСвойства.Свойство("СтатусДокумента") Тогда
		//В случае если используются статусы документа и проведение не из формы, тов ДС статуса нет
		ДанныеСтатуса = РегистрыСведений.CW_СтатусыДокументов.ПолучитьДанныеСтатусаДокумента(Ссылка);
		ЭтотОбъект.ДополнительныеСвойства.Вставить("СтатусДокумента", ДанныеСтатуса.СтатусДокумента);
	КонецЕсли;
	
	СтатусДокумента = Неопределено;
	ЭтотОбъект.ДополнительныеСвойства.Свойство("СтатусДокумента", СтатусДокумента);
	
	СтатусДокументаПроводитьПоБухгалтерскомуУчету = CW_СтатусыДокументовСервер.ПолучитьПризнакПроведенияПоБухгалтерскомуУчету(Ссылка, СтатусДокумента);
	//Подситема.СтатусыДокументов
	
	ВедетсяУчетПриложенийПоДоговорам = ПолучитьФункциональнуюОпцию("CW_ВедетсяУчетПриложенийПоДоговорам");
	
	СтруктураПараметровБухУчета = Новый Структура;
	СтруктураПараметровБухУчета.Вставить("Договор", 				Договор);
	СтруктураПараметровБухУчета.Вставить("ПриложениеКДоговору",		ПриложениеКДоговору);
	СтруктураПараметровБухУчета.Вставить("ВедетсяУчетПриложений",	ВедетсяУчетПриложенийПоДоговорам);
	
	ПараметрыБухгалтерскогоУчета = CW_Финансы.ПолучитьПарметрыВеденияБухгалтерскогоУчета(СтруктураПараметровБухУчета, Дата);
	
	ПровестиПоБухгалтерскомуУчету = СтатусДокументаПроводитьПоБухгалтерскомуУчету и ПараметрыБухгалтерскогоУчета.БухгалтерскийУчет;    
	
	// вызываем функцию формирования движений для счетов
	Если (Не ФормируетсяАкт ИЛИ НЕ ПровестиПоБухгалтерскомуУчету) Тогда
		
		Если (НЕ Корректировка) Тогда
			CW_Подписки.СформироватьДвиженияДляДоходов(Ссылка,Отказ,ДополнительныеСвойства);
		Иначе
			CW_Подписки.СформироватьДвиженияДляКорректировкиДоходов(Ссылка,Отказ,ДополнительныеСвойства);
		КонецЕсли; 
		
	КонецЕсли; 

	
КонецПроцедуры 

Функция ПроверятьНаличиеВТабличнойЧастиДокументаУслугСПорядкомОтраженияПеревыставление()
	
	
	
	
	
КонецФункции

Процедура ПроверитьСтатусВедомых()
	// --- 
	
	Если (НЕ Корректировка) Тогда
		
		Если (НЕ ВедомыйДокумент.Пустая()) Тогда
			
			Если (ФормируетсяАкт) Тогда
				СинхронизироватьПометкуУдаления(ВедомыйДокумент);
			Иначе
				ПометитьНаУдаление(ВедомыйДокумент);
			КонецЕсли; 
			
		КонецЕсли; 
		
		Если (НЕ ВедомыйСчет.Пустая()) Тогда
			
			Если (ФормируетсяСчет) Тогда
				СинхронизироватьПометкуУдаления(ВедомыйСчет);
			Иначе
				ПометитьНаУдаление(ВедомыйСчет);
			КонецЕсли; 
			
		КонецЕсли;  
		
		
		
	КонецЕсли; 
	
	Если (Корректировка) Тогда
		
		Если (НЕ ВедомыйДокументКорректировки.Пустая()) Тогда
			
			Если (ФормируетсяАкт) Тогда
				СинхронизироватьПометкуУдаления(ВедомыйДокументКорректировки);
			Иначе
				ПометитьНаУдаление(ВедомыйДокументКорректировки);
			КонецЕсли; 
			
		КонецЕсли; 
		
	КонецЕсли; 
	
	// --- 
КонецПроцедуры

Процедура СинхронизироватьПометкуУдаления(Документ)
	// --- 
	
	Если (Документ.ПометкаУдаления <> ПометкаУдаления) Тогда
		
		ВедомыйОбъект = Документ.ПолучитьОбъект();
		_сф.ст_УстановитьСвойство(ВедомыйОбъект.ДополнительныеСвойства,"ВедущийДокумент",Ссылка);
		ВедомыйОбъект.УстановитьПометкуУдаления(ПометкаУдаления);
		
	КонецЕсли;
	
	// --- 
КонецПроцедуры

Процедура ПометитьНаУдаление(Документ)
	// --- 
	
	Если (ВедомыйДокумент.ПометкаУдаления <> Истина) Тогда
		
		ВедомыйОбъект = Документ.ПолучитьОбъект();
		_сф.ст_УстановитьСвойство(ВедомыйОбъект.ДополнительныеСвойства,"ВедущийДокумент",Ссылка);
		ВедомыйОбъект.УстановитьПометкуУдаления(Истина);
		
	КонецЕсли; 
	
	// --- 
КонецПроцедуры

Процедура СформироватьОбщиеПараметры(Знач СписокПараметров=Неопределено,ИнтерактивныйРежим = Истина) Экспорт 
	
	// получаем параметры договора и константы, помещаем в доп. свойства
	CW_ОбщиеПараметры.СформироватьОбщиеПараметры(ЭтотОбъект,СписокПараметров,ИнтерактивныйРежим);
	ДС = ДополнительныеСвойства;
	
КонецПроцедуры

