								НомерСчетаФактуры = Номер;
								НовыйСФ.Номер = НомерСчетаФактуры;
								
							ИначеЕсли (ПолитикаНумерации = Перечисления.CW_ПорядокПрисвоенияИсходящихНомеров.НезависимаяНумерация) Тогда 
								
								НовыйСФ.УстановитьНовыйНомер();
								НомерСчетаФактуры = НовыйСФ.Номер;
								
								// внешний нумератор
							ИначеЕсли (ПолитикаНумерации = Перечисления.CW_ПорядокПрисвоенияИсходящихНомеров.ВнешнийНумератор) Тогда
								
								ОбработкаНумерации.УстановитьНомерСчетаФактуры(ЭтотОбъект, НовыйСФ);
								
							КонецЕсли; 
						КонецЕсли;  // присвоение номера счета-фактуры
						
						// если не удается записать документ с таким номером, то возвращаемся с ошибкой
						CW_Документы.ПеренестиПризнакВосстановленияПоследовательности(ЭтотОбъект,НовыйСФ);
						Отказ = CW_Документы.ПроверкаНомера(НовыйСФ, РежимЗаписиДокумента.Запись, ЭтотОбъект,Ложь);
