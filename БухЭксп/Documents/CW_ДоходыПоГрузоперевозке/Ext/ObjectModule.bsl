#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

Перем ДС Экспорт;

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	Ответственный = Неопределено;
	CW_Документы.ЗаполнениеДокументов(ЭтотОбъект);
	
	// чистим ссылки на ведомые документы
	ВедомыйДокумент 	= Документы.РеализацияТоваровУслуг.ПустаяСсылка();
	ВедомыйСчет 		= Документы.СчетНаОплатуПокупателю.ПустаяСсылка();
	ВедомыйСчетФактура 	= Документы.СчетФактураВыданный.ПустаяСсылка();
	
	// ввод на основании грузоперевозки
	Если ТипЗнч(ДанныеЗаполнения) = Тип("СправочникСсылка.CW_Грузоперевозки") Тогда
		СтруктураПараметров = Новый Структура;
		СтруктураПараметров.Вставить("Объект"				, ДанныеЗаполнения.Ссылка);
		СтруктураПараметров.Вставить("ЭтоВариантБюджета"	, Ложь);
		СтруктураПараметров.Вставить("Контрагент"			, ДанныеЗаполнения.Ссылка.Клиент);
		
		Контрагент = CW_Финансы.ВернутьПлательщика(СтруктураПараметров);
		ДанныеЗаполнения = Неопределено;
	КонецЕсли; 
	
	// состав пакета
	НастройкиПользователя = CW_Настройки.ПолучитьНастройкиПользователя();
	Если НастройкиПользователя = Неопределено Тогда
		НастройкиПользователя = Новый Структура("Доходы_ФормироватьСчет,Доходы_ФормироватьАкт,Доходы_ФормироватьСчетФактуру",Ложь,Ложь,Ложь);
	КонецЕсли;  
	
	Если CW_ПраваДоступа.ПравоДоступно("РедактированиеФинансов_Доходы_Счета") Тогда
		ФормируетсяСчет	=	НастройкиПользователя.Доходы_ФормироватьСчет;
	КонецЕсли;   
	
	Если CW_ПраваДоступа.ПравоДоступно("РедактированиеФинансов_Доходы_Акты") Тогда
		ФормируетсяАкт			= НастройкиПользователя.Доходы_ФормироватьАкт;
		ФормируетсяСчетФактура	= НастройкиПользователя.Доходы_ФормироватьСчетФактуру;
	КонецЕсли; 
	// состав пакета
	
	
	Если ДанныеЗаполнения = Неопределено Тогда 
		// вид операции
		ВидОперации = Перечисления.CW_ВидыОперацийДоходыПоГрузоперевозке.ОказаниеУслуг;
		// порядок зачета оперативных авансов
		СпособЗачетаАвансовОЗ = Перечисления.СпособыЗачетаАвансов.НеЗачитывать;
		Возврат;
	КонецЕсли;
	
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("Структура") Тогда
		
		Если ДанныеЗаполнения.Свойство("КорректируемыйДокумент") Тогда
			
			Корректировка 			= Истина;
			КорректируемыйДокумент 	= ДанныеЗаполнения.КорректируемыйДокумент;
			
			//Исправления
			ВидОперацииКорректировки = КорректируемыйДокумент.ВидОперацииКорректировки;
			Если НЕ ЗначениеЗаполнено(ВидОперацииКорректировки) Тогда
				ВидОперацииКорректировки = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсправленияПоступленияРеализации.СогласованноеИзменение");
			Конецесли;
			
			Если ВидОперацииКорректировки = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсправленияПоступленияРеализации.ИсправлениеОшибки") Тогда
				НомерСчетаФактуры	= КорректируемыйДокумент.НомерСчетаФактуры;
				ДатаСчетаФактуры	= КорректируемыйДокумент.ДатаСчетаФактуры;
				НомерИсправления 	= КорректируемыйДокумент.НомерИсправления + 1;
			конецЕсли;
			//Исправления
			
			ЗаполнитьЗначенияСвойств(ЭтотОбъект,КорректируемыйДокумент,"Организация,Контрагент,Договор,ПриложениеКДоговору,Валюта,ФормируетсяСчет,ФормируетсяАкт,ФормируетсяСчетФактура,ЦенаСНДС");
			
			СопроводительныеДокументы = КорректируемыйДокумент.СопроводительныеДокументы;
			СведенияОТранспортировкеИГрузе = КорректируемыйДокумент.СведенияОТранспортировкеИГрузе;
			
			тДокументыРасходов = КорректируемыйДокумент.Услуги.Выгрузить().Скопировать(,"ПорядокОтражения,ДокументРасходов");   
			тДокументыРасходов.Свернуть("ПорядокОтражения,ДокументРасходов",); 
			
			Отбор = Новый Структура;
			Отбор.Вставить("ПорядокОтражения", Перечисления.CW_ПорядокОтраженияДоходов.Перевыставление);
			
			мСтроки = тДокументыРасходов.НайтиСтроки(Отбор);
			
			мДокументыРасходов = Новый Массив;
			Для Каждого НайденнаяСтрока из мСтроки Цикл
				мДокументыРасходов.Добавить(НайденнаяСтрока.ДокументРасходов);	
			КонецЦикла;
			
			Запрос = Новый Запрос;
			Запрос.Текст = "ВЫБРАТЬ
			               |	CW_РасходыПоГрузоперевозке.КорректируемыйДокумент КАК КорректируемыйДокумент,
			               |	CW_РасходыПоГрузоперевозке.Ссылка КАК Ссылка
			               |ИЗ
			               |	Документ.CW_РасходыПоГрузоперевозке КАК CW_РасходыПоГрузоперевозке
			               |ГДЕ
			               |	CW_РасходыПоГрузоперевозке.КорректируемыйДокумент В(&КорректируемыйДокумент)";
			
			Запрос.УстановитьПараметр("КорректируемыйДокумент", мДокументыРасходов); 
			
			РезультатЗапроса = Запрос.Выполнить();
			
			СоответствиеДокументов = новый Соответствие;
			Выборка = РезультатЗапроса.Выбрать();
			Пока Выборка.Следующий() Цикл
				СоответствиеДокументов.Вставить(Выборка.КорректируемыйДокумент, Выборка.Ссылка);
			КонецЦикла; 
			
			//AFR23-3305  от 01.02.2023    
			ИсключаяСвойства = "";
			Если ДанныеЗаполнения.КорректируемыйДокумент.ФормируетсяАкт Тогда
				СписокСчетов = Ложь; 
				ИсключаяСвойства = "Счет";
			КонецЕсли;
			//AFR23-3305  от 01.02.2023
			
			Для каждого КорректируемаяСтрока Из КорректируемыйДокумент.Услуги Цикл 
				
				НоваяСтрока = Услуги.Добавить();
				
				ЗаполнитьЗначенияСвойств(НоваяСтрока, КорректируемаяСтрока,,ИсключаяСвойства); //Свойство счет исключено из заполнения по заявке: AFR23-3305  от 01.02.2023
				
				НоваяСтрока.Представление_ДоКорректировки 	= КорректируемаяСтрока.Представление;
				НоваяСтрока.Количество_ДоКорректировки 		= КорректируемаяСтрока.Количество;
				НоваяСтрока.Цена_ДоКорректировки 			= КорректируемаяСтрока.Цена;
				НоваяСтрока.Сумма_ДоКорректировки 			= КорректируемаяСтрока.Сумма;
				НоваяСтрока.СтавкаНДС_ДоКорректировки 		= КорректируемаяСтрока.СтавкаНДС;
				НоваяСтрока.НДС_ДоКорректировки 			= КорректируемаяСтрока.НДС;
				НоваяСтрока.Всего_ДоКорректировки 			= КорректируемаяСтрока.Всего;
				
				НоваяСтрока.РеестрыНДС0Приложение_ДоКорректировки = КорректируемаяСтрока.РеестрыНДС0Приложение;
				
				Если КорректируемаяСтрока.ПорядокОтражения = Перечисления.CW_ПорядокОтраженияДоходов.Перевыставление Тогда
					ДокументКорректировкиРасходов = СоответствиеДокументов.Получить(КорректируемаяСтрока.ДокументРасходов);
					Если ДокументКорректировкиРасходов <> Неопределено Тогда
						НоваяСтрока.ДокументРасходов = ДокументКорректировкиРасходов;
					КонецЕсли; 
				КонецЕсли;     
				
				НоваяСтрока.Представление_ПередКорректировкой 	= КорректируемаяСтрока.Представление_ДоКорректировки;
				НоваяСтрока.Количество_ПередКорректировкой 		= КорректируемаяСтрока.Количество_ДоКорректировки;
				НоваяСтрока.Цена_ПередКорректировкой 			= КорректируемаяСтрока.Цена_ДоКорректировки;
				НоваяСтрока.Сумма_ПередКорректировкой 			= КорректируемаяСтрока.Сумма_ДоКорректировки;
				НоваяСтрока.СтавкаНДС_ПередКорректировкой 		= КорректируемаяСтрока.СтавкаНДС_ДоКорректировки;
				НоваяСтрока.НДС_ПередКорректировкой 			= КорректируемаяСтрока.НДС_ДоКорректировки;
				НоваяСтрока.Всего_ПередКорректировкой 			= КорректируемаяСтрока.Всего_ДоКорректировки;
				
				НоваяСтрока.РеестрыНДС0Приложение_ПередКорректировкой = КорректируемаяСтрока.РеестрыНДС0Приложение_ПередКорректировкой;
		
			КонецЦикла; 
			
		КонецЕсли;
		
		Если ДанныеЗаполнения.Свойство("ВводНаОсновании") Тогда
			
			Если Не ДанныеЗаполнения.Свойство("ТипОснования") Тогда
				ВызватьИсключение "Ошибка ввода на основании. Обратитесь к разработчику!";
				Возврат;
			КонецЕсли;	
			
			#Область Ввод_на_основании_CW_РасходыПоГрузоперевозке
			Если ДанныеЗаполнения.ТипОснования = Тип("ДокументСсылка.CW_РасходыПоГрузоперевозке") Тогда
				
				ВидОперации = ПредопределенноеЗначение("Перечисление.CW_ВидыОперацийДоходыПоГрузоперевозке.ОказаниеУслуг");
				
				Организация	= ДанныеЗаполнения.Организация;
				Дата		= ДанныеЗаполнения.ДатаДокумента;
				Контрагент	= ДанныеЗаполнения.Контрагент;
				Договор		= ДанныеЗаполнения.Договор;
				
				//Подсистема.УчетПриложенийДоговоров
				ПриложениеКДоговору 	= ДанныеЗаполнения.ПриложениеКДоговору;
				//Подсистема.УчетПриложенийДоговоров
				
				Если ЗначениеЗаполнено(ПриложениеКДоговору) Тогда
					Валюта =	ПриложениеКДоговору.ВалютаДоговора;
				Иначе
					Валюта = 	Договор.ВалютаДоговора;
				КонецЕсли;
				
				ВалютаИсточника = ДанныеЗаполнения.ДокументОснование.Валюта;
				ДатаИсточника	= ДанныеЗаполнения.ДокументОснование.Дата;
				
				//Для версии КОРП
				ВестиУчетПоПодразделениям	= ПолучитьФункциональнуюОпцию("ВестиУчетПоПодразделениям");
				Если ВестиУчетПоПодразделениям Тогда
					ПодразделениеОрганизации = ДанныеЗаполнения.ДокументОснование.ПодразделениеОрганизации;
				КонецЕсли;
				//Для версии КОРП
				
				ФормируетсяСчет		= ДанныеЗаполнения.ДокументОснование.ПредъявленСчет И CW_ПраваДоступа.ПравоДоступно("РедактированиеФинансов_Доходы_Счета");
				
				ФормируетсяАкт 	= ДанныеЗаполнения.ДокументОснование.ПредъявленАкт И CW_ПраваДоступа.ПравоДоступно("РедактированиеФинансов_Доходы_Акты");
				
				Если ФормируетсяАкт Тогда
					ФормируетсяСчетФактура 		= ДанныеЗаполнения.ДокументОснование.ПредъявленСФ;
				Иначе
					ФормируетсяСчетФактура = Ложь;
				КонецЕсли; 
				
				Если ДанныеЗаполнения.ПервичныеДокументы = 1 Тогда
					Если ФормируетсяСчет Тогда 
						ДатаСчета = ДанныеЗаполнения.ДокументОснование.ДатаСчета; 
					КонецЕсли;
					Если ФормируетсяАкт Тогда 
						ДатаАкта = ДанныеЗаполнения.ДокументОснование.ДатаАкта; 
					КонецЕсли;
					Если ФормируетсяСчетФактура Тогда 
						ДатаСчетаФактуры = ДанныеЗаполнения.ДокументОснование.ДатаСФ; 
					КонецЕсли;
				Иначе
					//Тут можно предцсмотреть заполнение реквизитов
					//первичных документов из формы ввода на основании
				КонецЕсли;
				
				СтруктураПараметров = CW_Настройки.ПустаяСтруктураПолученияПараметровДоговора();
				СтруктураПараметров.Дата 				= Дата;
				СтруктураПараметров.Договор 			= Договор;
				СтруктураПараметров.ПриложениеКДоговору = ПриложениеКДоговору;
				
				ПараметрыДоговора = CW_Настройки.ПолучитьПараметрыДоговора(СтруктураПараметров);
				СпособЗачетаАвансов		= ПараметрыДоговора.ПорядокЗачетаАвансов;
				ПорядокЗачетаАвансовОЗ 	= ПараметрыДоговора.ПорядокЗачетаАвансовОЗ;
				КодСпособаВыставления 	= ПараметрыДоговора.ОсновнойКодСпособаВыставленияСчетовФактур;
				
				ТаблицаУслуг = Документы.CW_ДоходыПоГрузоперевозке.Услуги_СформироватьПоДокументуРасходов(ДанныеЗаполнения.ДокументОснование,Договор,ПриложениеКДоговору, ДанныеЗаполнения.ПорядокОтраженияЗатрат,ДанныеЗаполнения.ПорядокОтраженияДоходов);
				
				// анализируем
				ПересчетЧерезРубли = Ложь;
				
				// если валюта документов одинаковая
				Если ВалютаИсточника = Валюта Тогда
					// если рубли
					Если Валюта = Константы.ВалютаРегламентированногоУчета.Получить() Тогда
						ПересчетЧерезРубли = Ложь;
					Иначе
						
						// проверяем даты документов и порядок отражения
						Если  ДанныеЗаполнения.ПорядокОтраженияДоходов = Перечисления.CW_ПорядокОтраженияДоходов.ПеревыставлениеПоСтавкам Тогда
							ПересчетЧерезРубли = Ложь;
						ИначеЕсли  ДанныеЗаполнения.ПорядокОтраженияДоходов = Перечисления.CW_ПорядокОтраженияДоходов.Перевыставление Тогда 
							// проверяем даты
							Если НачалоДня(Дата)= НачалоДня(ДатаИсточника) Тогда
								ПересчетЧерезРубли = Ложь;
							Иначе
								ПересчетЧерезРубли = Истина;
							КонецЕсли; 
						КонецЕсли; 
						
					КонецЕсли; 
					
				Иначе
					ПересчетЧерезРубли = Истина;
				КонецЕсли; 
				
				// проверяем необходимость формировать вознаграждение		
				ТребуетсяВознаграждение = ДанныеЗаполнения.ПорядокОтраженияДоходов = Перечисления.CW_ПорядокОтраженияДоходов.Перевыставление И ПараметрыДоговора.АвтоматическийРасчетВознаграждения 
				И ПараметрыДоговора.МоментАвтоматическогоВыставленияВознаграждения = Перечисления.CW_МоментАвтоматическогоВыставленияВознаграждения.ПриПеревыставлении;
				
				Если ПересчетЧерезРубли Тогда
					СтруктураКурса = CW_Финансы.ПолучитьКурсВалюты(Валюта,?(ДатаАкта=Дата(1,1,1),Дата,ДатаАкта));
					Документы.CW_ДоходыПоГрузоперевозке.Услуги_ПересчитатьИзВалютыРегламентированногоУчета(ТаблицаУслуг,СтруктураКурса);
				КонецЕсли; 
				
				Если ТребуетсяВознаграждение Тогда
					ТаблицаУслуг.Колонки.Добавить("База");
					Документы.CW_ДоходыПоГрузоперевозке.Услуги_ДобавитьВознаграждение(ТаблицаУслуг,Договор,ПриложениеКДоговору, ПараметрыДоговора,Дата);
				КонецЕсли; 
				
				// если надо формируем новое представление
				флЗановоФормироватьПредставлениеПриПеревыставленииЗатрат = CW_Настройки.ПараметрУчетнойПолитики(Дата, Организация, "ЗановоФормироватьПредставлениеПриПеревыставленииЗатрат");
				Если флЗановоФормироватьПредставлениеПриПеревыставленииЗатрат Тогда
					Документы.CW_ДоходыПоГрузоперевозке.Услуги_СформироватьПредставлениеНоменклатуры(ТаблицаУслуг,Договор,ЭтотОбъект,флЗановоФормироватьПредставлениеПриПеревыставленииЗатрат);
				КонецЕсли; 
				
				//Поставим цены из протокола согласования
				Документы.CW_ДоходыПоГрузоперевозке.Услуги_УстновитьЦенуУслугПоПротоколуСогласованияЦен(ТаблицаУслуг, ЭтотОбъект);		
				
				// --- 
				Услуги.Загрузить(ТаблицаУслуг);
				
				//Зависимые услуги
				CW_Подписки.ДобавитьДополнительнуюУслугу(ЭтотОбъект);
				//Зависимые услуги
				
			КонецЕсли; 
			#КонецОбласти
			
			#Область Ввод_на_основании_CW_ДоходыПоГрузоперевозке
			Если ДанныеЗаполнения.ТипОснования = Тип("ДокументСсылка.CW_ДоходыПоГрузоперевозке") Тогда
				
				Если Не ДанныеЗаполнения.Свойство("РежимВвода") Тогда
					//Для ввода доходов предусмотрено два режима
					ВызватьИсключение "Ошибка ввода на основании. Обратитесь к разработчику!";
				КонецЕсли;
				
				СохранитьДату = CW_Настройки.ПолучитьНастройкуПользователя(,"УстанавливатьДатуАктаРавнойДатеСчетаПриВводеНаОснованииДоходы");
				
				РежимВводаНаОсновании = ДанныеЗаполнения.РежимВвода;
				
				ДокументОснование = ДанныеЗаполнения.ДокументОснование;
				
				// заполняем
				ЗаполнитьЗначенияСвойств(ЭтотОбъект,ДокументОснование,,"ВедомыйСчет,ВедомыйДокумент,ВедомыйСчетФактура,Дата");
				
				СтруктураПараметров = CW_Настройки.ПустаяСтруктураПолученияПараметровДоговора();
				СтруктураПараметров.Дата 				= Дата;
				СтруктураПараметров.Договор 			= Договор;
				СтруктураПараметров.ПриложениеКДоговору = ПриложениеКДоговору;
				
				СтрокаИменПараметров = 	"РазмерАгентскогоВознаграждения;ВариантРасчетаВознаграждения;СтавкаНДС;"+
										"ПорядокЗачетаАвансов;ПорядокЗачетаАвансовОЗ;Номенклатура;"+
										"АвтоматическийРасчетВознаграждения;МоментАвтоматическогоВыставленияВознаграждения;ОсновнойКодСпособаВыставленияСчетовФактур";
		
				ПараметрыДоговора 		= CW_Настройки.ПолучитьПараметрыДоговора(СтруктураПараметров,СтрокаИменПараметров);
				СпособЗачетаАвансов 	= ПараметрыДоговора.ПорядокЗачетаАвансов;
				КодСпособаВыставления 	= ПараметрыДоговора.ОсновнойКодСпособаВыставленияСчетовФактур;

				
				Если СохранитьДату тогда
					Дата = ДокументОснование.Дата;
				КонецЕсли;
				
				// сбрасываем номер 
				Номер = "";
				
				Если РежимВводаНаОсновании = "СоздатьАкт" Тогда
					
					ВидОперации = Перечисления.CW_ВидыОперацийДоходыПоГрузоперевозке.ОказаниеУслуг;
	
					ФормируетсяСчет 	= Ложь;
					НомерСчета 			= "";
					ДатаСчета 			= Неопределено;
					
					ФормируетсяАкт		= Истина;
					НомерАкта 			= "";
					ДатаАкта 			= Неопределено;
					
					// --- 
					КопироватьНомер = CW_Настройки.ПолучитьНастройкуПользователя(,"КопироватьНомерПриВводеАктаНаОснованииСчета");
					Если КопироватьНомер=Неопределено Тогда
						КопироватьНомер = Ложь;
					КонецЕсли; 
					Если КопироватьНомер Тогда
						НомерАкта = ДокументОснование.НомерСчета;
						ДатаАкта = ТекущаяДата();
					КонецЕсли; 
					
					ФормируетсяСчетФактура = НастройкиПользователя.Доходы_ФормироватьСчетФактуру;
					НомерСчетаФактуры = "";
					ДатаСчетаФактуры = Дата(1,1,1);
					Если ФормируетсяСчетФактура Тогда
						
						КопироватьНомерДляСФ = CW_Настройки.ПолучитьНастройкуПользователя(,"КопироватьНомерПриВводеСчетаФактурыНаОснованииСчета");
						Если КопироватьНомерДляСФ = Неопределено Тогда
							КопироватьНомерДляСФ = Ложь;
						КонецЕсли; 
						Если КопироватьНомерДляСФ Тогда
							НомерСчетаФактуры = НомерАкта;
							ДатаСчетаФактуры = ДатаАкта;
						КонецЕсли; 
					КонецЕсли;
					
					// акт на основании счета
					Счет 			= ДокументОснование;
					СписокСчетов 	= Ложь;
					
					Услуги.Загрузить(ДокументОснование.Услуги.Выгрузить());
				КонецЕсли;
				
				Если РежимВводаНаОсновании = "СоздатьВознагражение" Тогда
					
					ВидОперации = Перечисления.CW_ВидыОперацийДоходыПоГрузоперевозке.ОтчетАгента;

					ФормируетсяСчет 	= ДокументОснование.ФормируетсяСчет;
					НомерСчета 			= "";
					ДатаСчета 			= Неопределено;
					
					ФормируетсяАкт 		= ДокументОснование.ФормируетсяАкт;
					НомерАкта 			= "";
					ДатаАкта 			= Неопределено;
					
					ФормируетсяСчетФактура 		= ДокументОснование.ФормируетсяСчетФактура;
					НомерСчетаФактуры 			= "";
					ДатаСчетаФактуры 			= Неопределено;
					
					ВедомыйДокумент 	= Неопределено;
					ВедомыйСчет 		= Неопределено;
					ВедомыйСчетФактура 	= Неопределено;
					
					мДокументы = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ДокументОснование);
					ЗаполнитьТабличнуюЧастьВознаграждение(мДокументы, ПараметрыДоговора.Номенклатура, ПараметрыДоговора, ДокументОснование);
					
					
				КонецЕсли;
				
				//Зависимые услуги
				CW_Подписки.ДобавитьДополнительнуюУслугу(ЭтотОбъект);
				//Зависимые услуги

			Конецесли;
			#КонецОбласти
			
		КонецЕсли; 
	КонецЕсли; 
	
	Если ТипЗнч(ДанныеЗаполнения)=Тип("ДокументСсылка.CW_ОтчетЭкспедитора") Тогда
		
		//Проверим параметры договора
		СтруктураПараметров = CW_Настройки.ПустаяСтруктураПолученияПараметровДоговора();
		СтруктураПараметров.Дата 				= ДанныеЗаполнения.Дата;
		СтруктураПараметров.Договор 			= ДанныеЗаполнения.Договор;
		СтруктураПараметров.ПриложениеКДоговору = ДанныеЗаполнения.ПриложениеКДоговору;

		СтрокаИменПараметров = 	"РазмерАгентскогоВознаграждения;ВариантРасчетаВознаграждения;СтавкаНДС;"+
								"ПорядокЗачетаАвансов;ПорядокЗачетаАвансовОЗ;Номенклатура;"+
								"АвтоматическийРасчетВознаграждения;МоментАвтоматическогоВыставленияВознаграждения";
		
		ДанныеПараметровДоговора = CW_Настройки.ПолучитьПараметрыДоговора(СтруктураПараметров, СтрокаИменПараметров);
		
		Если ДанныеПараметровДоговора.АвтоматическийРасчетВознаграждения и 
			ДанныеПараметровДоговора.МоментАвтоматическогоВыставленияВознаграждения = Перечисления.CW_МоментАвтоматическогоВыставленияВознаграждения.ОтдельнымДокументом Тогда
			//Заполняем вознаграждение экспедитора
			СформироватьВознаграждениеЭкспедитра(ДанныеЗаполнения,ДанныеПараметровДоговора);
		Иначе
			ВызватьИсключение "Ввод на основании доступен только для договоров с автоматическим расчетом вознаграждения и его вводом отдельным документом!";
		КонецЕсли;
		
	КонецЕсли; 
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	ВедомыйДокумент 			= Документы.РеализацияТоваровУслуг.ПустаяСсылка();
	ВедомыйСчет 				= Документы.СчетНаОплатуПокупателю.ПустаяСсылка();
	ВедомыйСчетФактура 			= Документы.СчетФактураВыданный.ПустаяСсылка();
	ИдентификаторГосКонтракта 	= "";
	РабочиеДатаВремя 			= CW_Документы.РабочееВремя();
	ОтредактированыДокументыОтгрузки = Ложь;
	ДокументыОбОтгрузке.Очистить();
	
	
	ЗачетАвансов.Очистить();
	ЗачетАвансовОЗ.Очистить();
	ПлатёжноРасчётныеДокументы.Очистить();
	
	// ---------------------------------------------------------------------------- 
	
	НП = CW_Настройки.ПолучитьНастройкиПользователя();
	УстанавливатьТекущееВремя = НП.ПриКопированниУстанавливатьТекущееВремя;
	УстанавливатьТекущееВремя = ?(УстанавливатьТекущееВремя=Неопределено, Ложь, УстанавливатьТекущееВремя);
	
	Дата = ?(УстанавливатьТекущееВремя,РабочиеДатаВремя,НачалоДня(РабочиеДатаВремя));
	
	Если (CW_ПраваДоступа.ПравоДоступно("РедактированиеФинансов_Доходы_Счета")) Тогда
		ФормируетсяСчет=НП.Доходы_ФормироватьСчет;
	Иначе
		ФормируетсяСчет = Ложь;
	КонецЕсли; 
	НомерСчета = "";
	ДатаСчета = Дата(1,1,1);
	
	// --- 
	
	Если (CW_ПраваДоступа.ПравоДоступно("РедактированиеФинансов_Доходы_Акты")) Тогда
		
		ФормируетсяАкт=НП.Доходы_ФормироватьАкт;
		
		// --- 
		ФормируетсяСчетФактура=НП.Доходы_ФормироватьСчетФактуру;
		
	Иначе
		
		ФормируетсяАкт = Ложь;
		ФормируетсяСчетФактура = Ложь;
		
	КонецЕсли; 
	НомерАкта = "";
	ДатаАкта = Дата(1,1,1);
	НомерСчетаФактуры = "";
	ДатаСчетаФактуры = Дата(1,1,1);	
	
	Ответственный = Неопределено;
	
	//СрокОплаты = Дата(1,1,1);
	//СрокОплатыОписание = "";	
	
КонецПроцедуры

Процедура ПриУстановкеНовогоНомера(СтандартнаяОбработка, Префикс)
	
	ПорядокПрисвоенияНомеров = CW_Настройки.ПараметрУчетнойПолитики(Дата,Организация,"ПорядокПрисвоенияНомеров");
	// --- 
	Если (ПорядокПрисвоенияНомеров = Перечисления.CW_ПорядокПрисвоенияИсходящихНомеров.ВПределахДаты) Тогда
		Префикс = СокрЛП(Организация.Префикс)+Строка(Формат(Дата,"ДФ=ММ"))+ Строка(Формат(Дата,"ДФ=dd"))+"-";
	ИначеЕсли (ПорядокПрисвоенияНомеров = Перечисления.CW_ПорядокПрисвоенияИсходящихНомеров.СплошнаяНумерация) Тогда
		Префикс = CW_Документы.ПрефиксОрганизации(Организация);
	ИначеЕсли (ПорядокПрисвоенияНомеров = Перечисления.CW_ПорядокПрисвоенияИсходящихНомеров.НезависимаяНумерация) Тогда 
		Префикс = CW_Документы.ПрефиксОрганизации(Организация);
	ИначеЕсли (ПорядокПрисвоенияНомеров = Перечисления.CW_ПорядокПрисвоенияИсходящихНомеров.ВнешнийНумератор) Тогда 
		
		// проверки
		Нумератор = CW_Настройки.ПараметрУчетнойПолитики(Дата,Организация,"ВнешнийНумератор");
		// --- 
		ОбработкаНумерации = _ПО.ПолучитьОбработку(Нумератор);
		ОбработкаНумерации.УстановитьНомерДокумента(ЭтотОбъект,СтандартнаяОбработка,Префикс);
		
	Иначе
		
		Префикс = CW_Документы.ПрефиксОрганизации(Организация);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	// обмен данными
	Если ОбменДанными.Загрузка Тогда 
		Возврат; 
	КонецЕсли;
	
	// контроль наличия общих параметров
	Если НЕ ЗаполненыОбщиеПараметры() Тогда 
		СформироватьОбщиеПараметры();
	КонецЕсли;
	
	ПроверяемыеРеквизиты.Очистить();
	
	// получим необходимые права и опции пользователя
	РазрешитьПроведениеДокументовБезГрузоперевозок 	= CW_ПраваДоступа.ПравоДоступно("РазрешитьПроведениеДокументовБезГрузоперевозок");
	КонтролироватьСтрокиСНулевойСуммой 				= CW_Настройки.ПолучитьНастройкуПользователя(,"КонтролироватьСтрокиСНулевойСуммой");
	
	// проверка реквизитов
	флОшибка = Ложь;
	МассивСообщений = Новый Массив;
	
	Если Организация.Пустая() Тогда
		флОшибка = Истина;
		МассивСообщений.Добавить("Не указана организация!");
	КонецЕсли; 
	
	Если Контрагент.Пустая() Тогда
		флОшибка = Истина;
		МассивСообщений.Добавить("Не указан контрагент!");
	КонецЕсли; 
	
	Если Договор.Пустая() Тогда
		флОшибка = Истина;
		МассивСообщений.Добавить("Не указан договор контрагента!");
	КонецЕсли; 
	
	ДатаНачалаВеденияУчета = CW_Настройки.ПолучитьДатуНачалаВеденияУчета(Организация);
	
	Если НЕ ДатаНачалаВеденияУчета = Неопределено Тогда
		РежимВводНачальныхОстатков = Ложь;		
		Если Дата < ДатаНачалаВеденияУчета Тогда		
			РежимВводНачальныхОстатков = Истина;
		Иначе
			РежимВводНачальныхОстатков = Ложь;
		КонецЕсли;
	Иначе
		РежимВводНачальныхОстатков = Ложь;	
	КонецЕсли;
	
	Для каждого Стр Из Услуги Цикл
		
		Если Стр.Номенклатура.Пустая() Тогда
			флОшибка = Истина;
			МассивСообщений.Добавить("В строке №"+Стр.НомерСтроки+" таблицы услуг не указана номенклатура услуги!");
		Иначе 
			Если ВидОперации = Перечисления.CW_ВидыОперацийДоходыПоГрузоперевозке.ОтчетАгента Тогда 
				// допустима только номенклатура агентского вознаграждения
				Если Стр.Номенклатура<>ДС.ПД.Номенклатура Тогда 
					флОшибка = Истина;
					МассивСообщений.Добавить("В строке №"+Стр.НомерСтроки+" таблицы услуг номенклатура отличается от указанной в параметрах договора услуги!");
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		Если CW_Настройки.ПолучитьНастройкуПользователя(, "ПроверятьНоменклатурнуюГруппу") И Стр.ПорядокОтражения = Перечисления.CW_ПорядокОтраженияДоходов.СобственнаяУслуга Тогда
			Если НЕ ЗначениеЗаполнено(Стр.Номенклатура.НоменклатурнаяГруппа) Тогда
				флОшибка = Истина;
				МассивСообщений.Добавить("У номенклатуры в строке " + Стр.НомерСтроки + " отсутствует номенклатурная группа!");
			КонецЕсли;
		КонецЕсли;	
		
		Если ПолучитьФункциональнуюОпцию("CW_ОтображатьСтатьюЗатратВДокументахПоРасходамДоходам") Тогда
			Если Стр.СтатьяЗатрат.Пустая() и Стр.ПорядокОтражения = ПредопределенноеЗначение("Перечисление.CW_ПорядокОтраженияДоходов.СобственнаяУслуга") Тогда
				флОшибка = Истина;
				МассивСообщений.Добавить("В строке №"+Стр.НомерСтроки+" таблицы услуг не указана статья затрат!");
			КонецЕсли;
		КонецЕсли;
	
		Если НЕ РазрешитьПроведениеДокументовБезГрузоперевозок Тогда
			
			Если РежимВводНачальныхОстатков Тогда
				Если Стр.ПорядокОтражения = Перечисления.CW_ПорядокОтраженияДоходов.Перевыставление ИЛИ Стр.ПорядокОтражения = Перечисления.CW_ПорядокОтраженияДоходов.ПеревыставлениеПоСтавкам Тогда
					Если НЕ ЗначениеЗаполнено(Стр.Грузоперевозка) Тогда
						флОшибка = Истина;
						МассивСообщений.Добавить("В строке №"+Стр.НомерСтроки+" таблицы услуг не указана грузоперевозка!");
					КонецЕсли;
				КонецЕсли;
			Иначе
				Если НЕ ЗначениеЗаполнено(Стр.Грузоперевозка) Тогда
					флОшибка = Истина;
					МассивСообщений.Добавить("В строке №"+Стр.НомерСтроки+" таблицы услуг не указана грузоперевозка!");
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли; 
		
		Если НЕ ЗначениеЗаполнено(Стр.ПорядокОтражения) Тогда
			флОшибка = Истина;
			МассивСообщений.Добавить("В строке №"+Стр.НомерСтроки+" таблицы услуг не указан порядок отражения!");
		КонецЕсли;
		
		// проверим необходимость заполнения документа затрат
		флНеобходимДокументЗатрат = Ложь;
		
		// документ затрат требуется только для бухгалтерских документов (акт, с\ф)
		Если ФормируетсяАкт Тогда
			
			// перевыставление
			Если Стр.ПорядокОтражения = Перечисления.CW_ПорядокОтраженияДоходов.Перевыставление Тогда 
				флНеобходимДокументЗатрат = Истина;	
				
			// отчет агента с автоматическим расчетом вознаграждения по договору
			Иначе 
				Если ДС.ПД.АвтоматическийРасчетВознаграждения = Истина И ВидОперации = Перечисления.CW_ВидыОперацийДоходыПоГрузоперевозке.ОтчетАгента Тогда 
					Если ДС.ПД.ВариантРасчетаВознаграждения = Перечисления.CW_ВариантыАвтоматическогоРасчетаВознаграждения.ПроцентОтСуммы Тогда 
						Если Стр.Номенклатура = ДС.ПД.Номенклатура Тогда 
							флНеобходимДокументЗатрат = Истина;
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;	
		
		Если флНеобходимДокументЗатрат И НЕ ЗначениеЗаполнено(Стр.ДокументРасходов) Тогда 
			флОшибка = Истина;
			МассивСообщений.Добавить("В строке №"+Стр.НомерСтроки+" таблицы услуг не заполнен документ затрат!");
		КонецЕсли;

		// проверим заполнение реквизитов для ТЧ "Услуги"
		Если (НЕ Корректировка) Тогда
			
			Если Стр.Количество = 0 Тогда
				флОшибка = Истина;
				МассивСообщений.Добавить("В строке №"+Стр.НомерСтроки+" таблицы услуг не указано количество!");
			КонецЕсли;
			
			Если Стр.Цена = 0 и КонтролироватьСтрокиСНулевойСуммой Тогда
				флОшибка = Истина;
				МассивСообщений.Добавить("В строке №"+Стр.НомерСтроки+" таблицы услуг не указана цена!");
			КонецЕсли;
			
			Если Стр.Сумма = 0 и КонтролироватьСтрокиСНулевойСуммой Тогда
				флОшибка = Истина;
				МассивСообщений.Добавить("В строке №"+Стр.НомерСтроки+" таблицы услуг не указана сумма!");
			КонецЕсли;
			
			Если Стр.СтавкаНДС.Пустая() Тогда
				флОшибка = Истина;
				МассивСообщений.Добавить("В строке №"+Стр.НомерСтроки+" таблицы услуг не указана ставка НДС!");
			КонецЕсли;
			
			Если (Стр.НДС = 0) И 
				 (Стр.СтавкаНДС <> Перечисления.СтавкиНДС.БезНДС) И 
				 (Стр.СтавкаНДС <> Перечисления.СтавкиНДС.НДС0) И 
				 КонтролироватьСтрокиСНулевойСуммой
			Тогда
				флОшибка = Истина;
				МассивСообщений.Добавить("В строке №"+Стр.НомерСтроки+" таблицы услуг не указана сумма НДС!");
			КонецЕсли;
			
			Если Стр.Всего = 0 и КонтролироватьСтрокиСНулевойСуммой Тогда
				флОшибка = Истина;
				МассивСообщений.Добавить("В строке №"+Стр.НомерСтроки+" таблицы услуг не указана сумма всего!");
			КонецЕсли;
			
		КонецЕсли; 
		
		ГП = Стр.Грузоперевозка;
		ТП = Стр.Грузоперевозка.ТипПеревозки;
		Если ЗначениеЗаполнено(ТП) Тогда
			Если (ТП.КонтрольЗаполненияКлиентаДоходы И НЕ ЗначениеЗаполнено(ГП.Клиент)) Тогда
				МассивСообщений.Добавить("У грузоперевозки в строке " + Стр.НомерСтроки + " не заполнен обязательный реквизит ""Клиент""");
				флОшибка = Истина;
			КонецЕсли; 
			
			Если (ТП.КонтрольЗаполненияТипоразмераДоходы И НЕ ЗначениеЗаполнено(ГП.Типоразмер)) Тогда
				МассивСообщений.Добавить("У грузоперевозки в строке " + Стр.НомерСтроки + " не заполнен обязательный реквизит ""Типоразмер контейнера""");
				флОшибка = Истина;
			КонецЕсли; 
			
			Если (ТП.КонтрольЗаполненияГрузаДоходы И Константы.CW_Мониторинг_Груз.Получить() И НЕ ЗначениеЗаполнено(ГП.Груз)) Тогда
				МассивСообщений.Добавить("У грузоперевозки в строке " + Стр.НомерСтроки + " не заполнен обязательный реквизит ""Груз""");
				флОшибка = Истина;
			КонецЕсли; 
			
			Если (ТП.КонтрольЗаполненияМаршрутаДоходы И Константы.CW_Мониторинг_Маршрут.Получить() И НЕ ЗначениеЗаполнено(ГП.Маршрут)) Тогда
				МассивСообщений.Добавить("У грузоперевозки в строке " + Стр.НомерСтроки + " не заполнен обязательный реквизит ""Маршрут""");
				флОшибка = Истина;
			КонецЕсли; 
						
			Если (ТП.КонтрольЗаполненияМенеджераПродажДоходы И Константы.CW_Мониторинг_МенеджерПродаж.Получить() И НЕ ЗначениеЗаполнено(ГП.МенеджерПродаж)) Тогда
				МассивСообщений.Добавить("У грузоперевозки в строке " + Стр.НомерСтроки + " не заполнен обязательный реквизит ""Менеджер продаж""");
				флОшибка = Истина;
			КонецЕсли; 
						
			Если (ТП.КонтрольЗаполненияОперативногоМенеджераДоходы И Константы.CW_Мониторинг_ОперативныйМенеджер.Получить() И НЕ ЗначениеЗаполнено(ГП.ОперативныйМенеджер)) Тогда
				МассивСообщений.Добавить("У грузоперевозки в строке " + Стр.НомерСтроки + " не заполнен обязательный реквизит ""Оперативный менеджер""");
				флОшибка = Истина;
			КонецЕсли; 
			
			Отбор = Новый Структура("КонтрольЗаполненияДоходы", Истина);
			КонтроллируемыеПараметры = ТП.ПараметрыГрузоперевозки.Выгрузить(Отбор);
			СоответствиеСвойствПараметров = CW_Мониторинг.ПолучитьСоответствиеСвойствПараметров();
			Для Каждого СтрП Из КонтроллируемыеПараметры Цикл
				флПараметрНезаполнен = Ложь;
				ОтборПоПараметру = Новый Структура("Параметр", СтрП.Параметр);
				СтрокаПараметра = _сф.к_НайтиСтроку(ГП.ПараметрыГрузоперевозки, ОтборПоПараметру);
				СП = СоответствиеСвойствПараметров.Получить(СтрП.Параметр);
				Если (СтрокаПараметра = Неопределено) Тогда
					флПараметрНезаполнен = Истина;
				Иначе
					Если (СП.ЭтоКонтрольнаяДата) Тогда
						Если (НЕ ЗначениеЗаполнено(СтрокаПараметра.ЗначениеФакт)) Тогда
							флПараметрНезаполнен = Истина;
						КонецЕсли; 
					Иначе
						Если (НЕ ЗначениеЗаполнено(СтрокаПараметра.Значение)) Тогда
							флПараметрНезаполнен = Истина;
						КонецЕсли; 
					КонецЕсли; 
				КонецЕсли; 
				
				Если (флПараметрНезаполнен) Тогда
					МассивСообщений.Добавить("У грузоперевозки в строке " + Стр.НомерСтроки + " не заполнен обязательный параметр """ + СП.Наименование + """");
					флОшибка = Истина;
				КонецЕсли; 
			КонецЦикла; 
		КонецЕсли; 
		
	КонецЦикла; 
	
	Если флОшибка Тогда
		
		Для каждого Стр Из МассивСообщений Цикл
			Сообщить(Стр,СтатусСообщения.Внимание);
		КонецЦикла; 
		
		Отказ = Истина;
		Возврат;
		
	КонецЕсли; 
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если (РучнаяКорректировка) Тогда 
		Возврат; 
	КонецЕсли; 

	//Для версии КОРП 
	ВестиУчетПоПодразделениям = ПолучитьФункциональнуюОпцию("ВестиУчетПоПодразделениям");
	//Для версии КОРП 
	
	//Подситема.СтатусыДокументов
	СтатусДокумента = Неопределено;
	ЭтотОбъект.ДополнительныеСвойства.Свойство("СтатусДокумента", СтатусДокумента);
	
	СтатусДокументаПроводитьПоБухгалтерскомуУчету = CW_СтатусыДокументовСервер.ПолучитьПризнакПроведенияПоБухгалтерскомуУчету(Ссылка, СтатусДокумента);
	//Подситема.СтатусыДокументов
	
	СтруктураПараметровБухУчета = Новый Структура;
	СтруктураПараметровБухУчета.Вставить("Договор", 					Договор);
	СтруктураПараметровБухУчета.Вставить("ПриложениеКДоговору",			ПриложениеКДоговору);
	
	ПараметрыБухгалтерскогоУчета = CW_Финансы.ПолучитьПарметрыВеденияБухгалтерскогоУчета(СтруктураПараметровБухУчета, Дата);
	
	ПровестиПоБухгалтерскомуУчету = СтатусДокументаПроводитьПоБухгалтерскомуУчету и ПараметрыБухгалтерскогоУчета.БухгалтерскийУчет;
	
	_сф.ст_УстановитьСвойство(ДополнительныеСвойства,"СтатусПроведенияДоПроведения", Проведен);
	
	// проверка прав
	ПроведениеРазрешено = CW_ПраваДоступа.ПравоДоступно("РедактированиеФинансов");
	Если (Корректировка) Тогда
		ПроведениеРазрешено = ПроведениеРазрешено И CW_ПраваДоступа.ПравоДоступно("РедактированиеФинансов_Корректировки");
	КонецЕсли; 
	Если (НЕ ПроведениеРазрешено) Тогда
		Отказ = Истина;
		Сообщить("Недостаточно прав на проведение документа!");
		Возврат;
	КонецЕсли; 
	
	//Контроль услуг по договору
	Если ПолучитьФункциональнуюОпцию("CW_ОграничиватьУслугиПоДоговорам") и Договор.ОграничиватьНоменклатуру Тогда	
		
		ДатаДокумента = Дата;
		Если ФормируетсяАкт 
			и ЗначениеЗаполнено(ДатаАкта) Тогда
			ДатаДокумента = ДатаАкта;  
		ИначеЕсли ФормируетсяСчет 
			и ЗначениеЗаполнено(ДатаСчета) Тогда
			ДатаДокумента = ДатаСчета;  
		КонецЕсли;
	
		АдресУслуг = _УФС.ОбновитьСписокУслугПоДоговору(ДатаДокумента, Договор);
		Если ЭтоАдресВременногоХранилища(АдресУслуг) Тогда
			ТаблицаУслугДоговора 	= ПолучитьИзВременногоХранилища(АдресУслуг);
			МассивУслугДоговора 	= ТаблицаУслугДоговора.ВыгрузитьКолонку("Номенклатура"); 
			
			ИсключитьПеревыставление = Константы.CW_НеОграничиватьСписокУслугПриПеревыставленииЗатрат.Получить();
			МассивУслугДокумента 	 = ПолучитьМассивУслугДокумента(ИсключитьПеревыставление);
			
			CW_Документы.ПроверитьСоответствиеУслугПоДоговору(МассивУслугДоговора, МассивУслугДокумента, Отказ);
			
		КонецЕсли;
		
		Если Отказ тогда
			Возврат;
		Конецесли;
		
	КонецЕсли;		
		
	// контроль загрузки
	Если ОбменДанными.Загрузка Тогда 
		Возврат; 
	КонецЕсли;
	
	// не перепроводим при восстановлении последовательности
	ВосстановлениеПоследовательности = _сф.ст_ПолучитьСвойство(ДополнительныеСвойства,"ПроведенВХронологическойПоследовательности");
	Если (ВосстановлениеПоследовательности <> Неопределено) Тогда
		Если (ВосстановлениеПоследовательности) Тогда
			Возврат;
		КонецЕсли; 
	КонецЕсли; 
	
	Если (ПровестиПоБухгалтерскомуУчету) Тогда
		CW_Финансы.ПредупреждениеПоСхемеУчетаПеревыставленияПоСтавкам(ЭтотОбъект);	
	КонецЕсли; 
	
	// контроль наличия общих параметров
	Если НЕ ЗаполненыОбщиеПараметры() Тогда 
		СформироватьОбщиеПараметры(,Ложь); 
	КонецЕсли; 
	
	// если изменились даты начала ведения учета, то обновим соответствующие флаги
	// (при условии того, что в документе указана организация и договор)
	Если ЗначениеЗаполнено(Организация) и ЗначениеЗаполнено(Организация) Тогда
		Если ВводОстатковБУ <> ДополнительныеСвойства.УП.ВводОстатковБУ Тогда
			ВводОстатковБУ = ДополнительныеСвойства.УП.ВводОстатковБУ;	
		КонецЕсли; 
		Если ВводОстатковОЗ <> ДополнительныеСвойства.УП.ВводОстатковОЗ Тогда
			ВводОстатковОЗ = ДополнительныеСвойства.УП.ВводОстатковОЗ;	
		КонецЕсли; 	
	Иначе
		ВводОстатковБУ = Ложь;
		ВводОстатковОЗ = Ложь;
	КонецЕсли; 
	
	// фиксируем режим записи
	_сф.ст_УстановитьСвойство(ДополнительныеСвойства,"РежимЗаписи",РежимЗаписи);
	
	// проверка распроведения счетов с актами и оплатами (только для базовой валюты "Рубль")
	Если РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения ИЛИ РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
		
		ЭтоСчет 	= ФормируетсяСчет;
		ЭтоАкт 		= Не ФормируетсяСчет и (ФормируетсяАкт или ФормируетсяСчетФактура);
		ЭтоПакет 	= ФормируетсяСчет и (ФормируетсяАкт или ФормируетсяСчетФактура);
		
		// получим значение базовой валюты
		БазоваяВалютаРубль = Константы.CW_ВалютаРегламентированногоУчетаРубль.Получить();
		
		ПравоРедактирования = CW_ПраваДоступа.ПравоДоступно("РедактированиеФинансов");
		
		РедактированиеСчета 				= CW_ПраваДоступа.ПравоДоступно("РедактированиеФинансов_Доходы_Счета");
		РедактированиеАктированныхСчетов 	= CW_ПраваДоступа.ПравоДоступно("РазрешитьРедактированиеИсходящихАктированныхСчетов") 	И РедактированиеСчета;
		РедактированиеОплаченныхСчетов 		= CW_ПраваДоступа.ПравоДоступно("РазрешитьРедактированиеИсходящихОплаченныхСчетов") 	И РедактированиеСчета;
		
		// проверяем, ведётся ли оперативная задолженность
	//	Если ДС.УП.ОЗ И НЕ ЭтоПакет Тогда
		Если ДС.УП.ОЗ Тогда
			
			Если Корректировка и ПравоРедактирования Тогда
				ПравоРедактирования = CW_ПраваДоступа.ПравоДоступно("РедактированиеФинансов_Корректировки");
			КонецЕсли;
			
			Если ЭтоАкт И ПравоРедактирования Тогда
				ПравоРедактирования = CW_ПраваДоступа.ПравоДоступно("РедактированиеФинансов_Доходы_Акты");
			Конецесли;
			
			Если ПравоРедактирования И ЭтоСчет и РедактированиеСчета и БазоваяВалютаРубль Тогда
				
				Если Не РедактированиеАктированныхСчетов и ПравоРедактирования Тогда
					// проверяем, что нет сформированных актов
					Запрос = Новый Запрос;
					Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
					|	CW_СоответствиеАктовИсходящимСчетам.Акт КАК Акт
					|ИЗ
					|	РегистрСведений.CW_СоответствиеАктовИсходящимСчетам КАК CW_СоответствиеАктовИсходящимСчетам
					|ГДЕ
					|	CW_СоответствиеАктовИсходящимСчетам.Счет = &Счет";
					
					Запрос.УстановитьПараметр("Счет", Ссылка);
					РезультатЗапроса = Запрос.Выполнить();
					
					ПравоРедактирования = РезультатЗапроса.Пустой();
				КонецЕсли;
				
				Если Не РедактированиеОплаченныхСчетов и ПравоРедактирования Тогда
					// проверяем, нет ли оплат
					Запрос = Новый Запрос;
					Запрос.Текст = "ВЫБРАТЬ
					|	CW_ОплатаИсходящихДокументов.ДокументОплаты КАК ДокументОплаты
					|ИЗ
					|	РегистрСведений.CW_ОплатаИсходящихДокументов КАК CW_ОплатаИсходящихДокументов
					|ГДЕ
					|	CW_ОплатаИсходящихДокументов.Документ = &Документ";
					Запрос.УстановитьПараметр("Документ", Ссылка);
					
					РезультатЗапроса = Запрос.Выполнить();
					
					ПравоРедактирования = РезультатЗапроса.Пустой();
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
		Если Не ПравоРедактирования Тогда
			Если РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения Тогда
				ТекстСообщения = "Недостаточно прав для отмены проведения документа!";
			КонецЕсли;
			Если РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
				ТекстСообщения = "Недостаточно прав для проведения документа!";
			КонецЕсли;
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,,,Отказ);
		КонецЕсли;
		
	КонецЕсли;

	// контроль номенклатурной группы
	ЕстьОшибкиНоменклатурнойГруппы = Ложь;
	Для Каждого Стр Из Услуги Цикл
		Если стр.ПорядокОтражения = Перечисления.CW_ПорядокОтраженияДоходов.СобственнаяУслуга Тогда
			Если Стр.Номенклатура.НоменклатурнаяГруппа.Пустая() Тогда
				Если CW_Настройки.ПолучитьНастройкуПользователя(,"ПроверятьНоменклатурнуюГруппу") Тогда
					Сообщить("У номенклатуры в строке " + Стр.НомерСтроки + " отсутствует номенклатурная группа!", СтатусСообщения.Важное); 
					ЕстьОшибкиНоменклатурнойГруппы = Истина;
				КонецЕсли; 
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Если ЕстьОшибкиНоменклатурнойГруппы Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли; 
	
	// Контроль срока договора/приложения 
	СтруктураПараметров = CW_Документы.ПустаяСтруктураКонтроляСрокаДействияДоговора(); 
	СтруктураПараметров.КонтролироватьСрокДоговоров 	= ДС.НП.КонтролироватьСрокДоговоров;
	СтруктураПараметров.КонтролироватьСрокПриложения 	= ДС.НП.КонтролироватьСрокДействияПриложения; 
	
	CW_Документы.ПроверитьСрокДействияДоговора(ЭтотОбъект, СтруктураПараметров, Отказ);
	
	
	// считаем суммы документа
	Если (НЕ Корректировка) Тогда
		
		СуммаДокумента = _сф.Итог(Услуги,"Всего");
		СуммаНДС = _сф.Итог(Услуги,"НДС");
		
	Иначе
		
		пСуммаДокумента = 0;
		пСуммаНДС = 0;
		// --- 
		Для каждого Стр Из Услуги Цикл
			
			_сф.Инкремент(пСуммаДокумента,Стр.Всего - Стр.Всего_ДоКорректировки);
			_сф.Инкремент(пСуммаНДС,Стр.НДС - Стр.НДС_ДоКорректировки);
			
		КонецЦикла; 
		// --- 
		СуммаДокумента = пСуммаДокумента;
		СуммаНДС = пСуммаНДС;
		
	КонецЕсли; 
	
	// проверка реквизитов ввода остатков для непомеченных на удаление
	Если (НЕ ПометкаУдаления) Тогда
		
		// признак ошибки
		флОшибка = Ложь;
		МассивСообщений = Новый Массив;
		
		// проверка корректности ввода остатков
		Если ВводОстатковБУ Тогда
			
			// проверяем, курс по взаиморасчетам
			Если (Договор.ВзаиморасчетыВУЕ И (КурсВзаиморасчетовБУ = 0) И
				((ФормируетсяАкт) Или (ФормируетсяСчетФактура)) И СальдоВзаиморасчетовБУ > 0) 	
			Тогда
				флОшибка = Истина;
				МассивСообщений.Добавить("Не указан курс взаиморасчётов по бухгалтерскому учету!");				
			КонецЕсли;	
			
		КонецЕсли; 
		
		Если ВводОстатковОЗ Тогда
			
			// проверяем, курс по взаиморасчетам (для валютных и у.е. взаиморасчетов)
			Если (СальдоВзаиморасчетовОЗ <> 0) И 
				(Валюта <> ДС.КО.ВалютаРегламентированногоУчета) И 
				(КурсВзаиморасчетовОЗ = 0) И
				(ФормируетсяСчет)  	
			Тогда
				флОшибка = Истина;
				МассивСообщений.Добавить("Не указан курс ввода остатков для оперативного учета задолженности!");				
			КонецЕсли;	
			
		КонецЕсли; 
		
		Если флОшибка Тогда
			
			Сообщить("Проверка перед записью " + ЭтотОбъект + ": ");
			Для каждого Стр Из МассивСообщений Цикл
				Сообщить(Стр,СтатусСообщения.Внимание);
			КонецЦикла; 
			
			Отказ = Истина;
			Возврат;
			
		КонецЕсли; 
		
	КонецЕсли; // проверка реквезитов ввода остатков
	
	// заполняем ответственного
	_сф.УстановитьЕслиНезаполнено(Ответственный,CW_Настройки.Пользователь());
	
	// формируем список контейнеров
	мГП = _сф.м_СоздатьИзКолонкиТЗ(Услуги.Выгрузить(,"Грузоперевозка"),"Грузоперевозка");
	нСписокГП  = _сф.м_Представление(мГП,",");
	Если нСписокГП <> СписокКонтейнеров Тогда
		СписокКонтейнеров = СтрЗаменить(нСписокГП,",",", ");
	КонецЕсли; 
			
	// для подстановки последнего договора записываем его в регистр
	CW_Документы.ЗаписатьПоследнийДоговор(Договор);
	
	НП = CW_Настройки.ПолучитьНастройкиПользователя();
	
	КонтроллироватьДатыПеревыставления = НП.ПредупреждатьОПеревыставленииРанееДокументовПоставщика;
	Если (КонтроллироватьДатыПеревыставления = Неопределено) Тогда
		КонтроллироватьДатыПеревыставления = Ложь;
	КонецЕсли; 
	КонтроллироватьДатыПеревыставления = КонтроллироватьДатыПеревыставления И ФормируетсяАкт И (РежимЗаписи = РежимЗаписиДокумента.Запись ИЛИ РежимЗаписи = РежимЗаписиДокумента.Проведение);
	СтаршаяДатаРасходов = Дата(1,1,1);
	
	// контроль логической целостности для счетов
	Если (ФормируетсяСчет) Тогда
		Счет = Неопределено;
		СписокСчетов = Ложь;
	КонецЕсли; 
	
	// перезаполняем счета задолженности
	СтруктураСчетов = CW_Финансы.СтруктураСчетовРасчетов_Клиенты(Дата,Организация,ДС);
	ЕстьПеревыставление = Ложь;
	ЕстьСобственные = Ложь;
	Для каждого Стр Из Услуги Цикл
		
		Если (НЕ СписокСчетов) Тогда
			Стр.Счет = Неопределено;
		КонецЕсли;
		
		Стр.СчетЗадолженности = CW_Финансы.ОпределитьСчетУчетаДоходов(Стр,СтруктураСчетов,Валюта <> ДС.КО.ВалютарегламентированногоУчета,Договор.ВзаиморасчетыВУЕ);
		
		Если (Стр.ПорядокОтражения <> Перечисления.CW_ПорядокОтраженияДоходов.СобственнаяУслуга) Тогда
			ЕстьПеревыставление = Истина;
		Иначе
			ЕстьСобственные = Истина;
		КонецЕсли; 
		
		Если (КонтроллироватьДатыПеревыставления) Тогда
			
			Если (Стр.ПорядокОтражения = Перечисления.CW_ПорядокОтраженияДоходов.Перевыставление) Тогда
				
				Если (Стр.ДокументРасходов.Дата > СтаршаяДатаРасходов) Тогда
					СтаршаяДатаРасходов = Стр.ДокументРасходов.Дата;
				КонецЕсли; 
				
			КонецЕсли; 
			
		КонецЕсли; 
		
	КонецЦикла; 
	
	// нумерация документов
	ПолитикаНумерации = ДС.УП.ПорядокПрисвоенияНомеров;
	
	// если номер документ пустой - устанавливаем
	Если (СокрЛП(Номер) = "") Тогда	
		УстановитьНовыйНомер();	
	КонецЕсли; 
	
	//Если (НЕ Ссылка.Пустая()) Тогда
	//	
	//	Если ЗначениеЗаполнено(УдалитьСрокОплаты) Тогда
	//		
	//		СтруктураДанных = Новый Структура("Счет,ДатаОплаты,Описание", Ссылка, УдалитьСрокОплаты, УдалитьСрокОплатыОписание);
	//		Ответ = CW_Документы.УстановитьСрокОплаты(СтруктураДанных);
	//		
	//		УдалитьСрокОплаты = Дата(1,1,1);
	//		УдалитьСрокОплатыОписание = "";
	//		
	//	КонецЕсли;
	//	
	//КонецЕсли; 
	
	ФормироватьСчет = Ложь;
	ФормироватьАкт = Ложь;
	ФормироватьСчетФактуру = Ложь;
	
	// присвоение номеров и формирование ведомых документов
	Если (РежимЗаписи <> РежимЗаписиДокумента.ОтменаПроведения) Тогда
		
		// для внешнего нумератора
		Если (ПолитикаНумерации = Перечисления.CW_ПорядокПрисвоенияИсходящихНомеров.ВнешнийНумератор) Тогда
			ОбработкаНумерации = _ПО.ПолучитьОбработку(ДС.УП.ВнешнийНумератор);
		КонецЕсли;
		
		// проверяем номера
		Если (НЕ ПроверкаНомеров(ПровестиПоБухгалтерскомуУчету)) Тогда 
			Отказ = Истина; 
			Возврат; 
		КонецЕсли;
		
		Если (НЕ Корректировка) Тогда
			
			// номер счета
			Если (ФормируетсяСчет) Тогда
				
				_сф.УстановитьЕслиНезаполнено(ДатаСчета,Дата);
				
				// синхронизация времени
				Если (НачалоДня(ДатаСчета) = НачалоДня(Дата)) Тогда
					ДатаСчета = Дата;
				КонецЕсли; 
				
				// формирование счета при условии того, что по договору ведется бухгалтерский учет
				Если ПараметрыБухгалтерскогоУчета.БухгалтерскийУчет И ДС.УП.ФормироватьСчетаПокупателюНаОплату И ПровестиПоБухгалтерскомуУчету Тогда
					
					ФормироватьСчет = Истина;
					
					// если ссылка на документ "Счет" отсутствует, формирем новый документ,
					// иначе получаем ранее созданный
					Если ((ВедомыйСчет.Пустая()) ИЛИ (НЕ _СФ.ОбъектБДСуществует(ВедомыйСчет))) Тогда
						НовыйВедомыйСчет = Документы.СчетНаОплатуПокупателю.СоздатьДокумент(); 
						НовыйВедомыйСчет.Контрагент 	= Контрагент;
						НовыйВедомыйСчет.Комментарий 	= "Сформировано автоматически (CW) документом ""Доходы по грузоперевозке"" №"+Номер+" от "+СокрЛП(Дата);
					Иначе
						НовыйВедомыйСчет = ВедомыйСчет.ПолучитьОбъект();
						НовыйВедомыйСчет.ПометкаУдаления = Ложь;
					КонецЕсли; 
					
					НовыйВедомыйСчет.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийСчетаПокупателю.ТоварыИУслуги");
	
					// заполняем реквизиты счета  
					НовыйВедомыйСчет.Организация = Организация;
					//Удалено чтобы исключить дублирование номеров документов
					//НовыйВедомыйСчет.ОбменДанными.Загрузка = Истина;
					НовыйВедомыйСчет.Дата = ДатаСчета;
					
					НовыйВедомыйСчет.СуммаВключаетНДС = ЦенаСНДС;
					
					//Для версии КОРП
					Если ВестиУчетПоПодразделениям Тогда
						НовыйВедомыйСчет.ПодразделениеОрганизации = ПодразделениеОрганизации;
					КонецЕсли;
					//Для версии КОРП
					
					
					// присвоение номера счета
					Если (ЗначениеЗаполнено(НомерСчета)) Тогда
						НовыйВедомыйСчет.Номер = СокрЛП(НомерСчета);
					Иначе
						
						// для "сплошной" и "в пределах даты" ставим номер документа
						Если ПолитикаНумерации = Перечисления.CW_ПорядокПрисвоенияИсходящихНомеров.СплошнаяНумерация
							ИЛИ ПолитикаНумерации = Перечисления.CW_ПорядокПрисвоенияИсходящихНомеров.ВПределахДаты Тогда
							
							НовыйВедомыйСчет.Номер = СокрЛП(Номер);
							НомерСчета = Номер;
							
						КонецЕсли; 
						
						// для независимой просто получаем номер
						Если (ПолитикаНумерации = Перечисления.CW_ПорядокПрисвоенияИсходящихНомеров.НезависимаяНумерация) Тогда
							
							НовыйВедомыйСчет.УстановитьНовыйНомер();
							// --- 
							НомерСчета = НовыйВедомыйСчет.Номер;
							
						КонецЕсли;
						
						// внешний нумератор
						Если (ПолитикаНумерации = Перечисления.CW_ПорядокПрисвоенияИсходящихНомеров.ВнешнийНумератор) Тогда
							
							ОбработкаНумерации.УстановитьНомерСчета(ЭтотОбъект, НовыйВедомыйСчет);
							
						КонецЕсли; 
						
					КонецЕсли; 
					
					CW_Документы.ПеренестиПризнакВосстановленияПоследовательности(ЭтотОбъект,НовыйВедомыйСчет);
					
					// проверяем (пытаемся записать) на возможность записи документа с указанным номером,
					// если в процессе записи возникла ошибка, то выходим из процедуры
					Отказ = CW_Документы.ПроверкаНомера(НовыйВедомыйСчет, РежимЗаписиДокумента.Запись, ЭтотОбъект.Ссылка,Ложь);
					Если Отказ Тогда 
						Возврат; 
					КонецЕсли;
					
					// записываем ссылку на счет в документ
					ВедомыйСчет = НовыйВедомыйСчет.Ссылка;	
					
				// по договору не ведется бухгалтерский учет
				Иначе
					
					Если (НЕ ЗначениеЗаполнено(НомерСчета)) Тогда
						
						// для "сплошной" и "в пределах даты" ставим номер документа
						Если ПолитикаНумерации = Перечисления.CW_ПорядокПрисвоенияИсходящихНомеров.СплошнаяНумерация
							ИЛИ ПолитикаНумерации = Перечисления.CW_ПорядокПрисвоенияИсходящихНомеров.ВПределахДаты Тогда
							НомерСчета = Номер;
						ИначеЕсли ПолитикаНумерации = Перечисления.CW_ПорядокПрисвоенияИсходящихНомеров.ВнешнийНумератор Тогда
							
							ОбработкаНумерации.УстановитьНомерСчета(ЭтотОбъект);
							
						Иначе
							Сообщить("Автонумерация счетов для договоров без признака бухгалтерского учёта поддерживается только для типов нумерации ""Сплошная"" и ""В пределах даты""");
							Отказ = Истина;
							Возврат;
						КонецЕсли; // проверка на возможность автоматического присвоения номера 
					КонецЕсли; // номер счета не заполнен
				КонецЕсли; // проверка что по договору ведется БУ и нужно формировать счет
			КонецЕсли; // признак формирования счета установлен 
			
			// номер акта	
			Если (ФормируетсяАкт) Тогда
				
				_сф.УстановитьЕслиНезаполнено(ДатаАкта,Дата);
				
				// синхронизация времени
				Если (НачалоДня(ДатаАкта)=НачалоДня(Дата)) Тогда
					ДатаАкта = Дата;
				КонецЕсли;
				
				Если (ПровестиПоБухгалтерскомуУчету) Тогда
					
					ФормироватьАкт = Истина;
					
					ТребуетсяСозданиеВедомого = Ложь;
					Если (ВедомыйДокумент.Пустая()) Тогда
						ТребуетсяСозданиеВедомого = Истина;
					КонецЕсли; 
					
					Если (НЕ ТребуетсяСозданиеВедомого) Тогда
						Если (НЕ _СФ.ОбъектБДСуществует(ВедомыйДокумент)) Тогда
							ТребуетсяСозданиеВедомого = Истина;
						КонецЕсли; 
					КонецЕсли; 
					
					Если (НЕ ЭтоНовый() И НЕ ТребуетсяСозданиеВедомого) Тогда
						
						// проверяем, не связан ли он уже с другим ведущим
						Ведущий = CW_Документы.ПолучитьВедущийДокумент(ВедомыйДокумент);
						Если (Ведущий = Неопределено ИЛИ Ведущий <> Ссылка) Тогда
							ТребуетсяСозданиеВедомого = Истина;
							ВедомыйДокумент = Неопределено;
							ВедомыйСчетФактура = Неопределено;
						КонецЕсли; 
					КонецЕсли; 
					
					Если (ТребуетсяСозданиеВедомого) Тогда
						НовыйВедомый = Документы.РеализацияТоваровУслуг.СоздатьДокумент();
					Иначе
						НовыйВедомый = ВедомыйДокумент.ПолучитьОбъект();
						НовыйВедомый.ПометкаУдаления = Ложь;
					КонецЕсли;
					
					НовыйВедомый.Организация = Организация;
					НовыйВедомый.ОбменДанными.Загрузка=Истина;
					НовыйВедомый.Организация = Организация;
					НовыйВедомый.Дата = ДатаАкта;   
					
					НовыйВедомый.ЭтоУниверсальныйДокумент = ЭтоУниверсальныйДокумент;     
					
					НовыйВедомый.СопроводительныеДокументы = СопроводительныеДокументы;
					НовыйВедомый.СведенияОТранспортировкеИГрузе = СведенияОТранспортировкеИГрузе;
					
					//Для версии КОРП 
					Если ВестиУчетПоПодразделениям Тогда
						НовыйВедомый.ПодразделениеОрганизации = ПодразделениеОрганизации;
					КонецЕсли;
					//Для версии КОРП 
					
					Если (ЗначениеЗаполнено(НомерАкта)) Тогда
						НовыйВедомый.Номер = НомерАкта;
					Иначе
						
						// для "сплошной" и "в пределах даты" ставим номер документа
						Если ПолитикаНумерации = Перечисления.CW_ПорядокПрисвоенияИсходящихНомеров.СплошнаяНумерация
							ИЛИ ПолитикаНумерации = Перечисления.CW_ПорядокПрисвоенияИсходящихНомеров.ВПределахДаты 
							Тогда
							
							НовыйВедомый.Номер = СокрЛП(Номер);
							НомерАкта = Номер;
							
						КонецЕсли; 
						
						// для независимой просто получаем номер
						Если ПолитикаНумерации = Перечисления.CW_ПорядокПрисвоенияИсходящихНомеров.НезависимаяНумерация Тогда
							
							НовыйВедомый.УстановитьНовыйНомер();
							НомерАкта = НовыйВедомый.Номер;
							
						КонецЕсли;
						
						// внешний нумератор
						Если (ПолитикаНумерации = Перечисления.CW_ПорядокПрисвоенияИсходящихНомеров.ВнешнийНумератор) Тогда
							
							ОбработкаНумерации.УстановитьНомерАкта(ЭтотОбъект, НовыйВедомый);

						КонецЕсли; 
						
					КонецЕсли; 
					
					// проверим на возможность записи акта с данным номером 
					CW_Документы.ПеренестиПризнакВосстановленияПоследовательности(ЭтотОбъект,НовыйВедомый);
					Отказ = CW_Документы.ПроверкаНомера(НовыйВедомый, РежимЗаписиДокумента.Запись, ЭтотОбъект, Ложь);
					Если Отказ Тогда 
						Возврат; 
					КонецЕсли;
					ВедомыйДокумент = НовыйВедомый.Ссылка;
					
					// номер счета-фактуры 
					Если (ФормируетсяСчетФактура) Тогда
						
						ФормироватьСчетФактуру = Истина;
						
						// если по каким-то причинам ссылка на счет-фактуру не была записана в ведущий документ
						Если (ВедомыйСчетФактура.Пустая()) Тогда
							ВедомыйСФ = CW_Финансы.НайтиВыданнуюСчетФактуру(ВедомыйДокумент);
							Если (ВедомыйСФ <> Неопределено) Тогда
								ВедомыйСчетФактура = ВедомыйСФ;
							КонецЕсли; 
						КонецЕсли; 
						
						// счет-фактура отсутствует
						Если (ВедомыйСчетФактура.Пустая() ИЛИ (НЕ _СФ.ОбъектБДСуществует(ВедомыйСчетФактура))) Тогда
							_сф.УстановитьЕслиНезаполнено(ДатаСчетаФактуры,ДатаАкта);
							НовыйСФ = Документы.СчетФактураВыданный.СоздатьДокумент(); 
						Иначе
							НовыйСФ = ВедомыйСчетФактура.ПолучитьОбъект();	
							Если НовыйСФ.ПометкаУдаления Тогда
								НовыйСФ.УстановитьПометкуУдаления(Ложь);
							КонецЕсли;
						КонецЕсли;
						
						НовыйСФ.Ответственный = Ответственный;

