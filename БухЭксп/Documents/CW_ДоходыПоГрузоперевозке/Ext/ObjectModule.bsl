Процедура ЗаполнитьАвансы(ДатаПодбораАвансов,БУ,ОЗ) Экспорт 
	// --- 
	
	Если (БУ) Тогда
		
		ТЧ = ЗачетАвансов;
		
	Иначе
		
		ТЧ = ЗачетАвансовОЗ;
		
	КонецЕсли; 
	
	ДС = ДополнительныеСвойства;
	Счета = CW_Конфигурация.ПланСчетов(); 		
	ТЧ.Очистить();
		
	УслугиПоПорядкуОтражения = Услуги.Выгрузить();
	УслугиПоПорядкуОтражения.Свернуть("ПорядокОтражения", "Всего");
	 
	// определяем счета авансов
	Если (Валюта = ДС.КО.ВалютаРегламентированногоУчета) Тогда
		
		СчетРасчетов = ДС.УП.СчетРасчетов_Клиенты_Рубли;
		Если СчетРасчетов = Счета.РасчетыСПокупателями Тогда
			СчетЗадолженностиПоСобственным = СчетРасчетов;
			СчетЗадолженностиПоВозмещаемым = СчетРасчетов;
			СчетАвансовПоСобственным = Счета.РасчетыПоАвансамПолученным;						
			СчетАвансовПоВозмещаемым = Счета.РасчетыПоАвансамПолученным;
		Иначе
			СчетЗадолженностиПоСобственным = Счета.РасчетыСПокупателями;
			СчетЗадолженностиПоВозмещаемым = СчетРасчетов;
			СчетАвансовПоСобственным = Счета.РасчетыПоАвансамПолученным;						
			СчетАвансовПоВозмещаемым = СчетРасчетов;
		КонецЕсли; 
		
	Иначе
		
		// Валюта
		Если (НЕ Договор.ВзаиморасчетыВУЕ) Тогда
			СчетРасчетов = ДС.УП.СчетРасчетов_Клиенты_Валюта;
			Если СчетРасчетов = Счета.РасчетыСПокупателямиВал Тогда
				СчетАвансовПоСобственным = Счета.РасчетыПоАвансамПолученнымВал;						
				СчетАвансовПоВозмещаемым = Счета.РасчетыПоАвансамПолученнымВал;
			Иначе
				СчетАвансовПоСобственным = Счета.РасчетыПоАвансамПолученнымВал;						
				СчетАвансовПоВозмещаемым = СчетРасчетов;
			КонецЕсли;
		КонецЕсли;
		
		// УЕ
		Если (Договор.ВзаиморасчетыВУЕ) Тогда
			СчетРасчетов = ДС.УП.СчетРасчетов_Клиенты_УЕ;
			Если СчетРасчетов = Счета.РасчетыСПокупателямиУЕ Тогда
				СчетАвансовПоСобственным = Счета.РасчетыПоАвансамПолученнымУЕ;						
				СчетАвансовПоВозмещаемым = Счета.РасчетыПоАвансамПолученнымУЕ;
			Иначе
				СчетАвансовПоСобственным = Счета.РасчетыПоАвансамПолученнымУЕ;						
				СчетАвансовПоВозмещаемым = СчетРасчетов;
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли; 
	
	ПараметрыТА = Новый Структура("Дата,Договор,ОЗ,РаздельныйУчетЗаполженности,Акт,ПереплатаКакАванс");
	// --- 
	ПараметрыТА.Дата = ДатаПодбораАвансов;
	ПараметрыТА.Договор = Договор;
	ПараметрыТА.ОЗ = ДС.УП.ОЗ;
	ПараметрыТА.Акт = Ссылка;
	ПараметрыТА.РаздельныйУчетЗаполженности = ДС.УП.РаздельныйУчетОперативнойИБухгалтерскойЗадолженности;
	ПараметрыТА.ПереплатаКакАванс 			= ДС.УП.УчитыватьПереплатыПоДокументамКакАванс;
	
	//Подсистема.УчетПриложенийДоговоров
	ПараметрыТА.Вставить("ПриложениеКДоговору",ПриложениеКДоговору);
	//Подсистема.УчетПриложенийДоговоров
	
	// --- 
	ТЗ_Услуги = Услуги.Выгрузить();
	Если (ПараметрыТА.ОЗ) Тогда
		Если (НЕ СписокСчетов) Тогда
			Если (ЗначениеЗаполнено(Счет)) Тогда
				ТЗ_Услуги.ЗаполнитьЗначения(Счет,"Счет");
			Иначе
				ТЗ_Услуги.ЗаполнитьЗначения(Ссылка,"Счет");
			КонецЕсли; 
		КонецЕсли; 
	КонецЕсли; 
	Если (БУ) Тогда
		ТаблицаАвансов = CW_Финансы.ТаблицаАвансов(ПараметрыТА,ТЗ_Услуги,ТЧ.Выгрузить(),ЗачетАвансовОЗ.Выгрузить());	
	ИначеЕсли (ОЗ) Тогда 
		ТаблицаАвансов = CW_Финансы.ТаблицаАвансовДляОЗ(ПараметрыТА,ТЗ_Услуги,ТЧ.Выгрузить());
	КонецЕсли; 
	
	ТолькоПоПлатежкамСчетов = ПараметрыТА.ОЗ и НЕ ПараметрыТА.РаздельныйУчетЗаполженности;
	//ДС.ПД.АвтоматическиЗачитыватьТолькоПлатежкиПоСчету;
	// --- 
	МассивСчетовАвансов = Новый Массив;
	Если (СчетАвансовПоВозмещаемым = СчетАвансовПоСобственным) Тогда
		МассивСчетовАвансов.Добавить(СчетАвансовПоСобственным);
	Иначе
		МассивСчетовАвансов.Добавить(СчетАвансовПоСобственным);
		МассивСчетовАвансов.Добавить(СчетАвансовПоВозмещаемым);
	КонецЕсли; 
	// --- 
	СуммаСобственных 	= УслугиПоПорядкуОтражения.Скопировать(Новый Структура("ПорядокОтражения",Перечисления.CW_ПорядокОтраженияДоходов.СобственнаяУслуга)).Итог("Всего");
	СуммаПрочих 		= УслугиПоПорядкуОтражения.Скопировать(Новый Структура("ПорядокОтражения",Перечисления.CW_ПорядокОтраженияДоходов.ПрочиеДоходы)).Итог("Всего");
	
	СуммаСобственные 	= СуммаСобственных + СуммаПрочих;
	СуммаВозмещаемые 	= УслугиПоПорядкуОтражения.Итог("Всего") - СуммаСобственные;
	
	// распределение
	Для каждого СчетАванса Из МассивСчетовАвансов Цикл
		// --- 
		
		Если (СчетАвансовПоВозмещаемым = СчетАвансовПоСобственным) Тогда
			
			ТаблицаАнализа = ТаблицаАвансов;
			// --- 
			СуммаАванса = _сф.Итог(ТаблицаАвансов,"Аванс");
			СуммаРаспределения = _сф.Итог(УслугиПоПорядкуОтражения,"Всего");
			
		Иначе
			
			Если (СчетАванса = СчетАвансовПоСобственным) Тогда
				
				Отбор = Новый Структура("СчетАванса",СчетАванса);
				ТаблицаАнализа = ТаблицаАвансов.Скопировать(Отбор);
				// --- 
				СуммаАванса = _сф.Итог(ТаблицаАнализа,"Аванс");
				СуммаРаспределения = СуммаСобственные;					             					
				
			Иначе
				
				Отбор = Новый Структура("СчетАванса",СчетАванса);
				ТаблицаАнализа = ТаблицаАвансов.Скопировать(Отбор);
				// --- 
				СуммаАванса = _сф.Итог(ТаблицаАнализа,"Аванс");
				СуммаРаспределения = СуммаВозмещаемые;	
				
			КонецЕсли; 
			
		КонецЕсли; 
		// --- 
		ОстатокРаспределения = Мин(СуммаРаспределения,СуммаАванса);
		ОстаткиЗачетаПоАктированию = Новый СписокЗначений;
		Для каждого Стр Из ТаблицаАнализа Цикл
			
			Если (ОстатокРаспределения <= 0) Тогда Прервать; КонецЕсли;
			
			Если (БУ И ТолькоПоПлатежкамСчетов И Стр.ПризнакОплатыСчетовДокумента <> Истина) Тогда
				Продолжить;
			КонецЕсли; 
			
			Нстр = ТЧ.Добавить();
			// --- 
			Нстр.ДокументАванса = Стр.ДокументАванса;
			Нстр.ДокументОплаты = Стр.ДокументОплаты;
			Нстр.СчетАванса = Стр.СчетАванса;
			Нстр.СчетЗадолженности = Стр.СчетЗадолженности;
			// --- 
			Если (БУ) Тогда
				Нстр.Счет = Стр.Счет;
				Если (ТолькоПоПлатежкамСчетов) Тогда
					ОстатокЗадолженности = ОстаткиЗачетаПоАктированию.НайтиПоЗначению(Стр.Счет);
					Если (ОстатокЗадолженности = Неопределено) Тогда
						ОстатокЗадолженности = ОстаткиЗачетаПоАктированию.Добавить(Стр.Счет, Формат(Стр.Задолженность,"ЧН=; ЧГ="));
					КонецЕсли;
					НезачтенноеАктированноеСальдо = Число(ОстатокЗадолженности.Представление);
					Нстр.СуммаЗачета = Мин(ОстатокРаспределения,Стр.Аванс,НезачтенноеАктированноеСальдо);
					ОстатокЗадолженности.Представление = Формат(НезачтенноеАктированноеСальдо-Нстр.СуммаЗачета,"ЧН=; ЧГ=");
				Иначе
					Нстр.СуммаЗачета = Мин(ОстатокРаспределения,Стр.Аванс);
				КонецЕсли; 
			Иначе
				Нстр.СуммаЗачета = Мин(ОстатокРаспределения,Стр.Аванс);
			КонецЕсли; 
			// --- 
			_сф.Декремент(ОстатокРаспределения,Нстр.СуммаЗачета);
			Если (Нстр.СуммаЗачета = 0) Тогда
				ТЧ.Удалить(Нстр);
			КонецЕсли; 
			
		КонецЦикла; 

		// --- 
	КонецЦикла; 
	
	// сформируем текстовое представление платежки в ТЧ зачета авансов
	Для Каждого Стр Из ТЧ Цикл
		
		Попытка
			
			Если (БУ) Тогда
				
				Если НЕ Стр.ДокументАванса.НомерВходящегоДокумента = "" Тогда
					ВхНомер = Строка(Стр.ДокументАванса.НомерВходящегоДокумента);
				Иначе
					ВхНомер = "";
				КонецЕсли;	
				
				Если НЕ Стр.ДокументАванса.ДатаВходящегоДокумента = Дата("00010101") Тогда
					ВхДата = Строка(Формат(Стр.ДокументАванса.ДатаВходящегоДокумента,"ДФ=dd.MM.yyyy"));
				Иначе
					ВхДата = "";
				КонецЕсли;
				
				Если ВхНомер = "" ИЛИ ВхДата = "" Тогда
					Стр.ПредставлениеДокументаАванса = "Не задан!" ;
				Иначе
					Стр.ПредставлениеДокументаАванса = "№" + ВхНомер + " от " + ВхДата;
				КонецЕсли;	 
				
			ИначеЕсли (ОЗ) Тогда 
				
				Стр.ПредставлениеДокументаАванса = Стр.ДокументОплаты.ПредставлениеДокумента; 
				
			КонецЕсли; 
			
		Исключение
			
			// если аналитика заполнена
			Если ЗначениеЗаполнено(Стр.ДокументАванса) Тогда 
				
				Стр.ПредставлениеДокументаАванса = "№" + Строка(Стр.ДокументАванса.Номер) + " от " +  Формат(Стр.ДокументАванса.Дата, "ДЛФ=Д"); 
				
			// если документ не определен
			Иначе
				Стр.ПредставлениеДокументаАванса = Строка(Стр.ДокументАванса);	
			КонецЕсли;
			
		КонецПопытки	
		
	КонецЦикла;	
	
	// --- 
КонецПроцедуры

Функция ПроверкаНомеров(ПровестиПоБухгалтерскомуУчету)
	
	Если (НЕ ПровестиПоБухгалтерскомуУчету) Тогда
		
		Возврат(Истина);
		
	КонецЕсли; 
	
	ТребуетсяКонтрольСчета = Ложь;
	ТребуетсяКонтрольАкта = Ложь;
	ТребуетсяКонтрольСФ = Ложь;
	
	// анализируем, что мы можем проверить
	
	Если (ДС.УП.ПорядокПрисвоенияНомеров = Перечисления.CW_ПорядокПрисвоенияИсходящихНомеров.СплошнаяНумерация
		ИЛИ ДС.УП.ПорядокПрисвоенияНомеров = Перечисления.CW_ПорядокПрисвоенияИсходящихНомеров.ВПределахДаты) Тогда
		
		ТребуетсяКонтрольСчета = (ФормируетсяСчет);
		Если (ТребуетсяКонтрольСчета) Тогда
			НомерСчетаДляКонтроля = ?(ЗначениеЗаполнено(НомерСчета),НомерСчета,Номер);	
			ДатаСчетаДляКонтроля = ?(ЗначениеЗаполнено(ДатаСчета),ДатаСчета,Дата);
		КонецЕсли; 
		// --- 
		ТребуетсяКонтрольАкта = (ФормируетсяАкт);
		Если (ТребуетсяКонтрольАкта) Тогда
			НомерАктаДляКонтроля = ?(ЗначениеЗаполнено(НомерАкта),НомерАкта,Номер);
			ДатаАктаДляКонтроля = ?(ЗначениеЗаполнено(ДатаАкта),ДатаАкта,Дата);
		КонецЕсли;  
		// --- 
		ТребуетсяКонтрольСФ = (ФормируетсяАкт И ФормируетсяСчетФактура);
		Если (ТребуетсяКонтрольСФ) Тогда
			НомерСФДляКонтроля = ?(ЗначениеЗаполнено(НомерСчетаФактуры),НомерСчетаФактуры,Номер);
			ДатаСФДляКонтроля = ?(ЗначениеЗаполнено(ДатаСчетаФактуры),ДатаСчетаФактуры,?(ЗначениеЗаполнено(ДатаАкта),ДатаАкта,Дата));
		КонецЕсли; 
		
	КонецЕсли;
	
	Если (ДС.УП.ПорядокПрисвоенияНомеров = Перечисления.CW_ПорядокПрисвоенияИсходящихНомеров.НезависимаяНумерация) Тогда
		
		ТребуетсяКонтрольСчета = (ФормируетсяСчет И ЗначениеЗаполнено(НомерСчета) И ЗначениеЗаполнено(ДатаСчета));
		Если (ТребуетсяКонтрольСчета) Тогда
			НомерСчетаДляКонтроля = НомерСчета;	
			ДатаСчетаДляКонтроля = ДатаСчета;
		КонецЕсли; 
		ТребуетсяКонтрольАкта = (ФормируетсяАкт И ЗначениеЗаполнено(НомерАкта) И ЗначениеЗаполнено(ДатаАкта));
		Если (ТребуетсяКонтрольАкта) Тогда
			НомерАктаДляКонтроля = НомерАкта;
			ДатаАктаДляКонтроля = ДатаАкта;
		КонецЕсли;
		ТребуетсяКонтрольСФ = ФормируетсяАкт И ФормируетсяСчетФактура И ЗначениеЗаполнено(НомерСчетаФактуры) И ЗначениеЗаполнено(ДатаСчетаФактуры) И ВидОперацииКорректировки <> ПредопределенноеЗначение("Перечисление.ВидыОперацийИсправленияПоступленияРеализации.ИсправлениеОшибки");
		Если (ТребуетсяКонтрольСФ) Тогда
			НомерСФДляКонтроля 	= НомерСчетаФактуры;
			ДатаСФДляКонтроля 	= ДатаСчетаФактуры;
		КонецЕсли; 
		
	КонецЕсли; 
		
	Если (ТребуетсяКонтрольСчета) Тогда
		
		НомерСчетаУникальный = Ложь;
		Запрос = Новый Запрос("ВЫБРАТЬ 
							  |	СчетНаОплатуПокупателю.Ссылка КАК Ссылка
		                      |ИЗ
		                      |	Документ.СчетНаОплатуПокупателю КАК СчетНаОплатуПокупателю
		                      |ГДЕ
		                      |	СчетНаОплатуПокупателю.Номер = &Номер
		                      |	И ГОД(СчетНаОплатуПокупателю.Дата) = &Год
		                      |	И СчетНаОплатуПокупателю.Ссылка <> &ВедомыйСчет
		                      |	И СчетНаОплатуПокупателю.Организация = &Организация");
		
		Запрос.УстановитьПараметр("Номер", НомерСчетаДляКонтроля);
		Запрос.УстановитьПараметр("Год", Год(ДатаСчетаДляКонтроля));
		Запрос.УстановитьПараметр("ВедомыйСчет", ВедомыйСчет);
		Запрос.УстановитьПараметр("Организация", ВедомыйСчет.Организация);
		
		РезультатЗапроса = Запрос.Выполнить();
		Если РезультатЗапроса.Пустой() Тогда
			НомерСчетаУникальный = Истина;
		Иначе
			ПредтавлениеОшибки = "";
			
			Выборка = РезультатЗапроса.Выбрать();
			Пока Выборка.Следующий() Цикл
				ПредтавлениеОшибки = СокрЛП(Выборка.Ссылка);
			КонецЦикла;
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Обнаружены счета: "+ Символы.ПС + ПредтавлениеОшибки);
			
		КонецЕсли;
		
	Иначе
		
		НомерСчетаУникальный = Истина;
		
	КонецЕсли; 
	
	Если (ТребуетсяКонтрольАкта) Тогда
		
		НомерРеализацииУникальный = Ложь;
		// --- 
		Если (НЕ Корректировка) Тогда
			Запрос = Новый Запрос("ВЫБРАТЬ
			                      |	РеализацияТоваровУслуг.Номер КАК Номер,
			                      |	РеализацияТоваровУслуг.Дата КАК Дата,
			                      |	РеализацияТоваровУслуг.Ссылка КАК Ссылка
			                      |ИЗ
			                      |	Документ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг
			                      |ГДЕ
			                      |	РеализацияТоваровУслуг.Номер = &Номер
			                      |	И РеализацияТоваровУслуг.Ссылка <> &ВедомыйАкт
			                      |	И ГОД(РеализацияТоваровУслуг.Дата) = &Год
			                      |	И РеализацияТоваровУслуг.Организация = &Организация");
			Запрос.УстановитьПараметр("ВедомыйАкт", ВедомыйДокумент);
			Запрос.УстановитьПараметр("Организация", ВедомыйДокумент.Организация);
		
		Иначе
			Запрос = Новый Запрос("ВЫБРАТЬ
			                      |	КорректировкаРеализации.Номер КАК Номер,
			                      |	КорректировкаРеализации.Дата КАК Дата,
			                      |	КорректировкаРеализации.Ссылка КАК Ссылка
			                      |ИЗ
			                      |	Документ.КорректировкаРеализации КАК КорректировкаРеализации
			                      |ГДЕ
			                      |	КорректировкаРеализации.Номер = &Номер
			                      |	И КорректировкаРеализации.Ссылка <> &ВедомыйАкт
			                      |	И ГОД(КорректировкаРеализации.Дата) = &Год
			                      |	И КорректировкаРеализации.Организация = &Организация");
			Запрос.УстановитьПараметр("ВедомыйАкт", ВедомыйДокументКорректировки);
			Запрос.УстановитьПараметр("Организация", ВедомыйДокументКорректировки.Организация);
		КонецЕсли; 
		Запрос.УстановитьПараметр("Номер", НомерАктаДляКонтроля);
		Запрос.УстановитьПараметр("Год", Год(ДатаАктаДляКонтроля));
		
		РезультатЗапроса = Запрос.Выполнить();
		Если РезультатЗапроса.Пустой() Тогда
			НомерРеализацииУникальный = Истина;
		Иначе
			ПредтавлениеОшибки = "";
			
			Выборка = РезультатЗапроса.Выбрать();
			Пока Выборка.Следующий() Цикл
				ПредтавлениеОшибки = СокрЛП(Выборка.Ссылка);
			КонецЦикла;
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Обнаружены документы реализации: "+ Символы.ПС +ПредтавлениеОшибки);
			
		КонецЕсли;
			
	Иначе
		
		НомерРеализацииУникальный = Истина;
		
	КонецЕсли; 
	
	Если (ТребуетсяКонтрольСФ) Тогда
		
		НомерСФУникальный = Ложь;
		Запрос = Новый Запрос("ВЫБРАТЬ
		                      |	СчетФактураВыданный.Ссылка КАК Ссылка
		                      |ИЗ
		                      |	Документ.СчетФактураВыданный КАК СчетФактураВыданный
		                      |ГДЕ
		                      |	СчетФактураВыданный.Номер = &Номер
		                      |	И ГОД(СчетФактураВыданный.Дата) = &Год
		                      |	И СчетФактураВыданный.ДокументОснование <> &ВедомыйАкт
		                      |	И СчетФактураВыданный.Ссылка <> &СчетФактура
		                      |	И СчетФактураВыданный.Организация = &Организация");
		
		Запрос.УстановитьПараметр("Год", Год(ДатаСФДляКонтроля));
		Если (НЕ Корректировка) Тогда
			Запрос.УстановитьПараметр("Номер", 		 НомерСФДляКонтроля);
			Запрос.УстановитьПараметр("ВедомыйАкт",  ВедомыйДокумент);	
			Запрос.УстановитьПараметр("СчетФактура", ВедомыйСчетФактура);
			Запрос.УстановитьПараметр("Организация", ВедомыйСчетФактура.Организация);
		Иначе
			Запрос.УстановитьПараметр("Номер", 		 ВедомыйСчетФактураКорректировочный.Номер);
			Запрос.УстановитьПараметр("ВедомыйАкт",  ВедомыйДокументКорректировки);
			Запрос.УстановитьПараметр("СчетФактура", ВедомыйСчетФактураКорректировочный);
			Запрос.УстановитьПараметр("Организация", ВедомыйСчетФактураКорректировочный.Организация);
		КонецЕсли; 
		
		РезультатЗапроса = Запрос.Выполнить();
		Если РезультатЗапроса.Пустой() Тогда
			НомерСФУникальный = Истина;
		Иначе
			ПредтавлениеОшибки = "";
			
			Выборка = РезультатЗапроса.Выбрать();
			Пока Выборка.Следующий() Цикл
				ПредтавлениеОшибки = СокрЛП(Выборка.Ссылка);
			КонецЦикла;
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Обнаружены счета-фактуры: " + Символы.ПС + ПредтавлениеОшибки);
			
		КонецЕсли;

	Иначе
		
		НомерСФУникальный = Истина;
		
	КонецЕсли; 
	
	Возврат(НомерРеализацииУникальный И НомерСФУникальный И НомерСчетаУникальный);

КонецФункции	

Функция ПроверитьЗакрытиеГрузоперевозок() Экспорт 
	// --- 
	
	Возврат(CW_Мониторинг.ПроверитьЗакрытиеГрузоперевозок(ЭтотОбъект));
	
	// --- 
КонецФункции

//УСТАРЕЛА. Следует использовать функцию АвтоматическийПодборСчетов(ВариантПодбора)
Функция ВыполнитьАвтоматическийПодборСчетов(ВариантПодбора) Экспорт
	// --- 
	
	Объект = ЭтотОбъект;  
	
	СтруктураНастроек  = CW_Настройки.ПолучитьНастройкиОперативногоУчета(Организация,Перечисления.CW_ВидыОперативнойЗадолженности.Дебиторская, Дата); 
	ИспользуетсяОперативнаяЗадолженность = СтруктураНастроек["ВедетсяОперативныйУчет"];
	РежимВводначальныхОстатков_ОЗ 		 = СтруктураНастроек["ВводОстатков"];
	
	НастройкиОперативногоУчета = СтруктураНастроек["НастройкиОперативногоУчета"]; 
	КонтрольНоменклатуры 		= НастройкиОперативногоУчета["КонтрольНоменклатуры"];
	КонтрольПорядкаОтражения 	= НастройкиОперативногоУчета["КонтрольПорядкаОтражения"];
	КонтрольНДС 				= НастройкиОперативногоУчета["КонтрольНДС"];
	
	Если НЕ ИспользуетсяОперативнаяЗадолженность Тогда
		
		Возврат(_УФКС.Ответ(1,"Не используется оперативная задолжненность"));
		
	КонецЕсли; 
	
	// ---------------------------------------------------------------------------- 
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	CW_АктированиеИсходящихСчетовОстатки.Счет,
	               |	CW_АктированиеИсходящихСчетовОстатки.ВсегоОстаток КАК Всего,
	               |	ЛОЖЬ КАК ЕстьСтроки,
	               |	CW_АктированиеИсходящихСчетовОстатки.Грузоперевозка,
	               |	CW_АктированиеИсходящихСчетовОстатки.Номенклатура,
	               |	CW_АктированиеИсходящихСчетовОстатки.ПорядокОтражения,
	               |	CW_АктированиеИсходящихСчетовОстатки.СтавкаНДС
	               |ИЗ
	               |	РегистрНакопления.CW_АктированиеИсходящихСчетов.Остатки(
	               |			&Период,
	               |			Организация = &Организация
	               |				И Контрагент = &Контрагент
	               |				И Договор = &Договор
	               |				И Грузоперевозка = &Грузоперевозка
	               |				И ВЫБОР
	               |					КОГДА &Номенклатура = НЕОПРЕДЕЛЕНО
	               |						ТОГДА ИСТИНА
	               |					ИНАЧЕ Номенклатура = &Номенклатура
	               |				КОНЕЦ
	               |				И ВЫБОР
	               |					КОГДА &ПорядокОтражения = НЕОПРЕДЕЛЕНО
	               |						ТОГДА ИСТИНА
	               |					ИНАЧЕ ПорядокОтражения = &ПорядокОтражения
	               |				КОНЕЦ
	               |				И ВЫБОР
	               |					КОГДА &СтавкаНДС = НЕОПРЕДЕЛЕНО
	               |						ТОГДА ИСТИНА
	               |					ИНАЧЕ СтавкаНДС = &СтавкаНДС
	               |				КОНЕЦ) КАК CW_АктированиеИсходящихСчетовОстатки
	               |ГДЕ
	               |	CW_АктированиеИсходящихСчетовОстатки.ВсегоОстаток > 0
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	CW_АктированиеИсходящихСчетовОстатки.Счет.ДатаСчета";
	Если (ВариантПодбора = 0) Тогда
		Запрос.УстановитьПараметр("Период", ТекущаяДата());
	Иначе
		Запрос.УстановитьПараметр("Период", Объект.ДатаАкта);
	КонецЕсли; 
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	Запрос.УстановитьПараметр("Контрагент", Объект.Контрагент);
	Запрос.УстановитьПараметр("Договор", Объект.Договор); 
	// --- 
	ТЗУслуги = Объект.Услуги.Выгрузить();
	ТЗУслуги.Колонки.Добавить("СчетПодобран");
	ТЗУслуги.ЗаполнитьЗначения(Ложь,"СчетПодобран");
	
	// --- 
	
	ТаблицаОстатковАктирования = Неопределено;
	// --- 
	
	Для каждого СтрокаДокумента Из ТЗУслуги Цикл
		
		Запрос.УстановитьПараметр("Грузоперевозка", СтрокаДокумента.Грузоперевозка); 
		Запрос.УстановитьПараметр("Номенклатура", ?(КонтрольНоменклатуры,СтрокаДокумента.Номенклатура,Неопределено)); 	
		Запрос.УстановитьПараметр("ПорядокОтражения", ?(КонтрольПорядкаОтражения,СтрокаДокумента.ПорядокОтражения,Неопределено)); 	
		Запрос.УстановитьПараметр("СтавкаНДС", ?(КонтрольНДС,СтрокаДокумента.СтавкаНДС,Неопределено)); 	
		// --- 
		
		Отбор = Новый Структура;
		Отбор.Вставить("Грузоперевозка",СтрокаДокумента.Грузоперевозка);
		Если (КонтрольНоменклатуры) Тогда
			Отбор.Вставить("Номенклатура",СтрокаДокумента.Номенклатура);
		КонецЕсли; 
		Если (КонтрольПорядкаОтражения) Тогда
			Отбор.Вставить("ПорядокОтражения",СтрокаДокумента.ПорядокОтражения);
		КонецЕсли; 
		Если (КонтрольНДС) Тогда
			Отбор.Вставить("СтавкаНДС",СтрокаДокумента.СтавкаНДС);
		КонецЕсли; 
		
		// --- 
		
		ПоДаннымЗапроса = Ложь;
		
		Если (ТаблицаОстатковАктирования = Неопределено) Тогда
			ТЗ = Запрос.Выполнить().Выгрузить();
			ПоДаннымЗапроса = Истина;
			ТаблицаОстатковАктирования = ТЗ.СкопироватьКолонки();	
		Иначе
			// пробуем найти
			ТЗ = ТаблицаОстатковАктирования.НайтиСтроки(Отбор);
			Если (ТЗ.Количество() = 0) Тогда
				ТЗ = Запрос.Выполнить().Выгрузить();
				ПоДаннымЗапроса = Истина;
			КонецЕсли; 
		КонецЕсли; 
		
		Если (ПоДаннымЗапроса) Тогда
			
			МассивУдаления = Новый Массив;
			Для каждого Стр Из ТЗ Цикл
				Если (Стр.Счет.Пустая()) Тогда
					МассивУдаления.Добавить(Стр);
				КонецЕсли; 
			КонецЦикла; 
			_сф.к_УдалитьЭлементыПоМассиву(ТЗ,МассивУдаления);
			
			// --- 
			
			// переносим в таблицу остатков
			Для каждого Стр Из ТЗ Цикл
				Нстр = ТаблицаОстатковАктирования.Добавить();
				ЗаполнитьЗначенияСвойств(Нстр,Стр);
			КонецЦикла; 
			
		КонецЕсли; 
		
		// --- 
		
		КоличествоСтрок = ТЗ.Количество();
		Если (КоличествоСтрок = 1) Тогда
			
			// подставляем счет
			Если (СтрокаДокумента.Всего <= ТЗ[0].Всего) Тогда
				
				СтрокаДокумента.Счет = ТЗ[0].Счет;
				СтрокаДокумента.СчетПодобран = Истина;
				// --- 
				_сф.Декремент(ТЗ[0].Всего,СтрокаДокумента.Всего);
				
			КонецЕсли; 
			
		ИначеЕсли (КоличествоСтрок > 1) Тогда 
			
			// анализируем, ищем строку
			СчетПодобран = Ложь;
			Для каждого СтрокаТЗ Из ТЗ Цикл
				
				Если (СчетПодобран) Тогда
					Прервать;
				КонецЕсли; 
				
				Отбор = Новый Структура("Грузоперевозка,Номенклатура",СтрокаДокумента.Грузоперевозка,СтрокаДокумента.Номенклатура);
				УдовлетворяющиеСтроки = _сф.к_НайтиСтроки(СтрокаТЗ.Счет.Услуги,Отбор);
				Если (УдовлетворяющиеСтроки.Количество()<>0) Тогда
					
					Для каждого Стр Из УдовлетворяющиеСтроки Цикл
						
						Если (Стр.Всего >= СтрокаДокумента.Всего) Тогда
							СтрокаТЗ.ЕстьСтроки = Истина;
						КонецЕсли; 
						
						Если (Стр.Всего = СтрокаДокумента.Всего) Тогда
							
							СтрокаДокумента.Счет = СтрокаТЗ.Счет;
							СтрокаДокумента.СчетПодобран = Истина;
							_сф.Декремент(СтрокаТЗ.Всего,СтрокаДокумента.Всего);
							СчетПодобран = Истина;
							Продолжить;
							
						КонецЕсли; 
						
					КонецЦикла; 
					
				КонецЕсли; 
				
			КонецЦикла; 
			
			Если (НЕ СчетПодобран) Тогда
				
				// берем первую строку из таблицы с соответствующими строками
				ЕстьСтроки = Ложь;
				Для каждого Стр Из ТЗ Цикл
					
					Если (Стр.ЕстьСтроки) Тогда
						ЕстьСтроки = Истина;
						Прервать;
					КонецЕсли; 
					
				КонецЦикла; 
				
				Если (ЕстьСтроки) Тогда
					
					// подставляем счет
					Для каждого Стр Из ТЗ Цикл
						
						Если (Стр.ЕстьСтроки) Тогда
							
							Если (Стр.Всего >= СтрокаДокумента.Всего) Тогда
								
								СтрокаДокумента.Счет = Стр.Счет;
								СтрокаДокумента.СчетПодобран = Истина;	
								// --- 
								_сф.Декремент(Стр.Всего, СтрокаДокумента.Всего);
								
							КонецЕсли; 
							
						КонецЕсли; 
						
					КонецЦикла; 
					
				Иначе
					
					Если (ТЗ[0].Всего >= СтрокаДокумента.Всего) Тогда
						
						СтрокаДокумента.Счет = ТЗ[0].Счет;
						СтрокаДокумента.СчетПодобран = Истина;
						// --- 
						_сф.Декремент(ТЗ[0].Всего,СтрокаДокумента.Всего);
						
					КонецЕсли; 
					
				КонецЕсли; 
				
			КонецЕсли; 
			
		КонецЕсли; 
		
	КонецЦикла; 
	
	// анализируем и переносим найденные счета в 
	КоличествоНеподобранных = ТЗУслуги.Скопировать(Новый Структура("СчетПодобран",Ложь)).Количество();
	
	КолонкаСчетов = ТЗУслуги.Скопировать(,"Счет");
	КолонкаСчетов.Свернуть("Счет");
	Счета = КолонкаСчетов.ВыгрузитьКолонку("Счет");
	
	Если (Счета.Количество()=1 И КоличествоНеподобранных = 0) Тогда
		
		Объект.СписокСчетов = Ложь;
		Объект.Счет = Счета[0];
		
	Иначе
		
		Объект.СписокСчетов = Истина;
		Объект.Счет = Документы.CW_ДоходыПоГрузоперевозке.ПустаяСсылка();
		// --- 
		// переносим в ТЧ
		ВТЧ = Объект.Услуги.Выгрузить();
		ВТЧ.ЗагрузитьКолонку(ТЗУслуги.ВыгрузитьКолонку("Счет"),"Счет");
		Объект.Услуги.Загрузить(ВТЧ);
		
	КонецЕсли; 
	// --- 
	ТекстСообщения = "";
	Если (КоличествоНеподобранных=0) Тогда
		ТекстСообщения = "Счета подобраны.";
	Иначе
		ТекстСообщения = "Для "+Строка(КоличествоНеподобранных)+" строк(и) подобрать счета не удалось.";
	КонецЕсли; 
	Ответ = _УФКС.Ответ(,ТекстСообщения);
	
	Возврат(Ответ);
	
	// --- 
КонецФункции

Функция АвтоматическийПодборСчетов(ВариантПодбора) Экспорт
	
	СтруктураНастроек  = CW_Настройки.ПолучитьНастройкиОперативногоУчета(Организация,Перечисления.CW_ВидыОперативнойЗадолженности.Дебиторская, Дата); 

	ИспользуетсяОперативнаяЗадолженность = СтруктураНастроек["ВедетсяОперативныйУчет"]; 
	Если Не ИспользуетсяОперативнаяЗадолженность Тогда
		ВызватьИсключение "Не используется оперативная задолжненность";	
	КонецЕсли;
	
	НастройкиОперативногоУчета = СтруктураНастроек["НастройкиОперативногоУчета"]; 
	КонтрольНоменклатуры 		= НастройкиОперативногоУчета["КонтрольНоменклатуры"];
	КонтрольПорядкаОтражения 	= НастройкиОперативногоУчета["КонтрольПорядкаОтражения"];
	КонтрольНДС 				= НастройкиОперативногоУчета["КонтрольНДС"];
	
	Если ВариантПодбора = 0 Тогда
		ДатаСреза = ТекущаяДата();
	Иначе
		ДатаСреза = ДатаАкта;
	КонецЕсли;     
	
	Запрос = Новый Запрос;  
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ТаблицаУслуг.Грузоперевозка КАК Грузоперевозка,
	|	ТаблицаУслуг.Номенклатура КАК Номенклатура,
	|	ТаблицаУслуг.ПорядокОтражения КАК ПорядокОтражения,
	|	ТаблицаУслуг.СтавкаНДС КАК СтавкаНДС
	|ПОМЕСТИТЬ ВТ_ДанныеДокумента
	|ИЗ
	|	&ТаблицаУслуг КАК ТаблицаУслуг";
	
	Запрос.УстановитьПараметр("ТаблицаУслуг", Услуги.Выгрузить());
	
	Запрос.Выполнить();
	
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВТ_ДанныеДокумента.Грузоперевозка КАК Грузоперевозка
	|ИЗ
	|	ВТ_ДанныеДокумента КАК ВТ_ДанныеДокумента"; 
	
	РезультатЗапроса = Запрос.Выполнить();
	МассивГрузоперевозок = РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("Грузоперевозка");
	
	ЗапросАктирование = Новый Запрос;
	ЗапросАктирование.Текст = "ВЫБРАТЬ
	|	CW_АктированиеИсходящихСчетовОстатки.Грузоперевозка КАК Грузоперевозка,
	|	CW_АктированиеИсходящихСчетовОстатки.Номенклатура КАК Номенклатура,
	|	CW_АктированиеИсходящихСчетовОстатки.ПорядокОтражения КАК ПорядокОтражения,
	|	CW_АктированиеИсходящихСчетовОстатки.СтавкаНДС КАК СтавкаНДС,
	|	CW_АктированиеИсходящихСчетовОстатки.Счет КАК Счет,
	|	CW_АктированиеИсходящихСчетовОстатки.ВсегоОстаток КАК Всего
	|ИЗ
	|	РегистрНакопления.CW_АктированиеИсходящихСчетов.Остатки(
	|			&Период,
	|			Организация = &Организация
	|				И Контрагент = &Контрагент
	|				И Договор = &Договор
	|				И Грузоперевозка В (&Грузоперевозки)   
	|				//УСЛОВИЕ_Номенклатура
	|				//УСЛОВИЕ_ПорядокОтражения 
	|				//УСЛОВИЕ_СтавкаНДС
	|				И Счет <> ЗНАЧЕНИЕ(Документ.CW_ДоходыПоГрузоперевозке.ПустаяСсылка)) КАК CW_АктированиеИсходящихСчетовОстатки
	|ГДЕ
	|	CW_АктированиеИсходящихСчетовОстатки.ВсегоОстаток > 0";  
	
	ЗапросАктирование.УстановитьПараметр("Период", 			ДатаСреза);
	ЗапросАктирование.УстановитьПараметр("Организация", 	Организация);
	ЗапросАктирование.УстановитьПараметр("Контрагент", 		Контрагент);
	ЗапросАктирование.УстановитьПараметр("Договор", 		Договор);   
	ЗапросАктирование.УстановитьПараметр("Грузоперевозки", 	МассивГрузоперевозок); 
	
	Если КонтрольНоменклатуры Тогда   
		
		ЗапросАктирование.Текст = СтрЗаменить(ЗапросАктирование.Текст, "//УСЛОВИЕ_Номенклатура", "И Номенклатура В (&Номенклатура)");	
	
		Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ВТ_ДанныеДокумента.Номенклатура КАК Номенклатура
		|ИЗ
		|	ВТ_ДанныеДокумента КАК ВТ_ДанныеДокумента";
		
		РезультатЗапроса = Запрос.Выполнить();
		МассивНоменклатуры = РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("Номенклатура");
		
		ЗапросАктирование.УстановитьПараметр("Номенклатура", МассивНоменклатуры);
	КонецЕсли;   
	
	Если КонтрольПорядкаОтражения Тогда   
		ЗапросАктирование.Текст = СтрЗаменить(ЗапросАктирование.Текст, "//УСЛОВИЕ_ПорядокОтражения", "И ПорядокОтражения В (&ПорядокОтражения)");	
		
		Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ВТ_ДанныеДокумента.ПорядокОтражения КАК ПорядокОтражения
		|ИЗ
		|	ВТ_ДанныеДокумента КАК ВТ_ДанныеДокумента";
		
		РезультатЗапроса = Запрос.Выполнить();
		МассивПорядокОтражения = РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("ПорядокОтражения"); 
		
		ЗапросАктирование.УстановитьПараметр("ПорядокОтражения", МассивПорядокОтражения);
	КонецЕсли;   
	
	Если КонтрольНДС Тогда
		ЗапросАктирование.Текст = СтрЗаменить(ЗапросАктирование.Текст, "//УСЛОВИЕ_СтавкаНДС", "И СтавкаНДС В (&СтавкаНДС)");	
		
		Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ВТ_ДанныеДокумента.СтавкаНДС КАК СтавкаНДС
		|ИЗ
		|	ВТ_ДанныеДокумента КАК ВТ_ДанныеДокумента"; 
		
		РезультатЗапроса = Запрос.Выполнить();
		МассивСтавкаНДС = РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("СтавкаНДС"); 
		
		ЗапросАктирование.УстановитьПараметр("СтавкаНДС", МассивСтавкаНДС);
	КонецЕсли;
	
	РезультатЗапроса = ЗапросАктирование.Выполнить();
	ТаблицаСчетов = РезультатЗапроса.Выгрузить(); 
	ТаблицаСчетов.Колонки.Добавить("Выбран", Новый ОписаниеТипов("Булево"));
	ТаблицаСчетов.Сортировать("Всего ВОЗР");
	
	Подобрано = 0;
	
	Для Каждого СтрокаУслуг из Услуги Цикл   
		
		ОтборСтрок = Новый Структура; 
		ОтборСтрок.Вставить("Выбран", 			Ложь); 
		ОтборСтрок.Вставить("Грузоперевозка", 	СтрокаУслуг.Грузоперевозка); 
		ОтборСтрок.Вставить("Всего", 			СтрокаУслуг.Всего); 
		
		Если КонтрольНоменклатуры Тогда
			ОтборСтрок.Вставить("Номенклатура", 	СтрокаУслуг.Номенклатура);
		КонецЕсли;
		Если КонтрольПорядкаОтражения Тогда
			ОтборСтрок.Вставить("ПорядокОтражения", СтрокаУслуг.ПорядокОтражения);
		КонецЕсли;
		Если КонтрольНДС Тогда
			ОтборСтрок.Вставить("СтавкаНДС", 		СтрокаУслуг.СтавкаНДС);
		КонецЕсли;  
		
		
		Пока Истина Цикл
			
			НайденныеСтроки = ТаблицаСчетов.НайтиСтроки(ОтборСтрок); 
			Если НайденныеСтроки.Количество() = 0 Тогда 
				Если ОтборСтрок.Свойство("СтавкаНДС") Тогда
					ОтборСтрок.Удалить("СтавкаНДС");  
				КонецЕсли;
				Если ОтборСтрок.Свойство("ПорядокОтражения") Тогда
					ОтборСтрок.Удалить("ПорядокОтражения");   
				КонецЕсли;
				Если ОтборСтрок.Свойство("Номенклатура") Тогда
					ОтборСтрок.Удалить("Номенклатура");   
				КонецЕсли;
				Если ОтборСтрок.Свойство("Всего") Тогда
					ОтборСтрок.Удалить("Всего");   
				КонецЕсли;
			КонеЦЕсли;
			
			Для Каждого НайденнаяСтрока из НайденныеСтроки Цикл 
				Если НайденнаяСтрока.Всего >= СтрокаУслуг.Всего Тогда
					
					СтрокаУслуг.Счет 		= НайденнаяСтрока.Счет; 
					НайденнаяСтрока.Всего 	= НайденнаяСтрока.Всего - СтрокаУслуг.Всего;
					
					Подобрано = Подобрано + 1;  
					
					Если НайденнаяСтрока.Всего = 0 Тогда
						НайденнаяСтрока.Выбран = Истина;
					КонецЕсли;
					
					Прервать; 
					
				КонецЕсли;
			КонецЦикла;
			
			Прервать;
			
		КонецЦикла;
		
	КонецЦикла;  
	
	НеПодобрано = Услуги.Количество() - Подобрано;
	
	Если НеПодобрано = 0 Тогда
		ТекстСообщения = "Счета подобраны.";
		
		// если во всех строках подобрали только один счет, то пропишем его в шапку
		ТЗСчетов = Услуги.Выгрузить();
		ТЗСчетов.Свернуть("Счет");
		Если ТЗСчетов.Количество() = 1 Тогда
			СписокСчетов = Ложь; 
			Счет = ТЗСчетов[0]["Счет"];
		КонецЕсли;
		
	Иначе
		ТекстСообщения = "Для "+Строка(НеПодобрано)+" строк(и) подобрать счета не удалось.";
	КонецЕсли;
	
	Ответ = Новый Структура;
	Ответ.Вставить("Код", 0);
	Ответ.Вставить("ОписаниеОшибки",ТекстСообщения);
	
	Возврат Ответ;
	
КонецФункции
  
Процедура СформироватьВознаграждениеЭкспедитра(ДанныеЗаполнения, ПараметрыДоговора)
	
	НоменклатураВознаграждения 	= ПараметрыДоговора.Номенклатура;
	
	//Подситема.СтатусыДокументов
	СтатусДокумента 				= Справочники.CW_СтатусыДокументов.ПолучитьСтатусНовогоОбъекта(ТипЗнч(Ссылка));
	
	СтатусДокументаПроводитьПоБухгалтерскомуУчету 	= CW_СтатусыДокументовСервер.ПолучитьПризнакПроведенияПоБухгалтерскомуУчету(Ссылка, СтатусДокумента);
	//Подситема.СтатусыДокументов
	
	СтруктураПараметровБухУчета = Новый Структура;
	СтруктураПараметровБухУчета.Вставить("Договор", 				ДанныеЗаполнения.Договор);
	СтруктураПараметровБухУчета.Вставить("ПриложениеКДоговору",		ДанныеЗаполнения.ПриложениеКДоговору);
	
	ПараметрыБухгалтерскогоУчета = CW_Финансы.ПолучитьПарметрыВеденияБухгалтерскогоУчета(СтруктураПараметровБухУчета, ДанныеЗаполнения.Дата);
	
	ПровестиПоБухгалтерскомуУчету = СтатусДокументаПроводитьПоБухгалтерскомуУчету и ПараметрыБухгалтерскогоУчета.БухгалтерскийУчет;
	
	
	#Область Заполнение_шапки_Документа
	//Заполняем шапку документа
	Дата 							= ДанныеЗаполнения.Дата;
	ВидОперации 					= Перечисления.CW_ВидыОперацийДоходыПоГрузоперевозке.ОказаниеУслуг;
	Организация 					= ДанныеЗаполнения.Организация;
	Ответственный					= ДанныеЗаполнения.Ответственный;
	Руководитель					= ДанныеЗаполнения.Руководитель;
	ЗаРуководителяПоПриказу			= ДанныеЗаполнения.Руководитель_основание;
	ГлавныйБухгалтер				= ДанныеЗаполнения.ГлавныйБухгалтер;
	ЗаГлавногоБухгалтераПоПриказу	= ДанныеЗаполнения.ГлавныйБухгалтер_основание;
	
	Контрагент 						= ДанныеЗаполнения.Контрагент;
	Договор 						= ДанныеЗаполнения.Договор;
	Валюта 							= ДанныеЗаполнения.ВалютаДокумента;
	
	ДатаСчета 						= "";
	ДатаАкта  						= "";
	ДатаСчетаФактуры 				= "";
	
	НомерСчета 						= "";
	НомерАкта 						= "";
	НомерСчетаФактуры 				= "";
	
	Если ЗначениеЗаполнено(ПараметрыДоговора.ПорядокЗачетаАвансовОЗ) Тогда
		СпособЗачетаАвансовОЗ = ПараметрыДоговора.ПорядокЗачетаАвансовОЗ;
	КонецЕсли;
	Если ЗначениеЗаполнено(ПараметрыДоговора.ПорядокЗачетаАвансов) Тогда
		СпособЗачетаАвансов = ПараметрыДоговора.ПорядокЗачетаАвансов;
	КонецЕсли;
	
	Если НЕ ПровестиПоБухгалтерскомуУчету Тогда
		СпособЗачетаАвансов = Перечисления.СпособыЗачетаАвансов.НеЗачитывать;
	КонецЕсли;
			
	Комментарий	= "Агентское вознагражжение к документу: "+СокрЛП(ДанныеЗаполнения);
	
	#КонецОбласти
	
	#Область заполение_табличной_части_документа
	//Получаем данных для заполнения таблицы документа
	СтруктураСвязанняеДокументы = Документы.CW_ОтчетЭкспедитора.ПолучитьСвязанныеДоходыПоГрузопереовзкам(ДанныеЗаполнения);
	
	ЗаполнитьТабличнуюЧастьВознаграждение(СтруктураСвязанняеДокументы.Проведенные, НоменклатураВознаграждения, ПараметрыДоговора, ДанныеЗаполнения);

	#КонецОбласти
	

КонецПроцедуры

Функция ПолучитьОсновнуюСтатьюЗатрат(Знач НоменклатураВознаграждения, ДанныеЗаполнения)
	
	ОсновнаяСтатьяЗатрат = ПредопределенноеЗначение("Справочник.СтатьиЗатрат.ПустаяСсылка");
	
	//получим статью затрат для номенклатуры вознаграждения
	Запрос = новый запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	CW_СтатьиЗатратНоменклатуры.Номенклатура КАК Номенклатура,
	|	CW_СтатьиЗатратНоменклатуры.СтатьяЗатрат КАК СтатьяЗатрат
	|ИЗ
	|	РегистрСведений.CW_СтатьиЗатратНоменклатуры КАК CW_СтатьиЗатратНоменклатуры
	|ГДЕ
	|	CW_СтатьиЗатратНоменклатуры.Номенклатура = &Номенклатура";
	
	Запрос.УстановитьПараметр("Номенклатура", НоменклатураВознаграждения);
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Если Выборка.Следующий() Тогда
		ОсновнаяСтатьяЗатрат = Выборка.СтатьяЗатрат;
	Иначе
		ОсновнаяСтатьяЗатрат = CW_Настройки.ПараметрУчетнойПолитики(ДанныеЗаполнения.Дата, ДанныеЗаполнения.Договор.Организация, "ОсновнаяСтатьяЗатрат");
	КонецЕсли;
	
	Возврат ОсновнаяСтатьяЗатрат;

КонецФункции

Процедура ЗаполнитьТабличнуюЧастьВознаграждение(мДокументы, НоменклатураВознаграждения, ПараметрыДоговора, ДанныеЗаполнения)
	
	ОсновнаяСтатьяЗатрат = ПолучитьОсновнуюСтатьюЗатрат(НоменклатураВознаграждения, ДанныеЗаполнения);

	Запрос = новый запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	CW_ДоходыПоГрузоперевозкеУслуги.Грузоперевозка КАК Грузоперевозка,
	               |	СУММА(CW_ДоходыПоГрузоперевозкеУслуги.Всего) КАК Всего,
	               |	CW_ДоходыПоГрузоперевозкеУслуги.ДокументРасходов КАК ДокументРасходов
	               |ИЗ
	               |	Документ.CW_ДоходыПоГрузоперевозке.Услуги КАК CW_ДоходыПоГрузоперевозкеУслуги
	               |ГДЕ
	               |	CW_ДоходыПоГрузоперевозкеУслуги.Ссылка В(&мСсылки)
	               |	И CW_ДоходыПоГрузоперевозкеУслуги.ПорядокОтражения = ЗНАЧЕНИЕ(Перечисление.CW_ПорядокОтраженияДоходов.Перевыставление)
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	CW_ДоходыПоГрузоперевозкеУслуги.Грузоперевозка,
	               |	CW_ДоходыПоГрузоперевозкеУслуги.ДокументРасходов";
	
	Запрос.УстановитьПараметр("мСсылки", мДокументы);
	
	РезультатЗапроса = запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Нстр = Услуги.Добавить();
		
		Нстр.Грузоперевозка   = Выборка.Грузоперевозка;
		Нстр.Номенклатура     = НоменклатураВознаграждения;
		Нстр.Представление    = НоменклатураВознаграждения.НаименованиеПолное + " " + Выборка.Грузоперевозка.CW_Представление;
		Нстр.СтатьяЗатрат     = ОсновнаяСтатьяЗатрат;
		Нстр.ПорядокОтражения = Перечисления.CW_ПорядокОтраженияДоходов.СобственнаяУслуга;
		Нстр.Количество       = 1;
		Нстр.СтавкаНДС        = ПараметрыДоговора.СтавкаНДС;
		Нстр.ДокументРасходов = Выборка.ДокументРасходов;
		
	
		Ставка				  = CW_Финансы.ПолучитьСтавкуНДС(Нстр.СтавкаНДС)/100;
		
		Если ПараметрыДоговора.ВариантРасчетаВознаграждения = Перечисления.CW_ВариантыАвтоматическогоРасчетаВознаграждения.ПроцентОтСуммы Тогда 
			СуммаВознагражденияПоСтроке = Окр(Выборка.Всего*ПараметрыДоговора.РазмерАгентскогоВознаграждения/100, 2, 1);
			
			Нстр.Всего	= СуммаВознагражденияПоСтроке;
			Нстр.НДС	= Окр(Нстр.Всего * Ставка/(1+Ставка),2,1);
			Нстр.Сумма	= Нстр.Всего - Нстр.НДС;
			Нстр.Цена	= _сф.БезопасноРазделить(Нстр.Сумма,Нстр.Количество);
			Нстр.База 	= Выборка.Всего;
		
		ИначеЕсли ПараметрыДоговора.ВариантРасчетаВознаграждения = Перечисления.CW_ВариантыАвтоматическогоРасчетаВознаграждения.ФиксированнаяСумма Тогда
			
			Нстр.Всего				= ПараметрыДоговора.РазмерАгентскогоВознаграждения ;
			Нстр.НДС				= окр(Нстр.Всего*Ставка/(1+Ставка),2,1);
			Нстр.Сумма            	= Нстр.Всего - Нстр.НДС;
			Нстр.Цена				= _сф.БезопасноРазделить(Нстр.Сумма,Нстр.Количество);
			
		КонецЕсли;
		
	КонецЦикла;

КонецПроцедуры

#КонецЕсли