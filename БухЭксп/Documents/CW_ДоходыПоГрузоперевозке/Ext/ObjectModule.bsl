						ВедомыйДокумент = Неопределено;
						ВедомыйСчетФактура = Неопределено;
						
					КонецЕсли; 
					
				КонецЕсли; 
				
				// создаём/перезаполняем
				Если (ТребуетсяСозданиеВедомого ИЛИ НоваяДата <> ВедомыйДокумент.Дата ИЛИ ВедомыйДокумент.ПометкаУдаления) Тогда
					
					// создаем
					Если (ТребуетсяСозданиеВедомого) Тогда
						Ведомый = Документы.КорректировкаРеализации.СоздатьДокумент();
					Иначе
						Ведомый = ВедомыйДокументКорректировки.ПолучитьОбъект();
					КонецЕсли; 
					// --- 
					Ведомый.Дата 					= НоваяДата;
					Ведомый.ОбменДанными.Загрузка	= Истина;
					Ведомый.ПометкаУдаления 		= Ложь;
					Ведомый.Организация 			= Организация;
					
					Ведомый.ВидОперации 			= ВидОперацииКорректировки;
					
