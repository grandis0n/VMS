						КонецЕсли;
						
						// прописываем ссылку на счет-фактуру в ведущий документ
						ВедомыйСчетФактура = НовыйСФ.Ссылка;
						
						// если счет-фактуру формировать не требуется
					Иначе
						
						Если (НЕ ВедомыйСчетФактура.Пустая()) Тогда
							ВедомыйСФ = ВедомыйСчетФактура.ПолучитьОбъект();
							_сф.ст_УстановитьСвойство(ВедомыйСФ.ДополнительныеСвойства,"СообщитьОбИзмененииРеквизитов",Ложь);
							ВедомыйСФ.УстановитьПометкуУдаления(Истина);
						КонецЕсли; 
						
					КонецЕсли; // проверка на необходимость формирования счета-фактуры 
					
				Иначе
					
					Если (НЕ ЗначениеЗаполнено(НомерАкта)) Тогда
						
						// для "сплошной" и "в пределах даты" ставим номер документа
						Если ПолитикаНумерации = Перечисления.CW_ПорядокПрисвоенияИсходящихНомеров.СплошнаяНумерация
							ИЛИ ПолитикаНумерации = Перечисления.CW_ПорядокПрисвоенияИсходящихНомеров.ВПределахДаты Тогда
				
							НомерАкта = Номер;
							
						ИначеЕсли ПолитикаНумерации = Перечисления.CW_ПорядокПрисвоенияИсходящихНомеров.ВнешнийНумератор Тогда
							
							ОбработкаНумерации.УстановитьНомерАкта(ЭтотОбъект);
					
						Иначе
							
							Сообщить("Автонумерация актов для договоров без признака бухгалтерского учёта поддерживается только для типов нумерации ""Сплошная"" и ""В пределах даты""");
							Отказ = Истина;
							Возврат;
							
						КонецЕсли; 
						
					КонецЕсли; 
					
					Если (ФормируетсяСчетФактура) Тогда
						
						_сф.УстановитьЕслиНезаполнено(ДатаСчетаФактуры,ДатаАкта);
						
						// установка номера счета-фактуры
						Если (НЕ ЗначениеЗаполнено(НомерСчетаФактуры)) Тогда
							
							// для "сплошной" и "в пределах даты" ставим номер документа
							Если (ПолитикаНумерации = Перечисления.CW_ПорядокПрисвоенияИсходящихНомеров.СплошнаяНумерация
								ИЛИ ПолитикаНумерации = Перечисления.CW_ПорядокПрисвоенияИсходящихНомеров.ВПределахДаты) Тогда
								
								НомерСчетаФактуры = Номер;
								
							ИначеЕсли ПолитикаНумерации = Перечисления.CW_ПорядокПрисвоенияИсходящихНомеров.ВнешнийНумератор Тогда
								
								ОбработкаНумерации.УстановитьНомерСчетаФактуры(ЭтотОбъект);
								
							КонецЕсли; 
							
						КонецЕсли;  // присвоение номера счета-фактуры
						
						Если (НЕ ВедомыйСчетФактура.Пустая()) Тогда
							ВедомыйСФ = ВедомыйСчетФактура.ПолучитьОбъект();
							_сф.ст_УстановитьСвойство(ВедомыйСФ.ДополнительныеСвойства,"СообщитьОбИзмененииРеквизитов",Ложь);
							ВедомыйСФ.УстановитьПометкуУдаления(Истина);
						КонецЕсли; 
						
					КонецЕсли;
					
					// если ведомый документ существует, то помечаем на удаление
					Если (НЕ ВедомыйДокумент.Пустая()) Тогда
						Ведомый = ВедомыйДокумент.ПолучитьОбъект();
						Ведомый.УстановитьПометкуУдаления(Истина);
					КонецЕсли; 
					
				КонецЕсли; 
				
				БлокироватьПриОтличиеДатыАкта = НП.БлокироватьПриОтличиеДатыАкта;
				Если (БлокироватьПриОтличиеДатыАкта = Неопределено) Тогда
					БлокироватьПриОтличиеДатыАкта = Ложь;
				КонецЕсли;
				
				Если БлокироватьПриОтличиеДатыАкта И ФормируетсяАкт И РежимЗаписи = РежимЗаписиДокумента.Проведение и ФормируетсяАкт Тогда
					Если (НачалоДня(ДатаАкта) <> НачалоДня(Дата)) Тогда
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Дата акта отличается от даты документа. Проведение отменено.", ,,,Отказ);
						Возврат;
					КонецЕсли; 
				КонецЕсли; 
				
				// если акт не формируется
			Иначе
				
				// если ведомый документ существует, то помечаем на удаление
				Если (НЕ ВедомыйДокумент.Пустая()) Тогда
					Ведомый = ВедомыйДокумент.ПолучитьОбъект();
					Ведомый.УстановитьПометкуУдаления(Истина);
				КонецЕсли; 
				
			КонецЕсли; // проверка на необходимость формирования акта
			
		КонецЕсли; // это не корректировка
		
		Если (Корректировка) Тогда
			
			Если (ФормируетсяСчет) Тогда
				
				//----
				_сф.УстановитьЕслиНезаполнено(ДатаСчета,Дата);
				
				// синхронизация времени
				Если (НачалоДня(ДатаСчета) = НачалоДня(Дата)) Тогда
					ДатаСчета = Дата;
				КонецЕсли; 
				
				// формирование счета при условии того, что по договору ведется бухгалтерский учет
				Если (ПараметрыБухгалтерскогоУчета.БухгалтерскийУчет И ДС.УП.ФормироватьСчетаПокупателюНаОплату и ПровестиПоБухгалтерскомуУчету) Тогда
					
					ФормироватьСчет = Истина;
					
					// если ссылка на документ "Счет" отсутствует, формирем новый документ,
					// иначе получаем ранее созданный
					Если ((ВедомыйСчетКорректировочный.Пустая()) ИЛИ (НЕ _СФ.ОбъектБДСуществует(ВедомыйСчетКорректировочный))) Тогда
						НовыйВедомыйСчетКорректировочный = Документы.СчетНаОплатуПокупателю.СоздатьДокумент();
						НовыйВедомыйСчетКорректировочный.Контрагент 	= Контрагент;
						НовыйВедомыйСчетКорректировочный.Комментарий 	= "Сформировано автоматически (CW) документом ""Доходы по грузоперевозке"" №"+Номер+" от "+СокрЛП(Дата);
					Иначе
						НовыйВедомыйСчетКорректировочный = ВедомыйСчетКорректировочный.ПолучитьОбъект();
						НовыйВедомыйСчетКорректировочный.ПометкаУдаления = Ложь;
					КонецЕсли; 
					
					НовыйВедомыйСчетКорректировочный.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийСчетаПокупателю.ТоварыИУслуги");
	
					// заполняем реквизиты счета  
					НовыйВедомыйСчетКорректировочный.Организация = Организация;
					//Удалено чтобы исключить дублирование номеров документов
					//НовыйВедомыйСчет.ОбменДанными.Загрузка = Истина;
					НовыйВедомыйСчетКорректировочный.Дата = ДатаСчета;
					
					НовыйВедомыйСчетКорректировочный.СуммаВключаетНДС = ЦенаСНДС;
					
					//Для версии КОРП
					Если ВестиУчетПоПодразделениям Тогда
						НовыйВедомыйСчетКорректировочный.ПодразделениеОрганизации = ПодразделениеОрганизации;
					КонецЕсли;
					//Для версии КОРП
					
					
					// присвоение номера счета
					Если (ЗначениеЗаполнено(НомерСчета)) Тогда
						НовыйВедомыйСчетКорректировочный.Номер = СокрЛП(НомерСчета);
					Иначе
						
						// для "сплошной" и "в пределах даты" ставим номер документа
						Если ПолитикаНумерации = Перечисления.CW_ПорядокПрисвоенияИсходящихНомеров.СплошнаяНумерация
							ИЛИ ПолитикаНумерации = Перечисления.CW_ПорядокПрисвоенияИсходящихНомеров.ВПределахДаты Тогда
							
							НовыйВедомыйСчетКорректировочный.Номер = СокрЛП(Номер);
							НомерСчета = Номер;
							
						КонецЕсли; 
						
						// для независимой просто получаем номер
						Если (ПолитикаНумерации = Перечисления.CW_ПорядокПрисвоенияИсходящихНомеров.НезависимаяНумерация) Тогда
							
							НовыйВедомыйСчетКорректировочный.УстановитьНовыйНомер();
							// --- 
							НомерСчета = НовыйВедомыйСчетКорректировочный.Номер;
							
						КонецЕсли;
						
						// внешний нумератор
						Если (ПолитикаНумерации = Перечисления.CW_ПорядокПрисвоенияИсходящихНомеров.ВнешнийНумератор) Тогда
							
							ОбработкаНумерации.УстановитьНомерСчета(ЭтотОбъект, НовыйВедомыйСчетКорректировочный);
							
						КонецЕсли; 
						
					КонецЕсли; 
					
					CW_Документы.ПеренестиПризнакВосстановленияПоследовательности(ЭтотОбъект,НовыйВедомыйСчетКорректировочный);
					
					// проверяем (пытаемся записать) на возможность записи документа с указанным номером,
					// если в процессе записи возникла ошибка, то выходим из процедуры
					Отказ = CW_Документы.ПроверкаНомера(НовыйВедомыйСчетКорректировочный, РежимЗаписиДокумента.Запись, ЭтотОбъект.Ссылка,Ложь);
					Если Отказ Тогда 
