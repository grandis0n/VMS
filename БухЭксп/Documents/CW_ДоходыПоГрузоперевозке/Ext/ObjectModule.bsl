					КонецЕсли;
					
					// записываем ссылку на счет в документ
					ВедомыйСчетКорректировочный = НовыйВедомыйСчетКорректировочный.Ссылка;	
				КонецЕсли; // признак формирования счета установлен 
				
				//---
				
			КонецЕсли; // признак формирования счета установлен 
			
			Если (ФормируетсяАкт И ПровестиПоБухгалтерскомуУчету) Тогда
				
				_сф.УстановитьЕслиНезаполнено(ДатаАкта,Дата);
				
				// формируем ведомую корректировку поступления 
				НоваяДата = ?(ДатаАкта= Дата(1,1,1), Дата, ДатаАкта);
				
				ТребуетсяСозданиеВедомого = Ложь;
				Если (ВедомыйДокументКорректировки.Пустая()) Тогда
					ТребуетсяСозданиеВедомого = Истина;
				КонецЕсли; 
				Если (НЕ ТребуетсяСозданиеВедомого) Тогда
					Если (НЕ _СФ.ОбъектБДСуществует(ВедомыйДокументКорректировки)) Тогда
						ТребуетсяСозданиеВедомого = Истина;
					КонецЕсли; 
				КонецЕсли; 
				Если (НЕ ЭтоНовый() И НЕ ТребуетсяСозданиеВедомого) Тогда
					
					// проверяем, не связан ли он уже с другим ведущим
					Ведущий = CW_Документы.ПолучитьВедущийДокумент(ВедомыйДокументКорректировки);
					Если (Ведущий = Неопределено ИЛИ Ведущий <> Ссылка) Тогда
						
