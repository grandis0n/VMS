									мКоды.Добавить(ДС.УП.КодВидаОперацииДляИсходящихСчетовФактур);
								КонецЕсли; 
				
								НовыйСФ.КодВидаОперации = СтрСоединить(мКоды, ";");
								
							КонецЕсли; 
							
						КонецЕсли; 
						// --- 
						//НовыйСФ.ОбменДанными.Загрузка=Истина;
						
						// установка номера счета-фактуры
						Если (ЗначениеЗаполнено(НомерСчетаФактуры)) Тогда
							НовыйСФ.Номер = НомерСчетаФактуры;
							
							// пытаемся опаределить номер счета фактруры в автоматическом режиме
						Иначе
							
							// для "сплошной" и "в пределах даты" ставим номер документа
							Если (ПолитикаНумерации = Перечисления.CW_ПорядокПрисвоенияИсходящихНомеров.СплошнаяНумерация
								ИЛИ ПолитикаНумерации = Перечисления.CW_ПорядокПрисвоенияИсходящихНомеров.ВПределахДаты) 
