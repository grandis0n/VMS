&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	CW_Документы.УстановитьПараметрыФункциональныхОпцийФормы(Этаформа);
	ВалютаРег = Константы.ВалютаРегламентированногоУчета.Получить();
	
	Если Не ЗначениеЗаполнено(Объект.Организация) тогда
		Объект.Организация = CW_Настройки.ОсновнаяОрганизация();
	Конецесли;
	
	Если Не ЗначениеЗаполнено(Объект.Дата) Тогда
		Объект.Дата = CW_Документы.РабочееВремя();
	КонецЕсли;
	
	ПоказатьПодразделение = ложь;
	Если ЗначениеЗаполнено(Объект.Организация) тогда
		ПоказатьПодразделение = CW_Настройки.ПараметрУчетнойПолитики(Объект.Дата, Объект.Организация, "ГруппировкаЗатратПоПодразделениям");
	КонецЕсли;
	
	Элементы.ЗатратыПодразделение.Видимость = ПоказатьПодразделение;
	
	ТекущийДокументОснование = Объект.ДокументОснование;
	
	УстанавиливаемыеПараметры = Новый Структура("CW_ДоговорПоГрузоперевозкам", ТекущийДокументОснование.Договор);
	Элементы.ПриложениеКДоговору.Видимость = ПолучитьФункциональнуюОпцию("CW_УчитыватьПриложенияВДокументах",УстанавиливаемыеПараметры); 
	
	//Наличие прикрепленных файлов
	_УФКС.УстановитьНаличиеПрикрепленныхФайловПриСозданииФормыНаСервере(ЭтаФорма);
	//Наличие прикрепленных файлов

	//Для версии КОРП
	ВестиУчетПоПодразделениям					= ПолучитьФункциональнуюОпцию("ВестиУчетПоПодразделениям");
	Элементы.ПодразделениеОрганизации.Видимость	= ВестиУчетПоПодразделениям;
	//Для версии КОРП

	ПроверитьВозмоностьЗаполненияДокумента();
	
	УстановитьВидимостьСпособУчетаНДСНаСервере();
	
	ЗаполнитьДополнительныеКолонки();

	НачальнаяДатаДокумента = Объект.Дата;
	
	//Внешние подклчюаемые команды
	CW_ПодключаемыеКомандыСервер.ПриСозданииНаСервере(ЭтотОбъект);
	//Внешние подклчюаемые команды
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	СостояниеДокумента = ОбщегоНазначенияБП.СостояниеДокумента(Объект); // ВызовБП
	
	ЗаполнитьДополнительныеКолонки();

	НачальнаяДатаДокумента 	= Объект.Дата;
	
	//Подсистема.УчетПриложенийДоговоров
	CW_УчетПриложенийДоговоровСервер.УстановитьПризнакУчетаПоПриложениямВТабличнойЧасти(ЭтаФорма, "Затраты", "Договор");
	//Подсистема.УчетПриложенийДоговоров
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДополнительныеКолонки() 

	Для каждого СтрокаДокумента Из Объект.Затраты Цикл
		СтрокаДокумента.ВалютаРег = ВалютаРег;
	КонецЦикла;

КонецПроцедуры


&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	СостояниеДокумента = ОбщегоНазначенияБП.СостояниеДокумента(Объект); // ВызовБП
	
	ЗаполнитьДополнительныеКолонки();
	
	//Подсистема.УчетПриложенийДоговоров
	CW_УчетПриложенийДоговоровСервер.УстановитьПризнакУчетаПоПриложениямВТабличнойЧасти(ЭтаФорма, "Затраты", "Договор");
	//Подсистема.УчетПриложенийДоговоров
	
КонецПроцедуры

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
	ПроверитьВозмоностьЗаполненияДокумента();
	УстановитьВидимостьСпособУчетаНДСНаСервере();
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьСпособУчетаНДСНаСервере()
	
	УстанавливаемыеПараметры = Новый Структура;
	УстанавливаемыеПараметры.Вставить("Организация", Объект.Организация);
	
	Элементы.ЗатратыСпособУчетаНДС.Видимость = ПолучитьФункциональнуюОпцию("РаздельныйУчетНДСНаСчете19",УстанавливаемыеПараметры);

КонецПроцедуры

//Команды табличной части
&НаКлиенте
Процедура Заполнить(Команда)
	
	Отказ = Ложь;
	Если Не ЗначениеЗаполнено(Объект.ДокументОснование) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заполнен документ реализации!",,"ДокументОснование","Объект", Отказ);
	КонецЕсли;
	
	Если Не Отказ тогда
		
		ДополнительныеПараметры = Новый Структура;
		Оповещение = Новый ОписаниеОповещения("ПродолжитьЗаполнить", ЭтотОбъект, ДополнительныеПараметры);
		
		Если Объект.Затраты.Количество() > 0 Тогда
			СтандартнаяОбработка = Ложь;
			Режим = РежимДиалогаВопрос.ДаНет;
			ПоказатьВопрос(Оповещение, "Табличная часть документа будет очищена. Продолжить?", Режим, 0);
		Иначе
			ВыполнитьОбработкуОповещения(Оповещение, КодВозвратаДиалога.Да);
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПродолжитьЗаполнить(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьТабличнуюЧастьНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТабличнуюЧастьНаСервере(РезультатПодбора = Неопределено)
	
	ТОбъект = РеквизитФормыВЗначение("Объект");
	
	ПараметрыЗаполнения = Новый Структура;
	ПараметрыЗаполнения.Вставить("Дата", 						Объект.Дата);
	ПараметрыЗаполнения.Вставить("Организация", 				Объект.Организация);
	ПараметрыЗаполнения.Вставить("ПодразделениеОрганизации",	Объект.ПодразделениеОрганизации);
	ПараметрыЗаполнения.Вставить("Ссылка", 						Объект.ДокументОснование);
	ПараметрыЗаполнения.Вставить("Контрагент", 					Объект.ДокументОснование.Контрагент);
	ПараметрыЗаполнения.Вставить("Договор", 					Объект.ДокументОснование.Договор);
	ПараметрыЗаполнения.Вставить("ПриложениеКДоговору",			Объект.ДокументОснование.ПриложениеКДоговору);
	
	РезультатЗапроса = ТОбъект.ПолучитьДанныеДляЗаполненияТабличнойЧасти(ПараметрыЗаполнения, РезультатПодбора);
	
	Объект.Затраты.Загрузить(РезультатЗапроса.Выгрузить());
	
КонецПроцедуры

&НаСервере
Процедура ДокументОснованиеПриИзмененииНаСервере()
	
	Объект.Затраты.Очистить();
	Объект.ПодразделениеОрганизации = Объект.ДокументОснование.ПодразделениеОрганизации;
	ТекущийДокументОснование = Объект.ДокументОснование;
	
КонецПроцедуры

&НаКлиенте
Процедура ДокументОснованиеПриИзменении(Элемент)
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Элемент", Элемент);
	Оповещение = Новый ОписаниеОповещения("ПродолжитьДокументОснованиеПриИзменении", ЭтотОбъект, ДополнительныеПараметры);
	
	Если Объект.Затраты.Количество() > 0 и ЗначениеЗаполнено(ТекущийДокументОснование) и ТекущийДокументОснование <> Объект.ДокументОснование Тогда
		СтандартнаяОбработка = Ложь;
		Режим = РежимДиалогаВопрос.ДаНет;
		ПоказатьВопрос(Оповещение, "Табличная часть документа будет очищена. Продолжить?", Режим, 0);
	Иначе
		ВыполнитьОбработкуОповещения(Оповещение, КодВозвратаДиалога.Да);
	КонецЕсли;
	
	
КонецПроцедуры

&НаКлиенте
Процедура ПродолжитьДокументОснованиеПриИзменении(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Нет Тогда
		Объект.ДокументОснование =  ТекущийДокументОснование;
		Возврат;
	КонецЕсли;
	
	ДокументОснованиеПриИзмененииНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ДокументОснованиеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Элемент", Элемент);
	Оповещение = Новый ОписаниеОповещения("ПродолжитьИзменениеДокументаоснования", ЭтотОбъект, ДополнительныеПараметры);
	
	Если Объект.Затраты.Количество() > 0 Тогда
		СтандартнаяОбработка = Ложь;
		Режим = РежимДиалогаВопрос.ДаНет;
		ПоказатьВопрос(Оповещение, "Табличная часть документа будет очищена. Продолжить?", Режим, 0);
	Иначе
		ВыполнитьОбработкуОповещения(Оповещение, КодВозвратаДиалога.Да);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПродолжитьИзменениеДокументаоснования(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;
	
	СтруктураОтбора = Новый Структура;
	СтруктураОтбора.Вставить("Организация", 				Объект.Организация);
	СтруктураОтбора.Вставить("ПодразделениеОрганизации", 	Объект.ПодразделениеОрганизации);
	СтруктураОтбора.Вставить("ФормируетсяАкт", 				Истина);
	
	ПараметрыФормыВыбора = Новый Структура;
	ПараметрыФормыВыбора.Вставить("РежимВыбора", 		Истина);
	ПараметрыФормыВыбора.Вставить("МножественныйВыбор", Ложь);
	ПараметрыФормыВыбора.Вставить("ЗакрыватьПриВыборе", Истина);
	ПараметрыФормыВыбора.Вставить("Отбор", 				СтруктураОтбора);
	
	ОткрытьФорму("Документ.CW_ДоходыПоГрузоперевозке.ФормаВыбора", ПараметрыФормыВыбора, ДополнительныеПараметры.Элемент);

КонецПроцедуры

&НаКлиенте
Процедура Очистить(Команда)
	
	Если Объект.Затраты.Количество() > 0 Тогда
		Режим = РежимДиалогаВопрос.ДаНет;
		Оповещение = Новый ОписаниеОповещения("ПродолжитьОчисткуТабличнойЧасти", ЭтотОбъект);
		ПоказатьВопрос(Оповещение, "Табличная часть документа будет очищена. Продолжить?", Режим, 0);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПродолжитьОчисткуТабличнойЧасти(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;
	
	Объект.Затраты.Очистить();
	
КонецПроцедуры

&НаКлиенте
Процедура Подбор(Команда)
	
	АдресПодобранныхДанных = ПолучитьАдресТаблицыПодобранныхДанных();
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ДатаСреза", 				Объект.Дата);
	ПараметрыФормы.Вставить("Организация", 				Объект.Организация);
	ПараметрыФормы.Вставить("ПодразделениеОрганизации",	Объект.ПодразделениеОрганизации);
	ПараметрыФормы.Вставить("ДокументОснование", 		Объект.ДокументОснование);
	ПараметрыФормы.Вставить("АдресПодобранныхДанных", 	АдресПодобранныхДанных);
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ПродолжитьПодборСтрок", ЭтотОбъект);
	
	ОткрытьФорму("Документ.CW_СписаниеЗатратНаРеализацию.Форма.ФормаПодбораЗатрат", ПараметрыФормы, ЭтаФорма,,,,ОписаниеОповещения);
	
КонецПроцедуры

&наКлиенте
Процедура ПродолжитьПодборСтрок(АдресТаблицы, ДополнительныеПараметры) Экспорт

	Если АдресТаблицы = Неопределено тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЭтоАдресВременногоХранилища(АдресТаблицы) Тогда
		Возврат;
	КонецЕсли;
	
	ПродолжитьПодборСтрокНаСервере(АдресТаблицы);

КонецПроцедуры

&наСервере
Процедура ПродолжитьПодборСтрокНаСервере(АдресТаблицы)
	
	Объект.Затраты.Очистить();
	
	РезультатПодбора = ПолучитьИзВременногоХранилища(АдресТаблицы);
	ЗаполнитьТабличнуюЧастьНаСервере(РезультатПодбора);
	
КонецПроцедуры

&НаСервере
Функция ПолучитьАдресТаблицыПодобранныхДанных()
	
	Если Объект.Ссылка.Пустая() Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 0
		|	CW_СписаниеЗатратНаРеализациюЗатраты.ДокументРасходов КАК ДокументРасходов,
		|	CW_СписаниеЗатратНаРеализациюЗатраты.Номенклатура КАК Номенклатура,
		|	CW_СписаниеЗатратНаРеализациюЗатраты.Всего_Валюта КАК Всего_Валюта
		|ИЗ
		|	Документ.CW_СписаниеЗатратНаРеализацию.Затраты КАК CW_СписаниеЗатратНаРеализациюЗатраты";
		
		РезультатЗапроса = Запрос.Выполнить();
		ТаблицаДокумента = РезультатЗапроса.Выгрузить();
		
	Иначе  
		
		ТаблицаДокумента = Объект.Затраты.Выгрузить().Скопировать(,"ДокументРасходов,Номенклатура,Всего_Валюта");
		ТаблицаДокумента.Свернуть("ДокументРасходов,Номенклатура", "Всего_Валюта");
		
	КонецЕсли;
	
	Возврат ПоместитьВоВременноеХранилище(ТаблицаДокумента, УникальныйИдентификатор);
	
КонецФункции


