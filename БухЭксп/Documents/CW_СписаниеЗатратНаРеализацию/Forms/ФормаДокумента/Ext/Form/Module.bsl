//Изменение даты документа
&НаКлиенте
Процедура ДатаПриИзменении(Элемент)
	
	Если НЕ Объект.Ссылка.Пустая() Тогда
		Если ГодИзменился() Тогда
			
			ПОВ = Новый ОписаниеОповещения("ОбработкаВопросаИзмененияГода",ЭтотОбъект, Новый Структура()); 
			ПоказатьВопрос(ПОВ,"Дата документа перенесена в другой год."+Символы.ПС+ 
			"Документу будет присвоен новый номер."+Символы.ПС+ 
			"Продолжить?",РежимДиалогаВопрос.ДаНет);
			
		КонецЕсли; 
	КонецЕсли;
	
	ДатаПриИзмененииНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВопросаИзмененияГода(Ответ, ДополнительныеПараметры) Экспорт 
	
	Если Ответ = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		// присваевам новый номер
		ОбработатьИзменениеГода();
	Иначе
		// восстанавливаем дату по ссылке
		ВосстановитьДатуДокумента();
	КонецЕсли; 
	
КонецПроцедуры

&НаСервере
Функция ГодИзменился()
	Возврат Год(Объект.Дата) <> Год(НачальнаяДатаДокумента);
КонецФункции


&НаСервере
Процедура ОбработатьИзменениеГода()

	НачальнаяДатаДокумента = Объект.Дата;
	ПолучитьНомер(); 
	
КонецПроцедуры 

&НаСервере
Процедура ПолучитьНомер()
	
	ДокументОбъект = РеквизитФормыВЗначение("Объект");
	ДокументОбъект.УстановитьНовыйНомер();
	ЗначениеВРеквизитФормы(ДокументОбъект,"Объект");
	
КонецПроцедуры

&НаСервере
Процедура ВосстановитьДатуДокумента()
	
	Объект.Дата = НачальнаяДатаДокумента;
	ДатаПриИзмененииНаСервере(); 
	
КонецПроцедуры

 &НаСервере
Процедура ДатаПриИзмененииНаСервере()
	
	// если очистили дату, то принудительно 
	// устанавливаем текущую дату
	Если Объект.Дата = Дата(1,1,1) Тогда
		Объект.Дата = CW_Документы.РабочееВремя();
	КонецЕсли;
	
КонецПроцедуры
//Изменение даты документа



&НаСервере
Процедура ПроверитьВозмоностьЗаполненияДокумента()  
	
	Дата = ?(Объект.Дата = Дата(1,1,1), ТекущаяДата(), Объект.Дата);
	
	ПараметрыУчетнойПолитики		= CW_Настройки.ПараметрыУчетнойПолитики(Дата, Объект.Организация);  
	ВариантУчетаНЗПУчетнойПолитики	= ПараметрыУчетнойПолитики["ВариантУчетаНЗП"];

	ОтключеноУчетнойПолитикой = Ложь;
	
	ЧастиЗаголовка = Новый Массив;
	Если ЗначениеЗаполнено(Объект.Организация) 
		И ВариантУчетаНЗПУчетнойПолитики <> ПредопределенноеЗначение("Перечисление.CW_ВариантУчетаНЗП.Директивно") Тогда 
		
		КлючЗаписи = ПолучитьКлючЗаписи(ПараметрыУчетнойПолитики["Период"]);
	    НавигационнаяСсылка = ПолучитьНавигационнуюСсылку(КлючЗаписи);
		
		ЧастиЗаголовка.Добавить(
		НСтр("ru = 'Редактирование документа невозможно: ведение директивного учета незавершенного производства отключено в <a href = """+СокрЛП(НавигационнаяСсылка)+""">учетной политике</a>.'"));

		ОтключеноУчетнойПолитикой = Истина;
		
	КонецЕсли;

	Элементы.ОтключеноУчетнойПолитикой.Заголовок 	= СтроковыеФункции.ФорматированнаяСтрока(СтрСоединить(ЧастиЗаголовка));
	Элементы.ОтключеноУчетнойПолитикой.Видимость 	= ОтключеноУчетнойПолитикой;
	Элементы.Страницы.Доступность 					= НЕ ОтключеноУчетнойПолитикой;
 	Элементы.ГруппаДокументРеализации.Доступность 	= НЕ ОтключеноУчетнойПолитикой;
	
КонецПроцедуры


&НаСервере
Функция ПолучитьКлючЗаписи(Период)
	
	ЗначенияКлюча = Новый Структура;
	ЗначенияКлюча.Вставить("Период", 		Период);
	ЗначенияКлюча.Вставить("Организация", 	Объект.Организация);
	
	Возврат РегистрыСведений.CW_УчетнаяПолитика.СоздатьКлючЗаписи(ЗначенияКлюча);
	
КонецФункции


