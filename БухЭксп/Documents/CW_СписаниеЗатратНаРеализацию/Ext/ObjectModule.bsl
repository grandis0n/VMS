
Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.CW_ДоходыПоГрузоперевозке") Тогда 
		
		ДанныеОснования = ДанныеЗаполнения;
		
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("Структура") 
		И ДанныеЗаполнения.Свойство("ДокументОснование") Тогда 
		
		ДанныеОснования = ДанныеЗаполнения.ДокументОснование;
		
	КонецЕсли; 
	
	Если ДанныеОснования <> Неопределено Тогда
		
		Дата			  			= ДанныеОснования.Дата;
		Организация       			= ДанныеОснования.Организация;
		ДокументОснование 			= ДанныеОснования;
		ПодразделениеОрганизации 	= ДанныеОснования.ПодразделениеОрганизации;
		
		РезультатЗапроса = ПолучитьДанныеДляЗаполненияТабличнойЧасти(ДанныеОснования);
		Затраты.Загрузить(РезультатЗапроса.Выгрузить());
		
	КонецЕсли;
	
КонецПроцедуры


Процедура ПолучитьИзРасходовПоГрузоперевозке(Движение)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СУММА(CW_РасходыПоГрузоперевозкам.Всего) КАК Всего,
		|	СУММА(CW_РасходыПоГрузоперевозкам.Количество) КАК Количество,
		|	СУММА(CW_РасходыПоГрузоперевозкам.Сумма) КАК Сумма,
		|	СУММА(CW_РасходыПоГрузоперевозкам.НДС) КАК НДС
		|ИЗ
		|	РегистрНакопления.CW_РасходыПоГрузоперевозкам КАК CW_РасходыПоГрузоперевозкам
		|ГДЕ
		|	CW_РасходыПоГрузоперевозкам.Грузоперевозка = &Грузоперевозка
		|	И CW_РасходыПоГрузоперевозкам.Контрагент = &Контрагент
		|	И CW_РасходыПоГрузоперевозкам.Договор = &Договор
		|	И CW_РасходыПоГрузоперевозкам.ПриложениеКДоговору = &ПриложениеКДоговору
		|	И CW_РасходыПоГрузоперевозкам.ДокументРасходов = &ДокументРасходов
		|	И CW_РасходыПоГрузоперевозкам.ПорядокОтражения = &ПорядокОтражения
		|	И CW_РасходыПоГрузоперевозкам.СтавкаНДС = &СтавкаНДС
		|	И CW_РасходыПоГрузоперевозкам.Номенклатура = &Номенклатура
		|	И CW_РасходыПоГрузоперевозкам.СтатьяЗатрат = &СтатьяЗатрат
		|	И CW_РасходыПоГрузоперевозкам.Подразделение = &Подразделение
		|	И CW_РасходыПоГрузоперевозкам.Валюта = &Валюта
		|	И CW_РасходыПоГрузоперевозкам.Покупатель = &Покупатель
		|	И CW_РасходыПоГрузоперевозкам.ДоговорПокупателя = &ДоговорПокупателя
		|	И CW_РасходыПоГрузоперевозкам.ПриложениеКДоговоруПокупателя = &ПриложениеКДоговоруПокупателя";
	
	Запрос.УстановитьПараметр("Валюта",							Движение.Валюта);
	Запрос.УстановитьПараметр("Грузоперевозка",					Движение.Грузоперевозка);
	Запрос.УстановитьПараметр("Договор",						Движение.Договор);
	Запрос.УстановитьПараметр("ДоговорПокупателя",				Движение.ДоговорПокупателя);
	Запрос.УстановитьПараметр("ДокументРасходов",				Движение.ДокументРасходов);
	Запрос.УстановитьПараметр("Контрагент",						Движение.Контрагент);
	Запрос.УстановитьПараметр("Номенклатура",					Движение.Номенклатура);
	Запрос.УстановитьПараметр("Подразделение",					Движение.Подразделение);
	Запрос.УстановитьПараметр("Покупатель",						Движение.Покупатель);
	Запрос.УстановитьПараметр("ПорядокОтражения",				Движение.ПорядокОтражения);
	Запрос.УстановитьПараметр("ПриложениеКДоговору",			Движение.ПриложениеКДоговору);
	Запрос.УстановитьПараметр("ПриложениеКДоговоруПокупателя",	Движение.ПриложениеКДоговоруПокупателя);
	Запрос.УстановитьПараметр("СтавкаНДС",						Движение.СтавкаНДС);
	Запрос.УстановитьПараметр("СтатьяЗатрат",					Движение.СтатьяЗатрат);
	
	Выборка = Запрос.Выполнить().Выбрать(); 
	
	Если Выборка.Следующий() Тогда  
		
		// Если списание выполняется по корректировочным документам, 
		// то в движениях количество может быть равным нулю. В этом случае
		// коэффициент всегда принимаем равным единице, т.е. списываем рубли 
		// в том значении в котором они были отражены в движениях 
		// корректировочного документа "Расходы по грузоперевозке" 
		Если Движение.Количество = 0 Тогда
			Коэффициент = 1;
		Иначе
			Коэффициент = Движение.Количество / ?(Выборка.Количество=0,1,Выборка.Количество);
		КонецЕсли;   
		
		Движение.Сумма	= Окр(Выборка.Сумма * Коэффициент, 2);
		Движение.НДС	= Окр(Выборка.НДС 	* Коэффициент, 2);
		Движение.Всего	= Окр(Выборка.Всего	* Коэффициент, 2);
		
	КонецЕсли;	

КонецПроцедуры


Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	Движения.CW_НезавершенноеПроизводство.Записывать 	= Истина;

	Движения.CW_НезавершенноеПроизводство.Очистить();
	Движения.CW_РасходыНаРеализацию.Очистить();


	//CW_НезавершенноеПроизводство
	РезультатЗапроса =  ПолучитьДанныеДляНезавершенногоПроизводства();

	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл

		Движение = Движения.CW_НезавершенноеПроизводство.ДобавитьРасход();
		ЗаполнитьЗначенияСвойств(Движение, Выборка);

		Коэффициент 	= Выборка.Количество / ?(Выборка.КоличествоОстаток=0,1,Выборка.КоличествоОстаток);
		Движение.Сумма	= Окр(Выборка.СуммаОстаток 	* Коэффициент, 2);
		Движение.НДС	= Окр(Выборка.НДСОстаток 	* Коэффициент, 2);
		Движение.Всего	= Окр(Выборка.ВсегоОстаток	* Коэффициент, 2);
		
		// выполняем проверку, если валютные суммы не равны нулю, а рублевые суммы равны нулю, 
		// то рублевый эквивалент расходов получим из регистра "CW_РасходыПОгрузоперевозке"
		// Такая ситуация может возникать когда делается попытка списать расходы на реализацию раньше, 
		// чем были получены эти расходы (подход допустим в целях управленческого учета). 
		Если НЕ Движение.Сумма И Движение.Сумма_Валюта
			ИЛИ НЕ Движение.НДС И Движение.НДС_Валюта
			ИЛИ НЕ Движение.Всего И Движение.Сумма_Валюта Тогда
			Если Движение.Валюта = Константы.ВалютаРегламентированногоУчета.Получить()Тогда
				Движение.Количество	= Выборка.Количество;		
				Движение.Сумма		= Выборка.Сумма_Валюта;		
				Движение.НДС		= Выборка.НДС_Валюта;		
				Движение.Всего		= Выборка.Всего_Валюта;		
			Иначе
				ПолучитьИзРасходовПоГрузоперевозке(Движение);
			КонецЕсли;	
		КонецЕсли;
		
		
	КонецЦикла;
	//CW_НезавершенноеПроизводство

	Движения.Записать();

	//Проверка остатков после записи
	РезультатЗапроса =  ПолучитьДанныеДляКонтроля();
	ВыборкаДокументы = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаДокументы.Следующий() Цикл

		МассивОстатки = новый Массив;
		Если ВыборкаДокументы.Сумма_ВалютаОстаток < 0 Тогда
			МассивОстатки.Добавить("Сумма: " +Формат(ВыборкаДокументы.Сумма_ВалютаОстаток, "ЧДЦ=2"));
		КонецЕсли;
		Если ВыборкаДокументы.НДС_ВалютаОстаток < 0 Тогда
			МассивОстатки.Добавить("НДС: " +Формат(ВыборкаДокументы.НДС_ВалютаОстаток, "ЧДЦ=2"));
		КонецЕсли;
		Если ВыборкаДокументы.Всего_ВалютаОстаток < 0 Тогда
			МассивОстатки.Добавить("Всего: " +Формат(ВыборкаДокументы.Всего_ВалютаОстаток, "ЧДЦ=2"));
		КонецЕсли;

		СтрокаОстаток = СтрСоединить(МассивОстатки, "; ");

		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("По документу расходов "+СокрЛП(ВыборкаДокументы.ДокументРасходов) + " остаток НЗП в валюте меньше 0 ("+СтрокаОстаток+")"); 
		Выборка = ВыборкаДокументы.Выбрать();
		Пока Выборка.Следующий() Цикл

			МассивОстатки = новый Массив;
			Если Выборка.Сумма_ВалютаОстаток < 0 Тогда
				МассивОстатки.Добавить("Сумма: " +Формат(Выборка.Сумма_ВалютаОстаток, "ЧДЦ=2"));
			КонецЕсли;
			Если Выборка.НДС_ВалютаОстаток < 0 Тогда
				МассивОстатки.Добавить("НДС: " +Формат(Выборка.НДС_ВалютаОстаток, "ЧДЦ=2"));
			КонецЕсли;
			Если Выборка.Всего_ВалютаОстаток < 0 Тогда
				МассивОстатки.Добавить("Всего: " +Формат(Выборка.Всего_ВалютаОстаток, "ЧДЦ=2"));
			КонецЕсли;

			СтрокаОстаток = СтрСоединить(МассивОстатки, "; ");

			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(" - "+СокрЛП(Выборка.Грузоперевозка) + " остаток "+СтрокаОстаток); 
		КонецЦикла;
	КонецЦикла;
	//Проверка остатков после записи

	//CW_РасходыНаРеализацию
	Движения.CW_РасходыНаРеализацию.Записывать = Истина;

	РезультатЗапроса = ПолучитьДанныеДляРасхдовНаРеализацию();

	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		Движение = Движения.CW_РасходыНаРеализацию.Добавить();
		ЗаполнитьЗначенияСвойств(Движение, Выборка);
		Движение.ДокументДоходов = ДокументОснование;
	КонецЦикла;
	//CW_РасходыНаРеализацию
	
КонецПроцедуры

Функция ПолучитьДанныеДляРасхдовНаРеализацию()
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	CW_НезавершенноеПроизводство.Период КАК Период,
	               |	CW_НезавершенноеПроизводство.Организация КАК Организация,
	               |	CW_НезавершенноеПроизводство.ПодразделениеОрганизации КАК ПодразделениеОрганизации,
	               |	CW_НезавершенноеПроизводство.Грузоперевозка КАК Грузоперевозка,
	               |	CW_НезавершенноеПроизводство.Контрагент КАК Контрагент,
	               |	CW_НезавершенноеПроизводство.Договор КАК Договор,
	               |	CW_НезавершенноеПроизводство.ПриложениеКДоговору КАК ПриложениеКДоговору,
	               |	CW_НезавершенноеПроизводство.ДокументРасходов КАК ДокументРасходов,
	               |	CW_НезавершенноеПроизводство.ПорядокОтражения КАК ПорядокОтражения,
	               |	CW_НезавершенноеПроизводство.СтавкаНДС КАК СтавкаНДС,
	               |	CW_НезавершенноеПроизводство.СпособУчетаНДС КАК СпособУчетаНДС,
	               |	CW_НезавершенноеПроизводство.Номенклатура КАК Номенклатура,
	               |	CW_НезавершенноеПроизводство.СтатьяЗатрат КАК СтатьяЗатрат,
	               |	CW_НезавершенноеПроизводство.Подразделение КАК Подразделение,
	               |	CW_НезавершенноеПроизводство.Валюта КАК Валюта,
	               |	CW_НезавершенноеПроизводство.Покупатель КАК Покупатель,
	               |	CW_НезавершенноеПроизводство.ДоговорПокупателя КАК ДоговорПокупателя,
	               |	CW_НезавершенноеПроизводство.ПриложениеКДоговоруПокупателя КАК ПриложениеКДоговоруПокупателя,
	               |	CW_НезавершенноеПроизводство.Количество КАК Количество,
	               |	CW_НезавершенноеПроизводство.Сумма КАК Сумма,
	               |	CW_НезавершенноеПроизводство.НДС КАК НДС,
	               |	CW_НезавершенноеПроизводство.Всего КАК Всего,
	               |	CW_НезавершенноеПроизводство.Сумма_Валюта КАК Сумма_Валюта,
	               |	CW_НезавершенноеПроизводство.НДС_Валюта КАК НДС_Валюта,
	               |	CW_НезавершенноеПроизводство.Всего_Валюта КАК Всего_Валюта,
	               |	ЕСТЬNULL(СоставГруппУслугПоПриложению.ГруппаУслуг, ЕСТЬNULL(СоставГруппУслугПоДоговору.ГруппаУслуг, НЕОПРЕДЕЛЕНО)) КАК ГруппаУслуг
	               |ИЗ
	               |	РегистрНакопления.CW_НезавершенноеПроизводство КАК CW_НезавершенноеПроизводство
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.CW_СоставГруппУслуг КАК СоставГруппУслугПоДоговору
	               |		ПО CW_НезавершенноеПроизводство.ДоговорПокупателя = СоставГруппУслугПоДоговору.Владелец
	               |			И CW_НезавершенноеПроизводство.Номенклатура = СоставГруппУслугПоДоговору.Услуга
	               |			И (CW_НезавершенноеПроизводство.ДоговорПокупателя.ИспользуетсяОграниченияПоГруппамУслуг = ИСТИНА)
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.CW_СоставГруппУслуг КАК СоставГруппУслугПоПриложению
	               |		ПО CW_НезавершенноеПроизводство.ПриложениеКДоговоруПокупателя = СоставГруппУслугПоПриложению.Владелец
	               |			И CW_НезавершенноеПроизводство.Номенклатура = СоставГруппУслугПоПриложению.Услуга
	               |			И (CW_НезавершенноеПроизводство.ПриложениеКДоговоруПокупателя.ИспользуетсяОграниченияПоГруппамУслуг = ИСТИНА)
	               |ГДЕ
	               |	CW_НезавершенноеПроизводство.Регистратор = &Регистратор";
	
	Запрос.УстановитьПараметр("Регистратор", Ссылка);
	
	Возврат Запрос.Выполнить();

КонецФункции

Функция ПолучитьДанныеДляНезавершенногоПроизводства()
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	CW_ДоходыПоГрузоперевозкеУслуги.Грузоперевозка КАК Грузоперевозка
	               |ПОМЕСТИТЬ ВТ_Грузоперевозки
	               |ИЗ
	               |	Документ.CW_ДоходыПоГрузоперевозке.Услуги КАК CW_ДоходыПоГрузоперевозкеУслуги
	               |ГДЕ
	               |	CW_ДоходыПоГрузоперевозкеУслуги.Ссылка = &ДокументОснование
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	CW_СписаниеЗатратНаРеализациюЗатраты.Ссылка.Организация КАК Организация,
	               |	CW_СписаниеЗатратНаРеализациюЗатраты.Ссылка.ПодразделениеОрганизации КАК ПодразделениеОрганизации,
	               |	CW_СписаниеЗатратНаРеализациюЗатраты.Ссылка КАК Ссылка,
	               |	CW_СписаниеЗатратНаРеализациюЗатраты.Ссылка.Дата КАК Период,
	               |	CW_СписаниеЗатратНаРеализациюЗатраты.Ссылка.ДокументОснование КАК ДокументДоходов,
	               |	CW_СписаниеЗатратНаРеализациюЗатраты.НомерСтроки КАК НомерСтроки,
	               |	CW_СписаниеЗатратНаРеализациюЗатраты.Грузоперевозка КАК Грузоперевозка,
	               |	CW_СписаниеЗатратНаРеализациюЗатраты.Контрагент КАК Контрагент,
	               |	CW_СписаниеЗатратНаРеализациюЗатраты.Договор КАК Договор,
	               |	CW_СписаниеЗатратНаРеализациюЗатраты.ПриложениеКДоговору КАК ПриложениеКДоговору,
	               |	CW_СписаниеЗатратНаРеализациюЗатраты.ДокументРасходов КАК ДокументРасходов,
	               |	CW_СписаниеЗатратНаРеализациюЗатраты.ПорядокОтражения КАК ПорядокОтражения,
	               |	CW_СписаниеЗатратНаРеализациюЗатраты.СтавкаНДС КАК СтавкаНДС,
	               |	CW_СписаниеЗатратНаРеализациюЗатраты.СпособУчетаНДС КАК СпособУчетаНДС,
	               |	CW_СписаниеЗатратНаРеализациюЗатраты.Номенклатура КАК Номенклатура,
