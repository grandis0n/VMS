	               |			И ВТ_ДанныеДокумента.ПриложениеКДоговору = ВТ_Остатки.ПриложениеКДоговору
	               |			И ВТ_ДанныеДокумента.ДокументРасходов = ВТ_Остатки.ДокументРасходов
	               |			И ВТ_ДанныеДокумента.ПорядокОтражения = ВТ_Остатки.ПорядокОтражения
	               |			И ВТ_ДанныеДокумента.СтавкаНДС = ВТ_Остатки.СтавкаНДС
	               |			И ВТ_ДанныеДокумента.СпособУчетаНДС = ВТ_Остатки.СпособУчетаНДС
	               |			И ВТ_ДанныеДокумента.Номенклатура = ВТ_Остатки.Номенклатура
	               |			И ВТ_ДанныеДокумента.СтатьяЗатрат = ВТ_Остатки.СтатьяЗатрат
	               |			И ВТ_ДанныеДокумента.Подразделение = ВТ_Остатки.Подразделение
	               |			И ВТ_ДанныеДокумента.Валюта = ВТ_Остатки.Валюта
	               |			И ВТ_ДанныеДокумента.Покупатель = ВТ_Остатки.Покупатель
	               |			И ВТ_ДанныеДокумента.ДоговорПокупателя = ВТ_Остатки.ДоговорПокупателя
	               |			И ВТ_ДанныеДокумента.ПриложениеКДоговоруПокупателя = ВТ_Остатки.ПриложениеКДоговоруПокупателя
	               |ИТОГИ
	               |	СУММА(Сумма_ВалютаОстаток),
	               |	СУММА(НДС_ВалютаОстаток),
	               |	СУММА(Всего_ВалютаОстаток)
	               |ПО
	               |	ДокументРасходов";
	
	Запрос.УстановитьПараметр("ДатаСреза", 			Новый Граница(Дата, ВидГраницы.Включая));
	Запрос.УстановитьПараметр("Ссылка", 			Ссылка);
	Запрос.УстановитьПараметр("ДокументОснование", 	ДокументОснование);
	
	Возврат Запрос.Выполнить();

КонецФункции

Функция ПолучитьДанныеДляЗаполненияТабличнойЧасти(ДанныеЗаполнения, Знач РезультатПодбора = Неопределено) Экспорт
	
	//ВНИМАНИЕ! В ТЕКСТЕ ЗАПРОСА "//УсловиеКОРП"
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Если РезультатПодбора <> Неопределено Тогда
		Запрос.Текст = "ВЫБРАТЬ
		|	РезультатПодбора.ДокументРасходов КАК ДокументРасходов,
		|	РезультатПодбора.Номенклатура КАК Номенклатура
		|ПОМЕСТИТЬ ВТ_РезультатПодбора
		|ИЗ
		|	&РезультатПодбора КАК РезультатПодбора";
		
		Запрос.УстановитьПараметр("РезультатПодбора",		РезультатПодбора);
		Запрос.Выполнить();
		
	КонецЕсли;
	//Иначе
		
	Запрос.Текст = "ВЫБРАТЬ
	|	CW_ДоходыПоГрузоперевозкеУслуги.Грузоперевозка КАК Грузоперевозка
	|ПОМЕСТИТЬ ВТ_Грузоперевозки
	|ИЗ
	|	Документ.CW_ДоходыПоГрузоперевозке.Услуги КАК CW_ДоходыПоГрузоперевозкеУслуги
	|ГДЕ
	|	CW_ДоходыПоГрузоперевозкеУслуги.Ссылка = &Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	CW_ДоходыПоГрузоперевозкеУслуги.Грузоперевозка";
	
	Запрос.УстановитьПараметр("Ссылка", ДанныеЗаполнения.Ссылка);
	Запрос.Выполнить();
	//КонецЕсли;
	
	Запрос.Текст = "ВЫБРАТЬ
	|	CW_НезавершенноеПроизводствоОстатки.Грузоперевозка КАК Грузоперевозка,
	|	CW_НезавершенноеПроизводствоОстатки.Контрагент КАК Контрагент,
	|	CW_НезавершенноеПроизводствоОстатки.Договор КАК Договор,
	|	CW_НезавершенноеПроизводствоОстатки.ПриложениеКДоговору КАК ПриложениеКДоговору,
	|	CW_НезавершенноеПроизводствоОстатки.ДокументРасходов КАК ДокументРасходов,
	|	CW_НезавершенноеПроизводствоОстатки.ПорядокОтражения КАК ПорядокОтражения,
	|	CW_НезавершенноеПроизводствоОстатки.СтавкаНДС КАК СтавкаНДС,
	|	CW_НезавершенноеПроизводствоОстатки.СпособУчетаНДС КАК СпособУчетаНДС,
	|	CW_НезавершенноеПроизводствоОстатки.Номенклатура КАК Номенклатура,
	|	CW_НезавершенноеПроизводствоОстатки.СтатьяЗатрат КАК СтатьяЗатрат,
	|	CW_НезавершенноеПроизводствоОстатки.Подразделение КАК Подразделение,
	|	CW_НезавершенноеПроизводствоОстатки.Валюта КАК Валюта,
	|	CW_НезавершенноеПроизводствоОстатки.КоличествоОстаток КАК Количество,
	|	CW_НезавершенноеПроизводствоОстатки.Сумма_ВалютаОстаток КАК Сумма_Валюта,
	|	CW_НезавершенноеПроизводствоОстатки.НДС_ВалютаОстаток КАК НДС_Валюта,
	|	CW_НезавершенноеПроизводствоОстатки.Всего_ВалютаОстаток КАК Всего_Валюта
	|ИЗ
	|	РегистрНакопления.CW_НезавершенноеПроизводство.Остатки(
	|			&ДатаСреза,
	|			Организация = &Организация  
	|			И Грузоперевозка В
	|					(ВЫБРАТЬ
	|						ВТ_Грузоперевозки.Грузоперевозка КАК Грузоперевозка
	|					ИЗ
	|						ВТ_Грузоперевозки КАК ВТ_Грузоперевозки)	
	|			И Покупатель = &Покупатель
	|				И ДоговорПокупателя = &ДоговорПокупателя
	|				И ПриложениеКДоговоруПокупателя = &ПриложениеКДоговору
	|			//УсловиеКОРП
	|			//УсловияОстатков
	|				) КАК CW_НезавершенноеПроизводствоОстатки";
	
	//Для версии КОРП
	Если ПолучитьФункциональнуюОпцию("ВестиУчетПоПодразделениям") Тогда
		
		ПодразделениеОрганизации 	= ДанныеЗаполнения.ПодразделениеОрганизации;
		Запрос.Текст 				= СтрЗаменить(Запрос.Текст, "//УсловиеКОРП","И ПодразделениеОрганизации = &ПодразделениеОрганизации");
		Запрос.УстановитьПараметр("ПодразделениеОрганизации", ПодразделениеОрганизации);
		
	КонецЕсли;
	//Для версии КОРП
	
	Если РезультатПодбора <> Неопределено Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "//УсловияОстатков",	
		"И (ДокументРасходов, Номенклатура) В
		|	(ВЫБРАТЬ
		|		ВТ_РезультатПодбора.ДокументРасходов КАК ДокументРасходов,
		|		ВТ_РезультатПодбора.Номенклатура КАК Номенклатура
		|	ИЗ
		|	    ВТ_РезультатПодбора КАК ВТ_РезультатПодбора)");
	КонецЕсли;

	Запрос.УстановитьПараметр("Покупатель",				ДанныеЗаполнения.Контрагент);
	Запрос.УстановитьПараметр("ДоговорПокупателя", 		ДанныеЗаполнения.Договор);
	Запрос.УстановитьПараметр("ПриложениеКДоговору",	ДанныеЗаполнения.ПриложениеКДоговору);
	
	ДатаСреза = ?(ДанныеЗаполнения.Дата = Дата(1,1,1), ТекущаяДата(), ДанныеЗаполнения.Дата);
	
	Запрос.УстановитьПараметр("ДатаСреза", 				ДатаСреза);
	Запрос.УстановитьПараметр("Организация",			ДанныеЗаполнения.Организация);

	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат РезультатЗапроса;
	
КонецФункции

