
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// ---------------------------------------------------------------------------- 
	
	ЗначениеКопирования = Параметры.ЗначениеКопирования;
	Если (ЗначениеЗаполнено(ЗначениеКопирования)) Тогда
		АдресПрайса = ПоместитьВоВременноеХранилище(ЗначениеКопирования.ХранилищеПрайса.Получить(),ЭтаФорма.УникальныйИдентификатор);
	Иначе
		АдресПрайса = ПоместитьВоВременноеХранилище(РеквизитФормыВЗначение("Объект").ХранилищеПрайса.Получить(),ЭтаФорма.УникальныйИдентификатор);	
		Если (Объект.Ссылка.Пустая()) Тогда
			Объект.ВидКонтрагента = Перечисления.CW_ВидыКонтрагентов.Поставщик;	
		КонецЕсли; 
	КонецЕсли; 
	
	_СформироватьЗаголовок();
	
	//Внешние подклчюаемые команды
	CW_ПодключаемыеКомандыСервер.ПриСозданииНаСервере(ЭтотОбъект);

	
КонецПроцедуры

