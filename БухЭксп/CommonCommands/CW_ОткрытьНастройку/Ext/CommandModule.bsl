
&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)
	
	
	КлючОбъекта = _УФК.ПолучитьКлючьОбъектаПоИмениИсточника(ПараметрыВыполненияКоманды.Источник);
	
	ПараметрыФормы = Новый Структура("КлючОбъекта,РежимОткрытия,РежимВыбора,ИмяФормыВладельца,СкрытьВозможностьОтбора",КлючОбъекта,"Загрузка",Истина,ПараметрыВыполненияКоманды.Источник.ИмяФормы, Истина);
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ОткрытьНастройкуОтчета", ПараметрыВыполненияКоманды.Источник, ПараметрыФормы);
	ОткрытьФорму("Справочник.CW_НастройкиПользователей.Форма.ФормаУправленияНастройками", ПараметрыФормы,,,,, ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры
