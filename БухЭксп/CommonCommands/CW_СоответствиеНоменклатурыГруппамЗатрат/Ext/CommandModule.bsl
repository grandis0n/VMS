
&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)
	
	МассивЭлементов = ПараметрКоманды;
	ПОВ = Новый ОписаниеОповещения("ОбработкаВыбораГЗ",ЭтотОбъект, Новый Структура("МассивЭлементов",МассивЭлементов)); 
	ОткрытьФорму("Справочник.CW_ГруппыЗатрат.ФормаВыбора",,,Истина,,,ПОВ,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбораГЗ(Ответ, ДополнительныеПараметры) Экспорт 
	
	Если (Ответ <> Неопределено) Тогда
		_УстановитьСоответствие(ДополнительныеПараметры.МассивЭлементов, Ответ);
	КонецЕсли; 
	
КонецПроцедуры

&НаСервере
Процедура _УстановитьСоответствие(Ном, Ответ)
	
	Рег = РегистрыСведений.CW_СоответствиеНоменклатурыГруппамЗатрат.СоздатьНаборЗаписей();
	Рег.Отбор.Номенклатура.Установить(Ном);
	Рег.Прочитать();
	Если Рег.Количество() = 0 Тогда
		Запись = Рег.Добавить();
		Запись.Номенклатура = Ном;
		Запись.ГруппаЗатрат = Ответ;
	Иначе	
		Рег[0].ГруппаЗатрат = Ответ;
	КонецЕсли;
	
	Рег.Записать(Истина);
			
КонецПроцедуры