
&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)
	
	МассивГруппировок 	= _ПолучитьГруппировкиПоДокументу(ПараметрКоманды);
	Отбор 				= _ПолучитьОтборПоДокументу(ПараметрКоманды);
	Параметры 			= _ПолучитьПараметрыОтчета(ПараметрКоманды);
	
	ПФ = Новый Структура("ВнешнийВызов,Отбор,Группировки,Параметры", Истина, Отбор, МассивГруппировок,Параметры);
	ОткрытьФорму("Отчет.CW_ВедомостьПеревыставленияЗатрат.Форма.ФормаОтчетаУправляемая", ПФ,,Истина);
	
КонецПроцедуры   

&НаСервере
Функция _ПолучитьПараметрыОтчета(ПараметрКоманды)
	// --- 
	
	МинимальнаяДата		= НачалоДня(ТекущаяДата());
	МаксимальнаяДата	= КонецДня(ТекущаяДата());
	
	Если (ТипЗнч(ПараметрКоманды)=Тип("ДокументСсылка.CW_ДоходыПоГрузоперевозке")) 
		ИЛИ (ТипЗнч(ПараметрКоманды)=Тип("ДокументСсылка.CW_ОтчетЭкспедитора")) Тогда
		
		МинимальнаяДатаПоГрузоперевозкам	= НачалоДня(ТекущаяДата());
		МинимальнаяДатаПоРасходам 			= НачалоДня(ТекущаяДата());
		
		Если  ТипЗнч(ПараметрКоманды)=Тип("ДокументСсылка.CW_ДоходыПоГрузоперевозке") Тогда
			мДоходыПоГрузоперевозке = новый Массив;
			мДоходыПоГрузоперевозке.Добавить(ПараметрКоманды);
		Иначе
			СтруктураДанныхДокумента = Документы.CW_ОтчетЭкспедитора.ПолучитьДанныеДокумента(ПараметрКоманды);
			мДоходыПоГрузоперевозке  = СтруктураДанныхДокумента.ДоходыПоГрузоперевозке;
		КонецЕсли;
		
		мГрузопереовзки = CW_Финансы.ГрузоперевозкиДокумента(ПараметрКоманды);
		
		//Получение минимальной даты грузопереовозок
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	МИНИМУМ(CW_Грузоперевозки.ДатаСделкиФ) КАК Дата
		               |ПОМЕСТИТЬ ВТ_ДатаГрузоперевозок
		               |ИЗ
		               |	Справочник.CW_Грузоперевозки КАК CW_Грузоперевозки
		               |ГДЕ
		               |	CW_Грузоперевозки.Ссылка В(&мГрузопереовзки)
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ
		               |	МИНИМУМ(CW_ДоходыПоГрузоперевозкеУслуги.ДокументРасходов.Дата) КАК Дата
		               |ПОМЕСТИТЬ ВТ_ДатаРасходов
		               |ИЗ
		               |	Документ.CW_ДоходыПоГрузоперевозке.Услуги КАК CW_ДоходыПоГрузоперевозкеУслуги
		               |ГДЕ
		               |	CW_ДоходыПоГрузоперевозкеУслуги.Ссылка В (&мДоходыПоГрузоперевозке)
		               |	И НЕ CW_ДоходыПоГрузоперевозкеУслуги.ДокументРасходов = ЗНАЧЕНИЕ(Документ.CW_РасходыПоГрузоперевозке.ПустаяСсылка)
		               |	И CW_ДоходыПоГрузоперевозкеУслуги.Ссылка.Проведен
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ
		               |	ЕСТЬNULL(ВТ_ДатаГрузоперевозок.Дата, &МинимальнаяДата) КАК Дата
		               |ПОМЕСТИТЬ ВТ_ДАТЫ
		               |ИЗ
		               |	ВТ_ДатаГрузоперевозок КАК ВТ_ДатаГрузоперевозок
		               |
		               |ОБЪЕДИНИТЬ ВСЕ
		               |
		               |ВЫБРАТЬ
		               |	ЕСТЬNULL(ВТ_ДатаРасходов.Дата, &МинимальнаяДата)
		               |ИЗ
		               |	ВТ_ДатаРасходов КАК ВТ_ДатаРасходов
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ ПЕРВЫЕ 1
		               |	ВТ_ДАТЫ.Дата КАК Дата
		               |ИЗ
		               |	ВТ_ДАТЫ КАК ВТ_ДАТЫ
		               |
		               |УПОРЯДОЧИТЬ ПО
		               |	Дата
		               |АВТОУПОРЯДОЧИВАНИЕ";
		
		Запрос.УстановитьПараметр("мГрузопереовзки"				, мГрузопереовзки);
		Запрос.УстановитьПараметр("мДоходыПоГрузоперевозке"		, мДоходыПоГрузоперевозке);
		Запрос.УстановитьПараметр("МинимальнаяДата"				, МинимальнаяДата);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		Выборка = РезультатЗапроса.Выбрать();
		Если Выборка.Следующий() тогда
			Если Выборка.Дата <> null Тогда
				МинимальнаяДатаПоГрузоперевозкам = Выборка.Дата;
			Конецесли;
		КонецЕсли;
		
		МинимальнаяДата 	= Мин(МинимальнаяДата,МинимальнаяДатаПоГрузоперевозкам);
		
		Если  ТипЗнч(ПараметрКоманды)=Тип("ДокументСсылка.CW_ДоходыПоГрузоперевозке") Тогда
			МаксимальнаяДата	= МАКС(ПараметрКоманды.ДатаАкта, ПараметрКоманды.ДатаСчета, ПараметрКоманды.Дата);
		Иначе
			МаксимальнаяДата		 = МАКС(СтруктураДанныхДокумента.МаксДатаПервичногоДокумента, СтруктураДанныхДокумента.ДатаДок);
		КонецЕсли;
		
	ИначеЕсли (ТипЗнч(ПараметрКоманды)=Тип("ДокументСсылка.CW_РасходыПоГрузоперевозке")) Тогда 
		
		//получение минимальной даты
		ДатаДокумента 	= ПараметрКоманды.Дата; 
		ДатаСчета 		= ПараметрКоманды.Дата;
		ДатаАкта 		= ПараметрКоманды.Дата;
		ДатаСФ 			= ПараметрКоманды.Дата;
		
		Если ПараметрКоманды.ПредъявленСчет И ПараметрКоманды.ДатаСчета <> Дата(1,1,1)  Тогда
			ДатаСчета = ПараметрКоманды.ДатаСчета;
		КонецЕсли; 
		Если ПараметрКоманды.ПредъявленАкт И ПараметрКоманды.ДатаАкта <> Дата(1,1,1)  Тогда
			ДатаАкта = ПараметрКоманды.ДатаАкта;
		КонецЕсли; 
		Если ПараметрКоманды.ПредъявленСФ И ПараметрКоманды.ДатаСФ <> Дата(1,1,1) Тогда
			ДатаСФ	= ПараметрКоманды.ДатаСФ;
		КонецЕсли; 
		
		МинимальнаяДата = Мин(ДатаДокумента,ДатаСчета,ДатаАкта,ДатаСФ);
		
		//получение максимальной даты  МАКСИМУМ  ПЕРВЫЕ 1
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
		               |	CW_ДоходыПоГрузоперевозкеУслуги.Ссылка.Дата КАК Дата
		               |ИЗ
		               |	Документ.CW_ДоходыПоГрузоперевозке.Услуги КАК CW_ДоходыПоГрузоперевозкеУслуги
		               |ГДЕ
		               |	CW_ДоходыПоГрузоперевозкеУслуги.ДокументРасходов = &Ссылка
		               |	И CW_ДоходыПоГрузоперевозкеУслуги.Ссылка.Проведен
		               |
		               |УПОРЯДОЧИТЬ ПО
		               |	Дата УБЫВ
		               |АВТОУПОРЯДОЧИВАНИЕ";
		
		Запрос.УстановитьПараметр("Ссылка"				, ПараметрКоманды);
		Запрос.УстановитьПараметр("МаксимальнаяДата"	, МаксимальнаяДата);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		Выборка = РезультатЗапроса.Выбрать();
		Если Выборка.Следующий() тогда
			Если Выборка.Дата <> null Тогда
				МаксимальнаяДата = Выборка.Дата;
			Конецесли;
		КонецЕсли;
		
	ИначеЕсли (ТипЗнч(ПараметрКоманды)=Тип("СправочникСсылка.CW_Грузоперевозки")) Тогда
		
		Запрос_ВходяиеДокументы = Новый Запрос;
		Запрос_ВходяиеДокументы.Текст = "ВЫБРАТЬ
		                                |	CW_РасходыПоГрузоперевозкамОбороты.Грузоперевозка КАК Грузоперевозка,
		                                |	МИНИМУМ(CW_РасходыПоГрузоперевозкамОбороты.ДокументРасходов.Дата) КАК ДатаДокументов,
		                                |	МИНИМУМ(ВЫБОР
		                                |			КОГДА CW_РасходыПоГрузоперевозкамОбороты.ДокументРасходов.ПредъявленСчет
		                                |				ТОГДА ВЫБОР
		                                |						КОГДА CW_РасходыПоГрузоперевозкамОбороты.ДокументРасходов.ДатаСчета = &ПустаяДата
		                                |							ТОГДА CW_РасходыПоГрузоперевозкамОбороты.ДокументРасходов.Дата
		                                |						ИНАЧЕ CW_РасходыПоГрузоперевозкамОбороты.ДокументРасходов.ДатаСчета
		                                |					КОНЕЦ
		                                |			ИНАЧЕ CW_РасходыПоГрузоперевозкамОбороты.ДокументРасходов.ДатаСчета
		                                |		КОНЕЦ) КАК ДатаСчета,
		                                |	МИНИМУМ(ВЫБОР
		                                |			КОГДА CW_РасходыПоГрузоперевозкамОбороты.ДокументРасходов.ПредъявленАкт
		                                |				ТОГДА ВЫБОР
		                                |						КОГДА CW_РасходыПоГрузоперевозкамОбороты.ДокументРасходов.НомерАкта = &ПустаяДата
		                                |							ТОГДА CW_РасходыПоГрузоперевозкамОбороты.ДокументРасходов.Дата
		                                |						ИНАЧЕ CW_РасходыПоГрузоперевозкамОбороты.ДокументРасходов.ДатаАкта
		                                |					КОНЕЦ
		                                |			ИНАЧЕ CW_РасходыПоГрузоперевозкамОбороты.ДокументРасходов.ДатаАкта
		                                |		КОНЕЦ) КАК ДатаАкта,
		                                |	МИНИМУМ(ВЫБОР
		                                |			КОГДА CW_РасходыПоГрузоперевозкамОбороты.ДокументРасходов.ПредъявленСФ
		                                |				ТОГДА ВЫБОР
		                                |						КОГДА CW_РасходыПоГрузоперевозкамОбороты.ДокументРасходов.ДатаСФ = &ПустаяДата
		                                |							ТОГДА CW_РасходыПоГрузоперевозкамОбороты.ДокументРасходов.Дата
		                                |						ИНАЧЕ CW_РасходыПоГрузоперевозкамОбороты.ДокументРасходов.ДатаСФ
		                                |					КОНЕЦ
		                                |			ИНАЧЕ CW_РасходыПоГрузоперевозкамОбороты.ДокументРасходов.ДатаСФ
		                                |		КОНЕЦ) КАК ДатаСчф
		                                |ИЗ
		                                |	РегистрНакопления.CW_РасходыПоГрузоперевозкам.Обороты(, , Период, Грузоперевозка = &Грузоперевозка) КАК CW_РасходыПоГрузоперевозкамОбороты
		                                |
		                                |СГРУППИРОВАТЬ ПО
		                                |	CW_РасходыПоГрузоперевозкамОбороты.Грузоперевозка";
		
		Запрос_ВходяиеДокументы.УстановитьПараметр("Грузоперевозка"	, ПараметрКоманды);
		Запрос_ВходяиеДокументы.УстановитьПараметр("ПустаяДата"		, Дата(1,1,1));
		
		Результат_ВходяиеДокументы = Запрос_ВходяиеДокументы.Выполнить();
		
		МинимальнаяДата = ПараметрКоманды.ДатаСделкиФ;
		
		Если Не Результат_ВходяиеДокументы.Пустой() Тогда
			Выборка_ВходяиеДокументы = Результат_ВходяиеДокументы.Выбрать();
			Если  Выборка_ВходяиеДокументы.Следующий() Тогда
				МинимальнаяДата = МИН(Выборка_ВходяиеДокументы.ДатаДокументов,
									Выборка_ВходяиеДокументы.ДатаСчета,
									Выборка_ВходяиеДокументы.ДатаАкта,
									Выборка_ВходяиеДокументы.ДатаСчф);
			Конецесли;
		КонецЕсли;
		
		Запрос_ИсходящиеДокументы = Новый Запрос;
		Запрос_ИсходящиеДокументы.Текст = "ВЫБРАТЬ
		                                  |	CW_ДоходыПоГрузоперевозкамОбороты.Грузоперевозка КАК Грузоперевозка,
		                                  |	МАКСИМУМ(CW_ДоходыПоГрузоперевозкамОбороты.ДокументДоходов.Дата) КАК ДатаДокументов,
		                                  |	МАКСИМУМ(ВЫБОР
		                                  |			КОГДА НЕ CW_ДоходыПоГрузоперевозкамОбороты.ДокументДоходов.ФормируетсяСчет
		                                  |				ТОГДА CW_ДоходыПоГрузоперевозкамОбороты.ДокументДоходов.Дата
		                                  |			ИНАЧЕ ВЫБОР
		                                  |					КОГДА CW_ДоходыПоГрузоперевозкамОбороты.ДокументДоходов.ДатаСчета = &ПустаяДата
		                                  |						ТОГДА CW_ДоходыПоГрузоперевозкамОбороты.ДокументДоходов.Дата
		                                  |					ИНАЧЕ CW_ДоходыПоГрузоперевозкамОбороты.ДокументДоходов.ДатаСчета
		                                  |				КОНЕЦ
		                                  |		КОНЕЦ) КАК ДатаСчета,
		                                  |	МАКСИМУМ(ВЫБОР
		                                  |			КОГДА НЕ CW_ДоходыПоГрузоперевозкамОбороты.ДокументДоходов.ФормируетсяАкт
		                                  |				ТОГДА CW_ДоходыПоГрузоперевозкамОбороты.ДокументДоходов.Дата
		                                  |			ИНАЧЕ ВЫБОР
		                                  |					КОГДА CW_ДоходыПоГрузоперевозкамОбороты.ДокументДоходов.НомерАкта = &ПустаяДата
		                                  |						ТОГДА CW_ДоходыПоГрузоперевозкамОбороты.ДокументДоходов.Дата
		                                  |					ИНАЧЕ CW_ДоходыПоГрузоперевозкамОбороты.ДокументДоходов.ДатаАкта
		                                  |				КОНЕЦ
		                                  |		КОНЕЦ) КАК ДатаАкта,
		                                  |	МАКСИМУМ(ВЫБОР
		                                  |			КОГДА НЕ CW_ДоходыПоГрузоперевозкамОбороты.ДокументДоходов.ФормируетсяСчетФактура
		                                  |				ТОГДА CW_ДоходыПоГрузоперевозкамОбороты.ДокументДоходов.Дата
		                                  |			ИНАЧЕ ВЫБОР
		                                  |					КОГДА CW_ДоходыПоГрузоперевозкамОбороты.ДокументДоходов.ДатаСчетаФактуры = &ПустаяДата
		                                  |						ТОГДА CW_ДоходыПоГрузоперевозкамОбороты.ДокументДоходов.Дата
		                                  |					ИНАЧЕ CW_ДоходыПоГрузоперевозкамОбороты.ДокументДоходов.ДатаСчетаФактуры
		                                  |				КОНЕЦ
		                                  |		КОНЕЦ) КАК ДатаСчф
		                                  |ИЗ
		                                  |	РегистрНакопления.CW_ДоходыПоГрузоперевозкам.Обороты(, , Период, Грузоперевозка = &Грузоперевозка) КАК CW_ДоходыПоГрузоперевозкамОбороты
		                                  |
		                                  |СГРУППИРОВАТЬ ПО
		                                  |	CW_ДоходыПоГрузоперевозкамОбороты.Грузоперевозка";
		
		Запрос_ИсходящиеДокументы.УстановитьПараметр("Грузоперевозка", ПараметрКоманды);
		Запрос_ИсходящиеДокументы.УстановитьПараметр("ПустаяДата"		, Дата(1,1,1));
		
		Результат_ИсходящиеДокументы = Запрос_ИсходящиеДокументы.Выполнить();
		
		Если Не Результат_ИсходящиеДокументы.Пустой() Тогда
			Выборка_ИсходящиеДокумент = Результат_ИсходящиеДокументы.Выбрать();
			Если  Выборка_ИсходящиеДокумент.Следующий()  Тогда
				МаксимальнаяДата = Макс(Выборка_ИсходящиеДокумент.ДатаДокументов,
										Выборка_ИсходящиеДокумент.ДатаСчета,
										Выборка_ИсходящиеДокумент.ДатаАкта,
										Выборка_ИсходящиеДокумент.ДатаСчф);
			Конецесли;
		КонецЕсли;
		
		
	ИначеЕсли (ТипЗнч(ПараметрКоманды)=Тип("СправочникСсылка.CW_Заказы")) Тогда
		
		Запрос_ВходяиеДокументы = Новый Запрос;
		Запрос_ВходяиеДокументы.Текст = "ВЫБРАТЬ
		                                |	CW_РасходыПоГрузоперевозкамОбороты.Грузоперевозка КАК Грузоперевозка,
		                                |	МИНИМУМ(CW_РасходыПоГрузоперевозкамОбороты.ДокументРасходов.Дата) КАК ДатаДокументов,
		                                |	МИНИМУМ(ВЫБОР
		                                |			КОГДА CW_РасходыПоГрузоперевозкамОбороты.ДокументРасходов.ПредъявленСчет
		                                |				ТОГДА ВЫБОР
		                                |						КОГДА CW_РасходыПоГрузоперевозкамОбороты.ДокументРасходов.ДатаСчета = &ПустаяДата
		                                |							ТОГДА CW_РасходыПоГрузоперевозкамОбороты.ДокументРасходов.Дата
		                                |						ИНАЧЕ CW_РасходыПоГрузоперевозкамОбороты.ДокументРасходов.ДатаСчета
		                                |					КОНЕЦ
		                                |			ИНАЧЕ CW_РасходыПоГрузоперевозкамОбороты.ДокументРасходов.ДатаСчета
		                                |		КОНЕЦ) КАК ДатаСчета,
		                                |	МИНИМУМ(ВЫБОР
		                                |			КОГДА CW_РасходыПоГрузоперевозкамОбороты.ДокументРасходов.ПредъявленАкт
		                                |				ТОГДА ВЫБОР
		                                |						КОГДА CW_РасходыПоГрузоперевозкамОбороты.ДокументРасходов.НомерАкта = &ПустаяДата
		                                |							ТОГДА CW_РасходыПоГрузоперевозкамОбороты.ДокументРасходов.Дата
		                                |						ИНАЧЕ CW_РасходыПоГрузоперевозкамОбороты.ДокументРасходов.ДатаАкта
		                                |					КОНЕЦ
		                                |			ИНАЧЕ CW_РасходыПоГрузоперевозкамОбороты.ДокументРасходов.ДатаАкта
		                                |		КОНЕЦ) КАК ДатаАкта,
		                                |	МИНИМУМ(ВЫБОР
		                                |			КОГДА CW_РасходыПоГрузоперевозкамОбороты.ДокументРасходов.ПредъявленСФ
		                                |				ТОГДА ВЫБОР
		                                |						КОГДА CW_РасходыПоГрузоперевозкамОбороты.ДокументРасходов.ДатаСФ = &ПустаяДата
		                                |							ТОГДА CW_РасходыПоГрузоперевозкамОбороты.ДокументРасходов.Дата
		                                |						ИНАЧЕ CW_РасходыПоГрузоперевозкамОбороты.ДокументРасходов.ДатаСФ
		                                |					КОНЕЦ
		                                |			ИНАЧЕ CW_РасходыПоГрузоперевозкамОбороты.ДокументРасходов.ДатаСФ
		                                |		КОНЕЦ) КАК ДатаСчф
		                                |ИЗ
		                                |	РегистрНакопления.CW_РасходыПоГрузоперевозкам.Обороты(, , Период, Грузоперевозка.Заказ = &Заказ) КАК CW_РасходыПоГрузоперевозкамОбороты
		                                |
		                                |СГРУППИРОВАТЬ ПО
		                                |	CW_РасходыПоГрузоперевозкамОбороты.Грузоперевозка";
		
		
		Запрос_ВходяиеДокументы.УстановитьПараметр("Заказ", ПараметрКоманды);
		Запрос_ВходяиеДокументы.УстановитьПараметр("ПустаяДата"		, Дата(1,1,1));
		
		Результат_ВходяиеДокументы = Запрос_ВходяиеДокументы.Выполнить();
		
		МинимальнаяДата = ПараметрКоманды.ДатаСделкиФ;
		
		Если Не Результат_ВходяиеДокументы.Пустой() Тогда
			Выборка_ВходяиеДокументы = Результат_ВходяиеДокументы.Выбрать();
			Если  Выборка_ВходяиеДокументы.Следующий() Тогда
				МинимальнаяДата = МИН(Выборка_ВходяиеДокументы.ДатаДокументов,
									Выборка_ВходяиеДокументы.ДатаСчета,
									Выборка_ВходяиеДокументы.ДатаАкта,
									Выборка_ВходяиеДокументы.ДатаСчф);
			Конецесли;
		КонецЕсли;
		
		Запрос_ИсходящиеДокументы = Новый Запрос;
		Запрос_ИсходящиеДокументы.Текст = "ВЫБРАТЬ
		                                  |	CW_ДоходыПоГрузоперевозкамОбороты.Грузоперевозка КАК Грузоперевозка,
		                                  |	МАКСИМУМ(CW_ДоходыПоГрузоперевозкамОбороты.ДокументДоходов.Дата) КАК ДатаДокументов,
		                                  |	МАКСИМУМ(ВЫБОР
		                                  |			КОГДА НЕ CW_ДоходыПоГрузоперевозкамОбороты.ДокументДоходов.ФормируетсяСчет
		                                  |				ТОГДА CW_ДоходыПоГрузоперевозкамОбороты.ДокументДоходов.Дата
		                                  |			ИНАЧЕ ВЫБОР
		                                  |					КОГДА CW_ДоходыПоГрузоперевозкамОбороты.ДокументДоходов.ДатаСчета = &ПустаяДата
		                                  |						ТОГДА CW_ДоходыПоГрузоперевозкамОбороты.ДокументДоходов.Дата
		                                  |					ИНАЧЕ CW_ДоходыПоГрузоперевозкамОбороты.ДокументДоходов.ДатаСчета
		                                  |				КОНЕЦ
		                                  |		КОНЕЦ) КАК ДатаСчета,
		                                  |	МАКСИМУМ(ВЫБОР
		                                  |			КОГДА НЕ CW_ДоходыПоГрузоперевозкамОбороты.ДокументДоходов.ФормируетсяАкт
		                                  |				ТОГДА CW_ДоходыПоГрузоперевозкамОбороты.ДокументДоходов.Дата
		                                  |			ИНАЧЕ ВЫБОР
		                                  |					КОГДА CW_ДоходыПоГрузоперевозкамОбороты.ДокументДоходов.НомерАкта = &ПустаяДата
		                                  |						ТОГДА CW_ДоходыПоГрузоперевозкамОбороты.ДокументДоходов.Дата
		                                  |					ИНАЧЕ CW_ДоходыПоГрузоперевозкамОбороты.ДокументДоходов.ДатаАкта
		                                  |				КОНЕЦ
		                                  |		КОНЕЦ) КАК ДатаАкта,
		                                  |	МАКСИМУМ(ВЫБОР
		                                  |			КОГДА НЕ CW_ДоходыПоГрузоперевозкамОбороты.ДокументДоходов.ФормируетсяСчетФактура
		                                  |				ТОГДА CW_ДоходыПоГрузоперевозкамОбороты.ДокументДоходов.Дата
		                                  |			ИНАЧЕ ВЫБОР
		                                  |					КОГДА CW_ДоходыПоГрузоперевозкамОбороты.ДокументДоходов.ДатаСчетаФактуры = &ПустаяДата
		                                  |						ТОГДА CW_ДоходыПоГрузоперевозкамОбороты.ДокументДоходов.Дата
		                                  |					ИНАЧЕ CW_ДоходыПоГрузоперевозкамОбороты.ДокументДоходов.ДатаСчетаФактуры
		                                  |				КОНЕЦ
		                                  |		КОНЕЦ) КАК ДатаСчф
		                                  |ИЗ
		                                  |	РегистрНакопления.CW_ДоходыПоГрузоперевозкам.Обороты(, , Период, Грузоперевозка.Заказ = &Заказ) КАК CW_ДоходыПоГрузоперевозкамОбороты
		                                  |
		                                  |СГРУППИРОВАТЬ ПО
		                                  |	CW_ДоходыПоГрузоперевозкамОбороты.Грузоперевозка";
		
		Запрос_ИсходящиеДокументы.УстановитьПараметр("Заказ", ПараметрКоманды);
		Запрос_ИсходящиеДокументы.УстановитьПараметр("ПустаяДата"		, Дата(1,1,1));
		
		Результат_ИсходящиеДокументы = Запрос_ИсходящиеДокументы.Выполнить();
		
		Если Не Результат_ИсходящиеДокументы.Пустой() Тогда
			Выборка_ИсходящиеДокумент = Результат_ИсходящиеДокументы.Выбрать();
			Если  Выборка_ИсходящиеДокумент.Следующий()  Тогда
				МаксимальнаяДата = Макс(Выборка_ИсходящиеДокумент.ДатаДокументов,
										Выборка_ИсходящиеДокумент.ДатаСчета,
										Выборка_ИсходящиеДокумент.ДатаАкта,
										Выборка_ИсходящиеДокумент.ДатаСчф);
			Конецесли;
		КонецЕсли;
		
	КонецЕсли; 
	
	НачалоПериода = МинимальнаяДата;
	КонецПериода  = ?(МаксимальнаяДата<МинимальнаяДата, КонецДня(МинимальнаяДата), МаксимальнаяДата);
	
	Параметры = Новый Структура;
	Параметры.Вставить("НачалоПериода"	, НачалоДня(НачалоПериода));
	Параметры.Вставить("КонецПериода"	, КонецДня(КонецПериода));
	
	Возврат(Параметры);
	
	// --- 
КонецФункции


&НаСервере
Функция _ПолучитьГруппировкиПоДокументу(ПараметрКоманды)
	
	МассивГруппировок = Новый Массив;
	
	Если (ТипЗнч(ПараметрКоманды)=Тип("ДокументСсылка.CW_ДоходыПоГрузоперевозке")) Тогда
		
		МассивГруппировок.Добавить("Контрагент");
		МассивГруппировок.Добавить("Грузоперевозка");
		МассивГруппировок.Добавить("Номенклатура");
		
	ИначеЕсли (ТипЗнч(ПараметрКоманды)=Тип("ДокументСсылка.CW_ОтчетЭкспедитора")) Тогда
		
		МассивГруппировок.Добавить("Контрагент");
		МассивГруппировок.Добавить("Грузоперевозка");
		МассивГруппировок.Добавить("Номенклатура");
		
	ИначеЕсли (ТипЗнч(ПараметрКоманды)=Тип("ДокументСсылка.CW_РасходыПоГрузоперевозке")) Тогда
		
		МассивГруппировок.Добавить("Контрагент");
		МассивГруппировок.Добавить("Грузоперевозка");
		МассивГруппировок.Добавить("Номенклатура");
		
	ИначеЕсли (ТипЗнч(ПараметрКоманды)=Тип("СправочникСсылка.CW_Грузоперевозки")) Тогда
		
		МассивГруппировок.Добавить("Контрагент");
		МассивГруппировок.Добавить("Грузоперевозка");
		МассивГруппировок.Добавить("Номенклатура");
		
	ИначеЕсли (ТипЗнч(ПараметрКоманды)=Тип("СправочникСсылка.CW_Заказы")) Тогда
		
		МассивГруппировок.Добавить("Контрагент");
		МассивГруппировок.Добавить("Грузоперевозка.Заказ");
		МассивГруппировок.Добавить("Номенклатура");
		
	КонецЕсли;
	
	Возврат(МассивГруппировок);
	
КонецФункции


&НаСервере
Функция _ПолучитьОтборПоДокументу(ПараметрКоманды)
	// --- 
	
	Отбор = Новый Структура;
	
	Если (ТипЗнч(ПараметрКоманды)=Тип("ДокументСсылка.CW_ДоходыПоГрузоперевозке")) Тогда
		
		Отбор.Вставить("Грузоперевозки"	, CW_Финансы.ГрузоперевозкиДокумента(ПараметрКоманды));
		Отбор.Вставить("Номенклатура"	, CW_Финансы.НоменклатураДокумента(ПараметрКоманды));
		Отбор.Вставить("Контрагент"		, ПараметрКоманды.Контрагент);
		Отбор.Вставить("Договор"		, ПараметрКоманды.Договор);
		// --- 
		ТЗДокументовРасходов = ПараметрКоманды.Услуги.Выгрузить(,"ДокументРасходов");
		ТЗДокументовРасходов.Свернуть("ДокументРасходов");
		МассивДокументовРасходов = ТЗДокументовРасходов.ВыгрузитьКолонку("ДокументРасходов");
		_сф.м_УдалитьПустые(МассивДокументовРасходов);
		Отбор.Вставить("ДокументыРасходов",МассивДокументовРасходов);
		
	ИначеЕсли (ТипЗнч(ПараметрКоманды)=Тип("ДокументСсылка.CW_ОтчетЭкспедитора")) Тогда
		
		Отбор.Вставить("Грузоперевозки"	, CW_Финансы.ГрузоперевозкиДокумента(ПараметрКоманды));
		Отбор.Вставить("Номенклатура"	, CW_Финансы.НоменклатураДокумента(ПараметрКоманды));
		
		Отбор.Вставить("Контрагент"		, ПараметрКоманды.Контрагент);
		Отбор.Вставить("Договор"		, ПараметрКоманды.Договор);
		// --- 
		ТЗДокументовРасходов = ПараметрКоманды.Услуги.Выгрузить(,"ДокументРасходов");
		ТЗДокументовРасходов.Свернуть("ДокументРасходов");
		МассивДокументовРасходов = ТЗДокументовРасходов.ВыгрузитьКолонку("ДокументРасходов");
		_сф.м_УдалитьПустые(МассивДокументовРасходов);
		Отбор.Вставить("ДокументыРасходов",МассивДокументовРасходов);
	
	ИначеЕсли (ТипЗнч(ПараметрКоманды)=Тип("ДокументСсылка.CW_РасходыПоГрузоперевозке")) Тогда
		
		Отбор.Вставить("Грузоперевозки"	, CW_Финансы.ГрузоперевозкиДокумента(ПараметрКоманды));
		Отбор.Вставить("Номенклатура"	, CW_Финансы.НоменклатураДокумента(ПараметрКоманды));
		Отбор.Вставить("ДокументЗатрат"	, ПараметрКоманды);
		
	ИначеЕсли (ТипЗнч(ПараметрКоманды)=Тип("СправочникСсылка.CW_Грузоперевозки")) Тогда
		
		Отбор.Вставить("Грузоперевозки"	, 	ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ПараметрКоманды));
		
	ИначеЕсли (ТипЗнч(ПараметрКоманды)=Тип("СправочникСсылка.CW_Заказы")) Тогда
		
		СхемаКомпоновкиДанных 	= ПолучитьОбщийМакет("CW_СхемаЖурналаГрузоперевозок");
		ТекущиеНастройки 				= СхемаКомпоновкиДанных.НастройкиПоУмолчанию;
		
		ИсточникНастроек 	= Новый ИсточникДоступныхНастроекКомпоновкиДанных(СхемаКомпоновкиДанных);
		
		КомпоновщикНастроек = Новый КомпоновщикНастроекКомпоновкиДанных;
		КомпоновщикНастроек.Инициализировать(ИсточникНастроек);
		КомпоновщикНастроек.ЗагрузитьНастройки(ТекущиеНастройки);
		
		КомпоновщикНастроек.Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("Заказ"			, ПараметрКоманды);
		КомпоновщикНастроек.Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("Заявка"			, Справочники.CW_Заявки.ПустаяСсылка());
		КомпоновщикНастроек.Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("УказанМассивСсылок"	, Ложь);
		КомпоновщикНастроек.Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("МассивСсылок"		, Неопределено);
		КомпоновщикНастроек.Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("ВыводитьАрхивные"	, Ложь);
		
		ДанныеРасшифровки = Новый ДанныеРасшифровкиКомпоновкиДанных;
		КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
		
		МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, КомпоновщикНастроек.Настройки, ДанныеРасшифровки,,Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
		
		ПроцессорКомпоновкиДанных = Новый ПроцессорКомпоновкиДанных;
		ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновки, , ДанныеРасшифровки);
		
		ТаблицаРезультата = новый ТаблицаЗначений;
		
		ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
		ПроцессорВывода.УстановитьОбъект(ТаблицаРезультата);
		
		ПроцессорВывода.Вывести(ПроцессорКомпоновкиДанных);   
		
		Отбор.Вставить("Грузоперевозки"	, 	ТаблицаРезультата.ВыгрузитьКолонку("Ссылка"));
		
	КонецЕсли;
	
	// --- 
	Возврат(Отбор);
	
	// --- 
КонецФункции
