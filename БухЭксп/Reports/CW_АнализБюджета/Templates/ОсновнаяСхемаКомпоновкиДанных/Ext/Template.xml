		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	ВЫБОР
		КОГДА &amp;ВариантГруппировки = "ГРУЗОПЕРЕВОЗКА"
			ТОГДА CW_ПлановыеСтатьиЗатратИДоходов.Владелец
		КОГДА &amp;ВариантГруппировки = "ЗАКАЗ"
			ТОГДА CW_ПлановыеСтатьиЗатратИДоходов.Владелец.Заказ
		ИНАЧЕ CW_ПлановыеСтатьиЗатратИДоходов.Владелец.Владелец
	КОНЕЦ КАК ОбъектБюджета,
	CW_ПлановыеСтатьиЗатратИДоходов.ВидСтатьиПланирования КАК ВидСтатьи,
	CW_ПлановыеСтатьиЗатратИДоходов.ВерсияБюджета КАК ВерсияБюджета,
	CW_ПлановыеСтатьиЗатратИДоходов.Организация КАК Организация,
	CW_ПлановыеСтатьиЗатратИДоходов.Контрагент КАК Контрагент,
	CW_ПлановыеСтатьиЗатратИДоходов.Номенклатура КАК Номенклатура,
	ВЫБОР
		КОГДА CW_ПлановыеСтатьиЗатратИДоходов.ВидСтатьиПланирования = ЗНАЧЕНИЕ(Перечисление.CW_ВидыСтатейПланирования.Расходы)
			ТОГДА CW_ПлановыеСтатьиЗатратИДоходов.ПорядокОтраженияРасходов
		ИНАЧЕ CW_ПлановыеСтатьиЗатратИДоходов.ПорядокОтраженияДоходов
	КОНЕЦ КАК ПорядокОтражения,
	CW_ПлановыеСтатьиЗатратИДоходов.Валюта КАК Валюта,
	CW_ПлановыеСтатьиЗатратИДоходов.СуммаВсего КАК СуммаВсего,
	CW_ПлановыеСтатьиЗатратИДоходов.СуммаВсегоРуб КАК СуммаВсегоРуб,
	CW_ПлановыеСтатьиЗатратИДоходов.Сумма КАК Сумма,
	CW_ПлановыеСтатьиЗатратИДоходов.СуммаРуб КАК СуммаРуб,
	CW_ПлановыеСтатьиЗатратИДоходов.СуммаНДС КАК СуммаНДС,
	CW_ПлановыеСтатьиЗатратИДоходов.СуммаНДСРуб КАК СуммаНДСРуб,
	ВЫБОР
		КОГДА CW_ПлановыеСтатьиЗатратИДоходов.СуммаВсего = 0
			ТОГДА 0
		ИНАЧЕ CW_ПлановыеСтатьиЗатратИДоходов.СуммаВсегоРуб / CW_ПлановыеСтатьиЗатратИДоходов.СуммаВсего
	КОНЕЦ КАК Курс,
	ВЫБОР
		КОГДА CW_ПлановыеСтатьиЗатратИДоходов.ВидСтатьиПланирования = ЗНАЧЕНИЕ(Перечисление.CW_ВидыСтатейПланирования.Расходы)
			ТОГДА -1 * CW_ПлановыеСтатьиЗатратИДоходов.Сумма
		ИНАЧЕ CW_ПлановыеСтатьиЗатратИДоходов.Сумма
	КОНЕЦ КАК СуммаРасходы,
	ВЫБОР
		КОГДА CW_ПлановыеСтатьиЗатратИДоходов.ВидСтатьиПланирования = ЗНАЧЕНИЕ(Перечисление.CW_ВидыСтатейПланирования.Расходы)
			ТОГДА -1 * CW_ПлановыеСтатьиЗатратИДоходов.СуммаНДС
		ИНАЧЕ CW_ПлановыеСтатьиЗатратИДоходов.СуммаНДС
	КОНЕЦ КАК СуммаНДСРасходы,
	ВЫБОР
		КОГДА CW_ПлановыеСтатьиЗатратИДоходов.ВидСтатьиПланирования = ЗНАЧЕНИЕ(Перечисление.CW_ВидыСтатейПланирования.Расходы)
			ТОГДА -1 * CW_ПлановыеСтатьиЗатратИДоходов.СуммаВсего
		ИНАЧЕ CW_ПлановыеСтатьиЗатратИДоходов.СуммаВсего
	КОНЕЦ КАК СуммаВсегоРасходы,
	ВЫБОР
		КОГДА CW_ПлановыеСтатьиЗатратИДоходов.ВидСтатьиПланирования = ЗНАЧЕНИЕ(Перечисление.CW_ВидыСтатейПланирования.Расходы)
			ТОГДА -1 * CW_ПлановыеСтатьиЗатратИДоходов.СуммаРуб
		ИНАЧЕ CW_ПлановыеСтатьиЗатратИДоходов.СуммаРуб
	КОНЕЦ КАК СуммаРубРасходы,
	ВЫБОР
		КОГДА CW_ПлановыеСтатьиЗатратИДоходов.ВидСтатьиПланирования = ЗНАЧЕНИЕ(Перечисление.CW_ВидыСтатейПланирования.Расходы)
			ТОГДА -1 * CW_ПлановыеСтатьиЗатратИДоходов.СуммаНДСРуб
		ИНАЧЕ CW_ПлановыеСтатьиЗатратИДоходов.СуммаНДСРуб
	КОНЕЦ КАК СуммаНДСРубРасходы,
	ВЫБОР
		КОГДА CW_ПлановыеСтатьиЗатратИДоходов.ВидСтатьиПланирования = ЗНАЧЕНИЕ(Перечисление.CW_ВидыСтатейПланирования.Расходы)
			ТОГДА -1 * CW_ПлановыеСтатьиЗатратИДоходов.СуммаВсегоРуб
		ИНАЧЕ CW_ПлановыеСтатьиЗатратИДоходов.СуммаВсегоРуб
	КОНЕЦ КАК СуммаВсегоРубРасходы,
	CW_ПлановыеСтатьиЗатратИДоходов.СтавкаНДС КАК СтавкаНДС
ИЗ
	Справочник.CW_ПлановыеСтатьиЗатратИДоходов КАК CW_ПлановыеСтатьиЗатратИДоходов
ГДЕ
	CW_ПлановыеСтатьиЗатратИДоходов.Владелец В(&amp;Владелец)
	И ВЫБОР
			КОГДА CW_ПлановыеСтатьиЗатратИДоходов.ВидСтатьиПланирования = ЗНАЧЕНИЕ(Перечисление.CW_ВидыСтатейПланирования.Расходы)
				ТОГДА ВЫБОР
						КОГДА &amp;ПорядокОтражения = 0
							ТОГДА ИСТИНА
						ИНАЧЕ CW_ПлановыеСтатьиЗатратИДоходов.ПорядокОтраженияРасходов В (&amp;мПорядокОтражения)
					КОНЕЦ
			КОГДА CW_ПлановыеСтатьиЗатратИДоходов.ВидСтатьиПланирования = ЗНАЧЕНИЕ(Перечисление.CW_ВидыСтатейПланирования.Доходы)
				ТОГДА ВЫБОР
						КОГДА &amp;ПорядокОтражения = 0
							ТОГДА ИСТИНА
						ИНАЧЕ CW_ПлановыеСтатьиЗатратИДоходов.ПорядокОтраженияДоходов В (&amp;мПорядокОтражения)
					КОНЕЦ
			ИНАЧЕ ИСТИНА
		КОНЕЦ
	И ВЫБОР
			КОГДА &amp;ВерсияБюджета  &lt;&gt;  Значение(Справочник.CW_ВерсииБюджетов.ПустаяСсылка)
				ТОГДА CW_ПлановыеСтатьиЗатратИДоходов.ВерсияБюджета = &amp;ВерсияБюджета
			ИНАЧЕ ИСТИНА
		КОНЕЦ</query>
	</dataSet>
	<calculatedField>
		<dataPath>Курс</dataPath>
		<expression>Сумма(СуммаВсегоРуб) / Сумма(СуммаВсего)</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Курс</v8:content>
			</v8:item>
		</title>
		<appearance>
			<dcscor:item xsi:type="dcsset:SettingsParameterValue">
				<dcscor:parameter>Формат</dcscor:parameter>
				<dcscor:value xsi:type="v8:LocalStringType">
					<v8:item>
						<v8:lang>ru</v8:lang>
						<v8:content>ЧДЦ=4</v8:content>
					</v8:item>
				</dcscor:value>
			</dcscor:item>
			<dcscor:item xsi:type="dcsset:SettingsParameterValue">
				<dcscor:parameter>МинимальнаяШирина</dcscor:parameter>
				<dcscor:value xsi:type="xs:decimal">8</dcscor:value>
			</dcscor:item>
		</appearance>
		<valueType>
