&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЭтоВнешнийВызов = Ложь;
	Если Параметры.Свойство("ВнешнийВызов") Тогда
		ЭтоВнешнийВызов = Параметры.ВнешнийВызов;
	КонецЕсли;
	
	ИсключатьВнутрихолдинговыеВзаиморасчеты = CW_Настройки.ПолучитьНастройкуПользователя(,"ИсключатьВнутрихолдинговыеВзаиморасчеты");
	
	Если ЭтоВнешнийВызов Тогда
		СформироватьПриОткрытии = ЭтоВнешнийВызов;
		ЭтоВнешнийВызов 		= ложь;
		
		Если Параметры.Свойство("НачалоПериода") Тогда
			НачалоПериода = Параметры.НачалоПериода;
		КонецЕсли;
		Если Параметры.Свойство("КонецПериода") Тогда
			КонецПериода = Параметры.КонецПериода;
		КонецЕсли;
		Если Параметры.Свойство("ВариантПериодаОтчета") Тогда
			ВариантПериодаОтчета = Параметры.ВариантПериодаОтчета;
		КонецЕсли;
		Если Параметры.Свойство("ВариантФормирования") Тогда
			ВариантФормирования = Параметры.ВариантФормирования;
		КонецЕсли;
		Если Параметры.Свойство("ИсключатьВнутрихолдинговыеВзаиморасчеты") Тогда
			ИсключатьВнутрихолдинговыеВзаиморасчеты = Параметры.ИсключатьВнутрихолдинговыеВзаиморасчеты;
		КонецЕсли;
		Если Параметры.Свойство("ОбъединитьГруппировки") Тогда
			ОбъединитьГруппировки = Параметры.ОбъединитьГруппировки;
		КонецЕсли;
		Если Параметры.Свойство("ПорядокОтражения") Тогда
			ПорядокОтражения = Параметры.ПорядокОтражения;
		КонецЕсли;
		
        //Группировки
		Если Параметры.Свойство("Группировки") Тогда
			мГруппировки 		= Параметры.Группировки;
			Для Каждого ЭлементГруппировки из мГруппировки Цикл
				Нстр = Группировки.Добавить();
				Нстр.ИмяПоля = ЭлементГруппировки.Ключ;
				Нстр.Представление = ЭлементГруппировки.Значение;
				Нстр.Сортировка = Перечисления.CW_НаправлениеСортировки.ПоВозрастанию;
			КонецЦикла;
		КонецЕсли;
		
		//отбор
		Если Параметры.Свойство("Отбор") Тогда
			Если Параметры.Свойство("Отбор") Тогда
				стрОтбор = Параметры.Отбор;
			КонецЕсли;
		КонецЕсли;
		
		ЗаполнитьСписокПоказателей();
		
	Иначе
		// группировки
		Нстр = Группировки.Добавить();
		Нстр.ИмяПоля = "Валюта";
		Нстр.Представление = "Валюта";
		Нстр.Сортировка = Перечисления.CW_НаправлениеСортировки.ПоВозрастанию;
		// --- 
		Нстр = Группировки.Добавить();
		Нстр.ИмяПоля = "Контрагент";
		Нстр.Представление = "Контрагент";
		Нстр.Сортировка = Перечисления.CW_НаправлениеСортировки.ПоВозрастанию;
		
		_ВосстановитьСеансовуюНастройку();
		
	КонецЕсли;
	
	_УправлениеЭлементамиФормы();
	
	CW_ВалютаРегламентированногоУчетаРубль = ПолучитьФункциональнуюОпцию("CW_ВалютаРегламентированногоУчетаРубль");
	Если НЕ CW_ВалютаРегламентированногоУчетаРубль Тогда
		ВариантФормирования = 1;
	КонецЕсли;  
	
 	//Работа с буфером обмена
	// Проверка буфера обмена на наличие скопированных строк
	УстановитьДоступностьКомандыВставки(ЭтотОбъект, Не CW_РаботаСБуферомОбмена.ПустойБуферОбмена());
	//Работа с буфером обмена
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Элементы.ФормаНастройка.Пометка = Истина;
	
	Если СформироватьПриОткрытии Тогда
		
		СформироватьПриОткрытии=Ложь;

		// ----
		Если ЗначениеЗаполнено(стрОтбор) Тогда
			Отчет.КомпоновщикНастроек.Настройки.Отбор.Элементы.Очистить();
			Отчет.КомпоновщикНастроек.ФиксированныеНастройки.Отбор.Элементы.Очистить();
			
			КомпоновщикНастроекОтбор =  Отчет.КомпоновщикНастроек.Настройки.Отбор;
			Для Каждого ЭлементСтркутуры из стрОтбор Цикл				
				Если  ЗначениеЗаполнено(ЭлементСтркутуры.Значение) Тогда
					НовыйЭлементОтбора = КомпоновщикНастроекОтбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
					ПолеОтбора = Новый ПолеКомпоновкиДанных(ЭлементСтркутуры.Ключ);
					НовыйЭлементОтбора.ЛевоеЗначение = ПолеОтбора;
					НовыйЭлементОтбора.Использование = Истина;
					Если ТипЗнч(ЭлементСтркутуры.Значение) = Тип("Массив") Тогда
						СписокЗначений = Новый СписокЗначений;
						СписокЗначений.ЗагрузитьЗначения(ЭлементСтркутуры.Значение);
						
						НовыйЭлементОтбора.ВидСравнения 	= ВидСравненияКомпоновкиДанных.ВСписке;
						НовыйЭлементОтбора.ПравоеЗначение 	=  СписокЗначений;
						
					Иначе
						
						НовыйЭлементОтбора.ВидСравнения 	= ВидСравненияКомпоновкиДанных.Равно;
						НовыйЭлементОтбора.ПравоеЗначение 	= ЭлементСтркутуры.Значение;
						
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
		// ----
	
		СформироватьОтчет();
		_Настройка(Истина); 
	Иначе
		_ВосстановитьСтандартныеНастройки();
		_ВосстановитьСеансовуюНастройку();
	КонецЕсли; 
	
	// период по умолчанию
	Если НЕ ЗначениеЗаполнено(НачалоПериода) ИЛИ НЕ ЗначениеЗаполнено(КонецПериода) Тогда
		НачалоПериода = НачалоМесяца(ТекущаяДата());
		КонецПериода  = КонецМесяца(ТекущаяДата());
	КонецЕсли;	
	
	
КонецПроцедуры

