Функция СтруктураПримечания(выбДетали, тз)
	
	масс = тз.НайтиСтроки(
		Новый Структура(
			"НомерТаблицы, ДокументРасчетов, Счет", 
			выбДетали.НомерТаблицы,
			выбДетали.ДокументРасчетов,
			выбДетали.Счет
		)
	);
	
	рез = "";
	сз = Новый СписокЗначений;
	Для каждого строкаТЗ Из масс Цикл
		Если строкаТЗ.Сумма<>0 Тогда 
			Если Документы.ТипВсеСсылки().СодержитТип(ТипЗнч(строкаТЗ.ДокументКорреспондирующий)) И ЗначениеЗаполнено(строкаТЗ.ДокументКорреспондирующий) Тогда 
				// например, в проводках зачета аванса, третье корр-субконто
				рез = рез + "; " + СформироватьПредставлениеДокумента(строкаТЗ.ДокументКорреспондирующий, строкаТЗ.Сумма, строкаТЗ.Валюта);
				сз.Добавить(строкаТЗ.ДокументКорреспондирующий);
			ИначеЕсли выбДетали.ДокументРасчетов<>строкаТЗ.Регистратор Тогда 
				рез = рез + "; " + СформироватьПредставлениеДокумента(строкаТЗ.Регистратор, строкаТЗ.Сумма, строкаТЗ.Валюта);
				сз.Добавить(строкаТЗ.Регистратор);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	рез = Сред(рез, 3);
	
	Возврат Новый Структура("Примечание, Расшифровка", рез, сз);
	
КонецФункции

