&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ИсключатьВнутрихолдинговыеВзаиморасчеты = CW_Настройки.ПолучитьНастройкуПользователя(,"ИсключатьВнутрихолдинговыеВзаиморасчеты");
	
	_ВосстановитьСтандартныеНастройки();
	_ВосстановитьСеансовуюНастройку();
	
	CW_ВалютаРегламентированногоУчетаРубль = ПолучитьФункциональнуюОпцию("CW_ВалютаРегламентированногоУчетаРубль");
	
	Элементы.ПолучитьРасходыПоПутевымЛистам.Доступность = ПорядокОтражения <> 2 и ВариантФормирования = 0;

	Если Не CW_ВалютаРегламентированногоУчетаРубль Тогда
		ВариантФормирования = 1;
	КонецЕсли;
	
	//Работа с буфером обмена
	// Проверка буфера обмена на наличие скопированных строк
	УстановитьДоступностьКомандыВставки(ЭтотОбъект, Не CW_РаботаСБуферомОбмена.ПустойБуферОбмена());
	//Работа с буфером обмена
	
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Элементы.ФормаНастройка.Пометка = Истина;
	
	Если НЕ ЗначениеЗаполнено(НачалоПериода) ИЛИ НЕ ЗначениеЗаполнено(КонецПериода) Тогда
		НачалоПериода = НачалоМесяца(ТекущаяДата());
		КонецПериода  = КонецМесяца(ТекущаяДата());
	КонецЕсли;	
	
	//Если вдруг по каким то причинам показатели не заполнены
	Если Показатели.Количество() = 0 Тогда
		Показатели.Добавить("Сумма", "Сумма", Истина);
		Показатели.Добавить("НДС", "НДС", Истина);
		Показатели.Добавить("Всего", "Всего", Истина);	
		Показатели.Добавить("ВсегоВал", "Всего Вал.", Истина);	
	КонецЕсли;

		
КонецПроцедуры

