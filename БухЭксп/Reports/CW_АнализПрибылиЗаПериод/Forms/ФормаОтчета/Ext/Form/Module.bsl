&НаКлиенте
Процедура Сформировать(Команда)
	
	_Настройка(Истина);
	
	СформироватьОтчет();	
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьОтчет()
	
	Показатель = Ложь;
	Для Каждого Стр из Показатели Цикл
		Показатель = ?(Стр.Пометка, Истина, Показатель);
	КонецЦикла;
	
	Если НЕ Показатель Тогда
		_УФК.ВывестиПредупреждение("Не отмечено ни одного показателя!");
		Возврат;		
	КонецЕсли;
	
	Отчет.АдресНастроек = _ПолучитьАдресНастроек();
	ЭтаФорма.СкомпоноватьРезультат();
	ОбработатьОтчет();
	
	// --- 
	_СохранитьСеансовуюНастройку();

КонецПроцедуры

&НаСервере
Функция _ПолучитьАдресНастроек()
	
	Настройки = Новый Структура;
	Настройки.Вставить("ВариантФормирования", 		ВариантФормирования);
	Настройки.Вставить("ВариантПериодаОтчета", 		ВариантПериодаОтчета);
	Настройки.Вставить("НачалоПериода", 			НачалоПериода);
	Настройки.Вставить("КонецПериода", 				КонецПериода);
	Настройки.Вставить("Показатели", 				Показатели);
	Настройки.Вставить("Группировки",  				Группировки.Выгрузить());
	Настройки.Вставить("ИсключатьВнутрихолдинговыеВзаиморасчеты", 				ИсключатьВнутрихолдинговыеВзаиморасчеты);
	Настройки.Вставить("ВыводитьДокументыДвижения",  	 	ВыводитьДокументыДвижения);
	Настройки.Вставить("ПорядокОтражения",  	 			ПорядокОтражения);
	Настройки.Вставить("ОбъединитьГруппировки",  			ОбъединитьГруппировки);
	Настройки.Вставить("ПолучитьРасходыПоПутевымЛистам",  	ПолучитьРасходыПоПутевымЛистам);
	
	Возврат ПоместитьВоВременноеХранилище(Настройки,ЭтаФорма.УникальныйИдентификатор);

КонецФункции

&НаСервере
Процедура ОбработатьОтчет()
	
	CW_Отчеты.ЗаменитьТекстВТаблицеРезультата(Результат, "Расход", "Расход", ГоризонтальноеПоложение.Центр);
	CW_Отчеты.ЗаменитьТекстВТаблицеРезультата(Результат, "Доход", "Доход", ГоризонтальноеПоложение.Центр);
	CW_Отчеты.ЗаменитьТекстВТаблицеРезультата(Результат, "Прибыль", "Прибыль", ГоризонтальноеПоложение.Центр);	
	CW_Отчеты.ЗаменитьТекстВТаблицеРезультата(Результат, "Итого", "ИТОГО:");	
	
	CW_Отчеты.ЗаменитьТекстВТаблицеРезультата(Результат, "Сумма", "Сумма", ГоризонтальноеПоложение.Центр);
	CW_Отчеты.ЗаменитьТекстВТаблицеРезультата(Результат, "НДС", "НДС", ГоризонтальноеПоложение.Центр);
	CW_Отчеты.ЗаменитьТекстВТаблицеРезультата(Результат, "Всего", "Всего", ГоризонтальноеПоложение.Центр);
	
	Результат.УдалитьОбласть(Результат.Область("R1"), ТипСмещенияТабличногоДокумента.ПоГоризонтали); 
	Результат.УдалитьОбласть(Результат.Область("R2"), ТипСмещенияТабличногоДокумента.ПоГоризонтали); 
	Результат.ФиксацияСверху = Результат.ФиксацияСверху - 2;
	
	Результат.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	Результат.АвтоМасштаб = Истина;
	
	//УправлениеКолонтитулами
	УправлениеКолонтитулами.УстановитьКолонтитулы(Результат,"Анализ прибыли за период");
	//УправлениеКолонтитулами
	
КонецПроцедуры	

