					<v8:lang>ru</v8:lang>
					<v8:content>Ссылка</v8:content>
				</v8:item>
			</title>
			<role>
				<dcscom:dimension>true</dcscom:dimension>
			</role>
			<presentationExpression>ВЫБОР КОГДА Ссылка.ПредставлениеДокумента Есть Null Тогда Ссылка Иначе Ссылка.ПредставлениеДокумента Конец</presentationExpression>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	CW_СтатусыДокументов.Документ КАК Ссылка,
	CW_СтатусыДокументов.СтатусДокумента КАК СтатусДокумента,
	CW_СтатусыДокументов.Период КАК Период
ПОМЕСТИТЬ ВТ_ДанныеСтатусов
ИЗ
	РегистрСведений.CW_СтатусыДокументов КАК CW_СтатусыДокументов
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВТ_ДанныеСтатусов.Ссылка КАК Ссылка,
	МАКСИМУМ(ВТ_ДанныеСтатусов.Период) КАК Период
ПОМЕСТИТЬ ВТ_МаксимальнаяДата
ИЗ
	ВТ_ДанныеСтатусов КАК ВТ_ДанныеСтатусов

СГРУППИРОВАТЬ ПО
	ВТ_ДанныеСтатусов.Ссылка
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВТ_ДанныеСтатусов.Ссылка КАК Ссылка,
	ВТ_ДанныеСтатусов.СтатусДокумента КАК СтатусДокумента,
	ВЫБОР
		КОГДА ВТ_МаксимальнаяДата.Ссылка ЕСТЬ NULL
			ТОГДА ЛОЖЬ
		ИНАЧЕ ИСТИНА
	КОНЕЦ КАК ЭтоПоследний,
	ВТ_ДанныеСтатусов.СтатусДокумента.НеРассчитыватьСтатистикуДляПоследнего КАК НеРассчитывать,
	ВТ_ДанныеСтатусов.Период КАК Период
ПОМЕСТИТЬ ВТ_ПоследниеСтатусы
ИЗ
	ВТ_ДанныеСтатусов КАК ВТ_ДанныеСтатусов
		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_МаксимальнаяДата КАК ВТ_МаксимальнаяДата
		ПО ВТ_ДанныеСтатусов.Ссылка = ВТ_МаксимальнаяДата.Ссылка
			И ВТ_ДанныеСтатусов.Период = ВТ_МаксимальнаяДата.Период
ГДЕ
	НЕ ВТ_МаксимальнаяДата.Ссылка ЕСТЬ NULL
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВТ_ДанныеСтатусовОсновная.Ссылка КАК Ссылка,
	ВТ_ДанныеСтатусовОсновная.СтатусДокумента КАК СтатусДокумента,
	ВТ_ДанныеСтатусовОсновная.Период КАК ДатаНачала,
	ВЫБОР
		КОГДА ВТ_ПоследниеСтатусы.СтатусДокумента ЕСТЬ NULL
			ТОГДА ВЫБОР
					КОГДА ВТ_ДанныеСтатусовДоп.Период &gt; ВТ_ДанныеСтатусовОсновная.Период
						ТОГДА ВТ_ДанныеСтатусовДоп.Период
					ИНАЧЕ ВТ_ДанныеСтатусовОсновная.Период
				КОНЕЦ
		ИНАЧЕ ВЫБОР
				КОГДА ВТ_ПоследниеСтатусы.НеРассчитывать
					ТОГДА ДОБАВИТЬКДАТЕ(ВТ_ДанныеСтатусовОсновная.Период, СЕКУНДА, 3600)
				ИНАЧЕ &amp;ТекущаяДата
			КОНЕЦ
	КОНЕЦ КАК ДатаОкончания,
	ВТ_ПоследниеСтатусы.ЭтоПоследний КАК ЭтоПоследний,
	ВТ_ПоследниеСтатусы.НеРассчитывать КАК НеРассчитывать
ПОМЕСТИТЬ ВТ_Периоды
ИЗ
	ВТ_ДанныеСтатусов КАК ВТ_ДанныеСтатусовОсновная
		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ДанныеСтатусов КАК ВТ_ДанныеСтатусовДоп
		ПО ВТ_ДанныеСтатусовОсновная.Ссылка = ВТ_ДанныеСтатусовДоп.Ссылка
		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ПоследниеСтатусы КАК ВТ_ПоследниеСтатусы
		ПО ВТ_ДанныеСтатусовОсновная.Ссылка = ВТ_ПоследниеСтатусы.Ссылка
			И ВТ_ДанныеСтатусовОсновная.СтатусДокумента = ВТ_ПоследниеСтатусы.СтатусДокумента
			И ВТ_ДанныеСтатусовОсновная.Период = ВТ_ПоследниеСтатусы.Период
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВТ_Периоды.Ссылка КАК Ссылка,
	ВТ_Периоды.СтатусДокумента КАК СтатусДокумента,
	ВТ_Периоды.ДатаНачала КАК ДатаНачала,
	МИНИМУМ(ВЫБОР
			КОГДА ВТ_Периоды.СтатусДокумента.НеРассчитыватьСтатистикуДляПоследнего
					И ВТ_Периоды.ДатаОкончания = &amp;ТекущаяДата
				ТОГДА ВТ_Периоды.ДатаНачала
			ИНАЧЕ ВТ_Периоды.ДатаОкончания
		КОНЕЦ) КАК ДатаОкончания
ПОМЕСТИТЬ ВТ_Статистика
ИЗ
	ВТ_Периоды КАК ВТ_Периоды
ГДЕ
	ВТ_Периоды.ДатаНачала &lt;&gt; ВТ_Периоды.ДатаОкончания

СГРУППИРОВАТЬ ПО
	ВТ_Периоды.Ссылка,
	ВТ_Периоды.СтатусДокумента,
	ВТ_Периоды.ДатаНачала
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВТ_Статистика.Ссылка КАК Ссылка,
	ВТ_Статистика.СтатусДокумента КАК СтатусДокумента,
	ВТ_Статистика.ДатаНачала КАК ДатаНачала,
	ВТ_Статистика.ДатаОкончания КАК ДатаОкончания,
	РАЗНОСТЬДАТ(ВТ_Статистика.ДатаНачала, ВТ_Статистика.ДатаОкончания, СЕКУНДА) КАК ДлительностьСтатусаСек
ПОМЕСТИТЬ ВТ_ДанныеОтчета
ИЗ
	ВТ_Статистика КАК ВТ_Статистика
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВТ_ДанныеОтчета.Ссылка КАК Ссылка,
	//ПоляДокумента
	ВТ_ДанныеОтчета.СтатусДокумента КАК СтатусДокумента,
	СУММА(ВЫРАЗИТЬ(ВТ_ДанныеОтчета.ДлительностьСтатусаСек / 86400 КАК ЧИСЛО(10, 0))) КАК ДниСтатуса
ИЗ
	ВТ_ДанныеОтчета КАК ВТ_ДанныеОтчета

СГРУППИРОВАТЬ ПО
	ВТ_ДанныеОтчета.Ссылка,
	ВТ_ДанныеОтчета.СтатусДокумента</query>
