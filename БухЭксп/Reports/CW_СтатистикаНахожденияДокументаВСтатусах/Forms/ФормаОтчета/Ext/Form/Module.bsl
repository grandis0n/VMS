
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Параметры.Свойство("ИдентификаторОбъекта", 		Отчет.ИдентификаторОбъекта);
	
	АдресДокументовДляОтбора = Неопределено;
	Параметры.Свойство("АдресДокументовДляОтбора", АдресДокументовДляОтбора);
	
	Если ЭтоАдресВременногоХранилища(АдресДокументовДляОтбора) Тогда
		МассивДокументов = ПолучитьИзВременногоХранилища(АдресДокументовДляОтбора);
		Отчет.АдресДокументовДляОтбора  = ПоместитьВоВременноеХранилище(МассивДокументов, ЭтаФорма.УникальныйИдентификатор);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если Отчет.ИдентификаторОбъекта.Пустая() Тогда
		ПоказатьПредупреждение(,"Отчет не предназанчен для самостоятельного использвования!");
		Отказ = Истина;
	КонецЕсли;
	
	
	
КонецПроцедуры

&НаКлиенте
Процедура РезультатОбработкаРасшифровки(Элемент, Расшифровка, СтандартнаяОбработка, ДополнительныеПараметры)
	
	// отключаем стандартный механизм
	СтандартнаяОбработка = Ложь;
	// готовим объект обрабатывающий расшифровку
	// в первый параметр указываем адрес хранилища данных расшифровки (который мы подготовили при формировании отчета)
	// во второй параметр настройки нашего отчета
	//ОбработкаРасшифровки =  Новый ОбработкаРасшифровкиКомпоновкиДанных(ДанныеРасшифровки, Новый ИсточникДоступныхНастроекКомпоновкиДанных(Отчет));
	
	ПараметрыВыполняемогоДействия = ПолучитьВыполняемоеДействие(Расшифровка, ДанныеРасшифровки);
	
	ВыполняемоеДействие = ПараметрыВыполняемогоДействия.Получить("ВыполняемоеДействие");
	
	Если ВыполняемоеДействие = "ОткрытьЗначение" Тогда
		
		Значение = ПараметрыВыполняемогоДействия.Получить("Значение");
		Если Значение <> Неопределено Тогда
			ПоказатьЗначение(, Значение);
		КонецЕсли;
		
	ИначеЕсли ВыполняемоеДействие = "ИсторияСтатусов" Тогда
		
		Значение = ПараметрыВыполняемогоДействия.Получить("Значение");
		
		Если Значение <> Неопределено Тогда
			ПараметрыФормы = Новый Структура;
			ПараметрыФормы.Вставить("ЗначениеОтбора", 	Значение);
			ПараметрыФормы.Вставить("Отбор",			Новый Структура("Документ", Значение));
			
			ОткрытьФорму("РегистрСведений.CW_СтатусыДокументов.Форма.ФормаСпискаИстория", ПараметрыФормы,ЭтаФорма,,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьВыполняемоеДействие(Расшифровка, АдресДанныеРасшифровки)
	
	СтруктураДействий = Новый Соответствие;
	
	ДанныеРасшифровкиКомпоновкиДанных 	= ПолучитьИзВременногоХранилища(АдресДанныеРасшифровки);
	ЗначенияПолейРасшифровки 			= ДанныеРасшифровкиКомпоновкиДанных.Элементы[Расшифровка];
	
	ПоляРасшифровки = ЗначенияПолейРасшифровки.ПолучитьПоля();
	Если  ПоляРасшифровки.Найти("ДниСтатуса")<> Неопределено Тогда
		ЗначениеРасшифровки = ПолучитьЗначениеПоляРасшифровки(ЗначенияПолейРасшифровки);
		
		СтруктураДействий.Вставить("ВыполняемоеДействие",	"ИсторияСтатусов");
		СтруктураДействий.Вставить("Значение", 				ЗначениеРасшифровки);
	Иначе
		
		ПолеРасшифровки = ПоляРасшифровки.Найти("Ссылка"); 
		Если ПолеРасшифровки = Неопределено Тогда
			ЗначениеРасшифровки = ПолучитьЗначениеПоляРасшифровки(ЗначенияПолейРасшифровки);
			
			СтруктураДействий.Вставить("ВыполняемоеДействие",	"ОткрытьЗначение");
			СтруктураДействий.Вставить("Значение", 				ЗначениеРасшифровки);
		Иначе
			СтруктураДействий.Вставить("ВыполняемоеДействие",	"ОткрытьЗначение");
			СтруктураДействий.Вставить("Значение", 				ПолеРасшифровки.Значение);
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат СтруктураДействий;
	
КонецФункции

&НаСервере
Функция ПолучитьЗначениеПоляРасшифровки(ЗначенияПолейРасшифровки)
	
	мРодители =  ЗначенияПолейРасшифровки.ПолучитьРодителей();
	Для Каждого ЭлементРасшифровки из мРодители Цикл
		ПоляЭлементаРасшифровки = ЭлементРасшифровки.ПолучитьПоля();
		
		ПолеРасшифровки =  ПоляЭлементаРасшифровки.Найти("Ссылка");
		Если ПолеРасшифровки <> Неопределено Тогда
			Возврат ПолеРасшифровки.Значение;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

&НаКлиенте
Процедура ОбработатьРасшифровку(ВыбранноеДействие,ВыбранноеЗначение,Параметр3) Экспорт

	// поле выбора действия, обрабаытваем нужные нам манипуляции
	// в нашем случае можно этого не делать, так как у нас доступно только действие "ОткрытьЗначение"
	Если ВыбранноеДействие <> ДействиеОбработкиРасшифровкиКомпоновкиДанных.Нет Тогда
		Если ВыбранноеДействие = ДействиеОбработкиРасшифровкиКомпоновкиДанных.ОткрытьЗначение Тогда
			// в режиме запрета модальности используем "ПоказатьЗначение"
			ПоказатьЗначение(,ВыбранноеЗначение);
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура РезультатОбработкаДополнительнойРасшифровки(Элемент, Расшифровка, СтандартнаяОбработка, ДополнительныеПараметры)
	Расшифровка = Неопределено;
КонецПроцедуры
