	СтандартнаяОбработка = Ложь;
	// --- 
	ПОВ = Новый ОписаниеОповещения("ОбработкаВыбораЗаказа",ЭтотОбъект); 
	ПараметрыФормы = Новый Структура("Адрес",ПоместитьВоВременноеХранилище(Грузоперевозки,ЭтаФорма.УникальныйИдентификатор));
	ОткрытьФорму("ОбщаяФорма.CW_ФормаВыбораГрузоперевозок",ПараметрыФормы,,,,,ПОВ, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

