&НаСервере
Процедура _ВосстановитьСтандартныеНастройки()
	
	Отчет.КомпоновщикНастроек.ЗагрузитьНастройки(Отчеты.CW_ПланФакторныйАнализГрузоперевозок.ПолучитьМакет("ОсновнаяСхемаКомпоновкиДанных").НастройкиПоУмолчанию);
	
КонецПроцедуры	

&НаСервере
Процедура _ВосстановитьСеансовуюНастройку()
	// --- 
	
	// пытаемся восстановить настройки
	Идентификатор = РеквизитФормыВЗначение("Отчет").Метаданные().Имя;
	СеансоваяНастройка = ХранилищеСистемныхНастроек.Загрузить(Идентификатор, "Сеансовая");
	Если СеансоваяНастройка <> Неопределено Тогда
		
		Попытка
			СеансоваяНастройка.Свойство("Показатели",Показатели);
			Если (ПолучитьФункциональнуюОпцию("CW_ИспользованиеБюджетирования")) Тогда
				СеансоваяНастройка.Свойство("Разделы", Разделы);
				Если Разделы.Количество() = 1 Тогда
					Разделы.Вставить(0, "План", , Ложь);
					Разделы.Добавить("Отклонение", , Ложь);
				КонецЕсли;	
				СеансоваяНастройка.Свойство("ВерсияБюджета",ВерсияБюджета);
				Если НЕ ЗначениеЗаполнено(ВерсияБюджета) Тогда
					ВерсияБюджета = _ПолучитьБазовуюВерсиюБюджета();
				КонецЕсли;	
			Иначе
				Разделы.Очистить();
				Разделы.Добавить("Факт",,Истина);
				Элементы.ВерсияБюджета.Видимость = Ложь;
			КонецЕсли;	
			СеансоваяНастройка.Свойство("ПоСтатьям",ПоСтатьям);
			СеансоваяНастройка.Свойство("Организация",Организация);
			СеансоваяНастройка.Свойство("ВариантФормирования",ВариантФормирования);
			
			Если НЕ CW_ВалютаРегламентированногоУчетаРубль Тогда
				ВариантФормирования = 1;
			КонецЕсли;
			
		Исключение
		    //ОписаниеОшибки()
		КонецПопытки; 
		
		
	КонецЕсли; 
	
		
	
	// --- 
КонецПроцедуры

&НаСервере
Процедура _СохранитьСеансовуюНастройку()
	// --- 
	
	СтруктураНастройки = Новый Структура();
	СтруктураНастройки.Вставить("Показатели",Показатели);
	СтруктураНастройки.Вставить("Разделы",Разделы);
	СтруктураНастройки.Вставить("ВерсияБюджета",ВерсияБюджета);
	СтруктураНастройки.Вставить("ПоСтатьям",ПоСтатьям);
	СтруктураНастройки.Вставить("Организация",Организация);
	СтруктураНастройки.Вставить("ВариантФормирования",ВариантФормирования);
	Идентификатор = РеквизитФормыВЗначение("Отчет").Метаданные().Имя;
	ХранилищеСистемныхНастроек.Сохранить(Идентификатор, "Сеансовая", СтруктураНастройки);
	
	// --- 
КонецПроцедуры

// ---------------------------------------------------------------------------- 

&НаКлиенте
Процедура Сформировать(Команда)
	
	Раздел = Ложь;
	Для Каждого Стр из Разделы Цикл
		Раздел = ?(Стр.Пометка, Истина, Раздел);
	КонецЦикла;
	Если НЕ Раздел Тогда
		_УФК.ВывестиПредупреждение("Не отмечено ни одного раздела!");
		Возврат;		
	КонецЕсли;	
	
	Показатель = Ложь;
	Для Каждого Стр из Показатели Цикл
		Показатель = ?(Стр.Пометка, Истина, Показатель);
	КонецЦикла;
	Если НЕ Показатель Тогда
		_УФК.ВывестиПредупреждение("Не отмечено ни одного показателя!");
		Возврат;		
	КонецЕсли;	
	
	_Настройка(Истина);
	// записываем настройки во временное хранилище
	Отчет.АдресНастроек = _ПолучитьАдресНастроек();
	ЭтаФорма.СкомпоноватьРезультат();
	ОбработатьОтчет();	
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьОтчет()
	// --- 
		
	// записываем настройки во временное хранилище
	Отчет.АдресНастроек = _ПолучитьАдресНастроек();
	ЭтаФорма.СкомпоноватьРезультат();
	ОбработатьОтчет();	
	
	// --- 
	_СохранитьСеансовуюНастройку();
	
	// --- 
КонецПроцедуры

&НаСервере
Функция _ПолучитьАдресНастроек()
	// --- 
	
	Настройки = _сф.ст_Создать("Грузоперевозки,ВерсияБюджета,ВариантФормирования,Организация,ПоСтатьям,Показатели,Разделы");
	Настройки.ВариантФормирования = ВариантФормирования;
	Настройки.Грузоперевозки = Грузоперевозки;
	Настройки.ВерсияБюджета = ВерсияБюджета;
	Настройки.Организация = Организация;
	Настройки.ПоСтатьям = ПоСтатьям;
	Настройки.Показатели = Показатели;
	Настройки.Разделы = Разделы;
	
	Возврат(ПоместитьВоВременноеХранилище(Настройки,ЭтаФорма.УникальныйИдентификатор));
	
	// --- 
КонецФункции

&НаСервере
Процедура ОбработатьОтчет()
	
	CW_Отчеты.ЗаменитьТекстВТаблицеРезультата(Результат, "План", "План", ГоризонтальноеПоложение.Центр);
	CW_Отчеты.ЗаменитьТекстВТаблицеРезультата(Результат, "Факт", "Факт", ГоризонтальноеПоложение.Центр);
	CW_Отчеты.ЗаменитьТекстВТаблицеРезультата(Результат, "Отклонение", "Отклонение", ГоризонтальноеПоложение.Центр);
	CW_Отчеты.ЗаменитьТекстВТаблицеРезультата(Результат, "Сумма", "Сумма", ГоризонтальноеПоложение.Центр);
	CW_Отчеты.ЗаменитьТекстВТаблицеРезультата(Результат, "НДС", "НДС", ГоризонтальноеПоложение.Центр);
	CW_Отчеты.ЗаменитьТекстВТаблицеРезультата(Результат, "Всего", "Всего", ГоризонтальноеПоложение.Центр);
	CW_Отчеты.ЗаменитьТекстВТаблицеРезультата(Результат, "Итого", "ИТОГО:");	
	
	Результат.УдалитьОбласть(Результат.Область("R1"), ТипСмещенияТабличногоДокумента.ПоГоризонтали); 
	Результат.УдалитьОбласть(Результат.Область("R2"), ТипСмещенияТабличногоДокумента.ПоГоризонтали); 
	Результат.ФиксацияСверху = Результат.ФиксацияСверху - 2;
	
	Результат.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	Результат.АвтоМасштаб = Истина;
	
КонецПроцедуры	

// ---------------------------------------------------------------------------- 

&НаКлиенте
Процедура Настройка(Команда)
	
	_Настройка(); 
	
КонецПроцедуры

&НаСервере
Процедура _Настройка(Скрыть=Ложь)
	// --- 
	
	Если Скрыть Тогда
		
		Элементы.ГруппаНастройкиОтчета.Видимость = Ложь;
		Элементы.ФормаНастройка.Пометка=Ложь;
		
	Иначе
		
		Если Элементы.ГруппаНастройкиОтчета.Видимость Тогда
			
			Элементы.ГруппаНастройкиОтчета.Видимость = Ложь;
			Элементы.ФормаНастройка.Пометка=Ложь;
			
		Иначе
			
			Элементы.ГруппаНастройкиОтчета.Видимость = Истина;
			Элементы.ФормаНастройка.Пометка=Истина;
			
		КонецЕсли; 
		
	КонецЕсли; 
		
	// --- 
КонецПроцедуры

