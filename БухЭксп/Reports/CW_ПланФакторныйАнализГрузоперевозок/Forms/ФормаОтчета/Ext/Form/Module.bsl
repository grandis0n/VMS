&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	CW_ВалютаРегламентированногоУчетаРубль = ПолучитьФункциональнуюОпцию("CW_ВалютаРегламентированногоУчетаРубль");

	Если НЕ CW_ВалютаРегламентированногоУчетаРубль Тогда
		ВариантФормирования = 1;
	КонецЕсли;
	
	ВерсияБюджета = CW_Бюджетирование.ПолучитьОсновнуюВерсиюБюджета();
	
	// показатели
	Показатели.Добавить("Сумма"	,,Истина);
	Показатели.Добавить("НДС"	,,Истина);
	Показатели.Добавить("Всего"	,,Истина);
	
	// разделы
	Разделы.Добавить("План"			,,Истина);
	Разделы.Добавить("Факт"			,,Истина);
	Разделы.Добавить("Отклонение"	,,Истина);
		
	// если переданы параметры - выполняем отчёт
	Если Параметры.Свойство("Грузоперевозки") Тогда
		
		Грузоперевозки 	= Параметры.Грузоперевозки;
		
		Если ЗначениеЗаполнено(Параметры.ВерсияБюджета) Тогда
			ВерсияБюджета 	= Параметры.ВерсияБюджета;
		КонецЕсли;
		
		СформироватьПриОткрытии = Истина;
				
		// при внешнем вызове показывать только "Всего"
		Показатели.ЗаполнитьПометки(Ложь);
		Показатели.НайтиПоЗначению("Всего").Пометка = Истина;
		
	КонецЕсли; 
	
	//Работа с буфером обмена
	// Проверка буфера обмена на наличие скопированных строк
	УстановитьДоступностьКомандыВставки(ЭтотОбъект, Не CW_РаботаСБуферомОбмена.ПустойБуферОбмена());
	//Работа с буфером обмена	
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Элементы.ФормаНастройка.Пометка = Истина;
	
	Если СформироватьПриОткрытии Тогда
		СформироватьПриОткрытии = Ложь;
		_Настройка(Истина);
		СформироватьОтчет();
	Иначе	
		_ВосстановитьСтандартныеНастройки();
		_ВосстановитьСеансовуюНастройку();
	КонецЕсли; 
	
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, СтандартнаяОбработка)
	
	//_СохранитьСеансовуюНастройку();
	ВариантМодифицирован = Ложь;	
	
КонецПроцедуры

