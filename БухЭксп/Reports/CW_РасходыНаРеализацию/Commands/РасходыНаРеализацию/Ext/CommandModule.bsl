
&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)
	
	Отбор = Новый Структура;
	Если ТипЗнч(ПараметрКоманды) = Тип("ДокументСсылка.CW_ДоходыПоГрузоперевозке") Тогда
		Отбор.Вставить("ДокументДоходов",ПараметрКоманды);
	ИначеЕсли ТипЗнч(ПараметрКоманды) = Тип("ДокументСсылка.CW_СписаниеЗатратНаРеализацию") Тогда
		Отбор.Вставить("Регистратор",ПараметрКоманды);
	Конецесли;
	
	мГруппировки 	= ПолучитьГруппировкиОтчета();
	мПоказатели		= ПолучитьПоказателиОтчета();
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ВнешнийВызов", 	Истина);
	
	Если Отбор.Количество() > 0 Тогда
		ПараметрыФормы.Вставить("ДанныеОтбора", 	Отбор);
	КонецЕсли;

	ПараметрыФормы.Вставить("Группировки", 		мГруппировки);
	ПараметрыФормы.Вставить("Показатели", 		мПоказатели);
	ПараметрыФормы.Вставить("НачалоПериода", 	Дата(1,1,1));
	ПараметрыФормы.Вставить("КонецПериода", 	Дата(1,1,1));
	
	ОткрытьФорму("Отчет.CW_РасходыНаРеализацию.Форма", ПараметрыФормы, ПараметрыВыполненияКоманды.Источник, ПараметрыВыполненияКоманды.Уникальность, ПараметрыВыполненияКоманды.Окно, ПараметрыВыполненияКоманды.НавигационнаяСсылка);
	
КонецПроцедуры
	
&НаСервере
Функция ПолучитьГруппировкиОтчета()
	
	МассивГруппировок = Новый Массив;
	
	МассивГруппировок.Добавить("ДокументДоходов");
	МассивГруппировок.Добавить("Контрагент");
	МассивГруппировок.Добавить("ДокументРасходов");
	МассивГруппировок.Добавить("Номенклатура");
	
	Возврат МассивГруппировок;
	
КонецФункции

&НаСервере
Функция ПолучитьПоказателиОтчета()
	
	мПоказатели = новый Массив;
	мПоказатели.Добавить("СуммаОборот"); 
	мПоказатели.Добавить("НДСОборот"); 
	мПоказатели.Добавить("ВсегоОборот"); 
	
	Возврат мПоказатели;
	
КонецФункции