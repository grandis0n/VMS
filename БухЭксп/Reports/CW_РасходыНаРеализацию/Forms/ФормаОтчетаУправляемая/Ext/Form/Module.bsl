&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Показатели.Добавить("КоличествоОборот",	"Количество"); 
	Показатели.Добавить("СуммаОборот",		"Сумма"); 
	Показатели.Добавить("НДСОборот",		"НДС"); 
	Показатели.Добавить("ВсегоОборот",		"Всего"); 
	
	Показатели.Добавить("Сумма_ВалютаОборот",	"Сумма (вал.)"); 
	Показатели.Добавить("НДС_ВалютаОборот",		"НДС (вал.)"); 
	Показатели.Добавить("Всего_ВалютаОборот",	"Всего (вал.)"); 
	
	Параметры.Свойство("ВнешнийВызов", Отчет.ВнешнийВызов);
	Если Отчет.ВнешнийВызов Тогда
		Параметры.Свойство("НачалоПериода", НачалоПериода);
		Параметры.Свойство("КонецПериода", 	КонецПериода);
		
		Если Параметры.Свойство("Показатели") Тогда
			УстановитьВыбранныеПоказатели(Параметры.Показатели);
		КонецЕсли;
		
		Если Параметры.Свойство("Группировки") Тогда
			Группировки.Очистить();
			Для каждого ЭлементМассива Из Параметры.Группировки Цикл
				Нстр = Группировки.Добавить();
				Нстр.ИмяПоля 		= ЭлементМассива;
				Нстр.Представление 	= ЭлементМассива;
				Нстр.Сортировка 	= Перечисления.CW_НаправлениеСортировки.ПоВозрастанию;
			КонецЦикла; 
		КонецЕсли;
		
		Если Параметры.Свойство("ДанныеОтбора") Тогда
			АдресОтбора = ПоместитьВоВременноеХранилище(Параметры.ДанныеОтбора, УникальныйИдентификатор);
		КонецЕсли;
	Иначе
		НачалоПериода = НачалоМесяца(ТекущаяДата());
		КонецПериода  = КонецМесяца(ТекущаяДата());
	КонецЕсли;  
	
	//Работа с буфером обмена
	// Проверка буфера обмена на наличие скопированных строк
	УстановитьДоступностьКомандыВставки(ЭтотОбъект, Не CW_РаботаСБуферомОбмена.ПустойБуферОбмена());
	//Работа с буфером обмена
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	_ВосстановитьСтандартныеНастройки();
	
	_ВосстановитьСеансовуюНастройку();
	
	Элементы.ФормаНастройка.Пометка = Истина;
	
	УстановитьОтборНаСервере();

	Если Отчет.ВнешнийВызов Тогда
		Сформировать(Неопределено);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьОтборНаСервере()
	
	Если ЭтоАдресВременногоХранилища(АдресОтбора) Тогда
		ДанныеОтбора = ПолучитьИзВременногоХранилища(АдресОтбора);
		Для каждого ЭлементСтруктуры из  ДанныеОтбора Цикл
			Если ТипЗнч(ЭлементСтруктуры.Значение) = Тип("СписокЗначений") Тогда
				тВидСравнения   = ВидСравненияКомпоновкиДанных.ВСписке;
			Иначе
				тВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
			КонецЕсли;
			
			CW_БухгалтерскиеОтчетыКлиентСерверМСФО.ДобавитьОтбор(Отчет.КомпоновщикНастроек, ЭлементСтруктуры.Ключ, ЭлементСтруктуры.Значение, тВидСравнения, Истина);
		КонецЦикла;
	Конецесли;
	
КонецПроцедуры

&НаСервере
Процедура _ВосстановитьСтандартныеНастройки()
	
	Если Отчет.ВнешнийВызов Тогда
		Возврат;
	Конецесли;
	
	Отчет.КомпоновщикНастроек.ЗагрузитьНастройки(Отчеты.CW_РасходыНаРеализацию.ПолучитьМакет("Схема").НастройкиПоУмолчанию);
	
КонецПроцедуры	

&НаКлиенте
Процедура ПередЗакрытием(Отказ, СтандартнаяОбработка)
	
	//_СохранитьСеансовуюНастройку();
	ВариантМодифицирован = Ложь;
	
КонецПроцедуры

