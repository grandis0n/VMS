&НаСервере
Процедура _ВосстановитьСеансовуюНастройку()
	
	Если Отчет.ВнешнийВызов Тогда
		Возврат;
	КонецЕсли;
	
	// пытаемся восстановить настройки
	Идентификатор = РеквизитФормыВЗначение("Отчет").Метаданные().Имя;
	СеансоваяНастройка = ХранилищеСистемныхНастроек.Загрузить(Идентификатор, "Сеансовая");
	Если СеансоваяНастройка <> Неопределено Тогда
		Попытка
			Группировки.Загрузить(СеансоваяНастройка.Группировки);
			
			// Отбор
			Если СеансоваяНастройка.Свойство("Отбор") Тогда
				Отчет.КомпоновщикНастроек.Настройки.Отбор.Элементы.Очистить();
				Для Каждого СтрОтбор из СеансоваяНастройка.Отбор.Элементы Цикл
					НовОтбор = Отчет.КомпоновщикНастроек.Настройки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
					ЗаполнитьЗначенияСвойств(НовОтбор, СтрОтбор);
				КонецЦикла;	
			КонецЕсли;
			// Отбор
			
			//показатели
			мПоказатели = Неопределено;
			СеансоваяНастройка.Свойство("Показатели", мПоказатели);
			Если мПоказатели <> Неопределено Тогда
				УстановитьВыбранныеПоказатели(мПоказатели);
			КонецЕсли;
			//показатели
			
			СеансоваяНастройка.Свойство("ВыводитьДокументыДвижения", ВыводитьДокументыДвижения);
			

		Исключение
		КонецПопытки; 
	КонецЕсли; 
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВыбранныеПоказатели(мПоказатели)
	
	Для Каждого Показатель из мПоказатели Цикл
		ЭлементСписка = Показатели.НайтиПоЗначению(Показатель);
		Если ЭлементСписка <> Неопределено Тогда
			ЭлементСписка.Пометка = истина;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура _СохранитьСеансовуюНастройку()
	
	Если Отчет.ВнешнийВызов Тогда
		Возврат;
	КонецЕсли;
	
	мВыбранныеПоказатели = ПолучитьВыбранныеПоказатели();

	СтруктураНастройки = Новый Структура();
	СтруктураНастройки.Вставить("Группировки",	Группировки.Выгрузить());
	СтруктураНастройки.Вставить("Показатели",	мВыбранныеПоказатели);
	СтруктураНастройки.Вставить("Отбор", 		Отчет.КомпоновщикНастроек.Настройки.Отбор);
	
	СтруктураНастройки.Вставить("ВыводитьДокументыДвижения", ВыводитьДокументыДвижения);

	Идентификатор = РеквизитФормыВЗначение("Отчет").Метаданные().Имя;
	ХранилищеСистемныхНастроек.Сохранить(Идентификатор, "Сеансовая", СтруктураНастройки);
	
КонецПроцедуры

&НаСервере
Функция ПолучитьВыбранныеПоказатели()
	
	мВыбранныеПоказатели = Новый Массив;
	Для каждого ЭлементСписка из Показатели Цикл
		Если ЭлементСписка.Пометка Тогда
			мВыбранныеПоказатели.Добавить(ЭлементСписка.Значение);	
		КонецЕсли;
	КонецЦикла;
	
	Возврат мВыбранныеПоказатели;

КонецФункции

