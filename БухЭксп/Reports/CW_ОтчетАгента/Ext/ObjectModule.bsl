#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
Функция ОтчетВывести(ТабДок) Экспорт 
	ПостроительОтчетаОтчет = ПостроительОтчета;
	
    ПостроительОтчетаОтчет.Параметры.Очистить();
	ПостроительОтчетаОтчет.Параметры.Вставить("Дата1", НачПериода);
	ПостроительОтчетаОтчет.Параметры.Вставить("Дата2", КонецДня(КонПериода));
	ПостроительОтчетаОтчет.Параметры.Вставить("Контрагент", Контрагент);
	ПостроительОтчетаОтчет.Параметры.Вставить("Договор", 	Договор);
	ПостроительОтчетаОтчет.Параметры.Вставить("ПриложениеКДоговору", ПриложениеКДоговору);
	ПостроительОтчетаОтчет.Выполнить();
	
	Если ПостроительОтчетаОтчет.Результат.Пустой() Тогда 
		ТабДок.Область(1,1).Текст = "Нет данных за указанный период";
		Возврат(Ложь);
	КонецЕсли;
	
	// Формирование табличного документа
	ТабДок.Очистить();
	
	МакетОтчета = ПолучитьМакет("Макет");	
	
	// Сформируем область итогов, не выводя пока что
	ВыборкаОбщийИтог = ПостроительОтчетаОтчет.Результат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	ВыборкаОбщийИтог.Следующий();
	
	Если ЗначениеЗаполнено(ВыборкаОбщийИтог.БазаРубОборот) Тогда 
		естьБаза = Истина;
	Иначе 
		естьБаза = Ложь;
	КонецЕсли;
	
	Если естьБаза Тогда 
		ОбластьОбщихИтогов = МакетОтчета.ПолучитьОбласть("ОбщиеИтоги");
		ОбластьОбщихИтогов.Параметры.Заполнить(ВыборкаОбщийИтог);
	Иначе 
		ОбластьОбщихИтогов = МакетОтчета.ПолучитьОбласть("ОбщиеИтоги|ЛеваяЧасть");
		ОбластьОбщихИтогов.Параметры.Заполнить(ВыборкаОбщийИтог);
		ОбластьОбщихИтогов2 = МакетОтчета.ПолучитьОбласть("ОбщиеИтоги|ПраваяЧасть");
		ОбластьОбщихИтогов2.Параметры.Заполнить(ВыборкаОбщийИтог);
	КонецЕсли;
	
	Если ВыборкаОбщийИтог.КоличествоРазличныхВариантовРасчетаВознаграждения > 1 Тогда 
		Сообщить("Обнаружено "+ВыборкаОбщийИтог.КоличествоРазличныхВариантовРасчетаВознаграждения + " различных вариантов расчета вознаграждения!");
	КонецЕсли;
	Если ВыборкаОбщийИтог.КоличествоРазличныхВалют > 1 Тогда 
		Сообщить("Обнаружено "+ВыборкаОбщийИтог.КоличествоРазличныхВалют + " различных валют начисления вознаграждения!");
	КонецЕсли;
	
	Если естьБаза Тогда 
		Область = МакетОтчета.ПолучитьОбласть("Заголовок");
	Иначе 
		Область = МакетОтчета.ПолучитьОбласть("Заголовок|ЛеваяЧасть");
	КонецЕсли;						
								
	Область.Параметры.НомерДоговора = СокрЛП(Договор.НомерДоговора);
	Область.параметры.ДатаДоговора  = Формат(Договор.ДатаДоговора, "ДФ=dd.MM.yy") + " г.";
	
	СтруктураПараметров = CW_Настройки.ПустаяСтруктураПолученияПараметровДоговора();
	СтруктураПараметров.Дата 				= КонПериода;
	СтруктураПараметров.Договор 			= Договор;
	СтруктураПараметров.ПриложениеКДоговору = ПриложениеКДоговору;
	
	ПараметрыДоговора	= CW_Настройки.ПолучитьПараметрыДоговора(СтруктураПараметров, "РасчетныйСчетОрганизации");
	РСчет 				= ПараметрыДоговора.РасчетныйСчетОрганизации;
	
	Если НЕ ЗначениеЗаполнено(РСчет) Тогда
		БанкИсполнителя = Договор.Организация.ОсновнойБанковскийСчет.Банк;
		БанковскийСчет = Договор.Организация.ОсновнойБанковскийСчет.Банк.КоррСчет;
		НомерСчета = Договор.Организация.ОсновнойБанковскийСчет.НомерСчета;
		БИК = Договор.Организация.ОсновнойБанковскийСчет.Банк.Код;
	Иначе
		БанкИсполнителя = РСчет.Банк;
		БанковскийСчет = РСчет.Банк.КоррСчет;
		НомерСчета = РСчет.НомерСчета;
		БИК = РСчет.Банк.Код;
	КонецЕсли;

	Исполнитель = Договор.Организация.НаименованиеСокращенное;
	ИННИсполнителя = Договор.Организация.ИНН;
	КППИсполнителя = Договор.Организация.КПП;
	
	СтруктураПараметров = CW_Настройки.ПустаяСтруктураПолученияПараметровДоговора();
	СтруктураПараметров.Дата 				= КонПериода;
	СтруктураПараметров.Договор 			= Договор;
	СтруктураПараметров.ПриложениеКДоговору = ПриложениеКДоговору;
	
	ПараметрыДоговора	= CW_Настройки.ПолучитьПараметрыДоговора(СтруктураПараметров);
	
	АдресИсполнителя 	= ПараметрыДоговора.АдресОрганизации;
	АдресПолучателя 	= ПараметрыДоговора.Адрес;
	
	Получатель=Контрагент.НаименованиеПолное;
	
	СчетПолучателя = ПараметрыДоговора.РасчетныйСчет;
	Если СчетПолучателя = Неопределено ИЛИ СчетПолучателя.Пустая() Тогда
		БанкПолучателя=Контрагент.ОсновнойБанковскийСчет.Банк;
		БанковскийСчетПолучателя=Контрагент.ОсновнойБанковскийСчет.Банк.КоррСчет;
		НомерСчетаПолучателя=Контрагент.ОсновнойБанковскийСчет.НомерСчета;
		БИКПолучателя=Контрагент.ОсновнойБанковскийСчет.Банк.Код;
	Иначе
		БанкПолучателя = СчетПолучателя.Банк;
		БанковскийСчетПолучателя = СчетПолучателя.Банк.КоррСчет;
		НомерСчетаПолучателя = СчетПолучателя.НомерСчета;
		БИКПолучателя = СчетПолучателя.Банк.Код;
	КонецЕсли;	
	
	ИННПолучателя=Контрагент.ИНН;
	КПППолучателя=Контрагент.КПП;
	
	Область.Параметры.Исполнитель = Исполнитель + Символы.ПС + "ИНН/КПП: " + ИННИсполнителя + "/" + КППИсполнителя + Символы.ПС 
									+ "Адрес: " + АдресИсполнителя + Символы.ПС + "Р/счет: " + НомерСчета + Символы.ПС  
									+ БанкИсполнителя + Символы.ПС + "К/счет: " + БанковскийСчет + Символы.ПС + "БИК: " + БИК;
	
	Если естьБаза Тогда 
		Область.Параметры.Заказчик = Получатель + Символы.ПС + "ИНН/КПП: " + ИННПолучателя + "/" + КПППолучателя + Символы.ПС 
								 + "Адрес: " + АдресПолучателя + Символы.ПС + "Р/счет: " + НомерСчетаПолучателя + Символы.ПС 
								 + БанкПолучателя + Символы.ПС + "К/счет: " + БанковскийСчетПолучателя + Символы.ПС + "БИК: " + БИКПолучателя;
		ТабДок.Вывести(Область);
	Иначе 
		ТабДок.Вывести(Область);
		Область = МакетОтчета.ПолучитьОбласть("Заголовок|ПраваяЧасть");
		Область.Параметры.Заказчик = Получатель + Символы.ПС + "ИНН/КПП: " + ИННПолучателя + "/" + КПППолучателя + Символы.ПС 
								 + "Адрес: " + АдресПолучателя + Символы.ПС + "Р/счет: " + НомерСчетаПолучателя + Символы.ПС 
								 + БанкПолучателя + Символы.ПС + "К/счет: " + БанковскийСчетПолучателя + Символы.ПС + "БИК: " + БИКПолучателя;
		ТабДок.Присоединить(Область);
	КонецЕсли;								
	
	// заполним и выведем шапку таблицы
	Если естьБаза Тогда 
		Область = МакетОтчета.ПолучитьОбласть("ШапкаТаблицы");
	Иначе 
		Область = МакетОтчета.ПолучитьОбласть("ШапкаТаблицы|ЛеваяЧасть");
	КонецЕсли;
	Если ВыборкаОбщийИтог.ВариантРасчетаВознаграждения = Перечисления.CW_ВариантыАвтоматическогоРасчетаВознаграждения.ПроцентОтСуммы Тогда 
		Область.Параметры.ПроцентЛибоСумма = "%";
	ИначеЕсли ВыборкаОбщийИтог.ВариантРасчетаВознаграждения = Перечисления.CW_ВариантыАвтоматическогоРасчетаВознаграждения.ФиксированнаяСумма Тогда 
		Область.Параметры.ПроцентЛибоСумма = ""+Договор.ВалютаДоговора;
	Иначе
		Область.Параметры.ПроцентЛибоСумма = "?";
	КонецЕсли;
	
	Если естьБаза Тогда 
		Область.Параметры.ВалютаДоговора = Договор.ВалютаДоговора;
		ТабДок.Вывести(Область);
	Иначе 
		ТабДок.Вывести(Область);
		Область = МакетОтчета.ПолучитьОбласть("ШапкаТаблицы|ПраваяЧасть");
		Область.Параметры.ВалютаДоговора = Договор.ВалютаДоговора;
		ТабДок.Присоединить(Область);
	КонецЕсли;
	
	ЧислоГруппировок = ПостроительОтчетаОтчет.ИзмеренияСтроки.Количество();
	
	ВыводГруппировок(ВыборкаОбщийИтог.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам), ЧислоГруппировок, МакетОтчета, ТабДок, ЕстьБаза);
		
	Если естьБаза Тогда 
		ТабДок.Вывести(ОбластьОбщихИтогов, ВыборкаОбщийИтог.Уровень());
	Иначе 
		ТабДок.Вывести(ОбластьОбщихИтогов, ВыборкаОбщийИтог.Уровень());
		ТабДок.Присоединить(ОбластьОбщихИтогов2, ВыборкаОбщийИтог.Уровень());
	КонецЕсли;
	
	Область = МакетОтчета.ПолучитьОбласть("Подписи");
		
	// получим должность руководителя из доп.реквизитов контрагента
	СтруктураПараметров = CW_Настройки.ПустаяСтруктураПолученияПараметровДоговора();
	СтруктураПараметров.Дата 				= КонПериода;
	СтруктураПараметров.Договор 			= Договор;
	СтруктураПараметров.ПриложениеКДоговору = ПриложениеКДоговору;
	
	ПараметрыДоговора	= CW_Настройки.ПолучитьПараметрыДоговора(СтруктураПараметров);
	Тмп 				= ПараметрыДоговора.ДолжностьРуководителя;

	Область.Параметры.ДолжностьРуководителяЗаказчика = ?(ПустаяСтрока(Тмп),"Руководитель предприятия ", СокрЛП(Тмп) + " ");
	
	Область.Параметры.ИсполнительНаименование = Исполнитель;
	Область.Параметры.ПолучательНаименование = Получатель;
	
	Подписанты = ВернутьПодписантов(Договор.Организация, КонПериода, ПараметрыДоговора); 
	Область.Параметры.ДолжностьРуководителя = Подписанты.РуководительДолжностьРус;
	Область.Параметры.ФИОРуководителя = CW_Печать.ФамилияИОИзСтрокиФамилияИмяОтчество(Подписанты.Руководитель,НачПериода) + ?(ЗначениеЗаполнено(Подписанты.РуководительОснованиеРус), " (" + Подписанты.РуководительОснованиеРус + ")", ""); 
	
	Область.Параметры.ФИОЗаказчика = CW_Печать.ФамилияИОИзСтрокиФамилияИмяОтчество(ПараметрыДоговора.Руководитель,НачПериода);
	
	ТабДок.Вывести(Область);

	ТабДок.ОриентацияСтраницы 	= ОриентацияСтраницы.Портрет;
	ТабДок.АвтоМасштаб=Истина;
	
	Возврат Истина;
	
КонецФункции

Функция ВернутьПодписантов(Знач Организация, Дата, ПараметрыДоговора) Экспорт
	
	Ответ = Новый Структура;
	
	Если ПараметрыДоговора.РежимПодписей = 0  Тогда
		
		ВладелецПараметров = ПараметрыДоговора.Договор;
		Если ТипЗнч(ВладелецПараметров) = Тип("СправочникСсылка.CW_ДоговорыПоГрузоперевозкам") Тогда
			Организация = ВладелецПараметров.Организация;
		Иначе
			Организация = ВладелецПараметров.Договор.Организация;
		КонецЕсли;
		
		ДанныеОтветственных = РегистрыСведений.CW_ПараметрыДоговоров.ПолучитьОтветственныхЛицИзКарточкиОрганизации(Организация, Дата);
		
		Ответ.Вставить("Руководитель",              ДанныеОтветственных.РуководительОрганизации);
		Ответ.Вставить("РуководительПоДоговору",	ДанныеОтветственных.РуководительОрганизации);
		Ответ.Вставить("РуководительДолжностьРус",	ДанныеОтветственных.ДолжностьРуководителя);
		Ответ.Вставить("РуководительОснованиеРус",  "");
		
		Ответ.Вставить("ГлБух",						ДанныеОтветственных.ГлавныйБухгалтер);
		Ответ.Вставить("ГлБухОснованиеРус",			ДанныеОтветственных.ГлавныйБухгалтер);
		
	ИначеЕсли ПараметрыДоговора.РежимПодписей = 1 Тогда
		
		Ответ.Вставить("Руководитель",             ПараметрыДоговора.РуководительОрганизации);
		Ответ.Вставить("РуководительДолжностьРус", ПараметрыДоговора.ДолжностьРуководителяОрганизации);
		Ответ.Вставить("РуководительДолжностьАнг", ПараметрыДоговора.ДолжностьРуководителяОрганизацииАнгл);
		Ответ.Вставить("РуководительОснованиеРус", ПараметрыДоговора.РуководительОснование);
		Ответ.Вставить("РуководительОснованиеАнг", ПараметрыДоговора.РуководительОснованиеАнгл);
		
		Ответ.Вставить("ГлБух",             ПараметрыДоговора.ГлавныйБухгалтерОрганизации);
		Ответ.Вставить("ГлБухОснованиеРус", ПараметрыДоговора.ГлавныйБухгалтерОснование);
		Ответ.Вставить("ГлБухОснованиеАнг", ПараметрыДоговора.ГлавныйБухгалтерОснованиеАнгл);
		
		
	ИначеЕсли ПараметрыДоговора.РежимПодписей = 2 Тогда
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	CW_ЛицаПодписывающиеДокументыСрезПоследних.Руководитель,
		|	CW_ЛицаПодписывающиеДокументыСрезПоследних.РуководительДолжность,
		|	CW_ЛицаПодписывающиеДокументыСрезПоследних.РуководительДолжностьАнгл,
		|	CW_ЛицаПодписывающиеДокументыСрезПоследних.РуководительОснование,
		|	CW_ЛицаПодписывающиеДокументыСрезПоследних.РуководительОснованиеАнгл,
		|	CW_ЛицаПодписывающиеДокументыСрезПоследних.ГлБухгалтер,
		|	CW_ЛицаПодписывающиеДокументыСрезПоследних.ГлБухгалтерОснование,
		|	CW_ЛицаПодписывающиеДокументыСрезПоследних.ГлБухгалтерОснованиеАнгл
		|ИЗ
		|	РегистрСведений.CW_ЛицаПодписывающиеДокументы.СрезПоследних(
		|			&Дата,
		|			Вариант = &Вариант
		|				И Организация = &Организация) КАК CW_ЛицаПодписывающиеДокументыСрезПоследних";
		Запрос.УстановитьПараметр("Вариант", ПараметрыДоговора.ВариантПодписей);
		Запрос.УстановитьПараметр("Организация", Организация);
		Запрос.УстановитьПараметр("Дата", Дата);
		ТЗ = Запрос.Выполнить().Выбрать();
		Если ТЗ.Следующий() Тогда
			Ответ.Вставить("Руководитель",             ТЗ.Руководитель);
			Ответ.Вставить("РуководительДолжностьРус", ТЗ.РуководительДолжность);
			Ответ.Вставить("РуководительДолжностьАнг", ТЗ.РуководительДолжностьАнгл);
			Ответ.Вставить("РуководительОснованиеРус", ТЗ.РуководительОснование);
			Ответ.Вставить("РуководительОснованиеАнг", ТЗ.РуководительОснованиеАнгл);
			
			Ответ.Вставить("ГлБух",             ТЗ.ГлБухгалтер);
			Ответ.Вставить("ГлБухОснованиеРус", ТЗ.ГлБухгалтерОснование);
			Ответ.Вставить("ГлБухОснованиеАнг", ТЗ.ГлБухгалтерОснованиеАнгл);
		Иначе
			Ответ.Вставить("Руководитель",             "");
			Ответ.Вставить("РуководительДолжностьРус", "");
			Ответ.Вставить("РуководительДолжностьАнг", "");
			Ответ.Вставить("РуководительОснованиеРус", "");
			Ответ.Вставить("РуководительОснованиеАнг", "");
			
			Ответ.Вставить("ГлБух",             "");
			Ответ.Вставить("ГлБухОснованиеРус", "");
			Ответ.Вставить("ГлБухОснованиеАнг", "");
		КонецЕсли;	
		
	КонецЕсли;	
	
	Возврат Ответ;
	
КонецФункции

Процедура ВыводГруппировок(ВыборкаТекущегоУровня, ЧислоГруппировок, МакетОтчета, ТаблДок, ЕстьБаза)
	
	нпп=0;
	Пока ВыборкаТекущегоУровня.Следующий() Цикл 
		нпп=нпп+1;
		        		
		Если ЕстьБаза Тогда 
			Область = МакетОтчета.ПолучитьОбласть("Строка");
			Область.Параметры.Заполнить(ВыборкаТекущегоУровня); 
			Область.Параметры.Номер = нпп;
			//Область.Параметры.Группировка = ВыборкаТекущегоУровня[ПостроительОтчетаОтчет.ИзмеренияСтроки.Получить(ВыборкаТекущегоУровня.Уровень() - 1).Имя];
			//Область.Параметры.Расшифровка = ВыборкаТекущегоУровня[ПостроительОтчетаОтчет.ИзмеренияСтроки.Получить(ВыборкаТекущегоУровня.Уровень() - 1).Имя];
			ТаблДок.Вывести(Область, ВыборкаТекущегоУровня.Уровень());	
		Иначе 
			обл1 = МакетОтчета.ПолучитьОбласть("Строка|ЛеваяЧасть");
			обл2 = МакетОтчета.ПолучитьОбласть("Строка|ПраваяЧасть");
			обл1.Параметры.Заполнить(ВыборкаТекущегоУровня); 
			обл1.Параметры.Номер = нпп;
			обл2.Параметры.Заполнить(ВыборкаТекущегоУровня); 
			ТаблДок.Вывести(обл1, ВыборкаТекущегоУровня.Уровень());	
			ТаблДок.Присоединить(обл2, ВыборкаТекущегоУровня.Уровень());
		КонецЕсли;
			
		// Перейдем на нижний уровень
		//---------------------------------------------------------------------------------------
		Если ВыборкаТекущегоУровня.Уровень() < ЧислоГруппировок Тогда                     		
			ВыборкаСледующегоУровня = ВыборкаТекущегоУровня.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			ВыводГруппировок(ВыборкаСледующегоУровня, ЧислоГруппировок,  МакетОтчета, ТаблДок, ЕстьБаза);
		Иначе 
			//ВыборкаСледующегоУровня = ВыборкаТекущегоУровня.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			//ВыводДетальныхЗаписей(ВыборкаСледующегоУровня, МакетОтчета, ТаблДок);
		КонецЕсли;
		
	КонецЦикла;
		
КонецПроцедуры

Процедура ВыводДетальныхЗаписей(ВыборкаТекущегоУровня, МакетОтчета, ТаблДок)
		
	Пока ВыборкаТекущегоУровня.Следующий() Цикл 
		        		
		// Выведим область
		Область = МакетОтчета.ПолучитьОбласть("ДетальныеЗаписи");
		Область.Параметры.Заполнить(ВыборкаТекущегоУровня); 
		Область.Параметры.ДокументыСтрокой = ВыборкаТекущегоУровня.Документ.ПредставлениеДокумента;
		
		ТаблДок.Вывести(Область, ВыборкаТекущегоУровня.Уровень());	
					
	КонецЦикла;
		
КонецПроцедуры

