////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	CW_ТопливоТСОстаткиИОбороты.Организация КАК Организация,
	CW_ТопливоТСОстаткиИОбороты.ТранспортноеСредство КАК ТранспортноеСредство,
	ВТ_Склады.Склад КАК Склад,
	CW_ТопливоТСОстаткиИОбороты.Топливо КАК Топливо,
	CW_ТопливоТСОстаткиИОбороты.КоличествоНачальныйОстаток КАК НачОст_ОУ,
	CW_ТопливоТСОстаткиИОбороты.КоличествоПриход КАК Приход_УУ,
	CW_ТопливоТСОстаткиИОбороты.КоличествоРасход КАК Расход_УУ,
	CW_ТопливоТСОстаткиИОбороты.КоличествоКонечныйОстаток КАК КонОст_ОУ
ПОМЕСТИТЬ ВТ_ТопливоТС
ИЗ
	РегистрНакопления.CW_ТопливоТС.ОстаткиИОбороты(
			,
			,
			Период,
			,
			ТранспортноеСредство В
				(ВЫБРАТЬ
					ВТ_Склады.ТранспортноеСредство КАК ТранспортноеСредство
				ИЗ
					ВТ_Склады КАК ВТ_Склады)) КАК CW_ТопливоТСОстаткиИОбороты
		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Склады КАК ВТ_Склады
		ПО CW_ТопливоТСОстаткиИОбороты.ТранспортноеСредство = ВТ_Склады.ТранспортноеСредство
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ХозрасчетныйОстаткиИОбороты.Организация КАК Организация,
	ВТ_Склады.ТранспортноеСредство КАК ТранспортноеСредство,
	ХозрасчетныйОстаткиИОбороты.Субконто1 КАК Склад,
	ХозрасчетныйОстаткиИОбороты.Субконто2 КАК Топливо,
	ХозрасчетныйОстаткиИОбороты.КоличествоНачальныйОстаток КАК НачОст_БУ,
	ХозрасчетныйОстаткиИОбороты.КоличествоОборотДт КАК Приход_БУ,
	ХозрасчетныйОстаткиИОбороты.КоличествоОборотКт КАК Расход_БУ,
	ХозрасчетныйОстаткиИОбороты.КоличествоКонечныйОстатокДт КАК КонОст_БУ
ПОМЕСТИТЬ ВТ_ДанныеБУ
ИЗ
	РегистрБухгалтерии.Хозрасчетный.ОстаткиИОбороты(
			,
			,
			Период,
			,
			Счет = &amp;Счет_Топлива,
			&amp;Субконто,
			Субконто1 В
				(ВЫБРАТЬ
					ВТ_Склады.Склад КАК Склад
				ИЗ
					ВТ_Склады КАК ВТ_Склады)) КАК ХозрасчетныйОстаткиИОбороты
		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Склады КАК ВТ_Склады
		ПО ХозрасчетныйОстаткиИОбороты.Субконто1 = ВТ_Склады.Склад
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВТ_ТопливоТС.Организация КАК Организация,
	ВТ_ТопливоТС.ТранспортноеСредство КАК ТранспортноеСредство,
	ВТ_ТопливоТС.Склад КАК Склад,
	ВТ_ТопливоТС.Топливо КАК Топливо,
	ВТ_ТопливоТС.НачОст_ОУ КАК НачОст_ОУ,
	0 КАК НачОст_БУ,
	ВТ_ТопливоТС.Приход_УУ КАК Приход_ОУ,
	0 КАК Приход_БУ,
	ВТ_ТопливоТС.Расход_УУ КАК Расход_ОУ,
	0 КАК Расход_БУ,
	ВТ_ТопливоТС.КонОст_ОУ КАК КонОст_ОУ,
	0 КАК КонОст_БУ
ИЗ
	ВТ_ТопливоТС КАК ВТ_ТопливоТС

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	ВТ_ДанныеБУ.Организация,
	ВТ_ДанныеБУ.ТранспортноеСредство,
	ВТ_ДанныеБУ.Склад,
	ВТ_ДанныеБУ.Топливо,
	0,
	ВТ_ДанныеБУ.НачОст_БУ,
	0,
	ВТ_ДанныеБУ.Приход_БУ,
	0,
	ВТ_ДанныеБУ.Расход_БУ,
	0,
	ВТ_ДанныеБУ.КонОст_БУ
ИЗ
	ВТ_ДанныеБУ КАК ВТ_ДанныеБУ</query>
