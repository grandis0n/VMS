	РегистрСведений.CW_ДоходыНерезидентовСписокСчетов КАК CW_ДоходыНерезидентовСписокСчетов
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	Контрагенты.Ссылка КАК Ссылка
ПОМЕСТИТЬ ВТ_Нерезиденты
ИЗ
	Справочник.Контрагенты КАК Контрагенты
ГДЕ
	Контрагенты.ЭтоГруппа = ЛОЖЬ
	И Контрагенты.СтранаРегистрации &lt;&gt; ЗНАЧЕНИЕ(Справочник.СтраныМира.Россия)
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	CW_ДоходыНерезидентовДокументыИсключения.Документ КАК Документ
ПОМЕСТИТЬ ВТ_Исключения
ИЗ
	РегистрСведений.CW_ДоходыНерезидентовДокументыИсключения КАК CW_ДоходыНерезидентовДокументыИсключения
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ХозрасчетныйОбороты.Организация КАК Организация,
	ХозрасчетныйОбороты.Субконто1 КАК Контрагент,
	ХозрасчетныйОбороты.Субконто2 КАК ДоговорКонтрагента,
	ВЫБОР
		КОГДА ХозрасчетныйОбороты.Счет.Валютный
			ТОГДА ХозрасчетныйОбороты.Валюта
		ИНАЧЕ &amp;ВалютаРегламентированногоУчета
	КОНЕЦ КАК Валюта,
	ХозрасчетныйОбороты.Регистратор КАК Документ,
	СУММА(ВЫБОР
			КОГДА ХозрасчетныйОбороты.Счет.Валютный
				ТОГДА ХозрасчетныйОбороты.ВалютнаяСуммаОборотДт
			ИНАЧЕ ХозрасчетныйОбороты.СуммаОборотДт
		КОНЕЦ) КАК СуммаПоДокументу,
	ВЫБОР
		КОГДА ВТ_Исключения.Документ ЕСТЬ NULL
			ТОГДА ЛОЖЬ
		ИНАЧЕ ИСТИНА
	КОНЕЦ КАК Исключение
ПОМЕСТИТЬ ВТ_Проводки
ИЗ
	РегистрБухгалтерии.Хозрасчетный.Обороты(
			&amp;НачалоПериода,
			&amp;КонецПериода,
			Регистратор,
			Счет В
				(ВЫБРАТЬ
					ВТ_СчетаУчета.Счет КАК Счет
				ИЗ
					ВТ_СчетаУчета КАК ВТ_СчетаУчета),
			&amp;ВидыСубконто,
			Субконто1 В
					(ВЫБРАТЬ
						ВТ_Нерезиденты.Ссылка КАК Ссылка
					ИЗ
						ВТ_Нерезиденты КАК ВТ_Нерезиденты)
				И (ЕСТЬNULL(Субконто1, НЕОПРЕДЕЛЕНО) &lt;&gt; ЕСТЬNULL(КорСубконто1, НЕОПРЕДЕЛЕНО)
					ИЛИ ЕСТЬNULL(Субконто2, НЕОПРЕДЕЛЕНО) &lt;&gt; ЕСТЬNULL(КорСубконто2, НЕОПРЕДЕЛЕНО)),
			КорСчет &lt;&gt; &amp;Счет91001,
			) КАК ХозрасчетныйОбороты
		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Исключения КАК ВТ_Исключения
		ПО ХозрасчетныйОбороты.Регистратор = ВТ_Исключения.Документ
ГДЕ
	ВЫБОР
			КОГДА ХозрасчетныйОбороты.Счет.Валютный
				ТОГДА ХозрасчетныйОбороты.ВалютнаяСуммаОборотДт
			ИНАЧЕ ХозрасчетныйОбороты.СуммаОборотДт
		КОНЕЦ &lt;&gt; 0

СГРУППИРОВАТЬ ПО
	ХозрасчетныйОбороты.Субконто2,
	ХозрасчетныйОбороты.Субконто1,
	ХозрасчетныйОбороты.Регистратор,
	ХозрасчетныйОбороты.Организация,
	ВЫБОР
		КОГДА ХозрасчетныйОбороты.Счет.Валютный
			ТОГДА ХозрасчетныйОбороты.Валюта
		ИНАЧЕ &amp;ВалютаРегламентированногоУчета
	КОНЕЦ,
	ВЫБОР
		КОГДА ВТ_Исключения.Документ ЕСТЬ NULL
			ТОГДА ЛОЖЬ
		ИНАЧЕ ИСТИНА
	КОНЕЦ
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВТ_Проводки.Организация КАК Организация,
	ВТ_Проводки.Контрагент КАК Контрагент,
	ВТ_Проводки.ДоговорКонтрагента КАК ДоговорКонтрагента,
	ВТ_Проводки.Валюта КАК Валюта,
	ВТ_Проводки.Документ КАК Документ,
	СУММА(ВТ_Проводки.СуммаПоДокументу) КАК СуммаПоДокументу,
	ЕСТЬNULL(CW_ДоходыНерезидентовСведенияОДоходах.Ссылка, НЕОПРЕДЕЛЕНО) КАК СведенияОДоходах,
	СУММА(ЕСТЬNULL(CW_ДоходыНерезидентовСведенияОДоходах.СуммаДохода, 0)) КАК СуммаДохода,
	ЕСТЬNULL(CW_ДоходыНерезидентовСведенияОДоходах.ТребуетсяЗаполнение, ЛОЖЬ) КАК ТребуетсяЗаполнение,
	ЕСТЬNULL(CW_ДоходыНерезидентовСведенияОДоходах.Валюта, НЕОПРЕДЕЛЕНО) КАК ВалютаСведений,
	ВТ_Проводки.Исключение КАК Исключение
ПОМЕСТИТЬ ВТ_ПоПроводкам
ИЗ
	ВТ_Проводки КАК ВТ_Проводки
		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.CW_ДоходыНерезидентовСведенияОДоходах КАК CW_ДоходыНерезидентовСведенияОДоходах
		ПО ВТ_Проводки.Контрагент = CW_ДоходыНерезидентовСведенияОДоходах.Контрагент
			И ВТ_Проводки.ДоговорКонтрагента = CW_ДоходыНерезидентовСведенияОДоходах.ДоговорКонтрагента
			И ВТ_Проводки.Документ = CW_ДоходыНерезидентовСведенияОДоходах.Документ

СГРУППИРОВАТЬ ПО
	ЕСТЬNULL(CW_ДоходыНерезидентовСведенияОДоходах.Ссылка, НЕОПРЕДЕЛЕНО),
	ЕСТЬNULL(CW_ДоходыНерезидентовСведенияОДоходах.Валюта, НЕОПРЕДЕЛЕНО),
	ЕСТЬNULL(CW_ДоходыНерезидентовСведенияОДоходах.ТребуетсяЗаполнение, ЛОЖЬ),
	ВТ_Проводки.Организация,
	ВТ_Проводки.Контрагент,
	ВТ_Проводки.ДоговорКонтрагента,
	ВТ_Проводки.Валюта,
	ВТ_Проводки.Документ,
	ВТ_Проводки.Исключение
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	CW_ДоходыНерезидентовСведенияОДоходах.Организация КАК Организация,
	CW_ДоходыНерезидентовСведенияОДоходах.Контрагент КАК Контрагент,
	CW_ДоходыНерезидентовСведенияОДоходах.ДоговорКонтрагента КАК ДоговорКонтрагента,
	CW_ДоходыНерезидентовСведенияОДоходах.Валюта КАК Валюта,
	CW_ДоходыНерезидентовСведенияОДоходах.Документ КАК Документ,
	0 КАК СуммаПоДокументу,
	CW_ДоходыНерезидентовСведенияОДоходах.Ссылка КАК Ссылка,
	CW_ДоходыНерезидентовСведенияОДоходах.СуммаДохода КАК СуммаДохода,
	CW_ДоходыНерезидентовСведенияОДоходах.ТребуетсяЗаполнение КАК ТребуетсяЗаполнение,
	CW_ДоходыНерезидентовСведенияОДоходах.Валюта КАК ВалютаСведений
ПОМЕСТИТЬ ВТ_ПоСправочнику
ИЗ
	Справочник.CW_ДоходыНерезидентовСведенияОДоходах КАК CW_ДоходыНерезидентовСведенияОДоходах
ГДЕ
	НЕ CW_ДоходыНерезидентовСведенияОДоходах.Ссылка В
				(ВЫБРАТЬ
					ВТ_ПоПроводкам.СведенияОДоходах КАК СведенияОДоходах
				ИЗ
					ВТ_ПоПроводкам КАК ВТ_ПоПроводкам
				ГДЕ
					ВТ_ПоПроводкам.СведенияОДоходах &lt;&gt; НЕОПРЕДЕЛЕНО)
	И CW_ДоходыНерезидентовСведенияОДоходах.Дата МЕЖДУ &amp;НачалоПериода И &amp;КонецПериода
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВТ_ПоПроводкам.Организация КАК Организация,
	ВТ_ПоПроводкам.Контрагент КАК Контрагент,
	ВТ_ПоПроводкам.ДоговорКонтрагента КАК ДоговорКонтрагента,
	ВТ_ПоПроводкам.Валюта КАК Валюта,
	ВТ_ПоПроводкам.Документ КАК Документ,
	МАКСИМУМ(ВТ_ПоПроводкам.СуммаПоДокументу) КАК СуммаПоДокументу,
	ВТ_ПоПроводкам.СведенияОДоходах КАК СведенияОДоходах,
	МАКСИМУМ(ВТ_ПоПроводкам.СуммаДохода) КАК СуммаДохода,
	ВТ_ПоПроводкам.ТребуетсяЗаполнение КАК ТребуетсяЗаполнение,
	ВТ_ПоПроводкам.ВалютаСведений КАК ВалютаСведений,
	ВТ_ПоПроводкам.Исключение КАК Исключение
ПОМЕСТИТЬ ВТ_Данные
ИЗ
	ВТ_ПоПроводкам КАК ВТ_ПоПроводкам

СГРУППИРОВАТЬ ПО
	ВТ_ПоПроводкам.Документ,
	ВТ_ПоПроводкам.Валюта,
	ВТ_ПоПроводкам.Контрагент,
	ВТ_ПоПроводкам.Организация,
	ВТ_ПоПроводкам.ВалютаСведений,
	ВТ_ПоПроводкам.ДоговорКонтрагента,
	ВТ_ПоПроводкам.ТребуетсяЗаполнение,
	ВТ_ПоПроводкам.СведенияОДоходах,
	ВТ_ПоПроводкам.Исключение

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	ВТ_ПоСправочнику.Организация,
	ВТ_ПоСправочнику.Контрагент,
	ВТ_ПоСправочнику.ДоговорКонтрагента,
	ВТ_ПоСправочнику.Валюта,
	ВТ_ПоСправочнику.Документ,
