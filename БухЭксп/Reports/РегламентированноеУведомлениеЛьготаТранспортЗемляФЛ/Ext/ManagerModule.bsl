Процедура ПроверкаБлокаЛьгот_2026(Данные, ТаблицаОшибок, ИмяСтраницы)
	Если Не ЗначениеЗаполнено(Данные.ПрСрНалЛьг) Тогда 
		ТаблицаОшибок.Добавить(Документы.УведомлениеОСпецрежимахНалогообложения.ПолучитьПустуюСтруктуруНавигацииПоОшибкам(
			"Не указан признак срока предоставления налоговой льготы", ИмяСтраницы, "ПрСрНалЛьг", Данные.УИД));
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Данные.ДатаНачСр) Тогда 
		ТаблицаОшибок.Добавить(Документы.УведомлениеОСпецрежимахНалогообложения.ПолучитьПустуюСтруктуруНавигацииПоОшибкам(
			"Не указана дата начала срока предоставления налоговой льготы", ИмяСтраницы, "ДатаНачСр", Данные.УИД));
	КонецЕсли;
	Если Данные.ПрСрНалЛьг = "1" И ЗначениеЗаполнено(Данные.ДатаКонСр) Тогда 
		ТаблицаОшибок.Добавить(Документы.УведомлениеОСпецрежимахНалогообложения.ПолучитьПустуюСтруктуруНавигацииПоОшибкам(
			"Дата окончания срока не указывается", ИмяСтраницы, "ДатаКонСр", Данные.УИД));
	ИначеЕсли Данные.ПрСрНалЛьг = "2" И Не ЗначениеЗаполнено(Данные.ДатаКонСр) Тогда 
		ТаблицаОшибок.Добавить(Документы.УведомлениеОСпецрежимахНалогообложения.ПолучитьПустуюСтруктуруНавигацииПоОшибкам(
			"Не указана дата окончания срока предоставления налоговой льготы", ИмяСтраницы, "ДатаКонСр", Данные.УИД));
	КонецЕсли;
	
	Если УведомлениеОСпецрежимахНалогообложения.БлокЗаполнен(
		Данные, "НаимДок,ВыдДок,ДатаДок,ПрПериодДок,ДатаНачПериод,ДатаКонПериод,СерНомДок") Тогда 
		
		Если Не ЗначениеЗаполнено(Данные.НаимДок) Тогда 
			ТаблицаОшибок.Добавить(Документы.УведомлениеОСпецрежимахНалогообложения.ПолучитьПустуюСтруктуруНавигацииПоОшибкам(
				"Не указано полное наименование документа", ИмяСтраницы, "НаимДок", Данные.УИД));
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Данные.ВыдДок) Тогда 
			ТаблицаОшибок.Добавить(Документы.УведомлениеОСпецрежимахНалогообложения.ПолучитьПустуюСтруктуруНавигацииПоОшибкам(
				"Не указано наименование органа, выдавшего документ", ИмяСтраницы, "ВыдДок", Данные.УИД));
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Данные.ДатаДок) Тогда 
			ТаблицаОшибок.Добавить(Документы.УведомлениеОСпецрежимахНалогообложения.ПолучитьПустуюСтруктуруНавигацииПоОшибкам(
				"Не указана дата выдачи документа", ИмяСтраницы, "ДатаДок", Данные.УИД));
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Данные.ПрПериодДок) Тогда 
			ТаблицаОшибок.Добавить(Документы.УведомлениеОСпецрежимахНалогообложения.ПолучитьПустуюСтруктуруНавигацииПоОшибкам(
				"Не указан признак периода действия документа", ИмяСтраницы, "ПрПериодДок", Данные.УИД));
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Данные.ДатаНачПериод) Тогда 
			ТаблицаОшибок.Добавить(Документы.УведомлениеОСпецрежимахНалогообложения.ПолучитьПустуюСтруктуруНавигацииПоОшибкам(
				"Не указана дата начала периода действия документа", ИмяСтраницы, "ДатаНачПериод", Данные.УИД));
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Данные.СерНомДок) Тогда 
			ТаблицаОшибок.Добавить(Документы.УведомлениеОСпецрежимахНалогообложения.ПолучитьПустуюСтруктуруНавигацииПоОшибкам(
				"Не указаны серия и номер документа", ИмяСтраницы, "СерНомДок", Данные.УИД));
		КонецЕсли;
		Если Данные.ПрПериодДок = "1" И ЗначениеЗаполнено(Данные.ДатаКонПериод) Тогда 
			ТаблицаОшибок.Добавить(Документы.УведомлениеОСпецрежимахНалогообложения.ПолучитьПустуюСтруктуруНавигацииПоОшибкам(
				"Дата окончания периода действия документа не указывается", ИмяСтраницы, "ДатаКонПериод", Данные.УИД));
		ИначеЕсли Данные.ПрПериодДок = "2" И Не ЗначениеЗаполнено(Данные.ДатаКонПериод) Тогда 
			ТаблицаОшибок.Добавить(Документы.УведомлениеОСпецрежимахНалогообложения.ПолучитьПустуюСтруктуруНавигацииПоОшибкам(
				"Не указана дата окончания периода действия документа", ИмяСтраницы, "ДатаКонПериод", Данные.УИД));
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

Функция ПроверитьДокументСВыводомВТаблицу_Форма2026_1(Данные, УникальныйИдентификатор)
	ТаблицаОшибок = Новый СписокЗначений;
	УведомлениеОСпецрежимахНалогообложения.ПроверкаАктуальностиФормыПриВыгрузке(
		Данные.Объект.ИмяФормы, ТаблицаОшибок, ПолучитьТаблицуФорм());
		
	Титульная = Данные.ДанныеУведомления.Титульная;
	Если Не ЗначениеЗаполнено(Титульная.Фамилия) Тогда 
		ТаблицаОшибок.Добавить(Документы.УведомлениеОСпецрежимахНалогообложения.ПолучитьПустуюСтруктуруНавигацииПоОшибкам(
			"Не указана фамилия", "Титульная", "Фамилия"));
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Титульная.Имя) Тогда 
		ТаблицаОшибок.Добавить(Документы.УведомлениеОСпецрежимахНалогообложения.ПолучитьПустуюСтруктуруНавигацииПоОшибкам(
			"Не указано имя", "Титульная", "Имя"));
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Титульная.ДАТА_ПОДПИСИ) Тогда 
		ТаблицаОшибок.Добавить(Документы.УведомлениеОСпецрежимахНалогообложения.ПолучитьПустуюСтруктуруНавигацииПоОшибкам(
			"Не указана дата подписи", "Титульная", "ДАТА_ПОДПИСИ"));
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Титульная.ПРИЗНАК_НП_ПОДВАЛ) Тогда 
		ТаблицаОшибок.Добавить(Документы.УведомлениеОСпецрежимахНалогообложения.ПолучитьПустуюСтруктуруНавигацииПоОшибкам(
			"Не указан признак подписанта", "Титульная", "ПРИЗНАК_НП_ПОДВАЛ"));
	КонецЕсли;
	Если Титульная.ПРИЗНАК_НП_ПОДВАЛ = "2" И Не ЗначениеЗаполнено(Титульная.НаимДок) Тогда 
		ТаблицаОшибок.Добавить(Документы.УведомлениеОСпецрежимахНалогообложения.ПолучитьПустуюСтруктуруНавигацииПоОшибкам(
			"Не указан документ представителя", "Титульная", "НаимДок"));
	КонецЕсли;
	УведомлениеОСпецрежимахНалогообложенияСлужебный.ПроверкаКодаНО(Титульная.КодНО, ТаблицаОшибок, "Титульная");
	УведомлениеОСпецрежимахНалогообложенияСлужебный.ПроверкаПодписантаНалоговойОтчетности(
		Данные, ТаблицаОшибок, "Титульная", Титульная.ПРИЗНАК_НП_ПОДВАЛ = "2");
		
	Если ЗначениеЗаполнено(СокрЛП(Титульная.ИНН)) Тогда 
		УведомлениеОСпецрежимахНалогообложенияСлужебный.ПроверкаИНН(
			Титульная, ТаблицаОшибок, "Титульная", "ИНН", Истина, Ложь);
		УведомлениеОСпецрежимахНалогообложенияСлужебный.Проверка_УдЛичнФЛ(
			"КодВидДок,СерНомДок,ДатаДок,ВыдДок", Титульная, ТаблицаОшибок, "Титульная", Ложь);
	Иначе
		УведомлениеОСпецрежимахНалогообложенияСлужебный.Проверка_УдЛичнФЛ(
			"КодВидДок,СерНомДок,ДатаДок,ВыдДок", Титульная, ТаблицаОшибок, "Титульная", Истина);
		Если Не ЗначениеЗаполнено(Титульная.ДатаРожд) Тогда 
			ТаблицаОшибок.Добавить(Документы.УведомлениеОСпецрежимахНалогообложения.ПолучитьПустуюСтруктуруНавигацииПоОшибкам(
				"Не указана дата рождения", "Титульная", "ДатаРожд"));
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Титульная.МестоРожд) Тогда 
			ТаблицаОшибок.Добавить(Документы.УведомлениеОСпецрежимахНалогообложения.ПолучитьПустуюСтруктуруНавигацииПоОшибкам(
				"Не указано место рождения", "Титульная", "МестоРожд"));
		КонецЕсли;
	КонецЕсли;
	
	ЕстьЗаполненныеЛисты = Ложь;
	Для Каждого Элт Из Данные.ДанныеМногостраничныхРазделов.СведТС Цикл
		Лист = Элт.Значение;
		Если Не УведомлениеОСпецрежимахНалогообложенияКлиентСервер.СтраницаЗаполнена(Лист) Тогда 
			Продолжить;
		КонецЕсли;
		
		ЕстьЗаполненныеЛисты = Истина;
		Если Не ЗначениеЗаполнено(Лист.ВидТС) Тогда 
			ТаблицаОшибок.Добавить(Документы.УведомлениеОСпецрежимахНалогообложения.ПолучитьПустуюСтруктуруНавигацииПоОшибкам(
				"Не указан вид транспортного средства", "СведТС", "ВидТС", Лист.УИД));
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Лист.РегЗнакТС) Тогда 
			ТаблицаОшибок.Добавить(Документы.УведомлениеОСпецрежимахНалогообложения.ПолучитьПустуюСтруктуруНавигацииПоОшибкам(
				"Не указан регистрационный знак транспортного средства", "СведТС", "РегЗнакТС", Лист.УИД));
		КонецЕсли;
		ПроверкаБлокаЛьгот_2026(Лист, ТаблицаОшибок, "СведТС");
	КонецЦикла;
	Для Каждого Элт Из Данные.ДанныеМногостраничныхРазделов.СведЗемУч Цикл
		Лист = Элт.Значение;
		Если Не УведомлениеОСпецрежимахНалогообложенияКлиентСервер.СтраницаЗаполнена(Лист) Тогда 
			Продолжить;
		КонецЕсли;
		
		ЕстьЗаполненныеЛисты = Истина;
		Если Не ЗначениеЗаполнено(Лист.НомКадастрЗУ) Тогда 
			ТаблицаОшибок.Добавить(Документы.УведомлениеОСпецрежимахНалогообложения.ПолучитьПустуюСтруктуруНавигацииПоОшибкам(
				"Не указан кадастровый номер", "СведЗемУч", "НомКадастрЗУ", Лист.УИД));
		КонецЕсли;
		ПроверкаБлокаЛьгот_2026(Лист, ТаблицаОшибок, "СведЗемУч");
	КонецЦикла;
	Для Каждого Элт Из Данные.ДанныеМногостраничныхРазделов.СведОН Цикл
		Лист = Элт.Значение;
		Если Не УведомлениеОСпецрежимахНалогообложенияКлиентСервер.СтраницаЗаполнена(Лист) Тогда 
			Продолжить;
		КонецЕсли;
		
		ЕстьЗаполненныеЛисты = Истина;
		Если Не ЗначениеЗаполнено(Лист.ВидОНИ) Тогда 
			ТаблицаОшибок.Добавить(Документы.УведомлениеОСпецрежимахНалогообложения.ПолучитьПустуюСтруктуруНавигацииПоОшибкам(
				"Не указан вид объекта", "СведОН", "ВидОНИ", Лист.УИД));
		КонецЕсли;
		ПроверкаБлокаЛьгот_2026(Лист, ТаблицаОшибок, "СведОН");
	КонецЦикла;
	
	Если Не ЕстьЗаполненныеЛисты Тогда
		ТаблицаОшибок.Добавить(Документы.УведомлениеОСпецрежимахНалогообложения.ПолучитьПустуюСтруктуруНавигацииПоОшибкам(
			"Не заполнены сведения о льготных объектах", "СведТС", "ВидТС", Данные.ДанныеМногостраничныхРазделов.СведТС[0].Значение.УИД));
	КонецЕсли;
	
	УведомлениеОСпецрежимахНалогообложения.ПолнаяПроверкаЗаполненныхПоказателейНаСоотвествиеСписку(
		"СпискиВыбора2026_1", "СхемаВыгрузкиФорма2026_1", Данные.Объект.ИмяОтчета, ТаблицаОшибок, Данные);
	УведомлениеОСпецрежимахНалогообложения.ПроверкаДатВУведомлении(Данные, ТаблицаОшибок);
	Возврат ТаблицаОшибок;
КонецФункции

Функция ОсновныеСведенияЭлектронногоПредставления(Объект, УникальныйИдентификатор)
	ОсновныеСведения = Документы.УведомлениеОСпецрежимахНалогообложения.НачальнаяИнициализацияОбщихРеквизитовВыгрузки(Объект);
	ИдентификаторФайла = ИдентификаторФайлаЭлектронногоПредставления(ОсновныеСведения);
	ОсновныеСведения.Вставить("ИдФайл", ИдентификаторФайла);
	Возврат ОсновныеСведения;
