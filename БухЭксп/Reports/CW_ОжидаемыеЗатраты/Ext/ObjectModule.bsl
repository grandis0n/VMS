
Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если Не ЗначениеЗаполнено(ВерсияБюджета) Тогда
		ВызватьИсключение "Не выбрана версия бюджета!";
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ФактическиПолученныеЗатратыНаДату) Тогда
		ВызватьИсключение "Не указана дата получаения затрат.";
	КонецЕсли;
	
	СКД = ПолучитьМакет("ОсновнаяСхемаКомпоновкиДанных");  
	
	КомпоновщикНастроек.Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("Период", ФактическиПолученныеЗатратыНаДату); 

	КомпоновщикМакета 	= Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки 	= КомпоновщикМакета.Выполнить(СКД, КомпоновщикНастроек.Настройки, ДанныеРасшифровки, , );
	
	ТаблицаЗначений = Новый ТаблицаЗначений;  
	
	МассивГрузоперевозок = ПолучитьМассивГрузоперевозок(КомпоновщикНастроек.Настройки.Отбор);
	
	ВТ_ОжидаемыеЗатраты = ПолучитьТаблицуОжидаемыхЗатрат(МассивГрузоперевозок);
	ВнешнийНаборДанных = Новый Структура("ВТ_ОжидаемыеЗатраты", ВТ_ОжидаемыеЗатраты);
	
	ПроцессорКомпоновкиДанных 	= Новый ПроцессорКомпоновкиДанных;    
	ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновки, ВнешнийНаборДанных, ДанныеРасшифровки);
	
	ПроцессорВыводаРезультата 	= Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;    
	ПроцессорВыводаРезультата.УстановитьДокумент(ДокументРезультат); 
	ПроцессорВыводаРезультата.Вывести(ПроцессорКомпоновкиДанных);
	
КонецПроцедуры

Функция ПолучитьТаблицуОжидаемыхЗатрат(МассивГрузоперевозок)
	
	ТаблицаОжидаемыхЗатрат = ПолучитьПустуюТаблицуОжидаемыхЗатрат(); 
	
	//ПорядокРасчетаРублевогоЭквивалента
	//По курсу статьи бюджета(0), По курсу на дату отчета(1)
	
	//Расходные статьи бюджета
	Запрос = Новый Запрос; 
	Запрос.Текст = "ВЫБРАТЬ
	               |	CW_ПлановыеСтатьиЗатратИДоходов.Организация КАК Организация,
	               |	CW_ПлановыеСтатьиЗатратИДоходов.Ссылка КАК ДокументДвижения,
	               |	CW_ПлановыеСтатьиЗатратИДоходов.Владелец КАК Грузоперевозка,
	               |	CW_ПлановыеСтатьиЗатратИДоходов.Владелец.Заказ КАК Заказ,
	               |	CW_ПлановыеСтатьиЗатратИДоходов.Контрагент КАК Контрагент,
	               |	CW_ПлановыеСтатьиЗатратИДоходов.Номенклатура КАК Номенклатура,
	               |	CW_ПлановыеСтатьиЗатратИДоходов.ПорядокОтраженияРасходов КАК ПорядокОтражения,
	               |	CW_ПлановыеСтатьиЗатратИДоходов.Валюта КАК Валюта,
	               |	CW_ПлановыеСтатьиЗатратИДоходов.Сумма КАК СуммаПланВал,
	               |	CW_ПлановыеСтатьиЗатратИДоходов.СуммаВсего КАК СуммаСНДСПланВал,
	               |	CW_ПлановыеСтатьиЗатратИДоходов.СуммаРуб КАК СуммаПлан,
	               |	CW_ПлановыеСтатьиЗатратИДоходов.СуммаВсегоРуб КАК СуммаСНДСПлан
	               |ПОМЕСТИТЬ ВТ_СтатьиПланирования
	               |ИЗ
	               |	Справочник.CW_ПлановыеСтатьиЗатратИДоходов КАК CW_ПлановыеСтатьиЗатратИДоходов
	               |ГДЕ
	               |	CW_ПлановыеСтатьиЗатратИДоходов.Владелец В(&МассивГрузоперевозок)
	               |	И CW_ПлановыеСтатьиЗатратИДоходов.ВерсияБюджета = &ВерсияБюджета
	               |	И CW_ПлановыеСтатьиЗатратИДоходов.ВидСтатьиПланирования = ЗНАЧЕНИЕ(Перечисление.CW_ВидыСтатейПланирования.Расходы)
	               |	И CW_ПлановыеСтатьиЗатратИДоходов.ПометкаУдаления = ЛОЖЬ
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	КурсыВалютСрезПоследних.Валюта КАК Валюта,
	               |	КурсыВалютСрезПоследних.Курс КАК Курс,
	               |	КурсыВалютСрезПоследних.Кратность КАК Кратность
	               |ПОМЕСТИТЬ ВТ_КурсыВалют
	               |ИЗ
	               |	РегистрСведений.КурсыВалют.СрезПоследних(
	               |			&НаДату,
	               |			Валюта В
	               |				(ВЫБРАТЬ
	               |					ВТ_СтатьиПланирования.Валюта КАК Валюта
	               |				ИЗ
	               |					ВТ_СтатьиПланирования КАК ВТ_СтатьиПланирования)) КАК КурсыВалютСрезПоследних
	               |ГДЕ
	               |	&ПорядокРасчетаРублевогоЭквивалента = 1
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ_СтатьиПланирования.Организация КАК Организация,
	               |	ВТ_СтатьиПланирования.ДокументДвижения КАК ДокументДвижения,
	               |	ВТ_СтатьиПланирования.Грузоперевозка КАК Грузоперевозка,
	               |	ВТ_СтатьиПланирования.Заказ КАК Заказ,
	               |	ВТ_СтатьиПланирования.Контрагент КАК Контрагент,
	               |	ВТ_СтатьиПланирования.Номенклатура КАК Номенклатура,
	               |	ВТ_СтатьиПланирования.ПорядокОтражения КАК ПорядокОтражения,
	               |	ВТ_СтатьиПланирования.Валюта КАК Валюта,
	               |	ВТ_СтатьиПланирования.СуммаПланВал КАК СуммаПланВал,
	               |	ВТ_СтатьиПланирования.СуммаСНДСПланВал КАК СуммаСНДСПланВал,
	               |	ВЫБОР
	               |		КОГДА ВТ_КурсыВалют.Валюта ЕСТЬ NULL
	               |			ТОГДА ВТ_СтатьиПланирования.СуммаПлан
	               |		ИНАЧЕ ВТ_СтатьиПланирования.СуммаПланВал * ВТ_КурсыВалют.Курс / ВТ_КурсыВалют.Кратность
	               |	КОНЕЦ КАК СуммаПлан,
	               |	ВЫБОР
	               |		КОГДА ВТ_КурсыВалют.Валюта ЕСТЬ NULL
	               |			ТОГДА ВТ_СтатьиПланирования.СуммаСНДСПлан
	               |		ИНАЧЕ ВТ_СтатьиПланирования.СуммаСНДСПланВал * ВТ_КурсыВалют.Курс / ВТ_КурсыВалют.Кратность
	               |	КОНЕЦ КАК СуммаСНДСПлан
	               |ИЗ
	               |	ВТ_СтатьиПланирования КАК ВТ_СтатьиПланирования
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_КурсыВалют КАК ВТ_КурсыВалют
	               |		ПО ВТ_СтатьиПланирования.Валюта = ВТ_КурсыВалют.Валюта
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	CW_РасходыПоГрузоперевозкамОбороты.ДокументРасходов.Организация КАК Организация,
	               |	CW_РасходыПоГрузоперевозкамОбороты.ДокументРасходов КАК ДокументДвижения,
	               |	CW_РасходыПоГрузоперевозкамОбороты.ДокументРасходов.Дата КАК ДатаРасходов,
	               |	CW_РасходыПоГрузоперевозкамОбороты.Грузоперевозка КАК Грузоперевозка,
	               |	CW_РасходыПоГрузоперевозкамОбороты.Грузоперевозка.Заказ КАК Заказ,
	               |	CW_РасходыПоГрузоперевозкамОбороты.Контрагент КАК Контрагент,
	               |	CW_РасходыПоГрузоперевозкамОбороты.Номенклатура КАК Номенклатура,
	               |	CW_РасходыПоГрузоперевозкамОбороты.ПорядокОтражения КАК ПорядокОтражения,
	               |	CW_РасходыПоГрузоперевозкамОбороты.Валюта КАК Валюта,
	               |	CW_РасходыПоГрузоперевозкамОбороты.СуммаОборот КАК СуммаФакт,
	               |	CW_РасходыПоГрузоперевозкамОбороты.ВсегоОборот КАК СуммаСНДСФакт,
	               |	CW_РасходыПоГрузоперевозкамОбороты.Сумма_ВалютаОборот КАК СуммаФактДокВал,
	               |	CW_РасходыПоГрузоперевозкамОбороты.Всего_ВалютаОборот КАК СуммаСНДСФактДокВал
	               |ИЗ
	               |	РегистрНакопления.CW_РасходыПоГрузоперевозкам.Обороты(
	               |			,
	               |			&НаДату,
	               |			Период,
	               |			Грузоперевозка В (&МассивГрузоперевозок)
	               |				//УсловиеАктыСчет
				   |				) КАК CW_РасходыПоГрузоперевозкамОбороты";
	
	Запрос.УстановитьПараметр("НаДату", ФактическиПолученныеЗатратыНаДату); 
	Запрос.УстановитьПараметр("МассивГрузоперевозок", МассивГрузоперевозок);
	Запрос.УстановитьПараметр("ВерсияБюджета", ВерсияБюджета); 
	Запрос.УстановитьПараметр("ПорядокРасчетаРублевогоЭквивалента",	ПорядокРасчетаРублевогоЭквивалентаПлановыхСтатейЗатрат); 
	
	//Счета(СЧЕТА), Акты(АКТЫ)
	Если ФактическиеДокументы = "СЧЕТА" Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "//УсловиеАктыСчета", "И ДокументРасходов.ПредъявленСчет = ИСТИНА");
	ИначеЕсли ФактическиеДокументы = "АКТЫ" Тогда  
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "//УсловиеАктыСчета", "И ДокументРасходов.ПредъявленАкт = ИСТИНА");
	ИНАЧЕ
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "//УсловиеАктыСчета", "И ИСТИНА");
	КонецЕсли;
	
	ПакетРезультатовЗапроса = Запрос.ВыполнитьПакет();

	ТаблицаПлан = ПакетРезультатовЗапроса[2].Выгрузить(); 
	
	ТаблицаФакт = ПакетРезультатовЗапроса[3].Выгрузить();
	ТаблицаФакт.Колонки.Добавить("Учтено", Новый ОписаниеТипов("Булево"));
	
	ВалютаРегламентированногоучета = Константы.ВалютаРегламентированногоУчета.Получить();
	кэшКурсовВалют = Новый Соответствие;  
	
	Для Каждого СтрокаПлана из ТаблицаПлан Цикл
		
		НоваяСтрока = ТаблицаОжидаемыхЗатрат.Добавить();  
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаПлана); 
		
		ОтборСтрок = Новый Структура;
		ОтборСтрок.Вставить("Организация", 		СтрокаПлана.Организация);    
		ОтборСтрок.Вставить("Грузоперевозка", 	СтрокаПлана.Грузоперевозка);    
		ОтборСтрок.Вставить("Номенклатура", 	СтрокаПлана.Номенклатура);    
		ОтборСтрок.Вставить("Учтено", 			Ложь);    
		
		Если УчитыватьПорядокОтражения Тогда
			ОтборСтрок.Вставить("ПорядокОтражения", СтрокаПлана.ПорядокОтражения);    
		КонецЕсли; 
		
		Если УчитыватьПоставщика Тогда
			ОтборСтрок.Вставить("Контрагент", 		СтрокаПлана.Контрагент);    
		КонецЕсли; 
		
		НайденныеСтроки = ТаблицаФакт.НайтиСтроки(ОтборСтрок); 
		Для Каждого СтрокаФакт из  НайденныеСтроки Цикл
			НоваяСтрока = ТаблицаОжидаемыхЗатрат.Добавить();  
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаФакт,,"Валюта,Контрагент"); 
			
			НоваяСтрока.Контрагент		 = СтрокаПлана.Контрагент;
			НоваяСтрока.ПорядокОтражения = СтрокаПлана.ПорядокОтражения;
			НоваяСтрока.Валюта 			 = СтрокаПлана.Валюта;

			Если СтрокаФакт.Валюта = СтрокаПлана.Валюта Тогда
				НоваяСтрока.СуммаФактПланВал 		= СтрокаФакт.СуммаФактДокВал;
				НоваяСтрока.СуммаСНДСФактПланВал 	= СтрокаФакт.СуммаСНДСФактДокВал;
			Иначе    
				ДанныеСтроки = ПересчитатьВВалютуПлана(СтрокаФакт, НоваяСтрока.Валюта, ВалютаРегламентированногоучета, кэшКурсовВалют);
				НоваяСтрока.СуммаФактПланВал 		= ДанныеСтроки.СуммаФактПланВал;
				НоваяСтрока.СуммаСНДСФактПланВал 	= ДанныеСтроки.СуммаСНДСФактПланВал;
			КонецЕсли; 
			
			СтрокаФакт.Учтено = Истина;

		КонецЦикла;
		
	КонецЦикла;  
	
	ОтборНеучтено = Новый Структура;
	ОтборНеучтено.Вставить("Учтено", Ложь);
	
	НеучтенныеСтроки = ТаблицаФакт.НайтиСтроки(ОтборНеучтено);
	Для Каждого СтрокаФакт из  НеучтенныеСтроки Цикл
		НоваяСтрока = ТаблицаОжидаемыхЗатрат.Добавить();  
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаФакт); 
		
		НоваяСтрока.СуммаФактПланВал 		= СтрокаФакт.СуммаФактДокВал;
		НоваяСтрока.СуммаСНДСФактПланВал 	= СтрокаФакт.СуммаСНДСФактДокВал;

		СтрокаФакт.Учтено = Истина;
	КонецЦикла;
	
	Возврат ТаблицаОжидаемыхЗатрат;   
	
КонецФункции

Функция ПересчитатьВВалютуПлана(Знач СтрокаФакт, Знач Валюта, Знач ВалютаРегламентированногоучета, Знач кэшКурсовВалют)
	
	ДанныеКурса = Неопределено;
	КурсыВалюты = кэшКурсовВалют.Получить(Валюта); 
	Если КурсыВалюты <> Неопределено Тогда
		ДанныеКурса = КурсыВалюты.Получить(НачалоДня(СтрокаФакт.ДатаРасходов));
	КонецЕсли;
	Если ДанныеКурса = Неопределено Тогда
		ДанныеКурса	= CW_Финансы.ПолучитьКурсВалюты(Валюта, СтрокаФакт.ДатаРасходов);
		
		//кэшируем         
		КурсНаДату = Новый Соответствие;
		КурсНаДату.Вставить(НачалоДня(СтрокаФакт.ДатаРасходов), ДанныеКурса);
		кэшКурсовВалют.Вставить(Валюта, КурсНаДату);
	КонецЕсли;
	
	СуммаФактПланВал = CW_Финансы.ПересчитатьИзВалютыВВалюту(СтрокаФакт.СуммаФакт, 
		ВалютаРегламентированногоучета,
		Валюта,
		1,
		ДанныеКурса.Курс,
		1,
		ДанныеКурса.Кратность);
	
	СуммаСНДСФактПланВал = CW_Финансы.ПересчитатьИзВалютыВВалюту(СтрокаФакт.СуммаСНДСФакт, 
		ВалютаРегламентированногоучета,
		Валюта,
		1,
		ДанныеКурса.Курс,
		1,
		ДанныеКурса.Кратность); 
		
	Структура = Новый Структура;
	Структура.Вставить("СуммаФактПланВал", 		СуммаФактПланВал);
 	Структура.Вставить("СуммаСНДСФактПланВал", 	СуммаСНДСФактПланВал); 
	
	Возврат Структура;

КонецФункции   

Функция ПолучитьМассивГрузоперевозок(ОтборКомпановкиДанных)  
	
	СКД = ПолучитьМакет("МакетОтбораГрузоперевозок");
	
	КомпоновщикМакетаОтбора = Новый КомпоновщикМакетаКомпоновкиДанных;
	КомпоновщикНастроекОтбора = Новый КомпоновщикНастроекКомпоновкиДанных;
	КомпоновщикНастроекОтбора.ЗагрузитьНастройки(СКД.НастройкиПоУмолчанию); 
	
	Для Каждого ЭлементОтбораКомпановкиДанных Из ОтборКомпановкиДанных.Элементы Цикл  
		
		Если ТипЗнч(ЭлементОтбораКомпановкиДанных) <> Тип("ЭлементОтбораКомпоновкиДанных") Тогда
			Продолжить;
		КонецЕсли;
		
		Если (ЭлементОтбораКомпановкиДанных.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Грузоперевозка")
			или ЭлементОтбораКомпановкиДанных.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Заказ")
			ИЛИ СтрНачинаетсяС(ЭлементОтбораКомпановкиДанных.ЛевоеЗначение, "Грузоперевозка")  //Параметры и реквизиты грузоперевозки 
			ИЛИ СтрНачинаетсяС(ЭлементОтбораКомпановкиДанных.ЛевоеЗначение, "Заказ"))          //Параметры и реквизиты заказ
			И ЭлементОтбораКомпановкиДанных.Использование = Истина Тогда
			
			ЭлементОтбора = КомпоновщикНастроекОтбора.Настройки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
			ЗаполнитьЗначенияСвойств(ЭлементОтбора, ЭлементОтбораКомпановкиДанных); 
			
		КонецЕсли;  
		
	КонецЦикла;
	
	МакетКомпоновкиОтбра = КомпоновщикМакетаОтбора.Выполнить(СКД, КомпоновщикНастроекОтбора.Настройки, , , Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	ПроцессорКомпоновкиДанных = Новый ПроцессорКомпоновкиДанных;    
	ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновкиОтбра);
	
	ТаблицаЗначений = Новый ТаблицаЗначений;    
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;    
	ПроцессорВывода.УстановитьОбъект(ТаблицаЗначений);    
	
	ТаблицаГрузоперевозок = ПроцессорВывода.Вывести(ПроцессорКомпоновкиДанных);
	
	Возврат ТаблицаГрузоперевозок.ВыгрузитьКолонку("Грузоперевозка");
	
КонецФункции

