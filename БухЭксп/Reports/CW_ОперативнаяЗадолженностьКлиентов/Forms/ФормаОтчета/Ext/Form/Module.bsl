	Пар.Имя = "ОтборГрузоперевозок";
	Пар.Заголовок = "Отбор грузоперевозок";
	Пар.ТипЗначения = Новый ОписаниеТипов("Строка");
	Пар.ВключатьВДоступныеПоля = Ложь;
	
	Отчет.АдресСхемы = ПоместитьВоВременноеХранилище(СКД, ЭтаФорма.УникальныйИдентификатор);	
	
	Компоновщик.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(Отчет.АдресСхемы));	
		
КонецПроцедуры	

&НаСервере
Функция УстановитьНастройкиСКД()
	
	СКД = ПолучитьИзВременногоХранилища(Отчет.АдресСхемы);
	Компоновщик.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(СКД));
	НастройкиСКД = Компоновщик.Настройки;
	Настройки = ПолучитьНастройки();
	
//-----------------------------------------------------------------------------------------------------------//

	НастройкиСКД.Порядок.Элементы.Очистить();
	 	
	// формируем структуру отчета по группировкам
	НастройкиСКД.Структура.Очистить();
	ТекущийРодитель = НастройкиСКД.Структура;
	
	Если ОбъединитьГруппировки Тогда   
		//Добавляем пустую группировку
		НоваяГруппировка = ТекущийРодитель.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
		
		Если (ДополнительнаяСортировка <> 0) Тогда
			
			ТипУпорядочивания=НаправлениеСортировкиКомпоновкиДанных.Убыв;
			Если ПорядокСортировки = 1 тогда
				ТипУпорядочивания=НаправлениеСортировкиКомпоновкиДанных.Возр;
			КонецЕсли;
	
			ВП = НоваяГруппировка.Порядок.Элементы.Добавить(Тип("ЭлементПорядкаКомпоновкиДанных"));
			ВП.Использование 	 = Истина;
			ВП.ТипУпорядочивания = ТипУпорядочивания;

			Если (ДополнительнаяСортировка = 1) Тогда
				ВП.Поле = Новый ПолеКомпоновкиДанных("РубОстаток");
			ИначеЕсли (ДополнительнаяСортировка = 2) Тогда
				ВП.Поле = Новый ПолеКомпоновкиДанных("ПериодЗадолженности");
			Иначе
				ВП.Поле = Новый ПолеКомпоновкиДанных("СрокОплаты");
			КонецЕсли; 
			
		КонецЕсли;

		
	КонецЕсли;

	
	Для Каждого Групп Из Настройки.Группировки Цикл
		Если Не ОбъединитьГруппировки Тогда
			НоваяГруппировка = ТекущийРодитель.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
			ПолеГруппировки = НоваяГруппировка.ПоляГруппировки.Элементы.Добавить(Тип("ПолеГруппировкиКомпоновкиДанных"));
			ПолеГруппировки.Поле = Новый ПолеКомпоновкиДанных(Групп.ИмяПоля);
			ПолеГруппировки.Использование = Истина;
			// --- 
			НовоеАвтоПолеВыбора = НоваяГруппировка.Выбор.Элементы.Добавить(Тип("АвтоВыбранноеПолеКомпоновкиДанных"));
			НовоеАвтоПолеВыбора.Использование = Истина;
			// --- 
			Если (ДополнительнаяСортировка <> 0) Тогда
				
				ТипУпорядочивания=НаправлениеСортировкиКомпоновкиДанных.Убыв;
				Если ПорядокСортировки = 1 тогда
					ТипУпорядочивания=НаправлениеСортировкиКомпоновкиДанных.Возр;
				КонецЕсли;
				
				ВП = НоваяГруппировка.Порядок.Элементы.Добавить(Тип("ЭлементПорядкаКомпоновкиДанных"));
				ВП.Использование 	 = Истина;
				ВП.ТипУпорядочивания = ТипУпорядочивания;
				
				Если (ДополнительнаяСортировка = 1) Тогда
					ВП.Поле = Новый ПолеКомпоновкиДанных("РубОстаток");
				ИначеЕсли (ДополнительнаяСортировка = 2) Тогда
					ВП.Поле = Новый ПолеКомпоновкиДанных("ПериодЗадолженности");
				Иначе
					ВП.Поле = Новый ПолеКомпоновкиДанных("СрокОплаты");
				КонецЕсли; 
				
			КонецЕсли;
			// --- 
			ЭлементПорядка = НоваяГруппировка.Порядок.Элементы.Добавить(Тип("ЭлементПорядкаКомпоновкиДанных"));
			ЭлементПорядка.Поле = Новый ПолеКомпоновкиДанных(Групп.ИмяПоля);
			НС = ?(Групп.Сортировка = Перечисления.CW_НаправлениеСортировки.ПоВозрастанию,НаправлениеСортировкиКомпоновкиДанных.Возр,НаправлениеСортировкиКомпоновкиДанных.Убыв);
			ЭлементПорядка.ТипУпорядочивания = НС;
			ЭлементПорядка.Использование = Истина;
			// --- 
			НоваяГруппировка.Имя = Групп.Представление;
			НоваяГруппировка.Использование = Истина;
			// --- 
			ТекущийРодитель = НоваяГруппировка.Структура;
		Иначе
			
			//Заполняем группировку полями группирвоки
			ПолеГруппировки 				= НоваяГруппировка.ПоляГруппировки.Элементы.Добавить(Тип("ПолеГруппировкиКомпоновкиДанных"));
			ПолеГруппировки.Поле 			= Новый ПолеКомпоновкиДанных(Групп.ИмяПоля);
			ПолеГруппировки.Использование 	= Истина;
			
			НовоеАвтоПолеВыбора = НоваяГруппировка.Выбор.Элементы.Добавить(Тип("АвтоВыбранноеПолеКомпоновкиДанных"));
			НовоеАвтоПолеВыбора.Использование	= Истина;
			
			ЭлементПорядка = НоваяГруппировка.Порядок.Элементы.Добавить(Тип("ЭлементПорядкаКомпоновкиДанных"));
			ЭлементПорядка.Поле = Новый ПолеКомпоновкиДанных(Групп.ИмяПоля);
			
			НС = ?(Групп.Сортировка = Перечисления.CW_НаправлениеСортировки.ПоВозрастанию, НаправлениеСортировкиКомпоновкиДанных.Возр, НаправлениеСортировкиКомпоновкиДанных.Убыв);
			
			ЭлементПорядка.ТипУпорядочивания = НС;
			ЭлементПорядка.Использование = Истина;
			
		КонецЕсли;
		
	КонецЦикла; 
	
	// Предопределенная группировка "ДокументВзаиморасчетов"
	Если Не ОбъединитьГруппировки Тогда
		НоваяГруппировка = ТекущийРодитель.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
		НоваяГруппировка.Использование = Истина;
		
		ПолеГруппировки = НоваяГруппировка.ПоляГруппировки.Элементы.Добавить(Тип("ПолеГруппировкиКомпоновкиДанных"));
		ПолеГруппировки.Использование 		= Истина;
		ПолеГруппировки.Поле 				= Новый ПолеКомпоновкиДанных("ДокументВзаиморасчетов");
		
		НовоеАвтоПолеВыбора 				= НоваяГруппировка.Выбор.Элементы.Добавить(Тип("АвтоВыбранноеПолеКомпоновкиДанных"));
		НовоеАвтоПолеВыбора.Использование 	= Истина;
		
		//Подсистема.СтатусыДокументов
		Если ВыводитьСтатусДокумента Тогда
			ПолеГруппировки = НоваяГруппировка.ПоляГруппировки.Элементы.Добавить(Тип("ПолеГруппировкиКомпоновкиДанных"));
			ПолеГруппировки.Использование = Истина;
			ПолеГруппировки.Поле = Новый ПолеКомпоновкиДанных("СтатусДокумента");
			
			НовоеАвтоПолеВыбора = НоваяГруппировка.Выбор.Элементы.Добавить(Тип("АвтоВыбранноеПолеКомпоновкиДанных"));
			НовоеАвтоПолеВыбора.Использование = Истина;
		КонецЕсли;
		//Подсистема.СтатусыДокументов
		// --- 
		Если (ДополнительнаяСортировка <> 0) Тогда
			
			ТипУпорядочивания=НаправлениеСортировкиКомпоновкиДанных.Убыв;
			Если ПорядокСортировки = 1 тогда
				ТипУпорядочивания=НаправлениеСортировкиКомпоновкиДанных.Возр;
			КонецЕсли;
			
			ВП = НоваяГруппировка.Порядок.Элементы.Добавить(Тип("ЭлементПорядкаКомпоновкиДанных"));
			ВП.Использование 		= Истина;
			ВП.ТипУпорядочивания	= ТипУпорядочивания;
			Если (ДополнительнаяСортировка = 1) Тогда
				ВП.Поле = Новый ПолеКомпоновкиДанных("РубОстаток");
			ИначеЕсли (ДополнительнаяСортировка = 2) Тогда
				ВП.Поле = Новый ПолеКомпоновкиДанных("ПериодЗадолженности");
			Иначе
				ВП.Поле = Новый ПолеКомпоновкиДанных("СрокОплаты");
			КонецЕсли; 
			
		КонецЕсли;
		// --- 
		ЭлементПорядка = НоваяГруппировка.Порядок.Элементы.Добавить(Тип("ЭлементПорядкаКомпоновкиДанных"));
		ЭлементПорядка.Поле = Новый ПолеКомпоновкиДанных("ДокументВзаиморасчетов");
		ЭлементПорядка.ТипУпорядочивания = НаправлениеСортировкиКомпоновкиДанных.Возр;
		ЭлементПорядка.Использование = Истина;
		НоваяГруппировка.Имя = "Документ взаиморасчетов";
		НоваяГруппировка.Использование = Истина;
		
	Иначе
		//Заполняем группировку полями группирвоки
		ПолеГруппировки 				= НоваяГруппировка.ПоляГруппировки.Элементы.Добавить(Тип("ПолеГруппировкиКомпоновкиДанных"));
		ПолеГруппировки.Поле 			= Новый ПолеКомпоновкиДанных("ДокументВзаиморасчетов");
		ПолеГруппировки.Использование 	= Истина;
		
		НовоеАвтоПолеВыбора = НоваяГруппировка.Выбор.Элементы.Добавить(Тип("АвтоВыбранноеПолеКомпоновкиДанных"));
		НовоеАвтоПолеВыбора.Использование	= Истина;
		
		//Подсистема.СтатусыДокументов
		Если ВыводитьСтатусДокумента Тогда
			ПолеГруппировки = НоваяГруппировка.ПоляГруппировки.Элементы.Добавить(Тип("ПолеГруппировкиКомпоновкиДанных"));
			ПолеГруппировки.Использование = Истина;
			ПолеГруппировки.Поле = Новый ПолеКомпоновкиДанных("СтатусДокумента");
			
			НовоеАвтоПолеВыбора = НоваяГруппировка.Выбор.Элементы.Добавить(Тип("АвтоВыбранноеПолеКомпоновкиДанных"));
			НовоеАвтоПолеВыбора.Использование = Истина;
		КонецЕсли;
		//Подсистема.СтатусыДокументов

		ЭлементПорядка = НоваяГруппировка.Порядок.Элементы.Добавить(Тип("ЭлементПорядкаКомпоновкиДанных"));
		ЭлементПорядка.Поле = Новый ПолеКомпоновкиДанных("ДокументВзаиморасчетов");
		
	КонецЕсли;

		
//-----------------------------------------------------------------------------------------------------------//

	НастройкиСКД.Выбор.Элементы.Очистить();
	
	ГруппаВП = НастройкиСКД.Выбор.Элементы.Добавить(Тип("ГруппаВыбранныхПолейКомпоновкиДанных"));
	ГруппаВП.Использование = Истина;
	ГруппаВП.Заголовок = "Задолженность";	
	ВП = ГруппаВП.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
	ВП.Использование = Валюта;
	ВП.Заголовок = "ВалОстаток";
	ВП.Поле = Новый ПолеКомпоновкиДанных("ВалОстаток");
	ВП = ГруппаВП.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
	ВП.Использование = Рубли;
	ВП.Заголовок = "РубОстаток";
	ВП.Поле = Новый ПолеКомпоновкиДанных("РубОстаток");

	ВП = НастройкиСКД.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
	ВП.Использование = Истина;
	ВП.Заголовок = "Срок оплаты";
	ВП.Поле = Новый ПолеКомпоновкиДанных("СрокОплаты");
	
	ВП = НастройкиСКД.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
	ВП.Использование = Истина;
	ВП.Заголовок = "Период задолженности";
	ВП.Поле = Новый ПолеКомпоновкиДанных("ПериодЗадолженности");
	
	//ВП = НастройкиСКД.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
	//ВП.Использование = Истина;
	//ВП.Заголовок = "Счет учёта";
	//ВП.Поле = Новый ПолеКомпоновкиДанных("СчетУчета");
	
	Если ПоПериодам И Периоды.Количество() > 0 Тогда
		ГруппаВП0 = НастройкиСКД.Выбор.Элементы.Добавить(Тип("ГруппаВыбранныхПолейКомпоновкиДанных"));
		ГруппаВП0.Использование = Истина;
		ГруппаВП0.Заголовок = "Просроченная задолженность";
		
		ГруппаВсего = ГруппаВП0.Элементы.Добавить(Тип("ГруппаВыбранныхПолейКомпоновкиДанных"));
		ГруппаВсего.Использование = Истина;
		ГруппаВсего.Заголовок = "Всего";
		
		ВП = ГруппаВсего.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
		ВП.Использование = Валюта;
		ВП.Заголовок = "ВалПериод0";
		ВП.Поле = Новый ПолеКомпоновкиДанных("ВалПериод0");
		
		ВП = ГруппаВсего.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
		ВП.Использование = Рубли;
		ВП.Заголовок = "РубПериод0";
		ВП.Поле = Новый ПолеКомпоновкиДанных("РубПериод0");
		
		Ном = 1;
		Для Каждого Интервал из Периоды Цикл
			ГруппаПериода = ГруппаВП0.Элементы.Добавить(Тип("ГруппаВыбранныхПолейКомпоновкиДанных"));
			ГруппаПериода.Использование = Истина;
			ГруппаПериода.Заголовок = Интервал.Представление;
			
			ВП = ГруппаПериода.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
			ВП.Использование = Валюта;
			ВП.Заголовок = "ВалПериод" + Ном;
			ВП.Поле = Новый ПолеКомпоновкиДанных("ВалПериод" + Ном);
			
			ВП = ГруппаПериода.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
			ВП.Использование = Рубли;
			ВП.Заголовок = "РубПериод" + Ном;
			ВП.Поле = Новый ПолеКомпоновкиДанных("РубПериод" + Ном);
			
			Ном = Ном + 1;	
		КонецЦикла;	
		ГруппаПериода = ГруппаВП0.Элементы.Добавить(Тип("ГруппаВыбранныхПолейКомпоновкиДанных"));
		ГруппаПериода.Использование = Истина;
		ГруппаПериода.Заголовок = "Свыше " + Интервал.КонДень + " дней";
		
		ВП = ГруппаПериода.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
		ВП.Использование = Валюта;
		ВП.Заголовок = "ВалПериод" + Ном;
		ВП.Поле = Новый ПолеКомпоновкиДанных("ВалПериод" + Ном);
		
		ВП = ГруппаПериода.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
		ВП.Использование = Рубли;
		ВП.Заголовок = "РубПериод" + Ном;
		ВП.Поле = Новый ПолеКомпоновкиДанных("РубПериод" + Ном);
	КонецЕсли;
	
	ВП = НастройкиСКД.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
	ВП.Использование 	= ПланОплаты;
	ВП.Заголовок 		= "Плановая дата оплаты";
	ВП.Поле 			= Новый ПолеКомпоновкиДанных("ПлановаяДатаОплаты");
	
	ВП = НастройкиСКД.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
	ВП.Использование 	= ДатаВозвратаДокументов;
	ВП.Заголовок 		= "Дата передачи документов";
	ВП.Поле 			= Новый ПолеКомпоновкиДанных("ДатаВозвратаДокументов");  
	//-----------------------------------------------------------------------------------------------------------//
	
	НастройкиСКД.ПараметрыДанных.УстановитьЗначениеПараметра("Период", КонецДня(Настройки.НаДату));
	НастройкиСКД.ПараметрыДанных.УстановитьЗначениеПараметра("ВыводитьГрузоперевозки", Настройки.ВыводитьГрузоперевозки);
	НастройкиСКД.ПараметрыДанных.УстановитьЗначениеПараметра("ВыводитьЗаказы", Настройки.ВыводитьЗаказы);	
	Если (ОтборПоГрузоперевозкам) Тогда
		ОтборПоГрузоперевозкамПредставление = Строка(ОтборГП_КомпоновщикНастроек.Настройки.Отбор);
	Иначе
		ОтборПоГрузоперевозкамПредставление = "<не установлен>";
	КонецЕсли; 
	НастройкиСКД.ПараметрыДанных.УстановитьЗначениеПараметра("ОтборГрузоперевозок", ОтборПоГрузоперевозкамПредставление);	
	
//-----------------------------------------------------------------------------------------------------------//

	НастройкиСКД.УсловноеОформление.Элементы.Очистить();
	// --- 
	ЭлУО = НастройкиСКД.УсловноеОформление.Элементы.Добавить();
	ЭлУО.Использование = Истина;
	ЭлПоле = ЭлУО.Поля.Элементы.Добавить();
	ЭлПоле.Использование = Истина;
