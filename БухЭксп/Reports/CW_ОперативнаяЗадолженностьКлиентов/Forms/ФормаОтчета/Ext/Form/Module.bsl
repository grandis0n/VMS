	Если Элемент.ТекущиеДанные.ИмяПоля = "Валюта" Тогда
		Валюта = Ложь;
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьЗапрещенныеПоля(Режим = "") Экспорт
	
	СписокПолей = Новый Массив;
	
	СписокПолей.Добавить("Статус");
	СписокПолей.Добавить("UserFields");
	СписокПолей.Добавить("DataParameters");
	СписокПолей.Добавить("SystemFields");
	СписокПолей.Добавить("Показатели");
	СписокПолей.Добавить("Период");
	СписокПолей.Добавить("ДокументВзаиморасчетов");
	
	//Подсистема.СтатусыДокументов
	СписокПолей.Добавить("СтатусДокумента");
	//Подсистема.СтатусыДокументов

	Если Режим = "Группировка" Тогда
		//СписокПолей.Добавить("ДокументВзаиморасчетов");
		
		Для Каждого Стр Из Отчет.КомпоновщикНастроек.Настройки.ДоступныеПоляВыбора.Элементы Цикл
			Если Стр.Папка ИЛИ Стр.Таблица ИЛИ (Найти(Стр.Поле, "удалить") <> 0) Тогда
				СписокПолей.Добавить(Строка(Стр.Поле));
			КонецЕсли; 
		КонецЦикла;
	КонецЕсли;
	
	Возврат Новый ФиксированныйМассив(СписокПолей);
	
КонецФункции

// ---------------------------------------------------------------------------- 

&НаКлиенте
Процедура Сформировать(Команда)
	
	Если НЕ ЗначениеЗаполнено(НаДату) Тогда
		_УФК.ВывестиПредупреждение("Не заполнена дата отчета!");
		Возврат;		
	КонецЕсли;		
	
	Если ПоПериодам И Периоды.Количество() = 0 Тогда
		_УФК.ВывестиПредупреждение("Не настроены периоды!");
		Возврат;		
	КонецЕсли;						
	
	Если НЕ Рубли И НЕ Валюта Тогда
		_УФК.ВывестиПредупреждение("Не отмечено ни одного показателя!");
		Возврат;		
	КонецЕсли;
	
	Если Группировки.Количество() = 0 Тогда
		_УФК.ВывестиПредупреждение("Не выбрано ни одной группировки!");
		Возврат;				
	КонецЕсли;	
	
	_Настройка(Истина);
	СформироватьОтчет();
	ОбработатьОтчет();
	#Если ТолстыйКлиент Тогда
		Результат.ПоказатьУровеньГруппировокСтрок(2);
	#КонецЕсли
	
КонецПроцедуры

&НаСервере
Функция СформироватьОтчет() Экспорт
	
	Результат.Очистить();
	
	Настройки = ПолучитьНастройки();
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Период", КонецДня(Настройки.НаДату)+1);
	Запрос.Текст = СформироватьЗапрос();
	
	Рез = Запрос.Выполнить().Выгрузить();
	
	Если (ОтборПоГрузоперевозкам) Тогда
		
		// анализируем документы результата
		// выбираем только доходы по г/п
		// и для каждого документа создаем соответствие с грузоперевозками
		
		СоответствиеГП = Новый Соответствие;
		// --- 
		тГП = _сф.т_Создать("ГП");
		МассивУдаляемых = Новый Массив;
		ТипДоходов = Тип("ДокументСсылка.CW_ДоходыПоГрузоперевозке");
		Для каждого Стр Из Рез Цикл
			
			Если (ТипЗнч(Стр.ДокументВзаиморасчетов) <> ТипДоходов) Тогда
				
				МассивУдаляемых.Добавить(Стр);
				
			Иначе
				
				мГП=CW_Финансы.ГрузоперевозкиДокумента(Стр.ДокументВзаиморасчетов);
				_сф.м_УдалитьПустые(мГП);
				СоответствиеГП.Вставить(Стр.ДокументВзаиморасчетов,Новый Структура("мГП,Видимость",мГП,Ложь));
				// --- 
				Для каждого ГП Из мГП Цикл
					
					Нстр = тГП.Добавить();
					Нстр.ГП = ГП;
					
				КонецЦикла; 
				
			КонецЕсли; 
			
		КонецЦикла; 
		_сф.к_УдалитьЭлементыПоМассиву(Рез, МассивУдаляемых);
		МассивУдаляемых.Очистить();
		
		// формируем набор записей по г/п
		тГП.Свернуть("ГП");
		// --- 
		Метаданное = CW_Обмены_ПИ.МетаданноеКонфигурации("Отчет.CW_ОперативнаяЗадолженностьКлиентов");
		Пользователь = CW_Настройки.Пользователь();
		// --- 
		НаборЗаписей = РегистрыСведений.CW_ВыборкиГрузоперевозок.СоздатьНаборЗаписей();
		_сф.УстановитьОтбор(НаборЗаписей.Отбор,"Пользователь",Пользователь);
		_сф.УстановитьОтбор(НаборЗаписей.Отбор,"Метаданное", Метаданное);
		Для каждого СтрГП Из тГП Цикл
			
			Запись = НаборЗаписей.Добавить();
			Запись.Пользователь = Пользователь;
			Запись.Метаданное = Метаданное;
			Запись.Грузоперевозка = СтрГП.ГП;
			
		КонецЦикла; 
		НаборЗаписей.Записать(Истина);
		
		// ---------------------------------------------------------------------------- 
		
		// выполняем запрос по записанным данным
		ОтборГП_ТаблицаРезультата = Новый ТаблицаЗначений;
		// --- 
		ОтборГП_КомпоновщикНастроек.Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("Пользователь",Пользователь);
		ОтборГП_КомпоновщикНастроек.Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("Метаданное",Метаданное);
		ОтборГП_НовыеНастройки = ОтборГП_КомпоновщикНастроек.Настройки;
		// --- 
		ОтборГП_КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
		ОтборГП_ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
		ОтборГП_ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
		// --- 
		ОтборГП_ПроцессорВывода.УстановитьОбъект(ОтборГП_ТаблицаРезультата);
		// --- 
		Попытка
			ОтборГП_СхемаКомпоновки = ПолучитьИзВременногоХранилища(ОтборГП_АдресСхемыКомпоновки);
			ОтборГП_МакетКомпоновкиДанных = ОтборГП_КомпоновщикМакета.Выполнить(ОтборГП_СхемаКомпоновки, ОтборГП_НовыеНастройки,,,Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
			ОтборГП_ПроцессорКомпоновки.Инициализировать(ОтборГП_МакетКомпоновкиДанных);
			ОтборГП_ПроцессорВывода.Вывести(ОтборГП_ПроцессорКомпоновки);
		Исключение
			Сообщить(ОписаниеОшибки());
			Возврат(Неопределено);
		КонецПопытки;
		
		СоответствиеНайденныхГП = Новый Соответствие;
		Для каждого Стр Из ОтборГП_ТаблицаРезультата Цикл
			
			СоответствиеНайденныхГП.Вставить(Стр.Ссылка,Истина);
			
		КонецЦикла; 
		// --- 
		Для каждого Стр Из Рез Цикл
			
			СДД = СоответствиеГП.Получить(Стр.ДокументВзаиморасчетов);
			ДокументСоответствует = Ложь;
			Для каждого ГП Из СДД.мГП Цикл
				
				СтрокаНайденного = СоответствиеНайденныхГП.Получить(ГП);
				Если (СтрокаНайденного <> Неопределено) Тогда
					ДокументСоответствует=Истина;
					СДД.Видимость = Истина;
					Прервать;
				КонецЕсли; 
				
			КонецЦикла;
			Если (НЕ ДокументСоответствует) Тогда
				
				МассивУдаляемых.Добавить(Стр);
				
			КонецЕсли; 
			
		КонецЦикла; 
		_сф.к_УдалитьЭлементыПоМассиву(Рез, МассивУдаляемых);
		МассивУдаляемых.Очистить();
		
		// --- 
		
		НаборЗаписей.Очистить();
		НаборЗаписей.Записать(Истина);
		
		// ---------------------------------------------------------------------------- 
		
	КонецЕсли; 
	
	ВНД = Новый Структура("ВНД", Рез);
	
	УстановитьСхему();
	СКД = ПолучитьИзВременногоХранилища(Отчет.АдресСхемы);
	
	НастройкиСКД = УстановитьНастройкиСКД();
	
    КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	ДР = Новый ДанныеРасшифровкиКомпоновкиДанных;
    МакетКомпоновки = КомпоновщикМакета.Выполнить(СКД, НастройкиСКД, ДР);
    
    ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
    ПроцессорКомпоновки.Инициализировать(МакетКомпоновки, ВНД, ДР, Истина);
		
	Результат = Новый ТабличныйДокумент;
    ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
    ПроцессорВывода.УстановитьДокумент(Результат);
    ПроцессорВывода.Вывести(ПроцессорКомпоновки);
	
	Отчет.АдресРасшифровки = ПоместитьВоВременноеХранилище(ДР, ЭтаФорма.УникальныйИдентификатор);	
	
	// --- 
	_СохранитьСеансовуюНастройку();
		
КонецФункции

&НаСервере
Процедура ОбработатьОтчет() Экспорт
	
	CW_Отчеты.ЗаменитьТекстВТаблицеРезультата(Результат, "0:00:00", "");
	CW_Отчеты.ЗаменитьТекстВТаблицеРезультата(Результат, "23:59:59", "");
	CW_Отчеты.ЗаменитьТекстВТаблицеРезультата(Результат, "Задолженность", "Задолженность", ГоризонтальноеПоложение.Центр);
	CW_Отчеты.ЗаменитьТекстВТаблицеРезультата(Результат, "ВалОстаток", "Вал.", ГоризонтальноеПоложение.Центр);
	CW_Отчеты.ЗаменитьТекстВТаблицеРезультата(Результат, "РубОстаток", Строка(ВРУ), ГоризонтальноеПоложение.Центр);
	CW_Отчеты.ЗаменитьТекстВТаблицеРезультата(Результат, "ВРУ", Строка(ВРУ));
	КорректироватьТаблицуРезультата(Результат, "Срок оплаты", ГоризонтальноеПоложение.Центр);
	КорректироватьТаблицуРезультата(Результат, "Дата передачи документов", ГоризонтальноеПоложение.Центр);
	КорректироватьТаблицуРезультата(Результат, "Период задолженности", ГоризонтальноеПоложение.Центр);
	КорректироватьТаблицуРезультата(Результат, "Просроченная задолженность", ГоризонтальноеПоложение.Центр);
	КорректироватьТаблицуРезультата(Результат, "Всего", ГоризонтальноеПоложение.Центр);
	КорректироватьТаблицуРезультата(Результат, "дней", ГоризонтальноеПоложение.Центр);
	Для Инд = 0 по Периоды.Количество() + 1 Цикл
		CW_Отчеты.ЗаменитьТекстВТаблицеРезультата(Результат, "ВалПериод" + Инд, "Вал.", ГоризонтальноеПоложение.Центр);
		CW_Отчеты.ЗаменитьТекстВТаблицеРезультата(Результат, "РубПериод" + Инд, Строка(ВРУ), ГоризонтальноеПоложение.Центр);		
	КонецЦикла;	
	КорректироватьТаблицуРезультата(Результат, "Плановая дата оплаты", ГоризонтальноеПоложение.Центр);
	КорректироватьТаблицуРезультата(Результат, " Х ", ГоризонтальноеПоложение.Центр);
	
	//Подсистема.СтатусыДокументов
	КорректироватьТаблицуРезультата(Результат, "Статус", ГоризонтальноеПоложение.Центр);
	//Подсистема.СтатусыДокументов

	CW_Отчеты.ЗаменитьТекстВТаблицеРезультата(Результат, "Итого", "ИТОГО:");
	
	Результат.УдалитьОбласть(Результат.Область("R1"), ТипСмещенияТабличногоДокумента.ПоВертикали); 
	Результат.ФиксацияСверху = Результат.ФиксацияСверху - 1;
	
// ---------------------------------------------------------------------------- 

	Если ПланОплаты Тогда

		Запрос = Новый Запрос;
		Запрос.Текст = СформироватьЗапрос();
		Запрос.УстановитьПараметр("Период", КонецДня(НаДату)+1);
		ТЗ = Запрос.Выполнить().Выгрузить();
		
		Кооф = ?(Рубли И Валюта, 2, 1);
		КолПериод = ?(ПоПериодам И Периоды.Количество() > 0, Периоды.Количество() + 3, 1);
		
		ДР = ПолучитьДР();
		Сч = Результат.ФиксацияСверху + 1; 
		Об = Результат.Область(Сч, 1, Сч, 1); 
		
		ОбластьПлановаяДатаОплаты = Результат.НайтиТекст("Плановая дата оплаты");
		
		Если ОбластьПлановаяДатаОплаты <> Неопределено Тогда
			
			НомКол = ОбластьПлановаяДатаОплаты.Лево;
			Пока Об.Текст <> "ИТОГО:" Цикл
				Поле = ДР.Элементы[Об.Расшифровка].ПолучитьПоля()[0];
				Если Поле.Поле = "ДокументВзаиморасчетов" Тогда
					Н_Стр = ТЗ.Найти(Поле.Значение, "ДокументВзаиморасчетов");
					ОбХ = Результат.Область(Сч, НомКол, Сч, НомКол);
					ОбХ.Примечание.Текст = Н_Стр.ОписаниеОплаты;
				КонецЕсли;	
				Сч = Сч + 1;
				Об = Результат.Область(Сч, 1, Сч, 1);
			КонецЦикла;	
		КонецЕсли;	
		
	КонецЕсли;	
	
	Результат.АвтоМасштаб = Истина;
	
КонецПроцедуры	

&НаСервере
Функция КорректироватьТаблицуРезультата(ТабДок, стрЧтоИщем, НовоеГоризонтальноеПоложение = Неопределено, МаксНомерСтрокиПоиска = Неопределено) 
	
	ПредНайденнаяОбласть = Неопределено;
	
	Если ЗначениеЗаполнено(МаксНомерСтрокиПоиска) Тогда 
		ГдеИскать = ТабДок.Область(1, , МаксНомерСтрокиПоиска,);
	Иначе 
		ГдеИскать = Неопределено;
	КонецЕсли;
	
	Пока Истина Цикл
	
		НайденнаяОбласть = ТабДок.НайтиТекст(стрЧтоИщем, ПредНайденнаяОбласть, ГдеИскать); 
		Если Неопределено = НайденнаяОбласть Тогда 
			Прервать;
		Иначе 
			ПредНайденнаяОбласть = НайденнаяОбласть;
		КонецЕсли;
			
		Если НЕ Неопределено = НовоеГоризонтальноеПоложение Тогда 
			НайденнаяОбласть.ГоризонтальноеПоложение = НовоеГоризонтальноеПоложение;
		КонецЕсли;
		
	КонецЦикла;

КонецФункции

// ---------------------------------------------------------------------------- 

&НаКлиенте
Процедура РезультатПриАктивизацииОбласти(Элемент) 
	
	//БухгалтерскиеОтчетыКлиент
	БухгалтерскиеОтчетыКлиент.НачатьРасчетСуммыВыделенныхЯчеек(
		Элементы.Результат,
		ЭтотОбъект,
		"Подключаемый_РезультатПриАктивизацииПодключаемый");
	//---БухгалтерскиеОтчетыКлиент
	
	Выд = Новый СписокЗначений;
    Для Каждого Область Из Результат.ВыделенныеОбласти Цикл
        Если ТипЗнч(Область) = Тип("ОбластьЯчеекТабличногоДокумента") Тогда
            Для ИндексСтрока = Область.Верх По Область.Низ Цикл
                Для ИндексКолонка = Область.Лево По Область.Право Цикл
					Попытка
						Выд.Добавить(Результат.Область("R" + Формат(ИндексСтрока, "ЧГ=0") + "C" + Формат(ИндексКолонка, "ЧГ=0")).Расшифровка);
                    Исключение
                    КонецПопытки;
                КонецЦикла;
            КонецЦикла;
        КонецЕсли;
	КонецЦикла;
	
	Выделенные = ПроверитьВыделенные(Выд);
	
КонецПроцедуры 

&НаКлиенте
Функция ПроверитьВыделенные(Выд)
	
	Рез = Новый СписокЗначений;
	
	Если ЗначениеЗаполнено(Отчет.АдресРасшифровки) Тогда
		
		Рез = _ПроверитьВыделенные(Выд);
		
	КонецЕсли;	
	
	Возврат Рез;
	
КонецФункции	

&НаСервере
Функция _ПроверитьВыделенные(Выд)
	
	Рез = Новый СписокЗначений;
	РежимРасшифровки = "";
	
	Если ЗначениеЗаполнено(Отчет.АдресРасшифровки) Тогда
		ДР = ПолучитьДР();
		Для Каждого Стр из Выд Цикл
			Если Стр.Значение <> Неопределено Тогда
				Если ДР.Элементы[Стр.Значение].ПолучитьПоля()[0].Поле = "ПлановаяДатаОплаты" Тогда
					
					Попытка
						Род = ДР.Элементы[ДР.Элементы[Стр.Значение].ПолучитьРодителей()[0].Идентификатор].ПолучитьПоля()[0].Значение;                 
					Исключение
					КонецПопытки;	
					Если ТипЗнч(Род) = Тип("ДокументСсылка.CW_ДоходыПоГрузоперевозке") Тогда
						Рез.Добавить(Стр.Значение);	
					КонецЕсли;
					
				ИначеЕсли ДР.Элементы[Стр.Значение].ПолучитьПоля()[0].Поле = "СрокОплаты" Тогда
					
					Попытка
						Род = ДР.Элементы[ДР.Элементы[Стр.Значение].ПолучитьРодителей()[0].Идентификатор].ПолучитьПоля()[0].Значение;                 
					Исключение
					КонецПопытки;	
					Если ТипЗнч(Род) = Тип("ДокументСсылка.CW_ДоходыПоГрузоперевозке") Тогда
						Рез.Добавить(Стр.Значение);	
					КонецЕсли; 	
					
				КонецЕсли;
				
				РежимРасшифровки = ДР.Элементы[Стр.Значение].ПолучитьПоля()[0].Поле;
			КонецЕсли;	
		КонецЦикла;	
	КонецЕсли;	
	
	Возврат Рез;
	
КонецФункции	

&НаСервере
Процедура _СформироватьДоступныеДействияОбработкиРасшифровки(ДоступныеДействия,ДопДействия)
	// --- 
	
	ДР = ПолучитьДР();
	// --- 
	
	ДоступныеДействия.Добавить(ДействиеОбработкиРасшифровкиКомпоновкиДанных.ОткрытьЗначение);
	//ДоступныеДействия.Добавить(ДействиеОбработкиРасшифровкиКомпоновкиДанных.Отфильтровать);
	
	Если Выделенные.Количество() > 0 Тогда
		Для Каждого Стр из Выделенные Цикл
			Попытка
				Стр.Значение = ДР.Элементы[ДР.Элементы[Стр.Значение].ПолучитьРодителей()[0].Идентификатор].ПолучитьПоля()[0].Значение;                 
			Исключение
				Возврат;
			КонецПопытки;	
		КонецЦикла;
		
		Если РежимРасшифровки = "ПлановаяДатаОплаты" Тогда
		
			ДопДействия.Добавить("ПлановаяДатаОплаты", "План оплаты");
		
		КонецЕсли; 
		
		Если РежимРасшифровки = "СрокОплаты" И СрокОплатыДоступен Тогда
		
			ДопДействия.Добавить("СрокОплаты" , "Срок оплаты");
			
		КонецЕсли;	
		
	КонецЕсли;	
	
	// --- 
КонецПроцедуры

&НаКлиенте
Процедура РезультатОбработкаРасшифровки(Элемент, Расшифровка, СтандартнаяОбработка)
	
	Перем ВыполненноеДействие;
	
	СтандартнаяОбработка = Ложь;
	// --- 
	ОбработкаРасшифровки = Новый ОбработкаРасшифровкиКомпоновкиДанных(Отчет.АдресРасшифровки, Новый ИсточникДоступныхНастроекКомпоновкиДанных(Отчет.АдресСхемы));
	// --- 
	ДоступныеДействия = Новый Массив();
	ДопДействия = Новый СписокЗначений;
	_СформироватьДоступныеДействияОбработкиРасшифровки(ДоступныеДействия, ДопДействия);
	// --- 
	ПараметрВыполненногоДействия = Неопределено; // настройки
		
	// Осуществим выбор действия расшифровки пользователем
	ПОВ = Новый ОписаниеОповещения("ОбработкаВыбораДействияРасшифровки",ЭтотОбъект, Новый Структура("Расшифровка",Расшифровка)); 
	ОбработкаРасшифровки.ПоказатьВыборДействия(ПОВ,Расшифровка, ДоступныеДействия, ДопДействия, Истина);
   	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбораДействияРасшифровки(ВыполненноеДействие, ПараметрВыполненногоДействия, ДополнительныеПараметры) Экспорт 
	// --- 
	
	Если (ВыполненноеДействие <> Неопределено) Тогда
		
		Если ВыполненноеДействие = ДействиеОбработкиРасшифровкиКомпоновкиДанных.ОткрытьЗначение Тогда
			
			ПоказатьЗначение(,ПараметрВыполненногоДействия);    
			
		ИначеЕсли ВыполненноеДействие = ДействиеОбработкиРасшифровкиКомпоновкиДанных.Отфильтровать Тогда 
			
			Компоновщик.ЗагрузитьНастройки(ПараметрВыполненногоДействия);
			Сформировать(ЭтаФорма.Команды.Найти("Сформировать"));
			
		ИначеЕсли ВыполненноеДействие = "ПлановаяДатаОплаты" Тогда
			
			Для Каждого ЭлементСписка из Выделенные Цикл
				ЭлементСписка.Представление = _ПредставлениеДокумента(ЭлементСписка.Значение); 
			КонецЦикла;
			
			СтруктураПараметров = Новый Структура("Документ", Выделенные);
			ОписаниеОповещения  = Новый ОписаниеОповещения("ОбработкаИзмененияПлановойДатыОплаты",ЭтотОбъект);  
			
			ОткрытьФорму("ОбщаяФорма.CW_ПлановыйСрокОплаты", СтруктураПараметров,,,,,ОписаниеОповещения,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
			
		ИначеЕсли ВыполненноеДействие = "СрокОплаты" Тогда
			
			Для Каждого ЭлементСписка из Выделенные Цикл
				ЭлементСписка.Представление = _ПредставлениеДокумента(ЭлементСписка.Значение); 
			КонецЦикла;	
			
			СтруктураПараметров = Новый Структура;
			СтруктураПараметров.Вставить("Документ", 				Выделенные);
			
			Если Выделенные.Количество() = 1 Тогда
				ЭлементСписка 	  = Выделенные.Получить(0);	
				ДанныеСрокаОплаты =	CW_Документы.ПолучитьСрокОплаты(ЭлементСписка.Значение);
				
				СтруктураПараметров.Вставить("ДатаОплаты", 				ДанныеСрокаОплаты.ДатаОплаты);
				СтруктураПараметров.Вставить("Описание", 				ДанныеСрокаОплаты.Описание);
				СтруктураПараметров.Вставить("РучноеРедактирование", 	ДанныеСрокаОплаты.РучноеРедактирование);
				
			КонецЕсли;
			
			ОписаниеОповещения  = Новый ОписаниеОповещения("ОбработкаИзмененияСрокаОплаты",ЭтотОбъект, Выделенные); 
			
			ОткрытьФорму("ОбщаяФорма.CW_СрокОплаты", СтруктураПараметров,,,,,ОписаниеОповещения,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца); 	
			
		КонецЕсли;
		
	КонецЕсли; 
	
	// --- 
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаИзмененияПлановойДатыОплаты(РезультатОбработки, ДополнительныеПараметры) Экспорт 

	Если РезультатОбработки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Сформировать(ЭтаФорма.Команды.Найти("Сформировать"));
	
КонецПроцедуры
  
&НаКлиенте
Процедура ОбработкаИзмененияСрокаОплаты(РезультатОбработки, ДополнительныеПараметры) Экспорт 
	
	Если РезультатОбработки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОбработатьИзменениеСрокаОплатыНаСервере(РезультатОбработки, ДополнительныеПараметры);
	
	Сформировать(ЭтаФорма.Команды.Найти("Сформировать"));
	
КонецПроцедуры 

&НаСервере
Процедура ОбработатьИзменениеСрокаОплатыНаСервере(ДанныеСрокаОплаты, СписокДокументов)
	
	Для Каждого ЭлементСписка из СписокДокументов Цикл
		
		СтруктураПараметров  = Новый Структура;
		СтруктураПараметров.Вставить("Счет", ЭлементСписка.Значение);  
		
		СтруктураПараметров.Вставить("ДатаОплаты", 				ДанныеСрокаОплаты.ДатаОплаты);
		СтруктураПараметров.Вставить("Описание", 				ДанныеСрокаОплаты.Описание);
		СтруктураПараметров.Вставить("РучноеРедактирование", 	ДанныеСрокаОплаты.РучноеРедактирование);
		
		РегистрыСведений.CW_СрокиОплатыСчетов.ЗаписатьСрокОплатыДокумента(СтруктураПараметров);
		
	КонецЦикла;
	
КонецПроцедуры
  
&НаКлиенте
Процедура ОбработкаСобытияРасшифровки(РезПО, ДополнительныеПараметры) Экспорт 
