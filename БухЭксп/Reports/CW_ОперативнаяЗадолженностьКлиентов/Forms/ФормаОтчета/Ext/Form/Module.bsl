&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	CW_ВалютаРегламентированногоУчетаРубль = ПолучитьФункциональнуюОпцию("CW_ВалютаРегламентированногоУчетаРубль");
	ВРУ	= Константы.ВалютаРегламентированногоУчета.Получить();
	Элементы.Рубли.Заголовок = Строка(ВРУ);

	Параметры.Свойство("ПараметрКоманды", ПараметрКоманды); 
	Если Не ПараметрКоманды.Пустая() Тогда
		ПланОплаты 	= истина;
		Валюта 		= Истина;
		Рубли 		= Истина;   
		
		СтрокаГруппировки = Группировки.Добавить(); 
		СтрокаГруппировки.ИмяПоля 		= "Валюта";
		СтрокаГруппировки.Представление	= "Валюта";
		СтрокаГруппировки.Сортировка 	= ПредопределенноеЗначение("Перечисление.CW_НаправлениеСортировки.ПоВозрастанию");
		
		СтрокаГруппировки = Группировки.Добавить(); 
		СтрокаГруппировки.ИмяПоля 		= "Контрагент";
		СтрокаГруппировки.Представление	= "Контрагент";
		СтрокаГруппировки.Сортировка 	= ПредопределенноеЗначение("Перечисление.CW_НаправлениеСортировки.ПоВозрастанию");
	КонецЕсли;
	
	// список доступных группировок
	СписокГруппировок.Очистить();
	СписокГруппировок.Добавить("Организация", "Организация", Ложь);
	СписокГруппировок.Добавить("Контрагент", "Контрагент", Ложь);
	СписокГруппировок.Добавить("Договор", "Договор", Ложь);
	СписокГруппировок.Добавить("Валюта", "Валюта", Ложь);
	СписокГруппировок.Добавить("СчетУчета", "Счет учета", Ложь);
	
	ЭтаФорма.АвтоОтображениеСостояния = РежимАвтоОтображенияСостояния.НеОтображать;
	
	// ---------------------------------------------------------------------------- 
	
	ОтборГП_СК = ПолучитьОбщийМакет("CW_СхемаЖурналаГрузоперевозокПоВыборке");
	ОтборГП_АдресСхемыКомпоновки = ПоместитьВоВременноеХранилище(ОтборГП_СК,ЭтаФорма.УникальныйИдентификатор);
	ОтборГП_ИсточникНастроек = Новый ИсточникДоступныхНастроекКомпоновкиДанных(ОтборГП_АдресСхемыКомпоновки);
	ОтборГП_КомпоновщикНастроек = Новый КомпоновщикНастроекКомпоновкиДанных;
	ОтборГП_КомпоновщикНастроек.Инициализировать(ОтборГП_ИсточникНастроек);
	
	ГруппаПользователя = CW_ПраваДоступа_ПИ.ГруппаПользователя(ПараметрыСеанса.ТекущийПользователь);
	СрокОплатыДоступен = (ГруппаПользователя = Справочники.CW_ГруппыПользователей.Администраторы 
								Или ГруппаПользователя.РедактированиеСроковОплатыИсходящихСчетов);
	
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	НаДату = ТекущаяДата();
	
	_ИнициализацияНастроекКомпоновщикаДляОтбораГП();
	Если ПараметрКоманды.Пустая() Тогда
		_ВосстановитьСеансовуюНастройку(); 
	КонецЕсли;
	
	УстановитьСхему();
	ЗагрузитьНастройкиКомпановщика();   

	Если Не ПараметрКоманды.Пустая() Тогда
		УстановитьОтборКомпановщика();  
		СформироватьОтчет();
		ОбработатьОтчет();
	КонецЕсли;

	Элементы.ФормаНастройка.Пометка = Истина;
	
	_УправлениеЭлементамиФормы();
	
КонецПроцедуры   

&НаСервере
Процедура УстановитьОтборКомпановщика()
	
	Компоновщик.Настройки.Отбор.Элементы.Очистить();
	
	ЭлементОбора = Компоновщик.Настройки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОбора.ЛевоеЗначение 	= Новый ПолеКомпоновкиДанных("ДокументВзаиморасчетов");
	ЭлементОбора.ВидСравнения 	= ВидСравненияКомпоновкиДанных.Равно;
	ЭлементОбора.ПравоеЗначение = ПараметрКоманды;
	ЭлементОбора.Использование 	= Истина;
	
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьНастройкиКомпановщика()
	
	Компоновщик.ЗагрузитьНастройки(УстановитьНастройкиСКД());
	Компоновщик.РазвернутьАвтоПоля();

КонецПроцедуры



&НаСервере
Функция ПолучитьНастройки()
	
	Настройки = _сф.ст_Создать("НаДату,ПоПериодам,Периоды,ПланОплаты,ДатаВозвратаДокументов,ПланОплатыВыделятьПросрочку,Рубли,Валюта,Группировки,ВыводитьГрузоперевозки,ВыводитьЗаказы");
	Настройки.НаДату = НаДату;
	Настройки.ПоПериодам = ПоПериодам;
	Настройки.Периоды = Периоды.Выгрузить();
	Настройки.ПланОплаты = ПланОплаты;
	Настройки.ДатаВозвратаДокументов = ДатаВозвратаДокументов;
	Настройки.ПланОплатыВыделятьПросрочку = ПланОплатыВыделятьПросрочку;
	Настройки.Рубли = Рубли;
	Настройки.Валюта = Валюта;
	Настройки.Группировки = Группировки.Выгрузить();
	Настройки.ВыводитьГрузоперевозки = ВыводитьГрузоперевозки;
	Настройки.ВыводитьЗаказы = ВыводитьЗаказы;
	
	Возврат Настройки;
	
КонецФункции

