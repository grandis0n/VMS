&НаКлиенте
Процедура ВалютаПриИзменении(Элемент)
	
	Если Валюта Тогда
		мас = Группировки.НайтиСтроки(Новый Структура("Представление", "Валюта"));
		Если мас.Количество() = 0 Тогда
			НГр = Группировки.Вставить(0);
			НГр.ИмяПоля = "Валюта";
			НГр.Представление = "Валюта";
			НГр.Сортировка = ПредопределенноеЗначение("Перечисление.CW_НаправлениеСортировки.ПоВозрастанию"); 
		КонецЕсли;	
	КонецЕсли;	
	
КонецПроцедуры

&НаСервере
Процедура ПередЗагрузкойПользовательскихНастроекНаСервере(Настройки)
	
	Если Настройки.ДополнительныеСвойства.Свойство("Периоды") Тогда
		Если ТипЗнч(Настройки.ДополнительныеСвойства.Периоды) = Тип("ТаблицаЗначений") Тогда 
			Периоды.Загрузить(Настройки.ДополнительныеСвойства.Периоды); // ТаблицаЗначений
		Иначе
			Периоды.Загрузить(Настройки.ДополнительныеСвойства.Периоды.Выгрузить()); // ДанныеФормыКоллекция
		КонецЕсли;
	КонецЕсли;
	
	Если Настройки.ДополнительныеСвойства.Свойство("Группировки") Тогда
		Если ТипЗнч(Настройки.ДополнительныеСвойства.Группировки) = Тип("ТаблицаЗначений") Тогда 
			Группировки.Загрузить(Настройки.ДополнительныеСвойства.Группировки); // ТаблицаЗначений
		Иначе
			Группировки.Загрузить(Настройки.ДополнительныеСвойства.Группировки.Выгрузить()); // ДанныеФормыКоллекция
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

