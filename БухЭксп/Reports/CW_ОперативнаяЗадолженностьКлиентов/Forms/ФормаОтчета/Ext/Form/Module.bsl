&НаСервере
Процедура _ВосстановитьСеансовуюНастройку()
	
	// пытаемся восстановить настройки
	Идентификатор = РеквизитФормыВЗначение("Отчет").Метаданные().Имя;
	СеансоваяНастройка = ХранилищеСистемныхНастроек.Загрузить(Идентификатор, "Сеансовая");
	Если СеансоваяНастройка <> Неопределено Тогда
		Попытка
			СеансоваяНастройка.Свойство("ПоПериодам", ПоПериодам);
			Периоды.Загрузить(СеансоваяНастройка.Периоды);
			СеансоваяНастройка.Свойство("ПланОплаты", ПланОплаты);
			СеансоваяНастройка.Свойство("ДатаВозвратаДокументов", ДатаВозвратаДокументов);
			СеансоваяНастройка.Свойство("ПланОплатыВыделятьПросрочку", ПланОплатыВыделятьПросрочку);
			СеансоваяНастройка.Свойство("Рубли", Рубли);
			СеансоваяНастройка.Свойство("Валюта", Валюта);
			Группировки.Загрузить(СеансоваяНастройка.Группировки);
			СеансоваяНастройка.Свойство("ВыводитьГрузоперевозки", ВыводитьГрузоперевозки);
			СеансоваяНастройка.Свойство("ВыводитьЗаказы", ВыводитьЗаказы);
			
			//Подсистема.СтатусыДокументов
			СеансоваяНастройка.Свойство("ВыводитьСтатусДокумента", ВыводитьСтатусДокумента);
			//Подсистема.СтатусыДокументов
			
			// Отбор
			НастройкиКД = "";
			СеансоваяНастройка.Свойство("Отбор", НастройкиКД);
			Компоновщик.Настройки.Отбор.Элементы.Очистить();
			Для Каждого СтрОтбор из НастройкиКД.Отбор.Элементы Цикл
				НовОтбор = Компоновщик.Настройки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
				ЗаполнитьЗначенияСвойств(НовОтбор, СтрОтбор);
			КонецЦикла;	
			//  отбор г/п
			СеансоваяНастройка.Свойство("ОтборПоГрузоперевозкам", ОтборПоГрузоперевозкам);
			НастройкиКД_ОтборГП = "";
			СеансоваяНастройка.Свойство("ОтборПоГрузоперевозкам_Настройки", НастройкиКД_ОтборГП);
			Если (НастройкиКД_ОтборГП <> "") Тогда
				_УФС.СкопироватьОтбор(НастройкиКД_ОтборГП.Отбор,ОтборГП_КомпоновщикНастроек.Настройки.Отбор);
			КонецЕсли; 
			
		Исключение
		КонецПопытки; 
	КонецЕсли; 
	
КонецПроцедуры

&НаСервере
Процедура _СохранитьСеансовуюНастройку()
	
	СтруктураНастройки = Новый Структура();
	СтруктураНастройки.Вставить("ПоПериодам", ПоПериодам);
	СтруктураНастройки.Вставить("Периоды", Периоды.Выгрузить());
	СтруктураНастройки.Вставить("ПланОплаты", ПланОплаты);     
	СтруктураНастройки.Вставить("ДатаВозвратаДокументов", ДатаВозвратаДокументов);     
	СтруктураНастройки.Вставить("ПланОплатыВыделятьПросрочку", ПланОплатыВыделятьПросрочку);
	СтруктураНастройки.Вставить("Рубли", Рубли);
	СтруктураНастройки.Вставить("Валюта", Валюта);
	СтруктураНастройки.Вставить("Группировки", Группировки.Выгрузить());
	СтруктураНастройки.Вставить("ВыводитьГрузоперевозки", ВыводитьГрузоперевозки);
	СтруктураНастройки.Вставить("ВыводитьЗаказы", ВыводитьЗаказы);
	СтруктураНастройки.Вставить("Отбор", Компоновщик.ПолучитьНастройки());
	
	//Подсистема.СтатусыДокументов
	СтруктураНастройки.Вставить("ВыводитьСтатусДокумента", ВыводитьСтатусДокумента);
	//Подсистема.СтатусыДокументов

	// --- 
	СтруктураНастройки.Вставить("ОтборПоГрузоперевозкам", ОтборПоГрузоперевозкам);
	СтруктураНастройки.Вставить("ОтборПоГрузоперевозкам_Настройки", ОтборГП_КомпоновщикНастроек.Настройки);
	
	Идентификатор = РеквизитФормыВЗначение("Отчет").Метаданные().Имя;
	ХранилищеСистемныхНастроек.Сохранить(Идентификатор, "Сеансовая", СтруктураНастройки);
	
КонецПроцедуры

