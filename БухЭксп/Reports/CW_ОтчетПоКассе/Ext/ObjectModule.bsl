#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
Функция СформироватьОтчет(Результат=Неопределено, ДанныеРасшифровки = Неопределено) Экспорт
	
	Если Результат=Неопределено Тогда
		Результат = Новый ТабличныйДокумент;
	КонецЕсли;
	
	Результат.АвтоМасштаб = Истина;
	Результат.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	
	// ---------------------------------------------------------------------------- 
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	CW_ДенежныеСредстваОстаткиИОбороты.СуммаНачальныйОстаток КАК СальдоНачальное,
	               |	CW_ДенежныеСредстваОстаткиИОбороты.СуммаПриход КАК Приход,
	               |	CW_ДенежныеСредстваОстаткиИОбороты.СуммаРасход КАК Расход,
	               |	CW_ДенежныеСредстваОстаткиИОбороты.СуммаКонечныйОстаток КАК СальдоКонечное,
	               |	CW_ДенежныеСредстваОстаткиИОбороты.Регистратор.ВидОперации КАК ВидОперации,
	               |	CW_ДенежныеСредстваОстаткиИОбороты.Регистратор КАК Регистратор,
	               |	CW_ДенежныеСредстваОстаткиИОбороты.Регистратор.НомерДокумента КАК НомерДокумента,
	               |	CW_ДенежныеСредстваОстаткиИОбороты.Регистратор.ДатаДокумента КАК ДатаДокумента,
	               |	CW_ДенежныеСредстваОстаткиИОбороты.Регистратор.Дата КАК Дата,
	               |	CW_ДенежныеСредстваОстаткиИОбороты.Регистратор.ПредставлениеДокумента КАК ПредставлениеДокумента,
	               |	CW_ДенежныеСредстваОстаткиИОбороты.Регистратор.НазначениеПлатежа КАК НазначениеПлатежа
	               |ИЗ
	               |	РегистрНакопления.CW_ДенежныеСредства.ОстаткиИОбороты(
	               |			&НачалоПериода,
	               |			&КонецПериода,
	               |			Регистратор,
	               |			,
	               |			Касса = &Касса
	               |				И Валюта = &Валюта) КАК CW_ДенежныеСредстваОстаткиИОбороты
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	CW_ДенежныеСредстваОстаткиИОбороты.Регистратор.МоментВремени";
	Запрос.УстановитьПараметр("НачалоПериода", НачалоДня(НачалоПериода));
	Запрос.УстановитьПараметр("КонецПериода", КонецДня(КонецПериода));
	Запрос.УстановитьПараметр("Касса", Касса);
	Запрос.УстановитьПараметр("Валюта", Касса.Валюта );
	// --- 
	ТЗ = Запрос.Выполнить().Выгрузить();
	СальдоНачальное = 0;
	СальдоКонечное = 0;
	ВсегоПриход = 0;
	ВсегоРасход = 0;
	Если (ТЗ.Количество() <> 0) Тогда
		
		_сф.к_УдалитьЭлементыПоОтбору(ТЗ,Новый Структура("Регистратор",Неопределено));
		
		СальдоНачальное = _сф.к_ПервыйЭлемент(ТЗ).СальдоНачальное;
		СальдоКонечное = _сф.к_ПоследнийЭлемент(ТЗ).СальдоКонечное;
		ВсегоПриход = _сф.Итог(ТЗ,"Приход");
		ВсегоРасход = _сф.Итог(ТЗ,"Расход");
		
	КонецЕсли; 
	
	
	// ---------------------------------------------------------------------------- 
	
	Макет = ПолучитьМакет("ОтчетПоКассе");
	
	ТД = Новый ТабличныйДокумент;
	ТД.АвтоМасштаб = Истина;
	
	Область = Макет.ПолучитьОбласть("Заголовок");
	Область.Параметры.Текст = "Период: "+Формат(НачалоПериода, "ДЛФ=Д")+?(КонецПериода=Дата(1,1,1),Неопределено," - "+Формат(КонецПериода, "ДЛФ=Д"))+Символы.ПС+"Касса: "+Строка(Касса);
	ТД.Вывести(Область);
	
	// --- 
	
	Область = Макет.ПолучитьОбласть("Шапка");
	Область.Параметры.Валюта = Строка(Касса.Валюта);
	ТД.Вывести(Область);
	
	// --- 
	
	Область = Макет.ПолучитьОбласть("СальдоНачальное");
	Область.Параметры.НачПериода= Формат(НачалоПериода,"ДФ=dd.MM.yyyy");
	Область.Параметры.Сальдо = СальдоНачальное;
	ТД.Вывести(Область);
	
	// --- 
	
	Область = Макет.ПолучитьОбласть("СтрокаОборота");
	Для каждого Стр Из ТЗ Цикл
		
		Если (Стр.Регистратор=Неопределено) Тогда
			
			Продолжить;
			
		КонецЕсли; 
		
		Область.Параметры.Документ = Стр.Регистратор;
		Область.Параметры.Дата = Стр.Дата;
		// --- 
		СтрокаСодержания = "";
		// --- 
		
		Представление = СокрЛП(Стр.ПредставлениеДокумента);
		ЕстьПредставление = ЗначениеЗаполнено(Представление);
		Назначение = СокрЛП(Стр.НазначениеПлатежа);
		ЕстьНазначение = ЗначениеЗаполнено(Назначение);
		// --- 
		Если (Стр.ВидОперации = Перечисления.CW_ВидыОперацийДДС.ПоступлениеОтПокупателя) Тогда
			
			СтрокаСодержания = "Получено от """+Строка(Стр.Регистратор.Контрагент)+""""+?(ЕстьПредставление," по "+Представление,"")+?(ЕстьНазначение," ("+Назначение+")","");
			
		ИначеЕсли (Стр.ВидОперации = Перечисления.CW_ВидыОперацийДДС.ОплатаПоставщику) Тогда 
			
			 СтрокаСодержания = "Выдано """+Строка(Стр.Регистратор.Контрагент)+""""+?(ЕстьПредставление," по "+Представление,"")+?(ЕстьНазначение," ("+Назначение+")","");
			 
		ИначеЕсли (Стр.ВидОперации = Перечисления.CW_ВидыОперацийДДС.ПеремещениеВДругуюКассу) Тогда 
			
			 СтрокаСодержания = "Передано в """+Строка(Стр.Регистратор.КассаПоступления)+""""+?(ЕстьПредставление," по "+Представление,"")+?(ЕстьНазначение," ("+Назначение+")","");
			 
		ИначеЕсли (Стр.ВидОперации = Перечисления.CW_ВидыОперацийДДС.ПрочиеСписания) Тогда 
			
			 СтрокаСодержания = "Списано"+?(ЕстьПредставление," по "+Представление,"")+?(ЕстьНазначение," ("+Назначение+")","");
			 
		ИначеЕсли (Стр.ВидОперации = Перечисления.CW_ВидыОперацийДДС.ПрочиеПоступления) Тогда 
			
			 СтрокаСодержания = "Получено"+?(ЕстьПредставление," по "+Представление,"")+?(ЕстьНазначение," ("+Назначение+")","");
			 
		КонецЕсли; 
		Область.Параметры.Содержание = СтрокаСодержания;
		// --- 
		Область.Параметры.Приход = Стр.Приход;
		Область.Параметры.Расход = Стр.Расход; 
		
		ТД.Вывести(Область);
		
	КонецЦикла; 
	
	
	// --- 
	
	Область = Макет.ПолучитьОбласть("Итог");
	Область.Параметры.Приход = ВсегоПриход;
	Область.Параметры.Расход = ВсегоРасход;
	ТД.Вывести(Область);
	
	Область = Макет.ПолучитьОбласть("СальдоКонечное");
	Область.Параметры.КонПериода= Формат(КонецПериода,"ДФ=dd.MM.yyyy");
	Область.Параметры.Сальдо = СальдоКонечное;
	ТД.Вывести(Область);
	
	// --- 
	
	Результат.Вывести(ТД);
	
	// ---------------------------------------------------------------------------- 
	
КонецФункции
	

#КонецЕсли