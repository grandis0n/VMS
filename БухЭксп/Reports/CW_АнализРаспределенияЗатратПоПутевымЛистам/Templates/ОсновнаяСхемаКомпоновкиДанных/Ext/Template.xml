////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ХозрасчетныйОбороты.Организация КАК Организация,
	ЕСТЬNULL(ВТ_Соответствия.ПутевойЛист, НЕОПРЕДЕЛЕНО) КАК ПутевойЛист,
	ХозрасчетныйОбороты.Субконто1 КАК НоменклатурнаяГруппа,
	ХозрасчетныйОбороты.Субконто2 КАК СтатьяЗатрат,
	ХозрасчетныйОбороты.СуммаОборотДт КАК ОборотПоСчету
ПОМЕСТИТЬ ВТ_ОборотыСчета
ИЗ
	РегистрБухгалтерии.Хозрасчетный.Обороты(
			,
			,
			Период,
			Счет = &amp;Счет,
			&amp;Субконто,
			Субконто1 В
				(ВЫБРАТЬ
					ВТ_Соответствия.НоменклатурнаяГруппа КАК НоменклатурнаяГруппа
				ИЗ
					ВТ_Соответствия КАК ВТ_Соответствия),
			,
			) КАК ХозрасчетныйОбороты
		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Соответствия КАК ВТ_Соответствия
		ПО ХозрасчетныйОбороты.Субконто1 = ВТ_Соответствия.НоменклатурнаяГруппа

ИНДЕКСИРОВАТЬ ПО
	НоменклатурнаяГруппа,
	Организация
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	CW_РасходыПоГрузоперевозкамТранспортныхСредствОбороты.Организация КАК Организация,
	CW_РасходыПоГрузоперевозкамТранспортныхСредствОбороты.ПутевойЛист КАК ПутевойЛист,
	ЕСТЬNULL(ВТ_Соответствия.НоменклатурнаяГруппа, НЕОПРЕДЕЛЕНО) КАК НоменклатурнаяГруппа,
	CW_РасходыПоГрузоперевозкамТранспортныхСредствОбороты.Грузоперевозка КАК Грузоперевозка,
	CW_РасходыПоГрузоперевозкамТранспортныхСредствОбороты.СуммаОборот КАК СуммаРаспределено,
	CW_РасходыПоГрузоперевозкамТранспортныхСредствОбороты.СтатьяЗатрат КАК СтатьяЗатрат
ПОМЕСТИТЬ ВТ_Распределение
ИЗ
	РегистрНакопления.CW_РасходыПоГрузоперевозкамТранспортныхСредств.Обороты(
			,
			,
			Период,
			ПутевойЛист В
				(ВЫБРАТЬ
					ВТ_Соответствия.ПутевойЛист КАК ПутевойЛист
				ИЗ
					ВТ_Соответствия КАК ВТ_Соответствия)) КАК CW_РасходыПоГрузоперевозкамТранспортныхСредствОбороты
		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Соответствия КАК ВТ_Соответствия
		ПО CW_РасходыПоГрузоперевозкамТранспортныхСредствОбороты.ПутевойЛист = ВТ_Соответствия.ПутевойЛист

ИНДЕКСИРОВАТЬ ПО
	Организация
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВТ_ОборотыСчета.Организация КАК Организация,
	ВТ_ОборотыСчета.СтатьяЗатрат КАК СтатьяЗатрат,
	ВТ_ОборотыСчета.НоменклатурнаяГруппа КАК НоменклатурнаяГруппа,
	ВТ_ОборотыСчета.ПутевойЛист КАК ПутевойЛист,
	ВТ_ОборотыСчета.ОборотПоСчету КАК ОборотПоСчету,
	0 КАК СуммаРаспределено
ПОМЕСТИТЬ ВТ_Данные
ИЗ
	ВТ_ОборотыСчета КАК ВТ_ОборотыСчета

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	ВТ_Распределение.Организация,
	ВТ_Распределение.СтатьяЗатрат,
	ВТ_Распределение.НоменклатурнаяГруппа,
	ВТ_Распределение.ПутевойЛист,
	0,
	ВТ_Распределение.СуммаРаспределено
ИЗ
	ВТ_Распределение КАК ВТ_Распределение
;

