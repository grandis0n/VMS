;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	СУММА(Расходы.СуммаОборотДт) КАК Сумма,
	Расходы.КорСчет КАК КорСчет,
	Расходы.Организация КАК Организация,
	Расходы.Регистратор КАК Регистратор,
	2 КАК Вид
ПОМЕСТИТЬ Расходы
{ВЫБРАТЬ
	Сумма}
ИЗ
	РегистрБухгалтерии.Хозрасчетный.Обороты(
			&amp;НачалоПериода,
			&amp;КонецПериода,
			Регистратор {(&amp;Периодичность)},
			Счет В
				(ВЫБРАТЬ
					СчетаРасходов.Счет КАК Счет
				ИЗ
					СчетаРасходов КАК СчетаРасходов),
			,
			{(Организация).* КАК Организация},
			,
			) КАК Расходы

СГРУППИРОВАТЬ ПО
	Расходы.Организация,
	Расходы.КорСчет,
	Расходы.Регистратор

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	СУММА(Расходы.СуммаОборотДт),
	Расходы.КорСчет,
	Расходы.Организация,
	Расходы.Регистратор,
	5
ИЗ
	РегистрБухгалтерии.Хозрасчетный.Обороты(
			&amp;НачалоПериода,
			&amp;КонецПериода,
			Регистратор {(&amp;Периодичность)},
			Счет В
				(ВЫБРАТЬ
					СчетаПрочихРасходов.Счет
				ИЗ
					СчетаПрочихРасходов КАК СчетаПрочихРасходов),
			,
			&amp;ПрочиеДоходыИРасходы {(Организация).* КАК Организация},
			НЕ КорСчет В
					(ВЫБРАТЬ
						СчетаНДСПрочиеДоходыРасходы.Счет КАК Счет
					ИЗ
						СчетаНДСПрочиеДоходыРасходы КАК СчетаНДСПрочиеДоходыРасходы),
			) КАК Расходы

СГРУППИРОВАТЬ ПО
	Расходы.Организация,
	Расходы.КорСчет,
	Расходы.Регистратор
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	СУММА(Доходы.СуммаОборотКт) КАК Сумма,
	Доходы.Организация КАК Организация,
	1 КАК Вид,
	Доходы.Регистратор КАК Регистратор
ПОМЕСТИТЬ Доходы
{ВЫБРАТЬ
	Сумма}
ИЗ
	РегистрБухгалтерии.Хозрасчетный.Обороты(
			&amp;НачалоПериода,
			&amp;КонецПериода,
			Регистратор {(&amp;Периодичность)},
			Счет В
				(ВЫБРАТЬ
					СчетаДоходов.Счет КАК Счет
				ИЗ
					СчетаДоходов КАК СчетаДоходов),
			,
			{(Организация).* КАК Организация},
			,
			) КАК Доходы

СГРУППИРОВАТЬ ПО
	Доходы.Организация,
	Доходы.Регистратор

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	СУММА(Доходы.СуммаОборотКт),
	Доходы.Организация,
	4,
	Доходы.Регистратор
ИЗ
	РегистрБухгалтерии.Хозрасчетный.Обороты(
			&amp;НачалоПериода,
			&amp;КонецПериода,
			Регистратор {(&amp;Периодичность)},
			Счет В
				(ВЫБРАТЬ
					СчетаПрочихДоходов.Счет
				ИЗ
					СчетаПрочихДоходов КАК СчетаПрочихДоходов),
			,
			&amp;ПрочиеДоходыИРасходы {(Организация).* КАК Организация},
			,
			) КАК Доходы

СГРУППИРОВАТЬ ПО
	Доходы.Организация,
	Доходы.Регистратор

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	СУММА(-НДС.СуммаОборотДт),
	НДС.Организация,
	1,
	НДС.Регистратор
ИЗ
	РегистрБухгалтерии.Хозрасчетный.Обороты(
			&amp;НачалоПериода,
			&amp;КонецПериода,
			Регистратор {(&amp;Периодичность)},
			Счет В
				(ВЫБРАТЬ
					СчетаНДС.Счет
				ИЗ
					СчетаНДС КАК СчетаНДС),
			,
			{(Организация).* КАК Организация},
			,
			) КАК НДС

СГРУППИРОВАТЬ ПО
	НДС.Организация,
	НДС.Регистратор

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	СУММА(ВЫБОР
			КОГДА &amp;ИспользоватьФункциональность
					И &amp;БезвозмезднаяПередача &lt;&gt; ЗНАЧЕНИЕ(Справочник.ПрочиеДоходыИРасходы.ПустаяССылка)
					И НДС.Субконто1 = &amp;БезвозмезднаяПередача
				ТОГДА НДС.СуммаОборотДт
			ИНАЧЕ -НДС.СуммаОборотДт
		КОНЕЦ),
	НДС.Организация,
	ВЫБОР
		КОГДА &amp;ИспользоватьФункциональность
				И &amp;БезвозмезднаяПередача &lt;&gt; ЗНАЧЕНИЕ(Справочник.ПрочиеДоходыИРасходы.ПустаяССылка)
				И НДС.Субконто1 = &amp;БезвозмезднаяПередача
			ТОГДА 5
		ИНАЧЕ 4
	КОНЕЦ,
	НДС.Регистратор
ИЗ
	РегистрБухгалтерии.Хозрасчетный.Обороты(
			&amp;НачалоПериода,
			&amp;КонецПериода,
			Регистратор {(&amp;Периодичность)},
			Счет В
				(ВЫБРАТЬ
					СчетаПрочихРасходов.Счет КАК Счет
				ИЗ
					СчетаПрочихРасходов КАК СчетаПрочихРасходов),
			,
			&amp;ПрочиеДоходыИРасходы {(Организация).* КАК Организация},
			КорСчет В
				(ВЫБРАТЬ
					СчетаНДСПрочиеДоходыРасходы.Счет КАК Счет
				ИЗ
					СчетаНДСПрочиеДоходыРасходы КАК СчетаНДСПрочиеДоходыРасходы),
			) КАК НДС

СГРУППИРОВАТЬ ПО
	НДС.Организация,
	НДС.Регистратор,
	ВЫБОР
		КОГДА &amp;ИспользоватьФункциональность
				И &amp;БезвозмезднаяПередача &lt;&gt; ЗНАЧЕНИЕ(Справочник.ПрочиеДоходыИРасходы.ПустаяССылка)
				И НДС.Субконто1 = &amp;БезвозмезднаяПередача
			ТОГДА 5
		ИНАЧЕ 4
	КОНЕЦ
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	Расходы.Сумма КАК Сумма,
	Расходы.Вид КАК Вид,
	Расходы.Организация КАК Организация,
	Расходы.Регистратор КАК Регистратор
ПОМЕСТИТЬ ДанныеОтчета
{ВЫБРАТЬ
	Сумма,
	Вид,
	Организация.*}
ИЗ
	Расходы КАК Расходы
{ГДЕ
	Расходы.Сумма,
	Расходы.Организация.*}

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	СУММА(Доходы.Сумма),
	Доходы.Вид,
	Доходы.Организация,
	Доходы.Регистратор
ИЗ
	Доходы КАК Доходы
{ГДЕ
	Доходы.Сумма,
	Доходы.Организация.*}

СГРУППИРОВАТЬ ПО
	Доходы.Вид,
	Доходы.Организация,
	Доходы.Регистратор

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	ВложенныйЗапрос.Сумма,
	ВложенныйЗапрос.Вид,
	ВложенныйЗапрос.Организация,
	ВложенныйЗапрос.Регистратор
ИЗ
	(ВЫБРАТЬ
		ВложенныйЗапрос.Организация КАК Организация,
		СУММА(ВложенныйЗапрос.Сумма) КАК Сумма,
		ВложенныйЗапрос.Регистратор КАК Регистратор,
		ВложенныйЗапрос.Вид КАК Вид
	ИЗ
		(ВЫБРАТЬ
			ВЫБОР
				КОГДА Доходы.Вид = 5
					ТОГДА -Доходы.Сумма
				ИНАЧЕ Доходы.Сумма
			КОНЕЦ КАК Сумма,
			Доходы.Организация КАК Организация,
			Доходы.Регистратор КАК Регистратор,
			3 КАК Вид
		ИЗ
			Доходы КАК Доходы
		ГДЕ
			Доходы.Вид = 1
		
		ОБЪЕДИНИТЬ ВСЕ
		
		ВЫБРАТЬ
			-Расходы.Сумма,
			Расходы.Организация,
			Расходы.Регистратор,
			3
		ИЗ
			Расходы КАК Расходы
		ГДЕ
			Расходы.Вид = 2
		
		ОБЪЕДИНИТЬ ВСЕ
		
		ВЫБРАТЬ
			ВЫБОР
				КОГДА Доходы.Вид = 5
					ТОГДА -Доходы.Сумма
				ИНАЧЕ Доходы.Сумма
			КОНЕЦ,
			Доходы.Организация,
			Доходы.Регистратор,
			6
		ИЗ
			Доходы КАК Доходы
		ГДЕ
			&amp;ПрочиеДоходыИРасходы
		
		ОБЪЕДИНИТЬ ВСЕ
		
		ВЫБРАТЬ
			-Расходы.Сумма,
			Расходы.Организация,
			Расходы.Регистратор,
			6
		ИЗ
			Расходы КАК Расходы
		ГДЕ
			&amp;ПрочиеДоходыИРасходы) КАК ВложенныйЗапрос
	
	СГРУППИРОВАТЬ ПО
		ВложенныйЗапрос.Организация,
		ВложенныйЗапрос.Регистратор,
		ВложенныйЗапрос.Вид) КАК ВложенныйЗапрос
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ДанныеОтчета.Вид КАК Вид,
	ДанныеОтчета.Организация КАК Организация,
	ДанныеОтчета.Регистратор КАК Документ,
	ВЫБОР
		КОГДА ДанныеОтчета.Вид = 1
			ТОГДА ДанныеОтчета.Сумма
		ИНАЧЕ 0
	КОНЕЦ КАК Доходы,
	ВЫБОР
		КОГДА ДанныеОтчета.Вид = 2
			ТОГДА ДанныеОтчета.Сумма
		ИНАЧЕ 0
	КОНЕЦ КАК Расходы,
	ВЫБОР
		КОГДА ДанныеОтчета.Вид = 3
			ТОГДА ДанныеОтчета.Сумма
		ИНАЧЕ 0
	КОНЕЦ КАК Прибыль,
	ВЫБОР
		КОГДА ДанныеОтчета.Вид = 4
			ТОГДА ДанныеОтчета.Сумма
