		<dataSource>ИнформационнаяБаза</dataSource>
		<query>ВЫБРАТЬ
	Хозрасчетный.Ссылка КАК Счет
ПОМЕСТИТЬ СчетаРасходов
ИЗ
	ПланСчетов.Хозрасчетный КАК Хозрасчетный
ГДЕ
	(Хозрасчетный.Ссылка В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.СебестоимостьПродаж))
			ИЛИ Хозрасчетный.Ссылка В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.Продажи_Акцизы))
			ИЛИ Хозрасчетный.Ссылка В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.Продажи_ЭкспортныеПошлины))
			ИЛИ Хозрасчетный.Ссылка В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.Продажи_РасходыНаПродажу))
			ИЛИ Хозрасчетный.Ссылка В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.Продажи_УправленческиеРасходы)))
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	Хозрасчетный.Ссылка КАК Счет
ПОМЕСТИТЬ СчетаПрочихРасходов
ИЗ
	ПланСчетов.Хозрасчетный КАК Хозрасчетный
ГДЕ
	Хозрасчетный.Ссылка В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ПрочиеРасходы))
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	Хозрасчетный.Ссылка КАК Счет
ПОМЕСТИТЬ СчетаНДС
ИЗ
	ПланСчетов.Хозрасчетный КАК Хозрасчетный
ГДЕ
	Хозрасчетный.Ссылка В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.Продажи_НДС))
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	Хозрасчетный.Ссылка КАК Счет
ПОМЕСТИТЬ СчетаНДСПрочиеДоходыРасходы
ИЗ
	ПланСчетов.Хозрасчетный КАК Хозрасчетный
ГДЕ
	Хозрасчетный.Ссылка В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.НДС))
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	Хозрасчетный.Ссылка КАК Счет
ПОМЕСТИТЬ СчетаДоходов
ИЗ
	ПланСчетов.Хозрасчетный КАК Хозрасчетный
ГДЕ
	Хозрасчетный.Ссылка В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.Выручка))
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	Хозрасчетный.Ссылка КАК Счет
ПОМЕСТИТЬ СчетаПрочихДоходов
ИЗ
	ПланСчетов.Хозрасчетный КАК Хозрасчетный
ГДЕ
	Хозрасчетный.Ссылка В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ПрочиеДоходы))
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	СУММА(Расходы.СуммаОборотДт) КАК Сумма,
	Расходы.Период КАК Период,
	Расходы.КорСчет КАК КорСчет,
	Расходы.Организация КАК Организация,
	2 КАК Вид
ПОМЕСТИТЬ Расходы
{ВЫБРАТЬ
	Сумма,
	Период}
ИЗ
	РегистрБухгалтерии.Хозрасчетный.Обороты(
			&amp;НачалоПериода,
			&amp;КонецПериода,
			Регистратор {(&amp;Периодичность)},
			Счет В
				(ВЫБРАТЬ
					СчетаРасходов.Счет
				ИЗ
					СчетаРасходов КАК СчетаРасходов),
			,
			{(Организация).* КАК Организация},
			,
			) КАК Расходы

СГРУППИРОВАТЬ ПО
	Расходы.Организация,
	Расходы.КорСчет,
	Расходы.Период

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	СУММА(Расходы.СуммаОборотДт),
	Расходы.Период,
	Расходы.КорСчет,
	Расходы.Организация,
	5
ИЗ
	РегистрБухгалтерии.Хозрасчетный.Обороты(
			&amp;НачалоПериода,
			&amp;КонецПериода,
			Регистратор {(&amp;Периодичность)},
			Счет В
				(ВЫБРАТЬ
					СчетаПрочихРасходов.Счет КАК Счет
				ИЗ
					СчетаПрочихРасходов КАК СчетаПрочихРасходов),
			,
			&amp;ПрочиеДоходыИРасходы {(Организация).* КАК Организация},
			НЕ КорСчет В
					(ВЫБРАТЬ
						СчетаНДСПрочиеДоходыРасходы.Счет КАК Счет
					ИЗ
						СчетаНДСПрочиеДоходыРасходы КАК СчетаНДСПрочиеДоходыРасходы),
			) КАК Расходы

СГРУППИРОВАТЬ ПО
	Расходы.КорСчет,
	Расходы.Период,
	Расходы.Организация
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	СУММА(Доходы.СуммаОборотКт) КАК Сумма,
	Доходы.Период КАК Период,
	Доходы.Организация КАК Организация,
	1 КАК Вид
ПОМЕСТИТЬ Доходы
{ВЫБРАТЬ
	Сумма,
	Период}
ИЗ
	РегистрБухгалтерии.Хозрасчетный.Обороты(
			&amp;НачалоПериода,
			&amp;КонецПериода,
			Регистратор {(&amp;Периодичность)},
			Счет В
				(ВЫБРАТЬ
					СчетаДоходов.Счет КАК Счет
				ИЗ
					СчетаДоходов КАК СчетаДоходов),
			,
			{(Организация).* КАК Организация},
			,
			) КАК Доходы

СГРУППИРОВАТЬ ПО
	Доходы.Период,
	Доходы.Организация

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	СУММА(Доходы.СуммаОборотКт),
	Доходы.Период,
	Доходы.Организация,
	4
ИЗ
	РегистрБухгалтерии.Хозрасчетный.Обороты(
			&amp;НачалоПериода,
			&amp;КонецПериода,
			Регистратор {(&amp;Периодичность)},
			Счет В
				(ВЫБРАТЬ
					СчетаПрочихДоходов.Счет
				ИЗ
					СчетаПрочихДоходов КАК СчетаПрочихДоходов),
			,
			&amp;ПрочиеДоходыИРасходы {(Организация).* КАК Организация},
			,
			) КАК Доходы

СГРУППИРОВАТЬ ПО
	Доходы.Организация,
	Доходы.Период

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	СУММА(-НДС.СуммаОборотДт),
	НДС.Период,
	НДС.Организация,
	1
ИЗ
	РегистрБухгалтерии.Хозрасчетный.Обороты(
			&amp;НачалоПериода,
			&amp;КонецПериода,
			Регистратор {(&amp;Периодичность)},
			Счет В
				(ВЫБРАТЬ
					СчетаНДС.Счет
				ИЗ
					СчетаНДС КАК СчетаНДС),
			,
			{(Организация).* КАК Организация},
			,
			) КАК НДС

СГРУППИРОВАТЬ ПО
	НДС.Организация,
	НДС.Период

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	СУММА(ВЫБОР
			КОГДА &amp;ИспользоватьФункциональность
					И &amp;БезвозмезднаяПередача &lt;&gt; ЗНАЧЕНИЕ(Справочник.ПрочиеДоходыИРасходы.ПустаяССылка)
					И НДС.Субконто1 = &amp;БезвозмезднаяПередача
				ТОГДА НДС.СуммаОборотДт
			ИНАЧЕ -НДС.СуммаОборотДт
		КОНЕЦ),
	НДС.Период,
	НДС.Организация,
	ВЫБОР
		КОГДА &amp;ИспользоватьФункциональность
				И &amp;БезвозмезднаяПередача &lt;&gt; ЗНАЧЕНИЕ(Справочник.ПрочиеДоходыИРасходы.ПустаяССылка)
				И НДС.Субконто1 = &amp;БезвозмезднаяПередача
			ТОГДА 5
		ИНАЧЕ 4
	КОНЕЦ
ИЗ
	РегистрБухгалтерии.Хозрасчетный.Обороты(
			&amp;НачалоПериода,
			&amp;КонецПериода,
			Регистратор {(&amp;Периодичность)},
			Счет В
				(ВЫБРАТЬ
					СчетаПрочихРасходов.Счет КАК Счет
				ИЗ
					СчетаПрочихРасходов КАК СчетаПрочихРасходов),
			,
			&amp;ПрочиеДоходыИРасходы {(Организация).* КАК Организация},
			КорСчет В
				(ВЫБРАТЬ
					СчетаНДСПрочиеДоходыРасходы.Счет КАК Счет
				ИЗ
					СчетаНДСПрочиеДоходыРасходы КАК СчетаНДСПрочиеДоходыРасходы),
			) КАК НДС

СГРУППИРОВАТЬ ПО
	НДС.Организация,
	НДС.Период,
	ВЫБОР
		КОГДА &amp;ИспользоватьФункциональность
				И &amp;БезвозмезднаяПередача &lt;&gt; ЗНАЧЕНИЕ(Справочник.ПрочиеДоходыИРасходы.ПустаяССылка)
				И НДС.Субконто1 = &amp;БезвозмезднаяПередача
			ТОГДА 5
		ИНАЧЕ 4
	КОНЕЦ
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	1 КАК Вид,
	"Доходы от продаж (выручка)" КАК Представление
ПОМЕСТИТЬ Показатели

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	2,
	"Расходы"

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	3,
	"Прибыль (убыток) от продаж"

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	4,
	"Прочие доходы"
ГДЕ
	&amp;ПрочиеДоходыИРасходы

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	5,
	"Прочие расходы"
ГДЕ
	&amp;ПрочиеДоходыИРасходы

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	6,
	"Прибыль (убыток) до налогов"
ГДЕ
	&amp;ПрочиеДоходыИРасходы
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	Показатели.Вид КАК Вид,
	ДанныеОтчета.Организация КАК Организация,
	ВЫБОР
		КОГДА &amp;Периодичность = 6
			ТОГДА НАЧАЛОПЕРИОДА(ЕСТЬNULL(ДанныеОтчета.Период, &amp;НачалоПериода), ДЕНЬ)
		КОГДА &amp;Периодичность = 7
			ТОГДА НАЧАЛОПЕРИОДА(ЕСТЬNULL(ДанныеОтчета.Период, &amp;НачалоПериода), НЕДЕЛЯ)
		КОГДА &amp;Периодичность = 8
			ТОГДА НАЧАЛОПЕРИОДА(ЕСТЬNULL(ДанныеОтчета.Период, &amp;НачалоПериода), ДЕКАДА)
		КОГДА &amp;Периодичность = 9
			ТОГДА НАЧАЛОПЕРИОДА(ЕСТЬNULL(ДанныеОтчета.Период, &amp;НачалоПериода), МЕСЯЦ)
		КОГДА &amp;Периодичность = 10
			ТОГДА НАЧАЛОПЕРИОДА(ЕСТЬNULL(ДанныеОтчета.Период, &amp;НачалоПериода), КВАРТАЛ)
		КОГДА &amp;Периодичность = 11
			ТОГДА НАЧАЛОПЕРИОДА(ЕСТЬNULL(ДанныеОтчета.Период, &amp;НачалоПериода), ПОЛУГОДИЕ)
		КОГДА &amp;Периодичность = 12
			ТОГДА НАЧАЛОПЕРИОДА(ЕСТЬNULL(ДанныеОтчета.Период, &amp;НачалоПериода), ГОД)
	КОНЕЦ КАК Период,
	СУММА(ДанныеОтчета.Сумма) КАК Сумма
{ВЫБРАТЬ
	Вид,
	Организация.*,
	Период,
	Сумма}
ИЗ
	Показатели КАК Показатели
		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			Расходы.Сумма КАК Сумма,
			Расходы.Период КАК Период,
			Расходы.Вид КАК Вид,
			Расходы.Организация КАК Организация
		{ВЫБРАТЬ
			Сумма,
			Период,
			Вид,
			Организация.*}
		ИЗ
			Расходы КАК Расходы
		
		ОБЪЕДИНИТЬ ВСЕ
		
		ВЫБРАТЬ
			Доходы.Сумма,
			Доходы.Период,
			Доходы.Вид,
			Доходы.Организация
		ИЗ
			Доходы КАК Доходы
		
		ОБЪЕДИНИТЬ ВСЕ
		
		ВЫБРАТЬ
			Доходы.Сумма,
			Доходы.Период,
			3,
			Доходы.Организация
		ИЗ
			Доходы КАК Доходы
		ГДЕ
			Доходы.Вид = 1
		
		ОБЪЕДИНИТЬ ВСЕ
		
		ВЫБРАТЬ
			-Расходы.Сумма,
			Расходы.Период,
			3,
			Расходы.Организация
		ИЗ
			Расходы КАК Расходы
		ГДЕ
			Расходы.Вид = 2
		
		ОБЪЕДИНИТЬ ВСЕ
		
		ВЫБРАТЬ
			ВЫБОР
				КОГДА Доходы.Вид = 5
					ТОГДА -Доходы.Сумма
				ИНАЧЕ Доходы.Сумма
			КОНЕЦ,
			Доходы.Период,
			6,
			Доходы.Организация
		ИЗ
			Доходы КАК Доходы
		ГДЕ
			&amp;ПрочиеДоходыИРасходы
		
		ОБЪЕДИНИТЬ ВСЕ
		
		ВЫБРАТЬ
			-Расходы.Сумма,
			Расходы.Период,
			6,
			Расходы.Организация
		ИЗ
			Расходы КАК Расходы
		ГДЕ
			&amp;ПрочиеДоходыИРасходы) КАК ДанныеОтчета
		ПО Показатели.Вид = ДанныеОтчета.Вид

СГРУППИРОВАТЬ ПО
	ДанныеОтчета.Организация,
	Показатели.Вид,
	ВЫБОР
		КОГДА &amp;Периодичность = 6
			ТОГДА НАЧАЛОПЕРИОДА(ЕСТЬNULL(ДанныеОтчета.Период, &amp;НачалоПериода), ДЕНЬ)
		КОГДА &amp;Периодичность = 7
			ТОГДА НАЧАЛОПЕРИОДА(ЕСТЬNULL(ДанныеОтчета.Период, &amp;НачалоПериода), НЕДЕЛЯ)
		КОГДА &amp;Периодичность = 8
			ТОГДА НАЧАЛОПЕРИОДА(ЕСТЬNULL(ДанныеОтчета.Период, &amp;НачалоПериода), ДЕКАДА)
		КОГДА &amp;Периодичность = 9
			ТОГДА НАЧАЛОПЕРИОДА(ЕСТЬNULL(ДанныеОтчета.Период, &amp;НачалоПериода), МЕСЯЦ)
		КОГДА &amp;Периодичность = 10
			ТОГДА НАЧАЛОПЕРИОДА(ЕСТЬNULL(ДанныеОтчета.Период, &amp;НачалоПериода), КВАРТАЛ)
		КОГДА &amp;Периодичность = 11
			ТОГДА НАЧАЛОПЕРИОДА(ЕСТЬNULL(ДанныеОтчета.Период, &amp;НачалоПериода), ПОЛУГОДИЕ)
		КОГДА &amp;Периодичность = 12
			ТОГДА НАЧАЛОПЕРИОДА(ЕСТЬNULL(ДанныеОтчета.Период, &amp;НачалоПериода), ГОД)
	КОНЕЦ</query>
