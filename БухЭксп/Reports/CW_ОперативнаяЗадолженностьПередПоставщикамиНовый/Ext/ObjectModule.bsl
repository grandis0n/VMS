			Поле.ОграничениеИспользованияРеквизитов.Группировка = Ложь;
			
			ПолеИтога = Схема.ПоляИтога.Добавить();
			ПолеИтога.ПутьКДанным = ИмяПоля;
			ПолеИтога.Выражение   = "Сумма(" + ИмяПоля + ")";
			
			БухгалтерскиеОтчетыКлиентСервер.ДобавитьВыбранноеПоле(ПапкаСПолямиИнтевал, ИмяПоля);
		КонецЕсли;
		
		
		Индекс = Индекс + 1;
		ЗначениеПоследнего = Интервал.Значение;
		
	КонецЦикла;
	
	ПапкаСПолямиИнтевал = ПапкаСПолями.Элементы.Добавить(Тип("ГруппаВыбранныхПолейКомпоновкиДанных"));
	ПапкаСПолямиИнтевал.Заголовок  = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Свыше %1 дней'"), Формат(ЗначениеПоследнего,"ЧГ=0"));
	
	Если ВыводитьСуммыВРублях Тогда
		ИмяПоля = "ОстатокДолгаРуб" + Индекс;
		Поле = Схема.НаборыДанных.ОсновнойНабор.Поля.Найти(ИмяПоля);
		Если Поле = Неопределено Тогда
			Поле = Схема.НаборыДанных.ОсновнойНабор.Поля.Добавить(Тип("ПолеНабораДанныхСхемыКомпоновкиДанных"));
