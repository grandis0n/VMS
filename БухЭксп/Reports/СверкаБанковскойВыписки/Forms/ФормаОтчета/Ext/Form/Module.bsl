#КонецОбласти

#Область ОбработчикиСобытийПоляТабличногоДокументаРезультат

&НаКлиенте
Процедура РезультатОбработкаРасшифровки(Элемент, Расшифровка, СтандартнаяОбработка, ДополнительныеПараметры) 
	
	СтандартнаяОбработка = Ложь;
	
	Если Элемент.ТекущаяОбласть.Текст = НСтр("ru = 'Нет данных. Загрузить'") Тогда
		ПараметрыФормы = Новый Структура;
		Расшифровка = Элемент.ТекущаяОбласть.Расшифровка;
		ИмяОбласти = Элемент.ТекущаяОбласть.Имя;
		Организация = ПараметрПриАктивизацииПоляРесурса(Расшифровка, "Организация");
		Если ЗначениеЗаполнено(Организация) Тогда
			ПараметрыФормы.Вставить("Организация", Организация);
		Иначе
			ПараметрыФормы.Вставить("Организация", ПараметрПриАктивизацииПоляРесурса(Расшифровка, "ВладелецСчета"));
		КонецЕсли;
		ПараметрыФормы.Вставить("БанковскийСчет", ПараметрПриАктивизацииПоляРесурса(Расшифровка, "БанковскийСчет"));
		ПараметрыФормы.Вставить("ДатаНачала", ДатаНетДанных(Расшифровка, ИмяОбласти, "ДатаНачала"));
		ПараметрыФормы.Вставить("ДатаОкончания", ДатаНетДанных(Расшифровка, ИмяОбласти, "ДатаОкончания"));
		ПараметрыФормы.Вставить("УИДВладельцаФормы", ЭтотОбъект.УникальныйИдентификатор);
		ОткрытьФорму("Отчет.СверкаБанковскойВыписки.Форма.ФормаЗагрузкиВыписки", ПараметрыФормы,,,,,,
			РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	Иначе
		СтруктураРасшифровки = ПолучитьРасшифровку(Расшифровка, ДанныеРасшифровки);
		Если ЗначениеЗаполнено(СтруктураРасшифровки.БанковскийСчет) Тогда
			ПараметрыОтчета = Новый Структура;
			ПараметрыОтчета.Вставить("БанковскийСчет", СтруктураРасшифровки.БанковскийСчет);
			Если ЗначениеЗаполнено(СтруктураРасшифровки.Организация) Тогда
				ПараметрыОтчета.Вставить("Организация", СтруктураРасшифровки.Организация);
			Иначе
				ПараметрыОтчета.Вставить("Организация", СтруктураРасшифровки.ВладелецСчета);
			КонецЕсли;
			Если СтруктураРасшифровки.Период <> Неопределено Тогда
				ПараметрыОтчета.Вставить("НачалоПериода", СтруктураРасшифровки.Период);
				ПараметрыОтчета.Вставить("КонецПериода", КонецДня(СтруктураРасшифровки.Период));
			Иначе
				ПараметрыОтчета.Вставить("НачалоПериода", Отчет.НачалоПериода);
				ПараметрыОтчета.Вставить("КонецПериода", Отчет.КонецПериода);
			КонецЕсли;
			ПараметрыОтчета.Вставить("ТолькоДниРасхождений", Отчет.ПоказательТолькоДниРасхождений);
			
			ОткрытьФорму("Отчет.РасшифровкаБанковскойВыписки.Форма.ФормаОтчета",
				ПараметрыОтчета,, Новый УникальныйИдентификатор);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РезультатОбработкаДополнительнойРасшифровки(Элемент, Расшифровка, СтандартнаяОбработка)
	
	// Не будем обрабатывать нажатие на правую кнопку мыши.
	// Покажем стандартное контекстное меню ячейки табличного документа.
	Расшифровка = Неопределено;
	
КонецПроцедуры

&НаКлиенте
Процедура РезультатПриАктивизации(Элемент)
	
	БухгалтерскиеОтчетыКлиент.НачатьРасчетСуммыВыделенныхЯчеек(Элементы.Результат, ЭтотОбъект,
		"Подключаемый_РезультатПриАктивизацииПодключаемый");
	
КонецПроцедуры

&НаСервере
Функция ДатаНетДанных(Расшифровка, ИмяОбласти, РасшифровкаПериод)
	
	Расшифровка = ОпределитьРасшифровкуОбласти(ИмяОбласти, РасшифровкаПериод);
	
	Дата = ПараметрПриАктивизацииПоляРесурса(Расшифровка, "Период");
	
	Возврат Дата;
КонецФункции

&НаСервере
Функция ОпределитьРасшифровкуОбласти(ИмяОбласти, РасшифровкаПериод)
	
	ИмяОбластиНачало    = ИмяОбласти;
	ИмяОбластиДляПоиска = ИмяОбласти;
	ОбластьРезультат    = Результат.Область(ИмяОбластиНачало);
	// Для верного определения диапазона дат перебираем поля начального остатка
	// со значением "Н/Д" или "Нет данных. Загрузить".
	Пока ОбластьРезультат.Текст = НСтр("ru = 'Нет данных. Загрузить'")
			ИЛИ ОбластьРезультат.Текст = НСтр("ru = 'Н/Д'") Цикл
		ИмяОбластиДляПоиска = ИмяОбластиНачало;
		Право = ОбластьРезультат.Право;
		Если РасшифровкаПериод = "ДатаНачала" Тогда
			Направление = -1;
		Иначе
			Направление = 1;
		КонецЕсли;
		Верх = ОбластьРезультат.Верх + Направление * 3;
		ИмяОбластиНачало = "R" + Формат(Верх, "ЧГ=0") + "C" + Формат(Право, "ЧГ=0");
		ОбластьРезультат = Результат.Область(ИмяОбластиНачало);
		// Нужно проверить данные в первой колонке на наличие даты, чтобы корректно высчитать диапазон дат.
		ТекстОбластиРезультата = Результат.Область(Верх - 1, Право - 2, Верх + 1, Право - 2).Текст;
		ОбработаннаяСтрока = СтрЗаменить(ТекстОбластиРезультата, ".", "");
		Если НЕ (СтрДлина(ОбработаннаяСтрока) = 8 И СтроковыеФункцииКлиентСервер.ТолькоЦифрыВСтроке(ОбработаннаяСтрока)) Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Расшифровка = Результат.Область(ИмяОбластиДляПоиска).Расшифровка;
	
	Возврат Расшифровка;
КонецФункции

&НаСервере
Функция ПараметрПриАктивизацииПоляРесурса(Расшифровка, Параметр)
	
	СтруктураРасшифровки = ПолучитьРасшифровку(Расшифровка, ДанныеРасшифровки);
	
	Возврат СтруктураРасшифровки[Параметр];
КонецФункции

&НаСервере
Функция ПолучитьРасшифровку(Расшифровка, ДанныеРасшифровки)
	
	ИдентификаторОбъекта = БухгалтерскиеОтчетыКлиентСервер.ИмяОтчетаПоИмениФормы(ЭтотОбъект);
	
	ПараметрыРасшифровки = Новый Структура;
	
	СтруктураРасшифровки = Отчеты[ИдентификаторОбъекта].ЗаполнитьПараметрыРасшифровкиОтчета(ДанныеРасшифровки,
		Расшифровка, ПараметрыРасшифровки);
	
	Возврат СтруктураРасшифровки;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ПодготовитьПараметрыОтчетаНаСервере()
	
	ПараметрыОтчета = Новый Структура;
	ПараметрыОтчета.Вставить("Организация"                      , Отчет.Организация);
	ПараметрыОтчета.Вставить("БанковскийСчет"                   , Отчет.БанковскийСчет);
	ПараметрыОтчета.Вставить("НачалоПериода"                    , Отчет.НачалоПериода);
	ПараметрыОтчета.Вставить("КонецПериода"                     , Отчет.КонецПериода);
	ПараметрыОтчета.Вставить("ВключатьОбособленныеПодразделения", Отчет.ВключатьОбособленныеПодразделения);
	ПараметрыОтчета.Вставить("ВсеДанные"                        , Ложь);
	ПараметрыОтчета.Вставить("ПоказательТолькоДниРасхождений"   , Отчет.ПоказательТолькоДниРасхождений);
	
	ПараметрыОтчета.Вставить("РежимРасшифровки"                 , Отчет.РежимРасшифровки);
	ПараметрыОтчета.Вставить("ДанныеРасшифровки"                , ДанныеРасшифровки);
	ПараметрыОтчета.Вставить("МакетОформления"                  , МакетОформления);
	ПараметрыОтчета.Вставить("СхемаКомпоновкиДанных"            , ПолучитьИзВременногоХранилища(СхемаКомпоновкиДанных));
	ПараметрыОтчета.Вставить("ИдентификаторОтчета"              , БухгалтерскиеОтчетыКлиентСервер.ПолучитьИдентификаторОбъекта(ЭтаФорма));
	ПараметрыОтчета.Вставить("КомпоновщикНастроек"              , Отчет.КомпоновщикНастроек);
	ПараметрыОтчета.Вставить("НастройкиКомпоновкиДанных"        , Отчет.КомпоновщикНастроек.ПолучитьНастройки());
	ПараметрыОтчета.Вставить("НаборПоказателей"                 , Отчеты[ПараметрыОтчета.ИдентификаторОтчета].ПолучитьНаборПоказателей());
	ПараметрыОтчета.Вставить("ВыводитьЕдиницуИзмерения"         , ВыводитьЕдиницуИзмерения);
	ПараметрыОтчета.Вставить("Группировка"                      , Отчет.Группировка.Выгрузить());
	
	Возврат ПараметрыОтчета;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьТекстЗаголовка(Форма)
	
	Отчет = Форма.Отчет;
	
	ЗаголовокОтчета = "Сверка банковской выписки" + БухгалтерскиеОтчетыКлиентСервер.ПолучитьПредставлениеПериода(Отчет.НачалоПериода, Отчет.КонецПериода);
	
	Если ЗначениеЗаполнено(Отчет.Организация) И Форма.ИспользуетсяНесколькоОрганизаций Тогда
		ЗаголовокОтчета = ЗаголовокОтчета + " " + БухгалтерскиеОтчетыВызовСервера.ПолучитьТекстОрганизация(Отчет.Организация, Отчет.ВключатьОбособленныеПодразделения);
	КонецЕсли;
	
	Форма.Заголовок = ЗаголовокОтчета;

КонецПроцедуры

