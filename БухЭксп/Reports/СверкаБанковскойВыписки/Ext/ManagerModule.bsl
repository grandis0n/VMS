	Возврат СуммыСписание;
КонецФункции

Функция ЕстьБанковскиеСчетаБезДанныхОбОстатках(Организация, БанковскийСчет, НачалоПериода, КонецПериода)
	
	ТекущаяДатаСеанса = ТекущаяДатаСеанса();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ЗагруженныеБанковскиеВыписки.БанковскийСчет КАК БанковскийСчет
		|ИЗ
		|	РегистрСведений.ЗагруженныеБанковскиеВыписки КАК ЗагруженныеБанковскиеВыписки
		|ГДЕ
		|	ЗагруженныеБанковскиеВыписки.БанковскийСчет = &БанковскийСчет
		|	И ЗагруженныеБанковскиеВыписки.Организация = &Организация
		|	И ЗагруженныеБанковскиеВыписки.ИсточникЗагрузки = ЗНАЧЕНИЕ(Перечисление.ИсточникиЗагрузкиБанковскихВыписок.СервисАУСН)
		|	И ЗагруженныеБанковскиеВыписки.Дата МЕЖДУ &НачалоПериода И &КонецПериода
		|	И ЗагруженныеБанковскиеВыписки.ДанныеОбОстаткахОтсутствуют";
	
	Если ЗначениеЗаполнено(НачалоПериода) Тогда
		Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Иначе
		Запрос.УстановитьПараметр("НачалоПериода", НачалоМесяца(ТекущаяДатаСеанса));
	КонецЕсли;
	
	Если ЗначениеЗаполнено(КонецПериода) Тогда
		Запрос.УстановитьПараметр("КонецПериода", КонецПериода);
	Иначе
		Запрос.УстановитьПараметр("КонецПериода", КонецДня(ТекущаяДатаСеанса));
	КонецЕсли;
	
	Если ЗначениеЗаполнено(БанковскийСчет) Тогда
		Запрос.УстановитьПараметр("БанковскийСчет", БанковскийСчет);
	Иначе
		Запрос.Текст = СтрЗаменить(
			Запрос.Текст, "ЗагруженныеБанковскиеВыписки.БанковскийСчет = &БанковскийСчет", "Истина");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Организация) Тогда
		Запрос.УстановитьПараметр("Организация", Организация);
	Иначе
		ДоступныеОрганизации = ОбщегоНазначенияБПВызовСервераПовтИсп.ВсеОрганизацииДанныеКоторыхДоступныПоRLS(Ложь);
		Запрос.Текст = СтрЗаменить(
			Запрос.Текст, "ЗагруженныеБанковскиеВыписки.Организация = &Организация",
			"ЗагруженныеБанковскиеВыписки.Организация В (&Организация)");
		Запрос.УстановитьПараметр("Организация", ДоступныеОрганизации);
	КонецЕсли;
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если НЕ РезультатЗапроса.Пустой() Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;
КонецФункции

