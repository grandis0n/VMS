&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	СформироватьПриОткрытии=Параметры.Свойство("Документ",Документ);
	Параметры.Свойство("ВерсияБюджета",ВерсияБюджета);
	Если ВерсияБюджета.Пустая() Тогда
		ВерсияБюджета = CW_Бюджетирование.ПолучитьОсновнуюВерсиюБюджета();
		ВерсияБюджета = ?(ЗначениеЗаполнено(ВерсияБюджета),ВерсияБюджета, Справочники.CW_ВерсииБюджетов.Основная);
	КонецЕсли; 
	
	ПравоДоступноПросмотрБюджетов = CW_ПраваДоступа.ПравоДоступно("ПросмотрБюджетов");
	ПравоДоступноРедактированиеБюджетов = CW_ПраваДоступа.ПравоДоступно("РедактированиеБюджетов");
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Элементы.ФормаНастройка.Пометка=Истина;
	
	Если СформироватьПриОткрытии Тогда
		
		_Настройка(Истина);
		СформироватьОтчет();
		
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура Сформировать(Команда)
	
	_Настройка(Истина);
	СформироватьОтчет();
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьОтчет()
	// --- 
	
	Если НЕ ЗначениеЗаполнено(Документ) Тогда 
		_УФК.ВывестиПредупреждение("Не выбран документ!");
		Возврат;
	КонецЕсли;
	
	// записываем настройки во временное хранилище
	Отчет.АдресНастроек = _ПолучитьАдресНастроек();
	ЭтаФорма.СкомпоноватьРезультат();
	// дорабатываем
	_Доработать();
	
	// --- 
КонецПроцедуры

&НаСервере
Функция _ПолучитьАдресНастроек()
	// --- 
	
	Настройки = _сф.ст_Создать("ВерсияБюджета,Документ");
	Настройки.Документ = Документ;
	Настройки.ВерсияБюджета = ВерсияБюджета;
	Возврат(ПоместитьВоВременноеХранилище(Настройки,ЭтаФорма.УникальныйИдентификатор));
	
	// --- 
КонецФункции

&НаСервере
Процедура _Доработать()
	// --- 
	
	CW_Отчеты.ЗаменитьТекстВТаблицеРезультата(Результат, "Контрагент:",   "Клиент:"     ,                                   , 8);
	CW_Отчеты.ЗаменитьТекстВТаблицеРезультата(Результат, "Итого",        "ИТОГО:");
	CW_Отчеты.УжатьПоВысотеСтрокиПередИПослеЗаголовка(Результат);
	
	// --- 
КонецПроцедуры

// ---------------------------------------------------------------------------- 

&НаКлиенте
Процедура Настройка(Команда)
	
	_Настройка(); 
	
КонецПроцедуры

&НаСервере
Процедура _Настройка(Скрыть=Ложь)
	// --- 
	
	Если Скрыть Тогда
		
		Элементы.ГруппаНастройкиОтчета.Видимость = Ложь;
		Элементы.ФормаНастройка.Пометка=Ложь;
		
	Иначе
		
		Если Элементы.ГруппаНастройкиОтчета.Видимость Тогда
			
			Элементы.ГруппаНастройкиОтчета.Видимость = Ложь;
			Элементы.ФормаНастройка.Пометка=Ложь;
			
		Иначе
			
			Элементы.ГруппаНастройкиОтчета.Видимость = Истина;
			Элементы.ФормаНастройка.Пометка=Истина;
			
		КонецЕсли; 
		
	КонецЕсли; 
		
	// --- 
КонецПроцедуры

