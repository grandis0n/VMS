		<query>ВЫБРАТЬ РАЗРЕШЕННЫЕ
	CW_РасходыПоГрузоперевозкеУслуги.НомерСтроки,
	CW_РасходыПоГрузоперевозкеУслуги.Ссылка.Контрагент,
	CW_РасходыПоГрузоперевозкеУслуги.Грузоперевозка,
	CW_РасходыПоГрузоперевозкеУслуги.Ссылка.Валюта,
	CW_РасходыПоГрузоперевозкеУслуги.Номенклатура,
	CW_РасходыПоГрузоперевозкеУслуги.СтавкаНДС,
	CW_РасходыПоГрузоперевозкеУслуги.Всего КАК ВсегоПоДокументу
ПОМЕСТИТЬ ТабличнаяЧасть
ИЗ
	Документ.CW_РасходыПоГрузоперевозке.Услуги КАК CW_РасходыПоГрузоперевозкеУслуги
ГДЕ
	CW_РасходыПоГрузоперевозкеУслуги.Ссылка = &amp;Документ
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	CW_ПлановыеСтатьиЗатратИДоходов.Контрагент,
	CW_ПлановыеСтатьиЗатратИДоходов.Владелец КАК Грузоперевозка,
	CW_ПлановыеСтатьиЗатратИДоходов.Валюта,
	CW_ПлановыеСтатьиЗатратИДоходов.Номенклатура,
	CW_ПлановыеСтатьиЗатратИДоходов.СтавкаНДС,
	СУММА(CW_ПлановыеСтатьиЗатратИДоходов.СуммаВсего) КАК ВсегоПоБюджету,
	CW_ПлановыеСтатьиЗатратИДоходов.Ссылка
ПОМЕСТИТЬ Бюджет
ИЗ
	Справочник.CW_ПлановыеСтатьиЗатратИДоходов КАК CW_ПлановыеСтатьиЗатратИДоходов
ГДЕ
	CW_ПлановыеСтатьиЗатратИДоходов.Владелец В(&amp;Грузоперевозки)
	И CW_ПлановыеСтатьиЗатратИДоходов.ВидСтатьиПланирования = &amp;ВидСтатьиПланирования
	И CW_ПлановыеСтатьиЗатратИДоходов.ВерсияБюджета = &amp;ВерсияБюджета
	И CW_ПлановыеСтатьиЗатратИДоходов.Контрагент = &amp;Контрагент
	И CW_ПлановыеСтатьиЗатратИДоходов.Валюта = &amp;Валюта
	И CW_ПлановыеСтатьиЗатратИДоходов.Организация = &amp;Организация

СГРУППИРОВАТЬ ПО
	CW_ПлановыеСтатьиЗатратИДоходов.Контрагент,
	CW_ПлановыеСтатьиЗатратИДоходов.Номенклатура,
	CW_ПлановыеСтатьиЗатратИДоходов.СтавкаНДС,
	CW_ПлановыеСтатьиЗатратИДоходов.Владелец,
	CW_ПлановыеСтатьиЗатратИДоходов.Валюта,
	CW_ПлановыеСтатьиЗатратИДоходов.Ссылка
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	CW_ЗатратыПоГрузоперевозкам.Контрагент,
	CW_ЗатратыПоГрузоперевозкам.Грузоперевозка,
	CW_ЗатратыПоГрузоперевозкам.Валюта,
	CW_ЗатратыПоГрузоперевозкам.Номенклатура,
	CW_ЗатратыПоГрузоперевозкам.СтавкаНДС,
	СУММА(CW_ЗатратыПоГрузоперевозкам.Всего_Валюта) КАК ВсегоПоПрочим
ПОМЕСТИТЬ ПрочиеДокументы
ИЗ
	РегистрНакопления.CW_РасходыПоГрузоперевозкам КАК CW_ЗатратыПоГрузоперевозкам
ГДЕ
	CW_ЗатратыПоГрузоперевозкам.Грузоперевозка В(&amp;Грузоперевозки)
	И CW_ЗатратыПоГрузоперевозкам.Контрагент = &amp;Контрагент
	И CW_ЗатратыПоГрузоперевозкам.Валюта = &amp;Валюта
	И CW_ЗатратыПоГрузоперевозкам.ДокументРасходов.Организация = &amp;Организация
	И CW_ЗатратыПоГрузоперевозкам.ДокументРасходов &lt;&gt; &amp;Документ

СГРУППИРОВАТЬ ПО
	CW_ЗатратыПоГрузоперевозкам.Контрагент,
	CW_ЗатратыПоГрузоперевозкам.Валюта,
	CW_ЗатратыПоГрузоперевозкам.Номенклатура,
	CW_ЗатратыПоГрузоперевозкам.Грузоперевозка,
	CW_ЗатратыПоГрузоперевозкам.СтавкаНДС
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ТабличнаяЧасть.НомерСтроки,
	ТабличнаяЧасть.Контрагент,
	ТабличнаяЧасть.Грузоперевозка,
	ТабличнаяЧасть.Валюта,
	ТабличнаяЧасть.Номенклатура,
	ТабличнаяЧасть.СтавкаНДС,
	ТабличнаяЧасть.ВсегоПоДокументу,
	Бюджет.ВсегоПоБюджету,
	ПрочиеДокументы.ВсегоПоПрочим,
	Бюджет.Ссылка
ПОМЕСТИТЬ Результат
ИЗ
	ТабличнаяЧасть КАК ТабличнаяЧасть
		ЛЕВОЕ СОЕДИНЕНИЕ Бюджет КАК Бюджет
		ПО ТабличнаяЧасть.Контрагент = Бюджет.Контрагент
			И ТабличнаяЧасть.Грузоперевозка = Бюджет.Грузоперевозка
			И ТабличнаяЧасть.Валюта = Бюджет.Валюта
			И ТабличнаяЧасть.Номенклатура = Бюджет.Номенклатура
			И ТабличнаяЧасть.СтавкаНДС = Бюджет.СтавкаНДС
		ЛЕВОЕ СОЕДИНЕНИЕ ПрочиеДокументы КАК ПрочиеДокументы
		ПО ТабличнаяЧасть.Контрагент = ПрочиеДокументы.Контрагент
			И ТабличнаяЧасть.Грузоперевозка = ПрочиеДокументы.Грузоперевозка
			И ТабличнаяЧасть.Валюта = ПрочиеДокументы.Валюта
			И ТабличнаяЧасть.Номенклатура = ПрочиеДокументы.Номенклатура
			И ТабличнаяЧасть.СтавкаНДС = ПрочиеДокументы.СтавкаНДС
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	Результат.НомерСтроки КАК НомерСтроки,
	Результат.Контрагент,
	Результат.Грузоперевозка,
	Результат.Валюта,
	Результат.Номенклатура,
	Результат.СтавкаНДС,
	Результат.ВсегоПоДокументу,
	ЕСТЬNULL(Результат.ВсегоПоБюджету, 0) КАК ВсегоПоБюджету,
	ЕСТЬNULL(Результат.ВсегоПоПрочим, 0) КАК ВсегоПоПрочимДокументам,
	Результат.Ссылка
ИЗ
	Результат КАК Результат

УПОРЯДОЧИТЬ ПО
	НомерСтроки</query>
