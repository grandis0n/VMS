&НаКлиенте
Процедура ОтправитьПоЭлектроннойПочте(Команда)
	
// проверяем учётную запись пользователя
	Если (НЕ _ЕстьУчетнаяЗаписьПользователя()) Тогда
		
		_УФК.ВывестиПредупреждение("У текущего пользователя не задана учетная запись электронной почты!" + Символы.ПС + """Настройки пользователя"" --> ""Сервис"" --> ""Учетная запись электронной почты""");
		Возврат;
		
	КонецЕсли; 
	
	ПФ = Новый Структура("СтруктураПисьма",СформироватьПисьмо());
    ОткрытьФорму("Обработка.CW_ОтправкаПочты.Форма.Форма", ПФ);
	
КонецПроцедуры

&НаСервере
Функция _ЕстьУчетнаяЗаписьПользователя()
	
	УчетнуюЗапись = _ЭП.ПолучитьУчетнуюЗаписьТекущегоПользователя();
	Возврат УчетнуюЗапись <> Неопределено; 
	
КонецФункции

&НаСервере
Функция СформироватьПисьмо()
	
	СП = _ЭП.СтруктураПисьма();
	// --- 
	НастройкиПользователя = CW_Настройки.ПолучитьНастройкиПользователя();
	Учетка = НастройкиПользователя;
	СП.Отправитель = Учетка.УчетнаяЗаписьЭлектроннойПочты;
	// --- 
	
	// --- 
	
	СП.Тема = "";
	_ЭП.ДобавитьТекст(СП,"");
	
	// --- 
	//_ЭП.ДобавитьПолучателейИзСтроки(СП.Получатели,Получатели);
	// --- 
	Если Учетка.СкрытаяКопияСебе Тогда
		_ЭП.ДобавитьПолучателейИзСтроки(СП.Получатели_СкрытыеКопии,Учетка.УчетнаяЗаписьЭлектроннойПочты.ПочтовыйАдрес);
	КонецЕсли;
	// --- 
	
	// добавляем отчет в формате excel
	ИмяФайла = ПолучитьИмяВременногоФайла("xls");
	Результат.Записать(ИмяФайла,ТипФайлаТабличногоДокумента.XLS);
	_ЭП.ДобавитьВложение(СП,ИмяФайла,"путь",ИмяФайла);
	
	// ---------------------------------------------------------------------------- 
	
	Возврат(ПоместитьВоВременноеХранилище(СП,ЭтаФорма.УникальныйИдентификатор));
	
КонецФункции



