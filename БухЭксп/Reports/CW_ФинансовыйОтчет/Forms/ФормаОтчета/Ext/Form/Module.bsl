&НаСервере
Процедура _ВосстановитьСеансовуюНастройку()
	
	Идентификатор = РеквизитФормыВЗначение("Отчет").Метаданные().Имя;
	СеансоваяНастройка = ХранилищеСистемныхНастроек.Загрузить(Идентификатор, "Сеансовая");
	Если СеансоваяНастройка <> Неопределено Тогда
		Попытка
			СеансоваяНастройка.Свойство("Организация", Организация);
			СеансоваяНастройка.Свойство("ФормированиеОтчета", ФормированиеОтчета);
			// --- 
			СеансоваяНастройка.Свойство("ВыводитьЗаголовок", ВыводитьЗаголовок);
			СеансоваяНастройка.Свойство("ВыводитьФинансовыеПоказатели", ВыводитьФинансовыеПоказатели);
			СеансоваяНастройка.Свойство("ВыводитьФинансовыеПоказателиПоСчетам", ВыводитьФинансовыеПоказателиПоСчетам);
			СеансоваяНастройка.Свойство("ВыводитьФинансовыеПоказателиПоАктам", ВыводитьФинансовыеПоказателиПоАктам);
			СеансоваяНастройка.Свойство("ВыводитьФинансовыеПоказателиПоБюджету", ВыводитьФинансовыеПоказателиПоБюджету);
			СеансоваяНастройка.Свойство("КомментироватьФинансовыеПоказатели", КомментироватьФинансовыеПоказатели);
			// --- 
			СеансоваяНастройка.Свойство("ВерсияБюджета", ВерсияБюджета);
			Если НЕ ЗначениеЗаполнено(ВерсияБюджета) Тогда
				ВерсияБюджета = _ПолучитьБазовуюВерсиюБюджета();
			КонецЕсли;				
			СеансоваяНастройка.Свойство("ДетализироватьДоходы", ДетализироватьДоходы);
			СеансоваяНастройка.Свойство("ДетализироватьРасходы", ДетализироватьРасходы);
			СеансоваяНастройка.Свойство("ДетализироватьФинансовыйРезультат", ДетализироватьФинансовыйРезультат);
			СеансоваяНастройка.Свойство("РежимВалют", РежимВалют);
			СеансоваяНастройка.Свойство("Валюты", Валюты);
			СеансоваяНастройка.Свойство("ОпределениеКурса", ОпределениеКурса);
			СеансоваяНастройка.Свойство("КонтрольнаяДата", КД);
		Исключение
		КонецПопытки; 
	КонецЕсли;      
	
	ОбновитьСписокДоступныхВалют();
	
КонецПроцедуры 

&НаСервере
Процедура ОбновитьСписокДоступныхВалют() 
	
	RUB = Справочники.Валюты.НайтиПоКоду("643");   
	
	мИсключения = Валюты.ВыгрузитьЗначения(); 
	Если Не RUB.Пустая() Тогда
		мИсключения.Добавить(RUB);
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Валюты.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.Валюты КАК Валюты
	               |ГДЕ
	               |	Валюты.ПометкаУдаления = ЛОЖЬ
	               |	И НЕ Валюты.Ссылка В (&мИсключения)";  
	
	Запрос.УстановитьПараметр("мИсключения", мИсключения);

	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		Валюты.Добавить(Выборка.Ссылка, , Истина);
	КонецЦикла;   
	
	Валюты.СортироватьПоЗначению(НаправлениеСортировки.Возр);
	
КонецПроцедуры

&НаСервере
Процедура _СохранитьСеансовуюНастройку()
	
	СтруктураНастройки = Новый Структура();
	СтруктураНастройки.Вставить("Организация", Организация);
	СтруктураНастройки.Вставить("ФормированиеОтчета", ФормированиеОтчета);
	// --- 
	СтруктураНастройки.Вставить("ВыводитьЗаголовок",ВыводитьЗаголовок);
	СтруктураНастройки.Вставить("ВыводитьФинансовыеПоказатели",ВыводитьФинансовыеПоказатели);
	СтруктураНастройки.Вставить("ВыводитьФинансовыеПоказателиПоСчетам", ВыводитьФинансовыеПоказателиПоСчетам);
	СтруктураНастройки.Вставить("ВыводитьФинансовыеПоказателиПоАктам", ВыводитьФинансовыеПоказателиПоАктам);
	СтруктураНастройки.Вставить("ВыводитьФинансовыеПоказателиПоБюджету", ВыводитьФинансовыеПоказателиПоБюджету);
	СтруктураНастройки.Вставить("КомментироватьФинансовыеПоказатели",КомментироватьФинансовыеПоказатели);
	// --- 
	СтруктураНастройки.Вставить("ВерсияБюджета", ВерсияБюджета);	
	СтруктураНастройки.Вставить("ДетализироватьДоходы", ДетализироватьДоходы);
	СтруктураНастройки.Вставить("ДетализироватьРасходы", ДетализироватьРасходы);
	СтруктураНастройки.Вставить("ДетализироватьФинансовыйРезультат", ДетализироватьФинансовыйРезультат);
	СтруктураНастройки.Вставить("РежимВалют", РежимВалют);
	СтруктураНастройки.Вставить("Валюты", Валюты);
	СтруктураНастройки.Вставить("ОпределениеКурса", ОпределениеКурса);
	СтруктураНастройки.Вставить("КонтрольнаяДата", КД);
	
	Идентификатор = РеквизитФормыВЗначение("Отчет").Метаданные().Имя;
	ХранилищеСистемныхНастроек.Сохранить(Идентификатор, "Сеансовая", СтруктураНастройки);
	
КонецПроцедуры

