&НаСервере
Функция ПроверитьПараметры()
	
	Рез = Истина;
	
	Если РежимВалют = 1 И ОпределениеКурса = 1 И НЕ ЗначениеЗаполнено(КД) Тогда
		Сообщить("Не выбрана контрольная дата!");
		Рез = Ложь;			
	КонецЕсли;	
	
	Возврат Рез;
	
КонецФункции	

&НаСервере
Функция ОпределитьДатуКурса(ГП)
	
	Если КД = "Реквизит.ДатаЗакрытия" Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	CW_ЗакрытиеФинансов.ДатаЗакрытия КАК Дата
			|ИЗ
			|	РегистрСведений.CW_ЗакрытиеФинансов КАК CW_ЗакрытиеФинансов
			|ГДЕ
			|	(CW_ЗакрытиеФинансов.Аналитика = &ГП
			|			ИЛИ CW_ЗакрытиеФинансов.Аналитика = &Заказ)";
		Запрос.УстановитьПараметр("Заказ", ГП.Заказ);
		Запрос.УстановитьПараметр("ГП", ГП);
		ТЗ = Запрос.Выполнить().Выгрузить();
	ИначеЕсли КД = "Реквизит.ДатаСделкиФ" Тогда
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ
			|	CW_Грузоперевозки.ДатаСделкиФ КАК Дата
			|ИЗ
			|	Справочник.CW_Грузоперевозки КАК CW_Грузоперевозки
			|ГДЕ
			|	CW_Грузоперевозки.Ссылка = &ГП";
		Запрос.УстановитьПараметр("ГП", ГП);
		ТЗ = Запрос.Выполнить().Выгрузить();
	Иначе
		Параметр = ПланыВидовХарактеристик.CW_ПараметрыГрузоперевозок.НайтиПоКоду(КД);
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ
			|	CW_ГрузоперевозкиПараметрыОбъекта.Значение КАК Дата
			|ИЗ
			|	Справочник.CW_Грузоперевозки.ПараметрыГрузоперевозки КАК CW_ГрузоперевозкиПараметрыОбъекта
			|ГДЕ
			|	CW_ГрузоперевозкиПараметрыОбъекта.Параметр = &Параметр
			|	И CW_ГрузоперевозкиПараметрыОбъекта.Ссылка = &ГП";
		Запрос.УстановитьПараметр("Параметр", Параметр);
		Запрос.УстановитьПараметр("ГП", ГП);
		ТЗ = Запрос.Выполнить().Выгрузить();
	КонецЕсли;
	
	Если ТЗ.Количество() > 0 Тогда
		Возврат ТЗ[0].Дата;	
	Иначе
		Возврат '00010101';
	КонецЕсли;	
	
КонецФункции	

