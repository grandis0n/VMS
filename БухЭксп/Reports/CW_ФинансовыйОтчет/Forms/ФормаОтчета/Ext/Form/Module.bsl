&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("Журнал") И Параметры.Свойство("ОписаниеКолонок") Тогда
		Параметры.Свойство("Журнал", Отчет.АдресЖурналаПереданый);
		Параметры.Свойство("ОписаниеКолонок", АдрОписаниеКолонок);
		Журнал = ПолучитьИзВременногоХранилища(Отчет.АдресЖурналаПереданый);
		//Для Инд = 1 по 6 Цикл
		//	Журнал.Колонки.Удалить(0);
		//КонецЦикла;			
		ОписаниеКолонок = ПолучитьИзВременногоХранилища(АдрОписаниеКолонок);
		Отчет.АдресЖурналаПереданый = ПоместитьВоВременноеХранилище(Журнал, Новый УникальныйИдентификатор());
		АдрОписаниеКолонок = ПоместитьВоВременноеХранилище(ОписаниеКолонок, ЭтаФорма.УникальныйИдентификатор);		
	Иначе
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	флАнализЭкономикиГрузоперевозок	= CW_ПраваДоступа.ПравоДоступно("АнализЭкономикиГрузоперевозок", ПараметрыСеанса.ТекущийПользователь);
	
	Элементы.ВыводитьФинансовыеПоказатели.Доступность = флАнализЭкономикиГрузоперевозок;
	
	Если Не флАнализЭкономикиГрузоперевозок Тогда
		ВыводитьФинансовыеПоказатели = Ложь;
	КонецЕсли;
	
	Если (НЕ ПолучитьФункциональнуюОпцию("CW_ИспользованиеБюджетирования")) Тогда
		Элементы.ВерсияБюджета.Видимость = Ложь;
		Элементы.ВыводитьФинансовыеПоказателиПоБюджету.Доступность=Ложь;
	КонецЕсли;	
	
	СЗ = _ПолучитьСписокКД();
	Для Каждого Стр Из СЗ Цикл
		Элементы.КД.СписокВыбора.Добавить(Стр.Значение, Стр.Представление, , Стр.Картинка);
	КонецЦикла; 
	
	ВерсияБюджета = _ПолучитьБазовуюВерсиюБюджета();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	_ВосстановитьСеансовуюНастройку();	
	
	Если (ВыводитьФинансовыеПоказатели И (НЕ ВыводитьФинансовыеПоказателиПоСчетам И НЕ ВыводитьФинансовыеПоказателиПоАктам И НЕ ВыводитьФинансовыеПоказателиПоБюджету)) Тогда
		ВыводитьФинансовыеПоказатели = Ложь;
	КонецЕсли;	
	
	_ПраваДоступа();
	УправлениеВидимостью();
	
	_Сформировать();
	
КонецПроцедуры

&НаСервере
Функция _ПраваДоступа()
	// --- 
	
	ПравоФинансы = CW_ПраваДоступа.ПравоДоступно("АнализЭкономикиГрузоперевозок");;
	Если (НЕ ПравоФинансы) Тогда
		ВыводитьФинансовыеПоказатели = Ложь;
	КонецЕсли; 
	Элементы.ВыводитьФинансовыеПоказатели.Видимость = ПравоФинансы;
	
	// --- 
КонецФункции
 

&НаСервере
Процедура УправлениеВидимостью()

	Элементы.ГруппаОтбор.Видимость = ВыводитьФинансовыеПоказатели;
	Элементы.ГруппаФО.Видимость = ВыводитьФинансовыеПоказатели;
	Элементы.ГруппаДетализация.Видимость = ВыводитьФинансовыеПоказатели;
	Элементы.ГруппаВалюты.Видимость = ВыводитьФинансовыеПоказатели;
	
	// --- 
	
	Элементы.ВерсияБюджета.Видимость = ВыводитьФинансовыеПоказателиПоБюджету;

	Элементы.Валюты.Видимость = ?(РежимВалют = 1, Истина, Ложь);
	Элементы.ОпределениеКурса.Видимость = ?(РежимВалют = 1, Истина, Ложь);
	Элементы.КД.Видимость = ?(РежимВалют = 1, Истина, Ложь) И ?(ОпределениеКурса = 1, Истина, Ложь);	
	
КонецПроцедуры

&НаКлиенте
Процедура ВерсияБюджетаПриИзменении(Элемент)
		
	Если НЕ ЗначениеЗаполнено(ВерсияБюджета) Тогда
		ВерсияБюджета = _ПолучитьБазовуюВерсиюБюджета();
	КонецЕсли;	
	
КонецПроцедуры

&НаСервере
Функция _ПолучитьБазовуюВерсиюБюджета()
	
	тВерсияБюджета = CW_Бюджетирование.ПолучитьОсновнуюВерсиюБюджета();
	тВерсияБюджета = ?(ЗначениеЗаполнено(тВерсияБюджета), тВерсияБюджета, Справочники.CW_ВерсииБюджетов.Основная);
	
	Возврат тВерсияБюджета;
	
КонецФункции

&НаКлиенте
Процедура ПереключателиПриИзменении(Элемент)
	
	Если ФормированиеОтчета = 2 И РежимВалют = 1 Тогда
		ОпределениеКурса = 1;
	КонецЕсли;	
	
	УправлениеВидимостью();
	
КонецПроцедуры

&НаСервере
Функция _ПолучитьСписокКД() 

	СЗ = Новый СписокЗначений;
	СЗ.Добавить("Реквизит.ДатаСделкиФ",  "Дата грузоперевозки", , БиблиотекаКартинок.CW_Грузоперевозки);
	СЗ.Добавить("Реквизит.ДатаЗакрытия", "Дата блокировки", ,     БиблиотекаКартинок.CW_Грузоперевозки);
			
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	CW_ПараметрыГрузоперевозок.Ссылка,
		|	CW_ПараметрыГрузоперевозок.Наименование,
		|	CW_ПараметрыГрузоперевозок.ТипЗначения,
		|	CW_ПараметрыГрузоперевозок.Код
		|ИЗ
		|	ПланВидовХарактеристик.CW_ПараметрыГрузоперевозок КАК CW_ПараметрыГрузоперевозок
		|ГДЕ
		|	НЕ CW_ПараметрыГрузоперевозок.ЭтоГруппа
		|	И CW_ПараметрыГрузоперевозок.ЭтоКонтрольнаяДата = ИСТИНА";
	ТЗ = Запрос.Выполнить().Выгрузить();
	
	Для Каждого Стр из ТЗ Цикл
		СЗ.Добавить(Стр.Код, "(П) " + Стр.Наименование, , БиблиотекаКартинок.ДиаграммаГанта);
	КонецЦикла;
	
	Возврат СЗ;

КонецФункции

