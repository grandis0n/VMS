Процедура Сформировать(Команда)
	
	_Сформировать();

КонецПроцедуры

&НаСервере
Процедура _Сформировать()
	
	Результат.Очистить();
	_Настройка(Истина);
	
	ПодготовитьОтчет();
	СформироватьОтчет();
	ОбработатьОтчет();
	
КонецПроцедуры

