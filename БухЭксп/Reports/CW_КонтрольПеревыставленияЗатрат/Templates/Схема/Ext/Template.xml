		<query>ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ЕСТЬNULL(CW_Перевыставление.Договор.Организация, ХозрасчетныйОстатки.Организация) КАК Организация,
	ЕСТЬNULL(CW_Перевыставление.Контрагент, ХозрасчетныйОстатки.Субконто1) КАК Контрагент,
	ЕСТЬNULL(CW_Перевыставление.Договор.УчетныйДоговор, ХозрасчетныйОстатки.Субконто2) КАК Договор,
	СУММА(ЕСТЬNULL(CW_Перевыставление.ВсегоОстаток, 0)) КАК ОстатокПоРегистру,
	СУММА(ЕСТЬNULL(ХозрасчетныйОстатки.СуммаОстаток, 0)) КАК ОстатокПоСчету,
	СУММА(ЕСТЬNULL(ХозрасчетныйОстатки.СуммаОстаток, 0) - ЕСТЬNULL(CW_Перевыставление.ВсегоОстаток, 0)) КАК Отклонение
ПОМЕСТИТЬ ВТ
ИЗ
	РегистрНакопления.CW_Перевыставление.Остатки(, ) КАК CW_Перевыставление
		ПОЛНОЕ СОЕДИНЕНИЕ РегистрБухгалтерии.Хозрасчетный.Остатки(, Счет = ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.РасчетыСПрочимиПоставщикамиИПодрядчиками), , ) КАК ХозрасчетныйОстатки
		ПО CW_Перевыставление.Контрагент = ХозрасчетныйОстатки.Субконто1
			И CW_Перевыставление.Договор.УчетныйДоговор = ХозрасчетныйОстатки.Субконто2
			И CW_Перевыставление.Договор.Организация = ХозрасчетныйОстатки.Организация

СГРУППИРОВАТЬ ПО
	ЕСТЬNULL(CW_Перевыставление.Договор.УчетныйДоговор, ХозрасчетныйОстатки.Субконто2),
	ЕСТЬNULL(CW_Перевыставление.Контрагент, ХозрасчетныйОстатки.Субконто1),
	ЕСТЬNULL(CW_Перевыставление.Договор.Организация, ХозрасчетныйОстатки.Организация)
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВТ.Организация,
	ВТ.Контрагент,
	ВТ.Договор,
	ВТ.ОстатокПоРегистру,
	ВТ.ОстатокПоСчету,
	ВТ.Отклонение
ИЗ
	ВТ КАК ВТ
ГДЕ
	ВЫБОР
			КОГДА &amp;ТолькоОтклонение
				ТОГДА ВТ.Отклонение &lt;&gt; 0
			ИНАЧЕ ИСТИНА
		КОНЕЦ
{ХАРАКТЕРИСТИКИ
	ТИП(Справочник.CW_Грузоперевозки)
	ВИДЫХАРАКТЕРИСТИК ПланВидовХарактеристик.CW_ПараметрыГрузоперевозок
	ПОЛЕКЛЮЧА Ссылка
	ПОЛЕИМЕНИ Идентификатор
	ПОЛЕТИПАЗНАЧЕНИЯ ТипЗначения
	ЗНАЧЕНИЯХАРАКТЕРИСТИК РегистрСведений.CW_ХарактеристикиГрузоперевозок
	ПОЛЕОБЪЕКТА Грузоперевозка
	ПОЛЕВИДА Параметр
	ПОЛЕЗНАЧЕНИЯ Значение }
{ХАРАКТЕРИСТИКИ
	ТИП(Справочник.CW_Грузоперевозки)
	ВИДЫХАРАКТЕРИСТИК ПланВидовХарактеристик.CW_ПараметрыГрузоперевозок
	ПОЛЕКЛЮЧА Ссылка
	ПОЛЕИМЕНИ ИдентификаторФакт
	ПОЛЕТИПАЗНАЧЕНИЯ ТипЗначения
	ЗНАЧЕНИЯХАРАКТЕРИСТИК РегистрСведений.CW_ХарактеристикиГрузоперевозок
	ПОЛЕОБЪЕКТА Грузоперевозка
	ПОЛЕВИДА Параметр
	ПОЛЕЗНАЧЕНИЯ ЗначениеФакт }
{ХАРАКТЕРИСТИКИ
	ТИП(Справочник.CW_Грузоперевозки)
	ВИДЫХАРАКТЕРИСТИК ПланВидовХарактеристик.CW_ПараметрыГрузоперевозок
