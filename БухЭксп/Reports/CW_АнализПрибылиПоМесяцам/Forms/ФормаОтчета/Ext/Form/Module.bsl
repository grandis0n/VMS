&НаСервере
Функция _УправлениеЭлементамиФормы()
	// --- 
	
	Если (ИспользованиеБюджетирования) Тогда
		
		ЕстьПлан = Ложь;
		Для каждого Стр Из Разделы Цикл
			
			Если ((Стр.Значение = "План" ИЛИ Стр.Значение = "Отклонение") И Стр.Пометка) Тогда
				
				ЕстьПлан = Истина;
				Прервать;
				
			КонецЕсли; 
			
		КонецЦикла; 
		Элементы.ВерсияБюджета.Видимость = ЕстьПлан;
		
	КонецЕсли; 
	
	// --- 
КонецФункции
 

&НаКлиенте
Процедура Сформировать(Команда)
	
	_Настройка(Истина);
	СформироватьОтчет();
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьОтчет()
	// --- 
	
	Раздел = Ложь;
	Для Каждого Стр из Разделы Цикл
		Раздел = ?(Стр.Пометка, Истина, Раздел);
	КонецЦикла;
	Если НЕ Раздел Тогда
		_УФК.ВывестиПредупреждение("Не отмечено ни одного раздела!");
		Возврат;		
	КонецЕсли;	
	
	Показатель = Ложь;
	Для Каждого Стр из Показатели Цикл
		Показатель = ?(Стр.Пометка, Истина, Показатель);
	КонецЦикла;
	Если НЕ Показатель Тогда
		_УФК.ВывестиПредупреждение("Не отмечено ни одного показателя!");
		Возврат;		
	КонецЕсли;	
	
	// записываем настройки во временное хранилище
	Отчет.АдресНастроек = _ПолучитьАдресНастроек();
	ЭтаФорма.СкомпоноватьРезультат();
	ОбработатьОтчет();
	
	// --- 
	_СохранитьСеансовуюНастройку();
	
	// --- 
КонецПроцедуры

&НаСервере
Функция _ПолучитьАдресНастроек()
	// --- 
	
	Настройки = _сф.ст_Создать("ВариантФормирования,НачалоПериода,КонецПериода,ВерсияБюджета,Организация,ВыводитьРасходыДоходы,ДатаОпределенияПрибыли,Показатели,Разделы,Группировки,ИсключатьВнутрихолдинговыеВзаиморасчеты,ПорядокОтражения");
	Настройки.ВариантФормирования = ВариантФормирования;
	Настройки.ВыводитьРасходыДоходы = ВыводитьРасходыДоходы;
	Настройки.НачалоПериода = НачалоПериода;
	Настройки.КонецПериода = КонецПериода;
	Настройки.ВерсияБюджета = ВерсияБюджета;
	Настройки.Организация = Организация;
	Настройки.Показатели = Показатели;
	Настройки.Разделы = Разделы;
	Настройки.Группировки = Группировки.Выгрузить();
	Настройки.ДатаОпределенияПрибыли=ДатаОпределенияПрибыли;
	Настройки.ИсключатьВнутрихолдинговыеВзаиморасчеты = ИсключатьВнутрихолдинговыеВзаиморасчеты;
	Настройки.ПорядокОтражения = ПорядокОтражения;
	
	Возврат(ПоместитьВоВременноеХранилище(Настройки,ЭтаФорма.УникальныйИдентификатор));
	
	// --- 
КонецФункции

&НаСервере
Процедура ОбработатьОтчет()
	
	CW_Отчеты.ЗаменитьТекстВТаблицеРезультата(Результат, "0:00:00", "");
	CW_Отчеты.ЗаменитьТекстВТаблицеРезультата(Результат, "23:59:59", "");
	CW_Отчеты.ЗаменитьТекстВТаблицеРезультата(Результат, "План", "План", ГоризонтальноеПоложение.Центр);
	CW_Отчеты.ЗаменитьТекстВТаблицеРезультата(Результат, "Факт", "Факт", ГоризонтальноеПоложение.Центр);
	CW_Отчеты.ЗаменитьТекстВТаблицеРезультата(Результат, "Отклонение", "Отклонение", ГоризонтальноеПоложение.Центр);
	CW_Отчеты.ЗаменитьТекстВТаблицеРезультата(Результат, "Расходы", "Расходы", ГоризонтальноеПоложение.Центр);
	CW_Отчеты.ЗаменитьТекстВТаблицеРезультата(Результат, "Доходы", "Доходы", ГоризонтальноеПоложение.Центр);
	CW_Отчеты.ЗаменитьТекстВТаблицеРезультата(Результат, "Прибыль", "Прибыль", ГоризонтальноеПоложение.Центр);	
	CW_Отчеты.ЗаменитьТекстВТаблицеРезультата(Результат, "Сумма", "Сумма", ГоризонтальноеПоложение.Центр);
	CW_Отчеты.ЗаменитьТекстВТаблицеРезультата(Результат, "НДС", "НДС", ГоризонтальноеПоложение.Центр);
	CW_Отчеты.ЗаменитьТекстВТаблицеРезультата(Результат, "Всего", "Всего", ГоризонтальноеПоложение.Центр);
	CW_Отчеты.ЗаменитьТекстВТаблицеРезультата(Результат, "Итого", "ИТОГО:");	
	
	Результат.УдалитьОбласть(Результат.Область("R1"), ТипСмещенияТабличногоДокумента.ПоГоризонтали); 
	Результат.УдалитьОбласть(Результат.Область("R2"), ТипСмещенияТабличногоДокумента.ПоГоризонтали); 
	Результат.ФиксацияСверху = Результат.ФиксацияСверху - 2;
	
	Результат.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	Результат.АвтоМасштаб = Истина;
	
	//УправлениеКолонтитулами
	УправлениеКолонтитулами.УстановитьКолонтитулы(Результат,"Анализ прибыли по месяцам");
	//УправлениеКолонтитулами
	
КонецПроцедуры	

