&НаКлиенте
Процедура ВыборПериода(Команда)
	
	ПОВ = Новый ОписаниеОповещения("ОбработкаИзмененияПериода",ЭтотОбъект); 
	Диалог = Новый ДиалогРедактированияСтандартногоПериода();
	Диалог.Период = Период;
	Диалог.Период.ДатаНачала = НачалоПериода;
	Диалог.Период.ДатаОкончания = КонецПериода;
	Диалог.Период.Вариант = ВариантСтандартногоПериода.ПроизвольныйПериод;
	Диалог.Показать(ПОВ);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаИзмененияПериода(ОтветПериод, ДополнительныеПараметры) Экспорт 
	// --- 
	
	Если (ОтветПериод <> Неопределено) Тогда
		НачалоПериода = НачалоДня(ОтветПериод.ДатаНачала);
		КонецПериода  = КонецДня(ОтветПериод.ДатаОкончания);
		Период = ОтветПериод;
	КонецЕсли; 
	
	// --- 
КонецПроцедуры

&НаКлиенте
Процедура ВерсияБюджетаПриИзменении(Элемент)
	
	Если НЕ ЗначениеЗаполнено(ВерсияБюджета) Тогда
		ВерсияБюджета = _ПолучитьБазовуюВерсиюБюджета();
	КонецЕсли;	
	
КонецПроцедуры

&НаСервере
Функция _ПолучитьБазовуюВерсиюБюджета()
	
	Возврат ?(ЗначениеЗаполнено(Константы.CW_БазоваяВерсияБюджета.Получить()), Константы.CW_БазоваяВерсияБюджета.Получить(), Справочники.CW_ВерсииБюджетов.Основная);
	
КонецФункции

&НаКлиенте
Процедура ДатаОпределенияПрибылиПриИзменении(Элемент)
	
	Если НЕ ЗначениеЗаполнено(ДатаОпределенияПрибыли) Тогда
		ДатаОпределенияПрибыли = Элементы.ДатаОпределенияПрибыли.СписокВыбора.НайтиПоЗначению("Реквизит.ДатаЗакрытия");
	КонецЕсли;		
	
КонецПроцедуры

&НаСервере
Процедура ПриСохраненииПользовательскихНастроекНаСервере(Настройки)
	
	Настройки.ДополнительныеСвойства.Вставить("Показатели",Показатели);
	Настройки.ДополнительныеСвойства.Вставить("Разделы",Разделы);
	//Настройки.ДополнительныеСвойства.Вставить("Группировки", Группировки.Выгрузить());
	Настройки.ДополнительныеСвойства.Вставить("Группировки", Группировки); // ДанныеФормыКоллекция
	//Настройки.ДополнительныеСвойства.Вставить("НачалоПериода",НачалоПериода);
	//Настройки.ДополнительныеСвойства.Вставить("КонецПериода",КонецПериода);
	Настройки.ДополнительныеСвойства.Вставить("ВерсияБюджета",ВерсияБюджета);
	Настройки.ДополнительныеСвойства.Вставить("ВыводитьРасходыДоходы",ВыводитьРасходыДоходы);
	Настройки.ДополнительныеСвойства.Вставить("ДатаОпределенияПрибыли",ДатаОпределенияПрибыли);
	Настройки.ДополнительныеСвойства.Вставить("Организация",Организация);
	Настройки.ДополнительныеСвойства.Вставить("ИсключатьВнутрихолдинговыеВзаиморасчеты",ИсключатьВнутрихолдинговыеВзаиморасчеты);
	Настройки.ДополнительныеСвойства.Вставить("ПорядокОтражения",ПорядокОтражения);
	Настройки.ДополнительныеСвойства.Вставить("Отбор", Отчет.КомпоновщикНастроек.ПолучитьНастройки());
	
КонецПроцедуры

&НаСервере
Процедура ПриЗагрузкеПользовательскихНастроекНаСервере(Настройки)
	
	Если НЕ СформироватьПриОткрытии Тогда
		
		CW_Отчеты.ПриЗагрузкеПользовательскихНастроекНаСервере(ЭтаФорма, Настройки);
		
		Если ПолучитьФункциональнуюОпцию("CW_ИспользованиеБюджетирования") Тогда
			Если Разделы.Количество() = 1 Тогда
				Разделы.Вставить(0, "План", , Ложь);
				Разделы.Добавить("Отклонение", , Ложь);
			КонецЕсли;	
			Если НЕ ЗначениеЗаполнено(ВерсияБюджета) Тогда
				ВерсияБюджета = _ПолучитьБазовуюВерсиюБюджета();
			КонецЕсли;	
		Иначе
			Разделы.Очистить();
			Разделы.Добавить("Факт",,Истина);
			Элементы.ВерсияБюджета.Видимость = Ложь;
			ВерсияБюджета = Неопределено;
		КонецЕсли;	
		Если НЕ ЗначениеЗаполнено(ДатаОпределенияПрибыли) Тогда
			ДатаОпределенияПрибыли = Элементы.ДатаОпределенияПрибыли.СписокВыбора.НайтиПоЗначению("Реквизит.ДатаЗакрытия");
		КонецЕсли;		
	КонецЕсли;
	
	Отчет.КомпоновщикНастроек.ПользовательскиеНастройки.ДополнительныеСвойства.Очистить();
	Настройки.ДополнительныеСвойства.Очистить();
	
КонецПроцедуры

&НаКлиенте
Процедура РазделыПриИзменении(Элемент)
	
	_УправлениеЭлементамиФормы();
	
КонецПроцедуры
