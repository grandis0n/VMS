&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ИспользованиеБюджетирования 			= ПолучитьФункциональнуюОпцию("CW_ИспользованиеБюджетирования");
	ИсключатьВнутрихолдинговыеВзаиморасчеты = CW_Настройки.ПолучитьНастройкуПользователя(,"ИсключатьВнутрихолдинговыеВзаиморасчеты");
	
	// параметры
	//Период.Вариант=ВариантСтандартногоПериода.ЭтотГод;
	ВерсияБюджета=Справочники.CW_ВерсииБюджетов.Основная;
	
	// показатели
	Показатели.Добавить("Сумма",,Истина);
	Показатели.Добавить("НДС",,Истина);
	Показатели.Добавить("Всего",,Истина);
	
	// разделы
	Разделы.Добавить("План",,Истина);	
	Разделы.Добавить("Факт",,Истина);
	Разделы.Добавить("Отклонение",,Истина);	
		
	// группировки
	Нстр = Группировки.Добавить();
	Нстр.ИмяПоля = "Грузоперевозка.Клиент";
	Нстр.Представление = "Клиент";
	Нстр.Сортировка = Перечисления.CW_НаправлениеСортировки.ПоВозрастанию;
	// --- 
	Нстр = Группировки.Добавить();
	Нстр.ИмяПоля = "Грузоперевозка";
	Нстр.Представление = "Грузоперевозка";
	Нстр.Сортировка = Перечисления.CW_НаправлениеСортировки.ПоВозрастанию;
	
	СписокВыбора = ПолучитьСписокПолейДляОтбораПоИнтервалу();
	Элементы.ДатаОпределенияПрибыли.СписокВыбора.Очистить();
	Для каждого Стр Из СписокВыбора Цикл
		
		Элементы.ДатаОпределенияПрибыли.СписокВыбора.Добавить(Стр.Значение,Стр.Представление,,Стр.Картинка);
		
	КонецЦикла; 
	
	_ВосстановитьСеансовуюНастройку();
	
	Если НЕ ИспользованиеБюджетирования Тогда
		
		Элементы.ВерсияБюджета.Видимость = Ложь;
		
	КонецЕсли; 
	
	_УправлениеЭлементамиФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Элементы.ФормаНастройка.Пометка = Истина;
	
	Если СформироватьПриОткрытии Тогда
		СформироватьПриОткрытии=Ложь;
		СформироватьОтчет();
	Иначе
		_ВосстановитьСтандартныеНастройки();
		_ВосстановитьСеансовуюНастройку();
	КонецЕсли; 
	
	// период по умолчанию
	Если НЕ ЗначениеЗаполнено(НачалоПериода) ИЛИ НЕ ЗначениеЗаполнено(КонецПериода) Тогда
		НачалоПериода = НачалоМесяца(ТекущаяДата());
		КонецПериода  = КонецМесяца(ТекущаяДата());
	КонецЕсли;	
	
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, СтандартнаяОбработка)
	
	//_СохранитьСеансовуюНастройку();
	ВариантМодифицирован = Ложь;		
	
КонецПроцедуры

