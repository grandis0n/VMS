#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
Функция СформироватьОтчет(Настройки) Экспорт
	
	Ответ = Новый Структура("Результат,ОписаниеОшибки");
	
	#Область Проверки
	
	Если Не ЭтоАдресВременногоХранилища(Настройки.АдресПутевыхЛистов) Тогда
		//странно.. Адрес должен быть всегда
		Ответ.Результат 		= Новый ТабличныйДокумент;
		Ответ.ОписаниеОшибки 	= "Не удалось получить путевые листы!";
		Возврат Ответ;
	КонецЕсли;
	
	Если Не ЭтоАдресВременногоХранилища(Настройки.АдресГруппировок) Тогда
		Ответ.Результат 		= Новый ТабличныйДокумент;
		Ответ.ОписаниеОшибки 	= "Не удалось получить список группировок отчета";
		Возврат Ответ;
	КонецЕсли;
	
	Если Не ЭтоАдресВременногоХранилища(Настройки.АдресНастроекОтбора) Тогда
		Ответ.Результат 		= Новый ТабличныйДокумент;
		Ответ.ОписаниеОшибки 	= "Не удалось получить настрйоки отбора отчета";
		Возврат Ответ;
	КонецЕсли;
	
	#КонецОбласти
	
	
	#Область Функциональные_Опции
	
	УчитыватьПробегТранспортногоСредстваСГрузом 	= ПолучитьФункциональнуюОпцию("CW_УчитыватьПробегТранспортногоСредстваСГрузом");
	УчитыватьПогрешностьИзмеренияОстаткаТоплива 	= ПолучитьФункциональнуюОпцию("CW_УчитыватьПогрешностьИзмеренияОстаткаТоплива");
	ПрименяютсяНормативыРасходаТоплива 				= ПолучитьФункциональнуюОпцию("CW_ПрименяютсяНормативыРасходаТоплива");
	
	ФункциональныеОпции = новый Структура;
	ФункциональныеОпции.Вставить("УчитыватьПробегТранспортногоСредстваСГрузом"	, УчитыватьПробегТранспортногоСредстваСГрузом);
	ФункциональныеОпции.Вставить("УчитыватьПогрешностьИзмеренияОстаткаТоплива"	, УчитыватьПогрешностьИзмеренияОстаткаТоплива);
	ФункциональныеОпции.Вставить("ПрименяютсяНормативыРасходаТоплива"			, ПрименяютсяНормативыРасходаТоплива);
	
	#КонецОбласти
	
	
	#Область Получение_данных_для_отчета
	мПутевыеЛисты = ПолучитьИзВременногоХранилища(Настройки.АдресПутевыхЛистов);
	
	ДанныеДляРасчетаПогрешности = Новый Соответствие;
	
	Если Настройки.ТипПериода = 0 Тогда
		УсловиеПоПериду = " И CW_ПутевойЛист.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания"
	Иначе
		УсловиеПоПериду = " И CW_ПутевойЛист.ДатаЗакрытия МЕЖДУ &ДатаНачала И &ДатаОкончания"
	КонецЕсли;
	
	
	ТабллицаПогрешностей = Новый ТаблицаЗначений;
	ТабллицаПогрешностей.Колонки.Добавить("ДатаСреза"	, новый ОписаниеТипов("Дата"));
	ТабллицаПогрешностей.Колонки.Добавить("Автомобиль"	, новый ОписаниеТипов("СправочникСсылка.CW_ТранспортныеСредства"));
	ТабллицаПогрешностей.Колонки.Добавить("Процент"		, новый ОписаниеТипов("Число"));
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("мПутевыеЛисты"	, мПутевыеЛисты);
	Запрос.УстановитьПараметр("ДатаНачала"		, Настройки.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания"	, Настройки.ДатаОкончания);
	Запрос.УстановитьПараметр("ПустаяДата"		, Дата(1,1,1));
	
	//|	"+УсловиеПоПериду+"
	
	Запрос.Текст = "ВЫБРАТЬ
	|	CW_ПутевойЛист.Ссылка КАК ПутевойЛист,
	|	CW_ПутевойЛист.Номер КАК Номер,
	|	CW_ПутевойЛист.Дата КАК Дата,
	|	CW_ПутевойЛист.ДатаЗакрытия КАК ДатаЗакрытия,
	|	ВЫБОР
	|		КОГДА CW_ПутевойЛист.ДатаЗакрытия = &ПустаяДата
	|			ТОГДА НАЧАЛОПЕРИОДА(CW_ПутевойЛист.Дата, ДЕНЬ)
	|		ИНАЧЕ НАЧАЛОПЕРИОДА(CW_ПутевойЛист.ДатаЗакрытия, ДЕНЬ)
	|	КОНЕЦ КАК ДатаСреза,
	|	CW_ПутевойЛист.ТранспортноеСредство КАК Автомобиль,
	|	CW_ПутевойЛист.ТранспортноеСредство.Модель КАК МодельАвтомобиля,
	|	CW_ПутевойЛист.Прицеп КАК Прицеп,
	|	CW_ПутевойЛист.ПробегПриВыезде КАК Спидометр_Начало,
	|	CW_ПутевойЛист.ПробегПриВозвращении КАК Спидометр_Конец,
	|	CW_ПутевойЛист.ОстатокТопливаПриВозвращении КАК Топливо_Конец,
	|	CW_ПутевойЛист.ОстатокТопливаПриВыезде КАК Топливо_Начало,
	|	CW_ПутевойЛист.Водитель КАК Водитель
	|ПОМЕСТИТЬ ВТ_ДанныеПутевыхЛистов
	|ИЗ
	|	Документ.CW_ПутевойЛист КАК CW_ПутевойЛист
	|ГДЕ
	|	CW_ПутевойЛист.Ссылка В(&мПутевыеЛисты)
	|	"+УсловиеПоПериду+"
	|
	|СГРУППИРОВАТЬ ПО
	|	CW_ПутевойЛист.Ссылка,
	|	CW_ПутевойЛист.Номер,
	|	CW_ПутевойЛист.Дата,
	|	CW_ПутевойЛист.ДатаЗакрытия,
	|	ВЫБОР
	|		КОГДА CW_ПутевойЛист.ДатаЗакрытия = &ПустаяДата
	|			ТОГДА НАЧАЛОПЕРИОДА(CW_ПутевойЛист.Дата, ДЕНЬ)
	|		ИНАЧЕ НАЧАЛОПЕРИОДА(CW_ПутевойЛист.ДатаЗакрытия, ДЕНЬ)
	|	КОНЕЦ,
	|	CW_ПутевойЛист.ТранспортноеСредство,
	|	CW_ПутевойЛист.ТранспортноеСредство.Модель,
	|	CW_ПутевойЛист.Прицеп,
	|	CW_ПутевойЛист.ПробегПриВыезде,
	|	CW_ПутевойЛист.ПробегПриВозвращении,
	|	CW_ПутевойЛист.ОстатокТопливаПриВозвращении,
	|	CW_ПутевойЛист.ОстатокТопливаПриВыезде,
	|	CW_ПутевойЛист.Водитель
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ПутевойЛист";
	
	Запрос.Выполнить();
	
	Запрос.Текст = "ВЫБРАТЬ
	|	CW_ПутевойЛистЗаправки.Ссылка КАК ПутевойЛист,
	|	СУММА(CW_ПутевойЛистЗаправки.Количество) КАК Топливо_Заправлено
	|ПОМЕСТИТЬ ВТ_Зарпавки
	|ИЗ
	|	Документ.CW_ПутевойЛист.Заправки КАК CW_ПутевойЛистЗаправки
	|ГДЕ
	|	CW_ПутевойЛистЗаправки.Ссылка В
	|			(ВЫБРАТЬ
	|				ВТ_ДанныеПутевыхЛистов.ПутевойЛист
	|			ИЗ
	|				ВТ_ДанныеПутевыхЛистов КАК ВТ_ДанныеПутевыхЛистов)
	|
	|СГРУППИРОВАТЬ ПО
	|	CW_ПутевойЛистЗаправки.Ссылка
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ПутевойЛист";
	
	Запрос.Выполнить();
	
	Запрос.Текст = "ВЫБРАТЬ
	|	CW_ПутевойЛистТопливоВыдано.Ссылка КАК ПутевойЛист,
	|	СУММА(CW_ПутевойЛистТопливоВыдано.Объем) КАК Топливо_Выдано
	|ПОМЕСТИТЬ ВТ_ТопливоВыдано
	|ИЗ
	|	Документ.CW_ПутевойЛист.ТопливоВыдано КАК CW_ПутевойЛистТопливоВыдано
	|ГДЕ
	|	CW_ПутевойЛистТопливоВыдано.Ссылка В
	|			(ВЫБРАТЬ
	|				ВТ_ДанныеПутевыхЛистов.ПутевойЛист
	|			ИЗ
	|				ВТ_ДанныеПутевыхЛистов КАК ВТ_ДанныеПутевыхЛистов)
	|
	|СГРУППИРОВАТЬ ПО
	|	CW_ПутевойЛистТопливоВыдано.Ссылка
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ПутевойЛист";
	
	Запрос.Выполнить();
	
	Запрос.Текст = "ВЫБРАТЬ
	|	CW_ПутевойЛистЭтапыМаршрута.Ссылка КАК ПутевойЛист,
	|	СУММА(CW_ПутевойЛистЭтапыМаршрута.РасходФакт) КАК Топливо_Расход,
	|	СУММА(CW_ПутевойЛистЭтапыМаршрута.РасходНорма) КАК Топливо_Норма,
	|	СУММА(CW_ПутевойЛистЭтапыМаршрута.РасходФакт - CW_ПутевойЛистЭтапыМаршрута.РасходНорма) КАК Перерасход_всего,
	|	СУММА(CW_ПутевойЛистЭтапыМаршрута.Зарплата) КАК Зарплата,
	|	СУММА(CW_ПутевойЛистЭтапыМаршрута.ВесГруза) КАК ВесГруза,
	|	СУММА(CW_ПутевойЛистЭтапыМаршрута.Пробег) КАК Пробег_Всего,
	|	СУММА(CW_ПутевойЛистЭтапыМаршрута.ПробегСГрузом) КАК Пробег_СГрузом,
	|	СУММА(CW_ПутевойЛистЭтапыМаршрута.ПробегПорожний) КАК Пробег_БезГруза
	|ПОМЕСТИТЬ ВТ_Этапы
	|ИЗ
	|	Документ.CW_ПутевойЛист.ЭтапыМаршрута КАК CW_ПутевойЛистЭтапыМаршрута
	|ГДЕ
	|	CW_ПутевойЛистЭтапыМаршрута.Ссылка В
	|			(ВЫБРАТЬ
	|				ВТ_ДанныеПутевыхЛистов.ПутевойЛист
	|			ИЗ
	|				ВТ_ДанныеПутевыхЛистов КАК ВТ_ДанныеПутевыхЛистов)
	|
	|СГРУППИРОВАТЬ ПО
	|	CW_ПутевойЛистЭтапыМаршрута.Ссылка
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ПутевойЛист";
	
	Запрос.Выполнить();
	
	Запрос.Текст = "ВЫБРАТЬ
	|	CW_ПутевойЛист.ПутевойЛист КАК ПутевойЛист,
	|	CW_ПутевойЛист.Номер КАК Номер,
	|	CW_ПутевойЛист.Дата КАК Дата,
	|	CW_ПутевойЛист.ДатаЗакрытия КАК ДатаЗакрытия,
	|	CW_ПутевойЛист.ДатаСреза КАК ДатаСреза,
	|	CW_ПутевойЛист.Автомобиль КАК Автомобиль,
	|	CW_ПутевойЛист.МодельАвтомобиля КАК МодельАвтомобиля,
	|	CW_ПутевойЛист.Прицеп КАК Прицеп,
	|	CW_ПутевойЛист.Спидометр_Начало КАК Спидометр_Начало,
	|	CW_ПутевойЛист.Спидометр_Конец КАК Спидометр_Конец,
	|	CW_ПутевойЛист.Топливо_Конец КАК Топливо_Конец,
	|	CW_ПутевойЛист.Топливо_Начало КАК Топливо_Начало,
	|	CW_ПутевойЛистЗаправки.Топливо_Заправлено КАК Топливо_Заправлено,
	|	CW_ПутевойЛистТопливоВыдано.Топливо_Выдано КАК Топливо_Выдано,
	|	CW_ПутевойЛистЭтапыМаршрута.Топливо_Расход КАК Топливо_Расход,
	|	CW_ПутевойЛистЭтапыМаршрута.Топливо_Норма КАК Топливо_Норма,
	|	CW_ПутевойЛист.Водитель КАК Водитель,
	|	CW_ПутевойЛистЭтапыМаршрута.Перерасход_всего КАК Перерасход_всего,
	|	CW_ПутевойЛистЭтапыМаршрута.Зарплата КАК Зарплата,
	|	CW_ПутевойЛистЭтапыМаршрута.ВесГруза КАК ВесГруза,
	|	CW_ПутевойЛистЭтапыМаршрута.Пробег_Всего КАК Пробег_Всего,
	|	CW_ПутевойЛистЭтапыМаршрута.Пробег_СГрузом КАК Пробег_СГрузом,
	|	CW_ПутевойЛистЭтапыМаршрута.Пробег_БезГруза КАК Пробег_БезГруза
	|ПОМЕСТИТЬ ВТ_ПутевыеЛисты
	|ИЗ
	|	ВТ_ДанныеПутевыхЛистов КАК CW_ПутевойЛист
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Этапы КАК CW_ПутевойЛистЭтапыМаршрута
	|		ПО CW_ПутевойЛист.ПутевойЛист = CW_ПутевойЛистЭтапыМаршрута.ПутевойЛист
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Зарпавки КАК CW_ПутевойЛистЗаправки
	|		ПО CW_ПутевойЛист.ПутевойЛист = CW_ПутевойЛистЗаправки.ПутевойЛист
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ТопливоВыдано КАК CW_ПутевойЛистТопливоВыдано
	|		ПО CW_ПутевойЛист.ПутевойЛист = CW_ПутевойЛистТопливоВыдано.ПутевойЛист";
	
	
	Запрос.Выполнить();
	
	
	//				   	
	Если УчитыватьПогрешностьИзмеренияОстаткаТоплива Тогда
		
		Запрос.Текст = "ВЫБРАТЬ
		|	ВТ_ПутевыеЛисты.ДатаСреза КАК ДатаСреза,
		|	ВТ_ПутевыеЛисты.Автомобиль КАК Автомобиль,
		|	ВТ_ПутевыеЛисты.МодельАвтомобиля КАК МодельАвтомобиля
		|ИЗ
		|	ВТ_ПутевыеЛисты КАК ВТ_ПутевыеЛисты
		|
		|СГРУППИРОВАТЬ ПО
		|	ВТ_ПутевыеЛисты.Автомобиль,
		|	ВТ_ПутевыеЛисты.ДатаСреза,
		|	ВТ_ПутевыеЛисты.МодельАвтомобиля
		|ИТОГИ ПО
		|	ДатаСреза";
		
		РезультатЗапроса = Запрос.Выполнить();	
		
		//Подготовим таблицу с даннымм
		Выборка_ДатаСреза = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Пока Выборка_ДатаСреза.Следующий() Цикл
			
			Выборка_Детали = Выборка_ДатаСреза.Выбрать();
			
			мОбъектыНаДату = Новый Массив;
			Пока Выборка_Детали.Следующий() Цикл
				
				мОбъектыНаДату.Добавить(Выборка_Детали.Автомобиль);
				мОбъектыНаДату.Добавить(Выборка_Детали.МодельАвтомобиля);
				
			КонецЦикла;
			
			Запрос_погрешности = Новый запрос;
			Запрос_погрешности.Текст = "ВЫБРАТЬ
			|	&ДатаСреза КАК ДатаСреза,
			|	CW_ЗначенияПоказателейНормРасходаТопливаСрезПоследних.ОбъектРасчета КАК ОбъектРасчета,
			|	CW_ЗначенияПоказателейНормРасходаТопливаСрезПоследних.ЗначениеПоказателя КАК ЗначениеПоказателя
			|ИЗ
			|	РегистрСведений.CW_ЗначенияПоказателейНормРасходаТоплива.СрезПоследних(
			|			&ДатаСреза,
			|			ОбъектРасчета в (&мОбъектыНаДату)
			|				И ПоказательРасчетаРасходаТоплива = ЗНАЧЕНИЕ(Справочник.CW_ПоказателиРасчетаРасходаТоплива.ПогрешностьИзмеренияОстаткаТоплива)) КАК CW_ЗначенияПоказателейНормРасходаТопливаСрезПоследних";
			
			Запрос_погрешности.УстановитьПараметр("ДатаСреза"		, Выборка_ДатаСреза.ДатаСреза);
			Запрос_погрешности.УстановитьПараметр("мОбъектыНаДату"	, мОбъектыНаДату);
			
			Результат_Погрешность = Запрос_погрешности.Выполнить();
			
			Выборка_Погрешность = Результат_Погрешность.Выбрать();
			
			Выборка_Детали.Сбросить();
			
			Пока Выборка_Детали.Следующий() Цикл
				
				НоваяСтрока = ТабллицаПогрешностей.Добавить();
				НоваяСтрока.ДатаСреза 	= Выборка_ДатаСреза.ДатаСреза;
				НоваяСтрока.Автомобиль 	= Выборка_Детали.Автомобиль;
				
				Отбор = Новый Структура("ДатаСреза,ОбъектРасчета",Выборка_ДатаСреза.ДатаСреза,Выборка_Детали.Автомобиль);
				
				Если Выборка_Погрешность.НайтиСледующий(Отбор) Тогда
					Погрешность_процент = Выборка_Погрешность.ЗначениеПоказателя;
				КонецЕсли;
				
				Если Не ЗначениеЗаполнено(Погрешность_процент) Тогда
					Отбор = Новый Структура("ДатаСреза,ОбъектРасчета",Выборка_ДатаСреза.ДатаСреза,Выборка_Детали.МодельАвтомобиля);
					
					Если Выборка_Погрешность.НайтиСледующий(Отбор) Тогда
						Погрешность_процент = Выборка_Погрешность.ЗначениеПоказателя;
					КонецЕсли;
					
				КонецЕсли;
				
				НоваяСтрока.Процент = ?(ЗначениеЗаполнено(Погрешность_процент),Погрешность_процент, 0) ;
				
			КонецЦикла;
		КонецЦикла;
		
	КонецЕсли;
	
	Запрос.Текст = "ВЫБРАТЬ
	|	ВТ_погрешности.ДатаСреза КАК ДатаСреза,
	|	ВТ_погрешности.Автомобиль КАК Автомобиль,
	|	ВТ_погрешности.Процент КАК Процент
	|ПОМЕСТИТЬ ВТ_Погрешности
	|ИЗ
	|	&ВТ_погрешности КАК ВТ_погрешности
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ПутевыеЛисты.ПутевойЛист КАК ПутевойЛист,
	|	ВТ_ПутевыеЛисты.Номер КАК Номер,
	|	ВТ_ПутевыеЛисты.Дата КАК Дата,
	|	ВТ_ПутевыеЛисты.ДатаЗакрытия КАК ДатаЗакрытия,
	|	ВТ_ПутевыеЛисты.ДатаСреза КАК ДатаСреза,
	|	ВТ_ПутевыеЛисты.Автомобиль КАК Автомобиль,
	|	ВТ_ПутевыеЛисты.МодельАвтомобиля КАК МодельАвтомобиля,
	|	ВТ_ПутевыеЛисты.Прицеп КАК Прицеп,
	|	ВТ_ПутевыеЛисты.Спидометр_Начало КАК Спидометр_Начало,
	|	ВТ_ПутевыеЛисты.Спидометр_Конец КАК Спидометр_Конец,
	|	ВТ_ПутевыеЛисты.Топливо_Конец КАК Топливо_Конец,
	|	ВТ_ПутевыеЛисты.Топливо_Начало КАК Топливо_Начало,
	|	ВТ_ПутевыеЛисты.Топливо_Заправлено КАК Топливо_Заправлено,
	|	ВТ_ПутевыеЛисты.Топливо_Выдано КАК Топливо_Выдано,
	|	ВТ_ПутевыеЛисты.Топливо_Расход КАК Топливо_Расход,
	|	ВТ_ПутевыеЛисты.Топливо_Норма КАК Топливо_Норма,
	|	ВТ_ПутевыеЛисты.Водитель КАК Водитель,
	|	ВТ_ПутевыеЛисты.Зарплата КАК Зарплата,
	|	ВТ_ПутевыеЛисты.ВесГруза КАК ВесГруза,
	|	ВТ_ПутевыеЛисты.Пробег_Всего КАК Пробег_Всего,
	|	ВТ_ПутевыеЛисты.Пробег_СГрузом КАК Пробег_СГрузом,
	|	ВТ_ПутевыеЛисты.Пробег_БезГруза КАК Пробег_БезГруза,
	|	ВТ_ПутевыеЛисты.Перерасход_всего КАК Перерасход_всего,
	|	ЕСТЬNULL(ВТ_Погрешности.Процент, 0) КАК Погрешность_процент,
	|	ВЫРАЗИТЬ(ВТ_ПутевыеЛисты.Топливо_Конец * ЕСТЬNULL(ВТ_Погрешности.Процент, 0) / 100 КАК ЧИСЛО(10, 3)) КАК Погрешность_Литры,
	|	ВЫБОР
	|		КОГДА ВТ_ПутевыеЛисты.Перерасход_всего > (ВЫРАЗИТЬ(ВТ_ПутевыеЛисты.Топливо_Конец * ЕСТЬNULL(ВТ_Погрешности.Процент, 0) / 100 КАК ЧИСЛО(10, 3)))
	|			ТОГДА ВЫРАЗИТЬ(ВТ_ПутевыеЛисты.Топливо_Конец * ЕСТЬNULL(ВТ_Погрешности.Процент, 0) / 100 КАК ЧИСЛО(10, 3))
	|		ИНАЧЕ ВТ_ПутевыеЛисты.Перерасход_всего
	|	КОНЕЦ КАК Перерасход_ВПределахПогрешности,
	|	ВЫБОР
	|		КОГДА ВТ_ПутевыеЛисты.Перерасход_всего > (ВЫРАЗИТЬ(ВТ_ПутевыеЛисты.Топливо_Конец * ЕСТЬNULL(ВТ_Погрешности.Процент, 0) / 100 КАК ЧИСЛО(10, 3)))
	|			ТОГДА ВТ_ПутевыеЛисты.Перерасход_всего - (ВЫРАЗИТЬ(ВТ_ПутевыеЛисты.Топливо_Конец * ЕСТЬNULL(ВТ_Погрешности.Процент, 0) / 100 КАК ЧИСЛО(10, 3)))
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК Перерасход_СверхПогрешности
	|ИЗ
	|	ВТ_ПутевыеЛисты КАК ВТ_ПутевыеЛисты
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Погрешности КАК ВТ_Погрешности
	|		ПО ВТ_ПутевыеЛисты.ДатаСреза = ВТ_Погрешности.ДатаСреза
	|			И ВТ_ПутевыеЛисты.Автомобиль = ВТ_Погрешности.Автомобиль
	|
	|УПОРЯДОЧИТЬ ПО
	|	Автомобиль,
	|	Дата
	|ИТОГИ
	|	СУММА(Топливо_Заправлено),
	|	СУММА(Топливо_Выдано),
	|	СУММА(Топливо_Расход),
	|	СУММА(Зарплата),
	|	СУММА(ВесГруза),
	|	СУММА(Пробег_Всего),
	|	СУММА(Пробег_СГрузом),
	|	СУММА(Пробег_БезГруза),
	|	СУММА(Перерасход_всего),
	|	СУММА(Перерасход_ВПределахПогрешности),
	|	СУММА(Перерасход_СверхПогрешности)
	|ПО
	|	ОБЩИЕ";
	
	
	#Область Группирвоки_отчета
	
	ГруппировкиОтчета = ПолучитьИзВременногоХранилища(Настройки.АдресГруппировок);
	
	стрПолеГруппировки = "";
	
	массивПолей = новый Массив;
	
	Для Каждого Элемент из ГруппировкиОтчета Цикл
		Если  Элемент.Пометка Тогда
			массивПолей.Добавить(Элемент.Значение);
		КонецЕсли;
	КонецЦикла;
	
	стрПоляГруппировки = СтрСоединить(массивПолей, ",&ПС");
	стрПоляГруппировки = СтрЗаменить(стрПоляГруппировки,"&ПС",Символы.ПС);	
	
	Если массивПолей.Количество() > 0 Тогда
		Запрос.Текст = Запрос.Текст +","+ стрПоляГруппировки
	Конецесли;
	
	#конецОбласти
	
	Запрос.УстановитьПараметр("ВТ_погрешности"	, ТабллицаПогрешностей);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	#КонецОбласти
	
	
	#Область Вывод
	
	Результат = Новый ТабличныйДокумент;
	
	Макет = ПолучитьМакет("МакетОтчета");
	
	#Область Заголовок_Отчета
	//ЗАГОЛОВОК
	Область_Заголовок 	= Макет.ПолучитьОбласть("Заголовок|Начало");
	Результат.Вывести(Область_Заголовок);
	
	//Параметры и отборы
	Область_Параметры =  Макет.ПолучитьОбласть("Область_Параметры|Начало");
	Область_Параметры.Параметры.ПериодОтчета = "Период: "+ ПредставлениеПериода(НачалоДня(Настройки.ДатаНачала), КонецДня(Настройки.ДатаОкончания), "ФП = Истина");
	Результат.Вывести(Область_Параметры);
	
	Отбор = ПолучитьИзВременногоХранилища(Настройки.АдресНастроекОтбора);
	Если Отбор.Элементы.Количество() > 0 Тогда
		
		ДокументОтбора = Новый ТабличныйДокумент;
		//загловок отбора
		//Детали отбора
		ЕстьОтбор = Ложь;
		Для Каждого ЭлементОтбора из Отбор.Элементы Цикл
			Если Не ЭлементОтбора.Использование Тогда
				Продолжить;
			КонецЕсли;
			ЕстьОтбор = Истина;
			
			Область_Отбор_Детали =  Макет.ПолучитьОбласть("Отбор_Детали|Начало");
			Область_Отбор_Детали.Параметры.стрОтбор = СокрЛП(ЭлементОтбора.ЛевоеЗначение)+ " "+ СокрЛП(ЭлементОтбора.ВидСравнения)+" " +СокрЛП(ЭлементОтбора.ПравоеЗначение) ;
			ДокументОтбора.Вывести(Область_Отбор_Детали);
			
		КонецЦикла;
		
		Если ЕстьОтбор Тогда
			Область_Отбор_Заголовок =  Макет.ПолучитьОбласть("Отбор_Заголовок|Начало");
			Результат.Вывести(Область_Отбор_Заголовок);
			Результат.Вывести(ДокументОтбора);
		КонецЕсли;
		
	КонецЕсли;
	#Конецобласти
	
	
	#Область ШапкаОтчета
	
	ПоВодителю 		= Ложь;
	ПоАвтомобилю 	= Ложь;
	
	ВывестиНачало(Макет, Результат, "Шапка", МассивПолей, ПоВодителю,ПоАвтомобилю, Неопределено);
	ВывестиВертикальныеОбласти(Макет, Результат, "Шапка", ФункциональныеОпции, ПоВодителю , Неопределено);
	
	#Конецобласти
	
	ПерваяСтрока 		= Результат.ВысотаТаблицы;
	ПоследняяКолонка 	= Результат.ШиринаТаблицы;
	#Область Строки
	
	Выборка_ОбщийИтог = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Если массивПолей.Количество() = 0 Тогда
		
		Если Выборка_ОбщийИтог.Следующий() Тогда
			
			Выборка = Выборка_ОбщийИтог.Выбрать();
			
			Пока Выборка.Следующий() Цикл
				
				ВывестиНачало(Макет, Результат, "Строка", МассивПолей, ПоВодителю,ПоАвтомобилю, Выборка);
				ВывестиВертикальныеОбласти(Макет, Результат, "Строка", ФункциональныеОпции, ПоВодителю , Выборка);
				
			КонецЦикла;
			
			ВывестиНачало(Макет, Результат, "ОбщийИтог", МассивПолей, ПоВодителю,ПоАвтомобилю, Выборка_ОбщийИтог);
			ВывестиВертикальныеОбласти(Макет, Результат, "ОбщийИтог", ФункциональныеОпции, ПоВодителю , Выборка_ОбщийИтог);
			
			
		КонецЕсли;
	Иначе
		
		
		Если Выборка_ОбщийИтог.Следующий() Тогда
			
			Выборка_первая = Выборка_ОбщийИтог.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			
			Пока Выборка_первая.Следующий() Цикл
				Результат.НачатьАвтогруппировкуСтрок();
				
				//Группировка
				Имя = массивПолей[0];
				ВывестиНачало(Макет, Результат, "Итог"+Имя, МассивПолей, ПоВодителю,ПоАвтомобилю, Выборка_первая, Выборка_первая.Уровень());
				ВывестиВертикальныеОбласти(Макет, Результат, "Итог"+Имя, ФункциональныеОпции, ПоВодителю , Выборка_первая);
				
				Если МассивПолей.Количество() = 1 Тогда
					Детали = Выборка_первая.Выбрать();
					
					Пока Детали.Следующий() Цикл
						ВывестиНачало(Макет, Результат, "Строка", МассивПолей, ПоВодителю,ПоАвтомобилю, Детали, Детали.Уровень());
						ВывестиВертикальныеОбласти(Макет, Результат, "Строка", ФункциональныеОпции, ПоВодителю , Детали);
					КонецЦикла;
					
				ИначеЕсли МассивПолей.Количество() = 2 Тогда
					
					Выборка_вторая = Выборка_первая.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
					
					Пока Выборка_вторая.Следующий() Цикл
						
						//Группирловка
						Имя = массивПолей[1];
						ВывестиНачало(Макет, Результат, "Итог"+Имя, МассивПолей, ПоВодителю,ПоАвтомобилю, Выборка_вторая, Выборка_вторая.Уровень());
						ВывестиВертикальныеОбласти(Макет, Результат, "Итог"+Имя, ФункциональныеОпции, ПоВодителю , Выборка_вторая);
						
						Детали = Выборка_вторая.Выбрать();
						
						Пока Детали.Следующий() Цикл
							ВывестиНачало(Макет, Результат, "Строка", МассивПолей, ПоВодителю,ПоАвтомобилю, Детали, Детали.Уровень());
							ВывестиВертикальныеОбласти(Макет, Результат, "Строка", ФункциональныеОпции, ПоВодителю , Детали);
						КонецЦикла;
						
					КонецЦикла;
					
				КонецЕсли;
				
				Результат.ЗакончитьАвтогруппировкуСтрок();
				
			КонецЦикла;
			
			ВывестиНачало(Макет, Результат, "ОбщийИтог", МассивПолей, ПоВодителю,ПоАвтомобилю, Выборка_ОбщийИтог);
			ВывестиВертикальныеОбласти(Макет, Результат, "ОбщийИтог", ФункциональныеОпции, ПоВодителю , Выборка_ОбщийИтог);
			
		КонецЕсли;
		
		
		
	КонецЕсли;
	
	#КонецОбласти
	
	#КонецОбласти
	
	ПоследняяСтрока 		= Результат.ВысотаТаблицы;
	
	#Область Оформление
	
	Для НомерСтроки = ПерваяСтрока По ПоследняяСтрока Цикл
		
		НомерСтрокиФормат = Формат(НомерСтроки,"ЧГ=0");
		
		Область = Результат.Область("R"+НомерСтрокиФормат+"C1:R"+НомерСтрокиФормат+"C"+Формат(ПоследняяКолонка,"ЧГ=0"));
		
		Если ТипЗнч(Область.Расшифровка) = Тип("ДокументСсылка.CW_ПутевойЛист") Тогда
			//Это строки
			Если  Не ЗначениеЗаполнено(Область.Расшифровка.ДатаЗакрытия) Тогда
				//Закрыт
				Область.ЦветФона = ЦветаСтиля.ВыделеннаяКнопкаФон;
				
			КонецЕсли;
			
		ИначеЕсли ТипЗнч(Область.Расшифровка) = Тип("Число") Тогда
			Если Область.Расшифровка = 1 Тогда
				//первый урвоень
				Область.ЦветФона = ЦветаСтиля.ЦветФонаГруппировкиОтчета1;
			Иначеесли   Область.Расшифровка = 2 Тогда
				//второй уровень
				Область.ЦветФона = ЦветаСтиля.ЦветФонаГруппировкиОтчета2;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	#КонецОбласти
	
	Ответ.Результат			= Результат;	
	Ответ.ОписаниеОшибки 	= "";	
	
	Возврат Ответ;
	
КонецФункции     

Процедура ВывестиНачало(Макет, Результат, ИмяОбласти, МассивПолей, ПоВодителю, ПоАвтомобилю, ДанныеСтроки, Уровень = 0)
	
	Область_Автомобиль 	= Макет.ПолучитьОбласть(ИмяОбласти+"|Автомобиль");
	Область_Начало 		= Макет.ПолучитьОбласть(ИмяОбласти+"|Начало");
	
	ДанныеРасшфировки = Новый Структура("Расшифровка", Уровень);
	
	Если МассивПолей.Количество() = 0 тогда
		Если Не ДанныеСтроки = Неопределено Тогда
			ЗаполнитьЗначенияСвойств(Область_Автомобиль.Параметры, ДанныеСтроки); 
		КонецЕсли;
		
		Результат.Вывести(Область_Автомобиль);
	Иначе
		Если массивПолей.Количество() > 0 тогда
			//Первая
			Имя = массивПолей[0];
			ПоВодителю 		= Имя = "Водитель" 		или ПоВодителю;
			ПоАвтомобилю 	= Имя = "Автомобиль" 	или ПоАвтомобилю;
			
			Область_Первая 	= Макет.ПолучитьОбласть(ИмяОбласти +"|"+Имя);
			
			Если Не ДанныеСтроки = Неопределено Тогда
				ЗаполнитьЗначенияСвойств(Область_Первая.Параметры, ДанныеСтроки); 
				ЗаполнитьЗначенияСвойств(Область_Первая.Параметры, ДанныеРасшфировки); 
			КонецЕсли;
			
			Если ИмяОбласти = "Строка" Тогда
				Если ПоВодителю и Имя = "Водитель" тогда
					Область_Первая.Параметры.водитель = "";
				КонецЕсли;
				Если ПоАвтомобилю и Имя = "Автомобиль" тогда
					Область_Первая.Параметры.Автомобиль = "";
				КонецЕсли;
			КонецЕсли;
			
			Результат.Вывести(Область_Первая, Уровень);
			
		КонецЕсли;
		
		Если массивПолей.Количество() > 1 тогда
			//Втораая
			Имя = массивПолей[1];
			ПоВодителю 		= Имя = "Водитель" 		или ПоВодителю;
			ПоАвтомобилю 	= Имя = "Автомобиль" 	или ПоАвтомобилю;
			
			Область_Втораая = Макет.ПолучитьОбласть(ИмяОбласти +"|"+Имя);
			
			Если Не ДанныеСтроки = Неопределено Тогда
				ЗаполнитьЗначенияСвойств(Область_Втораая.Параметры, ДанныеСтроки); 
				ЗаполнитьЗначенияСвойств(Область_Втораая.Параметры, ДанныеРасшфировки); 
			КонецЕсли;
			
			Если ИмяОбласти = "Строка" Тогда
				Если ПоВодителю и Имя = "Водитель" тогда
					Область_Втораая.Параметры.водитель = "";
				КонецЕсли;
				Если ПоАвтомобилю и Имя = "Автомобиль" тогда
					Область_Втораая.Параметры.Автомобиль = "";
				КонецЕсли;
			КонецЕсли;
			
			Результат.Присоединить(Область_Втораая);
			
		КонецЕсли;
		
		Если Не ПоАвтомобилю Тогда
			
			Если Не ДанныеСтроки = Неопределено Тогда
				ЗаполнитьЗначенияСвойств(Область_Автомобиль.Параметры, ДанныеСтроки); 
			КонецЕсли;
			
			Если ИмяОбласти = "Строка" Тогда
				Если ПоАвтомобилю и Имя = "Автомобиль" тогда
					Область_Автомобиль.Параметры.Автомобиль = "";
				КонецЕсли;
			КонецЕсли;
			
			Результат.Присоединить(Область_Автомобиль);
		Конецесли;
		
	КонецЕсли;
	
	Если Не ДанныеСтроки = Неопределено Тогда
		ЗаполнитьЗначенияСвойств(Область_Начало.Параметры, ДанныеСтроки); 
		ЗаполнитьЗначенияСвойств(Область_Начало.Параметры, ДанныеРасшфировки); 
	КонецЕсли;
	
	Результат.Присоединить(Область_Начало);
	
КонецПроцедуры

Процедура ВывестиВертикальныеОбласти(Макет,Результат, ИмяОбласти, ФункциональныеОпции, ПоВодителю, ДанныеСтроки = Неопределено)
	
	//пробег
	Если  ФункциональныеОпции.УчитыватьПробегТранспортногоСредстваСГрузом Тогда
		Область_Пробег =  Макет.ПолучитьОбласть(ИмяОбласти+"|Пробег_Груз");
	Иначе
		Область_Пробег =  Макет.ПолучитьОбласть(ИмяОбласти+"|Пробег");
	КонецЕсли;
	
	Если Не ДанныеСтроки = Неопределено Тогда
		ЗаполнитьЗначенияСвойств(Область_Пробег.Параметры, ДанныеСтроки); 
	КонецЕсли;
	
	Результат.Присоединить(Область_Пробег);
	
	//Вес груза
	Область_ВесГруза =  Макет.ПолучитьОбласть(ИмяОбласти+"|ВесГруза");
	
	Если Не ДанныеСтроки = Неопределено Тогда
		ЗаполнитьЗначенияСвойств(Область_ВесГруза.Параметры, ДанныеСтроки); 
	КонецЕсли;
	
	Результат.Присоединить(Область_ВесГруза);
	
	//Топливо
	Область_Топливо =  Макет.ПолучитьОбласть(ИмяОбласти+"|Топливо");
	
	Если Не ДанныеСтроки = Неопределено Тогда
		ЗаполнитьЗначенияСвойств(Область_Топливо.Параметры, ДанныеСтроки); 
	КонецЕсли;
	
	Результат.Присоединить(Область_Топливо);
	
	//НормативныйРасход
	Если ФункциональныеОпции.ПрименяютсяНормативыРасходаТоплива Тогда
		
		Область_НормативныйРасход =  Макет.ПолучитьОбласть(ИмяОбласти+"|НормативныйРасход");
		
		Если Не ДанныеСтроки = Неопределено Тогда
			ЗаполнитьЗначенияСвойств(Область_НормативныйРасход.Параметры, ДанныеСтроки); 
		КонецЕсли;
		
		Результат.Присоединить(Область_НормативныйРасход);
		
	Конецесли;
	
	//Погрешность
	Если ФункциональныеОпции.УчитыватьПогрешностьИзмеренияОстаткаТоплива Тогда
		Область_Перерасход =  Макет.ПолучитьОбласть(ИмяОбласти+"|Погрешность");
	Иначе
		Область_Перерасход =  Макет.ПолучитьОбласть(ИмяОбласти+"|Перерасход");
	КонецЕсли;
	
	Если Не ДанныеСтроки = Неопределено Тогда
		ЗаполнитьЗначенияСвойств(Область_Перерасход.Параметры, ДанныеСтроки); 
	КонецЕсли;
	
	Результат.Присоединить(Область_Перерасход);
	
	Если НЕ ПоВодителю Тогда
		Область_водитель =  Макет.ПолучитьОбласть(ИмяОбласти+"|водитель");
		
		Если Не ДанныеСтроки = Неопределено Тогда
			ЗаполнитьЗначенияСвойств(Область_водитель.Параметры, ДанныеСтроки); 
		КонецЕсли;
		Результат.Присоединить(Область_водитель);
	КонецЕсли;
	
	//КОНЕЦ
	Область_Конец =  Макет.ПолучитьОбласть(ИмяОбласти+"|Конец");
	
	Если Не ДанныеСтроки = Неопределено Тогда
		ЗаполнитьЗначенияСвойств(Область_Конец.Параметры, ДанныеСтроки); 
	КонецЕсли;
	
	Результат.Присоединить(Область_Конец);
	
КонецПроцедуры

#КонецЕсли