&НаКлиенте
Процедура ВыборПериода(Команда)
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ОбработкаИзмененияПериода",ЭтотОбъект); 
	
	Диалог = Новый ДиалогРедактированияСтандартногоПериода();
	Диалог.Период 					= Период;
	Диалог.Период.ДатаНачала 		= ДатаНачала;
	Диалог.Период.ДатаОкончания 	= ДатаОкончания;
	Диалог.Период.Вариант 			= ВариантСтандартногоПериода.ПроизвольныйПериод;
	
	Диалог.Показать(ОписаниеОповещения);
	
КонецПроцедуры


