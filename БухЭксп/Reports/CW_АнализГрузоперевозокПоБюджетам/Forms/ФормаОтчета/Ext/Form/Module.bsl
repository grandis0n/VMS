&НаКлиенте
Процедура КомандаВыполнитьЗакрытие(Команда)
	
	Если (НЕ ЗначениеЗаполнено(Заказ)) Тогда
		Возврат;
	КонецЕсли; 
	
	// --- 
	
	ПОВ = Новый ОписаниеОповещения("ОбработкаЗакрытияЗаказа",ЭтотОбъект, Новый Структура()); 
	ОткрытьФорму("Отчет.CW_АнализГрузоперевозокПоБюджетам.Форма.ФормаЗакрытияЗаказа",,ЭтаФорма,,,,ПОВ,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаЗакрытияЗаказа(Ответ, ДополнительныеПараметры) Экспорт 
	// --- 
	
	Если (Ответ <> Неопределено) Тогда
		
		Если (Ответ.фл1 ИЛИ Ответ.фл2 ИЛИ Ответ.фл3) Тогда
			
			РезультатЗакрытия = _ВыполнитьЗакрытие(Ответ);
			Если (_УФКС.ВыполненоУспешно(РезультатЗакрытия)) Тогда
				Состояние("Закрытие выполнено.");
			Иначе
				_УФК.ВывестиПредупреждение("Ошибка закрытия заказа.");
			КонецЕсли; 
			
		КонецЕсли; 
		
	КонецЕсли; 
	
	// --- 
КонецПроцедуры

&НаСервере
Функция _ВыполнитьЗакрытие(Параметры)
	// --- 
	
	Попытка
		
		Если (Параметры.фл3) Тогда
			CW_Мониторинг.УстановитьДатуЗакрытия(Заказ,Параметры.Дата);  
		КонецЕсли;
		
		Для каждого СтрГП Из Грузоперевозки Цикл
			
			ГП = СтрГП.Значение.ПолучитьОбъект();
			// --- 
			Если (Параметры.фл1) Тогда
				СтрокаПараметра = CW_Мониторинг.СтрокаПараметра(ГП,ПараметрЗакрытия); 
				Если (СтрокаПараметра = Неопределено) Тогда
					СтрокаПараметра = ГП.ПараметрыГрузоперевозки.Добавить();
					СтрокаПараметра.Параметр = ПараметрЗакрытия;
				КонецЕсли; 
				СтрокаПараметра.ЗначениеФакт = Параметры.Дата;
				СтрокаПараметра.Значение = Параметры.Дата;
			КонецЕсли;
			Если (Параметры.фл1) Тогда
				СтрокаПараметра = CW_Мониторинг.СтрокаПараметра(ГП,ПараметрКонтроля); 
				Если (СтрокаПараметра = Неопределено) Тогда
					СтрокаПараметра = ГП.ПараметрыГрузоперевозки.Добавить();
					СтрокаПараметра.Параметр = ПараметрКонтроля;
				КонецЕсли; 
				СтрокаПараметра.ЗначениеФакт = Параметры.Дата;
				СтрокаПараметра.Значение = Параметры.Дата;
			КонецЕсли;
			// --- 
			ГП.Записать(); 
			
		КонецЦикла; 
		
		
	Исключение
		Сообщить(ОписаниеОшибки());
		Возврат(_УФКС.Ответ(1));
	КонецПопытки; 
	
	
	Возврат(_УФКС.Ответ());
	
	// --- 
КонецФункции
 
  
