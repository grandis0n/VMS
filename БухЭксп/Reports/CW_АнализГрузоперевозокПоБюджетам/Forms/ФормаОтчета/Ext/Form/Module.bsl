	ОбновитьТаблицы();
КонецПроцедуры

&НаКлиенте
Функция ПолучитьИмяТекущейТаблицы()
	
	ИмяТаблицы  = Неопределено;
	
	Попытка
		ИмяСтраницы = Элементы.ГруппаСтраницыБюджета.ТекущаяСтраница.ПодчиненныеЭлементы[0].ТекущаяСтраница.Имя;
		ИмяТаблицы 	= СтрЗаменить(ИмяСтраницы,"Группа","");
	Исключение
	КонецПопытки;
	
	Возврат ИмяТаблицы;
	
КонецФункции	

&НаКлиенте
Процедура ОбновитьТаблицу(Команда)
	
	ИмяТаблицы = ПолучитьИмяТекущейТаблицы();
	
	ОбновитьТаблицы(ИмяТаблицы);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуБюджета(ВыбраннаяСтрока)
	
	Возврат;
	
	ИмяТаблицы 		= ПолучитьИмяТекущейТаблицы();
	ВерсияБюджета 	= ПредопределенноеЗначение("Справочник.CW_ВерсииБюджетов.ПустаяСсылка");
	ВидСтатьи		= ПредопределенноеЗначение("Перечисление.CW_ВидыСтатейПланирования.ПустаяСсылка");
	
	Если Найти(ИмяТаблицы,"План") > 0 Тогда
		
		ВерсияБюджета = ВерсияБюджетаПлан;
		
	ИначеЕсли Найти(ИмяТаблицы,"Факт") = 0 Тогда	
		
		ВерсияБюджета = ВерсияБюджетаФакт;
		
	Иначе
		
		Возврат;
		
	КонецЕсли;
	
	Если Найти(ИмяТаблицы,"Доход") > 0 Тогда
		
		ВидСтатьи = ПредопределенноеЗначение("Перечисление.CW_ВидыСтатейПланирования.Доходы");
		
	ИначеЕсли Найти(ИмяТаблицы,"Расход") > 0 Тогда	
		
		ВидСтатьи = ПредопределенноеЗначение("Перечисление.CW_ВидыСтатейПланирования.Расходы");
		
	КонецЕсли;	
	
	СтрокаТаблицы = Элементы["Бюджет" + ИмяТаблицы].ТекущиеДанные;
	
	Если СтрокаТаблицы = Неопределено Тогда
		Возврат;
	КонецЕсли;	
	
	ДанныеЗаполнения = Новый Структура();
	ДанныеЗаполнения.Вставить("ЗаказСсылка",           	Заказ);
	ДанныеЗаполнения.Вставить("ВерсияБюджета",         	ВерсияБюджета);
	ДанныеЗаполнения.Вставить("ВидСтатьиПланирования", 	ВидСтатьи);
	ДанныеЗаполнения.Вставить("Контрагент",            	СтрокаТаблицы.Контрагент);
	ДанныеЗаполнения.Вставить("Номенклатура",          	СтрокаТаблицы.Номенклатура);
	ДанныеЗаполнения.Вставить("Валюта",                	СтрокаТаблицы.Валюта);
	ДанныеЗаполнения.Вставить("СтавкаНДС",             	СтрокаТаблицы.СтавкаНДС);
	ДанныеЗаполнения.Вставить("Организация",			СтрокаТаблицы.Организация);
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ДанныеЗаполнения",			ДанныеЗаполнения);
	ПараметрыФормы.Вставить("ТолькоПросмотр", 			Истина);
	
	Описание = Новый ОписаниеОповещения("ПослеЗакрытияПодчиненнойФормы",ЭтотОбъект,Новый Структура("ИмяТаблицы",ИмяТаблицы));
	
	ОткрытьФорму("Справочник.CW_ПлановыеСтатьиЗатратИДоходов.Форма.ФормаРедактированияГруппыСтатей", ПараметрыФормы, ЭтаФорма,,,,Описание);
	
КонецПроцедуры	

&НаКлиенте
Процедура ПослеЗакрытияПодчиненнойФормы(Результат,СтруктураПараметров) Экспорт
	
	ИмяТаблицы = Неопределено;
	СтруктураПараметров.Свойство("ИмяТаблицы",ИмяТаблицы);
	
	ОбновитьТаблицы(ИмяТаблицы);
	
КонецПроцедуры	

&НаКлиенте
Процедура БюджетДоходыПланВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка 	= Ложь;
	ОткрытьФормуБюджета(ВыбраннаяСтрока);

КонецПроцедуры

&НаКлиенте
Процедура БюджетДоходыПланПередНачаломИзменения(Элемент, Отказ)
	
	Отказ = Истина;
	ОткрытьФормуБюджета(Элемент.ТекущийЭлемент);

КонецПроцедуры

&НаКлиенте
Процедура ГрузоперевозкиПослеУдаления(Элемент)
	ОбновитьТаблицы();
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьГрузоперевозкиПоЗаказу()
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	CW_Грузоперевозки.Ссылка
	               |ИЗ
	               |	Справочник.CW_Грузоперевозки КАК CW_Грузоперевозки
	               |ГДЕ
	               |	CW_Грузоперевозки.Заказ = &Заказ
	               |	И CW_Грузоперевозки.Заказ <> ЗНАЧЕНИЕ(Справочник.CW_Заказы.ПустаяСсылка)";
				   
	Запрос.УстановитьПараметр("Заказ", Заказ);			   
	
	Грузоперевозки.ЗагрузитьЗначения(Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка"));
	
	ОбновитьТаблицы();
	
КонецПроцедуры	

&НаКлиенте
Процедура ПриВыбореЗаказа(Ответ,Параметры) Экспорт
	
	Если Не Ответ = КодВозвратаДиалога.Да Тогда
		
		Заказ = ЗаказДоИзм;
		Возврат;
		
	КонецЕсли;	
	
	ЗаказДоИзм = Заказ;
	ЗаполнитьГрузоперевозкиПоЗаказу();
	
КонецПроцедуры	

&НаКлиенте
Процедура ЗаказПриИзменении(Элемент)
	
	Если Не Грузоперевозки.Количество() Тогда
		
		ЗаказДоИзм = Заказ;
		ЗаполнитьГрузоперевозкиПоЗаказу();
		
		Возврат;
	КонецЕсли;	
	
	Если Заказ <> ЗаказДоИзм И ЗначениеЗаполнено(ЗаказДоИзм) Тогда
		
		Описание = Новый ОписаниеОповещения("ПриВыбореЗаказа", ЭтотОбъект, Новый Структура("Заказ",Заказ));
		
		ПоказатьВопрос(Описание, "Список грузоперевозок будет " +?(ЗначениеЗаполнено(Заказ),"очищен", "перезаполнен") + ", продолжить?",РежимДиалогаВопрос.ДаНетОтмена,,КодВозвратаДиалога.Да);
		
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуДокумента()
	
	ИмяТаблицы		= ПолучитьИмяТекущейТаблицы();
	СтрокаТаблицы 	= Элементы[ИмяТаблицы].ТекущиеДанные;
	 
	 Если СтрокаТаблицы = Неопределено Тогда
		 Возврат;
	 КонецЕсли;
	 
	 Документ = СтрокаТаблицы.Документ;
		
	Если ИмяТаблицы = "ФинансыРасходы" Тогда
		
		ИмяФормыДокумента = "Документ.CW_РасходыПоГрузоперевозке.ФормаОбъекта";
		
	ИначеЕсли ИмяТаблицы = "ФинансыДоходы" Тогда 
		
		ИмяФормыДокумента = "Документ.CW_ДоходыПоГрузоперевозке.ФормаОбъекта";
		
	КонецЕсли; 
	
	Попытка
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("Ключ", Документ);
		ОткрытьФорму(ИмяФормыДокумента, ПараметрыФормы,ЭтаФорма);
	Исключение
	КонецПопытки; 
	
КонецПроцедуры	
	
&НаКлиенте
Процедура ФинансыДоходыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ОткрытьФормуДокумента();
	
КонецПроцедуры

&НаКлиенте
Процедура ФинансыДоходыПередНачаломИзменения(Элемент, Отказ)
	
	Отказ = Истина;
	ОткрытьФормуДокумента();
	
КонецПроцедуры

