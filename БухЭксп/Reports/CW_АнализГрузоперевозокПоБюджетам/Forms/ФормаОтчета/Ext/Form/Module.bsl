Функция ПолучитьФинРез(ГП,ОтображениеФинРеза=Неопределено) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЕСТЬNULL(CW_ДоходыПоГрузоперевозкам.Всего, 0) КАК ДоходыВсего,
		|	ЕСТЬNULL(CW_ДоходыПоГрузоперевозкам.Сумма, 0) КАК ДоходыСумма,
		|	0 КАК РасходыВсего,
		|	0 КАК РасходыСумма,
		|	ЕСТЬNULL(CW_ДоходыПоГрузоперевозкам.Всего_Валюта, 0) КАК ДоходыВсегоВалюта,
		|	0 КАК РасходыВсегоВалюта,
		|	CW_ДоходыПоГрузоперевозкам.Контрагент,
		|	CW_ДоходыПоГрузоперевозкам.Номенклатура
		|ПОМЕСТИТЬ Рез
		|ИЗ
		|	РегистрНакопления.CW_ДоходыПоГрузоперевозкам КАК CW_ДоходыПоГрузоперевозкам
		|ГДЕ
		|	CW_ДоходыПоГрузоперевозкам.Грузоперевозка В(&СпГП)
		|	И ВЫБОР
		|			КОГДА &ФормированиеОтчета = 0
		|				ТОГДА CW_ДоходыПоГрузоперевозкам.ДокументДоходов.ФормируетсяАкт
		|			ИНАЧЕ CW_ДоходыПоГрузоперевозкам.ДокументДоходов.ФормируетсяСчет
		|		КОНЕЦ
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	0,
		|	0,
		|	ЕСТЬNULL(CW_РасходыПоГрузоперевозкам.Всего, 0),
		|	ЕСТЬNULL(CW_РасходыПоГрузоперевозкам.Сумма, 0),
		|	0,
		|	ЕСТЬNULL(CW_РасходыПоГрузоперевозкам.Всего_Валюта, 0),
		|	CW_РасходыПоГрузоперевозкам.Контрагент,
		|	CW_РасходыПоГрузоперевозкам.Номенклатура
		|ИЗ
		|	РегистрНакопления.CW_РасходыПоГрузоперевозкам КАК CW_РасходыПоГрузоперевозкам
		|ГДЕ
		|	CW_РасходыПоГрузоперевозкам.Грузоперевозка В(&СпГП)
		|	И ВЫБОР
		|			КОГДА &ФормированиеОтчета = 0
		|				ТОГДА CW_РасходыПоГрузоперевозкам.ДокументРасходов.ПредъявленАкт
		|						ИЛИ CW_РасходыПоГрузоперевозкам.ДокументРасходов.ПредъявленСФ
		|			ИНАЧЕ CW_РасходыПоГрузоперевозкам.ДокументРасходов.ПредъявленСчет
		|		КОНЕЦ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СУММА(Рез.ДоходыВсего) КАК ДоходыВсего,
		|	СУММА(Рез.ДоходыСумма) КАК ДоходыСумма,
		|	СУММА(Рез.РасходыВсего) КАК РасходыВсего,
		|	СУММА(Рез.РасходыСумма) КАК РасходыСумма,
		|	СУММА(Рез.ДоходыВсего - Рез.РасходыВсего) КАК ПрибыльВсего,
		|	СУММА(Рез.ДоходыСумма - Рез.РасходыСумма) КАК ПрибыльСумма,
		|	СУММА(Рез.ДоходыВсегоВалюта - Рез.РасходыВсегоВалюта) КАК ПрибыльВсегоВалюта,
		|	СУММА(Рез.ДоходыВсегоВалюта) КАК ДоходыВсегоВалюта,
		|	СУММА(Рез.РасходыВсегоВалюта) КАК РасходыВсегоВалюта,
		|	Рез.Контрагент,
		|	Рез.Номенклатура
		|ИЗ
		|	Рез КАК Рез
		|
		|СГРУППИРОВАТЬ ПО
		|	Рез.Контрагент,
		|	Рез.Номенклатура";
	Запрос.УстановитьПараметр("СпГП", ГП);
	Если (ОтображениеФинРеза <> Неопределено) Тогда
		Запрос.УстановитьПараметр("ФормированиеОтчета", ОтображениеФинРеза); 
	Иначе
		Запрос.УстановитьПараметр("ФормированиеОтчета", _БЭ.ПолучитьНастройкуПользователя( , "ОтображениеФинРез")); 	
	КонецЕсли; 
	
	ТЗ = Запрос.Выполнить().Выгрузить();
	
	ИсключатьВнутрихолдинговые = CW_Настройки.ПолучитьНастройкуПользователя(,"ИсключатьВнутрихолдинговыеВзаиморасчеты");
	Если (ИсключатьВнутрихолдинговые) Тогда
		
		МассивХолдинговыхКонтрагентов = CW_Финансы.ПолучитьКонтрагентовХолдинга();
		Если (МассивХолдинговыхКонтрагентов.Количество() <> 0) Тогда
			МассивУдаляемых = Новый Массив;
			Для каждого Стр Из ТЗ Цикл
				
				Если (МассивХолдинговыхКонтрагентов.Найти(Стр.Контрагент) <> Неопределено) Тогда
					МассивУдаляемых.Добавить(Стр);
				КонецЕсли; 
				
			КонецЦикла; 
			_сф.к_УдалитьЭлементыПоМассиву(ТЗ,МассивУдаляемых);
			
		КонецЕсли; 
		
	КонецЕсли; 
	
	Если (ЗначениеЗаполнено(Номенклатура)) Тогда
		
		ТЗ = ТЗ.Скопировать(Новый Структура("Номенклатура"));
		
	КонецЕсли; 
	
	ТЗ.Свернуть(,"ДоходыВсего,ДоходыСумма,РасходыВсего,РасходыСумма,ПрибыльВсего,ПрибыльСумма,ПрибыльВсегоВалюта,ДоходыВсегоВалюта,РасходыВсегоВалюта");
	
	Возврат ТЗ;
	
КонецФункции	

Функция ФинансыОбновитьИтоги()
	
	ФорматВывода = "ЧЦ=15; ЧДЦ=2; ЧН=";

	ФинРез = _БЭ.ПолучитьФинРез(Грузоперевозки);

	СчетаАкты = "";
	Если ФормированиеОтчета = 1 Тогда
		СчетаАкты = " (по актам)";
	Иначе
		СчетаАкты = " (по счетам)";
	КонецЕсли;

	ВыводитьРезультатВБазовойВалюте = Истина;
	ВыводитьРасходыВБазовойВалюте 	= Истина;
	ВыводитьДоходыВБазовойВалюте 	= Истина;
	
	Если ВыводитьРезультатВВалютеДокументов Тогда

		ОбщаяВалюта = Справочники.Валюты.ПустаяСсылка();
		
		ВалютыРасходов = ФинансыРасходы.Выгрузить(, "Валюта");
		ВалютыРасходов.Свернуть("Валюта");
		
		ВалютыДоходов = ФинансыДоходы.Выгрузить(, "Валюта");
		ВалютыДоходов.Свернуть("Валюта");

		Если ВалютыРасходов.Количество() = 1 Тогда
			ВалютаРасходов = ВалютыРасходов[0].Валюта;
			ВыводитьРасходыВБазовойВалюте = Ложь;
		Иначе
			ВалютаРасходов = Справочники.Валюты.ПустаяСсылка();
		КонецЕсли;

		Если ВалютыДоходов.Количество() = 1 Тогда
			ВалютаДоходов = ВалютыДоходов[0].Валюта;
			ВыводитьДоходыВБазовойВалюте = Ложь;
		Иначе
			ВалютаДоходов = Справочники.Валюты.ПустаяСсылка();
		КонецЕсли;

		Если ВалютаРасходов = ВалютаДоходов И Не ВалютаРасходов.Пустая() Тогда
			ВыводитьРезультатВБазовойВалюте = Ложь;
			ОбщаяВалюта = ВалютаРасходов;
		ИначеЕсли ВалютаРасходов.Пустая() И Не ВалютаДоходов.Пустая() И ВалютыРасходов.Количество() = 0 Тогда
			ВыводитьРезультатВБазовойВалюте = Ложь;
			ОбщаяВалюта = ВалютаДоходов;
		ИначеЕсли Не ВалютаРасходов.Пустая() И ВалютаДоходов.Пустая() И ВалютыДоходов.Количество() = 0 Тогда
			ВыводитьРезультатВБазовойВалюте = Ложь;
			ОбщаяВалюта = ВалютаРасходов;
		КонецЕсли;

	КонецЕсли;

	Если ВыводитьРасходыВБазовойВалюте Тогда


		ТекстИтога = "";
		_сф.стр_Добавить(ТекстИтога, "Расходы" + СчетаАкты + ": " + Формат(ФинРез.Итог("РасходыВсего"), ФорматВывода) + " " + Строка(ВРУ));
		_сф.стр_Добавить(ТекстИтога, ", " + "расходы без НДС: " + Формат(ФинРез.Итог("РасходыСумма"), ФорматВывода) + " " + Строка(ВРУ));
		Если (ЗначениеЗаполнено(Номенклатура)) Тогда
			_сф.стр_Добавить(ТекстИтога,"; Номенклатура="+Строка(Номенклатура));
		КонецЕсли; 
		
	Иначе


		ТекстИтога = "";
		_сф.стр_Добавить(ТекстИтога, "Расходы" + СчетаАкты + ": " + Формат(ФинРез.Итог("РасходыВсегоВалюта"), ФорматВывода) + " " + Строка(ВалютаРасходов));
		Если (ЗначениеЗаполнено(Номенклатура)) Тогда
			_сф.стр_Добавить(ТекстИтога,"; Номенклатура="+Строка(Номенклатура));
		КонецЕсли;

	КонецЕсли;
	
	Элементы.РасходыИтого.Заголовок = ТекстИтога;

	Если ВыводитьДоходыВБазовойВалюте Тогда

		ТекстИтога = "";
		_сф.стр_Добавить(ТекстИтога, "Доходы" + СчетаАкты + ": " + Формат(ФинРез.Итог("ДоходыВсего"), ФорматВывода) + " " + Строка(ВРУ));
		_сф.стр_Добавить(ТекстИтога, ", " + "доходы без НДС: " + Формат(ФинРез.Итог("ДоходыСумма"), ФорматВывода) + " " + Строка(ВРУ));
		Если (ЗначениеЗаполнено(Номенклатура)) Тогда
			_сф.стр_Добавить(ТекстИтога,"; Номенклатура="+Строка(Номенклатура));
		КонецЕсли;
		
	Иначе

		ТекстИтога = "";
		_сф.стр_Добавить(ТекстИтога, "Доходы" + СчетаАкты + ": " + Формат(ФинРез.Итог("ДоходыВсегоВалюта"), ФорматВывода) + " " + Строка(ВалютаДоходов));
		Если (ЗначениеЗаполнено(Номенклатура)) Тогда
			_сф.стр_Добавить(ТекстИтога,"; Номенклатура="+Строка(Номенклатура));
		КонецЕсли;

	КонецЕсли;
	
	Элементы.ДоходыИтого.Заголовок = ТекстИтога;

	Если ВыводитьРезультатВБазовойВалюте Тогда

		ТекстИтога = "";
		_сф.стр_Добавить(ТекстИтога, "Прибыль" + СчетаАкты + ": " + Формат(ФинРез.Итог("ПрибыльВсего"), ФорматВывода) + " " + Строка(ВРУ));
		_сф.стр_Добавить(ТекстИтога, ", " + "прибыль без НДС: " + Формат(ФинРез.Итог("ПрибыльСумма"), ФорматВывода) + " " + Строка(ВРУ));
		Если (ЗначениеЗаполнено(Номенклатура)) Тогда
			_сф.стр_Добавить(ТекстИтога,"; Номенклатура="+Строка(Номенклатура));
		КонецЕсли;
		
	Иначе


		ТекстИтога = "";
		_сф.стр_Добавить(ТекстИтога, "Прибыль" + СчетаАкты + ": " + Формат(ФинРез.Итог("ПрибыльВсегоВалюта"), ФорматВывода) + " " + Строка(ОбщаяВалюта));
		Если (ЗначениеЗаполнено(Номенклатура)) Тогда
			_сф.стр_Добавить(ТекстИтога,"; Номенклатура="+Строка(Номенклатура));
		КонецЕсли;

	КонецЕсли;
	
	Элементы.ФинансовыйРезультатИтого.Заголовок = ТекстИтога;

КонецФункции

