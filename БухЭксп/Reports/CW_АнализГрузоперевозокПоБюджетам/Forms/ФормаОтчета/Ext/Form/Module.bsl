&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Инициализация();
	// если переданы параметры - выполняем отчёт
	Если Параметры.Свойство("Грузоперевозки") Тогда
		
		Грузоперевозки 		= Параметры.Грузоперевозки;
		ВерсияБюджетаПлан 	= _сф.ст_ПолучитьСвойство(Параметры,"ВерсияБюджетаПлан",Константы.CW_БазоваяВерсияБюджета.Получить());
		ВерсияБюджетаФакт 	= _сф.ст_ПолучитьСвойство(Параметры,"ВерсияБюджетаФакт",Справочники.CW_ВерсииБюджетов.Основная);
		Валюта				= Константы.ВалютаРегламентированногоУчета.Получить();
		
		Если Грузоперевозки.Количество() Тогда
			Заказ			= Грузоперевозки[0].Значение.Заказ;
		КонецЕсли;	
			
		СформироватьПриОткрытии = Истина;
		
		Элементы.Страницы.ТекущаяСтраница = Элементы.ГруппаРезультат;
		
	Иначе
		
		Элементы.Страницы.ТекущаяСтраница = Элементы.ГруппаНастройкиОтчета;
				
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Элементы.ФормаНастройка.Пометка = Истина;
	
	Если СформироватьПриОткрытии Тогда
		СформироватьПриОткрытии = Ложь;
		НастроитьПоказателиОтчета();
		_Настройка(Истина);
		СформироватьОтчет();
	Иначе	
		_ВосстановитьСтандартныеНастройки();
		_ВосстановитьСеансовуюНастройку();
	КонецЕсли; 
	
	ЗаказДоИзм = Заказ;
	ОбновитьТаблицы();
	
КонецПроцедуры

