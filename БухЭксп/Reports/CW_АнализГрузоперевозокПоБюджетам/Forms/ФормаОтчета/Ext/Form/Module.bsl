		КонецЕсли;
		Элементы.БюджетФактФинансовыйРезультатИтого.Заголовок = "Прибыль: " + Формат(тзБюджетДоходыФакт.Итог("СуммаВсегоРуб") - тзБюджетРасходыФакт.Итог("СуммаВсегоРуб"), ФорматВывода) + " " + Строка(ВРУ) + ", прибыль без НДС: " + Формат(БюджетДоходыФакт.Итог("СуммаРуб") - БюджетРасходыФакт.Итог("СуммаРуб"), ФорматВывода) + " " + Строка(ВРУ);
