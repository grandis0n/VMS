&НаСервере
Процедура _ПолучитьОстаткиАктирования()
	// --- 
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	CW_АктированиеИсходящихСчетовОстатки.Счет,
	               |	CW_АктированиеИсходящихСчетовОстатки.Грузоперевозка,
	               |	CW_АктированиеИсходящихСчетовОстатки.Номенклатура,
	               |	CW_АктированиеИсходящихСчетовОстатки.ВсегоОстаток КАК Всего
	               |ИЗ
	               |	РегистрНакопления.CW_АктированиеИсходящихСчетов.Остатки(&Период, Грузоперевозка В (&Грузоперевозки)) КАК CW_АктированиеИсходящихСчетовОстатки";
	Запрос.УстановитьПараметр("Период", ТекущаяДата());
	Запрос.УстановитьПараметр("Грузоперевозки", Грузоперевозки.ВыгрузитьЗначения()); 
	ТЗ = Запрос.Выполнить().Выгрузить();
	СуммаНеактированныхИсходящих = ТЗ.Итог("Всего");
	
	Если (СуммаНеактированныхИсходящих = 0) Тогда
		
		НеактированоИсходящих = "Все исходящие счета заактированы";
		
	Иначе
		
		НеактированоИсходящих = "Имеются незаактированные исходящие счета";
		
	КонецЕсли; 
	
	// --- 
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	CW_АктированиеВходящихСчетовОстатки.Счет,
	               |	CW_АктированиеВходящихСчетовОстатки.Грузоперевозка,
	               |	CW_АктированиеВходящихСчетовОстатки.Номенклатура,
	               |	CW_АктированиеВходящихСчетовОстатки.ВсегоОстаток КАК Всего
	               |ИЗ
	               |	РегистрНакопления.CW_АктированиеВходящихСчетов.Остатки(&Период, Грузоперевозка В (&Грузоперевозки)) КАК CW_АктированиеВходящихСчетовОстатки";
	Запрос.УстановитьПараметр("Период", ТекущаяДата());
	Запрос.УстановитьПараметр("Грузоперевозки", Грузоперевозки.ВыгрузитьЗначения()); 
	ТЗ = Запрос.Выполнить().Выгрузить();
	СуммаНеактированныхВходящих = ТЗ.Итог("Всего");
	
	Если (СуммаНеактированныхВходящих = 0) Тогда
		
		НеактированоВходящих = "Все входящие счета заактированы";
		
	Иначе
		
		НеактированоВходящих = "Имеются незаактированные входящие счета";
		
	КонецЕсли;
	
	// --- 
КонецПроцедуры
 

&НаКлиенте
Процедура РезультатОбработкаРасшифровки(Элемент, Расшифровка, СтандартнаяОбработка)
	
	Перем ВыполненноеДействие;
	
	Ответ = _РежимРасшифровки(Расшифровка);
    СтандартнаяОбработка = Ложь;
	Возврат; // тмп	
	
	ОбработкаРасшифровки = Новый ОбработкаРасшифровкиКомпоновкиДанных(ДанныеРасшифровки, Новый ИсточникДоступныхНастроекКомпоновкиДанных(ПолучитьURLСхемы()));
	// ---------------------------------------------------------------------------- 
	
    ДоступныеДействия = Новый Массив();
    ДоступныеДействия.Добавить(ДействиеОбработкиРасшифровкиКомпоновкиДанных.ОткрытьЗначение);
	ДоступныеДействия.Добавить(ДействиеОбработкиРасшифровкиКомпоновкиДанных.Отфильтровать);
    
	// Осуществим выбор действия расшифровки пользователем
	ПОВ = Новый ОписаниеОповещения("ОбработкаВыбораДействияРасшифровки",ЭтотОбъект, Новый Структура("Расшифровка",Расшифровка)); 
	ОбработкаРасшифровки.ПоказатьВыборДействия(ПОВ,Расшифровка, ДоступныеДействия, , Истина);
   	
КонецПроцедуры

&НаСервере
Функция _РежимРасшифровки(Расшифровка)
	// --- 
	
	ДР = ПолучитьИзВременногоХранилища(ДанныеРасшифровки);
	ЭлементРасшифровки = ДР.Элементы.Получить(Расшифровка);
	
	Поля = ЭлементРасшифровки.ПолучитьПоля();
	Если (Поля.Количество() <> 0) Тогда
		
		ИмяПоля = Поля[0].Поле;
		//Сообщить(ИмяПоля);
		Номенклатура = Неопределено;
		// --- 
		Номенклатура = ДР.Элементы.Получить(ЭлементРасшифровки.ПолучитьРодителей()[0].Идентификатор).ПолучитьПоля()[0].Значение;
		
		Если (ИмяПоля = "ПланРасход") Тогда
			
			Элементы.ГруппаСтраницыБюджета.ТекущаяСтраница = Элементы.ГруппаПлан;
			Элементы.ГруппаДоходыРасходыПлан.ТекущаяСтраница = Элементы.ГруппаРасходыПлан;
			
		ИначеЕсли (ИмяПоля = "ПланДоход") Тогда 
			
			Элементы.ГруппаСтраницыБюджета.ТекущаяСтраница = Элементы.ГруппаПлан;
			Элементы.ГруппаДоходыРасходыПлан.ТекущаяСтраница = Элементы.ГруппаДоходыПлан; 
			
		ИначеЕсли (ИмяПоля = "ФактРасход") Тогда 
			
			Элементы.ГруппаСтраницыБюджета.ТекущаяСтраница = Элементы.ГруппаФакт;
			Элементы.ГруппаДоходыРасходыФакт.ТекущаяСтраница = Элементы.ГруппаРасходыФакт;
			
		ИначеЕсли (ИмяПоля = "ФактДоход") Тогда 
			
			Элементы.ГруппаСтраницыБюджета.ТекущаяСтраница = Элементы.ГруппаФакт;
			Элементы.ГруппаДоходыРасходыФакт.ТекущаяСтраница = Элементы.ГруппаДоходыФакт;
			
		ИначеЕсли (ИмяПоля = "ФинансыРасход") Тогда 
			
			Элементы.ГруппаСтраницыБюджета.ТекущаяСтраница = Элементы.ГруппаФинансы;
			Элементы.ГруппаДоходыРасходыФинансы.ТекущаяСтраница = Элементы.ГруппаФинансыРасходы;
			
		ИначеЕсли (ИмяПоля = "ФинансыДоход") Тогда 
			
			Элементы.ГруппаСтраницыБюджета.ТекущаяСтраница = Элементы.ГруппаФинансы;
			Элементы.ГруппаДоходыРасходыФинансы.ТекущаяСтраница = Элементы.ГруппаФинансыДоходы;
			
		КонецЕсли; 
		
	Иначе
		
		//_ОтборПоНоменклатуре(Неопределено);
		
	КонецЕсли; 
	
	
	Если (Номенклатура <> Неопределено) Тогда
		
		_ОтборПоНоменклатуре(Номенклатура);
		
	КонецЕсли; 
	
	// ЭлементРасшифровки.ПолучитьПоля()[0].Поле // ФинансыДоход
	//ДР.Элементы.Получить(ЭлементРасшифровки.ПолучитьРодителей()[0]).Значение // Номенклатура
	
	Возврат(_УФКС.Ответ());
	
	// --- 
КонецФункции

&НаСервере
Процедура _ОтборПоНоменклатуре(Номенклатура)
	// --- 
	
	Если (Номенклатура = Неопределено) Тогда
		Отбор = Неопределено;
	Иначе
		Отбор = Новый ФиксированнаяСтруктура(Новый Структура("Номенклатура",Номенклатура));	
	КонецЕсли; 
	// --- 
	Элементы.БюджетРасходыПлан.ОтборСтрок = Отбор;
	Элементы.БюджетДоходыПлан.ОтборСтрок = Отбор;
	Элементы.БюджетРасходыФакт.ОтборСтрок = Отбор;
	Элементы.БюджетДоходыФакт.ОтборСтрок = Отбор;
	БюджетОбновитьИтоги(Истина,Истина);	
	// --- 
	Элементы.ФинансыРасходы.ОтборСтрок = Отбор;
	Элементы.ФинансыДоходы.ОтборСтрок = Отбор;
	ФинансыОбновитьИтоги();
	
	// --- 
КонецПроцедуры
 

&НаКлиенте
Процедура ОбработкаВыбораДействияРасшифровки(ВыполненноеДействие, ПараметрВыполненногоДействия, ДополнительныеПараметры) Экспорт 
	// --- 
	
	Если (ВыполненноеДействие <> Неопределено) Тогда
		
		Если ВыполненноеДействие = ДействиеОбработкиРасшифровкиКомпоновкиДанных.ОткрытьЗначение Тогда
            ПоказатьЗначение(,ПараметрВыполненногоДействия);    
		ИначеЕсли ВыполненноеДействие = ДействиеОбработкиРасшифровкиКомпоновкиДанных.Отфильтровать Тогда 
            НовыеНастройки = ПрименитьНастройкиСКД(ДополнительныеПараметры.Расшифровка, ПараметрВыполненногоДействия);
		КонецЕсли;
		
		// --- 
		
		Если (НовыеНастройки <> Неопределено) Тогда
			
			// Пользователь выбрал действие, для которого нужно менять настройки
			Если ВыполненноеДействие = ДействиеОбработкиРасшифровкиКомпоновкиДанных.Отфильтровать ИЛИ 
				
				ВыполненноеДействие = ДействиеОбработкиРасшифровкиКомпоновкиДанных.Оформить Тогда
				Отчет.КомпоновщикНастроек.ЗагрузитьНастройки(НовыеНастройки);
				Отчет.АдресНастроек = _ПолучитьАдресНастроек();
				ЭтаФорма.СкомпоноватьРезультат();
				ОбработатьОтчет();
							
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли; 
	
	// --- 
КонецПроцедуры
 
