				Если (ЗначениеЗаполнено(Номенклатура)) Тогда
					_сф.стр_Добавить(Элементы[Соответствие.ЭлементИтогов].Заголовок, "; Номенклатура="+Строка(Номенклатура));
				КонецЕсли; 
				
			Иначе
				
				Элементы[Соответствие.ЭлементИтогов].Заголовок = "Доходы: " + Формат(ТаблицаБюджета.Итог("СуммаВсего"), ФорматВывода) + " " + Строка(ВалютаДоходов);
				Если (ЗначениеЗаполнено(Номенклатура)) Тогда
					_сф.стр_Добавить(Элементы[Соответствие.ЭлементИтогов].Заголовок, "; Номенклатура="+Строка(Номенклатура));
				КонецЕсли;
				
