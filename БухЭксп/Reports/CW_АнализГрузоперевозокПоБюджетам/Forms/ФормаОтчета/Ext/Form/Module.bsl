&НаКлиенте
Процедура Сформировать(Команда)
	
	ВсеХорошо = Истина;
	
	Если Не ЗначениеЗаполнено(ВерсияБюджетаПлан) Тогда
	
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Не заполнения версия бюджета (план)!";
		Сообщение.Сообщить(); 
		
		ВсеХорошо = Ложь;
	
	КонецЕсли; 
	
	Если Не ЗначениеЗаполнено(ВерсияБюджетаФакт) Тогда
	
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Не заполнения версия бюджета (факт)!";
		Сообщение.Сообщить(); 
		
		ВсеХорошо = Ложь;
	
	КонецЕсли; 
	
	Если Не ВсеХорошо Тогда
		Возврат;
	КонецЕсли; 
	
	//НастроитьПоказателиОтчета();
	
	Если Не ЗначениеЗаполнено(Заказ) И Грузоперевозки.Количество() Тогда
		
		Заказ = Грузоперевозки[0].Значение.Заказ;
		
	КонецЕсли;	
	
	Элементы.Страницы.ТекущаяСтраница = Элементы.ГруппаРезультат;
	
	_Настройка(Истина);
	// записываем настройки во временное хранилище
	Отчет.АдресНастроек = _ПолучитьАдресНастроек();
	ЭтаФорма.СкомпоноватьРезультат();
	
	ОбработатьОтчет();	
	Номенклатура=Неопределено;
	_ОтборПоНоменклатуре(Неопределено);
	
	// --- 
	
	_ПолучитьОстаткиАктирования();
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьОтчет()
	// --- 
		
	// записываем настройки во временное хранилище
	Отчет.АдресНастроек = _ПолучитьАдресНастроек();
	ЭтаФорма.СкомпоноватьРезультат();
	ОбработатьОтчет();	
	
	// --- 
	_СохранитьСеансовуюНастройку();
	
	// --- 
КонецПроцедуры

&НаСервере
Функция _ПолучитьАдресНастроек()
	// --- 
	
	Настройки = _сф.ст_Создать("Грузоперевозки,ВерсияБюджетаПлан,ВерсияБюджетаФакт,Организация,ФормированиеОтчета,Валюта,СписокПоказателей,Заказ");
	Настройки.Грузоперевозки 	 = Грузоперевозки;
	Настройки.ВерсияБюджетаПлан  = ВерсияБюджетаПлан;
	Настройки.ВерсияБюджетаФакт  = ВерсияБюджетаФакт;
	Настройки.Организация 		 = Организация;
	Настройки.ФормированиеОтчета = ФормированиеОтчета;
	Настройки.Валюта 			 = Валюта;
	Настройки.СписокПоказателей	 = СписокПоказателей;
	Настройки.Заказ				 = Заказ;
	
	Возврат(ПоместитьВоВременноеХранилище(Настройки,ЭтаФорма.УникальныйИдентификатор));
	
	// --- 
КонецФункции

&НаСервере
Функция ЗаменитьТекстВТаблицеРезультата(ТабДок, стрЧтоИщем, стрНаЧтоМеняем, НовоеГоризонтальноеПоложение = Неопределено, МаксНомерСтрокиПоиска = Неопределено, СловоЦеликом = Ложь) 
	
	ПредНайденнаяОбласть = Неопределено;
	
	Если ЗначениеЗаполнено(МаксНомерСтрокиПоиска) Тогда 
		ГдеИскать = ТабДок.Область(1,,МаксНомерСтрокиПоиска,);
	Иначе 
		ГдеИскать = Неопределено;
	КонецЕсли;
	
	Пока Истина Цикл
	
		НайденнаяОбласть = ТабДок.НайтиТекст(стрЧтоИщем, ПредНайденнаяОбласть, ГдеИскать); 
		Если Неопределено=НайденнаяОбласть Тогда 
			Прервать;
		Иначе 
			ПредНайденнаяОбласть = НайденнаяОбласть;
		КонецЕсли;
		
		// если кроме искомого слова ничего больше в данной области нет
		// тогда можно приступить к действиям по форматированию..
		//---------------------------------------------------------------
		Если СловоЦеликом и СтрЗаменить(НайденнаяОбласть.Текст, стрЧтоИщем, "") <> "" Тогда
			Продолжить;
		КонецЕсли;	
		
		Если стрЧтоИщем<>стрНаЧтоМеняем Тогда 
			
			НайденнаяОбласть.Текст = СтрЗаменить(НайденнаяОбласть.Текст, стрЧтоИщем, стрНаЧтоМеняем);
			
		КонецЕсли;
			
		Если НЕ Неопределено=НовоеГоризонтальноеПоложение Тогда 
			НайденнаяОбласть.ГоризонтальноеПоложение = НовоеГоризонтальноеПоложение;
		КонецЕсли;
		
	КонецЦикла;
	
	//НайденнаяОбласть.Шрифт =Новый Шрифт(НайденнаяОбласть.Шрифт, , 10);

КонецФункции


&НаСервере
Процедура ОбработатьОтчет()
	
	ЗаменитьТекстВТаблицеРезультата(Результат, "План"				, "План"				, ГоризонтальноеПоложение.Центр);
	ЗаменитьТекстВТаблицеРезультата(Результат, "Факт"				, "Факт"				, ГоризонтальноеПоложение.Центр);
	ЗаменитьТекстВТаблицеРезультата(Результат, "Бюджет Отклонение"	, "Бюджет Отклонение"	, ГоризонтальноеПоложение.Центр);
	ЗаменитьТекстВТаблицеРезультата(Результат, "Финансы"			, "Финансы"				, ГоризонтальноеПоложение.Центр);
	ЗаменитьТекстВТаблицеРезультата(Результат, "Финансы Отклонение"	, "Финансы Отклонение"	, ГоризонтальноеПоложение.Центр);
	ЗаменитьТекстВТаблицеРезультата(Результат, "Доход"				, "Доход"				, ГоризонтальноеПоложение.Центр);
	ЗаменитьТекстВТаблицеРезультата(Результат, "Расход"				, "Расход"				, ГоризонтальноеПоложение.Центр);
	ЗаменитьТекстВТаблицеРезультата(Результат, "Дельта План"		, "Дельта План"			, ГоризонтальноеПоложение.Центр);
	ЗаменитьТекстВТаблицеРезультата(Результат, "Дельта Факт"		, "Дельта Факт"			, ГоризонтальноеПоложение.Центр);
	
	ЗаменитьТекстВТаблицеРезультата(Результат, "Р" , "Р"	, ГоризонтальноеПоложение.Центр,,Истина);
	ЗаменитьТекстВТаблицеРезультата(Результат, "Д" , "Д"	, ГоризонтальноеПоложение.Центр,,Истина);
	ЗаменитьТекстВТаблицеРезультата(Результат, "П" , "П"	, ГоризонтальноеПоложение.Центр,,Истина);

	//Результат.ФиксацияСверху = Результат.ФиксацияСверху - 2;
	
	Результат.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	Результат.АвтоМасштаб = Истина;
	
КонецПроцедуры	

