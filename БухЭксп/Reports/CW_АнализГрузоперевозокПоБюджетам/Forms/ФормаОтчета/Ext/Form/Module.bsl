&НаСервере
Процедура _ВосстановитьСеансовуюНастройку()
	// --- 
	
	// пытаемся восстановить настройки
	Идентификатор 		= РеквизитФормыВЗначение("Отчет").Метаданные().Имя;
	СеансоваяНастройка	= ХранилищеСистемныхНастроек.Загрузить(Идентификатор, "Сеансовая");
	
	Если СеансоваяНастройка <> Неопределено Тогда
		
		Попытка
			
			Если Константы.CW_ИспользованиеБюджетирования.Получить() Тогда
				
				СеансоваяНастройка.Свойство("ВерсияБюджетаПлан",ВерсияБюджетаПлан);
				
				Если НЕ ЗначениеЗаполнено(ВерсияБюджетаПлан) Тогда
					ВерсияБюджетаПлан = Справочники.CW_ВерсииБюджетов.Основная();
				КонецЕсли;	
				
				СеансоваяНастройка.Свойство("ВерсияБюджетаФакт",ВерсияБюджетаФакт);
				
				Если НЕ ЗначениеЗаполнено(ВерсияБюджетаФакт) Тогда
					ВерсияБюджетаФакт = _ПолучитьБазовуюВерсиюБюджета();
				КонецЕсли;	
	
			КонецЕсли;	
			
			СеансоваяНастройка.Свойство("Организация"		,Организация);
			СеансоваяНастройка.Свойство("ФормированиеОтчета",ФормированиеОтчета);
			СеансоваяНастройка.Свойство("Валюта"			,Валюта);
			СеансоваяНастройка.Свойство("ПараметрЗакрытия",ПараметрЗакрытия);
			СеансоваяНастройка.Свойство("ПараметрКонтроля",ПараметрКонтроля);
			
			спПоказатели = Новый СписокЗначений;
			СеансоваяНастройка.Свойство("СписокПоказателей",спПоказатели);
			
			Если (СеансоваяНастройка.Свойство("НастройкиСКД")) Тогда
				
			КонецЕсли; 
			Отчет.КомпоновщикНастроек.ЗагрузитьНастройки(СеансоваяНастройка.НастройкиСКД);
			
			//Если Не спПоказатели = Неопределено И спПоказатели.Количество() Тогда
			//	СеансоваяНастройка.Свойство("СписокПоказателей",СписокПоказателей);
			//КонецЕсли;	
			
		Исключение
		    //ОписаниеОшибки()
		КонецПопытки; 
		
		
	КонецЕсли; 
	
	// --- 
КонецПроцедуры

&НаСервере
Процедура _СохранитьСеансовуюНастройку()
	// --- 
	
	СтруктураНастройки = Новый Структура();
	СтруктураНастройки.Вставить("ВерсияБюджетаПлан",ВерсияБюджетаПлан);
	СтруктураНастройки.Вставить("ВерсияБюджетаФакт",ВерсияБюджетаФакт);
	// --- 
	СтруктураНастройки.Вставить("ПараметрЗакрытия",ПараметрЗакрытия);
	СтруктураНастройки.Вставить("ПараметрКонтроля",ПараметрКонтроля);
	// --- 
	СтруктураНастройки.Вставить("Организация"		,Организация);
	СтруктураНастройки.Вставить("ФормированиеОтчета",ФормированиеОтчета);
	СтруктураНастройки.Вставить("Валюта"			,Валюта);
	//СтруктураНастройки.Вставить("СписокПоказателей"	,СписокПоказателей);
	СтруктураНастройки.Вставить("НастройкиСКД", Отчет.КомпоновщикНастроек.ПолучитьНастройки());
	
	Идентификатор = РеквизитФормыВЗначение("Отчет").Метаданные().Имя;
	
	ХранилищеСистемныхНастроек.Сохранить(Идентификатор, "Сеансовая", СтруктураНастройки);
	
	// --- 
КонецПроцедуры

