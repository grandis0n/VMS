&НаСервере
Функция ФинансыРасходыОбновить()
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	CW_РасходыПоГрузоперевозкам.Грузоперевозка КАК Грузоперевозка,
	               |	CW_РасходыПоГрузоперевозкам.Контрагент КАК Контрагент,
	               |	CW_РасходыПоГрузоперевозкам.Договор КАК Договор,
	               |	CW_РасходыПоГрузоперевозкам.ДокументРасходов КАК Документ,
	               |	CW_РасходыПоГрузоперевозкам.ДокументРасходов.ПредставлениеДокумента КАК ПредставлениеДокумента,
	               |	CW_РасходыПоГрузоперевозкам.Номенклатура КАК Номенклатура,
	               |	CW_РасходыПоГрузоперевозкам.Валюта КАК Валюта,
	               |	НЕ CW_РасходыПоГрузоперевозкам.ЭтоАкт КАК ЭтоСчет,
	               |	CW_РасходыПоГрузоперевозкам.Всего_Валюта КАК ВсегоВал,
	               |	CW_РасходыПоГрузоперевозкам.Всего КАК Всего,
	               |	CW_РасходыПоГрузоперевозкам.Сумма КАК Сумма,
	               |	CW_РасходыПоГрузоперевозкам.НДС КАК НДС,
	               |	CW_РасходыПоГрузоперевозкам.ДокументРасходов.Дата КАК Дата,
	               |	CW_РасходыПоГрузоперевозкам.ДокументРасходов.Организация КАК Организация,
	               |	CW_ОтсутствующиеОригиналыДокументов.Документ КАК ДокументБезОригиналов
	               |ПОМЕСТИТЬ ВТ
	               |ИЗ
	               |	РегистрНакопления.CW_РасходыПоГрузоперевозкам КАК CW_РасходыПоГрузоперевозкам
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.CW_ОтсутствующиеОригиналыДокументов КАК CW_ОтсутствующиеОригиналыДокументов
	               |		ПО CW_РасходыПоГрузоперевозкам.ДокументРасходов = CW_ОтсутствующиеОригиналыДокументов.Документ
	               |			И CW_РасходыПоГрузоперевозкам.Контрагент = CW_ОтсутствующиеОригиналыДокументов.Контрагент
	               |			И CW_РасходыПоГрузоперевозкам.Договор = CW_ОтсутствующиеОригиналыДокументов.Договор
	               |ГДЕ
	               |	CW_РасходыПоГрузоперевозкам.Грузоперевозка В(&мГрузоперевозок)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ.Грузоперевозка,
	               |	ВТ.Контрагент,
	               |	ВТ.Договор,
	               |	ВТ.Документ,
	               |	ВТ.ПредставлениеДокумента,
	               |	ВТ.Номенклатура,
	               |	ВТ.Валюта,
	               |	ВТ.ЭтоСчет,
	               |	ВТ.ВсегоВал,
	               |	ВТ.Всего,
	               |	ВТ.Сумма,
	               |	ВТ.НДС,
	               |	ВТ.Дата,
	               |	ВТ.Организация,
	               |	ВЫБОР
	               |		КОГДА ЕСТЬNULL(ВТ.ДокументБезОригиналов, ИСТИНА) = ИСТИНА
	               |			ТОГДА ИСТИНА
	               |		ИНАЧЕ ЛОЖЬ
	               |	КОНЕЦ КАК ОригиналыПредоставлены,
	               |	ВЫРАЗИТЬ("""" КАК СТРОКА(500)) КАК НомерКонтейнера
	               |ИЗ
	               |	ВТ КАК ВТ
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ВТ.Контрагент,
	               |	ВТ.Договор,
	               |	ВТ.Документ,
	               |	ВТ.Номенклатура,
	               |	ВТ.Валюта,
	               |	ВТ.Грузоперевозка,
	               |	ВТ.ЭтоСчет";
		
	Запрос.УстановитьПараметр("мГрузоперевозок", Грузоперевозки.ВыгрузитьЗначения());
	
	тЗапроса = Запрос.Выполнить().Выгрузить();
	
	ТЗ = тЗапроса.Скопировать();

	ТЗ.Свернуть("Контрагент,Номенклатура,Организация,Документ,Дата,ПредставлениеДокумента,Валюта,ЭтоСчет,ОригиналыПредоставлены,ПредставлениеДокумента,НомерКонтейнера", "ВсегоВал,Всего,Сумма,НДС");
	ТЗ.Сортировать("Дата Возр");
	
	Для каждого СтрокаТЗ Из ТЗ Цикл
		
		мСтрок = тЗапроса.НайтиСтроки(Новый Структура("Документ",СтрокаТЗ.Документ));
		
		Для каждого СтрокаМассива из мСтрок Цикл
			
			Если Найти(СтрокаТЗ.НомерКонтейнера, СтрокаМассива.Грузоперевозка) <> 0 Тогда
				Продолжить;
			КонецЕсли;
			
			СтрокаТЗ.НомерКонтейнера = СтрокаТЗ.НомерКонтейнера + СокрЛП(СтрокаМассива.Грузоперевозка) + ", ";
		КонецЦикла;
		
		Если Прав(СокрЛП(СтрокаТЗ.НомерКонтейнера),1) = "," Тогда
			СтрокаТЗ.НомерКонтейнера = Лев(СтрокаТЗ.НомерКонтейнера,СтрДлина(СтрокаТЗ.НомерКонтейнера) - 2);
		КонецЕсли;
		
	КонецЦикла;	
			
	ФинансыРасходы.Загрузить(ТЗ);

	ТЗД = ТЗ.Скопировать(, "Документ");                              
	ТЗД.Свернуть("Документ");
	
	КоличествоЗатратных = ТЗД.Количество();
	
	Элементы.ГруппаФинансыРасходы.Заголовок = "Расходы" + ?(КоличествоЗатратных = 0, "", " (" + Строка(КоличествоЗатратных) + ")");

КонецФункции

&НаСервере
Функция ФинансыДоходыОбновить()
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	CW_ДоходыПоГрузоперевозкам.Грузоперевозка КАК Грузоперевозка,
	               |	CW_ДоходыПоГрузоперевозкам.Контрагент КАК Контрагент,
	               |	CW_ДоходыПоГрузоперевозкам.Договор КАК Договор,
	               |	CW_ДоходыПоГрузоперевозкам.ДокументДоходов КАК Документ,
	               |	CW_ДоходыПоГрузоперевозкам.ДокументДоходов.ПредставлениеДокумента КАК ПредставлениеДокумента,
	               |	CW_ДоходыПоГрузоперевозкам.Номенклатура КАК Номенклатура,
	               |	CW_ДоходыПоГрузоперевозкам.Валюта КАК Валюта,
	               |	НЕ CW_ДоходыПоГрузоперевозкам.ЭтоАкт КАК ЭтоСчет,
	               |	CW_ДоходыПоГрузоперевозкам.Всего_Валюта КАК ВсегоВал,
	               |	CW_ДоходыПоГрузоперевозкам.Всего КАК Всего,
	               |	CW_ДоходыПоГрузоперевозкам.Сумма КАК Сумма,
	               |	CW_ДоходыПоГрузоперевозкам.НДС КАК НДС,
	               |	CW_ДоходыПоГрузоперевозкам.ДокументДоходов.Дата КАК Дата,
	               |	CW_ДоходыПоГрузоперевозкам.ДокументДоходов.Организация КАК Организация,
	               |	CW_ОтсутствующиеОригиналыДокументов.Документ КАК ДокументБезОригиналов
	               |ПОМЕСТИТЬ ВТ
	               |ИЗ
	               |	РегистрНакопления.CW_ДоходыПоГрузоперевозкам КАК CW_ДоходыПоГрузоперевозкам
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.CW_ОтсутствующиеОригиналыДокументов КАК CW_ОтсутствующиеОригиналыДокументов
	               |		ПО CW_ДоходыПоГрузоперевозкам.ДокументДоходов = CW_ОтсутствующиеОригиналыДокументов.Документ
	               |			И CW_ДоходыПоГрузоперевозкам.Контрагент = CW_ОтсутствующиеОригиналыДокументов.Контрагент
	               |			И CW_ДоходыПоГрузоперевозкам.Договор = CW_ОтсутствующиеОригиналыДокументов.Договор
	               |ГДЕ
	               |	CW_ДоходыПоГрузоперевозкам.Грузоперевозка В(&мГрузоперевозок)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ.Грузоперевозка,
	               |	ВТ.Контрагент,
	               |	ВТ.Договор,
	               |	ВТ.Документ,
	               |	ВТ.ПредставлениеДокумента,
	               |	ВТ.Номенклатура,
	               |	ВТ.Валюта,
	               |	ВТ.ЭтоСчет,
	               |	ВТ.ВсегоВал,
	               |	ВТ.Всего,
	               |	ВТ.Сумма,
	               |	ВТ.НДС,
	               |	ВТ.Дата,
	               |	ВТ.Организация,
	               |	ВЫБОР
	               |		КОГДА ЕСТЬNULL(ВТ.ДокументБезОригиналов, ИСТИНА) = ИСТИНА
	               |			ТОГДА ИСТИНА
	               |		ИНАЧЕ ЛОЖЬ
	               |	КОНЕЦ КАК ОригиналыПредоставлены,
	               |	ВЫРАЗИТЬ("""" КАК СТРОКА(500)) КАК НомерКонтейнера
	               |ИЗ
	               |	ВТ КАК ВТ
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ВТ.Контрагент,
	               |	ВТ.Договор,
	               |	ВТ.Документ,
	               |	ВТ.Номенклатура,
	               |	ВТ.Валюта,
	               |	ВТ.Грузоперевозка,
	               |	ВТ.ЭтоСчет";
	
	Запрос.УстановитьПараметр("мГрузоперевозок", Грузоперевозки.ВыгрузитьЗначения());
	
	тЗапроса = Запрос.Выполнить().Выгрузить();
	ТЗ = тЗапроса.Скопировать();
	
	ТЗ.Свернуть("Контрагент,Номенклатура,Организация,Документ,Дата,ПредставлениеДокумента,Валюта,ЭтоСчет,ОригиналыПредоставлены,ПредставлениеДокумента,НомерКонтейнера", "ВсегоВал,Всего,Сумма,НДС");
	ТЗ.Сортировать("Дата Возр");
	
	Для каждого СтрокаТЗ Из ТЗ Цикл
		
		мСтрок = тЗапроса.НайтиСтроки(Новый Структура("Документ",СтрокаТЗ.Документ));
		
		Для каждого СтрокаМассива из мСтрок Цикл
			
			Если Найти(СтрокаТЗ.НомерКонтейнера, СтрокаМассива.Грузоперевозка) <> 0 Тогда
				Продолжить;
			КонецЕсли;
			
			СтрокаТЗ.НомерКонтейнера = СтрокаТЗ.НомерКонтейнера + СокрЛП(СтрокаМассива.Грузоперевозка) + ", ";
		КонецЦикла;
		
		Если Прав(СокрЛП(СтрокаТЗ.НомерКонтейнера),1) = "," Тогда
			СтрокаТЗ.НомерКонтейнера = Лев(СтрокаТЗ.НомерКонтейнера,СтрДлина(СтрокаТЗ.НомерКонтейнера) - 2);
		КонецЕсли;
		
	КонецЦикла;	
	
	ТЗ.Свернуть("Контрагент,Номенклатура,Организация,Документ,Дата,ПредставлениеДокумента,Валюта,ЭтоСчет,ОригиналыПредоставлены,ПредставлениеДокумента", "ВсегоВал,Всего,Сумма,НДС");
	ТЗ.Сортировать("Дата Возр");
	
	ФинансыДоходы.Загрузить(ТЗ);
	
	ТЗД = ТЗ.Скопировать(, "Документ");
	ТЗД.Свернуть("Документ");
	КоличествоДоходных = ТЗД.Количество();
	
	Элементы.ГруппаФинансыДоходы.Заголовок = "Доходы" + ?(КоличествоДоходных = 0, "", " (" + Строка(КоличествоДоходных) + ")");

КонецФункции

&НаСервере
Процедура ОбновитьТаблицыФинансов(ИмяТаблицы = Неопределено)
	
	Если ИмяТаблицы = Неопределено Или ИмяТаблицы = "ФинансыРасходы" Тогда
		ФинансыРасходыОбновить();
	КонецЕсли;
	
	Если ИмяТаблицы = Неопределено Или ИмяТаблицы = "ФинансыДоходы" Тогда
		ФинансыДоходыОбновить();
	КонецЕсли;
	
	ФинансыОбновитьИтоги();
	
КонецПроцедуры	

&НаСервере
Функция ПолучитьТаблицыБюджета_ПоГрузоперевозкам(ВерсияБюджета, флЗатраты, флДоходы) Экспорт 
	
		з = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	CW_ПлановыеСтатьиЗатратИДоходов.Ссылка КАК СтатьяСсылка,
		|	CW_ПлановыеСтатьиЗатратИДоходов.Контрагент,
		|	CW_ПлановыеСтатьиЗатратИДоходов.Номенклатура,
		|	CW_ПлановыеСтатьиЗатратИДоходов.Валюта,
		|	CW_ПлановыеСтатьиЗатратИДоходов.Курс,
		|	CW_ПлановыеСтатьиЗатратИДоходов.СтавкаНДС,
		|	CW_ПлановыеСтатьиЗатратИДоходов.Сумма,
		|	CW_ПлановыеСтатьиЗатратИДоходов.СуммаНДС,
		|	CW_ПлановыеСтатьиЗатратИДоходов.СуммаВсего,
		|	CW_ПлановыеСтатьиЗатратИДоходов.СуммаРуб,
		|	CW_ПлановыеСтатьиЗатратИДоходов.СуммаНДСРуб,
		|	CW_ПлановыеСтатьиЗатратИДоходов.СуммаВсегоРуб,
		|	CW_ПлановыеСтатьиЗатратИДоходов.ВидСтатьиПланирования,
		|	CW_ПлановыеСтатьиЗатратИДоходов.Организация
		|ПОМЕСТИТЬ вт
		|ИЗ
		|	Справочник.CW_ПлановыеСтатьиЗатратИДоходов КАК CW_ПлановыеСтатьиЗатратИДоходов
		|ГДЕ
		|	CW_ПлановыеСтатьиЗатратИДоходов.Владелец В(&мГрузоперевозок)
		|	И CW_ПлановыеСтатьиЗатратИДоходов.ВерсияБюджета = &ВерсияБюджета
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	вт.СтатьяСсылка,
		|	вт.Контрагент,
		|	вт.Номенклатура,
		|	вт.Валюта,
		|	вт.Курс,
		|	вт.СтавкаНДС,
		|	СУММА(вт.Сумма) КАК Сумма,
		|	СУММА(вт.СуммаНДС) КАК СуммаНДС,
		|	СУММА(вт.СуммаВсего) КАК СуммаВсего,
		|	СУММА(вт.СуммаРуб) КАК СуммаРуб,
		|	СУММА(вт.СуммаНДСРуб) КАК СуммаНДСРуб,
		|	СУММА(вт.СуммаВсегоРуб) КАК СуммаВсегоРуб,
		|	вт.Организация
		|ИЗ
		|	вт КАК вт
		|ГДЕ
		|	&флЗатраты
		|	И вт.ВидСтатьиПланирования = ЗНАЧЕНИЕ(Перечисление.CW_ВидыСтатейПланирования.Расходы)
		|
		|СГРУППИРОВАТЬ ПО
		|	вт.Контрагент,
		|	вт.Валюта,
		|	вт.СтавкаНДС,
		|	вт.СтатьяСсылка,
		|	вт.Организация,
		|	вт.Номенклатура,
		|	вт.Курс
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	вт.СтатьяСсылка,
		|	вт.Контрагент,
		|	вт.Номенклатура,
		|	вт.Валюта,
		|	вт.Курс,
		|	вт.СтавкаНДС,
		|	СУММА(вт.Сумма) КАК Сумма,
		|	СУММА(вт.СуммаНДС) КАК СуммаНДС,
		|	СУММА(вт.СуммаВсего) КАК СуммаВсего,
		|	СУММА(вт.СуммаРуб) КАК СуммаРуб,
		|	СУММА(вт.СуммаНДСРуб) КАК СуммаНДСРуб,
		|	СУММА(вт.СуммаВсегоРуб) КАК СуммаВсегоРуб,
		|	вт.Организация
		|ИЗ
		|	вт КАК вт
		|ГДЕ
		|	&флДоходы
		|	И вт.ВидСтатьиПланирования = ЗНАЧЕНИЕ(Перечисление.CW_ВидыСтатейПланирования.Доходы)
		|
		|СГРУППИРОВАТЬ ПО
		|	вт.Валюта,
		|	вт.СтатьяСсылка,
		|	вт.Контрагент,
		|	вт.СтавкаНДС,
		|	вт.Номенклатура,
		|	вт.Организация,
		|	вт.Курс"
	);
	з.УстановитьПараметр("мГрузоперевозок", Грузоперевозки.ВыгрузитьЗначения());
	з.УстановитьПараметр("ВерсияБюджета", ВерсияБюджета);
	з.УстановитьПараметр("флЗатраты", флЗатраты);
	з.УстановитьПараметр("флДоходы",  флДоходы);
	масс = з.ВыполнитьПакет();

	стру = Новый Структура(
		"тзЗатраты, тзДоходы", 
		масс[1].Выгрузить(), 
		масс[2].Выгрузить()
	);

	Возврат стру;
	
КонецФункции

&НаСервере
Функция ТаблицыБюджетаОбновить(ИмяТаблицы = Неопределено)
	
	НужныДоходыПлан 	= (ИмяТаблицы = Неопределено Или ИмяТаблицы = "ДоходыПлан");
	НужныРасходыПлан 	= (ИмяТаблицы = Неопределено Или ИмяТаблицы = "РасходыПлан");
	
	ОтветПлан = ПолучитьТаблицыБюджета_ПоГрузоперевозкам(ВерсияБюджетаПлан, НужныРасходыПлан, НужныДоходыПлан );
	
	Если НужныДоходыПлан Тогда
		БюджетДоходыПлан.Загрузить(ОтветПлан.тзДоходы);	
	КонецЕсли;
	
	Если НужныРасходыПлан Тогда
		БюджетРасходыПлан.Загрузить(ОтветПлан.тзЗатраты);	
	КонецЕсли;
	
	НужныДоходыФакт 	= (ИмяТаблицы = Неопределено Или ИмяТаблицы = "ДоходыФакт");
	НужныРасходыФакт 	= (ИмяТаблицы = Неопределено Или ИмяТаблицы = "РасходыФакт");
	
	ОтветФакт = ПолучитьТаблицыБюджета_ПоГрузоперевозкам(ВерсияБюджетаФакт, НужныРасходыФакт, НужныДоходыФакт);
	
	Если НужныРасходыФакт Тогда
		БюджетРасходыФакт.Загрузить(ОтветФакт.тзЗатраты);	
	КонецЕсли;
	
	Если НужныДоходыФакт Тогда
		БюджетДоходыФакт.Загрузить(ОтветФакт.тзДоходы);
	КонецЕсли;	
	
	БюджетОбновитьИтоги();
	
КонецФункции

Функция БюджетОбновитьИтоги(флОбновлятьЗатраты = Истина, флОбновлятьДоходы = Истина)
	
	ФорматВывода = "ЧЦ=15; ЧДЦ=2; ЧН=";

	ВыводитьРезультатВБазовойВалюте = Истина;
	ВыводитьРасходыВБазовойВалюте = Истина;
	ВыводитьДоходыВБазовойВалюте = Истина;

	Если ВыводитьРезультатВВалютеДокументов Тогда

		ОбщаяВалюта 	= ПредопределенноеЗначение("Справочник.Валюты.ПустаяСсылка");
		ВалютыРасходов 	= БюджетРасходыПлан.Выгрузить(, "Валюта");
		
		Для каждого СтрокаТЗ из БюджетРасходыФакт Цикл
			
			НовСтрока = ВалютыРасходов.Добавить();
			НовСтрока.Валюта = СтрокаТЗ.Валюта;
			
		КонецЦикла;	
			
		ВалютыРасходов.Свернуть("Валюта");
	
			
		ВалютыДоходов = БюджетДоходыПлан.Выгрузить(, "Валюта");
		
		Для каждого СтрокаТЗ из БюджетДоходыФакт Цикл
			
			НовСтрока = ВалютыДоходов.Добавить();
			НовСтрока.Валюта = СтрокаТЗ.Валюта;
			
		КонецЦикла;	
		
		ВалютыДоходов.Свернуть("Валюта");

		Если ВалютыРасходов.Количество() = 1 Тогда
			ВалютаРасходов = ВалютыРасходов[0].Валюта;
			ВыводитьРасходыВБазовойВалюте = Ложь;
		Иначе
			ВалютаРасходов = ПредопределенноеЗначение("Справочник.Валюты.ПустаяСсылка");
		КонецЕсли;

		Если ВалютыДоходов.Количество() = 1 Тогда
			ВалютаДоходов = ВалютыДоходов[0].Валюта;
			ВыводитьДоходыВБазовойВалюте = Ложь;
		Иначе
			ВалютаДоходов = ПредопределенноеЗначение("Справочник.Валюты.ПустаяСсылка");
		КонецЕсли;

	КонецЕсли;
	
	Если (ЗначениеЗаполнено(Номенклатура)) Тогда
		тзБюджетРасходыПлан = БюджетРасходыПлан.Выгрузить(Новый Структура("Номенклатура",Номенклатура));
		тзБюджетРасходыФакт = БюджетРасходыФакт.Выгрузить(Новый Структура("Номенклатура",Номенклатура));
		тзБюджетДоходыПлан = БюджетДоходыПлан.Выгрузить(Новый Структура("Номенклатура",Номенклатура));
		тзБюджетДоходыФакт = БюджетДоходыФакт.Выгрузить(Новый Структура("Номенклатура",Номенклатура));
	Иначе
		тзБюджетРасходыПлан = БюджетРасходыПлан.Выгрузить();
		тзБюджетРасходыФакт = БюджетРасходыФакт.Выгрузить();
		тзБюджетДоходыПлан = БюджетДоходыПлан.Выгрузить();
		тзБюджетДоходыФакт = БюджетДоходыФакт.Выгрузить();
	КонецЕсли; 

	Если флОбновлятьЗатраты Тогда
		
		мСтрок = СоответствиеЭлементов.НайтиСтроки(Новый Структура("ВидЭлемента",0));
		
		Для каждого Соответствие из мСтрок Цикл
			
			Если (ЗначениеЗаполнено(Номенклатура)) Тогда
