&НаСервере
Процедура  ПолучитьСписокПолейДляОтбораПоИнтервалу(СписокЗначений) 
	
	Массив = Новый Массив;
	
	СписокЗначений.Очистить();
	СписокЗначений.Добавить("Реквизит.ДатаСделкиФ", 	"Дата грузоперевозки"		, , БиблиотекаКартинок.CW_Грузоперевозки);
	СписокЗначений.Добавить("Реквизит.ДатаЗакрытия", 	"Дата блокировки финансов"	, , БиблиотекаКартинок.CW_Грузоперевозки);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	CW_ПараметрыГрузоперевозок.Ссылка КАК Ссылка,
	|	CW_ПараметрыГрузоперевозок.Наименование КАК Наименование,
	|	CW_ПараметрыГрузоперевозок.ТипЗначения КАК ТипЗначения,
	|	CW_ПараметрыГрузоперевозок.Код КАК Код,
	|	CW_ПараметрыГрузоперевозок.ЭтоКонтрольнаяДата КАК ЭтоКонтрольнаяДата
	|ИЗ
	|	ПланВидовХарактеристик.CW_ПараметрыГрузоперевозок КАК CW_ПараметрыГрузоперевозок
	|ГДЕ
	|	CW_ПараметрыГрузоперевозок.ЭтоГруппа = ЛОЖЬ
	|	И CW_ПараметрыГрузоперевозок.ПометкаУдаления = ЛОЖЬ";  
	
	РезультатЗапрсоа = Запрос.Выполнить();
	Выборка = РезультатЗапрсоа.Выбрать();
	Пока Выборка.Следующий() Цикл   
		
		Если Выборка.ТипЗначения.СодержитТип(Тип("Дата")) Тогда      
			
			КартинкаДаты = БиблиотекаКартинок.Сегодня; 
			
			УИД_Парамтера = XMLСтрока(Выборка.Ссылка);
			Если Выборка.ЭтоКонтрольнаяДата Тогда
				КартинкаДаты = БиблиотекаКартинок.CW_КонтрольныеДаты; 
				Массив.Добавить(УИД_Парамтера);
			КонецЕсли;
			
			СписокЗначений.Добавить(УИД_Парамтера, СокрЛП(Выборка.Наименование), , КартинкаДаты);
		КонецЕсли; 
		
	КонецЦикла;    
	
	МассивКонтрольныеДаты = Новый ФиксированныйМассив(Массив);
	
КонецПроцедуры


&НаКлиенте
Процедура ВыборПериода(Команда)
	
	ПОВ = Новый ОписаниеОповещения("ОбработкаИзмененияПериода",ЭтотОбъект); 
	Диалог = Новый ДиалогРедактированияСтандартногоПериода();
	Диалог.Период = Период;
	Диалог.Период.ДатаНачала = НачалоПериода;
	Диалог.Период.ДатаОкончания = КонецПериода;
	Диалог.Период.Вариант = ВариантСтандартногоПериода.ПроизвольныйПериод;
	Диалог.Показать(ПОВ);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаИзмененияПериода(ОтветПериод, ДополнительныеПараметры) Экспорт 
	// --- 
	
	Если (ОтветПериод <> Неопределено) Тогда
		НачалоПериода = НачалоДня(ОтветПериод.ДатаНачала);
		КонецПериода  = КонецДня(ОтветПериод.ДатаОкончания);
		Период = ОтветПериод;
	КонецЕсли; 
	
	// --- 
КонецПроцедуры

&НаКлиенте
Процедура ВерсияБюджетаПриИзменении(Элемент)
	
	Если НЕ ЗначениеЗаполнено(ВерсияБюджета) Тогда
		ВерсияБюджета = _ПолучитьБазовуюВерсиюБюджета();
	КонецЕсли;	
	
КонецПроцедуры

&НаСервере
Функция _ПолучитьБазовуюВерсиюБюджета()
	
	тВерсияБюджета = CW_Бюджетирование.ПолучитьОсновнуюВерсиюБюджета();
	тВерсияБюджета = ?(ЗначениеЗаполнено(тВерсияБюджета), тВерсияБюджета, Справочники.CW_ВерсииБюджетов.Основная);
	
	Возврат тВерсияБюджета;
	
КонецФункции

&НаКлиенте
Процедура ДатаОпределенияПрибылиПриИзменении(Элемент)
	
	Если НЕ ЗначениеЗаполнено(ДатаОпределенияПрибыли) Тогда
		ДатаОпределенияПрибыли = Элементы.ДатаОпределенияПрибыли.СписокВыбора.НайтиПоЗначению("Реквизит.ДатаЗакрытия");
	КонецЕсли;	

	Если МассивКонтрольныеДаты.Найти(ДатаОпределенияПрибыли) = Неопределено Тогда
		ДатаОпределенияПрибылиПолучаемоеЗначение = "Значение";
	Конецесли;  
	
	Элементы.ГруппаОбъектыПраметров.Видимость = ВыбранПараметрНаСервере();
	
	УстановитьВидимостьПолучаемогоЗначения();   

КонецПроцедуры 

&НаСервере
Функция ВыбранПараметрНаСервере()
	
	Попытка
		Параметр = XMLЗначение(Тип("ПланВидовХарактеристикСсылка.CW_ПараметрыГрузоперевозок"), ДатаОпределенияПрибыли);
		Возврат Истина;
	Исключение       
		Возврат Ложь;
	КонецПопытки;
	
КонецФункции

&НаСервере
Процедура УстановитьВидимостьПолучаемогоЗначения()
	
	Элементы.ДатаОпределенияПрибылиПолучаемоеЗначение.Видимость = (МассивКонтрольныеДаты.Найти(ДатаОпределенияПрибыли) <> Неопределено);

КонецПроцедуры

&НаСервере
Процедура ПриСохраненииПользовательскихНастроекНаСервере(Настройки)
	
	Настройки.ДополнительныеСвойства.Вставить("Показатели",Показатели);
	Настройки.ДополнительныеСвойства.Вставить("Разделы",Разделы);
	//Настройки.ДополнительныеСвойства.Вставить("Группировки", Группировки.Выгрузить());
	Настройки.ДополнительныеСвойства.Вставить("Группировки", Группировки); // ДанныеФормыКоллекция
	//Настройки.ДополнительныеСвойства.Вставить("НачалоПериода",НачалоПериода);
	//Настройки.ДополнительныеСвойства.Вставить("КонецПериода",КонецПериода);
	Настройки.ДополнительныеСвойства.Вставить("ВерсияБюджета",ВерсияБюджета);
	Настройки.ДополнительныеСвойства.Вставить("ВыводитьРасходыДоходы",ВыводитьРасходыДоходы);
	Настройки.ДополнительныеСвойства.Вставить("ДатаОпределенияПрибыли",ДатаОпределенияПрибыли);
	Настройки.ДополнительныеСвойства.Вставить("Организация",Организация);
	Настройки.ДополнительныеСвойства.Вставить("ИсключатьВнутрихолдинговыеВзаиморасчеты",ИсключатьВнутрихолдинговыеВзаиморасчеты);
	Настройки.ДополнительныеСвойства.Вставить("ВыводитьСтатистику",ВыводитьСтатистику);
	Настройки.ДополнительныеСвойства.Вставить("ВыводитьСтатистикуПлан",ВыводитьСтатистикуПлан);
	Настройки.ДополнительныеСвойства.Вставить("ПорядокОтражения",ПорядокОтражения);
	Настройки.ДополнительныеСвойства.Вставить("Отбор", Отчет.КомпоновщикНастроек.ПолучитьНастройки());
	
КонецПроцедуры

&НаСервере
Процедура ПриЗагрузкеПользовательскихНастроекНаСервере(Настройки)
	
	Если НЕ СформироватьПриОткрытии Тогда
		CW_Отчеты.ПриЗагрузкеПользовательскихНастроекНаСервере(ЭтаФорма, Настройки);
		
		Если ПолучитьФункциональнуюОпцию("CW_ИспользованиеБюджетирования") Тогда
			Если Разделы.Количество() = 1 Тогда
				Разделы.Вставить(0, "План", , Ложь);
				Разделы.Добавить("Отклонение", , Ложь);
			КонецЕсли;	
			Если НЕ ЗначениеЗаполнено(ВерсияБюджета) Тогда
				ВерсияБюджета = _ПолучитьБазовуюВерсиюБюджета();
			КонецЕсли;	
		Иначе
			Разделы.Очистить();
			Разделы.Добавить("Факт",,Истина);
			Элементы.ВерсияБюджета.Видимость = Ложь;
			ВерсияБюджета = Неопределено;
		КонецЕсли;	
		Если НЕ ЗначениеЗаполнено(ДатаОпределенияПрибыли) Тогда
			ДатаОпределенияПрибыли = Элементы.ДатаОпределенияПрибыли.СписокВыбора.НайтиПоЗначению("Реквизит.ДатаЗакрытия");
		КонецЕсли;
		
	КонецЕсли;
	
	Отчет.КомпоновщикНастроек.ПользовательскиеНастройки.ДополнительныеСвойства.Очистить();
	Настройки.ДополнительныеСвойства.Очистить();
	
КонецПроцедуры

