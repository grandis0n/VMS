Функция БуферОбменаВставитьНаСервере()
	
	Возврат CW_РаботаСБуферомОбмена.УстановитьОтборКомпановщикаПоБуферуОбмена(Отчет.КомпоновщикНастроек);

КонецФункции 

&НаКлиенте
Процедура БуферОбменаВставитьДляРеквизита(Команда)

	КоличествоСтрок = БуферОбменаВставитьДляРеквизитаНаСервере();
	Если КоличествоСтрок <> Неопределено Тогда
		CW_РаботаСБуферомОбменаКлиент.ОповеститьОВставкеСтрокИзБуфераОбмена(ЭтаФорма, КоличествоСтрок);	
	КонецЕсли; 

КонецПроцедуры    

&НаСервере
Функция БуферОбменаВставитьДляРеквизитаНаСервере()
	
	ДанныеБуфераОбмена 	= CW_РаботаСБуферомОбмена.СтрокиИзБуфераОбмена(); 
	ТипИсточника		= CW_РаботаСБуферомОбмена.ПолучитьТипОбъектаПоИмени(ДанныеБуфераОбмена.Источник); 
	Если ТипИсточника = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли; 
	
	Если ТипИсточника <> тип("СправочникСсылка.CW_Грузоперевозки") Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Грузоперевозки.ЗагрузитьЗначения(ДанныеБуфераОбмена.Данные);
	
	Возврат Грузоперевозки.Количество();
	
КонецФункции 

