&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	СписокОбъектовПараметра.Добавить("Грузоперевозка",,Истина);
	СписокОбъектовПараметра.Добавить("Заказ");
	СписокОбъектовПараметра.Добавить("Заявка");     
	
	ИсключатьВнутрихолдинговыеВзаиморасчеты = CW_Настройки.ПолучитьНастройкуПользователя(,"ИсключатьВнутрихолдинговыеВзаиморасчеты");
	
	Параметры.Свойство("СформироватьПриОткрытии", СформироватьПриОткрытии);  
	
	Параметры.Свойство("ВнешнийВызов", Отчет.ВнешнийВызов);
	Если Отчет.ВнешнийВызов Тогда
		ПФ = Новый Структура("Отбор,Группировки,Параметры,Разделы,Показатели");
		ЗаполнитьЗначенияСвойств(ПФ, Параметры);   
		
		Если Параметры.Свойство("НачалоПериода") Тогда
			НачалоПериода = Параметры.НачалоПериода;
		КонецЕсли;
		Если Параметры.Свойство("КонецПериода") Тогда
			КонецПериода = Параметры.КонецПериода;
		КонецЕсли;
		Если Параметры.Свойство("ВерсияБюджета") Тогда
			ВерсияБюджета = Параметры.ВерсияБюджета;
		КонецЕсли;
		Если Параметры.Свойство("ОбъединитьГруппировки") Тогда
			ОбъединитьГруппировки = Параметры.ОбъединитьГруппировки;
		КонецЕсли;
		Если Параметры.Свойство("ВыводитьРасходыДоходы") Тогда
			ВыводитьРасходыДоходы = Параметры.ВыводитьРасходыДоходы;
		КонецЕсли;
		Если Параметры.Свойство("ПолучитьРасходыПоПутевымЛистам") Тогда
			ПолучитьРасходыПоПутевымЛистам = Параметры.ПолучитьРасходыПоПутевымЛистам;
		КонецЕсли;
		Если Параметры.Свойство("ВыводитьСтатистику") Тогда
			ВыводитьСтатистику = Параметры.ВыводитьСтатистику;
		КонецЕсли;               
		Если Параметры.Свойство("ВыводитьСтатистикуПалн") Тогда
			ВыводитьСтатистикуПлан = Параметры.ВыводитьСтатистикуПлан;
		КонецЕсли;               
		Если Параметры.Свойство("ИсключатьВнутрихолдинговыеВзаиморасчеты") Тогда
			ИсключатьВнутрихолдинговыеВзаиморасчеты = Параметры.ИсключатьВнутрихолдинговыеВзаиморасчеты;
		КонецЕсли;
		Если Параметры.Свойство("ВариантФормирования") Тогда
			ВариантФормирования = Параметры.ВариантФормирования;
		КонецЕсли;
		Если Параметры.Свойство("ПорядокОтражения") Тогда
			ПорядокОтражения = Параметры.ПорядокОтражения;
		КонецЕсли;
		Если Параметры.Свойство("ДатаОпределенияПрибылиПолучаемоеЗначение") Тогда
			ДатаОпределенияПрибылиПолучаемоеЗначение = Параметры.ДатаОпределенияПрибылиПолучаемоеЗначение;
		КонецЕсли;
		Если Параметры.Свойство("ДатаОпределенияПрибыли") Тогда
			ДатаОпределенияПрибыли = Параметры.ДатаОпределенияПрибыли;
		КонецЕсли;
		Если Параметры.Свойство("Данные") Тогда
			Данные = Параметры.Данные;
		КонецЕсли;
		Если Параметры.Свойство("Грузоперевозки") Тогда 
			Если ТипЗнч(Параметры.Грузоперевозки) = Тип("Массив") Тогда
				Грузоперевозки.ЗагрузитьЗначения(Параметры.Грузоперевозки);
			КонецЕсли;
		КонецЕсли;
		
		Отчет.АдресВнешнихНастроек = ПоместитьВоВременноеХранилище(ПФ, ЭтаФорма.УникальныйИдентификатор);
	КонецЕсли;
	
	// ---------------------------------------------------------------------------- 
	
	ИспользованиеБюджетирования = ПолучитьФункциональнуюОпцию("CW_ИспользованиеБюджетирования");
	

	// параметры
	ВерсияБюджета = _ПолучитьБазовуюВерсиюБюджета();
	
	// показатели
	Показатели.Добавить("Сумма",,Истина);
	Показатели.Добавить("НДС",,Истина);
	Показатели.Добавить("Всего",,Истина);
	
	// разделы
	Разделы.Добавить("План",,Истина);	
	Разделы.Добавить("Факт",,Истина);
	Разделы.Добавить("Отклонение",,Истина);	
		
	// группировки
	Нстр = Группировки.Добавить();
	Нстр.ИмяПоля = "Грузоперевозка.Клиент";
	Нстр.Представление = "Клиент";
	Нстр.Сортировка = Перечисления.CW_НаправлениеСортировки.ПоВозрастанию;
	// --- 
	Нстр = Группировки.Добавить();
	Нстр.ИмяПоля = "Грузоперевозка";
	Нстр.Представление = "Грузоперевозка";
	Нстр.Сортировка = Перечисления.CW_НаправлениеСортировки.ПоВозрастанию;
	
	ПолучитьСписокПолейДляОтбораПоИнтервалу(Элементы.ДатаОпределенияПрибыли.СписокВыбора);
	
	_ВосстановитьСеансовуюНастройку(); 
	
	Если НЕ ИспользованиеБюджетирования Тогда
		Элементы.ВерсияБюджета.Видимость = Ложь;
	КонецЕсли;   
	
	_УправлениеЭлементамиФормы();

	//Работа с буфером обмена
	// Проверка буфера обмена на наличие скопированных строк
	УстановитьДоступностьКомандыВставки(ЭтотОбъект, Не CW_РаботаСБуферомОбмена.ПустойБуферОбмена());
	//Работа с буфером обмена
	
	ДатаОпределенияПрибылиПолучаемоеЗначение = "Значение";

	УстановитьВидимостьПолучаемогоЗначения();
		
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Элементы.ФормаНастройка.Пометка = Истина;
	
	Если (НЕ Отчет.ВнешнийВызов) Тогда
		_ВосстановитьСтандартныеНастройки();
		_ВосстановитьСеансовуюНастройку();	
		Если НЕ ЗначениеЗаполнено(НачалоПериода) ИЛИ НЕ ЗначениеЗаполнено(КонецПериода) Тогда
			НачалоПериода = НачалоМесяца(ТекущаяДата());
			КонецПериода  = КонецМесяца(ТекущаяДата());
		КонецЕсли;
	КонецЕсли; 
	
	// --- 
	
	Если (Отчет.ВнешнийВызов) Тогда
		
		_ОбработатьВнешниеПараметры();
		_ВосстановитьСеансовуюНастройку();
		_УправлениеЭлементамиФормы();  
		
		Если СформироватьПриОткрытии Тогда
			Сформировать(Неопределено);       
		КонецЕсли;
		
	КонецЕсли;
	
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, СтандартнаяОбработка)
	
	//_СохранитьСеансовуюНастройку();
	ВариантМодифицирован = Ложь;		
	
КонецПроцедуры

