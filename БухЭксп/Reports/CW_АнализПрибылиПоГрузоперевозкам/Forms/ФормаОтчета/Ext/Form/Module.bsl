&НаСервере
Процедура _ОбработатьВнешниеПараметры()
	
	СП = ПолучитьИзВременногоХранилища(Отчет.АдресВнешнихНастроек);
	// ---------------------------------------------------------------------------- 
	
	// параметры
	СП.Параметры.Свойство("Данные",Данные);
	// --- 
	СП.Параметры.Свойство("ДатаОпределенияПрибыли",ДатаОпределенияПрибыли);
	
	СП.Параметры.Свойство("Грузоперевозки",Грузоперевозки);
	Если (Грузоперевозки.Количество() = 0) Тогда
		Если (СП.Параметры.Свойство("Грузоперевозка")) Тогда
			Грузоперевозки.Добавить(СП.Параметры.Грузоперевозка);
		КонецЕсли; 
		Если (СП.Параметры.Свойство("Заказ")) Тогда
			МассивГП = CW_Мониторинг.ГрузоперевозкиЗаказа(СП.Параметры.Заказ);
			Грузоперевозки.ЗагрузитьЗначения(МассивГП);
		КонецЕсли; 
	КонецЕсли; 
	
	СП.Параметры.Свойство("НачалоПериода",НачалоПериода);
	СП.Параметры.Свойство("КонецПериода",КонецПериода);
	// --- 
	СП.Параметры.Свойство("ВариантФормирования",ВариантФормирования);
	Если (НЕ СП.Параметры.Свойство("ВариантФормирования")) Тогда
		// получаем из настроек пользователя
		// ...
	КонецЕсли; 
	СП.Параметры.Свойство("ИсключатьВнутрихолдинговыеВзаиморасчеты",ИсключатьВнутрихолдинговыеВзаиморасчеты);
	СП.Параметры.Свойство("ВыводитьРасходыДоходы",ВыводитьРасходыДоходы);
	СП.Параметры.Свойство("ОбъединитьГруппировки",ОбъединитьГруппировки);
	СП.Параметры.Свойство("ВыводитьСтатистику",ВыводитьСтатистику); 
	СП.Параметры.Свойство("ВыводитьСтатистикуПлан",ВыводитьСтатистикуПлан); 
	СП.Параметры.Свойство("ПорядокОтражения",ПорядокОтражения);
	// --- 
	СП.Параметры.Свойство("Организация",Организация);
	СП.Параметры.Свойство("ВерсияБюджета",ВерсияБюджета);
	
	Если НЕ ЗначениеЗаполнено(ВерсияБюджета) Тогда
		ВерсияБюджета = _ПолучитьБазовуюВерсиюБюджета();
	КонецЕсли; 
	
	// разделы - массив идентификаторов
	Если (СП.Свойство("Разделы")) Тогда
		МассивРазделов = СП.Разделы;
		Если (МассивРазделов <> Неопределено) Тогда
			Для каждого ЭлементРаздела Из Разделы Цикл
				
				Если (МассивРазделов.Найти(ЭлементРаздела.Значение) <> Неопределено) Тогда
					ЭлементРаздела.Пометка = Истина;
				Иначе
					ЭлементРаздела.Пометка = Ложь;
				КонецЕсли; 
				
			КонецЦикла; 
		КонецЕсли;	
	КонецЕсли; 
	 
	
	// показатели - массив идентификаторов
	Если (СП.Свойство("Показатели")) Тогда
		МассивПоказателей = СП.Показатели;
		Если (МассивПоказателей <> Неопределено) Тогда
			Для каждого ЭлементПоказателя Из Показатели Цикл
				
				Если (МассивПоказателей.Найти(ЭлементПоказателя.Значение) <> Неопределено) Тогда
					ЭлементПоказателя.Пометка = Истина;
				Иначе
					ЭлементПоказателя.Пометка = Ложь;
				КонецЕсли; 
				
			КонецЦикла; 
		КонецЕсли;	
	КонецЕсли; 
	
	
	// группировки - список идентификаторов с представлениями
	СГ =  _сф.ст_ПолучитьСвойство(СП,"Группировки");
	Если (СГ <> Неопределено) Тогда
		
		Группировки.Очистить();
		Для каждого Стр Из СГ Цикл
			Нстр = Группировки.Добавить();
			Нстр.ИмяПоля = Стр.Значение;
			Нстр.Представление = Стр.Представление;
			Нстр.Сортировка = Перечисления.CW_НаправлениеСортировки.ПоВозрастанию;
		КонецЦикла; 
		
	КонецЕсли; 
	
	Отчет.ВнешнийВызов = Ложь;

КонецПроцедуры


&НаСервере
Процедура _ВосстановитьСтандартныеНастройки()
	
	Отчет.КомпоновщикНастроек.ЗагрузитьНастройки(Отчеты.CW_АнализПрибылиПоГрузоперевозкам.ПолучитьМакет("ОсновнаяСхемаКомпоновкиДанных").НастройкиПоУмолчанию);
	
КонецПроцедуры	

&НаСервере
Процедура _ВосстановитьСеансовуюНастройку()
	// --- 
	
	// пытаемся восстановить настройки
	Идентификатор = РеквизитФормыВЗначение("Отчет").Метаданные().Имя;
	СеансоваяНастройка = ХранилищеСистемныхНастроек.Загрузить(Идентификатор, "Сеансовая");
	Если СеансоваяНастройка <> Неопределено Тогда
		Попытка
			СеансоваяНастройка.Свойство("Показатели",Показатели);
			СеансоваяНастройка.Свойство("ОбъединитьГруппировки", ОбъединитьГруппировки);
			СеансоваяНастройка.Свойство("ПолучитьРасходыПоПутевымЛистам", ПолучитьРасходыПоПутевымЛистам);
			Если ПолучитьФункциональнуюОпцию("CW_ИспользованиеБюджетирования") Тогда
				СеансоваяНастройка.Свойство("Разделы", Разделы);
				Если Разделы.Количество() = 1 Тогда
					Разделы.Вставить(0, "План", , Ложь);
					Разделы.Добавить("Отклонение", , Ложь);
				КонецЕсли;	
				СеансоваяНастройка.Свойство("ВерсияБюджета",ВерсияБюджета);
				Если НЕ ЗначениеЗаполнено(ВерсияБюджета) Тогда
					ВерсияБюджета = _ПолучитьБазовуюВерсиюБюджета();
				КонецЕсли;	
			Иначе
				Разделы.Очистить();
				Разделы.Добавить("Факт",,Истина);
				Элементы.ВерсияБюджета.Видимость = Ложь;
			КонецЕсли;	
			СеансоваяНастройка.Свойство("ВариантФормирования",ВариантФормирования);
			СеансоваяНастройка.Свойство("ВыводитьРасходыДоходы",ВыводитьРасходыДоходы);
			СеансоваяНастройка.Свойство("ДатаОпределенияПрибыли",ДатаОпределенияПрибыли);
			Если НЕ ЗначениеЗаполнено(ДатаОпределенияПрибыли) Тогда
				ДатаОпределенияПрибыли = Элементы.ДатаОпределенияПрибыли.СписокВыбора.НайтиПоЗначению("Реквизит.ДатаЗакрытия");
			КонецЕсли;		
			СеансоваяНастройка.Свойство("Организация",Организация);
			СеансоваяНастройка.Свойство("ВыводитьСтатистику",ВыводитьСтатистику); 
			СеансоваяНастройка.Свойство("ВыводитьСтатистикуПлан",ВыводитьСтатистикуПлан); 
			СеансоваяНастройка.Свойство("ПорядокОтражения",ПорядокОтражения);  
			
			Если СеансоваяНастройка.Свойство("МассивОбъектовПараметра") 
				и ТипЗнч(СеансоваяНастройка.МассивОбъектовПараметра) = Тип("Массив") Тогда
				
				Отмечено = 0;
				Для Каждого ЭлементСписка из СписокОбъектовПараметра Цикл
					ЭлементСписка.Пометка = СеансоваяНастройка.МассивОбъектовПараметра.Найти(ЭлементСписка.Значение) <> Неопределено;   
					Отмечено = Отмечено +?(ЭлементСписка.Пометка, 1,0);
				КонецЦикла;  
				
				Если Отмечено = 0 Тогда
					ЭлементСписка = СписокОбъектовПараметра.НайтиПоЗначению("Грузоперевозка");
					Если ЭлементСписка <> Неопределено Тогда
						ЭлементСписка.Пометка = Истина;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			
			Группировки.Загрузить(СеансоваяНастройка.Группировки);
			
		Исключение
		    //ОписаниеОшибки()
		КонецПопытки; 
		
		
	КонецЕсли; 
	
	// --- 
КонецПроцедуры

&НаСервере
Процедура _СохранитьСеансовуюНастройку()
	// --- 
	
	СтруктураНастройки = Новый Структура();
	СтруктураНастройки.Вставить("Показатели",Показатели);
	СтруктураНастройки.Вставить("Разделы",Разделы);
	СтруктураНастройки.Вставить("Группировки",Группировки.Выгрузить());
	СтруктураНастройки.Вставить("ВариантФормирования",ВариантФормирования);
	СтруктураНастройки.Вставить("ВерсияБюджета",ВерсияБюджета);
	СтруктураНастройки.Вставить("ВыводитьРасходыДоходы",ВыводитьРасходыДоходы);
	СтруктураНастройки.Вставить("ДатаОпределенияПрибыли",ДатаОпределенияПрибыли);
	СтруктураНастройки.Вставить("Организация",Организация);
	СтруктураНастройки.Вставить("ВыводитьСтатистику",ВыводитьСтатистику);   
	СтруктураНастройки.Вставить("ВыводитьСтатистикуПлан",ВыводитьСтатистикуПлан);   
	СтруктураНастройки.Вставить("ПорядокОтражения",ПорядокОтражения);
	СтруктураНастройки.Вставить("ОбъединитьГруппировки", ОбъединитьГруппировки);
	СтруктураНастройки.Вставить("ПолучитьРасходыПоПутевымЛистам", ПолучитьРасходыПоПутевымЛистам); 
	
	СохраняемыеЗначенияОбъектовПараметра = Новый Массив;
	Для Каждого ЭлементСписка из СписокОбъектовПараметра Цикл   
		Если ЭлементСписка.Пометка Тогда
			СохраняемыеЗначенияОбъектовПараметра.Добавить(ЭлементСписка.Значение);
		КонецЕсли;
	КонецЦикла;
	СтруктураНастройки.Вставить("МассивОбъектовПараметра", СохраняемыеЗначенияОбъектовПараметра); 

	Идентификатор = РеквизитФормыВЗначение("Отчет").Метаданные().Имя;
	ХранилищеСистемныхНастроек.Сохранить(Идентификатор, "Сеансовая", СтруктураНастройки);
	
КонецПроцедуры

&НаСервере
Функция _УправлениеЭлементамиФормы()
	
	ПоГрузоперевозкам = (Данные = 1);

	Элементы.Грузоперевозки.Видимость = ПоГрузоперевозкам;
	Элементы.БуферОбменаВставитьДляРеквизита.Видимость = ПоГрузоперевозкам;
	Элементы.ГруппаПериод.Видимость = (НЕ ПоГрузоперевозкам);
	Элементы.ДатаОпределенияПрибыли.Видимость = (НЕ ПоГрузоперевозкам);
	Элементы.ГруппаПараметрИЗначение.Видимость 	= (Данные =0);
	Элементы.ГруппаОбъектыПраметров.Видимость 	= (Данные =0) и ВыбранПараметрНаСервере();
	
	Элементы.ПолучитьРасходыПоПутевымЛистам.Доступность = ПорядокОтражения <> 2 и ВариантФормирования = 0;
	
	Если (ИспользованиеБюджетирования) Тогда
		ЕстьПлан = Ложь;
		Для каждого Стр Из Разделы Цикл
			Если ((Стр.Значение = "План" ИЛИ Стр.Значение = "Отклонение") И Стр.Пометка) Тогда
				ЕстьПлан = Истина;
				Прервать;
			КонецЕсли; 
		КонецЦикла; 
		Элементы.ВерсияБюджета.Видимость = ЕстьПлан;
	КонецЕсли; 
	
КонецФункции

&НаКлиенте
Процедура Сформировать(Команда)
	
	_Настройка(Истина);
	СформироватьОтчет();
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьОтчет()
	// --- 
	
	Раздел = Ложь;
	Для Каждого Стр из Разделы Цикл
		Раздел = ?(Стр.Пометка, Истина, Раздел);
	КонецЦикла;
	Если НЕ Раздел Тогда
		_УФК.ВывестиПредупреждение("Не отмечено ни одного раздела!");
		Возврат;		
	КонецЕсли;	
	
	Показатель = Ложь;
	Для Каждого Стр из Показатели Цикл
		Показатель = ?(Стр.Пометка, Истина, Показатель);
	КонецЦикла;
	Если НЕ Показатель Тогда
		_УФК.ВывестиПредупреждение("Не отмечено ни одного показателя!");
		Возврат;		
	КонецЕсли;	
	
	// записываем настройки во временное хранилище
	Отчет.АдресНастроек = _ПолучитьАдресНастроек();
	ЭтаФорма.СкомпоноватьРезультат();
	ОбработатьОтчет();
	
	Отчет.ВнешнийВызов = Ложь;	
	// --- 
	
	_СохранитьСеансовуюНастройку();
	
	// --- 
КонецПроцедуры

&НаСервере
Функция _ПолучитьАдресНастроек()
	// --- 
	
	Настройки = _сф.ст_Создать("Данные,ВариантФормирования,НачалоПериода,КонецПериода,ВерсияБюджета,Организация,ВыводитьРасходыДоходы,ДатаОпределенияПрибыли,ПолучаемоеЗначение,Показатели,Разделы,Группировки,ИсключатьВнутрихолдинговыеВзаиморасчеты,ПорядокОтражения,ВыводитьСтатистику,ВыводитьСтатистикуПлан,Грузоперевозки,ОбъединитьГруппировки,ПолучитьРасходыПоПутевымЛистам,ОбъектыПараметра");
	Настройки.Данные = Данные;
	Настройки.ВариантФормирования = ВариантФормирования;
	Настройки.ВыводитьРасходыДоходы = ВыводитьРасходыДоходы;
	
	Настройки.НачалоПериода = ?(Данные = 1, Неопределено,НачалоДня(НачалоПериода));
	Настройки.КонецПериода 	= ?(Данные = 1, Неопределено, КонецДня(КонецПериода));
	
	Настройки.ВерсияБюджета = ВерсияБюджета;
	Настройки.Организация 	= Организация;
	Настройки.Показатели 	= Показатели;
	Настройки.Разделы 		= Разделы;
	Настройки.Группировки 	= Группировки.Выгрузить();  
	
	Настройки.ДатаОпределенияПрибыли	= ДатаОпределенияПрибыли; 
	Настройки.ПолучаемоеЗначение		= ДатаОпределенияПрибылиПолучаемоеЗначение; 

	Настройки.ИсключатьВнутрихолдинговыеВзаиморасчеты = ИсключатьВнутрихолдинговыеВзаиморасчеты;
	Настройки.ПорядокОтражения 			= ПорядокОтражения;
	Настройки.ВыводитьСтатистику 		= ВыводитьСтатистику;
	Настройки.ВыводитьСтатистикуПлан 	= ВыводитьСтатистикуПлан;
	
	Настройки.Грузоперевозки 			= Грузоперевозки;
	Настройки.ОбъединитьГруппировки 	= ОбъединитьГруппировки;
	
	Настройки.ПолучитьРасходыПоПутевымЛистам 	= ПолучитьРасходыПоПутевымЛистам;    
	
	МассивОбъектовПараметра = Новый Массив;
	Для Каждого ЭлементСписка из СписокОбъектовПараметра Цикл   
		Если ЭлементСписка.Пометка Тогда
			МассивОбъектовПараметра.Добавить(ЭлементСписка.Значение);
		КонецЕсли;
	КонецЦикла;
	
	Настройки.ОбъектыПараметра = МассивОбъектовПараметра;    
	
	Возврат ПоместитьВоВременноеХранилище(Настройки,ЭтаФорма.УникальныйИдентификатор);
	
КонецФункции

