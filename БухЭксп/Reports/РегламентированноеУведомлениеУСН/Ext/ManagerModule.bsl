Функция КонтейнерДляЗаполнения_2025()
	Контейнер = Новый Структура;
	Контейнер.Вставить("Титульная", Новый Структура);
	
	Макет = Отчеты["РегламентированноеУведомлениеУСН"].ПолучитьМакет("Титульная_2025_1").ПолучитьОбласть("ОсновнаяЧасть");
	Для Каждого Обл Из Макет.Области Цикл 
		Если Обл.ТипОбласти = ТипОбластиЯчеекТабличногоДокумента.Прямоугольник
			И Обл.СодержитЗначение = Истина Тогда 
			Контейнер["Титульная"].Вставить(Обл.Имя);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Контейнер;
КонецФункции

Функция НовоеУведомлениеПоУСН_2025(Параметры)
	ИмяОтчета = "РегламентированноеУведомлениеУСН";
	ИмяФормы = "Форма2025_1";
	
	ПараметрыОтчета = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Параметры, "ПараметрыОтчета");
	
	Контейнер = КонтейнерДляЗаполнения(ИмяФормы);
	РегламентированнаяОтчетностьПереопределяемый.ЗаполнитьОтчет(ИмяОтчета, ИмяФормы, ПараметрыОтчета, Контейнер);
	
	Ссылка = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Параметры, "Ссылка");
	Организация = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Параметры, "Организация");
	РегистрацияВИФНС = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Параметры, "РегистрацияВИФНС");
	
	ДокументОбъект = ?(ЗначениеЗаполнено(Ссылка), 
		Ссылка.ПолучитьОбъект(),
		Документы.УведомлениеОСпецрежимахНалогообложения.СоздатьДокумент());
		
	ДокументОбъект.Организация = Организация;
	ДокументОбъект.РегистрацияВИФНС = РегистрацияВИФНС;
	
	ДокументОбъект.ПодписантФамилия = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Параметры, "ПодписантФамилия");
	ДокументОбъект.ПодписантИмя = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Параметры, "ПодписантИмя");
	ДокументОбъект.ПодписантОтчество = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Параметры, "ПодписантОтчество");
	
	ДатаПодписи = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Контейнер["Титульная"], "ДАТА_ПОДПИСИ");
	
	Если Не ЗначениеЗаполнено(ДатаПодписи) Тогда
		ДатаПодписи = ТекущаяДатаСеанса();
	КонецЕсли;
	
	ДокументОбъект.Дата = ДатаПодписи;
	ДокументОбъект.ДатаПодписи = ДатаПодписи;
	ДокументОбъект.Основание = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Параметры, "ДокументОснование");
	ДокументОбъект.ИмяОтчета = ИмяОтчета;
	ДокументОбъект.ИмяФормы = ИмяФормы;
	
	УИДТитульная = Новый УникальныйИдентификатор;
	ДеревоСтраниц = УведомлениеОСпецрежимахНалогообложения.ПустоеДеревоСтраницУведомления();
	
	Стр001 = ДеревоСтраниц.Строки.Добавить();
	Стр001.Наименование = "Основные данные";
	Стр001.ИндексКартинки = 1;
	Стр001.ИмяМакета = "Титульная_2025_1";
	Стр001.Многостраничность = Ложь;
	Стр001.Многострочность = Ложь;
	Стр001.УИД = Новый УникальныйИдентификатор;
	Стр001.ИДНаименования = "Титульная";
	
	Титульная = Контейнер["Титульная"];
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("ДеревоСтраниц", ДеревоСтраниц);
	СтруктураПараметров.Вставить("ДанныеУведомления", Новый Структура("Титульная", Титульная));
	СтруктураПараметров.Вставить("РазрешитьВыгружатьСОшибками", Ложь);
	СтруктураПараметров.Вставить("ИдентификаторыОбычныхСтраниц", Новый Структура("Титульная", УИДТитульная));
	СтруктураПараметров.Вставить("ДанныеМногостраничныхРазделов", Новый Структура);
	СтруктураПараметров.Вставить("ДанныеДопСтрокБД", Новый Структура);
	
	ДокументОбъект.ВидУведомления = ВидУведомленияПоПризнаку(ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Титульная, "ПрОснПрУвед", ""));
	ДокументОбъект.ДанныеУведомления = Новый ХранилищеЗначения(СтруктураПараметров);
	ДокументОбъект.Записать();
	Возврат ДокументОбъект.Ссылка;
КонецФункции

