// Возвращает контейнер, который надо заполнять данными
//
// Параметры:
//    ИмяФормы - Строка - например, Форма2025_1
// Возвращаемое значение:
//    Структура - контейнер для заполнения ДОПП
//
Функция КонтейнерДляЗаполнения(ИмяФормы) Экспорт
	Если ИмяФормы = "Форма2025_1" Тогда
		Возврат КонтейнерДляЗаполнения_2025();
	Иначе
		ВызватьИсключение "Не поддерживаемый параметр";
	КонецЕсли;
КонецФункции

// Создание нового или редактирование существующего уведомления по УСН
//
// Параметры:
// Данные - Структура с полями:
//   Организация - СправочникСсылка.Организации
//   РегистрацияВИФНС - СправочникСсылка.РегистрацииВНалоговомОргане
//   Контейнер - Структура - получена из КонтейнерДляЗаполнения(...) и заполнена данными
//   Ссылка - ДокументСсылка.УведомлениеОСпецрежимахНалогообложения для редактирования существующего уведомления или Неопределено для создания нового
//   ДокументОснование - ОпределяемыйТип.ОснованиеУведомления или Неопределено
//   ИмяФормы - Строка - например, Форма2025_1
//
// Возвращаемое значение:
//    ДокументСсылка.УведомлениеОСпецрежимахНалогообложения ссылка на вновь созданное уведомление
Функция НовоеУведомлениеПоУСН(Данные) Экспорт 
	ИмяФормы = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Данные, "ИмяФормы");
	Если ИмяФормы = "Форма2025_1" Тогда
		Возврат НовоеУведомлениеПоУСН_2025(Данные);
	Иначе
		ВызватьИсключение "Не поддерживаемый параметр";
	КонецЕсли;
КонецФункции

// Определяет возможность печати pdf-417
//
//   ИмяФормы - Строка - например, Форма2025_1
//
// Возвращаемое значение:
//    Булево - истина, если возможна печать pdf-417
Функция ДоступнаПечатьPDF417(ИмяФормы) Экспорт
	Если ИмяФормы = "Форма2025_1" Тогда
		Возврат Истина;
	Иначе
		ВызватьИсключение НСтр("ru = 'Функция ДоступнаПечатьPDF417():
			|вызов функции с непредусмотренным значением параметра'");
	КонецЕсли;
КонецФункции

// Возвращает стандартную таблицу форм
//
// Возвращаемое значение:
//    ТаблицаЗначений - стандартная таблица с редакциями форм
Функция ТаблицаФормОтчета() Экспорт
	Результат = УведомлениеОСпецрежимахНалогообложения.НоваяТаблицаФормОтчета();
	
	НоваяФорма = Результат.Добавить();
	НоваяФорма.ФормаОтчета        = "Форма2025_1";
	НоваяФорма.ОписаниеОтчета     = "В соответствии с приказом ФНС России от 30.04.2026 № ЕД-1-3/285@";
	НоваяФорма.РедакцияФормы      = "от 30.04.2026 № ЕД-1-3/285@";
	НоваяФорма.ДатаНачалоДействия = '20260731';
	
	Возврат Результат;
КонецФункции

