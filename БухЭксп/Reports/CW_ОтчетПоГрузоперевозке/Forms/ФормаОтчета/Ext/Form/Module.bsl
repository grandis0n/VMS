&НаСервере
Функция ПолучитьИсходящие()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	CW_ДоходыПоГрузоперевозкам.Контрагент КАК Контрагент,
		|	CW_ДоходыПоГрузоперевозкам.ДокументДоходов КАК Документ,
		|	CW_ДоходыПоГрузоперевозкам.ДокументДоходов.ПредставлениеДокумента КАК ПредставлениеДокумента,
		|	CW_ДоходыПоГрузоперевозкам.Валюта КАК Валюта,
		|	CW_ДоходыПоГрузоперевозкеУслуги.ПорядокОтражения КАК ПорядокОтражения,
		|	СУММА(CW_ДоходыПоГрузоперевозкам.Всего) КАК Всего,
		|	СУММА(CW_ДоходыПоГрузоперевозкам.Сумма) КАК Сумма,
		|	СУММА(CW_ДоходыПоГрузоперевозкам.НДС) КАК НДС,
		|	СУММА(CW_ДоходыПоГрузоперевозкам.Всего_Валюта) КАК Всего_Валюта,
		|	CW_ДоходыПоГрузоперевозкам.Грузоперевозка КАК Грузоперевозка
		|ПОМЕСТИТЬ Доходы
		|ИЗ
		|	РегистрНакопления.CW_ДоходыПоГрузоперевозкам КАК CW_ДоходыПоГрузоперевозкам
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.CW_ДоходыПоГрузоперевозке.Услуги КАК CW_ДоходыПоГрузоперевозкеУслуги
		|		ПО CW_ДоходыПоГрузоперевозкам.ДокументДоходов = CW_ДоходыПоГрузоперевозкеУслуги.Ссылка
		|			И CW_ДоходыПоГрузоперевозкам.НомерСтроки = CW_ДоходыПоГрузоперевозкеУслуги.НомерСтроки
		|ГДЕ
		|	CW_ДоходыПоГрузоперевозкам.Грузоперевозка В(&Грузоперевозки)
		|	И ВЫБОР
		|			КОГДА &Организация <> НЕОПРЕДЕЛЕНО
		|				ТОГДА CW_ДоходыПоГрузоперевозкам.ДокументДоходов.Организация = &Организация
		|			ИНАЧЕ ИСТИНА
		|		КОНЕЦ
		|	И ВЫБОР
		|			КОГДА &ОтображениеФинРез = 0
		|				ТОГДА CW_ДоходыПоГрузоперевозкам.ДокументДоходов.ФормируетсяАкт
		|						ИЛИ CW_ДоходыПоГрузоперевозкам.ДокументДоходов.ФормируетсяСчетФактура
		|			ИНАЧЕ CW_ДоходыПоГрузоперевозкам.ДокументДоходов.ФормируетсяСчет
		|		КОНЕЦ
		|
		|СГРУППИРОВАТЬ ПО
		|	CW_ДоходыПоГрузоперевозкам.Контрагент,
		|	CW_ДоходыПоГрузоперевозкам.Валюта,
		|	CW_ДоходыПоГрузоперевозкам.ДокументДоходов,
		|	CW_ДоходыПоГрузоперевозкам.ДокументДоходов.ПредставлениеДокумента,
		|	CW_ДоходыПоГрузоперевозкеУслуги.ПорядокОтражения,
		|	CW_ДоходыПоГрузоперевозкам.Грузоперевозка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Доходы.Контрагент КАК Контрагент,
		|	Доходы.Документ КАК Документ,
		|	Доходы.Валюта КАК Валюта,
		|	СУММА(Доходы.Всего) КАК Всего,
		|	СУММА(Доходы.Сумма) КАК Сумма,
		|	СУММА(Доходы.НДС) КАК НДС,
		|	СУММА(Доходы.Всего_Валюта) КАК Всего_Валюта
		|ПОМЕСТИТЬ ОтобранныеДоходы
		|ИЗ
		|	Доходы КАК Доходы
		|ГДЕ
		|	//УсловиеПорядокОтражения 
		|
		|СГРУППИРОВАТЬ ПО
		|	Доходы.Контрагент,
		|	Доходы.Документ,
		|	Доходы.Валюта
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ОтобранныеДоходы.Контрагент КАК Контрагент,
		|	ОтобранныеДоходы.Документ КАК Документ,
		|	ОтобранныеДоходы.Валюта КАК Валюта,
		|	ОтобранныеДоходы.Всего КАК ВсегоОборот,
		|	ОтобранныеДоходы.Сумма КАК СуммаОборот,
		|	ОтобранныеДоходы.НДС КАК НДСОборот,
		|	ОтобранныеДоходы.Всего_Валюта КАК ВсегоВалОборот
		|ИЗ
		|	ОтобранныеДоходы КАК ОтобранныеДоходы
		|
		|УПОРЯДОЧИТЬ ПО
		|	ОтобранныеДоходы.Документ.Дата";

	Запрос.УстановитьПараметр("Грузоперевозки", Грузоперевозки);
	Запрос.УстановитьПараметр("Организация", ?(Организация.Пустая(), Неопределено, Организация));
	Запрос.УстановитьПараметр("ОтображениеФинРез", ОтображениеФинРез);
	
	Если ПорядокОтражения = 0 Тогда
		
		УсловиеПорядокОтражения = "ИСТИНА";
		
	ИначеЕсли ПорядокОтражения = 1 Тогда 
		
		УсловиеПорядокОтражения = "Доходы.ПорядокОтражения В (&ПорядокОтраженияДоходов)";

		ПорядокОтраженияДоходов = Новый Массив;
		ПорядокОтраженияДоходов.Добавить(ПредопределенноеЗначение("Перечисление.CW_ПорядокОтраженияДоходов.СобственнаяУслуга"));
		ПорядокОтраженияДоходов.Добавить(ПредопределенноеЗначение("Перечисление.CW_ПорядокОтраженияДоходов.ПрочиеДоходы"));
		
		Запрос.УстановитьПараметр("ПорядокОтраженияДоходов", ПорядокОтраженияДоходов);
		
	ИначеЕсли ПорядокОтражения = 2 Тогда
		
		УсловиеПорядокОтражения = "Доходы.ПорядокОтражения В (&ПорядокОтраженияДоходов)";
		
		ПорядокОтраженияДоходов = Новый Массив;
		ПорядокОтраженияДоходов.Добавить(ПредопределенноеЗначение("Перечисление.CW_ПорядокОтраженияДоходов.Перевыставление"));
		
		Запрос.УстановитьПараметр("ПорядокОтраженияДоходов", ПорядокОтраженияДоходов);
		
	КонецЕсли; 
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "//УсловиеПорядокОтражения", УсловиеПорядокОтражения);
	
	ТЗ = Запрос.Выполнить().Выгрузить();
	
	Если (ИсключатьВнутрихолдинговыеВзаиморасчеты) Тогда
		
		МассивХолдинговыхКонтрагентов = CW_Финансы.ПолучитьКонтрагентовХолдинга();
		Если (МассивХолдинговыхКонтрагентов.Количество() <> 0) Тогда
			МассивУдаляемых = Новый Массив;
			Для каждого Стр Из ТЗ Цикл
				
				Если (МассивХолдинговыхКонтрагентов.Найти(Стр.Контрагент) <> Неопределено) Тогда
					МассивУдаляемых.Добавить(Стр);
				КонецЕсли; 
				
			КонецЦикла; 
			_сф.к_УдалитьЭлементыПоМассиву(ТЗ,МассивУдаляемых);
			
		КонецЕсли; 
		
	КонецЕсли; 
	
	ТЗ.Колонки.Добавить("ЕстьОригиналы");
	ТЗ.Колонки.Добавить("ПредставлениеДокумента");
	Для каждого Стр Из ТЗ Цикл
		
		СтруктураКонтроляОригиналов =  CW_Документы.ПолучитьПризнакНаличияИДатуВозвратаОригиналов(Стр.Документ);
		Признак 	= СтруктураКонтроляОригиналов.ОригиналыПредоставлены;
		
		Стр.ЕстьОригиналы = ?(Признак,"+","-");
		Стр.ПредставлениеДокумента = Стр.Документ.ПредставлениеДокумента;
		
	КонецЦикла;
	
	Возврат ТЗ;
	
КонецФункции	

&НаСервере
Функция ПолучитьВходящие()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	CW_РасходыПоГрузоперевозкам.Контрагент КАК Контрагент,
		|	CW_РасходыПоГрузоперевозкам.ДокументРасходов КАК Документ,
		|	CW_РасходыПоГрузоперевозкам.ДокументРасходов.ПредставлениеДокумента КАК ПредставлениеДокумента,
		|	CW_РасходыПоГрузоперевозкам.Валюта КАК Валюта,
		|	CW_РасходыПоГрузоперевозкеУслуги.ПорядокОтражения КАК ПорядокОтражения,
		|	СУММА(CW_РасходыПоГрузоперевозкам.Всего) КАК Всего,
		|	СУММА(CW_РасходыПоГрузоперевозкам.Сумма) КАК Сумма,
		|	СУММА(CW_РасходыПоГрузоперевозкам.НДС) КАК НДС,
		|	СУММА(CW_РасходыПоГрузоперевозкам.Всего_Валюта) КАК Всего_Валюта,
		|	CW_РасходыПоГрузоперевозкам.Грузоперевозка КАК Грузоперевозка
		|ПОМЕСТИТЬ Расходы
		|ИЗ
		|	РегистрНакопления.CW_РасходыПоГрузоперевозкам КАК CW_РасходыПоГрузоперевозкам
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.CW_РасходыПоГрузоперевозке.Услуги КАК CW_РасходыПоГрузоперевозкеУслуги
		|		ПО CW_РасходыПоГрузоперевозкам.ДокументРасходов = CW_РасходыПоГрузоперевозкеУслуги.Ссылка
		|			И CW_РасходыПоГрузоперевозкам.НомерСтроки = CW_РасходыПоГрузоперевозкеУслуги.НомерСтроки
		|ГДЕ
		|	CW_РасходыПоГрузоперевозкам.Грузоперевозка В(&Грузоперевозки)
		|	И ВЫБОР
		|			КОГДА &Организация <> НЕОПРЕДЕЛЕНО
		|				ТОГДА CW_РасходыПоГрузоперевозкам.ДокументРасходов.Организация = &Организация
		|			ИНАЧЕ ИСТИНА
		|		КОНЕЦ
		|	И ВЫБОР
		|			КОГДА &ОтображениеФинРез = 0
		|				ТОГДА CW_РасходыПоГрузоперевозкам.ДокументРасходов.ПредъявленАкт
		|						ИЛИ CW_РасходыПоГрузоперевозкам.ДокументРасходов.ПредъявленСФ
		|			ИНАЧЕ CW_РасходыПоГрузоперевозкам.ДокументРасходов.ПредъявленСчет
		|		КОНЕЦ
		|
		|СГРУППИРОВАТЬ ПО
		|	CW_РасходыПоГрузоперевозкам.Контрагент,
		|	CW_РасходыПоГрузоперевозкам.Валюта,
		|	CW_РасходыПоГрузоперевозкам.ДокументРасходов,
		|	CW_РасходыПоГрузоперевозкам.ДокументРасходов.ПредставлениеДокумента,
		|	CW_РасходыПоГрузоперевозкеУслуги.ПорядокОтражения,
		|	CW_РасходыПоГрузоперевозкам.Грузоперевозка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Расходы.Контрагент КАК Контрагент,
		|	Расходы.Документ КАК Документ,
		|	Расходы.Валюта КАК Валюта,
		|	СУММА(Расходы.Всего) КАК Всего,
		|	СУММА(Расходы.Сумма) КАК Сумма,
		|	СУММА(Расходы.НДС) КАК НДС,
		|	СУММА(Расходы.Всего_Валюта) КАК Всего_Валюта
		|ПОМЕСТИТЬ ОтобранныеРасходы
		|ИЗ
		|	Расходы КАК Расходы
		|ГДЕ
		|	//УсловиеПорядокОтражения  
		|
		|СГРУППИРОВАТЬ ПО
		|	Расходы.Контрагент,
		|	Расходы.Документ,
		|	Расходы.Валюта
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ОтобранныеРасходы.Контрагент КАК Контрагент,
		|	ОтобранныеРасходы.Документ КАК Документ,
		|	ОтобранныеРасходы.Валюта КАК Валюта,
		|	ОтобранныеРасходы.Всего КАК ВсегоОборот,
		|	ОтобранныеРасходы.Сумма КАК СуммаОборот,
		|	ОтобранныеРасходы.НДС КАК НДСОборот,
		|	ОтобранныеРасходы.Всего_Валюта КАК ВсегоВалОборот
		|ИЗ
		|	ОтобранныеРасходы КАК ОтобранныеРасходы
		|
		|УПОРЯДОЧИТЬ ПО
		|	ОтобранныеРасходы.Документ.Дата";

	Запрос.УстановитьПараметр("Грузоперевозки", 	Грузоперевозки);
	Запрос.УстановитьПараметр("Организация", 		?(Организация.Пустая(), Неопределено, Организация));
	Запрос.УстановитьПараметр("ОтображениеФинРез", 	ОтображениеФинРез);
	
	Если ПорядокОтражения = 0 Тогда
		
		УсловиеПорядокОтражения = "ИСТИНА";
		
	ИначеЕсли ПорядокОтражения = 1 Тогда 
		
		УсловиеПорядокОтражения = "Расходы.ПорядокОтражения В (&ПорядокОтраженияРасходов)";

		
		ПорядокОтраженияРасходов = Новый Массив;
		ПорядокОтраженияРасходов.Добавить(ПредопределенноеЗначение("Перечисление.CW_ПорядокОтраженияЗатрат.Затраты"));
		ПорядокОтраженияРасходов.Добавить(ПредопределенноеЗначение("Перечисление.CW_ПорядокОтраженияЗатрат.ПрочиеРасходы"));
		
		Запрос.УстановитьПараметр("ПорядокОтраженияРасходов", ПорядокОтраженияРасходов);
		
	ИначеЕсли ПорядокОтражения = 2 Тогда
		
		УсловиеПорядокОтражения = "Расходы.ПорядокОтражения В (&ПорядокОтраженияРасходов)";
	
		ПорядокОтраженияРасходов = Новый Массив;
		ПорядокОтраженияРасходов.Добавить(ПредопределенноеЗначение("Перечисление.CW_ПорядокОтраженияЗатрат.Перевыставление"));
		
		Запрос.УстановитьПараметр("ПорядокОтраженияРасходов", ПорядокОтраженияРасходов);
		
	КонецЕсли;
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "//УсловиеПорядокОтражения", УсловиеПорядокОтражения);
	
	ТЗ = Запрос.Выполнить().Выгрузить();
	
	Если (ИсключатьВнутрихолдинговыеВзаиморасчеты) Тогда
		
		МассивХолдинговыхКонтрагентов = CW_Финансы.ПолучитьКонтрагентовХолдинга();
		Если (МассивХолдинговыхКонтрагентов.Количество() <> 0) Тогда
			МассивУдаляемых = Новый Массив;
			Для каждого Стр Из ТЗ Цикл
				
				Если (МассивХолдинговыхКонтрагентов.Найти(Стр.Контрагент) <> Неопределено) Тогда
					МассивУдаляемых.Добавить(Стр);
				КонецЕсли; 
				
			КонецЦикла; 
			_сф.к_УдалитьЭлементыПоМассиву(ТЗ,МассивУдаляемых);
			
		КонецЕсли; 
		
	КонецЕсли; 
	
	ТЗ.Колонки.Добавить("ЕстьОригиналы");
	ТЗ.Колонки.Добавить("ПредставлениеДокумента");
	Для каждого Стр Из ТЗ Цикл
		
		СтруктураКонтроляОригиналов =  CW_Документы.ПолучитьПризнакНаличияИДатуВозвратаОригиналов(Стр.Документ);
		Признак 	= СтруктураКонтроляОригиналов.ОригиналыПредоставлены;
		
		Стр.ЕстьОригиналы = ?(Признак,"+","-");
		Стр.ПредставлениеДокумента = Стр.Документ.ПредставлениеДокумента;
		
	КонецЦикла;
	
	Возврат ТЗ;
	
КонецФункции	

&НаСервере
Функция Задолженность(Док)
	
	Если ОтображениеФинРез = 0 Тогда
		массСчетаВзаиморасчетов = Новый Массив();
		Если ТипЗнч(Док) = Тип("ДокументСсылка.CW_РасходыПоГрузоперевозке") Тогда
			Если НЕ ЗначениеЗаполнено(Док.ВедомыйДокумент) Тогда
				Возврат 0;
			КонецЕсли;
			// счет можно взять из ведомого документа
			массСчетаВзаиморасчетов.Добавить(Док.ВедомыйДокумент.СчетУчетаРасчетовСКонтрагентом);
			знакОстатка = -1; // кредитовый
			
		ИначеЕсли ТипЗнч(док) = Тип("ДокументСсылка.CW_ДоходыПоГрузоперевозке") Тогда
			Если НЕ ЗначениеЗаполнено(Док.ВедомыйДокумент) Тогда
				Возврат 0;
			КонецЕсли;
			// счет расчетов с покупателями - всегда 62.01, но может быть и другой, если он задан в уч.политике
			Счета = CW_Конфигурация.ПланСчетов(); 
			массСчетаВзаиморасчетов.Добавить(Счета.РасчетыСПокупателями);
			массСчетаВзаиморасчетов.Добавить(Счета.РасчетыСПокупателямиВал);
			массСчетаВзаиморасчетов.Добавить(Счета.РасчетыСПокупателямиУЕ);

			сч = CW_Настройки.ПараметрУчетнойПолитики(Док.Дата, Док.Организация, "СчетРасчетов_Клиенты_Рубли");
			Если ЗначениеЗаполнено(сч) И (Неопределено = массСчетаВзаиморасчетов.Найти(сч)) Тогда
				массСчетаВзаиморасчетов.Добавить(сч);
			КонецЕсли;
			сч = CW_Настройки.ПараметрУчетнойПолитики(Док.Дата, Док.Организация, "СчетРасчетов_Клиенты_Валюта");
			Если ЗначениеЗаполнено(сч) И (Неопределено = массСчетаВзаиморасчетов.Найти(сч)) Тогда
				массСчетаВзаиморасчетов.Добавить(сч);
			КонецЕсли;
			знакОстатка = 1; // дебетовый
			
		Иначе
			Сообщить("Не поддерживается расчет задолженности для документов " + Док);
			Возврат "?";
		КонецЕсли;
		
		СтруктураПараметров = Новый Структура;
		СтруктураПараметров.Вставить("Договор", 			док.Договор);
		СтруктураПараметров.Вставить("ПриложениеКДоговору",	док.ПриложениеКДоговору);
		
		УчетныйДоговор = CW_Финансы.ПолучитьУчетныйДоговор(СтруктураПараметров);
		
		// все счета должны иметь данный набор субконто (здесь не проверяем)
		массВидыСубконто = Новый Массив();
		ВидыСубконто = CW_Конфигурация.ВидыСубконто();
		массВидыСубконто.Добавить(ВидыСубконто.Контрагенты);
		массВидыСубконто.Добавить(ВидыСубконто.Договоры);
		массВидыСубконто.Добавить(ВидыСубконто.ДокументыРасчетовСКонтрагентами);
		
		Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	ВЫБОР
		|		КОГДА ХозрасчетныйОстатки.Счет.Валютный
		|			ТОГДА ХозрасчетныйОстатки.ВалютнаяСуммаОстаток
		|		ИНАЧЕ ХозрасчетныйОстатки.СуммаОстаток
		|	КОНЕЦ КАК СуммаОстаток
		|ИЗ
		|	РегистрБухгалтерии.Хозрасчетный.Остатки(
		|			,
		|			Счет В (&массСчетаВзаиморасчетов),
		|			&массВидыСубконто,
		|			Организация = &Организация
		|				И Субконто1 = &Контрагент
		|				И Субконто2 = &Договор
		|				И Субконто3 = &ДокументРасчетов) КАК ХозрасчетныйОстатки"
		); 

		Запрос.УстановитьПараметр("массСчетаВзаиморасчетов", массСчетаВзаиморасчетов);
		Запрос.УстановитьПараметр("массВидыСубконто", массВидыСубконто);
		Запрос.УстановитьПараметр("Организация", док.Организация);
		Запрос.УстановитьПараметр("Контрагент", док.Контрагент);
		Запрос.УстановитьПараметр("Договор", 	УчетныйДоговор);
		Запрос.УстановитьПараметр("ДокументРасчетов", док.ВедомыйДокумент);
		Рез = Запрос.Выполнить().Выбрать();
		Если НЕ Рез.Следующий() Тогда
			Возврат 0;
		КонецЕсли;
		
		сум = Рез.СуммаОстаток * знакОстатка;
		
	ИначеЕсли ОтображениеФинРез = 1 Тогда
		
		Если ТипЗнч(Док) = Тип("ДокументСсылка.CW_РасходыПоГрузоперевозке") Тогда
			Запрос = Новый Запрос;
			Запрос.Текст =
				"ВЫБРАТЬ
				|	CW_ОперативнаяКредиторскаяЗадолженностьОстатки.Всего_ВалютаОстаток
				|ИЗ
				|	РегистрНакопления.CW_ОперативнаяКредиторскаяЗадолженность.Остатки(, Счет = &Док) КАК CW_ОперативнаяКредиторскаяЗадолженностьОстатки";
			Запрос.УстановитьПараметр("НаДату", Док.Дата); 	
			Запрос.УстановитьПараметр("Док", Док);
			Рез = Запрос.Выполнить().Выбрать();
			Если НЕ Рез.Следующий() Тогда
				Возврат 0;
			КонецЕсли;
			
			сум = Рез.Всего_ВалютаОстаток;
			
		ИначеЕсли ТипЗнч(Док) = Тип("ДокументСсылка.CW_ДоходыПоГрузоперевозке") Тогда	
			Запрос = Новый Запрос;
			Запрос.Текст =
				"ВЫБРАТЬ
				|	CW_ОперативнаяДебиторскаяЗадолженностьОстатки.Всего_ВалютаОстаток
				|ИЗ
				|	РегистрНакопления.CW_ОперативнаяДебиторскаяЗадолженность.Остатки(, Счет = &Док) КАК CW_ОперативнаяДебиторскаяЗадолженностьОстатки";
			Запрос.УстановитьПараметр("НаДату", Док.Дата); 	
			Запрос.УстановитьПараметр("Док", Док);
			Рез = Запрос.Выполнить().Выбрать();
			Если НЕ Рез.Следующий() Тогда
				Возврат 0;
			КонецЕсли;
			
			сум = Рез.Всего_ВалютаОстаток;
			
		КонецЕсли;	
		
	КонецЕсли;	
	
	//Выводить сальдо по (0) грузоперевозке (1) документу расчетов
	Если ВыводЗадолженности = 0 Тогда 
		Если Док.СуммаДокумента <> 0 Тогда
			// посчитаем сумму услуг документа по выбранным г/п
			СуммаУслуг = 0;
			ТаблицаУслуг = Док.Услуги.Выгрузить();
			Для Каждого Стр Из Грузоперевозки Цикл
				Отбор = _сф.ст_Отбор("Грузоперевозка", Стр.Значение);
				_сф.Инкремент(СуммаУслуг, ТаблицаУслуг.Скопировать(Отбор, "Всего").Итог("Всего"));
			КонецЦикла; 
			сум = сум * СуммаУслуг / Док.СуммаДокумента;
		КонецЕсли;
	КонецЕсли;
	
	Возврат сум;
	
КонецФункции

