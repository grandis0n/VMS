&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("Грузоперевозки", Грузоперевозки) Тогда
		СформироватьПриОткрытии = Истина;
	КонецЕсли; 
	ОтображениеФинРез = CW_Настройки.ПолучитьНастройкуПользователя(CW_Настройки.Пользователь(), "ОтображениеФинРез");
	ИсключатьВнутрихолдинговыеВзаиморасчеты = CW_Настройки.ПолучитьНастройкуПользователя(CW_Настройки.Пользователь(), "ИсключатьВнутрихолдинговыеВзаиморасчеты");
	
	ВРУ = Константы.ВалютаРегламентированногоУчета.Получить();
	
	//Работа с буфером обмена
	// Проверка буфера обмена на наличие скопированных строк
	УстановитьДоступностьКомандыВставки(ЭтотОбъект, Не CW_РаботаСБуферомОбмена.ПустойБуферОбмена());
	//Работа с буфером обмена   
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Элементы.ФормаНастройка.Пометка = Истина;
	
	Если СформироватьПриОткрытии Тогда
		СформироватьПриОткрытии = Ложь;
		_Настройка();
		//ФормированиеОтчета = 0;
		ВыводЗадолженности = 0;
		Организация = ПредопределенноеЗначение("Справочник.Организации.ПустаяСсылка");
		_СформироватьОтчет();
	Иначе
		_ВосстановитьСеансовуюНастройку();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, СтандартнаяОбработка)
	
	//_СохранитьСеансовуюНастройку();
	
КонецПроцедуры

// --- 

&НаКлиенте
Процедура Настройка(Команда)
	
	_Настройка(); 
	
КонецПроцедуры

&НаСервере
Процедура _Настройка(Скрыть=Ложь)
	
	Если Скрыть Тогда
		Элементы.ГруппаНастройкиОтчета.Видимость = Ложь;
		Элементы.ФормаНастройка.Пометка=Ложь;
	Иначе
		Если Элементы.ГруппаНастройкиОтчета.Видимость Тогда
			Элементы.ГруппаНастройкиОтчета.Видимость = Ложь;
			Элементы.ФормаНастройка.Пометка=Ложь;
		Иначе
			Элементы.ГруппаНастройкиОтчета.Видимость = Истина;
			Элементы.ФормаНастройка.Пометка=Истина;
		КонецЕсли; 
	КонецЕсли; 
		
КонецПроцедуры

// ---

&НаКлиенте
Процедура ГрузоперевозкиПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа)
	
	Отказ = Истина;
	// ---
	ПОВ = Новый ОписаниеОповещения("ОбработкаДобавленияГрузоперевозки",ЭтотОбъект); 
	ПФ = Новый Структура("МножественныйВыбор,РежимВыбора",Истина,Истина);
	ОткрытьФорму("Справочник.CW_Грузоперевозки.ФормаВыбора",ПФ,,,,,ПОВ, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаДобавленияГрузоперевозки(Ответ, ДополнительныеПараметры) Экспорт 
	// --- 
	
	Если Ответ <> Неопределено Тогда
		Для каждого ГП Из Ответ Цикл
			Грузоперевозки.Добавить(ГП);	
		КонецЦикла; 
	КонецЕсли; 
	
	// --- 
КонецПроцедуры
  

