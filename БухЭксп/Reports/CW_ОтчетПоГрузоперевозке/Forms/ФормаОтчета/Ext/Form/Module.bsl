&НаСервере
Процедура ПриСохраненииПользовательскихНастроекНаСервере(Настройки)
	
	Настройки.ДополнительныеСвойства.Вставить("Организация", Организация);
	Настройки.ДополнительныеСвойства.Вставить("ФормированиеОтчета", ОтображениеФинРез);
	Настройки.ДополнительныеСвойства.Вставить("ПорядокОтражения", ПорядокОтражения);
	Настройки.ДополнительныеСвойства.Вставить("ВыводЗадолженности", ВыводЗадолженности);
	//Настройки.ДополнительныеСвойства.Вставить("Грузоперевозки", Грузоперевозки);
	
КонецПроцедуры

&НаСервере
Процедура ПриЗагрузкеПользовательскихНастроекНаСервере(Настройки)
	
	Если НЕ СформироватьПриОткрытии Тогда
		CW_Отчеты.ПриЗагрузкеПользовательскихНастроекНаСервере(ЭтаФорма, Настройки);
	КонецЕсли;	
		
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьГрузоперевозки(Команда)
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ПослеЗакрытияФормыВыбораГрузоперевозок",ЭтаФорма);
	ПараметрыФормы = Новый Структура("МножественныйВыбор,ЗакрыватьПриВыборе,РежимВыбора", Истина, Истина, Истина);
	ОткрытьФорму("Справочник.CW_Грузоперевозки.ФормаВыбора",ПараметрыФормы,ЭтаФорма,,,,ОписаниеОповещения,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияФормыВыбораГрузоперевозок(РезультатВыбора, ДопПараметры) Экспорт
	
	Если Не РезультатВыбора = Неопределено Тогда
		
		Для Каждого ЗначениеВыбора из РезультатВыбора Цикл
			
			Если Грузоперевозки.НайтиПоЗначению(ЗначениеВыбора) = Неопределено Тогда
				Грузоперевозки.Добавить(ЗначениеВыбора);
			КонецЕсли;

		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьГрузоперевозки(Команда)
	
	Грузоперевозки.Очистить();
	
КонецПроцедуры

&НаКлиенте
Процедура ПодборГрузоперевозокПоТексту(Команда)
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ОбработкаИзмененияОтбораПоТексту", ЭтотОбъект);
	
	ПараметрыФормы  = Новый Структура;
	ПараметрыФормы.Вставить("ОбъектСсылка", Неопределено);
	
	ОткрытьФорму("ОбщаяФорма.CW_ЖурналГрузоперевозок_ОтборКонтейнеровПоТексту",ПараметрыФормы, ЭтаФорма,,,, ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры    

&НаКлиенте
Процедура ОбработкаИзмененияОтбораПоТексту(РезультатВыбора, ДополнительныеПараметры) Экспорт
	
	Если РезультатВыбора = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если РезультатВыбора.Свойство("НастройкиОтбора") Тогда 
		Для Каждого ЗначениеВМассиве из РезультатВыбора.НастройкиОтбора Цикл
			Если Грузоперевозки.НайтиПоЗначению(ЗначениеВМассиве) = Неопределено Тогда
				Грузоперевозки.Добавить(ЗначениеВМассиве);	
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры


//Работа с буфером обмена
&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "ДанныеСкопированыВБуферОбмена" Тогда
		УстановитьДоступностьКомандыВставки(ЭтотОбъект, Истина);
	КонецЕсли;

КонецПроцедуры  

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьДоступностьКомандыВставки(Форма, Доступность)

	Доступность = Не Форма.ТолькоПросмотр И Доступность;
	Элементы = Форма.Элементы;
	Элементы.КомандаБуфераОбменаВставить.Доступность = Доступность;
	
КонецПроцедуры  

&НаКлиенте
Процедура БуфераОбменаВставить(Команда)
	КоличествоСтрок = БуфераОбменаВставитьНаСервере();
	Если КоличествоСтрок <> Неопределено Тогда
		CW_РаботаСБуферомОбменаКлиент.ОповеститьОВставкеСтрокИзБуфераОбмена(ЭтаФорма, КоличествоСтрок);	
	КонецЕсли; 
КонецПроцедуры

&НаСервере
Функция БуфераОбменаВставитьНаСервере()
	
	ДанныеБуфераОбмена 	= CW_РаботаСБуферомОбмена.СтрокиИзБуфераОбмена(); 
	ТипИсточника		= CW_РаботаСБуферомОбмена.ПолучитьТипОбъектаПоИмени(ДанныеБуфераОбмена.Источник); 
	Если ТипИсточника <> тип("СправочникСсылка.CW_Грузоперевозки") Тогда
		Возврат Неопределено;
	КонецЕсли;   
	
	Грузоперевозки.ЗагрузитьЗначения(ДанныеБуфераОбмена.Данные);
	
	Возврат ДанныеБуфераОбмена.Данные.Количество();

КонецФункции
//Работа с буфером обмена  
