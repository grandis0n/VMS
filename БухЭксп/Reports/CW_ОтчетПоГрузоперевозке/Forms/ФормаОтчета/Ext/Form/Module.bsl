&НаКлиенте
Процедура Сформировать(Команда)
	
	_Настройка(Истина);
	_СформироватьОтчет();
	
КонецПроцедуры

&НаСервере
Процедура _СформироватьОтчет()
	
	CW_ВалютаРегламентированногоУчетаРубль = ПолучитьФункциональнуюОпцию("CW_ВалютаРегламентированногоУчетаРубль");
	Если не CW_ВалютаРегламентированногоУчетаРубль тогда
		ОтображениеФинРез = 1;
	КонецЕсли;

	
	ТаблДок = Новый ТабличныйДокумент;	
	МакетОтчета = РеквизитФормыВЗначение("Отчет").ПолучитьМакет("Отчет");
	
	// Заголовок
	Область = МакетОтчета.ПолучитьОбласть("Заголовок");
	Область.Параметры.Заголовок = ВРег("Отчёт по грузоперевозкам");
	Область.Параметры.Фильтр = "Грузоперевозки: "+_сф.сп_Представление(Грузоперевозки, ",", Ложь) + " " + ?(ОтображениеФинРез = 0, "(по актам)", "(по счетам)");
	ТаблДок.Вывести(Область);
	
	// Входящие документы
	ТЗ_В = ПолучитьВходящие();
			
	Область = МакетОтчета.ПолучитьОбласть("Шапка"); 
	Область.Параметры.ЗаголовокТаблицы 	= "Входящие документы";
	Область.параметры.ВРУ 				= Строка(ВРУ);
	ТаблДок.Вывести(Область);
	
	Долг = 0;
	Для Каждого Стр из ТЗ_В Цикл
		Область = МакетОтчета.ПолучитьОбласть("Строка");
		Область.Параметры.Заполнить(Стр);
		Область.Параметры.ПредставлениеДокумента = ?(ОтображениеФинРез = 1, "Счет №" + Стр.Документ.НомерСчета + " от " + Формат(Стр.Документ.ДатаСчета, "ДЛФ=Д"), Стр.ПредставлениеДокумента);
		Область.Параметры.Задолженность = Задолженность(Стр.Документ);
		// --- 		
		ВТД = Новый ТабличныйДокумент;
		ВТД.Вывести(Область);
		Если (Область.Параметры.Задолженность > 0) Тогда
			
			ЯчейкаЗадолженности = ВТД.Область("R1C9");
			ЯчейкаЗадолженности.ЦветФона = WebЦвета.ЛососьСветлый;
	
		КонецЕсли; 
		// --- 
		Долг = Долг + Область.Параметры.Задолженность;
		ТаблДок.Вывести(ВТД);	
	КонецЦикла;	
	
	ТЗ_ = ТЗ_В.Скопировать();
	ТЗ_.Свернуть("Валюта");
	
	Область = МакетОтчета.ПолучитьОбласть("Итого");
	Область.Параметры.ВсегоВалОборот = ?(ТЗ_.Количество() = 1, ТЗ_В.Итог("ВсегоВалОборот"), " Х ");
	Область.Параметры.ВсегоОборот    = ТЗ_В.Итог("ВсегоОборот");
	Область.Параметры.СуммаОборот    = ТЗ_В.Итог("СуммаОборот");
	Область.Параметры.НДСОборот      = ТЗ_В.Итог("НДСОборот");
	Область.Параметры.Задолженность  = ?(ТЗ_.Количество() = 1, Долг, " Х ");
	ТаблДок.Вывести(Область);
	
	// Исходящие документы
	ТЗ_И = ПолучитьИсходящие();
			
	Область = МакетОтчета.ПолучитьОбласть("Шапка"); 
	Область.Параметры.ЗаголовокТаблицы = "Исходящие документы";
	ТаблДок.Вывести(Область);
	
	Долг = 0;
	Для Каждого Стр из ТЗ_И Цикл
		Область = МакетОтчета.ПолучитьОбласть("Строка");
		Область.Параметры.Заполнить(Стр); 
		Область.Параметры.ПредставлениеДокумента = ?(ОтображениеФинРез = 1, "Счет №" + Стр.Документ.НомерСчета + " от " + Формат(Стр.Документ.ДатаСчета, "ДЛФ=Д"), Стр.ПредставлениеДокумента);
		Область.Параметры.Задолженность = Задолженность(Стр.Документ);
		// --- 		
		ВТД = Новый ТабличныйДокумент;
		ВТД.Вывести(Область);
		Если (Область.Параметры.Задолженность > 0) Тогда
			
			ЯчейкаЗадолженности = ВТД.Область("R1C9");
			ЯчейкаЗадолженности.ЦветФона = WebЦвета.ЛососьСветлый;
	
		КонецЕсли; 
		// --- 
		Долг = Долг + Область.Параметры.Задолженность;
		ТаблДок.Вывести(ВТД);	
	КонецЦикла;	
	
	ТЗ_ = ТЗ_И.Скопировать();
	ТЗ_.Свернуть("Валюта");
	
	Область = МакетОтчета.ПолучитьОбласть("Итого");
	Область.Параметры.ВсегоВалОборот = ?(ТЗ_.Количество() = 1, ТЗ_И.Итог("ВсегоВалОборот"), " Х ");
	Область.Параметры.ВсегоОборот = ТЗ_И.Итог("ВсегоОборот");
	Область.Параметры.СуммаОборот = ТЗ_И.Итог("СуммаОборот");
	Область.Параметры.НДСОборот   = ТЗ_И.Итог("НДСОборот");
	Область.Параметры.Задолженность  = ?(ТЗ_.Количество() = 1, Долг, " Х ");	
	ТаблДок.Вывести(Область);		
	
	// Подвал
	Область = МакетОтчета.ПолучитьОбласть("Подвал");
	Область.Параметры.ПрибыльСНДС   = ТЗ_И.Итог("ВсегоОборот") - ТЗ_В.Итог("ВсегоОборот");
	Область.Параметры.ПрибыльБезНДС = ТЗ_И.Итог("СуммаОборот") - ТЗ_В.Итог("СуммаОборот");
	Область.Параметры.ВРУ 			= Строка(ВРУ);
	ТаблДок.Вывести(Область);
	
	CW_Отчеты.ЗаменитьТекстВТаблицеРезультата(ТаблДок, " Х ", "Х", ГоризонтальноеПоложение.Центр);	
	Если Область.Параметры.ПрибыльСНДС < 0 ИЛИ Область.Параметры.ПрибыльБезНДС < 0 Тогда
		ТаблДок.Область("R" + Строка(14 + ТЗ_И.Количество() + ТЗ_В.Количество()) + "C2").ЦветТекста = WebЦвета.Красный;	
	КонецЕсли;	
	
	
	// Покажем
	Результат = ТаблДок;
	Результат.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	Результат.АвтоМасштаб = Истина;
	
	// --- 
	_СохранитьСеансовуюНастройку();
	
КонецПроцедуры

