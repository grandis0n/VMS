
#Область ВызовВнешнихОбработокВКачествеКоманд

Функция ВызватьВнешнююОбработкуОтчет(НазваниеОбработки,ПараметрыФормы,Действие=Неопределено,Владелец=Неопределено) Экспорт

	ЭтоОтчет = Истина;	
	ОбработчикСтрокой = "";
	Ответ = VMS_Сервер.ПодключитьВнешнююОбработкуОтчет(НазваниеОбработки,ОбработчикСтрокой);
	ИмяОбработки = Ответ.ИмяОбработки;
	Если ИмяОбработки = Неопределено Тогда
		Возврат Неопределено;
	КОнецЕсли;
	ПараметрыФормы.Вставить("ДополнительнаяОбработкаСсылка",Ответ.Обработка);
	
	Если Действие = "Получить" Тогда
		Форма = ПолучитьФорму(ОбработчикСтрокой+ ИмяОбработки +".Форма",ПараметрыФормы,Владелец);
	Иначе
		Форма = ОткрытьФорму(ОбработчикСтрокой+ ИмяОбработки +".Форма",ПараметрыФормы,Владелец);	
	КонецЕсли;
	
	Возврат Форма;
КонецФункции


#КонецОбласти

Функция ВызватьВнешнююОбработку(Обработка,ПараметрыФормы,Действие=Неопределено) Экспорт

	АдресХранилища = "";
	ИмяФайла = ПолучитьИмяВременногоФайла("epf");
	ДвоичныеДанные = VMS_Сервер.ПолучитьНаСервере(Обработка);
	ДвоичныеДанные.Записать(ИмяФайла);
	Результат = ПоместитьФайл(АдресХранилища, ИмяФайла, , Ложь);
	
	ИмяОбработки = VMS_Сервер.ПодключитьВнешнююОбработку(АдресХранилища);	
	Если Действие = "Получить" Тогда
		Форма = ПолучитьФорму("ВнешняяОбработка."+ ИмяОбработки +".Форма",ПараметрыФормы);
	Иначе
		Форма = ОткрытьФорму("ВнешняяОбработка."+ ИмяОбработки +".Форма",ПараметрыФормы);	
	КонецЕсли;
	
	УдалитьФайлы(ИмяФайла);
	Возврат Форма;
КонецФункции


