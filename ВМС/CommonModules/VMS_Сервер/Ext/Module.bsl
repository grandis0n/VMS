	Подключено = Ложь;
	Пока ПопытокПодключения<>0 Цикл 
		Попытка
			Соединение.Подключиться(Профиль);
			Подключено = Истина;
			Прервать;
		Исключение
			Причина = ОписаниеОшибки(); 
			ПопытокПодключения = ПопытокПодключения - 1;
		КонецПопытки;
	КонецЦикла;
	Если НЕ Подключено Тогда
		//ЗаписатьОшибкуВФайл(Формат(ТекущаяДата(),"")+" Ошибка отправки клиенту информации о плановой доставке на склад - невозможно соединиться с сервером");
	КонецЕсли;

КонецПроцедуры

Функция ВернутьЯщикФизическогоЛицаФарес(ФизЛицо,СЗапятой = Ложь) Экспорт
	Если Не ЗначениеЗаполнено(ФизЛицо) Тогда
		Возврат "";
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	КонтактныеЛицаКонтактнаяИнформация.Представление
		|ИЗ
		|	Справочник.ФизическиеЛица КАК ФизическиеЛица
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтактныеЛица.КонтактнаяИнформация КАК КонтактныеЛицаКонтактнаяИнформация
		|		ПО ФизическиеЛица.Фамилия = КонтактныеЛицаКонтактнаяИнформация.Ссылка.Фамилия
		|			И ФизическиеЛица.Имя = КонтактныеЛицаКонтактнаяИнформация.Ссылка.Имя
		|			И (КонтактныеЛицаКонтактнаяИнформация.Вид = &Вид)
		|ГДЕ
		|	ФизическиеЛица.Ссылка = &Ссылка
		|	И ЕСТЬNULL(КонтактныеЛицаКонтактнаяИнформация.Представление, """") <> """"";
	
	Запрос.УстановитьПараметр("Вид", Справочники.ВидыКонтактнойИнформации.EmailКонтактныеЛица);
	Запрос.УстановитьПараметр("Ссылка", ФизЛицо);
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат "";
	КонецЕсли;
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();	
	ВыборкаДетальныеЗаписи.Следующий();
	
	Возврат ?(СЗапятой,",","")+ВыборкаДетальныеЗаписи.Представление;
КонецФункции // ВернутьЯщикФизическогоЛицаФарес()

