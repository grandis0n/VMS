#Область ВызовВнешнихОбработокВКачествеКоманд

Функция ПодключитьОбработку(ПодключаемыйОбъект)  Экспорт	
	АдресОбработки = ПолучитьНавигационнуюСсылку(ПодключаемыйОбъект,"ХранилищеОбработки");
	ИмяВнешнейОбработки = ВнешниеОбработки.Подключить(АдресОбработки,ИдентификаторОбработки(ПодключаемыйОбъект),Ложь);
	Возврат(Истина);
КонецФункции

Функция ИдентификаторОбработки(ПодключаемыйОбъект)  
	// --- 	
	ИД = _сф.УИДСтрокой(ПодключаемыйОбъект.Ссылка);
	ИД = СтрЗаменить(ИД,"-","");
	ИД = "ПО_"+ИД;
	
	Возврат(ИД);	
	// --- 
КонецФункции

Функция ПолучитьОбработку(Обработка) Экспорт
	
	Если ТипЗнч(Обработка) = Тип("Строка") тогда 
		ПодключаемаяОбработкаСсылка = Справочники.ДополнительныеОтчетыИОбработки.НайтиПоНаименованию(Обработка);	
	ИначеЕсли ТипЗнч(Обработка) = Тип("СправочникСсылка.ДополнительныеОтчетыИОбработки") Тогда
		ПодключаемаяОбработкаСсылка = Обработка;
	Иначе
		ВызватьИсключение "VMS_Сервер.ПолучитьОбработку(Обработка): неверный параметр ""Обработка""";	
	КонецЕсли;
	
	
	Если ПодключаемаяОбработкаСсылка <> Неопределено тогда	
		ПодключаемаяОбработка = ПодключаемаяОбработкаСсылка.ПолучитьОбъект();
		Если (ПодключитьОбработку(ПодключаемаяОбработка)) Тогда
			ВнешняяОбработка = ВнешниеОбработки.Создать(ИдентификаторОбработки(ПодключаемаяОбработка));		
			Возврат ВнешняяОбработка;
		КонецЕсли;
	КонецЕсли;
	Возврат "";
КонецФункции

Функция ВыполнитьПроцедуруФункциюИзВнешнейОБработки(НаименованиеОбработки, НаименованиеПроцедурыФункции, ДопПараметрыСтруктурой, ЭтоФункция = истина) Экспорт
	ПодключаемаяОбработкаСсылка = Справочники.ДополнительныеОтчетыИОбработки.НайтиПоНаименованию(НаименованиеОбработки);	
	Если ПодключаемаяОбработкаСсылка <> Неопределено тогда	
		ПодключаемаяОбработка = ПодключаемаяОбработкаСсылка.ПолучитьОбъект();
		Если (ПодключитьОбработку(ПодключаемаяОбработка)) Тогда
			ВнешняяОбработка = ВнешниеОбработки.Создать(ИдентификаторОбработки(ПодключаемаяОбработка));
			СтрокаПараметров = "";
			Для каждого ЭлементДопПараметров Из ДопПараметрыСтруктурой цикл
				Если СтрокаПараметров <> "" тогда СтрокаПараметров = СтрокаПараметров + "," КонецЕсли;;
				СтрокаПараметров = СтрокаПараметров + "ДопПараметрыСтруктурой." + ЭлементДопПараметров.Ключ; 		
			КонецЦикла;	
			Ответ = Неопределено;
			Если ЭтоФункция тогда
				Выполнить("Ответ = ВнешняяОбработка." + НаименованиеПроцедурыФункции + "("+СтрокаПараметров+ ");"); 	
			Иначе
				Выполнить("ВнешняяОбработка." + НаименованиеПроцедурыФункции + "("+СтрокаПараметров+ ");");
			КонецЕсли;
			Возврат Ответ;
		КонецЕсли;
	КонецЕсли;	
КонецФункции

Функция ПодключитьВнешнююОбработкуОтчет(НазваниеОбработки,ОбработчикСтрокой) Экспорт 
	Обработка = Справочники.ДополнительныеОтчетыИОбработки.НайтиПоНаименованию(НазваниеОбработки);
	
	Если Обработка.Вид = Перечисления.ВидыДополнительныхОтчетовИОбработок.ДополнительнаяОбработка Тогда	
		МенежерНаУстановку = ВнешниеОбработки;
		ОбработчикСтрокой = "ВнешняяОбработка.";
	ИначеЕсли Обработка.Вид = Перечисления.ВидыДополнительныхОтчетовИОбработок.ДополнительныйОтчет Тогда	
		МенежерНаУстановку = ВнешниеОтчеты;
		ОбработчикСтрокой = "ВнешнийОтчет.";
	Иначе
		Возврат Неопределено;
	КонецЕсли;
			
	Возврат Новый Структура("Обработка,ИмяОбработки",Обработка,МенежерНаУстановку.Подключить(ПоместитьВоВременноеХранилище(Обработка.ХранилищеОбработки.Получить()),,Ложь));
КонецФункции

Функция ПодключитьВнешнююОбработку(АдресХранилища) Экспорт 
	Возврат ВнешниеОбработки.Подключить(АдресХранилища,,Ложь);
КонецФункции

Функция ПолучитьНаСервере(Наименование) Экспорт
	Возврат Справочники.ДополнительныеОтчетыИОбработки.НайтиПоНаименованию(Наименование).ХранилищеОбработки.Получить();
КонецФункции // ПолучитьНаСервере()

#КонецОбласти

Функция ЗапуститьВыполнениеВФоне(Знач ИдентификаторФормы, Знач ИмяЭкспортнойПроцедуры, 
	Знач Параметры, Знач НаименованиеЗадания = "", ИспользоватьДополнительноеВременноеХранилище = Ложь) Экспорт
	
	АдресХранилища = ПоместитьВоВременноеХранилище(Неопределено, ИдентификаторФормы);
	
	Результат = Новый Структура;
	Результат.Вставить("АдресХранилища",       АдресХранилища);
	Результат.Вставить("ЗаданиеВыполнено",     Ложь);
	Результат.Вставить("ИдентификаторЗадания", Неопределено);
	
	Если Не ЗначениеЗаполнено(НаименованиеЗадания) Тогда
		НаименованиеЗадания = ИмяЭкспортнойПроцедуры;
	КонецЕсли;
	
	ПараметрыЭкспортнойПроцедуры = Новый Массив;
	ПараметрыЭкспортнойПроцедуры.Добавить(Параметры);
	ПараметрыЭкспортнойПроцедуры.Добавить(АдресХранилища);
	
	Если ИспользоватьДополнительноеВременноеХранилище Тогда
		АдресХранилищаДополнительный = ПоместитьВоВременноеХранилище(Неопределено, ИдентификаторФормы);
		ПараметрыЭкспортнойПроцедуры.Добавить(АдресХранилищаДополнительный);
	КонецЕсли;
	
	РежимОтладки = ОбщегоНазначенияКлиентСервер.РежимОтладки();
	Если РежимОтладки Тогда
		
		РаботаВБезопасномРежиме.ВыполнитьМетодКонфигурации(ИмяЭкспортнойПроцедуры, ПараметрыЭкспортнойПроцедуры);
		Результат.ЗаданиеВыполнено = Истина;
		
	Иначе
		
		ПараметрыЗадания = Новый Массив;
		ПараметрыЗадания.Добавить(ИмяЭкспортнойПроцедуры);
		ПараметрыЗадания.Добавить(ПараметрыЭкспортнойПроцедуры);
		ВремяОжидания = ?(ПолучитьСкоростьКлиентскогоСоединения() = СкоростьКлиентскогоСоединения.Низкая, 4, 2);
		Задание = ФоновыеЗадания.Выполнить("ITSP_Сервер.ВыполнитьМетодКонфигурации", ПараметрыЗадания,, НаименованиеЗадания);
		Попытка
			Задание.ОжидатьЗавершения(ВремяОжидания);
		Исключение
			// Специальная обработка не требуется, возможно исключение вызвано истечением времени ожидания.
		КонецПопытки;
		
		Результат.ЗаданиеВыполнено = ДлительныеОперации.ЗаданиеВыполнено(Задание.УникальныйИдентификатор);
		Результат.ИдентификаторЗадания = Задание.УникальныйИдентификатор;
	КонецЕсли;
	
	Если ИспользоватьДополнительноеВременноеХранилище Тогда
		Результат.Вставить("АдресХранилищаДополнительный", АдресХранилищаДополнительный);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура СформироватьНаПечатьИзОбработки(ПараметрКоманды,Адрес,НазваниеОбработки,СПечатью = Ложь) Экспорт
	
	ИмяФайла = ПолучитьИмяВременногоФайла("epf");
	ДвоичныеДанные = Справочники.ДополнительныеОтчетыИОбработки.НайтиПоНаименованию(НазваниеОбработки).ХранилищеОбработки.Получить();
	Если ДвоичныеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ДвоичныеДанные.Записать(ИмяФайла);
	ВнешниеОбработки.Создать(ИмяФайла,Ложь).СформироватьНаПечать(ПараметрКоманды,Адрес,СПечатью);
	УдалитьФайлы(ИмяФайла);
	
КонецПроцедуры // СформироватьСчетаНаСервере()



