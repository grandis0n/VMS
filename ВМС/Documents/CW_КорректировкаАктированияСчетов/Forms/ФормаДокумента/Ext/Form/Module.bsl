
&НаСервере
&ИзменениеИКонтроль("_ЗаполнитьКорректировку")
Функция VMS__ЗаполнитьКорректировку()
	// --- 

	Если Объект.Договор.Пустая() Тогда

		Возврат(_УФКС.Ответ(1,"Не указан договор"));

	КонецЕсли; 

	Если Объект.Договор.ВидДоговора.Пустая() Тогда

		Возврат(_УФКС.Ответ(1,"Не указан вид договора"));

	КонецЕсли; 

	Если Объект.Договор.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком Тогда

		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		|	CW_АктированиеВходящихСчетовОстатки.Счет КАК ВходящийСчет,
		|	CW_АктированиеВходящихСчетовОстатки.Организация,
		|	CW_АктированиеВходящихСчетовОстатки.Контрагент,
		|	CW_АктированиеВходящихСчетовОстатки.Договор,
		|	CW_АктированиеВходящихСчетовОстатки.Грузоперевозка,
		|	CW_АктированиеВходящихСчетовОстатки.ПорядокОтражения,
		|	CW_АктированиеВходящихСчетовОстатки.Номенклатура,
		|	CW_АктированиеВходящихСчетовОстатки.СтавкаНДС,
		|	CW_АктированиеВходящихСчетовОстатки.СуммаОстаток КАК Сумма,
		|	CW_АктированиеВходящихСчетовОстатки.НДСОстаток КАК НДС,
		|	CW_АктированиеВходящихСчетовОстатки.ВсегоОстаток КАК Всего
		|ИЗ
		|	РегистрНакопления.CW_АктированиеВходящихСчетов.Остатки(
		|			&Период,
		|			Организация = &Организация
		|				И Контрагент = &Контрагент
		|				И Договор = &Договор
		//Подсистема.УчетПриложенийДоговоров
		|				И ПриложениеКДоговору = &ПриложениеКДоговору
		//Подсистема.УчетПриложенийДоговоров
		|				И Валюта = &Валюта) КАК CW_АктированиеВходящихСчетовОстатки";

	ИначеЕсли Объект.Договор.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПокупателем Тогда

		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		|	CW_АктированиеИсходящихСчетовОстатки.Счет КАК ИсходящийСчет,
		|	CW_АктированиеИсходящихСчетовОстатки.Организация,
		|	CW_АктированиеИсходящихСчетовОстатки.Контрагент,
		|	CW_АктированиеИсходящихСчетовОстатки.Договор,
		|	CW_АктированиеИсходящихСчетовОстатки.Грузоперевозка,
		|	CW_АктированиеИсходящихСчетовОстатки.ПорядокОтражения,
		|	CW_АктированиеИсходящихСчетовОстатки.Номенклатура,
		|	CW_АктированиеИсходящихСчетовОстатки.СтавкаНДС,
		|	CW_АктированиеИсходящихСчетовОстатки.ВсегоОстаток КАК Всего,
		|	CW_АктированиеИсходящихСчетовОстатки.НДСОстаток КАК НДС,
		|	CW_АктированиеИсходящихСчетовОстатки.СуммаОстаток КАК Сумма
		|ИЗ
		|	РегистрНакопления.CW_АктированиеИсходящихСчетов.Остатки(
		|			&Период,
		|			Организация = &Организация
		|				И Контрагент = &Контрагент
		|				И Договор = &Договор
		//Подсистема.УчетПриложенийДоговоров
		|				И ПриложениеКДоговору = &ПриложениеКДоговору
		//Подсистема.УчетПриложенийДоговоров
		|				И Валюта = &Валюта) КАК CW_АктированиеИсходящихСчетовОстатки";

	Иначе

		Возврат(_УФКС.Ответ(1,"Некорректный вид договора."));

	КонецЕсли; 
	// --- 
    #Удаление
		_сф.ст_ДобавитьСвойства(Запрос.Параметры,"Организация,Контрагент,Договор,Валюта:Договор.ВалютаДоговора",Объект);
	#КонецУдаления
	#Вставка 
		Запрос.УстановитьПараметр("Организация",Объект.Организация);
		Запрос.УстановитьПараметр("Контрагент",Объект.Контрагент);
		Запрос.УстановитьПараметр("Договор",Объект.Договор);
		Если ЗначениеЗаполнено(Объект.ПриложениеКДоговору) тогда
			Запрос.УстановитьПараметр("Валюта",Объект.ПриложениеКДоговору.ВалютаДоговора);	
		Иначе
			Запрос.УстановитьПараметр("Валюта",Объект.Договор.ВалютаДоговора);
		КонецЕсли;
		
	#КонецВставки
	Запрос.УстановитьПараметр("Период", Новый Граница(Объект.Дата,ВидГраницы.Исключая));

	//Подсистема.УчетПриложенийДоговоров
	Запрос.УстановитьПараметр("ПриложениеКДоговору", Объект.ПриложениеКДоговору);
	//Подсистема.УчетПриложенийДоговоров

	// --- 
	ТЗ = Запрос.Выполнить().Выгрузить();

	Если _сф.Количество(ТЗ) = 0 Тогда

		Возврат(_УФКС.Ответ(1,"Нет данных для заполнения."));

	Иначе

		Объект.КорректировкаАктирования.Загрузить(ТЗ);
		_ОбновитьПредставление_Списание();
		Возврат(_УФКС.Ответ());

	КонецЕсли; 

	// --- 
КонецФункции
