&После("ПередЗаписью")
Процедура FARESM_ПередЗаписью_После(Отказ)
	
	Если Ссылка.Пустая() Тогда
		ДополнительныеСвойства.Вставить("FARESM_ЗаписьНового");
	КонецЕсли;
	
КонецПроцедуры

&После("ПриЗаписи")
Процедура FARESM_ПриЗаписи_После(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если ДополнительныеСвойства.Свойство("FARESM_ЗаписьНового") Тогда
		
		ПараметрыДоговора = РегистрыСведений.CW_ПараметрыДоговоров.СоздатьМенеджерЗаписи();
		ПараметрыДоговора.Период = ЭтотОбъект.ДатаДоговора;
		ПараметрыДоговора.Договор = Ссылка;
		ПараметрыДоговора.Прочитать();
		Если ПараметрыДоговора.Выбран() Тогда
			ПараметрыДоговора.ПорядокЗачетаАвансовОЗ = Перечисления.СпособыЗачетаАвансов.ПоДокументу;
			ПараметрыДоговора.ПорядокЗачетаАвансов = Перечисления.СпособыЗачетаАвансов.Автоматически;
			ПараметрыДоговора.Записать();
		КонецЕсли;
		
	КонецЕсли;
		
	
КонецПроцедуры
